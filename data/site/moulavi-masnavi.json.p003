وقتی مغز گردو، فندق و بادام به ریاضت و تمرین روحی و عشق الهی برسد، پوست آن‌ها نازک‌تر می‌شود و ارزش این مغزها بیشتر می‌گردد."],[338,"مغز علم افزود کم شد پوستش","زانک عاشق را بسوزد دوستش","علم انسان در صورت افزودن به معنای واقعی و باطنی، کم‌کم از ظاهر و قشر بیرونی‌اش کاسته می‌شود، زیرا عشق به دوست (خدا) باعث می‌شود که او را بسوزاند و تمام وجود عاشق را تبدیل به حقیقت کند."],[338,"وصف مطلوبی چو ضد طالبیست","وحی و برق نور سوزنده نبیست","جمال مطلوب، شبیه به حسرت و آرزوی چیزی است که در طلب آن هستیم، و وحی و نور روشنایی که از نبی (پیامبر) می‌تابد، مانند برقی سوزان است."],[338,"چون تجلی کرد اوصاف قدیم","پس بسوزد وصف حادث را گلیم","وقتی که ویژگی‌های قدیمی و جاودانی خداوند در جهان ظاهر می‌شود، ویژگی‌های جدید و دنیوی از بین می‌رود و جایگاهی برای خود نمی‌یابد."],[338,"ربع قرآن هر که را محفوظ بود","جل فینا از صحابه می‌شنود","هر کسی که آیات قرآن را حفظ کرده باشد، از صحابه (یاران پیامبر) درباره معانی و تفسیر آن‌ها می‌شنود."],[338,"جمع صورت با چنین معنی ژرف","نیست ممکن جز ز سلطانی شگرف","برای بیان چنین مفهومی عمیق و معنادار، تنها از وجود یک پادشاه بزرگ و شگرف می‌توان بهره برد؛ زیرا جمع کردن این صورت (ظواهر) با چنین معنای عمیق، ممکن نیست."],[338,"در چنین مستی مراعات ادب","خود نباشد ور بود باشد عجب","در این حالت مسخری و شگفت‌انگیز، رعایت ادب و آداب اجتماعی برایم معنا ندارد و اگر هم باشد، جای تعجب دارد."],[338,"اندر استغنا مراعات نیاز","جمع ضدینست چون گرد و دراز","در حالت بی‌نیازی، رعایت نیازمندی‌ها بی‌معناست، مانند گردی که دراز است و نمی‌تواند به حالت مستطیل درآید."],[338,"خود عصا معشوق عمیان می‌بود","کور خود صندوق قرآن می‌بود","عصا به عنوان نمادی از معشوق، در نظر بینایان همچون وسیله‌ای برای رهنمودی و هدایت است، در حالی که برای کوران به شکل دکانی پر از کتاب‌های مقدس و تلاوت‌های مذهبی و روحانی جلوه می‌کند، اما در واقع بدون درک آنچه در آن است، بی‌فایده می‌باشد."],[338,"گفت کوران خود صنادیقند پر","از حروف مصحف و ذکر و نذر","کوران خود به مانند صندوق‌هایی هستند که پر از حروف قرآن و ذکر و دعا هستند، اما در حقیقت محتوای واقعی را درک نمی‌کنند."],[338,"باز صندوقی پر از قرآن به است","زانک صندوقی بود خالی بدست","صندوقی که پر از قرآن و ذکر و یاد خداست، از آن صندوقی که خالی از محتوای ارزشمند است، بهتر و باارزش‌تر است."],[338,"باز صندوقی که خالی شد ز بار","به ز صندوقی که پر موشست و مار","صندوقی که خالی از بار است، بهتر از صندوقی است که پر از موش و مار (آفت‌ها) است."],[338,"حاصل اندر وصل چون افتاد مرد","گشت دلاله به پیش مرد سرد","وقتی انسان به وصال و رسیدن به محبوب می‌رسد، معمولا از حالت مردانگی و استقلال خود خارج شده و به خدمتگزار و دلالی برای دیگران تبدیل می‌شود."],[338,"چون به مطلوبت رسیدی ای ملیح","شد طلب کاری علم اکنون قبیح","وقتی به خواسته‌ات رسیدی، ای زیبا، دیگر طلب و درخواست کردن از تو ناپسند و بی‌معنی است."],[338,"چون شدی بر بامهای آسمان","سرد باشد جست وجوی نردبان","وقتی به بالاترین مراحل روحانی و معنوی رسیدی، دیگر دنبال صعود و پیشرفت نباش، زیرا تلاش برای رسیدن به چنین مقاماتی بی‌معناست."],[338,"جز برای یاری و تعلیم غیر","سرد باشد راه خیر از بعد خیر","تنها برای کمک و آموزش به دیگران، راه نیکو از نیکی، سرد و بی‌عاطفه نخواهد بود."],[338,"آینه روشن که شد صاف و ملی","جهل باشد بر نهادن صیقلی","وقتی آینه‌ای پاک و صاف می‌شود، جهل و نادانی بر آن نمی‌نشیند، گویا که بر آن چیز روشنی نمی‌تواند بماند."],[338,"پیش سلطان خوش نشسته در قبول","زشت باشد جستن نامه و رسول","نشستن در حضور سلطان و نگاه کردن به او، در حالی که زشت و ناپسند است، مانند فرستادن نامه و پیام‌های ناخواسته است."],[339,"آن یکی را یار پیش خود نشاند","نامه بیرون کرد و پیش یار خواند","عاشق، محبوبش را نزد خود نشاند و نامه‌ای را که داشت، برای او خواند."],[339,"بیت‌ها در نامه و مدح و ثنا","زاری و مسکینی و بس لابه‌ها","عاشق در نامه‌هایش به ذکر مدح و ستایش و زاری و ناله‌های مسکینی پرداخته است و برای به دست آوردن عشق معشوقش به این کارها مشغول شده است."],[339,"گفت معشوق ‌«این اگر بهر من‌ست","گاه وصل این عمر ضایع کردن‌ست","معشوق گفت: اگر این کارها (نامه‌خوانی) برای من است، پس در زمان وصال، وقت را بیهوده تلف کردن است."],[339,"من به پیشت حاضر و تو نامه‌خوان‌؟","نیست این باری نشان عاشقان‌»","من در حضورت هستم و تو مشغول خواندن نامه‌ای؟ این نشان از عشق ورزی نیست."],[339,"گفت اینجا حاضری اما ولیک","من نمی‌یایم نصیب خویش نیک","می‌گوید اگر تو در اینجا حاضر هستی، من نمی‌توانم به تو برسم و نصیب خوب خود را به دست نیاورم."],[339,"آنچ می‌دیدم ز تو پارینه سال","نیست این دم گرچه می‌بینم وصال","آنچه در گذشته از تو می‌دیدم با آنچه اکنون در لحظه حاضر می‌بینم متفاوت است، اگرچه اکنون به وصال و نزدیکی رسیده‌ام."],[339,"من ازین چشمه زلالی خورده‌ام","دیده و دل ز آب تازه کرده‌ام","من از این چشمه‌ی زلال عشق نوشیده‌ام و به خاطر آن، دیده و دل خود را تازگی و طراوت بخشیده‌ام."],[339,"چشمه می‌بینم ولیکن آب نی","راه آبم را مگر زد ره‌زنی","من چشمه‌ای را می‌بینم، اما آبی از آن نمی‌نوشم و دلیلی که راهی به آب را بگشاید، شاید به خاطر وجود مانعی یا دزدی (ره‌زنی) در مسیر، غیرممکن شده است."],[339,"گفت پس من نیستم معشوق تو","من به بلغار و مرادت در قتو","او در پاسخ می‌گوید که من معشوق تو نیستم و در بلاد بلغار هستم و مقصود تو در جای دیگری است."],[339,"عاشقی تو بر من و بر حالتی","حالت اندر دست نبود یا فتی‌!","عاشقانه‌ای که تو برای من و برای حالتی که داری، در دستت نیست، ای جوان!"],[339,"پس نیم کلی مطلوب تو من","جزو مقصودم تو را اندر زمن","من به‌طور کامل آرزوی تو را نمی‌خواهم، بلکه بخشی از هدف تو هستم که در زمان و مکان به تو مرتبط می‌شود."],[339,"خانه معشوقه‌ام‌، معشوق نی","عشق بر نقدست‌، بر صندوق نی","عشق به معشوقه‌ام، اصل و حقیقت عشق است و نه چیزی نادیده و بدون اهمیت مثل یک صندوق که چیزی در آن باشد."],[339,"هست معشوق آنک او یکتو بود","مبتدا و منتهاات او بود","معشوق همان است که او یکتا و منحصر به فرد است، او آغاز و پایان تمام عشق‌هاست."],[339,"چون بیابی‌اش نمانی منتظر","هم هویدا او بود هم نیز سرّ","زمانی که او را بیابی، دیگر در انتظار نمی‌مانی؛ او هم آشکار است و هم راز."],[339,"میر احوالست نه موقوف حال","بنده آن ماه باشد ماه و سال","بنده آن معشوق (ماه) همیشه در حال و تغییر است و نمی‌توان بر اساس زمان (ماه و سال) او را وصف کرد."],[339,"چون بگوید حال را فرمان کند","چون بخواهد جسم‌ها را جان کند","وقتی او (معشوق) حال را بگوید، تصمیم می‌گیرد و همه چیز را تحت تأثیر قرار می‌دهد. وقتی بخواهد، می‌تواند روح را در جسم‌ها وارد کند و آن‌ها را زنده کند."],[339,"منتها نبود که موقوف‌ست او","منتظر بنشسته باشد حال‌جو","اینکه او (معشوق) در حالاتی که منتظر عشق است، نباید به انتظار نشسته باشد و از حال خود غافل بماند، بلکه باید به دنبال حال‌های نو و تجربه‌های تازه باشد."],[339,"کیمیای حال باشد دست او","دست جنباند شود مس مست او","دست او به طوری است که حال و وضعیت روحی‌اش را می‌سازد و با حرکت آن، حالتی مانند مستی به او دست می‌دهد."],[339,"گر بخواهد‌ مرگ هم شیرین شود","خار و نشتر نرگس و نسرین شود","اگر مرگ بخواهد، می‌تواند زیبا و دل‌نشین شود، همان‌طور که گل‌های نرگس و نسرین زیبا و دلربا هستند."],[339,"آنکه او موقوف حالست آدمی‌ست","کاو به‌حال افزون و گاهی در کمی‌ست","انسانی که حال او به حالتی مشخص وابسته است، در برخی اوقات حالش بهتر و در برخی اوقات دیگر حالش بدتر می‌شود. او نمی‌تواند همیشه در یک وضعیت ثابت باقی بماند و حالش همواره تغییر می‌کند."],[339,"صوفی ابن الوقت باشد در منال","لیک صافی فارغ‌ست از وقت و حال","صوفی کسی است که به لحظه‌های حال زندگی می‌کند و به دستاوردهای معنوی می‌رسد، اما فردی پاک و خالص از قید و بندهای زمان و حال است."],[339,"حال‌ها موقوف عزم و رای او","زنده از نفخ مسیح‌آسای او","حالت‌ها و تغییرات روحی انسان در واقع به تصمیم و اراده او وابسته است، و این احساسات و حالاتی که در او به وجود می‌آید به لطف و انرژی حیات‌بخش اوست که شبیه به دمیدن مسیح در جان انسان‌ها است."],[339,"عاشق‌ حالی‌، نه عاشق بر منی","بر امید حال بر من می‌تنی","عاشق واقعی کسی است که به دلیل حال و وضعیت خود به معشوق وابسته نیست، بلکه او به خاطر امید به دست آوردن حال و وضعیت بهتر به معشوق متصل می‌شود."],[339,"آنک یک دم کم دمی کامل بود","نیست معبود‌ خلیل‌، آفل بود","عاشق واقعی کسی است که حتی برای یک لحظه هم دمی کامل و تمام نمی‌تواند بدون معشوقش زندگی کند، و معشوق ابراهیم (خلیل) هم اگر لحظه‌ای از او دور باشد، هرگز نمی‌تواند به کامل بودن خود ادامه دهد."],[339,"وانک آفل باشد و گه آن و این","نیست دلبر لا احب الافلین","هرچند معشوق ممکن است در گاهی اوقات ظاهر شود و در زمان‌های دیگر نباشد، اما من به کسی که در دنیای مادی و گذراست محبت نمی‌ورزم، چون عاشق معشوقی هستم که همیشه در دل و جانم حضور دارد."],[339,"آنک او گاهی خوش و گه ناخوش‌ست","یک زمانی آب و یک دم آتش‌ست","معشوق گاهی حال خوشی دارد و گاهی حال ناخوشی، او در یک زمانی شبیه آب است که آرامش‌بخش است و در زمانی دیگر مانند آتش است که آتشین و پرحرارت می‌باشد."],[339,"برج مه باشد ولیکن ماه نه","نقش بت باشد ولی آگاه نه","اگرچه ممکن است ماه شب به زیبایی باشد، ولی در واقعیت، آن ماهی که می‌بینیم، تنها یک تصویر و جلوه است و حقیقت را نمی‌توان در آن دید."],[339,"هست صوفی‌ صفاجو ابن‌ وقت","وقت را همچون پدر بگرفته سخت","صوفی صفاجو (عاشق واقعی) در زمان خود همانند پدرش، سخت و جدی به وقت و زمان اهمیت می‌دهد و آن را به شدت می‌گیرد."],[339,"هست صافی غرق عشق ذوالجلال","ابن‌ کس نه‌، فارغ از اوقات و حال","عاشق حقیقی که در عشق خداوند غرق شده و از عشق او پاک و صاف است، فرزندی از کسی نیست و تحت تأثیر زمان و شرایط قرار ندارد."],[339,"غرقه نوری که او لم یولدست","لم یلد لم یولد آن ایزدست","غرق در نوری است که خداوند هیچ‌گاه متولد نشده و نخواهد شد، و این نور همان خداوند است."],[339,"رو چنین عشقی بجو گر زنده‌ای","ورنه وقت مختلف را بنده‌ای","چنین عشق زنده‌ای را بجوی اگر زنده‌ای؛ وگرنه، تو در وقت‌های مختلف، بنده‌ای و اسیر دنیای مادی هستی."],[339,"منگر اندر نقش زشت و خوب خویش","بنگر اندر عشق و در مطلوب خویش","به جای اینکه به زیبایی یا زشتی و خصوصیات خودت توجه کنی، بر عشق و خواسته‌ات تمرکز کن و به آنچه واقعا برایت مهم است، نگاه کن."],[339,"منگر آنک تو حقیری یا ضعیف","بنگر اندر همّت خود ای شریف","به جای اینکه به ضعف یا کوچکی خود فکر کنی، به اراده و همت بالای خود توجه کن، ای انسان والا."],[339,"تو به هر حالی که باشی می‌طلب","آب می‌جو دایما ای خشک‌لب","هر طور که باشی، همیشه در پی آب و نوشیدن هستی، ای کسی که لب‌هایت خشک است و نیاز به آب داری."],[339,"کان لب خشکت گواهی می‌دهد","کاو بآخر بر سر منبع رسد","لب‌های خشک تو گواهی می‌دهند که بالاخره به سرچشمه آب خواهی رسید."],[339,"خشکی لب هست پیغامی ز آب","که بمات آرد یقین این اضطراب","خشکی لب نشانه‌ای است از نیاز به آب، که نشان می‌دهد این عدم آب‌جویی، دلیل قاطعی برای ایجاد اضطراب و تشنگی در انسان است."],[339,"کاین طلب‌کاری مبارک جنبشی‌ست","این طلب در راه حق مانع کشی‌ست","این جستجو برای طلب دانش و حقیقت، حرکتی مبارک و مثبت است. این طلب، در مسیر حق و حقیقت، مانع از جلوگیری و ممانعت می‌شود و به پیشرفت و حرکت به سمت هدف کمک می‌کند."],[339,"این طلب مفتاح مطلوبات تست","این سپاه و نصرت رایات تست","این طلب، کلید دستیابی به خواسته‌ها و آرزوهایت است و این جمع و یاری که به دور توست، نشانه‌ی حمایت و پشتیبانی از توست."],[339,"این طلب همچون خروسی در صیاح","می‌زند نعره که می‌آید صباح","این آرزو شبیه خروس است که صبحگاه با صدای بلند خود خبر از آمدن صبح می‌دهد. این شعر به این معناست که خواسته‌ها و آرزوها، به‌ویژه در عشق، ممکن است هیجان‌انگیز و پر سر و صدا باشند، اما واقعیت را تغییر نمی‌دهند."],[339,"گرچه آلت نیستت تو می‌طلب","نیست آلت حاجت اندر راه رب","هرچند تو ابزار و وسیله‌ای برای طلب چیزی نیستی، اما نیازی که در طلب آن هستی در راه حق وجود دارد، یعنی نیاز واقعی تو باید به سوی خداوند باشد."],[339,"هر که را بینی طلب‌کار ای پسر","یار او شو پیش او انداز سر","هر کس را که به طلب و خواستن مشغول است، ای پسر، به او نزدیک شو و سر خود را در برابرش خم کن."],[339,"کز جوار طالبان طالب شوی","وز ظلال غالبان غالب شوی","از کنار خواستاران، تو نیز عاشق و خواستار عشق شو و زیر سایه‌ی غالبان، تو نیز غالب و برتر باش."],[339,"گر یکی موری سلیمانی بجست","منگر اندر جستن او سست سست","حتی موری اگر سلیمانی را می‌جوید در جستجو و طلب او‌، به چشم ضعیفی و حقارت نگاه مکن."],[339,"هرچه داری تو ز مال و پیشه‌ای","نه طلب بود اول و اندیشه‌ای‌؟","هر چیزی که تو داری، چه سرمایه و چه شغلی، آیا نیاز به درخواست و تلاش برای به دست آوردن آن نیست، و آیا در ابتدا فکر و اندیشه‌ای درباره آن نبوده است؟"],[340,"آن یکی در عهد داوود نبی","نزد هر دانا و پیش هر غبی","در زمان داود نبی، شخصی بود که به نزد هر عالم و نادانی می‌رفت."],[340,"این دعا می‌کرد دایم کای خدا","ثروتی بی رنج روزی کن مرا","این شخص همیشه دعا می‌کرد که، ای خدا، ثروتی بدون زحمت به من عطا کن."],[340,"چون مرا تو آفریدی کاهلی","زخم‌خواری سست‌جنبی منبلی","خداوند، وقتی مرا آفریدی، من تنبل و ناتوان و سست بوده‌ام و به راحتی عادت کرده‌ام که تنها بخواهم و کاری نکنم."],[340,"بر خران پشت‌ریش بی‌مراد","بار اسپان و استران نتوان نهاد","بر پشت الاغ‌ها که به آنها بار زیاد نمی‌توان گذاشت، نمی‌توان بار سنگین و نامرادی گذاشت. اینجا اشاره به این است که بر خلاف طبیعت و ظرفیت موجودات نمی‌توانیم توقعات زیادی داشته باشیم."],[340,"کاهلم چون آفریدی ای ملی","روزیم ده هم ز راه کاهلی","ای خداوند، من در حالی که کسالت و تنبلی دارم آفریده شده‌ام، بنابراین به من روزی حلالی بده، حتی از طریق تنبلی و بی‌کاری‌ام."],[340,"کاهلم من سایه خسپم در وجود","خفتم اندر سایه این فضل و جود","من سردسته ناکارآمدانم و در سایه این بخشش و نیکی، کوتاهی و راحت‌طلبی می‌کنم."],[340,"کاهلان و سایه‌خسپان را مگر","روزیی بنوشته‌ای نوعی دگر","کسانی که تنبل و بی‌تحرک هستند و در سایه نشسته‌اند، آیا روزی متفاوتی برایشان مقدر شده است؟"],[340,"هر که را پایست جوید روزیی","هر که را پا نیست کن دلسوزیی","هر کسی که برای به‌دست‌آوردن روزی تلاش و کوشش می‌کند، به او روزی خواهد رسید، اما کسی که ناتوان و بی‌پایت است، باید بر او دل‌سوزی کرد و به او کمک نمود."],[340,"رزق را می‌ران به سوی آن حزین","ابر را باران به سوی هر زمین","خداوند روزی را به سمت آن شخص غمگین می‌فرستد، همان‌طور که باران به سمت هر زمینی می‌بارد."],[340,"چون زمین را پا نباشد جود تو","ابر را راند به سوی او دوتو","اگر زمین قدرت راه رفتن نداشته باشد، تو با بخشش و کرم خود مانند ابری او را به سوی خود می‌کشی و می‌فرستی."],[340,"طفل را چون پا نباشد مادرش","آید و ریزد وظیفه بر سرش","وقتی کودک نتواند به تنهایی حرکت کند، مادرش سرش را می‌گیرد و غذا به او می‌دهد."],[340,"روزیی خواهم به‌ناگه بی تعب","که ندارم من ز کوشش جز طلب","من روزی می‌خواهم که به‌طور ناگهانی و بدون زحمت به دستم برسد، چون من فقط از راه دعا و خواستن به آن امید دارم و تلاشی دیگر نمی‌کنم."],[340,"مدت بسیار می‌کرد این دعا","روز تا شب، شب همه شب تا ضحی","او مدت زیادی دعا می‌کرد، به‌طوری که روزها تا شب و شب‌ها تا صبح در حال دعا بود."],[340,"خلق می‌خندید بر گفتار او","بر طمع‌خامی و بر بیگار او","مردم به سخنان او می‌خندیدند و به طمع و امید ناامیدانه‌اش و بی‌کاری او تمسخر می‌کردند."],[340,"که چه می‌گوید عجب این سست‌ریش","یا کسی دادست بنگ بیهشیش","او به شوخی می‌گوید این فرد بی‌خبر از واقعیت یا سست‌پایه چه می‌گوید، زیرا یا کسی به او چیزی داده است که او بی‌خبر از آن است، یا خودش بی‌اساس و بی‌خبر است."],[340,"راه روزی کسب و رنجست و تعب","هر کسی را پیشه‌ای داد و طلب","برای به‌دست آوردن روزی، باید تلاش و زحمت کشید، و برای هر فردی شغلی وجود دارد که می‌تواند به کمک آن روزی‌اش را تأمین کند."],[340,"اطلبوا الارزاق فی اسبابها","ادخلو الاوطان من ابوابها","برای به دست آوردن روزی، باید به سراغ اسباب و وسایل آن رفت و از طریق درست و مناسب وارد سرزمین‌ها شد."],[340,"شاه و سلطان و رسول حق کنون","هست داود نبی ذو فنون","داود نبی، که همزمان با مقام شاه و پیامبر است، انسانی با فضل و مهارت‌های گوناگون بود."],[340,"با چنان عزی و نازی کاندروست","که گزیدستش عنایتهای دوست","این شخص با مقام و بزرگی و زیبایی خاصی که دارد، مورد توجه و محبت خداوند قرار گرفته و از نعمت‌های خاص او بهره‌مند شده است."],[340,"معجزاتش بی شمار و بی عدد","موج بخشایش مدد اندر مدد","معجزات او بسیار و فراوان است و نعمت‌های الهی پیوسته بر یکدیگر جاری است."],[340,"هیچ کس را خود ز آدم تا کنون","کی بدست آواز صد چون ارغنون","هیچ‌کس از زمان آدم تا کنون، به وسیله صدایی مانند لحن خوش و موسیقایی (ارغنون) در عرصه دعا و نیایش به این اندازه موفق نبوده است."],[340,"که بهر وعظی بمیراند دویست","آدمی را صوت خوبش کرد نیست","صوت خوب او می‌تواند به اندازه دو صد نفر را به مرگ وادارد و تأثیر عمیق بگذارد، اما نه برای نصیحت و وعظ، بلکه به خاطر زیبایی و قدرت آن صوت."],[340,"شیر و آهو جمع گردد آن زمان","سوی تذکیرش مغفل این از آن","وقتی که دعوت الهی شنیده می‌شود، هم شیر و هم آهو، که نماد قدرت و ضعف هستند، به سوی یادآوری خداوند می‌آیند. این نشان‌دهنده تأثیر عمیق و یکسان دعوت خداوند بر همه موجودات است، حتی بر متظاهرین به غفلت."],[340,"کوه و مرغان هم‌رسایل با دمش","هردو اندر وقت دعوت محرمش","کوه و پرندگان نیز به همراه او، در زمان دعوت او در محرم (ماه محرم) حاضرند و به ندا و فراخوان او پاسخ می‌دهند."],[340,"این و صد چندین مرورا معجزات","نور رویش بی‌جهات و در جهات","این و صدها معجزه دیگر از او از نور صورتش به طور غیرمستقیم و مستقیم آشکار است."],[340,"با همه تمکین خدا روزی او","کرده باشد بسته اندر جست و جو","با اینکه خداوند به او اعتماد و تمکین داده، اما روزی‌اش به دست نیامده است و او هنوز در جستجوی روزی است."],[340,"بی زره‌بافی و رنجی روزیش","می‌نیاید با همه پیروزیش","او بدون تلاش و زحمت و بدون اینکه زره‌ای برای خود ببافد، روزی حلالش نمی‌رسد، هرچند که در زندگی پیروزی‌هایی داشته باشد."],[340,"این چنین مخذول واپس مانده‌ای","خانه کنده دون و گردون‌رانده‌ای","تو در وضع بدی هستی که به دور از امکانات زندگی، از نعمت‌های دنیا بی‌نصیب مانده‌ای و مانند کسی هستی که در دل زمین حبس شده و نمی‌تواند به جلو برود."],[340,"این چنین مدبر همی خواهد که زود","بی تجارت پر کند دامن ز سود","این شخص با هوشمندی می‌خواهد بدون زحمت و تجارت، به سرعت به ثروت و سود برسد."],[340,"این چنین گیجی بیامد در میان","که بر آیم بر فلک بی نردبان","این فرد نادان به گونه‌ای وارد کارزار شده که نمی‌داند برای صعود به اوج موفقیت، باید زحمت بکشد و نیازی به نردبان (زحمت و تلاش) ندارد."],[340,"این همی‌گفتش بتسخر رو بگیر","که رسیدت روزی و آمد بشیر","او (شخصی که دعا می‌کرد) باید بفهمد که به او می‌گویند با تمسخر رو برگردان، چون روزی‌ات رسید و مژده‌بر (خبر رسان) از راه رسید."],[340,"و آن همی خندید ما را هم بده","زانچ یابی هدیه‌ای سالار ده","او از سخنان تمسخرآمیز دیگران خنده‌اش می‌گیرد و به ما هم می‌گوید که اگر تو هم به مقامی برسی، هدیه‌ای به سالار بده."],[340,"او ازین تشنیع مردم وین فسوس","کم نمی‌کرد از دعا و چاپلوس","او از سرزنش مردم و این تهمت‌ها و بدگویی‌ها کم نمی‌کرد و همچنان به دعا کردن و تملق گفتن ادامه می‌داد."],[340,"تا که شد در شهر معروف و شهیر","کو ز انبان تهی جوید پنیر","این شخص به قدری در شهر معروف و مشهور شد که برای به دست آوردن پنیر، به جای کار و تلاش، در جستجوی کمک و انتظاری از دیگران است."],[340,"شد مثل در خام‌طبعی آن گدا","او ازین خواهش نمی‌آمد جدا","این گدا، به دلیل خامی و نادانی‌اش، به طور مداوم به همین درخواست‌هایش متعهد و وابسته است و از این خواسته رهایی نمی‌یابد."],[341,"تا که روزی ناگهان در چاشتگاه","این دعا می‌کرد با زاری و آه","در روزی ناگهانی، در میانه ساعت صبح، او با اندوه و ناله دعا می‌کرد."],[341,"ناگهان در خانه‌اش گاوی دوید","شاخ زد بشکست دربند و کلید","ناگهان در خانه‌ آن دعا کننده، گاوی دوید و با شاخش در را شکست و قفل و زنجیر را هم بریده است."],[341,"گاو گستاخ اندر آن خانه بجست","مرد در جست و قوائمهاش بست","گاو جسور در آن خانه به حرکت درآمد و مردی که در پی او بود پاهایش را محکم گرفت تا او را متوقف کند."],[341,"پس گلوی گاو ببرید آن زمان","بی توقف بی تامل بی امان","زمانی که سر گاو را بریدند، این کار به سرعت و بدون هیچ‌گونه وقفه یا تردیدی انجام شد."],[341,"چون سرش ببرید شد سوی قصاب","تا اهابش بر کند در دم شتاب","زمانی که سر گاو را بریدند، او به سمت قصاب رفت تا او پوستش را بردارد و سریعا متوجه این کار شد."],[342,"ای تقاضاگر درون همچون جنین","چون تقاضا می‌کنی اتمام این","ای درخواست‌کننده، درون تو همانند جنینی است که در حال رشد است. همان‌طور که از درون خود درخواست می‌کنی که این خواسته به پایان برسد."],[342,"سهل گردان ره نما توفیق ده","یا تقاضا را بهل بر ما منه","ای ره‌نما، لطف کن و کار را آسان کن و توفیق ما را بده، یا اینکه تقاضای ما را رها کن و به ما نده."],[342,"چون ز مفلس زر تقاضا می‌کنی","زر ببخشش در سر ای شاه غنی","وقتی که از شخص بی‌کس و بی‌پولی مانند من، پول و ثروت درخواست می‌کنی، باید در دل خود از تو ای شاه ثروتمند، درخواست بخشش کنی."],[342,"بی تو نظم و قافیه شام و سحر","زهره کی دارد که آید در نظر","بدون تو، نظم و قافیه نمی‌تواند در دل مردم جایی داشته باشد و هیچ‌گونه جذابیتی پیدا کند."],[342,"نظم و تجنیس و قوافی ای علیم","بنده امر توند از ترس و بیم","ای علیم (دانشمند) که نظم و قافیه و زیبایی‌های شعر را می‌شناسی، من از ترس و نگرانی به فرمان تو عمل می‌کنم و به این ترتیب شعر می‌گویم."],[342,"چون مسبح کرده‌ای هر چیز را","ذات بی تمییز و با تمییز را","هر چیزی که ذکر و ستایش می‌شود، چه بدون تمایز باشد و چه با تمایز، به نوعی در حال تسبیح و ستایش است."],[342,"هر یکی تسبیح بر نوعی دگر","گوید و از حال آن این بی‌خبر","هر چیز به نوع خاصی تسبیح و ستایش می‌کند و از وضعیت و حالتی که در آن قرار دارد، بی‌خبر است."],[342,"آدمی منکر ز تسبیح جماد","و آن جماد اندر عبادت اوستاد","انسانی که به تسبیح و یاد خداوند از سوی موجودات بی‌جان (جماد) اقرار ندارد، در حالی‌که این موجودات در عبادت و ستایش خداوند در حالتی خالصانه‌اند."],[342,"بلک هفتاد و دو ملت هر یکی","بی‌خبر از یکدگر واندر شکی","انسان‌ها که هفتاد و دو ملت مختلف هستند، هر یک از حال یکدیگر بی‌خبرند و در حالت تردید و شک زندگی می‌کنند."],[342,"چون دو ناطق را ز حال همدگر","نیست آگه چون بود دیوار و در","وقتی دو سخنگو از حال یکدیگر بی‌خبرند، وضعیت آن‌ها مانند دیوار و در است؛ یعنی بین آن‌ها جدایی وجود دارد و نمی‌توانند با یکدیگر ارتباط برقرار کنند."],[342,"چون من از تسبیح ناطق غافلم","چون بداند سبحه صامت دلم","من از ذکر و تسبیح گویندگان غافل هستم؛ چون دل من از تسبیح خاموشی که در دل دارم، آگاه نیست."],[342,"هست سنّی را یکی تسبیح خاص","هست جبری را ضد آن در مناص","سنی‌ها یک نوع تسبیح خاص دارند و در مقابل، جبری‌ها تسبیحی دارند که مخالف آن است."],[342,"سنّی از تسبیح جبری بی‌خبر","جبری از تسبیح سنّی بی اثر","سنّی (معتقد به مذهب سنی) از تسبیح جبری (معتقد به جبر) اطلاعی ندارد و نمی‌تواند به آن توجه کند، و جبری نیز از تسبیح سنّی بی‌اثر است و به آن اعتنایی نمی‌کند."],[342,"این همی‌گوید که آن ضالست و گم","بی‌خبر از حال او وز امر قم","این شخص (سنّی) هم می‌گوید که او (جبری) گمراه و در گم Machine و بی‌خبر است از حال او و از دستور خداوند."],[342,"و آن همی گوید که این را چه خبر","جنگشان افکند یزدان از قدر","او می‌گوید که یزدان (خداوند) چگونه به جنگ آن‌ها پرداخته است و آنان از سرنوشت و تقدیر خود بی‌خبرند."],[342,"گوهر هر یک هویدا می‌کند","جنس از ناجنس پیدا می‌کند","هر شیئی ویژگی‌های ذاتی خود را نشان می‌دهد و از بین اشیاء غیر مرتبط، نوع و دسته خود را مشخص می‌کند."],[342,"قهر را از لطف داند هر کسی","خواه دانا خواه نادان یا خسی","هر کسی، چه دانا و چه نادان یا بخیل، قهر را از لطف جدا نمی‌داند."],[342,"لیک لطفی قهر در پنهان شده","یا که قهری در دل لطف آمده","قهر و خشمی که به ظاهر وجود دارد، در واقع می‌تواند همراه با لطفی پنهان باشد؛ یا ممکن است در دل آن قهر، نوعی مهربانی نهفته باشد."],[342,"کم کسی داند مگر ربانیی","کش بود در دل محک جانیی","بسیاری از مردم نمی‌دانند که فقط خداوند است که می‌تواند در دل انسان‌های معمولی نشانه‌ای از صداقت و خوبی را بیابد."],[342,"باقیان زین دو گمانی می‌برند","سوی لانه خود به یک پر می‌پرند","باقی‌ماندگان از این دو نوع (ربانی و جانی) به سوی خانه‌های خود می‌روند و با یک پر، یعنی به آسانی و به سرعت، پرواز می‌کنند."],[343,"علم را دو پر، گمان را یک پرست","ناقص آمد ظن به پرواز ابترست","علم به دو پر تشبیه شده که باعث پرواز و اوج گرفتن می‌شود، در حالی که گمان تنها یک پر دارد و به همین دلیل نمی‌تواند به خوبی پرواز کند. بنابراین، گمان ناتمام و ناقص است."],[343,"مرغ یک‌پر زود افتد سرنگون","باز بر پرد دو گامی یا فزون","مرغی که فقط یک پر دارد، به سرعت سقوط می‌کند، اما مرغی که دو پر دارد، می‌تواند برود و دورتر پرواز کند."],[343,"افت خیزان می‌رود مرغ گمان","با یکی پر بر امید آشیان","مرغ گمان که تنها یک پر دارد، به طور بی‌ثبات و لرزان می‌رود و با امید رسیدن به آشیانه، در تلاش است، اما به خاطر نداشتن تکیه‌گاه قوی، به راحتی سقوط می‌کند."],[343,"چون ز ظن وا رست علمش رو نمود","شد دو پر آن مرغ یک‌پر پر گشود","زمانی که انسان از گمان و شک دور شود، علم و دانش او نمایان می‌شود و در این حالت، دانش مانند مرغی با دو پر پرواز می‌کند، در حالی که گمان به‌تنهایی تنها یک پر دارد و نمی‌تواند به‌خوبی پرواز کند."],[343,"بعد از آن یمشی سویا مستقیم","نه علی وجهه مکبا او سقیم","پس از آن، علم به‌سوی هدف خود به‌طور مستقیم حرکت می‌کند و مانند کسی که بیمار است، در مسیرش کج و معوج نیست."],[343,"با دو پر بر می‌پرد چون جبرئیل","بی گمان و بی مگر بی قال و قیل","علم، همچون جبرئیل، با دو بال (یقین و درستی) پرواز می‌کند، بدون شک و بدون هیچ‌گونه حرف و گپی."],[343,"گر همه عالم بگویندش توی","بر ره یزدان و دین مستوی","اگر همه مردم بگویند که تو در مسیر خدا و دین ثابت‌قدم هستی، به معنای واقعی، آنچه مهم است، یقین و اعتقاد درونی توست."],[343,"او نگردد گرم‌تر از گفتشان","جان طاق او نگردد جفتشان","انسان به‌دلیل نداشتن یقین و دانش واقعی، نمی‌تواند از نظرات دیگران تأثیر بپذیرد و به قلبش گرمایی دهد. او به‌جز آنچه که خود می‌داند و حس می‌کند، نمی‌تواند به گفته‌های دیگران اطمینان کند."],[343,"ور همه گویند او را گم‌رهی","کوه پنداری و تو برگ کهی","هرچند همه بگویند که او در گمراهی و سرگردانی است، اما تو چطور به او نگاه می‌کنی؟ آیا او را مانند کوهی می‌پنداری یا به مثابه برگی از درخت؟"],[343,"او نیفتد در گمان از طعنشان","او نگردد دردمند از ظعنشان","او تحت تأثیر سخنان و انتقادهای دیگران قرار نمی‌گیرد و از گمان‌های آنها در رنج نمی‌آید."],[343,"بلک گر دریا و کوه آید به‌گفت","گویدش با گم‌رهی گشتی تو جفت","اگر دریا و کوه هم بیایند و با هم گفتگو کنند، به تو می‌گویند که با گمراهی هم‌نشینی کرده‌ای و تو به همراهی او در آمده‌ای."],[343,"هیچ یک ذره نیفتد در خیال","یا به طعن طاعنان رنجورحال","هیچ یک از ذرات کوچک هم نمی‌تواند در ذهن بیفتد یا به خاطر طعنه‌زنی که از طرف افراد بدحال می‌شود، دچار رنج و ناراحتی شود."],[344,"کودکان مکتبی از اوستاد","رنج دیدند از ملال و اجتهاد","کودکان مکتب از سختی کار و تلاش زیاد درستان، به معلم خود ناراحت شدند."],[344,"مشورت کردند در تعویق کار","تا معلم در فتد در اضطرار","آن‌ها در مورد به تعویق انداختن کار مشورت کردند تا معلم به وضعیت اضطراری بیفتد."],[344,"چون نمی‌آید ورا رنجوریی","که بگیرد چند روز او دوریی","زیرا او نمی‌آید، ظاهرا حالتی از رنج و بیماری دارد که چند روز از او دوری می‌شود."],[344,"تا رهیم از حبس و تنگی و ز کار","هست او چون سنگ خارا بر قرار","برای رهایی از حبس و تنگناها، باید مانند سنگ خارا (سنگ سخت و محکم) ثابت و پایدار باشیم."],[344,"آن یکی زیرکتر این تدبیر کرد","که بگوید اوستا چونی تو زرد","شخصی زیرک به معلم (اوستا) می‌گوید که حال تو چگونه است، در حالی که او با ظاهری زرد و ناتوان به نظر می‌رسد. این جمله به نوعی ابراز نگرانی و جلب توجه به وضعیت معلم است."],[344,"خیر باشد رنگ تو بر جای نیست","این اثر یا از هوا یا از تبیست","رنگ و حال تو خوب است، اما این تأثیر و حالت یا ناشی از هوای بیرون است یا به خاطر بیماری."],[344,"اندکی اندر خیال افتد ازین","تو برادر هم مدد کن این‌چنین","برادر، گاهی در ذهن و خیال خود به این نحو فکر کن و از چنین فکر کمک بگیر."],[344,"چون درآیی از در مکتب بگو","خیر باشد اوستا احوال تو","وقتی که از در مکتب می‌رسی، با احترام و خوبی از استاد بپرس که حالش چطور است و او را خبر کن."],[344,"آن خیالش اندکی افزون شود","کز خیالی عاقلی مجنون شود","آن اندیشه و خیال او کم‌کم بیشتر می‌شود تا جایی که از خیالی که عاقل است، به وضعیتی دیوانه‌وار تبدیل می‌شود."],[344,"آن سوم و آن چارم و پنجم چنین","در پی ما غم نمایند و حنین","سوم و چهارم و پنجم آن‌ها (شمارش اعداد به صورت غیررسمی اشاره به تعداد چیزها دارد) به‌دنبال ما به شدت غمگین و ناله‌کنان هستند."],[344,"تا چو سی کودک تواتر این خبر","متفق گویند یابد مستقر","اگر چندین کودک این خبر را یکصدا و با توافق بگویند، آن خبر به‌طور قطع و یقین به تأسیس و تثبیت می‌رسد."],[344,"هر یکی گفتش که شاباش ای ذکی","باد بختت بر عنایت متکی","هر کدام از آن‌ها به او گفتند: «تبریک باد، ای باهوش! بخت تو به کمک رحمت و لطف خداوند نشسته است."],[344,"متفق گشتند در عهد وثیق","که نگرداند سخن را یک رفیق","همه در یک پیمان محکم توافق کردند که هیچ‌کدام از رفقا سخنی را بر علیه یکدیگر نزنند."],[344,"بعد از آن سوگند داد او جمله را","تا که غمازی نگوید ماجرا","سپس او (معلم) به همه‌ی آن‌ها سوگند داد که هیچ‌کس ماجرا را غمازی نکند و درباره‌ی آن صحبت نکند."],[344,"رای آن کودک به‌چربید از همه","عقل او در پیش می‌رفت از رمه","عقل و درک کودک به اندازه‌ای قوی است که از همه عقل‌ها جلو می‌افتد و این نشان می‌دهد که او به راحتی از دیگران تأثیر می‌پذیرد و به خاطر رفتار و احساسات آنها دلسرد یا خوشحال می‌شود."],[344,"آن تفاوت هست در عقل بشر","که میان شاهدان اندر صور","در میان انسان‌ها، تفاوت‌هایی در عقل و درک وجود دارد که سبب می‌شود شاهدان و ناظرانی که در حال تماشای چیزی هستند، هرکدام آن را به صورت‌های مختلفی ببینند و درک کنند."],[344,"زین قبل فرمود احمد در مقال","در زبان پنهان بود حسن رجال","پیامبر اسلام، احمد، در سخنانش اشاره کرده است که در کلام، زیبایی‌های مردان پنهان است."],[345,"اختلاف عقلها در اصل بود","بر وفاق سنیان باید شنود","اختلاف عقل‌ها به طور طبیعی و ذاتی است و این موضوع باید بر اساس باور اهل سنت مورد توجه قرار گیرد."],[345,"بر خلاف قول اهل اعتزال","که عقول از اصل دارند اعتدال","بر خلاف نظر معتزله که معتقدند عقل‌ها به طور طبیعی و از ابتدا در یک سطح و متعادل هستند، مولانا می‌گوید که عقل‌ها در فطرت و ذات خود متفاوت‌اند."],[345,"تجربه و تعلیم بیش و کم کند","تا یکی را از یکی اعلم کند","تجربه و آموزش باعث می‌شوند که افراد در دانش و فهم با یکدیگر تفاوت پیدا کنند و با این تفاوت، برخی از آن‌ها در علم بر دیگران برتری یابند."],[345,"باطلست این زانک رای کودکی","که ندارد تجربه در مسلکی","نظر و قضاوت یک کودک که تجربه‌ای ندارد، نادرست و بی‌اساس است و نمی‌توان به آن اعتماد کرد."],[345,"بر دمید اندیشه‌ای زان طفل خرد","پیر با صد تجربه بویی نبرد","اندیشه کودکانه، که هنوز تجربه‌ای از زندگی ندارد، حتی با وجود بلوغ سنی و سال‌ها تجربه، از درک واقعیات ناتوان است و نمی‌تواند بوی حقیقت را حس کند."],[345,"خود فزون آن به که آن از فطرتست","تا ز افزونی که جهد و فکرتست","خود فطرت و طبیعت انسانی با ارزش‌تر از آن چیزی است که به واسطه‌ی کوشش و تلاش به دست می‌آید، چراکه دانایی و هوش در اصل به ذات و فطرت مربوط می‌شود و نه تنها به زحمت و علم که کسب شده است."],[345,"تو بگو داده خدا بهتر بود","یاکه لنگی راهوارانه رود","آیا این که خداوند چیزی به انسان داده است، از پیش‌فرض‌های او بهتر است یا اینکه توانایی و تلاش انسان برای پیشرفت و حرکت در زندگی، مهم‌تر است؟"],[346,"روز گشت و آمدند آن کودکان","بر همین فکرت ز خانه تا دکان","کودکان به همین فکر و خیال، از خانه به سمت دکان آمدند و منتظر شدند."],[346,"جمله استادند بیرون منتظر","تا درآید اول آن یار مصر","همه کودکان در بیرون ایستاده و منتظر هستند تا اولین دوست خود، که یار آن‌هاست، وارد شود."],[346,"زانک منبع او بدست این رای را","سر امام آید همیشه پای را","چون آن نور و منبع، امام است، همیشه پایی که باید بر زمین بگذارد، از این رأی و نظر استفاده می‌کند."],[346,"ای مقلد تو مجو بیشی بر آن","کو بود منبع ز نور آسمان","ای تقلیدکننده، به چیزی بیش از آنکه منبع نور آسمان است نپرداز."],[346,"او در آمد گفت استا را سلام","خیر باشد رنگ رویت زردفام","شخصی وارد شد و به استاد سلام کرد و گفت: «آیا حال شما خوب است؟» در حالی که چهره‌اش رنگ و رویی زرد و نگران داشت."],[346,"گفت استا نیست رنجی مر مرا","تو برو بنشین مگو یاوه هلا","استاد گفت: «من هیچ رنجی از تو ندارم، تو برو و بنشین و حرف‌های بی‌خود نزن."],[346,"نفی کرد اما غبار وهم بد","اندکی اندر دلش ناگاه زد","استاد من (مولانا) گفتم که هیچ رنجی برای من نیست، اما ناگهان در دل او غبار وهم بدی به وجود آمد که نمی‌توان آن را انکار کرد."],[346,"اندر آمد دیگری گفت این چنین","اندکی آن وهم افزون شد بدین","دیگری وارد شد و گفت که اینگونه، اندکی از آن وهم بیشتر شد."],[346,"همچنین تا وهم او قوت گرفت","ماند اندر حال خود بس در شگفت","وقتی وهمی که استاد ایجاد کرده، قوی‌تر شد، آن شخص (کودک) در وضعیت خود باقی ماند و بسیار حیرت‌زده شد."],[347,"سجده خلق از زن و از طفل و مرد","زد دل فرعون را رنجور کرد","سجده و احترام مردم، چه زن، چه کودک و چه مرد، دل فرعون را آزرده و نگران کرد."],[347,"گفتن هریک خداوند و ملک","آنچنان کردش ز وهمی منهتک","فرعون گفت هر یک از مردم، به خود خدا و پادشاهی خود اعتبار دادند، و همین تصور او را از خیال و توهم خود بی‌حیا و بی‌پرواتر کرد."],[347,"که به دعوی الهی شد دلیر","اژدها گشت و نمی‌شد هیچ سیر","فرعون به خاطر ادعای خدایی‌اش به شدت جسور و بی‌پروا شد، اما همچنان با وجود این جسارت، درونش مانند اژدهایی در حال غرش، ناراضی و آشفته بود و هیچ آرامشی نداشت."],[347,"عقل جزوی آفتش وهمست و ظن","زانک در ظلمات شد او را وطن","عقل جزئی انسان به خاطر توهم و گمان دچار مشکل می‌شود، زیرا او در تاریکی جهل زندگی می‌کند و این حالتی از بی‌خبری برایش ایجاد می‌کند."],[347,"بر زمین گر نیم گز راهی بود","آدمی بی وهم آمن می‌رود","اگر بر روی زمین حتی نیم گز راهی وجود داشته باشد، انسانی که از وهم رهایی یافته باشد می‌تواند با اطمینان و امنیت از آن عبور کند."],[347,"بر سر دیوار عالی گر روی","گر دو گز عرضش بود کژ می‌شوی","انسان اگر بر دیوار بلندی بایستد، حتی اگر دو گام از آن فاصله بگیرد، دچار انحراف و کژتابی می‌شود. این به نوعی به خطرات ناشی از بلندپروازی و افتادن از جایگاه اشاره دارد."],[347,"بلک می‌افتی ز لرزه دل به وهم","ترس وهمی را نکو بنگر بفهم","دل تو به خاطر ترس، لرزیده و به وهمی دچار شده است. اما باید این وهم را به درستی بشناسی و درکش کنی تا بتوانی از آن بگذری."],[348,"گشت استا سست از وهم و ز بیم","بر جهید و می‌کشانید او گلیم","استاد به خاطر وهم و ترسش ضعیف و سست شد و در حالتی آشفته از جا پرید و تندی می‌کرد، مانند کسی که در حال نوشیدن می‌خواهد گلیم (فرش) خود را بکشاند."],[348,"خشمگین با زن که مهر اوست سست","من بدین حالم نپرسید و نجست","او با اینکه خشمگین بود، از حال من که به خاطر مهرش ضعیف و ناتوان شده‌ام، نپرسید و به من توجه نکرد."],[348,"خود مرا آگه نکرد از رنگ من","قصد دارد تا رهد از ننگ من","او مرا از حال و رنگ‌وبویم مطلع نکرده و هدفش این است که از عیب و ننگ من فرار کند."],[348,"او به حسن و جلوه خود مست گشت","بی‌خبر کز بام افتادم چو طشت","او به‌قدری مجذوب زیبایی و جلوه خود شده که از واقعیت بی‌خبر است و متوجه نیست که من، مانند طشتی (ظرفی) که از بام بیفتد، در حالت سقوط و سرگردانی قرار دارم."],[348,"آمد و در را به‌تندی وا گشاد","کودکان اندر پی آن اوستاد","او (اوستاد) به سرعت وارد شد و در را با شدت باز کرد و کودکان هم به‌دنبال او (اوستاد) وارد شدند."],[348,"گفت زن خیرست چون زود آمدی","که مبادا ذات نیکت را بدی","او گفت: زن (همسر) خوب است زیرا که سریعا به ملاقات من آمدی، تا مبادا به ذات نیکوی تو آسیب برسد."],[348,"گفت کوری رنگ و حال من ببین","از غمم بیگانگان اندر حنین","گفت: ای کسی که نمی‌تونی حال و رنگ من را ببینی، حال من را از غصه‌ام درک کن، زیرا در دل من فریاد و ناله‌ای وجود دارد که بیگانگان هم آن را حس می‌کنند."],[348,"تو درون خانه از بغض و نفاق","می‌نبینی حال من در احتراق","تو در دل خانه به خاطر کینه و دشمنی نمی‌توانی حالت آتشین من را ببینی."],[348,"گفت زن ای خواجه عیبی نیستت","وهم و ظن لاش بی معنیستت","زن به مرد می‌گوید: تو عیب و نقصی نداری، این افکاری که در ذهنت است و باعث شک و تردید می‌شود، بی‌معنی است."],[348,"گفتش ای غر تو هنوزی در لجاج","می‌نبینی این تغیر و ارتجاج","او به غرور شخصی اشاره می‌کند و می‌گوید: تو هنوز در لجاج و stubbornness خود باقی هستی و تغییرات و نوساناتی که در اطراف رخ می‌دهد را نمی‌بینی."],[348,"گر تو کور و کر شدی ما را چه جرم","ما درین رنجیم و در اندوه و گرم","اگر تو نابینا و ناشنوا شده‌ای، ما چه گناهی داریم که در این درد و اندوه گرفتاریم؟"],[348,"گفت ای خواجه بیارم آینه","تا بدانی که ندارم من گنه","اولیای خدا به شخصی می‌گویند که ای آقای محترم، من آینه‌ای برای تو می‌آورم تا ببینی که من هیچ گناهی ندارم."],[348,"گفت رو مه تو رهی مه آینت","دایما در بغض و کینی و عنت","او به کسی می‌گوید که تو در میانت از حسد و کینه و دشمنی رنجوری، و به دنبال خوبی و صفای دل نیستی. در حقیقت، تو با این حال، خود را از نور و خوبی دور می‌کنی."],[348,"جامه خواب مرا زو گستران","تا بخسپم که سر من شد گران","من به خواب رفتم و جامه خوابم را از او (استاد) گسترش بده، چرا که حالا سرم سنگین و خسته شده است."],[348,"زن توقف کرد مردش بانگ زد","کای عدو زوتر تو را این می‌سزد","زن متوقف شد و مرد او را صدا زد و گفت: ای دشمن، این کار برای تو مناسب‌تر است که سریع‌تر به حرکت درآیی."],[349,"جامه خواب آورد و گسترد آن عجوز","گفت امکان نه و باطن پر ز سوز","زن سال‌خورده‌ای، که به او «عجوز» گفته می‌شود، لباس خواب را آورد و به‌دقت گستراند. او گفت که امکان ندارد (منظور از لباس خریداری شده) و دلش پر از آتش و اندوه است."],[349,"گر بگویم متهم دارد مرا","ور نگویم جد شود این ماجرا","اگر بگویم که متهم (به نابسامانی و مشکل) هستم، شما این را قبول می‌کنید، اما اگر چیزی نگویید، این مشکل پیچیده‌تر می‌شود و به جدیت و سنگینی دیگری می‌رسد."],[349,"فال بد رنجور گرداند همی","آدمی را که نبودستش غمی","فال بد انسان را رنجور و ناراحت می‌کند، حتی اگر او هیچ غمی نداشته باشد."],[349,"قول پیغامبر قبوله یفرض","ان تمارضتم لدینا تمرضوا","پیامبر (حضرت محمد) می‌گوید اگر شما بخواهید به خودتان وانمود کنید که بیمار هستید، ما نیز به شما بیمارگونه رفتار خواهیم کرد."],[349,"گر بگویم او خیالی بر زند","فعل دارد زن که خلوت می‌کند","اگر بگویم که او فقط خیال است، کارها و افعالی دارد که این زن انجام می‌دهد و به همین دلیل در تنهایی (خلوت) خود را پنهان می‌کند."],[349,"مر مرا از خانه بیرون می‌کند","بهر فسقی فعل و افسون می‌کند","وهم و خیال مرا از خانه خارج می‌کند، و به خاطر گناه و انحراف، با افعالی جادویی و فریبنده من را تحت تأثیر قرار می‌دهد."],[349,"جامه خوابش کرد و استاد اوفتاد","آه آه و ناله از وی می‌بزاد","استاد به خواب رفت و در حالت خواب، ناله و آه‌های او بلند شد."],[349,"کودکان آنجا نشستند و نهان","درس می‌خواندند با صد اندهان","کودکان در آنجا نشسته بودند و پنهانی درس می‌خواندند، در حالی که صدای ناله استاد به گوش می‌رسید."],[349,"کین همه کردیم و ما زندانییم","بد بنایی بود ما بد بانییم","ما همه این کارها را انجام دادیم، اما همچنان در بند و زندانی هستیم؛ علت این موضوع به ساخت و ساز بد است، چون ما خودمان بنیاد و بنیان‌گذار کارهای نادرست بوده‌ایم."],[350,"گفت آن زیرک که ای قوم پسند","درس خوانید و کنید آوا بلند","زیرک در اینجا به جمعیت می‌گوید که درس بخوانند و صدای بلندتر از خود را ایجاد کنند تا استادشان (عبارت برانگیزاننده) از خواندن قرآن دلسرد نشود."],[350,"چون همی‌خواندند گفت ای کودکان","بانگ ما استاد را دارد زیان","استاد می‌گوید: وقتی شما (کودکان) بلند آواز می‌خوانید، صدای ما برای معلم دردسر ایجاد می‌کند و به او آسیب می‌زند."],[350,"درد سر افزاید استا را ز بانگ","ارزد این کو درد یابد بهر دانگ","استاد می‌گوید که اگر صدای ما باعث آزردگی او شود، این صدای ما ارزشش را ندارد، چون او درد و اندوهی را برای ما تحمل می‌کند."],[350,"گفت استا راست می‌گوید روید","درد سر افزون شدم بیرون شوید","استاد راست می‌گوید که من در پی آن هستم که درد و رنج بیشتری به زندگی‌ام اضافه شود و از این وضعیت خارج شوم."],[351,"سجده کردند و بگفتند ای کریم","دور بادا از تو رنجوری و بیم","آن‌ها به سجده افتادند و گفتند: ای بخشنده بزرگ، آرزو داریم که رنج و ترس از تو دور باشد."],[351,"پس برون جستند سوی خانه‌ها","همچو مرغان در هوای دانه‌ها","سپس مانند پرندگان که به دانه‌ها مشتاقند، به‌سرعت به سوی خانه‌های خود بیرون رفتند."],[351,"مادرانشان خشمگین گشتند و گفت","روز کتاب و شما با لهو جفت","مادران آن کودکان عصبانی شدند و گفتند که روز مدرسه است و شما با سرگرمی و شادی در حال بازی هستید."],[351,"عذر آوردند کای مادر تو بیست","این گناه از ما و از تقصیر نیست","گفتند که ای مادر، تو بیست ساله‌ای و ما در این خطا نقشی نداریم؛ مقصر از ما نیستیم و تقصیری نداریم."],[351,"از قضای آسمان استاد ما","گشت رنجور و سقیم و مبتلا","استاد ما بر اثر تقدیر الهی بیمار و ناتوان شده و در سختی و ناراحتی قرار گرفته است."],[351,"مادران گفتند مکرست و دروغ","صد دروغ آرید بهر طمع دوغ","مادران گفتند که این ماجرای استاد مکر و دروغی است و گفته‌های او برای فریب و رسیدن به طمع و سود است."],[351,"ما صباح آییم پیش اوستا","تا ببینیم اصل این مکر شما","ما صبح زود به پیش معلم می‌رویم تا ببینیم ریشه و حقیقت این دروغ شما چیست."],[351,"کودکان گفتند بسم الله روید","بر دروغ و صدق ما واقف شوید","کودکان می‌گویند که در آغاز باید نام خدا را ببریم و شما به حقیقت دروغ و صدق ما پی ببرید."],[352,"بامدادان آمدند آن مادران","خفته استا همچو بیمار گران","صبح زود، آن مادران به عیادت استاد آمدند در حالی که او به شدت خواب‌آلود و بیمار به نظر می‌رسید."],[352,"هم عرق کرده ز بسیاری لحاف","سر ببسته رو کشیده در سجاف","استاد به خاطر بیماری بسیار عرق کرده و لحاف را تا روی سرش کشیده و به خواب رفته است."],[352,"آه آهی می‌کند آهسته او","جملگان گشتند هم لا حول‌گو","او به آرامی آه می‌کشد و دیگران هم به دلیل شنیدن آه او، بی‌اختیار می‌گوید «لا حول ولاقوه» که به معنای ناتوانی و بی‌اختیاری است."],[352,"خیر باشد اوستاد این درد سر","جان تو ما را نبودست زین خبر","اوستاد (استاد) می‌گوید این درد و نگرانی برای جان تو، برای ما خیری دارد و ما از این خبر (از وضعیت تو) بی‌اطلاع بودیم."],[352,"گفت من هم بی‌خبر بودم ازین","آگهم مادر غران کردند هین","گفت من هم از این مسئله آگاه نبودم و مادرم با نارضایتی مرا به شدت دعوت کرد تا به موضوع توجه کنم."],[352,"من بدم غافل به‌شغل قال و قیل","بود در باطن چنین رنجی ثقیل","من خودم ناآگاه بودم و درگیر مباحث و مسابقات ظاهری زندگی بودم، در حالی که در درونم چنین درد و رنج سنگینی وجود داشت."],[352,"چون به‌جد مشغول باشد آدمی","او ز دید رنج خود باشد عمی","زمانی که انسان به‌طور جدی در کاری مشغول باشد، نمی‌تواند به رنج‌ها و مشکلات خود توجه کند و آنها را ببیند."],[352,"از زنان مصر یوسف شد سمر","که ز مشغولی بشد زیشان خبر","زنان مصری درباره یوسف خبر نداشتند، زیرا به شدت در کارها و سرگرمی‌های خود مشغول بودند."],[352,"پاره پاره کرده ساعدهای خویش","روح واله که نه پس بیند نه پیش","افرادی که دلتنگ و پریشان‌حال هستند، به‌خود آسیب می‌زنند و به خاطر غم و اندوه نتوانسته‌اند وضعیت خود را به درستی درک کنند؛ زیرا نه به گذشته می‌توانند برگردند و نه به آینده امیدوارند."],[352,"ای بسا مرد شجاع اندر حراب","که ببرد دست یا پایش ضراب","بسیاری از مردان دلیر در میدان جنگ ممکن است دستان یا پاهایشان را از دست بدهند، اما شجاعت و دلیری آنها همچنان باقی می‌ماند."],[352,"او همان دست آورد در گیر و دار","بر گمان آنک هست او بر قرار","انسان در شرایط و چالش‌های سخت، معمولا متوجه چیزی نمی‌شود که ممکن است از دست داده باشد؛ او فکر می‌کند که آن چیز همچنان نزد اوست و از وجودش بی‌خبر است."],[352,"خود ببیند دست رفته در ضرر","خون ازو بسیار رفته بی‌خبر","او باید ببیند که وقتی دستش را در خطر می‌زند، چقدر خون از او رفته است، بدون اینکه خود متوجه شود."],[353,"تا بدانی که تن آمد چون لباس","رو بجو لابس، لباسی را ملیس","بدان که بدن مانند لباسی است که روح آن را به تن کرده است، پس به دنبال کسی باش که این لباس را پوشیده و از آن استفاده می‌کند."],[353,"روح را توحید الله خوشترست","غیر ظاهر دست و پای دیگرست","روح برای خداوند یگانه، بهتر از تعلق به جسم است، زیرا دست و پای ظاهری تنها بخشی از وجود دنیوی هستند."],[353,"دست و پا در خواب بینی و ایتلاف","آن حقیقت دان مدانش از گزاف","اگر در خواب دست و پا ببینی، نباید آن را حقیقتی واقعی تلقی کنی، چون این‌ها تنها نشانه‌هایی از وجود روح هستند و نباید جدی گرفته شوند."],[353,"آن توی که بی بدن داری بدن","پس مترس از جسم و جان بیرون شدن","تو که بدون بدن هستی، نباید بر این موضوع بترسی که ممکن است روح از جسم و جان خارج شود."],[354,"بود درویشی به کهساری مقیم","خلوت او را بود هم خواب و ندیم","در آن کوهسار، درویشی زندگی می‌کرد که در تنهایی خود، دوستان و همراهانش خواب و راحتی را با او تجربه می‌کردند."],[354,"چون ز خالق می‌رسید او را شمول","بود از انفاس مرد و زن ملول","چون این درویش به‌خدا نزدیک می‌شود و از او بهره‌مند می‌گردد، به خاطر وجود نفس‌های مردان و زنان به حالتی ناراحت و بی‌حوصلگی دچار می‌شود."],[354,"همچنانک سهل شد ما را حضر","سهل شد هم قوم دیگر را سفر","چنان‌که حضور نزد ما آسان شد، برای دیگران نیز سفر به دور از ما آسان گردید."],[354,"آنچنانک عاشقی بر سروری","عاشقست آن خواجه بر آهنگری","عاشق به عشق خود، همان‌گونه وابسته و دل‌باخته است که یک استاد کار (آهنگر) به حرفه‌اش و کار خود التماس می‌کند و به آن عشق می‌ورزد."],[354,"هر کسی را بهر کاری ساختند","میل آن را در دلش انداختند","هر کس برای کاری خاص خلق شده و تمایلی در دل او نسبت به آن کار قرار داده شده است."],[354,"دست و پا بی میل جنبان کی شود","خار و خس بی آب و بادی کی رود","وقتی انسان به خواست درونی‌اش عمل نکند، مانند گیاهان بی‌آب و باد می‌ماند که نمی‌توانند رشد کنند. بنابراین، دستیابی به خواسته‌ها و میل‌های حقیقی، نیازمند حرکت و تلاش است."],[354,"گر ببینی میل خود سوی سما","پرّ دولت برگشا، همچون هما","اگر تمایل خود را به سوی آسمان می‌کنی، دروازه خوشبختی را بگشای، مانند پرنده‌ای بزرگ و خوش پرواز که از آسمان سر بر می‌آورد."],[354,"ور ببینی میل خود سوی زمین","نوحه می‌کن هیچ منشین از حنین","اگر ببینی که تمایل خود را به سمت زمین (دنیا) داری، از این وضعیت ناراحت نشو و از غم و اندوه فریاد مزن."],[354,"عاقلان خود نوحه‌ها پیشین کنند","جاهلان آخر به سر بر می‌زنند","عاقل‌ها در درد و اندوه خود به پیشواز مصیبت‌ها می‌روند و برای آن نوحه‌سرایی می‌کنند، ولی نادان‌ها در آخر کار و زمانی که مشکل پیش می‌آید، فقط به سر خود می‌زنند و احساس تاسف می‌کنند."],[354,"ز ابتدای کار آخر را ببین","تا نباشی تو پشیمان یوم دین","از همان آغاز کار، به پایان آن توجه کن تا در روز قیامت پشیمان نشوی."],[355,"آن یکی آمد به پیش زرگری","که ترازو ده که بر سنجم زری","مردی به پیش زرگری آمد و گفت: ای زرگر، میزان (ترازوی) تو کجاست تا بتوانم طلا را وزن کنم؟"],[355,"گفت خواجه رو مرا غربال نیست","گفت میزان ده برین تسخر مه‌ایست","زرگر گفت: «ای آقا، من غربالی ندارم و درست نمی‌توانم طلا را بسنجم، اما اگر می‌خواهی، ترازو بده که من می‌توانم با آن هوش و ذکاوت خود را به کار ببرم."],[355,"گفت جاروبی ندارم در دکان","گفت بس بس این مضاحک را بمان","زرگر گفت که من جاروبی برای تمیز کردن در دکان ندارم و به همین دلیل به او که زیاد مزاحمت ایجاد می‌کند، می‌گوید که کافی است و می‌تواند همین‌طور بماند."],[355,"من ترازویی که می‌خواهم بده","خویشتن را کر مکن هر سو مجه","من می‌خواهم ترازویی به خودم بدهم، اما تو آن را به یک طرف نبر و به من اجازه نده که از مسیر خود منحرف شوم."],[355,"گفت بشنیدم سخن کر نیستم","تا نپنداری که بی معنیستم","گفت: من سخن تو را شنیدم و بی‌صدا نیستم، تا تصور نکنی که نمی‌توانم معنی آن را درک کنم."],[355,"این شنیدم لیک پیری مرتعش","دست لرزان جسم تو نامنتعش","این را شنیدم، اما پیرمردی هست که دستش می‌لرزد و به خاطر لرزش دست تو، جسم تو پایدار نمی‌ماند."],[355,"وان زر تو هم قراضه خرد مرد","دست لرزد پس بریزد زر خرد","زر تو هم همانند تکه‌های کوچک و بی‌ارزش است؛ اگر مردی در دستش بلرزد، این تکه‌ها هم می‌ریزند و به آسانی از دست می‌روند."],[355,"پس بگویی خواجه جاروبی بیار","تا بجویم زر خود را در غبار","پس به زرگر می‌گویی که جاروبی بیاورد تا بتوانم طلای خود را در گرد و غبار پیدا کنم."],[355,"چون بروبی خاک را جمع آوری","گوییم غلبیر خواهم ای جری","وقتی که با جاروب خاک را جمع می‌کنی، به من بگو که من به تو می‌گویم: ای جری، می‌خواهم زر خود را پیدا کنم."],[355,"من ز اول دیدم آخر را تمام","جای دیگر رو ازینجا والسلام","من از ابتدا، پایان کار را دیدم و برای همین، به هیچ چیز دیگری توجه نمی‌کنم و از اینجا می‌روم."],[356,"اندر آن که بود اشجار و ثمار","بس مرودی کوهی آنجا بی‌شمار","در آن کوه درختان و میوه‌های زیادی وجود داشت، و در آنجا افراد بسیاری از مروندی (نوعی میوه جنگلی) بودند."],[356,"گفت آن درویش یا رب با تو من","عهد کردم زین نچینم در زمن","آن درویش به خداوند می‌گوید که من با تو پیمان بسته‌ام که در این زمان میوه نچینم."],[356,"جز از آن میوه که باد انداختش","من نچینم از درخت منتعش","تنها میوه‌ای که باد از درخت به زمین انداخته باشد را می‌چینم و غیر از آن، به هیچ میوه‌ای دست نخواهم زد."],[356,"مدتی بر نذر خود بودش وفا","تا در آمد امتحانات قضا","مدتی به عهد و نذر خود پایبند بود تا اینکه امتحاناتی از سوی قضا برایش پیش آمد."],[356,"زین سبب فرمود استثنا کنید","گر خدا خواهد به پیمان بر زنید","بخاطر همین موضوع، خداوند فرمان داده که تمام این نذرها را استثنا کنید و اگر خدا بخواهد، درباره پیمانی که بسته‌اید، مجدد فکر کنید."],[356,"هر زمان دل را دگر میلی دهم","هرنفس بر دل دگر داغی نهم","هر بار که دل به سمت چیزی میل پیدا می‌کند، هر نفس بر دل حسرت یا غمی جدید وارد می‌کنم."],[356,"کل اصباح لنا شان جدید","کل شیء عن مرادی لا یحید","همه صبح‌ها برای ما حال و وضع جدیدی به وجود می‌آید و هیچ چیزی از خواسته‌ ما منحرف نمی‌شود."],[356,"در حدیث آمد که دل همچون پریست","در بیابانی اسیر صرصریست","در اینجا گفته می‌شود که دل انسان مانند پرنده‌ای است که در بیابانی بی‌پناه گرفتار طوفانی شدید و سرگردان شده است. این تصویر بیانگر بی‌قراری و عدم آرامش دل در شرایط سخت و دشوار زندگی است."],[356,"باد پر را هر طرف راند گزاف","گه چپ و گه راست با صد اختلاف","باد چادر (پر یا بال) را بی‌هدف به این سو و آن سو می‌زند، گاهی به سمت چپ و گاهی به سمت راست، با تفاوت‌های فراوان."],[356,"در حدیث دیگر این دل دان چنان","کآب جوشان ز آتش اندر قازغان","در سخن دیگری این دل را بشناس، مانند آبی است که از حرارت در دیگ به جوش آمده است."],[356,"هر زمان دل را دگر رایی بود","آن نه از وی لیک از جایی بود","هر لحظه دل انسان نظری و خواسته‌ای متفاوت دارد، و این خواسته‌ها از خود دل نیست، بلکه از جایی دیگر نشأت می‌گیرد."],[356,"پس چرا آمن شوی بر رای دل","عهد بندی تا شوی آخر خجل","چرا بر نظر دل خود اطمینان می‌کنی و به آن اعتماد می‌کنی، وقتی که به آن عهدی بسته‌ای که در پایان باعث خجالتت می‌شود؟"],[356,"این هم از تاثیر حکمست و قدر","چاه می‌بیینی و نتوانی حذر","این وضعیت نیز نتیجه تقدیر و سرنوشت است؛ تو چاه را می‌بینی اما نمی‌توانی از آن دوری کنی."],[356,"نیست خود از مرغ پران این عجب","که نبیند دام و افتد در عطب","عجبی ندارد که کسی که از پرواز و آزادی خود آگاهی ندارد، دام را نبیند و به دام بیفتد."],[356,"این عجب که دام بیند هم وتد","گر بخواهد ور نخواهد می‌فتد","عجب است که حتی اگر انسان دام را ببیند، باز هم به سمت آن می‌رود و در آن می‌افتد، چه بخواهد و چه نخواهد."],[356,"چشم باز و گوش باز و دام پیش","سوی دامی می‌پرد با پر خویش","آدم باید با چشمانی باز و گوش‌هایی شنوا به دام‌های پیش رو نگاه کند، اما با این حال، گاهی به خاطر غفلت، خود را به دام می‌اندازد و در آن گرفتار می‌شود."],[357,"بینی اندر دلق مهتر زاده‌ای","سر برهنه در بلا افتاده‌ای","می‌بینی که در لباس و دلق شخص بزرگ‌زاده‌ای، که باید با وقار و آراستگی باشد، فردی بی‌سرپوش و برهنه در سختی و مشکل به سر می‌برد."],[357,"در هوای نابکاری سوخته","اقمشه و املاک خود بفروخته","در شرایط بد و دشوار، دارایی‌ها و املاک خود را برای رهایی از مشکل به فروش گذاشته است."],[357,"خان و مان رفته شده بدنام و خوار","کام دشمن می‌رود ادبیروار","خانه و مقام از دست رفته با ننگ و خفت است، و کام دشمن نیز با فوت ادبی و درخشان به‌دست می‌آید."],[357,"زاهدی بیند بگوید ای کیا","همتی می‌دار از بهر خدا","زاهدی، که فردی دیندار و پارساست، به شخصی می‌گوید: ای بزرگوار، برای خدا عزت و همت والایی داشته باش."],[357,"کاندرین ادبار زشت افتاده‌ام","مال و زر و نعمت از کف داده‌ام","در این وضعیت بد و ناامیدکننده که به آن دچار شده‌ام، همه دارایی‌ها و نعمت‌های مادی را از دست داده‌ام."],[357,"همتی تا بوک من زین وا رهم","زین گل تیره بود که بر جهم","به من همت و اراده‌ای عطا کن تا از این وضعیت ناخوشایند رها شوم، چون این درد و مشکل همچون گلی سیاه است که بر سر من سایه افکنده است."],[357,"این دعا می‌خواهد او از عام و خاص","کالخلاص و الخلاص و الخلاص","این دعا می‌خواهد که خداوند او را از همه چیز، چه عمومی و چه خصوصی، نجات دهد و به رهایی برساند."],[357,"دست باز و پای باز و بند نی","نه موکل بر سرش نه آهنی","انسان وقتی که آزاد و رها است، نه کسی بر او تسلط دارد و نه هیچ مانع و محدودیتی وجود دارد. او بدون قید و شرط می‌تواند زندگی کند."],[357,"از کدامین بند می‌جویی خلاص","وز کدامین حبس می‌جویی مناص","از کدام نوع وابستگی و بند آزاد شدن را می‌جویی و از کدام نوع زندانی که در آن به سر می‌بری، می‌خواهی رهایی یابی؟"],[357,"بند تقدیر و قضای مختفی","کی نبیند آن به جز جان صفی","بند تقدیر و قضا که به صورت پنهان است، جز جان پاک و خالص کسی نمی‌تواند آن را ببیند."],[357,"گرچه پیدا نیست آن در مکمنست","بتر از زندان و بند آهنست","هرچند آن تقدیر و قضا که در خفا قرار دارد، آشکار نیست، اما از زندان و بند آهنین بدتر است."],[357,"زانک آهنگر مر آن را بشکند","حفره گر هم خشت زندان بر کند","چون آهنگری هست که می‌تواند این بند و زندان را بشکند، حتی اگر هم خشت‌های زندان را بردارد."],[357,"ای عجب این بند پنهان گران","عاجز از تکسیر آن آهنگران","این عجب است که این بند پنهان، که سنگین و سخت است، از توان آهنگران که می‌توانند آن را بشکنند، عاجز و ناتوان است."],[357,"دیدن آن بند احمد را رسد","بر گلوی بسته حبل من مسد","احمد (نبی اکرم) آن بند (بند قضا و قدر) را می‌بیند که بر گلوی او (کسی که در دام قضا افتاده) به شدت بسته شده و او را در تنگنا قرار داده است."],[357,"دید بر پشت عیال بولهب","تنگ هیزم گفت حماله حطب","دیدن بر دوش همسر بولهب، که به سختی هیزم را حمل می‌کند، به گوینده این احساس را می‌دهد که او شبیه به یک کارگر باربر است که هیزم را برای دیگران حمل می‌کند."],[357,"حبل و هیزم را جز او چشمی ندید","که پدید آید برو هر ناپدید","تنها اوست که می‌تواند حبل و هیزم را ببیند و در واقع، هیچ چشم دیگری نمی‌تواند آنچه را که ناپیداست، آشکار کند."],[357,"باقیانش جمله تاویلی کنند","کین ز بیهوشیست و ایشان هوشمند","باقی‌مانده‌های آن را تفسیر می‌کنند و می‌گویند که این وضعیت از بی‌هوشی است، در حالی که آن‌ها هوشیارند."],[357,"لیک از تاثیر آن پشتش دوتو","گشته و نالان شده او پیش تو","اما از اثر آن، او به دو حال درآمده و درد و ناله‌اش را به تو نشان می‌دهد."],[357,"که دعایی همتی تا وا رهم","تا ازین بند نهان بیرون جهم","خواهان دعا و تلاشی هستم که مرا از این قید و بند پنهان رها کند و آزاد کند."],[357,"آنک بیند این علامتها پدید","چون نداند او شقی را از سعید","این شخص که این نشانه‌ها را می‌بیند، نمی‌داند که آیا شقی (بدبخت) است یا سعید (خوشبخت)."],[357,"داند و پوشد بامر ذوالجلال","که نباشد کشف راز حق حلال","خداوند (ذوالجلال) می‌داند که باید اسرار خود را پنهان نگه دارد، زیرا هیچ‌گاه فاش کردن آن‌ها مجاز نیست."],[357,"این سخن پایان ندارد آن فقیر","از مجاعت شد زبون و تن اسیر","این سخن هیچ‌گاه تمام نمی‌شود. فقیر به خاطر فقر و نیازمندی‌اش، ذلیل و بی‌چاره شده و جسمش در قید و بند گرفتار است."],[358,"پنج روز آن باد امرودی نریخت","ز آتش جوعش صبوری می‌گریخت","پنج روز، آن باد (بادی که برگ‌های درخت را می‌ریزد) امرود (میوه‌ای شیرین) نریخت و به خاطر گرسنگی و شدت گرسنگی، صبرش رو به پایان بود و فرار می‌کرد."],[358,"بر سر شاخی مرودی چند دید","باز صبری کرد و خود را وا کشید","روی یک شاخه، چند میوه امرود (آلو) دید و دوباره کمی صبر کرد و خودش را حبس کرد تا خواسته‌اش برآورده شود."],[358,"باد آمد شاخ را سر زیر کرد","طبع را بر خوردن آن چیر کرد","باد به درختی که امرود بر آن بود فشار آورد و آن را به سمت زمین خم کرد، و طبیعت انسان را به خوردن آن میوه ترغیب کرد."],[358,"جوع و ضعف و قوت جذب و قضا","کرد زاهد را ز نذرش بی‌وفا","زاهد، با گرسنگی و ضعیف شدن و همچنین قدرت جذب و قضا، به خاطر بی‌وفایی‌اش به نذر خود، در حالتی گرفتار شده است."],[358,"چونک از امرودبن میوه سکست","گشت اندر نذر و عهد خویش سست","چون میوه امرود را خورد، در وفای به نذر و عهد خود سست و ضعیف شد."],[358,"هم در آن دم گوشمال حق رسید","چشم او بگشاد و گوش او کشید","در آن لحظه، عذاب الهی به او رسید و او ناگهان چشمانش باز شد و متوجه حقیقت شد."],[359,"بیست از دزدان بدند آنجا و بیش","بخش می‌کردند مسروقات خویش","در آنجا بیست دزد وجود داشتند که اموال دزدیده شده خود را تقسیم می‌کردند و در واقع به آن کار مشغول بودند."],[359,"شحنه را غماز آگه کرده بود","مردم شحنه بر افتادند زود","شئون‌دار (شحنه) را که از دزدان خبر داشتند، آگاه ساخته بودند و به همین دلیل مردم به سرعت به او حمله کردند."],[359,"هم بدان‌جا پای چپ و دست راست","جمله را ببرید و غوغایی بخاست","زاهد را به اتهام دزدی، پای چپ و دست راستش را بریدند و در نتیجه، جوی پر سر و صدا و هیاهو به پا شد."],[359,"دست زاهد هم بریده شد غلط","پاش را می‌خواست هم کردن سقط","دست زاهد هم قطع شد، زیرا او نمی‌خواست پایش را درست کند و در اشتباهی بزرگ‌تر یعنی سقط جنین (از نظر فیزیکی یا معنوی) گرفتار شده بود."],[359,"در زمان آمد سواری بس گزین","بانگ بر زد بر عوان کای سگ ببین","در آن زمان سواری برجسته و مهم وارد شد و فریاد زد که: «ای سگ، به او توجه کن!"],[359,"این فلان شیخست از ابدال خدا","دست او را تو چرا کردی جدا","این فرد، همان شیخی است که از بندگان ویژه خداست، پس چرا دست او را قطع کردی؟"],[359,"آن عوان بدرید جامه تیز رفت","پیش شحنه داد آگاهیش تفت","آن دزد بی‌رحم، به سرعت به سمت شحنه (محل حاکم) رفت و خبر دزدی را با عجله به او گزارش داد."],[359,"شحنه آمد پا برهنه عذرخواه","که ندانستم خدا بر من گواه","شحنه (رئیس پلیس) بی‌پاپوش آمد و عذرخواهی کرد که نمی‌دانستم و اکنون خدا شاهد است که ماجرا چگونه بود."],[359,"هین بحل کن مر مرا زین کار زشت","ای کریم و سرور اهل بهشت","ای خداوند مهربان و سرور اهل بهشت، مرا از این عمل زشت رهایی بخش و آزاد کن."],[359,"گفت می‌دانم سبب این نیش را","می‌شناسم من گناه خویش را","فردی در اینجا می‌گوید که علت بدی‌ها و سوءبرداشتی که به او می‌شود را می‌داند و به خوبی از گناهان خود آگاه است."],[359,"من شکستم حرمت ایمان او","پس یمینم برد دادستان او","من حرمت ایمان او را شکستم، بنابراین، قسمم نزد دادستان او پذیرفته نیست."],[359,"من شکستم عهد و دانستم بدست","تا رسید آن شومی جرات به‌دست","من عهد و پیمان خود را شکستم و متوجه شدم که این کار به من آسیب خواهد زد، چرا که نتیجه‌ی بدی به دنبال این جسارت خواهد آمد."],[359,"دست ما و پای ما و مغز و پوست","باد ای والی فدای حکم دوست","ما از سر و دست و پا و حتی مغز و پوست‌مان هم برای اجرای فرمان دوست فداییم، ای والی."],[359,"قسم من بود این تو را کردم حلال","تو ندانستی تو را نبود وبال","من قسم خورده بودم که تو را حلال کنم، اما تو این را ندانستی و احساس نکردی که بر دوش تو گناهی نیست."],[359,"و آنک او دانست او فرمان‌رواست","با خدا سامان پیچیدن کجاست","او فهمید که فقط خداست که قدرت فرمانروایی دارد، پس تمامی ترفندها و نقشه‌ها در برابر او بی‌معنا و بی‌اثر است."],[359,"ای بسا مرغی پریده دانه‌جو","که بریده حلق او هم حلق او","خیلی از پرنده‌ها که دانه و غذایی پیدا می‌کنند، ممکن است بر اثر گرفتاری و مشکلاتی که دارند، نتوانند از آن‌ها بهره‌مند شوند و حتی گرفتار شوند، انگار که خودشان را در بند و در خطر قرار داده‌اند."],[359,"ای بسا مرغی ز معده وز مغص","بر کنار بام محبوس قفس","بسیاری از پرندگان به خاطر درد و ناراحتی در معده و دل به کنار بام قفس می‌روند و در آنجا محبوس می‌مانند."],[359,"ای بسا ماهی در آب دوردست","گشته از حرص گلو ماخوذ شست","بسیاری از ماهی‌ها در آب‌های دور از دسترس به دلیل حرص و طمعشان گرفتار و در تنگنا می‌شوند."],[359,"ای بسا مستور در پرده بده","شومی فرج و گلو رسوا شده","بسیاری از افراد هنوز در پرده پنهانی هستند، اما در واقع به سبب سرنوشت بد و رفتارهای ناپسند خود، حیثیت و آبرویشان برملا می‌شود."],[359,"ای بسا قاضی حبر نیک‌خو","از گلو و رشوتی او زردرو","بسیاری از قاضیان نیکوکار در اثر گلو و رشوه‌ای که به آن‌ها داده می‌شود، چهره‌ای زرد و ناراحت پیدا می‌کنند."],[359,"بلک در هاروت و ماروت آن شراب","از عروج چرخشان شد سد باب","هاروت و ماروت دو فرشته‌اند که در قرآن ذکر شده و به خاطر امتحانی که از انسان‌ها کردند، از عروج و نزدیکی به خدا محجور شدند. در اینجا اشاره شده که آن شراب (معنوی یا حقیقت ناب) به خاطر سقوط و دوری آن‌ها از آسمان و مقام بلندشان برای بشر قابل دسترسی شده است."],[359,"بایزید از بهر این کرد احتراز","دید در خود کاهلی اندر نماز","بایزید (بایزید بسطامی، عارف بزرگ ایرانی) به خاطر این موضوع (خودش را از گناهکاران دور نگه داشتن) احتیاط کرده است چون در خود کسالت و بی‌توجهی نسبت به نماز را می‌بیند."],[359,"از سبب اندیشه کرد آن ذو لباب","دید علت خوردن بسیار از آب","بایزید به دلیل تأمل در خود و فکر به علت نوشیدن زیاد آب، به نتیجه‌ای رسیده است. او متوجه شده که باید از دلایل این عملش آگاه شود و به تأمل در آن بپردازد."],[359,"گفت تا سالی نخواهم خورد آب","آنچنان کرد و خدایش داد تاب","شیخ تصمیم گرفت که به مدت یک سال آب نخواهد نوشید و بدین ترتیب به خدا توکل کرد و تحمل سختی را بر خود هموار ساخت."],[359,"این کمینه جهد او بد بهر دین","گشت او سلطان و قطب العارفین","این شخص، با تلاش و کوشش خود برای دین و راه حقیقت، به مقام و مرتبه‌ای بالا دست یافته و به عنوان بزرگ‌ترین عارف و پیشوای دینی شناخته می‌شود."],[359,"چون بریده شد برای حلق دست","مرد زاهد را در شکوی ببست","زمانی که دست مرد زاهد برای مجازات بریده شد، دیگر راهی برای شکایت و اعتراض باقی نماند."],[359,"شیخ اقطع گشت نامش پیش خلق","کرد معروفش بدین آفات حلق","نام شیخ به خاطر این حادثه و بریدن دستش بین مردم مشهور شد و این بلا او را در جمع مردم معروف کرد."],[360,"در عریش او را یکی زایر بیافت","کو به‌هر دو دست می زنبیل بافت","در سایه‌بان (عریش) او، یکی از زائران را دیدند که با هر دو دستش در حال بافتن زنبیل است."],[360,"گفت او را ای عدو جان خویش","در عریشم آمده سر کرده پیش","مرد زائر در عریش (سکونت‌گاه موقت) با حالتی کنایه‌آمیز به مردی که به او کینه دارد، گفت: «چرا به اینجا آمده‌ای و چرا به من نزدیک شده‌ای؟"],[360,"این چراکردی شتاب اندر سباق","گفت از افراط مهر و اشتیاق","شخصی از شتاب و عجله‌ای که در رقابت یا دویدن در مسیر عشق و محبت دیده می‌شود، می‌پرسد که چرا چنین عجله‌ای داشته است. او می‌گوید این شتاب ناشی از محبت و اشتیاق زیاد است."],[360,"پس تبسم کرد و گفت اکنون بیا","لیک مخفی دار این را ای کیا","او تبسم کرد و گفت اکنون نزد من بیا، اما این راز را مخفی نگه‌دار، ای کیا."],[360,"تا نمیرم من مگو این با کسی","نه قرینی نه حبیبی نه خسی","تا زنده‌ام، این موضوع را با هیچ‌کس در میان نگذارید؛ نه با دوست و نه با معشوق و نه با فردی کم‌ارزش."],[360,"بعد از آن قومی دگر از روزنش","مطلع گشتند بر بافیدنش","بعد از آن، گروه دیگری از طریق روزنه‌ای که در آن وجود داشت، از بافتن او آگاه شدند."],[360,"گفت حکمت را تو دانی کردگار","من کنم پنهان تو کردی آشکار","خداوند گفت که تو حکمت را می‌دانی، اما من آن را پنهان کرده‌ام و تو آن را به وضوح نشان داده‌ای."],[360,"آمد الهامش که یک چندی بدند","که درین غم بر تو منکر می‌شدند","الهام خداوند به او رسید که مدت زیادی به خاطر این غم بر او کافر می‌شدند و او را انکار می‌کردند."],[360,"که مگر سالوس بود او در طریق","که خدا رسواش کرد اندر فریق","شاید او در راه حقیقت مردم را فریب می‌داد، اما خداوند او را در جمع گروهی رسوا کرد."],[360,"من نخواهم کان رمه کافر شوند","در ضلالت در گمان بد روند","من نمی‌خواهم که آن گروه کافر شوند و در گمراهی زندگی کنند و به بدی بیندیشند."],[360,"این کرامت را بکردیم آشکار","که دهیمت دست اندر وقت کار","ما این معجزه را به‌وضوح انجام دادیم تا در زمان عمل، دستت را به‌سوی ما دراز کنیم و یاری‌ات کنیم."],[360,"تا که آن بیچارگان بد گمان","رد نگردند از جناب آسمان","تا زمانی که آن بیچاره‌های بدبین از مقام آسمانی (خدا) دور نشوند."],[360,"من تورا بی این کرامتها ز پیش","خود تسلی دادمی از ذات خویش","من پیش از این‌که معجزات و کرامات را به تو بدهم، از ذات خودم به تو آرامش می‌بخشیدم."],[360,"این کرامت بهر ایشان دادمت","وین چراغ از بهر آن بنهادمت","این کرامت را برای آنها به تو دادم و این چراغ را برای آن قرار دادم."],[360,"تو از آن بگذشته‌ای کز مرگ تن","ترسی وز تفریق اجزای بدن","تو فراتر از ترس از مرگ جسم رفته‌ای و از جدا شدن اعضای بدن خود نگرانی نداری."],[360,"وهم تفریق سر و پا از تو رفت","دفع وهم اسپر رسیدت نیک زفت","اندیشه جدا شدن سر و پا از تو کنار رفته و این تصور که باید از آن بترسی، به خوبی به تو رسیده است."],[361,"ساحران را نه که فرعون لعین","کرد تهدید سیاست بر زمین","ساحران را فرعون بدطینت به خاطر سیاست و قدرتش تهدید نکرد، بلکه انگیزه‌ای دیگر داشتند."],[361,"که ببرم دست و پاتان از خلاف","پس در آویزم، ندارمتان معاف","فرعون به ساحران می‌گوید که اگر دست و پای شما را از خطاهای‌تان قطع کنم، سپس شما را نیز معاف نخواهم کرد."],[361,"او همی‌پنداشت کایشان در همان","وهم و تخویفند و وسواس و گمان","او (فرعون) گمان می‌کرد که آنان (ساحران) در حالت ترس و توهم قرار دارند و بر اثر وسواس و گمان‌ها دچار وحشت شده‌اند."],[361,"که بودشان لرزه و تخویف و ترس","از توهمها و تهدیدات نفس","این ساحران فرعون به واسطه توهم‌ها و تهدیدات نفس خود احساس لرزه و ترس می‌کردند."],[361,"او نمی‌دانست کایشان رسته‌اند","بر دریچه نور دل بنشسته‌اند","او از این آگاه نبود که آنان (ساحران) از تاریکی رهایی یافته و بر دریچه نور دل نشسته‌اند، یعنی به روشنایی و حقیقت رسیده‌اند."],[361,"این جهان خوابست اندر ظن مه‌ایست","گر رود درخواب دستی باک نیست","این جهان همچون خواب است و در واقعیت چیزی جز خیال نیست. اگر در این خواب، دست کسی بریده شود، نگران نباشید؛ زیرا در این وهم و خیال، آسیب واقعی به کسی نمی‌رسد."],[361,"گر بخواب اندر سرت ببرید گاز","هم سرت بر جاست و هم عمرت دراز","اگر در خواب، سرت را ببرند، با این حال سر تو سرجایش هست و عمر تو نیز طولانی ادامه می‌یابد."],[361,"گر ببینی خواب در خود را دو نیم","تن‌درستی چون بخیزی، نی سقیم","اگر در خواب خود را به دو نیم ببینی، همان‌طور که در خواب به نظر می‌رسد، زمانی که بیدار شوی، چیزی در بدن تو آسیب ندیده و سالم خواهی بود."],[361,"حاصل اندر خواب نقصان بدن","نیست باک و نه دوصد پاره شدن","در خواب، نقص بدن و آسیب به آن اهمیت ندارد و ترسی از پاره‌پاره شدن نیست."],[361,"این جهان را که به‌صورت قایمست","گفت پیغامبر که حلم نایمست","این جهان که به‌ظاهر پایدار و ثابت به نظر می‌رسد، پیامبر گفته است که حقیقت آن چیزی جز خویشتن‌داری و صبر نیست."],[361,"از ره تقلید تو کردی قبول","سالکان این دیده پیدا بی رسول","تو به‌خاطر پیروی از دیگران، سالکان (راهنمایان) را قبول کرده‌ای، در حالی که این بینایی (واین نتایج) بدون وجود پیامبری مثل رسول، به‌دست آمده است."],[361,"روز در خوابی مگو کین خواب نیست","سایه فرعست اصل جز مهتاب نیست","روز را در خواب ندان که این خواب نیست؛ بلکه سایه‌ای از فرع (دنیای ظاهری) است و اصل آن چیزی جز نور مهتاب نیست که حقیقت را نشان می‌دهد."],[361,"خواب و بیداریت آن دان ای عضد","که ببیند خفته کو در خواب شد","ای عضد، تو باید بدانی که خواب و بیداری تو به چه معناست؛ زیرا کسی که در خواب به سر می‌برد، مانند کسی است که نمی‌تواند ببیند و از خواب بیرون آمده است."],[361,"او گمان برده که این دم خفته‌ام","بی‌خبر زان کوست درخواب دوم","شخصی فکر می‌کند که من در این لحظه خوابیده‌ام و بی‌خبر از آنچه در خواب دوم به وقوع می‌پیوندد."],[361,"هاون گردون اگر صد بارشان","خرد کوبد اندرین گلزارشان","اگر این دنیا (هاون گردون) صد بار هم آن‌ها (ساحران فرعون) را زیر فشار (خرد) قرار دهد، همچنان در زیبایی‌ها و نعمت‌های زندگی (گلزار) خود به سر می‌برند."],[361,"اصل این ترکیب را چون دیده‌اند","از فروع وهم کم ترسیده‌اند","آن‌ها وقتی ترکیب اصلی یعنی حقیقت را دیده‌اند، از فروع توهمات و خیالات کم‌تر می‌ترسند."],[361,"سایه خود را ز خود دانسته‌اند","چابک و چست و گش و بر جسته‌اند","ساحران فرعون سایه خود را به عنوان بخشی از وجود خود می‌بینند و به همین دلیل شجاع و چابک شده‌اند و به جلوه‌گری می‌پردازند."],[361,"کوزه‌گر گر کوزه‌ای را بشکند","چون بخواهد باز خود قایم کند","کوزه‌گر اگر کوزه‌ای را بشکند، چون بخواهد، دوباره آن را پنهان می‌کند. به عبارتی، وقتی ضرری به خود می‌زند، تلاش می‌کند تا از عواقب آن دوری کند."],[361,"کور را هر گام باشد ترس چاه","با هزاران ترس می‌آید به‌راه","انسان نابینا در هر قدم از خود می‌ترسد که به چاهی بیفتد، زیرا به خاطر نداشتن بینایی، هزاران ترس و نگرانی او را در مسیر همراهی می‌کند."],[361,"مرد بینا دید عرض راه را","پس بداند او مغاک و چاه را","مرد بینا در مسیر خود می‌تواند به خوبی عرض راه را ببیند و به همین دلیل می‌فهمد که در آنجا چاه و خطر وجود دارد."],[361,"پا و زانواش نلرزد هر دمی","رو ترش کی دارد او از هر غمی","کسی که به درستی و واضح می‌بیند، نباید در برابر مشکلات و سختی‌ها نگران باشد و دلواپس شود، زیرا او از دلخوشی و آرامش برخوردار است و هیچ غمی نمی‌تواند او را به لرزش درآورد."],[361,"خیز فرعونا که ما آن نیستیم","که به‌هر بانگی و غولی بیستیم","حرکت کن ای فرعون، زیرا ما آن افرادی نیستیم که با هر صدایی و ترس و دلهره‌ای به وحشت بیفتیم."],[361,"خرقه ما را بدر، دوزنده هست","ورنه ما را خود برهنه‌تر به است","ساحران فرعون می‌گویند که اگر لباس و نشانه‌های ما را برکنند، ما هنوز هم از درون پاک و بی‌آلایش هستیم و ارزش ما در وجودمان نهفته است، نه در ظواهر."],[361,"بی لباس این خوب را اندر کنار","خوش در آریم ای عدوّ نابکار","ما می‌خواهیم این زیبایی را بدون لباس در کنار هم قرار دهیم، ای دشمن بدکار."],[361,"خوشتر از تجرید از تن وز مزاج","نیست ای فرعون بی الهام گیج","دور شدن از بدن و ویژگی‌های جسمانی لذت‌بخش‌تر از هر چیز دیگری است، ای فرعون، که بدون الهام دچار سردرگمی هستی."],[362,"گفت استر با شتر کای خوش رفیق","در فراز و شیب و در راه دقیق","استر به شتر می‌گوید: ای رفیق خوب من، در فراز و نشیب و راه‌های سخت، تو همیشه خوشحالی و سهولت را تجربه می‌کنی."],[362,"تو نه آیی در سر و خوش می‌روی","من همی‌آیم بسر در چون غوی","شتر به استر می‌گوید که تو همیشه در مسیر راحت و خوش حرکت می‌کنی، اما من در هر قدم به سختی می‌افتم و در این وضعیت ناچارم زحمت بکشم."],[362,"من همی‌افتم به‌رو در هر دمی","خواه در خشکی و خواه اندر نمی","من هر لحظه به زمین می‌افتم، چه در خشکی و چه در دریا."],[362,"این سبب را باز گو با من که چیست","تا بدانم من که چون باید بزیست","من می‌خواهم علت این موضوع را که چرا من این‌گونه زندگی می‌کنم، برایم توضیح بدهی تا بفهمم که چگونه باید زندگی کنم."],[362,"گفت چشم من ز تو روشن‌ترست","بعد از آن هم از بلندی ناظرست","می‌گوید که چشم من، یعنی دیدگاه یا بینش من، از تو روشنتر است و بعد از آن، از بلندی و ارتفاعی که دارم، به خوبی می‌توانم اوضاع و احوال را ببینم."],[362,"چون برآیم بر سرکوه بلند","آخر عقبه ببینم هوشمند","وقتی بر فراز کوه بلندی می‌روم، در نهایت در انتهای مسیر، می‌توانم نظاره‌گر خرد و دانایی باشم."],[362,"پس همه پستی و بالایی راه","دیده‌ام را وا نماید هم اله","پس همه فراز و نشیب‌های راهی که تا کنون دیده‌ام، برایم بیان‌گر و معلوم می‌شود، و این مسئله به روشنی نشان می‌دهد که همه چیز به الهام و فهم الهی مربوط است."],[362,"هر قدم من از سر بینش نهم","از عثار و اوفتادن وا رهم","من هر گامی که برمی‌دارم، با شناخت و آگاهی است، نه با افتادن و لغزیدن."],[362,"تو ببینی پیش خود یک دو سه گام","دانه بینی و نبینی رنج دام","تو اگر چند قدم جلوتر از خودت دانه‌ای ببینی، متوجه رنج و زحمتی که در راه است نمی‌شوی."],[362,"یستوی الاعمی لدیکم و البصیر","فی المقام و النزول و المسیر","مساوی است برای شما نابینا و بینا در حال نشستن، برخاستن و حرکت کردن."],[362,"چون جنین را در شکم حق جان دهد","جذب اجزا در مزاج او نهد","وقتی خداوند جان را به جنین در رحم می‌دهد، اجزای بدن او را به طور مناسب و درست تنظیم می‌کند."],[362,"از خورش او جذب اجزا می‌کند","تار و پود جسم خود را می‌تند","این بیت به این معناست که انسان از مواد خوراکی که می‌خورد، بخشی از وجودش را می‌سازد و بدنش را از آن تغذیه می‌کند و در واقع با هر لقمه‌ای که می‌خورد، ساختار جسمش را شکل می‌دهد."],[362,"تا چهل سالش به‌جذب جزوها","حق حریصش کرده باشد در نما","در مدت چهل سال، حق (خدا) با عشق و اشتیاق به جذب و نزدیک کردن جزئیات روحش او را فراگرفته و به نمایان شدن اوضاع و احوالش کمک کرده است."],[362,"جذب اجزا روح را تعلیم کرد","چون نداند جذب اجزا شاه فرد","جذب جزءها و پیوستن به آنها روح را تعلیم می‌دهد، چون اگر فردی (شاه فرد) نتواند این پیوند را درک کند، از حقیقت دور می‌ماند."],[362,"جامع این ذره‌ها خورشید بود","بی غذا اجزات را داند ربود","جامع و گردآورنده‌ی این ذرات کهکشان‌ها خورشید است و او با از بین بردن فاصله‌ها، اجزاء را به سوی خود می‌کشاند."],[362,"آن زمانی که در آیی تو ز خواب","هوش و حس رفته را خواند شتاب","زمانی که تو از خواب بیدار شوی، باید با هوش و حواست سریعا به یاد بیاوری و توجه کنی که چه چیزهایی را فراموش کرده‌ای یا از دست داده‌ای."],[362,"تا بدانی کان ازو غایب نشد","باز آید چون بفرماید که عد","تا بفهمی که آن چیزی که از تو پنهان شده است، دوباره برمی‌گردد و وقتی برمی‌گردد که خود آن چیز (داستان یا حقیقت) به تو بگوید که چقدر سرآمده است."],[363,"هین عزیرا در نگر اندر خرت","که بپوسیدست و ریزیده برت","چشم خود را به خر عزیر (پیامبر بنی‌اسرائیل) بزن و ببین که چگونه پوسیده و متلاشی شده است."],[363,"پیش تو گرد آوریم اجزاش را","آن سر و دم و دو گوش و پاش را","اجزای خر را، که شامل سر، دم، دو گوش و پاهاست، برای تو جمع می‌کنیم."],[363,"دست نه و جزو برهم می‌نهد","پاره‌ها را اجتماعی می‌دهد","عزیر (پیامبری که داستانش در این بخش آمده) با دست خودش اجزای پراکنده خر را کنار هم می‌گذارد و آن‌ها را به هم متصل می‌کند تا دوباره جمع شوند."],[363,"در نگر در صنعت پاره‌زنی","کو همی‌دوزد کهن بی سوزنی","به دقت بنگر در هنر پاره‌دوزی؛ او که با دقت و مهارت، اجزا را به هم می‌دوزد، بدون اینکه از سوزن استفاده کند."],[363,"ریسمان و سوزنی نه وقت خرز","آنچنان دوزد که پیدا نیست درز","کار دوزندگی (ترکیب اجزا) به مانند این نیست که سوزن و ریسمان و ابزارهای عادی برای دوختن نداشته باشد، چون در کار عظیم احیا (بهشت و معاد) پرده‌ها و درزها پنهان است و این کار نیاز به ادراک عمیق‌تری دارد."],[363,"چشم بگشا حشر را پیدا ببین","تا نماند شبهه‌ات در یوم دین","چشمانت را بگشا و قیامت را به وضوح ببین تا در روز حساب، شک و تردیدی در دل نداشته باشی."],[363,"تا ببینی جامعی‌ام را تمام","تا نلرزی وقت مردن ز اهتمام","برای اینکه ببینی که چگونه همه چیز در نهایت به هم پیوسته‌است، باید تمام گوش‌ات را فراگیری تا در لحظه‌ی مرگ از نگرانی و اهمیت موضوع نلرزی."],[363,"همچنانک وقت خفتن آمنی","از فوات جمله حسهای تنی","مثل زمان خواب که انسان آرام است و از دست دادن همه حواس بدن بی‌خبر می‌شود، در موقع مرگ نیز باید آرام بود و بر حواس خود مسلط."],[363,"بر حواس خود نلرزی وقت خواب","گرچه می‌گردد پریشان و خراب","زمانی که خواب به سراغت می‌آید، نگران حواس خود نباش، حتی اگر در حالت خواب، حواست مختل و آشفته به نظر برسد."],[364,"بود شیخی رهنمایی پیش ازین","آسمانی شمع بر روی زمین","شیخی بود که مانند شمعی در زمین می‌درخشید و مردم را راهنمایی می‌کرد. او جلوه‌ای از آسمان و نور الهی بود."],[364,"چون پیمبر درمیان امتان","در گشای روضه دار الجنان","چون پیامبر در میان امت‌ها است، به بهشت و باغ‌های بهشت (دار الجنان) دسترسی و تسلط دارد."],[364,"گفت پیغامبر که شیخ رفته پیش","چون نبی باشد میان قوم خویش","پیامبر گفت که شیخ به سمت خدا رفته است، زیرا او مانند نبی (پیامبر) در میان قوم خود جایگاه خاصی دارد."],[364,"یک صباحی گفتش اهل بیت او","سخت‌دل چونی بگو ای نیک‌خو","یک روز اهالی خانه‌اش به او گفتند که تو چرا این‌قدر بی‌احساس و سخت‌دل هستی، بگو ای انسان نیکو و خوب."],[364,"ما ز مرگ و هجر فرزندان تو","نوحه می‌داریم با پشت دوتو","ما به خاطر مرگ و جدایی فرزندان تو به شدت غمگین و نوحه‌سرایی می‌کنیم و این درد را در دل داریم."],[364,"تو نمی‌گریی نمی‌زاری چرا","یا که رحمت نیست در دل ای کیا","تو چرا برای مرگ فرزندان خود گریه نمی‌کنی و بی‌تابی نشان نمی‌دهی؟ آیا به این دلیل است که در دلت رحمتی وجود ندارد ای کسی که به «ایا کیا» خطاب شده‌ای؟"],[364,"چون تورا رحمی نباشد در درون","پس چه اومیدست‌مان از تو کنون","اگر در دل تو رحمتی وجود نداشته باشد، پس حالا چه امیدی می‌توانیم از تو داشته باشیم؟"],[364,"ما باومید تویم ای پیشوا","که بنگذاری تو ما را در فنا","ما به تو امیدواریم ای پیشوا، زیرا که تو می‌توانی ما را از نابودی نجات دهی."],[364,"چون بیارایند روز حشر تخت","خود شفیع ما توی آن روز سخت","روز قیامت که تخت شفاعت تو را آراسته می‌کنند، تو تنها شفیع ما خواهی بود در آن روز دشوار."],[364,"در چنان روز و شب بی‌زینهار","ما به اکرام تویم اومیدوار","در آن روز و شب سخت و بدون پناه، ما به بزرگ‌منشی و لطف تو امیدواریم."],[364,"دست ما و دامن تست آن زمان","که نماند هیچ مجرم را امان","در آن زمان که هیچ مجرمی از عذاب و سختی در امان نباشد، ما به تو پناه می‌بریم و دست نیاز به دامنت می‌زنیم."],[364,"گفت پیغامبر که روز رستخیز","کی گذارم مجرمان را اشک‌ریز","پیامبر گفته است که در روز قیامت، زمانی که مجرمان بسیار زیاد می‌شوند، نمی‌توانم برای آنها اشک حسرت بریزم یا به حالشان گریه کنم."],[364,"من شفیع عاصیان باشم بجان","تا رهانمشان ز اشکنجه گران","من می‌خواهم شفیع (و میانجی) گنهکاران باشم تا بتوانم آنها را از عذاب سخت نجات دهم."],[364,"عاصیان واهل کبایر را بجهد","وا رهانم از عتاب نقض عهد","من در تلاش هستم که گناهکاران و مرتکبان بزرگ را از عذاب و مجازات دور کنم و آنها را از سرزنش و عواقب بد نقض پیمان نجات دهم."],[364,"صالحان امتم خود فارغ‌اند","از شفاعتهای من روز گزند","صالحان امت من در زمان بلایا و سختی‌ها از شفاعت من بی‌نیازند و خود را از نگرانی‌ها آزاد می‌بینند."],[364,"بلک ایشان را شفاعتها بود","گفتشان چون حکم نافذ می‌رود","بلکه آنها شفاعت‌هایی دارند و این بدان علت است که حکم آنها به قوت خود جاری می‌شود."],[364,"هیچ وازر وزر غیری بر نداشت","من نیم وازر خدایم بر فراشت","هیچ گناه یا بار گناهی از دیگری بر دوش من نیست و من فقط بار خدایم را به دوش دارم که آن را برمی‌دارد."],[364,"آنک بی وزرست شیخست ای جوان","در قبول حق چو اندر کف کمان","شیخی که هیچ گناه و بار خطایی بر دوش خود ندارد، جوانی است که در پذیرش حق و حقیقت مانند کمان در دست است. یعنی او به اندازه‌ای که خالی از بار گناه است، قوی‌تر می‌تواند حقیقت را درک کند."],[364,"شیخ کی بد پیر یعنی مو سپید","معنی این مو بدان ای کژ امید","شیخ کهن‌سال، کسی است که موهایش سپید شده، و این موهای سفید نماد پیری و تجربه است. بدان که این مو به معنای زندگی اوست، پس امید کژ و بی‌اساس نداشته باش."],[364,"هست آن موی سیه هستی او","تا ز هستی‌اش نماند تای مو","موی سیاه نشان‌دهنده وجود و هستی انسان است و وقتی که این هستی از بین برود، دیگر هیچ آثار و نشانه‌ای از او باقی نخواهد ماند، حتی موهایش."],[364,"چونک هستی‌اش نماند پیر اوست","گر سیه‌مو باشد او یا خود دوموست","وقتی که وجودش از بین برود، پیر، حتی اگر موهایش سیاه باشد، دیگر وجود ندارد و به حقیقت، او خود دوموست (یعنی بر اساس هستی‌اش سنجیده می‌شود نه ظاهر)."],[364,"هست آن موی سیه وصف بشر","نیست آن مو موی ریش و موی سر","موهای سیاه او نشانه انسانی‌اش نیست، زیرا آن موها صرفا موی ریش و موی سر هستند و حقیقت انسانی فراتر از ظاهر است."],[364,"عیسی اندر مهد بر دارد نفیر","که جوان ناگشته ما شیخیم و پیر","یحیی (عیسی) در مهد کودک به فریادی می‌زند که ما هنوز جوان و نرسیده به سن پیری هستیم و در حقیقت، پیری مختص وضع ظاهری ما نیست."],[364,"گر رهید از بعض اوصاف بشر","شیخ نبود کهل باشد ای پسر","اگر شیخ از برخی ویژگی‌های انسانی رهایی یابد، دیگر نمی‌تواند کهن‌سال باشد، ای پسر."],[364,"چون یکی موی سیه کان وصف ماست","نیست بر وی شیخ و مقبول خداست","اگر کسی موی سیاهی داشته باشد، این ویژگی از صفات ماست و مانع از این نمی‌شود که او شیخی باشد و نزد خداوند مقبول باشد."],[364,"چون بود مویش سپید ار با خودست","او نه پیرست و نه خاص ایزدست","اگر موی او سپید باشد، از آنجا که او با خود و درون خود یکی است، پس او نه تنها پیر نیست، بلکه مختص به خداوند نیز به شمار نمی‌آید."],[364,"ور سر مویی ز وصفش باقیست","او نه از عرش است او آفاقیست","اگر حتی یک تار موی سفید از او باقی مانده باشد، به معنای این نیست که او از آسمان و عرش است، بلکه او انسانی است که در دنیای مادی زندگی می‌کند."],[365,"شیخ گفت او را مپندار ای رفیق","که ندارم رحم و مهر و دل شفیق","شیخ به رفیقش می‌گوید که نباید او را پنداشتی که بی‌رحم و بی‌محبت است، چون او دارای محبت و دل مهربان است."],[365,"بر همه کفار ما را رحمتست","گرچه جان جمله کافر نعمتست","ما به همه کافران رحمت داریم، هرچند که تمامی جان‌های کافران نیز نعمت الهی است."],[365,"بر سگانم رحمت و بخشایش است","که چرا از سنگهاشان مالش است","بر سگ‌هایم رحم و بخشش دارم؛ زیرا از سنگ‌ها که به آن‌ها می‌زنند، کتک می‌خورند."],[365,"آن سگی که می‌گزد گویم دعا","که ازین خو وا رهانش ای خدا","من از خداوند می‌خواهم که این سگی که به مردم آسیب می‌زند، از این عادت بد رهایی یابد."],[365,"این سگان را هم در آن اندیشه دار","که نباشند از خلایق سنگسار","به این سگ‌ها هم فکر کن که در آن وضع قرار نگیرند که مردم آن‌ها را با سنگ بزنند."],[365,"زان بیاورد اولیا را بر زمین","تا کندشان رحمة للعالمین","خداوند اولیا (اولیای الهی) را به زمین فرستاد تا به وسیله آن‌ها رحمت و محبت خود را به تمامی موجودات نشان دهد و مایه نجات و بخشش آنان شود."],[365,"خلق را خواند سوی درگاه خاص","حق را خواند که وافر کن خلاص","خداوند مخلوقان را به سوی درگاه خود فراخواند و از او خواست که رهایی و نجات را برای آنها بیفزاید."],[365,"جهد بنماید ازین سو بهر پند","چون نشد گوید خدایا در مبند","انسان باید سعی کند از این سو برای دریافت پند و نصیحت تلاش کند و اگر موفق نشد، باید به خدا بگوید که او را در این راه بسته و بی‌راهه نگذارد."],[365,"رحمت جزوی بود مر عام را","رحمت کلی بود همام را","رحمت خاصی که به افراد می‌رسد، همان رحمت عمومی و همگانی نیست؛ بلکه رحمت کلی شامل همه و به‌ویژه وجود جامع و کامل مانند «همام» (که ممکن است اشاره به شخصیت یا مفهوم ویژه‌ای باشد) است."],[365,"رحمت جزوش قرین گشته به‌کل","رحمت دریا بود هادی سبل","رحمت جزئی (محدود) به هم پیوسته است و با رحمت کلی (عمومی) همراه شده است. این رحمت، مانند دریا، راهنمای مسیرها و راه‌هاست."],[365,"رحمت جزوی به‌کل پیوسته شو","رحمت کل را تو هادی بین و رو","رحمت جزئی باید به رحمت کل متصل شود تا بتواند درکی از رحمت کل داشته باشد و مردم را به سوی آن هدایت کند."],[365,"تا که جزوست او نداند راه بحر","هر غدیری را کند ز اشباه بحر","تا زمانی که انسان فقط بخشی از حقیقت را درک کند، نمی‌تواند راه دریا را بشناسد؛ هر کسی که درک نادرستی از واقعیت‌ها داشته باشد، مانند کسانی است که به اشتباه فکر می‌کنند هر برکه‌ای، دریا است."],[365,"چون نداند راه یم کی ره برد","سوی دریا خلق را چون آورد","وقتی کسی راه دریا را نخواهد دانست، چگونه می‌تواند مردم را به سوی دریا هدایت کند؟"],[365,"متصل گردد به بحر آنگاه او","ره برد تا بحر همچون سیل و جو","او وقتی به دریا (معرفت) وصل شود، می‌تواند مانند جاری شدن سیل و جریان آب، دیگران را نیز به سمت آن دریا هدایت کند."],[365,"ور کند دعوت به تقلیدی بود","نه از عیان و وحی تاییدی بود","اگر دعوت به تقلید باشد، این دعوت از روی شناخت و واقعیت نیست و تأیید و وحی الهی بر آن نیست."],[365,"گفت پس چون رحم داری بر همه","همچو چوپانی به گرد این رمه","چرا بر همه انسان‌ها رحم داری همانند چوپانی که بر یک گله گوسفند احساس محبت و مراقبت می‌کند."],[365,"چون نداری نوحه بر فرزند خویش","چونک فصاد اجلشان زد به‌نیش","چرا بر فرزند خود نوحه و گریه نمی‌کنی؟ زیرا که اجل (مرگ) آن‌ها ناگهانی و بی‌خبر به سراغشان آمده است."],[365,"چون گواه رحم اشک دیده‌هاست","دیده تو بی نم و گریه چراست","چون اشک چشم نشانه رحم و محبت است، پس چرا چشم تو بی‌اشک و بی‌گریه است؟"],[365,"رو به زن کرد و بگفتش ای عجوز","خود نباشد فصل دی همچون تموز","او (شیخ) به زنی پیر (عجوز) رو می‌کند و می‌گوید که فصل دی (زمستان) مثل فصل تموز (تابستان) نیست، پس نباید انتظار خوشی و شادابی را در این فصل داشت."],[365,"جمله گر مردند ایشان، گر حی‌اند","غایب و پنهان ز چشم دل کی‌اند","چه فرقی دارد که این افراد مرده‌اند یا زنده و پنهان از چشم دل، در هر حال از دید عاطفی و روحی و اجتماعی، آنها غایب هستند."],[365,"من چو بینمشان معین پیش خویش","از چه رو، رو را کنم همچون تو ریش","وقتی آن‌ها را می‌بینم که در کنارم هستند، چرا باید با رویی مانند تو که غمگین و پژمرده است، رفتار کنم؟"],[365,"گرچه بیرون‌اند از دور زمان","با من‌اند و گرد من بازی‌کنان","هرچند که عزیزانم از من دورند و در زمان جدایی به سر می‌برند، اما در عین حال، احساس می‌کنم که آنها همچنان با من هستند و در کنارم می‌چرخند و بازی می‌کنند."],[365,"گریه از هجران بود یا از فراق","با عزیزانم وصالست و عناق","گریه‌ای که من می‌کنم، به خاطر جدایی و فراق نیست، بلکه به خاطر پیوند و نزدیکی با عزیزانم است."],[365,"خلق اندر خواب می‌بینندشان","من به بیداری همی‌بینم عیان","مردم در خواب، محبوبان خود را می‌بینند، ولی من در بیداری، آن‌ها را به‌طور واضح و آشکار می‌بینم."],[365,"زین جهان خود را دمی پنهان کنم","برگ حس را از درخت افشان کنم","می‌خواهم از این جهان به مدت کوتاهی خود را مخفی کنم و احساسات را از وجود خود جدا سازم."],[365,"حس اسیر عقل باشد ای فلان","عقل اسیر روح باشد هم بدان","حس تحت سلطه عقل است، ای شخص، اما عقل هم بایستی تحت تسلط روح قرار گیرد."],[365,"دست بسته عقل را جان باز کرد","کارهای بسته را هم ساز کرد","عقل که محدود و بسته است، با کمک جان و روح می‌تواند آزاد شود و کارهایی را که قبلا انجام‌شدنی به نظر نمی‌رسید، ممکن کند."],[365,"حسها و اندیشه بر آب صفا","همچو خس بگرفته روی آب را","حس‌ها و تفکرات انسان بر روی آب پاک و صاف، مانند خس (پیش‌پرده) که سطح آب را می‌پوشاند، قرار دارد و آن را می‌پوشاند."],[365,"دست عقل، آن خس به یکسو می‌برد","آب پیدا می‌شود پیش خرد","عقل مانند دستی است که آن خس را از روی آب کنار می‌زند، و در این صورت آب به وضوح نمایان می‌شود و افکار و حقایق بهتر درک می‌شوند."],[365,"خس بس انبه بود بر جو چون حباب","خس چو یکسو رفت پیدا گشت آب","خس، که نوعی گیاه است، وقتی که در آب جمع می‌شود، به صورت حباب‌هایی درمی‌آید. هنگامی که این خس از یک سو کنار برود، آب به وضوح قابل دیدن می‌شود. این بیت به وضوح نشان می‌دهد که وجود موانع باعث پنهان شدن حقیقت می‌شود و با برطرف شدن آن‌ها، حقیقت نمایان می‌گردد."],[365,"چونک دست عقل نگشاید خدا","خس فزاید از هوا بر آب ما","وقتی عقل انسان نتواند به درستی عمل کند و گشوده نشود، در نتیجه تاثیرات خارجی و نامناسب، مانند خس (گیاه ناخواسته)، بر دل و روح او افزوده می‌شود و از آن آسیب می‌بیند."],[365,"آب را هر دم کند پوشیده او","آن هوا خندان و گریان عقل تو","آب هر لحظه به دست او (خدا) پنهان می‌شود، در حالی که آن هوای پر از شادی و غم، عقل تو را مشغول می‌کند."],[365,"چونک تقوی بست دو دست هوا","حق گشاید هر دو دست عقل را","زمانی که تقوی (پرهیزگاری) دو دست را به سوی دنیا و هوا (خواسته‌های نفسانی) می‌بندد، حق (خدا) هر دو دست عقل را باز می‌کند و به او توانایی می‌دهد."],[365,"پس حواس چیره محکوم تو شد","چون خرد سالار و مخدوم تو شد","حواس تو تحت سلطه و فرمان عقل قرار گرفت و عقل، به مانند سالاری برتر و رئیس تو، بر آن‌ها حاکم شد."],[365,"حس را بی‌خواب، خواب اندر کند","تا که غیبیها ز جان سر بر زند","حس آدمی، در حال بیداری و هوشیاری، می‌تواند خواب‌ها و خیالات را در ذهن ایجاد کند؛ این خواب‌ها و تصورات، در نهایت باعث می‌شود که شناخت‌های غیبی و امور باطنی از وجود انسان به ظهور برسند."],[365,"هم به بیداری ببینی خوابها","هم ز گردون برگشاید بابها","توی بیداری هم می‌توانی خواب‌ها را ببینی و همچنین از آسمان دروازه‌هایی به روی تو باز می‌شود."],[366,"دید در ایام آن شیخ فقیر","مصحفی در خانه پیری ضریر","در ایام آن شیخ فقیر، مصحفی را در خانه پیرمردی نابینا (ضریر) مشاهده کرد."],[366,"پیش او مهمان شد او وقت تموز","هر دو زاهد جمع گشته چند روز","در فصل گرما، شیخ نابینا (ضریر) به مهمانی دعوت شد و هر دو زاهد به مدت چند روز در کنار هم جمع شدند."],[366,"گفت اینجا ای عجب مصحف چراست","چونک نابیناست این درویش راست","شخصی در حال تعجب می‌گوید: \"چرا در اینجا یک کتاب مقدس (مصحف) وجود دارد در حالی که این درویش نابینا است؟"],[366,"اندرین اندیشه تشویشش فزود","که جز او را نیست اینجا باش و بود","در این فکر و خیال، اضطرابش بیشتر شد؛ چون فهمید که تنها موجود در این مکان، خودش است و هیچ‌کس دیگری نیست."],[366,"اوست تنها مصحفی آویخته","من نیم گستاخ یا آمیخته","او تنها کسی است که کتاب آسمانی (مصحف) را در آویزان بودن دارد و من نه گستاخ هستم و نه به او نزدیک می‌شوم."],[366,"تا بپرسم نه خمش صبری کنم","تا به صبری بر مرادی بر زنم","تا وقتی که سوال نکنم و صبر نکنم، امیدی به رسیدن به هدفم ندارم و باید با صبر و تحمل به مراد و خواسته‌ام برسم."],[366,"صبر کرد و بود چندی در حرج","کشف شد کالصبر مفتاح الفرج","وقتی مدتی صبر کرد و در گرفتاری و سختی بود، به آرامش رسید و در نهایت مشکلاتش حل شد؛ زیرا صبر کلید گشایش و رهایی از سختی‌هاست."],[367,"رفت لقمان سوی داود صفا","دید کو می‌کرد ز آهن حلقه‌ها","لقمان به سوی داود رفت و او را در حال ساختن حلقه‌ها از آهن مشاهده کرد."],[367,"جمله را با همدگر در می‌فکند","ز آهن پولاد آن شاه بلند","لقمان با دیگران درباره کار داود صحبت می‌کند و به این نکته اشاره می‌کند که او حلقه‌ها را از آهن و پولاد می‌سازد، در حالی که داود شاه بزرگی است."],[367,"صنعت زراد او کم دیده بود","درعجب می‌ماند وسواسش فزود","لقمان که دیده‌بان و بصیرت‌دانی بزرگ است، در مواجهه با ساخت حلقه‌های آهنی داود، از صنعت و مهارت او شگفت‌زده شده و این حیرت باعث افزایش وسواس و تردید او می‌شود."],[367,"کین چه شاید بود وا پرسم ازو","که چه می‌سازی ز حلقه تو بتو","لقمان فکر می‌کند که ممکن است از داود، درویش معروف که حلقه‌ها را می‌ساخت، بپرسد که چه چیزی می‌سازد و در اینجا به او نشان دهد که این سؤال کردن چه فایده‌ای دارد."],[367,"باز با خود گفت صبر اولیترست","صبر تا مقصود زوتر رهبرست","لقمان با خود فکر کرد که صبر بهتر است، زیرا صبر باعث می‌شود که به هدف خود سریع‌تر برسد."],[367,"چون نپرسی زودتر کشفت شود","مرغ صبر از جمله پران‌تر بود","اگر سوال نکنی، زودتر به هدف می‌رسی؛ چنان‌که مرغ صبر از دیگر پرندگان بیشتر می‌پراند و بر این اساس، صبر در دستیابی به نتیجه بهتر است."],[367,"ور بپرسی دیرتر حاصل شود","سهل از بی صبریت مشکل شود","اگر دیرتر بپرسی، نتیجه حاصل شدن به راحتی بیشتر خواهد بود، اما اگر صبر کنی، بی‌صبری کار را سخت‌تر می‌کند."],[367,"چونک لقمان تن بزد هم در زمان","شد تمام از صنعت داود آن","لقمان وقتی دید که داود در حال ساختن حلقه‌هاست، به او گفت که صبر کن تا کار درست و کامل به انجام برسد، زیرا مهارت داود به صورت تمام و کمال در زمان درست به نتیجه می‌رسد."],[367,"پس زره سازید و در پوشید او","پیش لقمان کریم صبرخو","داود، قبل از ملاقات با لقمان، زرهی درست کرد و آن را به تن کرد تا برای جنگ آماده باشد. او به لقمان، که شخصیتی بزرگ و صبور است، احترام می‌گذارد."],[367,"گفت این نیکو لباسست ای فتی","در مصاف و جنگ دفع زخم را","لقمان به داود می‌گوید این لباس (زره) برای جنگ زینت خوبی است و در میدان نبرد باعث جلوگیری از آسیب و زخم می‌شود."],[367,"گفت لقمان صبر هم نیکو دمیست","که پناه و دافع هر جا غمیست","لقمان گفت که صبر نیز زمانی خوب است که به عنوان پناهگاهی برای انسان عمل کند و هر جا که غمی هست، آن را دفع کند."],[367,"صبر را با حق قرین کرد ای فلان","آخر والعصر را آگه بخوان","صبر را به حق پیوند بده ای فرد، زیرا که در سوره «عصر» به اهمیت آن اشاره شده است."],[367,"صد هزاران کیمیا حق آفرید","کیمیایی همچو صبر آدم ندید","خداوند صدها هزار نوع گنج و ارزش ایجاد کرده است، اما ارزشی بزرگ‌تر و همانند صبر آدمی وجود ندارد."],[368,"مرد مهمان صبرکرد و ناگهان","کشف گشتش حال مشکل در زمان","مرد مهمان لحظه‌ای صبر کرد و ناگهان وضعیت سخت خود را در آن زمان دریافت."],[368,"نیم‌شب آواز قرآن را شنید","جست از خواب آن عجایب را بدید","در نیمه‌شب صدای قرآن را شنید و از خواب بیدار شد و آن عجایب و شگفتی‌ها را مشاهده کرد."],[368,"که ز مصحف کور می‌خواندی درست","گشت بی‌صبر و ازو آن حال جست","تو از مصحف (کتاب قرآن) که نابینا بودی، درست و بدون تأمل می‌خواندی و آن زمان (حسّ) حال خاصی را تجربه کردی."],[368,"گفت آیا ای عجب با چشم کور","چون همی‌خوانی همی‌بینی سطور","نابینا از مفسر می‌پرسد چگونه می‌توانی با وجود نابینایی، متن را بخوانی و سطرها را ببینی؟"],[368,"آنچ می‌خوانی بر آن افتاده‌ای","دست را بر حرف آن بنهاده‌ای","تو چیزی که می‌خوانی، همان را در دست گرفته‌ای و بر آن انگشت گذاشته‌ای."],[368,"اصبعت در سیر پیدا می‌کند","که نظر بر حرف داری مستند","تو در حال مشاهده و مطالعه‌ای که در آن، به حرف و نوشته‌ای توجه داری و دلیل و منبع سخن را از آن می‌گیری."],[368,"گفت ای گشته ز جهل تن جدا","این عجب می‌داری از صنع خدا","ای کسی که به‌سبب نادانی از جسم خود جدا شده‌ای، تو از خلقت خدا چه شگفتی داری؟"],[368,"من ز حق در خواستم کای مستعان","بر قرائت من حریصم همچو جان","من از خدا خواسته‌ام که ای یاری‌دهنده، در خواندن قرآن به من کمک کن؛ چرا که من به اندازه‌ای که به جانم اهمیت می‌دهم، به قرائت آن نیز اهمیت می‌دهم."],[368,"نیستم حافظ مرا نوری بده","در دو دیده وقت خواندن بی‌گره","من حافظ (قائم به یاد) نیستم، بنابراین به من نوری بده تا در دو چشمم در هنگام خواندن قرآن، بدون مشکل و موانع ببینم."],[368,"باز ده دو دیده‌ام را آن زمان","که بگیرم مصحف و خوانم عیان","به من دوباره دیدگانم را بده تا وقتی که مصحف (قرآن) را بگیرم و به وضوح بخوانم."],[368,"آمد از حضرت ندا کای مرد کار","ای به‌هر رنجی به ما اومیدوار","از سوی حضرت، ندا رسید که ای مرد تلاشگر، تو به هر سختی و مصیبت، امیدوار به ما باش."],[368,"حسن ظنست و امیدی خوش تورا","که تورا گوید به‌هر دم برتر آ","حسن ظن و امید قوی تو به خداوند این است که او در هر لحظه به تو نوید می‌دهد که بالاتر و بهتر از آنچه که می‌خواهی، برایت خواهد بود."],[368,"هر زمان که قصد خواندن باشدت","یا ز مصحفها قرائت بایدت","هر زمان که بخواهی بخوانی یا از مصاحف قرآن تلاوت کنی، نیاز است که آماده باشی و نیت خواندن داشته باشی."],[368,"من در آن دم وا دهم چشم تورا","تا فرو خوانی معظم جوهرا","من در آن لحظه چشمان تو را باز می‌کنم تا تو بتوانی ارزش‌های بزرگ و بااهمیت را بخوانی و درک کنی."],[368,"همچنان کرد و هر آنگاهی که من","وا گشایم مصحف اندر خواندن","او (شخصی در حکایت) همیشه این کار را می‌کند و هر بار که من صفحه‌ای را باز می‌کنم، او به خواندن مصحف (کتاب مقدس) ادامه می‌دهد."],[368,"آن خبیری که نشد غافل ز کار","آن گرامی پادشاه و کردگار","آن کسی که به کار آن پادشاه بزرگ و خداوند به خوبی آگاه بود و غافل نشده بود، در حقیقت بسیار باخبر و دانا بود."],[368,"باز بخشد بینشم آن شاه فرد","در زمان همچون چراغ شب‌نورد","آن پادشاه بزرگوار، مانند چراغی در شب، دوباره به من بینش و بینایی می‌بخشد."],[368,"زین سبب نبود ولی را اعتراض","هرچه بستاند فرستد اعتیاض","از این رو، اگر کسی به ستم از او چیزی بگیرد، دیگر از او اعتراضی نمی‌کند و آنچه را که گرفته، به عنوان جبران خسارت می‌پذیرد."],[368,"گر بسوزد باغت انگورت دهد","در میان ماتمی سورت دهد","اگر باغ تو بسوزد و ویران شود، در میان آن مصیبت، انگور می‌آورد و تو را به یاد مرگ و ماتم می‌اندازد."],[368,"آن شل بی‌دست را دستی دهد","کان غمها را دل مستی دهد","خداوند به آن شخص بی‌دست، نیکی و توانایی می‌بخشاید تا او را از غم‌ها رهایی بخشد و دلش را شاد کند."],[368,"لا نسلم و اعتراض از ما برفت","چون عوض می‌آید از مفقود زفت","ما دیگر تسلیم نمی‌شویم و اعتراضی از ما باقی نمانده است، چون چیزی که از دست رفته است، وقتی به ما برگردد، جایگزینی برای آن می‌شود."],[368,"چونک بی آتش مرا گرمی رسد","راضیم گر آتشش ما را کشد","اگر من بدون آتش هم احساس گرما کنم، راضی‌ام، حتی اگر آتش وجودش باعث مرگ من شود."],[368,"بی چراغی چون دهد او روشنی","گر چراغت شد چه افغان می‌کنی","چطور ممکن است در تاریکی، بی‌چراغ، کسی روشنی بدهد؟ اگر چراغ تو روشن شد، پس چرا اینقدر شکایت می‌کنی؟"],[369,"بشنو اکنون قصه آن ره‌روان","که ندارند اعتراضی در جهان","حالا داستان آن سالکان را بشنو که در این دنیا هیچ اعتراضی ندارند و خویشتن را راضی به اوضاع موجود می‌دانند."],[369,"ز اولیا اهل دعا خود دیگرند","که همی‌دوزند و گاهی می‌درند","اولیا و بزرگانی که به دعا معروفند، متفاوت از دیگران هستند؛ زیرا گاهی می‌خواهند خواسته‌های خود را به خدا نزدیک کنند و در مواقعی نیز به تقدیر الهی راضی هستند و آن را قبول می‌کنند."],[369,"قوم دیگر می‌شناسم ز اولیا","که دهانشان بسته باشد از دعا","افرادی از اولیا را می‌شناسم که از دعا کردن خودداری می‌کنند و زبانشان در این موضوع خاموش است."],[369,"از رضا که هست رام آن کرام","جستن دفع قضاشان شد حرام","افرادی که به رضایت الهی راضی هستند، از لطف و کرامت برخوردارند و درخواست تغییر در تقدیر و قضا و قدر خود را جایز نمی‌دانند."],[369,"در قضا ذوقی همی‌بینند خاص","کفرشان آید طلب کردن خلاص","بعضی اولیا در قضا و تقدیر، لذتی خاص احساس می‌کنند و از آن خوشحال هستند و برای رسیدن به رهایی از سرنوشت، دعا و درخواست نمی‌کنند، چون این کار را ناپسند می‌دانند."],[369,"حسن ظنی بر دل ایشان گشود","که نپوشند از عمی جامه کبود","حسن و زیبایی ظاهری به دل آن اولیا جلوه کرد، به‌طوری که نمی‌توانند از گناهانی که مرتکب شده‌اند، پرده‌پوشی کنند و از آن به خوبی آگاه‌اند."],[370,"گفت بهلول آن یکی درویش را","چونی ای درویش‌؟ واقف کن مرا","بهلول به آن درویش گفت: «چطور است ای درویش؟ مرا از حال خود آگاه کن."],[370,"گفت ‌«چون باشد کسی که جاودان","بر مراد او رود کار جهان","بهلول می‌پرسد که چگونه ممکن است کسی وجود داشته باشد که کارهای جهان همیشه مطابق میل او باشد و به خواسته‌های او پاسخ دهد."],[370,"سیل و جوها بر مراد او روند","اختران زان سان که خواهد آن شوند","سیل‌ها و جریان‌ها طبق اراده و خواسته او حرکت می‌کنند، مانند ستاره‌ها که بر اساس خواسته او به شکل دلخواه درمی‌آیند."],[370,"زندگی و مرگ‌، سرهنگان او","بر مراد او روانه کو به‌کو","زندگی و مرگ، مانند فرماندهان و سرهنگانی هستند که به خواست او (خدا) در همه جا حرکت می‌کنند و به دنبال اجرای اراده‌اش هستند."],[370,"هر کجا خواهد فرستد تعزیت","هر کجا خواهد ببخشد تهنیت","او (خدا یا تقدیر) هر جا که بخواهد، می‌تواند به دیگران تسلیت بدهد و هر که را بخواهد، شادباش بدهد."],[370,"سالکان راه هم بر گام او","ماندگان از راه هم در دام او","سالکان (ره‌پیمایان) که به دنبال حق و حقیقت هستند، در مسیری که او (فرمان‌روان) مشخص کرده، قدم می‌زنند و کسانی که از راه او منحرف شده‌اند، در چنگال بلا و آفت گرفتار شده‌اند."],[370,"هیچ دندانی نخندد در جهان","بی رضا و امر آن فرمان‌روان‌»","هیچ کسی در دنیا نمی‌تواند بدون خواست و اراده خداوند به چیزی لبخند بزند یا شاد باشد، زیرا او بر همه امور فرمانروایی دارد."],[370,"گفت ‌«ای شه راست گفتی همچنین","در فر و سیمای تو پیداست این","بهلول می‌گوید: «ای پادشاه، تو راست می‌گویی و آنچه گفته‌ای درست است، زیرا زیبایی و شکوه تو در چهره‌ات نمایان است."],[370,"این و صد چندینی ای صادق ولیک","شرح کن این را بیان کن نیک نیک","ای صادق، این مطلب و بسیاری بیشتر از آن را شرح بده و به‌خوبی توضیح کن."],[370,"آنچنان‌که فاضل و مرد فضول","چون به گوش او رسد‌، آرد قبول","انسان فاضل و با دانش، هر زمان که سخنان بیهوده یا نادرست را می‌شنود، آن‌ها را قبول نمی‌کند و به راحتی از کنارشان می‌گذرد."],[370,"آنچنانش شرح کن اندر کلام","که از آن هم بهره یابد عقل عام","او باید طوری سخن را توضیح دهد که همه‌کس، حتی افراد عادی هم بتوانند از آن بهره‌برداری کنند."],[370,"ناطق کامل چو خوان‌پاشی بود","خوانش بر هر گونه آشی بود","گوینده‌ی کامل مانند کسی است که سفره‌ای بیفکند و هر کسی بتواند از آن هر غذایی که می‌خواهد بردارد."],[370,"که نماند هیچ مهمان بی‌نوا","هر کسی یابد غذای خود جدا","هیچ مهمانی نباید گرسنه بماند و هر کسی به اندازه خود و مطابق با نیازش از این سفره بهره‌مند می‌شود."],[370,"همچو قرآن که به‌معنی هفت توست","خاص را و عام را مطعم دروست‌»","مانند قرآن که می‌تواند به هفت معنا تفسیر شود، به‌خاطر دارد که در آن هم خاص و هم عام موضوعات پرمغز و شایسته‌ای وجود دارد."],[370,"گفت ‌«این باری یقین شد پیش عام","که جهان در امر یزدان است رام","بهلول می‌گوید: «این موضوع حالا برای همه‌ واضح و روشن شده است که جهان در تسلط و اراده خداوند است و همه‌ چیز به دست او اداره می‌شود."],[370,"هیچ برگی در نیفتد از درخت","بی قضا و حکم آن سلطان بخت","هیچ برگی از درخت بدون تقدیر و فرمان سلطان سرنوشت نمی‌افتد."],[370,"از دهان لقمه نشد سوی گلو","تا نگوید لقمه را حق که ادخلوا","لقمه تا به گلو نرسد و به دهان نیفتد، نمی‌تواند سخن بگوید و حق خود را ادعا کند که برای شما بگویید داخل شوید. این بیت نشان‌دهنده این است که نخستین گام‌ها و روابط بین موجودات، تابع خواست و قضا و قدر الهی است."],[370,"میل و رغبت کان زمام آدمی‌ست","جنبش آن رام امر آن غنی‌ست","رغبت و تمایل انسان هدایت‌کننده او است و حرکت و جنبش آن به خواست و اراده آن غنی (خدای بی‌نیاز) بستگی دارد."],[370,"در زمین‌ها و آسمان‌ها ذره‌ای","پر نجنباند نگردد پره‌ای","هیچ ذره‌ای در زمین و آسمان نمی‌تواند حرکت کند و از جایی جدا شود، مگر با اجازه و فرمان خدای غنی و توانا."],[370,"جز به فرمان قدیم نافذش","شرح نتوان کرد و جلدی نیست خوش","تنها با اراده خداوند که ازلی و نافذ است، می‌توان حقیقت را توصیف کرد و نمی‌توان به راحتی آن را فهمید یا بیان کرد."],[370,"کی شمرد برگ درختان را تمام‌؟","بی‌نهایت کی شود در نطق رام‌؟","هیچ‌کس نمی‌تواند تعداد تمام برگ‌های درختان را بشمارد، زیرا شمارش آن‌ها خارج از اندازه‌گیری ماست. همچنین، گویایی و گفتار نیز نهایتی ندارد و نمی‌توان به طور کامل آن را درک کرد."],[370,"این قدر بشنو که چون کلی کار","می‌نگردد جز به‌امر کردگار","به این اندازه گوش کن که هیچ کار کلی به دور خود نمی‌چرخد، مگر با فرمان خداوند."],[370,"چون قضای حق رضای بنده شد","حکم او را بنده خواهنده شد","زمانی که خواسته بنده با قضا و قدر خداوند هم‌خوان شود، در این صورت حکم و فرمان خداوند به دست آن بنده به انجام می‌رسد."],[370,"بی تکلف، نه پی مزد و ثواب","بلک طبع او چنین شد مستطاب","این بیت به این معناست که انسان باید بدون هیچ زحمتی و نه به‌خاطر پاداش و جزا، بلکه به صورت طبیعی و به خاطر ذات خود، به کارهایی که خوشایند اوست بپردازد و لذت ببرد."],[370,"زندگی خود نخواهد بهر خوذ","نه پی ذوقی حیات مستلذ","او برای خود زندگی نمی‌خواهد و نه به خاطر لذت‌بردن از آن، بلکه به دلیل خودخواهی و لذت‌جویی را کنار گذاشته است."],[370,"هرکجا امر قدم را مسلکی‌ست","زندگی و مردگی پیشش یکی‌ست","هرجا که کسی بر اساس اصول و باورهای خاصی زندگی می‌کند، برای او موضوع زندگی و مرگ فرقی ندارد."],[370,"بهر یزدان می‌زید نه بهر گنج","بهر یزدان می‌مرد نه از خوف رنج","او (درویش) برای خدای یکتا زندگی می‌کند و می‌میرد، نه به خاطر ثروت و گنج؛ او به خاطر پروردگار می‌کوشد و از فراق و رنج نمی‌ترسد."],[370,"هست ایمانش برای خواست او","نه برای جنت و اشجار و جو","ایمان او به خاطر خواسته‌ی خداست، نه به خاطر بهشت و درختان و آب و گیاه."],[370,"ترک کفرش هم برای حق بود","نه ز بیم آنکه در آتش رود","ترک کفر این درویش نیز به خاطر حق و حقیقت بود، نه از ترس اینکه به جهنم برود."],[370,"این چنین آمد ز اصل‌، آن خوی او","نه ریاضت‌، نه به‌ جست‌و‌جوی او","خوی و رفتار انسان از ذات و ماهیت او نشأت می‌گیرد و اصلاح آن نه از طریق عبادت‌های سخت و ریاضت و نه از تلاش برای رسیدن به مقاصدی خاص به دست می‌آید."],[370,"آنگهان خندد که او بیند رضا","همچو حلوای شکر او را قضا","او زمانی می‌خندد که ببیند رضایت الهی را، همان‌طور که حلوای شیرین خوشمزه است، سرنوشتش هم شیرین و خوش می‌شود."],[370,"بنده‌ای کش خوی و خلقت این بود","نه جهان بر امر و فرمانش رود‌؟","بنده‌ای که سرشت و طبیعتش این‌گونه است، آیا نمی‌تواند جهان تحت فرمان او قرار بگیرد؟"],[370,"پس چرا لابه کند او یا دعا‌؟","که بگردان ای خداوند این قضا","چرا او ناله و دعا می‌کند که ای خدا، این تقدیر را تغییر بده؟"],[370,"مرگ او و مرگ فرزندان او","بهر حق پیشش چو حلوا در گلو","مرگ آن درویش و فرزندانش در نزد او به سبب حق، مانند حلوا در گلو است، یعنی به راحتی و بدون هیچ زحمتی قابل بلعیدن است."],[370,"نزع فرزندان بر آن باوفا","چون قطایف پیش شیخ بی‌نوا","جدایی فرزندان آن شخص وفادار، مانند شکم پر از شیرینی‌های «قطایف» (نوعی شیرینی معروف) در برابر شیخ بی‌نوا (بیچاره) احساس می‌شود."],[370,"پس چرا گوید دعا الا مگر","در دعا بیند رضای دادگر","چرا او دعا می‌کند، مگر اینکه در دعا رضایت خداوند دادگر را ببیند؟"],[370,"آن شفاعت و آن دعا نه از رحم خود","می‌کند آن بنده صاحب رشد","شفاعت و دعا نه به خاطر رحمت و محبت خود، بلکه به خاطر رشد و کمال روحی آن بنده‌ای است که به مقام کمال رسیده است."],[370,"رحم خود را او همان دم سوخته‌ست","که چراغ عشق حق افروخته‌ست","کسی که در راه عشق الهی گام برداشته و به مقام محبت الهی رسیده، تمام توجه و محبت‌های خود را از دنیا و نفس خود بریده است. او در همان لحظه که به عشق خدا رسیده، تعلقات و احساسات دنیوی را رها کرده و به نور و عشق الهی متصل شده است."],[370,"دوزخ اوصاف او عشقست و او","سوخت مر اوصاف خود را مو به‌مو","دوزخ همان حسادت‌ها و عیب‌ها و نقص‌های انسانی است که عشق الهی موجب دگرگونی آنها می‌شود و عاشق در این راه، ویژگی‌های بد خود را به‌طور کامل رها می‌کند."],[370,"هر طروقی این فروقی کی شناخت‌؟","جز دقوقی تا درین دولت بتاخت","چگونه می‌توان هر گوشه و حالتی از عشق را شناخت؟ تنها دقوقی (دلقک یا شراب‌نوش) در این حالت وارد می‌شود و در این مقام از عشق می‌جنگد."],[371,"آن دقوقی داشت خوش دیباجه‌ای","عاشق و صاحب کرامت خواجه‌ای","دقوقی، شخصی با لباس زیبا و خوش‌پوش بود که عاشق و دارای کرامت‌های ویژه‌ای بود."],[371,"در زمین می‌شد چو مه بر آسمان","شب‌روان راگشته زو روشن روان","دقوقی به قدری درخشان و نورانی بود که در زمین مانند ماه در آسمان درخشش داشت و شب‌زنده‌داران را روشن می‌کرد."],[371,"در مقامی مسکنی کم ساختی","کم دو روز اندر دهی انداختی","چند روزی در مقام و خانه‌ای که ساخته‌ای، زندگی می‌کنی و در این مدت عشق و محبت به آنجا وارد می‌شود."],[371,"گفت در یک خانه گر باشم دو روز","عشق آن مسکن کند در من فروز","اگر در یک خانه فقط دو روز بمانم، عشق به آن خانه بر دل من تاثیر عمیق می‌گذارد و نورانیت و گرمای خود را در من می‌اندازد."],[371,"غرة المسکن احاذره انا","انقلی یا نفس سیری للغنا","عشق و ساکن شدن در یک مکان خوشایند، باعث شده تا نفس من به زیبایی‌های آن گوشزد کند؛ ای نفس، به منظور جستجوی ثروت، به اینجا بیا."],[371,"لا اعود خلق قلبی بالمکان","کی یکون خالصا فی الامتحان","من نمی‌توانم قلب خود را در مکانی ثابت نگه‌دارم، زیرا باید خالص و بی‌نقص در امتحان قرار گیرد."],[371,"روز اندر سیر بد شب در نماز","چشم اندر شاه باز او همچو باز","در طول روز، در جستجوی حق و حقیقت است و شب‌ها به عبادت و نماز می‌پردازد. مانند یک باز که با دقت و توجه به شکارش نگاه می‌کند، او نیز با تمرکز به پروردگار و معبودی که در دلش قرار دارد، توجه دارد."],[371,"منقطع از خلق، نه از بد خوی","منفرد از مرد و زن، نه از دوی","او از مردم ناآرام و بدخلق قطع رابطه کرده است و از دو جنس مرد و زن نیز جداست، یعنی به طور کامل از روابط و خواسته‌های دنیوی فاصله گرفته و منفرد است."],[371,"مشفقی بر خلق و نافع همچو آب","خوش شفعیی و دعااش مستجاب","او نسبت به مردم مهربان و نافع است، مانند آب زلال که زندگی‌بخش است، دعا و شفاعتش نیز مستجاب می‌شود."],[371,"نیک و بد را مهربان و مستقر","بهتر از مادر شهی‌تر از پدر","نیک و بد هر دو را با محبت و استواری باید پذیرفت، که این رویکرد همچنان بهتر از محبت مادر و پدر است."],[371,"گفت پیغامبر شما را ای مهان","چون پدر هستم شفیق و مهربان","پیامبر به شما ای مهمانان می‌گوید که من همچون پدر، برای شما مهربان و دلسوز هستم."],[371,"زان سبب که جمله اجزای منید","جزو را از کل چرا بر می‌کنید","چرا تمام اجزای وجود من را از کلّ وجودتان جدا می‌کنید؟"],[371,"جزو از کل قطع شد بی کار شد","عضو از تن قطع شد مردار شد","وقتی جزئی از کل جدا می‌شود، بی‌فایده و بی‌کار می‌شود؛ مانند اینکه اگر عضوی از بدن جدا شود، آن عضو دیگر ارزش و حیات ندارد و مرده می‌شود."],[371,"تا نپیوندد به‌کل بار دگر","مرده باشد نبودش از جان خبر","تا زمانی که به کل متصل نشود و دوباره به حالت اول برنگردد، از نظر روحی مرده است و خبری از زندگی‌اش نیست."],[371,"ور بجنبد نیست آن را خود سند","عضو نو ببریده هم جنبش کند","اگر چیزی به حیاتش ادامه ندهد، از آن عضو که جدا شده هم حرکتی نمی‌توان سراغ داشت."],[371,"جزو ازین کل گر برد یکسو رود","این نه آن کلست کو ناقص شود","اگر بخشی از یک کل برداشته شود، آن کل به‌طور کامل نخواهد بود و ناقص می‌شود."],[371,"قطع و وصل او نیاید در مقال","چیز ناقص گفته شد بهر مثال","اگر چیزی را قطعه‌قطعه کنیم، دیگر نمی‌توان آن را به عنوان یک کل در نظر گرفت. بنابراین، هرچیزی که ناتمام باشد، نمی‌تواند به درستی در مقال و سخن به حساب آید."],[372,"مر علی را در مثالی شیر خواند","شیر مثل او نباشد گرچه راند","علی را در مثالی شیر می‌نامند، اما هیچ‌گاه هیچ حیوانی نمی‌تواند مانند او باشد، حتی اگر به او نزدیک شود یا شبیه او باشد."],[372,"از مثال و مثل و فرق آن بران","جانب قصه دقوقی ای جوان","ای جوان، از تفاوت مثال و مثل و معنای آن‌ها فراتر برو و به داستان دقوقی بپرداز."],[372,"آنک در فتوی امام خلق بود","گوی تقوی از فرشته می‌ربود","دقوقی، که در فتوایی که امام صادر کرده بود، مورد توجه مردم بود، به گونه‌ای زندگی می‌کرد که گویی تقوای او از فرشتگان هم بالاتر است."],[372,"آنک اندر سیر مه را مات کرد","هم ز دین‌داری او دین رشک خورد","او در سیر و سلوکش چنان به خداوند نزدیک شد و با صفای دل، ستاره مهتاب را به حیرت واداشت که حتی دین (آیین) نیز به او حسادت می‌کرد."],[372,"با چنین تقوی و اوراد و قیام","طالب خاصان حق بودی مدام","با این تقوا و عبادت‌های مستمر و قیام در نماز، همواره از خواص و ویژه‌مندان حق بودی."],[372,"در سفر معظم مرادش آن بدی","که دمی بر بنده خاصی زدی","در سفر بزرگ، مقصود او این بود که لحظه‌ای بر یکی از بندگان خاص خود رحمت و لطف نازل کند."],[372,"این همی‌گفتی چو می‌رفتی به‌راه","کن قرین خاصگانم ای اله","تو ای خدا، در مسیر سفر، همواره می‌گویی که همراه من، بندگان خاص خود را قرار بده."],[372,"یا رب آنها را که بشناسد دلم","بنده و بسته‌میان و مجملم","ای خدا، آنها که دل من به عشق آنها آشناست، را من بنده و وابسته می‌دانم و در بیان این عشق، دلم گنگ و ناواضح است."],[372,"و آنک نشناسم تو ای یزدان جان","بر من محجوبشان کن مهربان","اگر من تو را نشناسم، ای خدا، مرا از آنانی که با تو ارتباط دارند، محجوب و دور نگه‌دار تا محبتشان بر من نشود."],[372,"حضرتش گفتی که ای صدر مهین","این چه عشقست و چه استسقاست این","حضرت محمد (ص) به شما ای بزرگ‌ترین مقام اشاره کرده و می‌پرسد که این چه عشقی است و چه نیازی به آب روحی وجود دارد."],[372,"مهر من داری چه می‌جویی دگر","چون خدا با تست چون جویی بشر","اگر مرا دوست داری، چرا دنبال چیز دیگری هستی؟ در حالی که خداوند همواره با توست مانند جوی آبی که در کنار تو جاری است."],[372,"او بگفتی یا رب ای دانای راز","تو گشودی در دلم راه نیاز","دقوقی در این بیت از خداوند درخواست می‌کند و می‌گوید ای پروردگارا، تو به من آگاهی و درک رازها داده‌ای و راهی برای طلب و نیاز من در دلم گشوده‌ای."],[372,"درمیان بحر اگر بنشسته‌ام","طمع در آب سبو هم بسته‌ام","اگرچه در وسط دریا نشسته‌ام و در حال غرق شدن هستم، اما باز هم به آب در دست خود (سبوی آب) چشم دوخته‌ام و به آن امیدوارم."],[372,"همچو داودم نود نعجه مراست","طمع در نعجه حریفم هم بخاست","من چون داوود، نود گوسفند دارم و آرزو می‌کنم که گوسفند حریفم را هم به دست آورم."],[372,"حرص اندر عشق تو فخرست و جاه","حرص اندر غیر تو ننگ و تباه","حرص در عشق تو باعث افتخار و مقام است، اما حرص در غیر تو، ننگ و فساد به همراه دارد."],[372,"شهوت و حرص نران بیشی بود","و آن حیزان ننگ و بدکیشی بود","حرص و شهوت در عشق تو (خدا یا محبوب) افتخار و شرافت است، اما در عشق به غیر تو ننگ و بدنامی به شمار می‌رود."],[372,"حرص مردان از ره پیشی بود","در مخنث حرص سوی پس رود","حرص مردان باعث پیشرفت و ترقی آنها می‌شود، در حالی که در افرادی که ویژگی‌های زنانه دارند (مخنث) این حرص به عقب‌نشینی و تنزل منجر می‌شود."],[372,"آن یکی حرص از کمال مردی است","و آن دگر حرص افتضاح و سردی است","حرص برخی از مردان نشانه کمال و تلاش برای برتری است، در حالی که حرص دیگری سبب شرمندگی و سرد شدن احساسات می‌شود."],[372,"آه سرّی هست اینجا بس نهان","که سوی خضری شود موسی روان","در این بیت، مولانا به موضوعی اشاره می‌کند که راز و سرّی پنهان در اینجا وجود دارد و اگر کسی آن را درک کند، مانند موسی که به سمت سبزینگی و زندگی می‌رود، به سوی روشنایی و کمال حرکت می‌کند."],[372,"همچو مستسقی کز آبش سیر نیست","بر هر آنچ یافتی بالله مه‌ایست","انسانی که تشنه‌ی حقیقت و آگاهی است، مانند شخصی است که به آب دسترسی ندارد و با وجود تلاش و جستجو، از آنچه یافته، راضی نیست. این آب یعنی علم و معرفت، وعده‌گاهی معنوی است که بی‌نهایت زیبا و دلکش است."],[372,"بی نهایت حضرتست این بارگاه","صدر را بگذار صدر تست راه","این بارگاه به عنوان نشانه‌ای از مقام و عظمت الهی بی‌نهایت است. بنابراین، برای رسیدن به این مقام بزرگ، باید جایگاه خود را رها کنید و به او نزدیک شوید."],[373,"از کلیم حق بیاموز ای کریم","بین چه می‌گوید ز مشتاقی کلیم","از موسی کلیم‌الله (موسی پیامبر) بیاموز ای بزرگوار، ببین چه می‌گوید درباره عشق و خواسته‌های دل، یعنی چطور با دل‌سوزی و شوق در جستجوی حقیقت است."],[373,"با چنین جاه و چنین پیغامبری","طالب خضرم ز خودبینی بری","با چنین مقام و نفوذ و پیامبری، هنوز تو به خاطر خودبینی‌ات طالب خضر هستی."],[373,"موسیا تو قوم خود را هشته‌ای","در پی نیکوپیی سرگشته‌ای","ای موسی، تو مردم خود را به راهی بی‌نیکی و اخلاق نیکو رها کرده‌ای و در جستجوی کسی هستی که توجه به فضائل نیکو را به تو نشان دهد."],[373,"کیقبادی رسته از خوف و رجا","چند گردی چند جویی تا کجا","کیقباد، پادشاه اسطوره‌ای ایران، از ترس و امید به خداوند رها شده است. تو چه مدت می‌خواهی در جستجوی او بگردی و به کجا می‌خواهی بروی؟"],[373,"آن تو با تست و تو واقف برین","آسمانا چند پیمایی زمین","تو همیشه در کنار من هستی و از حال من آگاه هستی، پس چرا برای رسیدن به آسمان‌ها دشواری می‌کشی و بر روی زمین سفر می‌کنی؟"],[373,"گفت موسی این ملامت کم کنید","آفتاب و ماه را کم ره زنید","موسی، پیامبر، از کسانی که او را سرزنش می‌کنند می‌خواهد که کمتر او را ملامت کنند و از آفتاب و ماه که سمبل نور و روشنایی هستند، کمتر در مسیر او قرار بگیرند. در واقع، او خواهان این است که انتقادات و ملامت‌ها بر او تأثیر کمتری داشته باشد."],[373,"می‌روم تا مجمع البحرین من","تا شوم مصحوب سلطان زمن","من به سمت جایگاهی می‌روم که دو دریا با هم ملاقات می‌کنند تا در نزدیکی و همراهی سلطان زمان خودم قرار بگیرم."],[373,"اجعل الخضر لامری سببا","ذاک او امضی و اسری حقبا","آیا خضر (پیامبر) را برای خود به عنوان سبب و وسیله‌ای قرار دهم یا او را به سرزمین‌های دور بفرستم تا در مدت زمان‌های طولانی به سفر برود؟"],[373,"سال‌ها پرم به‌پر و بال‌ها","سال‌ها چه بود هزاران سال‌ها","سالیانی دراز من در جستجوی حقیقت و روحانیتم گذشت. در این مدت، زندگی‌ام پر از تلاش و دوندگی بوده و تجربه‌های زیادی را پشت سر گذاشته‌ام."],[373,"می‌روم یعنی نمی‌ارزد بدان","عشق جانان کم مدان از عشق نان","من دارم می‌روم، یعنی نمی‌خواهم به خاطر عشق محبوبم، به عشق نان و روزی بی‌ارزش، کم ارزش بگذارم."],[373,"این سخن پایان ندارد ای عمو","داستان آن دقوقی را بگو","این حرف ادامه‌دار است، ای عمو، داستان دقوقی (که احتمالا شخصیتی حکیم یا عبرت‌آموز است) را تعریف کن."],[374,"آن دقوقی رحمة الله علیه","گفت سافرت مدی فی خافقیه","دقوقی، عالم مشهور، گفت که سفری کرده‌ام که در دل و روح من تا ابد باقی مانده است."],[374,"سال و مه رفتم سفر از عشق ماه","بی‌خبر از راه حیران در اله","مدت زیادی است که به خاطر عشق به ماه (معشوق) در سفر هستم، غافل از راه و مسیر، و در حیرت و سرگشتگی به سر می‌برم."],[374,"پا برهنه می‌روی بر خار و سنگ","گفت من حیرانم و بی خویش و دنگ","عاشق به‌طور بی‌خبر و حیران، پا برهنه و بدون توجه به درد و رنج، بر روی خارها و سنگ‌ها قدم می‌گذارد و به حالت گم‌گشتگی و بی‌هویتی دچار شده است."],[374,"تو مبین این پایها را بر زمین","زانک بر دل می‌رود عاشق یقین","این پاها که بر زمین می‌روی، فقط ظاهر را نبین؛ زیرا عشق واقعی به دل می‌رسد و نه به پاها."],[374,"از ره و منزل ز کوتاه و دراز","دل چه داند کوست مست دل‌نواز","عاشق یا کسی که دلش شاد و سرزنده است، از ویژگی‌های ظاهری راه و مکان (مثل اینکه چقدر کوتاه یا بلند هستند) چیزی نمی‌داند؛ او فقط از لذت و زیبایی دل‌نوازش آگاه است."],[374,"آن دراز و کوته اوصاف تنست","رفتن ارواح دیگر رفتنست","دراز و کوتاه بودن ویژگی‌های جسم انسان است، اما رفتن روح‌ها موضوعی متفاوت و جدا از این اوصاف است. اینجا روح‌ها به عالمی دیگر می‌روند و این سفر با آنچه که از جسم مشاهده می‌شود، ارتباطی ندارد."],[374,"تو سفر کردی ز نطفه تا به‌عقل","نه به‌گامی بود، نه منزل نه نقل","تو از حالت نطفه تا رسیدن به عقل سفر کرده‌ای، ولی در این سفر هیچ‌گاه قدمی برنداشته‌ای و نه کسی به تو کمک کرده و نه جایی برای توقف وجود داشته است."],[374,"سیر جان بی چون بود در دور و دیر","جسم ما از جان بیاموزید سیر","سیر و حرکت جان، بی‌هیچ تردیدی، در گذر زمان و مکان وجود دارد. شما باید از جان خود بیاموزید که چگونه این سفر را در سایه جسم بگذرانید."],[374,"سیر جسمانه رها کرد او کنون","می‌رود بی‌چون نهان در شکل چون","او در حال حاضر دیگر به حضور جسمانی خود اهمیت نمی‌دهد و اکنون به‌سادگی و بی‌هیچ قید و شرطی در قالب انسانی به جستجوی حقیقت مشغول است."],[374,"گفت روزی می‌شدم مشتاق‌وار","تا ببینم در بشر انوار یار","روزی با شوق و اشتیاق به دنبالش می‌رفتم تا نور و روشنی پروردگار را در وجود انسان‌ها ببینم."],[374,"تا ببینم قلزمی در قطره‌ای","آفتابی درج اندر ذره‌ای","می‌خواهم در دنیای انسان‌ها نشانی از نور خداوند را ببینم، همان‌طور که تابش آفتاب در یک قطره آب و در ذره‌ای گرد و غبار نمایان است."],[374,"چون رسیدم سوی یک ساحل به‌گام","بود بیگه گشته روز و وقت شام","وقتی به یک ساحل رسیدم، روز به پایان رسیده و وقت شام شده بود."],[375,"هفت شمع از دور دیدم ناگهان","اندر آن ساحل شتابیدم بدان","ناگهان در آن ساحل، هفت شمع را از دور دیدم و به سرعت به سمت آن‌ها رفتم."],[375,"نور شعله هر یکی شمعی از آن","بر شده خوش تا عنان آسمان","شعله هر یک از آن شمع‌ها به‌قدری درخشان و زیبا بود که تا آسمان بالا می‌رفت و به آنجا می‌رسید."],[375,"خیره گشتم خیرگی هم خیره گشت","موج حیرت عقل را از سر گذشت","مشغول تماشای شمع‌ها شدم و در حیرت و شگفتی فرو رفتم، به‌طوری که موجی از حیرت عقل را از یاد برد."],[375,"این چگونه شمعها افروخته‌ست","کین دو دیده خلق ازینها دوخته‌ست","این شمع‌ها چطور روشن شده‌اند که دو چشم مردم به اینها خیره مانده است."],[375,"خلق جویان چراغی گشته بود","پیش آن شمعی که بر مه می‌فزود","مردم در پی چراغی و روشنی بودند و به سوی آن شمعی رفتند که نورش بر ماه می‌افزود و آن را روشن‌تر می‌کرد."],[375,"چشم‌بندی بد عجب بر دیده‌ها","بندشان می‌کرد یهدی من یشا","چشم‌پوشی عجیبی بود که بر چشم‌ها می‌افتاد و باعث می‌شد مردم را به سوی آن شمع جذب کند، در حالی که فقط خداوند می‌تواند هر کس را بخواهد به روشنایی هدایت کند."],[376,"باز می‌دیدم که می‌شد هفت، یک","می‌شکافد نور او جیب فلک","دوباره می‌دیدم که هفت شمع به یک شمع تبدیل می‌شود و نور آن، فضای آسمان را می‌شکافد."],[376,"باز آن یک، بار دیگر هفت شد","مستی و حیرانی من زفت شد","شمع واحد دوباره به حالت هفت شمع تبدیل شد، و حال من از این تجربه دچار مستی و حیرت گشته است."],[376,"اتصالاتی میان شمعها","که نیاید بر زبان و گفت ما","ارتباطات و پیوندهایی میان شمع‌ها وجود دارد که نمی‌توان آنها را با زبان بیان کرد و نمی‌توان به راحتی درباره‌شان صحبت کرد."],[376,"آنک یک دیدن کند ادراک آن","سالها نتوان نمودن از زبان","هر زمان که کسی یک بار چیزی را مشاهده کند، فهم آن به قدری عمیق است که سال‌ها از صحبت کردن درباره‌اش نمی‌توان بهره برد."],[376,"آنک یک دم بیندش ادراک هوش","سالها نتوان شنودن آن بگوش","آن کسی که یک لحظه از خدا را درک کند، نمی‌تواند سال‌ها از آن درک، با گوش‌ش بشنود."],[376,"چونک پایانی ندارد رو الیک","زانک لا احصی ثناء ما علیک","چون ثنای تو را پایان و شمار نیست، پس رو به سوی تو می‌آوریم، چرا که نمی‌توانیم حمد و ستایش تو را به طور کامل بیان کنیم."],[376,"پیشتر رفتم دوان کان شمعها","تا چه چیزست از نشان کبریا","قبل از این، با شتاب و سرعت به جلو حرکت کردم تا ببینم آن شمع‌ها چه نشانه‌ای از عظمت و کبریایی دارند."],[376,"می‌شدم بی خویش و مدهوش و خراب","تا بیفتادم ز تعجیل و شتاب","به شدت در حال بی‌خودی و مستی بودم و از خودم بی‌خبر شدم، تا اینکه به خاطر شتاب و عجله‌ام روی زمین افتادم."],[376,"ساعتی بی‌هوش و بی‌عقل اندرین","اوفتادم بر سر خاک زمین","مدتی در حالتی از بی‌هوشی و عدم عقل بر خاک زمین افتاده بودم."],[376,"باز با هوش آمدم برخاستم","در روش گویی نه سر نه پاستم","من دوباره به هوش آمدم و از زمین بلند شدم، اما در این حالت، نه خبر از سرم دارم و نه از پایم."],[377,"هفت شمع اندر نظر شد هفت مرد","نورشان می‌شد به سقف لاژورد","هفت شمع در مقابل هفت مرد قرار گرفت و نورشان به سقف آبی (لاژوردی) می‌تابید."],[377,"پیش آن انوار نور روز، درد","از صلابت نورها را می‌سترد","در برابر آن نورها که مانند نور روز هستند، شجاعت و سختی نورها را از بین می‌برد و به زوال می‌برد."],[378,"باز هر یک مرد شد شکل درخت","چشمم از سبزی ایشان نیکبخت","هر یک از مردان با شکلی مانند درخت نمایان شدند و من از سرسبزی و وفور خیر و برکت آن‌ها خوشحالم."],[378,"زانبهی برگ پیدا نیست شاخ","برگ هم گم گشته از میوه فراخ","درختان زیبا و سرسبز به قدری دچار تحول و تغییر شده‌اند که نه تنها برگ آنها دیده نمی‌شود، بلکه شاخ و برگشان نیز ناپدید شده و از میوه‌های فراوانشان خبری نیست."],[378,"هر درختی شاخ بر سدره زده","سدره چه بود از خلا بیرون شده","هر درختی، شاخ و برگش به درخت سدره (درختی مقدس) وصل است، اما درخت سدره از اصل و منیعتی فراتر از وجود مادی خود برخاسته و از چیزی جز عدم و فضا بیرون آمده است."],[378,"بیخ هر یک رفته در قعر زمین","زیرتر از گاو و ماهی بد یقین","ریشه هر یک از درختان به عمق زمین نفوذ کرده و از گاو و ماهی هم پایین‌تر است. این نشان‌دهنده استحکام و پایداری آن‌ها در زمین است."],[378,"بیخشان از شاخ خندان‌روی‌تر","عقل از آن اشکالشان زیر و زبر","ریشه‌های آن درختان خندان، از نظر عقل به‌مراتب زیباتر و عالی‌تر از ظاهر ظاهری و شکل‌های مختلف آنهاست. به عبارتی، حقیقت و عمق وجود آنها در مقایسه با ظاهرشان بسیار بیشتر و بهتر است."],[378,"میوه‌ای که بر شکافیدی ز زور","همچو آب از میوه جستی برق نور","میوه‌ای که با شدت و قدرت چیدی، مانند آبی که از میوه برمی‌خیزد، نورانی و درخشان می‌شود."],[379,"این عجب‌تر که بریشان می‌گذشت","صد هزاران خلق از صحرا و دشت","این بسیار شگفت‌آور است که آنها از کنار این درختان می‌گذشتند در حالی که صدها هزار نفر از میان دشت و صحرا عبور می‌کردند."],[379,"ز آرزوی سایه جان می‌باختند","از گلیمی سایه‌بان می‌ساختند","به خاطر آرزوی سایه آن درختان جان خود را می‌باختند و از یک گلیم، سایه‌بان درست می‌کردند."],[379,"سایه آن را نمی‌دیدند هیچ","صد تفو بر دیده‌های پیچ پیچ","آن‌ها سایه این درختان را نمی‌دیدند و برای همین با حیرت و ناامیدی به چشم‌های خود لعنت می‌کردند."],[379,"ختم کرده قهر حق بر دیده‌ها","که نبیند ماه را بیند سها","خداوند به خاطر خشم و غضبش، بر چشمان مردم پرده‌ای انداخته است؛ به طوری که آن‌ها نمی‌توانند ماه (نماد حقیقت و زیبایی) را ببینند و تنها سها (ستاره‌ای دیگر) را می‌بینند."],[379,"ذره‌ای را بیند و خورشید نه","لیک از لطف و کرم نومید نه","انسان تنها می‌تواند ذره‌ای از حقیقت را ببیند و نه خورشید را به‌طور کامل. اما او نباید از لطف و کرم خدا ناامید باشد."],[379,"کاروانها بی نوا وین میوه‌ها","پخته می‌ریزد چه سحرست ای خدا","ای خدا، کاروان‌ها در حالت ناموزونی قرار دارند و میوه‌های ن ripe (پخته) در حال ریختن هستند؛ این چه جادویی است؟"],[379,"سیب پوسیده همی‌چیدند خلق","درهم افتاده به‌یغما خشک‌حلق","مردم در حال چیدن سیب‌های پوسیده‌ای هستند که بر زمین افتاده و به سرقت رفته‌ است. این سیب‌های خشک و بی‌ارزش نشان‌دهنده چیزهایی است که دیگر فایده‌ای ندارند."],[379,"گفته هر برگ و شکوفه آن غصون","دم بدم یا لیت قوم یعلمون","هر برگ و شکوفه از آن درختان می‌گوید، ای کاش قوم (مردم) می‌دانستند (که این درختان چه ثمراتی دارند)."],[379,"بانگ می‌آمد ز سوی هر درخت","سوی ما آیید خلق شوربخت","از هر درخت صدایی به سمت ما می‌آمد و دعوت می‌کرد که ای مردم بیچاره، به سوی ما بیایید."],[379,"بانگ می‌آمد ز غیرت بر شجر","چشمشان بستیم کلا لا وزر","صدای درختان به دلیل غیرتی که داشتند، چشمان ما را از دیدن آنها بسته بود و نمی‌توانستیم به آنها نزدیک شویم."],[379,"گر کسی می‌گفتشان کین سو روید","تا ازین اشجار مستسعد شوید","اگر کسی به شما می‌گفت که از این درختان بهره‌مند خواهید شد، به سمت آن درختان بروید."],[379,"جمله می‌گفتند کین مسکین مست","از قضاء الله دیوانه شدست","می‌گفتند که این انسان فقیر و بیچاره، به خاطر تقدیر الهی، دیوانه و مست شده است."],[379,"مغز این مسکین ز سودای دراز","وز ریاضت گشت فاسد چون پیاز","این شخص مسکین، به خاطر افکار عمیق و طولانی‌اش و همچنین به واسطه دشمنی که در اثر ریاضت کشیدن پیدا کرده، مثل پیاز فاسد و خراب شده است."],[379,"او عجب می‌ماند یا رب حال چیست","خلق را این پرده و اضلال چیست","مولانا در این بیت به حال حیرت و شگفتی خود اشاره می‌کند که چرا مردم درک درستی از حقیقت ندارند و در این بی‌خبری به سر می‌برند. او از خداوند پرسش می‌کند که جدایی و اشتباه این مردم چه دلیلی دارد."],[379,"خلق گوناگون با صد رای و عقل","یک قدم آن سو نمی‌آرند نقل","مردم با افکار و نظرات مختلف و با عقل‌های گوناگون، حتی یک قدم هم به درک حقیقت نزدیک نمی‌شوند."],[379,"عاقلان و زیرکانشان ز اتفاق","گشته منکر زین چنین باغی و عاق","عاقلان و هوشمندان آن‌ها به خاطر توافقی که با هم دارند، وجود چنین باغی (باغ معرفت یا عشق) را انکار می‌کنند."],[379,"یا منم دیوانه و خیره شده","دیو چیزی مر مرا بر سر زده","شاید من دیوانه‌ام و دچار اشتباه شده‌ام، که دیو (نماد شر یا جنون) چیزی در سرم گذاشته است."],[379,"چشم می‌مالم به‌هر لحظه که من","خواب می‌بینم خیال اندر زمن","در هر لحظه‌ای که خواب می‌بینم، با چشمانم به تعبیرات و تصوراتم می‌نگرم و آنها را همچون خیال، لمس و بررسی می‌کنم."],[379,"خواب چه بود بر درختان می‌روم","میوه‌هاشان می‌خورم چون نگروم","خواب چه بود؟ من در عالم خواب به درختان می‌روم و میوه‌هایشان را می‌چشم و می‌خورم، وقتی که به آن‌ها می‌نگرم."],[379,"باز چون من بنگرم در منکران","که همی‌گیرند زین بستان کران","چون دوباره به منکران نگاه می‌کنم، می‌بینم که از این باغ زیبا دور می‌مانند و چیزی از آن نمی‌چشند."],[379,"با کمال احتیاج و افتقار","ز آرزوی نیم غوره جانسپار","این بیت به بیان حالتی از انسان‌ها اشاره دارد که با تمام نیاز و ناتوانی خود، آرزوی رسیدن به چیزی را دارند و حتی حاضرند به خاطر آن آرزو جان خود را فدای آن کنند. در اینجا «نیم غوره» به یک آرزوی ناکام و اندک اشاره دارد که ارزش بالایی برای فرد دارد."],[379,"ز اشتیاق و حرص یک برگ درخت","می‌زنند این بی‌نوایان آه سخت","این بی‌نوایان به خاطر اشتیاق و حرص‌شان، به شدت به یک برگ درخت حمله می‌کنند و فریاد می‌زنند."],[379,"در هزیمت زین درخت و زین ثمار","این خلایق صد هزار اندر هزار","مردم از درخت و میوه‌های آن دور هستند و به خاطر بی‌خبری‌شان از این نعمت‌ها، در واقع صدها هزار نفر در هر زمان و مکان دچار نقص و کمبود شده‌اند."],[379,"باز می‌گویم عجب من بی‌خودم","دست در شاخ خیالی در زدم","من دوباره می‌گویم چقدر شگفت‌آور است که من بی‌خود، دستم را به شاخ و برگ خیالی زده‌ام."],[379,"حتی اذا ما استیاس الرسل بگو","تا بظنوا انهم قد کذبوا","در این بیت به مراحل سخت و ناامیدی پیامبران اشاره می‌شود، به‌گونه‌ای که حتی زمانی که آنان در تشنگی و ناامیدی به سر می‌برند، برخی فکر می‌کنند که آن‌ها دروغگو هستند. این بازتابی از چالش‌ها و مشکلاتی است که پیامبران در طول راه خود با آن‌ها مواجه می‌شوند و تعبیر از فشارهایی که بر آن‌ها می‌آید، حتی به حدی که در باور مردم ممکن است به دروغگویی متهم شوند."],[379,"این قرائت خوان که تخفیف کذب","این بود که خویش بیند محتجب","این بیان به این معناست که خواننده قرآن، یعنی پیامبر، به خاطر فریب و دروغی که دیگران می‌زنند، باید خود را در حالت پنهانی ببیند و از آن اجتناب کند. این اشاره به این دارد که او باید با دیده خود به حقیقت و درستی ایمان داشته باشد تا از کذب و دروغ‌های مردم مصون بماند."],[379,"در گمان افتاد جان انبیا","ز اتفاق منکری اشقیا","جان انبیا (پیامبران) به خاطر اتفاقی که از سوی کسانی که منکر حقایق هستند (اشقیا) برایشان پیش آمد، دچار تردید و گمان شد."],[379,"جائهم بعد التشکک نصرنا","ترکشان گو بر درخت جان بر آ","جایگاه ما بعد از تردید و شک، پیروزی ماست. ترک‌ها که نماد سختی‌ها و دشواری‌ها هستند، بر درخت جان ما تکیه کرده‌اند."],[379,"می‌خور و می‌ده بدان کش روزیست","هر دم و هر لحظه سحرآموزیست","همان‌طور که روز به روز و لحظه به لحظه، چیزهای جدید و شگفت‌انگیزی وجود دارد، باید از می (نوشیدنی) بنوشی و به دیگران نیز بدهی، زیرا همواره در زندگی چیزهایی جدید و سحرآمیز در حال ظهور است."],[379,"خلق‌گویان ای عجب این بانگ چیست","چونک صحرا از درخت و بر تهیست","مردم می‌گویند که این صدا چیست، در حالی که صحرا خالی از درخت و سبزه است."],[379,"گیج گشتیم از دم سوداییان","که به نزدیک شما باغست و خوان","ما در اثر سخنان دیوانه‌وار عده‌ای سردرگم و گیج شده‌ایم که می‌گویند در نزدیکی شما باغی وجود دارد و مهمانی برپاست."],[379,"چشم می‌مالیم اینجا باغ نیست","یا بیابانیست یا مشکل رهیست","ما از دیدن باغی که به آن اشاره می‌شود، ناامید و سردرگم هستیم و در این مکان یا بیابانی وجود دارد یا راه رسیدن به باغ، سخت و دشوار است."],[379,"ای عجب چندین دراز این گفت و گو","چون بود بیهوده ور خود هست کو","چقدر عجیب است که این گفت‌وگو این‌قدر طولانی شده، در حالی که اگر خود شخصی وجود نداشته باشد، این گفتگو بیهوده است."],[379,"من همی‌گویم چو ایشان ای عجب","این چنین مهری چرا زد صنع رب","من نیز در تعجبم، چرا اینچنین مهر و نشانی بر این خلق زده شده است، در حالی که خداوند (رب) صانع و آفریننده است."],[379,"زین تنازعها محمد در عجب","در تعجب نیز مانده بولهب","محمد (پیامبر اسلام) از این دعواها و درگیری‌ها در شگفتی است، زیرا بولهب (عموی او) نیز در حیرت و تعجب به سر می‌برد."],[379,"زین عجب تا آن عجب فرقیست ژرف","تا چه خواهد کرد سلطان شگرف","از این تعجب تا آن تعجب تفاوتی عمیق وجود دارد؛ باید دید سلطان بزرگ (خدا) چه کار خواهد کرد."],[379,"ای دقوقی تیزتر ران هین خموش","چند گویی چند چون قحطست گوش","ای دقوقی (نوازنده معروف) هرچه تندتر بران، سکوت کن! چرا که چه فایده دارد که مدام سخن بگویی وقتی که دیگران گوش شنوا ندارند و در قحطی کلام قرار دارند."],[380,"گفت راندم پیشتر من نیکبخت","باز شد آن هفت جمله یک درخت","من پیشتر گفتم که من خوشبختم و اکنون آن هفت بعد (یا ویژگی) به یک درخت تبدیل شد."],[380,"هفت می‌شد فرد می‌شد هر دمی","من چه سان می‌گشتم از حیرت همی","هر لحظه که می‌گذشت، هفت می، یعنی شراب معنوی، به یک تبدیل می‌شد و من در شگفتی و حیرت بودند که چگونه این تغییرات در من رخ می‌دهد."],[380,"بعد از آن دیدم درختان در نماز","صف کشیده چون جماعت کرده ساز","پس از آن، درختان را دیدم که در حال نماز مثل جمعیتی منظم در صف ایستاده‌اند."],[380,"یک درخت از پیش مانند امام","دیگران اندر پس او در قیام","یک درخت به عنوان پیشوا و امام، در جلو ایستاده و سایر درختان پشت او در هنگام قیام و عبادت قرار دارند."],[380,"آن قیام و آن رکوع و آن سجود","از درختان بس شگفتم می‌نمود","آن قیام و رکوع و سجود درختان برای من بسیار شگفت‌انگیز بود."],[380,"یاد کردم قول حق را آن زمان","گفت النجم و شجر را یسجدان","من به یاد سخن خدا افتادم که فرموده است: «ستاره‌ها و درختان هم به سجده می‌افتند."],[380,"این درختان را نه زانو نه میان","این چه ترتیب نمازست آنچنان","این درختان نه زانو دارند و نه وسطی برای قرار گرفتن، پس این چه نوع نمازی است که اینگونه انجام می‌دهند؟"],[380,"آمد الهام خدا کای بافروز","می عجب داری ز کار ما هنوز","الهام خدا به تو رسید و می‌گوید: ای بافروز، شگفت‌انگیز است که هنوز از کار ما بی‌خبر هستی."],[381,"بعد دیری گشت آنها هفت مرد","جمله در قعده پی یزدان فرد","بعد از مدتی، آن هفت مرد همه گرد هم نشسته و در حضور خداوند یگانه هستند."],[381,"چشم می‌مالم که آن هفت ارسلان","تا کیانند و چه دارند از جهان","من به این فکر می‌کنم که آن هفت مرد بزرگ (که به آن‌ها ارسلان گفته می‌شود) چه کسانی هستند و چه دستاوردهایی از دنیا دارند."],[381,"چون به نزدیکی رسیدم من ز راه","کردم ایشان را سلام از انتباه","وقتی به آن هفت ارسلان نزدیک شدم، سلامی به آن‌ها کردم که با شگفتی و توجه ویژه‌ای بود."],[381,"قوم گفتندم جواب آن سلام","ای دقوقی مفخر و تاج کرام","مردم گفتند که جواب سلام من را بدهند، ای دقوقی، که مایه‌ی فخر و تاج‌دار بزرگی."],[381,"گفتم آخر چون مرا بشناختند","پیش ازین بر من نظر ننداختند","گفتم چرا این بار مرا شناختند، در حالی که قبل از این به من توجه نکرده بودند."],[381,"از ضمیر من بدانستند زود","یکدگر را بنگریدند از فرود","آن‌ها از حال من به سرعت متوجه شدند و به یکدیگر نگریستند تا ببینند چه بر من گذشته است."],[381,"پاسخم دادند خندان کای عزیز","این بپوشیدست اکنون بر تو نیز","پاسخ آن‌ها با خنده به من گفتند: «ای عزیز، این موضوع را در حال حاضر بپوشان و برای تو هم همین بهتر است."],[381,"بر دلی کو در تحیر با خداست","کی شود پوشیده راز چپ و راست","دل کسی که در حیرت و شگفتی از وجود خداست، چگونه ممکن است که راز راست و چپ (درست و نادرست) از او پنهان بماند؟"],[381,"گفتم ار سوی حقایق بشگفند","چون ز اسم حرف رسمی واقفند","اگر به عمق حقایق آگاه شوند و از اسرار آنها پرده‌برداری کنند، این فقط به خاطر آن است که از واژه‌ها و اصطلاحات رسمی و معنایی آنها باخبر هستند."],[381,"گفت اگر اسمی شود غیب از ولی","آن ز استغراق دان نه از جاهلی","مولانا می‌گوید اگر نامی از غیب بر ولی (فرستاده خدا) بیان شود، این نشانه‌ای از آگاهی او به حقیقت و اموری ناشناخته است و نه به خاطر نادانی یا بی‌خبری."],[381,"بعد از آن گفتند ما را آرزوست","اقتدا کردن به تو ای پاک دوست","آن‌ها گفتند که آرزوی ما این است که بتوانیم مانند تو، ای دوست پاک، راه تو را دنبال کنیم و به تو اقتدا کنیم."],[381,"گفتم آری لیک یک ساعت که من","مشکلاتی دارم از دور زمن","گفتم بله، اما من در حال حاضر مشکلاتی دارم که باعث می‌شود نتوانم از دور با تو همراهی کنم."],[381,"تا شود آن حل به صحبتهای پاک","که به صحبت روید انگوری ز خاک","برای حل مشکلات، نیاز به گفت‌وگوهای پاک و خالصانه است، همان‌طور که انگور از زمین می‌روید."],[381,"دانه پرمغز با خاک دژم","خلوتی و صحبتی کرد از کرم","دانه پرمغز در خلوتی با خاک تلخ و ناامید گفتگو کرد و از روی لطف و خوبی، با او رابطه‌ای برقرار کرد."],[381,"خویشتن در خاک کلی محو کرد","تا نماندش رنگ و بو و سرخ و زرد","انسان در این عالم مادی باید خود را کاملا در خاک و طبیعت غرق کند تا از ویژگی‌های ظاهری و دنیاوی مانند رنگ و بو و زیبایی‌های دنیوی (سرخ و زرد) رهایی یابد و خود را به شناخت عمیق‌تری برساند."],[381,"از پس آن محو قبض او نماند","پرگشاد و بسط شد مرکب براند","پس از آنکه خود را به‌کلی محو کرد، دیگر از کنش‌ها و ویژگی‌های ظاهری او چیزی باقی نماند و در نتیجه، وجود او به نوعی گسترش و انبساط تبدیل شد."],[381,"پیش اصل خویش چون بی‌خویش شد","رفت صورت جلوه معنیش شد","وقتی انسان از اصل خود جدا می‌شود و هویت واقعی‌اش را گم می‌کند، به مانند کسی است که بی‌هویت و بی‌خود شده است و در این حال، تنها به جلوه‌های ظاهری خود توجه می‌کند."],[381,"سر چنین کردند هین فرمان توراست","تف دل از سر چنین کردن بخاست","به خاطر این‌که چنین کارهایی انجام ندهید، باید از خودتان دل کنده و به فرمان خداوند عمل کنید."],[381,"ساعتی با آن گروه مجتبی","چون مراقب گشتم و از خود جدا","در ساعتی که با آن گروه مجتبی (مراقب خود) بودم، متوجه شدم که از خودم جدا شده‌ام."],[381,"هم در آن ساعت ز ساعت رست جان","زانک ساعت پیر گرداند جوان","در آن زمان، جان از ساعت جدا شده است زیرا ساعت (زمان) پیر می‌شود و جوانی را به گردش درمی‌آورد."],[381,"جمله تلوینها ز ساعت خاستست","رست از تلوین که از ساعت برست","همه تغییرات و دگرگونی‌ها ناشی از ساعت و زمان است و اگر کسی از این تغییرات رها شود، از زمان جدا خواهد شد."],[381,"چون ز ساعت ساعتی بیرون شوی","چون نماند محرم بی‌چون شوی","وقتی از زمان و محدودیت‌های آن آزاد شوی، دیگر در هیچ چیز نخواهی بود که راز و رمز آن را بشناسی."],[381,"ساعت از بی‌ساعتی آگاه نیست","زانکش آن سو جز تحیر راه نیست","ساعت (زمان) از بی‌زمانی خبر ندارد، زیرا در آن سمت (جهان باکیفیت دیگر) جز سرگردانی و حیرت وجود ندارد."],[381,"هر نفر را بر طویله خاص او","بسته‌اند اندر جهان جست و جو","هر فردی در دنیا به وظایف و مشاغل خاص خودش مشغول شده و هر کس باید در زمینه خود تلاش و کاوش کند."],[381,"منتصب بر هر طویله رایضی","جز بدستوری نیاید رافضی","هر کسی در هر جایی که قرار دارد، نمی‌تواند از دستور و قوانینی که در آنجا وجود دارد، خارج شود؛ به همین خاطر، کسی که در جایی خاص است، نمی‌تواند بدون مجوز وارد جای دیگری شود."],[381,"از هوس گر از طویله بسکلد","در طویله دیگران سر در کند","اگر شخصی از هوس یا میلش از جایی خارج شود، به طوری که در نظر دیگران قرار گیرد، در آن صورت به جاهای دیگر نیز سرک می‌کشد و در آنها نیز تأثیر می‌گذارد."],[381,"در زمان آخرجیان چست خوش","گوشه افسار او گیرند و کش","در آخرالزمان، افرادی با زیرکی و زرنگی در کنار مسیر زندگی خود، افسار او (انسان) را به دست می‌گیرند و او را به سویی می‌کشانند."],[381,"حافظان را گر نبینی ای عیار","اختیارت را ببین بی اختیار","اگر حافظان و نگهبانان را نمی‌بینی، ای شخص زیرک و باهوش، به اختیارت توجه کن که بدون انتخاب خودت به حالت بی‌اختیاری درآمده‌ای."],[381,"اختیاری می‌کنی و دست و پا","برگشا دستت، چرا حبسی چرا","تو اختیاری را که داری، از خودت می‌گیری و به دنبال آزادی هستی، اما چرا خود را زندانی کرده‌ای؟"],[381,"روی در انکار حافظ برده‌ای","نام تهدیدات نفسش کرده‌ای","تو به خاطر انکار حق، به خودت آسیب رسانده‌ای و به وعده‌های نفس خود بی‌اعتنا شده‌ای."],[382,"این سخن پایان ندارد تیز دو","هین نماز آمد دقوقی پیش رو","این صحبت پایان‌پذیر نیست، به سرعت بیا و توجه کن که دقوقی (امام) برای برپایی نماز آمده است."],[382,"ای یگانه هین دوگانه بر گزار","تا مزین گردد از تو روزگار","ای تنها و بی‌نظیر، هر دو طرف را یکی کن و نماز را به‌جا آور تا روزگار از لطف تو زینت یابد."],[382,"ای امام چشم‌روشن در صلا","چشم روشن باید ایدر پیشوا","ای امام که بینا و روشنی، در برابر این صدا و ندا، تنها کسی که شایسته است، باید پیشوا باشد."],[382,"در شریعت هست مکروه ای کیا","در امامت پیش کردن کور را","در دین اسلام، یکی از کارهای ناپسند این است که شخص نابینا را به عنوان امام و پیشوای جماعت برگزینند، چرا که امام باید بینا و آگاه باشد تا بتواند به درستی هدایت کند."],[382,"گرچه حافظ باشد و چست و فقیه","چشم‌روشن به وگر باشد سفیه","شخصی که حافظ کل قرآن باشد و از نظر اخلاقی و فقهی نیز درستکار و باهوش باشد، در مقام رهبری و امامت شایسته است؛ اما اگر کسی سفیه و نادان باشد، حتی اگر ظاهرش خوب و چشمانش روشن باشد، نباید او را در این مقام قرار داد."],[382,"کور را پرهیز نبود از قذر","چشم باشد اصل پرهیز و حذر","شخص نابینا از نگاه به چیزهای ناپسند پرهیز ندارد، چون نمی‌تواند ببیند. اما اصل پرهیز و احتیاط در توانایی بینایی است، به این معنا که شخص بینا باید از هر چیزی که ناپسند است دوری کند."],[382,"او پلیدی را نبیند در عبور","هیچ مؤمن را مبادا چشم کور","مؤمن در هنگام عبور از پلیدی‌ها و ناپاکی‌ها چیزی نخواهد دید و برایش اهمیتی نخواهد داشت، چون چشم او (چشم باطن) کور است و به ناپاکی‌ها توجهی نمی‌کند."],[382,"کور ظاهر در نجاسه ظاهرست","کور باطن در نجاسات سرست","کور ظاهری فقط به مسائل ظاهری و نجاست‌های ظاهری توجه دارد، اما کور باطنی در درک آلودگی‌های باطنی و روحی ناتوان است."],[382,"این نجاسه ظاهر از آبی رود","آن نجاسه باطن افزون می‌شود","نجاست ظاهری که با آب رود شسته می‌شود، باعث افزایش نجاست باطنی می‌شود. یعنی پاک کردن ظواهر، برای رفع آلودگی‌های درونی کافی نیست."],[382,"جز به آب چشم نتوان شستن آن","چون نجاسات بواطن شد عیان","تنها با آب اشک نمی‌توان این نجاست‌ها را که در باطن وجود دارد پاک کرد، زیرا نجاست‌های باطنی به وضوح آشکار شده‌اند."],[382,"چون نجس خواندست کافر را خدا","آن نجاست نیست بر ظاهر ورا","خداوند کافر را نجس نامیده است، اما این نجاست تنها به ظاهر او مربوط نمی‌شود."],[382,"ظاهر کافر ملوث نیست زین","آن نجاست هست در اخلاق و دین","ظاهر کافر به لحاظ ظاهری نجس و آلوده نیست، اما این نجاست به معنای ناپاکی در اخلاق و دین او وجود دارد."],[382,"این نجاست بویش آید بیست گام","و آن نجاست بویش از ری تا به‌شام","اخلاق و دین ناپاکی، از دور بوی خود را مشخص می‌کند؛ به طوری که بوی نجاست اخلاقی کسی از بیست قدمی حس می‌شود، در حالی که بوی نجاست ظاهری مثل بوی جسمی از مسیری طولانی، مانند از ری تا به شام، احساس نمی‌شود."],[382,"بلک بویش آسمانها بر رود","بر دماغ حور و رضوان بر شود","اما بوی او (خدا) چنان است که در آسمان‌ها به مشام می‌رسد و بر صورت حوریان (موجودات بهشتی) و در بهشت (رضوان) می‌نشیند."],[382,"اینچ می‌گویم به قدر فهم تست","مردم اندر حسرت فهم درست","من می‌گویم به اندازه‌ی درک و فهم توست که من در حسرت درک درست و واقعی چیزی حیات خود را از دست داده‌ام."],[382,"فهم آبست و وجود تن سبو","چون سبو بشکست ریزد آب ازو","در این بیت، مولانا به رابطه میان فهم و وجود اشاره می‌کند. او می‌گوید که فهم مانند آبی است که درون تن یا سبویی (که نماد وجود انسان است) قرار دارد و وقتی سبو (تن) شکسته شود، آب (فهم) جاری خواهد شد. بنابراین، اگر وجود انسان دچار نقص یا آسیب شود، فهم او نیز از بین می‌رود."],[382,"این سبو را پنج سوراخست ژرف","اندرو نه آب ماند خود نه برف","این تن مانند سبویی است که پنج سوراخ عمیق دارد، به طوری که نه چیزی از آب در آن باقی می‌ماند و نه برف."],[382,"امر غضوا غضة ابصارکم","هم شنیدی راست ننهادی تو سم","به یاد داری که دستور غض بصر (پائین نگاه داشتن چشم‌ها) در قرآن آمده است، اما تو این را به درستی نپذیرفتی و در عمل رعایت نکردی."],[382,"از دهانت نطق فهمت را برد","گوش چون ریگست فهمت را خورد","فهم تو مانند دانه‌های ریگ از دهانت بیرون می‌رود و در گوش دیگران به خوبی شنیده نمی‌شود."],[382,"همچنین سوراخهای دیگرت","می‌کشاند آب فهم مضمرت","سوراخ‌های دیگر تو نیز آب درک و فهم تو را به سمت خود می‌کشد و جذب می‌کند."],[382,"گر ز دریا آب را بیرون کنی","بی عوض آن بحر را هامون کنی","اگر آب را از دریا بیرون کنی، به جای آن چیزی به دریا نمی‌افزایی و در نتیجه دریا را همانند علفزاری خشک و بی آب خواهی کرد."],[382,"بیگهست ار نه بگویم حال را","مدخل اعواض را و ابدال را","اگر بخواهم درباره حال و احوال بگویم، باید در مورد ورودی‌ها و جایگزین‌ها صحبت کنم."],[382,"کان عوضها و آن بدلها بحر را","از کجا آید ز بعد خرجها","عوض‌ها و بدل‌ها چگونه می‌توانند از دریا بیایند در حالی که ابتدا خرج‌ها و هزینه‌ها باید پرداخت شود؟"],[382,"صد هزاران جانور زو می‌خورند","ابرها هم از برونش می‌برند","بسیاری از موجودات زنده از همین ابرها و باران‌ها تغذیه می‌کنند و ابرها نیز از آنچه خارج می‌شود، بهره‌مند می‌گردند."],[382,"باز دریا آن عوضها می‌کشد","از کجا دانند اصحاب رشد","دریا، آن نعمت‌ها و پاداش‌های خود را به سوی دیگر می‌برد. اما اصحاب رشد (آنان که به کمال و پختگی رسیده‌اند)، از کجا می‌دانند که این تغییرات و انتقالات به چه دلیل و از کجا ناشی می‌شوند؟"],[382,"قصه‌ها آغاز کردیم از شتاب","ماند بی مخلص درون این کتاب","ما داستان‌ها را از شدت شتاب آغاز کردیم، اما کسی که خالص و بدون ریا باشد، درون این کتاب باقی خواهد ماند."],[382,"ای ضیاء الحق حسام الدین راد","که فلک و ارکان چو تو شاهی نزاد","ای نور حقیقت، حسام الدین رادی، که همچون تو پادشاهی در آسمان‌ها و در زمین وجود ندارد."],[382,"تو به‌نادر آمدی در جان و دل","ای دل و جان از قدوم تو خجل","تو به ندرت به جان و دل می‌رسی و من، ای دل و جان، از آمدن تو شرمنده‌ام."],[382,"چند کردم مدح قوم ما مضی","قصد من زانها تو بودی ز اقتضا","من چندین بار از قوم خود ستایش کردم، اما هدف من از این کار فقط تو بودی و این به خاطر اقتضای عشق و حالتی است که برای تو دارم."],[382,"خانه خود را شناسد خود دعا","تو بنام هر که خواهی کن ثنا","انسان باید خود را بشناسد و در دعاها و ستایش‌هایش، فقط به خداوندی که به او یقین دارد توجه کند و به دیگران توجه نداشته باشد."],[382,"بهر کتمان مدیح از نا محل","حق نهادست این حکایات و مثل","به خاطر پنهان کردن ستایش از جای نادرست، حق این داستان‌ها و مثل‌ها را قرار داده است."],[382,"گرچه آن مدح از تو هم آمد خجل","لیک بپذیرد خدا جهد المقل","هرچند آن ستایش از تو با شرم و خجالت بیان شد، اما خداوند تلاش کم‌تر از تو را می‌پذیرد."],[382,"حق پذیرد کسره‌ای دارد معاف","کز دو دیده کور دو قطره کفاف","حق، برای کسی که دچار زحمت و سختی است، نقصی قائل نیست و نیاز نیست انسان به خاطر کمبودها، شرمسار باشد؛ چون در واقع او از دو چشمی که بینا نیستند، فقط به اندازه دو قطره اشک به او کمک می‌شود."],[382,"مرغ و ماهی داند آن ابهام را","که ستودم مجمل این خوش‌نام را","مرغ و ماهی از آن راز و ابهام آگاهند که من از این شخص خوش‌نام ستایش کردم."],[382,"تا برو آه حسودان کم وزد","تا خیالش را به دندان کم گزد","تا وقتی که آه حسودان به کسی اذیت نرساند، خیالات و ترس‌های او رنج نخواهد برد و به او آسیب نمی‌زند."],[382,"خود خیالش را کجا یابد حسود","در وثاق موش طوطی کی غنود","حسود چگونه می‌تواند خیالی را که در انتظارش است بیابد، در حالی که در تنگنای موش (محل خطر) و در خواب طوطی (به معنای بی‌خبر و خواب آلود) قرار دارد؟"],[382,"آن خیال او بود از احتیال","موی ابروی ویست آن نه هلال","این خیال که حسود از آن نوعی دلخوشی دارد، در واقع ناشی از موی ابروهای توست و نه چیزی دیگر، مانند هلال ماه."],[382,"مدح تو گویم برون از پنج و هفت","بر نویس اکنون دقوقی پیش رفت","من اکنون در وصف تو نیکی می‌گویم و قصد دارم آن را در دست بنویسم، در حالی که دقوقی (شخصی معتبر و مذهبی) به جلو می‌رود."],[383,"در تحیات و سلام الصالحین","مدح جمله انبیا آمد عجین","در سلام‌ها و تحیات نیکوکاران، ستایش همه پیامبران به هم آمیخته است."],[383,"مدحها شد جملگی آمیخته","کوزه‌ها در یک لگن در ریخته","مدح‌ها و ستایش‌ها همگی با هم ترکیب شده‌اند، مثل این‌که چند کوزه را در یک لگن بریزیم و همه‌ی محتویات آن‌ها با هم مخلوط شود."],[383,"زانک خود ممدوح، جز یک بیش نیست","کیشها زین روی، جز یک کیش نیست","هرچه مدح و ستایش وجود دارد، در حقیقت به یک شخص و حقیقت واحد بازمی‌گردد، چون آنچه که مورد ستایش قرار می‌گیرد، تنها یک اصل و حقیقت است و همه کیش‌ها و عقاید دیگر به همین یک حقیقت مربوط می‌شوند."],[383,"دان که هر مدحی به‌نور حق رود","بر صور و اشخاص عاریت بود","بدان که هر گونه ستایش و مدحی که وجود دارد، به واسطه نور و حقیقت الهی به وجود می‌آید و در واقع بر روی اشخاص و چیزها، تنها به صورت عاریتی و موقتی است."],[383,"مدحها جز مستحق را کی کنند","لیک بر پنداشت گم‌ره می‌شوند","مدح و ستایش تنها برای کسانی است که شایسته آن باشند، اما برخی به واسطه ناآگاهی و گمراهی، به ستایش کسانی می‌پردازند که سزاوار آن نیستند."],[383,"همچو نوری تافته بر حایطی","حایط آن انوار را چون رابطی","چنان‌که نوری بر دوردست‌ها می‌تابد، این نورها هم مانند واسطه‌ای عمل می‌کنند."],[383,"لاجرم چون سایه سوی اصل راند","ضال مه گم کرد و ز استایش بماند","بنابراین، مانند سایه‌ای که به سوی اصل خود برمی‌گردد، شخصی که راه را گم کرده و به بی‌راهه می‌رود، در نهایت به علت گم شدن حقیقت، از ستایش و تقدیر باز می‌ماند."],[383,"یا ز چاهی عکس ماهی وا نمود","سر به‌چه در کرد و آن را می‌ستود","کسی مانند دقوقی، که به امامت قوم خود گمارده شده است، در چاه به جستجوی ماه می‌رود و با دیدن تصویر آن در آب، آن را ستایش می‌کند. او به جای شناخت حقیقت، تنها به تصویر نگریسته و آن را می‌ستاید."],[383,"در حقیقت مادح ماهست او","گرچه جهل او بعکسش کرد رو","او در واقع مدح‌کننده ماه است، هرچند جهل او سبب شده که دیدگاهش معکوس شود و نسبت به آنچه می‌ستاید، اشتباه کند."],[383,"مدح او مه‌راست نه آن عکس را","کفر شد آن چون غلط شد ماجرا","ستایش او حقیقتا مانند ماه است و نه تصویر معکوس او؛ آن تصویر معکوس به کفر تعبیر می‌شود، زیرا ماجرا اشتباه شده است."],[383,"کز شقاوت گشت گم‌ره آن دلیر","مه به بالا بود و او پنداشت زیر","به خاطر بدبختی، آن دلیر (شخصیت مورد نظر) به راهی نادرست رفت و به جای اینکه به اوج و علو برود، خود را در پستی و ذلت دید، چون این مسیر را اشتباه برداشت کرد."],[383,"زین بتان خلقان پریشان می‌شوند","شهوت رانده پشیمان می‌شوند","از این بت‌ها (عشق‌های خیالی یا معبودهای دروغین) مردم دچار آشفتگی و پریشانی می‌شوند و پس از آنکه از شهوت خود دور می‌شوند، احساس پشیمانی می‌کنند."],[383,"زآنک شهوت با خیالی رانده است","وز حقیقت دورتر وا مانده است","چون شهوت با خیال و آرزو کنار رفته، انسان از حقیقت و واقعیت اصلی خود دور مانده است."],[383,"با خیالی میل تو چون پر بود","تا بدان پر بر حقیقت بر شود","میل تو به خیالی مانند پر است و این پر تو را به حقیقت می‌رساند."],[383,"چون براندی شهوتی پرّت بریخت","لنگ گشتی و آن خیال از تو گریخت","زمانی که شهوتی را رد می‌کنی، قدرت و بال و پر تو از دست می‌رود و در نتیجه، در دنیا دچار عقب‌نشینی می‌شوی و آن خیال زیبای عشق، از تو دور می‌شود."],[383,"پر نگه دار و چنین شهوت مران","تا پر میلت برد سوی جنان","پر خود را حفظ کن و شهوت را به دنبال خود نرانی، زیرا این شهوت تو را به سوی بهشت می‌برد."],[383,"خلق پندارند عشرت می‌کنند","بر خیالی پر خود بر می‌کنند","مردم گمان می‌کنند که در حال خوش‌گذرانی و لذت بردن هستند، در حالی که در واقع بر پایه یک خیال نامعتبر و ناواقعی زندگی می‌کنند."],[383,"وام‌دار شرح این نکته شدم","مهلتم ده معسرم زان تن زدم","من به شرح این نکته و مفهوم آن نیاز دارم، پس کمی مهلت بدهید؛ زیرا من به علت تنگ‌دستی و ناتوانی از به‌دست آوردن معیشت، از دنیای مادی فاصله گرفتم."],[384,"پیش در شد آن دقوقی در نماز","قوم همچون اطلس آمد او طراز","دقوقی، که فردی برجسته و محبوب است، پیشاپیش صف نمازگزاران قرار می‌گیرد و مانند پارچه‌ای لطیف و خوش‌رنگ (اطلس) درخشنده و متمایز به نظر می‌رسد."],[384,"اقتدا کردند آن شاهان قطار","در پی آن مقتدای نامدار","آن شاهان بزرگ، با نظم و ترتیب، به دقوقی که پیشوای معروفی است، اقتدا کردند و به او پیوستند."],[384,"چونک با تکبیرها مقرون شدند","همچو قربان از جهان بیرون شدند","چون با گفتن «تکبیر»، یعنی اعلام بزرگ‌مردی خدا، همراه شدند، مانند قربانی‌ها از دنیای مادی جدا شدند."],[384,"معنی تکبیر اینست ای امیم","کای خدا پیش تو ما قربان شدیم","معنی تکبیر این است که ما به تو، ای خدا، ادای احترام می‌کنیم و به نشانه تسلیم و قربانی شدن برای تو، به حضور تو آمده‌ایم."],[384,"وقت ذبح، الله‌اکبر می‌کنی","همچنین در ذبح نفس کشتنی","در زمان ذبح، با گفتن «الله‌اکبر» اشاره به قربانی کردن در راه خدا داری، همان‌طور که باید بر نفس خود نیز غلبه کنی و آن را بکشی."],[384,"تن چو اسمعیل و جان همچون خلیل","کرد جان تکبیر بر جسم نبیل","بدن مانند اسماعیل (که به خاطر فرمان خدا آماده قربانی شدن بود) و جان مانند خلیل (ابراهیم، که با جان خود تسلیم خدا شد) است، به همین دلیل بر جان شریف و باارزش این تکبیر (خدای بزرگ را بزرگ دانستن) را باید گفت."],[384,"گشت کشته تن ز شهوتها و آز","شد به بسم الله بسمل در نماز","تن انسان به خاطر شهوات و آزهایی که داشت، به نوعی کشته و نابود شده است و اکنون با گفتن «بسم الله» در آغاز نماز، همچون قربانی که در مراسم قربانی کردن ذبح می‌شود، به دست خداوند سپرده می‌شود."],[384,"چون قیامت پیش حق صفها زده","در حساب و در مناجات آمده","در روز قیامت، صف‌های زیادی در برابر خداوند تشکیل خواهد شد و مردم برای حسابرسی و دعا و نیایش به حضور او خواهند آمد."],[384,"ایستاده پیش یزدان اشک‌ریز","بر مثال راست‌خیز رستخیز","در برابر خداوند ایستاده، با اشک‌های ریخته، به‌گونه‌ای که مانند روز قیامت (رستخیز) است."],[384,"حق همی‌گوید چه آوردی مرا","اندرین مهلت که دادم من تورا","خداوند می‌گوید در این فرصتی که به تو داده‌ام، چه کاری برای من انجام دادی و چه چیزی به من آوردی؟"],[384,"عمر خود را در چه پایان برده‌ای","قوت و قوّت در چه فانی کرده‌ای","تو عمرت را در چه چیزی گذرانده‌ای و نیروی خود را در چه چیزهایی به هدر داده‌ای؟"],[384,"گوهر دیده کجا فرسوده‌ای","پنج حس را در کجا پالوده‌ای","از کجا دیده و بینایی‌ات را از دست داده‌ای و در کجا توانسته‌ای حواس پنج‌گانه‌ات را پاک و خالص کرده‌ای؟"],[384,"چشم و هوش و گوش و گوهرهای عرش","خرج کردی چه خریدی تو ز فرش","تو نیروها و امکاناتی که از قبیل چشم، هوش، گوش و جوهرهای باارزش آسمانی داری را چه طور هزینه کردی و در عوض چه چیزی از زندگی زمینی به دست آوردی؟"],[384,"دست و پا دادمت چون بیل و کلند","من ببخشیدم ز خود آن کی شدند","من به تو دست و پا داده‌ام، چون بیل و کلنگ برای کار، اما آنچه از خود به تو بخشیده‌ام، دیگر به چه چیزی تبدیل شده است؟"],[384,"همچنین پیغامهای دردگین","صد هزاران آید از حضرت چنین","پیام‌های دردناکی از سوی خداوند می‌آید که به تعداد بسیار زیاد است و می‌توان آن‌ها را درک کرد."],[384,"در قیام این گفتها دارد رجوع","وز خجالت شد دوتا او در رکوع","در حال قیام، به نظر می‌رسد این سخنان به او برمی‌گردد و از شرم، او در حالت رکوع به دو نیم شده است."],[384,"قوت استادن از خجلت نماند","در رکوع از شرم تسبیحی بخواند","اگر کسی به خاطر شرم و خجالت نتواند به راحتی بایستد و در حالت رکوع باقی بماند، باید به جای آن، در این حالت تسبیح بگوید و ذکر خداوند را زنده نگه دارد."],[384,"باز فرمان می‌رسد بردار سر","از رکوع و پاسخ حق بر شمر","پس از اینکه سر خود را از رکوع برمی‌دارند، به آن‌ها دستور می‌رسد که پاسخ حق را بدهند و در این جا به چیزی که از آنها خواسته شده، اهمیت داده می‌شود."],[384,"سر بر آرد از رکوع آن شرمسار","باز اندر رو فتد آن خام‌کار","شرمسار (شرمنده) از رکوع (حالت خم شدن برای نماز) سر خود را بلند می‌کند، اما دوباره به حالت خامی و نادانی خود بازمی‌گردد."],[384,"باز فرمان آیدش بردار سر","از سجود و وا ده از کرده خبر","به او امر می‌شود که سرش را از سجده بلند کند و از کارهایی که کرده است، آگاه شود."],[384,"سر بر آرد او دگر ره شرمسار","اندر افتد باز در رو همچو مار","او (مکلّم) سرش را بلند می‌کند، اما دوباره با شرم به زمین می‌افتد و مانند مار در جا خود می‌خزد."],[384,"باز گوید سر برآر و باز گو","که بخواهم جست از تو مو به مو","او (دقوقی) می‌گوید که دوباره سرش را بالا بیاور و بگو که من می‌خواهم جزئیات تو را دقیقا بررسی کنم و از تو بیاموزم."],[384,"قوت پا ایستادن نبودش","که خطاب هیبتی بر جان زدش","او قدرت ایستادن نداشت، زیرا سخن و حالتی از هیبت و عظمت بر جانش تاثیر گذاشته بود."],[384,"پس نشیند قعده زان بار گران","حضرتش گوید سخن گو با بیان","پس از آنکه آن شخص در اثر هیبت و سنگینی آن حال نتوانست ایستاده بماند و مجبور به نشستن شد، حضرتش (خدا) به او سخنی می‌گوید که با بیان روشن و شیوا است."],[384,"نعمتت دادم بگو شکرت چه بود","دادمت سرمایه هین بنمای سود","خداوند نعمت‌های زیادی به تو داده است، حالا بگو برای شکرگزاری چه کرده‌ای؟ من به تو سرمایه‌ای بخشیده‌ام، حالا باید سود آن را نشان دهی."],[384,"رو به دست راست آرد در سلام","سوی جان انبیا و آن کرام","به سمت راست خود می‌رود و سلام می‌دهد به روح انبیا و شخصیت‌های بزرگ که دارای کرامت هستند."],[384,"یعنی ای شاهان شفاعت کین لئیم","سخت در گل ماندش پای و گلیم","ای پادشاهان شفاعت، حالا که انسان‌های لئیم (پست) در این دنیا گرفتار سختی‌ها و دشواری‌ها شده‌اند، نمی‌توانند به راحتی از این وضعیت نجات یابند."],[385,"انبیا گویند روز چاره رفت","چاره آنجا بود و دست‌افزار زفت","انبیا در روز قیامت می‌گویند که در آن روز، چاره‌جویی فایده‌ ندارد و فقط در آنجا (محضر خدا) چاره‌ و وسایل نجات واقعی وجود دارد."],[385,"مرغ بی‌هنگامی ای بدبخت رو","ترک ما گو خون ما اندر مشو","ای پرنده بی‌صدا و نابخرد، بدبختی خود را بپذیر و از ما دور شو؛ خون ما را در دل خود ننداز و عذاب نده."],[385,"رو بگرداند به سوی دست چپ","در تبار و خویش گویندش که خپ","در قیامت، وقتی که او (مرغ بی‌هنگام) به سمت دست چپ خود برمی‌گردد، افراد خانواده‌اش به او می‌گویند که بدبخت است."],[385,"هین جواب خویش گو با کردگار","ما کییم ای خواجه دست از ما بدار","به خداوند خود بگویید که ما چه کسانی هستیم و از او بخواهید که از ما دست بردارد و ما را نجات دهد."],[385,"نه ازین سو نه از آن سو چاره شد","جان آن بیچاره‌دل صد پاره شد","نه از این طرف و نه از آن طرف راه نجاتی نیست؛ جان آن شخص بیچاره که دلش شکسته و پاره‌پاره شده، به هیچ وجهی نمی‌تواند چاره‌ای پیدا کند."],[385,"از همه نومید شد مسکین کیا","پس برآرد هر دو دست اندر دعا","کیا، انسان بیچاره و پشیمان، از همه چیز ناامید شده است. او اکنون هر دو دستش را به دعا بلند می‌کند و می‌خواهد از خدا یاری بخواهد."],[385,"کز همه نومید گشتم ای خدا","اول و آخر توی و منتها","ای خدا، من از همه چیز ناامید شدم و تنها به تو، که اول و آخر همه چیز و هدف نهایی هستی، پناه می‌آورم."],[385,"در نماز این خوش اشارتها ببین","تا بدانی کین بخواهد شد یقین","در نماز، این نشانه‌های زیبا را مشاهده کن تا بدانی که آنچه خواسته می‌شود، حتمی و مسلم خواهد شد."],[385,"بچه بیرون آر از بیضه نماز","سر مزن چون مرغ بی تعظیم و ساز","نماز باید با احترام و خضوع برپا شود، نه اینکه مانند جوجه‌ای که از تخم بیرون می‌آید، بدون توجه و بی‌احترامی انجام گیرد."],[386,"آن دقوقی در امامت کرد ساز","اندر آن ساحل در آمد در نماز","دقوقی، که به معنای امام جماعت یا پیشوای نماز است، در آن سواحل به نماز ایستاد و آواز خود را به صدا درآورد."],[386,"و آن جماعت در پی او در قیام","اینت زیبا قوم و بگزیده امام","جماعت مردم به دنبال آن امامت (دقوقی) در حال قیام بودند، و این حرکت زیبا و شاخصی بود برای قومی که او را برگزیده بودند."],[386,"ناگهان چشمش سوی دریا فتاد","چون شنید از سوی دریا داد داد","چشم او ناگهان به سمت دریا افتاد، زیرا صدای فریاد از طرف دریا را شنید."],[386,"در میان موج دید او کشتیی","در قضا و در بلا و زشتیی","در میان امواج دریا، او کشتی‌ای را می‌بیند که در سرنوشت و مشکلات و بدی گرفتار شده است."],[386,"هم شب و هم ابر و هم موج عظیم","این سه تاریکی و از غرقاب بیم","شب، ابر و موج‌های عظیم همگی نشان‌دهنده تاریکی و خطر هستند که انسان را از غرق شدن می‌ترسانند."],[386,"تند بادی همچو عزرائیل خاست","موجها آشوفت اندر چپ و راست","باد تندی مثل عزرائیل (فرشته مرگ) سر برآورد و موج‌ها را به شدت در دو سمت، چپ و راست، به هم ریخت."],[386,"اهل کشتی از مهابت کاسته","نعره وا ویلها برخاسته","اهل کشتی بر اثر ترس و وحشت، از شدت هیجان و اضطراب فریاد می‌زنند «وا ویلا» و از وضعیت خطرناک نجات خود را فریاد می‌کنند."],[386,"دستها در نوحه بر سر می‌زدند","کافر و ملحد همه مخلص شدند","در آن زمان که کشتی در خطر غرق شدن بود، هم کافران و هم الحادیان به نشانه اندوه، دست‌های خود را بر سر می‌زدند و از شدت ترس و ناامیدی، خود را مخلص و به خدا نزدیک می‌کردند."],[386,"با خدا با صد تضرع آن زمان","عهدها و نذرها کرده به‌جان","در آن لحظه، مردم با تمام دل و ناله و زاری به درگاهی الهی روی آورده و عهد و پیمان‌هایی با خدا بسته‌اند."],[386,"سر برهنه در سجود آنها که هیچ","رویشان قبله ندید از پیچ پیچ","در حالتی که برخی افراد، بدون شناخت و توجه به سمت قبله، سر برهنه در حال سجده هستند، نشان‌دهنده نادانی و عدم فهم واقعی از عبادت و نماز است."],[386,"گفته که بی‌فایده‌ست این بندگی","آن زمان دیده در آن صد زندگی","اینجا بیان می‌شود که عبادت و بندگی در زمانی که انسان در دلش توجه و آگاهی از حقایق زندگی ندارد، بی‌فایده و کم‌ثمر است. در واقع، معنای حقیقی بندگی زمانی حاصل می‌شود که انسان به عمق زندگی و وجود خود پی ببرد."],[386,"از همه اومید ببریده تمام","دوستان و خال و عم، بابا و مام","هنگامی که وقت مرگ فرا می‌رسد، همه‌ی امیدها و رابطه‌ها قطع می‌شود و حتی نزدیک‌ترین افراد مانند دوستان، خانواده و والدین دیگر نمی‌توانند کمکی کنند."],[386,"زاهد و فاسق شد آن دم متقی","همچو در هنگام جان کندن شقی","در آن لحظه‌ جان دادن، هم زاهد و هم فاسق در برابر مرگ متقی (پرهیزکار) می‌شوند، زیرا در لحظه آخر زندگی، راحتی و تقوا از بین می‌رود و انسان دچار اضطراب و وحشت می‌شود."],[386,"نه ز چپشان چاره بود و نه ز راست","حیله‌ها چون مرد، هنگام دعاست","در لحظه مرگ، هیچ راه حلی از سمت چپ یا راست برای آن‌ها وجود ندارد و تنها در این زمان دعا و ناله معنا می‌یابد."],[386,"در دعا ایشان و در زاری و آه","بر فلک زیشان شده دود سیاه","در زمان دعا و زاری آن‌ها، دودی سیاه از سمت آسمان برخاست که نشان‌دهنده ناراحتی و غم آن‌هاست."],[386,"دیو آن دم از عداوت بین بین","بانگ زد کای سگ‌پرستان علتین","دیو در آن لحظه از دشمنی فریاد زد و گفت: ای کسانی که مانند سگ به دنبال دنیا هستید، دلیل این وضعیت را بفهمید."],[386,"مرگ و جسک ای اهل انکار و نفاق","عاقبت خواهد بدن این اتفاق","ای کسانی که منکر و دچار نفاق هستید، بدانید که در نهایت، مرگ و پوسیدگی بدن شما سرنوشت حتمی است و به ناچار باید با این واقعیت مواجه شوید."],[386,"چشمتان تر باشد از بعد خلاص","که شوید از بهر شهوت دیو خاص","چشم‌هایتان باید از ترس جدایی و مرگ همیشه اشک‌آلود باشد؛ زیرا با این جدایی، برای رهایی از خواسته‌های شیطانی و نفس اماره آماده می‌شوید."],[386,"یادتان ناید که روزی در خطر","دستتان بگرفت یزدان از قدر","خداوند روزی شما را در خطر نجات داد و دستتان را گرفت تا از آن وضعیت خطرناک خارج شوید؛ آیا این را فراموش کرده‌اید؟"],[386,"این همی‌آمد ندا از دیو لیک","این سخن را نشنود جز گوش نیک","این صدا از دیو می‌آید، ولی فقط گوش‌های خوب و آگاه می‌توانند آن را بشنوند و درک کنند."],[386,"راست فرمودست با ما مصطفی","قطب و شاهنشاه و دریای صفا","پیامبر اسلام، محمد (مصطفی)، به‌درستی با ما سخن گفته است و او را قطب و شاهنشاه و سمبل پاکی و صفا می‌دانیم."],[386,"کانچ جاهل دید خواهد عاقبت","عاقلان بینند ز اول مرتبت","آنچه جاهلان می‌بینند، در نهایت عاقلان خواهند دید، اما آن‌ها این مطالب را از ابتدا و در مرتبه‌ی بالاتر درک می‌کنند."],[386,"کارها ز آغاز اگر غیبست و سر","عاقل اول دید و آخر آن مصر","کارها در ابتدا اگر پوشیده و پنهان است، عاقل در آغاز حقایق را مشاهده می‌کند و در پایان، آن را اثبات خواهد کرد."],[386,"اولش پوشیده باشد و آخر آن","عاقل و جاهل ببیند در عیان","ابتدا کارها پنهان و نامرئی است، اما در نهایت هم عاقل و هم نادان آن را به وضوح خواهند دید."],[386,"گر نبینی واقعه غیب ای عنود","حزم را سیلاب کی اندر ربود","اگر واقعیت‌های پنهان را نبینی، ای شخص لجوج، چطور انتظار داری که احتیاط تو را از آسیب‌های ناگهانی حفظ کند؟"],[386,"حزم چه بود بدگمانی بر جهان","دم بدم بیند بلای ناگهان","حزم یعنی احتیاط و تدبیر. بدگمانی نسبت به دنیا یعنی اینکه همیشه انتظار بدی را داشته باشیم، و این نگرش باعث می‌شود که از بلای ناگهانی که ممکن است پیش بیاید، غافل نباشیم."],[387,"آنچنانک ناگهان شیری رسید","مرد را بربود و در بیشه کشید","ناگهان مانند اینکه شیر به شکار مردی آمده، او را به شدت و به سرعت برد و به جنگل کشاند."],[387,"او چه اندیشد در آن بردن ببین","تو همان اندیش ای استاد دین","مرد حازم که در حال فرار از شیر است، در می‌یابد که استاد دین باید به این موضوع فکر کند که چگونه در زمان خطر و ناامنی به جای اندیشیدن به نجات، باید به مقاصد و تفکرات مهم‌تر بپردازد."],[387,"می‌کشد شیر قضا در بیشه‌ها","جان ما مشغول کار و پیشه‌ها","سرنوشت و تقدیر ما را مانند شیری که در جنگل‌ها شکار می‌کند، به سوی خود می‌کشاند و مشغول ساختن زندگی و کارهای مختلف ماست."],[387,"آنچنانک از فقر می‌ترسند خلق","زیر آب شور رفته تا به حلق","مردم طوری از فقر می‌ترسند که مانند کسی که به زیر آب شور رفته، تا نزدیک گلو در خطر هستند و به شدت احساس خطر می‌کنند."],[387,"گر بترسندی از آن فقرآفرین","گنجهاشان کشف گشتی در زمین","اگر از ایجاد فقر بترسی، باعث می‌شود که گنج‌های آنها در زمین نمایان شود."],[387,"جمله‌شان از خوف غم در عین غم","در پی هستی فتاده در عدم","این جمله بیانگر این است که آن‌ها از ترس و غم خودشان در حال غمگینی و ناامیدی هستند، به‌گونه‌ای که در جستجوی وجود و زندگی از هویت واقعی خود تهی شده‌اند."],[388,"چون دقوقی آن قیامت را بدید","رحم او جوشید و اشک او دوید","دقوقی، وقتی قیامت را دید، احساس رحمتی در او پدید آمد و اشک‌هایش جاری شد."],[388,"گفت یا رب منگر اندر فعلشان","دستشان گیر ای شه نیکو نشان","ای پروردگار، به کارهای آنان نگاه نکن و دستشان را بگیر، ای پادشاه نیکو خصال."],[388,"خوش سلامتشان به ساحل باز بر","ای رسیده دست تو در بحر و بر","خوشا حال آنان که به ساحل امن رسیده‌اند، ای پروردگار، دست تو در دریا و در زمین است."],[388,"ای کریم و ای رحیم سرمدی","در گذار از بدسگالان این بدی","ای خداوند بزرگ و بخشنده‌ای که همیشه و به طور دائمی رحمتت جاری است، از زشتی‌ها و بدی‌های بدسگالان (بدخواهانی که به مردم آسیب می‌زنند) بگذر و آنها را نادیده بگیر."],[388,"ای بداده رایگان صد چشم و گوش","بی ز رشوت بخش کرده عقل و هوش","ای بخشنده‌ای که به صورت رایگان، صدها چشم و گوش به ما داده‌ای و بدون اینکه به چیزی نیاز داشته باشی، عقل و هوش را به ما عطا کرده‌ای."],[388,"پیش از استحقاق بخشیده عطا","دیده از ما جمله کفران و خطا","پیش از آنکه ما شایسته بخشش باشیم، خداوند به ما نعمت‌ها داده و به خاطر تمام کفرها و اشتباهات‌مان چشم‌پوشی کرده است."],[388,"ای عظیم از ما گناهان عظیم","تو توانی عفو کردن در حریم","ای بزرگ و عظیم، ما گناهان بزرگی انجام داده‌ایم، اما تو قدرت این را داری که در آغوش رحمتت ما را ببخشی."],[388,"ما ز آز و حرص خود را سوختیم","وین دعا را هم ز تو آموختیم","ما به خاطر آز و حرص خودمان نابود شدیم، اما این دعا را از تو آموختیم."],[388,"حرمت آن که دعا آموختی","در چنین ظلمت چراغ افروختی","نمی‌توان حرمت کسی که به ما دعا یاد داده را نادیده گرفت؛ زیرا او در این تاریکی مانند چراغی روشنی بخشیده است."],[388,"همچنین می‌رفت بر لفظش دعا","آن زمان چون مادران با وفا","او نیز در آن لحظه دعا را با همان حالتی ادا می‌کرد که مادران مهربان و وفادار برای فرزندانشان دعا می‌کنند."],[388,"اشک می‌رفت از دو چشمش و آن دعا","بی خود از وی می بر آمد بر سما","اشک از چشمانش می‌ریخت و دعا به‌طور ناخودآگاه و از عمق وجودش از او ساطع می‌شد."],[388,"آن دعای بی خودان خود دیگرست","آن دعا زو نیست گفت داورست","دعای کسانی که از خود بی‌خود شده‌اند با دعای دیگران متفاوت است؛ این دعا به ذات خود وابسته نیست و از طرف خداوند است."],[388,"آن دعا حق می‌کند چون او فناست","آن دعا و آن اجابت از خداست","آن دعایی که از سوی بی‌خودان (مخلصان) برمی‌آید، حقیقتا حق و مورد پذیرش خداوند است؛ زیرا این افراد خود را فارغ از خودخواهی و محبت به دنیا می‌دانند و این دعا و همچنین هر اجابتی که از آن ناشی می‌شود، به واسطه خداوند است."],[388,"واسطه مخلوق نه اندر میان","بی‌خبر زان لابه کردن جسم و جان","برای واسطه‌گیری میان خدا و بندگان، مخلوقی وجود ندارد که از درد و لابه‌ی انسان‌ها آگاه باشد، زیرا این تنها خداست که می‌داند چه در دل انسان می‌گذرد."],[388,"بندگان حق رحیم و بردبار","خوی حق دارند در اصلاح کار","بندگان خداوند رحیم و بردبار هستند و وظیفه دارند در کارها به اصلاح و بهبود بپردازند."],[388,"مهربان بی‌رشوتان یاری‌گران","در مقام سخت و در روز گران","افرادی که بدون چشم‌داشت و به‌طور محبت‌آمیز کمک می‌کنند، در اوضاع دشوار و روزهای سخت یاری‌رسان هستند."],[388,"هین بجو این قوم را ای مبتلا","هین غنیمت دارشان پیش از بلا","ای مبتلا به درد و رنج، در جستجوی یاری این مردم باش و پیش از اینکه به مصیبت دچار شوند، از وجودشان بهره ببر."],[388,"رست کشتی از دم آن پهلوان","واهل کشتی را به‌جهد خود گمان","کشتی را از خطر آن پهلوان نجات بده و اهل کشتی فکر کنند که این نجات به دلیل تلاش و کوشش خودشان بوده است."],[388,"که مگر بازوی ایشان در حذر","بر هدف انداخت تیری از هنر","شاید بازوی آن‌ها، با احتیاط و دقت، تیر هنری را به هدف بزند."],[388,"پا رهاند روبهان را در شکار","و آن ز دم دانند روباهان غرار","پا (پای) را برای رهایی و نجات روباهان در هنگام شکار به کار می‌برند و این نجات را از دم آنان به شمار می‌آورند."],[388,"عشقها با دم خود بازند کین","می‌رهاند جان ما را در کمین","عشق‌ها با استفاده از دم خود، ترفندهایی به کار می‌برند که باعث می‌شود ما را در دام خود نگه دارند، زیرا این عشق‌ها جان ما را در معرض خطرات قرار می‌دهند."],[388,"روبها پا را نگه دار از کلوخ","پا چو نبود دم چه سود ای چشم‌شوخ","روباهان پا را از سنگ و کلوخ دور نگه‌دار، چرا که اگر دمی نداشته باشی، دردی نخواهی برد. ای چشم شوخ! این اشاره به این است که برای فرار از مشکلات و دردها، باید مانع از آسیب به خود باشی."],[388,"ما چو روباهان و پای ما کرام","می‌رهاندمان ز صدگون انتقام","ما مانند روباهان هستیم و کسی مانند کرام (گربه‌سان) ما را از عذاب‌ها و انتقام‌های فراوان نجات می‌دهد."],[388,"حیله باریک ما چون دم ماست","عشقها بازیم با دم چپ و راست","حیله و ترفندهای ما مانند دمی است که در تیرگی و روشنی حرکت می‌کند. در عشق و روابط خود، ما با نرمش و زیرکی عمل می‌کنیم و می‌توانیم در دو سمت مختلف بازی کنیم."],[388,"دم بجنبانیم ز استدلال و مکر","تا که حیران ماند از ما زید و بکر","با به دست آوردن سحر و تزویر، به شیوه‌ای پنهانی عمل می‌کنیم تا زید و بکر (دو شخصیت نمادین) از ما گیج و حیران بمانند."],[388,"طالب حیرانی خلقان شدیم","دست طمع اندر الوهیت زدیم","ما به خاطر حیرت و سرگردانی مردم به دنبال جذب آن‌ها هستیم و به طور آشکار به الوهیت (خدا) امیدواریم و به نوعی دست نیاز به سوی او دراز کرده‌ایم."],[388,"تا بافسون مالک دلها شویم","این نمی‌بینیم ما کاندر گویم","تا زمانی که مالکان دل‌ها نشویم، نمی‌توانیم این را ببینیم که در سخن خود چه می‌گوییم."],[388,"در گوی و در چهی ای قلتبان","دست وا دار از سبال دیگران","اگر در جایی مثل میدان یا بازار و در حال خرید و فروش هستی، خودت را درگیر کارهای دیگران نکن و از رقابت با آنها پرهیز کن."],[388,"چون به بستانی رسی زیبا و خوش","بعد از آن دامان خلقان گیر و کش","وقتی به باغی زیبا و خوشبو می‌رسی، بعد از آن دامان و دامن‌کشی مردم را بگیر و آنان را به سوی خود بکش."],[388,"ای مقیم حبس چار و پنج و شش","نغز جایی دیگران را هم بکش","ای کسی که در زندان (دنیا) می‌گذرانید، زمانی بی‌خبر از صحنه‌های زیبای زندگی هستید؛ حالا به روایتی دیگر افراد را هم به سمت این زیبایی‌ها دعوت کن."],[388,"ای چو خربنده حریف کون خر","بوسه گاهی یافتی ما را ببر","ای کسی که مانند خر، زمانی در جهان و بزم زندگی مشکل کشیده‌ای، ما را به سوی خود ببر و به ما محبت کن."],[388,"چون ندادت بندگی دوست دست","میل شاهی از کجاات خاستست","وقتی که تو بندگی و خدمت به دوست را نشان نمی‌دهی، دست و نیّت بزرگ‌منشی و شان شاهی تو از کجا ناشی شده است؟"],[388,"در هوای آنک گویندت زهی","بسته‌ای در گردن جانت زهی","در این بیت به این نکته اشاره می‌شود که اگر در دل خود دعا یا خواسته‌ای به جانب خداوند بکنی، گویی که خود را به مسیر خاصی بسته‌ای که از آن راه خارج نمی‌شوی و از دست خدا فاصله می‌گیری. به عبارتی، باید توجه داشته باشی که در خواستن از خدا باید از وابستگی‌های مادی خود دور شوی."],[388,"روبها این دم حیلت را بهل","وقف کن دل بر خداوندان دل","روباه‌ها اینک به فریب و تدبیر مشغول‌اند، تو برای خداوندان دل، دلت را آماده کن و از این حیله‌ها رها شو."],[388,"در پناه شیر، کم ناید کباب","روبها تو سوی جیفه کم شتاب","اگر در پناه و حمایت شیر باشی، کمتر برای روباه‌ها (که نماد مکر و حیله‌اند) ناراحت کننده است و نیازی به شتاب به سمت چیزهای بی‌ارزش (جیفه) نخواهی داشت."],[388,"تو دلا منظور حق آنگه شوی","که چو جزوی سوی کل خود روی","وقتی دل تو به حقیقت و هدف اصلی‌اش برسد، آن‌گاه می‌توانی به طور کامل به سوی کل و جمع نگری و جزئیات فرعی را رها کنی."],[388,"حق همی‌گوید نظرمان در دلست","نیست بر صورت که آن آب و گلست","خداوند می‌گوید که توجه و نگاه ما به دل‌هاست، نه به ظاهر و شکل ظاهری که از خاک و آب تشکیل شده است."],[388,"تو همی‌گویی مرا دل نیز هست","دل فراز عرش باشد نی به پست","تو می‌گویی که من دل هم دارم، اما آن دل باید شایسته باشد و در مقام بالایی مانند عرش قرار گیرد، نه در جاهای پایین و ناپسند."],[388,"در گل تیره یقین هم آب هست","لیک زان آبت نشاید آب‌دست","در دل تاریکی و گل، واقعا آب وجود دارد، اما نمی‌شود به آن آبی که در دست است، اعتماد کرد یا به آن دل خوش کرد."],[388,"زان که گر آبست مغلوب گلست","پس دل خود را مگو کین هم دلست","اگرچه دل انسان مانند آب است و می‌تواند زنده و شاداب باشد، اما وقتی در معرض غفلت و زشتی (گل) قرار می‌گیرد، تحت تأثیر منفی آن قرار می‌گیرد. بنابراین نباید به خود بگوییم که دل ما خوب است در حالی که در جذب این زشتی‌ها غوطه‌ور هستیم."],[388,"آن دلی کز آسمانها برترست","آن دل ابدال یا پیغامبرست","دلی که به مراتب بالاتر از آسمان‌هاست، همان دل ابدال (افرادی که در معنویت به مقام‌های عالی رسیده‌اند) یا دل پیغامبر (پیام رسان وحی و الهام) است."],[388,"پاک گشته آن ز گل صافی شده","در فزونی آمده وافی شده","دل پاک شده از غبار گناه، به صفا و purity رسیده و در کمال و فراوانی افزایش یافته است."],[388,"ترک گل کرده سوی بحر آمده","رسته از زندان گل بحری شده","کسی که از خاک و گل دست کشیده و به دریا آمده، از قید و بند خاک آزاد شده و به حیات و زندگی دریایی پیوسته است."],[388,"آب ما محبوس گل ماندست هین","بحر رحمت جذب کن ما را ز طین","آب ما در گل محصور شده است. ای دریاى رحمت، ما را از این گل جذب کن."],[388,"بحر گوید من تورا در خود کشم","لیک می‌لافی که من آب خوشم","در این بیت، دریا (بحر) می‌گوید که من تو را در خود جای می‌دهم، اما تو از روی خودبینی و ادعا می‌گویی که من آب شیرینی هستم. این تضاد میان دعوت متن و خود بزرگ‌بینی گوینده را نشان می‌دهد."],[388,"لاف تو محروم می‌دارد تورا","ترک آن پنداشت کن در من درآ","برخی از افراد به خود می‌بالند و از خود تصنعی می‌سازند، اما این خودستایی مانع از آن می‌شود که به حقیقت و عمق وجودشان دست یابند؛ بنابراین باید از این خودبزرگ‌بینی دست بکشند و به درون خود راه یابند."],[388,"آب گل خواهد که در دریا رود","گل گرفته پای آب و می‌کشد","اگر گلی بخواهد به دریا برود، باید از میان آب بگذرد، اما گل پاهایش را گرفته و او را عقب می‌کشد."],[388,"گر رهاند پای خود از دست گل","گل بماند خشک و او شد مستقل","اگر پای انسان از گل رها شود، گل به حال خود خشک می‌ماند و دیگر تحت تأثیر او نخواهد بود و مستقل می‌شود."],[388,"آن کشیدن چیست از گل آب را","جذب تو نقل و شراب ناب را","عمل کشیدن آب از گل (آبکشیدن) به معنای جذب کردن و استقبال از چیزهای خوب و خالص مثل شراب ناب است. در اینجا به انتقال و کسب نعمت‌ها و لذت‌های خاص اشاره دارد."],[388,"همچنین هر شهوتی اندر جهان","خواه مال و خواه جاه و خواه نان","تمام شهوت‌ها و خواسته‌های انسان در دنیا وجود دارد، چه این خواسته‌ها مالی باشد، چه مقام و رتبه اجتماعی، یا حتی نان و خوراک."],[388,"هر یکی زینها تورا مستی کند","چون نیابی آن خمارت می‌زند","هر یک از این خواهش‌ها و هوس‌ها تو را مست و غرق شوق می‌کند، اما زمانی که آنچه را می‌خواهی پیدا نکردی، حال خوش و نشاطت از بین می‌رود."],[388,"این خمار غم دلیل آن شدست","که بدان مفقود، مستی‌ات بدست","غم و اندوهی که بر تو غلبه کرده، دلیلی است که تو را از آن حالت مستی و سرخوشی دور کرده است."],[388,"جز به اندازه ضرورت زین مگیر","تا نگردد غالب و بر تو امیر","به جز به اندازه لازم و ضروری از این حال و احساس غم و مستی نگیر، که مبادا این احساس بر تو غلبه کند و بر تو تسلط یابد."],[388,"سر کشیدی تو که من صاحب‌دلم","حاجت غیری ندارم واصلم","تو به مقام بلندی رسیده‌ای و چون شخصی دنبال کسی نیستم که از او چیزی بخواهم، بلکه فقط به تو وابسته‌ام و به جز تو خواسته‌ای ندارم."],[388,"آنچنانک آب در گل سر کشد","که منم آب و چرا جویم مدد","من مانند آبی هستم که در گل سر می‌کشد، پس چرا باید کمک دیگری را بجویم؟ این بیان نشان‌دهنده خودکفا بودن و وابسته نبودن به دیگران است."],[388,"دل تو این آلوده را پنداشتی","لاجرم دل ز اهل دل برداشتی","تو دل خود را به چیزهای آلوده و ناپاک نسبت داده‌ای، بنابراین از دل‌های واقعی و اهل دل فاصله گرفته‌ای."],[388,"خود روا داری که آن دل باشد این","کو بود در عشق شیر و انگبین","تو این‌جا به خود اجازه می‌دهی که دل‌ت را همان‌گونه که هست، در نظر بگیری، در حالی که آن دل، متعلق به کسی است که در عشق محبت و شیرینی را درکی کرده است."],[388,"لطف شیر و انگبین عکس دلست","هر خوشی را آن خوش از دل حاصلست","لطف و نیکی شیر و انگبین نشان‌دهنده حالت خوب دل است و هر شادی‌ای که وجود دارد، از دل نشأت می‌گیرد."],[388,"پس بود دل جوهر و عالم عرض","سایه دل چون بود دل را غرض؟","از این بیت برداشت می‌شود که دل، خود جوهری باارزش است و عالم، چیزی موقتی و چون سایه‌ای دور از واقعیت است. اما اینجا سوال مطرح می‌شود که هدف دل چه می‌تواند باشد، در حالی که عالم فقط یک تصویر یا سایه از دل است."],[388,"آن دلی کو عاشق مالست و جاه","یا زبون این گل و آب سیاه","دل که فقط عاشق مال و مقام است، در واقع مایه خفت و ذلتش همین گل و آب سیاه (دنیا) است."],[388,"یا خیالاتی که در ظلمات او","می‌پرستدشان برای گفت و گو","انسان‌هایی که در تاریکی‌های وجود خود، به خیال‌ها و اوهام خود وابسته‌اند و آنها را worship می‌کنند، در واقع در حال گفت‌وگو با این خیالات‌ هستند."],[388,"دل نباشد غیر آن دریای نور","دل نظرگاه خدا وانگاه کور","دل انسان جز دریای نور نیست و آن، محل توجه خداست و وقتی انسان از این حقیقت غافل باشد، همچون فردی کور است که نمی‌بیند."],[388,"نه دل اندر صد هزاران خاص و عام","در یکی باشد کدامست آن کدام","دل در میان انبوهی از مردم و ویژگی‌ها، یکی است. حالا باید بپرسیم آن یکدل چیست و کدام یک از دل‌هاست."],[388,"ریزه دل را بهل دل را بجو","تا شود آن ریزه چون کوهی ازو","دل را ریزه و کوچک (ناباقی) می‌دان، اما به‌دنبال دل بروید تا آن ریزه نیز به بزرگی کوه تبدیل شود."],[388,"دل محیطست اندرین خطه وجود","زر همی‌افشاند از احسان و جود","دل در این جهان وجود، فراگیر است و از رحمت و نیکی خدای متعال، مانند طلا که گرانبهاست، پخش می‌کند."],[388,"از سلام حق سلامیها نثار","می‌کند بر اهل عالم اختیار","خداوند از برکت سلام خود، سلام‌هایی به اهل عالم می‌دهد که بر اساس اراده و اختیار آنهاست."],[388,"هر که را دامن درستست و معد","آن نثار دل بر آنکس می‌رسد","هر کس که دامنش پاک و درست باشد، دل الهی بر او نثار می‌شود و محبت و رحمت به او می‌رسد."],[388,"دامن تو آن نیازست و حضور","هین منه در دامن آن سنگ فجور","وجود تو همانند دامن است که نیازهای انسان را در بر می‌گیرد؛ بنابراین، در دامن (حضور) آن سنگ درشت و ناپسند نرو، چرا که این چیزها باعث آزار و ضرر خواهد شد."],[388,"تا ندرد دامنت زان سنگها","تا بدانی نقد را از رنگها","هرگاه دامنت از آن سنگ‌ها آسیبی نبیند، می‌توانی تفاوت واقعیات را از ظواهر تشخیص دهی."],[388,"سنگ پر کردی تو دامن از جهان","هم ز سنگ سیم و زر چون کودکان","تو دامن خود را از مشغله‌های دنیوی پر کرده‌ای، مانند کودکان که از سنگ و زیورآلات بازی می‌کنند، در حالی که ارزش واقعی آن‌ها را درک نمی‌کنند."],[388,"از خیال سیم و زر چون زر نبود","دامن صدقت درید و غم فزود","هیچ‌گاه خیال طلا و نقره به حقیقت نمی‌رسد؛ تو تنها به خاطر این آرزو، جیب صداقت خود را پاره کردی و بر غم‌های خود افزودی."],[388,"کی نماید کودکان را سنگ، سنگ","تا نگیرد عقل دامنشان به چنگ","هیچ کس نمی‌تواند کودکان را با سنگ بزند، چرا که این کار باعث می‌شود عقل آنها به دام بیفتد و از حرکت باز بمانند."],[388,"پیر، عقل آمد نه آن موی سپید","مو نمی‌گنجد درین بخت و امید","عقل (در فهم و دانایی) به سن و سال و موی سپید مربوط نیست؛ بلکه باید با بهره‌گیری از آن به استقبال بخت و امید رفت."],[389,"چون رهید آن کشتی و آمد به‌کام","شد نماز آن جماعت هم تمام","زمانی که آن کشتی رهایی یافت و به مقصد رسید، دعا و نماز آن گروه نیز به پایان رسید."],[389,"فجفجی افتادشان با همدگر","کین فضولی کیست از ما ای پدر","آن جماعت ناگهان به هم ریختند و به یکدیگر گفتند که این فضولی و دخالت از جانب کدام یک از ماست، ای پدر!"],[389,"هر یکی با آن دگر گفتند سر","از پس پشت دقوقی مستتر","هر یک از آنها به دیگری گفتند که راز را در پنهان از پشت دقوقی بیان می‌کنند."],[389,"گفت هر یک من نکردستم کنون","این دعا نه از برون نه از درون","هر یک از آن جماعت گفتند که من خود در حال دعا نیستم و این دعا از ذهن و قلب من نمی‌خواهد، بلکه به نوعی به‌صورت بیرونی و غیرواقعی است."],[389,"گفت مانا این امام ما ز درد","بوالفضولانه مناجاتی بکرد","امام ما برای دردهای بی‌منطق و گزاف خود، مناجات و دعاهایی کرده است."],[389,"گفت آن دیگر که ای یار یقین","مر مرا هم می‌نماید این چنین","دوست مطمئن من گفت: ای رفیق، من هم این صحنه را به همین شکل می‌بینم و درک می‌کنم."],[389,"او فضولی بوده است از انقباض","کرد بر مختار مطلق اعتراض","این فرد به خاطر دلسردی و انقباضی که دارد، به خداوندی که مختار و آزاد است، اعتراض کرده و فضولی کرده است."],[389,"چون نگه کردم سپس تا بنگرم","که چه می‌گویند آن اهل کرم","وقتی که نگاه کردم تا ببینم آن افراد بافضیلت چه می‌گویند، متوجه شدم که در چه وضعیتی هستند."],[389,"یک ازیشان را ندیدم در مقام","رفته بودند از مقام خود تمام","هیچ‌یک از آن‌ها را در جایگاه خود ندیدم، زیرا همه‌ آن‌ها از محل خود ناپدید شده بودند."],[389,"نه به چپ نه راست نه بالا نه زیر","چشم تیز من نشد بر قوم چیر","چشم تیز مولانا بر این جمع دقت نمی‌کند و نمی‌تواند آنها را در هیچ جهتی ببیند؛ نه در سمت چپ، نه راست، نه بالا و نه پایین. به عبارتی، آنها به گونه‌ای ناپدید شده‌اند که او قادر به مشاهده آنها نیست."],[389,"درها بودند گویی آب گشت","نه نشان پا و نه گردی به‌دشت","گویی آن‌ها مانند درهایی باارزش بودند که به آب تبدیل شدند و دیگر هیچ نشانه‌ای از پا یا خاکی در دشت به جا نگذاشتند."],[389,"در قباب حق شدند آن دم همه","در کدامین روضه رفتند آن رمه","در آن لحظه که به حقیقت و لطف الهی دست یافتند، آن گروه در چه فضایی یا باغی ناپدید شدند و به کجا رفتند."],[389,"در تحیر ماندم کین قوم را","چون بپوشانید حق بر چشم ما","در شگفتی هستم که چگونه حق بر چشمان ما این قوم را پنهان کرده است."],[389,"آنچنان پنهان شدند از چشم او","مثل غوطه ماهیان در آب جو","آن‌ها به قدری از دید او پنهان شدند که مانند ماهیانی هستند که در آب زنده‌اند و دیده نمی‌شوند."],[389,"سالها درحسرت ایشان بماند","عمرها در شوق ایشان اشک راند","سال‌ها عمرش در آرزوی دیدن آن جماعت که در پرده غیبت پنهان شده‌اند، سپری می‌شود و عمرش در انتظار آن‌ها به شوق و اشک می‌گذرد."],[389,"تو بگویی مرد حق اندر نظر","کی در آرد با خدا ذکر بشر","تو بگویی مرد حق، یعنی انسان حقیقی و خداشناس، چگونه در نظر خداوند یاد انسان‌ها را به میان می‌آورد؟"],[389,"خر ازین می‌خسپد اینجا ای فلان","که بشر دیدی تو ایشان را نه جان","دقوقی به کسی اشاره دارد که به موجودات خاصی که در عالم غیب وجود دارند، اعتقاد دارد. این بیت بیان می‌کند که تو به اشتباه فکر می‌کنی که انسان‌های عادی یا ظاهری می‌توانند به عمق حقیقت دست یابند، در حالی که چنین موجوداتی از دید بشر پنهان هستند و فقط از دقت و آگاهی عمیق می‌توان به آنها دست یافت."],[389,"کار ازین ویران شدست ای مرد خام","که بشر دیدی مر ایشان را چو عام","ای مرد نادان، کار این جانورها خراب شده است، زیرا تو تنها به ظاهر آنان نگاه کردی و این موجودات را مانند انسان‌های عادی تصور کردی."],[389,"تو همان دیدی که ابلیس لعین","گفت من از آتشم آدم ز طین","تو همان چیزی را دیده‌ای که ابلیس لعین گفت: «من از آتش آفریده شده‌ام و آدم از خاک.» این نشان می‌دهد که ابلیس برتری خود را بر آدم بیان کرده است."],[389,"چشم ابلیسانه را یک دم ببند","چند بینی صورت آخر چند چند","چشم‌های شبیه ابلیس را به مدت کوتاهی ببند تا ببینی در پایان کار چقدر حقیقت و واقعیت در پی آن است."],[389,"ای دقوقی با دو چشم همچو جو","هین مبر اومید ایشان را بجو","ای دقوقی، تو که با دو چشم مانند جو (سرسبز و شفاف) هستی، نگذار امید آن افراد را قطع کنی و به دنبال آن‌ها برو."],[389,"هین بجو که رکن دولت جستن است","هر گشادی در دل اندر بستن است","به‌هوش باش که کسب پایه‌های قدرت و حکومت دشوار است و هرگونه تساهل و سستی در دل، سختی‌هایی به‌دنبال خواهد داشت."],[389,"از همه کار جهان پرداخته","کو و کو می‌گو به‌جان چون فاخته","از هر کاری در جهان دست بردار و مانند فاخته، به دنبال جان خود بگرد. فاخته، پرنده‌ای است که به دنبال عشق و عشق‌ورزی می‌گردد."],[389,"نیک بنگر اندرین ای محتجب","که دعا را بست حق در استجب","ای کسی که خود را از حق پوشانده‌ای، خوب توجه کن که خداوند دعا را در «استجابت» (پاسخ دادن) بسته است."],[389,"هر که را دل پاک شد از اعتلال","آن دعااش می‌رود تا ذوالجلال","هر کسی که دلش از آلودگی‌ها و ناپاکی‌ها پاک شود، دعایش به سوی خداوندی می‌رود که صاحب جلال و بزرگی است."],[390,"یادم آمد آن حکایت کان فقیر","روز و شب می‌کرد افغان و نفیر","یاد من آمد آن داستان درباره فقیری که روز و شب در حال ناله و گریه بود."],[390,"وز خدا می‌خواست روزی حلال","بی شکار و رنج و کسب و انتقال","او از خدا خواسته بود که روزی حلال به او بدهد، بدون اینکه نیازی به شکار، زحمت یا تلاش برای کسب درآمد داشته باشد."],[390,"پیش ازین گفتیم بعضی حال او","لیک تعویق آمد و شد پنج‌تو","پیش از این درباره برخی از وضعیت او (طالب روزی حلال) صحبت کردیم، اما به دلیل وقفه‌ای، تغییر وضعیت او مشخص نشد."],[390,"هم بگوییمش کجا خواهد گریخت","چون ز ابر فضل حق حکمت بریخت","ما هم به او خواهیم گفت که کجا خواهد رفت و پنهان خواهد شد وقتی که باران رحمت و فضل خدا بر او نازل شود و حکمت را به او عطا کند."],[390,"صاحب گاوش بدید و گفت هین","ای به‌ظلمت گاو من گشته رهین","صاحب گاوش گاوی را که در ظلمت در مسیر گم شده دیده، می‌گوید: \"ای کسی که در ظلمتی، گاو من گرفتار شده، چرا این‌گونه رفتار می‌کنی؟"],[390,"هین چرا کشتی بگو گاو مرا","ابله طرار انصاف اندر آ","چرا گاو من را کشتی؟ بگو، ای ابله، انصاف را در نظر بگیر و ببین که کار درست چیست."],[390,"گفت من روزی ز حق می‌خواستم","قبله را از لابه می‌آراستم","او می‌گوید که من از خداوند روزی حلال می‌خواستم و در این راستا با خلوص نیت و تلاش دعا می‌کردم و از دل به سمت قبله (جهت نماز) می‌رفتم."],[390,"آن دعای کهنه‌ام شد مستجاب","روزی من بود کشتم نک جواب","دعای قبلی‌ام – که از خدا خواسته بودم – برآورده شد و روزی من که به دنبال آن بودم، به دست آمد. من می‌دانم که در حق‌جویی‌ام، از هیچ کاری دریغ نکردم و در نهایت دعا و خواسته‌ام برآورده شد."],[390,"او ز خشم آمد گریبانش گرفت","چند مشتی زد به رویش ناشکفت","داود، از شدت خشم، گریبان او را گرفت و چند مشت به صورتش زد، در حالی که هنوز در دلش نشانه‌ای از فروتنی و نرمی وجود نداشت."],[391,"می‌کشیدش تا به داود نبی","که بیا ای ظالم گیج غبی","آن‌ها (خصم‌ها) او را (دغا) می‌کشانیدند تا به داود نبی، و او را خطاب می‌کردند که ای ظالم، گیج و سرگشته بی‌منطق!"],[391,"حجت بارد رها کن ای دغا","عقل در تن آور و با خویش آ","حجت را رها کن و خود را به عقل بسپار، با خودت به تفکر و اندیشه پرداز."],[391,"این چه می‌گویی دعا چه بود مخند","بر سر و و ریش من و خویش ای لوند","منظور این است که فردی که صحبت می‌کند به طرف مقابل می‌گوید: این چه سخنی است که درباره دعا می‌گویی؟ بر خودت و بر من که با هم دوست هستیم، نخند و با این لحن فریبنده صحبت نکن."],[391,"گفت من با حق دعاها کرده‌ام","اندرین لابه بسی خون خورده‌ام","او می‌گوید که من دعای زیادی به درگاه حق کرده‌ام و در این ناله و زاری، سخت اشک ریخته‌ام."],[391,"من یقین دارم دعا شد مستجاب","سر بزن بر سنگ ای منکرخطاب","من مطمئن هستم که دعاهایم مستجاب شده است، پس ای منکر، بر سنگی که همواره بر آن می‌زنی، سر بزن و به حقیقت توجه کن."],[391,"گفت گرد آیید هین یا مسلمین","ژاژ بینید و فشار این مهین","این بیت به جمع شدن مسلمانان و جمع کردن افکارشان دعوت می‌کند تا به یکدیگر توجه کنند و همزمان از زشتی‌ها و ناپسندها، که در اینجا به \"ژاژ\" اشاره شده، پرهیز کنند. اشاره به \"فشار این مهین\" به معنای تحمل و فشارهایی است که از سوی بدی‌ها متحمل می‌شوند."],[391,"ای مسلمانان، دعا مال مرا","چون از آن او کند بهر خدا","ای مسلمانان، دعا باعث می‌شود که مال و ثروت من به خاطر خداوند به آن شخص دیگر برسد."],[391,"گر چنین بودی همه عالم بدین","یک دعا املاک بردندی بکین","اگر واقعا دعا چنین تأثیری داشت، همه کسانی که در دنیا هستند با یک دعا می‌توانستند املاک و دارایی‌های دیگران را به‌نفع خود تصاحب کنند."],[391,"گر چنین بودی گدایان ضریر","محتشم گشته بدندی و امیر","اگر چنین دعاهایی مؤثر بود، فقیرانی که نابینا هستند، محترم و با مقام می‌شدند و فرمانروایان در برابر آنها قرار می‌گرفتند."],[391,"روز و شب اندر دعااند و ثنا","لابه‌گویان که تو ده‌مان ای خدا","روز و شب، لابه‌گویان نماز می‌خوانند و تو را می‌ستایند، و از تو درخواست می‌کنند که ای خدا، ما را روزی ده."],[391,"تا تو ندهی هیچ کس ندهد یقین","ای گشاینده تو بگشا بند این","تا زمانی که تو ندهی، هیچ‌کس چیزی نمی‌دهد، ای بخشنده بزرگ، گره این مشکل را باز کن."],[391,"مکسب کوران بود لابه و دعا","جز لب نانی نیابند از عطا","مردم نابینا (کوران) تنها با زاری و دعا کردن چیزی به دست نمی‌آورند و از لطف دیگران جز لقمه‌ای نان نصیبشان نخواهد شد."],[391,"خلق گفتند این مسلمان راست‌گوست","وین فروشنده دعاها ظلم‌جوست","خلق می‌گویند که این فرد مسلمان راست‌گو و درستکار است، اما این فروشنده دعاها (که ظاهرا به انسان‌های ناتوان و نیازمند ظلم می‌کند) فردی ظلم‌جو و فاسد است."],[391,"این دعا کی باشد از اسباب ملک","کی کشید این را شریعت خود بسلک","این دعا چه ارتباطی با مالکیت دارد و بر اساس کدام قوانین شرعی اثری در این زمینه دارد؟"],[391,"بیع و بخشش یا وصیت یا عطا","یا ز جنس این شود ملکی تورا","هر نوع معامله، بخشش، وصیت یا عطا که انجام می‌دهی، همه این‌ها از جمله اموری هستند که به تو تعلق می‌گیرد و بر اساس شریعت معین می‌شوند."],[391,"در کدامین دفترست این شرع نو","گاو را تو باز ده یا حبس رو","در کدامین قانون و مقررات جدید، اجازه‌ی بازپس‌دادن گاو به صاحبش نیست یا باید آن را نگه‌داشت؟"],[391,"او به سوی آسمان می‌کرد رو","واقعه ما را نداند غیر تو","او به سمت آسمان روی می‌آورد و جز تو هیچ‌کس از اتفاقی که برای ما افتاده، خبر ندارد."],[391,"در دل من آن دعا انداختی","صد امید اندر دلم افراختی","تو در دل من دعای خوبی انداختی و امیدهای زیادی در دلم به وجود آوردی."],[391,"من نمی‌کردم گزافه آن دعا","همچو یوسف دیده بودم خوابها","من به خاطر آن دعا سخنی بیهوده نمی‌گفتم، زیرا مثل یوسف، خواب‌های مهم و بزرگی دیده بودم."],[391,"دید یوسف آفتاب و اختران","پیش او سجده‌کنان چون چاکران","یوسف در خواب دید که خورشید و ستاره‌ها در برابر او به احترام به سجده افتاده‌اند، مانند چاکران (خدمتکاران) که در برابر بزرگان سجده می‌کنند."],[391,"اعتمادش بود بر خواب درست","در چه و زندان جز آن را می‌نجست","یوسف به خواب صحیح خود اعتماد داشت و جز آن، از هیچ چیز در زندان نمی‌هراسید."],[391,"ز اعتماد او نبودش هیچ غم","از غلامی وز ملام و بیش و کم","او به خاطر اعتمادی که به خواب خودش داشت، هیچ نگرانی از بردگی و عیب‌جویی و نواقص دیگر احساس نمی‌کرد."],[391,"اعتمادی داشت او بر خواب خویش","که چو شمعی می‌فروزیدش ز پیش","او به خواب خود اعتماد داشت و این خواب انگار او را مانند شمعی روشن می‌کرد و نور امید و روشنی را برایش به ارمغان می‌آورد."],[391,"چون در افکندند یوسف را به چاه","بانگ آمد سمع او را از اله","وقتی که یوسف را در چاه انداختند، صدای او به گوش خدا رسید."],[391,"که تو روزی شه شوی ای پهلوان","تا بمالی این جفا در رویشان","ای پهلوان، تو روزی به مقام پادشاهی خواهی رسید و آن زمان می‌توانی بر این ظلم و ستمی که بر تو رفته است، انتقام بگیری."],[391,"قایل این بانگ ناید در نظر","لیک دل بشناخت قایل را ز اثر","این صدا (که به حقیقت اشاره دارد) با چشم دیده نمی‌شود، اما دل انسان می‌تواند شخص قائل به این صدا را از نشانه‌هایش بشناسد."],[391,"قوّتی و راحتی و مسندی","در میان جان فتادش زان ندا","ندایی که بر دل او طنین‌انداز شد، نیرویی و آرامشی به او بخشید و پناهگاهی برای جانش فراهم کرد."],[391,"چاه شد بر وی بدان بانگ جلیل","گلشن و بزمی چو آتش بر خلیل","چاه، به‌دلیل صدای بلند و مهم آن در گلستان و جشنی مانند آتش، بر او (داود) افتاد. یعنی قهری و سنگینی بر او وارد آمد که مانند آتش بر ابراهیم (خلیل) بود."],[391,"هر جفا که بعد از آنش می‌رسید","او بدان قوت به‌شادی می‌کشید","هر اذیتی که پس از آن به او می‌رسید، او به لطف و قدرت آن بانگ (خود) را با شادمانی تحمل می‌کرد."],[391,"همچنانک ذوق آن بانگ الست","در دل هر مؤمنی تا حشر هست","ذوق و شادمانی ناشی از شنیدن صدای «الست» (آیا من پروردگار شما نیستم؟) در دل هر مؤمنی تا روز قیامت باقی خواهد ماند."],[391,"تا نباشد در بلاشان اعتراض","نه ز امر و نهی حقشان انقباض","تا زمانی که در بلا و سختی‌هایشان اعتراضی نباشد، نه از فرامین و دستورات الهی آنها چیزی کم می‌شود و نه در محدوده و قدرت‌شان اختلالی ایجاد می‌گردد."],[391,"لقمه حکمی که تلخی می‌نهد","گلشکر آن را گوارش می‌دهد","حکم یا آموزه‌ای که باعث تلخی می‌شود، برای کسی که از آن آگاه است و در دلش شیرینی فهم آن وجود دارد، قابل تحمل و خوشایند می‌گردد."],[391,"گلشکر آن را که نبود مستند","لقمه را ز انکار او قی می‌کند","اگر کسی از حکمت و حقیقت بهره‌مند نباشد، نمی‌تواند طعم واقعی آن را بچشد و در برابر آن بی‌اعتنا می‌شود."],[391,"هر که خوابی دید از روز الست","مست باشد در ره طاعات مست","کسی که در روز الست، که روز میثاق روحانی است، خواب خوشی دیده، در راه اطاعت و بندگی خداوند شگفت‌زده و سرمست خواهد بود و از این طریق، عشق و شوق به عبادت را خواهد یافت."],[391,"می‌کشد چون اشتر مست این جوال","بی فتور و بی گمان و بی ملال","این شخص مانند یک شتر مست، بی‌هیچ تردید و آسودگی، این بار را حمل می‌کند و هیچ کسنگینی بر دوشش نیست."],[391,"کفک تصدیقش به‌گرد پوز او","شد گواه مستی و دلسوز او","عطر و بوی خوش او به گرد دهانش گواهی بر شوق و عشق اوست و همچنین نشانه‌ای از حال مستی او به شمار می‌آید."],[391,"اشتر از قوت چو شیر نر شده","زیر ثقل بار اندک‌خور شده","مادیانی که مانند شیر نر قوی شده‌اند، به‌واسطه سنگینی بار، به خاطر کم‌خوری ضعیف شده‌اند."],[391,"ز آرزوی ناقه صد فاقه برو","می‌نماید کوه پیشش تار مو","از آرزوی شتر، کمرش به شدت تحت فشار قرار گرفته و مانند کوه ناپیدا و بزرگ، جلوه می‌کند."],[391,"در الست آنکو چنین خوابی ندید","اندرین دنیا نشد بنده و مرید","در عالم «الست» (عالم عهد و پیمان) کسی که این‌گونه خواب ندیده باشد، در این دنیا بندگی و فرمان‌برداری نمی‌شود."],[391,"ور بشد اندر تردد صد دله","یک زمان شکرستش و سالی گله","اگر کسی در تردید و بلاتکلیفی صد بار به دل خود فکر کند، در یک زمان، شکر خدا بر او واجب است و سال‌ها گله و شکایت از تقدیر نمی‌تواند داشته باشد."],[391,"پای پیش و پای پس در راه دین","می‌نهد با صد تردد بی یقین","انسان در مسیر دین با تردید و احتیاط حرکت می‌کند و هر قدمی که برمی‌دارد، ممکن است همراه با عدم اطمینان باشد."],[391,"وام‌دار شرح اینم نک گرو","ور شتابستت ز الم نشرح شنو","من به توضیح این مفهوم نیاز دارم و نمی‌توانم به طور مستقیم به آن بپردازم. اما به طور کلی می‌توان گفت که گوینده در پی آن است که از برداشت و توضیحی کلی از امور خودداری کند و بر اهمیت شناخت و فهم عمیق تأکید دارد، و اگر شتاب‌زده برخیزد، باید به این مسأله توجه کند."],[391,"چون ندارد شرح این معنی کران","خر به سوی مدعی گاو ران","چون این معنی را نمی‌توان به وضوح بیان کرد، مانند خر نادانی که به سوی مدعی‌ای که گاو را می‌راند، می‌خزد."],[391,"گفت کورم خواند زین جرم آن دغا","بس بلیسانه قیاسست ای خدا","شخصی می‌گوید که در برابر این ظلم و فریب، از درماندگی خود شکایت می‌کند و به خدا شکایت می‌آورد که این وضعیت مثالی از فریب و نیرنگ است."],[391,"من دعا کورانه کی می‌کرده‌ام","جز به خالق کدیه کی آورده‌ام","من هیچ‌گاه دعا نمی‌کردم که کورانه و بی‌مفهم، جز برای خالق خود؛ و هیچ‌گاه چیزی از نادانی و جهالت من به درگاه او نبرده‌ام."],[391,"کور از خلقان طمع دارد ز جهل","من ز تو، کز تست هر دشوار سهل","آدم کور، به خاطر جهلش از خلق، به امید آنها امید دارد، در حالی که من از تو امید دارم؛ زیرا تو هر چیز دشوار را به آسانی می‌سازی."],[391,"آن یکی کورم ز کوران بشمرید","او نیاز جان و اخلاصم ندید","من عاشق کور هستم و به نوعی از کور بودن دیگران رنج می‌برم. او به نیاز من و اخلاص قلبی‌ام توجهی ندارد."],[391,"کوری عشقست این کوری من","حب یعمی و یصمست ای حسن","کوری که به عشق نسبت داده شده، واقعا کوری است که من از آن رنج می‌برم؛ عشق، محبتی است که انسان را نابینا و ناشنوا می‌کند، ای زیبا."],[391,"کورم از غیر خدا بینا بدو","مقتضای عشق این باشد نکو","من از غیر خدا کور هستم، اما به او بینا هستم. این وضعیت، نشانه‌ای خوب از عشق واقعی است."],[391,"تو که بینایی ز کورانم مدار","دایرم برگرد لطفت ای مدار","تو که بینا هستی، مرا از کوری و نابینایی دور نکن، و لطف و محبتت را به من بازگردان."],[391,"آنچنانک یوسف صدیق را","خواب بنمودی و گشتش متکا","تو نیز همان‌طور که به یوسف صدیق خواب‌های راستین نشان دادی و او را آرامش بخشیدی، به من نیز لطف کن و آرامش بده."],[391,"مر مرا لطف تو هم خوابی نمود","آن دعای بی‌حدم بازی نبود","خداوند مهربانی تو خواب خوشی به من داد، و دعای بی‌پایان من بی‌نتیجه نبود."],[391,"می‌نداند خلق اسرار مرا","ژاژ می‌دانند گفتار مرا","مردم اسرار و رموز درونی من را نمی‌دانند و تنها به گفتار من که بیهوده و بی‌ارزش است، توجه می‌کنند."],[391,"حقشان است و کی داند راز غیب","غیر علّام سر و ستار عیب","حقوق آن‌ها (خصم‌ها) بر حق است، ولی چه کسی می‌تواند رازهای غیب و عیوب نهان را بداند جز کسی که آگاه است و آنچه پنهان است را می‌پوشاند؟"],[391,"خصم گفتش رو به من کن حق بگو","رو چه سوی آسمان کردی عمو","خصم به داود علیه السلام گفت: به من رو کن و حقایق را بگو، اینکه تو چه جهتی از آسمان را گرفته‌ای، عمو (یعنی ای پسرعمو یا ای خویشاوند)."],[391,"شید می‌آری غلط می‌افکنی","لاف عشق و لاف قربت می‌زنی","تو به جای اینکه حقیقت عشق را بیان کنی، تنها به سخنانی بی‌اساس و نادرست درباره عشق و نزدیکی به خداوند می‌پردازی و صرفا ادعا می‌کنی."],[391,"با کدامین روی چون دل‌مرده‌ای","روی سوی آسمانها کرده‌ای","چگونه ممکن است که تو، با چهره‌ای چون دل‌مرده‌ها، رو به آسمان کرده‌ای؟"],[391,"غلغلی در شهر افتاده ازین","آن مسلمان می‌نهد رو بر زمین","در شهر غوغایی به پا شده و مسلمان (مؤمن) به خاطر این وضعیت، سرش را به زیر انداخته و خجالت‌زده است."],[391,"کای خدا این بنده را رسوا مکن","گر بدم هم سر من پیدا مکن","خداوندا، من را رسوا نکن و حتی اگر بدی‌هایی دارم، آن‌ها را به‌صورت علنی نشان نده."],[391,"تو همی‌دانی و شبهای دراز","که همی‌خواندم تورا با صد نیاز","تو هم می‌دانی در شب‌های طولانی که من با همه‌ی وجود و از روی نیاز زیاد تو را می‌خواندم و دعا می‌کردم."],[391,"پیش خلق این را اگر خود قدر نیست","پیش تو همچون چراغ روشنیست","اگر این موضوع برای دیگران ارزشمند نباشد، برای تو مانند نوری در روشنی است."],[392,"چونک داود نبی آمد برون","گفت هین چونست این احوال چون","داود نبی وقتی به خارج آمد، گفت: این چه وضع و حالتی است؟"],[392,"مدّعی گفت ای نبی الله داد","گاو من در خانه او درفتاد","مدعی گفت: ای پیامبر خدا، گاو من به خانه او (متهم) رفته و آنجا کشته شده است."],[392,"کشت گاوم را بپرسش که چرا","گاو من کشت او بیان کن ماجرا","مدعی از داود علیه السلام می‌خواهد تا از گاوش بپرسد که چرا گاو او را کشته است و خواسته‌اش این است که ماجرای این حادثه را توضیح دهد."],[392,"گفت داودش بگو ای بوالکرم","چون تلف کردی تو ملک محترم","داود به بوالکرم می‌گوید: بگو، تو که این ملک محترم را از بین بردی، چرا این کار را کردی؟"],[392,"هین پراکنده مگو حجت بیار","تا به یک سو گردد این دعوی و کار","هدف این است که در این بحث و دعوا، به جای این که هر یک به بهانه‌های پراکنده بپردازید، دلیل و مدرکی بیاورید تا این ادعای مطرح شده به یک نتیجه مشخص برسد و کارها حل و فصل شود."],[392,"گفت ای داود بودم هفت سال","روز و شب اندر دعا و در سؤال","مردی به داود می‌گوید که او به مدت هفت سال، شب و روز مشغول دعا و سوال از خداوند بوده‌است."],[392,"این همی‌جستم ز یزدان کای خدا","روزیی خواهم حلال و بی عنا","من از خداوند درخواست می‌کنم که روزی حلال و بدون هیچگونه نیرنگ و فریبی به من عطا کند."],[392,"مرد و زن بر ناله من واقف‌اند","کودکان این ماجرا را واصف‌اند","مردان و زنان از ناله‌ها و دردهای من آگاه‌اند و حتی کودکان نیز این داستان را تعریف می‌کنند و از آن اطلاع دارند."],[392,"تو بپرس از هر که خواهی این خبر","تا بگوید بی شکنجه بی ضرر","هر کسی را که می‌خواهی درباره این موضوع بپرسی، می‌تواند به راحتی و بدون دردسر اطلاعاتی به تو بدهد."],[392,"هم هویدا پرس و هم پنهان ز خلق","که چه می‌گفت این گدای ژنده‌دلق","همه‌ی مردم چه آشکار و چه پنهان را بپرس که این گدای بی‌خانمان و رنجور چه می‌گوید."],[392,"بعد این جمله دعا و این فغان","گاوی اندر خانه دیدم ناگهان","ناگهان پس از این دعا و فریاد، گاوی را در خانه دیدم."],[392,"چشم من تاریک شد نه بهر لوت","شادی آن که قبول آمد قنوت","چشم من به خاطر درخواست و آرزوی شادی دیگران تاریک شد، زیرا دعای من در پیشگاه خداوند پذیرفته شد."],[392,"کشتم آن را تا دهم در شکر آن","که دعای من شنود آن غیب‌دان","من آن شخص را کشتم تا به شکرگزاری بپردازم، زیرا کسی که همه‌چیز را می‌داند (خداوند) دعای من را شنیده است."],[393,"گفت داود این سخنها را بشو","حجت شرعی درین دعوی بگو","داود گفت: این افکار را از خودت دور کن، باید دلیل شرعی برای این دعوا بیاوری."],[393,"تو روا داری که من بی حجتی","بنهم اندر شهر باطل سنتی","داود (پیامبر) می‌گوید که آیا تو حق داری بدون دلیل و مدرکی، در شهری قانونی نادرست را برقرار کنی؟"],[393,"این کی بخشیدت خریدی وارثی","ریع را چون می‌ستانی حارثی","تو چگونه می‌توانی پرداخت اقساط یک زمین را که خریداری کرده‌ای ببخشی، در حالی که هنوز منتظر درآمد و محصول آن هستی؟"],[393,"کسب را همچون زراعت دان عمو","تا نکاری دخل نبود آن تو","کسب را مانند کشت و زراعت بدان ای عم، زیرا تا زمانی که کاری نکنی، درآمدی برای تو وجود ندارد."],[393,"آنچ کاری بدروی آن آن تست","ورنه این بی‌داد بر تو شد درست","هر چه کاری که انجام دهی، همان نتیجه‌اش برای تو خواهد بود و اگر از این مسئله غافل باشی، ناعدالتی و ستم به تو خواهد رسید."],[393,"رو بده مال مسلمان کژ مگو","رو بجو وام و بده باطل مجو","مال مسلمان را به او بده و بهانه‌تراشی نکن. دنبال قرض و وام نرو و از کارهای نادرست و باطل دوری کن."],[393,"گفت ای شه تو همین می‌گوییم","که همی‌گویند اصحاب ستم","ای پادشاه، تو همین را می‌گویی که اصحاب ستم نیز می‌گویند."],[394,"سجده کرد و گفت کای دانای سوز","در دل داود انداز آن فروز","او به سجده می‌افتد و می‌گوید: ای دانای دردها، آن روشنی و روشن‌گری را در دل داود (پیامبر) بیفکن."],[394,"در دلش نه آنچ تو اندر دلم","اندر افکندی به‌راز ای مفضلم","در دل او چیزی را که تو به‌طور پنهانی در دل من انداختی، نهفته کن، ای کسی که در علم و فضیلت بی‌نظیری."],[394,"این بگفت و گریه در شد های های","تا دل داود بیرون شد ز جای","این شخص این جمله را گفت و با صدای بلند شروع به گریه کرد، تا اینکه دل داود (پیامبر و قاضی) از عاطفه و احساس او متأثر شد و از جایش تکان خورد."],[394,"گفت هین امروز ای خواهان گاو","مهلتم ده وین دعاوی را مکاو","او به خواهان گاو می‌گوید که امروز مهلت بده و این دعواها را رها کن."],[394,"تا روم من سوی خلوت در نماز","پرسم این احوال از دانای راز","من به جای اینکه در میان مردم باشم، به گوشه‌ای خلوت می‌روم و در نماز از خداوند دانای رازها درباره این مشکلات و حالاتی که دارم، سوال می‌کنم."],[394,"خوی دارم در نماز این التفات","معنی قرة عینی فی الصلوة","در نماز، توجه خاص و خاصی دارم که معنایش همان «چشم روشنی من در نماز» است."],[394,"روزن جانم گشادست از صفا","می‌رسد بی واسطه نامه خدا","روزنه وجود من به دلیل پاکی و صفای درونم، مستقیم و بی‌واسطه پیام خدا به من می‌رسد."],[394,"نامه و باران و نور از روزنم","می‌فتد در خانه‌ام از معدنم","از روح پاک و صاف من، نامه‌های الهی، باران‌ رحمت و نور حقیقت به خانه‌ام می‌رسد و این نعمت‌ها از عمق وجودم سرچشمه می‌گیرد."],[394,"دوزخست آن خانه کان بی روزنست","اصل دین ای بنده روزن کردنست","خانه‌ای که روزن ندارد، دوزخ است و تو ای بنده، بدان که اصل دین باز کردن روزن و راهی برای نور و آشتی پیدا کردن است."],[394,"تیشه هر بیشه‌ای کم زن بیا","تیشه زن در کندن روزن هلا","هر درخت و جنگلی را با تیشه آسیب نزن، بلکه بیا و تیشه را به کار ببر تا راهی برای نور و روشنایی ایجاد کنی."],[394,"یا نمی‌دانی که نور آفتاب","عکس خورشید برونست از حجاب","آیا نمی‌دانی که نور آفتاب، انعکاس و تصویر خورشید است که از پرده‌ای که بر آن افتاده، خارج می‌شود؟"],[394,"نور این دانی که حیوان دید هم","پس چه کرمنا بود بر آدمم","این نور را که تو می‌دانی حیوان نیز آن را می‌بیند، پس چه شایستگی و بزرگی بر آدم (انسان) می‌بخشد."],[394,"من چو خورشیدم درون نور غرق","می‌ندانم کرد خویش از نور فرق","من مانند خورشید هستم که در نور خود غرق شده و نمی‌دانم که چطور می‌توانم از نور خود جدا شوم."],[394,"رفتنم سوی نماز و آن خلا","بهر تعلیمست ره مر خلق را","من به سوی نماز می‌روم و این خلوت برای آموزش و یادگیری است تا راه و روش مردم را بیاموزم."],[394,"کژ نهم تا راست گردد این جهان","حرب خدعه این بود ای پهلوان","من با کردار نادرست خود این جهان را به بی‌راهه کشانده‌ام و فکر می‌کنم که با فریب و نیرنگ می‌توانم اوضاع را به سامان برسانم، ای قهرمان."],[394,"نیست دستوری و گر نه ریختی","گرد از دریای راز انگیختی","اگر دستوری وجود نداشت، تو از دریای اسرار، گرد و غبار برمی‌افشاندی."],[394,"همچنین داود می‌گفت این نسق","خواست گشتن عقل خلقان محترق","داود نبی می‌گفت که این روش و دستور (داوری) که به آن عمل می‌کنید، عقل مردم را به شدت تحت تأثیر و دچار مشکل می‌کند."],[394,"پس گریبانش کشید از پس یکی","که ندارم در یکیی‌اش شکی","او (شخص مورد نظر) به گریبان یکی از مردم رسید و گفت که من در مورد او هیچ شکی ندارم."],[394,"با خود آمد گفت را کوتاه کرد","لب ببست و عزم خلوتگاه کرد","او به آرامی با خود فکر کرد و تصمیم گرفت که صحبتش را کم کند، سپس دهانش را بست و به سمت مکانی خلوت رفت تا تنها باشد."],[395,"در فرو بست و برفت آنگه شتاب","سوی محراب و دعای مستجاب","داود به هنگام دریافت وحی و آگاهی از حقیقت، به سرعت به سوی محراب رفت تا دعا کند و به درخواستش پاسخ مثبت داده شود."],[395,"حق نمودش آنچ بنمودش تمام","گشت واقف بر سزای انتقام","خداوند به داود چیزهایی را نشان داد که او را کاملا به عواقب و پیامدهای انتقام آشنا کرد."],[395,"روز دیگر جمله خصمان آمدند","پیش داود پیمبر صف زدند","روز بعد، همه دشمنان نزد داود پیامبر جمع شدند و صف بستند."],[395,"همچنان آن ماجراها باز رفت","زود زد آن مدعی تشنیع زفت","ماجراهای گذشته دوباره به سرعت تکرار شد و آن مدعی که دروغ‌پردازی می‌کرد، به شدت به داود آسیب رساند."],[396,"گفت داودش خمش کن رو بهل","این مسلمان را ز گاوت کن بحل","داود به این جوان می‌گوید که سکوت کند و از او بخواهد که نسبت به صاحب گاو با مهربانی رفتار کند و از او عذرخواهی کند."],[396,"چون خدا پوشید بر تو ای جوان","رو خمش کن حق ستاری بدان","وقتی که خداوند خطای تو را پنهان کرده است، ای جوان، باید ساکت بمانی و نباید در مورد آن سخن بگویی، زیرا حقایق در پیشگاه خداوند پوشیده می‌مانند."],[396,"گفت وا ویلی چه حکمست این چه داد","از پی من شرع نو خواهی نهاد","داود علیه‌السلام می‌گوید وای بر من، این چه حکمی است که صادر کردی؟ آیا می‌خواهی به خاطر من، قانونی جدید وضع کنی؟"],[396,"رفته است آوازه عدلت چنان","که معطر شد زمین و آسمان","آوازه عدالت تو به قدری گسترده و خوشبو شده که تمام زمین و آسمان را معطر کرده است."],[396,"بر سگان کور این استم نرفت","زین تعدی سنگ و که بشکافت تفت","داود علیه‌السلام می‌گوید: صدای من در برابر سگان کور که نمی‌شنوند، به جایی نمی‌رسد؛ حتی اگر من سنگ و کوه را بشکافم، باز هم نتیجه‌ای نخواهد داشت."],[396,"همچنین تشنیع می‌زد برملا","کالصلا هنگام ظلمست الصلا","او (صاحب گاو) همچنان بر داود (پیامبر) عیب‌جویی می‌کرد و آن را به‌طور آشکار بیان می‌نمود؛ مانند دعایی که در زمان ظلم و ستم به خداوند ندا داده می‌شود."],[397,"بعد از آن داود گفتش کای عنود","جمله مال خویش او را بخش زود","داود به آن مرد که مغرور و لجوج است، می‌گوید: «سرعت کن و تمام دارایی‌ات را به او بده."],[397,"ورنه کارت سخت گردد گفتمت","تا نگردد ظاهر از وی استمت","اگر این کار را انجام ندهی، برای تو عواقب بدی به همراه خواهد داشت. گفتم که تا زمانی که حقیقت از او پدیدار نشود، تو از او بهره‌مند نخواهی شد."],[397,"خاک بر سر کرد و جامه بر درید","که به‌هر دم می‌کنی ظلمی مزید","او دیگر نمی‌توانست ظلم‌های بیشتری را ببیند، به همین خاطر خاک بر سر خود ریخت و لباسش را پاره کرد."],[397,"یک‌دمی دیگر برین تشنیع راند","باز داودش به پیش خویش خواند","مدتی دیگر بر این سرزنش و عیب‌جویی ماند و سپس داود او را دوباره به پیش خود احضار کرد."],[397,"گفت چون بختت نبود ای بخت‌کور","ظلمت آمد اندک اندک در ظهور","داود به شخصی که به او ظلم کرده می‌گوید چون تو بخت خوبی نداشتی و کور به دنیا آمدی، ظلمت و تاریکی به تدریج بر تو ظاهر خواهد شد."],[397,"ریده‌ای آنگاه صدر و پیشگاه","ای دریغ از چون تو خر خاشاک و کاه","تو بی‌آنکه صلاحیت و شایستگی داشته باشی، به مقام و جایگاه بلندی دست یافته‌ای. افسوس که شخصی مثل تو که در واقعیتی مشابه به خر خاشاک و کاه هستی، چنین مقام مهمی را اشغال کرده‌ای."],[397,"رو که فرزندان تو با جفت تو","بندگان او شدند افزون مگو","سرانجام فرزندان تو به گناهی که خود مرتکب شده‌ای، به بردگی این شخص (که در اینجا به عنوان «او» ذکر شده) درآمدند. دیگر درباره این موضوع بیشتر نگو."],[397,"سنگ بر سینه همی‌زد با دو دست","می‌دوید از جهل خود بالا و پست","شخصی به خاطر نادانی و ناآگاهی خود، با شدت و عصبانیت به سینه‌اش ضربه می‌زند و به سمت بالا و پایین می‌دود، مانند کسی که از درد یا عذاب درونی خود بی‌خبر است."],[397,"خلق هم اندر ملامت آمدند","کز ضمیر کار او غافل بدند","مردم به ملامت و سرزنش او پرداختند، زیرا از باطن و نیت واقعی کار او بی‌خبر بودند."],[397,"ظالم از مظلوم کی داند کسی","کو بود سخره هوا همچون خسی","ظالم نمی‌داند که چه کسی مظلوم است، زیرا شخصی که تحت تأثیر هوای نفس خود قرار دارد و همچون علفی بی‌ارزش پیش می‌رود، نمی‌تواند به وضعیت واقعی دیگران پی ببرد."],[397,"ظالم از مظلوم آنکس پی برد","کو سر نفس ظلوم خود برد","کسی که خود را از خواسته‌های نفس و هوای نفسش آزاد کرده باشد، می‌تواند ظلم و ستم را از مظلومین درک کند. در واقع، تنها فردی که بر نفس خود تسلط دارد می‌تواند حقیقت ظلم را بشناسد."],[397,"ورنه آن ظالم که نفس است از درون","خصم هر مظلوم باشد از جنون","اگر انسان نفسانی ظالم باشد، در واقع از درونش به عنوان دشمن هر مظلوم عمل می‌کند و این کار ناشی از دیوانگی اوست."],[397,"سگ هماره حمله بر مسکین کند","تا تواند زخم بر مسکین زند","سگی همیشه به ضعیفان حمله می‌کند و تا جایی که بتواند، به آن‌ها آسیب می‌زند."],[397,"شرم شیران راست نه سگ را بدان","که نگیرد صید از همسایگان","شرف و نجابت شیران به گونه‌ای است که به سگ مربوط نمی‌شود، زیرا سگ نمی‌تواند از همسایگانش شکار کند."],[397,"عامه مظلوم‌کش، ظالم‌پرست","از کمین، سگشان سوی داود جست","مردم عادی که به ظلم عادت کرده‌اند و از ظالم حمایت می‌کنند، مانند سگی که در کمین نشسته، به سمت داود پیامبر می‌آیند."],[397,"روی در داود کردند آن فریق","کای نبی مجتبی بر ما شفیق","آن گروه به سوی داود (نبی مجتبی) روی آوردند و گفتند: ای نبی مهربان، بر ما رحم کن."],[397,"این نشاید از تو کین ظلمیست فاش","قهر کردی بی‌گناهی را به‌لاش","این کار تو درست نیست، زیرا ظلمی آشکار است که بدون دلیل، فرد بی‌گناهی را مجازات کردی."],[398,"گفت ای یاران زمان آن رسید","کان سر مکتوم او گردد پدید","داوود علیه‌السلام به یارانش می‌گوید که اکنون زمان آن فرارسیده است که راز پنهانی آشکار شود."],[398,"جمله برخیزید تا بیرون رویم","تا بر آن سر نهان واقف شویم","همه شما بلند شوید تا به بیرون برویم و به آن راز نهان آگاهی پیدا کنیم."],[398,"در فلان صحرا درختی هست زفت","شاخهااش انبه و بسیار و چفت","در آن صحرا درختی وجود دارد که دارای شاخه‌های بزرگ و انبوه و فراوان است و به هم فشرده و محکم است."],[398,"سخت راسخ خیمه‌گاه و میخ او","بوی خون می‌آیدم از بیخ او","خیمه‌گاه داود علیه‌السلام محکم و با ثبات است و از ریشه و بنیاد آن بوی خون به مشام می‌رسد، که نشان‌دهنده قربانی شدن و خون‌ریزی در آن منطقه است."],[398,"خون شدست اندر بن آن خوش درخت","خواجه را کشتست این منحوس‌ بخت","خون در ریشه آن درخت خوب به خاطر این دیده می‌شود که بخت بد خواجه (داود) او را کشته است."],[398,"تا کنون حلم خدا پوشید آن","آخر از ناشکری آن قلتبان","به خاطر ناشکر بودن آن شخص، حلم و رحمت خداوند تا کنون از او پنهان شده بود، اما حالا دیگر صبر خدا تمام شده است و به زودی آشکار خواهد شد."],[398,"که عیال خواجه را روزی ندید","نه به نوروز و نه موسمهای عید","خواجه (مرد ثروتمند) هیچ‌گاه نتوانسته است روزی برای خانواده‌اش (عیال) تأمین کند، نه در نوروز که زمان شادی و جشن است، و نه در ایام عید که معمولا برای برگزاری مراسم و خوشحالی مردم است."],[398,"بی‌نوایان را به یک لقمه نجست","یاد ناورد او ز حقهای نخست","داود علیه السلام به بی‌نوایان توجهی نکرد و به آنها فقط به خاطر یک لقمه نپرداخت و بی‌توجهی او باعث فراموشی حقوق اولیه و اساسی انسان‌ها شد."],[398,"تا کنون از بهر یک گاو این لعین","می‌زند فرزند او را در زمین","تا به حال برای یک گاو، این انسان بدجنس، فرزند او (داود علیه السلام) را در زمین به قتل رسانده است."],[398,"او بخود برداشت پرده از گناه","ورنه می‌پوشید جرمش را اله","او خود پرده گناهش را کنار زد و البته اگر این کار را نمی‌کرد، خداوند خطاهایش را می‌پوشاند."],[398,"کافر و فاسق درین دور گزند","پرده خود را به‌خود بر می‌درند","کافر و گناهکار در این زمان، خود را از پرده‌ی پوشش گناهی که بر خود دارند، جدا می‌کنند و عیب‌ها و فسادهای خود را آشکار می‌سازند."],[398,"ظلم مستورست در اسرار جان","می‌نهد ظالم به‌پیش مردمان","ظلمی که در دل انسان‌ها پنهان است به وسیله ظلم‌گران در پیش چشمان دیگران قرار می‌گیرد."],[398,"که ببینیدم که دارم شاخها","گاو دوزخ را ببینید از ملا","من دارم نشانه‌هایی از دوزخ را می‌بینم که شاخ‌های گاو دوزخ را نشان می‌دهد. این نشانه‌ها را از ملا مشاهده می‌کنید."],[399,"پس همینجا دست و پایت در گزند","بر ضمیر تو گواهی می‌دهند","دست و پای تو در اینجا که در خطر است، بر حقیقت درونت شهادت می‌دهند."],[399,"چون موکل می‌شود بر تو ضمیر","که بگو تو اعتقادت وا مگیر","وقتی ضمیر و درونت به تو تسلط می‌یابد و سخن می‌گوید، این نشان می‌دهد که نباید از اعتقادات و باورهایت دست بکشی."],[399,"خاصه در هنگام خشم و گفت‌ و گو","می‌کند ظاهر سرت را مو به‌ مو","در زمان خشم و هنگام بحث و جدل، خلقیات و خصوصیات درونی تو را به‌روشنی آشکار می‌سازد."],[399,"چون موکل می‌شود ظلم و جفا","که هویدا کن مرا ای دست و پا","زمانی که ظلم و ستم بر کسی حاکم می‌شود، از من می‌خواهی که ای دست و پا، آشکارا کن آنچه را که در دل نهفته‌ام."],[399,"چون همی‌گیرد گواه سر لگام","خاصه وقت جوش و خشم و انتقام","در زمان خشم و انتقام، گواهی‌دادن دست و پا به رازهایی که در دل دارند، بسیار قوی و مؤثر خواهد بود."],[399,"پس همان کس کین موکل می‌کند","تا لوای راز بر صحرا زند","پس همان کسی که موکل (نگهبان) می‌کند، در روز قیامت رازها را فاش می‌کند و بر همه آشکار می‌سازد."],[399,"پس موکل‌های دیگر روز حشر","هم تواند آفرید از بهر نشر","در روز قیامت، نگهبانان و فرشتگان دیگر نیز می‌توانند برای گسترش حقایق و انتشار اعمال انسانی آفریده شوند."],[399,"ای به‌ده دست آمده در ظلم و کین","گوهرت پیداست حاجت نیست این","ای کسی که به ظلم و عداوت رسیده‌ای، گوهر درون تو (خوبی‌ها و نیکی‌هایت) آشکار است و نیازی به بیان آن نیست."],[399,"نیست حاجت شهره گشتن در گزند","بر ضمیر آتشینت واقف‌اند","نیازی به معروف شدن در بین مردم به خاطر ظلم و آزار نیست، زیرا درد و آتش در دل تو برای همگان آشکار است و آن‌ها از وضعیت درونی تو باخبرند."],[399,"نفس تو هر دم بر آرد صد شرار","که ببینیدم منم ز اصحاب نار","نفس تو هر لحظه شعله‌های زیادی را به وجود می‌آورد که گویا من از ساکنان آتش هستم و این را مشهود می‌داند."],[399,"جزو نارم سوی کلّ خود روم","من نه نورم که سوی حضرت شوم","من از آتش دوزخ هستم و به سوی کل وجودم می‌روم، نه اینکه نوری باشم که به سوی حضرت حق بروم."],[399,"همچنان کین ظالم حق‌ناشناس","بهر گاوی کرد چندین التباس","این بیت اشاره به این دارد که ظالمی که حق و حقوق دیگران را نمی‌شناسد، برای به دست آوردن چند گاو، مشکلات و پیچیدگی‌های زیادی ایجاد می‌کند. به عبارت دیگر، برای رسیدن به خواسته‌های نامشروع خود، او بی‌ملاحظه و بی‌پروا رفتار می‌کند."],[399,"او ازو صد گاو برد و صد شتر","نفس اینست ای پدر از وی ببر","او از آن ظالم صد گاو و صد شتر گرفت؛ این موضوع نشان می‌دهد که باید از او دوری کنی، ای پدر."],[399,"نیز روزی با خدا زاری نکرد","یاربی نامد ازو روزی به‌ درد","یار او، در روزی در برابر خدا تقوا نداشت و از او شکایت نکرد، و به همین دلیل، خداوند روزی را به او نداد که از درد رهایی یابد."],[399,"کای خدا خصم مرا خشنود کن","گر منش کردم زیان تو سود کن","خدایا، دشمن مرا راضی و خوشنود کن، اگر من به تو آسیب رسانده‌ام، بر من لطفی کن تا به جای زیان، سودی حاصل شود."],[399,"گر خطا کشتم دیت بر عاقله‌ست","عاقله جانم تو بودی از الست","اگر در قتل یا آسیب رساندن به کسی اشتباهی مرتکب شده‌ام، جبران آن با عاقله (خانواده) است و عاقله جان من تو، یعنی خدا، هستی که در آغاز خلقت (عالم الست) مرا به وجود آوردی."],[399,"سنگ می‌ندهد به استعفار در","این بود انصاف نفس ای جان حرّ","بدون توبه و پشیمانی، سنگ نمی‌زند و نمی‌گوید که من گناه کرده‌ام؛ این رفتار نشان‌دهنده انصاف نفس است، ای جان آزاد و بزرگوار."],[400,"چون برون رفتند سوی آن درخت","گفت دستش را سپس بندید سخت","هنگامی که آنها به سوی آن درخت رفتند، سپس دست یکی از آنها را به شدت گرفتند و محکم بستند."],[400,"تا گناه و جرم او پیدا کنم","تا لوای عدل بر صحرا زنم","می‌خواهم تا گناه و اشتباه او را مشخص کنم تا بتوانم عدالت را در این بیابان برقرار سازم."],[400,"گفت ای سگ جد او را کشته‌ای","تو غلامی خواجه زین رو گشته‌ای","گفت ای سگ، تو جد او را کشته‌ای و به همین دلیل غلام کسی شده‌ای (که تو را پرورش داده)."],[400,"خواجه را کشتی و بردی مال او","کرد یزدان آشکارا حال او","تو خواجه را کشتی و اموال او را بردی، خداوند به‌روشنی وضعیت تو را می‌داند و از آن آگاه است."],[400,"آن زنت او را کنیزک بوده است","با همین خواجه جفا بنموده است","زن تو در گذشته کنیز کسی بوده و با همان خواجه (آقای تو) رفتار بدی داشته است."],[400,"هر چه زو زایید ماده یا که نر","ملک وارث باشد آنها سر به‌سر","هرچه که از این زن (کنیزک) به‌وجود آید، چه دختر باشد و چه پسر، آن‌ها نیز وارث ملک (دارایی) او خواهند بود و همه در این حق برابرند."],[400,"تو غلامی کسب و کارت ملک اوست","شرع جستی شرع بستان رو نکوست","تو بنده‌ای و کار تو به ملک او مربوط است، پس به دنبال شرع درست باش و راه صحیح را بپیمایید."],[400,"خواجه را کشتی باستم زار زار","هم برینجا خواجه گویان زینهار","خواجه، که به دلیل فساد و ستمکاری‌اش به زاری افتاده، به این وضع خود اشاره می‌کند و به کسانی که قدرتمندانه سخن می‌گویند، می‌گوید که زنهار و حذر کنید از این سرنوشت بد."],[400,"کارد از اشتاب کردی زیر خاک","از خیالی که بدیدی سهمناک","تو به خاطر ترس و وحشت از خیالی که دیدی، کارد را به زمین زدی و زیر خاک کردی."],[400,"نک سرش با کارد در زیر زمین","باز کاوید این زمین را همچنین","سگ به زیر زمین رفت و با کارد سر خود را با شدت زیاد کنده و جستجو کرد."],[400,"نام این سگ هم نبشته کارد بر","کرد با خواجه چنین مکر و ضرر","سگ را در اینجا به‌عنوان موجودی زیرک و مکار توصیف کرده‌اند که با نام کارد به تعبیری به مال و اموال خواجه آسیب می‌زند. به عبارتی، این سگ به خواجه ضرر می‌زند و نشان‌دهنده فریب و نیرنگی است که او از آن بی‌خبر است."],[400,"همچنان کردند چون بشکافتند","در زمین آن کارد و سر را یافتند","هنگامی که آنها (سگ و خواجه) با هم به دعوا پرداختند و کارد را در زمین شکستند، سر (سگ) را پیدا کردند."],[400,"ولوله در خلق افتاد آن زمان","هر یکی زنار ببرید از میان","در آن زمان که کارد و سر از زمین نمایان شد، هیاهو و غوغایی در میان مردم برخاست و هر کسی دست به کار شد و زنجیری که به گردن داشت را از میان برداشت."],[400,"بعد از آن گفتش بیا ای دادخواه","داد خود بستان بدان روی سیاه","پس از آن، او به شخصی که در جستجوی انصاف است می‌گوید: «بیا، تا حق و حقوق خود را بگیری و به او، که چهره‌اش تیره و سیاه است، توجه کن."],[401,"هم بدان تیغش بفرمود او قصاص","کی کند مکرش ز علم حق خلاص؟","داود علیه‌السلام فرمان داد تا با آن تیغ کسی را مجازات کنند، اما آیا این کید و نیرنگ او از شناخت و علم به حق نجات می‌یابد؟"],[401,"حلم حق گرچه مواساها کند","لیک چون از حد بشد پیدا کند","حلم و آرامش حق هرچند که در عین حال ممکن است از روی شفقت و مهربانی باشد، اما وقتی حد و مرز خود را شکست، به‌روشنی نمایان می‌شود."],[401,"خون نخسپد درفتد در هر دلی","میل جست و جوی و کشف مشکلی","خون (خون‌ریزی، قتل) در دل‌ها جا نمی‌گیرد و در هر دلی به دنبال جست و جو و پیدا کردن دوباره‌ای است که ماجرای مشکل را روشن کند."],[401,"اقتضای داوری رب دین","سر بر آرد از ضمیر آن و این","داوری الهی اقتضا می‌کند که حقیقت و واقعیت به وضوح از دل‌ها و اندیشه‌ها آشکار شود."],[401,"کان فلان چون شد چه شد حالش چه گشت","همچنانک جوشد از گلزار کشت","فلانی چه حالی دارد و چه تغییراتی در او به وجود آمده است، مانند آبی که از شکوفه‌های باغ بیرون می‌جوشد و به زمین می‌ریزد."],[401,"جوشش خون باشد آن وا جستها","خارش دلها و بحث و ماجرا","جوشش خون به معنای برانگیختن احساسات و عواطف انسانی است، که باعث خارش دل‌ها و بحث و ماجراهای مختلف می‌شود. این حالت نشان‌دهنده حساسیت و تنشی است که در ارتباط با یک موضوع مهم یا دردناک ایجاد می‌شود."],[401,"چونک پیداگشت سر کار او","معجزه داود شد فاش و دوتو","چون راز کار داود (علیه‌السلام) آشکار شد، معجزه‌اش نمایان شد و دو تا (کسی که برای قصاص درخواست شده بود) مشخص شد."],[401,"خلق جمله سر برهنه آمدند","سر به سجده بر زمینها می‌زدند","مردم با سرهای برهنه و بدون هیچ زینتی حاضر شدند و با انکار خود، سر به سجده بر زمین می‌زدند."],[401,"ما همه کوران اصلی بوده‌ایم","از تو ما صد گون عجایب دیده‌ایم","همه ما انسان‌ها در اصل و ماهیت خود نابینا بوده‌ایم، اما از تو، یعنی از خدا یا حقیقت، شگفتی‌های فراوانی را دیده‌ایم."],[401,"سنگ با تو در سخن آمد شهیر","کز برای غزو طالوتم بگیر","سنگ در اینجا به طوری نمادین صحبت کرده و به داود علیه‌السلام اشاره دارد. او می‌گوید که برای نبرد با جالوت، چه افتخاری است که تا این حد معروف و مشهور شده‌ام."],[401,"تو به سه سنگ و فلاخن آمدی","صد هزاران مرد را بر هم زدی","تو با سه سنگ و کمان کوچک به میدان آمدی و توانستی بر اثر آن، هزاران مرد را شکست دهی و بی‌نظام کنی."],[401,"سنگهایت صدهزاران پاره شد","هر یکی هر خصم را خون‌خواره شد","سنگ‌های تو، دشمنان را به تکه‌های کوچک تبدیل کرد و هر یک از آن‌ها سبب خون‌ریزی و کشتن دشمنان شد."],[401,"آهن اندر دست تو چون موم شد","چون زره‌سازی تورا معلوم شد","آهن در دستان تو مانند موم نرم و شکل‌پذیر شده است، زیرا تو هنر زره‌سازی را به خوبی می‌دانی و با آن آشنا هستی."],[401,"کوهها با تو رسایل شد شکور","با تو می‌خوانند چون مقری زبور","کوه‌ها به محبت و عشق تو نرم و تسلیم شده‌اند و مانند یک قاری به تو احترام می‌گذارند و زبور (کتاب آسمانی داود) را می‌خوانند."],[401,"صد هزاران چشم دل بگشاده شد","از دم تو غیب را آماده شد","بسیاری از دل‌ها تحت تأثیر نفحات تو باز شده و از طریق تو به عالم غیب و معنویت وصل شده‌اند."],[401,"و آن قوی‌تر زان همه کین دایمست","زندگی بخشی که سرمد قایمست","این زندگی‌بخشی که همیشگی و پایدار است، قوی‌تر از هر کینه و دشمنی‌ای است که وجود دارد."],[401,"جان جمله معجزات اینست خود","کو ببخشد مرده را جان ابد","تمام معجزات الهی در این است که او (خدا) می‌تواند جان مرده را ببخشد و به او حیات جاودانه عطا کند."],[401,"کشته شد ظالم جهانی زنده شد","هر یکی از نو خدا را بنده شد","زمانی که ظالمی کشته می‌شود، به‌خاطر این عمل، دنیای او به پایان می‌رسد و در عوض، انسان‌های دیگری دوباره به زندگی می‌آیند و به بندگی خدا مشغول می‌شوند."],[402,"نفس خود را کش جهان را زنده کن","خواجه را کشتست او را بنده کن","نفس خودت را نابود کن تا به زندگی واقعی دست یابی و به آن چیزی که از آن بالاتر است، دست پیدا کنی. کسی که به این کار اقدام کند، مانند خواجه‌ای است که خودش را خفه کرده و می‌تواند دیگران را نیز به بندگی وادار کند."],[402,"مدعی گاو، نفس تست هین","خویشتن را خواجه کردست و مهین","نفس انسان، به جای اینکه خویشتن را بزرگ و محترم بداند، خود را به گونه‌ای بی‌ارزش و کوچک می‌بیند، در حالی که این نفس باید به بزرگی خود پی ببرد. این تأکید بر ارزش ذاتی نفس، نشان‌دهنده ضرورت شناخت و احترام به خود است."],[402,"آن کشنده گاو، عقل تست رو","بر کشنده گاو تن منکر مشو","عقل تو همان نیروی فکری و شناختی است که می‌تواند بر زندگی مادی و جسمانی (نماد گاو) حکومت کند، پس بر آنچه که به ظاهر مهم است (تن) و به نفسانیات وابسته است، منکر نباش."],[402,"عقل اسیرست و همی خواهد ز حق","روزیی بی رنج و نعمت بر طبق","عقل در اسارت است و تلاش دارد که از خداوند روزی بدون زحمت و نعمت را به‌راحتی به دست آورد."],[402,"روزی بی رنج او موقوف چیست","آنک بکشد گاو را کاصل بدیست","به دست آوردن روزی بدون زحمت و رنج، به این وابسته است که چیزی مانند گاو (که نماد نفس است) کشته شود؛ زیرا نفس انسان مظهر بدی و موانع در مسیر رسیدن به روزی حلال و پاک است."],[402,"نفس گوید چون کشی تو گاو من","زانک گاو نفس باشد نقش تن","نفس می‌گوید که چطور تو گاو من را می‌کشی، زیرا این گاو نشان‌دهنده نیازهای جسمی و دنیوی من است."],[402,"خواجه‌زاده عقل مانده بی‌نوا","نفس خونی خواجه گشت و پیشوا","عقل که مانند فرزند باهوش و محترمی است، در شرایطی ناتوان و بی‌صدا مانده است، در حالی که نفس که منبعی از خون و زندگی است، به مقام رهبری و ریاست رسیده و او را تحت کنترل خود درآورده است."],[402,"روزی بی‌رنج می‌دانی که چیست","قوت ارواحست و ارزاق نبیست","رزق و روزی بدون زحمت را می‌دانی چیست؟ آن را قدرت و نیرو دهنده روح‌ها و روزی‌ دهندگان پیامبران می‌دانند."],[402,"لیک موقوفست بر قربان گاو","گنج اندر گاو دان ای کنج‌کاو","ولی به دست آوردن گنج و ثروت نیازمند قربانی کردن گاو است، پس باید گنج را در درون گاو دان (که به معنای حکمت و دانش است) جستجو کرد."],[402,"دوش چیزی خورده‌ام ور نه تمام","دادمی در دست فهم تو زمام","دیروز چیزی نوشیده‌ام و اگر نه، تمام داد و ستدهای من در دست و دانش تو، به تو وابسته است."],[402,"دوش چیزی خورده‌ام افسانه است","هرچه می‌آید ز پنهان خانه است","دیشب چیزی خورده‌ام که واقعیت ندارد و هر آنچه از من برمی‌آید، از دلایل و اسرار درونی‌ام نشأت می‌گیرد."],[402,"چشم بر اسباب از چه دوختیم","گر ز خوش‌چشمان کرشم آموختیم","چرا چشم‌مان را به وسایل و اسباب دوختیم، در حالی که از خوش‌چشمان (افرادی که اهل بصیرت هستند) آموخته‌ایم که به چیزهای واقعی توجه کنیم؟"],[402,"هست بر اسباب اسبابی دگر","در سبب منگر در آن افکن نظر","بر روی اسباب و وسایل دنیوی، اسباب دیگری نیز وجود دارد که باید به آن‌ها توجه کرد. به جای اینکه تنها به علل و اسباب ظاهری بپردازی، باید نگاهی عمیق‌تر و معنوی‌تر داشته باشی."],[402,"انبیا در قطع اسباب آمدند","معجزات خویش بر کیوان زدند","پیامبران برای قطع کردن وابستگی به علل و اسباب طبیعی ظهور کردند و معجزات خود را به عنوان نشانه‌ای از قدرت الهی به آسمان نشان دادند."],[402,"بی‌سبب مر بحر را بشکافتند","بی زراعت چاش گندم یافتند","بدون هیچ دلیلی، دریا را شکافتند و بدون اینکه زراعتی داشته باشند، گندم خوشمزه‌ای پیدا کردند."],[402,"ریگها هم آرد شد از سعیشان","پشم بز ابریشم آمد کش‌کشان","تلاش و کوشش آدمیان باعث می‌شود که ریگ‌ها (سنگ‌ریزه‌ها) نیز به دست بیاورند، مانند این که پشم بز به شکل ابریشم درآید و به‌خوبی کشیده شود. اینجا به رابطه تلاش و دستاوردها اشاره شده است."],[402,"جمله قرآن هست در قطع سبب","عز درویش و هلاک بولهب","قرآن به‌روشنی بیان می‌کند که سبب عزت درویش و هلاک ولید بن مغیره (که به بولهب مشهور است) چیست."],[402,"مرغ بابیلی دو سه سنگ افکند","لشکر زفت حبش را بشکند","مرغی از بابل با پرتاب چند سنگ، لشکری بزرگ از حبشی‌ها را زمین‌گیر و شکست می‌دهد. این اشاره به قدرت و تأثیر کوچک در برابر دشمنان بزرگ دارد."],[402,"پیل را سوراخ سوراخ افکند","سنگ مرغی کو به بالا پر زند","مرغی که به سمت بالا پرواز می‌کند، با پرتاب سنگ‌هایش، بدن فیل را به طور متناوب و ضربه‌زده می‌کند. این تصویر به نوعی نشان‌دهنده قدرتی است که نه تنها از قوت جسمی، بلکه از روح و نیروی باطنی ناشی می‌شود."],[402,"دم گاو کشته بر مقتول زن","تا شود زنده همان دم در کفن","برای زنده شدن یا زنده نمودن کسی، دم گاوی که کشته شده را بر جسد او قرار می‌دهند تا از این طریق روح و حیات به او بازگردد. این اشاره به باورهای عامیانه و نمادین دارد که در آن ارتباطی میان مرگ و زنده شدن با چیزهای خاص برقرار می‌شود."],[402,"حلق‌ببریده جهد از جای خویش","خون خود جوید ز خون‌پالای خویش","در این بیت به گوینده اشاره می‌شود که خواسته‌ها و تلاش‌های نفس انسان، حتی زمانی که در شرایط سخت و خطرناک است، باید به گونه‌ای باشد که از منابع درونی خود، یعنی ظرفیت‌ها و تجربیاتش، بهره‌برداری کند و به رشد و خودآگاهی برسد. اینجا بر اهمیت جستجوی منابع درونی در مواجهه با چالش‌ها تاکید شده است."],[402,"همچنین ز آغاز قرآن تا تمام","رفض اسبابست و علت والسلام","از ابتدای قرآن کریم تا انتهای آن، همه چیز به دور از اسباب و علل دنیوی است و در حقیقت، در نهایت همه چیز به آرامش و تسلیم به اراده الهی ختم می‌شود."],[402,"کشف این نه از عقل کارافزا شود","بندگی کن تا تورا پیدا شود","کشف این حقیقت، از راه عقل و تفکر زیاد حاصل نمی‌شود، بلکه با بندگی و تسلیم در برابر حق است که تو می‌توانی این را درک کنی و به آن پی ببری."],[402,"بند معقولات آمد فلسفی","شهسوار عقل عقل آمد صفی","معنای این بیت این است که میان تفکر فلسفی و معقولات، یک پیوند عمیق وجود دارد، و عقل انسان به عنوان نیرویی قوی و برتر، می‌تواند بر این پیچیدگی‌ها غلبه کند و به حقیقت راه یابد. در واقع، عقل به عنوان یک قهرمان عمل می‌کند که می‌تواند در مواجهه با چالش‌های فلسفی پیش برود و به درک عمیق‌تری از مسائل دست یابد."],[402,"عقل عقلت مغز و عقل تست پوست","معده حیوان همیشه پوست‌جوست","عقل تو مانند مغز است و عقل حیوانی مانند پوست است؛ به این معنا که عقل انسان به حقیقت و عمق می‌رسد، در حالی که عقل حیوانی تنها جنبه‌های سطحی را درک می‌کند. پوست در اینجا به عدم توانایی در فهم عمیق و واقعی اشاره دارد."],[402,"مغزجوی از پوست دارد صد ملال","مغز نغزان را حلال آمد حلال","مغز جو (مغز دانه گندم) به دلیل پوستی که دارد، نگرانی‌های زیادی ایجاد می‌کند، اما در عوض، مغز نغزان (مغزهای خوشمزه و باکیفیت) را می‌توان به راحتی خورد و در واقع خوردن آن‌ها بی‌دردسر است."],[402,"چونک قشر عقل صد برهان دهد","عقل کل کی گام بی ایقان نهد","عقل که تنها به ظواهر و دلایل مختلف اکتفا می‌کند، هرچند دلیل و برهان زیادی داشته باشد، اما نمی‌تواند قدمی محکم و مطمئن بردارد. این بدان معناست که اگر عقل به تنها ظاهرها تکیه کند، در درک حقیقت ناتوان خواهد بود."],[402,"عقل دفترها کند یکسر سیاه","عقل عقل آفاق دارد پر ز ماه","عقل، تمام علوم و دانش‌ها را به‌طور کامل و صحیح می‌فهمد و می‌تواند به شکلی عمیق و وسیع به جهان نگاه کند. در اینجا، به شباهت عقل با ماه اشاره شده که روشنایی و درک عمیق را به همراه دارد."],[402,"از سیاهی و سپیدی فارغست","نور ماهش بر دل و جان بازغست","نور ماه از سیاهی و روشنی بی‌نیاز است و بر دل و جان انسان می‌تابد و انرژی می‌بخشد."],[402,"این سیاه و این سپید ار قدر یافت","زان شب قدرست کاختروار تافت","این سیاه و سپید (که به شب و روز یا خیر و شر اشاره دارد) اگر ارزشمند شده‌اند، به خاطر شب قدر است که در آن، نور و روشنی قدر و منزلت پیدا می‌کنند."],[402,"قیمت همیان و کیسه از زرست","بی ز زر همیان و کیسه ابترست","ارزش همیان (کیسه) و کیسه پول به خاطر طلا و زر است و بدون زر، همیان و کیسه بی‌فایده و ناقص هستند."],[402,"همچنانک قدر تن از جان بود","قدر جان از پرتو جانان بود","قدر و ارزش بدن به خاطر جان است، همچنان که ارزش جان به روشنایی و نورانی بودن جانان (خدا) وابسته است."],[402,"گر بدی جان زنده بی پرتو کنون","هیچ گفتی کافران را میتّون","اگر جان بدون نور و پرتوی جانان (خدا) وجود داشته باشد، هیچ چیز نمی‌تواند زنده باشد؛ بنابراین، کافران به مرگ خود راضی هستند."],[402,"هین بگو که ناطقه جو می‌کند","تا به قرنی بعد ما آبی رسد","توجه کن که گفتار و اندیشه‌ها در طول زمان منتقل می‌شود و سخنان ما در آینده تأثیرگذار خواهد بود تا جایی که ممکن است در قرن‌های بعد، پیام ما به دیگران برسد."],[402,"گرچه هر قرنی سخن‌آری بود","لیک گفت سالفان یاری بود","هر چند در هر دوره‌ای سخنانی گفته می‌شود، اما این سخنان قدیم‌تر (سالفان) به خوبی از یکدیگر حمایت و پشتیبانی می‌کنند."],[402,"نه که هم توریت و انجیل و زبور","شد گواه صدق قرآن ای شکور","نه‌تنها کتاب‌های توریت، انجیل و زبور، بلکه خود قرآن نیز بر صدق و درستی پیام‌های الهی گواهی می‌دهد، ای شکرگزار."],[402,"روزی بی‌رنج جو و بی‌حسیب","کز بهشتت آورد جبریل سیب","روزی بدون زحمت و بدون نیاز به کسی که رسیدگی کند، از بهشت برای تو می‌آورد جبریل، میوه‌ای به نام سیب."],[402,"بلک رزقی از خداوند بهشت","بی‌صداع باغبان بی رنج کشت","خداوند در بهشت روزی و نعمت‌هایی را به انسان می‌دهد که بدون زحمت و سختی فراهم می‌شود، مانند میوه‌هایی که باغبان برای به‌دست آوردن آن‌ها زحمت نمی‌کشد."],[402,"زانک نفع نان در آن نان داد اوست","بدهدت آن نفع بی توسیط پوست","چون نفع نان از آن نان، به سرپرستی و عطای خداوند است، پس آن نفع را به تو می‌دهد و تو در این میان واسطه‌ای نیستی که با پوست و جسم خود دسترسی به آن داشته باشی."],[402,"ذوق پنهان نقش نان چون سفره‌ایست","نان بی سفره ولی را بهره‌ایست","لذت و شوق در باطن نان مانند سفره‌ای است که فقط وقتی نان در آن گذاشته شود، فایده‌اش محسوس است؛ در غیر این صورت، نان موجود اما بدون سفره، فاقد نفع واقعی است."],[402,"رزق جانی کی بری با سعی و جست","جز به عدل شیخ کو داود تست","برای رسیدن به روزی واقعی و جان‌افزا، تلاش و کوشش لازم نیست و این فقط به دست شخص عادل (شیخ) که مانند داود پیامبر است، امکان‌پذیر است."],[402,"نفس چون با شیخ بیند کام تو","از بن دندان شود او رام تو","نفس انسان وقتی به شیخ (معلم و راهنمای روحانی) نگاه کند و به خواسته‌ات توجه کند، مانند اسب رام می‌شود و از عمق وجودت، خواسته‌هایت را به تو می‌دهد."],[402,"صاحب آن گاو رام آنگاه شد","کز دم داود او آگاه شد","صاحب آن گاو، هنگامی که از نفوذ و قدرت داود آگاه شد، آرام و مطیع شد."],[402,"عقل گاهی غالب آید در شکار","برسگ نفست که باشد شیخ یار","گاهی عقل بر نفس چیره می‌شود و در مبارزه با آن پیروز می‌گردد؛ در این موقع، عقل به مانند شیخی است که با یاری و حمایت، بر دشواری‌ها غلبه می‌کند."],[402,"نفس اژدرهاست با صد زور و فن","روی شیخ او را زمرد دیده کن","نفس انسانی مانند اژدهایی است که با قدرت و حیله‌های فراوان خود را نشان می‌دهد، اما شیخ با بصیرت و درایت خود می‌تواند آن را در زیر کنترلی ساده به مانند یک سنگ زینتی (زمرد) ببیند و مهار کند."],[402,"گر تو صاحب گاو را خواهی زبون","چون خران سیخش کن آن سو ای حرون","اگر می‌خواهی صاحب گاو را وادار به حرف زدن کنی، باید او را به شکلی به چالش بکشی، مثل اینکه خر را با سیخی به طرف مخالف هدایت کنی."],[402,"چون به نزدیک ولی الله شود","آن زبان صد گزش کوته شود","وقتی به نزد ولی‌الله (خدا) می‌رسد، آن زبان (زبان ادعا و تهمت) که صد گزش و آزار دارد، کوتاه می‌شود و دیگر توانایی آزار ندارد."],[402,"صد زبان و هر زبانش صد لغت","زرق و دستانش نیاید در صفت","این بیت به ناکامی و عدم توانایی افرادی اشاره دارد که با داشتن ظاهر فصیح و زبان‌های گوناگون، در حقیقت فاقد عمق و حقیقت هستند. به عبارتی، آن‌ها هیچ‌گاه قادر نخواهند بود به‌درستی صفات و ویژگی‌های واقعی خود را بیان کنند."],[402,"مدعی گاو نفس آمد فصیح","صد هزاران حجت آرد ناصحیح","نفس آدمی مانند گاوی است که مدعی می‌شود و به زبان فصیح صحبت می‌کند، اما در حقیقت هزاران دلیل نادرست و اشتباه ارائه می‌دهد."],[402,"شهر را بفریبد الا شاه را","ره نتاند زد شه آگاه را","شهر (مردم) معمولا فریب می‌خورند، اما شاه (دولت یا حاکم) نمی‌تواند فریب بخورد و او از واقعیت‌ها آگاه است."],[402,"نفس را تسبیح و مصحف در یمین","خنجر و شمشیر اندر آستین","نفس (در اینجا به معنای نفس اماره یا نفس هوسران) را مانند تسبیح و کتاب آسمانی در دست راست انسان تصور کن، در حالی که در دست چپ او خنجر و شمشیر نیز موجود است. این بیت به تضاد میان جنبه‌های معنوی و مادی وجود انسان اشاره دارد، جایی که انسان هم به یاد خدا و معنویت می‌پردازد و هم قدرت و خشونت را در اختیار دارد."],[402,"مصحف و سالوس او باور مکن","خویش با او هم‌سر و هم‌سر مکن","کتاب مقدس و ظاهر عام فریب او را باور نکن، و خودت را با او هم‌راز و هم‌دست نکن؛ زیرا ممکن است به دامش بیفتی."],[402,"سوی حوضت آورد بهر وضو","واندر اندازد تورا در قعر او","نفس انسان تو را به سمت حوض می‌آورد تا وضو بگیری، اما در عین حال می‌خواهد تو را به عمق خود ببرد و در گمراهی گرفتار کند."],[402,"عقل نورانی و نیکو طالبست","نفس ظلمانی برو چون غالبست؟","عقل روشن و نیک، خواهان آن است که چرا نفس تاریک بر او غلبه دارد؟"],[402,"زانک او در خانه عقل تو غریب","بر در خود سگ بود شیر مهیب","چون نفس در درون آدمی با عقل او غریبه است، او مانند سگی در برابر شیر قدرت و عظمت عقل، که در اینجا به شیر تشبیه شده، قرار دارد."],[402,"باش تا شیران سوی بیشه روند","وین سگان کور آنجا بگروند","بگذار شیرها به دشت و جنگل بروند و این سگان کور در آنجا به هم بپیوندند."],[402,"مکر نفس و تن نداند عام شهر","او نگردد جز به‌وحی القلب قهر","نفس و بدنی که در انسان است، تنها به فریبکاری و مکر توانا است و هر کسی که در شهر ادعای خود را می‌کند، بدون راهنمایی الهی و عشق واقعی به حقیقت، نمی‌تواند به موفقیت برسد."],[402,"هر که جنس اوست یار او شود","جز مگر داود کان شیخت بود","هر کسی که از جنس روح و صفای دل باشد، با او ارتباط برقرار می‌کند و دوست او می‌شود، مگر داود که مقامش به عنوان یک مقام‌دار و شیخ، هویت و ارتباطش را متفاوت می‌کند."],[402,"کو مبدل گشت و جنس تن نماند","هر که را حق در مقام دل نشاند","هر کسی که به مقام و درک حقیقت برسد و از دنیا و جسم رها شود، دیگر هویت و ماهیت ظاهری او تغییر می‌کند و دیگر به شکل مادی نمی‌ماند."],[402,"خلق جمله علتی‌اند از کمین","یار علت می‌شود علت یقین","تمام موجودات، به عنوان علتی از عشق و محبت یار (خدا) به وجود آمده‌اند و این عشق، باعث یقین و آگاهی در وجود آن‌ها می‌شود."],[402,"هر خسی دعوی داودی کند","هر که بی تمییز کف در وی زند","هر احمق و بی‌خود ادعای داوود بودن می‌کند، در حالی که هر کسی که از عقل و تشخیص درست چیزی سرش نمی‌شود، فقط باید خودش را در دستان دیگران بیفتد و در وضعیت بی‌کفایتی باقی بماند."],[402,"از صیادی بشنود آواز طیر","مرغ ابله می‌کند آن سوی سیر","پرنده‌ای که از صیاد صدای خود را می‌شنود، نادانانه به سمت او می‌رود، در حالی که خطر در کمین اوست."],[402,"نقد را از نقل نشناسد غویست","هین ازو بگریز اگر چه معنویست","کسی که نتواند بین حقیقت و نقل تمایز قائل شود، در واقع گمراه است. بهتر است از او دوری کنی، حتی اگر سخنانش معنوی به نظر برسد."],[402,"رسته و بر بسته پیش او یکیست","گر یقین دعوی کند او در شکیست","کسی که در پیش خداوند رشد کرده و به کمال رسیده، در حقیقت در برابر او هیچ تفاوتی با دیگران ندارد و اگر کسی خود را مطمئن از حقیقت بداند در حالی که در شک است، در واقع در اشتباه است."],[402,"این چنین کس گر ذکی مطلقست","چونش این تمییز نبود احمقست","آن کسی که به شدت هوشمند و در امور مختلف به کمال رسیده باشد، اما نتواند تفاوت‌ها را تشخیص دهد و درک کمی از حقایق داشته باشد، در واقع احمق است."],[402,"هین ازو بگریز چون آهو ز شیر","سوی او مشتاب ای دانا دلیر","از این شخص دوری کن، مانند آهویی که از شیر فرار می‌کند. به او نزدیک نشو، ای دانای دلیر."],[403,"عیسی مریم به کوهی می‌گریخت","شیر گویی خون او می‌خواست ریخت","عیسی، فرزند مریم، به سمت کوهی فرار می‌کرد،بطوری که گویی یک شیر درنده میخواست خون او را بریزد و اورا بکشد."],[403,"آن یکی در پی دوید و گفت خیر","در پیت کس نیست چه گریزی چو طیر","فرد دیگری به دنبال عیسی علیه السلام دوید و گفت:نخیر؛هیچ کسی تو را تعقیب نمیکند،پس چرا مثل یک پرنده فرار میکنی؟"],[403,"با شتاب او آنچنان می‌تاخت جفت","کز شتاب خود جواب او نگفت","عیسی علیه السلام چنان با شتاب و سرعت میدوید که از شدت سرعت خود جواب فرد سوال کننده را نداد."],[403,"یک دو میدان در پی عیسی براند","پس به‌ جدّ جد،عیسی را بخواند","شخص،عیسی علیه السلام را مسافتی تعقیب کرد و سپس با جدیت فراوان او را صدا زد؛"],[403,"کز پی مرضات حق یک لحظه بیست","که مرا اندر گریزت مشکلیست","برای رضای خدا لحظه ای باییست من درمورد فرارت ازت سوال دارم"],[403,"از کی این سو می‌گریزی ای کریم","نه پیت شیر و نه خصم و خوف و بیم","از دست چه کسی فرار میکنی ؟ نه شیری دنبالته نه دشمن و یا چیز ترسناکی!"],[403,"گفت از احمق گریزانم برو","می‌رهانم خویش را، بندم مشو","عیسی علیه السلام گفت: من از احمق فرار می‌کنم، مرا رها کن و مانع من نشو."],[403,"گفت آخر آن مسیحا نه توی","که شود کور و کر از تو مستوی","او گفت در واقع تو مسیحا نیستی، چون مسیحا کسی است که نباید از تو آسیب ببیند و بی‌حس و آگاه شود."],[403,"گفت آری گفت آن شه نیستی","که فسون غیب را ماویستی","عیسی علیه‌السلام می‌گوید که تو آن کسی نیستی که قادر به فهم جادوی غیبی باشید و در آن سکونت داشته باشی."],[403,"چون بخوانی آن فسون بر مرده‌ای","برجهد چون شیر صید آورده‌ای","وقتی که آن فسون را بر مرده‌ای بخوانی، او مانند شیر شکارزده‌ای به حرکت درمی‌آید و زنده می‌شود."],[403,"گفت آری آن منم گفتا که تو","نه ز گل مرغان کنی ای خوب‌رو","عیسی (علیه‌السلام) جواب می‌دهد که من همان فرد هستم، اما تو نباید خود را از خاک و طبیعت پرندگان بدانستی، ای زیبا روی."],[403,"گفت آری گفت پس ای روح پاک","هرچه خواهی می‌کنی از کیست باک","عیسی (علیه‌السلام) جواب می‌دهد که من همان هستم که می‌گویی. سپس می‌گوید ای روح پاک، تو می‌توانی هر کاری که بخواهی انجام دهی و از هیچ‌کس نترس."],[403,"با چنین برهان که باشد در جهان","که نباشد مر تورا از بندگان","با وجود چنین دلیلی، در این جهان چگونه می‌شود که تو از بندگان خودت جدا باشی؟"],[403,"گفت عیسی که به ذات پاک حق","مبدع تن، خالق جان در سبق","عیسی (علیه‌السلام) می‌گوید که تنها خداوند، ذات پاک و مقدس او، خالق بدن و روح انسان است و این آفرینش از ابتدای خلقت بوده است."],[403,"حرمت ذات و صفات پاک او","که بود گردون گریبان‌چاک او","حرمت و عظمت ذات و صفات پاک خداوند، همان‌طور که آسمان از در برابر او شرمنده و خجالت‌زده است."],[403,"کان فسون و اسم اعظم را که من","بر کر و بر کور خواندم شد حسن","نام‌های خدا و ویژگی‌های عالی او که من در برابر ناتوانان و نابینایان خواندم، اثرگذار و زیبا شد."],[403,"بر که سنگین بخواندم شد شکاف","خرقه را بدرید بر خود تا به‌ناف","عیسی علیه‌السلام بر کوه سنگینی دعا و ذکر کرده و این دعا باعث شد که خرقه‌اش (لباس پشمینه‌اش) پاره شد و این نشان‌دهنده قدرت تاثیر کلامش است."],[403,"بر تن مرده بخواندم گشت حی","بر سر لاشی بخواندم گشت شی","بر تن مرده‌ای خواندم، آنقدر تأثیر گذاشت که زنده شد؛ و وقتی بر سر لاشه‌ای خواندم، به اندازه‌ای اثر کرد که شیء و چیزی شد."],[403,"خواندم آن را بر دل احمق به ودّ","صد هزاران بار و درمانی نشد","اگرچه بارها و بارها بر دل انسان‌های نادان (احمق) دعا و ذکر خوانده‌ام، اما هیچ سودی نبخشید و بهبودی حاصل نشد."],[403,"سنگ خارا گشت و زان خو بر نگشت","ریگ شد کز وی نروید هیچ کشت","انسان احمق مانند سنگ سخت و بی‌حاصل می‌شود و تغییر نمی‌کند، در حالی که اگر او به فکر و حکمت بیفتد، مانند ریگ نرم و قابل کشت و کار می‌شود و می‌تواند میوه‌ای از خود به بار آورد."],[403,"گفت حکمت چیست کآنجا اسم حق","سود کرد اینجا نبود آن را سبق","حکمت چیست؟ آنجا که نام خدا باعث سود و فایده‌ای شده، در اینجا آن حکمت وجود ندارد و به این دلیل اثر ندارد."],[403,"آن همان رنج است و این رنجی چرا","او نشد این را و آن را شد دوا","رنجی که در اینجا وجود دارد، همانند رنجی است که قبلا گفته شد، اما چرا آن رنج درمانی شد و این رنج نشد؟"],[403,"گفت رنج احمقی قهر خداست","رنج و کوری نیست قهر آن ابتلاست","رنجی که احمق‌ها متحمل می‌شوند، ناشی از قهر خداوند است و این رنج، نشانه ضعف یا نادانی آن‌ها نیست، بلکه نوعی آزمایش الهی است."],[403,"ابتلا رنجیست کان رحم آورد","احمقی رنجیست کان زخم آورد","ابتلا درد و آزمایش است که خدا به خاطر رحمتش برای انسان‌ها می‌آورد، اما رنج احمقانه نتیجه جهل و نادانی است که زخم و آسیب می‌زند."],[403,"آنچ داغ اوست مهر او کرده است","چاره‌ای بر وی نیارد برد دست","عذابی که از جانب خداوند بر آن شخص نازل شده است، او را به این حالت رسانده که هیچ چاره‌ای برای رهایی از آن ندارد و هیچ دستی نمی‌تواند او را نجات دهد."],[403,"ز احمقان بگریز چون عیسی گریخت","صحبت احمق بسی خون‌ها که ریخت","از احمقان دوری کن، مانند عیسی که از آن‌ها فرار کرد، زیرا گفت‌وگو با احمق‌ها موجب هدر رفتن جان و خون بسیاری شده است."],[403,"اندک اندک آب را دزدد هوا","دین چنین دزدد هم احمق از شما","به آرامی و به تدریج، هوا قطره‌قطره آب را می‌دزدد؛ دین هم به همین شکل از افراد نادان می‌رباید."],[403,"گرمیت را دزدد و سردی دهد","همچو آن کاو زیر کون سنگی نهد","مهر و گرمی تو را می‌گیرد و به جای آن سردی می‌بخشد، مانند کسی که زیر پای خود سنگی می‌گذارد تا بر او بنشیند و خود را از راحتی محروم کند."],[403,"آن گریز عیسی نه از بیم بود","آمن است او‌، آن پی تعلیم بود","گریز عیسی از آنجا نه به خاطر ترس بود، زیرا او در امنیت کامل بود، بلکه هدف او از این گریز آموزش و تعلیم دادن به دیگران بود."],[403,"زمهریر ار پر کند آفاق را","چه غم آن خورشید با اشراق را","اگر برف شدید (زمهریر) همه جا را بپوشاند، چه غمی دارد برای آن خورشید درخشان."],[404,"یادم آمد قصه اهل سبا","کز دم احمق صباشان شد وبا","به یادم آمد داستان کسانی که از سر حماقت، اهل سبا بودند و به خاطر نادانی آن‌ها دچار عذاب و غم شدند."],[404,"آن سبا ماند به شهر بس کلان","در فسانه بشنوی از کودکان","قصه اهل سبا در شهر بزرگ و پرجمعیتی باقی مانده و تو می‌توانی از کودکان شنیده‌ها و افسانه‌های آنان را بشنوی."],[404,"کودکان افسانه‌ها می‌آورند","درج در افسانه‌شان بس سر و پند","کودکان داستان‌ها و افسانه‌های خود را با پر از رمز و پیام‌های عبرت‌آمیز می‌سازند و در آنها نکات مهم و عقد را بیان می‌کنند."],[404,"هزلها گویند در افسانه‌ها","گنج می‌جو در همه ویرانه‌ها","در داستان‌ها، شوخی‌ها و سخنان ناپسند می‌گویند، در حالی که نباید به جای آن‌ها به دنبال گنج و ارزش‌ها در ویرانه‌ها و چیزهای بی‌ارزش بگردیم."],[404,"بود شهری بس عظیم و مه، ولی","قدر او قدر سکرّه بیش نی","در این بیت اشاره به شهری بزرگ و با عظمت شده است، اما ارزش و اهمیت آن تنها به اندازه یک دانه شکر است. این یعنی آن شهر اگرچه بزرگ و مشهور است، ولی در واقعیت، ارزش چندانی ندارد."],[404,"بس عظیم و بس فراخ و بس دراز","سخت زفت زفت اندازه پیاز","این شهر بسیار بزرگ، وسیع و طولانی است، اما آن‌قدر پر از زحمت و سختی است که اندازه‌اش به پیاز می‌رسد، زیرا پیاز هم معمولا لایه‌های سخت و زحمت‌آور دارد."],[404,"مردم ده شهر مجموع اندرو","لیک جمله سه تن ناشسته‌رو","در اینجا اشاره شده است که در میان مردم یک شهر بزرگ، تنها سه نفر هستند که هنوز به آراستگی و نظافت، توجه نکرده‌اند و در واقع، به خاطر اخلاق بد یا بی‌توجهی‌شان، در مقایسه با دیگران که بیشتر قابل تحسین هستند، ناچیز جلوه می‌کنند."],[404,"اندرو خلق و خلایق بی‌شمار","لیک آن جمله سه خام پخته‌خوار","در آنجا مردم و مخلوقاتی بسیار وجود دارند، اما از میان آن‌ها فقط سه نفر هستند که نادان و احمق‌اند و از عقل و درک صحیح بی‌بهره‌اند."],[404,"جان ناکرده به جانان تاختن","گر هزارانست باشد نیم تن","اگر کسی حتی با جانش به عشق و معشوق نرود و عملا جانی نداشته باشد، هرچند که در نظر دیگران بزرگ و باارزش باشد، در حقیقت او فقط نیمی از وجودش را دارد و ارزش کمتری از یک انسان واقعی خواهد داشت."],[404,"آن یکی بس دور بین و دیده‌کور","از سلیمان کور و دیده پای مور","شخصی در این بیت بسیار دوربین و زیرک است، اما در عین حال به اندازه‌ای نادان و کور است که هرگز نمی‌تواند حقیقت را ببیند؛ مانند سلیمان که به خاطر خداوند قدرت دیدن داشت، اما این شخص به قدری ناتوان است که حتی پای یک مور را هم نمی‌بیند."],[404,"و آن دگر بس تیزگوش و سخت کر","گنج و در وی نیست یک جو سنگ زر","این شخص بسیار گوش شنوا و حساس دارد، اما در عین حال، بسیار کر است؛ در واقع در او هیچ چیزی از گنج و ثروت وجود ندارد، حتی به اندازه یک سکه کوچک طلا."],[404,"وآن دگر عور و برهنه لاشه‌باز","لیک دامنهای جامه او دراز","و دیگری که کور و برهنه است، باز هم در میانسالی خود لباس‌های طولانی پوشیده است."],[404,"گفت کور اینک سپاهی می‌رسند","من همی‌بینم که چه قومند و چند","کور می‌گوید که سپاهی در حال نزدیک شدن هستند و او می‌داند که این قوم چه کسانی هستند و تعدادشان چقدر است."],[404,"گفت کر آری شنودم بانگشان","که چه می‌گویند پیدا و نهان","کر به صدای سپاهیان اشاره می‌کند که از دور می‌شنود و می‌فهمد که آن‌ها چه می‌گویند، هم آشکار و هم پنهان."],[404,"آن برهنه گفت ترسان زین منم","که ببرند از درازی دامنم","زن برهنه‌ای گفت که از ترس این موضوع می‌ترسم که دامنم را از طولش ببرند."],[404,"کور گفت اینک به نزدیک آمدند","خیز بگریزیم پیش از زخم و بند","کور گفت حالا دیگر نزدیک شدند، پس بشتابید و فرار کنیم قبل از اینکه آسیب ببینیم یا گرفتار شویم."],[404,"کر همی‌گوید که آری مشغله","می‌شود نزدیکتر یاران هله","کر که نماد احمق‌ها یا جاهلان است، می‌گوید که اگر یاران (دوستان) نزدیک‌تر شوند، مشغله (مشغولی یا مشکل) بیشتری پیش می‌آید. این شخص از نزدیک‌تر شدن یاران احساس خطر می‌کند."],[404,"آن برهنه گفت آوه دامنم","از طمع برند و من ناآمنم","آن مرد برهنه (نیز ممکن است اشاره به شخصی خاص باشد) گفت که دامنم را از طمع بکشید، چرا که من در حال حاضر در امنیت نیستم."],[404,"شهر را هشتند و بیرون آمدند","در هزیمت در دهی اندر شدند","آنها به شهر حمله کردند و پس از آنکه به شدت عقب‌نشینی کردند، وارد دهکی شدند."],[404,"اندر آن ده مرغ فربه یافتند","لیک ذره گوشت بر وی نه نژند","در آن ده، مرغ چاق و فربه‌ای پیدا کردند، اما هیچ‌گونه گوشتی بر روی آن نبود و در واقع خالی و بی‌فایده بود."],[404,"مرغ مرده خشک وز زخم کلاغ","استخوانها زار گشته چون پناغ","مرغی که مرده و خشک شده است و به خاطر زخم‌هایی که کلاغ به او زده، استخوان‌هایش به شدت ضعیف و زار شده‌اند."],[404,"زان همی‌خوردند چون از صید شیر","هر یکی از خوردنش چون پیل سیر","آنها به همین دلیل از گوشت شیر می‌خوردند و هر یک از آنها پس از خوردن به اندازه یک فیل سیر بودند، یعنی بسیار چاق و راضی شده بودند."],[404,"هر سه زان خوردند و بس فربه شدند","چون سه پیل بس بزرگ و مه شدند","این سه نفر از همان طعمی که خوردند، چاق و فربه شدند و به اندازه‌ای بزرگ و عظیم هستند که مانند سه فیل شده‌اند."],[404,"آنچنان کز فربهی هر یک جوان","در نگنجیدی ز زفتی در جهان","چنان چاق و فربه شدند که هر یک از آن‌ها به خاطر بزرگیشان در دنیا جا نمی‌شدند."],[404,"با چنین گبزی و هفت اندام زفت","از شکاف در برون جستند و رفت","با چنین بدن بزرگ و هفت‌کونی چاق و تنگ، از شکاف در بیرون آمدند و رفتند."],[404,"راه مرگ خلق ناپیدا رهیست","در نظر ناید که آن بی‌جا رهیست","راه مرگ مردم مسأله‌ای است که برایشان پنهان و نامشخص است و آن را نمی‌توان دید، در حالی که واقعا این راه وجود دارد و در واقع آنها در مسیر نادرستی قرار دارند."],[404,"نک پیاپی کاروانها مقتفی","زین شکاف در که هست آن مختفی","چرا کاروان‌ها پیوسته از این شکاف عبور می‌کنند؟ در حالی که هیچ نشانه‌ای از آن در اینجا دیده نمی‌شود."],[404,"بر در ار جویی نیابی آن شکاف","سخت ناپیدا و زو چندین زفاف","اگر در در مدینه (شهر مدینه) به دنبال آن شکاف باشی، آن شکاف را نخواهی یافت، زیرا به شدت ناپیداست و از آن شکاف، چندین مرد و همسرانشان به دنیا آمده‌اند."],[405,"کر امل را دان که مرگ ما شنید","مرگ خود نشنید و نقل خود ندید","کسی که به امید و آرزوهایش کور است، مرگ ما را می‌بیند اما مرگ خود را نمی‌فهمد و به نقل حال خود توجه ندارد."],[405,"حرص نابیناست بیند مو به‌مو","عیب خلقان و بگوید کو به‌کو","حرص، گونه‌ای کوری است که فقط عیب‌های دیگران را با جزئیات می‌بیند و به‌طور مداوم درباره آن‌ها قضاوت می‌کند."],[405,"عیب خود یک ذره چشم کور او","می‌نبیند گرچه هست او عیب‌جو","این فرد عیب‌جو، با اینکه عیب دیگران را به‌خوبی می‌بیند، نمی‌تواند حتی یک ذره از عیب خود را تشخیص دهد و این نابینایی او را نشان می‌دهد."],[405,"عور می‌ترسد که دامانش برند","دامن مرد برهنه چون درند","مرد کور از اینکه دامنش را پاره کنند، می‌ترسد، در حالی که مرد برهنه‌ای که دامن ندارد، از درندگی دیگران ترسی ندارد."],[405,"مرد دنیا مفلس است و ترسناک","هیچ او را نیست، از دزدانش باک","مرد دنیا که به معنای بی‌خبر از حقیقت است، شخصیتی ضعیف و ترسناک دارد و در واقع هیچ ارزش و قدرتی ندارد. او از دزدان، که به فساد و خطرات دنیا اشاره دارد، هراسی ندارد."],[405,"او برهنه آمد و عریان رود","وز غم دزدش جگر خون می‌شود","انسان در آغاز به دنیا آمده و بی‌پوشش است و با وجود اینکه چیزی ندارد، به خاطر نگرانی از دزدی و نگران از دست دادن، دلش پر از غم و اندوه می‌شود."],[405,"وقت مرگش که بود صد نوحه بیش","خنده آید جانش را زین ترس خویش","هنگام مرگ او، صدای نوحه و شیون زیاد خواهد بود، اما در کنارش لبخند خواهد زد؛ چون از ترس خودش به آرامش رسیده است."],[405,"آن زمان داند غنی کش نیست زر","هم ذکی داند که او بد بی‌هنر","در آن زمان، شخص ثروتمند می‌فهمد که دارایی‌اش ارزش ندارد، زیرا انسان دانا می‌داند که بدون هنر و قابلیت، ثروت هیچ معنا و ارزشی ندارد."],[405,"چون کنار کودکی پر از سفال","کو بر آن لرزان بود چون رب مال","کودکی که در کنار او قرار دارد و به سفال‌های موجود نگاه می‌کند، مانند کسی است که در حال لرزیدن و ترسیدن از ربودن مال و ثروت است."],[405,"گر ستانی پاره‌ای گریان شود","پاره گر بازش دهی خندان شود","اگر تکه‌ای از چیزی را بگیری، آن پاره گریه می‌کند، اما اگر آن را به او برگردانی، دوباره خوشحال و خندان می‌شود."],[405,"چون نباشد طفل را دانش دثار","گریه و خنده‌ش ندارد اعتبار","اگر کودک را علم و دانش نباشد، نه گریه‌اش اعتبار دارد و نه خنده‌اش."],[405,"محتشم چون عاریت را ملک دید","پس بر آن مال دروغین می‌طپید","محتشم، وقتی که مال عاریه‌ای را به‌جای ملک خود دید، به خاطر آن مال دروغین، شاد و خوشحال شد و به حالت شگفت‌انگیزی دچار شد."],[405,"خواب می‌بیند که او را هست مال","ترسد از دزدی که برباید جوال","در خواب می‌بیند که صاحب مال و ثروتی است، اما از دزد می‌ترسد که آن را برباید."],[405,"چون ز خوابش بر جهاند گوش‌کش","پس ز ترس خویش تسخر آیدش","هنگامی که از خواب بیدار می‌شود و هشیار می‌گردد، ترس او از دزدی و خطراتی که در خواب احساس کرده بود، به طور مضحک و خنده‌دار به نظرش می‌آید."],[405,"همچنان لرزانی این عالمان","که بودشان عقل و علم این جهان","عالمان و دانشمندان این دنیا نیز مانند کسانی هستند که در حال لرزش و ترس به سر می‌برند، هرچند که عقل و علم دارند."],[405,"از پی این عاقلان ذو فنون","گفت ایزد در نبی، لا یعلمون","خداوند درباره این عالمان و دانایان چند رشته‌ای که به تخصص‌های مختلف مسلط هستند، می‌گوید که آن‌ها چیزی از حقیقت نمی‌دانند و در واقع، نادان هستند."],[405,"هر یکی ترسان ز دزدی کسی","خویشتن را علم پندارد بسی","هر کس از دزدی دیگری می‌ترسد، به خود مغرور است و فکر می‌کند که دانش و آگاهی زیادی دارد."],[405,"گوید او که روزگارم می‌برند","خود ندارد روزگار سودمند","او می‌گوید که روزگار (زمان) من را به‌سوی تباهی می‌برد، در حالی که خودش از زندگی خوب و سودمند برخوردار نیست."],[405,"گوید از کارم بر آوردند خلق","غرق بی‌کاریست جانش تابه حلق","او می‌گوید مردم او را از کارش بازداشته‌اند و اکنون در دریاهای بی‌کاری غرق شده است، حالا جانش به اندازه‌ای تنش را آزار می‌دهد که به گلو رسیده است."],[405,"عور ترسان که منم دامن کشان","چون رهانم دامن از چنگالشان","من از ترس عور (برهنه) و بی‌پوشش بودن، دامن خود را کشان‌کشان می‌آیم تا از چنگال آنان رها شوم."],[405,"صد هزاران فضل داند از علوم","جان خود را می‌نداند آن ظلوم","انسان‌های جاهل ممکن است در زمینه‌های مختلف دانش و علم ادعاهای زیادی داشته باشند و از اطلاعات زیاد خود صحبت کنند، اما به عمق وجود و حقیقت خودشان آگاهی ندارند و از آن غافل هستند."],[405,"داند او خاصیت هر جوهری","در بیان جوهر خود چون خری","او (فرد ظالم) به خوبی خاصیت و ویژگی هر چیز گرانبهایی را می‌داند، اما درباره خودش، همانند خری که فقط به صدای خود آشناست و از ماهیت خود بی‌خبر است، چیزی نمی‌داند."],[405,"که همی‌دانم یجوز و لایجوز","خود ندانی تو یجوزی یا عجوز","من می‌دانم چه چیزهایی درست و چه چیزهایی نادرست هستند، اما تو خودت نمی‌دانی که آیا کارهای تو درست است یا نادرست."],[405,"این روا و آن ناروا دانی ولیک","تو روا یا ناروایی بین تو نیک","تو می‌دانی چه چیزهایی درست و چه چیزهایی نادرست است، اما خودت را نمی‌شناسی که آیا تو هم درست یا نادرست هستی."],[405,"قیمت هر کاله می‌دانی که چیست","قیمت خود را ندانی احمقیست","اگرچه می‌دانی ارزش هر کالا چیست، اما اگر خودت را نشناسی و نتوانی به ارزش خود پی ببری، به واقع نادان هستی."],[405,"سعدها و نحسها دانسته‌ای","ننگری سعدی تو یا ناشسته‌ای","سعد و نحس به معنای خوشی و بدی هستند. اگرچه تو می‌دانی که خوشبختی و بدبختی چیست، اما نباید به آن‌ها اهمیت دادی و باید به خودت و ماهیت واقعی‌ات توجه کنی."],[405,"جان جمله علمها اینست این","که بدانی من کیم در یوم دین","تمام علم‌ها و دانش‌ها در نهایت به این موضوع مربوط می‌شود که بیندیشی من کیستم در روز قیامت و حساب و کتاب."],[405,"آن اصول دین بدانستی ولیک","بنگر اندر اصل خود گر هست نیک","تو اصول دین را می‌شناسی، اما باید به خودت نگاه کنی و ببینی که آیا حقیقتا خوب هستی یا نه."],[405,"از اصولینت اصول خویش به","که بدانی اصل خود ای مرد مه","تو از اصول دین خود چیزهایی می‌دانی، اما مهم‌تر از آن این است که به اصل حقیقت وجود خودت توجه کنی، ای مرد بزرگ."],[406,"اصلشان بد بود آن اهل سبا","می‌رمیدندی ز اسباب لقا","اصل و نژاد آن‌ها (اهل سبا) بد بود و از هرگونه ملاقات و رویارویی می‌گریختند."],[406,"دادشان چندان ضیاع و باغ و راغ","از چپ و از راست از بهر فراغ","اهل سبا به قدری باغ و زمین و زمین‌های زراعی داشتند که از سمت چپ و راست، سرشار از خوشی و آرامش بودند."],[406,"بس که می‌افتاد از پری ثمار","تنگ می‌شد معبر ره، بر گذار","به دلیل فراوانی میوه‌ها، معبر راه تنگ می‌شد و عبور از آن دشوار می‌گشت."],[406,"آن نثار میوه، ره را می‌گرفت","از پری میوه، ره‌رو در شگفت","آن میوه‌ها که از درختان می‌ریخت، به قدری زیاد بود که راه عبور را مسدود می‌کرد و رهگذران به تماشای این وضعیت حیرت‌زده می‌شدند."],[406,"سلّه بر سر در درختستانشان","پر شدی ناخواست از میوه‌فشان","بر سر درختستان اهل سبا، میوه‌ها به قدری فراوان و سرشار است که کسی به نیازی از آنها دست نیازیسته و از آنها بی‌خبر است."],[406,"باد آن میوه فشاندی نه کسی","پر شدی زان میوه دامنها بسی","باد، آن میوه را به زمین می‌ریزد و هیچ‌کس با آن میوه دامنش پر نمی‌شود."],[406,"خوشه‌های زفت تا زیر آمده","بر سر و روی رونده می‌زده","خوشه‌های درشت و رسیده به قدری پایین آمده که بر سر و صورت رونده، به اصطلاح، می‌خورده و او را در خود غرق می‌کند."],[406,"مرد گلخن‌تاب از پری زر","بسته بودی در میان زرین کمر","مردی با چهره‌ای گلگون و تابناک که از زیبایی و درخشندگی چهره‌اش می‌توان فهمید در میان کمر زرین و طلا بسته شده است."],[406,"سگ کلیچه کوفتی در زیر پا","تخمه بودی گرگ صحرا از نوا","سگ گلی که زیر پا می‌مالی، مانند تخمینی از گرگ صحرا است که به خاطر صدای نوا به وجود می‌آید. در این بیت، به تمسخر اشاره شده که چیزهایی که معمولا خطرناک به نظر می‌رسند، در واقع ممکن است بی‌خطر باشند و فقط از صداهای خاص واکنش نشان دهند."],[406,"گشته آمن شهر و ده از دزد و گرگ","بز نترسیدی هم از گرگ سترگ","شهر و ده امن و ایمن شده است و دیگر از دزد و گرگ نگران نیستید، حتی اگر گرگ بزرگ هم باشد، دیگر از او نمی‌ترسید."],[406,"گر بگویم شرح نعمتهای قوم","که زیادت می‌شد آن یوما بیوم","اگر بخواهم درباره نعمت‌های مردم سبا توضیح دهم، هر روز بر تعداد آن‌ها افزوده می‌شود."],[406,"مانع آید از سخنهای مهم","انبیا بردند امر فاستقم","سخنان مهم انبیا را از این مسأله که نباید از نعمت‌ها غافل شد، دور می‌کند. به آن‌ها گفته شده که بر ثابت‌قدم بودن تأکید کنند."],[407,"سیزده پیغامبر آنجا آمدند","گم‌رهان را جمله رهبر می‌شدند","سیزده پیامبر به آنجا آمدند تا گمشدگان را راهنمایی کنند و به آن‌ها نشان دهند که چگونه باید راه درست را پیدا کنند."],[407,"که هله نعمت فزون شد شکر کو","مرکب شکر ار بخسپد حرکوا","آیا مشاهده نمی‌کنی که نعمت‌ها بسیار افزون شده‌اند؟ پس شکرگزاری کجاست؟ اگر شکر را به درستی انجام ندهی، عذاب و سختی دامن‌گیرت خواهد شد."],[407,"شکر منعم واجب آید در خرد","ورنه بگشاید در خشم ابد","شکرگزاری از نعمت‌دهنده (خداوند) واجب و ضروری است؛ در غیر این صورت، شخص در عذاب و خشم ابدی گرفتار خواهد شد."],[407,"هین کرم بینید وین خود کس کند","کز چنین نعمت به شکری بس کند","بیدار شوید و به رحمت خداوند نگاه کنید، زیرا انسان نباید از این‌همه نعمت غافل باشد و به شکرگزاری بپردازد."],[407,"سر ببخشد شکر خواهد سجده‌ای","پا ببخشد شکر خواهد قعده‌ای","وقتی خداوند سر به تو میدهد شکرگزاری آن در سجده کردن است و اگر پا به تو داده است، شکرگزاری‌اش در نشستن و آرامش یافتن خواهد بود."],[407,"قوم گفته شکر ما را برد غول","ما شدیم از شکر و از نعمت ملول","مردم می‌گویند که شکرگزاری ما را تا حدی برده که مانند غولی شده‌ایم، به طوری که از شکر و نعمت خسته و بی‌حوصله هستیم."],[407,"ما چنان پژمرده گشتیم ازعطا","که نه طاعتمان خوش آید نه خطا","ما به قدری از نعمت‌ها و هدیه‌ها پژمرده شده‌ایم که دیگر نه عبادت و اطاعت‌مان خوشایند است و نه گناه و خطاهایمان."],[407,"ما نمی‌خواهیم نعمتها و باغ","ما نمی‌خواهیم اسباب و فراغ","ما نه به نعمت‌ها و ثروت‌ها نیازی داریم، و نه به باغ و وسایل راحتی و آسایش."],[407,"انبیا گفتند در دل علتیست","که از آن در حق‌شناسی آفتیست","پیامبران اشاره می‌کنند که در دل هر انسانی علت یا عاملی وجود دارد که باعث می‌شود او در قدردانی از نعمت‌ها کوتاهی کند و این به نوعی آفت یا مشکل در راه شکرگزاری است."],[407,"نعمت از وی جملگی علت شود","طعمه در بیمار کی قوت شود","نعمت‌ها از جانب خداوند به طور کلی علت درد و بیماری انسان‌ها می‌شود و مانند طعمه‌ای است که برای بیمار، قوت و انرژی فراهم نمی‌کند."],[407,"چند خوش پیش تو آمد ای مصر","جمله ناخوش گشت و صاف او کدر","ای مصر، چند بار خوشی به نزد تو آمد، اما همه آن خوشی‌ها ناگهان ناخوش شدند و حالت صاف و روشن آن‌ها به کدورت و تیرگی تبدیل شد."],[407,"تو عدو این خوشیها آمدی","گشت ناخوش هر چه بر وی کف زدی","تو دشمن این خوشی‌ها هستی و هرچه بر او دست زدی، ناخوش و بد شد."],[407,"هر که اوشد آشنا و یار تو","شد حقیر و خوار در دیدار تو","هر کسی که با تو آشنا و دوست شود، در نظر تو حقیر و بی‌ارزش می‌شود."],[407,"هر که او بیگانه باشد با تو هم","پیش تو او بس مه‌است و محترم","هرکس که با تو بیگانه باشد، در حضور تو بسیار محترم و ارزشمند به نظر می‌رسد."],[407,"این هم از تاثیر آن بیماریست","زهر او در جمله جفتان ساریست","این هم از تأثیر آن بیماری است که زهر آن در همه روابط و ارتباطات آدم‌ها پخش شده است."],[407,"دفع آن علت بباید کرد زود","که شکر با آن حدث خواهد نمود","برای از بین بردن آن بیماری، باید هر چه زودتر اقدام کرد، زیرا اگر تعلل کنیم، شیرینی شکر هم تحت تأثیر آن وضعیت بد قرار خواهد گرفت."],[407,"هر خوشی کاید به تو ناخوش شود","آب حیوان گر رسد آتش شود","هر خوشحالی که به تو برسد، به زودی به ناامیدی تبدیل می‌شود. اگر آب حیات هم به تو برسد، به همان اندازه می‌تواند موجب آتش و عذاب شود."],[407,"کیمیای مرگ و جسکست آن صفت","مرگ گردد زان حیاتت عاقبت","مرگ که کیمیای زندگی است، به دلیل ویژگی‌هایش، در نهایت به زنده‌بودن تو تبدیل خواهد شد و باعث نابودی آن حالت حیات می‌شود."],[407,"بس غدایی که ز وی دل زنده شد","چون بیامد در تن تو گنده شد","خیلی از غذاها وجود دارند که وقتی به دل و جان انسان می‌رسند، باعث حیات و شادابی می‌شوند، اما وقتی به بدن او وارد می‌شوند، او را سنگین و ضعیف می‌کنند."],[407,"بس عزیزی که بناز اشکار شد","چون شکارت شد بر تو خوار شد","بسیاری از عزیزان و بزرگانی که به خاطر جمال و زیبایی خود مورد توجه و احترام قرار گرفته‌اند، هنگامی که به چنگال تو افتاده و به تملک تو درآمده‌اند، دیگر ارزش و اعتبار خود را از دست داده و خوار شده‌اند."],[407,"آشنایی عقل با عقل از صفا","چون شود هر دم فزون باشد ولا","ارتباط عقل با عقل دیگر زمانی پاک و صفا دارد که این آشنایی هر لحظه بیشتر شود و هر چه بیشتر شود، فضیلت و برتری آن نیز افزایش می‌یابد."],[407,"آشنایی نفس با هر نفس پست","تو یقین می‌دان که دم دم کمترست","آشنایی روح انسان با نفوس ضعیف و پست باعث می‌شود که هر لحظه این آشنایی کمتر و ضعیف‌تر شود؛ یعنی تاثیرات منفی ناشی از ارتباط با افراد نادرست، به تدریج موجب کاهش ارزش و مقام روحی انسان می‌شود."],[407,"زانک نفسش گرد علت می‌تند","معرفت را زود فاسد می‌کند","نفس انسان به خاطر دلایل مختلف دایما در حال سفر و غور و جستجوست که این باعث می‌شود شناخت و معرفت او سریعا تحت تأثیر منفی قرار گیرد و فاسد شود."],[407,"گر نخواهی دوست را فردا نفیر","دوستی با عاقل و با عقل گیر","اگر نمی‌خواهی فردا با دوستانت به خوبی رفتار کنی و دوستی و محبت را حفظ کنی، پس حالا باید از عاقل و خردمند بهره‌مند شوی و دوستی را در خود تقویت کنی."],[407,"از سموم نفس چون با علتی","هر چه گیری تو مرض را آلتی","اگر از آسیب‌های نفس اماره (خودخواهی) به وسیله‌ی علل و عوامل مختلف آگاه نشوی، هر چیزی که به دست بیاوری، تنها وسیله‌ای برای ایجاد بیماری و مشکل خواهد بود."],[407,"گر بگیری گوهری سنگی شود","ور بگیری مهر دل جنگی شود","اگر چیزی ارزشمند را به دست بیاوری، مانند یک گوهر قیمتی، همچنین می‌تواند احساسات و دل‌های مردم را به درد آورد و برانگیزد. در اینجا به تضاد بین ارزش واقعی و عواقب منفی آن اشاره شده است."],[407,"ور بگیری نکته بکری لطیف","بعد درکت گشت بی‌ذوق و کثیف","اگر نکته‌ای جدید و لطیف را بگیری، بعدا فهم تو از آن نکته بی‌همه‌چیز و بی‌ذوق خواهد شد."],[407,"که من این را بس شنیدم کهنه شد","چیز دیگر گو به جز آن ای عضد","من این موضوع را بسیار شنیدم و اکنون تکراری و کهنه شده است. پس تو موضوعی تازه بگو، غیر از این که من می‌دانم."],[407,"چیز دیگر تازه و نو گفته گیر","باز فردا زان شوی سیر و نفیر","چیز دیگری را تازه و جدید یاد بگیر، چرا که فردا از این مطالب قدیم خسته و بی‌علاقه خواهی شد."],[407,"دفع علت کن چو علت خو شود","هرحدیثی کهنه پیشت نو شود","هرگاه علت را از خود دور کنی و آن را دفع کنی، دیگر هر سخنی که برایت گفته شود، حتی اگر کهنه باشد، جدید و تازه به نظرت خواهد آمد."],[407,"تا که از کهنه برآرد برگ نو","بشکفاند کهنه صد خوشه ز گو","برای آن‌که از کهنه، نو رویاند، باید دگرگونی و تحول رخ دهد تا خوشه‌های تازه‌ای از دل کهنه‌ها جوانه بزند."],[407,"ما طبیبانیم شاگردان حق","بحر قلزم دید ما را فانفلق","ما پزشکانی هستیم که شاگردان حق هستیم و دریای علم و معرفت (معنوی) را دیده‌ایم. ما به مانند دریا، عمیق و وسیع هستیم و به همین دلیل، از هم می‌شکافیم و به آگاهی‌های نوین دست می‌یابیم."],[407,"آن طبیبان طبیعت دیگرند","که به دل از راه نبضی بنگرند","طبیبان واقعی، افرادی هستند که به روح و دل انسان‌ها توجه می‌کنند و به جای بررسی جزئیات ظاهری آن‌ها، از احوال درونی و احساساتشان آگاه می‌شوند."],[407,"ما به دل بی واسطه خوش بنگریم","کز فراست ما به عالی منظریم","ما با دل خود به‌طور مستقیم و بدون واسطه چیزهای زیبا و عالی را می‌بینیم، زیرا با هوش و درک عمیق خود، به چیزی بسیار والاتر نگاه می‌کنیم."],[407,"آن طبیبان غذااند و ثمار","جان حیوانی بدیشان استوار","طبیبان به معنای پزشکان یا معلمانی هستند که روح و جان انسان را تغذیه می‌کنند و آنچه که به روح انسان قوت و استحکام می‌بخشد، میوه‌ها و مواد غذایی روحی و معنوی است."],[407,"ما طبیبان فعالیم و مقال","ملهم ما پرتو نور جلال","ما پزشکانی هستیم که با اعمال و رفتار خود به درمان و تربیت دیگران می‌پردازیم و سخنان ما از منبع الهام و روشنی بهره‌مند است."],[407,"کین چنین فعلی ترا نافع بود","و آنچنان فعلی ز ره قاطع بود","این‌گونه کارها و رفتارهای درست برای تو سودمند هستند، اما بعضی از فعالیت‌ها و رفتارهای نادرست و قطع رابطه‌ات با حق زیان‌آورند."],[407,"اینچنین قولی ترا پیش آورد","و آنچنان قولی ترا نیش آورد","این نوع سخن به تو فایده می‌رساند، اما سخن دیگر برای تو دردسر و آسیب به همراه دارد."],[407,"آن طبیبان را بود بولی دلیل","وین دلیل ما بود وحی جلیل","طبیبان هنگامی که علت بیماری را می‌فهمند، با دلایلی قوی قضاوت می‌کنند، اما دلیل ما، که از آن به وحی بزرگ یاد می‌شود، ریشه‌ای عمیق‌تر و معنوی‌تر دارد."],[407,"دست‌مزدی می نخواهیم از کسی","دست‌مزد ما رسد از حق بسی","ما از کسی پاداش یا مزدی نمی‌خواهیم، پاداش واقعی ما از خداوند بسیار بیشتر است."],[407,"هین صلا بیماری ناسور را","داروی ما یک بیک رنجور را","ما به سرعت به بیماری‌های سخت و مهلک (ناطور) می‌پردازیم و دارویی که داریم، برای نجات یک شخص رنجور و دردمند است."],[408,"قوم گفتند ای گروه مدعی","کو گواه علم طب و نافعی","قوم گفتند: ای کسانی که مدعی‌اید، نشانه‌ای از علم پزشکی و سودمندی آن کجاست؟"],[408,"چون شما بسته همین خواب و خورید","همچو ما باشید در ده می‌چرید","شما همواره در خواب و خوش‌گذرانید و مثل ما در دنیا سرگردان و بی‌هدف خواهید بود."],[408,"چون شما در دام این آب و گلید","کی شما صیاد سیمرغ دلید","شما که در این دنیا و ظواهر آن گرفتارید، چگونه می‌توانید به جست‌وجوی حقیقتی والا و روحانی مانند سیمرغ (نماد کمال و حقیقت) بپردازید؟"],[408,"حب جاه و سروری دارد بر آن","که شمارد خویش از پیغامبران","کسی که به مقام و شهرت علاقه‌مند است، خود را از جمله پیامبران می‌داند و به جایگاه والای آنها می‌بالد."],[408,"ما نخواهیم این چنین لاف و دروغ","کردن اندر گوش و افتادن بدوغ","ما نمی‌خواهیم که این‌گونه دروغ بگوییم و خود را بزرگ‌تر از آنچه که هستیم نشان دهیم و در دل دیگران بی‌احترامی کنیم."],[408,"انبیا گفتند کین زان علتست","مایه کوری حجاب ریتست","پیامبران (انبیا) گفتند که علت این قضاوت نادرست شما به خاطر نادانی‌تان است و این جهل، حجاب و مانعی بر روی حقیقت قرار داده است."],[408,"دعوی ما را شنیدیت و شما","می‌نبینید این گهر در دست ما","شما ادعای ما را شنیده‌اید، اما هنوز نمی‌توانید این گوهر را که در دستان ماست ببینید."],[408,"امتحانست این گهر مر خلق را","ماش گردانیم گرد چشمها","این گوهر (ایمان یا حقیقت) امتحانی است برای مردم، تا ما بتوانیم آن را در دل‌ها ببینیم و نه تنها در چشم‌ها، بلکه با چشمان باطن نیز درک کنیم."],[408,"هر که گوید کو گوا گفتش گواست","کو نمی‌بیند گهر حبس عماست","هر کس بگوید که چرا گواهی (بر معجزات) وجود ندارد، او خود بی‌خبر است. زیرا کسی که حقیقت را نمی‌بیند، در حجاب جهل و نادانی است."],[408,"آفتابی در سخن آمد که خیز","که بر آمد روز بر جه کم ستیز","در این جا، خورشید به عنوان نماد حقیقت و روشنایی سخن می‌گوید و از انسان‌ها می‌خواهد که بیدار شوند و به سوی حقیقت بروند، زیرا روز (حقیقت) سررسیده و نباید در برابر آن مقاومت کرد."],[408,"تو بگویی آفتابا کو گواه","گویدت ای کور از حق دیده خواه","مولانا به افرادی که در جستجوی نشانه‌های واضح از حقیقت هستند، می‌گوید که اگر می‌پرسند \"آفتاب\" کجاست، در واقع باید به حقیقت و معرفت با دیده دل بنگرند، چرا که فرد کور نمی‌تواند حقیقت را ببیند و باید به دنبال بینایی واقعی باشد."],[408,"روز روشن هر که او جوید چراغ","عین جستن کوریش دارد بلاغ","کسی که در روز روشن به دنبال چراغ می‌گردد، نشان‌دهنده نادانی اوست که حتی در روشنایی نمی‌تواند حقیقت را ببیند و به حقیقت دست یابد."],[408,"ور نمی‌بینی گمانی برده‌ای","که صباحست و تو اندر پرده‌ای","اگر نمی‌بینی، به این معنی است که تو به پیش‌آمدی گمان برده‌ای که این صبح است، در حالی که تو در پرده و پوشش قرار داری و حقیقت را نمی‌بینی."],[408,"کوری خود را مکن زین گفت فاش","خامش و در انتظار فضل باش","خودت را نسبت به حقیقت‌ها کور نکن و از گفتن بی‌فایده پرهیز کن؛ در عوض، در انتظار بخشش و لطف خداوند باش."],[408,"در میان روز گفتن روز کو","خویش رسوا کردنست ای روزجو","گفتن درباره روز، در وسط روز، باعث رسوایی خود شخص است، ای کسی که به دنبال روز(روشنی و حقیقت) هستی."],[408,"صبر و خاموشی جذوب رحمتست","وین نشان جستن نشان علتست","صبر و سکوت موجب جلب رحمت الهی است، اما طلب کردن و نشان جست‌وجو کردن، نشان از دلیل و علت دارد."],[408,"انصتوا بپذیر تا بر جان تو","آید از جانان جزای انصتوا","سکوت کن و بپذیر تا از طرف معشوق، پاداش این سکوت بر جان تو نازل شود."],[408,"گر نخواهی نکس پیش این طبیب","بر زمین زن زر و سر را ای لبیب","اگر نمی‌خواهی که کسی پیش این درمانگر بیاید، پس تو ثروت و مقام و زندگی‌ات را بر زمین بگذار، ای عالم."],[408,"گفت افزون را تو بفروش و بخر","بذل جان و بذل جاه و بذل زر","اگر می‌خواهی بیشتر از آنچه که داری داشته باشی، باید جان و مقام و مال خود را برای دیگران ببخشی و خرید و فروش کنی."],[408,"تا ثنای تو بگوید فضل هو","که حسد آرد فلک بر جاه تو","تا زمانی که ستایش تو را نعمت بزرگ الهی بداند، آسمان نیز به جاه و مقام تو حسد خواهد ورزید."],[408,"چون طبیبان را نگه دارید دل","خود ببینید و شوید ازخود خجل","هرگاه طبیبان را می‌نگرید، دل خودتان را هم نگاه کنید و خجالت بکشید از آن چه در درون شما می‌گذرد."],[408,"دفع این کوری بدست خلق نیست","لیک اکرام طبیبان از هدیست","تغییر این نابینایی به دست مردم نیست، بلکه احترام به پیامبران و راهنمایان الهی از هدایت و نعمت‌های خداوند است."],[408,"این طبیبان را به جان بنده شوید","تا به مشک و عنبر آکنده شوید","این پزشکان را با احترام و با جان خود بپذیرید تا شما نیز به خوشبوئی و عطر مشک و عنبر آراسته شوید."],[409,"قوم گفتند این همه زرقست و مکر","کی خدا نایب کند از زید و بکر","قوم گفتند این همه عوام فریبی و نیرنگ است، آیا ممکن است خداوند کسی مثل زید و بکر را به عنوان نماینده خود انتخاب کند؟"],[409,"هر رسول شاه باید جنس او","آب و گل کو خالق افلاک کو","هر پیامبر باید از نژادی باشد که از آب و گل آفریده شده، همان‌طور که خالق آسمان‌ها و زمین نیز از این عناصر ساخته است."],[409,"مغز خر خوردیم تا ما چون شما","پشه را داریم همراز هما","ما از مغز خر تغذیه کردیم تا به اندازه شما، پشه را هم‌نوا و دوست خود بدانیم."],[409,"کو هما کو پشه کو گل کو خدا","ز آفتاب چرخ چه بود ذره را","در این بیت، شاعر از افراد و موجودات مختلف می‌پرسد که چه نسبت و پیوندی بین آنها وجود دارد. او به دنبال درک ارتباط چیزهای مختلف مانند هما (پرنده‌ای افسانه‌ای)، پشه، گل و خداوند است و به این نکته اشاره دارد که همه اینها در مقایسه با آفتاب یا چرخ (دایره عالم) در چه جایگاهی قرار دارند. در واقع، اشاره به زندگی و وجود در میان مسائلی عمیق و هستی‌شناسانه دارد."],[409,"این چه نسبت این چه پیوندی بود","تاکه در عقل و دماغی در رود","این چه ارتباط و وابستگی عجیبی است که در عقل و ذهن ایجاد می‌شود."],[410,"این بدان ماند که خرگوشی بگفت","من رسول ماهم و با ماه جفت","این همانند آن است که خرگوشی گفت من پیام‌آور ماه هستم و با ماه هم‌جفت هستم."],[410,"کز رمه پیلان بر آن چشمه زلال","جمله نخجیران بدند اندر وبال","از گروه فیل‌ها، همه شکارچیان (خرگوشان) به آن چشمه زلال روی آوردند و در خطر افتادند."],[410,"جمله محروم و ز خوف از چشمه دور","حیله‌ای کردند چون کم بود زور","همه خرگوش‌ها به خاطر ترس از چشمه، که به آن نزدیک نشوند، حیله‌ای ترتیب دادند زیرا خود را ضعیف می‌دیدند و نمی‌توانستند به آنجا بروند."],[410,"از سر که بانگ زد خرگوش زال","سوی پیلان در شب غره هلال","خرگوش زال از دور برای پیلان صدا می‌زند، او در شب روشن ماه کامل (هلال) این کار را انجام می‌دهد."],[410,"که بیا رابع عشر ای شاه‌پیل","تا درون چشمه یابی این دلیل","خرگوش به شاه‌پیل می‌گوید که بیا و در سیزدهمین روز ماه، دلیل حذر از این چشمه را ببین."],[410,"شاه‌پیلا من رسولم پیش بیست","بر رسولان بند و زجر و خشم نیست","پیل بزرگ (شاه‌پیل) به خرگوشی که خود را پیام‌آور معرفی کرده، می‌گوید که من اکنون به عنوان نماینده فرستاده شده‌ام و در این مورد نیازی به تهدید و خشونت علیه پیام‌آوران نیست."],[410,"ماه می‌گوید که ای پیلان روید","چشمه آن ماست زین یکسو شوید","ماه به پیلان می‌گوید که به آن طرف بروید، زیرا چشمه‌ای که در آنجا وجود دارد، آب ماست. پس از این چشمه دور شوید."],[410,"ورنه منتان کور گردانم ستم","گفتم از گردن برون انداختم","اگر شما به هشدار من توجه نکنید، من شما را به نابینایی و بی‌اطلاعی دچار می‌کنم. من قبلا در برابر شما اعلام کردم که باید از خطر دوری کنید."],[410,"ترک این چشمه بگویید و روید","تا ز زخم تیغ مه ایمن شوید","به خرگوشان گفته می‌شود که از این چشمه دوری کنید و به جای دیگری بروید تا از آسیب تیغ ستاره‌ای معروف، که به ماه تشبیه شده، در امان بمانید."],[410,"نک نشان آنست کاندر چشمه ماه","مضطرب گردد ز پیل آب‌خواه","نشان این است که وقتی ماه به چشمه می‌آید، از ترس پیل (فیل) که آب می‌خواهد، نگران و مضطرب می‌شود."],[410,"آن فلان شب حاضر آ ای شاه‌پیل","تا درون چشمه یابی زین دلیل","در آن شب خاص، ای شاه‌پیل، بیا تا درون چشمه بروی و از این دلیل (خطر) آگاه شوی."],[410,"چونک هفت و هشت از مه بگذرید","شاه‌پیل آمد ز چشمه می‌چرید","وقتی که سپیده‌دمان (سحر) و صبح (هفت و هشت) از آسمان گذشت، شاه‌پیل از کنار چشمه عبور کرد و به چشمه نزدیک شد تا آب بنوشد."],[410,"چونک زد خرطوم پیل آن شب درآب","مضطرب شد آب ومه کرد اضطراب","وقتی که پیل خرطومش را به آب زد، آب به شدت به هم ریخت و به هم خورد."],[410,"پیل باور کرد از وی آن خطاب","چون درون چشمه مه کرد اضطراب","پیل به سخنان خرگوش ایمان آورد و با توجه به اضطرابی که در آب چشمه ایجاد شده بود، حرف او را پذیرفت."],[410,"مانه زان پیلان گولیم ای گروه","که اضطراب ماه آردمان شکوه","ای گروه، از آن پیلان که به ما دروغ می‌گویند، خالی باشید، چون اضطراب و تشویش ما را به شکایت وادار می‌کند."],[410,"انبیا گفتند آوه پند جان","سخت‌تر کرد ای سفیهان بندتان","پیامبران به شما هشدار دادند، اما شما در برابر این نصیحت‌ها بی‌توجهی کردید و به سختی و نادانی ادامه می‌دهید."],[411,"ای دریغا که دوا در رنجتان","گشت زهر قهر جان آهنجتان","ای کاش که درمان درد شما، تبدیل به زهر خشم خدا شده و جانتان را دچار درد و عذاب کرده است."],[411,"ظلمت افزود این چراغ آن چشم را","چون خدا بگماشت پرده خشم را","این بیت بیان می‌کند که خداوند با قراردادن پرده خشم بر چشمان انسان، نور و روشنی را در زندگی او کمتر کرده است. به این معنا که ناپاکی و ظلمت با خشم و غضب خداوند بیشتر می‌شود و در نتیجه، بینایی و بصیرت انسان کاهش می‌یابد."],[411,"چه رئیسی جست خواهیم از شما","که ریاستمان فزونست از سما","ما از شما چه رئیسی می‌طلبیم در حالی که خودمان مقام و ریاستمان از آسمان نیز بلندتر است؟"],[411,"چه شرف یابد ز کشتی بحر در","خاصه کشتیی ز سرگین گشته پر","کشتی‌ای که در دریای بزرگ هست، به خاطر سطح خاص خود و گندیدگی‌اش، چگونه می‌تواند شرافتی پیدا کند؟ این اشاره به این است که ظواهر و ویژگی‌های ناپسند، نمی‌توانند به مقام و موقعیت ارزشمند افزوده‌ای برسند."],[411,"ای دریغ آن دیده کور و کبود","آفتابی اندرو ذره نمود","ای کاش آن چشم کور و نابینا نمی‌توانست زیبایی و نور خورشید را ببیند، چرا که در اینجا فقط ذره‌ای از نور و زیبایی نمایان است."],[411,"ز آدمی که بود بی مثل و ندید","دیده ابلیس جز طینی ندید","انسانی که بی‌همتا و خاص است، فقط به دلیل آلودگی و گناه، چشم ابلیس که نماد شر است، چیزی جز کثافت و زشتی نمی‌بیند."],[411,"چشم دیوانه بهارش دی نمود","زان طرف جنبید کو را خانه بود","چشم دیوانه، نشانه‌ای از بی‌خود شدن و شیدایی را در بهار می‌بیند، و این نشانه، به دلیل تحرک و جنبش آن طرفی است که متعلق به اوست. یعنی شخص دیوانه (شاید به سمبل دیوانگی و عشق اشاره داشته باشد) از آن محیط و فضایی که به او تعلق دارد، آثاری از زندگی و نشاط می‌بیند."],[411,"ای بسا دولت که آید گاه گاه","پیش بی‌دولت بگردد او ز راه","بسیاری از خوشبختی‌ها و نعمت‌ها گاهی به سراغ انسان می‌آیند، ولی اگر کسی بی‌نصیب و فقیر باشد، به‌سادگی از آن‌ها دور می‌شود و نمی‌تواند از آن نعمت‌ها بهره‌مند شود."],[411,"ای بسا معشوق کاید ناشناخت","پیش بدبختی نداند عشق باخت","بسیاری از معشوق‌ها به سوی کسانی که شناخته نمی‌شوند می‌آیند، اما افراد بدبخت نمی‌دانند که عشق باعث از دست رفتن شانس و فرصت‌ها می‌شود."],[411,"این غلط‌ده دیده را حرمان ماست","وین مقلب قلب را سؤ القضاست","این اشتباه گرفتن و قضاوت نادرست بر ما تحمیل شده و این تغییر حالت قلب، نشان‌دهنده بدی تقدیر است."],[411,"چون بت سنگین شما را قبله شد","لعنت و کوری شما را ظله شد","وقتی که شما، ای بت سنگین، به عنوان قبله (هدف عبادت) قرار گرفتید، پس لعنت و نادانی شما هم به دنبال آن خواهد آمد."],[411,"چون بشاید سنگتان انباز حق","چون نشاید عقل و جان همراز حق","وقتی سنگ شما شایسته دوستی با حق است، در آن صورت عقل و جان شما نیز شایسته همراهی با حق نمی‌باشند."],[411,"پشه مرده هما را شد شریک","چون نشاید زنده همراز ملیک","پشه مرده به هما که پرنده‌ای بزرگ و نشانه شاهانه است، پیوسته است، اما چگونه می‌شود که موجودی مرده بتواند با موجود زنده‌ای که نماد بزرگی و سلطنت است، هم‌نشین باشد؟"],[411,"یا مگر مرده تراشیده شماست","پشه زنده تراشیده خداست","شاید موجود مرده‌ای که شما به آن اشاره می‌کنید، ساخته‌ی دست خود شماست، اما پشه‌ای که زنده است، آفریده‌ی خداوند است."],[411,"عاشق خویشید و صنعت‌کرد خویش","دم ماران را سر مارست کیش","شما عاشق خودتان هستید و بر طبق هنر خودتان عمل می‌کنید؛ بنابراین دم ماران (یعنی خطرها و دشواری‌ها) به ترفند شما، به سرعت مؤثر می‌شود و به منحرف کردن شما ادامه می‌دهد."],[411,"نه در آن دم دولتی و نعمتی","نه در آن سر راحتی و لذتی","در آن حال، هیچ‌گونه قدرت، نعمت، راحتی یا لذتی وجود ندارد."],[411,"گرد سر گردان بود آن دم مار","لایق‌اند و درخورند آن هر دو یار","در آن زمان، مار دور سر می‌چرخید و هر دو دوست شایسته و سزاوار او بودند."],[411,"آنچنان گوید حکیم غزنوی","در الهی‌نامه گر خوش بشنوی","حکیم غزنوی (عطار نیشابوری) در کتاب الهی‌نامه چیزی می‌گوید که اگر با دقت و خوش‌ذوقی بشنوی، نکات عمیق و ارزشمندی در آن نهفته است."],[411,"کم فضولی کن تو در حکم قدر","درخور آمد شخص خر با گوش خر","بیش از اندازه در کار قضا و سرنوشت دخالت نکن، زیرا هر چیزی با توجه به ویژگی‌های خود در جایگاه مناسبش قرار می‌گیرد، مانند اینکه فریاد کردن یک خر به اندازه‌ی خودش است و بس."],[411,"شد مناسب عضوها و ابدانها","شد مناسب وصفها با جانها","مناسبت و تناسب در میان اعضای بدن و جسم وجود دارد، همان‌طور که اوصاف و ویژگی‌ها با نفس و روح هر انسانی سازگاری دارد."],[411,"وصف هر جانی تناسب باشدش","بی گمان با جان که حق بتراشدش","هر صفت و ویژگی که برای یک جان وجود دارد، بی‌تردید باید با ذات و ماهیت آن جان همخوانی داشته باشد، چرا که خداوند این هماهنگی را در آن شکل داده است."],[411,"چون صفت با جان قرین کردست او","پس مناسب دانش همچون چشم و رو","این بیت می‌گوید که زمانی که ویژگی‌ها با جان انسان آمیخته می‌شود، در نتیجه علم و دانش او نیز متناسب با آن ویژگی‌ها خواهد بود، مانند چهره و ظاهر که به هم مرتبط‌اند."],[411,"شد مناسب وصفها در خوب و زشت","شد مناسب حرفها که حق نبشت","صفات زیبا و زشت، با یکدیگر هماهنگ شده‌اند و همچنین گفتارها نیز به طوری مناسب با حق و حقیقت در آمده‌اند."],[411,"دیده و دل هست بین اصبعین","چون قلم در دست کاتب ای حسین","چشم و دل انسان مانند دو انگشت دست هستند که قلم را در دست نویسنده قرار می‌دهند، و این بدان معناست که درک و احساسات ما ابزارهای نوشتن سرنوشت و زندگی‌مان هستند. اشاره به حسین نیز می‌تواند به جایگاه و مقام او در بین مومنان و شاعران اشاره کند."],[411,"اصبع لطفست و قهر و در میان","کلک دل با قبض و بسطی زین بنان","محبت (لطف) و خشم (قهر) انسان در دل او وجود دارد و این دو با هم در میان نوشته‌های دل (چکامه‌های زندگی) به طور متناوب و متغیر جاری هستند."],[411,"ای قلم بنگر گر اجلالیستی","که میان اصبعین کیستی","ای قلم، اگر تو مقام و عظمت داری، به خود بنگر که بین دو انگشت (اصبع) چه جایگاهی داری."],[411,"جمله قصد و جنبشت زین اصبعست","فرق تو بر چار راه مجمعست","تمام اهداف و حرکات تو از این انگشت است که تو را به چهارراهی که اجتماع همه هستی در آنجاست رهنمون می‌کند."],[411,"این حروف حالهات از نسخ اوست","عزم و فسخت هم ز عزم و فسخ اوست","این حروف و کلمات که بیانگر حال و احوال تو هستند، نتیجه‌ی اراده و تقدیر خداوند است و تصمیم‌ها و تغییرات تو نیز از خواست و اراده‌ی او نشأت می‌گیرد."],[411,"جز نیاز و جز تضرع راه نیست","زین تقلب هر قلم آگاه نیست","جز دعا و درخواست و نیاز، راه دیگری وجود ندارد؛ زیرا در این دگرگونی و فریب، هیچ قلمی از حقیقت آگاه نیست."],[411,"این قلم داند ولی بر قدر خود","قدر خود پیدا کند در نیک و بد","این قلم (که به طور نمادین به علم یا قلم به معنای نوشتن اشاره دارد) می‌داند که باید به اندازه ظرفیت و ارزش خود شناخته شود، چه در کارهای نیک و چه در کارهای بد."],[411,"آنچ در خرگوش و پیل آویختند","تا ازل را با حیل آمیختند","آنچه را که در خرگوش و فیل (نمادهایی از حق و باطل) به صورت حقه و نیرنگ به هم آمیختند، به قصد ایجاد اختلاط ازلی و آغازین است."],[412,"کی رسدتان این مثلها ساختن","سوی آن درگاه پاک انداختن","کسی که به درگاه خداوند می‌رسد، نمی‌تواند به سادگی مثل‌ها و نمونه‌ها بسازد؛ بلکه باید خود را به آن مقام پاک نزدیک کند."],[412,"آن مثل آوردن آن حضرتست","که بعلم سر و جهر او آیتست","آوردن آن نمونه‌ها از ویژگی‌های آن حضرت (مقصود پیامبر یا ولی الهی) است، که علم و دانش او نشانه و آیتی از بزرگی‌اش به شمار می‌آید."],[412,"تو چه دانی سر چیزی تا تو کل","یا به زلفی یا به رخ آری مثل","تو چه می‌دانی که ماهیت یک چیز چیست، تا بتوانی آن را به زیبایی زلف یا رخساری شبیه کنی؟"],[412,"موسیی آن را عصا دید و نبود","اژدها بد سر او لب می‌گشود","موسی (پیامبر) وقتی عصای خود را به زمین انداخت، تصور کرد که اژدهایی در آن است، اما در حقیقت هیچ چیزی وجود نداشت. در نتیجه خداوند به او آگاه کرد که این فقط یک تصور بود و او می‌تواند از قدرت خود به درستی استفاده کند."],[412,"چون چنان شاهی نداند سر چوب","تو چه دانی سر این دام و حبوب","زمانی که یک پادشاه مانند موسی نتواند راز چوبی را درک کند، تو چگونه می‌توانی راز این حیوانات و غذا ها را درک کنی؟"],[412,"چون غلط شد چشم موسی در مثل","چون کند موشی فضولی مدخل","وقتی چشم موسی (پیامبر) در دیدگاه و تشبیه دچار اشتباه شد، مانند موشی کنجکاو و فضول وارد می‌شود."],[412,"آن مثالت را چو اژدرها کند","تا به پاسخ جزو جزوت بر کند","وقتی مثال تو مانند اژدها می‌شود، می‌تواند جزئیات و عناصر کوچک را به‌راحتی از هم جدا کند و به پاسخ برسد."],[412,"این مثال آورد ابلیس لعین","تا که شد ملعون حق تا یوم دین","ابلیس لعین (شیاطین و وسوسه‌کننده) به عنوان مثال آورده شده تا نشان دهد که او نیز به سبب نافرمانی‌اش از خدا، ملعون شده و تا روز قیامت در لعنت و نفرین خواهد ماند."],[412,"این مثال آورد قارون از لجاج","تا فرو شد در زمین با تخت و تاج","قارون، که به خاطر لجاجت و کبرش مثال آورده شده، به خاطر خواسته‌هایش و طغیانش، به زمین فرو رفت و با تمام قدرت و ثروتش، نابود شد."],[412,"این مثالت را چو زاغ و بوم دان","که ازیشان پست شد صد خاندان","این مثال را به زاغ و بوم (نوعی پرنده) تشبیه کن که به خاطر کردارهای ناپسندشان، از بین رفته و نسل‌های بسیاری را به نابودی کشانده‌اند."],[413,"نوح اندر بادیه کشتی بساخت","صد مثل‌گو از پی تسخیر بتاخت","نوح در بیابان کشتی‌ای ساخت و صد نفر که مانند او نادان بودند، به او می‌خندیدند و به تمسخر به او حمله کردند."],[413,"در بیابانی که چاه آب نیست","می‌کند کشتی چه نادان و ابلهیست","در بیابانی که هیچ آبی نیست و نمی‌توان کشتی را استفاده کرد، چه نادان و احمق است کسی که در آنجا کشتی می‌سازد."],[413,"آن یکی می‌گفت ای کشتی بتاز","و آن یکی می‌گفت پرش هم بساز","یکی از آن‌ها می‌گفت که کشتی را ساخته و آماده کن و بران آن، و دیگری می‌گفت برای آن، بادبان هم بساز."],[413,"او همی‌گفت این به فرمان خداست","این بچربکها نخواهد گشت کاست","او (نوح) می‌گفت که این کار به دستور خداوند است و این کشتی به طور حتم خالی نخواهد ماند و از آن بهره‌برداری خواهد شد."],[414,"این مثل بشنو که شب دزدی عنید","در بن دیوار حفره می‌برید","مثل این است که در شب، دزدی بدذات در زیر دیوار جایی را حفر می‌کند."],[414,"نیم‌بیداری که او رنجور بود","طقطق آهسته‌اش را می‌شنود","نیمه‌شب، شخصی که در حال خواب و خواب‌آلودگی است، صدای آهسته‌ی ضربه‌های دزد را می‌شنود و از رنجی که دارد، آگاهی می‌یابد."],[414,"رفت بر بام و فرو آویخت سر","گفت او را در چه کاری ای پدر","شخصی به بالای بام رفت و سرش را پایین آورد و از او پرسید: «ای پدر، در چه کاری هستی؟"],[414,"خیر باشد نیمشب چه می‌کنی","تو کیی گفتا دهل‌زن ای سنی","پرسیدند نیمه شب چه کار می‌کنی، او پاسخ داد که من دهل‌زن هستم و تو کیستی که این سؤال را می‌کنی."],[414,"در چه کاری گفت می‌کوبم دهل","گفت کو بانگ دهل ای بوسبل","او در پاسخ به این سوال که در چه کار هستی می‌گوید به زدن دهل مشغولم. پرسش‌کننده از او می‌خواهد صدای دهل را بشنود و او را با نام «بوسبل» خطاب می‌کند که به احتمال زیاد نامی برای اوست."],[414,"گفت فردا بشنوی این بانگ را","نعره یا حسرتا وا ویلتا","گفت فردا صدای این دهل را خواهی شنید که یا صدای نعره است یا حسرت و آه و واویلای اهل درد و اندوه."],[414,"آن دروغست و کژ و بر ساخته","سر آن کژ را تو هم نشناخته","این حرفی که می‌زند دروغ و نادرست و ساختگی است و تو هم به علت کج‌فهمی‌ات نمی‌توانی حقیقت آن را شناسایی کنی."],[415,"سر آن خرگوش دان دیو فضول","که به پیش نفس تو آمد رسول","این خرگوش نماینده یک دیو فضول است که به عنوان پیام‌آور به پیش نفس انسان آمده است."],[415,"تا که نفس گول را محروم کرد","ز آب حیوانی که از وی خضر خورد","زمانی که نفس، یعنی خواهش‌های نفسانی، انسان را فریب داد و از آب حیات که خضر (نبی معروف) از آن نوشید محروم ساخت، انسان به بهروزی و زندگی جاودان دست نخواهد یافت."],[415,"بازگونه کرده‌ای معنیش را","کفر گفتی مستعد شو نیش را","تو معنی کفر را به گونه‌ای بازجسته‌ای که اگر مستعد باشی، آسیب می‌زنی."],[415,"اضطراب ماه گفتی در زلال","که بترسانید پیلان را شغال","باید گفت که شغال، در تعبیر از اضطراب و نگرانی ماه، به پیلان (فیل‌ها) می‌گوید که در آبی زلال، ممکن است دچار ترس و وحشت شوند. ماه به عنوان یک منبع ناپایدار، می‌تواند باعث هراس فیل‌ها شود."],[415,"قصه خرگوش و پیل آری و آب","خشیت پیلان ز مه در اضطراب","ماجرای خرگوش و فیل به نوعی اشاره به ترس و وحشت فیل‌ها از خرگوش دارد، در حالی که این ترس به نوعی از اثرات ماه و زیبایی آن نشأت می‌گیرد و به اضطراب فیل‌ها در برابر این ترسیدن اشاره دارد."],[415,"این چه ماند آخر ای کوران خام","با مهی که شد زبونش خاص و عام","ای نادانان و کورها، به چه دلیلی همچنان بی‌خبر و خام هستید، در حالی که این ماه (مه) که منبع روشنی و زیبایی است، اکنون به خاطر ارتباطی که با همه دارد، به شکلی خوار و زبون در آمده است؟"],[415,"چه مه و چه آفتاب و چه فلک","چه عقول و چه نفوس و چه ملک","این‌ها همه نشانه‌هایی از حقیقت هستند و درک معنای آن‌ها وابسته به درک عینیت و واقعیت وجود است؛ یعنی نه ماه و نه آفتاب و نه دیگر موجودات و اندیشه‌ها مستقل از حقیقت هستند."],[415,"آفتاب آفتاب آفتاب","این چه می‌گویم مگر هستم بخواب","منظور این است که گوینده مرتبا بر نور آفتاب تأکید می‌کند و در عین حال به خود یادآوری می‌کند که آیا در خواب است و این حقیقت را به درستی درک نمی‌کند. این نشان می‌دهد که شاید او در فهم واقعیت دچار غفلت شده است."],[415,"صد هزاران شهر را خشم شهان","سرنگون کردست ای بد گم‌رهان","خشم پادشاهان و حکام، باعث ویرانی و نابودی صدها هزار شهر شده است، ای افرادی که در گمراهی به سر می‌برید."],[415,"کوه بر خود می‌شکافد صد شکاف","آفتابی از کسوفش در شغاف","کوه به خاطر شدت خشم و نابودی چیزی، به شدت دچار شکست و ترک می‌شود و این ترک‌ها به مانند آفتابی می‌تابند که از کسوف (خورشیدگرفتگی) ناشی شده و به اعماق کوه نفوذ کرده است."],[415,"خشم مردان خشک گرداند سحاب","خشم دلها کرد عالمها خراب","خشم مردان خشک، باران را قطره‌قطره و کنترل‌شده می‌سازد و در نتیجه، خشم دل‌ها باعث خرابی و نابودی دنیا می‌شود."],[415,"بنگرید ای مردگان بی حنوط","در سیاستگاه شهرستان لوط","ای مردان بی‌خبر و مرده‌دل، دقت کنید در اوضاع و احوال شهر لوط که پر از فساد و گناه است."],[415,"پیل خود چه بود که سه مرغ پران","کوفتند آن پیلکان را استخوان","چه چیز است این فیل که سه مرغ پرنده به آن حمله کردند و استخوانش را شکستند؟"],[415,"اضعف مرغان ابابیلست و او","پیل را بدرید و نپذیرد رفو","مرغان ابابیل از آنجا که ضعیف‌ترند، نمی‌توانند با پیل بدرازند و او را در چنگال بگیرند، و به همین دلیل نمی‌توانند او را اصلاح کنند یا حمایت کنند."],[415,"کیست کو نشنید آن طوفان نوح","یا مصاف لشکر فرعون و روح","کیست که خبر طوفان نوح یا جنگ لشکر فرعون و روح را نشنیده باشد؟"],[415,"روحشان بشکست و اندر آب ریخت","ذره ذره آبشان بر می‌گسیخت","روح آن‌ها از ترس و شدت وحشت شکست و به طور تدریجی، وجودشان مانند قطرات آب به زمین می‌ریخت و از هم متلاشی می‌شد."],[415,"کیست کو نشنید احوال ثمود","و آنک صرصر عادیان را می‌ربود","کیست که خبر احوال قوم ثمود را نشنیده باشد و نداند که چگونه باد سخت (صرصر) عادت‌زده‌ها را می‌برد؟"],[415,"چشم باری در چنان پیلان گشا","که بدندی پیل‌کش اندر وغا","چشمی باز کن تا ببینی که چگونه آن فیل‌ها (که نماد قدرت و عظمت هستند) در جنگ و نزاع در حال جنب و جوش‌اند، یعنی در این مسیر و در چنین موقعیتی، قدرت به تنهایی نمی‌تواند راهگشا باشد."],[415,"آنچنان پیلان و شاهان ظلوم","زیر خشم دل همیشه در رجوم","پیل‌ها و پادشاهان ظالم، همیشه زیر خشم و کینه‌ی دل در سنگ‌دلی و بدخواهی باقی‌ مانده‌اند و از عذاب و قهری که بر سر آنان نازل می‌شود، در امنیت نیستند."],[415,"تا ابد از ظلمتی در ظلمتی","می‌روند و نیست غوثی رحمتی","افراد ظالم و ستمگر همیشه در تاریکی و ناامیدی باقی می‌مانند و هیچ امداد و رحمتی شامل حالشان نمی‌شود."],[415,"نام نیک و بد مگر نشنیده‌اید","جمله دیدند و شما نادیده‌اید","آیا نام‌های نیک و بد را نشنیده‌اید؟ همه چیز را دیده‌اند، اما شما هنوز آنها را نادیده گرفته‌اید."],[415,"دیده را نادیده می‌آرید لیک","چشمتان را وا گشاید مرگ نیک","شما چیزهایی را که باید ببینید نادیده می‌گیرید، اما در هنگام مرگ، چشمانتان به حقیقت باز خواهد شد و حقایق را خواهید دید."],[415,"گیر عالم پر بود خورشید و نور","چون روی در ظلمتی مانند گور","عالم پر از نور و روشنایی است، مانند خورشید، اما اگر کسی در ظلمت و تاریکی باشد، مانند گوری که در آن نمی‌تواند روشنی را ببیند."],[415,"بی نصیب آیی از آن نور عظیم","بسته‌روزن باشی از ماه کریم","اگر از آن نور بزرگ و درخشان بی‌نصیب بمانی، مانند کسی هستی که در فضای بسته و تاریک قرار دارد و نمی‌تواند از نور ماه کریم (طلوع ماه) استفاده کند. در این حالت، تو نمی‌توانی از نعمت‌های خیر و روشنایی بهره‌مند شوی."],[415,"تو درون چاه رفتستی ز کاخ","چه گنه دارد جهانهای فراخ","تو در چاهی که تاریک و عمیق است، به سر می‌بری، در حالی که از کاخ‌های بزرگ و زیبا به دور هستی. این حالت تو چه اشکالی دارد در مقایسه با جهان‌های وسیع و پرنعمت که می‌توانی در آن‌ها زندگی کنی؟"],[415,"جان که اندر وصف گرگی ماند او","چون ببیند روی یوسف را بگو","چون کسی که وصف گرگ را می‌داند، وقتی روی یوسف (زیبایی یوسف) را ببیند، دگرگون می‌شود و نمی‌تواند به وصف آن ادامه دهد."],[415,"لحن داودی به سنگ و که رسید","گوش آن سنگین دلانش کم شنید","وقتی صدای خوش داوود به سنگ‌ها می‌رسید، گوش سنگین دلان به خوبی آن را نمی‌شنید. این به این معناست که افرادی که دل‌هایشان سخت و بی‌حس شده، قادر به درک زیبایی‌ها و پیام‌ها نیستند."],[415,"آفرین بر عقل و بر انصاف باد","هر زمان والله اعلم بالرشاد","ستایش و تحسین بر عقل و انصاف شایسته است، و تنها خداوند از راه راست باخبر است."],[415,"صدقوا رسلا کراما یا سبا","صدقوا روحا سباها من سبا","پیامبران راستگویی که از سبأ آمده‌اند، همانند روحی هستند که به آنها زندگی و حیات می‌بخشد. سبأ، به عنوان سرزمینی مهم و نمادین در اینجا اشاره به اعتقادات و پیام‌های الهی دارد."],[415,"صدقوهم هم شموس طالعه","یومنوکم من مخازی القارعه","اینان به آنها (پیامبران) ایمان آورید، زیرا آنان مانند خورشیدهای درخشان هستند که شما را از بلاهای درنده‌ای که شما را تهدید می‌کند، آگاه می‌سازند."],[415,"صدقوهم هم بدور زاهره","قبل ان یلقوکم بالساهره","آن‌ها را تصدیق کنید، زیرا آن‌ها درخشندگی و نور دارند، قبل از آنکه با سحر و فریب شما را ملاقات کنند."],[415,"صدقوهم هم مصابیح الدجی","اکرموهم هم مفاتیح الرجا","ایمان به آن‌ها، چون چراغ‌هایی در تاریکی است؛ با احترام به آن‌ها، کلیدهای آرزوها را خواهید داشت."],[415,"صدقوا من لیس یرجو خیرکم","لا تضلوا لا تصدوا غیرکم","کسانی که به شما خوبی و نیکی نمی‌کنند، راست نمی‌گویند و نباید از این افراد گمراه شوید و آن‌ها را دور کنید."],[415,"پارسی گوییم هین تازی بهل","هندوی آن ترک باش ای آب و گل","بیان شده که ما باید به زبان پارسی صحبت کنیم و با توجه به این نکته، نژادها و ملل دیگر هم باید در این کار از ما پیروی کنند. به طور خاص اشاره شده که حتی اگر کسی از تازی‌ها (عرب‌ها) باشد، بهتر است که به زبان پارسی بیاندیشد و تصرف نشود و به دو ملت دیگر (هندوها و ترکان) نیز اشاره شده که در این راه باید همراهی کنند."],[415,"هین گواهیهای شاهان بشنوید","بگرویدند آسمانها بگروید","به معنای این است که ای خدایان، گواهی‌هایی از سوی پادشاهان را بشنوید که آسمان‌ها به خاطر این گواهی‌ها به لرزه درآمده‌اند و به غم و اندوه افتاده‌اند."],[416,"یا به حال اولینان بنگرید","یا سوی آخر بحزمی در پرید","به حال پیشینیان نگاه کنید یا به سمت آخر که در پروا و احتیاط است."],[416,"حزم چه بود در دو تدبیر احتیاط","از دو آن گیری که دورست از خباط","حزم به معنای تدبیر و احتیاط است، و مولانا می‌گوید که احتیاط را از دو تدبیر بگیریم، زیرا آن چیزی که درست است، از نادرستی‌ها و خطرات دور خواهد بود."],[416,"آن یکی گوید درین ره هفت روز","نیست آب و هست ریگ پای‌سوز","یکی از آن‌ها می‌گوید که در این مسیر هفت روز آب نیست و تنها ریگ وجود دارد که پای را می‌سوزاند."],[416,"آن دگر گوید دروغست این بران","که بهر شب چشمه‌ای بینی روان","دیگری می‌گوید این سخن نادرست است، چون تو هر شب چشمه‌ای را می‌بینی که در حال جریان است."],[416,"حزم آن باشد که بر گیری تو آب","تا رهی از ترس و باشی بر صواب","حزم به معنی احتیاط و تدبیر است و در اینجا به این معناست که باید آب را جمع کنی تا از ترس و خطر نجات یابی و به راه درست بروی."],[416,"گر بود در راه آب این را بریز","ور نباشد وای بر مرد ستیز","اگر در مسیر آبی وجود داشته باشد، آن آب را بریزید، و اگر نباشد، وای به حال مردی که به ستیزه‌جویی و نبرد می‌پردازد."],[416,"ای خلیفه‌زادگان دادی کنید","حزم بهر روز میعادی کنید","ای فرزندان خلیفه، در روزهایی که نیاز است، احتیاط و دوراندیشی داشته باشید و در چنین روزهایی برای مخاطراتی که ممکن است پیش بیاید، آماده‌سازی کنید."],[416,"آن عدوی کز پدرتان کین کشید","سوی زندانش ز علیین کشید","آن دشمنی که به خاطر پدر شما، کینه و دشمنی به دل داشت، به سوی زندان برده شد و به مقام بالایی رسید."],[416,"آن شه شطرنج دل را مات کرد","از بهشتش سخره آفات کرد","آن پادشاهی که دل را در بازی شطرنج شکست داد، بهشتی بودنش را به وسیله بلاها به سخره گرفت."],[416,"چند جا بندش گرفت اندر نبرد","تا بکشتی در فکندش روی‌زرد","در جنگ، چندین بار او را گرفتار کرد تا اینکه سرانجام او را به زمین انداخت و رنگش زرد شد."],[416,"اینچنین کردست با آن پهلوان","سست سستش منگرید ای دیگران","این مرد پهلوان سست‌نفس را این‌گونه باطل و ناتوان کرده‌اند، پس ای دیگران، مراقب باشید و از این حالت او عبرت بگیرید."],[416,"مادر و بابای ما را آن حسود","تاج و پیرایه بچالاکی ربود","حسودهایی که به ما آسیب زدند، پدر و مادر ما را به نیرنگ و فریب از ما دور کردند و از ما دزدیدند."],[416,"کردشان آنجا برهنه و زار و خوار","سالها بگریست آدم زار زار","آدم (علیه‌السلام) آن‌ها را در آنجا برهنه و درمانده دید و سال‌ها به حال آن‌ها گریست."],[416,"که ز اشک چشم او رویید نبت","که چرا اندر جریده لاست ثبت","از اشک چشم آدم، گیاه نبت (نوعی گیاه) رشد کرد، به این معنی که چرا اسم او در کتاب حیات ثبت شده است (و باید نام او به یادگار بماند)."],[416,"تو قیاسی گیر طراریش را","که چنان سرور کند زو ریش را","به تو می‌گویم که خودت را با کسی مقایسه کن که مانند او در زندگی‌اش مایه خوشحالی و سروری برای دیگران است، به طوری که حتی ریشش هم از این خوشحالی رشد می‌کند."],[416,"الحذر ای گل‌پرستان از شرش","تیغ لا حولی زنید اندر سرش","ای گل‌پرستان، از شر آن تیغ بی‌حیا و بی‌رحم که در دست اوست، مراقب باشید و در سر او بزنید، یعنی با احتیاط رفتار کنید و مقابله کنید."],[416,"کو همی‌بیند شما را از کمین","که شما او را نمی‌بینید هین","او (صیاد) همیشه از جایی پنهانی به شما نگاه می‌کند و شما از آنجا که او را نمی‌بینید در خطر هستید، پس هوشیار باشید."],[416,"دایما صیاد ریزد دانه‌ها","دانه پیدا باشد و پنهان دغا","همواره شکارچی دانه‌ها را می‌ریزد، برخی از دانه‌ها پیدا و برخی دیگر پنهان و فریب‌آمیز هستند."],[416,"هر کجا دانه بدیدی الحذر","تا نبندد دام بر تو بال و پر","هرجا دانه‌ای (که به معنی فریب یا طمع است) دیدی، حواس‌جمع باش که مبادا دام (فریب) تو را گرفتار کند و بال و پر تو را بگیرد."],[416,"زانک مرغی کو بترک دانه کرد","دانه از صحرای بی تزویر خورد","مرغی که از دانه (غذای) دروغین و فریبنده دوری کرد، دانه‌های واقعی و سالم را از صحرا (مکان مناسب) تناول می‌کند."],[416,"هم بدان قانع شد و از دام جست","هیچ دامی پر و بالش را نبست","او نیز از آن دانه قانع شد و از دام رهایی یافت، زیرا هیچ دامی نتوانست بال و پرش را بگیرد."],[417,"باز مرغی فوق دیواری نشست","دیده سوی دانه دامی ببست","مرغی بر روی دیواری نشسته و به دانه‌ای که در دام گذاشته شده نگاه می‌کند."],[417,"یک نظر او سوی صحرا می‌کند","یک نظر حرصش به دانه می‌کشد","مرغ با یک نگاه به بیابان و آزادی توجه می‌کند و با نگاهی دیگر، حرص و ولعش به دانه و غذا او را به سمت دام می‌کشاند."],[417,"این نظر با آن نظر چالیش کرد","ناگهانی از خرد خالیش کرد","این نگاه به دانه و آن نگاه به صحرا با هم در تضاد هستند و به ناگاه عقل و خرد را از آدمی می‌گیرند."],[417,"باز مرغی کان تردد را گذاشت","زان نظر بر کند و بر صحرا گماشت","مرغی که مدام در تردید بود، تصمیم گرفت که تردید را کنار بگذارد و به جای آن، خود را به دشت و صحرا بسپارد."],[417,"شاد پرّ و بال او بـخّـا له","تا امام جمله آزادان شد او","پر و بال او با شادی و سروری، شایسته است، زیرا او امام و رهبر همه آزادگان شد."],[417,"هر که او را مقتدا سازد برست","در مقام امن و آزادی نشست","هر کس که او را به عنوان پیشوا و راهنما انتخاب کند، به مقام امن و آزادی دست می‌یابد و آرامش می‌گیرد."],[417,"زانک شاه حازمان آمد دلش","تا گلستان و چمن شد منزلش","چون پادشاه و دانایان و محتاطان به آرامش و امنیت دست پیدا کردند، دلشان به خوبی و شادی مثل گلستان و باغی پر از گل و چمن گشوده شد و آرامش گرفت."],[417,"حزم ازو راضی و او راضی ز حزم","این چنین کن گر کنی تدبیر و عزم","اگر تو با تدبیر و عزم خود را کنترل کنی، حزم (مردانگی و احتیاط) از تو راضی خواهد بود و او هم به تو راضی خواهد شد."],[417,"بارها در دام حرص افتاده‌ای","حلق خود را در بریدن داده‌ای","بارها به خاطر حرص و طمع به دام افتاده‌ای و خودت را در خطر انداخته‌ای."],[417,"بازت آن تواب لطف آزاد کرد","توبه پذرفت و شما را شاد کرد","خداوند بار دیگر به شما لطف و رحمت خود را عطا کرد و شما را از گناهانتان بخشید، پس دل‌های‌تان را شاد کرد."],[417,"گفت إن عدتم کذا عدنا کذا","نحن زوّجنا الفعال بالجزا","مولانا بیان می‌کند که خداوند می‌فرماید: اگر شما به گناه و کارهای بد بازگردید، ما نیز به عذاب و جزای شما برمی‌گردیم، اما اگر شما کارهای نیک انجام دهید، ما نیز این رفتارهای خوب را با پاداش مناسب پاسخ می‌دهیم."],[417,"چونک جفتی را بر خود آورم","آید آن را جفتش دوانه لاجرم","وقتی که من یک جفت را برای خود انتخاب کنم، آن جفت نیز جفتی دیوانه را به دنبال خود می‌آورد."],[417,"جفت کردیم این عمل را با اثر","چون رسد جفتی رسد جفتی دگر","وقتی عمل را با تأثیر آن به هم می‌زنیم، زمانی که یکی از جفت‌ها به ما می‌رسد، جفت دیگری نیز خواهد آمد."],[417,"چون رباید غارتی از جفت شوی","جفت می‌آید پس او شوی‌جوی","زمانی که تو به خاطر حرص و دلخواهی، از جفتت چیزی را بربایی، دیگر کسی به تو برنمی‌گردد و تو تنها می‌مانی."],[417,"بار دیگر سوی این دام آمدیت","خاک اندر دیده توبه زدیت","شما دوباره به دام توبه آمده‌اید، اما خاک (یعنی گناه) در چشمان شما است و نمی‌توانید آن را ببینید."],[417,"بازتان تواب بگشاد از گره","گفت هین بگریز روی این سو منه","خدا به شما مهلت جدیدی داده و راه توبه را برایتان گشوده است؛ پس هشیار باشید و دیگر به این طرف نروید و از آن دوری کنید."],[417,"باز چون پروانه نسیان رسید","جانتان را جانب آتش کشید","چون پروانه‌ای که فراموشی به سرش زده، به سوی آتش می‌رود، جان شما را نیز به سوی آتش می‌کشد."],[417,"کم کن ای پروانه نسیان و شکی","در پر سوزیده بنگر تو یکی","ای پروانه نسیان، کمی از فراموشی خود بکاه و با دقت به پر سوخته‌ات نگاه کن."],[417,"چون رهیدی شکر آن باشد که هیچ","سوی آن دانه نداری پیچ پیچ","وقتی که از نگرانی و وسوسه‌ها رهایی پیدا کردی، آن شکر (خوشحالی و رضایت) به‌دست می‌آید که دیگر به هیچ‌کس نیازی نداشته باشی و در هیچ‌کجا دنبال دانه‌ای نباشی."],[417,"تا ترا چون شکر گویی بخشد او","روزیی بی دام و بی خوف عدو","اگر تو شکر نعمت‌های خدا را به جا آوری و از او سپاسگزاری کنی، او روزی و نعمت‌هایی به تو می‌دهد که در آنها هیچ دامی وجود ندارد و از دشمنی نیز نگرانی نخواهی داشت."],[417,"شکر آن نعمت که‌تان آزاد کرد","نعمت حق را بباید یاد کرد","باید شکر نعمت را به‌جا آورد، زیرا که او شما را از قید و بند رها کرده است و این نعمت الهی را باید همواره به یاد داشت."],[417,"چند اندر رنجها و در بلا","گفتی از دامم رها ده ای خدا","چقدر در رنج‌ها و مشکلات خود شکایت کردی و از خدا خواستی که مرا از این دام رهایی بخشد."],[417,"تا چنین خدمت کنم احسان کنم","خاک اندر دیده شیطان زنم","من به این‌گونه خدمت و لطف، یعنی از خاک در چشم شیطان کردن، اقدام می‌کنم."],[418,"سگ، زمستان جمع گردد، استخوانش.","زخم سرما خرد گرداند چنانش.","مثل سگی که سرمای زمستان چنان فشار و دردی به استخوان‌هایش می‌آورد که گویا آنها در حال خرد شدن هستند."],[418,"کو بگوید، کین قدر تن—که مّنم—","خانه‌ایّ از سنگ، باید کـردنم!","او با خود می‌گوید برای تن من باارزش (تن و بعد جسمانی انسان) باید خانه‌ای از سنگ بسازم که هم پناه خوبی باشد برای من هم اینکه در شان و شخصیت من باشد."],[418,"چونک تابستان بیاید، من بچنگ","بهر سرما خانه‌ای سازم ز سنگ.","زمانی که تابستان (زمان بی‌دردی) رو به چنگ بیارم (تابستان فرارسد) برای زمستان (زمان تنگی و درد) خود خانه‌ای از سنگ بنا خواهم کرد."],[418,"چونک تابستان بیاید، از گشاد،","استخوانها پهن گردد؛ پوست، شاد.","چرا که که گرمای تابستان باعث رفع درد می‌شود، فشار زمستان را ندارد و او احساس راحتی بیشتری می‌کند."],[418,"گوید او، چون زفت بیند خویش را:","«در کدامین خانه گـنجم، ای کیا؟».","از شدت شادی و بی‌دردی انگار که زمستان وجود را فراموش کرده باشد با سرخوشی و غرور با خود می‌گوید که جهان برای من جای کوچکی‌ است و خود را به اشتباه بزرگ می‌پندارد و فکر زمستان را نمی‌کند."],[418,"زفت گردد. پا کشد در سایه‌ای.","کاهلی، سیری، غری، خودرایه‌ای،","همچون کسی که با خوشی و سرور به زیر سایه‌ای (زمان بی‌دردی) می‌رود، از تنبلی و راحت‌طلبی خود لذت می‌برد و در این وضعیت به آرامش کاذب می‌رسد."],[418,"گویدش: «دل خانه‌ای ساز ای عمو!».","گوید او: «در خانه کی گنجم؟ بگو!","صدای درون (وجدان) بهش میگه که زمستان رو فراموش نکن حال که در خوشی و آرامش هستی. و او از روی غرور و جهل می‌گوید خانه‌ای که لایق من باشد وجود ندارد، گویا که آرامش تابستان، درد استخوان‌سوز زمستان را از یاد او برده است."],[418,"استخوان حرص تو، در وقت درد،","درهم آید خرد گردد، در نورد.","کاری که زمستان با استخوان سگ می‌کند، حرص و آز و طمع با روح و روان انسان می‌کند."],[418,"گویی از توبه بسازم خانه‌ای،","در زمستان باشدم استانه‌ای،","باز در وقت درد با خود می‌گوید که توبه می‌کنم و اشتباه خود را قبول دارم و از این به بعد حرص و آز و طمع و غرور و جهل را از خود دور نگه می‌دارم."],[418,"چون بشد درد و شدت آن حرص، زفت،","همچو سگ، سودای خانه از تو رفت.","ولی مجدد وقتی که آن درد از تو دور شد، حرص و آز هم در تو باز پا گرفت و تقویت شد. مثل آن سگی که در تابستان ساختن پناه سنگی برای فرار از درد و سرمای زمستان از یادش رفت."],[418,"شکر نعمت، خوشتر از نعمت بود.","شکرباره کی سوی نعمت رود؟","سپاسگزاری و دیدن نعمت‌ها، زیباتر از خود نعمت‌هاست، چراکه داشته‌های ما را یادآودر می‌شود و ذهن را به سوی داشته‌ها سوق می‌دهد. آیا کسی می‌تواند به سوی نعمت رود در حالی که قدردانی و شکرگزاری را نادیده بگیرد؟"],[418,"شکر، جان نعمت و نعمت چو پوست؛","زآنک شکر آرد ترا تا کوی دوست.","شکر و سپاسگزاری، مغز و روح نعمت است و نعمت مانند پوست آن. چرا که شکر کردن و دیدن نعمت‌هاست که ارزش حقیقی‌ است."],[418,"نعمت آرد غفلت و شکر انتباه.","صید نعمت کن بدام شکر، شاه.","خود نعمت به تنهایی و بدون شکرگزاری غفلت و تباهی به همراه دارد، در صورتی که شکر کردن و دیدن آن بیداری و آگاهی برای انسان به بار می‌آورد. در حقیقت شکرگزاری از نعمت‌ها، مانند شکار و به دام انداختن آنهاست."],[418,"نعمت شکرت کند پر چشم و میر؛","تا کنی صد نعمت ایثار فقیر.","شکر و سپاسگزاری و دیدن نعمت‌ها به قدری تو را بی‌نیاز و ثروتمند (ثروت باطنی، رضا) می‌کند که می‌توانی از آن به صدها فقیر (ناسپاس‌ها) ببخشی. نور آگاهی و تجربه شکر خود را به آنها نشان دهی."],[418,"سیر نوشی از طعام و نقل حق؛","تا رود از تو شکم‌خواری و دق.».","آنقدر چشم‌هات باز می‌شوند و از ارزشهای حقیقی سیراب می‌شوی و اجازه می‌دهی که آنها زیبایی خودشان را به تو نشان دهند که حرص و آز و طمعی که از روی جهل و ناآگاهی بدان‌ها گرفتار بودی از تو دور خواهد شد."],[419,"قوم گفتند ای نصوحان بس بود","اینچ گفتید ار درین ده کس بود","قوم به نصوحان (راهنماها) گفتند: کافی است آنچه تاکنون گفتید، اگر در این ده (سرزمین) کسی وجود داشت."],[419,"قفل بر دلهای ما بنهاد حق","کس نداند برد بر خالق سبق","خداوند قفل‌هایی بر دل‌های ما گذاشته است که هیچ‌کس نمی‌داند چگونه این قفل‌ها را بر خالق (خدا) سبقت می‌دهد یا پیشی می‌گیرد."],[419,"نقش ما این کرد آن تصویرگر","این نخواهد شد بگفت و گو دگر","ما نقشی داریم که آن تصویرگر (خدا) برای ما تعیین کرده است و نمی‌توانیم تغییرش دهیم. در حقیقت، این مسأله قابل بحث نیست و هرگونه گفت و گو درباره‌اش بی‌فایده است."],[419,"سنگ را صد سال گویی لعل شو","کهنه را صد سال گویی باش نو","اگر سنگ را صد سال بگویی باید مانند لعل (گوهر گرانبها) شود، یا اگر چیزی کهنه است را صد سال تلاش کنی تا نو بشود، تغییر نمی‌کند و نمی‌تواند به حالت جدید در آید."],[419,"خاک را گویی صفات آب گیر","آب را گویی عسل شو یا که شیر","خاک را به گونه‌ای توصیف کن که مانند آب خاصیت جذب و نرمی داشته باشد، و آب را به گونه‌ای بگویید که شیرینی‌اش به عسل شبیه شود."],[419,"خالق افلاک او و افلاکیان","خالق آب و تراب و خاکیان","خداوند، آفریننده آسمان‌ها و ستاره‌هاست و او همچنین آفریننده آب و خاک و موجودات زمینی نیز می‌باشد."],[419,"آسمان را داد دوران و صفا","آب و گل را تیره رویی و نما","آسمان به خاطر دوران (چرخش و تغییر) خود و پاکی‌اش، مقام و فضل خاصی دارد، اما آب و گل به خاطر سرشت و شکل ظاهری‌شان، ظاهری تیره و نازیبا دارند."],[419,"کی تواند آسمان دردی گزید","کی تواند آب و گل صفوت خرید","هیچ کس نمی‌تواند آسمان را دردی تحمل کند و هیچ کس نمی‌تواند از آب و خاک پاکی را به دست آورد."],[419,"قسمتی کردست هر یک را رهی","کی کهی گردد بجهدی چون کهی","هر کس را راه و راهی مخصوص داده شده است، پس نمی‌تواند در زمانی که به سراغ او نمی‌رود، از او انتظار داشته باشید که تغییر کند یا از راه خود دور شود."],[420,"انبیا گفتند کاری آفرید","وصفهایی که نتان زان سر کشید","پیامبران گفتند خداوند کارهایی را خلق کرده که انسان نمی‌تواند از آن‌ها فرار کند و به دلیل این ویژگی‌ها و حالات مختلف، انسان‌ها ممکن است مورد تنفر قرار گیرند."],[420,"و آفرید او وصفهای عارضی","که کسی مبغوض می‌گردد رضی","خداوند صفات و ویژگی‌هایی آفرید که باعث می‌شود برخی از انسان‌ها به دیگران ناخوشایند و منفور شوند."],[420,"سنگ را گویی که زر شو بیهده‌ست","مس را گویی که زر شو راه هست","تو به سنگ بگو که طلا شود، این بیهوده است و ممکن نیست، اما به مس بگو که طلا شود، این امکان‌پذیر است."],[420,"ریگ را گویی که گل شو عاجزست","خاک را گویی که گل شو جایزست","به ریگ نمی‌توان گفت که به گل تبدیل شود، زیرا ناتوان است، اما به خاک می‌توان گفت که ممکن است به گل تبدیل شود؛ یعنی در شرایط خاص و با تغییراتی ممکن است به چیز بهتری تبدیل شود."],[420,"رنجها دادست کان را چاره نیست","آن بمثل لنگی و فطس و عمیست","رنج‌ها و مشکلاتی که بر سر راه انسان‌ها وجود دارد، راه حلی ندارد و مشابه لنگی، ناقصی و ناتوانی است که نمی‌توان درمانش کرد."],[420,"رنجها دادست کان را چاره هست","آن بمثل لقوه و درد سرست","رنج‌ها و مشکلاتی که به انسان داده شده، راه‌حلی دارند و این مشکلات به گونه‌ای هستند که می‌توان مانند بیماری‌هایی چون فلج (لقوه) و سردرد (درد سر) با آن‌ها مقابله کرد."],[420,"این دواها ساخت بهر ایتلاف","نیست این درد و دواها از گزاف","این داروها برای توافق و جمع کردن نیستند؛ بلکه این درد و درمان‌ها بی‌دلیل و بی‌هدف هستند."],[420,"بلک اغلب رنجها را چاره هست","چون بجد جویی بیاید آن بدست","اکثر رنج‌ها و مشکلات راه حلی دارند، به شرطی که انسان به طور جدی به دنبال آنها برود."],[421,"قوم گفتند ای گروه این رنج ما","نیست زان رنجی که بپذیرد دوا","قوم می‌گویند: ای گروه، این تحمل ما، به دلیل دردی نیست که قابل درمان باشد."],[421,"سالها گفتید زین افسون و پند","سخت‌تر می‌گشت زان هر لحظه بند","سال‌ها در مورد افسون و پند سخن گفتید، اما هر بار موضوع و مشکل بیشتر و سخت‌تر می‌شد و بند و زنجیرهای دشواری را بر دوش شما می‌افزود."],[421,"گر دوا را این مرض قابل بدی","آخر از وی ذره‌ای زایل شدی","اگر این مرض این دوا را قبول می کرد(این دارو مرهمی بر این بیماری بود) حداقل یه ذره از درد و رنج بیماری کم می شد(ذره ای بهبود حاصل می شد)"],[421,"سدّه چون شد آب ناید در جگر","گر خورد دریا رود جایی دگر","اگر سدی تشکیل شود، آب به جگر نمی‌رسد؛ حتی اگر دریا را هم بخورد، باز به جایی دیگر می‌رود."],[421,"لاجرم آماس گیرد دست و پا","تشنگی را نشکند آن استقا","بنابراین، وقتی که آب دجّی (غیرقابل دسترس) شود، نه تنها تشنگی را برطرف نمی‌کند بلکه باعث می‌شود که خود انسان دچار درد و رنج بیشتری شود. کوشش‌هایی که در این شرایط انجام می‌شود، فایده‌ای نخواهد داشت."],[422,"انبیا گفتند نومیدی بدست","فضل و رحمتهای باری بی‌حدست","انبیا می‌گویند که ناامیدی از رحمت و فضل بی‌پایان خداوند نادرست است."],[422,"از چنین محسن نشاید ناامید","دست در فتراک این رحمت زنید","از چنین نیکوکار و بخشنده‌ای، نباید ناامید شد؛ چرا که این رحمت الهی مانند دام و فتراک است که با دعا و درخواست می‌توان به آن دست یافت."],[422,"ای بسا کارا که اول صعب گشت","بعد از آن بگشاده شد سختی گذشت","بسیاری از کارها در ابتدا دشوار به نظر می‌رسند، اما بعد از مدتی، سختی‌ها برطرف شده و آنها انجام‌پذیر می‌شوند."],[422,"بعد نومیدی بسی اومیدهاست","از پس ظلمت بسی خورشیدهاست","بعد از ناامیدی، امیدهای زیادی وجود دارد و پس از تاریکی‌های زیاد، روزهای روشنی (مثل خورشید) در انتظار است."],[422,"خود گرفتم که شما سنگین شدیت","قفلها بر گوش و بر دل بر زدیت","من متوجه شدم که شما به دلیل سنگینی وجود خود، قفل‌هایی را بر گوش و دل‌تان زده‌اید و به این ترتیب، نمی‌توانید به حرف‌ها و پیام‌ها توجه کنید."],[422,"هیچ ما را با قبولی کار نیست","کار ما تسلیم و فرمان کردنیست","ما هیچ‌گاه نباید به دنبال قبول یا قبولیت کارها باشیم، چرا که وظیفه ما تنها تسلیم به اراده و فرمان خداوند است."],[422,"او بفرمودستمان این بندگی","نیست ما را از خود این گویندگی","خداوند به ما دستور داده که این نوع بندگی و اطاعت از خود را نپذیریم و ما را از خود این گفتارها و ادعاها برحذر داشته است."],[422,"جان برای امر او داریم ما","گر به ریگی گوید او کاریم ما","ما جان خود را برای انجام فرمان او داریم، حتی اگر به اندازه یک دانه شن (ریگ) هم باشد، اگر او به ما بگوید کاری انجام دهیم، ما آن را انجام خواهیم داد."],[422,"غیر حق جان نبی را یار نیست","با قبول و رد خلقش کار نیست","جز حق، هیچ کس یار نبی نیست و کار او به پذیرش و انکار مردم وابسته نیست."],[422,"مزد تبلیغ رسالاتش ازوست","زشت و دشمن‌رو شدیم از بهر دوست","پاداش تبلیغ پیام‌های او تنها از خود اوست و ما به خاطر دوست (خدا) بد و دشمن‌دوست شده‌ایم."],[422,"ما برین درگه ملولان نیستیم","تا ز بعد راه هر جا بیستیم","ما در این مکان، مایوس و ناراحت نیستیم، تا زمانی که به راهی دیگر برویم و در هر مکان دیگری قرار بگیریم."],[422,"دل فرو بسته و ملول آنکس بود","کز فراق یار در محبس بود","کسی که از دوری معشوق در حبس و تنهایی به سر می‌برد، دلش بسته و ناراحت است."],[422,"دلبر و مطلوب با ما حاضرست","در نثار رحمتش جان شاکرست","دلبر و معشوق ما اکنون در کنار ماست و در سایه رحمت او، جان ما شکرگزار است."],[422,"در دل ما لاله‌زار و گلشنیست","پیری و پژمردگی را راه نیست","در دل ما باغی پر از لاله و گل وجود دارد و جایی برای پیری و پژمردگی نیست."],[422,"دایما تر و جوانیم و لطیف","تازه و شیرین و خندان و ظریف","ما همیشه تازه و جوان و لطیف هستیم، با طراوت و شیرین و شاداب و ظریف."],[422,"پیش ما صد سال و یکساعت یکیست","که دراز و کوته از ما منفکیست","برای ما، صد سال و یک ساعت برابر است و تفاوتی در طول زمان برای ما وجود ندارد، زیرا آنچه دراز و کوتاه به نظر می‌رسد، از ما بی‌اهمیت است."],[422,"آن دراز و کوتهی در جسمهاست","آن دراز و کوته اندر جان کجاست","مدت زمان در عالم جسمانی ممکن است طولانی یا کوتاه به نظر برسد، اما در روح و جان انسان، چنین تفاوتی وجود ندارد و در حقیقت همه چیز یکسان است."],[422,"سیصد و نه سال آن اصحاب کهف","پیششان یک روز بی اندوه و لهف","اصحاب کهف سیصد و نه سال در غار زندگی کردند، ولی این مدت برایشان به یک روز بدون نگرانی و اضطراب می‌گذشت."],[422,"وانگهی بنمودشان یک روز هم","که به تن باز آمد ارواح از عدم","آنگاه به آن‌ها نشان داده شد که یک روز دیگر نیز خواهد آمد که در آن، جان‌ها از عدم خارج شده و به تن‌هایشان بازمی‌گردند."],[422,"چون نباشد روز و شب یا ماه و سال","کی بود سیری و پیری و ملال","اگر زمانی وجود نداشته باشد و روز و شب یا ماه و سال نباشد، در آن صورت دیگر احساس خستگی، پیری و غم وجود نخواهد داشت."],[422,"در گلستان عدم چون بی‌خودیست","مستی از سغراق لطف ایزدیست","در فضای عدم، هنگامی که انسان بی‌خود و سرمست است، نشانه‌ای از پرستیژ و عظمت لطف الهی به وضوح نمایان می‌شود."],[422,"لم یذق لم یدر هر کس کو نخورد","کی بوهم آرد جعل انفاس ورد","هر کس که طعم حقیقت را نچشد، نمی‌تواند آن را درک کند. او فقط با خیالات و تصورات خود می‌تواند به چیزی شبیه به حقیقت برسد و از آن به عنوان یک صورت ظاهری یاد کند."],[422,"نیست موهوم ار بدی موهوم آن","همچو موهومان شدی معدوم آن","بدی و زشتی واقعی وجود ندارد و اگر هم به نظر برسد، مانند خیالات و تصورات بی‌اساس است که در واقع وجود خارجی ندارند."],[422,"دوزخ اندر وهم چون آرد بهشت","هیچ تابد روی خوب از خوک زشت","دوزخ در تخیل نمی‌تواند به بهشت راه یابد، زیرا زیبایی و خوبی به‌هیچ‌وجه نمی‌تواند از زشتی و پلیدی به دست آید."],[422,"هین گلوی خود مبر هان ای مهان","این‌چنین لقمه رسیده تا دهان","ای بزرگواران، مراقب باشید که گلوی خود را نبرید و به خود آسیب نزنید، زیرا این قضا و تقدیر به شما رسیده و فقط در حال حاضر نزد شماست."],[422,"راههای صعب پایان برده‌ایم","ره بر اهل خویش آسان کرده‌ایم","ما مشکلات و راه‌های سخت را پشت سر گذاشته‌ایم و برای خانواده و نزدیکان خود مسیر را آسان کرده‌ایم."],[423,"قوم گفتند ار شما سعد خودیت","نحس مایید و ضدیت و مرتدیت","قوم گفتند اگر شما خوشبختی و سعادت خود را می‌خواهید، ما شومی و بدبختی شما را می‌بینیم و فکر می‌کنیم که شما با عقاید ما در تضاد هستید و به نوعی مرتد شده‌اید."],[423,"جان ما فارغ بد از اندیشه‌ها","در غم افکندید ما را و عنا","اگرچه ما از فکر و اندیشه‌ها آزاد بودیم، شما ما را با غم و مشکلاتی که ایجاد کردید غمگین کردید."],[423,"ذوق جمعیت که بود و اتفاق","شد ز فال زشتتان صد افتراق","ذوق و شادی جمع شدن و اتفاق ما به خاطر بدبیاری و فال بد شما به جدایی و تفرقه انجامید."],[423,"طوطی نقل شکر بودیم ما","مرغ مرگ‌اندیش گشتیم از شما","ما در ابتدا مانند طوطی بودیم که شیرینی‌ها را نقل می‌کرد و شاداب بودیم، اما به دلیل وجود شما، به مرغی اندیشناک و غمگین تبدیل شدیم."],[423,"هر کجا افسانه غم‌گستریست","هر کجا آوازه مستنکریست","هر جا داستانی از غم وجود دارد و هر جا حرفی از ناپسند بودن شنیده می‌شود."],[423,"هر کجا اندر جهان فال بذست","هر کجا مسخی نکالی ماخذست","هر کجا در جهان فال (تعبیر خواب یا پیشگویی) در دست است و هر کجا تغییر شکل (مسخ) وجود دارد، منبع آن عقل و اختیار انسانی است."],[423,"در مثال قصه و فال شماست","در غم‌انگیزی شما را مشتهاست","شما به مانند داستان و سرنوشت هستید؛ در غم و اندوه، چهره‌تان حاکی از پریشانی و دردی است که در دل دارید."],[424,"انبیا گفتند فال زشت و بد","از میان جانتان دارد مدد","انبیا گفتند که نشانه‌های ناگوار و بدی از درون وجود شما سرچشمه می‌گیرد و به شما کمک می‌کند."],[424,"گر تو جایی خفته باشی با خطر","اژدها در قصد تو از سوی سر","اگر در جایی بخوابی و خطر اژدها (نماینده خطر یا دشواری) از سمت سرت به تو نزدیک شود، نشانه این است که باید هوشیار و بیدار باشی."],[424,"مهربانی مر ترا آگاه کرد","که بجه زود ار نه اژدرهات خورد","مهربانی تو را از خطر آگاه کرده است، پس اگر به موقع بیدار نشوی، مانند اژدهایی تو را خواهد خورد."],[424,"تو بگویی فال بد چون می‌زنی","فال چه بر جه ببین در روشنی","تو می‌گویی وقتی بدی را از روی فال می‌بینی، در واقع باید توجه کنی که در حقیقت چه چیزی از روشنایی و حقیقت بر تو ظاهر می‌شود."],[424,"از میان فال بد من خود ترا","می‌رهانم می‌برم سوی سرا","من از بین فال بدی که زدم، تو را نجات می‌دهم و به خانه‌ام می‌برم."],[424,"چون نبی آگه کننده‌ست از نهان","کو بدید آنچ ندید اهل جهان","پیامبر (نبی) از حقایق پنهان آگاه است، چون او آنچه را که مردم نمی‌بینند، مشاهده می‌کند."],[424,"گر طبیبی گویدت غوره مخور","که چنین رنجی بر آرد شور و شر","اگر طبیبی به تو بگوید که غوره نخور، زیرا این کار باعث می‌شود که رنج و درد زیادی به تو تحمیل شود."],[424,"تو بگویی فال بد چون می‌زنی","پس تو ناصح را مثم می‌کنی","اگر تو بگویی که پیشگویی بدی کردم، در واقع به نصیحت‌کننده‌ات لطمه می‌زنی و او را بی‌مقدار می‌سازی."],[424,"ور منجم گویدت کامروز هیچ","آنچنان کاری مکن اندر پسیچ","اگر منجمی به تو بگوید که امروز هیچ کاری انجام مده، باید برعکس عمل کنی و کاری در پی انجام ندهی."],[424,"صد ره ار بینی دروغ اختری","یک دوباره راست آید می‌خری","اگر صد بار هم دروغی از نجوم و پیشگویی‌ها ببینی، باز هم یک بار ممکن است که راست باشد و تو این بار را می‌خری."],[424,"این نجوم ما نشد هرگز خلاف","صحتش چون ماند از تو در غلاف","علم نجوم ما هرگز با حقیقت مخالف نشد، چون به خاطر تو در پرده و غلاف پنهان مانده است."],[424,"آن طبیب و آن منجم از گمان","می‌کنند آگاه و ما خود از عیان","آن پزشک و منجم (در اینجا به معنای ستاره‌شناس) به دانسته‌های ظاهری خود می‌بالند و فکر می‌کنند که همگی را می‌دانند، در حالی که ما حقیقت را از تجربه و دانش مستقیم خود می‌شناسیم."],[424,"دود می‌بینیم و آتش از کران","حمله می‌آرد به سوی منکران","ما دود را می‌بینیم و آتش از دور به سمت کسانی که حقیقت را انکار می‌کنند، نزدیک می‌شود."],[424,"تو همی‌گویی خمش کن زین مقال","که زیان ماست قال شوم‌فال","تو می‌گویی در مورد این سخن سکوت کن، زیرا این گفتار برای ما مضر است و شوم است."],[424,"ای که نصح ناصحان را نشنوی","فال بد با تست هر جا می‌روی","ای کسی که به نصیحت‌های نصیحت‌گران گوش نمی‌دهی، بدی‌ها با تو هستند هر جا که بروی."],[424,"افعیی بر پشت تو بر می‌رود","او ز بامی بیندش آگه کند","افعی (مار سمی) بر پشت تو می‌خزد و او در بالای بام تو را می‌بیند و به تو هشدار می‌دهد."],[424,"گوییش خاموش غمگینم مکن","گوید او خوش باش خود رفت آن سخن","این بیت بیان می‌کند که شخصی غمگین است و از دیگری می‌خواهد که درباره این غم صحبت نکند. او می‌گوید که باید خوش باشد، زیرا موضوعی که باعث این غم شده، دیگر موضوعی نیست که در مورد آن حرف زده شود."],[424,"چون زند افعی دهان بر گردنت","تلخ گردد جمله شادی جستنت","زمانی که افعی (مار) دهانش را در گردن تو بزند، همه‌ی شادی‌ها و خوشحالی‌هایت تلخ و نابود می‌شود."],[424,"پس بدو گویی همین بود ای فلان","چون بندریدی گریبان در فغان","وقتی با او سخن می‌گویی، می‌گویی که این همان چیزی است که تو به دنبال آن بودی، ای فلان، چون وقتی که خودت را رهانیدی، به فریاد درآمدی."],[424,"یا ز بالایم تو سنگی می‌زدی","تا مرا آن جد نمودی و بدی","تو از بالای من سنگ می‌زدی تا مرا به جدایی و ناخوشی برسانی."],[424,"او بگوید زآنک می‌آزرده‌ای","تو بگویی نیک شادم کرده‌ای","او می‌گوید چون تو مرا مورد آزار قرار می‌دهی، من نیز پاسخ می‌دهم که تو مرا خوشحال کرده‌ای."],[424,"گفت من کردم جوامردی بپند","تا رهانم من ترا زین خشک بند","او می‌گوید که من برای اینکه تو را از این قید و بند سخت آزاد کنم، اعمال نیک و بزرگی انجام دادم و امیدوارم تو هم این را درک کنی."],[424,"از لئیمی حق آن نشناختی","مایه ایذا و طغیان ساختی","تو از ویژگی‌های بد انسان‌های لئیم (پست) آگاهی نداشتی و همین باعث شد که زمینه‌ساز آزار و تبهکاری شوی."],[424,"این بود خوی لئیمان دنی","بد کند با تو چو نیکویی کنی","خوی افراد پست و لئیم این است که اگر با آنها نیکی کنی، بدی در حق تو می‌کنند."],[424,"نفس را زین صبر می‌کن منحنیش","که لئیمست و نسازد نیکویش","نفس انسان را با این صبر، منحرف کن، زیرا نفس انسان پست است و نیکی نمی‌کند."],[424,"با کریمی گر کنی احسان سزد","مر یکی را او عوض هفصد دهد","اگر با نیکی و بخشندگی به کسی احسان کنی، شایسته است که این کار را انجام دهی، چون یک نفر در ازای آن، برکت و پاداشی به اندازه هفتصد برابر به تو می‌دهد."],[424,"با لئیمی چون کنی قهر و جفا","بنده‌ای گردد ترا بس با وفا","اگر با انسان بدخو و لئییم قهر و سخت‌گیری کنی، آن‌گاه بنده‌ای وفادار و خوب برای تو پیدا خواهد شد."],[424,"کافران کارند در نعمت جفا","باز در دوزخ نداشان ربنا","کافران در دنیای نعمت، به خداوند بدی می‌کنند، اما در آتش دوزخ به ناله و دعا می‌پردازند و درخواست کمک می‌کنند."],[425,"که لئیمان در جفا صافی شوند","چون وفا بینند خود جافی شوند","لئیمان (افراد پست) در موقع سختی و جفا به راحتی به صفات نیک تبدیل می‌شوند، ولی وقتی وفا و صداقت را می‌بینند، خودشان هم ظالم و جفاکار می‌شوند."],[425,"مسجد طاعاتشان پس دوزخست","پای‌بند مرغ بیگانه فخست","این بیت به این معناست که عبادت‌های ظاهری آن‌ها، در واقع نوعی دوزخ است که آن‌ها را به بند کشیده است. به عبارت دیگر، افرادی که به ظاهر عبادت می‌کنند، در حقیقت گرفتار محدودیت و وابستگی‌اند و به مانند مرغی بیگانه، از معنا و حقیقت دور هستند."],[425,"هست زندان صومعه دزد و لئیم","کاندرو ذاکر شود حق را مقیم","در صومعه‌ای که مکان زندانیانی چون دزدان و افراد پست است، کسی می‌تواند به یاد حق مشغول شود و به یاد او بایستد."],[425,"چون عبادت بود مقصود از بشر","شد عبادتگاه گردن‌کش سقر","اگر هدف از آفرینش انسان عبادت باشد، پس دوزخ سقر (دوزخی برای گردن‌کش‌ها و متکبران) تبدیل به معبد و عبادتگاه آن‌ها می‌شود."],[425,"آدمی را هست در هر کار دست","لیک ازو مقصود این خدمت بدست","انسان در هر کاری که انجام می‌دهد، از قدرت و اراده خود بهره‌مند است، اما در نهایت هدف از همه این کارها، خدمت و عبادت به خداوند است."],[425,"ما خلقت الجن و الانس این بخوان","جز عبادت نیست مقصود از جهان","خداوند جن و انس را تنها برای عبادت آفریده است و جز این هدفی برای خلق آن‌ها وجود ندارد."],[425,"گرچه مقصود از کتاب آن فن بود","گر توش بالش کنی هم می‌شود","اگرچه هدف از نوشتن این کتاب آموزش و فن است، اما اگر تو آن را بال و پر دهی و به آن جان ببخشی، همچنان می‌تواند مفید و ارزشمند باشد."],[425,"لیک ازو مقصود این بالش نبود","علم بود و دانش و ارشاد سود","مقصود از این کلام نثر و شعر، تنها علم و دانش و ارشاد است، نه صرفا زینت کلام و تزیینی که در قالب شعر ارائه شده است."],[425,"گر تو میخی ساختی شمشیر را","برگزیدی بر ظفر ادبار را","اگر تو به چیزی چنگ زدی و آن را ساختی، در واقع، شمشیر را انتخاب کرده‌ای تا به پیروزی بر ناامیدی برسی."],[425,"گرچه مقصود از بشر علم و هدیست","لیک هر یک آدمی را معبدیست","هرچند هدف از خلقت انسان، علم و هدایت است، اما هر فرد انسان به نوعی (از نظر صفات و ویژگی‌ها) معبد خاصی دارد."],[425,"معبد مرد کریم اکرمته","معبد مرد لئیم اسقمته","معبد انسان بزرگوار، او را محترم می‌شمارد و در مقابل، معبد انسان پست و بی‌مقدار او را خوار و ذلیل می‌کند."],[425,"مر لئیمان را بزن تا سر نهند","مر کریمان را بده تا بر دهند","بزدل‌ها و افراد لئیم را باید سرکوب کرد تا سرافکنده و به زانو درآیند، اما به افراد کریم و بزرگوار باید کمک کرد تا به پیشرفت و تعالی برسند."],[425,"لاجرم حق هر دو مسجد آفرید","دوزخ آنها را و اینها را مزید","خداوند به همین سبب، برای هر دو گروه (کرام و لئیمان) مکان‌هایی به وجود آورد؛ دوزخی برای لئیمان و مسجدی برای کرام تا هر یک به مقصود خود برسند."],[425,"ساخت موسی قدس در باب صغیر","تا فرود آرند سر قوم زحیر","موسی (پیامبر) در دروازه‌ای کوچک (یعنی دوزخ) ساخت تا سر گروه زورگو و متکبر را پایین بیاورد و آنها را خوار کند."],[425,"زآنک جباران بدند و سرفراز","دوزخ آن باب صغیرست و نیاز","چون ستمگران و متکبران در دنیا وجود دارند، به همین دلیل دوزخ در آنچه که به دنیا و زندگی انسان‌ها مربوط می‌شود، شبیه به دروازه‌ای کوچک است که نیاز به آن احساس می‌شود."],[426,"آنچنانک حق ز گوشت و استخوان","از شهان باب صغیری ساخت هان","خداوند به‌گونه‌ای از گوشت و استخوان پادشاهان، شکلی کوچک و کودکانه ساخت تا به نوعی قدرت آن‌ها را به مسخرگی بگیرد."],[426,"اهل دنیا سجده ایشان کنند","چونک سجده کبریا را دشمنند","اهل دنیا به خاطر مقام و قدرت آنها سجده می‌کنند، اما خود آنها به سجده در مقابل خداوند، که بزرگ‌ترین و والاترین است، نارضایتی دارند."],[426,"ساخت سرگین‌دانکی محرابشان","نام آن محراب میر و پهلوان","این بیت به توصیف محرابی می‌پردازد که محبت و حرمت خاصی به آن تعلق دارد و به نوعی نماد قدرت و شجاعت است. در اینجا، سرگین‌دانکی (ظرفی برای نگه‌داری سرگین) به عنوان کنایه‌ای از ناپاکی و ناتوانی در فهم حقیقت معرفی شده و محراب نماینده مقام عالیه‌ای است که برای مردان بزرگ و پهلوانان طراحی شده است."],[426,"لایق این حضرت پاکی نه‌اید","نیشکر پاکان شما خالی‌نیید","شما شایسته مقام این حضرت پاک نیستید، چراکه نیشکر، که نماد پاکی و شیرینی است، بدون وجود پاکان چیزی از خود ندارد."],[426,"آن سگان را این خسان خاضع شوند","شیر را عارست کو را بگروند","این سگان اوباش در برابر شیر، که نماد قدرت و عظمت است، خاضع و تسلیم شده‌اند، چون می‌دانند که شیر به آنها بی‌توجه خواهد بود و حاضر به پذیرش ذلت آنها نیست."],[426,"گربه باشد شحنه هر موش‌خو","موش که بود تا ز شیران ترسد او","اگر گربه‌ای در محله باشد، موش‌ها به خاطر ترس از شیرها، که نماد قدرت و خطرند، همواره مراقب خواهند بود و از گربه هم می‌ترسند."],[426,"خوف ایشان از کلاب حق بود","خوفشان کی ز آفتاب حق بود","ترس جباران از بندگان خدا (کلاب حق) ناشی از ترس آن‌ها از قدرت و نور الهی (آفتاب حق) است. این ترس به خاطر عظمت و سروری خدا است که آن‌ها را به چنین وضعی دچار کرده است."],[426,"ربی الاعلاست ورد آن مهان","رب ادنی درخور این ابلهان","خداوند متعال است و ربی که بالاترین مقام را دارد، اما این افراد فرودست و سفیه در شأن خود نمی‌دانند و به بی‌خودگی و نادانی مشغولند."],[426,"موش کی ترسد ز شیران مصاف","بلک آن آهوتگان مشک‌ناف","موش از شیران دلیر نمی‌ترسد، بلکه از آهوان خوشبو و زیبا که خاصیت خوشی و صفای خود را دارند، می‌ترسد."],[426,"رو به پیش کاسه‌لیس ای دیگ‌لیس","توش خداوند و ولی نعمت نویس","ای کاسه‌لیس (کسی که کاسه می‌سازد)، رو به جلو بیا، چون خداوند و ولی نعمت (حامی و اولیای تو) درون توست و اثر آن را بنویس."],[426,"بس کن ار شرحی بگویم دور دست","خشم گیرد میر و هم داند که هست","اگر بخواهم بیشتر توضیح دهم، ممکن است بر خشم آن شخص (که به احتمال زیاد به مقام بالایی اشاره دارد) افزوده شود و او نیز به خوبی می‌داند چه کسی هستم."],[426,"حاصل این آمد که بد کن ای کریم","با لئیمان تا نهد گردن لئیم","نتیجه این سخن این است که ای کریم، با افراد پست و فرومایه بدرفتاری کن تا آن‌ها سر تسلیم به تو فرود آورند و ذلت خود را بپذیرند."],[426,"با لئیم نفس چون احسان کند","چون لئیمان نفس بد کفران کند","زمانی که نفس پست و ذلیل خیری کند، مانند انسان‌های پست، به خوبی‌ها کافر می‌شود و این نیکی را به فراموشی می‌سپارد."],[426,"زین سبب بد که اهل محنت شاکرند","اهل نعمت طاغیند و ماکرند","به همین دلیل، کسانی که در زحمت هستند شاکر و سپاسگزارند، اما کسانی که در نعمت‌ و رفاه به سر می‌برند، طغیان‌گر و مکار هستند."],[426,"هست طاغی بگلر زرین‌قبا","هست شاکر خسته صاحب‌عبا","افراد طاغی و ستمگر معمولا در لباس‌های زرق و برق و زیبا دیده می‌شوند، در حالی که افرادی که دچار رنج و سختی‌اند (خسته صاحب‌عبا، اشاره به آنان که در رنجند) شکرگزار و سپاس‌گذار هستند."],[426,"شکر کی روید ز املاک و نعم","شکر می‌روید ز بلوی و سقم","شکر و سپاسگذاری زمانی پدیدار می‌شود که انسان از نعمت‌ها و ملک‌ها به دور باشد و در شرایط سختی چون بلا و بیماری قرار گیرد."],[427,"صوفیی بر میخ روزی سفره دید","چرخ می‌زد جامه‌ها را می‌درید","صوفی‌ای سفره‌ای را دید که در روز قحطی و کمبود، وضعیتش بسیار بد است و چرخ زمانه به گونه‌ای چرخیده که اوضاع زندگی را نابود کرده و نعمت‌ها را از انسان‌ها می‌گیرد."],[427,"بانگ می‌زد نک نوای بی‌نوا","قحطها و دردها را نک دوا","صوفی ناله‌ و فریاد می‌زد و می‌گفت که بی‌کسی و مشکلات و دردها مانند قحطی و کمبود چیزی را درمان نمی‌کند."],[427,"چونک دود و شور او بسیار شد","هر که صوفی بود با او یار شد","زمانی که شور و هیجان او (صوفی) افزایش یافت، هر کسی که صوفی بود، به او نزدیک و همراه شد."],[427,"کخ‌کخی و های و هویی می‌زدند","تای چندی مست و بی‌خود می‌شدند","گروه‌هایی از افراد به شوق و شادی سر و صدا و هیاهو برپا می‌کردند و تا مدتی در حال مستی و بی‌خیالی غرق می‌شدند."],[427,"بوالفضولی گفت صوفی را که چیست","سفره‌ای آویخته وز نان تهیست","بوالفضل، به صوفی می‌گوید که چرا سفره‌ای آویخته‌اید که خالی از نان است و چیزی برای خوردن ندارد."],[427,"گفت رو رو نقش بی‌معنیستی","تو بجو هستی که عاشق نیستی","به صوفی گفته می‌شود که به دنبال معنای واقعی و اهمیت زندگی باشد، زیرا تو تنها به دنبال ظواهر و نمای بی‌معنا هستی و حقیقت عشق و وجود را نمی‌شناسی."],[427,"عشق نان بی نان غذای عاشق است","بند هستی نیست هر کو صادقست","عشق برای عاشق مانند غذایی است که حتی بی‌نان هم قابل خوردن و تأمین‌کننده نیازش است؛ از نظر مولانا، وجود عشق در دل انسان واقعی به هر حال کافی است و شرط اصلی داشتن صداقت است."],[427,"عاشقان را کار نبود با وجود","عاشقان را هست بی سرمایه سود","عاشقان، حتی اگر چیزی نداشته باشند، به عشق خود ادامه می‌دهند و نیازی به دارایی ندارند، چون عشق برایشان یک سرمایه بزرگ و سودمند است؛ در واقع عشق، خود سرمایه اصلی آنهاست."],[427,"بال نه و گرد عالم می‌پرند","دست نه و گو ز میدان می‌برند","عاشقان به دلایل روحانی و معنوی در دنیا پرواز می‌کنند و نیاز به ابزار مادی ندارند، اما کسانی که دستشان از حقیقت و معنای عشق کوتاه است، از میدان زندگی طرد می‌شوند."],[427,"آن فقیری کو ز معنی بوی یافت","دست ببریده همی زنبیل بافت","فقیر حقیقی کسی است که بوی معنویت را درک کرده و حتی اگر در شرایط سخت و با دست‌های بریده باشد، همچنان مشغول کار و تلاش است و سبدی از خواسته‌های معنوی را می‌سازد."],[427,"عاشقان اندر عدم خیمه زدند","چون عدم یک‌رنگ و نفس واحدند","عاشقان در جایی که وجودی نیست (عدم) ارتباط و همبستگی برقرار کرده‌اند و به خاطر آنکه عدم دارای یک رنگ و یک نفس است، آن‌ها نیز به نوعی یگانه و هماهنگ به نظر می‌رسند."],[427,"شیرخواره کی شناسد ذوق لوت","مر پری را بوی باشد لوت و پوت","کودک شیرخوار چگونه می‌تواند طعم لذت را درک کند، در حالی که هنوز بوی آن لذت و چیزهای خوب را نشناخته است؟"],[427,"آدمی کی بو برد از بوی او","چونک خوی اوست ضد خوی او","انسان چگونه می‌تواند از بوی کسی آگاه شود، در حالی که ذات او با ذات آن فرد مخالف است؟"],[427,"یابد از بو آن پری بوی‌کش","تو نیابی آن ز صد من لوت خوش","اگر تو از بو و نشانه‌ها بتوانی آن پری را شناسایی کنی، پس حقیقت و زیبایی او را دریابی. اما تو نمی‌توانی آن را حتی از میان صد ظرف خوش‌بو هم بشناسی."],[427,"پیش قبطی خون بود آن آب نیل","آب باشد پیش سبطی جمیل","در زمان موسی، برای قبطی‌ها، آب نیل همانند خونی بود که انگار به عنوان عذاب دیده می‌شد، اما برای سبطی‌های بنی‌اسرائیل، آن آب زیبایی و نعمت بود."],[427,"جاده باشد بحر ز اسرائیلیان","غرقه گه باشد ز فرعون عوان","جاده‌ای که از آن عبور می‌شود، برای قوم بنی‌اسرائیل دریایی است که غرق شده‌اند، و گاه نیز برای فرعون و پیروان او خواهد بود که به هلاکت می‌رسند."],[428,"آنچ یعقوب از رخ یوسف بدید","خاص او بد آن به اخوان کی رسید","یعقوب از زیبایی یوسف خاصیت و جلوه‌ای را دریافت کرد که این حس و درک برای برادران او قابل دسترسی نبود."],[428,"این ز عشقش خویش در چه می‌کند","و آن بکین از بهر او چه می‌کند","یعقوب به خاطر عشقش به یوسف، خود را فدای او می‌کند و برادرانش نیز از حسادت و کینه به خاطر او دست به اقداماتی می‌زنند."],[428,"سفره او پیش این از نان تهیست","پیش یعقوبست پر کو مشتهیست","سفره محبت و رحمت حق برای دیگران خالی از نعمت است، اما برای یعقوب، که عشق به یوسف را در دل دارد، پر از خواسته‌ها و آرزوهاست."],[428,"روی ناشسته نبیند روی حور","لا صلوة گفت الا بالطهور","کسی که قبل از نماز، غسل نکرده یا وضو ندارد، نباید به جمال حور العین (زنان بهشتی) بنگرد، زیرا دیدن آن جمال نیازمند پاکیزگی و طهارت است."],[428,"عشق باشد لوت و پوت جانها","جوع ازین رویست قوت جانها","عشق مانند سرزمین (لوت) و سرپوش (پوت) جان‌هاست و نیاز به آن، منبع قوت روح‌ها است. انسان‌ها به خاطر عشق به آن سو کشیده می‌شوند و قوت روحی خود را از آن می‌گیرند."],[428,"جوع یوسف بود آن یعقوب را","بوی نانش می‌رسید از دور جا","یعقوب، نزدیکی و عشقش به یوسف را مانند گرسنگی به نان توصیف می‌کند، به طوری که بو و عطر یوسف از فاصله به او می‌رسید و او را جذب می‌کرد."],[428,"آنک بستد پیرهن را می‌شتافت","بوی پیراهان یوسف می‌نیافت","یعقوب پیرهن یوسف را که گم کرده بود، با شتاب می‌خواست به دستش بیاورد، اما بوی پیراهن یوسف به او نمی‌رسید."],[428,"و آنک صد فرسنگ زان سو بود او","چونک بد یعقوب می‌بویید بو","یعقوب، که در فاصله‌ای بسیار دور قرار داشت، زمانی که بوی پیراهن یوسف را استشمام کرد، متوجه او شد."],[428,"ای بسا عالم ز دانش بی‌نصیب","حافظ علمست آنکس نه حبیب","خیلی از دانشمندان وجود دارند که از دانش واقعی بی‌بهره‌اند؛ زیرا علم واقعی را کسی دارد که در دلش محبت و دوستی وجود داشته باشد، نه فقط اطلاعات و علم ظاهری."],[428,"مستمع از وی همی‌یابد مشام","گرچه باشد مستمع از جنس عام","شنونده از او بوی خوش و معانی عمیق را می‌برد، هرچند این شنونده ممکن است از مردم عادی باشد و به مقام خاصی نرسیده باشد."],[428,"زانک پیراهان بدستش عاریه‌ست","چون بدست آن نخاسی جاریه‌ست","زیرا پیراهن‌هایی که در دستان اوست، فقط امانت است، مانند اینکه جاریه (زن کنیز) در دستان آن بافنده (نخاس) تنها برای مشتری (خریدار) است."],[428,"جاریه پیش نخاسی سرسریست","در کف او از برای مشتریست","دامن حایلی که در دست آن خنیاگر (نخاس) است، فقط ظاهری است و در واقع، به خاطر خریدار (مشتری) دیگر است و ارزش واقعی ندارد."],[428,"قسمت حقست روزی دادنی","هر یکی را سوی دیگر راه نی","قسمت الهی است که روزی به هر کسی داده می‌شود و هر کس باید در مسیر دیگری برود و به او نمی‌رسد."],[428,"یک خیال نیک باغ آن شده","یک خیال زشت راه این زده","همان‌طور که یک خیال خوب می‌تواند باغی زیبا و دلپذیر بسازد، خیال بد هم می‌تواند راه را به سمت ویرانی و زشتی هدایت کند."],[428,"آن خدایی کز خیالی باغ ساخت","وز خیالی دوزخ و جای گداخت","خداوندی که با خیال خود باغی زیبا و همچنین دوزخی هولناک را آفریده است، نشان‌دهنده توانا بودن او در ایجاد حالت‌های مختلف در زندگی و سرنوشت انسان‌هاست."],[428,"پس کی داند راه گلشنهای او","پس کی داند جای گلخنهای او","هیچ‌کس نمی‌داند که باغ‌های بهشت (گلشن‌ها) و جهنم (گلخن‌ها) در کجا قرار دارند و راه رسیدن به آن‌ها چیست."],[428,"دیدبان دل نبیند در مجال","کز کدامین رکن جان آید خیال","دل نگهبان (نگهبان دل) نمی‌تواند در حالتی که در دسترس نیست، ببیند که خیال از کدام رکن و بخش جان می‌آید. این اشاره به محدودیت‌های ادراک انسانی و مشکلاتی است که در درک حقیقت وجود دارد."],[428,"گر بدیدی مطلعش را ز احتیال","بند کردی راه هر ناخوش خیال","اگر به آغاز و حقیقت او نگاه می‌کردی، از ترفندهای دیگران بی‌خبر می‌ماندی و راه هر خیال ناخوشایند را می‌بستی."],[428,"کی رسد جاسوس را آنجا قدم","که بود مرصاد و در بند عدم","هیچ‌گاه جاسوس نمی‌تواند به جایی برسد که در آنجا تله و دام قرار دارد و انسان از عدم و نبود آنجا خبر ندارد."],[428,"دامن فضلش بکف کن کوروار","قبض اعمی این بود ای شهره یار","یعقوب، که در غم او پسرش یوسف کور شده، حالا باید دامن فضل و کرامت را در دست بگیرد زیرا این وضعیت نشان از نقص و محرومیت او دارد. در واقع، یعقوب به یوسف و فضل او توجهی دارد و می‌خواهد از این غم و فقدان رها شود."],[428,"دامن او امر و فرمان ویست","نیکبختی که تقی جان ویست","دامن او (یعنی دامن یوسف) مظهر دستورات و فرمان‌های الهی است و کسی که تقوای او را دارد، خوشبخت خواهد بود."],[428,"آن یکی در مرغزار و جوی آب","و آن یکی پهلوی او اندر عذاب","یکی در خوشی و آرامش در طبیعت و در کنار آب و گل زندگی می‌کند، اما دیگری در کنارش در عذاب و رنج به سر می‌برد."],[428,"او عجب مانده که ذوق این ز چیست","و آن عجب مانده که این در حبس کیست","یعقوب در حیرت است که چطور از وجود یوسف این همه لذت می‌برد و در عجب است که این شخصی که در حبس است، چه کسی می‌تواند باشد."],[428,"هین چرا خشکی که اینجا چشمه هاست","هین چرا زردی که اینجا صد دواست","چرا در اینجا که چشمه‌ها جاری است، بی‌حالی و خشکی را حس می‌کنی؟ و چرا در حالی که اینجا دارویی مثل صد دوا وجود دارد، حال تو زرد و ناخوش است؟"],[428,"همنشینا هین در آ اندر چمن","گوید ای جان من نیارم آمدن","دوستان و هم‌نشینان، چرا در این مکان زیبا و دل‌انگیز نمی‌گویید که ای جان من، نمی‌توانم به گردهمایی بیایم؟"],[429,"میر شد محتاج گرمابه سحر","بانگ زد سنقر هلا بردار سر","امیر (میر) به شدت به گرمابه نیاز داشت و در آستانه صبح با صدای سنقر (پرنده‌ای سمبل آزادی و شادی) فریاد زد که کسی بیاید و سر او را بردارد و به گرمابه برساند."],[429,"طاس و مندیل و گل از التون بگیر","تا به گرمابه رویم ای ناگزیر","دوستش به او می‌گوید که برای رفتن به گرمابه، ظرف (طاس) و دستمال (مندیل) و گل را از التون (محل یا کسی که ممکن است گل بدهد) بگیر، چون تو ناچار باید به گرمابه بروی."],[429,"سنقر آن دم طاس و مندیلی نکو","برگرفت و رفت با او دو بدو","سنقر در آن لحظه، طاس و دستمالی زیبا را برداشت و به همراه او (امیر) دو به دو به سمت جایی رفتند."],[429,"مسجدی بر ره بد و بانگ صلا","آمد اندر گوش سنقر در ملا","سنقر در مسیر خود به مسجدی رسید و صدای اذان به گوشش رسید."],[429,"بود سنقر سخت مولع در نماز","گفت ای میر من ای بنده‌نواز","سنقر، به شدت شیفته و passionate در نماز بود و به امیر خود، که او را به خوبی می‌پرستد، گفت: «ای آقا و سرور من، ای کسی که بندگان را با مهربانی خود نوازش می‌کنی»."],[429,"تو برین دکان زمانی صبر کن","تا گزارم فرض و خوانم لم یکن","صبر کن تا من نماز را به جا بیاورم و سپس می‌توانی به کار خود ادامه دهی."],[429,"چون امام و قوم بیرون آمدند","از نماز و وردها فارغ شدند","وقتی امام و مردم از نماز خارج شدند و به ذکر و دعاهای خود پایان دادند،"],[429,"سنقر آنجا ماند تا نزدیک چاشت","میر سنقر را زمانی چشم داشت","سنقر تا نزدیک صبح آنجا ماند و به انتظار رسیدن امیر بود و به او توجه داشت."],[429,"گفت ای سنقر چرا نایی برون","گفت می‌نگذاردم این ذو فنون","سنقر (پرنده‌ای بزرگ) می‌گوید: چرا بیرون نمی‌روی؟ و او پاسخ می‌دهد که نمی‌توانم بروم زیرا به خاطر آموختن این همه مهارت و فن، مانع می‌شوم."],[429,"صبر کن نک آمدم ای روشنی","نیستم غافل که در گوش منی","بگو صبر کن، من هنوز نرسیده‌ام، ای نور و روشنایی؛ من غافل نیستم، تو در قلب و ذهن من هستی."],[429,"هفت نوبت صبر کرد و بانگ کرد","تاکه عاجز گشت از تیباش مرد","او هفت بار صبر کرد و صدا زد، اما به دلیل ناتوانی‌اش از تأثیرگذاری بر او، مرد ناامید شد."],[429,"پاسخش این بود می‌نگذاردم","تا برون آیم هنوز ای محترم","او در پاسخ گفت که نمی‌گذارم از مسجد بیرون بیایی تا وقتی که هنوز این کار (نماز) را انجام نداده‌ای، ای محترم."],[429,"گفت آخر مسجد اندر کس نماند","کیت وا می‌دارد آنجا کت نشاند","او می‌گوید که در مسجد هیچ‌کس باقی نمانده است، پس چرا کسی در آنجا گردهم می‌آید و چه کسی آنجا را پر می‌کند؟"],[429,"گفت آنک بسته‌استت از برون","بسته است او هم مرا در اندرون","اگر کسی به خاطر بیرون ماندن از نماز و عبادت، از مسجد خارج شود، در واقع خود را از رحمت و محبت حق نیز محروم کرده است."],[429,"آنک نگذارد ترا کایی درون","می‌بنگذارد مرا کایم برون","آن که اجازه نمی‌دهد تو در درون خودت، به راحتی و آزادی زندگی کنی، به من این فرصت را می‌دهد که در بیرون از خودم، به خوبی زندگی کنم."],[429,"آنک نگذارد کزین سو پا نهی","او بدین سو بست پای این رهی","کسی که نمی‌گذارد که تو از این سو پا در میان بگذاری، او همچنین پای تو را به این سو بسته است تا نتوانی در این راه پیش بروی."],[429,"ماهیان را بحر نگذارد برون","خاکیان را بحر نگذارد درون","ماهی‌ها نمی‌توانند از دریا خارج شوند و انسان‌ها نیز نمی‌توانند به دریا وارد شوند. این کنایه از محدودیت‌ها و حریم‌های طبیعی موجود در زندگی است."],[429,"اصل ماهی آب و حیوان از گلست","حیله و تدبیر اینجا باطلست","ماهی در اصل از آب و مخلوقات دیگر از خاک شکل گرفته‌اند، بنابراین در اینجا با ترفند و تدبیر چیزی رسیدن به حقیقت ممکن نیست."],[429,"قفل زفتست و گشاینده خدا","دست در تسلیم زن واندر رضا","قفل بزرگ و محکمی وجود دارد که تنها خدا می‌تواند آن را باز کند. باید در تسلیم شدن به اراده الهی تلاش کرد و راضی بودن را در پیش گرفت."],[429,"ذره ذره گر شود مفتاحها","این گشایش نیست جز از کبریا","اگر ذره ذره و به تدریج کلیدهایی به دست آید، این گشایش تنها از جانب خداوند بزرگ است و نه از تلاش‌های فردی."],[429,"چون فراموشت شود تدبیر خویش","یابی آن بخت جوان از پیر خویش","زمانی که تدبیر و فکر خود را فراموش کنی، به ناگهان بخت جوان و نیک‌سرشتت را از تجربه و علم پیر و بزرگ‌سال به دست خواهی آورد."],[429,"چون فراموش خودی یادت کنند","بنده گشتی آنگه آزادت کنند","زمانی که خودت را فراموش کنی و دیگران به یاد تو بیفتند، به مقام بندگی می‌رسی و در این حالت به تو آزادی می‌دهند."],[430,"انبیا گفتند با خاطر که چند","می‌دهیم این را و آن را وعظ و پند","پیامبران با خودشان فکر می‌کردند که چقدر برای پیش بردن پیام‌هایشان، نصیحت و موعظه کنند و چه اندازه تلاش کنند."],[430,"چند کوبیم آهن سردی ز غی","در دمیدن در قفص هین تا به کی","هرچند تلاش می‌کنیم که با سخنان و نصیحت‌هایمان، مردم را متوجه حقایق کنیم و آنها را برانگیزیم، اما تا کی می‌توانیم بی‌نتیجه صدا کنیم و بی‌فایده تلاش کنیم؟"],[430,"جنبش خلق از قضا و وعده است","تیزی دندان ز سوز معده است","آفرینش و حرکت انسان‌ها ناشی از قضا و قدر الهی و وعده‌های خداوند است، در حالی که احساسات و خواسته‌های درونی نیز مانند درد یا سوزش معده می‌توانند به تحرکات و واکنش‌ها منجر شوند."],[430,"نفس اول راند بر نفس دوم","ماهی از سر گنده باشد نه ز دم","نفس اول، بر نفس دوم تسلط می‌یابد مانند ماهی‌ای که بزرگ است و از سرش برمی‌آید، نه از دمی که کوچک است. یعنی تأثیر و قدرت یک نفس بر دیگری بستگی به عظمت و تأثیرگذاری او دارد."],[430,"لیک هم می‌دان و خر می‌ران چو تیر","چونک بلغ گفت حق شد ناگزیر","اگرچه هم‌اکنون می‌دانند که حقیقت چیست، اما مانند یک الاغ در حال حرکت به سمت مقصد هستند و همچنان باید به سمت راستا بروند؛ چرا که اگر حق را بشنوند، ناگزیر از پذیرش آن خواهند بود."],[430,"تو نمی‌دانی کزین دو کیستی","جهد کن چندانک بینی چیستی","تو نمی‌دانی که از این دو گروه (مؤمنان و منکران) کدامی، پس سعی کن تا به آنچه که هستی پی ببری."],[430,"چون نهی بر پشت کشتی بار را","بر توکل می‌کنی آن کار را","وقتی که بار را بر پشت کشتی می‌گذاری، باید به خداوند اعتماد کنی و به تصمیم خود ایمان داشته باشی."],[430,"تو نمی‌دانی که از هر دو کیی","غرقه‌ای اندر سفر یا ناجیی","تو از وضعیت خود و سرنوشتت آگاه نیستی، آیا در این سفر غرق می‌شوی یا نجات پیدا می‌کنی."],[430,"گر بگویی تا ندانم من کیم","بر نخواهم تاخت در کشتی و یم","اگر بگویی که من کیستم و نمی‌دانم، هرگز در کشتی طوفان یا در دریا نخواهم رفت."],[430,"من درین ره ناجیم یا غرقه‌ام","کشف گردان کز کدامین فرقه‌ام","من در این راه یا نجات یافته‌ام یا غرق شده‌ام، تو به من نشان بده که از کدام گروه یا طایفه هستم."],[430,"من نخواهم رفت این ره با گمان","بر امید خشک همچون دیگران","من نمی‌خواهم مثل دیگران بدون یقین و تنها بر اساس امید به این راه بروم، زیرا امید من باید واقعی و معنادار باشد."],[430,"هیچ بازرگانیی ناید ز تو","زانک در غیبست سر این دو رو","هیچ بازرگانی به سراغ تو نمی‌آید، زیرا در غیب و نهان، رازی وجود دارد که او از آن بی‌خبر است."],[430,"تاجر ترسنده‌طبع شیشه‌جان","در طلب نه سود دارد نه زیان","تاجر با طبع ترسویی که قلبش مانند شیشه نازک و آسیب‌پذیر است، در جست‌وجوی چیزی نیست و نه سودی به دست می‌آورد و نه زیانی می‌بیند."],[430,"بل زیان دارد که محرومست و خوار","نور او یابد که باشد شعله‌خوار","اگر کسی از حقیقت دور باشد، نه تنها سودی ندارد بلکه به خاطر محرومیت و ذلتش، روحش مانند شعلۀ آتش‌خوار می‌شود که به نور و روشنی نرسیده است."],[430,"چونک بر بوکست جمله کارها","کار دین اولی کزین یابی رها","چون بر توکل و اعتماد فقط به خداست، همه کارهای دین و دنیایت به خوبی پیش خواهد رفت و از مشکلات رهایی می‌یابی."],[430,"نیست دستوری بدینجا قرع باب","جز امید الله اعلم بالصواب","در اینجا هیچ دستوری برای ورود به این موضوع وجود ندارد جز امید به خداوند که خود داناترین به درست و نادرست است."],[431,"داعی هر پیشه اومیدست و بوک","گرچه گردنشان ز کوشش شد چو دوک","هر کسی در حرفه‌اش امیدوار به روزی است و هرچند گردنشان به خاطر تلاش در کارهایشان همچون دوکی (که می‌چرخد و زحمت می‌کشد) خم شده، ولی باز هم به کوشش ادامه می‌دهند."],[431,"بامدادان چون سوی دکان رود","بر امید و بوک روزی می‌دود","هنگام صبح، زمانی که به سمت دکان می‌رود، به امید کسب روزی و مال حرکت می‌کند."],[431,"بوک روزی نبودت چون می‌روی","خوف حرمان هست تو چونی قوی","زمانی که تو برای کسب روزی می‌روی، اگر روزی پیدا نکنی، ترس از کمبود و عدم موفقیت وجود دارد؛ تو چقدر قوی هستی که می‌توانی بر این ترس غلبه کنی."],[431,"خوف حرمان ازل در کسب لوت","چون نکردت سست اندر جست و جوت","ترس از فقدان نعمت‌های جاودانی، چرا در تلاش برای به‌دست‌آوردن روزی‌ات سست و ضعیفت کرده است؟"],[431,"گویی گرچه خوف حرمان هست پیش","هست اندر کاهلی این خوف بیش","اگرچه ترس از محرومیت همیشه وجود دارد، اما در بی‌تحرکی و تنبلی، این ترس بیشتر می‌شود."],[431,"هست در کوشش امیدم بیشتر","دارم اندر کاهلی افزون خطر","در تلاش برای رسیدن به امید، احساس می‌کنم که اگر تسلیم کسالت شوم، خطر بیشتری زیادی به وجود می‌آید."],[431,"پس چرا در کار دین ای بدگمان","دامنت می‌گیرد این خوف زیان","چرا در مورد دین چنین بدبین هستی که این ترس از ضرر به دامنت چسبیده است؟"],[431,"یا ندیدی کاهل این بازار ما","در چه سودند انبیا و اولیا","آیا توجه نکرده‌ای که این کاهل (تن lazy) در بازار دین، چه سودی از پیامبران و اولیا می‌برد؟"],[431,"زین دکان رفتن چه کانشان رو نمود","اندرین بازار چون بستند سود","از این دکان (دنیا) رفتن چه فایده‌ای دارد، اگر در این بازار (زندگی) سودی نباشد از آنچه آن‌ها (انبیا و اولیا) نشان دادند؟"],[431,"آتش آن را رام چون خلخال شد","بحر آن را رام شد حمال شد","آتش مانند زنجیری نرم و قابل انعطاف می‌شود، و دریا هم به فرمان می‌آید و بارکش می‌شود."],[431,"آهن آن را رام شد چون موم شد","باد آن را بنده و محکوم شد","آهن هنگامی که نرم شود مانند موم قابل شکل‌گیری است و باد نیز زمانی که تحت کنترل درآید، به دست آنچه می‌خواهد، می‌تواند هدایت شود."],[432,"قوم دیگر سخت پنهان می‌روند","شهره خلقان ظاهر کی شوند","بعضی از مردم به طور جدی و مخفیانه زندگی می‌کنند و هرگز در برابر مردم شناخته نمی‌شوند."],[432,"این همه دارند و چشم هیچ کس","بر نیفتد بر کیاشان یک نفس","این افراد دانشی عظیم و ویژگی‌های خاص دارند، اما هیچ‌کس از آن‌ها آگاه نیست و کسی جز خداوند از حالشان خبر ندارد."],[432,"هم کرامتشان هم ایشان در حرم","نامشان را نشنوند ابدال هم","کرامت و مقامات بلند این اولیای خدا در حرم امن الهی، به گونه‌ای است که حتی نام آن‌ها هم در بین ابدال (افراد برتر و معنوی) شنیده نمی‌شود."],[432,"یا نمی‌دانی کرمهای خدا","کو ترا می‌خواند آن سو که بیا","شاید نمی‌دانی که نعمت‌ها و لطف‌های خداوند کجا هستند و او تو را به سمت چه چیزهایی دعوت می‌کند."],[432,"شش جهت عالم همه اکرام اوست","هر طرف که بنگری اعلام اوست","تمام جهات جهان نشانه بزرگواری و احسان الهی هستند و در هر مکانی که نگاه کنی، آثار و علائم خداوند خود را نمایان می‌سازد."],[432,"چون کریمی گویدت آتش در آ","اندر آ زود و مگو سوزد مرا","اگر کریم و بخشنده‌ای به تو بگوید که به آتش نزدیک شو و وارد آن شو، نباید با خودت بگویی که آتش مرا خواهد سوزاند."],[433,"از انس فرزند مالک آمدست","که به مهمانی او شخصی شدست","انس فرزند مالک (یکی از صحابه پیامبر) به مهمانی آمده است."],[433,"او حکایت کرد کز بعد طعام","دید انس دستارخوان را زردفام","انس به دیگران گفت که بعد از صرف غذا، دیدم سفره کمی زرد شده است، که نشان‌دهنده‌ی اثر چربی و غذاست."],[433,"چرکن و آلوده گفت ای خادمه","اندر افکن در تنورش یک‌دمه","انس، که در داستان اشاره شده، به خادمه می‌گوید که پارچه‌ی چرک و کثیف را در تنور بگذارد تا یک لحظه هم که شده، در آتش بسوزد."],[433,"در تنور پر ز آتش در فکند","آن زمان دستارخوان را هوشمند","انس بن مالک (رضی الله عنه) در آن زمان دستار خود را که به عنوان نشانه‌ای از مقام و احترامش بود، در تنور پر از آتش انداخت."],[433,"جمله مهمانان در آن حیران شدند","انتظار دود کندوری بدند","همه مهمانان در آنجا شگفت‌زده و گیج شدند و انتظار داشتند که دود زیادی از تنور بلند شود."],[433,"بعد یکساعت بر آورد از تنور","پاک و اسپید و از آن اوساخ دور","پس از یک ساعت، او (انس بن مالک) دستار را از تنور بیرون آورد که کاملا تمیز و سفید بود و هیچ اثری از کثیفی نداشت."],[433,"قوم گفتند ای صحابی عزیز","چون نسوزید و منقی گشت نیز","قوم گفتند ای یاران نزدیک پیغمبر، چگونه است که این مندیل نسوخته و پاک و سفید شده است؟"],[433,"گفت زانک مصطفی دست و دهان","بس بمالید اندرین دستارخوان","گفتند که چون پیامبر اسلام، محمد (مصطفی)، دست و دهانش را به این دستار (پارچه) مالید، این کار موجب شد که او نسوزد."],[433,"ای دل ترسنده از نار و عذاب","با چنان دست و لبی کن اقتراب","ای دل که از ترس آتش و عذاب می‌لرزی، با چنین دستان و لب‌هایی به خدا نزدیک شو و تقرب بجو."],[433,"چون جمادی را چنین تشریف داد","جان عاشق را چه‌ها خواهد گشاد","چون به موجودات بی‌جان این‌چنین احترام و مقام داده شده است، جان عاشق به‌راستی چه‌همه قابلیت‌ها و راه‌های معرفتی را خواهد یافت و گشایش می‌یابد."],[433,"مر کلوخ کعبه را چون قبله کرد","خاک مردان باش ای جان در نبرد","هرچند که کعبه به عنوان قبله و مقدس‌ترین مکان در اسلام شناخته می‌شود، اما خاک آن (کلوخ کعبه) را هم می‌توان در نبرد و سختی‌ها به عنوان نماد قدسی در نظر گرفت. بنابراین، ای جان، باید خود را به مقام بلند مردانگی برسانی و در برابر چالش‌ها مقاومت کنی."],[433,"بعد از آن گفتند با آن خادمه","تو نگویی حال خود با این همه","بعد از آن، گفتند تو با این خادمه نباید از حال خود صحبت کنی، با این وجود خیلی چیزها در دل داری."],[433,"چون فکندی زود آن از گفت وی","گیرم او بردست در اسرار پی","چون تو به‌سرعت آن چیز را از دست او به زمین انداختی، پس می‌پذیرم که او به دستش رازهایی در خود دارد."],[433,"این‌چنین دستارخوان قیمتی","چون فکندی اندر آتش ای ستی","این‌گونه که تو دستار یا پارچه قیمتی‌ات را به آسانی در آتش می‌اندازی، یعنی به سادگی و بدون توجه به ارزش آن، نشان می‌دهد که چقدر بی‌پروا هستی."],[433,"گفت دارم بر کریمان اعتمید","نیستم ز اکرام ایشان ناامید","من به کریمان (بخشندگان) اعتماد دارم و هیچ‌گاه از احسان و جود آن‌ها ناامید نیستم."],[433,"میزری چه بود اگر او گویدم","در رو اندر عین آتش بی ندم","اگر من به خدا بگویم که در آتش نمی‌سوزم، پس چه فایده‌ای دارد؟ در واقع، با وجود خطرات و امتحانات، من به او اعتماد دارم."],[433,"اندر افتم از کمال اعتمید","از عباد الله دارم بس امید","من به خاطر کمال اعتمادی که دارم، در دامن خداوند و بندگان خوب او می‌افتم و از این امر بسیار امیدوارم."],[433,"سر در اندازم نه این دستارخوان","ز اعتماد هر کریم رازدان","من سر پایین می‌اندازم و به این دستار (نوعی پارچه یا پوشش) نمی‌پردازم، چون به اعتماد هر انسان بزرگوار و فهیم (کریم رازدان) اطمینان دارم."],[433,"ای برادر خود برین اکسیر زن","کم نباید صدق مرد از صدق زن","ای برادر، در این روزگار، بهترین و گرانبهاترین چیزها را نمی‌توان از کم‌لطفی زن کم دانست؛ زیرا صداقت مرد وابسته به صداقت زن است."],[433,"آن دل مردی که از زن کم بود","آن دلی باشد که کم ز اشکم بود","دل مردی که محبت و صداقت او از محبت زن کمتر باشد، دلی است که به اندازه اشک‌ها، یعنی اندکی، احساس و عاطفه دارد."],[434,"اندر آن وادی گروهی از عرب","خشک شد از قحط بارانشان قرب","در آن دره، گروهی از عرب به خاطر کمبود باران و خشکسالی، به شدت تشنه و از شدت عطش در حالت سختی قرار گرفته‌اند."],[434,"در میان آن بیابان مانده","کاروانی مرگ خود بر خوانده","در وسط آن بیابان، کاروانی گرفتار شده و چنان در شرایط سخت و بی‌آبی به سر می‌برد که به مرگ خود فکر می‌کند."],[434,"ناگهانی آن مغیث هر دو کون","مصطفی پیدا شد از ره بهر عون","ناگهان پیامبر اسلام، که یاری‌دهنده دو جهان است، از راه پیدا شد تا به آنها کمک کند."],[434,"دید آنجا کاروانی بس بزرگ","بر تف ریگ و ره صعب و سترگ","کاروانی بزرگ را دید که در میان شن‌ها و راه دشوار و پر خطر در حال حرکت بود."],[434,"اشترانشان را زبان آویخته","خلق اندر ریگ هر سو ریخته","شتران آن کاروان زبانشان را بیرون آورده و به شدت تشنه و ناتوان شده بودند. مردم هم در بیابان هر جا که می‌توانستند، افتاده و بی‌حالی را نشان می‌دادند."],[434,"رحمش آمد گفت هین زوتر روید","چند یاری سوی آن کثبان دوید","پیامبر با رحمتی که داشت، به کاروان فرمان داد که زودتر حرکت کنند و به سوی تپه‌های شن بروند تا به آب برسند."],[434,"گر سیاهی بر شتر مشک آورد","سوی میر خود به زودی می‌برد","اگر شتر سیاه مشک بیاورد، به زودی او را به سمت صاحبش می‌برد."],[434,"آن شتربان سیه را با شتر","سوی من آرید با فرمان مر","آن شتربان سیاه‌پوست را با شتر به سوی من بیاورید به دستور من."],[434,"سوی کثبان آمدند آن طالبان","بعد یکساعت بدیدند آنچنان","آن کسانی که تشنه بودند، بعد از یک ساعت به تپه‌های شن نزدیک شدند و دیدند که وضعشان از پیش مشخص است و به آب رسیده‌اند."],[434,"بنده‌ای می‌شد سیه با اشتری","راویه پر آب چون هدیه‌بری","بنده‌ای سیاه‌پوست به همراه شتری که بار آب داشت، به منظور هدیه دادن به دیگران به سوی آنها می‌رفت."],[434,"پس بدو گفتند می‌خواند ترا","این طرف فخر البشر خیر الوری","به او گفتند که این پیامبر، بهترین مخلوق خدا، تو را می‌خواند."],[434,"گفت من نشناسم او را کیست او","گفت او آن ماه‌روی قندخو","شخصی در پاسخ به دیگران می‌گوید که من این فرد را نمی‌شناسم، او کیست؟ و در جواب به او می‌گویند که او همان شخص زیبای چون ماه و شیرین‌گوی است."],[434,"نوعها تعریف کردندش که هست","گفت مانا او مگر آن شاعرست","گروهی در مورد کسی که ناشناس مانده، صحبت می‌کنند و می‌گویند که ممکن است او همان شاعری باشد که ویژگی‌های خاصی دارد."],[434,"که گروهی را زبون کرد او بسحر","من نیایم جانب او نیم شبر","گروهی از مردم را به خاطر سحر و جادو زبون و ناتوان کرده است و من به خاطر او هرچند اندک، به سمت او نمی‌آیم."],[434,"کش‌کشانش آوریدند آن طرف","او فغان برداشت در تشنیع و تف","آن رسول را به زور به طرف خود آوردند و او در حال تشنگی و بی‌آبی فریاد زد و شکایت کرد."],[434,"چون کشیدندش به پیش آن عزیز","گفت نوشید آب و بردارید نیز","وقتی او را به سمت آن شخص محترم کشیدند، گفت که آب بنوشید و همچنین چیزی دیگر بردارید."],[434,"جمله را زان مشک او سیراب کرد","اشتران و هر کسی زان آب خورد","همه شتران و انسان‌ها از آن مشک آب سیراب شدند و هر فردی از آن آب نوشید."],[434,"راویه پر کرد و مشک از مشک او","ابر گردون خیره ماند از رشک او","راویه (ظرف آب) را پر کرد و مشک (ظرف بزرگ) از آب او پر شد، ابر آسمان از روی حسادت به او متعجب ماند."],[434,"این کسی دیدست کز یک راویه","سرد گردد سوز چندان هاویه","کسی را دیده‌ام که با یک راویه (ظرف آب) چگونه می‌تواند سرما و خنکی را به وجود آورد و از گرمای سوزان بهشتی رهایی یابد."],[434,"این کسی دیدست کز یک مشک آب","گشت چندین مشک پر بی اضطراب","این کس که می‌بینید از خداوند یک مشک آب گرفته، ولی آنقدر سرشار از رحمت و برکت شده که چندین مشک آب پر می‌شود بدون هیچ اضطرابی."],[434,"مشک خود روپوش بود و موج فضل","می‌رسید از امر او از بحر اصل","مشک در اینجا به عنوان پوشش و حجاب عمل می‌کند و معنای آن این است که فضل و نعمت‌های الهی از دستور و اراده او (خدا) به ما می‌رسد، مثل امواجی که از دریا به سوی ما می‌آید."],[434,"آب از جوشش همی‌گردد هوا","و آن هوا گردد ز سردی آبها","آب به خاطر جوشش و حرکتش، هوا را به وجود می‌آورد و این هوا ناشی از سردی آب‌هاست."],[434,"بلک بی علت و بیرون زین حکم","آب رویانید تکوین از عدم","آب به خودی خود از هیچ و عدم به وجود آمده و رشد کرده است، نه به خاطر علل و اسبابی که مردم بر آن تأکید دارند."],[434,"تو ز طفلی چون سببها دیده‌ای","در سبب از جهل بر چفسیده‌ای","تو از کودکی نشانه‌های علت و سبب را دیده‌ای، اما به خاطر نادانی و جهل، به آن‌ها وابسته و چسبیده‌ای."],[434,"با سببها از مسبب غافلی","سوی این روپوشها زان مایلی","تو با وجود اینکه علل و اسباب را می‌شناسی، به مسبب اصلی (خدا) توجه نداری و به این ظواهر و روکش‌ها تمایل داری."],[434,"چون سببها رفت بر سر می‌زنی","ربنا و ربناها می‌کنی","وقتی به بی‌سبب به سوی خدا می‌روی و می‌خواهی دعا کنی، در واقع از علل و اسباب غافل شده‌ای."],[434,"رب می‌گوید برو سوی سبب","چون ز صنعم یاد کردی ای عجب","خداوند می‌فرماید وقتی به یاد من باشی، باید به سوی علل و اسباب بروی و برای مشکلاتت تلاش کنی، چون این موضوع برای من شگفت‌آور است که فقط به من تکیه کنی بدون اینکه به کارهای عملی بپردازی."],[434,"گفت زین پس من ترا بینم همه","ننگرم سوی سبب و آن دمدمه","گفت از این به بعد من فقط تو را می‌بینم و دیگر به امور دنیوی و علل و اسباب توجهی نخواهم داشت."],[434,"گویدش ردوا لعادوا کار تست","ای تو اندر توبه و میثاق سست","رسول (ص) به او می‌گوید که از گناه بازگرد و به عهد خود پابند باش، زیرا تو در توبه و پیمان خود سست بوده‌ای."],[434,"لیک من آن ننگرم رحمت کنم","رحمتم پرست بر رحمت تنم","اما من به آن جنبه بد را نمی‌بینم و فقط بر رحمت خداوند تکیه می‌کنم، زیرا لطف و رحمت او بر روی من بسیار بزرگ و گسترده است."],[434,"ننگرم عهد بدت بدهم عطا","از کرم این دم چو می‌خوانی مرا","من به بدی‌ها و عهدهای ناپسند تو نگاه نمی‌کنم و نمی‌خواهم به خاطر آن‌ها از لطف خود چیزی به تو ببخشم، بلکه چون این لحظه مرا می‌خوانی، از روی بخشش و بزرگواری به تو عطا می‌کنم."],[434,"قافله حیران شد اندر کار او","یا محمد چیست این ای بحر خو","کاروان در شگفت‌زدگی و حیرت از او (پیامبر محمد) است و از خود می‌پرسند: «این چه دریایی است که تویی؟» اشاره به ویژگی‌ها و عظمت پیامبر دارند."],[434,"کرده‌ای روپوش مشک خرد را","غرقه کردی هم عرب هم کرد را","در این بیت، اشاره به این است که تو (محمد) توانسته‌ای مشک (نماد آب) را بپوشانی و باعث شده‌ای که هم عرب‌ها و هم کردها (الحقایق) در زندگی با مشکل مواجه شوند. به این معنا که تاثیر تو بر مشکلات و چالش‌ها به گونه‌ای بوده که همه اقوام را تحت تأثیر قرار داده است."],[435,"ای غلام اکنون تو پر بین مشک خود","تا نگویی درشکایت نیک و بد","ای غلام، اکنون مشکی که در دست داری را خوب ببین تا در شکایت از خوب و بد چیزی نگوئی."],[435,"آن سیه حیران شد از برهان او","می‌دمید از لامکان ایمان او","غلام سیاه، به سبب دلایل و نشانه‌های قدرت مولانا حیرت‌زده شد و از ایمان و اعتقاد او به وجود چیزهایی فراتر از عالم مادی، قوت و روح تازه‌ای می‌گرفت."],[435,"چشمه‌ای دید از هوا ریزان شده","مشک او روپوش فیض آن شده","او چشمه‌ای را دید که از آسمان می‌ریزد و مشک او (غلام سیاه) به خاطر آن چشمه، پوشش فیض و برکت را پیدا کرده است."],[435,"زان نظر روپوشها هم بر درید","تا معین چشمه غیبی بدید","به خاطر آن نظر، پرده‌ها و موانع کنار رفت و او چشمه‌ای از غیب را مشاهده کرد."],[435,"چشمها پر آب کرد آن دم غلام","شد فراموشش ز خواجه وز مقام","غلام در آن لحظه چشمانش پر از اشک شد و به قدری تحت تأثیر قرار گرفت که مقام و جایگاه خواجه را فراموش کرد."],[435,"دست و پایش ماند از رفتن به راه","زلزله افکند در جانش اله","غلام به دلیل شگفتی از معجزه‌ای که دیده، توان حرکت از جای خود را ندارد و مانند زلزله‌ای در وجودش رخ می‌دهد که او را به شدت دچار ترس و حیرت می‌کند."],[435,"باز بهر مصلحت بازش کشید","که به خویش آ باز رو ای مستفید","به خاطر مصلحت دوباره او را به سمت خود کشیدند تا به خود بازگردد، ای کسی که از این وضعیت بهره‌مند می‌شوی."],[435,"وقت حیرت نیست حیرت پیش تست","این زمان در ره در آ چالاک و چست","شما در حال حیرت و تعجب هستید، اما وقت آن است که از این حالت خارج شوید. اکنون وقت عمل و ورود به راهی است که باید با هوشیاری و سرعت آن را بپیمایید."],[435,"دستهای مصطفی بر رو نهاد","بوسه‌های عاشقانه بس بداد","دست‌های پیامبر، یعنی مصطفی، بر چهره او گذاشته شد و به او بوسه‌های عاشقانه‌ای عطا کرد."],[435,"مصطفی دست مبارک بر رخش","آن زمان مالید و کرد او فرخش","پیامبر (مصطفی) در آن زمان با دست مبارک خود بر صورت آن غلام سیاه مالید و او را درخشان و زیبا کرد."],[435,"شد سپید آن زنگی و زاده حبش","همچو بدر و روز روشن شد شبش","غلام سیاه‌پوست (زنگی) که از سرزمین حبشه آمده بود، به لطف و معجزه‌ای، به زیبایی و روشنی چهره‌اش مانند ماه و روز روشن تبدیل شد."],[435,"یوسفی شد در جمال و در دلال","گفتش اکنون رو بده وا گوی حال","غلام سیاه به زیبایی و خوش‌رویی یوسف تبدیل شد و از او خواسته می‌شود که حال خود را بیان کند و بگوید چه بر او گذشته است."],[435,"او همی‌شد بی سر و بی پای مست","پای می‌نشناخت در رفتن ز دست","او به حال مستی و بی‌خبری می‌افتاد که دیگر نه سرش را حس می‌کرد و نه پایش را؛ نمی‌توانست به درستی قدم بردارد و از دست او خارج می‌شد."],[435,"پس بیامد با دو مشک پر روان","سوی خواجه از نواحی کاروان","او، که در حال مستی و بی‌خبر از خود بوده، اکنون با دو مشکی پر از آب روان به سوی خواجه (مالک یا شخص مهمی) از سمت کاروان می‌آید."],[436,"خواجه از دورش بدید و خیره ماند","از تحیر اهل آن ده را بخواند","خواجه از دور غلام خود را دید و به خاطر حیرت و شگفتی نتوانست حرکت کند و از آنجا اهل آن ده را فراخواند."],[436,"راویه ما اشتر ما هست این","پس کجا شد بنده زنگی‌جبین","ما می‌گوییم که راوی و شاهد ما یک شتر است، پس حالا بگویید این بنده‌ای که چهره‌اش مانند زنگی‌هاست (غلام سیاه‌چهره) کجا رفت؟"],[436,"این یکی بدریست می‌آید ز دور","می‌زند بر نور روز از روش نور","این شخص، مثل یک ستاره روشن است که از دور می‌آید و با تابش نورش، بر luminosity یک روز روشنی می‌افزاید."],[436,"کو غلام ما مگر سرگشته شد","یا بدو گرگی رسید و کشته شد","آیا غلام ما سرگشته و گم شده است یا اینکه به دست گرگی کشته شده؟"],[436,"چون بیامد پیش گفتش کیستی","از یمن زادی و یا ترکیستی","وقتی او پیش آمد، از او پرسید کیستی؟ آیا از یمن هستی یا ترک؟"],[436,"گو غلامم را چه کردی راست گو","گر بکشتی وا نما حیلت مجو","از او بپرس که با غلام من چه کرده‌ای؛ صادقانه بگو. اگر او را کشته‌ای، بی‌هیچ ترفندی بگو که چه کرده‌ای."],[436,"گفت اگر کشتم بتو چون آمدم","چون به پای خود درین خون آمدم","گفت اگر من تو را کشته‌ام، چطور به اینجا آمدم؟ چون پای خود را در این خون گذاشتم."],[436,"کو غلام من بگفت اینک منم","کرد دست فضل یزدان روشنم","او (غلام) می‌گوید که من همین‌جا هستم و خودم را به‌عنوان غلام معرفی می‌کند، و همچنین به روشنایی و فضل الهی اشاره می‌کند که موجب وجود او شده است."],[436,"هی چه می‌گویی غلام من کجاست","هین نخواهی رست از من جز براست","تو چرا می‌گویی غلام من کجاست؟ هین! از من هیچ رهایی نخواهی داشت جز اینکه حقیقت را بگویی."],[436,"گفت اسرار ترا با آن غلام","جمله وا گویم یکایک من تمام","من تمام اسرار تو را به آن غلام می‌گویم و همه را به‌طور کامل و جزء به جزء برای او توضیح می‌دهم."],[436,"زان زمانی که خریدی تو مرا","تا به اکنون باز گویم ماجرا","از زمانی که تو من را خریدی، تا حالا می‌خواهم داستانی را برایت بازگو کنم."],[436,"تا بدانی که همانم در وجود","گرچه از شبدیز من صبحی گشود","اگر متوجه حالت و وجود من شوی، می‌فهمی که من همان وجود اصلی‌ام هستم، هرچند که از اسب شبدیز (اسب زیبا) من نور صبحی به وجود آمده است."],[436,"رنگ دیگر شد ولیکن جان پاک","فارغ از رنگست و از ارکان و خاک","روح انسانی از تغییرات ظاهری و تنوعات مادی بی‌نزار است و همیشه خالص و دور از وابستگی به رنگ‌ها و عناصر خاکی باقی می‌ماند."],[436,"تن‌شناسان زود ما را گم کنند","آب‌نوشان ترک مشک و خم کنند","شناساندن بدن و ظاهر شخص باعث می‌شود که به‌راحتی افرادی مثل ما را فراموش کنند؛ اما کسانی که به سیراب کردن دل و روح توجه دارند، از زیبایی‌ها و زینت‌های دنیوی (همچون مشک و شراب) غافل نمی‌شوند."],[436,"جان‌شناسان از عددها فارغ‌اند","غرقه دریای بی‌چونند و چند","دست‌یابدن به فهم جان و حقیقت برای جان‌شناسان به معنای رها شدن از عددها و اندازه‌گیری‌های دنیوی است. آنها در عمق دریای وجود غرق شده‌اند و از محدودیت‌های فکری و عددی آزادند."],[436,"جان شو و از راه جان جان را شناس","یار بینش شو نه فرزند قیاس","روح خود را آزاد کن و تا به وجود واقعی و معانی عمیق پی ببری، باید از علم تجربی و منطقی فراتر بروی. با درک عمیق و بصیرت جدید به زندگی نگاه کن، نه با استناد به تجربیات و مقایسه‌های منطقی."],[436,"چون ملک با عقل یک سررشته‌اند","بهر حکمت را دو صورت گشته‌اند","چون ملک (فرشتگان) و عقل (دانش و خرد) در یک ریشه و اصل مشترک قرار دارند، هر حکمت و دانشی به دو شکل و نمود متفاوت درمی‌آید."],[436,"آن ملک چون مرغ بال و پر گرفت","وین خرد بگذاشت پر و فر گرفت","این ملک، مانند مرغی بال و پر گرفته است و عقل و خرد را رها کرده و به خیال و خیال‌پردازی می‌پردازد."],[436,"لاجرم هر دو مناصر آمدند","هر دو خوش رو پشت همدیگر شدند","بنابراین، هر دو گروه (ملک و عقل) با هم به میدان نبرد آمده و به زیبایی و با روی خوش در کنار یکدیگر قرار گرفتند."],[436,"هم ملک هم عقل حق را واجدی","هر دو آدم را معین و ساجدی","هم ملک و هم عقل، وجود حق را دارند و هر دو، به آدم کمک کرده و او را مورد ستایش قرار می‌دهند."],[436,"نفس و شیطان بوده ز اول واحدی","بوده آدم را عدو و حاسدی","نفس و شیطان از ابتدا یک ویژگی داشتند و در حقیقت دشمن و حسود آدم بودند."],[436,"آنک آدم را بدن دید او رمید","و آنک نور مؤتمن دید او خمید","چون آدم را فقط از ظاهر بدنش دید، فرار کرد و وقتی که نور با امانت را دید، تسلیم شد."],[436,"آن دو دیده‌روشنان بودند ازین","وین دو را دیده ندیده غیر طین","آن دو نفر که چشم‌های روشنی دارند (به معنای درک و بینش بالا) از این حد و مرز فراتر رفته‌اند و این دو را فقط افرادی که درک عمیقی دارند، می‌توانند ببینند، نه آن‌هایی که فقط ظاهر را می‌بینند."],[436,"این بیان اکنون چو خر بر یخ بماند","چون نشاید بر جهود انجیل خواند","این گفته مانند خر بر روی یخ باقی می‌ماند و هیچ فایده‌ای ندارد، چون نمی‌شود به یهودی انجیل خواند."],[436,"کی توان با شیعه گفتن از عمر","کی توان بربط زدن در پیش کر","چگونه می‌توان با افرادی از اهل تشیع درباره عمر (خلیفه اول اسلامی) سخن گفت، همان‌طور که نمی‌توان در مقابل کر (کسی که ناشنواست) با ساز بربط (ساز موسیقی) نواخت؟ این بیان کنایه از دشواری یا ناممکن بودن بحث در موضوعات حساس و بحث‌برانگیز است."],[436,"لیک گر در ده به گوشه یک کسست","های هویی که برآوردم بسست","اگر در دهی تنها یک نفر با صدای بلند فریاد بزند و من نیز صدای او را بشنوم، نشان می‌دهد که آن شخص مهم است و توجه مرا جلب کرده است."],[436,"مستحق شرح را سنگ و کلوخ","ناطقی گردد مشرح با رسوخ","آنچه شایسته توضیح و تفسیر است، به مانند سنگ و کلوخ، بی‌صدا و خاموش است، اما آن را گوینده‌ای می‌تواند شرح دهد که در دلش عمیق و ریشه‌دار باشد."],[437,"آن نیاز مریمی بوده‌ست و درد","که چنان طفلی سخن آغاز کرد","آن‌چیزی که باعث شد طفلی به سخن‌گفتن بیاید، درد و نیاز مریمی بوده‌است."],[437,"جزو او بی او برای او بگفت","جزو جزوت گفت دارد در نهفت","جزو او بدون او برای او سخن‌گفت؛ تو نیز جزو جزوت سخن می‌گوید که پنهان است."],[437,"دست و پا شاهد شوندت ای رهی","منکری را چند دست و پا نهی","ای دوست، در روز قیامت دست و پا و جزو جزوت شهادت می‌دهند؛ منکری را چند دست و پا نهی؟ (دست و پا نهادن اصطلاح است؛ مصرع : «تا دست و پا نهاد دو زلف تو کفر را» از دیوان شمس است.)"],[437,"ور نباشی مستحق شرح و گفت","ناطقه ناطق ترا دید و بخفت","اگر شایسته سخن و گفت‌وگو نباشی، سخن‌ران و گوینده به تو نگاه کرد و خاموش شد."],[437,"هر‌چه رویید از پی محتاج رست","تا بیابد طالبی چیزی که جست","هر گیاهی که رویید برای نیاز و احتیاجی رویید‌، تا جوینده‌ای بیابد چیزی را که می‌جوید."],[437,"حق تعالی گر سماوات آفرید","از برای دفع حاجات آفرید","خداوند آسمان‌ها را با هدف برآوردن نیازها آفرید."],[437,"هر کجا دردی‌، دوا آنجا رود","هر کجا فقری‌، نوا آنجا رود","هر کجا که مشکلی وجود داشته باشد، تلاش برای حل آن مشکل شکل می‌گیرد و هر کجا که کسی دچار فقر یا کمبود باشد، روزی و غذا آنجا می‌رود."],[437,"هر کجا مشکل جواب آنجا رود","هر کجا کشتی‌ست‌، آب آنجا رود","هر جا که مشکل و سؤال وجود داشته باشد، حل آن مشکل و پاسخ نیز همان‌جا می‌رود و هر جایی که کشتی باشد، آب به سمت آنجا سرازیر می‌شود."],[437,"آب کم جو‌، تشنگی آور به‌دست","تا بجوشد آب از بالا و پست","به دنبال آب نگرد بلکه تشنگی به‌دست بیاور تا آب از بالا و پایین و از آسمان و از زمین به‌سوی تو بیاید."],[437,"تا نزاید طفلک نازک‌گلو","کی روان گردد ز پستان شیر او‌؟","تا طفل شیر‌خواره و نازک‌گلو متولد نشود؛ کی شیر در پستان روان می‌شود؟"],[437,"رو بدین بالا و پستی‌ها بدو","تا شوی تشنه و حرارت را گرو","برای رسیدن به مقام‌های بالا و پایین، باید به سوی آن کشیده شوی تا از این تشنگی و حرارت وجودی، بهره‌مند گردی."],[437,"بعد از آن از بانگ زنبور هوا","بانگ آب جو بنوشی ای کیا","پس از آنکه صدای زنبور را شنیدی، برای نوشیدن آب جوی به سمت آن برو، ای بزرگوار."],[437,"حاجت تو کم نباشد از حشیش","آب را گیری سوی او می‌کشیش","نیاز تو کمتر از نیاز گیاه نیست؛ که آب را به‌سوی گیاهان می‌بری."],[437,"گوش گیری آب را تو می‌کشی","سوی زرع خشک تا یابد خوشی","برای اینکه گیاه خشک و بی‌آب به رشد و سرزندگی برسد، باید به سمت آب بروی و آن را به سوی آن گیاه بیاوری تا خوشبختی و طراوت به آن برسد."],[437,"زرع جان را که‌ش جواهر مضمر‌ست","ابر رحمت پر ز آب کوثر‌ست","کشتزار جان آدمی که جواهر و گوهرهای پنهان دارد، ابر بخشش و رحمت الهی برای آن آب‌هایی گوارا دارد."],[437,"تا ‌«سقاهم ربهم‌» آید خطاب","تشنه باش‌، الله اعلم بالصواب","تا «خدای‌شان آنها را شرابی پاک بنوشاند» خطاب گردد، تشنه باش الله اعلم بالصواب (مصرع اول اشاره است به آیه ۲۱ سوره انسان؛ وسقاهم ربهم شرابا طهورا ‌)"],[438,"هم از آن ده یک زنی از کافران","سوی پیغامبر دوان شد ز امتحان","زنی از کافران به سمت پیامبر آمد و این حرکت او نشانه‌ای از امتحانی است که در آن قرار دارد."],[438,"پیش پیغامبر در آمد با خمار","کودکی دو ماه زن را بر کنار","زنی که دو ماهه کودکی در آغوش داشت، با چادر پوشیده به نزد پیامبر آمده بود."],[438,"گفت کودک سلم الله علیک","یا رسول الله قد جئنا الیک","کودک گفت: «سلام بر تو ای پیامبر خدا! ما به سوی تو آمده‌ایم."],[438,"مادرش از خشم گفتش هی خموش","کیت افکند این شهادت را بگوش","مادر کودک از خشم به او گفت که ساکت باشد و از او پرسید که چه کسی این شهادت را به گوش او انداخت."],[438,"این کیت آموخت ای طفل صغیر","که زبانت گشت در طفلی جریر","این که تو به این سن کم (طفل صغیر) زبانت به گفتن (شهادت) و بیان معانی رسا (جریر) آموخته شده، نشان‌دهنده معجزه‌ای است که یادگیری و بیان حقیقت را به تو عطا کرده است."],[438,"گفت حق آموخت آنگه جبرئیل","در بیان با جبرئیلم من رسیل","خداوند به من آموخت (چگونه سخن بگویم) و سپس فرشته جبرئیل در حال بیان به من گفت که من فرستاده‌ای از جانب خدا هستم."],[438,"گفت کو گفتا که بالای سرت","می‌نبینی کن به بالا منظرت","مولانا به بیان این می‌پردازد که جبرئیل به پیامبر (محمد صلی الله علیه و سلم) می‌گوید که آیا نمی‌بینی بالای سرت چه چیزی قرار دارد، و به او توصیه می‌کند که به‌سوی بالا بنگرد و منظره‌ای را که در آنجا وجود دارد، مشاهده کند."],[438,"ایستاده بر سر تو جبرئیل","مر مرا گشته به صد گونه دلیل","جبرئیل، فرشته وحی، در بالای سرت ایستاده و من به خاطر او به هزاران دلیل مختلف، به تو سخن می‌گویم و به تو نور و راهنمایی می‌رسانم."],[438,"گفت می‌بینی تو گفتا که بلی","بر سرت تابان چو بدری کاملی","آن زن کافر به پیامبر (ص) گفت که آیا تو را می‌بینم؟ او پاسخ داد که بله، تو تابان و درخشان مانند ماه کامل بر سر من هستی."],[438,"می‌بیاموزد مرا وصف رسول","زان علوم می‌رهاند زین سفول","من از وصف رسول خدا (محمد) آموخته‌ام، و او با علم و دانشی که دارد، مرا از این اوضاع پایین و زشت (سفول) رهایی می‌بخشد."],[438,"پس رسولش گفت ای طفل رضیع","چیست نامت باز گو و شو مطیع","رسول خدا (ص) به آن کودک شیرخواره گفت: ای کودک، نامت چیست؟ بگو و به من اطاعت کن."],[438,"گفت نامم پیش حق عبدالعزیز","عبد عزی پیش این یک مشت حیز","گفت نامم عبدالعزیز است، که به معنای «بنده عزت» است. اما این نام به خاطر نام «عزی»، که نام یکی از بت‌هاست، به یک مشت زباله می‌ماند و از آن به دور است."],[438,"من ز عزی پاک و بیزار و بری","حق آنک دادت این پیغامبری","من از عزی (بت) پاک و از او بیزار و دور هستم، زیرا حق (خداوند) به تو، پیامبری (رسالت) داده است."],[438,"کودک دو ماهه همچون ماه بدر","درس بالغ گفته چون اصحاب صدر","کودک دو ماهه که مانند ماه شب کامل است، سخنی عاقلانه و بالغ می‌گوید، همان‌طور که اصحاب (یاران) پیامبر در اوایل اسلام صحبت می‌کردند."],[438,"پس حنوط آن دم ز جنت در رسید","تا دماغ طفل و مادر بو کشید","در آن لحظه، بوی خوش بهشتی (حنوط) به آنها رسید و بوی آن در بینی کودک و مادرش پیچید."],[438,"هر دو می‌گفتند کز خوف سقوط","جان سپردن به برین بوی حنوط","مادر و فرزند از ترس اینکه سقوط کنند، به عطر خوش حنوط (بوی عطر مخصوص برای تدفین) اشتیاق نشان می‌دادند و جان‌شان را به خاطر این بو از دست می‌دادند."],[438,"آن کسی را کش معرف حق بود","جامد و نامیش صد صدق زند","شخصی که حقیقت را می‌شناسد و به عقل و درایت آراسته است، ثباتش همچون سنگ است و در صدق و راستی با تمام وجود، ثابت و پایدار می‌ماند."],[438,"آنکسی را کش خدا حافظ بود","مرغ و ماهی مر ورا حارس شود","کسی که خدا نگهدارش باشد، از پرندگان و ماهی‌ها هم در امان است و آن‌ها هم از او محافظت خواهند کرد."],[439,"اندرین بودند کآواز صلا","مصطفی بشنید از سوی علا","در این بیت، اشاره به این است که در این بین، صدا و ندای پیامبر اسلام، حضرت مصطفی (ص)، از طرف علو و بلندی به گوش رسید."],[439,"خواست آبی و وضو را تازه کرد","دست و رو را شست او زان آب سرد","پیامبر خدا خواست وضو بگیرد و برای این کار، دست و صورتش را با آن آب سرد شست."],[439,"هر دو پا شست و به موزه کرد رای","موزه را بربود یک موزه‌ربای","او هر دو پا را شست و تصمیم گرفت به موزه برود. شخصی که می‌خواست موزه را بدزدد، موزه را از او گرفت."],[439,"دست سوی موزه برد آن خوش‌خطاب","موزه را بربود از دستش عقاب","مردی خوش‌صدا دستش را به سوی موزه دراز کرد و عقابی را که در آنجا بود، از دستان او ربود."],[439,"موزه را اندر هوا برد او چو باد","پس نگون کرد و از آن ماری فتاد","او (عقاب) موزه (محل نگهداری موزه‌ای) را در هوا به‌همراه خود برد، مانند باد، و سپس آن را به زمین انداخت و از آنجا ماری (مار سیاه) افتاد."],[439,"در فتاد از موزه یک مار سیاه","زان عنایت شد عقابش نیکخواه","عقاب در حالی که از موزه مصطفی (پیامبر اسلام) یک مار سیاه را به زمین می‌اندازد، به خاطر محبت و لطفی که دارد، این کار را انجام می‌دهد."],[439,"پس عقاب آن موزه را آورد باز","گفت هین بستان و رو سوی نماز","عقاب پس از این که آن مار سیاه را به آسمان برد، موزه را به زمین آورد و به او گفت: «برو و نمازت را بخوان."],[439,"از ضرورت کردم این گستاخیی","من ز ادب دارم شکسته‌شاخیی","من به خاطر نیازی که داشتم، این بی‌ادبی را انجام دادم و به همین دلیل در دلم حس شرمساری و نقص ادب وجود دارد."],[439,"وای کو گستاخ پایی می‌نهد","بی ضرورت کش هوا فتوی دهد","وای بر کسی که بدون دلیل و نیاز، پا به عرصه می‌گذارد و به بادها فرمان می‌دهد."],[439,"پس رسولش شکر کرد و گفت ما","این جفا دیدیم و بود این خود وفا","پیامبر (رسول) شکرگزاری کرد و گفت ما این آسیب را تحمل کردیم و همین مسأله خود نشانه‌ای از وفاداری و احترام است."],[439,"موزه بربودی و من درهم شدم","تو غمم بردی و من در غم شدم","عقاب را ربودند و من دچار نابودی شدم؛ تو غم مرا از بین بردی و من در اندوه افتادم."],[439,"گرچه هر غیبی خدا ما را نمود","دل در آن لحظه به خود مشغول بود","هرچند خداوند در غیبت ما نشانه‌هایی را به ما نشان می‌دهد، اما دل ما در آن لحظه تنها به خود مشغول است و به آن نشانه‌ها توجهی ندارد."],[439,"گفت دور از تو که غفلت در تو رست","دیدنم آن غیب را هم عکس تست","اگر بخواهم دور از تو بایستم و غفلت را از تو دور کنم، دیدن آن غیب (که اشاره به حقیقتی معنوی دارد) نیز مثل یک تصویر از تو خواهد بود."],[439,"مار در موزه ببینم بر هوا","نیست از من عکس تست ای مصطفی","مار را در موزه ببینم، اما او در آسمان نیست، زیرا این تصویر (مار) در واقع تصویر تو، ای مصطفی، است."],[439,"عکس نورانی همه روشن بود","عکس ظلمانی همه گلخن بود","عکس‌هایی که روشن و نورانی هستند، همیشه روشنی و خیر را نمایان می‌کنند، در حالی که عکس‌هایی که ظلمانی و تاریک‌اند، به معنای بدی و جهنم مثل گلخن (آتشکده) هستند."],[439,"عکس عبدالله همه نوری بود","عکس بیگانه همه کوری بود","تصویر عبدالله (پیامبر) پر از روشنی و نور است، در حالی که تصویر بیگانه (کسی که پیرو حق نیست) تماما در تاریکی و کوری و بی‌نوری به شمار می‌آید."],[439,"عکس هر کس را بدان ای جان ببین","پهلوی جنسی که خواهی می‌نشین","اگر می‌خواهی ویژگی‌های هر فرد را درک کنی، به شخصیت و جوهره او توجه کن، تا به درستی با دیگران ارتباط برقرار کنی."],[440,"عبرتست آن قصه ای جان مر ترا","تا که راضی باشی در حکم خدا","داستانی که نقل شده، برای عبرت گرفتن و درس‌آموزی است تا تو هم در برابر اتفاقات ناگوار راضی باشی به آنچه خداوند برای تو مقرر کرده است."],[440,"تا که زیرک باشی و نیکوگمان","چون ببینی واقعه بد ناگهان","(این قصه برای آن است تا بیاموزی که) زیرک و دانا و خوش‌بین باشی وقتی که واقعه‌ای بد برای تو رخ می‌دهد."],[440,"دیگران گردند زرد از بیم آن","تو چو گل خندان گه سود و زیان","دیگران در حوادث بد ناامید و وحشت‌زده می‌شوند‌، اما تو همچون گل چه در سود و چه در زیان شاد هستی."],[440,"زانک گل گر برگ برگش می‌کنی","خنده نگذارد نگردد منثنی","مثل گل وقتی که حتی برگ‌هایش کنده می‌شود خندان است."],[440,"گوید از خاری چرا افتم به‌غم","خنده را من خود ز خار آورده‌ام","که می‌گوید چرا از خار و حادثه‌ای بد غمناک شوم!؟ این شادی را من خود از غم به‌دست آورده‌ام."],[440,"هرچه از تو یاوه گردد از قضا","تو یقین دان که خریدت از بلا","هرچیزی‌که از دست بدهی‌ و تقدیر و قضاست؛ تو تردید مکن که آن، تو را از بلا حفظ کرده‌است."],[440,"ما التصوف قال وجدان الفرح","فی الفؤاد عند اتیان الترح","صوفی‌گری به معنای تجربه درونی است که انسان در دلش شادمانی را احساس می‌کند هنگامی که به سفر روحانی می‌رود."],[440,"آن عقابش را عقابی دان که او","در ربود آن موزه را زان نیک‌خو","آن عقاب و سختی را به عنوان آن عقاب در نظر بگیر که کفش‌ آن نیک‌سیرت را ربود."],[440,"تا رهاند پاش را از زخم مار","ای خنک عقلی که باشد بی غبار","تا پاهایش را از نیش و زخم مار مصون بدارد؛ خوشا بحال عقل و اندیشه‌ای که پاک باشد!"],[440,"گفت لا تاسوا علی ما فاتکم","ان اتی السرحان واردی شاتکم","نگران نباشید و بر گذشته‌ها افسوس نخورید، زیرا اگر گرگ‌ها به گله‌تان حمله‌آورند، به این معناست که درهای جدیدی نیز برای شما باز خواهد شد."],[440,"کان بلا دفع بلاهای بزرگ","و آن زیان منع زیانهای سترگ","که آن حادثه و بلا‌، مانع و دفع‌کننده بلاهای بزرگ‌تر است و آن زیان‌، مانع رسیدن زیان‌های سترگ."],[441,"گفت موسی را یکی مرد جوان","که بیاموزم زبان جانوران","یک جوان به موسی می‌گوید که می‌خواهم زبان جانوران را یاد بگیرم."],[441,"تا بود کز بانگ حیوانات و دد","عبرتی حاصل کنم در دین خود","می‌خواهم از صدای حیوانات و درندگان درس عبرتی بگیرم تا در دین خود بهره‌مند شوم."],[441,"چون زبان‌های بنی‌آدم همه","در پی آبست و نان و دمدمه","زبان‌های انسان‌ها همواره مشغول صحبت درباره نیازهای مادی مانند آب و نان و لذت‌ها هستند."],[441,"بوک حیوانات را دردی دگر","باشد از تدبیر هنگام گذر","حیوانات هنگامی که از کنار انسان‌ها عبور می‌کنند، درد و نیاز دیگری دارند که از تفکر و تدبیر انسان‌ها جداست."],[441,"گفت موسی رو گذر کن زین هوس","کاین خطر دارد بسی در پیش و پس","موسی به او می‌گوید که از این خواسته و اشتیاق رهایی یابد، زیرا این هوس ممکن است خطرات زیادی برای او به همراه داشته باشد."],[441,"عبرت و بیداری از یزدان طلب","نه از کتاب و از مقال و حرف و لب","بیداری و عبرت را باید از خداوند طلب کرد، نه از کتاب‌ها و حرف‌ها و گفته‌های زبانی."],[441,"گرم‌تر شد مرد زان منعش که کرد","گرم‌تر گردد همی از منع مرد","مرد از اینکه موسی او را از چیزی منع کرد، بیش از پیش برانگیخته و شوق او افزایش یافت. این منع، او را به سمت اشتیاق و حرارت بیشتری سوق داد."],[441,"گفت ای موسی چو نور تو بتافت","هر‌چه چیزی بود چیزی از تو یافت","مرد به موسی می‌گوید: ای موسی، هرچیزی که وجود دارد، نور تو بر آن تابیده و از تو تأثیر گرفته است."],[441,"مر مرا محروم کردن زین مراد","لایق لطفت نباشد ای جواد","محروم کردن من از این خواسته، شایسته‌ی لطف و مهربانی تو نیست، ای بخشنده."],[441,"این زمان قایم مقام حق توی","یاس باشد گر مرا مانع شوی","این زمان تو نماینده حق هستی، چنانکه یاس (گل یاس) در برابر من جذاب و زیباست، اگر مانع من شوی."],[441,"گفت موسی یا رب این مرد سلیم","سخره کردستش مگر دیو رجیم","موسی (پیامبر) می‌گوید: خدایا، این مرد پاک و سالم را مسخره کرده‌اند، آیا این رفتار ناشایست از جانب شیطان و دیو نیست؟"],[441,"گر بیاموزم زیان کارش بود","ور نیاموزم دلش بد می‌شود","اگر به او آموزش بدهم، این کار به ضرر او خواهد بود و اگر آموزش ندهیم، دلش ناراحت و نگران خواهد شد."],[441,"گفت ای موسی بیاموزش که ما","رد نکردیم از کرم هرگز دعا","مرد به موسی می‌گوید که باید به او یاد دهد، زیرا ما هرگز دعای کسی را به خاطر بزرگواری‌اش رد نکرده‌ایم."],[441,"گفت یا رب او پشیمانی خورد","دست خاید‌، جامه‌ها را بر‌درد","مردی از خدا خواسته که اگر موسی به دعاهای او توجه نکرد، به خاطر پشیمانی اش از رفتارهای ناپسندش، لباس‌هایش را پاره کند تا باشد که مورد رحمت قرار گیرد."],[441,"نیست قدرت هر کسی را سازوار","عجز بهتر مایه پرهیزکار","توانایی هر کسی با هم برابر نیست و این ناتوانی بهتر از فزونی و توانایی در گناه است. پرهیزکاران به خاطر توانایی‌های محدود خود، می‌توانند از گناهان دور بمانند."],[441,"فقر ازین رو فخر آمد جاودان","که به تقوی ماند دست نارسان","فقر، از این نظر، همیشه مایه افتخار است که تنها به افرادی که با تقوا هستند، می‌رسد و دست نادرست‌ها و ستم‌ها به آن‌ها نمی‌رسد."],[441,"زان غنا و زان غنی مردود شد","که ز قدرت صبرها بدرود شد","از آن غنا و ثروتی که به دست آمده است، بنابراین به خاطر این که صبر و تحمل نسبت به مشکلات و ناملایمات از دست رفته است، مردود و ناچیز شده است."],[441,"آدمی را عجز و فقر آمد امان","از بلای نفس پر حرص و غمان","انسان در برابر بلای نفس که همیشه پرحرص و غمگین است، به عجز و فقر پناه می‌برد و از آن نجات می‌یابد."],[441,"آن غم آمد ز آرزوهای فضول","که بدان خو کرده است آن صید غول","غم و اندوه انسان از آرزوهای نابجا و بیهوده‌ای ناشی می‌شود که به آن عادت کرده و به همین دلیل، او مانند شکار غولی گرفتار شده است."],[441,"آرزوی گل بود گل‌خواره را","گل‌شکر نگوارد آن بیچاره را","آرزوی کسی که به گل عادت کرده، گل و شکر را برای او نمی‌تواند شایسته کند. این بیان نشان می‌دهد که انسان‌ها گاهی به چیزهای نازک و لطیف (مثل خوشی‌ها) دست نمی‌یابند چون به سختی‌ها (مثل رنج‌ها) عادت کرده‌اند."],[442,"گفت یزدان تو بده بایست او","برگشا در اختیار آن دست او","خداوند به موسی می‌گوید که فرصتی برای دعا و درخواست از من را به او بده، تا بتواند دستش را در اختیار بگذارد و از آنچه نیاز دارد، بهره‌مند شود."],[442,"اختیار آمد عبادت را نمک","ورنه می‌گردد بناخواه این فلک","اختیار، موجب طعم و ارزش عبادت است، وگرنه این دنیا به دلخواه خود می‌چرخد و معنایی ندارد."],[442,"گردش او را نه اجر و نه عقاب","که اختیار آمد هنر وقت حساب","حرکت و گردش (جنبش) کائنات نه پاداشی دارد و نه تنبیهی؛ زیرا اختیار و اراده، در هنر و عمل انسان در زمان قیامت (حساب) وجود دارد."],[442,"جمله عالم خود مسبح آمدند","نیست آن تسبیح جبری مزدمند","تمام موجودات عالم به سبب ذات خود، حاوی تسبیح و پاکی‌اند و این تسبیح به معنای جبری و بدون اختیار نیست، بلکه از روی فهم و اراده آن‌هاست."],[442,"تیغ در دستش نه از عجزش بکن","تا که غازی گردد او یا راه‌زن","موسی در این بیت به کسی اشاره دارد که در برابر مشکلات و چالش‌ها از خود ضعف نشان ندهد. او باید با قدرت و اراده، در دست تیغ (به معنای ابزار مبارزه یا دفاع) همچون یک غازی (مبارز یا مجاهد) باشد و نه به صورت راه‌زن (کسی که با زور و غفلت دست به سرقت می‌زند)."],[442,"زانک کرمنا شد آدم ز اختیار","نیم زنبور عسل شد نیم مار","زیرا انسان (آدم) به خاطر انتخابش به دو قسم تقسیم شده است؛ نیمی از او مانند زنبور عسل است که نیکو و شیرین عمل می‌کند و نیمی دیگر مانند مار است که گزنده و مضر است."],[442,"مومنان کان عسل زنبوروار","کافران خود کان زهری همچو مار","مؤمنان مانند زنبورها از دل ایمان‌شان شیرینی و عسل تولید می‌کنند، اما کافران مانند مار، زهر و آسیب می‌زنند."],[442,"زانک مؤمن خورد بگزیده نبات","تا چو نحلی گشت ریق او حیات","مؤمنان، گیاهان و محصولاتی را که انتخاب کرده و می‌خورند، مصرف می‌کنند و به همین دلیل مانند درختان نخل می‌شوند و زندگی و حیات در وجودشان آشکار می‌شود."],[442,"باز کافر خورد شربت از صدید","هم ز قوتش زهر شد در وی پدید","کافر از شربتی که از جایی ناپاک (شربت صدید) می‌نوشد، به جای آنکه قوت بگیرد، زهر در وجودش ظهور می‌کند و او را ضعیف و بیمار می‌کند."],[442,"اهل الهام خدا عین الحیات","اهل تسویل هوا سم الممات","آنان که الهام الهی را دریافت می‌کنند، خود حقیقت زندگی هستند، در حالی که کسانی که به خوشگذرانی و هوس‌ها اهمیت می‌دهند، سمّ (زهر) مرگ را به جان می‌ریزند."],[442,"در جهان این مدح و شاباش و زهی","ز اختیارست و حفاظ آگهی","در این جهان، این تحسین و تبریک و خوشامدگویی به خاطر اختیار انسان و آگاهی او از شرایط و موقعیتش اتفاق می‌افتد."],[442,"جمله رندان چونک در زندان بوند","متقی و زاهد و حق‌خوان شوند","چون رندان (زاهدان و عابدان) در زندان هستند، در آن زمان هم متقی (پرهیزگار) و زاهد و کسی که به حق و حقیقت می‌اندیشد، خواهند شد. این به معنای این است که در شرایط سخت و دشوار نیز انسان‌ها ویژگی‌های خوب خود را حفظ می‌کنند."],[442,"چونک قدرت رفت کاسد شد عمل","هین که تا سرمایه نستاند اجل","وقتی قدرت از انسان برود، کارش بی‌اثر می‌شود، پس مواظب باش که اجازه ندهی مرگ سرمایه‌ات را از تو بگیرد."],[442,"قدرتت سرمایه سودست هین","وقت قدرت را نگه دار و ببین","قدرت تو مانند سرمایه‌ای است که می‌توانی از آن سود ببری؛ پس مراقب باش که این قدرت را از دست ندهی و به خوبی از آن استفاده کن."],[442,"آدمی بر خنگ کرمنا سوار","در کف درکش عنان اختیار","انسانی مانند کرمی که بر روی یک خرطوم سوار است، در واقع به سختی می‌تواند کنترل و انتخاب‌هایش را داشته باشد."],[442,"باز موسی داد پند او را بمهر","که مرادت زرد خواهد کرد چهر","موسی دوباره پند و نصیحت را به او گفت تا بگوید که خواسته‌ات چهره‌ات را زرد خواهد کرد، یعنی به تو ضرر خواهد زد."],[442,"ترک این سودا بگو وز حق بترس","دیو دادستت برای مکر درس","ترک این فکر و آرزو را بکن و از خدا بترس، زیرا شیطان به تو درس فریب و مکر می‌دهد."],[443,"گفت باری نطق سگ کو بر درست","نطق مرغ خانگی کاهل پرست","موسی گفت: حالا تو می‌دانی که وقتی این دو زبان به تو تعلیم داده شود، نطق سگ به‌درستی سخن می‌گوید، و نطق مرغ خانگی نیز به کاهلی (تنبلی) سخن می‌زند."],[443,"گفت موسی هین تو دانی رو رسید","نطق این هر دو شود بر تو پدید","موسی گفت: «برو، تو می‌دانی که وقتی زمانش برسد، سخن این دو (سگ و مرغ خانگی) برای تو روشن خواهد شد."],[443,"بامدادان از برای امتحان","ایستاد او منتظر بر آستان","موسی علیه السلام بامدادان، برای آزمایش ایستاده و در انتظار است، در آستانه در."],[443,"خادمه سفره بیفشاند و فتاد","پاره‌ای نان بیات آثار زاد","خدمتکار سفره را پخش کرد و تکه‌ای نان بیات (کهنه) بر زمین افتاد که نشان از خوراکی‌های باقیمانده دارد."],[443,"در ربود آن را خروسی چون گرو","گفت سگ کردی تو بر ما ظلم رو","خروس آن نان را به دزدی برداشت و گفت که این سگ بر ما ظلم کرده است که باعث می‌شود ما از خوردن آن محروم شویم."],[443,"دانه گندم توانی خورد و من","عاجزم در دانه خوردن در وطن","تو می‌توانی دانه گندم بخوری، اما من در وطن خودم در خوردن دانه ناتوانم و نمی‌توانم."],[443,"گندم و جو را و باقی حبوب","می‌توانی خورد و من نه ای طروب","تو می‌توانی گندم و جو و سایر حبوبات را بخوری، اما من نمی‌توانم، ای طروب (شخصی که سرشار از شادابی و نشاط است)."],[443,"این لب نانی که قسم ماست نان","می‌ربایی این قدر را از سگان","این نانی که به آن قسم خورده‌ایم، تو آن را می‌ربایی و حتی آن را به سگ‌ها هم نمی‌دهی."],[444,"پس خروسش گفت تن زن غم مخور","که خدا بدهد عوض زینت دگر","پس خروس به سگ گفت: نگران نباش و غم مخور، چرا که خدا به تو پاداشی دیگر خواهد داد."],[444,"اسپ این خواجه سقط خواهد شدن","روز فردا سیر خور کم کن حزن","این خواجه، اسبش فردا بی‌فایده خواهد شد، بنابراین غم و اندوه را کنار بگذار و کمی از تغذیه‌ی او بکاه."],[444,"مر سگان را عید باشد مرگ اسپ","روزی وافر بود بی جهد و کسپ","مرگ اسب برای سگان جشن و خوشحالی است، زیرا در آن روز آن‌ها به وفور غذا می‌یابند، بدون اینکه زحمت و تلاشی انجام دهند."],[444,"اسپ را بفروخت چون بشنید مرد","پیش سگ شد آن خروسش روی‌زرد","چون مرد اسبش را فروخت و این خبر به گوش خروس رسید، آن خروس به سوی سگ رفت و رنگش زرد شد، یعنی دلسرد و ناامید گردید."],[444,"روز دیگر همچنان نان را ربود","آن خروس و سگ برو لب بر گشود","روز بعد، خروس دوباره نان را دزدید و سگ در پاسخ به او شروع به صحبت کرد."],[444,"کای خروس عشوه‌ده چند این دروغ","ظالمی و کاذبی و بی فروغ","ای خروس، تو که با ظاهرسازی و ناز و بازیگری خود را نشان می‌دهی، این دروغی که می‌گویی، ظالم و بی‌معناست و هیچ نوری بر آن نیست."],[444,"اسپ کش گفتی سقط گردد کجاست","کور اخترگوی و محرومی ز راست","می‌پرسی که چرا اسب سقط شده‌ای که درباره‌اش صحبت کردی، کجاست. آیا کور اخترشناس یا کسی که از حقیقت بی‌خبر است، وجود ندارد که به تو راست بگوید؟"],[444,"گفت او را آن خروس با خبر","که سقط شد اسپ او جای دگر","خروس به سگ گفت که خبر دارد اسپ تو در مکان دیگری سقط شده است."],[444,"اسپ را بفروخت و جست او از زیان","آن زیان انداخت او بر دیگران","او اسب را فروخت و از زیان این کار رهایی یافت و این زیان را بر دوش دیگران انداخت."],[444,"لیک فردا استرش گردد سقط","مر سگان را باشد آن نعمت فقط","اما فردا ممکن است که آن استر (اسبی که فروخته شده) سقط شود (از بین برود) و این خوشی در واقع فقط برای سگان (که از گوشت آن بهره‌مند می‌شوند) خواهد بود."],[444,"زود استر را فروشید آن حریص","یافت از غم وز زیان آن دم محیص","زود استر (حیوان بارکش) را فروختند، زیرا آن فرد حریص از غم و خسارت ناگهانی به شدت نگران شده بود."],[444,"روز ثالث گفت سگ با آن خروس","ای امیر کاذبان با طبل و کوس","سگ به خروس گفت، در روز سوم، ای امیر دروغگویان، که با طبل و ساز خود را معرفی می‌کنی."],[444,"گفت او بفروخت استر را شتاب","گفت فردایش غلام آید مصاب","سگ گفت که او (مالک استر) اسبش را به سرعت فروخت و گفت فردا غلامی (خود) خواهد آمد که اسب را تحویل بگیرد."],[444,"چون غلام او بمیرد نانها","بر سگ و خواهنده ریزند اقربا","زمانی که غلام او بمیرد، خانواده‌اش خواهنده‌ها و نان‌ها را بر سر سگ می‌ریزند، به این معنی که به جای آنکه برای او رشدی یا خیر و نیکی از خود نشان دهند، فقط برای سگ و دیگران چیزهایی خواهند داد."],[444,"این شنید و آن غلامش را فروخت","رست از خسران و رخ را بر فروخت","او که این سخن را شنید، غلامش را فروخت و از زیان رهایی یافت، اما در عوض چهره‌اش را از دست داد."],[444,"شکرها می‌کرد و شادیها که من","رستم از سه واقعه اندر زمن","او از سه اتفاق مهم در زمانش نجات یافته و به همین خاطر شکرگزاری و شادی می‌کند."],[444,"تا زبان مرغ و سگ آموختم","دیده سوء القضا را دوختم","من زبان مرغ و سگ را آموزش دادم و بر اثر آن، چشمم را به روی بدبختی‌ها بستم."],[444,"روز دیگر آن سگ محروم گفت","کای خروس ژاژخا کو طاق و جفت","سگ که محروم از خوراک و نعمت است، به خروس می‌گوید: ای خروس پرحرف، کجاست آن طاق و جفت (که به تو وعده داده بودند و در آنجا با هم جمع می‌شوید)؟"],[445,"چند چند آخر دروغ و مکر تو","خود نپرد جز دروغ از وکر تو","چند بار باید دروغ و فریب تو را تحمل کرد؟ تو فقط به دروغ و فریب خودت ادامه می‌دهی و از حقیقت دوری می‌کنی."],[445,"گفت حاشا از من و از جنس من","که بگردیم از دروغی ممتحن","خروس می‌گوید: از من و از طبیعت من دور است که به خاطر یک دروغ آزمایش شوم."],[445,"ما خروسان چون مؤذن راست‌گوی","هم رقیب آفتاب و وقت‌جوی","ما مثل خروس‌ها هستیم که راست می‌گوییم و مانند مؤذنان صدای خود را بلند می‌کنیم و در جستجوی درستی وقت و زمان هستیم و با خورشید که نماد روشنایی و حقیقت است، رقابت می‌کنیم."],[445,"پاسبان آفتابیم از درون","گر کنی بالای ما طشتی نگون","ما مانند پاسبانان آفتاب هستیم و در حقیقت، در دل خود روشنایی و دانایی داریم. اگر تو (اشاره به کسی که به آن‌ها توجه می‌کند) طشتی ( ظرف آب) را بر سر ما بیندازی، و آن را برعکس کنی، ما همچنان از درون روشن و آگاه خواهیم بود."],[445,"پاسبان آفتابند اولیا","در بشر واقف ز اسرار خدا","اولیا (عاشقان و بندگان خاص خدا) مانند پاسبانان خورشید هستند، یعنی به حقیقت‌های معنوی و اسرار الهی آگاهند و در میان انسان‌ها به این اسرار واقفند."],[445,"اصل ما را حق پی بانگ نماز","داد هدیه آدمی را در جهاز","خداوند حقیقت وجود ما را با صدای اذان نماز فراخواند و نعمت انسان را در درون وجودش به او عطا کرد."],[445,"گر بناهنگام سهوی‌مان رود","در اذان آن مقتل ما می‌شود","اگر در وقتی نامناسب و به طور ناخواسته اذان بگوییم، این کار باعث نابودی و هلاکت ما خواهد شد."],[445,"گفت ناهنگام حی عل فلاح","خون ما را می‌کند خوار و مباح","خروس گفت؛ در زمانی نامناسب (به خطای خود) اذان گفت، و این باعث شد که خون ما (نیز) خوار و مباح شود."],[445,"آنک معصوم آمد و پاک از غلط","آن خروس جان وحی آمد فقط","خروس که نماد صداقت و پاکی است، به خاطر دروغ‌هایی که گفته شده، از بینش واقعی و وحی پاک شده و به حالتی معصوم و بی‌گناه باقی مانده است."],[445,"آن غلامش مرد پیش مشتری","شد زیان مشتری آن یکسری","غلام او (معصوم) پیش مشتری (فروشنده) متوجه زیان مشتری شد و عواقب بد آن را مشاهده کرد."],[445,"او گریزانید مالش را ولیک","خون خود را ریخت اندر یاب نیک","او اموالش را از دست می‌دهد، اما برای نجات جان خود خونش را بهایی می‌پردازد."],[445,"یک زیان دفع زیانها می‌شدی","جسم و مال ماست جانها را فدی","اگر می‌خواهی از زیان‌ها جلوگیری کنی، باید به خاطر جسم و مال ما آماده باشی که جان‌ها را فدای آن‌ها کنیم."],[445,"پیش شاهان در سیاست‌گستری","می‌دهی تو مال و سر را می‌خری","تو در سیاست و اداره امور نزد شاهان، مال و جان خود را در پیش آنها می‌گذاری و در عوض، از آنها چیزی را به دست می‌آوری."],[445,"اعجمی چون گشته‌ای اندر قضا","می‌گریزانی ز داور مال را","چون تو بیگانه‌ای (غیر فارس‌زبان) در قضا (حوادث و سرنوشت) قرار گرفته‌ای، مال را از داور (خدا) می‌گریزی و از آن دوری می‌کنی."],[446,"لیک فردا خواهد او مردن یقین","گاو خواهد کشت وارث در حنین","اما فردا او حتما خواهد مرد و در این صورت گاو را برای مراسم سوگواری او خواهند کشت و وارثینش در حال انجام این کار خواهند بود."],[446,"صاحب خانه بخواهد مرد رفت","روز فردا نک رسیدت لوت زفت","صاحب خانه که دارای گنج و ثروت است، تصمیم دارد که در روز آینده بمیرد و در نتیجه، لوت و دارایی او در اختیار دیگران قرار خواهد گرفت."],[446,"پاره‌های نان و لالنگ و طعام","در میان کوی یابد خاص و عام","نان‌های خرد شده و غذاهای دیگر در کوچه پراکنده می‌شود و همه، از خاص و عام، آن‌ها را پیدا می‌کنند."],[446,"گاو قربانی و نانهای تنک","بر سگان و سایلان ریزد سبک","در این بیت اشاره به این است که گاوهای قربانی و نان‌های کم‌ارزش به سگ‌ها و دیگر حیوانات داده می‌شود و این عمل را به نوعی بی‌ارزش و سبک می‌داند."],[446,"مرگ اسپ و استر و مرگ غلام","بد قضا گردان این مغرور خام","مرگ اسب و الاغ و مرگ غلام، باعث بدبختی و تقدیر شوم این مغرور و متکبر می‌شود."],[446,"از زیان مال و درد آن گریخت","مال افزون کرد و خون خویش ریخت","شخصی از آسیب مالی و دردهایی که داشته، فرار کرده و به جای آن تلاش کرده است که ثروت بیشتر به دست آورد، حتی به قیمت ریختن خون خود و قربانی کردن خودش."],[446,"این ریاضتهای درویشان چراست","کان بلا بر تن بقای جانهاست","این تمرین‌ها و زحمات درویشان برای چیست، در حالی که این دردها بر جسم تأثیر می‌گذارد و باعث بقای جان‌ها می‌شود؟"],[446,"تا بقای خود نیابد سالکی","چون کند تن را سقیم و هالکی","سالک (جستجوگر حق و حقیقت) تا زمانی که به بقای خود نرسد، چگونه می‌تواند بدنش را بیمار و تباه کند."],[446,"دست کی جنبد به ایثار و عمل","تا نبیند داده را جانش بدل","تا زمانی که انسانی با ایثار و عمل دست به کار نشود و در پی نتایج کارهای خود نباشد، جانش در جای خود باقی نمی‌ماند و به تغییر نخواهد رسید."],[446,"آنک بدهد بی امید سودها","آن خدایست آن خدایست آن خدا","خدای حقیقی کسی است که بدون هیچ امیدی به پاداش، نعمت‌ها و خیرات را می‌دهد."],[446,"یا ولی حق که خوی حق گرفت","نور گشت و تابش مطلق گرفت","ولی حق، یعنی دوست خدا، از آن‌جا که ویژگی‌های خداوند را در خود پذیرفته است، مانند نور می‌شود و نور درخشان و بی‌نهایت می‌گردد."],[446,"کو غنی است و جز او جمله فقیر","کی فقیری بی عوض گوید که گیر","خداوندی که او غنی و بی‌نیاز است و همه دیگران فقیرند، آیا می‌شود که فقیری بدون دریافت چیزی از او چیزی بخواهد؟"],[446,"تا نبیند کودکی که سیب هست","او پیاز گنده را ندهد ز دست","کودک تا زمانی که ببیند سیب (شیء مطلوب) وجود دارد، هرگز پیاز گنده (شیء نامطلوب) را از دست نمی‌دهد. به این معنا که تا وقتی امید یا چیزی بهتر را نبیند، از چیزهای بد دور نمی‌شود."],[446,"این همه بازار بهر این غرض","بر دکانها شسته بر بوی عوض","این همه بازار برای این هدف آماده شده و دکان‌ها به‌خاطر عوض (چیزی که جایگزین می‌شود) تمیز و مرتب شده‌اند."],[446,"صد متاع خوب عرضه می‌کنند","واندرون دل عوضها می‌تنند","تعداد زیادی کالاهای خوب در بازار عرضه می‌شوند، اما در دل و باطن این عرضه‌کنندگان، قصد و نیت‌هایی غیر از راستگویی و صداقت وجود دارد."],[446,"یک سلامی نشنوی ای مرد دین","که نگیرد آخرت آن آستین","ای مرد دین، اگر سلامی نشنوی، نمی‌توانی در آخرت از آن آستینی که در دست داری، چیزی به دست بیاوری."],[446,"بی طمع نشنیده‌ام از خاص و عام","من سلامی ای برادر والسلام","من هرگز نشنیده‌ام که کسی بدون اینکه انتظار پاداشی داشته باشد، از خاص و عام سلامی بگوید. ای برادر، سلام تنها به خاطر خدا و بدون طمع باید باشد."],[446,"جز سلام حق هین آن را بجو","خانه خانه جا بجا و کو بکو","فقط سلامی که از سوی حق است را طلب کن و فراموش نکن که این سلام در همه جا و در هر مکان وجود دارد، پس به جستجوی آن باش."],[446,"از دهان آدمی خوش‌مشام","هم پیام حق شنودم هم سلام","از دهان انسان که بوی خوشی دارد، هم پیامی از طرف خدا را شنیدم و هم سلامی از او."],[446,"وین سلام باقیان بر بوی آن","من همی‌نوشم به دل خوشتر ز جان","من همواره از بوی سلامی که از باقیان (کسانی که باقی مانده‌اند و در آنجا هستند) به من می‌رسد، لذت می‌برم و این سلام برایم دلپذیرتر از جان خودم است."],[446,"زان سلام او سلام حق شدست","کآتش اندر دودمان خود زدست","سلام او، سلام حقیقت و واقعیت است که مانند آتشی در خانواده‌اش (دودمانش) تاثیر گذاشته و تغییراتی به وجود آورده است."],[446,"مرده است از خود شده زنده برب","زان بود اسرار حقش در دو لب","کسی که به خود فراموشی و مرگ واقعی رسیده است، از عالم مادی رها شده و در حقیقت زنده است، زیرا اسرار الهی بر زبان او جاری می‌شود."],[446,"مردن تن در ریاضت زندگیست","رنج این تن روح را پایندگیست","مردن جسم در مسیر زهد و ریاضت، به معنای واقعی زندگی است و درد و رنج این جسم سبب بقای روح می‌شود."],[446,"گوش بنهاده بد آن مرد خبیث","می‌شنود او از خروسش آن حدیث","آن مرد بدجنس به صدای خروس خود گوش داده و از او خبر مرگ خواجه را می‌شنود."],[447,"چون شنید اینها دوان شد تیز و تفت","بر در موسی کلیم الله رفت","آن شخص وقتی این خبرها را شنید، به سرعت و با نگرانی به سمت موسی، پیامبر خدا (کلیم الله)، رفت."],[447,"رو همی‌مالید در خاک او ز بیم","که مرا فریاد رس زین ای کلیم","آن شخص از ترس این‌که حضرت موسی (کلیم الله) فریادرسی برای او باشد، به خاک افتاده و خود را به زمین می‌مالید."],[447,"گفت رو بفروش خود را و بره","چونک استا گشته‌ای بر جه ز چه","گفت برو و خودت را بفروش و به او بابت این وضع بدی که به آن دچار شده‌ای، مراجعه کن."],[447,"بر مسلمانان زیان انداز تو","کیسه و همیانها را کن دوتو","تو با کیسه و همیان (کیسه و ظرف پول) خود، بر مسلمانان ضرر و زیان می‌زنی و آنها را دچار مشکل می‌کنی."],[447,"من درون خشت دیدم این قضا","که در آیینه عیان شد مر ترا","من در دل خشت، سرنوشت تو را دیدم که در آینه به روشنی نمایان شد."],[447,"عاقل اول بیند آخر را بدل","اندر آخر بیند از دانش مقل","عاقل ابتدا عاقبت کارها را می‌بیند و درک می‌کند، ولی جاهل فقط به ظاهر امور توجه می‌کند و از دانش نادانی به مسائل نگاه می‌کند."],[447,"باز زاری کرد کای نیکوخصال","مر مرا در سر مزن در رو ممال","او دوباره با صدای بلند و التماس کرد و گفت: ای انسان نیکوخصال، در سر من مزن و به من رحم کن. به من اجازه بده که از این مکان خارج شوم و به دنبال راهی بروم."],[447,"از من آن آمد که بودم ناسزا","ناسزایم را تو ده حسن الجزا","من از طرف خود سخنان ناپسند و نامناسبی گفتم، حالا تو به من پاداش نیک بده، چرا که سزاوار نیکی هستم."],[447,"گفت تیری جست از شست ای پسر","نیست سنت کآید آن واپس به سر","گفت: ای پسر، تیر از دست شوت شده است و دیگر به عقب برنمی‌گردد، این روش و رسم دنیا چنین است."],[447,"لیک در خواهم ز نیکوداوری","تا که ایمان آن زمان با خود بری","من می‌خواهم از نیکویی و خوبی بهره‌مند شوم، تا زمانی که ایمان، آن حس خوب را به من هدیه دهد."],[447,"چونک ایمان برده باشی زنده‌ای","چونک با ایمان روی پاینده‌ای","وقتی که ایمان داشته باشی، زندگی و تمامیت خود را حفظ کرده‌ای؛ زیرا با ایمان، به پایداری و حیات واقعی دست می‌یابی."],[447,"هم در آن دم حال بر خواجه بگشت","تا دلش شوریده و آوردند طشت","در آن لحظه حال خواجه (موسی) تغییر کرد و دلش به هم ریخت و طشت (ظرفی برای غسل) را آوردند."],[447,"شورش مرگست نه هیضه طعام","قی چه سودت دارد ای بدبخت خام","مرگ، شور و هیجان شدیدی را به وجود می‌آورد، نه مانند هیجان ناشی از غذا. ای بیچاره! این چه فایده‌ای برای تو دارد؟"],[447,"چار کس بردند تا سوی وثاق","ساق می‌مالید او بر پشت ساق","چهار نفر او را گرفتند و به سمت زندان می‌بردند و او در حالیکه در زیر فشار، می‌خواست به خود بچسبد و خود را به ساق پای فردی که او را حمل می‌کرد، مالید."],[447,"پند موسی نشنوی شوخی کنی","خویشتن بر تیغ پولادی زنی","اگر پند موسی را نشنوی و بی‌پروا شوخی کنی، خود را به تیغ تیز و برنده‌ای خواهی زد."],[447,"شرم ناید تیغ را از جان تو","آن تست این ای برادر آن تو","این شخص به برادرش می‌گوید که از تیغ (یعنی مرگ) نباید شرم کرد، زیرا جان تو (همان وجود تو) از خود اوست و باید بپذیری که این واقعیت را."],[448,"موسی آمد در مناجات آن سحر","کای خدا ایمان ازو مستان مبر","موسی در آن سحر در حال مناجات و راز و نیاز با خداوند بود و از او می‌خواست که ایمان را از آن شخص بستاند و او را مست (غافل) نکند."],[448,"پادشاهی کن برو بخشا که او","سهو کرد و خیره‌رویی و غلو","ای موسی، به خدا بگو که این شخص که مرتکب اشتباهاتی شده و در امور خود دچار سردرگمی و زیاده‌ روی است، باید عفو شود و مورد رحمت قرار گیرد."],[448,"گفتمش این علم نه درخورد تست","دفع پندارید گفتم را و سست","به او گفتم این دانش و علم به تو نمی‌سازد، باید اندیشه‌هایم را رد کنی و برهان‌های سست را نادیده بگیری."],[448,"دست را بر اژدها آنکس زند","که عصا را دستش اژدرها کند","فقط کسی می‌تواند به اژدها (موانع بزرگ یا مشکل) نزدیک شود و دستش را بر آن بگذارد که عصایش (قدرت و اراده‌اش) همانند اژدها (محکم و قوی) شود. در حقیقت، برای مواجهه با چالش‌های بزرگ نیاز به اراده و قدرت درونی دارید."],[448,"سر غیب آن را سزد آموختن","که ز گفتن لب تواند دوختن","آموختن معنای چیزهایی که از عالم غیب می‌آید، برای کسی که قادر به بیان آنها باشد، لازم و شایسته است؛ زیرا کسی که می‌تواند با کلمات حقیقتی را بیان کند، در واقع می‌تواند در دل‌ها نفوذ کند و آنها را به هم پیوند دهد."],[448,"درخور دریا نشد جز مرغ آب","فهم کن والله اعلم بالصواب","تنها مرغابی که شایسته دریا بود، در آن جا قرار گرفت. بفهم این موضوع را، و خداوند از واقعیت‌ها آگاه‌تر است."],[448,"او به دریا رفت و مرغ‌آبی نبود","گشت غرقه دست گیرش ای ودود","او به دریا رفت و هیچ‌یک از مرغ‌های آبی نبود، بنابراین غرق شد؛ ای خداوند مهربان، او را نجات کن."],[449,"گفت بخشیدم بدو ایمان نعم","ور تو خواهی این زمان زنده‌ش کنم","خداوند گفت که ایمان او (موسی) را بخشیدم و اگر تو (موسی) بخواهی، در حال حاضر او را زنده می‌کنم."],[449,"بلک جمله مردگان خاک را","این زمان زنده کنم بهر ترا","من تمام مردگان را در این جهان به خاطر تو زنده می‌کنم."],[449,"گفت موسی این جهان مردنست","آن جهان انگیز کانجا روشنست","موسی (پیامبر) گفت این جهان، جهانی است که در آن مرگ و فنا وجود دارد، اما آن جهان دیگر، جهانی است که روشنایی و حیات در آن برقرار است."],[449,"این فناجا چون جهان بود نیست","بازگشت عاریت بس سود نیست","این زوال و فنا مانند جهانی است که وجود ندارد و بازگشت به آن عاریّت (خود را به چیز دیگر وابسته کردن) فایده‌ای نخواهد داشت."],[449,"رحمتی افشان بر ایشان هم کنون","در نهان‌خانه لدینا محضرون","خداوند اکنون نیز رحمتش را بر بندگانش پراکنده می‌سازد و در نهان‌خانه‌ای که نزد اوست، آن‌ها در حضور او هستند."],[449,"تابدانی که زیان جسم و مال","سود جان باشد رهاند از وبال","بدان که گاهی ضرر بدن و دارایی می‌تواند به نفع روح باشد، پس از بار گناهان رهایی یاب."],[449,"پس ریاضت را به جان شو مشتری","چون سپردی تن به خدمت جان بری","اگر می‌خواهی به مقام روح و جان برسی، باید با تمام وجود و اراده‌ات به ریاضت و تمرین بپردازی، چرا که این راه به خدمت جان و روح تو می‌انجامد."],[449,"ور ریاضت آیدت بی اختیار","سر بنه شکرانه ده ای کامیار","اگر بدون آنکه قصد داشته باشی به ریاضت (زحمت و عبادت) بپردازی، توفیق این کار به تو داده شد، باید سر به زمین بگذاری و سپاسگزاری کنی ای کسی که به آرزوهایت رسیده‌ای."],[449,"چون حقت داد آن ریاضت شکر کن","تو نکردی او کشیدت ز امر کن","زمانی که خداوند تو را به واسطه آن ریاضت و زحمت به مقام و حالتی خاص برساند، باید شکرگزاری کنی؛ زیرا تو خود این حالت را نخواستی و او، یعنی خدا، تو را به این مقام رسانده است."],[450,"آن زنی هر سال زاییدی پسر","بیش از شش مه نبودی عمرور","زن هر سال پسری به دنیا می‌آورد که بیشتر از شش ماه عمر نمی‌کند."],[450,"یاسه مه یا چار مه گشتی تباه","ناله کرد آن زن که افغان ای اله","آن زن از اینکه فرزندش فقط سه یا چهار ماه زندگی کرده و سپس از دنیا رفته، بسیار ناراحت و ناله‌کنان فریاد می‌زند و از خدا کمک می‌خواهد."],[450,"نه مهم بارست و سه ماهم فرح","نعمتم زوتر رو از قوس قزح","نه زمان یا سال و ماه (به سر نیاور) اهمیت ندارد، خوشی و نعمت من زودتر از قوس قزح (رنگین کمان) می‌آید."],[450,"پیش مردان خدا کردی نفیر","زین شکایت آن زن از درد نذیر","زن از درد و رنجی که داشت، در پیش مردان خدا ناله و شکایت می‌کرد."],[450,"بیست فرزند این‌چنین در گور رفت","آتشی در جانشان افتاد تفت","این زن بیست فرزندش را به همین شکل از دست داده است و از درد و اندوه آنها آتش عذاب و ناراحتی در دلش شعله‌ور شده است."],[450,"تا شبی بنمود او را جنتی","باقیی سبزی خوشی بی ضنتی","زن در خواب، باغی زیبا و سرسبز را می‌بیند که در آن هیچ‌گونه زحمتی وجود ندارد و به‌راحتی از ثمرات آن بهره‌مند می‌شود."],[450,"باغ گفتم نعمت بی‌کیف را","کاصل نعمتهاست و مجمع باغها","باغی که از آن صحبت می‌کنم، نماد نعمت‌هایی است که نه کیفیت مشخصی دارند و نه محدود به احساسات خاصی هستند؛ این باغ، در حقیقت، کانون و مجموع تمام نعمت‌ها می‌باشد."],[450,"ورنه لا عین رات چه جای باغ","گفت نور غیب را یزدان چراغ","اگر نور غیبی که به معنای علم و آگاهی الهی است، آشکار نشود، صحبت از باغ و نعمت بی‌کیف چه معنایی دارد؟ یزدان (خدا) مانند چراغی است که این نور را می‌تاباند."],[450,"مثل نبود آن مثال آن بود","تا برد بوی آنک او حیران بود","شبیه این مثال وجود ندارد، آن فقط یک نمونه بود که بوی آن را برد، زیرا او در حیرت و شگفتی قرار داشت."],[450,"حاصل آن زن دید آن را مست شد","زان تجلی آن ضعیف از دست شد","حاصل آن زن، یعنی آن زن به نتیجه و نتیجۀ کار خودش رسید و از شدت شگفتی به حالت مستی درآمد و به خاطر آن تجلی (نمایش الهی یا زیبایی)، آن زن ضعیف و ناتوان شد."],[450,"دید در قصری نبشته نام خویش","آن خود دانستش آن محبوب‌کیش","زن در قصر (شعر به قصر اشاره دارد) نام خود را نوشته دید و متوجه شد که آن شخص محبوب اوست، یعنی او خود را در آن نام شناسایی کرد."],[450,"بعد از آن گفتند کین نعمت وراست","کو بجان بازی به جز صادق نخاست","بعد از آن گفتند که این نعمت درست است، چون کسی که به زندگی و جان بازی کرده، جز شخصی راستگو و صادق به آن نعمت نمی‌رسد."],[450,"خدمت بسیار می‌بایست کرد","مر ترا تا بر خوری زین چاشت‌خورد","باید خدمتی بسیار انجام دهی تا از این نعمت و روزی بهره‌مند شوی."],[450,"چون تو کاهل بودی اندر التجا","آن مصیبتها عوض دادت خدا","زیرا که تو در دعا و تقاضا تنبلی کردی، خدا به جای آن مصیبت‌هایی که تجربه کرده‌ای، پاداشی به تو داده است."],[450,"گفت یا رب تا به صد سال و فزون","این چنینم ده بریز از من تو خون","زن می‌گوید: ای پروردگار، اگر این قدر دچار مصیبت هستم و تا صد سال یا بیشتر همچنان به این حال باشم، پس برایم خون بریز و زندگی‌ام را به پایان برسان."],[450,"اندر آن باغ او چو آمد پیش پیش","دید در وی جمله فرزندان خویش","در آن باغ که او وارد شد، همه فرزندانش را در آنجا دید."],[450,"گفت از من کم شد از تو گم نشد","بی دو چشم غیب کس مردم نشد","این بیت اشاره به این دارد که اگرچه من فرزندی را از دست داده‌ام که برایم بسیار ارزشمند بود، اما تو نباید غمگین باشی زیرا هیچ‌کس در عالم غیب و قدرت خداوند نابود نمی‌شود و زندگی ادامه دارد. وجود خدا و حقیقتی که در عالم هست، بر هیچ‌کس گم نشده است."],[450,"تو نکردی فصد و از بینی دوید","خون افزون تا ز تب جانت رهید","تو برای درمان بیماری خود، خون‌گیری نکردی، اما از بینی‌ات خون زیادی سرازیر شد تا از تب و بیماری‌ات رهایی یابی."],[450,"مغز هر میوه بهست از پوستش","پوست دان تن را و مغز آن دوستش","مغز هر میوه بهتر از پوست آن است. همین‌طور، روح و فطرت واقعی انسان (مغز) از بدن و ظاهر او (پوست) ارزشمندتر است و انسان باید به حقیقت درون خود و دوستی با آن توجه کند."],[450,"مغز نغزی دارد آخر آدمی","یکدمی آن را طلب گر زان دمی","انسان درون خود چیزی ارزشمند و عمیق دارد که باید در لحظه‌ای خاص آن را جستجو کند. اگر کسی در یک لحظه به آن دست یابد، ارزش واقعی وجودش را درک کرده است."],[451,"اندر آخر حمزه چون در صف شدی","بی زره سرمست در غزو آمدی","حمزه در پایان، وقتی وارد میدان جنگ شد، بدون زره و با شجاعت و سرمستی وارد نبرد گردید."],[451,"سینه باز و تن برهنه پیش پیش","در فکندی در صف شمشیر خویش","حمزه، با سینه‌ای باز و بدنی برهنه، به میدان جنگ رفت و با شهامت در صف دشمنان قرار گرفت و شمشیر خود را به کار انداخت."],[451,"خلق پرسیدند کای عم رسول","ای هزبر صف‌شکن شاه فحول","مردم از حمزه، عموی پیامبر (محمد) پرسیدند، ای مرد شجاع و نیرومند، که به تنهایی در صف دشمنان می‌تازی."],[451,"نه تو لا تلقوا بایدیکم الی","تهلکه خواندی ز پیغام خدا","خداوند در پیغام خود فرمان داده است که خودتان را به خطر نیندازید و در برابر دشمنان نروید."],[451,"پس چرا تو خویش را در تهلکه","می در اندازی چنین در معرکه","چرا خودت را به خطر می‌اندازی و در این جنگ چنین بی‌پناه و بی‌سپر به میدان می‌روی؟"],[451,"چون جوان بودی و زفت و سخت‌زه","تو نمی‌رفتی سوی صف بی زره","زمانی که جوان و نیرومند بودی، بی‌پروا و بدون زره به سوی میدان نبرد می‌رفتی، اما حالا که پیری و ضعف بر تو چیره شده، از آن کار پرخطر دست می‌کشی."],[451,"چون شدی پیر و ضعیف و منحنی","پرده‌های لا ابالی می‌زنی","وقتی که پیر و ضعیف و خمیده شدی، دیگر بی‌احتیاط و بی‌پروا رفتار می‌کنی و با بی‌خیالی از مرزهای خطر عبور می‌کنی."],[451,"لا ابالی‌وار با تیغ و سنان","می‌نمایی دار و گیر و امتحان","در حالی که بی‌احتیاط و بی‌ملاحظه با شمشیر و نیزه ظاهر می‌شوی، در واقع در معرض خطر و آزمون‌هایی واقعی قرار داری."],[451,"تیغ حرمت می‌ندارد پیر را","کی بود تمییز تیغ و تیر را","تیغ (شمشیر) حرمت (احترام) دارد و به این خاطر نمی‌تواند به پیر (رزمنده مسن) آسیب برساند؛ چنین چیزی درک تمییز (تشخیص) بین شمشیر و تیر (سلاحی دیگر) را ناممکن می‌کند."],[451,"زین نسق غمخوارگان بی‌خبر","پند می‌دادند او را از غیر","در این بیت، غمخواران و دل‌سوزان، به حمزه رضی الله عنه (که در جنگ بی‌زره شرکت کرده است) بدون اطلاع از وضعیت او، پند و نصیحت می‌کردند که از دیگران پرهیز کند."],[452,"گفت حمزه چونک بودم من جوان","مرگ می‌دیدم وداع این جهان","حمزه‌ی سیّدالشّهدا (عموی پیغمبر) گفت: هنگامی که جوان بودم، می‌پنداشتم که مرگ یعنی خداحافظی با دنیا."],[452,"سوی مردن کس به رغبت کی رود","پیش اژدرها برهنه کی شود","هیچ‌کس با میل و رغبت به سوی مرگ نمی‌رود، و هیچ انسانی بدون پوشش و آماده‌سازی به‌سوی خطر بزرگی مانند اژدها نمی‌رود."],[452,"لیک از نور محمد من کنون","نیستم این شهر فانی را زبون","من اکنون از نور محمد بی‌نصیبم و در این شهر فانی، افتاده و بی‌ارزش هستم."],[452,"از برون حس لشکرگاه شاه","پر همی‌بینم ز نور حق سپاه","من از خارج، صف‌های لشکر شاه را می‌بینم که از نور حق تشکیل شده‌اند."],[452,"خیمه در خیمه طناب اندر طناب","شکر آنک کرد بیدارم ز خواب","در عالم معنوی، حالتی از زندگی وجود دارد که در آن، دنیای خارجی به شکل خیمه‌ها و طناب‌های متصل به هم تصویر می‌شود و این تصویر به عنوان شکر و نعمت تعبیر شده است. این بیداری از خواب به معنای آگاهی یافتن از حقیقت و زیبایی‌های معنوی است."],[452,"آنک مردن پیش چشمش تهلکه‌ست","امر لا تلقوا بگیرد او به دست","مرگ در برابر چشمان او (خداوند) خطرناک است؛ فرمان «لا تلقوا» (نفس را به کشتن ندهید) او را در دست خواهد گرفت."],[452,"و آنک مردن پیش او شد فتح باب","سارعوا آید مرورا در خطاب","مردن برای او مانند گشایش دروازه‌ای است که موجب می‌شود با شتاب به حرکت درآیند و در خطاب به او (خدا) بشتابند."],[452,"الحذر ای مرگ‌بینان بارعوا","العجل ای حشربینان سارعوا","ای افرادی که مرگ را می‌بینید، مراقب باشید و شتاب کنید! ای کسانی که به قیامت فکر می‌کنید، بسرعة عمل کنید!"],[452,"الصلا ای لطف‌بینان افرحوا","البلا ای قهربینان اترحوا","ای کسانی که مهربانی را می‌بینید، خوشحال باشید! ای کسانی که قهر و خشم را می‌بینید، آرامش اختیار کنید."],[452,"هر که یوسف دید جان کردش فدی","هر که گرگش دید برگشت از هدی","هر کس زیبایی و محبوبیت یوسف را ببیند، جانش را فدای او می‌کند، اما هر کس گرگی را ببیند، از راه راست و هدایت دور می‌شود و به سمت خطر می‌رود."],[452,"مرگ هر یک ای پسر همرنگ اوست","پیش دشمن دشمن و بر دوست دوست","مرگ هر کسی شبیه به اوست؛ با دشمن، دشمن و با دوست، دوست رفتار می‌کند."],[452,"پیش ترک آیینه را خوش رنگی‌است","پیش زنگی آینه هم زنگی‌است","آیینه در برابر ترک (جمشید، قوم ترک) زیبایی و رنگی دلپذیر دارد، اما در برابر زنگ (زنگ‌زدگی) نشان‌دهنده‌ی زشتی و کدورت است. این بیت به تفاوت برخورد مردم با یکدیگر و تأثیر موقعیت بر نگاه و احساس آن‌ها اشاره دارد."],[452,"آنک می‌ترسی ز مرگ اندر فرار","آن ز خود ترسانی ای جان هوش دار","اگر از مرگ می‌ترسی و از آن فرار می‌کنی، باید بدانی که این ترس از خود توست. ای جان، هوشیار باش و بدان که ترس خود عامل این فرار است."],[452,"روی زشت تست نه رخسار مرگ","جان تو همچون درخت و مرگ برگ","روی زشت تو ناشی از مرگ است، نه از زیبایی. جان تو مانند درختی است که برگ‌هایش می‌ریزد و مرگ می‌تواند به آن آسیب بزند."],[452,"از تو رسته‌ست ار نکوی‌ست ار بدست","ناخوش و خوش، هر ضمیر‌ت، از خودست","هرچه درون تو وجود دارد، چه خوب باشد و چه بد، نتیجه درون خودت است و از خود تو نشأت می‌گیرد."],[452,"گر به «خار»ی خسته‌ای، خود کشته‌ای","ور «حریر» و «قز» دری، خود رشته‌ای","اگر به چیزی یا وضعیتی ناخوشایند مانند خار دچار شده‌ای، خودت باعث آن شده‌ای و اگر به چیزی خوشایند و زیبا مانند حریر یا قز (پارچه ابریشمی) رسیده‌ای، باز هم خودت در این موفقیت نقش داشتی."],[452,"دانک نبود فعل همرنگ جزا","هیچ خدمت نیست همرنگ عطا","اگر عملی که انجام می‌دهی با پاداش و جبران آن هم‌سنخ نباشد، هیچ خدمتی ارزشمند نیست و با عطا همخوانی ندارد."],[452,"مزد مزدوران نمی‌ماند به‌کار","کان عرض وین جوهر‌ست و پایدار","پاداش کسانی که برای دیگران کار می‌کنند، در آن کار باقی نمی‌ماند؛ زیرا آن کار زودگذر است و ارزش و جوهر واقعی در چیزهای پایدار و باارزش نهفته است."],[452,"آن همه سختی و زورست و عرق","وین همه سیم است و زر‌ست و طبق","تمامی این زحمات و سختی‌های زندگی، فرایندهایی طاقت‌فرساست که انسان برای کسب مال و ثروت متحمل می‌شود، و در حقیقت، آنچه به دست می‌آید، همان طلا و نقره است که در نهایت ارزش و بقا دارد."],[452,"گر ترا آید ز جایی تهمتی","کرد مظلومت دعا در محنتی","اگر از جایی بر تو اتهامی بیفتد، مظلومیت تو دعا می‌کند و تو را در سختی‌ها تنها نمی‌گذارد."],[452,"تو همی‌گویی که من آزاده‌ام","بر کسی من تهمتی ننهاده‌ام","تو می‌گویی من فردی آزاده هستم و هیچ تهمتی به کسی نزده‌ام."],[452,"تو گناهی کرده‌ای شکل دگر","دانه کشتی‌، دانه کی ماند به بر‌؟","تو گناهی مرتکب شده‌ای، اما به شکل دیگری آن را پنهان کرده‌ای؛ آیا می‌توانی دانه‌ای که در دامن خود داری را نگه‌داری؟"],[452,"او زنا کرد و جزا صد چوب بود","گوید او ‌«من کی زدم کس را به‌عود‌؟‌»","شخصی مرتکب زنا شده و متوجه می‌شود که جزای عملش، ضربه‌ها و تنبیه‌های شدید است، اما او در عین حال می‌گوید که من چرا کسی را عذاب کرده‌ام یا به او آسیبی رسانده‌ام؟"],[452,"نه جزای آن زنا بود این بلا‌؟","چوب کی ماند زنا را در خلا‌؟","آیا این عذاب و رنج، نتیجه آن زنا نیست؟ آیا تنبیه و مجازات نمی‌تواند از بین برود و در دل آن عمل، ناپدید شود؟"],[452,"مار کی ماند عصا را‌ ای کلیم","درد کی ماند دوا‌ را‌ ای حکیم","موسی، که به کلیم مشهور است، نمی‌تواند عصا را به عنوان یک مار نگه دارد و درد هم نمی‌تواند دائما دوا داشته باشد. در واقع، هیچ چیز نمی‌تواند به حالت خود باقی بماند."],[452,"تو به جای آن عصا آب منی","چون بیفکندی شد آن شخص سنی","تو به جای عصای موسی، آب من هستی و وقتی او را به زمین افکندی، شخص سنی (دینی که در اعتقادات خود محافظه‌کار است) شد."],[452,"یار شد یا مار شد آن آب تو","زان عصا چونست این اعجاب تو","آب تو به خاطر عصا، یار شد یا مار؟ این شگفتی چگونه است؟"],[452,"هیچ ماند آب آن فرزند را‌؟","هیچ ماند نیشکر مر قند را‌؟","آب فرزند و نیشکر برای قند، هیچ یک باقی نمانده‌اند؟ در واقع، اشاره به این دارد که چیزهای ظاهری و مادی دوام و پایداری ندارند."],[452,"چون سجودی یا رکوعی مرد کشت","شد در آن عالم سجود او بهشت","زمانی که مرد در حال سجود یا رکوع می‌میرد، آن عمل عبادی او باعث می‌شود که در عالم دیگر، بهشت نصیب او گردد."],[452,"چونک پرید از دهانش حمد حق","مرغ جنت ساختش رب‌الفلق","زمانی که مرغ از دهانش حمد خداوند را به زبان آورد، خداوند او را به موجودی از بهشت تبدیل کرد و به او برکت و وجودی نو بخشید."],[452,"حمد و تسبیحت نماند مرغ را","گرچه نطفه مرغ بادست و هوا","اگرچه مرغ به خاطر وجود نطفه‌اش در دستان و در زیر آسمان است، اما ذکر و ستایش و تسبیح خداوند برای او باقی نمی‌ماند."],[452,"چون ز دستت رست ایثار و زکات","گشت این دست آن طرف نخل و نبات","وقتی ایثار و بخشش از دستان تو خارج شد، این دست تو به سمت درخت نخل و گیاه روان شد و ثمرات آنها را به ارمغان آورد."],[452,"آب صبرت جوی آب خلد شد","جوی شیر خلد مهر تست و ود","صبر و شکیبایی تو باعث شده که همچون جوی آب بهشتی باشد، و محبت تو نیز همچون جوی شیر از بهشت جاری است."],[452,"ذوق طاعت گشت جوی انگبین","مستی و شوق تو جوی خمر بین","شوق و لذت در عبادت به مانند جوی عسل شده است و عشق و علاقه‌ات به خداوند مانند جوی شراب است."],[452,"این سبب‌ها آن اثر‌ها را نماند","کس نداند چونش جای آن نشاند","این علل و عوامل، اثرات خود را از دست داده‌اند و هیچ‌کس نمی‌داند که چه چیزی باعث جایگاه آن‌ها شده است."],[452,"این سبب‌ها چون به فرمان تو بود","چار جو هم مر ترا فرمان نمود","این علل و عوامل وقتی به اختیار و اراده تو باشند، مانند چهار جو (آب) هم به خاطر تو به فرمان تو عمل می‌کنند و به خواسته تو پاسخ می‌دهند."],[452,"هر طرف خواهی روانش می‌کنی","آن صفت چون بد چنانش می‌کنی","هر جا که بخواهی روح او را به حرکت درمی‌آوری و هر صفتی که برای او بخواهی، او را به همان صفت تبدیل می‌کنی."],[452,"چون منی تو که در فرمان تست","نسل آن در امر تو آیند چست","تو که در فرمان من هستی، من چگونه می‌توانم باشد که نسل تو در کارهایتان چابک و تند نباشد؟"],[452,"می‌دود بر امر تو فرزند نو","که منم جزوت که کردی‌اش گرو","فرزند نوزادی که به دنیا آمده، در پی فرمان تو می‌دود، و من نیز جزئی از آن هستم که تو او را به گرو گذاشته‌ای."],[452,"آن صفت در امر تو بود این جهان","هم در امر تست آن جوها روان","این جهان و همه چیز در آن، تحت فرمان تو و صفات تو هستند و آن صفات در کار تو تاثیر دارند، مانند جریان آب که به خاطر امر تو در حرکت است."],[452,"آن درختان مر ترا فرمان‌برند","کان درختان از صفاتت با‌برند","با برند‌: با میوه و بر هستند، دارای بر هستند."],[452,"چون به امر تست اینجا این صفات","پس در امر تست آنجا آن جزات","چون این صفات (درختان) به فرمان تو هستند، بنابراین در آنجا نیز جزا و پاداش بر اساس اراده تو خواهد بود."],[452,"چون ز دستت زخم بر مظلوم رست","آن درختی گشت ازو زقوم رست","زمانی که تو از دستت به مظلومین آسیب برسانی، به مانند درختی می‌شود که از ریشه تلخ زقوم (یک نوع درخت زهرآلود و تلخ) به وجود آمده است."],[452,"چون ز خشم آتش تو در دل‌ها زدی","مایه نار جهنم آمدی","وقتی که به خاطر خشم و آتش تو در دل‌ها آسیب رسید، باعث شدی که مایه آتش جهنم به وجود بیاید."],[452,"آتشت اینجا چو آدم‌سوز بود","آنچ از وی زاد مرد افروز بود","آتش تو مانند آتشی است که آدمیان را می‌سوزاند، اما از آن آتش افرادی به وجود می‌آیند که سرزنده و با نشاط خداوندی زندگی می‌کنند."],[452,"آتش تو قصد مردم می‌کند","نار کز وی زاد بر مردم زند","آتش تو قصد مردم را می‌کند، همان آتش که از آن زاده می‌شود و به مردم آسیب می‌زند."],[452,"آن سخن‌های چو مار و کزدمت","مار و کزدم گشت و می‌گیرد دمت","سخنانی که مانند مار زهرآگین هستند، از تو ناگهان به دشمن تبدیل می‌شوند و به طوری تو را می‌چسبند که به راحتی نمی‌توانی از چنگ آن ها فرار کنی."],[452,"اولیا را داشتی در انتظار","انتظار رستخیز‌ت گشت یار","تو دارای اولیا و دوستانی بوده‌ای که در انتظار قیام و رستاخیز تو مانده‌اند و یار و همراه تو شده‌اند."],[452,"وعده فردا و پس‌فردای تو","انتظار حشرت آمد وای تو","وعده‌های فردا و روزهای بعد از آن، انتظار قیامت و برزخ تو را به همراه دارد، وای بر تو که غافل هستی."],[452,"منتظر مانی در آن روز دراز","در حساب و آفتاب جان‌گداز","در آن روز طولانی که منتظر هستی، در محاسبه و حساب کارهایت هستی و تابش آفتاب به شدت تو را آزار می‌دهد."],[452,"که‌آسمان را منتظر می‌داشتی","تخم ‌«فردا ره روم‌» می‌کاشتی","تو آسمان را منتظر نگه می‌داشتی و در دل خود تخم فردا را می‌کاشتی، به این امید که به مقصد برسی."],[452,"خشم تو تخم سعیر دوزخ است","هین بکش این دوزخت را کاین فخ است","خشم تو باعث به وجود آمدن آتش دوزخ می‌شود، پس به خودت بیا و این عذاب را از خود دور کن چون این خشم را نمی‌توان تحمل کرد."],[452,"کشتن این نار نبود جز به نور","نورک اطفا نارنا نحن الشکور","کشتن آتش خشم، تنها با نور و روشنی ممکن است. ما به عنوان شکرگزاران، باید با نور، آتش را خاموش کنیم."],[452,"گر تو بی نوری کنی حلمی بدست","آتشت زنده‌ست و در خاکستر‌ست","اگر تو بدون نور (فهم و هدایت) صبر و بردباری کنی، آتش درونت همچنان زنده است و در زیر خاکستر پنهان شده."],[452,"آن تکلف باشد و روپوش هین","نار را نکشد به غیر نور دین","تکلف و ظاهرسازی برای کسی سودی ندارد و آتش درونی انسان بدون نور دین نمی‌تواند خاموش شود. در واقع، نور دین است که حقیقت را روشن می‌کند و بدون آن، نار یا آتش درون افراد در انتظار بروز است."],[452,"تا نبینی نور دین آمن مباش","که‌آتش پنهان شود یک روز فاش","تا وقتی نور ایمان را نبینی، ایمن نباش، زیرا آتش باطن ممکن است در یک روز به طور علنی نمایان شود."],[452,"نور آبی دان و هم در آب چفس","چونک داری آب از آتش مترس","نور آبی را بشناس و بدان که اگر در آب غوطه‌ور شوی، از آتش نترس؛ زیرا آب آتش را خاموش می‌کند."],[452,"آب آتش را کشد کآتش به خو","می‌بسوزد نسل و فرزندان او","آب می‌تواند آتش را خاموش کند، زیرا آتش از خود نمی‌سوزد بلکه نسلی و فرزندانش را می‌سوزاند."],[452,"سوی آن مرغابیان رو روز چند","تا ترا در آب حیوانی کشند","به‌سوی آن مرغابی‌ها برو و چند روزی را در آب زندگی با آنها بگذران، چرا که تو را در این زندگی، موجوداتی شبیه به خودت می‌کشند."],[452,"مرغ خاکی مرغ آبی هم‌تنند","لیک ضدانند آب و روغنند","مرغ خاکی و مرغ آبی هر دو از یک نوع هستند، اما با هم متفاوت‌اند، مانند آب و روغن که هر دو مایند اما به دلیل تفاوت ویژگی‌ها، نمی‌توانند با هم مخلوط شوند."],[452,"هر یکی مر اصل خود را بنده‌اند","احتیاطی کن به‌هم ماننده‌اند","هر یک از این موجودات، اصل و طبیعت خود را در اختیار دارند و به‌نوعی به آن پایبندند، اما احتیاطی لازم است چون به‌ظاهر شبیه هم هستند."],[452,"همچنانک وسوسه و وحی الست","هر دو معقولند لیکن فرق هست","وسوسه و وحی هر دو در دسته امور معقول قرار دارند، اما میان آن‌ها تفاوتی وجود دارد."],[452,"هر دو دلالان بازار ضمیر","رخت‌ها را می‌ستایند ای امیر","هر دو (وسوسه و وحی) به نوعی نماینده و راهنمای فکر و حافظه انسان هستند که در حقیقت، در بازار درون دل و ذهن انسان، کار می‌کنند و به خوبی‌های او اشاره می‌کنند. زبان حال مولانا خطاب به یک امیر است که به این دلالان (وسوسه و وحی) توجه کند."],[452,"گر تو صراف دلی فکرت شناس","فرق کن سر دو فکر چون نخاس","اگر تو انسانی هستی که به دل آگاهی داری، باید دو نوع فکر را از هم تشخیص دهی و برتری یکی را بر دیگری درک کنی."],[452,"ور ندانی این دو فکرت از گمان","لا خلابه گوی و مشتاب و مران","اگر نمی‌دانی که این دو فکر چه هستند و از کجا به وجود آمده‌اند، به حقیقت بگو و در این مورد تردید نکن و از آن دور نشو."],[453,"آن یکی یاری پیمبر را بگفت","که منم در بیعها با غبن جفت","یک نفر به یاری پیامبر می‌گوید که من در خرید و فروش‌ها همیشه با ضرر و خسارت روبرو هستم."],[453,"مکر هر کس کو فروشد یا خرد","همچو سحرست و ز راهم می‌برد","هر کسی که چیزی می‌فروشد یا خریداری می‌کند، با شیوه‌های فریبنده و حقه‌بازانه خود مانند جادوگران عمل می‌کند و به راحتی می‌تواند انسان‌ها را از مسیر درست خود منحرف کند."],[453,"گفت در بیعی که ترسی از غرار","شرط کن سه روز خود را اختیار","اگر در معامله‌ای از شرط غرر (نااطمینانی و ریسک) بترسی، باید سه روز به خودت فرصت بدهی تا خوب فکر کنی و به انتخاب مناسب برسیدی."],[453,"که تانی هست از رحمان یقین","هست تعجیلت ز شیطان لعین","تردیدی نیست که خداوند رحمان وجود دارد و یقینا سرعت عمل در کارها از شیطان خبیث است."],[453,"پیش سگ چون لقمه نان افکنی","بو کند آنگه خورد ای معتنی","اگر لقمه‌ای را جلوی سگ بیندازی، او ابتدا آن را بو می‌کند و بعد از آن می‌خورد. از این بیت، به اهمیت تأمل و بررسی قبل از عمل اشاره شده است."],[453,"او ببینی بو کند ما با خرد","هم ببوییمش به عقل منتقد","انسان باید مانند سگ که لقمه را بو می‌کند، با هوش و خرد خود به‌دنبال کشف و درک حقیقت‌ها برود و با عقل انتقادی، مسائل را بررسی کند."],[453,"با تانی گشت موجود از خدا","تابه شش روز این زمین و چرخها","خداوند با تدبیر و اندکی تأخیر، دنیا و آسمان‌ها را در شش روز آفرید."],[453,"ورنه قادر بود کو کن فیکون","صد زمین و چرخ آوردی برون","اگر خداوند می‌خواست، می‌توانست به‌راحتی با یک «کن» و «فیکون» (که به معنای «بشو» و «بوجود بیا» است) صدها زمین و آسمان را یکی پس از دیگری بیافریند و به وجود آورد."],[453,"آدمی را اندک اندک آن همام","تا چهل سالش کند مرد تمام","انسان به تدریج و کم‌کم، آن هم تا سن چهل سالگی، تبدیل به یک مرد کامل می‌شود."],[453,"گرچه قادر بود کاندر یک نفس","از عدم پران کند پنجاه کس","هرچند عیسی (پیامبر) می‌توانست در یک دم، پنجاه نفر را از نیستی به زندگی برساند، اما در واقع انسانی که به کمال و تمامیت رسیده، تدریجی و در طول زمان به این مقام می‌رسد."],[453,"عیسی قادر بود کو از یک دعا","بی توقف بر جهاند مرده را","عیسی (پیامبر) می‌توانست با یک دعا فرد مرده‌ای را زنده کند و این کار را بدون فاصله انجام دهد."],[453,"خالق عیسی بنتواند که او","بی توقف مردم آرد تو بتو","خداوند، عیسی را قادر به زنده کردن مردگان کرده است، اما نمی‌تواند مردم را بدون وقفه و از روی استراحت به سوی تو بیاورد."],[453,"این تانی از پی تعلیم تست","که طلب آهسته باید بی سکست","سکستن: گسیختن و پاره گشتن.بنابراین بی سکست: بدون گسیختگی. یعنی طلب رو باید آهسته و پیوسته دنبال کرد."],[453,"جو یکی کوچک که دایم می‌رود","نه نجس گردد نه گنده می‌شود","این بیت به این معناست که جو (غله‌ای که همیشه وجود دارد و در حال مصرف است) هرگز نجس یا کثیف نمی‌شود. به عبارت دیگر، اشیاء و چیزهایی که در زندگی روزمره و معاملات وجود دارند، اگر به درستی مدیریت شوند، می‌توانند همیشه پاک و سالم باقی بمانند."],[453,"زین تانی زاید اقبال و سرور","این تانی بیضه دولت چون طیور","از این تن و بدن، خوشبختی و شادی زاییده می‌شود؛ چون تخم دولت، مانند تخم پرندگان، از این تن به وجود می‌آید."],[453,"مرغ کی ماند به بیضه‌ ای عنید","گرچه از بیضه همی آید پدید","پرنده‌ای که به تخم‌گذاری نشسته، هرگز در تخم نمی‌ماند. هرچند که از تخم هم گاهی جوجه‌ای به وجود می‌آید."],[453,"باش تا اجزای تو چون بیضه‌ها","مرغها زایند اندر انتها","بگذار اجزای تو مانند تخم‌های مرغ، در نهایت سبب زایش مرغ‌ها شوند."],[453,"بیضه مار ارچه ماند در شبه","بیضه گنجشک را دورست ره","هرچند که تخم مار به شکل تخم گنجشک است، اما در حقیقت، به عنوان تخم یک موجود خطرناک، راه بهتری پیش نمی‌آورد."],[453,"دانه آبی به دانه سیب نیز","گرچه ماند فرقها دان ای عزیز","اگرچه دانه آبی رنگش به دانه سیب شبیه است، اما باید آگاه باشی که در اصل و حقیقت، میان آن‌ها تفاوت‌هایی وجود دارد."],[453,"برگها هم‌رنگ باشد در نظر","میوه‌ها هر یک بود نوعی دگر","برگ‌ها در ظاهری یکسان و هم‌رنگ با هم دیده می‌شوند، ولی هر کدام مربوط به نوعی میوه متفاوت هستند."],[453,"برگهای جسمها ماننده‌اند","لیک هر جانی بریعی زنده‌اند","برگ‌های جسم‌ها شبیه هم هستند، اما هر روحی به‌تنهایی زنده و منحصر به فرد است."],[453,"خلق در بازار یکسان می‌روند","آن یکی در ذوق و دیگر دردمند","مردم در بازار به یک شکل رفت‌وآمد می‌کنند، اما برخی از آن‌ها خوشحال و راضی هستند، در حالی که برخی دیگر در عذاب و ناراحتی به سر می‌برند."],[453,"همچنان در مرگ یکسان می‌رویم","نیم در خسران و نیمی خسرویم","همه ما در مرگ به یک شکل حرکت می‌کنیم، ولی عده‌ای در این مسیر متضرر و زیان‌دیده‌اند و عده‌ای دیگر به سعادت و رستگاری رسیده‌اند."],[454,"چون بلال از ضعف شد همچون هلال","رنگ مرگ افتاد بر روی بلال","وقتی بلال به خاطر ضعف و بیماریش مانند هلال ماه شده بود، رنگ مرگ بر چهره‌اش نمایان شد."],[454,"جفت او دیدش بگفتا وا حرب","پس بلالش گفت نه نه وا طرب","همسر بلال، او را دید و گفت که چقدر حیرت انگیز است که در این حال مرگ، تو به یاد جنگ و معرکه هستی. اما بلال پاسخ داد که نه، من به حالت شادمانی و طرب (شادی و خوشحالی) در اینجا هستم."],[454,"تا کنون اندر حرب بودم ز زیست","تو چه دانی مرگ چون عیشست و چیست","من تا به حال در جنگ و نبرد بودم و به زندگی مشغول، بنابراین نمی‌دانی که مرگ چه حالتی دارد و مانند چه عیش و شادمانی‌ای است."],[454,"این همی گفت و رخش در عین گفت","نرگس و گلبرگ و لاله می‌شکفت","بلال در حال سخن گفتن بود و در عین حال، چهره‌اش به زیبایی درخششی خاص داشت که مانند گل و لاله و نرگس شکوفا می‌شد."],[454,"تاب رو و چشم پر انوار او","می گواهی داد بر گفتار او","چهره و چشمان پرنور بلال رضی الله عنه، گواهی بر سخنانی است که می‌گوید و نشان‌دهنده حقیقت کلام اوست."],[454,"هر سیه دل می سیه دیدی ورا","مردم دیده سیاه آمد چرا","هر فرد بدبخت و تیره‌دل را که دیدی، با دل سیاه و غمگین است؛ اما چرا مردم او را به شکل و چهره سیاه می‌بینند؟"],[454,"مردم نادیده باشد رو سیاه","مردم دیده بود مرآت ماه","اگر فردی را به خاطر ظواهر نادرست قضاوت کنیم، به مانند این است که در آینه‌ی چهره‌اش، چهره‌ای نادرست می‌بینیم. در واقع، افرادی که واقعیات را نمی‌بینند، به اشتباه او را بد می‌خوانند، در حالی که حقیقت او ممکن است زیبا و روشن باشد."],[454,"خود که بیند مردم دیده ترا","در جهان جز مردم دیده‌فزا","مردم فقط تو را در چشم خود می‌بینند و در واقع کسانی که تو را دیده‌اند، فقط از طریق چشم دیگران، قضاوت می‌کنند و نمی‌توانند حقیقت تو را بشناسند."],[454,"چون به غیر مردم دیده‌ش ندید","پس به غیر او که در رنگش رسید","هر کس غیر از مردم را نبیند، پس به غیر از او که به رنگ و جلوه‌اش رسیده، نمی‌تواند زل بزند و توجه کند."],[454,"پس جز او جمله مقلد آمدند","در صفات مردم دیده بلند","به جز او، دیگران همگی در صفات و ویژگی‌های ظاهری انسان‌ها تقلید کردند و به جمع آمده‌اند."],[454,"گفت جفتش الفراق ای خوش‌خصال","گفت نه نه الوصالست الوصال","دوست خوب بلال، که همسرش است، می‌گوید فراق و جدایی از تو را خوش‌خصال می‌نامد و او در پاسخ می‌گوید نه، جدایی را نمی‌خواهم، بلکه وصل و پیوستگی با تو را می‌خواهم."],[454,"گفت جفت امشب غریبی می‌روی","از تبار و خویش غایب می‌شوی","او می‌گوید که امشب تو به غریبی می‌روی و از خویشاوندان و نزدیکان خود دور می‌شوی."],[454,"گفت نه نه بلک امشب جان من","می‌رسد خود از غریبی در وطن","بلال می‌گوید که امشب جان من به سوی معبود می‌رسد و دیگر احساس غریبی نمی‌کنم، بلکه در وطن خود خواهم بود."],[454,"گفت رویت را کجا بینیم ما","گفت اندر حلقه خاص خدا","بلال رضی الله عنه، در پاسخ به سؤال دیگران درباره مکان دیدن چهره‌اش، می‌گوید که ما فقط می‌توانیم خدا را در حلقه خاصی از محبت و نزدیکان او ببینیم. به عبارت دیگر، او اشاره دارد که دیدن چهره‌اش تنها در ارتباط با خدا و در آن فضای خاص ممکن است."],[454,"حلقه خاصش به تو پیوسته است","گر نظر بالا کنی نه سوی پست","حلقه خاص خداوند به تو متصل است، اگر نظر خود را به بالا یعنی به سوی خدا معطوف کنی، نه به سوی موارد پایین و دنیوی."],[454,"اندر آن حلقه ز رب العالمین","نور می‌تابد چو در حلقه نگین","در آن حلقه که به خداوند عالم مربوط می‌شود، نوری می‌تابد مانند نوری که از نگین حلقه بیرون می‌آید."],[454,"گفت ویران گشت این خانه دریغ","گفت اندر مه نگر منگر به میغ","گفت این خانه ویران شده است، افسوس. به ماه نگاه کن و با ابر (غم) نگاه نکن."],[454,"کرد ویران تا کند معمورتر","قومم انبه بود و خانه مختصر","خداوند این خانه را ویران کرده تا با این کار آن را پرآب و رنگ‌تر کند، زیرا که قوم من کم‌جمعیت و خانه‌هایمان هم کوچک است."],[455,"من چو آدم بودم اول حبس کرب","پر شد اکنون نسل جانم شرق و غرب","من در ابتدا مانند آدم (انسان اول) در زندانی قرار داشتم، اما اکنون نسل جانم به وسعت شرق و غرب گسترش یافته است."],[455,"من گدا بودم درین خانه چو چاه","شاه گشتم قصر باید بهر شاه","من در این دنیا مانند گدا بودم، اما اکنون به مقام شاه رسیده‌ام. بنابراین، باید قصر (محل زندگی) مخصوص شاهان را داشته باشم."],[455,"قصرها خود مر شهان را مانسست","مرده را خانه و مکان گوری بسست","قصرها برای پادشاهان باقی نمی‌ماند و پس از مرگ، خانه و مکانی برای مرده فقط قبر است."],[455,"انبیا را تنگ آمد این جهان","چون شهان رفتند اندر لامکان","پیامبران وقتی به دنیا نگاه کردند، این جهان را برایشان تنگ و محدود احساس کردند؛ چون پادشاهان بزرگ (شاهان) بعد از مرگ به جایی فراتر از این دنیا رفته‌اند که در آن هیچ‌گونه محدودیتی وجود ندارد."],[455,"مردگان را این جهان بنمود فر","ظاهرش زفت و به معنی تنگ بر","مردگان به این جهان نگریسته‌اند و از ظاهری زشت و خشن آن، با حالت تنگی و محدودیت مواجه شده‌اند."],[455,"گر نبودی تنگ این افغان ز چیست","چون دو تا شد هر که در وی بیش زیست","اگر این زندگی تنگ و محدود نبود، چرا این ناله و افسوس است؟ با این حال، هر کس که بیشتر در آن زندگی کند، به دو نیم می‌شود (یعنی دچار دوگانگی یا کشمکش درونی می‌گردد)."],[455,"در زمان خواب چون آزاد شد","زان مکان بنگر که جان چون شاد شد","در زمان خواب، وقتی که روح از جسم آزاد می‌شود، با شادی و سرخی جان را مشاهده کن."],[455,"ظالم از ظلم طبیعت باز رست","مرد زندانی ز فکر حبس جست","انسان ستمگر از ظلم طبیعت رهایی یافته است و کسی که در زندان اندیشه خود اسیر است، جست‌وجویی برای آزادی می‌کند."],[455,"این زمین و آسمان بس فراخ","سخت تنگ آمد به هنگام مناخ","این زمین و آسمان بسیار وسیع و گسترده است، اما در زمان مرگ، برای من احساس تنگی و محدودیت می‌کند."],[455,"جسم بند آمد فراخ وسخت تنگ","خنده او گریه فخرش جمله ننگ","جسم انسان در این دنیا به دلیل محدودیت‌ها و مشکلاتش، همچون زندانی می‌ماند که در عین وسیع بودن جهان، در تنگنا قرار دارد. در این حال، خنده و شادی او نشان‌دهنده فخر و افتخار است، اما در حقیقت، همه این‌ها سبب ننگ و شرمندگی‌اش می‌شود."],[456,"همچو گرمابه که تفسیده بود","تنگ آیی جانت پخسیده شود","همان‌طور که در گرمابه‌ای که بخار و گرما آن را گرفته، فضا تنگ می‌شود، جان تو هم وقتی به دنیا وابسته باشد و غرق در آن شود، احساس تنگی و فشار خواهد کرد."],[456,"گرچه گرمابه عریضست و طویل","زان تبش تنگ آیدت جان و کلیل","هرچند که حمام بزرگ و وسیع است، اما به خاطر گرما و بخار، برای جان و روح تو تنگ و خفقان‌آور می‌شود."],[456,"تا برون نایی بنگشاید دلت","پس چه سود آمد فراخی منزلت","اگر نتوانی از دنیا و وضع کنونی‌ات به راحتی خارج شوی، پس چه فایده‌ای دارد که خانه‌ات وسیع و جا دار باشد؟"],[456,"یا که کفش تنگ پوشی ای غوی","در بیابان فراخی می‌روی","اگر در بیابان وسیع هستی، اما کفش تنگ به پا داری، در واقع در محدودیت و تنگنا حرکت می‌کنی."],[456,"آن فراخی بیابان تنگ گشت","بر تو زندان آمد آن صحرا و دشت","آن‌قدر که بیابان به نظر وسیع می‌رسد، در واقع بر تو تنگ و محدود شده است، به طوری که آن صحرا و دشت برای تو مانند زندانی شده است."],[456,"هر که دید او مر ترا از دور گفت","کو در آن صحرا چو لاله تر شکفت","هر کسی که تو را از دور ببیند، می‌گوید که در آن بیابان، همچون لاله‌ای در حال شکفتن هستی."],[456,"او نداند که تو همچون ظالمان","از برون در گلشنی جان در فغان","او نمی‌داند که تو مانند ستمگران، از بیرون به سرسبزی و زیبایی ظاهری می‌نگری، در حالی که در درون، جانت در حال رنج و عذاب است."],[456,"خواب تو آن کفش بیرون کردنست","که زمانی جانت آزاد از تنست","خواب تو مانند درآوردن کفش است که در آن زمان، جان تو از قید بدن آزاد است."],[456,"اولیا را خواب ملکست ای فلان","همچو آن اصحاب کهف اندر جهان","اولیا، یعنی بندگان خاص و حقیقت‌جو، در حالت خواب به مانند کسانی هستند که در غاری به خواب رفته‌اند، مانند اصحاب کهف که سال‌ها در خواب بودند و از دنیای بیرون بی‌خبر. این خواب، برای آن‌ها نوعی ملک و آرامش است."],[456,"خواب می‌بینند و آنجا خواب نه","در عدم در می‌روند و باب نه","اولیا در خواب هستند و این خواب واقعی نیست، بلکه آن‌ها در حال گذر از عدم و ناپایداری به چیزی هستند که هنوز قابل درک نیست. این خواب آن‌ها به معنای فرار از دنیا و مشکلات آن است، نه فراموشی و نیستی."],[456,"خانه تنگ و درون جان چنگ‌لوک","کرد ویران تا کند قصر ملوک","زندگی و دنیا مانند یک خانه تنگ است که روح انسان (چنگ‌لوک) را به دردسر و ویرانی می‌اندازد تا از این طریق، قصر و مقام بزرگ و باعظمتی را برای پادشاهان و بزرگانی بسازد."],[456,"چنگ‌لوکم چون جنین اندر رحم","نه‌مهه گشتم شد این نقلان مهم","چنگ‌لوک، که به معنای حیات و زندگی شاداب است، در حالتی شبیه به جنین در رحم قرار دارد و من به مانند او از مشکلات و تنگناها آزاد شدم و به مرحله‌ای مهم و جدید وارد شدم."],[456,"گر نباشد درد زه بر مادرم","من درین زندان میان آذرم","اگر درد زایمان بر مادرم وجود نداشت، من نیز در این زندان میان آتش نمی‌بودم."],[456,"مادر طبعم ز درد مرگ خویش","می‌کند ره تا رهد بره ز میش","طبیعت من، به خاطر دردی که از مرگ خود احساس می‌کند، راهی پیدا می‌کند تا بره (نماد وجود نازک و بی‌پناه) از میش (نماد مادر) آزاد شود."],[456,"تا چرد آن بره در صحرای سبز","هین رحم بگشا که گشت این بره گبز","بره‌ای که در صحرای سبز (که نمایانگر زندگی و سرسبزی است) گرفتار شده و به کمک نیاز دارد، به مادرش می‌گوید که دست از رحم و شفقت بردارد و به او کمک کند تا از این وضعیت آزاد شود. «بره گبز» به معنای بره‌ای است که در تنگنا قرار گرفته و به یاری می‌طلبد."],[456,"درد زه گر رنج آبستان بود","بر جنین اشکستن زندان بود","اگر دردی که زن حامله در هنگام زایمان به خاطر درد زایمان احساس می‌کند، درخت آبستن باشد، شکست آن درد مانند شکستن زندان است."],[456,"حامله گریان ز زه کاین المناص","و آن جنین خندان که پیش آمد خلاص","مادر حامله به خاطر دردش می‌گرید، در حالی که جنینی که در شکمش است، به خاطر آزادی‌اش خوشحال است."],[456,"هرچه زیر چرخ هستند امهات","از جماد و از بهیمه وز نبات","تمام موجوداتی که زیر آسمان هستند، شامل مادران زمین، مانند سنگ‌ها (جمادها)، حیوانات (بهیمه) و گیاهان (نبات) می‌شوند."],[456,"هر یکی از درد غیری غافل اند","جز کسانی که نبیه و کامل‌اند","هر کس به درد و مشکل دیگران بی‌توجه است، جز افرادی که نبی (پیامبر) و کامل‌اند و به آلام دیگران آگاهند."],[456,"آنچ کوسه داند از خانه کسان","بلمه از خانه خودش کی داند آن","کوسه (نوعی ماهی) فقط از وضعیت خانه دیگران اطلاع دارد، اما از وضعیت خانه خود چیزی نمی‌داند. این بیت به این معناست که افراد معمولا از مشکلات و اوضاع دیگران باخبرند، اما خودشان را نمی‌شناسند و از دنیای درونی خود غافل‌اند."],[456,"آنچ صاحب‌دل بداند حال تو","تو ز حال خود ندانی ای عمو","آنچه صاحب‌دل (شخص عارف و با بصیرت) از وضعیت تو می‌داند، تو از حال خود بی‌خبر هستی، ای عمو."],[457,"غفلت از تن بود چون تن روح شد","بیند او اسرار را بی هیچ بد","غفلت و نادانی از جسم انسان ناشی می‌شود؛ وقتی که بدن از بین برود و روح آزاد شود، او می‌تواند اسرار و حقیقت‌ها را ببیند بدون هیچ‌گونه محدودیتی یا آسیب."],[457,"چون زمین برخاست از جو فلک","نه شب و نه سایه باشد نه دلک","وقتی زمین از جو آسمان جدا شد، دیگر نه شب وجود دارد و نه سایه‌ای، و همچنین دل‌های آشفته نیز وجود نخواهد داشت."],[457,"هر کجا سایه‌ست و شب یا سایگه","از زمین باشد نه از افلاک و مه","هر جا که سایه یا شب و تیرگی وجود دارد، باید بدانیم که منشا آن از زمین و امور دنیوی است، نه از آسمان و اجرام سماوی."],[457,"دود پیوسته هم از هیزم بود","نه ز آتش‌های مستنجم بود","دود که به طور مداوم تولید می‌شود، ناشی از سوختن چوب‌ها (هیزم) است و نه از آتش‌هایی که در خود جذب شده و درون‌ریز شده‌اند. اینجا اشاره به این دارد که مشکلات و غم‌ها از ریشه‌های دنیوی و مادی هستند، نه از چیزهای والا و معنوی."],[457,"وهم افتد در خطا و در غلط","عقل باشد در اصابت‌ها فقط","وهم انسان ممکن است به اشتباه بیفتد و دچار خطا شود، اما عقل تنها در شناخت درست و تصمیم‌گیری صحیح است که می‌تواند به درستی عمل کند."],[457,"هر گرانی و کسل خود از تن است","جان ز خفت جمله در پریدن است","همه سنگینی و کسالت انسان ناشی از بدن اوست، در حالی که جان او در حالت خواب و سستی به سر می‌برد و به پرواز و آزادی تمایل دارد."],[457,"روی سرخ از غلبه خون‌ها بود","روی زرد از جنبش صفرا بود","رنگ صورت انسان به علت غلبه خون، سرخ می‌شود و اگر صفرا (یکی از اخلاط چهارگانه) بر او غلبه کند، رنگش زرد می‌شود."],[457,"رو سپید از قوّت بلغم بود","باشد از سودا که رو ادهم بود","رنگ چهره‌ی سفید ناشی از قوت و مزاج بلغم (یکی از چهار مزاج بدن) است، در حالی که رنگ چهره‌ی قرمز به خاطر وجود سودا (مزاجی دیگر) است که سبب تیره شدن چهره می‌شود."],[457,"در حقیقت خالق آثار اوست","لیک جز علت نبیند اهل پوست","در واقع، خالق آثار و کارها تنها خداوند است، اما کسانی که به ظواهر و äußere چیزها توجه دارند، فقط علل ظاهری را می‌بینند و از حقیقت بی‌خبرند."],[457,"مغز کو از پوست‌ها آواره نیست","از طبیب و علت او را چاره نیست","مغز، مرکز و اصول واقعی وجود انسان، از لایه‌های ظاهری و سطوح بیرونی (پوست) جدا نیست و نمی‌توان به تنهایی به پزشک و دلایل ظاهری برای درمان او اتکا کرد."],[457,"چون دوم بار آدمی‌زاده بزاد","پای خود بر فرق علت‌ها نهاد","زمانی که یک انسان دوباره به دنیا می‌آید و به رشد و پختگی می‌رسد، بر روی عوامل و علل مختلف زندگی‌اش تسلط پیدا می‌کند و بر آن‌ها فراتر می‌رود."],[457,"علت اولی نباشد دین او","علت جزوی ندارد کین او","دین آدمی نباید به علت‌های جزئی و سطحی وابسته باشد، بلکه باید به یک علت اصلی و فراگیر برگردد."],[457,"می‌پرد چون آفتاب اندر افق","با عروس صدق و صورت چون تتق","روان و پاک از غم و کاهلی، مانند آفتاب که در افق می‌درخشد، بی‌هیچ مانع و حجاب، به جمال و حقیقت خود می‌پردازد و چون زنی زیبا، حقیقت و صدق را به نمایش می‌گذارد."],[457,"بلک بیرون از افق وز چرخ‌ها","بی مکان باشد چو ارواح و نهی","نهی‌: خوانده می‌شود نها. جمع نهیه است یعنی خردها و عقل‌ها."],[457,"بل عقول ماست سایه‌های او","می‌فتد چون سایه‌ها در پای او","عقول ما، یعنی عقل‌ها و اندیشه‌های ما، تحت تأثیر و سایه‌ی جسم و بدن ما قرار دارند، به‌گونه‌ای که مانند سایه‌هایی که در زیر پای یک شخص می‌افتند، همیشه از وجود جسم تاثیر می‌پذیرند."],[457,"مجتهد هر گه که باشد نص‌شناس","اندر آن صورت نیندیشد قیاس","مجتهد (فردی که در دین اسلام اجتهاد می‌کند) هرگاه که به نص (کتاب یا سنت) آگاه باشد، به شکل ظاهری (صورت) آن توجه نمی‌کند و بر اساس قیاس (استدلال منطقی) فکر نمی‌کند."],[457,"چون نیابد نص اندر صورتی","از قیاس آنجا نماید عبرتی","وقتی مجتهد در مسأله‌ای نتواند نص (آیه یا روایت) مشخصی پیدا کند، در این مواقع باید از قیاس استفاده کند و از آنجا درس عبرت بگیرد."],[458,"نص وحی روح قدسی دان یقین","وان قیاس عقل جزوی تحت این","وحی به عنوان روح قدسی و الهام الهی یقینا درست است، اما قیاس عقل جزئی، محدود و ناقص است."],[458,"عقل از جان گشت با ادراک و فر","روح او را کی شود زیر نظر","عقل از جان استفاده می‌کند و با درک خود به فهم می‌رسد، ولی روح او هرگز تحت نظارت عقل نمی‌آید."],[458,"لیک جان در عقل تاثیری کند","زان اثر آن عقل تدبیری کند","ولی جان بر عقل تأثیر می‌گذارد و از آن تأثیر، عقل نیز تدبیر و برنامه‌ریزی می‌کند."],[458,"نوح‌وار ار صدقی زد در تو روح","کو یم و کشتی و کو طوفان نوح","اگر تو هم مانند نوح (پیامبر) صداقت نشان دهی، روح تو مانند کشتی است و باید ببینی طوفان نوح کجاست."],[458,"عقل اثر را روح پندارد ولیک","نور خور از قرص خور دورست نیک","عقل چیزی را که به وجود آمده است، به عنوان روح و زندگی می‌بیند، اما در واقع، نور خورشید از قرص (دایره) خورشید جدا نیست و این جدایی حقیقت ندارد."],[458,"زان به قرصی سالکی خرسند شد","تا ز نورش سوی قرص افکند شد","سالکی به خوشحالی به خورشید (قرص خور) نگریست، چرا که از نور آن می‌تواند به سمت خورشید تابش کند و بهره‌مند شود."],[458,"زانک این نوری که اندر سافل است","نیست دایم روز و شب او آفل است","این نوری که در بخش پایین‌تر وجود دارد، ثابت و دائمی نیست و در روز و شب تغییر می‌کند و از بین می‌رود."],[458,"وانک اندر قرص دارد باش و جا","غرقه آن نور باشد دایما","این نور که در قرص (دایره‌ای) قرار دارد، همیشه در آن جا به صورت کامل و غرقه وجود دارد."],[458,"نه سحابش ره زند خود نه غروب","وا رهید او از فراق سینه کوب","نه ابر در آسمان راهی به سوی او پیدا می‌کند و نه غروب، او از فراق و جدایی به شدت در زحمت و تقلاست."],[458,"این‌چنین کس اصلش از افلاک بود","یا مبدل گشت گر از خاک بود","این فرد به‌طور طبیعی از عالم بالا و افلاک است و اگر هم به‌ظاهر از خاک باشد، در واقع به حالت تغییر یافته و مبدل درآمده است."],[458,"زانک خاکی را نباشد تاب آن","که زند بر وی شعاعش جاودان","زیرا خاک نمی‌تواند تاب بیاورد و تحمل کند تابش نور جاودانی را که بر آن می‌تابد."],[458,"گر زند بر خاک دایم تاب خور","آنچنان سوزد که ناید زو ثمر","اگر تابش دائمی خورشید بر خاک بیفتد، آن‌قدر آن را می‌سوزاند که هیچ ثمری از آن بیرون نخواهد آمد."],[458,"دایم اندر آب کار ماهی است","مار را با او کجا همراهی است","ماهی همیشه در آب زندگی می‌کند و کار آن شنا کردن است، اما مار به دلیل طبیعتش نمی‌تواند با ماهی در آب همراه شود."],[458,"لیک در که مارهای پر فن‌اند","اندرین یم ماهییها می‌کنند","اما در این دریا، مارهایی وجود دارند که بسیار ماهرند و در این گرداب آشفته، حرکات ماهی‌ها را زیر نظر دارند و می‌توانند آنها را تحت تأثیر قرار دهند."],[458,"مکرشان گر خلق را شیدا کند","هم ز دریا تاسه‌شان رسوا کند","اگر مکر و فریب آنها مردم را دلبسته و مجذوب کند، در نهایت همین مکر از دریا (یعنی از حقیقت) آنها را رسوا خواهد کرد."],[458,"واندرین یم ماهیان پر فن‌اند","مار را از سحر ماهی می‌کنند","در این دریا، ماهیانی هستند که مهارت زیادی دارند و با سحر و جادو، مار را از درون دریا می‌گیرند."],[458,"ماهیان قعر دریای جلال","بحرشان آموخته سحر حلال","ماهیانی که در عمق دریای بزرگی هستند، از جلال و باشکوهی که دارند، فنون و مهارت‌های خاصی آموخته‌اند که همگی ناشی از قدرت و زیبایی ذات دریا است."],[458,"بس محال از تاب ایشان حال شد","نحس آنجا رفت و نیکوفال شد","اگر انسان‌ها از تابش وجود آن‌ها (به معنای وجود و نور آنها) حال خوبی داشته باشند، در آنجا (جایی که در آن هستند) بخت بدی بر آن‌ها سایه نمی‌افکند و حال آن‌ها نیکو خواهد بود."],[458,"تا قیامت گر بگویم زین کلام","صد قیامت بگذرد وین ناتمام","اگر تا قیامت درباره این سخن بگویم، یکصد قیامت حتی می‌گذرد و این حرف ناقص و ناتمام می‌ماند."],[459,"بر ملولان این مکرر کردنست","نزد من عمر مکرر بردنست","برای افراد بی‌علاقه و خسته، تکرار کارها بی‌فایده است، زیرا به نظر من عمر را با این تکرارها هدر می‌دهند و هیچ سودی نمی‌برند."],[459,"شمع از برق مکرر بر شود","خاک از تاب مکرر زر شود","شمع با تابش مداوم برق روشن می‌شود و خاک با تابش مکرر طلا می‌گردد. این به این معناست که تکرار و استمرار آرامش‌بخش و نیرومند است و می‌تواند سبب تغییر و تحول شود."],[459,"گر هزاران طالب‌اند و یک ملول","از رسالت باز می‌ماند رسول","اگرچه هزاران نفر هستند که به دنبال علم و معرفت‌اند، اما اگر حتی یک نفر بی‌میل و بی‌علاقه باشد، آن فرستاده (رسول) در ابلاغ رسالتش متوقف می‌شود."],[459,"این رسولان ضمیر رازگو","مستمع خواهند اسرافیل‌خو","این پیامبران که اسرار را می‌دانند، از شنوندگان خواهند که مانند اسرافیل باشند؛ یعنی بیدار و مطیع و آماده برای دریافت پیام‌ها. اسرافیل فرشته‌ای است که در روز قیامت به نفخ در صور مشهور است و در اینجا به معنای پذیرش و آمادگی تعبیر شده است."],[459,"نخوتی دارند و کبری چون شهان","چاکری خواهند از اهل جهان","این افراد به سبب مقام و فضل خود، متکبر و مغرور هستند و مانند پادشاهان، از انسان‌های دیگر انتظار دارند که برای آن‌ها خدمتگزاری کنند."],[459,"تا ادبهاشان بجاگه ناوری","از رسالتشان چگونه بر خوری","تا وقتی که ادب‌های آنها را در جای خود قرار ندهی، چگونه می‌توانی از رسالت و پیام آنها بهره‌مند شوی؟"],[459,"کی رسانند آن امانت را بتو","تا نباشی پیششان راکع دوتو","چگونه می‌توانند امانت را به تو برسانند وقتی که تو در برابرشان خضوع و ادب نداشته باشی؟"],[459,"هر ادبشان کی همی‌آید پسند","کامدند ایشان ز ایوان بلند","آداب و رفتار آنان که در اینجا صحبت می‌شود، وقتی خوب و پذیرفتنی است که از جایگاه بلندی (اندیشه یا مقام) آمده باشد. در واقع، کسانی که در این مقام هستند، به خوبی از چیزهایی که می‌آموزند و ارائه می‌دهند آگاه‌اند."],[459,"نه گدایانند کز هر خدمتی","از تو دارند ای مزور منتی","این افراد گدایانی نیستند که به خاطر هر کمکی از تو انتظار داشته باشند و بر تو منت بگذارند."],[459,"لیک با بی‌رغبتیها ای ضمیر","صدقه سلطان بیفشان وا مگیر","ای ضمیر، با بی‌میلی‌ها و بدون شوق، صدقه‌ای که به سلطان داده می‌شود را رها کن و نپذیر."],[459,"اسپ خود را ای رسول آسمان","در ملولان منگر و اندر جهان","ای پیام‌آور آسمان، به افرادی که از زندگی بی‌حوصله و ناامید هستند، نگاه نکن و به دنیا اهمیت نده."],[459,"فرخ آن ترکی که استیزه نهد","اسپش اندر خندق آتش جهد","ترکی خوشبخت است که در هنگام درخواست، اسپش را به وسط خندق آتش می‌برد و به این کار شجاعانه دست می‌زند."],[459,"گرم گرداند فرس را آنچنان","که کند آهنگ اوج آسمان","این بیت به این معناست که آن اسب را به گرمی و شدت به حرکت در می‌آورد، به گونه‌ای که او مانند آهنی داغ به سوی آسمان پرواز می‌کند. مربی می‌خواهد بگوید، که از شدت هیجان و فعالیت، اسب (یا مرید) به اوج بالا می‌رسد."],[459,"چشم را از غیر و غیرت دوخته","همچو آتش خشک و تر را سوخته","چشم خود را به هیچ چیز غیر از محبوب دوخته و نسبت به آن بی‌تفاوت است، مانند آتش که همه چیز را در خود می‌سوزاند؛ یعنی در عشق و دلدادگی، تمام توجهش به معشوق است و از دیگران فارغ است."],[459,"گر پشیمانی برو عیبی کند","آتش اول در پشیمانی زند","اگر پشیمانی به وجود بیاید، به خودی خود عیب و نقصی ایجاد می‌کند، مثل آتش که در آغاز خود، پشیمانی را شعله‌ور می‌سازد."],[459,"خود پشیمانی نروید از عدم","چون ببیند گرمی صاحب‌قدم","پشیمانی خود از نبودن نمی‌روید، زیرا وقتی صاحب‌قدم (دستگاه معرفتی) به گرمی و شور درآید، پشیمانی هم احساس می‌شود."],[460,"اسپ داند بانگ و بوی شیر را","گرچه حیوانست الا نادرا","اسب صدای شیر و بوی او را می‌شناسد، با اینکه او هم یک حیوان است، اما این شناخت در میان حیوانات نادر است."],[460,"بل عدو خویش را هر جانور","خود بداند از نشان و از اثر","هر موجودی از روی نشانه‌ها و آثار، دشمن خود را می‌شناسد و به آن آگاه است."],[460,"روز خفاشک نیارد بر پرید","شب برون آمد چو دزدان و چرید","خفاش در روز نمی‌تواند پرواز کند و شب وقتی که بیرون می‌آید، مانند دزدان که به‌طور پنهانی می‌روند، به جست‌وجو و چریدن می‌پردازد."],[460,"از همه محروم‌تر خفاش بود","که عدو آفتاب فاش بود","خفاش از همه موجودات بیشتر محروم است، زیرا دشمن او، آفتاب، به وضوح و آشکارا در معرض دید است و او نمی‌تواند از آن فرار کند."],[460,"نه تواند در مصافش زخم خورد","نه بنفرین تاندش مهجور کرد","او (خفاش) نمی‌تواند در نبرد با آفتاب آسیب ببیند، و نمی‌تواند از طریق نفرین، آفتاب را دور کند."],[460,"آفتابی که بگرداند قفاش","از برای غصه و قهر خفاش","آفتابی که خفاش را از غم و خشم دور می‌سازد، به معنی نور و روشنی‌ای است که می‌تواند مشکلات و ناامیدی‌ها را برطرف کند."],[460,"غایت لطف و کمال او بود","گرنه خفاشش کجا مانع شود","اگر لطف و کمال خداوندی نبود، خفاش هرگز نمی‌توانست مانع از تابش نور آفتاب شود."],[460,"دشمنی گیری بحد خویش گیر","تا بود ممکن که گردانی اسیر","دشمن خود را در حد و اندازه‌اش شناسایی کن و با او به اندازه‌ای مقابله کن که بتوانی او را به تسخیر درآوری."],[460,"قطره با قلزم چو استیزه کند","ابلهست او ریش خود بر می‌کند","اگر قطره‌ای با دریا (قلزم) بر سر جدال و نزاع باشد، در واقع آن قطره بی‌خود است و به‌دلیل نادانی، موی خود را می‌کند. این بیت به بی‌فایده بودن تلاش برای مقایسه یا جنگیدن با قدرتی بسیار بزرگتر اشاره دارد."],[460,"حیلت او از سبالش نگذرد","چنبره حجره قمر چون بر درد","تدبیر او از زیرکی‌اش خلاص نمی‌شود، چنان‌که دایره‌ای که می‌چرخد، به درد نمی‌آید."],[460,"با عدو آفتاب این بد عتاب","ای عدو آفتاب آفتاب","این بیت به معنای گله و شکایت از دشمنی است که به نور و روشنی، یعنی آفتاب، تشبیه شده است. در واقع، شاعر با این تعبیر می‌خواهد بگوید که دشمنان مانند آفتاب وجود دارند و در عین حال، دارای خصلت‌های خاصی هستند که موجب آسیب به دیگران می‌شوند. این آفتاب به نوعی چندان درخشان و قابل چشم‌پوشی نیست، بلکه موجب عذاب و دشواری است."],[460,"ای عدو آفتابی کز فرش","می‌بلرزد آفتاب و اخترش","ای دشمن آفتابی که از ترس تو، آفتاب و ستاره‌ها در وحشت به لرزه افتاده‌اند."],[460,"تو عدو او نه‌ای خصم خودی","چه غم آتش را که تو هیزم شدی","تو دشمن او نیستی، بلکه با خودت دشمنی می‌کنی. پس چرا نگران آتش باشی، وقتی که خودت هیزم آن شدی؟"],[460,"ای عجب از سوزشت او کم شود","یا ز درد سوزشت پر غم شود","تعجب آور است که آیا از سوزش شخصی، درد او کم می‌شود یا اینکه از این درد، غم او بیشتر می‌شود؟"],[460,"رحمتش نه رحمت آدم بود","که مزاج رحم آدم غم بود","رحمت او (خدا) مانند رحم کردن انسان‌ها نیست؛ زیرا رحم انسان‌ها غالبا با غم و درد همراه است."],[460,"رحمت مخلوق باشد غصه‌ناک","رحمت حق از غم و غصه‌ست پاک","رحمت حاصل از مخلوقات، به خاطر درد و غم‌هایی که دارند، ممکن است با غم و اندوه همراه باشد. اما رحمت حق، از هرگونه غم و اندوه پاک است و خالی از ناراحتی است."],[460,"رحمت بی‌چون چنین دان ای پدر","ناید اندر وهم از وی جز اثر","رحمت بی‌چون، یعنی رحمت بی‌پایان و بی‌پایان خداوند، را این‌گونه بشناس، ای پدر: هیچ تصوری از آن در ذهن نمی‌آید جز نشان‌هایی از اثرات آن."],[461,"ظاهرست آثار و میوه رحمتش","لیک کی داند جز او ماهیتش","آثار و نتایج رحمت الهی در ظاهر نمایان است، اما تنها خداست که می‌تواند ماهیت واقعی آن را درک کند."],[461,"هیچ ماهیات اوصاف کمال","کس نداند جز به آثار و مثال","هیچ‌کس نمی‌تواند ماهیت واقعی چیزها را به طور کامل درک کند، مگر اینکه از طریق نشانه‌ها و نمونه‌ها به آن پی ببرد."],[461,"طفل ماهیت نداند طمث را","جز که گویی هست چون حلوا ترا","کودک ماهیت قاعدگی را نمی‌داند، فقط می‌تواند بگوید که آن شبیه حلوا است."],[461,"کی بود ماهیت ذوق جماع","مثل ماهیات حلوا ای مطاع","کسی که طعم لذت جنسی را نمی‌داند، فقط می‌تواند به ظواهر آن مانند حلوا اشاره کند و تفاوت این دو را متوجه نیست."],[461,"لیک نسبت کرد از روی خوشی","با تو آن عاقل چو تو کودک‌وشی","عاقل به خاطر خوشی و محبت به تو، رفتار و صفاتی شبیه یک کودک از خود نشان می‌دهد، انگار که در فهم و شعور از تو کمتر است."],[461,"تا بداند کودک آن را از مثال","گر نداند ماهیت یا عین حال","کودک فقط چیزی را که از طریق مثال یاد گرفته، می‌فهمد و اگر او ماهیت واقعی یا ذات آن چیز را نادانسته باشد، شناختش کامل نیست."],[461,"پس اگر گویی بدانم دور نیست","ور ندانم گفت کذب و زور نیست","اگر بگویی که من موضوعی را می‌دانم، به معنای این نیست که واقعا درکی از آن داشته باشی؛ ناآگاهی درباره آن موضوع نیز دروغ و بی‌پایه نیست."],[461,"گر کسی گوید که دانی نوح را","آن رسول حق و نور روح را","اگر کسی بگوید که نوح، آن پیامبر خدا و نور روح را می‌شناسد، این به معنای واقعی دانش نیست."],[461,"گر بگویی چون ندانم کان قمر","هست از خورشید و مه مشهورتر","اگر بگویی که من نمی‌دانم قمر (ماه) با خورشید چه نسبتی دارد و چه چیزی او را مشهورتر کرده است، این نشان‌دهنده نادانی‌ام است."],[461,"کودکان خرد در کتابها","و آن امامان جمله در محرابها","کودکان کوچک در کتاب‌ها درس می‌خوانند و آن پیشوایان religieux در مکان‌های مذهبی (محراب‌ها) عبادت می‌کنند."],[461,"نام او خوانند در قرآن صریح","قصه‌اش گویند از ماضی فصیح","این بیت به این نکته اشاره دارد که در قرآن به روشنی نام نوح بیان شده و داستان او به طور واضح و بی‌ابهام نقل شده است."],[461,"راست‌گو دانیش تو از روی وصف","گرچه ماهیت نشد از نوح کشف","راست‌گو را از بیان و توصیف بشناس، هرچند که حقیقت و ذات او مانند نوح به طور کامل روشن نشود."],[461,"ور بگویی من چه دانم نوح را","همچو اویی داند او را ای فتی","اگر بگویی که من چه می‌دانم درباره نوح، باید بدانی که کسی مانند او، ذات و حقیقت او را می‌شناسد."],[461,"مور لنگم من چه دانم فیل را","پشه‌ای کی داند اسرافیل را","من که مانند یک مور در حال حرکت هستم، چطور می‌توانم از فیل (موجود بزرگ و مهم) باخبر باشم؟ و برعکس، پشه‌ای که موجودی کوچک و بی‌اهمیت است، چگونه می‌تواند به عظمت و ویژگی‌های اسرافیل (فرشته‌ای بزرگ) آگاه باشد؟"],[461,"این سخن هم راستست از روی آن","که بماهیت ندانیش ای فلان","این جمله نیز درست است، زیرا تو ماهیت آن چیز را نمی‌دانی، ای فرد مورد نظر."],[461,"عجز از ادراک ماهیت عمو","حالت عامه بود مطلق مگو","ناتوانی در درک ماهیت چیزها، یک وضعیت کلی و عمومی است، بنابراین نباید درباره‌اش صحبت کرد."],[461,"زانک ماهیات و سر سر آن","پیش چشم کاملان باشد عیان","ماهیت‌ها و رازهای آنها برای کسانی که در درک و دانش کامل هستند، به‌وضوح نمایان است."],[461,"در وجود از سر حق و ذات او","دورتر از فهم و استبصار کو","در وجود، حق و ذات الهی از درک و فهم انسانی بسیار دورتر است و ما نمی‌توانیم به درستی آن را درک یا تصور کنیم."],[461,"چونک آن مخفی نماند از محرمان","ذات و وصفی چیست کان ماند نهان","چون این حقیقت پنهان نماند از کسانی که در درک و فهم آن راز دارند، ماهیت و صفات او چیست که هنوز ناشناخته باقی مانده است."],[461,"عقل بحثی گوید این دورست و گو","بی ز تاویل محالی کم شنو","عقل می‌گوید که این مطلب به دور از حقیقت است و بدون تأویل (تفسیر) می‌توانی کم‌وبیش از محالات (چیزهای غیرممکن) بشنوی."],[461,"قطب گوید مر ترا ای سست‌حال","آنچ فوق حال تست آید محال","قطب (یعنی قطب‌لوطی یا استاد) به تو که دارای حال ضعیفی هستی می‌گوید، آنچه که بالاتر از حال توست، محال است. یعنی رسیدن به آن وضعیت برای تو غیرممکن به نظر می‌رسد."],[461,"واقعاتی که کنونت بر گشود","نه که اول هم محالت می‌نمود","تجربه‌هایی که اکنون برای تو روشن شده، در گذشته هم غیرممکن و محال به نظر می‌رسیدند."],[461,"چون رهانیدت ز ده زندان کرم","تیه را بر خود مکن حبس ستم","محمدحسین مسعودی گاوگانی: زمانی که با لطف خویش شما را از زندان گناه و سختی نجات داد، دیگر بر خود ستم نکن و خود را در بند تکبر و خودپسندی زندانی مکن."],[462,"نفی آن یک چیز و اثباتش رواست","چون جهت شد مختلف نسبت دوتاست","رد کردن یا قبول کردن یک چیز از نظر نسبت و جهات مختلف جایز است، زیرا وقتی از زوایای متفاوت به آن نگاه کنیم، می‌توانیم هم نفی کنیم و هم اثبات."],[462,"ما رمیت اذ رمیت از نسبتست","نفی و اثباتست و هر دو مثبتست","عمل تو در پرتاب کردن سنگ، به نسبت دیگری است که در آن نفی و اثبات وجود دارد و در واقع، هر دو مورد مثبت هستند."],[462,"آن تو افکندی چو بر دست تو بود","تو نه افکندی که قوت حق نمود","تو هر چیزی را که به دست می‌آوری، گویی خودت انجام داده‌ای، اما در حقیقت این قدرت الهی است که آن را به وجود می‌آورد و تو را به آن توفیق می‌دهد."],[462,"زور آدم‌زاد را حدی بود","مشت خاک اشکست لشکر کی شود","قدرت و توانایی انسان مرز و محدوده‌ای دارد؛ وقتی او از خاک و همانند آن ساخته شده است، چگونه می‌تواند لشکری بی‌حد و مرز تشکیل دهد؟"],[462,"مشت مشت تست و افکندن ز ماست","زین دو نسبت نفی و اثباتش رواست","در اینجا اشاره شده که آنچه در دست ماست، فقط تکه‌ای از خاک است که می‌توان آن را بر زمین افکند. این به نوعی دو جنبه، یعنی نفی و اثبات وجود آن چیز، را توجیه می‌کند و می‌گوید با توجه به این دو جنبه می‌توان به نوعی به حقیقت آن پی برد."],[462,"یعرفون الانبیا اضدادهم","مثل ما لا یشتبه اولادهم","مردم پیامبران را مانند فرزندانشان می‌شناسند؛ به گونه‌ای که اختلاف آنها با یکدیگر، مانند شناخته شدن فرزندان است که در هیچ چیزی نمی‌توانند شبیه هم باشند."],[462,"همچو فرزندان خود دانندشان","منکران با صد دلیل و صد نشان","منکران پیامبران را مانند فرزندان خود می‌شناسند و در این شناخت، صدها دلیل و نشانه برای اثبات حقانیت آن‌ها دارند."],[462,"لیک از رشک و حسد پنهان کنند","خویشتن را بر ندانم می‌زنند","اما به خاطر حسد و رشک، خود را پنهان می‌کنند و به ناشناسی حمله می‌کنند."],[462,"پس چو یعرف گفت چون جای دگر","گفت لایعرفهم غیری فذر","وقتی خداوند آنها را می‌شناسد، در جای دیگر می‌گوید که غیر از او هیچ‌کس آنها را نمی‌شناسد، پس آنها را رها کن."],[462,"انهم تحت قبابی کامنون","جز که یزدانشان نداند ز آزمون","آن‌ها زیر قبه‌ای پنهان هستند که جز خداوند (یزدان) هیچ‌کس از حال آن‌ها باخبر نیست و هیچ آزمایشی نمی‌تواند آن‌ها را نمایان کند."],[462,"هم بنسبت گیر این مفتوح را","که بدانی و ندانی نوح را","به نسبت به این حقیقت توجه کن؛ اینکه نوح (پیامبر) را هم می‌دانی و هم نمی‌دانی."],[463,"گفت قایل در جهان درویش نیست","ور بود درویش آن درویش نیست","اگر کسی در این دنیا به درویشی اعتراف کند، در واقع درویش نیست، زیرا درویشی که واقعی باشد، خود را نمی‌شناسد و به دنبال نام و مقام نیست."],[463,"هست از روی بقای ذات او","نیست گشته وصف او در وصف هو","از آنجا که ذات خداوند جاودان و باقی است، صفات او نیز به طور واقعی وجود دارند و در وصف دیگران، قابل توصیف نیستند."],[463,"چون زبانه شمع پیش آفتاب","نیست باشد هست باشد در حساب","زبانة شمع در برابر نور آفتاب وجود ندارد و اعتبارش کم‌رنگ می‌شود، اما در حقیقت، شمع همچنان وجود دارد و به حساب می‌آید."],[463,"هست باشد ذات او تا تو اگر","بر نهی پنبه بسوزد زان شرر","ذات او (خدا) وجود دارد، حتی اگر تو (انسان) مانند پنبه بر او بتازی، او همیشه نمی‌سوزد و همچنان باقی می‌ماند."],[463,"نیست باشد روشنی ندهد ترا","کرده باشد آفتاب او را فنا","اگر روشنی وجود نداشته باشد، آفتاب نمی‌تواند به تو نور بدهد و بنابراین وجود او در فناست."],[463,"در دو صد من شهد یک اوقیه خل","چون در افکندی و در وی گشت حل","اگر دوصد من عسل را در یک اوقیه (حدود چهل و پنج گرم) از شکر حل کنی، آن عسل همگی تبدیل به شکر می‌شود. این بیت به مفهوم فنا و زوال اشیاء اشاره دارد و بیان می‌کند که با ورود چیزهایی دیگر، اصل و موجودیت اولیه از بین می‌رود."],[463,"نیست باشد طعم خل چون می‌چشی","هست اوقیه فزون چون برکشی","طعم عسل (خل) وجود ندارد وقتی که بچشی، زیرا وقتی چیزی را بالا می‌کشی (رها می‌کنی) مقدارش بیشتر می‌شود و این حالت در آن وجود ندارد."],[463,"پیش شیری آهوی بیهوش شد","هستی‌اش در هست او روپوش شد","وقتی آهو در برابر شیر بی‌هوش می‌شود، وجودش در واقع زیر پوشش وجود شیر پنهان می‌شود."],[463,"این قیاس ناقصان بر کار رب","جوشش عشقست نه از ترک ادب","این مقایسه‌های نادرست که از عقل ناقص سرچشمه می‌گیرد، ناشی از شور و جوشش عشق است و نه به خاطر ترک آداب و ادب."],[463,"نبض عاشق بی ادب بر می‌جهد","خویش را در کفه شه می‌نهد","عاشق بی‌ادب هیجان و تپش درونی خود را نشان می‌دهد و خود را به پای پادشاه عشق می‌افکند."],[463,"بی‌ادب‌تر نیست کس زو در جهان","با ادب‌تر نیست کس زو در نهان","هیچ‌کس در این دنیا بی‌ادب‌تر از او نیست و هیچ‌کس در نهان نیز باادب‌تر از او وجود ندارد."],[463,"هم بنسبت دان وفاق ای منتجب","این دو ضد با ادب با بی‌ادب","هر دو این وضعیت‌ها یعنی داشتن ادب و بی‌ادبی، نسبت به هم از یکدیگر جدا هستند و در عین حال به یکدیگر مربوطند. تو ای منتخب، باید بفهمی که این دو ویژگی به نوعی با هم در ارتباط‌اند."],[463,"بی‌ادب باشد چو ظاهر بنگری","که بود دعوی عشقش هم‌سری","اگر فقط ظاهر او را ببینی، بی‌ادب و بی‌احترام به نظر می‌آید؛ در حالی که دعوی عشق او حقیقتی عمیق و باطن‌دار دارد."],[463,"چون به باطن بنگری دعوی کجاست","او و دعوی پیش آن سلطان فناست","اگر به عمق و باطن نگاه کنی، می‌فهمی که ادعای عشق و دوستی دروغ است و در واقع آن ادعا در برابر همه چیز فنا و نابود است."],[463,"مات زید زید اگر فاعل بود","لیک فاعل نیست کو عاطل بود","اگر زید به عنوان فاعل و عامل در نظر گرفته شود، مرگ او را می‌توان مرگ زید دانست، اما در واقع او فاعل نیست و بی‌عمل است و همین باعث می‌شود که از نظر وجودی، زید به معنای واقعی مرده است."],[463,"او ز روی لفظ نحوی فاعلست","ورنه او مفعول و موتش قاتلست","او از نظر زبان‌شناسی فاعل است، اما در واقع، مفعول و در اختیار مرگ و فنا قرار دارد."],[463,"فاعل چه کو چنان مقهور شد","فاعلیها جمله از وی دور شد","فاعل چه می‌شود که به این اندازه مغلوب شده است و حتی تمام ویژگی‌های فاعلی از او دور شده است؟"],[464,"در بخارا بنده صدر جهان","متهم شد گشت از صدرش نهان","در بخارا، بنده صدر (مشیر) جهان به جرم (اتیه) یا اتهامی متهم شد و برای فرار از این اتهام، از مقام و جایگاه خود دور شد و پنهان گردید."],[464,"مدت ده سال سرگردان بگشت","گه خراسان گه کهستان گاه دشت","مدت ده سال، او سرگردان و بی‌هدف به سفر می‌رفت، گاهی به خراسان می‌رفت، گاهی به کوهستان و گاهی در دشت‌ها می‌گشت."],[464,"از پس ده سال او از اشتیاق","گشت بی‌طاقت ز ایام فراق","پس از گذشت ده سال، او از شدت اشتیاق و longing، دیگر نتوانست صبر کند و بی‌تاب شد به خاطر دوری و جدایی."],[464,"گفت تاب فرقتم زین پس نماند","صبر کی داند خلاعت را نشاند","او گفت صبرم دیگر در این فراق تمام شده است؛ هیچ‌کس نمی‌داند که چه چشماندازی در انتظارش است، یعنی بقیه هرگز نمی‌توانند درک کنند که چگونه عشقش او را به سوی خود می‌کشد."],[464,"از فراق این خاکها شوره بود","آب زرد و گنده و تیره شود","فراق از دست دادن و جدایی، مانند شوری و تلخی در این دنیا را به وجود می‌آورد و زندگی را به شکل آب زرد، کدر و تیره‌ای تبدیل می‌کند."],[464,"باد جان‌افزا وخم گردد وبا","آتشی خاکستری گردد هبا","اگر باد جان‌افزایی بوزد، زندگی و شادابی را به ارمغان می‌آورد و هر چیزی را که از خاکستری و بی‌روح به نظر می‌رسد، متحول می‌کند."],[464,"باغ چون جنت شود دار المرض","زرد و ریزان برگ او اندر حرض","باغ مثل بهشت می‌شود، اما درختانش بیمار و زرد می‌شوند و برگ‌هایش می‌ریزند."],[464,"عقل دراک از فراق دوستان","همچو تیرانداز اشکسته کمان","عقل که قدرت درک و فهم دارد، در اثر دوری از دوستان و محبوبان، مانند تیراندازی است که کمانی شکسته دارد و نمی‌تواند تیر را به هدف بزند."],[464,"دوزخ از فرقت چنان سوزان شدست","پیر از فرقت چنان لرزان شدست","عذاب فراق برای عاشق به قدری شدید است که مانند آتش دوزخ سوزاننده و دردناک می‌شود، و این درد باعث لرزیدن و ناتوانی پیر (شاید عاشقی با تجربه) می‌گردد."],[464,"گر بگویم از فراق چون شرار","تا قیامت یک بود از صد هزار","اگر بگویم از جدایی چه‌قدر دلم آتش می‌زند، تا قیامت یک بار هم به اندازه صد هزار بار می‌سوزد."],[464,"پس ز شرح سوز او کم زن نفس","رب سلم رب سلم گوی و بس","پس از بیان دل‌تنگی و سوز فراق محبوب، دیگر از آنچه بر جان آدمی می‌گذرد نگو و فقط بگو \"پروردگارم، پروردگارم\" که همین بس است."],[464,"هرچه از وی شاد گردی در جهان","از فراق او بیندیش آن زمان","هر وقت به خاطر دوری از معشوق (وکیل صدر) شاد می‌شوی، به این فکر کن که در این جهان، غم فراق او را فراموش نکن."],[464,"زانچه گشتی شاد بس کس شاد شد","آخر از وی جست و همچون باد شد","به خاطر اینکه تو شاد شدی، دیگران نیز خوشحال شدند؛ اما سرانجام از او فاصله گرفتی و مانند باد ناپدید شدی."],[464,"از تو هم بجهد تو دل بر وی منه","پیش از آن کو بجهد از وی تو بجه","اگر کسی از تو فاصله بگیرد، تو نیز دل به او نسپار و قبل از آن‌که او از تو فرار کند، خودت از او فاصله بگیر."],[465,"همچو مریم گوی پیش از فوت ملک","نقش را کالعوذ بالرحمن منک","به مانند مریم، قبل از مرگ، به ملک (فرشته) بگو، برای پناه بردن به خداوند رحمان، از تو خواهش می‌کنم مرا در آغوش بگیرد."],[465,"دید مریم صورتی بس جان‌فزا","جان‌فزایی دلربایی در خلا","مریم یک صورتی را دید که بسیار جان‌بخش و دلربا بود و این شکل از عالم بالا و آسمانی در فضا ظاهر شده بود."],[465,"پیش او بر رست از روی زمین","چون مه وخورشید آن روح الامین","در برابر او، آن روح الامین (فرشته وحی) به مانند ماه و خورشید از زمین برخاست."],[465,"از زمین بر رست خوبی بی‌نقاب","آنچنان کز شرق روید آفتاب","خوبی و صفای روح القدس، بدون هیچ پرده و حجاب، از زمین به عرش و اوج رسته است، همان‌طور که آفتاب از جانب شرق طلوع می‌کند."],[465,"لرزه بر اعضای مریم اوفتاد","کو برهنه بود و ترسید از فساد","مریم در حالی که برهنه بود، به شدت ترسید و لرزید، زیرا از فساد و گناه می‌ترسید."],[465,"صورتی که یوسف ار دیدی عیان","دست از حیرت بریدی چو زنان","مریم وقتی صورت یوسف را به‌طور واضح دید، از حیرت دست برداشت و مانند زنان به خود آمد."],[465,"همچو گل پیشش برویید آن ز گل","چون خیالی که بر آرد سر ز دل","چنان‌که گل در کنار او می‌روید، او نیز مانند گلی است که خیال دل را از خود به نمایش می‌گذارد."],[465,"گشت بی‌خود مریم و در بی‌خودی","گفت بجهم در پناه ایزدی","مریم در حالتی از بی‌خودگی و حیرت قرار گرفت و در این حالت به خداوند پناه برد."],[465,"زانک عادت کرده بود آن پاک‌جیب","در هزیمت رخت بردن سوی غیب","زیرا آن پاک‌جیب (مریم) عادت کرده بود وقتی که در حال فرار (هزیمت) است، به سمت عالم غیب و معنوی پناه ببرد."],[465,"چون جهان را دید ملکی بی‌قرار","حازمانه ساخت زان حضرت حصار","وقتی فرشتگان آسمانی جهان را مشاهده کردند، با شتاب و بی‌قراری برای حفاظت و نگهبانی از آن حضرت (مریم) حصاری ایجاد کردند."],[465,"تا به گاه مرگ حصنی باشدش","که نیابد خصم راه مقصدش","در زمان مرگ، باید دژی برای انسان باشد که دشمن نتواند به هدف او دست یابد."],[465,"از پناه حق حصاری به ندید","یورتگه نزدیک آن دز برگزید","خداوند برای حفاظت از او (انسان) به گونه‌ای پناهگاهی قرار داده که نمی‌تواند دشمن (ابلیس) به هدفش برسد و به او آسیب بزند."],[465,"چون بدید آن غمزه‌های عقل‌سوز","که ازو می‌شد جگرها تیردوز","وقتی آن نگاه‌های فریبنده و عقل‌سوز را دید، که باعث می‌شد جگرها مانند تیر، به درد بیفتند و آسیب ببینند."],[465,"شاه و لشکر حلقه در گوشش شده","خسروان هوش بیهوشش شده","در این بیت، شاه و لشکر به دور مریم حلقه زده‌اند و از زیبایی و جاذبه‌اش به شدت مجذوب و بی‌هوش شده‌اند، به‌طوری که هوش و خردشان را از دست داده‌اند."],[465,"صد هزاران شاه مملوکش برق","صد هزاران بدر را داده به دق","خداوند برای مملوکانش (بردگان پادشاه) به تعداد بسیار زیاد، خوشی و پاداشی بزرگ فراهم کرده است، به گونه‌ای که نور آنها (مملوک‌ها) به روشنی ستاره‌های درخشان می‌تابد."],[465,"زهره نی مر زهره را تا دم زند","عقل کلش چون ببیند کم زند","زیبایی و جذابیت (زهره) زهره (مریم) تا زمانی وجود دارد که عقل کل (خدا) او را ببیند، و در آن صورت نخواهد بود که زیبایی را به خود بگیرد یا کم شود."],[465,"من چگویم که مرا در دوخته‌ست","دمگهم را دمگه او سوخته‌ست","من نمی‌دانم چگونه بگویم که در این حال که نفس من در خطر است، نفس (روح) او به گونه‌ای جانسوز شده است."],[465,"دود آن نارم دلیلم من برو","دور از آن شه باطل ما عبروا","من دلیل خود را از درد دل ناشی از آن آتش (عشق) می‌دانم؛ از آنجا که این عشق به من یاری می‌دهد تا از آن پادشاه دروغین و فریبنده دور شوم."],[465,"خود نباشد آفتابی را دلیل","جز که نور آفتاب مستطیل","هیچ‌کس نمی‌تواند برای آفتاب دلیل و نشانه‌ای ارائه دهد، جز خود نور آفتاب که به شکل مستطیل، روشنایی را نمایان می‌کند."],[465,"سایه کی بود تا دلیل او بود","این بس استش که ذلیل او بود","سایه چه چیزی می‌تواند باشد تا دلیل وجود او محسوب شود؟ همین کافی است که او ذلیل و ناتوان است."],[465,"این جلالت در دلالت صادقست","جمله ادراکات پس او سابقست","این عظمت و بزرگی در نشانه‌گذاری و دلالت حقیقت دارد و تمامی درک‌ها و دانش‌ها پیش از او وجود دارند و از آن سرچشمه می‌گیرند."],[465,"جمله ادراکات بر خرهای لنگ","او سوار باد پران چون خدنگ","جملگی ادراکات، بر افرادی ناتوان و کم‌فهم مانند خرهای لنگ سوارند و آن‌ها مثل تیرهایی پرتاب می‌شوند."],[465,"گر گریزد کس نیابد گرد شه","ور گریزند او بگیرد پیش ره","اگر کسی از پادشاه بگریزد، هرگز نمی‌تواند او را پیدا کند، اما اگر خود پادشاه مانند کسی که گریز می‌زند، به دنبال فرد گریزنده برود، او را در مسیر خود خواهد یافت."],[465,"جمله ادراکات را آرام نی","وقت میدانست وقت جام نی","هیچ یک از ادراکات و آگاهی‌ها در زمان مناسب خود، آرام و ثابت نمی‌مانند؛ چون وقتی انسان در حال خوشگذرانی یا سرخوشی است، نمی‌تواند به درک صحیحی برسد."],[465,"آن یکی وهمی چو بازی می‌پرد","وآن دگر چون تیر معبر می‌درد","یکی از ادراکات ذهنی شبیه به بازی است که به صورت تصادفی جلوه می‌کند، در حالی که دیگری مانند تیری است که به دقت و هدفمند مسیرش را می‌سوزاند و می‌شکافد."],[465,"وان دگر چون کشتی با بادبان","وآن دگر اندر تراجع هر زمان","این بیت به مقایسه بین دو حالت متفاوت می‌پردازد. یکی از آن‌ها مانند کشتی است که با بادبان حرکت می‌کند و به جلو می‌رود، در حالی که دیگری همیشه در حال پس‌گردانی و عقب‌نشینی است. این تصویر نشان‌دهنده دو نوع رفتار یا وضعیت است که یکی پیشرفت و حرکت رو به جلو و دیگری عدم پیشرفت و تزلزل را نشان می‌دهد."],[465,"چون شکاری می‌نمایدشان ز دور","جمله حمله می‌فزایند آن طیور","چون شکاری از دور به نظر می‌رسد، تمام پرندگان به سوی او حمله می‌کنند و بر شدت حمله خود می‌افزایند."],[465,"چونک ناپیدا شود حیران شوند","همچو جغدان سوی هر ویران شوند","وقتی که آن شکار ناپیدا می‌شود، پرندگان هم مانند جغدها حیرت‌زده می‌شوند و به سمت هر ویرانی می‌روند."],[465,"منتظر چشمی به هم یک چشم باز","تا که پیدا گردد آن صید به ناز","چشم‌ها را بسته‌ایم و منتظریم که آن شکار زیبا و دلربا (که در اینجا به روح القدس اشاره دارد) پیدا شود."],[465,"چون بماند دیر گویند از ملال","صید بود آن خود عجب یا خود خیال","اگر مدت زیادی بگذرد و آن صید به انتظار نرسد، می‌گویند که آنچه انتظارش را می‌کشیدند، فقط ملال و دل‌سردی بوده است، یا اینکه آن صید وجود نداشته و فقط خیال و پنداری بوده که در ذهن آنان نشسته است."],[465,"مصلحت آنست تا یک ساعتی","قوتی گیرند و زور از راحتی","مصلحت این است که انسان باید در یک برهه از زمان، نیرویی به دست آورد و از آرامش و راحتی بهره‌مند شود تا بتواند به توانایی و قدرت خود برسد."],[465,"گر نبودی شب همه خلقان ز آز","خویشتن را سوختندی ز اهتزاز","اگر شب نبود، همه‌ی مردم از آز و طمع خود به خاکستر تبدیل می‌شدند و در عذاب رنج می‌کشیدند."],[465,"از هوس وز حرص سود اندوختن","هر کسی دادی بدن را سوختن","افرادی که به هوس و حرص خود مشغولند و از آن برای به دست آوردن سود استفاده می‌کنند، در حقیقت باعث آتش‌سوزی وجود خود می‌شوند و خود را در معرض خطر قرار می‌دهند."],[465,"شب پدید آید چو گنج رحمتی","تا رهند ازحرص خود یکساعتی","شب که می‌رسد، برکت و رحمتی مانند یک گنج آشکار می‌شود تا مردم بتوانند به مدت یک ساعت از حرص و طمع خود فاصله بگیرند."],[465,"چونک قبضی آیدت ای راه‌رو","آن صلاح تست آتش دل مشو","ای مسافر، وقتی که به تو تسلطی یا گرفتن چیزی برسد، آن به نفع توست و برای تو خوب است، پس در دل خود ناراحت یا التماس نکن."],[465,"زآنک در خرجی در آن بسط و گشاد","خرج را دخلی بباید زاعتداد","از آن جایی که در خرج و هزینه، گشایش و وسعت وجود دارد، لازم است که در مقدار هزینه کردن نیز تدبیری به خرج داده شود."],[465,"گر هماره فصل تابستان بدی","سوزش خورشید در بستان شدی","اگر همیشه فصل تابستان بود، سوزش خورشید در باغ شدت پیدا می‌کرد و تحمل آن دشوار می‌شد."],[465,"منبتش را سوختی از بیخ و بن","که دگر تازه نگشتی آن کهن","تو ریشه درخت قدیمی را سوزاندی و از بین بردی، بنابراین دیگر آن درخت نمی‌تواند جوانه بزند و تازه شود."],[465,"گر ترش‌رویست آن دی مشفق است","صیف خندانست اما محرقست","اگر در آن دی (دوران یا زمان) او ترش‌رو و عبوس باشد، همچنانکه به نظر می‌رسد، در حقیقت مهربان است. اما در صفای زمان طرب و شادابی، همچنان که از ظاهرش پیداست، آتشین و سوزان است."],[465,"چونک قبض آید تو در وی بسط بین","تازه باش و چین میفکن در جبین","زمانی که قبض و سختی و تنگی به تو برسد، در آن لحظه بسط و گشایش را ببین و اجازه نده افکار منفی و اندوه بر forehead (جبین) تو تأثیر بگذارد."],[465,"کودکان خندان و دانایان ترش","غم جگر را باشد و شادی ز شش","کودکان همواره خندان هستند و دانایان و برزگسالان همیشه ترشرو هستند /// چون شادی کودکان از شش است ولی ترشروئی بزرگسالان از جگر است. در طب و روانشناسی قدیم چنین باوری وجود داشته است."],[465,"چشم کودک همچو خر در آخرست","چشم عاقل در حساب آخرست","چشم کودک مانند چشم خر، در آخر کار به چیزهای ساده و ظاهری دقت می‌کند، اما چشم عاقل به نتیجه و حساب و کتاب نهایی می‌نگرد."],[465,"او در آخر چرب می‌بیند علف","وین ز قصاب آخرش بیند تلف","کودک در پایان کار تنها به خوشمزگی علف‌ها توجه می‌کند و این در حالی است که قصاب در پایان کار، چیزی جز فساد و تخریب نمی‌بیند."],[465,"آن علف تلخست کین قصاب داد","بهر لحم ما ترازویی نهاد","این علف تلخ، که قصاب برای ما به عنوان غذا داد، به خاطر اینکه ترازویی برای اندازه‌گیری گوشت ما گذاشته است، مفهومی تیره و ناخوشایند دارد."],[465,"رو ز حکمت خور علف کان را خدا","بی غرض دادست از محض عطا","از حکمت، تو باید از گیاهی که خداوند به‌خاطر لطف و بی‌هیچ هدفی به ما داده است، بخوری."],[465,"فهم نان کردی نه حکمت ای رهی","زانچ حق گفتت کلوا من رزقه","ای رهی، تو فقط خوردن نان را درک کرده‌ای، نه حکمت را؛ زیرا خدا به تو گفته است: «از روزی‌اش بخورید»."],[465,"رزق حق حکمت بود در مرتبت","کان گلوگیرت نباشد عاقبت","رزق الهی در واقع همان حکمت است که در مرتبه‌ای است که گلوگیرت نمی‌شود و باعث دردسر نمی‌گردد."],[465,"این دهان بستی دهانی باز شد","کو خورنده لقمه‌های راز شد","زمانی که انسان در مقام سکوت و انزوای باطنی قرار می‌گیرد و از بیان خودداری می‌کند، در حقیقت دهانی برای دریافت دانش و اسرار باز می‌شود و به درک و فهم معانی عمیق‌تری نائل می‌شود."],[465,"گر ز شیر دیو تن را وابری","در فطام اوبسی نعمت خوری","اگر از شیر دیو (شیر نشانه قدرت و دیو نشانه شر) بدن خود را آزاد کنی، در دامان صلاح و خوبی بسیاری نعمت‌ها را خواهی چشید."],[465,"ترک‌جوشش شرح کردم نیم‌خام","از حکیم غزنوی بشنو تمام","این که من گفتم پخته نبود و نیم خام رها می‌کنم /// اگر سخن پخته می‌خواهی از حکیم سنائی غزنوی بشنو"],[465,"در الهی‌نامه گوید شرح این","آن حکیم غیب و فخرالعارفین","در «الهی‌نامه» (کتابی از عطار نیشابوری) توضیح می‌دهد این موضوع را، آن حکیم غیب (عطار نیشابوری) و بزرگ‌ترین عارفان را ستایش می‌کند."],[465,"غم خور و نان غم‌افزایان مخور","زانک عاقل غم خورد کودک شکر","غم را تحمل کن و به حرف غم‌افزا گوش نده، زیرا عاقل کسی است که در وقتی غمگین است، شکر را به دندان می‌زند، نه اینکه غم را تشدید کند."],[465,"قند شادی میوه باغ غمست","این فرح زخمست وآن غم مرهمست","شادی و خوشحالی در واقع نتیجه تلخی‌ها و غم‌هاست؛ مانند میوه شیرین در باغی که پر از غم است. این خوشحالی از زخمی ناشی می‌شود که در وجود انسان است و آن غم به عنوان مرهمی برای این زخم عمل می‌کند."],[465,"غم چو بینی در کنارش کش به عشق","از سر ربوه نظر کن در دمشق","وقتی که غم را می‌بینی، آن را کنار بگذار و به عشق نگاه کن، مانند کسی که در جایی مرتفع به دمشق (شهر زیبای سوریه) می‌نگرد."],[465,"عاقل از انگور می بیند همی","عاشق از معدوم شی بیند همی","عقل، حقیقت چیزها را از موجودات واقعی، مانند انگور، درک می‌کند، اما عاشق با چشم دل خود، از چیزهای ناچیز و غیرموجود نیز عشق می‌ورزد و معنای عشق را در آن‌ها می‌بیند."],[465,"جنگ می‌کردند حمالان پریر","تو مکش تا من کشم حملش چو شیر","حمالان (باربران) برای اینکه بار را از دوش همدیگر بردارند، با یکدیگر درگیر می‌شدند. یکی از آن‌ها به دیگری می‌گوید که تو (در این جنگ) نکشید؛ بگذار من بار را با قدرت و شجاعت مانند شیر از دوش خود بردارم."],[465,"زانک زان رنجش همی‌دیدند سود","حمل را هر یک ز دیگر می‌ربود","زیرا هر یک از حمالان که رنج و سختی همدیگر را می‌دیدند، برای خود بهره‌ای به دست می‌آوردند و از یکدیگر چیزهایی را می‌گرفتند."],[465,"مزد حق کو مزد آن بی‌مایه کو","این دهد گنجیت مزد و آن تسو","مزد و پاداش خداوند چیست؟ در حالی که شخص بی‌ارزش و بی‌مقدار، گنجی را به دست می‌آورد، در حالی که آن‌که ارزشمند است، پاداشی بدست نمی‌آورد."],[465,"گنج زری که چو خسپی زیر ریگ","با تو باشد ان نباشد مرده ریگ","گنج با ارزشی که مانند دانه‌ای گرانبها در زیر خاک پنهان شده، هرگز مرده و بی‌ارزش نیست، پس آنچه در زیر خاک است، در واقع زنده و ارزشمند است."],[465,"پیش پیش آن جنازه‌ت می‌دود","مونس گور و غریبی می‌شود","در این بیت، جنازه انسان در حال حرکت به سمت گور است و در این‌جا مونس یا همراه آن جنازه، غریبی و تنهایی است که به سراغش می‌آید. به عبارتی، وقتی مرگ نزدیک است، احساس تنهایی و غریبی در وجود آدمی بیشتر می‌شود."],[465,"بهر روز مرگ این دم مرده باش","تا شوی با عشق سرمد خواجه‌تاش","هر روز باید به مرگ و فنا نگاه کنی و خود را مانند جسدی مرده ببینی تا بتوانی به عشق ابدی خداوند نزدیک شوی و به مقام او برسید."],[465,"صبر می‌بیند ز پرده اجتهاد","روی چون گلنار و زلفین مراد","صبر به‌خوبی در سایه دانش و اجتهاد خود را نشان می‌دهد، مانند گل نارنج و زلف‌های محبوب."],[465,"غم چو آیینه‌ست پیش مجتهد","کاندرین ضد می‌نماید روی ضد","غم مانند یک آیینه است که به مجتهد (دانشمند و پژوهشگر) نشان می‌دهد که در این وضعیت، زیبایی‌ها و خوبی‌ها (روی ضد) به‌چشم نمی‌خورد و در عوض فقط زشتی‌ها نمایان می‌شود."],[465,"بعد ضد رنج آن ضد دگر","رو دهد یعنی گشاد و کر و فر","پس از رنج و مشکلات، روی دیگری نمایان خواهد شد که نشان‌دهنده گشایش، وسعت و خوشحالی است."],[465,"این دو وصف از پنجه دستت ببین","بعد قبض مشت بسط آید یقین","این بیت به توانایی و قدرت خدا اشاره دارد که همان‌طور که در دست خدا درگیر شدن و بسته شدن وجود دارد، در عین حال بسط و گشایش نیز به وجود می‌آید. به این معنا است که بعد از سختی‌ها، آسایش و گشایش نیز خواهد آمد."],[465,"پنجه را گر قبض باشد دایما","یا همه بسط او بود چون مبتلا","اگر پنجه خداوند همیشه فشرده باشد، در این صورت، بسط و گسترش آن نیز به صورت مبتلا شدن به او خواهد بود. به عبارت دیگر، اگر چیزی در قبض و محدودیت باشد، در عین حال می‌تواند در گسترش و بسط هم قرار گیرد."],[465,"زین دو وصفش کار و مکسب منتظم","چون پر مرغ این دو حال او را مهم","به خاطر این دو ویژگی، کار و کسب او منظم و مرتب است، همان‌طور که پر پرنده به اوج ارتفاع می‌رسد."],[465,"چونک مریم مضطرب شد یک زمان","همچنانک بر زمین آن ماهیان","وقتی مریم یک لحظه مضطرب و نگران شد، مانند حالتی که ماهی‌ها به هنگام غرق شدن در آب روی زمین احساس می‌کنند، در دلش تلاطم و آشفتگی به وجود آمد."],[466,"بانگ بر وی زد نمودار کرم","که امین حضرتم از من مرم","صدایی به مریم می‌زند و می‌گوید: من نماینده‌ی خداوند و امین او هستم، از من نترس و پنهان مشو."],[466,"از سرافرازان عزت سرمکش","از چنین خوش‌محرمان خود درمکش","تو از سرافرازان باعزت و بزرگ‌مقام هستی، پس از چنین دوستان و رازداران خوب دوری مکن و خود را از آن‌ها جدا نکن."],[466,"این همی گفت و ذباله نور پاک","از لبش می‌شد پیاپی بر سماک","این شخص (روح القدس) این کلمات را می‌گفت و هر بار که صحبت می‌کرد، نور پاکی از لبانش مثل ذرات ریز به بالا می‌رفت."],[466,"از وجودم می‌گریزی در عدم","در عدم من شاهم و صاحب علم","تو از وجود من فرار می‌کنی، اما در عدم (عدم یعنی عدم وجود) من شاه و صاحب علم هستم."],[466,"خود بنه و بنگاه من در نیستیست","یکسواره نقش من پیش ستیست","اگر خود را رها کنی و به حقیقت وجودیت توجه کنی، در عدم (نیستی) تنها یک سویی از هستی من دیده می‌شود. نقش من (هستی من) در این عالم پیش تو حضور دارد و به چشم می‌آید."],[466,"مریما بنگر که نقش مشکلم","هم هلالم هم خیال اندر دلم","ای مریم، نیک بنگر که تصویر مشکل (ای پیامبر) من هم شبیه هلال است و هم یک خیال در دل من نشسته است."],[466,"چون خیالی در دلت آمد نشست","هر کجا که می‌گریزی با توست","هر کجا که بروی، یک خیال یا فکر در دل تو وجود دارد و نمی‌توانی از آن فرار کنی."],[466,"جز خیالی عارضی و باطلی","کو بود چون صبح کاذب آفلی","این خیال‌هایی که به دل انسان می‌آید، چیزی جز تصورات بی‌پایه و سطحی نیستند و مانند سپیده‌دمی کاذب هستند که به زودی ناپدید می‌شود."],[466,"من چو صبح صادقم از نور رب","که نگردد گرد روزم هیچ شب","من مانند سپیده‌دم روشن و پاک هستم که از نور خداوند می‌درخشد و هرگز در تیرگی‌های شب، دچار نقصان و آلودگی نمی‌شوم."],[466,"هین مکن لاحول عمران زاده‌ام","که ز لاحول این طرف افتاده‌ام","بنگر که من از سوی خداوند بی‌نیاز و جاودانه می‌آیم. بنابراین، نباید ناراحت و نگران باشی، زیرا من از همان منبعی آمده‌ام که تو نیز باید به آن پیوند داشته باشی."],[466,"مر مرا اصل و غذا لاحول بود","نور لاحولی که پیش از قول بود","من از نور الهی و حقیقتی که فراتر از همه کلام‌ها و گفته‌هاست، به وجود آمده‌ام و این نور، اصلی و غذای من است."],[466,"تو همی‌گیری پناه ازمن به حق","من نگاریده پناهم در سبق","تو به حق، از من پناه می‌گیری، در حالی که من نوشته‌ی پناه تو هستم و این موضوع از قبل تعیین شده است."],[466,"آن پناهم من که مخلصهات بود","تو اعوذ آری و من خود آن اعوذ","من پناه تو هستم که به خاطر خلوص و پاکی‌ام، پناهی برای تو شده‌ام. تو به من پناه می‌آوری و در واقع من همان پناهگاه تو هستم."],[466,"آفتی نبود بتر از ناشناخت","تو بر یار و ندانی عشق باخت","بدتر از این نیست که تو یار خود را نشناسی و ندانستی عشق را باخته‌ای."],[466,"یار را اغیار پنداری همی","شادیی را نام بنهادی غمی","اگر یار خود را به غریبه‌ها نسبت دهی و آن را شادی تصور کنی، در واقع آن شادی، غم است."],[466,"اینچنین نخلی که لطف یار ماست","چونک ما دزدیم نخلش دار ماست","این نخل که از لطف یار ما سر برآورده، به دلیل اینکه ما خود را دزد می‌دانیم، باغی نیست که به ما تعلق داشته باشد."],[466,"اینچنین مشکین که زلف میر ماست","چونکه بی‌عقلیم این زنجیر ماست","زلف میرداد، مانند مشک تیره و خوشبوست، اما چون من بی‌عقل هستم، این زنجیر (وابستگی) به او برای من مشکل‌ساز شده است."],[466,"اینچنین لطفی چو نیلی می‌رود","چونکه فرعونیم چون خون می‌شود","لطف و زیبایی نیل به گونه‌ای است که به سمت او می‌رود، همان‌طور که فرعون به خشم می‌آید و حالتی چون خون به خود می‌گیرد."],[466,"خون همی‌گوید من آبم هین مریز","یوسفم گرگ از توام ای پر ستیز","خون می‌گوید که من مثل آب هستم، بنابراین مرا هدر نده. من یوسف هستم و تو مانند گرگ هستی که با من درگیر شده‌ای."],[466,"تو نمی‌بینی که یار بردبار","چونکه با او ضد شدی گردد چو مار","تو متوجه نمی‌شوی که وقتی با یار صبور و آرام خود دشمنی می‌کنی، مانند ماری گزنده می‌شوی و به او آسیب می‌زنی."],[466,"لحم او و شحم او دیگر نشد","او چنان بد جز که از منظر نشد","جسد مریم (مادر عیسی) و گوشت او دیگر به حالت عادی و طبیعی بازنگشت، بلکه فقط به خاطر اینکه او در دید و منظر الهی قرار گرفت، به چنین حالتی دچار شد."],[467,"شمع مریم را بهل افروخته","که بخارا می‌رود آن سوخته","مریم، مادر عیسی، شمع روشنی را که به خاطر عشقش بر افروخته شده است، در حالی می‌بیند که آن شخص سوخته و زخمی در حال رفتن به بخارا است."],[467,"سخت بی‌صبر و در آتشدان تیز","رو سوی صدر جهان می‌کن گریز","او که به شدت بی‌صبر است و در آتش عشق می‌سوزد، باید به سرعت از سرزمین خود به سوی بالای جهان فرار کند."],[467,"این بخارا منبع دانش بود","پس بخاراییست هرک آنش بود","بخارا مرکز علم و دانش بوده است و بنابراین هر کسی که از آنجا به علم و دانش دست یابد، به نوعی از سوز و شوق آنجا برخوردار است."],[467,"پیش شیخی در بخارا اندری","تا به خواری در بخارا ننگری","او در حضور یک شیخ در بخارا قرار دارد و باید مراقب باشد که اگر به فکر عیش و نوش باشد، باعث ننگ و ذلت او در بخارا خواهد شد."],[467,"جز به خواری در بخارای دلش","راه ندهد جزر و مد مشکلش","دل او جز در حال خواری و ذلت در بخارا آرام نمی‌گیرد و مشکلاتش نیز در نوسان و زحمت هستند."],[467,"ای خنک آن را که ذلت نفسه","وای آنکس را که یردی رفسه","خوشا به حال کسی که با ذلت نفس (یعنی پست و ذلیل شدن روح و نفس) رو به رو می‌شود و از آن می‌گریزد؛ و وای بر کسی که به رفیقش خیانت می‌کند."],[467,"فرقت صدر جهان در جان او","پاره پاره کرده بود ارکان او","فراق و جدایی از محبوب دنیا، وجود او را به شدت رنجور و آشفته کرده و اجزای وجودش را از هم جدا کرده است."],[467,"گفت بر خیزم هم‌آنجا واروم","کافر ار گشتم دگر ره بگروم","او می‌گوید که بلند می‌شود و به آنجا می‌رود، و اگر به کفر گراییدم، دوباره مسیر خود را تغییر می‌دهم و به سمت دیگری می‌روم."],[467,"واروم آنجا بیفتم پیش او","پیش آن صدر نکواندیش او","می‌گوید که به محض اینکه به آنجا برسم، بی‌پروا و بی‌ملاحظگی در برابر او می‌افتم، در برابر آن شخصیت بزرگ و عاقل."],[467,"گویم افکندم به پیشت جان خویش","زنده کن یا سر ببر ما را چو میش","می‌گویم جانم را به پای تو افکنده‌ام؛ تو یا مرا زنده کن یا مانند میش سرم را ببر."],[467,"کشته و مرده به پیشت ای قمر","به که شاه زندگان جای دگر","ای قمر (ماه)، من به خاطر عشق تو کشته و مرده‌ام، و بر این باورم که زندگی در کنار تو بهتر از هر زندگی دیگری است."],[467,"آزمودم من هزاران بار بیش","بی تو شیرین می‌نبینم عیش خویش","من بارها امتحان کرده‌ام، اما بدون تو هیچ لذتی در زندگی‌ام نمی‌بینم و همه چیز برایم تلخ و دردآور است."],[467,"غن لی یا منیتی لحن النشور","ابرکی یا ناقتی تم السرور","ای کاش ای محبوب من، لحن برآمدن روز قیامت را بشنوی و ای کاش ای ناقه من، دلت شاد شود."],[467,"ابلعی یا ارض دمعی قد کفی","اشربی یا نفس وردا قد صفا","ای زمین، اگر اشک من کفایت کند، پس به من بگو که آیا می‌توانم بنوشم؟ ای نفس، آیا به خاطر صفای خود می‌توانی مرا سیراب کنی؟"],[467,"عدت یا عیدی الینا مرحبا","نعم ما روحت یا ریح الصبا","به ما خوش آمدی، عید و جشن تو را گرامی می‌داریم. ای نسیم خوشبو، تو ما را زنده کردی و به ما روح تازه‌ای بخشیدی."],[467,"گفت ای یاران روان گشتم وداع","سوی آن صدری که میر است و مطاع","گفت: ای دوستان، جانم آزاد شده و به سوی آن مقام عالی می‌روم که در آنجا کسی مثل پادشاه و فرمانروایی وجود دارد."],[467,"دم‌بدم در سوز بریان می‌شوم","هرچه بادا باد آنجا می‌روم","من هر لحظه در آتش عشق می‌سوزم و بی‌توجه به هر چیز دیگری، تنها به سمت بخارا می‌روم."],[467,"گرچه دل چون سنگ خارا می‌کند","جان من عزم بخارا می‌کند","هرچند که دل من مانند سنگ سخت و ناپذیر می‌شود، اما جان و روح من همچنان تصمیم به رفتن به بخارا (شهری که یادآور عشق من است) دارد."],[467,"مسکن یارست و شهر شاه من","پیش عاشق این بود حب الوطن","محل زندگی معشوق و شهر پادشاه من، در نظر عاشق، منبعی از عشق و محبت به وطن است."],[468,"گفت معشوقی به عاشق کای فتی","تو به غربت دیده‌ای بس شهرها","معشوق به عاشق می‌گوید: ای جوان، تو که در غربت زندگی می‌کنی، شهرهای زیادی را دیده‌ای."],[468,"پس کدامین شهر ز آنها خوشترست","گفت آن شهری که در وی دلبرست","معشوق از عاشق می‌پرسد که کدام یک از شهرهایی که دیده است، برای او خوش‌تر بوده است. عاشق پاسخ می‌دهد که شهری که در آن دلبرش باشد، بهترین است."],[468,"هرکجا باشد شه ما را بساط","هست صحرا گر بود سم الخیاط","هرجا که شاه (معشوق) ما باشد، برای ما زندگی و خوشی برقرار است، حتی اگر آن جا بیابانی باشد یا درخت و گیاهی نداشته باشد."],[468,"هر کجا که یوسفی باشد چو ماه","جنتست ارچه که باشد قعر چاه","هر کجا که یوسف، نماد زیبایی و خوش‌معنایی، وجود داشته باشد، آن مکان بهشت است، حتی اگر در اعماق چاه (که نماد تاریکی و سختی) باشد."],[469,"گفت او را ناصحی ای بی‌خبر","عاقبت اندیش اگر داری هنر","ناصح به او می‌گوید: ای فرد ناآگاه، اگر اندیشه‌ی عاقبت‌نگر داری، باید هنری هم داشته باشی."],[469,"درنگر پس را به عقل و پیش را","همچو پروانه مسوزان خویش را","به عقب که نگاه کنی، با عقل و اندیشه رفتار کن، و به جلو جلوه‌ای از پروانه داشته باش که خود را بسوزاند و فدای عشق کند."],[469,"چون بخارا می‌روی دیوانه‌ای","لایق زنجیر و زندان‌خانه‌ای","زمانی که به بخارا می‌روی، تو دیوانه‌ای هستی که سزاوار زنجیر و زندان است."],[469,"او ز تو آهن همی‌خاید ز خشم","او همی‌جوید ترا با بیست چشم","او از تو آهن (معنی آن به شدت سختی و قدرت) می‌خواهد و به خاطر خشمش به دنبال تو می‌گردد با بیست چشم. یعنی او به شدت عصبانی است و دقت زیادی به خرج می‌دهد تا تو را پیدا کند."],[469,"می‌کند او تیز از بهر تو کارد","او سگ قحطست و تو انبان آرد","او از سر خشم به خاطر تو، کارد را تیز می‌کند و در حالی که تو در آرامش هستی، به او می‌گوید که او مانند سگی در بیابان است و تو مثل انباری هستی که از آذوقه پر است."],[469,"چون رهیدی و خدایت راه داد","سوی زندان می‌روی چونت فتاد","وقتی که از خطر نجات پیدا کردی و خداوند به تو راهی نشان داد، به سوی زندان می‌روی و مانند زندانی به دام افتاده هستی."],[469,"بر تو گر ده‌گون موکل آمدی","عقل بایستی کز ایشان کم زدی","اگر ده نفر هم برای نگهبانی تو آمده باشند، باید از عقل خود به آن‌ها اعتماد کنی و از این که از آن‌ها کاسته‌ای، بپرهیزی."],[469,"چون موکل نیست بر تو هیچ‌کس","از چه بسته گشت بر تو پیش و پس","وقتی موکل (نگهبان)ی بر تو نیست و هیچ‌کس به تو توجه نمی‌کند، دلیل بسته شدن کارهایت چیست و چرا در گذشته و آینده گرفتار شده‌ای؟"],[469,"عشق پنهان کرده بود او را اسیر","آن موکل را نمی‌دید آن نذیر","عشق، او را پنهانی در قلبش اسیر کرده بود و او نمی‌توانست موکل خود را، که همان استهزاء یا عذاب است، ببیند."],[469,"هر موکل را موکل مختفیست","ورنه او در بند سگ طبعی ز چیست","هر نگهبانی (موکل) یک نگهبان پنهان (موکل مختفی) دارد و اگر این‌گونه نبود، او به خاطر طبیعت زشتش در بند (دست‌بند) قرار می‌گرفت."],[469,"خشم شاه عشق بر جانش نشست","بر عوانی و سیه‌روییش بست","خشم شاه عشق (که نماد عشق الهی یا محبت است) بر روح او حاکم شد و بر چهره‌اش که نماد سیاه‌رویی و غم است، سایه افکند."],[469,"می‌زند او را که هین او رابزن","زان عوانان نهان افغان من","او (شاه عشق) به کسی که به عوانان (بدکاران) پناه برده، هشدار می‌دهد و می‌گوید که به او آسیب می‌زند، چون در دل خود او را می‌زند و کسی که در میان عوانان است، خود را دچار پریشانی و افسردگی کرده است."],[469,"هرکه بینی در زیانی می‌رود","گرچه تنها ، با عوانی می‌رود","هرکس را که می‌بینی در حال ضرر و زیان است، هرچند که به تنهایی در حال رفتن باشد، در واقع با گروهی از شرارتکاران در حال رفتن است."],[469,"گر ازو واقف بدی افغان زدی","پیش آن سلطان سلطانان شدی","اگر از وضعیت او آگاه بودی و از درد او آگاهانه شکایت می‌کردی، در پیش آن پادشاه بزرگ، بزرگ‌ترین مقام را به دست می‌آوردی."],[469,"ریختی بر سر به پیش شاه خاک","تا امان دیدی ز دیو سهمناک","بر سر شاه خاک انداختی تا زمانی که از دیو ترسناک امنیت پیدا کردی."],[469,"میر دیدی خویش را ای کم ز مور","زان ندیدی آن موکل را تو کور","ای شخص، خودت را مانند مور کوچک و حقیر می‌بینی، اما از آن موکل بزرگ که به تو نزدیک است، بی‌خبر و ناشنوا هستی، مانند کسی که نابیناست."],[469,"غره گشتی زین دروغین پر و بال","پر و بالی کو کشد سوی وبال","تو به‌واسطه دروغ‌های فریبنده و خوش‌خبری‌های بی‌پایه خود را فریب داده‌ای و به خیال خود، به اوج و ترقی رسیده‌ای، در حالی که این پر و بال تو توهمی است که به سوی بند و مشکلات می‌کشد."],[469,"پر سبک دارد ره بالا کند","چون گل‌آلو شد گرانیها کند","کسی که به خود مغرور شده و به اوج می‌رود، چنان‌که پروازش سبک و آزاد باشد، حالا که به مشکلاتی دچار شده، سنگینی بار بر دوشش می‌آید و او را خسته می‌کند."],[470,"گفت ای ناصح خمش کن چند چند","پند کم ده زانکه بس سختست بند","گفت ای نصیحت‌کننده، ساکت باش و دیگر پند نده، زیرا قید و بند عشق بسیار سنگین و دشوار است."],[470,"سخت‌تر شد بند من از پند تو","عشق را نشناخت دانشمند تو","پند و نصیحت تو باعث نمی‌شود که رنج من کم شود، زیرا تو به عمق عشق و احساسات من آگاه نیستی و درک واقعی از آن نداری."],[470,"آن طرف که عشق می‌افزود درد","بوحنیفه و شافعی درسی نکرد","در جایی که عشق وجود دارد و افزایش می‌یابد، درد و رنج دو فقیه معروف، بوحنیفه و شافعی، هیچ اثری ندارد و به آموزه‌های آنها توجهی نمی‌شود."],[470,"تو مکن تهدید از کشتن که من","تشنه زارم به خون خویشتن","تهدید به کشتن مرا نکن، زیرا من به شدت عاشق هستم و در پی سوزش و رنج خویش، تشنه‌ام."],[470,"عاشقان را هر زمانی مردنی‌ست","مردن عشاق خود یک نوع نیست","عاشقان همیشه در معرض مرگ هستند، اما مرگ آنها متفاوت است و هر یک از عاشقان به شیوه‌ای خاص می‌میرد."],[470,"او دو صد جان دارد از جان هدی","وآن دوصد را می‌کند هر دم فدی","عاشق که اوست، دو صد جان دارد و این جان‌ها را به خاطر محبوبش (هدی) هر لحظه فدای او می‌کند."],[470,"هر یکی جان را ستاند ده بها","از نبی خوان عشرة امثالها","هر کس که جانش را فدای عشق کند، در عوض باید ده جان دیگر به دست آورد. اینجا اشاره به ارزشی است که فدای عشق و محبت دارد و نشان می‌دهد که در این مسیر، جان‌های بیشتری به دست می‌آید."],[470,"گر بریزد خون من آن دوست‌رو","پای‌کوبان جان برافشانم برو","حتی اگر آن دوستی که برایم عزیز است، خونم را بریزد، با شور و شوق جانم را فدای او می‌کنم و به پای او می‌افزایم."],[470,"آزمودم مرگ من در زندگی‌ست","چون رهم زین زندگی پایندگی‌ست","من دریافتم که مرگ من در حقیقت در زندگی نهفته است، چون از این زندگی به سمت جاودانگی و پایندگی حرکت می‌کنم."],[470,"اقتلونی اقتلونی یا ثقات","ان فی قتلی حیاتا فی حیات","به من بگویید که مرا بکشید، زیرا در مرگ من زندگی وجود دارد و در این زندگی‌ای که دارم، حیات واقعی نهفته است."],[470,"یا منیر الخد یا روح البقا","اجتذب روحی وجد لی باللقا","ای روشنی‌صورت، ای روح بقای هستی، جانم را جذب کن و به من بگو که با دیدار تو به وجد آمده‌ام."],[470,"لی حبیب حبه یشوی الحشا","لو یشا یمشی علی عینی مشی","عاشق اگر بخواهد، محبوبش به دلش می‌آید و اگر بخواهد، به گونه‌ای حرکت می‌کند که گویا بر چشم‌های او می‌رود."],[470,"پارسی گو گرچه تازی خوشترست","عشق را خود صد زبان دیگرست","هرچند که زبان فارسی زیباست، اما زبان عربی در بیان عشق جذاب‌تر است. عشق خودش هزاران زبان دارد و به شیوه‌های مختلف ابراز می‌شود."],[470,"بوی آن دلبر چو پران می‌شود","آن زبان‌ها جمله حیران می‌شود","وقتی بوی دلبر به مشام می‌رسد، همه زبان‌ها و گفتارها از حیرت و شگفتی خاموش می‌شوند."],[470,"بس کنم‌، دلبر در آمد در خطاب","گوش شو والله اعلم بالصواب","دلبر (محبوب) وارد شد و با صدای دلنشینش صحبت کرد. من دیگر چیزی نمی‌گویم، زیرا تنها خدا می‌داند که حقیقت چیست و چه درست است."],[470,"چونک عاشق توبه کرد اکنون بترس","کو چو عیاران کند بر دار درس","عاشق وقتی که توبه کرد، باید بترسد، زیرا ممکن است مانند دزدان و عیاران که بر دار (مکان‌هایی که مجازات می‌شدند) قرار می‌گیرند، در معرض خطر و مجازات قرار گیرد."],[470,"گرچه این عاشق بخارا می‌رود","نه به درس و نه به استا می‌رود","این عاشق به شهر بخارا می‌رود، اما نه برای تحصیل علم و نه برای یادگیری از استاد."],[470,"عاشقان را شد مدرس حسن دوست","دفتر و درس و سبق‌شان روی اوست","عاشقان برای یادگیری و آموزش به مدرسه نمی‌روند؛ آنان تمام درس و آموختنشان درباره زیبایی و محبت خداوند است و تمام توجهشان به او معطوف است."],[470,"خامشند و نعره تکرار‌شان","می‌رود تا عرش و تخت یارشان","عاشقان در سکوت و آرامش هستند، اما صدای فریادشان آن‌قدر بلند و رساست که به عرش و محل نشستن معشوق می‌رسد."],[470,"درس‌شان آشوب و چرخ و زلزله","نه زیادات است و باب سلسله","آموزش‌های آن‌ها باعث بلوا و آشفتگی می‌شود و سبب آرامش نیست، بلکه تنها به موضوع‌های بی‌اهمیت می‌پردازند."],[470,"سلسله این قوم جعد مشکبار","مسأله دورست لیکن دور یار","پیوند این گروه، مانند موی فرشته‌ای خوشبو و زیباست. مسأله وجود دارد و در عین حال، به دوری محبوب اشاره دارد که به نظر می‌رسد دشوار و بعید است."],[470,"مسأله کیس ار بپرسد کس ترا","گو نگنجد گنج حق در کیسه‌ها","اگر کسی در مورد مسأله عشق و معرفت بپرسد، به او بگو که گنج حقیقت در کیسه‌ها و مال و ثروت نمی‌گنجد و برای یافتن آن نباید به ظاهر و possessions زندگی اکتفا کرد."],[470,"گر دم خلع و مبارا می‌رود","بد مبین ذکر بخارا می‌رود","اگر کسی در حال سخن گفتن از خلع و رهایی است، نباید نگران باشی؛ زیرا در پس این سخن، اشاره به بخارا و زیبایی‌ها و ویژگی‌هایش وجود دارد."],[470,"ذکر هر چیزی دهد خاصیتی","زانک دارد هر صفت ماهیتی","هر چیزی که ذکرش به میان آید، خاصیتی به همراه دارد، زیرا هر صفتی ماهیت خاص خود را دارد."],[470,"آن بخاری غصه دانش نداشت","چشم بر خورشید بینش می‌گماشت","غصه دانش، همان آتش یا بخاری است که بر اثر نداشتن بینش ایجاد می‌شود، و کسی که واقعا بینش دارد، به جای غصه خوردن، نگاهش به آفتاب حقیقت و بینش است."],[470,"هرکه در خلوت به بینش یافت راه","او ز دانش‌ها نجوید دستگاه","هر کسی که در تنهایی به فهم عمیق و بصیرت برسد، دیگر نیازی به دانش‌ها و اطلاعات ظاهری ندارد و به راحتی حقیقت را می‌بیند."],[470,"با جمال جان چو شد هم‌کاسه‌ای","باشدش ز اخبار و دانش تاسه‌ای","وقتی با معشوق هم‌نشین شود، اخبار و دانش‌ها جذابیتی ندارند و ملالت‌بار می‌شوند."],[470,"دید بر دانش بود غالب فرا","زان همی دنیا بچربد عامه را","عاشقانی که به جمال معشوق رسیده‌اند، حتی بر دانش و آگاهی نیز تسلط و تسلّط دارند، زیرا در این دنیا، عوام مردم به راحتی به دنیای مادی مشغول می‌شوند و تحت تأثیر آن قرار می‌گیرند."],[470,"زانکه دنیا را همی‌بینند عین","وآن جهانی را همی‌دانند دین","چون مردم فقط به ظاهر دنیا نگاه می‌کنند و این دنیا را می‌بینند، در عوض، از عالم معنوی و حقیقت‌های دینی غافل هستند."],[471,"رو نهاد آن عاشق خونابه‌ریز","دل‌طپان سوی بخارا گرم و تیز","آن عاشق که دلش پر از درد و اندوه است، با شوق و هیجان و تندی به سوی بخارا می‌رود."],[471,"ریگ آمون پیش او همچون حریر","آب جیحون پیش او چون آبگیر","ریگ بیابان آمون در مقابل او نرم و لطیف مانند حریر به نظر می‌رسید و آب جیحون در حضور او به زیبایی و صفا مانند آبگیر به نظر می‌رسید."],[471,"آن بیابان پیش او چون گلستان","می‌فتاد از خنده او ، چون گل‌ ستان","آن بیابان در برابر او چنان رونق و زیبایی می‌گرفت که مانند گلستان به نظر می‌رسید، به گونه‌ای که همه چیز از شادی او سرشار بود."],[471,"در سمرقندست قند اما لبش","از بخارا یافت و آن شد مذهبش","سمرقند محل تولید قند است، اما آن شخص (عاشق) در عشق و محبت خود به بخارا (محلی دیگر) عشق می‌ورزد و این عشق برای او تبدیل به عقیده و باور شده است."],[471,"ای بخارا عقل‌افزا بوده‌ای","لیکن ازمن عقل و دین بربوده‌ای","بخارا، شهری بوده که عقل و دانش را افزایش می‌دهد، اما تو از من عقل و دین را گرفته‌ای."],[471,"بدر می‌جویم از آنم چون هلال","صدر می‌جویم درین صف نعال","من از بخارا که عقل و دین را از من گرفته، دنبال نور و روشنی هستم؛ همان‌طور که هلال (ماه) نور می‌تابد، دنبال ستاره‌ای در این صف پر از غم و اندوه می‌گردم."],[471,"چون سواد آن بخارا را بدید","در سواد غم بیاضی شد پدید","وقتی آن عاشق به تیرگی‌های بخارا (شهری در ماوراءالنهر) نظر انداخت، در دلش غم و اندوهی نمایان شد که مانند رنگ سفید (حکایت از خلوص و اندوه) آشکار شد."],[471,"ساعتی افتاد بیهوش و دراز","عقل او پرید در بستان راز","او لحظه‌ای بی‌هوش بر زمین افتاد و عقلش در میان اندیشه‌های عمیق و پنهان ناپدید شد."],[471,"بر سر و رویش گلابی می‌زدند","از گلاب عشق او غافل بدند","بر روی او گل‌های قرمز می‌ریختند و این نشان از عشق او بود، اما دیگران به این موضوع توجهی نداشتند و از عشق او بی‌خبر بودند."],[471,"او گلستانی نهانی دیده بود","غارت عشقش ز خود ببریده بود","او دنیایی پنهان و غنی از زیبایی و دل‌انگیزی را تجربه کرده بود، اما به خاطر شدت عشقش، از خود و نیازهایش دور شده بود."],[471,"تو فسرده درخور این دم نه‌ای","با شکر مقرون نه‌ای گرچه نیی","تو در این لحظه به شادابی و سرزندگی نیاز داری و با حال ناخوش و افسرده خود نمی‌توانی از شکر و شیرینی عشق بهره‌مند شوی، هرچند که در اصل تو وجودی شیرین و با ارزش هستی."],[471,"رخت عقلت با توست و عاقلی","کز جنودا لم تروها غافلی","وجود عقل تو در کنارت است، اما تو از نشانه‌ها و نشانه‌های آن که ظاهرا نمی‌بینی غافلی."],[472,"اندر آمد در بخارا شادمان","پیش معشوق خود و دارالامان","او با خوشحالی و شادی وارد شهر بخارا شد تا نزد معشوق خود و جای امنی برود."],[472,"همچو آن مستی که پرد بر اثیر","مه کنارش گیرد و گوید که گیر","مانند آن مستی که پرده‌ای (مانند حجاب) در اثر نور ماه به او نزدیک می‌شود و می‌گوید مرا بگیر، اشاره به حالتی از شیدایی و عشق دارد که فرد عاشق به شدت جذب معشوقش می‌شود."],[472,"هرکه دیدش در بخارا گفت خیز","پیش از پیدا شدن منشین گریز","هر کسی که تو را در بخارا ببیند، به تو خواهد گفت که قبل از اینکه پیدا شوی، از اینجا فرار کن."],[472,"که ترا می‌جوید آن شه خشمگین","تا کشد از جان تو ده ساله کین","آن شاه خشمگین (که ممکن است نماد عشق یا حقیقت باشد) تو را می‌جوید تا انتقام ده سال کینه‌ای که از تو دارد را از جانت بگیرد."],[472,"الله الله درمیا در خون خویش","تکیه کم کن بر دم و افسون خویش","خدا را! در خون خود فرو نرو و تکیه نکن بر نیروی خود و ترفندهایی که به کار می‌بری."],[472,"شحنه صدر جهان بودی و راد","معتمد بودی مهندس اوستاد","تو در مرتبه‌ای بلند و در جایگاه والایی بودی، و کسی بودی که می‌توان به او اعتماد کرد و تدبیرها را به دست او سپرد."],[472,"غدر کردی وز جزا بگریختی","رسته بودی باز چون آویختی","تو خیانت کردی و از کیفر فرار کردی، اما دوباره وقتی گرفتار شدی، دوباره به همانی که بودی برگشتی."],[472,"از بلا بگریختی با صد حیل","ابلهی آوردت اینجا یا اجل","تو با ترفندهای بسیار از بلا و خطر گریخته‌ای، اما بی‌خبر از آنی که در اینجا تو را احمقانه به این وضعیت کشانده یا این که زمان مرگت فرارسیده است."],[472,"ای که عقلت بر عطارد دق کند","عقل و عاقل را قضا احمق کند","ای کسی که عقل تو مانند عطارد (سیاره‌ای نزدیک به خورشید) در تلاطمی دائمی و بی‌ثباتی است، بدان که قضا و سرنوشت، انسان‌های عاقل را نیز به کارهای احمقانه می‌کشاند."],[472,"نحس خرگوشی که باشد شیرجو","زیرکی و عقل و چالاکیت کو","نخوت و بدشانسی‌ای که به نظر می‌رسد از خرگوشی به وجود آمده، در حالی که باید در وجود شیر، که نماد زیرکی و عقل است، پیدا شود. به بیان دیگر، پیام این بیت این است که زیرکی و عقل باید در زندگی ما وجود داشته باشد و نه بدشانسی و ندانم‌کاری."],[472,"هست صد چندین فسونهای قضا","گفت اذا جاء القضا ضاق الفضا","بسیاری از جادوها و تاثیری که سرنوشت به همراه دارد وجود دارد، چرا که وقتی سرنوشت فرامی‌رسد، فضا و آزادی عمل محدود می‌شود."],[472,"صد ره و مخلص بود از چپ و راست","از قضا بسته شود کو اژدهاست","بسیاری از راه‌ها و راه‌حل‌ها برای نجات وجود دارد، اما وقتی قضا و قدر (سرنوشت) مانند اژدهایی مهارکننده پیش می‌آید، همه آنها به بن‌بست می‌رسند."],[473,"گفت من مستسقیم آبم کشد","گرچه می‌دانم که هم آبم کشد","گفت: من دچار استسقا (بیماری تشنگی همیشگی) هستم. آب مرا به سمت خود می‌کشد. هرچند میدانم که بسیار آب خوردن مرا خواهد کشت."],[473,"هیچ مستسقی بنگریزد ز آب","گر دو صد بارش کند مات و خراب","هیچ کس که تشنه و در جستجوی آب است، حتی اگر بارها در برابر آب نیز حیران و بی‌هوش شود، از آب رویگردان نمی‌شود."],[473,"گر بیاماسد مرا دست و شکم","عشق آب از من نخواهد گشت کم","اگر عشق مرا به حیرت و شگفتی دچار کند، به‌طوری که دست و شکم من آسیب ببیند، از وجود من آب و مایه‌ای کم نخواهد شد."],[473,"گویم آنگه که بپرسند از بطون","کاشکی بحرم روان بودی درون","می‌گویم اگر از درون خودم بپرسند، کاش که در دریای عشق بودی و روان."],[473,"خیک اشکم گو بدر از موج آب","گر بمیرم هست مرگم مستطاب","اشک من مانند خیکی است که باید از درون آب خارج شود. اگر بمیرم، مرگ من برایم خوشایند و مطلوب است."],[473,"من بهر جایی که بینم آب جو","رشکم آید بودمی من جای او","هرجا که آب زلال و خوشگوار (آب جو) را می‌بینم، حسادت و شوق به من دست می‌دهد و می‌خواهم در آنجا باشم."],[473,"دست چون دف و شکم همچون دهل","طبل عشق آب می‌کوبم چو گل","دستم مانند ساز دف و شکمم مانند طبل دهل است؛ من در عشق، به شوق و شور، مانند گلی می‌کوبم و آواز می‌زنم."],[473,"گر بریزد خونم آن روح الامین","جرعه جرعه خون خورم همچون زمین","اگر روح‌الامین (ملک جبرائیل) خون من را بریزد، من جرعه‌جرعه آن را می‌نوشم مانند زمین که خونی را که جذب می‌کند، به خود می‌گیرد."],[473,"چون زمین و چون جنین خون‌خواره‌ام","تا که عاشق گشته‌ام این کاره‌ام","من همچون زمین و جنینی که به خون نیاز دارد، تشنه‌ام و از آنجایی که به عشق رسیده‌ام، به این حالت درآمده‌ام."],[473,"شب همی‌جوشم در آتش همچو دیگ","روز تا شب خون خورم مانند ریگ","شب‌ها در آتش عشق می‌جوشم و درد می‌کشم، و در روزها تا شب خون می‌خورم و عذاب می‌بینم مانند ریگ که به آرامی و به تعداد زیاد می‌ریزند."],[473,"من پشیمانم که مکر انگیختم","از مراد خشم او بگریختم","من از این که به خاطر خواسته‌ام او را فریب دادم و موجب خشمش شدم، بسیار پشیمانم و از عذاب او فرار کردم."],[473,"گو بران بر جان مستم خشم خویش","عید قربان اوست و عاشق گاومیش","من از خشم خود به جان مست و شادابم، این خشم برای من مانند عید قربان است، زیرا عاشق شادمانم که در عشق خود غنی و پرورش‌یافته‌ام."],[473,"گاو اگر خسپد وگر چیزی خورد","بهر عید و ذبح او می‌پرورد","اگر گاو بخوابد یا چیزی بخورد، برای عید قربان و قربانی شدن او پرورش داده می‌شود."],[473,"گاو موسی دان مرا جان داده‌ای","جزو جزوم حشر هر آزاده‌ای","من تو را با گاوی نسبت می‌دهم که متعلق به موسی است و این جان تو را به من بخشیده‌ای؛ تو بخشی از حشر (زندگی و رستاخیز) هر انسان آزاد هستی."],[473,"گاو موسی بود قربان گشته‌ای","کمترین جزوش حیات کشته‌ای","تو به مانند گاو موسی (که در داستان موسی ناتوان بود و قربانی شد)، به خاطر عشق و شوق به حق، جان خود را فدا کرده‌ای و هیچ بهره‌ای از زندگی از تو باقی نمانده است، چرا که عشق تو را به کشتن کشانده است."],[473,"برجهید آن کشته ز آسیبش ز جا","در خطاب اضربوه بعضها","کشته‌ای که آسیب دیده بود، از جایش به‌سرعت برخاست و به کسانی که به او آسیب زده بودند، گفت: «به هم بزنید و او را بزنید."],[473,"یا کرامی اذبحوا هذا البقر","ان اردتم حشر ارواح النظر","ای دوستان، اگر می‌خواهید ارواح نگاه‌ها را جمع کنید، این گاو را قربانی کنید."],[473,"از جمادی مردم و نامی شدم","وز نما مردم به حیوان برزدم","از حالت جماد مردم و به حالت نباتی و نامی وارد شدم، سپس از نامی بودن مردم و به حیوان بودن وارد شدم"],[473,"مردم از حیوانی و آدم شدم","پس چه ترسم کی ز مردن کم شدم","از حیوان بودن مردم و تبدیل به آدم شدم، پس چرا از مرگ بترسم؟ آیا تا به حال از مردن چیزی از من کم شده؟"],[473,"حمله دیگر بمیرم از بشر","تا بر آرم از ملایک پر و سر","بار دیگر از انسان بودن بمیرم تا از فرشتگان سر در بیاورم"],[473,"وز ملک هم بایدم جستن ز جو","کل شیء هالک الا وجهه","و از فرشته بودن هم باید فرا تر را بجویم زیرا هر چیز از بین می رود به جز ذات او (آیه ۲۸ سوره قصص)"],[473,"بار دیگر از ملک قربان شوم","آنچ اندر وهم ناید آن شوم","بار دیگر از فرشته بودن بمیرم و تبدیل به آن چیزی شوم که حتی در ذهن انسان نمی‌گنجد"],[473,"پس عدم گردم عدم چون ارغنون","گویدم که انا الیه راجعون","من می‌شوم عدم، همان‌گونه که صدای ارغنون (نوازنده) می‌گوید که ما به سوی او خواهیم رفت."],[473,"مرگ دان آنک اتفاق امتست","کاب حیوانی نهان در ظلمتست","بدان که مرگ برای همه ی امت اتفاق می افتد و آب حیات در ظلمت پس از مرگ پنهان شده."],[473,"همچو نیلوفر برو زین طرف جو","همچو مستسقی حریص و مرگ‌جو","مانند نیلوفر آبی که در این طرف جوی آب قرار دارد، تو نیز از این سمت به سوی آب برو؛ مانند کسی که تشنه و حریص است و به دنبال مرگ می‌گردد."],[473,"مرگ او آبست و او جویای آب","می‌خورد والله اعلم بالصواب","عاشق در جستجوی جانان و محبت اوست، ولی در واقع تنها در مسیر مرگ و نابودی خود قدم می‌زند. او فکر می‌کند که در این جستجو به آب حیات می‌رسد، اما حقیقت این است که آنچه دنبال می‌کند، منجر به مرگش می‌شود."],[473,"ای فسرده عاشق ننگین نمد","کو ز بیم جان ز جانان می‌رمد","ای عاشق بی‌روح و بی‌همت، تو که از ترس جانت از معشوق فرار می‌کنی، ننگ بر تو باد!"],[473,"سوی تیغ عشقش ای ننگ زنان","صد هزاران جان نگر دستک‌زنان","به خاطر عشق او، ای زنان که شرم دارید، هزاران جان را ببینید که با شوق و اشتیاق در راه او جان می‌بازند و خود را به خطر می‌اندازند."],[473,"جوی دیدی کوزه اندر جوی ریز","آب را از جوی کی باشد گریز","اگر جوی را ببینی که کوزه‌ای در آن است، آیا آب می‌تواند از جوی فرار کند؟"],[473,"آب کوزه چون در آب جو شود","محو گردد در وی و جو او شود","وقتی آب کوزه در آب جوی ریخته می‌شود، در آن به کلی محو می‌شود و انگار جوی خودش می‌شود."],[473,"وصف او فانی شد و ذاتش بقا","زین سپس نه کم شود نه بدلقا","وصف خداوند ناپدید می‌شود و ذات او باقی و پایدار است، بنابراین هیچ‌گاه نه کم می‌شود و نه دگرگون."],[473,"خویش را بر نخل او آویختم","عذر آن را که ازو بگریختم","من خود را به درخت او (عشق یا معشوق) آویزان کرده‌ام تا به خاطر این که از او دور شده‌ام، عذرخواهی کنم."],[474,"همچو گویی سجده کن بر رو و سر","جانب آن صدر شد با چشم تر","عاشق مانند کسی است که در حال سجده، چهره و سرش را به زمین می‌گذارد و با چشمی گریان به سمت محبوبش نگاه می‌کند."],[474,"جمله خلقان منتظر سر در هوا","کش بسوزد یا برآویزد ورا","همه انسان‌ها در انتظار هستند، یا باید به عشق و معشوق خود برسند و از شوق بسوزند، یا باید از سر حسرت دست بکشند و خود را از امید جدا کنند."],[474,"این زمان این احمق یک لخت را","آن نماید که زمان بدبخت را","این زمان، این انسان نادان به طور کامل وضعیت اسفناک و بدبختی را نشان می‌دهد که دچارش شده است."],[474,"همچو پروانه شرر را نور دید","احمقانه در فتاد از جان برید","شخصی همچون پروانه به نار جست و در اثر نور شرر (شعله) بی‌دلیل و احمقانه متوجه شد که جان خود را به خطر انداخته و به دور آن می‌گردد."],[474,"لیک شمع عشق چون آن شمع نیست","روشن اندر روشن اندر روشنیست","شمع عشق مانند شمع‌های معمولی نیست؛ بلکه حتی در روشنی، شعلۀ خاصی دارد و کیفیتی متمایز از سایر شمع‌ها می‌بخشد."],[474,"او به عکس شمعهای آتشیست","می‌نماید آتش و جمله خوشیست","او برخلاف شمع‌های واقعی، به نظر آتشین می‌آید، اما در حقیقت، شعله‌ای ندارد و تنها ظاهری از شادابی و خوشی را ارائه می‌دهد."],[475,"یک حکایت گوش کن ای نیک‌پی","مسجدی بد بر کنار شهر ری","یک داستانی را بشنو ای فرد نیکوکار، درباره‌ی مسجدی بد که در کنار شهر ری واقع شده است."],[475,"هیچ کس در وی نخفتی شب ز بیم","که نه فرزندش شدی آن شب یتیم","در آن مسجد هیچ‌کس به خواب نرفته بود، زیرا ترس از این داشتند که فرزند یتیمی به دنیا نیامده باشد و او در آن شب یتیم بماند."],[475,"بس که اندر وی غریب عور رفت","صبحدم چون اختران در گور رفت","به اندازه‌ای در آن مکان (مسجد) غریب و عریان رفت که صبح زود مانند ستاره‌ها به زیر خاک رفت."],[475,"خویشتن را نیک ازین آگاه کن","صبح آمد خواب را کوتاه کن","خودت را به خوبی بشناس و درک کن که صبح شده، پس خواب را رها کن و بیدار شو."],[475,"هر کسی گفتی که پریانند تند","اندرو مهمان کشان با تیغ کند","هر کسی که گفتی که وجود پریان در اینجا تند و تیز است، بدان که مهمان‌کشانی در آنجا وجود دارند که با شمشیر آماده‌اند."],[475,"آن دگر گفتی که سحرست و طلسم","کین رصد باشد عدو جان و خصم","دیگری گفته که اینجا سحر و طلسم وجود دارد و این مکان به گونه‌ای است که دشمن جان و خصم (دشمن) در آنجا مراقب هستند."],[475,"آن دگر گفتی که بر نه نقش فاش","بر درش کای میهمان اینجا مباش","او اشاره می‌کند به این که بر در آن مسجد، نقش و علامتی وجود دارد که به وضوح نوشته شده و به میهمان می‌گوید که اینجا نماند."],[475,"شب مخسپ اینجا اگر جان بایدت","ورنه مرگ اینجا کمین بگشایدت","اگر واقعا زندگی‌ات برایت مهم است، در اینجا شب را به خواب نرو؛ زیرا مرگ در این مکان کمین کرده و تو را می‌گیرد."],[475,"وان یکی گفتی که شب قفلی نهید","غافلی کاید شما کم ره دهید","یکی گفت که اگر شب در اینجا قفل را ببندید، غافلید؛ زیرا این شبی که در آن هستید می‌تواند فرصتی برای شما باشد و باید از آن غافل نشوید."],[476,"تا یکی مهمان در آمد وقت شب","کو شنیده بود آن صیت عجب","در شب، مهمانی به آنجا آمد که درباره‌ی شهرت و آوازه‌ی آن مکان چیزهای شگفت‌انگیز شنیده بود."],[476,"از برای آزمون می‌آزمود","زانک بس مردانه و جان سیر بود","او (مهمان) برای آزمون دیگران را امتحان می‌کرد، زیرا در دلش مردانگی و شجاعت زیادی وجود داشت و از زندگی پرمعنا و سرشار بود."],[476,"گفت کم گیرم سر و اشکمبه‌ای","رفته گیر از گنج جان یک حبه‌ای","گفت: کم بگیر، یعنی خیلی چیزها نداشته باش و سر و شکل خود را کمتر زیبا نشان بده. اشکمبه‌ای (یعنی چیز زیادی از ظاهر) را رها کن و به درون خود بپرداز، چرا که از گنج جان می‌توانی یک دانه کوچک هم بدست آوری."],[476,"صورت تن گو برو من کیستم","نقش کم ناید چو من باقیستم","بدن من را رها کن و بگو من کی هستم، زیرا شکل و ظاهری که دارم، نمی‌تواند نشان‌دهنده‌ی حقیقت من باشد."],[476,"چون نفخت بودم از لطف خدا","نفخ حق باشم ز نای تن جدا","وقتی که خداوند از رحمتش به من دمید، من نیز از حقیقت الهی هستم و از این رو، از نای جسم جدا شده‌ام."],[476,"تا نیفتد بانگ نفخش این طرف","تا رهد آن گوهر از تنگین صدف","تا زمانی که صدای نای تو در این سو نرسد، آن گوهر ارزشمند از تنگی صدف رها نخواهد شد."],[476,"چون تمنوا موت گفت ای صادقین","صادقم جان را برافشانم برین","زمانی که «تمنوا موت» (یعنی آرزوی مرگ کنید) به زبان می‌آید، اینجا سخن از صادقان است که می‌گویند من نیز اگر لازم باشد، جانم را به خاطر این هدف بزرگ فدای شما می‌کنم."],[477,"قوم گفتندش که هین اینجا مخسپ","تا نکوبد جانستانت همچو کسپ","جمعی به او گفتند که در اینجا نمان، زیرا ممکن است جانت مانند کپس (که ظرفی است که درش بسته می‌شود) محبوس و گرفتار شود."],[477,"که غریبی و نمی‌دانی ز حال","کاندرین جا هر که خفت آمد زوال","تو غریب هستی و نمی‌دانی حال کسانی که در اینجا خوابند؛ زیرا کسی که در این مکان بخوابد، به زودی دچار زوال و نقصان می‌شود."],[477,"اتفاقی نیست این ما بارها","دیده‌ایم و جمله اصحاب نهی","این هیچ چیز عجیبی نیست، ما بارها اینگونه رفتارها را مشاهده کرده‌ایم و همه دوستانی که نهی کرده‌اند نیز همین را دیده‌اند."],[477,"هر که آن مسجد شبی مسکن شدش","نیم‌شب مرگ هلاهل آمدش","هر کسی که شبی در آن مسجد (یعنی در کنار خدا و در حال عبادت) اقامت کرد، به ناگاه در نیمه شب با مرگ و خطرات آن مواجه می‌شود."],[477,"از یکی ما تابه صد این دیده‌ایم","نه به تقلید از کسی بشنیده‌ایم","ما از یک نفر تا این تعداد تجربه کرده‌ایم و این را نه به خاطر تقلید از کسی، بلکه به صورت مستقیم و شخصی مشاهده کرده‌ایم."],[477,"گفت الدین نصیحه آن رسول","آن نصیحت در لغت ضد غلول","گفت: دین نصیحت است، همان‌طور که آن پیامبر فرمود. این نصیحت در زبان، مخالف غلول (خیانت) است."],[477,"این نصیحت راستی در دوستی","در غلولی خاین و سگ‌پوستی","این نصیحتی که می‌گویی در رابطه با دوستی است، همان‌طور که در غلول (خیانت) و در سگ‌پوستی (دروغ‌گویی) نمی‌باشد."],[477,"بی خیانت این نصیحت از وداد","می‌نماییمت مگرد از عقل و داد","این نصیحتی که در مورد دوستی می‌گویم، ناشی از خیانت نیست، بلکه از عشق و دوستی واقعی است، بنابراین از عقل و انصاف دور نکنید."],[478,"گفت او ای ناصحان من بی ندم","از جهان زندگی سیر آمدم","او به ناصحان می‌گوید که من از زندگی خسته و دل‌زده شده‌ام و دیگر چیزی برای از دست دادن ندارم."],[478,"منبلی‌ام زخم جو و زخم‌خواه","عافیت کم جوی از منبل براه","من آدمی هستم که به درد و زخم عادت کرده‌ام و کسی که به دنبال آرامش و عافیت است، نباید از من توقع داشته باشد."],[478,"منبلی نی کو بود خود برگ‌جو","منبلی‌ام لاابالی مرگ‌جو","منبلی کسی نیست که به دنبال مروارید (برگ‌جو) باشد، بلکه من خودم بی‌خیال و بی‌پروا از مرگ هستم."],[478,"منبلی نی کو به کف پول آورد","منبلی چستی کزین پل بگذرد","کسی که مانند منبلی (دروغین و دروغگو) نیست، پول را به آسانی به دست نمی‌آورد. اما منبلی (شخصی بی‌خیال و بی‌مسئولیت) سریع و چابک است و می‌تواند از پل مشکلات عبور کند."],[478,"آن نه کو بر هر دکانی بر زند","بل جهد از کون و کانی بر زند","کسی که فقط بر سر هر دکانی می‌رود و به دنبال سود است، بر اثر تلاش و کوشش از میان موجودات و عالم مادی به مقصد بالاتری می‌رسد."],[478,"مرگ شیرین گشت و نقلم زین سرا","چون قفس هشتن پریدن مرغ را","مرگ برای من شیرین شد و از این دنیای مادی جدا شدم، مانند پرنده‌ای که از قفسی کوچک به پرواز درمی‌آید."],[478,"آن قفس که هست عین باغ در","مرغ می‌بیند گلستان و شجر","عاشق در قفس، زیبایی‌هایی را می‌بیند که در اصل متعلق به باغ است، همان‌طور که مرغ در قفس، گل و درختان را تصور می‌کند، اگرچه خود در فضای تنگ قرار دارد."],[478,"جوق مرغان از برون گرد قفس","خوش همی‌خوانند ز آزادی قصص","گروهی از پرندگان که در خارج از قفس هستند، درباره آزادی و زیبایی آن با هم آواز می‌خوانند و داستان‌هایی درباره‌اش می‌گویند."],[478,"مرغ را اندر قفس زان سبزه‌زار","نه خورش ماندست و نه صبر و قرار","مرغ در قفس به خاطر زیبایی سبزه‌زار بیرون، نه غذای خوشمزه‌ای دارد و نه تحمل و آرامش."],[478,"سر ز هر سوراخ بیرون می‌کند","تا بود کین بند از پا برکند","پرنده از هر سوراخی که بتواند، سرش را بیرون می‌آورد تا اینکه آن بند و زنجیر را از پایش بگسلد."],[478,"چون دل و جانش چنین بیرون بود","آن قفس را در گشایی چون بود","چون دل و جان عاشق به‌این اندازه آزاد و رها شود، در آن صورت قفس (قید و بند) را چگونه باز نخواهد کرد؟"],[478,"نه چنان مرغ قفس در اندهان","گرد بر گردش به حلقه گربگان","عاشق مانند مرغی است که در قفس گرفتار شده و به دور خود می‌چرخد؛ او در درون خود احساس درد و اندوه دارد و به خاطر این محدودیت، به شدت نگران و پریشان است."],[478,"کی بود او را درین خوف و حزن","آرزوی از قفس بیرون شدن","این بیت به این موضوع اشاره دارد که هیچ‌کس در میان ترس و ناراحتی، آرزوی آزادی از قفس را ندارد. به عبارتی، زمانی که کسی احساس ترس و غم دارد، تمایل به رهایی از محدودیت‌ها و مشکلات از او گرفته می‌شود."],[478,"او همی‌خواهد کزین ناخوش حصص","صد قفس باشد بگرد این قفس","او همیشه آرزو دارد که از این قفس‌های ناخوشایند رهایی یابد و در اطراف این قفس‌ها باشد، یعنی به زندگی آزاد و خوشایندی دست یابد."],[479,"آنچنانک گفت جالینوس راد","از هوای این جهان و از مراد","جالینوس، پزشک و فیلسوف مشهور، بر این عقیده است که محبت و عشق به این دنیا و خواسته‌های آن انسان را از حقیقت دور می‌کند و او را به مراد و آرزوهای سطحی می‌کشاند."],[479,"راضیم کز من بماند نیم جان","که ز کون استری بینم جهان","من راضی هستم که تنها نیمه‌جان بمانم تا اینکه از طریق کنه و ماهیت روحی خود، به دنیای مادی نگاه کنم."],[479,"گربه می‌بیند بگرد خود قطار","مرغش آیس گشته بودست از مطار","اگر گربه‌ای را ببینی که دور خودش می‌چرخد، می‌فهمی که پرنده‌اش (مرغش) از ترس فرار کرده و در حال پرواز است."],[479,"یا عدم دیدست غیر این جهان","در عدم نادیده او حشری نهان","این جهان را از دید او چیزی نمی‌بیند جز عدم و آنچه در عدم وجود دارد، حالی پنهان و شگفت دارد."],[479,"چون جنین کش می‌کشد بیرون کرم","می‌گریزد او سپس سوی شکم","زمانی که جنین به دنیا می‌آید، کرم به یک‌باره فرار می‌کند و به سمت شکم مادر می‌رود. این بیت به تغییر وضعیت و هراسی که در فرایند زایمان وجود دارد اشاره دارد."],[479,"لطف رویش سوی مصدر می‌کند","او مقر در پشت مادر می‌کند","محبت و حقایق وجود انسان، او را به سوی منبع اصلی و خداوند هدایت می‌کند، در حالی که او در جای خود و در امن و امان، در پناه مادر قرار دارد."],[479,"که اگر بیرون فتم زین شهر و کام","ای عجب بینم بدیده این مقام","اگر از این شهر و زندگی بیرون بروم، با کمال تعجب می‌بینم که این مقام و حالت را در عالم دیگری مشاهده می‌کنم."],[479,"یا دری بودی در آن شهر وخم","که نظاره کردمی اندر رحم","دری که من در آن شهر می‌دیدم، به صورت خمیده‌ای بود که من در آن، می‌توانستم به درون رحم (رحم به معنای نرم و لطیف) نگاه کنم."],[479,"یا چو چشمه سوزنی راهم بدی","که ز بیرونم رحم دیده شدی","چنان‌که چشمه سوزنی در دل راهی به بیرون پیدا می‌شود، تو هم از درون رحم دیده شدی."],[479,"آن جنین هم غافلست از عالمی","همچو جالینوس او نامحرمی","آن جنین (جنین در حال رشد) نیز از عالمی که مانند جالینوس (پزشک معروف از دوران باستان) بی‌خبر است، ناآگاه است و در واقع به این جهان و استعدادهای آن ناآشنا است."],[479,"اونداند کآن رطوباتی که هست","آن مدد از عالم بیرونی است","رطوبت‌هایی که وجود دارد، از جهان خارجی و بیرون سرچشمه می‌گیرد و به این زندگی کمک می‌کند."],[479,"آنچنانک چار عنصر در جهان","صد مدد آرد ز شهر لامکان","همان‌طور که چهار عنصر (آب، آتش، باد و خاک) در دنیا وجود دارند، صدها نیروی کمک‌دهنده از جهانی فراتر از این جهان (لامکان) به ما می‌رسد."],[479,"آب و دانه در قفس گر یافتست","آن ز باغ و عرصه‌ای درتافتست","اگر در قفس آب و دانه‌ای وجود دارد، این به خاطر است که آن‌ها از باغ و زمینی دیگر به این مکان آورده شده‌اند."],[479,"جانهای انبیا بینند باغ","زین قفس در وقت نقلان و فراغ","جان‌های پیامبران (انبیا) در زمان انتقال و رهایی، باغ را از پس این قفس (دنیا) می‌بینند."],[479,"پس ز جالینوس و عالم فارغند","همچو ماه اندر فلکها بازغند","انبیاء و روحانیون از جالینوس و علم او بی‌نیازند و مانند ماه در آسمان، درخشان و مستقل از دیگران هستند."],[479,"ور ز جالینوس این گفت افتراست","پس جوابم بهر جالینوس نیست","اگر جالینوس (پزشک و فیلسوف بزرگ یونانی) این سخن را گفته باشد، در واقع تهمتی است و من پاسخی برای جالینوس ندارم."],[479,"این جواب آنکس آمد کین بگفت","که نبودستش دل پر نور جفت","این پاسخی است به کسی که این سخن را گفت، زیرا او دل روشنی برای دوست داشتن ندارد و به همین دلیل نمی‌تواند درک درستی از این موضوع داشته باشد."],[479,"مرغ جانش موش شد سوراخ‌جو","چون شنید از گربگان او عرجوا","روح او مانند موشی شده است که به دنبال سوراخ می‌گردد، زیرا از گربه‌ها (گربه‌های گرانقدر و قدرتمند) خبر عرج (نیاز به فرار و پناه بردن) را شنیده است."],[479,"زان سبب جانش وطن دید و قرار","اندرین سوراخ دنیا موش‌وار","به همین خاطر، جانش مثل یک موش در این سوراخ دنیا احساس سکون و آرامش می‌کند و به‌عنوان وطنش می‌بیند."],[479,"هم درین سوراخ بنایی گرفت","درخور سوراخ دانایی گرفت","در این دنیا، جایی که شبیه موش‌ها به زندگی مشغولیم، جایی را برای یادگیری و دانش‌اندوزی انتخاب کرد که مناسب و مرتبط با چنین جایی باشد."],[479,"پیشه‌هایی که مر او را در مزید","کاندرین سوراخ کار آید،گزید","پیشه‌هایی که در این دنیای محدود برای او مفید است، را انتخاب می‌کند."],[479,"زانک دل بر کند از بیرون شدن","بسته شد راه رهیدن از بدن","زیرا دل وقتی از بدن جدا می‌شود، راهی برای رهایی و خروج از آن وجود ندارد."],[479,"عنکبوت ار طبع عنقا داشتی","از لعابی خیمه کی افراشتی","اگر عنکبوت مثل پرنده افسانه‌ای عنقا، استعداد و توانایی داشت، هیچ‌گاه نمی‌توانست از مواد بی‌ارزش مثل تارهای خود، خیمه بسازد."],[479,"گربه کرده چنگ خود اندر قفس","نام چنگش درد و سرسام و مغص","گربه (که نماد مرگ و بیماری است) چنگ‌هایش را در قفس کرده، و این چنگ‌ها به درد، سردرگمی و رنج اشاره دارد."],[479,"گربه مرگست و مرض چنگال او","می‌زند بر مرغ و پر و بال او","مرگ مانند یک گربه است که با چنگال خود به جان انسان آسیب می‌زند و او را در رنج و آسیب قرار می‌دهد."],[479,"گوشه گوشه می‌جهد سوی دوا","مرگ چون قاضیست و رنجوری گوا","مرگ همچون قاضی است و در هر گوشه به دنبال کشف نشانه‌هایی برای ادای داد قرار دارد. رنجوری هم به مانند شاهدی است که به دنبال علاج و درمان است."],[479,"چون پیاده قاضی آمد این گواه","که همی‌خواند ترا تا حکم گاه","وقتی که پیادۀ قاضی به سوی تو می‌آید، این نشان‌دهندۀ آن است که او تو را می‌خواند تا به محضر قاضی بروی و حکمی صادر شود."],[479,"مهلتی می‌خواهی از وی در گریز","گر پذیرد شد و گرنه گفت خیز","می‌خواهی از قاضی مهلتی بگیری تا بتوانی بگریزی؛ اگر قاضی مهلت را بدهد، خوب است و در غیر این صورت باید بروی و حکم را بپذیری."],[479,"جستن مهلت دوا و چاره‌ها","که زنی بر خرقه تن پاره‌ها","دنبال بهانه و فرصتی هستی تا از این درد و مشکلات فرار کنی، اما در حال حاضر تنها در حال وارد کردن آسیب به خودت هستی."],[479,"عاقبت آید صباحی خشم‌وار","چند باشد مهلت آخر شرم دار","سرانجام روزی خشمگین خواهد آمد؛ باید مواظب باشی که وقتی آن روز برسد، فرصت برای عذرخواهی نخواهد بود. پس به خودت شرم کن و قبل از دیر شدن، اقدام کن."],[479,"عذر خود از شه بخواه ای پرحسد","پیش از آنک آنچنان روزی رسد","پیش از آنکه روزی سخت و ناگوار بر تو برسد، از شاه (خدا) بابت حسادت و ندامت خود عذرخواهی کن."],[479,"وانک در ظلمت براند بارگی","برکند زان نور دل یکبارگی","اگر در تاریکی قرار بگیرد و زود از آن بیرون بیاید، می‌تواند یک بار به نور دل دست یابد."],[479,"می‌گریزد از گوا و مقصدش","کان گوا سوی قضا می‌خواندش","او از گواه و مقصدی که دارد فرار می‌کند؛ چون آن گواه، او را به سرنوشت و قضا و قدرش فرا می‌خواند."],[480,"قوم گفتندش مکن جلدی برو","تا نگردد جامه و جانت گرو","قوم به او گفتند که عجله نکن و سریع نرو، زیرا ممکن است جان و لباس تو در خطر بیفتد."],[480,"آن ز دور آسان نماید به نگر","که به آخر سخت باشد ره‌گذر","در ابتدا ممکن است سفر و مشکل به نظر آسان بیاید، اما در انتها، فردی که در مسیر قرار دارد، متوجه می‌شود که این راه بسیار دشوار و پرپیچ‌وخمی است."],[480,"خویشتن آویخت بس مرد و سکست","وقت پیچاپیچ دست‌آویز جست","انسان باید با تلاش و زحمت خود را تشویق کند و در شرایط دشوار به دنبال مسیر و راه‌حل مناسب باشد. در این حالت، تلاش و جستجوی او در شرایط پیچیده و سخت، می‌تواند موجب دستیابی به نتیجه مطلوب شود."],[480,"پیشتر از واقعه آسان بود","در دل مردم خیال نیک و بد","قبل از وقوع حادثه، در دل مردم تصورات خوب و بد به راحتی وجود داشت."],[480,"چون در آید اندرون کارزار","آن زمان گردد بر آنکس کار زار","زمانی که درون انسان درگیر جنگ و جدل و درگیری‌های درونی می‌شود، آن وقت است که آن فرد به خود و کارهایش فشار می‌آورد و در وضعیت دشواری قرار می‌گیرد."],[480,"چون نه شیری هین منه تو پای پیش","کان اجل گرگست و جان تست میش","اگر در برابر مرگ بایستی، نترس و پا پیش نگذار؛ زیرا مرگ مثل گرگ است و جان تو همچون میش آسیب‌پذیر است."],[480,"ور ز ابدالی و میشت شیر شد","آمن آ که مرگ تو سرزیر شد","اگر از ابدال، یعنی افرادی که در راه خدا به کمال رسیده‌اند، شرابی نوشیده باشی که مانند شیر شده، مطمئن باش که مرگ تو نزدیک است و به سراغت خواهد آمد."],[480,"کیست ابدال آنک او مبدل شود","خمرش از تبدیل یزدان خل شود","ابدال به افرادی اطلاق می‌شود که از فضل و مقام خاصی برخوردارند و در این بیت اشاره به کسی است که به واسطه تغییر و تبدیل، از شراب (که نماد حالتی مخصوص است) به مقام بالایی رسیده است که آن مقام را به دست خداوند کسب کرده است. این شخص از حالت ابتدایی خود به ترقی و قدس رسیده است."],[480,"لیک مستی شیرگیری وز گمان","شیر پنداری تو خود را هین مران","اما بیداری از مستی به دست آوردن شکر و نعمت را فراموش نکن و خود را به گمان نوشیدن شیر نسپار."],[480,"گفت حق ز اهل نفاق ناسدید","باسهم ما بینهم باس شدید","خداوند می‌گوید که نسبت به اهل نفاق (دوست‌نماها) باید حذر کرد، زیرا سهم و بخشش آن‌ها از یکدیگر به شدت بی‌اعتبار و ناپایدار است."],[480,"در میان همدگر مردانه‌اند","در غزا چون عورتان خانه‌اند","در میان یکدیگر، مردانه و شجاعانه عمل می‌کنند، اما در میدان جنگ مانند زنانی هستند که در خانه پنهان شده‌اند و جرات نمی‌کنند."],[480,"گفت پیغامبر سپهدار غیوب","لا شجاعة یا فتی قبل الحروب","پیامبر (در اینجا اشاره به محمد، پیامبر اسلام) به سربازان گفته است که قبل از جنگ، شجاعت واقعی را در قلب خود پیدا کنید و به خود اطمینان داشته باشید. این بیان کنایه‌ای است از اینکه شجاعت باید از درون انسان بیاید و فقط به ظاهر و ظواهر جنگ خلاصه نمی‌شود."],[480,"وقت لاف غزو مستان کف کنند","وقت جوش جنگ چون کف بی‌فنند","در زمان صحبت و brag کردن درباره جنگ، مستان (مستهتران) به لاف زدن می‌پردازند و در وقت بروز جنگ، همانند کف که بدون مهارت و توانی به سرعت از بین می‌رود، ناتوان و بی‌سلاح می‌شوند."],[480,"وقت ذکر غزو شمشیرش دراز","وقت کر و فر تیغش چون پیاز","در زمان ذکر جنگ، شمشیر او بسیار بلند و بزرگ می‌شود، اما در زمان ترس و وحشت، تیغ او مانند پیاز نرم و بی‌خاصیت است."],[480,"وقت اندیشه دل او زخم‌جو","پس به یک سوزن تهی شد خیک او","زمانی که دل او به زخمی فکر می‌کند، پس از آن با یک سوزن، خیک او (کیسه یا ظرف او) خالی می‌شود."],[480,"من عجب دارم ز جویای صفا","کو رمد در وقت صیقل از جفا","من تعجب می‌کنم از کسی که به دنبال صفای باطن است، در حالی‌که در زمان نیاز به پالایش و پاک‌سازی، هنوز به زخم و جفا تکیه می‌کند."],[480,"عشق چون دعوی جفا دیدن گواه","چون گواهت نیست شد دعوی تباه","عشق وقتی که ادعا کند که آزار دیده است، گواهی برای آن وجود ندارد و به همین دلیل ادعای آن بی‌اعتبار می‌شود."],[480,"چون گواهت خواهد این قاضی مرنج","بوسه ده بر مار تا یابی تو گنج","اگر قاضی (عشق) از تو خواسته که گواهی بدهی و تو نگران نباشی، پس باید بر مار (مشکلات و دردسرها) بوسی بدهی تا در نهایت به گنج (حقایق ارزشمند) دست یابی."],[480,"آن جفا با تو نباشد ای پسر","بلک با وصف بدی اندر تو در","این پلیدی که به تو نسبت داده می‌شود، نسبت به خودت است و نه نسبت به من، ای فرزند."],[480,"بر نمد چوبی که آن را مرد زد","بر نمد آن را نزد بر گرد زد","مردی بر نمد (پارچه‌ای پشمی) چوبی زده است، یعنی بر آن نمد ضربه‌ای زده، و صدا یا برآمدگی (بر اثر ضربه) در نمد ایجاد کرده است."],[480,"گر بزد مر اسپ را آن کینه کش","آن نزد بر اسپ زد بر سکسکش","اگر آن کینه‌کش به سم اسب ضربه بزند، سم آن اسب به زمین خواهد خورد و صدای سکسک در می‌آورد."],[480,"تا ز سکسک وارهد خوش‌پی شود","شیره را زندان کنی تا می‌ شود","برای اینکه از زحمت و دشواری‌های زندگی خلاص شود، باید با سادگی و راحتی به خوشان بپردازد و در این حال، دچار وابستگی به مایه‌های حیات و لذت‌های زودگذر نشود."],[480,"گفت چندان آن یتیمک را زدی","چون نترسیدی ز قهر ایزدی","چقدر به آن یتیم ظلم کردی و او را زدی، چطور از عذاب و غضب خدا نترسیدی؟"],[480,"گفت او را کی زدم ای جان و دوست","من بر آن دیوی زدم کو اندروست","مولانا با این بیت می‌گوید که من هرگز آن یتیم را نواختم، بلکه من به آن دیو (دروغ و زشتی) زدم که در وجود اوست. در حقیقت، من به خود یتیم آسیبی نزدم، بلکه به ریشه بدی در وجودش حمله کردم."],[480,"مادر ار گوید ترا مرگ تو باد","مرگ آن خو خواهد و مرگ فساد","اگر مادر به تو بگوید که مرگ تو بهتر است، او به مرگ خوبی و نابودی بدی رضایت می‌دهد."],[480,"آن گروهی کز ادب بگریختند","آب مردی و آب مردان ریختند","گروهی که از ادب و فرهنگ فاصله گرفتند، در واقع ارزش‌های انسانی و مردانگی خود را از دست دادند و به ورطه‌ی سقوط رفتند."],[480,"عاذلانشان از وغا واراندند","تا چنین حیز و مخنث ماندند","عذرخواهی‌کنندگانشان (عاذلان) از دعوا و جنگ دوری کردند، تا جایی که به ضجرت و ناتوانی (حیز و مخنث) رسیدند."],[480,"لاف و غره ژاژخا را کم شنو","با چنینها در صف هیجا مرو","به خودت مغرور و فریب‌خورده نباش و به حرف‌های بی‌ارزش این‌گونه افراد توجه نکن. در جمع آن‌ها نباش و از آن‌ها دوری کن."],[480,"زانک زادوکم خبالا گفت حق","کز رفاق سست برگردان ورق","زیرا خداوند به زاد و ولد (فرزندان) شما می‌گوید که از رفاقت سست (دوستی‌های ضعیف) دوری کنید و ورق زندگی‌تان را عقب نزنید."],[480,"که گر ایشان با شما همره شوند","غازیان بی‌مغز همچون که شوند","اگر این افراد با شما همراه شوند، مانند جنگجویان بی‌فکر و نادان خواهند شد و هیچ سودی از این همراهی نخواهید برد."],[480,"خویشتن را با شما هم‌صف کنند","پس گریزند و دل صف بشکنند","اگر آنها خود را با شما هم‌ردیف و هم‌دست نشان دهند، بعد از آن فرار می‌کنند و دل گروه را می‌شکنند."],[480,"پس سپاهی اندکی بی این نفر","به که با اهل نفاق آید حشر","بهتر است که گروهی اندک و با ایمان، با هم باشند تا اینکه با افرادی نفاق‌کار و دو رو گرد هم آیند."],[480,"هست بادام کم خوش بیخته","به ز بسیاری به تلخ آمیخته","بادام، زمانی که کم باشد، خوشمزه است و اگر تعدادش زیاد شود، طعم تلخی به خود می‌گیرد؛ یعنی ارزش و خوشمزگی چیزها گاهی به کمی و ندرت آن‌ها بستگی دارد."],[480,"تلخ و شیرین در ژغاژغ یک شی‌اند","نقص از آن افتاد که همدل نیند","تلخی و شیرینی در یک واقعیت یا موضوع واحد وجود دارد و این نشان‌دهنده‌ی نقصی است که به خاطر این که همدلی و یکدلی وجود ندارد، به وجود آمده است."],[480,"گبر ترسان دل بود کو از گمان","می‌زید در شک ز حال آن جهان","کسی که دلش ترسیده و بی‌اطمینان است، به خاطر شک و گمان‌هایی که دارد، از حقیقت آن جهان (جهان پس از مرگ) در تردید است و نمی‌داند چه اتفاقاتی برای او خواهد افتاد."],[480,"می‌رود در ره نداند منزلی","گام ترسان می‌نهد اعمی دلی","شخصی در راهی می‌رود که مشخص نیست مقصدش کجاست و با دل نگرانی و احتیاط قدم برمی‌دارد. در واقع، او مانند کسی است که نمی‌بیند و در تردید به سر می‌برد."],[480,"چون نداند ره مسافر چون رود","با ترددها و دل پرخون رود","وقتی مسافر راه را نمی‌شناسد، به شیوه‌ای نامطمئن و با دل پر از نگرانی و درد قدم برمی‌دارد و از مشکلات و ترددهای مختلف عبور می‌کند."],[480,"هرکه گوید، های این‌سو راه نیست","او کند از بیم آنجا وقف و ایست","هر کس بگوید که این‌جا راهی وجود ندارد، به خاطر ترس از آنجا متوقف می‌شود و نمی‌تواند به مسیر خود ادامه دهد."],[480,"ور بداند ره دل با هوش او","کی رود هر های و هو در گوش او","اگر کسی بداند که راه دل نیکو و باهوش کجاست، در آن صورت به هر صدای ناهنجار که به گوشش می‌رسد، توجه نمی‌کند."],[480,"پس مشو همراه این اشتردلان","زانک وقت ضیق و بیمند آفلان","بنابراین، با انسان‌های نادان و بی‌فکر همراه نشو، زیرا در زمان نیاز و تنگدستی، از تو دور می‌شوند و تو را تنها می‌گذارند."],[480,"پس گریزند و ترا تنها هلند","گرچه اندر لاف سحر بابلند","پس (اهالی آنها) فرار می‌کنند و تو را تنها می‌گذارند، هرچند در این فریب و لاف‌های بی‌اساس مانند سحر ساکت و بابل (شهر باستانی) به نظر می‌آیند."],[480,"تو ز رعنایان مجو هین کارزار","تو ز طاوسان مجو صید و شکار","تو در میدان جنگ به دنبال زیبا رویان نرو و از طاوس‌ها (در اینجا استعاره از کسانی که به زیبایی و آراستگی می‌بالند) هم پی شکار نرو."],[480,"طبع طاوسست و وسواست کند","دم زند تا از مقامت برکند","طبع تو مانند طاوس است و وسواس دارد، که دائم در فکر آن است تا تو را از مرتبت و مقام خودت پایین بیاورد."],[481,"همچو شیطان در سپه شد صد یکم","خواند افسون که اننی جار لکم","شیطان مانند یک فرمانده در ارتش قریش ظاهر شد و به آن‌ها وعده داد که کمک‌هایی به آن‌ها می‌کند و با زبانی فریبنده به آن‌ها گفت: من برای شما آماده‌ام."],[481,"چون قریش از گفت او حاضر شدند","هر دو لشکر در ملاقات آمدند","وقتی قریش به حرف‌های شیطان گوش دادند و آمادگی لازم را پیدا کردند، هر دو طرف ارتش برای دیدار و رویارویی آماده شدند."],[481,"دید شیطان از ملایک اسپهی","سوی صف مؤمنان اندر رهی","شیطان متوجه شد که گروهی از فرشتگان (ملایک) به سوی صف مؤمنان در راه‌اند."],[481,"آن جنودا لم تروها صف زده","گشت جان او ز بیم آتشکده","آن لشکرهایی که شما نمی‌بینید، صف بسته‌اند و جان شیطان از ترس آتشکده، در حال ناراحتی است."],[481,"پای خود وا پس کشیده می‌گرفت","که همی‌بینم سپاهی من شگفت","او به عقب برمی‌گردد و به پاهای خود نگاه می‌کند، زیرا متوجه می‌شود که سپاهش بسیار عجیب و غیرقابل تصور است."],[481,"ای اخاف الله ما لی منه عون","اذهبوا انی اری ما لاترون","ای بیم دارم از خدا، هیچ یاری از او ندارم. بروید، زیرا من چیزهایی می‌بینم که شما نمی‌بینید."],[481,"گفت حارث ای سراقه شکل هین","دی چرا تو می‌نگفتی اینچنین","شیطان به حارث (که سراقه نام دارد) می‌گوید: چرا تو این‌قدر ترسیده‌ای و به‌جای بیان حقیقت، فقط این طور به خودت می‌بالیدی که در این موقعیت قرار نداشتی؟"],[481,"گفت این دم من همی‌بینم حرب","گفت می‌بینی جعاشیش عرب","شیطان به قریش می‌گوید که در این لحظه من وضعیت جنگ را می‌بینم و به شما می‌گوید که دارید به کجای جنگ می‌روید."],[481,"می‌نبینی غیر این لیک ای تو ننگ","آن زمان لاف بود این وقت جنگ","تو تنها این موضوع را نمی‌بینی، ای کس، اینکه در آن زمان بزرگ‌منشی ات حرفی پوچ بود، اما در این موقعیت جنگ، خود را نشان می‌دهد."],[481,"دی همی‌گفتی که پایندان شدم","که بودتان فتح و نصرت دم‌بدم","دیگر می‌گفتی که من به پیروزی و نصرت رسیده‌ام و زمانی که به جنگ می‌رسد، همواره در حال حمایت از شما هستم."],[481,"دی زعیم الجیش بودی ای لعین","وین زمان نامرد و ناچیز و مهین","دیگر تو سرکرده گروه رذل‌ها و پلیدان بودی، اما اکنون به شخصی پست و بی‌ارزش تبدیل شده‌ای."],[481,"تا بخوردیم آن دم تو و آمدیم","تو بتون رفتی و ما هیزم شدیم","این بیت به این معناست که وقتی ما به تو نیاز داشتیم و به سوی تو آمدیم، تو ما را رها کردی و رفتی، و حالا ما به مشکل افتاده‌ایم و بی‌پناه مانده‌ایم."],[481,"چونک حارث با سراقه گفت این","از عتابش خشمگین شد آن لعین","چون حارث به سراقه گفت، این شیطان خشمگین شد به خاطر سرزنش و سخنان او."],[481,"دست خود خشمین ز دست او کشید","چون ز گفت اوش درد دل رسید","حارث از خشم خود دست کشید و بر اثر سخنان شیطان که دلش را آزار داد، با دل‌دردی مواجه شد."],[481,"سینه‌اش را کوفت شیطان و گریخت","خون آن بیچارگان زین مکر ریخت","شیطان به دل این بیچاره‌ها ضربه می‌زند و آنها را به وحشت می‌اندازد، و به خاطر این فریب، خون آنان بر زمین می‌ریزد."],[481,"چونک ویران کرد چندین عالم او","پس بگفت انّی بری منکم","زمانی که شیطان بسیاری از جهان‌ها را ویران کرد، گفت که من از شما بری هستم و به شما هیچ ارتباطی ندارم."],[481,"کوفت اندر سینه‌اش انداختش","پس گریزان شد چو هیبت تاختش","شیطان به قریش می‌گوید که چقدر ترسیده و تحت فشار است، او به سینه‌اش زخم و ضربه‌ای می‌زند و سپس هنگامی که هیبت و قدرت پیامبر (احمد) بر او طغیان می‌کند، فرار می‌کند."],[481,"نفس و شیطان هر دو یک تن بوده‌اند","در دو صورت خویش را بنموده‌اند","نفس و شیطان در واقع یکی هستند، اما خود را به دو شکل متفاوت نمایش می‌دهند."],[481,"چون فرشته و عقل کایشان یک بدند","بهر حکمتهاش دو صورت شدند","فرشته و عقل یک ذات و یک حقیقت هستند، اما برای حکمت‌های مختلف، به دو شکل متفاوت ظاهر شده‌اند."],[481,"دشمنی داری چنین در سر خویش","مانع عقلست و خصم جان و کیش","دشمنی که در دل داری، باعث می‌شود عقل تو از کار بیفتد و جان و ایمان تو را دشمنی کند."],[481,"یکنفس حمله کند چون سوسمار","پس بسوراخی گریزد در فرار","اگر کسی به او حمله کند، به طور ناگهانی مانند سوسماری که بلافاصله از سوراخی فرار می‌کند، می‌گریزد."],[481,"در دل او سوراخها دارد کنون","سر ز هر سوراخ می‌آرد برون","در دل انسان، نقاط ضعف و خلل وجود دارد که در مواقع خاص خود را نشان می‌دهد و از این نقاط ضعف، مشکلات و افکار شوم و منفی بیرون می‌آید."],[481,"نام پنهان گشتن دیو از نفوس","واندر آن سوراخ رفتن شد خنوس","وقتی دیو در دل آدمی پنهان می‌شود و خود را مخفی می‌کند، به مانند سوسک کوچکی است که در سوراخی پنهان شده و به درون آن می‌رود."],[481,"که خنوسش چون خنوس قنفذست","چون سر قنفذ ورا آمد شذست","خنوس، که به معنی خنک و آرام است، به مانند خزیدن و پنهان‌شدن قنفذ (خارپشت) است. به این معنا که آن دیو نیز مانند قنفذ در حالتی پنهان و در غیاب حضور دارد."],[481,"که خدا آن دیو را خناس خواند","کو سر آن خارپشتک را بماند","خدا، آن موجود شیطانی را که در دل انسان وسوسه ایجاد می‌کند، به نام خناس معرفی کرده است، مانند سر خارپشت که در مواقع خطر، خود را پنهان می‌کند."],[481,"می نهان گردد سر آن خارپشت","دم‌بدم از بیم صیاد درشت","سر خارپشت به طور مداوم از ترس شکارچی بزرگ پنهان می‌شود."],[481,"تا چو فرصت یافت سر آرد برون","زین چنین مکری شود مارش زبون","زمانی که فرصت به دست آورد، سر خود را بیرون می‌آورد. در چنین حالتی، او به مکر و فریب تبدیل می‌شود و به موجودی ضعیف و بی‌دفاع می‌ماند."],[481,"گرنه نفس از اندرون راهت زدی","ره‌زنان را بر تو دستی کی بدی","اگر نفس درونت باعث نشود که در مسیر زندگی‌ات دچار انحراف شوی، قطعا دزدان (یعنی کسانی که به تو ضرر می‌زنند) نمی‌توانند به تو آسیبی برسانند."],[481,"زان عوان مقتضی که شهوتست","دل اسیر حرص و آز و آفتست","چون انسان تحت تأثیر شهوت و تمایلات گوناگون قرار می‌گیرد، دل او به حرص و آز گرفتار شده و در نتیجه به مصیبت و آسیب دچار می‌شود."],[481,"زان عوان سر شدی دزد و تباه","تا عوانان را به قهر تست راه","در آن زمان، تو دزد و خرابکار شدی، زیرا عوانان (گروهی که دستور می‌دهند) را با قهر و خشم خودت می‌کشی و به طرف آن‌ها راهی داری."],[481,"در خبر بشنو تو این پند نکو","بیم جنبیکم لکم اعدی عدو","این پند نیک را بشنو که در خبرها آمده است: من به شما می‌گویم که دشمنی بزرگتر از من برای شما نیست."],[481,"طمطراق این عدو مشنو گریز","کو چو ابلیسست در لج و ستیز","این دشمن را با طمطراق و جلوه‌گری‌اش نشنو و از او فرار نکن، زیرا او همچون ابلیس در لجاجت و جنگیدن است."],[481,"بر تو او از بهر دنیا و نبرد","آن عذاب سرمدی را سهل کرد","شیطان برای تو، به خاطر دنیای فانی و جنگ، عذاب ابدی را آسان جلوه می‌دهد."],[481,"چه عجب گر مرگ را آسان کند","او ز سحر خویش صد چندان کند","عجب نیست اگر او (شیطان) مرگ را با سحر خود آسان کند و این کار را چندین برابر جلوه دهد."],[481,"سحر کاهی را به صنعت که کند","باز کوهی را چو کاهی می‌تند","شیطنت و فریبکاری نمی‌تواند ضعف‌ها را به قوت تبدیل کند؛ در حقیقت، هر چیز کوچک و بی‌ارزش مانند کاه را نمی‌تواند به چیزی بزرگ و محکم مانند کوه تغییر دهد."],[481,"زشتها را نغز گرداند به فن","نغزها را زشت گرداند به ظن","زشت‌ها را با هنر و مهارت به چیزی زیبا تبدیل می‌کند، در حالی که زیبایی‌ها را به واسطه‌ی گمان و خیال، زشت می‌سازد."],[481,"کار سحر اینست کو دم می‌زند","هر نفس قلب حقایق می‌کند","سحر به گونه‌ای عمل می‌کند که در هر لحظه بر گفتار و رفتار انسان تأثیر می‌گذارد و باعث می‌شود که قلب او به حقایق و واقعیات معنوی متوجه شود."],[481,"آدمی را خر نماید ساعتی","آدمی سازد خری را وآیتی","انسان می‌تواند در یک لحظه به مانند خر رفتار کند و در لحظه‌ای دیگر، موجودی انسانی باشد، و این خود نشانه‌ای از تنوع و تحول در وجود اوست."],[481,"این چنین ساحر درون تست و سر","ان فی الوسواس سحرا مستتر","اینطور ساحر درون تو وجود دارد و در سر هر وسوسه، جادوی نهفته‌ای است."],[481,"اندر آن عالم که هست این سحرها","ساحران هستند جادویی‌گشا","در جهانی که اینگونه سحر و جادو وجود دارد، کسانی هستند که هنرمندانه و با استعداد به جادوگری و سحر مشغولند."],[481,"اندر آن صحرا که رست این زهر تر","نیز روییدست تریاق ای پسر","در آن بیابان که این زهر کشنده رشد کرده، پسرم، تریاق (داروی ضد زهر) نیز وجود دارد."],[481,"گویدت تریاق از من جو سپر","که ز زهرم من به تو نزدیکتر","شیطان به تو می‌گوید که برای حفاظت به تریاق (پادزهر) من نیاز داری، در حالی که من خودم از زهر به تو نزدیک‌تر هستم و می‌توانم به تو آسیب برسانم."],[481,"گفت او سحرست و ویرانی تو","گفت من سحرست و دفع سحر او","او (شیطان) گفت که سحر و افسون من سبب ویرانی توست، و من (پیامبر) پاسخ داد که من نیز سحر دارم و می‌توانم سحر تو را دفع کنم."],[482,"گفت پیغامبر که ان فی البیان","سحرا و حق گفت آن خوش پهلوان","پیامبر فرمود که در بیان و صحبت، جادو و سحر وجود دارد و حق هم این را گفت که آن کسی که می‌تواند خوب سخن بگوید، قهرمان واقعی است."],[482,"هین مکن جلدی برو ای بوالکرم","مسجد و ما را مکن زین متهم","ای بوالکرم (نام یکی از شخصیت‌ها)، عجله نکن و به مسجد برو، و ما را به این اتهام متهم نکن."],[482,"که بگوید دشمنی از دشمنی","آتشی در ما زند فردا دنی","اگر کسی به ما از جانب دشمنانش داستانی بگوید و بذر کینه‌ای در دل ما بکارد، فردا در دنیا عذاب و ناراحتی به بار خواهد آورد."],[482,"که بتاسانید او را ظالمی","بر بهانه مسجد او بد سالمی","ظالمی می‌خواهد او را تحت فشار قرار دهد و به او بگوید که به خاطر مسجد او، او دلی پاک و سالم ندارد."],[482,"تا بهانه قتل بر مسجد نهد","چونک بدنامست مسجد او جهد","اگر کسی بهانه‌ای برای قتل در مسجد بیاورد، به این دلیل است که مسجد او بدنام شده است و تلاش می‌کند این بدنامی را به دوش مسجد بگذارد."],[482,"تهمتی بر ما منه ای سخت‌جان","که نه‌ایم آمن ز مکر دشمنان","ای انسانی استوار، به ما اتهام نزن، زیرا ما از فریب و مکر دشمنان در امان نیستیم و نمی‌توانیم از آن‌ها محافظت کنیم."],[482,"هین برو جلدی مکن سودا مپز","که نتان پیمود کیوان را بگز","ای مهمان، فورا برو و در کارها تعلل نکن، زیرا نمی‌توانی به راحتی به کیوان (سیاره زهره) برسید."],[482,"چون تو بسیاران بلافیده ز بخت","ریش خود بر کنده یک یک لخت لخت","تو که در اینجا به خاطر بخت بد خود، سر خود را موی موی می‌کنی و ریشت را می‌کنی، یعنی به درد و مصیبت خود خیلی توجه می‌کنی و به آن دچار شده‌ای."],[482,"هین برو کوتاه کن این قیل و قال","خویش و ما را در میفکن در وبال","زود باش و صحبت‌های بی‌فایده‌ات را قطع کن و ما را در دردسر نینداز."],[483,"گفت ای یاران از آن دیوان نیم","که ز لا حولی ضعیف آید پیم","مولانا به دوستانش می‌گوید که از آن دیوان (دیوانگی، جنون یا خردی که در حالت ضعف مشاهده می‌شود) نیست که به واسطه‌ی ناتوانی و ضعیفی که دارد، پیم (عهد و پیمان) ببندد. به عبارت دیگر، او در وضعیت ضعف و ناتوانی قرار ندارد که بر اساس آن عمل کند."],[483,"کودکی کو حارس کشتی بدی","طبلکی در دفع مرغان می‌زدی","کودکی که نگهبان کشتزار بود، طبلکی برای ترساندن پرندگان می‌زد تا آن‌ها را از کشت دور کند."],[483,"تا رمیدی مرغ زان طبلک ز کشت","کشت از مرغان بد بی خوف گشت","مرغ به خاطر صدای طبلک از کشت فراری شد و بدون ترس از مرغ‌ها، در کشت باقی ماند."],[483,"چونک سلطان شاه محمود کریم","برگذر زد آن طرف خیمه عظیم","سلطان شاه محمود کریم با مهربانی و شکوه، بر روی گذر و در طرف دیگر خیمه بزرگ ایستاده بود."],[483,"با سپاهی همچو استاره اثیر","انبه و پیروز و صفدر ملک‌گیر","با سپاهی که مانند چوب‌های محکم و قوی است، که پیروزی و قدرت را به دست می‌آورند."],[483,"اشتری بد کو بدی حمال کوس","بختیی بد پیش‌رو همچون خروس","او مغز و ذات اشتری را که بارکش است و بخت خوبی ندارد، به بدی توصیف می‌کند و او را به خروسی تشبیه می‌کند که در جلو می‌نشیند. این اشاره به کسی است که در موقعیتی نامناسب و ضعیف قرار دارد و در عین حال به زور خود را جلو می‌اندازد."],[483,"بانگ کوس و طبل بر وی روز و شب","می‌زدی اندر رجوع و در طلب","هر روز و شب صدای کوس و طبل را بر او می‌زدی تا به راه بازگردد و به دنبال چیزی بگردد."],[483,"اندر آن مزرع در آمد آن شتر","کودک آن طبلک بزد در حفظ بر","در آن زمین، شتری که هنوز جوان و ناتوان بود، به صدای طبل به احتیاط نزدیک شد و از خود محافظت می‌کرد."],[483,"عاقلی گفتش مزن طبلک که او","پخته طبلست با آنشست خو","عاقلی به آن شخص می‌گوید که طبل را نزن، زیرا او (شتر) پخته و دارای تجربه است و با صدای طبل نمی‌توان او را ترساند یا از کار بازداشت."],[483,"پیش او چه بود تبوراک تو طفل","که کشد او طبل سلطان بیست کفل","چه چیزی به او می‌گوید که تو مانند کودکی هستی که قادر نیست طبل پادشاهی را بر دوش خود بگذارد."],[483,"عاشقم من کشته قربان لا","جان من نوبتگه طبل بلا","من عاشق کسی هستم که قربانی عشق شده و جان من در این لحظه سخت، نواختن طبل بلا را می‌زند."],[483,"خود تبوراکست این تهدیدها","پیش آنچ دیده است این دیدها","این تهدیدها برای تو به خاطر آن چیزهایی است که دیده‌ای و تجربیاتت را نشان می‌دهد. در واقع، تو اهل تحمل و بروز این تهدیدها هستی."],[483,"ای حریفان من از آنها نیستم","کز خیالاتی درین ره بیستم","ای دوستان، من از گروهی نیستم که به خاطر آرزوها و خیالات در این مسیر وقفه ایجاد کنم."],[483,"من چو اسماعیلیانم بی‌حذر","بل چو اسمعیل آزادم ز سر","من مانند اسماعیلیان هستم که بی‌پروا و بی‌خطرند، اما همانند اسماعیل، آزاد هستم و از خودم جدا نمی‌شوم."],[483,"فارغم از طمطراق و از ریا","قل تعالوا گفت جانم را بیا","از بزرگی و تظاهر دست بردارید و بیایید به من بپیوندید."],[483,"گفت پیغامبر که جاد فی السلف","بالعطیه من تیقن بالخلف","پیامبر گفت که هرکس در گذشته با هدیه‌ای به دیگران کمک کرده باشد، به طور یقین در آینده هم از جبران آن برخوردار خواهد شد."],[483,"هر که بیند مر عطا را صد عوض","زود دربازد عطا را زین غرض","هر کس که به عطایی نگاه کند، به سرعت از زبان خود بیدل و بی‌دریغ عطا می‌کند، چرا که او به هدفی از بخشش می‌اندیشد."],[483,"جمله در بازار از آن گشتند بند","تا چو سود افتاد مال خود دهند","همه در بازار به هم پیوستند و به صف شدند تا وقتی که سودی به دست آید، اموال خود را تقدیم کنند."],[483,"زر در انبانها نشسته منتظر","تا که سود آید ببذل آید مصر","طلاها در انبارها نشسته‌اند و منتظر هستند تا زمانی که سودی حاصل شود، بعد خود را به بازار عرضه کنند."],[483,"چون ببیند کاله‌ای در ربح بیش","سرد گردد عشقش از کالای خویش","وقتی که شخصی ببیند کالایی که دارد، نسبت به دیگر کالاها ارزش بیشتری دارد، عشق و علاقه‌اش به آن کالا کاهش می‌یابد."],[483,"گرم زان ماندست با آن کو ندید","کاله‌های خویش را ربح و مزید","کسی که در عشق و محبت به چیزی یا کسی مداومت دارد، از آنجا که از کالای خود را که به روان‌شناسی و عواطف او بستگی دارد، دور است و نمی‌تواند بر آنچه از دست داده است، بی‌تفاوت بماند."],[483,"همچنین علم و هنرها و حرف","چون بدید افزون از آنها در شرف","وقتی کسی علم و هنرها و حرفه‌ها را می‌بیند که به اندازه‌ای بیشتر از آن‌ها در حال پیشرفت است، احساس می‌کند که همه چیز در حال ترقی و گسترش است."],[483,"تا به از جان نیست جان باشد عزیز","چون به آمد نام جان شد چیز لیز","چون جان انسان ارزشمندتر از آن است که تنها وجود داشته باشد، وقتی که نام و خاطره‌ای از آن می‌ماند، آن وجود به شکل چیزی لغزنده و بی‌ثبات درمی‌آید."],[483,"لعبت مرده بود جان طفل را","تا نگشت او در بزرگی طفل‌زا","روح و وجود کودک در ابتدا بی‌خبر و مرده بود؛ اما پس از آنکه او بزرگ شد و به سن بچه‌دار شدن رسید، جان و زندگی به او داده شد."],[483,"این تصور وین تخیل لعبتست","تا تو طفلی پس بدانت حاجتست","این تصور و تخیّل که اکنون داری، مانند خیال بازیگوشی است؛ چون هنوز در مرحله کودکی و ناتوانی، به آن نیاز داری."],[483,"چون ز طفلی رست جان شد در وصال","فارغ از حس است و تصویر و خیال","زمانی که انسان از دوران کودکی فارغ می‌شود و به مرحله‌ای از وصال می‌رسد، روح او از احساسات، تصورات و خیالات آزاد می‌شود."],[483,"نیست محرم تا بگویم بی‌نفاق","تن زدم والله اعلم بالوفاق","هیچ‌کس در اینجا نیست که بتوانم بی‌پرده در مورد خودم بگویم. من از نفاق و دورویی فاصله گرفته‌ام و تنها خداوند داند که من در صمیمیت و وفاداری هستم."],[483,"مال و تن برف‌اند ریزان فنا","حق خریدارش که الله اشتری","مال و بدن همچون برف‌هایی هستند که به سرعت در حال ذوب شدن و فنا هستند. خریدار این مال و بدن، تنها کسی است که خداوند است، چون او می‌فهمد که در نهایت همه چیز گذراست."],[483,"برفها زان از ثمن اولیستت","که هیی در شک یقینی نیستت","برف‌ها از آن است که قیمت اولی تو را مشخص کرده است، زیرا در حال حاضر هیچ شکی در حقیقت تو وجود ندارد."],[483,"وین عجب ظنست در تو ای مهین","که نمی‌پرد به بستان یقین","ای انسان بزرگ، این شگفتی است که در وجود تو وجود دارد، چرا که تو به باغ یقین پرواز نمی‌کنی و به آن نمی‌رسی."],[483,"هر گمان تشنه یقینست ای پسر","می‌زند اندر تزاید بال و پر","هر گمانی که انسان دارد، حاکی از عطش او برای رسیدن به یقین و حقیقت است، و این گمان‌ها باعث می‌شود که آرزوهای او رشد و پرواز کنند."],[483,"چون رسد در علم پس پر پا شود","مر یقین را علم او بویا شود","وقتی علم به جایی برسد، پایه‌گذار یقین می‌شود و در این حالت، یقین درک می‌شود و به وضوح آشکار می‌گردد."],[483,"زانک هست اندر طریق مفتتن","علم کمتر از یقین و فوق ظن","در این بیت گفته شده که در مسیر رشد و شناخت، علم کمتر از یقین و بالاتر از گمان است؛ به این معنا که علم به تنهایی نمی‌تواند به اندازه یقین معتبر و محکم باشد."],[483,"علم جویای یقین باشد بدان","و آن یقین جویای دیدست و عیان","علم به دنبال یقین است و یقین نیز خواهان مشاهده و درک واقعی است."],[483,"اندر الهیکم بجو این را کنون","از پس کلا پس لو تعلمون","شما اکنون درگیر امور دنیوی هستید، اما باید به فکر آنچه در پس پرده‌ها و اسرار هستید باشید؛ اگر می‌دانستید چه چیزی بر شما نازل خواهد شد، به طور قطع به این امور دنیوی توجه نمی‌کردید."],[483,"می‌کشد دانش ببینش ای علیم","گر یقین گشتی ببینندی جحیم","اگر از علم و دانش درست استفاده کنی، می‌توانی عاقبت کار را ببینی؛ پس ای عالم، اگر به یقین برسی، عذاب جهنم را خواهی دید."],[483,"دید زاید از یقین بی امتهال","آنچنانک از ظن می‌زاید خیال","یقین بدون هیچ تردیدی به وجود می‌آید و به سرعت شکل می‌گیرد، مانند آنچه از ظن و گمان به وجود می‌آید که فقط خیالی است."],[483,"اندر الهیکم بیان این ببین","که شود علم الیقین عین الیقین","در اینجا اشاره شده است که اگر واقعیت‌ها به روشنی بیان شوند، آن‌گاه علم درست و یقین به واقعیت، برابر با دیدن عینی آن واقعیت خواهد بود. یعنی دانایی و شناختی که بر اساس شواهد قوی شکل می‌گیرد، به همان اندازه معتبر و قابل اعتماد است که تجربه مستقیم."],[483,"از گمان و از یقین بالاترم","وز ملامت بر نمی‌گردد سرم","من بالاتر از حد گمان و یقین هستم و به خاطر ملامت دیگران، سرم پایین نمی‌آید و دلسرد نمی‌شوم."],[483,"چون دهانم خورد از حلوای او","چشم‌روشن گشتم و بینای او","پس از خوردن حلوای آن مهمان، چشمانم روشن شد و بینایی‌ام افزون گردید."],[483,"پا نهم گستاخ چون خانه روم","پا نلرزانم نه کورانه روم","من وقتی به خانه می‌روم، با اعتماد به نفس و بدون تردید وارد می‌شوم و مانند کسی که نمی‌داند کجا می‌رود، عمل نمی‌کنم."],[483,"آنچ گل را گفت حق خندانش کرد","با دل من گفت و صد چندانش کرد","گل به من گفت که خداوند او را خندان کرده است و این گفت و گوی دلنشین و زیبا بر دل من تأثیر بیشتری گذاشت."],[483,"آنچ زد بر سرو و قدش راست کرد","و آنچ از وی نرگس و نسرین بخورد","خداوند با لطافت و مهربانی، قامت او را راست و زیبا کرد و از او گل‌های نرگس و نسرین را به وجود آورد."],[483,"آنچ نی را کرد شیرین جان و دل","و آنچ خاکی یافت ازو نقش چگل","آنچه نی را به صوت شیرین تبدیل کرد، جان و دل را به وجد می‌آورد و آنچه از خاک به دست آمده، نقش زیبا و دلربا را پدید می‌آورد."],[483,"آنچ ابرو را چنان طرار ساخت","چهره را گلگونه و گلنار ساخت","آن ابرو را به‌گونه‌ای زیبا و هوس‌انگیز آرایش کرد که چهره را شبیه گل و رنگارنگ مانند انار ساخت."],[483,"مر زبان را داد صد افسون‌گری","وانک کان را داد زر جعفری","زبان را قدرت و توانایی بخشید تا به زیبایی و فریبندگی صحبت کند، زیرا که کان (گنجینه) را همچنین طلا و زیورآلاتی مثل زر جعفری (طلا با رنگ زرد متمایز) عطا کرده است."],[483,"چون در زرادخانه باز شد","غمزه‌های چشم تیرانداز شد","زمانی که در زرادخانه (محل نگهداری سلاح) در باز شد، غمزه‌های (نگاه‌های فریبنده) چشم تیرانداز (کسی که تیر می‌اندازد) به هدف قرار گرفت."],[483,"بر دلم زد تیر و سوداییم کرد","عاشق شکر و شکرخاییم کرد","محبوب به دل من تیر زد و مرا دلباخته خود کرد و من هم به عشق او و زیبایی‌هایش دلبسته شدم."],[483,"عاشق آنم که هر آن آن اوست","عقل و جان جاندار یک مرجان اوست","عاشق کسی هستم که در هر لحظه وجودش را حس می‌کنم؛ عقل و جان او به‌سان جانی در دل یک مرجان (که خود جاندار است) برای من زنده و پویاست."],[483,"من نلافم ور بلافم همچو آب","نیست در آتش‌کشی‌ام اضطراب","من نگران نیستم، حتی اگر در تنش و کشمکش باشم، زیرا مانند آب در آتش که آرام است، من هم در این شرایط مضطرب نیستم."],[483,"چون بدزدم چون حفیظ مخزن اوست","چون نباشم سخت‌رو پشت من اوست","اگر من دزدی کنم، مانند «حفیظ» که حافظ و محافظ چیزی است، او که مخزن و منبع من است، در این حال پشت من خواهد بود و من را حمایت خواهد کرد. در واقع، این بیت به نوعی بر تکیه‌گاه و حمایتی اشاره دارد که در موقع دشواری وجود دارد."],[483,"هر که از خورشید باشد پشت گرم","سخت رو باشد نه بیم او را نه شرم","هر کسی که نور و روشنی را از خورشید دریافت کند، قوی و مقاوم می‌شود و نه از خطر می‌ترسد و نه از عیب و ننگ شرمندگی دارد."],[483,"همچو روی آفتاب بی‌حذر","گشت رویش خصم‌سوز و پرده‌در","چنان‌که روی آفتاب بی‌هیچ ترسی می‌تابد، چهره‌اش طوری است که دشمنان را سوزانده و پرده‌ها را می‌درد."],[483,"هر پیمبر سخت‌رو بد در جهان","یکسواره کوفت بر جیش شهان","هر پیامبری که در برابر مشکلات و سختی‌ها ایستادگی کرده، به تنهایی با قدرت و جدیت بر حکومت‌های ظالم و ستمگر ضربه زده است."],[483,"رو نگردانید از ترس و غمی","یک‌تنه تنها بزد بر عالمی","او از ترس و اندوه، چهره‌اش را از دیگران برنگرداند و به تنهایی بر جهانی که پر از مشکلات و موانع است، ضربه زد."],[483,"سنگ باشد سخت‌رو و چشم‌شوخ","او نترسد از جهان پر کلوخ","سنگ یک چیزی است که خودش سخت و بی‌احساس است و به سختی تحت تأثیر قرار می‌گیرد. او نسبت به دنیا پر از مشکلات و دردسرها (کلوخ‌ها) ترسی ندارد."],[483,"کان کلوخ از خشت‌زن یک‌لخت شد","سنگ از صنع خدایی سخت شد","اینجا اشاره به این دارد که کلوخ در اثر فعالیت خشت‌زن یک‌جا و سخت شده و مانند سنگ شده است. این تغییر نشان‌دهنده قدرت خلق الهی است که می‌تواند مواد ساده را به چیزهای محکم و سخت تبدیل کند."],[483,"گوسفندان گر برونند از حساب","ز انبهیشان کی بترسد آن قصاب","اگر گوسفندها از تعدادشان خارج شوند و حساب و کتابشان را نداشته باشند، قصاب از چه چیزی باید بترسد؟ در واقع، در این بیت به بی‌تفاوتی قصاب در برابر گوسفندهایی که به حساب نمی‌آیند، اشاره شده است."],[483,"کلکم راع نبی چون راعیست","خلق مانند رمه او ساعیست","همه شما نگهبانید، زیرا مانند چوپانی که از رمه محافظت می‌کند، انسان‌ها نیز در نگهداری و سرپرستی یکدیگر هستند و تلاش می‌کنند که به یکدیگر کمک کنند."],[483,"از رمه چوپان نترسد در نبرد","لیکشان حافظ بود از گرم و سرد","رمه، یعنی گله گوسفند، در نبرد به چوپان ترسی ندارد زیرا چوپانی که از آن‌ها محافظت می‌کند، آن‌ها را در برابر سرما و گرما و خطرات دیگر حفظ می‌کند."],[483,"گر زند بانگی ز قهر او بر رمه","دان ز مهرست آن که دارد بر همه","اگر صدای خشم او به گله برسد، بدان که این محبت است که بر همه چیز تسلط دارد."],[483,"هر زمان گوید به گوشم بخت نو","که ترا غمگین کنم غمگین مشو","هر بار که بخت خوب به من خبر می‌دهد و می‌گوید که تو را غمگین می‌کنم، نگران نباش و غمگین نشو."],[483,"من ترا غمگین و گریان زان کنم","تا کت از چشم بدان پنهان کنم","من تو را از روی غمگینی و اندوه می‌آورم تا اینکه از چشم بد و حسد دیگران دور بمانی."],[483,"تلخ گردانم ز غمها خوی تو","تا بگردد چشم بد از روی تو","برای این‌که چشم بد از روی تو دور شود، من غم‌ها و سختی‌ها را به دل خود می‌گیرم و تو را تلخ و غمگین می‌کنم."],[483,"نه تو صیادی و جویای منی","بنده و افکنده رای منی","تو نه آن صیاد و جوینده‌ای که دنبال من می‌گردی، بلکه من هستم که تحت تأثیر افکار و خیال تو گرفتار شده‌ام."],[483,"حیله اندیشی که در من در رسی","در فراق و جستن من بی‌کسی","کسی که در من نشسته و به فکر حیله است، در حسرت و دوری من، به بی‌کسی دچار شده است."],[483,"چاره می‌جوید پی من درد تو","می‌شنودم دوش آه سرد تو","او (مهمان) در جستجوی چاره‌ای برای بی‌کسی من است و در شب گذشته درد و آه سرد تو را شنیدم."],[483,"من توانم هم که بی این انتظار","ره دهم بنمایمت راه گذار","من می‌توانم بدون این‌که منتظر کسی باشم، تو را به راه هدایت کنم و به تو نشان دهم که چگونه از این دشواری‌ها عبور کنی."],[483,"تا ازین گرداب دوران وا رهی","بر سر گنج وصالم پا نهی","اگر از مشکلات و گرفتاری‌های زندگی رهایی یابی، به مقصد اتّصال و دسترسی به معشوق و عشق واقعی خواهی رسید."],[483,"لیک شیرینی و لذات مقر","هست بر اندازه رنج سفر","اما از آن‌جا که شیرینی و لذت‌های مقصد به اندازه زحمات و رنج‌هایی است که در راه سفر کشیده می‌شود، می‌توان گفت که هرچه زحمت بیشتر باشد، لذت نیز در پایان بیشتر خواهد بود."],[483,"آنگه از شهر و ز خویشان بر خوری","کز غریبی رنج و محنتها بری","پس از اتمام سفر و دوری از شهر و خانواده، باید به خاطر لذت‌ها و شیرینی‌هایی که در کنار نزدیکان به دست می‌آوری، از رنج و زحمات سفر فارغ شوی."],[484,"بنگر اندر نخودی در دیگ چون","می‌جهد بالا چو شد ز آتش زبون","به نخود نگاه کن که در دیگ چگونه از شدت حرارت به بالا می‌جهد و سرش را از آب بیرون می‌آورد. این نشان‌دهنده‌ی شدت اضطراب و بی‌صبر بودن در مواجهه با سختی‌هاست."],[484,"هر زمان نخود بر آید وقت جوش","بر سر دیگ و برآرد صد خروش","هر بار که نخود از دیگ به بالا می‌آید و در حال جوشیدن است، صدای بلندی ایجاد می‌کند."],[484,"که چرا آتش به من در می‌زنی","چون خریدی چون نگونم می‌کنی","شاعر از کسی می‌پرسد که چرا به او آسیب می‌زند و آتش را به همراه خود بر او می‌افروزد، در حالی که خود او را در حال سرنگونی و بدبختی می‌بیند."],[484,"می‌زند کفلیز کدبانو که نی","خوش بجوش و بر مجه ز آتش‌کنی","کدبانو (زنی که در خانه کارهای مربوط به خانه را انجام می‌دهد) با صدای زنگی به دیگ می‌زند تا به نشانه‌ای دقت کند که مواد درون آن به خوبی بجوشد و آماده شود، اما به دلیل نا آرامی یا بی‌صبری، ممکن است به آتش کیسه‌ای همزادی بزند که باعث می‌شود غذا بی‌حوصله و نامناسب بپزد."],[484,"زان نجوشانم که مکروه منی","بلکه تا گیری تو ذوق و چاشنی","من از جوشیدن پرهیز می‌کنم چون تو باعث آزار و آفت من هستی، بلکه باید اجازه بدهم تا تو لذت و طعم شیرینی را به دست آوری."],[484,"تا غذی گردی بیامیزی بجان","بهرخواری نیستت این امتحان","تا زمانی که به جانت نیامیزد و در چهره‌ات طعم خوشی نبوده باشد، برای تو این آزمایش سخت است و نمی‌توانی از آن گذر کنی."],[484,"آب می‌خوردی به بستان سبز و تر","بهراین آتش بدست آن آب خور","اگر می‌خواهی از آتش بلای زندگی رهایی یابی، مانند درختان در باغ، به آرامی و با صبر آب بنوش تا در این مشکلات از پس آن برآیی."],[484,"رحمتش سابق بدست از قهر زان","تا ز رحمت گردد اهل امتحان","رحمت خدا همواره بر قهر او مقدم بوده است، و به همین دلیل انسان‌ها برای آزمون و امتحان، دچار سختی‌ها و مصائب می‌شوند تا از طریق رحمت به بندگی و قرب او نائل شوند."],[484,"رحمتش بر قهر از آن سابق شدست","تا که سرمایه وجود آید بدست","رحمت خداوند بر قهرش مقدم و پیشی دارد، تا اینکه این رحمت سبب شود که انسان به حقیقت هستی و وجود خود دست یابد."],[484,"زانکه بی‌لذت نروید لحم و پوست","چون نروید چه گدازد عشق دوست","به خاطر این که لذت عشق دوست وجود ندارد، از پوست و گوشت هم زائیده نمی‌شود؛ پس اگر عشق نباشد، هیچ چیزی به وجود نمی‌آید و فقط رنج و عذاب به همراه خواهد داشت."],[484,"زان تقاضا گر بیاید قهرها","تا کنی ایثار آن سرمایه را","اگر تقاضا و درخواست‌ها سر برسند و تو به خاطر آنان خسارت و فداکاری کنی، بدین معناست که باید به جای خودخواهی، ایثار و از خودگذشتگی را در نظر بگیری."],[484,"باز لطف آید برای عذر او","که بکردی غسل و بر جستی ز جو","خدا دوباره به خاطر عذر و تقصیر مؤمن رحمت و لطف خود را نازل می‌کند، زیرا او غسل کرده و از وضعیت سخت و آشفته‌اش به آرامش آمده است."],[484,"گوید ای نخود چریدی در بهار","رنج مهمان تو شد نیکوش دار","می‌گوید ای نخود، تو در فصل بهار به خاطر رنج مهمان، به خوبی نگهداری شو."],[484,"تا که مهمان باز گردد شکر ساز","پیش شه گوید ز ایثار تو باز","تا زمانی که مهمان به خانه‌اش برگردد، شکرگزاری کن و پیش پادشاه بگو که به خاطر ایثار و فداکاری تو، این نعمت‌ها در دسترس او قرار گرفت."],[484,"تا به جای نعمتت منعم رسد","جمله نعمتها برد بر تو حسد","اگر تو در نعمت و خوشی هستی، حسد و کینه دیگران نسبت به تو بیشتر می‌شود و این حسادت باعث می‌شود که نیکی‌های تو را فرصتی برای آسیب به دست بیاورند."],[484,"من خلیلم تو پسر پیش بچک","سر بنه انی ارانی اذبحک","من (ابراهیم، خلیل الله) پسرم، تو باید سر خود را پایین بیاوری و تسلیم شوی، چون من می‌گویم «می‌بینم که تو را قربانی می‌کنم»."],[484,"سر به پیش قهر نه دل بر قرار","تا ببرم حلقت اسمعیل‌وار","به خاطر نارضایتی و خشم از شرایط سخت، سر را پایین می‌آورم و آرامش را از دست می‌دهم تا همچون اسماعیل، پسر ابراهیم، آماده قربانی شدن باشم."],[484,"سر ببرم لیک این سر آن سریست","کز بریده گشتن و مردن بریست","اگرچه می‌گوید که سرش را می‌برد، اما این سر (وجود او) به گونه‌ای است که با بریدن و مردن از بین نمی‌رود و همچنان باقی خواهد ماند."],[484,"لیک مقصود ازل تسلیم تست","ای مسلمان بایدت تسلیم جست","مقصود از آغاز، تسلیم شدن به خواست و اراده خداوند است؛ ای مسلمان، تو باید به این تسلیم دست پیدا کنی."],[484,"ای نخود می‌جوش اندر ابتلا","تا نه هستی و نه خود ماند ترا","ای نخود، در شرایط سخت و دشوار در حال جوشیدنی، تا جایی که نه وجود داری و نه خودت را احساس می‌کنی."],[484,"اندر آن بستان اگر خندیده‌ای","تو گل بستان جان و دیده‌ای","اگر در آن باغ سرسبز و زیبا خندانده‌ای، تو همان گل باغ جان و دل هستی."],[484,"گر جدا از باغ آب و گل شدی","لقمه گشتی اندر احیا آمدی","اگر از باغ و دنیای زیبای آب و گل جدا شوی، به یک لقمه تبدیل می‌شوی و در حیات معنوی قرار می‌گیری."],[484,"شو غذی و قوت و اندیشه‌ها","شیر بودی شیر شو در بیشه‌ها","دلیلی برای ضعف و ترس نداشته باش و به دنبال قوت و آگاهی باش، زیرا تو مانند شیری هستی که باید در جنگل‌ها قدرتمند و شجاعانه زندگی کنی."],[484,"از صفاتش رسته‌ای والله نخست","در صفاتش باز رو چالاک و چست","تو از ویژگی‌های الهی خود جدا شده‌ای، پس به‌طور مستقیم به آن صفات برگرد و دوباره به سرزندگی و نشاط خود برگرد."],[484,"ز ابر و خورشید و ز گردون آمدی","پس شدی اوصاف و گردون بر شدی","تو از آسمان و طبیعت (ابر و خورشید و زمین) آمده‌ای و در واقع، ویژگی‌ها و صفات زیادی را به خود گرفتی و حالا در این اوصاف قرار گرفته‌ای."],[484,"آمدی در صورت باران و تاب","می‌روی اندر صفات مستطاب","تو به شکل باران به دنیا آمدی و به آرامی در صفات بی‌نظیر و شگفت‌انگیز خداوند در حال حرکت و ترقی هستی."],[484,"جزو شید و ابر و انجمها بدی","نفس و فعل و قول و فکرتها شدی","وجود تو مانند جزءهایی از شید (پرتو نور)، ابر و ستاره‌هاست و نفس، کردار، گفتار و اندیشه‌ات از این عناصر تشکیل شده است."],[484,"هستی حیوان شد از مرگ نبات","راست آمد اقتلونی یا ثقات","حیات حیوان از مرگ گیاه به وجود می‌آید و بنابراین، مرگ به معنای واقعی از دست رفتن زندگی نیست. به همین دلیل، در این وضعیت باید با شجاعت گفت که اگر کشته شویم، این مرگ هم می‌تواند در پی آن زندگی تازه‌ای را به ارمغان آورد."],[484,"چون چنین بردیست ما را بعد مات","راست آمد ان فی قتلی حیات","این بیت بیانگر این است که بعد از مرگ، زندگی و حیات تازه‌ای در انتظار انسان است. اشاره دارد به اینکه از دیدگاه معنوی، مرگ نه تنها پایان نیست، بلکه آغاز یک زندگی جدید و بهتر است."],[484,"فعل و قول و صدق شد قوت ملک","تا بدین معراج شد سوی فلک","انسان با عمل و سخنش به قوام و قدرت می‌رسد و این قوام باعث می‌شود که او به مقام والایی دست یابد و به آسمان‌ها نزدیک شود."],[484,"آنچنان کان طعمه شد قوت بشر","از جمادی بر شد و شد جانور","انسان‌ها از حالت بی‌جان و جامد مانند سنگ و گیاه به موجودات زنده و جان‌دار تبدیل می‌شوند، به طوری که قوت و زندگی‌شان از این تحولی که به وجود آمده ناشی می‌شود."],[484,"این سخن را ترجمه پهناوری","گفته آید در مقام دیگری","این موضوع و مفهوم در جای دیگری به طور مفصل‌تر شرح داده شده است."],[484,"کاروان دایم ز گردون می‌رسد","تا تجارت می‌کند وا می‌رود","کاروانی همواره از آسمان (گردون) می‌آید و بار و سفر می‌آورد تا در این دنیا تجارت کند و سپس می‌رود."],[484,"پس برو شیرین و خوش با اختیار","نه بتلخی و کراهت دزدوار","برو با اختیار و آرامش، به خوشی و شیرینی زندگی کن نه به تلخی و دشواری که مانند دزد است و از آن فرار می‌کند."],[484,"زان حدیث تلخ می‌گویم ترا","تا ز تلخیها فرو شویم ترا","من از ماجرای تلخ و دردناک صحبت می‌کنم تا تو نیز از تلخی‌ها و رنج‌های زندگی دور شوی و رهایی یابی."],[484,"ز آب سرد انگور افسرده رهد","سردی و افسردگی بیرون نهد","انگور وقتی در آب سرد قرار می‌گیرد، افسردگی و سردی را از خود دور می‌کند و به طراوت می‌رسد."],[484,"تو ز تلخی چونک دل پر خون شوی","پس ز تلخیها همه بیرون روی","زمانی که از تلخی‌ها و مشکلات قلبا رنجیده و غمگین می‌شوی، طبیعی است که از آن تلخی‌ها رها شوی و تلاش کنی تا از آنها فاصله بگیری."],[485,"سگ شکاری نیست او را طوق نیست","خام و ناجوشیده جز بی‌ذوق نیست","او مانند سگ شکاری نیست که طوقی به گردن داشته باشد و خام و نپخته و بی‌ذوق است و نمی‌تواند بجوشد یا هیجان داشته باشد."],[485,"گفت نخود چون چنینست ای ستی","خوش بجوشم یاریم ده راستی","نخود (نوعی حبوبات) در اینجا می‌گوید: اگر من این‌گونه هستم و این ویژگی‌ها را دارم، ای دوست، تو می‌توانی به من کمک کنی تا واقعیت را دریابم و همراه من بجوشی."],[485,"تو درین جوشش چو معمار منی","کفچلیزم زن که بس خوش می‌زنی","تو در این جوشش مثل معمار هستی، زیرا که من تحت تأثیر هنر و خلاقیت تو در حال ساخت و سازم، پس مانند کسی که خنده‌کنان و با مهارت کار می‌کند، مرا شکل بده و هدایت کن."],[485,"همچو پیلم بر سرم زن زخم و داغ","تا نبینم خواب هندستان و باغ","من همچون فیل، زخم و جراحت را بر سر خود بپذیرم تا به خواب هندستان و باغ نروم و غفلت نکنم."],[485,"تا که خود را در دهم در جوش من","تا رهی یابم در آن آغوش من","تا زمانی که خود را در حال و هوای من قرار ندهی، راهی برای رسیدن به محبت و آغوش من پیدا نمی‌کنی."],[485,"زانک انسان در غنا طاغی شود","همچو پیل خواب‌بین یاغی شود","انسان هنگامی که در نعمت و ثروت باشد، مثل فیل خواب‌زده، سرکش و نافرمان می‌شود."],[485,"پیل چون در خواب بیند هند را","پیلبان را نشنود آرد دغا","فیل وقتی در خواب هندوستان را می‌بیند، دیگر صدای پیلبان (فیل‌ران) را نمی‌شنود و به همین دلیل دغل‌کاری و فریب را درمی‌یابد."],[486,"آن ستی گوید ورا که پیش ازین","من چو تو بودم ز اجزای زمین","آن شخص به او می‌گوید که من قبل از این، مانند تو از عناصر و مواد زمین ساخته شده بودم."],[486,"چون بنوشیدم جهاد آذری","پس پذیرا گشتم و اندر خوری","هنگامی که جهاد آذری (مقدار زیادی نوشیدنی که به تازگی آماده شده) را نوشیدم، پذیرای زندگی و درون خودم شدم و به آنچه درونم است توجه کردم."],[486,"مدتی جوشیده‌ام اندر زمن","مدتی دیگر درون دیگ تن","مدتی در احوال و حالت‌های روحانی و معنوی خود به شدت فعالیت کرده‌ام و حالا در مدتی دیگر در وجود جسمانی و مادی‌ام به سر می‌برم."],[486,"زین دو جوشش قوت حسها شدم","روح گشتم پس ترا استا شدم","از این دو جوش و خروش، نیروهای حسی من تقویت شده است و در نتیجه، روح من بیدار شده و به مقام استادی دست یافته‌ام."],[486,"در جمادی گفتمی زان می‌دوی","تا شوی علم و صفات معنوی","در مرحله جمادی (یکی از مراحل آفرینش) به تو گفتم که از آن شراب بنوش تا بتوانی به علم و صفات معنوی دست یابی."],[486,"چون شدم من روح پس بار دگر","جوش دیگر کن ز حیوانی گذر","زمانی که من به روح تبدیل شدم، دوباره تلاش کن تا از حالت حیوانی عبور کنم و رشد کنم."],[486,"از خدا می‌خواه تا زین نکته‌ها","در نلغزی و رسی در منتها","از خدا بخواه که در این نکته‌ها دچار اشتباه نشوی و به بی‌راهه نروی."],[486,"زانک از قرآن بسی گمره شدند","زان رسن قومی درون چه شدند","بسیاری از مردم (به خاطر برداشت‌های نادرست از قرآن و همچنین دشمنی و لجاجت) گمراه شدند و برخی دیگر در پی آن، به چاه افتادند. (اشاره به آیه یضل به کثیرا - بسیاری به واسطه آن گمراه شدند)"],[486,"مر رسن را نیست جرمی ای عنود","چون ترا سودای سربالا نبود","عزیز من، گناهی بر گردن رسن (قرآن) نیست. چرا که تو خودت در پی حرکت به سمت بالا (بیرون آمدن از چاه) نیستی."],[487,"آن غریب شهر سربالا طلب","گفت می‌خسپم درین مسجد بشب","غریب شهر که به او اشاره شده، به کسی می‌گوید که در این مسجد می‌خوابم و به درخواست‌ام فکر می‌کنم."],[487,"مسجدا گر کربلای من شوی","کعبه حاجت‌روای من شوی","اگر این مسجد مانند کربلا برای من شود، به مانند کعبه‌ای که حاجت‌ها را برآورده می‌کند، تبدیل خواهی شد."],[487,"هین مرا بگذار ای بگزیده دار","تا رسن‌بازی کنم منصوروار","ای کسی که برگزیده و محبوبی، مرا رها کن تا مانند منصور، که به خاطر آزادی‌خواهی‌اش مشهور است، در بازی با طناب (رسن) زندگی کنم."],[487,"گر شدیت اندر نصیحت جبرئیل","می‌نخواهد غوث در آتش خلیل","اگر در نصیحت‌های جبرئیل (فرشته وحی) سخت‌گیری وجود داشته باشد، او نمی‌خواهد که دیگران از آتش خلیل (ابراهیم) نجات یابند. یعنی در اوج نصیحت و سرزنش، او به فکر بخشش و رهایی دیگران نیست."],[487,"جبرئیلا رو که من افروخته","بهترم چون عود و عنبر سوخته","جبرئیل، وقتی به من نگاه می‌کنی، به این فکر کن که من در آتش عشق و شوق به خدا، چون عود و عنبر که برمی‌افروزد، در حال سوختن و پاک شدن هستم و این سوختن، مرا بهتر کرده است."],[487,"جبرئیلا گرچه یاری می‌کنی","چون برادر پاس داری می‌کنی","اگرچه ای جبرئیل، تو به عنوان یاری‌کننده به من کمک می‌کنی، اما من از تو انتظار دارم که همچون یک برادر، مراقب و حامی من باشی."],[487,"ای برادر من بر آذر چابکم","من نه آن جانم که گردم بیش و کم","ای برادر، من همچون آتش زبانه‌زن و چابک هستم. من آن جان مادی و دنیوی نیستم که به کم و زیاد شدن دچار شوم."],[487,"جان حیوانی فزاید از علف","آتشی بود و چو هیزم شد تلف","جان حیوانی از خوردن علف افزایش پیدا می‌کند، اما اگر آتش باشد و مانند هیزم بسوزد، نابود می‌شود."],[487,"گر نگشتی هیزم او مثمر بدی","تا ابد معمور و هم عامر بدی","اگر هیزم او (آتش) نمی‌شدی و مثمر (سودبخش) نبود، تا ابد آباد و آبادکننده نمی‌ماندی."],[487,"باد سوزانت این آتش بدان","پرتو آتش بود نه عین آن","آتش سوزان تو از تاثیر باد است و این نور و درخشندگی، خود آتش نیست، بلکه تنها نتیجه و نشانه‌ای از وجود آن آتش است."],[487,"عین آتش در اثیر آمد یقین","پرتو و سایه ویست اندر زمین","آتش واقعی در عالم غیب وجود دارد و این شعله، تنها پرتو و سایه‌ای از آن است که در دنیا احساس می‌شود."],[487,"لاجرم پرتو نپاید ز اضطراب","سوی معدن باز می‌گردد شتاب","به طور حتم، پرتو نور نمی‌تواند از بی‌نظمی و اضطراب باقی بماند و به سوی منبع خود، یعنی منبع نور، به سرعت برمی‌گردد."],[487,"قامت تو بر قرار آمد بساز","سایه‌ات کوته دمی یکدم دراز","قامت تو به شکل استواری درآمد؛ سایه‌ات لحظه‌ای کوتاه است و لحظه‌ای دراز می‌شود."],[487,"زانک در پرتو نیابد کس ثبات","عکسها وا گشت سوی امهات","زیرا در نور، هیچ‌کس آرامش و ثبات ندارد و تغییر و دگرگونی در روح و جان همه افراد از مادران (یا اصول) به وجود می‌آید."],[487,"هین دهان بر بند فتنه لب گشاد","خشک آر الله اعلم بالرشاد","خود را کنترل کن و از حرف زدن درباره فتنه‌ها پرهیز کن، چراکه خداوند بهتر از هر کس می‌داند که هدایت چه کسانی را می‌خواهد."],[488,"پیش از آنک این قصه تا مخلص رسد","دود و گندی آمد از اهل حسد","پیش از آنکه این داستان به پایان برسد، از این حسادتها و کینه‌ها بوی بد و آزاردهنده‌ای به مشام می‌رسد."],[488,"من نمی‌رنجم ازین لیک این لگد","خاطر ساده‌دلی را پی کند","من از این موضوع ناراحت نیستم، اما این بی‌احترامی به خاطر سادگی و بی‌خبری دیگران باعث می‌شود که دل آن‌ها دچار آسیب شود."],[488,"خوش بیان کرد آن حکیم غزنوی","بهر محجوبان مثال معنوی","حکیم غزنوی با زبان زیبا و دلنشین خود، مثالی معنوی برای افرادی که از فهم ژرف معانی بازمانده‌اند، بیان کرده است."],[488,"که ز قرآن گر نبیند غیر قال","این عجب نبود ز اصحاب ضلال","اگر کسی غیر از گفته‌های قرآن را نبیند، این تعجب ندارد که او از گروه‌های گمراه است."],[488,"کز شعاع آفتاب پر ز نور","غیر گرمی می‌نیابد چشم کور","چشم کور نمی‌تواند از نور آفتاب بهره‌برداری کند و فقط با وجود نور نمی‌تواند گرما را احساس کند. این نشان می‌دهد که برخی افراد، حتی در حضور حقیقت و زیبایی، به دلیل نداشتن درک صحیح، نمی‌توانند از آن بهره‌مند شوند."],[488,"خربطی ناگاه از خرخانه‌ای","سر برون آورد چون طعانه‌ای","ناگهان یک خر، بی‌خبر از اطراف، از خرابه‌ای بیرون آمد و این وضعیت به مانند یک طعنه است."],[488,"کین سخن پستست یعنی مثنوی","قصه پیغامبرست و پی‌روی","این سخن بی‌ارزش است، یعنی مثنوی داستان پیامبران و پیروی از آن‌هاست."],[488,"نیست ذکر بحث و اسرار بلند","که دوانند اولیا آن سو سمند","ذکر و بحث درباره معانی و رازهای عمیق، در سطحی نیست که اولیا (مردان بزرگ و عارفان) به آن توجه کنند، بلکه آن‌ها همچون اسب‌های تندرو به سمت مقامات و معارف بالاتر می‌شتابند."],[488,"از مقامات تبتّل تا فنا","پایه پایه تا ملاقات خدا","از مراحل بالای زهد و انقطاع از دنیا تا رسیدن به فنا و نابودی در خدا، گام به گام می‌رویم تا به ملاقات او برسیم."],[488,"شرح و حد هر مقام و منزلی","که بپر زو بر پرد صاحب‌دلی","هر مقام و منزلتی را که صاحب دلان در مسیر معنوی خود تجربه می‌کنند، باید با دقت شرح داده و محدودیت آن را مشخص کرد."],[488,"چون کتاب الله بیامد هم بر آن","این چنین طعنه زدند آن کافران","زمانی که کتاب خدا (قرآن) نازل شد، کافران به آن طعنه زدند و آن را مسخره کردند."],[488,"که اساطیرست و افسانه نژند","نیست تعمیقی و تحقیقی بلند","این دنیا پر از افسانه‌ها و داستان‌های ساختگی است و هیچ عمق و تحقیقی در آن نیست."],[488,"کودکان خرد فهمش می‌کنند","نیست جز امر پسند و ناپسند","فهم این داستان‌ها و افسانه‌ها تنها برای کودکان خردسالی آسان است که درک آن‌ها محدود به خوب و بد است و بیشتر از این نمی‌توانند فهم کنند."],[488,"ذکر یوسف ذکر زلف پر خمش","ذکر یعقوب و زلیخا و غمش","یادکرد یوسف و زلف‌های مجعد او، یاد یعقوب و زلیخا و دردهای آن‌هاست. این اشاره به داستان معروف عشق یوسف و زلیخا و اندوه یعقوب (پدر یوسف) دارد."],[488,"ظاهرست و هرکسی پی می‌برد","کو بیان که گم شود در وی خرد","هر کسی می‌تواند از ظاهر امر بفهمد که این بیان و سخن چقدر عمیق و پیچیده است و آنقدر مسحور کننده است که عقل انسان در آن گم می‌شود."],[488,"گفت اگر آسان نماید این به تو","این چنین آسان یکی سوره بگو","مولانا در این بیت بیان می‌کند که اگر این مسأله برای تو به این سادگی جلوه‌گر می‌شود، پس به آسانی می‌توانی یکی از سوره‌های قرآن را بگویی."],[488,"جنتان و انستان و اهل کار","گو یکی آیت ازین آسان بیار","اگر بهشت و دشواری‌های آن و اهل عمل را به یک آیه‌ای از همین آسانی ربط دهی، می‌توانی به سادگی به این موضوع پی ببری."],[489,"حرف قرآن را بدان که ظاهریست","زیر ظاهر باطنی بس قاهریست","معنای این بیت این است که کلام قرآن تنها معنای ظاهری ندارد و در زیر این ظاهر، باطنی عمیق و قوی وجود دارد که اهمیت بیشتری دارد."],[489,"زیر آن باطن یکی بطن سوم","که درو گردد خردها جمله گم","زیر آن باطن، یک باطن سوم وجود دارد که در آن، همه خردها و دانسته‌ها ناپدید می‌شوند و گم می‌شوند."],[489,"بطن چارم از نبی خود کس ندید","جز خدای بی‌نظیر بی‌ندید","بطن چهارم از نبوت، هیچ‌کس جز خداوندی که بی‌نظیر است، را ندیده است."],[489,"تو ز قرآن ای پسر ظاهر مبین","دیو آدم را نبیند جز که طین","ای پسر، قرآن را فقط در ظاهرش نگاه نکن، زیرا کسی که به آن سطحی نگری کند، روح و باطن آن را نمی‌بیند و در نتیجه مانند آدمی که فقط جسمش را می‌بیند، دیو درون آدم را درک نخواهد کرد."],[489,"ظاهر قرآن چو شخص آدمیست","که نقوشش ظاهر و جانش خفیست","ظاهر قرآن مانند یک انسان است که شکل و ظواهر آن نمایان است، اما باطن و حقیقت آن پنهان می‌ماند."],[489,"مرد را صد سال عم و خال او","یک سر مویی نبیند حال او","انسان حتی با گذشت صد سال از عمرش، هیچ‌گاه نمی‌تواند به تمام ویژگی‌ها و حالات درونی خود آگاه شود و همچنان ناشناخته باقی می‌ماند."],[490,"آنک گویند اولیا در که بوند","تا ز چشم مردمان پنهان شوند","برخی می‌گویند که اولیا (شخصیت‌های معنوی و عارفان) در کوه‌ها وجود دارند تا از دیده مردم پنهان بمانند."],[490,"پیش خلق ایشان فراز صد که‌اند","گام خود بر چرخ هفتم می‌نهند","اولیا که در برابر مردم قرار دارند، در عین حال بر بالای هزاران کوه هستند و قدم‌هایشان به بلندای هفتمین آسمان می‌رسد، یعنی در حالتی معنوی و روحانی بسیار بالا قرار دارند."],[490,"پس چرا پنهان شود، که‌جو بود","کو ز صد دریا و که زان سو بود","چرا باید به کوه‌ها برود و پنهان شود، در حالی که او باید کسی باشد که از صد دریا و کوه فراتر می‌رود و از آن‌ها عبور می‌کند؟"],[490,"حاجتش نبود به سوی که گریخت","کز پیش کرّه فلک صد نعل ریخت","انبیا و اولیا نیازی به گریختن به کوه ندارند، زیرا از ترس مشکلات و دغدغه‌های مردم نیست، بلکه برای هدایت آن‌ها و تشویق‌شان به دوری از دنیا به قدر امکان این کار را می‌کنند."],[490,"چرخ گردید و ندید او گرد جان","تعزیت‌جامه بپوشید آسمان","چرخ، به معنای فلک یا آسمان، در حرکت است و به وضعیت تغییر و تحولات زندگی اشاره دارد. این تغییرات را مشاهده نمی‌کند و در عوض، فردی که بر آن گشته، بابت مصیبت‌های روحی و غم‌انگیز، لباس غم به تن کرده است. در واقع، فرد در برابر سختی‌ها و غم‌ها واکنش نشان می‌دهد و آسمان نیز به او توجهی ندارد."],[490,"گر به ظاهر آن پری پنهان بود","آدمی پنهان‌تر از پریان بود","اگر چه در ظاهر آن پری (یعنی موجودات زیبا و ظاهری) پنهان است، ولی انسان از پریان هم بیشتر در خفا و پنهانی است."],[490,"نزد عاقل زان پری که مضمرست","آدمی صد بار خود پنهان‌ترست","در نزد عاقل، انسان که درونش مخفی است، به مراتب از آن پری که پنهان است، بیشتر و پیچیده‌تر پنهان می‌شود."],[490,"آدمی نزدیک عاقل چون خفیست","چون بود آدم که در غیب او صفیست","انسان نزد عاقل مانند یک راز پنهان است، چرا که آدمی در باطن خود دارای امکانات و ویژگی‌های نادیده‌ای است که برای دیگران مخفی مانده‌اند."],[491,"آدمی همچون عصای موسی‌است","آدمی همچون فسون عیسی‌است","انسان می‌تواند مانند عصای موسی، قدرت و کارایی داشته باشد و همچنین می‌تواند مانند افسون عیسی ویژگی‌های جالب و شگفت‌انگیز را از خود نشان دهد."],[491,"در کف حق بهر داد و بهر زین","قلب مومن هست بین اصبعین","در دست خداوند، برای بخشش و نعمت، قلب مؤمن مانند انگشتان دو دست اوست."],[491,"ظاهرش چوبی ولیکن پیش او","کون یک لقمه چو بگشاید گلو","ظاهر عصای موسی، چوبی به نظر می‌رسد، اما در حقیقت وقتی که در حضور خداوند قرار می‌گیرد، می‌تواند به طرز شگفت‌آوری مانند لقمه‌ای در گلو، مؤثر و بزرگ باشد."],[491,"تو مبین ز افسون عیسی حرف و صوت","آن ببین کز وی گریزان گشت موت","با افسون عیسی، یعنی قدرت شگفت‌انگیز او در بیان و صدا، به مرگ نگاه نکن. بلکه ببین که چگونه با کلام عیسی، مرگ از انسان‌ها فرار کرد و آنها را زنده کرد."],[491,"تو مبین ز افسونش آن لهجات پست","آن نگر که مرده بر جست و نشست","تو از افسون عیسی، لهجه‌های بی‌ارزش را نپندار، زیرا نگاه کن که چگونه مردگان به خاطر او از جا برخاستند و نشسته‌اند."],[491,"تو مبین مر آن عصا را سهل یافت","آن ببین که بحر خضرا را شکافت","این بیت به شما می‌گوید که نباید به سادگی به عصای موسی نگاه کنید و اهمیت آن را نادیده بگیرید. آن را در نظر بگیرید که چگونه این عصا توانسته است دریای نیل را شکافتی و موج‌های عظیم را ایجاد کند."],[491,"تو ز دوری دیده‌ای چتر سیاه","یک قدم فا پیش نه بنگر سپاه","تو به خاطر دوری، فقط چتر سیاهی را می‌بینی و نمی‌توانی لشکر را که در آن سوست، مشاهده کنی."],[491,"تو ز دوری می‌نبینی جز که گرد","اندکی پیش آ ببین در گرد مرد","تو به خاطر دوری چیزی جز گرد و غبار خس‌خس نمی‌بینی؛ نزدیک بیا تا گرد و غبار دور را که به دلیل فاصله می‌بینی، به وضوح در نزدیکی مرد (شخصیت مهم یا اولیا) مشاهده کنی."],[491,"دیده‌ها را گرد او روشن کند","کوهها را مردی او بر کند","مردی (موسی) که در کوه طور به دیدار خدا رفت، چشمان مردم را با درخشندگی خود روشن می‌کند و باعث می‌شود که آنها بتوانند به حقیقت نزدیک‌تر شوند."],[491,"چون بر آمد موسی از اقصای دشت","کوه طور از مقدمش رقاص گشت","وقتی موسی از دوردست‌های دشت بالا می‌آید، کوه طور به خاطر حضور او مانند یک رقاص به جنبش درمی‌آید."],[492,"روی داود از فرش تابان شده","کوهها اندر پیش نالان شده","چهره داود درخشان و زیباست و چون بر زمین می‌تابد، کوه‌ها به خاطر او ناله و فریاد می‌زنند."],[492,"کوه با داود گشته همرهی","هردو مطرب مست در عشق شهی","کوه به همراه داود هماهنگ شده است و هر دو در عشق پادشاهی غرق در شادمانی و مستی به سر می‌برند."],[492,"یا جبال اوبی امر آمده","هر دو هم‌آواز و هم‌پرده شده","ای کوه‌ها، به فرمان حق آمده‌اید و هر دو یکی صدا و هم‌آواز شده‌اید."],[492,"گفت داودا تو هجرت دیده‌ای","بهر من از همدمان ببریده‌ای","داود به تو گفته است که تو هجرت و دوری را تجربه کرده‌ای و به خاطر من از هم‌نشینان و دوستانت جدا شده‌ای."],[492,"ای غریب فرد بی مونس شده","آتش شوق از دلت شعله زده","ای فردی که به دور از دوستان و آشناها شده‌ای و احساس تنهایی می‌کنی، عشق و آرزو در دل تو به شدت شعله‌ور شده است."],[492,"مطربان خواهی و قوال و ندیم","کوهها را پیشت آرد آن قدیم","اگر خواهان مطرب و قوال و دوستانی هستی، آن‌ها می‌توانند کوه‌ها را نیز به پیش تو بیاورند، همچنان که در گذشته این کار صورت می‌گرفت."],[492,"مطرب و قوال و سرنایی کند","که به پیشت بادپیمایی کند","موزیسین، قوال و نوازنده با سازی همچون نی و سرنا، باد را به سوی تو می‌فرستد تا نوای موسیقی را بیاورد."],[492,"تا بدانی ناله چون که را رواست","بی لب و دندان ولی را ناله‌هاست","تا بفهمی که ناله کردن برای چه کسی جایز است، بدان که این ناله‌ها از دل کسی برمی‌خیزد که نه لب دارد و نه دندان، یعنی او در حالتی است که نتواند به راحتی ابراز احساسات کند."],[492,"نغمه اجزای آن صافی‌جسد","هر دمی در گوش حسش می‌رسد","هزینه‌های جسمی او به قدری خالص و پاک است که هر لحظه نغمه و صدای اجزای بدنش به حس او می‌رسد."],[492,"همنشینان نشنوند او بشنود","ای خنک جان کو به غیبش بگرود","محبت و حقیقتی که دل‌های دیگران نمی‌توانند بشنوند، برای جان‌هایی که به عالم غیب و باطن متصل‌اند، آشکار است. ای کاش یک چنین جانی که به عالم غیبی پیوند دارد، وجود داشت."],[492,"بنگرد در نفس خود صد گفت و گو","همنشین او نبرده هیچ بو","انسانی که به درون خود نگاه کند، به درک و فهم عمیقی از وجود خویش می‌رسد و در این حال، صحبت‌ها و گفتگوهای درونی خود را احساس می‌کند، در حالی که دیگران از این تجربه بی‌خبرند."],[492,"صد سؤال و صد جواب اندر دلت","می‌رسد از لامکان تا منزلت","در دل تو هزاران سؤال و جواب وجود دارد که از عالم بی‌کران به سوی مقام و منزلت تو می‌آید."],[492,"بشنوی تو نشنود زان گوشها","گر به نزدیک تو آرد گوش را","اگر تو از آن گوش‌ها که به نزدیک تو آورده شده است، چیزی بشنوی، دیگر آن گوش‌ها نخواهند شنید."],[492,"گیرم ای کر خود تو آن را نشنوی","چون مثالش دیده‌ای چون نگروی","اگر تو نیز مانند کران، آن را نشنوی، چرا که چون تصویرش را دیده‌ای، مانند نگار در ذهن تو حک شده است."],[493,"ای سگ طاعن تو عو عو می‌کنی","طعن قرآن را برون‌شو می‌کنی","ای آن که به قرآن حمله می‌کنی و بی‌جهت در حق او بی‌حرمتی می‌کنی، تو همچون سگی هستی که پارس می‌کند و اینگونه، طعنه قرآن درمورد بدگویان (آنجا که فرموده آنان را همچون سگان، بند اگر زنی یا رهاشان سازی، هر دو حالت گاز میگیرند) را ظاهر و آشکار و جلوه گر میکنی."],[493,"این نه آن شیرست کز وی جان بری","یا ز پنجه قهر او ایمان بری","این اشاره‌ای به قدرت و عظمت قرآن است. می‌گوید این قرآن مانند شیری نیست که از آن بترسید و جان و ایمان‌تان را از دست بدهید."],[493,"تا قیامت می‌زند قرآن ندی","کای گروه جهل را گشته فدی","قرآن تا قیامت به جهل و نادانی شما گوشزد می‌کند که گناه شما باعث گرفتاریتان شده است."],[493,"که مرا افسانه می‌پنداشتید","تخم طعن و کافری می‌کاشتید","شما مرا داستان و افسانه می‌دانستید و به همین دلیل، زخم زبان و تهمت‌زنی را به من نسبت می‌دادید و باور داشتید که من کافر هستم."],[493,"خود بدیدید آن‌که طعنه می‌زدید","که شما فانیّ و افسانه بدید","شما خودتان دیدید که تهمت و طعنه می‌زدید، در حالی که شما نیز زودگذر و بی‌ارزش هستید و فقط مانند یک داستان به شمار می‌آیید."],[493,"من کلام حقّم و قائم به ذات","قوت جان جان و یاقوت زکات","من، کلام حقی را دارم که خود، مستقل و قائم به ذات است و به‌عنوان نیروی حیات و ارزش معنوی در قلب‌ها و جان‌ها، روشنایی‌بخش و مایه زندگی است."],[493,"نور خورشیدم فتاده بر شما","لیک از خورشید ناگشته جدا","من منبع نور و روشنایی هستم که بر شما تابیده‌ام، اما شما درک و فهم شما از من کم است و همچنان از من جدا هستید."],[493,"نک منم ینبوع آن آب حیات","تا رهانم عاشقان را از ممات","من منبع آب حیات هستم که می‌توانم عاشقان را از مرگ نجات دهم و به زندگی جاودان برسانم."],[493,"گر چنان گند آزتان ننگیختی","جرعه‌ای بر گورتان، حق ریختی","اگر به شما عذاب و خجالت نمی‌رسید و گناهی بر دوش شما نمی‌افتاد، آن‌گاه شما نصیبی از حق و حقیقت را به خودتان نمی‌ریختید."],[493,"نه بگیرم گفت و پند آن حکیم","دل نگردانم به هر طعنی سقیم","من از سخن و نصیحت آن حکیم چیزی نخواهم گرفت و دل خود را به هر طعنه و انتقاد بی‌اساسی نخواهم بزرگ کرد."],[494,"آنک فرمودست او اندر خطاب","کره و مادر همی‌خوردند آب","او (یعنی خداوند یا مولانا) از زبان شخصیتی که با اسپ و مادرش صحبت می‌کند، می‌گوید که آن‌ها در حال نوشیدن آب هستند."],[494,"می‌شخولیدند هر دم آن نفر","بهر اسپان که هلا هین آب خور","هر لحظه آن افراد مشغول بودند به شخولیدن و حرکت دادن کره‌ها، تا به اسب‌ها یادآوری کنند که از آب بنوشند و برای این کار هشدار می‌دادند."],[494,"آن شخولیدن به کره می‌رسید","سر همی بر داشت و از خور می‌رمید","کره اسب به سبب شخولیدن، سر خود را بالا می‌آورد و از آب خوردن می‌گریزد."],[494,"مادرش پرسید کای کره چرا","می‌رمی هر ساعتی زین استقا","مادر کره نگران شده و از او می‌پرسد که چرا هر لحظه از این مکان دور می‌شود و فرار می‌کند."],[494,"گفت کره می‌شخولند این گروه","ز اتفاق بانگشان دارم شکوه","کره می‌گوید که این گروه به‌طور ناگهانی مرا می‌زنند و به همین دلیل صدای آنها را می‌شنوم و نسبت به آن شکایت دارم."],[494,"پس دلم می‌لرزد از جا می‌رود","ز اتفاق نعره خوفم می‌رسد","دل من از ترس به تپش افتاده و احساس می‌کنم که از جایش می‌لرزد. به دلیل یک وضعیت ناگوار یا غافلگیرکننده، صدای وحشت من به گوش می‌رسد."],[494,"گفت مادر تا جهان بودست ازین","کارافزایان بدند اندر زمین","مادر گفت تا وقتی که این کارآفرینان بد در زمین وجود دارند، جهان به همین شکل خواهد بود."],[494,"هین تو کار خویش کن ای ارجمند","زود کایشان ریش خود بر می‌کنند","ای فرد ارزشمند، تلاش خود را آغاز کن و به زودی کسانی که در کار خود سست هستند، از فعالیت خود دست می‌کشند و ریش خود را می‌زنند."],[494,"وقت تنگ و می‌رود آب فراخ","پیش از آن کز هجر گردی شاخ شاخ","زمان کم است و آب زیاد در حال رفتن است، پیش از آنکه به خاطر دوری و جدایی از تو، به حالت گیاه‌های خشک و بی‌برگ تبدیل شوم."],[494,"شهره کاریزیست پر آب حیات","آب کش تا بر دمد از تو نبات","کارزاری (چاه یا قناتی) پر آب وجود دارد که مایه حیات است. آب را بکش و آن را به زراعت برسان تا گیاهان از آن بهره‌مند شوند."],[494,"آب خضر از جوی نطق اولیا","می‌خوریم ای تشنه غافل بیا","به ما آب حیات خضر، که نشان‌دهنده علم و بصیرت اولیا (پیدایش‌های الهی و عارفان) است، می‌رسد، ای تشنه نادان و غافل! بیا و توجه کن که به این علم دست یابی."],[494,"گر نبینی آب کورانه بفن","سوی جو آور سبو در جوی زن","اگر نتوانی آب را ببینی، به‌طور نابخردانه به طرف جوی نرو و سبو (ظرف) را در آب نزن."],[494,"چون شنیدی کاندرین جو آب هست","کور را تقلید باید کار بست","اگر شنیدی که در این جوی آب هست، باید کور (کسی که دید ندارد) برای پیدا کردن آب به تقلید و جست‌وجو بپردازد."],[494,"جو فرو بر مشک آب‌اندیش را","تا گران بینی تو مشک خویش را","اگر از آب زلال و گوارا (جو) آگاه هستی، باید مشک خویش را در زیر نگه‌داری (فکر و اندیشه) قرار دهی و وقتی که سنگینی (مشک) را احساس می‌کنی، باید به آن توجه کنی."],[494,"چون گران دیدی شوی تو مستدل","رست از تقلید خشک آنگاه دل","وقتی که چیزی را سنگین و باارزش دیدی، باید به این نکته توجه کنی که دلیل این ارزش چیست و از تقلید کورکورانه دوری کنی تا درک صحیحی از واقعیت پیدا کنی."],[494,"گر نبیند کور آب جو عیان","لیک داند چون سبو بیند گران","اگر کور، آب جو را واضح نبیند، اما می‌داند که وقتی سبو را می‌بیند، سنگین شده است."],[494,"که ز جو اندر سبو آبی برفت","کین سبک بود و گران شد ز آب و زفت","وقتی آب از جوی به سبو می‌ریزد، این آب سبک است، اما وقتی در سبو جمع می‌شود، به خاطر سنگینی و غلظت آب، سبو سنگین می‌شود."],[494,"زانک هر بادی مرا در می‌ربود","باد می‌نربایدم ثقلم فزود","هر بادی مرا از حال و وضعی که دارم، به راحتی می‌برد؛ اما با وجود این، سنگینی و سختی جرم من بیشتر می‌شود."],[494,"مر سفیهان را رباید هر هوا","زانک نبودشان گرانی قوی","سفیهان (بزرگان نادان) به خاطر نداشتن باور و بصیرت قوی، به سادگی تحت تاثیر هر هوایی (هواهای نفسانی یا اوهام) قرار می‌گیرند و به دنبال آن می‌روند."],[494,"کشتی بی‌لنگر آمد مرد شر","که ز باد کژ نیابد او حذر","مرد شر مانند کشتی‌ای است که لنگر ندارد و در برابر بادهای بد و خطرناک کنترل خود را از دست می‌دهد. او نمی‌تواند از آسیب‌ها و مشکلات دوری کند زیرا بی‌مراقبت و بی‌پایه است."],[494,"لنگر عقلست عاقل را امان","لنگری در یوزه کن از عاقلان","عقل مانند لنگر است که از خطرات و هول و هراس‌ها محافظت می‌کند. بنابراین، عاقل باید مثل یک لنگر در دنیای پر تلاطم زندگی، به عقل و اندیشه خود تکیه کند تا از گمراهی و لغزش در امان بماند."],[494,"او مددهای خرد چون در ربود","از خزینه درّ آن دریای جود","عقل در مواقعی که کمک‌هایی را از خداوند دریافت می‌کند، مانند دری ارزشمند از دریای بخشش اوست."],[494,"زین چنین امداد دل پر فن شود","بجهد از دل چشم هم روشن شود","از این‌گونه یاری‌هاست که دل انسان پر از مهارت و هنر می‌شود و به همین دلیل، از دل، چشمی روشن و بینا ایجاد می‌شود."],[494,"زانک نور از دل برین دیده نشست","تا چو دل شد دیده تو عاطلست","چون نور از دل بر چشم تو می‌تابد، پس چشم تو، که بی‌دل است، نادان و بی‌فایده می‌شود."],[494,"دل چو بر انوار عقلی نیز زد","زان نصیبی هم بدو دیده دهد","وقتی دل به نور عقل توجه پیدا کند، از آن نیز نصیبی نصیبش می‌شود که به او بینایی و درک می‌دهد."],[494,"پس بدان کاب مبارک ز آسمان","وحی دلها باشد و صدق بیان","وحی آسمانی سبب خوشبختی و راهنمایی دل‌هاست و بیان راست و صادق از آن ناشی می‌شود."],[494,"ما چو آن کره هم آب جو خوریم","سوی آن وسواس طاعن ننگریم","ما مانند آن کره‌ای هستیم که آب زلال می‌نوشد و به وسوسه‌ها و طعنه‌های دیگران هیچ توجهی نداریم."],[494,"پی‌رو پیغمبرانی ره سپر","طعنه خلقان همه بادی شمر","پیروان پیامبرانی که از طعنه و سرزنش مردم می‌گذرند، مانند باد می‌گذرانند و به آن توجهی ندارند."],[494,"آن خداوندان که ره طی کرده‌اند","گوش فا بانگ سگان کی کرده‌اند","خداوندانی که راه پیموده‌اند و به کمال رسیده‌اند، هرگز به صدای ناهنجار و ناپسند سگان توجهی نمی‌کنند."],[495,"باز گو کان پاک‌باز شیرمرد","اندر آن مسجد چه بنمودش چه کرد","پاک‌باز شیرمرد، یعنی مردی شجاع و شریف، در آن مسجد چه کار کرد و چه نشانه‌هایی از خود به جا گذاشت."],[495,"خفت در مسجد خود او را خواب کو","مرد غرقه گشته چون خسپد بجو","او که در مسجد خوابش برده بود، مردی غرق در غم شده است؛ مانند کسی که در خواب افتاده ولی از حال خود بی‌خبر است."],[495,"خواب مرغ و ماهیان باشد همی","عاشقان را زیر غرقاب غمی","خواب آن مرغ و ماهیان نمادی است از سرنوشت عاشقان که در زیر فشار غم غرق شده‌اند. این غم چنان شدید است که آن‌ها را به حالت خواب و بی‌خبری می‌برد."],[495,"نیمشب آواز با هولی رسید","کایم آیم بر سرت ای مستفید","در نیمه‌شب صدای هولی (شور و هیاهو) شنیده می‌شود که می‌گوید: ای بهره‌مند و آگاه، من می‌آیم بر سرت."],[495,"پنج کرت این چنین آواز سخت","می‌رسید و دل همی‌شد لخت‌لخت","پنج بار اینگونه صدای دلخراش به گوش می‌رسید و دل آدمی به شدت مضطرب و بی‌تاب می‌شد."],[496,"تو چو عزم دین کنی با اجتهاد","دیو بانگت بر زند اندر نهاد","هرگاه که تو با اراده و کوشش به دنبال دین و آموزه‌های آن باشی، صدای دیو (شیطان) تو را از درون تهدید می‌کند و مزاحمت می‌کند."],[496,"که مرو زان سو بیندیش ای غوی","که اسیر رنج و درویشی شوی","از آن طرف مرو و فکر نکن، ای جوان، که در این مسیر به زحمت و فقر دچار می‌شوی."],[496,"بی‌نوا گردی ز یاران وابری","خوار گردی و پشیمانی خوری","از دوستان و یاران دور می‌شوی و در نتیجه بی‌نوا و بی‌پناه می‌گردی، و در نهایت به ذلت و خفت می‌رسید و پشیمان می‌شوی."],[496,"تو ز بیم بانگ آن دیو لعین","وا گریزی در ضلالت از یقین","تو به خاطر ترس از صدای آن دیو شوم، از یقین به حقیقت و راه درست دوری می‌کنی و در جهل و گمراهی قرار می‌گیری."],[496,"که هلا فردا و پس فردا مراست","راه دین پویم که مهلت پیش ماست","فردا و پس‌فردا نجات من در دست است. باید در پی راه دین بروم، چون هنوز فرصت دارم."],[496,"مرگ بینی باز کو از چپ و راست","می‌کشد همسایه را تا بانگ خاست","مرگ را می‌بینی که از دو طرف (چپ و راست) به سراغ آدم‌ها می‌آید و همسایه‌ات را نیز گرفته و به عزا می‌کشاند تا سرانجام صدای ندا بلند شود."],[496,"باز عزم دین کنی از بیم جان","مرد سازی خویشتن را یک زمان","اگر از ترس مرگ و خطرات زندگی تصمیم به دین‌داری بگیری، در حقیقت، خودت را برای مدتی از حالت اولیه و بی‌خیالی دور کرده‌ای و به دینی تازه روی آورده‌ای."],[496,"پس سلح بر بندی از علم و حکم","که من از خوفی نیارم پای کم","پس باید سلاحی از علم و دانایی داشته باشی، زیرا من به خاطر ترس نمی‌توانم در این میدان کم‌ترین زحمتی بکشم."],[496,"باز بانگی بر زند بر تو ز مکر","که بترس و باز گرد از تیغ فقر","برای تو بار دیگر از مکر و فریب دنیا صدایی به گوش می‌رسد که از آن بترسی و از تنگی و نیاز مالی دوری کنی."],[496,"باز بگریزی ز راه روشنی","آن سلاح علم و فن را بفکنی","اگر از راه روشن علم و مهارت فرار کنی و خود را از این سلاح‌ها دور کنی، در واقع به خودت آسیب زده‌ای."],[496,"سالها او را به بانگی بنده‌ای","در چنین ظلمت نمد افکنده‌ای","سال‌ها او (انسان) را به صدای شیاطین، در چنین ظلمت (نادانی و بی‌خبری) گرفتار کرده‌ای."],[496,"هیبت بانگ شیاطین خلق را","بند کردست و گرفته حلق را","صدای شیاطین آنچنان ترسناک و باشکوه است که مردم را از حرکت بازمی‌دارد و گلوهایشان را می‌فشارد."],[496,"تا چنان نومید شد جانشان ز نور","که روان کافران ز اهل قبور","جان‌های کافران آن‌قدر از نور ناامید و تاریک شدند که گویی از قبرهای خود خارج شده‌اند و هنوز به زندگی بازنگشته‌اند."],[496,"این شکوه بانگ آن ملعون بود","هیبت بانگ خدایی چون بود","این صدا و شکوه، صدای شیطان است. هیبت و قدرت صدای خداوند چه شکلی دارد؟"],[496,"هیبت بازست بر کبک نجیب","مر مگس را نیست زان هیبت نصیب","هیبت و قدرت پرنده باز، مخصوصا نسبت به کبک‌های شریف و نجیب است و مگس‌ها از این هیبت بهره‌ای ندارند و نمی‌توانند به هدف بزرگ‌تر دست یابند."],[496,"زانک نبود باز صیاد مگس","عنکبوتان می مگس گیرند و بس","چون صیاد (شکارچی) باز (پرنده شکاری) نیست، مگس‌ها دیگر نمی‌توانند شکار شوند و عنکبوت‌ها فقط مگس‌ها را می‌گیرند."],[496,"عنکبوت دیو بر چون تو ذباب","کر و فر دارد نه بر کبک و عقاب","دیو عنکبوت به خاطر وجود تو، مثل مگس کر و فر را دارد و بر پرندگان بزرگی چون کبک و عقاب اثری نمی‌گذارد."],[496,"بانگ دیوان گله‌بان اشقیاست","بانگ سلطان پاسبان اولیاست","صدای دیوان، یعنی صداهای شومی که از آنها می‌آید، برای گله‌داران و نگهبانان بد و شقاوت بار است، در حالی که صدای سلطان پاسبان، علامت امنیت و موارد اولیاست (بهترین چیزها) است."],[496,"تا نیامیزد بدین دو بانگ دور","قطره‌ای از بحر خوش با بحر شور","اگر این دو ندای متفاوت (صدای دیوان و صدای پاسبان) با هم ترکیب نشوند، نمی‌توان قطره‌ای از دریا (خوشی) را با دریا (شور) ناگهان مخلوط کرد."],[497,"بشنو اکنون قصه آن بانگ سخت","که نرفت از جا بدان آن نیکبخت","داستان آن صدای قوی و لرزانی را بشنو که باعث نشد آن انسان خوشبخت، از جایش حرکت کند."],[497,"گفت چون ترسم چو هست این طبل عید","تا دهل ترسد که زخم او را رسید","او می‌گوید که چون من می‌ترسم، طبل عید اینجا به صدا درآمده است، در نتیجه دهل هم می‌ترسد که مبادا زخم او به وی برسد. یعنی نگرانی او از پیامت‌های منفی این صدا موجب می‌شود که دیگر اجزای موجود نیز احساس خطر کنند."],[497,"ای دهلهای تهی بی قلوب","قسمتان از عید جان شد زخم چوب","ای دهل‌های تو خالی و بی‌روح، قسم‌تان به روز عید جان، زخم چوب (کتک) آزاردهنده است."],[497,"شد قیامت عید و بی‌دینان دهل","ما چو اهل عید خندان همچو گل","در روز قیامت، عید بزرگ و شگفتی برای ما است و بی‌دینان مانند کسانی که در عید شاد هستند، به صدای دهل ما می‌خندند و نسبت به آن شادابی نشان می‌دهند، مانند گل که زیبا و شاداب است."],[497,"بشنو اکنون این دهل چون بانگ زد","دیگ دولتبا چگونه می‌پزد","اکنون صدای این طبل را بشنو، مثل صدای دیگ دولت که چگونه در حال پختن غذاست."],[497,"چونک بشنود آن دهل آن مرد دید","گفت چون ترسد دلم از طبل عید","وقتی که آن مرد صدای دهل را می‌شنود، می‌گوید دلم از طبل عید می‌ترسد."],[497,"گفت با خود هین ملرزان دل کزین","مرد جان بددلان بی‌یقین","به خود می‌گوید که نترس و آرام باش، چون از وجود این مرد بی‌ثبات و بددل، تو باید مطمئن باشی و به خودت ایمان داشته باشی."],[497,"وقت آن آمد که حیدروار من","ملک گیرم یا بپردازم بدن","زمان آن رسیده که مانند حیدر (علی) با شجاعت عمل کنم و یا اینکه با بدنم از این دنیا بگذرم."],[497,"بر جهید و بانگ بر زد کای کیا","حاضرم اینک اگر مردی بیا","با صدای بلند اعلام کرد که من اینجا هستم و آماده‌ام؛ اگر مردی هست، بیاید تا با هم روبه‌رو شویم."],[497,"در زمان بشکست ز آواز آن طلسم","زر همی‌ریزید هر سو قسم قسم","در زمان شکست طلسم، صدای آن باعث می‌شد که زر به‌طور تکه‌تکه و در هر سمت بریزد."],[497,"ریخت چند این زر که ترسید آن پسر","تا نگیرد زر ز پری راه در","چندین ذرّات زر به زمین ریخت و آن پسر از ترس این که مبادا زر را پری (موجود فراطبیعی) برباید، نزدیک آن‌ها نرفت."],[497,"بعد از آن برخاست آن شیر عتید","تا سحرگه زر به بیرون می‌کشید","پس از اینکه آن پسر ترسیده و زر را رها کرد، شیر قدیمی (پیر) برخاست و تا صبح، زر را از زیر زمین بیرون می‌آورد."],[497,"دفن می‌کرد و همی آمد بزر","با جوال و توبره بار دگر","او (شیر عتید) در حال دفن کردن گنج‌ها بود و با کیسه‌ها و بارهایی دیگر به سوی او (گنج) می‌آمد."],[497,"گنجها بنهاد آن جانباز از آن","کوری ترسانی واپس خزان","آن جانباز (شخصی شجاع و فداکار) گنجینه‌ها را در آن طرف (جایی دور از دید) گذاشت تا آن کور (شخصی که از حقیقت بی‌خبر است) را از ترس کوری‌اش دور کند، تا مبادا چیزی را از دست بدهد."],[497,"این زر ظاهر بخاطر آمدست","در دل هر کور دور زرپرست","زر (طلا) ظاهر شده است که توجه هر کسی که کور است و فقط به دنبال طلاست را جلب کند. این افراد به خاطر نداشتن بصیرت واقعی، تنها به ظواهر و riches اهمیت می‌دهند."],[497,"کودکان اسفالها را بشکنند","نام زر بنهند و در دامن کنند","کودکان می‌خواهند با تخریب عروسک‌ها (اسفال‌ها) اسباب بازی خود، به آن‌ها نام زر دهند و در دامن خود جمع کنند. این نشان می‌دهد که آن‌ها به دنبال زیبایی و غنای ظاهری هستند."],[497,"اندر آن بازی چو گویی نام زر","آن کند در خاطر کودک گذر","در آن بازی که کودکان انجام می‌دهند، اگر بگویند نام زر (طلا) را، این نام در ذهن کودک باقی می‌ماند و تأثیرش را می‌گذارد."],[497,"بل زر مضروب ضرب ایزدی","کو نگردد کاسد آمد سرمدی","طلای ناب و مطلقی که به دست خداوند ضرب شده است، هرگز از بین نمی‌رود و همیشه باقی می‌ماند."],[497,"آن زری کین زر از آن زر تاب یافت","گوهر و تابندگی و آب یافت","این طلا که در اینجا به آن اشاره شده، از آن طلاست که به خاطر رونق و زیبایی‌اش، به جواهر و درخشندگی و آب (زندگی) دست یافته است. به عبارتی دیگر، این طلا طلاست که از ویژگی‌های خاص و درخشانش بهره‌مند شده است."],[497,"آن زری که دل ازو گردد غنی","غالب آید بر قمر در روشنی","آن زری که دل از او پر از ثروت و بی‌نیازی می‌شود، در روشنایی خود بر ماه (قمر) نیز غلبه می‌کند."],[497,"شمع بود آن مسجد و پروانه او","خویشتن در باخت آن پروانه‌خو","مسجد مانند شمعی است که نور می‌دهد و پروانه، به عشق نور و روشنایی آن، جان خود را در این مسیر فدا می‌کند. پروانه، خود را به خاطر عشق به نور مسجد، در خطر می‌اندازد."],[497,"پر بسوخت او را ولیکن ساختش","بس مبارک آمد آن انداختش","اگرچه پروانه در آتش شمع سوخت، اما در نهایت این سوختن برای او خوش یمن و نیکو بود و باعث شد به کمالی دست یابد."],[497,"همچو موسی بود آن مسعودبخت","کاتشی دید او به سوی آن درخت","آن شخص خوش‌اقبال مانند موسی، آتش سوزانی را دید که او را به سوی درختی فرا می‌خواند."],[497,"چون عنایتها برو موفور بود","نار می‌پنداشت و خود آن نور بود","چون رحمت‌ها و لطف‌ها بر او فراوان بود، او آتش را می‌پنداشت (و خود را در زمره آتش) ولی در واقع خود او نور (و روشنی) بود."],[497,"مرد حق را چون ببینی ای پسر","تو گمان داری برو نار بشر","اگر مردی که به حقیقت نزدیک است را ببینی، ای پسر، ممکن است فکر کنی که او مانند آتش بشری است."],[497,"تو ز خود می‌آیی و آن در تو است","نار و خار ظن باطل این سو است","تو از وجود خودت می‌آیی و درون تو آتش و خار (رنج) وجود دارد؛ گمان نکن که این دردی که احساس می‌کنی از بیرون است."],[497,"او درخت موسی است و پر ضیا","نور خوان نارش مخوان باری بیا","این بیت به درختی اشاره دارد که موسی (پیامبر خدا) در کنار آن با نور خداوندی سخن گفت. شاعر بیان می‌کند که این درخت، درختی پرنور و زیبا است و نباید آن را به عنوان نمادی از آتش و عذاب خواند، بلکه باید به نور و روشنایی‌اش توجه کرد. در دعوت به آمدن، اشاره به این دارد که حتی اگر ظاهرش آتش است، حقیقتش نور و روشنی است."],[497,"نه فطام این جهان ناری نمود","سالکان رفتند و آن خود نور بود","این جهان، در حقیقت، آتشین و پر از مصیبت است و سالکان (جستجوگران حقیقت) از آن رفته‌اند، اما نور حقیقی که همان آگاهی و معرفت است، در این دنیا وجود دارد و بر آن‌ها درخشش می‌یابد."],[497,"پس بدان که شمع دین بر می‌شود","این نه همچون شمع آتشها بود","بدان که شمع دین مانند شمع‌های معمولی که آتش می‌گیرند نیست، بلکه درخشش و روشنایی خاصی دارد که از آن می‌تابد."],[497,"این نماید نور و سوزد یار را","و آن بصورت نار و گل زوار را","این نور که به ظهور می‌آید، باعث روشنی و حیات دل یار می‌شود، در حالی که آن آتش هم به صورت آتش و هم به شکل گلی زینتی، موجودیت خود را نشان می‌دهد."],[497,"این چو سازنده ولی سوزنده‌ای","و آن گه وصلت دل افروزنده‌ای","این تو همچون سازنده‌ای هستی که می‌سوزاند و آن (یار) بعد از آن وصلی است که دل را خوشحال و نورانی می‌کند."],[497,"شکل شعله نور پاک سازوار","حاضران را نور و دوران را چو نار","شکل شعله نور به زیبایی، نور پاک حاضران را همچون شعله آتش می‌سازد و به دور و بر می‌تاباند."],[498,"آن بخاری نیز خود بر شمع زد","گشته بود از عشقش آسان آن کبد","این بیت به این معناست که آن بخار (احساسات عاطفی) که از شمع (عشق) بلند می‌شود، به واسطه عشقش آسان و بدون زحمت به کبد (دل یا باطن) می‌رسد، و نشان‌دهنده تأثیر عمیق عشق بر وجود انسان است."],[498,"آه سوزانش سوی گردون شده","در دل صدر جهان مهر آمده","آه و ن cries ی حزن‌آلود او به آسمان رفته و در دل صدر جهان، یعنی در دل کسی که مقام والایی دارد، عشق و محبت جاری شده است."],[498,"گفته با خود در سحرگه کای احد","حال آن آواره ما چون بود","با خود فکر کرد که ای یکتا، حال آن عاشق بی‌خانمان ما چگونه است؟"],[498,"او گناهی کرد و ما دیدیم لیک","رحمت ما را نمی‌دانست نیک","این شخص (او) مرتکب گناهی شد و ما آن را مشاهده کردیم، ولی او نمی‌دانست که رحمت ما نسبت به او چقدر زیاد است."],[498,"خاطر مجرم ز ما ترسان شود","لیک صد اومید در ترسش بود","دل گنهکار از ما می‌ترسد، اما در دلش امیدهای بسیاری دارد که در این ترس وجود دارد."],[498,"من بترسانم وقیح یاوه را","آنک ترسد من چه ترسانم ورا","من آن کسی هستم که می‌توانم وقیح و بی‌شرم را بترسانم، ولی آیا او از من می‌ترسد؟ چنین آدمی را چه دلیلی است که از من بترسد؟"],[498,"بهر دیگ سرد آذر می‌رود","نه بدان کز جوش از سر می‌رود","برای جلوگیری از به هم ریختگی و حفظ آرامش، باید گاهی از حضور در موقعیت‌های پرتنش دوری کرد. این متن به این نکته اشاره دارد که در زندگی، برخی مسائل و چالش‌ها تنها به خاطر شدت خود می‌توانند موجب ناراحتی یا ترس شوند."],[498,"آمنان را من بترسانم به علم","خایفان را ترس بردارم به حلم","من با دانش خود آمنان (با یقین و امن) را بترسانم و به وسیله‌ بردباری، ترس خایفان (ترسانان) را برطرف کنم."],[498,"پاره‌دوزم پاره در موضع نهم","هر کسی را شربت اندر خور دهم","من به مانند یک پاره‌دوز، کاری می‌کنم که هر چیز را در جای مناسب خود قرار دهم و به هر کسی بر اساس نیازش، نعمت و خوشی می‌بخشم."],[498,"هست سر مرد چون بیخ درخت","زان بروید برگهاش از چوب سخت","سر مرد مانند ریشه درخت است و از آنجا است که برگ‌های او (ویژگی‌ها یا صفات او) از چوب سخت (موجودیت او) رشد می‌کند."],[498,"درخور آن بیخ رسته برگها","در درخت و در نفوس و در نهی","درختی که از ریشه خوب و استواری رشد کرده باشد، برگ‌هایش هم شایسته و زیبا خواهد بود. این موضوع در مورد انسان‌ها نیز صدق می‌کند؛ اگر پایه و ریشه وجود آن‌ها نیکو باشد، صفات و خصلت‌هایشان نیز نیکو خواهد بود."],[498,"برفلک پرهاست ز اشجار وفا","اصلها ثابت و فرعه فی السما","پرها مانند منافذی از درختان وفا به آسمان رسیده‌اند و ریشه‌هایشان در زمین محکم و ثابت است، در حالی که شاخه‌هایشان به سوی آسمان گسترش یافته است."],[498,"چون برست از عشق پر بر آسمان","چون نروید در دل صدر جهان","وقتی عشق به اوج می‌رسد و شخصیت را به پرواز درمی‌آورد، دیگر هیچ چیز نمی‌تواند او را از مقام و جایگاهش در عالم وجود جدا کند."],[498,"موج می‌زد در دلش عفو گنه","که ز هر دل تا دل آمد روزنه","عفو و بخشش گناهان در دل او مانند موج حرکت می‌کرد، زیرا این ارتباط میان دل‌ها شبیه روزنه‌ای است که از دل یک نفر به دل دیگری می‌رسد."],[498,"که ز دل تا دل یقین روزن بود","نه جدا و دور چون دو تن بود","به یقین، میان دل‌ها ارتباطی وجود دارد و آن‌ها از هم جدا و دور نیستند؛ مانند دو نفر که به هم متصل‌اند."],[498,"متصل نبود سفال دو چراغ","نورشان ممزوج باشد در مساغ","دو چراغ که نورشان به هم آمیخته است، مانند دو تکه سفال نیستند که به هم متصل نباشند؛ بلکه نور آن‌ها به طور طبیعی و پیوسته با یکدیگر ترکیب شده است."],[498,"هیچ عاشق خود نباشد وصل‌جو","که نه معشوقش بود جویای او","هیچ عاشق حقیقی‌ای وجود ندارد که در پی وصال باشد، مگر آنکه معشوقش نیز او را جستجو کند و خواهان او باشد."],[498,"لیک عشق عاشقان تن زه کند","عشق معشوقان خوش و فربه کند","اما عشق عاشقان، آنها را لاغر و نحیف می‌کند، در حالی که عشق معشوقان، آنها را خوشحال و سرحال می‌سازد."],[498,"چون درین دل برق مهر دوست جست","اندر آن دل دوستی می‌دان که هست","اگر در دل شما جرقه‌ای از عشق دوست بیدار شود، بدان که در دل کسی که به او دوستی می‌ورزد، نیز محبتی وجود دارد."],[498,"در دل تو مهر حق چون شد دوتو","هست حق را بی گمانی مهر تو","در دل تو وقتی عشق و محبت خدا به وجود آمد، آن عشق هم به وجود دارد و در واقع محبتی که به خدا داری، نشانه ایمان توست."],[498,"هیچ بانگ کف زدن ناید بدر","از یکی دست تو بی دستی دگر","هیچ صدای کف زدن و شادمانی بدون وجود دستخوشی دیگر، به معنای همراهی و دوستی، نمی‌تواند به گوش برسد. در واقع، توجه به این مطلب است که در دوستی و همراهی است که شادی و نشاط واقعی به وجود می‌آید."],[498,"تشنه می‌نالد که ای آب گوار","آب هم نالد که کو آن آب‌خوار","تشنگی از شدت عطش ناله می‌کند و می‌گوید ای آب گوارا! و در عین حال آب نیز ناله می‌کند که کجاست آن کسی که مرا می‌خورد و نیازمند من است؟"],[498,"جذب آبست این عطش در جان ما","ما از آن او و او هم آن ما","عطش در وجود ما، ما را به سمت جذب آب می‌کشاند. ما متعلق به او (خدا) هستیم و او نیز متعلق به ماست."],[498,"حکمت حق در قضا و در قدر","کرد ما را عاشقان همدگر","حکمت و اراده خداوند در سرنوشت و تقدیر باعث شده که ما عاشقان به یکدیگر مرتبط و همدل باشیم."],[498,"جمله اجزای جهان زان حکم پیش","جفت جفت و عاشقان جفت خویش","تمام اجزای جهان طبق حکم الهی به یکدیگر مرتبط و جفت‌شده‌اند، و همچنین عاشقان نیز جفت یکدیگر هستند."],[498,"هست هر جزوی ز عالم جفت‌خواه","راست همچون کهربا و برگ کاه","هر جزئی از جهان تمایل به جفت پیدا کردن دارد، درست مانند خاصیت کهربا که برگ‌های کاه را به خود جذب می‌کند."],[498,"آسمان گوید زمین را مرحبا","با توم چون آهن و آهن‌ربا","آسمان به زمین می‌گوید خوش آمدی، زیرا مانند آهن و آهن‌ربا به هم متصل هستید و وجود یکدیگر را جذب می‌کنید."],[498,"آسمان مرد و زمین زن در خرد","هرچه آن انداخت این می‌پرورد","آسمان مانند مرد است و زمین مانند زن، و هرچه آسمان به زمین می‌دهد، زمین آن را پرورش می‌دهد."],[498,"چون نماند گرمیش بفرستد او","چون نماند تری و نم بدهد او","چون گرما و حرارت از بین برود، او یعنی زمین، حرارت را به سوی آسمان می‌فرستد و وقتی که رطوبت و تری نداشته باشد، از خود هم رطوبتی نمی‌دهد."],[498,"برج خاکی خاک ارضی را مدد","برج آبی تریش اندر دمد","برج زمین که از خاک و سنگ ساخته شده، به کمک برج آب، رطوبت و بخار را به سمت خود می‌کشد."],[498,"برج بادی ابر سوی او برد","تا بخارات وخم را بر کشد","ابر که به آن برج بادی اشاره دارد، بخارات و رطوبت زمین را به سوی او می‌برد، تا آن چیزهای سنگین و کدر را از زمین بلند کند و به آسمان برساند."],[498,"برج آتش گرمی خورشید ازو","همچو تابه سرخ ز آتش پشت و رو","برج آتش، به گرمای خورشید اشاره دارد که مانند تابه سرخ، هر دو طرفش از آتش داغ است. در اینجا، مولانا به شدت و تاثیر گرمای خورشید بر زمین و موجودات اشاره می‌کند."],[498,"هست سرگردان فلک اندر زمن","همچو مردان گرد مکسب بهر زن","جهان در حالی سرگردان است که مردان برای رسیدن به زن، مانند مشتاقان تجارت و کسب و کار در تلاش و کوشش هستند."],[498,"وین زمین کدبانویها می‌کند","بر ولادات و رضاعش می‌تند","این زمین مانند زنی است که کارهای خود را انجام می‌دهد و در مورد زایمان و شیر دادن نوزادان، کار و تلاش می‌کند."],[498,"پس زمین و چرخ را دان هوشمند","چونک کار هوشمندان می‌کنند","پس زمین و آسمان را بدان که هوشمند و آگاهند، چونکه کارهای خردمندان و باهوشان را انجام می‌دهند."],[498,"گر نه از هم این دو دلبر می‌مزند","پس چرا چون جفت در هم می‌خزند","اگر این دو دلبر (عشق و عقل) از یکدیگر جدا هستند، پس چرا مانند جفتی که در هم می‌خزد، با یکدیگر سر و کار دارند؟"],[498,"بی زمین کی گل بروید و ارغوان","پس چه زاید ز آب و تاب آسمان","بی‌زمینی، گل و ارغوان نمی‌روید، پس چه چیزی از آب و حالت آسمان به وجود می‌آید؟"],[498,"بهر آن میلست در ماده به نر","تا بود تکمیل کار همدگر","میل و کشش بین ماده و نر (زن و مرد) به این خاطر است که تا زمانی که این دو عنصر در کنار هم باشند، کار یکدیگر کامل شود و به کمال برسد."],[498,"میل اندر مرد و زن حق زان نهاد","تا بقا یابد جهان زین اتحاد","تمایل و عشق میان مرد و زن به فرمان حق قرار داده شده است تا از این اتحاد، جهان ادامه حیات یابد."],[498,"میل هر جزوی به جزوی هم نهد","ز اتحاد هر دو تولیدی زهد","میل و کشش هر چیزی به چیز دیگر به خاطر این اتحاد است که بین آن‌ها وجود دارد و از این اتحاد، چیزهای جدید به وجود می‌آید."],[498,"شب چنین با روز اندر اعتناق","مختلف در صورت اما اتفاق","شب و روز در ظاهر متفاوت و در تضاد هستند، اما در باطن، هر دو به یک حقیقت و معنا پیوند دارند و به هم تعلق دارند."],[498,"روز و شب ظاهر دو ضد و دشمنند","لیک هر دو یک حقیقت می‌تنند","روز و شب به ظاهر با یکدیگر متضاد و دشمن هستند، اما در حقیقت هر دو به یک اصل و واقعیت مرتبط هستند."],[498,"هر یکی خواهان دگر را همچو خویش","از پی تکمیل فعل و کار خویش","هر فردی مانند خود، به دنبال دیگری است تا فعالیّت و کارش را کامل کند."],[498,"زانک بی شب دخل نبود طبع را","پس چه اندر خرج آرد روزها","چون با صدای شب، طبیعت زندگی نمی‌کند، پس انسان روزها چگونه می‌تواند هزینه‌ها و مخارجش را تأمین کند؟"],[499,"خاک گوید خاک تن را باز گرد","ترک جان کن سوی ما آ همچو گرد","خاک به انسان می‌گوید که به تن خود برگرد و روح و جان را ترک کن و به سوی ما بیا، مانند غباری که از خاک برمی‌خیزد."],[499,"جنس مایی پیش ما اولیتری","به که زان تن وا رهی و زان تری","جنس ما (خاک) نزد ما اصل و ارجحیت دارد، تا اینکه از آن بدن جدا شوی و به سوی ما برگردی."],[499,"گوید آری لیک من پابسته‌ام","گرچه همچون تو ز هجران خسته‌ام","او می‌گوید که قبول دارم، اما من به کسی وابسته هستم و با وجود اینکه مانند تو از این جدایی رنج می‌برم، هنوز به آن چیز که وابسته‌ام متصل هستم."],[499,"تری تن را بجویند آبها","کای تری باز آ ز غربت سوی ما","آب‌ها به دنبال تری (رطوبت) تن هستند تا به آن برسند، زیرا تری به ما (انسان‌ها) از غربت و دوری خود برمی‌گردد."],[499,"گرمی تن را همی‌خواند اثیر","که ز ناری راه اصل خویش گیر","برخی از عناصر، مانند گرما، به طور طبیعی به سمت منابع خود جذب می‌شوند، همان‌طور که آتش به سمت آتش و ناری (حرارت) می‌خواهد برگردد به جایی که خود از آن آمده است."],[499,"هست هفتاد و دو علت در بدن","از کششهای عناصر بی رسن","در بدن انسان هفتاد و دو علت وجود دارد که به خاطر کشش‌های عناصر مختلف به هم مرتبط هستند، و این ارتباط بدون هیچ‌گونه ریسمانی یا رشته‌ای شکل گرفته است."],[499,"علت آید تا بدن را بسکلد","تا عناصر همدگر را وا هلد","علت باعث می‌شود که بدن به حالت سلامتی برسد و عناصر مختلف در بدن بتوانند یکدیگر را حمایت کنند و به هم نزدیک شوند."],[499,"چار مرغ‌اند این عناصر بسته‌پا","مرگ و رنجوری و علت پاگشا","این عناصر چهارگانه مانند مرغ‌هایی هستند که به خاطر مرگ و بیماری در یکدیگر محبوس شده‌اند و علت آن‌ها را آزاد می‌کند."],[499,"پایشان از همدگر چون باز کرد","مرغ هر عنصر یقین پرواز کرد","وقتی عناصر مختلف جسم انسان از یکدیگر جدا شوند، مانند پرندگان که از هم دور می‌شوند، هر عنصر به سمت عنصر مشابه خود پرواز می‌کند و به سوی جایگاه طبیعی‌اش می‌رود."],[499,"جذبه این اصلها و فرعها","هر دمی رنجی نهد در جسم ما","جذب و کشش بین اجزا و عناصر مختلف در بدن ما هر لحظه یک درد و رنجی به ما می‌دهد."],[499,"تا که این ترکیبها را بر درد","مرغ هر جزوی به اصل خود پرد","ترکیب‌های مختلفی که در وجود انسان وجود دارد، باید هر کدام را به‌سوی اصل و ماهیت واقعی خود سوق دهد و به درد و رنجی که انسان از این ترکیب‌ها می‌کشد، پایان دهد."],[499,"حکمت حق مانع آید زین عجل","جمعشان دارد بصحت تا اجل","حکمت خداوند باعث می‌شود که اجزای مختلف انسان نتوانند به‌سرعت و قبل از زمان مقرر، از هم جدا شوند و او در سلامت و تمامیت نگهداری شود تا زمانی که مرگ فرا برسد."],[499,"گوید ای اجزا اجل مشهود نیست","پر زدن پیش از اجلتان سود نیست","اجزای بدن انسان، ای شما، بدانید که مرگ و سرنوشت شما هنوز پنهان است و پرواز و رفتن قبل از زمان مرگتان فایده‌ای ندارد."],[499,"چونک هر جزوی بجوید ارتفاق","چون بود جان غریب اندر فراق","هر جزئی از آدمی در تلاش است تا به جایی که به آن تعلق دارد برسد و این تلاش در حالی است که جان انسان در حالت جدایی و فراق به سر می‌برد، یعنی او از اصل خود دور است و احساس غربت می‌کند."],[500,"گوید ای اجزای پست فرشیم","غربت من تلختر من عرشیم","شاعر به اجزای پست و ابتدایی خود یعنی جسم و تن می‌گوید که ما در این دنیا بیگانه‌ایم و دوری از معانی عالی و روحانی برای ما تلخ‌تر از هر چیز است، در حالی که ما در حقیقت از مقام بالاتر و عرش آسمانی آمده‌ایم."],[500,"میل تن در سبزه و آب روان","زان بود که اصل او آمد از آن","تمایل بدن به سبزه و آب روان به این خاطر است که ریشه و منشأ آن از همین عناصر طبیعی است."],[500,"میل جان اندر حیات و در حی است","زانک جان لامکان اصل وی است","تمایل روح به زندگی و حیات از این ناشی می‌شود که اصل روح در جایی نامحدود و فراتر از مکان‌ها قرار دارد."],[500,"میل جان در حکمتست و در علوم","میل تن در باغ و راغست و کروم","تمایل جان به یادگیری حکمت و کسب علوم است، در حالی که تمایل تن به لذت‌بردن از باغ و دشت و محصولات آن می‌باشد."],[500,"میل جان اندر ترقی و شرف","میل تن در کسب و اسباب علف","میل و خواسته‌ی جان در میل به ترقی و مقام عالی است، در حالی که میل و خواسته‌ی تن به تأمین نیازهای مادی و وسایل زندگی مربوط می‌شود."],[500,"میل و عشق آن شرف هم سوی جان","زین یحب را و یحبون را بدان","عشق و تمایل به کمال و مقام عالی، به سوی روح و جان انسان گرایش دارد؛ زیرا کسی که به چنین مقاماتی میل و عشق دارد، روح او نیز به آن سمت گرایش پیدا می‌کند."],[500,"حاصل آنک هر که او طالب بود","جان مطلوبش درو راغب بود","هر کسی که خواستار چیزی باشد، جان آن چیز نیز به او تمایل خواهد داشت و نسبت به او علاقه‌مند خواهد شد."],[500,"گر بگویم شرح این بی حد شود","مثنوی هشتاد تا کاغذ شود","اگر بخواهم توضیح دهم، این موضوع بسیار گسترده و طولانی خواهد شد و ممکن است چندین دفتر مثنوی را پر کند."],[500,"آدمی حیوان نباتی و جماد","هر مرادی عاشق هر بی‌مراد","آدمی، مانند موجودات زنده و بی‌جان، به چیزهایی که به او مرتبط نیستند هم عشق می‌ورزد و به دنبال خواسته‌ها و آرزوهایی است که هیچ‌گاه به آن‌ها نمی‌رسد."],[500,"بی‌مرادان بر مرادی می‌تنند","و آن مرادان جذب ایشان می‌کنند","بی‌مرادان (کسانی که چیزی را نمی‌خواهند) به کسانی که مراد دارند (یعنی خواسته‌ای دارند) نزدیک می‌شوند و آن کسانی که خواسته دارند، این بی‌مرادان را به خود جذب می‌کنند."],[500,"لیک میل عاشقان لاغر کند","میل معشوقان خوش و خوش‌فر کند","علاقه و کشش عاشقان می‌تواند آنها را رنجور و ضعیف کند، اما عشق معشوقان موجب شادی و نشاط آنها خواهد شد."],[500,"عشق معشوقان دو رخ افروخته","عشق عاشق جان او را سوخته","عشق معشوقان باعث می‌شود که چهره‌های آن‌ها شاداب و درخشان باشد، در حالی که عشق عاشق، جان او را می‌سوزاند و به شدت در درونش احساس سوزش و رنج ایجاد می‌کند."],[500,"کهربا عاشق به شکل بی‌نیاز","کاه می‌کوشد در آن راه دراز","عاشق مانند کهربا است که به صورت بی‌نیاز و مستقل در جستجوی معشوق است و به‌ خاطر علاقۀ شدید خود تلاش می‌کند تا در مسیر طولانی عشق پیش برود."],[500,"این رها کن عشق آن تشنه‌دهان","تافت اندر سینه صدر جهان","این عشق را رها کن، زیرا آن تشنه‌ دهانی که در سینه صدر جهان (یعنی در دل جهان) می‌تابد، ماشین و کاسه محبت و عشق را می‌طلبد."],[500,"دود آن عشق و غم آتش‌کده","رفته در مخدوم او مشفق شده","عشق و غم مانند دودی هستند که از آتش‌کده‌ای برمی‌خیزند و در حضور محترم و مهربان او کاملا ناپدید شده‌اند."],[500,"لیکش از ناموس و بوش و آب رو","شرم می‌آمد که وا جوید ازو","او از حرمت و بوی خوش و آب روی معشوق سر شرم داشت که نتواند از او دور شود."],[500,"رحمتش مشتاق آن مسکین شده","سلطنت زین لطف مانع آمده","عشق و رحمت الهی نسبت به انسان‌های بیچاره و محروم افزایش یافته است، و به خاطر این لطف و محبت، نعمت سلطنت و قدرت الهی نمی‌تواند خود را از آن‌ها دور سازد."],[500,"عقل حیران کین عجب او را کشید","یا کشش زان سو بدینجانب رسید","عقل در حیرت است که این شگفتی چه چیزی او را به سمت خود کشیده است، یا این که نیرویی از آن‌سوی عالم، او را به اینجا رسانده است."],[500,"ترک جلدی کن کزین ناواقفی","لب ببند الله اعلم بالخفی","تن یکنواخت و محدود خود را رها کن، زیرا از این نا آگاهی، سکوت کن. خداوند از رموز نهانی باخبرتر است."],[500,"این سخن را بعد ازین مدفون کنم","آن کشنده می‌کشد من چون کنم","من بعد از این، دیگر این صحبت‌ها را مخفی می‌کنم، چون آن کسی که جان را می‌کشد (یعنی خدا یا حقیقتی عظیم)، مرا در این حالت رها نمی‌کند."],[500,"کیست آن کت می‌کشد ای معتنی","آنک می‌نگذاردت کین دم زنی","کیست که تو را به طرف خود جلب می‌کند، ای کسی که با دقت و توجه زندگی می‌کنی؟ آن کسی که نمی‌گذارد تو در این دم (لحظه) از او دور شوی."],[500,"صد عزیمت می‌کنی بهر سفر","می‌کشاند مر ترا جای دگر","شما در زندگی بارها تصمیم می‌گیرید و به سفرهایی می‌روید، اما در واقع چیزی فراتر از جسم خاکی‌تان شما را به سمت مکان‌های دیگر و جهات مختلف می‌کشاند."],[500,"زان بگرداند به هر سو آن لگام","تا خبر یابد ز فارس اسپ خام","به کمک لگام اسب، او را به هر سمت می‌چرخاند تا بفهمد که آیا به سمت فارس می‌رود یا نه، چون اسب خام (بی‌تجربه) نیاز دارد تا جهت را بشناسد."],[500,"اسپ زیرکسار زان نیکو پیست","کو همی‌داند که فارس بر ویست","اسب زیرکشیده، که از لحاظ نژاد و اصل خوب است، می‌داند که فارس، که به معنای اصل و نسب خوب است، بر اوست و او را تحت نظر دارد."],[500,"او دلت را بر دو صد سودا ببست","بی‌مرادت کرد پس دل را شکست","دل تو را به خاطر دوصد آرزو و خواسته بسته است؛ پس وقتی چنین نشد و به مقصودت نرسی، دل تو را می‌شکند."],[500,"چون شکست او بال آن رای نخست","چون نشد هستی بال‌اشکن درست","زمانی که او، یعنی جان یا روح، نخستین حالت خود را از دست می‌دهد و دچار تزلزل می‌شود، دیگر نمی‌تواند به‌درستی نیرو و قدرت خود را حفظ کند و از آن بال شکسته، نمی‌تواند به‌خوبی استفاده کند."],[500,"چون قضایش حبل تدبیرت سکست","چون نشد بر تو قضای آن درست","زمانی که تقدیر و سرنوشت تو به سبب تدبیر الهی به بن‌بست می‌رسد، آن گاه قضای الهی بر تو به درستی و به موقع تحقق نمی‌یابد."],[501,"عزمها و قصدها در ماجرا","گاه گاهی راست می‌آید ترا","عزم‌ها و نیت‌های انسانی در زندگی گاهی به حقیقت می‌پیوندد و به هدف می‌رسد."],[501,"تا به طمع آن دلت نیت کند","بار دیگر نیتت را بشکند","خداوند با امیدواری دل تو را به نیت کردن تشویق می‌کند، ولی در آخر بار دیگر آن نیت را می‌شکند تا تو را به یاد بیاورد که اوست که بر تمامی امور تسلط دارد."],[501,"ور بکلی بی‌مرادت داشتی","دل شدی نومید امل کی کاشتی","اگر به طور کامل از خواسته‌ات ناامید شده‌ای، دیگر امید به خوبی نداشته باش و نباید در دل خود آرزوهایی بپرورانی."],[501,"ور بکاریدی امل از عوریش","کی شدی پیدا برو مقهوریش","اگر امیدی را به کار می‌گرفتی که از نقص آن (عور) ناشی شده بود، چگونه می‌توانستی به شکستگی (مقهور) خود اعتراف کنی؟"],[501,"عاشقان از بی‌مرادیهای خویش","باخبر گشتند از مولای خویش","عاشقان با ناامیدی‌های خود آشنا شدند و از مقام و حقیقت مولای خود آگاه شدند."],[501,"بی‌مرادی شد قلاوز بهشت","حفت الجنه شنو ای خوش سرشت","دوری از خواسته‌ها و ناامیدی، به مانند قلاوز (ایستادگی) در بهشت است. ای کسی که طبیعت نیکو و خوشی داری، به این نکته توجه کن که این حالت ناامیدی مانند حضور در بهشتی است که از آن دوری وجود دارد."],[501,"که مراداتت همه اشکسته‌پاست","پس کسی باشد که کام او رواست","آرزوها و خواسته‌هایت همگی در حال ناپایدار و از هم‌پاشیده‌اند، پس کسی وجود دارد که خواسته‌هایش به حقیقت پیوسته و موفق است."],[501,"پس شدند اشکسته‌اش آن صادقان","لیک کو خود آن شکست عاشقان","پس آن صادقان که دچار شکست شده‌اند، حالا چه کسی است که خود آن شکست را درست کند؟"],[501,"عاقلان اشکسته‌اش از اضطرار","عاشقان اشکسته با صد اختیار","عاقلان بر اثر ناچاری به مسیر شکست و ناتوانی کشیده شده‌اند، در حالی که عاشقان از روی انتخاب و اراده خود، به این حال نائل آمده‌اند."],[501,"عاقلانش بندگان بندی‌اند","عاشقانش شکری و قندی‌اند","عاقلان در عشق همچون بندگان به بند و زنجیر هستند، اما عاشقان مانند شکری و قند شیرین و دلپذیرند."],[501,"ائتیا کرها مهار عاقلان","ائتیا طوعا بهار بی‌دلان","عاقلان با اختیار و تصمیم خود به سوی خود می‌آیند، اما دلدادگان و بی‌خودان به زور و بی‌اختیار به سمت او می‌روند."],[502,"دید پیغامبر یکی جوقی اسیر","که همی‌بردند و ایشان در نفیر","پیامبر اسلام (ص) گروهی اسیر را دید که آن‌ها را به سمت خود می‌بردند و آن‌ها در حال ناله و فریاد بودند."],[502,"دیدشان در بند آن آگاه شیر","می نظر کردند در وی زیر زیر","پیامبر اکرم برخی از اسیرانی را که در بند بودند دید و در چهره آنان به خوبی فهمید که چه حالتی دارند. او با نگاهی عمیق و توجهی خاص به آنان نگریست."],[502,"تا همی خایید هر یک از غضب","بر رسول صدق دندانها و لب","هر یک از اسیران به خاطر خشم و کینه‌ای که از پیامبر دارند، دندان‌ها و لب‌های خود را به نشانه‌ی عصبانیت به هم می فشارند و در واقع، در دل خود خشم و کینه نسبت به او دارند."],[502,"زهره نه با آن غضب که دم زنند","زانک در زنجیر قهر ده‌منند","غضب کسانی که در زنجیرند و به قهر کشیده می‌شوند، کمترین باکی ندارد؛ زیرا در این حال، حتی زبان هم نمی‌زنند و به شدت تحت فشار و خفقان قرار دارند."],[502,"می‌کشاندشان موکل سوی شهر","می‌برد از کافرستانشان به قهر","فرشتۀ موکل به زور و به‌اجبار آنها را به سمت شهر (بهشت) می‌برد و از سرزمین کافران به سختی و خشم خارجشان می‌کند."],[502,"نه فدایی می‌ستاند نه زری","نه شفاعت می‌رسد از سروری","پیامبر (ص) نه به خاطر فدایی و نه به خاطر زرو (گنج و ثروت) و نه به واسطه شفاعت و کمک سرور و بزرگی، کسی را نمی‌گیرد."],[502,"رحمت عالم همی‌گویند و او","عالمی را می‌برد حلق و گلو","رحمت و mercy خداوند در رابطه با پیامبر (رحمت العالمین) دائم گفته می‌شود، اما در عین حال او (پیامبر) برخی از مردم را به زور و با زنجیر و غل و زنجیر به سمت بهشت می‌برد."],[502,"با هزار انکار می‌رفتند راه","زیر لب طعنه‌زنان بر کار شاه","با هزار انکار و اعتراض به سمت مقصد می‌رفتند، در حالی که زیر لب به کارهای شاه (دولت یا حاکم) طعنه می‌زدند."],[502,"چاره‌ها کردیم و اینجا چاره نیست","خود دل این مرد کم از خاره نیست","ما به اندازه کافی تدبیر و فکر کردیم، اما در این موقعیت راه حلی وجود ندارد. خود دل این مرد (اشاره به حال و وضعیت و دل‌تنگی او) هیچ فرقی با خار و دردهای دیگر ندارد."],[502,"ما هزاران مرد شیر الپ ارسلان","با دو سه عریان سست نیم‌جان","ما هزاران مرد شجاع همچون شیر داریم، اما با دو یا سه نفر عریان و ناتوان مواجه‌ایم که حال و روزشان خوب نیست."],[502,"این چنین درمانده‌ایم از کژرویست","یا ز اخترهاست یا خود جادویست","ما به این اندازه درمانده و گرفتار شده‌ایم، دلیل آن ممکن است نادرستی راه ما باشد، یا این‌که به خاطر ستاره‌های بد، یا حتی ممکن است جادو و سحر در کار باشد."],[502,"بخت ما را بر درید آن بخت او","تخت ما شد سرنگون از تخت او","بخت و تقدیر ما را از هم جدا کرد و باعث شد که مقام و جایگاه‌مان خراب شود، در حالی که بخت و تقدیر او باعث موفقیت و بلندپروازی‌اش گردید."],[502,"کار او از جادوی گر گشت زفت","جادوی کردیم ما هم چون نرفت","اگر کار پیامبر، که خود از قدرتی الهی برخوردار است، به نوعی جادو باشد که بر دل‌ها تأثیر می‌گذارد، ما نیز با بهره‌گیری از آن تأثیر، به شکلی مشابه عمل کردیم و از قدرت او بهره بردیم."],[503,"از بتان و از خدا در خواستیم","که بکن ما را اگر ناراستیم","از بت‌ها و خداوند خواسته‌ایم که اگر ما ناحق هستیم، ما را به نتیجه نرسانند."],[503,"آنک حق و راستست از ما و او","نصرتش ده نصرت او را بجو","شما می‌گفتید که حق و راست زیستن فقط از ما و محمد است، بنابراین از خدا بخواهید که او را یاری کند و در جستجوی یاری او باشید."],[503,"این دعا بسیار کردیم و صلات","پیش لات و پیش عزی و منات","این دعاهای زیادی که پیش از این، ما در برابر لات (یکی از خدایان عرب)، عزی و منات (دو خدای دیگر) کرده‌ایم، نشانه ناپاکی و انحراف ما از مسیر حق است."],[503,"که اگر حقست او پیداش کن","ور نباشد حق زبون ماش کن","اگر حق، وجود دارد، آن را آشکار کن، و اگر حق نیست، ما را در زبونی و ناتوانی قرار بده."],[503,"چونک وا دیدیم او منصور بود","ما همه ظلمت بدیم او نور بود","وقتی دیدیم که محمد پیروز و موفق است، متوجه شدیم که ما در تاریکی هستیم و او در روشنی و حقیقت قرار دارد."],[503,"این جواب ماست کانچ خواستید","گشت پیدا که شما ناراستید","این پاسخ ماست که آنچه را خواستید، آشکار شد؛ زیرا شما حقیقت را نمی‌خواهید و در پی آن نیستید."],[503,"باز این اندیشه را از فکر خویش","کور می‌کردند و دفع از ذکر خویش","آنها به‌جای توجه به حقائق و ذکر الهی، از افکار خودشان دور و بی‌خبر بودند و این تفکر غلط، موجب می‌شد که از یاد خدا و حقایق راستین باز بمانند."],[503,"کین تفکرمان هم از ادبار رست","که صواب او شود در دل درست","این تفکر ما که از بدبختی رهایی یافته، به درستی در دل ما جا گرفته است."],[503,"خود چه شد گر غالب آمد چند بار","هر کسی را غالب آرد روزگار","اگر کسی در زندگی چندین بار پیروز شود، چه اهمیتی دارد؟ زیرا این روزگار است که هرکس را به موفقیت می‌رساند و ممکن است هر لحظه تغییر کند."],[503,"ما هم از ایام بخت‌آور شدیم","بارها بر وی مظفر آمدیم","ما نیز در روزهای خوشی و شانس پیروز شدیم و بارها در برابر او موفقیت‌آمیز ظاهر شدیم."],[503,"باز گفتندی که گرچه او شکست","چون شکست ما نبود آن زشت و پست","این بیت اشاره به این دارد که عده‌ای می‌گویند اگرچه محمد (ص) نیز شکست خورده، اما شکست او با شکست ما متفاوت است و از نظر آنان، شکست او زشت و پست است. این افراد سعی دارند تا اهمیت و مقام محمد (ص) را کم‌ارزش جلوه دهند."],[503,"زانک بخت نیک او را در شکست","داد صد شادی پنهان زیردست","چون بخت نیک محمد (ص) در شکست او را یاری کرد، در واقع در دل او شادی‌های پنهانی وجود داشت که ناشناخته مانده است."],[503,"کو باشکسته نمی‌مانست هیچ","که نه غم بودش در آن نه پیچ پیچ","کسی که در شکست نمی‌ماند، هیچ غمی ندارد و هیچ رنج و تلخی را احساس نمی‌کند."],[503,"چون نشان مؤمنان مغلوبیست","لیک در اشکست مؤمن خوبیست","مؤمنان در ظاهر شکست‌خورده و مغلوب به نظر می‌رسند، اما در دل خود، ایمان و خوبی را دارند که از باطن آن‌ها جلوه‌گر می‌شود."],[503,"گر تو مشک و عنبری را بشکنی","عالمی از فوح ریحان پر کنی","اگر تو مشک و عنبر (دو عطر گران‌بها) را بشکنی، دنیا را از بوی خوش ریحان (گلابی معطر) پر خواهید کرد."],[503,"ور شکستی ناگهان سرگین خر","خانه‌ها پر گند گردد تا به سر","اگر ناگهان سرگین خر را بشکنی، خانه‌ها پر از بوی ناخوشایند خواهد شد. این تصویر به این معناست که اگر چیزی ناخوشایند یا زشت به صورت ناگهانی اتفاق بیفتد، عواقب و اثرات آن به شدت محسوس و آزاردهنده می‌شود."],[503,"وقت واگشت حدیبیه بذل","دولت انا فتحنا زد دهل","در زمان برگرداندن از حدیبیه، خداوند دولتی را عطا کرد که به صدا درآوردند و از آن به عنوان فتح (پیروزی) یاد کردند."],[504,"آمدش پیغام از دولت که رو","تو ز منع این ظفر غمگین مشو","پیام از سوی خدا به رسول (صلى الله علیه وسلم) رسید که تو از این پیروزی که در ظاهر منع شده‌ای، ناامید نباش."],[504,"کاندرین خواری نقدت فتحهاست","نک فلان قلعه فلان بقعه تراست","این در بی‌احترامی و سختی که تو به آن برخورده‌ای، در واقع پیروزی به شمار می‌آید؛ زیرا پیروزی حقیقی چیزی نیست که به یک قلعه یا مکان خاص مربوط شود، بلکه از آن توست و در باطن، چیزی بزرگ‌تر را در پی دارد."],[504,"بنگر آخر چونک واگردید تفت","بر قریظه و بر نضیر از وی چه رفت","پس از بازگشت رسول خدا از حدیبیه به قریظه و نضیر، نگاهی کن به آنچه بر سر آنها آمد و چه بلایی بر سرشان نازل شد."],[504,"قلعه‌ها هم گرد آن دو بقعه‌ها","شد مسلم وز غنایم نفعها","محل اقامت مسلمانان به دو نقطه خاص اطراف خود احاطه شد و از غنائم حاصل‌ شده نیز بهره‌مند شدند."],[504,"ور نباشد آن تو بنگر کین فریق","پر غم و رنجند و مفتون و عشیق","اگر آن که دوست داری نباشد، بنگر که این گروه چقدر در غم و رنج هستند و چطور مجنون و عاشق‌اند."],[504,"زهر خواری را چو شکر می‌خورند","خار غمها را چو اشتر می‌چرند","آنها به جای اینکه از رنج و محرومیت خود ناراحت باشند، این دردها را خوشایند و شیرین می‌پندارند، و غم‌هایشان را مثل علفی که شتر می‌خورد، به راحتی می‌پذیرند و تحمل می‌کنند."],[504,"بهر عین غم نه از بهر فرج","این تسافل پیش ایشان چون درج","این بیت به این معناست که برخی افراد تنها به خاطر غم و اندوه خود، به حالتی از تواضع و خضوع می‌رسند و این حالت را از خود نمی‌خواهند برگردانند، بلکه به نوعی به آن عادت کرده‌اند، حال آنکه این خضوع و روند صعودی باید به خاطر رهایی و خوشحالی باشد، نه تنها به خاطر غم."],[504,"آنچنان شادند اندر قعر چاه","که همی‌ترسند از تخت و کلاه","افراد در عمیق‌ترین ناراحتی‌ها و مشکلات زندگی (قعر چاه) به قدری خوشحال و شاد هستند که از مقام‌ها و ظواهر دنیوی (تخت و کلاه) ترسی ندارند."],[504,"هر کجا دلبر بود خود همنشین","فوق گردونست نه زیر زمین","هر جا که محبوب و معشوق حضور دارد، آن مکان به درجه‌ای رفیع و بالاست که هم‌نشینی با او از جاهای پایین‌تر و دنیوی بهتر و ارزشمندتر است."],[505,"گفت پیغامبر که معراج مرا","نیست بر معراج یونس اجتبا","پیامبر فرمود که مقام من در معراج، با مقام یونس بن متی قابل مقایسه نیست، زیرا یونس به مقام بالایی از انتخاب و ارادت دست یافته است که آن را در معراج من نمی‌توان یافت."],[505,"آن من بر چرخ و آن او نشیب","زانک قرب حق برونست از حسیب","مقصود مولانا این است که در حالی که من (پیامبر) در آسمان‌ها (چرخ) هستم و یونس در دنیا (نشیب) است، اما نزدیکی به خداوند تنها به واسطه رهایی از قید و بندهای مادی قابل دستیابی است، نه به خاطر مقام و مرتبه."],[505,"قرب نه بالا نه پستی رفتنست","قرب حق از حبس هستی رستنست","نزدیکی به حق نه به معنای بالا رفتن یا پایین رفتن است، بلکه این نزدیکی از آزادی و رهایی از قید و بندهای هستی حاصل می‌شود."],[505,"نیست را چه جای بالا است و زیر","نیست را نه زود و نه دورست و دیر","وجودی که در عالم نیستی است، نه بالا و نه پایین دارد و این وجود نه به سرعت از بین می‌رود و نه به آرامی می‌ماند. در حقیقت، نیستی دارای مفهومی فراتر از مقیاس‌های زمانی و مکانی است."],[505,"کارگاه و گنج حق در نیستیست","غره هستی چه دانی نیست چیست","حقایق و معانی عمیق در جایی که به ظاهر چیزی وجود ندارد، نهفته است. دلبستگی به وجود و هستی، انسان را از درک حقیقت واقعی هستی، که همان «نیستی» است، باز می‌دارد."],[505,"حاصل این اشکست ایشان ای کیا","می‌نماند هیچ با اشکست ما","حاصل این شکست، یعنی نتیجه این بی‌نظمی و ناکامی، ای کیا (یکی از یاران)، چه چیزی باقی نمی‌ماند در برابر شکست ما؟"],[505,"آنچنان شادند در ذل و تلف","همچو ما در وقت اقبال و شرف","افرادی که در حاشیه و در ذلت و سختی هستند، به اندازه ما که در زمان پادشاهی و عزت شادیم، شاد و خوشحال‌اند."],[505,"برگ بی‌برگی همه اقطاع اوست","فقر و خواریش افتخارست و علوست","تمامی نقاط وجود او، بدون برگ و زینت، به فقر و ذلتش تعلق دارد و این حالتی که دارد، برای او مایه‌ی افتخار و برتری است."],[505,"آن یکی گفت ار چنانست آن ندید","چون بخندید او که ما را بسته دید","یکی گفت اگر یونس بن متی چنین حالتی دارد و از غم و اندوهی که در قید و بند بوده، در حال شادی است، پس آیا او (یونس) به حقیقت آنچه را که ما گرفتار آنیم نمی‌بیند و نمی‌فهمد؟"],[505,"چونک او مبدل شدست و شادیش","نیست زین زندان و زین آزادیش","او (یونس بن متی) که در شرایط سخت زندان قرار داشت، دیگر از شادیش خبری نیست، چرا که آزادی‌اش از زندان نیز نتوانسته او را خوشحال کند و تبدیل به یک انسان جدید نشده است."],[505,"پس به قهر دشمنان چون شاد شد","چون ازین فتح و ظفر پر باد شد","حضرت یونس در مقابل دشمنانش شاد و خوشحال می‌شود زیرا از این پیروزی و موفقیت احساس غرور و نشو و نما می‌کند."],[505,"شاد شد جانش که بر شیران نر","یافت آسان نصرت و دست و ظفر","جانش از اینکه بر شیران نر (دشمنان قوی) پیروز شد و نصرت و دستیابی به موفقیت را به آسانی به دست آورد، شاد شد."],[505,"پس بدانستیم کو آزاد نیست","جز به دنیا دلخوش و دلشاد نیست","از این بیت می‌فهمیم که کسی که آزاد نیست، تنها به همین دنیا دلخوش و شاداب است و از دنیای معنوی و آزادی حقیقی بی‌بهره است."],[505,"ورنه چون خندد که اهل آن جهان","بر بد و نیک‌اند مشفق مهربان","اگر اهل آن جهان به خوبی‌ها و بدی‌ها توجه داشته و مهربان باشند، پس چگونه کسی می‌تواند بخندد یا شاد باشد؟"],[505,"این بمنگیدند در زیر زبان","آن اسیران با هم اندر بحث آن","این بند به گفتگو و بحث اسیرانی اشاره دارد که در زیر زبان خود، در مورد موضوعاتی صحبت می‌کنند. کلمه «بمنگیدند» به معنای پنهان کاری یا نگفتن چیزی است. اسیران به نوعی در حال تبادل نظر یا درگیر در یک بحث هستند."],[505,"تا موکل نشنود بر ما جهد","خود سخن در گوش آن سلطان برد","اگر موکل و نگهبان نشنود، ما تمام تلاش خود را برای گرفتن سخن در گوش آن سلطان می‌کنیم."],[506,"گرچه نشنید آن موکل آن سخن","رفت در گوشی که آن بد من لدن","هرچند آن نگهبان (موکل) سخن بد شما را نشنید، اما این حرف در دل او رفت و اندیشه‌اش را مشغول کرد."],[506,"بوی پیراهان یوسف را ندید","آنک حافظ بود و یعقوبش کشید","یعقوب، پدر یوسف، به شدت به یاد بوی پیراهن یوسف است که حافظ (مراقب) او نمی‌تواند آن را ببیند و احساس کند. این نشان می‌دهد که یعقوب با وجود دوری از یوسف، همچنان درگیر یاد و خاطره اوست."],[506,"آن شیاطین بر عنان آسمان","نشنوند آن سر لوح غیب‌دان","شیاطین و نیروهای شیطانی نمی‌توانند بر عرش آسمان دسترسی پیدا کنند و از علم و دانایی خداوند که در لوح محفوظ است، آگاهی یابند."],[506,"آن محمد خفته و تکیه زده","آمده سر گرد او گردان شده","محمد (پیامبر اسلام) در حالتی آرام و با اطمینان، در کنار مردم نشسته و در فضایی قرار دارد که همه چیز دور او را گرفته و به او توجه دارند."],[506,"او خورد حلوا که روزیشست باز","آن نه کانگشتان او باشد دراز","پیامبر (محمد) با وجود اینکه به آرامی نشسته است، همچنان از زرنگی و هوش خود بهره می‌برد و این‌گونه نشان می‌دهد که او در دنیا نیازی به مال و ثروت ندارد. \"حلوا\" نماد نعمت‌ها و برکت‌هایی است که به او داده شده، و \"کفگیران\" اشاره به دستیابی او به علوم و معارف دارد، نه به وسیله دزدی یا بدست آوردن ناروایی."],[506,"نجم ثاقب گشته حارس دیوران","که بهل دزدی ز احمد سر ستان","ستاره‌ای درخشان و پرنور، در نگهبانی از جهان ظاهر شده که به زودی دزدی از أحمد (پیامبر اسلام) را متوقف خواهد کرد."],[506,"ای دویده سوی دکان از پگاه","هین به مسجد رو بجو رزق اله","ای کسی که از صبح زود به سمت دکانی رفته‌ای، حالا به مسجد برو و روزی الهی را جستجو کن."],[506,"پس رسول آن گفتشان را فهم کرد","گفت آن خنده نبودم از نبرد","پیامبر (علیه‌السلام) متوجه شد که آنها به او طعنه می‌زنند و به او خندیده‌اند و گفت که آن خنده به خاطر جنگ و مبارزه نبوده است."],[506,"مرده‌اند ایشان و پوسیده فنا","مرده کشتن نیست مردی پیش ما","این بیت به این معناست که کسانی که به مرگ و فنا دچار شده‌اند، واقعا مرده‌اند و دیگر برای ما اثری از آنها نیست. از این رو، کشتن کسی که دیگر حیات ندارد، به معنای واقعی مردانگی نیست و این کار بر عهده‌ی ما نیست."],[506,"خود کیند ایشان که مه گردد شکاف","چونک من پا بفشرم اندر مصاف","این بیت بیان می‌کند که اگر من (پیامبر) در میدان نبرد پا بگذارم و با عزم و اراده عمل کنم، چه کسی می‌تواند بر من غلبه کند و مانند ماه درخشان شود. می‌توان به این نکته اشاره کرد که اعتماد به نفس و قدرت شخصی به مبارزات و چالش‌ها بستگی دارد."],[506,"آنگهی کآزاد بودیت و مکین","مر شما را بسته می‌دیدم چنین","آنگاه که شما آزاد و رها بودید، من شما را در حالتی می‌دیدم که در بند و اسیر بودید."],[506,"ای بنازیده به ملک و خاندان","نزد عاقل اشتری بر ناودان","ای کسی که به دلیل خانواده و مقام خود مورد ستایش قرار گرفته‌ای، در نظر حکیم و عاقل، مانند الاغی هستی که بر روی سقف (ناودان) ایستاده است."],[506,"نقش تن را تا فتاد از بام طشت","پیش چشمم کل آت آت گشت","وقتی که بدن از بام به زمین افتاد، مانند تشت که صدا می‌دهد، تمام وجودم پر از آتش و شعله شد."],[506,"بنگرم در غوره می بینم عیان","بنگرم در نیست شی بینم عیان","وقتی به غوره نگاه می‌کنم، به روشنی می‌بینم که در آن چیزی هست. اما وقتی به «نیست» نگاه می‌کنم، باز هم به وضوح می‌بینم که در آن چیزی وجود دارد."],[506,"بنگرم سر عالمی بینم نهان","آدم و حوا نرسته از جهان","در نگاه من، در عالمی که پنهان است، آدم و حوا دیده نمی‌شوند و از دنیای خود خارج نشده‌اند."],[506,"مر شما را وقت ذرات الست","دیده‌ام پا بسته و منکوس و پست","من در زمان ولادت شما، وقتی که روح شما هنوز در عالم ذر (عالم روحانی) بود، شما را دیدم که در حالتی ضعیف و عاجز و در موقعیتی پست قرار داشتید."],[506,"از حدوث آسمان بی عمد","آنچ دانسته بدم افزون نشد","از این که آسمان بدون دلیلی پدید آمده، آن‌چه که می‌دانستم، چیزی بیشتر از این نیست."],[506,"من شما را سرنگون می‌دیده‌ام","پیش از آن کز آب و گل بالیده‌ام","من قبلا شما را در حالت ضعف و ذلت می‌دیدم، قبل از اینکه از آب و گل (آفرینش) بالنده و رشد یافته شوم."],[506,"نو ندیدم تا کنم شادی بدان","این همی‌دیدم در آن اقبالتان","هیچ شادی تازه‌ای نمی‌بینم که باعث خوشحالی‌ام شود، تنها چیزی که می‌بینم نیکی‌های شما در آینده است که باعث خوشبختی‌تان خواهد شد."],[506,"بسته قهر خفی وانگه چه قهر","قند می‌خوردید و در وی درج زهر","اگرچه بسته‌ای از قهر دارید و در دل‌تان خشم و کینه وجود دارد، چرا بر قند و شیرینی محبت می‌آشامید، در حالی که در آن شیرینی زهر نهفته است؟"],[506,"این چنین قندی پر از زهر ار عدو","خوش بنوشد چت حسد آید برو","اگر دشمنی چنین قندی که پر از زهر است را خوش بخورد، نشان می‌دهد که حسادت به او می‌آید."],[506,"با نشاط آن زهر می‌کردید نوش","مرگتان خفیه گرفته هر دو گوش","شما با شوق زهر را می‌نوشیدید، در حالی که مرگ شما پنهان در گوش‌تان نهفته است و این به خاطر غیبت و طعنه‌هایی است که به شما می‌شود."],[506,"من نمی‌کردم غزا از بهر آن","تا ظفر یابم فرو گیرم جهان","من به خاطر به دست آوردن پیروزی در جنگ اقدام نمی‌کردم تا دنیا را به دست آورم."],[506,"کین جهان جیفه‌ست و مردار و رخیص","بر چنین مردار چون باشم حریص","این دنیا مانند زباله و پوسیده است و من هرگز به چنین چیزهای مرده و پستی، عیاش نخواهم بود."],[506,"سگ نیم تا پرچم مرده کنم","عیسی‌ام آیم که تا زنده‌ش کنم","من می‌خواهم با اقداماتی که انجام می‌دهم، به یاری عیسی(ع) برسم و با او به زندگی دوباره بازگردم. در اینجا، منظور از \"سگ\" نوعی تواضع و بی‌پروایی است که در کنار عیسی(ع) خواهان حیات و زنده شدن هستم."],[506,"زان همی‌کردم صفوف جنگ چاک","تا رهانم مر شما را از هلاک","من با تلاش برای شکست صفوف دشمن می‌کوشم تا شما را از نابودی نجات دهم."],[506,"زان نمی‌برم گلوهای بشر","تا مرا باشد کر و فر و حشر","من انسان‌ها را به خاطر خودم و به خاطر نجات خودم از عذاب و سختی‌ها نمی‌کشم، زیرا باید در روز قیامت و رستاخیز، در برابر آن‌ها پاسخگو باشم."],[506,"زان همی‌برم گلویی چند تا","زان گلوها عالمی یابد رها","از آنچه گفته شد، من چندین گلو را می‌برم تا از آن گل‌ها جهانی آزاد و رها به وجود آید."],[506,"که شما پروانه‌وار از جهل خویش","پیش آتش می‌کنید این حمله کیش","شما مانند پروانه‌ها به خاطر نادانی خود به سوی آتش می‌روید و این رفتار، حمله‌ای به دین و آیین شماست."],[506,"من همی‌رانم شما را همچو مست","از در افتادن در آتش با دو دست","من شما را مانند کسی که مست است و نمی‌تواند کنترل خود را داشته باشد، به جلو می‌رانم، انگار که در حال افتادن به درون آتش هستید و با دستان خود به آن سمت می‌روید."],[506,"آنک خود را فتحها پنداشتید","تخم منحوسی خود می‌کاشتید","شما که خود را به پیروزی‌ها و پیشرفت‌های بزرگ می‌نگرید، در واقع در حال کاشتن زشتی برای خود هستید و به آینده‌ای بدتر نزدیک می‌شوید."],[506,"یکدگر را جد جد می‌خواندید","سوی اژدرها فرس می‌راندید","شما به جای اینکه به یکدیگر نزدیک شوید و متحد شوید، هر کدام به تنهایی خود را جدا از دیگری می‌دانستید و با رفتارهای خود به سوی خطرات بزرگ می‌رفتید."],[506,"قهر می‌کردید و اندر عین قهر","خود شما مقهور قهر شیر دهر","شما در حال قهر و خشم بودید، اما در عین حال، خودتان نیز در برابر قهر و خشم بزرگان زمانه تحت تأثیر و تسلط قرار داشتید."],[507,"دزد قهرخواجه کرد و زر کشید","او بدان مشغول خود والی رسید","دزد تحت فشار و قهر خواجه (حاکم) طلا و زر را دزدید و در حال سرقت مشغول بود که والی (بازرس یا مقام مسئولی) به او رسید."],[507,"گر ز خواجه آن زمان بگریختی","کی برو والی حشر انگیختی","اگر در آن زمان از خواجه فرار می‌کردی، آیا در آن صورت والی (حاکم یا فرمانده) تو را به محاکمه نمی‌کشاند؟"],[507,"قاهری دزد مقهوریش بود","زانک قهر او سر او را ربود","دزد قدرتمندی که به ظاهر قاهر و تسلط دارد، در واقع مقهور و تحت کنترل است، زیرا قدرت او سرنوشت و اختیار او را از او گرفته است."],[507,"غالبی بر خواجه دام او شود","تا رسد والی و بستاند قود","غالب بودن بر دیگران باعث می‌شود که مردمان مهم و توانمند نیز در دام او بیفتند و در نتیجه حاکم و والی از او بهره‌برداری کند و به آسانی مهار او را در دست بگیرد."],[507,"ای که تو بر خلق چیره گشته‌ای","در نبرد و غالبی آغشته‌ای","ای کسی که در برابر مردم پیروز شده‌ای و در میدان جنگ برتری یافته‌ای،"],[507,"آن به قاصد منهزم کردستشان","تا ترا در حلقه می‌آرد کشان","کسی که در ظاهر بر دیگران چیره شده، در باطن به وسیله قاصدی که از شکست‌خوردگان می‌سازد، به سمت تو می‌کشدشان و در حلقه رفاقت با تو می‌آورد."],[507,"هین عنان در کش پی این منهزم","در مران تا تو نگردی منخزم","به سرعت بابا، مهار این شکست‌خورده را رها نکن و او را نرسان به سرنوشت بد، تا خودت به زانو درنیایی و ضعیف نشوی."],[507,"چون کشانیدت بدین شیوه به دام","حمله بینی بعد از آن اندر زحام","وقتی که تو را به این شیوه به دام می‌اندازند و به تله حمله می‌برند، بعد از آن در میان شلوغی و آشفتگی قرار می‌گیری."],[507,"عقل ازین غالب شدن کی گشت شاد","چون درین غالب شدن دید او فساد","عقل به خاطر پیروزی و تسلطی که به دست آورده، خوشحال نمی‌شود؛ زیرا در این پیروزی فساد و ناپسندی را می‌بیند."],[507,"تیزچشم آمد خرد بینای پیش","که خدایش سرمه کرد از کحل خویش","خرد، که از دید تیز و بینایی برخوردار است، در واقع به وسیله قدرت و زیبایی الهی (خداوند) که مانند سرمه‌ را به چشم خود می‌مالد، به روشنایی و آگاهی می‌رسد."],[507,"گفت پیغامبر که هستند از فنون","اهل جنت در خصومتها زبون","پیامبر (ص) فرمودند که اهل بهشت در رقابت‌ها و نزاع‌ها از آنچه که از فنون و مهارت‌هایشان می‌باشد، ضعیف و زبون هستند."],[507,"از کمال حزم و سؤ الظن خویش","نه ز نقص و بد دلی و ضعف کیش","تنها به خاطر احتیاط و بدگمانی خود انسان است که در برابر کمالات دیگران واکنش نشان می‌دهد، نه به دلیل کمبود یا ضعف در ایمان و وصف اخلاقی خود."],[507,"در فره دادن شنیده در کمون","حکمت لولا رجال مومنون","در پروردن و آفرینش، حکمت نهفته است و این حکمت به واسطه مردان مؤمن به ظهور می‌رسد."],[507,"دست‌کوتاهی ز کفار لعین","فرض شد بهر خلاص مؤمنین","ضعف و ناتوانی کفار بدکردار به عنوان دلیلی برای نجات مؤمنان به شمار می‌رود."],[507,"قصه عهد حدیبیه بخوان","کف ایدیکم تمامت زان بدان","قصه صلح حدیبیه را بخوانید، که در آن دست شما در عین قدرت، از همه‌چیز کوتاه بود. این نشان می‌دهد که ممکن است در ظاهری سخت، در واقعیت ناتوانی وجود داشته باشد."],[507,"نیز اندر غالبی هم خویش را","دید او مغلوب دام کبریا","در حالتی که انسان در موقعیت غالب و پیروز قرار دارد، باز هم خود را در برابر بزرگ‌ترین قدرت، یعنی کبریا (عظمت و قدرت خداوند) مغلوب می‌بیند."],[507,"زان نمی‌خندم من از زنجیرتان","که بکردم ناگهان شبگیرتان","من از زنجیرها و محدودیت‌های شما نمی‌خندم، چون ناگهان در شب به شما حمله کردم و کاری کردم که نتوانید فرار کنید."],[507,"زان همی‌خندم که با زنجیر و غل","می‌کشمتان سوی سروستان و گل","من به خاطر این که شما به زنجیر و غل کشیده شده‌اید، می‌خندم؛ زیرا با وجود این وضعیت، شما را به سمت باغ‌ها و گل‌های زیبا می‌برم."],[507,"ای عجب کز آتش بی‌زینهار","بسته می‌آریمتان تا سبزه‌زار","عجیب است که شما را از میان آتش بی‌خطر به سوی سبزه‌زار می‌برم."],[507,"از سوی دوزخ به زنجیر گران","می‌کشمتان تا بهشت جاودان","از طرف جهنم، شما را با زنجیر سنگین می‌آورم تا به بهشت ابدی برسانم."],[507,"هر مقلد را درین ره نیک و بد","همچنان بسته به حضرت می‌کشد","هر کسی که تقلید می‌کند، در این مسیر نیک و بد، به سویی کشیده می‌شود که به حضور و مقام الهی وصل می‌شود."],[507,"جمله در زنجیر بیم و ابتلا","می‌روند این ره بغیر اولیا","همه انسان‌ها در زنجیر نگرانی و آزمایش می‌گذرانند، اما فقط افرادی که به مقام اولیاء (مردان خدا) دست یافته‌اند، می‌توانند به درستی این راه را طی کنند."],[507,"می‌کشند این راه را بیگاروار","جز کسانی واقف از اسرار کار","این راه را تنها افرادی طی می‌کنند که در خواب و بی‌خبرند و از اسرار آن آگاه نیستند، و دیگران که به این اسرار پی برده‌اند، نمی‌توانند همچون بیگاری‌گران آن را بگذرانند."],[507,"جهد کن تا نور تو رخشان شود","تا سلوک و خدمتت آسان شود","سعی کن تا نور وجودت روشن و تابان شود، تا مسیر رشد و خدمت به دیگران برایت آسان گردد."],[507,"کودکان را می‌بری مکتب به زور","زانک هستند از فواید چشم‌کور","کودکانی را که نمی‌خواهند به مدرسه بروند، به زور به مکتب می‌بری؛ زیرا آن‌ها از فوائد آموزش، برایشان ناآگاه و نابینا هستند."],[507,"چون شود واقف به مکتب می‌دود","جانش از رفتن شکفته می‌شود","وقتی کودک به آموزش و دانایی دست پیدا می‌کند، شور و نشاط در وجودش بیشتر می‌شود و با اشتیاق به سوی مکتب می‌دود."],[507,"می‌رود کودک به مکتب پیچ پیچ","چون ندید از مزد کار خویش هیچ","کودک به مکتب می‌رود با ناز و نرمی، اما چون دستمزد کارش را نمی‌بیند، از تلاش و زحمت خود بی‌خبر است."],[507,"چون کند در کیسه دانگی دست‌مزد","آنگهان بی‌خواب گردد شب چو دزد","زمانی که در کیسه خود از مزد تلاش‌هایش دست می‌کند، آن‌گاه مانند دزد در شب بی‌خواب می‌شود. یعنی وقتی که شخص به دست‌آوردهایش دست می‌زند یا به فکر آنها می‌افتد، نگرانی و احساس عدم آرامش او را در می‌گیرد."],[507,"جهد کن تا مزد طاعت در رسد","بر مطیعان آنگهت آید حسد","سعی کن تا پاداش اطاعت به کسانی که مطیع هستند برسد، در آن صورت حسد به دل افرادی که با تو رقابت می‌کنند می‌افتد."],[507,"ائتیا کرها مقلد گشته را","ائتیا طوعا صفا بسرشته را","اگر کسی به اجبار پیروی کند، به مجازات می‌رسد، اما اگر کسی با میل و رغبت پیروی کند، به جمال و زیبایی راه می‌یابد."],[507,"این محب حق ز بهر علتی","و آن دگر را بی غرض خود خلتی","اینجا مولانا می‌گوید که برخی از محبان خدا به خاطر یک دلیل یا علت خاص به او محبت می‌کنند، در حالی که برخی دیگر بدون هیچ دلیلی و فقط به خاطر خود خدا به او عشق می‌ورزند."],[507,"این محب دایه لیک از بهر شیر","و آن دگر دل داده بهر این ستیر","محبّ (دوستدار) او مانند دایه‌ای است که به خاطر شیر (محبت و نفعی) به این کودک وابسته است و آن شخص دیگر هم به همین دلیل به او دل داده است، نه به خاطر خود او."],[507,"طفل را از حسن او آگاه نه","غیر شیر او را ازو دلخواه نه","کودک فقط از زیبایی دایه باخبر است و جز شیر او (که خوراکش است) چیز دیگری را دوست ندارد."],[507,"و آن دگر خود عاشق دایه بود","بی غرض در عشق یک‌رایه بود","این بیت به این معناست که شخص دیگری که عاشق دایه است، بدون هیچ‌گونه هدف و غرض خاصی عشق می‌ورزد و در این عشق کاملا خالص و یک‌دست است."],[507,"پس محب حق باومید و بترس","دفتر تقلید می‌خواند بدرس","محب خدا در حالی که امیدوار است و می‌ترسد، در حال خواندن دفتری از آموزش‌ها و تقلیدها به منظور یادگیری و دریافت درس‌های معنوی است."],[507,"و آن محب حق ز بهر حق کجاست","که ز اغراض و ز علتها جداست","محبّ حقی که به خاطر خدا و محبت او تلاش می‌کند، کجاست که از خواسته‌ها و ملاحظات دنیوی و دلیل‌ها جداست؟"],[507,"گر چنین و گر چنان چون طالبست","جذب حق او را سوی حق جاذبست","اگر شخصی به دنبال حق باشد، چه کیفیتی داشته باشد، جذب حق خواهد شد و آن حق او را به سوی خود می‌کشاند."],[507,"گر محب حق بود لغیره","کی ینال دائما من خیره","اگر انسانی عاشق حق باشد، چگونه می‌تواند همواره از غیر او بهره‌مند شود؟"],[507,"یا محب حق بود لعینه","لاسواه خائفا من بینه","اگر کسی محب حقیقی باشد، نمی‌تواند از غیر خدا بترسد."],[507,"هر دو را این جست و جوها زان سریست","این گرفتاری دل زان دلبریست","این جست‌و‌جوها که هر دو در آن به سر می‌برند، ناشی از یک سرّ عمیق است و این درد و گرفتاری دل نیز به خاطر دلبری و زیبایی اوست."],[508,"آمدیم اینجا که در صدر جهان","گر نبودی جذب آن عاشق نهان","ما به این مکان آمدیم تا در اوج دنیا باشیم، و اگر خودت، یعنی معشوق، اینجا نبودی، جذبه‌ات نسبت به آن عاشق پنهان در دل شکل نمی‌گرفت."],[508,"ناشکیبا کی بدی او از فراق","کی دوان باز آمدی سوی وثاق","ناشکیبا که بودی، وقتی از فراق معشوق رنج می‌بردی؟ حال چگونه بازگشتی به آغوش او؟"],[508,"میل معشوقان نهانست و ستیر","میل عاشق با دو صد طبل و نفیر","میل و کشش عاشقان به سمت معشوق پنهان و مخفی است، در حالی که عشق عاشق به معشوق، به شدت نمایان و پر سر و صداست."],[508,"یک حکایت هست اینجا ز اعتبار","لیک عاجز شد بخاری ز انتظار","در اینجا حکایتی از ارزش و اعتبار عشق وجود دارد، اما بخاری، که نماد عاشق است، به خاطر انتظار و شوقی که دارد، ناتوان و عاجز شده است."],[508,"ترک آن کردیم کو در جست و جوست","تاکه پیش از مرگ بیند روی دوست","ما راه جست‌وجو و طلب را ترک کردیم، زیرا می‌خواهیم پیش از مرگ، چهره‌ی دوست را ببینیم."],[508,"تا رهد از مرگ تا یابد نجات","زانک دید دوستست آب حیات","آدمی تا زمانی که از مرگ رهایی یابد و به نجات برسد، باید در جستجوی دوست باشد؛ زیرا دیدن دوست همانند آب حیات است و موجب زندگی می‌شود."],[508,"هر که دید او نباشد دفع مرگ","دوست نبود که نه میوه‌ستش نه برگ","هرکس که ببیند مرگ را از او دور نیست، دوست او نیست؛ زیرا که او نه میوه دارد و نه برگ، یعنی نه شاهد زندگی و برکت است."],[508,"کار آن کارست ای مشتاق مست","کاندر آن کار ار رسد مرگت خوشست","کار عاشقانه و عشق واقعی به معشوق، چنان است که اگر در این مسیر با مرگ نیز مواجه شوی، آن مرگ هم خوشایند و دلپذیر خواهد بود."],[508,"شد نشان صدق ایمان ای جوان","آنک آید خوش ترا مرگ اندر آن","ای جوان، نشانه واقعی و صدق ایمان وقتی است که مرگ برای تو در آن حالتی که به تو می‌رسد، خوشایند و دلپذیر باشد."],[508,"گر نشد ایمان تو ای جان چنین","نیست کامل رو بجو اکمال دین","اگر ایمان تو به این شکل نیست، ای جان، پس کامل نیست. پس به دنبال کمال دین باش."],[508,"هر که اندر کار تو شد مرگ‌دوست","بر دل تو بی کراهت دوست اوست","هر کسی که در مسأله تو به مرگ رغبت پیدا کند، یعنی آماده فراق شما شود، به دل شما بی‌کراهت و دوست خواهد بود."],[508,"چون کراهت رفت آن خود مرگ نیست","صورت مرگست و نقلان کردنیست","زمانی که کراهت و تنفر از مرگ برطرف شود، دیگر آنچه که به عنوان مرگ شناخته می‌شود، حقیقتا مرگ نیست، بلکه فقط شکلی از تغییر است و به راحتی می‌توان آن را انتقال داد یا تغییر وضعیت داد."],[508,"چون کراهت رفت مردن نفع شد","پس درست آید که مردن دفع شد","زمانی که کراهت و تنفر از مرگ برطرف شود، در آن صورت مرگ به نفع آدمی تبدیل می‌شود و مشخص است که دیگر مرگ برای او چیز منفی‌ای نیست."],[508,"دوست حقست و کسی کش گفت او","که توی آن من و من آن تو","دوست، حق و حقیقت است و هر کس بگوید او در من است و من در او هستم، در واقع به ارتباط عمیق و یگانگی روحی اشاره دارد."],[508,"گوش دار اکنون که عاشق می‌رسد","بسته عشق او را به حبل من مسد","خود را آماده باش، زیرا عاشق به تو نزدیک می‌شود، و عشق او را به ریسمان من متصل کرده است."],[508,"چون بدید او چهره صدر جهان","گوییا پریدش از تن مرغ جان","هنگامی که او (عاشق) چهره زیبا و دلربای معشوق (صدر جهان) را دید، گویی جانش از بدنش خارج شد، مانند پرنده‌ای که از تن خود می‌پرد."],[508,"همچو چوب خشک افتاد آن تنش","سرد شد از فرق جان تا ناخنش","عاشق به حالت بی‌حالی و بی‌حرکتی افتاده است و بدن او مانند چوب خشک شده است، به طوری که روحش از سر تا ناخن از او جدا شده و به حالتی سرد و بی‌تحرک در آمده است."],[508,"هرچه کردند از بخور و از گلاب","نه بجنبید و نه آمد در خطاب","هر چه از عطر و گلاب به کار بردند، هیچ تأثیری نداشت و او حتی حرکتی نکرد و به سخن نیامد."],[508,"شاه چون دید آن مزعفر روی او","پس فرود آمد ز مرکب سوی او","زمانی که شاه، چهره زیبا و شگفت‌انگیز او که موهای زرد (مزعفر) دارد را دید، از اسبش پیاده شد و به سمت او رفت."],[508,"گفت عاشق دوست می‌جوید بتفت","چونک معشوق آمد آن عاشق برفت","عاشق برای یافتن محبوبش بسیار تلاش می‌کند، اما وقتی معشوق سراغ او می‌آید، آن عاشق خود را پنهان می‌کند و فرار می‌کند."],[508,"عاشق حقی و حق آنست کو","چون بیاید نبود از تو تای مو","عاشق حقیقی و واقعی کسی است که وقتی معشوق (خدا) می‌آید، دیگر هیچ چیز از خود نمی‌بیند و هیچ نشانه‌ای از خود را در آن حال احساس نمی‌کند."],[508,"صد چو تو فانیست پیش آن نظر","عاشقی بر نفی خود خواجه مگر","هر کسی مانند تو در برابر آن نگاه از بین می‌رود، عاشقی حقیقی جز نفی خود و نداشتن خواسته‌های شخصی را ندارد."],[508,"سایه‌ای و عاشقی بر آفتاب","شمس آید سایه لا گردد شتاب","عاشق مانند سایه‌ای است که در برابر آفتاب شمس‌الدین تبریزی قرار دارد و هرگز نمی‌تواند به سوی او شتاب کند. در واقع، عشق او به شمس چنان است که سایه فقط در حضور آفتاب وجود دارد، اما نمی‌تواند به جلو بیفتد یا به او نزدیک شود."],[509,"پشه آمد از حدیقه وز گیاه","وز سلیمان گشت پشه دادخواه","پشه از باغ و گیاه و همچنین از سلیمان به درگاه او آمد تا از ظلمی که بر او می‌رود شکایت کند."],[509,"کای سلیمان معدلت می‌گستری","بر شیاطین و آدمی‌زاد و پری","ای سلیمان، تو عدالت خود را بر شیاطین و آدمیان و پری‌ها گسترش می‌دهی."],[509,"مرغ و ماهی در پناه عدل تست","کیست آن گم‌گشته کش فضلت نجست","در سایه عدل و انصاف تو، ای سلیمان، پرنده و ماهی در امن و امان هستند، اما چه کسی در این میان گم شده است که از فضیلت تو بی‌بهره مانده؟"],[509,"داد ده ما را که بس زاریم ما","بی‌نصیب از باغ و گلزاریم ما","از خداوند (حضرت سلیمان) درخواست می‌کنیم که به ما کمک کند، زیرا ما در شرایط سخت و بدی به سر می‌بریم و از نعمت‌های باغ و گلزار بی‌بهره‌ایم."],[509,"مشکلات هر ضعیفی از تو حل","پشه باشد در ضعیفی خود مثل","مشکلات هر انسان ضعیف، همانند پشه‌ای است که به تو، سلیمان، از ضعف خود شکایت می‌کند."],[509,"شهره ما در ضعف و اشکسته‌پری","شهره تو در لطف و مسکین‌پروری","ما در میان ضعف و ناتوانی معروف هستیم، اما تو در بخشندگی و حمایت از مسکین‌ها معروفی."],[509,"ای تو در اطباق قدرت منتهی","منتهی ما در کمی و بی‌رهی","ای تو که در اوج قدرت و توانایی، ما در نهایت ناتوانی و بی‌سرشتی هستیم."],[509,"داد ده ما را ازین غم کن جدا","دست گیر ای دست تو دست خدا","از ما این غم و رنج را دور کن و کمک کن، ای که دست تو همچون دست خداست و می‌تواند به ما یاری رساند."],[509,"پس سلیمان گفت ای انصاف‌جو","داد و انصاف از که میخواهی بگو","حضرت سلیمان از پشه‌ای که دادخواهی می‌کند می‌پرسد که انصاف و عدالت را از چه کسی می‌خواهد و از او می‌خواهد تا نام شخص ظالم را مشخص کند."],[509,"کیست آن کالم که از باد و بروت","ظلم کردست و خراشیدست روت","کیست آن کسی که از باد و برگ درخت به تو ظلم کرده و صورت تو را خراشیده است؟"],[509,"ای عجب در عهد ما ظالم کجاست","کو نه اندر حبس و در زنجیر ماست","عجیب است که در زمان ما چه کسی ظالم است، چرا که او در حبس و زنجیر ما نیست و آزاد است."],[509,"چونک ما زادیم ظلم آن روز مرد","پس بعهد ما کی ظلمی پیش برد","ما در روزگار ظلم پرورش یافته‌ایم، پس چگونه در زمان ما می‌توان ظلمی به جلو رفت؟"],[509,"چون بر آمد نور ظلمت نیست شد","ظلم را ظلمت بود اصل و عضد","زمانی که نور می‌تابد، ظلمتی وجود ندارد و ظلم نیز ریشه‌اش در تاریکی است."],[509,"نک شیاطین کسب و خدمت می‌کنند","دیگران بسته باصفادند و بند","شیاطین به کسب و کار و خدمت مشغولند، اما دیگران در بند و گرفتار هستند و آزادی ندارند."],[509,"اصل ظلم ظالمان از دیو بود","دیو در بندست استم چون نمود","ظلم ظالمان ریشه در وجود دیو دارد و دیو، که نماد شر و فساد است، به زنجیر بسته شده و نمی‌تواند خود را نشان دهد."],[509,"ملک زان دادست ما را کن فکان","تا ننالد خلق سوی آسمان","سلیمان، ملک و پادشاه، به ما کمک کرده است تا از ظلم و ستم رهایی یابیم، تا مردم از درد و ناله به آسمان شکایت نکنند."],[509,"تا به بالا بر نیاید دودها","تا نگردد مضطرب چرخ و سها","تا زمانی که دودها به آسمان نرود و بالا نرود، حرکت و اضطرابی در آسمان و ستاره‌ها ایجاد نخواهد شد."],[509,"تا نلرزد عرش از ناله یتیم","تا نگردد از ستم جانی سقیم","تا زمانی که عرش (آسمان) از ناله و فریاد یتیمان بلرزد و جان‌های ستمدیدگان مریض و رنجور نشوند، باید به این مسائل توجه کرد."],[509,"زان نهادیم از ممالک مذهبی","تا نیاید بر فلکها یا ربی","ما به خاطر دین و مذهب خود، دعا و درخواست می‌کنیم که ظلم و ستم در زمین و آسمان نیاید."],[509,"منگر ای مظلوم سوی آسمان","کاسمانی شاه داری در زمان","ای مظلوم، به آسمان نگاه نکن؛ زیرا در این دنیا، تو پادشاهی بزرگ و با مقامی ارزشمند داری."],[509,"گفت پشه داد من از دست باد","کو دو دست ظلم بر ما بر گشاد","پشه گفت که من از ظلم باد به زحمت افتاده‌ام، پس کجاست آن کسی که دو دست ظلم را از ما باز کند؟"],[509,"ما ز ظلم او به تنگی اندریم","با لب بسته ازو خون می‌خوریم","ما از ظلم باد به تنگ آمده‌ایم و با اینکه نمی‌توانیم چیزی بگوییم، در عین حال از او خون می‌خوریم (یعنی آسیب می‌بینیم)."],[510,"پس سلیمان گفت ای زیبا دوی","امر حق باید که از جان بشنوی","سلیمان گفت که ای زیبای دو جهان، باید به فرمان حق گوش دهی و اطاعت کنی."],[510,"حق به من گفته‌ست هان ای دادور","مشنو از خصمی تو بی خصمی دگر","خدا به من گفته است، ای قاضی و دادگر، از شکایت یک طرفه نشنو و به رقبتی که میان این دو کس است توجه کن زیرا باید هر دو خصم را در نظر بگیری."],[510,"تا نیاید هر دو خصم اندر حضور","حق نیاید پیش حاکم در ظهور","تا زمانی که هر دو طرف دعوا به حضور خدا نیایند، مسئله نزد حاکم به نتیجه نخواهد رسید."],[510,"خصم تنها، گر بر آرد صد نفیر","هان و هان بی خصم قول او مگیر","اگر یک طرف دعوا فقط صد بار فریاد بزند و اعتراض کند، باز هم چیزی نیست و نباید به سخنان او توجه کرد، چون او تنهاست و طرف مقابل را ندارد."],[510,"من نیارم رو ز فرمان تافتن","خصم خود را رو بیاور سوی من","من نمی‌توانم به خاطر رویارویی با دشمن خود، از فرمان خداوند رو برگردانم و درخواست او را نادیده بگیرم."],[510,"گفت قول تست برهان و درست","خصم من بادست و او در حکم تست","سلیمان علیه السلام می‌گوید: «گفتار تو دلیل و برهان قاطع است و درست این است که من در اختیار تو هستم و او (خصم) در دست توست؛ بنابراین تو قاضی هستی و باید حکم کنی."],[510,"بانگ بر زد آن شه ای باد صبا","پشّه افغان کرد از ظلمت، بیا","سلیمان، آن پادشاه بزرگ، فرمان داد که صدا بزنید ای باد صبحگاهی، تا این پشه به خاطر ظلمی که دیده است، شکایت کند و بیاید."],[510,"هین مقابل شو تو و خصم و بگو","پاسخ خصم و بکن دفع عدو","ای گروه مردم، با خصم خود رو به‌رو شوید و به او بگویید، پاسخ او را بدهید و دشمنی را دفع کنید."],[510,"باد چون بشنید آمد تیز تیز","پشه بگرفت آن زمان راه گریز","زمانی که باد این گفتار را شنید، به سرعت و با چالاکی آمد و پشه را گرفت و در آن زمان دیگر راه فراری نداشت."],[510,"پس سلیمان گفت ای پشه کجا؟","باش تا بر هر دو رانم من قضا","سلیمان به پشه می‌گوید: کجا هستی؟ بایست تا حکم قضا را بر هر دو شما، یعنی پشه و خصمش، بکنم."],[510,"گفت ای شه مرگ من از بود اوست","خود سیاه این روز من از دود اوست","پشه گفت ای پادشاه، مرگ من به خاطر وجود اوست و من به خاطر او در این روز سیاه و غم‌انگیز زندگی‌ام دچار مشکل شده‌ام."],[510,"او چو آمد من کجا یابم قرار","کو بر آرد از نهاد من دمار","زمانی که خداوند به نزد من بیاید، من چگونه می‌توانم آرامش پیدا کنم؟ او مرا طوری در هم خواهد شکست که بی‌قرار و آشفته شوم."],[510,"همچنین جویای درگاه خدا","چون خدا آمد شود جوینده لا","هرگاه انسان در طلب و جستجوی درگاه خدا باشد، زمانی که خداوند نزدیک شود، این جستجوگر دیگر جوینده نخواهد بود، بلکه به مقام حقیقت و وصال می‌رسد و در جستجو باقی نمی‌ماند."],[510,"گرچه آن وصلت بقا اندر بقاست","لیک ز اول آن بقا اندر فناست","هرچند آن پیوند و ارتباط دائمی و پایدار است، اما از ابتدا، این دوام و بقای آن به فنا و زوال منتهی می‌شود."],[510,"سایه‌هایی که بود جویای نور","نیست گردد چون کند نورش ظهور","سایه‌ها هرگز به دنبال نور نمی‌روند، اما وقتی نور نمایان شود، خود را نشان می‌دهند و به وجود می‌آیند."],[510,"عقل کی ماند چو باشد سرده او","کل شیء هالک الا وجهه","عقل انسان در شرایطی که سرد و بی‌روح باشد دوام نخواهد آورد، زیرا همه چیز جز ذات خداوند (وجهه او) فناپذیر است."],[510,"هالک آید پیش وجهش هست و نیست","هستی اندر نیستی خود طرفه‌ایست","هالک (چیزهای فناپذیر) در برابر صورت حق (وجهه‌اش) می‌آید، یعنی در نهایت همه چیز نابود می‌شود جز ذات حق. وجود و عدم در اینجا به هم آمیخته است و این تناقضی شگفت‌انگیز است."],[510,"اندرین محضر خردها شد ز دست","چون قلم اینجا رسیده شد، شکست","در این محضر و جلسه، عقل‌ها و خردها نابود می‌شوند و به گونه‌ای هستند که مانند قلم، به اینجا رسیده و شکسته می‌شوند."],[511,"می‌کشید از بیهشی‌اش در بیان","اندک اندک از کرم صدر جهان","خود را از حالت بی‌هوشی به تدریج به هوش می‌آورد، به‌گونه‌ای که این کار را با لطف و بخشش خود انجام می‌دهد."],[511,"بانگ زد در گوش او شه کای گدا","زر نثار آوردمت دامن گشا","شه (پادشاه) در گوش عاشق (گدا) ندا داد که ای گدا، زر و طلا برای تو بخشیده‌ام، حال دامن خود را باز کن و بپذیر."],[511,"جان تو کاندر فراقم می‌طپید","چونک زنهارش رسیدم چون رمید","ای آن که جان تو در فراق من می‌تپید، چون زنهار و وعده‌ام را شنیدی و ترسیدی از آن، جان تو از این عشق رهایی یافت و رمید."],[511,"ای بدیده در فراقم گرم و سرد","با خود آ از بی‌خودی و باز گرد","ای محبوب که من به خاطر دوری‌ات در حالت ناآرامی و بی‌تابی به سر می‌برم، حالا به خود بیا و از این حالت بی‌خودی خارج شو و به سوی من برگرد."],[511,"مرغ خانه اشتری را بی خرد","رسم مهمانش به خانه می‌برد","مرغی که نماد عقل و خرد است، به خاطر بی‌خردی و نادانی، مهمان اشتری را به خانه‌اش دعوت می‌کند. این بیت به هشدار درباره عواقب نادانی اشاره دارد که چگونه می‌تواند به خرابی و تباهی منجر شود."],[511,"چون به خانه مرغ اشتر پا نهاد","خانه ویران گشت و سقف اندر فتاد","وقتی اشتر (شتر) به خانه مرغ پا گذاشت، آن خانه خراب شد و سقفش فرو ریخت."],[511,"خانه مرغست هوش و عقل ما","هوش صالح طالب ناقه خدا","عقل و هوش ما تنها مکان و خانه مرغی است و باید در پی ناقه خداوند باشیم، یعنی در پی معرفت و عشق الهی."],[511,"ناقه چون سر کرد در آب و گلش","نه گل آنجا ماند نه جان و دلش","وقتی که معشوق مانند شتری که به آب می‌رود، در دنیا و مادیات غوطه‌ور می‌شود، دیگر نه آن مادیات باقی می‌ماند و نه عشق و روح او."],[511,"کرد فضل عشق انسان را فضول","زین فزون‌جویی ظلومست و جهول","عشق باعث رشد و کمال انسان می‌شود، اما اگر کسی به دنبال زیادطلبی و فزون‌خواهی باشد، او به جهل و ظلم مبتلا خواهد شد."],[511,"جاهلست و اندرین مشکل شکار","می‌کشد خرگوش شیری در کنار","در این بیت اشاره به این است که شخص نادان (جاهل) در جست‌وجوی شکار به دنبال به دام انداختن شیر می‌رود، در حالی که تلاش او بیهوده است؛ چون نمی‌داند که شکارش (خرگوش) در نزد شیر در معرض خطر است. این بیان نشان‌دهنده‌ی نادانی و ناامیدی فرد در مواجهه با چالش‌های بزرگ‌تر است."],[511,"کی کنار اندر کشیدی شیر را","گر بدانستی و دیدی شیر را","اگر تو شیر را می‌شناختی و می‌فهمیدی که او چیست، هرگز کنارش نمی‌نشستی و خطر را به جان نمی‌خریدی."],[511,"ظالمست او بر خود و بر جان خود","ظلم بین کز عدلها گو می‌برد","او بر خود و جان خودش ظلم می‌کند، پس چگونه می‌تواند از عدالت‌ها سخن بگوید، در حالی که در واقعیت از آن‌ها دور است؟"],[511,"جهل او مر علمها را اوستاد","ظلم او مر عدلها را شد رشاد","نادانی او، مرجع و استادی بر علم‌هاست، و ظلم او موجب گردیده که عدالت‌ها دچار لطمه و نقص شوند."],[511,"دست او بگرفت کین رفته دمش","آنگهی آید که من دم بخشمش","او (عاشق) دست محبوب را گرفت و در این حال، رویدادهایی در انتظار است که آنچه به او پرداخته می‌شود، جان او را به زندگی دوباره برمی‌گرداند. در واقع، او می‌خواهد زمانی که نفسش (دم او) را به محبوب بدهد، آن محبوب دوباره جان بگیرد و به زندگی برگردد."],[511,"چون به من زنده شود این مرده‌تن","جان من باشد که رو آرد به من","وقتی این مرده‌تن، به من جان بگیرد، جان من است که به سوی من می‌آید."],[511,"من کنم او را ازین جان محتشم","جان که من بخشم ببیند بخششم","من با این جان محترم و باعظمت، او را از خودم می‌کنم، تا او بتواند بخشش من را ببیند."],[511,"جان نامحرم نبیند روی دوست","جز همان جان کاصل او از کوی اوست","تنها جان‌های پاک و شایسته می‌توانند چهره معشوق را ببینند، زیرا جان‌های ناپاک و نامحرم از عشق و حقیقت دور هستند و فقط آن‌هایی که از راه عشق به معشوق رسیده‌اند، می‌توانند جمال او را بدانند."],[511,"دردمم قصاب‌وار این دوست را","تا هلد آن مغز نغزش پوست را","درد من مانند قصاب است که به شدت به دوست حمله می‌کند تا مغز نغز و باارزشی را از پوست بیرون بکشد. این اشاره به عمق احساسات عاشقانه و کشمکش‌های درونی دارد که به خاطر عشق به وجود می‌آید."],[511,"گفت ای جان رمیده از بلا","وصل ما را در گشادیم الصلا","محبوب می‌گوید: ای جان، که از درد و رنج جدا شده‌ای، در آغوش ما بشتاب و فریاد ما را بشنو."],[511,"ای خود ما بی‌خودی و مستی‌ات","ای ز هست ما هماره هستی‌ات","ای خود ما که در بی‌خودی �