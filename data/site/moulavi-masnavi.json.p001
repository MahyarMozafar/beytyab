طرح شده است نیاز به توضیح دارد، اما من همچنان به داستان مرد و زن برمی‌گردم، که موضوع اصلی بحث است."],[125,"ماجرای مرد و زن را مخلصی","باز می‌جوید درون مخلصی","ماجرای مرد و زن به دنبال نجات و رهایی می‌گردد و در این راه، درونی به نام «مخلص» دنبال می‌کند که ممکن است به معنای نجات‌دهنده یا راهنما باشد."],[125,"ماجرای مرد و زن افتاد نقل","آن مثال نفس خود می‌دان و عقل","داستان مرد و زن در واقع مثالی است از نفس و عقل انسان، که هر کدام جنبه‌ها و ویژگی‌های خاص خود را دارند."],[125,"این زن و مردی که نفسست و خرد","نیک بایستست بهر نیک و بد","این زن و مرد نماد نفس و عقل هستند که برای انجام کارهای نیک و بد مناسبند."],[125,"وین دو بایسته درین خاکی‌سرا","روز و شب در جنگ و اندر ماجرا","این زن و مرد که نماد نفس و عقل هستند، در این دنیای مادی و خاکی هر لحظه با یکدیگر در نبرد و کشمکش‌اند."],[125,"زن همی‌خواهد حویج خانگاه","یعنی آب رو و نان و خوان و جاه","زن در زندگی، همچنین به دنبال تأمین معیشت خود است؛ او خواهان چیزهایی است که زندگی را برایش فراهم کند، مانند آب، نان، امنیت و وضعیت اجتماعی خوب."],[125,"نفس همچون زن پی چاره‌گری","گاه خاکی گاه جوید سروری","نفس انسان مانند زنی است که برای پیدا کردن راه حل و رهایی از مشکلات به دنبال چاره‌گری است؛ گاهی به چیزهای مادی و دنیوی (خاکی) و گاهی به جایگاه‌های بلند و شریفی (سروری) می‌پردازد."],[125,"عقل خود زین فکرها آگاه نیست","در دماغش جز غم الله نیست","عقل انسان از این نوع افکار و دغدغه‌ها بی‌خبر است و در ذهن او جز اندوهی ناشی از دوری از خداوند وجود ندارد."],[125,"گرچه سرّ قصه این دانه‌ست و دام","صورت قصه شنو اکنون تمام","اگرچه حقیقت داستان در دانه است، اما اکنون به ظاهر داستان گوش کن که به تمام‌ پناه می‌برد."],[125,"گر بیان معنوی کافی شدی","خلق عالم عاطل و باطل بدی","اگر معنای باطنی و روحانی یک مسئله به‌خوبی بیان شود، مردم دنیا بی‌فایده و بیهوده خواهند بود."],[125,"گر محبت فکرت و معنیستی","صورت روزه و نمازت نیستی","اگر محبت و اندیشه‌ات واقعی باشد، در آن صورت، شکل و ظاهر روزه و نماز تو اهمیت ندارد."],[125,"هدیه‌های دوستان با همدگر","نیست اندر دوستی الا صور","هدیه‌های دوستان، در حقیقت، نشانه‌های ظاهری دوستی هستند و خود دوستی و محبت واقعی در باطن ناشناخته و پنهان است."],[125,"تا گواهی داده باشد هدیه‌ها","بر محبتهای مضمر در خفا","هدیه‌ها باید نشانه‌ای باشند بر محبت‌های پنهانی که در دل وجود دارد."],[125,"زانک احسانهای ظاهر شاهدند","بر محبتهای سر ای ارجمند","چون احسان‌های آشکار نشان‌دهنده محبت‌های پنهان است، ای عزیز."],[125,"شاهدت گه راست باشد گه دروغ","مست گاهی از می و گاهی ز دوغ","شاهد تو، یعنی دل و آنچه که احساس می‌کنی، گاهی راست و گاهی دروغ می‌گوید. گاهی مستی‌ات از شراب است و گاهی از دوغ (نوشیدنی غیر الکلی)، که اشاره به سردرگمی و بی‌خبری از واقعیت دارد."],[125,"دوغ خورده مستیی پیدا کند","های هوی و سرگرانیها کند","کسی که دوغ می‌نوشد، ممکن است حالتی از سرخوشی و شنگولی پیدا کند و به خوش‌گذرانی و تفریح بپردازد."],[125,"آن مرایی در صیام و در صلاست","تا گمان آید که او مست ولاست","در حالتی که آن مرد در حال روزه‌داری و در انجام نماز است، به نظر می‌رسد که او دچار مستی و غفلت شده است."],[125,"حاصل افعال برونی دیگرست","تا نشان باشد بر آنچ مضمرست","عمل‌های ظاهری انسان نشان‌دهنده چیز دیگری است که در درون او نهفته است؛ یعنی آنچه که بیرونی و قابل مشاهده است، بر اساس رفتارهای درونی و پنهان او معنا می‌یابد."],[125,"یا رب این تمییز ده ما را بخواست","تا شناسیم آن نشان کژ ز راست","خداوندا، به ما درک و تمییز بده تا بتوانیم آن نشانه‌های حق را از باطل تشخیص دهیم."],[125,"حس را تمییز دانی چون شود","آنک حس ینظر بنور الله بود","حس را باید آنگاه شناخت که به نور خداوند نگاه کند، یعنی وقتی حس به روشنایی الهی دست پیدا کند، توانایی تمییز درست و نادرست را خواهد داشت."],[125,"ور اثر نبود سبب هم مظهرست","همچو خویشی کز محبت مخبرست","اگر اثری نباشد، سبب هم نمایانگر است، مانند دوستی که از طریق محبت از احوال دیگری باخبر می‌شود."],[125,"نبود آنک نور حقش شد امام","مر اثر را یا سببها را غلام","اگر نور حق، که امام آن است، در درون انسان نباشد، به جز اثر و اسباب دنیا هیچ چیزی نخواهد بود و همه آن‌ها همچون برده‌هایی از آن نور می‌باشند."],[125,"یا محبت در درون شعله زند","زفت گردد وز اثر فارغ کند","محبت می‌تواند در درون مانند شعله‌ای بسوزد و انسان را چنان داغ کند که از آثار و تبعات آن رها شده و آزاد گردد."],[125,"حاجتش نبود پی اعلام مهر","چون محبت نور خود زد بر سپهر","محبت به‌حدی قوی و روشن است که نیازی به اعلام و بیان ندارد، زیرا خود به‌طور طبیعی مانند نوری که بر آسمان می‌تابد، وجودش را نشان می‌دهد."],[125,"هست تفصیلات تا گردد تمام","این سخن لیکن بجو تو والسلام","برای آنکه این سخن به‌طور کامل روشن شود، جزییات زیادی وجود دارد، اما به تو می‌گویم و کارم را به پایان می‌رسانم."],[125,"گرچه شد معنی درین صورت پدید","صورت از معنی غریبست و بعید","هرچند که معنا در این شکل و صورت به وضوح ظاهر شده، اما خود این شکل و صورت از معنی بسیار بیگانه و دور است."],[125,"در دلالت همچو آبند و درخت","چون بماهیت روی دورند سخت","در اشاره به دلالت و مفهوم‌سازی، مثل آب و درخت، که از ذات خود دور هستند و به صورتشان وابسته‌اند، به ما نشان می‌دهد که حقیقت یا ماهیت اشیاء معمولا از ظاهر آنها قابل فهم نیست."],[125,"ترک ماهیات و خاصیات گو","شرح کن احوال آن دو ماه‌رو","به جای تمرکز بر ویژگی‌ها و صفات ظاهری، داستان و حالت آن دو انسان زیبا را توضیح بده."],[126,"مرد گفت اکنون گذشتم از خلاف","حکم داری تیغ برکش از غلاف","مرد می‌گوید که حالا از نافرمانی گذشته‌ام، پس ای فرمانروای عزیز، شمشیر خود را از غلاف بیرون بیاور."],[126,"هرچه گویی من ترا فرمان برم","در بد و نیک آمد آن ننگرم","هر چیزی که تو بگویی، من آن را انجام می‌دهم و به خوبی و بدی آن توجهی نمی‌کنم."],[126,"در وجود تو شوم من منعدم","چون محبم حب یعمی و یصم","در وجود تو ذوب می‌شوم و گم می‌شوم، زیرا محبت من به تو آن‌قدر شدید است که همه چیز را می‌پوشاند و از شنیدن و دیدن باز می‌دارد."],[126,"گفت زن آهنگ برّم می‌کنی","یا بحیلت کشف سرّم می‌کنی","زن گفت: آیا قصد داری به خاطر نیکی و خوبی به من نزدیک شوی، یا با نیرنگ و فریب راز مرا افشا خواهی کرد؟"],[126,"گفت والله عالم السرّ الخفی","کآفرید از خاک آدم را صفی","عرب گفت، سوگند به خدا، که او (خدا) داننده رازهای پنهان است، همان‌طور که از خاک، آدم را خلق کرد."],[126,"در سه گز قالب که دادش وا نمود","هر چه در الواح و در ارواح بود","در سه قطعه‌ای که به او داد، هر چه در جان‌ها و در دفترهای آسمانی بود، نشان داد و نمایان کرد."],[126,"تا ابد هرچه بود او پیش‌پیش","درس کرد از علّم الاسماء خویش","تا همیشه، هر آنچه که وجود داشت را او از پیش، درس داد و آموخت، از علم نام‌ها و نشانه‌های خود."],[126,"تا ملک بی‌خود شد از تدریس او","قدس دیگر یافت از تقدیس او","ملائکه (فرشتگان) به خاطر آموزش و تعلیم مولانا از حالت عادی خود خارج شدند و به مرتبه‌ای قدسی و ارجمند دست یافتند که به واسطه این تقدیس، مقام و منزلت خاصی پیدا کردند."],[126,"آن گشادیشان کز آدم رو نمود","در گشاد آسمانهاشان نبود","آسمان‌ها که به واسطه آدم گشوده شدند، آنقدر وسیع و باز نیستند که به اندازه گشایش روح‌های پاک و مقدس وجود موحدان باشد."],[126,"در فراخی عرصه آن پاک‌جان","تنگ آمد عرصه هفت آسمان","در وسعت و گستردگی فضای آن روح پاک، عرصه هفت آسمان برایش تنگ و محدود است."],[126,"گفت پیغامبر که حق فرموده است","من نگنجم هیچ در بالا و پست","پیامبر گفته است که خداوند فرموده است من در هیچ‌یک از مکان‌ها، چه بالا و چه پایین، جا نمی‌گیرم."],[126,"در زمین و آسمان و عرش نیز","من نگنجم این یقین دان ای عزیز","من نمی‌توانم در هیچ جا از جمله زمین، آسمان و عرش، جا بگیرم؛ این مسأله را به خوبی درک کن، ای عزیز."],[126,"در دل مؤمن بگنجم ای عجب","گر مرا جویی در آن دلها طلب","من در دل مؤمنان جا می‌گیرم، چه شگفت‌انگیز! اگر مرا بخواهی، باید در آن دل‌ها جستجو کنی."],[126,"گفت ادخل فی عبادی تلتقی","جنّة من رویتی یا متّقی","خداوند می‌فرماید: «وارد گروه بندگان من شو، که بهشت را از روی من خواهی دید، ای پرهیزکار»."],[126,"عرش با آن نور با پهنای خویش","چون بدید آنرا، برفت از جای خویش","عرش (مکانی بلند و مقدس در آسمان) به نور و بزرگی‌اش نگریست و از مقام بلندش پایین آمد."],[126,"خود بزرگی عرش باشد بس مدید","لیک صورت کیست چون معنی رسید","عرش (جایگاه خداوندی) با تمام عظمت و شکوه خود بسیار وسیع است، اما وقتی به معنی و مفهوم واقعی برسیم، می‌فهمیم که حقیقت و معنای عرش به صورت و شکل ظاهری آن محدود نیست."],[126,"هر ملک می‌گفت ما را پیش ازین","الفتی می‌بود بر روی زمین","هر فرشته‌ای می‌گفت که ما قبل از این نیز علاقه و محبت زیادی به یکدیگر داشتیم و با هم در زمین ارتباط داشتیم."],[126,"تخم خدمت بر زمین می‌کاشتیم","زان تعلق ما عجب می‌داشتیم","ما در زمین تخم خدمت می‌کاشتیم و به خاطر این وابستگی به خاک، حیرت داشتیم که چرا چنین رابطه‌ای داریم."],[126,"کین تعلق چیست با این خاکمان","چون سرشت ما بدست از آسمان","این تعلق و وابستگی به خاک چیست، در حالی که سرشت و وجود ما از آسمان و عالم معنوی است؟"],[126,"الف ما انوار، با ظلمات چیست؟","چون تواند نور با ظلمات زیست؟","محبت و عشق ما همانند نور است، در حالی که ظلمات (تاریکی) چیزی جدا و متضاد با آن است. پس چگونه می‌تواند نور با تاریکی coexist کند و زندگی کند؟"],[126,"آدما آن الف از بوی تو بود","زانک جسمت را زمین بد تار و پود","آدم‌ها به این دلیل به عشق و محبت تو جذب شده‌اند که وجود و جسم تو در زمین، شالوده و بنیاد زندگی آن‌ها را تشکیل می‌دهد."],[126,"جسم خاکت را ازینجا بافتند","نور پاکت را درینجا یافتند","جسم خاکی تو را از این زمین ساخته‌اند، اما نور و روح پاک تو را در اینجا شناخته و یافته‌اند."],[126,"این که جان ما ز روحت یافتست","پیش‌پیش از خاک آن می‌تافتست","جان ما از روح الهی به وجود آمده و پیش از اینکه خاک بدن ما ساخته شود، به آن روح وابسته بوده و از نور آن بهره‌مند می‌شد."],[126,"در زمین بودیم و غافل از زمین","غافل از گنجی که در وی بد دفین","ما در دنیا زندگی می‌کردیم و از واقعیت‌های آن غافل بودیم و از گنجی که در دل این دنیا پنهان است، آگاه نبودیم."],[126,"چون سفر فرمود ما را زان مقام","تلخ شد ما را از آن تحویل کام","وقتی که خداوند ما را از آن جای تلخ به سفر فرستاد، این تغییر وضعیت باعث شد که ما احساس تلخی و آزردگی کنیم."],[126,"تا که حجتها همی گفتیم ما","که به جای ما کی آید ای خدا","ما در حین مطرح کردن دلایل خود از خداوند می‌پرسیم که چه کسی جای ما خواهد آمد."],[126,"نور این تسبیح و این تهلیل را","می‌فروشی بهر قال و قیل را","تو نور این ذکر و ستایش را برای حرف و حدیث‌ها می‌فروشی."],[126,"حکم حق گسترد بهر ما بساط","که بگویید ازطریق انبساط","خداوند برای ما رحمت و نعمت زیادی فراهم کرده است تا بتوانیم به راحتی و با دل باز سخن بگوییم."],[126,"هرچه آید بر زبانتان بی‌حذر","همچو طفلان یگانه با پدر","هر چیزی که به زبان می‌آورید، بدون نگرانی و احتیاط، مانند بچه‌هاست که به راحتی با پدر خود صحبت می‌کنند."],[126,"زانک این دمها چه گر نالایقست","رحمت من بر غضب هم سابقست","چون این لحظات و حالاتی که من دارم، ناپسند و نامناسب است، پس رحمت من بر غضبم پیشی دارد."],[126,"از پی اظهار این سبق ای ملک","در تو بنهم داعیه اشکال و شک","ای فرشته، از روی این پیش‌آمد که من در تو – یعنی در وجود تو – ادعایی از نایابی و دشواری‌ها دارم و این نشان‌دهنده شک و اشکال است."],[126,"تا بگویی و نگیرم بر تو من","منکر حلمم نیارد دم زدن","اگر بگویی که من می‌توانم تو را بپذیرم، من هرگز بر تو انکار نمی‌کنم و در برابر تو هیچ کلامی برای دفاع از خود ندارم."],[126,"صد پدر صد مادر اندر حلم ما","هر نفس زاید در افتد در فنا","هر لحظه در حالت تحمل و صبر ما، صد پدر و مادر به دنیا می‌آیند و از بین می‌روند. این به معنای عمق و وسعت صبر ماست که در هر دم، احساسات و دشواری‌های بسیاری را تجربه می‌کنیم."],[126,"حلم ایشان کف بحر حلم ماست","کف رود آید، ولی دریا بجاست","حلم و بردباری آن‌ها مانند سطح دریا است که به نظر می‌رسد کوچکتر از آن چیزی باشد که وجود دارد؛ اگرچه ممکن است تنها بخشی از آن قابل مشاهده باشد، اما عمق و وسعت دریا در زیر سطح آن نهفته است."],[126,"خود چه گویم پیش آن درّ این صدف","نیست الا کف کف کف کف","من نمی‌توانم در برابر آن جواهر (درّ) که در دل آن صدف (خود) نهفته است، چیزی بگویم، زیرا فقط ظهور و نمایشی از آن جواهر (کف) را دارم."],[126,"حق آن کف، حق آن دریای صاف","کامتحانی نیست این گفت و نه لاف","سخن از این است که این کف (کف دست یا خروار شن) در مقایسه با دریای صاف (که به معانی والای عشق یا حقیقت اشاره دارد) هیچ ارزشی ندارد و نمی‌تواند آزمون را بیازماید. در واقع، او می‌گوید آنچه می‌گوید حقیقتی عمیق است و دروغی نیست."],[126,"از سر مهر و صفا است و خضوع","حق آنکس که بدو دارم رجوع","محبت و ادب نسبت به خداوند و تسلیم در برابر او از ویژگی‌های کسی است که به درگاه او روی می‌آورد و به او پناه می‌برد."],[126,"گر به پیشت امتحانست این هوس","امتحان را امتحان کن یک نفس","اگر این اشتیاق و خواسته‌ام برای تو آزمایش است، پس آزمایش را آزمایش کن، حتی اگر فقط یک لحظه باشد."],[126,"سر مپوشان تا پدید آید سرم","امر کن تو، هرچه بر وی قادرم","راز خود را پنهان نکن که تا راز من آشکار شود. تو هرچه بر او می‌توانی فرمان بده."],[126,"دل مپوشان تا پدید آید دلم","تا قبول آرم هر آنچ قابلم","دل خود را پنهان نکن تا احساسات و عشق من آشکار شود، زیرا من آماده‌ام تا هر چیزی را که شایسته‌ام بپذیرم."],[126,"چون کنم در دست من چه چاره است","درنگر تا جان من چه کاره است","بگویم چکار باید بکنم وقتی در دست من چاره‌ای نیست؛ حالا نگاه کن ببین جان من چه وضعیتی دارد."],[127,"گفت زن یک آفتابی تافتست","عالمی زو روشنایی یافتست","زن به مانند خورشید است که نورش جهان را روشن کرده و باعث روشنی و زندگی در آن می‌شود."],[127,"نایب رحمان خلیفه کردگار","شهر بغدادست از وی چون بهار","نایب رحمان، نماینده خداوند بر روی زمین و خلیفه او در شهر بغداد است و او مثل بهار، باعث تازگی و سرسبزی می‌شود."],[127,"گر بپیوندی بدان شه شه شوی","سوی هر ادبیر تا کی می‌روی","اگر با آن پادشاه پیوندی برقرار کنی، به مقام و جایگاه بالاتری دست پیدا خواهی کرد و به هر ادب و فرهنگ و دانشی راه خواهی یافت. پس تا چه زمانی می‌خواهی به تنهایی و بدون همراهی پیش بروی؟"],[127,"همنشینی با شهان چون کیمیاست","چون نظرشان کیمیایی خود کجاست","نشستن و مشورت کردن با پادشاهان و افراد بزرگ، مانند طلا و کیمیا ارزشمند و گرانبها است. اما باید توجه کرد که این کیفیت و ارزش را در خود نمی‌توان پیدا کرد و آن در نگاه و نظر آن‌هاست."],[127,"چشم احمد بر ابوبکری زده","او ز یک تصدیق صدیق آمده","چشم احمد (پیامبر اسلام) به ابوبکر (دوست نزدیک و نخستین خلافت وی) نگریسته است و او با یک تأیید، صدیق (شخصیت راستگو) شده است."],[127,"گفت من شه را پذیرا چون شوم","بی بهانه سوی او من چون روم","گفت من چگونه می‌توانم بدون هیچ بهانه‌ای به سوی شاه بروم و او را بپذیرم؟"],[127,"نسبتی باید مرا یا حیلتی","هیچ پیشه راست شد بی‌آلتی","برای نزدیکی به مقام و موقعیتی که می‌خواهم، یا باید رابطه‌ای بر قرار کنم یا تدبیری بیندیشم، زیرا بدون ابزار و وسیله، به نتیجه‌ای پایدار نخواهم رسید."],[127,"همچو مجنونی که بشنید از یکی","که مرض آمد به لیلی اندکی","چون مجنونی که از کسی شنید لیلی بیمار شده، دچار حیرت و آشفتگی می‌شود."],[127,"گفت آوه بی بهانه چون روم","ور بمانم از عیادت چون شوم","گفت: ای آوه! بی‌دلیل به جایی نروم، و اگر هم بمانم برای عیادت، به چه دلیل این کار را انجام دهم؟"],[127,"لیتنی کنت طبیبا حاذقا","کنت امشی نحو لیلی سابقا","ای کاش من پزشک ماهری بودم که می‌توانستم به سوی لیلی بروم، همان‌طور که قبلا می‌رفتم."],[127,"قل تعالوا گفت حق ما را بدان","تا بود شرم‌اشکنی ما را نشان","خداوند می‌گوید بیایید و از آنچه می‌خواهید آگاه شوید، زیرا ما را به وسیله شرم و خجالت‌های‌تان می‌شناسید."],[127,"شب‌پران را گر نظر و آلت بدی","روزشان جولان و خوش حالت بدی","اگر به شب‌پران (پرندگان شب‌پرواز) نگاهی افکنیم و او را با زیبایی و توانمندی ببینی، روزشان پر از شادی و خوشحالی خواهد بود."],[127,"گفت چون شاه کرم میدان رود","عین هر بی‌آلتی آلت شود","اگر شاه کرم، یعنی خداوند، در میدان حضور یابد، مانند هر چیزی که فاقد ابزار و قدرت است، آن چیز نیز به آلت و ابزار تبدیل خواهد شد. یعنی حضور پر قدرت خداوند همه چیز را تحت تأثیر قرار می‌دهد و حتی ممکن است چیزها را از حالت معمولی خود خارج کند."],[127,"زانک آلت دعوی است و هستی است","کار در بی‌آلتی و پستی است","زیرا ابزار (وسایل) برای نشان دادن دعوی و وجود انسان است، و کار در بی‌وسایلی و در پستی و ضعف است."],[127,"گفت کی بی‌آلتی سودا کنم","تا نه من بی‌آلتی پیدا کنم","می‌گوید که آیا می‌توانم بدون ابزار و وسیله‌ای (کمک) کار معاملاتی انجام دهم، در حالی که باید خودم نیز بدون ابزار و کمک نباشم؟"],[127,"پس گواهی بایدم بر مفلسی","تا مرا رحمی کند شاه غنی","پس باید گواهی بر بی‌پولی و فقر خود ارائه دهم تا از طرف شاه ثروتم، رحمی شامل حال من شود."],[127,"تو گواهی غیر گفت و گو و رنگ","وا نما تا رحم آرد شاه شنگ","تو باید نشان بدهی چیزی غیر از گفتار و ظاهر خودت، تا شاه ثروتمند به تو رحم کند."],[127,"کین گواهی که ز گفت و رنگ بد","نزد آن قاضی القضاة آن جرح شد","گواهی که بر اساس سخن و ظاهر (رنگ و شکل) باشد، در پیش آن قاضی بزرگ (خدا) معتبر نیست و نزد او مورد قبول نیست، زیرا این نوع گواهی باعث ایجاد نقص و آسیب می‌شود."],[127,"صدق می‌خواهد گواه حال او","تا بتابد نور او بی قال او","برای اینکه حقیقت و واقعیت حال زن روشن شود و نور او نمایان گردد، نیاز به صداقت وجود دارد؛ این صداقت باید به گونه‌ای باشد که بدون هیچ سخنی، حقیقت او را نشان دهد."],[128,"گفت زن صدق آن بود کز بود خویش","پاک برخیزی تو از مجهود خویش","زن گفت: راست می‌گوید، آن چیز واقعی و درست است که تو از زحمات و مشقت‌های خود، پاک و دور شوی."],[128,"آب بارانست ما را در سبو","ملکت و سرمایه و اسباب تو","آب باران در سبوی ما نشانه اعتبار و ثروت و وسایل زندگی ماست."],[128,"این سبوی آب را بردار و رو","هدیه ساز و پیش شاهنشاه شو","این سبوی آب را بردار و به عنوان هدیه به امیرالمؤمنین (شاهنشاه) ببر."],[128,"گو که ما را غیر این اسباب نیست","در مفازه هیچ به زین آب نیست","بگویید که ما هیچ وسیله‌ای جز این آب نداریم و در مغازه‌ها چیزی بهتر از این آب وجود ندارد."],[128,"گر خزینه‌ش پر متاع فاخرست","این چنین آبش نباشد نادرست","اگرچه این خزانه پر از کالاهای ارزشمند است، اما اگر آب این منطقه این‌چنین باشد، دچار مشکل است و این وضعیت صحیح نیست."],[128,"چیست آن کوزه تن محصور ما","اندرو آب حواس شور ما","تن ما همچون یک کوزه است که در آن آب حواسی که ما را به هیجان می‌آورد، محصور شده است."],[128,"ای خداوند این خم و کوزه مرا","در پذیر از فضل الله اشتری","ای خدایا، لطفا این کوزه و خم من را بپذیر که از فضل و رحمت تو پر است."],[128,"کوزه‌ای با پنج لوله پنج حس","پاک دار این آب را از هر نجس","کوزه‌ای که پنج لوله دارد، نماد پنج حس انسان است و این آب (دانش یا معرفت) را از هر چیز ناپاکی دور نگه‌داشته است."],[128,"تا شود زین کوزه منفذ سوی بحر","تا بگیرد کوزه من خوی بحر","این بیت بیان می‌کند که باید مسیری از کوزه به دریا ایجاد شود تا کوزه بتواند از ویژگی‌های دریا بهره‌مند شود و به خوی و ذات دریایی خود دست یابد."],[128,"تا چو هدیه پیش سلطانش بری","پاک بیند باشدش شه مشتری","عرب، هدیه‌اش را به پیش سلطان می‌برد تا او (سلطان) که انسان پاکی است، این هدیه را ببیند و بپذیرد. در اینجا، سلطان به عنوان یک شخصیتی با ارزشی معرفی می‌شود که شایسته دریافت هدایای ارزنده است."],[128,"بی‌نهایت گردد آبش بعد از آن","پر شود از کوزه من صد جهان","آب این سبوی باران پس از آنکه به امیرالمؤمنین تقدیم شود، به حدی زیاد و فراوان خواهد شد که گویا از کوزه من صد جهان آب در آن است."],[128,"لوله‌ها بر بند و پر دارش ز خم","گفت غضوا عن هوا ابصارکم","لوله‌ها را ببندید و پر کنید از شراب، چون گفت: چشم‌هایتان را از نظر به هوا (فضای باز) منصرف کنید. اینجا اشاره به این دارد که هنگام نوشیدن شراب، باید توجه را به داخل معطوف کرد و از حواس بیرونی دور شد."],[128,"ریش او پر باد کین هدیه کراست","لایق چون او شهی اینست راست","ریش او پر از باد است؛ یعنی در اینجا به جای تمجید از او، به خاطر جایگاهش اشاره می‌کند که این هدیه برای او شایسته است. چون او پادشاهی است که شایسته این هدیه است."],[128,"زن نمی‌دانست کانجا برگذر","هست جاری دجله‌ای همچون شکر","زن نمی‌دانست که در اینجا در کنار گذر، دجله‌ای جاری است که مثل شکر شیرین و خوشبوست."],[128,"در میان شهر چون دریا روان","پر ز کشتیها و شست ماهیان","در وسط شهر، مانند دریا آب جاری است که پر از کشتی‌ها و ماهی‌هاست."],[128,"رو بر سلطان و کار و بار بین","حس تجری تحتها الانهار بین","به سوی سلطان و کار او نگاه کن، پس خواهی دید که حس و ادراک ما مانند نهرهایی زیر آن، در مقایسه با واقعیت بزرگ و عمیق او محدود و ناچیز است."],[128,"این چنین حسها و ادراکات ما","قطره‌ای باشد در آن نهر صفا","ادراکات و حواس ما تنها به میزان بسیار کمی شبیه به قطره‌ای در یک نهر بزرگ و زلال هستند."],[129,"مرد گفت آری سبو را سر ببند","هین که این هدیه‌ست ما را سودمند","مرد گفت که حتما سر سبوی آب باران را ببند، زیرا این هدیه‌ای است که برای ما سودمند خواهد بود."],[129,"در نمد در دوز تو این کوزه را","تا گشاید شه به هدیه روزه را","تو در نمد (پارچه) برای این کوزه بدوز که وقتی کارش تمام شد، شاه این هدیه را به عنوان هدیه روزه بگشاید."],[129,"کاین چنین اندر همه آفاق نیست","جز رحیق و مایه‌ی اذواق نیست","در تمامی جهان، چیزی به‌جز خوشی و لذت وجود ندارد و هیچ چیز دیگری که مایه طراوت و شادابی باشد، نیست."],[129,"زانک ایشان ز آبهای تلخ و شور","دایما پر علت‌اند و نیم‌کور","زیرا آن‌ها همیشه از آب‌های تلخ و شور سیراب می‌شوند و به همین خاطر علت‌های زیادی دارند و درک کمتری از حقیقت دارند."],[129,"مرغ کاب شور باشد مسکنش","او چه داند جای آب روشنش","پرنده‌ای که در آب‌های شور و تلخ زندگی می‌کند، نمی‌داند که آب پاک و زلال در کجا وجود دارد."],[129,"ای که اندر چشمه‌ی شورست جات","تو چه دانی شط و جیحون و فرات","ای کسی که در چشمه‌ای پر از شور زندگی می‌کنی، تو چه می‌دانی درباره‌ی رودها و جریان‌های بزرگ و شیرین مثل شط، جیحون و فرات؟"],[129,"ای تو نارسته ازین فانی رباط","تو چه دانی محو و سکر و انبساط","ای کسی که هنوز از قید و بندهای این دنیای زایا و فانی رها نشده‌ای، تو چه می‌دانی از حالاتی مانند محو، سکر (سرخوشی و مستی روحانی) و انبساط (شادمانی و گشایش در دل) که در عالم معنوی وجود دارد؟"],[129,"ور بدانی نقلت از آب و جدست","پیش تو این نامها چون ابجدست","اگر تو بدانی که نسل و ریشه‌ات از آب و گل است، در این صورت این نام‌ها و الفاظ که به سادگی مانند الفبای ابجد هستند، چه اهمیتی دارند؟"],[129,"ابجد و هوز چه فاش است و پدید","بر همه طفلان و معنی بس بعید","حروف الفبا و چیزهایی مانند ابجد و هوز برای همه بچه‌ها کاملا روشن و واضح است، اما معنای عمیق و واقعی آنها برای مردم عادی بسیار دور و ناواضح است."],[129,"پس سبو برداشت آن مرد عرب","در سفر شد می‌کشیدش روز و شب","آن مرد عرب در سفر، سبویی که برداشت کرده بود را طول روز و شب می‌کشید و با خود می‌برد."],[129,"بر سبو لرزان بد از آفات دهر","هم کشیدش از بیابان تا به شهر","آن سبوی آب باران که مرد عرب با خود داشت، در مسیر سفر به دلیل مشکلات و خطرات زمانه دچار لرزش و آسیب شده بود. او تلاش کرده بود تا این سبو را از دل بیابان به شهر برساند."],[129,"زن مصلا باز کرده از نیاز","رب سلم ورد کرده در نماز","زن عربی که از نیاز و درخواست به خداوند، سجاده‌اش را باز کرده و در حال خواندن دعای «سلم» (سلامتی) در نماز است."],[129,"که نگه‌دار آب ما را از خسان","یا رب آن گوهر بدان دریا رسان","ای خدا، نگهدار آب زندگی ما را از انسان‌های ناپاک و بی‌ارزش (خسان) باش و لطف کن که آن گوهر ارزشمند (روح یا حقیقت) را به دریا (وصل به حقیقت مطلق یا عشق الهی) برسانی."],[129,"گرچه شویم آگهست و پر فنست","لیک گوهر را هزاران دشمنست","هرچند ما از دانش و فنون آگاه و باخبر هستیم، اما گوهر و حقیقت ارزشمند ما (یعنی آب معنوی) دشمنان زیادی دارد که می‌خواهند به آن آسیب برسانند."],[129,"خود چه باشد گوهر، آب کوثرست","قطره‌ای زینست کاصل گوهرست","جوهر اصلی وجود انسان، مانند آب کوثر، بسیار باارزش و نادر است و آن ارزش را از قطره‌ای که در آن است به دست نمی‌آورد."],[129,"از دعاهای زن و زاری او","وز غم مرد و گران‌باری او","زن عرب به خاطر مشکلات و دردهای زندگی‌اش دعا می‌کند و زاری می‌کند، و همچنین غم و بار سنگین مرد نیز باعث نگرانی و ناراحتی اوست."],[129,"سالم از دزدان و از آسیب سنگ","برد تا دار الخلافه بی‌درنگ","از دزدان و خطرات سنگ‌ها در امان بمان و بی‌درنگ به دارالخلافه (پایتخت) برو."],[129,"دید درگاهی پر از انعامها","اهل حاجت گستریده دامها","مولانا مشاهده می‌کند که در آنجا، دربسته‌ای پر از نعمت‌ها و بخشش‌های خداوند وجود دارد و افرادی که نیازمند هستند، به سوی آنجا هجوم آورده‌اند تا از این انعام‌ها بهره‌مند شوند."],[129,"دم بدم هر سوی صاحب‌حاجتی","یافته زان در عطا و خلعتی","هر لحظه از آن در، شخصی که نیاز دارد به عطا و بخشش‌هایی دست می‌یابد و از هدیه‌ها بهره‌مند می‌شود."],[129,"بهر گبر و مؤمن و زیبا و زشت","همچو خورشید و مطر نی چون بهشت","برای هر کس، چه کافر و چه مؤمن، و چه زیبا و چه زشت، نعمت‌ها و برکاتی وجود دارد که به مانند خورشید و باران همگانی است و بهشت مختص به جمع خاصی نیست."],[129,"دید قومی در نظر آراسته","قوم دیگر منتظر بر خاسته","برخی از افراد خود را با ویژگی‌های خوب و زیبا به نمایش گذاشته‌اند، در حالی که گروهی دیگر در انتظار هستند تا به آن‌ها توجه شود و معرفی شوند."],[129,"خاص و عامه از سلیمان تا بمور","زنده گشته چون جهان از نفخ صور","خاص و عام و همه انسان‌ها از سلیمان (پیامبر و پادشاه معروف) تا بمور (احتمالا به معنای دیگر مخلوقات) با دمیدن صور (شیپور) زنده شده‌اند، همچنان که جهان در اثر این دمیدن به حیات بازگشته است."],[129,"اهل صورت در جواهر بافته","اهل معنی بحر معنی یافته","آدم‌های ظاهربین و دلبسته به دنیا، در بافتن مواد ظاهری مهارت دارند، اما اهل معنا و حقیقت، در عمق معانی و مفاهیم به مانند دریا شناور هستند و از آن بهره‌مند شده‌اند."],[129,"آنک بی همت چه با همت شده","وانک با همت چه با نعمت شده","آن که بی‌کوشش و تلاش است، در واقع در مقام و موقعیتی مبتذل قرار دارد و آن که با تلاش و پشتکار به مقام می‌رسد، از نعمت و برکت برخوردار می‌شود."],[130,"بانگ می‌آمد که ای طالب بیا","جود، محتاج گدایان چون گدا","صدایی می‌آمد که ای طالب، بیا و محبت را بپذیر؛ چراکه گدایان هم به این محبت نیاز دارند، همان‌طور که یک گدا به بخشش و محبت نیازمند است."],[130,"جود می‌جوید گدایان و ضعاف","همچو خوبان کآینه جویند صاف","گدایان و افراد نیازمند مانند زیبایی‌ها که به دنبال آینه‌اند، همواره در جستجوی قدردانی و بخشش هستند. آن‌ها به دنبال جود و سخاوت هستند، زیرا این کار به زیبایی روح و دلشان می‌افزاید."],[130,"روی خوبان ز آینه زیبا شود","روی احسان از گدا پیدا شود","چهره زیبا و دل‌نواز خوبان مانند انعکاسی در آینه است، و وجه نامحسوس احسان و نیکی که از سوی گدا به دیگران می‌رسد، به وضوح نمایان می‌شود."],[130,"پس ازین فرمود حق در والضحی","بانگ کم زن ای محمد بر گدا","خداوند در ادامه فرمان می‌دهد که ای محمد، بر گدا فریاد نزن و ملاحظه کن که او در مقام گداست."],[130,"چون گدا آیینه جودست هان","دم بود بر روی آیینه زیان","گدا مانند آینه‌ای است که بخشش و کرم را نشان می‌دهد، اما اگر چیزی بر روی آینه باشد، نیکی و بخشندگی نمی‌تواند به وضوح دیده شود."],[130,"آن یکی جودش گدا آرد پدید","و آن دگر بخشد گدایان را مزید","خداوند (که به عنوان جود و کرم معرفی شده) به وسیله بخشش‌هایش، گدایان را آشکار می‌کند و در عین حال به گدایان افزایش نعمت می‌بخشد."],[130,"پس گدایان آیت جود حقند","وانک با حقند جود مطلقند","گداها نشانه و نماینده بخشندگی و جود الهی هستند و کسانی که با خداوند در ارتباط هستند، خود به نوعی تجلی جود مطلق هستند."],[130,"وانک جز این دوست او خود مرده‌ایست","او برین در نیست نقش پرده‌ایست","اگر جز عشق و محبت به معشوق، چیزی در وجود شخص نباشد، او مانند مرده‌ای است و در این دنیای عشق و محبت، نقشی ندارد."],[131,"نقش درویشست او نه اهل نان","نقش سگ را تو مینداز استخوان","این بیت می‌گوید که درویش واقعی کسی است که فقط به خدا وابسته است و نیازی به نان و لقمه ندارد؛ او مثل سگی نیست که برای گرفتن استخوان به دنبال نان باشد. درویش حقیقی به مقام معنوی اهمیت می‌دهد و نه به نیازهای مادی."],[131,"فقر لقمه دارد او، نه فقر حق","پیش نقش مرده‌ای کم نه طبق","او فقط نیاز به لقمه‌ای دارد و فقیری در زمینه معنوی و حقیقت ندارد. به نوعی دیگر، او به چیزهای سطحی و ظاهری وابسته است، نه به حقیقت عمیق و واقعی."],[131,"ماهی خاکی بود درویش نان","شکل ماهی لیک از دریا رمان","درویشی که به زندگی مادی و پیروزی دنیوی مانند نان و زندگی معمولی نظر دارد، مانند ماهی‌ای است که از خاک بیرون آمده و در حالی که شکلی شبیه ماهی را دارد، اما در واقع از دریا و آب دور است و نمی‌تواند بطور واقعی زندگی کند."],[131,"مرغ خانه‌ست او نه سیمرغ هوا","لوت نوشد او ننوشد از خدا","او، یک موجود زمین‌گیر و بی‌خبر از آسمان است و به خاطر وابستگی به زندگی مادی، تنها از نعمت‌های همین دنیا بهره‌مند می‌شود، ولی از خداوند چیزی نمی‌نوشد و به او دسترسی ندارد."],[131,"عاشق حقست او بهر نوال","نیست جانش عاشق حسن و جمال","عاشق خداوند است و هدفی جز دریافت نعمت‌های او ندارد. جانش تنها به زیبایی و محبت خداوند علاقه‌مند است."],[131,"گر توهم می‌کند او عشق ذات","ذات نبود وهم اسما و صفات","اگر او تنها عشق به خدا را در تصورات خود می‌سازد، باید بداند که عشق به ذات خداوند حقیقی نیست و فقط وابسته به نام‌ها و ویژگی‌های الهی است."],[131,"وهم مخلوقست و مولود آمدست","حق نزاییده‌ست او لم یولدست","وهم، چیزی ساخته و پرداخته ذهن بشر است و از حقیقت به وجود نیامده است، در حالی که حق (خداوند) نه مخلوق است و نه زاییده، بلکه ازلی و ابدی است و هیچ چیز به او تعلق ندارد."],[131,"عاشق تصویر و وهم خویشتن","کی بود از عاشقان ذوالمنن","عاشق کسی که فقط به تصویر و تصور خود عشق ورزد، جزو عاشقان خداوند نیست."],[131,"عاشق آن وهم اگر صادق بود","آن مجاز او حقیقت‌کش شود","اگر آن عشق و خیالی که انسان به آن مشغول است واقعی باشد، تبدیل به حقیقت می‌شود و موجب نجات او از دنیای مجازی و خیال‌پردازی می‌گردد."],[131,"شرح می‌خواهد بیان این سخن","لیک می‌ترسم ز افهام کهن","می‌خواهم این سخن را توضیح دهم، اما از نگرانی برای این که فهم قدیمی و محدود باعث سوءتفاهم نشود، می‌ترسم."],[131,"فهمهای کهنه کوته‌نظر","صد خیال بد در آرد در فکر","فهم‌های محدود و قدیمی، افکار و تصورات نادرست و بدی را در ذهن می‌آورند."],[131,"بر سماع راست هر کس چیر نیست","لقمه هر مرغکی انجیر نیست","در مجال سماع و خوش‌نوازی، هر کسی به اندازه درک و توان خود نمی‌تواند لذت ببرد، زیرا هر مرغکی (هر شخص) نمی‌تواند به یک لقمه خاص (معنای عمیق و ارزشمند) دست پیدا کند."],[131,"خاصه مرغی مرده‌ای پوسیده‌ای","پرخیالی اعمیی بی‌دیده‌ای","ای این مرغ خاص، که مرده و بی‌ارزش است و خیال‌هایی در سر دارد، به مانند کسی است که بینایی ندارد و نمی‌تواند حقیقت را ببیند."],[131,"نقش ماهی را چه دریا و چه خاک","رنگ هندو را چه صابون و چه زاک","منظور از « زاک » در اینجا گویا زاج زرد است که ماده‌ای است معدنی که در بهداشت و طب سنتی برای تمیز کردن پوست استفاده می‌شود."],[131,"نقش اگر غمگین نگاری بر ورق","او ندارد از غم و شادی سبق","هر نقشی که بر روی کاغذ رسم شده، اگر غمگین باشد، هیچ تأثیری از شادی و اندوه بر روی آن باقی نمی‌گذارد. این جمله به این نکته اشاره دارد که احساسات واقعی نمی‌توانند فقط در یک شکل ظاهری محدود بمانند و درون حقیقت آن اثر، تاثیری از شادی یا غم وجود ندارد."],[131,"صورتش غمگین و او فارغ از آن","صورتش خندان و او زان بی‌نشان","ظاهر او غمگین است، اما درونش از آن غم رها و شاداب است؛ و در حقیقت، آدمی که در درونش شاداب است، بر پایه آن ظاهر افسرده بی‌توجه است."],[131,"وین غم و شادی که اندر دل حظیست","پیش آن شادی و غم جز نقش نیست","غم و شادی که در دل وجود دارد، تنها بهره‌ای از آن است و پیش از آن شادی و غم واقعی در عالم هستی، فقط یک تصویر و نشانه به حساب می‌آید."],[131,"صورت غمگین نقش از بهر ماست","تا که ما را یاد آید راه راست","غم و اندوهی که در زندگی ما وجود دارد، تنها نمایشی است که برای ما فراهم شده تا از طریق آن به یادآوریم که باید مسیر درست را پیدا کنیم."],[131,"صورت خندان نقش از بهر تست","تا از آن صورت شود معنی درست","چهره‌ی شاد و خندان در این تصویر برای توست تا با دیدن این چهره، به درک درست و حقیقی برسید."],[131,"نقشهایی کاندرین حمامهاست","از برون جامه‌کن چون جامه‌هاست","نقش‌هایی که در حمام‌ها مشاهده می‌شود، مانند لباس‌های شما هستند؛ وقتی که لباس‌ها را درآورید، آن نقش‌ها نیز باقی خواهند ماند."],[131,"تا برونی جامه‌ها بینی و بس","جامه بیرون کن درآ ای هم‌نفس","تنها به تماشای ظواهر نپرداز و فقط به آن‌ها قناعت نکن، بلکه برای رسیدن به عمق و حقیقت، زودتر از ظواهر بکنار برو و به درون خودت نگریست."],[131,"زانک با جامه درون سو راه نیست","تن ز جان، جامه ز تن آگاه نیست","چون جسم از جان بی‌خبر است، بنابراین لباس درونی (حجاب‌های روحی و معنوی) نمی‌تواند به سویی راه ببرد؛ یعنی انسان در حقیقت از جوهره وجود خود آگاه نیست و فقط با لباس ظاهری خود در ارتباط است."],[132,"آن عرابی از بیابان بعید","بر در دار الخلافه چون رسید","آن عرابی (بدوی) که از بیابانی دور آمد، وقتی به درگاه خلافت رسید،"],[132,"پس نقیبان پیش او باز آمدند","بس گلاب لطف بر جیبش زدند","پس از اینکه آن عرابی به دربار رسید، نقیبان (دربانان) به سمت او برگشتند و به نشانه احترام و محبت، گلاب (عطر) لطف و محبت بر لباس او پاشیدند."],[132,"حاجت او فهمشان شد بی مقال","کار ایشان بد عطا پیش از سئوال","کار آنها بدون اینکه نیازی به پرسش باشد، آغاز شد و حاجت اعرابی به خوبی درک شد. این نشان‌دهنده آن است که آنها به سرعت و بدون وقفه، اقدام کردند."],[132,"پس بدو گفتند یا وجه العرب","از کجایی چونی از راه و تعب","به او گفتند، ای برادر عرب، تو از کجا آمده‌ای و از چه راهی سفر کرده‌ای که این‌قدر خسته به نظر می‌رسی؟"],[132,"گفت وجهم گر مرا وجهی دهید","بی وجوهم چون پس پشتم نهید","اعرابی می‌گوید: اگر مرا مقام و ارزشی بدهید، خوب است، اما اگر بدون ارزش و اعتبار باشم، مانند کسی هستم که از پشت خودکار غیرت ندارد و نمی‌تواند به جلو پیش برود."],[132,"ای که در روتان نشان مهتری","فرتان خوشتر ز زر جعفری","ای کسی که در چهره‌تان نشانه‌های بزرگی و مهتری دیده می‌شود، زیبایی شما برای من از زر زرد رنگ هم دلپذیرتر است."],[132,"ای که یک دیدارتان دیدارها","ای نثار دینتان دینارها","ای کسی که یک بار دیدن شما، بر همه دیدارها برتری دارد، و محبت و نیکی شما، ارزش دینارها (پول) را پیدا کرده است."],[132,"ای همه ینظر بنور الله شده","بهر بخشش از بر شه آمده","ای کسانی که به نور خداوند نگریسته‌اید، برای بخشش و عطا از سوی پادشاه به اینجا آمده‌اید."],[132,"تا زنید آن کیمیاهای نظر","بر سر مسهای اشخاص بشر","چنان‌چه شما با نگاه ویژه و لطف خود به انسان‌ها توجه کنید، آن‌ها مانند مس به طلا تبدیل می‌شوند؛ یعنی با نگاه شما به ارزش و مقام بالاتری دست می‌یابند."],[132,"من غریبم از بیابان آمدم","بر امید لطف سلطان آمدم","من از یک بیابان دور و ناشناخته آمده‌ام و به امید محبت و لطف سلطان به اینجا آمده‌ام."],[132,"بوی لطف او بیابانها گرفت","ذره‌های ریگ هم جانها گرفت","لطف و مهربانی او چنان فراگیر شد که حتی بو و رایحه‌اش به دوردست‌های بیابان رسید و ذره‌های ریز شن هم به دلیل این محبت جان‌دار شدند."],[132,"تا بدین جا بهر دینار آمدم","چون رسیدم مست دیدار آمدم","من برای رسیدن به ثروت و دینار سفر کردم، اما حالا که به اینجا رسیدم، مجذوب و شادمان از دیدار شدم."],[132,"بهر نان شخصی سوی نانبا دوید","داد جان چون حسن نانبا را بدید","شخصی به خاطر نان و خوردن به سوی نانوا دوید و وقتی حسن نانوا را دید، جانش به شوق آمد."],[132,"بهر فرجه شد یکی تا گلستان","فرجه او شد جمال باغبان","برای خوشحال کردن باغبان، یکی به بهانه گلستان آمد و به آن باغبان که زیبایی باغ را دارد، احترام گذاشت."],[132,"همچو اعرابی که آب از چه کشید","آب حیوان از رخ یوسف چشید","اعرابی همچون کسی است که نمی‌داند آب را از کجا باید برداشت، اما با زیبایی یوسف (که به زیبایی مشهور است) چشیده و لذت می‌برد. این تصویر نشان‌دهنده شگفتی و حیرت از جمال و جذابیت یوسف است."],[132,"رفت موسی کآتش آرد او بدست","آتشی دید او که از آتش برست","موسی (پیامبر) رفت تا آتش را بیاورد، اما به جای آن آتشی را دید که از آتش جدا شده بود."],[132,"جست عیسی تا رهد از دشمنان","بردش آن جستن به چارم آسمان","عیسی در تلاش است که از دشمنانش فرار کند و این تلاش او به مرحله‌ای رسیده که به آسمان چهارم می‌رسد."],[132,"دام آدم خوشه گندم شده","تا وجودش خوشه مردم شده","دام آدم به خوشه گندم تبدیل شده است تا وجود او که از جنس انسان است، به مانند خوشه مردم درآید. بدین معنی که آدم، به عنوان انسانی که در جمع انسان‌ها قرار دارد، به چیزی پربار و مثمرثمر تبدیل شده است."],[132,"باز آید سوی دام از بهر خور","ساعد شه یابد و اقبال و فر","انسان دوباره به دام و دانه برمی‌گردد تا از آن بهره‌مند شود، و به وسیله کمک و حمایت شاه، به روزی و خوشبختی دست پیدا می‌کند."],[132,"طفل شد مکتب پی کسب هنر","بر امید مرغ با لطف پدر","کودک در مدرسه مشغول یادگیری هنر است و به امید اینکه با لطف و محبت پدرش، آینده‌ای خوب و موفق داشته باشد، تلاش می‌کند."],[132,"پس ز مکتب آن یکی صدری شده","ماهگانه داده و بدری شده","پس از اینکه آن شخص در مکتب آموزش دیده و به علو مقام رسیده، مانند ماه درخشان و تابان شده و در علم و دانش به‌سوی بی‌کرانگی (بدری) رسیده است."],[132,"آمده عباس حرب از بهر کین","بهر قمع احمد و استیز دین","عباس حرب به خاطر کینه‌توزی و انتقام از احمد آمده است تا دین را سرکوب کند و آن را نادیده بگیرد."],[132,"گشته دین را تا قیامت پشت و رو","در خلافت او و فرزندان او","دین تا روز قیامت به خاطر خلافت او و فرزندانش دچار دگرگونی و تزلزل شده است."],[132,"من برین در طالب چیز آمدم","صدر گشتم چون به دهلیز آمدم","من برای طلب چیزی به این در آمده‌ام و وقتی وارد این راهرو شدم، به مقامی عالی رسیدم."],[132,"آب آوردم به تحفه بهر نان","بوی نانم برد تا صدر جنان","من برای نانی تحفه (هدیه) آورده‌ام، کما اینکه بوی نان مرا به بالاترین مرتبه بهشت می‌برد."],[132,"نان برون راند آدمی را از بهشت","نان مرا اندر بهشتی در سرشت","نان باعث شد که آدم از بهشت خارج شود، اما نان من در ذات خود بهشتی است."],[132,"رستم از آب و ز نان همچون ملک","بی‌غرض گردم برین در چون فلک","من از آب و نان، مانند یک موجود آسمانی به مقام بلند می‌رسم و در این دنیا بدون هیچ هدفی متعالی و بی‌غرض هستم."],[132,"بی‌غرض نبود بگردش در جهان","غیر جسم و غیر جان عاشقان","در جهان تنها عاشقان هستند که بدون هیچ هدف و غرضی، تنها به خاطر عشق، به دور آن می‌چرخند و فراق و دلبستگی را تجربه می‌کنند."],[133,"عاشقان کل نه عشاق جزو","ماند از کل آنک شد مشتاق جزو","عاشقان حقیقی و کامل، به عشق چیزهای جزئی و محدود مشغول نمی‌شوند. وقتی که کسی به چیزی جزئی علاقه‌مند شود، چنانچه به آن وابسته گشت، تمام وجودش از آن چیز منفک می‌شود و به آن وابستگی نمی‌یابد."],[133,"چونک جزوی عاشق جزوی شود","زود معشوقش بکل خود رود","وقتی کسی جزئی به چیزی عشق می‌ورزد، معشوقش به طور کامل از او دور می‌شود."],[133,"ریش گاو و بنده غیر آمد او","غرقه شد کف در ضعیفی در زد او","مردی که وابسته به دیگران است و به جای خود را با دیگران می‌سازد، به ضعف و ناتوانی دچار می‌شود و در مشکلات غرق می‌گردد. این فرد همواره در پی قدرت و تسلط بر دیگران است، اما در واقع خود را تحت نفوذ آن‌ها قرار می‌دهد و توانایی‌هایش را از دست می‌دهد."],[133,"نیست حاکم تا کند تیمار او","کار خواجه خود کند یا کار او","هیچ حاکمی در کار او نیست که به او رسیدگی کرده و از او مراقبت کند، بلکه خود او باید به حال خود رسیدگی کند."],[134,"فازن بالحرة پی این شد مثل","فاسرق الدرة بدین شد منتقل","به این معناست که اگر با زنی آزاد و باکره ازدواج کردی، خوشحال شو و اگر دست به سرقت زدی، باید به سرقت گرانبها و باارزش بپردازی. در واقع، این مثل به اهمیت انتخاب‌های درست و ارزش‌ها در زندگی اشاره دارد."],[134,"بنده سوی خواجه شد او ماند زار","بوی گل شد سوی گل او ماند خار","بنده به سوی آقایش رفت اما او در حال زاری و تاسف باقی ماند. بوی گل او را به سمت خود کشید، اما او فقط به خار مانده است و نتوانسته به گل برسد."],[134,"او بمانده دور از مطلوب خویش","سعی ضایع، رنج باطل، پای ریش","او دور از هدف و خواسته‌اش مانده و تلاش‌هایش بیهوده و رنجش بی‌فایده است و مانند کسی است که با پای ریش، به دنبال چیزی می‌دود که به دست نمی‌آورد."],[134,"همچو صیادی که گیرد سایه‌ای","سایه کی گردد ورا سرمایه‌ای","شخصی مانند صیاد که فقط سایه‌ای را می‌گیرد، چگونه می‌تواند آن سایه را به سرمایه‌ای تبدیل کند؟ اشاره به این دارد که اگر کوشش بیهوده و بی‌هدف باشد، هیچ تحقق یا بهره‌ای به همراه نخواهد داشت."],[134,"سایه مرغی گرفته مرد سخت","مرغ حیران گشته بر شاخ درخت","مردی که سایه‌ی یک پرنده را دیده، به شدت شگفت‌زده و گیج شده است و به همین خاطر بر درخت نشسته و به این سایه خیره شده است."],[134,"کین مدمغ بر کی می‌خندد عجب","اینت باطل اینت پوسیده سبب","این شخص از چه کسی می‌خندد یا به چه چیز مشغول است؟ شگفت اینجاست که این موضوع بی‌اساس و پوچ است."],[134,"ور تو گویی جزو پیوسته کلست","خار می‌خور خار مقرون گلست","اگر تو بگویی که جزئی از کل هستی، باید به این نکته توجه کنی که خار را می‌خوری، در حالی که خار در کنار گل است."],[134,"جز ز یک رو نیست پیوسته به کل","ورنه خود باطل بدی بعث رسل","پیوندی که بین یک بخش و کل وجود دارد، تنها از یک جنبه واقعی است وگرنه اگر این پیوند از جوهر حقیقت نباشد، خود آن نیز بی‌معنا و بی‌اساس خواهد بود."],[134,"چون رسولان از پی پیوستنند","پس چه پیوندندشان چون یک تنند","وقتی رسولان به دنبال ایجاد ارتباط و پیوستگی هستند، دیگر چه پیوندی می‌توانند با خود داشته باشند، زیرا آن‌ها مانند یک شخص واحد هستند."],[134,"این سخن پایان ندارد ای غلام","روز بیگه شد حکایت کن تمام","این صحبت هیچ‌گاه تمام نمی‌شود، ای پسر! شب شده است، پس داستان را بی‌وقفه بگو."],[135,"آن سبوی آب را در پیش داشت","تخم خدمت رادر آن حضرت بکاشت","او سبوی آب را به عنوان هدیه در مقابل خود داشت و در آن موقع به نشانه خدمت‌گذاری و احترام، می‌خواست خدمتی به آن پادشاه (سلطان) انجام دهد."],[135,"گفت این هدیه بدان سلطان برید","سایل شه را ز حاجت وا خرید","گفت این هدیه را به آن سلطان بدهید، تا درخواستی که از طرف مردم (سایل) برای او آمده است، برآورده شود."],[135,"آب شیرین و سبوی سبز و نو","ز آب بارانی که جمع آمد به گو","آب شیرین و سبوی سبز که با آب باران پر شده، به خوبی و تازگی جلوه می‌کند، چون این آب بارانی به هم جمع آمده است."],[135,"خنده می‌آمد نقیبان را از آن","لیک پذرفتند آن را همچو جان","نقیبان (نگهبانان) از آن هدیه خنده‌شان گرفته بود، اما آن را با محبت و احترام پذیرفتند، گویی آن هدیه برایشان مانند جان dear و عزیز است."],[135,"زانک لطف شاه خوب با خبر","کرده بود اندر همه ارکان اثر","زیرا مهربانی و لطف شاه خوب، در تمام جوانب زندگی و امور، تأثیرگذار بوده و همه چیز را تحت تأثیر خود قرار داده است."],[135,"خوی شاهان در رعیت جا کند","چرخ اخضر خاک را خضرا کند","خوی و رفتار پادشاهان در میان مردم عادی جا می‌گیرد و به این ترتیب، زندگی و وضعیت زمین (خاک) را نیز به حالت خوب و سرسبز در می‌آورد."],[135,"شه چو حوضی دان حشم چون لوله‌ها","آب از لوله روان در گوله‌ها","پادشاه مانند حوضی است که غلامان او به مانند لوله‌هایی می‌باشند که آب جریان دارد و به همه می‌رسد. به این ترتیب، پادشاه با توزیع خوبی که دارد، نیکی و نعمت را به رعیت می‌رساند."],[135,"چونک آب جمله از حوضیست پاک","هر یکی آبی دهد خوش ذوقناک","چون آب همه از حوضی پاک و زلال است، هر کدام از لوله‌ها آبی خوش‌طعم و لذت‌بخش می‌دهد."],[135,"ور در آن حوض آب شورست و پلید","هر یکی لوله همان آرد پدید","اگر در آن حوض، آب شور و کثیف باشد، هر لوله‌ای همان نوع آب را به‌وجود می‌آورد و از آن می‌ریزد."],[135,"زانک پیوستست هر لوله به حوض","خوض کن در معنی این حرف خوض","چون هر لوله به حوض متصل است، در معنی این کلام به دقت فکر کن."],[135,"لطف شاهنشاه جان بی‌وطن","چون اثر کردست اندر کل تن","لطف و مرحمت شاهنشاه (که به معنای خدا یا موجودی بزرگ است) مانند اثری است که بی‌وطن بودنش در تمام وجود انسان حس می‌شود. در واقع، این لطف به صورت عمیق در جان انسان‌ها نفوذ کرده است."],[135,"لطف عقل خوش‌نهاد خوش‌نسب","چون همه تن را در آرد در ادب","لطف و مهربانی عقل پاک و نیک‌سرشت مانند این است که همه وجود انسان را در ادب و تربیت به ‌سوی خود مشغول می‌سازد."],[135,"عشق شنگ بی‌قرار بی سکون","چون در آرد کل تن را در جنون","عشق شنگ (شاد و سرزنده) باعث بی‌قراری و بی‌سکونی است و هنگامی که در وجود انسان بروز کند، تمامی وجود او را به حالتی جنون‌آلود درمی‌آورد."],[135,"لطف آب بحر کو چون کوثرست","سنگ‌ریزه‌ش جمله در و گوهرست","لطف و زیبایی آب دریا مانند کوثر (چشمه‌ای در بهشت) است و هر ذره‌ای از آن، همچون سنگ‌ریزه‌ها، درخشندگی و ارزش بالایی دارد."],[135,"هر هنر که استا بدان معروف شد","جان شاگردان بدان موصوف شد","هر هنری که استاد به آن مشهور است، جان شاگردان هم به همان هنر توصیف و شناخته می‌شود."],[135,"پیش استاد اصولی هم اصول","خواند آن شاگرد چست با حصول","شاگرد زرنگ و تیزهوش، در حضور استاد که در رشته اصول (اصول فقه) معروف است، به یادگیری اصول پرداخت و مطالب را به خوبی فرا گرفت."],[135,"پیش استاد فقیه آن فقه‌خوان","فقه خواند نه اصول اندر بیان","شاگرد در محضر استاد فقیه درس فقه می‌خواند و در اینجا به جای یادگیری اصول فقه، فقط به یادگیری خود فقه می‌پردازد."],[135,"پیش استادی که او نحوی بود","جان شاگردش ازو نحوی شود","نزد استادی که متخصص ادبیات و نحو (قواعد زبان) است، جان شاگردش به تأثیر او می‌تواند دانشمند و متخصص در این حوزه شود."],[135,"باز استادی که او محو رهست","جان شاگردش ازو محو شهست","استادی که خود به صورت کامل در مسیر عشق و حقیقت غرق شده است، جان شاگردش را نیز در این حالت وهمی و شهودی قرار می‌دهد، به طوری که او نیز مانند استاد به جذب عشق و حقیقت می‌پردازد."],[135,"زین همه انواع دانش روز مرگ","دانش فقرست ساز راه و برگ","از بین همه انواع دانش و دانایی، در روز مرگ، فقر و نیاز به دانش در راه زندگی و ابزار آن است."],[136,"آن یکی نحوی به کشتی در نشست","رو به کشتیبان نهاد آن خودپرست","یک دانشمند وارد کشتی شد و با خودپسندی و فخر فروشی رو به ناخدا کرد و گفت"],[136,"گفت هیچ از نحو خواندی گفت لا","گفت نیم عمر تو شد در فنا","آیا چیزی از علم و قوائد نوشتاری میدانی؟ ناخدا گفت نه دانشمند گفت پس نصف عمر تو تباه شده است"],[136,"دل‌شکسته گشت کشتیبان ز تاب","لیک آن دم کرد خامش از جواب","ناخدا از این حرف دانشمند ناراحت شد اما در آن لحظه جوابی به او نداد"],[136,"باد کشتی را به گردابی فکند","گفت کشتیبان بدان نحوی بلند","باد کشتی را به دام یک گرداب انداخت و کشتیبان را به تلاطم واداشت سپس کشتیبان با صدای بلند به نحوی گفت:"],[136,"هیچ دانی آشنا کردن بگو","گفت نی ای خوش‌جواب خوب‌رو","هیچ می‌دانی از نحوه شنا کردن ؟ نحوی پاسخ داد: نه ای خوش سخن"],[136,"گفت کل عمرت ای نحوی فناست","زانک کشتی غرق این گردابهاست","کشتیبان گفت تمام عمر تو فقط به هدر رفته است، زیرا این قایق همیشه در معرض غرق شدن است"],[136,"محو می‌باید نه نحو اینجا بدان","گر تو محوی بی‌خطر در آب ران","اینجا باید در مشیت الهی و اتفاقاتی که به خواست خدا رخ میدهد رها شوی و به دنبال قانون و قواعد نباشی. اگر که کاملا تسلیم شوی دیگر از غرق شدن نمیترسی"],[136,"آب دریا مرده را بر سر نهد","ور بود زنده ز دریا کی رهد","در دریا فقط زمانی که مثل یک مرده تسلیم شوی و تلاشی برای نجات پیدا کردن نکنی دریا تورا رها میکند اما اگر دست و پا بزنی و فکرکنی که میتوانی برای نجات خودت کاری انجام دهی نمیتوانی از دریا رها شوی"],[136,"چون بمردی تو ز اوصاف بشر","بحر اسرارت نهد بر فرق سر","وقتی که از قانون و قوائد انسان فانی رها شدی دریای اسرار به روی تو در باز میکند"],[136,"ای که خلقان را تو خر می‌خوانده‌ای","این زمان چون خر برین یخ مانده‌ای","تو که همیشه فکرمیکردی انسان های دیگر که از علوم تو سر در نمی‌آورند احمق هستند، حالا با تمام علم و دانشت در این شرایط نمیدانی که باید چه کنی"],[136,"گر تو علامه زمانی در جهان","نک فنای این جهان بین وین زمان","تو که فکرمیکردی در این جهان دانشمند و عالمی اینک با چشم خودت ببین که جهانی که در آن تو همه چیز دان بودی چطور ازبین میرود و چقدر فانی است"],[136,"مرد نحوی را از آن در دوختیم","تا شما را نحو محو آموختیم","از مرد نحوی استفاده کردیم تا به شما بیاموزیم که چطور در دریای تلاطم های زندگی تسلیم شوید و گاهی فقط تماشا کردن را بیاموزید"],[136,"فقه فقه و نحو نحو و صرف صرف","در کم آمد یابی ای یار شگرف","تمام علوم در مقابل قانون تسلیم شدن و صرفا ناظر بودن کم می آورند"],[136,"آن سبوی آب، دانشهای ماست","وان خلیفه دجله علم خداست","درک ما و دانش ما از زندگی به اندازه یک پیاله آب است و درمقابل آن خداوند و تمام دنیا یک رودخانه بی‌کران هستند"],[136,"ما سبوها پر به دجله می‌بریم","گرنه خر دانیم خود را، ما خریم","ما با پیاله های پر به سمت رود میرویم (کنایه ازینکه فکرمیکنیم که همه چیز را میدانیم) خودمان را احمق نمیدانیم اما در واقع ما احمق هستیم"],[136,"باری اعرابی بدان معذور بود","کو ز دجله غافل و بس دور بود","همچون کسی که در بیابان زندگی میکند و هیچ درکی از وجود رودخانه و منبع عظیم آب ندارد ما هم انگار که بی‌خبریم ازینکه علمی بالاتر از علم ما وجود دارد"],[136,"گر ز دجله با خبر بودی چو ما","او نبردی آن سبو را جا بجا","اگر تو هم از وجود آن علم بزرگ و بی همتا با خبر بودی ادعای دانش نمیکردی و در واقع با پیاله پر از آب به سمت رودخانه نمیرفتی"],[136,"بلک از دجله چو واقف آمدی","آن سبو را بر سر سنگی زدی","اگر بفهمی که این دریا چقدر بزرگ است پیاله خودت را با سنگی‌میشکستی یعنی اگر میدانستی که چه علمی فراتر از تمام علم ها وجود دارد اظهار نادانی میکردی"],[137,"چون خلیفه دید و احوالش شنید","آن سبو را پر ز زر کرد و مزید","خلیفه، وقتی حال آن عرب را دید و از وضعیت او باخبر شد، آن سبویی را که آن عرب برایش آورده بود، پر از طلا کرد و به او هدیه داد."],[137,"آن عرب را کرد از فاقه خلاص","داد بخشش‌ها و خلعت‌های خاص","آن عرب را از فقر و تنگدستی نجات داد و او را با عطایای ویژه و بخشش‌هایی که مختص به خود بود، سرافراز کرد."],[137,"کاین سبو پر زر به دست او دهید","چونک واگردد سوی دجله‌ش برید","این سبو را پر از طلا به او بدهید، زیرا وقتی که به سمت دجله (رودخانه‌ای در عراق) برگردد، آن را کنار می‌گذارد و دور می‌افکند."],[137,"از ره خشک آمده‌ست و از سفر","از ره دجله‌ش بود نزدیک‌تر","از راه خشکی و طولانی آمده (و خسته است)‌، (با قایق‌) و از راه دجله او را ببرید که نزدیک‌تر است."],[137,"چون به کشتی در نشست و دجله دید","سجده می‌کرد از حیا و می‌خمید","وقتی او (شخصیتی که در کشتی نشسته) به دجله نگاه کرد، از احترام و حیا به سمت آن سجده کرد و خم شد."],[137,"کای عجب لطف این شه وهاب را","وان عجب‌تر کاو ستد آن آب را","عجب است که این پادشاه بخشنده تا چه حد لطف دارد، و عجب‌تر از آن این است که او آن آب را که حقا ارزشمند است، می‌گیرد."],[137,"چون پذیرفت از من آن دریای جود‌؟","آن‌چنان نقد دغل را زود زود‌؟","چطور ممکن است آن دریای بخشش، یعنی خدا، هدیه‌ای از من را قبول کند؟ در حالی که او بی‌نیاز و غنی است و من به راحتی این هدیه ناپایدار را به او پیشنهاد می‌کنم؟"],[137,"کل عالم را سبو دان ای پسر","کاو بود از علم و خوبی تا به‌سر","ای پسر، تمام عالم را مانند سبویی تصور کن که پر از علم و خوبی است و همه چیز در آن جای دارد."],[137,"قطره‌ای از دجله خوبی اوست","کان نمی‌گنجد ز پری زیر پوست","قطره‌ای از دریای خوبی اوست که نمی‌تواند در فضای تنگ و محدود زیر پوست انسانی جای بگیرد."],[137,"گنج مخفی بد ز پری چاک کرد","خاک را تابان‌تر از افلاک کرد","خزانه‌ای پنهان از زیبایی، خاک را چاک داد و آن را روشن‌تر از آسمان‌ها ساخت."],[137,"گنج مخفی بد ز پری جوش کرد","خاک را سلطان اطلس‌پوش کرد","گنجی پنهان از جوشیدن پری، خاک را تبدیل به چیزی باارزش و پرشکوه کرده که شبیه به شاهی با لباس سلطنتی است."],[137,"ور بدیدی شاخی از دجله خدا","آن سبو را او فنا کردی فنا","اگر می‌توانستی شاخی از دجله، که به عنوان یکی از نعمت‌های خدا دیده می‌شود، ببینی، آن سبو را همچنین به خاطر فنا و زوالش رها می‌کردی."],[137,"آنک دیدندش همیشه بی خودند","بی‌خودانه بر سبو سنگی زدند","آنها همیشه او را از خود بی‌خود و مجنون می‌بینند، و به همین دلیل بر سبو که نماد دیوانگی اوست، سنگ می‌زنند."],[137,"ای ز غیرت بر سبو سنگی زده","وان شکستت خود درستی آمده","تو که از غیرت و تعصب بر سبو سنگ انداختی، بدان که همین شکستن باعث شده که درستی و کمال به وجود آید."],[137,"خم شکسته آب ازو ناریخته","صد درستی زین شکست انگیخته","خم شکسته دیگر آبی ندارد، اما از این شکست، صد نوع درستی و زوایای جدید به وجود آمده است."],[137,"جزو جزو خم به‌رقص‌ست و به‌حال","عقل جزوی را نموده این محال","جزئی از خم که نشانه شکست است، در حال رقص است و عقل جزوی (عقل محدود انسانی) این وضعیت را محال می‌داند. این بیت به دوگانگی میان شناخت عقلانی و واقعیت‌های عمیق‌تر می‌پردازد."],[137,"نه سبو پیدا درین حالت نه آب","خوش ببین والله اعلم بالصواب","در این حالت، نه آن سبویی که آب در آن است وجود دارد و نه آب خوشی دیده می‌شود؛ فقط خداوند می‌داند حقیقت چه چیزی است."],[137,"چون در معنی زنی بازت کنند","پرّ فکرت زن که شهباز‌ت کنند","وقتی به عمق معانی وارد می‌شوی و در معنای حقیقی را به روی تو باز می‌کنند، فکر و اندیشه‌ات همچون پرنده‌ای بلندپرواز، به اوج می‌رسد و آزاد می‌شود."],[137,"پر فکرت شد گل‌آلود و گران","زانک گل‌خواری‌، ترا گل شد چو نان","از آنجا که فکر و اندیشه‌ات مشغول و سنگین شده و حالت به هم ریخته است، مانند گلی که در گل آغشته شده است، تو نیز به خاطر این گل‌خواری و توجه به امور دنیوی، به مانند نانی شده‌ای که در گل فرورفته است."],[137,"نان گلست و گوشت کمتر خور ازین","تا نمانی همچو گل اندر زمین","نان مانند گل است و بهتر است کمتر گوشت بخوری، تا مانند گل در زمین نمانی و از زندگی واقعی و روحانی دور نشوی."],[137,"چون گرسنه می‌شوی سگ می‌شوی","تند و بد پیوند و بدرگ می‌شوی","زمانی که گرسنه می‌شوی، به مانند سگی می‌شوی که تند و خشن و بدخلق است و به راحتی به دیگران آسیب می‌زنی."],[137,"چون شدی تو سیر‌، مرداری شدی","بی‌خبر بی‌پا ، چو دیواری شدی","وقتی که تو سیر و سیراب می‌شوی، غافل و بی‌حرکت می‌گردی و مانند دیواری می‌شوی که بی‌خبر از محیط اطرافش است."],[137,"پس دمی مردار و دیگر دم سگی","چون کنی در راه شیران خوش‌تگی‌؟","زندگی به دو حالت تقسیم می‌شود: یک حالت که شبیه به مردار است؛ یعنی بی‌خبر و بی‌تحرک، و حالت دیگری که مانند سگ است و در آن، انسان به ستیز و تلاش برای امرار معاش و حیات می‌پردازد. حالا سؤال این است که چگونه می‌توان به طریقی شیران (قهرمانان یا افراد بزرگ) پیوست و از زندگی شاد و پرمحتوا برخوردار شد؟"],[137,"آلت اشکار خود جز سگ مدان","کمترک انداز سگ را استخوان","آلت و زرق و برق خود را کمتر از سگ ندان، زیرا که سگ را وقتی استخوانی بدهند، به شدت به آن علاقمند می‌شود."],[137,"زانک سگ چون سیر شد سرکش شود","کی سوی صید و شکار خوش دود","سگ وقتی سیر و مست شود، سرکش و بی‌تاب می‌گردد و به سمت شکار و صید می‌رود، زیرا تحریک و هیجان او با سیر شدن به وجود می‌آید."],[137,"آن عرب را بی‌نوایی می‌کشید","تا بدان درگاه و آن دولت رسید","آن چیزی که آن عرب را می‌کشید (و به آن درگاه آورد) (و انواع نعمت‌ها و هدایای خاص و مخصوص بخشید) بی‌نوایی و فقر بود."],[137,"در حکایت گفته‌ایم احسان شاه","در حق آن بی‌نوای بی‌پناه","حکایت کرده‌ایم که چگونه شاه، لطف و احسان خود را به آن بی‌پناه و بی‌نوای نیازمند عطا کرده است."],[137,"هر‌چه گوید مرد عاشق بوی عشق","از دهانش می‌جهد در کوی عشق","هر چه مرد عاشق بگوید، بوی عشق از سخن او استشمام می‌شود و این عشق در فضای عشق پخش می‌شود."],[137,"گر بگوید فقه‌، فقر آید همه","بوی فقر آید از آن خوش دمدمه","اگر کسی درباره فقه (علم دین) صحبت کند، در حقیقت فقر و نیاز به کمک خداوند را نشان می‌دهد و سخنانش بوی فقر و نیاز را پخش می‌کند، حتی اگر ظاهرش چیزی دیگر به نظر برسد."],[137,"ور بگوید کفر‌، دارد بوی دین","آید از گفت شکش بوی یقین","اگر کسی بگوید کفر، از سخنش بویی از دین به مشام می‌رسد، زیرا در شک و تردید او، نشان‌هایی از یقین نهفته است."],[137,"کف‌ کژ کز بحر صدقی خاسته‌ست","اصل صاف آن فرع را آراسته‌ست","کف مثلی که از دریا صداقت برآمده، حالا فرع و نتیجه‌اش را زیبا و آراسته کرده است."],[137,"آن کفش را صافی و محقوق دان","همچو دشنام لب معشوق دان","این بیت می‌گوید که کفشی که صاف و درست است، مانند دشنام زبانی معشوق، ارزش و اهمیت دارد. به عبارتی دیگر، زیبایی و درستی هر چیز را از اهمیت آن می‌توان فهمید، همان‌طور که دشنام از زبان معشوق نیز به نوعی اعتبار پیدا می‌کند."],[137,"گشته آن دشنام نامطلوب او","خوش ز بهر عارض محبوب او","دشنامی که به خاطر زیبایی محبوب برای او ناخوشایند بود، اکنون به خاطر محبوبش به شیوه‌ای خوشایند تبدیل شده است."],[137,"گر بگوید کژ‌، نماید راستی","ای کژی که راست را آراستی","اگر کسی بگوید که او (محبوب) از راه نادرستی می‌شود، باید بداند که در حقیقت هر نادرستی، حقایق را زیبا و درست جلوه می‌دهد."],[137,"از شکر گر شکل نانی می‌پزی","طعم قند آید نه نان‌، چون می‌مزی","اگر از شکر نان درست کنی، طعمش شیرین و قند مانند می‌شود، نه طعمی که انتظار نان داری."],[137,"ور بیابد مؤمنی زرین وثن","کی هلد آن را برای هر شمن‌؟","اگر کسی مؤمنی را پیدا کند که به طلا و ثروت وابسته باشد، آیا او این ثروت را برای هر جادوگری (شمن) هدیه می‌دهد؟"],[137,"بلک گیرد اندر آتش افکند","صورت عاریتش را بشکند","بدون شک، آنچه را که به‌طور موقت و قرضی به دست آورده، به زودی در آتش می‌افکند و به‌طور کلی می‌شکند، چون برای او معنایی ندارد."],[137,"تا نماند بر ذهب شکل وثن","زانک صورت مانع است و راه‌زن","برای این که شکل بت بر طلا باقی نماند، باید آن را از بین برد؛ زیرا تصویر بت مانع و دزد راه حقیقت است."],[137,"ذات زرش داد ربانیت است","نقش بت بر نقد زر عاریت است","ذات خداوند (زرش) به عنوان مربی و پرورش‌دهنده‌ایست که هیچ‌گاه نمی‌تواند به چیزی مادی تبدیل شود؛ در حالی که صفات و اشیا (نقش بت) بر چیزهای مادی مانند طلا (زر) تنها ناپایدار و عاری از ارزش واقعی هستند."],[137,"بهر کیکی تو گلیمی را مسوز","وز صداع هر مگس مگذار روز","برای کیکی (خوشبختی) به گلیم (پوشش) خود، خود را نسوزان؛ و اجازه نده که صدای مگس (نیکی‌های ناچیز یا مزاحمت‌های کوچک) روز تو را خراب کند."],[137,"بت‌پرستی چون بمانی در صور","صورتش بگذار و در معنی نگر","مصرع اول‌: اگر در صورت‌ها بمانی، بت‌پرست هستی"],[137,"مرد حجی‌، همره حاجی طلب","خواه هندو خواه ترک و یا عرب","مرد حاجی، که در سفر حج است، از هر قوم و نژادی که باشد، مانند هندو یا ترک و عرب، درخواست را از او بکن."],[137,"منگر اندر نقش و اندر رنگ او","بنگر اندر عزم و در آهنگ او","به ظاهر و ظاهرگرایی یکدیگر توجه نکنید، بلکه به نیت، اراده و هدف واقعی او نگاه کنید."],[137,"گر سیاه‌ست او هم‌آهنگ توست","تو سپید‌ش خوان که همرنگ توست","اگر او سیاه است، باید بدانی که در حقیقت هماهنگ با توست. تو او را سپید بشمار، زیرا هماهنگ با رنگ توست."],[137,"این حکایت گفته شد زیر و زبر","همچو فکر عاشقان بی پا و سر","این داستان به گونه‌ای روایت شده که هم حال و هوای عاشقانه داشته باشد و هم در آن آشفتگی و ناپایداری افکار عاشقان دیده می‌شود که نه پا دارند و نه سر، یعنی در جستجوی معشوق خود به حالت بی‌خودی و سرگشتگی افتاده‌اند."],[137,"سر ندارد چون ز ازل بوده‌ست پیش","پا ندارد با ابد بوده‌ست خویش","سر و پا ندارد چون از ابتدا وجود داشته و از ازل بوده، و پیش پا هم ندارد زیرا با ابد و جاودانگی آشناست."],[137,"بلک چون آبست هر قطره از آن","هم سرست و پا و هم بی هر دوان","هر قطره آب از آن به طور کامل و بدون کم و کاست وجود دارد؛ یعنی هم دارای سر و پا است و هم نیاز به دو بعد (سر و پا) ندارد. این بیت به این معناست که در ذات هر چیزی تمامیت و کمال وجود دارد."],[137,"حاش لله این حکایت نیست هین","نقد حال ما و تست این‌، خوش ببین","این سخن حکمتی عمیق دارد و بیانگر آن است که این داستان فقط یک روایت نیست، بلکه ناظر بر حال و وضعیت ماست، پس با توجه و دقت به آن نگاه کن."],[137,"زانک صوفی با کرّ و با فر بود","هرچ آن ماضی‌ست لا یذکر بود","زیرا صوفی با حالتی پرخروش و ابهت، هرچیزی که در گذشته بوده را به یاد نمی‌آورد و توجهی به آن ندارد."],[137,"هم عرب ما‌، هم سبو ما‌، هم ملک","جمله ما یؤفک عنه من افک","عرب (قومی از اهالی جزیره‌العرب) و سبو (ظرفی برای نگهداری مایعات) و پادشاه، همه متعلق به ما هستند و هر چیزی که از این‌ها دور شود و به آن‌ها پشت کند، به‌راستی از هدایت و حقیقت منحرف شده است."],[137,"عقل را شو دان و زن این نفس و طمع","این دو ظلمانی و منکر‌، عقل شمع","عقل را بشناس و درک کن که چگونه این نفس و طمع، دو چیز تاریک و ناپسند هستند و همچنین عقل مانند شمعی است که در این تاریکی‌ها، روشنایی می‌بخشد و حقیقت را نمایان می‌کند."],[137,"بشنو اکنون اصل انکار از چه خاست","زانک کل را گونه‌گونه جزوهاست","بشنو که منشا انکار چیست، زیرا همه اجزا، نوع‌های مختلفی از کل هستند."],[137,"جزو کل نی جزوها نسبت به کل","نی چو بوی گل که باشد جزو گل","اجزای یک چیز نسبت به کل آن چیزی نیستند، مانند بوی گل که جزئی از خود گل نیست، بلکه فقط یکی از ویژگی‌های آن به شمار می‌رود."],[137,"لطف سبزه جزو لطف گل بود","بانگ قمری جزو آن بلبل بود","لطف و زیبایی سبزه بخشی از زیبایی گل است و صدای قمری (پرنده‌ای خوش‌آواز) نیز قسمتی از آواز بلبل به حساب می‌آید."],[137,"گر شوم مشغول اشکال و جواب","تشنگان را کی توانم داد آب","اگر به بیان مسائلی بپردازم و بر این امور متمرکز شوم، چگونه می‌توانم به نیازمندان آبی بیاورم؟"],[137,"گر تو اشکالی بکلی و حرج","صبر کن الصبر مفتاح الفرج","اگر تو به طور کامل درگیر اشکال و مشکلات هستی، پس باید صبر کنی؛ زیرا صبر کلید گشایش و رهایی است."],[137,"احتما کن احتما ز اندیشه‌ها","فکر شیر و گور و دل‌ها بیشه‌ها","از اندیشه توهمی پرهیز کن.همانطور که شیر وگورخر در بیشه ها به جان هم می افتند فکر در دل انسان توهم درست می کند."],[137,"احتماها بر دواها سرور‌ست","زانک خاریدن فزونی‌ گر‌ست","گر در مصرع دوم بیماری پوستی است که موی‌ها را بریزاند و بدن خارش کند‌. همانگونه نخاریدن پوست گر بهترین راه درمان پوست گر است"],[137,"احتما اصل دوا آمد یقین","احتما کن‌، قوّت جانت ببین","احتما‌: پرهیز بیمار از خوراکی‌.پرهیز کردن از اندیشه های توهمی باعث تقویت بینش انسان می شود"],[137,"قابل این گفته‌ها شو گوش‌وار","تا که از زر سازمت من گوش‌وار","برای اینکه بتوانی به درک و فهم بالا برسی و شایسته این کلمات شوی، باید همانند گوشواره‌ای طلا باشی تا من بتوانم تو را از زر بسازم و به زیبایی برسانم."],[137,"حلقه در گوش مه زرگر شوی","تا به ماه و تا ثریا بر شوی","برای رسیدن به بلندی و مقام والای انسانی، باید از دنیای مادی و زینت‌های ظاهری گذر کنی و نسبت به آن‌ها بی‌نیاز باشی، تا بتوانی به جایی بلندتر و روحانی‌تر دست یابی."],[137,"اولا بشنو که خلق مختلف","مختلف جانند تا یا از الف","اولا باید بگویی که انسان‌ها دارای جان‌های مختلف و متنوع هستند، تا دیگران هم در بین آن‌ها به طور فردی و خاصی درک شوند."],[137,"در حروف مختلف شور و شکی‌ست","گرچه از یک‌رو ز سر تا پا یکی‌ست","در میان حروف و سخنان مختلف تنوع و اختلاف وجود دارد، اما در اصل و ماهیت، همه آنها از یک منبع سرچشمه گرفته و یکسان هستند."],[137,"از یکی رو ضد و یک رو متحد","از یکی رو هزل و از یک روی جد","از یک نظر، چیزها در تضاد و ضد هم‌اند، و از نظر دیگر، همگی به هم پیوسته و واحد هستند؛ از یک سو، صحبت‌های بی‌معنی و شوخی وجود دارد و از سوی دیگر، مطالب جدی و درست."],[137,"پس قیامت روز عرض اکبر‌ست","عرض او خواهد که با زیب و فر‌ست","روز قیامت، روز بزرگ عرضه و حسابرسی است و در آن روز، زیبایی و شکوه انسان‌ها در پیشگاه خداوند به نمایش گذاشته می‌شود."],[137,"هر که چون هندوی‌ بد سودایی است","روز عرضش نوبت رسوایی است","هر کسی که مثل هندوها در دنیا فقط به دنبال مال و ثروت است، در روز قیامت، نوبت او به رسوایی خواهد رسید."],[137,"چون ندارد روی همچون آفتاب","او نخواهد جز شبی همچون نقاب","کسی که مانند خورشید روشنایی و زیبایی ندارد، تنها دلیلی برای انتظارش جز شب و تاری نمی‌تواند وجود داشته باشد، یعنی زندگی‌اش در ظلمت و کمبود خواهد بود."],[137,"برگ یک گل چون ندارد خار او","شد بهاران دشمن اسرار او","برگ گل که خار ندارد، به مانند نشانه‌ای است که دشمنی به رازهای او پی نمی‌برد؛ یعنی کسی که در شرایط آسان و زیبا قرار دارد، به راحتی می‌تواند از رازهای درونی‌اش محافظت کند."],[137,"وانک سر تا پا گل‌ست و سوسن‌ست","پس بهار او را دو چشم روشن است","این بیت اشاره به کسی دارد که به‌طور کامل در زیبایی و لطافت غرق شده است، مانند گل و سوسن. بنابراین، در بهار زندگی‌اش، چشمانش روشن و پر از زندگی و شادابی است."],[137,"خار بی‌معنی خزان خواهد خزان","تا زند پهلوی خود با گلستان","خار، که در فصل خزان بی‌معنی و بی‌فایده است، به خاطر آنکه در کنار گلستان قرار می‌گیرد، شایسته‌ی توجه و معنا می‌شود. در واقع، وجود خار در کنار گل‌ها باعث می‌شود که وجودش معنا پیدا کند."],[137,"تا بپوشد حسن آن و ننگ این","تا نبینی رنگ آن و زنگ این","باید زیبایی را بپوشاند و زشتی را از نظر دور کند، تا تو نتوانی رنگ زیبایی را ببینی و زشتی را بشناسی."],[137,"پس خزان او را بهارست و حیات","یک نماید سنگ و یاقوت زکات","خزانی که برای او به نظر می‌رسد، در واقع بهاری است، زیرا گوهرهای ارزنده‌ای همچون سنگ و یاقوت در این دوره از حیات، به نوعی زکات و ثمری را نمایان می‌سازند."],[137,"باغبان هم داند آن را در خزان","لیک دید یک به از دید جهان","باغبان (که معرفت و بینش عمیق‌تری دارد) در فصل خزان می‌داند که طبیعت به چه صورت است، اما برای دیگران، فقط یک صورت را می‌بینند و قادر به درک عمیق‌تر نیستند."],[137,"خود جهان آن یک کس است او ابله‌ست","هر ستاره بر فلک جزو مه است","جهان در حقیقت فقط یک فرد است و سایر چیزها که در آسمان به عنوان ستاره‌ها دیده می‌شوند، جزئی از آن فرد هستند. کسی که این حقیقت را درک نکند، ابله است."],[137,"پس همی‌گویند هر نقش و نگار","مژده مژده نک همی‌آید بهار","هر نقش و نگار (زیبایی و ظرافت طبیعت) خبر می‌دهد که بهار نزدیک است و بی‌صبرانه اعلام می‌کند که فصل جدیدی از زندگی در راه است."],[137,"تا بود تابان شکوفه چون زره","کی کنند آن میوه‌ها پیدا گره","تا زمانی که شکوفه‌ها مانند زره درخشان هستند، میوه‌ها چطور می‌توانند ظاهر شوند و گره بخورند؟"],[137,"چون شکوفه ریخت‌، میوه سر کند","چونکه تن بشکست‌، جان سر بر زند","زمانی که گلبرگ‌های شکوفه افتاده و ریخته می‌شود، میوه به وجود می‌آید و زمانی که جسم (تن) بمیرد، روح (جان) نمایان می‌شود."],[137,"میوه معنی و شکوفه صورتش","آن شکوفه مژده‌، میوه نعمتش","شکوفه نمایانگر ظاهر و صورت میوه است، در حالی که میوه نشان‌دهنده‌ی باطن و معنای واقعی آن است. شکوفه خبر از آمدن میوه می‌دهد و میوه در واقع نعمت و برکت آن شکوفه است."],[137,"چون شکوفه ریخت میوه شد پدید","چونکه آن کم شد، شد این اندر مزید","زمانی که شکوفه‌ها بریزند، میوه‌ها نمایان می‌شوند. هنگامی که شکوفه‌ها کاهش می‌یابند، میوه‌ها در رشد و افزایش هستند."],[137,"تا که نان نشکست‌، قوّت کی دهد‌؟","ناشکسته خوشه‌ها کی می‌ دهد‌؟","تا زمانی که نان نشکند، قوّت و قدرت از کجا به دست می‌آید؟ وقتی خوشه‌ها نشکسته‌اند، چه چیزی می‌تواند به آن‌ها نیروی تازه بدهد؟"],[137,"تا هلیله نشکند با ادویه","کی شود خود صحت‌افزا ادویه‌؟","تا زمانی که هلیله (نوعی میوه دارویی) نشکند، ادویه‌ها چگونه می‌توانند خاصیت و اثر خود را نشان دهند؟ این بیان به اهمیت مراحل و شرایط لازم برای تحقق نتیجه مثبت اشاره دارد."],[138,"ای ضیاء الحق حسام الدین بگیر","یک دو کاغذ بر فزا در وصف پیر","ای روشنایی حقیقت، حسام‌الدین، لطفا یک یا دو ورق کاغذ بردار و درباره صفت و ویژگی‌های پیر (معلم) بنویس."],[138,"گرچه جسم نازکت را زور نیست","لیک بی خورشید ما را نور نیست","هرچند که بدن نازک و ضعیفی داری و توانایی زیادی نداری، اما بدون نور خورشید، ما نیز نمی‌توانیم از نور و هدایت بهره‌مند شویم."],[138,"گرچه مصباح و زجاجه گشته‌ای","لیک سرخیل دلی سررشته‌ای","اگرچه تو مانند چراغ و شیشه‌ای شده‌ای که نور را منتشر می‌کند، اما هنوز هم دل تو به عنوان ریش‌سفید و رهبری که هدایت‌کننده احساسات و افکار است، اهمیت دارد."],[138,"چون سر رشته به دست و کام تست","درهای عقد دل ز انعام تست","چون کنترل و هدایت امور به دست توست و خواسته‌هایت را برآورده می‌کنی، درهای محبت و عشق در دل دیگران به واسطه‌ای از خیر و لطف تو باز می‌شود."],[138,"بر نویس احوال پیر راه‌دان","پیر را بگزین و عین راه دان","پیر راه‌دان، شخصی آگاه و راهنمایی است که باید انتخاب شود و به او توجه شود تا احوال او را بنویسند. در واقع، این اشاره به اهمیت پیروی از راهنمایی حکیمانه و تجربه‌های او دارد."],[138,"پیر تابستان و خلقان تیر ماه","خلق مانند شبند و پیر ماه","پیر، در فصل تابستان، با ویژگی‌هایی چون دانایی و تجربه، شبیه به تیرماه است که آفتاب و گرما دارد. مردم نیز مانند شب‌های تیرماه هستند که ظلمت و ناآگاهی آن‌ها را فراگرفته است."],[138,"کرده‌ام بخت جوان را نام پیر","کو ز حق پیرست نه از ایام پیر","من جوانی‌ام را به نام پیر سپرده‌ام، زیرا او از حق پیر است و نه به خاطر سال‌های زندگی‌اش."],[138,"او چنان پیرست کش آغاز نیست","با چنان در یتیم انباز نیست","او (پیر) چنان سن و سالی دارد که آغاز و شروعی ندارد و در نگاه او، دوستان و هم‌نشینانش مانند یتیم‌هایی هستند که بی‌همراهی به سر می‌برند."],[138,"خود قوی‌تر می‌شود خمر کهن","خاصه آن خمری که باشد من لدن","خود شراب کهنه قوی‌تر می‌شود، به‌خصوص آن شرابی که از دست من گرفته شده باشد."],[138,"پیر را بگزین که بی پیر این سفر","هست بس پر آفت و خوف و خطر","در این بیت به اهمیت انتخاب یک راهنمای روحانی (پیر) اشاره شده است و می‌گوید که بدون داشتن چنین راهنمایی، سفر معنوی پر از مشکلات، ترس و خطر خواهد بود."],[138,"آن رهی که بارها تو رفته‌ای","بی قلاوز اندر آن آشفته‌ای","آن راهی که تو بارها در آن رفته‌ای، چون در آن بدون راهنمایی حرکت کنی، دچار آشفتگی و سردرگمی خواهی شد."],[138,"پس رهی را که ندیدستی تو هیچ","هین مرو تنها ز رهبر سر مپیچ","بهتر است به راهی که هرگز آن را ندیده‌ای نروی، زیرا تنها از راهنمایی که می‌شناسی جدا نشوید و از مسیر اصلی منحرف نشوید."],[138,"گر نباشد سایه او بر تو گول","پس ترا سرگشته دارد بانگ غول","اگر سایه او، یعنی راهنمای تو، بر سرت نباشد، مانند کسی سرگشته و گیج می‌شوی که صدای غول (مسیری خطرناک) او را می‌ترساند."],[138,"غولت از ره افکند اندر گزند","از تو داهی‌تر درین ره بس بدند","غول تو را به خطر می‌اندازد و در این مسیر، بیشتر از تو آگاه است و به تو ضربه می‌زند."],[138,"از نبی بشنو ضلال ره‌روان","که چه شان کرد آن بلیس بدروان","از پیامبر بشنو درباره گمراهی راهپیمایانی که بلیس (شیطان) چگونه آنان را فریب داده و به سمت بدی سوق داده است."],[138,"صد هزاران ساله راه از جاده دور","بردشان و کردشان ادبیر و عور","این ابیات به حال افرادی اشاره دارد که به مدت بسیار طولانی از جاده راست و درست منحرف شده‌اند و در نتیجه به حالت نادم و پشیمان درآمده‌اند. آن‌ها به نحوی بی‌هویت و بی‌ثبات شده‌اند و به این وضعیت عمیق دچار گشته‌اند."],[138,"استخوانهاشان ببین و مویشان","عبرتی گیر و مران خر سویشان","به استخوان‌ها و موهای این افراد توجه کن و از آن‌ها عبرتی بگیر و خر را به سمت آن‌ها نبر."],[138,"گردن خر گیر و سوی راه کش","سوی ره‌بانان و ره‌دانان خوش","به گردن الاغ دفتری ببند و آن را به سوی راه بینداز تا به راهبان و دانایان خوش عزم برسد."],[138,"هین مهل خر را و دست از وی مدار","زانک عشق اوست سوی سبزه‌زار","زود دست از کار و تلاش با او بردار و مهلتش نده، چرا که عشق واقعی او به سوی مکان‌های سرسبز و خوش‌بوست."],[138,"گر یکی دم تو به غفلت وا هلیش","او رود فرسنگها سوی حشیش","اگر یک لحظه غافل شوی و او را رها کنی، او ممکن است هزاران فرسنگ از تو دور شود و به علف‌ها برود."],[138,"دشمن راهست خر مست علف","ای که بس خر بنده را کرد او تلف","خر مست، نماینده‌ای از بی‌خود و نادان است که در راه علف به بی‌راهه می‌رود. در اینجا، شاعر به فردی که به این خر (بی‌خود) وابسته است، می‌گوید که این علف (هوی و هوس) دشمن راه راست است و او را به هلاکت می‌کشاند."],[138,"گر ندانی ره هر آنچ خر بخواست","عکس آن کن خود بود آن راه راست","اگر نمی‌دانی که کدام راه درست است، به عکس خواسته‌های خود عمل کن، زیرا در این حالت خودت می‌فهمی که کدام مسیر درست است."],[138,"شاوروهن و آنگه خالفوا","ان من لم یعصهن تالف","با اهل مشورت هم‌رأی شوید و سپس بر خلاف آنچه می‌گویند عمل کنید، زیرا کسی که از آن‌ها تبعیت نکند به جمع شما درمی‌آید."],[138,"با هوا و آرزو کم باش دوست","چون یضلک عن سبیل الله اوست","با هوا و آرزو همراهی نکن، چون آن‌ها تو را از راه خدا منحرف می‌کنند."],[138,"این هوا را نشکند اندر جهان","هیچ چیزی همچو سایه همرهان","هیچ چیزی در دنیا مانند سایه همرهان نمی‌تواند این هوای نفس را در هم بشکند."],[139,"گفت پیغامبر علی را کای علی","شیر حقی پهلوان پردلی",": پیامبر به علی گفت: ای علی، شیر حقیقت و قهرمان شجاعت!"],[139,"لیک بر شیری مکن هم اعتمید","اندر آ در سایه نخل امید","بر علی، که به او شیر حق گفته می‌شود، نباید بیشتر از حد اعتماد کرد و باید به سایه امید و حمایت خداوند پناه برد."],[139,"اندر آ در سایه آن عاقلی","کش نداند برد از ره ناقلی","به نزد عاقلی که هیچ‌گاه از راه کسی نرفته و چیزی ندیده، وارد شو و در سایه‌ی وجود او قرار بگیر."],[139,"ظل او اندر زمین چون کوه قاف","روح او سیمرغ بس عالی‌طواف","وجود او در زمین به مانند کوه قاف است و سایه‌اش گسترده و عظیم، در حالی که روح او مانند سیمرغ، موجودی بسیار برتر و عالی است که در آسمان‌ها پرواز می‌کند."],[139,"گر بگویم تا قیامت نعت او","هیچ آن را مقطع و غایت مجو","اگر بگویم وصف و فضایل او (رسول خدا) را تا روز قیامت، هیچ‌وقت نمی‌توانم به انتها و حدی برای آن برسم."],[139,"در بشر روپوش کردست آفتاب","فهم کن والله اعلم بالصواب","آفتاب (نور و روشنایی) فهم و دانش در وجود انسان به عنوان یک پوشش یا روپوشی قرار گرفته است؛ یعنی انسان‌ها به دلیل محدودیت‌های خود، حقیقت و دانش را کامل درک نمی‌کنند. به خدا سوگند، او بهتر می‌داند که کدام فهم درست‌تر است."],[139,"یا علی از جمله طاعات راه","بر گزین تو سایه خاص اله","ای علی، از میان تمام عبادت‌ها و کارهای خوب، راهی را انتخاب کن که به تو نزدیک‌تر است و سایه خاص خدا بر تو باشد."],[139,"هر کسی در طاعتی بگریختند","خویشتن را مخلصی انگیختند","هر کس در راهی از عبادت و طاعتی، خود را از خطرات حفظ کرده و با آن نزدیک‌تر می‌شود."],[139,"تو برو در سایه عاقل گریز","تا رهی زان دشمن پنهان‌ستیز","به نزد شخص عاقل برو و از او پناه ببر تا از دشمنی که ناپیدا است و ممکن است به تو آسیب برساند، در امان بمانی."],[139,"از همه طاعات اینت بهترست","سبق یابی بر هر آن سابق که هست","بهتر از هر نوع عبادت و تقرب به خداوند، پیشی گرفتن بر کسانی است که در مسیر نیکی قرار دارند و به نوعی از آن‌ها سبقت جستن، ارزش بیشتری دارد."],[139,"چون گرفتت پیر هین تسلیم شو","همچو موسی زیر حکم خضر رو","زمانی که استاد و راهنمای تو (پیر) تو را فرا می‌خواند، باید با تسلیم کامل به او پاسخ دهی، مانند موسی که زیر فرمان خضر قرار گرفت."],[139,"صبر کن بر کار خضری بی نفاق","تا نگوید خضر رو هذا فراق","بر کار خضر (عالم الهی) صبر کن و در این زمینه نفاق و دوگانگی در قلبت نداشته باش، زیرا اگر چنین کنی، او خواهد گفت که دیگر از من دوری و این جدایی است."],[139,"گرچه کشتی بشکند تو دم مزن","گرچه طفلی را کشد تو مو مکن","اگرچه کشتی (زندگی) خراب شود، تو سخن مگو و ناامیدی نشان نده. اگر هم کودکی (بی‌گناه) را بکشند، تو مو (ناراحتی) مکن و آرام باش."],[139,"دست او را حق چو دست خویش خواند","تا ید الله فوق ایدیهم براند","خدا دست علی (علیه‌السلام) را مانند دست خود می‌خواند تا این‌گونه نشان دهد که قدرت الهی بالاتر از همه دست‌ها است و علی در نزد خداوند جایگاه ویژه‌ای دارد."],[139,"دست حق میراندش زنده‌ش کند","زنده چه بود جان پاینده‌ش کند","دست خدا او را هدایت می‌کند و به زندگی بازمی‌گرداند؛ زنده بودن او به این است که جانش همیشه پاینده و جاودانه باشد."],[139,"هرکه تنها نادرا این ره برید","هم به عون همت پیران رسید","هر کس به تنهایی و به سختی این مسیر را طی کند، در نهایت به یاری و کمک دانشمندان و بزرگان خواهد رسید."],[139,"دست پیر از غایبان کوتاه نیست","دست او جز قبضه الله نیست","پیر یا ولی، به رغم غیبت بعضی افراد، ارتباط و تاثیرش را همچنان حفظ کرده و تنها فردی که در دست اوست، خداوند است."],[139,"غایبان را چون چنین خلعت دهند","حاضران از غایبان لا شک به‌اند","وقتی به غایبان این‌گونه پاداش و احترام داده می‌شود، حاضران بی‌تردید از نظر مقام و منزلت به غایبان می‌رسند و مثل آن‌ها مورد توجه قرار می‌گیرند."],[139,"غایبان را چون نواله می‌دهند","پیش مهمان تا چه نعمتها نهند","وقتی که به غایبان نواله یا هدیه‌ای می‌دهند، مهمانان هم می‌فهمند که چه نعمت‌هایی به آن‌ها داده خواهد شد."],[139,"کو کسی کو پیش شه بندد کمر","تا کسی کو هست بیرون سوی در","کسی را پیدا کن که در کنار پادشاه (شه) حاضر باشد و به او وصل شود، زیرا کسی که در بیرون از در (دربار) است، ارتباطی با او ندارد."],[139,"چون گزیدی پیر نازک‌دل مباش","سست و ریزیده چو آب و گل مباش","وقتی کسی را به عنوان استاد یا راهنما انتخاب کردی، ضعیف و آسیب‌پذیر نباش، مانند آب و گل که سست و نرم‌اند، بلکه باید قوی و استوار باشی."],[139,"ور بهر زخمی تو پر کینه شوی","پس کجا بی‌صیقل آیینه شوی",": اگر بر اثر جراحتی از تو کینه به دل بگیرم، پس کجا می‌توانم بدون زنگار و کثیفی مثل آینه شفاف و پاک بمانم؟"],[140,"این حکایت بشنو از صاحب بیان","در طریق و عادت قزوینیان","این داستان را از کسی بشنو که در سخنوری و بیان تبحر دارد، درباره روش و عادات قزوینی‌ها."],[140,"بر تن و دست و کتف‌ها بی‌گزند","از سر سوزن کبودیها زنند","بر تن و دست و شانه‌هایشان -بدون آنکه گناهی کرده باشند- با سر سوزن، نشان‌های آبی می‌گذارند (و آنها را عذاب می‌دهند / شکنجه می‌دهند)"],[140,"سوی دلاکی بشد قزوینیی","که کبودم زن بکن شیرینیی","یک قزوینی پیش حمامی رفت و به او گفت که برایم خالکوبی‌ای بکن و شاهکاری بساز - شیرینی کردن:شیرین‌کاری کردن؛ کار هنرمندانه کردن. - دلاک: حمامی، کارگر حمام، خالکوب"],[140,"گفت چه صورت زنم ای پهلوان","گفت برزن صورت شیر ژیان","قزوینی از یک مرد قوی می‌پرسد که چه ظاهری باید به خود بگیرد؛ مرد پهلوان به او می‌گوید که باید چهره‌اش را مانند چهره شیر بکند."],[140,"طالعم شیرست نقش شیر زن","جهد کن رنگ کبودی سیر زن","طالع و برج من شیر است پس نقش شیری بر تنم خالکوبی کن و رنگ کبودش را پررنگ بزن (سیر‌: پررنگ)"],[140,"گفت بر چه موضعت صورت زنم","گفت بر شانه گهم زن آن رقم","شیر به خود می‌گوید که بر کجا می‌زنم، به شانه‌ام بزن، چون این زخم بر آنجا چیزی را رقم می‌زند."],[140,"چونک او سوزن فرو بردن گرفت","درد آن در شانه‌گه مسکن گرفت","وقتی او سوزنی را به شانه‌اش فرو برد، درد آن در شانه‌اش جا گرفت و ماندگار شد."],[140,"پهلوان در ناله آمد کای سنی","مر مرا کشتی چه صورت می‌زنی","پهلوان در حال ناله و شکایت می‌گوید: ای سنی (شخصی از قبیله‌ی سنی‌ها)، تو مرا کشتی، چرا بر صورتم ضربه می‌زنی؟"],[140,"گفت آخر شیر فرمودی مرا","گفت از چه عضو کردی ابتدا","شیر به پهلوان می‌گوید که تو به من فرمان دادی، حالا بگو از کدام قسمت بدن من شروع به زدن کردی؟"],[140,"گفت از دمگاه آغازیده‌ام","گفت دم بگذار ای دو دیده‌ام","شیر می‌گوید که من از دمگاه (قسمت پایین بدن) شروع کرده‌ام، پس تو هم باید برای درمانم دم (نفس) را از همین قسمت بگذاری، ای دو دیده‌ام (چشمانم)."],[140,"از دم و دمگاه شیرم دم گرفت","دمگه او دمگهم محکم گرفت","شیر، از دم و پای خود، نیرویی گرفته و محکم ایستاده است. در واقع، او از قوی بودن خود استفاده می‌کند و به شدت از این قدرت دفاع می‌کند."],[140,"شیر بی‌دم باش گو ای شیرساز","که دلم سستی گرفت از زخم گاز","ای شیر، حتی اگر دم نداری، از من بشنو که دلم به خاطر زخم گاز تو سست و ناراحت شده است."],[140,"جانب دیگر گرفت آن شخص زخم","بی‌محابا و مواسایی و رحم","آن شخص به سمت دیگری رفت و زخم را به شدت و بدون ملاحظه و رحم به جان شیر زد."],[140,"بانگ کرد او کین چه اندامست ازو","گفت این گوشست ای مرد نکو","او که زخمی شده، فریاد می‌زند که این بدن چه طور است، و دیگری پاسخ می‌دهد که این, گوش است ای مرد نیکو."],[140,"گفت تا گوشش نباشد ای حکیم","گوش را بگذار و کوته کن گلیم","شخصی به حکیم می‌گوید که تا وقتی که گوش ندارد، لازم نیست به آن اهمیت بدهی و از او می‌خواهد که آن را کنار بگذارد و به جای آن گلیم را کوتاه کند."],[140,"جانب دیگر خلش آغاز کرد","باز قزوینی فغان را ساز کرد","قزوینی دوباره به طرف دیگر حیوان (شیر) رو کرده و شروع به ناله و فغانی جدید می‌کند."],[140,"کین سوم جانب چه اندامست نیز","گفت اینست اشکم شیر ای عزیز","قزوینی در پاسخ به سوال درباره کیفیت زخم‌ها، می‌گوید که این زخم‌ها از کدام قسمت بدن شیر است و این زخم‌ها به خاطر اشک و غم شیر به وجود آمده است."],[140,"گفت تا اشکم نباشد شیر را","گشت افزون درد کم زن زخمها","او گفت: تا زمانی که زخم من بر بدن شیر وجود داشته باشد، درد او بیشتر خواهد شد؛ بنابراین نباید زخم‌های بیشتری به او بزنم."],[140,"خیره شد دلاک و پس حیران بماند","تا بدیر انگشت در دندان بماند","دلاک (آرایشگر) شگفت‌زده و متعجب شد و برای مدتی در این وضعیت باقی ماند که با انگشتش در دندانش گیر کرده بود."],[140,"بر زمین زد سوزن از خشم اوستاد","گفت در عالم کسی را این فتاد؟","استاد (دلاک) از شدت خشم سوزن را بر زمین انداخت و گفت آیا در این دنیا کسی هم مانند این اتفاق را تجربه کرده است؟"],[140,"شیر بی‌دم و سر و اشکم کی دید","این‌چنین شیری خدا خود نافرید","شیر بدون دم و سر و شکم را کی دیده است؟ این‌طور شیرهایی را خداوند خود نیافریده است."],[140,"ای برادر صبر کن بر درد نیش","تا رهی از نیش نفس گبر خویش","ای برادر، لحظه‌ای صبر کن و بر درد نیش (آزار) غم و اندوه تحمل کن تا از زخم نفس شرور خود رهایی یابی."],[140,"کان گروهی که رهیدند از وجود","چرخ و مهر و ماهشان آرد سجود","گروهی از انسان‌ها وجود آثار مادی همچون چرخ (زمان)، خورشید و ماه را پشت سر گذاشته‌اند و به مرحله‌ای رسیده‌اند که به خاطر تعالی معنوی خود، باید سجده کنند. این افراد به مرتبه‌ای از عقل و درک رسیده‌اند که از دنیا و موجودات آن جدا شده‌اند."],[140,"هر که مرد اندر تن او نفس گبر","مر ورا فرمان برد خورشید و ابر","هر کس که در وجودش نفس دنیوی و مادی (گبر به معنای بت پرست یا غیر مومن) باشد، خورشید و ابر (نمادهای طبیعی و دنیوی) بر او فرمان می‌برند و او تحت تأثیر آنها قرار می‌گیرد."],[140,"چون دلش آموخت شمع افروختن","آفتاب او را نیارد سوختن","وقتی دل آدمی یاد می‌گیرد که چگونه شمع عشق را روشن کند، آفتاب وجودش نمی‌تواند آن شمع را خاموش کند."],[140,"گفت حق در آفتاب منتجم","ذکر تزاور کذی عن کهفهم","خداوند در نور خورشید، با نیکویی و محبت خود به یادآوری ارزش‌های بزرگ می‌پردازد. او از کسانی سخن می‌گوید که در غار (به معنای دوری از دنیا) به سر می‌برند و به توجه و محبت الهی دست می‌یابند."],[140,"خار جمله لطف چون گل می‌شود","پیش جزوی کو سوی کل می‌رود","هر چیز کوچک و نامطلوبی مانند «خار» می‌تواند با لطف و محبت، به زیبایی گل مانند شود؛ و همچنین، هر جزئی باید به سوی کل و اصل خود گرایش پیدا کند و به آن ملحق شود."],[140,"چیست تعظیم خدا افراشتن","خویشتن را خوار و خاکی داشتن","تعظیم خداوند یعنی اینکه انسان باید خود را در مقابل او کوچک و خاکی بداند و به جای خود افتادگی را انتخاب کند."],[140,"چیست توحید خدا آموختن","خویشتن را پیش واحد سوختن","توحید خدا به این معناست که انسان باید در برابر یگانگی خداوند خویشتن را به فنا بسپارد و از خودخواهی دست بردارد."],[140,"گر همی‌خواهی که بفروزی چو روز","هستی همچون شب خود را بسوز","اگر می‌خواهی مانند روز درخشان باشی، باید همانند شب به فنا و زوال خودتن بپردازی و خود را قربانی کنی."],[140,"هستیت در هست آن هستی‌نواز","همچو مس در کیمیا اندر گداز","وجود تو در هستی‌ای که پذیرای هستی است، مانند مس در کیمیا (طلایابی) در حال ذوب شدن و تغییر است."],[140,"در من و ما سخت کردستی دو دست","هست این جمله خرابی از دو هست","عشق و وجود ما را به هم پیوند زده‌ای و دو دست ما را به سختی در هم گره زده‌ای. این وضعیت نابسامان ناشی از وجود همین دو هویت متفاوت است."],[141,"شیر و گرگ و روبهی بهر شکار","رفته بودند از طلب در کوهسار","شیر، گرگ و روباه برای شکار در جستجوی طعمه کوهسار رفته بودند."],[141,"تا به پشت همدگر بر صیدها","سخت بر بندند بار قیدها","به یاری هم در شکار و مسیر را بر طعمه‌ها به سختی ببندند."],[141,"هر سه با هم اندر آن صحرای ژرف","صیدها گیرند بسیار و شگرف","هر سه در آن صحرای عمیق، شکارهای فراوان و شگفت‌انگیزی به دست آورند."],[141,"گرچه زیشان شیر نر را ننگ بود","لیک کرد اکرام و همراهی نمود","اگر چه همراهی آن دو برای شیر ننگ بود، اما او احترام و همراهی را از خود نشان داد."],[141,"این چنین شه را ز لشکر زحمتست","لیک همره شد جماعت رحمتست","این گونه است لشکر همراه دردسر برای شاه باشد اما همراهی یک جمع خود نیز منفعت دارد."],[141,"این چنین مه را ز اختر ننگهاست","او میان اختران بهر سخاست","این گونه که ستارگان برای ماه ننگ هستند و اما در میان ستارگان جلب توجه می‌کند."],[141,"امر شاورهم پیمبر را رسید","گرچه رایی نیست رایش را ندید","پیامبر نیز به مشورت با مردم توجه می‌کرد، هرچند که نظر او در این مورد مشخص نبود."],[141,"در ترازو جو رفیق زر شدست","نه از آن که جو چو زر جوهر شدست","در مقام رفاقت، جو به ارزش طلا تبدیل شده است، نه به این دلیل که جو ذاتا به طلا تبدیل شده باشد."],[141,"روح قالب را کنون همره شدست","مدتی سگ حارس درگه شدست","روح اکنون با بدن قرین شده است و مدتی است که مانند سگی نگهبان در اینجا مستقر شده است."],[141,"چونک رفتند این جماعت سوی کوه","در رکاب شیر با فر و شکوه","این دو در رکاب شیر با شکوه قدرت راهی کوه شدند"],[141,"گاو کوهی و بز و خرگوش زفت","یافتند و کار ایشان پیش رفت","گاو کوهی و بز و خرگوش چاق و چله پیدا کردند و کار شکارشان خوب پیش رفت."],[141,"هر که باشد در پی شیر حراب","کم نیاید روز و شب او را کباب","هر کسی که پیرو شیر جنگو باشد، شب و روز دچار گرفتاری خواهد شد."],[141,"چون ز که در بیشه آوردندشان","کشته و مجروح و اندر خون کشان","وقتی که آن‌ها را از کوه به بیشه آوردند، سخت مجروح و در خون خود غرق شده بودند."],[141,"گرگ و روبه را طمع بود اندر آن","که رود قسمت به عدل خسروان","گرگ و روباهانتظار داشتند، شیر سهمشان به طور عادلانه‌ای تقسیم شود، مانند تقسیم ثروت و قدرت در میان شاهان."],[141,"عکس طمع هر دوشان بر شیر زد","شیر دانست آن طمعها را سند","طمع هر دوی آن‌ها (گرگ و روباه) در رفتار و نگاهشان بازتاب پیدا کرد و برای شیر آشکار شد؛ شیر هم فهمید که آن طمع‌ها واقعیت دارند و برایشان شواهدی داشت."],[141,"هر که باشد شیر اسرار و امیر","او بداند هر چه اندیشد ضمیر","هر کسی که فرمانروای رمز و رازها باشد، به خوبی از تمام افکار و نیت‌های پنهانی آگاه است."],[141,"هین نگه دار ای دل اندیشه‌خو","دل ز اندیشه بدی در پیش او","ای دل، مراقب باش در پیشگاه او! از فکرهای بد دوری کن و جلوی آن‌ها را بگیر."],[141,"داند و خر را همی‌راند خموش","در رخت خندد برای روی‌پوش","می‌داند و در حالی که ساکت است، خر را می‌راند؛ و برای پوشاندن حقیقت، در روی تو لبخند می‌زند."],[141,"شیر چون دانست آن وسواسشان","وا نگفت و داشت آن دم پاسشان","شیر از نیتشان باخبر است، اما سکوت می‌کند و با روی خوش با آنها رفتار می‌کند تا چیزی از آگاهی خودش آشکار نشود."],[141,"لیک با خود گفت بنمایم سزا","مر شما را ای خسیسان گدا","شیر با خود گفت الان سزای کارتان را به شما خواهم داد ای گدایان خسیس."],[141,"مر شما را بس نیامد رای من","ظنتان اینست در اعطای من","رأی و تدبیر من برای شما کافی نبود؟ گمان شما درباره بخشش من این است؟"],[141,"ای عقول و رایتان از رای من","از عطاهای جهان‌آرای من","ای صاحبان عقل، رای و اندیشه شما در برابر رای من چیست؟ در برابر عطاهای جهان‌آرای من چه می‌اندیشید؟"],[141,"نقش با نقاش چه سگالد دگر","چون سگالش اوش بخشید و خبر","نقش با نقاش دیگر چه تدبیری می‌تواند بکند، وقتی نقاش خودش به او اندیشه و آگاهی بخشیده است؟"],[141,"این چنین ظن خسیسانه به من","مر شما را بود ننگان زمن","چنین گمان بخیلانه‌ای نسبت به من، از سوی شما مایه‌ی ننگ من بود."],[141,"ظانین بالله ظن السؤ را","گر نبرم سر بود عین خطا","شما درباره‌ی خدا گمان بد می‌برید؛ اگر سرتان را نبرم، خود این کار خطایی آشکار خواهد بود."],[141,"وا رهانم چرخ را از ننگتان","تا بماند در جهان این داستان","جهان را از ننگ شما رها کنم، تا این داستان در جهان باقی بماند."],[141,"شیر با این فکر می‌زد خنده فاش","بر تبسمهای شیر ایمن مباش","شیر با این اندیشه آشکارا می‌خندید، از لبخندهای شیر در امان نیستی"],[141,"مال دنیا شد تبسمهای حق","کرد ما را مست و مغرور و خلق","مال دنیا، تبسم‌های حضرت حق شده است. ما را مست و مغرور و فرسوده کرده است."],[141,"فقر و رنجوری بهستت ای سند","کان تبسم دام خود را بر کند","فقر و رنجوری برای تو بهتر است، ای گرامی؛ زیرا آن لبخند، دام خودش را برخواهد کند"],[142,"گفت شیر ای گرگ این را بخش کن","معدلت را نو کن ای گرگ کهن","شیر به گرگ می‌گوید که باید این شکار را تقسیم کنیم و تو نیز باید خودت را تجدید و اصلاح کنی، زیرا در حال حاضر به خاطر پیری و کهنگی‌ات در موقعیت مناسبی نیستی."],[142,"نایب من باش در قسمت‌گری","تا پدید آید که تو چه گوهری","من از تو می‌خواهم که به عنوان نماینده‌ام در تقسیم کردن چیزی عمل کنی تا مشخص شود که تو چه ارزش و توانایی‌ای داری."],[142,"گفت ای شه گاو وحشی بخش تست","آن بزرگ و تو بزرگ و زفت و چست","گرگ به شیر گفت که ای پادشاه، این گاو وحشی سهم توست، زیرا گاو بزرگ است و تو بزرگ و درشت و چابک هستی."],[142,"بز مرا که بز میانه‌ست و وسط","روبها خرگوش بستان بی غلط","گرگ گفت: من سهم خود را بز برمیدارم زیرا بز برای من مناسب تر است.و روباه هم خرگوش را به عنوان سهم خود برمیدارد"],[142,"شیر گفت ای گرگ چون گفتی بگو","چونک من باشم تو گویی ما و تو","شیر به گرگ گفت: چون تو می‌گویی «بگو»، پس من هم می‌توانم بگویم «ما و تو»؛ یعنی وقتی من در کنار تو هستم، ما به یکدیگر وابسته‌ایم و یک کل می‌شویم."],[142,"گرگ خود چه سگ بود کو خویش دید","پیش چون من شیر بی مثل و ندید","گرگ چگونه می‌تواند خود را با دیدن شیر، که بی‌همتا و بی‌نقص است، مقایسه کند؟ او حتی نمی‌تواند خود را به اندازه یک سگ نیز بشناسد."],[142,"گفت پیش آ ای خری کو خود خرید","پیشش آمد پنجه زد او را درید","گفت: ای خر، بیا جلو که خودت را به فروش گذاشتی. خر در پاسخ نزدیک شد و او با پنجه‌اش به او حمله کرد و او را پاره‌پاره کرد."],[142,"چون ندیدش مغز و تدبیر رشید","در سیاست پوستش از سر کشید","وقتی دید که گرگ (که نماد حیلتمندی و فریب است) عقل و تدبیرش را ندارد و به درستی عمل نمی‌کند، از او روی برگرداند و او را کنار زد."],[142,"گفت چون دید منت ز خود نبرد","این چنین جان را بباید زار مرد","وقتی دید که او با این حال، هیچ خدمتی برای خود نمی‌خواهد و در برابر دیگران خوار شده است، پس باید جانش به حال زاری و تاسف درآید."],[142,"چون نبودی فانی اندر پیش من","فضل آمد مر ترا گردن زدن","وقتی که تو در برابر من فنا نشدی، لطف و کرامت تو به من رسید و باعث شد که تو را گردن بزنم."],[142,"کل شیء هالک جز وجه او","چون نه‌ای در وجه او هستی مجو","تمام موجودات فناپذیرند و فقط «چهره» و «وجود» خداوند باقی و پایدار است. اگر تو در پی خدا نیستی، نباید به دنبال ذات او باشی."],[142,"هر که اندر وجه ما باشد فنا","کل شیء هالک نبود جزا","هر کس که در جمع ما باشد و به ما تعلق داشته باشد، نابود نمی‌شود و برخلاف دیگران که هلاک می‌شوند، پاداشی خواهد داشت."],[142,"زانک در الاست او از لا گذشت","هر که در الاست او فانی نگشت","چون کسی به حقیقت وجود خود پی ببرد و از خودخواهی و انانیت بگذرد، دیگر نمی‌تواند فانی شود و در نتیجه، از وجود حقیقی و الهی خود دور نمی‌ماند."],[142,"هر که بر در او من و ما می‌زند","رد بابست او و بر لا می‌تند","هر کسی که به در وجود او (خدا یا حقیقت) می‌زند و به خودخواهی می‌رسد، از آن در رد می‌شود و به لا (وحدت یا عدم) می‌رسد."],[143,"آن یکی آمد در یاری بزد","گفت یارش کیستی ای معتمد","یک نفر به یاری آمد و به کسی که در آنجا بود ضربه‌ای زد و از او پرسید: «ای شخص مورد اعتماد، یار تو کیست؟"],[143,"گفت من، گفتش برو هنگام نیست","بر چنین خوانی مقام خام نیست","او پاسخ می‌دهد که من هستم، اما به او می‌گوید الان وقت مناسبی نیست. در این مقام، شخص نادان نمی‌تواند وارد شود."],[143,"خام را جز آتش هجر و فراق","کی پزد کی وا رهاند از نفاق","آدم خام و ناتوان را فقط آتش هجران و فراق می‌سوزاند، و هیچ چیز دیگری نمی‌تواند او را از کینه و نفاق رهایی بخشد."],[143,"رفت آن مسکین و سالی در سفر","در فراق دوست سوزید از شرر","آن بیچاره فرد مسکین، به مدت یک سال در سفر بود و به خاطر دوری از دوستش، از حسرت و آتش فراق رنج می‌برد."],[143,"پخته گشت آن سوخته پس باز گشت","باز گرد خانه همباز گشت","او که در فراق دوست سال‌ها رنج کشیده و سوزیده بود، حالا به پختگی و کمال رسیده و دوباره به خانه یار خود برگشته است."],[143,"حلقه زد بر در به صد ترس و ادب","تا بنجهد بی‌ادب لفظی ز لب","با کمال احتیاط و فروتنی به درب کوبید تا مبادا کلامی بی‌ادبانه از زبانش خارج شود."],[143,"بانگ زد یارش که بر در کیست آن","گفت بر در هم توی ای دلستان","یارش فریاد زد که ببین، آن که بر در است کیست؟ او پاسخ داد که ای محبوب، خودت هستی که در در ایستاده‌ای."],[143,"گفت اکنون چون منی ای من در آ","نیست گنجایی دو من را در سرا","گفت: حالا که تو همانی که من هستم، به درون بیا. هیچ جایی برای دو نفر با هویت یکسان در این مکان نیست."],[143,"نیست سوزن را سر رشته دوتا","چونک یکتایی درین سوزن در آ","سوزن نمی‌تواند دو رشته را در خود جای دهد، زیرا یکتایی و یکپارچگی خاصی دارد و فقط می‌تواند یک رشته را در خود بگنجاند."],[143,"رشته را با سوزن آمد ارتباط","نیست در خور با جمل سم الخیاط","رشته‌ای که با سوزن به هم وصل می‌شود، به خودی خود نمی‌تواند با بارهایی که تحت فشار و سختی هستند، ارتباط برقرار کند. این جمله به این معناست که برای ارتباط یا اتصال، باید شرایط مناسب و لازم فراهم باشد."],[143,"کی شود باریک هستی جمل","جز به مقراض ریاضات و عمل","تنها با تمرین سخت و مجاهدت در راه رسیدن به مقصد می‌توان به وجود لطیف و معنوی دست یافت، زیرا جز این راه، هیچ‌کس نمی‌تواند به عمیق‌ترین حقیقت‌ها برسد."],[143,"دست حق باید مر آن را ای فلان","کو بود بر هر محالی کن فکان","دست خداوند باید به هر چیزی کمک کند، ای فلان، و او کسی است که می‌تواند هر چیزی را از حالت غیر ممکن به ممکن تبدیل کند."],[143,"هر محال از دست او ممکن شود","هر حرون از بیم او ساکن شود","هر غیرممکنی به دست او ممکن می‌شود و هر دیوانه‌ای از ترس او آرام می‌گیرد."],[143,"اکمه و ابرص چه باشد مرده نیز","زنده گردد از فسون آن عزیز","این بیت می‌گوید که هرچه به نظر مرده و بی‌خاصیت بیاید، مانند آکله و ابرص (بیماری‌هایی که به ظاهر فرد را می‌میراند)، می‌تواند با تاثیر شادی‌آور و سحرآمیز آن شخص عزیز (مقصود خدا یا انسانی خاص) جان دوباره بگیرد و زنده شود."],[143,"و آن عدم کز مرده مرده‌تر بود","در کف ایجاد او مضطر بود","این عدم که به معنای نبودن یا عدم وجود است، حتی از مرده نیز مرده‌تر به نظر می‌رسد و در دست قدرت خلق، خود را در مضیقه و نیاز می‌یابد. یعنی وجود آن چنان تهی است که به عجز و بیچارگی دچار می‌شود."],[143,"کل یوم هو فی شان بخوان","مر ورا بی کار و بی‌فعلی مدان","خدا هر روز در حال ایجاد و تدبیر امور است، پس او را بی‌کار و بی‌عمل نپندار."],[143,"کمترین کاریش هر روزست آن","کو سه لشکر را کند این سو روان","کمترین کار او هر روز این است که سه لشکر را به این سو روانه می‌کند."],[143,"لشکری ز اصلاب سوی امهات","بهر آن تا در رحم روید نبات","برخی از انسان‌ها از نسل‌های پیشین به دنیا می‌آیند تا در رحم مادران شکل بگیرند و رشد کنند. این فرآیند به معنای ادامه نسل و زندگی است."],[143,"لشکری ز ارحام سوی خاکدان","تا ز نر و ماده پر گردد جهان","لشکری از انسان‌ها که از رحم مادران به دنیا می‌آیند، تا از ترکیب نر و ماده، دنیا پر شود."],[143,"لشکری از خاکدان سوی اجل","تا ببیند هر کسی حسن عمل","لشکری از انسان‌ها به سوی مرگ می‌رود تا حسن عمل هر فرد را ببیند و نتیجه آن را ببیند."],[143,"این سخن پایان ندارد هین بتاز","سوی آن دو یار پاک پاک‌باز","این گفتگو تمام‌شدنی نیست، پس شتاب کن و به سوی آن دو یار پاک دل و بی‌آلایش برو."],[143,"گفت یارش کاندر آ ای جمله من","نی مخالف چون گل و خار چمن","یارش گفت: ای همه، من مخالف نیستم؛ من مانند گل و خار در کنار چمن هستم."],[143,"رشته یکتا شد غلط کم شد کنون","گر دوتا بینی حروف کاف و نون","رشته‌ای (رابطه‌ای) که به یک موضوع خاص اشاره دارد، به وضوح و روشنی در آمده و دیگر با اشتباهاتی همراه نیست. اکنون اگر دو حرف «کاف» و «نون» را ببینی، به نظر می‌آید که یک نقص یا دوگانگی وجود دارد."],[143,"کاف و نون همچون کمند آمد جذوب","تا کشاند مر عدم را در خطوب","حرف‌های «کاف» و «نون» مانند کمندی هستند که وجود را از عدم بکشند و به دنیای پرماجرای حوادث بیاورند."],[143,"پس دوتا باید کمند اندر صور","گرچه یکتا باشد آن دو در اثر","بنابراین باید دو تا کمند در شکل‌های مختلف وجود داشته باشد، هرچند که آن دو در نتیجه یکی هستند."],[143,"گر دو پا گر چار پا ره را برد","همچو مقراض دو تا یکتا برد","هر تعداد پا که در راه باشند، یعنی چه دو پا و چه چهار پا، باز هم مانند یک قیچی دو لبه، به طور همزمان عمل می‌کنند و به جلو می‌روند."],[143,"آن دو همبازان گازر را ببین","هست در ظاهر خلافی زان و زین","دو شریک گازر (چرم‌ساز) را ببین که در ظاهر با یکدیگر مخالفت دارند، اما در باطن یکسان هستند و اختلافشان فقط در نمای ظاهری است."],[143,"آن یکی کرباس را در آب زد","وان دگر همباز خشکش می‌کند","یکی از آن دو، کرباس (پارچه) را در آب می‌زند تا خیس شود، در حالی که دیگری پارچه‌ی خشک را هم می‌کوشد که دوباره خشک کند."],[143,"باز او آن خشک را تر می‌کند","گوییا ز استیزه ضد بر می‌تند","کسی که در حال تر کردن کرباس خشک است، به گونه‌ای عمل می‌کند که نشان می‌دهد از تأثیرات متضاد و ضد یکدیگر فراتر رفته و بر آن‌ها غلبه می‌کند."],[143,"لیک این دو ضد استیزه‌نما","یک‌دل و یک‌کار باشد در رضا","اگرچه این دو موضوع متضاد به نظر می‌رسند، اما در حقیقت آن‌ها با هم توافق دارند و در رضایت و موافقت عمل می‌کنند."],[143,"هر نبی و هر ولی را مسلکیست","لیک تا حق می‌برد جمله یکیست","هر پیامبر و ولی، مکتب و روش خاصی دارد، اما زمانی که به حقیقت می‌رسند، همه آنها در راستای حق و حقیقت متحد و یکی می‌شوند."],[143,"چونک جمع مستمع را خواب برد","سنگهای آسیا را آب برد","زمانی که جمعیت شنوندگان خوابشان برد، آب سنگ‌های آسیا را نیز به همراه خود برد."],[143,"رفتن این آب فوق آسیاست","رفتنش در آسیا بهر شماست","آب که از آسیا می‌رود، از آنجا که در حال حرکت است، به شما ربطی ندارد و به خاطر آسیا و آسیاب به این طرف و آن طرف می‌رود."],[143,"چون شما را حاجت طاحون نماند","آب را در جوی اصلی باز راند","وقتی شما دیگر نیازی به آسیاب ندارید، آب را به جوی اصلی برگردانید."],[143,"ناطقه سوی دهان تعلیم راست","ورنه خود آن نطق را جویی جداست","جملات و سخنان درست و درست‌گو، از زبان انسان بیان می‌شود، وگرنه خود این سخن، مانند جوی جداست و از انسان جدا می‌باشد."],[143,"می‌رود بی بانگ و بی تکرارها","تحتها الانهار تا گلزارها","بدون صدا و تکرار، کلام به راحتی و به طور طبیعی از عمق وجود و قلب‌ها به سوی باغ‌ها و سرزمین‌های سبز جاری می‌شود."],[143,"ای خدا جان را تو بنما آن مقام","کاندرو بی‌حرف می‌روید کلام","خدای بزرگ، به من نشان بده آن جایگاهی را که در آن، کلام بدون نیاز به حرف و سخن بیرون می‌آید و جان حرکت می‌کند."],[143,"تا که سازد جان پاک از سر قدم","سوی عرصه دور و پهنای عدم","جان پاک باید ابتدا از نفس و خواسته‌های دنیوی فاصله بگیرد و به عرصه وسیع و نامحدود وجود پی برد."],[143,"عرصه‌ای بس با گشاد و با فضا","وین خیال و هست یابد زو نوا","در این دنیا که بسیار وسیع و آزاد به نظر می‌رسد، تصور و اندیشه انسان می‌تواند از این فضا به زندگی و مفهوم موسیقی دست یابد."],[143,"تنگ‌تر آمد خیالات از عدم","زان سبب باشد خیال اسباب غم","خیالات از عدم، تنگ‌تر و محدودتر می‌شوند و به همین خاطر خیال، باعث ایجاد غم و اندوه می‌شود."],[143,"باز هستی تنگ‌تر بود از خیال","زان شود در وی قمر همچون هلال","وجود دوباره محدودتر از خیال است و به همین دلیل در آن، چهره‌اش مانند هلال ماه نمایان می‌شود."],[143,"باز هستی جهان حس و رنگ","تنگ‌تر آمد که زندانیست تنگ","هستی و وجود جهان مادی و حسی، مانند زندانی است که انسان را در تنگنا قرار می‌دهد و محدودیت‌های آن بیشتر از آن چیزی است که در ابتدا به نظر می‌رسد."],[143,"علت تنگیست ترکیب و عدد","جانب ترکیب حسها می‌کشد","علت تنگی و محدودیت در جهان، به خاطر ترکیب و عدد (شمارش و تنوع) است که حس‌ها (ادراکات حسی) را به خود جلب می‌کند و باعث می‌شود انسان در این محدودیت‌ها گرفتار شود."],[143,"زان سوی حس عالم توحید دان","گر یکی خواهی بدان جانب بران","از آن طرف حس، عالم توحید را بشناس، اگر می‌خواهی یکی بشوی، باید به آن سوی بروی."],[143,"امر کن یک فعل بود و نون و کاف","در سخن افتاد و معنی بود صاف","فعل «کن» که به معنی «بکن» است، از آنجایی که حرف «نون» و «کاف» در کلام افتاده، معنی‌اش به وضوح فهمیده نمی‌شود، اما اصل معنای آن بسیار روشن و واضح است."],[143,"این سخن پایان ندارد باز گرد","تا چه شد احوال گرگ اندر نبرد","این گفت‌وگو پایانی ندارد. برگرد و ببین چه بر سر حال و احوال گرگ در هنگام جنگ آمده است."],[144,"گرگ را بر کند سر، آن سرفراز","تا نماند دوسری و امتیاز","سر گرگ را می‌زنی تا تیرگی و تمایز او از دیگران برطرف شود و دیگر هیچ نشانی از او باقی نماند."],[144,"فانتقمنا منهم است ای گرگ پیر","چون نبودی مرده در پیش امیر","ما از گرگ پیر انتقام می‌گیریم، زیرا تو در برابر امیر، هنوز زنده ای و کشته نشده‌ای."],[144,"بعد از آن رو شیر با روباه کرد","گفت این را بخش کن از بهر خورد","سپس شیر به روباه گفت که این گاو را به دیگران بده تا بخورند."],[144,"سجده کرد و گفت کین گاو سمین","چاشت‌خوردت باشد ای شاه گزین","شیر برای نشان دادن ادب خود و احترام به شاه، به سجده افتاد و گفت این گاو چاق که بزرگ و لذیذ است، غذایی مناسب برای تو، ای شاه برگزیده، می‌باشد."],[144,"وان بز از بهر میان روز را","یخنیی باشد شه پیروز را","و آن بز برای ناهار در نظر گرفته شده است، که باید تقدیم شاه پیروز شود."],[144,"و آن دگر خرگوش بهر شام هم","شب‌چره این شاه با لطف و کرم","و آن خرگوش دیگر هم به خاطر شام، در کنار این شاه، از لطف و مهربانی او بهره‌مند است."],[144,"گفت ای روبه تو عدل افروختی","این چنین قسمت ز کی آموختی","روباه به شاه می‌گوید: تو با انصاف و عدل رفتار کردی، و اینگونه تقسیم برکت و نعمت چه کسی به تو آموخته است؟"],[144,"از کجا آموختی این ای بزرگ","گفت ای شاه جهان از حال گرگ","این بزرگ، در پاسخ سؤال روبه، می‌گوید که من این نوع رفتار را از حال و وضعیت گرگ آموخته‌ام. یعنی با مشاهده وضعیت گرگ، دانستم که چطور باید رفتار کنم."],[144,"گفت چون در عشق ما گشتی گرو","هر سه را بر گیر و بستان و برو","گفت: چون شما در عشق ما وابسته شدی، همه‌تان را بگیرید و با خود ببرید."],[144,"روبها چون جملگی ما را شدی","چونت آزاریم چون تو ما شدی","چون همه روباه‌ها به ما نزدیک شدند و ما را آزار دادند، تو هم به خاطر اینکه شبیه ما شدی، به آزار ما پیوستی."],[144,"ما ترا و جمله اشکاران ترا","پای بر گردون هفتم نه بر آ","ما تو را و همه آشکاران را بر بالای آسمان هفتم، نه بر روی زمین، می‌دانیم و می‌نگریم."],[144,"چون گرفتی عبرت از گرگ دنی","پس تو روبه نیستی شیر منی","اگر از گرگ دنیا عبرت بگیری، پس تو مانند روباه نیستی، بلکه شیر هستی و دارای قدرت و شجاعت."],[144,"عاقل آن باشد که عبرت گیرد از","مرگ یاران در بلای محترز","عاقل کسی است که از مرگ دوستانش در مصیبت و گرفتاری‌ها درس بگیرد و عبرتی برای خود قرار دهد."],[144,"روبه آن دم بر زبان صد شکر راند","که مرا شیر از پی آن گرگ خواند","در آن لحظه، فقط شکرگزاری می‌کنم که شیر (نماد قدرت و شجاعت) مرا به خاطر آن گرگ (نماد خطر یا دشمنی) خوانده است."],[144,"گر مرا اول بفرمودی که تو","بخش کن این را، که بردی جان ازو","اگر ابتدا به من فرمان می‌دادید که این شخص (شیر) را ببخش و جانش را نجات دهم، من این کار را می‌کردم."],[144,"پس سپاس او را که ما را در جهان","کرد پیدا از پس پیشینیان","حالا از او سپاسگزاری می‌کنیم که ما را در این دنیا شناساند و وجود ما را بعد از پیشینیان مطرح کرد."],[144,"تا شنیدیم آن سیاستهای حق","بر قرون ماضیه اندر سبق","هنگامی که ما آن تدبیرهای الهی را در قرون گذشته شنیدیم و مشاهده کردیم که چگونه با اعمال پیشینیان برخورد شده است، متوجه شدیم."],[144,"تا که ما از حال آن گرگان پیش","همچو روبه پاس خود داریم بیش","تا زمانی که ما از وضعیت آن گرگ‌ها (مخالفان ما) آگاه هستیم و خود را مانند روباه (که حیله‌گر است) به دفاع از خود آماده می‌کنیم، در موقعیت قوی‌تری هستیم."],[144,"امت مرحومه زین رو خواندمان","آن رسول حق و صادق در بیان","این بیت به این اشاره دارد که پیامبر، در نقش راستگو و صادق، از امتی که به خاطر افکار و اعمال نادرست در خطر نابودی قرار دارند، می‌گوید و می‌خواند تا آنها را از انحراف نجات دهد."],[144,"استخوان و پشم آن گرگان عیان","بنگرید و پند گیرید ای مهان","استخوان و پشم آن گرگ‌ها را که نمایان است، ببینید و از آن‌ها درس عبرت بگیرید، ای بزرگان."],[144,"عاقل از سر بنهد این هستی و باد","چون شنید انجام فرعونان و عاد","عاقل باید از روی عقل و منطق به زندگی‌اش بنگرد و وقتی سرنوشت فرعون‌ها و قوم عاد را می‌بیند که به نابودی و سقوط رسیدند، عبرت بگیرد."],[144,"ور بننهد دیگران از حال او","عبرتی گیرند از اضلال او","اگر دیگران از حال او عبرتی بگیرند، در آن صورت می‌توانند از گمراهی او درس بگیرند."],[145,"گفت نوح ای سرکشان من، من نیم","من ز جان مردم به جانان می‌زیم","نوح علیه‌السلام به سرکشان می‌گوید: من دیگر خودم را نمی‌شناسم و از دست نفس و وجود خود مرده‌ام، اکنون روح و جانم تنها به وصال و ارتباط با خدا تعلق دارد."],[145,"چون بمردم از حواس بوالبشر","حق مرا شد سمع و ادراک و بصر","وقتی که از حواس انسانی و دنیوی خود مردم و کنار گذاشتم، در حقیقت، خدا به من گوش و بینایی و درک عطا کرد."],[145,"چونک من، من نیستم این دم ز هوست","پیش این دم هرکه دم زد کافر اوست","هرگاه که من به حقیقت وجود خود واقف نباشم و در این لحظه از خودم بی‌خبر شوم، هر کس که در این حال به من بگوید که من هستم، کافر است و به درستی ایمان نیاورده است."],[145,"هست اندر نقش این روباه شیر","سوی این روبه نشاید شد دلیر","در حقیقت جان من شیر وجود دارد اگر چه در ظاهر روباه می نماید، لذا در برابر این شیر الهی به ظاهر روباه دلیری نکنید"],[145,"گر ز روی صورتش می‌نگروی","غره شیران ازو می‌نشنوی؟","اگر از روی ظاهری او (نوح) ننگری، آیا نمی‌فهمی که شیران (نیرومندترها) از او می‌هراسند و به او احترام می‌گذارند؟"],[145,"گر نبودی نوح را از حق یدی","پس جهانی را چرا بر هم زدی؟","اگر نوح علیه‌السلام را حمایت و دست یاری الهی نبود، پس چرا جهانی را به هم زدی و آن را دگرگون کردی؟"],[145,"صد هزاران شیر بود او در تنی","او چو آتش بود و عالم خرمنی","نوح علیه‌السلام در وجود خود قدرت و شجاعت بسیاری داشت، مثل این که او هزاران شیر را در خود جای داده است، و از نظر تأثیرگذاری مانند آتش است که بر خرمن عالم می‌افروزد."],[145,"چونک خرمن پاس عشر او نداشت","او چنان شعله بر آن خرمن گماشت","وقتی که خرمن در برابر ده درصد زکاتش پاسخی نداشت، خداوند بر آن خرمن آتش افکند."],[145,"هر که او در پیش این شیر نهان","بی‌ادب چون گرگ بگشاید دهان","هر کس که به طور پنهانی در برابر این شیر (نوح) باشد و بی‌ادبانه حرف بزند، مانند گرگی دهانش را باز می‌کند."],[145,"همچو گرگ آن شیر بر دراندش","فانتقمنا منهم بر خواندش","شیر مانند گرگ به او حمله ور می‌شود و می‌گوید که ما از آنها انتقام می‌گیریم، همان‌طور که گرگ از حمله به دیگران نمی‌هراسد."],[145,"زخم یابد همچو گرگ از دست شیر","پیش شیر ابله بود کو شد دلیر","اگر کسی همچون گرگ به دست شیر زخم و آسیب ببیند، بی‌خود و احمق است که در برابر شیر به دلیر بودن تظاهر کند، زیرا شیر قدرت و قوت واقعی است."],[145,"کاشکی آن زخم بر تن آمدی","تا بدی کایمان و دل سالم بدی","کاش آن زخم به تو می‌رسید تا با آن زخم، ایمان و دل‌ت سالم می‌ماند."],[145,"قوتم بگسست چون اینجا رسید","چون توانم کرد این سر را پدید","وقتی به اینجا رسیدم، قوام و قدرت من از بین رفته است؛ حال چگونه می‌توانم این راز را آشکار کنم؟"],[145,"همچو آن روبه کم اشکم کنید","پیش او روباه‌ بازی کم کنید","مانند روباه، به جای اینکه در پیش او (خدای) تظاهر به ناز و فریب کنید، باید صادقانه و خالصانه در پیش او باشید و خود را بی‌پرده نشان دهید."],[145,"جمله ما و من به پیش او نهید","ملک ملک اوست ملک او را دهید","همه ما و خود را در پیش خداوند بگذارید، چراکه ملک و سلطنت از آن اوست. پس این سلطنت را به او بسپارید."],[145,"چون فقیر آیید اندر راه راست","شیر و صید شیر خود آن شماست","اگر به راه راست بیایید و در جستجوی حقیقت باشید، شیر و شکار او (موفقیت و پیروزی) از آن شما خواهد بود."],[145,"زانک او پاکست و سبحان وصف اوست","بی نیازست او ز نغز و مغز و پوست","چون خداوند، پاک و بی‌نقص است، نیازی به زیبایی‌ها و ظواهر دنیوی ندارد و از همه چیز بالاتر و فراتر است."],[145,"هر شکار و هر کراماتی که هست","از برای بندگان آن شهست","هر نوع نعمت و کرامتی که وجود دارد، برای بندگان خداوند است، که در اینجا به عنوان «شه» اشاره شده است."],[145,"نیست شه را طمع بهر خلق ساخت","این همه دولت خنک آنکو شناخت","خداوند هیچ امیدی برای بشر ندارد که از او به نفع دیگران استفاده کند، بلکه همه این نعمت‌ها و حکومت‌ها به خوشبختی آن کسی می‌رسد که او را بشناسد و حقیقت او را درک کند."],[145,"آنک دولت آفرید و دو سرا","ملک و دولتها چه کار آید ورا","کسی که این دنیا و آن دنیا و حکومت‌ها را آفرید، برای او هیچ فایده‌ای ندارد که ما اینجا بر سر قدرت و اقتدار با یکدیگر درگیر شویم."],[145,"پیش سبحان پس نگه دارید دل","تا نگردید از گمان بد خجل","خود را در برابر خداوند (سبحان) نگه دارید و آرام باشید تا از گمان‌های بد شرمنده نشوید."],[145,"کو ببیند سر و فکر و جست و جو","همچو اندر شیر خالص تار مو","هیچ‌کس نمی‌تواند عمق رازها و اندیشه‌ها را ببیند، به‌خصوص اگر مانند تار مویی در درون شیر خالص، کوچکتر از آن باشد که قابل مشاهده باشد."],[145,"آنک او بی نقش ساده‌سینه شد","نقشهای غیب را آیینه شد","آن‌که از ظاهر و شکل و رنگ خود رهایی یافته و به سادگی و خلوص رسیده است، اکنون به آیینه‌ای تبدیل شده که می‌تواند رازهای پنهان را به روشنی نشان دهد."],[145,"سر ما را بی‌گمان موقن شود","زان که مؤمن آینه مؤمن بود","راز ما بدون شک روشن می‌شود، زیرا مؤمن مانند آینه‌ای برای مؤمنان دیگر است و حقیقت را به آن‌ها نشان می‌دهد."],[145,"چون زند او نقد ما را بر محک","پس یقین را باز داند او ز شک","وقتی او (خدای) ما را آزمایش کند و ارزش ما را مشخص کند، آنگاه یقین و حقیقت را از تردید تمیز خواهد داد."],[145,"چون شود جانش محک نقدها","پس ببیند قلب را و قلب را","وقتی که جان انسان به عنوان معیاری برای سنجش ارزش‌ها قرار گیرد، او می‌تواند حقیقت قلب خود را ببیند و با اندیشه‌اش بهتر آشنا شود."],[146,"پادشاهان را چنان عادت بود","این شنیده باشی ار یادت بود","پادشاهان به گونه‌ای عادت کرده بودند که همواره این موضوع را شنیده و به خاطر سپرده بودند."],[146,"دست چپشان پهلوانان ایستند","زانک دل پهلوی چپ باشد ببند","در دست چپ پادشاه، پهلوانان قرار دارند زیرا دل در سمت چپ قرار دارد و باید آن‌ها را جمع کنند."],[146,"مشرف و اهل قلم بر دست راست","زانک علم خط و ثبت آن دست راست","اهل علم و نویسندگان بر دست راست پادشاه ایستاده‌اند، زیرا علم نوشتن و ثبت کردن معمولا با دست راست انجام می‌شود."],[146,"صوفیان را پیش رو موضع دهند","کاینه جانند و ز آیینه بهند","صوفیان (عاشقان خدا) را در مقابل خود قرار می‌دهند تا به آن‌ها نشان دهند که جان‌هایشان مانند آینه است و آنچه در آینه مشاهده می‌شود، از خود آینه نیست بلکه از نور یا واقعیت بیرون است."],[146,"سینه صیقلها زده در ذکر و فکر","تا پذیرد آینه دل نقش بکر","دل آدمی باید به وسیله یاد خدا و تفکر، پاک و سابیده شود تا بتواند نقش تازه و زیبای حقیقت را در خود ببیند و بپذیرد."],[146,"هر که او از صلب فطرت خوب زاد","آینه در پیش او باید نهاد","هر کسی که از ذات و طبیعت پاک به دنیا آمده باشد، باید آینه‌ای در جلو او قرار داد تا زیبایی‌های او را منعکس کند."],[146,"عاشق آیینه باشد روی خوب","صیقل جان آمد و تقوی القلوب","عاشق به مانند آینه‌ای است که زیبایی‌های محبوب را نشان می‌دهد، و با توجه به خوب بودن جان و تقوا، دل‌ها را پاک و روشن نگه می‌دارد."],[147,"آمد از آفاق، یار مهربان","یوسف صدّیق را شد میهمان","یار مهربان یوسف، از دوردست‌ها آمد و مهمان او شد."],[147,"کاشنا بودند وقت کودکی","بر وساده آشنایی متکی","در زمان کودکی، آن‌ها به خوبی با یکدیگر آشنا بودند و بر پایه این آشنایی، احساس نزدیکی و صمیمیت داشتند."],[147,"یاد دادش جور اخوان و حسد","گفت کان زنجیر بود و ما اسد","یاد او را به بدی‌های برادران و حسادت آنها انداختند و گفتند که این زنجیر به گردن او است و ما مانند شیر، آزاد و قوی هستیم."],[147,"عار نبود شیر را از سلسله","نیست ما را از قضای حق گله","شیر، که نماد قدرت و شجاعت است، نباید از زنجیری که به گردنش است، شرمنده شود، همان‌طور که ما نباید از تقدیری که بر ما گذشته گله و شکایت کنیم."],[147,"شیر را بر گردن ار زنجیر بود","بر همه زنجیرسازان میر بود","اگر شیر (فرد قوی و برجسته) هم زنجیر داشته باشد، همچنان بر تمام زنجیرسازان پیشوا و رئیس است."],[147,"گفت چون بودی ز زندان و ز چاه","گفت همچون در محاق و کاست ماه","یوسف (علیه‌السلام) در پاسخ به سوالی درباره وضعیتش می‌گوید که مانند ماهی است که در حال محاق است و به تدریج کم‌نور می‌شود، زیرا او هم به دلیل زندان و چاه، در شرایط سختی قرار داشته و امیدش کم شده است."],[147,"در محاق ار ماه نو گردد دوتا","نی در آخر بدر گردد بر سما؟","اگر ماه نو در تاریکی و نبود نور (محاق) قرار بگیرد، آیا دو نیمه نمی‌شود؟ در پایان، هنگامی که کامل می‌شود و به حالت بدر (ماه کامل) درمی‌آید، در آسمان به چه صورت خواهد بود؟"],[147,"گرچه دردانه به هاون کوفتند","نور چشم و دل شد و بیند بلند","هرچند که گوهر گرانبهایی را در هاون (آسیاب) می‌کوبند، اما او را دیده و قلبی روشنی‌ بخش می‌سازد و به مرتبه‌ای بلند می‌رسد."],[147,"گندمی را زیر خاک انداختند","پس ز خاکش خوشه‌ها بر ساختند","گندم را در زیر خاک قرار دادند، اما بعد از مدتی، از آن دانه‌های گندم خوشه‌هایی رویید و به وجود آمد."],[147,"بار دیگر کوفتندش ز آسیا","قیمتش افزود و نان شد جان‌فزا","گندم را دوباره در آسیاب آسیاب کردند، و با این کار ارزش آن بیشتر شد و نان به دست آمد که جان‌افزاست و روح را تازه می‌کند."],[147,"باز، نان را زیر دندان کوفتند","گشت عقل و جان و فهم هوشمند","نان را دوباره زیر دندان فشار دادند و این کار سبب شد که عقل، جان و فهم، هوش و ذکاوت پیدا کنند."],[147,"باز آن جان چونک محو عشق گشت","یعجب الزّرّاع آمد بعد کشت","وقتی جان انسان در عشق غرق می‌شود، مانند دانه‌ای است که پس از کشت، سبز و روییده می‌شود و این وضعیت توجه و شگفتی را ایجاد می‌کند."],[147,"این سخن پایان ندارد باز گرد","تا که با یوسف چه گفت آن نیک‌مرد","سخن گفتن به اینجا پایان نمی‌رسد، برگرد و ببین آن نیک‌مرد (یوسف) چه چیزی به مهمان گفت."],[147,"بعد قصه گفتنش گفت ای فلان","هین چه آوردی تو ما را ارمغان","پس از اینکه داستان را گفت، یوسف به آن آدم اشاره کرد و پرسید: ای فلانی، چه چیزی برای ما هدیه آوردی؟"],[147,"بر در یاران تهی‌دست آمدن","هست بی‌گندم سوی طاحون شدن","وقتی مهمانی به نزد یاران نادار می‌آید، انتظار ندارد که از آن‌ها چیزی بگیرد؛ حتی بی‌گندم (غلات) هم به آسیاب نخواهد رفت، به این معنا که اگر چیزی نداشته باشند، نمی‌توانند چیزی به کسی بدهند."],[147,"حق تعالی خلق را گوید بحشر","ارمغان کو از برای روز نشر","خداوند به بندگانش می‌گوید: در روز رستاخیز، چه چیزی به عنوان هدیه و ارمغان برای من آورده‌اید؟"],[147,"جئتمونا و فرادی بی نوا","هم بدان سان که خلقناکم کذا","شما به صورت تنها و نیازمند به ما آمده‌اید، همان‌طور که ما شما را از ابتدا خلق کردیم."],[147,"هین چه آوردید دست‌آویز را","ارمغانی روز رستاخیز را","ای مهمانان، چه هدیه و تحفه‌ای به همراه آورده‌اید که در روز قیامت، به عنوان پاداش و نیکویی شما به حساب آید؟"],[147,"یا امید بازگشتنتان نبود","وعده امروز باطلتان نمود","شما انتظاری برای بازگشت به سوی من نداشتید و به همین دلیل، وعده و قول امروز شما را ناامید کرد."],[147,"منکری مهمانیش را از خری","پس ز مطبخ خاک و خاکستر بری","منکر، یعنی کسی که منکر و نادرست است، مهمانی خود را از آنگونه زندگی و روزی پریشان که تنها در مطبخ (آشپزخانه) و پر از خاک و خاکستر است، دور کن."],[147,"ور نه‌ای منکر چنین دست تهی","در در آن دوست چون پا می‌نهی","اگر تو به استقبال دوست نمی‌روی و دست خالی می‌آیی، پس چگونه می‌خواهی در حضور او قدم بگذاری؟"],[147,"اندکی صرفه بکن از خواب و خور","ارمغان بهر ملاقاتش ببر","کمی از خواب و خوراک خود بزن و هدیه‌ای برای دیدن او تهیه کن."],[147,"شو قلیل النوم مما یهجعون","باش در اسحار از یستغفرون","کم بخواب و از خواب‌هایی که تو را غافل می‌کند دوری کن، در سحرگاهان مشغول استغفار و طلب آمرزش باش."],[147,"اندکی جنبش بکن همچون جنین","تا ببخشندت حواس نوربین","کمی جا به جا شو و حرکتی بکن مثل جنینی که در رحم است، تا اینکه بتوانی حواس روشن و بینا را از آن خود کنی و به دانایی و آگاهی دست یابی."],[147,"وز جهان چون رحم، بیرون روی","از زمین در عرصه واسع شوی","از دنیا که مانند رحم است، بیرون بیا و بر روی زمینی وسیع قرار بگیر."],[147,"آنک ارض الله واسع گفته‌اند","عرصه‌ای دان انبیا را بس بلند","گفته‌اند که زمین خدا وسیع است، و این مکان گسترده‌ای که انبیا در آن قرار دارند بسیار بلند و وسیع است."],[147,"دل نگردد تنگ زان عرصه فراخ","نخل تر آنجا نگردد خشک شاخ","دل انسان در آن سرزمین وسیع، که مانند نخل تر و سبز است، نباید تنگ و گرفته شود، چرا که در آنجا شاخ و برگ‌ها خشک نمی‌شوند و همواره سرسبز و زنده هستند."],[147,"حاملی تو مر حواست را کنون","کند و مانده می‌شوی و سرنگون","تو اکنون بار و مسئولیت خود را فراموش کرده‌ای و به همین دلیل در وضعیتی گیر کرده‌ای و دچار سقوط و افول خواهی شد."],[147,"چونک محمولی نه حامل وقت خواب","ماندگی رفت و شدی بی رنج و تاب","وقتی که باربر (محمولی) خواب را که نمی‌تواند حمل کند، به راحتی و بدون زحمت و رنج از بین می‌رود، تو نیز از این وضعیت رنج نخواهی کشید و خواهی رفت."],[147,"چاشنیی دان تو حال خواب را","پیش محمولی حال اولیا","حال خواب را چاشنی دان، زیرا حال اولیا مانند حال محمولی (بارکش) است که در خواب مانده‌اند."],[147,"اولیا اصحاب کهفند ای عنود","در قیام و در تقلب هم رقود","اولیا، کسانی هستند که مانند اصحاب کهف در برابر مشکلات و تحول‌ها ایستادگی می‌کنند و در حالت آرامش و سکون باقی می‌مانند."],[147,"می‌کشدشان بی تکلف در فعال","بی‌خبر ذات الیمین ذات الشّمال","خداوند آن‌ها را بی‌هیچ سختی، به کار ها وامی‌دارد به جلو می‌روند و چه درستکاران و چه گمراهان(گروه چپ و راست در قیامت) از این امر ناآگاهند."],[147,"چیست آن ذات الیمین؟ فعل حسن","چیست آن ذات الشّمال؟ اشغال تن","ذات الیمین به معنای صفات نیکو و کارهای خوب است و در مقابل، ذات الشمال به صفات و اعمال ناپسند اشاره دارد. بنابراین، آیا این کارهای خوب از آن ذات الیمین می‌آید و کارهای زشت از آن ذات الشمال؟ در واقع، این سوال به تداخل و ارتباط بین فعل نیک و بد و آثار آن در زندگی انسان اشاره دارد."],[147,"می‌رود این هر دو کار از انبیا","بی‌خبر زین هر دو ایشان چون صدا","هر دو کار نیک و بد برای انبیا نامشخص است و آن‌ها از این دو موضوع بی‌خبرند، زیرا صدای این دو (خیر و شر) را نمی‌شنوند."],[147,"گر صدایت بشنواند خیر و شر","ذات که باشد ز هر دو بی‌خبر","اگر صدایت را بشنود، خیر و شر از ذات کوه می‌آید که از هر دو (خیر و شر) بی‌خبر است."],[148,"گفت یوسف هین بیاور ارمغان","او ز شرم این تقاضا زد فغان","یوسف از مهمان می‌خواهد که هدیه‌اش را بیاورد، اما به خاطر شرمی که از این درخواست دارد، آه و ناله‌ای سر می‌دهد."],[148,"گفت من چند ارمغان جستم ترا","ارمغانی در نظر نامد مرا","یوسف می‌گوید که من مدت‌ها به دنبال یک هدیه برای تو بوده‌ام، اما هیچ چیز مناسبی در نظرم نرسیده است."],[148,"حبّه‌ای را جانب کان چون برم","قطره‌ای را سوی عمّان چون برم","اگر گوهر گران‌بها (حبّه‌ای) از معدن زیبا به سوی عمان ببرم، گویا قطره‌ای از دریاست که به سوی دریا می‌برم."],[148,"زیره را من سوی کرمان آورم","گر به پیش تو دل و جان آورم","من زیره را از کرمان نزد تو می‌آورم، اگر دل و جان خود را هم به پیش تو بیاورم."],[148,"نیست تخمی کاندرین انبار نیست","غیر حسن تو که آن را یار نیست","هیچ دانه‌ای در این انبار نیست که ارزش داشته باشد؛ تنها زیبایی توست که هیچ هم‌تایی ندارد."],[148,"لایق آن دیدم که من آیینه‌ای","پیش تو آرم چو نور سینه‌ای","من خود را لایق دیدار تو می‌دانم و می‌خواهم آینه‌ای برای تو بیاورم تا مانند نور در سینه‌ام روشنایی تو را نشان دهم."],[148,"تا ببینی روی خوب خود در آن","ای تو چون خورشید شمع آسمان","تا وقتی در آن آینه زیبایی خود را می‌بینی، تو همچون خورشید و شمعی در آسمان می‌شوی."],[148,"آینه آوردمت ای روشنی","تا چو بینی روی خود یادم کنی","ای روشنایی، من آینه‌ای برای تو آورده‌ام تا وقتی که چهره خود را در آن می‌بینی، به یاد من هم بیفتی."],[148,"آینه بیرون کشید او از بغل","خوب را آیینه باشد مشتغل","یوسف (علیه‌السلام) آینه‌ای را از زیر بغل خود بیرون آورد تا نشان دهد که خوب بودن و زیبایی، واقعیتی در درون فرد است و این آینه همچون مجلسی است که آن زیبایی را نمایان می‌کند."],[148,"آینه هستی چه باشد نیستی","نیستی بر، گر تو ابله نیستی","آینه هستی چه معنایی دارد؟ آنچه ما هستیم در واقع عدم است، اگر فهمی درست داشته باشی و ابله نباشی."],[148,"هستی اندر نیستی بتوان نمود","مال‌داران بر فقیر آرند جود","در دنیای وجود، می‌توان در قلب نیستی هم جلوه‌ای از هستی پیدا کرد و حتی کسانی که مال‌دار هستند، می‌توانند به فقرا بخشش و نیکی کنند."],[148,"آینه صافی نان خود گرسنه‌ست","سوخته هم آینه آتش‌زنه‌ست","آینه‌ای که کاملا صاف و شفاف است، در حقیقت به خاطر گرسنگی و نیاز خود، همیشه نگران و در عذاب است. این آینه، مانند آتش‌زنه‌ای سوخته، پیوسته در آتش و شدت شعله‌ها خود را می‌سوزاند."],[148,"نیستی و نقص هر جایی که خاست","آینه خوبی جمله پیشه‌هاست","در هر جا که نقص و نبودن وجود داشته باشد، آینه خوبی هم آنجا موجود است و می‌تواند آنچه را که خوب است نشان دهد."],[148,"چونک جامه چست و دوزیده بود","مظهر فرهنگ درزی چون شود","وقتی که لباس به‌طور شایسته و محکم دوخته شده باشد، در حقیقت نمایانگر فرهنگ و هنر در دوخت است."],[148,"ناتراشیده همی باید جذوع","تا دروگر اصل سازد یا فروع","باید چوبی که به‌دست نجار می‌آید هنوز کاملا صاف و صیقلی نشده باشد، تا او بتواند از آن، قطعه‌های اصلی یا اضافی بسازد."],[148,"خواجه اشکسته‌بند آنجا رود","کاندر آنجا پای اشکسته بود","آدمی با روح و نفس جریح‌خورده (اشکسته) به جایی می‌رود که او را با نفس و روح آسیب‌دیده‌اش می‌شناسند و درک می‌کنند."],[148,"کی شود چون نیست رنجور نزار","آن جمال صنعت طب آشکار","در صورتی که زیبایی و هنر در جایی وجود نداشته باشد، نمی‌توان انتظار داشت که حالتی از درد و رنج و بیماری در آنجا ظاهر شود. در واقع، اگر هنر و زیبایی نباشد، حال رنجور و نزار نمی‌تواند خودش را نشان دهد."],[148,"خواری و دونی مسها بر ملا","گر نباشد کی نماید کیمیا","اگر مس (فلز بی‌ارزش) در معرض آزمایش نباشد، نمی‌تواند ارزش کیمیا را نشان دهد. به عبارت دیگر، تنها در شرایط خاص و با آزمایش می‌توان به ارزش واقعی چیزها پی برد."],[148,"نقصها آیینه وصف کمال","و آن حقارت آینه عز و جلال","نقص‌ها و کمبودها، همچون آینه‌ای هستند که زیبایی و کمال را به نمایش می‌گذارند، و این حقارت‌ها نیز مانند آینه‌ای از بزرگی و جلال، نمایانگر مقام و عظمت هستند."],[148,"زانک ضد را ضد کند پیدا یقین","زانک با سرکه پدیدست انگبین","چون ضدّ یک چیز، چیز دیگر را آشکار می‌کند، یقینا هر چیزی بر اساس تضاد با چیز مخالفش مشخص می‌شود. همان‌طور که سرکه به خاطر وجود آن می‌تواند انگبین (عسل) را نشان دهد."],[148,"هر که نقص خویش را دید و شناخت","اندر استکمال خود ده‌اسپه تاخت","هر کسی که نقص‌های خود را ببیند و بشناسد، به سمت تکمیل و کمال خویش حرکت می‌کند."],[148,"زان نمی‌پرد به سوی ذوالجلال","کو گمانی می‌برد خود را کمال","کسی که به کمال خود می‌بالد و تصور می‌کند که پیشرفته است، نمی‌تواند به سوی خداوند متعال و بی‌نهایت برود."],[148,"علتی بتر ز پندار کمال","نیست اندر جان تو ای ذو دلال","هیچ چیزی در وجود تو بدتر از خیال کمال نیست؛ این خیال باعث می‌شود که به نقص‌های خود توجه نکنی."],[148,"از دل و از دیده‌ات بس خون رود","تا ز تو این معجبی بیرون شود","باید از دل و چشمانت بسیار گریه کنی تا این شگفتی و حیرت که در وجود توست، خارج شود."],[148,"علت ابلیس انا خیری بدست","وین مرض در نفس هر مخلوق هست","ابلیس به خاطر خودخواهی و غرور گفت که من از همه‌ی مخلوقات بهترم و این نقص و بیماری در وجود هر موجودی وجود دارد."],[148,"گرچه خود را بس شکسته بیند او","آب صافی دان و سرگین زیر جو","هرچند او (انسان) خود را شکست‌خورده و ناامید می‌بیند، اما آب زلال و صاف را در زیر گل و کثافت تصور می‌کند."],[148,"چون بشوراند ترا در امتحان","آب سرگین رنگ گردد در زمان","وقتی که در امتحان، آب تو را به هم بزند، سرگین (مواد کثیف) باعث می‌شود آب در همان لحظه رنگین و کثیف شود."],[148,"در تگ جو هست سرگین ای فتی","گرچه جو صافی نماید مر ترا","در درون یک چشمه زلال ممکن است آلودگی وجود داشته باشد، ای فتی (مرد دانا و آگاه)، هرچند که آن چشمه به نظر پاک بیاید."],[148,"هست پیر راه‌دان پر فطن","باغهای نفس کل را جوی کن","پیر راه‌دان، یعنی استاد و راهنمای با تجربه و زیرک، در باغ‌های نفس، یعنی در عمق روح و خواسته‌های انسانی، باید جوی کند. این به معنای این است که انسان باید در عمق وجود خودش جستجو کند و از خواسته‌ها و امیال خود آگاه شود."],[148,"جوی خود را کی تواند پاک کرد","نافع از علم خدا شد علم مرد","انسان چگونه می‌تواند روح و جان خود را پاک کند؛ آن هم تنها با علم الهی، که باعث نفع و سودمندی انسان می‌شود."],[148,"کی تراشد تیغ دسته خویش را","رو به جراحی سپار این ریش را","کی می‌تواند تیغ خود را به دست جراح بسپارد تا ریش خود را بتراشد؟ یعنی هیچ‌کس ریش خودش را به کسانی که در آن مهارت ندارند نمی‌سپارد."],[148,"بر سر هر ریش جمع آمد مگس","تا نبیند قبح ریش خویش کس","مگس‌ها بر روی هر ریش جمع شده‌اند تا کسی عیوب و زشتی‌های ریش خودش را نبیند. این بیان به نوعی نشان‌دهنده‌ی غفلت انسان‌ها از عیب‌های خودشان است."],[148,"آن مگس اندیشه‌ها وان مال تو","ریش تو آن ظلمت احوال تو","آن مگس (که نماد اندیشه‌های منفی و مزاحم است) نشانه افکار منفی تو و آن مال (که اشاره به زوال و کاستی‌ها دارد) نشان‌دهنده وضعیت ناخوشایند و تاریک تو است."],[148,"ور نهد مرهم بر آن ریش تو پیر","آن زمان ساکن شود درد و نفیر","اگر بر ریش تو، که نشانه پیری است، مرهمی بگذارد، در آن صورت دردی که از آن رنج می‌بری، آرام می‌گیرد و صداهای ناله و فریاد ساکت می‌شود."],[148,"تا که پندارد که صحت یافتست","پرتو مرهم بر آنجا تافتست","تا زمانی که فکر کند که خوب شده، نور مرهم بر آنجا تابیده است."],[148,"هین ز مرهم سر مکش ای پشت‌ریش","و آن ز پرتو دان مدان از اصل خویش","ای کسی که پشت‌ریش هستی و خود را مرهم می‌زنی، مواظب باش که سر خود را نپوشانی، و نگو که نور و روشنایی از خودت است؛ این را از اصل وجود خودت بدان."],[149,"پیش از عثمان یکی نساخ بود","کو به نسخ وحی جدی می‌نمود","پیش از عثمان، یکی از کاتب‌ها بود که به نوشتن وحی به طور جدی می‌پرداخت."],[149,"چون نبی از وحی فرمودی سبق","او همان را وا نبشتی بر ورق","زمانی که پیامبر از وحی صحبت کرد، آن نساخ (کاتب) همان آیات را که هنوز ابلاغ نشده بود، بر روی کاغذ نوشت."],[149,"پرتو آن وحی بر وی تافتی","او درون خویش حکمت یافتی","نور وحی به او تابید و او در دلش حکمت را یافت."],[149,"عین آن حکمت بفرمودی رسول","زین قدر گمراه شد آن بوالفضول","رسول خدا (محمد صلی الله علیه و سلم) همان حکمت را که از جانب خدا فرمود، باعث شد که این فرد جاهل و پرحرف (بوالفضول) از مسیر حق و حقیقت گمراه شود."],[149,"کانچ می‌گوید رسول مستنیر","مر مرا هست آن حقیقت در ضمیر","رسول (پیامبر اسلام) می‌گوید که هرچه من می‌گویم، حقیقتی است که در درون مرا روشن کرده و در ضمیرم (وجودم) وجود دارد."],[149,"پرتو اندیشه‌اش زد بر رسول","قهر حق آورد بر جانش نزول","پرتو اندیشه و فکر او بر پیامبر، موجب خشم و غضب خداوند و نزول عذاب بر جانش شد."],[149,"هم ز نساخی بر آمد هم ز دین","شد عدوّ مصطفی و دین بکین","او از بین کتابت و تحصیل دین، دشمن پیامبر (مصطفی) شد و به کینه‌ورزی علیه دین برخواست."],[149,"مصطفی فرمود کای گبر عنود","چون سیه گشتی اگر نور از تو بود؟","پیامبر (مصطفی) به این شخص بت پرست و لجوج می‌گوید: اگر تو دارای نور و آگاهی الهی بودی، چرا در این حالت تاریکی و کفر به سر می‌بری؟"],[149,"گر تو ینبوع الهی بودیی","این چنین آب سیه نگشودیی","اگر تو منبع الهی بودی، این‌گونه آب سیاه (فاسد) از شخصیتت نمی‌جوشید."],[149,"تا که ناموسش به پیش این و آن","نشکند بر بست این او را دهان","او به خاطر این که مبادا آبرو و ناموسش در مقابل دیگران آسیب ببیند، دهانش را بسته و چیزی نمی‌گوید."],[149,"اندرون می‌سوختش هم زین سبب","توبه کردن می‌نیارست این عجب","او به دلیل سوختن دلش از این موضوع نمی‌توانست توبه کند، و این واقعا عجیب است که او نتوانسته به راه درست برگردد."],[149,"آه می‌کرد و نبودش آه سود","چون در آمد تیغ و سر را در ربود","او آه و ناله می‌کرد، اما ناله‌اش سودی نداشت، چون وقتی شمشیر به او نزدیک شد و جانش را گرفت، این صدا بی‌فایده بود."],[149,"کرده حق ناموس را صد من حدید","ای بسا بسته به بند ناپدید","حق (خدا) شریعت را چنان محکم و استوار قرار داده که اگر کسی از آن تخلف کند، به شدت مجازات خواهد شد. بسیاری از افراد در بندهای ناپیدا و گمراهی گرفتار شده‌اند که از دید دیگران پنهان است."],[149,"کبر و کفر آن سان ببست آن راه را","که نیارد کرد ظاهر آه را","کبر (تکبر) و کفر (عدم ایمان) به اندازه‌ای آن راه را مسدود کردند که آه (ناله) هم نمی‌تواند به وضوح و آشکاری از دل برآید."],[149,"گفت اغلالا فهم به مقمحون","نیست آن اغلال بر ما از برون","گفت: آن زنجیرها و محدودیت‌ها مانع فهم ما نیست، زیرا این زنجیرها تنها از بیرون بر ما تحمیل شده‌اند."],[149,"خلفهم سدا فاغشیناهم","می‌نبیند بند را پیش و پس او","این بیت می‌گوید که خداوند در قرآن می‌فرماید: ما بر دل‌های آنها پرده‌ای می‌زنیم، به طوری که نمی‌توانند راه راست را در پیش و پس خود ببینند. بند، استعاره از موانع فکری و دینی است که مانع از درک حقیقت می‌شود."],[149,"رنگ صحرا دارد آن سدی که خاست","او نمی‌داند که آن سد قضاست","آن سدی که در صحرا پدید آمده، از رنگ و حال و هوای صحرا نشان دارد، اما او نمی‌داند که این سد به مقدر و سرنوشت (قضا) وابسته است."],[149,"شاهد تو سد روی شاهدست","مرشد تو سد گفت مرشدست","شاهد تو، یعنی معشوق یا محبوب تو، به مانند سدی است که بر روی آن ایستاده است و مرشد تو نیز در مقام راهنما، خود را مانند سدی معرفی می‌کند که به تو آموزش می‌دهد. این به نوعی اشاره به موانع یا محدودیت‌هایی است که بین انسان و حقیقت وجود دارد."],[149,"ای بسا کفار را سودای دین","بندشان ناموس و کبر آن و این","بسیاری از کافران با آرزوی دین و مذهب در دل خود، به خاطر ناموس (غیرت) و خودبزرگ‌بینی (کبر) به آن رغبتی نشان می‌دهند."],[149,"بند پنهان لیک از آهن بتر","بند آهن را کند پاره تبر","بندهای پنهانی که در دل انسان وجود دارد، از بندهای ظاهری و آهنین خطرناکترند، چون تبر می‌تواند بند آهنی را بشکند، اما کسی نمی‌تواند آن بندهای ناپیدا را بگسلت."],[149,"بند آهن را توان کردن جدا","بند غیبی را نداند کس دوا","بندهای غیبی و غیرمادی را هیچ‌کس نمی‌تواند با ابزارهای مادی و دنیوی از بین ببرد یا درمان کند، اما ممکن است بتوان بندهای مادی مثل بند آهنی را جدا کرد."],[149,"مرد را زنبور اگر نیشی زند","طبع او آن لحظه بر دفعی تند","اگر زنبور به مردی نیش بزند، در آن لحظه طبع او به شدت واکنش نشان می‌دهد و می‌خواهد از خود دفاع کند."],[149,"زخم نیش اما چو از هستی تست","غم قوی باشد نگردد درد سست","زخم نیش زنبور، اگرچه دردناک است، ولی چون از وجود و هستی تو ناشی می‌شود، غم و درد آن بسیار شدید و قوی خواهد بود و به سادگی تسکین نمی‌یابد."],[149,"شرح این از سینه بیرون می‌جهد","لیک می‌ترسم که نومیدی دهد","من از دل و جان این موضوع را توضیح می‌دهم، اما می‌ترسم که این صحبت‌ها باعث ناامیدی شما شوند."],[149,"نی مشو نومید و خود را شاد کن","پیش آن فریادرس فریاد کن","به ناامیدی روی نیاور و خودت را خوشحال نگه‌دار، در برابر پروردگار فریاد و درخواست کن تا از تو دریغ نکند."],[149,"کای محب عفو از ما عفو کن","ای طبیب رنج ناسور کهن","ای دوست، ما را ببخش و عفو کن، چون تو درمانگر دردهای قدیمی مردم هستی."],[149,"عکس حکمت آن شقی را یاوه کرد","خود مبین تا بر نیارد از تو گرد","شخص شقاوت‌پیشه (شقی) به جای حکمت، برای خود سخنان بی‌فایده‌ای درست کرده است. او را ننگر که مبادا از تو گردی (گناه یا ناپاکی) به دامانش برسد."],[149,"ای برادر بر تو حکمت جاریه‌ست","آن ز ابدالست و بر تو عاریه‌ست","ای برادر، حکمت در وجود تو است که از ابدال (مردان کامل و عارف) می‌آید، اما این حکمت به تو تعلق ندارد و تنها به صورت عاریه‌ای است که به تو داده شده است."],[149,"گرچه در خودخانه نوری یافتست","آن ز همسایه منور تافتست","اگرچه در خانه‌اش نوری پیدا شده، اما این نور از همسایه‌ای با نور بیشتر تابیده است."],[149,"شکر کن، غره مشو، بینی مکن","گوش دار و هیچ خودبینی مکن","سپاسگزار باش و مغرور نشو، به خودت نبال و نسبت به خودبینی پرهیز کن."],[149,"صد دریغ و درد، کین عاریتی","امتّان را دور کرد از امّتی","غصه و درد بسیار است که این عاریتی (نسیه یا ارثی) به تاریخ امت‌ها این گونه باعث جدایی می‌شود و آن جامعه را از تدبیر و هدایت دور می‌کند."],[149,"من غلام آن که او در هر رباط","خویش را واصل نداند بر سماط","من بنده کسی هستم که در هر مکانی (یا ارتباطی) خود را به کسی وابسته نمی‌داند و آزاد و مستقل است."],[149,"بس رباطی که بباید ترک کرد","تا به مسکن در رسد یک روز مرد","برای رسیدن به منزلی نیک و امن، باید بسیاری از مکان‌ها و تعلقات را رها کرد. این سفر و تلاش گاه طولانی و دشوار است، اما در نهایت به هدف خواهد رسید."],[149,"گرچه آهن سرخ شد، او سرخ نیست","پرتو عاریت آتش‌زنیست","هرچند که رنگ آهن به حرارت و آتش سرخ می‌شود، اما خود آهن به‌طور واقعی سرخ نیست؛ بلکه این رنگ، نتیجۀ تأثیر آتش بر آن است و نشان می‌دهد که این سرخی وجود واقعی ندارد و قرضی از آتش است."],[149,"گر شود پر نور روزن یا سرا","تو مدان روشن مگر خورشید را","اگر روزنی یا جایی روشن شد، فراموش نکن که خود آنجا نورانی نیست، بلکه روشنایی از خورشید آمده است."],[149,"هر در و دیوار گوید روشنم","پرتو غیری ندارم این منم","هر در و دیواری می‌گوید که من روشن هستم و هیچ نور دیگری ندارم، این فقط من هستم که نور دارم."],[149,"پس بگوید آفتاب ای نارشید","چونک من غارب شوم، آید پدید","آفتاب می‌گوید: ای آتش خورشید، وقتی من غروب کنم، تو هم آشکار خواهی شد."],[149,"سبزه‌ها گویند ما سبز از خودیم","شاد و خندانیم و بس زیبا خدیم","سبزه‌ها می‌گویند: ما به خاطر خودمان سبز هستیم و به همین دلیل شاد و خندانیم و بسیار زیبا به نظر می‌رسیم."],[149,"فصل تابستان بگوید ای امم","خویش را بینید چون من بگذرم","فصل تابستان به انسان‌ها می‌گوید که خود را ببینند و خود را بشناسند وقتی من از میانشان می‌روم."],[149,"تن همی‌نازد به خوبی و جمال","روح پنهان کرده فرّ و پر و بال","تن به زیبایی و جمال خود می‌بالد، در حالی که روح در پس این زیبایی، خاصیت و قدرتی پنهان کرده است که مانند بال و پر برای پرواز است."],[149,"گویدش ای مزبله تو کیستی","یک دو روز از پرتو من زیستی","این بیت به نکوهش کسی می‌پردازد که از نور و فضیلت آگاه شده ولی خود را بهپای چیزهای پست و ناچیز پایین می‌آورد. در این جا، ندا درونی به این فرد می‌گوید که ارزش و شخصیت او بسیار فراتر از آن است که به حالتی زشت و بی‌اهمیت تن دهد، چرا که او تنها مدتی از نور و روشنایی بهره‌مند بوده است."],[149,"غنج و نازت می‌نگنجد در جهان","باش تا که من شوم از تو جهان","جمال و زیبایی تو در دنیا جا نمی‌گیرد؛ باید تا زمانی که من از عشق تو سرشار شوم، در این دنیا بمانی."],[149,"گرم‌دارانت ترا گوری کنند","طعمه ماران و مورانت کنند","اگر گرم‌داران (افرادی که به تو وابسته‌اند) تو را به خاک بسپارند و به طعمه مارها و مورها تبدیل شوی، این دلیلی بر بی‌وفایی یا عدم محبت آن‌هاست."],[149,"بینی از گند تو گیرد آن کسی","کو به پیش تو همی‌مردی بسی","هر کسی که از گندی که از تو برمی‌خیزد، بی‌توجه به تو، بهره‌مند می‌شود و به تلاش و سعی تو در پیشت هیچ اهمیتی نمی‌دهد، آن شخص در واقع به شایستگی و مردانگی تو بی‌اعتنا است."],[149,"پرتو روحست نطق و چشم و گوش","پرتو آتش بود در آب جوش","نطق و گوش و چشم بر اثر روح هستند، مانند اینکه حرارت آتش نیز در آب جوش موجود است."],[149,"آنچنانک پرتو جان بر تنست","پرتو ابدال بر جان منست","همان‌طور که نور جان بدن را روشن می‌کند، نور ابدال (افراد عارف و بزرگ) نیز بر جان من تأثیر دارد و آن را روشن می‌کند."],[149,"جان جان چو واکشد پا را ز جان","جان چنان گردد که بی‌جان تن بدان","زمانی که جان از قید بدن آزاد شود، به مانند پاها از جان جدا می‌شود، و در این حالت، انسان به حالت بی‌جانی و مردن دچار می‌شود."],[149,"سر از آن رو می‌نهم من بر زمین","تا گواه من بود در روز دین","من سرم را بر زمین می‌گذارم تا این زمین در روز قیامت شهادت بدهد که من چه کردم و چه گناهانی مرتکب شدم."],[149,"یوم دین که زلزلت زلزالها","این زمین باشد گواه حالها","در روز قیامت که زمین به شدت لرزان خواهد شد، این زمین خود شاهد حال انسان‌ها خواهد بود."],[149,"گو تحدث جهرة اخبارها","در سخن آید زمین و خاره‌ها","در روز قیامت، زمین به وضوح و آشکارا اخبار و زندگی مردم را بازگو می‌کند و جزئیات آنچه در آن گذشته است را به مردم یادآوری می‌کند."],[149,"فلسفی منکر شود در فکر و ظن","گو برو سر را بر آن دیوار زن","فردی که به فلسفه باور دارد، ممکن است به دلیل افکار و شک‌هایش به انکار بپردازد، پس بهتر است فکر خود را در چارچوب معین و اصولی قرار دهد و از انحراف بپرهیزد."],[149,"نطق آب و نطق خاک و نطق گل","هست محسوس حواس اهل دل","آب، خاک و گل هر یک صدا و سخنی دارند که برای اهل دل و کسانی که احساس و فهم عمیق دارند، قابل درک و احساس است."],[149,"فلسفی کو منکر حنّانه است","از حواس اولیا بیگانه است","فردی که به فلسفه و منطق اهمیت می‌دهد و وجود حنانه (خودآگاهی و عشق الهی) را رد می‌کند، در واقع از ادراک و تجربه‌های اولیا و عرفا دور است."],[149,"گوید او که پرتو سودای خلق","بس خیالات آورد در رای خلق","او (فردی که در حال صحبت است) می‌گوید که نور عشق و شور و شوق دل و روح انسان، باعث می‌شود که افکار و تصورات بی‌پایه‌ای در ذهن مردم شکل بگیرد."],[149,"بلک عکس آن فساد و کفر او","این خیال منکری را زد برو","بلکه برعکس آن فساد و کفر او، همین خیال انکار را بر او وارد ساخت."],[149,"فلسفی مر دیو را منکر شود","در همان دم سخره دیوی بود","فردی که خود را فیلسوف می‌داند، در همان لحظه که منکر دیو می‌شود، به نوعی به دیو تبدیل می‌شود و به او مضحکه می‌کند."],[149,"گر ندیدی دیو را خود را ببین","بی جنون نبود کبودی بر جبین","اگر دیو را ندی و او را نبینی، به جای آن به خودت توجه کن و خودت را ببین. اگر دیوانه نباشی، علامت‌های غم و کراهت (کبودی) بر پیشانی‌ات وجود نخواهد داشت."],[149,"هر که را در دل شک و پیچانیست","در جهان او فلسفی پنهانیست","هر کسی که در دلش شک و تردید وجود دارد، در واقع در دنیا به نوعی تفکر فلسفی و عمیق درگیر است که از نگاه دیگران پنهان است."],[149,"می‌نماید اعتقاد و گاه گاه","آن رگ فلسف کند رویش سیاه","اعتقاد و ایمان گاهی به ظاهر جلوه می‌کند، اما در برخی افراد، رگ فلسفه ممکن است باعث تردید و سیاه شدن روحشان شود."],[149,"الحذر ای مؤمنان کان در شماست","در شما بس عالم بی‌منتهاست","ای مؤمنان، هوشیار باشید، چرا که در شما دانی از معرفت و دانش بی‌پایان وجود دارد."],[149,"جمله هفتاد و دو ملت در توست","وه که روزی آن بر آرد از تو دست","در وجود تو نمایانگر هفتاد و دو ملت (آیین و مذهب مختلف) است و وای بر تو که روزی ممکن است این کثرت و تنوع از تو آشکار شود."],[149,"هر که او را برگ آن ایمان بود","همچو برگ از بیم این لرزان بود","هر کسی که به واسطه ایمانش مورد محبت و توجه قرار گرفته، مانند برگ درخت از ترس این لرزش، می‌لرزد."],[149,"بر بلیس و دیو زان خندیده‌ای","که تو خود را نیک‌مردم دیده‌ای","تو به شیطان و دیوان می‌خندی، حال آنکه خود را انسانی نیکو می‌پنداری."],[149,"چون کند جان بازگونه پوستین","چند وا ویلی بر آید ز اهل دین","وقتی که جان انسان، مانند پوستینی تغییر شکل دهد و از دین خارج شود، در این حالت، او از جمع اهل دین دور می‌شود و به نوعی شبیه به موجودات ناپاک یا ویرانگر می‌گردد."],[149,"بر دکان، هر زرنما خندان شدست","زانک سنگ امتحان پنهان شدست","در دکان، هر کسی که به ظاهر زرنما و خندان است، به این خاطر است که سنگ آزمایش و میزان حقایق پنهان گشته است."],[149,"پرده‌ ای ستار از ما بر مگیر","باش اندر امتحان ما را مجیر","ای پرده‌دار، تو از ما پوشش و ستر و پرده بر مگیر و در آزمایش ما را نرنجان."],[149,"قلب پهلو می‌زند با زر به شب","انتظار روز می‌دارد ذهب","قلب در دلش با زر (طلا) رقابت می‌کند و در شب در انتظار روزی است که طلای خالص (حقیقت) نمایان شود."],[149,"با زبان حال زر گوید که باش","ای مزوّر تا بر آید روز فاش","زر که به نور و زیبایی معروف است، در اینجا به زبان حال می‌گوید که ای شخص فریبکار، کنار برو تا روز حقیقت و واقعیت آشکار شود."],[149,"صد هزاران سال ابلیس لعین","بود ز ابدال و امیر المؤمنین","ابلیس، لعنت شده، با وجود این که سال‌های بسیار طولانی در مقام ولی و پیشوای مؤمنان بود، به خاطر نافرمانی‌اش از خداوند سقوط کرد."],[149,"پنجه زد با آدم از نازی که داشت","گشت رسوا همچو سرگین وقت چاشت","شیطان به خاطر فخر و ناز خود به آدم حمله کرد و به عاقبت بدی مبتلا شد، مانند کثیفی که در زمان صبح خود را نشان می‌دهد و موجب رسوایی می‌شود."],[150,"بلعم باعور را خلق جهان","سغبه شد مانند عیسی زمان","بلعم باعور (پیامبری در قرآن) برای مردم زمانش مانند عیسی (علیه‌السلام) مورد توجه و احترام بود و مردم به او معجزه‌ها و قوت‌ او ایمان آوردند."],[150,"سجده ناوردند کس را دون او","صحّت رنجور بود افسون او","هیچ‌کس جز بلعم باعور نتوانست سجده کند، زیرا توانایی او، در واقع، فرسوده و خراب بود."],[150,"پنجه زد با موسی از کبر و کمال","آنچنان شد که شنیدستی تو حال","بلعم به خاطر تکبر و برتری‌طلبی، با موسی مخالفت کرد و در این وضعیت به گونه‌ای درآمد که شاید تو هم درباره‌اش شنیده‌ای."],[150,"صد هزار ابلیس و بلعم در جهان","همچنین بودست پیدا و نهان","در جهان، افراد زیادی مانند ابلیس و بلعم وجود دارند که ممکن است ظاهرا خوب و نیکوکار به نظر برسند، اما در باطن نقش‌هایی منفی دارند و به جفا و فریب مشغولند."],[150,"این دو را مشهور گردانید اله","تا که باشد این دو بر باقی گواه","خداوند این دو را مشهور و معروف کرد تا برای دیگران نشانه و گواهی بر حقانیت یا باطل بودنشان باشند."],[150,"این دو دزد آویخت از دار بلند","ورنه اندر قهر بس دزدان بدند","این دو دزد را از چوبه دار آویختند، وگرنه در زمان قهر و انتقام، دزدان زیادی وجود داشتند."],[150,"این دو را پرچم به سوی شهر برد","کشتگان قهر را نتوان شمرد","این دو نفر، پرچمی را به سوی شهر بردند، در حالی که تعداد کشته‌شدگان بر اثر قهر و خشم فراوان بود و نمی‌توان آن‌ها را شمرد."],[150,"نازنینی تو ولی در حد خویش","الله الله ، پا منه از حدّ بیش","تو شخصی نازنین و محترمی، اما باید بدانید که این نازنینی محدود به مقام و مرتبه‌ات است. پس از حد و اندازه‌ات فراتر نرو و خود را بزرگ‌تر از آنچه که هستی ندان."],[150,"گر زنی بر نازنین‌تر از خودت","در تگ هفتم زمین زیر آردت","اگر بر کسی زیبا و عزیزتر از خودت محبت کنی و او را زیر پای خودت بیندازی، خود را به زمین می‌زنی."],[150,"قصه عاد و ثمود از بهر چیست؟","تا بدانی کانبیا را نازکیست","قصه قوم عاد و ثمود به چه دلیلی بیان شده است؟ تا بفهمی که انبیا در مقابل سختی‌ها و مشکلات، چه ظرافت و لطافتی دارند."],[150,"این نشان خسف و قذف و صاعقه","شد بیان عزّ نفس ناطقه","این‌ موارد نشانه‌ای از سرنوشت‌های بد مانند زمین‌لرزه، سیل و آتش‌فشان است که بیانگر عظمت روح و نفس ناطقه (عقل) است."],[150,"جمله حیوان را پی انسان بکش","جمله انسان را بکش از بهر هش","تمام حیوانات را به پیوند با انسان دعوت کن و همه انسان‌ها را به خاطر هوش و خردشان از هم جدا کن."],[150,"هش چه باشد، عقل کل هوشمند","هوش جزوی هش بود اما نژند","هش به معنای آگاهی و درک است و به عقل کل اشاره دارد که هوشمند و فراتر از شناخت جزئیات است. اینجا گفته می‌شود که عقل جزئی یا همان هوش محدود می‌تواند نژند و به نوعی ناچیز باشد در مقایسه با عقل کل."],[150,"جمله حیوانات وحشی ز آدمی","باشد از حیوان انسی در کمی","تمام وحشی‌های عالم (حیوانات) از آدمی بیشتر هستند، زیرا انسان‌ها نسبت به حیوانات اهلی (انسی) در کمبود هستند."],[150,"خون آنها خلق را باشد سبیل","زانک وحشی‌اند از عقل جلیل","خون وحوش (وحشی‌ها) برای مردم، مانند آب و زندگی است؛ زیرا آنها از عقل و خرد دور هستند."],[150,"عزت وحشی بدین افتاد پست","که مر انسان را مخالف آمدست","اگرچه وحشی‌ها از نظر ظاهری ممکن است عزت و احترام داشته باشند، اما در واقع به خاطر رفتارهایشان، مانند نادانی و بی‌عقلی، مقام و منزلت واقعی آنها به شدت افت کرده است؛ زیرا این حالات با انسانیت در تضاد است."],[150,"پس چه عزت باشدت ای نادره","چون شدی تو حمر مستنفره","ای نادره (شخصی با ویژگی‌های برجسته یا بی‌نظیر)، حالا که تو به موشکافی وبه تعمق در خود پرداخته‌ای، دیگر چه عزتی می‌تونی داشته باشی وقتی که مثل الاغ وحشی (حمر مستنفره) شده‌ای؟"],[150,"خر نشاید کشت از بهر صلاح","چون شود وحشی، شود خونش مباح","هرگز نمی‌توان خر را به خاطر مصلحتی کشت، زیرا اگر او وحشی شود، خونش مباح خواهد شد و این یعنی اجازه قتل او داده می‌شود."],[150,"گرچه خر را دانش زاجر نبود","هیچ معذورش نمی‌دارد ودود","اگرچه خر (حیوانی بی‌فهم) نسبت به عذاب و عاقبت کارش آگاهی ندارد، اما این ناآگاهی او را از مسئولیت و عذاب رهایی نمی‌بخشد."],[150,"پس چو وحشی شد از آن دم آدمی","کی بود معذور ای یار سمی","آن‌گاه که انسان به حالت وحشی و بی‌قید می‌رسد، دیگر عذری برای او وجود ندارد. ای دوست، این درسی است درباره مسئولیت و کردار انسان‌ها."],[150,"لاجرم کفار را شد خون مباح","همچو وحشی پیش نشاب و رماح","پس از آن، خون کافران به‌راستی مباح شد، مانند وحشیانی که در برابر تیرها و نیزه‌ها می‌جنگند و هیچ ترسی ندارند."],[150,"جفت و فرزندانشان جمله سبیل","زانک بی‌عقلند و مردود و ذلیل","فرزندان و همسران آن‌ها همه در بدبختی و ذلت هستند زیرا بی‌عقل و ناپسند به شمار می‌روند."],[150,"باز عقلی کو رمد از عقل عقل","کرد از عقلی به حیوانات نقل","عقلی که از عقل خود به در می‌رود و از آن تبعیت نمی‌کند، مانند عقلی است که به حالت حیوانی می‌رسد و از درک درست فاصله می‌گیرد."],[151,"همچو هاروت و چو ماروت شهیر","از بطر خوردند زهرآلود تیر","هاروت و ماروت، دو فرشته مشهور، به دلیل غرور و خودبینی دچار خطا شدند و مانند آنها، بزرگانی که به خود و قدرتشان افتخار می‌کنند، از زهر فریب و آزمایشات دنیا آسیب می‌بینند."],[151,"اعتمادی بودشان بر قدس خویش","چیست بر شیر اعتماد گاومیش","اعتماد هاروت و ماروت به پاکی و مقدس بودن خودشان چه سودی دارد، زمانی که اعتماد بر حیوانی چون گاومیش به شیر نر بی‌فایده است."],[151,"گرچه او با شاخ صد چاره کند","شاخ شاخش شیر نر پاره کند","اگرچه او (گاو) با شاخ‌هایش تلاش کند و در برابر مشکلات چاره بیندیشد، اما در نهایت شاخ‌هایش نمی‌توانند او را از خطر نجات دهند، زیرا شیر نر قدرتی دارد که می‌تواند او را نابود کند."],[151,"گر شود پر شاخ همچون خارپشت","شیر خواهد گاو را ناچار کشت","اگر کسی به اندازه خارپشت پرپشت شود، ناگزیر شیر، گاو را خواهد کشت. یعنی در شرایطی که قدرت یا قدرت‌نمایی فرد خیلی زیاد شود، خشونت و آسیب به دیگران محتمل است."],[151,"گرچه صرصر بس درختان می‌کند","با گیاه تر وی احسان می‌کند","هرچند باد تند و طاقت‌فرسا (صرصر) درختان را خراب می‌کند، اما به گیاه تر (نرم و جوان) رحم و لطف می‌کند و به آن آسیب نمی‌زند."],[151,"بر ضعیفی گیاه آن باد تند","رحم کرد ای دل تو از قوت ملند","باد تند به گیاه ضعیف رحم می‌کند، اما تو ای دل، از قدرت ملند (پژوهشگران و دانشمندان نفسی قوی) عبرت بگیر و نپندار که خودت از این قدرت مصون هستی."],[151,"تیشه را ز انبوهی شاخ درخت","کی هراس آید ببرد لخت لخت","تیشه که ابزاری برای بریدن و قطع درختان است، از انبوه شاخ‌های درخت نمی‌ترسد و به راحتی می‌تواند رشته‌های نازک و ضعیف آنها را قطع کند. این بیان نشان‌دهنده شجاعت و عدم ترس در مواجهه با ضعف‌هاست."],[151,"لیک بر برگی نکوبد خویش را","جز که بر نیشی نکوبد نیش را","اما برگ درخت نمی‌تواند خود را بر روی چیزی بکوبد، مگر اینکه بر روی نیشی فرود آید که نیش به خودی خود زهر دارد."],[151,"شعله را ز انبوهی هیزم چه غم","کی رمد قصاب از خیل غنم","شعله‌ی آتش از وجود انبوه چوب‌ها و هیزم‌ها نگرانی ندارد، چرا که قصاب از میان گله‌ی گوسفندها نمی‌تواند فرار کند. به عبارت دیگر، وجود بسیار از چیزها نمی‌تواند مانع از بروز مشکلات و خطرات شود."],[151,"پیش معنی چیست صورت بس زبون","چرخ را معنیش می‌دارد نگون","معنی این بیت این است که محتوای واقعی یک چیز، مثل معنی و مفهوم آن، بسیار مهم‌تر از ظاهری ناقص و زبون آن است. در اینجا اشاره شده که چرخ، که نماد دنیای مادی و فانی است، از نظر شکل ظاهری به تنهایی ارزشی ندارد و تنها معنای عمیق آن می‌تواند آن را بسازد."],[151,"تو قیاس از چرخ دولابی بگیر","گردشش از کیست از عقل مشیر","از چرخ دولابی (چرخ دنیا) مثل بگیر و در نظر بگیر که گردشش به دست چه کسی است؛ این کار به عقل و درایت نیاز دارد."],[151,"گردش این قالب همچون سپر","هست از روح مستر ای پسر","گردش این جسم مانند سپر (که دوران می‌کند) به خاطر روح است، ای پسر."],[151,"گردش این باد از معنی اوست","همچو چرخی کان اسیر آب جوست","حرکت این باد به خاطر معنای اوست، مانند چرخشی که به دلیل اسارت در آب جوی اتفاق می‌افتد."],[151,"جر و مد و دخل و خرج این نفس","از کی باشد جز ز جان پر هوس","این نفس (نفس انسانی) که درگیر کشمکش‌ها، دستاوردها و هزینه‌ها است، از کجا می‌آید جز از وجودی پر از آرزوها و خواسته‌های بی‌پایان؟"],[151,"گاه جیمش می‌کند گه حا و دال","گاه صلحش می‌کند گاهی جدال","این نفس گاهی انسان را به سوی خوبی‌ها و صلح و آرامش می‌برد و گاهی به سوی جنگ و خصومت و درگیری می‌کشاند."],[151,"گه یمینش می‌برد گاهی یسار","که گلستانش کند گاهیش خار","گاهی این باد او را به سمت راست (یمین) می‌برد و گاهی به سمت چپ (یسار)، تا در برخی اوقات، او را به گلستان برساند و در سایر زمان‌ها، او را به سرنوشتی بد و خاری دچار کند."],[151,"همچنین این باد را یزدان ما","کرده بد بر عاد همچون اژدها","خداوند این باد را بر قوم عاد، که به خاطر ظلم و طغیانی که داشتند، مانند اژدهایی خطرناک و بد کرده است."],[151,"باز هم آن باد را بر مؤمنان","کرده بد صلح و مراعات و امان","این باد در واقع بر مؤمنان نیز بدی کرده و باعث ناامنی و بی‌اعتمادی شده است، به طوری که دیگر خبری از صلح و سازش و امنیت نیست."],[151,"گفت المعنی هوالله شیخ دین","بحر معنیهای رب العالمین","شیخ دین، که به عنوان یک عالم دینی شناخته می‌شود، گفت که «معنی» همان خداوند است و او همچون دریا، معانی و مفاهیم الهی را در خود جای داده است."],[151,"جمله اطباق زمین و آسمان","همچو خاشاکی در آن بحر روان","تمام اجزای زمین و آسمان مانند خاشاکی در میان آن دریای بزرگ در حال حرکت هستند."],[151,"حمله‌ها و رقص خاشاک اندر آب","هم ز آب آمد به وقت اضطراب","حرکت‌ها و رقص خاشاک در آب در زمان اضطراب و هیجان به خاطر وجود آب و طبیعت آن است. به این معنی که همه چیز تحت تأثیر شرایط و اوضاع محیط قرار می‌گیرد."],[151,"چونک ساکن خواهدش کرد از مرا","سوی ساحل افکند خاشاک را","وقتی که او (آب) بخواهد کسی را آرام کند، خاشاک را به سوی ساحل می‌افکند."],[151,"چون کشد از ساحلش در موج‌گاه","آن کند با او که آتش با گیاه","اگر چیزی نخست در ساحل آرام قرار داشته باشد و سپس در دریا دچار طوفان و موج شود، آنجا به سرنوشت گیاهی می‌افتد که در آتش قرار گرفته است و می‌سوزد."],[151,"این حدیث آخر ندارد باز ران","جانب هاروت و ماروت ای جوان","این داستان پایانی ندارد و همواره بر اساس داستان هاروت و ماروت ادامه دارد، ای جوان."],[152,"چون گناه و فسق خلقان جهان","می‌شدی بر هر دو روشن آن زمان","چون گناه و فساد، بر مردم جهان ظاهر می‌شد، در آن زمان این دو (هاروت و ماروت) به آن گناهان آگاه و روشن بودند."],[152,"دست خاییدن گرفتندی ز خشم","لیک عیب خود ندیدندی به چشم","از روی خشم، دست به کار زدن و ظلم کردن را آغاز کردند، اما عیب خود را نمی‌دیدند و متوجه آن نبودند."],[152,"خویش در آیینه دید آن زشت مرد","رو بگردانید از آن و خشم کرد","مرد زشت وقتی خود را در آینه دید، به خاطر زشتی‌اش رویش را برگرداند و از آنچه که دید خشمگین شد."],[152,"خویش‌بین چون از کسی جرمی بدید","آتشی در وی ز دوزخ شد پدید","کسی که خود را در آینه می‌بیند و گناه یا عیب دیگری را می‌بیند، احساس خشم و غضبش بیدار می‌شود و در درونش آتش عذاب دوزخ شعله‌ور می‌شود."],[152,"حمیت دین خواند او آن کبر را","ننگرد در خویش نفس گبر را","مولانا می‌گوید که شخصی که خود را دین‌دار می‌داند، نباید به کبر و خودخواهی خود توجه کند و به جای آن، باید به نقص‌های درونی خود (نفس گبر) نگاه کند. در واقع، او باید به بسیاری از زشتی‌های خود بیندیشد و از خودپرستی دور شود."],[152,"حمیت دین را نشانی دیگرست","که از آن آتش جهانی اخضرست","حمیت دین، یعنی غیرت و تعصب دینی، نشانه دیگری دارد که آن، آتش سبز جهانی است. این تعبیر به نوعی خطر و تهدیدی را که به خاطر تعصب دینی ممکن است به وجود آید، اشاره می‌کند."],[152,"گفت حقشان گر شما روشن گرید","در سیه‌کاران مغفل منگرید","خداوند می‌گوید اگر شما در کارهای نیک و روشنی‌بخش خود تلاش کنید، به کسانی که در حال گمراهی و نادانی هستند توجه نکنید."],[152,"شکر گویید ای سپاه و چاکران","رسته‌اید از شهوت و از چاک‌ران","از شهوت و وسوسه‌های نفس رستیدید و از بندگی آن آزاد شدید، پس از این آزادی شکرگزار باشید ای جماعت و خدمتگزاران."],[152,"گر از آن معنی نهم من بر شما","مر شما را بیش نپذیرد سما","اگر من از آن معنایی که دارم بر شما بگویم، شما را بیشتر از این نمی‌پذیرد آسمان (یا مقام شما)."],[152,"عصمتی که مر شما را در تنست","آن ز عکس عصمت و حفظ منست","عصمت و پاکی که شما در وجود خود دارید، به خاطر انعکاس و تأثیر عصمت و حفاظت من است."],[152,"آن ز من بینید نه از خود هین و هین","تا نچربد بر شما دیو لعین","این بیت بر این نکته تأکید دارد که آنچه شما در خود می‌بینید و تجربه می‌کنید، از منبعی فراتر از خودتان ناشی می‌شود. بنابراین، مراقب باشید و فریب نخورید، تا دیو شیاطین به شما چیره نشود و شما را منحرف نکند."],[152,"آنچنان که کاتب وحی رسول","دید حکمت در خود و نور اصول","کاتب وحی، که پیامبر را می‌بیند، در خود حکمت و روشنی اصول دین را مشاهده می‌کند."],[152,"خویش را هم صوت مرغان خدا","می‌شمرد آن بد صفیری چون صدا","این فرد که به صفیری بد صدا اشاره دارد، خود را به‌عنوان یکی از پرندگان الهی می‌داند و صدا و نغمه‌اش را مقدس می‌شمارد، در حالی که صدایش ناپسند و زشت است."],[152,"لحن مرغان را اگر واصف شوی","بر مراد مرغ کی واقف شوی","اگر تو توانایی توصیف صداهای پرندگان را داشته باشی، باز هم نمی‌توانی به ذات و اهداف واقعی آنها پی ببری."],[152,"گر بیاموزی صفیر بلبلی","تو چه دانی کو چه دارد با گلی","اگر صفیر و آواز بلبل را یاد بگیری، نمی‌دانی که او چه ارتباطی با گل دارد و چه احساساتی را منتقل می‌کند."],[152,"ور بدانی باشد آن هم از گمان","چون ز لب‌جنبان گمانهای کران","اگر چیزی را از روی حدس و گمان بفهمی، هیچ‌وقت آن را به‌طور قطع نخواهی شناخت، مانند سوت زدن بلبل که تنها باعث شک و گمان‌های بی‌پایه می‌شود."],[153,"آن کری را گفت افزون مایه‌ای","که ترا رنجور شد همسایه‌ای","کر به جوانی می‌گوید که تو باید برای همسایه‌ات که بیمار شده، چیزی بیشتر از این که از گنجینه‌ات می‌دانی، به او برسانی."],[153,"گفت با خود کر که با گوش گران","من چه دریابم ز گفت آن جوان","کر به خود می‌گوید، با این که شنوایی‌ام ضعیف است و گوش سنگینی دارم، چگونه می‌توانم از صحبت آن جوان چیزی بفهمم؟"],[153,"خاصه رنجور و ضعیف آواز شد","لیک باید رفت آنجا نیست بد","اگرچه رنجور و ضعیف صدا دارد، اما باید به عیادت او رفت، زیرا رفتن به نزد بیمار واجب است."],[153,"چون ببینم کان لبش جنبان شود","من قیاسی گیرم آن را از خرد","زمانی که می‌بینم لب او حرکت می‌کند و سخن می‌گوید، از عقل و درک خود نتیجه‌گیری می‌کنم که چه احساسی دارد یا چه حالتی را تجربه می‌کند."],[153,"چون بگویم، چونی ای محنت‌ کشم؟","او بخواهد گفت نیکم یا خوشم","وقتی من از او بپرسم حالش چگونه است، او جواب خواهد داد که یا حالش خوب است یا خوش می‌گذراند."],[153,"من بگویم شکر، چه خوردی ابا","او بگوید \"شربتی\" یا \"ماش با\"","اگر من بگویم که شکر (شکر بی‌نصیب) چیست، او (همان کسی که درباره‌اش صحبت می‌کنیم) می‌گوید: \"یک شربت نوشیدم\" یا \"ماش (نوعی دانه خوراکی) خوردم\"."],[153,"من بگویم صحّه‌نوشت کیست آن","از طبیبان پیش تو؟ گوید فلان","من از او می‌پرسم که آن پزشک و طبیبی که تو را معاینه کرده، کیست؟ او پاسخ می‌دهد که فلانی است."],[153,"من بگویم بس مبارک‌‌پاست او","چونک او آمد شود کارت نکو","من می‌گویم که او بسیار خوشبخت است، زیرا زمانی که او وارد می‌شود، کار تو به خوبی انجام می‌شود."],[153,"پای او را آزمودستیم ما","هر کجا شد می‌شود حاجت روا","ما پای او را آزمایش کرده‌ایم و هر جا که او باشد، نیازها برآورده می‌شود."],[153,"این جوابات قیاسی راست کرد","پیش آن رنجور شد آن نیک‌مرد","این پاسخ‌های منطقی و سنجیده‌ای که آن مرد نیکوکار به رنجور داد، او را به حالت بهتری رساند."],[153,"گفت چونی؟ گفت مردم، گفت شکر","شد ازین رنجور پر آزار و نکر","رنجور از حالش می‌گوید که مرده‌ام، و او پاسخ می‌دهد که بابت این آزار و درد تو، شکرگزاری می‌کنم."],[153,"کین چه شکر است، این عدوی ما بدست","کر قیاسی کرد و، آن کژ آمدست","اینکه می‌گوید شکر به چه معناست، زیرا درد و رنج ما از این همسایه کر (چرا که همسایه‌ای که نمی‌شنود و نمی‌فهمد) به دست آمده است، قیاس نادرستی است و نتیجه اشتباهی به بار آورده است."],[153,"بعد از آن گفتش چه خوردی؟ گفت زهر","گفت نوشت باد! افزون گشت قهر","پس از آن پرسیدند چه خوردی؟ او پاسخ داد زهر خورده‌ام. سپس نوشتند که باد هم آمده و قهرش (خشمش) افزایش یافته است."],[153,"بعد از آن گفت از طبیبان کیست او","کاو همی‌ آید به چاره پیش تو؟","سپس گفت: از میان پزشکان، چه کسی است که به کمک تو می‌آید و برای درمان تو می‌رسد؟"],[153,"گفت عزرائیل می‌آید برو","گفت پایش بس مبارک، شاد شو","کر به رنجور خود می‌گوید که عزرائیل، فرشته مرگ، می‌آید. او از این موضوع خوشحال می‌شود و می‌گوید خوشا به حال او که پایش برای دیدن فرشته مرگ برکت دارد، پس باید شاد باشد."],[153,"کر برون آمد بگفت او شادمان","شکر کش کردم مراعات این زمان","کر از خانه خارج شد و گفت که شادمان هستم و برای بلای حاضر شکرگزاری کردم."],[153,"گفت رنجور این عدوی جان ماست","ما ندانستیم کاو کان جفاست","رنجور می‌گوید که این شخص دشمن جان ماست، اما ما این را نمی‌دانستیم و در واقع او با ما بد کرد."],[153,"خاطر رنجور جویان شد سقط","تا که پیغامش کند از هر نمط","دل رنجور و بیمار به خاطر مشکلاتش از بین رفت و ناپایدار شد، تا اینکه پیغامش را از هر نوعی برساند و احساساتش را بیان کند."],[153,"چون کسی که خورده باشد آش بد","می‌بشوراند دلش تا قی کند","کسی که چیزی را به او نمی‌چسبد و دلش پریشان است، مانند آدمی است که غذای ناسالمی خورده و به خاطر آن دچار ناراحتی می‌شود. دلش به حالت تنگی و ناراحتی درمی‌آید تا بالاخره آن را بیرون بریزد."],[153,"کظم غیظ اینست آن را قی مکن","تا بیابی در جزا شیرین سخن","خودداری از خشم و عصبانیت نشان دادن، سبب می‌شود که در آینده پاداشی خوب و دلپذیر نصیبت شود."],[153,"چون نبودش صبر، می‌پیچید او","کین سگ زن‌روسپی حیز کو","چون او صبر نداشت، در خود می‌پیچید و کینه می‌ورزید، مانند سگی که متعلق به زنی طماع و فاسد است."],[153,"تا بریزم بر وی آنچه گفته بود","کان زمان شیر ضمیرم خفته بود","من می‌خواهم آنچه را در آن زمان به او گفته بودم را بر سرش بریزم، زیرا آن زمان هنوز غافل و بی‌خبر بودم."],[153,"چون عیادت بهر دل‌آرامیست","این عیادت نیست، دشمن کامیست","عیادت کردن به منظور آرامش قلب است، اما این نوع عیادت، عیادت نیست و نشان‌دهنده‌ی تأسیس دوستی‌های نامناسب و کامیابی دشمنی است."],[153,"تا ببیند دشمن خود را نزار","تا بگیرد خاطر زشتش قرار","کسی که دشمنش رنجور و بیمار است، می‌خواهد او را ببیند تا از نگرانی و احساس بدی که نسبت به او دارد، آسوده خاطر شود."],[153,"بس کسان، کایشان ز طاعت که رهند","دل به رضوان و ثواب آن دهند","بسیاری از افرادی که به پرهیزکاری و عبادت مشغولند، دلشان را به بهشت و پاداش آن گره زده‌اند و از این راه به سوی آن می‌روند."],[153,"خود حقیقت، معصیت باشد خفی","بس کدر، کان را تو پنداری صفی","حقیقت این است که خلافکار واقعی در باطن خود، گاهی به شکل پنهانی و نادیده، وجود دارد و ممکن است آنچه را که انسان در ظاهر خوب می‌بیند، در واقع ناپاک و فاسد باشد."],[153,"همچو آن کر، کو همی پنداشتست","کو نکویی کرد و آن بر عکس جست","شخصی مانند آن کر است که فکر می‌کند کار نیک انجام داده، در حالی که حقیقتا کارش به عکس بوده است."],[153,"او نشسته خوش که خدمت کرده‌ام","حق همسایه بجا آورده‌ام","او با خیالی خوش نشسته است که خدمت کرده و حقوق همسایه‌اش را به جا آورده است."],[153,"بهر خود او آتشی افروخته‌ست","در دل رنجور و، خود را سوخته‌ست","او با رفتارهای ناپسندش، آتش درد و رنجی را در دل همسایه بیمار برافروخته و در واقع خودش نیز از این کار آسیب دیده است."],[153,"فاتقوا النار التی اوقدتم","انکم فی المعصیه ازددتم","بترسید از آتش دوزخ که خود برای خود روشن کرده‌اید، زیرا در نافرمانی و گناه، به عذاب خود افزوده‌اید."],[153,"گفت پیغامبر به یک صاحب‌ریا","صل انک لم تصل یا فتی","پیامبر به مرد ریاکار گفت: «نماز بخوان، اما بدان که تو به حقیقت به خدا وصل نشده‌ای، ای جوان»."],[153,"از برای چاره این خوف‌ها","آمد اندر هر نمازی اهدنا","برای رفع ترس‌ها و نگرانی‌ها، در هر نمازی از خدا می‌خواهیم که ما را به راه درست هدایت کند."],[153,"کین نمازم را میامیز ای خدا","با نماز ضالین و اهل ریا","خدایا، نماز مرا با نماز کسانی که گمراهند و اهل ریا و نفاق که فقط ظاهر را حفظ می‌کنند، درآمیز نکن."],[153,"از قیاسی که بکرد آن کر گزین","صحبت ده‌ ساله باطل شد بدین","نتیجه‌گیری از قیاس نادرستی که آن کر انجام داد، این است که انتخاب دوستی برای صحبت، حتی اگر از چندین سال باشد، باطل و بی‌فایده می‌شود."],[153,"خاصه، ای خواجه قیاس حس دون","اندر آن وحیی که شد از حد فزون","ای خواجه، تو نباید حس پایین‌مرتبه‌ات را با آن وحی برتر که از حد فراتر رفته قیاس کنی."],[153,"گوش حس تو، به حرف ار در خور است؟","دان، که گوش غیب‌گیر تو، کر است","اگر گوش حس تو توانایی درک این سخن را دارد، بدان که گوش باطنی تو که باید معنای حقیقت را بشنود، ناتوان است."],[154,"اول آن کس کین قیاسکها نمود","پیش انوار خدا ابلیس بود","نخستین کسی که این قیاس‌ها را (برتری خاک بر آتش) مطرح کرد و در مقابل نورهای الهی قرار گرفت، ابلیس بود."],[154,"گفت نار از خاک بی شک بهترست","من ز نار و او ز خاک اکدرست","ابلیس می‌گوید که آتش (نار) از خاک بهتر است و او به این دلیل خودش را از آتش برتر می‌داند و می‌گوید که من از آتش ساخته شده‌ام و او (آدم) از خاک است، پس برتری از آن من است."],[154,"پس قیاس فرع بر اصلش کنیم","او ز ظلمت ما ز نور روشنیم","پس قیاس را به پایه و اصلش برمی‌گردانیم؛ او (ابلیس) در تاریکی است و ما در نور و روشنایی قرار داریم."],[154,"گفت حق نه بلک لا انساب شد","زهد و تقوی فضل را محراب شد","خداوند فرمود که اصل و اساس در دین و راه صحیح، نسب و خانواده نیست، بلکه زهد و تقوا مهم است؛ بدین معنا که عبادت و فضیلت، مکان و مقام حقیقی خود را پیدا می‌کند."],[154,"این نه میراث جهان فانی است","که به انسابش بیابی جانی است","این چیزی که به عنوان میراث از دنیا و زندگی مادی می‌شناسید، تنها متعلق به این جهان فانی نیست؛ بلکه باید از طریق نسبت‌ها و خویشاوندی‌ها، روح و جان را بیابید."],[154,"بلک این میراثهای انبیاست","وارث این جانهای اتقیاست","این میراث‌ها از انبیا (پیشوایان دینی) است و وارثان این جان‌ها نیز کسانی هستند که به تقوا و پرهیزگاری مشغولند."],[154,"پور آن بوجهل شد مؤمن عیان","پور آن نوح نبی از گمرهان","پسر ابوجهل، مؤمن آشکاری شد، و پسر نوح نبی از گمراهان گردید."],[154,"زاده خاکی منور شد چو ماه","زاده آتش توی رو روسیاه","فرزند خاکی، مانند ماه تابناک و درخشان شد، اما فرزند آتش (ابلیس) به صورت سیاه و زشت ظاهر گردید."],[154,"این قیاسات و تحری روز ابر","یا بشب مر قبله را کردست حبر","این قیاس‌ها و استدلال‌ها مانند ابری هستند که باعث می‌شوند انسان از حقیقت دور شود و قبله (هدف واقعی) را که باید در شب به آن توجه کند، به فراموشی بسپارد."],[154,"لیک با خورشید و کعبه پیش رو","این قیاس و این تحری را مجو","اما در حضور خورشید و کعبه، که نشانه‌های روشن الهی هستند، این قیاس و این تحلیلات بی‌فایده است و نباید به آن‌ها توجه کرد."],[154,"کعبه نادیده مکن رو زو متاب","از قیاس الله اعلم بالصواب","به کعبه (مکانی مقدس در اسلام) به عنوان یک نشانه مهم توجه کن و از قیاس‌های بی‌اساس دوری کن؛ زیرا تنها خداوند به درستی‌ها و بهترین‌ها آگاه است."],[154,"چون صفیری بشنوی از مرغ حق","ظاهرش را یاد گیری چون سبق","زمانی که صدای شگفت‌انگیز حق را از پرنده‌اش بشنوی، باید از ظاهر آن صدای زیبا درس بگیری، همان‌طور که در مسابقه‌های دو (سبق) یاد می‌گیری."],[154,"وانگهی از خود قیاساتی کنی","مر خیال محض را ذاتی کنی","سپس به خودت قیاس‌ها و استدلال‌هایی می‌کنی که در واقع خیال محض است و به ذات و حقیقت چیزی تبدیل نمی‌شود."],[154,"اصطلاحاتیست مر ابدال را","که نباشد زان خبر اقوال را","اصطلاحات و واژه‌هایی وجود دارد که خاص ابدال (افرادی که به مقام بالایی رسیده‌اند) است و هیچ خبری از اقوال و گفته‌های دیگران در آن وجود ندارد."],[154,"منطق الطیری به صوت آموختی","صد قیاس و صد هوس افروختی","تو با آواز منطق الطیر (پرندگان) آشنا شدی و به این وسیله فهمیدنی‌ها و خواسته‌های زیادی در دل‌ها برانگیختی."],[154,"همچو آن رنجور دلها از تو خست","کر بپندار اصابت گشته مست","به مانند آن فرد رنجوری که دلش از تو خسته است، این احساس را در نظر بگیر که به سبب تو، فردی به شدت مدهوش و مست شده است."],[154,"کاتب آن وحی زان آواز مرغ","برده ظنی کو بود همباز مرغ","کسی که آن وحی را نوشت (مثلا پیامبر یا فرستاده الهی)، صدای مرغ را شنیده است؛ اما او هم در این مورد تنها یک حدس دارد و نمی‌داند که آن مرغ چه کسی بوده است."],[154,"مرغ پری زد مرورا کور کرد","نک فرو بردش به قعر مرگ و درد","مرغی که به تشبیه پری است، با زیبایی و فریبندگی‌اش توانست مرد را کور کند و او را در عمق مرگ و درد غرق کرد."],[154,"هین به عکسی یا به ظنی هم شما","در میفتید از مقامات سما","هشدار که شما نیز ممکن است به خاطر یک تصویر یا گمان، به مقام‌ها و مراحل بالای معنوی بشتابید و در آنجا به اشتباه بیفتید."],[154,"گرچه هاروتید و ماروت و فزون","از همه بر بام نحن الصافون","هرچند هاروت و ماروت (دو فرشته آزمون) و حتی بیشتر از آنها، در بالای این مقام (مقامی بلند) در صف ایستاده‌اند و آماده ارزیابی هستند."],[154,"بر بدیهای بدان رحمت کنید","بر منی و خویش‌بین لعنت کنید","با بدی‌ها و ناپاکی‌های دیگران رحم و مرا که خودپسند و خودبین هستم، نفرین کنید."],[154,"هین مبادا غیرت آید از کمین","سرنگون افتید در قعر زمین","مراقب باشید که غیرت شما از پس کمین آسیب نبیند و باعث نشود که به قعر زمین بیفتید و سقوط کنید."],[154,"هر دو گفتند ای خدا فرمان تراست","بی امان تو امانی خود کجاست","هر دو (مقصود، دو شخص یا موجود) می‌گویند، ای خدا، فرمان تو را می‌پذیریم، ولی در عین حال، بی‌وقفه می‌پرسند که امان ما کجاست، و این به گونه‌ای به شک و تردید اشاره دارد."],[154,"این همی گفتند و دلشان می‌طپید","بد کجا آید ز ما نعم العبید","آن‌ها (دو فرشته) در حال گفت‌وگو بودند و در دلشان نگرانی داشتند که بدی از ما ظهور کند، زیرا ما بندگان نیکو هستیم."],[154,"خار خار دو فرشته هم نهشت","تا که تخم خویش‌بینی را نکشت","دو فرشته که نماد پاکی و دیانت هستند، با هم نشسته‌اند و در حال گفتگو هستند تا تخم خودبینی و خودپسندی را از میان ببرند و این موضوع را ریشه‌کن کنند."],[154,"پس همی گفتند کای ارکانیان","بی خبر از پاکی روحانیان","آن‌ها گفتند: ای افرادی که از حالت روحانی پاکان بی‌خبر هستید،"],[154,"ما برین گردون تتقها می‌تنیم","بر زمین آییم و شادروان زنیم","ما بر این گردونه (زندگی دنیوی) تلاش و زحمت می‌کشیم و وقتی به زمین می‌آییم، شادی و خوشی را تجربه می‌کنیم."],[154,"عدل توزیم و عبادت آوریم","باز هر شب سوی گردون بر پریم","ما در دنیای مادی به طور شبانه به سمت آسمان می‌رویم و در عین حال، عدالت را برپا می‌داریم و عبادت می‌کنیم."],[154,"تا شویم اعجوبه دور زمان","تا نهیم اندر زمین امن و امان","برای اینکه ما تبدیل به موجودی شگفت‌انگیز در این دوران شویم، باید به نوعی در زمین به آرامش و امنیت دست یابیم."],[154,"آن قیاس حال گردون بر زمین","راست ناید فرق دارد در کمین","قیاس و مقایسه حال آسمان با زمین صحیح نیست، زیرا وضعیت‌ها و ویژگی‌های این دو عالم با یکدیگر متفاوت است و نمی‌توان آنها را یکسان دانست."],[155,"بشنو الفاظ حکیم پرده‌ای","سر همانجا نه که باده خورده‌ای","از سخنان حکیمانه و عمیق بهره‌مند شو و خود را درگیر ظاهر فریبنده نکن؛ همان‌گونه که در مستی باده، آدمی ممکن است از حقیقت دور شود."],[155,"چونک از میخانه مستی ضال شد","تسخر و بازیچه اطفال شد","وقتی‌که شخصی مست از میخانه دور شود، مایه تمسخر و بازیچه کودکان کوی و برزن می‌شود."],[155,"می‌فتد او سو به سو بر هر رهی","در گل و می‌خنددش هر ابلهی","مست شراب به خاطر حالت و نشئگی‌اش به هر سمتی می‌رود و در بین راه به هر احمق و نادانی می‌خندد."],[155,"او چنین و کودکان اندر پیش","بی‌خبر از مستی و ذوق میش","او (مستمند) این‌گونه است که کودکان در برابر او، از حال و شادی‌اش بی‌خبر و بی‌توجه هستند."],[155,"خلق اطفالند جز مست خدا","نیست بالغ جز رهیده از هوا","در واقع، مردم مانند کودکان هستند و جز عشق و مستی خدا چیزی دیگری نمی‌فهمند. کسانی که بالغ شده‌اند، کسانی هستند که از خواسته‌ها و تمایلات دنیوی رها شده‌اند."],[155,"گفت دنیا لعب و لهوست و شما","کودکیت و راست فرماید خدا","دنیا بازی و سرگرمی است و شما در حقیقت کودکی هستید که خداوند به درستی این سخن را می‌گوید."],[155,"از لعب بیرون نرفتی کودکی","بی ذکات روح کی باشد ذکی","اگر از بازی و سرگرمی‌ها خارج نشوی، همیشه چون کودکی خواهی ماند و کسی که بدون تذکر و یادآوری روحش روحی فرزانه و دانا نمی‌شود."],[155,"چون جماع طفل دان این شهوتی","که همی رانند اینجا ای فتی","به خاطر داشته باش که این اشتیاق و شهوت کودکانه، سرشتی مانند جست‌وجوهای آشفته و بی‌هدف دارد که در حال حاضر تو را به سمت هوای نفس سوق می‌دهد."],[155,"آن جماع طفل چه بود بازیی","با جماع رستمی و غازیی","نزدیک شدن و درآمیختن کودکان، مانند بازی است که در مقایسه با نزدیک شدن رستم و غازی‌ها، بی‌اهمیت و بازیچه به نظر می‌رسد."],[155,"جنگ خلقان همچو جنگ کودکان","جمله بی‌معنی و بی‌مغز و مهان","جنگ و دعواهای مردم شبیه جنگ‌های بچه‌هاست، که بی‌معنی، بی‌مغز و بی‌هدف هستند."],[155,"جمله با شمشیر چوبین جنگشان","جمله در لا ینفعی آهنگشان","این مردم با شمشیرهای چوبی به جنگ مشغول‌اند، و جنگ آنها هیچ فایده‌ای ندارد و صدایشان هم بی‌معنی است."],[155,"جمله شان گشته سواره بر نیی","کین براق ماست یا دلدل‌پیی","همه آن‌ها بر اسب‌هایی سوار شده‌اند که این اسب‌ها یا تندرویی هستند که ما می‌شناسیم یا همانی هستند که به سادگی نمی‌توان بر آن‌ها سوار شد."],[155,"حاملند و خود ز جهل افراشته","راکب و محمول ره پنداشته","این بیت می‌گوید افرادی که نادان هستند، خود را بر نشانه‌های علم و دانایی سوار می‌کنند و تصور می‌کنند که آگاه و صاحب‌نظرند، در حالی که در حقیقت همچنان در جهل به سر می‌برند."],[155,"باش تا روزی که محمولان حق","اسپ‌تازان بگذرند از نه طبق","تا روزی صبر کن که حاملان حق، مانند اسب‌تازان از نه طبقه گذر خواهند کرد."],[155,"تعرج الروح الیه و الملک","من عروج الروح یهتز الفلک","روح به سوی او (خدا) عروج می‌کند و فرشتگان به عروج روح، آسمان را به لرزه درمی‌آورند."],[155,"همچو طفلان جمله‌تان دامن‌سوار","گوشه دامن گرفته اسپ‌وار","شما مانند کودکانی هستید که دامن خود را گرفته‌اید و همچون اسب‌ها در گوشه‌ای ایستاده‌اید. این تصویر نشان‌دهنده حالتی از وابستگی و عدم توانایی در حرکت است."],[155,"از حق ان الظن لا یغنی رسید","مرکب ظن بر فلکها کی دوید","ظن و گمان نمی‌تواند انسان را به حقیقت برساند؛ زیرا مانند مرکبی است که هرگز نمی‌تواند به آسمان‌ها پرواز کند."],[155,"اغلب الظنین فی ترجیح ذا","لا تماری الشمس فی توضیحها","اغلب مردم در مورد این که کدام چیز باارزش‌تر است، دچار شک و تردید هستند، ولی در مورد روشنی خورشید هیچ شکی وجود ندارد و وضوح آن در درک همگی یکسان است."],[155,"آنگهی بینید مرکبهای خویش","مرکبی سازیده‌ایت از پای خویش","شما باید به این نکته توجه کنید که افکار و احساسات شما همچون مرکب‌هایی هستند که خودتان ساخته‌اید و به آن‌ها وابسته‌اید. این مرکب‌ها از خود شما نشأت می‌گیرند و شما را به سوی مسیرهای مختلف می‌برند."],[155,"وهم و فکر و حس و ادراک شما","همچو نی دان مرکب کودک هلا","وهم و فکر و حس و ادراک شما مانند نی (بند یا ابزار موسیقی) است که برای کودکانی بی‌تجربه ساخته می‌شود، و این ابزار تنها بازیچه‌ای است و ارزش واقعی ندارد."],[155,"علمهای اهل دل حمالشان","علمهای اهل تن احمالشان","علم‌های مربوط به اهل دل، همچون بارهای سنگینی هستند که برای نقل و انتقال نیاز به مراقبت و احتیاط دارند، در حالی که علم‌های مربوط به اهل جسم، بار غیرضروری و سنگین هستند."],[155,"علم چون بر دل زند یاری شود","علم چون بر تن زند باری شود","علمی که بر دل وارد شود، به آن کمک و یاری می‌رساند و انسان را به روشنی و بصیرت می‌رساند، اما علمی که فقط در سطح ظاهری و بدنی بماند، مانند بار سنگینی است که بر دوش انسان می‌آید و او را می‌آزارد."],[155,"گفت ایزد یحمل اسفاره","بار باشد علم کان نبود ز هو","خداوند می‌فرماید که علم بار (سنگینی) دارد، اما اگر این علم از وحی الهی نباشد، پایدار نمی‌ماند."],[155,"علم کان نبود ز هو بی واسطه","آن نپاید همچو رنگ ماشطه","علمی که به واسطه خدا نیست، همچون رنگ آرایشگری که پاک شود، پایدار نخواهد بود. این بدان معناست که اگر علم به صورت مستقیم از خدا نیاید، دوام نخواهد داشت و به راحتی از بین می‌رود."],[155,"لیک چون این بار را نیکو کشی","بار بر گیرند و بخشندت خوشی","اگر این بار علم را به درستی و با توجه به اصولش حمل کنی، دیگران آن را از تو می‌پذیرند و در عوض، خوشی و شادی را به تو می‌دهند."],[155,"هین مکش بهر هوا آن بار علم","تا ببینی در درون انبار علم","مراقب باش که به خاطر تمایلات نفسانی خود، بار علم را نخور و به دوش خود نگذار؛ زیرا در این صورت نمی‌توانی حقیقت و مضمون عمیق دانش را در درون خود مشاهده کنی."],[155,"تا که بر رهوار علم آیی سوار","بعد از آن افتد ترا از دوش بار","تا زمانی که بر چهارپایه علم سوار نشوی و به جایی نرسی، بار سنگین مسؤولیت‌های علمی بر دوشت خواهد بود."],[155,"از هواها کی رهی بی جام هو","ای ز هو قانع شده با نام هو","اگر از خواسته‌ها و تمایلات خود رها شوی، نمی‌توانی به حقیقت معنوی دست یابی. تو که با نام خدا قانع شده‌ای، نباید به حالت ظاهری و ناپایدار دل خوش کنی."],[155,"از صفت وز نام چه زاید خیال","و آن خیالش هست دلال وصال","از ویژگی‌ها و نام‌ها تنها خیال به وجود می‌آید و این خیال خود واسطه‌ای است برای رسیدن به وصال و اتصال به معشوق."],[155,"دیده‌ای دلال بی مدلول هیچ","تا نباشد جاده نبود غول هیچ","هیچ راهی برای درک واقعی کلمات و معانی وجود ندارد، مگر اینکه خود آن معنا و حقیقت در دسترس باشد. در حقیقت، اگر چیزی وجود نداشته باشد، برای ما به عنوان یک راهنما و دلالتی از آن نمی‌توانیم استفاده کنیم."],[155,"هیچ نامی بی حقیقت دیده‌ای","یا ز گاف و لام گل، گل چیده‌ای","هیچ نامی بدون حقیقت و واقعیت وجود ندارد؛ آیا تو از گل که نامش را می‌شنوی، به حقیقت آن توجه کرده‌ای یا فقط از ظاهر آن خوش‌ات آمده و گل چیده‌ای؟"],[155,"اسم خواندی رو مسمی را بجو","مه به بالا دان نه اندر آب جو","اسم را دیدی و خواندی، اکنون برو و صاحب اسم را بیاب؛ ماه در آب جوی نیست (تو عکس آن را دیده‌ای) ماه در بالاست."],[155,"گر ز نام و حرف خواهی بگذری","پاک کن خود را ز خود هین یکسری","اگر می‌خواهی از اسم و حرف و صوت بگذری، خود را از «خویشتن» و «خود» یکسره پاک‌کن‌."],[155,"همچو آهن ز آهنی بی رنگ شو","در ریاضت آینه بی زنگ شو","همچون آهن از «آهن بودن» کاملا بی‌رنگ شو و با ریاضت‌، آینه بی‌رنگ و زلال شو‌."],[155,"خویش را صافی کن از اوصاف خود","تا ببینی ذات پاک صاف خود","خود را از ویژگی‌های منفی و پستی‌ها پاک و خالص کن تا بتوانی ذات پاک و زیبا و واقعی‌ات را ببینی."],[155,"بینی اندر دل علوم انبیا","بی کتاب و بی معید و اوستا","در دل انسان، علوم و دانش‌های پیامبران را خواهی دید، بدون نیاز به کتاب و سند و متون مقدس دیگر."],[155,"گفت پیغمبر که هست از امتم","کو بود هم گوهر و هم همتم","پیامبر (که منظورش محمد (ص) است) گفت که در میان امت من کسی وجود دارد که هم از نظر روحی و هم از نظر نژادی مانند من است."],[155,"مر مرا زان نور بیند جانشان","که من ایشان را همی‌بینم بدان","جان‌ها به نور الهی می‌بینند که من نیز آن‌ها را با همان نور می‌بینم."],[155,"بی صحیحین و احادیث و روات","بلک اندر مشرب آب حیات","تنها با آیات و احادیث نیست که می‌توان به حقیقت پی برد، بلکه باید در سرچشمه‌ی معرفت و آب حیات غوطه‌ور شد و از آن نوشید."],[155,"سر امسینا لکردیا بدان","راز اصبحنا عرابیا بخوان","سر صبح به خاطر آن راز، ما مانند عرب‌ها (قبیله‌های عرب) گویانی شده‌ایم."],[155,"ور مثالی خواهی از علم نهان","قصه‌گو از رومیان و چینیان","اگر به دنبال مثالی از علم پنهان هستی، می‌توانی داستان‌هایی از رومی‌ها و چینی‌ها بگویی."],[156,"چینیان گفتند ما نقاش‌تر","رومیان گفتند ما را کر و فر","چینیان ادعا کردند که ما در هنر نقاشی برتر از رومیان هستیم، و رومیان هم در پاسخ گفتند که ما در این زمینه توانمندتر و با استعدادتر هستیم."],[156,"گفت سلطان امتحان خواهم درین","کز شماها کیست در دعوی گزین","سلطان گفت: می‌خواهم شما را امتحان کنم تا ببینم از بین شما کدام‌یک در این ادعا برتری دارد."],[156,"اهل چین و روم چون حاضر شدند","رومیان در علم واقف‌تر بدند","هنگامی که اهالی چین و روم در جمع حاضر شدند، رومیان در دانش علم نقاشی و تصویرگری از چینیان آگاه‌تر و موفق‌تر بودند."],[156,"چینیان گفتند یک خانه به ما","خاص بسپارید و یک آن شما","چینی‌ها خواستار شدند که یک خانه به ویژه برای خودشان در نظر بگیرند و خانه دیگر برای رومی‌ها باقی بماند."],[156,"بود دو خانه مقابل در بدر","زان یکی چینی ستد رومی دگر","در برابر در شهر، دو خانه وجود داشت؛ یکی از آن‌ها متعلق به چینی‌ها و دیگری برای رومی‌ها بود."],[156,"چینیان صد رنگ از شه خواستند","پس خزینه باز کرد آن ارجمند","چینیان از شاه درخواست کردند که صد رنگ به آنها بدهد، سپس شاه آن خزانه ارزشمند را باز کرد."],[156,"هر صباحی از خزینه رنگها","چینیان را راتبه بود از عطا","هر صبح، چینیان از خزانه رنگ‌ها سهم و بهره‌ای می‌گرفتند که از نعمت و بخشش بود."],[156,"رومیان گفتند نه نقش و نه رنگ","در خور آید کار را جز دفع زنگ","رومیان بیان کردند که نه نقاشی و نه رنگ به کار نمی‌آید و تنها راه حل، از میان بردن زنگار و کدری است."],[156,"در فرو بستند و صیقل می‌زدند","همچو گردون ساده و صافی شدند","آن‌ها (رومیان) در دفتری بسته، کار خود را با دقت و صیقل دادن انجام می‌دادند؛ به گونه‌ای که مانند آسمان، ساده و بی‌حرکت شدند."],[156,"از دو صد رنگی به بی‌رنگی رهیست","رنگ چون ابرست و بی‌رنگی مهیست","از میان رنگ‌ها و تنوعات زیاد، به بی‌رنگی و سادگی رسیدن ممکن است. رنگ‌ها مانند ابر هستند و بی‌رنگی شبیه به نور ماه است."],[156,"هرچه اندر ابر ضو بینی و تاب","آن ز اختر دان و ماه و آفتاب","هر نوری که در ابر می‌بینی و روشنی آن، از نور ستاره، ماه و خورشید است."],[156,"چینیان چون از عمل فارغ شدند","از پی شادی دهلها می‌زدند","چینیان پس از اینکه از کار نقاشی و تصویرگری فارغ شدند، برای خوشحالی و شادمانی به ضرب آواز دهل شروع به نواختن کردند."],[156,"شه در آمد دید آنجا نقشها","می‌ربود آن عقل را و فهم را","سلطان (شه) به آنجا آمد و مشاهده کرد که نقاشی‌ها و تصاویر به شدت توجه و فکر او را به خود مشغول کرده و او را از درک واقعیت دور می‌کنند."],[156,"بعد از آن آمد به سوی رومیان","پرده را بالا کشیدند از میان","پس از آن، او به سمت رومیان رفت و پرده را از وسط بالا زدند."],[156,"عکس آن تصویر و آن کردارها","زد برین صافی شده دیوارها","عکس آن تصویر و کارهایی که کرده بودند، بر روی دیوارهای صاف و بدون نقص ایجاد شده است."],[156,"هر چه آنجا دید اینجا به نمود","دیده را از دیده‌خانه می‌ربود","هر آنچه که در آنجا (در دنیای دیگر یا عالم بالا) مشاهده کرد، اینجا (در دنیای مادی) به ظهور می‌آید و چشم را از دیدن آنچه در «دیده‌خانه» (پرده‌های چشم یا دنیای مادی) محدود شده، می‌رباید."],[156,"رومیان آن صوفیانند ای پدر","بی ز تکرار و کتاب و بی هنر","رومیان در این بیت به صوفیان اشاره دارند که از تکرار، مطالعه کتب، و مهارت‌های هنری مستقل هستند. در حقیقت، آنها به تجارب روحانی و درونی خود تکیه می‌کنند و بر ادراک شخصی و باطنی خود تأکید دارند."],[156,"لیک صیقل کرده‌اند آن سینه‌ها","پاک از آز و حرص و بخل و کینه‌ها","اما آنها که دل‌هایشان را صیقل داده‌اند، از هر نوع آز و حرص و بخل و کینه پاک شده‌اند."],[156,"آن صفای آینه وصف دلست","صورت بی منتها را قابلست","آینه‌ای که پاک و صاف است، نمایانگر دل است و می‌تواند صورت بی‌حد و اندازه‌ای را به نمایش بگذارد."],[156,"صورت بی‌صورت بی حد غیب","ز آینه دل تافت بر موسی ز جیب","صورت بی‌صورت یعنی حقیقتی خالی از شکل و ویژگی، از عالم غیب از دل آدمی مانند آینه‌ای نور می‌تاباند و بر موسی (حضرت موسی) آشکار می‌شود."],[156,"گرچه آن صورت نگنجد در فلک","نه بعرش و فرش و دریا و سمک","هرچند آن تصویر زیبا در آسمان و زمین و دریا و موجودات زنده نمی‌گنجد و به وضوح دیده نمی‌شود، اما وجود دارد."],[156,"زانک محدودست و معدودست آن","آینه دل را نباشد حد بدان","دل انسان مانند آینه‌ای است که محدود و شمارش‌پذیر نیست، و نمی‌توان آن را به مرزها و حد و مرز مشخصی محدود کرد."],[156,"عقل اینجا ساکت آمد یا مضل","زانک دل یا اوست یا خود اوست دل","عقل در اینجا خاموش شده یا گمراه است، زیرا یا دل همان عقل است و یا خود عقل است که دل را به وجود آورده است."],[156,"عکس هر نقشی نتابد تا ابد","جز ز دل هم با عدد هم بی عدد","هیچ تصویری نمی‌تواند تا ابد بماند و پدیدار شود، مگر این که از دل ناشی شده باشد، چه با عدد (محاسبه) و چه بی عدد (بدون تعدادی خاص و مشخص)."],[156,"تا ابد هر نقش نو کاید برو","می‌نماید بی حجابی اندرو","هر نقش جدیدی که به وجود می‌آید، تا ابد به نمایش در می‌آید و در آن، جلوه‌های بدون حجاب و خلوص وجود دارد."],[156,"اهل صیقل رسته‌اند از بوی و رنگ","هر دمی بینند خوبی بی درنگ","افراد هنرمند و زبردست در هنر نقاشی، از عطر و رنگ‌های ظاهری رها شده‌اند و در هر لحظه زیبایی‌های واقعی و عمیق را مشاهده می‌کنند."],[156,"نقش و قشر علم را بگذاشتند","رایت عین الیقین افراشتند","آن‌ها (اهل علم و هنر) از ظاهر علم و زیبایی‌های سطحی آن دست برداشتند و پرچم یقین واقعی را برافراشتند."],[156,"رفت فکر و روشنایی یافتند","نحر و بحر آشنایی یافتند","آنها از این فکر و اندیشه، روشنایی و آگاهی پیدا کردند و به علم عمیق و گسترده‌ای در زمینه‌های مختلف (نحر و بحر به معنای علم و تجربیات در زندگی) دست یافتند."],[156,"مرگ کین جمله ازو در وحشتند","می‌کنند این قوم بر وی ریش‌خند","این قوم از مرگ و کین می‌ترسند و به همین دلیل بر او (شخصی که مورد تمسخر قرار می‌گیرد) می‌خندند."],[156,"کس نیابد بر دل ایشان ظفر","بر صدف آید ضرر نه بر گهر","هیچ‌کس نمی‌تواند بر دل این آدم‌ها پیروز شود، مانند اینکه در صدفی که مروارید ندارد، هیچ‌چیز نمی‌تواند به آن آسیبی برساند."],[156,"گرچه نحو و فقه را بگذاشتند","لیک محو فقر را بر داشتند","هرچند که از تحصیل علم نحو (دستور زبان) و فقه (علم دین) خودداری کردند، اما از بین بردن فقر و نیازمندی را فراموش نکردند و همچنان برای رهایی از آن تلاش می‌کنند."],[156,"تا نقوش هشت جنت تافتست","لوح دلشان را پذیرا یافتست","دل‌های ایشان مانند لوحی است که نقوش هشت جنت (بهشت) بر آن نقش بسته، و این زیبایی و فهم عمیق به روح و دل آن‌ها نور می‌بخشد."],[156,"برترند از عرش و کرسی و خلا","ساکنان مقعد صدق خدا","ساکنان مقام صدق خدا از مراتب بالاتر از عرش و کرسی و خلا هستند."],[157,"گفت پیغمبر صباحی زید را","کیف اصبحت ای رفیق با صفا","پیغمبر از زید می‌پرسد: «چگونه صبح کردی، ای رفیق باصفات؟"],[157,"گفت عبدا مؤمنا باز اوش گفت","کو نشان از باغ ایمان گر شکفت","زید پاسخ می‌دهد که من بنده‌ای مؤمن هستم؛ اما پیغمبر پرسش دیگری می‌کند و می‌پرسد نشانه‌ای از باغ ایمان نشان بده، اگر که شکوفا شده‌ای."],[157,"گفت تشنه بوده‌ام من روزها","شب نخفتستم ز عشق و سوزها","زید می‌گوید که من در روزها تشنه بوده‌ام و به خاطر عشق و سوز درونی‌ام شب‌ها نتوانسته‌ام بخوابم."],[157,"تا ز روز و شب گذر کردم چنان","که ز اسپر بگذرد نوک سنان","از وقتی که روز و شب را گذرانده‌ام، مانند آن است که نوک نیزه از لابلای گرد و غبار می‌گذرد و هیچ چیز را حس نمی‌کند."],[157,"که از آن سو جمله ملت یکیست","صد هزاران سال و یک ساعت یکیست","از آن طرف همه ملت‌ها یکی هستند؛ یعنی در حقیقت، تفاوتی میان آن‌ها وجود ندارد و زمان، چه صد هزار سال باشد و چه یک ساعت، از این نظر اهمیت ندارد."],[157,"هست ازل را و ابد را اتحاد","عقل را ره نیست آن سو ز افتقاد","ازل و ابد، یعنی زمان‌های بی‌پایان، در واقع همگی یکی هستند و عقل انسان نمی‌تواند به درستی به آن‌ها دست یابد؛ زیرا عقل به خاطر کمبودهایش نمی‌تواند به آن سوی حقیقت پی ببرد."],[157,"گفت ازین ره کو ره‌آوردی بیار","در خور فهم و عقول این دیار","پیامبر از زید خواسته که تجربه‌اش را از حالت خود بگوید. زید پاسخ می‌دهد که از این مسیر آگاهی‌هایی برای مردم بیاور که متناسب با درک و عقل‌های این سرزمین باشد."],[157,"گفت خلقان چون ببینند آسمان","من ببینم عرش را با عرشیان","نمی‌دانم مردم چه می‌گویند، اما وقتی به آسمان نگاه می‌کنم، عرش را می‌بینم و در کنار اهل عرش قرار می‌گیرم."],[157,"هشت جنت هفت دوزخ پیش من","هست پیدا همچو بت پیش شمن","هشت بهشت و هفت دوزخ همه در برابر من واضح و مشخص است، همان‌طور که بت‌ها در مقابل شمن (کاهن یا عابد) قرار دارند."],[157,"یک به یک وا می‌شناسم خلق را","همچو گندم من ز جو در آسیا","هر یک از انسان‌ها را به خوبی می‌شناسم و می‌توانم آن‌ها را از یکدیگر تمییز دهم، درست مثل اینکه جدا کردن گندم از جو را در آسیاب می‌دانم."],[157,"که بهشتی کیست و بیگانه کیست","پیش من پیدا چو مار و ماهیست","بهشتی و بیگانه چه کسانی هستند، برای من این‌جا روشن است، مانند تفاوت مار و ماهی که هر یک مشخص و قابل تشخیص‌اند."],[157,"این زمان پیدا شده بر این گروه","یوم تبیض و تسودالوجوه","این زمان برای گروهی روزی است که چهره‌ها درخشان و سفید یا تیره و سیاه می‌شود، و این نشان‌دهنده حال و سرنوشت افراد است."],[157,"پیش ازین هرچند جان پر عیب بود","در رحم بود و ز خلقان غیب بود","پیش از این، هرچند جان انسان پر از عیوب بود، در مرحله جنینی در رحم مادر وجود داشت و از دید سایر مردم پنهان بود."],[157,"الشقی من شقی فی بطن الام","من سمات الجسم یعرف حالهم","انسان بدبخت کسی است که در رحم مادر بدبخت به دنیا آمده و علامت‌های جسمی او نشان‌دهنده حال اوست."],[157,"تن چو مادر طفل جان را حامله","مرگ درد زادنست و زلزله","بدن انسان مانند یک مادر است که جان را در خود حمل می‌کند. مرگ مانند زائیدن است که درد و سختی‌هایی به همراه دارد."],[157,"جمله جانهای گذشته منتظر","تا چگونه زاید آن جان بطر","همه ارواح کسانی که قبلا مرده‌اند، منتظرند که ببینند این جان تازه (انسانی که به دنیا می‌آید) چگونه و با چه ویژگی‌هایی پا به عرصه وجود می‌گذارد."],[157,"زنگیان گویند خود از ماست او","رومیان گویند بس زیباست او","زنگیان (مردم زنگبار) ادعا می‌کنند که او از آن‌هاست و رومیان (مردم روم) می‌گویند که او بسیار زیباست. در این بیت به شکاف فرهنگی و ادعای هویت متفاوت درباره یک شخص اشاره شده است."],[157,"چون بزاید در جهان جان و جود","پس نماند اختلاف بیض و سود","وقتی که در جهان جان (زندگی) و جود (فراوانی) به وجود آید، دیگر اختلاف در نژاد و سود (به‌دست آوردن منافع) وجود نخواهد داشت."],[157,"گر بود زنگی برندش زنگیان","روم را رومی برد هم از میان","اگر یک زنگی (برده یا شخص سیاه‌پوست) به رومی‌ها (مردم روم) نسبت داده شود، این زنگی هم از میان آن‌ها به حساب می‌آید و به گونه‌ای همه با هم یکی هستند. در واقع، انسان از نظر هویت و اصلش فراتر از رنگ و نژاد است."],[157,"تا نزاد او مشکلات عالمست","آنک نازاده شناسد او کمست","مشکلات عالم به وجود آمده، تا زمانی که کسی نداشته باشد که با درک عمیق خود از مسائل آگاه باشد، به وجود می‌آید. فقط کسی که از تولد و ریشه خودش آگاه نیست، می‌تواند این مشکلات را کمتر بشناسد."],[157,"او مگر ینظر بنور الله بود","کاندرون پوست او را ره بود","آیا او نور خدا را نمی‌بیند که درون پوست او وجود دارد و او را هدایت می‌کند؟"],[157,"اصل آب نطفه اسپیدست و خوش","لیک عکس جان رومی و حبش","نطفه اصلی انسان (آب) از رنگ سفید و خوشی برخوردار است، اما تصویر روح و شخصیت او (رومی و حبشی) در ظاهر او نمایان است."],[157,"می‌دهد رنگ احسن التقویم را","تا به اسفل می‌برد این نیم را","خداوند انسان را با بهترین شکل آفریده است، اما این انسان به واسطه اعمال خود می‌تواند به پایین‌ترین درجات سقوط کند."],[157,"این سخن پایان ندارد باز ران","تا نمانیم از قطار کاروان","این سخن هیچ‌گاه تمام نمی‌شود، بنابراین باید همواره با شتاب پیش برویم تا از کاروان زندگی عقب نمانیم."],[157,"یوم تبیض و تسود وجوه","ترک و هندو شهره گردد زان گروه","در روزی که چهره‌ها سفید و سیاه می‌شود، گروهی از ترک و هندو به خاطر این واقعه معروف خواهند شد."],[157,"در رحم پیدا نباشد هند و ترک","چونک زاید بیندش زار و سترگ","در دنیای پس از مرگ، در رحم مادر هیچ تفاوتی میان هندو و ترک وجود ندارد؛ زیرا وقتی انسان به دنیا می‌آید، از همه تعلقات و تفاخرها آزاد و بی‌نیاز از آن‌هاست."],[157,"جمله را چون روز رستاخیز من","فاش می‌بینم عیان از مرد و زن","در روز قیامت، من همه چیز را به وضوح و به صورت آشکار از مردان و زنان می‌بینم، مانند روزی که همه حقایق روشن می‌شود."],[157,"هین بگویم یا فرو بندم نفس","لب گزیدش مصطفی یعنی که بس","من امروز درباره حال و احوال خود نزد پیامبر (مصطفی) چیزی می‌گویم یا سکوت می‌کنم، چرا که از شدت شوق و اضطراب، زبانم به گزیدن لب‌هایم مشغول است."],[157,"یا رسول الله بگویم سر حشر","در جهان پیدا کنم امروز نشر","ای پیامبر خدا، آیا بگویم که در روز قیامت چطور برانگیخته می‌شوم تا اوضاع و احوال آن روز را در این جهان برای خودم مشخص کنم؟"],[157,"هل مرا تا پرده‌ها را بر درم","تا چو خورشیدی بتابد گوهرم","من به مناجات و دعا دعوت می‌کنم تا تمام موانع و حجاب‌ها از پیش رویم برداشته شود، تا همچون خورشید، درخشش وجودم نمایان شود."],[157,"تا کسوف آید ز من خورشید را","تا نمایم نخل را و بید را","وقتی سایه‌ام (کسوف) بر روی خورشید بیفتد، می‌توانم درخت خرما و بید را به نمایش بگذارم. این به این معناست که در زمان‌هایی که من تحت فشار و مشکل هستم، می‌توانم صفات و ویژگی‌های پنهانی خود را نشان دهم."],[157,"وا نمایم راز رستاخیز را","نقد را و نقد قلب‌آمیز را","راز رستاخیز و معانی عمیق آن را برای مردم به نمایش می‌گذارم و همچنین حقیقت و درونی‌ترین احساسات قلبی را روشن می‌کنم."],[157,"دستها ببریده اصحاب شمال","وا نمایم رنگ کفر و رنگ آل","من در قیامت، دست‌های بریده افرادی را که در گروه اهل چپ هستند، نشان می‌دهم و رنگ کفر و نفاق آن‌ها را به نمایش می‌گذارم."],[157,"وا گشایم هفت سوراخ نفاق","در ضیای ماه بی خسف و محاق","من در روشنی ماه، با این‌که هنوز سایه‌ای از خسوف (ماه‌گرفتگی) یا محاق (کم‌نور شدن ماه) وجود ندارد، هفت سوراخ نفاق را نمایان می‌کنم. این اشاره به آمادگی برای نشان دادن باطن حقایق و نفاق‌ها دارد."],[157,"وا نمایم من پلاس اشقیا","بشنوانم طبل و کوس انبیا","من منسجم و محکم، زندگی بدبختان را آشکار می‌کنم و صدای طبل و ساز پیامبران را به گوش آنان می‌رسانم."],[157,"دوزخ و جنات و برزخ در میان","پیش چشم کافران آرم عیان","برای کافران، دوزخ و بهشت و برزخ را به طور واضح و آشکار جلوه می‌دهم تا آن‌ها را ببینند و درک کنند."],[157,"وا نمایم حوض کوثر را به جوش","کاب بر روشان زند بانگش به گوش","من حوض کوثر، که نماد بهشت و نعمت‌های الهی است، را به تصویر می‌کشم که از آن آب زلالی می‌جوشد و مرغ‌های آسمانی با آواز خوش خود، از آن برای مردم خبر می‌دهند."],[157,"وان کسان که تشنه بر گردش دوان","گشته‌اند این دم نمایم من عیان","کسانی که در اطراف من به شدت تشنه‌اند و در حرکت هستند، اکنون من آنها را به وضوح نشان می‌دهم."],[157,"می‌بساید دوششان بر دوش من","نعره‌هاشان می‌رسد در گوش من","صدای ناله و فریاد تشنگان به گوش من می‌رسد و حالشان را به شدت احساس می‌کنم. آن‌ها در سختی و نیاز به من و کمک من ناله می‌کنند."],[157,"اهل جنت پیش چشمم ز اختیار","در کشیده یک‌دگر را در کنار","اهل بهشت در برابر چشمان من، به اختیار خود، یکدیگر را به نزدیک می‌کشانند."],[157,"دست همدیگر زیارت می‌کنند","از لبان هم بوسه غارت می‌کنند","اهل بهشت یکدیگر را ملاقات می‌کنند و با لبان خود به یکدیگر بوسه می‌زنند."],[157,"کر شد این گوشم ز بانگ آه آه","از خسان و نعره واحسرتاه","گوش من از صدای آه و ناله و فریاد \"واه حسرتا\"ی انسان‌های ناتوان و بدبخت به شدت کر شده است و دیگر نمی‌تواند بشنود."],[157,"این اشارتهاست گویم از نغول","لیک می‌ترسم ز آزار رسول","منظور از این بیت این است که شاعر به نشانه‌ها و رمزهای معنوی اشاره می‌کند، اما از اینکه پیامبر (محمد صلی الله علیه و سلم) را آزار دهد یا مورد خشم او قرار گیرد، می‌ترسد."],[157,"همچنین می‌گفت سرمست و خراب","داد پیغامبر گریبانش بتاب","زید در حالی که سرمست و خمار بود، به پیامبر اکرم (ص) گفت که گریبانش را بگیرد و بر او تاب دهد."],[157,"گفت هین در کش که اسبت گرم شد","عکس حق لا یستحی زد شرم شد","زید گفت: «بروید و ببینید که شترتان (که به عنوان نشانه‌ای از یاری حق است) گرم شده و در برابر حقیقت، شرم دارد.» این نشان‌دهنده درخشش نور حق و تأثیر آن بر وجود انسان است."],[157,"آینه تو جست بیرون از غلاف","آینه و میزان کجا گوید خلاف","آینه وجود تو باید از پوشش خود بیرون بیاید؛ چون آینه و ترازویی که حقیقت را نشان می‌دهند، نمی‌توانند چیزی برعکس از خود بگویند."],[157,"آینه و میزان کجا بندد نفس","بهر آزار و حیاء هیچ‌کس","آینه و میزان هیچ‌گاه نمی‌تواند نفس را به خاطر آزار یا شرم هیچ‌کس محدود کند."],[157,"آینه و میزان محکهای سنی","گر دو صد سالش تو خدمتها کنی","آینه و میزان، معیاری از حقیقت هستند و حتی اگر سال‌ها برای دیگران خدمت کنی، این محک‌ها نمی‌توانند بر درستی و صداقت تو تاثیری بگذارند."],[157,"کز برای من بپوشان راستی","بر فزون بنما و منما کاستی","برای من حقیقت را پنهان کن و آنچه از خوبی‌ها در من هست، نشان بده و کمبودها و نقص‌هایم را به نمایش نگذار."],[157,"اوت گوید ریش و سبلت بر مخند","آینه و میزان و آنگه ریو و پند","او (زید) می‌گوید که ریش و موی بلند من را در آینه و میزان نگذارید، چون سرنوشت و عاقبت ما مهم است و پند و نصیحت به آنچه درون وجود ماست بستگی دارد."],[157,"چون خدا ما را برای آن فراخت","که بما بتوان حقیقت را شناخت","خداوند ما را آفرید تا بتوانیم حقیقت را بشناسیم."],[157,"این نباشد، ما چه ارزیم ای جوان؟","کی شویم آیین روی نیکوان","اگر این‌طور نباشد، پس ما چه ارزشی داریم، ای جوان؟ چگونه می‌توانیم به آیین و راه نیکوکاران برسیم؟"],[157,"لیک در کش در نمد آیینه را","کز تجلی کرد سینا سینه را","اما در کشف حقیقت، مانند نمد، آینه‌ای وجود دارد که تجلیات نورانی و فراوان بر آن اثر گذاشته است، مانند نور تجلی خداوند بر کوه طور که دل‌ها را روشن می‌کند."],[157,"گفت آخر هیچ گنجد در بغل","آفتاب حق و خورشید ازل","آیا ممکن است که نور و حقیقتی به چنین بزرگی، مثل آفتاب الهی یا خورشید آغازین، در دامن و نزدیکی انسان بگنجد؟"],[157,"هم دغل را هم بغل را بر درد","نه جنون ماند به پیشش نه خرد","هر دو (دغل و بغل) برای زخم‌های درونی آدمی کافی نیستند، نه دیوانگی و نه عقل، هیچ‌کدام در برابر او، که حقیقت مطلق است، ناتوان می‌مانند."],[157,"گفت یک اصبع چو بر چشمی نهی","بیند از خورشید عالم را تهی","اگر یک انگشت را روی چشمت بگذاری، نمی‌توانی حیات و روشنی خورشید را ببینی و تنها چیزی که می‌بینی، تاریکی و عدم است."],[157,"یک سر انگشت پرده ماه شد","وین نشان ساتری شاه شد","پرده ماه، یعنی نور و روشنایی ماه که به تصور آمده، با یک سر انگشت پوشانده شده و این نشان‌دهنده‌ی پادشاهی بزرگ است که در آن نور و وسعت وجود دارد."],[157,"تا بپوشاند جهان را نقطه‌ای","مهر گردد منکسف از سقطه‌ای","برای اینکه مهر (محبت) جهان را بپوشاند، باید یک نقطه‌ای باشد که از سقوط آن نقطه، نور (یا زیبایی) متجلی گردد."],[157,"لب ببند و غور دریایی نگر","بحر را حق کرد محکوم بشر","سکوت کن و به عمق وجود خود بنگر، چرا که واقعیت‌ها و معانی عمیق در دریاچه وجود انسان نهفته است و خداوند حقایق را بر بشر مکشوف کرده است."],[157,"همچو چشمه سلسبیل و زنجبیل","هست در حکم بهشتی جلیل","مانند چشمه زلال و شیرین سلسبیل و زنجبیل، این‌ها در سیرت و زیبایی بهشت مقام عظیمی دارند."],[157,"چار جوی جنت اندر حکم ماست","این نه زور ما ز فرمان خداست","چهار جوی (رودخانه) بهشتی در حکم ما وجود دارد و این نعمت از قدرت و اختیارات ما نیست، بلکه ناشی از فرمان خداوند است."],[157,"هر کجا خواهیم داریمش روان","همچو سحر اندر مراد ساحران","هر جا که اراده کنیم، آن چیز را به راحتی داریم، مانند سحر که آرزوهای ساحران را محقق می‌کند."],[157,"همچو این دو چشمه چشم روان","هست در حکم دل و فرمان جان","چشم‌های انسان به مانند دو چشمه هستند که در جریان و نرمی دل و اراده‌ی جان تأثیر دارند."],[157,"گر بخواهد رفت سوی زهر و مار","ور بخواهد رفت سوی اعتبار","اگر بخواهد به سمت زهر و مار برود، یا اگر بخواهد به سمت چیزهای محترم و با اعتبار حرکت کند."],[157,"گر بخواهد سوی محسوسات رفت","ور بخواهد سوی ملبوسات رفت","اگر بخواهد به سمت چیزهای محسوس و قابل مشاهده برود، یا اگر بخواهد به سمت پوشاک و لباس‌ها برود."],[157,"گر بخواهد سوی کلیات راند","ور بخواهد حبس جزویات ماند","اگر بخواهد به سمت اصول کلی و کلیات برود، و اگر بخواهد در جزئیات و مسائل خاص متوقف بماند."],[157,"همچنین هر پنج حس چون نایزه","بر مراد و امر دل شد جایزه","هر پنج حس انسان مانند تیرهایی هستند که بر اساس اراده و خواسته دل حرکت می‌کنند و به سمت آنچه که دل می‌خواهد، می‌روند."],[157,"هر طرف که دل اشارت کردشان","می‌رود هر پنج حس دامن‌کشان","هر جا که دل اشاره کند، هر پنج حس (بینایی، شنوایی، بویایی، چشایی و لامسه) دنبال آن می‌روند و به آن سمت حرکت می‌کنند."],[157,"دست و پا در امر دل اندر ملا","همچو اندر دست موسی آن عصا","دل انسان در امورش حکم‌فرماست و اعضای بدن (دست و پا) در خدمت دل هستند، مانند عصای موسی که در دست او بود و به دستورات او عمل می‌کرد."],[157,"دل بخواهد پا در آید زو به رقص","یا گریزد سوی افزونی ز نقص","دل می‌خواهد که پا به میدان رقص بگذارد یا به دنبال افزایش و برطرف کردن نقص‌های خود فرار کند."],[157,"دل بخواهد دست آید در حساب","با اصابع تا نویسد او کتاب","اگر دل بخواهد، می‌تواند با انگشتانش به حساب وکتاب بپردازد و مطالبی را بنویسد. این اشاره به این دارد که اگر انسان اراده کند، می‌تواند توانایی‌هایش را به کار گیرد و به دانایی و یادگیری بپردازد."],[157,"دست در دست نهانی مانده است","او درون تن را برون بنشانده است","انسان، در درون خود دارای نعمت‌ها و ظرفیت‌های پنهانی است که دست او به آن‌ها نمی‌رسد. او باید این استعدادها و نیروهای نهان را از درون خود بیرون بیاورد و به فعلیت برساند."],[157,"گر بخواهد بر عدو ماری شود","ور بخواهد بر ولی یاری شود","اگر بخواهد، می‌تواند به دشمنانش مانند مار خطرناک شود، و اگر بخواهد، می‌تواند به دوستان و ولی‌اش کمک کند."],[157,"ور بخواهد کفچه‌ای در خوردنی","ور بخواهد همچو گرز ده‌منی","اگر بخواهد، می‌تواند حرکتی کوچک و ساده مانند برداشت یک قاشق از غذا داشته باشد و اگر بخواهد، می‌تواند به‌قدری قوی و بزرگ عمل کند که مانند گرزی سنگین و شدید باشد."],[157,"دل چه می‌گوید بدیشان ای عجب","طرفه وصلت طرفه پنهانی سبب","دل چه می‌گوید به دوستان خود که ای شگفت، وصل و پیوند ما شگفت‌انگیز و پنهان است، دلیل آن چیست؟"],[157,"دل مگر مهر سلیمان یافتست","که مهار پنج حس بر تافتست","دل اگر به مانند سلیمان، محبت و عشق خاصی پیدا کرده باشد، می‌تواند بر پنج حس (شکم، بینایی، شنوایی، لامسه و بساوش) که به دنیای مادی مربوطند، غلبه کند و آن‌ها را تحت کنترل خود قرار دهد."],[157,"پنج حسی از برون میسور او","پنج حسی از درون مامور او","پنج حس که از بیرون برای او فراهم است، به اضافه پنج حس دیگری که از درون وظیفه‌ای به دوش دارند."],[157,"ده حس است و هفت اندام و دگر","آنچ اندر گفت ناید می‌شمر","انسان دارای ده حس و هفت عضو اصلی است و همچنین چیزهایی وجود دارد که نمی‌توان آنها را با زبان بیان کرد."],[157,"چون سلیمانی دلا در مهتری","بر پری و دیو زن انگشتری","وقتی که دلاور سلیمان، در مقام سرپرستی، بر یک پری و یک دیو، انگشتر را می‌زند."],[157,"گر درین ملکت بری باشی ز ریو","خاتم از دست تو نستاند سه دیو","اگر در این مملکت حاکم و آزاد باشی، هیچ دیو (بدی یا شیطانی) نمی‌تواند خاتم (قدرت و سلطنت تو) را از دستانت بستاند."],[157,"بعد از آن عالم بگیرد اسم تو","دو جهان محکوم تو چون جسم تو","پس از مرگ تو، علم و دانش نام تو را بر خود می‌گیرد و دو جهان (مادی و معنوی) تحت سیطره و فرمان تو قرار می‌گیرد، مانند اینکه جسم تو در دست دیگران است."],[157,"ور ز دستت دیو خاتم را ببرد","پادشاهی فوت شد بختت بمرد","اگر دیو در دست تو خاتم را بگیرد، یعنی اگر قدرت و سلطنت تو را از تو بگیرند، سلطنت و کامیابی‌ات از بین می‌رود و بخت تو به پایان می‌رسد."],[157,"بعد از آن یا حسرتا شد یا عباد","بر شما محتوم تا یوم التناد","پس از آن، یا به درد و حسرت دچار می‌شوید و یا به عبادت و بندگی، زیرا این ناپایدار است و در نهایت تا روز قیامت، این سرنوشت برای شما مقرر شده است."],[157,"مکر خود را گر تو انکار آوری","از ترازو و آینه کی جان بری","اگر تو مکر و حیله‌ی خود را انکار کنی، از کجا می‌توانی جان خود را نجات دهی، در حالی که آینه و ترازو حقیقت را نشان می‌دهند؟"],[158,"بود لقمان پیش خواجه خویشتن","در میان بندگانش خوارتن","لقمان در حضور ارباب خود (خواجه) در میان بندگانش در وضعیت فرودستی قرار داشت و به نوعی حقیر شده بود."],[158,"می‌فرستاد او غلامان را به باغ","تا که میوه آیدش بهر فراغ","لقمان، غلامان خود را به باغ می‌فرستاد تا میوه بیاورند و او از آن‌ها برای تفریح و آرامش خود بهره‌برداری کند."],[158,"بود لقمان در غلامان چون طفیل","پر معانی تیره‌صورت همچو لیل","لقمان در میان غلامان مانند کسی بود که به ارزش‌ها و معانی عمیق زندگی وابسته است، اما ظاهری ناپسند و سیاه مانند شب (لیل) دارد."],[158,"آن غلامان میوه‌های جمع را","خوش بخوردند از نهیب طمع را","غلامان میوه‌های خوشمزه را به خوبی خوردند و این به دلیل طمع و تمایل آنها به لذات زندگی بود."],[158,"خواجه را گفتند لقمان خورد آن","خواجه بر لقمان ترش گشت و گران","به لقمان گفتند که غلامان میوه‌ها را خوردند، و خواجه به خاطر این خبر بر لقمان عصبانی و دلخور شد."],[158,"چون تفحص کرد لقمان از سبب","در عتاب خواجه‌اش بگشاد لب","لقمان به دنبال دلیل عصبانیت خواجه‌اش بود و وقتی آن را بررسی کرد، زبانش باز شد و شروع به صحبت کرد."],[158,"گفت لقمان سیدا پیش خدا","بنده خاین نباشد مرتضی","لقمان به آقا (خواجه‌اش) گفت که نزد خدا، بنده‌ای که خیانت کند، مورد پسند نیست."],[158,"امتحان کن جمله‌مان را ای کریم","سیرمان در ده تو از آب حمیم","امتحان کن همه ما را، ای بزرگوار، زیرا سیرابی ما از آب گوارای توست."],[158,"بعد از آن ما را به صحرایی کلان","تو سواره ما پیاده می‌دوان","سپس ما را به بیابان وسیعی می‌بردی، در حالی که تو سوار بودی و ما پیاده عقب تو می‌دویدیم."],[158,"آنگهان بنگر تو بدکردار را","صنعهای کاشف الاسرار را","به آنجا بنگر که بدکردار است و به مهارت‌ها و دستاوردهای او که اسرار را آشکار می‌کند."],[158,"گشت ساقی خواجه از آب حمیم","مر غلامان را و خوردند آن ز بیم","خواجه، ساقی را از آب داغی که در حمام است خبر کرد و غلامان از ترس خواجه آن را نوشیدند."],[158,"بعد از آن می‌راندشان در دشتها","می‌دویدند آن نفر تحت و علا","پس از آن، او آن غلامان را به دشت‌ها فرستاد و آن‌ها در حال دویدن بودند، برخی در وضعیتی خوابیده و برخی دیگر در حالت ایستاده."],[158,"قی در افتادند ایشان از عنا","آب می‌آورد زیشان میوه‌ها","ایشان در خطر گرفتار شدند و برای نوشیدن آب از آن میوه‌ها، به سویی می‌رفتند."],[158,"چون که لقمان را در آمد قی ز ناف","می بر آمد از درونش آب صاف","وقتی که لقمان دچار قی (درد) شد، آب صاف و زلال از درون او خارج شد."],[158,"حکمت لقمان چو داند این نمود","پس چه باشد حکمت رب الوجود","حکمت لقمان (پندها و دانایی‌اش) اگر اینگونه است، پس حکمت خداوند (رب الوجود) چه حالتی خواهد داشت؟"],[158,"یوم تبلی والسرائر کلها","بان منکم کامن لا یشتهی","در آن روز که تمام رازها و دل‌ها آشکار می‌شود، معلوم خواهد شد که از شما کسی وجود دارد که چیزی ندارد و نمی‌خواهد."],[158,"چون سقوا ماء حمیما قطعت","جملة الاستار مما افضعت","آنگاه که به آن‌ها آب جوشان بخورانند، همه پرده‌ها پاره می‌شود و تمام رازها فاش می‌گردد."],[158,"نار زان آمد عذاب کافران","که حجر را نار باشد امتحان","عذاب کافران از آتش است، زیرا آتش می‌تواند سنگ را نیز آزمایش کند و آن را می‌سوزاند."],[158,"آن دل چون سنگ را ما چند چند","نرم گفتیم و نمی‌پذرفت پند","دل سخت و بی‌احساس را ما بارها پند و نصیحت کردیم، اما آن دل هیچ‌گونه تغییر و نرمش نشان نداد و نصیحت‌ها را نپذیرفت."],[158,"ریش بد را داروی بد یافت رگ","مر سر خر را سر دندان سگ","از گیاهان بد، داروی بد پیدا کرد و رگ پای خر را با دندان سگ برید."],[158,"الخبیثات الخبیثین حکمتست","زشت را هم زشت جفت و بابتست","زشت‌ها به زشت‌ها شبیه‌اند و به همین دلیل، میان چیزهای زشت همواره پیوند و همسازی وجود دارد. این یک حکمت است که زشت‌ها با زشت‌ها جفت می‌شوند."],[158,"پس تو هر جفتی که می‌خواهی برو","محو و هم‌شکل و صفات او بشو","برای به‌دست آوردن هر چیزی که خواسته‌ای، باید خود را شبیه و هم‌تراز آن چیزی که می‌خواهی کنی و به نوعی در آن غرق شوی."],[158,"نور خواهی مستعد نور شو","دور خواهی خویش بین و دور شو","اگر خواهان نور و روشنایی هستی، خود را برای دریافت آن آماده کن و به آن نزدیک شو. اگر می‌خواهی از تاریکی دور باشی، ابتدا باید خود را بشناسی و از آن دوری بگیری."],[158,"ور رهی خواهی ازین سجن خرب","سر مکش از دوست و اسجد واقترب","اگر می‌خواهی از این زندان رهایی یابی، سر خود را از دوست دور نکن و همیشه به او نزدیک باش."],[159,"این سخن پایان ندارد خیز زید","بر براق ناطقه بربند قید","این سخن پایانی ندارد، ای زید! بر براق (اسب آسمانی) ناطقه سوار شو و قید آن را ببند."],[159,"ناطقه چون فاضح آمد عیب را","می‌دراند پرده‌های غیب را","ناطق که به معنای گویا و سخنگو است، عیوب را به وضوح و روشنی نمایان می‌سازد و پرده‌های پنهان و غیبی را آشکار می‌کند."],[159,"غیب مطلوب حق آمد چند گاه","این دهل‌زن را بران، بربند راه","حقیقت پنهان و مورد خواست خدا مدتی است که این نوازنده (دهل‌زن) را به نواختن واداشته، اکنون وقت آن رسیده که او را از این کار بازداری و راهش را ببندی."],[159,"تگ مران درکش عنان مستور به","هر کس از پندار خود مسرور به","عنایت و توجه خود را از دیگران دور کن و به آنچه درون خودت نهفته است، توجه کن؛ زیرا هر کس به تخیلات و خیال‌های خود راضی و شاد است، و به همین خاطر دچار اشتباه و گمراهی می‌شود."],[159,"حق همی‌خواهد که نومیدان او","زین عبادت هم نگردانند رو","خداوند می‌خواهد که کسانی که ناامید هستند، به خاطر این عبادت از روی تلخی دور نشوند و به کار خود ادامه دهند."],[159,"هم باومیدی مشرف می‌شوند","چند روزی در رکابش می‌دوند","چند نفر از افراد امیدوار به درگاه حق، مدتی در کنار او (پیامبر اسلام) حضور دارند و در خدمتش می‌کوشند."],[159,"خواهد آن رحمت بتابد بر همه","بر بد و نیک از عموم مرحمه","رحمت الهی می‌خواهد بر همه، چه خوب و چه بد، سایه افکند و به طور عمومی شامل حال همه انسان‌ها شود."],[159,"حق همی‌خواهد که هر میر و اسیر","با رجا و خوف باشند و حذیر","خداوند می‌خواهد که هر فرمانروا و هر اسیر (انسان) با امید و ترس از او زندگی کنند و هوشیار باشند."],[159,"این رجا و خوف در پرده بود","تا پس این پرده پرورده شود","این امید و ترس در پس پرده‌ای پنهان بودند تا زمانیکه این پرده کنار زده شود و آنها نمایان شوند."],[159,"چون دریدی پرده کو خوف و رجا","غیب را شد کر و فری بر ملا","وقتی که پرده عشق را کنار زدی و درک کردی که خوف و امید تنها در خیالند، حقیقت غیب به صورت واضح و شفاف بر تو آشکار می‌شود و صدای آن بر سر همه مردم بلند می‌شود."],[159,"بر لب جو برد ظنّی یک فتی","که سلیمانست ماهی‌گیر ما","در کنار جوی، جوانی وجود دارد که به او ظن و گمان می‌برند که او سلیمان، پادشاه و نبی معروف است، و به همین دلیل، او را ماهی‌گیر ما می‌دانند."],[159,"گر ویست این از چه فردست و خفیست","ورنه سیمای سلیمانیش چیست","اگر این فرد (یعنی فتی که ذکر شده) از آن سلیمان است، پس چرا ویژگی‌های او آشکار و شناخته‌شده نیست؟ در غیر این صورت، چه دلیلی برای شباهت ظاهری‌اش به سلیمان وجود دارد؟"],[159,"اندرین اندیشه می‌بود او دودل","تا سلیمان گشت شاه و مستقل","او در این اندیشه و نگرانی بود که گاهی دچار تردید می‌شد تا اینکه سلیمان پادشاه و مستقل شد."],[159,"دیو رفت از ملک و تخت او گریخت","تیغ بختش خون آن شیطان بریخت","دیو که نماد شر و بدی است، از سرزمین و سلطنت سلیمان فرار کرد و بخت سلیمان به قدری قوی شد که کینه و ناامیدی شیطان را از بین برد."],[159,"کرد در انگشت خود انگشتری","جمع آمد لشکر دیو و پری","زید در انگشتش انگشتری را گذاشت و آن انگشتری باعث شد که لشکری از دیو و پری جمع شوند."],[159,"آمدند از بهر نظاره رجال","در میانشان آنک بد صاحب‌خیال","بزرگانی برای تماشا و دیدن زید به جمع آمده بودند، زیرا او کسی خیالی و توانا داشت که قابل توجه بود."],[159,"چون در انگشتش بدید انگشتری","رفت اندیشه و گمانش یکسری","وقتی زید در انگشت شخصی انگشتری را دید، فکر و گمانش به یک جهت خاص معطوف شد."],[159,"وهم آنگاهست کان پوشیده است","این تحرّی از پی نادیده است","شخص وقتی متوجه چیزی می‌شود، به دنبال آن می‌گردد و در واقع آن جست‌وجو و تلاش، ناشی از چیزی ناپیداست که در دل او وجود دارد."],[159,"شد خیال غایب اندر سینه زفت","چونک حاضر شد خیال او برفت","خیال یا تصوری که در دل انسان در مورد یک چیز غایب وجود دارد، زمانی که آن چیز حاضر می‌شود به طور طبیعی از بین می‌رود."],[159,"گر سمای نور بی باریده نیست","هم زمین تار بی بالیده نیست","اگر نور آسمان نباریده باشد، زمین هم نمی‌تواند سبز و سرسبز شود."],[159,"یومنون بالغیب می‌باید مرا","زان ببستم روزن فانی سرا","مؤمنان باید به غیب ایمان داشته باشند، بنابراین این ایمان را به من سرازیر کرده و روزنه‌ای به جهان فانی بگشایید."],[159,"چون شکافم آسمان را در ظهور","چون بگویم هل تری فیها فطور","زمانی که آسمان را در زمان ظهور می‌شکافم، به مردم می‌گویم آیا در آن دچار نقصی هستید؟"],[159,"تا درین ظلمت تحرّی گسترند","هر کسی رو جانبی می‌آورند","در این تاریکی، هر کسی به جستجوی خود می‌پردازد و به سمتی می‌رود."],[159,"مدتی معکوس باشد کارها","شحنه را دزد آورد بر دارها","مدتی برای شحنه (دست‌نشاندۀ حاکم) کارها به‌طور معکوس و برعکس پیش می‌رود، به‌طوری‌که دزدی را بر دار (چوبه‌دار) می‌آورند."],[159,"تا که بس سلطان و عالی‌همّتی","بنده بنده خود آید مدتی","تا زمانی که سلطان و انسانی با اراده و همت عالی، بنده بنده خود را در این دنیا می‌بیند و خود را به خدمت او درمی‌آورد."],[159,"بندگی در غیب آید خوب و گش","حفظ غیب آید در استعباد خوش","بندگی در غیبت زیبا و مناسب است، و در حالت پنهانی نیز بندگی و خدمت به خداوند خوب و شایسته است."],[159,"کو که مدح شاه گوید پیش او","تا که در غیبت بود او شرم‌رو","کسی که پیش شاه از او تعریف کند و او در غیبت باشد، باید شرمنده باشد."],[159,"قلعه‌داری کز کنار مملکت","دور از سلطان و سایه سلطنت","قلعه‌‌داری که در دوردست و خارج از سرزمین پادشاهی زندگی می‌کند و تحت تأثیر قدرت پادشاه نیست."],[159,"پاس دارد قلعه را از دشمنان","قلعه نفروشد به مالی بی‌کران","قلعه‌دار وظیفه دارد از قلعه در برابر دشمنان محافظت کند و نباید آن را به خاطر مال زیاد بفروشد."],[159,"غایب از شه در کنار ثغرها","همچو حاضر او نگه دارد وفا","زید که در کنار مرزها و نقاط حساس قرار دارد، وفاداری و امانت‌داری‌اش به شه (پادشاه) را مانند محبوبان و کسانی که در حضور او هستند، حفظ می‌کند."],[159,"پیش شه او به بود از دیگران","که به خدمت حاضرند و جان‌فشان","مقام و موقعیت او (زید) نزد پادشاه از دیگران بیشتر است، حتی اگر در غیاب باشد، زیرا کسانی که در حضور پادشاه هستند، نمی‌توانند به اندازه او که در دوری با جان‌فشانی در خدمت است، ارزشمند باشند."],[159,"پس به غیبت نیم ذره حفظ کار","به که اندر حاضری زان صد هزار","اگر در غیاب و دوری هم به مقدار نیم دانه‌ای از کارها و وظایف خود را حفظ کنی، بهتر از این است که در حضور، به رغم اینکه در اطراف تو تعداد زیادی هستند، نتوانی به خوبی انجام وظیفه کنی."],[159,"طاعت و ایمان کنون محمود شد","بعد مرگ اندر عیان مردود شد","ایمان و اطاعت اکنون مورد تحسین و ستایش قرار گرفته است، اما بعد از مرگ، این صفات در عالم واقعی نامطلوب و رد شده است."],[159,"چونک غیب و غایب و روپوش به","پس لبان بر بند و لب خاموش به","هرگاه که سخن از غیب و چیزهایی که پنهان هستند به میان می‌آید، باید زبان را به سکوت بسپاریم و از سخن گفتن درباره آن‌ها خودداری کنیم."],[159,"ای برادر دست وادار از سخن","خود خدا پیدا کند علم لدن","ای برادر، دست از سخن بردار؛ خود خداوند می‌تواند از باطن و علم غیبی‌اش، دانشی به تو بدهد."],[159,"بس بود خورشید را رویش گواه","ای شیء اعظم الشاهد اله","خورشید به عنوان بزرگترین شاهد و نشانه، گواهی می‌دهد بر وجود پروردگار، ای حقیقت بزرگ."],[159,"نه بگویم چون قرین شد در بیان","هم خدا و هم ملک هم عالمان","نمی‌توانم بگویم که کدام یک از خدا، فرشتگان و عالمان در یک موضوع صحبت می‌کنند؛ زیرا این سه مقام بلند، همگی در ارتباط و نقش خود قرار دارند و همه به یک حقیقت اشاره می‌کنند."],[159,"یشهد الله و الملک و اهل العلوم","انّه لا ربّ الّا من یدوم","خدا، فرشتگان و دانشمندان گواهی می‌دهند که جز او که همیشه پایدار است، پروردگاری نیست."],[159,"چون گواهی داد حق، کی بد ملک؟","تا شود اندر گواهی مشترک","وقتی خدا شهادت می‌دهد، دیگر چه نیازی به گواهی فرشته (ملک) است؟ تا این‌گونه گواهی آن‌ها هم به شهادت خدا اضافه شود."],[159,"زانک شعشاع و حضور آفتاب","بر نتابد چشم و دلهای خراب","چنین است که چشمان و دل‌های فاسد نمی‌توانند نور و روشنایی آفتاب را تحمل کنند."],[159,"چون خفاشی کو تف خورشید را","بر نتابد بسکلد اومید را","مثل خفاش که نمی‌تواند نور خورشید را ببیند و از آن دوری می‌کند، کسی که دل خراب و کدر دارد، نمی‌تواند امید را بپذیرد و به آن رو کند."],[159,"پس ملایک را چو ما هم یار دان","جلوه‌گر خورشید را بر آسمان","فرشتگان را نیز، چون ما هم دوستان و یاوران خداوند بدانند و از روشنایی و نور خورشید الهی بر آسمان‌ها ظاهر می‌شوند."],[159,"کین ضیا ما ز آفتابی یافتیم","چون خلیفه بر ضعیفان تافتیم","این نور و روشنی که ما به آن دست یافتیم، مانند آفتاب است که بر ضعیفان می‌تابد و به آن‌ها قوت و قدرت می‌بخشد، مثل خلیفه‌ای که بر مردم ضعیف است."],[159,"چون مه نو یا سه روزه یا که بدر","هر ملک دارد کمال و نور و قدر","هر یک از این اجسام سماوی مانند هلال ماه یا ماه کامل و یا دیگر ستارگان در هر ملک و مملکت (مثلا انسان یا موجودات دیگر) ویژگی‌ها و کمالاتی دارند که به آنها نور و ارزش می‌بخشد."],[159,"ز اجنحه نور ثلاث او رباع","بر مراتب هر ملک را آن شعاع","از بال‌ها و پرهای نورانی سه‌گانه یا چهارگانه، بر پایه‌های هر ملک، آن نور و تابش وجود دارد."],[159,"همچو پرهای عقول انسیان","که بسی فرقستشان اندر میان","عقول انسان‌ها مانند پرهای پرندگان است که هر کدام به نوعی متفاوت‌اند و تفاوت‌های زیادی بین آن‌ها وجود دارد."],[159,"پس قرین هر بشر در نیک و بد","آن ملک باشد که مانندش بود","هر انسانی در نیک و بد به همدم و هم‌نوعی نیاز دارد که شبیه خودش باشد و در واقع، همان ملک یا روح ممکن است که با او همراه است."],[159,"چشم اعمش چونک خور را بر نتافت","اختر او را شمع شد تا ره بیافت","چشم نابینا (اعمش) چون نتوانست خورشید را ببیند، ستاره‌اش به مانند شمعی شد تا راهش را پیدا کند."],[160,"گفت پیغامبر که اصحابی نجوم","ره‌روان را شمع و شیطان را رجوم","پیامبر (ص) فرمود که دوستان من مانند ستاره‌های درخشان در آسمان هستند و راهنمایان خوبی برای رهروانند، اما شیطان مانند سنگی است که برای دور کردن مردم از مسیر حق قرار داده شده است."],[160,"هر کسی را گر بدی آن چشم و زور","کو گرفتی ز آفتاب چرخ نور","هر کسی اگر بدی ببیند، قدرت و نگاه او را از نور خورشید آسمان (حقایق روشن) گرفته‌ای."],[160,"کی ستاره حاجتستی ای ذلیل","که بدی بر نور خورشید او دلیل","ای ذلیل، چه زمانی می‌خواهی به ستاره‌ای که نیاز توست، برای خود دلیل بیاوری، در حالی که بدی تو خود نشان‌دهنده نور خورشید است؟"],[160,"ماه می‌گوید به خاک و ابر و فی","من بشر بودم ولی یوحی الی","ماه می‌گوید من از خاک و ابر به دنیا آمده‌ام، اما روحی از سماوات (آسمان) به من وحی می‌شود."],[160,"چون شما تاریک بودم در نهاد","وحی خورشیدم چنین نوری بداد","من وقتی که در وجودم تاریکی بود، وحی مانند خورشیدی در درونم نوری به من بخشید."],[160,"ظلمتی دارم به نسبت با شموس","نور دارم بهر ظلمات نفوس","من در مقایسه با خورشید، که نماد روشنی و آگاهی است، در تاریکی و جهل به سر می‌برم. اما از سوی دیگر، از طریق نیروی نورانی پیامبر، در دلم نوری دارم که می‌تواند بر تاریکی‌های جان انسان‌ها تأثیر بگذارد."],[160,"زان ضعیفم تا تو تابی آوری","که نه مرد آفتاب انوری","من به خاطر ضعف و ناتوانی‌ام از تو انتظار دارم که قوی‌تر و پرتوان‌تر شوی، چرا که من نمی‌توانم در برابر آفتاب روشنی تو مقاومت کنم."],[160,"همچو شهد و سرکه در هم بافتم","تا سوی رنج جگر ره یافتم","کنار هم قرار دادن شیرینی شهادت و تلخی غم، باعث شده که به رنج و زحمتی که بر جگر انسان است، دست یابم."],[160,"چون ز علت وا رهیدی ای رهین","سرکه را بگذار و می‌خور انگبین","وقتی از دلایل و عوامل رنج‌آور رها شدی، ای کسی که از دردهای زندگی آزاد شده‌ای، بهتر است سرکه را کنار بگذاری و به جای آن، عسل بخوری و لذت زندگی را تجربه کنی."],[160,"تخت دل معمور شد پاک از هوا","بین که الرحمن علی العرش استوی","دل انسان به‌طور کامل از هر نوع هوای نفس پاک و منزه شده است، زیرا گرمای محبت خداوند که بر عرش نشسته است، در این دل قرار گرفته است."],[160,"حکم بر دل بعد ازین بی واسطه","حق کند چون یافت دل این رابطه","بعد از این، حق به‌طور مستقیم بر دل فرمان می‌دهد، زیرا دل چنین ارتباطی را یافته است."],[160,"این سخن پایان ندارد زید کو","تا دهم پندش که رسوایی مجو","این سخن هرگز تمام نمی‌شود، زید، تو تا زمانی که این پند را به او برسانی، خود را رسوا نکن."],[161,"زید را اکنون نیابی کو گریخت","جست از صفّ نعال و نعل ریخت","زید را اکنون نمی‌توانی پیدا کنی، زیرا او از جمعیت فرار کرده و به دوری رفته است و مانند نعل‌هایی که از پا می‌افتند، از میان رفته و در صفاتی که به او نسبت داده شده، نشانی از او نیست."],[161,"تو که باشی زید هم خود را نیافت","همچو اختر که برو خورشید تافت","وقتی تو هم مثل زید خودت را گم کرده‌ای، مانند ستاره‌ای می‌مانی که در مقابل تابش خورشید، نورش ناپدید می‌شود."],[161,"نه ازو نقشی بیابی نه نشان","نه کهی یابی به راه کهکشان","تو از او هیچ نشانی نمی‌توانی بگیری و در این مسیر کهکشان هم نمی‌توانی او را پیدا کنی."],[161,"شد حواس و نطق باپایان ما","محو نور دانش سلطان ما","حس‌ها و گفتارهای ما که محدود و ناتمام است، در برابر نور و دانایی سلطان ما (خدا یا حقیقت) ناپدید و محو شده است."],[161,"حسها و عقلهاشان در درون","موج در موج لدینا محضرون","حس‌ها و عقل‌های آن‌ها در درون مثل امواج دریا در حضور ما قرار دارند."],[161,"چون بیاید صبح وقت بار شد","انجم پنهان شده بر کار شد","هنگامی که صبح فرا برسد، ستارگان پنهان می‌شوند و دوباره به کار خود مشغول می‌گردند."],[161,"بیهشان را وادهد حق هوشها","حلقه حلقه، حلقه‌ها در گوشها","خداوند با حکمت و تدبیر خود، به هر شخصی هوش و درک خاصی می‌دهد و این درک‌ها مانند حلقه‌هایی در گوش‌ها وجود دارند که به هم متصل‌اند."],[161,"پای‌کوبان دست‌افشان در ثنا","ناز نازان ربّنا احییتنا","افرادی با شادی و سرزندگی در حال دعا و تمجید هستند و با اظهار محبت و شکرگزاری، خدا را سراغ می‌گیرند و می‌گویند: «خداوندا، تو ما را زنده کردی."],[161,"آن جلود و آن عظام ریخته","فارسان گشته غبار انگیخته","حالت‌های بی‌حرکتی و اجزای بدن‌ای که بر زمین افتاده‌اند، به سوی زیبایی و شجاعت تبدیل شده‌اند و مانند گرد و غبار در حال پراکنده شدن‌اند."],[161,"حمله آرند از عدم سوی وجود","در قیامت هم شکور و هم کنود","در قیامت، افرادی از عدم به سوی وجود حمله‌ور می‌شوند که هم شکرگزار هستند و هم ناسپاس."],[161,"سر چه می‌پیچی کنی نادیده‌ای","در عدم ز اول نه سر پیچیده‌ای","چرا به سمت نادیده‌ای می‌پیچی، در حالی که از همان ابتدا در عدم (نیستی) بودی و نه در ظاهر پیچیده‌ای؟"],[161,"در عدم افشرده بودی پای خویش","که مرا کی برکند از جای خویش","در حالت عدم، پای خود را فشرده و محکم نگه داشته بودی، حالا که من چگونه می‌توانم تو را از این وضعیت ثابت خارج کنم؟"],[161,"می‌نبینی صنع ربّانیت را","که کشید او موی پیشانیت را","تو نمی‌بینی که خداوند چه آفرینشی کرده است، چرا که او موهای پیشانی‌ات را به سمت خود کشیده است."],[161,"تا کشیدت اندرین انواع حال","که نبودت در گمان و در خیال","خدای بزرگ تو را به گونه‌های مختلفی در حالات گوناگون کشانده است، حال آنکه خودت هیچ تصوری از این شرایط و اوضاع نداشتی و نمی‌توانستی آنها را در ذهن یا خیال خود تصور کنی."],[161,"آن عدم او را هماره بنده است","کار کن دیوا سلیمان زنده است","عدم (نیستی) همیشه تحت تسلط و کنترل آن «او» (خداوند) است. بنابراین، باید توجه کرد که دیو سلیمان (آن نیروی منفی و شیطانی) همچنان وجود دارد و زنده است و از این بعد به کارهایش ادامه می‌دهد."],[161,"دیو می‌سازد جفان کالجواب","زهره نه تا دفع گوید یا جواب","دیو، یعنی نیروی شر، به اوج قدرت و توانایی خود می‌رسد و ریشه‌های اسلام را تهدید می‌کند؛ او نمی‌خواهد به هیچ دلیلی پاسخگو باشد."],[161,"خویش را بین چون همی‌لرزی ز بیم","مر عدم را نیز لرزان دان مقیم","خودت را ببین که چگونه از ترس، می‌لرزی. بدان که عدم (یعنی نیستی یا مرگ) نیز همانند تو ترسناک است و باید بترسید."],[161,"ور تو دست اندر مناصب می‌زنی","هم ز ترس است آن که جانی می‌کنی","اگر تو به مقام‌ها و موقعیت‌ها دست پیدا می‌کنی، این کار نیز از روی ترس است که جانت را در معرض خطر قرار می‌دهی."],[161,"هرچه جز عشق خدای احسنست","گر شکرخواریست آن جان کندنست","هر چیزی که به جز عشق خداوند، که برترین نعمت است، باشد، اگر به نظر خوب و شیرین بیاید، در واقع مثله مرگ است و به معنای واقعی جان کندن است."],[161,"چیست جان کندن سوی مرگ آمدن","دست در آب حیاتی نازدن","کنار رفتن از زندگی و مرگ، شبیه جان کندن است و این که انسان به آب حیات نزدیک نشود، مثل این است که دستش را در آن آب نگذارد."],[161,"خلق را دو دیده در خاک و ممات","صد گمان دارند در آب حیات","انسان‌ها در زندگی با دو چشم به مشکلات و مرگ می‌نگرند و در این حال، نسبت به آب حیات (آب زندگی‌بخش و جاودانه) افکار و گمان‌های مختلفی دارند."],[161,"جهد کن تا صد گمان گردد نود","شب برو ور تو بخسپی شب رود","تلاش کن تا گمان‌هایت به صد برسد، زیرا اگر در نود شب تلاش کنی، در حقیقت، شب از دست خواهد رفت و تو بی‌نتیجه خواهی ماند."],[161,"در شب تاریک جوی آن روز را","پیش کن آن عقل ظلمت‌سوز را","در شب تاریک، تلاش کن که روز را جلو بیندازی و آن عقل و فکری که می‌تواند ظلمت را از بین ببرد، به کار بگیری."],[161,"در شب بدرنگ بس نیکی بود","آب حیوان جفت تاریکی بود","در شب سیاه و تیره، کارهای نیک و خوبی بسیار است، زیرا زندگی و حیات در دل این تاریکی نهفته است."],[161,"سر ز خفتن کی توان برداشتن","با چنین صد تخم غفلت کاشتن","چگونه می‌توان از خواب بیدار شد و به فکر برخاست وقتی که با کاشتن صد تخم غفلت در خواب به سر می‌بریم؟"],[161,"خواب‌مرده لقمه مرده یار شد","خواجه خفت و دزد شب بر کار شد","شخصی که در خواب است و غافل، به مانند لقمه‌ای مرده است که در اختیار یار (دوست یا معشوق) قرار می‌گیرد. در این حال، شخصی زمزمه شبانه را در حال دزدی یا فریب می‌بیند و در خواب غفلت به سر می‌برد."],[161,"تو نمی‌دانی که خصمانت کیند","ناریان خصم وجود خاکیند","تو نمی‌دانی که دشمنان چه کسانی هستند؛ آتش‌زنه‌های دشمن وجود انسان‌های مادی هستند."],[161,"نار خصم آب و فرزندان اوست","همچنانک آب خصم جان اوست","آتش دشمن آب و موجودات زنده‌ای است که از آب نشأت می‌گیرند، همان‌طور که آب دشمن جان و روح انسان است."],[161,"آب آتش را کشد زیرا که او","خصم فرزندان آبست و عدو","آب، آتش را خاموش می‌کند زیرا آتش دشمن فرزندان آب است و با آنها در تضاد است."],[161,"بعد از آن این نار نار شهوتست","کاندرو اصل گناه و زلتست","این نار، یعنی آتش شهوت، منشأ اصلی گناه و لغزش‌هاست."],[161,"نار بیرونی به آبی بفسرد","نار شهوت تا به دوزخ می‌برد","آتش شهوت مانند آتش بیرونی است که با آب خاموش می‌شود، اما این آتش باعث می‌شود انسان را به دوزخ ببرد و عذابش کند."],[161,"نار شهوت می‌نیارامد به آب","زانک دارد طبع دوزخ در عذاب","آتش شهوت با آب آرام نمی‌گیرد، زیرا طبیعت آن مانند آتش دوزخ است که در عذاب دائما شعله‌ور است."],[161,"نار شهوت را چه چاره نور دین","نورکم اطفاء نار الکافرین","نار شهوت، که به معنای آتش شهوت است، راهی جز نور دین و ایمان ندارد که آن را خاموش کند؛ ایمان می‌تواند آتش را، که مربوط به کافران است، خاموش کند."],[161,"چه کشد این نار را نور خدا","نور ابراهیم را ساز اوستا","این بیت به مفهوم این اشاره دارد که نور خدا و نور ابراهیم (پیامبر الهی) می‌تواند شعله‌های آتش شهوت و نفس را خاموش کند. به عبارتی، ایمان و نور الهی قدرت غلبه بر خواسته‌های نفسانی را دارند و می‌توانند انسان را از آتش گناه و وسوسه نجات دهند."],[161,"تا ز نار نفس چون نمرود تو","وا رهد این جسم همچون عود تو","اگر نفس‌ات، مانند نمرود که در برابر ابراهیم قرار داشت، از آتش حرص و شهوت رهایی یابد، این جسم تو نیز مانند چوب عود، به آسانی و بدون مشکل خواهد سوخت."],[161,"شهوت ناری به راندن کم نشد","او بماندن کم شود بی هیچ بد","میل و هوس مانند آتش است که با راندن و دور کردن کم نمی‌شود، بلکه با ماندن و تحمل کردن کاهش می‌یابد و بدون هیچ ضرری این کار انجام می‌شود."],[161,"تا که هیزم می‌نهی بر آتشی","کی بمیرد آتش از هیزم‌کشی","اگر هیزم به آتش بیفزایی، تا زمانی که هیزم در آن می‌افکنی، آتش نمی‌میرد."],[161,"چونک هیزم باز گیری نار مرد","زانک تقوی آب سوی نار برد","اگر هیزم را از آتش بگیری، آتش می‌میرد؛ چون تقوی مانند آبی است که آتش را خاموش می‌کند."],[161,"کی سیه گردد ز آتش روی خوب","کو نهد گلگونه از تقوی القلوب","کسی که چهره‌اش زیباست و با تقوای قلب خود، گلابی از عمل نیکو به دیگران می‌زند، هرگز زیر تأثیر آتش و غم نمی‌رود و چهره‌اش سیاه نمی‌شود."],[162,"آتشی افتاد در عهد عمر","همچو چوب خشک می‌خورد او حجر","در زمان خلافت عمر، آتش سوزی به وقوع پیوست. آتش به شدتی زیاد بود که سنگ ها مانند چوب خشک در این آتش شعله ور می شدند."],[162,"در فتاد اندر بنا و خانه‌ها","تا زد اندر پر مرغ و لانه‌ها","آتش به داخل ساختمان‌ها و خانه‌ها نفوذ کرد و به پرندگان و لانه‌هایشان آسیب رساند."],[162,"نیم شهر از شعله‌ها آتش گرفت","آب می‌ترسید از آن و می‌شکفت","شهر نیمه‌اش از آتش شعله‌ور شد به طوری که آب از ترس این آتش عقب‌نشینی کرد و به حرکت درآمد."],[162,"مشکهای آب و سرکه می‌زدند","بر سر آتش کسان هوشمند","افراد عاقل و با تدبیر برای مهار آتش، کیسه‌های آب و سرکه را بر روی آن می‌ریختند."],[162,"آتش از استیزه افزون می‌شدی","می‌رسید او را مدد از بی حدی","آتش از شدت شعله‌ور شدن بیشتر می‌شد و این کمک و یاری او ناشی از حد و اندازه‌ناپذیری بود."],[162,"خلق آمد جانب عمر شتاب","کآتش ما می‌نمیرد هیچ از آب","مردم به سمت عمر (عمر بن خطاب) شتابان آمدند، زیرا تاکید می‌کنند که آتش ما هیچ‌گاه با آب خاموش نمی‌شود."],[162,"گفت آن آتش ز آیات خداست","شعله‌ای از آتش بخل شماست","آن آتش ناشی از نشانه‌های خداوند است و شعله‌ای از آتش به خاطر بخل و خساست شماست."],[162,"آب و سرکه چیست نان قسمت کنید","بخل بگذارید اگر آل منید","آب و سرکه چیست که نسبت به آن سخاوت ورزید؟ اگر هم‌خانواده من هستید، بخل را کنار بگذارید و از نان خود تقسیم کنید."],[162,"خلق گفتندش که در بگشوده‌ایم","ما سخی و اهل فتوت بوده‌ایم","مردم به او گفتند که درها را به روی همگان باز کرده‌ایم و ما بخشنده و اهل جوانمردی هستیم."],[162,"گفت نان در رسم و عادت داده‌اید","دست از بهر خدا نگشاده‌اید","عمر (رضی الله عنه) به مردم می‌گوید که شما نان و غذا را به خاطر عادت و رسم به دیگران می‌دهید، نه به خاطر خداوند، و در واقع در این کار، نیت الهی ندارید."],[162,"بهر فخر و بهر بوش و بهر ناز","نه از برای ترس و تقوی و نیاز","این بیت بیان می‌کند که هدف از تزئین و خودنمایی در زندگی باید برای فخر، خودپسندی و لذت‌جویی باشد، نه به خاطر ترس از خدا یا نیاز به تقوا و عبادت."],[162,"مال تخمست و به هر شوره منه","تیغ را در دست هر ره‌زن مده","مال و دارایی تو همچون تخم است، آن را در هر خاکی نکار و تیغ را در دست هر دزد و راهزن نده."],[162,"اهل دین را باز دان از اهل کین","همنشین حق بجو با او نشین","اهل دین و ایمان را از اهل کینه و دشمنی جدا کن و در جمع کسانی که به حق می‌گروند، نشسته و هم‌نشینی کن."],[162,"هر کسی بر قوم خود ایثار کرد","کاغه پندارد که او خود کار کرد","هر کسی برای قوم و قبیله‌اش فداکاری و ایثار کند، فکر می‌کند که این کار را خودش انجام داده است."],[163,"از علی آموز اخلاص عمل","شیر حق را دان مطهّر از دغل","از علی (علی بن ابی‌طالب) بیاموز اخلاص در عمل را، چون او شیر حق است و از نیرنگ و فریب پاک و منزه است."],[163,"در غزا بر پهلوانی دست یافت","زود شمشیری بر آورد و شتافت","در میدان جنگ، به سرعت به پهلوانی نزدیک شد و شمشیری را بالا برد و به سمت او rushed."],[163,"او خدو انداخت در روی علی","افتخار هر نبیّ و هر ولی","دشمن بر صورت علی آب دهان انداخت.بر صورت آدمی که پیامبران به او افتخار میکردند"],[163,"آن خدو زد بر رخی که روی ماه","سجده آرد پیش او در سجده‌گاه","دشمن به صورت کسی خدشه وارد کرد که ماه به زیباییش سجده میکند"],[163,"در زمان انداخت شمشیر آن علی","کرد او اندر غزااش کاهلی","علی در آن هنگام شمشیرش را انداخت و در انجام عمل مقداری مکث نمود"],[163,"گشت حیران آن مبارز، زین عمل","وز نمودن عفو و رحمت بی‌محل","مبارز از این کار عجیبی که علی انجام داد و بخشش و رحمتی که به خرج داد، شگفت‌زده و متعجب شد، چون این کار در آن موقعیت جایگاهی نداشت."],[163,"گفت بر من تیغ تیز افراشتی","از چه افکندی مرا بگذاشتی؟","مبارز به علی (علیه‌السلام) می‌گوید: تو که شمشیر تند و تیزی را بر سر من نگه داشته بودی، چرا اکنون مرا رها کردی و به من توجهی نمی‌کنی؟"],[163,"آن چه دیدی بهتر از پیکار من؟","تا شدی تو سست در اشکار من","در باورخود چه کاری بهتر از پیکار و شکست من احساس کردی که در کشتن من مردد و سست شدی؟"],[163,"آن چه دیدی که چنین خشمت نشست","تا چنان برقی نمود و باز جست","تو چه دیدی که اینقدر خشمگین شدی و ناگهان مانند رعد و برق تابناک ظاهر شدی و دوباره ناپدید گشتی؟"],[163,"آن چه دیدی که مرا زان عکس دید","در دل و جان شعله‌ای آمد پدید","آنچه تو دیدی که من را از آن تصویر (یا آن حالت) در دل و جان، دچار شعله و炎 (آتش) کرد، چیست؟"],[163,"آن چه دیدی برتر از کون و مکان","که به از جان بود و بخشیدیم جان","آنچه تو دیدی، چیزی فراتر از جهان و مکان است که ارزشش از جان هم بیشتر است و ما این را به دیگران بخشیدیم."],[163,"در شجاعت شیر ربّانیستی","در مروّت خود که داند کیستی؟","شجاعت تو از شیر هم بیشتر است و فقط کسی که دارای فضیلت انسانی و مروت باشد، می‌تواند بداند که تو چه کسی هستی."],[163,"در مروّت، ابر موسیّی به تیه","کآمد از وی خوان و نان بی‌شبیه","در جوانمردی و مروّت (نیک‌رفتاری)، ابر موسی از بیابان به سرزمینی خشک و بی‌آب‌وعلف آمده که بر اثر آن، خوان برکت و نان بی‌مانند نازل می‌شود."],[163,"ابرها گندم دهد کان را بجهد","پخته و شیرین کند مردم چو شهد","ابرها گندم می‌دهند که مردم با آن نان پخته و شیرین درست کنند، مانند شهد که خوشمزه و مطلوب است."],[163,"ابر موسی پرّ رحمت برگشاد","پخته و شیرین بی زحمت بداد","ابر موسی (که به رحمت خداوند اشاره دارد) به مانند برکتی است که گندم پخته و شیرین را بدون زحمت به مردم عطا می‌کند."],[163,"از برای پخته‌خواران کرم","رحمتش افراخت در عالم علم","خداوند به خاطر انسان‌های با دانش و تجربه، رحمتی بزرگ را در جهان علم گسترش داده است."],[163,"تا چهل سال آن وظیفه و آن عطا","کم نشد یک روز زان اهل رجا","به مدت چهل سال، آن وظیفه و آن عطا که از جانب علی (علیه‌السلام) به مردم داده می‌شد، هیچگاه کم نشد و حتی یک روز هم از اهل امیدوار کاهش نیافت."],[163,"تا هم ایشان از خسیسی خاستند","گندنا و ترّه و خس خواستند","در دوره‌ای که مردم از راه خودخواهی و کم‌فکری دور شدند، به دنبال چیزهای بی‌ارزش و کم‌اهمیت مانند علف و سبزی‌های بی‌فایده افتادند."],[163,"امت احمد که هستید از کرام","تا قیامت هست باقی آن طعام","امت پیامبر احمد (ص) که به خاطر کرامت و بزرگی‌تان تا قیامت باقی می‌مانید، این غذای روحانی و معنوی، همیشه در دسترس شما خواهد بود."],[163,"چون ابیت عند ربّی فاش شد","یطعم و یسقی کنایت ز آش شد","زمانی که راز من، که در نزد پروردگارم هست، فاش شد، به معنای این است که او به من غذا و نوشیدنی می‌دهد؛ این به نوعی نشان‌دهنده حال و مقام من است."],[163,"هیچ بی‌تاویل این را درپذیر","تا درآید در گلو چون شهد و شیر","هیچ‌گاه نمی‌توان این مطالب را بدون تأویل پذیرفت، زیرا اگر بدون درک و فهم درست وارد جان شود، مانند شهد و شیر به‌راحتی گزیده نمی‌شود."],[163,"زانک تاویلست وا داد عطا","چونک بیند آن حقیقت را خطا","چون که حقیقتی را به درستی درک نکرده و خطا می‌بیند، تاویل آن چیز به نفهمی او برمی‌گردد. در واقع، بی‌توجهی به حقیقت باعث می‌شود که عطا و بخشندگی او نیز به اشتباه تفسیر شود."],[163,"آن خطا دیدن ز ضعف عقل اوست","عقل کل مغزست و عقل جزو پوست","خطا دیدن حقیقت به خاطر ضعف عقل فرد است، زیرا عقل کل همچون مغز است و عقل جزئی مانند پوسته، که درک واقعیات را محدود می‌کند."],[163,"خویش را تاویل کن نه اخبار را","مغز را بد گوی نه گلزار را","صفات و ویژگی‌های خودت را با تفسیر و معنای درست در نظر بگیر، نه اینکه به اخبار و روایت‌ها بسنده کنی. در مورد باطن و حقیقت چیزها قضاوت نادرست نکن و به زیبایی‌ها و سادگی‌ها توجه کن."],[163,"ای علی که جمله عقل و دیده‌ای","شمّه‌ای واگو از آنچ دیده‌ای","ای علی، تو نمونه کامل عقل و بینایی هستی؛ لطفا کمی از آنچه دیده‌ای را برای ما بگو."],[163,"تیغ حلمت جان ما را چاک کرد","آب علمت خاک ما را پاک کرد","شمشیر بردباری‌ات جان ما را به شکاف آورد و دانش تو خاک وجود ما را پاک کرد."],[163,"بازگو دانم که این اسرار هوست","زانک بی شمشیر کشتن کار اوست","می‌دانم که این اسرار ویژه وجود توست، زیرا تو بدون نیاز به شمشیر توانایی کشتن و نابود کردن داری."],[163,"صانع بی آلت و بی جارحه","واهب این هدیه‌های رابحه","خداوند، بدون نیاز به ابزار و اندام‌های فیزیکی، این نعمت‌های باارزش را به بندگانش عطا می‌کند."],[163,"صد هزاران می چشاند هوش را","که خبر نبود دو چشم و گوش را","مولانا می‌گوید که هزاران راه برای تجربه و دیدن حقایق وجود دارد که فراتر از توانایی‌های بصری و شنیداری انسان است. در اینجا به قدرت خداوند و آگاهی الهی اشاره دارد که از فهم معمول ما فراتر است."],[163,"باز گو ای باز عرش خوش‌شکار","تا چه دیدی این زمان از کردگار","ای پرنده‌ای که در آسمان‌های بلند به شکار می‌روی، به من بگو در این لحظه چه چیزی از خداوند دیده‌ای."],[163,"چشم تو ادراک غیب آموخته","چشمهای حاضران بردوخته","چشمان تو توانایی درک چیزهای پنهان و غیبی را پیدا کرده و چشمان بقیه افراد فقط به دیدن آنچه در برابرشان است، مشغول هستند."],[163,"آن یکی ماهی همی‌بیند عیان","وان یکی تاریک می‌بیند جهان","یکی از آن سه نفر (که یکی از آنها علی کرم الله وجهه است) می‌تواند عده‌ای را بی‌واسطه و واضح ببیند، در حالی که دیگری (شاید یک دشمن) دنیا را به صورت تاریک و ناواضح مشاهده می‌کند."],[163,"وان یکی سه ماه می‌بیند بهم","این سه کس بنشسته یک موضع نعم","یکی از این افراد، سه ماه را به هم متصل می‌بیند و این سه نفر در یک جا نشسته‌اند و از یکدیگر بهره‌مند می‌شوند."],[163,"چشم هر سه باز و گوش هر سه تیز","در تو آویزان و از من در گریز","چشمان هر سه نفر باز و گوش‌هایشان تیز است؛ آن‌ها به تو توجه دارند و از من دوری می‌کنند."],[163,"سحر عین است این عجب لطف خفیست","بر تو نقش گرگ و بر من یوسفیست","سحر، یعنی جادو، واقعیت را به گونه‌ای عجیب به تصویر می‌کشد؛ طوری که در نگاه تو، ظاهری زیبا و موجه وجود دارد، در حالی که در واقعیت، من مثل یوسف هستم و تو به شکل گرگ درآمده‌ای."],[163,"عالم ار هجده هزارست و فزون","هر نظر را نیست این هجده زبون","عالم اگر چه بسیار بزرگ و شامل هجده هزار دنیا و بیشتر است، اما هیچ یک از اینها در نظر من از بی‌ارزشی و ذلت بی‌بهره نیستند."],[163,"راز بگشا ای علی مرتضی","ای پس سؤ القضا حسن القضا","ای علی مرتضی، راز را برای ما بگشا؛ تو که نتیجه بدی‌ها و نداشته‌ها را به خوبی‌ها و خوبی‌ها تبدیل می‌کنی."],[163,"یا تو واگو آنچ عقلت یافتست","یا بگویم آنچ برمن تافتست","ای علی، یا آنچه که تو از حکمت و دانش به دست آورده‌ای را بیان کن، یا آنچه که بر من روشن شده را بگویم."],[163,"از تو بر من تافت چون داری نهان","می‌فشانی نور چون مه بی زبان","نور وجود تو به من می‌تابد و از آنجایی که تو پنهان‌کاری، این نور را بی‌زبان و بی‌صدا به من می‌رسی."],[163,"لیک اگر در گفت آید قرص ماه","شب روان را زودتر آرد به راه","اما اگر در سخن بگوید که ماه کامل شب تابان، زودتر کسی را به راه هدایت می‌کند."],[163,"از غلط ایمن شوند و از ذهول","بانگ مه غالب شود بر بانگ غول","آشفتگی‌ها و اشتباهات از بین می‌روند و زمانی که صدای ماه (معنای روشنایی و روشنی) بر صدای غول (معنای تاریکی و وحشت) غلبه کند، مردم در میان آن آرامش پیدا می‌کنند."],[163,"ماه بی گفتن چو باشد رهنما","چون بگوید شد ضیا اندر ضیا","وقتی که ماه بدون صحبت کردن نمایان باشد، مانند یک راهنماست، و زمانی که شروع به سخن گفتن کند، نورش در نور دیگر نیز منتشر می‌شود."],[163,"چون تو بابی آن مدینه علم را","چون شعاعی آفتاب حلم را","تو مثل دروازه‌ای هستی که به شهر دانش و علم راه می‌دهد، مانند پرتو نور آفتاب که نماد حلم و شکیبایی است."],[163,"باز باش ای باب بر جویای باب","تا رسد از تو قشور اندر لباب","ای درگاه علم و حکمت، برای کسانی که علم را جستجو می‌کنند باز بمان، تا از وجود تو معلومات و حقایق عمیق به آنها برسد."],[163,"باز باش ای باب رحمت تا ابد","بارگاه ما له کفوا احد","ای باب رحمت، همیشه باز باش تا اینکه هیچ‌کس از ما از هر نعمت و رحمت بی‌نصیب نماند."],[163,"هر هوا و ذره‌ای خود منظریست","نا گشاده کی گود کانجا دریست","هر نوعی از احساس یا ذره‌ای از وجود، نمایانگر دنیایی است که هنوز به آن دست نیافته‌ایم؛ هرگز فکر نکن که در اینجا، در این فضا، درب بسته‌ای وجود ندارد."],[163,"تا بنگشاید دری را دیدبان","در درون هرگز نجنبد این گمان","تا وقتی که دربی باز نشود، مراقب (دیدبان) درون هرگز این تصور را ترک نمی‌کند که در واقع در اینجا دری وجود دارد."],[163,"چون گشاده شد دری حیران شود","مرغ اومید و طمع پران شود","وقتی دری باز می‌شود، مرغ امید و آرزو شگفت‌زده می‌شود و از شادی پرواز می‌کند."],[163,"غافلی ناگه به ویران گنج یافت","سوی هر ویران از آن پس می‌شتافت","چنانچه شخصی غافل باشد و ناگهان گنجی در ویرانی پیدا کند، از آن پس به سمت هر ویرانی می‌رود تا گنجی بیابد."],[163,"تا ز درویشی نیابی تو گهر","کی گهر جویی ز درویشی دگر","تا وقتی که از مقام درویشی (پائین‌دستی و بی‌نیازی) چیزی نیابی، چگونه می‌توانی از درویشی دیگر گوهر و حقیقتی را جستجو کنی؟ در واقع، برای به دست آوردن ارزش و عمق معنوی، باید خود تجربه‌ای از درویشی یا تنگدستی داشته باشی."],[163,"سالها گر ظن دود با پای خویش","نگذرد ز اشکاف بینیهای خویش","اگر سال‌ها با فرض و گمان خود به دنبال چیزی باشی، اما واقعیت را با چشم خود نبینی، هیچ‌گاه به حقیقت دست نخواهی یافت و تنها در توهمات خود به سر خواهی برد."],[163,"تا ببینی نایدت از غیب بو","غیر بینی هیچ می‌بینی بگو","تا زمانی که از طرف غیب (خدا) چیزی به تو نرسد، هرچه می‌بینی از خودت است و واقعیت ندارد. پس هر چیزی که می‌بینی، به خودت نسبت بده."],[164,"پس بگفت آن نو مسلمان ولی","از سر مستی و لذت با علی","آن نو مسلمان مست و شاداب با لذت و خوشحالی این را به علی گفت."],[164,"که بفرما یا امیر المؤمنین","تا بجنبد جان بتن در چون جنین","از علی بن ابی‌طالب (علیه‌السلام) می‌خواهد که او، ای پیشوای مؤمنان، به او دستور دهد تا جانش در بدنش به جنبش درآید، مانند جنبش جنینی که در رحم دارد."],[164,"هفت اختر هر جنین را مدتی","می‌کنند ای جان به نوبت خدمتی","هر جنینی (جنین) در دوره‌ای هفت ستاره (اختر) را دارد که به نوبت و به مدت معینی به او خدمت می‌کنند و جان او را هدایت می‌کنند."],[164,"چونک وقت آید که جان گیرد جنین","آفتابش آن زمان گردد معین","زمانی که جنین جان می‌گیرد و به حیات می‌آید، آن زمان مشخص و معین می‌شود که نسبت به آفتاب و نیروی آن چه حالتی پیدا می‌کند."],[164,"این جنین در جنبش آید ز آفتاب","کآفتابش جان همی‌بخشد شتاب","این جنین به خاطر تابش آفتاب حرکت می‌کند، زیرا آفتاب به آن جان می‌بخشد و باعث سریع‌تر شدن آن می‌شود."],[164,"از دگر انجم به جز نقشی نیافت","این جنین تا آفتابش بر نتافت","این جنین (نوزاد) تا زمانی که آفتاب (نور و زندگی) به او نتابیده است، هیچ شکلی از ستاره‌های دیگر به خود نگرفته و یا به عبارتی دیگر، تنها تحت تأثیر نور آفتاب قرار می‌گیرد و بدون آن چیزی نیست."],[164,"از کدامین ره تعلق یافت او","در رحم با آفتاب خوب‌رو","این بیت به سوالی درباره اصل و منشأ وجود انسان اشاره دارد و می‌پرسد که چگونه این فرد که در رحم قرار دارد، به آفتاب زیبا و روشن تعلق یافته است. در واقع، شاعر به ارتباط و پیوند بین انسان و وجود مقدس و الهی اشاره می‌کند."],[164,"از ره پنهان که دور از حس ماست","آفتاب چرخ را بس راههاست","در این بیت گفته شده که راه‌های مختلفی برای رسیدن به حقیقت وجود دارد که ما از آن‌ها بی‌خبر هستیم و این راه‌ها به روش‌های پنهانی که احساسات ما قادر به درک آن‌ها نیستند، مرتبط می‌شوند. به این معنا که بخش‌هایی از دانش و آگاهی، فراتر از درک حسی ماست."],[164,"آن رهی که زر بیابد قوت ازو","و آن رهی که سنگ شد یاقوت ازو","مسیر و راهی که در آن طلا به قوت و قدرت می‌رسد و راهی که سنگ در آن به یاقوت تبدیل می‌شود."],[164,"آن رهی که سرخ سازد لعل را","وان رهی که برق بخشد نعل را","راهی که می‌تواند سنگ را به یاقوت تبدیل کند و می‌تواند لعل (جوهر سرخ) را سرخ‌تر کند، و همچنین می‌تواند نعل (زینت و سم اسب) را درخشندگی دهد، نشان‌دهنده قدرتی است که از آن بهره‌برداری می‌شود."],[164,"آن رهی که پخته سازد میوه را","و آن رهی که دل دهد کالیوه را","راهی که میوه را به موقع و خوب می‌سازد و راهی که دل را سرشار از عشق و محبت می‌کند."],[164,"بازگو ای باز پر افروخته","با شه و با ساعدش آموخته","ای پرنده باز که در آسمان پرواز می‌کنی، داستانی را بگو که چگونه با پادشاه و بازوی قوی‌اش آشنا شدی و این آشنایی به تو آموخته است."],[164,"باز گو ای باز عنقاگیر شاه","ای سپاه‌اشکن بخود نه با سپاه","ای عنقاگیر (پرنده‌ای افسانه‌ای) که به شاه و سپاه او تعلق داری، بگو بدون اینکه به سپاه خود تکیه کنی."],[164,"امت وحدی یکی و صد هزار","بازگو ای بنده بازت را شکار","ای بنده، برگرد و بگو که هر چند به ظاهری جدا به نظر می‌رسیم، در حقیقت همه ما یکی هستیم، حتی اگر به تعداد صد هزار نفر به نظر برسیم."],[164,"در محل قهر این رحمت ز چیست","اژدها را دست دادن راه کیست","در جایی که رحمت خداوند غیظ و خشم را کنترل می‌کند، دلیل چیست که اژدها (نماد شر و بزرگ‌ترین خطر) می‌تواند تسلیم شود و دست (سازش و صلح) بدهد و راهی برای نجات پیدا کند؟"],[165,"گفت من تیغ از پی حق می‌زنم","بنده حقم نه مامور تنم","او می‌گوید که من برای حق شمشیر می‌زنم و تنها به دنبال انجام وظیفه معنوی خود هستم، نه اینکه به خاطر بدن خود یا خواسته‌های دنیوی عمل کنم."],[165,"شیر حقم نیستم شیر هوا","فعل من بر دین من باشد گوا","من شیر حق نیستم، بلکه شیر نفس خودم هستم و اعمال من باید بر اساس دینم باشد تا معتبر باشد."],[165,"ما رمیت اذ رمیتم در حراب","من چو تیغم وان زننده آفتاب","شما زمانی که تیر می‌اندازید، در واقع من هستم که این کار را انجام می‌دهم، چون من مانند شمشیری هستم که آفتاب را می‌زنه."],[165,"رخت خود را من ز ره بر داشتم","غیر حق را من عدم انگاشتم","من از مسیر حق خود را کنار کشیدم و هر چیزی غیر از حق را به حساب نیآوردم."],[165,"سایه‌ای‌ام کدخداام آفتاب","حاجبم من نیستم او را حجاب","من مانند سایه‌ای هستم و وجودم مانند کدخداست که آفتاب (یعنی حقیقت یا خدا) را پنهان کرده است. من خودم حقیقت نیستم، بلکه فقط مانعی برای او هستم."],[165,"من چو تیغم پر گهرهای وصال","زنده گردانم نه کشته در قتال","من مانند شمشیری هستم که پر از جواهرات وصال و دوستی است. من باید زنده بمانم با عشق و محبت، نه اینکه در جنگ و نبرد کشته شوم."],[165,"خون نپوشد گوهر تیغ مرا","باد از جا کی برد میغ مرا","باد نمی‌تواند گوهر تیغ مرا بپوشاند و از جای خود حرکت کند؛ چون ابر نمی‌تواند مرا از ریشه‌ام جدا کند."],[165,"که نیم کوهم ز حلم و صبر و داد","کوه را کی در رباید تند باد","من نیمه‌کوهی از حلم، صبر و داد هستم و بر این باورم که کوه را نیز نمی‌تواند باد تند جابه‌جا کند."],[165,"آنک از بادی رود از جا خسیست","زانک باد ناموافق خود بسیست","کسی که از طوفان بادی به دور می‌رود، انسان ناتوان و بی‌ارزشی است، زیرا آن باد مخالف پرشمار و قوی است."],[165,"باد خشم و باد شهوت باد آز","برد او را که نبود اهل نماز","خشم، تمایلات نفسانی و آز و طمع، انسان را به سمت بعد پست و سطحی خود می‌کشاند و او را از حالت سجده و عبادت دور می‌سازد؛ به‌طوری که فرد اهل نماز و عبادت نمی‌شود."],[165,"کوهم و هستی من بنیاد اوست","ور شوم چون کاه بادم یاد اوست","من منبعی هستم که وجودم به خدا وابسته است و اگر بخواهم در برابر هیجانات منفی ضعیف شوم، یاد او به من قوت و ثبات می‌دهد."],[165,"جز به باد او نجنبد میل من","نیست جز عشق احد سرخیل من","جز از جانب او، هیچ چیز در من حرکت نمی‌کند و میل و خواسته‌ای ندارم. تنها عشق به «احد» (خدا) است که راهنمای من و رهبری‌کننده زندگی‌ام می‌باشد."],[165,"خشم بر شاهان شه و ما را غلام","خشم را هم بسته‌ام زیر لگام","من بر خشم شاهان و سلطنت، بندگی می‌کنم و این خشم را تحت کنترل خود نگه داشته‌ام."],[165,"تیغ حلمم گردن خشمم زدست","خشم حق بر من چو رحمت آمدست","تیغ بردباری من بر گردن خشمم قرار دارد و خشم حق بر من مانند رحمت نازل شده است."],[165,"غرق نورم گرچه سقفم شد خراب","روضه گشتم گرچه هستم بوتراب","اگرچه سقف و دیوارم خراب شده و شرایط خوبی ندارم، اما در نور محبت الهی غرق شده‌ام و روحا در بهشت و باغی روحانی قرار دارم، حتی اگر به ظاهر در وضعیت نامناسبی باشم."],[165,"چون در آمد علتی اندر غزا","تیغ را دیدم نهان کردن سزا","وقتی که علتی برای جنگ پیش آمد، دیدم که در آن لحظه پنهان کردن شمشیر کار درست و مناسبی نیست."],[165,"تا احب لله آید نام من","تا که ابغض لله آید کام من","اگر محبت من در راه خدا باشد، نام من (عزت و شهرت) برای او معتبر است، و اگر بغض من بنا به خدا باشد، خواسته‌ها و آرزوهای من نیز باید بر اساس رضایت او باشد."],[165,"تا که اعطا لله آید جود من","تا که امسک لله آید بود من","تا زمانی که بخشش من برای خدا باشد و من از خودخواهی و خساست دور باشم، وجود من در این حالت معنا دارد."],[165,"بخل من لله عطا لله و بس","جمله لله‌ام نیم من آن کس","من فقط به خاطر خداوند، ثروت و بخشش خود را برای او می‌بخشیدم و هیچ چیزی از خودم ندارم، بلکه همه‌چیز برای خداوند است و من هیچ کس نیستم."],[165,"وانچ لله می‌کنم تقلید نیست","نیست تخییل و گمان جز دید نیست","آنچه برای خدا انجام می‌دهم، تقلید و تقلید از دیگران نیست؛ این اعمالم خیالی و گمان نیست، بلکه کاملا عینی و واقعی است."],[165,"ز اجتهاد و از تحری رسته‌ام","آستین بر دامن حق بسته‌ام","از تلاش فکری و تلاش برای فهم درست راه خود را جدا کرده‌ام و اکنون دستم را به سوی حقیقت دراز کرده‌ام."],[165,"گر همی‌پرم همی‌بینم مطار","ور همی‌گردم همی‌بینم مدار","اگر به کمال پرواز می‌کنم، می‌بینم که در حال اوج‌گیری هستم، و اگر مدام در حال چرخش هستم، می‌بینم که در مدار خاصی قرار دارم."],[165,"ور کشم باری بدانم تا کجا","ماهم و خورشید پیشم پیشوا","اگر بار سنگینی را بر دوش بکشم، می‌دانم تا کجا می‌رسم؛ چرا که ماه و خورشید برای من راهنما هستند و مسیر را نشان می‌دهند."],[165,"بیش ازین با خلق گفتن روی نیست","بحر را گنجایی اندر جوی نیست","در اینجا مولانا می‌گوید که دیگر نمی‌توان به مردم بیشتر از این صحبت کرد، زیرا مانند این است که بخواهیم دریای وسیع را در یک جوی کوچک جا دهیم؛ چنین چیزی محال است."],[165,"پست می‌گویم به اندازه عقول","عیب نبود این بود کار رسول","من می‌گویم که از نظر عقلی، به اندازه درک و فهم مردم عیب و نقصی در این موضوع وجود ندارد و این کار از پیامبر (رسول) بوده است."],[165,"از غرض حرم گواهی حر شنو","که گواهی بندگان نه ارزد دو جو","از مقصد حرم، یعنی مکان مقدس کعبه، به حرم حر (مرد بزرگوار) گوش کن. بدان که گواهی بندگان (انسان‌ها) به اندازه دو جو (کم‌ارزش) هم ارزش ندارد."],[165,"در شریعت مر گواهی بنده را","نیست قدری وقت دعوی و قضا","در شریعت، گواهی بندگان ارزشی در زمان منازعه و قضاوت ندارد."],[165,"گر هزاران بنده باشندت گواه","بر نسنجد شرع ایشان را به کاه","اگر هزاران برده هم به عنوان شاهد بر تو گواهی دهند، شرع (قانون دین) اعتبار آنها را به اندازه یک دانه کاه هم نمی‌سنجد."],[165,"بنده شهوت بتر نزدیک حق","از غلام و بندگان مسترق","بنده‌ای که تحت تأثیر شهوات است، نزد خداوند از غلامان و بندگان آزاد شده کمتر ارزش دارد."],[165,"کین بیک لفظی شود از خواجه حر","وان زید شیرین میرد سخت مر","اگر بخواهیم با یک کلمه یا عبارت به شخصیتی خاص اشاره کنیم، حتی یک کلمه قوی و تاثیرگذار می‌تواند باعث تغییر بزرگی در احساسات یا رفتار افراد شود، مانند این‌که نام حر یا زید شیرین احساسات قوی و متفاوتی را بیان می‌کند."],[165,"بنده شهوت ندارد خود خلاص","جز به فضل ایزد و انعام خاص","انسانی که تسلیم خواسته‌های نفسانی و شهوت شده، نمی‌تواند از این وضعیت نجات یابد مگر با لطف و رحمت خداوند و بخشش خاص او."],[165,"در چهی افتاد کان را غور نیست","وان گناه اوست جبر و جور نیست","در چاهی افتاده که عمق آن مشخص نیست و این ناشی از گناه خود اوست، زیرا بر او زور و جبر وجود ندارد."],[165,"در چهی انداخت او خود را که من","درخور قعرش نمی‌یابم رسن","امیر المؤمنین (علی علیه‌السلام) به خاطر ترس و دلیری خود را در چاهی انداخت که به نظرش می‌رسید توانایی کشیدن خود را از عمق آن ندارد. در واقع، او فهمیده بود که در شرایط سخت و خطرناک نمی‌تواند به خود کمک کند."],[165,"بس کنم گر این سخن افزون شود","خود جگر چه بود که خارا خون شود","من از ادامه این بحث خودداری می‌کنم، زیرا وجود درد و رنج در دل‌ها، به اندازه کافی مشهود است و نیازی به توضیح بیشتر نیست."],[165,"این جگرها خون نشد نه از سختی است","غفلت و مشغولی و بدبختی است","اینکه جگرها به خون نمی‌نشینند، ناشی از سختی و آسیب نیست، بلکه به خاطر غفلت و مشغولیت و بدبختی است که انسان را از احساسات واقعی دور می‌کند."],[165,"خون شود روزی که خونش سود نیست","خون شو آن وقتی که خون مردود نیست","این بیت به این موضوع اشاره دارد که انسان باید در زمان مناسب و در شرایط درست تلاش کند و خون و جان خود را فدای هدفی کند که به آن ارزش می‌دهد. با این حال، اگر خونش مورد قبول و سودمند واقع نشود، نباید آن را فدای بیهوده کند. در واقع، عمل باید با هدف و نتیجه‌ای واقع‌نگرانه همراه باشد."],[165,"چون گواهی بندگان مقبول نیست","عدل او باشد که بنده غول نیست","وقتی شهادت بندگان (که در اینجا اشاره به انسان‌ها دارد) پذیرفته نمی‌شود، به همین دلیل است که عدالت او (خدا) ثابت می‌کند که بنده فقط تحت تاثیر هیولا و موجوداتی شرور نیست."],[165,"گشت ارسلناک شاهد در نذر","زانک بود از کون او حر بن حر","خداوند به پیامبرش نشانه‌ای فرستاد که او به خاطر نذر (تعهد) و اراده‌اش گواه می‌شود، زیرا حرّ که یکی از افراد مهم است، از وجود او (پیامبر) به وجود آمده است."],[165,"چونک حرم خشم کی بندد مرا","نیست اینجا جز صفات حق در آ","زمانی که خشم نمی‌تواند مرا محبوس کند، در اینجا جز ویژگی‌های الهی وجود ندارد."],[165,"اندر آ کآزاد کردت فضل حق","زانک رحمت داشت بر خشمش سبق","بیا در اینجا که فضل خدا تو را آزاد کرده، زیرا رحمتی که بر خشم خداوند مقدم است، می‌تواند تو را نجات دهد."],[165,"اندر آ اکنون که رستی از خطر","سنگ بودی کیمیا کردت گهر","اکنون که از خطر و دشواری رهایی یافته‌ای، مانند سنگی بوده‌ای که کیمیا، یعنی قیمتی کردنش، جواهرش را به تو داده است."],[165,"رسته‌ای از کفر و خارستان او","چون گلی بشکف به سروستان هو","از کفر و بی‌دینی آزاد شده‌ای و مانند گلی شکفته‌ای، در باغ معرفت و محبت رشد کرده‌ای."],[165,"تو منی و من توم ای محتشم","تو علی بودی علی را چون کشم","تو خود منی و من هم تو هستم، ای بزرگوار. تو علی هستی و من چگونه می‌توانم تو را بزنم؟"],[165,"معصیت کردی به از هر طاعتی","آسمان پیموده‌ای در ساعتی","ارتکاب به گناه بهتر از انجام هر عبادتی است، چرا که در یک لحظه می‌توانی به آسمان و حقیقت دست یابی."],[165,"بس خجسته معصیت کان کرد مرد","نه ز خاری بر دمد اوراق ورد","این مرد، معصیتی انجام داده که بسیار خوش‌یمن است، زیرا از پرچم و نشانه‌ای که به بهشت منتهی می‌شود، برگی تازه به وجود آورده است."],[165,"نه گناه عمر و قصد رسول","می‌کشیدش تا بدرگاه قبول","نه گناه عمر (صحابه پیامبر) و نه قصد (سوء نیت) رسول (محمد) او را نمی‌کشت، بلکه دلایل دیگری باعث می‌شد که حوادث خاصی پیش آید و مورد قبول خداوند قرار گیرد."],[165,"نه بسحر ساحران فرعونشان","می‌کشید و گشت دولت عونشان","سحر ساحران فرعون، باعث نشده که قدرت و سلطنت آنها، یعنی عون و یارانش، کم شود. این نشان می‌دهد که موفقیت عون به دلیل استفاده از جادوی ساحران نیست بلکه به دلایل دیگر است."],[165,"گر نبودی سحرشان و آن جحود","کی کشیدیشان به فرعون عنود","اگر سحر ساحران و نادانی آنها نبود، چگونه می‌توانستند این قوم را به فرعون ستمگر بکشند؟"],[165,"کی بدیدندی عصا و معجزات","معصیت طاعت شد ای قوم عصات","چگونه می‌توانستند عصا و معجزات را ببینند، ولی معصیت و نافرمانی را به جای طاعت و بندگی انتخاب کنند، ای گروه نافرمان؟"],[165,"ناامیدی را خدا گردن زدست","چون گنه مانند طاعت آمدست","خدا ناامیدی را از بین برده است، زیرا گناه همچون طاعت (کار نیک) به نظر می‌رسد."],[165,"چون مبدل می‌کند او سیئات","طاعتی‌اش می‌کند رغم وشات","خداوند گناهان انسان را به خوبی‌ها تبدیل می‌کند، اما در عین حال، انسان باید از خداوند به خاطر اعمالش پرهیز کند و به او روی آورد."],[165,"زین شود مرجوم شیطان رجیم","وز حسد او بطرقد گردد دو نیم","از این حادثه، شرّ شیطان رانده شده و به خاطر حسادت او، قلب‌های مردم از دو نیم می‌شود و به تفرقه می‌افتند."],[165,"او بکوشد تا گناهی پرورد","زان گنه ما را به چاهی آورد","شیطان تلاش می‌کند تا انسان را به گناهی بیفکند و به خاطر همان گناه، ما را در دامی گرفتار کند."],[165,"چون ببیند کان گنه شد طاعتی","گردد او را نامبارک ساعتی","وقتی کسی ببیند که گناهش به نوعی تبدیل به اطاعت و فرمانبرداری می‌شود، در آن لحظه به نظرش می‌رسد که این تغییر، خوشایند و مبارک نیست."],[165,"اندر آ من در گشادم مر ترا","تف زدی و تحفه دادم مر ترا","من در را به روی تو باز می‌کنم، تو که به من بی‌احترامی کردی و من هنوز به تو هدیه‌ای داده‌ام."],[165,"مر جفاگر را چنینها می‌دهم","پیش پای چپ چه سان سر می‌نهم","من به کسی که جفا کرده، این چیزها را می‌دهم، اما با این حال، سر تعظیم نمی‌زنم."],[165,"پس وفاگر را چه بخشم تو بدان","گنجها و ملکهای جاودان","به کسی که وفادار و درستکار است، چه پاداشی دهم که شایسته او باشد، چون گنج‌ها و ملکه‌های ابدی کم نیستند."],[166,"من چنان مردم که بر خونی خویش","نوش لطف من نشد در قهر نیش","من به حدی از اخلاق و انسانیت رسیده‌ام که بر درد و مصیبت خود، اثر خوشایندی نداشته و در هنگام خشم و قهرم، دیگران را مورد لطف و رحمت قرار نمی‌دهم."],[166,"گفت پیغامبر به گوش چاکرم","کو برد روزی ز گردن این سرم","پیامبر (صلی الله علیه و سلم) به گوش خدمتکار و چاکر علی (علی علیه‌السلام) گفت که روزی کسی که این سر را از گردن خواهد برید، نفرین و عذاب خواهد آورد."],[166,"کرد آگه آن رسول از وحی دوست","که هلاکم عاقبت بر دست اوست","پیامبر خدا از سوی خداوند به من خبر داد که سرنوشت من در نهایت به دست او خواهد بود و من در این راه هلاک می‌شوم."],[166,"او همی‌گوید بکش پیشین مرا","تا نیاید از من این منکر خطا","پیامبر (ص) می‌گوید که علی (ع) باید مرا بکشد تا از من (نظریه یا گناهی) پیش نیاید که بعدها به عنوان خطا شناخته شود."],[166,"من همی‌گویم چو مرگ من ز تست","با قضا من چون توانم حیله جست","من می‌گویم، اگر مرگ من به دست تو باشد، با تقدیر الهی دیگر چگونه می‌توانم در برابر آن تدبیر و فریب بزنم؟"],[166,"او همی‌افتد به پیشم کای کریم","مر مرا کن از برای حق دو نیم","علی (کرار) به من نزدیک می‌شود و می‌گوید: ای بزرگوار، به خاطر حق، من را به دو قسمت تقسیم کن."],[166,"تا نه آید بر من این انجام بد","تا نسوزد جان من بر جان خود","هرگز نباید به چنین سرنوشتی دچار شوم، تا زمانی که جان من به جان خودم آسیب نرساند."],[166,"من همی گویم برو جف القلم","زان قلم بس سرنگون گردد علم","من می‌گویم برو، قلم را ببر، چرا که این قلم (یعنی قسمت حکمت یا علم) از شدت غم به زودی فرومی‌افتد و ناتوان می‌شود."],[166,"هیچ بغضی نیست در جانم ز تو","زانک این را من نمی‌دانم ز تو","من از تو هیچ کینه و دشنی در دل ندارم، چون نمی‌دانم که این احساسات من نسبت به تو چیست و از کجا ناشی می‌شود."],[166,"آلت حقی تو فاعل دست حق","چون زنم بر آلت حق طعن و دق","تو وسیله‌ای برای اجرای اراده خدا هستی. وقتی که به وسیله‌ای که برای حق قرار داده شده، آسیب می‌زنم یا عیب می‌گذارم، در واقع به اراده‌ی خدا هم لطمه می‌زنم."],[166,"گفت او پس آن قصاص از بهر چیست","گفت هم از حق و آن سر خفیست","پیامبر به علی (کرم الله وجهه) می‌گوید که چرا قصد قصاص داری، علی پاسخ می‌دهد که این عمل هم از سوی حق است و دلیل آن پنهان است."],[166,"گر کند بر فعل خود او اعتراض","ز اعتراض خود برویاند ریاض","اگر او بر عمل خود اعتراضی کند، این اعتراضش باعث می‌شود که از دلش زراعت و به دست آوردن خوب و خالصی بیرون آید."],[166,"اعتراض او را رسد بر فعل خود","زانک در قهرست و در لطف او احد","اگر او بر کار خود اعتراضی داشته باشد، این اعتراض فقط به خود او می‌رسد چون در قهر و لطف خداوند هیچ کس را یاری نیست."],[166,"اندرین شهر حوادث میر اوست","در ممالک مالک تدبیر اوست","در این شهر، رخدادها و حوادث به دست او مدیریت می‌شود و در سرزمین‌ها، حکمرانی و تدبیر امور به عهده اوست."],[166,"آلت خود را اگر او بشکند","آن شکسته گشته را نیکو کند","اگر خداوند آلت و ابزار تو را بشکند، او همان ابزار شکسته را به خوبی و زیبایی بازسازی خواهد کرد."],[166,"رمز ننسخ آیة او ننسها","نات خیرا در عقب می‌دان مها","پیامبر (ص) می‌فرماید که رمزی در آیه‌ای وجود دارد که اگر او (علی) را نادیده بگیریم، خیر و نیکی همراه او به نسل‌های بعدی خواهد آمد."],[166,"هر شریعت را که حق منسوخ کرد","او گیا برد و عوض آورد ورد","هر دینی که خداوند آن را از اعتبار خارج کرد، جای آن دینی دیگر با احکام جدید می‌آورد."],[166,"شب کند منسوخ شغل روز را","بین جمادی خرد افروز را","شب که به پایان می‌رسد، کار روز روشن می‌شود و از آن زمان به بعد، خرد و اندیشه در دل جمادی (گویا اشاره به گیاهان و موجودات زنده دیگر) شکوفا می‌شود."],[166,"باز شب منسوخ شد از نور روز","تا جمادی سوخت زان آتش‌فروز","شب به تدریج به پایان می‌رسد و نور روز می‌تابد؛ تا اینکه در لباس جدید خود، یعنی فصل زمستان (جمادی)، از گرمای این نور تغذیه می‌شود و جان می‌گیرد."],[166,"گرچه ظلمت آمد آن نوم و سبات","نه درون ظلمتست آب حیات","هرچند ظلمت و خواب و سستی به انسان رو آورده، در این تاریکی نیز آب حیات و زندگی نهفته است و انسان نباید ناامید شود."],[166,"نه در آن ظلمت خردها تازه شد","سکته‌ای سرمایه آوازه شد","در آن تاریکی، خردها و اندیشه‌ها تازه نمی‌شوند و دچار سکون و ناراحتی می‌گردند، به طوری که به تنها چیزی که می‌ماند، افسانه و نام و آوازه تبدیل می‌شود."],[166,"که ز ضدها ضدها آمد پدید","در سویدا روشنایی آفرید","از تضادها و مخالفت‌ها چیزهای جدیدی به وجود می‌آید و در میان تاریکی، روشنایی ایجاد می‌شود."],[166,"جنگ پیغامبر مدار صلح شد","صلح این آخر زمان زان جنگ بد","جنگ پیامبر به خاطر صلح پایان یافت، زیرا در این زمان آخر (زمانه‌ی ظهور) به خاطر حقایق و پیامدهای جنگ، صلحی به دست آمده که نتیجه آن از جنگ بهتر است."],[166,"صد هزاران سر برید آن دلستان","تا امان یابد سر اهل جهان","صد هزاران نفر زیبا و دلربا در جنگ کشته شدند تا دیگران از خطر رهایی یابند و جانشان در امان بماند."],[166,"باغبان زان می‌برد شاخ مضر","تا بیابد نخل قامتها و بر","باغبان برای این که شاخ‌های مضر خود را قطع کند، اقدام می‌کند تا بتواند درختان نخل که قامت بلند و زیبا دارند را به دست آورد."],[166,"می‌کند از باغ دانا آن حشیش","تا نماید باغ و میوه خرمیش","باغبان با دانش و آگاهی، علف‌های هرز را از باغ می‌کند تا باغی سرسبز و میوه‌دار به وجود آورد."],[166,"می‌کند دندان بد را آن طبیب","تا رهد از درد و بیماری حبیب","طبیب (پزشک) بدی را که دندان دارد، می‌کشد تا آن دوستی که در درد و بیماری است، از رنج خلاص شده و بهبود یابد."],[166,"پس زیادتها درون نقصهاست","مر شهیدان را حیات اندر فناست","در واقع، درون نقصان‌ها و کمبودها، زیادتی و فزونی وجود دارد؛ یعنی شهیدان در حقیقت با مرگشان حیات و زندگی را تجربه می‌کنند."],[166,"چون بریده گشت حلق رزق‌خوار","یرزقون فرحین شد گوار","زمانی که حلق (گلو) موجودات را که برای رزق و روزی می‌خورند، بریده می‌شود، روح آن‌ها آزاد می‌شود و به زندگی شاداب‌تر و خوش‌حال‌تری دست می‌یابد."],[166,"حلق حیوان چون بریده شد بعدل","حلق انسان رست و افزونید فضل","زمانی که حلق (گردن) حیوانی بریده می‌شود، فضیلت و برتری انسان نیز بعد از آن به خوبی ظاهر می‌شود و افزون می‌گردد."],[166,"حلق انسان چون ببرد هین ببین","تا چه زاید کن قیاس آن برین","وقتی که گردن انسان را بشکنی، نگاه کن ببین چه نتیجه‌ای به بار خواهد آورد و آن را با گردن حیوان مقایسه کن."],[166,"حلق ثالث زاید و تیمار او","شربت حق باشد و انوار او","حلق سوم، که به معنای ظرف یا حالت روحانی است، از وجود حق می‌نوشد و پر از نورهای الهی است."],[166,"حلق ببریده خورد شربت ولی","حلق از لا رسته مرده در بلی","اگر حلق بریده شود، نوشیدن شربت ولی (ولی به معنی دوست و حامی، اشاره به علی) هم نمی‌تواند جان را زنده کند، زیرا حلق به معنای زندگی و حیات، از بین رفته و نمی‌تواند به آن بازگردد."],[166,"بس کن ای دون‌همت کوته‌بنان","تا کیت باشد حیات جان به نان","ای انسان بی‌هدف و کم‌مایه، دیگر بس کن؛ تا کی می‌خواهی تنها به زندگی روزمره و نان خوش بگذران؟ زندگی‌ات به همین امور محدود نخواهد ماند."],[166,"زان نداری میوه‌ای مانند بید","کآبرو بردی پی نان سپید","تو مانند درخت بید میوه‌ای نداری، زیرا آبرویت را به دنبال نان سفید (نان حلال و معیشت) برده‌ای."],[166,"گر ندارد صبر زین نان جان حس","کیمیا را گیر و زر گردان تو مس","اگر صبر بر این نان و روزی نداشته باشی، جان خود را به کیمیا تبدیل کن و مثل زر طلا باش، نه اینکه خود را به مس بیارایی."],[166,"جامه‌شویی کرد خواهی ای فلان","رو مگردان از محله گازران","اگر برایت مقدور است، به شست‌وشوی لباس بپرداز و از محله گازران دور نشو، زیرا افرادی در آن محل مشغول به کار هستند که می‌توانند از تو کمک بگیرند."],[166,"گرچه نان بشکست مر روزه ترا","در شکسته‌بند پیچ و برتر آ","اگرچه در روزه‌ات اشکالی پیش آمده و نانت شکسته است، اما باید به شکسته‌بند اعتماد کنی و او را بالاتر از خودت ببینی."],[166,"چون شکسته‌بند آمد دست او","پس رفو باشد یقین اشکست او","وقتی که شخصی که کار رفو کردن (شکسته‌بند) آمده و کار او را انجام می‌دهد، پس مشخص است که آن دست شکسته (یا آسیب‌دیده) دیگر رفو خواهد شد و قابل ترمیم است."],[166,"گر تو آن را بشکنی گوید بیا","تو درستش کن نداری دست و پا","اگر تو چیزی را بشکنی، آن چیز به تو می‌گوید که بیا و آن را اصلاح کن، زیرا تو توانایی و آزادی لازم را برای اصلاح آن نداری."],[166,"پس شکستن حق او باشد که او","مر شکسته گشته را داند رفو","شکستن حق دیگران باعث می‌شود که خود فرد در حقیقت در حال شکسته شدن باشد، زیرا کسی که چنین کاری می‌کند، نمی‌تواند مشکلات و آسیب‌های ناشی از آن را درک کند و فقط کسی که در آن موقعیت است، می‌تواند او را ترمیم کند."],[166,"آنک داند دوخت او داند درید","هر چه را بفروخت نیکوتر خرید","کسی که به خوبی می‌داند چطور چیزی را بدوزد، همچنین می‌داند چطور آن را پاره کند. بنابراین، هر چیزی را که می‌فروشد، با دقت و درایت بیشتری خریداری می‌کند."],[166,"خانه را ویران کند زیر و زبر","پس بیک ساعت کند معمورتر","خانه را ویران کند و به هم بریزد، اما پس از مدتی کوتاه، آن را دوباره آبادتر از قبل می‌کند."],[166,"گر یکی سر را ببرد از بدن","صد هزاران سر بر آرد در زمن","اگر کسی یک سر را از بدن جدا کند، در یک لحظه صدها هزار سر دیگر نیز به وجود خواهند آمد."],[166,"گر نفرمودی قصاصی بر جنات","یا نگفتی فی القصاص آمد حیات","اگر تو درباره مجازات (قصاص) بر درختان بهار (جنات) سخنی نمی‌گفتی یا اینکه نمی‌گفتی در قصاص (مجازات)، زندگی تازه‌ای (حیات) وجود دارد، زندگی چگونه ادامه می‌یافت؟"],[166,"خود که را زهره بدی تا او ز خود","بر اسیر حکم حق تیغی زند","هیچ‌کس را جرأت نمی‌دهد تا به واسطه خود، به یک شخص اسیر حکم مرگ صادر کند؛ زیرا این کار تنها به دست خداوند است که حق را اجرا می‌کند و هیچ انسانی نمی‌تواند به خودش اجازه دهد چنین کاری کند."],[166,"زانک داند هر که چشمش را گشود","کان کشنده سخره تقدیر بود","هر کسی که چشمش را به واقعیت باز کند، می‌داند که آن کس که کشته می‌شود، به خواست و اراده تقدیر و سرنوشت به این سرنوشت دچار شده است."],[166,"هر که را آن حکم بر سر آمدی","بر سر فرزند هم تیغی زدی","هر کسی که سرنوشتش به این گونه رقم بخورد، بر فرزند خودش نیز شمشیری می‌زند، یعنی اگر تقدیر او را به خطری بیندازد، ممکن است حتی به خود نزدیک‌ترین افرادش نیز آسیب بزند."],[166,"رو بترس و طعنه کم زن بر بدان","پیش دام حکم عجز خود بدان","از عاقبت کار بدکاران بترس و کمتر بر آن‌ها طعنه بزن، زیرا که دست خود را در دام حکمت و عجز خویش گیر کرده‌ای."],[167,"چشم آدم بر بلیسی کو شقی‌ست","از حقارت وز زیافت بنگریست","حضرت آدم حقارت و فرومایگی ابلیس رو دید"],[167,"خویش‌بینی کرد و آمد خودگزین","خنده زد بر کار ابلیس لعین","در اون لحظه با خودبینی و از دید «من برترم» به ابلیس نگاه میکرد.( حال آنکه این دید در اصل دید ابلیسی هست که حضرت میفرمایند: که «انا خیری» دم شیطانی است.)"],[167,"بانگ بر زد غیرت حق کای صفی","تو نمی‌دانی ز اسرار خفی","همان لحظه خداوند به آدم ایراد گرفت که: ای کسی که صافی شدی و روی خودت کار کردی و به صفات من زنده شدی، تو از اسرار پنهان چیزی نمیدانی"],[167,"پوستین را بازگونه گر کند","کوه را از بیخ و از بن برکند","اون چیزهایی که در ذهنت بعنوان خوب و بد میشناسی، بعنوان خیر و شر می‌شناسی و اون دانسته های ذهنی تو مثل کوه سفت و سخته و بشدت باور داری، در یک لحظه می‌تونه زیر و زبر بشه( پس با این عقاید متزلزل نمی‌خواد کسی رو قضاوت کنی)"],[167,"پرده صد آدم آن دم بر درد","صد بلیس نو مسلمان آورد","صد (نماد کثرت) تا مثل حضرت آدم در یک لحظه میتونن به گمراهی سقوط کنند و صد تا ابلیس تسلیم حضرت حق بشن."],[167,"گفت آدم توبه کردم زین نظر","این چنین گستاخ نندیشم دگر","حضرت آدم متوجه شد که با این نوع دیدن داره به خودش صدمه می‌زنه و از این نوع اندیشه و قضاوت که دست‌مایه ش خود برتر بینی بود، توبه کرد"],[167,"یا غیاث المستغیثین اهدنا","لا افتخار بالعلوم و الغنی","رو به خدا میگه: ای فریادرس ما را هدایت کن( همه تیره من همه انسانها را) ما را هدایت کن که به داشته‌ها و دانسته‌های خودمون افتخار نکنیم و اگر عقلی و علمی و ثروتی به دست آوردیم از پشت عینک اونها به دیگران از دید «من برترم» ننگریم."],[167,"لا تزغ قلبا هدیت بالکرم","واصرف السؤ الذی خط القلم","قلبی را که با کرم و بخششت هدایت یکبار کردی بار دیگر تنگ و تیره مگردان و از این دل در برابر قضا و قدر محافظت کن.6060"],[167,"بگذران از جان ما سؤ القضا","وامبر ما را ز اخوان صفا","تقدیرهای بد را از ما دور کن و از اهل صفا (کسانیکه روی خودشان کار میکنند و صافی دل شده‌اند) خودت را دریغ نکن"],[167,"تلخ‌تر از فرقت تو هیچ نیست","بی پناهت غیر پیچاپیچ نیست","هیچ چیزی در این دنیا تلخ تر از این نیست که تو خودت را دریغ کنی و وقتی پناه تو نباشه تمام امور شبیه یک هزار‌توی درد و رنجه حتی اگه به ظاهر خوشایند باشه"],[167,"رخت ما هم رخت ما را راه‌زن","جسم ما مر جان ما را جامه کن","(وقتی حضور تو نباشه) هر چه که داریم راه ما رو میزنه و حتی جسم ما روی جان مارو میپوشونه.(حجاب جان ما میشه)"],[167,"دست ما چون پای ما را می‌خورد","بی امان تو کسی جان چون برد","(وقتی تو نباشی)ما با انتخاب‌های غلط خودمون به خودمون آسیب میزنیم. اگر تو پناه ما نباشی نمی‌تونیم جان سالم به در ببریم"],[167,"ور برد جان زین خطرهای عظیم","برده باشد مایه ادبار و بیم","اگر هم جان سالم به در ببریم و مثلا نود سال عمر کنیم چه عمری می‌کنیم؟نود سال درد و رنج انباشته که نشد جان سالم به در بردن"],[167,"زانک جان چون واصل جانان نبود","تا ابد با خویش کورست و کبود","جانی که به تو وصل نباشه و از صفات تو صافی نشده باشه، تا ابد در کور و کبوده( از شدت کوری دایما خودش رو به در و دیوار می‌کوبه و درد می‌کشه و کبود میشه)"],[167,"چون تو ندهی راه جان خود برده گیر","جان که بی تو زنده باشد مرده گیر","اگر تو راه را نشان ندی، جان بردن و زنده بودن بی‌معنی میشه."],[167,"گر تو طعنه می‌زنی بر بندگان","مر ترا آن می‌رسد ای کامران","طعنه زدن و قضاوت کردن دیگران به تو رواست و به ما ناروا."],[167,"ور تو ماه و مهر را گویی جفا","ور تو قد سرو را گویی دوتا","تو می‌تونی دیگران رو به دیده کوچکی ببینی (ما نمی‌تونیم)"],[167,"ور تو چرخ و عرش را خوانی حقیر","ور تو کان و بحر را گویی فقیر","تو میتونی به نسبت بزرگی خودت هر چیزی رو به دیده کوچکی ببینی"],[167,"آن به نسبت با کمال تو رواست","ملک اکمال فناها مر تراست","هر چیزی در برابر کمال تو ناقصه و کامل کردنش هم فقط از تو برمیاد"],[167,"که تو پاکی از خطر وز نیستی","نیستان را موجد و مغنیستی","چرا که به تو آسیبی نمی‌رسه و درمان هر آسیبی و تو نیست نمیشی و درمان هر نیست هستی(نیستها بوجود می‌آورد و استغنا می‌بخشد)"],[167,"آنک رویانید داند سوختن","زانک چون بدرید داند دوختن","آن که بوجود میاره بلده نیست کنه و آنکه میپراکنه بلده جمع کنه(فقط خدا می‌تونه کسی رو که خودش رو با ذهن یکی گرفته دوباره جمع کنه در وحدت)"],[167,"می‌بسوزد هر خزان مر باغ را","باز رویاند گل صباغ را","باغ رو در پاییز (انسان رو در ذهن) خشک می‌کنه. و دوباره باغ رو با گل‌های رنگارنگ (انسان رو در حضور) زنده می‌کنه."],[167,"کای بسوزیده برون آ تازه شو","بار دیگر خوب و خوب‌آوازه شو","که ای خشک و سوزان شده در ذهن (خطاب به انسان) که هر لحظه داری با افکارت خودت را می‌سوزانی و خشک میکنی تورا من مثل یک دانه در ذهن کاشتم حالا بیا بیرون وقت روییدن و شهرت یافتنه تو در تمام کائنات مشهور هستی. بیا بیرون ، رشد کن و از حالت فکر پشت فکر بیرون بیا"],[167,"چشم نرگس کور شد بازش بساخت","حلق نی ببرید و بازش خود نواخت","عادت کردی با این چشم ذهنی دنیا رو ببینی و به خوب و بد قضاوت کنی هر لحظه این حالت نهایی تو نیست. خالی شو تا من تو را بنوازم."],[167,"ما چو مصنوعیم و صانع نیستیم","جز زبون و جز که قانع نیستیم","ما انسانها در ذهن قدرت خلق کردن داریم اگر از ذهن بعنوان ابزار استفاده کنیم اما متاسفانه خودمون رو با ذهن اشتباه گرفتیم و به همین دید کوته بین قناعت کردیم.تا زمانیکه در چنین حالتی هستیم حقیر خواهیم بود."],[167,"ما همه نفسی و نفسی می‌زنیم","گر نخواهی ما همه آهرمنیم","از این حقیر شدنه که ما منم منم میکنیم و به داشته‌ها و دانسته‌های ذهنی خودمون افتخار میکنیم و در یک مسابقه من بهترم با دیگران شرکت داریم(ماشین من بهتره /خونه من بهتره/ دانش من بهتره /عرفان من بهتره و ....)و تا تو نخواهی در همین اهریمنی من باقی هستیم"],[167,"زان ز آهرمن رهیدستیم ما","که خریدی جان ما را از عمی","از این حالت اگر ما رها شدیم(کسانی مثل مولانا) بخاطر اینکه خودمون بلد بودیم و دانش به دست آوردیم و عبادت کردیم و امثالهم نیست، بخاطر اینه که تو چشم ما را باز کردی و به ما دیده ‌ای دادی سبب سوراخ کن تا حجب را بکنیم از بیخ و بن."],[167,"تو عصاکش هر کرا که زندگیست","بی عصا و بی عصاکش کور چیست","اگر یک کور نه عصا داشته باشه و نه عصا کش دقیقا چه حالتی داره؟ ما بی تو همون حالتیم، تو بیا و عصای ما رو بکش ما نمی‌بینیم چرا که در ذهن کور شدیم و خودمون رو کامل و عاقل میدانیم."],[167,"غیر تو هر چه خوشست و ناخوشست","آدمی سوزست و عین آتشست","کل وجه ما سوی الله باطل. به غیر از تو هرچه که با این حالت کوری میبینیم و خوب و بد مینامیم مثلا ازدواج رو خوب می‌دونیم و مرگ تن رو بد و امثالهم ، در اصل همه باطله چون ما کورین در نتیجه از همه اینها در نهایت درد گیرمون میاد."],[167,"هر که را آتش پناه و پشت شد","هم مجوسی گشت و هم زردشت شد","این سبک زندگی جز درد هیچ چیزی به ارمغان نمیاره"],[167,"کل شیء ما خلا الله باطل","ان فضل الله غیم هاطل","بدون بودن در حالت حضور (بدون حضور خدا) هر چیزی باطله و بودن در این حالت چیزی نیست که بتونیم به دست بیاریم، بلکه به واسطه فضل و کرم اوست و ما فقط میتونیم روی خودمون کار کنیم تا از این صفات فعلی خودمون رو در معرض صفات الهی قرار بدیم. مثلا شاهد خشم و حرص و حسد در خودمان باشیم و سعی و تلاش غیر ذهنی در اطراف این پدیده‌ها کنیم برای رهایی اما فقط به فضل او امید ببندیم."],[168,"باز رو سوی علی و خونیش","وان کرم با خونی و افزونیش","به سوی علی (ع) و خونی که به او تعلق دارد برمی‌گردم و به خوبی او با وجود این خون و احسان‌های بیشترش توجه می‌کنم."],[168,"گفت دشمن را همی‌بینم به چشم","روز و شب بر وی ندارم هیچ خشم","علی (ع) می‌گوید که هر روز و شب دشمن را می‌بینم و با وجود این، هیچ احساس خشم و کینه‌ای نسبت به او ندارم."],[168,"زانک مرگم همچو من خوش آمدست","مرگ من در بعث چنگ اندر زدست","مرگ برای من به اندازه‌ای دلپذیر است که گویی خودم آن را انتخاب کرده‌ام و در روز قیامت برایم جذابیت خاصی خواهد داشت."],[168,"مرگ بی مرگی بود ما را حلال","برگ بی برگی بود ما را نوال","مرگ برای ما به معنای عدم وجود بود و بی‌برگی برای ما نبودن حقیقی یا نداشتن چیزی را به ارمغان آورد."],[168,"ظاهرش مرگ و به باطن زندگی","ظاهرش ابتر نهان پایندگی","ظاهر این چهره، مرگ است، اما در باطن، زندگی وجود دارد؛ آنچه به نظر ناتمام و بی‌ثمر می‌آید، در حقیقت نشانه‌ای از ادامه و پایندگی است."],[168,"در رحم زادن جنین را رفتنست","در جهان او را ز نو بشکفتنست","جنین در رحم به دنیا آمدن و رشد کردنش در جهان، به معنای تولد دوباره و شکفتن تازه‌ای است."],[168,"چون مرا سوی اجل عشق و هواست","نهی لا تلقوا بایدیکم مراست","چون به سوی مرگ می‌روم، عشق و تمایلات زندگی مرا بخود کشانده‌اند؛ پس، دسیسه و نهی (مانند نهی از چیزی) در مورد من هم وجود دارد."],[168,"زانک نهی از دانه شیرین بود","تلخ را خود نهی حاجت کی شود","چون نهی از دانه شیرین، به معنای اجتناب از تلخی است، بنابراین اگر از چیزی که تلخ است بپرهیزیم، دیگر نیازی به توجیه وجود آن نداریم."],[168,"دانه‌ای کش تلخ باشد مغز و پوست","تلخی و مکروهیش خود نهی اوست","دانه‌ای که پوسته‌اش تلخ و ناگوار است، در واقع خود این تلخی و بدی، مسبب این است که از آن دانه دوری کنیم."],[168,"دانه مردن مرا شیرین شدست","بل هم احیاء پی من آمدست","مرگ من مانند دانه‌ای که به شیرینی می‌رسد، شده است، زیرا از پس مرگ من زندگی و حیات جدیدی به وجود آمده است."],[168,"اقتلونی یا ثقاتی لائما","ان فی قتلی حیاتی دائما","ای دوستان، اگر می‌خواهید مرا بکشید، مرا بکشید، چرا که در قتل من زندگی پایدار و همیشگی من نهفته است."],[168,"ان فی موتی حیاتی یا فتی","کم افارق موطنی حتی متی","ای جوان، در مرگ من زندگی نهفته است؛ تا کی باید سرزمین مادری‌ام را ترک کنم و دور باشم؟"],[168,"فرقتی لو لم تکن فی ذا السکون","لم یقل انا الیه راجعون","اگر جدایی و فرقتی در این سکون وجود نداشت، دیگر نمی‌گفتند که به سوی او بازمی‌گردیم."],[168,"راجع آن باشد که باز آید به شهر","سوی وحدت آید از تفریق دهر","موضوع این بیت این است که انسان باید به سرنخ بازگشت به جایی که وحدت و یگانگی وجود دارد، برسد و از جداافتادگی و تفرقه‌ای که در زندگی ایجاد شده است، عبور کند. به عبارت دیگر، غایت اصلی این است که انسان به وحدت در عالم برگردد."],[169,"باز آمد کای علی زودم بکش","تا نبینم آن دم و وقت ترش","شخصی به علی (ع) مراجعه می‌کند و از او می‌خواهد که هر چه سریع‌تر او را بکشند تا در آن لحظه‌ی سخت و ترش (دشواری) مراسم رستاخیز را نبیند."],[169,"من حلالت می‌کنم خونم بریز","تا نبیند چشم من آن رستخیز","من تو را از خون خودم معاف می‌کنم، فقط خونم را بریز تا چشمانم آن روز ترسناک را نبیند."],[169,"گفتم ار هر ذره‌ای خونی شود","خنجر اندر کف به قصد تو رود","گفتم اگر هر قطره‌ای خون من ریخته شود، خنجر به سمت تو برمی‌گردد تا به تو آسیب بزند."],[169,"یک سر مو از تو نتواند برید","چون قلم بر تو چنان خطی کشید","هیچ کس نمی‌تواند حتی یک تار موی تو را قطع کند، چرا که تو چنان اثری در دل‌ها و جان‌ها گذاشته‌ای که مثل یک خط روشن بر کاغذ است."],[169,"لیک بی غم شو شفیع تو منم","خواجه روحم نه مملوک تنم","اما نگران نباش، من شفیع تو هستم. من آقایی هستم که روح من متعلق به توست و نه تنم که در دنیا به آن وابسته‌ام."],[169,"پیش من این تن ندارد قیمتی","بی تن خویشم فتی ابن الفتی","این بدن من برای من ارزشی ندارد و من با روح و وجود خودم هستم که شایستگی و ارزش را دارم. \"ابن الفتی\" به معنی فرزند جوانمردی است که به جنبه‌های روحانی و معنوی اشاره دارد."],[169,"خنجر و شمشیر شد ریحان من","مرگ من شد بزم و نرگسدان من","من در دل جنگ و مبارزه، مرگ را همچون گل و بزم خوشبو می‌بینم. مرگ برای من مانند گل نرگس است و به جای ترس از آن، به زیبایی و شیرینی‌اش توجه دارم."],[169,"آنک او تن را بدین سان پی کند","حرص میری و خلافت کی کند","آنکه به این شکل به بدن خود می‌رسد، حرص بر ریاست و خلافت دارد."],[169,"زان به ظاهر کو شد اندر جاه و حکم","تا امیران را نماید راه و حکم","آن کسی که به ظاهر در مقام و قدرت قرار گرفته است، برای امیران طریق و روش هدایت را نمایان می‌سازد."],[169,"تا امیری را دهد جانی دگر","تا دهد نخل خلافت را ثمر","تا به امیری دیگر جان تازه‌ای دهد و تا میوه‌ای عالی به درخت خلافت ببخشد."],[170,"جهد پیغامبر به فتح مکه هم","کی بود در حب دنیا متهم","سعی و تلاش پیامبر برای فتح مکه به خاطر دوستی با دنیا و مال و مقام نبود، بلکه هدف والاتری داشت."],[170,"آنک او از مخزن هفت آسمان","چشم و دل بر بست روز امتحان","پیامبر (مصطفی صلی الله علیه و سلم) در روز امتحان، چشمانش را از شوق به زیبایی‌های آسمانی و دلش را از دنیا و ریا برشته است."],[170,"از پی نظاره او حور و جان","پر شده آفاق هر هفت آسمان","عاشق دیدار او، آسمان‌ها مملو از روح و زیبایی شده‌اند و این زیبایی به خاطر محبت اوست."],[170,"خویشتن آراسته از بهر او","خود ورا پروای غیر دوست کو","انسان باید خود را برای محبوبش، یعنی خدا، زینت و آراسته کند و نباید نگران نظرات و خواسته‌های دیگران باشد."],[170,"آنچنان پر گشته از اجلال حق","که درو هم ره نیابد آل حق","او (پیامبر اسلام) به قدری از عظمت و احترام خداوند پر شده که حتی کسانی که به درستی و حق تعلق دارند، نمی‌توانند به او نزدیک شوند."],[170,"لا یسع فینا نبی مرسل","والملک و الروح ایضا فاعقلوا","در این بیت، مولانا به این نکته اشاره می‌کند که در وجود ما جای پیامبری مانند محمد (صلی‌الله‌علیه‌وآله) و نیز روح القدس که درک آن بسیار بزرگ و والاست، وجود ندارد. بنابراین، متوجه باشید که ما انسان‌ها از درک کامل حقیقت الهی ناتوانیم."],[170,"گفت مازاغیم همچون زاغ نه","مست صباغیم مست باغ نه","ما زاغ: منحرف نشدگان، فعل منفی عربی. گفت ما منحرف نشده‌ایم، و همانند زاغ در باغ نیستیم که مست رنگ‌هاست، ما در باغ خوشحال نیستیم. - بازی با کلمات زاغ در عربی و فارسی"],[170,"چونک مخزن‌های افلاک و عقول","چون خسی آمد بر چشم رسول","چون دانش و نعمت‌های آسمانی در برابر چشمان پیامبر (محمد) مانند دانه‌های ریز خاک و ناچیز بود."],[170,"پس چه باشد مکه و شام و عراق","که نماید او نبرد و اشتیاق","پس چه اهمیتی دارد مکه و شام و عراق، اگر او (پیامبر اسلام) خود را در برقراری جنگ و اشتیاق به این مکان‌ها نشان نمی‌دهد؟"],[170,"آن گمان بر وی ضمیر بد کند","کو قیاس از جهل و حرص خود کند","کسی که به اشتباه بر پیامبر (مصطفی صلی الله علیه و سلم) گمان بدی می‌برد، به خاطر جهل و طمع خود چنین تصوری دارد."],[170,"آبگینه زرد چون سازی نقاب","زرد بینی جمله نور آفتاب","اگر شیشه‌ای زرد رنگ درست کنی، در آن نقابی زرد می‌بینی که تمام نور آفتاب را به خود می‌گیرد."],[170,"بشکن آن شیشه کبود و زرد را","تا شناسی گرد را و مرد را","شیشه کبود و زرد نماد دیدگاه‌های مادی و دنیوی است که باعث می‌شود حقیقت را نتوانیم به‌خوبی ببینیم. با شکستن این شیشه، می‌توانیم واقعیت را بهتر بشناسیم و درک کنیم که افرادی که به‌دنبال اهداف راستین و معنوی هستند، واقعی‌تر از ظواهر دنیوی‌اند."],[170,"گرد فارس گرد سر افراشته","گرد را تو مرد حق پنداشته","این بیت به تمایز میان ظاهری و باطنی اشاره دارد. گرد و غبار (معادل با فرس و زینت‌های ظاهری) را به دلیل تجمل و زیبایی آن نمی‌توان حقیقت پنداشت، بلکه مرد واقعی را باید در معنای درونی و باطنش جستجو کرد."],[170,"گرد دید ابلیس و گفت این فرع طین","چون فزاید بر من آتش‌جبین","ابلیس که در اینجا نماد شر و دشمنی است، به فرع طین (مخلوقی که از گل و خاک ساخته شده) نگاه می‌کند و می‌گوید چگونه این موجود (انسان) که از خاک و گل است، می‌تواند قدرت و جلالی بهتر از من (که از آتش هستم) پیدا کند."],[170,"تا تو می‌بینی عزیزان را بشر","دانک میراث بلیس‌ست آن نظر","تو وقتی عزیزان و محبوبان را می‌بینی، باید بدانید که این محبت و دوستی در واقع میراث ابلیس است، زیرا او از این نگاه به دنیا راضی است و در مقام فریب انسان‌هاست."],[170,"گر نه فرزندی‌، بلیسی ای عنید","پس به تو میراث آن سگ چون رسید","اگر تو فرزندی از بلایای شیطانی نیستی، پس ارث تو چه خواهد بود؟ به تو فقط ارث آن سگ می‌رسد."],[170,"من نیم سگ‌، شیر حقم حق‌پرست","شیر حق آنست کز صورت برست","من انسان نیستم که فقط به دنبال خواسته‌های دنیوی باشم، بلکه در جستجوی حقیقت و معنای واقعی هستم. شیر حق، نماد معنویت و کمال است که از ظواهر دنیوی فراتر می‌رود."],[170,"شیر دنیا جوید اشکاری و برگ","شیر مولی جوید آزادی و مرگ","شیر دنیا (که به دنبال قدرت و مال دنیاست) در ظاهر به دنبال مقام و نشانه‌های ظاهری است، اما شیر حقیقی که مولای واقعی است، به دنبال آزادگی و رهایی از قید و بند دنیا و مرگ است."],[170,"چونک اندر مرگ بیند صد وجود","همچو پروانه بسوزاند وجود","هنگامی که انسان در مرگ و فنا، صد وجود را می‌بیند، مانند پروانه‌ای می‌شود که برای نور عشق می‌سوزد و از میان می‌رود."],[170,"شد هوای مرگ طوق صادقان","که جهودان را بد این دم امتحان","مرگ برای صادقان (راستگویان) مانند گردنبندی است زیبا و ارزشمند، اما یهودیان (جهودان) در این زمان در حال آزمون و آزمایش هستند و مرگ را تهدیدی می‌دانند."],[170,"در نبی فرمود کای قوم یهود","صادقان را مرگ باشد گنج و سود","پیامبر در گفتاری به یهودیان می‌فرماید که مرگ برای صادقان خیر و برکت است و به نوعی برای آنها مانند گنجی ارزشمند به حساب می‌آید."],[170,"همچنانک آرزوی سود هست","آرزوی مرگ بردن زان بهست","آرزوی سود و ثروت برای انسان طبیعی است، اما آرزوی مرگ برای او برتر و حقیقی‌تر از این است."],[170,"ای جهودان بهر ناموس کسان","بگذرانید این تمنا بر زبان","ای یهودیان، به خاطر احترام و آبروی خانواده‌ها، این خواسته را از زبان خود بگذرانید و بر زبان نیاورید."],[170,"یک جهودی این قدر زهره نداشت","چون محمد این علم را بر فراشت","یک یهودی به اندازه‌ای شجاعت نداشت که مانند محمد (ص) این علم و پیام را به انحاء مختلف منتشر کند."],[170,"گفت اگر رانید این را بر زبان","یک یهودی خود نماند در جهان","اگر یهودی آنچه را که محمد (صلی الله علیه و سلم) فرمود به زبان بیاورد، نخواهد توانست این حرف را در دنیا به خاطر بسپارد و نگه دارد."],[170,"پس یهودان مال بردند و خراج","که مکن رسوا تو ما را ای سراج","یهودیان اموال و خراج‌هایی را از مکه برداشتند و از تو می‌خواهند که ما را رسوا نکن، ای روشنگر (سراج)."],[170,"این سخن را نیست پایانی پدید","دست با من ده چو چشمت دوست دید","این سخن هیچ‌گاه تمام نمی‌شود و همواره ادامه دارد، پس دستت را به من بده تا به چشمان دوست تو نگاه کنم و از آن طریق ارتباط برقرار کنیم."],[171,"گفت امیر المؤمنین با آن جوان","که به هنگام نبرد ای پهلوان","امیر المؤمنین به جوانی که با او می‌جنگید، گفت: در زمان نبرد ای پهلوان!"],[171,"چون خدو انداختی در روی من","نفس جنبید و تبه شد خوی من","وقتی که با نگاه خود بر من خیره شدی، نفس من به تشویش افتاد و شخصیت واقعی‌ام از بین رفت."],[171,"نیم بهر حق شد و نیمی هوا","شرکت اندر کار حق نبود روا","نصف کارها برای خدا و نیم دیگر برای هوای نفس، موجب می‌شود که کار حق خالص نباشد و این برای انجام کارهای الهی مناسب نیست."],[171,"تو نگاریده کف مولیستی","آن حقی کرده من نیستی","تو زیبا و نقش بسته در دستان مولا (علی) هستی، اما عمل و کارهای حقیقتا نیکو از آن من نیست."],[171,"نقش حق را هم به امر حق شکن","بر زجاجه دوست سنگ دوست زن","نقش حق یعنی نشانه‌های الهی را به اذن و اجازه خداوند بشکن و در مقابل کسی که دوستش داری، همچون سنگ بر شیشه‌اش بیفکن. این اشاره به این دارد که گاهی باید با قاطعیت و بدون تردید برای محبت و دوستی خود اقدام کرد."],[171,"گبر این بشنید و نوری شد پدید","در دل او تا که زناری برید","گبر (یعنی کافر زرتشتی) این را شنید و نوری در دلش پدید آمد تا اینکه گناهش را ترک کرد و از آن جدا شد."],[171,"گفت من تخم جفا می‌کاشتم","من ترا نوعی دگر پنداشتم","گفت: من در دل خود حس نکوهش و بدی می‌کاشتیم و تو را به نوعی دیگر می‌دیدم و فکر می‌کردم."],[171,"تو ترازوی احدخو بوده‌ای","بل زبانه هر ترازو بوده‌ای","تو معیار و سنجشی از خصوصیات انسان‌های با فضیلت هستی و نه تنها استانداردی برای سنجش، بلکه خودت به تنهایی معیار سنجش آنها هستی."],[171,"تو تبار و اصل و خویشم بوده‌ای","تو فروغ شمع کیشم بوده‌ای","تو نژاد و اصل من بوده‌ای و نور و روشنی چراغ وجود من بوده‌ای."],[171,"من غلام آن چراغ چشم‌جو","که چراغت روشنی پذرفت ازو","من بنده‌ی آن چراغی هستم که ánh روشنی تو از آن کسب می‌شود."],[171,"من غلام موج آن دریای نور","که چنین گوهر بر آرد در ظهور","من در برابر دریا و امواج آن، که نور و روشنایی را به خود می‌گیرد و باعث ظهور جواهرات گرانبها می‌شود، فرزند و خدمتگزار آن هستم."],[171,"عرضه کن بر من شهادت را که من","مر ترا دیدم سرافراز زمن","شهادت بده که من تو را به حالتی با ارزش و سرافراز دیدم."],[171,"قرب پنجه کس ز خویش و قوم او","عاشقانه سوی دین کردند رو","عزیزان فردی که به او تعلق خاطر دارند، با عشق به دین روی آورده و از خویشاوندان و قوم و قبیله‌ی خود فاصله گرفته‌اند."],[171,"او به تیغ حلم چندین حلق را","وا خرید از تیغ و چندین خلق را","علی (ع) با کمال بردباری و گذشت خود، انسان‌های زیادی را از راه ظلم و کشتار نجات داد و با نرم‌خویی، جان افراد بسیاری را حفظ کرد."],[171,"تیغ حلم از تیغ آهن تیزتر","بل ز صد لشکر ظفر انگیزتر","تیغ حلم، که به معنای بردباری و صبوری است، از تیغ آهن تیزتر و برنده‌تر است و حتی از صد لشکری که پیروزی می‌آورند، مؤثرتر و قوی‌تر است."],[171,"ای دریغا لقمه‌ای دو خورده شد","جوشش فکرت از آن افسرده شد","ای کاش لقمه‌ای دو تا خورده می‌شد، وگرنه اندیشه و تفکر من به خاطر این افسردگی دچار رکود و سستی شده است."],[171,"گندمی خورشید آدم را کسوف","چون ذنب شعشاع بدری را خسوف","شخصیت آدم (علیه‌السلام) مانند گندمی است که در نور خورشید (هدایت و مقام او) می‌درخشد، اما مثل خسوف (تاریکی و پنهان شدن نور) وقتی که به کسوف (محجوب شدن نور خورشید) دچار می‌شود."],[171,"اینت لطف دل که از یک مشت گل","ماه او چون می‌شود پروین‌گسل","این لطف دل شبیه به یک مشت گل است که باعث می‌شود درخشش چهره‌اش (ماهی او) مانند ستاره پروین (پروین‌گسل) گردد."],[171,"نان چو معنی بود خوردش سود بود","چونک صورت گشت انگیزد جحود","اگر نان حقیقتا معنایی داشته باشد و از آن جوهره بهره ببرد، خوردن آن مفید است؛ اما وقتی فقط به صورت و ظاهری تبدیل شود، انسان را به انکار و کفر می‌کشاند."],[171,"همچو خار سبز کاشتر می‌خورد","زان خورش صد نفع و لذت می‌برد","چون خار سبز، کاشتر (کیسه دوستی و محبت) را می‌خورد، از آن خورش، صد فایده و لذت می‌برد."],[171,"چونک آن سبزیش رفت و خشک گشت","چون همان را می‌خورد اشتر ز دشت","زمانی که آن سبز (سبزی و تازگی) از بین رفت و خشک شد، هرچند دیگر آن را نمی‌خورد، اما همچنان الاغ (اشتر) از دشت می‌چرد."],[171,"می‌دراند کام و لنجش ای دریغ","کانچنان ورد مربی گشت تیغ","کسی که می‌خواهد به معنای واقعی چیزها دست یابد، به خوبی می‌فهمد که آنچه در دل و نیت اوست، می‌تواند به ظاهری چنان برنده و خطرناک تبدیل شود که به راحتی جان او را بگیرد."],[171,"نان چو معنی بود، بود آن خار سبز","چونک صورت شد کنون خشکست و گبز","اگر نان به معنای واقعی‌اش باشد، آن‌گاه مانند خار سبز خواهد بود؛ چون اکنون که فقط ظاهری از آن مانده، خشک و بی‌مزه شده است."],[171,"تو بدان عادت که او را پیش ازین","خورده بودی ای وجود نازنین","تو به عادت این وجود نازنین که پیش از این خورده بودی اشاره کن."],[171,"بر همان بو می‌خوری این خشک را","بعد از آن کامیخت معنی با ثری","تو همان‌طور که در گذشته از زهر یا خشکیده‌ای تغذیه کرده‌ای، اکنون هم همچنان به همان چیزها روی می‌آوری، در حالیکه معنای واقعی زندگی با بلندی و پرباری (همچون ثریا) فرسنگ‌ها فاصله دارد."],[171,"گشت خاک‌آمیز و خشک و گوشت‌بر","زان گیاه اکنون بپرهیز ای شتر","مقصود این است که اگر گیاهی که در خاک خشک و آغشته به گرد و غبار عمیق شده، رشد کرده، باید از آن دوری کنی، ای شتر. این به‌نوعی هشدار به شتر است که از چیزهایی که در شرایط نامناسب رشد می‌کنند، دوری کند."],[171,"سخت خاک‌آلود می‌آید سخن","آب تیره شد سر چه بند کن","سخن به شدت آغشته به حقیقت‌های دنیوی و غبارآلود شده است، مثل آب تیره که دیگر قابل نوشیدن نیست؛ بنابراین باید به آن بی‌توجهی کرد و از آن دوری جست."],[171,"تا خدایش باز صاف و خوش کند","او که تیره کرد هم صافش کند","خداوند که روح و دل انسان را از تیره‌کامگی و مشکلات پاک و شفاف می‌کند، همان‌طور که او را به آن حال بد مبتلا کرده، می‌تواند دوباره به حالت خوب و روشن بازگرداند."],[171,"صبر آرد آرزو را نه شتاب","صبر کن والله اعلم بالصواب","آرزو برای به دست آوردن چیزی نیاز به صبر دارد و نباید در آن شتاب زد. صبر کن که خداوند بهتر از هر کس می‌داند چه چیزی درست و مناسب است."],[172,"مدتی این مثنوی تأخیر شد","مهلتی بایست تا خون شیر شد","مدتی این مثنوی به تاخیر افتاد، فرصتی لازم بود که خون به شیر بدل شود"],[172,"تا نزاید بخت تو فرزند نو","خون نگردد شیر‌ شیرین‌، خوش شنو","خوب گوش کن، تا بخت تو فرزند جدیدی به دنیا نیاورد، خون به شیر بدل نمیشود"],[172,"چون ضیاء‌الحق حسام‌الدین عنان","باز گردانید ز اوج آسمان","چون ضیاء الحق حسام الدین چلپی از اوج آسمان عنان بازگردانید"],[172,"چون به معراج حقایق رفته بود","بی‌بهارش غنچه‌ها ناکفته بود","چون به معراج حقایق الهی رفته بود، بی بهار وجود او غنچه ها ناشکفته مانده بود"],[172,"چون ز دریا سوی ساحل بازگشت","چنگ شعر مثنوی با‌ساز گشت","چون از دریا به ساحل برگشت، چنگ شعر مثنوی سامان گرفت (کوک شد)"],[172,"مثنوی که صیقل ارواح بود","بازگشتش روز استفتاح بود","مثنوی که ارواح را جلا میداد، روز پانزدهم رجب دوباره آغاز شد"],[172,"مطلع تاریخ این سودا و سود","سال اندر ششصد و شصت و دو بود","آغاز تاریخ این کار و بار در سال ششصد و شصت و دو اتفاق افتاد"],[172,"بلبلی زینجا برفت و بازگشت","بهر صید این معانی باز گشت","بلبلی که از اینجا رفته بود، بازگشت و برای شکار معانی مثنوی به باز شکاری ماننده شد"],[172,"ساعد شه مسکن این باز باد","تا ابد بر خلق این در باز باد","بازوی پادشاه قرارگاه این باز باد، این درگاه تا جاودان بروی مردم گشوده باد"],[172,"آفت این در هوا و شهوت است","ورنه اینجا شربت اندر شربت است","آفت این درگاه هوای نفس و میل به شهوت است، و الا اینجا پیاپی شربت خوشی می نوشند"],[172,"این دهان بربند تا بینی عیان","چشم‌بند آن جهان حلق و دهان","این دهان نفسانی را ببند تا آشکارا ببینی که حلق و دهان مانع دیدار آن جهان است"],[172,"ای دهان تو خود دهانه دوزخی","وی جهان تو بر مثال برزخی","ای دهان تو دروازه یی از دوزخی، و ای دنیا تو هم همانند برزخی"],[172,"نور باقی پهلوی دنیای دون","شیر صافی پهلوی جوهای خون","نور جاویدان در کنار دنیای پست و شیر صاف در کنار جویهای خون است"],[172,"چون درو گامی زنی بی احتیاط","شیر تو خون می‌شود از اختلاط","اگر در آنجا بی احتیاط گام برداری، شیر تو با خون به هم می آمیزد"],[172,"یک قدم زد آدم اندر ذوق نفس","شد فراق صدر جنّت طوق نفس","آدم یک قدم در راه خوشی نفس برداشت، جدایی از صدر جنت بنامش ثبت شد، طوق جدایی بر گردنش آویخته شد"],[172,"همچو دیو از وی فرشته می‌گریخت","بهر نانی چند آب چشم ریخت","فرشته همانگونه که شیطان گریزد، از وی گریزان شد، برای لقمه ای نان مدتها اشک ریخت"],[172,"گرچه یک مو بد گنه کو جسته بود","لیک آن مو در دو دیده رسته بود","هرچند گناهی که مرتکب شده بود، تار مویی بود ولی آن مو در دو چشم او رسته بود"],[172,"بود آدم دیده نور قدیم","موی در دیده بود کوه عظیم","آدم، در حکم چشم ذات قدیم باری تعالی بود، موی در چشم، کوهی عظیم است"],[172,"گر در آن آدم بکردی مشورت","در پشیمانی نگفتی معذرت","اگر آدم در انجام آن کار مشورت میکرد، پشیمان نمیشد و به عذرخواهی بر نمیخواست"],[172,"زانک با عقلی چو عقلی جفت شد","مانع بد فعلی و بد گفت شد","اگر عقلی با عقل دیگر یار شود، از کردار و گفتار بد جلوگیری میکند"],[172,"نفس با نفس دگر چون یار شد","عقل جزوی عاطل و بی‌کار شد","اما اگر نفسی با نفسی دیگر یار شود، عقل فردی عاطل و باطل میگردد"],[172,"چون ز تنهایی تو نومیدی شوی","زیر سایه یار خورشیدی شوی","اگر از تنهایی نومیدی بر تو چیره شود، زیر سایه دوست به خورشیدی بدل میگردی"],[172,"رو بجو یار خدایی را تو زود","چون چنان کردی خدا یار تو بود","برو، بی درنگ دوست الهی جستجو کن، اگر چنین کاری بکنی، خدا یار تو میشود"],[172,"آنک در خلوت نظر بر دوخته‌ست","آخر آن را هم ز یار آموخته‌ست","آنکس که در خلوت نشسته و چشم بر اغیار بسته است، او نیز این کار را از دوست فرا گرفته است"],[172,"خلوت از اغیار باید نه ز یار","پوستین بهر دی آمد نه بهار","از بیگانگان باید خلوت گزید نه از یار، پوستین برای زمستان است نه برای بهار"],[172,"عقل با عقل دگر دوتا شود","نور افزون گشت و ره پیدا شود","اگر عقلی با عقل دیگر جفت شود، نور بیشتر میشود و راه آشکارتر میگردد"],[172,"نفس با نفس دگر خندان شود","ظلمت افزون گشت و ره پنهان شود","اما اگر نفسی از دیدار نفس دیگر شادمان شود، تاریکی بیشتر میگردد و راه گم میشود"],[172,"یار چشم تست ای مرد شکار","از خس و خاشاک او را پاک دار","ای مرد شکارچی! دوست همانند چشم توست، آن را از خس و خاشاک پاکیزه دار"],[172,"هین به جاروب زبان گردی مکن","چشم را از خس ره‌آوردی مکن","آگاه باش! با جاروی زبان خود گرد و غبار مکن، برای چشم از خس و خاشاک ارمغان فراهم میاور"],[172,"چون که مؤمن آینه مؤمن بود","روی او ز آلودگی ایمن بود","چون مؤمن برای مؤمن آینه است، روی او از آلودگی در امان است"],[172,"یار آیینه‌ست جان را در حزن","در رخ آیینه ای جان دم مزن","دوست در روزهای اندوه، آینه جان است، ای عزیز! بر روی آینه نباید دمید"],[172,"تا نپوشد روی خود را در دمت","دم فرو خوردن بباید هر دمت","تا به سبب دم تو روی خود را از تو نهان نکند، تو هر لحظه باید نفس خود را حبس کنی"],[172,"کم ز خاکی چونک خاکی یار یافت","از بهاری صد هزار انوار یافت","مگر کمتر از خاکی؟ چون خاک یاری مساعد یافت، با فرا رسیدن بهار صد هزار گل و غنچه رویانید"],[172,"آن درختی کو شود با یار جفت","از هوای خوش ز سر تا پا شکفت","درختی که با یار خود همراه و هم‌راستا می‌شود، از هوای خوب و دلپذیر، از ریشه تا سرشاخه شکوفا و سرسبز می‌گردد."],[172,"در خزان چون دید او یار خلاف","در کشید او رو و سر زیر لحاف","وقتی که در فصل پاییز یار را دید که برخلاف میلش رفتار می‌کند، او (عاشق) روی خود را برگرداند و سرش را زیر لحاف پنهان کرد."],[172,"گفت یار بد بلا آشفتن است","چونک او آمد طریقم خفتن است","یار گفت که بلا (مشکلات و دردسرها) باعث آشفتگی و بی‌قراری است، چون او (یار) که آمد، راهی که باید می‌رفتم را ترک کردم و به خواب رفتم."],[172,"پس بخسپم باشم از اصحاب کهف","به ز دقیانوس آن محبوس لهف","من به خواب می‌روم و از دوستان اصحاب کهف می‌شوم، زیرا زندگی و حاکمیت دقیانوس برای من زندان و سختی است."],[172,"یقظه‌شان مصروف دقیانوس بود","خوابشان سرمایه ناموس بود","بیداری و آگاهی آن‌ها به خاطر دقیانوس، حاکم ستمگر، صرف می‌شد و خواب آن‌ها، که می‌توانست بخشی از ارزش و حرمت آن‌ها باشد، به نوعی دارایی مهمی به حساب می‌آمد."],[172,"خواب بیداری‌ست چون با دانش‌است","وای بیداری که با نادان نشست","خواب واقعی همان بیداری است که مبتنی بر دانش و آگاهی باشد، در حالی که بیداری‌ای که در کنار نادانی باشد، ارزش چندانی ندارد."],[172,"چونک زاغان خیمه بر بهمن زدند","بلبلان پنهان شدند و تن زدند","زمانی که زاغ‌ها (پرندگان شوم) درختان را تحت کنترل خود درآورده و در بهمن (درخت کهنسال) لانه کردند، بلبل‌ها از ترس و ناامیدی پنهان شدند و از آواز خواندن خود دست کشیدند."],[172,"زانک بی‌گلزار بلبل خامش است","غیبت خورشید بیداری‌کش است","بلبل به خاطر نبودن گلزار خاموش است و غیبت خورشید، که نشانه بیداری و روشنی است، بر دلش سنگینی می‌کند."],[172,"آفتابا ترک این گلشن کنی","تا که تحت‌الارض را روشن کنی","ای خورشید! اگر این گلستان را ترک کنی، نور تو می‌تواند زیر زمین را هم روشن کند."],[172,"آفتاب معرفت را نقل نیست","مشرق او غیر جان و عقل نیست","آفتاب معرفت که به نور و دانایی اشاره دارد، نمی‌تواند از جایی دیگر به ما منتقل شود و منبع آن تنها جان و عقل انسان است."],[172,"خاصه خورشید ‌کمالی کان سری‌ست","روز و شب کردار او روشن‌گری‌ست","خورشید کمال، که اسرار برایش نهفته است، هر لحظه و در تمام روز و شب اعمال و کردار او را روشنی می‌بخشد."],[172,"مطلع شمس آی گر اسکندری","بعد از آن هرجا روی نیکو فری","ای شمس، ای خورشید کمال، اگر به تو نگاه کنم، بعد از تو هر جا که روی زیبا کند، محبوب خواهد بود."],[172,"بعد از آن هر‌جا روی مشرق شود","شرق‌ها بر مغربت عاشق شود","هر جا که روی تو به سمت مشرق برود، آن شرق‌ها به عشق تو به مغرب متمایل می‌شوند."],[172,"حس خفاشت سوی مغرب دوان","حس درپاشت سوی مشرق روان","حس تو، که به معنای احساسات و تمایلات انسانی است، به سمت مغرب می‌دود و در حالتی گیج و بی‌مقدار حرکت می‌کند، در حالی که حس دیگر که شامل درک و فهم عمیق‌تری است، به سمت مشرق در حال حرکت است. این بیان، تمایز میان حس‌های سطحی و عمیق را نشان می‌دهد."],[172,"راه حس راه خرانست ای سوار","ای خران را تو مزاحم‌، شرم دار","راه احساسات انسانی، به مانند راهی است که خران در آن می‌روند. ای سوار، به خران آسیب نرسان، زیرا این کار شرم‌آور است."],[172,"پنج حسی هست جز این پنج حس","آن چو زر سرخ و این حسها چو مس","پنج حس معروف که ما از طریق آن‌ها دنیا را درک می‌کنیم، مانند مس هستند و ارزش چندانی ندارند. اما حس دیگری هست که مانند طلا است و ارزش بالایی دارد."],[172,"اندر آن بازار که‌اهل محشرند","حس مس را چون حس زر کی خرند‌؟","در آن بازاری که اهل محشر (مردم قیامت) حضور دارند، آیا کسی حس مس (حس‌های سطحی و مادی) را به ارزش حس زر (حس عمیق و والای روحانی) می‌فروشد؟"],[172,"حس ابدان قوت ظلمت می‌خورد","حس جان از آفتابی می‌چرد","حس جسمی و فیزیکی تحت تأثیر تاریکی قرار می‌گیرد، اما حس روحی و معنوی از نور و روشنی الهام می‌گیرد و تغذیه می‌شود."],[172,"ای ببرده رخت حسها سوی غیب","دست چون موسی برون آور ز جیب","ای کسی که حواست را از دنیای محسوسات برده و به امور غیبی توجه داری، همان‌طور که موسی (پیامبر) عصای خود را از جیبش بیرون آورد."],[172,"ای صفاتت آفتاب معرفت","و آفتاب چرخ بند یک صفت","ای صفات تو مانند آفتاب، حقیقت و معرفت را روشن می‌کند، و همچنین مانند آفتاب آسمان، محدود به یک ویژگی نیست."],[172,"گاه خورشیدی و گه دریا شوی","گاه کوه قاف و گه عنقا شوی","گاهی مانند خورشید می‌درخشی و گاهی مانند دریا عمیق و وسیع می‌شوی، گاهی به بلندای کوه قاف می‌رسی و گاهی به مرتبه‌ای چون عنقا (پرنده‌ای افسانه‌ای) تبدیل می‌شوی."],[172,"تو نه این باشی نه آن در ذات خویش","ای فزون از وهم‌ها وز بیش بیش","تو نه به این صورت هستی و نه به آن صورت، بلکه در ذات خودت موجودی بالاتر از تصورات و فراتر از حالت‌های مختلف هستی."],[172,"روح با علمست و با عقلست یار","روح را با تازی و ترکی چه کار‌؟","روح دارای دانایی و عقل است و ارتباطی با زبان‌ها (مانند عربی و ترکی) ندارد. اینجا اشاره به این است که ذات روحی انسان فراتر از تعلقات زبانی و فرهنگی است."],[172,"از تو ای بی‌نقش با چندین صور","هم مشبه هم موحد خیره‌سر","ای تو که بدون هیچ شکلی و تجسمی، با وجود این همه اشکال و صورت‌های گوناگون، هم شبیه به واحد و هم وحدت‌گرا (موحد) داری، اما در حقیقت خیره و گیج هستی."],[172,"گه مشبه را موحد می‌کند","گه موحد را صور ره می‌زند","گاهی مشبه (کسی که ظاهر را می‌پرستد و به نقش‌ها توجه دارد) را به توحید و یکتاپرستی می‌کشاند و گاهی نیز موحد (کسی که به یکتایی خداوند باور دارد) را به سوی اشکال و صورت‌ها دچار می‌سازد."],[172,"گه ترا گوید ز مستی بوالحسن","یا صغیر السن یا رطب البدن","گاه او (خدا یا حقیقت) تو را به زبان حال مانند بوالحسن (شخصیت عرفانی) یا به اصطلاح جوان یا شخصی که گوشت و برنج می‌خورد، توصیف می‌کند."],[172,"گاه نقش خویش ویران می‌کند","آن پی تنزیه جانان می‌کند","گاهی یک نقش یا تصویر خویش را خراب می‌کند، چرا که او (خدا) برای پاک‌سازی و برآورده کردن نیازهای معنوی خود را می‌بیند."],[172,"چشم حس را هست مذهب اعتزال","دیده عقلست سنی در وصال","چشم حس که محدود و دنیایی است، پیرو مذهب اعتزال (از دنیا و لذات آن دوری می‌کند) است، اما دیده عقل که به امور معنوی و حقیقت نزدیک است، در وصال و نزدیکی با حق پیش می‌رود و سنی (پیرو اهل سنت) محسوب می‌شود."],[172,"سخره حس‌اند اهل اعتزال","خویش را سنی نمایند از ضلال","اهل اعتزال، که به دوری از احساسات و تجربیات حسی معروف‌اند، خود را پیرو مذهب سنی معرفی می‌کنند، در حالی که در حقیقت به گمراهی رفته‌اند."],[172,"هر که بیرون شد ز حس سنی وی‌است","اهل بینش چشم عقل خوش‌پی‌است","هر کسی که از حس و دریافت‌های حسی جدا شد، اهل شناخت و بصیرت است و دیدگاه عقلی و روشنی دارد."],[172,"گر بدیدی حس حیوان شاه را","پس بدیدی گاو و خر الله را","اگر حس حیوانی تنها داشتی و فقط به آن بسنده می‌کردی، در این صورت خدا را مانند گاو و خر می‌دیدی و هیچ درکی از ملکوت و معنویت نداشتی."],[172,"گر نبودی حس دیگر مر ترا","جز حس حیوان ز بیرون هوا","اگر حس دیگری در تو وجود نداشت، تنها حس حیوانی تو از بیرون یعنی از محیط اطراف، برای تو باقی می‌ماند."],[172,"پس بنی‌آدم مکرم کی بدی‌؟","کی به حس مشترک محرم شدی‌؟","آیا بنی‌آدم، که مخلوقی محترم است، در کی به این مقام والای خود دست یافت؟ و چه زمانی تو به حس مشترک و عمیق انسانی دسترسی پیدا کردی؟"],[172,"نامصور یا مصور گفتنت","باطل آمد بی ز صورت رستنت","گفتن نامصور یا مصور (یعنی بدون شکل و با شکل) بی‌معناست، زیرا تو در صورتی که از قید شکل خارج شوی، می‌توانی به حقیقتی عمیق‌تر دست یابی."],[172,"نامصور یا مصور پیش اوست","کو همه مغزست و بیرون شد ز پوست","خداوند یا حقیقتی که می‌توان آن را توصیف کرد، فراتر از تصویر و منظر است و حقیقت اصلی درونی و باطنی است که از ظاهر و فرم‌های بیرونی جداست."],[172,"گر تو کوری، نیست بر اعمی حرج","ورنه رو کالصبر مفتاح الفرج","اگر تو نابینا هستی، برای فردی که بینا نیست، ایرادی ندارد؛ چرا که صبر، کلید گشایش و رهایی است."],[172,"پرده‌های دیده را داروی صبر","هم بسوزد هم بسازد شرح صدر","داروی صبر می‌تواند پرده‌های بینایی را نابود کند و همچنین به انسان کمک می‌کند تا صدرش، یعنی وسعت دل و فهمش، افزایش یابد."],[172,"آینه دل چون شود صافی و پاک","نقش‌ها بینی برون از آب و خاک","وقتی دل مانند آینه پاک و صاف شود، می‌توانی نقش‌ها را به‌وضوح ببینی، حتی اگر این نقش‌ها فراتر از آب و خاک باشند."],[172,"هم ببینی نقش و هم نقاش را","فرش دولت را و هم فراش را","در این بیت اشاره به این است که وقتی دل پاک و صاف شود، نه‌تنها می‌توان اثرات و نقش‌های زیبای عالم را دید، بلکه خود خالق این نقش‌ها یا نقاش را نیز دریافت می‌کنیم. همچنین، در زندگی، هم می‌توان به نعمت‌ها و خوشی‌ها (فرش دولت) توجه داشت و هم به کسانی که آن‌ها را فراهم می‌آورند (فراش)."],[172,"چون خلیل آمد خیال یار من","صورتش بت‌، معنی او بت‌شکن","وقتی خلیل (ابراهیم خلیل) به خاطر دیدن معشوقم (یار من) به یاد او می‌افتاد، صورتش برای من مانند بت است، اما معنای او بت‌شکن است، یعنی کسی که بتی را از میان برمی‌دارد و به راستی خالص و غیرمادی است."],[172,"شکر یزدان را که چون او شد پدید","در خیالش جان خیال خود بدید","خدا را شکر که چون او (مقصود، یار) ظاهر شد، در خیال او جان خود را دید."],[172,"خاک درگاهت دلم را می‌فریفت","خاک بر وی کو ز خاکت می‌شکیفت","عشق و محبت من به درگاه تو، مانند خاکی است که به خاطر عشق تو به من عشق می‌ورزد. زیرا اگر زمین و خاک تو نباشد، من از آن عشق و محبت محروم می‌شوم."],[172,"گفتم ار خوبم پذیرم این ازو","ورنه خود خندید بر من زشت‌رو","گفتم اگر زیبا هستم، باید این زیبایی را از او بپذیرم، وگرنه خودم بر زشت‌رویی‌ام می‌خندد."],[172,"چاره آن باشد که خود را بنگرم","ورنه او خندد مرا من کی خرم","باید به جای نگرانی درباره او و زیبایی‌هایش، به درون خود نگاه کنم. اگر به خودم نپردازم، او هم به من می‌خندد و من هیچ خوشحال نخواهم بود."],[172,"او جمیلست و محب للجمال","کی جوان نو گزیند پیر زال","او زیباست و عشق زیبایی دارد. پس جوانی را که تازه به سن جوانی رسیده انتخاب نمی‌کند، بلکه کسی را برمی‌گزیند که در زیبایی و جوانی تجربه بیشتری دارد."],[172,"خوب خوبی را کند جذب این بدان","طیبات و طیبین بر وی بخوان","خوب، زیبایی را به خود جلب می‌کند. این مسأله به خاطر چیزهای نیک و پاکیزه‌ای است که بر او نازل می‌شود."],[172,"در جهان هر چیز چیزی جذب کرد","گرم گرمی را کشید و سرد سرد","در این جهان، هر چیزی، مشابه خود را جذب می‌کند؛ چیزهای گرم، گرمی را به خود می‌کشند و چیزهای سرد، سرما را."],[172,"قسم باطل باطلان را می‌کشند","باقیان از باقیان هم سرخوشند","قسم‌های دروغین، دروغ‌گویان را به سوی خود می‌کشانند، اما افراد درستکار و پایدار از یکدیگر شاد و خوشحال‌اند."],[172,"ناریان مر ناریان را جاذب‌اند","نوریان مر نوریان را طالب‌اند","آتش‌ناسان (ناریان) جذب کننده یکدیگرند و انسان‌های نورانی (نوریان) به دنبال همدیگر می‌گردند."],[172,"چشم چون بستی ترا جان کندنیست","چشم را از نور روزن صبر نیست","وقتی چشمانت را می‌بندی، مانند این است که جان می‌رود و در واقع چشم نمی‌تواند بدون نور روزنه (پنجره) تحمل کند."],[172,"چشم چون بستی تو را تاسه گرفت","نور چشم از نور روزن کی شکفت‌؟","زمانی که چشمت را می‌بندی، وارد مرحله‌ای می‌شوی که در آن امکان دیدن نور و زیبایی‌های دنیای外ی برایت وجود ندارد. آیا نور چشمت، که از پنجره‌ی وجودت می‌تابد، می‌تواند باز هم به شکوفایی برسد؟"],[172,"تاسه تو جذب نور چشم بود","تا بپیوندد به نور روز زود","چشم تو به نور چشم وابسته است تا به‌زودی به نور روز بپیوندد."],[172,"چشم باز ار تاسه گیرد مر تو را","دان‌که چشم دل ببستی‌، بر گشا","اگر چشمت را باز کنی و توجه کنی، خواهی دانست که چشمان دل را بسته‌ای، پس آن‌ها را باز کن."],[172,"آن تقاضای دو چشم دل شناس","کو همی‌جوید ضیای بی‌قیاس","چشم دل که به معنای بصیرت و آگاهی است، به دنبال روشنایی و حقیقتی بی‌نظیر می‌گردد، که این جست‌وجو ناشی از خواسته و آرزوی عمیق آن چشم‌هاست."],[172,"چون فراق آن دو نور بی‌ثبات","تاسه آوردت گشادی چشمهات","فراق و دوری آن دو نور (چشمان معشوق) که ناپایدار هستند، باعث می‌شود که در وجودت فضای جدیدی ایجاد شود و چشمانت به وسعت و گشایش بیشتری دست یابند."],[172,"پس فراق آن دو نور پایدار","تاسه می‌آرد مر آن را پاس دار","فراق (جدایی) دو نور پایدار (خدا و پیامبر) موجب می‌شود تا آدمی به یاد آن نورها به مراقبت و پاسداری از خود بپردازد."],[172,"او چو می‌خواند مرا من بنگرم","لایق جذبم و یا بد پیکرم","وقتی او (خدا یا محبوب) مرا فراخواند، من توجه می‌کنم که آیا شایسته جذب شدن به او هستم یا اینکه بدنم ناپاک و ناهنجار است."],[172,"گر لطیفی زشت را در پی کند","تسخری باشد که او بر وی کند","اگر کسی فردی را که با وجود لطافت، زشت است، مورد تحقیر و خوار شماری قرار دهد، این تحقیر به خود او برمی‌گردد و نشان‌دهنده ناپسندی رفتار اوست."],[172,"کی ببینم روی خود را ای عجب‌؟","تا چه رنگم همچو روزم یا چو شب‌؟","از خود پرسش می‌کند که کی می‌تواند چهره واقعی خود را ببیند، و حیرت دارد که آیا رنگ و حالش مثل روز روشن است یا مثل شب تاریک."],[172,"نقش جان خویش من جستم بسی","هیچ می‌ننمود نقشم از کسی","تلاش کردم تا ماهیت و حقیقت وجود خود را پیدا کنم، اما نشان و اثری از آنچه هستم، از هیچ‌کس و هیچ‌چیز به وضوح نمایان نبود."],[172,"گفتم آخر آینه از بهر چیست","تا بداند هر کسی کو چیست و کیست","سوال کردم که آینه برای چه ایجاد شده است، تا هر فردی بتواند چهره خود و هویت خود را بشناسد."],[172,"آینه آهن برای پوست‌هاست","آینه سیمای جان سنگی‌بهاست","آینه آهن برای نشان دادن ظاهر بدن است، اما آینه جان، تصویری از روح و باطن را به نمایش می‌گذارد که از ارزش بسیار بالایی برخوردار است."],[172,"آینه جان نیست الا روی یار","روی آن یاری که باشد زان دیار","آینه جان فقط چهره محبوب است، یعنی تنها چیزی که می‌تواند روح را بازتاب کند، چهره یاری است که از سرزمین محبوب می‌آید."],[172,"گفتم ای دل آینه کلی بجو","رو به دریا‌، کار بر ناید به‌جو","به دل گفتم که به جای جستجوی کمال و زیبایی در دیگران، به سمت حقیقت و عمق وجود بپرداز، چون به دنبال آب دریا نرو، چون به آن نخواهی رسید."],[172,"زین طلب بنده به کوی تو رسید","درد مریم را به خرمابن کشید","از طلب و نیاز است که بنده به کوی تو رسید، و درد بود که مریم را به ثمره و شیرینی خرما‌بن کشید."],[172,"دیده تو چون دلم را دیده شد","شد دل نادیده غرق دیده شد","چشم تو مانند دل من به چیزی که درونش است می‌نگرد و دل نادیده (یعنی دل پنهان) در این نگاه غرق می‌شود و مشغول می‌گردد."],[172,"آینه کلی ترا دیدم ابد","دیدم اندر چشم تو من نقش خود","در چشم تو، که مانند یک آینه است، وجود جمعی و کلی انسان‌ها را دیدم و خودم را در آن تصویر یافتم."],[172,"گفتم آخر خویش را من یافتم","در دو چشمش راه روشن یافتم","گفتم در نهایت خودم را در دو چشم او پیدا کردم و در آنجا راهی روشن برای شناخت خود یافتم."],[172,"گفت وهمم کان خیال تست هان","ذات خود را از خیال خود بدان","می‌گوید که فکر و تصور من به من می‌گوید که آنچه می‌بینم خیال توست. پس باید خود را از این خیال‌ها بشناسم و حقیقت وجود خود را بفهمم."],[172,"نقش من از چشم تو آواز داد","که منم تو تو منی در اتحاد","چشم تو به من خبر داد که من همانی هستم که تو هستی و تو همانی که من هستم؛ ما در هم یکی هستیم."],[172,"کاندرین چشم منیر بی زوال","از حقایق راه کی یابد خیال‌؟","در این بیت، شاعر می‌گوید که در این چشمان درخشان و همیشگی (که به حقایق اشاره دارد) چگونه می‌تواند خیالی به وجود بیاید و به حقیقت دست یابد. به عبارتی دیگر، او به ارتباط میان بینایی و حقیقت اشاره می‌کند و می‌پرسد که چگونه می‌توان فقط با خیال به درک واقعیات رسید."],[172,"در دو چشم غیر من تو نقش خود","گر ببینی آن خیالی دان و رد","اگر در دو چشم دیگری غیر از من، تصویری از خود ببینی، بدان که آن فقط یک خیال است و واقعی نیست."],[172,"زانک سرمه نیستی در می‌کشد","باده از تصویر شیطان می‌چشد","چون سرمه هیچ‌بودگی بر می‌کشد، از تصویر شیطان شراب می‌نوشد."],[172,"چشمشان خانه خیالست و عدم","نیست‌ها را هست بیند لاجرم","چشم‌های آن‌ها تنها تصویر خیال را می‌بینند و به جای آنکه به حقیقت وجود (هستی) توجه کنند، به عدم و نداشتن‌ها می‌نگرند. به همین دلیل، حقیقت را نمی‌شناسند و در عالم خیال متوقف مانده‌اند."],[172,"چشم من چون سرمه دید از ذوالجلال","خانه هستی‌ست نه خانه خیال","چشم من، که مانند سرمه (که در قدیم برای سیاه کردن چشم استفاده می‌شده) به بینایی حقیقت کمک می‌کند، از ذات الهی (ذوالجلال) چیزهایی را می‌بیند که واقعی و موجود هستند، نه خیالی و غیرواقعی."],[172,"تا یکی مو باشد از تو پیش چشم","در خیالت گوهری باشد چو یشم","هرگاه که تو به چیزی در خیال خود چشم بدوزی، حتی اگر آن چیز کوچک و ناچیز باشد، در نظر تو به اندازه یک گوهر گرانبها و باارزش می‌آید، مانند یشم."],[172,"یشم را آنگه شناسی از گهر","کز خیال خود کنی کلی عبر","یشم را زمانی می‌شناسی که آن را از گوهری که در خیال خود خلق کرده‌ای، مجزا کنی و به واسطه خیال نتوانی به شناخت کامل آن برسی."],[172,"یک حکایت بشنو ای گوهر‌شناس","تا بدانی تو عیان را از قیاس","ای گوهر‌شناس، یک حکایت را بشنو تا بفهمی چیزهای روشنی را که به طور مستقیم می‌بینی، نباید با چیزهای مشابه و به ظاهر آشنا مقایسه کنی."],[173,"ماه روزه گشت در عهد عمر","بر سر کوهی دویدند آن نفر","در زمان خلافت عمر، ماه رمضان به پایان رسید، گروهی بر بالای کوهی به تماشای هلال ماه نو رفتند."],[173,"تا هلال روزه را گیرند فال","آن یکی گفت ای عمر اینک هلال","به این خاطر که هلال ماه را سبب فال خیر و پایان ماه رمضان بشمارند. یکی گفت «ای عمر، هلال ماه پیدا شد.»"],[173,"چون عمر بر آسمان مه را ندید","گفت کین مه از خیال تو دمید","چون عمر در آسمان هیچ نشانی از ماه ندید، گفت که این ماه تنها از خیال تو بوجود آمده است."],[173,"ورنه من بیناترم افلاک را","چون نمی‌بینم هلال پاک را","چرا که برتری من موجب است که آسمان هارا بهتر ببینم. چطور است که هلال ماه نو را نمی‌بینم؟"],[173,"گفت تر کن دست و بر ابرو بمال","آنگهان تو در نگر سوی هلال","عمر به وی گفت انگشتت را تر کن و به ابرویت بکش. سپس به هلال ماه نگاه کن."],[173,"چونکه او تر کرد ابرو‌، مه ندید","گفت ای شه نیست مه شد ناپدید","وقتی ابرویش را تر کرد، دیگر ماه را ندید. گفت ای شاه(عمر) ماه ناپدید شد."],[173,"گفت آری موی ابرو شد کمان","سوی تو افکند تیری از گمان","عمر گفت: آری موی ابروی تو روبروی چشمت کمان شده بود و باعث شک تو به دیدن ماه نو شد."],[173,"چون یکی مو کژ شد‌، او را راه زد","تا به‌دعوی لاف‌ دید‌ ماه زد","هنگامی که یک نخ مو کج شد، او هدفش را گم کرد و به همین خاطر به اشتباه گفت ماه را دیده."],[173,"موی کژ چون پرده گردون بود","چون همه اجزات کژ شد‌، چون بود‌؟","اگر موها به‌هم ریخته و نامرتب باشد، مانند قضا و قدر آشفته و بی‌نظم خواهد بود. وقتی تمام اجزای زندگی به‌هم بریزد، اوضاع چگونه می‌تواند به سامان باشد؟"],[173,"راست کن اجزات را از راستان","سر مکش ای راست‌رو ز آن آستان","باید اجزای وجودت را به سمت راست و درست تنظیم کنی و از افرادی که اهل کژی هستند، دوری کن، ای انسان راست‌رو، زیرا تو هرگز نباید از درگاه خداوند دور شوی."],[173,"هم ترازو را ترازو راست کرد","هم ترازو را ترازو کاست کرد","ترازو، با برقراری تعادل و سنجش به درستی، می‌تواند هم وزن چیزی را افزایش دهد و هم کاهش دهد. این به این معناست که در زندگی، درست و نادرست یا خوبی و بدی به نسبت و تعادل بستگی دارد."],[173,"هر که با ناراستان هم‌سنگ شد","در کمی افتاد و عقلش دنگ شد","هر کسی که با حقیقت و واقعیت فاصله گرفت و به امور نادرست روی آورد، در عمل به تنگنا دچار می‌شود و فهم و عقلش دچار اختلال و نارسایی خواهد شد."],[173,"رو اشداء علی‌الکفار باش","خاک بر دلداری اغیار پاش","در برابر دشمنان خدا باید سخت و جدی باشی و نباید به دوستی و دلداری افراد بیگانه بپردازی."],[173,"بر سر اغیار چون شمشیر باش","هین مکن روباه‌بازی شیر باش","بر سر دشمنان به شدت و قاطعیت رفتار کن و مانند شمشیر عمل کن. از فریب و نیرنگ پرهیز کن و باید با شجاعت و قدرت رفتار کنی."],[173,"تا ز غیرت از تو یاران نسکلند","زانکه آن خاران عدو این گلند","به خاطر غیرت و شجاعت تو، یاران از تو دور نشوند؛ زیرا آن خران (احمق‌ها) دشمن این گل‌ها (دوستان و عزیزان) هستند."],[173,"آتش اندر زن به گرگان چون سپند","زانکه آن گرگان عدو یوسفند","به گرگان (دشمنان) آتش بیفکن و از آن‌ها دوری کن، چون گرگ‌ها دشمن یوسف (نماد نیک و خوب) هستند."],[173,"«‌جان بابا‌» گویدت ابلیس هین","تا به دم بفریبدت دیو لعین","ابلیس (شیطان) به تو می‌گوید که «جان بابا» است و تا لحظه آخر تو را فریب می‌دهد تا به او اعتماد کنی."],[173,"این چنین تلبیس با بابات کرد","آدمی را این سیه‌رخ مات کرد","این‌گونه فریبکاری دیو سیاه، در حق پدرت (آدم) انجام داد و او را به ورطه‌ی اسارت کشاند."],[173,"بر سر شطرنج چست است این غراب","تو مبین بازی به چشم نیم‌خواب","در این بیت به شطرنج بازی اشاره شده و گفته می‌شود که غراب (پرنده‌ای که به عنوان نماد در این جا مطرح شده است) در این بازی هوشیار و چابک است و نباید بازی را با چشمان نیمه‌خواب و بی‌دقت تماشا کرد. در واقع، بی‌توجهی به بازی باعث می‌شود که حقیقت‌ها را نادیده بگیریم."],[173,"زانکه فرزین‌بندها داند بسی","که بگیرد در گلویت چون خسی","چون فرزین (مردی هوشمند و حاذق) بسیار چیزها می‌داند، می‌تواند تو را به دام بیندازد و در گلویت مانند یک خس (در اینجا، حلقه‌ای که در گلو گذاشته می‌شود) بگیرد."],[173,"در گلو ماند خس او سال‌ها","چیست آن خس، مهر جاه و مال‌ها","خس (علف هرز) که سال‌ها در گلو مانده، نماد مهر و محبت به جاه و مال است. این ابیات بیانگر این است که عشق به قدرت و ثروت می‌تواند انسان را به دام بیندازد و از رسیدن به آب حیات (حیات معنوی) بازدارد."],[173,"مال خس باشد چو هست ای بی‌ثبات","در گلویت مانع آب حیات","خس یا گیاه بی‌ارزش، مانند مال و ثروت است که اگر در زندگی کسی باشد، او را از دستیابی به آب حیات (زندگی واقعی و معنوی) بازمی‌دارد و این نشان می‌دهد که ثروت، ثبات و دوام ندارد."],[173,"گر برد مالت عدوی پر فنی","ره‌زنی را برده باشد ره‌زنی","اگر دشمنی پر حیله، مالت را برده باشد، یک دزد، دزدی دیگر را برده و شرّ یک دزد و راهزن را از تو کم کرده است."],[174,"دزدکی از مارگیری مار برد","ز ابلهی آن را غنیمت می‌شمرد","دزدی از مارگیری یک مار را دزدید و از روی نادانی آن را بسیار ارزشمند تصور کرد."],[174,"وا رهید آن مارگیر از زخم مار","مار کشت آن دزد او را زار زار","مارگیر از آسیب مار نجات پیدا کرد ولی مار آن دزد را نیش زد و به حال بدی کشت."],[174,"مارگیرش دید پس بشناختش","گفت از جان مار من پرداختش","مارگیر او را شناخت و گفت: جان او را مار من گرفته است ."],[174,"در دعا می‌خواستی جانم ازو","کش بیابم مار بستانم ازو","با تمام وجود دعا کرده بودم که دزد را پیدا کنم و مارم را از او پس بگیرم"],[174,"شکر حق را کان دعا مردود شد","من زیان پنداشتم آن سود شد","خدا را شکر که دعایم مستجاب نشد، من این ماجرا ی دزدی را ضرر می دانستم ولی در واقع به نفع من بود."],[174,"بس دعاها کان زیانست و هلاک","وز کرم می‌نشنود یزدان پاک","خیلی از دعاها در صورت استجابت، به ضرر و هلاکت منجر خواهد شد که خداوند پاک و بخشنده آنها را مستجاب نمیکند."],[175,"گشت با عیسی یکی ابله رفیق","استخوانها دید در حفره عمیق","همراه عیسی (ع) فردی احمق و ناآگاه بود که استخوان‌ها را در یک گودال عمیق دیده بود."],[175,"گفت ای همراه آن نام سنی","که بدان مرده تو زنده می‌کنی","این شخص به عیسی علیه السلام می‌گوید: ای همراه، تو که به نام خدا مرده‌ها را زنده می‌کنی، مرا هم آموزش بده تا بتوانم چنین کار بزرگی انجام دهم."],[175,"مر مرا آموز تا احسان کنم","استخوانها را بدان با جان کنم","ای عیسی، مرا یاد بده تا بتوانم با روح خود به استخوان‌ها احسان کنم و آنها را به زندگی برگردانم."],[175,"گفت خامش کن که آن کار تو نیست","لایق انفاس و گفتار تو نیست","گفتند که سکوت کن، زیرا این کار از توانایی و شایستگی تو خارج است و مناسب با سخنان و نفس‌های تو نیست."],[175,"کان نفس خواهد ز باران پاک‌تر","وز فرشته در روش دراک‌تر","نفس (روح یا جان) انسانی از باران پاک‌تر خواهد بود و درک او از فرشتگان نیز برتر و قوی‌تر است."],[175,"عمرها بایست تا دم پاک شد","تا امین مخزن افلاک شد","مدت‌های طولانی لازم است تا فردی پاک و بی‌نقص شود و به مقام اطمینان و اعتبار در مخزن‌های آسمانی دست یابد."],[175,"خود گرفتی این عصا در دست راست","دست را دستان موسی از کجاست","تو خودت این عصا را در دست راستت گرفته‌ای، پس دست‌های موسی (پیامبر) از کجا آمده است؟"],[175,"گفت اگر من نیستم اسرارخوان","هم تو بر خوان نام را بر استخوان","عیسی گفت: اگر من که نیستم، تو هم آن‌قدر قدرت داری که اسرار را بخوانی و نام را بر استخوان‌ها بیاوری."],[175,"گفت عیسی یا رب این اسرار چیست","میل این ابله درین بیگار چیست","عیسی علیه السلام از خداوند سؤال می‌کند که این اسرار چیست که این بی‌خود و احمق (که به او اشاره دارد) در این کار بی‌فایده و بیهوده چه انگیزه‌ای دارد."],[175,"چون غم خود نیست این بیمار را","چون غم جان نیست این مردار را","این بیمار به خاطر غم خود ناراحت نیست و این مرده هم به خاطر جانش غم ندارد؛ او به حال خود توجه نمی‌کند."],[175,"مرده خود را رها کردست او","مرده بیگانه را جوید رفو","این فرد (بیمار) به جای اینکه به فکر خود و مشکلاتش باشد، به دنبال ترمیم مشکلات دیگران است و به موضوعات بی‌ربط مشغول شده است."],[175,"گفت حق ادبار اگر ادبارجوست","خار روییده جزای کشت اوست","خداوند گفت: اگر کسی در جستجوی پشت کردن و رویگردانی است، باید بداند که خارهایی که روییده، نتیجه کشت و کار خود اوست."],[175,"آنک تخم خار کارد در جهان","هان و هان او را مجو در گلستان","تخم خار که در دنیا پاشیده شده، به هیچ وجه نباید آن را در گلستان جستجو کنی، زیرا نتیجه‌اش چیزی جز خار نخواهد بود."],[175,"گر گلی گیرد به کف خاری شود","ور سوی یاری رود ماری شود","اگر برای کمک به دیگری گلی را در دست گیرد، شایسته است و اگر به سوی دوستی برود، مانند ماری می‌شود."],[175,"کیمیای زهر و مارست آن شقی","بر خلاف کیمیای متقی","شخص شقی و بدبختم به جای تبدیل شدن به چیزی با ارزش و نیکو (کیمیای تقوا و پرهیزگاری)، به نتیجه‌ای منفی و زهرآلود (زهر و مار) می‌رسد."],[176,"صوفیی می‌گشت در دور افق","تا شبی در خانقاهی شد قنق","صوفی‌ای در حال گشت و گذار در دوردست‌ها بود و یک شب به خانقاهی رسید و در آن‌جا سکنی گزید."],[176,"یک بهیمه داشت در آخر ببست","او به صدر صفه با یاران نشست","صوفی یک حیوان بارکش (بهیمه) داشت که آن را در آخر کار به جایی بست و سپس با دوستانش در بالای یک صفه (سکویی یا مکان بلندی) نشسته بود."],[176,"پس مراقب گشت با یاران خویش","دفتری باشد حضور یار پیش","خود را در جمع یارانش مشغول و مراقب کرد تا در سایه دوستی و حضور محبوب، یاد و ثبت خوبی‌ها را داشته باشد."],[176,"دفتر صوفی سواد حرف نیست","جز دل اسپید همچون برف نیست","معنی آن است که دفتر صوفی تنها نوشته‌ها و حروف را شامل نمی‌شود، بلکه حقیقت اصلی آن، دل پاکی است که مانند برف سفید و خالص است."],[176,"زاد دانشمند آثار قلم","زاد صوفی چیست آثار قدم","آثار قلم دانشمند نشان‌دهنده تلاش و علم اوست، اما آثار قدم صوفی نشان‌دهنده سفر و تجربه‌های روحانی او است."],[176,"همچو صیادی سوی اشکار شد","گام آهو دید و بر آثار شد","مانند یک صیاد، به سمت روشنایی و جایی که مشخص است حرکت کرد و رد پای آهو را دید و به نشانه‌ها و آثار آن توجه کرد."],[176,"چندگاهش گام آهو در خورست","بعد از آن خود ناف آهو رهبرست","مدت‌هاست که آثار گام آهو در اینجا دیده می‌شود، اما بعد از آن، خود آهو هم به دنبال آن گام‌ها راه را مشخص می‌کند."],[176,"چونک شکر گام کرد و ره برید","لاجرم زان گام در کامی رسید","چون شکر (نرمی و خوشی) را احساس کرد و مسیر را تغییر داد، بنابراین به مدد آن گام، به کامی و موفقیت رسید."],[176,"رفتن یک منزلی بر بوی ناف","بهتر از صد منزل گام و طواف","رفتار انسان در زندگی، اگر با نیت و معرفت درست باشد، حتی اگر فقط به یک منزل محدود باشد، ارزش بیشتری دارد تا اینکه فرد به سرعت و بدون آگاهی از مسیر گذر کند و صد منزل را طی کند."],[176,"آن دلی کو مطلع مهتاب‌هاست","بهر عارف فتحت ابواب‌هاست","دل کسی که درخشش و زیبایی مهتاب‌ها را درک می‌کند، برای عارفان درهای دانش و حقیقت را می‌گشاید."],[176,"با تو دیوارست و با ایشان درست","با تو سنگ و با عزیزان گوهرست","این بیت به تضاد بین رابطه انسان با خدا و رابطه‌اش با دیگران اشاره دارد. می‌گوید اگر انسان با خداوند نزدیکی داشته باشد، دیوار و فاصله‌ای میان او و خدا نیست، در حالی که با دیگران ممکن است فاصله و سختی وجود داشته باشد. با دوستان و عزیزان رابطه‌ای ارزشمند و باارزش‌تر مانند گوهر است."],[176,"آنچ تو در آینه بینی عیان","پیر اندر خشت بیند بیش از آن","آنچه را که تو در آینه به وضوح می‌بینی، پیر (عالم یا راهنما) در دل خاک (خشت) نیز می‌بیند و حتی بیشتر از آن."],[176,"پیر ایشانند کین عالم نبود","جان ایشان بود در دریای جود","پیران و استادان آنها به این نکته اشاره دارند که این جهان تنها ظاهر دارد و حقیقت آن غیر از این است؛ وجود حقیقی آنها در عمق دریای سخاوت و بخشش نهفته است."],[176,"پیش ازین تن عمرها بگذاشتند","پیشتر از کشت بر برداشتند","قبل از اینکه عمرهای خود را در این دنیا سپری کنند، از دنیای مادی و ظاهری عبور کرده و به مرحله‌ای عمیق‌تر و واقعی‌تر دست یافته‌اند."],[176,"پیشتر از نقش جان پذرفته‌اند","پیشتر از بحر درها سفته‌اند","افرادی که قبل از به دنیا آمدن، جان خود را در عالم دیگری پذیرفته‌اند، پیش از آنکه در دنیای مادی پرورش یابند، به حقیقت‌های اساسی و عمیق‌تری آگاه شده‌اند."],[177,"مشورت می‌رفت در ایجاد خلق","جانشان در بحر قدرت تا به حلق","خدا در ایجاد موجودات با ملایکه مشورت می‌کرد، در حالی که جان آنها در وسعت قدرت الهی مثل آب (در دریا) تا حلق (گلو) فرو رفته بود."],[177,"چون ملایک مانع آن می‌شدند","بر ملایک خفیه خنبک می‌زدند","وقتی فرشتگان مانع ایجاد انسان می‌شدند، به فرشتگان پنهان خبر می‌دادند که مشکلاتی وجود دارد."],[177,"مطلع بر نقش هر که هست شد","پیش از آن کین نفس کل پابست شد","کسی که بر نقش و اصل خلقت آگاه است، قبل از اینکه نفس او به دنیا وابسته شود، به این حقیقت رسیده است."],[177,"پیشتر ز افلاک کیوان دیده‌اند","پیشتر از دانه‌ها نان دیده‌اند","آن‌ها قبل از این که افلاک و سیارات را ببینند، شاهد وجود کیوان (سیاره زحل) بوده‌اند و همچنین قبل از اینکه دانه‌ها را ببینند، نان را دیده‌اند. بدین معنا که معرفت و درک آن‌ها از عالم وجود فراتر از مشاهدات ظاهری است."],[177,"بی دماغ و دل پر از فکرت بدند","بی سپاه و جنگ بر نصرت زدند","این افراد بدون عقل و فکر، قلبی پر از اندیشه داشتند و در حالی که نه جنگی داشتند و نه سپاهی، به یاری و نصرت برخواستند."],[177,"آن عیان نسبت بایشان فکرتست","ورنه خود نسبت بدوران رؤیتست","آنچه به‌صورت واضح مشخص است، همین فکر و اندیشه است که به آنان نسبت داده می‌شود؛ وگرنه خود آنان نسبت به دوران رؤیت و دیدند."],[177,"فکرت از ماضی و مستقبل بود","چون ازین دو رست مشکل حل شود","فکر و اندیشه از گذشته و آینده نشأت می‌گیرد و زمانی که انسان از این دو رهایی یابد، مسائل و مشکلاتش حل خواهد شد."],[177,"دیده چون بی‌کیف هر باکیف را","دیده پیش از کان صحیح و زیف را","چشم، هر نوع زیبایی را قبل از این که به وجود آید، به گونه‌ای بی‌کیفیت و ناقص مشاهده کرده است، یعنی آنچه زیباست و آنچه نازیباست را قبل از اینکه به حقیقت برسند، می‌بیند."],[177,"پیشتر از خلقت انگورها","خورده میها و نموده شورها","قبل از خلق انگورها، خداوند تاکنون شراب‌ها را چشیده و سرور و شوری را تجربه کرده است."],[177,"در تموز گرم می‌بینند دی","در شعاع شمس می‌بینند فی","در تابستان گرم (تموز)، در حالتی که مستی و سرگیجه بوجود می‌آید، آدمی به تأثیر خورشید (شمس) در دل آن (می) و حالت تغییر و تحول راه می‌یابد."],[177,"در دل انگور می را دیده‌اند","در فنای محض شی را دیده‌اند","در دل انگور شراب را مشاهده کرده‌اند و در فنای مطلق، حقیقت را دیده‌اند."],[177,"آسمان در دور ایشان جرعه‌نوش","آفتاب از جودشان زربفت‌پوش","آسمان به دور این انسان‌ها همچون کسی است که مشغول نوشیدن جرعه‌ای از آفتاب است و این آفتاب به خاطر بخشندگی آن‌ها در پوششی از طلا قرار گرفته است."],[177,"چون ازیشان مجتمع بینی دو یار","هم یکی باشند و هم ششصد هزار","زمانی که دو دوست را کنار هم ببینی، به نظر می‌رسد که آن‌ها تنها دو نفر هستند، اما در حقیقت، آن‌ها به گونه‌ای با یکدیگر پیوند دارند که می‌توانند به اندازۀ ششصد هزار نفر احساس نزدیک و یکی بودن کنند."],[177,"بر مثال موجها اعدادشان","در عدد آورده باشد بادشان","قله‌های کوه مانند موج‌ها هستند که در تعدادشان بر یکدیگر تاثیر می‌گذارند؛ هم‌چنان که بادها بر این موج‌ها تاثیر می‌گذارند، اعداد و تعداد افراد نیز بر یکدیگر اثر می‌گذارند."],[177,"مفترق شد آفتاب جانها","در درون روزن ابدان ما","آفتاب جان‌ها از هم فاصله گرفت و در درون روزن‌های بدن‌های ما پراکنده شد."],[177,"چون نظر در قرص داری خود یکیست","وانک شد محجوب ابدان در شکیست","اگر به قرص، که به معنای کامل یا دایره است، نگاه کنی، همه چیز یکی است، اما آنچه در حال حاضر مانع از دیدن این یک‌پارچگی می‌شود، بدن‌های مادی ما هستند که باعث تردید و دوگانگی می‌شوند."],[177,"تفرقه در روح حیوانی بود","نفس واحد روح انسانی بود","تفرقه و جدایی در روح حیوانات وجود دارد، اما روح انسان واحد و یکپارچه است."],[177,"چونک حق رش علیهم نوره","مفترق هرگز نگردد نور او","زمانی که خداوند بر آن‌ها (مخلوقات) نور خود را افروز می‌کند، هرگز پراکنده نمی‌شوند و نور او همیشه یکپارچه است."],[177,"یک زمان بگذار ای همره ملال","تا بگویم وصف خالی زان جمال","لحظه‌ای صبر کن ای همراه غم‌انگیز تا وصف زیبایی آن محبوب را بگویم."],[177,"در بیان ناید جمال حال او","هر دو عالم چیست عکس خال او","جمال و زیبایی او آن‌قدر خارق‌العاده است که نمی‌توان به درستی وصفش کرد و هر دو جهان تنها تصویری از آن زیبایی را نشان می‌دهند."],[177,"چونک من از خال خوبش دم زنم","نطق می‌خواهد که بشکافد تنم","چون من درباره زیبایی او سخن می‌گویم، به گفتاری نیاز دارم که وجودم را بشکافد و عمق وجودم را بیان کند."],[177,"همچو موری اندرین خرمن خوشم","تا فزون از خویش باری می‌کشم","من همچون موری (مور) در این خرمن (خوشی و نعمت) هستم و گاهی از خودم بیشتر بار می‌برم."],[178,"کی گذارد آنک رشک روشنیست","تا بگویم آنچ فرض و گفتنیست","چه کسی اجازه می‌دهد که حسادت به روشنی (یعنی مقام واقعی و حقیقت) بر او غلبه کند، تا من بتوانم آنچه که فرضی و گفتنی است را بیان کنم؟"],[178,"بحر کف پیش آرد و سدی کند","جر کند وز بعد جر مدی کند","آب دریا را به سطح می‌آورد و سپس سد ایجاد می‌کند. در پی این عمل، جریان آب تغییر می‌کند و به آرامی جاری می‌شود."],[178,"این زمان بشنو چه مانع شد مگر","مستمع را رفت دل جای دگر","این زمان بشنو، چه چیزی باعث شد که شنونده حواسش پرت شود و دلش به جای دیگری برود."],[178,"خاطرش شد سوی صوفی قنق","اندر آن سودا فرو شد تا عنق","دل او به سمت صوفی و حال و هوای عرفانی او متمایل شد و در آن حالتی که درگیر آن است از دنیا و مشغله‌هایش غافل گردید."],[178,"لازم آمد باز رفتن زین مقال","سوی آن افسانه بهر وصف حال","لازمی پیدا شد که دوباره از این گفت‌وگو برگردیم به آن داستان، تا وصف حال را روایت کنیم."],[178,"صوفی آن صورت مپندار ای عزیز","همچو طفلان تا کی از جوز و مویز","ای عزیز، صوفی را به ظواهر مپندار، زیرا مانند بچه‌ها نمی‌توانی همیشه به جوز و مویز (طبیعت مادی) وابسته بمانی."],[178,"جسم ما جوز و مویزست ای پسر","گر تو مردی زین دو چیز اندر گذر","جسم آدمی به مانند جوز و مویز است، یعنی زودگذر و فانی؛ اگر تو مردی واقعی هستی، باید از این دو چیز، یعنی جسم و مادیات، فراتر بروی."],[178,"ور تو اندر نگذری اکرام حق","بگذراند مر ترا از نه طبق","اگر تو از این دو چیز (جسم و ماده) نگذری، خداوند تو را در مقام اکرام و احترام قرار نخواهد داد و از مرتبه پست (نه طبق) تو را عبور نخواهد داد."],[178,"بشنو اکنون صورت افسانه را","لیک هین از که جداکن دانه را","حالا به شنیدن داستان بپرداز، اما مواظب باش که دانه (محتوای اصلی) را از پوست و ظاهر آن جدا کنی و معانی عمیق را دریابی."],[179,"حلقه آن صوفیان مستفید","چونک در وجد و طرب آخر رسید","حلقه صوفیان، با شوق و سرخوشی به اوج لذت و شادی خود رسیده بودند."],[179,"خوان بیاوردند بهر میهمان","از بهیمه یاد آورد آن زمان","خادم، غذایی برای مهمان‌ها آورد که در آن یادآوری بهیمه (حیوانات) وجود داشت و منظور از این یادآوری، اشاره به غذایی است که از گوشت یا محصولات دامی تهیه شده است."],[179,"گفت خادم را که در آخر برو","راست کن بهر بهیمه کاه و جو","خادم را گفت که به درستی هرچه در نهایت باید برای بهیمه تهیه کنی، کاه و جو درست کن."],[179,"گفت لا حول این چه افزون گفتنست","از قدیم این کارها کار منست","خادم به من می‌گوید که حرف‌های اضافی نزن، چون از قدیم‌الایام کار من همین بوده است."],[179,"گفت تر کن آن جوش را از نخست","کان خر پیرست و دندانهاش سست","گفت: آن جوش را (یعنی حال و اوضاع را) از ابتدا مرطوب و نرم کن، چونکه آن خر پیر است و دندان‌هایش ضعیف و سست شده است."],[179,"گفت لا حول این چه می‌گویی مها","از من آموزند این ترتیبها","گفت وقتی که تو این صحبت‌ها را می‌کنی، من معذورم و نمی‌توانم از تو چیزی یاد بگیرم."],[179,"گفت پالانش فرو نه پیش پیش","داروی منبل بنه بر پشت ریش","پالان، یعنی جالی که بر پشت حیوانات بار می‌شود، را بر زمین بگذار و داروی منبل (نوعی دارو یا مسکن) را بر پشت ریش (پیشانی) حیوان بچسبان. این جملات به نوعی اشاره به بی‌توجهی به شرایط و نیازهای حیوان و همچنین عدم رعایت اصول صحیح در کار دارد."],[179,"گفت لا حول آخر ای حکمت‌گزار","جنس تو مهمانم آمد صد هزار","خداوند به حکمت‌گزار می‌گوید که من به تو پناه آورده‌ام و با حالت تسلیم، به اهمیت و ارزش وجود تو پی برده‌ام، چرا که مهمان من از میلیون‌ها نکته و حالت معتبر است."],[179,"جمله راضی رفته‌اند از پیش ما","هست مهمان جان ما و خویش ما","همه آنها که از پیش ما رفته‌اند، راضی و خوشحال به نظر می‌رسند، اما مهمان جان ما و روح ما، همان کسی است که نزدیک و در زندگی‌ ماست."],[179,"گفت آبش ده ولیکن شیر گرم","گفت لا حول از توم بگرفت شرم","گفتند به او که به آنها آب بدهد، اما شیر گرم را فراموش نکند. او پاسخ داد که از من شرم دارد و نمی‌تواند دست از این کار بکشد."],[179,"گفت اندر جو تو کمتر کاه‌کن","گفت لا حول این سخن کوتاه کن","او به شخصی دیگر می‌گوید که در جو (تجربه یا زمینه) خود، کمتر از کاه (ناچیز) استفاده کن و به او پاسخ می‌دهد که با این شرایط، نمی‌توان کاری کرد و این حرف‌ها را کوتاه کن."],[179,"گفت جایش را بروب از سنگ و پشک","ور بود تر ریز بر وی خاک خشک","اگر در جایی که سنگ و فضولات حیوانی (پشک) وجود دارد، خاک رسید، خاک خشک را بر آن بپاش تا پاک شود."],[179,"گفت لا حول ای پدر لا حول کن","با رسول اهل کمتر گو سخن","در این بیت، شخصی به پدرش می‌گوید که باید از عدم توانایی و نشدنی‌ها (لا حول) دست بردارد و با پیامبر اهل (ایمان‌داران) کمتر صحبت کند. این به معنای دعوت به دوری از سخنان بی‌فایده و بی‌احترامی است."],[179,"گفت بستان شانه پشت خر بخار","گفت لا حول ای پدر شرمی بدار","خادم گفت: \"پشت خر را برش کن\"، اما در دل با خود گفت: \"ای پدر، کمی خجالت بکش و از این کار دست بردار."],[179,"خادم این گفت و میان را بست چست","گفت رفتم کاه و جو آرم نخست","خادم این را گفت و در میان کار را محکم کرد و گفت که من می‌روم تا ابتدا کاه و جو بیاورم."],[179,"رفت و از آخر نکرد او هیچ یاد","خواب خرگوشی بدان صوفی بداد","خادم رفت و هیچ زمانی به یاد نداشت که در مورد خواب خرگوشی به آن صوفی (عارف) بگوید، یعنی به توصیه‌ها و یادآوری‌های او توجه نکرد."],[179,"رفت خادم جانب اوباش چند","کرد بر اندرز صوفی ریش‌خند","خادم به سوی چند اوباش رفت و آنها را به تمسخر و تمسخر کرد و با نصیحت صوفی، به آنها خندید."],[179,"صوفی از ره مانده بود و شد دراز","خوابها می‌دید با چشم فراز","صوفی که از مسیر خود منحرف شده بود، دراز کشیده و خواب‌های عجیب و غریبی می‌دید و چشمانش بالا بود."],[179,"کان خرش در چنگ گرگی مانده بود","پاره‌ها از پشت و رانش می‌ربود","خر او در چنگالی از گرگ گرفتار شده بود و گرگ تکه‌تکه شدن او را از پشت و رانش می‌دزدید."],[179,"گفت لا حول این چه مالیخولیاست","ای عجب آن خادم مشفق کجاست","گفت این چه وضع آشفته‌ای است، ای وای! کجا است آن خادم مهربانی که باید مراقب باشد؟"],[179,"باز می‌دید آن خرش در راه‌رو","گه به چاهی می‌فتاد و گه بگو","او دوباره می‌دید که خرش در راه، گاهی در چاه می‌افتد و گاهی موضوع دیگری پیش می‌آید."],[179,"گونه‌گون می‌دید ناخوش واقعه","فاتحه می‌خواند او والقارعه","او می‌دید که حوادث ناخوشایند و نامطلوبی در حال وقوع است و به همین دلیل فاتحه می‌خواند و برای مواجهه با این وقایع نگران بود."],[179,"گفت چاره چیست یاران جسته‌اند","رفته‌اند و جمله درها بسته‌اند","او از یارانش می‌گوید که همه رفته‌اند و دیگر هیچ‌کدام در دسترس نیستند. از این رو می‌پرسد چه باید کرد، چون هیچ راهی برای کمک یا دیدار پیدا نمی‌شود."],[179,"باز می‌گفت ای عجب آن خادمک","نه که با ما گشت هم‌نان و نمک","خادم که نه در محفل یاران با ما بود و نه با ما نان و نمک خورد، چه جای شگفتی است در رفتار او؟"],[179,"من نکردم با وی الا لطف و لین","او چرا با من کند برعکس کین","من با او جز لطف و محبت نکردم، پس چرا او با من دشمنی و کینه‌ورزی می‌کند؟"],[179,"هر عداوت را سبب باید سند","ورنه جنسیت وفا تلقین کند","هر دشمنی باید دلیلی داشته باشد، وگرنه وفا و دوستی را به‌جای دشمنی جا می‌زند."],[179,"باز می‌گفت آدم با لطف و جود","کی بر آن ابلیس جوری کرده بود","آدم به لطف و بخشندگی خداوند اشاره می‌کند و می‌گوید که چگونه ابلیس بر او تأثیر گذاشت و او را به گمراهی کشاند."],[179,"آدمی مر مار و کزدم را چه کرد","کو همی‌خواهد مرورا مرگ و درد","انسانی مانند من و تو، دشمنی مانند ماری را چه کرده است که او به دنبال کشتن و آزار ماست؟"],[179,"گرگ را خود خاصیت بدریدنست","این حسد در خلق آخر روشنست","حسادت در انسان‌ها مانند غریزه‌ای است که در گرگ وجود دارد و این خاصیت، ناپسندی آن را در اختلافات و دشمنی‌ها آشکار می‌کند."],[179,"باز می‌گفت این گمان بد خطاست","بر برادر این چنین ظنم چراست","می‌گوید که او مدام می‌گفت که داشتن چنین گمان بدی نسبت به برادر اشتباه است و نمی‌داند چرا چنین ظنی به او دارد."],[179,"باز گفتی حزم سؤ الظن تست","هر که بدظن نیست کی ماند درست","اینجا مولانا اشاره می‌کند که تو بار دیگر گفتی که احتیاط و شنیدینی نسبت به سوءظن لازم است؛ اما در واقع، کسی که بدگمان نیست، چگونه می‌تواند به درستی باقی بماند؟"],[179,"صوفی اندر وسوسه وان خر چنان","که چنین بادا جزای دشمنان","صوفی در حیرت و تردید است و حال خر (که نماد جهل و نادانی است) نیز به همین صورت دچار مشکلات و بلاهایی شده که سزاوار دشمنانش است."],[179,"آن خر مسکین میان خاک و سنگ","کژ شده پالان دریده پالهنگ","این خر بیچاره در میان زمین و سنگ‌ها گیر افتاده و بار خویش را نیز به‌طور نامناسبی بر دوش دارد و پالان او پاره شده است."],[179,"کشته از ره جمله شب بی علف","گاه در جان کندن و گه در تلف","او (خر) در شب‌ها به خاطر نبود علف جانش در خطر و مرگ است، گاهی در حال جان کندن و گاهی در معرض هلاکت قرار دارد."],[179,"خر همه شب ذکر می‌کرد ای اله","جو رها کردم کم از یک مشت کاه","خر شب‌ها ذکر و دعا می‌کرد و از خداوند طلب می‌نمود، در حالی که برای او چیزی کمتر از یک مشت کاه ارزش نداشت و او را رها کرده بود."],[179,"با زبان حال می‌گفت ای شیوخ","رحمتی که سوختم زین خام شوخ","خر با حالتی نالان و دلتنگ، از شیخ‌ها می‌خواهد که به او رحم کنند؛ زیرا از دیوانگی و خوشمزگی‌اش در حال سوختن و ناراحتی است."],[179,"آنچ آن خر دید از رنج و عذاب","مرغ خاکی بیند اندر سیل آب","آن خر، رنج و عذابی که تجربه کرده، حالا مانند مرغی خاکی را می‌بیند که در میان سیل آب دچار مشکلات و سختی‌ها شده است."],[179,"بس به پهلو گشت آن شب تا سحر","آن خر بیچاره از جوع البقر","آن خر بیچاره، به علت گرسنگی و ناراحتی، به مدت طولانی و دردی بر روی پهلوهایش غلتید و نمی‌توانست خواب راحتی داشته باشد."],[179,"روز شد خادم بیامد بامداد","زود پالان جست بر پشتش نهاد","صبح شده است، خادم زود به نزد خر آمده و پالان (زین) را بر پشت او گذاشته است."],[179,"خر فروشانه دو سه زخمش بزد","کرد با خر آنچ زان سگ می‌سزد","خر به طرز بی‌شرمانه‌ای از سوی دیگر زخم‌هایی را برداشت می‌کند و با سگی که خود زخم‌هایی به او زده، با همدیگر در حال صحبت هستند."],[179,"خر جهنده گشت از تیزی نیش","کو زبان تا خر بگوید حال خویش","خر به علت تیزی نیش، وحشت‌زده و پریشان شده و از شدت درد آنچنان بی‌تاب است که اگر قادر بود، زبان باز می‌کرد تا حال و روز خود را بیان کند."],[180,"چونک صوفی بر نشست و شد روان","رو در افتادن گرفت او هر زمان","وقتی صوفی سوار بر مرکب شد و به سمت جلو حرکت کرد، همیشه در درگیری و مقابله با مشکلات و سختی‌ها بود."],[180,"هر زمانش خلق بر می‌داشتند","جمله رنجورش همی‌پنداشتند","هر لحظه مردم او را به حالت رنجور و بیمار می‌دیدند و به همین خاطر او نیز همیشه فکر می‌کرد که بیمار است."],[180,"آن یکی گوشش همی‌پیچید سخت","وان دگر در زیر کامش جست لخت","یکی از کاروانیان به شدت در گوشش درد می‌کرد و یکی دیگر در زیر دهانش چیزی سخت پیدا کرده بود."],[180,"وان دگر در نعل او می‌جست سنگ","وان دگر در چشم او می‌دید زنگ","دیگری در نعل این خر، به دنبال سنگ می‌گشت و آن یکی در چشم او، زنگی (زنگار) می‌دید."],[180,"باز می‌گفتند ای شیخ این ز چیست","دی نمی‌گفتی که شکر این خر قویست",": باز می‌گفتند ای شیخ این موضوع چیست؟ دیروز مگه نمیگفتی ، شکر خدا که این خر نیرومند است."],[180,"گفت آن خر کو بشب لا حول خورد","جز بدین شیوه نداند راه کرد","آن خر که شب‌ها فقط علف می‌خورد، جز به این روش نمی‌تواند راه برود و حرکت کند."],[180,"چونک قوت خر به شب لا حول بود","شب مسبح بود و روز اندر سجود","توان جسمی و sức خر در شب به اندازه‌ای نبود که بتواند حرکت کند، در نتیجه شب برای او مانند جایگاه عبادت و تسبیح بود و روز، زمان فرود آوردن سر به خاک و عبادت."],[180,"آدمی خوارند اغلب مردمان","از سلام علیکشان کم جو امان","بیشتر مردم آدمی‌خوار هستند به‌ توجه و احترام ظاهری که نسبت به تو دارند، اعتماد مکن."],[180,"خانه دیوست دلهای همه","کم پذیر از دیومردم دمدمه","دل‌های مردم، از دیو و نیروی بد او استقبال نمی‌کنند و جایی برای آن ندارند. دیو در اینجا نماد شر و بدی است و اشاره به این دارد که انسان‌ها به خوبی‌های درون خود بیشتر اهمیت می‌دهند."],[180,"از دم دیو آنک او لا حول خورد","همچو آن خر در سر آید در نبرد","کسی که از دام و فریب دیو (نماد شر) فرار نکند، مانند همان خر (حیوانی که نشانه نادانی است) در جنگ و نبرد شکست می‌خورد و به زانو در می‌آید."],[180,"هر که در دنیا خورد تلبیس دیو","وز عدو دوست‌رو تعظیم و ریو","هر کس که در دنیا به فریب و نیرنگ شیطان بیفتد، و از دشمنی که به ظاهر دوست‌رو و دوست‌نماست، ستایش و تمجید ببیند."],[180,"در ره اسلام و بر پول صراط","در سر آید همچو آن خر از خباط","در راه دین اسلام و بر پل صراط همچون آن خر، لرزلرزان فرو می‌افتد."],[180,"عشوه‌های یار بد منیوش هین","دام بین ایمن مرو تو بر زمین","عشق و زیبایی‌های یار را فریبنده و مخرّب می‌داند، پس از آن بپرهیز و در دام آن‌ها نیفت. هرگز نباید با خیال راحت و ایمن بر زمین زندگی کنی، چون ممکن است به زحمت بیفتی."],[180,"صد هزار ابلیس لا حول آر بین","آدما ابلیس را در مار بین","در میان مردم، صدها هزار ابلیس وجود دارد که هیچ قدرتی ندارند و فقط در ظاهر به شکل انسان‌ها دیده می‌شوند؛ ابلیس اصلی را در افعی (مار) ببین."],[180,"دم دهد گوید ترا ای جان و دوست","تا چو قصابی کشد از دوست پوست","قصاب به تو (دوست) می‌گوید که با دم زدن و دعوت کردن به جان او نزدیک می‌شود، تا مثل قصابی که پوست می‌کند، تو را از دوست جدا کند."],[180,"دم دهد تا پوستت بیرون کشد","وای او کز دشمنان افیون چشد","می‌گوید اگر کسی با نیرنگ تو را فریب دهد تا تو را از خود جدا کند، وای بر او که همچون دشمنی است که به تو آسیب می‌زند و تو را به افیونی مصیبت‌بار دچار می‌کند."],[180,"سر نهد بر پای تو قصاب‌وار","دم دهد تا خونت ریزد زار زار","نفس یا وسوسه درونی در حال ستم به توست و مانند یک قصاب که بر سر مشتری می‌رود، می‌خواهد تو را به درد و رنج بیندازد و خون دلت را به شدت بریزد."],[180,"همچو شیری صید خود را خویش کن","ترک عشوه اجنبی و خویش کن","مثل شیر، شکار خود را مال خود کن و از فریب و زرق و برق بیگانه دست بردار و به خود و خویشاوندان خود بپرداز."],[180,"همچو خادم دان مراعات خسان","بی‌کسی بهتر ز عشوه ناکسان","به مانند خدمتگزاری که به حال بی‌کسان توجه دارد، من هم به بی‌کسی و تنهایی بیشتر اهمیت می‌دهم تا به ناز و اداهای افرادی که ارزشمند نیستند."],[180,"در زمین مردمان خانه مکن","کار خود کن کار بیگانه مکن","در این بیت هشدار داده می‌شود که در میان مردم و جامعه زندگی نکن و به کار و مسئولیت‌های خود بپرداز، بلکه به کارهای دیگران و بیگانگان اهمیت نده. یعنی فرضیات و دغدغه‌های اجتماعی را رها کن و روی خودت تمرکز کن."],[180,"کیست بیگانه تن خاکی تو","کز برای اوست غمناکی تو","این بیت اشاره به این دارد که غم و ناراحتی تو برای چه کسی است؛ آیا برای این جسم خاکی (تن) که بیگانه است و وابستگی واقعی به تو ندارد؟"],[180,"تا تو تن را چرب و شیرین می‌دهی","جوهر خود را نبینی فربهی","تا زمانی که تو به تن خود را با لذت‌ها و نعمت‌ها سیراب می‌کنی، نمی‌توانی جوهر واقعی وجود خود را ببینی و فهمی عمیق از آن ندارید."],[180,"گر میان مشک تن را جا شود","روز مردن گند او پیدا شود","اگر در وجود انسان، یعنی در «تن» او، عطر خوش «مشک» جای بگیرد، در روز قیامت هنگام مرگ بوی ناخوش آن «گند» (بدبویی) پدیدار خواهد شد."],[180,"مشک را بر تن مزن، بر دل بمال","مشک چه‌بود نام پاک ذوالجلال","به جای اینکه بویی از مشک را بر بدن خود بیاویزی، آن را بر دل خود بکش، زیرا نام پاک خداوند (ذوالجلال) نسبت به بوی مشک، ارزش و عظمتی بسیار بیشتری دارد."],[180,"آن منافق مشک بر تن می‌نهد","روح را در قعر گلخن می‌نهد","منافقان فقط به ظواهر می‌پردازند و خود را زینت می‌کنند، اما در درونشان، روح و ذاتشان در بدبختی و پستی قرار دارد."],[180,"بر زبان نام حق و، در جان او","گندها از فکر بی ایمان او","در زبان این شخص، نام خداوند جاری است اما در درون او، فکر و اندیشه‌ای ناپاک و بی‌ایمان وجود دارد."],[180,"ذکر با او همچو سبزه گلخنست","بر سر مبرز گلست و سوسنست","یاد کردن از خداوند مانند سبزه‌ای است که در مکانی کثیف و بدبو می‌روید، اما بر روی آن گل‌های زیبا و خوشبو مثل گل و سوسن هم وجود دارد."],[180,"آن نبات آنجا یقین عاریتست","جای آن گل مجلسست و عشرتست","آن گیاه (نبات) در آنجا به‌طور قطع امانتی است و جای آن گل ، جا و مکانی برای خوشی و شادی است."],[180,"طیبات آید به سوی طیبین","للخبیثین الخبیثات است هین","خوبی‌ها و چیزهای نیکو به سوی نیکوکاران می‌آید، اما چیزهای زشت و بد به سوی زشت‌کاران و افراد بدجنس می‌رود. بنابراین، مراقب باشید که ارتباط با افراد بد، شما را نیز به سمت بدی سوق می‌دهد."],[180,"کین مدار؛ آنها که از کین گمرهند","گورشان پهلوی کین‌داران نهند","کینه را حفظ نکن و نگهداری نکن؛ زیرا کسانی که به خاطر کینه گمراه شده‌اند، در نزد کسانی که کینه دارند دفن خواهند شد."],[180,"اصل کینه دوزخست و کین تو","جزو آن کلست و خصم دین تو","کینه اصلیت دوزخی است و کینه‌ای که در دل تو وجود دارد، بخشی از آن کینه کلی است که دشمن دین توست."],[180,"چون تو جزو دوزخی پس هوش دار","جزو سوی کل خود گیرد قرار","چون تو بخشی از دوزخ هستی، پس هوشیار باش که بخشی از کل وجودت، آرامش و ثبات می‌یابد."],[180,"ور تو جزو جنتی ای نامدار","عیش تو باشد ز جنت پایدار","اگر تو بخشی از بهشت هستی، ای شخصیت برجسته، زندگی تو از سرای جاویدان بهشت شیرین و خوش خواهد بود."],[180,"تلخ با تلخان یقین ملحق شود","کی دم باطل قرین حق شود","چیزهای تلخ، با تلخی‌های دیگر پیوند می‌خورند و هیچ‌گاه حقیقت نمی‌تواند با دروغ همراه شود."],[180,"ای برادر تو همان اندیشه‌ای","ما بقی تو استخوان و ریشه‌ای","ای برادر، تو همان تفکری که داری، بقیه وجودت فقط جسم و ریشه‌ای است که به این فکر متصل است."],[180,"گر گلست اندیشه تو، گلشنی","ور بود خاری، تو هیمه گلخنی","اگر اندیشه تو مانند گل باشد، بهشت زیبا و دل‌نشینی است و اگر خاری باشد، تو باعث آزار و زحمت گلستان خواهی بود."],[180,"گر گلابی، بر سر جیبت زنند","ور تو چون بولی، برونت افکنند","اگر تو گلابی باشی، بر سر تو عطری و خوشبو خواهند زد؛ اما اگر بویی مانند بوی ادرار داشته باشی، تو را به دور خواهند انداخت."],[180,"طبله‌ها در پیش عطاران ببین","جنس را با جنس خود کرده قرین","در پیش عطاران، در زمان دیدن، می‌توانید ببینید که در دنیای عطاران، انواع و اقسام اجناس خوب و بد، هریک با هم هم‌جنس و قرین شده‌اند."],[180,"جنسها با جنسها آمیخته","زین تجانس زینتی انگیخته","جنس‌های مختلف با هم ترکیب شده‌اند و این هماهنگی بین آن‌ها باعث ایجاد زیبایی شده است."],[180,"گر در آمیزند عود و شکّرش","برگزیند یک‌یک از یک‌دیگرش","اگر عود (بوی خوش) و شکر (میان‌برنده و شیرین) با هم ترکیب شوند، هر یک به‌طور جداگانه، ویژگی خاص خود را حفظ می‌کند و از یکدیگر جدا می‌شوند."],[180,"طبله‌ها بشکست و جانها ریختند","نیک و بد درهمدگر آمیختند","در اینجا اشاره به یک واقعه‌ی معنوی است که در آن، وقتی «طبله‌ها» (که ممکن است به ابزار و وسایل دنیوی اشاره داشته باشد) شکسته می‌شود، جان‌ها آزاد می‌شوند و در این آزادسازی، خوبی‌ها و بدی‌ها به هم آمیخته می‌شوند. این آمیختگی نمادی از اختلاط جنبه‌های مختلف وجود انسان و پیوستگی آن‌ها به یکدیگر است."],[180,"حق فرستاد انبیا را با ورق","تا گزید این دانه‌ها را بر طبق","خداوند پیامبران را با کتاب‌هایی فرستاد تا این اندیشه‌ها و نکات مهم را بر اساس حقیقت جیوه‌ای انتخاب کند."],[180,"پیش از ایشان ما همه یکسان بدیم","کس ندانستی که ما نیک و بدیم","قبل از آمدن انبیا، همه ما شبیه به هم بودیم و هیچ‌کس ندانست که ما نیکو و بد هستیم."],[180,"قلب و نیکو در جهان بودی روان","چون همه شب بود و ما چون شب‌روان","قلب و خوبی در دنیا وجود داشتند و همیشه در حال حرکت بودند، مانند شب‌روانی که در تاریکی شب به سیر و سفر می‌پردازند."],[180,"تا بر آمد آفتاب انبیا","گفت ای غش دور شو، صافی بیا","هنگامی که آفتاب علم و دانش انبیا طلوع کرد، انبیا به مردم گفتند: ای کسی که در غفلت و جهل هستی، از این حال بیرون بیا و به صفای درک و فهم پیوسته شو."],[180,"چشم داند فرق کردن رنگ را","چشم داند لعل را و سنگ را","چشم انسان می‌تواند تفاوت رنگ‌ها را تشخیص دهد و لعل (گوهر) را از سنگ جدا کند."],[180,"چشم داند گوهر و خاشاک را","چشم را زان می‌خلد خاشاکها","چشم انسان می‌تواند بین گوهر (ارزشمند) و خاشاک (چیزهای بی‌ارزش) تفاوت قائل شود، اما از آن‌جایی که چشم فریب می‌خورد، ممکن است به آسانی فریب خاشاک‌ها را بخورد و آن‌ها را با چیزهای با ارزش اشتباه بگیرد."],[180,"دشمن روزند این قلابکان","عاشق روزند آن زرهای کان","دشمنان کسانی هستند که به نظر می‌رسد فقط به دنیا و چیزهای فانی علاقه‌مندند، اما عاشقان واقعی به حقایق و امور معنوی دست می‌یابند، که همانند زر و ثروت واقعی هستند."],[180,"زانک روزست آینه تعریف او","تا ببیند اشرفی تشریف او","چون روز است، آینه‌ای برای تعریف او (خدا) به شمار می‌آید، زیرا در روز می‌توان به وضوح ارزش و مقام او را مشاهده کرد."],[180,"حق قیامت را لقب زان روز کرد","روز بنماید جمال سرخ و زرد","در روز قیامت، حقیقت و واقعیت آشکار می‌شود و آن روز، چهره‌های زیبای سرخ و زرد را نشان می‌دهد."],[180,"پس حقیقت روز سر اولیاست","روز پیش ماهشان چون سایه‌هاست","حقیقت روز در آغاز آن روزی است که افراد حق را می‌شناسند و در نگاه آن‌ها، نور و زیبایی حق مانند روشنایی ماه دانسته می‌شود؛ یعنی نور حقیقی در برابر آنها همچون سایه‌ای است که فعالیت و درک آن روز را تحت‌الشعاع قرار می‌دهد."],[180,"عکس راز مرد حق دانید روز","عکس ستاریش شام چشم‌دوز","شما باید بدانید که حقیقت و راز وجود انسان‌های حقیقی (مرد حق) مانند روز است، ولی حالتی عکس و معکوس دارد، یعنی در شب و تاریکی قابل درک‌تر است؛ زیرا چشم‌های بسته (چشم‌دوز) نمی‌توانند آن را ببینند."],[180,"زان سبب فرمود یزدان والضحی","والضحی نور ضمیر مصطفی","به همین دلیل، خداوند در آیه «والضحی» به نور و روشنی دل پیامبر مصطفی اشاره کرده است."],[180,"قول دیگر کین ضحی را خواست دوست","هم برای آنک این هم عکس اوست","برخی می‌گویند که چون صبح و روشنایی (ضحی) را خدا خواسته، این نیز نشان‌دهنده رابطه دوطرفه است، چرا که خود صبح هم تصویری از وجود حقیقی اوست."],[180,"ورنه بر فانی قسم گفتن خطاست","خود فنا چه لایق گفت خداست","اگر غیر از فنا خدا قسم بخورد، این کار اشتباه است، زیرا خود فنا شایستگی سخن گفتن از خدا را ندارد."],[180,"از خلیلی لا احب الافلین","پس فنا چون خواست رب العالمین","حضرت ابراهیم (خلیل) می‌گوید که من آخرت (افول) را دوست ندارم، پس وقتی خداوند (رب العالمین) خواست که از چیزی فنا شود، چگونه ممکن است؟"],[180,"لا احب افلین گفت آن خلیل","کی فنا خواهد ازین رب جلیل","خلیل یعنی ابراهیم ادهم، می‌گوید که من کسانی را که رخت از دنیا بربسته و زائل شده‌اند، دوست ندارم. او می‌پرسد که آیا از این خدای بزرگ، کسی به فنا خواهد رسید؟"],[180,"باز واللیل است ستاری او","وان تن خاکی زنگاری او","صورت شب بر می‌گردد و ستاره‌اش درخشانی خاصی دارد، اما این بدن خاکی که تاریکی و زنگار دارد، در برابر آن نور چیزی نیست."],[180,"آفتابش چون برآمد زان فلک","با شب تن گفت هین ما ودعک","چون آفتاب از افق طلوع کرد و شب را ترک گفت، تن (جسم) به شب گفت که وداع کن."],[180,"وصل پیدا گشت از عین بلا","زان حلاوت شد عبارت ما قلی","به‌دلیل بلا و سختی‌هایی که متحمل شدیم، به وصلی رسیدیم و این تجربه باعث شده عبارت ما شیرین و دل‌انگیز شود."],[180,"هر عبارت خود نشان حالتیست","حال چون دست و عبارت آلتیست","هر جمله‌ای که ما می‌گوییم، بیانگر یک حالت و احساس خاصی است. مانند این است که دست یک فرد، ابزاری برای انجام کارها باشد."],[180,"آلت زرگر به دست کفشگر","همچو دانه کشت کرده ریگ در","آلت زرگر (ابزار طلا سازی) در دست کفشگر (کسی که کفش می‌سازد) مانند دانه‌ای است که در زمین نامناسب (ریگ) کاشته شده است. این بیان نادرستی و عدم تناسب استفاده از ابزارها را نشان می‌دهد."],[180,"و آلت اسکاف پیش برزگر","پیش سگ که، استخوان در پیش خر","در این بیت، اشاره به این است که وقتی ابزار یک حرفه‌ای (اسکاف که به معنای کفاش است) در دست کسی غیر از صاحب‌کارش (برزگر، یعنی کشاورز) باشد، به اندازه استخوانی در برابر خر، ارزش و تأثیر ندارد. این نشان‌دهنده بی‌مفهمی یا ناآشنایی فرد با ملزومات و ابزاروفنون کاری است که در دست دارد."],[180,"بود انا الحق در لب منصور نور","بود انا الله در لب فرعون زور","منصورالحلاج، عارف و صوفی مشهور، به جمله «أنا الحق» (من حقیقت هستم) معروف است که بیانگر وحدت وجود و حقیقت روحانی اوست. در مقابل، فرعون به عنوان نماد قدرت و زور، جملاتی درباره‌ی خداوند و خود بر زبان می‌آورد که نشان‌دهنده‌ی سرکشی و استکبار اوست. این بیت به تضاد بین حقیقت معنوی منصور و زورگویی فرعون اشاره دارد."],[180,"شد عصا اندر کف موسی گوا","شد عصا اندر کف ساحر هبا","عصای موسی در دست او معجزه‌ای بزرگ بود و عصای جادوگران نیز فقط توانستند خلق و خوی سحر را نشان دهند."],[180,"زین سبب عیسی بدان همراه خود","در نیاموزید آن اسم صمد","به همین دلیل، عیسی نتوانست آن نام خاص و عظیم (صمد) را که به معنای بی‌نیازی و کمال است، از همراه خود (موسی) بیاموزد."],[180,"کو نداند نقص بر آلت نهد","سنگ بر گل زن تو آتش کی جهد","کسی که نمی‌داند نقص (عیب) بر ابزار (آلت) وجود دارد، چگونه می‌تواند سنگ (وزن) را بر گل (ماده) زننده بگذارد؟ با این حال، تو (انسان) باید آتش (عشق یا تلاش) را به کار بیندازی و به جلو برانی."],[180,"دست و آلت همچو سنگ و آهنست","جفت باید جفت شرط زادنست","دست و اعضای بدن مانند سنگ و آهن هستند و برای به بار نشستن، باید با هم جفت شوند؛ این جفت بودن یکی از شروط زایش و تولید است."],[180,"آنک بی جفتست و بی آلت یکیست","در عدد شکست و آن یک بی‌شکیست","آن کسی که بدون همدم و بدون وسیله است، در واقع به تنهایی معنای واحدی دارد و در شمار دو یا چند نیست. او یک وجود محض است که هیچ نقصی ندارد و در کثرت وجود ندارد."],[180,"آنک دو گفت و سه گفت و بیش ازین","متفق باشند در واحد یقین","هر کس می‌تواند وقتی در موضوعی با همدیگر سخن بگویند، حتی اگر تعداد آنان بیشتر از دو یا سه باشد، در یک یقین وحدت داشته باشند و بر سر آن باور مشترک به توافق برسند."],[180,"احولی چون دفع شد یکسان شوند","دو سه گویان هم یکی گویان شوند","زمانی که وابستگی‌ها و حالتی خاص از بین برود، افرادی که پیش از این درباره موضوعی مختلف صحبت می‌کردند، یکسان و متحد خواهند شد و هم‌نظر خواهند شد."],[180,"گر یکی گویی تو در میدان او","گرد بر می‌گرد از چوگان او","اگر تو در میدان مسابقه، تنها یک نفر باشی که حرفی بزند، تو هم به دور او می‌چرخانی، مانند نحوه حرکت گوی در بازی چوگان."],[180,"گوی آنگه راست و بی نقصان شود","کو ز زخم دست شه رقصان شود","وقتی که در میدان، زخم دست پادشاه باعث به حرکت درآمدن درست و بدون نقص گوی شود، یعنی آن گوی به خوبی و بدون نقص به گردش درمی‌آید."],[180,"گوش دار ای احول اینها را بهوش","داروی دیده بکش از راه گوش","ای احول (نابینا)، گوش‌هات را باز کن و به این مطالب توجه کن؛ داروی بینایی را از طریق گوش دریافت کن، نه از طریق چشم."],[180,"پس کلام پاک در دلهای کور","می‌نپاید می‌رود تا اصل نور","کلام پاک و حقیقت در دل‌های افرادی که ناآگاه یا کوربین هستند، دوام نمی‌آورد و به جایی نمی‌رسد؛ بلکه به سمت منبع اصلی نور و روشنایی حرکت می‌کند."],[180,"وان فسون دیو در دلهای کژ","می‌رود چون کفش کژ در پای کژ","جادوی شیطانی به دل‌های کج‌فهم و وارونه نفوذ می‌کند، مانند این‌که یک کفش نادرست به پای فردی با قدمی کج می‌افتد و او را دچار مشکل می‌کند."],[180,"گرچه حکمت را به تکرار آوری","چون تو نااهلی شود از تو بری","هرچند که می‌توانی حکمت را بارها تکرار کنی، اما اگر خودت شایستگی و درک لازم را نداشته باشی، آن حکمت از تو دور خواهد شد."],[180,"ورچه بنویسی نشانش می‌کنی","ورچه می‌لافی بیانش می‌کنی","اگرچه تو نوشته‌ای و نشانی به دیگران می‌دانی، ولی اگر صرفا با لاف و سخنان تند از آن یاد کنی، در واقع معنای واقعی آن را بیان نکرده‌ای."],[180,"او ز تو رو در کشد ای پر ستیز","بندها را بگسلد وز تو گریز","او به خاطر ستیزه‌جویی تو از تو دور می‌شود و باعث می‌شود که تمامی محدودیت‌ها و قید و بندها را بشکند و از تو فرار کند."],[180,"ور نخوانی و ببیند سوز تو","علم باشد مرغ دست‌آموز تو","اگر تو نخوانی و آن سوزی که در دل داری را نبیند، آن علم و دانشی که در دست تو هست، همچون مرغی خواهد بود که تحت تعلیم تو است و به معنای واقعی نمی‌تواند از آن بهره‌مند شود."],[180,"او نپاید پیش هر نااوستا","همچو طاووسی به خانه روستا","او مانند طاووسی که به خانه یک روستا می‌رود، در مواجهه با هر فرد نادانی نمی‌ماند و برمی‌گردد."],[181,"دین نه آن بازیست کو از شه گریخت","سوی آن کمپیر کو می آرد بیخت","دین آن چیزی نیست که کسی به خاطر ترس از حاکم (شاه) از آن فاصله بگیرد و به سوی زنی که فرزندانی را به دنیا می‌آورد پناه ببرد."],[181,"تا که تتماجی پزد اولاد را","دید آن باز خوش خوش‌زاد را","تا وقتی که باز در حال تخم‌گذاری بچه‌هایش را دید، بسیار خوشحال شد."],[181,"پایکش بست و پرش کوتاه کرد","ناخنش ببرید و قوتش کاه کرد","باز شاه را پایش را به بند کشیدند و بال‌هایش را کوتاه کردند. ناخن‌های او را بریدند و قدرتش را کاهش دادند."],[181,"گفت نااهلان نکردندت بساز","پر فزود از حد و ناخن شد دراز","نااهلان به تو (که به نوعی در مضیقه هستی) کمکی نکردند و به جای آن معایب تو را بیشتر کردند، به طوری که پرهایت (استعدادهایت) بیش از حد زیاد شد و ناخن‌هایت هم درازتر شد."],[181,"دست هر نااهل بیمارت کند","سوی مادر آ که تیمارت کند","دست هر بی‌تجربه و نادان، تو را بیمار می‌کند، اما تنها مادرت است که به خوبی از تو مراقبت می‌کند و حال تو را بهبود می‌بخشد."],[181,"مهر جاهل را چنین دان ای رفیق","کژ رود جاهل همیشه در طریق","دوستی، بدان که محبت و علاقه فرد نادان همیشه منحرف و کج است و او همواره در مسیر اشتباه قرار دارد."],[181,"روز شه در جست و جو بی‌گاه شد","سوی آن کمپیر و آن خرگاه شد","روز شاه در جستجوی او به جایی رسید که شب شده بود و به خانه آن زن سالخورده و خرگاه او رسید."],[181,"دید ناگه باز را در دود و گرد","شه برو بگریست زار و نوحه کرد","شه ناگهان شاه‌باز را در میان دود و گرد و غبار مشاهده کرد و به شدت گریه کرد و نوحه‌سرایی نمود."],[181,"گفت هرچند این جزای کار تست","که نباشی در وفای ما درست","او به شاه باز می‌گوید که هرچند این عذاب و کیفر ناشی از رفتار خود توست، اما دلیل آن نیست که در وفای ما درست و به‌جا نبوده‌ای."],[181,"چون کنی از خلد زی دوزخ فرار؟","غافل از «لا‌یستوی اصحاب نار»","چگونه می‌توانی از بهشت به جهنم فرار کنی، در حالی که غافلی از این موضوع که اهل جهنم هیچ‌گاه با اهل بهشت برابر نخواهند بود؟"],[181,"این سزای آنک از شاه خبیر","خیره بگریزد به خانه گنده‌پیر","کسی که از پادشاه آگاه و دانا فرار کند و به خانه زن سالخورده‌ای برود، سزاوار چنین عذاب و عاقبتی است."],[181,"باز می‌مالید پر بر دست شاه","بی‌زبان می‌گفت من کردم گناه","شاه، که مقام او به خوبی بر همگان روشن است، با پر از باز به سوی او می‌آید و باز بی‌زبان، در تلاش برای توجیه رفتار خود، می‌گوید که من مرتکب اشتباه شده‌ام."],[181,"پس کجا زارد کجا نالد لئیم؟","گر تو نپذیری به جز نیک ای کریم","پس لئیم (حقیر) کجا تولد می‌دهد و کجا ناله می‌کند؟ اگر تو، ای بخشنده بزرگوار، جز نیکی را نپذیری."],[181,"لطف شه جان را جنایت‌جو کند","زانک شه هر زشت را نیکو کند","لطف و مهربانی پادشاه (خدا) روح را به گناه وادار می‌کند، زیرا او هر چیزی را که زشت است، به زیبایی تبدیل می‌کند."],[181,"رو مکن زشتی که نیکی‌های ما","زشت آمد پیش آن زیبای ما","برخود نیاور زشتی را، زیرا نیکی‌های ما در برابر زیبایی او زشت به نظر می‌رسد."],[181,"خدمت خود را سزا پنداشتی","تو لوای جرم از آن افراشتی","تو خدمت خود را به قدر و ارزش می‌دانی، اما در عین حال در برابر آن، بار گناه و خطاهای خود را نیز نمایان کرده‌ای."],[181,"چون ترا ذکر و دعا دستور شد","زان دعا کردن دلت مغرور شد","وقتی که ذکر و دعا برای تو واجب و لازم شد، به خاطر این دعا کردن، دل تو به خود مغرور شد."],[181,"هم‌سخن دیدی تو خود را با خدا","ای بسا کو زین گمان افتد جدا","اگر تو با خدا سخن گفته‌ای و او را در دل خود حس کرده‌ای، بسا افرادی که به خاطر همین گمان، خود را از او دور می‌بینند و جدا می‌پندارند."],[181,"گرچه با تو شه نشیند بر زمین","خویشتن بشناس و نیکوتر نشین","هرچند که پادشاه (یا شخص مهمی) در کنار تو نشسته باشد و تو را بخواهد، باید خودت را بشناسی و بهتر و از برابر او با احترام بنشینی."],[181,"باز گفت ای شه پشیمان می‌شوم","توبه کردم نومسلمان می‌شوم","باز (که در اینجا نماد انسان یا روح است) به شاه (سلاطین) می‌گوید که از کرده خود پشیمان است و تصمیم دارد به خدایی کردن برگردد و مانند نو مسلمانان توبه کند."],[181,"آنک تو مستش کنی و شیرگیر","گر ز مستی کژ رود عذرش پذیر","تو کسی را مست می‌کنی و در عین حال از او می‌طلبی که شجاع و قوی شود. اگر او از حالت مستی خارج شود و کارش نادرست باشد، عذر او را بپذیر."],[181,"گرچه ناخن رفت چون باشی مرا","بر‌کنم من پرچم خورشید را","هرچند که ناخن من (یعنی بدن من) از بین برود، اما اگر تو با من باشی، من به نور و وجود خود (تصویر تابندگی خورشید) ادامه می‌دهم."],[181,"ورچه پرم رفت چون بنوازی‌ام","چرخ بازی گم کند در بازی‌ام","هرچند که من پرشید و انرژی‌ام را از دست داده‌ام، اگر به من نوازش کنی، چرخ فلک و گردش زمان را در بازی زندگی‌ام فراموش می‌کنم."],[181,"گر کمر بخشیم که را برکنم","گر دهی کلکی علمها بشکنم","اگر کمر خود را محکم کنیم، می‌توانم کوه‌ها را بشکافم و اگر به من ترفند و نیرنگی بدهی، می‌توانم علم و دانش را فاسد کنم."],[181,"آخر از پشه نه کم باشد تنم","ملک نمرودی به پر برهم زنم","حتی اگر من از پشه کوچک‌تر هم باشم، باز هم می‌توانم مانند نمرود، پادشاه بدار و سرکش، در چنگال خودم کل مملکت را به هم بریزم و نابود کنم."],[181,"در ضعیفی تو مرا بابیل گیر","هر یکی خصم مرا چون پیل گیر","به خاطر ناتوانی من، تو باید به من همچون بابل (شهر بزرگ و مستحکم) نگاه کنی و به هر دشمنی که مرا تهدید می‌کند، مانند فیل (نیروی عظیم و مستحکم) بپردازی."],[181,"قدر فندق افکنم بندق حریق","بندقم در فعل صد چون منجنیق","من قدرتی دارم که می‌توانم به شدت و فشاری مانند منجنیق (وسیله قدیمی جنگی) به کار ببرم، ولی اندازه این قدرت و اثرگذاری‌ام شاید به اندازه یک فندق باشد."],[181,"گرچه سنگم هست مقدار نخود","لیک در هیجا نه سر ماند نه خود","هرچند من از نظر اندازه به یک نخود هستم و در این مقایسه کوچک به نظر می‌آیم، اما در واقع در هیچ اجتماعی نه نام و نشانی دارم و نه وجودی مشخص."],[181,"موسی آمد در وغا با یک عصاش","زد بر آن فرعون و بر شمشیرهاش","موسی با عصای خود به سمت فرعون رفت و او را به چالش کشید، حتی با وجود خطراتی که شمشیرهای فرعونیان به همراه داشت."],[181,"هر رسولی یک‌تنه کان در زدست","بر همه آفاق تنها بر زدست","هر پیامبری باید به‌تنهایی با مشکلات و چالش‌ها روبرو شود و بر تمام دنیا تأثیرگذار باشد، حتی اگر خودش تنها باشد."],[181,"نوح چون شمشیر در خواهید ازو","موج طوفان گشت ازو شمشیرخو","نوح، چنان که شمشیری از او بیرون می‌آید، در مواجهه با طوفان و به خاطر آن موج‌های سخت و خطرناک، به قدرت و اراده خدا تکیه می‌کند."],[181,"احمدا خود کیست اسپاه زمین؟","ماه بین بر چرخ و بشکافش جبین","آدم نادانی که به آن اشاره شده، کیست که بر روی زمین، درستی‌ها و حقیقت‌ها را نمی‌بیند؟ ای ماه، بر در آسمان ببین و با روشنایی‌ات، پیشانی‌اش را بشکاف تا حقیقت برایش روشن شود."],[181,"تا بداند سعد و نحس بی‌خبر","دور تست این دور نه دور قمر","این دور، دوری است که در آن سعد و نحس (خوشبختی و بدبختی) را نمی‌توان شناخت، و این دور به دور قمر (ماه) مربوط نمی‌شود، بلکه از آن فراتر است."],[181,"دور تست ایرا که موسی کلیم","آرزو می‌برد زین دورت مقیم","موسی کلیم (یعنی حضرت موسی) آرزوی دیدن جمال و نور الهی را دارد، و این دور که تو در آن هستی، نقطه‌ای است که او به خاطر آن آرزو می‌کند و در اینجا ساکن می‌شود."],[181,"چونک موسی رونق دور تو دید","کاندرو صبح تجلی می‌دمید","موسی وقتی رونق و زیبایی دور تو را مشاهده کرد، آنجا بود که صبح تجلی حقیقت می‌تابید."],[181,"گفت یارب آن چه دور رحمتست","آن گذشت از رحمت آنجا رؤیتست","موسی (پیامبر) می‌گوید: ای پروردگار، آنچه که دور از رحمت توست، از رحمت تو فاصله گرفته و رؤیت (مشاهده حقیقت) در آنجا وجود ندارد."],[181,"غوطه ده موسی خود را در بحار","از میان دوره احمد بر آر","موسی (پیامبر) را به دعوت می‌کند که خود را در دریاهای عمیق غوطه‌ور کند و از میان دوره احمد (پیامبر اسلام) خود را بالا بکشد و به کمالات او دست یابد."],[181,"گفت یا موسی بدان بنمودمت","راه آن خلوت بدان بگشودمت","موسی را گفتند که به تو راه خلوت و نزدیکی به خداوند را نشان دادم و این رهنمودی برای توست."],[181,"که تو زان دوری درین دور ای کلیم","پا بکش زیرا درازست این گلیم","ای موسی، تو از دوری در این دنیای بزرگ خیلی ناراحتی؛ پس از این موقعیت دوری کن و پا را به جلو بگذار، چرا که این مسیر طولانی است و تو می‌توانی موفق‌تر عمل کنی."],[181,"من کریمم نان نمایم بنده را","تا بگریاند طمع آن زنده را","من بخشنده‌ام و نان می‌دهم تا اینکه بنده را به گریه بیندازد و طمع آن زنده را برانگیزد."],[181,"بینی طفلی بمالد مادری","تا شود بیدار و وا جوید خوری","اگر ببینی کودکی به دامن مادرش دست می‌مالد تا بیدار شود و غذا طلب کند، این نشان از نیاز شدید و کوشش او برای برآورده شدن خواسته‌اش است."],[181,"کو گرسنه خفته باشد بی‌خبر","وان دو پستان می‌خلد زو مهر در","کسی که گرسنه است و در خواب به سر می‌برد، بی‌خبر از این دو پستان است که به او محبت و نوازش می‌کنند."],[181,"کنت کنزا رحمة مخفیة","فابتعثت امة مهدیة","تو در ذات خود رحمت مخفی‌ای بودی که آن را بیدار کردی و امتی هدایت‌یافته را به ظهور رساندی."],[181,"هر کراماتی که می‌جویی بجان","او نمودت تا طمع کردی در آن","هر معجزه و فضیلتی که دنبالش هستی، به خاطر جان او به تو نمایش داده می‌شود، تا زمانی که به آن تمایل پیدا کردی."],[181,"چند بت بشکست احمد در جهان","تا که یا رب گوی گشتند امتان","احمد (پیامبر اسلام) در طول تاریخ، بت‌های زیادی را در جهان نابود کرد تا اینکه ای خدا، افرادی که به او ایمان آورده و گروهی از پیروان او شدند، به اسامی مسلمانان معروف شدند."],[181,"گر نبودی کوشش احمد تو هم","می‌پرستیدی چو اجدادت صنم","اگر تلاش‌های احمد (پیامبر اسلام) نبود، تو هم مانند نیاکانت به پرستش بت‌ها ادامه می‌دادی."],[181,"این سرت وا رست از سجده صنم","تا بدانی حق او را بر امم","سرت از سجده بت‌ها آزاد شده است تا بدانی که حق خدا بر مردم چیست."],[181,"گر بگویی شکر این رستن بگو","کز بت باطن همت برهاند او","اگر بگویی که باید بخاطر این رهایی از سجده بتی که در باطن داری شکرگزاری کنی، بگو که در حقیقت کسی تو را از آن بت نجات داده است."],[181,"مر سرت را چون رهانید از بتان","هم بدان قوّت تو دل را وا رهان","وقتی که سرت را از بت‌های درونت آزاد کردی، با همان نیرویی که به دست آوردی، دل خود را هم رها کن."],[181,"سر ز شکر دین از آن برتافتی","کز پدر میراث مفتش یافتی","تو به خاطر شکرگزاری از دین، از سر خود دل برمی‌داری، زیرا از پدرت ارثی بی‌زحمت به دست آورده‌ای."],[181,"مرد میراثی چه داند قدر مال؟","رستمی جان کند و مجان یافت زال","مردی که به ارث مال و دارایی رسیده، هیچ نمی‌فهمد که این ثروت چقدر ارزش دارد؛ مثل رستم که با جان‌فشانی، زال (پدرش) را به دست آورد و به این خاطر آن را به حق و با زحمت کسب کرده است."],[181,"چون بگریانم، بجوشد رحمتم","آن خروشنده بنوشد نعمتم","هرگاه من به گریه وادار شوم، رحمت و دلسوزی‌ام بیدار می‌شود و آن شخص خروشنده که به من توجه می‌کند، از نعمت‌های من بهره‌مند می‌شود."],[181,"گر نخواهم داد، خود ننمایمش","چونش کردم بسته دل بگشایمش","اگر نخواهم چیزی را به کسی بدهم، خودم آن را نشان نمی‌دهم؛ اما اگر دل او را بسته‌ام، می‌توانم آن را باز کنم."],[181,"رحمتم موقوف آن خوش‌گریه‌هاست","چون گریست، از بحر رحمت موج خاست","رحمت من وابسته به گریه‌های زیبا و دل‌نشین است، و هنگامی که او گریه کند، به مانند یک موج از دریای رحمت، رحمت فراوانی به وجود می‌آید."],[182,"بود شیخی دایما او وامدار","از جوانمردی که بود آن نامدار","شیخی بزرگ و جوانمرد بود که وام زیادی بر گردن او بود."],[182,"ده هزاران وام کردی از مهان","خرج کردی بر فقیران جهان","از افراد غنی وام می‌گرفت و خرج فقیران می‌کرد."],[182,"هم به وام او خانقاهی ساخته","جان و مال و خانقه در باخته","با همان وام‌ها خانقاهی ساخته بود و زندگیش را وقف خانقاه کرده بود."],[182,"وام او را حق ز هر جا می‌گزارد","کرد حق بهر خلیل از ریگ آرد","خدا به طرق مختلف وام‌های او را تسویه می‌کرد، همان طور که ریگ بیابان را برای حضرت موسی تبدیل به آرد کرد."],[182,"گفت پیغامبر که در بازارها","دو فرشته می‌کنند ایدر دعا","پیامبر فرمود که دو فرشته در بازارها دعا می‌کنند."],[182,"کای خدا تو منفقان را ده خلف","ای خدا تو ممسکان را ده تلف","که ای خدا! به سخاوت‌مندان برکت بده و مالشان را چند برابر کن و کسب و کار خسیسان را دچار زیان کن"],[182,"خاصه آن منفق که جان انفاق کرد","حلق خود قربانی خلاق کرد","به ویژه آن سخاوتمندی که جان خود را در راه خدا قربانی کرد (اشاره به قربانی کردن حضرت اسماعیل توسط حضرت ابراهیم)"],[182,"حلق پیش آورد اسمعیل‌وار","کارد بر حلقش نیارد کرد کار","مانند اسماعیل گلوی خود را پیش آورد و کارد بر گلوی او کارگر نبود"],[182,"پس شهیدان زنده زین رویند و خوش","تو بدان قالب بمنگر گبروش","به همین دلیل است که شهیدان زنده‌اند و مانند کفار به جسم مرده شهدا نگاه نکن"],[182,"چون خلف دادستشان جان بقا","جان ایمن از غم و رنج و شقا","چون خداوند جانشینان را زندگی جاوید داده است، جان آنها از غم و رنج و مصیبت ایمن و در امان است."],[182,"شیخ وامی سالها این کار کرد","می‌ستد می‌داد همچون پای‌مرد","سال‌ها کار شیخ همین وام گرفتن و بخشش بود و در این راه خستگی نمی‌شناخت"],[182,"تخمها می‌کاشت تا روز اجل","تا بود روز اجل میر اجل","او مرتب کار نیک می‌کرد تا در روز مرگ، از مردن باکی نداشته باشد"],[182,"چونک عمر شیخ در آخر رسید","در وجود خود نشان مرگ دید","زمانی که عمر شیخ به پایان رسید، در وجود خود نشانه‌های مرگ را مشاهده کرد."],[182,"وام‌داران گرد او بنشسته جمع","شیخ بر خود خوش گدازان همچو شمع","طلبکاران دور او نشسته‌اند و شیخ مانند شمعی در حال خاموشی است."],[182,"وام‌داران گشته نومید و ترش","درد دلها یار شد با درد شش","وام‌داران که به خاطر مشکلات مالی و ناامیدی به دور شیخ جمع شده بودند، دیگر به جای امیدواری، به درد دل‌هایشان عادت کردند و این درد به دوست همیشگی آن‌ها تبدیل شده است."],[182,"شیخ گفت این بدگمانان را نگر","نیست حق را چارصد دینار زر!؟","شیخ می‌گوید که این بدگمانان به خداوند، آیا واقعا فکر می‌کنند که خداوند چهارصد دینار طلا ندارد؟"],[182,"کودکی حلوا ز بیرون بانگ زد","لاف حلوا بر امید دانگ زد","کودکی در بیرون فریاد می‌زد که حلوا دارد و با امید به اینکه کسی به او توجه کند، خود را به نمایش گذاشته است."],[182,"شیخ اشارت کرد خادم را به سر","که برو آن جمله حلوا را بخر","شیخ به خادم اشاره کرد که برود و تمام آن حلواها را بخرد."],[182,"تا غریمان چونک آن حلوا خورند","یک زمانی تلخ در من ننگرند","کمک به مهمانان و غریبان برای خوردن حلوا باعث می‌شود که آنها در آن لحظه به تلخی‌های زندگی فکر نکنند و فقط شیرینی را بچشند."],[182,"در زمان خادم برون آمد به در","تا خرد او جمله حلوا را به زر","در زمانیکه خادم بیرون آمد، خرد او (کودک) همه حلواها را به قیمت طلا خرید."],[182,"گفت او را کوترو حلوا به چند","گفت کودک نیم دینار و ادند","او به خادم گفت که حلوا را به چه میزان می‌فروشد. کودک گفته است که قیمت آن نیم دینار و مقدار کمی هم به آن اضافه می‌شود."],[182,"گفت نه از صوفیان افزون مجو","نیم دینارت دهم دیگر مگو","آن کودک به شیخ می‌گوید که از صوفیان بیش از این نجوید و من تنها نیم دینار به تو می‌دهم، دیگر صحبت نکن."],[182,"او طبق بنهاد اندر پیش شیخ","تو ببین اسرار سرّ اندیش شیخ","شیخ به او (شیخ احمد خضرویه) می‌گوید که در پیش تو، اسراری از اندیشه و طرز فکر من وجود دارد که باید آن‌ها را ببینی."],[182,"کرد اشارت با غریمان کین نوال","نک تبرک خوش خورید این را حلال","او به غریبان (بی‌خانمان‌ها) اشاره کرد که این نان را که شما خوردید، حلال و برای شما مقدّس است و از برکت است."],[182,"چون طبق خالی شد آن کودک ستد","گفت دینارم بده ای با خرد","زمانی که ظرف خالی شد، آن کودک ستد (شیخ احمد خضرویه) گفت: ای خردمند، دینارم را بده."],[182,"شیخ گفتا از کجا آرم درم","وامدارم می‌روم سوی عدم","شیخ می‌گوید چگونه می‌توانم پول بیاورم، من که بدهکار هستم و به سوی نابودی می‌روم."],[182,"کودک از غم زد طبق را بر زمین","ناله و گریه بر آورد و حنین","کودک به خاطر غم و اندوه، طبق را بر زمین انداخت و شروع به ناله و گریه کرد."],[182,"می‌گریست از غبن کودک های های","کای مرا بشکسته بودی هر دو پای","کودک به شدت می‌گریست و نالیده بود که ای کاش تو (شخص مورد خطاب) هر دو پای مرا نشکسته بودی."],[182,"کاشکی من گرد گلخن گشتمی","بر در این خانقه نگذشتمی","ای کاش من به دور گلخانه گلابی می‌گشتم و هرگز از در این خانقاه نمی‌گذشتم."],[182,"صوفیان طبل‌خوار لقمه‌جو","سگ‌دلان و همچو گربه روی‌شو","صوفیان که علاقه‌مند به جمع‌آوری لقمه‌های حلال هستند، همچون سگ‌های وفادار و گاهی مانند گربه‌هایی که به آرامی و با احتیاط به جست‌وجو می‌پردازند، رفتار می‌کنند."],[182,"از غریو کودک آنجا خیر و شر","گرد آمد گشت بر کودک حشر","از فریاد و صدای کودکی در آنجا خیر و شر جمع شدند و بر کودک قیامتی برپا گردید."],[182,"پیش شیخ آمد که ای شیخ درشت","تو یقین دان که مرا استاد کشت","کودک به شیخ می‌گوید که تو می‌دانی من به خاطر معلمی که دارم، کشت شده‌ام. در اینجا کشت شدن به معنای یادگیری سخت و مشقت ناشی از تعلیم است."],[182,"گر روم من پیش او دست تهی","او مرا بکشد، اجازت می‌دهی؟","اگر من به حضور او بروم در حالی که دست خالی هستم، آیا او مرا خواهد کشت و تو اجازه این کار را می‌دهی؟"],[182,"وان غریمان هم به انکار و جحود","رو به شیخ آورده کین باری چه بود؟","غریبان با انکار و نادیده گرفتن به شیخ (احمد خضرویه) مراجعه کرده‌اند و از او می‌پرسند که علت این رفتار زشت چیست."],[182,"مال ما خوردی مظالم می‌بری","از چه بود این ظلم دیگر بر سری؟","تو مال ما را خوردی و به ما ظلم کردی، حال از کجا این ظلم جدید بر سر ما نازل شده است؟"],[182,"تا نماز دیگر آن کودک گریست","شیخ دیده بست و در وی ننگریست","کودک تا زمان نماز عصر گریه کرد و شیخ چشمانش را بست و از روی کودک خجالت می‌کشید."],[182,"شیخ فارغ از جفا و از خلاف","در کشیده روی چون مه در لحاف","شیخ از آزار و تناقضات بی‌خبر و دور است و چهره‌اش مانند ماه در لحاف (که پوششی نرم و لطیف دارد) روشن و آرام به نظر می‌آید."],[182,"با ازل خوش با اجل خوش شادکام","فارغ از تشنیع و گفت خاص و عام","او با خداوند از آغاز و پایان خوش است و زندگی‌اش شادمانه می‌گذرد و از سرزنش‌ها و گفتار دیگران بی‌خبر است."],[182,"آنک جان در روی او خندد چو قند","از ترش‌رویی خلقش چه گزند؟","جان در مقابل روی او شاد و خوشحال است، همچون قند که شیرین است، پس از چهره‌ی ترش و ناراضی دیگران چه آسیبی می‌بیند؟"],[182,"آنک جان بوسه دهد بر چشم او","کی خورد غم از فلک وز خشم او؟","اگر جان کسی به چشمان معشوق بوسه بزند و از زیبایی او شاد شود، دیگر چه غم و ناراحتی از دنیا و سختی‌های آن خواهد داشت؟"],[182,"در شب مهتاب مه را بر سماک","از سگان و وعوع ایشان چه باک؟","در شب پرنور ماه، ماه را بر ستاره سماک (از ستاره‌های آسمان) چه غم و نگرانی از سگان و ناله‌های آنهاست؟"],[182,"سگ وظیفه خود بجا می‌آورد","مه وظیفه خود به رخ می‌گسترد","سگ به‌درستی وظیفه‌اش را انجام می‌دهد و در عوض، ماه نیز به زیبایی نوری که دارد، خود را نمایان می‌کند."],[182,"کارک خود می‌گزارد هر کسی","آب نگذارد صفا بهر خسی","هر کس در انجام وظایف و کارهای خود کوشا و پایبند است، اما برای کسی که دست از تلاش برمی‌دارد، پاکی و صفا به آسانی به دست نمی‌آید."],[182,"خس، خسانه می‌رود بر روی آب","آب صافی می‌رود بی اضطراب","علف‌های کوتاه و بی‌سود، به آسانی بر روی آب می‌روند و آب زلال و صاف بدون هیچ نگرانی جریان دارد."],[182,"مصطفی مه می‌شکافد نیم‌شب","ژاژ می‌خاید ز کینه بولهب","پیامبر در نیمه شب ماه را با معجزه دو نیم می‌کند، و ابولهب به او فحش می‌دهد."],[182,"آن مسیحا مرده زنده می‌کند","وان جهود از خشم سبلت می‌کند","مسیح مرده زنده می‌کند، و کاهن یهودی از سر خشم و حسادت موهای خود را می‌کند."],[182,"بانگ سگ هرگز رسد در گوش ماه؟","خاصه ماهی کو بود خاص اله؟","آیا صدای سگ به گوش ماه می‌رسد؟ به‌ویژه اینکه ماهی، که مخصوص خداوند است، در آب باشد؟"],[182,"می خورد شه بر لب جو تا سحر","در سماع از بانگ چغزان بی خبر","پادشاه تا صبح در کنار جوی، مشغول نوشیدن شراب بود و در حال سماع (رقص و شادمانی) بود، غافل از صدای گذاشتن چغندر."],[182,"هم شدی توزیع کودک دانگ چند","همت شیخ آن سخا را کرد بند","شیخ احمد خضرویه، با بخشش نه تنها به نیازمندان کمک می‌کند، بلکه این کار را با تلاش و اراده خود انجام می‌دهد. او به گنجایش خودش در این بخشش نیز توجه داشته و بر تنظیم آن کمک می‌کند."],[182,"تا کسی ندهد به کودک هیچ چیز","قوت پیران ازین بیش است نیز","اگر کسی به کودک چیزی ندهد، این دلیل بر آن است که خوراک و نیازهای بزرگترها بیشتر از این است."],[182,"شد نماز دیگر آمد خادمی","یک طبق بر کف ز پیش حاتمی","وقت نماز عصر شد و خدمتکاری با یک سینی از طرف فردی بخشنده به پیش شیخ آمد."],[182,"صاحب مالی و حالی پیش پیر","هدیه بفرستاد کز وی بد خبیر","شخصی که ثروت و حال خوبی داشت، هدیه‌ای برای پیر فرستاد، زیرا از او آگاهی و بصیرت می‌خواست."],[182,"چارصد دینار بر گوشه طبق","نیم دینار دگر اندر ورق","شیخ احمد خضرویه چهارصد دینار پول را در گوشه ظرفی گذاشته و نیم دینار دیگر هم در ورق (کاغذ) قرار داده است."],[182,"خادم آمد شیخ را اکرام کرد","وان طبق بنهاد پیش شیخ فرد","خادم به نزد شیخ آمد و او را مورد احترام قرار داد و آن طبق را که حاوی پول بود، جلوی شیخ گذاشت."],[182,"چون طبق را از غطا وا کرد رو","خلق دیدند آن کرامت را ازو","وقتی شیخ طبق را از روی حجاب برداشت، مردم آن کرامت (شگفتی) را از او مشاهده کردند."],[182,"آه و افغان از همه برخاست زود","کای سر شیخان و شاهان این چه بود","همه از شدت حیرت و شگفتی فریاد و ناله‌ای بلند کردند و گفتند: ای سردمدار شیخ‌ها و پادشاهان، این چه wondrous (عجیب) و عظمت است؟"],[182,"این چه سرست این چه سلطانیست باز","ای خداوند خداوندان راز","این چه حالتی است و چه نوع سلطنتی است؟ ای خدا، ای صاحب اسرار الهی، به فریاد ما برس."],[182,"ما ندانستیم ما را عفو کن","بس پراکنده که رفت از ما سخن","ما از واقعیت‌ها آگاه نبودیم، بنابراین ما را ببخش. ما خیلی بی‌نظم و از هم گسسته هستیم و سخنان ما از وجودمان رفته است."],[182,"ما که کورانه عصاها می‌زنیم","لاجرم قندیلها را بشکنیم","ما که بدون درک و بصیرت در حال تلاش هستیم، در نتیجه به چیزهای ارزشمند آسیب می‌زنیم."],[182,"ما چو کران ناشنیده یک خطاب","هرزه گویان از قیاس خود جواب","ما مانند افرادی که ناشنوا هستند، از سخنان بی‌معنای افرادی که فقط زبان به گزاف می‌گشایند، هیچ پاسخی نمی‌دهیم و فقط به قیاس و استنتاج خود تکیه می‌زنیم."],[182,"ما ز موسی پند نگرفتیم کاو","گشت از انکار خضری زردرو","ما از موسی (پیامبر) درس عبرت نگرفتیم؛ او که به دلیل انکار خضر (نبی) دچار رنگ زردی و پریشانی شد."],[182,"با چنان چشمی که بالا می‌شتافت","نور چشمش آسمان را می‌شکافت","با چشمی که به طور خاص و با دقت نظر به آسمان خیره می‌شد، روشنایی و نور او به قدری قوی بود که مانند شعاعی درخشان آسمان را می‌شکافت."],[182,"کرده با چشمت تعصب موسیا","از حماقت چشم موش آسیا","تو با چشمان تعصب‌زده‌ات مانند موسی (پیامبر) شده‌ای که به دلیل کم‌فکری و نادانی، مثل موش‌ها در آسیا، عمل می‌کنی."],[182,"شیخ فرمود آن همه گفتار و قال","من بحل کردم شما را آن حلال","شیخ گفت: من شما را بابت همه آن صحبت‌ها و گفته‌ها حلال کردم."],[182,"سر این آن بود کز حق خواستم","لاجرم بنمود راه راستم","راز من این بود که از خدا طلب کردم، در نتیجه خداوند راه راست را به من نشان داد."],[182,"گفت آن دینار اگر چه اندکست","لیک موقوف غریو کودکست","این دینار هر چند کم ارزش است، اما به خاطر فریاد کودک حلوافروش نصیب شما شده است."],[182,"تا نگرید کودک حلوا فروش","بحر رحمت در نمی‌آید به جوش","تا زمانی که کودک حلوا فروش گریه نکند، دریای رحمت الهی به خروش نمی آید"],[182,"ای برادر طفل، طفل چشم تست","کام خود موقوف زاری دان درست","ای برادر، کودک (دیده) تو همان کودک است، و خوشی و کامی که می‌خواهی به زاری و گریه تو وابسته است."],[182,"گر همی‌خواهی که آن خلعت رسد","پس بگریان طفل دیده بر جسد","اگر می‌خواهی آن لباس (عطایتی) به تو برسد، پس باید بر سخن گفتن و گریه کردن این طفل چشم، که بر جسم خود تو می‌گرید، تأکید کنی."],[183,"زاهدی را گفت یاری در عمل","کم گری تا چشم را ناید خلل","یار زاهد به او می‌گوید که در عمل خوب، کم‌کاری نکن تا چشمت دچار نقصان و کوردلی نشود."],[183,"گفت زاهد از دو بیرون نیست حال","چشم بیند یا نبیند آن جمال","زاهد گفت که حال چشم یا به واسطه دیدن، یا به واسطه ناپیدایی مربوط به بیرون نیست، بلکه به آن جلال و جمالی که در درون است، بستگی دارد."],[183,"گر ببیند نور حق خود چه غمست","در وصال حق دو دیده چه کمست","اگر کسی نور حق را ببیند، چه غمی دارد؟ در نزدیکی و وصال حق، حتی دو چشم هم کافی نیستند."],[183,"ور نخواهد دید حق را گو برو","این چنین چشم شقی گو کور شو","اگر شخصی نخواهد حقیقت را ببیند، به او بگو که بهتر است همین‌طور که هست، نابینا بماند و نبیند."],[183,"غم مخور از دیده، کان عیسی تراست","چپ مرو تا بخشدت دو چشم راست","نگران نباش، چون عیسی (پیامبر) همراه توست و تو را می‌بیند. به سمت چپ نرو، زیرا که ممکن است با آن کار، بینایی حقیقی را که برای تو به ارمغان می‌آورد، از دست بدهی."],[183,"عیسی روح تو با تو حاضرست","نصرت از وی خواه کو خوش ناصرست","روح عیسی (عیسای پیامبر) در نزد تو حاضر است؛ پس از او کمک بخواه که او مددکار خوبی است."],[183,"لیک بیگار تن پر استخوان","بر دل عیسی منه تو هر زمان","تن بی‌کار و تن پر از استخوان، بر دل عیسی (که به معنای روح و نصرت الهی است) سنگینی نکن، بلکه همواره به یاد داشته باش که به او متکی باشی و از او یاری بخواهی."],[183,"همچو آن ابله که اندر داستان","ذکر او کردیم بهر راستان","شخصی را تشبیه می‌کند به ابلهی که در داستان قبلا ذکر شد و فقط به خاطر نادانی‌اش در مورد راه درست ناآگاه است."],[183,"زندگی تن مجو از عیسی‌ات","کام فرعونی مخواه از موسی‌ات","زندگی جسمی و دنیوی را از عیسی (ع) نخواه، زیرا او آمده تا روح و معنویت را زنده کند؛ و از موسی (ع) هم انتظار نعمت‌های دنیوی و قدرت فرعونی نداشته باش، چرا که او هدایت و رهایی را آورده است."],[183,"بر دل خود کم نه اندیشه معاش","عیش کم ناید تو بر درگاه باش","به دل خود کمتر به فکر دنیا باش، زیرا درآمدهای آن سبب خوشحالی نمی‌شود؛ بر درگاه الهی حضور داشته باش."],[183,"این بدن خرگاه آمد روح را","یا مثال کشتیی مر نوح را","این بدن مانند محلی برای زندگی روح است، مانند یک کشتی که نوح (پیامبر) در آن قرار دارد."],[183,"ترک چون باشد بیابد خرگهی","خاصه چون باشد عزیز درگهی","ترک (غیر مسلمان) چگونه می‌تواند به آنجا (به مقام و منزلت روح) برسد، چونکه در آنجا جایی خاص و ارجمند وجود دارد که مخصوص کسی است که عزیز و محترم باشد."],[184,"خواند عیسی نام حق بر استخوان","از برای التماس آن جوان","عیسی (علیه‌السلام) به خاطر درخواست آن جوان، نام خدا را بر استخوان‌ها خواند تا از آن‌ها استمداد کند و دعا کند."],[184,"حکم یزدان از پی آن خام مرد","صورت آن استخوان را زنده کرد","خداوند به فرمان خود، به خاطر آن جوان بی‌ازرد، صورت آن استخوان را زنده کرد."],[184,"از میان بر جست یک شیر سیاه","پنجه‌ای زد کرد نقشش را تباه","ناگهان، یک شیر سیاه از وسط آمد و با پنجه‌هایش به استخوان‌ها حمله کرد و نقش آن‌ها را خراب کرد."],[184,"کله‌اش بر کند مغزش ریخت زود","مغز جوزی کاندرو مغزی نبود","سر او را به سرعت بریدند و مغزش را بر زمین ریختند و در حقیقت، مغز او همانند مغز گردو، پوک و بی‌محتوا بود."],[184,"گر ورا مغزی بدی اشکستنش","خود نبودی نقص الا بر تنش","اگر آن شخص (اشاره به کسی که مغز او شکست) مغز سالمی داشت، شکسستن او (ناقص کردن او) هیچکی جز خودش نبود؛ نقص و عیب فقط به بدن او برمی‌گردد."],[184,"گفت عیسی چون شتابش کوفتی","گفت زان رو که تو زو آشوفتی","عیسی گفت چون تو به او شتابی ورزیدی و او را زود آزردی، همین سبب شد که او از تو پریشان و ناامید شده است."],[184,"گفت عیسی چون نخوردی خون مرد","گفت در قسمت نبودم رزق خورد","عیسی گفت که چون تو نتوانستی غذا بخوری، به این دلیل است که در سرنوشتت نصیب و روزی خوردن نبوده است."],[184,"ای بسا کس همچو آن شیر ژیان","صید خود ناخورده رفته از جهان","بسیاری از مردم مانند شیر ژیان، که قوی و نیرومند است، بدون اینکه بهره‌ای از زندگی ببرند و رزق خود را بهره‌مند شوند، از این دنیا می‌روند."],[184,"قسمتش کاهی نه و حرصش چو کوه","وجه نه و کرده تحصیل وجوه","کسی که سهمش اندک و ناچیز است، اما حرص و طمعش بسیار بزرگ و همچون کوه است، در حالی که در تلاش برای به دست آوردن مال و ثروت است."],[184,"ای میسر کرده بر ما در جهان","سخره و بیگار ما را وا رهان","ای کسی که در این دنیا برای ما دشواری‌ها و زحمت‌ها را آسان کرده‌ای، ما را از این بندگی و سختی‌ها رها کن."],[184,"طعمه بنموده بما وان بوده شست","آنچنان بنما بما آن را که هست","ای عیسی، طعمه‌ای برای ما نمایان کرده‌ای که در واقع خام است، ما را نشان بده که حقیقت آن چیست."],[184,"گفت آن شیر ای مسیحا این شکار","بود خالص از برای اعتبار","مسیحا (عیسی) به شیر (شخصیتی象徴ین یا مفهومی) می‌گوید که این شکار (استخوان‌ها یا مردگان زنده شده) به خاطر اعتبار و عظمت خالص بوده است."],[184,"گر مرا روزی بدی اندر جهان","خود چه کارستی مرا با مردگان","اگر روزی به من برسی و در این دنیا به من قدرتی بدهی، چه نیازی به مردگان دارم؟"],[184,"این سزای آنک یابد آب صاف","همچو خر در جو بمیزد از گزاف","کسی که مانند الاغ (خر) در آب زلال می‌افتد، نتیجه‌اش این است که به خاطر کارهای بی‌فایده خود، سزاوار چنین شرایطی است."],[184,"گر بداند قیمت آن جوی خر","او به جای پا نهد در جوی سر","اگر خر (حیوانی) بداند ارزش آن جوی آب را، به جای پا گذاشتن در جوی، سرش را در آن می‌اندازد."],[184,"او بیابد آنچنان پیغامبری","میر آبی زندگانی‌پروری","او مانند پیامبری می‌شود که آب زندگی را به انسان‌ها می‌بخشد."],[184,"چون نمیرد پیش او کز امر کن","ای امیر آب ما را زنده کن","چون نمیرد در برابر او، تو ای امیر، دستور بده که آب ما را زنده کند."],[184,"هین سگ نفس ترا زنده مخواه","کو عدو جان تست از دیرگاه","مراقب باش، ای انسان، که نفس (هجیر، خواسته‌های نفسانی) را زنده و فعال نکن، زیرا او دشمن روح تو است و از زمان‌های دور با تو سر دشمنی دارد."],[184,"خاک بر سر استخوانی را که آن","مانع این سگ بود از صید جان","خاک بر سر آن استخوانی که مانع صید جان تو بود و به نوعی باعث شده بود که نتوانی به مقام روحانی‌ات دست یابی."],[184,"سگ نه‌ای بر استخوان چون عاشقی","دیوچه‌وار از چه بر خون عاشقی","نمی‌توانی به استخوان بی‌حرکتی مانند سگ حریص نگاه کنی، چون عاشق واقعی نباید مانند دیوها و مخلوقات پلید به خون عشق تمسک جوید."],[184,"آن چه چشمست آن که بیناییش نیست","ز امتحانها جز که رسواییش نیست","چیزی که در ظاهر به چشم می‌آید، اگر بینا نباشد، تنها رسوایی و عریانی‌اش باقی می‌ماند و در واقع از آزمایش‌ها چیزی بر جا نمی‌گذارد."],[184,"سهو باشد ظنها را گاه گاه","این چه ظنست این که کور آمد ز راه","گاهی پیش می‌آید که خطاهایی در برداشت از چیزها وجود دارد، به‌خصوص این تصور که باید در همه‌جا دید روشن داشت. این چه تصوری است که انسان‌ها در تاریکی و نادرستی خود را گم کرده‌اند؟"],[184,"دیده آ بر دیگران نوحه‌گری","مدتی بنشین و بر خود می‌گری","نگاه کن به نوحه‌گری دیگران و مدتی به حال آنها بنشین و بر خودت سوگواری کن."],[184,"ز ابر گریان شاخ سبز و تر شود","زانک شمع از گریه روشن‌تر شود","از ابر، وقتی باران می‌بارد، شاخ و برگ سبز و تازه می‌شود، چون شمع با اشک (نشتن) بیشتر روشن می‌شود."],[184,"هر کجا نوحه کنند آنجا نشین","زانک تو اولیتری اندر حنین","هر جا که زاری و نوحه‌ای باشد، آنجا برو و تماشا کن، چون تو در این زمینه برتر از دیگران هستی و در این ناله‌ها محبوب‌تر و مهم‌تر به حساب می‌آیی."],[184,"زانک ایشان در فراق فانی‌اند","غافل از لعل بقای کانی‌اند","آن‌ها در غم دوری و جدایی هستند و از حقیقت جاودانی و ماندگاری غافلند."],[184,"زانک بر دل نقش تقلیدست بند","رو به آب چشم بندش را برند","چون بر دل انسان آثار تقلید نقش بسته است، مانع از آن می‌شود که به حقیقت و خلوص خود دست یابد و همچون آبی که چشم را می‌پوشاند، او را از دیدن واقعیت بازمی‌دارد."],[184,"زانک تقلید آفت هر نیکویست","که بود تقلید اگر کوه قویست","زیرا تقلید باعث آسیب به هر کار خوبی است، و اگر کوه قوی باشد، باز هم تقلید مشکل‌زا خواهد بود."],[184,"گر ضریری لمترست و تیز خشم","گوشت‌پاره‌ش دان چو او را نیست چشم","اگر کسی بینا باشد و تندخو مانند شخصی که از بدخلقی خود ناراحت است، چه فایده‌ای دارد؟ آنچنان که او اگر چشم نداشته باشد، چیزی نمی‌بیند."],[184,"گر سخن گوید ز مو باریکتر","آن سرش را زان سخن نبود خبر","اگر کسی سخنی بگوید که حتی باریک‌تر از موی باشد، آن سر که سخن می‌گوید از آن سخن خبر ندارد، یعنی آن شخص خود را از حقیقت دور کرده و درک درستی از موضوع ندارد."],[184,"مستیی دارد ز گفت خود ولیک","از بر وی تا به می راهیست نیک","مستی او ناشی از گفتار خود است، اما برای رسیدن به آن حالت، باید از مسیر دیگری به می (شراب) دست یافت."],[184,"همچو جویست او نه او آبی خورد","آب ازو بر آب‌خوران بگذرد","او مانند جویی است که آب نمی‌نوشد، بلکه آب از او می‌گذرد و به آب‌خواران می‌رسد."],[184,"آب در جو زان نمی‌گیرد قرار","زانک آن جو نیست تشنه و آب‌خوار","آب در جوی قرار نمی‌گیرد زیرا آن جو تشنه و نیازمند آب نیست."],[184,"همچو نایی ناله زاری کند","لیک بیگار خریداری کند","چنان‌که نی در دلش زاری و ناله می‌کند، اما کسی که بی‌گاری می‌خرد، به هنگام درد و غم تنها به فکر منفعت خود است."],[184,"نوحه‌گر باشد مقلد در حدیث","جز طمع نبود مراد آن خبیث","نوحه‌گر (شخصی که می‌نالد و سوگواری می‌کند) فقط در روایت کردن داستان سوگواری تقلید می‌کند و در حقیقت تنها چیزی که او را تحریک می‌کند، طمع و سودجویی است، نه احساس واقعی."],[184,"نوحه‌گر گوید حدیث سوزناک","لیک کو سوز دل و دامان چاک","نوحه‌گر داستانی سوزناک و غم‌انگیز می‌گوید، اما باید پرسید که این سخنان او چه تاثیری بر قلبش دارد و آیا او خود را خسته و پاره‌پاره کرده است؟"],[184,"از محقق تا مقلد فرقهاست","کین چو داوودست و آن دیگر صداست","بین عالم واقعی و کسی که فقط تقلید می‌کند تفاوت بزرگی وجود دارد؛ عالم واقعی مانند داوود است که صدای دلنشینی دارد، در حالی که مقلد فقط صدایی شبیه به او ایجاد می‌کند."],[184,"منبع گفتار این سوزی بود","وان مقلد کهنه‌آموزی بود","منبع این احساس سوزان، الهام و وحی است، در حالی که مقلد، فقط آموزه‌های قدیمی را تکرار می‌کند و درک عمیق‌تری ندارد."],[184,"هین مشو غره بدان گفت حزین","بار بر گاوست و بر گردون حنین","مراقب باش که فریب سخن حزین (شاعر) را نخوری؛ زیرا به این گفته اعتماد نکن که بار بر دوش گاو و بر گردونه (آسمان) است."],[184,"هم مقلد نیست محروم از ثواب","نوحه‌گر را مزد باشد در حساب","نوحه‌گر، که در سوگواری و ذکر مصیبت اهل بیت (علیهم‌السلام) به نوحه‌خوانی می‌پردازد، همواره از ثواب و پاداش برخوردار است، حتی اگر تقلید کند و خود نظرات و آراء خاصی نداشته باشد."],[184,"کافر و مؤمن خدا گویند لیک","درمیان هر دو فرقی هست نیک","کافر و مؤمن هر دو نام خدا را می‌برند، اما در حقیقت میان آن‌ها تفاوت‌های زیادی وجود دارد که نیکوست."],[184,"آن گدا گوید خدا از بهر نان","متقی گوید خدا از عین جان","گدایان می‌گویند خداوند برای تأمین نان آن‌هاست، اما انسان‌های متقی می‌فهمند که خداوند، اصل حیات و وجودشان است."],[184,"گر بدانستی گدا از گفت خویش","پیش چشم او نه کم ماندی نه بیش","اگر می‌دانستی که این گدا (یعنی نیازمند) از حرف‌هایش چه می‌گوید، متوجه می‌شدی که در مقابل چشمان او هیچ چیزی کم یا زیاد نیست؛ یعنی او به حقیقتی فراتر از ظاهر توجه دارد."],[184,"سالها گوید خدا آن نان‌خواه","همچو خر مصحف کشد از بهر کاه","سال‌ها خداوند به کسی که فقط از او نان می‌خواهد، مانند الاغ (خر) که بار کتاب می‌کشد، به خاطر کاه (چیزهای ناچیز) می‌دهد."],[184,"گر به دل در تافتی گفت لبش","ذره ذره گشته بودی قالبش","اگر به دل خود نظری بیندازی، می‌بینی که لب او به اندازه‌ای کم‌کم از هم گسسته و نرم شده که هیچ شکل مشخصی ندارد."],[184,"نام دیوی ره برد در ساحری","تو به نام حق پشیزی می‌بری","برای تو به خاطر خدا، دیو سحر و جادو در گمراهی و بدی تو را به نام خدا فریب می‌دهد و تو در این وضعیت، ارزشی به اندازه‌ی یک پراکنده سکه (پشیزی) نداری."],[185,"روستایی گاو در آخر ببست","شیر گاوش خورد و بر جایش نشست","روستایی در پایان، شیر را به گمان اینکه گاوش است، گرفت و آن را خورد و سپس در همان مکان نشسته است."],[185,"روستایی شد در آخر سوی گاو","گاو را می‌جست شب آن کنج‌کاو","روستایی در نهایت به سمت گاوش رفت و در آن شب تاریک به دنبالش می‌گشت."],[185,"دست می‌مالید بر اعضای شیر","پشت و پهلو گاه بالا گاه زیر","روستایی، در تاریکی شب، به جسد شیر دست می‌زد و قسمت‌های مختلف بدن او را لمس می‌کرد، گاه به پشت و پهلوی شیر و گاه به قسمت‌های بالا و پایین آن."],[185,"گفت شیر ار روشنی افزون شدی","زهره‌اش بدریدی و دل خون شدی","اگر شیر روشنایی بیشتری می‌داشت، از ترسش فرار می‌کردی و قلبش پر از خون می‌شد."],[185,"این چنین گستاخ زان می‌خاردم","کو درین شب گاو می‌پنداردم","شیر به خاطر ترس و شجاعتش از موجودی که در تاریکی دیده، در واقع خیال می‌کند که آن گاو است، خود را به خطر می‌اندازد و به او حمله می‌کند."],[185,"حق همی‌گوید که ای مغرور کور","نه ز نامم پاره پاره گشت طور","حق می‌گوید ای فریب‌خورده و نابینا، تو به خاطر نام من (حق) پاره پاره نشدی، بلکه کوه طور به خاطر عظمت من پاره پاره شد."],[185,"که لو انزلنا کتابا للجبل","لانصدع ثم انقطع ثم ارتحل","اگر ما کتابی بر کوه نازل می‌کردیم، آن کوه از شدت خوف پاره پاره می‌شد و سپس در هم می‌ریخت و از جای خود حرکت می‌کرد."],[185,"از من ار کوه احد واقف بدی","پاره گشتیّ و دلش پرخون شدی","اگر کوه احد (که کوه سنگیست )، از حقیقت من آگاهی داشت، زهره‌ی دلش از ترس (دل سنگش) پاره می‌شد و دلش به درد می‌آمد و غم وجودش را می‌گرفت (دلش خون می شد)."],[185,"از پدر وز مادر این بشنیده‌ای","لاجرم غافل درین پیچیده‌ای","این بیت به این معناست که ما از پدر و مادر خود برخی چیزها را شنیده‌ایم و به همین دلیل در این موقعیت پیچیده غافل مانده‌ایم. اشاره به این دارد که اطرافیان و خویشاوندان می‌توانند بر نگرش ما تأثیر بگذارند و ما را از درک درست واقعیت دور کنند."],[185,"گر تو بی‌تقلید ازین واقف شوی","بی نشان از لطف چون هاتف شوی","اگر تو بدون تقلید از دیگران به این حقیقت پی ببری، به اندازه‌ای از لطف الهی برخوردار خواهی شد که مانند یک ندا کننده یا فرشته خواهی شد."],[185,"بشنو این قصه پی تهدید را","تا بدانی آفت تقلید را","این داستان را بشنو که از تهدید تقلید صحبت می‌کند تا بدانی تقلید چه آسیبی می‌تواند داشته باشد."],[186,"صوفیی در خانقاه از ره رسید","مرکب خود برد و در آخر کشید","صوفی مسافری به خانقاه رسید و مرکبش(خر) را به به اصطبل برد و بست."],[186,"آبکش داد و علف از دست خویش","نه چنان صوفی که ما گفتیم پیش","با دست خود به خر آب و علف داد و او همانند صوفی هایی که پیش از این از آنان یاد کرده ایم نبود( گویا از حقیقت عرفان بهره ای نبرده بود و تنها لباس صوفی بر تن داشت )"],[186,"احتیاطش کرد از سهو و خباط","چون قضا آید چه سودست احتیاط","او بسیار از خطا و اشتباه احتیاط می کرد اما وقتی قضای الهی فرا برسد احتیاط سودی نخواهد داشت ."],[186,"صوفیان تقصیر بودند و فقیر","کاد فقرا ان یکن کفرا یبیر","صوفیان آنجا کم بضاعت و فقیر بودند و همانطور که پیامبر فرمود: فقر انسان را در آستانه کفر قرار می دهد."],[186,"ای توانگر که تو سیری هین مخند","بر کژی آن فقیر دردمند","ای شخص توانگر و ثروتمند که سیر هستی٬ کج روی و انحراف فقیر درمانده را مایه خنده و مضحکه قرار نده."],[186,"از سر تقصیر آن صوفی رمه","خرفروشی در گرفتند آن همه","صوفیان با کوتاهی و قصوری که کردند نقشه ی فروش خر صوفی مسافر را کشیدند."],[186,"کز ضرورت هست مرداری مباح","بس فسادی کز ضرورت شد صلاح","صوفیان برای خود توجیه شرعی می آورند : زمانی که انسان در ناچاری و دام مرگ باشد خوردن گوشت مردار مباح و حلال است ( پس فروختن خر نیز مانعی ندارد )٬ چه بسیار فساد هایی که به بهانه و به واسطه توجیه برای ضرورت صلاح و درست در نظر گرفته شدند."],[186,"هم در آن دم آن خرک بفروختند","لوت آوردند و شمع افروختند","در همان لحظه آن خر را فروختند و غذایی فراهم آوردند و شمع روشن کردند."],[186,"ولوله افتاد اندر خانقه","کامشبان لوت و سماعست و وله","همهمه و شورشی در خانقاه به راه افتاد ( به دلیل آن که ): امشب شب غذا و سماع و وجد فراوان است."],[186,"چند ازین صبر و ازین سه روزه چند","چند ازین زنبیل و این دریوزه چند","به وفور از این تحمل و صبر و از این سه روزه (درد و رنج) چه استفاده‌ای می‌توان کرد؟ و چند بار باید به این وضعیت (دریوزه‌گری و تظاهرات نیاز) ادامه داد؟"],[186,"ما هم از خلقیم و جان داریم ما","دولت امشب میهمان داریم ما","( صوفیان گفتند: ) ما نیز آفریده خداوند هستیم و جان داریم و امشب شادکامی و بخت خوش میهمان ماست."],[186,"تخم باطل را از آن می‌کاشتند","کانک آن جان نیست جان پنداشتند","آن‌ها تخم چیزی بی‌ارزش را می‌کاشتند، و چون این کار را انجام می‌دادند، گمان می‌کردند که این عمل، حقیقتا به جان و روح آن‌ها مربوط می‌شود."],[186,"وان مسافر نیز از راه دراز","خسته بود و دید آن اقبال و ناز","آن مسافر که از سفر طولانی خسته شده بود، به نظرش آمد که به استقبال او، پذیرایی خوش و ناز و نعمت آمده است."],[186,"صوفیانش یک به یک بنواختند","نرد خدمتهای خوش می‌باختند","صوفیان به نوبت به مسافر توجه و محبت نشان می‌دهند و در مراسم خدمت به او، مهارت‌های خود را به نمایش می‌گذارند."],[186,"گفت چون می‌دید میلانش به وی","گر طرب امشب نخواهم کرد کی","گفت وقتی دید که او به موسیقی و شادی تمایل دارد، امروز شب نمی‌خواهم برقصم."],[186,"لوت خوردند و سماع آغاز کرد","خانقه تا سقف شد پر دود و گرد","حقه‌زن‌ها (لوت‌ها) شروع به نواختن موسیقی کردند و مراسم سماع در خانقاه (محل تجمع صوفیان) آغاز شد، به طوری که هوا تا سقف پر از دود و غبار شد."],[186,"دود مطبخ گرد آن پا کوفتن","ز اشتیاق و وجد جان آشوفتن","دود پخت‌وپز در اطراف کسانی که با شور و عشق پا به زمین می‌کوبند، نشان‌دهنده شوق و بی‌تابی روحی آن‌هاست."],[186,"گاه دست‌افشان قدم می‌کوفتند","گه به سجده صفه را می‌روفتند","گاهی دست‌افکنی می‌کردند و با شوق و شوری که داشتند، پا به زمین می‌کوبیدند، و گاهی در حالت سجده بر زمین می‌افتادند و به صفای روح مشغول بودند."],[186,"دیر یابد صوفی آز از روزگار","زان سبب صوفی بود بسیارخوار","صوفی معمولا از زندگی مادی و روزگار خوار و ذلیل می‌شود، به همین دلیل کم‌تر می‌تواند از دنیا به‌راحتی آز درآورد و آزاد باشد."],[186,"جز مگر آن صوفیی کز نور حق","سیر خورد او فارغست از ننگ دق","تنها آن صوفی که از نور حق تغذیه می‌کند و به درون خود می‌نگرد، از زشتی و تحقیر بی‌خبر است."],[186,"از هزاران اندکی زین صوفیند","باقیان در دولت او می‌زیند","فقط عده کمی از صوفی‌ها وجود دارند که در حقیقت حقیقی و دولت الهی به سر می‌برند و باقی آن‌ها در این مسیر نیستند."],[186,"چون سماع آمد ز اول تا کران","مطرب آغازید یک ضرب گران","زمانی که سماع آغاز شد، از ابتدا تا افق، نوازنده شروع به نواختن ضرب تار و تیز و پرتوانی کرد."],[186,"خر برفت و خر برفت آغاز کرد","زین حرارت جمله را انباز کرد","خر، به خاطر این حرارت و شوق، به حرکت درآمد و شروع به رفتن کرد و همه را نیز برانگیخت تا با او همراه شوند."],[186,"زین حرارت پای‌کوبان تا سحر","کف‌زنان خر رفت و خر رفت ای پسر","به‌خاطر حرارتی که ایجاد کرده، صوفیان تا سحر با پای کوبیدن و کف زدن مشغول هستند و همواره در حال «خر رفتن» (دست به کار شدن و به جنب و جوش درآمدن) هستند، ای پسر."],[186,"از ره تقلید آن صوفی همین","خر برفت آغاز کرد اندر حنین","به خاطر مقلد بودن صوفی هم شروع کرد به گفتن خر برفت در نوحه ای که میخواندند"],[186,"چون گذشت آن نوش و جوش و آن سماع","روز گشت و جمله گفتند الوداع","پس از آنکه شگفتی و شادی و رقص در آن روز سپری شد، اکنون روز عادی آغاز شده و همه‌کس گفتند خداحافظ."],[186,"خانقه خالی شد و صوفی بماند","گرد از رخت آن مسافر می‌فشاند","خانقاه (محل عبادت و تجمع صوفیان) خالی شد و صوفی (عاشق خدا) تنها ماند؛ گرد و غبار لباس آن مسافر (مسافر عاشق) را بر زمین می‌افشاند."],[186,"رخت از حجره برون آورد او","تا به خر بر بندد آن همراه‌جو","او (صوفی) لوازم و وسایل خود را از اتاق بیرون آورد تا آنها را به اسب (خر) دوستش ببندد و همراهش شود."],[186,"تا رسد در همرهان او می‌شتافت","رفت در آخر خر خود را نیافت","او تا به هم‌نشینانش برسد، به سرعت می‌دوید، اما در نهایت خر خود را پیدا نکرد."],[186,"گفت آن خادم به آبش برده است","زانک خر دوش آب کمتر خورده است","خادم گفت که خر را به جایی برده تا آب بخورد، چون خر دیشب کمتر آب نوشیده است."],[186,"خادم آمد گفت صوفی خر کجاست","گفت خادم ریش بین، جنگی بخاست","خادم آمد و صوفی از او پرسید خر کجاست؟ خادم گفت این ابله را ببین. و دعوا شد"],[186,"گفت من خر را به تو بسپرده‌ام","من تو را بر خر موکل کرده‌ام","گفت من این خر را به تو سپرده‌ام و مادام که به او دست‌رسی داری، مسئولیت او به عهده توست."],[186,"از تو خواهم آنچ من دادم به تو","باز ده آنچ فرستادم به تو","من از تو می‌خواهم چیزی را که به تو سپردم، به من برگردانی، و آنچه را که به سوی تو فرستادم، دوباره به من برگردان."],[186,"بحث با توجیه کن حجت میار","آنچ من بسپردمت وا پس سپار","با تو صحبت و بحث مکن که نیازی به دلیل و حجت نداری؛ آنچه را که من به تو سپردم، به من برگردان."],[186,"گفت پیغمبر که دستت هر چه برد","بایدش در عاقبت وا پس سپرد","پیامبر گفته است که هر چیزی را که با دست خود به دست می‌آوری، باید در نهایت آن را پس بدهی و هیچ‌چیز دائمی نیست."],[186,"ور نه‌ای از سرکشی راضی بدین","نک من و تو خانه قاضی دین","اگر از سرکشی و نافرمانی خود راضی نیستی، در این صورت نه من و نه تو نباید در منزل قاضی دین (داور خدا) حضور پیدا کنیم."],[186,"گفت من مغلوب بودم صوفیان","حمله آوردند و بودم بیم جان","وی می‌گوید که من تحت‌ فشار و در شرایط سختی قرار داشتم و صوفیان به من حمله کردند و من از ترس جانم در حالت ناتوانی بودم."],[186,"تو جگربندی میان گربگان","اندر اندازی و جویی زان نشان","تو در میان گربه‌ها، شکارچی می‌شوی و با ترفندی خاص، نشانی از خود بر جای می‌گذاری تا آن‌ها را به خود جذب کنی."],[186,"در میان صد گرسنه گرده‌ای","پیش صد سگ گربه پژمرده‌ای","در میان جمعیت زیادی از گرسنگان، تکه نانی وجود دارد که به آن مثل گربه پژمرده‌ای می‌ماند که در مقابل صد سگ قرار دارد. این تصویر نشان‌دهنده وضعیت ناامیدانه یا ناکافی است که در یک محیط پر رقابت و گرسنگی وجود دارد."],[186,"گفت گیرم کز تو ظلما بستدند","قاصد خون من مسکین شدند","گفت از تو می‌گیرد که در ظلم و ستم پیامی را برای من فرستاده‌اند که به خاطر ناچیز بودنم مورد ظلم قرار گرفته‌ام."],[186,"تو نیایی و نگویی مر مرا","که خرت را می‌برند ای بی‌نوا","تو نمی‌آیی و به من نمی‌گویی که خر (حیوان باربر) تو را می‌برند، ای بیچاره."],[186,"تا خر از هر که بود من وا خرم","ورنه توزیعی کنند ایشان زرم","اگر من از هر کسی که او را می‌شناسم، خودم را بخرم و آزاد کنم، در غیر این صورت، این افراد ثروت مرا تقسیم می‌کنند."],[186,"صد تدارک بود چون حاضر بدند","این زمان هر یک به اقلیمی شدند","این زمان که فراهم شده است، هر کس به جایی (اقلیمی) رفته و آماده کار و فعالیتی خاص است. این بدان معناست که هر یک از آنها به نحوی آماده و مجهز شده‌اند."],[186,"من که را گیرم که را قاضی برم","این قضا خود از تو آمد بر سرم","من چه کسی را به عنوان قاضی انتخاب کنم و چه کسی را به دادگاه ببرم؟ این سرنوشتم از جانب تو به من رسید."],[186,"چون نیایی و نگویی ای غریب","پیش آمد این چنین ظلمی مهیب","زمانی که تو نیایی و سخنی نگویی، ای غریب، چنین ظلم بزرگ و وحشتناکی پیش می‌آید."],[186,"گفت والله آمدم من بارها","تا ترا واقف کنم زین کارها","من بارها به تو گفته‌ام و قسم می‌خورم که آمده‌ام تا تو را از این مسائل آگاه کنم."],[186,"تو همی‌گفتی که خر رفت ای پسر","از همه گویندگان با ذوق‌تر","تو می‌گفتی که ای پسر، خر رفت، و این شیوه سخن گفتن از همه سخنگویان با ذوق‌تر است."],[186,"باز می‌گشتم که او خود واقفست","زین قضا راضیست مردی عارفست","من دوباره برمی‌گشتم زیرا می‌دانستم که او از این ماجرا آگاه است و از وضعیت راضی است، چرا که او مردی عارف و داناست."],[186,"گفت آن را جمله می‌گفتند خوش","مر مرا هم ذوق آمد گفتنش","صوفیان درباره مطلبی که گفته می‌شد، به خوشی و خوبی آن اشاره کردند و من هم از شنیدن آن صحبت، لذت بردم و به آن مشتاق شدم."],[186,"مر مرا تقلیدشان بر باد داد","که دو صد لعنت بر آن تقلید باد","تقلید از این‌ها باعث نابودی من شده است و بر آن تقلید فرستاده‌ام دوصد لعنت."],[186,"خاصه تقلید چنین بی‌حاصلان","خشم ابراهیم با بر آفلان","تقلید از چنین افرادی که نتایج مثبتی ندارند، خشم ابراهیم (پیامبر بزرگ) را به همراه دارد و به آتش می‌کشد. ابراهیم اشاره به نافرمانی و گناه می‌کند؛ زیرا او خود در برابر بت‌ها ایستادگی کرده بود."],[186,"عکس ذوق آن جماعت می‌زدی","وین دلم زان عکس ذوقی می‌شدی","تو از ذوق و شوق آن جماعت به من خبر می‌دادی، و دلم به همین خبر شاد و سرمست می‌شد."],[186,"عکس چندان باید از یاران خوش","که شوی از بحر بی‌عکس آب‌کش","باید از دوستان و یاران خود به اندازه‌ای خوشحال باشی و از شادی آنان بهره‌مند شوی که مانند آب‌کشی از دریای عشق و محبت، بی‌نظارتی و بی‌تصوری را به دور بریزی."],[186,"عکس کاول زد تو آن تقلید دان","چون پیاپی شد شود تحقیق آن","تصویر و توهمی که تو از یاران داری، بر اثر تقلید و پیروی از دیگران است؛ وقتی که این تقلید مستمر شود، تحقیق و شناسایی حقیقت نیز ممکن خواهد شد."],[186,"تا نشد تحقیق از یاران مبر","از صدف مگسل نگشت آن قطره در","تا زمانی که حقیقت از طرف یاران و دوستان روشن نشده، نباید که از صدف مروارید را بیاندازی، زیرا آن قطره، درون صدف باقی می‌ماند و رشد نمی‌کند."],[186,"صاف خواهی چشم و عقل و سمع را","بر دران تو پرده‌های طمع را","اگر می‌خواهی دیدگاه و عقل و شنوایی‌ات روشن باشد، باید پرده‌های طمع و حرص را از دل و جان خود کنار بزنی."],[186,"زانک آن تقلید صوفی از طمع","عقل او بر بست از نور و لمع","چون صوفی به تقلید از طمع خود پرداخته، عقل او از نور و فهم دور افتاده است."],[186,"طمع لوت و طمع آن ذوق و سماع","مانع آمد عقل او را ز اطلاع","طمع به مال و طمع به لذت و شنیدن موسیقی، عقل او را از آگاهی و درک بازداشته است."],[186,"گر طمع در آینه بر خاستی","در نفاق آن آینه چون ماستی","اگر طمع در آینه ظاهر شود، آن آینه به نفاق، مانند مستی می‌شود. یعنی وقتی انسان به خواسته‌های دنیوی و طمع دچار شود، حقیقت و صداقت خود را از دست می‌دهد و به گمراهی می‌افتد."],[186,"گر ترازو را طمع بودی به مال","راست کی گفتی ترازو وصف حال","اگر ترازوی وزن‌کشی به مال طمع کند، چگونه می‌تواند درست و بی‌طرفانه وضعیت اجناس را توصیف کند؟"],[186,"هر نبیی گفت با قوم از صفا","من نخواهم مزد پیغام از شما","هر پیامبری به قوم خود گفت که من در ازای رسالت و پیامم از شما چیزی نمی‌خواهم و مزد نمی‌گیرم."],[186,"من دلیلم حق شما را مشتری","داد حق دلالیم هر دو سری","من دلیل این مطلب هستم که خداوند شما را خریدار قرار داده است و حق واسطه‌گری ما این است که هر دو به یکدیگر پنهان هستیم."],[186,"چیست مزد کار من دیدار یار","گرچه خود بوبکر بخشد چل هزار","مزد کار من فقط دیدار یار است، هرچند خود ابوبکر (صحابی بزرگ اسلام) به من سی هزار بدهد."],[186,"چل هزار او نباشد مزد من","کی بود شبه شبه در عدن","چهل هزار (دینار یا درهم) که بوبکر (معروف به بوبکر صدیق، اولین خلفای اسلام) بخشیده، مزد کار من نیست. مزد من وجودی است که شبیه درّ (گوهر) در بهشت عدن است."],[186,"یک حکایت گویمت بشنو بهوش","تا بدانی که طمع شد بند گوش","می‌خواهم داستانی را برایت بگویم که با دقت بشنوی، تا بفهمی چگونه طمع انسان را به زنجیر می‌کشد و مانع از شنیدن حقیقت می‌شود."],[186,"هر که را باشد طمع الکن شود","با طمع کی چشم و دل روشن شود","هر کسی که طمع و خساست داشته باشد، نمی‌تواند به دوستی و عشق واقعی دست یابد. با این طمع، نه چشمش روشن می‌شود و نه دلش آرام."],[186,"پیش چشم او خیال جاه و زر","همچنان باشد که موی اندر بصر","در برابر دیدگان او، آرزوی مقام و ثروت مانند مو در چشمش ظاهر می‌شود و از توجه به آن جلوگیری می‌کند."],[186,"جز مگر مستی که از حق پر بود","گرچه بدهی گنجها او حر بود","تنها کسی که از حقیقت و خدا سرشار است، هرچند که ثروت و گنج‌های فراوانی را بدهی، آزاد و رهاست."],[186,"هر که از دیدار برخوردار شد","این جهان در چشم او مردار شد","هر کسی که به دیدار حقیقت و خداوند نائل شود، این جهان مادی در نظر او بی‌ارزش و همچون مرده می‌شود."],[186,"لیک آن صوفی ز مستی دور بود","لاجرم در حرص او شبکور بود","اما آن صوفی به دلیل مستی و حالات روحانی خود دور بود، بنابراین در او حرص و طمع به مانند یک فرد کوردل و blind (نابینا) وجود داشت."],[186,"صد حکایت بشنود مدهوش حرص","در نیاید نکته‌ای در گوش حرص","کسی که مدهوش و مست عشق و علاقه است، هرگز نخواهد توانست به درس و حکایات گوش فرا دهد، چرا که دلش درگیر حرص و آز است و گنجایشی برای شنیدن نکته‌های حکمت را ندارد."],[187,"بود شخصی مفلسی بی خان و مان","مانده در زندان و بند بی امان","شخصی فقیر و بی‌خانمان در زندان مانده و در زنجیر و اسارت است."],[187,"لقمه زندانیان خوردی گزاف","بر دل خلق از طمع چون کوه قاف","تو به نادرستی دلی که گرفتار زندانیان است، به طمع و حرص لقمه‌ای می‌زنی و این کار تو به اندازه‌ی کوه قاف بزرگ و سنگین است و بر دل مردم تأثیر منفی می‌گذارد."],[187,"زهره نه کس را که لقمه نان خورد","زانک آن لقمه‌ربا گاوش برد","هیچ‌کس جرئت ندارد لقمه نانی بخورد، چون آن لقمه‌ربا (اژدهای حافظه‌ای و فراموشی) گاوش را می‌برد؛ یعنی در خطر از دست دادن مال و زندگی‌اش قرار می‌گیرد."],[187,"هر که دور از دعوت رحمان بود","او گداچشمست اگر سلطان بود","هر کسی که از دعوت خداوند (رحمان) فاصله بگیرد و به آن پاسخ ندهد، حتی اگر مقام و ثروت بالایی داشته باشد، در حقیقت گدا و بی‌بهاست."],[187,"مر مروت را نهاده زیر پا","گشته زندان دوزخی زان نان‌ربا","انسان‌های بی‌عنایت و بی‌مروت، در پی نفع شخصی خود، ارزش‌های انسانی را زیر پا می‌گذارند و به خاطر دزدی نان دیگران، به مانند زندانیان جهنمی گرفتار می‌شوند."],[187,"گر گریزی بر امید راحتی","زان طرف هم پیشت آید آفتی","اگر از موقعیتی که در آن هستی فرار کنی به امید اینکه به آرامش برسی، از آن طرف هم مشکلی به تو خواهد رسید."],[187,"هیچ کنجی بی دد و بی دام نیست","جز بخلوتگاه حق آرام نیست","هیچ جایی در این دنیا خالی از جانوران و موانع نیست و بدون مشکلات نمی‌توان به آرامش و امنیت واقعی رسید، جز در خلوتگاه حق که تنها در آنجا می‌توان آرامش حقیقی را حس کرد."],[187,"کنج زندان جهان ناگزیر","نیست بی پامزد و بی دق الحصیر","زندانی که در این جهان داریم، نمی‌تواند بدون نگهبان و بدون تنبیه و دشواری باشد. به عبارتی، در زندگی این دنیا نقص و مشکل وجود دارد و هر کس در یک چالش و سختی قرار دارد."],[187,"والله ار سوراخ موشی در روی","مبتلای گربه چنگالی شوی","خدا را شاهد می‌گیرم که اگر در روی مبتلای گربه، یعنی کسی که در خطر افتاده، سوراخ موشی پیدا کنی، باید به او کمک کنی و نجاتش بدهی."],[187,"آدمی را فربهی هست از خیال","گر خیالاتش بود صاحب‌جمال","انسان دارای ظاهری زیبا و دلرباست، اما این زیبایی تنها از خیال و تصویر ذهنی او ناشی می‌شود. اگر خیالات او نامناسب باشد، آن زیبایی خود را از دست می‌دهد."],[187,"ور خیالاتش نماید ناخوشی","می‌گدازد همچو موم از آتشی","اگر خیالات انسان به او حالت ناخوشی القا کنند، او مانند موم از آتش ذوب می‌شود و در برابر مشکلات ضعیف و فاسد می‌گردد."],[187,"در میان مار و کزدم گر ترا","با خیالات خوشان دارد خدا","اگر خداوند به تو خیالات خوشی عطا کرده باشد، در میان مار و کژدم نیز از گزند آن‌ها مصون خواهی بود."],[187,"مار و کزدم مر ترا مونس بود","کان خیالت کیمیای مس بود","مار و کژدم (حیوانات خطرناک) برای تو مونس و دوست بودند، زیرا خیال و تصور تو همانند کیمیا (طلا) است که می‌تواند مس (مادی بی‌ارزش) را تبدیل به طلا کند."],[187,"صبر شیرین از خیال خوش شدست","کان خیالات فرج پیش آمدست","صبر شیرین به خاطر خیال خوش و امیدواری به آینده شکل گرفته است، زیرا این خیالات نوید بهبود و فرج را داده‌اند."],[187,"آن فرج آید ز ایمان در ضمیر","ضعف ایمان ناامیدی و زحیر","فرج و گشایش در زندگی از ایمان و اعتقاد به خداوند در دل انسان ناشی می‌شود، اما در دل کسانی که ایمان ضعیف دارند، ناامیدی و زحمت وجود دارد."],[187,"صبر از ایمان بیابد سر کله","حیث لا صبر فلا ایمان له","صبر از ایمان سرچشمه می‌گیرد؛ بنابراین، اگر صبر نباشد، ایمان نیز وجود ندارد."],[187,"گفت پیغامبر خداش ایمان نداد","هر که را صبری نباشد در نهاد","پیامبر خدا (محمد) فرمود هر کسی که در درون خود صبر نداشته باشد، به او ایمان نخواهد داشت."],[187,"آن یکی در چشم تو باشد چو مار","هم وی اندر چشم آن دیگر نگار","شخصی در نظر تو مانند مار به نظر می‌آید، اما او در نگاه شخص دیگری، زیبا و دوست‌داشتنی است."],[187,"زانک در چشمت خیال کفر اوست","وان خیال مؤمنی در چشم دوست","چون تو در چشم خود، او را کافر می‌بینی، در عوض در چشم دوستت، او را مؤمن تصور می‌کند."],[187,"کاندرین یک شخص هر دو فعل هست","گاه ماهی باشد او و گاه شست","در وجود یک شخص، هر دو نوع رفتار و ویژگی ممکن است، زمانی او مانند ماهی که لطیف و خوشحال است، و زمانی دیگر مانند شست (دست) که می‌تواند سخت و خشن باشد."],[187,"نیم او مؤمن بود نیمیش گبر","نیم او حرص‌آوری نیمیش صبر","نیمه‌ای از وجود او با ایمان و مؤمن است و نیمه‌ای دیگر او را به کافر و زردشتی تشبیه می‌کند. همچنین، بخشی از او به حرص و طمع دلالت دارد و نیمه دیگرش به صبر و تحمل اشاره می‌کند."],[187,"گفت یزدانت فمنکم مؤمن","باز منکم کافر گبر کهن","گفت: خدای تو، هم از شما مؤمنان است و هم از شما کافران کهنه (غیری)."],[187,"همچو گاوی نیمه چپش سیاه","نیمه دیگر سپید همچو ماه","شخصیت انسان به گونه‌ای است که یک بخش از او نیکو و مومن و بخش دیگر او ناپاک و کافر است؛ مانند گاوی که یک نیمه‌اش سیاه و نیمه‌ی دیگرش سفید است، یا مانند ماه که در برخی زمان‌ها نوارهای سیاه و سفیدی دارد."],[187,"هر که این نیمه ببیند رد کند","هر که آن نیمه ببیند کد کند","هر کسی که نیمه سیاه گاو را ببیند، آن را رد می‌کند و هر کسی که نیمه سپید را ببیند، آن را می‌پسندد."],[187,"یوسف اندر چشم اخوان چون ستور","هم وی اندر چشم یعقوبی چو حور","در چشمان برادران، یوسف مانند یک حیوان زشت به نظر می‌رسد، اما در چشمان یعقوب، او همچون حوری زیبا دیده می‌شود. این بیت به تضاد درک و دیدگاه افراد مختلف نسبت به یکسانی می‌پردازد."],[187,"از خیال بد مرورا زشت دید","چشم فرع و چشم اصلی ناپدید","چشم ظاهر بین برادران یوسف به دلیل گرفتار بودن در خیالات و تصورهای ناپسند، چهره یوسف را زشت دیدند در حالی که چشم حیقیت بین آنها در حجاب جسمانی مخفی شده بود ."],[187,"چشم ظاهر سایه آن چشم دان","هرچه آن بیند بگردد این بدان","چشم ظاهری فقط سایه‌ای از چشم باطن است و هرچیزی که آن چشم باطن ببیند، چشم ظاهر هم به نوعی آن را درک می‌کند."],[187,"تو مکانی اصل تو در لامکان","این دکان بر بند و بگشا آن دکان","تو در حقیقت و وجود خود، محلی از وجود نداری و در لامکان واقع هستی، پس این دنیای مادی را که همچون دکان است، رها کن و به حقیقت والای خود بپرداز."],[187,"شش جهت مگریز زیرا در جهات","ششدره‌ست و ششدره ماتست مات","در هیچ‌یک از شش جهت (شمال، جنوب، شرق، غرب، بالا، پایین) نرو، زیرا در هر کدام از این جهات، تو را به خواب و بی‌خبری می‌برد و در خواب بودن، حالت ناپایداری است."],[188,"با وکیل قاضی ادراک‌مند","اهل زندان در شکایت آمدند","اهل زندان، که در بند هستند، به وکیل قاضی که فردی دانا و فهمیده است، مراجعه کردند تا شکایت خود را مطرح کنند."],[188,"که سلام ما به قاضی بر، کنون","بازگو آزار ما زین مرد دون","سلام ما را به قاضی برسان و الان مشکل خود را از این مرد بی‌ارزش و پست، برای او بگو."],[188,"کندرین زندان بماند او مستمر","یاوه‌تاز و طبل‌خوارست و مضر","در این زندان، او به‌طور مداوم مشغول حرف‌های بی‌معنی و سر و صداست، مانند فردی که فقط به برانگیختن سر و صدا و حواس‌پرتی می‌پردازد و مضر است."],[188,"چون مگس حاضر شود در هر طعام","از وقاحت بی صلا و بی سلام","هرگاه مگس بر سر خوراکی حاضر شود، نشان از بی‌شرمی و بی‌ادبی اوست که بدون احترامی و بدون سلام وارد می‌شود."],[188,"پیش او هیچست لوت شصت کس","کر کند خود را اگر گوییش بس","نزد او، یعنی در پیشگاه قاضی یا وکیل، هیچ نفع و سودی برای شصت نفر وجود ندارد، و او (مفلس) خود را در برابر آن‌ها به حالت کر و ناشنوا در می‌آورد اگر به او بگوید این موضوع را."],[188,"مرد زندان را نیاید لقمه‌ای","ور به صد حیلت گشاید طعمه‌ای","مرد زندانی نمی‌تواند لقمه‌ای برای خود به دست آورد، حتی اگر با صد حیله هم تلاش کند، باز هم طعمه‌ای پیدا نخواهد کرد."],[188,"در زمان پیش آید آن دوزخ گلو","حجتش این که خدا گفتا کلوا","در زمان قیامت، آتش جهنم در گلو و حلق انسان‌ها خود را نمایان می‌کند و دلیل آن این است که خداوند فرموده است: «بخورید!» یعنی انسان‌ها به غذا و لذت‌های دنیوی پرداخته‌اند و در نتیجه به عذاب گرفتار می‌شوند."],[188,"زین چنین قحط سه‌ساله داد داد","ظل مولانا ابد پاینده باد","این سه سال قحطی و کمبود غذا به خاطر ظلم و ستم حاکمیت مولانا به یادگار مانده و تا ابد پایدار باشد."],[188,"یا ز زندان تا رود این گاومیش","یا وظیفه کن ز وقفی لقمه‌ایش","شخصی می‌گوید یا از زندان آزاد شو تا این گاومیش (که به‌عنوان نماد عسر و مشکلات است) از بین برود، یا اینکه وظیفه‌ای را انجام بده که از نذری (وقف) به او لقمه‌ای برسد."],[188,"ای ز تو خوش هم ذکور و هم اناث","داد کن المستغاث المستغاث","ای کسی که باعث شادی مردان و زنان هستی، به ما کمک کن و نجات‌دهنده ما باش."],[188,"سوی قاضی شد وکیل با نمک","گفت با قاضی شکایت یک به یک","وکیل به سمت قاضی رفت و با آداب و لحن نیکو گفت که شکایت‌های زندانیان را یکی یکی بیان کند."],[188,"خواند او را قاضی از زندان به پیش","پس تفحص کرد از اعیان خویش","قاضی به وکیل دستور می‌دهد تا زندانیان را از زندان به نزد او بیاورد، سپس درباره اصل و نسب آن‌ها تحقیق می‌کند."],[188,"گشت ثابت پیش قاضی آن همه","که نمودند از شکایت آن رمه","همه شکایت‌هایی که از طرف آن گروه (اهل زندان) به قاضی ارائه شد، باعث شد تا قاضی به صداقت و ثبات آن شکایت‌ها پی ببرد."],[188,"گفت قاضی خیز ازین زندان برو","سوی خانه مردریگ خویش شو","قاضی به زندانی می‌گوید که از این زندان خارج شود و به خانه‌ی مردی به نام ریسک (مردریگ) برود."],[188,"گفت خان و مان من احسان تست","همچو کافر جنتم زندان تست","او می‌گوید که خانه و زندگی‌ام در اختیار توست و اینجا مانند جهنمی است که با احسان تو فراهم شده، مانند کافرانی که در بهشت زندانی شده‌اند."],[188,"گر ز زندانم برانی تو به رد","خود بمیرم من ز تقصیری و کد","اگر تو مرا از زندان آزاد کنی، به خاطر اشتباهات و تقصیرهایم جان می‌دهم."],[188,"همچو ابلیسی که می‌گفت ای سلام","رب انظرنی الی یوم القیام","این بیت به ابلیس اشاره دارد که در روز قیامت از خداوند درخواست مهلت می‌کند تا تا آن زمان زنده بماند. شاعر به این معنا می‌پردازد که زندانیان نیز مانند ابلیس از وضعیت خود نگران هستند و به دنبال فرصتی برای رهایی از قید و بندهایشان هستند."],[188,"کاندرین زندان دنیا من خوشم","تا که دشمن‌زادگان را می‌کشم","من در این زندان دنیا احساس خوشحالی می‌کنم تا زمانی که دشمنان را نابود کنم."],[188,"هر که او را قوت ایمانی بود","وز برای زاد ره نانی بود","هر کسی که ایمان قوی دارد و برای معیشت خود تلاش می‌کند، در مرتبه‌ای از قدرت و توان قرار می‌گیرد."],[188,"می‌ستانم گه به مکر و گه به ریو","تا بر آرند از پشیمانی غریو","گاهی با نیرنگ و حیله چیزی از آنها می‌گیرم و گاهی با تظاهر و فریب، تا از پشیمانی‌شان صدای ناله شنیده شود."],[188,"گه به درویشی کنم تهدیدشان","گه به زلف و خال بندم دیدشان","گاهی با حالت درویش‌مآب به تهدید آن‌ها می‌پردازم و گاهی با زیبایی و جذابیت زلف و خال خودشان را مجذوب می‌کنم."],[188,"قوت ایمانی درین زندان کمست","وانک هست از قصد این سگ در خمست","ایمان در این زندان ضعیف است، اما هدف از اینجا همانند حیوانی است که در سوراخ خود پنهان شده است."],[188,"از نماز و صوم و صد بیچارگی","قوت ذوق آید برد یکبارگی","از عبادت‌ها مانند نماز و روزه و صدقه، به خاطر بیچارگی، لذت و نشأتی به وجود می‌آید که ناگهان به انسان دست می‌دهد."],[188,"استعیذ الله من شیطانه","قد هلکنا آه من طغیانه","از خداوندHelp می‌طلبیم که به ما از شر شیطان پناه دهد، زیرا به سبب طغیان و سرکشی‌مان به هلاکت خود نزدیک شده‌ایم."],[188,"یک سگست و در هزاران می‌رود","هر که در وی رفت او او می‌شود","هر کسی که در جمع انسان‌ها قرار گیرد و به آن‌ها وابسته شود، مانند سگی است که در میان هزاران سگ دیگر می‌چرخد و نهایتا تحت تأثیر محیط و کسانی که در آن‌ها حضور دارد، شبیه آن‌ها می‌شود."],[188,"هر که سردت کرد می‌دان کو دروست","دیو پنهان گشته اندر زیر پوست","هر کسی که تو را سرد و بی‌عاطفه کرد، باید بداند که در درون او دیوی پنهان شده است که زیر پوستش مخفی شده است."],[188,"چون نیابد صورت آید در خیال","تا کشاند آن خیالت در وبال","وقتی چیزی را در دنیا نمی‌بینی، فقط در ذهن تصورش می‌کنی؛ این تصور به تو سختی می‌آورد و باعث مشکلاتی می‌شود که شاید ناشی از صدای درون خودت باشد."],[188,"گه خیال فرجه و گاهی دکان","گه خیال علم و گاهی خان و مان","گاهی به خیال خود امید آزادی و گاهی به فکر رونق و کسب و کار می‌افتم، و گاهی در اندیشه علم و گاهی به یاد خانه و خانواده‌ام می‌باشم."],[188,"هان بگو لا حولها اندر زمان","از زبان تنها نه بلک از عین جان","ای شنونده، بگو که در این زمان هیچ قدرت و نیرویی از خود ما نیست، بلکه باید از عمق وجود و حقیقت جان خود بگوییم."],[189,"گفت قاضی مفلسی را وا نما","گفت اینک اهل زندانت گوا","قاضی به مفلسی می‌گوید که او را به زندان ببرند و از اهل زندان به عنوان شاهد یاد می‌کند."],[189,"گفت ایشان متهم باشند چون","می‌گریزند از تو می‌گریند خون","قاضی می‌گوید که کسانی که به تو شهادت می‌دهند، ممکن است متهم باشند؛ چون آنها از تو فرار می‌کنند مانند کسی که از خون خود می‌گریزد."],[189,"وز تو می‌خواهند هم تا وارهند","زین غرض باطل گواهی می‌دهند","افرادی که به تو پناه آورده‌اند، برای اینکه از این هدف نادرست و بی‌اساس فرار کنند، شهادت و گواهی می‌دهند."],[189,"جمله اهل محکمه گفتند ما","هم بر ادبار و بر افلاسش گوا","همه اهل دادگاه گفتند که ما هم بر بی‌پولی و بدبختی او شهادت می‌دهیم."],[189,"هر که را پرسید قاضی حال او","گفت مولا دست ازین مفلس بشو","هرکسی که قاضی حال این مفلس را پرسید، گفت: ای آقای من، از این مفلس دست بردارید."],[189,"گفت قاضی که‌ش بگردانید فاش","گرد شهر این مفلس است و بس قلاش","قاضی گفت که این را در شهر بگردانید و رسما اعلام کنید که این شخص مفلس است و فقط قلاش (کسی که از قشر پایین جامعه و بی‌پول است) می‌باشد."],[189,"کو به‌کو او را منادی‌ها زنید","طبل افلاسش عیان هر جا زنید","در هر نقطه‌ای، با صدای بلند خبر بی‌پولی او را پخش کنید و طبل ناداری‌اش را به صدا درآورید تا همه از وضعیت او آگاه شوند."],[189,"هیچ کس نسیه بنفروشد بدو","قرض ندهد هیچ کس او را تسو","هیچ‌کس به او چیزی به‌صورت نسیه نمی‌فروشد و به او قرض نمی‌دهد، زیرا هیچ‌کس او را نمی‌خواهد و به او کمکی نمی‌کند."],[189,"هر که دعوی آردش اینجا به‌فن","بیش زندانش نخواهم کرد من","هر کس که در اینجا ادعایی کند، به زبان و با هنر خود، به خاطر او اجازه نخواهم داد که در زندان من بماند."],[189,"پیش من افلاس او ثابت شده‌ست","نقد و کالا نیستش چیزی به‌دست","من پیش خود می‌دانم که او بی‌پولی و تنگدستی‌اش به اثبات رسیده است و چیزی به‌عنوان مال و دارایی در اختیار ندارد."],[189,"آدمی در حبس دنیا ز‌آن بود","تا بود که‌افلاس او ثابت شود","انسان در دنیای مادی زندانی است تا زمانی که فقر و بی‌چیزی‌اش برای او روشن شود."],[189,"مفلسی دیو را یزدان ما","هم منادی کرد در قرآن ما","خدای یزدان (خدا) در قرآن ما صدای افلاس (بی‌پولی و ناداری) دیو را اعلام کرده است."],[189,"کاو دغا و مفلس است و بد سخن","هیچ با او شرکت و سودا مکن","کسی که فریبکار و بی‌چیز است و بد سخن می‌گوید، هیچ‌گاه با او همکاری نداشته‌ باش و مبادله‌ای نکن."],[189,"ور کنی او را بهانه آوری","مفلس است او، صرفه از وی کی بری‌‌؟","اگر به او بهانه بدهی و به او اعتماد کنی، در واقع او یک شخص مفلس و بی‌اعتبار است و چه فایده‌ای از او نصیب تو خواهد شد؟"],[189,"حاضر آوردند چون فتنه فروخت","اشتر کردی که هیزم می‌فروخت","به خدمت آوردند شخصی را که به خاطر فتنه‌ای که به پا کرده بود، او را مجازات کردند. او یک چوپان کرد بود که هیزم می‌فروخت و حالا در این موقعیت قرار گرفته است."],[189,"کرد بیچاره بسی فریاد کرد","هم موکل را به دانگی شاد کرد","مرد کرد بیچاره خیلی گریه و فریاد زد و حتی نگهبانش را هم خوشحال کرد."],[189,"اشترش بردند از هنگام چاشت","تا شب و افغان او سودی نداشت","گفتند که شتر (حیوان بارکش) او را در زمان ناهار به سرقت بردند و او تا شب فریاد زد، اما فریاد او بی‌نتیجه ماند و سودی نداشت."],[189,"بر شتر بنشست آن قحط گران","صاحب اشتر پی اشتر دوان","صاحب آن شتر که در قحطی و سختی زندگی می‌کند، بر شتر سوار شد و به دنبال آن شتر دوان دوان رفت."],[189,"سو به سو و کو به کو می‌تاختند","تا همه شهرش عیان بشناختند","آن‌ها در هر گوشه و کنار شهر در حال دویدن و جست‌وجو بودند تا اینکه همه مردم او را شناختند و او در دید همگان قرار گرفت."],[189,"پیش هر حمام و هر بازار‌گه‌","کرده مردم جمله در شکلش نگه","مردم در مقابل هر حمام و بازار، به شکل و ظاهر او (مفلس) نگاه می‌کردند و او را می‌دیدند."],[189,"ده منادی‌گر بلند آوازیان","ترک و کرد و رومیان و تازیان","ده نفر منادی با صدای بلند و رسایی از قوم‌های مختلف مانند ترک‌ها، کردها، رومی‌ها و عرب‌ها به صدا درآمده‌اند."],[189,"مفلس است این و ندارد هیچ چیز","قرض تا ندهد کس او را یک پشیز","مفلس (بی‌پول) است و هیچ چیزی ندارد، حتی قرضی که از دیگران بگیرد؛ پس نمی‌تواند حتی یک پشیز (پول کوچک) به کسی بدهد."],[189,"ظاهر و باطن ندارد حبه‌ای","مفلسی قلبی دغایی دبه‌ای","مفلس نه در ظاهر و نه در باطن هیچ دارایی ندارد؛ او فقط قلبی پر از دغدغه و نگرانی دارد، مانند دبه‌ای که تنها در ظاهر وجود دارد ولی درونش خالی است."],[189,"هان و هان با او حریفی کم کنید","چونک گاو آرد گره محکم کنید","مراقب باشید در برخورد با او دوستانه باشید و بی‌محابا به او نپرید، زیرا زمانی که او به مشکل برمی‌خورد، بهتر است که به او کمک و حمایت کنید."],[189,"ور به‌حکم آرید این پژمرده را","من نخواهم کرد زندان مرده را","اگر به دستور خودتان این زهره و پژمرده را به زندان بیندازید، من هرگز نمی‌خواهم که زندانی شوم مانند یک مرده."],[189,"خوش‌دمست او و گلویش بس فراخ","با شعار نو دثار شاخ شاخ","شعار جامه‌ی میانی است و لباسی که در زیر دثار و بر روی جامه‌ی زیرین برتن کنند. و دثار جامه‌ی رویین یا زبرین است. بیت یعنی: آدمی چرب‌زبان و خوش‌دم است و توانا در سخن‌گویی و لباس‌های نو و فاخر می‌پوشد."],[189,"گر بپوشد بهر مکر آن جامه را","عاریه‌ست آن تا فریبد عامه را","لباس‌هایش عاریه است تا مردم را با ظاهری باتجمل بفریبد. (که به او قرض و وام دهند)"],[189,"حرف حکمت بر زبان نا‌حکیم","حله‌های عاریت دان ای سلیم","سخن حکمت و راستی را هم بر زبان شخص ناحکیم و ناراست همچون آن زیورها و لباس‌های عاریتی بدان. (که برای فریب است)"],[189,"گرچه دزدی حله‌ای پوشیده است","دست تو چون گیرد آن ببریده‌دست","اگرچه دزدی که دزدی را به سرقت برده، در پوشش و تظاهر به کار نیکو به نظر می‌رسد، اما زمانی که او گرفتار شود، حقیقت نیتش آشکار خواهد شد."],[189,"چون شبانه از شتر آمد به زیر","کرد گفتش منزلم دورست و دیر","شخصی شبانه از شتر پایین آمده و به کردی که در آنجا است می‌گوید که منزلش بسیار دور و به زمان زیادی برای رسیدن نیاز دارد."],[189,"بر نشستی اشترم را از پگاه","جو رها کردم کم از اخراج کاه","گفت که از صبح زود سوار بر شتر شدم و آن را به حال خود رها کردم و به اندازه‌ای برانگیخته شدم که گویی هیچ کاه و بار روی آن نبوده است."],[189,"گفت تا اکنون چه می‌کردیم پس‌‌؟!","هوش تو کو‌‌؟ نیست اندر خانه کس‌‌‌؟","سوال می‌کند که تا حالا چه کاری انجام می‌دادیم؟ آیا حواس و هوش تو کجا رفته؟ آیا کسی در خانه نیست؟"],[189,"طبل افلاسم به چرخ سابعه","رفت و تو نشنیده‌ای بد واقعه","طبل زندگی من به چرخ هفتم (چرخ برج زحل) رفته است و تو هنوز از این واقعه خبر ندارید."],[189,"گوش تو پر بوده‌است از طمع خام","پس طمع کر می‌کند کور ای غلام","گوش تو از طمع نابجا پر شده است، به همین دلیل طمع باعث می‌شود که تو مانند کرها نشنوی و بینا نباشی، ای غلام."],[189,"تا کلوخ و سنگ بشنید این بیان","مفلس‌ست و مفلس‌ست این قلتبان","کلوخ و سنگ هم از این سخن باخبر شدند که این شخص بی‌چیز و بی‌مال است و لذا کسی به او توجه نمی‌کند."],[189,"تا به شب گفتند و در صاحب شتر","بر نزد کاو از طمع پر بود پر","در شب، به کسی که صاحب شتر بود گفتند که او از طمع پر از آرزو و خواسته‌هایش است."],[189,"هست بر سمع و بصر مهر خدا","در حجب بس صورت‌ست و بس صدا","خداوند بر گوش و چشم انسان‌ها نشانه‌ای دارد؛ بسیاری از چیزها از نظر ظاهر و صدا فقط یک سطح هستند و حقیقت عمیق‌تری در آن‌ها نهفته است."],[189,"آنچ او خواهد رساند آن به چشم","از جمال و از کمال و از کرشم","هر آنچه که خداوند می‌خواهد به چشم انسان‌ها می‌رساند، شامل زیبایی، کمال و جذابیتی است که وجود دارد."],[189,"و آنچ او خواهد رساند آن به گوش","از سماع و از بشارت وز خروش","آنچه او (خدا) می‌خواهد به گوش تو برساند، مربوط به آوازها و نویدهایی است که از شور و شوق ناشی می‌شود."],[189,"کون پر چاره‌ست، هیچت چاره نی","تا که نگشاید خدایت روزنی","کائنات پر از راه حل و تدبیر است، اما تو برای مشکل‌ات هیچ چاره‌ای نداری تا زمانی که خداوند روزنه‌ای به رویت بگشاید و تو را از مشکلات رها کند."],[189,"گرچه تو هستی کنون غافل از آن","وقت حاجت حق کند آن را عیان","هرچند که اکنون غافل هستی و متوجه نیاز خود به خدا نیستی، اما در زمان نیاز، خداوند آن را به تو نمایان می‌کند."],[189,"گفت پیغامبر که یزدان مجید","از پی هر درد درمان آفرید","پیامبر گفته است که خداوند بزرگ برای هر دردی درمانی قرار داده است."],[189,"لیک زان درمان نبینی رنگ و بو","بهر درد خویش بی فرمان او","اما تو رنگ و بوی آن درمان را نمی‌بینی، زیرا برای رفع درد خود، به خواست و اراده او توجهی نداری."],[189,"چشم را ای چاره‌جو در لامکان","هین بنه چون چشم‌ کشته سوی جان","ای چاره‌جو، چشم خود را به سوی لامکان (جایی که وجود ندارد) معطوف کن و مانند چشمی که به دنبال جان خودش می‌گردد، به آن نگاه کن."],[189,"این جهان از بی جهت پیدا شده‌ست","که ز بی‌جایی جهان را جا شده‌ست","این جهان به طور بی‌دلیل و از هیچ موجود شده است، به همین دلیل جهان بر اساس ناچیزی و بی‌جایی ساخته شده است."],[189,"باز گرد از هست سوی نیستی","طالب ربی و ربانیستی","به این دنیا و وجود بازنگر و به سوی عدم و نیستی بازگرد. تو در جست‌وجوی خداوند هستی و در واقع، آن جنبه خدایی خود را در وجودت یافتی."],[189,"جای دخل‌ست این عدم از وی مرم","جای خرج‌ست این وجود بیش و کم","عدم، جایی برای دخل و صرف‌نظر از چیزهاست، در حالی که وجود منبع هزینه و خرج کردن است، چه کم و چه زیاد."],[189,"کارگاه صنع حق چون نیستی‌ست","جز معطل در جهان هست کیست‌‌‌؟","در این بیت، مولانا می‌گوید که کارگاه آفریدن خداوند مانند عدم و نیستی است، و اگر انسان در این دنیا که وجود دارد معطل بماند، چه کسی در این جهان از این وضعیت متأثر می‌شود؟ به عبارت دیگر، او به بی‌فایده بودن اتلاف وقت در دنیا اشاره می‌کند."],[189,"یاد ده ما را سخن‌های دقیق","که ترا رحم آورد آن ای رفیق","ای رفیق، ما را به یاد سخن‌های عمیق و دقیق بینداز تا رحمت تو شامل حال ما شود."],[189,"هم دعا از تو اجابت هم ز تو","ایمنی از تو مهابت هم ز تو","هم دعای ما از سوی تو مستجاب می‌شود، هم از تو ایمنی داریم، و هم از تو به خاطر ترس و خشیتت در امان هستیم."],[189,"گر خطا گفتیم اصلاحش تو کن","مصلحی تو ای تو سلطان سخن","اگر در گفتن اشتباهی کرده‌ایم، تو آن را اصلاح کن؛ زیرا تو مصلح هستی و سلطان سخن."],[189,"کیمیا داری که تبدیلش کنی","گرچه جوی خون بود نیلش کنی","تو دارای هنر و توانایی کیمیاگری هستی که می‌توانی چیزهای بی‌ارزش را به چیزهای باارزش تبدیل کنی، حتی اگر وضعیت به شدت مشکل باشد و محیط پر از رنج و سختی باشد."],[189,"این چنین مینا‌گر‌ی‌ها کار تست","این چنین اکسیر‌ها اسرار تست","این کارها و هنرهایی که در میناگری و ساخت اکسیر (نوشیدنی‌های جادویی) انجام می‌شود، به دست توست و تو هستی که این رازها را دانسته و می‌توانی آنها را عملی کنی."],[189,"آب را و خاک را بر هم زدی","ز آب و گل نقش تن آدم زدی","تو با مخلوط کردن آب و خاک، جسم انسان را خلق کردی و از این ترکیب، شکل و نقش تن آدمی را به وجود آوردی."],[189,"نسبتش دادی و جفت و خال و عم","با هزار اندیشه و شادی و غم","به انسان نسبت پدر و مادر و ویژگی‌هایی همچون جفت و خال (نشانه‌های ظاهری) داده‌ای، در حالی که او را با هزاران اندیشه و احساس شادی و غم احاطه کرده‌ای."],[189,"باز بعضی را رهایی داده‌ای","زین غم و شادی جدایی داده‌ای","برخی را از این غم و شادی رها کرده‌ای و جدایی را برایشان به پایان رسانده‌ای."],[189,"برده‌ای از خویش و پیوند و سرشت","کرده‌ای در چشم او هر خوب زشت","تو از ویژگی‌ها و روابط انسانی خود دور کرده‌ای و در نظر او، هر چیز خوب به زشت تبدیل شده است."],[189,"هر چه محسوس است او رد می‌کند","وانچ ناپیدا‌ست مسند می‌کند","هر چیزی که در دنیای محسوس و قابل لمس وجود دارد، او آن را رد می‌کند و نمی‌پذیرد؛ اما آنچه نامرئی و غیرقابل مشاهده است، برای او اهمیت دارد و بر آن تکیه می‌کند."],[189,"عشق او پیدا و معشوقش نهان","یار بیرون فتنه او در جهان","عشق الهی روشن و آشکار است، اما محبوب واقعی آن (خداوند) پنهان و ناپیداست. یار (خدا) در میان فتنه‌ها و مشکلات دنیا، خارج از آن‌ها قرار دارد."],[189,"این رها کن عشق‌های صورتی","نیست بر صورت نه بر روی ستی","عشق‌های ظاهری و ظاهرساز را رها کن، زیرا عشق حقیقی، چیزی فراتر از شکل و ظاهر است و به صرف زیبایی‌های ظاهری نمی‌انجامد."],[189,"آنچ معشوق‌ست صورت نیست آن","خواه عشق این جهان خواه آن جهان","معشوق واقعی چیزی فراتر از ظواهر مادی است و به شکل و صورت محدود نمی‌شود؛ او می‌تواند هم در این دنیا باشد و هم در آن دنیا."],[189,"آنچ بر صورت تو عاشق گشته‌ای","چون برون شد جان چرایش هشته‌ای‌‌؟","تو که به زیبایی ظاهری خود عشق ورزیده‌ای، چرا وقتی جانت از بدن خارج می‌شود، همچنان به آن زیبایی وابسته هستی و آن را تابع خود می‌دانی؟"],[189,"صورت‌ش بر جاست این سیری ز چیست‌؟","عاشقا وا جو که معشوق تو کیست‌‌؟","چهره‌اش همچنان باقی است، اما این شور و حال عاشقانه از کجا ناشی می‌شود؟ ای عاشق، بپرس که معشوق تو کیست؟"],[189,"آنچ محسوس‌ست اگر معشوقه است","عاشق‌ستی هر که او را حس هست","هر چیزی که در جهان محسوس و قابل‌لمس است، اگر معشوقه (محبوب) باشد، عاشق هم در وجود او احساساتی دارد؛ یعنی هر کسی که او را احساس می‌کند، باید عاشق او باشد."],[189,"چون وفا آن عشق افزون می‌کند","کی وفا صورت دگرگون می‌کند‌‌؟","هرگاه وفا در عشق افزایش یابد، آیا وفا شکلی متفاوت به خود نمی‌گیرد؟"],[189,"پرتو خورشید بر دیوار تافت","تابش عاریتی دیوار یافت","پرتو خورشید بر دیوار می‌تابد و این تابش، باعث می‌شود که دیوار نیز به نوعی نور و زیبایی بگیرد، اما این نور و زیبایی موقتی و قرضی است."],[189,"بر کلوخی دل چه بندی ای سلیم‌؟!","وا طلب اصلی که تابد او مقیم","ای سلیم، چرا به چیزی بی‌ارزش و ناچیز مانند کلوخ دل می‌بندی؟! باید به چیزی که اصل و اساسی دارد بپردازی، تا آن حقیقت در تو ساکن شود."],[189,"ای که تو هم عاشقی بر عقل خویش","خویش بر صورت‌پرستان دیده بیش","ای کسی که تو نیز عاشق هستی، بر عقل و فهم خود تکیه کن، چراکه تو بیشتر از زیبایی‌پرستان، به حقیقت و عمق معنا گرا هستی."],[189,"پرتو عقل‌ست آن بر حس تو","عاریت می‌دان ذهب بر مس تو","نور و روشنایی عقل، مثل نوری است که به حس تو رسیده و می‌توان آن را به عنوان وام گرفته‌شده در نظر گرفت، همان‌طور که طلا (زر) فقط بر مس (برنج) نمی‌تواند وجود داشته باشد."],[189,"چون زر‌اندود‌ست خوبی در بشر","ورنه چون شد شاهد تر پیره‌خر‌؟","خوبی‌های انسانی مانند طلا بر روی چیزی پوشانده شده است، وگرنه چرا شاهدی که زیباست باید شبیه پیری تندخو و تلخ‌کام باشد؟"],[189,"چون فرشته بود همچون دیو شد","کان ملاحت اندرو عاریه بد","وقتی که زیبایی او به فرشته‌ها شباهت داشت، به زشتی دیو همانی تبدیل شد؛ زیرا آن زیبایی، موقتی و عاری از خود او بود."],[189,"اندک اندک می‌ستانند آن جمال","اندک اندک خشک می‌گردد نهال","به تدریج همان زیبایی که در ابتدا بود، از دست می‌رود و به همین ترتیب، درخت زندگی نیز کم‌کم خشک می‌شود."],[189,"رو نعمره ننکسه بخوان","دل طلب کن دل منه بر استخوان","دل را به طلب عشق و زیبایی مشغول کن و در پی آن باش، نه اینکه تنها بر چیزهای مادی و گذرا مانند استخوان‌های بی‌جان توجه کنی."],[189,"کآن جمال دل جمال باقی‌ است","دولتش از آب حیوان ساقی است","آن زیبایی که دل را زیبا می‌کند، زیبایی دائمی است و نعمت او از آب حیات (که به زندگی ابدی اشاره دارد) به‌دست می‌آید و او همان ساقی است."],[189,"خود هم او آبست و هم ساقی و مست","هر سه یک شد چون طلسم تو شکست","خود او هم در حال آبستن شدن است، هم ساقی است و هم مست. هر سه حالت او یکی شده‌اند، مانند اینکه وقتی طلسمی شکسته می‌شود، همه چیز به حقیقت و وضوح درمی‌آید."],[189,"آن یکی را تو ندانی از قیاس","بندگی کن، ژاژ کم خا ناشناس","برای شناختن حقیقت را از طریق قیاس و مقایسه بندگی نکن، زیرا عقیده و گفته‌های ناپخته و بی‌اساس است."],[189,"معنی تو صورت‌ست و عاریت","بر مناسب شادی و بر قافیت","معنی تو، ظاهری و به اصطلاح پوسته‌است که به شما تعلق ندارد و فقط چیزی موقتی و امانتی برای شادی و زیبایی می‌باشد."],[189,"معنی آن باشد که بستاند ترا","بی نیاز از نقش گرداند ترا","مقصود این است که کسی به خود بی‌نیاز می‌شود و به جای توجه به ظواهر و نقش‌ها، به باطن و حقیقت زندگی پی می‌برد."],[189,"معنی آن نبود که کور و کر کند","مرد را بر نقش عاشق‌تر کند","این بیت می‌گوید که اگر کسی کور و کر شود، این باعث نمی‌شود که او را در عشق و محبت ضعیف‌تر کند، بلکه ممکن است او حتی عاشق‌تر و شیداتر شود."],[189,"کور را قسمت خیال غم‌فزا‌ست","بهره چشم این خیالات فنا‌ست","کور به چشمی که چیزی نمی‌بیند، فقط قسمت غم و اندوه را میسر شده است و او از دیدن زیبایی‌ها و خیالات فانی که به خاطر آن غمگین می‌شود، بی‌بهره است."],[189,"حرف قرآن را ضریران معدن‌ند","خر نبینند و به پالان بر زنند","انسان‌های نابینا (ضریران) معانی عمیق قرآن را درک نمی‌کنند و فقط به ظواهر (پالان) آن وابسته‌اند."],[189,"چون تو بینایی پی خر رو که جست","چند پالان‌دوزی ای پالان‌پرست‌؟!","چون تو بینا هستی، به سمت خر برو و ببین او چه چیزی را از دست داده است که تو، به عنوان عاشق پالان، فقط به زیبایی پالان توجه می‌کنی؟"],[189,"خر چو هست آید یقین پالان ترا","کم نگردد نان‌، چو باشد جان ترا","اگر خر (که نماد کار و تلاش است) وجود داشته باشد، یقینا پالان (تجهیزات کار) تو کم نخواهد شد. با وجود جان و زندگی در تو، از تأمین نان و روزی نگران نخواهی بود."],[189,"پشت خر دکان و مال و مکسب است","در قلبت مایه صد قالب است","پشت خر، محل کسب و کار و ثروت است، در حالی که دل تو خود دارای ارزش و گنجی بسیار بیشتر از هر چیزی است."],[189,"خر برهنه بر نشین ای بوالفضول","خر برهنه نی که راکب شد رسول","ای بوالفضول، بر روی خر برهنه بنشین، چراکه این خر برهنه نیست، بلکه آن کسی که سوار آن شده، پیامبر است و او دارای مقام والایی است."],[189,"النبی قد رکب معروریا","والنبی قیل سافر ماشیا","پیامبر (محمد) بر الاغی به نام معرور سوار شد و وقتی خبر سفرش به دیگران رسید، گفته شد که او پیاده سفر می‌کند."],[189,"شد خر نفس تو‌، بر میخی‌ش بند","چند بگریزد ز کار و بار چند‌‌؟","نفس تو مانند خر (حیوانی که بار می‌کشد) به میخی بسته شده است. اگر این نفس بخواهد، نمی‌تواند از مسئولیت‌ها و کارهایش فرار کند، حتی اگر بخواهد گاهی از زیر بار آنها بیرون برود."],[189,"بار صبر و شکر او را بردنی‌ست","خواه در صد سال و خواهی سی و بیست","صبر و شکر کردن نسبت به پروردگار، برای هر کسی بر عهده اوست و این بار سنگین صبر و شکر را باید بکشند، چه این پروسه صد سال طول بکشد و چه سی سال و بیست سال."],[189,"هیچ وازر وزر غیری بر نداشت","هیچ کس ندرود تا چیزی نکاشت","هیچ کسی بار گناه و عذاب دیگری را به دوش نمی‌کشد و هیچ‌کس نمی‌تواند بدون کوشش و عمل از چیزی بهره‌برداری کند."],[189,"طمع خامست آن مخور خام ای پسر","خام خوردن علت آرد در بشر","ای پسر خام، به طمعی بی‌جا و نادرست دل‌بستگی نداشته باش؛ زیرا طمع و آرزوی بی‌اساس، موجب می‌شود که انسان از درک واقعیت دور شده و دچار مشکلات و زیان‌ها گردد."],[189,"کان فلانی یافت گنجی ناگهان","من همان خواهم مه کار و مه دکان","فلانی به‌طور ناگهانی به گنجی دست یافته است و من هم همان را می‌خواهم، یعنی به دنبال شغل و کسب و کار خود هستم."],[189,"کار بخت‌ست آن و آن هم نادر‌ست","کسب باید کرد تا تن قادر‌ست","بخت و اقبال بستگی به کار و تلاش دارد و این موفقیت‌ها نادر هستند؛ بنابراین باید عمل کنیم و کار کنیم تا بتوانیم به توفیق برسیم."],[189,"کسب کردن گنج را مانع کی است‌‌؟","پا مکش از کار آن خود در پی است","کسی مانع کسب و به دست آوردن ثروت نمی‌شود، بنابراین از دنبال کردن کار خود کم نگذار."],[189,"تا نگردی تو گرفتار اگر","که اگر این کردمی یا آن دگر","تا زمانی که تو درگیر هیچ «اگر» و «ای کاش» نشوی و خود را گرفتار پشیمانی‌ها و شرایط ممکن نکنید، نمی‌توانی به چیزی دست یابی."],[189,"کز اگر گفتن رسول با وفاق","منع کرد و گفت آن هست از نفاق","پیامبر (رسول) مردم را از گفتن «اگر» برحذر داشت و آن را نشانه‌ای از نفاق دانست؛ چرا که تردید و شرطی‌سازی در عمل، باعث نفاق می‌شود."],[189,"کان منافق در اگر گفتن بمرد","وز اگر گفتن به جز حسرت نبرد","منافق در گفتن اگر بر سر وفاق از دنیا می‌رود و از گفتن جز حسرت و پشیمانی برایش باقی نمی‌ماند."],[190,"آن غریبی خانه می‌جست از شتاب","دوستی بردش سوی خانه خراب","آن غریبه به شدت در جست‌وجوی خانه‌ای بود که به خاطر دوستی، او را به سوی یک خانه نابود شده برد."],[190,"گفت او این را اگر سقفی بدی","پهلوی من مر تو را مسکن شدی","او (غریبی که به خانه‌ای خراب رفته) گفت اگر تو برای من سقفی بگذاری، در کنار من مسکن و منزلت خواهی داشت."],[190,"هم عیال تو بیاسودی اگر","در میانه داشتی حجره دگر","اگر تو در وسط خانه‌ات اتاق دیگری داشتی، همسر تو در آرامش و آسایش زندگی می‌کرد."],[190,"گفت آری پهلوی یاران بهست","لیک ای جان در اگر نتوان نشست","او می‌گوید که رابطه با یاران (دوستان) خوب است، اما اگر نتوانی در کنار آنان آرام بگذرانی و در آنجا راحت نباشی، فایده‌ای ندارد."],[190,"این همه عالم طلب‌کار خوشند","وز خوش تزویر اندر آتشند","این همه مردم در جستجوی خوشی و لذت هستند، اما به خاطر ظاهر فریبنده و نادرست، در درد و رنجی عمیق گرفتارند."],[190,"طالب زر گشته جمله پیر و خام","لیک قلب از زر نداند چشم عام","همه انسان‌ها در جستجوی زر (طلای حقیقی) شده‌اند، اما آن‌ها که پیر و نادان هستند، در حقیقت از ارزش واقعی زر بی‌خبرند و فقط به ظاهر چیزها می‌نگرند."],[190,"پرتوی بر قلب زد خالص ببین","بی محک زر را مکن از ظن گزین","نور و روشنی بر دل خالصی بتابان و آن را ببین؛ طلا را فقط بر اساس ظن و گمان انتخاب نکن."],[190,"گر محک داری گزین کن ور نه رو","نزد دانا خویشتن را کن گرو","اگر معیار و محک درستی برای ارزیابی داری، باید انتخاب کنی؛ اما اگر چنین نیست، بهتر است به دانا مراجعه کنی و خودت را در اختیار او قرار دهی."],[190,"یا محک باید میان جان خویش","ور ندانی ره مرو تنها تو پیش","اگر می‌خواهی خودت را بشناسی و به حقیقت وجودیت پی ببری، باید خودت را مانند یک محک در نظر بگیری و به درون خویش نگری. اگر این شناخت را نداری، به تنهایی به راه نرو."],[190,"بانگ غولان هست بانگ آشنا","آشنایی که کشد سوی فنا","صدای غول‌ها شبیه صدای آشناست؛ آشنایی که انسان را به سوی نابودی می‌کشاند."],[190,"بانگ می‌دارد که هان ای کاروان","سوی من آیید نک راه و نشان","صدای غولان به کاروان می‌گوید که بیایید به سمت من، اما هیچ راه و نشانی برای هدایت شما وجود ندارد."],[190,"نام هر یک می‌برد غول ای فلان","تا کند آن خواجه را از آفلان","غول (موجودی افسانه‌ای و ترسناک) نام هر یک از کاروانیان را می‌برد و با گفتن نام شخصی خاص، او را به سمت خود می‌کشاند تا او را از جمع دور کند."],[190,"چون رسد آنجا ببیند گرگ و شیر","عمر ضایع راه دور و روز دیر","زمانی که به آن مکان برسد، گرگ و شیر را می‌بیند که عمرش را در مسیرهای دور و روزهای طولانی هدر کرده است."],[190,"چون بود آن بانگ غول آخر بگو","مال خواهم جاه خواهم و آب رو","زمانی که صدای ترسناک غول را بشنوی، به او بگو که من مال و مقام و آبرو می‌خواهم."],[190,"از درون خویش این آوازها","منع کن تا کشف گردد رازها","برای درک رازهای درونی و حقایق عمیق، باید صدای درونی و خواسته‌های بی‌مورد را خاموش کرد."],[190,"ذکر حق کن بانگ غولان را بسوز","چشم نرگس را ازین کرکس بدوز","ذکر خدا را بسیار بگو تا صدای غول‌ها (واژه‌ای برای تمثیل به خطرات و مشکلات) خاموش شود و چشم نرگس (نماد زیبایی و محبت) را از این پرنده‌ی مضر (کرکس) دور نگه‌داری."],[190,"صبح کاذب را ز صادق وا شناس","رنگ می را باز دان از رنگ کاس","صبح دروغین را از صبح واقعی بشناس و رنگ شراب را از رنگ کاسه تمیز بده."],[190,"تا بود کز دیدگان هفت رنگ","دیده‌ای پیدا کند صبر و درنگ","تا زمانی که با چشم‌های هفت رنگ (رنگ‌های مختلف) به دنیا نگاه نکنی، نمی‌توانی صبر و آرامش را درک کنی و درنگ کنی."],[190,"رنگها بینی به جز این رنگها","گوهران بینی به جای سنگها","غیر از رنگ‌های ظاهری، زیبایی‌های درونی و ارزش‌های حقیقی را ببین؛ به جای توجه به چیزهای بی‌ارزش، به جواهرات درونی و معنوی نگاه کن."],[190,"گوهر چه بلک دریایی شوی","آفتاب چرخ‌پیمایی شوی","اگرچه تو گوهر باارزشی هستی، باید در عمق وجودت مانند دریا باشی تا به روشنی و تابش آفتاب در زندگی و جهان پیرامونت تبدیل شوی."],[190,"کارکن در کارگه باشد نهان","تو برو در کارگه بینش عیان","اگر کسی در کارگاه در حال کار است، او را پنهانی ببین. تو باید به کارگاه بروی و کار او را آشکارا مشاهده کنی."],[190,"کار چون بر کارکن پرده تنید","خارج آن کار نتوانیش دید","وقتی کار بر کسی که مشغول به کار است، پوششی می‌افتد، نمی‌توانی آن کار را از بیرون ببینی."],[190,"کارگه چون جای باش عاملست","آنک بیرونست از وی غافلست","محل کار، جایی است که عامل (کارگر) در آن مشغول به کار است، اما کسی که از آنجا خارج شده و ناظر نیست، از آن کار بی‌خبر و غافل خواهد بود."],[190,"پس در آ در کارگه یعنی عدم","تا ببینی صنع و صانع را بهم","پس در این مکان که به آن عدم می‌گویند، بیا تا بیندیشی و کار (آفرینش) و آفریننده را به هم مرتبط ببینی."],[190,"کارگه چون جای روشن‌دیدگیست","پس برون کارگه پوشیدگیست","کارگاه، یعنی دنیایی که در آن روشنایی و حقیقت نمایان است، در واقع مکان فهم و شهود است. در مقابل، خارج از این کارگاه، جایی است که حقایق و واقعیت‌ها پوشیده و پنهان است."],[190,"رو بهستی داشت فرعون عنود","لاجرم از کارگاهش کور بود","فرعون، که شخصیتی لجوج و سرسخت بود، به حقیقت و روشنایی دسترسی نداشت و بنابراین از کارگاه (آفرینش و مسائل عمیق) بینایی نداشت."],[190,"لاجرم می‌خواست تبدیل قدر","تا قضا را باز گرداند ز در","بنابراین، فرعون که در برابر حقیقت مقاومت می‌کرد، می‌خواست مقام و قدرت خود را تغییر دهد تا بتواند سرنوشت و قضا را از مسیر خود منحرف کند."],[190,"خود قضا بر سبلت آن حیله‌مند","زیر لب می‌کرد هر دم ریش‌خند","قضا، که نماینده تقدیر و سرنوشت است، به طور پنهانی و به طور مکرر به سخره می‌گیرد و تمسخر می‌کند، در حالی که تلاش می‌کند تا خود را در مسیر حیله‌گری پنهان کند."],[190,"صد هزاران طفل کشت او بی‌گناه","تا بگردد حکم و تقدیر اله","او به خاطر پیشبرد قضا و حکمش، بدون هیچ دلیلی، صد هزاران کودک بی‌گناه را به قتل رساند تا تقدیر الهی به انجام برسد."],[190,"تا که موسی نبی ناید برون","کرد در گردن هزاران ظلم و خون","تا زمانی که موسی نبی به دنیا نیاید، ظلم و خون‌ریزی بر دوش انسان‌ها خواهد بود."],[190,"آن همه خون کرد و موسی زاده شد","وز برای قهر او آماده شد","این بیت به وقایع تاریخی اشاره دارد که نشان می‌دهد پس از کشتارهای بسیار، موسی (نبی الله) به دنیا آمد و این به عنوان نشانه‌ای از آماده شدن مردم برای قهر و انتقام الهی تعبیر می‌شود."],[190,"گر بدیدی کارگاه لایزال","دست و پایش خشک گشتی ز احتیال","اگر کارگاه بی‌پایان او را می‌دیدی که دست و پایش به خاطر نقشه‌ها و تدبیرهایش خشک شده، دچار حیرت و شگفتی می‌شدی."],[190,"اندرون خانه‌اش موسی معاف","وز برون می‌کشت طفلان را گزاف","در خانه‌ی موسی، او از گناهان آمرزیده است و در بیرون، خود به طور بی‌رحمانه‌ای کودکان را می‌کشد."],[190,"همچو صاحب‌نفس کو تن پرورد","بر دگر کس ظن حقدی می‌برد","کسی که دارای نفس بزرگ و پاکی است و به خود را می‌پروراند، نسبت به دیگران با حسد و بدخواهی نگاه می‌کند."],[190,"کین عدو و آن حسود و دشمنست","خود حسود و دشمن او آن تنست","دشمن و حسود در واقع خود آن شخص است؛ خود او که حسادت و عداوت را در وجودش دارد، همانند یک جسم است که او را درگیر کرده است."],[190,"او چو فرعون و تنش موسی او","او به بیرون می‌دود که کو عدو","انسان همان‌طور که فرعون به‌دنبال موسی فرار می‌کند، باید از دشمنی که در درون خود دارد (نفس) فرار کند و آن را شناسایی کند. در واقع، این دشمن درونی است که باید از آن رهایی یابد."],[190,"نفسش اندر خانه تن نازنین","بر دگر کس دست می‌خاید به کین","نفس او در بدن نازنینش، به دیگران آسیب می‌زند و کینه و دشمنی می‌ورزد."],[191,"آن یکی از خشم، مادر را بکشت","هم به زخم خنجر و هم زخم مشت","شخصی به خاطر خشم، مادرش را به قتل رساند، هم با ضربه خنجر و هم با مشت زدن."],[191,"آن یکی گفتش که: از بدگوهری","یاد ناوردی تو حق مادری؟","شخصی به فردی می‌گوید که چرا به خاطر بدی و ناپاکی دیگران فراموش کرده‌ای حق مادری را رعایت کنی؟"],[191,"هی تو مادر را چرا کشتی؟ بگو","او چه کرد آخر بگو ای زشت‌خو؟","تو که مادر را کشتی، دلیلش چیست؟ بگو او چه کار کرده که می‌گویی حقش را از بین بردی، ای انسان زشت‌خو؟"],[191,"گفت: کاری کرد کان عار وی است","کشتمش کان خاک، ستّار وی است","او گفت: آن شخص کاری کرده که باعث عذاب و ننگ او شده، و به همین خاطر او را کشتم، زیرا این خاک یعنی بدن وی، پوشاننده عیوب اوست."],[191,"گفت: آن‌کس را بکش ای محتشم","گفت: پس هر روز مردی را کشم","او (شخصی) می‌گوید: کسی که در این عالم به این دلیل که عار (سرزنش) به او بچسبد کشته شود، باید آن قدر به کشتن مردم ادامه دهد که هر روز یک نفر را بکشد."],[191,"کشتم او را رستم از خون‌های خلق","نای او برّم به است از نای خلق","من، آن فرد را کشتم و رهایی یافتم از خون‌های مردم؛ صدای او (این فرد) سر و صدایش بهتر است از صدای مردم."],[191,"نفس توست آن مادر بدخاصیت","که فساد اوست در هر ناحیت","نفس تو همان مادر بدجنس و آسیب‌رسانی است که فسادش در هر جا گسترش یافته و تأثیر منفی می‌گذارد."],[191,"هین بکش او را که بهر آن دنی","هر دمی، قصد عزیزی می‌کنی","به او بگو که باید نفس خود را که سبب فساد و گمراهی‌ات است، بکش، زیرا به خاطر این دنیا هر لحظه با عزیزی دشمنی می‌کنی."],[191,"از وی این دنیای خوش بر توست تنگ","از پی او، با حق و با خلق، جنگ","دنیا به خاطر دوستی با او برای تو تنگ و محدود شده است و تو در این راه در حال جنگیدن با خدا و مردم هستی."],[191,"نفس کشتی باز رستی ز اعتذار","کس، تو را دشمن نماند در دیار","اگر نفس خود را بکشی و از عذرخواهی دیگران دست برداری، دیگر هیچ دشمنت در این دنیا نخواهد ماند."],[191,"گر شکال آرد کسی بر گفت ما","از برای انبیا و اولیا","اگر کسی به سخنان ما درباره پیامبران و اولیای خدا ایراد بگیرد و شکایت کند، نباید نگران باشیم."],[191,"کانبیا را نی که نفس کشته بود","پس چراشان دشمنان بود و حسود؟","اگر انبیا (پیامبران) نفس کشته بودند، پس چرا دشمنان و حسودان برای آن‌ها دشمنی می‌کردند؟"],[191,"گوش نه تو، ای طلب‌کار صواب","بشنو این اشکال و شبهت را جواب","ای کسی که دنبال حق و حقیقتی، به دقت گوش کن و این سؤال و شبهه را پاسخ بده."],[191,"دشمن خود بوده‌اند آن منکران","زخم، بر خود می‌زدند ایشان، چنان","این افراد انکارکننده، در واقع دشمن خودشان بوده‌اند و به خود آسیب می‌زنند، مانند کسی که زخم‌هایی به خود می‌زند."],[191,"دشمن، آن باشد که قصد جان کند","دشمن، آن نبود که خود، جان می‌کند","دشمن واقعی کسی است که به جان دیگران آسیب می‌زند، نه کسی که خودش به جان خود آسیب می‌زند."],[191,"نیست خفاشک، عدوی آفتاب","او، عدوی خویش آمد در حجاب","این بیت بیانگر این است که خفاش، دشمن روشنایی آفتاب است، اما در واقع، دشمنی او با آفتاب تنها به خود او برمی‌گردد و در واقع خود را در سایه و حجاب قرار داده است. به عبارت دیگر، کسی که علیه نور و روشنایی ایستاده، در حقیقت به خودش آسیب می‌زند."],[191,"تابش خورشید او را می‌کشد","رنج او، خورشید هرگز کی کشد؟","تابش خورشید، یعنی حقیقت و روشنایی، او را به الموت می‌کشاند و سبب رنج او می‌شود، اما آیا حقیقت و روشنایی به‌خودش کشنده است؟ یعنی خورشید هرگز نمی‌تواند کسی را بکشد."],[191,"دشمن، آن باشد کز او آید عذاب","مانع آید لعل را از آفتاب","دشمن کسی است که باعث درد و عذاب برای انسان می‌شود، و برعکس، کسی که مانع می‌شود که گوهر (حقیقت) از نور آفتاب (موعظه و هدایت) بهره‌مند شود."],[191,"مانع خویش‌اند جمله کافران","از شعاع جوهر پیغمبران","کافرانی که به درک و فهم حقایق نائل نمی‌شوند، خودشان مانع بهره‌مندی از نور و حقیقت وجود پیامبران هستند و باعث می‌شوند که دیگران نتوانند از این نور بهره‌مند شوند."],[191,"کی حجاب چشم آن فردند خلق؟","چشم خود را کور و کژ کردند خلق","مردم چگونه می‌توانند حجاب چشم آن شخص باشند؟ خودشان چشمانشان را کور و کج کرده‌اند."],[191,"چون غلام هندوی کو کین کشد","از ستیزه خواجه، خود را می‌کشد","چون غلام هندوستانی به خاطر دشمنی با خواجه دعوا و جنگ به راه می‌اندازد، در واقع خودش را هم به خطر می‌اندازد و نابود می‌کند."],[191,"سرنگون می‌افتد از بام سرا","تا زیانی کرده باشد خواجه را","شخصی که در صدد آزار دادن دیگران است، در نهایت خود به نابودی می‌افتد، مانند کسی که از بالای بام سقوط می‌کند، زیرا به خاطر عملی که علیه دیگران انجام داده به چنین سرنوشتی دچار می‌شود."],[191,"گر شود بیمار، دشمن با طبیب","ور کند کودک، عداوت با ادیب","اگر کسی بیمار شود، دشمن با پزشک می‌شود و اگر کودک باشد، با معلم دشمنی می‌کند."],[191,"در حقیقت، رهزن جان خودند","راه عقل و جان خود را خود زدند","در واقع، انسان‌ها خودشان با نادانی و رفتارهای نادرست، به جان و روح خود آسیب می‌زنند و راه درست را از دست می‌دهند."],[191,"گازری گر خشم گیرد ز آفتاب","ماهیی گر خشم می‌گیرد ز آب","اگر گرگ (گازور) از تابش آفتاب خشمگین شود، مانند ماهی نیز در آب اگر خشم بگیرد."],[191,"تو یکی بنگر که را دارد زیان","عاقبت کبود سیه‌اختر از آن؟","به تو گفته می‌شود که به سرنوشت کسانی که به دیگران آسیب می‌زنند، توجه کن؛ زیرا بدبختی و زیان نهایی برای آن‌ها خواهد بود و به مراتب بیشتر از کسی است که خود را درگیر این کار می‌کند."],[191,"گر تو را حق آفریند زشت‌رو","هان مشو هم زشت‌رو، هم زشت‌خو","اگر خداوند تو را به صورت زشت بیافریند، نباید هم زشت‌رو باشی و هم زشت‌خو؛ یعنی خلق نیکو نباید با اخلاق بد همراه باشد."],[191,"ور برد کفشت مرو در سنگلاخ","ور دو شاخه‌ستت مشو تو چار شاخ","اگر کسی کفش‌ات را بردارد، نباید در مسیر سنگلاخ و دشوار بروی و اگر دو راه داری، نباید به چهار راه تبدیلش کنی و خودت را در سختی قرار دهی."],[191,"تو، حسودی کز فلان، من، کم‌ترم","می‌فزاید کم‌تری در اخترم","تو حسادت می‌کنی به کسی، اما خودت کمتر از او هستی و این حسادت، باعث افزایش نقص و کمبودهای تو در زندگی‌ات می‌شود."],[191,"خود، حسد، نقصان و عیبی دیگر است","بلک از جمله کمی‌ها بتّر است","حسادت، یکی از نقص‌ها و عیب‌هاست، بلکه از جمله‌ی کمبودها و کمبودهایی که برتر از آن‌ها محسوب می‌شود."],[191,"آن بلیس از ننگ و عار کم‌تری","خویش را افکند در صد ابتری","ابلیس از شرم و زشتی عیوب کمتری که در خود دارد، خود را در صد عیب بزرگ‌تر انداخته و به آن عیوب بزرگ‌تری متهم می‌کند."],[191,"از حسد می‌خواست تا بالا بود","خود چه بالا بلک خون‌پالا بود","ابوجهل به خاطر حسدی که به پیامبر محمد (ص) داشت، می‌خواست خود را در مقام بالاتری قرار دهد، در حالی که او موجودی پست و خونی ناپاک است."],[191,"آن ابوجهل از محمّد ننگ داشت","وز حسد خود را به بالا می‌فراشت","ابوجهل از پیامبر محمد (ص) احساس ننگ می‌کرد و به خاطر حسدی که داشت، خود را بزرگ‌تر و برتر از او نشان می‌داد."],[191,"بوالحکم نامش بد و بوجهل شد","ای بسا اهل از حسد، نااهل شد","بوالحکم، که نامش بود، به ابوجهل معروف شد. بسیاری از مردم به خاطر حسد، خود را نااهل و نالایق نشان دادند."],[191,"من ندیدم در جهان جست‌وجو","هیچ اهلیّت، به از خوی نکو","در دنیای پر جست‌وجو، هیچ چیز ارزش‌مندتر از نیک‌خویی و داشتن صفات خوب نیست."],[191,"انبیا را واسطه زان کرد حق","تا پدید آید حسدها در قلق","خدایان برای آگاهی و توجه به انسان‌ها انبیا را به عنوان واسطه قرار داده‌اند تا حسادت‌ها و اضطراب‌ها در آنها به وجود آید."],[191,"زانک کس را از خدا عاری نبود","حاسد حق، هیچ دیّاری نبود","هیچ‌کس از خدا خالی نیست و کسی که حاسد است، هیچ مکانی برای پناهندگی ندارد."],[191,"آن کسی کش مثل خود پنداشتی","زان سبب با او، حسد برداشتی","تو کسی را که مانند خودت می‌پنداشتی، به همین دلیل به او حسادت کردی."],[191,"چون مقرّر شد بزرگی رسول","پس حسد ناید کسی را از قبول","وقتی که بزرگی و مقام پیامبر مشخص و ثابت شد، هیچ‌کس نمی‌تواند به خاطر حسد، او را از پذیرش درست و صحیح بازدارد."],[191,"پس به هر دوری، ولیی قائم است","تا قیامت، آزمایش، دائم است","در هر زمان، ولی و پیشوایی وجود دارد که می‌تواند درستی را هدایت کند و آزمایش و آزمون برای انسان‌ها ادامه دارد تا روز قیامت."],[191,"هر که را خوی نکو باشد برست","هرکسی کاو شیشه‌دل باشد شکست","هر کسی که شخصیت خوبی داشته باشد، در نهایت نجات پیدا می‌کند، اما کسی که دلش ظریف و حساس باشد، به آسانی دچار آسیب و شکست می‌شود."],[191,"پس امام حیّ قائم، آن ولی‌ست","خواه از نسل عمر خواه از علی‌ست","امام مهدی، که او را امام زنده و منتظر می‌دانند، ولی الهی است و ممکن است که از نسل عمر باشد یا علی."],[191,"مهدی و هادی، وی‌ست ای راه‌جو","هم نهان و هم نشسته، پیش رو","مهدی و هادی، همان کسی است که ای کسی که به دنبال راهنمایی هستی، او هم در دل‌های مردم پنهان است و هم در جلو چشم‌ها حضور دارد."],[191,"او چو نور است و خرد، جبریل اوست","وان ولی کم از او، قندیل اوست","او مانند نور و خرد است و به نوعی مظهر فرشتگی (جبریل) است و ولی (مردی با مقام معنوی و روحانی) که از او کمتر است، مانند قندیل (چراغ) او به شمار می‌آید."],[191,"وانک زین قندیل کم‌مشکات ماست","نور را در مرتبه، ترتیب‌هاست","نور حقیقت از این قندیل (نور معنوی) که در دست ماست، به تدریج و با مرتبه‌بندی خاصی قابل مشاهده است. این نشان می‌دهد که نور الهی در سطح‌های مختلفی تجلی می‌کند."],[191,"زانک هفصد پرده دارد نور حق","پرده‌های نور دان چندین طبق","نور حق دارای هفتصد پرده است، و همچنین پرده‌های نوری وجود دارد که هر کدام چندین لایه یا طبقه دارند."],[191,"از پس هر پرده، قومی را مقام","صف‌صف‌اند این پرده‌هاشان تا امام","مردم در پس هر پرده، در مقام‌های مختلفی قرار دارند و این پرده‌ها، که نشانه‌های نور الهی هستند، آن‌ها را تا دیدار با امام می‌پوشانند."],[191,"اهل صف آخرین از ضعف خویش","چشمشان طاقت ندارد نور بیش","آنان که در آخرین ردیف قرار دارند، به دلیل ناتوانی و ضعیف بودن خود نمی‌توانند نور بیشتری را تحمل کنند و در مقابلش تاب بیاورند."],[191,"وان صف پیش از ضعیفی بصر","تاب نارد روشنایی، بیش‌تر","صفّ پیش یعنی گروهی که در درجه‌های بالاتر از خود هستند، به خاطر ضعف چشم نمی‌توانند نور بیشتری را تحمل کنند و به آن نگاه کنند."],[191,"روشنایی کاو حیات اول است","رنج جان و فتنه این احول است","روشنایی که به حیات اولیه مربوط می‌شود، همان رنج و مشکلاتی است که در این دنیا تجربه می‌کنیم و به نوعی مایه فتنه و دردسر است."],[191,"احولی‌ها اندک‌اندک کم شود","چون ز هفصد بگذرد او یم شود","افراد با ویژگی‌های خاص و پیچیده (احوالی‌ها) به تدریج کاهش می‌یابند و زمانی که به هفتصد برسد، به طور کلی محو می‌شوند."],[191,"آتشی کاصلاح آهن یا زر است","کی صلاح آبی و سیب تر است؟","آتش، هم برای اصلاح و قالب‌گیری آهن و طلا استفاده می‌شود، اما آیا می‌تواند برای اصلاح آب و سیب تازه هم به کار رود؟ این بیت به تفاوت‌های طبیعی و کارکردی عناصر مختلف اشاره می‌کند."],[191,"سیب و آبی، خامیی دارد خفیف","نی چو آهن، تابشی خواهد لطیف","سیب و آب یک خصوصیت خفیف و نازک دارند و طبع‌شان خام است، برعکس آهن که خاصیتش درخشش و تابش لطیفی دارد."],[191,"لیک آهن را لطیف، آن شعله‌هاست","کو جذوب تابش آن اژدهاست","آهن زمانی که به حرارت می‌رسد و تحت تأثیر شعله‌ها قرار می‌گیرد، نرمی و لطافت پیدا می‌کند، و این حرارت به جذب نور و درخشش خاصی در آن مرتبط است که مانند درخشش یک اژدهای افسانه‌ای است."],[191,"هست آن آهن، فقیر سخت‌کش","زیر پتک و آتش است او سرخ و خوش","آهن در اینجا به معنای انسانی است که با سختی‌ها و مشکلات زندگی مواجه است. او تحت فشار و سختی (پتک و آتش) قرار دارد، اما با وجود این دشواری‌ها، همچنان مقاوم و خوشحال است."],[191,"حاجب آتش بود بی‌واسطه","در دل آتش رود بی‌رابطه","آتش حجاب ندارد و بدون واسطه وارد دل آتش می‌شود. این بیان کننده این است که حقیقت و جوهر هر چیز نمی‌تواند تحت تأثیر موانع و حجاب‌ها قرار گیرد و به راحتی به عمق وجود می‌رسد."],[191,"بی‌حجاب آب و فرزندان آب","پختگی ز آتش نیابند و خطاب","بی‌حجاب بودن آب یعنی بدون هیچ پوششی و پنهانی، آب و فرزندان آن نمی‌توانند از آتش پختگی و گرما تاثیر بپذیرند و مستقیما در معرض آن قرار نمی‌گیرند. در واقع، وقتی چیزی درمیان نیست، نمی‌تواند تحت تاثیر آن واقع شود."],[191,"واسطه دیگی بود یا تابه‌ای","همچو پا را در روش پاتابه‌ای","هیچ وسیله‌ای مانند دیگ یا تابه‌ای نیست که پا را در پیاله‌ای قرار دهد و به آن شکل در آن قرار گیرد. در اینجا این تعبیر به معنای این است که انسان‌ها باید با شرایطی که در آن قرار دارند، سازگار شوند و از آن بهره‌برداری کنند."],[191,"یا مکانی در میان تا آن هوا","می‌شود سوزان و می‌آرد بما","یا جایی وجود دارد که باعث می‌شود هوا گرم و سوزان شود و این گرما بر ما تأثیر می‌گذارد."],[191,"پس فقیر آنست کو بی واسطه‌ست","شعله‌ها را با وجودش رابطه‌ست","فقیر حقیقی کسی است که بدون واسطه و با وجودش ارتباطی مستقیم با شعله‌ها (نور و آتش) دارد، یعنی او به حقیقت و معنویت نزدیک است."],[191,"پس دل عالم ویست ایرا که تن","می‌رسد از واسطه این دل به فن","دل عالم کسی است که از طریق واسطه‌های موجود، به حقایق و فنون دست می‌یابد. در واقع، تن (بدن) نتیجه‌ای از دل است که از طریق آن به علم و دانایی می‌رسد."],[191,"دل نباشد تن چه داند گفت و گو","دل نجوید تن چه داند جست و جو","تن (بدن) نمی‌تواند به گفت‌وگو و مباحثه بپردازد؛ فقط دل (روح) است که می‌تواند فهم و درک کند. بدن نمی‌تواند در پی جست‌وجو باشد، این دل است که طالب حقیقت و معناست."],[191,"پس نظرگاه شعاع آن آهنست","پس نظرگاه خدا دل نه تنست","اگر بخواهیم نگاه کنیم، حقیقت و نور معنوی به مانند شعاعی است که از خداوند (کسی که خالق است) نشأت می‌گیرد و این نور تنها از طریق دل قابل درک است، نه از طریق جسم و تن."],[191,"بس مثال و شرح خواهد این کلام","لیک ترسم تا نلغزد وهم عام","این سخن مثال‌ها و توضیحات زیادی خواهد داشت، اما من می‌ترسم که این فکر عمومی دچار اشتباه شود."],[191,"تا نگردد نیکوی ما بدی","اینک گفتم هم نبد جز بی‌خودی","تا زمانی که نیکویی ما به بدی تبدیل نشود، الان می‌گویم که بدون خویشتن‌داری و خودنظارتی، چنین اتفاقی نخواهد افتاد."],[191,"پای کژ را کفش کژ بهتر بود","مر گدا را دستگه بر در بود","بهتر است که پاهای کج، از کفش‌های کج استفاده کنند، نه اینکه گدا به‌دلیل نداشتن امکانات، از درگاه دیگران درخواست کمک کند."],[192,"پادشاهی دو غلام ارزان خرید","با یکی زان دو سخن گفت و شنید","پادشاهی دو غلام را که به قیمت کم خرید، با یکی از آن دو صحبت کرد و حرف‌های او را شنید."],[192,"یافتش زیرک‌دل و شیرین جواب","از لب شکر چه زاید شکرآب","پادشاه، غلامی را باهوش و صحبت‌های شیرین یافت که از زبانش مانند شکر شیرینی می‌ریخت، اما از این زبان شیرین ممکن است چیزهای تلخی هم به وجود آید."],[192,"آدمی مخفیست در زیر زبان","این زبان پرده‌ست بر درگاه جان","انسان در زیر زبانش پنهان است و این زبان مانند پرده‌ای است که در را به روی روح و جان او می‌بندد."],[192,"چونک بادی پرده را در هم کشید","سرّ صحن خانه شد بر ما پدید","وقتی که بادی پرده را کنار زد، راز و حقایق درون خانه برای ما روشن شد."],[192,"کاندر آن خانه گهر یا گندمست","گنج زر یا جمله مار و کزدمست","در آن خانه ممکن است جواهر یا گندم باشد، یا اینکه فقط طلا و گنج‌های باارزش باشد، یا شاید هم پر از مار و خطراتی باشد که انسان را می‌نیشند."],[192,"یا درو گنجست و ماری بر کران","زانک نبود گنج زر بی پاسبان","در اینجا اشاره شده که خانه‌ای که به آن اشاره می‌شود یا پر از گنج‌های قیمتی است یا در آن مارهایی خطرناک وجود دارد، زیرا گنج‌های ارزشمند بدون نگهبان و پاسبانی در آنجا نیستند."],[192,"بی تامل او سخن گفتی چنان","کز پس پانصد تامل دیگران","او بدون هیچ تاملی صحبت کرد، مانند کسی که از پس پانصد تامل و فکر دیگران سخن می‌گوید."],[192,"گفتیی در باطنش دریاستی","جمله دریا گوهر گویاستی","تو در باطن خود مانند دریا هستی و تمام دریاها، گوهر وجود توست."],[192,"نور هر گوهر کزو تابان شدی","حق و باطل را ازو فرقان شدی","نور هر گوهر که از آن تابنده است، حق و باطل را از یکدیگر جدا کرده است."],[192,"نور فرقان فرق کردی بهر ما","ذره ذره حق و باطل را جدا","نور فرقان (تمایز و تشخیص) را به ما عطا کردی تا به‌طور جزئی و دقیق حق را از باطل جدا کنیم."],[192,"نور گوهر نور چشم ما شدی","هم سؤال و هم جواب از ما بدی","نور حقیقی که به واسطه فهم و بصیرت به ما رسیده، هم برای ما سؤال ایجاد کرده و هم پاسخ‌هایی از جانب ما به آن سوالات داده است."],[192,"چشم کژ کردی دو دیدی قرص ماه","چون سؤالست این نظر در اشتباه","اگر چشمانت را به درستی نگردانی، دو ماه را خواهی دید؛ چرا که این نگاه به ماه به مانند سوالی است که در اشتباه می‌کنی."],[192,"راست گردان چشم را در ماهتاب","تا یکی بینی تو مه را نک جواب","چشم‌ات را درست کن تا به درستی ماه را ببینی، وگرنه از دیدن واقعیت ماه، درست درک نخواهی کرد."],[192,"فکرتت گو، کژ مبین نیکو نگر","هست هم نور و شعاع آن گهر","فکرت و اندیشه‌ات را درست و صحیح به کار بگیر، زیرا که درخشش و روشنایی آن گوهر (حقیقت) همواره موجود است."],[192,"هر جوابی کان ز گوش آید بدل","چشم گفت از من شنو آن را بهل","هر جوابی که از گوش می‌شنوی، به خاطر روشنی چشم نیست، بلکه از طرف دل می‌گوید. پس آن را رها کن و به حقیقت آن توجه نکن."],[192,"گوش دلاله‌ست و چشم اهل وصال","چشم صاحب حال و گوش اصحاب قال","گوش نشانه‌ای است برای درک و دریافت سخنان و مطالبی که به ما منتقل می‌شود، در حالی که چشم مخصوص افرادی است که به حقیقت و وصال (وصل به حق یا معشوق) رسیده‌اند. چشم، متعلق به کسانی است که در حال و مقام بالایی قرار دارند و گوش، متعلق به افرادی است که فقط به گفتار و نظرات (اقوال) دیگران گوش می‌دهند."],[192,"در شنود گوش تبدیل صفات","در عیان دیده‌ها تبدیل ذات","تنها شنیدن و گوش دادن به سخنان دیگران باعث تغییر صفات و ویژگی‌ها نمی‌شود؛ بلکه دیدن و درک واقعی باعث تغییر اساسی در ذات و ماهیت افراد خواهد شد."],[192,"ز آتش ار علمت یقین شد از سخن","پختگی جو در یقین منزل مکن","اگر علم و دانش تو از آتش به یقین رسیده باشد، نباید به صرف گفتار و بیانات پخته اکتفا کنی و در این یقین ساکن بمانی."],[192,"تا نسوزی نیست آن عین الیقین","این یقین خواهی در آتش در نشین","وقتی که به یقین واقعی نرسیده‌ای و دچار تردید و نادانی هستی، نمی‌توانی به ورای آن حقیقت دست یابی؛ بنابراین، برای رسیدن به یقین واقعی باید از آزمایش‌ها و سختی‌ها عبور کنی."],[192,"گوش چون نافذ بود دیده شود","ورنه قل در گوش پیچیده شود","اگر گوش انسان توانایی درک حقایق را داشته باشد، چشمی برای بینایی و مشاهده آن حقایق وجود دارد؛ وگرنه، تنها زوزه‌ای در گوش خواهد ماند که چیزی را متوجه نخواهد شد."],[192,"این سخن پایان ندارد باز گرد","تا که شه با آن غلامانش چه کرد","این داستان همچنان ادامه دارد، پس برگرد و ببین که پادشاه با آن دو غلامش چه کرد."],[193,"آن غلامک را چو دید اهل ذکا","آن دگر را کرد اشارت که بیا","وقتی اهل دانش آن غلام کوچک را دیدند، به غلام دیگر اشاره کردند که نزد آن‌ها بیاید."],[193,"کاف رحمت گفتمش تصغیر نیست","جد گود فرزندکم تحقیر نیست","به او گفتم که خداوند رحمت است و این‌جا صحبت از کوچک‌سازی و تحقیر فرزندان نیست، زیرا فرزند من که به تنهایی در این مقام قرار می‌گیرد، در حقیقت مورد احترام و ارزش است."],[193,"چون بیامد آن دوم در پیش شاه","بود او گنده‌دهان دندان سیاه","آن دو غلام در برابر شاه ایستاده بودند و در این میان، یکی از آن‌ها که دندان‌های سیاه و دهانی بزرگ داشت، به سمت شاه آمد."],[193,"گرچه شه ناخوش شد از گفتار او","جست و جویی کرد هم ز اسرار او","اگرچه شاه از سخنان آن فرد ناراحت شد، اما از روی کنجکاوی به دنبال حقایق و رازهای او رفت."],[193,"گفت با این شکل و این گند دهان","دور بنشین لیک آن سوتر مران","با این وضع و ظاهر نامناسب و بوی بد دهان، دور از من بنشین، اما بیشتر از این به آن سو نرو."],[193,"که تو اهل نامه و رقعه بدی","نه جلیس و یار و هم‌بقعه بدی","تو شخصی هستی که اهل نوشتن و نامه‌نگاری هستی و در واقع، نمی‌توانی دوست و همراه مناسبی برای من باشی."],[193,"تا علاج آن دهان تو کنیم","تو حبیب و ما طبیب پر فنیم","برای درمان و اصلاح کلام و رفتار تو، ما به عنوان دوستانی مهرورز و دلسوز در مقام پزشک و درمانگر عمل می‌کنیم."],[193,"بهر کیکی نو گلیمی سوختن","نیست لایق از تو دیده دوختن","برای دیدن و شناختن زیبایی و چیزهای خوب، هرگز مناسب نیست که برای یک کیک (یا شیرینی) که تازه‌دار می‌آید، چشمانت را بسوزانی و به چیزهای خوب وتازه برسی. این بر ذوق و خلاقیت تو نمی‌افزاید."],[193,"با همه بنشین دو سه دستان بگو","تا ببینم صورت عقلت نکو","حالا که با هم نشسته‌اید، دو یا سه داستان بگویید تا ببینم چقدر عقل و فهم شما خوب و زیباست."],[193,"آن ذکی را پس فرستاد او به کار","سوی حمامی که رو خود را بخار","او (شاه) پس از فرستادن آن فرد باهوش به سمت کار، او را به حمام فرستاد تا با بخار آنجا خود را بشوید و آماده کند."],[193,"وین دگر را گفت خه تو زیرکی","صد غلامی در حقیقت نه یکی","مولانا به شخصی می‌گوید که تو خود را با زیرکی می‌شناسی و فکر می‌کنی که هوش و ذکاوتت مانند یک صد غلام است، در حالی که در واقع تنها یک شخص هستی و این تصور تو از زیرکی، توهّم است."],[193,"آن نه‌ای که خواجه‌تاش تو نمود","از تو ما را سرد می‌کرد آن حسود","شخصی که تو را به خواجه‌تاش، یعنی غلام و خدمتکار، نشان داد، در واقع حسود است و این حسد باعث می‌شود که از تو فاصله بگیریم و سردی احساسی بین ما به وجود آید."],[193,"گفت او دزد و کژست و کژنشین","حیز و نامرد و چنینست و چنین","او درباره‌ی شخصی که در نظرش دزد و فاسد و بدکار است، می‌گوید که این فرد بی‌صداقت و نامرد می‌باشد و ویژگی‌های زشت بسیاری دارد."],[193,"گفت پیوسته بدست او راست‌گو","راست‌گویی من ندیدستم چو او","این بیت به تعریف شخصی پرداخته که همیشه همراه اوست و به راستی سخن می‌گوید. گوینده می‌گوید که هیچ راست‌گویی همچون او را ندیده است و بنابراین مورد احترام و اعتناست."],[193,"راست‌گویی در نهادش خلقتیست","هرچه گوید من نگویم آن تهیست","راست‌گویی جزو ذات و سرشت اوست، هرچه او بگوید، من نمی‌توانم با آن مخالفت کنم، زیرا سخن و گفتار او خالی از حقیقت نیست."],[193,"کژ ندانم آن نکواندیش را","متهم دارم وجود خویش را","من نمی‌دانم آن شخص دارای اندیشه‌ی نیک را به چه دلیل متهم می‌کنم و این نشان‌دهنده‌ی نقص وجود خودم است."],[193,"باشد او در من ببیند عیبها","من نبینم در وجود خود شها","شاید او (شخص مورد نظر) در وجود من عیب‌ها را ببیند، اما من هیچ عیبی در خودم نمی‌بینم، ای شاه."],[193,"هر کسی گر عیب خود دیدی ز پیش","کی بدی فارغ وی از اصلاح خویش","اگر هر کسی عیب خود را پیش از دیگران ببیند، به این معناست که او از اصلاح کردن خود غافل است و نمی‌تواند به عیب‌های خود رسیدگی کند."],[193,"غافل‌اند این خلق از خود ای پدر","لاجرم گویند عیب همدگر","این مردم از عیب‌های خود غافل‌اند، به همین دلیل به عیب‌جویی از یکدیگر می‌پردازند."],[193,"من نبینم روی خود را ای شمن","من ببینم روی تو تو روی من","من نمی‌توانم روی خود را ببینم، ای محبوب، اما تو را می‌بینم و در واقع روی من، در حقیقت، همان روی توست."],[193,"آنکسی که او ببیند روی خویش","نور او از نور خلقانست بیش","آن کسی که فقط خود را ببیند، نورش بیشتر از نور دیگران است، زیرا او در حقیقت از نور و حقیقت خود سرچشمه می‌گیرد."],[193,"گر بمیرد دید او باقی بود","زانک دیدش دید خلاقی بود","اگر کسی بمیرد، دید او از بین نمی‌رود، زیرا این دید از ذات خالق برمی‌خیزد و پایدار می‌ماند."],[193,"نور حسی نبود آن نوری که او","روی خود محسوس بیند پیش رو","این نور، نور حسی نیست؛ بلکه نوری است که او بر روی خود می‌بیند و این نور به صورت محسوس و جسمانی در برابر او قرار ندارد."],[193,"گفت اکنون عیبهای او بگو","آنچنان که گفت او از عیب تو","گفت حالا عیب‌های او را بگو، مانند چیزی که خود او از عیب‌های تو گفته است."],[193,"تا بدانم که تو غمخوار منی","کدخدای ملکت و کار منی","من می‌خواهم بفهمم که آیا تو نسبت به من دلسوزی و توجه داری، ای کدخدای حکومت و سرپرست امور من."],[193,"گفت ای شه من بگویم عیبهاش","گرچه هست او مر مرا خوش خواجه‌تاش","گفت: ای پادشاه، من عیب‌های او را می‌گویم، هرچند که او برای من نیکو و عزیز است."],[193,"عیب او مهر و وفا و مردمی","عیب او صدق و ذکا و همدمی","عیب آن شخص، محبت، وفاداری و شرافت اوست. همچنین، صداقت، زیرکی و رفاقت او نیز از نقاط ضعف او به شمار می‌آید."],[193,"کمترین عیبش جوامردی و داد","آن جوامردی که جان را هم بداد","کمترین عیب او جوانمردی و انصاف است، و جوانمردی او به حدی است که جان خود را هم برای دیگران فدا می‌کند."],[193,"صد هزاران جان خدا کرده پدید","چه جوامردی بود کان را ندید","خداوند صد هزاران جان پدید آورده است، اما چه فایده از این جوانمردی اگر کسی نتواند او را ببیند و درک کند؟"],[193,"ور بدیدی کی به جان بخلش بدی؟","بهر یک جان کی چنین غمگین شدی؟","اگر می‌دیدی که به خاطر بخل او جانش را تباه کردی، آیا به خاطر یک جان تا این حد غمگین می‌شدی؟"],[193,"بر لب جو بخل آب آن را بود","کو ز جوی آب نابینا بود","آب بخل به مانند آبی است که در لب جوی قرار دارد، اما آن آب ناپیدا و ناشناخته است، به طوری که مثل یک نابینا کسی نمی‌تواند آن را ببیند."],[193,"گفت پیغامبر که هر که از یقین","داند او پاداش خود در یوم دین","پیامبر گفت که هر کس به یقین و ایمان برسد، در روز جزا پاداش خود را خواهد گرفت."],[193,"که یکی را ده عوض می‌آیدش","هر زمان جودی دگرگون زایدش","هر زمان که شخصی به سبب جود و بخشندگی‌اش، نعمت و پاداشی دریافت می‌کند، شایستگی او برای دریافت بیشتر نعمت‌ها به طور مداوم افزایش می‌یابد."],[193,"جود جمله از عوضها دیدنست","پس عوض دیدن ضد ترسیدنست","سخاوت و generosity تنها با مشاهده‌ی پاداش‌ها و جایگزین‌های آن معنا پیدا می‌کند، بنابراین اگر کسی پاداش‌ها را ببیند، دیگر نباید از دست دادن آن‌ها بترسد."],[193,"بخل نادیدن بود اعواض را","شاد دارد دید در خواض را","بخل به معنی نداشتن نعمت‌ها و غفلت از آن‌هاست، زیرا کسی که بخل دارد، در واقع خوشحال است که از نعمت‌های دیگران بی‌خبر است و تنها به غم و درد خود می‌پردازد."],[193,"پس بعالم هیچ کس نبود بخیل","زانک کس چیزی نبازد بی بدیل","هیچ‌کس در این عالم بخل ورزی نمی‌کند، چون کسی چیزی را از دست نمی‌دهد که برایش بی‌بدیل باشد."],[193,"پس سخا از چشم آمد نه ز دست","دید دارد کار جز بینا نرست","سخاوت و بخشندگی از دید دل و حقیقت انسان است، نه از عمل و کارهایی که با دست انجام می‌شود؛ تنها کسی که بصیرت و بینش دارد می‌تواند به این ویژگی دست یابد."],[193,"عیب دیگر این که خودبین نیست او","هست او در هستی خود عیب‌جو","عیب دیگر این است که او خود را نمی‌بیند، در حالی که در حقیقت خود او هم عیب‌جو است و به عیب‌های خود آگاه نیست."],[193,"عیب‌گوی و عیب‌جوی خود بدست","با همه نیکو و با خود بد بدست","انسانی که عیب دیگران را می‌بیند و به دنبال عیب‌جویی از آنهاست، در واقع خود را نیز تحت تأثیر قرار می‌دهد و به بدی‌های خودش پی می‌برد، و در این حالت، حتی در میان خوبی‌های دیگران نیز، نواقص خود را می‌یابد."],[193,"گفت شه جلدی مکن در مدح یار","مدح خود در ضمن مدح او میار","سلطانی گفت که در ستایش یار، شتاب کامل نکن و همچنین ستایش خود را به بهانه‌ی ستایش او مطرح نکن."],[193,"زانک من در امتحان آرم ورا","شرمساری آیدت در ماورا","زیرا من او را در امتحان قرار می‌دهم و اگر او در این آزمایش بد عمل کند، شرمنده خواهد شد و عواقب آن تا دورتر از اینجا به او بازخواهد گشت."],[194,"گفت نه والله بالله العظیم","مالک الملک و به رحمان و رحیم","مولانا در این بیت به قسم یاد می‌کند و می‌گوید که به خداوند بزرگترین قسم می‌خورد که مالک همه‌ی چیزهاست و رحمت و مهربانی‌اش شامل حال همه می‌شود."],[194,"آن خدایی که فرستاد انبیا","نه بحاجت بل بفضل و کبریا","خدای عزیزی که پیامبران را فرستاد، این کار را نه برای نیاز به آنها، بلکه به خاطر فضل و بزرگواری خودش انجام داد."],[194,"آن خداوندی که از خاک ذلیل","آفرید او شهسواران جلیل","خدای بزرگ، کسانی را که از خاک پستی و ذلت خلق کرده، به درجات والای انسانی و شهامت برساند."],[194,"پاکشان کرد از مزاج خاکیان","بگذرانید از تک افلاکیان","او (خداوند) افراد پاک را از ناپاکی‌های موجود در طبیعت انسانی خود پاک می‌کند و آنها را از مراتب پایین‌تری که در آسمان‌ها وجود دارد، عبور می‌دهد."],[194,"بر گرفت از نار و نور صاف ساخت","وانگه او بر جمله انوار تاخت","خداوند از آتش و نور، روح را پاک و خالص کرد و سپس آن روح را به سوی همه نورها و ارواح دیگر فرستاد."],[194,"آن سنابرقی که بر ارواح تافت","تا که آدم معرفت زان نور یافت","نور سنابرقی (که به معنای نور شفاف و درخشان است) بر ارواح تابید، تا آدم با آن نور، معرفت و آگاهی پیدا کند."],[194,"آن کز آدم رست و دست شیث چید","پس خلیفه‌ش کرد آدم کان بدید","این بیت به ذکر این موضوع می‌پردازد که چیزی که از وجود آدم خارج شده و به دست شیث (پسر آدم) سپرده شده، باعث شد که آدم خلیفه‌ خداوند شود و به مقام بزرگی دست یابد. این اشاره به ادامه‌ نسل آدم و مقام‌های معنوی او دارد."],[194,"نوح از آن گوهر که برخوردار بود","در هوای بحر جان دربار بود","نوح به خاطر جواهر گران‌بهایی که در اختیار داشت، به مقام و قدرتی بزرگ در زندگی خود رسیده بود و در این دریای جان، مورد احترام و تقدیر قرار داشت."],[194,"جان ابراهیم از آن انوار زفت","بی حذر در شعله‌های نار رفت","ابراهیم (پیامبر) با شجاعت و بی‌هراس از آتش، به سوی نورهای درخشان و قدرت‌های الهی حرکت کرد، حتی اگر این مسیر او را به آتش تبدیل کند."],[194,"چونک اسمعیل در جویش فتاد","پیش دشنه آبدارش سر نهاد","چون اسماعیل در قنات (جوی آب) افتاد، در برابر دشنه تیز و آبدار (که برای قربانی کردن او آمده) سرش را تسلیم کرد."],[194,"جان داوود از شعاعش گرم شد","آهن اندر دست‌بافش نرم شد","گرمای جان داوود به دلیل تابش شعاع او (سلیمان) زیاد شد و در نتیجه، آهن در دست بافنده نرم و قابل شکل‌پذیری شد."],[194,"چون سلیمان بد وصالش را رضیع","دیو گشتش بنده فرمان و مطیع","سلیمان، پیامبر و پادشاه، به خاطر محبت و رابطه‌اش با وصالش (دوست یا محبوبش) به اندازه‌ای قدرت و سلطه پیدا کرد که حتی دیوها (موجودات شرور و بد) هم به او بنده و فرمان‌بر شدند."],[194,"در قضا یعقوب چون بنهاد سر","چشم روشن کرد از بوی پسر","وقتی یعقوب در قضا و سرنوشت، سر را بر زمین نهاد، به خاطر بوی پسرش، چشمانش روشن و بینا شد."],[194,"یوسف مه‌رو چو دید آن آفتاب","شد چنان بیدار در تعبیر خواب","یوسف با زیبایی‌اش، وقتی آفتاب (پدرش یعقوب) را دید، آن‌قدر مشغول تعبیر خوابش شد که کاملا در حال بیداری و هوشیاری قرار گرفت."],[194,"چون عصا از دست موسی آب خورد","ملکت فرعون را یک لقمه کرد","زمانی که عصای موسی در آب فرو رفت، سلطنت فرعون به آسانی به خود بلعید و نابود شد."],[194,"نردبانش عیسی مریم چو یافت","بر فراز گنبد چارم شتافت","عیسای مسیح، وقتی نردبان را در دست مریم دید، با شتاب به بالای گنبد چهارم رفت."],[194,"چون محمد یافت آن ملک و نعیم","قرص مه را کرد او در دم دو نیم","وقتی محمد (پیامبر اسلام) ملک (قدرت و حاکمیت) و نعمت را پیدا کرد، مانند ماه که به دو نیم تقسیم می‌شود، آن قدرت را در یک لحظه دید و به دست آورد."],[194,"چون ابوبکر آیت توفیق شد","با چنان شه صاحب و صدیق شد","وقتی ابوبکر، که یکی از نزدیک‌ترین یاران محمد است، به مقام توفیق و موفقیت رسید، به واسطه‌ی آن پیامبر بزرگ، او نیز به شخصیت والایی دست یافت و به عنوان شخصی صدیق (راستین و وفادار) شناخته شد."],[194,"چون عمر شیدای آن معشوق شد","حق و باطل را چو دل فاروق شد","زمانی که عمر (یکی از صحابه پیامبر)، به شدت شیدای آن معشوق (پیامبر اسلام) شد، قدرت تمییز بین حق و باطل را به دست آورد و به مانند دل، تفاوت‌ها را تشخیص داد."],[194,"چونک عثمان آن عیان را عین گشت","نور فایض بود و ذی النورین گشت","چون عثمان (عثمان بن عفان، یکی از خلفای راشدین و شخصیت‌های مهم اسلامی) آن حقیقت نمایان شد و به عینیّت درآمد، نور الهی در او جاری شد و او به صفت «ذی النورین» (دارای دو نور، اشاره به ازدواج با دو دختر پیامبر) نائل گردید."],[194,"چون ز رویش مرتضی شد درفشان","گشت او شیر خدا در مرج جان","چون مرتضی (علی) از چهره‌اش نور افشانی کرد، او مانند شیر خدا در میدان جان نمایان شد."],[194,"چون جنید از جند او دید آن مدد","خود مقاماتش فزون شد از عدد","زمانی که جنید، یکی از عرفا و زاهدان بزرگ، از یاران او (مرتضی) آن کمک و یاری را مشاهده کرد، مقام و مرتبه‌اش بسیار بیشتر و والاتر از عدد و شمار اعداد گردید."],[194,"بایزید اندر مزیدش راه دید","نام قطب العارفین از حق شنید","بایزید بسطامی، که از عارفان بزرگ است، در حالتی که در مسیر عرفان پیشرفت کرده بود، نام «قطب العارفین» (نقطه کانونی عرفا) را از خدا شنید."],[194,"چونک کرخی کرخ او را شد حرس","شد خلیفه عشق و ربانی نفس","زمانی بایزید در حال تضرع و دعا بود و آن حالت او باعث شد که به مقام والای خلیفه‌ی عشق دست یابد و به تعبیر دیگر، روح او به مقام ربانی و معنوی نزدیک شود."],[194,"پور ادهم مرکب آن سو راند شاد","گشت او سلطان سلطانان داد","پور ادهم، پسر ادهم، با شوق و خوشحالی به آن سوی رفت و احساس شادی او بیشتر شد، زیرا او مانند سلطان سلطان‌ها، مقام و عظمت پیدا کرد."],[194,"وان شقیق از شق آن راه شگرف","گشت او خورشید رای و تیز طرف","شقیق به دلیل عبور از آن راه عمیق و دشوار، مانند خورشید درخشان و باهوش شد و توانایی‌های او افزایش یافت."],[194,"صد هزاران پادشاهان نهان","سر فرازانند زان سوی جهان","صدها هزار پادشاه در آن‌سوی جهان وجود دارند که در خفا و به دور از دید مردم قرار دارند."],[194,"نامشان از رشک حق پنهان بماند","هر گدایی نامشان را بر نخواند","نام این پادشاهان به خاطر رشک و حسادت حق، پنهان خواهد ماند و حتی گدایان نیز نام آنها را نخواهند دانست."],[194,"حق آن نور و حق نورانیان","کاندر آن بحرند همچون ماهیان","خداوند همان نور و روشنایی است و درستکاران نیز مانند ماهیانی هستند که در این دریا غوطه‌ورند."],[194,"بحر جان و جان بحر ار گویمش","نیست لایق نام نو می‌جویمش","اگر بگویم که «بحر جان» و «جان بحر» وجود دارند، مناسب این نام‌های بزرگ نیستند؛ بنابراین به دنبال نامی نو و برازنده‌تر برای آن‌ها می‌گردم."],[194,"حق آن آنی که این و آن ازوست","مغزها نسبت بدو باشند پوست","حقیقت همان چیزی است که هم «این» و هم «آن» از آن نشأت می‌گیرند، همچنان‌که در درخت، مغز (میوه) و پوست دارای نسبت‌هایی با یکدیگرند."],[194,"که صفات خواجه‌تاش و یار من","هست صد چندان که این گفتار من","صفات محبوب من، یعنی خواجه‌تاش، به اندازه‌ای زیاد و برتر از آن است که من بتوانم به طور کامل درباره‌اش صحبت کنم."],[194,"آنچ می‌دانم ز وصف آن ندیم","باورت ناید چه گویم ای کریم","من از ویژگی‌ها و صفات آن دوست (ندیم) چیزهایی می‌دانم که تو نمی‌توانی به آن‌ها ایمان بیاوری، ای بخشنده و نیکوکار."],[194,"شاه گفت اکنون از آن خود بگو","چند گویی آن این و آن او","شاه از من می‌خواهد بگویم که چه چیزی به من تعلق دارد و از من می‌خواهد که به جای حرف زدن درباره آنچه دیگران دارند، درباره خودم صحبت کنم."],[194,"تو چه داری و چه حاصل کرده‌ای","از تک دریا چه در آورده‌ای","تو چه چیز داری و چه دستاوردی به‌دست آورده‌ای، از این دریا که اشاره به علم و معرفت دارد، چه گوهرهای قیمتی خارج کرده‌ای؟"],[194,"روز مرگ این حس تو باطل شود","نور جان داری که یار دل شود","در روز مرگ، حس و احساسات دنیوی از بین می‌روند، اما تو جان پاکی داری که می‌تواند با محبوب واقعی‌ات پیوند داشته باشد."],[194,"در لحد کین چشم را خاک آگند","هست آنچ گور را روشن کند","در روز قیامت، این چشم‌ها که به خاطر گناهان به خاک کشیده شده‌اند، همان چیزی خواهند بود که گور را روشن می‌کند."],[194,"آن زمان که دست و پایت بر درد","پر و بالت هست تا جان بر پرد","در زمانی که دستان و پاهایت را درد و رنج فراگرفته و تو همچنان زنده‌ای، باید روح و جانت را پیش از جدایی از این بدن حفظ کنی."],[194,"آن زمان کین جان حیوانی نماند","جان باقی بایدت بر جا نشاند","زمانی که جان حیوانی دیگر باقی نمی‌ماند، باید جان حقیقی و باقی‌ات را بر جای بگذاری و به آن توجه کنی."],[194,"شرط من جا بالحسن نه کردنست","این حسن را سوی حضرت بردنست","شرط من برای داشتن زیبایی این است که این زیبایی را به سوی حضرت (خدا) ببرم و تنها زیبایی ظاهری (دنیا) کافی نیست."],[194,"جوهری داری ز انسان یا خری","این عرضها که فنا شد چون بری","انسان دارای جوهر و ذات ارزشمندی است، اما این ظواهر و اعمالی که به نظر مهم می‌آیند، وقتی که عمرشان به پایان برسد، دیگر ارزشی نخواهند داشت."],[194,"این عرضهای نماز و روزه را","چونک لایبقی زمانین انتفی","نماز و روزه و دیگر اعمال ظاهری، زمانی ارزش دارند که انسان به جوهر و ذات خود توجه کند، زیرا این اعمال در نهایت نابود می‌شوند و فقط جوهر حقیقت باقی می‌ماند."],[194,"نقل نتوان کرد مر اعراض را","لیک از جوهر برند امراض را","نمی‌توان از ویژگی‌های ظاهری و سطحی سخن گفت، بلکه این جوهر و باطن است که بیماری‌ها را نشان می‌دهد."],[194,"تا مبدل گشت جوهر زین عرض","چون ز پرهیزی که زایل شد مرض","هرگاه جوهر (ماهیت اصلی) از عوارض (صفات ظاهری و موقتی) پاک و خالص شد، به خاطر پرهیزی که باعث از بین رفتن بیماری (نقص) می‌شود، آن جوهر دگرگون می‌گردد."],[194,"گشت پرهیز عرض جوهر بجهد","شد دهان تلخ از پرهیز شهد","وقتی که جوهر و ذات حقیقی انسان به صفات و ویژگی‌های ظاهری و زودگذر مبدل شود، مانند این می‌ماند که کسی از خوردن شهد (عسل) پرهیز کند و به همین سبب دهانش تلخ می‌شود."],[194,"از زراعت خاکها شد سنبله","داروی مو کرد مو را سلسله","از زراعت زمین سنبله (محصول) به دست آمد و این سنبله، دارویی برای مو شد و به وسیله آن موها را به هم پیوند می‌زند."],[194,"آن نکاح زن عرض بد شد فنا","جوهر فرزند حاصل شد ز ما","این بیت می‌گوید که در عقد و ازدواج زن، ارزش و مقام آن دستخوش تغییر و نابودی می‌شود، اما فرزندی که به وجود می‌آید، نتیجه‌ای از وجود ماست و نشان‌دهنده استمرار زندگی و وجود ما است."],[194,"جفت کردن اسپ و اشتر را عرض","جوهر کره بزاییدن غرض","جفت کردن اسب و الاغ برای تولید یک فرزند (کره) که هدف آن به دست آوردن یک نژاد خاص است، نشان‌دهنده عدم توجه به ارزش واقعی و ذات این کار است."],[194,"هست آن بستان نشاندن هم عرض","کشت جوهر گشت بستان نک غرض","زرع کردن در بستان، هم‌تراز کاشتن چیزهای باارزش است؛ در واقع، هدف از این بستان یا کشت، به دست آوردن چیزهایی با ارزش‌تر و ناب‌تر است."],[194,"هم عرض دان کیمیا بردن به کار","جوهری زان کیمیا گر شد بیار","این بیت به این معناست که مانند کیمیا، اگر چیزی به ارزش و صفای واقعی مسئولانه و با دقت به کار گرفته شود، به نتیجه‌ای خوب و ارزشمند خواهد انجامید. در حقیقت، کیمیاگر (کسی که این کار را انجام می‌دهد) باید با صداقت و وفاداری دست به کار شود تا بتواند از آن چیز، فایده‌ای بزرگ حاصل کند."],[194,"صیقلی کردن عرض باشد شها","زین عرض جوهر همی‌زاید صفا","صیقل دادن سطح (عرض) باعث می‌شود که جوهر از آن به وجود آید و صفا و پاکی ایجاد کند."],[194,"پس مگو که من عملها کرده‌ام","دخل آن اعراض را بنما مرم","پس به زبان نیاور که من کارهای زیادی انجام داده‌ام، بلکه نتیجه و اثر آن اعمال را نشان بده."],[194,"این صفت کردن عرض باشد خمش","سایه بز را پی قربان مکش","شخصی که در رفتار و کردار خود صفتی را به دیگران نسبت می‌دهد، باید از ستم و ناراستی بری باشد، همان‌طور که سایه بز را برای قربانی کردن نباید به ناحق و به غفلت ناپایدار کرد."],[194,"گفت شاها بی قنوط عقل نیست","گر تو فرمایی عرض را نقل نیست","پادشاه می‌گوید: عقل هیچ امیدی به ناامیدی ندارد، اگر تو دستور بدهی، هیچ مانعی برای ارائه درخواست نیست."],[194,"پادشاها جز که یاس بنده نیست","گر عرض کان رفت باز آینده نیست","ای پادشاه، جز ناامیدی از بنده چیز دیگری وجود ندارد، زیرا اگر آنچه را که گفته شد (عرض) بپذیریم، امیدی به آینده وجود نخواهد داشت."],[194,"گر نبودی مر عرض را نقل و حشر","فعل بودی باطل و اقوال فشر","اگر این درخواست‌ها و صحبت‌های ما درباره حقیقت وجود نداشت، فعل و کارهایی که انجام می‌دهیم، بی‌معنا و پوچ می‌بود و سخن‌ها قوی نمی‌شدند."],[194,"این عرضها نقل شد لونی دگر","حشر هر فانی بود کونی دگر","این گفته‌ها به زبان دیگری بیان شد که در آن، به هر دلیل و مشکلی که پیش می‌آید، نوعی دیگر از وجود آن (حشر) در ارتباط با همه چیز وجود دارد و هر چیزی که فناپذیر باشد، وجودی متفاوت و تازه را به خود می‌گیرد."],[194,"نقل هر چیزی بود هم لایقش","لایق گله بود هم سایقش","هر چیزی که به دیگران منتقل می‌شود، باید با آن متناسب باشد؛ یعنی آن چیز باید شایسته و مناسب خود باشد و در مورد گله نیز باید چیزی گفته شود که هم با آن سازگار باشد و هم راه‌نما و هدایت‌کننده باشد."],[194,"وقت محشر هر عرض را صورتیست","صورت هر یک عرض را نوبتیست","در روز قیامت، هر چیزی یک شکل و صورت خاصی دارد و برای هر کدام از آن اشکال، یک نوبت و زمان مشخص وجود دارد تا به آن‌ها رسیدگی شود."],[194,"بنگر اندر خود نه تو بودی عرض","جنبش جفتی و جفتی با غرض","به درون خود نگاهی بینداز، تو تنها یک مظهر (عرض) هستی که حرکت و جنبش‌ات بر اساس اتصال به دیگری (جفت) و هدف خاصی (غرض) است."],[194,"بنگر اندر خانه و کاشانه‌ها","در مهندس بود چون افسانه‌ها","به خانه‌ها و مکان‌هایی که نگاه می‌کنی، توجه کن؛ مهارت و مهندسی کار در آنها مانند داستان‌ها و افسانه‌ها است."],[194,"آن فلان خانه که ما دیدیم خوش","بود موزون صفه و سقف و درش","خانه‌ای که ما مشاهده کردیم، زیبا و خوش‌ساخت بود و صفه، سقف و در آن به‌خوبی هماهنگ و منظم طراحی شده است."],[194,"از مهندس آن عرض و اندیشه‌ها","آلت آورد و ستون از بیشه‌ها","هنرمند معمار از طبیعت و جنگل چوب‌ها را برای ساخت و ساز می‌آورد و طرح‌ها و ایده‌های خود را با آن‌ها پیاده می‌کند."],[194,"چیست اصل و مایه هر پیشه‌ای","جز خیال و جز عرض و اندیشه‌ای","هر حرفه و کاری که وجود دارد، ریشه در خیال و تفکر دارد و بدون این افکار و ایده‌ها، کاری ساخته نمی‌شود."],[194,"جمله اجزای جهان را بی غرض","در نگر حاصل نشد جز از عرض","تمام اجزای جهان را بدون هدف و قصد، نمی‌توان دید، زیرا تمام آنچه وجود دارد، تنها حاصل از ظواهر و چیزهای گذرا است."],[194,"اول فکر آخر آمد در عمل","بنیت عالم چنان دان در ازل","در ابتدای هر چیزی، فکر و نیت وجود دارد و این نیت، اساس و پی‌ریزی جهان به حساب می‌آید؛ این نکته را باید در آغاز خلقت در نظر داشته باشی."],[194,"میوه‌ها در فکر دل اول بود","در عمل ظاهر به آخر می‌شود","اندیشه‌های اصلی و نیت‌های قلبی ابتدا در ذهن شکل می‌گیرند، ولی نتایج و آثار آن‌ها در نهایت در عمل و واقعیت نمایان می‌شود."],[194,"چون عمل کردی شجر بنشاندی","اندر آخر حرف اول خواندی","وقتی عملی را انجام می‌دهی، در واقع درختی را در انتها می‌کاری که به ثمر می‌رسد، در حالی که در ابتدا فقط صحبت از آن می‌کنی."],[194,"گرچه شاخ و برگ و بیخش اولست","آن همه از بهر میوه مرسلست","با اینکه شاخ و برگ و ریشه درخت در ابتدا به نظر می‌رسد، اما همه این‌ها به خاطر میوه‌ای است که در انتها به بار می‌آید."],[194,"پس سری که مغز آن افلاک بود","اندر آخر خواجه لولاک بود","پس سرّی که اصل آن از آسمان‌ها و افلاک است، در نهایت به خواجه لولاک (یعنی خداوند) تعلق دارد."],[194,"نقل اعراضست این بحث و مقال","نقل اعراضست این شیر و شگال","این بحث و گفت‌وگو درباره اعراض (موضوعات ظاهری و امور سطحی) است، به همان اندازه که این شیر و شگال (حکایتی از تنوع و ویژگی‌های ظاهری) به آن تعلق دارد."],[194,"جمله عالم خود عرض بودند تا","اندرین معنی بیامد هل اتی","تمام موجودات عالم فقط یک حالت و ویژگی دارند و در این معنا به اصل و ماهیتشان اشاره می‌کنند که در آنجا معنای «هل اتی» (آیا رسید؟) مطرح می‌شود."],[194,"این عرضها از چه زاید از صور","وین صور هم از چه زاید از فکر","این بیان می‌کند که این وجودهای ظاهری (عرض‌ها) از چه چیزی نشأت می‌گیرند و خود این صورت‌ها نیز از چه فکر یا اندیشه‌ای سرچشمه می‌گیرند. به عبارت دیگر، ارتباط میان شکل‌های ظاهری و افکار اولیه را مورد سوال قرار می‌دهد."],[194,"این جهان یک فکرتست از عقل کل","عقل چون شاهست و صورتها رسل","این جهان یک فکر است از عقل کل؛ عقل، چون شاهی است و صورت‌ها، پیامبران او هستند. یعنی همه موجودات و پدیده‌ها در این دنیا نتیجه‌ی تفکر و عقل خالق هستند و عقل به منزله‌ی سرآمد است که جلوه‌های خود را از طریق صورت‌ها به نمایش می‌گذارد."],[194,"عالم اول جهان امتحان","عالم ثانی جزای این و آن","دنیا یک آزمون و آزمایش است و جهان بعدی، پاداش این امتحان و نتیجه اعمال افراد است."],[194,"چاکرت شاها جنایت می‌کند","آن عرض زنجیر و زندان می‌شود","بنده تو ای پادشاه، خطاهایی می‌کند و در نتیجه از آنچه که خواسته، زنجیر و زندان برایش به وجود می‌آید."],[194,"بنده‌ات چون خدمت شایسته کرد","آن عرض نی خلعتی شد در نبرد","وقتی بنده‌ات کار شایسته و قابل قبولی انجام داد، این خدمت به مانند زنجیری نمی‌شود که او را در میدان نبرد محبوس کند."],[194,"این عرض با جوهر آن بیضست و طیر","این از آن و آن ازین زاید به سیر","این دعا و نیایش که از دل برمی‌آید (عرض) از جوهر حقیقتی نشأت می‌گیرد که در آن وجود دارد، مانند رابطه‌ای که میان تخم‌مرغ (بیضه) و پرنده (طیر) وجود دارد؛ یکی از دیگری برمی‌خیزد و هر دو به یکدیگر وابسته‌اند."],[194,"گفت شاهنشه چنین گیر المراد","این عرضهای تو یک جوهر نزاد","شاهنشاه (فرمانروا) گفت: این خواسته‌ها و آرزوهای تو هیچ‌گاه از یک ذات و جوهر حقیقی (اصلی) به وجود نیامده است."],[194,"گفت مخفی داشتست آن را خرد","تا بود غیب این جهان نیک و بد","خرد (عقل) گفته است که رازها و امور پنهانی را در خود نگه داشته و تا زمانی که این جهان (دنیا) وجود دارد، خوبی‌ها و بدی‌ها را نمی‌توان به‌طور کامل فهمید."],[194,"زانک گر پیدا شدی اشکال فکر","کافر و مؤمن نگفتی جز که ذکر","اگر حقیقت آشکار شود، فکرهای کافر و مؤمن به یکدیگر شباهت می‌یابند و چیزی جز یاد خدا نمی‌ماند که بیان شود."],[194,"پس عیان بودی نه غیب ای شاه این","نقش دین و کفر بودی بر جبین","ای پادشاه، این حقیقت روشن و آشکار است و نه پنهان که نشانه‌های دین و کفر بر پیشانی افراد مشخص است."],[194,"کی درین عالم بت و بتگر بدی","چون کسی را زهره تسخر بدی","در این دنیا، بت و بت‌پرستی به نوعی وجود دارد که وقتی کسی قدرت یا جرئت نداشته باشد تا کسی را به تمسخر بگیرد، واقعا مضحک به نظر می‌رسد."],[194,"پس قیامت بودی این دنیای ما","در قیامت کی کند جرم و خطا","این دنیا مانند قیامت است و در آن، هیچ‌کس نمی‌تواند به سادگی مرتکب جرم و خطا شود. در قیامت، همه اعمال مشهود است و عواقب آن‌ها نمایان خواهد شد."],[194,"گفت شه پوشید حق پاداش بد","لیک از عامه نه از خاصان خود","سلطانی (شه) گفت که پاداش بدی را که کرده است، مخفی می‌دارد و به اشخاص عادی نمی‌دهد، بلکه آن را فقط از خاصان و نزدیکان خود دریافت می‌کند."],[194,"گر به دامی افکنم من یک امیر","از امیران خفیه دارم نه از وزیر","اگر من یک امیر را در دام بیندازم، از امیرانی دیگر دلم آسوده است، زیرا او از وزیران نیست."],[194,"حق به من بنمود پس پاداش کار","وز صورهای عملها صد هزار","حق (خدا) بر من نمایان ساخت که نتیجه اعمال، پاداشی بسیار بیشتر از تصور است و از نتایج کارها، حیرت‌انگیز و بی‌شمار خواهد بود."],[194,"تو نشانی ده که من دانم تمام","ماه را بر من نمی‌پوشد غمام","تو نشانی بده که من همه چیز را بدانم؛ غم و اندوه نمی‌تواند تمام ماه (نشانه روشنایی و حقیقت) را از من بپوشاند."],[194,"گفت پس از گفت من مقصود چیست","چون تو می‌دانی که آنچ بود چیست","سخن از اهداف من چه سودی دارد، وقتی تو به روشنی می‌دانی آنچه لازم است چیست."],[194,"گفت شه حکمت در اظهار جهان","آنک دانسته برون آید عیان","حکیم بزرگ گفت که تنها چیزی که به وضوح در جهان نمایان می‌شود، همان چیزی است که قبلا در دل و ذهن دانسته شده است."],[194,"آنچ می‌دانست تا پیدا نکرد","بر جهان ننهاد رنج طلق و درد","آنچه او می‌دانست و به وضوح به آن رسید، بر دنیا زحمت و عذاب را نپذیرفت."],[194,"یک زمان بی کار نتوانی نشست","تا بدی یا نیکیی از تو نجست","تو نمی‌توانی حتی برای لحظه‌ای بیکار باشی، زیرا یا کار بدی انجام خواهی داد یا کاری نیک."],[194,"این تقاضاهای کار از بهر آن","شد موکل تا شود سرت عیان","این خواسته‌های کاری به خاطر این است که نگهبانی بر تو گذاشته شده تا حقیقت تو آشکار شود."],[194,"پس کلابه تن کجا ساکن شود","چون سر رشته ضمیرش می‌کشد","اگر روح و نفس انسان مشغول دغدغه‌ها و وسوسه‌های دنیوی باشد، چگونه می‌تواند در آرامش و سکون زندگی کند؟ زیرا در این حالت، افکار و احساسات او، او را به سمت خود می‌کشد و از امنیت و آرامش دور می‌کند."],[194,"تاسه تو شد نشان آن کشش","بر تو بی کاری بود چون جان‌کنش","نشانه این کششی که به سوی تو وجود دارد، نتیجه سه‌گانه‌ای است که از تو به وجود آمده و این نشان‌دهنده کم‌کاری تو است، مانند جان‌کندن که نشان می‌دهد کار می‌کنی."],[194,"این جهان و آن جهان زاید ابد","هر سبب مادر اثر از وی ولد","این جهان و آن جهان دائما به وجود می‌آیند و هر علتی، مادر اثر یا پدیده‌ای است که از آن ناشی می‌شود."],[194,"چون اثر زایید آن هم شد سبب","تا بزاید او اثرهای عجب","هرگاه اثری تولید شود، آن اثر هم خود به عنوان دلیلی جدید به وجود می‌آید تا اثرهای شگفت‌انگیز دیگری را به وجود آورد."],[194,"این سببها نسل بر نسلست لیک","دیده‌ای باید منور نیک نیک","این علت‌ها به صورت نسل به نسل ادامه دارد، اما باید چشمی نورانی و روشنگر داشته باشی تا آن‌ها را به خوبی ببیند."],[194,"شاه با او در سخن اینجا رسید","یا بدید از وی نشانی یا ندید","شاه در اینجا به گفتگو با او رسید و شاید هم از او اثری را مشاهده کرد یا اینکه از او چیزی ندید."],[194,"گر بدید آن شاه جویا دور نیست","لیک ما را ذکر آن دستور نیست","اگر آن شاه را به دور دست دیده باشد، اما نامی از او به میان نمی‌آوریم و در این گفتگو اشاره‌ای به او نمی‌کنیم."],[194,"چون ز گرمابه بیامد آن غلام","سوی خویشش خواند آن شاه و همام","وقتی آن غلام از حمام بیرون آمد، آن شاه و همام او را به سمت خود فراخواند."],[194,"گفت صحا لک نعیم دائم","بس لطیفی و ظریف و خوب‌رو","غلام به معشوق می‌گوید که تو را نعمت‌ها و لذت‌های همیشگی و نیکو، که همه از لطافت و زیبایی تو برمی‌خیزد، می‌بخشم."],[194,"ای دریغا گر نبودی در تو آن","که همی‌گوید برای تو فلان","ای کاش در وجود تو، آن کسی که می‌گوید برای تو چنین و چنان، نبود."],[194,"شاد گشتی هر که رویت دیدیی","دیدنت ملک جهان ارزیدیی","هر کس که چهره‌ات را ببیند شاد می‌شود، زیرا وجود تو برای او ارزشمندتر از تمام جهان است."],[194,"گفت رمزی زان بگو ای پادشاه","کز برای من بگفت آن دین‌تباه","پادشاه می‌گوید: ای کسی که درخشان و بزرگ هستی، رازی را بگو که به خاطر من، آن دین فاسد و خراب را بر زبان آوردند."],[194,"گفت اول وصف دوروییت کرد","کاشکارا تو دوایی خفیه درد","گفت ابتدا مشخصات نیرنگ بازی و دورویی تو را بیان کرد و ای کاش که تو داروی پنهان درد من باشی."],[194,"خبث یارش را چو از شه گوش کرد","در زمان دریای خشمش جوش کرد","وقتی یار بدجنس او به او کم‌محبت و بدگویی کرد، دریایی از خشم درون او به وجود آمد و خشمش طغیانی شد."],[194,"کف برآورد آن غلام و سرخ گشت","تا که موج هجو او از حد گذشت","غلام که به یارش وفادار است، از شدت خشم و ناپاکی یار، دستش را به علامت اعتراض بالا می‌برد و چهره‌اش سرخ می‌شود، چون موج توهین و بی‌احترامی نسبت به او بیش از حد می‌شود."],[194,"کو ز اول دم که با من یار بود","همچو سگ در قحط بس گه‌خوار بود","از ابتدا که یار من به دنیا آمد، مانند سگی وفادار در سختی‌ها و قحطی‌ها همراه من بود."],[194,"چون دمادم کرد هجوش چون جرس","دست بر لب زد شهنشاهش که بس","هر بار که صدای او به گوش می‌رسد، مانند صدای زنگی که در فاصله‌های منظم به صدا درمی‌آید، او نیز به شوق و محبت می‌افتد و دلتنگی‌اش نمودار می‌شود."],[194,"گفت دانستم ترا از وی بدان","از تو جان گنده‌ست و از یارت دهان","گفت: فهمیدم تو از آن شخصی و به خاطر تو جانت بزرگ است و از یارت، دهانش (از او) است."],[194,"پس نشین ای گنده‌جان از دور تو","تا امیر او باشد و مامور تو","از دور برای تو بنشین، چون این مقام برای شخص دیگری است، تا او (امیر) به وظایف خود بپردازد و به تو فرمان بدهد."],[194,"در حدیث آمد که تسبیح از ریا","همچو سبزه گولخن دان ای کیا","در روایت آمده که تسبیح به دور از ریا و نفاق، همانند سبزه گولخن (نوعی علف بی‌ارزش) محسوب می‌شود، ای بزرگوار."],[194,"پس بدان که صورت خوب و نکو","با خصال بد نیرزد یک تسو","پس بفهم که زیبایی ظاهری و خوب و نیکو بودن صورت، به تنهایی ارزشمند نیست و در برابر اخلاق و رفتار بد نمی‌ارزد."],[194,"ور بود صورت حقیر و ناپذیر","چون بود خلقش نکو در پاش میر","حتی اگر ظاهری بی‌ارزش و ناپسند داشته باشد، وقتی خلق و خوی او نیکو باشد، در نظر دیگران بزرگ و ارزشمند خواهد بود."],[194,"صورت ظاهر فنا گردد بدان","عالم معنی بماند جاودان","ظاهر و صورت دنیوی از بین می‌رود، اما حقیقت معنوی و ارزش‌های عمیق در عالم معنی باقی می‌ماند و پایدار است."],[194,"چند بازی عشق با نقش سبو","بگذر از نقش سبو رو آب جو","عشق مانند بازی است که به شکل ظرفی (سبو) ظاهر شده، اما باید فراتر از این ظاهر رفت و به جوهر و حقیقت آب (محبت) دست یافت."],[194,"صورتش دیدی ز معنی غافلی","از صدف دری گزین گر عاقلی","اگر فقط به ظاهر او توجه کنی و از باطن و معنای عمیق غافل باشی، در حقیقت از انتخاب جواهر واقعی (مانند در) بی‌خبری کرده‌ای. اگر عاقل باشی، باید به عمق و حقیقت اشیاء نگاه کنی."],[194,"این صدفهای قوالب در جهان","گرچه جمله زنده‌اند از بحر جان","این قوالب و شکل‌ها در جهان، هرچند که به ظاهر زنده به نظر می‌رسند، اما حقیقتشان تنها از جان الهی ناشی می‌شود."],[194,"لیک اندر هر صدف نبود گهر","چشم بگشا در دل هر یک نگر","اما در هر صدفی مروارید وجود ندارد، بنابراین باید با دقت به دل هرکدام نگاه کنی."],[194,"کان چه دارد وین چه دارد می‌گزین","زانک کم‌یابست آن در ثمین","آنچه که در هر چیزی وجود دارد را با آنچه دارد مقایسه کن و انتخاب کن، زیرا آنچه کم‌یاب است و ارزشمند، در مواردی که دارای زیبایی و ارزش خاصی است، وجود دارد."],[194,"گر به صورت می‌روی کوهی به شکل","در بزرگی هست صد چندان که لعل","اگر به شکل و ظاهری مثل کوه بیایی، آنچه در درون تو هست، به اندازه‌ای بزرگ و باارزش است که صد برابر آن لعل (سنگ گران‌بها) می‌باشد."],[194,"هم به صورت دست و پا و پشم تو","هست صد چندان که نقش چشم تو","در تو، علاوه بر صورت و اعضای بدنی‌ات مثل دست و پا و مو، وجودی بزرگ و گسترده‌تر از آنچه که چشم تو می‌بیند، نهفته است."],[194,"لیک پوشیده نباشد بر تو این","کز همه اعضا دو چشم آمد گزین","ولی نباید از دید تو پنهان باشد که از تمام اعضای بدن، فقط دو چشم انتخاب شده‌اند."],[194,"از یک اندیشه که آید در درون","صد جهان گردد به یک دم سرنگون","یک فکر می‌تواند در ذهن انسان بوجود بیاید و در عرض یک لحظه باعث سقوط و نابودی صدها جهان و دنیا شود."],[194,"جسم سلطان گر به صورت یک بود","صد هزاران لشکرش در پی دود","اگرچه جسم سلطان به ظاهر یکی است، اما هزاران لشکر و نیرو به خاطر او و به دنبال قدر و اعتبارش وجود دارند."],[194,"باز شکل و صورت شاه صفی","هست محکوم یکی فکر خفی","شکل و ظاهر شاه صفی (شاهی در تاریخ ایران) فقط نمایانگر او نیست، بلکه این انتظار وجود دارد که به عمق اندیشه و تفکر او توجه شود که بر همه چیز حاکم است."],[194,"خلق بی‌پایان ز یک اندیشه بین","گشته چون سیلی روانه بر زمین","انسان‌های بی‌شمار به واسطه یک فکر یا اندیشه، به صورت‌های مختلف در آمده‌اند، مانند سیل که به طور ناگهانی و بی‌وقفه بر زمین می‌ریزد."],[194,"هست آن اندیشه پیش خلق خرد","لیک چون سیلی جهان را خورد و برد","اندیشه نیک و خردمندانه‌ای وجود دارد که بر همه انسان‌ها تأثیر می‌گذارد، اما این اندیشه مانند سیلی است که جهان را جا به جا می‌کند و همه چیز را تحت تأثیر خود قرار می‌دهد."],[194,"پس چو می‌بینی که از اندیشه‌ای","قایمست اندر جهان هر پیشه‌ای","پس وقتی می‌بینی که هر شغل و حرفه‌ای در دنیا از یک اندیشه و فکر نهانی سرچشمه می‌گیرد،"],[194,"خانه‌ها و قصرها و شهرها","کوهها و دشتها و نهرها","خانه‌ها، قصرها، شهرها، کوه‌ها، دشت‌ها و نهرها همگی نشان‌دهنده‌ی موجودیت و زیبایی‌های جهان هستند."],[194,"هم زمین و بحر و هم مهر و فلک","زنده از وی همچو کز دریا سمک","تمامی موجودات در زمین و دریا و نورهای آسمانی از او زنده و پوینده هستند، مانند آن که از دریا یک ماهی بیرون می‌آید و زندگی می‌کند."],[194,"پس چرا از ابلهی پیش تو کور","تن سلیمانست و اندیشه چو مور","چرا با وجود چنین عظمت و زیبایی، بعضی‌ها مانند سلیمان از حقیقت کور هستند و ذهنشان به اندازه یک مور کوچک و ضعیف است؟"],[194,"می‌نماید پیش چشمت که بزرگ","هست اندیشه چو موش و کوه گرگ","در نظر تو، اندیشه‌ها بزرگ و مهم به نظر می‌رسند، در حالی که در واقعیت، این اندیشه‌ها کوچک و بی‌اهمیت هستند. همان‌طور که موش کوچک است و کوهی بزرگ به نظر می‌رسد، اندیشه‌های تو هم از نظر حجم و اثرگذاری واقعی کوچک اما در نظرت بزرگ جلوه می‌کنند."],[194,"عالم اندر چشم تو هول و عظیم","ز ابر و رعد و چرخ داری لرز و بیم","دنیا در نظر تو بسیار ترسناک و بزرگ به نظر می‌رسد، مثل طوفان و رعد و برق و آسمانی که تو را به لرزه می‌اندازد و هراسان می‌کند."],[194,"وز جهان فکرتی ای کم ز خر","ایمن و غافل چو سنگ بی‌خبر","تو از دنیای فکر و اندیشه‌ات کمتر از خر ایمنی و از آن غافلی، مانند سنگی که بی‌خبر از خود و محیطش است."],[194,"زانک نقشی وز خرد بی‌بهره‌ای","آدمی خو نیستی خرکره‌ای","چون انسانی که از خرد و فهم بی‌بهره است، مانند خر (حیوانی که به تحمل بار شناخته می‌شود) نیست؛ او در حقیقت خود را از واقعیت جدا می‌کند و نسبت به خود بی‌خبر است."],[194,"سایه را تو شخص می‌بینی ز جهل","شخص از آن شد نزد تو بازی و سهل","سایه را شما به عنوان یک شخص می‌بینید، ولی این ناشی از جهل خود شماست که آن را ساده و بازیچه تصور می‌کنید."],[194,"باش تا روزی که آن فکر و خیال","بر گشاید بی‌حجابی پر و بال","منتظر بمان تا روزی که آن اندیشه و خیال تو را آزاد کند و بدون هیچ پوششی آزادانه پرواز کنی."],[194,"کوهها بینی شده چون پشم نرم","نیست گشته این زمین سرد و گرم","این زمین که می‌بینی، به اندازه‌ای نرم و سست شده است که کوه‌ها به مانند پشم می‌نمایند. در واقع، تغییرات در جهان باعث شده که هرچیزی به حالتی غیرمقاوم و شکننده درآید."],[194,"نه سما بینی نه اختر نه وجود","جز خدای واحد حی ودود","نه آسمان را می‌بینی، نه ستاره‌ای، نه چیزی از این عالم، جز خداوند واحد و زنده و مهربان."],[194,"یک فسانه راست آمد یا دروغ","تا دهد مر راستیها را فروغ","یک داستان واقعی یا دروغ به وجود آمده تا نور حقیقت‌ها را روشن کند."],[195,"پادشاهی بنده‌ای را از کرم","بر گزیده بود بر جمله حشم","پادشاه به خاطر لطف و بزرگی‌اش، یکی از خدمتگزاران خود را میان همه درباریان انتخاب کرده بود."],[195,"جامگی او وظیفه چل امیر","ده یک قدرش ندیدی صد وزیر","غم‌خواری او ارزش و مقام او را برای هیچ‌یک از وزرا و مقاماتی که برابر با جایگاه پادشاه هستند، نمی‌بیند."],[195,"از کمال طالع و اقبال و بخت","او ایازی بود و شه محمود وقت","بخت و سرنوشت او به قدری خوش و همراه با موفقیت بود که ایاز (غلام خاص) و شاه محمود در آن زمان از آن بهره‌مند شدند."],[195,"روح او با روح شه در اصل خویش","پیش ازین تن بوده هم پیوند و خویش","روح او (ایازی) در ذات خود، پیش از اینکه به این بدن محقق شود، با روح شاه محمود ارتباط و پیوند عمیق داشته است."],[195,"کار آن دارد که پیش از تن بدست","بگذر از این‌ها که نو حادث شدست","انسان باید به ذات حقیقی و روح خود که پیش از تن به وجود آمده توجه کند و از امور جدید و سطحی که فقط به ظاهر مربوط می‌شوند، فراتر برود."],[195,"کار عارف‌ راست کو نه احول است","چشم او بر کشت‌های اول است","عارف واقعی کسی است که در کارهای خود اندیشه و تعقل دارد و به دقت به کارهای آغازین و ریشه‌ها می‌نگرد، نه اینکه بی‌دقت و فریب‌خورده به مسائلی بی‌اهمیت توجه کند."],[195,"آنچ گندم کاشتندش و آنچ جو","چشم او آنجاست روز و شب گرو","آنچه را که از گندم کاشته‌اند و آنچه را که از جو کاشته‌اند، نگاه او فقط به همان است و در تمام روز و شب در انتظار آن است."],[195,"آنچ آبستست شب جز آن نزاد","حیله‌ها و مکرها بادست باد","آنچه در دل شب پنهان شده یا نمی‌تواند به حقیقت پیوندد، جز جادوها و فریب‌هایی که دست باد ایجاد می‌کند، نیست."],[195,"کی کند دل خوش به حیلت‌های گش","آنک بیند حیله حق بر سرش","کسی که دلش به نیرنگ‌ها شاد باشد، وقتی می‌بیند که نیرنگ‌های حق (یا تدبیر الهی) بر او چیره شده، دیگر نمی‌تواند خوشحال باشد."],[195,"او درون دام و دامی می‌نهد","جان تو نی آن جهد نی این جهد","او جان تو را درون دامی قرار می‌دهد که نه در این تلاش است و نه در آن تلاش."],[195,"گر بروید ور بریزد صد گیاه","عاقبت بر روید آن کشته اله","اگر صد گیاه هم بروید یا بریزد، در نهایت آن کشت الهی (امور معنوی و راستین) رشد کرده و نمایان خواهد شد."],[195,"کشت نو کارند بر کشت نخست","این دوم فانی‌ست وان اول درست","کشت جدیدی که اکنون کاشته می‌شود، بر روی کشت قبلی است. این کشت دوم نابود شدنی و فانی است، در حالی که کشت اول صحیح و پایدار است."],[195,"تخم اول کامل و بگزیده است","تخم ثانی فاسد و پوسیده است","تخم اول به‌طور کامل و باکیفیت است، در حالی که تخم دوم فاسد و خراب شده است."],[195,"افکن این تدبیر خود را پیش دوست","گرچه تدبیرت هم از تدبیر اوست","تدبیر و نقشه‌ات را برای جلب نظر و محبت دوست بکار ببر، حتی اگر نقشه‌ات به همان اندازه وابسته به تدبیر او باشد."],[195,"کار آن دارد که حق افراشت است","آخر آن روید که اول کاشت است","کار هر شخص نتیجه اعمال و نیت‌های اوست؛ بنابراین، در نهایت آنچه به بار می‌آید، حاصل آن چیزی است که نخست پایه‌گذاری شده است."],[195,"هرچه کاری از برای او بکار","چون اسیر دوستی ای دوستدار","هر کاری که انسان برای او (خدا) انجام می‌دهد، مانند دوستی است که او را به اسارتی می‌کشاند."],[195,"گرد نفس دزد و کار او مپیچ","هرچه آن نه کار حق هیچست هیچ","به گرد خودت و کارهای دزد نچرخ، زیرا آنچه او انجام می‌دهد عمل حق نیست و هیچ ارزشی ندارد."],[195,"پیش از آنک روز دین پیدا شود","نزد مالک دزد شب رسوا شود","پیش از آنکه روز قیامت و حساب و کتاب نمایان شود، دزد باید در شب چهره‌اش رسوا گردد و عیوبش فاش شود."],[195,"رخت دزدیده به تدبیر و فنش","مانده روز داوری بر گردنش","غزالی که دزدی کرده، چاره‌جویی و زیرکی‌اش باعث شده که در روز محاکمه نشانه‌ها و آثار دزدی هنوز بر دوش او باقی بماند."],[195,"صد هزاران عقل با هم بر جهند","تا به غیر دام او دامی نهند","همه عقل‌ها و اندیشه‌ها به میدان می‌آیند تا دام دیگری به غیر از دام او (که به نظر می‌رسد شخصیتی خاص باشد) بیفکنند."],[195,"دام خود را سخت‌تر یابند و بس","کی نماید قوتی با باد، خس","دام خود را محکم‌تر و تنگ‌تر می‌کنند، اما در نهایت نمی‌توانند از پس باد برآیند، مانند ساقه‌ی خس که با وزش باد آسیب می‌بیند."],[195,"گر تو گویی فایده هستی چه بود","در سؤالت فایده هست ای عنود","اگر تو می‌پرسی فایده وجود انسان چیست، باید بدانی که در پرسش تو هم فایده‌ای وجود دارد، ای کسی که همیشه منفی‌نگر هستی."],[195,"گر ندارد این سؤالت فایده","چه شنویم این را عبث بی‌عایده","اگر این سؤال تو هیچ فایده‌ای ندارد، پس چرا این حرف را می‌زنیم که بیهوده و بدون سود است؟"],[195,"ور سؤالت را بسی فایده‌هاست","پس جهان بی‌فایده آخر چراست؟","اگر این سؤال که می‌کنی، خیلی فایده دارد، پس چرا جهان در نهایت بی‌فایده است؟"],[195,"ور جهان از یک جهت بی فایده‌ است","از جهت‌های دگر پر عایده‌ است","اگرچه از یک جنبه، جهان بی‌فایده به نظر می‌رسد، اما از جنبه‌های دیگر، پر از سود و منفعت است."],[195,"فایده تو گر مرا فایده نیست","مر ترا چون فایده‌ست از وی مایست","اگر فایده‌ای که تو داری برای من بی‌فایده است، آن فایده برای تو چه ارزشی دارد که به من مرتبط است؟"],[195,"حسن یوسف عالمی را فایده","گرچه بر اخوان عبث بد زایده","زیبایی یوسف (که به عنوان نماد زیبایی در ادبیات فارسی شناخته شده) برای تمام عالم فایده دارد، هرچند که برادرانش (اخوان) تنها به حسادت و کینه‌ورزی نسبت به او دچار شده‌اند و از این زیبایی هیچ بهره‌ای نمی‌برند."],[195,"لحن داوودی چنان محبوب بود","لیک بر محروم بانگ چوب بود","لحن داوود (پیامبر) چنان دل‌نشین و زیبا بود که همه آن را دوست داشتند، اما برای کسانی که از نعمت‌ها محروم بودند، صدای او مانند صدای کتک زدن بود."],[195,"آب نیل از آب حیوان بد فزون","لیک بر محروم و منکر بود خون","آب نیل که به عنوان منبعی حیات‌بخش شناخته می‌شود، از آب حیوانی که مظهر حیات است، بیشتر است، اما برای کسی که محروم و منکر حقایق است، این آب نیز بی‌فایده و بی‌استفاده خواهد بود."],[195,"هست بر مؤمن شهیدی زندگی","بر منافق مردنست و ژندگی","زندگی مؤمن، گواهی و شهادت است، در حالی که زندگی منافق به مثابه مرگ و نیستی است."],[195,"چیست در عالم بگو یک نعمتی","که نه محرومند از وی امتی","در این جهان، بگو چه نعمتی وجود دارد که هیچ گروهی از آن محروم نیستند."],[195,"گاو و خر را فایده چه در شکر","هست هر جان را یکی قوتی دگر","گاو و خر در شکر (شیرین‌کاری) چه سودی دارند، زیرا هر موجودی برای ادامه حیات خود به نوعی قوت و تغذیه نیاز دارد."],[195,"لیک گر آن قوت بر وی عارضیست","پس نصیحت کردن او را رایضی‌ست","اگر آن قوتی که به آن فرد رسیده، به طور طبیعی در وجود او نیست و فقط به دلایل خارجی به او اضافه شده، پس نصیحت کردن او در مورد آن امر، حکیمانه و درست است."],[195,"چون کسی کو از مرض گل داشت دوست","گرچه پندارد که آن خود قوت اوست","کسی که به دلیل بیماری، در درونش کثیفی و آلودگی دارد، ممکن است فکر کند که همان آلودگی قدرت اوست، در حالی که در واقع این یک ضعف است."],[195,"قوت اصلی را فرامش کرده است","روی در قوت مرض آورده است","او به جای توجه به قدرت اصلی و وجود واقعی‌اش، به قدرتی که از بیماری‌اش ناشی می‌شود، اعتنا کرده است."],[195,"نوش را بگذاشته سم خورده است","قوت علت را چو چربش کرده است","انسان نعمت و انرژی اصل خودش را رها کرده و به جای آن به چیزهای زهرآلود و مضر روی آورده است و تأثیرات منفی علت اصلی را در زندگی‌اش احساس کرده است."],[195,"قوت اصلیّ بشر نور خداست","قوت حیوانی مر او را ناسزاست","قدرت و نیروی اصلی انسان از نور الهی ناشی می‌شود و نیروی حیوانی نسبت به آن ناپسند است."],[195,"لیک از علت درین افتاد دل","که خورد او روز و شب زین آب و گل","اما به سبب علتی، دل او در این وضعیت افتاده است که روز و شب از این آب و خاک تغذیه می‌کند."],[195,"روی زرد و پای سست و دل سبک","کو غذای والسّما ذات الحبک؟","دلی مضطرب و بی‌قرار، و حالتی پریشان و ناتوانی در بدن نشان می‌دهد که از نبودن غذای خاصی رنج می‌برد و آن غذا چیزی جز عشق و محبتی عمیق نیست."],[195,"آن غذای خاصگان دولت است","خوردن آن بی گلو و آلت است","این غذای ویژه افراد خاص و مقرب به درگاه خداوند است و دریافت آن بدون هیچ واسطه و کلامی ممکن نیست."],[195,"شد غذای آفتاب از نور عرش","مر حسود و دیو را از دود فرش","غذای آفتاب از نور عرش، به معنای شروط و ویژگی‌های خاصی است که در دنیای اعلای الهی وجود دارد و حسود و دیو (نماد بی‌خودی و بدی) از خامی و ناپاکی دنیوی به وجود می‌آید."],[195,"در شهیدان یرزقون فرمود حق","آن غذا را نی دهان بد، نی طبق","در شهیدان، حق تعالی فرموده است که آن‌ها روزی می‌گیرند و غذا به آن‌ها داده می‌شود، اما این غذا نه از طریق دهان و خوراکی معمولی، بلکه به گونه‌ای دیگر و فراتر از اوهام مادی تامین می‌شود."],[195,"دل ز هر یاری غذایی می‌خورد","دل ز هر علمی صفایی می‌برد","دل انسان از هر دوستی و یاری Nourishment و شادابی می‌گیرد و از هر علمی که می‌آموزد، روح و صفا دریافت می‌کند."],[195,"صورت هر آدمی چون کاسه‌ای‌ست","چشم از معنیّ او حساسه‌ای‌ست","هر انسانی مثل یک کاسه است و درون او معنا و مفهومش وجود دارد که چشم (نگاه) به آن معنا، حساسیت و تأثیر دارد."],[195,"از لقای هر کسی چیزی خوری","وز قران هر قرین چیزی بری","از دیدار هر کس چیزی به دست بیاور و از همراهی هر دوستی نیز چیزی به دست آور."],[195,"چون ستاره با ستاره شد قرین","لایق هر دو اثر زاید یقین","وقتی دو ستاره با یکدیگر همراه و نزدیک شوند، هر یک بر دیگری تأثیرات شایسته‌ای خواهد گذاشت و این رابطه آنها به وضوح نتیجه‌ داشته و یقینا اثرات مثبتی ایجاد می‌کند."],[195,"چون قران مرد و زن زاید بشر","وز قران سنگ و آهن شد شرر","همانطور که از هم‌بستگی مرد و زن، بشر زاییده می‌شود، از هم‌نشینی سنگ و آهن هم آتش شعله‌ور می‌گردد."],[195,"وز قران خاک با باران‌ها","میوه‌ها و سبزه و ریحان‌ها","از ترکیب خاک و باران، میوه‌ها و گیاهان خوشبو و سبز مانند ریحان به وجود می‌آید."],[195,"وز قران سبزه‌ها با آدمی","دلخوشی و بی‌غمی و خرمی","از میوه‌ها و سبزه‌ها که به وسیله نعمت‌های الهی حاصل می‌شود، دل آدمی شاد و بدون غم و خوشحال است."],[195,"وز قران خرمی با جان ما","می‌بزاید خوبی و احسان ما","از ترکیب شادی و خرمی با وجود انسان، خوبی‌ها و نیکی‌های ما زاده می‌شود و شکل می‌گیرد."],[195,"قابل خوردن شود اجسام ما","چون بر آید از تفرج کام ما","اجسام ما به خاطر لذت و خوشی‌هایی که از تفرج و گشت و گذار به دست می‌آوریم، شایسته خورده شدن یا مورد استفاده قرار گرفتن می‌شوند."],[195,"سرخ‌رویی از قران خون بود","خون ز خورشید خوش گلگون بود","سرخی چهره به خاطر تأثیر خون است و این خون به خاطر تابش آفتاب خوش‌رنگ گلگون به وجود آمده است."],[195,"بهترین رنگ‌ها سرخی بود","وان ز خورشید است و از وی می‌رسد","بهترین رنگ‌ها سرخ است و این سرخی از خورشید ناشی می‌شود و به وسیله آن به ما می‌رسد."],[195,"هر زمینی کان قرین شد با زحل","شوره گشت و کشت را نبود محل","هر زمینی که با سیاره زحل هم‌جواری پیدا کند، شوره‌زار می‌شود و جایی برای کشت‌وکار نخواهد داشت."],[195,"قوت اندر فعل آید ز اتفاق","چون قران دیو با اهل نفاق","قدرت و نیروی عمل از همکاری و هماهنگی به وجود می‌آید، همان‌گونه که پیوند شیطان (دیو) با hypocrites (دوتا چهره‌ها) به هم کمک می‌کند."],[195,"این معانی راست از چرخ نهم","بی همه طاق و طرم، طاق و طرم","این معانی ناشی از چرخ نهم است که از نظر و اعتقاد هر کسی متفاوت است و بدون هیچ محدودیت و قیدی در دسترس است."],[195,"خلق را طاق و طرم عاریت است","امر را طاق و طرم ماهیت است","آفرینش و شکل‌گیری موجودات در دنیا، به‌صورت موقتی و عاریتی است و به همین دلیل، احساساتی مانند طاق و طرم (شکوه و زیبایی) نیز، تنها ظاهری دارند. اما وجود واقعی چیزها، به ماهیت و حقیقت‌شان وابسته است."],[195,"از پی طاق و طرم خواری کشند","بر امید عزّ در خواری خوشند","انسان‌ها به دنبال ظاهری زیبا و بی‌نقص هستند، اما در واقع به خاطر این جستجو، زیر بار ذلت و خواری زندگی می‌کنند و در آرزوی دستیابی به عظمت و مقام، در شرایط ناگواری خوشحال به نظر می‌رسند."],[195,"بر امید عز ده‌روزه‌ی خدوک","گردن خود کرده‌اند از غم چو دوک","به امید دستیابی به عزت و مقام ده روزه، مانند دوک که برای ریسیدن نخ گردن خود را به نشانه‌ی غم و اندوه خم کرده‌اند."],[195,"چون نمی‌آیند اینجا که منم","کاندرین عز آفتاب روشنم","چون این افراد به اینجا نمی‌آیند که من هستم، بدانید که من در اینجا مانند آفتاب روشنی‌ام."],[195,"مشرق خورشید برج قیرگون","آفتاب ما ز مشرق‌ها برون","خورشید ما از مشرق‌های مختلف می‌تابد و در دل رنگ قیرگون برجی قرار دارد."],[195,"مشرق او نسبت ذرات او","نه بر آمد نه فرو شد ذات او","مقام و اصل وجود او (خدا) نسبت به ذرات و اشیاء دیگرش نه از مشرقی خاص می‌آید و نه در غروب و افول قرار می‌گیرد، زیرا ذات او همواره ثابت و ثابت‌الوجود است."],[195,"ما که واپس ماند ذرات وی‌ایم","در دو عالم آفتاب بی فی‌ایم","ما که جزئی از وجود او هستیم و در حالت عقب‌ماندگی و تنهایی به سر می‌بریم، در هر دو عالم بجز نور خورشید، از روشنی و نعمت او بهره‌ای نداریم."],[195,"باز گرد شمس می‌گردم عجب","هم ز فرّ شمس باشد این سبب","من دوباره به دور شمس می‌چرخم، و این برایم عجیب است که این دلیل، تنها به خاطر نور و عظمت شمس است."],[195,"شمس باشد بر سبب‌ها مطّلع","هم ازو حبل سبب‌ها منقطع","شمس به تمامی علل و دلایل آگاه است و به خاطر وجود او، ارتباط با دلایل و عوامل دیگر قطع می‌شود."],[195,"صد هزاران بار ببریدم امید","از کی؟ از شمس؟ این شما باور کنید؟","من از امیدم بارها جدا شدم، اما آیا این امید به شمس است؟ این نکته را شما باور کنید."],[195,"تو مرا باور مکن کز آفتاب","صبر دارم من و یا ماهی ز آب","منظور شاعر این است که به من اعتماد نکن، زیرا من را افرادی چون آفتاب، که صبر دارد، یا ماهی که در آب است، نمی‌توانی ببینی و درک کنی. من تنها در خودم وضعیتی دارم که به کسی نشان نخواهم داد."],[195,"ور شوم نومید نومیدیّ من","عین صنع آفتاب است ای حسن","اگر من ناامید شوم، آن ناامیدی خود به نوعی از آثار و نشانه‌های وجود آفتاب است، ای زیبایی."],[195,"عین صنع از نفس صانع چون برد","هیچ هست از غیر هستی چون چرد","آثاری که از وجود صانع (خالق) بیرون می‌آید، اگر از نفس او جدا شود، دیگر هیچ چیز از غیر خود به وجود نخواهد آمد و هر آنچه وجود دارد، به او بازمی‌گردد."],[195,"جمله هستی‌ها ازین روضه چرند","گر براق و تازیان ور خود خرند","تمام موجودات و هستی‌ها از این باغ و گلزار تنها بازیچه‌هایی هستند، حتی اگر زیبا و شگفت‌انگیز به نظر بیایند، در حقیقت همه آنها مانند یک الاغ (خر) هستند و ارزش واقعی ندارند."],[195,"وانک گردش‌ها از آن دریا ندید","هر دم آرد رو به محرابی جدید","وگرچه این گردش‌ها و تحولات از آن دریا (دریای وجود) دیده نمی‌شود، اما هر لحظه به سمت محرابی جدید می‌شتابد، یعنی هر لحظه تغییر و تحول تازه‌ای به وجود می‌آید."],[195,"او ز بحر عذب آب شور خورد","تا که آب شور او را کور کرد","او از دریا که آب شیرین دارد، آب شور می‌نوشد تا اینکه آب شور او را نابینا کرده است."],[195,"بحر می‌گوید به دست راست خور","ز آب من، ای کور، تا یابی بصر","در این بیت، بحر (که می‌تواند نماد علم یا دانش باشد) به شخص نابینا (کور) می‌گوید که با استفاده از آب من (که نماد معرفت و حقیقت است)، می‌تواند بینایی و بصیرت پیدا کند. در واقع، به او توصیه می‌شود که از این آب بهره‌برداری کند تا روشن‌بینی و درک بهتری پیدا کند."],[195,"هست دست راست اینجا ظن راست","کو بداند نیک و بد را کز کجاست","دست راست در اینجا به معنی قدرت و تسلط است که می‌تواند تفاوت‌های نیک و بد را بفهمد و از کجا ناشی می‌شود. این دست به معنای شعور و درک است که باید به درستی عمل کند."],[195,"نیزه‌گردانی‌ست ای نیزه، که تو","راست می‌گردی گهی گاهی دوتو","این بیت به بیان تناقضات در شخصیت انسان می‌پردازد، زیرا انسان‌ها مانند نیزه‌ای هستند که گاهی در مسیر درست و گاهی در مسیر نادرست حرکت می‌کنند. به این معنا که انسان‌ها زمانی خوب و زمانی بد عمل می‌کنند و دچار تغییر و تزلزل می‌شوند."],[195,"ما ز عشق شمس دین بی‌ناخنیم","ورنه ما آن کور را بینا کنیم","ما به عشق شمس‌الدین (شمس تبریزی) چنان وابسته‌ایم که انگار بی‌دست و ناخن هستیم، اما اگر بخواهیم، می‌توانیم آن کور را بینا کنیم."],[195,"هان ضیاء الحق حسام الدین تو زود","داروش کن کوری چشم حسود","هان، ای نور الحق حسام‌الدین، تو هر چه زودتر داروش کن، که کوری حسودان را علاج کند."],[195,"توتیای کبریای تیزفعل","داروی ظلمت‌کش استیزفعل","توتیای کبریا (یک نوع دارو) خاصیت خارق‌العاده‌ای دارد و دارای توانایی از بین بردن ظلمت و تاریکی است. این دارو می‌تواند جان را از بیماری و حسادت نجات دهد."],[195,"آنک گر بر چشم اعمی برزند","ظلمت صد ساله را زو برکند","اگر کسی در چشمان فردی نابینا، نور را به وجود آورد، می‌تواند تمام تاریکی‌های بی‌پایان را از آنجا بزداید."],[195,"جمله کوران را دوا کن جز حسود","کز حسودی بر تو می‌آرد جحود","تمام نابینایان را درمان کن، جز حسود که به خاطر حسادتش بر تو کفر و انکار می‌ورزد."],[195,"مر حسودت را اگر چه آن منم","جان مده تا همچنین جان می‌کنم","اگرچه من نیز حسود تو هستم، اما جان خود را فدای او نکن، زیرا من نیز جان تو را می‌گیرم."],[195,"آنک او باشد حسود آفتاب","وانک می‌رنجد ز بود آفتاب","حسود مانند آفتاب است که باعث روشنایی و زندگی می‌شود، اما اگر کسی از وجود او ناراحت شود، خود را از نور و گرمای او محروم می‌کند."],[195,"اینت درد بی‌دوا کاو راست آه","اینت افتاده ابد در قعر چاه","این درد بی‌دوا، کسی را آزار می‌دهد که همیشه در رنج و عذاب است و به عمق مصیبت خزیده است."],[195,"نفی خورشید ازل بایست او","کی برآید این مراد او بگو","این بیت به بیان این مسئله می‌پردازد که وجود خورشید ازلی، یعنی وجود خدا، همیشه باید باقی بماند و هیچ‌کس نمی‌تواند از آن بکاهد. در واقع، هر کس باید از آن وجود بزرگ آگاه باشد و به دنبال شناخت آن برآید."],[195,"باز آن باشد که باز آید به شاه","باز کور است آنک شد گم‌کرده راه","اگر بازگشت دوباره‌ای به شاه وجود داشته باشد، این نشان می‌دهد که پرنده‌ای که کور شده و راه را گم کرده، دوباره به سر منزل مقصود خود خواهد رسید."],[195,"راه را گم کرد و در ویران فتاد","باز در ویران بر جغدان فتاد","آن شخص راه را گم کرده و به ویرانه‌ای افتاده، دوباره در همان ویرانه به جغدها برخورد کرده است."],[195,"او همه نور است از نور رضا","لیک کورش کرد سرهنگ قضا","او (خداوند) همه‌اش نور و روشنایی است که از راضی بودن (همه‌چیز) ناشی می‌شود، ولی سرهنگ قضا (سرنوشت) او را نابینا کرده است."],[195,"خاک در چشمش زد و از راه برد","در میان جغد و ویرانش سپرد","کور او را فریب داد و در مسیری نادرست هدایتش کرد و در بین جغدها (نماد فساد و تاریکی) و در خرابه‌ها (نماد ویرانی) رهایش کرد."],[195,"بر سری جغدانش بر سر می‌زنند","پرّ و بال نازنینش می‌کنند","بر سر جغدها با ضربه‌هایی می‌زنند و بال‌های زیبا و لطیف او را از بدنش جدا می‌کنند."],[195,"ولوله افتاد در جغدان که ها","باز آمد تا بگیرد جای ما","هرج و مرج و شلوغی در میان جغدان (طوطی‌ها) به وجود آمد زیرا ها (پرندگان دیگر) برگشتند تا جای ما را بگیرند."],[195,"چون سگان کوی پر خشم و مهیب","اندر افتادند در دلق غریب","گروهی از سگان، که در کوی زندگی می‌کنند، با خشونت و وحشت به این دلق عجیب (غریب) حمله کرده‌اند."],[195,"باز گوید من چه در خوردم به جغد","صد چنین ویران فدا کردم به جغد","گفتن به جغد (پرنده‌ای که به عنوان نماد بی‌خبر بودن یا بد یمنی شناخته می‌شود) نشان می‌دهد که من به خاطر یک چنین بی‌خبری و ویرانی، نسبت به جغد فدای این وضعیت شده‌ام و از خودم می‌پرسم که چه بر سر من آمده است."],[195,"من نخواهم بود اینجا می‌روم","سوی شاهنشاه راجع می‌شوم","من در اینجا نمی‌خواهم بمانم و به سوی شاهنشاه می‌روم تا درباره خودم صحبت کنم."],[195,"خویشتن مکشید ای جغدان که من","نه مقیمم می‌روم سوی وطن","ای جغدها، خودتان را عذاب ندهید و خود را نمی‌کشید، چرا که من در اینجا نمی‌مانم و قصد دارم به وطن خود بروم."],[195,"این خراب آباد در چشم شماست","ورنه ما را ساعد شه ناز جاست","این ویرانی که در نظر شماست، تنها در نگاه شما خراب به نظر می‌آید، در حالی که ما نزد شاه، مقام و جایگاه ناز و ارزنده‌ای داریم."],[195,"جغد گفتا باز حیلت می‌کند","تا ز خان و مان شما را بر کند","جغد می‌گوید که باز هم در حال نقشه‌کشی است تا شما را از خانه و جا و مکان خود بیرون کند."],[195,"خانه‌های ما بگیرد او به مکر","برکند ما را به سالوسی ز وکر","او با نیرنگ و تزویر، خانه‌های ما را می‌گیرد و ما را به دورویی و فریب از وطن‌مان بیرون می‌کند."],[195,"می‌نماید سیری این حیلت‌پرست","والله از جمله حریصان بدترست","این حیلت‌پرست، که خود را سیر نشان می‌دهد، از دیگر حریصان بدتر است، زیرا در حقیقت به دنبال بهره‌برداری و سوءاستفاده است."],[195,"او خورد از حرص طین را همچو دبس","دنبه مسپارید ای یاران به خرس","او از حرص و شکم‌چرانی مانند دبس (عسل غلیظ) حرص می‌زند و به مانند دنبه (چربی) که به خرس می‌دهند، به او طعمه‌ای ندهید."],[195,"لاف از شه می‌زند وز دست شه","تا برد او ما سلیمان را ز ره","این بیت به این معناست که افرادی که از مقام و اعتبار شاه سخن می‌گویند و به او افتخار می‌کنند، در واقع می‌خواهند خود را از نظر اجتماعی بالا ببرند. اما اگر این افراد به دست شاه وابسته شوند، خود را از راه دور، به سلیمان، پیامبر بزرگ که نماد حکمت و قدرت است، نزدیک می‌کنند."],[195,"خود چه جنس شاه باشد مرغکی","مشنوش گر عقل داری اندکی","اگر خودت هم از نظر ارزش به اندازه شاه باشی، مثل یک پرنده کوچک مشو. اگر کمی عقل داشته باشی، این را درک خواهی کرد."],[195,"جنس شاهست او و یا جنس وزیر","هیچ باشد لایق گوزینه سیر","او (شاه) از جنس و طبقه خود (شخصیت برجسته) است، و یا جنس وزیر (که مقام پایین‌تری دارد) هیچ‌گاه نمی‌تواند لایق مقام و رتبه بزرگ و معتبر باشد."],[195,"آنچ می‌گوید ز مکر و فعل و فن","هست سلطان با حشم جویای من","آنچه او (سلطان) درباره مکر، کارها و فنون می‌گوید، نتیجه‌اش این است که او در جستجوی من (غلام خاص) است و به دنبال منافع و نتایج آن می‌باشد."],[195,"اینت مالیخولیای ناپذیر","اینت لاف خام و دام گول‌گیر","این نوع غم و افسردگی غیرقابل فرار است. این ادعاهای بزرگ و توخالی، تنها فریبی است که انسان را در دام خود گرفتار می‌کند."],[195,"هر که این باور کند از ابلهیست","مرغک لاغر چه درخورد شهیست","هر کس این باور را داشته باشد، ابله است که تصور کند مرغ لاغر (که نماد ضعیف‌ترین موجودات است) چه چیزی می‌تواند در خور یک پادشاه (که نماد قدرت و عظمت است) باشد."],[195,"کمترین جغد ار زند بر مغز او","مر ورا یاری‌گری از شاه کو","اگر کمترین جغدی بر مغز او بنشیند، آن شخص دیگر نمی‌تواند یاری‌رسانی کند از جانب شاه."],[195,"گفت باز ار یک پر من بشکند","بیخ جغدستان شهنشه بر کند","اگر پر من شکسته شود، باز هم شاه من، که در جغدستان است، مرا نمی‌کاهد و برتری‌ام را از بین نمی‌برد."],[195,"جغد چه بود خود اگر بازی مرا","دل برنجاند کند با من جفا","اگر جغد چه فرقی می‌کند، دلم را با بازی‌اش می‌آزارد و با من بدی می‌کند."],[195,"شه کند توده به هر شیب و فراز","صد هزاران خرمن از سرهای باز","سلطان (شه) در هر بلندی و پستی (شیب و فراز) برای خود توده‌ای (جمعی) آماده می‌کند و از سرهای بی‌خبر و ناآگاه (سرهای باز) هزاران خرمن (خزانه) انباشت می‌کند. در اینجا به این نکته اشاره می‌شود که افراد جاهل و ناآگاه، به راحتی در دام قدرت‌طلبی و خودخواهی می‌افتند."],[195,"پاسبان من عنایات ویست","هر کجا که من روم شه در پیست","خدمتگزار من، در هر کجا که بروم، توجه و مهر سلطان همراه من است."],[195,"در دل سلطان خیال من مقیم","بی خیال من دل سلطان سقیم","در دل سلطان، خیال من ساکن است، و در عین حال، او به من بی‌توجهی می‌کند؛ زیرا دل سلطان بیمار و ناتوان است."],[195,"چون بپراند مرا شه در روش","می‌پرم بر اوج دل چون پرتوش","وقتی که پادشاه (سلطان) مرا به اوج محبتی برساند، مانند نوری که از دل او می‌تابد، به اوج دل می‌رسم و پرواز می‌کنم."],[195,"همچو ماه و آفتابی می‌پرم","پرده‌های آسمانها می‌درم","من همچون ماه و آفتاب از مرزهای محدودیت‌ها عبور می‌کنم و پرده‌های آسمان را می‌شکافم."],[195,"روشنی عقلها از فکرتم","انفطار آسمان از فطرتم","روشنی عقل‌ها از اندیشه من به وجود آمده و انفجار آسمان بر اثر ذات و خاستگاه من است."],[195,"بازم و حیران شود در من هما","جغد کی بود تا بداند سر ما","شخصی حیران و شگفت‌زده می‌شود که این جغد (پرنده‌ای که نماد شب و تاریکی است) کی بوده و چه کسی می‌تواند سرنوشت ما را بداند."],[195,"شه برای من ز زندان یاد کرد","صد هزاران بسته را آزاد کرد","سلطان به یاد من که در زندان هستم، هزاران نفر که در بند هستند را آزاد کرد."],[195,"یک دمم با جغدها دمساز کرد","از دم من جغدها را باز کرد","ساعتی من با جغدها هم‌نشینی کردم و از نفس من جغدها آزاد شدند."],[195,"ای خنک جغدی که در پرواز من","فهم کرد از نیکبختی راز من","ای جغد خوش‌اقبال که در پرواز من توانسته‌ای راز خوشبختی‌ام را دریابی."],[195,"در من آویزید تا نازان شوید","گرچه جغدانید شهبازان شوید","در من بیفتید و به من نزدیک شوید تا به بزرگی و ارزش برسید، هرچند ممکن است شما در اصل از نوع جغد (جانوری که سمبل شب و تاریکی است) باشید، اما می‌توانید همچون شهبازان (پرندگان شکاری و با شکوه) تبدیل شوید."],[195,"آنک باشد با چنان شاهی حبیب","هر کجا افتد چرا باشد غریب","کسی که با چنین پادشاهی دوست است، چرا در هر جایی که برود، باید احساس تنهایی و غربت کند؟"],[195,"هر که باشد شاه دردش را دوا","گر چو نی نالد نباشد بی نوا","هر کس که شاه باشد، درد او را درمان می‌کند، اما اگر نی (ساز نی) نالیده نداشته باشد، مظلوم و بی‌صدا می‌ماند."],[195,"مالک ملک نیم من طبل‌خوار","طبل بازم می‌زند شه از کنار","من مالک این سرزمین نیستم، زیرا طبل‌زن من هستم؛ یعنی، من فقط صدای طبل را می‌زنم و خودم ثابت نیستم، بلکه شاه از کنار من عبور می‌کند."],[195,"طبل باز من ندای ارجعی","حق گواه من به رغم مدعی","من، که سازنده طبل‌ام، صدای من به‌طور واضح و روشن حقایق را بیان می‌کند و شهادت می‌دهد که من از ادعای دیگران برتر هستم."],[195,"من نیم جنس شهنشه دور ازو","لیک دارم در تجلی نور ازو","من از جنس شاهان نیستم و از آن‌ها دورم، اما نور و روشنایی را از او دارم و به واسطه او درخشان می‌شوم."],[195,"نیست جنسیت ز روی شکل و ذات","آب جنس خاک آمد در نبات","ماهیت چیزها به شکل و ظاهر آن‌ها بستگی ندارد. آب، که به ظاهر مایع است، می‌تواند به دلیل ترکیبات خود در گیاهان به شکل خاکی ظاهر شود و نشان دهد که واقعیت آن چیزی فراتر از ظاهر است."],[195,"باد جنس آتش آمد در قوام","طبع را جنس آمدست آخر مدام","جنس باد مشابه آتش است و این نکتة مهمی در طبیعت انسان‌ها و ویژگی‌های آن‌هاست که در نهایت ویژگی‌های اصلی خود را نشان می‌دهند."],[195,"جنس ما چون نیست جنس شاه ما","مای ما شد بهر مای او فنا","آنچه ما هستیم با آنچه شاه ما هست، متفاوت است و وجود ما برای او محو و نابود می‌شود."],[195,"چون فنا شد مای ما او ماند فرد","پیش پای اسپ او گردم چو گرد","زمانی که ما به فنا و نابودی رفتیم، او (شاه) به تنهایی باقی می‌ماند و من هم مانند غباری هستم که در پیش پای اسب او پراکنده می‌شود."],[195,"خاک شد جان و نشانیهای او","هست بر خاکش نشان پای او","جان انسان فنا می‌شود و تنها نشانه‌های او، مانند آثار و رفتارهایش، بر زمین باقی می‌ماند که نشان‌دهنده وجود او هستند."],[195,"خاک پایش شو برای این نشان","تا شوی تاج سر گردن‌کشان","برای اینکه نشان پای او را ببینی و به مقام والایی دست یابی، باید خود را مانند خاکی که زیر پای اوست، humble (خاکی و متواضع) کنی تا به مقام و اهمیت برتری در نظر دیگران برسی."],[195,"تا که نفریبد شما را شکل من","نقل من نوشید پیش از نقل من","مراقب باشید که ظاهر من شما را فریب ندهد؛ زیرا روح و باطن من (که حقیقت من است) پیش از این ظاهر شده و نوشیده شده است."],[195,"ای بسا کس را که صورت راه زد","قصد صورت کرد و بر الله زد","گاهی پیش می‌آید که انسان‌ها فقط به ظاهر و شکل ظاهری چیزی توجه می‌کنند و به عمق یا ذات آن نمی‌نگرند و در این مسیر ممکن است به هدف واقعی خود پی نبرند."],[195,"آخر این جان با بدن پیوسته است","هیچ این جان با بدن مانند هست","این جان (روح) به جسم (بدن) متصل و وابسته است و به هیچ وجه نمی‌توان این جان را با بدن یکی دانست."],[195,"تاب نور چشم با پیهست جفت","نور دل در قطره خونی نهفت","نور چشم به رنگ و لعاب دنیوی مرتبط است و در حقیقت به اوج زیبایی و جذابیت اشاره دارد، در حالی که نور دل به عمق احساسات و حقیقت وجود بازمی‌گردد که در عمق وجود انسان، مانند قطره‌ای خون پنهان شده است."],[195,"شادی اندر گرده و غم در جگر","عقل چون شمعی درون مغز سر","شادی در دلم و غم در وجودم همچون نیروی عقل که مانند شمعی در سرم می‌سوزد و روشنایی می‌دهد."],[195,"این تعلقها نه بی کیفست و چون","عقلها در دانش چونی زبون","این وابستگی‌ها به هیچ‌وجه خوشایند نیست و وقتی عقل‌ها در دانش ضعیف و بی‌ثمر باشند، به حالت ذلت درمی‌آیند."],[195,"جان کل با جان جزو آسیب کرد","جان ازو درّی ستد در جیب کرد","جان جامع و کامل با جان جزئی آسیب می‌زند و از این آسیب، جان در جیب خود مرواریدی به دست می‌آورد."],[195,"همچو مریم، جان از آن آسیب جیب","حامله شد از مسیح دلفریب","جان همچون مریم، از آسیب (محبت) به جیب (دل) پذیرایی کرد و به سبب مسیح دلفریب (به خاطر جمال و زیبایی او) حامله شد."],[195,"آن مسیحی نه که بر خشک و ترست","آن مسیحی کز مساحت برترست","این مسیحی که گفته شده، تنها به چیزهای مادی و ظاهری نمی‌نگرد، بلکه مسیحیت او از نظر روحانی و معنوی فراتر از این مسائل است. او به حقیقت و عمق وجود انسان‌ها توجه دارد و فراتر از مشخصات ظاهری زندگی می‌کند."],[195,"پس ز جان جان چو حامل گشت جان","از چنین جانی شود حامل جهان","وقتی جان، حامل جان دیگر شود، به این معناست که از طریق آن جان اصلی، وجودی بزرگتر و جهانی وسیع‌تر به وجود می‌آید. در واقع، این اشاره به انتقال و گسترش وجود و معنا دارد."],[195,"پس جهان زاید جهانی دیگری","این حشر را وا نماید محشری","جهان جدیدی از جهان قدیم به وجود می‌آید و این هجوم و جمع شدن مردم در قیامت را به تصویر می‌کشد."],[195,"تا قیامت گر بگویم بشمرم","من ز شرح این قیامت قاصرم","حتی اگر تا قیامت درباره این قیامت صحبت کنم و بخواهم آن را توضیح دهم، در بیان و شرح آن ناتوان و نارسایم."],[195,"این سخنها خود به معنی یا ربیست","حرفها دام دم شیرین‌لبیست","این عبارت‌ها خود به معنای «ای پروردگار» است و این کلمات مانند دام و تله‌ای هستند که برای شیرین زبانی و خوش‌صحبتی می‌افتند."],[195,"چون کند تقصیر پس چون تن زند","چونک لبیکش به یارب می‌رسد","اگر کسی که تقصیر می‌کند، بخواهد خود را نجات دهد، باید توجه داشته باشد که صدای «یارب» او به خدا می‌رسد."],[195,"هست لبیکی که نتوانی شنید","لیک سر تا پای بتوانی چشید","بعضی از لبیک‌هایی که توصیف نمی‌شوند و قابل شنیدن نیستند، اما می‌توانی از وجود و تأثیر آنها به خوبی آگاه شوی و احساسشان کنی."],[196,"بر لب جو بوده دیواری بلند","بر سر دیوار تشنه دردمند","در کناره جوی آب، دیواری بلند وجود دارد که این دیوار باعث شده فردی دردمند و تشنه نتواند به آب دسترسی پیدا کند."],[196,"مانعش از آب آن دیوار بود","از پی آب او چو ماهی زار بود","دیواری که بر سر جوی آب قرار دارد، مانع رسیدن تشنه دردمند به آب شده است. او مانند ماهی که از آب دور باشد، به شدت در آرزوی آب است و حالتی زار و نزار دارد."],[196,"ناگهان انداخت او خشتی در آب","بانگ آب آمد به گوشش چون خطاب","ناگهان او یک تکه خشت (کلوخ) را به داخل آب انداخت و صدای آب به گوشش رسید، مانند اینکه صدای کسی به او خطاب کرد."],[196,"چون خطاب یار شیرین لذیذ","مست کرد آن بانگ آبش چون نبیذ","صدای آب برای او مانند گفتار معشوق است که لذتی شیرین و خوشایند دارد و او را مست کرده است، گویی مانند نبیذ (شرابی که از خرما یا مویز تهیه می‌شود) او را تحت تأثیر قرار داده است."],[196,"از صفای بانگ آب آن ممتحن","گشت خشت‌انداز از آنجا خشت‌کن","صدای خوش آب باعث شد که آن شخصی که امتحان می‌کند، از شوق و خوشحالی، به جای پرتاب کردن خشت، به جمع‌آوری خشت بپردازد."],[196,"آب می‌زد بانگ یعنی هی ترا","فایده چه زین زدن خشتی مرا","تشنه به نشانه اعتراض می‌گوید که صدای آب هیچ فایده‌ای برای او ندارد و او از این زدن خشت (و کارهای دیگر) چیزی به دست نخواهد آورد."],[196,"تشنه گفت آبا مرا دو فایده‌ست","من ازین صنعت ندارم هیچ دست","تشنه می‌گوید که من دو فایده از این کار می‌بینم، اما از این هنر (یعنی نشستن و انتظار کشیدن برای آب) هیچ بهره‌ای ندارم."],[196,"فایده اول سماع بانگ آب","کو بود مر تشنگان را چون رباب","سماع یا آواز آب برای تشنگان همانند صدای ساز رباب است که به آن‌ها امید و شوق می‌دهد."],[196,"بانگ او چون بانگ اسرافیل شد","مرده را زین زندگی تحویل شد","صدای او (صدای آب) مانند صدای اسرافیل است که وقتی به مرده شنیده می‌شود، باعث می‌شود او از زندگی جدیدی برخوردار شود."],[196,"یا چو بانگ رعد ایام بهار","باغ می‌یابد ازو چندین نگار","صدای او مانند صدای رعد در زمان بهار است که باعث می‌شود باغ از وجود چندین گل و نقش زیبا پر شود."],[196,"یا چو بر درویش ایام زکات","یا چو بر محبوس پیغام نجات","یا مانند درویشی که زمان زکات (انفاق واجب) می‌رسد، یا مانند زندانی که پیغام نجات به او می‌رسد."],[196,"چون دم رحمان بود کان از یمن","می‌رسد سوی محمد بی دهن","وقتی که نفس رحمت الهی به سمت محمد می‌آید، بدون هیچ گفتگویی و به طور مستقیم تأثیر خود را می‌گذارد."],[196,"یا چو بوی احمد مرسل بود","کان به عاصی در شفاعت می‌رسد","مانند بوی خوش احمد (پیامبر)، این شفاعت به گنهکاران (عاصیان) نیز می‌رسد و آنها را مورد رحمت قرار می‌دهد."],[196,"یا چو بوی یوسف خوب لطیف","می‌زند بر جان یعقوب نحیف","همچون بوی خوش و لطیف یوسف، که بر روح یعقوب نزار و نحیف تأثیر می‌گذارد و او را شاداب می‌کند."],[196,"فایده دیگر که هر خشتی کزین","بر کنم آیم سوی ماء معین","هر خشت که از دیوار برداشته می‌شود، فایده‌ای که دارد این است که به سمت آب زلال می‌روم."],[196,"کز کمی خشت دیوار بلند","پست‌تر گردد به هر دفعه که کند","دیوار بلند به خاطر کم شدن هر خشت، پایین‌تر می‌آید و هر بار که خشت از آن برداشته شود، ارتفاع آن کاهش می‌یابد."],[196,"پستی دیوار قربی می‌شود","فصل او درمان وصلی می‌بود","هر بار که دیوار کم‌ارتفاع‌تر می‌شود، نزدیک شدن به هدف و وصل شدن به معشوق آسان‌تر می‌گردد."],[196,"سجده آمد کندن خشت لزب","موجب قربی که واسجد واقترب","سجده به معنای عبادت و راز و نیایش است، و در اینجا اشاره به آن دارد که برای رسیدن به نزدیکی و قرب خداوند، باید از مشکلات و موانع عبور کرد. به عبارت دیگر، از بین بردن موانع (مثل کندن خشت) و سجده کردن به این معناست که باید به تلاش و کوشش برای نزدیک شدن به خداوند توجه شود."],[196,"تا که این دیوار، عالی‌گردنست","مانع این سر فرود آوردنست","این دیوار که بلند و محکم است، مانع از این می‌شود که سر فرود آورده شود و سجده شود. در واقع، موانع فیزیکی و معنوی باعث ناتوانی در دستیابی به مقام‌های بالا و بزرگ می‌شوند."],[196,"سجده نتوان کرد بر آب حیات","تا نیابم زین تن خاکی نجات","برای رسیدن به آب حیات و زندگی جاودان، نمی‌توان سجده و خضوع کرد، تا زمانی که از این جسم خاکی که مانع شده، رهایی نیابم."],[196,"بر سر دیوار هر کو تشنه‌تر","زودتر بر می‌کند خشت و مدر","هر کسی که بیشتر تشنه باشد، سریع‌تر خشت و مدر (آجر و ملات) را از روی دیوار برمی‌دارد تا به آب برسد."],[196,"هر که عاشقتر بود بر بانگ آب","او کلوخ زفت‌تر کند از حجاب","هر کسی که در عشق بیشتر باشد، برای رسیدن به صدای آب، تلاش و کوشش بیشتری می‌کند و از موانع (حجاب‌ها) با شدت بیشتری عبور می‌کند."],[196,"او ز بانگ آب پر می تا عنق","نشنود بیگانه جز بانگ بلق","کسی که از صدای آب سیراب می‌شود، تا گردن نمی‌تواند صدا را بشنود، هیچ‌کس جز صدای «بلق» (صدای مزاحم) را نخواهد شنید."],[196,"ای خنک آن را که او ایام پیش","مغتنم دارد گزارد وام خویش","خوشا به حال کسی که در زمان‌های گذشته، فرصت‌ها را غنیمت شمرده و بدهی‌های خود را پرداخت کرده است."],[196,"اندر آن ایام کش قدرت بود","صحت و زور دل و قوت بود","در آن زمان، قدرت و سلامت و توانمندی در دل و قوت وجود داشت."],[196,"وان جوانی همچو باغ سبز و تر","می‌رساند بی دریغی بار و بر","آن جوانی مانند باغی سرسبز و شاداب است که بدون هیچ‌گونه چشم‌داشتی، میوه و بهره به دیگران می‌دهد."],[196,"چشمه‌های قوت و شهوت روان","سبز می‌گردد زمین تن بدان","در اینجا به بیان اثرات مثبت و سرزنده‌کنندگی نیازها و خواسته‌های انسانی اشاره شده است. نیروی حیات و اشتیاق به زندگی، زمین وجود انسان را سرسبز و بارور می‌کند."],[196,"خانه معمور و سقفش بس بلند","معتدل ارکان و بی تخلیط و بند","خانه‌ای پر رونق و با سقفی بلند که ستون‌هایش متناسب و با هم هماهنگ هستند و در آن هیچ اختلالی وجود ندارد."],[196,"پیش از آن کایام پیری در رسد","گردنت بندد به حبل من مسد","پیش از آنکه دوران پیری به تو برسد، گردن‌ات را به ریسمانی از محبت من ببند."],[196,"خاک شوره گردد و ریزان و سست","هرگز از شوره نبات خوش نرست","خاک شوره و خشک و سست شده، هرگز نمی‌تواند گیاه خوبی را رشد دهد. در واقع، شرایط نامساعد باعث می‌شود که زندگی و رشد به درستی انجام نشود."],[196,"آب زور و آب شهوت منقطع","او ز خویش و دیگران نا منتفع","آب قدرت و تمایل جنسی او به دلیل خودخواهی و تعلقاتش به خودش و دیگران قطع شده است و از این رو هیچ بهره‌ای نمی‌برد."],[196,"ابروان چون پالدم زیر آمده","چشم را نم آمده تاری شده","چشم‌ها به دلیل غم و اندوه به حالت تیره و تار درآمده و ابروهای او نیز در اثر این حالت پایین آمده است."],[196,"از تشنج رو چو پشت سوسمار","رفته نطق و طعم و دندانها ز کار","به خاطر تنش و اضطراب، چهره‌اش مانند پشت سوسمار شده و دیگر توان صحبت کردن، لذت بردن از طعم‌ها و داشتن دندان‌های سالم را ندارد."],[196,"روز بیگه، لاشه لنگ و ره دراز","کارگه ویران عمل رفته ز ساز","در روز روشن، با بدنی خسته و سفر طولانی، نتیجه کار خراب و بی‌خاصیت شده است و دیگر ساز و کاری برای ادامه آن وجود ندارد."],[196,"بیخهای خوی بد محکم شده","قوت بر کندن آن کم شده","ریشه‌های بدی که در وجود انسان وجود دارد، به شدت محکم شده و به همین دلیل قدرت از بین بردن آن‌ها کم شده است."],[197,"همچو آن شخص درشت خوش‌سخن","در میان ره نشاند او خاربن","شخصی درشت‌هیکل و خوش‌زبان را مانند آن مرد خاربن (علف‌های خاردار) در وسط راه قرار دادند."],[197,"ره گذریانش ملامت‌گر شدند","پس بگفتندش بکن این را نکند","رهگذران از کار آن مرد که خاربن را بر سر راه گذاشته، او را سرزنش کردند و گفتند که باید این کار را متوقف کند."],[197,"هر دمی آن خاربن افزون شدی","پای خلق از زخم آن پر خون شدی","هر لحظه آن خار، بیشتر رشد کرد و پای مردم به خاطر زخم آن، به شدت خونین شد."],[197,"جامه‌های خلق بدریدی ز خار","پای درویشان بخستی زار زار","تو به خاطر خارهایی که در پای درویشان وجود دارد، لباس‌های مردم را پاره کردی و آنها را به شدت نالان و گریان کرده‌ای."],[197,"چون به جد حاکم بدو گفت این بکن","گفت آری بر کنم روزیش من","حاکم به آن مرد گفت که این خاری را که در راه مانده، برکن. او پاسخ داد که آری، این کار را انجام می‌دهم و روزی‌ام را به این وسیله تأمین می‌کنم."],[197,"مدتی فردا و فردا وعده داد","شد درخت خار او محکم نهاد","مدتی شخصی برای روزهای آینده وعده داد و در نتیجه درخت خاری که او کاشته بود، به شدت و استحکام ریشه دواند."],[197,"گفت روزی حاکمش ای وعده کژ","پیش آ در کار ما واپس مغژ","حاکم روزی به مرد گفت: وعده تو درست نیست، حالا بیا و در کار ما، عقب‌نشینی کن و به تأخیر نینداز."],[197,"گفت الایام یا عم بیننا","گفت عجل لا تماطل دیننا","مردی به نام «عمّ» از زمان شکایت می‌کند و می‌گوید که روزها به سرعت می‌گذرند. او پاسخ می‌دهد که باید زودتر عمل کنیم و نباید در انجام دین و مسئولیت‌هایمان تأخیر کنیم."],[197,"تو که می‌گویی که فردا این بدان","که به هر روزی که می‌آید زمان","تو که می‌گویی فردا این کار انجام می‌شود، بدان که با هر روزی که می‌گذرد، زمان نیز پیش می‌رود و ممکن است کارها به تاخیر بیفتند."],[197,"آن درخت بد جوان‌تر می‌شود","وین کننده پیر و مضطر می‌شود","درخت بد، یعنی درخت خاری که به زودی جوان‌تر و سرزنده‌تر خواهد بود، در حالی که آن کسی که برای کندن آن تلاش می‌کند، در سن پیری ضعیف و درمانده می‌شود."],[197,"خاربن در قوت و برخاستن","خارکن در پیری و در کاستن","درخت «خاربن» (نوعی درخت خاردار) هر روز قوی‌تر می‌شود و رشد می‌کند، اما «خارکن» (کسی که خارها را می‌کند) با گذشت زمان پیر می‌شود و ضعیف‌تر می‌گردد."],[197,"خاربن هر روز و هر دم سبز و تر","خارکن هر روز زار و خشک تر","خارهای خاربن همیشه جوان و شاداب هستند، در حالی که خارکن، که وظیفه بریدن آن‌ها را دارد، هر روز ضعیف‌تر و پژمرده‌تر می‌شود."],[197,"او جوان‌تر می‌شود تو پیرتر","زود باش و روزگار خود مبر","اگر او هر روز جوان‌تر می‌شود، تو به سرعت پیرتر می‌شوی. پس احتیاط کن و وقت خود را هدر نده."],[197,"خاربن دان هر یکی خوی بدت","بارها در پای خار آخر زدت","خاربن، درختچه‌های خاردار هستند. هر یک از این خاری‌ها به‌مثابه‌ی رفتارهای بد توست که بارها باعث آسیب به تو شده‌اند، درست مانند اینکه پای هر بار که به این خارها برخورد کرده‌ای، زخم خورده‌ای."],[197,"بارها از خوی خود خسته شدی","حس نداری سخت بی‌حس آمدی","بارها به خاطر رفتار بد خود خسته و دل‌زده شدی، ولی حالا حس و درک این خستگی را نداری و به‌طور جدی بی‌احساس شده‌ای."],[197,"گر ز خسته گشتن دیگر کسان","که ز خلق زشت تو هست آن رسان","اگر دیگران از خستگی و ناراحتی رنج می‌برند، این نشانه بدخوئی و خصوصیات زشت توست که به آن‌ها منتقل می‌شود."],[197,"غافلی باری ز زخم خود نه‌ای","تو عذاب خویش و هر بیگانه‌ای","تو از زخم‌های خود غافلی و بی‌خبر هستی و نمی‌دانی که خودت باعث عذاب خودت هستی، نه دیگران."],[197,"یا تبر بر گیر و مردانه بزن","تو علی‌وار این در خیبر بکن","با قدرت و شجاعت، مانند علی که در دروازه خیبر با چلابی که در دست داشت، دشمنان را به زانو درآورد، این خار را قطع کن."],[197,"یا به گلبن وصل کن این خار را","وصل کن با نار نور یار را","به روشنی می‌گوید یا این خاری را که در مسیر قرار دارد، به باغ گل وصل کن و یا این که با نور محبت یار، آتش درد و رنج را خاموش کن."],[197,"تا که نور او کشد نار تو را","وصل او گلشن کند خار تو را","اگر نور او (یعنی خدا یا حقیقت) تو را من extinguish کند، آنگاه اتصال او تو را به گلستان (رنگین و زیبا) می‌برد و خار (مشکلات و رنج‌ها) را از زندگی‌ات پاک می‌کند."],[197,"تو مثال دوزخی او مؤمنست","کشتن آتش به مؤمن ممکنست","شخصی که مانند دوزخ است، در واقع مؤمن است؛ زیرا می‌تواند آتش را بکشد و به مؤمن آسیب برساند."],[197,"مصطفی فرمود از گفت جحیم","کو به مؤمن لابه‌گر گردد ز بیم","مصطفی، پیامبر اسلام، فرمود که جهنم نمی‌تواند مؤمنی را که از ترس عذابش به او دعا می‌کند، مورد آزار قرار دهد."],[197,"گویدش بگذر ز من ای شاه زود","هین که نورت سوز نارم را ربود","به او می‌گوید، ای پادشاه، سریع از من بگذر که روشنایی تو آتش درونم را خاموش کرده است."],[197,"پس هلاک نار، نور مؤمنست","زانک بی ضد دفع ضد لا یمکنست","به دنبال نابودی آتش، نور مؤمن برقرار است زیرا بدون وجود چیزهای متضاد، نمی‌توان ضد را دفع کرد."],[197,"نار ضد نور باشد روز عدل","کان ز قهر انگیخته شد این ز فضل","آتش (نار) در روز قیامت که روز داد وJustice است، با نور (فضل) مؤمنان و رحمت الهی مقابله می‌کند، زیرا این آتش به دلیل قهر و غضب خدا ایجاد شده است."],[197,"گر همی خواهی تو دفع شر نار","آب رحمت بر دل آتش گمار","اگر می‌خواهی شر آتش را دور کنی، باید آب رحمت را بر دل آتش بریزی."],[197,"چشمه آن آب رحمت مؤمنست","آب حیوان روح پاک محسنست","چشمه آب رحمت که به آن اشاره شده، به مؤمنان اختصاص دارد و آب حیوان، که به معنای آب حیات است، روح پاک افراد نیکوکار را زنده و تازه می‌کند."],[197,"بس گریزانست نفس تو ازو","زانک تو از آتشی او آب جو","نفس تو از آب رحمت و اصل حیات فراری است، زیرا تو از آتش دنیا به وجود آمده‌ای و آن آب، زندگی بخش است."],[197,"ز آب آتش زان گریزان می‌شود","کآتشش از آب ویران می‌شود","نفس انسان از آتش (گناه و شهوت) می‌گریزد، چون اگر به آب (پاکی و طهارت) نزدیک شود، آتش (خصایل زشت)‌اش در او نابود می‌شود."],[197,"حس و فکر تو همه از آتشست","حس شیخ و فکر او نور خوشست","احساس و تفکر تو تنها ناشی از آتش (تعصب و حرارت درونی) است، ولی احساس و اندیشه شیخ (شخصیت عارف یا حکیمی که در موردش صحبت می‌شود) همچون نوری خوش و روشن است."],[197,"آب نور او چو بر آتش چکد","چک چک از آتش بر آید برجهد","نور او مانند آبی است که بر آتش می‌ریزد؛ وقتی این آب بر آتش بریزد، بخار و دود از آن بلند می‌شود."],[197,"چون کند چک‌چک تو گویش مرگ و درد","تا شود این دوزخ نفس تو سرد","زمانی که تو به‌طور مکرر از مرگ و درد صحبت کنی، باعث می‌شوی که آتش نفس تو فروکش کند و این عذاب روانی برای تو کمتر شود."],[197,"تا نسوزد او گلستان ترا","تا نسوزد عدل و احسان ترا","تا زمانی که گلستان تو نسوزد، ادب و انصاف تو نیز از بین نمی‌رود."],[197,"بعد از آن چیزی که کاری بر دهد","لاله و نسرین و سیسنبر دهد","پس از آن، کاری پیش می‌آید که گل لاله و گل نسرین و دیگر گل‌ها را در جای خود قرار می‌دهد."],[197,"باز پهنا می‌رویم از راه راست","باز گرد ای خواجه راه ما کجاست","ما دوباره از مسیر درست منحرف می‌شویم و به راهی دیگر می‌رویم. ای آقاجان، کجاست مسیر صحیحی که باید برویم؟"],[197,"اندر آن تقریر بودیم ای حسود","که خرت لنگست و منزل دور زود","ما در آن بیان و گفتگو در مورد تو ای حسود، می‌گوییم که الاغ تو لنگ می‌زند و سفر کردنت به منزل دیرهنگام است."],[197,"سال بیگه گشت وقت کشت نی","جز سیه‌رویی و فعل زشت نی","زمان کشت نی (نی‌زار) به سر آمده و جز بدبختی و اعمال ناپسند چیزی نصیب ما نمی‌شود."],[197,"کرم در بیخ درخت تن فتاد","بایدش بر کند و در آتش نهاد","وقتی کرم در ریشه درختی نفوذ کند، باید آن درخت را برید و کرم را در آتش سوزاند تا جلوی خراب شدن درخت گرفته شود."],[197,"هین و هین ای راه‌رو بیگاه شد","آفتاب عمر سوی چاه شد","ای مسافر، آگاه شو! وقت گذشت و روز به پایان رسید و عمر تو رو به پایان است، همانند آفتابی که به سوی چاه می‌رود."],[197,"این دو روزک را که زورت هست زود","پیر افشانی بکن از راه جود","این دو روز کوتاه که هنوز جوانی و انرژی داری، قدر بدان و به دیگران بخشش کن، تا با جود و generosity خود از آنها بهره ببری."],[197,"این قدر تخمی که ماندستت بباز","تا بروید زین دو دم عمر دراز","به اندازه‌ای که از عمرت باقی مانده، از آن بهره ببر و آن را خرج کن تا زندگی‌ات به درازا بکشد و تو را بارور کند."],[197,"تا نمردست این چراغ با گهر","هین فتیلش ساز و روغن زودتر","تا زمانی که این چراغ با ارزش (معنای «چراغ با گهر» به معنی چراغی که با جواهرات زینت داده شده) خاموش نشده، فتیله‌اش را آماده کن و روغن را هم زودتر بیاور."],[197,"هین مگو فردا که فرداها گذشت","تا بکلی نگذرد ایام کشت","نظام زندگی و فرصت‌ها را هدر نده و نگویید که فردا انجام می‌دهم، زیرا روزهای آینده نیز به سرعت می‌گذرند و ممکن است زمان از دست برود. پس از همین حالا کارهای خود را انجام بدهید قبل از اینکه فرصت‌ها به طور کامل از بین بروند."],[197,"پند من بشنو که تن بند قویست","کهنه بیرون کن گرت میل نویست","به حرف‌های من گوش کن که تن (جسم) به طور طبیعی قوی و محکم است؛ اگر به کارهای جدید و نوین علاقه‌مندی، آنچه که کهنه و obsolete است را کنار بگذار."],[197,"لب ببند و کف پر زر بر گشا","بخل تن بگذار و پیش آور سخا","زبانت را بسته نگه‌دار و دستانت را پر از طلا کن. خودخواهی و بخل را کنار بگذار و سخاوت را در پیش بگیر."],[197,"ترک شهوتها و لذتها سخاست","هر که در شهوت فرو شد برنخاست","رها کردن خواسته‌ها و جاذبه‌های دنیوی، نشانه‌ی سخاوت است. کسی که در دام شهوت و لذت‌های دنیوی گرفتار شود، از این روح سخاوت محروم می‌ماند."],[197,"این سخا شاخیست از سرو بهشت","وای او کز کف چنین شاخی بهشت","این سخاوت، همانند شاخی از درختان بهشت است و وای بر کسی که از دست این شاخ و میوه‌های بهشت محروم بماند."],[197,"عروة الوثقاست این ترک هوا","برکشد این شاخ جان را بر سما","این نیروی معنوی، مانند دلیلی محکم و استوار، انسان را از وابستگی به خواسته‌های دنیوی آزاد می‌کند و روح او را به عالم بالا می‌برد."],[197,"تا برد شاخ سخا ای خوب‌کیش","مر ترا بالاکشان تا اصل خویش","ای خوب‌صورت، بگذار تا شاخ سخاوت را بردارند و تو را به اصل و ریشه‌ات برسانند، همان‌گونه که بالاکشان (بلند کردن) تو را به اوج می‌برند."],[197,"یوسف حسنی و این عالم چو چاه","وین رسن صبرست بر امر اله","یوسف (پیامبر) خوب و خوش‌سیماست و این دنیا مانند چاه عمیق می‌باشد، و صبر، مانند ریسمانی است که ما را به سمت اراده الهی هدایت می‌کند."],[197,"یوسفا آمد رسن در زن دو دست","از رسن غافل مشو بیگه شدست","یوسف (یوسف پیامبر) رسن (کودکی که به دو دست دوخته شده) را به نزد زنی آوردند. از این رسن غافل نشوید که او (رسن یا کودکی که به آن اشاره دارد) به خواب رفته است."],[197,"حمد لله کین رسن آویختند","فضل و رحمت را بهم آمیختند","خدا را شکر که این ریسمان (رسن) را به هم آویختند و فضل و رحمت را در هم ترکیب کردند."],[197,"تا ببینی عالم جان جدید","عالم بس آشکار ناپدید","تا زمانی که تو عالم جان جدید را ببینی، باید بدانی که این عالم ظاهری، به‌طور آشکار ناپدید است و حقیقتی پنهان دارد."],[197,"این جهان نیست چون هستان شده","وان جهان هست بس پنهان شده","این جهان مانند آن جهانی که وجود دارد، نیست؛ زیرا آن جهان هستی واقعی‌تری دارد که از دید ما پنهان است."],[197,"خاک بر بادست و بازی می‌کند","کژنمایی پرده‌سازی می‌کند","خاک بر باد است و با این حال در حال بازی است؛ یعنی واقعیت‌ها و ظواهر به گونه‌ای دیگر جلوه می‌کنند و دگرگون شده‌اند."],[197,"اینک بر کارست بی‌کارست و پوست","وانک پنهانست مغز و اصل اوست","اینک در این دنیا، ظاهر کارها بیهوده و بی‌فایده است و پوسته‌ای است که در واقع مغز و اصل وجود انسان در پس آن پنهان است."],[197,"خاک همچون آلتی در دست باد","باد را دان عالی و عالی‌نژاد","خاک مانند ابزاری در دست باد است، و باد را باید موجودی بزرگ و بلندمرتبه و بااصل و نسب دانست."],[197,"چشم خاکی را به خاک افتد نظر","بادبین چشمی بود نوعی دگر","چشم‌های خاکی و دنیوی نمی‌توانند به حقیقت و درک بالاتری که از آن با چشم‌های الهی و معنوی می‌توان دست یافت، پی ببرند. فقط با دید خاصی می‌توان به عمق ولایتی که برخاسته از معنویت است، نگریست."],[197,"اسپ داند اسپ را کو هست یار","هم سواری داند احوال سوار","اسب، چون یار خود را می‌شناسد، وضعیت سوارش را نیز می‌داند و از این رو با او هماهنگ است."],[197,"چشم حس اسپست و نور حق سوار","بی‌سواره اسپ خود ناید به کار","چشم حسی مانند اسپ است که فقط به ظاهر و دنیای مادی نگاه می‌کند، اما نور حقیقت مانند سوار بر این اسپ است که بدون وجود سوار، اسپ به کار نمی‌آید. این نشان می‌دهد که فهم عمیق و معنوی بدون راهنمایی حقیقت ممکن نیست."],[197,"پس ادب کن اسپ را از خوی بد","ورنه پیش شاه باشد اسپ رد","اگر اسب را از ویژگی‌های ناپسند و رفتارهای بدش اصلاح نکنی و به آن ادب نیاموزی، در پیشگاه شاه (خدا) مردود و غیرقابل قبول خواهد بود."],[197,"چشم اسپ از چشم شه رهبر بود","چشم او بی‌چشم شه مضطر بود","سر چشم اسبی که در مقام و جایگاه قرار دارد، به چشم پادشاه (رهبری) وابسته است. اگر پادشاه در بی‌نظمی و بی‌هدفی باشد، آن اسب نیز در وضعی ناامید و بی‌هدف خواهد بود."],[197,"چشم اسپان جز گیاه و جز چرا","هر کجا خوانی بگوید نی چرا","چشم‌های اسب‌ها به جز به گیاه و چراگاه نگاه نمی‌کنند و هر کجا که بروی، فقط از نبود چرا شکایت می‌کنند."],[197,"نور حق بر نور حس راکب شود","آنگهی جان سوی حق راغب شود","وقتی که نور حقیقت بر حس و درک ظاهری آدمی تابیده شود، آن وقت جان انسان به سوی حق و حقیقت گرایش پیدا می‌کند."],[197,"اسپ بی راکب چه داند رسم راه","شاه باید تا بداند شاه‌راه","اسب بدون سوار نمی‌داند که راه شاهی چیست و چگونه باید برود؛ تا او را سواری نباشد، نمی‌تواند مسیر اصلی را بشناسد."],[197,"سوی حسی رو که نورش راکبست","حس را آن نور نیکو صاحبست","به حس روی آور که آن حس تحت هدایت نوری است که راکب (سوار) آن حس است. این نور، حس را می‌سازد و به آن زیبایی می‌بخشد."],[197,"نور حس را نور حق تزیین بود","معنی نور علی نور این بود","نور حسی که انسان با آن واقعیت‌ها را ادراک می‌کند، با نور حق، که حقیقت اصلی و الهی است، زینت و زیبایی می‌یابد. در واقع، نور علی (علی بن ابی‌طالب) نیز به عنوان نوری از نور حق یا حقیقت مطرح شده است."],[197,"نور حسی می‌کشد سوی ثری","نور حقش می‌برد سوی علی","نور حسی انسان را به عالم طبیعت و مادیات جذب می‌کند، در حالی که نور حق او را به سوی عالم معنوی و الهی (علی، که نشان از مرتبه‌ای والا دارد) هدایت می‌نماید."],[197,"زانک محسوسات دونتر عالمیست","نور حق دریا و حس چون شب‌نمیست","زیرا محسوسات (چیزهای قابل حس) پست‌تر از یک جهانی هستند که نور حق در آن وجود دارد، مانند دریا. حس انسان مانند شب‌نم، تاریک و محدود است و نمی‌تواند به عمق آن نور پی ببرد."],[197,"لیک پیدا نیست آن راکب برو","جز به آثار و به گفتار نکو","آن سوار (راکب) که بر این خاربن (مظهر نقص و پستی) نشسته، به‌جز از روی نشانه‌ها و گفتار خوبش نمی‌توان شناخته شود، زیرا خود او (حقیقتش) در دسترس نیست."],[197,"نور حسی کو غلیظست و گران","هست پنهان در سواد دیدگان","نور حسی که سنگین و غلیظ است، در عمق چشم‌ها پنهان است و نمی‌توان به راحتی آن را دید."],[197,"چونک نور حس نمی‌بینی ز چشم","چون ببینی نور آن دینی ز چشم","هرگاه نور حس را با چشم خود نمی‌بینی، به این معناست که باید با چشم دل یا با بصیرت خود، نور حقیقت و معنویت را ببینی."],[197,"نور حس با این غلیظی مختفیست","چون خفی نبود ضیائی کان صفیست","نور حواس با این شدت و وضوح پنهان است، زیرا نوری از آن صفات درخشان، آشکار نمی‌شود."],[197,"این جهان چون خس به دست باد غیب","عاجزی پیش گرفت و داد غیب","این جهان مانند علفی است که در دستان باد نامرئی قرار دارد؛ و در نتیجه، عاجز و ناتوان است و تحت تأثیر این باد نامرئی قرار می‌گیرد."],[197,"گه بلندش می‌کند گاهیش پست","گه درستش می‌کند گاهی شکست","زمانی او را بالا می‌برد و زمانی پایین می‌آورد؛ گاهی به او نظم و ترتیب می‌دهد و گاهی او را در هم می‌شکند."],[197,"گه یمینش می‌برد گاهی یسار","گه گلستانش کند گاهیش خار","گاهی دست راست او (یمین) او را به سمت خوبی و نعمت می‌برد و گاهی دست چپ (یسار) او را به سوی بدی و مشکلات می‌کشاند؛ گاهی او را در باغ و گلستان قرار می‌دهد و گاهی به خار و خاشاک (مشکلات و رنج‌ها) می‌کشاند."],[197,"دست پنهان و قلم بین خط‌گزار","اسپ در جولان و ناپیدا سوار","دست نامرئی و قلمی که خطوط را ترسیم می‌کند، مانند اسبی در حال دویدن و سوارکاری مخفی است که دیده نمی‌شود."],[197,"تیر پران بین و ناپیدا کمان","جانها پیدا و پنهان جان جان","تیرانداز را ببین که تیرش نامرئی است، ولی کمان او که روح‌ها را به حرکت درمی‌آورد، هم آشکار و هم پنهان است. این دلالت بر قدرتی دارد که در پس دیده‌هاست و تأثیراتی عمیق بر جان‌ها می‌گذارد."],[197,"تیر را مشکن که این تیر شهیست","نیست پرتاوی ز شصت آگهیست","تیر را نشکن، زیرا این تیر شاه است و از شصت نشانه‌ای دارد که تو از آن آگاه نیستی."],[197,"ما رمیت اذ رمیت گفت حق","کار حق بر کارها دارد سبق","خداوند می‌فرماید: زمانی که تو تیر می‌اندازی، تو در واقع این کار را نمی‌کنی، بلکه خداست که این کار را انجام می‌دهد، زیرا او بر تمامی امور تسلط دارد و بر کارهایش پیشی می‌گیرد."],[197,"خشم خود بشکن تو مشکن تیر را","چشم خشمت خون شمارد شیر را","خشم و عصبانیت خود را کنار بگذار و نگذار تیر (حالت یا کلامی که طرف را هدف می‌گیرد) را بشکنی، زیرا چشمان خشمگین تو می‌توانند شیر را هم به خون بکشند و قدرت تخریب زیادی دارند."],[197,"بوسه ده بر تیر و پیش شاه بر","تیر خون‌آلود از خون تو تر","بوسه‌ای به تیر بزن و در پیش پادشاه، بر تیری که خون تو را بر خود دارد، بوسه بزن. این اشاره به احساس گناه و پشیمانی دارد و نشان می‌دهد که با زخم‌ها و مشکلات خود باید روبرو شد."],[197,"آنچ پیدا عاجز و بسته و زبون","وآنچ ناپیدا چنان تند و حرون","آنچه در دید است، عاجز، بسته و زبون به نظر می‌رسد، و آنچه ناپیداست، چنان تند و پرجنب و جوش است."],[197,"ما شکاریم این چنین دامی کراست","گوی چوگانیم چوگانی کجاست","ما مانند شکار هستیم که در دام دیگری گرفتار شده‌ایم. همچنین ما مانند گوی‌هایی در بازی چوگان هستیم، اما چوگان (بازیکن) کجاست که ما را به حرکت درآورد؟"],[197,"می‌درد می‌دوزد این خیاط کو","می‌دمد می‌سوزد این نفاط کو","این خیاط (که به کار درست کردن لباس یا پارچه مشغول است) در یک فرآیند سخت و دقیق در حال دوختن است، در حالی که در عین حال خودش رنج می‌برد و به عذاب می‌افتد. همچنین این \"نفاط\" (احتمالا اشاره به ممکن است به چیزهایی باشد که در دلتنگی یا آتش ناشی از مشکلات) نیز لطمه می‌زند و می‌سوزاند. به طور کلی، این بیت به تعارضات و دردها در حین کار و تلاش اشاره دارد."],[197,"ساعتی کافر کند صدیق را","ساعتی زاهد کند زندیق را","گاهی یک کافر می‌تواند در یک لحظه، انسان مؤمنی را به شک و تردید بیندازد و در لحظه‌ای دیگر، یک زاهد را به گمراهی و زندگی دوگانه بکشاند."],[197,"زانک مخلص در خطر باشد ز دام","تا ز خود خالص نگردد او تمام","چون انسان مخلص در خطر است و در دام‌های دنیا قرار دارد، تا زمانی که به طور کامل از خود خواهی دور نشود و خالص نگردد، از آن دام‌ها رهایی نمی‌یابد."],[197,"زانک در راهست و ره‌زن بی‌حدست","آن رهد کو در امان ایزدست","چون در راه، شخصی وجود دارد که همواره در حال دزدی و غارت است، آن کسی که در امان خداوند است از این خطر مطمئن است و باید در این مسیر هوشیار باشد."],[197,"آینه خالص نگشت او مخلص است","مرغ را نگرفته است او مقنص است","اگر آینه‌ای خالص نشود، او راه نجات را پیدا نکرده است. پس مانند پرنده‌ای است که گرفتار شده و نمی‌تواند آزاد شود."],[197,"چونک مخلص گشت مخلص باز رست","در مقام امن رفت و برد دست","زمانی که شخصی از دورویی و نفاق رهایی یافت و صمیمی و خالص شد، به مقام امن و آرامش رسید و دستش را در این حالت به سوی دیگران دراز کرد."],[197,"هیچ آیینه دگر آهن نشد","هیچ نانی گندم خرمن نشد","هیچ آینه‌ای به غیر از آهن ساخته نشد و هیچ نانی از گندم در کشتزار به وجود نیامد."],[197,"هیچ انگوری دگر غوره نشد","هیچ میوه پخته با کوره نشد","هیچ انگور دیگری به غوره تبدیل نشد و هیچ میوه‌ای بدون پخته شدن در آتش و حرارت به دست نیامد."],[197,"پخته گرد و از تغیّر دور شو","رو چو برهان محقق نور شو","به پخته و بارور تبدیل شو و از هر تغییر و تحول ناپسند فاصله بگیر، تا مانند برهانی که حقیقت را روشن می‌کند، نورانی و روشن‌گر شوی."],[197,"چون ز خود رستی همه برهان شدی","چونک بنده نیست شد سلطان شدی","وقتی از خود رها شدی، تمام مشکلات و موانع از بین رفتند. زیرا وقتی دیگر بنده و وابسته نبودی، به مقام سلطانی رسیدی."],[197,"ور عیان خواهی صلاح الدین نمود","دیده‌ها را کرد بینا و گشود","اگر می‌خواهی صلاح‌الدین را به‌وضوح ببینی و درک کنی، باید چشمانت را بینا کنی و آگاهی‌ات را افزایش دهی."],[197,"فقر را از چشم و از سیمای او","دید هر چشمی که دارد نور هو","هر چشمی که روشنایی و بینایی دارد، می‌تواند فقر و نیازمندی را در چهره و سیمای او (کسی که در حال صحبت است) ببیند."],[197,"شیخ فعالست بی‌آلت چو حق","با مریدان داده بی گفتی سبق","شیخ (یعنی فردی که مقام بالایی در عرفان دارد) بدون ابزار و وسیله‌ای فعال است؛ مانند خداوند که بدون گفتگو و با وجود عدم گفتاری، پیشی و برتری را به مریدان خود عطا کرده است."],[197,"دل به دست او چو موم نرم رام","مهر او گه ننگ سازد گاه نام","دل آدمی مانند موم در دست او (شیخ) نرم و فرمان‌پذیر است. محبت او (شیخ) گاهی موجب ننگ و رسوایی می‌شود و گاهی باعث نام و اعتبار."],[197,"مهر مومش حاکی انگشتریست","باز آن نقش نگین حاکی کیست","محبت او مانند موم است که در دست من نرم و رام می‌شود، و نشان می‌دهد که مهر او در دل من مانند انگشتری است. حالا باید بدانم که آن نقش درخشان نگین انگشتر، که نشان از کسی دارد، متعلق به کیست."],[197,"حاکی اندیشه آن زرگرست","سلسله هر حلقه اندر دیگرست","این جمله نشان می‌دهد که نشان‌هایی که در این انگشتر وجود دارد، نمایانگر فکر و اندیشه آن زرگر (طلاکار) است و هر حلقه از زنجیر به نوعی به حلقه‌های دیگر مرتبط است."],[197,"این صدا در کوه دلها بانگ کیست","گه پرست از بانگ این که گه تهیست","این صدا که از کوه می‌آید و دل‌ها را پر می‌کند، صدای چه کسی است؟ گاهی این صدا به‌سبب عشق و پرستش است و گاهی هم از بی‌محتوایی و خالی بودن دل‌هاست."],[197,"هر کجا هست او حکیمست اوستاد","بانگ او زین کوه دل خالی مباد","هر جا که آن حکیم و استاد هست، نشانه‌ای از وجود اوست. صدای او از این کوه به‌گوش می‌رسد و نباید دلی خالی از محبت و آموزه‌های او باشد."],[197,"هست که کآوا مثنا می‌کند","هست که کآواز صدتا می‌کند","کوهی وجود دارد که صدای آن دوگانه و هماهنگ است و همچنین کوهی هست که آوازهای بسیار زیبا و متنوعی از آن شنیده می‌شود."],[197,"می‌زهاند کوه از آن آواز و قال","صد هزاران چشمه آب زلال","کوه به خاطر آن صدا و نغمه، زنده و شاداب می‌شود و از دل آن، صدها چشمه آب زلال و پاک به‌وجود می‌آید."],[197,"چون ز که آن لطف بیرون می‌شود","آبها در چشمه‌ها خون می‌شود","زمانی‌که لطف و رحمت الهی از کوه‌ها خارج می‌شود، آب‌ها در چشمه‌ها به حالت ناپسند و خون تبدیل می‌شود، نشان‌دهنده عواقب منفی بروز خشونت و نبود جمال و خیر است."],[197,"زان شهنشاه همایون‌نعل بود","که سراسر طور سینا لعل بود","آن پادشاه بزرگ و محترم با نعل خود، مانند جواهر درخشانی است که تمام کوه سینا را زیبا و با ارزش کرده است."],[197,"جان پذیرفت و خرد اجزای کوه","ما کم از سنگیم آخر ای گروه","انسان‌ها دارای روح و عقل هستند، اما با توجه به سختی‌ها و ناپایداری‌های زندگی، گاهی مانند سنگ‌ها بی‌تحرک و بی‌احساس می‌شوند. در واقع، ما در این دنیا نیز بخشی از جسم سنگین و بی‌حرکت طبیعت هستیم، حتی اگر جان و خردی در ما وجود داشته باشد."],[197,"نه ز جان یک چشمه جوشان می‌شود","نه بدن از سبزپوشان می‌شود","نه از جان انسان چیزی مانند چشمه‌ای پرآب و زنده خلق می‌شود و نه از بدن او، با پوشش سبز، زندگی و سرزندگی به وجود می‌آید."],[197,"نی صدای بانگ مشتاقی درو","نی صفای جرعه ساقی درو","در این بیت، مولانا از نبودن یک صدای دلنشین یا بانگ عاشقانه سخن می‌گوید و همچنین از فقدان طراوت و صفای نوشیدنی ساقی که می‌تواند روح را شاداب کند. به این ترتیب، فضای دل‌تنگی و بی‌حالی را توصیف می‌کند که در آن نه اشتیاقی وجود دارد و نه لذت از می."],[197,"کو حمیت تا ز تیشه وز کلند","این چنین که را بکلی بر کنند","حمیت (غیرت و شجاعت) کجاست که با تیشه و ابزارهای قوی، این کوه را کاملا از ریشه برکنند؟"],[197,"بوک بر اجزای او تابد مهی","بوک در وی تاب مه یابد رهی","چون نور ماه بر اجزای او بتابد، آنچنان که در او نوری پدید می‌آید، راهی روشن و آشکار خواهد شد."],[197,"چون قیامت کوهها را برکند","بر سر ما سایه کی می‌افکند","زمانی که قیامت کوه‌ها را از جا برمی‌کند، دیگر چگونه می‌تواند بر سر ما سایه بیندازد؟"],[197,"این قیامت زان قیامت کی کمست","آن قیامت زخم و این چون مرهمست","این قیامت، که به معنای وضع جاری و مشکلات دنیوی است، در مقایسه با قیامت حقیقی که برای انسان عذاب و زخم و رنج به همراه دارد، باعث آرامش و تسکین برای بشر می‌شود. در واقع، دردها و مشکلات این دنیا به نوعی مرهم و تسکین‌دهنده‌اند تا انسان‌ها را به سمت رشد و بهتر شدن هدایت کنند."],[197,"هر که دید این مرهم از زخم ایمنست","هر بدی کین حسن دید او محسنست","هر کس که این مرهم را ببیند و از زخم‌ها در امان باشد، هر بدی که زیبایی را ببیند، او کار نیکو انجام می‌دهد و خوب می‌شود."],[197,"ای خنک زشتی که خوبش شد حریف","وای گل‌رویی که جفتش شد خریف","خوشاب حال زشتی که با خوبی هم‌نشین شده است و خوش به حال زیبایی که همراهش زشتی است."],[197,"نان مرده چون حریف جان شود","زنده گردد نان و عین آن شود","نان مرده وقتی به همراه جان و روح انسان می‌شود، زنده و پرکاربرد می‌گردد و در واقع به همان نان روح و زندگی می‌دهد."],[197,"هیزم تیره حریف نار شد","تیرگی رفت و همه انوار شد","هیزم سیاه، وقتی که با آتش تماس می‌گیرد، به شعله تبدیل می‌شود و تاریکی آن پس از روشن شدن، از بین می‌رود و همه جا پر از نور می‌شود."],[197,"در نمکلان چون خر مرده فتاد","آن خری و مردگی یکسو نهاد","وقتی که در نمکلان، خر مرده‌ای افتاده، آن خر مردگی را کنار گذاشته و بی‌حرکت مانده است."],[197,"صبغة الله هست خم رنگ هو","پیسها یک رنگ گردد اندرو","خم (ظرف بزرگ) رنگی است که خدا بر آن نهاده و هر رنگی که در آن ریخته شود، رنگ خدا را به خود می‌گیرد. این به این معناست که وجود انسان نیز باید زیر تأثیر رنگ خدا و صفات او قرار گیرد تا به یک رنگ و یک کردار واحد تبدیل شود."],[197,"چون در آن خم افتد و گوییش قم","از طرب گوید منم خم لا تلم","وقتی در آن خم (که نماد روح و وجود است) می‌افتد و به وجد می‌آید، از شادی و شوق می‌گوید که من خم هستم، اما نادانسته نگوید که به من دست نزنید."],[197,"آن «منم خم» خود انا الحق گفتنست","رنگ آتش دارد الا آهنست","بیان این است که وقتی کسی ادعا می‌کند «من همان حقیقت هستم» (منم خم) و خود را مثل حقّ می‌داند، در واقع به رنگ آتش درآمده و خود را برتر از دیگران می‌بیند، در حالی که در واقع او تنها یک جنس آهنی است و حقیقت ندارد."],[197,"رنگ آهن محو رنگ آتشست","ز آتشی می‌لافد و خامش وشست","رنگ آهن تحت تأثیر رنگ آتش قرار می‌گیرد و به خاطر آن آتش، شعله‌ور شده و در واقع خاموش و بی‌صداست."],[197,"چون به سرخی گشت همچون زر کان","پس انا النارست لافش بی زبان","زمانی که آتش به رنگ سرخ در می‌آید و شبیه طلا می‌شود، در واقع خود می‌گوید که من آتش هستم، بی آنکه نیازی به سخن گفتن داشته باشد."],[197,"شد ز رنگ و طبع آتش محتشم","گوید او من آتشم من آتشم","آتش که به رنگ و خصوصیاتش مشکوک شده، با صلابت می‌گوید که من آتش هستم، من آتش هستم."],[197,"آتشم من گر ترا شکیست و ظن","آزمون کن دست را بر من بزن","من آتش هستم، اگر نسبت به من شک و تردید داری، آزمون کن و دستت را به من بزن تا حقیقت را بیابی."],[197,"آتشم من بر تو گر شد مشتبه","روی خود بر روی من یک‌دم بنه","من آتش عشق و شوق به تو هستم، اگر برایت مشخص نیست. فقط یک لحظه روی خود را به سمت من برگردان."],[197,"آدمی چون نور گیرد از خدا","هست مسجود ملایک ز اجتبا","انسان از آنجا که از خدا نور دریافت می‌کند، مورد احترام فرشتگان (ملایک) قرار می‌گیرد و به مقام والایی می‌رسد زیرا او از بینش و انتخاب الهی بهره‌مند است."],[197,"نیز مسجود کسی کو چون ملک","رسته باشد جانش از طغیان و شک","آدمی هم مسجود و شایسته احترام است که مانند فرشتگان از طغیان و نافرمانی دور باشد و در حقیقت شرافت او به پاکی و آزادگی‌اش بستگی دارد."],[197,"آتش چه آهن چه لب ببند","ریش تشبیه مشبه را مخند","وقتی آتش و آهن در کنار هم هستند، باید سکوت اختیار کرد و لب‌ها را از خندیدن به طرف مقابل منع کرد؛ یعنی در مواجهه با خطر و مشکلات نباید دست کم گرفت و باید جدی بود."],[197,"پای در دریا منه کم‌گوی از آن","بر لب دریا خمش کن لب گزان","به دریا پا نگذار و سر خود را از حرف‌زدن در این مورد دور نگه‌دار. در کنار دریا، سکوت کن و از ادعا و گفتگوهای بی‌مورد دوری کن."],[197,"گرچه صد چون من ندارد تاب بحر","لیک می‌نشکیبم از غرقاب بحر","هرچند که تعداد افرادی مانند من که توانایی تحمل و مواجهه با دریا را داشته باشند، بسیار کم است، اما من به رغم این هم از غرق شدن در عمق دریا نمی‌ترسم و صبر می‌کنم."],[197,"جان و عقل من فدای بحر باد","خونبهای عقل و جان این بحر داد","من جان و عقل خود را برای دریا فدای می‌کنم، زیرا بهای جان و عقل من این دریا را به من بخشیده است."],[197,"تا که پایم می‌رود رانم درو","چون نماند پا چو بطانم درو","تا زمانی که پای من می‌تواند حرکت کند، من هم در این مسیر پیش می‌روم. اما وقتی که پایم نماند، مانند پرنده‌ای که می‌افتد، دیگر نمی‌توانم ادامه دهم."],[197,"بی‌ادب حاضر ز غایب خوشترست","حلقه گرچه کژ بود نی بر درست؟","حضور بی‌ادب به مراتب مطلوب‌تر از غیبت است، حتی اگر حلقه و جامعه‌ای که در آن هستیم، نادرست و کژ باشد."],[197,"ای تن‌آلوده بگرد حوض گرد","پاک کی گردد برون حوض مرد","ای کسی که بدن و جانت آلوده است، قبل از اینکه به حوض پاک برسد، باید خود را از آلودگی‌ها بشویی. تنها در این صورت است که می‌توانی از حوض پاک بیرون بیایی."],[197,"پاک کو از حوض مهجور اوفتاد","او ز پاکی خویش هم دور اوفتاد","آن شخصی که از حوض دور افتاده است، به سبب نبود پاکی در آن حوض، خود نیز از پاکی و بی‌خبری فاصله گرفته و آلوده شده است."],[197,"پاکی این حوض بی‌پایان بود","پاکی اجسام کم میزان بود","پاکی و طهارت این حوض بی‌انتها و فراوان است، اما در مقایسه با پاکی واقعی، مانند پاکی اجسام و چیزهای مادی، کم‌ارزش و کم‌شمار به نظر می‌رسد."],[197,"زانک دل حوضست لیکن در کمین","سوی دریا راه پنهان دارد این","دل مانند حوضی است، اما در کمین و آماده حرکت به سوی دریا (معرفت و حقیقت) است و دارای راهی پنهان برای رسیدن به آنجا می‌باشد."],[197,"پاکی محدود تو خواهد مدد","ورنه اندر خرج کم گردد عدد","پاکی تو به اندازه‌ای است که اگر کمک کند، به این ترتیب هیچ‌گاه در کمبود و نقص قرار نخواهی گرفت. در غیر این صورت، کمبود و نقص به سراغت خواهد آمد."],[197,"آب گفت آلوده را در من شتاب","گفت آلوده که دارم شرم از آب","آب به آلوده می‌گوید که چرا به من نزدیک می‌شوی، زیرا من از آلودگی تو بیزار و شرمنده‌ام. آلوده هم می‌گوید که به خاطر آلودگی‌ام از تو خجالت می‌کشم."],[197,"گفت آب این شرم بی من کی رود","بی من این آلوده زایل کی شود","آب می‌گوید که شرم و حیای این فرد به خاطر وجود من است؛ اگر من بروم، این آلودگی چه زمانی از بین خواهد رفت؟"],[197,"ز آب هر آلوده کو پنهان شود","الحیاء یمنع الایمان بود","آب هر چیز آلوده‌ای که پنهان شده باشد، اگر ظاهر نشود، شرم و حیا مانع از ایمان خواهد بود."],[197,"دل ز پایه حوض تن گلناک شد","تن ز آب حوض دلها پاک شد","دل که در پیوند با بدن قرار دارد، از آن آلوده و کثیف می‌شود، اما بدن با آب حوض دل‌ها، احیا و پاکیزه می‌گردد."],[197,"گرد پایه حوض دل گرد ای پسر","هان ز پایه حوض تن می‌کن حذر","پسر، مراقب باش که دور پایه حوض دل بگردی و از دور پایه حوض تن دوری کنی، چون تن و دل هر کدام ویژگی‌های خاص خود را دارند که باید به آنها توجه کرد."],[197,"بحر تن بر بحر دل بر هم زنان","در میانشان برزخ لا یبغیان","تن مانند دریایی است که بر روی دریای دل متلاطم می‌شود و در این بین فاصله‌ای است که نه از بین می‌رود و نه خفه می‌شود."],[197,"گر تو باشی راست ور باشی تو کژ","پیشتر می‌غژ بدو واپس مغژ","اگر تو درست و حقیقتا باشی، و اگر کج و نادرست باشی، پیش از آنکه به بدی افکار و رفتار دیگران تکیه کنی، اول به کم و کاستی‌های خودت دقت کن."],[197,"پیش شاهان گر خطر باشد به جان","لیک نشکیبند ازو با همتان","اگر در میان پادشاهان خطری جان افراد را تهدید کند، آن‌ها هرگز از آن خطر نمی‌هراسند و در کنار یکدیگر ایستادگی می‌کنند."],[197,"شاه چون شیرین‌تر از شکر بود","جان به شیرینی رود خوشتر بود","در این بیت، شاعر به توصیف شاه می‌پردازد و می‌گوید که او به اندازه‌ای شیرین و خوشبوست که همچون شکر است و جان انسان به شیرینی او خوشتر از هر چیز دیگری است. به عبارتی، وجود و صفات شاه به قدری محبوب و دلنشین است که انسان آرزوی جانی شیرین‌تر را در پی او دارد."],[197,"ای ملامت‌گر سلامت مر تو را","ای سلامت‌جو رها کن تو مرا","ای کسی که به من سرزنش می‌کنی، به سلامت خود دل‌مشغول نباش، ای کسی که در جست‌وجوی سلامت هستی، من را رها کن و برای خودت زندگی کن."],[197,"جان من کوره‌ست با آتش خوشست","کوره را این بس که خانه آتشست","روح من مانند کوره‌ای است که در آن آتش وجود دارد و این کوره فقط به این دلیل خوب است که خانه آتش است."],[197,"همچو کوره عشق را سوزیدنیست","هر که او زین کور باشد کوره نیست","عشق مانند کوره‌ای است که باید دائما در آن سوخت و سوز وجود داشته باشد. هر کسی که در این مسیر از عشق فاصله بگیرد، مانند کوره‌ای است که دیگر هیچ حرارتی ندارد و مرده به حساب می‌آید."],[197,"برگ بی برگی ترا چون برگ شد","جان باقی یافتی و مرگ شد","وقتی که تو از حالت بی‌حالتیت به دنیای جدیدی منتقل شدی، مانند برگ درخت به زندگی ادامه می‌دهی و مرگ به معنای واقعی برای تو محو می‌شود."],[197,"چون تو را غم شادی افزودن گرفت","روضه جانت گل و سوسن گرفت","وقتی که غم به تو شادی می‌بخشد، روح و جان تو مانند باغی پر از گل و سوسن و زیبایی می‌شود."],[197,"آنچ خوف دیگران آن امن تست","بط قوی از بحر و مرغ خانه سست","چیزی که دیگران از آن می‌ترسند، برای تو امن و احساس امنیت به همراه دارد، مانند بطی که در دریا مقاوم است ولی مرغ که در خانه است، در برابر خطرات آسیب‌پذیر و ناامن است."],[197,"باز دیوانه شدم من ای طبیب","باز سودایی شدم من ای حبیب","دوباره دیوانه شدم ای پزشک، و دوباره به عشق دچار شدم ای دوست."],[197,"حلقه‌های سلسله تو ذو فنون","هر یکی حلقه دهد دیگر جنون","حلقه‌های پیوند و تعلق به تو، هر کدام جنون و دیوانگی دیگری را به من می‌دهند. این نشان‌دهنده این است که هر مرتبه‌ای که به تو نزدیک‌تر می‌شوم، شوری و هیجان جدیدی در من ایجاد می‌شود."],[197,"داد هر حلقه فنونی دیگرست","پس مرا هر دم جنونی دیگرست","هر حلقه از سلسله تو ویژگی‌ها و فنون خاص خودش را دارد، بنابراین من هر لحظه دچار حالتی جدید و جنونی متفاوت می‌شوم."],[197,"پس فنون باشد جنون این شد مثل","خاصه در زنجیر این میر اجل","دلیل این جنون و رفتار غیرعادی، مشابه گشتن با زنجیری است که بر گردن یک شخص است، و این شخص در واقع تحت تسلط مرگ (میر اجل) قرار دارد."],[197,"آنچنان دیوانگی بگسست بند","که همه دیوانگان پندم دهند","به قدری دیوانگی از من دور شده که حالا دیوانگان به من نصیحت می‌کنند."],[198,"این چنین ذالنون مصری را فتاد","کاندرو شور و جنونی نو بزاد","ذالنون مصری به این شدت دچار شور و جنونی شد که نوع دیگری از شور و هیجان در او به وجود آمد."],[198,"شور چندان شد که تا فوق فلک","می‌رسید از وی جگرها را نمک","شور و هیجان ذالنون مصری به حدی افزایش پیدا کرد که تا آسمان‌ها بالا می‌رفت و این حالت موجب می‌شد که دل‌ها مانند جگرها به نمک نیاز پیدا کنند، به تعبیر دیگر، او به شدت تحت تأثیر عشق و شوق قرار گرفته بود."],[198,"هین منه تو شور خود ای شوره‌خاک","پهلوی شور خداوندان پاک","ای شوره‌خاک، توجه کن که شور و هیجان خود را مهار کن، زیرا شور و جنون الهی پاکان و افراد با تقوا به مراتب بالاتر از شور توست."],[198,"خلق را تاب جنون او نبود","آتش او ریشهاشان می‌ربود","جنون وجدانی که ذاالنون مصری دارد، برای دیگران غیرقابل تحمل است و شدت احساس او، آرامش و حیات عقلانی را از مردم می‌گیرد. آتش عشق و شوق او به حدی است که سر و وضع مردم را به هم می‌ریزد و آنها را مجنون می‌کند."],[198,"چونک در ریش عوام آتش فتاد","بند کردندش به زندانی نهاد","وقتی که آتش عشق و جنون ذاالنون مصری در ریش مردم عادی افتاد، آنها او را به زندان انداختند و به نوعی او را محدود کردند."],[198,"نیست امکان واکشیدن این لگام","گرچه زین ره تنگ می‌آیند عام","این امکان وجود ندارد که این افسار را بکشیم و آزاد کنیم، هرچند مردم از این راه باریک و تنگ به ما نزدیک می‌شوند."],[198,"دیده این شاهان ز عامه خوف جان","کین گره کورند و شاهان بی‌نشان","شاهان از ترس جان، چشم به عامه (مردم) دارند، زیرا می‌ترسند که این مردم ممکن است دلیلی برای کور کردن گره‌ها و آشفتگی‌ها فراهم کنند و در نتیجه، قدرت و نشانی از خود نداشته باشند."],[198,"چونک حکم اندر کف رندان بود","لاجرم ذاالنون در زندان بود","زمانی که اختیار و فرماندهی در دست افراد لوده و پر ادعایی باشد، بنابراین طبیعی است که ذاالنون مصری، یک عالم و عارف بزرگ، به زندان افتاده باشد."],[198,"یکسواره می‌رود شاه عظیم","در کف طفلان چنین درّ یتیم","شاه عظیم به صورت یکسویه و بدون توجه به دیگران، در حال حرکت است و در دستان کودکانی، این مروارید بی‌سرپرست به گونه‌ای رها شده دارد."],[198,"درّ چه؟ دریا نهان در قطره‌ای","آفتابی مخفی اندر ذره‌ای","مھر در حقیقت همچون یک درّ گرانبها است که در دریا پنهان شده و به اندازه یک قطره ظاهر می‌شود؛ همچنین نور خورشید نیز در ذره‌ای کوچک نهفته است و به نظر نمی‌آید."],[198,"آفتابی خویش را ذره نمود","واندک اندک روی خود را بر گشود","نور و روشنایی خود را به صورت ذره‌ای کوچک نشان داد و کم‌کم چهره‌اش را آشکار کرد."],[198,"جمله ذرات در وی محو شد","عالم از وی مست گشت و صحو شد","ذرات وجودی او در حقیقتش ناپدید شد و به همین دلیل، جهان به خاطر او شگفت‌زده و سرمست گشت."],[198,"چون قلم در دست غداری بود","بی گمان منصور بر داری بود","زمانی که قلم در دست شخصی بدسگال و مکار باشد، بدون شک منصور حلاج به دار آویخته خواهد شد."],[198,"چون سفیهان‌راست این کار و کیا","لازم آمد یقتلون الانبیا","این کار به سفیهان و جاهلان مربوط می‌شود و به همین دلیل لازم شده که پیامبران را به قتل برسانند."],[198,"انبیا را گفته قومی راه گم","از سفه انا تطیرنا بکم","بعضی از قوم‌ها به پیامبران گفته‌اند که ما از وجود شما بدشانس و بداقبال شده‌ایم و به همین خاطر، شما را ملامت می‌کنند که ما را به خطا انداخته‌اید."],[198,"جهل ترسا بین امان انگیخته","زان خداوندی که گشت آویخته","جهل ترسا به معنای نادانی و سادگی‌اش، به خاطر خداوندی است که به صلیب کشیده شد. این اشاره به عیسای مسیح دارد که در اعتقادات مسیحی، به خاطر گناهان بشر قربانی شد."],[198,"چون بقول اوست مصلوب جهود","پس مرورا امن کی تاند نمود","چون به گفته او، یهودی‌ها مصلوب شده (عیسى مسیح) هستند، پس کسی که در این‌باره صحبت کند، در چه زمانی می‌تواند به امنیت برسد؟"],[198,"چون دل آن شاه زیشان خون بود","عصمت و انت فیهم چون بود","چون دل آن پادشاه (ذوالنون مصری) از آزار یهودیان خون‌چکان بود، عفت و پاکی او در میان آنان چگونه بوده است؟"],[198,"زر خالص را و زرگر را خطر","باشد از قلاب خاین بیشتر","خطر بیشتر شامل حال طلا (زر خالص) و طلاساز (زرگر) می‌شود، زیرا قلاب خائن می‌تواند آسیب بیشتری به آن‌ها بزند. یعنی افرادی که در مقام طلا و ارزش واقعی قرار دارند، ممکن است از خیانت و آسیب‌دیدگی بیشتری برخوردار شوند."],[198,"یوسفان از رشک زشتان مخفی‌اند","کز عدو خوبان در آتش می‌زیند","خوبان مانند یوسف، به خاطر حسادت و رشک بدخواهان پنهان هستند؛ زیرا دشمنان، در آتش حسادت و کینه می‌سوزند."],[198,"یوسفان از مکر اخوان در چهند","کز حسد یوسف به گرگان می‌دهند","یوسف‌ها به خاطر مکر و نیرنگ برادران خود در خطر هستند؛ چون به خاطر حسد نسبت به یوسف، برادرانشان مانند گرگ‌ها به او حمله می‌کنند."],[198,"از حسد بر یوسف مصری چه رفت؟","این حسد اندر کمین گرگیست زفت","حسد نسبت به یوسف مصری چه بلایی به بار آورد؟ این حسد همچون گرگ خطرناکی در کمین است."],[198,"لاجرم زین گرگ، یعقوب حلیم","داشت بر یوسف، همیشه خوف و بیم","بنابراین، یعقوب، پدر یوسف که انسانی صبور و بخشنده است، همیشه از این حسد و کینه‌ورزی‌های پنهان در دل‌ها نگران و ترسان بود."],[198,"گرگ ظاهر گرد یوسف خود نگشت","این حسد در فعل از گرگان گذشت","حسادت باعث نمی‌شود که گرگ‌ها به ظاهر به یوسف حمله کنند، بلکه این حسادت از دل خود گرگان بیرون می‌آید و بر رفتار آنها تأثیر می‌گذارد."],[198,"رحم کرد این گرگ وز عذر لبق","آمده که انا ذهبنا نستبق","این گرگ رحم کرده و به عذری که آورده، می‌گوید ما آمده‌ایم که برای سبقت بیفتیم."],[198,"صد هزاران گرگ را این مکر نیست","عاقبت رسوا شود این گرگ بیست","این گرگ، یعنی شخصی که در اینجا به او اشاره شده، در نهایت به خاطر مکر و فریبش رسوا خواهد شد، حتی اگر صدها هزار گرگ دیگر هم به او کمک کنند."],[198,"زانک حشر حاسدان روز گزند","بی گمان بر صورت گرگان کنند","به‌خاطر اینکه در روز قیامت، حسودان به‌طور قطع بر چهره گرگ‌ها (که نماد کسانی است که به دیگران آسیب می‌زنند) آسیب خواهند زد."],[198,"حشر پر حرص خس مردارخوار","صورت خوکی بود روز شمار","روز قیامت، جمع‌آوری و محشری که در آن به حرص و پرخوری شخصیت‌های مادی و طمع‌کار که مرگ و فساد را می‌پرستند، شبیه به خوک خواهد بود."],[198,"زانیان را گند اندام نهان","خمرخواران را بود گند دهان","زانیان (زناکاران) به خاطر گناهانی که مرتکب شده‌اند، به نوعی آلودگی درونی دارند که در ظاهرشان پنهان است، در حالی که کسانی که شراب می‌نوشند (خمرخواران) به دلیل رفتارشان، آلودگی و فسادشان در کلام و دهانشان نمایان است."],[198,"گند مخفی کان به دلها می‌رسید","گشت اندر حشر محسوس و پدید","آلودگی و ناخالصی پنهانی که به دل‌ها نفوذ می‌کرد، در روز محشر آشکار و واضح خواهد شد."],[198,"بیشه‌ای آمد وجود آدمی","بر حذر شو زین وجود ار زان دمی","وجود انسان همچون یک جنگل انبوه است، پس در برابر این وجود باید احتیاط کنی و اگر در یک لحظه غفلت کنی، ممکن است به دردسر بیفتی."],[198,"در وجود ما هزاران گرگ و خوک","صالح و ناصالح و خوب و خشوک","در وجود هر انسان، هزاران صفت مختلف و متضاد وجود دارد؛ برخی از این صفات نیکو و برخی بد هستند، مانند گرگ و خوک که به صورت نمادین نشان‌دهنده صفات زشت و ناپسند هستند."],[198,"حکم آن خو راست کان غالبترست","چونک زر بیش از مس آمد آن زرست","حکمی که بر شخصی غالب است، اثر آن شخص را مشخص می‌کند؛ مانند اینکه اگر طلا بر مس غالب باشد، ارزش آن طلا بیشتر خواهد بود."],[198,"سیرتی کان بر وجودت غالبست","هم بر آن تصویر حشرت واجبست","سیرت و باطنی که در وجود تو غالب است، بر آن تصویر ظاهری نیز اثر می‌گذارد و باید مطابق آن باشد."],[198,"ساعتی گرگی در آید در بشر","ساعتی یوسف‌رخی همچون قمر","گاهی در وجود انسان حالتی خبیث و وحشی مانند گرگ ظاهر می‌شود و زمانی دیگر، وجود او مثل یوسف، زیبا و نورانی است."],[198,"می‌رود از سینه‌ها در سینه‌ها","از ره پنهان صلاح و کینه‌ها","صلاح و کینه‌ها به طور پنهانی از دل‌ها می‌روند و به دل‌های دیگر منتقل می‌شوند."],[198,"بلک خود از آدمی در گاو و خر","می‌رود دانایی و علم و هنر","این بیت می‌گوید که در واقع دانایی، علم و هنر از خود انسان به موجودات دیگری مانند گاو و خر منتقل می‌شود، به طوری که افراد با ویژگی‌های خود می‌توانند جنبه‌های انسانی را در این موجودات ناظر باشند."],[198,"اسپ سکسک می‌شود رهوار و رام","خرس بازی می‌کند بز هم سلام","گاو و خر هم با وجود اینکه به نظر ساده می‌آیند، می‌توانند دارای هوش و هنر باشند. در اینجا به نوعی اشاره شده که حتی حیوانات به واسطه تربیت یا شرایط می‌توانند رفتاری متناسب با موقعیت خود از خود نشان دهند؛ مثلا اسب رهوار و رام می‌شود و بز هم می‌تواند در بازی با خرس مشارکت کند."],[198,"رفت اندر سگ ز آدمیان هوس","تا شبان شد یا شکاری یا حرس","انسان‌ها به خاطر هوس و خواسته‌های خود به هر سمتی می‌روند، یا شبانی می‌شوند که از گله محافظت می‌کند یا شکاری که دنبال شکار است، یا حتی ممکن است به حراست و نگهبانی مشغول شوند."],[198,"در سگ اصحاب خویی زان وفود","رفت تا جویای الله گشته بود","در میان دوستی‌های انسان‌ها، خویی به سوی خداوند افاضه می‌شود که به دنبال او رفته‌اند."],[198,"هر زمان در سینه نوعی سر کند","گاه دیو و گه ملک گه دام و دد","در هر زمانی در دل انسان نوعی احساس وجود دارد که گاهی شبیه به دیو (نماد شر و بدی) و گاهی شبیه به ملک (نماد خوبی و فرشته) و گاه شبیه به دام و دد (حیوانات وحشی) است."],[198,"زان عجب بیشه که هر شیر آگهست","تا به دام سینه‌ها پنهان رهست","عجب است که در این جنگل، هر شیر (به معنای قوی و با اراده) از آنچه در دل‌ها نهفته است، باخبر است و در عین حال، از دامی که در سینه‌ها پنهان است، راهی می‌یابد."],[198,"دزدیی کن از درون مرجان جان","ای کم از سگ از درون عارفان","از عمق جان خود، گوهری پاک و ارزشمند را بربای و در خود پیدا کن، ای کسی که از شناخت عارفان کمتر از یک سگ هم نیستی."],[198,"چونک دزدی باری آن در لطیف","چونک حامل می‌شوی باری شریف","وقتی که دزدی، یعنی کسی که به‌ناحق چیزی را می‌گیرد، آن گوهر لطیف را به چنگ می‌آورد، چون خود را به مراتب بالا می‌رساند، آن را در اختیار شخص شایسته یا با ارزش دیگری قرار می‌دهد."],[199,"دوستان در قصه ذاالنون شدند","سوی زندان و در آن رایی زدند","دوستان در قصه ذاالنون (إمام شافعی) به زندان رفتند و در آنجا درباره موضوعی گفتگو کردند."],[199,"کین مگر قاصد کند یا حکمتیست","او درین دین قبله‌ای و آیتیست","آیا ممکن است که این شخص (ذاالنون به عنوان قاصد) به دنبال هدفی معنوی یا حکمتی خاص باشد؟ در این دین، او مانند قبله‌ای (مرکز توجه) و آیتی (نشانه‌ای از حقایق الهی) محسوب می‌شود."],[199,"دور دور از عقل چون دریای او","تا جنون باشد سفه‌فرمای او","عقل انسان بسیار محدود است و مانند دریایی عمیق، اما در مقابل این وسعت عقل، جنون و دیوانگی او به قدری عمیق است که می‌تواند به او اجازه دهد تا بر افکار و رفتارهای بی‌معنی و غیرعادی خود تسلط داشته باشد."],[199,"حاش لله از کمال جاه او","کابر بیماری بپوشد ماه او","خدا نکند که کمال و عظمت او را به این بیماری‌اش نسبت دهیم، زیرا جمال او چنان است که حتی عیب‌ها نمی‌تواند آن را بپوشاند."],[199,"او ز شر عامه اندر خانه شد","او ز ننگ عاقلان دیوانه شد","او از شرّ و بدی مردم به درون خانه پناه برد و به خاطر ننگ و خفت عاقلان دیوانه و عاشق شد."],[199,"او ز عار عقل کند تن‌پرست","قاصدا رفتست و دیوانه شدست","او به خاطر شرم از عقل ضعیف و پرستی جسم و تن، قاصدی فرستاده و به حالت دیوانگی در آمده است."],[199,"که ببندیدم قوی وز ساز گاو","بر سر و پشتم بزن وین را مکاو","من قوی و نیرومند شدم و به ساز گاو (در اینجا اشاره به موسی و معجزه‌اش) دست یافته‌ام، پس بر سر و پشت من بزنید و این را فراموش نکنید."],[199,"تا ز زخم لخت یابم من حیات","چون قتیل از گاو موسی ای ثقات","از طریق زخم لخت (زخم عمیق) زندگانی جدیدی به دست می‌آورم، مانند کسی که از گاو موسی (حیوانی که او را برای نجات بنی‌اسرائیل قربانی کردند) زندگانی‌اش به دست آمده است، ای دوستان پخته و با تجربه."],[199,"تا ز زخم لخت گاوی خوش شوم","همچو کشته و گاو موسی گش شوم","می‌خواهم از زخم‌های گاوی خوشحالی و حیات بیابم، مانند کشته‌ای که به واسطه گاو موسی زنده می‌شود."],[199,"زنده شد کشته ز زخم دم گاو","همچو مس از کیمیا شد زر ساو","کشته، به واسطه زخمی که به او وارد شده، جان دوباره‌ای می‌یابد و به زندگی برمی‌گردد، درست مانند اینکه مس به وسیله کیمیا به طلا تبدیل می‌شود."],[199,"کشته بر جست و بگفت اسرار را","وا نمود آن زمره خون‌خوار را","کسی که به قتل رسیده، حقیقت و اسرار را آشکار کرد و آن گروهی که خونریز هستند را عریان ساخت."],[199,"گفت روشن کین جماعت کشته‌اند","کین زمان در خصمیم آشفته‌اند","گفت که این گروه (که به ناحق) کشته شده‌اند، روشن است که در این زمان در حال خصومت و درگیری هستند و دچار آشفتگی و بی‌نظمی‌اند."],[199,"چونک کشته گردد این جسم گران","زنده گردد هستی اسراردان","زمانی که این جسم سنگین و مادی از بین برود، وجودی تازه و باطنی زنده می‌شود که آگاهی و دانایی بسیاری دارد."],[199,"جان او بیند بهشت و نار را","باز داند جمله اسرار را","روح او به بهشت و دوزخ آگاهی دارد و همه رموز و اسرار را درک می‌کند."],[199,"وا نماید خونیان دیو را","وا نماید دام خدعه و ریو را","مریدان می‌توانند ذات و حقیقت دیوانگی را بشناسند و همچنین ترفندهای فریب و مکر را برایشان آشکار کند."],[199,"گاو کشتن هست از شرط طریق","تا شود از زخم دمش جان مفیق","کشتن گاو (تمثیل نفس) جزء ضروری سلوک (راه و رسم عرفانی) است تا از زخم دم آن (اینجا نماد زخم‌پذیری و رنج) جان از بند رهایی یابد و زنده شود."],[199,"گاو نفس خویش را زوتر بکش","تا شود روح خفی زنده و بهش","باید سریع‌تر نفس خود را کنترل کنی تا روح پنهان و عمیق تو زنده و به حالتی خوب برسد."],[200,"چون رسیدند آن نفر نزدیک او","بانگ بر زد هی کیانید اتقو","زمانی که آن افراد به نزد ذاالنون رسیدند، با صدای بلند فریاد زدند که «ای کسان، آگاه باشید!"],[200,"با ادب گفتند ما از دوستان","بهر پرسش آمدیم اینجا بجان","با زبان مودبانه گفتند که ما به خاطر پرسش و یادگیری، از دوستان به اینجا آمده‌ایم."],[200,"چونی ای دریای عقل ذو فنون","این چه بهتانست بر عقلت جنون","ای عقل دانا و پرظرفیت، چرا به تو این نسبت جنون داده‌اند؟ این چه اتهامی است که به تو می‌زنند؟"],[200,"دود گلخن کی رسد در آفتاب","چون شود عنقا شکسته از غراب","دود جمع‌شده در کوره مانند شعله‌ای در آفتاب نمی‌تواند دیده شود. همچنین مانند پرنده‌ی افسانه‌ای عنقا که در برابر زاغ شکسته و بی‌جلا می‌شود، فضا و اوضاع دیگرانی که در حالت جمود و محدودیت هستند، نمی‌تواند به زیبایی و تابش بیشتری برسد."],[200,"وا مگیر از ما بیان کن این سخن","ما محبانیم با ما این مکن","ما را ترک نکن و این حرف را بگو که ما عاشقان هستیم، با ما این رفتار را نکن."],[200,"مر محبان را نشاید دور کرد","یا بروپوش و دغل مغرور کرد","محبان (عاشقان) را نمی‌توان دور کرد و نباید به وسیله فریب و نیرنگ، آنها را گمراه ساخت."],[200,"راز را اندر میان آور شها","رو مکن در ابر پنهانی مها","ای پادشاه، راز را در میان مردم بگو و آن را در ابر پنهان نکن؛ یعنی نباید حقایق را نهان کرد و باید به‌وضوح بیان شوند."],[200,"ما محب و صادق و دل خسته‌ایم","در دو عالم دل به تو در بسته‌ایم","ما عاشق و شفاف و دل‌شکسته‌ایم و در هر دو جهان، دل‌مان به تو بسته است."],[200,"فحش آغازید و دشنام از گزاف","گفت او دیوانگانه زی و قاف","آن مرد به آرامی شروع به فحش و دشنام گفتن کرد و به طور بی‌مورد و دیوانه‌وار سخنانی گفت که مفهوم خاصی نداشت."],[200,"بر جهید و سنگ پران کرد و چوب","جملگی بگریختند از بیم کوب","آن مرد ناگهان بلند شد و سنگی به سمت دیگران انداخت و با چوب به آن‌ها حمله کرد، به طوری که همه از ترس فرار کردند."],[200,"قهقهه خندید و جنبانید سر","گفت باد ریش این یاران نگر","با صدای بلند خندید و سرش را جنباند و گفت: «ببین چگونه باد، ریش این دوستان را می‌جنباند.» این اشاره به بی‌ثباتی و ناپایداری حالت دوستان دارد."],[200,"دوستان بین کو نشان دوستان","دوستان را رنج باشد همچو جان","دوستان را در این بیت نشان دهید، زیرا برای دوستان، رنج و سختی وجود دارد که مانند جان برای آنها ارزشمند است."],[200,"کی کران گیرد ز رنج دوست دوست","رنج مغز و دوستی آن را چو پوست","دوست را نمی‌توان از رنج و ناراحتی جدا کرد، زیرا رنج برای دوست همانند مغز است و دوستی مانند پوست؛ بنابراین، رنج و دوستی به هم وابسته‌اند."],[200,"نی نشان دوستی شد سرخوشی","در بلا و آفت و محنت‌کشی","دوستی واقعی در زمان سختی و مشقت آشکار می‌شود و به انسان خوشحالی و سرخوشی می‌بخشد، حتی در مواجهه با مصیبت و درد."],[200,"دوست همچون زر بلا چون آتشست","زر خالص در دل آتش خوشست","دوست در زمان سختی و مشکلات مانند طلا درون آتش است؛ گرچه آتش برای طلا دردسر و آزمایش می‌آورد، اما در دل آتش، طلا خالص و ارزشمندتر می‌شود."],[201,"نی که لقمان را که بنده پاک بود","روز و شب در بندگی چالاک بود","لقمان، که بنده‌ای پاک و نیکو است، همیشه در خدمت و بندگی خدا مشغول و پرانرژی بود."],[201,"خواجه‌اش می‌داشتی در کار پیش","بهترش دیدی ز فرزندان خویش","اگر لقمان را به عنوان خدمتکاری در نظر گرفته‌ای، او را در امور خود بهتر از فرزندان خود می‌بینی. این بیانگر توانایی و لیاقت لقمان در کارهاست."],[201,"زانک لقمان گرچه بنده‌زاد بود","خواجه بود و از هوا آزاد بود","هرچند لقمان از خانواده پایین‌تری به دنیا آمده بود و به عنوان بنده شناخته می‌شد، اما او شریف و بزرگ‌مقام بود و از خواسته‌ها و تمایلات دنیا رهایی یافته بود."],[201,"گفت شاهی شیخ را اندر سخن","چیزی از بخشش ز من درخواست کن","شاه به لقمان، که یک شیخ و حکیم است، می‌گوید که از من چیزی در مورد بخشش و عطا بخواه."],[201,"گفت ای شه شرم ناید مر ترا","که چنین گویی مرا زین برتر آ","لقمان به شاه می‌گوید: ای پادشاه، آیا برای تو ننگ نیست که چنین سخن می‌گویی و مرا از خود برتر می‌پنداری؟"],[201,"من دو بنده دارم و ایشان حقیر","وآن دو بر تو حاکمانند و امیر","من دو بنده دارم که بسیار ناتوان و حقیر هستند، اما آن دو بر تو تسلط دارند و بر تو حکومت می‌کنند."],[201,"گفت شه آن دو چه‌اند این زلتست","گفت آن یک خشم و دیگر شهوتست","شاه پرسید آن دو چه چیز هستند که باعث زلت (سقوط و انحطاط) می‌شوند، و لقمان پاسخ داد: یکی خشم است و دیگر شهوت."],[201,"شاه آن دان کو ز شاهی فارغست","بی مه و خورشید نورش بازغست","ملوک، کسی که از مقام و سلطنت خود بی‌نیاز است، مانند خورشید و ماه، منبع نوری درخشان و واضح است."],[201,"مخزن آن دارد که مخزن ذات اوست","هستی او دارد که با هستی عدوست","آدمی که در دلش حقیقت و معرفت وجود دارد، در واقع آنچه را که در خود دارد، از عمق وجودش برمی‌آید و با حقیقی وجودش دست به دشمنی نمی‌زند."],[201,"خواجه لقمان بظاهر خواجه‌وش","در حقیقت بنده لقمان خواجه‌اش","خواجه لقمان به ظاهر نسیب مقام و احترامی دارد، اما در واقع منش و حقیقت او، بندگی لقمان است."],[201,"در جهان بازگونه زین بسیست","در نظرشان گوهری کم از خسیست","در جهان چیزهای زیادی وجود دارد، اما برای افراد نادان، ارزش آن‌ها بیشتر از یک دانه‌ی بی‌ارزش به نظر نمی‌رسد."],[201,"مر بیابان را مفازه نام شد","نام و رنگی عقلشان را دام شد","بیابان به نام «مفازه» (مفاز، محلی بی آب و علف) معروف شده است و عقل آنها به رنگ و شکل خاصی درآمده که به آن‌ها دام می‌زند و آن‌ها را در تنگنا قرار می‌دهد."],[201,"یک گره را خود معرف جامه است","در قبا گویند کو از عامه است","روشی که یک گروه را شناسایی می‌کنند، لباس و پوشش آن‌هاست؛ در ظاهر، کسی را که از جمعیت عامه جدا است، با همین لباس می‌شناسند."],[201,"یک گره را ظاهر سالوس زهد","نور باید تا بود جاسوس زهد","گروهی از مردم به خاطر ظاهر زهد و دینداری، واسطه‌ای برای شناخت افراد نیکوکار هستند. برای تشخیص واقعی افراد با ایمان، لازم است که نور و حقیقت زهد در دل آن‌ها وجود داشته باشد."],[201,"نور باید پاک از تقلید و غول","تا شناسد مرد را بی فعل و قول","انسان باید از تقلید و تقلب دور باشد و به صفای درون برسد تا بتواند دیگران را صرف‌نظر از رفتار و گفتارشان بشناسد."],[201,"در رود در قلب او از راه عقل","نقد او بیند نباشد بند نقل","انسانی که با عقل و درایت عمل کند، می‌تواند حقیقت را در دل خود درک کند و در این حالت، نیازی به سخنان دیگران برای فهم آن ندارد."],[201,"بندگان خاص علام الغیوب","در جهان جان جواسیس القلوب","بندگان خاص خداوند که به علم غیب آگاهند، در دنیا مانند جاسوسانی هستند که به اسرار درون دل‌ها و نیات دیگران آگاه می‌شوند."],[201,"در درون دل در آید چون خیال","پیش او مکشوف باشد سر حال","در دل انسان، زمانی که خیال و اندیشه‌ای به وجود می‌آید، آن اندیشه برای خداوند که خبر از همه چیز دارد، روشن و آشکار است."],[201,"در تن گنجشک چیست از برگ و ساز","که شود پوشیده آن بر عقل باز","در وجود گنجشک، چه چیزهایی از برگ و نوا پنهان است که عقل قادر به فهم آن‌ها نیست؟"],[201,"آنک واقف گشت بر اسرار هو","سر مخلوقات چه بود پیش او","کسی که به اسرار و رازهای خلقت آگاه شد، دیگر نزد او چه چیزی اهمیت دارد و چه درسی ممکن است بیاموزد؟"],[201,"آنک بر افلاک رفتارش بود","بر زمین رفتن چه دشوارش بود","خداوند در آسمان‌ها و عالم بالا با ویژگی‌های خاص خود در حال فعالیت است، اما کار کردن بر روی زمین و مواجهه با مشکلات آن برای او چندان آسان نیست."],[201,"در کف داود کاهن گشت موم","موم چه بود در کف او ای ظلوم","داود، پیامبر و پادشاه اسرائیل، در دستش موم داشت. این موم چه چیزی بود که من، ظلوم (یعنی فریب خورده)، از آن بی‌خبر هستم؟"],[201,"بود لقمان بنده‌شکلی خواجه‌ای","بندگی بر ظاهرش دیباجه‌ای","لقمان، در ظاهر مانند یک بنده و نوکر، خود را نشان می‌دهد، ولی در باطن، دارای همانندی با یک صاحب‌منصب و عالی‌مقام است."],[201,"چون رود خواجه به جای ناشناس","در غلام خویش پوشاند لباس","وقتی خواجه به مکان ناشناسی برود، لباس غلام خود را بر تن او می‌پوشاند."],[201,"او بپوشد جامه‌های آن غلام","مر غلام خویش را سازد امام","او (خواجه لقمان) لباس آن غلام را می‌پوشد تا آن غلامش را پیشوای خود قرار دهد."],[201,"در پیش چون بندگان در ره شود","تا نباید زو کسی آگه شود","وقتی که او در میان بندگان قرار می‌گیرد و گامی به جلو می‌برد، نباید کسی از حضور او باخبر شود."],[201,"گوید ای بنده تو رو بر صدر شین","من بگیرم کفش چون بنده کهین","لقمان به بنده می‌گوید: ای بنده، تو بر صدر بنشین، من مثل یک بنده کهنه، کفش تو را می‌گیرم."],[201,"تو درشتی کن مرا دشنام ده","مر مرا تو هیچ توقیری منه","تو نازک‌خویی کن و به من فحش بده، هرگز مرا کوچک و بی‌ارزش نشمار."],[201,"ترک خدمت خدمت تو داشتم","تا به غربت تخم حیلت کاشتم","من از خدمت تو منصرف شدم و در غربت به کاشتن دانه فریب و نیرنگ پرداختم."],[201,"خواجگان این بندگیها کرده‌اند","تا گمان آید که ایشان بنده‌اند","خواجگان (آزادمردان) این کارها را انجام داده‌اند تا دیگران گمان کنند که آن‌ها بنده و مطیع هستند."],[201,"چشم‌پر بودند و سیر از خواجگی","کارها را کرده‌اند آمادگی","آن‌ها با نگاهی پر از طمع و آرزو، به‌خاطر مقام و جایگاه خود هیچ گاه سیر نمی‌شوند و آماده‌اند تا هر کاری را برای حفظ خواجگی و مقام خود انجام دهند."],[201,"وین غلامان هوا بر عکس آن","خویشتن بنموده خواجه عقل و جان","این غلامان نفس، بر خلاف آنچه که واقعا هستند، خود را به عنوان صاحبان عقل و جان به نمایش می‌گذارند."],[201,"آید از خواجه ره افکندگی","ناید از بنده به غیر بندگی","از خواجه (لقمان) انتظار می‌رود که به دیگران کمک کند و در مشکلات آن‌ها را یاری دهد، اما بنده نمی‌تواند جز در چارچوب بندگی و خدمت به او عمل کند."],[201,"پس از آن عالم بدین عالم چنان","تعبیتها هست بر عکس این بدان","پس از آنکه عالم (لقمان) از عالم دیگر به این دنیا آمده، تعبیرها و نشانه‌های او در اینجا به‌گونه‌ای کاملا متفاوت و برعکس است."],[201,"خواجه لقمان ازین حال نهان","بود واقف دیده بود از وی نشان","لقمان که شخصیت حکیم و عاقل است، از این وضعیت پنهان بود و در واقع به دلایلی که خودش می‌دانست، نشان‌هایی از او را مشاهده کرده بود."],[201,"راز می‌دانست و خوش می‌راند خر","از برای مصلحت آن راه‌بر","لقمان از راز واقف بود و بر خر سوار می‌شد تا با مصلحتی که در نظر داشت، راه‌بردی کند."],[201,"مر ورا آزاد کردی از نخست","لیک خشنودی لقمان را بجست","خواجه و صاحب لقمان میخواست او را همان ابتدا آزاد کند اما چون او را خیلی دوست داشت و میخواست دایما به او رسیدگی کند این بود که او را به ظاهر بنده خودش نگاه داشت تا بتواند دایما به لقمان خدمتی کند. بخش بعدی این داستان که داستان خربزه خوردن لقمان است این مطلب را بهتر آشکارا میکند."],[201,"زانک لقمان را مراد این بود تا","کس نداند سر آن شیر و فتی","لقمان هدفش این بود که هیچ‌کس از راز آن شیر و فتی (مرد جوان) مطلع نشود."],[201,"چه عجب گر سر ز بد پنهان کنی","این عجب که سر ز خود پنهان کنی","میگوید،این عجیب نیست که انسان سر درونی اش و ذاتش را از بدان مخفی کند،اما این عجیب است که سر و ذات والایی داشته باشی و آن را از خودت هم مخفی بداری یعنی به آن بی توجه باشی"],[201,"کار پنهان کن تو از چشمان خود","تا بود کارت سلیم از چشم بد","کارهای بزرگ خودت را از چشم خودت بینداز و کوچک بشمار تا همه کارهایت به سلامت انجام پذیرد"],[201,"خویش را تسلیم کن بر دام مزد","وانگه از خود بی ز خود چیزی بدزد","پیچیده ترین بیت این بخش است. احتمالا با توجه به ابیات پیشین و ماجرای کلی لقمان میگوید که ابتدا دست از جایگاه بلند خود بکش و بنده وار برای مزد حاضر به خدمت و زندگی باش، مثل خواجه ای که جایش را با برده اش عوض میکند تا مخفیانه در غربت بسر برد، تو هم مخفیانه در حالی که از خود بی خودی، از خود) احتمالا منیت و خوخواهی ات( چیزی بدزد و بکاه"],[201,"می‌دهند افیون به مرد زخم‌مند","تا که پیکان از تنش بیرون کنند","به مردی که زخم دارد، افیونی می‌دهند تا با این دارو او را بی‌حس کرده و بتوانند پیکان را از تنش خارج کنند."],[201,"وقت مرگ از رنج او را می‌درند","او بدان مشغول شد جان می‌برند","در زمان مرگ، به جای اینکه به درد و رنج او توجه کنند، او را اذیت می‌کنند و به این وضعیت ادامه می‌دهند؛ در حالی که جان او را می‌گیرند و او همچنان درگیر مشکلات خود است."],[201,"چون به هر فکری که دل خواهی سپرد","از تو چیزی در نهان خواهند برد","هر زمان که دل را به یک فکر مشغول کنی، از وجود تو چیزی پنهانی می‌ستانند."],[201,"پس بدان مشغول شو کان بهترست","تا ز تو چیزی برد کان کهترست","بهتر است که به همان کاری مشغول شوی که موجب آگاهی و درک بالاتری می‌شود، تا اینکه چیزی از تو به سرقت برود که ارزشی کمتر دارد."],[201,"هرچه تحصیلی کنی ای معتنی","می در آید دزد از آن سو کایمنی","هرچه تحصیل و دانشی به‌دست آوری، ای کسی که به خودت اهمیت می‌دهی، در واقع از طرفی دیگر ممکن است نوعی آسیب و دزدی به تو برسد که امنیت تو را تهدید می‌کند."],[201,"بار بازرگان چو در آب اوفتد","دست اندر کاله بهتر زند","وقتی بار بازرگان در آب بیفتد، باید به دنبال کالای بهتر و با کیفت‌تر بگردد و دست به تلاش برای پیدا کردن آن بزند."],[201,"چونک چیزی فوت خواهد شد در آب","ترک کمتر گوی و بهتر را بیاب","وقتی چیزی در آب گم می‌شود، کمتر حرف بزن و به جای آن بهتر و مناسب‌تر را پیدا کن."],[202,"هر طعامی کآوریدندی به وی","کس سوی لقمان فرستادی ز پی","هر غذایی که به لقمان می‌آوردند، افرادی برای او می‌فرستادند تا ببینند او چه واکنشی نشان می‌دهد."],[202,"تا که لقمان دست سوی آن برد","قاصدا تا خواجه پس‌خوردش خورد","لقمان وقتی که دستش را به سمت آن غذا برد، خواجه (امتحان‌کننده) از او خواست که باقی‌مانده را بخورد."],[202,"سؤر او خوردی و شور انگیختی","هر طعامی کو نخوردی ریختی","هر غذایی را که لقمان آزمایش کرده بود, خواجه میخورد و اگر غذایی را لقمان آزمایش نکرده بود خواجه نمیخورد و دور میریخت"],[202,"ور بخوردی بی دل و بی اشتها","این بود پیوندی بی انتها","اگر کسی بدون میل و اشتیاق غذا بخورد، این نشان‌دهنده پیوندی بی‌پایان است، به این معنا که آن شخص هیچ لذتی از خوردن نمی‌برد و در واقع این عمل، بی‌احساس و بدون دلیلی عمیق است."],[202,"خربزه آورده بودند ارمغان","گفت رو فرزند لقمان را بخوان","لقمان را که فرزندش است، گفته‌اند که خربزه‌ای را به عنوان هدیه آورده‌اند."],[202,"چون برید و داد او را یک برین","همچو شکر خوردش و چون انگبین","لقمان وقتی که خربزه را برید و به فرزندش داد، آن‌قدر خوشمزه بود که او همچون شکر آن را خورد و مانند انگبین (عسل) لذت برد."],[202,"از خوشی که خورد داد او را دوم","تا رسید آن گرچها تا هفدهم","لقمان از شادی و لذت خوردن، بلافاصله فرصت دیگری برای خوردن به چنگ آورد و تا رسیدن به مرحله هفدهم، همچنان در این خوشی غوطه‌ور بود."],[202,"ماند گرچی گفت این را من خورم","تا چه شیرین خربزه‌ست این بنگرم","با وجود اینکه لقمان این را گفت که من این خربزه را می‌خورم، اما می‌خواهم ببینم تا چه حد شیرین است."],[202,"او چنین خوش می‌خورد کز ذوق او","طبعها شد مشتهی و لقمه‌جو","لقمان آن‌قدر با اشتها و لذت غذا می‌خورد که دیگران هم از لذت او مشتاق می‌شوند و به دنبال لقمه می‌روند."],[202,"چون بخورد از تلخیش آتش فروخت","هم زبان کرد آبله هم حلق سوخت","وقتی لقمان از غذاهای تلخ خورد، به شدت عذاب کشید و زبانش به نشانه درد دچار زخم و آتش‌سوزی شد و گلویش نیز سوخت."],[202,"ساعتی بی‌خود شد از تلخی آن","بعد از آن گفتش که ای جان و جهان","ساعتی به خاطر تلخی آن تجربه (که اشاره به تلخی‌های زندگی دارد) بی‌خود و گیج شد و بعد از این، به خود گفت که ای جان و جهان."],[202,"نوش چون کردی تو چندین زهر را","لطف چون انگاشتی این قهر را","تو چگونه می‌توانی پس از آن همه زهر، حالا طعم خوشی را احساس کنی و این قهر و سختی را لطف بنامید؟"],[202,"این چه صبرست این صبوری ازچه روست","یا مگر پیش تو این جانت عدوست","کسی از لقمان می‌پرسد که این صبر و شکیبایی تو از کجا ناشی می‌شود، آیا شاید این روح و جان تو نسبت به تو دشمنی دارد و موجب این صبر شده است؟"],[202,"چون نیاوردی به حیلت حجتی","که مرا عذریست بس کن ساعتی","چون نتوانستی با زیرکی دلیل قانع‌کننده‌ای بیاوری که مرا توجیه کند، فعلا برای مدتی دست از سرم بردار."],[202,"گفت من از دست نعمت‌بخش تو","خورده‌ام چندان که از شرمم دوتو","لقمان می‌گوید که از نعمت‌های تو آن‌قدر بهره‌مند شده‌ام که باعث شرمم شده، و اکنون دوستی و رفتار خوب تو مرا به شدت شرمنده کرده است."],[202,"شرمم آمد که یکی تلخ از کفت","من ننوشم ای تو صاحب‌معرفت","احساس شرم می‌کنم که برای من که تو را می‌شناسم، فقط یک تلخی از دست تو بنوشم."],[202,"چون همه اجزام از انعام تو","رسته‌اند و غرق دانه و دام تو","از آنجا که همه بندگان از نعمت‌های تو بی‌بهره‌ شده و گرفتار دانه و دام تو هستند، شرم دارم که چیزی از تلخی را بگویم."],[202,"گر ز یک تلخی کنم فریاد و داد","خاک صد ره بر سر اجزام باد","اگر من به خاطر یک تلخی حق خود را طلب کنم و فریاد بزنم، باید بدانم که خاک زمین صد بار بر سر اجزای وجودم فرود خواهد آمد."],[202,"لذت دست شکربخشت بداشت","اندرین بطیخ تلخی کی گذاشت","اگر کسی در زندگی خود به تلخی‌های مختلفی برخورد کند، باید بپذیرد که خوشی‌ها و لذت‌های واقعی، حتی در دل تلخی‌ها، وجود دارند و در این تلخی‌ها نیز می‌توان شیرینی و لذت را یافت."],[202,"از محبت تلخها شیرین شود","از محبت مسها زرین شود","از محبت، چیزهای تلخ به شیرینی تبدیل می‌شوند و چیزهای بی‌ارزش مثل مس، به چیزی باارزش مانند طلا بدل می‌شوند."],[202,"از محبت دردها صافی شود","از محبت دردها شافی شود","محبت باعث می‌شود که دردها و رنج‌ها پاک و خالص شوند و همچنین محبت بهبوددهنده و درمان‌کننده‌ی دردهاست."],[202,"از محبت مرده زنده می‌کنند","از محبت شاه بنده می‌کنند","از محبت، کسانی که مرده‌اند زنده می‌شوند و محبت باعث می‌شود که بنده‌ای در برابر شاه به پا خیزد و به او خدمت کند."],[202,"این محبت هم نتیجه دانشست","کی گزافه بر چنین تختی نشست","این محبت که درباره‌اش صحبت می‌شود، ناشی از دانش و آگاهی است و بی‌سبب به چنین مقام و جایگاهی نمی‌رسد."],[202,"دانش ناقص کجا این عشق زاد","عشق زاید ناقص اما بر جماد","دانش ناقص نمی‌تواند عشق حقیقی را تولید کند، زیرا عشق از نوع ناقص زاده نمی‌شود، اما عشق می‌تواند وجود بیابد حتی در اشیای بی‌جان."],[202,"بر جمادی رنگ مطلوبی چو دید","از صفیری بانگ محبوبی شنید","وقتی جماد (اجسام بی‌جان) رنگ زیبا و دلخواهی را دید، از صدای نی (صدای نغمه‌سرا) آوای محبوبی را شنید."],[202,"دانش ناقص نداند فرق را","لاجرم خورشید داند برق را","دانش ناقص قادر به تشخیص تفاوت‌ها نیست، بنابراین خورشید می‌داند که برق چیست و آن را می‌شناسد."],[202,"چونک ملعون خواند ناقص را رسول","بود در تاویل نقصان عقول","هرگاه ناقص‌العقل را ملعون بخوانند، او در حقیقت رسالت را در تفسیر ناتوانی ذهن‌های افراد دیگر بر عهده دارد."],[202,"زانک ناقص‌تن بود مرحوم رحم","نیست بر مرحوم لایق لعن و زخم","چون بدن ناقص و ناتوان است، نمی‌توان بر کسی که جانش رفته و مرده، هر چند که ناقص بوده، رحم نکرد و او را مورد لعن و آزار قرار داد."],[202,"نقص عقلست آن که بد رنجوریست","موجب لعنت سزای دوریست","نقصان عقل باعث می‌شود که انسان در رنج و عذاب به سر ببرد و این رنج و عذاب می‌تواند موجب لعنت و عاقبت‌سختی برای او شود."],[202,"زانک تکمیل خردها دور نیست","لیک تکمیل بدن مقدور نیست","تکمیل و کمال عقل و خرد به سادگی و با تلاش به‌دست‌آمدنی است، اما رسیدن به کمال و تمامیت در بدن امکان‌پذیر نیست و این کار سختی است."],[202,"کفر و فرعونی هر گبر بعید","جمله از نقصان عقل آمد پدید","کافر و فرعون، هر انسانی که پیرو بت‌پرستی باشد و به حقیقت نرسیده، به خاطر کمبود عقل و خرد خود، از نقص عقل واضحی برخوردار است."],[202,"بهر نقصان بدن آمد فرج","در نبی که ما علی الاعمی حرج","به دلیل ناتوانی و نقصانی که در بدن هر فردی وجود دارد، در وجود نبی (پیامبران) که ما (پیروان) بر عمیان (نابینایان) مشکلی نمی‌بینیم، شادمانی و نجات وجود دارد."],[202,"برق آفل باشد و بس بی وفا","آفل از باقی ندانی بی صفا","برق، به معنای نیرنگ یا ظاهری فریبنده، فریبنده و ناپایدار است و نمی‌توان به چیزی که فقط ظاهری زیبا دارد و بی وفا است، اعتماد کرد. در واقع، از چیزهای ظاهری نباید انتظار صداقت یا دوام داشت."],[202,"برق خندد بر کی می‌خندد بگو","بر کسی که دل نهد بر نور او","برق، که نماد زیبایی و جذابیت است، برای چه کسی می‌خندد؟ او بر کسی می‌خندد که دلش را به نور و روشنی او می‌سپارد."],[202,"نورهای چرخ ببریده‌پیست","آن چو لا شرقی و لا غربی کیست","نورهای آسمانی که در حالتی بریده از هم به نظر می‌رسند، در اینجا به معنای حقیقتی است که نه به شرق تعلق دارد و نه به غرب. این نورها نماد معرفت و روشنایی هستند، که از هر دو طرف جدا و مستقل‌اند و اشاره به وجودی دارد که فراتر از این تقسیمات جغرافیایی و فرهنگی است."],[202,"برق را خو یخطف الابصار دان","نور باقی را همه انصار دان","برق را بسانی می‌دانند که چشم‌ها را به خود خیره می‌کند، اما نور واقعی و باقی را همه پیروان و حامیان می‌شناسند."],[202,"بر کف دریا فرس را راندن","نامه‌ای در نور برقی خواندن","راندن اسب بر روی سطح دریا مانند این است که کسی نامه‌ای را در درخشش نور بخواند؛ این کارها هم بسیار دشوار و ناممکن به نظر می‌رسند."],[202,"از حریصی عاقبت نادیدنست","بر دل و بر عقل خود خندیدنست","حریص، در نهایت نمی‌تواند عاقبت‌نگر باشد و این نادانی او باعث می‌شود که به دل و عقل خود بخندد و به آن‌ها بی‌اعتنا باشد."],[202,"عاقبت بینست عقل از خاصیت","نفس باشد کو نبیند عاقبت","در نهایت، عقل به وضوح می‌بیند که نادانی از ویژگی نفس است؛ زیرا نفس نمی‌تواند عواقب کارها را ببیند."],[202,"عقل کو مغلوب نفس، او نفس شد","مشتری مات زحل شد نحس شد","عقل اگر تحت تاثیر نفس قرار بگیرد و تسلیم آن شود، به نوعی فریب می‌خورد و به ناکامی می‌رسد، مانند وضع سیاره زحل که در باورهای قدیمی به عنوان نجومی نحس تلقی می‌شود."],[202,"هم درین نحسی بگردان این نظر","در کسی که کرد نحست در نگر","در این بیت گفته می‌شود که در این بدبختی، نگاه خود را به کسی که در آنجا بدی کرده است، برگردان. یعنی به جای اینکه فقط به بدی‌ها توجه کنی، باید به کسی که عامل آن هست نگاه کنی و او را در نظر بگیری."],[202,"آن نظر که بنگرد این جر و مد","او ز نحسی سوی سعدی نقب زد","نگاهی که به این کشمکش و جدال می‌اندازد، از شومی به خوشبختی تغییر می‌کند. آن نگاهی که این تناقضات را مشاهده می‌کند، در نهایت به سوی موفقیت خواهد رفت."],[202,"زان همی‌گرداندت حالی به حال","ضد به ضد پیداکنان در انتقال","این بیت می‌گوید که انسان‌ها به دلیل تغییرات مداوم وضعیت‌ها و احساساتشان، از حالتی به حالت دیگر می‌چرخند، به طوری که تناقضات درونیشان را به وضوح نشان می‌دهند."],[202,"تا که خوفت زاید از ذات الشمال","لذت ذات الیمین یرجی الرجال","تنها زمانی می‌توانی از لذت‌های خوب و نیکو بهره‌مند شوی که از غفلت و خواب غفلت بیدار شوی. در این حالت، افراد شایسته و بزرگ (رجال) به تو امید خواهند داشت و به تو یاری خواهند داد."],[202,"تا دو پر باشی که مرغ یک پره","عاجز آید از پریدن ای سره","تا زمانی که بال‌های دوگانه داشته باشی، مرغی که تنها یک بال دارد، در پرواز کردن ناتوان خواهد بود."],[202,"یا رها کن تا نیایم در کلام","یا بده دستور تا گویم تمام","به من بگو که حرفی نزنم و بی‌حرف بروم، یا اگر لازم است، اجازه بده که به طور کامل صحبت کنم."],[202,"ورنه این خواهی نه آن فرمان تراست","کس چه داند مر ترا مقصد کجاست","اگر تو این کار را نخواهی، پس آن فرمانی که به تو داده شده است مطابقت ندارد. هیچ‌کس نمی‌داند که مقصد تو به کجا می‌رسد."],[202,"جان ابراهیم باید تا به نور","بیند اندر نار فردوس و قصور","ابراهیم (پیامبر) باید در آتش بیفتد تا بتواند در نور حقیقت و زیبایی بهشتی و مکان‌های بزرگ الهی را ببیند."],[202,"پایه پایه بر رود بر ماه و خور","تا نماند همچو حلقه بند در","انسان باید به قدری بر فراز و در اوج باشد که هرگز مانند حلقه‌ای که به چیزی بند باشد، در قید و بند چیزی نماند."],[202,"چون خلیل از آسمان هفتمین","بگذرد که لا احب الافلین","وقتی خلیل (ابراهیم) از آسمان هفتم بگذرد، به این معناست که او دیگر به دنیا و زندگی مادی علاقه‌ای ندارد و به مرتبه‌ای والا و فراتر از دنیا می‌رسد."],[202,"این جهان تن غلط‌انداز شد","جز مر آن را کو ز شهوت باز شد","این جهان جسمانی فریبنده است و جز آنچه که از آن جدا شود و تحت تأثیر شهوت نباشد، حقیقت ندارد."],[203,"قصه شاه و امیران و حسد","بر غلام خاص و سلطان خرد","این بیت به قصه‌ای اشاره دارد که در آن شاه و امیران به غلام خاص و همچنین حکمت و خرد سلطان حسد می‌ورزند."],[203,"دور ماند از جر جرار کلام","باز باید گشت و کرد آن را تمام","باید از حواشی و بحث‌های غیرضروری دور شد و دوباره به موضوع اصلی بازگشت و آن را به پایان رساند."],[203,"باغبان ملک با اقبال و بخت","چون درختی را نداند از درخت","باغبان که نماینده ملک و بخت است، وقتی درختی را نمی‌شناسد، مثل این است که درختی با خصوصیات مختلف و خاص برای او بی‌ارزش است."],[203,"آن درختی را که تلخ و رد بود","و آن درختی که یکش هفصد بود","در این بیت به مقابلۀ دو درخت اشاره می‌شود؛ یکی درختی که تلخ و بی‌ثمر است و دیگری درختی که میوه‌اش فراوان و با ارزش است. این تفاوت درثمر‌دهی درختان می‌تواند نماد تفاوت‌ها و انتخاب‌های زندگی باشد."],[203,"کی برابر دارد اندر تربیت","چون ببیندشان به چشم عاقبت","کسی که در تربیت و پرورش استعدادهای انسان‌ها دقت می‌کند، وقتی عاقبت کار آن‌ها را می‌بیند، چگونه می‌تواند آنها را با هم برابر ببیند؟"],[203,"کان درختان را نهایت چیست بر","گرچه یکسانند این دم در نظر","درختان هرچند در ظاهر یکسان به نظر می‌رسند، اما در نهایت به نتیجه و مقصد متفاوتی خواهند رسید."],[203,"شیخ کو ینظر بنور الله شد","از نهایت وز نخست آگاه شد","هر کسی که به نور خدا نگاه کند، از نهایت و اول امر آگاه می‌شود و به حقیقت‌ها پی می‌برد."],[203,"چشم آخربین ببست از بهر حق","چشم آخربین گشاد اندر سبق","چشم آخر بین (مورخی) خود را برای رسیدن به حق بست و به جای آن، چشم حقیقت‌بین را گشود تا جلوتر از دیگران برود."],[203,"آن حسودان بد درختان بوده‌اند","تلخ گوهر شوربختان بوده‌اند","حسودان مانند درختان بدی هستند که میوه تلخ دارند و از شانس بد خود رنج می‌برند."],[203,"از حسد جوشان و کف می‌ریختند","در نهانی مکر می‌انگیختند","حسودان به طور نهان از شدت حسد، جوش و خروش زیادی داشتند و در خفا نقشه و مکر می‌کشیدند."],[203,"تا غلام خاص را گردن زنند","بیخ او را از زمانه بر کنند","برای اینکه غلام خاص را به قتل برسانند، ریشه و اساس او را از دنیای زمانه قطع می‌کنند."],[203,"چون شود فانی چو جانش شاه بود","بیخ او در عصمت الله بود","وقتی که این غلام خاص از بین برود، مانند جان او را به شاهی تشبیه می‌کند که ریشه‌اش در لطف و حفاظت خداوند قرار دارد."],[203,"شاه از آن اسرار واقف آمده","همچو بوبکر ربابی تن زده","شاه به آن اسرار آگاه شده است، مانند ابو بکر ربابی که به هنر و مهارت خاصی در نواختن ساز پرداخته و در این راه حرفه‌ای شده است."],[203,"در تماشای دل بدگوهران","می‌زدی خنبک بر آن کوزه‌گران","تو در تماشای دل‌های سنگ‌دل و بدجنس، بر کوزه‌گران که ظروف سفالی می‌سازند، خنبک (آله موسیقی) می‌زدی."],[203,"مکر می‌سازند قومی حیله‌مند","تا که شه را در فقاعی در کنند","گروهی از حیله‌گران نقشه می‌کشند تا پادشاه را در چیزی بیهوده و کم‌ارزش غرق کنند."],[203,"پادشاهی بس عظیمی بی کران","در فقاعی کی بگنجد ای خران","پادشاهی بسیار بزرگ و وسیع است که در یک حوض کوچک نمی‌گنجید، ای خرها!"],[203,"از برای شاه دامی دوختند","آخر این تدبیر ازو آموختند","برای شاه دامی آماده کردند و این تدبیر را از او (پادشاه) آموختند."],[203,"نحس شاگردی که با استاد خویش","همسری آغازد و آید به پیش","نفرین بر شاگردی که با استادش هم‌پیمان شود و به او برتری جست."],[203,"با کدام استاد استاد جهان","پیش او یکسان هویدا و نهان","هیچ استادی در جهان نمی‌تواند مانند او (غلام خاص) باشد، چون او از نظر ظاهری و باطنی به اوج کمال رسیده است."],[203,"چشم او ینظر بنور الله شده","پرده‌های جهل را خارق بده","چشم او (مقصود مولانا است) با نور خداوند به حقیقت‌ها می‌نگرد و پرده‌های نادانی را کنار می‌زند."],[203,"از دل سوراخ چون کهنه گلیم","پرده‌ای بندد به پیش آن حکیم","از دل سوراخ (یعنی میان دعاوی و خواسته‌های باطلی که مانند سوراخ است) مانند کهنه گلیم (که دیگر استفاده‌ای ندارد) پرده‌ای برای آن حکیم (که معرفت و بصیرت دارد) می‌زند، یعنی خود را نادان نشان می‌دهد و نمی‌تواند به حقیقت دست یابد."],[203,"پرده می‌خندد برو با صد دهان","هر دهانی گشته اشکافی بر آن","پرده به‌گونه‌ای خندناک و با صداهای مختلف صحبت می‌کند و هر دهان به نوعی بر آن تأثیر می‌گذارد و آن را شکافته است."],[203,"گوید آن استاد مر شاگرد را","ای کم از سگ نیستت با من وفا","استاد به شاگرد می‌گوید که وفاداری تو از وفاداری یک سگ کمتر نیست."],[203,"خود مرا استا مگیر آهن‌گسل","همچو خود شاگرد گیر و کوردل","به من نگویید استاد، زیرا من نیز مانند شما شاگرد و ناتوان هستم. بهتر است به دنبال افرادی باشید که از خودتان کم‌هوش‌تر هستند."],[203,"نه از منت یاریست در جان و روان","بی منت آبی نمی‌گردد روان","یاری و کمک تنها از روی منت و بخشش نیست، بلکه در روح و روان انسان باید به‌طور واقعی و بدون انتظار پاداش باشد. مانند آبی که بدون تلاش و زحمت به وجود نمی‌آید، روح نیز بدون حقیقت و خلوص زنده نمی‌ماند."],[203,"پس دل من کارگاه بخت تست","چه شکنی این کارگاه ای نادرست","دل من محل و کارگاه سرنوشت توست، چرا این کارگاه نادرست را خراب می‌کنی؟"],[203,"گوییش پنهان زنم آتش‌زنه","نی به قلب از قلب باشد روزنه","سخنانم را پنهان می‌کنم و مانند چشمه‌ای که آتش برافروزد، به دل خود می‌زنم، زیرا روزنه‌ای که به قلب می‌رسد، از دل سرچشمه می‌گیرد."],[203,"آخر از روزن ببیند فکر تو","دل گواهیی دهد زین ذکر تو","در نهایت، از پنجره دل، افکار تو دیده می‌شود و دل به خاطر یاد تو شهادتی می‌دهد."],[203,"گیر در رویت نمالد از کرم","هرچه گویی خندد و گوید نعم","هرگز بر چهره‌ات از روی نیکی و مهربانی نمالد، بلکه هر چه بگویی او فقط می‌خندد و می‌گوید بله."],[203,"او نمی‌خندد ز ذوق مالشت","او همی‌خندد بر آن اسگالشت","او از خوشحالی و شوق به نوازش تو نمی‌خندد، بلکه بر روی آن سگ (که به او حسادت می‌کند) می‌خندد."],[203,"پس خداعی را خداعی شد جزا","کاسه زن کوزه بخور اینک سزا","پس خداوند هم به خدعه و فریب پاداش می‌دهد؛ مثل این که کاسه‌زن (کسی که فقط کاسه می‌زند) سزاوار خوردن کوزه (چیزی که از آن آب می‌نوشند) است."],[203,"گر بدی با تو ورا خنده رضا","صد هزاران گل شکفتی مر ترا","اگر کسی به تو بدی کند و تو با لبخند و رضایت به او پاسخ دهی، هزاران گل در دل تو شکوفا می‌شود."],[203,"چون دل او در رضا آرد عمل","آفتابی دان که آید در حمل","هرگاه دل کسی به رضا و خوشنودی بسپارد و عملش بر اساس این راضی بودن باشد، نشانه‌ای از نور و روشنایی در وجود او پدیدار می‌شود که به مانند خورشید در آغوش مهر و محبت می‌آید."],[203,"زو بخندد هم نهار و هم بهار","در هم آمیزد شکوفه و سبزه‌زار","او (شخصی که در ابتدا به او اشاره شده) به شادی و سرزندگی می‌پردازد، به طوری که در طول روز و شب، شکوفه‌ها و چمن‌ها با هم ترکیب می‌شوند و زیبایی به وجود می‌آورند."],[203,"صد هزاران بلبل و قمری نوا","افکنند اندر جهان بی‌نوا","صدها هزار بلبل و قمری (پرنده‌هایی خوش‌آوایی) در سراسر جهان آوازهایی زیبا می‌خوانند، در حالی که خودشان در رنج و بی‌صدا هستند."],[203,"چونک برگ روح خود زرد و سیاه","می‌ببینی چون ندانی خشم شاه","وقتی که حالت روحی‌ات زرد و سیاه است و نمی‌دانی چرا خشم شاه به تو می‌خورد، به این معناست که به دلیل درون ناخوشایندت، به پریشانی مبتلا شده‌ای."],[203,"آفتاب شاه در برج عتاب","می‌کند روها سیه همچون کتاب","آفتاب شاه (خشم و قدرت پادشاه) در وضعیتی نامطلوب (برج عتاب) باعث می‌شود که چهره‌ها و روح‌ها تیره و سیاه شوند، مانند نوشته‌هایی که در کتاب دیده می‌شود."],[203,"آن عطارد را ورقها جان ماست","آن سپیدی و آن سیه میزان ماست","عطارد (سیاره‌ای در منظومه شمسی) در اینجا تشبیه به ورق‌های کتابی است که جان ما را نشان می‌دهد. سفیدی و سیاهی به عنوان معیاری برای قضاوت درباره ماست، یعنی شخصیت و رفتار ما را وامی‌نماید."],[203,"باز منشوری نویسد سرخ و سبز","تا رهند ارواح از سودا و عجز","نویسنده‌ای دیگر (عطارد) به نوشتن به رنگ‌های سرخ و سبز ادامه می‌دهد تا ارواح (روح‌های مردم) از اندوه و ناتوانی رهایی یابند."],[203,"سرخ و سبز افتاد نسخ نوبهار","چون خط قوس و قزح در اعتبار","رنگ‌های سرخ و سبز در بهار به شکل نوشته‌هایی بر زمین می‌افتند، مانند رنگ‌های قوس قزح که اعتبار و زیبایی خاصی دارند."],[204,"رحمت صد تو بر آن بلقیس باد","که خدایش عقل صد مرده بداد","خدا رحمت کند بلقیس را، زیرا او از طرف خدا عقل و بصیرتی همچون صد مرد را دریافت کرده بود."],[204,"هدهدی نامه بیاورد و نشان","از سلیمان چند حرفی با بیان","هدهدی نامه‌ای آورد که نشانی از سلیمان در آن بود و چند کلمه درباره او گفت."],[204,"خواند او آن نکته‌های با شمول","با حقارت ننگرید اندر رسول","هدهد نامه‌هایی که حاوی نکات مهم و جامع بود را خواند، اما به خاطر حقارت خود، به مقام فرستنده آن پیام (سلیمان) بی‌احترامی نکرد و در او و پیامش ننگرید."],[204,"جسم هدهد دید و جان عنقاش دید","حس چو کفی دید و دل دریاش دید","هدهد فقط جسم خود را می‌بیند، اما روحش جان پرنده‌ای فرزانه‌تری را می‌نگرد. حس او به اندازه یک کف (که به اندک چیزی اشاره دارد) است، اما دل او دریا و وسیع است."],[204,"عقل با حس زین طلسمات دو رنگ","چون محمد با ابوجهلان به جنگ","عقل مانند حس، در مواجهه با این دنیا و رازهای آن، دچار دوگانگی و پیچیدگی است؛ درست مانند محمّد (ص) که با ابوجهل و نادانی‌ها می‌جنگید."],[204,"کافران دیدند احمد را بشر","چون ندیدند از وی انشق القمر","کافران، محمد (احمد) را فقط انسانی عادی می‌دیدند، چون شگفتی و معجزه شکافتن ماه (انشقاق قمر) را از او ندیدند."],[204,"خاک زن در دیده حس‌بین خویش","دیده حس دشمن عقلست و کیش","خاکی که بر چشم حس بین خود می‌پاشی، در واقع حس، دشمن عقل است و پیرو یک آیین نادرست می‌باشد."],[204,"دیده حس را خدا اعماش خواند","بت‌پرستش گفت و ضد ماش خواند","خدا به چشم حسی که به دنیا و مادیات وابسته است، آسیب و کوری داده و آن را شایسته بت‌پرستی می‌داند و همچنین آن را مخالف با حقیقت می‌خواند."],[204,"زانک او کف دید و دریا را ندید","زانک حالی دید و فردا را ندید","چون او به جنبه‌های ظاهری و سطحی توجه دارد، نمی‌تواند عمق موقعیت را درک کند و از لحظه حال به دور است و آینده را نمی‌بیند."],[204,"خواجه فردا و حالی پیش او","او نمی‌بیند ز گنجی جز تسو","سلیمان، که خواجه فردا و حال است، برای او فقط حالت فانی و بی‌ارزش زندگی را می‌بیند و جز از گنج شایستگی و فضیلت‌های مهم نمی‌تواند درک کند."],[204,"ذره‌ای زان آفتاب آرد پیام","آفتاب آن ذره را گردد غلام","ذره‌ای از آن آفتاب (حکمت یا حقیقت) پیام آن آفتاب را به همراه می‌آورد و آن ذره از آن پس، بنده و خدمت‌گزار آن آفتاب می‌شود."],[204,"قطره‌ای کز بحر وحدت شد سفیر","هفت بحر آن قطره را باشد اسیر","قطره‌ای که از دریاچه یکتایی (خدا) به عنوان پیام‌آور بیرون می‌آید، در واقع به هفت دریا (جهان‌های مختلف) می‌رود، اما آن قطره خود را اسیر این دریاها می‌بیند."],[204,"گر کف خاکی شود چالاک او","پیش خاکش سر نهد افلاک او","اگر هم ذره‌ای از خاک آدم قوی و توانمند شود، آسمان‌ها و ستاره‌ها هم برای او سر تعظیم فرود می‌آورند."],[204,"خاک آدم چونک شد چالاک حق","پیش خاکش سر نهند املاک حق","زمانی که خاک بدن آدم (انسان) به خلوص و تندی دست یافت، آسمان‌ها و ملکوت در مقابل او سر تعظیم فرود می‌آورند."],[204,"السماء انشقت آخر از چه بود","از یکی چشمی که خاکیی گشود","آسمان در آخر از چه چیزی شکافته شد؟ از یک چشمی که انسان را از درون خاکی گشود."],[204,"خاک از دردی نشیند زیر آب","خاک بین کز عرش بگذشت از شتاب","خاک به دلیل دردی که دارد، زیر آب می‌نشیند و این نکته را باید در نظر بگیریم که خاک، در اثر شتابی که دارد، از عرش (مقام بلند) پایین آمده است."],[204,"آن لطافت پس بدان کز آب نیست","جز عطای مبدع وهاب نیست","آن نرمی و لطافتی که در آب وجود دارد، تنها به بخشش و نعمت آفریننده‌ای برمی‌گردد که سخاوت‌مند است و هیچ منبع دیگری ندارد."],[204,"گر کند سفلی هوا و نار را","ور ز گل او بگذراند خار را","اگر هوا و آتش در این دنیا بالا برود و همچنین اگر خار را بر گل بگذرانند، باز هم این لطافت و زیبایی که از جانب خداوند است، حفظ خواهد شد."],[204,"حاکمست و یفعل الله ما یشا","کو ز عین درد انگیزد دوا","خداوند، حاکم مطلق است و هر کاری بخواهد انجام می‌دهد؛ از درد و رنج، گاهی درمانی به وجود می‌آورد."],[204,"گر هوا و نار را سفلی کند","تیرگی و دردی و ثفلی کند","اگر خداوند بخواهد، می‌تواند آتش و هوا را هم به زمین بیاورد و آن‌ها را در پایین‌ترین مرتبه قرار دهد، به گونه‌ای که تاریکی و درد و پستی را به همراه داشته باشد."],[204,"ور زمین و آب را علوی کند","راه گردون را به پا مطوی کند","اگر زمین و آب را به مقام والای انسانی برساند و مسیر آسمانی را در دست بگیرد."],[204,"پس یقین شد که تعز من تشا","خاکیی را گفت پرها بر گشا","پس به‌طور قطع معلوم شد که آن کسی که می‌خواهد مقام والایی را داشته باشد، باید در وجود خود را بگشاید و از خاکی (مانند هدهد) فراتر برود."],[204,"آتشی را گفت رو ابلیس شو","زیر هفتم خاک با تلبیس شو","ابلیس به آتش دستور می‌دهد که به زیر هفتمین آسمان برود و در آنجا به فریب مردم بپردازد."],[204,"آدم خاکی برو تو بر سها","ای بلیس آتشی رو تا ثری","ای آدمی که از خاک شکل گرفته‌ای، برو به سمت سها (ستاره‌ای در آسمان) و ای ابلیس (نماد شیاطین) به آتش برو تا به ثریا (ستاره‌ای دیگر) برسی."],[204,"چار طبع و علت اولی نیم","در تصرف دایما من باقیم","ناامیدی از تغییر طبع و ذات خود، نشان‌دهنده آن است که من همیشه تحت تأثیر علل ابتدایی و عوامل طبیعی قرار دارم و نمی‌توانم بر آن‌ها تسلط پیدا کنم."],[204,"کار من بی علتست و مستقیم","هست تقدیرم نه علت ای سقیم","من بدون دلیل خاصی و به طور مستقیم عمل می‌کنم؛ تقدیر من اینگونه رقم خورده است، نه به خاطر علت یا دلیلی خاص، ای بیمار (سقیم)."],[204,"عادت خود را بگردانم بوقت","این غبار از پیش بنشانم بوقت","من عادت‌های خود را تغییر می‌دهم و به موقع غبارهای موجود را کنار می‌زنم."],[204,"بحر را گویم که هین پر نار شو","گویم آتش را که رو گلزار شو","به دریا می‌گویم که بخار شو و به آتش می‌گویم که به باغ برو و گل‌باران کن."],[204,"کوه را گویم سبک شو همچو پشم","چرخ را گویم فرو در پیش چشم","به کوه می‌گویم که سبک و سبک‌بار شو مانند پشم، و به چرخ (آسمان) می‌گویم که در برابر چشم‌ها پایین بیا."],[204,"گویم ای خورشید مقرون شو به ماه","هر دو را سازم چو دو ابر سیاه","من می‌گویم ای خورشید، به ماه ملحق شو؛ هر دو را مانند دو ابر سیاه به هم نزدیک و متصل می‌کنم."],[204,"چشمه خورشید را سازیم خشک","چشمه خون را به فن سازیم مشک","به جای چشمه نورانی و حیات‌بخش خورشید، چشمه‌ای خشک و متوقف ایجاد می‌کنیم و چشمه خونی که به نوعی نماد رنج و عذاب است، به وسایل خوشبو و معطر تبدیل می‌سازیم."],[204,"آفتاب و مه چو دو گاو سیاه","یوغ بر گردن ببنددشان اله","اگر خورشید و ماه مانند دو گاو سیاه به دوش گرفته شوند، نشان‌دهنده بار سنگین و عظیم در این دنیا است که به سختی بر دوش آن‌ها نهاده شده است."],[205,"مقریی می‌خواند از روی کتاب","ماؤکم غورا ز چشمه بندم آب","مقرئی (خواننده) از روی کتاب، آیه‌ای از قرآن را می‌خواند که در آن آمده است «کجا آب پنهان است» و من آب‌ها را از چشمه‌ها می‌بندم."],[205,"آب را در غورها پنهان کنم","چشمه‌ها را خشک و خشکستان کنم","من می‌توانم آب را در عمق زمین مخفی کنم و چشمه‌ها را خشک و بی‌آب کنم."],[205,"آب را در چشمه کی آرد دگر","جز من بی مثل و با فضل و خطر","هیچ‌کس نمی‌تواند آب را به چشمه بیاورد و آن را به‌جز من که بی‌نظیر و با استعداد و مخاطره‌آمیز هستم، نخواهد آورد."],[205,"فلسفی منطقی مستهان","می‌گذشت از سوی مکتب آن زمان","فلسفی منطقی که مورد تمسخر قرار می‌گرفت، از سمت مکانی که در آن زمان مشهور بود، عبور می‌کرد."],[205,"چونک بشنید آیت او از ناپسند","گفت آریم آب را ما با کلند","وقتی او (فلسفی منطقی) سخن ناپسند آن آیه را شنید، گفت که ما با علم و مهارت می‌توانیم آب را از پایین‌تر بیاوریم."],[205,"ما به زخم بیل و تیزی تبر","آب را آریم از پستی زبر","ما با زخم بیل و تیزی تبر، آب را از پایین­‌تر (پستی) به بالاتر می‌بریم."],[205,"شب بخفت و دید او یک شیرمرد","زد طبانچه هر دو چشمش کور کرد","او در شب خواب دیده که یک مرد شجاع (شیرمرد) پیدا شده و با ضربه‌ای (طبانچه) هر دو چشم او را کور کرده است."],[205,"گفت زین دو چشمه چشم ای شقی","با تبر نوری بر آر ار صادقی","با این دو چشم که به تو داده شده، ای شقی (بدبخت)، اگر راست می‌گویی، با تبر نور را از آن‌ها برآور."],[205,"روز بر جست و دو چشم کور دید","نور فایض از دو چشمش ناپدید","چشم‌های کور به روشنی و نور دسترسی ندارند و در نتیجه، روز که خود نماد روشنایی است، برای آن‌ها بی‌فایده و ناپیداست. این بیت به تصویر کشیدن حالتی است که فردی بدون دید و درک، از وجود نور و روشنایی بی‌خبر است."],[205,"گر بنالیدی و مستغفر شدی","نور رفته از کرم ظاهر شدی","اگر در دل به گناه خود نالیده و از خداوند آمرزش خواسته‌ای، با لطف و کرم او، نور و روشنی که از تو رفته بود، دوباره ظاهر خواهد شد."],[205,"لیک استغفار هم در دست نیست","ذوق توبه نقل هر سرمست نیست","ولی حتی اگر بخواهی توبه کنی، احساس و ذوق توبه در دسترس نیست و فقط کسانی که در حال مستی‌اند می‌توانند از این موضوع صحبت کنند."],[205,"زشتی اعمال و شومی جحود","راه توبه بر دل او بسته بود","بدی‌های کارها و کفر و انکار او، راه بازگشت و توبه را بر دلش بسته بود."],[205,"از نیاز و اعتقاد آن خلیل","گشت ممکن امر صعب و مستحیل","از نیاز و ایمان ابراهیم خلیل (پدر پیامبران) امر دشوار و غیر ممکن ممکن شد."],[205,"همچنین بر عکس آن انکار مرد","مس کند زر را و صلحی را نبرد","به همان اندازه که مرد مس (یعنی مردی که به خوبی شمش طلا را نمی‌بیند) طلا را انکار می‌کند و به جنگ برای صلح نمی‌رود، در اینجا اشاره به نادانی یا عدم درک فردی دارد که حقیقت را نمی‌شناسد."],[205,"دل بسختی همچو روی سنگ گشت","چون شکافد توبه آن را بهر کشت","دل به سختی مانند سنگ شده است، اما وقتی که توبه و بازگشت به سوی خدا می‌آید، مانند شکاف‌هایی که در سنگ ایجاد می‌شود، به نرم‌شدن و تغییر می‌پردازد."],[205,"چون شعیبی کو که تا او از دعا","بهر کشتن خاک سازد کوه را","این بیت به شعیب، پیامبری اشاره دارد که از دعا و خواسته‌های خود می‌تواند به کشتن و نابود کردن زمین‌های زراعی و کوه‌ها اقدام کند. در واقع، شعیب نشان‌دهنده‌ی قدرت دعا و تاثیر آن بر طبیعت است."],[205,"یا به دریوزه مقوقس از رسول","سنگ‌لاخی مزرعی شد با اصول","مقوقس، که یکی از زمام‌داران مصر بود، با درخواست رسول خدا (ص) به دین اسلام گرایش پیدا کرد و به او مزرعه‌ای از سنگ‌لاخ (خاک سخت و نامعقول) تقدیم کرد که به اصول واقعی و بنیادهای دین اشاره دارد. این اشاره به این است که مزرعه، با دعا و راهنمایی رسول، می‌تواند به زمین بارور و مفیدی تبدیل شود."],[205,"کهربای مسخ آمد این دغا","خاک قابل را کند سنگ و حصا","این بیت به بیان تغییرات ناشی از یک فریب یا فاسدکننده می‌پردازد. به نظر می‌رسد اشاره به این دارد که گداختن کهربا (ماده‌ای قیمتی) می‌تواند خاک قابل را به سنگ و ریگ تبدیل کند، به این معنا که هر چیز با ارزشی می‌تواند به بی‌ارزشی تبدیل شود در اثر تاثیرات منفی."],[205,"هر دلی را سجده هم دستور نیست","مزد رحمت قسم هر مزدور نیست","هر دلی نمی‌تواند به هر سجده‌ای رو بیاورد، زیرا تنها دل‌هایی که شایسته هستند می‌توانند پاداش رحمت خدا را دریافت کنند و هر کسی که مزدور (بدهکار یا فریب‌خورده) باشد، سزاوار این پاداش نیست."],[205,"هین به پشت آن مکن جرم و گناه","که کنم توبه در آیم در پناه","مراقب باش که مرتکب گناه نشوی، زیرا من در صدد توبه‌ام و می‌خواهم به پناهگاه رحمت برگردم."],[205,"می‌بباید تاب و آبی توبه را","شرط شد برق و سحابی توبه را","برای اینکه توبه پذیرفته شود، باید نور و تابش و آبی از دل توبه‌کار ساطع شود، و این نشانه‌ی حقیقی توبه است."],[205,"آتش و آبی بباید میوه را","واجب آید ابر و برق این شیوه را","برای به دست آوردن میوه، وجود آتش و آب ضروری است و همچنین لازم است که ابر و برق به این روش عمل کنند."],[205,"تا نباشد برق دل و ابر دو چشم","کی نشیند آتش تهدید و خشم","تا زمانی که در دل یعنی احساسات چراغی روشن نباشد و در چشم‌ها یعنی نگاه‌ها ابر غم و اندوه وجود داشته باشد، چگونه می‌تواند آتش عشق و انتقام آرام بگیرد و ساکت شود؟"],[205,"کی بروید سبزه ذوق وصال","کی بجوشد چشمه‌ها ز آب زلال","بدون وجود ذوق و شوق وصال، مانند سبزه‌ای که نمی‌روید، چگونه می‌توان امید به شکوفایی و سرزندگی داشت؟ و چشمه‌های زلال هم بدون این احساسات، نمی‌جوشند."],[205,"کی گلستان راز گوید با چمن","کی بنفشه عهد بندد با سمن","تا زمانی که رازها برملا نشده و ارتباطات میان موجودات برقرار نگردد، گلستان (محل گل‌ها) چگونگی سخن گفتن با چمن را نخواهد داشت و بنفشه (گل بنفشه) نیز نمی‌تواند با سمن (گل سمن) پیمان صمیمیت ببندد."],[205,"کی چناری کف گشاید در دعا","کی درختی سر فشاند در هوا","در هیچ زمانی چناری برای دعا کردن دستش را نمی‌گشاید و هیچ درختی سر خود را در هوا بلند نمی‌کند."],[205,"کی شکوفه آستین پر نثار","بر فشاندن گیرد ایام بهار","در زمان بهار، شکوفه‌ها نمی‌توانند آستین خود را پر از گل کنند و آن را بریزند، پس نشانه‌ای از بهار در این دگرگونی طبیعت چگونه به وجود می‌آید."],[205,"کی فروزد لاله را رخ همچو خون","کی گل از کیسه بر آرد زر برون","چگونه ممکن است لاله‌ای به رنگ خون درخشان باشد و چه کسی می‌تواند گلی را از کیسه‌اش به‌صورت زرین خارج کند؟ این ابیات به بیان زیبایی و شکوه گل‌ها و لاله‌ها و نشانه‌های طبیعت می‌پردازد و به نوعی حیرت و سوال از ظهور این زیبایی‌ها دارد."],[205,"کی بیاید بلبل و گل بو کند","کی چو طالب فاخته کوکو کند","کی ممکن است بلبل به نزد گل بیاید و عطر او را استشمام کند؟ آیا همان‌طور که فاخته به دنبال کوکو می‌رود، او هم این کار را انجام دهد؟"],[205,"کی بگوید لک‌لک آن لک‌لک بجان","لک چه باشد ملک تست ای مستعان","لک‌لک (پرنده‌ای که نماد عشق و وفاداری است) نمی‌تواند بگوید که بقایای عشق و محبت که در جان او باقی مانده، چه ارتباطی با دنیا و ملک تو دارد. این جمله به نوعی اشاره به بی‌فایده بودن سخن گفتن در مورد عشق و دلدادگی در دنیای مادی دارد؛ درحالی‌که عشق واقعی فرای این امور است."],[205,"کی نماید خاک اسرار ضمیر","کی شود بی آسمان بستان منیر","هیچ‌کس نمی‌تواند رازهای دل را آشکار کند و همچنین هیچ باغی پر از نور نمی‌تواند بدون آسمان وجود داشته باشد."],[205,"از کجا آورده‌اند آن حله‌ها","من کریم من رحیم کلها","سخن از این است که این حله‌ها (پوشش‌ها، ظواهر) از کجا به دست آمده‌اند، در حالی که من (خدا) کریم و رحیم هستم و همه چیز از من است."],[205,"آن لطافتها نشان شاهدیست","آن نشان پای مرد عابدیست","لطافت‌ها و زیبایی‌ها نشان‌دهنده وجود یک معشوق است، و این نشان به پای مردی عابد و پرهیزگار برمی‌گردد که در جست‌وجوی عشق الهی است."],[205,"آن شود شاد از نشان کو دید شاه","چون ندید او را نباشد انتباه","کسی که به نشانه‌های خداوند (شاه) توجه می‌کند و او را می‌بیند، شاد و خوشحال می‌شود، اما اگر او (خدا را) نبیند، هرگز به هوش و حواس خود نخواهد آمد و نمی‌تواند به فهم عمیق‌تری برسد."],[205,"روح آنکس کو بهنگام الست","دید رب خویش و شد بی‌خویش مست","روح کسی که در عالم «الست» (عالم پیش از دنیا) رب خود را شناخت و به خاطر این شناخت، خویشتن خود را فراموش کرد و به حالت مستی رسید، به حقیقت نزدیک است."],[205,"او شناسد بوی می کو می بخورد","چون نخورد او می چه داند بوی کرد","کسی که شراب می‌نوشد، بوی آن را به خوبی می‌شناسد، اما کسی که شراب نخورده باشد، چگونه می‌تواند بوی آن را بشناسد؟"],[205,"زانک حکمت همچو ناقه ضاله است","همچو دلاله شهان را داله است","حکمت به مانند شتر گم‌شده و بی‌راهه است و مانند کسی است که شاهان را به راهنمایی و هدایت می‌کشاند."],[205,"تو ببینی خواب در یک خوش‌لقا","کو دهد وعده و نشانی مر ترا","تو در خواب کسی را می‌بینی که ظاهری دل‌نشین و زیبا دارد و به تو وعده و نشانه‌ای را می‌دهد."],[205,"که مراد تو شود و اینک نشان","که به پیش آید ترا فردا فلان","مراد تو (هدف یا آرزوت) مشخص خواهد شد و هم‌اکنون نشانه‌ای وجود دارد که فردا به سوی تو می‌آید."],[205,"یک نشانی آن که او باشد سوار","یک نشانی که ترا گیرد کنار","نشانی که به آن اشاره می‌شود، یکی از ویژگی‌های کسی است که سوار بر اسب است و نشانی دیگر، ویژگی کسی است که تو را در کنار خود می‌گیرد."],[205,"یک نشانی که بخندد پیش تو","یک نشان که دست بندد پیش تو","نشانه‌ای که باعث خوشحالی و خندیدن تو می‌شود و نشانه‌ای که تو را به خود می‌کشاند و برایت جذابیت دارد."],[205,"یک نشانی آنک این خواب از هوس","چون شود فردا نگویی پیش کس","اگر خواب ناشی از هوس و خواسته‌های انسانی است، دیگر نیازی نیست تا فردا به کسی بگویی که چه خواهد شد."],[205,"زان نشان هم زکریا را بگفت","که نیایی تا سه روز اصلا بگفت","زکریا به این علامت فهمید که تو، یعنی یحیی، تا سه روز به او نخواهی آمد و در واقع به او گفت که تا آن زمان نیازی به او نیست."],[205,"تا سه شب خامش کن از نیک و بدت","این نشان باشد که یحیی آیدت","سه شب باید سکوت کنی و در مورد خوب و بد چیزی نگوئی، این کار نشانه‌ای است که یحیی، فرزند زکریا، به تو خواهد رسید."],[205,"دم مزن سه روز اندر گفت و گو","کین سکوتست آیت مقصود تو","سه روز از گفتن درباره‌ی خوب و بد خودداری کن، زیرا این سکوت نشانه‌ای است از هدفی که تو دنبال می‌کنی."],[205,"هین میاور این نشان را تو بگفت","وین سخن را دار اندر دل نهفت","این نشان را که سخن می‌گوید، به خود نیاور و در دل خود مخفی کن."],[205,"این نشانها گویدش همچون شکر","این چه باشد صد نشانی دگر","این نشانه‌ها مانند شکر شیرین است و چه چیز دیگری می‌تواند باشد که صد نشانه دیگر را نشان دهد."],[205,"این نشان آن بود کان ملک و جاه","که همی‌جویی بیابی از اله","این نشانه، آن چیز است که اگر به دنبال قدرت و مقام بروی، آن را از خداوند می‌یابی."],[205,"آنک می‌گریی به شبهای دراز","وانک می‌سوزی سحرگه در نیاز","تو در شب‌های طولانی بسیار می‌گویی و گله‌مند هستی، و در صبح‌گاهان در هنگام دعا و نیاز از عشق و شوق می‌سوزی."],[205,"آنک بی آن روز تو تاریک شد","همچو دوکی گردنت باریک شد","به یاد داشته باش که در طول روز، بدون وجود تو، همه چیز تیره و تار شده است و مانند دوکی که دور گردن پیچیده شده، بار سنگینی بر دوش من احساس می‌شود."],[205,"وآنچ دادی هرچه داری در زکات","چون زکات پاک‌بازان رختهات","هرچیزی که برای کمک به دیگران و در راه خدا می‌کشی، مانند زکات است که پاکبازان از خود می‌دهند. این عمل، مانند دادن مال و دارایی به دیگران است و نشان‌دهنده فداکاری و بخشش تو می‌باشد."],[205,"رختها دادی و خواب و رنگ رو","سر فدا کردی و گشتی همچو مو","تو آنچه داشتی – اعم از مال و فرزند و زیبایی – برای خداوند هزینه کردی و همه لذت‌ها و زیبایی‌هایت را فدای عشق کردی و به حالت یک زاهد و سادگی در آمده‌ای."],[205,"چند در آتش نشستی همچو عود","چند پیش تیغ رفتی همچو خود","چندین بار مانند چوب عود در آتش سوختی و چندین بار مانند خودت در برابر تیغ قرار گرفتی."],[205,"زین چنین بیچارگیها صد هزار","خوی عشاقست و ناید در شمار","این‌همه رنج و ناچاری که عاشقان در عشق متحمل می‌شوند، هزاران نوع است و شمارش‌اش ممکن نیست."],[205,"چونک شب این خواب دیدی روز شد","از امیدش روز تو پیروز شد","وقتی که در شب، این خواب را دیدی، صبح وقت از امید آن خواب، روزت پیروز و موفق خواهد شد."],[205,"چشم گردان کرده‌ای بر چپ و راست","کان نشان و آن علامتها کجاست","تو در جست‌وجوی نشانه‌ها و علامت‌هایی هستی، و بدون اینکه به وضعیت فعلی خود توجه کنی، به اطراف نگاه می‌کنی که در کجا این نشانه‌ها پیدا می‌شوند."],[205,"بر مثال برگ می‌لرزی که وای","گر رود روز و نشان ناید بجای","تو مانند برگ درختی می‌لرزی و نگران هستی که اگر روز پایان یابد و تو از آنجا بروی، هیچ نشانی از تو باقی نخواهد ماند."],[205,"می‌دوی در کوی و بازار و سرا","چون کسی کو گم کند گوساله را","تو در کوچه‌ها و بازار می‌دوی، مانند کسی که گوساله‌اش را گم کرده و نگران است."],[205,"خواجه خیرست این دوادو چیستت","گم شده اینجا که داری کیستت","تو به دنبال خیر و نیکی هستی، ولی هنوز نمی‌دانی که این دو آداب و رسوم و سنت‌ها چه چیزی را برای تو گم کرده است. در واقع، نفرین‌ها و خوش‌خیالی‌هایت در اینجا چه معنی و جایگاهی دارند؟"],[205,"گوییش خیرست لیکن خیر من","کس نشاید که بداند غیر من","می‌گوید تو خوب می‌گویی، اما خیر من را فقط من می‌دانم و هیچ‌کس دیگری نمی‌تواند آن را بفهمد."],[205,"گر بگویم نک نشانم فوت شد","چون نشان شد فوت وقت موت شد","اگر بگویم که نشانه‌ام از بین رفته است، چون وقتی نشان از بین می‌رود، وقت آن هم به پایان می‌رسد."],[205,"بنگری در روی هر مرد سوار","گویدت منگر مرا دیوانه‌وار","اگر به چهره هر مرد سوار نگاه کنی، او به تو می‌گوید که به من نگاه نکن، چون من دیوانه‌وار هستم و وضعیت خوبی ندارم."],[205,"گوییش من صاحبی گم کرده‌ام","رو به جست و جوی او آورده‌ام","من می‌گویم که من صاحب و مولا و مربی را گم کرده‌ام و به همین خاطر به دنبال او آمده‌ام."],[205,"دولتت پاینده بادا ای سوار","رحم کن بر عاشقان معذور دار","ای سوار، خدا کند که دولت و نعمت تو همواره برقرار باشد. بر عاشقان که در جستجوی تو هستند رحم کن و آنها را معذور بدار."],[205,"چون طلب کردی به جد آمد نظر","جد خطا نکند چنین آمد خبر","هرگاه که با جدیت و earnestness خواسته‌ای را جستجو کنی، نظر و توجه خاصی به تو می‌آید که هیچ اشتباهی در آن نیست و خبر خوبی دریافت می‌کنی."],[205,"ناگهان آمد سواری نیکبخت","پس گرفت اندر کنارت سخت سخت","ناگهان سواری خوش‌شانس و خوش‌طالع به سراغ تو آمد و به‌طور جدی و با قاطعیت کنارت قرار گرفت."],[205,"تو شدی بیهوش و افتادی به طاق","بی‌خبر گفت اینت سالوس و نفاق","تو در حال بی‌حالی و بی‌خبری افتاده‌ای و نمی‌دانی که این حال خود را به چه چیزی نسبت می‌دهی؛ در حالی که این رفتار تو نشان‌دهنده تظاهر و دوچهرگی است."],[205,"او چه می‌بیند درو این شور چیست","او نداند کان نشان وصل کیست","شخصی که به حالت بی‌خبری افتاده، نمی‌داند چه چیزی را می‌بیند و این احساسات عجیب و شوری که در او ایجاد شده، ناشی از اتصال به حقیقتی بالاتر است که او از آن بی‌خبر است."],[205,"این نشان در حق او باشد که دید","آن دگر را کی نشان آید پدید","این علامتی که او دیده، بر حق و حقیقت اوست و نشانی از دیگری وجود ندارد که پیش روی او باشد."],[205,"هر زمان کز وی نشانی می‌رسید","شخص را جانی به جانی می‌رسید","هر زمانی که نشانه‌ای از او به شخص می‌رسید، آن شخص به زندگی و روح جدیدی دست پیدا می‌کرد."],[205,"ماهی بیچاره را پیش آمد آب","این نشانها تلک آیات الکتاب","ماهی بیچاره، در اینجا به وضعیتی اشاره دارد که در آن، آب (محیط زندگی‌اش) به او رسیده و نشان‌هایی (علامت‌ها) از آیات کتاب (آیات الهی) را تجربه می‌کند. به عبارت دیگر، موجودی برای درک نشانه‌ها و آموزه‌های الهی با مشکلات و چالش‌هایی روبه‌رو است."],[205,"پس نشانیها که اندر انبیاست","خاص آن جان را بود کو آشناست","در اینجا اشاره شده است که نشانه‌ها و آیات الهی که در کتاب‌های آسمانی وجود دارد، مختص به جان‌هایی است که با این معانی آشنا هستند. یعنی فقط افرادی که درک لازم را دارند، می‌توانند به درستی از این نشانه‌ها بهره‌برداری کنند."],[205,"این سخن ناقص بماند و بی‌قرار","دل ندارم بی‌دلم معذور دار","این حرف ناقص می‌ماند و با حالتی ناآرام، نمی‌توانم بدون دل خود زندگی کنم. اگر دلم بی‌تاب است، تو مرا معذور بدار."],[205,"ذره‌ها را کی تواند کس شمرد","خاصه آن کو عشق از وی عقل برد","هیچ‌کس نمی‌تواند ذرات عشق را بشمارد، به‌ویژه کسی که عشق او را از عقلش بی‌خبر کرده است."],[205,"می‌شمارم برگهای باغ را","می‌شمارم بانگ کبک و زاغ را","می‌توانم برگ‌های درختان باغ را بشمارم و صدای کبک و زاغ را هم بشمارم."],[205,"در شمار اندر نیاید لیک من","می‌شمارم بهر رشد ممتحن","شمارش و حساب‌ کردن برخی چیزها ممکن نیست، اما من به خاطر رشد و ترقی خود، همچنان به شمارش چیزهای غیرقابل شمارش ادامه می‌دهم."],[205,"نحس کیوان یا که سعد مشتری","ناید اندر حصر گرچه بشمری","بدبختی و شقاوت (نحس) سیاره زحل (کیوان) یا خوشبختی و سعادت سیاره مشتری (مشتری) هر دو در حبس نمی‌آیند، هرچند که تو آنها را بشماری و در نظر بگیری."],[205,"لیک هم بعضی ازین هر دو اثر","شرح باید کرد یعنی نفع و ضر","باید برخی از آثار هر دو سوی نیک و بد را توضیح داد، یعنی منفعت و زیان."],[205,"تا شود معلوم آثار قضا","شمه‌ای مر اهل سعد و نحس را","می‌خواهد بگوید که برای درک آثار قضا و سرنوشت، باید نگاهی به نشانه‌های شادمانی (سعد) و غم (نحس) افراد داشت."],[205,"طالع آنکس که باشد مشتری","شاد گردد از نشاط و سروری","کسی که طالع او مشتری است، با خوشحالی و شادی همراه می‌شود و از خوشبختی و خوشحالی بهره‌مند می‌شود."],[205,"وانک را طالع زحل از هر شرور","احتیاطش لازم آید در امور","کسی که طالعش زحل است، باید در زندگی‌اش احتیاط بیشتری در کارها داشته باشد تا از هر نوع بدی و آسیب در امان بماند."],[205,"اذکروا الله شاه ما دستور داد","اندر آتش دید ما را نور داد","خدا را یاد کنید که شاه ما دستور داد و در آتش، نور را به ما نشان داد."],[205,"گفت اگرچه پاکم از ذکر شما","نیست لایق مر مرا تصویرها","گفته می‌شود که اگرچه من از یاد شما پاک هستم، اما شایسته نیست که من در قالب‌ها و تصاویری محدود قرار بگیرم."],[205,"لیک هرگز مست تصویر و خیال","در نیابد ذات ما را بی مثال","اما هرگز مست (افسرده) تصویر و خیال نمی‌تواند ذات ما را که بی‌نظیر است درک کند."],[205,"ذکر جسمانه خیال ناقصست","وصف شاهانه از آنها خالصست","ذکر و یاد جسمانی و مادی ناقص و ناپخته است، در حالی که توصیف‌های مربوط به شاه، خالص و برتر از این نوع یادها می‌باشند."],[205,"شاه را گوید کسی جولاه نیست","این چه مدحست این مگر آگاه نیست","به کسی گفته می‌شود که اگر می‌خواهی شاه را پرستش کنی، باید بدانی که او انسانی نیست که بر اساس ظواهر و مدح‌های معمولی قضاوت شود؛ این نوع ستایش بی‌پایه و نادرست است."],[206,"دید موسی یک شبانی را به راه","کو همی‌گفت ای گزیننده اله","موسی علیه‌السلام در شب کسی را می‌بیند که در راه خدا سخن می‌گوید و او را به عنوان برگزیده خدا خطاب می‌کند."],[206,"تو کجایی تا شوم من چاکرت","چارقت دوزم کنم شانه سرت","من در کجا هستی تا من خدمتگزار تو باشم؟ و گوشه چادر تو را بدوزم و سر تو را شانه کنم؟"],[206,"جامه‌ات شویم شپشهاات کشم","شیر پیشت آورم ای محتشم","من لباس‌هایت را می‌شویم و شپش‌هایت را می‌کشم. ای بزرگوار، شیر را هم برای تو می‌آورم."],[206,"دستکت بوسم بمالم پایکت","وقت خواب آید بروبم جایکت","دستانت را ببوسم و پایت را بمالم، وقتی که خواب به سراغت آمد، جایت را بروبم وجارو کنم."],[206,"ای فدای تو همه بزهای من","ای بیادت هیهی و هیهای من","من تمام بزهای خود را فدای تو می‌کنم، ای کسی که یاد تو باعث شادی من است و ناله‌ها و صداهای غمگین من را به یاد می‌آورد."],[206,"این نمط بیهوده می‌گفت آن شبان","گفت موسی با کی است این ای فلان","این شبان در حال بیان سخنانی بی‌معنا و بی‌فایده بود و موسی از او می‌پرسد که با چه کسی صحبت می‌کند و به چه کسی اشاره می‌کند."],[206,"گفت با آنکس که ما را آفرید","این زمین و چرخ ازو آمد پدید","موسی علیه‌السلام گفت: با کسی که ما را خلق کرده و این زمین و آسمان از او به وجود آمده است، صحبت کن."],[206,"گفت موسی های بس مدبر شدی","خود مسلمان ناشده کافر شدی","موسی به کسی می‌گوید: ای کسی که خیلی تدبیر و فکر کرده‌ای، اما هنوز مسلمان نشده‌ای، در واقع به کفر روی آورده‌ای."],[206,"این چه ژاژست این چه کفرست و فشار","پنبه‌ای اندر دهان خود فشار","این سخنان آشفته و کفرآمیز و بیهوده‌ چیست که میگویی؟ خاموش باش، چونان کسی که پنبه‌ای در دهان خود فشار میدهد و عاجز از سخن گفتن میشود."],[206,"گند کفر تو جهان را گنده کرد","کفر تو دیبای دین را ژنده کرد","کفر تو دنیا را بدبو و ناپاک کرده و کفر تو لباس دین را خراب و زشت نشان داده است."],[206,"چارق و پاتابه لایق مر تراست","آفتابی را چنینها کی رواست","تو را به لباس‌ها و زینت‌هایی مانند چارق و پاتابه (نوعی کفش و پوشش که نزد مردم آن زمان رایج بوده) نیاز نیست، زیرا در برابر نور آفتاب، چنین چیزهایی مناسب نیستند."],[206,"گر نبندی زین سخن تو حلق را","آتشی آید بسوزد خلق را","اگر تو این سخن را قطع نکنی و به آن گوش ندهی، آتش خشم خداوندی بروز می‌کند که به مردم آسیب خواهد رساند."],[206,"آتشی گر نامدست این دود چیست","جان سیه گشته روان مردود چیست","اگر آتش وجود ندارد، پس این دود چیست؟ چرا جان انسانی که گناه کرده، تیره و ناپسند است؟"],[206,"گر همی‌دانی که یزدان داورست","ژاژ و گستاخی ترا چون باورست","اگر می‌دانی که خداوند، داوری است که حق و باطل را می‌سنجد، پس چرا به بیهوده‌گویی و بی‌احترامی می‌پردازی و خود را در برابر او گستاخ می‌کنی؟"],[206,"دوستی بی‌خرد خود دشمنیست","حق تعالی زین چنین خدمت غنیست","دوستی که عاقلانه نیست، در واقع دشمنی با خداوند است، زیرا از چنین سرویسی (دوستی نادانانه) برای خداوند بهره‌ای نیست."],[206,"با کی می‌گویی تو این با عم و خال","جسم و حاجت در صفات ذوالجلال","با چه کسی صحبت می‌کنی وقتی که تو به عمو و خاله‌ات و همچنین به نیازهای جسمی و صفات خداوند بزرگ اشاره می‌کنی؟"],[206,"شیر او نوشد که در نشو و نماست","چارق او پوشد که او محتاج پاست","شیر، که نماد قدرت و زندگی است، به کسی داده می‌شود که در حال رشد و تحولی مثبت است، و کسی که از ویژگی‌های او بهره‌مند می‌شود، برای اینکه به کمال برسد، به او نیازمند است. این به معنای آن است که انسان‌ها برای رسیدن به اهداف و پیشرفت‌های معنوی، به حمایت و ویژگی‌های خداوند نیاز دارند."],[206,"ور برای بنده‌شست این گفت تو","آنک حق گفت او منست و من خود او","اگر این سخن برای بنده‌ای باشد، این است که حق گفته است: «تو همان منی و من خود او هستم»، یعنی ما و حق یکی هستیم و در حقیقت، تو بخشی از حقیقت هستی."],[206,"آنک گفت انی مرضت لم تعد","من شدم رنجور او تنها نشد","موسی علیه‌السلام می‌گوید: وقتی که گفتم «من بیمار شدم»، او (خدا) فقط من را تنها ندانست و رنج من را احساس کرد."],[206,"آنک بی یسمع و بی یبصر شده‌ست","در حق آن بنده این هم بیهده‌ست","این شخص (شبان) که نه می‌شنود و نه می‌بیند، در حقیقت از درک حقایق و ارتباط با خداوند دور افتاده و گفتن چنین سخنانی درباره او بی‌فایده و بی‌مورد است."],[206,"بی ادب گفتن سخن با خاص حق","دل بمیراند سیه دارد ورق","صحبت کردن بی‌ادبانه با خداوند، دل انسان را می‌کشد و روح او را خالی می‌کند، و این نوع گفتار بر ورق وجود او آثار منفی و سیاهی به جا می‌گذارد."],[206,"گر تو مردی را بخوانی فاطمه","گرچه یک جنس‌اند مرد و زن همه","اگر تو به کسی که مرد است، فاطمه را صدا بزنی، باید بدانید که مرد و زن هر دو از یک نوع هستند و هر دو از یک جنس خلق شده‌اند."],[206,"قصد خون تو کند تا ممکنست","گرچه خوش‌خو و حلیم و ساکنست","هرچند انسان‌ها ممکن است در ظاهر خوش‌خو و آرام به نظر برسند، اما در باطن ممکن است به قصد آسیب رساندن و به خون ریختن اقدام کنند."],[206,"فاطمه مدحست در حق زنان","مرد را گویی بود زخم سنان","فاطمه، در وصف زنان، ستایش و تمجید است؛ گویا مردی که گوینده این مدح است از زخم تیرهایی که به او خورده، حرف می‌زند."],[206,"دست و پا در حق ما استایش است","در حق پاکی حق آلایش است","در حق ما، دست و پا (یعنی وجود و تلاش‌مان) به ستایش و مدح تعلق دارد، ولی در مورد ذات خداوند، پاکی و خلوص او باید مورد توجه قرار گیرد، نه آلودگی و نقص."],[206,"لم یلد لم یولد او را لایق است","والد و مولود را او خالق است","خداوند نه پدر دارد و نه فرزندی، بنابراین او سزاوار است که هیچ‌گونه نسبتی با والدین یا فرزندان نداشته باشد، زیرا خالق همه چیز است و هیچ چیز نمی‌تواند او را به دیگران وابسته کند."],[206,"هرچه جسم آمد ولادت وصف اوست","هرچه مولودست او زین سوی جوست","هر چیزی که جسم دارد و به دنیا آمده، وصف اوست، و هر چیزی که به عنوان مولود به وجود می‌آید، از جانب او سرچشمه می‌گیرد."],[206,"زانک از کون و فساد است و مهین","حادثست و محدثی خواهد یقین","زیرا موجودات از عالم جسم و فساد به وجود آمده و پدیده‌ای ناچیز و حادث هستند، و کسی مانند خدای متعال باید وجود آن‌ها را یقینا به وجود آورد."],[206,"گفت ای موسی دهانم دوختی","وز پشیمانی تو جانم سوختی","شبان به موسی علیه‌السلام می‌گوید که تو با سکوت و خاموشی‌ات، دهان مرا بستیدی و به خاطر بی‌اعتنایی‌ات، روح و جانم به شدت داغدار و پشیمان شد."],[206,"جامه را بدرید و آهی کرد تفت","سر نهاد اندر بیابانی و رفت","او (شبان) لباسش را پاره کرد و با آهی عمیق به آسمان نظر کرد، سپس سرش را به سوی بیابان خم کرد و از آنجا رفت."],[207,"وحی آمد سوی موسی از خدا","بنده ما را ز ما کردی جدا","وحی از سوی خدا به حضرت موسی رسید که فرمود: بنده ما (شبان) را به خاطر این جدایی از ما توبیخ کن."],[207,"تو برای وصل کردن آمدی","یا برای فصل کردن آمدی؟","موسی به خداوند می‌گوید که آیا تو برای اینکه انسان‌ها را به هم وصل کنی و اتحاد بدهی به دنیا آمده‌ای، یا اینکه برای جدایی و فاصله انداختن میان آنان آمده‌ای؟"],[207,"تا توانی پا منه اندر فراق","ابغض الاشیاء عندی الطّلاق","هرگاه می‌توانی، پای خود را در فراق نگه‌دار، زیرا طلاق برای من از تمام چیزها نفرت‌انگیزترین است."],[207,"هر کسی را سیرتی بنهاده‌ام","هر کسی را اصطلاحی داده‌ام","من هر فردی را با خصوصیات خاص خود و رفتار مخصوص به خودش شناخته‌ام و برای هر کس عنوان یا اصطلاحی را قرار داده‌ام که به او مربوط می‌شود."],[207,"در حق او مدح و در حقّ تو ذم","در حق او شهد و در حقّ تو سم","در مورد خداوند ستایش و تمجید است، اما درباره تو، نکوهش و سرزنش وجود دارد. در مورد خداوند، حقیقتی شیرین و دلپذیر است، اما در مورد تو، چیزی تلخ و سمّی وجود دارد."],[207,"ما بریّ از پاک و ناپاکی همه","از گرانجانی و چالاکی همه","خداوند از پاکی و ناپاکی جداست و هیچ تعلقی به این امور ندارد؛ همه موجودات از بار سنگین و سختی زندگی و همچنین از توانایی و چابکی ما ناشی می‌شوند."],[207,"من نکردم امر تا سودی کنم","بلکه تا بر بندگان جودی کنم","خداوند می‌فرماید که من نیامده‌ام تا از فرمان‌هایم به نفع خود بهره ببرم، بلکه هدف من کمک و نیکی به بندگانم است."],[207,"هندوان را اصطلاح هند، مدح","سندیان را اصطلاح سند، مدح","مردم هند را به لحاظ ویژگی‌های خاصشان هندوان می‌نامند و در مقابل، مردم سند (منطقه‌ای در شمال هند) را به همین ترتیب، سندی می‌خوانند. این عبارات بیانگر تشخیص و تفاوت دو ملت بر اساس فرهنگ و سرزمین آنهاست."],[207,"من نگردم پاک از تسبیحشان","پاک، هم ایشان شوند و در فشان","من از تسبیح و ذکر آن‌ها پاک نمی‌شوم، چون آن‌ها نیز در مقام دریافت، پاک و معصوم می‌شوند و زیبایی و شیرینی‌های معنوی را پخش می‌کنند."],[207,"ما زبان را ننگریم و قال را","ما روان را بنگریم و حال را","ما به گفتار الفاظ توجه نمی‌کنیم، بلکه به درون انسان و حال روحی او نظر داریم."],[207,"ناظر قلبیم اگر خاشع بود","گرچه گفت لفظ، ناخاضع رود","ما به دل و حالت درونی افراد نگاه می‌کنیم و اگر دلشان خاشع و تسلیم باشد، حتی اگر سخنانشان زیبا و نیکو نباشد، آن را نادیده می‌گیریم."],[207,"زانکه دل جوهر بود، گفتن عرض","پس طفیل آمد عرض، جوهر غرض","دل انسان ارزش واقعی و جوهر وجود اوست، در حالی که گفتن کلمات تنها یک ظاهرسازی و شکل ظاهری است. اگر دل خالص باشد، سخنان و الفاظی که به میان می‌آید، تنها تابعه و پیرو آن خلوص هستند."],[207,"چند ازین الفاظ و اضمار و مجاز؟","سوز خواهم سوز، با آن سوز ساز","چند واژه و تعابیر نامفهوم و کنایه‌ای وجود دارد؟ من می‌خواهم سوز عشق را درک کنم، نه این بازی‌های لفظی را."],[207,"آتشی از عشق در جان بر فروز","سر بسر فکر و عبارت را بسوز","آتش عشق باید در وجود تو شعله‌ور شود تا اندیشه و گفتار تو را بسوزاند و نابود کند."],[207,"موسیا! آداب‌دانان دیگرند","سوخته جان و روانان دیگرند","ای موسی! عالمان و کسانی که به آداب و رسوم آشنا هستند، با افراد سوخته‌جان و عاشقان حقیقی فرق دارند. آن‌هایی که جان و روحشان در آتش عشق سوخته است، حال و هوای متفاوتی دارند و به شیوه‌ای دیگر زندگی می‌کنند."],[207,"عاشقان را هر نفس سوزیدنیست","بر ده ویران، خراج و عشر نیست","عاشقانی که در عشق حقیقی هستند، هر لحظه دلی پر سوز دارند و کسانی که در عشق غم‌زده‌اند، در جایی خراب و ویران زندگی می‌کنند و در آنجا هیچگونه مالیاتی یا درآمدی وجود ندارد."],[207,"گر خطا گوید، ورا خاطی مگو","گر بود پرخون شهید، او را مشو","اگر کسی خطایی انجام دهد، او را گناهکار نخوان، حتی اگر او مردی باشد که خونش به ناحق ریخته شده است، او را سرزنش نکن."],[207,"خون، شهیدان را ز آب اولی ترست","این خطا، از صد صواب اولی ترست","این بیت می‌گوید که حتی اگر یک شهید به خطا به خون آغشته شود، این خطا از صد درستکاری دیگر او بیشتر به چشم می‌آید. به عبارت دیگر، عواقب منفی یک خطا (خون شهیدان) از آثار مثبت کارهای درست او سنگین‌تر است."],[207,"در درون کعبه رسم قبله نیست","چه غم ار غوّاص را پاچیله نیست؟","در درون کعبه، نشانی از قبله وجود ندارد، پس چه جای نگرانی است اگر غواصی در دریا نمی‌تواند از عمق آب طلای پنهان را پیدا کند؟"],[207,"تو ز سرمستان قلاویزی مجو","جامه‌چاکان را چه فرمایی رفو؟","موسی از خدا می‌پرسد که در کوه سرمستان (منطقه‌ای سرد و کوهستانی) چه دستور و راه‌حلی برای ترمیم و اصلاح پوشاک پاره‌ی جامه‌چاکان (مکافات‌دیده‌ها یا آنهایی که در شرایط سخت هستند) باید بدهد، یعنی او نمی‌تواند مشکلات بزرگ‌تر را حل کند در حالی که مشکلات کوچک‌تر هم حل نشده باقی مانده‌اند."],[207,"ملّت عشق از همه دین‌ها جداست","عاشقان را ملّت و مذهب خداست","ملّت عشق، به معنای افرادی که عاشق هستند، از تمامی دین‌ها و مذاهب جداست و عشق، خود دینی است که عاشقان را به هم متصل می‌کند و در این مذهب، خداوند وجود دارد."],[207,"لعل را گر مهر نبود، باک نیست","عشق در دریای غم، غمناک نیست","اگر مهر و نشانه‌ای از نبوّت نباشد، نگران نباشید؛ زیرا عشق در دریای غم، هیچ غمگین و نگران نیست."],[208,"بعد از آن در سرّ موسی حق نهفت","رازهایی گفت کان ناید به گفت","پس از آن، در راز موسی، حضور حق پنهان شده و ذهن و زبان توان بیان آن رازها را ندارند."],[208,"بر دل موسی سخن‌ها ریختند","دیدن و گفتن به هم آمیختند","بر دل موسی رازهایی را آشکار کردند، به طوری که دیدن و گفتن برای او با هم در هم آمیخت و یکی شد."],[208,"چند بی‌خود گشت و چند آمد به خود","چند پرّید از ازل سوی ابد","موسی چند بار بی‌خود و در حالت جنون شد و چند بار به خود آمد. چند بار از ابتدایی‌ترین مراحل وجود به سمت جاودانگی و ابدیت پرواز کرد."],[208,"بعد از این گر شرح گویم ابلهیست","زانک شرح این ورای آگهیست","اگر بعد از این بخواهم توضیح دهم، نادانی است، زیرا شرح این موضوع فراتر از دانش بشر است."],[208,"ور بگویم عقل‌ها را برکند","ور نویسم بس قلم‌ها بشکند","اگر بخواهم این موضوع را بیان کنم، عقل‌ها از تعجب شکسته می‌شوند و اگر بنویسم، قلم‌ها از قدرت نوشتن ناتوان می‌گردند."],[208,"چون که موسی این عتاب از حق شنید","در بیابان در پی چوپان دوید","موسی، وقتی این سرزنش از طرف خداوند را شنید، در بیابان به دنبال چوپان رفت."],[208,"بر نشان پای آن سرگشته راند","گرد از پرّه بیابان برفشاند","موسی که در جستجوی چوپان است، با مشاهده رد پای او در بیابان، حس شگفت‌انگیزی پیدا می‌کند و گرد و غبار بیابان را از روی آن ردپا می‌زند."],[208,"گام پای مردم شوریده خود","هم ز گام دیگران پیدا بود","گام‌های مردم مجنون و دیوانه، همان‌طور که از گام‌های دیگران مشخص است، نشانه‌ای از وضعیت آنهاست."],[208,"یک قدم چون رخ ز بالا تا نشیب","یک قدم چون پیل رفته بر وریب","یک قدم مانند صورت که از بالا به پایین می‌آید و یک قدم دیگر مانند فیل سنگین که به آرامی حرکت می‌کند."],[208,"گاه چون موجی بر افرازان علم","گاه چون ماهی روانه بر شکم","گاه انسان به مانند موجی است که بر افراشته شدن علم، قوی و پرقدرت می‌جوشد و گاه به مانند ماهی است که در آب به آرامی در حال حرکت است. در این دو تصویر، اشاره به تغییر حال و رفتار انسان‌ها دارد؛ از قدرت و عظمت تا نرمی و آرامش."],[208,"گاه بر خاکی نبشته حال خود","همچو رمالی که رملی بر زند","گاهی او بر روی خاک، حال خودش را می‌نویسد مانند رمالی که پیشگوئی‌هایی در رمل (خطوط یا نشانه‌های روی زمین) انجام می‌دهد."],[208,"عاقبت دریافت او را و بدید","گفت مژده ده که دستوری رسید","موسی (علیه‌السلام) در نهایت دریافت وحی را احساس کرد و گفت به مردم مژده بده که دستوری از جانب خداوند رسیده است."],[208,"هیچ آدابی و ترتیبی مجو","هرچه می‌خواهد دل تنگت بگو","هرگونه آداب و ترتیبات خاصی را جستجو نکن و آنچه در دل تنگت می‌گذرد، بدون هیچ واهمه‌ای بیان کن."],[208,"کفر تو دین است و دینت نور جان","آمنی وز تو جهانی در امان","کفر تو در حقیقت، همان دین است و دین تو، نوری برای جان و روح تو محسوب می‌شود. به خاطر تو، جهانی در امنیت و حفظ قرار دارد."],[208,"ای معاف یفعل الله ما یشا","بی‌محابا رو زبان را برگشا","ای کسی که خدا هر چه بخواهد، بدون ترس انجام می‌دهد، زبانت را باز کن و صحبت کن."],[208,"گفت ای موسی از آن بگذشته‌ام","من کنون در خون دل آغشته‌ام","خداوند به موسی می‌گوید که من از همه‌ی محدودیت‌ها و موانع گذشته‌ام و حالا در وضعیت سختی قرار دارم که دلم پر از درد و رنج است."],[208,"من ز سدره منتهی بگذشته‌ام","صد هزاران ساله زان سو رفته‌ام","من از درخت سدره منتهی، که در بهشت قرار دارد، عبور کرده‌ام و سال‌هاست که از آن طرف رفته‌ام."],[208,"تازیانه بر زدی اسپم بگشت","گنبدی کرد و ز گردون بر گذشت","موسی علیه‌السلام با تازیانه‌ای که به اسبش زده است، به پیش می‌رود و انگار گنبد آسمان را به گردش درمی‌آورد و از گردونه عالم بالا عبور می‌کند."],[208,"محرم ناسوت ما لاهوت باد","آفرین بر دست و بر بازوت باد","ای کسانی که به عالم ناسوت (عالم مادی) تعلق دارید، شما را به عالم لاهوت (عالم معنوی) و فراق از مادیات می‌خوانم. درود بر دست و قوت شما که به این هدف می‌رسید."],[208,"حال من اکنون برون از گفتن است","اینچ می‌گویم نه احوال من است","موسی در این بیت می‌گوید که حال و وضعیت او فراتر از بیان کلامی است و آنچه می‌گوید به هیچ وجه وضعیت واقعی او را توصیف نمی‌کند."],[208,"نقش می‌بینی که در آیینه‌ای‌ست","نقش توست آن نقش آن آیینه نیست","تصویری که در آینه می‌بینی، در واقع تصویر خود توست و آن تصویر متعلق به آینه نیست."],[208,"دم که مرد نایی اندر نای کرد","درخور نایست نه درخورد مرد","زمانی که انسانی در یک نای (شاید نایاب یا ساز) دم می‌زند، او به قدری سازگار و شایسته نای نیست که آن نای را به خوبی پر کند؛ بلکه باید شخصیتی در خور آن نای باشد تا بتواند صدای زیبایی از آن خارج کند."],[208,"هان و هان گر حمد گویی گر سپاس","همچو نافرجام آن چوپان شناس","اگر تو هم بخواهی حمد و سپاس بگویی، باید بدان که این کار به اندازه حمد آن چوپان ناکام ارزش ندارد."],[208,"حمد تو نسبت بدان گر بهترست","لیک آن نسبت به حق هم ابترست","هرچند حمد و ستایش تو نسبت به آن چوپان بهتر است، ولی آن نسبت به خداوند هم ناقص و مهجور است."],[208,"چند گویی چون غطا برداشتند","کاین نبوده‌ست آنک می‌پنداشتند","چرا اینقدر می‌گویی و تکرار می‌کنی؟ چون پرده‌ها (از حقایق) کنار زده شده است و فهمیده‌اند که آنچه فکر می‌کردند، حقیقت نداشته است."],[208,"این قبول ذکر تو از رحمت است","چون نماز مستحاضه رخصت است","قبول ذکر تو بر اساس رحمت خداوند است، همان‌طور که نماز مستحاضه به خاطر عذر و رخصت، جایز است."],[208,"با نماز او بیالوده‌ست خون","ذکر تو آلوده تشبیه و چون","نماز او (موسی علیه‌السلام) پاک و بی‌آلایش است، ولی ذکر تو (شبان) به تشبیه و قیاس‌ها آلوده شده است."],[208,"خون پلید است و به آبی می‌رود","لیک باطن را نجاست‌ها بود","خون، به عنوان یک چیز ناپاک، به آب راه می‌یابد، اما حقیقت درونی فرد، آلوده به آلودگی‌ها و نجاست‌ها است."],[208,"کان به غیر آب لطف کردگار","کم نگردد از درون مرد کار","لطف و رحمت خداوند به انسان تنها به وسیله آب نمی‌رسد و انسان باید از درون خود کار کند تا به او چیزی اضافه نشود."],[208,"در سجودت کاش روگردانیی","معنی سبحان ربی دانیی","ای کاش وقتی در حال سجود هستی، روگردانی نداشته باشی و معنای \"سبحان ربی\" را بفهمی و درک کنی."],[208,"کای سجودم چون وجودم ناسزا","مر بدی را تو نکویی ده جزا","با توجه به سجود و خضوع من، آنچه در درونم وجود دارد ناپسند است. پس ای حق، جزا و پاداش بدی‌های من را با نیکی بده."],[208,"این زمین از حلم حق دارد اثر","تا نجاست برد و گل‌ها داد بر","این زمین به خاطر بردباری خداوند تاثیر دارد، تا کثافت‌ها را از بین ببرد و گل‌ها را به وجود آورد."],[208,"تا بپوشد او پلیدی‌های ما","در عوض بر روید از وی غنچه‌ها","خداوند پلیدی‌های ما را می‌پوشاند تا به جای آن غنچه‌ها و زیبایی‌ها از ما ظهور کند."],[208,"پس چو کافر دید کاو در داد و جود","کم‌تر و بی‌مایه‌تر از خاک بود","مولانا در این بیت می‌گوید: وقتی انسان (کافر، یعنی کسی که ناسپاس است) می‌بیند که در عین بخشش و سخاوت دیگران، خودش پایین‌تر و بی‌ارزش‌تر از خاک است، تازه به حقارت خود پی می‌برد."],[208,"از وجود او گل و میوه نرست","جز فساد جمله پاکی‌ها نجست","از وجود آن کافر که نمی‌تواند به دیگران کمک کند، هیچ چیز خوبی به وجود نمی‌آید و همه پاکی‌ها در او فاسد و ناپاک است."],[208,"گفت واپس رفته‌ام من در ذهاب","حسرتا، یا لیتنی کنت تراب","مصرع دوم اشاره به آیه ۴۰ سوره نبا: «... يقول ٱلکافر يا ليتني کنت ترابا، یعنی: کافر می‌گويد: ای کاش خاک بودم » دارد."],[208,"کاش از خاکی سفر نگزیدمی","همچو خاکی دانه‌ای می‌چیدمی","ای کاش از خاک جدا نمی‌شدم و مثل دانه‌ای که از خاک برمی‌خیزد، می‌توانستم در آنجا بمانم و زندگی کنم."],[208,"چون سفر کردم، مرا راه آزمود","زین سفرکردن ره‌آوردم چه بود؟","زمانی که سفر کردم، راه را تجربه کردم و حالا می‌پرسم از این سفر، چه نتیجه‌ای بدست آوردم؟"],[208,"زان همه میلش سوی خاک است کو","در سفر سودی نبیند پیش رو","تمامی تمایل او به سوی زمین و خاک است، زیرا در این سفر، هیچ سودی را در پیش‌رو نبیند."],[208,"روی واپس کردنش آن حرص و آز","روی در ره کردنش صدق و نیاز","حرص و آز انسان باعث می‌شود که او به زمین و مادیات روی آورد، در حالی که اگر صدق و نیاز را در پیش گیرد، می‌تواند مسیر درست و معنوی را انتخاب کند."],[208,"هر گیا را کش بود میل علا","در مزید است و حیات و در نما","هر گیاهی که تمایل به رشد و تعالی دارد، در بیشتری و حیات و نما باید تلاش کند و به سمت عالی‌تر شدن برود."],[208,"چونک گردانید سر سوی زمین","در کمی و خشکی و نقص و غبین","زمانی که سر خود را به سوی زمین می‌چرخاند، به خاطر کمی و خشکی و نقص و عیب‌هایی که وجود دارد، دچار تردید و نگرانی می‌شود."],[208,"میل روحت چون سوی بالا بود","در تزاید مرجعت آنجا بود","میلی که روح تو به سوی بالاست، در حال افزایش و ترقی، بازگشت آنجا (به عالم بالا) قرار دارد."],[208,"ور نگوساری سرت سوی زمین","آفلی، حق لا یحبّ الافلین","در مصرع دوم: لا یحب الآفلین یعنی «نابودشوندگان (/ناپدیدشوندگان) را دوست نمی‌دارد» (اقتباس از آیه ۷۶ سوره انعام)"],[209,"گفت موسی ای کریم کارساز","ای که یکدم ذکر تو عمر دراز","موسی به خدایش می‌گوید: ای خداوند کریم و کمک‌کننده، تو که ذکر و یاد تو باعث طول عمر من است."],[209,"نقش کژمژ دیدم اندر آب و گل","چون ملایک اعتراضی کرد دل","موسی در دل خود به مشاهده نادرستی و فساد در دنیا اعتراض می‌کند، همان‌طور که فرشتگان در برابر کارهای نادرست انسان‌ها اعتراض دارند."],[209,"که چه مقصودست نقشی ساختن","واندرو تخم فساد انداختن","سؤال این است که هدف از ایجاد این نقش (نقشی که در آب و گل دیده می‌شود) چیست و چرا در آن تخم فساد و نکبت کاشته می‌شود؟"],[209,"آتش ظلم و فساد افروختن","مسجد و سجده‌کنان را سوختن","آتش ظلم و فساد باعث ویرانی می‌شود و افرادی که در مسجد و در حال عبادت هستند نیز در اثر این ناملایمات آسیب می‌بینند."],[209,"مایه خونابه و زردآبه را","جوش دادن از برای لابه را","دردهای عمیق و ناراحتی‌های روحی انسان‌ها را بیان می‌کند که به خاطر ستم و فساد در جامعه به وجود آمده‌اند و به نوعی نگرانی و اضطراب را به تصویر می‌کشد."],[209,"من یقین دانم که عین حکمتست","لیک مقصودم عیان و رؤیتست","من می‌دانم که این مسئله، حکمت و راز بزرگی دارد، اما هدف من این است که آن را به‌وضوح ببینم و درک کنم."],[209,"آن یقین می‌گویدم خاموش کن","حرص رؤیت گویدم نه جوش کن","یعنی من قبلا هم به یقین دست یافتم و حالا می‌گویم که این یقین را خاموش کن، زیرا حرص و اشتیاق به دیدن حق را بیان می‌کنم، نه اینکه برانگیخته شوم و هیجان‌زده شوم."],[209,"مر ملایک را نمودی سر خویش","کین چنین نوشی همی ارزد به نیش","موسی (پیامبر) به خداوند می‌گوید: ای خدا، به فرشتگان نشان دادی که سر انسان (آدم) را برتر از خودشان قرار دادی، در حالی که این تعبیر (برتری) برای آن‌ها قابل درک نیست و به این ترتیب، آدمی این جایگاهش را عملا به نیش (رنج و آزردگی) تبدیل می‌کند."],[209,"عرضه کردی نور آدم را عیان","بر ملایک گشت مشکلها بیان","خداوند نور وجود آدم را به شکل آشکار در مقابل ملائکه قرار داد، و این موضوع باعث شد که مسائل و دشواری‌ها به وضوح برای آن‌ها بیان شود."],[209,"حشر تو گوید که سر مرگ چیست","میوه‌ها گویند سر برگ چیست","در روز قیامت، روح تو (انسان) باید درباره‌ی علت مرگ سوال کند، و میوه‌ها نیز پاسخ می‌دهند که منشأ زندگی و جوانه‌زدن چیست."],[209,"سر خون و نطفه حسن آدمیست","سابق هر بیشیی آخر کمیست","مفهوم زندگی و وجود انسان، با توجه به منشأ او، به خون و نطفه در رحم مادر برمی‌گردد و در نهایت، هر چیزی که در عالم وجود دارد، از کمبود و نقصان حاصل می‌شود."],[209,"لوح را اول بشوید بی وقوف","آنگهی بر وی نویسد او حروف","خداوند ابتدا دل را از نادانی و آلودگی پاک می‌کند، سپس بر آن دل، حروف و اسرار را می‌نویسد."],[209,"خون کند دل را و اشک مستهان","بر نویسد بر وی اسرار آنگهان","دل را با خون می‌آلاید و اشک‌های فرو ریخته ظلم و ستم را بر روی آن می‌نویسد، و در آن زمان اسرار را ثبت می‌کند."],[209,"وقت شستن لوح را باید شناخت","که مر آن را دفتری خواهند ساخت","شستن لوح به معنای آماده‌کردن آن برای نوشتن است و باید زمان مناسب این کار را شناخت، زیرا این لوح در آینده به‌عنوان یک دفتر (سند) مهم خواهد بود."],[209,"چون اساس خانه‌ای می‌افکنند","اولین بنیاد را بر می‌کنند","زمانی که می‌خواهند به ساختن خانه‌ای بپردازند، ابتدا باید پایه و بنیان آن را به خوبی بنا کنند."],[209,"گل بر آرند اول از قعر زمین","تا به آخر بر کشی ماء معین","ابتدا باید گل را از عمق زمین بیرون بیاورند تا بتوانند در نهایت به آب زلال دست یابند."],[209,"از حجامت کودکان گریند زار","که نمی‌دانند ایشان سر کار","کودکان از جراحی و حجامت بسیار ناراحت و گریه می‌کنند، زیرا نمی‌دانند که این عمل برای سلامتی‌شان لازم است و هدفی دارد."],[209,"مرد خود زر می‌دهد حجام را","می‌نوازد نیش خون آشام را","مردی برای حجامت، پولی به حجام می‌دهد و در عین حال از کار او، که به نوعی درد و آسیب به کودک وارد می‌کند، راضی است و در واقع نیش حجام را به نوعی با نوازش و محبت می‌پذیرد، مانند کسی که درد را تحمل می‌کند."],[209,"می دود حمال زی بار گران","می‌رباید بار را از دیگران","حمال که بار سنگینی بر دوش دارد، در حین دویدن بار دیگران را می‌دزدد."],[209,"جنگ حمالان برای بار بین","این چنین است اجتهاد کاربین","جنگ حمالان برسر بار، نشان‌دهنده تلاش و کوشش‌های آدمیان در زندگی است و این تلاش‌ها در حقیقت کاری است مبتنی بر فهم و اجتهاد."],[209,"چون گرانیها اساس راحتست","تلخها هم پیشوای نعمتست","سختی‌ها و مشکلات، اساس و پایه راحتی و آسایش هستند و تلخی‌ها هم راهنمای نعمت‌ها و خوشی‌ها به شمار می‌آیند."],[209,"حفت الجنه بمکروهاتنا","حفت النیران من شهواتنا","بهشت با کارهای ناپسند ما احاطه شده و آتش جهنم از خواسته‌های نفسانی ما پر شده است."],[209,"تخم مایه آتشت شاخ ترست","سوخته آتش قرین کوثرست","تخم یا اساس آتش، شاخ و برگ تر و تازه‌ای است که در حال سوختن است، و سوختن این آتش، با آب حیات و نعمت‌های بهشتی مرتبط است."],[209,"هر که در زندان قرین محنتیست","آن جزای لقمه‌ای و شهوتیست","هر کسی که در زندان قرار دارد و با سختی و محنت روبه‌روست، حاصل کار او تنها رسیدن به لذت‌های زودگذر و دنیوی است."],[209,"هر که در قصری قرین دولتیست","آن جزای کارزار و محنتیست","هر کس در قصر و کاخی زندگی می‌کند و در ارامش و نعمت است، به دلیل تلاش و زحمتی است که در میدان مبارزه و سختی‌ها کشیده است."],[209,"هر که را دیدی بزر و سیم فرد","دانک اندر کسب کردن صبر کرد","هر کسی را که دیدی بزرگ و صاحب ثروت است، بدان که او در به دست آوردن این ثروت صبر و تلاش زیادی کرده است."],[209,"بی سبب بیند چو دیده شد گذار","تو که در حسی سبب را گوش دار","هرگاه کسی بدون دلیل و غرض خاصی تو را ببیند، توجه کن که در دنیای محسوس، مسائل و عوامل را به خاطر بسپار."],[209,"آنک بیرون از طبایع جان اوست","منصب خرق سببها آن اوست","روح او چیزی فراتر از خصایص طبیعی است و مقام شگفت‌انگیز فراتر رفتن از علل و اسباب نیز مخصوص اوست."],[209,"بی سبب بیند نه از آب و گیا","چشم چشمه معجزات انبیا","انسان می‌تواند بدون وجود دلیل و سبب، به معجزات انبیا مانند چشمه‌ای که از آب و گیاه جداست، نگاه کند و آنها را ببیند. اینجا اشاره به این است که دیده‌ها و درک‌ها ممکن است از موارد ظاهری مستقل باشند."],[209,"این سبب همچون طبیب است و علیل","این سبب همچون چراغست و فتیل","این سبب امانتی است که درد را درمان می‌کند مانند طبیب، و همچنین مانند چراغی است که به کمک فتیل خود نور می‌دهد."],[209,"شب چراغت را فتیل نو بتاب","پاک دان زینها چراغ آفتاب","چراغ شب تو را با فتیل جدید روشن کن و بدان که این‌ها همانند چراغ آفتاب هستند که پاک و روشن‌اند."],[209,"رو تو کهگل ساز بهر سقف خان","سقف گردون را ز کهگل پاک دان","شما که با گل، سقف خانه را می‌سازید، بدانید که آسمان را نیز با گل پاکیزه بدانید."],[209,"آه که چون دلدار ما غمسوز شد","خلوت شب در گذشت و روز شد","وقتی دلدار ما غم‌انگیز و دردناک شد، تنها و بی‌کس بودن شب به پایان رسید و روزی جدید آغاز شد."],[209,"جز به شب جلوه نباشد ماه را","جز به درد دل مجو دلخواه را","ماه فقط در شب دیده می‌شود و در غیر آن قابل رؤیت نیست، پس هیچ چیز زیبا را در حال خوشی نمی‌توان یافت و دل‌خواهی را جز در درد دل نمی‌توان جستجو کرد."],[209,"ترک عیسی کرده خر پروده‌ای","لاجرم چون خر برون پرده‌ای","تو از خصایص و ویژگی‌های عیسی، پیامبر بزرگ و معانی عالی او دوری جسته‌ای و به بندگی و دلسوزی در برابر حیات مادی مانند خر وابسته شده‌ای، بنابراین در ظاهر نیز مانند خر به بی‌خبری و نادانی پرداخته‌ای."],[209,"طالع عیسیست علم و معرفت","طالع خر نیست ای تو خر صفت","سرنوشت عیسی، علم و معرفت است، اما سرنوشت خر (به معنای نادانی) چنین نیست. ای کسی که همچنان مانند خر رفتار می‌کنی، بدان که نمی‌توانی به مقام علم و معرفت عیسی برسید."],[209,"ناله خر بشنوی رحم آیدت","پس ندانی خر خری فرمایدت","اگر صدای ناله الاغ را بشنوی، دلت به رحم می‌آید؛ اما نمی‌دانی که الاغ، همان الاغ است و حالت او را تغییر نمی‌دهد."],[209,"رحم بر عیسی کن و بر خر مکن","طبع را بر عقل خود سرور مکن","به عیسی رحم کن و بر خر رحم نکن. طبع (روح) خود را بر عقلت حاکم نکن و از آن پیروی نکن."],[209,"طبع را هل تا بگرید زار زار","تو ازو بستان و وام جان گزار","طبیعت خود را به‌دست باد بسپار تا به شدت احساسات و اشک بریزد. سپس از آن احساسات رنج و اندوه را بگیر و جان خود را از قید آنها نجات بده."],[209,"سالها خر بنده بودی بس بود","زانک خربنده ز خر واپس بود","سال‌ها تو به عنوان بنده‌ای خجالت‌زده و وابسته به خواسته‌ها و میل‌های نفسانی زندگی کردی، زیرا این وابستگی به نفس و خواسته‌ها، تو را از رشد و حقیقت دور کرده است."],[209,"ز اخروهن مرادش نفس تست","کو به آخر باید و عقلت نخست","مراد از «اخروهن» نفس انسان است که باید در نهایت به آن توجه کرد؛ زیرا عقل انسان در ابتدا مهم‌تر است و باید به آن اعتماد کرد."],[209,"هم‌مزاج خر شدست این عقل پست","فکرش این که چون علف آرم به دست","عقل پست و نادان همچون خر شده است و فکرش تنها به فراهم کردن علف محدود می‌شود، بی‌آنکه به کارهای مهم‌تر و عمیق‌تر توجهی داشته باشد."],[209,"آن خر عیسی مزاج دل گرفت","در مقام عاقلان منزل گرفت","آن خر که در داستان عیسی (پیامبر بزرگ) از نشانه‌های او به شمار می‌رود، به دلیل رفتار ناپسند و افکار نادرست، در میان افراد عاقل و دانشمند جا و منزلت یافته است."],[209,"زانک غالب عقل بود و خر ضعیف","از سوار زفت گردد خر نحیف","زیرا عقل برتر و غالب است و خر ضعیف از سوار سنگین وزن، به ضعف و ناتوانی دچار می‌شود."],[209,"وز ضعیفی عقل تو ای خربها","این خر پژمرده گشتست اژدها","به خاطر ضعف عقل تو، ای خر، این موجود پژمرده به شکل اژدهایی بزرگ و ترسناک درآمده است."],[209,"گر ز عیسی گشته‌ای رنجوردل","هم ازو صحت رسد او را مهل","اگر دلت از عیسی (شخصیتی مقدس) رنجور شده است، باید بدانی که توسط او سلامتی به تو خواهد رسید، بنابراین به او مهلت بده تا به تو کمک کند."],[209,"چونی ای عیسی عیسی‌دم ز رنج","که نبود اندر جهان بی مار گنج","ای عیسی، چگونه‌ای؟ تو که از رنج‌ها به زندگی بخشیدن معروفی، چرا که در این دنیا گنجی بدون درد و رنج وجود ندارد."],[209,"چونی ای عیسی ز دیدار جهود","چونی ای یوسف ز مکار و حسود","ای عیسی، برخورد تو با یهودیان چگونه است؟ و ای یوسف، حال و عملکرد تو در برابر دورویی و حسادت دیگران چگونه است؟"],[209,"تو شب و روز از پی این قوم غمر","چون شب و روزی مددبخشای عمر","ای خدا، تو شب و روز در پی این قوم نادان و بی‌خبر هستی، مانند شب و روزی که به انسان عمر و زندگی می‌بخشد."],[209,"چونی از صفراییان بی‌هنر","چه هنر زاید ز صفرا درد سر","چطور می‌توان از بی‌هنران صفراوی (گستاخ و پست) هنری به وجود آورد؟ اساسا دردی که از صفرا می‌آید، فقط دردسر و مشکل به بار می‌آورد."],[209,"تو همان کن که کند خورشید شرق","با نفاق و حیله و دزدی و زرق","سخن تو باید مانند خورشید شرق باشد که با نفاق و حیله، دزدی و فریب، می‌تابد و جلوه‌گری می‌کند."],[209,"تو عسل ما سرکه در دنیا و دین","دفع این صفرا بود سرکنگبین","در دنیا و دین، تو عسل و شیرینی ما هستی و برای مقابله با تلخی و بدی‌ها، همچون سرکنگبین به‌ کار می‌آیی."],[209,"سرکه افزودیم ما قوم زحیر","تو عسل بفزا کرم را وا مگیر","ما به جماعت سرکه (تلخی و سختی) اضافه کرده‌ایم، اما تو (خدا) عسل (نیکویی و شیرینی) را بیفزا و کرم (رحمت) را هرگز از خود دور نکن."],[209,"این سزید از ما چنان آمد ز ما","ریگ اندر چشم چه فزاید عمی","این نتیجه از ماست که به این وضع دچار شده‌ایم؛ مانند دانه‌های ریز شن که در چشم می‌روند و چشمان را می‌آزارند، بنابراین این عذاب و مشکلات به خود ما برمی‌گردد."],[209,"آن سزد از تو ایا کحل عزیز","که بیابد از تو هر ناچیز چیز","ای خداوند عزیز و عزیزترین، شایسته است که از تو بهترین چیزها به دست آید، حتی اگر آن چیزها به نظر ناچیز و کوچک باشند."],[209,"ز آتش این ظالمانت دل کباب","از تو جمله اهد قومی بد خطاب","دل من به خاطر ظلم این ظالمان مانند کباب در آتش می‌سوزد؛ از تو (خداوند) است که به همه مردم (این قوم) خطاب و پیامی می‌فرستی."],[209,"کان عودی در تو گر آتش زنند","این جهان از عطر و ریحان آگنند","اگر در تو مانند چوب عود آتش بزنند، این جهان با عطر و بوی خوش پر می‌شود."],[209,"تو نه آن عودی کز آتش کم شود","تو نه آن روحی که اسیر غم شود","تو مانند عود نیستی که با آتش اثرش کم شود و نابود گردد؛ تو مثل روحی نیستی که به غم و ناراحتی گرفتار و تحت‌تأثیر قرار گیرد."],[209,"عود سوزد کان عود از سوز دور","باد کی حمله برد بر اصل نور","چوب عود وقتی می‌سوزد که از آتش دور باشد، اما اگر از اصل نور (منبع اصلی روشنایی) باشد، نمی‌تواند بر آن حمله‌ور شود. در اینجا به تمایز میان چیزهایی که از نور و حقیقت فاصله دارند و آن‌هایی که به اصل نور نزدیک‌اند اشاره دارد."],[209,"ای ز تو مر آسمانها را صفا","ای جفای تو نکوتر از وفا","ای خدایی که تو پاکی و زیبایی آسمان‌ها به خاطر توست، ناپسندی‌ها و مظالم تو بهتر از وفا و وفاداری است."],[209,"زانک از عاقل جفایی گر رود","از وفای جاهلان آن به بود","اگر جفای شخص عاقل پیش بیاید، بهتر از آن است که وفای جاهلان وجود داشته باشد."],[209,"گفت پیغامبر عداوت از خرد","بهتر از مهری که از جاهل رسد","پیامبر (یعنی موسی) گفت: دشمنی و عداوتی که ناشی از عقل و خرد باشد، از دوستی و مهری که از جاهلان برمی‌خیزد، بهتر است."],[210,"عاقلی بر اسپ می‌آمد سوار","در دهان خفته‌ای می‌رفت مار","عاقلی سوار اسبی در حال گذر بود، و مار به داخل دهان یک فرد خفته می‌خزید"],[210,"آن سوار آن را بدید و می‌شتافت","�