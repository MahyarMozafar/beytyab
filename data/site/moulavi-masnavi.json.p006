لی که معده‌ی دل به سمت زیبایی‌ها و چیزهای دلپذیر (مانند ریحان) تمایل دارد."],[756,"هر که کاه و جو خورد قربان شود","هر که نور حق خورد قرآن شود","هر کسی که از چیزهای بی‌ارزش و کم‌اهمیت (مثل کاه و جو) استفاده کند، قربانی می‌شود و از بین می‌رود؛ اما کسی که از نور حقیقت، که همان قرآن است، بهره‌مند شود، به مقام و معنای والاتری نائل می‌آید."],[756,"نیم تو مشکست و نیمی پشک هین","هین میفزا پشک افزا مشک چین","نصف وجود تو از خوبی و زیبایی است و نصف دیگر از زشتی و ناپاکی. باید مراقب باشی تا زشتی‌ها را افزایش ندهی و بر خوبی‌ها بیفزایی."],[756,"آن مقلد صد دلیل و صد بیان","در زبان آرد ندارد هیچ جان","مقلدی که فقط از دیگران تقلید می‌کند، هرچقدر هم دلیل و بیان بیاورد، در واقع روح و عمق هیچ چیزی را درک نکرده و در کلامش زندگی و جان ندارد."],[756,"چونک گوینده ندارد جان و فر","گفت او را کی بود برگ و ثمر","چون گوینده‌ای که بدون جان و روح است، نمی‌تواند اثر و ثمره‌ای داشته باشد، پس او چه چیزی می‌تواند بگوید و چه ارزشی دارد."],[756,"می‌کند گستاخ مردم را به راه","او بجان لرزان‌ترست از برگ کاه","او باعث می‌شود که مردم از روی ترس و وحشت به سوی او بیفتند، در حالی که این ترس بیشتر از لرزش یک برگ کاه است."],[756,"پس حدیثش گرچه بس با فر بود","در حدیثش لرزه هم مضمر بود","هرچند که سخن او از جنس بزرگی و شرافت است، اما در دل آن، اضطراب و ترسی نهفته است."],[757,"شیخ نورانی ز ره آگه کند","با سخن هم نور را همره کند","شیخ نورانی، انسان باکمال و آگاه، می‌تواند دیگران را به سوی روشنایی و معرفت هدایت کند و با کلامش، نور را در کنار آن‌چه می‌آموزد، به دیگران منتقل کند."],[757,"جهد کن تا مست و نورانی شوی","تا حدیثت را شود نورش روی","کوشش کن تا به حالت سرمستی و روشنی دست پیدا کنی تا گفتارت نیز درخشان و با نور شود."],[757,"هر چه در دوشاب جوشیده شود","در عقیده طعم دوشابش بود","هر چیزی که در داخل دوشاب (شیرین‌سازی) به جوش بیاید، طعم دوشاب را خواهد داشت. این جمله اشاره دارد به اینکه هر آنچه در زندگی به وجود می‌آید، تحت تأثیر ماهیت خود و مقدمه‌ای که بر آن است، خواهد بود."],[757,"از جزر وز سیب و به وز گردگان","لذت دوشاب یابی تو از آن","تو از جزر (نوعی سبزی)، سیب، و به (میوه) و گردو، طعم و لذت دوشاب (عسل غلیظ) را می‌چشیدی، اما این لذت واقعی از آن است که تو با این چیزها به درک و تجربه می‌رسی."],[757,"علم اندر نور چون فرغرده شد","پس ز علمت نور یابد قوم لد","علم هنگامی که در نور (حقیقت) قرار گیرد، مثل دانه‌ای فرغرده (رشد کرده و شکفته) می‌شود. پس، با علم تو، قوم (مردم) نور و روشنی پیدا می‌کنند."],[757,"هر چه گویی باشد آن هم نورناک","که آسمان هرگز نبارد غیر پاک","هر چه بگویی، آن هم نورانی و روشن است، زیرا آسمان هرگز باران نخواهد آورد اگر چیزی غیرپاک باشد."],[757,"آسمان شو ابر شو باران ببار","ناودان بارش کند نبود به کار","اگر می‌خواهی همچون آسمان شو و مانند ابر باران ببار، باید بدانی که ناودان فقط برای دریافت بارش است و نمی‌تواند بارش را خودش ایجاد کند."],[757,"آب اندر ناودان عاریتیست","آب اندر ابر و دریا فطرتیست","آب در ناودان (به عنوان نماد دانایی و علم) موقتی و عاریتی است، در حالی که آب در ابر و دریا (به عنوان نماد فطرت و ذات انسان) اصالت و دائمی دارد."],[757,"فکر و اندیشه‌ست مثل ناودان","وحی و مکشوفست ابر و آسمان","فکر و اندیشه، مانند ناودانی است که فقط مکان و وسیله‌ای برای دریافت وحی و مفاهیم الهی است که از آسمان و ابر نازل می‌شود."],[757,"آب باران باغ صد رنگ آورد","ناودان همسایه در جنگ آورد","آب باران، زیبایی و رنگارنگی را به باغ می‌آورد، در حالی که ناودان همسایه، موجب نزاع و درگیری می‌شود."],[757,"خر دو سه حمله به روبه بحث کرد","چون مقلد بد فریب او بخورد","خر پس از چند بار حمله به روبه، در بحث کردن با او کوشش کرد، اما چون کراهت و تقلید نادرست داشت، به نتیجه‌ای نرسید و فریب خورد."],[757,"طنطنه ادراک بینایی نداشت","دمدمه روبه برو سکته گماشت","خر توانایی درک و فهم عمیق نداشت و فقط نشانه‌هایی از بینایی را نشان می‌داد که در واقع تنها سر و صدا و اجزای بیرونی بودند. در حقیقت، روبه (به عنوان نماد) او را به حالتی از سکرات و بهت دچار کرد."],[757,"حرص خوردن آنچنان کردش ذلیل","که زبونش گشت با پانصد دلیل","حرص و طمع او را به قدری ذلیل و بی‌اراده کرده که با وجود دلایل و استدلال‌های بسیار، همچنان در وضعیت زبونی خود باقی مانده است."],[758,"کنده‌ای را لوطیی در خانه برد","سرنگون افکندش و در وی فشرد","لوطی ای(مرد لواط‌کار)، یک مرد زن‌صفتی را به خانه‌اش برد و....."],[758,"بر میانش خنجری دید آن لعین","پس بگفتش بر میانت چیست این","آن شخص ناپاک (لعین) خنجری را در میان خود دید و از او پرسید که این خنجر چیست و چرا در میان توست."],[758,"گفت آنک با من ار یک بدمنش","بد بیندیشد بدرم اشکمش","اگر کسی به من بد اندیشی کند، من با خنجری که در دست دارم، آن‌قدر او را می‌زنم که اشکم بریزد."],[758,"گفت لوطی حمد لله را که من","بد نه اندیشیده‌ام با تو به فن","لوطی خدا را شکر می‌کند که او هیچ بدی به تو نمی‌اندیشد و در نتیجه نیتش خالص است."],[758,"چون که مردی نیست خنجرها چه سود","چون نباشد دل ندارد سود خود","اگر مردی وجود نداشته باشد، خنجرها هیچ فایده‌ای ندارند؛ چون در absence of courage و دل، سود خاصی ندارد."],[758,"از علی میراث داری ذوالفقار","بازوی شیر خدا هستت بیار","تو از علی میراثی داری که شمشیرش، ذوالفقار، در دستان توست و تو مانند شیر خدا قوی و نیرومند هستی."],[758,"گر فسونی یاد داری از مسیح","کو لب و دندان عیسی ای قبیح","اگر به یاد داری که چه معجزاتی از عیسی مسیح بوده، نباید به خاطر عیوب ظاهری او چون لب و دندان، به او ایراد بگیری و او را زشت خطاب کنی."],[758,"کشتیی سازی ز توزیع و فتوح","کو یکی ملاح کشتی هم‌چو نوح","کشتی‌ای بساز که سمبل تقسیم و پیروزی است. این کشتی، ملاحی مانند نوح دارد که به هدایت دیگران می‌پردازد."],[758,"بت شکستی گیرم ابراهیم‌وار","کو بت تن را فدی کردن بنار","من به مانند ابراهیم که بت‌ها را می‌شکست، به خراب کردن بت‌های نفس و جسم خود پرداختم و آن‌ها را به آتش می‌زنم تا به رهایی برسم."],[758,"گر دلیلت هست اندر فعل آر","تیغ چوبین را بدان کن ذوالفقار","اگر دلیلی برای انجام کارت داری، تیغ چوبی را به مانند ذوالفقار (تیغ معروف علی) در نظر بگیر و به عمل بزن."],[758,"آن دلیلی که ترا مانع شود","از عمل آن نقمت صانع بود","دلیلی که تو را از انجام عمل باز می‌دارد، در واقع عذاب و عواقب ناشی از ساختار آفرینش است."],[758,"خایفان راه را کردی دلیر","از همه لرزان‌تری تو زیر زیر","ترسواها باعث شده‌اند که تو در این مسیر شجاع‌تر از همه لرزنده‌ها باشی؛ تو در دل خود زیرکی و حوشیاری بیشتری داری."],[758,"بر همه درس توکل می‌کنی","در هوا تو پشه را رگ می‌زنی","تو به همه درس‌های توکل اهمیت می‌دهی، اما در عمل قدرت خود را بر موجودی کوچک و بی‌خطر مانند پشه نشان می‌دهی."],[758,"ای مخنث پیش رفته از سپاه","بر دروغ ریش تو کیرت گواه","ای مخنث، تو که با سپاه به جلو رفته‌ای، بر روی دروغ، ریش تو گواهی می‌دهد که هویت واقعی‌ات چیست."],[758,"چون ز نامردی دل آکنده بود","ریش و سبلت موجب خنده بود","چون دل او پر از نامردی و رذالت بود، ریش و موهای بلندش موجب خنده و تمسخر دیگران می‌شد."],[758,"توبه‌ای کن اشک باران چون مطر","ریش و سبلت را ز خنده باز خر","توبه کن و از دل خود اشک بریز، مثل بارانی که بر زمین می‌ریزد، تا ریش و سبیل تو از خنده و شادی بازبماند."],[758,"داروی مردی بخور اندر عمل","تا شوی خورشید گرم اندر حمل","برای اینکه به مرحله‌ای بالاتر از مردان عادی برسی و تاثیرگذاری بیشتری داشته باشی، باید در عمل و کارهای خود تلاش کنی و به شکلی مؤثر ظاهر شوی، مانند خورشیدی که در میانه آسمان به گرمی و روشنی می‌تابد."],[758,"معده را بگذار و سوی دل خرام","تا که بی‌پرده ز حق آید سلام","به جای اینکه به امور دنیوی و مادی (مثل معده و خوراک) توجه کنی، به دل و احساسات خود بیا و توجهت را به حقیقت و معانی عمیق معطوف کن تا نکات و حقایق روحانی بی‌واسطه به تو سلام کنند."],[758,"یک دو گامی رو تکلف ساز خوش","عشق گیرد گوش تو آنگاه کش","یک یا دو قدم به جلو برو و خودت را به زحمت نینداز، عشق به تو نزدیک می‌شود، آنگاه گوش‌های تو آماده شنیدن آن خواهد بود."],[759,"روبه اندر حیله پای خود فشرد","ریش خر بگرفت و آن خر را ببرد","روباه با نیرنگ، پای خود را به زمین فشار داد و سپس ریش خر را گرفت و او را به دنبال خود برد."],[759,"مطرب آن خانقه کو تا که تفت","دف زند که خر برفت و خر برفت","مطرب آنجا که در خانقاه حضور دارد، کیست تا برای شادی و شادابی دست به ساز بزند، چونکه خر از بین رفته و دیگر نیست."],[759,"چونک خرگوشی برد شیری به چاه","چون نیارد روبهی خر تا گیاه","چون خرگوشی، شیری را به چاه کشاند، روباه نمی‌تواند خر را به گیاه برساند. در اینجا، به این نکته اشاره شده که وقتی فریب خورده شود، دیگر نمی‌تواند به هدفش برسد."],[759,"گوش را بر بند و افسونها مخور","جز فسون آن ولی دادگر","گوش خود را ببند و به سحرها و فریب‌ها گوش نده، جز به سحر و روش آن ولی دادگر و حق‌طلب."],[759,"آن فسون خوشتر از حلوای او","آنک صد حلواست خاک پای او","آن فریب و جادو که از حرف‌های او به دست می‌آید، از هزاران حلوا شیرین‌تر و دلپذیرتر است، چرا که آن حرف‌ها مانند خاک پای او، بسیار ارزشمند و گرانبهاست."],[759,"خنبهای خسروانی پر ز می","مایه برده از می لبهای وی","خنب‌های خسروانی (نوشیدنی‌ها یا می‌خواری‌های شاهانه) که از شراب لب‌های او به دست آمده، پر از خاصیت و عنوان می‌شود. در اینجا به لذت و شیرینی ناشی از شرابی اشاره دارد که از عشق حاصل شده است."],[759,"عاشق می باشد آن جان بعید","کو می لبهای لعلش را ندید","عاشق کسی است که آن روحی که دور است، حالا که لب‌های سرخ او را ندیده است، همچنان عاشق می‌ماند."],[759,"آب شیرین چون نبیند مرغ کور","چون نگردد گرد چشمه آب شور","مرغ کور هرگز نمی‌تواند آب شیرین را ببیند، بنابراین چگونه می‌تواند به دور چشمه آب شور بچرخد؟ این نشان می‌دهد که کسی که بینا نیست، قادر به درک زیبایی‌ها و نعمت‌ها نیست."],[759,"موسی جان سینه را سینا کند","طوطیان کور را بینا کند","موسی، پیامبر، دل و جان را مانند کوه سینا نورانی و روشن می‌سازد و باعث می‌شود طوطی‌های بی‌خبر و نادان، دیدگا ه و بینش پیدا کنند."],[759,"خسرو شیرین جان نوبت زده‌ست","لاجرم در شهر قند ارزان شده‌ست","خسرو (شاه) شیرین جان (شیرین) در این نوبت تصمیمی گرفته است، بنابراین در شهر، قند به قیمت ارزان‌تری عرضه می‌شود."],[759,"یوسفان غیب لشکر می‌کشند","تنگهای قند و شکر می‌کشند","افراد باهوش و هوشمند (یوسفان غیب) در حال آماده‌سازی و ایجاد نیرویی هستند که در مناطق پربار و شیرین (تنگ‌های قند و شکر) به فعالیت بپردازند."],[759,"اشتران مصر را رو سوی ما","بشنوید ای طوطیان بانگ درا","شترهایی که از مصر می‌آیند، را به سوی ما بکشید، ای طوطی‌ها (که نماد خبررسانی و خوش‌اخلاقی هستید) صدای نیک را بشنوید."],[759,"شهر ما فردا پر از شکر شود","شکر ارزانست ارزان‌تر شود","فردا در شهر ما، شکر فراوان خواهد بود و قیمت آن پایین‌تر از قبل می‌شود."],[759,"در شکر غلطید ای حلواییان","هم‌چو طوطی کوری صفراییان","در اینجا به افرادی که در کار شیرینی‌سازی مشغول هستند (حلواییان) اشاره شده و می‌گوید آنها مانند طوطی‌هایی هستند که در شکر غلتیده‌اند، اما کورند و نمی‌توانند به درستی آن را ببینند. این تعبیر به عدم درک و آگاهی آنها از حقیقت (شکر و تلخی زندگی) اشاره دارد."],[759,"نیشکر کوبید کار اینست و بس","جان بر افشانید یار اینست و بس","کار نیشکر کوبیدن تنها برای به‌دست آوردن شکر است، و یار فقط جان خود را فدای عشق و محبوب خود می‌کند."],[759,"نقل بر نقلست و می بر می هلا","بر مناره رو بزن بانگ صلا","این بیت به این معناست که پیوندها و اتصالات مختلفی در عالم وجود دارد و هر چیز بر چیز دیگر اثر می‌گذارد. همچنین، اشاره به رهایی و آزادی هست و با دعوت به توجه و فراخواندن دیگران به صدای بلندی (مانند طبل یا ناقوس) برای بیداری و آگاهی دارد."],[759,"سرکه نه ساله شیرین می‌شود","سنگ و مرمر لعل و زرین می‌شود","سرکه که نه سال بگذرد، شیرین می‌شود و سنگ و مرمر نیز با گذشت زمان به لعل و طلا تبدیل می‌شوند. این بیت به تغییر و تحول مثبت در چیزها با مرور زمان اشاره دارد."],[759,"آفتاب اندر فلک دستک‌زنان","ذره‌ها چون عاشقان بازی‌کنان","خورشید در آسمان با قدرت و شکوهی در حال درخشش است و ذرات کوچک گرد و غبار مانند عاشقانی در حال بازی و رقص هستند."],[759,"چشمها مخمور شد از سبزه‌زار","گل شکوفه می‌کند بر شاخسار","چشم‌ها از زیبایی سبزه‌زار مست و سرمست شده‌اند و گل‌ها درختان را محیای شکفتن و گل دادن می‌کنند."],[759,"چشم دولت سحر مطلق می‌کند","روح شد منصور انا الحق می‌زند","چشم دولت، یا به عبارتی نعمت و ثروت، به طور کامل در حال ظهور و تجلی است، روح منصور حلاج نیز با جملات \"من هستم حق\" در حال بسط و گسترش است."],[759,"گر خری را می‌برد روبه ز سر","گو ببر تو خر مباش و غم مخور","اگر روباه خر را می‌برد، تو نیز بگو که خر را ببر و نباش و نگران نباش."],[760,"آن یکی در خانه‌ای در می‌گریخت","زرد رو و لب کبود و رنگ ریخت","شخصی در خانه‌ای مخفی شده و به شدت وحشت دارد، به طوری که چهره‌اش رنگ پریده و لب‌هایش کبود شده است."],[760,"صاحب خانه بگفتش خیر هست","که همی لرزد ترا چون پیر دست","صاحب خانه از او می‌پرسد که چه می‌شود و چرا این‌قدر می‌لرزد، آیا مشکلی وجود دارد؟ با توجه به لرزیدن او، به نظر می‌رسد که احساس ترس او شدید است."],[760,"واقعه چونست چون بگریختی","رنگ رخساره چنین چون ریختی","این شخص به خاطر ترس، رنگ رخسارش زرد شده و حالش بسیار بد است. او از علت این ترس یا واقعه‌ای که باعث این حال شده می‌پرسد، زیرا مشخص نیست چه چیزی باعث این تغییر رنگ شده است."],[760,"گفت بهر سخره شاه حرون","خر همی‌گیرند امروز از برون","گفتند امروز به سبب شوخی شاه، در بیرون خر می‌گیرند."],[760,"گفت می‌گیرند کو خر جان عم","چون نه‌ای خر رو ترا زین چیست غم","گفت خر را میگیرند تو که خر نیستی چرا غمگین و ناراحتی ؟"],[760,"گفت بس جدند و گرم اندر گرفت","گر خرم گیرند هم نبود شگفت","گفت در کار خود خیلی جدی هستند اگر به جای خر‌ من را هم بگیرند جای تعجب ندارد"],[760,"بهر خرگیری بر آوردند دست","جدجد تمییز هم برخاستست","بیشتر مردم برای گرفتن خر آماده‌اند و در این میان، کسی که باید تمییز (تشخیص) دهد، هم متوجه شده و به پا خاسته است."],[760,"چونک بی‌تمییزیان‌مان سرورند","صاحب خر را به جای خر برند","وقتی که بی‌حیا و نادان‌ها بر ما تسلط دارند، صاحب خر (افراد عاقل و باهوش) را به جای خر (بی‌کفایت‌ها) می‌برند."],[760,"نیست شاه شهر ما بیهوده گیر","هست تمییزش سمیعست و بصیر","شاه شهر ما (یعنی حاکم) بی‌دلیلی به کسی که تمییز دارد (توانایی تشخیص خوب و بد) نمی‌گیرد، زیرا او (حاکم) دارای بصیرت و آگاهی است."],[760,"آدمی باش و ز خرگیران مترس","خر نه‌ای ای عیسی دوران مترس","ای آدم، تو انسان باش و از کسانی که خر می‌گیرند نترس، تو که خودت مانند عیسی، مرحمتی بزرگ هستی، پس نترس."],[760,"چرخ چارم هم ز نور تو پرست","حاش لله که مقامت آخرست","چرخ چهارم (سیاره زحل) نیز به نور و پرتو وجود تو روشن است. اما حاشا به خدا که مقام تو برای آخر و پایان است و تو از این حد و حدود بالاتر و والاتر هستی."],[760,"تو ز چرخ و اختران هم برتری","گرچه بهر مصلحت در آخری","تو از چرخ و ستاره‌ها هم برتر هستی، هرچند به خاطر مصلحت و حکمت در آستانۀ پایان و آخر عمر قرار داری."],[760,"میر آخر دیگر و خر دیگرست","نه هر آنک اندر آخر شد خرست","در پایان کار و در روز قیامت، سرنوشت انسان‌ها متفاوت خواهد بود و صرفا به این دلیل که کسی در آخر عمرش دچار ناپسندی شده است، به معنای آن نیست که او در حقیقت انسان بدی بوده است."],[760,"چه در افتادیم در دنبال خر","از گلستان گوی و از گلهای تر","ما در پی گرفتن خر از گلستان و گلابی که از گل‌های زیبا آمده، درگیر و سردرگم شده‌ایم."],[760,"از انار و از ترنج و شاخ سیب","وز شراب و شاهدان بی‌حسیب","از انار و ترنج (نوعی میوه) و شاخه‌های سیب و همچنین شراب و معشوقان زیبا و بی‌تاب، بهشتی پرنعمت و خوشگوار به تصویر کشیده شده است. این اشاره‌ها نشان‌دهنده زیبایی‌ها و لذت‌هایی است که در عشق و عیش و نوش وجود دارد."],[760,"یا از آن دریا که موجش گوهرست","گوهرش گوینده و بیناورست","شاید از دریا بگویید که امواج آن مانند جواهر می‌درخشند، اما در حقیقت، خود دریا گوینده و بینا است، یعنی معنای عمیق‌تری در دل این زیبایی نهفته است."],[760,"یا از آن مرغان که گل‌چین می‌کنند","بیضه‌ها زرین و سیمین می‌کنند","شاید اشاره به پرندگانی باشد که گل‌های زیبا را می‌چینند و از آن‌ها تخم‌هایی به رنگ زر و سیم می‌سازند. این تخم‌ها نماد چیزهای با ارزش و زیبا هستند."],[760,"یا از آن بازان که کبکان پرورند","هم نگون اشکم هم استان می‌پرند","شاعر به این فکر اشاره می‌کند که مثل بازهایی که کبک‌ها را شکار می‌کنند، چشم حسرت و ناراحتی من نیز هر لحظه در انتظار این است که اشک بریزم و از غم و اندوه بگریم."],[760,"نردبانهاییست پنهان در جهان","پایه پایه تا عنان آسمان","در این جهان نردبان‌هایی پنهان وجود دارد که هر کدام به صورت مرحله به مرحله ما را به آسمان و بالاترین مقام‌ها هدایت می‌کنند."],[760,"هر گره را نردبانی دیگرست","هر روش را آسمانی دیگرست","هر مشکلی یا گره‌ای در زندگی به راه‌حلی متفاوت نیاز دارد و هر روشی که انتخاب می‌شود، راهی جدید و مخصوص به خود دارد که می‌تواند به موفقیت یا آسمان امید برسد."],[760,"هر یکی از حال دیگر بی‌خبر","ملک با پهنا و بی‌پایان و سر","هر کسی از حال دیگری بی‌خبر است، حتی اگر ملک (سلطنت) بزرگی داشته باشد که وسعت و بی‌پایانی داشته باشد."],[760,"این در آن حیران که او از چیست خوش","وآن درین خیره که حیرت چیستش","این شخص در فراموشی و گیجی به سر می‌برد که نمی‌داند خوشی چیست و در عوض، کسی که در این وضعیت است، از حیرت خود در می‌ماند و نمی‌فهمد علت این حیرت چیست."],[760,"صحن ارض الله واسع آمده","هر درختی از زمینی سر زده","زمین خدا وسیع است و هر درختی از خاکی رشد کرده است، بنابراین جای ترس و نگرانی نیست."],[760,"بر درختان شکر گویان برگ و شاخ","که زهی ملک و زهی عرصه فراخ","بر درختان شکر، برگ و شاخه‌ها به قدری زیبا و دل‌نشین هستند که گویی آن‌ها متعلق به ملکی با وسعت بسیارند و نشان‌دهنده فضای گسترده و سرسبز زندگی هستند."],[760,"بلبلان گرد شکوفه پر گره","که از آنچ می‌خوری ما را بده","بلبلان دور شکوفه‌های پرپیچ و خم جمع شده‌اند و از آنچه که می‌خورید، به ما دهید."],[760,"این سخن پایان ندارد کن رجوع","سوی آن روباه و شیر و سقم و جوع","این حرف‌ها پایانی ندارد، برگرد به داستان روباه و شیر و گرسنگی و زخم‌ها."],[761,"چونک بر کوهش بسوی مرج برد","تا کند شیرش به حمله خرد و مرد","وقتی روباه به سمت کوه می‌رفت تا خر را به شیر برساند، می‌خواست به شیر حمله کند و آن را از پای درآورد."],[761,"دور بود از شیر و آن شیر از نبرد","تا به نزدیک آمدن صبری نکرد","خر از شیر دور بود و شیر نیز از جنگ دور ماند، اما خر نتوانست صبر کند و به نزدیک شیر رفت."],[761,"گنبدی کرد از بلندی شیر هول","خود نبودش قوت و امکان حول","شیر به خاطر قامت بلندی که داشت، مانند گنبد به نظر می‌رسید، ولی از شدت ترس و وحشت، نتوانسته بود به دور خود بچرخد یا حرکت کند."],[761,"خر ز دورش دید و برگشت و گریز","تا به زیر کوه تازان نعل ریز","روباه خر را از دور دید و برای اینکه خود را به خطر نیندازد، به سرعت به سمت زیر کوه و محل امنی فرار کرد."],[761,"گفت روبه شیر را ای شاه ما","چون نکردی صبر در وقت وغا","روباه به شیر می‌گوید: ای پادشاه، چرا در زمان جنگ صبر نکردی؟"],[761,"تا به نزدیک تو آید آن غوی","تا باندک حمله‌ای غالب شوی","اگر به نزد تو آن خر برسد، می‌توانی با چند حمله و کوشش او را تسخیر کنی و بر او تسلط پیدا کنی."],[761,"مکر شیطانست تعجیل و شتاب","لطف رحمانست صبر و احتساب","شتاب و عجله کردن ناشی از ترفند شیطان است، در حالی که صبر و انتظار کردن نشانه‌ی رحمت خداوند (رحمان) و پاداشی است که در انتظار است."],[761,"دور بود و حمله را دید و گریخت","ضعف تو ظاهر شد و آب تو ریخت","خر از حمله شیر دور بود و با دیدن آن، فرار کرد. این نشان‌دهنده ضعف تو است که در مواجهه با خطر، خود را از دست دادی و شجاعتت را به نمایش گذاشتی."],[761,"گفت من پنداشتم بر جاست زور","تا بدین حد می‌ندانستم فتور","شیر گفت: من گمان می‌کردم که قدرت و نیرو تا اینجا باقی‌است، اما نمی‌دانستم که کم‌حالی و ضعف به سراغم آمده است."],[761,"نیز جوع و حاجتم از حد گذشت","صبر و عقلم از تجوع یاوه گشت","طبق این بیت، گرسنگی و نیاز من به حد زیادی رسیده و صبر و عقل من از شدت گرسنگی به حالت بی‌خود و بی‌فکری رسیده است."],[761,"گر توانی بار دیگر از خرد","باز آوردن مر او را مسترد","اگر بتوانی دوباره با خرد و عقل، او را (خر) به من برگردانی."],[761,"منت بسیار دارم از تو من","جهد کن باشد بیاری‌اش به فن","من بسیار از تو سپاسگزارم و از تو می‌خواهم که تلاش کنی تا به او کمک کنی، زیرا این کار به مهارت و فنّ تو نیاز دارد."],[761,"گفت آری گر خدا یاری دهد","بر دل او از عمی مهری نهد","گفت: اگر خدا کمک کند، محبت عمیقی بر دل او می‌گذارد."],[761,"پس فراموشش شود هولی که دید","از خری او نباشد این بعید","اگر خر را به شیر ببری و بی‌احتیاطی کنی، فراموش می‌کند که باید از ترس شیر بترسد؛ این غیرعادی است که خر از خطر خود غافل شود."],[761,"لیک چون آرم من او را بر متاز","تا ببادش ندهی از تعجیل باز","اما وقتی من او را (خر) به شیر نزدیک کنم، تو از روی تعجیل او را نترسان و به باد ندهی."],[761,"گفت آری تجربه کردم که من","سخت رنجورم مخلخل گشته تن","شخصی می‌گوید که او به خوبی تجربه کرده که در حالتی بیمار و ضعیف به سر می‌برد و بدنش به شدت ناتوان و شکننده شده است."],[761,"تا به نزدیکم نیاید خر تمام","من نجنبم خفته باشم در قوام","تا زمانی که خر به نزدیکی من نرسد، من هیچ حرکتی نمی‌کنم و در آرامش می‌مانم."],[761,"رفت روبه گفت ای شه همتی","تا بپوشد عقل او را غفلتی","روباه به شیر (که نماد قدرت است) می‌گوید: ای پادشاه، همت کن تا عقل او (خر) را بپوشاند و او را به خواب غفلت ببرد."],[761,"توبه‌ها کردست خر با کردگار","که نگردد غره هر نابکار","خر با خداوند توبه کرده تا دیگر فریب هیچ فرد نادانی را نخورد و به نادانی‌ها دچار نگردد."],[761,"توبه‌هااش را به فن بر هم زنیم","ما عدوی عقل و عهد روشنیم","توبه‌های خر را با فریب و نیرنگ زیر پا می‌گذاریم، چرا که ما دشمنان عقل و پیمان روشن هستیم."],[761,"کله خر گوی فرزندان ماست","فکرتش بازیچه دستان ماست","سر خر، مانند گوی بازی فرزندان ماست و فکر او، ابزاری برای بازیگوشی و سرگرمی ماست."],[761,"عقل که آن باشد ز دوران زحل","پیش عقل کل ندارد آن محل","عقل که مربوط به دوران زحل است، نسبت به عقل کامل (عقل کل) در مقام و مرتبه پایین‌تری قرار دارد و با آن قابل مقایسه نیست."],[761,"از عطارد وز زحل دانا شد او","ما ز داد کردگار لطف‌خو","از سیاره‌های عطارد و زحل، او (عقل) دانا شده است و ما هم از لطف و بخشش خدای دادگر بهره‌مند گشته‌ایم."],[761,"علم الانسان خم طغرای ماست","علم عند الله مقصدهای ماست","دانش و آگاهی انسان، نشانه مقام و عظمت اوست و در نزد خداوند، هدف‌ها و مقاصد ما مشخص و از او دانسته شده است."],[761,"تربیه آن آفتاب روشنیم","ربی الاعلی از آن رو می‌زنیم","ما به یاد خدا، پرورش‌دهنده آن آفتاب روشن (که به معنای حقیقت و حقیقت‌نمایی است)، از بالاترین مقام (ربی الاعلی) به سمت او حرکت می‌کنیم."],[761,"تجربه گر دارد او با این همه","بشکند صد تجربه زین دمدمه","کسی که تجربه دارد، با وجود این همه، اگر بخواهد، می‌تواند صدها تجربه را در این شرایط حس کند و بشکند."],[761,"بوک توبه بشکند آن سست‌خو","در رسد شومی اشکستن درو","سست‌خو، که به راحتی توبه می‌کند و به بی‌ثباتی شناخته می‌شود، با شکست توبه‌اش به بدبختی و عاقبت شومی می‌رسد."],[762,"نقض میثاق و شکست توبه‌ها","موجب لعنت شود در انتها","شکستن پیمان و نقض توبه‌ها در نهایت باعث لعنت و عذاب خواهد شد."],[762,"نقض توبه و عهد آن اصحاب سبت","موجب مسخ آمد و اهلاک و مقت","شکستن توبه و پیمان گروهی از یهود که در روز سبت برای عبادت خداوند عمل نکردند، باعث شد که آن‌ها به موجوداتی زشت و نکوهیده تبدیل شوند و هلاک گردند."],[762,"پس خدا آن قوم را بوزینه کرد","چونک عهد حق شکستند از نبرد","خداوند آن گروه را به صورت بوزینه درآورد، زیرا که عهد خود را در جنگ شکستند."],[762,"اندرین امت نبد مسخ بدن","لیک مسخ دل بود ای بوالفطن","در این امت (مسلمانان)، بدن‌ها مسخ (تبدیل) نمی‌شود، اما دل‌ها مسخ می‌شود، ای بوالفطن (عنوانی برای اشاره به فردی دانا)."],[762,"چون دل بوزینه گردد آن دلش","از دل بوزینه شد خوار آن گلش","وقتی دل انسان به حالت دل بوزینه درمی‌آید، او از مقام خود تنزل پیدا می‌کند و به همان اندازه که بوزینه بی‌ارزش است، انسان نیز در نظر دیگران خوار و بی‌ارزش می‌شود."],[762,"گر هنر بودی دلش را ز اختبار","خوار کی بودی ز صورت آن حمار","اگر دل او (بوزینه) هنری می‌داشت، پس چرا از آزمایش و امتحان خوار شد و در چه حالتی می‌توانست به زیبایی ظاهری یک الاغ باشد؟"],[762,"آن سگ اصحاب خوش بد سیرتش","هیچ بودش منقصت زان صورتش","سگ اصحاب کهف (کاروانی از مومنان) به خاطر نیت و سیرت خوبش، هیچ کمبودی از لحاظ ظاهر و صورتش ندارد."],[762,"مسخ ظاهر بود اهل سبت را","تا ببیند خلق ظاهر کبت را","مسخ ظاهری که بر سر اصحاب سبت (مردم شنبه) آمد به این دلیل بود که مردم به خاطر آنچه که آن‌ها را ناپاک کرده بود، بتوانند چهره ناپاکی آن‌ها را ببینند."],[762,"از ره سر صد هزاران دگر","گشته از توبه شکستن خوک و خر","شکننده زرنگ توبه‌های خود، از طرفی به فساد رفت و به شکل‌های ناپسند درآمده است، و این نشان می‌دهد که بسیارانی از این کارها به گمراهی و عمل زشت منجر می‌شود."],[763,"پس بیامد زود روبه سوی خر","گفت خر از چون تو یاری الحذر","روبات برای فریب دادن خر به سمت او آمد و به او هشدار داد که از دوستی با چنین موجودی باید احتیاط کند."],[763,"ناجوامردا چه کردم من ترا","که به پیش اژدها بردی مرا","ای ناجوانمرد، چه کار زشتی با من کردی که مرا به پیش اژدهای خطرناک کشاندی؟"],[763,"موجب کین تو با جانم چه بود","غیر خبث جوهر تو ای عنود","کینه‌ی تو با جان من به چه دلیلی است جز اینکه ذات تو پلید است، ای دشمن سرسخت؟"],[763,"هم‌چو کزدم کو گزد پای فتی","نارسیده از وی او را زحمتی","همان‌طور که مگس در گوشه‌ای نشسته و پای فتی (پای فکری) را می‌زند، او همچنین (روباه) زحمتی از ما نداشته و به ما آسیب نمی‌زند."],[763,"یا چو دیوی کو عدوی جان ماست","نارسیده زحمتش از ما و کاست","چنانکه دیوی که دشمن جان ماست، هنوز به ما آسیب نرسانده و زحمتی از او بر ما کم شده است."],[763,"بلک طبعا خصم جان آدمیست","از هلاک آدمی در خرمیست","این بیت بیان می‌کند که در واقع، دشمن اصلی جان انسان، طبیعت اوست، و هلاکت انسان در خوشی‌ها و لذت‌ها نهفته است."],[763,"از پی هر آدمی او نسکلد","خو و طبع زشت خود او کی هلد","هر آدمی که در مسیر زندگی‌اش دچار مشکلات و نابسامانی‌ها می‌شود، در واقع خصم و دشمن درونی او، یعنی نفس و طبیعت زشت خود اوست که او را به انحراف و فساد می‌کشد."],[763,"زانک خبث ذات او بی‌موجبی","هست سوی ظلم و عدوان جاذبی","چون ذات او به خاطر زشتی و نقصش هیچ دلیلی ندارد، به سمت ظلم و ستم کشیده می‌شود و به این کار جذب می‌شود."],[763,"هر زمان خواند ترا تا خرگهی","که در اندازد ترا اندر چهی","هر زمان کسی تو را صدا می‌زند، مانند خر، که تو را به چاهی بیندازد."],[763,"که فلان جا حوض آبست و عیون","تا در اندازد به حوضت سرنگون","در فلان جا برکه‌ای از آب وجود دارد و چشمه‌هایی هست تا تو را به سمت حوض بیندازد و غرق کند."],[763,"آدمی را با همه وحی و نظر","اندر افکند آن لعین در شور و شر","شیطان، انسان را با وجود همه‌ی راهنمایی‌ها و دانش‌هایی که دارد به شک و تردید می‌اندازد و او را به انحراف و آشفتگی می‌کشاند."],[763,"بی‌گناهی بی‌گزند سابقی","که رسد او را ز آدم ناحقی","این بیت اشاره دارد به انسانی که قبلا بی‌گناه و بی‌آسیب بوده، اما با ورود فردی ناپاک (مانند شیطان یا لعین) به زندگی‌اش، دچار مشکلات و آسیب می‌شود. به عبارتی دیگر، این فرد به خاطر نفرین یا وسوسه‌هایی که بر اثر آدم‌های ناحق به او رسیده، آسیب‌پذیر و در معرض خطر قرار می‌گیرد."],[763,"گفت روبه آن طلسم سحر بود","که ترا در چشم آن شیری نمود","روباه گفت که او طلسم سحر است که تو را در نظر شیر، بزرگ و ترسناک نشان داده است."],[763,"ورنه من از تو به تن مسکین‌ترم","که شب و روز اندر آنجا می‌چرم","در غیر این صورت، من از تو به حال مسکین‌تری هستم، زیرا شب و روز در آنجا مانند یک گاو چرم می‌زنم (یعنی بی‌خود و بی‌خبری می‌گذرانم)."],[763,"گرنه زان گونه طلسمی ساختی","هر شکم‌خواری بدانجا تاختی","اگر چنین طلسمی برپا کرده‌ای، پس هر ولنگاری و شکم‌خواری به آنجا حمله‌ور شده است."],[763,"یک جهان بی‌نوا پر پیل و ارج","بی‌طلسمی کی بماندی سبز مرج","در یک جهان بی‌نوا، که به نظر می‌رسد پر از ابهت و قدرت (پیل و ارج) باشد، اگر طلسمی وجود نداشته باشد، آیا جایی برای آرامش و رشد (سبز مرج) باقی خواهد ماند؟"],[763,"من ترا خود خواستم گفتن به درس","که چنان هولی اگر بینی مترس","من خودم خواستم تو را به درس گفتن بپردازم، زیرا اگر چنین ترسی را ببینی، نترس."],[763,"لیک رفت از یاد علم آموزیت","که بدم مستغرق دلسوزیت","اما یادگیری و علم‌آموزی تو از یاد رفته و من در غم و دل‌سوزی تو غرق شده‌ام."],[763,"دیدمت در جوع کلب و بی‌نوا","می‌شتابیدم که آیی تا دوا","من تو را در حال گرسنگی و بی‌پناهی دیدم و به شتاب می‌آیم تا به تو کمک کنم و درمانی بیاورم."],[763,"ورنه با تو گفتمی شرح طلسم","که آن خیالی می‌نماید نیست جسم","اگر با تو صحبت نمی‌کردم و درباره راز و نشانه‌ها توضیح نمی‌دادم، شاید می‌پنداشتی که آن‌چه می‌بینی، واقعی نیست و فقط یک خیال است."],[764,"گفت رو رو هین ز پیشم ای عدو","تا نبینم روی تو ای زشت‌رو","می‌گوید: برو از مقابل من ای دشمن، تا دیگر نتوانم روی زشت تو را ببینم."],[764,"آن خدایی که ترا بدبخت کرد","روی زشتت را کریه و سخت کرد","خدایانی که تو را بدبخت کرده، باعث شده‌اند که چهره‌ات زشت و کریه و سخت به نظر بیاید."],[764,"با کدامین روی می‌آیی به من","این چنین سغری ندارد کرگدن","با چه چهره‌ای به من نزدیک می‌شوی در حالی که چهره زشت تو هیچ شباهتی به زیبایی ندارد؟"],[764,"رفته‌ای در خون جانم آشکار","که ترا من ره‌برم تا مرغزار","من تو را می‌بینم که در عمق جانم نفوذ کرده‌ای، به گونه‌ای که به من نشان می‌دهی که هدایتگر من هستی و به سوی سرزمین‌های خوب و دل‌انگیز می‌روی."],[764,"تا بدیدم روی عزرائیل را","باز آوردی فن و تسویل را","وقتی چهره عزرائیل، فرشته مرگ، را دیدم، تو با هنر و ترفند خود، مرا به حالتی توجیه کردید."],[764,"گرچه من ننگ خرانم یا خرم","جانورم جان دارم این را کی خرم","هرچند که من به خاطر این که شبیه الاغ‌ها هستم، خود را بی‌ارزش می‌دانم و نمی‌خواهم به این خاطر شرمنده شوم، اما زندگی را دارم و این واقعیت را کتمان نمی‌کنم."],[764,"آنچ من دیدم ز هول بی‌امان","طفل دیدی پیر گشتی در زمان","من آنچه را از ترس و وحشت بی‌پایان دیدم، تو نیز آن را ببین و بفهم که چگونه یک کودک در گذر زمان پیری را تجربه می‌کند."],[764,"بی‌دل و جان از نهیب آن شکوه","سرنگون خود را درافکندم ز کوه","از شدت ترس و وحشت آن صدا به حالت بی‌پناهی و بی‌کسی، خود را از بلندی کوه به زمین انداختم."],[764,"بسته شد پایم در آن دم از نهیب","چون بدیدم آن عذاب بی‌حجیب","در آن لحظه که از سر صدای نهیب و تهدید، پایم بسته شد، وقتی عذاب شدید و بدون پرده را دیدم، حس کردم که در معرض خطر و سختی قرار گرفته‌ام."],[764,"عهد کردم با خدا کای ذوالمنن","برگشا زین بستگی تو پای من","با خدا پیمان بستم که ای بخشنده، این گرفتاریم را از میان برکن و پاهایم را آزاد کن."],[764,"تا ننوشم وسوسه کس بعد ازین","عهد کردم نذر کردم ای معین","من عهد کرده‌ام که تا زمانی که وسوسه‌ای از کسی به دلم نیفتد، نخواهم نوشید. ای معین (معیّن)، این را نذر کرده‌ام."],[764,"حق گشاده کرد آن دم پای من","زان دعا و زاری و ایمای من","در آن لحظه، به خاطر دعا و ناله و سعی من، خداوند راه را برای من باز کرد و پنجه نجات را به من عطا نمود."],[764,"ورنه اندر من رسیدی شیر نر","چون بدی در زیر پنجه شیر خر","اگر تو به من نزدیک می‌شدی، همان‌طور که شیر نر بر زمین با پنجه‌اش خر را زیر می‌گیرد، این‌گونه به تو می‌فتم و در واقعی به تو آسیب می‌زدم."],[764,"باز بفرستادت آن شیر عرین","سوی من از مکر ای بئس القرین","شیر نر (که نماد قدرت و شجاعت است) دوباره تو را به نزد من فرستاد، اما از مکر و نیرنگی که در وجود توست، بیزارم و تو را دوستان خوبی به حساب نمی‌آورم."],[764,"حق ذات پاک الله الصمد","که بود به مار بد از یار بد","خداوند متعال و یکتا، کسی است که از وجود دوست بد، به مانند مار بد، به انسان آسیب می‌زند."],[764,"مار بد جانی ستاند از سلیم","یار بد آرد سوی نار مقیم","مار بد، که نشانه‌ای از شر و خطر است، جان شخص سلیم و بی‌زرر را می‌گیرد و یار بد او را به جایی می‌برد که همیشه در آتش و عذاب است. این اشاره به تاثیرات منفی افراد بد در زندگی انسان‌های نیکو دارد."],[764,"از قرین بی‌قول و گفت و گوی او","خو بدزدد دل نهان از خوی او","دوست نادان و بی‌اطلاع از گفتار و رفتار آدمی، به‌راحتی می‌تواند احساسات و آرزوهای درونی او را برباید و از او چیزی بگیرد."],[764,"چونک او افکند بر تو سایه را","دزدد آن بی‌مایه از تو مایه را","وقتی او (روباه) بر تو سایه می‌افکند، بی‌مایه (خر) از تو مایه (معنا و ارزش) را می‌دزدد."],[764,"عقل تو گر اژدهایی گشت مست","یار بد او را زمرد دان که هست","اگر عقل تو مانند اژدهایی مست و بی‌خود شده باشد، بدان که یار بد تو هم مانند زمردی است که وجود دارد، و به این معنی است که این یار خیری برای تو ندارد."],[764,"دیده عقلت بدو بیرون جهد","طعن اوت اندر کف طاعون نهد","اگر عقل تو به شدت مغرور و مست شده باشد، دیدی که در نتیجه آن به دیگران طعنه می‌زنی، همانند انسانی است که بیماری طاعون دستش را گرفته و به دیگران آسیب می‌زند."],[765,"گفت روبه صاف ما را درد نیست","لیک تخییلات وهمی خورد نیست","روباه گفت ما به خاطر دل صاف و بی‌دردی که داریم، هیچ دردی نداریم، اما خیال‌ها و تصورات تو، به ما آسیبی نمی‌زند."],[765,"این همه وهم توست ای ساده‌دل","ورنه بر تو نه غشی دارم نه غل","این توهمات همه از طرف توست، ای دل ساده، وگرنه من هیچ نوع بدی نسبت به تو ندارم و دلیلی برای فریب تو وجود ندارد."],[765,"از خیال زشت خود منگر به من","بر محبان از چه داری سؤ ظن","به خاطر خیال‌های بد و نادرست خود به من نگاه نکن؛ بلکه به عاشقان و محبان نگاه کن و ببین چرا به من سوء ظن دارید."],[765,"ظن نیکو بر بر اخوان صفا","گرچه آید ظاهرا زیشان جفا","حتی اگر به ظاهر از دوستان خوبی جفا و بدرفتاری دیده شود، باید به آن‌ها حسن ظن داشت و به نیکی آن‌ها اعتماد کرد."],[765,"این خیال و وهم بد چون شد پدید","صد هزاران یار را از هم برید","این فکر و توهم بد چه زمانی به وجود آمد، باعث شد که صدها دوست را از یکدیگر جدا کند."],[765,"مشفقی گر کرد جور و امتحان","عقل باید که نباشد بدگمان","اگر کسی با محبت رفتار کند و از او سختی و آزمایشی ببینیم، نباید به او بدگمان باشیم و باید با عقل و درک صحیح به او نگاه کنیم."],[765,"خاصه من بدرگ نبودم زشت‌اسم","آنک دیدی بد نبد بود آن طلسم","من، به‌خصوص، در زمان زشت‌نامی، زیر تأثیر آن طلسم (حالت یا شرایط خاص) نبودم، زیرا آنچه تو دیدی بد نیست و برعکس، خوب است."],[765,"ور بدی بد آن سگالش قدرا","عفو فرمایند یاران زان خطا","اگر بدی از آن سگ (خر) ناشی شده باشد، یاران او از آن خطا می‌گذرند و آن را عفو می‌کنند."],[765,"عالم وهم و خیال طمع و بیم","هست ره‌رو را یکی سدی عظیم","علم و خیالات به همراه آرزوها و ترس‌ها، برای سالک (کسی که در راه سیر و سلوک است) مانند سدی بزرگ عمل می‌کند و مانع از پیشرفت او می‌شود."],[765,"نقشهای این خیال نقش‌بند","چون خلیلی را که که بد شد گزند","این خیال‌ها مانند نقش‌هایی هستند که در دل خلیل (ابراهیم) ایجاد شده‌اند، و اگر او را دچار آسیب و گزند کنند، به مانند خلیلی می‌شوند که در اثر ضربه‌ای بد شکل شده است."],[765,"گفت هذا ربی ابراهیم راد","چونک اندر عالم وهم اوفتاد","گفت: این کسی که می‌بینید، معبود من است؛ ابراهیم(ع) چنین سخنی را به این دلیل گفت که در عالم خیال و وهم قرار گرفت."],[765,"ذکر کوکب را چنین تاویل گفت","آن کسی که گوهر تاویل سفت","این بیت درباره شخصی است که توضیح می‌دهد که معنای ستاره را به گونه‌ای تفسیر کرده که از دیدگاه عمیق‌تری به آن نگاه کند. او مانند کسی است که به حقیقت و عمق موضوعات توجه دارد و می‌تواند معانی ظریف را درک کند."],[765,"عالم وهم و خیال چشم‌بند","آنچنان که را ز جای خویش کند","عالم وهم و خیال مانند چشم‌بندی است که انسان را از واقعیت دور می‌کند و او را از مکان واقعی‌اش بیرون می‌برد."],[765,"تا که هذا ربی آمد قال او","خربط و خر را چه باشد حال او","وقتی که کسی در حال گفتن این جمله است که «این، پروردگار من است»، او در حقیقت مسخره می‌کند و صحبت از خر و حال او به این معنی است که به رفتارهای بی‌خود و غیرمنطقی خود انسان‌ها اشاره دارد."],[765,"غرق گشته عقلهای چون جبال","در بحار وهم و گرداب خیال","عقل‌های افرادی که مانند کوه‌ها بزرگ و محکم هستند، در دریاهای توهم و گرداب خیال غرق شده‌اند."],[765,"کوهها را هست زین طوفان فضوح","کو امانی جز که در کشتی نوح","در اینجا گفته شده که عقل‌هایی که چون کوه‌ها هستند، در طوفان افکار و خیالات غرق شده‌اند و تنها جایی که می‌توان به آن پناه برد، کشتی نوح است که نماد نجات و امنیت است."],[765,"زین خیال ره‌زن راه یقین","گشت هفتاد و دو ملت اهل دین","این خیال، افرادی را که در جستجوی حقیقت و یقین هستند از راه راست منحرف می‌کند و باعث می‌شود که آنها به هفتاد و دو ملت مختلف دینی تقسیم شوند."],[765,"مرد ایقان رست از وهم و خیال","موی ابرو را نمی‌گوید هلال","مردی که به یقین و حقیقت رسیده است، دیگر به خیالات و تصورات اهمیت نمی‌دهد و به زیبایی‌های ظاهری مانند قوس ابروی کسی توجه نمی‌کند."],[765,"وآنک نور عمرش نبود سند","موی ابروی کژی راهش زند","اگر نور عمر شخصی وجود نداشته باشد، نمی‌تواند به به درستی روی موی ابروی خود (نمادی از زیبایی یا کمال) تکیه کند، زیرا کژی و انحراف مسیرش را زیر پا می‌گذارد."],[765,"صد هزاران کشتی با هول و سهم","تخته تخته گشته در دریای وهم","بسیاری از کشتی‌ها در دریای وهم که به معنای توهم و خیالات است، سرگردان و ترسان شده‌اند و به تکه‌های جداگانه تقسیم گشته‌اند."],[765,"کمترین فرعون چست فیلسوف","ماه او در برج وهمی در خسوف","کمترین فرعون، که اشاره به کسی با قدرت و مقام کم‌تر از فرعون دارد، به مانند یک فیلسوف زبرنگر است که تحت تاثیر وضعیت وهم‌آلود و تاریک فکر خود قرار دارد. او در دوره‌ای از سردرگمی و عدم وضوح فکری به سر می‌برد، مثل زمانی که ماه در سایه قرار می‌گیرد و دیده نمی‌شود."],[765,"کس نداند روسپی‌زن کیست آن","وانک داند نیستش بر خود گمان","هیچ‌کس نمی‌داند که آن شخص که در برابر تو به صورت فاحشه رفتار می‌کند، کیست و اگر کسی هم این را می‌داند، در واقع خودش در اشتباه است و به گمان خود می‌رسد."],[765,"چون ترا وهم تو دارد خیره‌سر","از چه گردی گرد وهم آن دگر","وقتی که تو به خاطر خیال‌های خود، دچار سردرگمی و غفلت می‌شوی، دیگر چه نیازی به گیج شدن و سرگردانی در آن خیال‌ها داری؟"],[765,"عاجزم من از منی خویشتن","چه نشستی پر منی تو پیش من","من از ویژگی‌های خودم ناتوان و عاجزم، پس چرا تو با آنهمه خودبینی و غرور در مقابل من نشسته‌ای؟"],[765,"بی‌من و مایی همی‌جویم به جان","تا شوم من گوی آن خوش صولجان","من در جستجوی بی‌من و بی‌ما هستم و می‌کوشم تا به این حالتی که خودم نمی‌خواهم، دست یابم و چنین حالتی، حالتی است خوش و دلپذیر."],[765,"هر که بی‌من شد همه من‌ها خود اوست","دوست جمله شد چو خود را نیست دوست","هر کسی که از من فاصله بگیرد، در واقع همه اجزای وجود خود را از دست داده است، زیرا او باید ابتدا خود را دوست داشته باشد تا بتواند دیگری را دوست بدارد."],[765,"آینه بی‌نقش شد یابد بها","زانک شد حاکی جمله نقشها","آینه، که بدون نقش و تصویر است، به خاطر آن که نشان‌دهنده تمام نقش‌هاست، ارزش و بها پیدا می‌کند. این به این معناست که کسی که خالی از خودخواهی و نقش‌های دنیوی باشد، می‌تواند به عمق وجود دیگران و خلق و خوهایشان پی ببرد و از این طریق جایگاه والایی پیدا کند."],[766,"زاهدی در غزنی از دانش مزی","بد محمد نام و کنیت سررزی","زاهدی در غزنی به نام محمد که کنیتش سررزی است، وجود داشت که از دانش و علم بی‌نظیری برخوردار بود."],[766,"بود افطارش سر رز هر شبی","هفت سال او دایم اندر مطلبی","شیخ محمد سررزی به مدت هفت سال، هر شب افطارش فقط یک دانه سرخس (یا گل رز) بود و همیشه در حال بررسی و تحقیق در موضوعی خاص بود."],[766,"بس عجایب دید از شاه وجود","لیک مقصودش جمال شاه بود","شیخ محمد سررزی در طول هفت سال، حیرت‌های زیادی از وجود خداوند (شاه وجود) مشاهده کرده است، اما هدف او تنها دست‌یابی به زیبایی و جمال الهی بوده است."],[766,"بر سر که رفت آن از خویش سیر","گفت بنما یا فتادم من به زیر","او که در حال سیر و سلوک است، به بالای سر کسی که به او محبت دارد، می‌رسد و از او می‌خواهد تا نشان دهد آیا به زمین افتاده است یا نه."],[766,"گفت نامد مهلت آن مکرمت","ور فرو افتی نمیری نکشمت","گفت: زمانی برای نشان دادن بزرگواری و مهربانی باقی نمانده و اگر هم سقوط کنی، نمی‌میرم و آسیب نمی‌رسانمت."],[766,"او فرو افکند خود را از وداد","در میان عمق آبی اوفتاد","شیخ محمد سررزی خود را از عشق و محبت به زمین انداخت و در عمق آب فرو رفت."],[766,"چون نمرد از نکس آن جان‌سیر مرد","از فراق مرگ بر خود نوحه کرد","مردی که جانش از شدت محبت جان‌سوز خسته و سیر شده، وقتی مرگ را نمی‌بیند، به خاطر جدایی از مرگ بر خود ناله و زاری می‌کند."],[766,"کین حیات او را چو مرگی می‌نمود","کار پیشش بازگونه گشته بود","چون زندگی او به نظرش مانند مرگ بود، کارها و رفتارهایش دگرگون شده بود."],[766,"موت را از غیب می‌کرد او کدی","ان فی موتی حیاتی می‌زدی","او (شیخ محمد سررزی) به مرگ به چشم راز و عمیق می‌نگریست و از دنیای باطنی آن، زندگی دیگری را می‌فهمید و در حقیقت، در مرگ حیات را می‌دید."],[766,"موت را چون زندگی قابل شده","با هلاک جان خود یک دل شده","موت را همچون زندگی ارزشمند و قابل تصور کرده و با نابودی جانش، به آن یکپارچگی و هماهنگی بخشیده است."],[766,"سیف و خنجر چون علی ریحان او","نرگس و نسرین عدوی جان او","سیف و خنجر (شمشیر و چاقو) از ویژگی‌های علی (علی بن ابی‌طالب) است و مانند ریحان و نرگس (دو گل زیبا) جان او را زیبا می‌کنند. اینجا اشاره به این دارد که مانند گل‌ها، مظهر زیبایی و لطافت، علی نیز با شجاعت و دلاوری‌اش، بعدی از زیبایی و قدرت را به وجود می‌آورد."],[766,"بانگ آمد رو ز صحرا سوی شهر","بانگ طرفه از ورای سر و جهر","صدا آمد که از دشت به سمت شهر بیاید، صدایی شگفت‌انگیز از دور به گوش می‌رسد."],[766,"گفت ای دانای رازم مو به مو","چه کنم در شهر از خدمت بگو","شیخ محمد سررزی، با تشخیص بالای خود، از دانای رازها می‌خواهد که در مورد خدمت به دیگران در شهر مشاوره بدهد و به او بگوید که چه کاری باید انجام دهد."],[766,"گفت خدمت آنک بهر ذل نفس","خویش را سازی تو چون عباس دبس","گفتن خدمت برای تو در واقع برای ذلت نفس خودت است، همان‌طور که عباس دبس (شخصیتی فریبنده و شکسته نفس) این کار را می‌کند."],[766,"مدتی از اغنیا زر می‌ستان","پس به درویشان مسکین می‌رسان","مدتی از ثروتمندان پول می‌گیرد و سپس به فقیران و مسکین‌ها می‌دهد."],[766,"خدمتت اینست تا یک چند گاه","گفت سمعا طاعة ای جان‌پناه","خدمت من برای تو این است که به خاطر تو و با احترام گوش می‌سپارم و اطاعت می‌کنم، ای پناه‌دهنده جانم."],[766,"بس سؤال و بس جواب و ماجرا","بد میان زاهد و رب الوری","در این بیت، اشاره به گفت‌وگو و مباحثه فراوانی است که میان زاهد (قدیس یا فرد زاهد از دنیا) و خدای رب الوری (پروردگار جهان) وجود دارد. زاهد به خاطر سوالاتش و پاسخ‌هایی که می‌گیرد، وارد ماجرای عمیقی می‌شود."],[766,"که زمین و آسمان پر نور شد","در مقالات آن همه مذکور شد","زمین و آسمان به واسطه مطالبی که در آن گفتگوها مطرح شد، روشن و پر از نور شد."],[766,"لیک کوته کردم آن گفتار را","تا ننوشد هر خسی اسرار را","اما من سخنانم را مختصر بیان کردم تا هر فرد بی‌ارزشی اسرار را ننویسد و فاش نکند."],[767,"رو به شهر آورد آن فرمان‌پذیر","شهر غزنین گشت از رویش منیر","او که فرمان‌پذیر است، به سمت شهر غزنین حرکت کرد و چهره‌اش به سبب شادابی و نورانی بودن به زیبایی درخشید."],[767,"از فرح خلقی به استقبال رفت","او در آمد از ره دزدیده تفت","او از خوشحالی مردم به استقبال رفت و به طوری مخفیانه وارد شد."],[767,"جمله اعیان و مهان بر خاستند","قصرها از بهر او آراستند","همه اشراف و بزرگان به پا خاستند و به خاطر او قصرها را تزئین کردند."],[767,"گفت من از خودنمایی نامدم","جز به خواری و گدایی نامدم","او می‌گوید که من برای خودنمایی و دیده شدن نیامده‌ام، بلکه هدفم فقط خواری و گدایی است؛ به معنای این که به دنبال فروتنی و خدمت به دیگران هستم."],[767,"نیستم در عزم قال و قیل من","در به در گردم به کف زنبیل من","من درگیر نکته‌های بی‌فایده و گفتگوهای بی‌معنی نیستم، بلکه به دنبال آن هستم که به هر گوشه‌ای بروم و با خود زنبیلی از نیکی و خدمت به دیگران بیاورم."],[767,"بنده فرمانم که امرست از خدا","که گدا باشم گدا باشم گدا","من در برابر فرمان خدا تسلیم هستم و باید گدا باشم؛ برای من افتخار است که گدا باشم."],[767,"در گدایی لفظ نادر ناورم","جز طریق خس گدایان نسپرم","در گدایی از به زبان آوردن سخنان کم‌مقدار و نادر خودداری می‌کنم و جز راه و رسم گدایان واقعی را دنبال نمی‌کنم."],[767,"تا شوم غرقه مذلت من تمام","تا سقطها بشنوم از خاص و عام","می‌خواهم به حدی غرق در ذلت شوم که سخن و نقدها و حرف‌های مردم (به ویژه خاصان و عامان) را درباره‌ام بشنوم."],[767,"امر حق جانست و من آن را تبع","او طمع فرمود ذل من طمع","حقیقت الهی همان جان و روح آدمی است و من تنها پیرو آن خواهش روحانی هستم؛ زیرا به من آموختند که ذلت و خواری از طمع خواسته‌ها بر من عارض می‌شود."],[767,"چون طمع خواهد ز من سلطان دین","خاک بر فرق قناعت بعد ازین","وقتی که سلطان دین (شخصی محترم و بزرگ در دین) از من طمع و خواسته‌ای دارد، باید خاک بر سر قناعت بریزم و دیگر به آن قناعت نکنم."],[767,"او مذلت خواست کی عزت تنم","او گدایی خواست کی میری کنم","او خواهان ذلت است، چگونه می‌تواند عزت و شرف من را بخواهد؟ او در پی گدایی و نیاز است، چگونه می‌تواند مرا به سوی مرگ بکشاند؟"],[767,"بعد ازین کد و مذلت جان من","بیست عباس‌اند در انبان من","پس از این، ذلت و خواری برای جان من مانند بیست عباس، در کیسه من وجود دارد. (عباس به معنای نامی محترم و بزرگ است و در اینجا می‌توان به عنوان نماد گنج و ثروت در نظر گرفت.)"],[767,"شیخ بر می‌گشت زنبیلی به دست","شیء لله خواجه توفیقیت هست","شیخ با خوشحالی و احترام به سوی شهر غزنین برمی‌گشت و زنبیلی به دست داشت که به معنای \"کار خدا\" است و نشان از موفقیت و توفیق او دارد."],[767,"برتر از کرسی و عرش اسرار او","شیء لله شیء لله کار او","اسرار و علم خداوند از هر چیز بالاتر است و کار او بالاتر از کرسی و عرش است."],[767,"انبیا هر یک همین فن می‌زنند","خلق مفلس کدیه ایشان می‌کنند","پیامبران هر کدام به همین شیوه عمل می‌کنند و خلق ناتوان و بی‌چیز را به عشق و علم خود جلب می‌کنند."],[767,"اقرضوا الله اقرضوا الله می‌زنند","بازگون بر انصروا الله می‌تنند","می‌گویند که انسان‌ها به خداوند قرض بدهند و این کار را با اصرار و تکرار انجام می‌دهند، همانطور که در دعوت به یاری خدا نیز با شدت و تکرار عمل می‌کنند."],[767,"در به در این شیخ می‌آرد نیاز","بر فلک صد در برای شیخ باز","این شیخ در همه جا به دنبال برآورده شدن نیازهایش است و با صد در به سوی آسمان درخواست می‌کند، گویی که درهای آسمان برای او باز شده‌اند."],[767,"که آن گدایی که آن به جد می‌کرد او","بهر یزدان بود نه از بهر گلو","گدایان واقعی که با جدیت دعا و نیاز خود را پیش یزدان می‌برند، این کار را به خاطر شکم و نیازهای جسمی نمی‌کنند، بلکه برای رسیدن به نزدیک خدا و نعمت‌های روحانی است."],[767,"ور بکردی نیز از بهر گلو","آن گلو از نور حق دارد غلو","اگر تو هم برای خودت کاری می‌کردی که به خاطر شکم باشد، بدان که آن شکم از نور حق، بلندی و برتری دارد."],[767,"در حق او خورد نان و شهد و شیر","به ز چله وز سه روزه صد فقیر","او برای نیازمندان نان و عسل و شیر می‌خورد که ارزشش بیشتر از ارزش غذایی است که صد فقیر در سی روز یا سه روز می‌خورند."],[767,"نور می‌نوشد مگو نان می‌خورد","لاله می‌کارد به صورت می‌چرد","نور هیچ‌گاه به شما نمی‌گوید که نان می‌خورد؛ گل لاله به خاطر زیبایی‌اش فقط بر روی زمین رشد می‌کند و زیبایی‌اش را به نمایش می‌گذارد. این ابیات به معنای این است که برخی موجودات و زیبایی‌ها به طور غیرمستقیم به زندگی و دیگران شادی و نور می‌بخشند، بدون اینکه کار ویژه‌ای انجام دهند."],[767,"چون شراری کو خورد روغن ز شمع","نور افزاید ز خوردش بهر جمع","وقتی شعله‌ای که از شمع بیرون می‌آید، روغن را می‌خورد، باعث افزایش نور می‌شود. این به این معناست که اگر کسی از وجود چیزی بهره‌مند شود، بر جمع و کثرت خیر می‌افزاید."],[767,"نان‌خوری را گفت حق لاتسرفوا","نور خوردن را نگفتست اکتفوا","خداوند به کسانی که از نعمت‌ها بهره‌مند می‌شوند می‌گوید که در مصرف آن زیاده‌روی نکنید، ولی در مورد کسانی که از نور و نورانیت برخوردارند، هیچ محدودیتی وجود ندارد و می‌توانند به اندازه همت خود بهره‌مند شوند."],[767,"آن گلوی ابتلا بد وین گلو","فارغ از اسراف و آمن از غلو","آدم‌هایی که در مشکلات و بحران‌ها قرار دارند، به نوعی در تنگنا به سر می‌برند، در حالی که کسانی که از زیاده‌روی و افراط دور هستند و در آرامش زندگی می‌کنند، از این مشکلات به دورند و در احوال بهتری به سر می‌برند."],[767,"امر و فرمان بود نه حرص و طمع","آن چنان جان حرص را نبود تبع","فرمان و دستور الهی وجود دارد و حرص و طمع در آن نقشی ندارد؛ به گونه‌ای که جان انسان هیچ‌گاه تابع حرص و طمع نیست."],[767,"گر بگوید کیمیا مس را بده","تو به من خود را طمع نبود فره","اگر بگوید که ماده‌ی کیمیا (سحر) را به من بده، تو هیچ طمعی به این مس (فلز بی‌ارزش) نداشته باش."],[767,"گنجهای خاک تا هفتم طبق","عرضه کرده بود پیش شیخ حق","گنج‌های نهفته در زمین را تا عمق هفتمین لایه در برابر شیخ حق (که احتمالا اشاره به یک مقام معنوی است) نمایان کرده بود."],[767,"شیخ گفتا خالقا من عاشقم","گر بجویم غیر تو من فاسقم","شیخ می‌گوید: ای خالق، من عاشق تو هستم و اگر غیر تو را جستجو کنم، به گمراهی و فساد دچار می‌شوم."],[767,"هشت جنت گر در آرم در نظر","ور کنم خدمت من از خوف سقر","اگر هشت بهشت را در نظر بیاورم، اما نتوانم به خدمت تو برسم، به خاطر ترس از دوزخ (سقر) است."],[767,"مومنی باشم سلامت‌جوی من","زانک این هر دو بود حظ بدن","من شخصی مومن و سلامت‌جو هستم، زیرا هر دو (عشق به خدا و عشق به دنیا) برای بدن نفع دارد و بهره‌ای از آن می‌برم."],[767,"عاشقی کز عشق یزدان خورد قوت","صد بدن پیشش نیرزد تره‌توت","عاشقی که از عشق خداوند نیرو می‌گیرد، حتی اگر به اندازه قوت هزار بدن باشد، در برابر او چیزی چون تره‌توت، یعنی بی‌ارزش به نظر می‌آید."],[767,"وین بدن که دارد آن شیخ فطن","چیز دگر گشت کم خوانش بدن","بدن آن شیخ فطن (زیرکی) دیگرگون شده است، پس کم‌تر آن را بدن نامید، زیرا او به مرتبه‌ای از روحانیّت و عشق رسیده که جسمش دیگر اهمیت ندارد."],[767,"عاشق عشق خدا وانگاه مزد","جبرئیل مؤتمن وانگاه دزد","عاشق خدا و عشق او، مزد (پاداش) جبرئیل (فرشته‌ای که پیام‌های خدا را به انسان می‌آورد) را دریافت می‌کند، در حالی که دزد (کسی که از چیزی می‌دزدد) نیز به این عشق و پاداش دست پیدا می‌کند. این نشان می‌دهد که عشق به خداوند، حتی به کسانی که به طرق مختلف زندگی می‌کنند، روح بخشیده و پاداش می‌دهد."],[767,"عاشق آن لیلی کور و کبود","ملک عالم پیش او یک تره بود","عاشق لیلی، که در اینجا نماد عشق و معشوق است، در نظر او که فرشته‌ای از عالم وجود است، مانند یک تره (سبزی سطحی و بی‌ارزش) به نظر می‌رسد. این به معنای این است که در مقایسه با عشق واقعی، حتی بزرگ‌ترین عشق‌ها ارزش کمی دارند."],[767,"پیش او یکسان شده بد خاک و زر","زر چه باشد که نبد جان را خطر","در نزد او، خاک و طلا هیچ تفاوتی ندارند؛ چه اهمیتی دارد که طلا چه ارزشی دارد، وقتی جان انسان در خطر است؟"],[767,"شیر و گرگ و دد ازو واقف شده","هم‌چو خویشان گرد او گرد آمده","شیر و گرگ و سایر حیوانات از او آگاه شده و مانند خویشاوندان دور او جمع شده‌اند."],[767,"کین شدست از خوی حیوان پاک پاک","پر ز عشق و لحم و شحمش زهرناک","این بیت به تمایز بین انسان و حیوان اشاره دارد و بیان می‌کند که انسان به واسطه داشتن روح و خوی حیوانی، از لطافت و عشق سرشار است. در عین حال، صفات زشت و منفی مانند زیاده‌خواهی و حیات مادی او را دچار زهر و آسیب می‌کند."],[767,"زهر دد باشد شکرریز خرد","زانک نیک نیک باشد ضد بد","زهر، یعنی ماده سمی در اینجا به معنای چیز بد و مضر است، در حالی که شکرریز به معنای دوستی و خوبی است. خرد (عقل) از این دو پدیده، چیزهایی را می‌سازد که نیکو و مبارک هستند و برعکس، هرگونه بدی را به عنوان ضد نیکی می‌شناسد. در واقع، عقل به ما نشان می‌دهد که چگونه از زهر (بدی) به شکر (خوبی) برسیم."],[767,"لحم عاشق را نیارد خورد دد","عشق معروفست پیش نیک و بد","عشق نمی‌تواند به خوراک دد (حیوانات وحشی) تبدیل شود، زیرا عشق معروف و شناخته‌شده‌ای است که در نظر خوبان و بدخواهان به یکسان مورد توجه قرار می‌گیرد."],[767,"ور خورد خود فی‌المثل دام و ددش","گوشت عاشق زهر گردد بکشدش","اگر گوشت عاشق در دست حیوان قاتل یا دد بیفتد، زهرآگین می‌شود و او را می‌کشد، یعنی عشق اگر در معرض خطرات و سختی‌ها قرار گیرد، می‌تواند آسیب ببیند و به مشکلات دچار شود."],[767,"هر چه جز عشقست شد ماکول عشق","دو جهان یک دانه پیش نول عشق","هر چیزی که غیر از عشق باشد، مانند خوراکی است که در نهایت به هدر می‌رود. عشق، تنها چیزی است که ارزش دارد و در دو جهان، مانند دانه‌ای در برابر تمام آنچه وجود دارد، درخشان و ارزشمند است."],[767,"دانه‌ای مر مرغ را هرگز خورد","کاهدان مر اسپ را هرگز چرد","مرغ هیچگاه دانه‌ای نمی‌خورد که در کاهدان (مکانی برای نگهداری کاه) باشد و اسب نیز در آنجا چرا نمی‌کند. این بیان به این معناست که جان و روح انسان‌ها به عشق و معانی والاتر نیاز دارند و در مکان‌های بی‌فایده و خالی از محتوا، نمی‌توانند رشد کنند."],[767,"بندگی کن تا شوی عاشق لعل","بندگی کسبیست آید در عمل","اگر بخواهی عاشق زیبایی و ارزش‌های عالی شوی، باید به بندگی و خدمت کردن روی آورده و در عمل و رفتار خود چنین کمالی را به دست آوری. بندگی و خدمت به دیگران راهیست برای رسیدن به عشق حقیقی."],[767,"بنده آزادی طمع دارد ز جد","عاشق آزادی نخواهد تا ابد","بنده‌ای که در حالت طمع و خواسته‌های دنیوی است، به آزادی و رهایی فکر می‌کند، اما عاشقی که واقعا به عشق رسیده، هرگز به آزادی راضی نخواهد شد و این حالت را تا همیشه حفظ می‌کند."],[767,"بنده دایم خلعت و ادرارجوست","خلعت عاشق همه دیدار دوست","بنده همیشه در جستجوی لباس و نشان (خلعت) است، اما لباس واقعی عاشق، همان دیدار معشوق (دوست) است."],[767,"در نگنجد عشق در گفت و شنید","عشق دریاییست قعرش ناپدید","عشق در کلام و گفتگو نمی‌گنجد و واقعیات آن را نمی‌توان به زبان آورد. عشق همچون دریا است که عمق آن پنهان و ناپیداست و قابل اندازه‌گیری نیست."],[767,"قطره‌های بحر را نتوان شمرد","هفت دریا پیش آن بحرست خرد","عشق و معانی آن به حدی گسترده و عمیق است که مانند قطره‌هایی از دریا نمی‌توان آن‌ها را شمرد. همچنین این دریا نسبت به دریاهای دیگر مانند هفت دریا بسیار موثرتر و بزرگتر است."],[767,"این سخن پایان ندارد ای فلان","باز رو در قصه شیخ زمان","این کلام ادامه دارد و تمام نمی‌شود، ای فلانی، دوباره به داستان شیخ زمان بپرداز."],[768,"شد چنین شیخی گدای کو به کو","عشق آمد لاابالی اتقوا","این بیت می‌گوید که این شیخ (که به نظر نمی‌رسد اهمیت زیادی به مال و دنیا بدهد) مانند یک گدا در هر کجا به دنبال عشق است و به عاقبت کارش توجهی ندارد."],[768,"عشق جوشد بحر را مانند دیگ","عشق ساید کوه را مانند ریگ","عشق مانند آبی جوشان است که دریا را به جوش می‌آورد و می‌تواند کوه‌ها را به اندازه دانه‌های ریگ کوچک کند."],[768,"عشق‌بشکافد فلک را صد شکاف","عشق لرزاند زمین را از گزاف","عشق، آسمان را به اندازه صد شکاف می‌شکافد و زمین را نیز بی‌دلیل و از سر بی‌اساس می‌لرزاند."],[768,"با محمد بود عشق پاک جفت","بهر عشق او را خدا لولاک گفت","عشق پاک به محمد، پیامبر اسلام، همراه بود و به خاطر عشق او، خداوند به آدمی چنین گفت که تو را برای عشق محمد خلق کرده‌ام."],[768,"منتهی در عشق چون او بود فرد","پس مر او را ز انبیا تخصیص کرد","عشق واقعی وقتی به کمال می‌رسد که مانند عشق محمد باشد، و به همین خاطر او را از میان پیامبران خاص و ممتاز گردانیده است."],[768,"گر نبودی بهر عشق پاک را","کی وجودی دادمی افلاک را","اگر عشق پاک وجود نداشت، آیا برای وجود داشتن این آسمان‌ها و عالم‌ها، دلیلی داشتم؟"],[768,"من بدان افراشتم چرخ سنی","تا علو عشق را فهمی کنی","من منبعی از آسمان را ایجاد کردم تا تو بتوانی مرتبه بلند عشق را درک کنی."],[768,"منفعتهای دگر آید ز چرخ","آن چو بیضه تابع آید این چو فرخ","منفعت‌های دیگر از گردش چرخ (جهان) به وجود می‌آید، مانند تخم مرغ که چیزی به دنبال آن می‌آید و این وضعیت مبارک و نیکو است."],[768,"خاک را من خوار کردم یک سری","تا ز خواری عاشقان بویی بری","من، خاک را خوار و ذلیل کرده‌ام تا عاشقانی که در رنج و خواری هستند، از این خوارگی، عطر و بویی ببرند."],[768,"خاک را دادیم سبزی و نوی","تا ز تبدیل فقیر آگه شوی","ما به خاک زندگی و تازگی بخشیدیم تا تو درک کنی که تغییر و دگرگونی از فقر و نیازمندی ناشی می‌شود."],[768,"با تو گویند این جبال راسیات","وصف حال عاشقان اندر ثبات","این جبال (کوه‌ها) به تو می‌گویند که حال عاشقانی که در عشق ثابت‌قدم هستند، چگونه است."],[768,"گرچه آن معنیست و این نقش ای پسر","تا به فهم تو کند نزدیک‌تر","هرچند که آن حقیقت و معنا وجود دارد، اما این تصویر و شکل تنها برای تو، ای پسر، نزدیک‌تر و قابل فهم‌تر است."],[768,"غصه را با خار تشبیهی کنند","آن نباشد لیک تنبیهی کنند","غصه را به خار تشبیه می‌کنند، اما واقعا این‌گونه نیست؛ هدف این تشبیه آگاه کردن و هشدار دادن است."],[768,"آن دل قاسی که سنگش خواندند","نامناسب بد مثالی راندند","دل سنگی و سخت را نامناسب می‌دانند و برای آن مثالی نامناسب آورده‌اند."],[768,"در تصور در نیاید عین آن","عیب بر تصویر نه نفیش مدان","این بیت به این معنی است که عیب واقعی یا نقص موجود در چیزی را نمی‌توان به‌طور کامل در تصویر یا تصور آن بازنمایی کرد، پس تنها به خاطر وجود تصویر باید آن عیب را انکار نکرد."],[769,"شیخ روزی چار کرت چون فقیر","بهر کدیه رفت در قصر امیر","شیخ به‌عنوان یک فقیر، روزی چهار بار به خانه امیر می‌رفت تا نان بگیرد."],[769,"در کفش زنبیل و شی لله زنان","خالق جان می‌بجوید تای نان","شیخ در زنبیل (کیسه) خود فقط نان نمی‌گذارد بلکه جان و حقیقتی را می‌جوید که از خالق به دست می‌آید. او به‌دنبال چیزی فراتر از نان است و در پی رسیدن به معنای زندگی و روح است."],[769,"نعلهای بازگونه‌ست ای پسر","عقل کلی را کند هم خیره‌سر","نعل‌های باز مانند و ساده هستند، ای پسر، عقل جامع و کامل نیز ممکن است گاهی دچار اشتباه شود و گرفتار نادانی گردد."],[769,"چون امیرش دید گفتش ای وقیح","گویمت چیزی منه نامم شحیح","هنگامی که امیر او را دید، به او گفت: ای بی‌شرم، به تو می‌گویم چیزی به من نرسان. نامم را هم بدون اجازه نبر."],[769,"این چه سغری و چه رویست و چه کار","که به روزی اندر آیی چار بار","امیر از شیخی که چهار بار در روز به خانه او می‌آید تعجب می‌کند و درباره کوچکی و عجیب بودن این رفتار او سوال می‌کند که این چه نیامدنی است و چه کار و چه رویی برایش وجود دارد."],[769,"کیست اینجا شیخ اندر بند تو","من ندیدم نر گدا مانند تو","این شخص که در اینجا به عنوان شیخ به تو وابسته است، کیست؟ من کسی را مانند تو که گدا باشد، نه دیده‌ام و نه شناخته‌ام."],[769,"حرمت و آب گدایان برده‌ای","این چه عباسی زشت آورده‌ای","تو به خاطر رفتار زشت و بی‌ادبانه‌ات، حرمت و آبروی گدایان را از بین برده‌ای. این چه نوع بی‌احترامی است که به عباس (که نماد شخصیت بزرگی است) نسبت داده‌ای؟"],[769,"غاشیه بر دوش تو عباس دبس","هیچ ملحد را مباد این نفس نحس","عباس دبس، کسی است که بار سنگین گناه بر دوش اوست، و نباید به هیچ ملحدی (کافر) اجازه داد که چنین چیزی را تجربه کند. زندگی چنین کسانی با افکار ناپاک و منحرف، باطل و ناخوشایند است."],[769,"گفت امیرا بنده فرمانم خموش","ز آتشم آگه نه‌ای چندین مجوش","شیخ به امیر می‌گوید که من بنده فرمان تو هستم و باید ساکت بمانم. اما اگر تو از آتش من خبر نداری، بیهوده نغز مکن و مرا به این درد عذاب نده."],[769,"بهر نان در خویش حرصی دیدمی","اشکم نان‌خواه را بدریدمی","به خاطر گرفتن نان، خود را در وضعیتی سخت و پرحرص دیدم و از روی اندوه و نیاز، اشک‌های کسی را که طالب نان است، ریختم."],[769,"هفت سال از سوز عشق جسم‌پز","در بیابان خورده‌ام من برگ رز","هفت سال است که به علت سوز عشق، زندگی‌ام را در بیابان سختی می‌گذرانم و در این مدت به اندازه‌ی یک برگ گل سرخ، لطیف و آسیب‌پذیر شده‌ام."],[769,"تا ز برگ خشک و تازه خوردنم","سبز گشته بود این رنگ تنم","بدن من به واسطه خوردن برگ‌های خشک و تازه، رنگی سبز و جوان پیدا کرده بود."],[769,"تا تو باشی در حجاب بوالبشر","سرسری در عاشقان کمتر نگر","تا زمانی که تو در حجاب و پوشش انسانی (بوالبشر) قرار داری، به طور سطحی به عاشقان (محبان) کمتر توجه کن و به عمق احساسات و حالات آن‌ها نپرداز."],[769,"زیرکان که مویها بشکافتند","علم هیات را به جان دریافتند","زیرکان (عالم‌هانی) که به عمق مسائل می‌پردازند و رازها را می‌شکافند، علم هیأت (علم نجوم و اجرام آسمانی) را به‌خوبی درک کردند و به عمق آن پی بردند."],[769,"علم نارنجات و سحر و فلسفه","گرچه نشناسند حق المعرفه","علمی مانند علم نارنجات (علم جادو و سحر) و فلسفه، اگرچه بعضی از مردم به آن‌ها آگاهی نداشته باشند، باز هم در حقیقت و ذات خود به عنوان معرفت شناخته می‌شوند."],[769,"لیک کوشیدند تا امکان خود","بر گذشتند از همه اقران خود","اما آن‌ها (جمعی از کسانی که در این زمینه بودند) تلاش کردند تا از هر راهی که ممکن است، خود را از تمامی رقبای خود متمایز کنند و بالاتر ببرند."],[769,"عشق غیرت کرد و زیشان در کشید","شد چنین خورشید زیشان ناپدید","عشق با غیرتی که دارد، از آنها دور شد و موجب ناپدید شدن خورشیدی شد که از آنان می‌درخشید."],[769,"نور چشمی کو به روز استاره دید","آفتابی چون ازو رو در کشید","نور چشمی که در روز مانند ستاره می‌درخشد، هنگامی که آفتاب از او دور می‌شود، همچون ستاره‌ای به نظر می‌رسد."],[769,"زین گذر کن پند من بپذیر هین","عاشقان را تو به چشم عشق بین","از این موضوع عبور کن و نصیحت من را بپذیر، تو نیز عاشقان را با چشم عشق ببین."],[769,"وقت نازک باشد و جان در رصد","با تو نتوان گفت آن دم عذر خود","زمانی که موقعیت حساس و ظریفی پیش می‌آید و جان انسان در خطر است، در آن لحظه نمی‌توان عذر و بهانه‌ای مطرح کرد."],[769,"فهم کن موقوف آن گفتن مباش","سینه‌های عاشقان را کم خراش","برای درک اوضاع عاشقانه و احساسات عمیق، نباید هرگز به حرف زدن و افشای بی‌جا بپردازی، زیرا ممکن است دل عاشقان را آزرده کند."],[769,"نه گمانی برده‌ای تو زین نشاط","حزم را مگذار می‌کن احتیاط","تو به این شادمانی، هیچ گمانی نبر، احتیاط را فراموش نکن و از ملاحظه‌کاری غافل مشو."],[769,"واجبست و جایزست و مستحیل","این وسط را گیر در حزم ای دخیل","این موضوع ضروری و هم‌زمان ممکن و غیرممکن است. باید در این میان، احتیاط و دوراندیشی را در نظر بگیری، ای کسی که به این کار دخالت کرده‌ای."],[770,"این بگفت و گریه در شد های های","اشک غلطان بر رخ او جای جای","امیر این را گفت و به شدت گریه کرد، اشک‌هایش بر صورتش سرازیر شد و همه جا را پر کرد."],[770,"صدق او هم بر ضمیر میر زد","عشق هر دم طرفه دیگی می‌پزد","صداقت او (امیر) بر دل او (شیخ) اثر می‌گذارد و عشقش هر لحظه به طرزی تازه او را به شکلی در می‌آورد که همچون دیگی در حال جوشیدن است."],[770,"صدق عاشق بر جمادی می‌تند","چه عجب گر بر دل دانا زند","عاشق واقعی اینقدر صادق و راستگو است که حتی سنگ و مواد بی‌جان هم با او در ارتباط قرار می‌گیرند و تحت تأثیر این صدق قرار می‌گیرند. بنابراین، جای شگفتی ندارد اگر صدق او بر دل یک انسان آگاه و دانا تأثیر بگذارد."],[770,"صدق موسی بر عصا و کوه زد","بلک بر دریای پر اشکوه زد","موسى در زمان خود با صداقت و حقیقتی که داشت، بر عصا و کوه تاثیر گذاشت، اما در واقع بر دریای پر از عظمت و ژرفای اشکوه هم تاثیرگذار بود."],[770,"صدق احمد بر جمال ماه زد","بلک بر خورشید رخشان راه زد","احمد، که اشاره به پیامبر اسلام (ص) دارد، صداقت خود را به زیبایی ماه تشبیه کرده است، اما در حقیقت بر درخشش و تابش خورشید که نمایان‌گر عظمت اوست، تأکید می‌کند. این به معنای این است که زیبایی و نور پیامبر فراتر از جمال ماه است."],[770,"رو برو آورده هر دو در نفیر","گشته گریان هم امیر و هم فقیر","امیر و فقیر هر دو رودرروی یکدیگر ایستاده‌اند و از شدت ناراحتی و اندوه به گریه افتاده‌اند."],[770,"ساعتی بسیار چون بگریستند","گفت میر او را که خیز ای ارجمند","ساعاتی پس از گریه کردن، امیر به شیخ گفت: ای شخص محترم، بلند شو."],[770,"هر چه خواهی از خزانه برگزین","گرچه استحقاق داری صد چنین","هر چیزی که می‌خواهی از خزانه برگزین، هرچند که تو لیاقت صدها چیز بهتر از آن را داری."],[770,"خانه آن تست هر چت میل هست","بر گزین خود هر دو عالم اندکست","خانه تو (خزانه وجودت) مال خودت است؛ هرچه را می‌خواهی انتخاب کن، زیرا در این دو عالم، چیز کم است."],[770,"گفت دستوری ندادندم چنین","که به دست خويش چيزي برگزين","او می‌گوید که من دستوری از کسی نگرفتم که خودم چیزی انتخاب کنم و به دلخواه خود عمل کنم."],[770,"این بهانه کرد و مهره در ربود","مانع آن بد کان عطا صادق نبود","امیر بهانه‌ای آورد و شیخ را متهم کرد که به خاطر حقیقت و صداقتی که ندارد، مانع بخشش او بوده است."],[770,"نه که صادق بود و پاک از غل و خشم","شیخ را هر صدق می‌نامد به چشم","شیخ به خاطر صداقتش و بی‌غلط بودنش قابل ستایش نیست، بلکه هر صداقتی که به چشم او بیفتد، مورد تقدیر قرار می‌گیرد، حتی اگر آن صداقت واقعی نباشد."],[770,"گفت فرمانم چنین دادست اله","که گدایانه برو نانی بخواه","امیر می‌گوید که خدا به من فرمان داده که به شکل گدا، برای به‌دست آوردن نان، درخواست کنم."],[771,"تا دو سال این کار کرد آن مرد کار","بعد از آن امر آمدش از کردگار","آن مرد به مدت دو سال این کار را انجام داد، و سپس فرمانی از سوی خداوند به او رسید."],[771,"بعد ازین می‌ده ولی از کس مخواه","ما بدادیمت ز غیب این دستگاه","بعد از این شیخ به تو می‌دهد، ولی از هیچ‌کس نمی‌توانی درخواست کنی، چرا که ما از غیب این نعمت را به تو عطا کردیم."],[771,"هر که خواهد از تو از یک تا هزار","دست در زیر حصیری کن بر آر","هر کسی که می‌خواهد از تو چیزی بخواهد، چه یک چیز و چه هزار چیز، باید با اخلاص و توجه دست خود را زیر حصیری (مانند پرده‌ای) قرار دهد و آن را بالا آورد."],[771,"هین ز گنج رحمت بی‌مر بده","در کف تو خاک گردد زر بده","اینجا به این نکته اشاره می‌شود که از گنجینه رحمت الهی بی‌محدود به انسان عطا کن، به‌طوری که آنچه در دست تو است، از خاک بی‌ارزش به طلا و زر تبدیل شود."],[771,"هر چه خواهندت بده مندیش از آن","داد یزدان را تو بیش از بیش دان","هر چیزی که بخواهی به تو می‌دهند، نگران نباش. خداوند چیزی را که به تو می‌دهد، از آنچه که می‌خواسته، بیشتر است."],[771,"دست زیر بوریا کن ای سند","از برای روی‌پوش چشم بد","دستت را زیر حصیر بگذار، ای سند (گواهی) که برای حفاظت از چشم بد استفاده می‌شود. این به معنای پنهان کردن خود از نظرهای ناپسند و بدگویی‌هاست."],[771,"پس ز زیر بوریا پر کن تو مشت","ده به دست سایل بشکسته پشت","پس از آنکه زیر حصیر (بوریا) را پر کردی، مشت (دست) خود را به سوی سائل (فقرایی که از تو درخواست دارند) کن که پشت او شکسته است؛ یعنی به کسانی که در درد و رنج هستند، کمک کن."],[771,"بعد ازین از اجر ناممنون بده","هر که خواهد گوهر مکنون بده","پس از این، هر کس که خواهان چیزی است، از نعمت‌های بی‌پایان و پنهان ما بهره‌مندش کن و از ما چیزی نخواه که شکر و مزد را فراموش کند."],[771,"رو ید الله فوق ایدیهم تو باش","هم‌چو دست حق گزافی رزق پاش","خداوندی که بالای دست‌های آنان است، تو باش مانند دست خداوند که به وفور روزی می‌پاشد."],[771,"وام داران را ز عهده وا رهان","هم‌چو باران سبز کن فرش جهان","باید بدهی به وام‌داران و آن‌ها را از بار بدهی آزاد کنی، مثل باران که زمین را سرسبز و آباد می‌کند."],[771,"بود یک سال دگر کارش همین","که بدادی زر ز کیسه رب دین","یک سال دیگر هم کار او همین بود که از کیسه پروردگار دین، طلا و زر را به مردم بخشید."],[771,"زر شدی خاک سیه اندر کفش","حاتم طایی گدایی در صفش","حاتم طایی که فردی بخشنده و فاضل است، به خاک سیاه و سپس به طلا مبدل شده است و در حال حاضر به جای این که مانند او زندگی کند، باید در صف گدایان قرار بگیرد. این تصویر به تظاهر و روحیه انسان‌ها و ارزش‌های اجتماعی اشاره دارد که چگونه می‌توانند تغییر کنند."],[772,"حاجت خود گر نگفتی آن فقیر","او بدادی و بدانستی ضمیر","اگر تو حاجت خود را به فقیر نگویی، او به خاطر درک درونت، نیاز تو را می‌فهمد و به تو کمک می‌کند."],[772,"آنچ در دل داشتی آن پشت‌خم","قدر آن دادی بدو نه بیش و کم","هر چیزی که در دلت بود و به آن فکر می‌کردی، به همان میزان به او (فقیر) کمک کردی، نه بیشتر و نه کمتر."],[772,"پس بگفتندی چه دانستی که او","این قدر اندیشه دارد ای عمو","پس پرسیدند که چگونه می‌توان فهمید او چه اندازه فکر و اندیشه دارد، ای عمو؟"],[772,"او بگفتی خانه دل خلوتست","خالی از کدیه مثال جنتست","او گفت که خانه دل، مکانی خلوت و آرام است و در آن چیزی وجود ندارد، به طوری که مانند بهشت خالی و بی‌زحمت به نظر می‌آید."],[772,"اندرو جز عشق یزدان کار نیست","جز خیال وصل او دیار نیست","در دل انسان، جز عشق به خداوند هیچ کاری نیست و در آن‌جا جز خیال وصال با او، هیچ سرزمین و محلی وجود ندارد."],[772,"خانه را من روفتم از نیک و بد","خانه‌ام پرّست از عشق احد","خانه‌ام را از هر نیکی و بدی پاک کرده‌ام؛ زیرا دل من تنها از عشق یکتای خدا پر شده است."],[772,"هرچه بینم اندرو غیر خدا","آن من نبود بود عکس گدا","هر چیزی که در خانه‌ام می‌بینم جز خدا نیست و اگر هم چیزی داشته باشم، در واقع فقط منعکس‌کننده شخصیت و حال من است."],[772,"گر در آبی نخل یا عرجون نمود","جز ز عکس نخله بیرون نبود","اگر در آبی تصویر نخل یا درخت عرجون را ببینی، در حقیقت فقط انعکاسی از آن نخل بیرونی خواهد بود و خود نخل درون آب وجود ندارد."],[772,"در تگ آب ار ببینی صورتی","عکس بیرون باشد آن نقش ای فتی","اگر در آب نگاه کنی و تصویری ببینی، در واقع تنها عکس آن شکل بر آب افتاده است، و آنچه می‌بینی واقعیت ندارد. ای جوان! به این نکته توجه کن که هر تصویر یا نقشی که در آب می‌بینی، تنها انعکاسی از آن چیز است."],[772,"لیک تا آب از قذی خالی شدن","تنقیه شرطست در جوی بدن","برای اینکه آب از آلودگی و کثیفی پاک شود، باید شرایط خاصی در جریان بدن وجود داشته باشد."],[772,"تا نماند تیرگی و خس درو","تا امین گردد نماید عکس رو","چون تیرگی و زنگار از دل برطرف شود، دل به صفا می‌رسد و شفاف می‌شود؛ بنابراین، دل باید پاک و خالی از کثافت باشد تا حقیقت و زیبایی در آن نمایان گردد."],[772,"جز گلابه در تنت کو ای مقل","آب صافی کن ز گل ای خصم دل","ای مقل (نقش دیوانه)، جز گلابی (عطر و خوشبویی) در وجودت نیست، با این حال، دل را از آلودگی و بدی‌ها پاک کن و آن را به مانند آب زلال و صاف بساز."],[772,"تو بر آنی هر دمی کز خواب و خور","خاک ریزی اندرین جو بیشتر","تو هر لحظه خواب و خوراک را به خاک می‌ریزی و باعث می‌شوی که این جو (دل) پر از ناخالصی و کثافت شود."],[773,"چون دل آن آب زینها خالیست","عکس روها از برون در آب جست","وقتی دل انسان از این تجربیات و جاذبه‌های دنیوی خالی است، تصاویر چهره‌ها را در آینه دل نمی‌تواند جستجو کند. این یعنی او به چیزهای ظاهری و دنیوی توجهی ندارد."],[773,"پس ترا باطن مصفا ناشده","خانه پر از دیو و نسناس و دده","اگر باطن تو پاک و روشن نشده باشد، مانند خانه‌ای پر از موجودات زشت و ناپسند (دیو و نسناس و دده) می‌باشد."],[773,"ای خری ز استیزه مانده در خری","کی ز ارواح مسیحی بو بری","ای کسی که مانند الاغ در بنبست مانده‌ای، چه زمانی از روح مسیحی رهایی خواهی یافت؟"],[773,"کی شناسی گر خیالی سر کند","کز کدامین مکمنی سر بر کند","تو چگونه می‌دانی که اگر خیالی ظهور کند، از کدام مکان یا محل به وجود آمده است؟"],[773,"چون خیالی می‌شود در زهد تن","تا خیالات از درونه روفتن","زمانی که انسان در زهد (رهبانیت و رهایی از دنیا) به خیال و اندیشه‌ای می‌پردازد، آن خیال به درون او رخنه کرده و باعث می‌شود که خیالات و افکار او به تدریج از وجودش خارج شود."],[774,"خر بسی کوشید و او را دفع گفت","لیک جوع الکلب با خر بود جفت","خر تلاش زیادی کرد و سعی داشت خود را از دست شرایط سخت رها کند، اما در نهایت گرسنگی و نیاز به غذا باعث شد تا در کنار مشکلاتش باقی بماند."],[774,"غالب آمد حرص و صبرش بد ضعیف","بس گلوها که برد عشق رغیف","حرص و طمع بر صبر او چیره شد و او ضعیف گشت، و به خاطر عشق، همه چیز را فدای نان و لقمه‌ای کرد."],[774,"زان رسولی کش حقایق داد دست","کاد فقر ان یکن کفر آمدست","از آن پیامبری که حقایق را به مردم داده است، معلوم می‌شود که کاد (حد) فقر به این معناست که اگر فقر باشد، مانند کفر خواهد بود."],[774,"گشته بود آن خر مجاعت را اسیر","گفت اگر مکرست یک ره مرده گیر","آن خر در گرفتاری و گرسنگی خود به اسیری افتاده بود و می‌گفت اگر این مکر و فریب است، پس یک بار دیگر هم مرده بگیر."],[774,"زین عذاب جوع باری وا رهم","گر حیات اینست من مرده بهم","از این عذاب گرسنگی بر من رحم کنید، اگر حیات به این شکل است، من مرده‌ام."],[774,"گر خر اول توبه و سوگند خورد","عاقبت هم از خری خبطی بکرد","اگر خر هم برای بار اول قسم بخورد و توبه کند، در نهایت باز هم از خود اشتباهی نشان می‌دهد."],[774,"حرص کور و احمق و نادان کند","مرگ را بر احمقان آسان کند","حرص، انسان نادان و بی‌هوش را به طوری می‌فریبد که مرگ را برای او آسان جلوه دهد."],[774,"نیست آسان مرگ بر جان خران","که ندارند آب جان جاودان","مرگ بر افرادی که مانند خر (احمق و نادان) هستند، آسان نیست، زیرا این افراد فاقد روحی جاودانه‌اند و تنها حیات دنیوی دارند."],[774,"چون ندارد جان جاوید او شقیست","جرات او بر اجل از احمقیست","کسی که جان جاودانی ندارد، در واقع انسان شقی و نادانی است، زیرا جرات او در مواجهه با مرگ ناشی از احمق بودنش است."],[774,"جهد کن تا جان مخلد گرددت","تا به روز مرگ برگی باشدت","تلاش کن تا روح تو جاودان و پایدار شود، تا در روز مرگ، نیکی‌ها و کارهای خوبت به یادگار بمانند."],[774,"اعتمادش نیز بر رازق نبود","که بر افشاند برو از غیب جود","اعتمادش به خداوند روزی‌دهنده نبود، زیرا با بخشش‌های پنهانی و فراوانی که از عالم غیب نازل می‌شود، او را نمی‌شناخت."],[774,"تاکنونش فضل بی‌روزی نداشت","گرچه گه‌گه بر تنش جوعی گماشت","او تاکنون از نعمت و فضل برخوردار نبوده و هیچ گاه به روزی نرسیده، هرچند گاهی گرسنگی را تجربه کرده است."],[774,"گر نباشد جوع صد رنج دگر","از پی هیضه بر آرد از تو سر","اگر گرسنگی نباشد، صد رنج دیگر به دنبال آن از تو سر برمی‌آورد."],[774,"رنج جوع اولی بود خود زان علل","هم به لطف و هم به خفت هم عمل","رنج گرسنگی از سایر دردها بالاتر است، زیرا هم به لطف الهی منجر می‌شود و هم به خفت (تسلیم و تواضع) و هم به عمل و کوششی مفید."],[774,"رنج جوع از رنجها پاکیزه‌تر","خاصه در جوعست صد نفع و هنر","رنج گرسنگی از سایر رنج‌ها خالص‌تر و خالی از ناپاکی‌هاست، به‌ویژه اینکه در گرسنگی فواید و هنرهای زیادی وجود دارد."],[775,"جوع خود سلطان داروهاست هین","جوع در جان نه چنین خوارش مبین","بدان که گرسنگی شاه همه‌ی داروهاست گرسنگی را پذیرا باش و خوار نشمار و از آن دوری نکن"],[775,"جمله ناخوش از مجاعت خوش شدست","جمله خوشها بی‌مجاعتها ردست","چه‌بسیاری از غذاهای نامطبوع و غیرلذیذ که از گرسنگی خوش‌طعم و گوارا شده‌اند و چه بسیاری از غذاهای گوارا و لذیذ به هنگام سیری نامطبوع آمدند"],[776,"آن یکی می‌خورد نان فخفره","گفت سایل چون بدین استت شره","یک نفر نان خوشمزه‌ای می‌خورد و دیگری که سیر است، به او می‌گوید چون تو در حال خوشی هستی، این نان برایت لذت‌بخش‌تر شده است."],[776,"گفت جوع از صبر چون دوتا شود","نان جو در پیش من حلوا شود","گفت اگر گرسنگی و صبر با همدیگر ترکیب شوند، خوردن نان جو برای من شیرین و خوشمزه مثل حلوا خواهد شد."],[776,"پس توانم که همه حلوا خورم","چون کنم صبری صبورم لاجرم","اگر صبر کنم و تحمل داشته باشم، می‌توانم همه‌ی نعمت‌ها و خوشی‌ها را به دست آورم و به این ترتیب به آرامش و خوشبختی برسم."],[776,"خود نباشد جوع هر کس را زبون","کین علف‌زاریست ز اندازه برون","هر کس به اندازه خود از درد گرسنگی رنج می‌برد و این گرسنگی نتیجه ناتوانی اوست؛ چرا که در حقیقت، نعمت‌ها و امکانات برای همه افراد به میزان لازم وجود دارد."],[776,"جوع مر خاصان حق را داده‌اند","تا شوند از جوع شیر زورمند","گرسنگی خاصان خدا را به آن خاطر داده‌اند که از این گرسنگی قوی و نیرومند شوند."],[776,"جوع هر جلف گدا را کی دهند","چون علف کم نیست پیش او نهند","جوع ( گرسنگی) به افراد نادان و بی‌ارزش (گدا) داده نمی‌شود، زیرا برای آن‌ها چیزی ارزشمند و کم‌نظیر مانند علف هم وجود ندارد و به همین دلیل آن‌ها به گرسنگی دچار می‌شوند."],[776,"که بخور که هم بدین ارزانیی","تو نه‌ای مرغاب مرغ نانیی","تو هم باید غذا بخوری، زیرا تو هم به این ارزانی (سنگینی) نیازی نداری؛ تو فقط یک مرغابی هستی که به دنبال نان می‌گردی."],[777,"شیخ می‌شد با مریدی بی‌درنگ","سوی شهری نان بدانجا بود تنگ","شیخ به همراه مریدش بی‌درنگ به سوی شهری می‌رفت که در آنجا کمبود نان بود."],[777,"ترس جوع و قحط در فکر مرید","هر دمی می‌گشت از غفلت پدید","مرید به خاطر ترس از گرسنگی و کمبود غذا مدام در افکار خود غرق شده بود و هر لحظه در این افکار به غفلت دچار می‌شد."],[777,"شیخ آگه بود و واقف از ضمیر","گفت او را چند باشی در زحیر","شیخ از نیت و درون مرید باخبر بود و دانست که او تا چه زمان در رنج و عذاب خواهد بود."],[777,"از برای غصه نان سوختی","دیده صبر و توکل دوختی","به خاطر نگرانی از تأمین نان، چشمان خود را بسته‌ای به روی صبر و توکل، و به این ترتیب خود را در نگرانی‌ها غرق کرده‌ای."],[777,"تو نه‌ای زان نازنینان عزیز","که ترا دارند بی‌جوز و مویز","تو از آن عزیزان و محبوبان واقعی نیستی که آنها را بدون هیچ طمع و انتظاری دوست داشته باشند."],[777,"جوع رزق جان خاصان خداست","کی زبون هم‌چو تو گیج گداست","کسانی که از بندگی خداوند سیراب و راضی هستند، به طعم و لذت رزق روحانی می‌رسند، در حالی که تو که در فقر و نادانی به سر می‌بری، همچون یک گدا و بی‌چاره هستی."],[777,"باش فارغ تو از آنها نیستی","که درین مطبخ تو بی‌نان بیستی","به تو این نکته را می‌گوید که تو نباید نگران افرادی باشی که در این آشپزخانه، در وضعیتی بدون نان و نیازمند قرار دارند."],[777,"کاسه بر کاسه‌ست و نان بر نان مدام","از برای این شکم‌خواران عام","ظاهرا بر روی هم انباشته شدن کاسه‌ها و نان‌ها برای زحمت‌کشانی است که همیشه در پی سیر کردن شکم‌های خود هستند. این بیان به عدم رضایت از شرایط و وابستگی به نیازهای مادی اشاره دارد."],[777,"چون بمیرد می‌رود نان پیش پیش","کای ز بیم بی‌نوایی کشته خویش","وقتی که انسان می‌میرد، نان و خوراک او به دیگری می‌رسد، زیرا او از ترس فقر و بی‌پولی، خود را در تلاش و سختی انداخته است."],[777,"تو برفتی ماند نان برخیز گیر","ای بکشته خویش را اندر زحیر","تو رفتی و خطری برای او نیست، نان و روزی را بردار و به کار خود ادامه بده، زیرا کسی که به امید خودت کشته شده، باید در دریا (زندگی) شکوفا و سرزنده باشد."],[777,"هین توکل کن ملرزان پا و دست","رزق تو بر تو ز تو عاشق‌ترست","ببین، به خدایت توکل کن و نترس از کار و تلاش، زیرا روزی و رزق تو به دست خودت نیست و عشق حق به تو بیشتر از هر چیز دیگری علاقه‌مند است."],[777,"عاشقست و می‌زند او مول‌مول","که ز بی‌صبریت داند ای فضول","عاشق (خدا یا معشوق) از بی‌صبری تو آگاه است و به همین دلیل تو را مورد سرزنش قرار می‌دهد."],[777,"گر تو را صبری بدی رزق آمدی","خویشتن چون عاشقان بر تو زدی","اگر صبر داشته باشی، رزق و روزی تو نیز خواهد آمد، پس خود را مانند عاشقان به عشق و شوق بسپار."],[777,"این تب لرزه ز خوف جوع چیست","در توکل سیر می‌تانند زیست","این دلهره و اضطراب ناشی از ترس از گرسنگی چه معنایی دارد وقتی که در توکل به خدا زندگی به راحتی می‌گذرد؟"],[778,"یک جزیره سبز هست اندر جهان","اندرو گاویست تنها خوش‌دهان","در جهان جزیره‌ای سرسبز وجود دارد که در آن گاوی تنها و خوشخوراک زندگی می‌کند."],[778,"جمله صحرا را چرد او تا به شب","تا شود زفت و عظیم و منتجب","او (گاو) تمام روز را در صحرا می‌چرد تا شب که بتواند فربه و بزرگ شود و به نهایت قوت برسد."],[778,"شب ز اندیشه که «فردا چه خورم؟»","گردد او چون تار مو لاغر ز غم","او به خاطر نگرانی از اینکه فردا چه خواهد خورد، در شب به قدری ناراحت و غمگین می‌شود که مانند رشته‌ای نازک و لاغر می‌شود."],[778,"چون برآید صبح گردد سبز دشت","تا میان رسته قصیل سبز و کشت","وقتی صبح می‌رسد دشت سرسبز شده و به بلندی میان و کمر، گیاه و علف سبز (و تازه) رسته است."],[778,"اندر افتد گاو با جوع البقر","تا به شب آن را چرد او سر به سر","گاو در ابتدا بسیار گرسنه است و تا شب تلاش می‌کند تا تمام علف‌ها را بخورد."],[778,"باز زفت و فربه و لمتر شود","آن تنش از پیه و قوّت پر شود","گاو دوباره چاق و فربه می‌شود و بدنش از چربی و قوت پر می‌شود."],[778,"باز شب اندر تب افتد از فزع","تا شود لاغر ز خوف منتجع","شب‌ها دوباره از ترس به شدت نگران می‌شود و به خاطر این نگرانی لاغر می‌شود."],[778,"که چه خواهم خورد فردا وقت خور","سالها اینست کار آن بقر","این گاو سال‌هاست که نگران فردای خود است و همیشه به فکر این است که فردا چه خواهد خورد، در حالی که در حال حاضر از علف‌ها و نعمت‌های دور و برش بهره‌مند است."],[778,"هیچ نندیشد که چندین سال من","می‌خورم زین سبزه‌زار و زین چمن","او هرگز به این فکر نمی‌کند که سال‌هاست از این علفزار و چمن تغذیه می‌کند و هنوز در نگرانی و ترس از فردا به سر می‌برد."],[778,"هیچ روزی کم نیامد روزیم","چیست این ترس و غم و دلسوزیم؟","این گاو هیچ‌گاه در طول روز با کمبود غذا مواجه نشده است، پس نمی‌داند چرا این‌قدر نگران و پریشان است و این ترس و غم او از چیست."],[778,"باز چون شب می‌شود آن گاو زفت","می‌شود لاغر که «آوه رزق رفت!»","هر شب که می‌شود، آن گاو چاق، دوباره لاغر می‌شود و نگران می‌شود که «آه! روزی رفت!» و این ترس و نگرانی او را به لاغری می‌کشاند."],[778,"نفس آن گاوست و آن دشت این جهان","کاو همی لاغر شود از خوف نان","نفس آن گاو نمادی از انسان است و آن دشت اشاره به این جهان دارد. انسان از ترس و نگرانی برای تأمین نیازهای زندگی (نان) دچار لاغری و رنج می‌شود."],[778,"که چه خواهم خورد مستقبل عجب","لوت فردا از کجا سازم طلب","گاو نگران است که فردا چه چیزی خواهد خورد و از کجا باید آن را پیدا کند؛ او به شدت به فکر تأمین غذا برای آینده‌اش است."],[778,"سالها خوردی و کم نامد ز خور","ترک مستقبل کن و ماضی نگر","سال‌ها تو غذا خوردی و از این بابت چیزی کمتر نشد، حالا گذشته و آینده را رها کن و به حال و روز خود توجه کن."],[778,"لوت و پوت خورده را هم یاد آر","منگر اندر غابر و کم باش زار","به یاد داشته باش که باید به آنچه خورده‌ای و به دست آورده‌ای توجه کنی، نه اینکه فقط به گذشته نگاه کنی و غمگین باشی. از نگرانی و زاری در مورد گذشته بپرهیز."],[779,"برد خر را روبهک تا پیش شیر","پاره‌پاره کردش آن شیر دلیر","روباه خر را به نزد شیر برد و او را پاره‌پاره کرد؛ زیرا شیر که دلاور و قوی بود، در برابر حیله‌های روباه قرار گرفت و نتوانست از خود دفاع کند."],[779,"تشنه شد از کوشش آن سلطان دد","رفت سوی چشمه تا آبی خورد","آن شیر، که سلطان درندگان است، از تلاش و فعالیتی که داشت، تشنه شد و به سمت چشمه‌ای رفت تا آب بنوشد."],[779,"روبهک خورد آن جگربند و دلش","آن زمان چون فرصتی شد حاصلش","روباه در آن زمان که فرصتی برایش پیدا شد، دل و جگر شیر را خورد."],[779,"شیر چون وا گشت از چشمه به خور","جست در خر دل نه دل بد نه جگر","شیر وقتی از چشمه بیرون آمد و به خر خود رسید، متوجه شد که نه دل داشته و نه جگری."],[779,"گفت روبه را جگر کو دل چه شد","که نباشد جانور را زین دو بد","روباه به شیر می‌گوید: دل و جگر او کجاست و چرا نیست، که اگر این دو را داشت، هرگز به اینجا بر نمی‌گشت."],[779,"گفت گر بودی ورا دل یا جگر","کی بدینجا آمدی بار دگر","روباه به شیر می‌گوید اگر تو دل و جگر داشتی، چرا دوباره به اینجا آمده‌ای؟ اینجا به معنای اشاره به بی‌خود بودن شیر است که در این موقعیت قرار گرفته است."],[779,"آن قیامت دیده بود و رستخیز","وآن ز کوه افتادن و هول و گریز","شیر به بلاهای عظیمی که در روز قیامت و رستخیز می‌افتد، و همچنین به ترس و وحشت افتادن از کوه، اشاره دارد. او این موارد را دیده و تجربه کرده، اما اکنون بی‌دلی و بی‌جرأت به اینجا آمده است."],[779,"گر جگر بودی ورا یا دل بدی","بار دیگر کی بر تو آمدی؟","اگر آن شیر دارای دل و جگر بود، هرگز به این راحتی به چشمه نمی‌رفت که برگردد و دوباره در دام تو بیفتد."],[779,"چون نباشد نور دل دل نیست آن","چون نباشد روح جز گل نیست آن","اگر دل نور نداشته باشد، به واقع دل نیست و فقط گلی بی‌فایده است. همچنین، اگر روح وجود نداشته باشد، فقط توده‌ای از خاک باقی می‌ماند و هیچ ارزشی ندارد."],[779,"آن زجاجی کاو ندارد نور جان","بول و قاروره‌ست قندیلش مخوان","هر انسانی که روح و جان ندارد، مانند شیشه‌ای است که نور را در خود ندارد؛ او را نمی‌توان به عنوان چراغ یا قندیل شناخت و در حقیقت تنها یک ظرف خالی است."],[779,"نور مصباحست داد ذوالجلال","صنعت خلقست آن شیشه و سفال","نور چراغ از ناحیه‌ی خداوند است و این شیشه و سفال، آثار صنعت خلقت خداوند می‌باشد."],[779,"لاجرم در ظرف باشد اعتداد","در لهبها نبود الا اتحاد","بنابراین، در ظرف تنها یک حد و اندازه وجود دارد و در روشنایی شعله‌ها هیچ تنوعی نیست جز اتحاد آن‌ها."],[779,"نور شش قندیل چون آمیختند","نیست اندر نورشان اعداد و چند","نور شش قندیل به گونه‌ای با هم ترکیب شده که در میان آن‌ها هیچ عدد و چندی وجود ندارد، یعنی با هم یکی شده‌اند و دیگر نمی‌توان آن‌ها را به صورت جداگانه شمرد."],[779,"آن جهود از ظرفها مشرک شده‌ست","نور دید آن مؤمن و مدرک شده‌ست","آن یهودی به خاطر دیدن نور از ظرف‌ها با وجود شرک خود، به نوعی متوجه نور ایمان و درک آن مؤمن شده است."],[779,"چون نظر بر ظرف افتد روح را","پس دو بیند شیث را و نوح را","وقتی روح به ظرف نگاه کند، دو شخصیت مهم را می‌بیند: شیث و نوح. شیث، پسر آدم و نوح، پیامبر معروف است که نشان‌دهنده صفات نیک و الگوهای دین‌داری هستند."],[779,"جو که آبش هست جو خود آن بود","آدمی آنست کاو را جان بود","انسانی که روح و جان دارد و زنده است، مانند جوئی است که آب در آن وجود دارد؛ در واقع، وجود روح در انسان، نشانه زنده بودن اوست."],[779,"این نه مردانند اینها صورتند","مرده نانند و کشته شهوتند","این‌ها مردان واقعی نیستند، بلکه فقط ظاهری از انسان دارند. آن‌ها به‌نوعی مرده‌های زنده‌اند که تنها به دنبال نان و ارضای شهوت‌های خود هستند."],[780,"آن یکی با شمع برمی‌گشت روز","گرد بازاری دلش پر عشق و سوز","آن شخص در روز با یک شمع به بازار برمی‌گشت و دلش پر از عشق و ناراحتی بود."],[780,"بوالفضولی گفت او را کای فلان","هین چه می‌جویی به سوی هر دکان","بوالفضولی به او می‌گوید: ای فلانی، چه چیزی را در این بازار به سمت هر دکان می‌گردی و دنبال آن هستی؟"],[780,"هین چه می‌گردی تو جویان با چراغ","در میان روز روشن چیست لاغ","ای جوینده، چرا در روز روشن با چراغ در میان مردم می‌گردی؟ چه چیزی را جستجو می‌کنی که در این روشنی واضح نیست؟"],[780,"گفت می‌جویم به هر سو آدمی","که بود حی از حیات آن دمی","او می‌گوید که در هر طرف به دنبال آدمی می‌گردد که از حیات و زندگی یا از معنای واقعی زندگی برخوردار باشد."],[780,"هست مردی گفت این بازار پر","مردمانند آخر ای دانای حر","مردی گفت که این بازار پر از انسان‌هاست، ای دانای عاقل و هوشمند."],[780,"گفت خواهم مرد بر جاده دو ره","در ره خشم و به هنگام شره","گفت می‌خواهم مردی را که در دو مسیر حرکت کند: یکی در زمان خشم و دیگری در هنگام ولع و شهوات."],[780,"وقت خشم و وقت شهوت مرد کو","طالب مردی دوانم کو به کو","مردی که در زمان خشم و شهوت به دنبال نیکی و انسانیت است، کجاست؟ من به دنبال او در هر کوچه و بازار می گردم."],[780,"کو درین دو حال مردی در جهان؟","تا فدای او کنم امروز جان","من در این دو حالت، یعنی در زمان خشم و شهوت، در جهان کسی را نمی‌بینم که شایسته فدای جانم باشد."],[780,"گفت نادر چیز می‌جویی ولیک","غافل از حکم و قضایی، بین تو نیک","می‌گوید اگرچه در جستجوی چیز کمیابی هستی، اما از قوانین و سرنوشت غافل هستی و باید به خوبی درک کنی که چه می‌کنی."],[780,"ناظر فرعی ز اصلی بی‌خبر","فرع ماییم اصل احکام قدر","ما از حقیقت و واقعیت اصلی بی‌خبر و ناآگاه هستیم و تنها به جنبه‌های فرعی و جزئیات توجه داریم؛ در حالی که همه امور و قوانین بر اساس تقدیر و سرنوشت شکل می‌گیرند."],[780,"چرخ گردان را قضا گمره کند","صد عطارد را قضا ابله کند","سرنوشت (قضا) چرخ گردان را (یعنی نیروی عظیم یا تقدیر) گمراه و به بی‌راهه می‌کشاند و بر اثر سرنوشت، حتی سیاراتی چون عطارد که مثال عقل و هوش هستند، احمق می‌شوند و دچار سردرگمی می‌گردند."],[780,"تنگ گرداند جهان چاره را","آب گرداند حدید و خاره را","جهان چاره‌ساز را به تنگی می‌کشاند و در این تنگنای زندگی، آهن (حدید) و خار وجود آدمی را دچار فشار می‌کند و محدود می‌سازد."],[780,"ای قراری داده ره را گام گام","خام خامی خام خامی خام خام","ای کسی که به قرار و نظم هدایت می‌کنی، همواره در مسیر زندگی، بی‌خبر و خام، گام برمی‌داری."],[780,"چون بدیدی گردش سنگ‌آسیا","آب جو را هم ببین آخر بیا","وقتی که گردش سنگ آسیا (آسیاب) را دیدی، باید توجه کنی که آب جو (آب خالص و زلال) نیز باید در نهایت دیده شود."],[780,"خاک را دیدی برآمد در هوا","در میان خاک بنگر باد را","اگر خاک را در آسمان مشاهده می‌کنی، در میان خاک توجه کن به وزش باد."],[780,"دیگ‌های فکر می‌بینی به جوش","اندر آتش هم نظر می‌کن به هوش","در اینجا گفته می‌شود که در دنیای فکر و اندیشه، همانند دیگ‌هایی که در آتش در حال جوشیدن هستند، افکار و ایده‌ها مدام در حال تحرک و فعالیت‌اند. به همین دلیل، باید با دقت و هوشیاری به این افکار توجه کرد."],[780,"گفت حق ایوب را در مکرمت","من به هر موییت صبری دادمت","خداوند به ایوب (پیامبر) در مقام بزرگ‌منشی و کرامتش، به ازای هر موی او، صبر عطا کرده است."],[780,"هین به صبر خود مکن چندین نظر","صبر دیدی صبر دادن را نگر","به خاطر صبر خود، زیاد به وضعیت کنونی توجه نکن. تو صبر را بارها دیده‌ای؛ حالا به آن نگاه کن که چگونه می‌خواهند تو را صبر دهند."],[780,"چند بینی گردش دولاب را؟","سر برون کن هم ببین تیز آب را","به اینکه تو تنها به گردش دنیا و تغییرات آن نگاه می‌کنی، اما باید سر خود را از این دنیای نامعلوم بیرون بکشی و به عمق و واقعیت زندگی، همچون تیزی آب که به جلو می‌رود، توجه داشته باشی."],[780,"تو همی‌گویی که می‌بینم ولیک","دید آن را بس علامتهاست نیک","اگرچه تو ادعا می‌کنی که می‌بینی، اما درک واقعی آن نیازمند نشانه‌های روشنی است که تنها با مشاهده عمیق به دست می‌آید."],[780,"گردش کف را چو دیدی مختصر","حیرتت باید به دریا در نگر","وقتی فقط به دیدن سطح و ظاهر چیزها (کف) بسنده می‌کنی، باید دچار شگفتی و حیرت شوی که چه عمق و حقیقتی (دریا) در زیر آن وجود دارد."],[780,"آنک کف را دید سر گویان بود","وانک دریا دید او حیران بود","کسی که فقط به سطح و ظاهر (کف) نگاه می‌کند، نادان و مغرور است و در این حال به خود می‌بالد، اما کسی که عمق و حقیقت (دریا) را می‌بیند، متحیر و شگفت‌زده می‌شود."],[780,"آنک کف را دید نیتها کند","وانک دریا دید دل دریا کند","کسی که فقط به ظاهر چیزها (مانند کف دریا) نگاه می‌کند، نیّت‌های مختلفی می‌کند و سردرگم می‌شود، اما وقتی عمق مسئله (مانند خود دریا) را می‌بیند، دلش گسترده و شجاع می‌شود."],[780,"آنک کفها دید باشد در شمار","و آنک دریا دید شد بی‌اختیار","کسی که تنها به ظاهر و سطحیات (مثل کف دریا) توجه می‌کند، خود را در محدودیت‌های شمارش و اندازه‌گیری نگه می‌دارد، اما کسی که به عمق (مثل دریا) پی می‌برد، به حالت غیر ارادی و بی‌اختیار درمی‌آید، گویی روحش آزاد شده است."],[780,"آنک او کف دید در گردش بود","وانک دریا دید او بی‌غش بود","او که کف‌ها را در حال چرخش می‌دید، در حالی که دریا را می‌دید، صاف و بی‌فریب بود."],[781,"مر مغی را گفت مردی کای فلان","هین مسلمان شو بباش از مؤمنان","مردی به مغ (یک سرزمین و قوم غیرمسلمانی) می‌گوید که ای فلانی، مسلمان شو و جزو مؤمنان باش."],[781,"گفت اگر خواهد خدا مؤمن شوم","ور فزاید فضل هم موقن شوم","مغ گفت اگر خدا بخواهد، من مؤمن می‌شوم و اگر فضل و رحمت او اضافه شود، به یقین به ایمان خود استحکام می‌بخشم."],[781,"گفت می‌خواهد خدا ایمان تو","تا رهد از دست دوزخ جان تو","خدا می‌خواهد که تو مؤمن شوی تا جانت از عذاب دوزخ نجات پیدا کند."],[781,"لیک نفس نحس و آن شیطان زشت","می‌کشندت سوی کفران و کنشت","اما نفس بد و شیطان زشت تو را به سوی کفر و گناه می‌کشند."],[781,"گفت ای منصف چو ایشان غالب‌اند","یار او باشم که باشد زورمند","اگر آنها قدرت و تسلط دارند، پس باید طرفدار کسی باشم که قوی و نیرومند است."],[781,"یار آن تانم بدن کاو غالبست","آن طرف افتم که غالب جاذبست","من طرف کسی هستم که برنده و قوی‌تر است، چون به طور طبیعی به کسانی که غالب و پیشرو هستند تمایل دارم و به سمت آنها جذب می‌شوم."],[781,"چون خدا می‌خواست از من صدق زفت","خواست او چه سود چون پیشش نرفت","وقتی خدا می‌خواست که صداقت را از من ببیند، چه فایده‌ای دارد که من در این مورد تلاش کنم، اگر من به او نزدیک نشوم؟"],[781,"نفس و شیطان خواست خود را پیش برد","وآن عنایت قهر گشت و خرد و مرد","نفس و شیطان تلاش کردند خواسته‌های خود را تحقق بخشند، اما رحمت الهی به قهر تبدیل شد و عقل و انسان را در تنگنا قرار داد."],[781,"تو یکی قصر و سرایی ساختی","اندرو صد نقش خوش افراختی","تو یکی قصر و سرایی ساختی و در آن صد نقش زیبا و خوشگل طراحی کردی."],[781,"خواستی مسجد بود آن جای خیر","دیگری آمد مر آن را ساخت دیر","تو خواستی که آن مکان مسجدی برای خیر و نیکی باشد، اما شخص دیگری آن را به ساختمان دیر (مکانی برای عبادت مسیحیان) تبدیل کرد."],[781,"یا تو بافیدی یکی کرباس تا","خوش بسازی بهر پوشیدن قبا","این بیت به شخصی اشاره دارد که یا پارچه‌ای به نام کرباس (پارچه‌ای خشن و ساده) بافته که برای ساختن قبا (لباس بالاتنه) استفاده می‌شود، یا اینکه تلاش و زحمت کشیده تا قبا را بسازد و برای زیبایی و راحتی خود آماده کند."],[781,"تو قبا می‌خواستی خصم از نبرد","رغم تو کرباس را شلوار کرد","تو در جنگ خواهان لباس (قبا) بودی، اما خصم به خاطر شکست، کرباس را به شلوار تبدیل کرد."],[781,"او زبون شد جرم این کرباس چیست","آنک او مغلوب غالب نیست کیست","او به خاطر کرباس (گونی) زبون و خوار شد، زیرا نمی‌داند که مقصر این وضعیت چه چیزی است و این که چه کسی بر او پیروز شده (غالب) و چه کسی مغلوب است."],[781,"چون کسی بی‌خواست او بر وی براند","خاربن در ملک و خانه او نشاند","وقتی کسی بدون درخواست و تمایل صاحب خانه، در ملک و خانه‌اش خر را براند، یعنی به او بی‌احترامی کرده و او را تحقیر کرده است."],[781,"صاحب خانه بدین خواری بود","که چنین بر وی خلاقت می‌رود","صاحب خانه به خاطر شرایطی که دارد، این گونه مورد تحقیر و ذلت قرار می‌گیرد که این وضعیت بر او تحمیل شده است."],[781,"هم خلق گردم من ار تازه و نوم","چونک یار این چنین خواری شوم","اگر به خاطر چنین یاری که موجب خواری و ذلت من شده، خلق جدیدی پیدا کنم و تازه و نو شوم، چه فایده‌ای دارد؟"],[781,"چونک خواه نفس آمد مستعان","تسخر آمد ایش شاء الله کان","وقتی که نفس به کمک بیاید، آنها که در قدرت هستند به تمسخر برمی‌خیزند، ان‌شاءالله."],[781,"من اگر ننگ مغان یا کافرم","آن نیم که بر خدا این ظن برم","من اگر به خاطر مجوس‌ها (مغان) یا کافران شرمنده هستم، این نیست که به خدا چنین گمانی بد کنم."],[781,"که کسی ناخواه او و رغم او","گردد اندر ملکت او حکم‌جو","اگر کسی به اختیار خود و برخلاف اراده و خواست او وارد سلطنتش شود و در آنجا حاکم شود، این باعث حیرت او خواهد بود."],[781,"ملکت او را فرو گیرد چنین","که نیارد دم زدن دم آفرین","ملکت او (پادشاهی مغ) به‌گونه‌ای او را در بر می‌گیرد که او حتی نمی‌تواند یک کلمه در مورد آفریننده (خدا) بر زبان بیاورد."],[781,"دفع او می‌خواهد و می‌بایدش","دیو هر دم غصه می‌افزایدش","او به دنبال دفع و راندن دیو است، ولی این کار لازم و ضروری به نظر می‌رسد، چرا که این دیو هر لحظه غصه و ناراحتی او را بیشتر می‌کند."],[781,"بنده این دیو می‌باید شدن","چونک غالب اوست در هر انجمن","انسان باید به بندگی این دیو دربیفتد، زیرا او در هر جمع و انجمن غالب و قدرتمند است."],[781,"تا مبادا کین کشد شیطان ز من","پس چه دستم گیرد آنجا ذوالمنن","من نمی‌خواهم که شیطان بر من مسلط شود و کینه‌ام را بگیرد، زیرا در آن صورت، دیگر نمی‌توانم از رحمت خداوند (ذوالمنن) بهره‌مند شوم."],[781,"آنک او خواهد مراد او شود","از کی کار من دگر نیکو شود","اگر او بخواهد که آرزویش برآورده شود، کار من به خودی خود بهتر خواهد شد."],[782,"حاش لله ایش شاء الله کان","حاکم آمد در مکان و لامکان","به هر حال خداوند اگر بخواهد، حاکم در هر جا و هر مکان می‌آید و در هیچ مکانی نیست که او حاکم نباشد."],[782,"هیچ کس در ملک او بی‌امر او","در نیفزاید سر یک تای مو","در سرزمین خدا هیچ‌کس بدون فرمان او نمی‌تواند حتی به اندازه یک تار موی خود چیزی اضافه کند."],[782,"ملک، ملک اوست فرمان آن او","کمترین سگ بر در آن شیطان او","زمین و ملکی که در آن زندگی می‌کنیم، همگی متعلق به خداوند است و فرمانروایی و اختیار به دست اوست؛ حتی کمترین موجودی مانند یک سگ که در دروازه شیطان نشسته، نیز نمی‌تواند بدون اجازه او کاری انجام دهد."],[782,"ترکمان را گر سگی باشد به در","بر درش بنهاده باشد رو و سر","اگر درب خانه ترکمان (انسان سرسخت) سگی وجود داشته باشد که آنجا نشسته و سرش را هم بالا نگه داشته، نشان‌دهنده چست و سخت‌کوش بودن اوست."],[782,"کودکان خانه دمش می‌کشند","باشد اندر دست طفلان خوارمند","کودکان، در حالی که به دلیل ضعف و ناتوانی خود در برابر بزرگ‌ترها، به سگی که در در خانه است، ابراز محبت می‌کنند، به او نزدیک می‌شوند و از او حمایت می‌کنند."],[782,"باز اگر بیگانه‌ای معبر کند","حمله بر وی هم‌چو شیر نر کند","اگر بیگانه‌ای به حریم و محدوده‌ ما هجوم آورد، باید مثل شیر نر بر او حمله کرد و به او پاسخ داد."],[782,"که اشداء علی الکفار شد","با ولی گل با عدو چون خار شد","مؤمنان در برابر دشمنان مانند شیر نر شمشیر می‌زنند و در مقابل دوستان و اهل ایمان همچون گل نرم و مهربان می‌شوند، اما نسبت به دشمنان مانند خار سخت و بی‌رحم هستند."],[782,"ز آب تتماجی که دادش ترکمان","آنچنان وافی شده‌ست و پاسبان","از آبی که ترکمنی به او داده، به‌قدری شفاف و زلال شده است که دیگر نیازی به محافظت ندارد و به طور کامل نمایان است."],[782,"پس سگ شیطان که حق هستش کند","اندرو صد فکرت و حیلت تند","سگ شیطان، که نماد وسوسه و فریب است، در دل انسان نفوذ می‌کند و او را به تفکر و حیله‌های نادرست می‌اندازد."],[782,"آب روها را غذای او کند","تا برد او آب روی نیک و بد","شیطان از آب روها (چهره‌ها) تغذیه می‌کند و بر اساس آن‌ها به انسان‌ها نیکی و بدی را ارائه می‌دهد."],[782,"این تتماجست آب روی عام","که سگ شیطان از آن یابد طعام","این آب روی عام، مانند ماده‌ای است که شیطان از آن تغذیه می‌کند. در واقع، افرادی که از صفات و ناپاکی‌های درونی محروم‌اند، در حقیقت به این نوع غذا دسترسی دارند و تحت تأثیر نیروهای منفی قرار می‌گیرند."],[782,"بر در خرگاه قدرت جان او","چون نباشد حکم را قربان بگو","در درگاه خداوندی، اگر جان انسان نتواند خود را به نزدیکی و مقام والای قدرت برساند، باید بگوید که به خاطر حکم و اراده او، خود را فدای او می‌کند."],[782,"گله گله از مرید و از مرید","چون سگ باسط ذراعی بالوصید","گله گله از مریدان و پیروان مثل سگی هستند که در اطراف کسی که مقامش بالا و والا است، با وفاداری و سرسپردگی در گرد او می‌چرخند."],[782,"بر در کهف الوهیت چو سگ","ذره ذره امرجو برجسته رگ","کسی که در درگاه الوهیت همچون سگی وفادار و تسلیم است، با دقت و حوصله هر جزئی از واقعیت‌های معنوی را بررسی کرده و به دنبال درک عمیق‌تری از آن‌هاست."],[782,"ای سگ دیو امتحان می‌کن که تا","چون درین ره می‌نهند این خلق پا","ای دیو، تو هم مانند یک سگ در این امتحان رفتار کن، ببین این مردم چگونه در این راه قدم می‌گذارند."],[782,"حمله می‌کن منع می‌کن می‌نگر","تا که باشد ماده اندر صدق و نر","به خود اجازه حمله و منع می‌دهی، اما باید دقت کنی که این ماده (جنس ماده) در صدق (راست‌گویی) و نر (جنس نر یا مرد) چگونه است."],[782,"پس اعوذ از بهر چه باشد چو سگ","گشته باشد از ترفع تیزتگ","پس «اعوذ» از چه باید باشد وقتی که مانند سگ تیزتگ (یا گزند) شده‌ای؟"],[782,"این اعوذ آنست کای ترک خطا","بانگ بر زن بر سگت ره بر گشا","این پناه و تکیه‌گاه همانی است که ای ترک، خطا نکن و صدا بر بزن که در آن هنگام، راه را به سگی می‌گشایی."],[782,"تا بیایم بر در خرگاه تو","حاجتی خواهم ز جود و جاه تو","وقتی به درگاه تو می‌آیم، از مهربانی و بزرگی‌ات حاجتی دارم."],[782,"چونک ترک از سطوت سگ عاجزست","این اعوذ و این فغان ناجایزست","چون ترک (انسانی که به ترک‌ها اشاره دارد) از قدرت و زور سگ ناتوان است، پس درخواست پناهندگی و فریاد زدن او بی‌مناسبت و نادرست است."],[782,"ترک هم گوید اعوذ از سگ که من","هم ز سگ در مانده‌ام اندر وطن","ترک نیز می‌گوید که به خاطر سگ به خدا پناه می‌برم، زیرا من هم به خاطر سگ در وطن خود گرفتار شده‌ام."],[782,"تو نمی‌یاری برین در آمدن","من نمی‌آرم ز در بیرون شدن","تو نمی‌توانی به این در ورود کنی و من هم نمی‌توانم از در خارج شوم."],[782,"خاک اکنون بر سر ترک و قنق","که یکی سگ هر دو را بندد عنق","خاک بر سر کسانی که به خاطر عرق و تفریح، مانند سگ به هم می‌پیوندند و در واقع هیچ ارزشی ندارند."],[782,"حاش لله ترک بانگی بر زند","سگ چه باشد شیر نر خون قی کند","برای خداوند، ترک (ترک، قومی در تاریخ) چه صدایی برمی‌آورد که سگ (حیوانی پست) را به زنجیر بکشد؟ هرچند شیر نر (شیر، نماد قدرت و شجاعت) خون را می‌ریزد، باز هم این کار از سگ برنمی‌آید."],[782,"ای که خود را شیر یزدان خوانده‌ای","سالها شد با سگی در مانده‌ای","ای کسی که خود را شیر خدا معرفی می‌کنی، سال‌هاست که با یک سگ در حال سرگردانی و گیر افتادگی هستی."],[782,"چون کند این سگ برای تو شکار؟","چون شکار سگ شده‌ستی آشکار","چطور این سگ می‌تواند برای تو شکار کند؟ وقتی که خودت به عنوان طعمه شکار شده‌ای و دیگر شکارچی نیستی."],[783,"گفت مؤمن بشنو ای جبری خطاب","آن خود گفتی نک آوردم جواب","مؤمن به جبری می‌گوید: تو حرف خود را زدی. حالا پاسخ من را بشنو."],[783,"بازی خود دیدی ای شطرنج‌باز","بازی خصمت ببین پهن و دراز","ای شطرنج‌باز، فقط به بازی خودتان نپردازید، بلکه باید بازی حریف را نیز مشاهده کنید؛ او حرکاتش را به گونه‌ای انجام می‌دهد که درازمدت و هدفمند است."],[783,"نامه عذر خودت بر خوانده‌ای","نامه سنی بخوان، چه مانده‌ای؟","بهانه هایت را برشمردی، حالا نامه‌ای از سنّی را بخوان، منتظر چه هستی؟"],[783,"نکته گفتی جبریانه در قضا","سرّ آن بشنو ز من در ماجرا","نکته‌ای که تو به طور جبری درباره قضا و تقدیر می‌گویی، حقیقت آن را از من بشنو و در این داستان توجه کن."],[783,"اختیاری هست ما را بی‌گمان","حس را منکر نتانی شد عیان","ما به‌طور قطع دارای اختیار و توان انتخاب هستیم، و نمی‌توان به هیچ وجه حس و درک خود را منکر شد، زیرا این اختیار روشن و آشکار است."],[783,"سنگ را هرگز بگوید کس بیا","از کلوخی کس کجا جوید وفا","هیچ‌کس هرگز به سنگ دستور نمی‌دهد، چه کسی از کلوخ انتظار وفا دارد؟"],[783,"آدمی را کس نگوید هین بپر","یا بیا ای کور تو در من نگر","هیچ‌کس به آدمی نمی‌گوید که پرواز کن، یا ای نابینا! باید به من نگاه کنی."],[783,"گفت یزدان ما علی الاعمی حرج","کی نهد بر کس حرج رب الفرج","خداوند فرمود: بر نابینایان هیچ ایرادی وارد نیست (که جهاد نکنند)، و او که مشکلات را می‌زداید، بر کسی بار گناه نخواهد نهاد."],[783,"کس نگوید سنگ را دیر آمدی","یا که چوبا تو چرا بر من زدی","هیچ‌کس به سنگ نمی‌گوید که دیر کردی، یا چوب! چرا بر من فرود آمدی."],[783,"این چنین واجستها مجبور را","کس بگوید یا زند معذور را؟","هیچ‌کس به مجبور نمی‌تواند بگوید که چرا به این حالت درآمده است و چرا مجبور است، مانند کسی که معذور است و نمی‌توان به او خرده گرفت."],[783,"امر و نهی و خشم و تشریف و عتیب","نیست جز مختار را ای پاک‌جیب","هیچ‌یک از دستورها و نهی‌ها، خشم‌ها و احترام‌ها مربوط به کسی نیست جز کسی که اختیار دارد، ای صاحب دل پاک."],[783,"اختیاری هست در ظلم و ستم","من ازین شیطان و نفس این خواستم","انسان می‌تواند در کارهای ظلم و ستم اختیار داشته باشد و این خواسته من از شیطان و نفسم است."],[783,"اختیار اندر درونت ساکنست","تا ندید او یوسفی، کف را نخست","اختیار درون تو وجود دارد، اما تا زمانی که آن را نبینی و به‌خوبی نشناسی، نمی‌توانی از آن استفاده کنی یا آثارش را مشاهده کنی. مانند یوسف که در چاهی بود و کسی به او توجه نداشت."],[783,"اختیار و داعیه در نفس بود","روش دید آنگه پر و بالی گشود","اختیار و رغبت در نفس انسان وجود دارد و وقتی او این حقیقت را ببیند، توانایی و آزادی عمل بیشتری پیدا می‌کند."],[783,"سگ بخفته اختیارش گشته گم","چون شکنبه دید جنبانید دم","سگ، که نماد یک موجود در خواب و بی‌خبر از اختیارش است، وقتی که دمی را می‌بیند که حرکت می‌کند، متوجه می‌شود باید واکنشی نشان دهد و در واقع به خود می‌آید. این تصویر به نوعی توانایی انتخاب را در موجودات نشان می‌دهد، حتی اگر در حالت خواب و ناآگاهی قرار داشته باشند."],[783,"اسپ هم حو حو کند چون دید جو","چون بجنبد گوشت گربه کرد مو","اسب نیز وقتی جو می‌بیند، صداهایی از خود در می‌آورد. و گربه اگر گوشت ببیند میو میو می کند."],[783,"دیدن آمد جنبش آن اختیار","هم‌چو نفخی ز آتش انگیزد شرار","دیدن اختیار به انسان این قدرت را می‌دهد که مانند شراره های آتش، حس و انرژی خاصی در او برانگیخته شود."],[783,"پس بجنبد اختیارت چون بلیس","شد دلاله آردت پیغام ویس","بنابراین اراده‌ات می تواند مانند ابلیس به حرکت درآید، و یا پیام عشق از ویس به تو برسد."],[783,"چونک مطلوبی برین کس عرضه کرد","اختیار خفته بگشاید نورد","وقتی مطلوبی را بر آن شخص عرضه کردند، اختیار پنهان او نیز بیدار می‌شود و روشن می‌گردد."],[783,"وآن فرشته خیرها بر رغم دیو","عرضه دارد می‌کند در دل غریو","فرشته نیکی‌ها با وجود شیطان، نیکی‌ها را در دل انسان القا می‌کند."],[783,"تا بجنبد اختیار خیر تو","زانک پیش از عرضه خفته‌ست این دو خو","برای اینکه اختیار نیکی کردن در تو برانگیخته شود، زیرا قبل از این، حالت و روحیاتت در حالت خواب و بی‌توجهی قرار دارد."],[783,"پس فرشته و دیو گشته عرضه‌دار","بهر تحریک عروق اختیار","بنابراین فرشته و شیطان به‌عنوان نمایندگان عمل و تصمیم‌گیری در برابر انسان حضور دارند تا او را در انتخاب‌هایش تحت تأثیر قرار دهند."],[783,"می‌شود ز الهامها و وسوسه","اختیار خیر و شرّت ده کسه","الهام‌ها و وسوسه‌ها می توانند حس انتخاب بین خوبی و بدی را بسیار تقویت کنند."],[783,"وقت تحلیل نماز ای بانمک","زان سلام آورد باید بر ملک","زمانی که به نماز می‌پردازی، ای دلربا، باید به فرشتگان سلام فرستی."],[783,"که ز الهام و دعای خوبتان","اختیار این نمازم شد روان","به خاطر الهام و دعاهای خوب شما، اختیار انجام این نماز به من داده شده است و این عبادت برایم روان و آسان شده است."],[783,"باز از بعد گنه لعنت کنی","بر بلیس ایرا کزویی منحنی","پس از گناه به شیطان لعنت می‌فرستی، زیرا او تو را به راه کج منحرف می‌کند."],[783,"این دو ضد عرضه کننده‌ت در سرار","در حجاب غیب آمد عرضه‌دار","این دو نیروی مخالف هم که در وجودت هستند، در پرده‌ای از پنهان به تو عرضه می‌شوند."],[783,"چونک پرده غیب برخیزد ز پیش","تو ببینی روی دلالان خویش","وقتی پرده‌های پنهان از جلوی چشمانت برداشته شود، چهره‌های کسانی که به تو نزدیک‌اند را خواهی دید."],[783,"وآن سخنشان وا شناسی بی‌گزند","که آن سخن‌گویان نهان اینها بدند","تنها کسانی که به درستی سخن می‌گویند و می‌توان به آن‌ها اعتماد کرد، افرادی هستند که خود را در پس پرده‌ها پنهان نکرده‌اند. در واقع، سخنانی که از دل بر می‌آید و از افرادی معتبر بیان می‌شود، خالی از آسیب و گزند است."],[783,"دیو گوید ای اسیر طبع و تن","عرضه می‌کردم نکردم زور من","دیو می‌گوید: ای کسی که اسیر طبیعت و جسمت هستی، من فقط به تو پیشنهاد می‌کردم، و تو را به زور مجبور به کاری نمی‌کردم."],[783,"وآن فرشته گویدت من گفتمت","که ازین شادی فزون گردد غمت","فرشته به تو می‌گوید: من به تو گفتم که پس از این لذت، غم هایت بیشتر خواهد شد."],[783,"آن فلان روزت نگفتم من چنان؟","که از آن سویست ره سوی جنان","من در آن روز خاص حرف‌هایی به تو زدم که نشان‌دهنده‌ی راه به سمت بهشت بود، اما تو متوجه آن نشدی."],[783,"ما محب جان و روح‌افزای تو","ساجدان مخلص بابای تو","ما عاشق جان و روح تو هستیم و به پدر تو (حضرت آدم) سجده کردیم."],[783,"این زمانت خدمتی هم می‌کنیم","سوی مخدومی صلایت می‌زنیم","در این زمان ما هم به نوعی خدمت می‌گذاریم و برای محبت و دوستی تو دعا می‌کنیم."],[783,"آن گره بابات را بوده عدی","در خطاب اسجدوا کرده ابا","آن گروه دیگر، دشمن پدرت بوده اند، و در مقابل دستور \"سجده کنید\" از پیروی از دستورات الهی سر باز زدند."],[783,"آن گرفتی آن ما انداختی","حق خدمت‌های ما نشناختی","تو آن چیزی را که به ما تعلق داشت، گرفتی و حق زحمات ما را ندیدی و نشناختی."],[783,"این زمان ما را و ایشان را عیان","در نگر بشناس از لحن و بیان","در این زمان، ما و آن‌ها را به وضوح بشناسید، با دقت به نحوه صحبت و بیان آن‌ها."],[783,"نیم‌شب چون بشنوی رازی ز دوست","چون سخن گوید سحر دانی که اوست","نیمه شب وقتی که رازی از دوست می‌شنوی، هنگامی که سحر سخن می‌گوید، می‌فهمی که او همان دوست است."],[783,"ور دو کس در شب خبر آرد ترا","روز از گفتن شناسی هر دو را","اگر دو نفر در شب خبری به تو بگویند، روز که بشنوی، از گفته‌هایشان می‌فهمی که آن‌ها را می‌شناسی."],[783,"بانگ شیر و بانگ سگ در شب رسید","صورت هر دو ز تاریکی ندید","صدای شیر و صدای سگ در شب به گوش رسید، اما به علت تاریکی هیچ‌کدام را نتوانستند ببینند."],[783,"روز شد چون باز در بانگ آمدند","پس شناسدشان ز بانگ آن هوشمند","هنگامی که صبح شد و صدای آنها به گوش رسید، آن فرد دانا آنها را از صدایشان شناخت."],[783,"مخلص این که دیو و روح عرضه‌دار","هر دو هستند از تتمه اختیار","در نهایت باید گفت که هر دو دیو و روح به نوعی نشانه‌ای از باقی‌مانده انتخاب و اختیار انسان هستند."],[783,"اختیاری هست در ما ناپدید","چون دو مطلب دید آید در مزید","در وجود ما اراده‌ای پنهان وجود دارد و این حالت به وضوح زمانی نمایان می‌شود که دو دیدگاه مختلف در کنار هم قرار می‌گیرند."],[783,"اوستادان کودکان را می‌زنند","آن ادب سنگ سیه را کی کنند؟","استادان نسبت به کودکان سخت‌گیرانه رفتار می‌کنند، اما آیا کسی سنگ سیاه را ادب می کند؟"],[783,"هیچ گویی سنگ را فردا بیا","ور نیایی من دهم بد را سزا","آیا کسی به سنگ می‌گوید باید فردا بیایی و اگر نیایی، من جزای بدی را خواهم داد."],[783,"هیچ عاقل مر کلوخی را زند","هیچ با سنگی عتابی کس کند","هیچ فرد عاقلی با سنگ‌ریزه‌ای دعوا نمی‌کند و کسی سنگ بزرگ را ملامت نمی‌کند."],[783,"در خرد جبر از قدر رسواترست","زانک جبری حس خود را منکرست","در عقل و تفکر، جبر از سرنوشت بی‌آبروتر است، زیرا کسی که به جبر اعتقاد داشته باشد، در حقیقت احساس خود را انکار کرده است."],[783,"منکر حس نیست آن مرد قدر","فعل حق حسی نباشد ای پسر","کسی که به سرنوشت اعتقاد دارد، منکر احساس نیست. ای پسر! حق و حقیقت یک امر حسی نیست."],[783,"منکر فعل خداوند جلیل","هست در انکار مدلول دلیل","کسی که اعمال خداوند بزرگ را انکار کند، در حقیقت به نتیجه که بر وجود و کارهای او دلالت دارد، پشت پا زده است."],[783,"آن بگوید دود هست و نار نی","نور شمعی بی ز شمعی روشنی","چنین شخصی می‌گوید وجود دود نشان‌دهنده آتش نیست و نور شمعی را بدون وجود شمع دیگری می‌داند. در واقع، اشاره به این دارد که برخی چیزها نمی‌توانند به تنهایی حقیقت یا واقعیت داشته باشند."],[783,"وین همی‌بیند معین نار را","نیست می‌گوید پی انکار را","این شخص آتش را می‌بیند، اما آن را انکار می‌کند و به دنبال دلیل‌هایی بر انکار خود می‌گردد."],[783,"جامه‌اش سوزد بگوید نار نیست","جامه‌اش دوزد بگوید تار نیست","این شخص حتی اگر لباسش بسوزد، می‌گوید که آتش وجود ندارد و اگر هم لباسش را بدوزد، باز هم می‌گوید که تار و پود آن وجود ندارد."],[783,"پس تسفسط آمد این دعوی جبر","لاجرم بدتر بود زین رو ز گبر","بنابراین، این نظریه جبر و اجبار، در واقع بدتر از چیزی است که از یک کافر انتظار می‌رود."],[783,"گبر گوید هست عالم نیست رب","یا ربی گوید که نبود مستحب","کافر می‌گوید که جهان وجود دارد و خداوندی نیست. میگوید که \"یا رب\" مطلوب و پسندیده‌ نیست."],[783,"این همی‌گوید جهان خود نیست هیچ","هسته سوفسطایی اندر پیچ پیچ","او می گوید جهان به خودی خود وجود ندارد و هیچ چیز ثابت و واقعی نیست. این اعتقادات و نظرات سوفسطایی متناقض و گمراه کننده هستند."],[783,"جمله عالم مقر در اختیار","امر و نهی این میار و آن بیار","تمامی موجودات، اختیار را تایید می کنند؛ مانند فرمان این را نیاور و آن را بیاور."],[783,"او همی‌گوید که امر و نهی لاست","اختیاری نیست این جمله خطاست","او می‌گوید که فرمان و نهی و اختیار وجود ندارد، اما این حرف نادرست است."],[783,"حس را حیوان مقرست ای رفیق","لیک ادراک دلیل آمد دقیق","حیوانات نیز وجود احساسات را تایید می کنند، هرچند فهم و درک ما منطقی و عمیق‌تر از این احساسات است."],[783,"زانک محسوسست ما را اختیار","خوب می‌آید برو تکلیف کار","به خاطر اینکه ما می‌توانیم به طور مستقیم اختیار را احساس کنیم، بنابراین در قبال کارهایمان نیز باید پاسخگو باشیم."],[784,"درک وجدانی به جای حس بود","هر دو در یک جدول ای عم می‌رود","درک و فهم وجدانی انسان، جایگزین حس ظاهری است و هر دو در یک سطح از وجود قرار دارند، ای عم (ای برادر)."],[784,"نغز می‌آید برو کن یا مکن","امر و نهی و ماجراها و سخن","نغز و زیبا می‌رسد به تو این امر و نهی، پس یا باید کاری را انجام دهی یا از آن پرهیز کنی؛ این مساله نشان‌دهنده ماجراها و گفت‌وگوهایی است که در زندگی رخ می‌دهد."],[784,"این که فردا این کنم یا آن کنم","این دلیل اختیارست ای صنم","اینکه می‌گوید فردا چه کاری انجام دهم، نشانه‌ای از اختیار و آزادی در تصمیم‌گیری من است، ای محبوب."],[784,"وان پشیمانی که خوردی زان بدی","ز اختیار خویش گشتی مهتدی","پشیمانی که به خاطر کار بدی که کردی، به وجود آمده، نشان‌دهنده این است که از روی اختیار خودت بوده و به همین دلیل، به راه درست هدایت شده‌ای."],[784,"جمله قران امر و نهیست و وعید","امر کردن سنگ مرمر را کی دید","قرآن به فرمان و نهی پرداخته و هشدارهایی ارائه می‌دهد، اما آیا کسی سنگ مرمر را به عنوان یک چیز باارزش دیده است که به او دستور داده شود؟ این بیان نشان می‌دهد که برخی امور ممکن است از نظر ظاهر مهم به نظر نرسند."],[784,"هیچ دانا هیچ عاقل این کند","با کلوخ و سنگ خشم و کین کند","هیچ دانشمند و عاقل، در برابر کلوخ و سنگ، خشم و کینه نمی‌ورزد."],[784,"که بگفتم کین چنین کن یا چنان","چون نکردید ای موات و عاجزان","من به شما گفتم که اگر می‌خواهید بدکاری کنید، می‌توانید به این شکل عمل کنید یا به آن شکل، اما شما ای بی‌جان و ناتوان هیچ‌یک از این‌ها را نکردید."],[784,"عقل کی حکمی کند بر چوب و سنگ","عقل کی چنگی زند بر نقش چنگ","عقل نمی‌تواند در مورد چوب و سنگ حکمی بدهد، و نمی‌تواند به نقش‌های روی چنگ (آلت موسیقی) نیز واکنش نشان دهد."],[784,"کای غلام بسته دست اشکسته‌پا","نیزه برگیر و بیا سوی وغا","که ای خدمتگزار، تو که دستت باندپیچی شده و پایت شکستگی دارد، سلاح خود را بردار و به میدان جنگ بیا."],[784,"خالقی که اختر و گردون کند","امر و نهی جاهلانه چون کند","خالق، آسمان و ستاره‌ها را به نظم درمی‌آورد؛ اما انسان که ignorant و نادان است چگونه می‌تواند به درستی امر و نهی کند؟"],[784,"احتمال عجز از حق راندی","جاهل و گیج و سفیهش خواندی","تو احتمال (امکان) ناتوانی را از حق (خداوند) رد کردی (نادرست دانستی)، ولی او را شخصی نادان، گیج و احمق شمردی."],[784,"عجز نبود از قدر ور گر بود","جاهلی از عاجزی بدتر بود","عجز (ناتوانی) از تقدیر خداوند نیست، و اگر فردی نادان باشد، نادانی‌اش از ناتوانی‌اش بدتر است."],[784,"ترک می‌گوید قنق را از کرم","بی‌سگ و بی‌دلق آ سوی درم","ترک (هندو) می‌گوید که با دل‌رحمی و بزرگواری، نه به خاطر نداشتن سگ و دلق (جامه پست و ناچیز)، بلکه به خاطر انسانیت و کریم بودن به قنق (تجارت) می‌پردازد و به سوی ثروت (درم) می‌رود."],[784,"وز فلان سوی اندر آ هین با ادب","تا سگم بندد ز تو دندان و لب","از آن سو که شخص با آداب و ادب وارد می‌شود، تا زمانی که سگ به او نزدیک نشود و دندان و لبش را نیش نزند، او در امان خواهد بود."],[784,"تو به عکس آن کنی بر در روی","لاجرم از زخم سگ خسته شوی","تو برخلاف آنچه باید باشد رفتار می‌کنی و در نتیجه از زخم‌هایی که به تو می‌رسد، خسته و رنجیده خواهی شد."],[784,"آن‌چنان رو که غلامان رفته‌اند","تا سگش گردد حلیم و مهرمند","به‌گونه‌ای رفتار کن که غلامان (خدمتکاران) رفته‌اند، تا اینکه سگ تو هم نرم و مهربان شود. یعنی با محبت و رفتار نیکو، می‌توان رفتار دیگران را تغییر داد."],[784,"تو سگی با خود بری یا روبهی","سگ بشورد از بن هر خرگهی","تو هر کجا که بروی، حالتی از خودت را با خود می‌بری، یا مثل روباه فریبنده‌ای، همچون سگی که با خود می‌برد، از هر محل و مکانی در می‌آیی."],[784,"غیر حق را گر نباشد اختیار","خشم چون می‌آیدت بر جرم‌دار","اگر غیر از خدا کسی دیگر را اختیار و اراده‌ای نداشته باشد، خشم تو در برابر کسی که مرتکب گناه شده، چگونه بر تو عارض می‌شود؟"],[784,"چون همی‌خایی تو دندان بر عدو","چون همی بینی گناه و جرم ازو","وقتی تو از دشمن خود نفرت و خشم داری و به او دندان نشان می‌دهی، یعنی گناه و خطای او را می‌بینی."],[784,"گر ز سقف خانه چوبی بشکند","بر تو افتد سخت مجروحت کند","اگر چوب سقف خانه بر سرت بیفتد، به شدت آسیب می‌بینی و جراحت می‌خوری."],[784,"هیچ خشمی آیدت بر چوب سقف","هیچ اندر کین او باشی تو وقف","اگر بر تو خشم و غضبی پیدا شود، نباید بر چوب سقف خشمگین شوی، چون تو خود را نسبت به او (چوب سقف) در این خشم گرفتار کرده‌ای و هیچ ارتباطی با او نداری."],[784,"که چرا بر من زد و دستم شکست","او عدو و خصم جان من بدست","شخصی از روی غفلت به من آسیب زده و دستم را شکسته است و این فرد، دشمن جان من به حساب می‌آید."],[784,"کودکان خرد را چون می‌زنی","چون بزرگان را منزه می‌کنی","وقتی که به کودکان کوچک ظلم می‌کنی و به آن‌ها صدمه می‌زنی، در حقیقت خود را از بزرگ‌ترها و انسان‌های پخته‌تر پاک و برتر می‌دانی."],[784,"آنک دزدد مال تو گویی بگیر","دست و پایش را ببر سازش اسیر","اگر کسی مال تو را بدزدد، باید او را بگرفتی و به او سختی بدهی تا تسلیم و بی‌دفاع شود."],[784,"وآنک قصد عورت تو می‌کند","صد هزاران خشم از تو می‌دمد","اگر کسی بخواهد به زن تو چشم‌غوره‌ای داشته باشد، خشم و غضب زیادی از جانب تو ناشی می‌شود و به شدت احساس می‌کنی."],[784,"گر بیاید سیل و رخت تو برد","هیچ با سیل آورد کینی خرد","اگر سیل بیاید و اثاث تو را ببرد، نباید که دل خود را به خاطر این اتفاق پر از کینه کنی."],[784,"ور بیامد باد و دستارت ربود","کی ترا با باد دل خشمی نمود","اگر باد بیاید و دستار تو را ببرد، آیا دل تو به خاطر این موضوع با باد خشمگین می‌شود؟"],[784,"خشم در تو شد بیان اختیار","تا نگویی جبریانه اعتذار","خشم در وجود تو نشانه‌ای از آزادی اراده‌ات است، پس نباید بهانه‌ای بیاوری و خود را مجبور به این حالت معرفی کنی."],[784,"گر شتربان اشتری را می‌زند","آن شتر قصد زننده می‌کند","اگر شتربانی شتر خود را می‌زند، آن شتر به قصد خود شتربان هم به او حمله می‌کند."],[784,"خشم اشتر نیست با آن چوب او","پس ز مختاری شتر بردست بو","خشم شتر به خاطر آن تغییر و ضربه‌ای که به او وارد می‌شود نیست؛ بلکه نشان‌دهنده‌ی اختیار شتر است که در دست شتربان قرار دارد."],[784,"هم‌چنین سگ گر برو سنگی زنی","بر تو آرد حمله گردد منثنی","اگر بر یک سگ سنگی بیفکنی، آن سگ به تو حمله‌ور می‌شود و از روی خشم پاسخ می‌دهد."],[784,"سنگ را گر گیرد از خشم توست","که تو دوری و ندارد بر تو دست","اگر کسی سنگی را به عنوان نشانه خشم تو به کار ببرد، به این دلیل است که تو دور هستی و او توانایی ضربه زدن به تو را ندارد."],[784,"عقل حیوانی چو دانست اختیار","این مگو ای عقل انسان شرم دار","عقل حیوانی وقتی به مفهوم اختیار پی می‌برد، دیگر نباید به عقل انسان اجازه دهد که در این مورد سخن بگوید، بلکه باید در برابر آن خجالت بکشد."],[784,"روشنست این لیکن از طمع سحور","آن خورنده چشم می‌بندد ز نور","آنچه بیان می‌شود این است که فردی که شوق و طمع به خوراک سحری دارد، به رغم اینکه حقیقت روشن است، چشمانش را به روی نور می‌بندد و نمی‌بیند. این اشاره به ناتوانی انسان در دیدن حقیقت به دلیل وسوسه‌ها و خواسته‌های دلش دارد."],[784,"چونک کلی میل او نان خوردنیست","رو به تاریکی نهد که روز نیست","انسان وقتی که تمام توجه و خواسته‌اش به خوردن نان معطوف می‌شود، به خاطر اینکه روز نیست، به سمت تاریکی می‌رود و نمی‌تواند از آنچه در دسترسش است استفاده کند."],[784,"حرص چون خورشید را پنهان کند","چه عجب گر پشت بر برهان کند","حرص انسان به گونه‌ای است که می‌تواند مانند خورشید، حقیقت و روشنی را پنهان کند. بنابراین، تعجبی ندارد اگر انسان بخواهد برهان‌ها و دلایل روشنگر را رد کند و پشت کند."],[785,"گفت دزدی شحنه را کای پادشاه","آنچ کردم بود آن حکم اله","دزدی به شحنه، که فرمانده پلیس است، می‌گوید: «ای پادشاه، آنچه من انجام داده‌ام، مطابق حکم الهی است.» در اینجا دزد سعی دارد کار خود را توجیه کند و مسئولیت‌ها را به تقدیر الهی نسبت می‌دهد."],[785,"گفت شحنه آنچ من هم می‌کنم","حکم حقست ای دو چشم روشنم","شحنه (پرسنل حکومتی) می‌گوید هر کاری که من انجام می‌دهم، مطابق با حکم خداوند است و این را با یقین بیان می‌کند، ای دو چشم روشن من (به‌نوعی به مخاطب احترام می‌گذارد)."],[785,"از دکانی گر کسی تربی برد","کین ز حکم ایزدست ای با خرد","اگر کسی از دکانی تربت (خاک) برباید، این کار ناشی از اراده و فرمان خداوند است، ای کسی که خردمند هستی."],[785,"بر سرش کوبی دو سه مشت ای کره","حکم حقست این که اینجا باز نه","اگر کسی بر سر او چند مشت بزند، این به حکم حق است و دلیلی ندارد که او اینجا نایستد."],[785,"در یکی تره چو این عذر ای فضول","می‌نیاید پیش بقالی قبول","اگر بهانه‌ای مثل این داشته باشی، ای فضول، هیچ‌گاه نمی‌توانی در مغازه‌ی بقالی قبول شویم و چیزی بخری."],[785,"چون بدین عذر اعتمادی می‌کنی","بر حوالی اژدهایی می‌تنی","اگر به این بهانه و عذر، به چیزی اعتماد کنی، در حقیقت به گرداب و گرفتاری عظیمی مانند اژدها وارد شده‌ای."],[785,"از چنین عذر ای سلیم نانبیل","خون و مال و زن همه کردی سبیل","از این عذر که می‌گویی، ای سلیم نانبیل، تو به بهانه آن خون مردم و مال و زنان را حلال می‌کنی و این کار را مجاز می‌دانی."],[785,"هر کسی پس سبلت تو بر کند","عذر آرد خویش را مضطر کند","هر کسی که از تو عذر و بهانه بیاورد، خود را در موقعیتی ناتوان و تحت فشار نشان می‌دهد."],[785,"حکم حق گر عذر می‌شاید ترا","پس بیاموز و بده فتوی مرا","اگر حکم خداوند به تو اجازه‌ی عذرخواهی می‌دهد، پس بیاموز و به من درس بده که چگونه عذر خود را بیان کنم."],[785,"که مرا صد آرزو و شهوتست","دست من بسته ز بیم و هیبتست","من آرزوها و تمایلات زیادی دارم، اما به خاطر ترس و احترام، دست و پایم بسته است و نمی‌توانم به آن‌ها دست یابم."],[785,"پس کرم کن عذر را تعلیم ده","برگشا از دست و پای من گره","ای خدا، لطف و کرم کن و عذر و بهانه‌ام را بپذیر و مرا از بند و محدودیت‌هایی که دارم آزاد کن."],[785,"اختیاری کرده‌ای تو پیشه‌ای","که اختیاری دارم و اندیشه‌ای","تو کار و حرفه‌ای را برگزیده‌ای که در آن خودت اختیاری داری و می‌توانی برای آن فکر کنی و تصمیم بگیری."],[785,"ورنه چون بگزیده‌ای آن پیشه را","از میان پیشه‌ها ای کدخدا","اگر تو این شغل و کار را از میان دیگر کارها انتخاب کرده‌ای، ای کدخدا، پس نباید بگویی که من اختیاری ندارم."],[785,"چونک آید نوبت نفس و هوا","بیست مرده اختیار آید ترا","وقتی نفس و خواهش‌های نفسانی دخالت کنند، در آن حال بیست مرده (انتخاب‌ها و اختیارها) به سراغت می‌آید، و این نشان‌دهنده غفلت از اختیار واقعی است."],[785,"چون برد یک حبه از تو یار سود","اختیار جنگ در جانت گشود","زمانی که محبوب (یار) از تو یک گوشه‌ای (حبه‌ای) بگیرد، به سود تو، جنگی در وجودت آغاز می‌شود؛ یعنی در اینجا جنگی بین خواسته‌ها و حقایق درونت شکل می‌گیرد که نشان‌دهنده تعارض بین میل‌های نفسانی و انتخاب‌های عقلانی تو است."],[785,"چون بیاید نوبت شکر نعم","اختیارت نیست وز سنگی تو کم","زمانی که نوبت شکرگزاری از نعمت‌هایت می‌رسد، دیگر اختیاری برای تو وجود ندارد و مانند سنگی بی‌تحرک می‌شوی."],[785,"دوزخت را عذر این باشد یقین","که اندرین سوزش مرا معذور بین","در آتش جهنم، عذر و بهانه‌ای وجود ندارد و باید باور کرد که در این گرما، من نیز مستحق عفو و بخشش هستم."],[785,"کس بدین حجت چو معذورت نداشت","وز کف جلاد این دورت نداشت","هیچ‌کس با چنین دلیلی (که سوزش آتش دوزخ را توجیه کند) معذور نیست و کسی نیز از دست جلاد، این دوری را نداشت."],[785,"پس بدین داور جهان منظوم شد","حال آن عالم همت معلوم شد","پس به این ترتیب، داور جهان بر طبق نظامی دقیق و مرتب عمل می‌کند و حال آن عالم (خدا) با همت و اراده‌اش مشخص و معلوم شده است."],[786,"آن یکی می‌رفت بالای درخت","می‌فشاند آن میوه را دزدانه سخت","شخصی در حال بالا رفتن از درخت است و به‌طور مخفیانه میوه‌ای را از درخت می‌چکند."],[786,"صاحب باغ آمد و گفت ای دنی","از خدا شرمیت کو چه می‌کنی","صاحب باغ (خدا) آمد و به دنی (شخصی که میوه را دزدیده) گفت، ای انسان، از خدا شرم نمی‌کنی؟ چرا این کار را می‌کنی؟"],[786,"گفت از باغ خدا بنده خدا","گر خورد خرما که حق کردش عطا","اگر بنده‌ای از باغ خدا، که در اینجا به معنی مخلوقی است، خرما بخورد، این امر به دلیل بخشش و عطای خداوند به اوست."],[786,"عامیانه چه ملامت می‌کنی","بخل بر خوان خداوند غنی","چرا دیگران را به خاطر بخل بر سر سفره پربرکت خداوندی که بی‌نیاز است، سرزنش می‌کنی؟"],[786,"گفت ای ایبک بیاور آن رسن","تا بگویم من جواب بوالحسن","شخصی به نام ایبک را صدا می‌زند و از او می‌خواهد که طنابی (رسن) بیاورد تا به وسیله آن بتواند پاسخی به بوالحسن بدهد."],[786,"پس ببستش سخت آن دم بر درخت","می‌زد او بر پشت و ساقش چوب سخت","او را به درخت بستند و شروع به زدن او کردند؛ به گونه‌ای که چوب سختی بر پشت و پاهایش فرود می‌آمد."],[786,"گفت آخر از خدا شرمی بدار","می‌کشی این بی‌گنه را زار زار","خدا را شرم کن، چرا این بی‌گناه را به شدت می‌زنی و او را به حالت زار و نزار درآورده‌ای؟"],[786,"گفت از چوب خدا این بنده‌اش","می‌زند بر پشت دیگر بنده خوش","او می‌گوید که خداوند این بندگانش را با سختی و آزمون می‌آزماید و این آزمایش‌ها برای دیگر بندگان خیر و خوشحالی به ارمغان می‌آورد، زیرا نشانگر حکمت و قدرت الهی است."],[786,"چوب حق و پشت و پهلو آن او","من غلام و آلت فرمان او","این بیت می‌گوید که خداوند (حق) اسبابی را مانند چوب به دست دارد و آن را بر بدن بندگان (مثل پشت و پهلو) می‌زند، و من (شاعر) فقط یک بندۀ او هستم که تحت فرمانش قرار دارم."],[786,"گفت توبه کردم از جبر ای عیار","اختیارست اختیارست اختیار","می‌گوید ای ریاکار، من از جبر توبه کردم؛ اما این اختیار است که در تمام کارهایم وجود دارد."],[786,"اختیارات اختیارش هست کرد","اختیارش چون سواری زیر گرد","اختیارات او به معنای واقعی، همان اختیار خودش است، مانند اینکه یک سوارکاری که زیر گرد حرکت می‌کند، کنترل بر اسبش دارد. در واقع، آنچه را که او انتخاب کرده، را نمی‌توان به جبر نسبت داد."],[786,"اختیارش اختیار ما کند","امر شد بر اختیاری مستند","اختیار او (خدا) سبب اختیار ما می‌شود، بنابراین هر دستوری که داده می‌شود، به اختیار خود ما مربوط است."],[786,"حاکمی بر صورت بی‌اختیار","هست هر مخلوق را در اقتدار","هر مخلوقی حاکمی دارد که بر او تسلط کامل دارد و او را بی‌اختیار می‌سازد."],[786,"تا کشد بی‌اختیاری صید را","تا برد بگرفته گوش او زید را","بی‌اختیاری مانند صیادی است که شکارش را به دام می‌اندازد، و شخصی که در این حالت قرار دارد، نمی‌تواند از آن لحظه‌ها و شرایط فرار کند. به این معنا که انسان وقتی در وضعیتی بی‌اختیار قرار می‌گیرد، نمی‌تواند به راحتی از آن خارج شود."],[786,"لیک بی هیچ آلتی صنع صمد","اختیارش را کمند او کند","خداوند بدون هیچ وسیله یا ابزاری، اختیار انسان را به دام می‌اندازد و او را به مسیر خود هدایت می‌کند."],[786,"اختیارش زید را قیدش کند","بی‌سگ و بی‌دام حق صیدش کند","اختیار زید را به گونه‌ای محدود می‌کند که او مانند حیوانی بدون سگ و دام، در دام حق گرفتار می‌شود. این نشان می‌دهد که اختیار انسان قابل کنترل و تأثیرپذیرفته است."],[786,"آن دروگر حاکم چوبی بود","وآن مصور حاکم خوبی بود","در این بیت، سخن از دو نوع حاکمیت است؛ یکی حاکمیت دروگر که با چوب و به‌زور حاکم می‌شود و دیگری حاکمیت مصور که بر پایه‌ی خوبی و هنر استوار است. این تصویر به نوعی اشاره به تفاوت میان حاکمان ظالم و حاکمان عادل دارد."],[786,"هست آهنگر بر آهن قیمی","هست بنا هم بر آلت حاکمی","آهنگر بر فلز کار می‌کند و بنا هم بر ابزار خودش تسلط دارد. این بیت به اختیار و قدرت انسان در کارهای خود اشاره دارد و نشان می‌دهد که هر کسی در حرفه‌اش توانایی و کنترل دارد."],[786,"نادر این باشد که چندین اختیار","ساجد اندر اختیارش بنده‌وار","نادر است که چندین نفر به انتخاب خود به سجده بیفتند و در این حال، بندگان حاکم و اختیار او باشند."],[786,"قدرت تو بر جمادات از نبرد","کی جمادی را از آنها نفی کرد","قدرت تو بر موجودات غیرفاقد زندگی (جمادات) به معنای این نیست که آنها از وجود خود بی بهره می‌شوند. در واقع، توانایی تو در تسلط بر این موجودات هیچ‌یک از ویژگی‌های آنها را از بین نمی‌برد."],[786,"قدرتش بر اختیارات آنچنان","نفی نکند اختیاری را از آن","قدرت خداوند بر چیزهایی که اختیار دارند، به هیچ وجه موجب نمی‌شود که اختیاری از آن‌ها سلب گردد."],[786,"خواستش می‌گوی بر وجه کمال","که نباشد نسبت جبر و ضلال","خواسته او را به جایی می‌رساند که به کمال می‌رسد و بنابراین هیچ ارتباطی با جبر و گمراهی ندارد."],[786,"چونک گفتی کفر من خواست ویست","خواست خود را نیز هم می‌دان که هست","اگر تو می‌گویی که کفر من خواسته خداوند است، پس باید بدانی که خواست خودت هم وجود دارد و نمی‌توانی آن را نادیده بگیری."],[786,"زانک بی‌خواه تو خود کفر تو نیست","کفر بی‌خواهش تناقض گفتنیست","کسی که بدون خواست و اراده خود کافر شده، واقعا کافر نیست، زیرا کفر وقتی معنا دارد که به‌طور عمدی و با اراده به آن عمل شود؛ بنابراین کفر ناخواسته تناقضی است که قابل گفتن نیست."],[786,"امر عاجز را قبیحست و ذمیم","خشم بتر خاصه از رب رحیم","امر ناتوان و ضعیف، عملی زشت و ناپسند است، و به ویژه وقتی که از خداوند رحیم سر بزند، این زشتی و ناپسندی بیشتر می‌شود."],[786,"گاو گر یوغی نگیرد می‌زنند","هیچ گاوی که نپرد شد نژند","اگر گاو یوغ (کار) را به گردن نگیرد، او را تنبیه می‌کنند، زیرا هیچ گاوی که از کار طفره برود، معاف نیست و باید مجازات شود."],[786,"گاو چون معذور نبود در فضول","صاحب گاو از چه معذورست و دول","گاو نمی‌تواند بهانه‌ای برای انجام ندادن کارش داشته باشد، بنابراین صاحب گاو نیز نباید در کارهای بی‌فایده و اضافی خود بهانه‌ای داشته باشد و مسئولیت‌پذیر باشد."],[786,"چون نه‌ای رنجور سر را بر مبند","اختیارت هست بر سبلت مخند","چون رنجوری، سر خود را پنهان نکن و اختیار تو در دست خودت است، پس به سرنوشت خود بخند و ناامید نباش."],[786,"جهد کن کز جام حق یابی نوی","بی‌خود و بی‌اختیار آنگه شوی","سعی کن تا از جام حقیقت بنوشی و به حالت مستی و بی‌اختیاری برسی؛ آنگاه تو به طور کامل دگرگون خواهی شد."],[786,"آنگه آن می را بود کل اختیار","تو شوی معذور مطلق مست‌وار","اگر تو از می حقی بنوشی و به مستی و سرمستی دست یابی، در آنجا دیگر هیچ اختیاری نخواهی داشت و از مسئولیت خود معذور خواهی بود."],[786,"هرچه گویی گفته می باشد آن","هر چه روبی رفته می باشد آن","هر چیزی که می‌گویی، در واقع چیزهایی هستند که به خاطر شراب معرفت به ذهنت راه یافته‌اند و هر آنچه از تو دور می‌شود، در حقیقت نتیجه همان شراب است."],[786,"کی کند آن مست جز عدل و صواب","که ز جام حق کشیدست او شراب","مست که از جام حقیقت به مستی درآمده، چگونه می‌تواند جز عدالت و کار نیک انجام دهد؟"],[786,"جادوان فرعون را گفتند بیست","مست را پروای دست و پای نیست","جادوگران فرعون به این نتیجه رسیدند که وقتی انسان تحت تأثیر مستی و شیدایی باشد، به هیچ چیز از جمله دست و پای خود توجهی ندارد و نمی‌تواند به درستی کارهایش را انجام دهد."],[786,"دست و پای ما می آن واحدست","دست ظاهر سایه است و کاسدست","دست و پای انسان در واقع یکی هستند و فقط دست ظاهری است که سایه‌ای از آن را نشان می‌دهد و بی‌فایده است."],[787,"قول بنده ایش شاء الله کان","بهر آن نبود که تنبل کن در آن","عذرخواهی من از اینکه بگویم \"هر چه خدا بخواهد، رخ می‌دهد\" هیچ‌گاه به این معنا نیست که انسان را تنبل کند و او را از تلاش و کوشش بازدارد."],[787,"بلک تحریضست بر اخلاص و جد","که در آن خدمت فزون شو مستعد","این بیت اشاره به این دارد که این تعالیم و گفتارها، تشویق‌کننده به اخلاص و جدیت است؛ به این معنا که در خدمت به حق و انجام کارها، آمادگی و شایستگی انسان را افزایش می‌دهد."],[787,"گر بگویند آنچ می‌خواهی تو راد","کار کار تست برحسب مراد","اگر دیگران بگویند که هرچه بخواهی به تو داده می‌شود، بدان که این اتفاق تنها به دست توست و بر اساس خواسته و اراده تو خواهد بود."],[787,"آنگهان تنبل کنی جایز بود","کانچ خواهی و آنچ گویی آن شود","اگر در آن زمان تنبلی کنی، اشکالی ندارد؛ زیرا هر آنچه را که بخواهی و بگویی، واقع می‌شود."],[787,"چون بگویند ایش شاء الله کان","حکم حکم اوست مطلق جاودان","زمانی که می‌گویند «هر آن‌چه خدا بخواهد» یعنی آن حکم، حکم مطلق و جاودانی اوست."],[787,"پس چرا صد مرده اندر ورد او","بر نگردی بندگانه گرد او","چرا باید خاطرت را مشغول مردگان (کسانی که از دنیا رفته‌اند) کنی وقتی که در دعا و یاد او هستی و به او بندگی می‌کنی؟"],[787,"گر بگویند آنچ می‌خواهد وزیر","خواست آن اوست اندر دار و گیر","اگر بگویند آنچه را که وزیر می‌خواهد، در واقع همان خواسته خداوند است که در دنیا و آخرت در نظر گرفته می‌شود."],[787,"گرد او گردان شوی صد مرده زود","تا بریزد بر سرت احسان و جود","اگر به دور خداوند بچرخی، مانند صد مرده زود زنده خواهی شد، زیرا رحمت و بخشش او بر سرت نازل می‌شود."],[787,"یا گریزی از وزیر و قصر او","این نباشد جست و جوی نصر او","فرار از وزیر و کاخ او فایده‌ای ندارد و نباید به دنبال پیروزی او باشی."],[787,"بازگونه زین سخن کاهل شدی","منعکس ادراک و خاطر آمدی","اگر از این سخن غافل شوی و کاهل باشی، درک و فهم تو منعکس خواهد شد و به خوبی نخواهی رسید."],[787,"امر امر آن فلان خواجه‌ست هین","چیست یعنی با جز او کمتر نشین","امر متعلق به فلان خواجه است، پس چرا با کسی دیگر کمتر بنشینی و بگویید که او مهم‌تر از اوست؟"],[787,"گرد خواجه گرد چون امر آن اوست","کو کشد دشمن رهاند جان دوست","گرد خواجه، یعنی دور خواجه (مقصود شخص صاحب‌نفوذ است)، حضور و اطاعت از او واجب است، چرا که اگر کسی بخواهد با دشمنی در افتد، خود را به خطر می‌اندازد، در حالی که او می‌تواند جان دوست را نجات دهد."],[787,"هرچه او خواهد همان یابی یقین","یاوه کم رو خدمت او برگزین","هرچه خدا بخواهد، همان را به دست می‌آوری، پس از خواسته‌های بی‌اهمیت و بی‌اساس دوری کن و تنها خدمت به او را برگزین."],[787,"نی چو حاکم اوست گرد او مگرد","تا شوی نامه سیاه و روی زرد","اگر او حاکم است، دور او مدار و به سراغش نرو، زیرا با این کار سرنوشت تو به بدی رقم می‌خورد و چهره‌ات زشت می‌شود."],[787,"حق بود تاویل که آن گرمت کند","پر امید و چست و با شرمت کند","تعبیر درست و معنادار از حق، تو را شاداب و امیدوار می‌کند و در عین حال، تو را از شرم بر حذر نگه می‌دارد."],[787,"ور کند سستت حقیقت این بدان","هست تبدیل و نه تاویلست آن","اگر حقیقتی تو را سست کند، بدان که این به خاطر تغییر و تحول است و نه به خاطر تفسیر یا تأویل."],[787,"این برای گرم کردن آمدست","تا بگیرد ناامیدان را دو دست","اینجا به این نکته اشاره شده که این وجود و حقیقت (و یا هر چیزی که در عالم است) برای ایجاد ارتباط و امید به آن آمد است تا ناامیدان را به آغوش بگیرد و آرامش ببخشد."],[787,"معنی قرآن ز قرآن پرس و بس","وز کسی که آتش زدست اندر هوس","معنی مفهوم قرآن را از خود قرآن بپرس و از کسی که به خاطر هوس‌هایش شعله‌ای بر افروخته است."],[787,"پیش قرآن گشت قربانی و پست","تا که عین روح او قرآن شدست","انسان باید در مقابل قرآن به قدری تواضع و قربانی باشد که روح و جان او با حقیقت قرآن یکی شود. یعنی باید آنقدر در فهم و عمل به قرآن پیشرفت کند که به مقام نزدیک شدن به روح قرآن نائل آید."],[787,"روغنی کو شد فدای گل به کل","خواه روغن بوی کن خواهی تو گل","روغن که به خاطر گل فدای آن شده است، تنها به بوی خوش گل هم افتخار می‌کند؛ حال یا به خاطر خودش باشد یا به خاطر گل."],[788,"هم‌چنین تاویل قد جف القلم","بهر تحریضست بر شغل اهم","تعبیر \"قد جف القلم\" به معنای انجام نوشته‌ها و تقدیرات الهی است و این جمله به تأکید بر اهمیت تلاش و کارهای مهم در زندگی اشاره دارد. مولانا می‌گوید که این تأویل نشان‌دهنده ضرورت و تشویق به اشتغال در کارهای اصلی و مهم است."],[788,"پس قلم بنوشت که هر کار را","لایق آن هست تاثیر و جزا","پس قلم نوشت که هر عملی بر اساس شایستگی‌اش تأثیر و جزای خاص خود را دارد."],[788,"کژ روی جف القلم کژ آیدت","راستی آری سعادت زایدت","اگر به راه نادرست بروی، سرنوشت تو به انحراف خواهد رفت و تنها راستی و صداقت هستند که به تو خوشبختی می‌رسانند."],[788,"ظلم آری مدبری جف القلم","عدل آری بر خوری جف القلم","ظلم می‌کنی، اما قلم نوشته‌ است که مدبر و تدبیرکننده‌ای، و اگر عدالت برپا کنی، قلم نوشته‌ است که به تو زیان نمی‌رسد."],[788,"چون بدزدد دست شد جف القلم","خورد باده مست شد جف القلم","وقتی دست به دزدی بزند، کار نوشته‌ها پایان می‌یابد و دیگر نمی‌توان به آنها اتکاء کرد. اما وقتی کسی شراب می‌خورد و مست می‌شود، نیز به همین اندازه کار آنچه نوشته شده تمام می‌شود."],[788,"تو روا داری روا باشد که حق","هم‌چو معزول آید از حکم سبق","تو مجاز می‌دانی که در حکم الهی، حق مانند کسی که از قدرت و مقامش محروم شده، بی‌اثر شود."],[788,"که ز دست من برون رفتست کار","پیش من چندین میا چندین مزار","کارهایی که از دست من خارج شده و انجام نشده، دلیل موجهی برای ادامه نگرانیم نیست؛ در برابر این ناملایمات، دیگر به تعداد قبرها و مزارها فکر نکن."],[788,"بلک معنی آن بود جف القلم","نیست یکسان پیش من عدل و ستم","معنی این بیت این است که در عالم حقیقت و در نظر من، عدالت و ظلم یکسان نیستند و قلم تقدیر نوشته است که هیچ چیز در پیش من برابر و یکسان نیست."],[788,"فرق بنهادم میان خیر و شر","فرق بنهادم ز بد هم از بتر","من میان کارهای نیک و بد تفاوت قائل شدم و همچنین بین بد و بدتر نیز تفاوت گذاشتم."],[788,"ذره‌ای گر در تو افزونی ادب","باشد از یارت بداند فضل رب","اگر در وجود تو ذره‌ای ادب و ادب‌دوستی باشد، کسی از یاران تو به خوبی متوجه خواهد شد که این لطف و فضل از سوی پروردگار است."],[788,"قدر آن ذره ترا افزون دهد","ذره چون کوهی قدم بیرون نهد","اگر آن مقدار اندکی که در تو وجود دارد، ادب و احترام باشد، همین مقدار می‌تواند تو رابه بلندی و مقام رفیع برساند و حتی ذره‌ای که در توست می‌تواند مانند کوه، بزرگ و تاثیرگذار شود."],[788,"پادشاهی که به پیش تخت او","فرق نبود از امین و ظلم‌جو","در درگاه پادشاه، هیچ تفاوتی میان افراد با نیک و بد وجود ندارد و همگی به یک چشم دیده می‌شوند."],[788,"آنک می‌لرزد ز بیم رد او","وانک طعنه می‌زند در جد او","آن کسی که از ترس رد شدن از پیش پادشاه می‌لرزد و آن کسی که به او آسیب می‌زند، در واقع با او نسبتی خویشاوندی دارد."],[788,"فرق نبود هر دو یک باشد برش","شاه نبود خاک تیره بر سرش","چه فرقی بین هر دو (انسان‌های نیک و بد) نیست، زیرا هر دو در اصل یکسان‌اند و این نبوده که شاه باشد (از نظر مقام یا ارزش)، بلکه این خاک تیره (گناه و عیب) بر سر اوست."],[788,"ذره‌ای گر جهد تو افزون بود","در ترازوی خدا موزون بود","اگر کوچک‌ترین تلاشی از سوی تو باشد، آن تلاش در نظر خدا وزن و اهمیت دارد."],[788,"پیش این شاهان هماره جان کنی","بی‌خبر ایشان ز غدر و روشنی","در برابر این شاهان، همیشه باید جانفشانی کنی، حتی اگر آن‌ها از نیرنگ و حقیقت بی‌خبر باشند."],[788,"گفت غمازی که بد گوید ترا","ضایع آرد خدمتت را سالها","اگر کسی بدگوی و غماز باشد و از شما عیب‌جویی کند، این شخص می‌تواند سال‌ها زحمات و خدمات خوب شما را زیر سؤال ببرد و بی‌اعتبار کند."],[788,"پیش شاهی که سمیعست و بصیر","گفت غمازان نباشد جای‌گیر","پیش شاهی که شنوا و بیناست، جای غمازانی که بدگویند، نیست."],[788,"جمله غمازان ازو آیس شوند","سوی ما آیند و افزایند پند","غمازان که کسانی هستند که از بیان ناپسند و غیبت پرهیز می‌کنند، از او ناامید خواهند شد و به سوی ما می‌آیند تا پند و اندرز بیشتری بدهند."],[788,"بس جفا گویند شه را پیش ما","که برو جف القلم کم کن وفا","بسیاری از مردم درباره شه (شاه) به ما می‌گویند که به او جفا روا داریم، اما بگو که در برابر این سخنان وفا و محبت را کم کن."],[788,"معنی جف القلم کی آن بود","که جفاها با وفا یکسان بود","این به این معناست که قلم الهی نوشته است که جفا (بدی) و وفا (نیکی) از نظر پاداش‌های الهی یکسان هستند، یعنی هیچ‌کدام بر دیگری برتری ندارد."],[788,"بل جفا را هم جفا جف القلم","وآن وفا را هم وفا جف القلم","در اینجا مولانا بیان می‌کند که حتی بدی‌ها و بی‌وفایی‌ها نیز به نوعی به ثبت رسیده و با همدیگر برابرند، و همچنین رفتارهای خوب و وفاداری‌ها هم همین طور. به عبارتی، همه‌ی اعمال انسانی، چه خوب و چه بد، در سرنوشت و قضا ثبت شده و از نظر حقیقت یکسان هستند."],[788,"عفو باشد لیک کو فر امید","که بود بنده ز تقوی روسپید","اگر عفو و بخشش وجود داشته باشد، اما امیدی به آن نباشد، چه فایده‌ای دارد؟ زیرا انسان مؤمن، که ترس از خداوند را دارد، با تقوا و پرهیزکاری خود محترم و روسفید خواهد بود."],[788,"دزد را گر عفو باشد جان برد","کی وزیر و خازن مخزن شود","اگر برای دزد هم عفوی باشد، او جان خود را می‌برد، اما آیا ممکن است که او وزیر و خزانه‌دار (خازن) گنجینه شود؟"],[788,"ای امین الدین ربانی بیا","کز امانت رست هر تاج و لوا","ای کسی که به دین و امانت الهی وفاداری، بیایید که از هر تاج و پرچمی، به امانت و نقش خود رهایی یافته‌اید."],[788,"پور سلطان گر برو خاین شود","آن سرش از تن بدان باین شود","اگر پسر سلطان خیانت کند، به زودی سرش از بدن جدا خواهد شد."],[788,"وز غلامی هندوی آرد وفا","دولت او را می‌زند طال بقا","غلام هندی اگر وفاداری کند، موجب می‌شود که دولت او پایدار شود و به او سعادتی می‌رسد."],[788,"چه غلام ار بر دری سگ باوفاست","در دل سالار او را صد رضاست","هرچقدر هم که غلامی در برابر در سالاری مانند سگ وفادار و مطیع باشد، در درون دل سالار، او را در نزد خود جمعی از رضایت و احترام نمی‌داند."],[788,"زین چو سگ را بوسه بر پوزش دهد","گر بود شیری چه پیروزش کند","اگر کسی مانند سگ وفادار به دیگری بوسه زند، حال اگر آن فرد از نسل شیر باشد (شجاع و قدرتمند)، او چه پیروزی می‌تواند به دست آورد؟ این بیت به وفاداری و ارادت شخص به کسی حتی اگر آن شخص قدرتمند باشد، اشاره دارد."],[788,"جز مگر دزدی که خدمتها کند","صدق او بیخ جفا را بر کند","تنها دزدی که خدمت به دیگران می‌کند، صداقت او باعث می‌شود که آسیب‌ها و بدی‌ها را از ریشه برکند."],[788,"چون فضیل ره‌زنی کو راست باخت","زانک ده مرده به سوی توبه تاخت","چون فضیل، مرد راستینی که دزدیده شده است، پس از آن که به بی‌راهه رفت، به سمت توبه و اصلاح گام برداشت و ده نفر را به همراه خود به این مسیر هدایت کرد."],[788,"وآنچنان که ساحران فرعون را","رو سیه کردند از صبر و وفا","ساحران فرعون به دلیل صبر و وفای خود، به افتخار و مقام رسیدند و همچنین بر اوضاع دشوار غلبه کردند."],[788,"دست و پا دادند در جرم قود","آن به صد ساله عبادت کی شود","اگر کسی مدت طولانی عبادت کرده باشد و در عین حال مرتکب گناه یا جرم شود، این عبادت نمی‌تواند او را از عواقب گناه نجات دهد."],[788,"تو که پنجه سال خدمت کرده‌ای","کی چنین صدقی به دست آورده‌ای","تو که پنجاه سال است در خدمت بوده‌ای، چگونه می‌کوشی که به چنین صداقتی برسید؟"],[789,"آن یکی گستاخ رو اندر هری","چون بدیدی او غلام مهتری","گستاخی از هری (شهری در ایران) که در آنجا مردی با مقام و شأن بالا را دیده بود، شگفت‌زده می‌شود که چگونه او غلام یک شخص دیگر است."],[789,"جامه اطلس کمر زرین روان","روی کردی سوی قبله آسمان","درویش در حالی که لباس‌های گرانبها و زرق و برقی به تن دارد، به سمت آسمان نگاه می‌کند و دعا می‌کند."],[789,"کای خدا زین خواجه صاحب منن","چون نیاموزی تو بنده داشتن","ای خدا، از این خواجه بزرگ و صاحب نعمت چرا تو به من یاد نمی‌دهی که چگونه بنده داشته باشم؟"],[789,"بنده پروردن بیاموز ای خدا","زین رئیس و اختیار شاه ما","خداوند، تو کمک کن تا هنر و توانایی پرورش بندگان و خدمتگزاران را از این رئیس و شاه ما یاد بگیرم."],[789,"بود محتاج و برهنه و بی‌نوا","در زمستان لرز لرزان از هوا","در این بیت، شاعر وضعیتی را توصیف می‌کند که شخصی نیازمند و بی‌پوشش در سرمای زمستان در حال لرزش است. او بی‌پناه و در مضیقه است و از سختی شرایط رنج می‌برد."],[789,"انبساطی کرد آن از خود بری","جراتی بنمود او از لمتری","درویش، از خود رها و آزاد شده، احساس خوشحالی می‌کند و جرأت نشان می‌دهد که از مقام و وضعیت خود فراتر رفته است."],[789,"اعتمادش بر هزاران موهبت","که ندیم حق شد اهل معرفت","اعتماد او به هزاران نعمت و برکت است که از طرف حق به او رسیده و این افراد اهل شناخت و معرفت هستند."],[789,"گر ندیم شاه گستاخی کند","تو مکن آنک نداری آن سند","اگر ندیم شاه (دوست و دربار است) جسارت و جسارتی از خود نشان دهد، تو نباید چنین کنی، زیرا تو مقام و اعتبار لازم را برای این کار نداری."],[789,"حق میان داد و میان به از کمر","گر کسی تاجی دهد او داد سر","عدالت از داده‌های دنیوی و ظاهر بهتر و بالاتر است. اگر کسی به دیگری مقام و ثروتی بدهد، فقط به ظاهر است، اما حق و عدالت از عمق وجود و ارزش‌های واقعی سرچشمه می‌گیرد."],[789,"تا یکی روزی که شاه آن خواجه را","متهم کرد و ببستش دست و پا","روزی شاه خواجه را به اتهامی متهم کرده و او را دستگیر و تحت کنترل قرار داد."],[789,"آن غلامان را شکنجه می‌نمود","که دفینه خواجه بنمایید زود","غلامان (زیر دستان) را عذاب و شکنجه می‌کرد تا سریعا مال و گنج خواجه را نشان دهند."],[789,"سر او با من بگویید ای خسان","ورنه برم از شما حلق و لسان","بگویید سر او کجاست، ای بی‌خودان! وگرنه من از شما زبان و گردن می‌برم."],[789,"مدت یک ماهشان تعذیب کرد","روز و شب اشکنجه و افشار و درد","مدت یک ماه آن درویش آنها را مورد آزار و شکنجه قرار داد و شب و روز تحت فشار و درد نگه داشت."],[789,"پاره پاره کردشان و یک غلام","راز خواجه وا نگفت از اهتمام","او (عمید خراسان) آن‌ها را به شدت تنبیه کرد و در میان آن‌ها هیچ یک از غلامانش راز خواجه (سروان یا صاحب‌منصبی خاص) را فاش نکردند و این نشان‌دهنده توجه و وفاداری آن‌ها به صاحب‌منصبی خود است."],[789,"گفتش اندر خواب هاتف کای کیا","بنده بودن هم بیاموز و بیا","هاتف در خواب به او گفت: ای پادشاه، یاد بگیر که چگونه بندگی کردن را باید آموخت و این را هم به دیگران یاد بده."],[789,"ای دریده پوستین یوسفان","گر بدرد گرگت آن از خویش دان","ای کسی که پوستین یوسف (که به عنوان نماد زیبایی و مقام است) را دریده‌ای، اگر گرگ تو را بدرد، بدان که آن مورد از جانب خودت است."],[789,"زانک می‌بافی همه‌ساله بپوش","زانک می‌کاری همه ساله بنوش","تو به خاطر این که همیشه در حال بافتن هستی، باید بپوشی و به خاطر این که همیشه در حال کاشتن هستی، باید بنوشی."],[789,"فعل تست این غصه‌های دم به دم","این بود معنی قد جف القلم","فعل تست (شاید به معنای «تو هستی») بیانگر این است که تو (یا انسان‌ها) هر لحظه با غصه‌ها و دردهای جدیدی روبه‌رو می‌شوی. این به این معنی است که سرنوشت و تقدیر ما نوشته شده و قلم تقدیر در حال ثبت این غصه‌هاست."],[789,"که نگردد سنت ما از رشد","نیک را نیکی بود بد راست بد","از رشد صحیح و خوب، هیچ‌گاه سنت ما نمی‌کاهد؛ نیکی همیشه نیکی است و بدی هم همیشه بدی خواهد ماند."],[789,"کار کن هین که سلیمان زنده است","تا تو دیوی تیغ او برنده است","به کار پرداز، زیرا که سلیمان هنوز زنده است و تا زمانی که او زنده است، قدرتش مانند تیغی برنده بر دستان توست و می‌تواند بر مشکلات پیروز شوی."],[789,"چون فرشته گشته از تیغ آمنیست","از سلیمان هیچ او را خوف نیست","هرگاه انسان به وسیله‌ی تیغ حکم سلیمان به موجوداتی مانند دیوها مسلط شود و در این حالت، به قدری قوی و مطمئن شود که هیچ ترسی از سلیمان نداشته باشد، انگار که به مرتبه‌ای فرشته‌گون رسیده است."],[789,"حکم او بر دیو باشد نه ملک","رنج در خاکست نه فوق فلک","حکم خدا بر دیوان است، نه بر انسان‌های ملکی؛ پس رنج و درد فقط در این دنیای خاکی وجود دارد و نه در عوالم بالا."],[789,"ترک کن این جبر را که بس تهیست","تا بدانی سر سر جبر چیست","جبر را رها کن زیرا خالی و بی‌محتواست تا متوجه شوی حقیقت جبر چیست و راز آن را بشناسی."],[789,"ترک کن این جبر جمع منبلان","تا خبر یابی از آن جبر چو جان","این شعر به ما می‌گوید که باید از جبر و محدودیت‌های جمعی دور شویم تا بتوانیم به حقیقت جبر و سرنوشت پی ببریم. به عبارتی، فقط با رهایی از قیدهای اجتماعی و جمعی می‌توانیم به عمق وجود و معنای زندگی دست یابیم."],[789,"ترک معشوقی کن و کن عاشقی","ای گمان برده که خوب و فایقی","عشق و محبت به معشوق را رها کن و به سوی عشق حقیقی برو، ای کسی که به خود این را نسبت داده‌ای که خوب و شایسته‌ای."],[789,"ای که در معنی ز شب خامش‌تری","گفت خود را چند جویی مشتری","ای کسی که در معنای حقیقی و درک عمیق، از شب هم سکوت و خاموشی بیشتری داری، چرا همچنان به دنبال جلب نظر دیگران و تأیید آن‌ها هستی؟"],[789,"سر بجنبانند پیشت بهر تو","رفت در سودای ایشان دهر تو","این بیت به این معنی است که افرادی به خاطر تو و تحت تأثیر تو به حرکت در می‌آیند و در واقع دنیای تو به خاطر آرزوی آنها می‌چرخد."],[789,"تو مرا گویی حسد اندر مپیچ","چه حسد آرد کسی از فوت هیچ","تو به من می‌گویی که حسد را در خودت به هم نپیچان، چرا که کسی به خاطر از دست دادن چیزی خود را دچار حسد نمی‌کند."],[789,"هست تعلیم خسان ای چشم‌شوخ","هم‌چو نقش خرد کردن بر کلوخ","تعلیم دادن به نادانان و افراد بی‌خبر، مانند حکاکی نقش بر روی سنگ است؛ زیرا تلاش برای آموزش به کسانی که درک نمی‌کنند، نتیجه‌ای ندارد و سختی‌هایی به دنبال دارد."],[789,"خویش را تعلیم کن عشق و نظر","که آن بود چون نقش فی جرم الحجر","خود را به یادگیری عشق و بینش وادار کن، زیرا عشق و نظر مانند نقش و نگاری است که بر روی سنگ می‌ماند و تأثیر عمیقی بر روح دارد."],[789,"نفس تو با تست شاگرد وفا","غیر فانی شد کجا جویی کجا","نفس تو، که همان نفس خودت است، با توست و وفادار به تو، اما این نفس فانی و ناپایدار شده است. بنابراین، کجا می‌خواهی آن را جستجو کنی یا چه جایی را در نظر داری؟"],[789,"تا کنی مر غیر را حبر و سنی","خویش را بدخو و خالی می‌کنی","اگر بخواهی دیگران را عالم و فاضل را بشناسی، در واقع خود را بدخوی و خالی می‌کنی."],[789,"متصل چون شد دلت با آن عدن","هین بگو مهراس از خالی شدن","اگر دل تو به بهشت متصل شود، نترس که از چیزهای دیگر خالی می‌مانی."],[789,"امر قل زین آمدش کای راستین","کم نخواهد شد بگو دریاست این","امر یا دستوری که به او داده شده، به او می‌گوید که این حقیقت را بگوید که اگرچه او چیز کم‌تری دارد، اما در حقیقت غنی و بی‌نهایت است؛ مانند دریا که قابل تصور نیست و هیچ چیزی نمی‌تواند آن را کاهش دهد."],[789,"انصتوا یعنی که آبت را بلاغ","هین تلف کم کن که لب‌خشکست باغ","شاعر می‌گوید ساکت باشید و به سخن من گوش دهید، زیرا آب شما کم شده است و اگر به اندازه کافی حواس‌جمع نباشید، ممکن است باغ شما بخاطر خشکی لب‌ها کم آب شود."],[789,"این سخن پایان ندارد ای پدر","این سخن را ترک کن پایان نگر","این موضوع به قدری عمیق و گسترده است که نهایتی برای آن نمی‌توان تصور کرد، ای پدر. بهتر است که از ادامه این بحث دست برداری و به انتها و نتیجه آن بیندیشی."],[789,"غیرتم آید که پیشت بیستند","بر تو می‌خندند عاشق نیستند","افتخار و غیرت من اجازه نمی‌دهد که کسانی که به تو نزدیکند، به تو تمسخر کنند و عاشق تو نباشند."],[789,"عاشقانت در پس پرده کرم","بهر تو نعره‌زنان بین دم بدم","عاشقانت پشت پرده‌ رحمت و بخشش تو، به‌طور مداوم و پیوسته ندا می‌دهند و در حال دعا و درخواست‌اند."],[789,"عاشق آن عاشقان غیب باش","عاشقان پنج روزه کم تراش","عاشق واقعی، عاشقانی است که از عالم غیبت و ناچیزی خود را جدا کرده‌اند، زیرا عاشقانی که صرفا به عشق‌های دنیوی و موقتی پرداخته‌اند، ارزش کمتری دارند."],[789,"که بخوردندت ز خدعه و جذبه‌ای","سالها زیشان ندیدی حبه‌ای","چند سالی است که به خاطر فریب و جاذبه‌ای که این افراد داشته‌اند، تو از آن‌ها یک دانه هم نمی‌توانی ببینی و بهره‌ای نمی‌گیری."],[789,"چند هنگامه نهی بر راه عام","گام خستی بر نیامد هیچ کام","چندین بار که در مسیر عموم مردم با تردید و ناپایداری گام برداشتی، هیچ موفقیتی نصیبت نشد."],[789,"وقت صحت جمله یارند و حریف","وقت درد و غم به جز حق کو الیف","در زمان سلامتی، همه دوستان و همراهان در کنار انسان هستند، اما در زمان درد و غم، تنها کسی که انسان را کمک می‌کند، خداوند است."],[789,"وقت درد چشم و دندان هیچ کس","دست تو گیرد به جز فریاد رس","در زمان سختی و درد، هیچ‌کس جز خدا به کمک انسان نمی‌آید و فقط فریاد رس واقعی، اوست که می‌تواند به درد و مشکل او رسیدگی کند."],[789,"پس همان درد و مرض را یاد دار","چون ایاز از پوستین کن اعتبار","درد و بیماری را همیشه به یاد داشته باش، زیرا مانند ایاز (غلام معروف) از پوستینی که به تن دارد، اعتبار و ارزش او در سایه آن درد و رنج است."],[789,"پوستین آن حالت درد توست","که گرفتست آن ایاز آن را به دست","پوستین، حالتی است که درد تو را نشان می‌دهد و ایاز (غلام معروف نادر) آن را در دست دارد. این اشاره به این دارد که درد و رنج تو خود را به صورت عینی نشان می‌دهد، همان‌طور که ایاز در پی‌اش است."],[790,"کافر جبری جواب آغاز کرد","که از آن حیران شد آن منطیق مرد","کافر جبری (کافری که به جبر اعتقاد دارد) آغاز به صحبت کرد و جواب‌هایی داد که مرد منطقی از حیرت در آن فرو رفت."],[790,"لیک گر من آن جوابات و سؤال","جمله را گویم بمانم زین مقال","اگر من بخواهم تمام جواب‌ها و سؤال‌ها را بگویم، در این بحث طولانی می‌مانم و نمی‌توانم آن را به پایان برسانم."],[790,"زان مهم‌تر گفتنیها هستمان","که بدان فهم تو به یابد نشان","بسیاری از نکات مهم‌تر از آنچه گفته شد وجود دارد که با درک آن‌ها می‌توانی به روشنی بیشتری برسی."],[790,"اندکی گفتیم زان بحث ای عتل","ز اندکی پیدا بود قانون کل","اندکی که در مورد این بحث گفتیم، نشان‌دهنده یک اصول کلی و جامع است که از همین مقدار گفتار قابل دریافت است."],[790,"هم‌چنین بحثست تا حشر بشر","در میان جبری و اهل قدر","بحث همچنان ادامه دارد تا روز قیامت، و این در مورد جبرگرایان و کسانی است که به آزادی اراده (اهل قدر) اعتقاد دارند."],[790,"گر فرو ماندی ز دفع خصم خویش","مذهب ایشان بر افتادی ز پیش","اگر نتوانی از دشمن خود دفاع کنی، به ناچار پیرو مذهب آن‌ها خواهی شد و از اعتقاد خود عقب‌نشینی خواهی کرد."],[790,"چون برون‌شوشان نبودی در جواب","پس رمیدندی از آن راه تباب","زمانی که توانایی پاسخ دادن به آن‌ها را نداشتی، از آن مسیر پرخطر و دشوار عقب‌نشینی کردی و از در جواب دادن دور شدی."],[790,"چونک مقضی بد دوام آن روش","می‌دهدشان از دلایل پرورش","این بیت اشاره به این دارد که وقتی یک روش یا طریقه‌ای پایدار و ماندگار شود، دلایل و شواهدی که موجب رشد و پرورش آن می‌شوند نیز به آن روش تداوم می‌بخشند. به عبارت دیگر، ثبات در عقیده یا روش باعث می‌شود که دلایل و عوامل حمایتی آن نیز باقی بمانند."],[790,"تا نگردد ملزم از اشکال خصم","تا بود محجوب از اقبال خصم","تا زمانی که فرد ملزم به پاسخ‌گویی به اشکالات حریف نشود، او از موفقیت و سعادت غافل خواهد ماند."],[790,"تا که این هفتاد و دو ملت مدام","در جهان ماند الی یوم القیام","تا زمانی که این هفتاد و دو ملت (مذهبی و قومیتی) در جهان وجود دارند، این وضع و مناظره و اختلافات ادامه خواهد داشت تا روز قیامت."],[790,"چون جهان ظلمتست و غیب این","از برای سایه می‌باید زمین","جهان، به سبب ظلمت خود، به غیبت می‌رسد و برای وجود سایه، به زمین نیاز دارد. در واقع، سایه نمایانگر وجودی است که به خاطر ظلمت وجود دارد."],[790,"تا قیامت ماند این هفتاد و دو","کم نیاید مبتدع را گفت و گو","این که هفتاد و دو گروه مختلف در دین و عقیده وجود دارد، تا روز قیامت ادامه خواهد داشت و هیچ‌گونه گفتمانی با مبتدع (کسی که عقاید جدید و نادرست را ابداع می‌کند) به سرانجام نخواهد رسید."],[790,"عزت مخزن بود اندر بها","که برو بسیار باشد قفلها","عزت و شرافت در وجود انسان مانند مخزنی با ارزش است که برای دسترسی به آن، قفل‌های زیادی وجود دارد. این قفل‌ها نماد موانع و دشواری‌هایی هستند که برای دستیابی به عزت باید بر آن‌ها غلبه کرد."],[790,"عزت مقصد بود ای ممتحن","پیچ پیچ راه و عقبه و راه‌زن","عزت و بزرگی به هدفی که باید به آن رسید وابسته است، ای آزمون‌کننده؛ هرچند راه‌ها پیچیده و دشوار باشد و در مسیر دزدان و خطرات بسیاری وجود داشته باشد."],[790,"عزت کعبه بود و آن نادیه","ره‌زنی اعراب و طول بادیه","عزت و مقام کعبه (مکه) است، و آن ندا کننده (که ممکن است به اعراب اشاره کند) باعث می‌شود که راه‌زنی و مشکلات در بیابان وجود داشته باشد."],[790,"هر روش هر ره که آن محمود نیست","عقبه‌ای و مانعی و ره‌زنیست","هر روشی که به حقیقت و خوبی منتهی نشود، مانند یک مانع یا کار خیانت‌آمیز است و در واقع به مقصد نمی‌رسد."],[790,"این روش خصم و حقود آن شده","تا مقلد در دو ره حیران شده","این روش، که خصم و دشمنی بر آن حاکم است، باعث شده تا مقلد در دو مسیر گمراه و سردرگم شود."],[790,"صدق هر دو ضد ببیند در روش","هر فریقی در ره خود خوش منش","هر طرف در مناظره، برای خود بر این باور است که راست می‌گوید و هر کدام سعی می‌کنند صدق و حق را در رویکرد خود ببینند و به نوعی در مسیر خود خوش‌منش و خوش‌رفتار هستند."],[790,"گر جوابش نیست می‌بندد ستیز","بر همان دم تا به روز رستخیز","اگر نتوانی به او جواب بدهی، در همان لحظه گفتگو را قطع می‌کند تا روز قیامت."],[790,"که مهان ما بدانند این جواب","گرچه از ما شد نهان وجه صواب","مهمانان ما باید بدانند که هرچند این پاسخ از ما پنهان است، اما حقیقت و درست بودن آن مشخص است."],[790,"پوزبند وسوسه عشقست و بس","ورنه کی وسواس را بستست کس","عشق تنها عامل مهار وسوسه‌ها است وگرنه هیچ‌کس قادر به کنترل وسوسه‌ها نیست."],[790,"عاشقی شو شاهد خوبی بجو","صید مرغابی همی‌کن جو بجو","عاشق شو و به دنبال زیبایی‌ها بگرد، مانند کسی که در جستجوی شکار مرغابی است و همه‌چیز را برای دستیابی به آن جستجو می‌کند."],[790,"کی بری زان آب کان آبت برد","کی کنی زان فهم فهمت را خورد","وقتی از آب زلال و پاکیزه دور شوی، در حقیقت خود را از فهم و درک واقعی باز می‌داری که آن درک حقیقت تو را می‌نوشد و رشد می‌دهد."],[790,"غیر این معقولها معقولها","یابی اندر عشق با فر و بها","علاوه بر این عقل‌ها، در عشق معانی و درک‌های بالاتری پیدا می‌شود که ارزش و عظمت زیادی دارد."],[790,"غیر این عقل تو حق را عقلهاست","که بدان تدبیر اسباب سماست","غیر از این عقل تو، عقل‌های واقعی وجود دارند که به مدد آنها می‌توان به درک و فهم حقیقت و نظام عالم نایل شد."],[790,"که بدین عقل آوری ارزاق را","زان دگر مفرش کنی اطباق را","با این عقل نمی‌توانی روزی‌ها را به دست بیاوری و اگر به این عقل تکیه کنی، به زودی می‌بینی که مجبور به دوری از آن می‌شوی."],[790,"چون ببازی عقل در عشق صمد","عشر امثالت دهد یا هفت‌صد","وقتی که عقل را در عشق الهی ببازی، ده یا حتی هفتصد مثال و نمونه از آن دریافت می‌کنی."],[790,"آن زنان چون عقلها درباختند","بر رواق عشق یوسف تاختند","زنان وقتی عقل‌های خود را در عشق باختند، به سوی زیبایی و محبت یوسف شتافتند."],[790,"عقلشان یک‌دم ستد ساقی عمر","سیر گشتند از خرد باقی عمر","زنان، وقتی که عقل‌شان را در عشق یوسف باختند، مدتی از عقل خود بی‌خبر شدند و از آن پس، عمرشان را از درک خرد و نزاکت روی برگرداندند و در پی سیر و سلوک عشق رفتند."],[790,"اصل صد یوسف جمال ذوالجلال","ای کم از زن شو فدای آن جمال","حضور زیبایی و جمال واقعی که در وجود خداوند است، بسیار عظیم و بی‌نظیر است؛ بنابراین، تو که به خاطر زیبایی ظاهری زنان، خود را فدای آن‌ها می‌کنی، کمتر از آن‌ها نیستی."],[790,"عشق برد بحث را ای جان و بس","کو ز گفت و گو شود فریاد رس","عشق است که می‌تواند بحث و جدل را به نتیجه برساند و فقط عشق است که در این زمینه می‌تواند فریادرس و کمککار باشد."],[790,"حیرتی آید ز عشق آن نطق را","زهره نبود که کند او ماجرا","عشق آن‌قدر شگفت‌انگیز و عمیق است که جرأت بیان و شرح آن را ندارد؛ به‌طوری‌که شخص از بیان آن ناتوان می‌شود و نمی‌تواند ماجرای عشق را بازگو کند."],[790,"که بترسد گر جوابی وا دهد","گوهری از لنج او بیرون فتد","اگر بخواهد که به سخن کسی پاسخ بدهد، باید بترسد که از دل او حقیقتی والا و گرانبها بیرون بیفتد."],[790,"لب ببندد سخت او از خیر و شر","تا نباید کز دهان افتد گهر","او باید سکوت کند و از خوبی‌ها و بدی‌ها چیزی نگوید، زیرا ممکن است از دهانش چیزی ارزشمند بیرون بیفتد."],[790,"هم‌چنانک گفت آن یار رسول","چون نبی بر خواندی بر ما فصول","همان‌طور که آن دوست پیامبر گفت، تو هم مانند نبی، فصول و مباحث مختلف را برای ما مطرح کردی."],[790,"آن رسول مجتبی وقت نثار","خواستی از ما حضور و صد وقار","در زمانی که پیامبر مجتبی (حضرت علی) به ما نیاز داشت، خواستار حضور و احترام ما بود."],[790,"آنچنان که بر سرت مرغی بود","کز فواتش جان تو لرزان شود","اگر مرغی بر سر تو باشد، جان تو به خاطر از دست رفتن آن مرغ به شدت می‌لرزد. این بیان نشان‌دهنده اهمیت و وابستگی عمیق انسان‌ها به چیزهایی است که برایشان عزیز و ارزشمند است."],[790,"پس نیاری هیچ جنبیدن ز جا","تا نگیرد مرغ خوب تو هوا","تو هیچ حرکتی از جای خود نکن که مبادا پرنده محبوبت از دست برود و به آسمان برود."],[790,"دم نیاری زد ببندی سرفه را","تا نباید که بپرد آن هما","نباید دم بزنید و سرفه را کنترل کنید، زیرا اگر این کار را بکنید، آن پرنده خوب (هما) از شما دور می‌شود."],[790,"ور کست شیرین بگوید یا ترش","بر لب انگشتی نهی یعنی خمش","اگر کسی شیرین یا تلخ بگوید، به این معنا نیست که با دست خود به دندانش اشاره می‌کند و او را خاموش می‌کند."],[790,"حیرت آن مرغست خاموشت کند","بر نهد سردیگ و پر جوشت کند","حیرت آن مرغ خاموش می‌شود وقتی که می‌بیند بر روی دیگ سرد، آب جوشان می‌ریزد. در واقع، او از این تضاد و تغییر شرایط شگفت‌زده می‌شود."],[791,"ای ایاز این مهرها بر چارقی","چیست آخر هم‌چو بر بت عاشقی","ای ایاز، این مهرها که به چارق (کفش یا پوشاکی که از پوست یا چرم ساخته شده) بسته‌ای چیست؟ در واقع، تو مانند عاشقانی هستی که به بت معشوق خود مهر می‌ورزند."],[791,"هم‌چو مجنون از رخ لیلی خویش","کرده‌ای تو چارقی را دین و کیش","تو مانند مجنون که به خاطر معشوقش (لیلی) دل بسته و مجنون شده، از روی خویش به این چارق (پوشش)، اعتقادی چون دین و مذهب پیدا کرده‌ای."],[791,"با دو کهنه مهر جان آمیخته","هر دو را در حجره‌ای آویخته","ایاز با دو منبع عشق و محبت، که هر دو به شدت با جانش مرتبط هستند، آن‌ها را در یک مکان نگه‌داری می‌کند."],[791,"چند گویی با دو کهنه نو سخن","در جمادی می‌دمی سر کهن","چند بار می‌خواهی با دو چیز کهنه و ناچیز صحبت کنی و خصلت‌های قدیمی را به آن‌ها نسبت بدهی، در حالی که در اصل، آن‌ها چیز غیرزنده‌ای هستند و زندگی و شرافتی ندارند؟"],[791,"چون عرب با ربع و اطلال ای ایاز","می‌کشی از عشق گفت خود دراز","عرب‌ها به زیبایی و شکوه معشوق و خرابه‌های آثار قدیمی عشق می‌ورزند، ای ایاز! تو نیز در عشق همچون آن‌ها سخن طولانی و عمیق بگو."],[791,"چارقت ربع کدامین آصفست","پوستین گویی که کرته یوسفست","ایاز، کدامین لباس را می‌پوشی که مانند چارق (نوعی کفش محلی) و پوستینی که بر تن داری، مشابه لباس پادشاه آصف است؟ آیا این پوستینی که بر تن داری، به زیبایی کرتۀ یوسف نیست؟"],[791,"هم‌چو ترسا که شمارد با کشش","جرم یکساله زنا و غل و غش","شخصی مانند یک ترسا (کسی که به دین مسیحیت گرایش دارد) که تمام گناهان یک ساله‌اش، مانند زنا و فریبکاری، را به خاطر یک کشش و تمایل غیرقابل کنترل فراموش می‌کند و نادیده می‌گیرد."],[791,"تا بیامرزد کشش زو آن گناه","عفو او را عفو داند از اله","اگر عشق و ایمان وجود داشته باشد، خداوند با نظر رحمت به گناهان ورای آنها می‌نگرد و آنها را می‌بخشد."],[791,"نیست آگه آن کشش از جرم و داد","لیک بس جادوست عشق و اعتقاد","این کشش (عشق و تمایل) از میزان گناه و بخشش خبر ندارد، اما جادو و قدرتش در عشق و اعتقاد بسیار زیاد است."],[791,"دوستی و وهم صد یوسف تند","اسحر از هاروت و ماروتست خود","دوستی و خیال، از نعمت‌های بزرگ و سریع مانند یوسف (پسر یعقوب) است که ناشی از جادوگری هاروت و ماروت (دو فرشته) است. منظور از هاروت و ماروت در اینجا نیروهایی است که ممکن است ما را به وسوسه و اشتباه بیندازند."],[791,"صورتی پیدا کند بر یاد او","جذب صورت آردت در گفت و گو","اگر به یاد او بیفتی، چهره‌ای در ذهنت شکل می‌گیرد که در هنگام صحبت و گفتگو، تو را به خود جذب می‌کند."],[791,"راز گویی پیش صورت صد هزار","آن چنان که یار گوید پیش یار","رازها را باید با آن‌که محبوب و عزیز است، در میان گذاشت، مانند گفت‌وگویی که یار با یار دارد."],[791,"نه بدانجا صورتی نه هیکلی","زاده از وی صد الست و صد بلی","در آن عالم نه به شکل و صورت مشخصی و نه به هیکلی آفریده شده، بلکه از آن حقیقت مطلق (که به صدای «هست» می‌خوانند) چیزی وجود دارد که فقط در آن عالم می‌توان به آن دست یافت."],[791,"آن چنان که مادری دل‌برده‌ای","پیش گور بچه نومرده‌ای","این بیت به رابطه عاطفی عمیق مادر با فرزندش اشاره دارد؛ مثل مادری که پس از مرگ فرزندش در کنار گور او دلتنگ و افسرده است. این احساس حاکی از غم و وابستگی عاطفی شدید است."],[791,"رازها گوید به جد و اجتهاد","می‌نماید زنده او را آن جماد","رازها را می‌تواند با دقت و صراحت بیان کند، اما آنچه که آن جسم بی‌جان (جماد) از خود نشان می‌دهد، به زنده بودن او اشاره دارد."],[791,"حی و قایم داند او آن خاک را","چشم و گوشی داند او خاشاک را","او (ایاز) می‌داند که آن خاک (مرده) زنده است و می‌تواند با چشم و گوش خود، خاشاک (چیزی بی‌ارزش و کوچک) را نیز درک کند."],[791,"پیش او هر ذره آن خاک گور","گوش دارد هوش دارد وقت شور","هر ذره از خاک گور، نزد او (خدا) دارای گوش و هوش است و در زمان شور و هیجان، به خوبی آگاه است."],[791,"مستمع داند به جد آن خاک را","خوش نگر این عشق ساحرناک را","شنونده باید به خوبی بداند که این خاک (گور) از نظر جدی و با دقت نگریسته شود، زیرا این عشق، جاذبه و سحر خاصی دارد."],[791,"آنچنان بر خاک گور تازه او","دم‌بدم خوش می‌نهد با اشک رو","او هر لحظه با اشک‌هایش بر خاک تازه گور می‌نهد، به‌گونه‌ای که گویی بر آن خاک عشق می‌ورزد."],[791,"که بوقت زندگی هرگز چنان","روی ننهادست بر پور چو جان","در زمان حیات هرگز چنین غمگین و ناراحت بر فرزندش مانند جانش ننشسته و نگریسته است."],[791,"از عزا چون چند روزی بگذرد","آتش آن عشق او ساکن شود","چند روزی که از عزای عشق بگذرد، شعله‌ی آن عشق آرام خواهد گرفت و دیگر به شدت اولیه نخواهد بود."],[791,"عشق بر مرده نباشد پایدار","عشق را بر حی جان‌افزای دار","عشق نمی‌تواند به مرده دوام بیاورد و پایدار باشد؛ این عشق باید بر موجود زنده‌ای که جان دارد، قوت بگیرد و رشد کند."],[791,"بعد از آن زان گور خود خواب آیدش","از جمادی هم جمادی زایدش","بعد از مرگ، او خواب‌هایی از گور خود می‌بیند و از حالت بی‌حالی (جمادی) به وجودی جدید (جمادی دیگر) می‌رسد."],[791,"زانک عشق افسون خود بربود و رفت","ماند خاکستر چو آتش رفت تفت","عشق مانند جادو اثر خود را بر روی فرد می‌گذارد و او را از واقعیت‌های دنیای مادی دور می‌کند. هنگامی که عشق از بین برود، تنها چیزی که باقی می‌ماند، مانند خاکستر آتش است که بعد از خاموش شدنش باقی می‌ماند."],[791,"آنچ بیند آن جوان در آینه","پیر اندر خشت می‌بیند همه","آنچه جوان در آینه می‌بیند، پیر در خشت می‌بیند؛ یعنی آنچه که جوان از عشق و زیبایی می‌بیند، پیر به شکل زشت و بی‌پروایی می‌بیند."],[791,"پیر عشق تست نه ریش سپید","دستگیر صد هزاران ناامید","عشق، همچون یک پیر با تجربه و دانا است که به جای سن و سال، توانایی و قدرتش در کمک به افراد ناامید بسیار زیاد است. او با حکمت و دلسوزی می‌تواند به هزاران نفر که در جستجوی امید هستند، یاری رساند."],[791,"عشق صورتها بسازد در فراق","نامصور سر کند وقت تلاق","عشق در زمان جدایی، به شکل‌های مختلفی تجلی پیدا می‌کند و در این شرایط که نمی‌توان صورت معینی از آن را درک کرد، به عمق و حقیقت خود می‌رسد."],[791,"که منم آن اصل اصل هوش و مست","بر صور آن حسن عکس ما بدست","من منبع اصلی و حقیقتی از هوش و خلاقیت هستم و زیبایی را فقط در تصاویر و تجلیات آن حس می‌کنم."],[791,"پرده‌ها را این زمان برداشتم","حسن را بی‌واسطه بفراشتم","این زمان، من پرده‌ها را کنار زدم و زیبایی را بدون هیچ واسطه‌ای به نمایش گذاشتم."],[791,"زانک بس با عکس من در بافتی","قوت تجرید ذاتم یافتی","زیرا تو با تصویر من در آمیخته‌ای، بنابراین قدرت خالص بودن و جدا بودن ذات خود را پیدا کردی."],[791,"چون ازین سو جذبه من شد روان","او کشش را می‌نبیند در میان","وقتی که از طرف من کشش و جذبه‌ای به سوی او جاری می‌شود، او نمی‌تواند این کشش را در خود احساس کند."],[791,"مغفرت می‌خواهد از جرم و خطا","از پس آن پرده از لطف خدا","آدمی در دل‌خواهی‌اش از خداوند امید رحمت و بخشش دارد و می‌خواهد با لطف الهی، خطاها و گناهانش بخشیده شود."],[791,"چون ز سنگی چشمه‌ای جاری شود","سنگ اندر چشمه متواری شود","وقتی از سنگی آبی روان می‌شود، آن سنگ در درون چشمه پنهان و ناپیدا می‌گردد."],[791,"کس نخواهد بعد از آن او را حجر","زانک جاری شد از آن سنگ آن گهر","هیچ‌کس بعد از آن سنگ را نمی‌خواهد، چون از همان سنگ، گوهری روان شده است."],[791,"کاسه‌ها دان این صور را واندرو","آنچ حق ریزد بدان گیرد علو","این بیت به مفهوم این است که فهم و درک انسان‌ها از واقعیت‌ها مانند کاسه‌هایی است که تنها می‌توانند آنچه را که حق (حقیقت) در آن‌ها می‌ریزد، بپذیرند. هرچه ظرفیت این کاسه‌ها بیشتر باشد، معرفت و روشنی بیشتری از حق را درک خواهند کرد."],[792,"ابلهان گفتند مجنون را ز جهل","حسن لیلی نیست چندان، هست سهل","بدوی‌ها به مجنون گفتند به خاطر نادانی‌ات نمی‌توانی لیلی را زیبا و دوست‌داشتنی تصور کنی، در حقیقت زیبایی او به‌اندازه‌ای نیست که به آن باید افتخار کرد."],[792,"بهتر از وی صد هزاران دلربا","هست هم‌چون ماه اندر شهر ما","مجنون می‌گوید که در شهر ما به اندازه‌ای از زیبایان وجود دارد که حتی صدها نفر از آنها جذاب‌تر از لیلی هستند، مانند ماه در میان ستاره‌ها."],[792,"گفت صورت کوزه است و حسن می","می خدایم می‌دهد از نقش وی","مجنون می‌گوید که جلوه و زیبایی کوزه، همچون زیبایی می (نوشیدنی) است و این زیبایی می، با نقشی که در کوزه دارد، از خود کوزه برتری دارد و در واقع، خداوند این زیبایی را به من عطا کرده است."],[792,"مر شما را سرکه داد از کوزه‌اش","تا نباشد عشق اوتان گوش کش","مجنون می‌گوید که شما را سرکه از کوزه‌اش می‌دهد تا ناشنوا از عشق او باشید و نتوانید آن را بشنوید."],[792,"از یکی کوزه دهد زهر و عسل","هر یکی را دست حق عز و جل","خداوند در کمال حکمت، به هر کسی چیزی می‌دهد؛ برخی زهر و برخی عسل. هر کدام آنچه به آنها داده می‌شود، نتیجه کار خود و مقداری است که در زندگی‌شان دارند."],[792,"کوزه می‌بینی ولیکن آن شراب","روی ننماید به چشم ناصواب","کوزه‌ای را می‌بینی که در واقع حاوی شراب است، اما این شراب به چشم نادان ظاهر نمی‌شود."],[792,"قاصرات الطّرف، باشد ذوق جان","جز به خصم خود بننماید نشان","عاشقانی که چشمشان از دیگران می‌پوشد، تنها می‌توانند ذوق و حال درونی خود را به دشمنان نشان دهند و این احساسات را به کسانی دیگر نمی‌گذارند."],[792,"قاصرات الطّرف، آمد آن مدام","وین حجاب ظرف‌ها هم‌چون خیام","چشم‌ها که به چیزهای حرام و ناپسند نمی‌نگرند، همیشه در حال نگاه کردن به خوبی‌ها هستند، و این حجاب‌ها (موانع) نیز مانند خیمه (پناهگاه) عمل می‌کنند."],[792,"هست دریا خیمه‌ای در وی حیات","بطّ را، لیکن کلاغان را ممات","در اینجا اشاره شده است که در دریا زندگی (حیات) برای برخی موجودات مانند بط وجود دارد، اما کلاغان در این دریا بی‌حیات و مرده هستند. این تضاد نشان‌دهنده‌ی این است که هر محیطی ممکن است برای برخی جانداران مناسب و برای برخی دیگر خطرناک باشد."],[792,"زهر باشد مار را هم قوت و برگ","غیر او را زهر او دردست و مرگ","مار برای زنده ماندن به زهر خود نیاز دارد، اما زهر برای دیگران مرگ‌آور و دردناک است؛ یعنی هر چیزی می‌تواند به دو شکل مختلف اثر کند: برای صاحبش مفید و برای دیگران مضر."],[792,"صورت هر نعمتی و محنتی","هست این را دوزخ، آن را جنّتی","هر چیزی که به نظر نعمتی یا محنتی می‌آید، در واقع به خودی خود نه خوب است و نه بد؛ این دنیا می‌تواند به دوزخی تبدیل شود یا به بهشتی، بسته به دیدگاه و انتخاب ما."],[792,"پس همه اجسام و اشیا تبصرون","واندرو قوتست و سم، لاتبصرون","شما همه اجسام و اشیا را می‌بینید و در آن‌ها قوت و انرژی وجود دارد، اما سم و زهر را نمی‌بینید."],[792,"هست هر جسمی چو کاسه و کوزه‌ای","اندرو هم قوت و هم دل‌سوزه‌ای","هر جسمی مانند کاسه و کوزه‌ای است که درون آن نه تنها خوراکی (قوت) وجود دارد، بلکه احساس و روحی (دل‌سوزه) نیز نهفته است."],[792,"کاسه پیدا اندرو پنهان رغد","طاعمش داند کزان چه می‌خورد","در این بیت گفته شده است که کاسه (ظرف) ظاهر است، اما درون آن، نعمت و لذتی پنهان وجود دارد که فقط کسی می‌داند که از آن چه چیز می‌خورد. به بیان دیگر، آنچه در باطن و دل یک شخص وجود دارد، شاید فراتر از آن چیزی باشد که به چشم می‌آید."],[792,"صورت یوسف چو جامی بود خوب","زان پدر می‌خورد صد باده طروب","صورت یوسف (که به زیبایی و جذبه‌ی او اشاره دارد) مانند جامی است زیبا که از آن پدرش (یعنی یعقوب) صد جام شراب شاداب می‌نوشد. این نشان از شگفتی و جذابیت زیبایی یوسف دارد که تأثیر عمیقی بر دیگران می‌گذارد."],[792,"باز اخوان را از آن زهراب بود","کان در ایشان خشم و کینه می‌فزود","برادران مجنون به دلیل زهراب (حسادت) که در وجودشان بود، خشم و کینه‌ بیشتری نسبت به او پیدا می‌کردند."],[792,"باز از وی مر زلیخا را سکر","می‌کشید از عشق، افیونی دگر","مجنون از عشق لیلی به شدت دچار حالت سرمستی و بی‌خبری است، چنانکه زلیخا نیز به خاطر عشق یوسف حالتی مشابه دارد و این عشق او را به افیونی دیگر دچار کرده است."],[792,"غیر آنچ بود مر یعقوب را","بود از یوسف غذا آن خوب را","غیر از غذایی که یعقوب برای یوسف داشت، چیز دیگری برای آن یوسف خوب نیست."],[792,"گونه‌گونه شربت و کوزه یکی","تا نماند در می غیبت شکی","اقسام مختلفی از شربت و کوزه وجود دارد، اما اگر می شراب غیبی از دید پنهان بماند، شکی در آن باقی نمی‌ماند."],[792,"باده از غیبست و کوزه زین جهان","کوزه پیدا باده در وی بس نهان","نوشیدنی اصیل و واقعی از غیب به ما رسیده است، اما ظرفی که آن را در خود جای داده از همین جهان مادی است و در این ظرف، باده به طور پنهان وجود دارد."],[792,"بس نهان از دیده نامحرمان","لیک بر محرم هویدا و عیان","بسیاری از حقایق و معانی عمیق از دید کسانی که شایستگی درک آن را ندارند پنهان است، اما برای کسانی که در این راه آگاه و نزدیک هستند، آن حقایق واضح و روشن است."],[792,"یا إلهی سکّرت أبصارنا","فاعف عنّا أثقلت أوزارنا","خدایا، چشمان ما مست شده و قدرت دیدن را از دست داده‌اند، پس بر ما ببخشای و از بار گناهان ما کاسته‌‍ای."],[792,"یا خفیّا قد ملأت الخافقین","قد علوت فوق نور المشرقین","ای خداوند پنهان که آسمان‌ها را پر کرده‌ای و بالاتر از نور مشرقین (دو سوی شرق) هستی."],[792,"أنت سرّ کاشف أسرارنا","أنت فجر مفجر أنهارنا","تو راز کشف‌کننده‌ی اسرار ما هستی و تویی صبحی که چشمه‌های ما را جاری می‌سازد."],[792,"یا خفیّ الذّات محسوس العطا","أنت کالماء و نحن کالرّحا","ای پنهان ذات و نمایان در عطا، تو مانند آب هستی و ما مثل آسیاب."],[792,"أنت کالرّیح و نحن کالغبار","تختفی الرّیح و غبراها جهار","تو مانند باد هستی که بر غبارها می‌وزد و ما مانند غبار هستیم که در برابر تو پنهان می‌شویم."],[792,"تو بهاری ما چو باغ سبز خوش","او نهان و آشکارا بخششش","تو مانند بهاری که برای ما مثل باغی سرسبز و خوشبو است، همه جا بخشش و خوبی‌ات را به صورت پنهان و آشکار نشان می‌دهی."],[792,"تو چو جانی ما مثال دست و پا","قبض و بسط دست از جان شد روا","تو مانند جان ما هستی که به مثابه دست و پا در بدن عمل می‌کند. این دست و پا، حیات را سر و سامان می‌دهند و وابسته به جان هستند؛ یعنی جان باعث می‌شود که دست و پا حرکت کنند و زندگی کنند."],[792,"تو چو عقلی ما مثال این زبان","این زبان از عقل دارد این بیان","تو مانند عقل هستی و ما مانند زبان. این زبان، بیانی دارد که منبع آن عقل است."],[792,"تو مثال شادی و ما خنده‌ایم","که نتیجه شادی فرخنده‌ایم","تو خود شادی هستی و ما تنها خنده‌ایم که نتیجه وجود شادی توست."],[792,"جنبش ما هر دمی خود اشهدست","که گواه ذوالجلال سرمدست","حرکت و جنبش ما در هر لحظه نشانه‌ای است که شهادت می‌دهد بر وجود و جلالی پایدار که همواره موجود است."],[792,"گردش سنگ آسیا در اضطراب","اشهد آمد بر وجود جوی آب","چرخش سنگ آسیاب به وضوح نشان‌دهنده وجود جریان آب در جوی است. این نشان می‌دهد که هر چیز در طبیعت نشانه‌هایی از واقعیت‌های دیگر دارد."],[792,"ای برون از وهم و قال و قیل من","خاک بر فرق من و تمثیل من","ای کسی که فراتر از تصورات و گفت‌وگوهای من هستی، من خاکی هستم بر سر و نماد من."],[792,"بنده نشکیبد ز تصویر خوشت","هر دمت گوید که جانم مفرشت","من نمی‌توانم از زیبایی تصویر تو بی‌خبر بمانم، هر لحظه که تو را می‌بینم، جانم مانند یک فرش زیر پا می‌افتد و تسلیم می‌شود."],[792,"هم‌چو آن چوپان که می‌گفت ای خدا","پیش چوپان و محبّ خود بیا","مجنون به خویشاوندانش اشاره می‌کند که مانند چوپانی است که از خدا می‌خواهد که در مقابل خودش به ظهور بیاید، به این معنا که او نیز در دنبال لیلی به خداوند تکیه دارد و عاشقانه خواهان نزدیکی به اوست."],[792,"تا شپش جویم من از پیراهنت","چارقت دوزم ببوسم دامنت","من تا آن‌جا که می‌توانم به دنبال کوچک‌ترین چیزها در وجود تو هستم و می‌خواهم چادر تو را بدوزم و پای دامنت را ببوسم."],[792,"کس نبودش در هوا و عشق، جفت","لیک قاصر بود از تسبیح و گفت","در عشق و وابستگی به لیلی، هیچ‌کس مانند مجنون نیست و او در این احساس بی‌نظیر و یکتا است، اما توانایی‌های او در بیان عشق و تسبیح (ستایش) و گفتگو محدود است."],[792,"عشق او خرگاه بر گردون زده","جان سگ خرگاه آن چوپان شده","عشق مجنون به لیلی به اندازه‌ای بزرگ و بلند است که مانند یک خرگاه (محل استراحت) بر گردون (آسمان) قرار گرفته. جان او در حقیقت به مانند سگی شده است که سرگردان گرد خرگاه آن چوپان (یعنی لیلی) است، به این معنا که به شدت مجنون و وابسته به عشقش شده است."],[792,"چونک بحر عشق یزدان جوش زد","بر دل او زد، ترا بر گوش زد","وقتی که دریاى عشق خداوند به جوش آمد، قلب او را زیر فشار قرار داد و تو را نیز به توجه واداشت."],[793,"واعظی بد بس گزیده در بیان","زیر منبر جمع مردان و زنان","واعظی بسیار حکیم و توانا در گفتار، زیر منبر مردان و زنان سخن می‌گوید."],[793,"رفت جوحی چادر و روبند ساخت","در میان آن زنان شد ناشناخت","جوحی (مردی به نام جوحی) چادر و روبندی درست کرد و در میان زنان قرار گرفت طوری که کسی او را نشناخت."],[793,"سایلی پرسید واعظ را به راز","موی عانه هست نقصان نماز","زنی از واعظ سؤال کرد که آیا موی عانه (موهایی که در ناحیه تناسلی هستند) موجب نقص در نماز می‌شود یا نه."],[793,"گفت واعظ چون شود عانه دراز","پس کراهت باشد از وی در نماز","واعظ گفت: وقتی که عانه (موهای ناحیه ختنه) دراز شود، نماز باعث کراهت و ناپسندی می‌شود."],[793,"یا به آهک یا ستره بسترش","تا نمازت کامل آید خوب و خوش","یا با آهک (برای پاک‌کردن) یا با پوشش مناسب بستر او (میزان پوشش) را تمیز کن تا نمازت به‌طور کامل و خوب انجام شود."],[793,"گفت سایل آن درازی تا چه حد","شرط باشد تا نمازم کم بود","سائل پرسید که طول آن دراز به چه اندازه‌ای باید باشد تا نماز من کامل شود."],[793,"گفت چون قدر جوی گردد به طول","پس ستردن فرض باشد ای سئول","گفت وقتی که طول جوی به اندازه معینی برسد، پس بر شما واجب است که آن را پاک کنید، ای پرسشگر."],[793,"گفت جوحی زود ای خوهر ببین","عانه من گشته باشد این چنین","جوحی (شخصیتی داستانی) به زنی می‌گوید که به سرعت ببیند چادر او چقدر تغییر کرده و بزرگتر شده است. این بیان نشان‌دهنده اعتماد به نفس اوست و اشاره به توجه به ظواهر دارد."],[793,"بهر خشنودی حق پیش آر دست","که آن به مقدار کراهت آمدست","برای جلب رضایت خداوند، دست خود را پیش بیاور که آن به اندازه‌ی ناخوشایندی (کراهت) آمده است."],[793,"دست زن در کرد در شلوار مرد","کیر او بر دست زن آسیب کرد","زن دستش را در شلوار مرد کرد و از شدت فشاری که به حساس‌ترین ناحیه آن مرد وارد شد، آسیب دید."],[793,"نعره‌ای زد سخت اندر حال زن","گفت واعظ بر دلش زد گفت من","زن به شدت فریاد زد و گفت که واعظ (جوحی) به دل او آسیب رسانده است."],[793,"گفت نه بر دل نزد بر دست زد","وای اگر بر دل زدی ای پر خرد","او می‌گوید که تنها بر دست او نزن، نه بر دلش؛ وای به حال تو اگر به دل او زدی، ای خردمند!"],[793,"بر دل آن ساحران زد اندکی","شد عصا و دست ایشان را یکی","مولانا می‌گوید که وقتی آن ساحران به دل خود توجه کردند و فهمیدند حقیقت چیست، به نوعی تغییر پیدا کردند و عصا و دست‌هایشان تبدیل به یک وجود واحد شد، به این معنا که اتحاد و هماهنگی در احساسات و افکارشان به وجود آمد."],[793,"گر عصا بستانی از پیری شها","بیش رنجد که آن گروه از دست و پا","اگر عصای پیری را بگیری، شها (شاه) بدتر از آن‌ها رنج می‌برد که آن گروه (ساحران) از دست و پا رنج می‌برند."],[793,"نعره لاضیر بر گردون رسید","هین ببر که جان ز جان کندن رهید","نعره زنی که جوحی را شناخت، به آسمان رسید و هشدار داد که این مرد را ببر، چون او جانش را از جدا شدن از جسم نجات داده است."],[793,"ما بدانستیم ما این تن نه‌ایم","از ورای تن به یزدان می‌زییم","ما فهمیدیم که ما فقط این جسم نیستیم و از فراسوی جسم به خداوند زندگی می‌کنیم."],[793,"ای خنک آن را که ذات خود شناخت","اندر امن سرمدی قصری بساخت","خوش به حال کسی که به حقیقت وجود خود پی برد و در آرامش جاودانی، خانه و مکانی برای خود بنا کرد."],[793,"کودکی گرید پی جوز و مویز","پیش عاقل باشد آن بس سهل چیز","کودکی به دنبال گردو و کشمش می‌گریزد و این کار در نظر یک فرد عاقل کار آسانی به نظر می‌رسد."],[793,"پیش دل جوز و مویز آمد جسد","طفل کی در دانش مردان رسد","جوز و مویز در دل، برای آن کودک جسد می‌آید؛ اما به دانش مردان نمی‌رسد، یعنی کسانی که در عقل و آگاهی رشد کرده‌اند، نمی‌توانند به این چیزهای مادی دل ببندند."],[793,"هر که محجوبست او خود کودکست","مرد آن باشد که بیرون از شک‌ست","هر کسی که حجاب دارد و خود را از دیگران پنهان می‌کند، در واقع مانند یک کودک است. مرد واقعی کسی است که از تردید و شک آزاد است و به درک درستی از خود و جهان رسیده است."],[793,"گر بریش و خایه مردستی کسی","هر بزی را ریش و مو باشد بسی","اگر کسی ریش و پشم داشته باشد، به معنی مرد بودن نیست، زیرا هر بز (حیوان) هم ریش و پشم دارد."],[793,"پیشوای بد بود آن بز شتاب","می‌برد اصحاب را پیش قصاب","آن بز (جوحی) که پیشوای بدی بود، افراد را به سرعت به سوی قصاب هدایت می‌کرد."],[793,"ریش شانه کرده که من سابقم","سابقی لیکن به سوی مرگ و غم","من خود را با ظاهری آراسته و درخشان نشان می‌دهم و ادعا می‌کنم که در گذشته‌های دور مقام و منزلتی داشتم، اما در حقیقت به سمت مرگ و اندوه می‌روم."],[793,"هین روش بگزین و ترک ریش کن","ترک این ما و من و تشویش کن","بیدار شو و راهی را انتخاب کن، ریش را رها کن و از این خودخواهی و نگرانی‌های بیهوده دست بردار."],[793,"تا شوی چون بوی گل با عاشقان","پیشوا و رهنمای گلستان","برای اینکه مانند بوی گل به یاد ماندنی باشی و با عاشقان، پیشوا و راهنمای گلستان (بهشتی) بشوی، باید خود را به صفات نیکو بیارایی و محبوبیت کسب کنی."],[793,"کیست بوی گل دم عقل و خرد","خوش قلاووز ره ملک ابد","بوی گل که در اینجا اشاره به عقل و خرد است، نشانه‌ای از زیبایی و طراوت عاقلانه است که راهنمایی برای ورود به سرزمین جاودانه (بهشت) به شمار می‌آید."],[794,"سر چارق را بیان کن ای ایاز","پیش چارق چیستت چندین نیاز","ای ایاز، به من بگو که سر چارق (جوراب یا پوشش پای) چیست و چرا برای این پوشش این همه نیاز داری؟"],[794,"تا بنوشد سنقر و بک یا رقت","سر سر پوستین و چارقت","بگذار سنقر (پرنده‌ای خوش‌صدا) پرواز کند و غمگین است، و رقت (احساس لطافت و نرمی) را بنوشد تا روی پوستین و چارق (پوشش‌هایی از چرم و پشم) خود را نشان دهد."],[794,"ای ایاز از تو غلامی نور یافت","نورت از پستی سوی گردون شتافت","ای ایاز، تو از من روشنایی و نور گرفتی و این نور تو را از مقام پست به عرش آسمان‌ها رسانده است."],[794,"حسرت آزادگان شد بندگی","بندگی را چون تو دادی زندگی","آزادگان به خاطر بندگی حسرت می‌خورند، چون تو بندگی را به زندگی و آزادی خود تبدیل کردی."],[794,"مؤمن آن باشد که اندر جزر و مد","کافر از ایمان او حسرت خورد","مؤمن کسی است که در کمی و افزونی و در هر شرایطی چنان ایمانش را نگه‌دارد که افراد کافر به ایمان محکم او حسرت بخورند."],[795,"بود گبری در زمان بایزید","گفت او را یک مسلمان سعید","در زمان بایزید، مردی کافر (گاها به معنی غیرمسلمان) وجود داشت که به او گفت یک مسلمان خوش‌نهاد (خیرخواه و نیکوکار) او را به اسلام دعوت کرد."],[795,"که چه باشد گر تو اسلام آوری","تا بیابی صد نجات و سروری","اگر تو مسلمان شوی، چه اهمیتی دارد، وقتی که به وسیله این ایمان، به نجات و مقام بالایی دست خواهی یافت؟"],[795,"گفت این ایمان اگر هست ای مرید","آنک دارد شیخ عالم بایزید","او به مریدانش می‌گوید: اگر ایمان و مسلمان شدن، آن‌چنان که شیخ و عالم بایزید دارد، خوب است."],[795,"من ندارم طاقت آن تاب آن","که آن فزون آمد ز کوششهای جان","من توانایی تحمل و قدرت درک آنچه را که فراتر از تلاش‌های روحی و جانبی من است، ندارم."],[795,"گرچه در ایمان و دین ناموقنم","لیک در ایمان او بس مؤمنم","هرچند در ایمان و دین خود مطمئن نیستم و شرایط دینی‌ام نامشخص است، اما در ایمان به خداوند بسیار مؤمن و متعهد هستم."],[795,"دارم ایمان که آن ز جمله برترست","بس لطیف و با فروغ و با فرست","من به ایمانی که از همه چیز بالاتر است، اعتقاد دارم؛ این ایمان بسیار لطیف، درخشان و پرنور است."],[795,"مؤمن ایمان اویم در نهان","گرچه مهرم هست محکم بر دهان","من در درون خود مؤمن هستم، هرچند که به ظاهر به زبان چیزی نمی‌گویم و سکوت کرده‌ام."],[795,"باز ایمان خود گر ایمان شماست","نه بدان میلستم و نه مشتهاست","من ایمان خودم را دارم و اگر ایمان شما هم هست، برای من مهم نیست. نه به خاطر میل و علاقه به شما، بلکه به خاطر خود ایمانم است که به آن پایبندم."],[795,"آنک صد میلش سوی ایمان بود","چون شما را دید آن فاتر شود","کسی که شما را ببیند حتی اگر با صد اشتیاق بسوی دین و ایمان آمده‌باشد، دلسرد و سست می‌شود"],[795,"زانک نامی بیند و معنیش نی","چون بیابان را مفازه گفتنی","زیرا از (ایمان) فقط اسمی می‌شنود و معنی‌یی نمی‌بیند همچون آنکه یک بیابان (برهوت) را مفازه و جای پناه و رهایی بنامی (و به کسی بنمایی)"],[795,"عشق او ز آورد ایمان بفسرد","چون به ایمان شما او بنگرد","عشق (و محبتی که به خداوند وجود دارد) باعث می‌شود که ایمان به فساد برسد، چون او (خدا) زمانی که به ایمان شما نگاهی کند، می‌بیند که در عشق شما چه حالتی وجود دارد."],[796,"یک مؤذن داشت بس آواز بد","در میان کافرستان بانگ زد","مؤذنی بود که صدای زشتی داشت و در سرزمین کافران اذان گفت."],[796,"چند گفتندش مگو بانگ نماز","که شود جنگ و عداوت‌ها دراز","به مؤذن گفته‌ بودند که در کافرستان اذان نگو چون این کار ممکن است باعث دشمنی و جنگ‌های طولانی شود."],[796,"او ستیزه کرد و پس بی‌احتراز","گفت در کافرستان بانگ نماز","مؤذن بی‌پروا و بدون هیچ دغدغه‌ای در کافرستان اذان گفت و به این اقدام ستیز کرد."],[796,"خلق خایف شد ز فتنه عامه‌ای","خود بیامد کافری با جامه‌ای","مردم از فتنه‌ای که در میان عامه (عموم مردم) به وجود آمده، ترسان شدند و یک کافر با لباسی شیک و زیبا نزد آنها آمد."],[796,"شمع و حلوا با چنان جامه لطیف","هدیه آورد و بیامد چون الیف","چند شمع و مقداری حلوا با چنین لباس نازکی (لطیف) هدیه آورد و به این سوی آمد، مانند یک زنبور عسل (الیف)."],[796,"پرس پرسان کاین مؤذن کو؟ کجاست‌؟","که صلا و بانگ او راحت‌فزاست","سوال می‌کنند که این مؤذن کیست و کجاست، چرا که صدای او آرامش‌بخش و دلنشین است."],[796,"هین چه راحت بود زان آواز زشت","گفت که آوازش فتاد اندر کنشت","آیا می‌دانید که صدا و آواز زشت مؤذن چه آرامش و راحتی به مردم می‌دهد؟ او به‌واسطه صدای خود باعث می‌شود آوازش به گوش مردم برسد."],[796,"دختری دارم لطیف و بس سنی","آرزو می‌بود او را مؤمنی","دختری زیبا و گرانقدر دارم که آرزو داشت مؤمن شود."],[796,"هیچ این سودا نمی‌رفت از سرش","پندها می‌داد چندین کافرش","این آرزو از سر او بیرون نمی‌رفت؛ چندین بی‌دین و کافر او را نصیحت کردند."],[796,"در دل او مهر ایمان رسته بود","هم‌چو مجمر بود این غم من چو عود","ایمان در دل او جوانه زده بود و همچون عود که بر مجمر بریزند دل مرا از غم می‌سوخت و دود می‌کرد."],[796,"در عذاب و درد و اشکنجه بدم","که بجنبد سلسله او دم به دم","من در عذاب و درد و شکنجه بودم و هر لحظه احساس می‌کردم که رنج و عذاب بر من سوار است."],[796,"هیچ چاره می‌ندانستم در آن","تا فرو خواند این مؤذن آن اذان","هیچ چاره‌ای برای آن نمی‌دانستم تا این‌که این مؤذن، اذان خواند"],[796,"گفت دختر چیست این مکروه بانگ","که به گوشم آمد این دو چار دانگ","دختر پرسید این صدای ناخوشایند و زشت چیست که به گوشم می‌رسد؟ این صدای ناهنجار و ناقص که می‌شنوم؟"],[796,"من همه عمر این چنین آواز زشت","هیچ نشنیدم درین دیر و کنشت","من در تمام عمرم هرگز صدای زشت و ناپسندی مانند این صدایی که در این کلیسا و معبد شنیدم، نشنیده‌ام."],[796,"خواهرش گفتا که این بانگ اذان","هست اعلام و شعار مؤمنان","خواهرش گفت این صدای اذان است، که اعلام و شعار مؤمنان به شمار می‌آید."],[796,"باورش نامد بپرسید از دگر","آن دگر هم گفت آری ای پدر","او باور نکرد و از دیگری پرسید، و آن هم گفت: بله، جانم!"],[796,"چون یقین گشتش رخ او زرد شد","از مسلمانی دل او سرد شد","وقتی که مطمئن شد؛ رخ او از (ترس و غم) زرد شد و از مسلمان شدن دلسرد گشت."],[796,"باز رستم من ز تشویش و عذاب","دوش خوش خفتم در آن بی‌خوف خواب","من از آن تشویش و اضطراب رها شدم و دیشب با خیال راحت خوابیدم"],[796,"راحتم این بود از آواز او","هدیه آوردم به شکر آن مرد کو","این آرامش من از آواز اوست؛ من‌باب تشکر برای او هدیه آورده‌ام، او کجاست؟"],[796,"چون بدیدش گفت این هدیه پذیر","که مرا گشتی مجیر و دستگیر","مرد کافر وقتی هدیه را دید، به مؤذن گفت این هدیه را بپذیر زیرا تو به من کمک کردی و من در برابر تو دست نیاز دراز کردم."],[796,"آنچ کردی با من از احسان و بر","بنده تو گشته‌ام من مستمر","آنچه تو با من کردی، از لطف و نیکی بوده و به واسطه آن، من در برابر تو بنده‌ای وفادار و دائمی شده‌ام."],[796,"گر به مال و ملک و ثروت فردمی","من دهانت را پر از زر کردمی","اگر برای تو به خاطر مال و ثروت و دارایی ارزش قائل بودم، دهان تو را از طلا پر می‌کردم."],[796,"هست ایمان شما زرق و مجاز","راه‌زن هم‌چون که آن بانگ نماز","ایمان شما شبیه به ظاهری فریبنده و نادرست است، مانند بانگ نماز آن مؤذن که در کافرستان شنیده می‌شود، و در واقع حقیقی نیست."],[796,"لیک از ایمان و صدق بایزید","چند حسرت در دل و جانم رسید","ولی از ایمان و صداقت بایزید (که در داستان اشاره به او شده) حسرت‌هایی در دل و جانم به وجود آمد."],[796,"هم‌چو آن زن کو جماع خر بدید","گفت آوه چیست این فحل فرید","این بیت به زنی اشاره دارد که وقتی جماع خر را می‌بیند، با تعجب می‌پرسد چه چیزی است که این‌گونه باقوت و نیرومند به نظر می‌رسد. این زن به خاطر آنچه می‌بیند، شگفت‌زده و کنجکاو می‌شود.ّ"],[796,"گر جماع اینست بردند این خران","بر کس ما می‌ریند این شوهران","اگر جماع (مقاربت) را این‌گونه انجام می‌دهند، پس این خرها چگونه همسران خود را می‌غلتانند و بر دیگران می‌ریزند؟ (یعنی اگر این رفتار را به جماع تعبیر کنیم، باید بدانیم که هیچ حیوانی - از جمله خرها - این‌گونه عمل نمی‌کند.)"],[796,"داد جمله داد ایمان بایزید","آفرین‌ها بر چنین شیر فرید","تمام مؤمنان به ایمان سرشار بایزید (بایزید بسطامی، عارف بزرگ) ارادت می‌کنند و بر او و ویژگی‌هایش که شجاعت و دلیر بودن است، تحسین و ستایش می‌فرستند."],[796,"قطره‌ای ز ایمانش در بحر ار رود","بحر اندر قطره‌اش غرقه شود","اگر قطره‌ای از ایمان بایزید در دریای بزرگ وجود داشته باشد، آن دریا به خاطر آن قطره غرق نخواهد شد."],[796,"هم‌چو ز آتش ذره‌ای در بیشه‌ها","اندر آن ذره شود بیشه فنا","مؤمن اگرچه مانند ذره‌ای کوچک از آتش ایمان باشد، می‌تواند در دل یک جنگل بزرگ که همان دنیای مادی است، آن‌قدر قوی باشد که آن جنگل را نابود کند."],[796,"چون خیالی در دل شه یا سپاه","کرد اندر جنگ خصمان را تباه","وقتی که یک خیال در دل شاه یا سربازانش ایجاد شد، آن خیال باعث شد که خصم‌ها در جنگ نابود شوند."],[796,"یک ستاره در محمد رخ نمود","تا فنا شد گوهر گبر و جهود","یک ستاره در چهره محمد (پیامبر اسلام) نمایان شد که باعث شد ارزش و مقام گبران (زرتشتیان) و یهودیان از بین برود."],[796,"آنک ایمان یافت رفت اندر امان","کفرهای باقیان شد دو گمان","کسی که ایمان آورد، در امنیت قرار گرفت و از شک و تردیدهای باقی‌مانده کافران رهایی یافت."],[796,"کفر صرف اولین باری نماند","یا مسلمانی و یا بیمی نشاند","کفر به طور موقت و برای اولین بار باقی نمی‌ماند و در نهایت یا به ایمان تبدیل می‌شود یا ترس از عواقب آن را به وجود می‌آورد."],[796,"این به حیله آب و روغن کردنیست","این مثلها کفو ذره نور نیست","این موضوع به ترفندهای ساختگی و دور از واقعیت اشاره دارد و می‌گوید که این مثال‌ها و استعاره‌ها به هیچ عنوان همپایه و معادل ذره‌ای از نور واقعی نیستند."],[796,"ذره نبود جز حقیری منجسم","ذره نبود شارق لا ینقسم","ذره تنها یک موجود کوچک و ناچیز نیست بلکه به حقیقت یک جسم کوچک و محدود است، و ذره نیست جز یک نور که تقسیم‌ناپذیر است."],[796,"گفتن ذره مرادی دان خفی","محرم دریا نه‌ای این دم کفی","منظور این است که وقتی از ذره سخن گفته می‌شود، باید دانست که آنچه از آن یاد می‌شود، یک معنی باطنی و پنهان دارد. کسی که در حقیقت خود را در خدا (دریا) محرم می‌بیند، در این لحظه باید به دست خود (کفی) اشاره کند."],[796,"آفتاب نیر ایمان شیخ","گر نماید رخ ز شرق جان شیخ","اگر ایمان شیخ مانند آفتاب نیرومند باشد، وقتی که رخسار او را از سمت شرق ببیند، روشنایی و نورانیت او را آشکار می‌کند."],[796,"جمله پستی گنج گیرد تا ثری","جمله بالا خلد گیرد اخضری","هر چیزی که در پایین‌ترین و پست‌ترین حالت باشد، می‌تواند به اوج و بلندی برسد. هر چیزی که به بالا و بهشتیان (بهشت و مقام عالی) تعلق دارد، می‌تواند به سمت کمال و زیبایی راه یابد."],[796,"او یکی جان دارد از نور منیر","او یکی تن دارد از خاک حقیر","این شخص، جانش را از نور و روشنایی الهی دارد و در عین حال، جسمش از خاک و پستی و بی‌ارزشی ساخته شده است."],[796,"ای عجب اینست او یا آن بگو","که بماندم اندرین مشکل عمو","این شگفت‌انگیز است که این شخص (مؤذن) همین‌طور است یا آن گونه است؟ بگو که من در این مشکل حیران مانده‌ام."],[796,"گر وی اینست ای برادر چیست آن","پر شده از نور او هفت آسمان","اگر او همین است، پس آن نور او که هفت آسمان را پر کرده چیست؟"],[796,"ور وی آنست این بدن ای دوست چیست","ای عجب زین دو کدامین است و کیست","اگر این بدنی که تو می‌بینی، ای دوست، همان شخص است، پس شگفت‌انگیز است که این دو (بدن و روح) چیستند و چه تفاوتی بین این دو وجود دارد؟"],[797,"بود مردی کدخدا او را زنی","سخت طناز و پلید و ره‌زنی","مردی بود که کدخدا نامیده می‌شد و زنی داشت که بسیار فریبنده و بدکار و موذی بود."],[797,"هرچه آوردی تلف کردیش زن","مرد مضطر بود اندر تن زدن","زن به شوهرش می‌گوید که هر چیزی که آوردی، خراب و تلف شده است. مرد در حالتی ناامیدانه و عذاب‌آور در تلاش است تا جلوی او را بگیرد و او را سرزنش کند."],[797,"بهر مهمان گوشت آورد آن معیل","سوی خانه با دو صد جهد طویل","این مرد جوان برای مهمان گوشت آورد و با زحمت و سختی بسیار به خانه برگشت."],[797,"زن بخوردش با کباب و با شراب","مرد آمد گفت دفع ناصواب","زن به خوردن گوشت و نوشیدن شراب مشغول بود و مرد که به خانه برگشت، گفت که باید این نادرستی را برطرف کرد."],[797,"مرد گفتش گوشت کو مهمان رسید","پیش مهمان لوت می‌باید کشید","مرد به زن می‌گوید مهمان آمده و باید غذایی برای او تهیه شود، بنابراین باید گوشت حاضر باشد."],[797,"گفت زن این گربه خورد آن گوشت را","گوشت دیگر خر اگر باشد هلا","زن گفت که این گربه همان گوشت را خورده است و اگر گوشت دیگری هم وجود داشته باشد، فرقی نمی‌کند."],[797,"گفت ای ایبک ترازو را بیار","گربه را من بر کشم اندر عیار","مرد به ایبک می‌گوید که ترازو را بیاورد تا او بتواند گربه را وزن کند و آن را در مقیاس بسنجد."],[797,"بر کشیدش بود گربه نیم من","پس بگفت آن مرد کای محتال زن","مرد گربه را از روی ترازو بلند کرد و سپس به همسرش گفت: ای زن فریب‌کار، تو چه می‌گویی؟"],[797,"گوشت نیم من بود و افزون یک ستیر","هست گربه نیم‌من هم ای ستیر","گوشت من نصف بود و بیشتر است، و اگر این گربه نیم من است، پس تو باید برای چیزی به نام ستیر (از جنس ماده‌ای که در حکم من است) هم جواب بدهی."],[797,"این اگر گربه‌ست پس آن گوشت کو","ور بود این گوشت گربه کو بجو","اگر این موجود گربه است، پس آن گوشت کجاست؟ و اگر این گوشت واقعی است، گربه‌اش کجاست؟"],[797,"بایزید ار این بود آن روح چیست","ور وی آن روحست این تصویر کیست","اگر این جسم بایزید، روح واقعی‌اش چیست؟ و اگر آن روح بایزید است، پس این تصویر (این جسم) که در مقابل ماست، چیست؟"],[797,"حیرت اندر حیرتست ای یار من","این نه کار تست و نه هم کار من","ای دوست، ما در یک سردرگمی عمیق هستیم و این وضعیت نه به خاطر توست و نه به خاطر من."],[797,"هر دو او باشد ولیک از ریع زرع","دانه باشد اصل و آن که پره فرع","هر دو چیز (اصل و فرع) در نهایت به یک چیز وابسته‌اند، اما دانه زراعت (اصل) مهم‌تر از میوه یا شاخ و برگ آن (فرع) است."],[797,"حکمت این اضداد را با هم ببست","ای قصاب این گردران با گردنست","ای قصاب، حکمت این تضادها را کنار هم قرار داده است؛ به این معنا که این دو چیز (گوشت و گربه) به هم مرتبطند و در حقیقت با وجود تفاوت‌ها، به یک حقیقت وابسته‌اند."],[797,"روح بی‌قالب نداند کار کرد","قالبت بی‌جان فسرده بود و سرد","روح بی‌قالب (بدون وجود جسمانی) نمی‌تواند از کارها و فعالیت‌ها باخبر شود. در مقابل، جسم بی‌روح و جان، بی‌حرکت و سرد است."],[797,"قالبت پیدا و آن جانت نهان","راست شد زین هر دو اسباب جهان","شکل و قالب جسمی تو روشن و نمایان است، اما جان و روح تو پنهان و ناپیداست. به همین خاطر، این دو، که یکی ظاهر و دیگری باطن است، سبب وجود جهان شده‌اند."],[797,"خاک را بر سر زنی سر نشکند","آب را بر سر زنی در نشکند","اگر بخواهی سر را بشکنی، با زدن خاک بر سرت نمی‌توانی موفق شوی؛ چرا که آب هم بر سرت بریزی نتیجه‌ای نخواهد داشت."],[797,"گر تو می‌خواهی که سر را بشکنی","آب را و خاک را بر هم زنی","اگر می‌خواهی که بخواهی سر را بشکنی و آب و خاک را به هم بزنید، باید به عواقب آن عمل توجه کنی."],[797,"چون شکستی سر رود آبش به اصل","خاک سوی خاک آید روز فصل","وقتی که تو سر رود را بشکنی، آب آن به سمت اصل خاک برمی‌گردد و در فصل مناسب دوباره به خاک می‌پیوندد."],[797,"حکمتی که بود حق را ز ازدواج","گشت حاصل از نیاز و از لجاج","مفهوم حکمت این است که ازدواج، نتیجه نیاز انسان‌ها به یکدیگر و گاهی در اثر لجاجت و ناسازگاری به وجود می‌آید."],[797,"باشد آنگه ازدواجات دگر","لا سمع اذن و لا عین بصر","اگر ازدواج‌های دیگر هم باشد، نه گوش به صدای کسی می‌شنود و نه چشم به چیزی می‌بیند."],[797,"گر شنیدی اذن کی ماندی اذن","یا کجا کردی دگر ضبط سخن","اگر شنیده‌ای که اجازه‌ای داده شده، دیگر چرا در آنجا مانده‌ای یا کجا دیگر ضبط و سخن را انجام می‌دهی؟"],[797,"گر بدیدی برف و یخ خورشید را","از یخی برداشتی اومید را","اگر برف و یخ در برابر خورشید را می‌دیدی، از یخ می‌رفتی به سوی خورشید و امید را در دل خود احساس می‌کردی."],[797,"آب گشتی بی‌عروق و بی‌گره","ز آب داود هوا کردی زره","تو مانند آبی شدی که هیچ رگ و گره‌ای ندارد و فقط با دعای حضرت داود، لباس زره (محافظ) بر تن کرده‌ای."],[797,"پس شدی درمان جان هر درخت","هر درختی از قدومش نیک‌بخت","در نتیجه‌ی آمدن او، هر درخت نیکو و خوش‌بخت شد و جان هر درخت درمان یافت."],[797,"آن یخی بفسرده در خود مانده","لا مساسی با درختان خوانده","آن برف یخ‌زده که در خود مانده، با درختان تماس ندارد و به آن‌ها نمی‌پیوندد."],[797,"لیس یالف لیس یؤلف جسمه","لیس الا شح نفس قسمه","نمی‌تواند با هم هماهنگ شود، نمی‌تواند با هم ترکیب شود، او فقط شهوات نفس خود را با قسمتی از بدنش همراه ساخته است."],[797,"نیست ضایع زو شود تازه جگر","لیک نبود پیک و سلطان خضر","هیچ چیز از او ضایع نمی‌شود و تازه جگر او در امان است، اما پیک و خبررسانی از جانب او وجود ندارد، و همچنین سلطان خضر (که نماد حیات و جاودانگی است) هم حضور ندارد."],[797,"ای ایاز استاره تو بس بلند","نیست هر برجی عبورش را پسند","ای ایاز (دوست و خدمتگزار)، مقام تو بسیار بلند است، اما این‌طور نیست که هر برجی بتواند به تو راه یابد یا تو را شایسته بداند."],[797,"هر وفا را کی پسندد همتت","هر صفا را کی گزیند صفوتت","نمی‌دانم وفا و صفا را چه کسی انتخاب می‌کند یا درک می‌کند، همت تو و روح پاک تو هستند که این ویژگی‌ها را قدر می‌دانند و برایشان ارزش قائل می‌شوند."],[798,"بود امیری خوش دلی می‌باره‌ای","کهف هر مخمور و هر بیچاره‌ای","امیری با دل خوش و مهربان بود که هر فرد شرابی و بیچاره‌ای را محبت می‌کرد و به او محبت نشان می‌داد."],[798,"مشفقی مسکین‌نوازی عادلی","جوهری زربخششی دریادلی","شخصی با روحیه‌ای مهربان و دلسوز وجود دارد که با کودکان به نرمی و محبت رفتار می‌کند. او عدالت‌پیشه و وقتی به موضوعی می‌رسد، به رنگ و جلوه‌ی زرین (درخشان) توجه دارد که نمایانگر بخشش و سخاوت اوست. این شخص با قلبی بزرگ و با فهم عمیق به دیگران کمک می‌کند."],[798,"شاه مردان و امیرالمؤمنین","راه‌بان و رازدان و دوست‌بین","شخصیتی بزرگ و معتبر، که حاکم مردان و پیشوای مؤمنان است، همچنین دلداده و آگاه به امور پنهانی و دوستی‌های مردم است."],[798,"دور عیسی بود و ایام مسیح","خلق دلدار و کم‌آزار و ملیح","در آن زمان که عیسی و اوضاع مربوط به مسیح بود، مردم دوستانه و کم‌آزار و شیرین‌رفتار بودند."],[798,"آمدش مهمان بناگاهان شبی","هم امیری جنس او خوش‌مذهبی","شبی ناگهان مهمانی برای او (امیر) می‌آید که بر خلاف ظاهرش، شخصیتش شاداب و خوش‌خلق است و از او خوشش می‌آید."],[798,"باده می‌بایستشان در نظم حال","باده بود آن وقت ماذون و حلال","شرط این بود که باده در شرایط خاص و معین باشد تا بتوان آن را به نحو صحیح و مجاز نوشید. زمانی که این شرایط فراهم باشد، نوشیدن باده مجاز و مشروع است."],[798,"باده‌شان کم بود و گفتا ای غلام","رو سبو پر کن به ما آور مدام","باده آن‌ها کم بود و به غلام گفتند که برو و سبو را پر کن و مداوم برای ما بیاور."],[798,"از فلان راهب که دارد خمر خاص","تا ز خاص و عام یابد جان خلاص","این بیت به این معناست که راهب (زاهد) خاصی که دارای شراب خاصی است، باعث می‌شود که هم عده‌ای خاص و هم عامه مردم از درد و رنج رهایی یابند. به عبارتی، شرابی که او می‌آورد، روح را آزاد و رها می‌کند و سبب نجات و رستگاری می‌شود."],[798,"جرعه‌ای زان جام راهب آن کند","که هزاران جره و خمدان کند","نوشیدن یک جرعه از آن جام مخصوص راهب، تأثیری دارد که هزاران ظرف و پیمانه دیگر نمی‌تواند داشته باشد."],[798,"اندر آن می مایه پنهانی است","آنچنان که اندر عبا سلطانی است","در شراب، راز و مایه‌ای نهفته است که مانند پنهان شدن سلطانی در عبا (لباس مخصوص) می‌باشد."],[798,"تو بدلق پاره‌پاره کم نگر","که سیه کردند از بیرون زر","نباید به ظواهر و غیرواقعی‌ها توجه کنی؛ زیرا کسانی که از درون، ناپاک و پلید هستند، ظاهر زیبا و خود را با زرق و برق درست می‌کنند، و همین ایجاد تصویر کاذب، حقیقت را خراب کرده است."],[798,"از برای چشم بد مردود شد","وز برون آن لعل دودآلود شد","چشم‌بد به‌خاطر زیبایی یا ارزش افراد دیگر، به این لب و دندان (که به لعل تشبیه شده) آسیب نمی‌زند. این لعل (گوهر باارزش) در نظر دیگران ممکن است کدر و دودآلود به نظر برسد، اما در واقعیت قلمرو باطنی‌اش محفوظ مانده و دست‌نخورده است."],[798,"گنج و گوهر کی میان خانه‌هاست","گنجها پیوسته در ویرانه‌هاست","بهترین و ارزشمندترین چیزها (گنج و گوهر) در دل خانه‌ها نیستند، بلکه در دل ویرانی‌ها و جاهای دور از نظر قرار دارند."],[798,"گنج آدم چون بویران بد دفین","گشت طینش چشم‌بند آن لعین","انسان، هنگامی که مانند یک ویرانه و بی‌فایده می‌شود، گنجی که در او نهفته است، پنهان می‌ماند و آن چهره پلید (شیطان یا نفس) همچون چشم‌بندی عمل می‌کند که مانع از دیدن آن گنج می‌شود."],[798,"او نظر می‌کرد در طین سست سست","جان همی‌گفتش که طینم سد تست","زاهد، در حال مشاهده و نگاه کردن به گل و لای نرم و سست، به خود می‌گوید که من هم مانند این گل و لای هستم و به دلیلی نتوانسته‌ام از آن حال و وضع خود آزاد شوم."],[798,"دو سبو بستد غلام و خوش دوید","در زمان در دیر رهبانان رسید","غلام دو کوزه (سبو) را برداشت و به سرعت دوید و به دیر رهبانان رسید."],[798,"زر بداد و باده چون زر خرید","سنگ داد و در عوض گوهر خرید","امیر برای خرید باده، پول زیادی داد و در عوض، سنگی داد و به جای آن، جواهر خرید."],[798,"باده‌ای که آن بر سر شاهان جهد","تاج زر بر تارک ساقی نهد","باده‌ای که مخصوص شاهان است، لباس زیبایی بر تن دارد و بر بالای سر ساقی، تاجی از طلا گذاشته می‌شود."],[798,"فتنه‌ها و شورها انگیخته","بندگان و خسروان آمیخته","فتنه‌ها و آشوب‌ها بین بندگان و پادشاهان به هم پیوسته و در هم تنیده شده است."],[798,"استخوانها رفته جمله جان شده","تخت و تخته آن زمان یکسان شده","در این بیت، بیان می‌شود که در زمان مستی، روح و بدن یکسان می‌شوند و دیگر تفاوتی بین آنها نیست؛ به نوعی همه چیز به حالت یکنواخت و بی‌تفاوتی درمی‌آید، همان‌طور که استخوان‌ها از هم رفته و جان به یک شکل تبدیل می‌شود."],[798,"وقت هشیاری چو آب و روغنند","وقت مستی هم‌چو جان اندر تنند","در هنگام هشیاری، افراد مانند آب و روغن، جدا از یکدیگرند و نمی‌توانند با هم مخلوط شوند. اما در زمان مستی، انسان‌ها به یکدیگر نزدیک می‌شوند و هم چون جان و بدن به هم وابسته‌اند."],[798,"چون هریسه گشته آنجا فرق نیست","نیست فرقی کاندر آنجا غرق نیست","در آن مکان، اختلافی بین افراد وجود ندارد؛ زیرا تمام آنها در همان حالت هریسه (حالت مخلوط و یکدست) قرار دارند و هیچ‌کس در آنجا غرق نشده است."],[798,"این چنین باده همی‌برد آن غلام","سوی قصر آن امیر نیک‌نام","این غلام باده را به سوی قصر آن امیر نیکوکار می‌برد."],[798,"پیشش آمد زاهدی غم دیده‌ای","خشک مغزی در بلا پیچیده‌ای","زاهدی به آن غلام نزدیک شد که از غم خشک و بی‌احساس به نظر می‌رسید و در اندوه و مشکلات فرو رفته بود."],[798,"تن ز آتشهای دل بگداخته","خانه از غیر خدا پرداخته","دل صاحب این بیت به خاطر آتش عشق خالصانه به خدا می‌سوزد و وجودش از دیگران خالی شده و تمام تمرکزش بر خداوند است. او از محبت‌های دیگران بی‌نیاز شده و تنها به دنبال رضایت الهی است."],[798,"گوشمال محنت بی‌زینهار","داغها بر داغها چندین هزار","گوشمال و تنبیهی که بدون هیچ حفاظت یا پناهی انجام می‌شود، دردهایی را به همراه دارد که بر روی دردهای بسیار زیاد دیگری انباشته شده است."],[798,"دیده هر ساعت دلش در اجتهاد","روز و شب چفسیده او بر اجتهاد","چشم زاهد همیشه در جستجوی دلایل و حقایق است و هر لحظه در فکر و تلاش برای فهم بیشتر است، به‌طوری که تمام شب و روز را به فکر و اجتهاد می‌پردازد."],[798,"سال و مه در خون و خاک آمیخته","صبر و حلمش نیم‌شب بگریخته","سال‌ها و ماه‌ها در خون و خاک آمیخته شده‌اند، یعنی در وضعیت‌های سخت و دشوار قرار دارند و ناامیدی و تنش در دل زاهد وجود دارد، طوری که صبر و بردباری او در نیمه‌شب از بین رفته و به گریه افتاده است."],[798,"گفت زاهد در سبوها چیست آن","گفت باده گفت آن کیست آن","زاهد از امیر می‌پرسد که در ظرف‌های شیشه‌ای چه چیزی است. امیر پاسخ می‌دهد که آن‌ها حاوی شراب هستند و زاهد می‌پرسد که این شراب چیست."],[798,"گفت آن آن فلان میر اجل","گفت طالب را چنین باشد عمل","زاهد می‌گوید که کسی که به عشق خدا می‌پردازد، رفتار و اعمالش باید بر اساس همین عشق باشد و اگر چنین نباشد، آن عمل از نظر خداوند پذیرفته نخواهد شد."],[798,"طالب یزدان و آنگه عیش و نوش","باده شیطان و آنگه نیم هوش","مرید خدا را طلب می‌کند و به دنبال آن زندگی خوش و لذیذ را با شراب شیطان می‌گذرانید، اما در این حال نیمی از هوش خود را هم ندارد."],[798,"هوش تو بی می چنین پژمرده است","هوشها باید بر آن هوش تو بست","اگر تو بدون شراب و می، چنین پژمرده و بی‌هوش هستی، باید هوش‌های دیگر را به تو بسپارند تا با کمک آن‌ها به حالت طبیعی برگردی."],[798,"تا چه باشد هوش تو هنگام سکر","ای چو مرغی گشته صید دام سکر","حال که تو در حال سکر و نوشیدنی هستی، چه بر تو می‌گذرد و هوش و ذکایتت چگونه است؟ تو مانند پرنده‌ای هستی که به دام افتاده است و از آزادی و آگاهی‌اش دور مانده."],[799,"آن ضیاء دلق خوش الهام بود","دادر آن تاج شیخ اسلام بود","ضیاء که دارای استعداد و خلاقیت بالایی بود، وارث تاج و مقام شیخ اسلام در بلخ بود."],[799,"تاج شیخ اسلام دار الملک بلخ","بود کوته‌قد و کوچک هم‌چو فرخ","تاج، شیخ اسلام که در بلخ مقام بلندی دارد، قد کوتاه و کوچک دارد و مانند پرنده‌ای به نام فرخ که کوچک است، وصف شده است."],[799,"گرچه فاضل بود و فحل و ذو فنون","این ضیا اندر ظرافت بد فزون","هرچند ضیا در علم و دانش برجسته و دارای مهارت‌های مختلف بود، اما در ظرافت و نازکی از برادرش شیخ اسلام بیشتر بود."],[799,"او بسی کوته ضیا بی‌حد دراز","بود شیخ اسلام را صد کبر و ناز","ضیا بسیار بلندقد بود، در حالی که شیخ اسلام، برادرش، به شدت کوتاه بود و به همین خاطر او (شیخ اسلام) به شدت متکبر و خودبین بود."],[799,"زین برادر عار و ننگش آمدی","آن ضیا هم واعظی بد با هدی","ضیا به خاطر کوتاهی برادرش، شیخ اسلام، احساس عار و ننگ می‌کند و خودش هم فردی با دانش و اندرزدهنده‌ای خوب است."],[799,"روز محفل اندر آمد آن ضیا","بارگه پر قاضیان و اصفیا","ضیا در روز محفل وارد شد، جایی که پر از قاضیان و افراد قدری بود."],[799,"کرد شیخ اسلام از کبر تمام","این برادر را چنین نصف القیام","شیخ اسلام به خاطر کبر و خودبینی‌اش، برادرش ضیا را که خیلی بلند قد بود، نادیده گرفت و او را فقط به عنوان یک موجود بلند قامت و نه یک فرد با ارزش دید."],[799,"گفت او را بس درازی بهر مزد","اندکی زان قد سروت هم بدزد","شیخ اسلام به برادرش ضیا می‌گوید که قد بلندش، تنها به خاطر شغل و مقام کمی از آنهاست و به سادگی می‌تواند به این بلندی به چشم طعنه نگاه کند."],[799,"پس ترا خود هوش کو یا عقل کو","تا خوری می ای تو دانش را عدو","پس تو باید به خودت فکر کنی و از عقل و هوشت استفاده کنی، چون اگر نه، دانشی که به دست می‌آوری برایت مضر خواهد بود و دشمن تو می‌شود."],[799,"روت بس زیباست نیلی هم بکش","ضحکه باشد نیل بر روی حبش","صورت تو بسیار زیباست، مانند رنگ آسمان درخشان است. نیل، که رنگی آبی به‌حساب می‌آید، اگر بر چهره حبشیان به کار رود، مزیتی و زیبایی خاصی به وجود می‌آورد."],[799,"در تو نوری کی درآمد ای غوی","تا تو بیهوشی و ظلمت‌جو شوی","ای جوانمرد غوی (غوی به معنای جوانمرد)، چه زمانی نوری به درون تو وارد می‌شود، در حالی که تو در بی‌هشی و در جستجوی ظلمات هستی؟"],[799,"سایه در روزست جستن قاعده","در شب ابری تو سایه‌جو شده","در روز، جستجوی سایه‌ها مانند تلاش برای پیدا کردن اصول و قواعد در شب ابری است. تو به دنبال سایه‌ها رفته‌ای و از نور و حقیقت غافلی."],[799,"گر حلال آمد پی قوت عوام","طالبان دوست را آمد حرام","اگر انسان‌های عادی به دنبال قوت و تامین نیازهای خود باشند، برای افرادی که عاشق و در جستجوی دوست حقیقی هستند، این کار حرام محسوب می‌شود."],[799,"عاشقان را باده خون دل بود","چشمشان بر راه و بر منزل بود","عاشقانی که دلشان از درد و رنج می‌سوزد، می‌دانند که نوشیدن باده (عشق و محبت) برای آن‌ها مانند نوشیدن خون دل است. آن‌ها همیشه چشم به راه محبوب و خانه‌اش هستند."],[799,"در چنین راه بیابان مخوف","این قلاوز خرد با صد کسوف","در این بیابان خطرناک، این قلاوز (سرپرست قافله) با وجود صدها مانع و مشکلات، در حال حرکت است. اشاره به دشواری‌های سفر و تحدیدات موجود دارد."],[799,"خاک در چشم قلاوزان زنی","کاروان را هالک و گمره کنی","با خاک زدن به چشم دزدان و چپاول‌گران، می‌توانی کاروان‌ها را نابود و گمراه کنی."],[799,"نان جو حقا حرامست و فسوس","نفس را در پیش نه نان سبوس","نان جو به‌حق حرام است، و فاسد کردن نفس در برابر آن، نه نان سبوس است. در واقع، این بیت به اهمیت پرهیز از فساد و گناه در نفس انسان اشاره دارد و می‌گوید که عایدی‌های ناپاک، حتی اگر به شکل نان باشد، نمی‌تواند مجاز باشد."],[799,"دشمن راه خدا را خوار دار","دزد را منبر منه بر دار دار","دشمنی که بر ضد خدا عمل می‌کند، باید خوار و بی‌مقدار باشد و دزد را نباید بر بالای منبر بگذاری تا به دیگران سخن بگوید یا تعلیم دهد."],[799,"دزد را تو دست ببریدن پسند","از بریدن عاجزی دستش ببند","اگر نمی‌توانی دزد را دستگیر کنی و او را از کارش باز‌داری، حداقل دست او را ببند تا نتواند دزدی کند."],[799,"گر نبندی دست او دست تو بست","گر تو پایش نشکنی پایت شکست","اگر تو دست او را نبندی، او دست تو را می‌بندد؛ اگر تو پای او را نشکنی، پای تو به ضربه او می‌شکند."],[799,"تو عدو را می دهی و نی‌شکر","بهر چه گو زهر خند و خاک خور","تو به دشمن (عدو) خود هدیه می‌دهی در حالی که از نی‌شکر (شیرینی) برخوردار نیستی. این کار چه فایده‌ای دارد که به نیشخند (زهرخند) و خاکی که بر سرت می‌ریزد (تحقیر) منجر می‌شود؟"],[799,"زد ز غیرت بر سبو سنگ و شکست","او سبو انداخت و از زاهد بجست","به خاطر غیرت و حس حسادت، بر روی سبوی شراب سنگ زد و آن را شکست. سپس از درون زاهد (شخصی که به زهد و پارسایی مشهور است) خارج شد."],[799,"رفت پیش میر و گفتش باده کو","ماجرا را گفت یک یک پیش او","ضیا پیش میردیسی (مظاهری یا شخص محترم) رفت و از او پرسید که شراب کجاست و ماجرای خود را به تفصیل برای او توضیح داد."],[800,"میر چون آتش شد و برجست راست","گفت بنما خانه زاهد کجاست","امیر خشمگین مانند آتش شعله‌ور شده و به راستی گفت: «خانه زاهد کجا است؟"],[800,"تا بدین گرز گران کوبم سرش","آن سر بی‌دانش مادرغرش","من با این گرز سنگین بر سر او می‌کوبم، همان سر نادانی که گمراهی مادرش است."],[800,"او چه داند امر معروف از سگی","طالب معروفی است و شهرگی","او کار پسندیده و ناپسند (سگی) را از هم تشخیص نمی‌دهد؛ طالب شهرت است و می‌خواهد معروف شود."],[800,"تا بدین سالوس خود را جا کند","تا به چیزی خویشتن پیدا کند","انسان تا زمانی که با نفاق و ظاهرسازی (سالوس) خود را به جایی برساند، نمی‌تواند ذات واقعی‌اش را بشناسد و به حقیقت وجود خود پی ببرد."],[800,"کو ندارد خود هنر الا همان","که تسلس می‌کند با این و آن","کسی که خود هنری ندارد، تنها همان چیزی را دارد که از طریق ارتباط با دیگران به دست می‌آورد و به عبارتی دیگران را در آن شریک می‌کند."],[800,"او اگر دیوانه است و فتنه‌کاو","داروی دیوانه باشد کیر گاو","اگر او (شخصی که سخن از اوست) دیوانه و آسیب‌زننده است، دارویی که می‌تواند او را درمان کند، باید به شدت و خطرناک باشد، مانند کیر گاو که سمبل قدرت و خشونت است."],[800,"تا که شیطان از سرش بیرون رود","بی‌لت خربندگان خر چون رود","زمانی که شیطان از سر او (شخص دیوانه) خارج شود، مانند این است که خر از زیر بار (بار سنگین) آزاد شود."],[800,"میر بیرون جست دبوسی بدست","نیم شب آمد به زاهد نیم‌مست","امیر (میر) در حین خشم و عصبانیت با تکه‌ای از دبو (دبوس) به سرعت خارج شد و در نیمه شب نزد زاهد (مرد زاهد) که نیمه مست بود، حاضر شد."],[800,"خواست کشتن مرد زاهد را ز خشم","مرد زاهد گشت پنهان زیر پشم","امیر به خاطر خشمش می‌خواست زاهد را بکشد، اما زاهد از ترس، زیر لباس خوابش مخفی شد."],[800,"مرد زاهد می‌شنید از میر آن","زیر پشم آن رسن‌تابان نهان","مرد زاهد از زیر پشم، صدای میر (امیر) را می‌شنید که به او می‌گوید و متوجه می‌شود که در حینی که او خودش را پنهان کرده، صدایش به گوشش می‌رسد."],[800,"گفت در رو گفتن زشتی مرد","آینه تاند که رو را سخت کرد","گفت: آنکس که می‌تواند عیبهایت را در روی تو و مقابل تو بگوید آینه است که سخت‌رو و دلیر است."],[800,"روی باید آینه‌وار آهنین","تات گوید روی زشت خود ببین","رویی سخت همچون آینه لازم است تا به‌تو عیبهایت را بنماید. (توضیح: آینه‌های قدیمی از آهن بوده‌اند)"],[801,"شاه با دلقک همی شطرنج باخت","مات کردش زود خشم شه بتاخت","شاه بازی شطرنج را با دلقک باخت و به سرعت از خشم، به او حمله‌ور شد."],[801,"گفت شه شه و آن شه کبرآورش","یک یک از شطرنج می‌زد بر سرش","شاه به دلقک گفت و دلقک با کبر و arrogance خود، یکی یکی مهره‌های شطرنج را بر سر او می‌زد."],[801,"که بگیر اینک شهت ای قلتبان","صبر کرد آن دلقک و گفت الامان","دلقک که به شدت ترسیده، از شاه می‌خواهد که او را نرنجاند و به او امان دهد."],[801,"دست دیگر باختن فرمود میر","او چنان لرزان که عور از زمهریر","دست دیگر خود را باختن به معنای «شکست» است که میر (همان شاه) دستور می‌دهد. او چنان لرزان و بی‌دست و پا شده که مانند کسی است که در سرمای شدید زمهریر (سرما) دچار سردرگمی و گیجی شده است."],[801,"باخت دست دیگر و شه مات شد","وقت شه شه گفتن و میقات شد","شاه بازی را باخت و در نتیجه، در حالت مات قرار گرفت. اینجا وقتی می‌گویند “شه شه گفتن” به معنای اعلام باخت است و “میقات شد” یعنی زمان پایان بازی فرا رسیده است."],[801,"بر جهید آن دلقک و در کنج رفت","شش نمد بر خود فکند از بیم تفت","آن دلقک ناگهان از جا پریده و به گوشه‌ای رفت و برای اینکه از شدت ترس و فشار روحی خود را پنهان کند، شش نمد (نوعی پارچه یا لایه) بر خود انداخت."],[801,"زیر بالشها و زیر شش نمد","خفت پنهان تا ز زخم شه رهد","دلقک به زیر بالش‌ها و زیر نمدهایش پنهان شد تا از آسیب و زخم‌های شاه در امان بماند."],[801,"گفت شه هی هی چه کردی چیست این","گفت شه شه شه شه ای شاه گزین","شاه با صدای پرهیجان و حیرت می‌گوید: «چه کار کرده‌ای؟ این چه وضعیتی است؟» و در ادامه، او که مقام سلطنت دارد، از شخص مقابل (دلقک) سؤال می‌کند که چرا این گونه به حال او درآمده است."],[801,"کی توان حق گفت جز زیر لحاف","با تو ای خشم‌آور آتش‌سجاف","هیچ‌کس نمی‌تواند حقایق را به‌طور مستقیم و بدون پرده‌پوشی بیان کند مگر اینکه در پناه تو، ای خشم‌آور (شخصی با هیبت و قدرت)، باشد و به‌نوعی آرامش پیدا کند. در واقع، بیان حقایق در برابر تو دشوار است."],[801,"ای تو مات و من ز زخم شاه مات","می‌زنم شه شه به زیر رختهات","ای تو که به خاطر زخم‌های شاه، گیج و مبهوت شده‌ای و حالا من دارم با ضربات شدید، بر تو فشار می‌آورم و تو را زیر گوش پادشاه حریف می‌زنم."],[801,"چون محله پر شد از هیهای میر","وز لگد بر در زدن وز دار و گیر","وقتی محله پر از صدای آزاردهنده فرمانده و جمعیت شد، مردم به در زدن و ایجاد سروصدا پرداخته و نگران و مصیبت‌زده شدند."],[801,"خلق بیرون جست زود از چپ و راست","کای مقدم وقت عفوست و رضاست","مردم به سرعت از دو طرف بیرون آمدند، زیرا وقت مناسبی برای عفو و رضایت فرارسیده است."],[801,"مغز او خشکست و عقلش این زمان","کمترست از عقل و فهم کودکان","مردی به نام سید شاه ترمد به شدتی گرفتار و مغرور شده که حتی عقل و شعور او به قدری تحلیل رفته که به اندازه عقل و درک یک کودک رسیده است."],[801,"زهد و پیری ضعف بر ضعف آمده","واندر آن زهدش گشادی ناشده","زهد و پیری باعث شده‌اند که نقص و ضعف‌های بیشتری بر او بیفزاید و در این زهد و دنیاگریزی، هنوز نتوانسته است به عمق و حقیقت آن دست یابد."],[801,"رنج دیده گنج نادیده ز یار","کارها کرده ندیده مزد کار","کسی که زحمت کشیده و رنج برده، گنج و پاداشی که از کارهای او ناشی می‌شود، از دید یار پنهان مانده است و او از زحماتش چیزی را نمی‌بیند."],[801,"یا نبود آن کار او را خود گهر","یا نیامد وقت پاداش از قدر","شاید آن کار او به دلیل ناتوانی خودش نبوده و یا اینکه زمان مناسب برای پاداش دادن هنوز نرسیده است."],[801,"یا که بود آن سعی چون سعی جهود","یا جزا وابسته میقات بود","آیا تلاش او مانند تلاش یهودی بود، یا اینکه پاداش او به زمان معین و مشخصی بستگی داشت؟"],[801,"مر ورا درد و مصیبت این بس است","که درین وادی پر خون بی‌کس است","درد و رنج او به حدی است که در این بی‌رحمی و سختی، احساس تنهایی و بی‌پناهی می‌کند."],[801,"چشم پر درد و نشسته او به کنج","رو ترش کرده فرو افکنده لنج","چشم‌های او پر از درد است و در گوشه‌ای نشسته، با چهره‌ای بدخلق و در هم کشیده، سرش را پایین انداخته است."],[801,"نه یکی کحال کو را غم خورد","نیش عقلی که به کحلی پی برد","غمی نیست که انسان‌های زیادی به او توجه کنند، بلکه این عقل و بینش اوست که با تجربه و شعور، به عمق مسائل و نکات پنهان پی می‌برد."],[801,"اجتهادی می‌کند با حزر و ظن","کار در بوکست تا نیکو شدن","او با احتیاط و تردید تلاش می‌کند تا در کار خود به درک و فهمی دست یابد که به نتایج خوب و مثبت منتهی شود."],[801,"زان رهش دورست تا دیدار دوست","کو نجوید سر رئیسیش آرزوست","راه او از دیدار دوست دور است و او برای رسیدن به آن، هیچ تلاشی نمی‌کند، چرا که فقط آرزوی مقام و رئیسی دارد."],[801,"ساعتی او با خدا اندر عتاب","که نصیبم رنج آمد زین حساب","مدتی او در ملامت و سرزنش خدا به سر می‌برد، چون احساس می‌کند که به خاطر محاسبات و کارهایی که کرده، دچار رنج و سختی شده است."],[801,"ساعتی با بخت خود اندر جدال","که همه پران و ما ببریده بال","مدتی با تقدیر و سرنوشت خود در کشمکش هستم، در حالی که بخت من به خاطر مشکلات و سختی‌ها مانند پرنده‌ای در قفس حبس شده و بال‌هایش چیده شده است."],[801,"هر که محبوس است اندر بو و رنگ","گرچه در زهدست باشد خوش تنگ","هر کس در قید و بند محدودیت و رنگ و بو گرفتار گشته است هرچند اگر زاهد باشد خوی او تنگ است و بدحال است."],[801,"تا برون ناید ازین ننگین مناخ","کی شود خویش خوش و صدرش فراخ","هر زمانی که انسان از وضعیت ناپسند و محدود کننده‌ای که در آن قرار دارد بیرون نیاید، هرگز نمی‌تواند به حال خوش و آسودگی خاطر دست یابد."],[801,"زاهدان را در خلا پیش از گشاد","کارد و استره نشاید هیچ داد","زاهدان نباید در حال بی‌کاری و بیکاری به دیگران چیزی بدهند یا کمک کنند، چون در آن حالت، آنها بر اساس نیاز و بی‌چیزی خود، نمی‌توانند درست عمل کنند و ممکن است نتوانند از عهده مسئولیت‌های خود برآیند."],[801,"کز ضجر خود را بدراند شکم","غصه آن بی‌مرادیها و غم","درد و رنج خود را با کینه و حسرت از دل بیرون می‌برد، و دلش از غصه و مصیبت‌های بی‌پاسخ و غم‌هایش پر است."],[802,"مصطفی را هجر چون بفراختی","خویش را از کوه می‌انداختی","وقتی که هجران و جدایی حضرت محمد (مصطفی) سخت شد، خود را از کوه حری به پایین می‌اندازید."],[802,"تا بگفتی جبرئیلش هین مکن","که ترا بس دولتست از امر کن","وقتی جبرئیل به مصطفی (پیامبر اسلام) گفت که به خودت اینطور فشار نیاور، بدان که تو به خاطر فرمان خدا مقام و منزلت زیادی داری."],[802,"مصطفی ساکن شدی ز انداختن","باز هجران آوریدی تاختن","پیامبر (مصطفی) از انداختن و سقوط به آرامش رسید و از دوری و جدایی به شدت نگران شد و دوباره به تندروی و شتاب افتاد."],[802,"باز خود را سرنگون از کوه او","می‌فکندی از غم و اندوه او","جبرئیل از روی کوه حری به پایین می‌افتد و این کار را به خاطر غم و اندوهی که دارد، انجام می‌دهد."],[802,"باز خود پیدا شدی آن جبرئیل","که مکن این ای تو شاه بی‌بدیل","جبرئیل، فرشته وحی، دوباره خود را نمایان کرد و به مصطفی (پیامبر اسلام) گفت که ای پادشاه بی‌نظیر، دست از این کار بکش و ناامیدی را رها کن."],[802,"هم‌چنین می‌بود تا کشف حجاب","تا بیابید آن گهر را او ز جیب","این وضعیت نیز همین‌گونه بود تا پرده‌ها کنار برود و شما آن گوهر را از دامن خود بیابید."],[802,"بهر هر محنت چو خود را می‌کشند","اصل محنتهاست این چونش کشند","هر کسی برای رسیدن به خواسته‌هایش و دور کردن مشکلات، تلاش و زحمت می‌کشد و این سختی‌ها اصل و اساس زحمت‌ها هستند."],[802,"از فدایی مردمان را حیرتیست","هر یکی از ما فدای سیرتیست","هر یک از ما انسان‌ها به خاطر رفتارها و شخصیت‌هایمان شگفت‌زده و حیرت‌زده هستیم، به ویژه که برای بعضی از افراد، فدای شایستگی و سیرت نیکشان می‌شویم."],[802,"ای خنک آنک فدا کردست تن","بهر آن کارزد فدای آن شدن","خوشا به حال کسی که جان خود را برای دستیابی به هدفی بزرگ فدای می‌کند و به خاطر این کار، به مقام والایی می‌رسد."],[802,"هر یکی چونک فدایی فنیست","کاندر آن ره صرف عمر و کشتنیست","هر کس که فدای هنری شده باشد، در آن راه باید عمرش را فدای آن هنر کند و جانش را در این مسیر بگذارد."],[802,"کشتنی اندر غروبی یا شروق","که نه شایق ماند آنگه نه مشوق","در زمان غروب یا سپیده‌دم، هیچ‌کس متقاضی این کار نیست و نه کسی او را تشویق می‌کند."],[802,"باری این مقبل فدای این فنست","کاندرو صد زندگی در کشتنست","این قصیده به نیروی عشق و فداکاری اشاره دارد. به گونه‌ای که کسی که به عشق راستین می‌رسد، حاضر است جان خود را فدای آن کند، زیرا در این عشق، زندگی و شادی‌های زیادی وجود دارد که حتی در سختی‌ها و مرگ نیز احساس می‌شود."],[802,"عاشق و معشوق و عشقش بر دوام","در دو عالم بهرمند و نیک‌نام","عاشق، معشوق، و عشق آن‌ها در دنیا و آخرت همیشه باقی و پرثمر است و نام نیک و خوشی برایشان به جا می‌گذارد."],[802,"یا کرامی ارحموا اهل الهوی","شانهم ورد التوی بعد التوی","ای بزرگواران، به دل‌های عاشقان رحم کنید که پس از سختی و بلایایی که متحمل شده‌اند، به آرامش و نزدیکی نیاز دارند."],[802,"عفو کن ای میر بر سختی او","در نگر در درد و بدبختی او","ای حاکم، به سختی و مشکل او توجه کن و او را از درد و گرفتاری‌اش عفو و ببخش."],[802,"تا ز جرمت هم خدا عفوی کند","زلتت را مغفرت در آکند","اگر خداوند به خاطر خطاهایت از تو بگذرد، رحمت او می‌تواند زجر و گناهت را پوشش دهد و به تو بخشش ببخشد."],[802,"تو ز غفلت بس سبو بشکسته‌ای","در امید عفو دل در بسته‌ای","تو به خاطر غفلت، سبوی خود را شکست‌ و در این میان هنوز امیدوار به عفو هستی، در حالی که دل تو بسته شده است."],[802,"عفو کن تا عفو یابی در جزا","می‌شکافد مو قدر اندر سزا","اگر تو دیگران را عفو کنی، در مقابل نیکوکاری تو، عفو و گذشت نیز نصیبت می‌شود و عذاب و کیفر به اندازه‌ی عمل تو تقسیم می‌شود."],[803,"میر گفت او کیست کو سنگی زند","بر سبوی ما سبو را بشکند","امیر از کسی می‌پرسد که این فرد کیست که با سنگ به سبوی ما حمله‌ور شده و آن را می‌شکند."],[803,"چون گذر سازد ز کویم شیر نر","ترس ترسان بگذرد با صد حذر","وقتی شیر نر از کوه من عبور کند، من بسیار ترسیده و با احتیاط از کنارش عبور می‌کنم."],[803,"بنده ما را چرا آزرد دل","کرد ما را پیش مهمانان خجل","چرا بنده ما دل ما را آزار داد و ما را در برابر مهمانان شرمنده کرد؟"],[803,"شربتی که به ز خون اوست ریخت","این زمان هم‌چون زنان از ما گریخت","شربتی که به قیمت خون او به دست آمده، اکنون مانند زنانی که از ما دور می‌شوند، از دست ما فرار کرده است."],[803,"لیک جان از دست من او کی برد","گیر هم‌چون مرغ بالا بر پرد","اما جان او از دست من نمی‌رود، باید او مانند پرنده‌ای بالا برود و آزاد باشد."],[803,"تیر قهر خویش بر پرش زنم","پر و بال مردریگش بر کنم","من به خاطر خشم و قهر خود، تیر خشم را به سوی او پرتاب می‌کنم و پر و بال او را می‌زنم و می‌تراشم."],[803,"گر رود در سنگ سخت از کوششم","از دل سنگش کنون بیرون کشم","اگر او در سنگ سخت برود، من تلاش می‌کنم و از دل سنگ، او را بیرون می‌آورم."],[803,"من برانم بر تن او ضربتی","که بود قوادکان را عبرتی","من بر او ضربه‌ای می‌زنم که برای قوادکان (دیگر فرماندهان) پند و عبرتی خواهد بود."],[803,"با همه سالوس با ما نیز هم","داد او و صد چو او این دم دهم","با وجود تمام نیرنگ‌ها و فریب‌کاری‌هایی که به کار می‌برد، او نیز به ما داد و راستی می‌گوید که هنوز صد نفر مانند او چنین می‌کنند."],[803,"خشم خون‌خوارش شده بد سرکشی","از دهانش می بر آمد آتشی","خشم او مانند خونی که تشنه انتقام است، به صورت سرکشی و طغیان از دهانش بیرون می‌آید و شعله‌های آتش را به همراه دارد."],[804,"آن شفیعان از دم هیهای او","چند بوسیدند دست و پای او","شفیعان، از شدت ناله و گریه‌اش، چندین بار دست و پای او را بوسیدند."],[804,"کای امیر از تو نشاید کین کشی","گر بشد باده تو بی‌باده خوشی","ای امیر، نمی‌شود که به خاطر کینه‌توزی با تو برخورد شود، زیرا اگر باده تو نباشد، خوشی و شادی هم وجود ندارد."],[804,"باده سرمایه ز لطف تو برد","لطف آب از لطف تو حسرت خورد","باده به خاطر عنایت تو به من داده شده است، اما آب هم که از مهر و محبت توست، حسرت می‌خورد و به من نمی‌رسد."],[804,"پادشاهی کن ببخشش ای رحیم","ای کریم ابن الکریم ابن الکریم","ای رحیم و کریم، پادشاه بزرگوار، با بخل نکردن و بخشندگی خود، به ما رحم کن؛ تو فرزند کریمان هستی که خود نیز کریم و بزرگوارند."],[804,"هر شرابی بنده این قد و خد","جمله مستان را بود بر تو حسد","هر نوع شرابی به وجود تو، که به خاطر قد و قامت زیبایت است، باعث حسادت همه مستان شده است."],[804,"هیچ محتاج می گلگون نه‌ای","ترک کن گلگونه تو گلگونه‌ای","تو نیازی به رنگ و زیبایی گلگون نداری، پس این رنگ و زیبایی که به خود گرفته‌ای را رها کن، زیرا خودت به تنهایی زیبا و دلربا هستی."],[804,"ای رخ چون زهره‌ات شمس الضحی","ای گدای رنگ تو گلگونه‌ها","ای چهره‌ات مانند زهره (درخشش و زیبایی تو همچون زهره) و ای خورشید درخشان (شمس الضحی)، من چون گدا (فقر و نیازمندی) به رنگ تو (زیبایی و شادابی تو) می‌نگرم."],[804,"باده کاندر خنب می‌جوشد نهان","ز اشتیاق روی تو جوشد چنان","شراب که در خمره در حال جوشیدن است، به خاطر اشتیاق دیدن روی تو به صورت نهانی می‌جوشد."],[804,"ای همه دریا چه خواهی کرد نم","وی همه هستی چه می‌جویی عدم","ای دریا، که نماد وسعت و عمق است، تو چه هدفی داری؟ همه وجود (هستی) چگونه می‌خواهد چیزی را که نیست (عدم) جستجو کند؟"],[804,"ای مه تابان چه خواهی کرد گرد","ای که مه در پیش رویت روی‌زرد","ای ماه زیبای درخشان، چه قصدی داری از دوری و غم؟ ای کسی که در مقابلت، چهره‌ام رنگ باخته و زرد شده است."],[804,"تاج کرمناست بر فرق سرت","طوق اعطیناک آویز برت","تاجی که بر سر توست نشان رحمت و بخشش ماست و طوقی که به تو داده‌ایم، برگردنت آویخته شده است."],[804,"تو خوش و خوبی و کان هر خوشی","تو چرا خود منت باده کشی","تو آفرینش زیبا و خوش‌چهره‌ای و منبع هر خوبی هستی، پس چرا خود را گرفتار مشروب و می‌کشی؟"],[804,"جوهرست انسان و چرخ او را عرض","جمله فرع و پایه‌اند و او غرض","انسان دارای جوهر و حقیقتی است که چرخ و کائنات به عنوان جزئی از آن، در حقیقت فرع و وابسته به او می‌باشند و او هدف اصلی و غرض نهایی است."],[804,"ای غلامت عقل و تدبیرات و هوش","چون چنینی خویش را ارزان فروش","ای جوانان، عقل و تدبیر و هوش به خاطر چه کسی، مانند تو، اینقدر بی‌ارزش و ارزان است؟"],[804,"خدمتت بر جمله هستی مفترض","جوهری چون نجده خواهد از عرض","خدمت به تو بر تمام هستی واجب است، زیرا کسی چون نجده (شخصیتی در شعر) از وجود و ماهیت خود به اندازه‌ای که تو داری، برخوردار نیست."],[804,"علم جویی از کتبها ای فسوس","ذوق جویی تو ز حلوا ای فسوس","علم را از کتاب‌ها نجو، ای فسوس! چرا که لذت‌بردن از علم به مانند لذت بردن از حلواست."],[804,"بحر علمی در نمی پنهان شده","در سه گز تن عالمی پنهان شده","در عمق دریای علم، یک انسان دانا وجود دارد که ولی در فقط سه انگشت، به وضوح قابل مشاهده و ارزیابی است."],[804,"می چه باشد یا سماع و یا جماع","تا بجویی زو نشاط و انتفاع","می‌ نوشی چه تفاوتی دارد، لطفی و لذتی که در آن وجود دارد، چه از طریق نوشیدن مستی باشد یا از طریق سماع و رقص، یا از طریق همبستری، تا اینکه بخواهی از این‌ها شادی و بهره‌ای به دست آوری."],[804,"آفتاب از ذره‌ای شد وام خواه","زهره‌ای از خمره‌ای شد جام‌خواه","خورشید (آفتاب) از یک ذره به‌وجود آمد و برای طلب (خواستن) نور و روشنایی است. زهره (Venus یا سیاره زهره) نیز از یک خمره (سپر) به وجود آمده و برای طلب (خواستن) جام و می‌باشد."],[804,"جان بی‌کیفی شده محبوس کیف","آفتابی حبس عقده اینت حیف","جان من در حالت بی‌کیفی گرفتار شده و حالتی شبیه به محبوس دارد. این حالت ناشی از این است که نعمت آفتاب و کیفیت آن، به خاطر عقده‌های درونی‌ام در حبس است و این معضل برایم بسیار نگران‌کننده است."],[805,"گفت نه نه من حریف آن میم","من به ذوق این خوشی قانع نیم","او (امیر) می‌گوید که من حریف آن کسی که عاشق معشوقش باشد، نیستم و به این لذت ناکافی که پیش رو دارم، راضی نیستم."],[805,"من چنان خواهم که هم‌چون یاسمین","کژ همی‌گردم چنان گاهی چنین","من می‌خواهم مانند یاسمن، که به صورت کج و معوج (غیر مستقیم) رشد می‌کند، در حرکت کنم و به سمت‌های مختلف بروم؛ یعنی از مسیر معمول و مستقیم خارج شوم و به طور غیرعادی رفتار کنم."],[805,"وارهیده از همه خوف و امید","کژ همی‌گردم بهر سو هم‌چو بید","از تمام ترس‌ها و امیدها رها شده‌ام و به هر طرف مانند بید که در اثر باد می‌چرخد، نوسان می‌کنم."],[805,"هم‌چو شاخ بید گردان چپ و راست","که ز بادش گونه گونه رقصهاست","من مانند شاخه بید در این سو و آن سو حرکت می‌کنم، چراکه به خاطر تأثیر باد، حرکات مختلفی پیدا می‌کنم."],[805,"آنک خو کردست با شادی می","این خوشی را کی پسندد خواجه کی","اینکه کسی با شادی و سرور خو گرفته، این خوشی را خواجه (آدم مهم یا مقتدر) چگونه می‌تواند پسندیده و مورد توجه قرار دهد؟"],[805,"انبیا زان زین خوشی بیرون شدند","که سرشته در خوشی حق بدند","انبیاء از این نوع خوشی‌ها دور شدند چون که خوشی حقی را از جانب خدا دریافت کرده‌اند."],[805,"زانک جانشان آن خوشی را دیده بود","این خوشیها پیششان بازی نمود","چون جان انبیا خوشی واقعی را قبلا مشاهده کرده بود، این خوشی‌های دنیایی برایشان مانند یک بازی جلوه می‌کرد."],[805,"با بت زنده کسی چون گشت یار","مرده را چون در کشد اندر کنار","وقتی کسی با بت زنده (محبوب زنده) آشنا می‌شود، چگونه می‌تواند یاد یار مرده (محبوب از دست رفته) را کنار بگذارد و فراموش کند."],[806,"آن جهان چون ذره ذره زنده‌اند","نکته‌دانند و سخن گوینده‌اند","در آن جهان، همه چیز به طور جداگانه زنده و باهوش است و از نکات و اسرار آگاهند و توانایی بیان دارند."],[806,"در جهان مرده‌شان آرام نیست","کین علف جز لایق انعام نیست","در دنیای آن‌ها که مرده‌اند، آرامش وجود ندارد، زیرا آن نوع گیاهان تنها برای کسانی که شایسته پاداش و نعمت هستند، می‌رویند."],[806,"هر که را گلشن بود بزم و وطن","کی خورد او باده اندر گولخن","هر کسی که در زندگی‌اش باغ و بهشت و شادی دارد، چگونه ممکن است در این دنیای فانی و زشت (گولخن) میگساری کند و به خوشی‌های زودگذر دنیا روی آورد؟"],[806,"جای روح پاک علیین بود","کرم باشد کش وطن سرگین بود","جایگاه روح‌های پاک در عالم اعلی است، در حالی که کرم و موجودات دیگری که در زباله‌ها و خاک زندگی می‌کنند، جایگاهشان در مکان‌های ناپاک و پست است. در واقع، روح‌های بلند مرتبه در محل‌های نیویدبند و زنده قرار دارند، در حالی که موجودات پست در زباله و سرگین می‌زیند."],[806,"بهر مخمور خدا جام طهور","بهر این مرغان کور این آب شور","به خاطر خواب و غفلت انسان‌ها، خداوند برای آنان شراب پاک و حیات‌بخش را فراهم کرده است، در حالی که این پرندگان (اشاره به انسان‌ها) در دنیای مادی خود به دنبال آب شور و ناخوشایند هستند."],[806,"هر که عدل عمرش ننمود دست","پیش او حجاج خونی عادلست","هر کسی که در دوران زندگی‌اش به عدل و انصاف عمل نکند، در آخرت به دست حجاج (حاکم ظالم) گرفتار خواهد شد، که در اینجا به خون‌آشام یا قاتل عادل اشاره دارد. این نشان می‌دهد که عدم رعایت عدل باعث می‌شود انسان به عذاب و بی‌عدالتی دچار شود."],[806,"دختران را لعبت مرده دهند","که ز لعب زندگان بی‌آگهند","دختران را به عروسکی که مرده است معامله می‌کنند، در حالی که از بازی‌های دختران زنده، بی‌خبر هستند و به آن‌ها اهمیت نمی‌دهند."],[806,"چون ندارند از فتوت زور و دست","کودکان را تیغ چوبین بهترست","زیرا کسانی که از جوانمردی و فداکاری بی‌بهره‌اند، بهتر است که به جای سلاح واقعی، از ابزار بی‌خطر همچون تیغ چوبی استفاده کنند، چرا که در دست کودکان، این ابزار خطر کمتری دارد."],[806,"کافران قانع بنقش انبیا","که نگاریده‌ست اندر دیرها","کافران تنها به تصویر و نقش انبیا (پیامبران) که در معابد و مکان‌های مذهبی کشیده شده است، بسنده می‌کنند."],[806,"زان مهان ما را چو دور روشنیست","هیچ‌مان پروای نقش سایه نیست","این‌جهان برای ما مانند دوری از روشنی است و بی‌اهمیت است که به نقش سایه‌ها توجه کنیم، زیرا ما باید به واقعیت اصلی و روشنی توجه کنیم و نگران چیزهای زودگذر نباشیم."],[806,"این یکی نقشش نشسته در جهان","وآن دگر نقشش چو مه در آسمان","بیت به بیان این نکته می‌پردازد که در این دنیا (جهان) هر چیزی از جمله موجودات و اشیاء، نقشی دارد که به آن معنا و وجود می‌بخشد. همچنین، در دنیای دیگر (آسمان) نقش‌ها و حقیقت‌ها بسیار بالاتر و معنوی‌تر هستند، مانند نور ماه که در آسمان می‌درخشد."],[806,"این دهانش نکته‌گویان با جلیس","و آن دگر با حق به گفتار و انیس","در این بیت به این موضوع اشاره می‌شود که برخی انسان‌ها (یا موجودات) در این دنیا با دیگران به گفت‌و‌گو و تبادل نظر می‌پردازند و نکته‌های مهمی را بیان می‌کنند، در حالی که برخی دیگر با خداوند به گفتگو می‌پردازند و این انس و صحبت برای آن‌ها بسیار معنوی و عمیق است."],[806,"گوش ظاهر این سخن را ضبط کن","گوش جانش جاذب اسرار کن","گوش ظاهری خود را برای شنیدن این سخن آماده کن و در عین حال، گوش جانت را برای دریافت و جذب اسرار عمیق و معنوی این کلام فعال کن."],[806,"چشم ظاهر ضابط حلیه بشر","چشم سر حیران مازاغ البصر","چشم ظاهری فقط به زیبایی‌های دنیایی که انسان‌ها دارند می‌نگرد و از آن حیرت‌زده می‌شود، اما چشم باطنی که آگاهی و درک عمیق‌تری دارد، به چیزهایی فراتر از مادیات توجه می‌کند."],[806,"پای ظاهر در صف مسجد صواف","پای معنی فوق گردون در طواف","پای انسان در ظاهر، در صف نمازگزاران در مسجد است، اما پای حقیقت و معنا، در دور گردونه وجود به طواف مشغول است. این اشاره به این دارد که زندگی ظاهری تنها یک روی سکه است و حقیقت عمیق‌تری در جریان است."],[806,"جزو جزوش را تو بشمر هم‌چنین","این درون وقت و آن بیرون حین","هر جزئی از وجود خود را بشمار و به همین ترتیب، این زمان درون را و آن زمان بیرون را نیز در نظر بگیر."],[806,"این که در وقتست باشد تا اجل","وان دگر یار ابد قرن ازل","این زمان، موقتی است تا صورت اجل فرا برسد و در آن زمان، یار ابدی، به طور جاودانه و از ازل به نزد ما خواهد آمد."],[806,"هست یک نامش ولی الدولتین","هست یک نعتش امام القبلتین","یکی از نام‌های او، ولی‌الدولتین است و یکی از صفاتش، امام القبلتین. این تعبیرها به مقام و شخصیت بلند او اشاره دارند، که در عالم معنوی و دینی مورد احترام و توجه است."],[806,"خلوت و چله برو لازم نماند","هیچ غیمی مر ورا غایم نماند","در دنیای آخرت، نیازی به انزوا و دوری از دیگران نیست، زیرا در آنجا هیچ چیزی مخفی نخواهد ماند و همه چیز آشکار و روشن است."],[806,"قرص خورشیدست خلوت‌خانه‌اش","کی حجاب آرد شب بیگانه‌اش","خلوت‌خانه خورشید مانند یک قرص بزرگ است و حجاب شب نمی‌تواند از نور و روشنایی آن جلوگیری کند. در اینجا، خورشید نماد روشنایی و حقیقت است که در برابر تاریکی شب و بیگانگی مقاوم است."],[806,"علت و پرهیز شد بحران نماند","کفر او ایمان شد و کفران نماند","وقتی علل و دلایل (متعالی) و دوری از شرک و کفر ایجاد شود، دیگر جای نگرانی نیست؛ زیرا کفر به ایمان تبدیل می‌شود و ایمان نمی‌تواند دچار انکار یا کفر شود."],[806,"چون الف از استقامت شد به پیش","او ندارد هیچ از اوصاف خویش","وقتی که الف (نشانه استقامت و پایداری) به جلو می‌رود، دیگر هیچ‌یک از صفات و ویژگی‌های خود را ندارد. این نشان‌دهنده این است که در مسیر رشد و ترقی، انسان باید از ویژگی‌های محدود کننده خود عبور کند."],[806,"گشت فرد از کسوه خوهای خویش","شد برهنه جان به جان‌افزای خویش","انسان وقتی به صفات نیک و خوب خود آشنا می‌شود و از زرق و برق دنیوی دست می‌کشد، از قید و بندهای دنیایی آزاد می‌شود و به حقیقت وجود و معنای واقعی خود پی می‌برد."],[806,"چون برهنه رفت پیش شاه فرد","شاهش از اوصاف قدسی جامه کرد","زمانی که فرد برهنه به حضور شاه می‌رود، شاه با ویژگی‌های الهی و قدسی‌اش او را به لباس و جامه‌ای آراسته می‌کند."],[806,"خلعتی پوشید از اوصاف شاه","بر پرید از چاه بر ایوان جاه","کس به اوصاف خداوند، جامه‌ای از فضایل و خصائص گرفت و از چاه دنیا به رفیع‌ترین مقام رسید و بر سر ایوان بزرگی و شرف قرار گرفت."],[806,"این چنین باشد چو دردی صاف گشت","از بن طشت آمد او بالای طشت","وقتی درد و رنج به وضوح و روشنی در دل انسان جاری می‌شود، او به آرامی و به تدریج از عمق مشکلات و سختی‌ها بیرون می‌آید و به سطح زندگی و به روشنایی نزدیک می‌شود."],[806,"در بن طشت از چه بود او دردناک","شومی آمیزش اجزای خاک","این بیت از مولانا به این معناست که در عمق زندگی و جهان مادی، درد و رنج نهفته است. این رنج به دلیل آمیختگی و ترکیب اجزای خاک است که نشان می‌دهد زندگی مادی، با مشکلات و ناراحتی‌ها همراه است."],[806,"یار ناخوش پر و بالش بسته بود","ورنه او در اصل بس برجسته بود","یار ناشاد و بی‌قرار بود و مژدگانی او به خاطر محدودیت‌ها و مشکلاتش به چشم نمی‌آمد، در حالی که در ذات و اصل خود بسیار با ارزش و برجسته بود."],[806,"چون عتاب اهبطوا انگیختند","هم‌چو هاروتش نگون آویختند","به دلیل توبیخی که به فرشتگان شد، آنان هم‌چون هاروت، که به خاطر خطایش پایین آورده شد، به حالت ذلت و افتادگی در آمدند."],[806,"بود هاروت از ملاک آسمان","از عتابی شد معلق هم‌چنان","هاروت، که یکی از ملائکه آسمانی است، به خاطر یک توبیخ (عتاب) در وضعیتی معلق و آویزان قرار گرفت و همچنان در این حالت باقی ماند."],[806,"سرنگون زان شد که از سر دور ماند","خویش را سر ساخت و تنها پیش راند","چون از سر دور شد، به دلیل سقوطش، تصمیم گرفت خود را به تنهایی بسازد و به جلو برود."],[806,"آن سپد خود را چو پر از آب دید","کرد استغنا و از دریا برید","وقتی آن سپر (درباره مردی صحبت می‌کند که به شجاعت و توانایی خود متکی شده و از دیگران فاصله گرفته) را دید که از آب پر شده، به این نتیجه رسید که دیگر به دریا (یعنی لطف و رحمت الهی) نیازی ندارد و از آن جدا شد."],[806,"بر جگر آبش یکی قطره نماند","بحر رحمت کرد و او را باز خواند","تمام آب موجود در جگر (وجود انسان) به خاطر رحمت الهی و لطف خداوند، دریاگون (بی‌نهایت) است و او (خدا) این انسان را بار دیگر به زندگی و حیات برمی‌گرداند."],[806,"رحمتی بی‌علتی بی‌خدمتی","آید از دریا مبارک ساعتی","رحمت خداوند بدون هیچ دلیلی و بدون انتظاری از خدمت و زحمتی، همچون آبی که از دریا به سمت زمین می‌آید، در زمانی مبارک فرامی‌رسد."],[806,"الله الله گرد دریابار گرد","گرچه باشند اهل دریابار زرد","خداوند، خداوند است، حتی اگر اهل دریا و بندگانش زرد و بی‌روح باشند. این اشاره به این دارد که حقیقت الهی و جمال او همواره وجود دارد و به شرایط دنیوی وابسته نیست."],[806,"تا که آید لطف بخشایش‌گری","سرخ گردد روی زرد از گوهری","زمانی که لطف و بخشایش خداوند بوجود آید، روی زرد (استعاره از حالتی ناراحت یا خسته) به سرخی (نشانه‌ای از شادمانی و زندگی) تبدیل می‌شود، مثل گوهری که درخشندگی و زیبایی‌اش را نشان می‌دهد."],[806,"زردی رو بهترین رنگهاست","زانک اندر انتظار آن لقاست","زردی چهره، نشان خوبی است، زیرا آدمی در انتظار دیدار معشوق و خداوند است."],[806,"لیک سرخی بر رخی که آن لامعست","بهر آن آمد که جانش قانعست","اما در چهره‌ای که درخشان و زیباست، سرخی و جذابیت وجود دارد، زیرا آن به خاطر وجود جان و روحی است که در آن ساکن است و او به زندگی و زیبایی قانع است."],[806,"که طمع لاغر کند زرد و ذلیل","نیست او از علت ابدان علیل","طمع و حرص باعث می‌شود که انسان زرد و ذلیل به نظر بیاید، اما این زشتی ناشی از بیماری جسمی نیست؛ بلکه از رنج و ضعف روحی است."],[806,"چون ببیند روی زرد بی‌سقم","خیره گردد عقل جالینوس هم","اگر عقل جالینوس (پزشک معروف یونانی) چهره‌ای زرد و بیمارگونه ببیند، حیرت‌زده و متعجب می‌شود. این حیرت نشان‌دهنده عجز و ناتوانی در درک وضعیت دچار بیماری یا ضعف و سردی جسمی است."],[806,"چون طمع بستی تو در انوار هو","مصطفی گوید که ذلت نفسه","وقتی به نورها و فضائل محمد (مصطفی) وابسته شده‌ای، او به تو می‌گوید که این وابستگی باعث ذلت نفس تو شده است."],[806,"نور بی‌سایه لطیف و عالی است","آن مشبک سایه غربالی است","نور بدون سایه، نور لطیف و بلندمرتبه‌ای است، اما سایه‌ای که به آن مربوط می‌شود، مانند مشبک و شبکه‌ای است که در غربال دیده می‌شود."],[806,"عاشقان عریان همی‌خواهند تن","پیش عنینان چه جامه چه بدن","عاشقان واقعی که از دنیا و ظواهر آن بی‌نیازند، در حضور معشوقان مخلص، به تن و لباس نیازی ندارند. آنها تنها به معشوق و عشق او توجه دارند و برایشان ظاهر و جسم اهمیتی ندارد."],[806,"روزه‌داران را بود آن نان و خوان","خرمگس را چه ابا چه دیگدان","روزه‌داران فقط از نان و روزه خود لذت می‌برند، در حالی‌که خرمگس (مگس) به غذا چه دیگ (پلو) و چه suje (غذا) توجهی ندارد و فقط به دنبال خوردن است. این بیت اشاره به این دارد که افراد متعهد و با ایمان (روز‌ه‌داران) لذایذ خاصی دارند که برای آنها مهم است، اما دیگران (مثل خرمگس) فقط به دنبال مصرف و لذت‌جویی هستند."],[807,"این سخن از حد و اندازه‌ست بیش","ای ایاز اکنون بگو احوال خویش","این جمله از مولانا به ایاز می‌گوید که سخن او فراتر از حد و اندازه است و به همین دلیل از او می‌خواهد که وضعیت و احوال خود را بیان کند."],[807,"هست احوال تو از کان نوی","تو بدین احوال کی راضی شوی","آیا با این وضع، تو از حال و احوال نیکو و ظرفیت درونی‌ات راضی خواهی بود؟"],[807,"هین حکایت کن از آن احوال خوش","خاک بر احوال و درس پنج و شش","ایاز از شاه می‌خواهد تا داستان خوشی‌های روحانی و حقیقت‌های عمیق را که فراتر از دنیا و مسائل مادّی هستند، بیان کند و بگوید که چگونه می‌توان این خوشی‌ها را در کنار مشکلات دنیوی شناسایی کرد. اینجا به یادآوری درس‌های مهم و آموزه‌های زندگی نیز اشاره می‌شود."],[807,"حال باطن گر نمی‌آید بگفت","حال ظاهر گویمت در طاق وجفت","اگر واقعیت درونی و باطنی من روشن نشود، حالا به حالت ظاهری و ظاهری خودم اشاره می‌کنم."],[807,"که ز لطف یار تلخیهای مات","گشت بر جان خوشتر از شکرنبات","از لطف و محبت محبوب، تلخی‌ها و سختی‌هایی که بر جان من می‌آید، برایم خوش‌تر و شیرین‌تر از شکر نبات است."],[807,"زان نبات ار گرد در دریا رود","تلخی دریا همه شیرین شود","اگر آن نبات (شکر) به دریا بریزد، تلخی دریا به خاطر شیرینی آن شکر ناپدید می‌شود و دریا نیز شیرین می‌گردد."],[807,"صدهزار احوال آمد هم‌چنین","باز سوی غیب رفتند ای امین","صدها هزار حالت و وضعیت به همین شکل پیش آمد، و همه به سوی غیب و دنیای ناپیدا رفتند، ای امین (ای کسی که قابل اعتماد هستی)."],[807,"حال هر روزی بدی مانند نی","هم‌چو جو اندر روش کش بند نی","حال هر روز مانند نی است که همواره در حال تغییر و نوسان است، همان‌طور که نی در جریان آب حرکت می‌کند و ارتباطش با جریان آب او را تحت تاثیر قرار می‌دهد."],[807,"شادی هر روز از نوعی دگر","فکرت هر روز را دیگر اثر","هر روز شادی و خوشحالی از نوعی جدید به دست می‌آید و فکر و اندیشه انسان نیز در هر روز تأثیر متفاوتی دارد."],[808,"هست مهمان‌خانه این تن ای جوان","هر صباحی ضیف نو آید دوان","این بدن مانند یک مهمان‌خانه است، ای جوان، که هر روز مسافر تازه‌ای به آن وارد می‌شود."],[808,"هین مگو کین ماند اندر گردنم","که هم اکنون باز پرد در عدم","نگو که این بار گران بر دوش من باقی‌مانده است، زیرا در همین لحظه، پرده‌ها کنار رفته و به عدم (عدم وجود) باز می‌گردد."],[808,"هرچه آید از جهان غیب‌وش","در دلت ضیفست او را دار خوش","هر چیزی که از جهان پنهان و ناپیدا به قلبت راه پیدا می‌کند، مهمان است؛ او را با خوش‌رویی و احترام بپذیر."],[809,"آن یکی را بیگهان آمد قنق","ساخت او را هم‌چو طوق اندر عنق","ناگهان شخصی به جمع مهمانان اضافه شد و باعث شد که همه او را فراموش کنند، مانند طوقی که به دور گردن دیگران حلقه شده باشد و موجب ایجاد محدودیت در آن‌ها شود."],[809,"خوان کشید او را کرامتها نمود","آن شب اندر کوی ایشان سور بود","در آن شب مهمان را با احترام پذیرایی کردند و در محله آن‌ها جشن و سروری برپا بود."],[809,"مرد زن را گفت پنهانی سخن","که امشب ای خاتون دو جامه خواب کن","مرد به زن گفت که به طور پنهانی صحبت کند و از او خواست که امشب دو لباس برای خواب آماده کند."],[809,"پستر ما را بگستر سوی در","بهر مهمان گستر آن سوی دگر","ما را به سوی در، یعنی به سمت درب، دعوت کن تا بساط مهمان در آن سوی دیگر نیز گسترده شود."],[809,"گفت زن خدمت کنم شادی کنم","سمع و طاعه ای دو چشم روشنم","زن گفت که من برای مهمان خدمت می‌کنم و با شادی از او پذیرایی می‌کنم؛ دو چشمان روشنی (محبوب) دارم که در فرمانبرداری و شنیدن است."],[809,"هر دو پستر گسترید و رفت زن","سوی ختنه‌سور کرد آنجا وطن","زنان در خانه سفره‌ای گذاشتند و یکی از آنها به سوی جشن ختنه‌سور (جشنی برای ختنه پسران) رفت، جایی که وطن او محسوب می‌شود."],[809,"ماند مهمان عزیز و شوهرش","نقل بنهادند از خشک و ترش","مهمان گرامی و شوهرش در مورد مسائلی از زندگی، حال و روز سختی‌ها و راحتی‌های خود صحبت کردند."],[809,"در سمر گفتند هر دو منتجب","سرگذشت نیک و بد تا نیم شب","در میهمانی، مهمان و همسرش با هم در مورد سرنوشت خوب و بد خود صحبت کردند تا نیمه‌شب."],[809,"بعد از آن مهمان ز خواب و از سمر","شد در آن پستر که بد آن سوی در","مهمان بعد از بیدار شدن و گفتگو کردن، به سمت پستی که در آنجا قرار داشت رفت."],[809,"شوهر از خجلت بدو چیزی نگفت","که ترا این سوست ای جان جای خفت","شوهر از شرم نتوانست چیزی به مهمان بگوید و به او گفت که اینجا جایی برای خوابیدن نیست."],[809,"که برای خواب تو ای بوالکرم","پستر آن سوی دگر افکنده‌ام","او به مهمان می‌گوید که برای راحتی خواب تو، ای بوالکرم (لقب کسی)، یک بستر در سوی دیگر خانه آماده کرده‌ام."],[809,"آن قراری که به زن او داده بود","گشت مبدل و آن طرف مهمان غنود","قراری که مرد به همسرش داده بود، تغییر کرد و نتیجه‌اش این شد که مهمان در آن سوی خانه خوابش برد."],[809,"آن شب آنجا سخت باران در گرفت","کز غلیظی ابرشان آمد شگفت","آن شب باران شدیدی بارید که به خاطر غلظت ابرها، حیرت‌انگیز بود."],[809,"زن بیامد بر گمان آنک شو","سوی در خفتست و آن سو آن عمو","زن فکر کرد که شوهرش نزد در خوابیده است و آن طرف، عموی او نیز در آنجا است."],[809,"رفت عریان در لحاف آن دم عروس","داد مهمان را به رغبت چند بوس","عروس در حالی که برهنه در زیر لحاف بود، با اشتیاق مهمان را چندین بار بوسید."],[809,"گفت می‌ترسیدم ای مرد کلان","خود همان آمد همان آمد همان","مهمان به مردی بزرگ‌تر از خود می‌گوید که می‌ترسیده و حالا آنچه می‌ترسیده، حاضر شده است."],[809,"مرد مهمان را گل و باران نشاند","بر تو چون صابون سلطانی بماند","مرد مهمان در شرایط بارانی و گل آلود، مانند صابون سلطانی بر تو تأثیر می‌گذارد و تو را در این وضعیت رها می‌کند و به هیچ‌وجه نمی‌تواند از آن خارج شود."],[809,"اندرین باران و گل او کی رود","بر سر و جان تو او تاوان شود","در این باران و گل، آیا او بر سر و جان تو نمی‌افتد (و آسیب نمی‌زند)، و آیا تاوان و خسارتی بر تو تحمیل نمی‌شود؟"],[809,"زود مهمان جست و گفت این زن بهل","موزه دارم غم ندارم من ز گل","مهمان سریع از خانه خارج شد و گفت: \"این زن را رها کن، من نگران نیستم چون از گل (پاشیده شدن گل و گل) ناراحتی ندارم."],[809,"من روان گشتم شما را خیر باد","در سفر یک دم مبادا روح شاد","من به سفر روان شدم و برای شما آرزوی خیر و موفقیت در این سفر را دارم و امیدوارم که همیشه روح‌تان شاد باشد."],[809,"تا که زوتر جانب معدن رود","کین خوشی اندر سفر ره‌زن شود","تا زمانی که به معدن خوشی (منبع شادی و خوشبختی) نرسیده‌ام، بر اثر شتاب و عجله ممکن است خوشی در سفر از انسان دور شود."],[809,"زن پشیمان شد از آن گفتار سرد","چون رمید و رفت آن مهمان فرد","زن از گفتار بی‌احساسی‌اش پشیمان شد و وقتی دید مهمان با حالتی ناراضی رفته، او هم از آنجا رفت."],[809,"زن بسی گفتش که آخر ای امیر","گر مزاحی کردم از طیبت مگیر","زن بسیار به او گفت که ای امیر، اگر من در شوخی با تو چیزی گفتم، از لطافت و مهربانی‌ات نکا‌ه‌دار نباش."],[809,"سجده و زاری زن سودی نداشت","رفت و ایشان را در آن حسرت گذاشت","زن با سجده و ناله تلاش کرد که اهمیت خود را نشان دهد، اما این درخواست او بی‌نتیجه ماند و او را در حسرت باقی گذاشت."],[809,"جامه ازرق کرد زان پس مرد و زن","صورتش دیدند شمعی بی‌لگن","آن مرد و زن بعد از آنکه وضعیت را دیدند، جامه‌ای آبی بر تن کرد و صورتش به گونه‌ای شد که مانند شمعی بود بی‌فروغ و گنگ، به طوری که نور و درخشندگی نداشت."],[809,"می‌شد و صحرا ز نور شمع مرد","چون بهشت از ظلمت شب گشته فرد","حضور نور شمع مرد در صحرا آن‌قدر روشن و دل‌نشین می‌شود که مانند بهشتی است که در تاریکی شب به وجود می‌آید."],[809,"کرد مهمان خانه خانه خویش را","از غم و از خجلت این ماجرا","مهمان در خانه‌اش، به خاطر غم و شرمساری از اتفاقی که افتاده، خود را به حالتی نگران و ناخوشایند می‌بیند."],[809,"در درون هر دو از راه نهان","هر زمان گفتی خیال میهمان","در دل هر دو یعنی صاحبخانه و مهمان، به طور پنهانی، همواره این فکر وجود دارد که مهمان در اینجا است."],[809,"که منم یار خضر صد گنج و جود","می‌فشاندم لیک روزیتان نبود","من منبع خیر و برکت و دانشی مانند خضر هستم و هر زمان دست‌گیری و سخاوت می‌کنم، اما شما از روزی و نعمت من بی‌بهره شده‌اید."],[810,"هر دمی فکری چو مهمان عزیز","آید اندر سینه‌ات هر روز نیز","هر لحظه فکری مانند یک مهمان باارزش به درون دل تو می‌آید و در سینه‌ات جای می‌گیرد."],[810,"فکر را ای جان به جای شخص دان","زانک شخص از فکر دارد قدر و جان","ای جان، فکر را مانند یک شخص مهم و ارزشمند در نظر بگیر، زیرا انسان به واسطه فکر خود است که ارزش و وجود واقعی‌اش مشخص می‌شود."],[810,"فکر غم گر راه شادی می‌زند","کارسازیهای شادی می‌کند","فکر اگر غم و اندوهی به جان می‌آورد، همانند راهی است که به شادی می‌رسد و می‌تواند کارهایی انجام دهد که موجب شادی شود."],[810,"خانه می‌روبد به تندی او ز غیر","تا در آید شادی نو ز اصل خیر","انسان باید از افکار منفی و غم‌انگیز خود دوری کند و آنها را به سرعت از دل بزداید تا شادی و خوشحالی جدیدی به زندگی‌اش راه یابد، زیرا این شادی از نیکی و خیر سرچشمه می‌گیرد."],[810,"می‌فشاند برگ زرد از شاخ دل","تا بروید برگ سبز متصل","دل در ابتدای احساس غم و اندوه، با اندیشه‌های منفی و ناامیدی مانند برگ‌های زرد خشکیده است. اما اگر این اندیشه‌ها دور ریخته شوند، جوانه‌های امید و خوشبختی، شبیه برگ‌های سبز و تازه، بار دیگر رشد خواهند کرد."],[810,"می‌کند بیخ سرور کهنه را","تا خرامد ذوق نو از ما ورا","خودپسندی و غرور قدیمی را از بین می‌برد تا لذت و ذوق تازه‌ای از ما بیرون بیاید."],[810,"غم کند بیخ کژ پوسیده را","تا نماید بیخ رو پوشیده را","غم، ریشه‌ی ناخرسند و کهنه را برمی‌کند تا ریشه‌ی سرزنده و نیکو را نشان دهد."],[810,"غم ز دل هر چه بریزد یا برد","در عوض حقا که بهتر آورد","هر غمی که از دل انسان کنار برود یا از او دور شود، به درستی چیزی بهتر و ارزشمندتر به جای آن خواهد آمد."],[810,"خاصه آن را که یقینش باشد این","که بود غم بنده اهل یقین","غم کسی که به یقین می‌داند بنده خداوند است، به ویژه برای او خصوصیت دارد. این شخص از غم‌های دنیا مطمئن و بی‌نیاز است."],[810,"گر ترش‌رویی نیارد ابر و برق","رز بسوزد از تبسمهای شرق","اگر کسی بدخلق باشد، مثل ابر و برق به خاطر لطافت و زیبایی گل رز نمی‌تواند دوام بیاورد و از تبسم‌های دل‌انگیز صبحگاهی از بین می‌رود."],[810,"سعد و نحس اندر دلت مهمان شود","چون ستاره خانه خانه می‌رود","خوشبختی و بدبختی مانند مهمانانی در قلب انسان می‌آیند و مانند ستاره‌ها، به تدریج در زندگی ما جای می‌گیرند."],[810,"آن زمان که او مقیم برج تست","باش هم‌چون طالعش شیرین و چست","زمانی که او (فکر) در دل تو ساکن می‌شود، مانند آن است که طالع تو خوش و فعال است."],[810,"تا که با مه چون شود او متصل","شکر گوید از تو با سلطان دل","وقتی که آن شخص با مه (معشوق یا زیبایی) پیوند برقرار کند، از تو (خدا یا معشوق) با دل خوشی و شکرگزاری سخن می‌گوید."],[810,"هفت سال ایوب با صبر و رضا","در بلا خوش بود با ضیف خدا","ایوب، پیامبری که هفت سال در سختی و بلا زندگی کرد، با صبر و آرامش نسبت به وضعیت خود، در مقابل خداوند خوشحال و راضی بود."],[810,"تا چو وا گردد بلای سخت‌رو","پیش حق گوید به صدگون شکر او","ایوب هنگامی که بلا و سختی به او روی می‌آورد، در برابر خداوند، به شکرگزاری و سپاس‌گزاری می‌پردازد و این شکر را به صد زبان ابراز می‌کند."],[810,"کز محبت با من محبوب کش","رو نکرد ایوب یک لحظه ترش","محبوبی که به او عشق می‌ورزد، حتی در سخت‌ترین لحظات و مشکلات هم از خود ناراحتی نشان نمی‌دهد و در برابر ایوب (پیامبر آزموده‌) یک لحظه هم بدخلقی نمی‌کند."],[810,"از وفا و خجلت علم خدا","بود چون شیر و عسل او با بلا","وفا و خجالت از علم و آگاهی خدا ناشی می‌شود؛ مانند شیر و عسل که طعم خوبی دارند ولی هر دو می‌توانند به بلا و مشکلاتی نیز دلالت کنند."],[810,"فکر در سینه در آید نو به نو","خند خندان پیش او تو باز رو","فکر تازه‌وارد هر روز به دل انسان راه می‌یابد و برای او مانند مهمان خوش‌رویی است که باید به او خوش‌آمد گفت و از او استقبال کرد."],[810,"که اعذنی خالقی من شره","لا تحرمنی انل من بره","از خداوند خالق می‌خواهم مرا از شر و مضرات فکرهای بد و ناخواسته حفظ کند و همچنین از خوبی‌های او محرومم نسازد."],[810,"رب اوزعنی لشکر ما اری","لا تعقب حسرة لی ان مضی","این بیت به نوعی وصیت و درخواست از خداوند اشاره دارد که خداوند او را از حسرت و پشیمانی در بر آوردن خواسته‌ها و آرزوهایش محفوظ دارد و سپاسگزاری کند که از بی‌نصیب ماندن خود جلوگیری شود. این حسرت، ناشی از نرسیدن به آرزوها و اهدافی است که انسان در طول زندگی خود دارد."],[810,"آن ضمیر رو ترش را پاس‌دار","آن ترش را چون شکر شیرین شمار","باید با چهره‌ای گشاده و خوش برخورد با دیگران روبه‌رو شوی و هرگونه بدخلقی یا رفتار نیکوکارانه را به سادگی و شیرینی تحمل کنی."],[810,"ابر را گر هست ظاهر رو ترش","گلشن آرنده‌ست ابر و شوره‌کش","اگر ابر به ظاهر اخم و روی ترش داشته باشد، در واقع به نفع گلستان و باغ می‌بارد و باعث رشد و آبادانی آن می‌شود. بنابراین، ظاهر ناخوشایند ابر نباید ما را فریب دهد، زیرا کارش مفید است."],[810,"فکر غم را تو مثال ابر دان","با ترش تو رو ترش کم کن چنان","فکر غم را مانند ابر تصور کن؛ هر چه کمتر در چهره‌ات ناراحتی نشان دهی، کمتر بر تو تاثیر می‌گذارد."],[810,"بوک آن گوهر به دست او بود","جهد کن تا از تو او راضی رود","اگر آن گوهر (فکر خوب یا خوشی) در دست تو باشد، باید تلاش کنی تا او (فکر خوب) از تو راضی و خوشنود شود."],[810,"ور نباشد گوهر و نبود غنی","عادت شیرین خود افزون کنی","اگر حتی گوهر (خیر و ارزش) و ثروت (غنی) وجود نداشته باشد، باید عادت شیرین خود را (یعنی خوبی‌ها و سلوک نیک) افزایش دهی."],[810,"جای دیگر سود دارد عادتت","ناگهان روزی بر آید حاجتت","عادت و رفتار خوب تو در یک موقعیت دیگر می‌تواند به تو کمک کند و روزی به ناگاه نیاز تو را برآورده کند."],[810,"فکرتی کز شادیت مانع شود","آن به امر و حکمت صانع شود","اگر فکری باشد که مانع شادی‌ات شود، آن فکر در واقع به دستور و حکمت خداوند ایجاد شده است."],[810,"تو مخوان دو چار دانگش ای جوان","بوک نجمی باشد و صاحب‌قران","ای جوان، از این دوچار (مشکلات و محنت‌ها) نام مبر، شاید آن پدیده از نظر تو کم‌ارزش باشد، اما در واقع، ممکن است به مانند ستاره‌ای درخشان یا دارای مقامات و فضائل بلندی باشد."],[810,"تو مگو فرعیست او را اصل گیر","تا بوی پیوسته بر مقصود چیر","نگو که آن موضوع یا مسئله‌ای که تو به آن اشاره می‌کنی فرعی و جزئی است، بلکه اصل را در نظر بگیر، زیرا پیوستگی و ارتباطی که دارد، در نهایت به هدف و مقصود اصلی نزدیک‌تر می‌شود."],[810,"ور تو آن را فرع گیری و مضر","چشم تو در اصل باشد منتظر","اگر تو آن چیز را که فرعی است در نظر بگیری و مضر بودن آن را نیز در اصل بدان، در واقع چشم تو همیشه بر روی آن در انتظارش خواهد بود."],[810,"زهر آمد انتظار اندر چشش","دایما در مرگ باشی زان روش","انتظار مرگ، مانند زهر است که به طور مداوم در چشم انسان باقی می‌ماند. این حالت انسان را در اضطراب و نشستن در کنار مرگ نگه می‌دارد."],[810,"اصل دان آن را بگیرش در کنار","بازره دایم ز مرگ انتظار","اصل این موضوع را درک کن که انتظار مرگ همیشه در کنار تو حضور دارد و باید به آن توجه کنی."],[811,"ای ایاز پر نیاز صدق‌کیش","صدق تو از بحر و از کوهست بیش","ای ایاز، تو که همواره نیازمند هستی و با نیت خالص و راستین خود در جست‌وجوی حقیقت، صداقت تو بیشتر از دریا و کوه است."],[811,"نه به وقت شهوتت باشد عثار","که رود عقل چو کوهت کاه‌وار","در زمان شهوت و هوس، عقل تو آسیب نخواهد دید و مانند کوهی استوار می‌ماند و تحقیر نمی‌شود."],[811,"نه به وقت خشم و کینه صبرهات","سست گردد در قرار و در ثبات","در زمان خشم و کینه، صبر و استقامت انسان کم‌زور می‌شود و نمی‌تواند در تحمل و پایداری خود ثابت‌قدم بماند."],[811,"مردی این مردیست نه ریش و ذکر","ورنه بودی شاه مردان کیر خر","مرد واقعی کسی است که دارای ویژگی‌های درونی و معنوی است و صرف ریش و ظاهر فیزیکی او را مرد نمی‌کند، در غیر این صورت او فقط یک حیوان (خر) می‌شود و اینکه در درونش چیزی از مردانگی ندارد."],[811,"حق کرا خواندست در قرآن رجال","کی بود این جسم را آنجا مجال","در قرآن به مردانی که در روح و معنویت برترند اشاره شده، پس این جسم مادی در آنجا جایگاهی ندارد."],[811,"روح حیوان را چه قدرست ای پدر","آخر از بازار قصابان گذر","مردم باید بدانند که روح حیوانات چه ارزشی دارد، ای پدر، چون در نهایت پس از کشتار آنها، فقط از بازار قصابان عبور می‌کنند."],[811,"صد هزاران سر نهاده بر شکم","ارزشان از دنبه و از دم کم","بسیاری از موجودات (رسانه‌های مختلف) وجود دارند که برای شکم خود به طمع دنبه و چربی می‌افتند و از نعمت‌های موجود در دنیا بهره‌برداری می‌کنند."],[811,"روسپی باشد که از جولان کیر","عقل او موشی شود شهوت چو شیر","زنی که به فعالیت‌های ناپسند مشغول است، با وجود قدرت عقلش، به خاطر شهوت به موجودی کوچک و ضعیف مانند موش تبدیل می‌شود، در حالی که شهوت مانند شیر قوی و غران است."],[812,"خواجه‌ای بودست او را دختری","زهره‌خدی مه‌رخی سیمین‌بری","خواجه‌ای (مردی محترم و برجسته) بود که دختری داشت به نام زهره، که صورتش همچون ماه و موهایش نقره‌ای بود."],[812,"گشت بالغ داد دختر را به شو","شو نبود اندر کفائت کفو او","دختر به سن بلوغ رسید و پدرش او را به شوهرش داد، ولی او (شوهر) از نظر شایستگی و لیاقت با دختر هم‌تراز نیست."],[812,"خربزه چون در رسد شد آبناک","گر بنشکافی تلف گردد هلاک","وقتی خربزه به مرحله رسیدن می‌رسد، آبدار و رقیق می‌شود. اما اگر آن را نشکافیم، به سرعت خراب شده و از بین می‌رود."],[812,"چون ضرورت بود دختر را بداد","او بناکفوی ز تخویف فساد","چون ضرورت پیش آمد، پدر دختر او را به شوهر داد تا از ترس فساد اخلاقی، دچار مشکل نشود و از او دوری کند."],[812,"گفت دختر را کزین داماد نو","خویشتن پرهیز کن حامل مشو","پدر به دخترش می‌گوید که از داماد جدید خود دوری کن و حامله نشو."],[812,"کز ضرورت بود عقد این گدا","این غریب‌اشمار را نبود وفا","برای این گدا (یعنی داماد) که در نظر تو غریب و مهمان است، ازدواج از روی ضرورت اتفاق افتاده و او وفادار نخواهد بود."],[812,"ناگهان بجهد کند ترک همه","بر تو طفل او بماند مظلمه","ناگهان همسر تو به خاطر تو همه‌چیز را رها می‌کند و کودک تو با حالتی مظلوم باقی می‌ماند."],[812,"گفت دختر کای پدر خدمت کنم","هست پندت دل‌پذیر و مغتنم","دختر به پدر می‌گوید: «پدر، من آماده‌ام تا به خدمت تو بپردازم، زیرا نصایح تو برای من عزیز و ارزشمند است."],[812,"هر دو روزی هر سه روزی آن پدر","دختر خود را بفرمودی حذر","پدر دختر هر روز یا هر سه روز یک‌بار به او توصیه می‌کرد که از باردار شدن خودداری کند."],[812,"حامله شد ناگهان دختر ازو","چون بود هر دو جوان خاتون و شو","دختر به طور ناگهانی از شوهرش حامله شد، در حالی که هر دو جوان بودند."],[812,"از پدر او را خفی می‌داشتش","پنج ماهه گشت کودک یا که شش","پدر دختر در پنج یا شش ماهگی او را از خطرات پنهان نگه‌داشته بود."],[812,"گشت پیدا گفت بابا چیست این","من نگفتم که ازو دوری گزین","دختر از پدرش می‌پرسد که چرا به او نگفته بود از شوهرش دوری کند و اکنون که او باردار شده، متوجه شده است."],[812,"این وصیتهای من خود باد بود","که نکردت پند و وعظم هیچ سود","این نصیحت‌های من مانند بادی است که به خودم نیامده و هیچ فایده‌ای ندارد، چون در واقع این نصیحت‌ها تأثیری نداشته است."],[812,"گفت بابا چون کنم پرهیز من","آتش و پنبه‌ست بی‌شک مرد و زن","دختر به پدر گفت: پدرم چگونه از من می خواهید که با او ربطه نداشته باشم در حالی که مرد و زن مثل آتش و پنبه هستند، کنایه از این که به صورت فطری به هم گرایش دارند"],[812,"پنبه را پرهیز از آتش کجاست","یا در آتش کی حفاظست و تقاست","پرهیز از آتش برای پنبه چه معنایی دارد؟ آیا واقعا می‌توان از آتش ایمنی داشت و در عین حال در آتش قرار گرفت؟"],[812,"گفت من گفتم که سوی او مرو","تو پذیرای منی او مشو","گفت: من به تو گفتم که به سمتی از او نروی چرا که تو نباید پذیرای او باشی."],[812,"در زمان حال و انزال و خوشی","خویشتن باید که از وی در کشی","در زمان حال و در هنگام لذت، باید از او (شوهر) دوری کنی و خود را نگه‌داری."],[812,"گفت کی دانم که انزالش کی است","این نهانست و به غایت دوردست","می‌گوید: چطور می‌توانم بفهمم که انزال شوهرم چه زمانی رخ می‌دهد؛ این موضوع پنهان است و به شدت دور از دسترس می‌باشد."],[812,"گفت چشمش چون کلاپیسه شود","فهم کن که آن وقت انزالش بود","وقتی که چشم شوهرت مانند کلاپیسه (چشم‌های برآمده ناشی از اشتیاق و شگفتی) شود، بفهم که در آن زمان انزال (خروج مایع منی) او اتفاق می‌افتد."],[812,"گفت تا چشمش کلاپیسه شدن","کور گشتست این دو چشم کور من","گفته شده که وقتی چشم کسی مانند کلاپیسه (چشم گربه) شود، او در حالت انزال است؛ در اینجا، گوینده بیان می‌کند که این دو چشم از او کور شده‌اند و به نوعی به نقصان و ناتوانی خود در درک و بینش اشاره دارد."],[812,"نیست هر عقلی حقیری پایدار","وقت حرص و وقت خشم و کارزار","هر عقل و دانشی که بر پایه‌ی حرص و خشم و در زمان جنگ و نزاع شکل بگیرد، پایدار و محکم نیست و نمی‌توان به آن اعتماد کرد."],[813,"رفت یک صوفی به لشکر در غزا","ناگهان آمد قطاریق و وغا","یک صوفی به صف لشکر جنگی رفت و ناگهان با گروهی از سربازان و صدای جنگ روبه‌رو شد."],[813,"ماند صوفی با بنه و خیمه و ضعاف","فارسان راندند تا صف مصاف","صوفی با وسایل و خیمه‌اش در میدان نبرد تنها ماند، در حالی که مبارزان توانمند و شجاع به سمت صف دشمن حمله کردند."],[813,"مثقلان خاک بر جا ماندند","سابقون السابقون در راندند","بیشتر افرادی که در رکاب جنگ نرفتند و فقط در خاک ماندند، همانند کسانی هستند که پیش از آن‌ها در صحنه‌های نبرد حاضر شدند و در واقع از آن‌ها عقب‌ترند. این کنایه به کسانی دارد که فقط ظاهر مسئله را می‌بینند و در عمق و حقیقت آن درگیر نیستند."],[813,"جنگها کرده مظفر آمدند","باز گشته با غنایم سودمند","به کسانی که در میدان جنگ پیروز شده و با غنایم با ارزش به خانه برگشته‌اند، اشاره می‌شود. این افراد به دلیل تلاش و مجاهدت در جنگ، به دستاوردی بزرگ رسیده‌اند و حالا باید با کسانی که بدون زحمت و کوشش به مقام و موقعیتی دست یافته‌اند، مقایسه شوند."],[813,"ارمغان دادند کای صوفی تو نیز","او برون انداخت نستد هیچ چیز","ای صوفی، مردم هدایای زیادی به تو تقدیم کردند، اما او (شخصی که مورد اشاره است) بدون هیچ زحمتی و تلاش، همه چیز را دور انداخت."],[813,"پس بگفتندش که خشمینی چرا","گفت من محروم ماندم از غزا","به او گفتند که چرا در این حال خشمگین هستی، او پاسخ داد که من از شرکت در جنگ (غزا) محروم مانده‌ام."],[813,"زان تلطف هیچ صوفی خوش نشد","که میان غزو خنجر کش نشد","هیچ یک از صوفیان به خاطر لطف و بزرگی که دارند، در جنگ و نبرد، خنجر کشیده نشده‌اند و از این رو در میان شجاعت و جنگاوری نتوانسته‌اند خود را نشان دهند."],[813,"پس بگفتندش که آوردیم اسیر","آن یکی را بهر کشتن تو بگیر","گفتند به او که ما یکی اسیر را آوردیم تا تو او را بکشی."],[813,"سر ببرش تا تو هم غازی شوی","اندکی خوش گشت صوفی دل‌قوی","برای اینکه تو هم مانند رزمندگان (غازیان) به مقام بلند برسی، باید به جانبازان بپیوندی و قدری دلیر و قوی شوی. بازم دل‌ناتوانی و سستی بس است، پس باید برای کسب شجاعت و فخر بیشتری اقدام کنی."],[813,"که آب را گر در وضو صد روشنیست","چونک آن نبود تیمم کردنیست","اگر آب برای وضو روشنایی و پاکی به همراه دارد، در غیاب آن (آب) تیمم تنها گزینه‌ای است که مورد استفاده قرار می‌گیرد. بدین معنا که اگر نتوان به آب دسترسی داشت، باید به روش دیگری برای پاکی و آماده شدن اقدام کرد."],[813,"برد صوفی آن اسیر بسته را","در پس خرگه که آرد او غزا","صوفی، اسیر را که در بند است، به پشت خرگاه خود می‌برد تا او را به جنگ ببرد."],[813,"دیر ماند آن صوفی آنجا با اسیر","قوم گفتا دیر ماند آنجا فقیر","صوفی مدتی طولانی در کنار اسیر ماند و به او گفت که اینجا بمان، ای فقیر."],[813,"کافر بسته دو دست او کشتنیست","بسملش را موجب تاخیر چیست","کافر، که در اینجا نماد دشمن یا معارض است، او را در حال کشته شدن می‌بیند و می‌پرسد که چرا مهلت می‌سازد و او را به تاخیر می‌اندازد. به عبارت دیگر، او از کافر می‌پرسد که علت این تأخیر در کشتن او چیست."],[813,"آمد آن یک در تفحص در پیش","دید کافر را به بالای ویش","آن شخص، در جستجوی حقیقت و در بررسی وضع، به بالای تپه‌ای می‌نگرد و کافر را می‌بیند که در آنجا نشسته است."],[813,"هم‌چو نر بالای ماده وآن اسیر","هم‌چو شیری خفته بالای فقیر","شبیه به نر (گاو نر) که بر روی ماده (گاو ماده) نشسته و آن اسیر (ماده) مانند شیری است که خوابیده و روی فقیر (بنده یا انسان ضعیف) است."],[813,"دستها بسته همی‌خایید او","از سر استیز صوفی را گلو","صوفی در حالی که دست‌هایش بسته است، همچنان از سر استهزا به او می‌خندد. این نشان از ضعف و ناتوانی او دارد، زیرا نمی‌تواند به راحتی از خود دفاع کند."],[813,"گبر می‌خایید با دندان گلوش","صوفی افتاده به زیر و رفته هوش","گبر (کافر) با دندان گلو صوفی را می‌گیرد، در حالی که صوفی به زمین افتاده و بی‌هوش شده است."],[813,"دست‌بسته گبر و هم‌چون گربه‌ای","خسته کرده حلق او بی‌حربه‌ای","گبر (جزء) در حالتی بی‌دفاع مثل یک گربه خسته دست‌هایش بسته است و بدون هیچ سلاحی، او را در گردن گرفته‌اند."],[813,"نیم کشتش کرده با دندان اسیر","ریش او پر خون ز حلق آن فقیر","شخصی که به دندانش مثلا کشت کرده، حالا موهای ریش او را گرفته و به شدت او را زخمی کرده است؛ او که فقیر است، در این وضعیت به شدت آسیب دیده و خونریزی دارد."],[813,"هم‌چو تو کز دست نفس بسته دست","هم‌چو آن صوفی شدی بی‌خویش و پست","شما نیز مانند کسی که به خاطر نفس خود دست و پا بسته شده، بی‌هویت و حقیر شده‌اید."],[813,"ای شده عاجز ز تلی کیش تو","صد هزاران کوهها در پیش تو","تو که به دلیل ناتوانی و ضعف اراده، از رسیدن به هدفی بزرگ عاجز هستی، ای کاش می‌دانستی که در برابر تو موانع زیادی وجود دارد، همانند کوه‌های بلند که برای عبور از آن‌ها به تلاش و قدرت نیاز داری."],[813,"زین قدر خرپشته مردی از شکوه","چون روی بر عقبه‌های هم‌چو کوه","این بیت به فردی اشاره دارد که به خاطر عظمت و قدرت خود، از سرکشی و خودپسندی به شکوه و افاده می‌پردازد؛ مانند فردی که بر بلندی‌ها (عقبه‌ها) ایستاده و خود را بزرگ و تواناتر از دیگران می‌داند، همچنان که کوه‌ها در برابر او به نظر کوچک می‌آیند."],[813,"غازیان کشتند کافر را بتیغ","هم در آن ساعت ز حمیت بی‌دریغ","غازیان (مجاهدان مسلمان) در همان لحظه با شمشیر کافر را کشتند و این کار را با انگیزه و غیرت بی‌اندازه انجام دادند."],[813,"بر رخ صوفی زدند آب و گلاب","تا به هوش آید ز بی‌خویشی و خواب","بر روی صوفی آب و گلاب ریختند تا از بی‌خویشی و خواب بیدار شود و هوشیار گردد."],[813,"چون به خویش آمد بدید آن قوم را","پس بپرسیدند چون بد ماجرا","وقتی صوفی به خود آمد و حال آن گروه را مشاهده کرد، از آن‌ها پرسید که ماجرا چه بود و چه بر سر آن‌ها آمده است."],[813,"الله الله این چه حالست ای عزیز","این چنین بی‌هوش گشتی از چه چیز","ای عزیز، این چه وضعی است که به چنین حالتی افتاده‌ای و بی‌هوش شده‌ای؟ از چه چیزی دچار این حالت شده‌ای؟"],[813,"از اسیر نیم‌کشت بسته‌دست","این چنین بی‌هوش افتادی و پست","تو مانند کسی هستی که به اسیری گرفتار شده و نیمه‌کشته است، اما در این حال، آن‌قدر بی‌هوش و ضعیف شده‌ای که به شدت در پستی و درماندگی به سر می‌بری."],[813,"گفت چون قصد سرش کردم به خشم","طرفه در من بنگرید آن شوخ‌چشم","گفت وقتی که با خشم قصد نزدیک شدن به او را کردم، آن شوخ‌چشم به من نگاهی کرد."],[813,"چشم را وا کرد پهن او سوی من","چشم گردانید و شد هوشم ز تن","چشمانش را باز کرد و به سمت من نگاه کرد، وقتی که به من خیره شد، هوش و حواسم از بدنی که داشتم خارج شد."],[813,"گردش چشمش مرا لشکر نمود","من ندانم گفت چون پر هول بود","چرخش و نگاه چشم او برای من همچون یک لشکر و نیرو به نظر می‌رسد. من نمی‌دانم چرا، ولی این بی‌قراری و هیجان در من وجود دارد."],[813,"قصه کوته کن کزان چشم این چنین","رفتم از خود اوفتادم بر زمین","این بیت به این معناست که داستان را کوتاه کن و بگو از دیدن این چشمان چه بر سرم آمده است؛ به‌طوری‌که از خودم بی‌خبر شدم و به زمین افتادم."],[814,"قوم گفتندش به پیکار و نبرد","با چنین زهره که تو داری مگرد","قوم به او گفتند که با چنین هوش و شجاعت کمی که داری، به جنگ و نبرد نرو و دوری کن."],[814,"چون ز چشم آن اسیر بسته‌دست","غرقه گشتی کشتی تو در شکست","چون به خاطر نگاه آن اسیر (که دستانش بسته است) غرق در ترس و وحشت شدی، کشتی تو (یعنی زندگی یا وضعیت تو) در حال شکست و نابودی است."],[814,"پس میان حمله شیران نر","که بود با تیغشان چون گوی سر","در میانه حمله شیران نر، کسی که با سر تیغ آن‌ها مانند گوی می‌شود، به معنای بی‌پناهی و آسیب‌پذیری است؛ یعنی او در مواجهه با دشمنان قوی و خطرناک، هیچ قدرت و امکاناتی برای دفاع ندارد و به‌سادگی مورد حمله و آسیب قرار می‌گیرد."],[814,"کی توانی کرد در خون آشنا","چون نه‌ای با جنگ مردان آشنا","نمی‌توانی در میان خون و کشتار دوستان و آشنایان خود، در حالی که با جنگ و میدان نبرد آشنا نیستی، کاری انجام دهی."],[814,"که ز طاقاطاق گردنها زدن","طاق‌طاق جامه کوبان ممتهن","در این بیت، اشاره به افراد و کسانی است که بی‌احترامی و توهین می‌کنند و به دیگران به گونه‌ای خفت آمیز آسیب می‌زنند. این عمل، به ویژه زدن بر گردن‌های بلند (نماد مقام و اهمیتی که افراد دارند) را نشان می‌دهد و نوعی تمسخر یا تحقیر به شمار می‌آید. در کل، این بیت به وضعیت افرادی می‌پردازد که از حیثیت دیگران سوء‌استفاده می‌کنند."],[814,"بس تن بی‌سر که دارد اضطراب","بس سر بی‌تن به خون بر چون حباب","بسیاری از بدن‌ها بدون سر اضطراب دارند و بسیاری از سرها بدون بدن به خون تبدیل شده و مانند حباب‌ها در حال پدید آمدن و نابودی هستند."],[814,"زیر دست و پای اسپان در غزا","صد فنا کن غرقه گشته در فنا","در میدان جنگ، زیر پا و دست اسب‌ها، فقط فنا و نابودی وجود دارد و انسان به گونه‌ای غرق فنا می‌شود."],[814,"این چنین هوشی که از موشی پرید","اندر آن صف تیغ چون خواهد کشید","هوشی که به اندازه موش است، در صف جنگ و در میان تیغ‌ها نمی‌تواند از خود عکس‌العمل مناسبی نشان دهد و در برابر سختی‌ها و خطرات جنگ ناتوان خواهد بود."],[814,"چالش است آن حمزه خوردن نیست این","تا تو برمالی بخوردن آستین","حمزه خوردن در اینجا به معنای مواجهه با خطر و درگیری نیست، بلکه تا زمانی که تو خود را در خطر نیندازی و آماده‌ی چالش نباشی، این کار بی‌فایده است. شما باید همواره آماده باشید و در عمل ورود کنید، نه اینکه فقط به ظاهر و بی‌هویتی بسنده کنید."],[814,"نیست حمزه خوردن اینجا تیغ بین","حمزه‌ای باید درین صف آهنین","این‌جا جنگ مانند مبارزه حمزه نیست؛ بلکه باید در این صف محکم و آهنین تیغ برنده‌ای مانند حمزه در دست داشته باشی."],[814,"کار هر نازک‌دلی نبود قتال","که گریزد از خیالی چون خیال","کار کسانی که احساسات لطیفی دارند و نازک‌دل هستند، مبارزه و جنگ نیست؛ زیرا آن‌ها از خیالات و تصورات ترسناک می‌گریزند و نمی‌توانند در میدان نبرد حضور یابند."],[814,"کار ترکانست نه ترکان برو","جای ترکان هست خانه خانه شو","این بیت اشاره به این دارد که کار جنگ و مبارزه مخصوص افرادی با قدرت و دلایل قوی است؛ بنابراین، تو هم باید به جای درگیری و جنگ، به معنای خانه و آرامش بپردازی و در زندگی‌ات به دنبال امنیت و سکون باش."],[815,"گفت عیاضی نود بار آمدم","تن برهنه بوک زخمی آیدم","عیاضی گفت: نود بار به میدان جنگ آمدم و بدون زره و لباس، به امید این که زخمی بشوم و شهید شوم."],[815,"تن برهنه می‌شدم در پیش تیر","تا یکی تیری خورم من جای‌گیر","عیاضی گفته که برای به دست آوردن شهادت، با سر و بدن برهنه به میدان می‌رفت تا شاید یکی از تیرها به او اصابت کند و او به مقام شهادت برسد."],[815,"تیر خوردن بر گلو یا مقتلی","در نیابد جز شهیدی مقبلی","فقط کسی که در میدان جنگ جانش را فدای خدا و مذهب کند، می‌تواند به مقام شهادت برسد و غیر از این، تیر خوردن یا کشته شدن در میدان جنگ بی‌فایده است."],[815,"بر تنم یک جایگه بی‌زخم نیست","این تنم از تیر چون پرویزنیست","بدن من در یک جا هم بی‌زخم نیست و این همه زخم که در بدن دارم، مانند زخم‌های پرویز (که به خاطر جنگ و مبارزه دچار زخم شده) نیست."],[815,"لیک بر مقتل نیامد تیرها","کار بخت است این نه جلدی و دها","اما تیرها به سمت میدان جنگ نیامدند و این به خاطر تقدیر و سرنوشت است؛ نشانه‌ای از ناتوانی و بی‌عملی نیست."],[815,"چون شهیدی روزی جانم نبود","رفتم اندر خلوت و در چله زود","چون مدتی بود که شهید شدن نصیبم نمی‌شد، به تنهایی و در یک مکان دور از مردم رفتم و به عبادت و ریاضت پرداختم."],[815,"در جهاد اکبر افکندم بدن","در ریاضت کردن و لاغر شدن","در جهاد درونی و مجاهدت با نفس، بدنم را در تلاش برای ریاضت و کاهش وزن قرار دادم."],[815,"بانگ طبل غازیان آمد به گوش","که خرامیدند جیش غزوکوش","صدای طبل جنگجویان به گوش رسید که آنان با شوق و شور برای جنگ حرکت می‌کردند."],[815,"نفس از باطن مرا آواز داد","که به گوش حس شنیدم بامداد","نفس من از درونم (از باطن) صدا کرد و به من گفت که صبح زود صدای غازیان (در حال جنگ) را شنیدم."],[815,"خیز هنگام غزا آمد برو","خویش را در غزو کردن کن گرو","زمان نبرد فرارسیده است، پس خود را آماده کن و در جنگ شرکت کن."],[815,"گفتم ای نفس خبیث بی‌وفا","از کجا میل غزا تو از کجا","به خودم گفتم، ای نفس پلید و بی‌وفا، انگیزه‌ات برای رفتن به جنگ از کجا ناشی می‌شود؟"],[815,"راست گوی ای نفس کین حیلت‌گریست","ورنه نفس شهوت از طاعت بریست","ای نفس، اگر تو حقیقت را بگویی، به ما می‌گویی که تو فقط به حیل و نیرنگ مشغولی؛ وگرنه نفس شهوت به عبادت و اطاعت تمایل ندارد."],[815,"گر نگویی راست حمله آرمت","در ریاضت سخت‌تر افشارمت","اگر به من راست نگویی و از حقیقت بگویی، تو را وادار می‌کنند که در مسیر سخت ریاضت و تمرینات معنوی پیش بروی."],[815,"نفس بانگ آورد آن دم از درون","با فصاحت بی‌دهان اندر فسون","نفس انسان در آن لحظه از درونش صدایی بلند می‌کند و به طور غیرمستقیم با فصاحت و eloquence، به او می‌گوید که جذب کار نیک و جهاد شود، حتی بدون اینکه دهانی داشته باشد."],[815,"که مرا هر روز اینجا می‌کشی","جان من چون جان گبران می‌کشی","نفس من هر روز مرا در اینجا به خاطر خود می‌کشد، مانند اینکه جان گبران (عابدان و زاهدان) را می‌کشی."],[815,"هیچ کس را نیست از حالم خبر","که مرا تو می‌کشی بی‌خواب و خور","هیچ‌کس از حال من خبر ندارد که تو، ای خدا، مرا به‌گونه‌ای قتل می‌کنی که نه خواب دارم و نه خوراک."],[815,"در غزا بجهم به یک زخم از بدن","خلق بیند مردی و ایثار من","در میدان جنگ، اگر با یک ضربه از بدن دشمن کسی را ببینم که جان خود را فدای دیگران می‌کند، آن مرد را باید دید و ایثار او را شناخت."],[815,"گفتم ای نفسک منافق زیستی","هم منافق می‌مری تو چیستی","من به نفس خود می‌گویم که ای نفس، تو منافق هستی و در این دنیا نیز به همین صورت زندگی کرده‌ای. حال که مرگ را نزدیک می‌بینی، مشخص است که تو چه موجودی هستی و واقعا چه نوع حیات و مرگی را تجربه می‌کنی."],[815,"در دو عالم تو مرایی بوده‌ای","در دو عالم تو چنین بیهوده‌ای","در این دو جهان تو موجودیتی داشته‌ای، اما حالا، در این وضع، هیچ ارزشی نداری و بی‌فایده‌ای."],[815,"نذر کردم که ز خلوت هیچ من","سر برون نارم چو زنده‌ست این بدن","من تصمیم گرفتم که از خلوت بیرون نروم و با وجود زنده بودن این بدن، هیچ توجهی به دنیا نداشته باشم."],[815,"زانک در خلوت هر آنچ تن کند","نه از برای روی مرد و زن کند","در خلوت، هر عملی که بدن انجام می‌دهد، باید برای خدا باشد و نه به خاطر نشان دادن خود به دیگران، چه برای مردان و چه برای زنان."],[815,"جنبش و آرامش اندر خلوتش","جز برای حق نباشد نیتش","در خلوت و تنهایی، هرگونه حرکت و سکون او تنها برای رضای خداوند و به خاطر حق است و منظور دیگری ندارد."],[815,"این جهاد اکبرست آن اصغرست","هر دو کار رستمست و حیدرست","این تلاش بزرگ‌ترین مبارزه است و آن یکی کوچک‌تر. هر دو کار بزرگ و شایسته رستم و حیدر هستند."],[815,"کار آن کس نیست کو را عقل و هوش","پرد از تن چون بجنبد دنب موش","کار کسی که عقل و هوش او از بدنش جدا باشد، کار عبث و بی‌فایده‌ای است؛ زیرا او مثل موش به دنبال کارهای بی‌ارزش می‌افتد."],[815,"آن چنان کس را بباید چون زنان","دور بودن از مصاف و از سنان","کسی که اینگونه است، باید مانند زنان از میدان جنگ و تیر و نیزه دور باشد."],[815,"صوفیی آن صوفیی این اینت حیف","آن ز سوزن کشته این را طعمه سیف","صوفی‌ها هر دو یکسان نیستند؛ یکی مانند آنکه با سوزن کشته شده، رنج می‌برد و دیگری طعمه‌ای است برای شمشیر. در واقع، به نظر می‌رسد که یکی از آن‌ها واقعا درگیر سختی‌های واقعی است و دیگری بیشتر به ظاهر و بی‌عملی مشغول است."],[815,"نقش صوفی باشد او را نیست جان","صوفیان بدنام هم زین صوفیان","نقش صوفی به این معنای نیست که او جان دارد، چراکه صوفیان بدنام نیز از همین صوفیان هستند."],[815,"بر در و دیوار جسم گل‌سرشت","حق ز غیرت نقش صد صوفی نبشت","بر دیوار و درهای این بدن، آثار و نشانه‌های خدا وجود دارد و به خاطر غیرت الهی، نقش صد صوفی را بر آن نوشته است."],[815,"تا ز سحر آن نقشها جنبان شود","تا عصای موسوی پنهان شود","تا صبح، آن نقش‌ها به حرکت درمی‌آیند و به تحریک می‌آیند، تا اینکه عصای موسى (موسوی) که نماد قدرت و معجزه است، پنهان شود و ممکن است از بین برود."],[815,"نقشها را میخورد صدق عصا","چشم فرعونیست پر گرد و حصا","نقش‌ها، نشانه‌ها و نمادها را صدق و راستی می‌بلعد، در حالی که چشم فرعونی (استبدادی) پر از گرد و خاک و زباله‌های دنیاست و بازدارنده از دیدن حقیقت می‌باشد."],[815,"صوفی دیگر میان صف حرب","اندر آمد بیست بار از بهر ضرب","یک صوفی دیگر به جمعیت جنگی پیوست و برای جنگیدن و ضربه زدن بیست بار به میدان آمد."],[815,"با مسلمانان به کافر وقت کر","وانگشت او با مسلمانان به فر","عیاضی که در زمان جنگ با کافران حضور دارد، حالتی ناامیدکننده برایش پیش آمد و دستش به سمت مسلمانان دراز شد، ولی در عین حال، احساس کرد که به خاطر این وضعیت، در بین مسلمانان نیز منفور شده است."],[815,"زخم خورد و بست زخمی را که خورد","بار دیگر حمله آورد و نبرد","او که زخمی شده بود، دوباره به مبارزه و حمله ادامه داد و به میدان نبرد بازگشت."],[815,"تا نمیرد تن به یک زخم از گزاف","تا خورد او بیست زخم اندر مصاف","انسان تا یک بار دچار مرگ نشود، به‌راحتی زخم را جدی نمی‌گیرد و ممکن است در میدان نبرد بیست زخم دیگر ببیند، چون اهمیت مرگ را درک نکرده است."],[815,"حیفش آمد که به زخمی جان دهد","جان ز دست صدق او آسان رهد","عیاضی با وجود اینکه در میدان جنگ به شدت مجروح شده و نزدیک به مرگ است، با خود می‌گوید حیف است که به خاطر یک زخم جانش را از دست بدهد، زیرا ایمان و صداقت او به قدری قوی است که به آسانی می‌تواند از مرگ رهایی یابد."],[816,"آن یکی بودش به کف در چل درم","هر شب افکندی یکی در آب یم","مردی هر شب یک درم از سرمایه‌اش را در آب می‌انداخت تا با این کار به مبارزه با حرص و آرزوی نفس بپردازد."],[816,"تا که گردد سخت بر نفس مجاز","در تأنی درد جان کندن دراز","نفس انسان طبیعی است که در برابر سختی‌ها و دشواری‌ها مقاومت می‌کند، لذا برای رسیدن به آرامش و راحتی، باید با تدبیر و صبر، سختی‌های درونی و روانی را متحمل شد تا در نهایت به آرامش و آسایش دست یافت."],[816,"با مسلمانان به کر او پیش رفت","وقت فر او وا نگشت از خصم تفت","او به همراه مسلمانان با شجاعت و قوت به سمت دشمن حمله‌کرد، اما وقتی به دشمن نزدیک شد، از روی ترس و عدم پشتیبانی، از آن‌ها دور نشد."],[816,"زخم دیگر خورد آن را هم ببست","بیست کرت رمح و تیر از وی شکست","او آسیب دیگری دید و آن را نیز درمان کرد، در حالی که بیست بار با نیزه و تیر به او حمله کردند و نتوانستند او را شکست دهند."],[816,"بعد از آن قوّت نماند افتاد پیش","مقعد صدق او ز صدق عشق خویش","پس از آن دیگر نیرو و قدرتی نمانده بود و در برابر مقام صدق (راستی و حقیقت) او افتاد، زیرا او از صدق و حقیقت عشق خود غرق شده بود."],[816,"صدق جان دادن بود هین سابقوا","از نبی برخوان رجال صدقوا","راستین و واقعی‌ترین حالت جان دادن، همان صدق و راست‌گویی است. پس بیایید به زودتر پیشی بگیریم و از پیامبر بشنویم که مردانی هستند که به راستی در صداقت و راست‌گویی پایبندند."],[816,"این همه مردن نه مرگ صورت است","این بدن مر روح را چون آلت است","اینکه می‌گوید همه این مردن‌ها، مرگ ظاهری است و در واقع این بدن تنها وسیله‌ای برای روح است. به عبارتی، مرگ واقعی به معنای پایان وجود روح نیست و روح از این بدن جدا نمی‌شود."],[816,"ای بسا خامی که ظاهر خونش ریخت","لیک نفس زنده آن جانب گریخت","بسیاری از افراد نادان که در ظاهر سرشان خون رفته، اما روح یا نفسشان هنوز زنده و فرار کرده است."],[816,"آلتش بشکست و ره‌زن زنده ماند","نفس زنده‌ست ارچه مرکب خون فشاند","اگرچه آلت، به‌معنای ابزار یا وسیله، شکسته شده، اما دزد یا راه‌زن (به‌طور نمادین نماینده نفس) هنوز زنده است. نفس همچنان وجود دارد، حتی اگر ظاهر آن به‌دلیل خون‌ریزی آسیب دیده باشد."],[816,"اسپ کشت و راه او رفته نشد","جز که خام و زشت و آشفته نشد","اسب را کشت، اما راه او به مقصد نرسید و تنها نتیجه‌اش خامی و زشتی و آشفته‌گی بود."],[816,"گر به هر خون‌ریزیی گشتی شهید","کافری کشته بدی هم بوسعید","حتی اگر به خاطر هر گونه کشتن و خون‌ریزی شهید شوی، باز هم اگر کافری را بکشی، مانند بوسعید، که یک شخصیت معتبر مذهبی است، تو هنوز هم از کافر بودن خارج نخواهی شد."],[816,"ای بسا نفس شهید معتمد","مرده در دنیا چو زنده می‌رود","بسیاری از نفس‌ها به ظاهر زنده‌اند اما در واقع شهید و مرده‌اند؛ یعنی بر اثر تعلقات دنیایی و گناه‌ها به حقیقت نمی‌رسند و فقط در دنیا زندگی می‌کنند."],[816,"روح ره‌زن مرد و تن که تیغ اوست","هست باقی در کف آن غزوجوست","روح انسان همان راهزن است و تن او که مانند تیغی تند و قاتل است، تنها در دست آن دل‌باخته (غزوجو) باقی مانده است."],[816,"تیغ آن تیغست مرد آن مرد نیست","لیک این صورت ترا حیران کنیست","تیغ در اینجا نماد سختی‌ها و چالش‌های زندگی است، اما انسان واقعی و معنوی همچون آن تیغ نیست و تنها در قالب ظاهری می‌تواند دیگران را متوجه خود کند. در واقع، آنچه که ما را مبهوت می‌کند، صرفا شکل ظاهری و ظلمات دنیوی است، نه حقیقت انسانیت."],[816,"نفس چون مبدل شود این تیغ تن","باشد اندر دست صنع ذوالمنن","نفس انسان وقتی تغییر کند، می‌تواند مانند تیغی در دست خداوند باشد که او را به نعمت‌ها و آفریده‌هایش هدایت می‌کند."],[816,"آن یکی مردیست قوتش جمله درد","این دگر مردی میان‌تی هم‌چو گرد","این مرد، قدرتش بردن دردهاست، در حالی که آن مرد دیگر در میان این مشکلات مثل گردی در باد است و نمی‌تواند از عهده آنها برآید."],[817,"مر خلیفه مصر را غماز گفت","که شه موصل به حوری گشت جفت","خبرچین به خلیفه مصر گفت که پادشاه موصل به همسری حوری درآمده است."],[817,"یک کنیزک دارد او اندر کنار","که به عالم نیست مانندش نگار","یک کنیزک در کنار اوست که در دنیای پیرامونش هیچ‌کس مانند او زیبا نیست."],[817,"در بیان ناید که حسنش بی‌حدست","نقش او اینست که اندر کاغذست","حسن و زیبایی آن کنیزک به قدری زیاد است که نمی‌توان به خوبی توصیفش کرد؛ نقشی که از او در کاغذ کشیده شده تنها تصویری از زیبایی‌اش را نشان می‌دهد و بیانگر تمام زیبایی واقعی او نیست."],[817,"نقش در کاغذ چو دید آن کیقباد","خیره گشت و جام از دستش فتاد","کیقباد، که به احتمال زیاد اشاره به یک فرمانروا یا شخص بزرگ دارد، وقتی تصویر کنیزک را بر کاغذ دید، حیرت‌زده شد و از شدت شگفتی جامی که در دست داشت، به زمین افتاد."],[817,"پهلوانی را فرستاد آن زمان","سوی موصل با سپاه بس گران","در آن زمان، خلیفه مصر، پهلوانی را با سپاه زیاد به موصل فرستاد."],[817,"که اگر ندهد به تو آن ماه را","برکن از بن آن در و درگاه را","اگر آن دختر (ماه) را به تو ندهند، از ریشه آن در و درگاه (محل ورود) را هم کنار بزن."],[817,"ور دهد ترکش کن و مه را بیار","تا کشم من بر زمین مه در کنار","اگر او آن ماه (کنیزک) را به تو ندهد، پس او را رها کن و آن در و درگاه را ترک کن. اگر او (کنیزک) ترکش را به تو بدهد، آن مه را بیاور تا من آن را در کنار خود بر زمین بکشم."],[817,"پهلوان شد سوی موصل با حشم","با هزاران رستم و طبل و علم","پهلوان به سمت موصل حرکت کرد، با عده‌ای فراوان و سپاهی بزرگ که شامل هزاران رستم (جنگجویان شجاع) و نشان‌ها و طبل‌ها بود."],[817,"چون ملخها بی‌عدد بر گرد کشت","قاصد اهلاک اهل شهر گشت","به‌گونه‌ای که ملخ‌ها به‌حدی زیاد و بی‌شماره به دور محصول حلقه می‌زنند، فرستاده‌ای که این خبر را می‌آورد، باعث ویرانی و نابودی مردم شهر می‌شود."],[817,"هر نواحی منجنیقی از نبرد","هم‌چو کوه قاف او بر کار کرد","در هر منطقه‌ای که جنگ اتفاق می‌افتاد، مانند کوه قاف، خون و ویرانی زیادی به بار می‌آورد."],[817,"زخم تیر و سنگهای منجنیق","تیغها در گرد چون برق از بریق","زخم‌هایی که تیر و سنگ‌های منجنیق بر جا می‌گذارند، به تیزی و درخشندگی‌ تیغ‌ها هستند و تأثیر آنها در میدان نبرد همانند رعد و برق است."],[817,"هفته‌ای کرد این چنین خون‌ریز گرم","برج سنگین سست شد چون موم نرم","این هفت روز، این جنگ و کشتار بی‌رحمانه ادامه داشت و سرانجام، برج‌های محکم و سنگی دشمن نیز به نرمی و سستی مانند موم درمی‌آمد."],[817,"شاه موصل دید پیگار مهول","پس فرستاد از درون پیشش رسول","شاه موصل در برابر یک نشانه یا صحنه ترسناک قرار گرفت و به همین خاطر از داخل کاخ خود فرستاده‌ای به نزد او فرستاد."],[817,"که چه می‌خواهی ز خون مؤمنان","کشته می‌گردند زین حرب گران","تو چه هدفی را در سر داری که به خاطر آن مؤمنان بی‌گناه این‌گونه کشته می‌شوند و این جنگ و خون‌ریزی ادامه دارد؟"],[817,"گر مرادت ملک شهر موصلست","بی‌چنین خون‌ریز اینت حاصلست","اگر منظورت تسلط بر شهر موصل است، با این‌همه خون‌ریزی نمی‌توانی به آن هدف برسی."],[817,"من روم بیرون شهر اینک در آ","تا نگیرد خون مظلومان ترا","من از این شهر بیرون می‌روم تا تو گرفتار ظلم و خون‌ریزی نشوی و خون مظلومان به گردن تو نیفتد."],[817,"ور مرادت مال و زر و گوهرست","این ز ملک شهر خود آسان‌ترست","اگر هدف تو به دست آوردن مال و ثروت و جواهر است، این کار به‌راحتی از سرزمین و کشور خودت امکان‌پذیرتر است."],[818,"چون رسول آمد به پیش پهلوان","داد کاغذ اندرو نقش و نشان","وقتی که رسول به نزد پهلوان رفت، نوشته‌ای را که در آن نقش و نشان وجود داشت، به او داد."],[818,"بنگر اندر کاغذ این را طالبم","هین بده ورنه کنون من غالبم","در نوشته‌ای که بر کاغذ است، ببین که چه چیزی را طلب می‌کنم؛ سریعا آن را به من بده، وگرنه اکنون من بر تو برتری دارم."],[818,"چون رسول آمد بگفت آن شاه نر","صورتی کم گیر زود این را ببر","پس از رسیدن پیامبری به نزد شاه، او گفت که زودتر آن دخترک را ببر و از او کم بگیر."],[818,"من نیم در عهد ایمان بت‌پرست","بت بر آن بت‌پرست اولیترست","من در زمان ایمان و اعتقاد به خدا، مشغول پرستش بت نیستم. پرستش من برای آن بت‌پرست (یعنی کسی که بت می‌پرستد) برتر و والاتر از پرستیدن بت اوست."],[818,"چونک آوردش رسول آن پهلوان","گشت عاشق بر جمالش آن زمان","زمانی که رسول، آن پهلوان را به حضور آورد، او به زیبایی آن کنیزک عاشق شد."],[818,"عشق بحری آسمان بر وی کفی","چون زلیخا در هوای یوسفی","عشق مانند دریا است و آسمان بر او سایه افکنده، همچنان که زلیخا در آرزوی یوسف بود."],[818,"دور گردونها ز موج عشق دان","گر نبودی عشق بفسردی جهان","اگر عشق و محبت وجود نداشت و دور گردون‌ها تحت تأثیر آن نبود، جهان به حالت پژمردگی و زوال می‌رفت."],[818,"کی جمادی محو گشتی در نبات","کی فدای روح گشتی نامیات","در این بیت، شاعر اشاره می‌کند که چگونه در عوالم وجود، مادیات (جماد) در گیاهان (نبات) محو می‌شود و بیان می‌کند که روح انسان نیز می‌تواند در عوالم بالاتر فدای چیزهای نامی (با ارزش و معنوی) شود. این تعبیر به نوعی به تحول و ارتقاء روح اشاره دارد که می‌تواند از حالت مادی خارج شود و به مراحل والاتری دست یابد."],[818,"روح کی گشتی فدای آن دمی","کز نسیمش حامله شد مریمی","روح چه زمانی فدای آن دم می‌شود که در نسیمش، مریم (مادری که عیسی (ع) را به دنیا آورد) به وجود آمده باشد."],[818,"هر یکی بر جا ترنجیدی چو یخ","کی بدی پران و جویان چون ملخ","هر کس در مکانی به شدت خود را ناراحت می‌بیند، مانند یخی است که بر اثر گرما ذوب می‌شود و بی‌نظم و سرگردان به اطراف می‌پراند، همچون ملخی که در جستجوی مکان تازه‌ای است."],[818,"ذره ذره عاشقان آن کمال","می‌شتابند در علو هم‌چون نهال","عاشقان به تدریج و قدم به قدم به سوی کمال و مقام بلند روحانی حرکت می‌کنند، مشابه رشد نهال که به آرامی و با استقامت به سمت بالا می‌رود."],[818,"سبح لله هست اشتابشان","تنقیه تن می‌کنند از بهر جان","عاشقان به خاطر عشق و محبت خود، به سوی خداوند شتاب می‌کنند و در تلاش‌اند که روح و جان خود را پاکیزه کنند."],[818,"پهلوان چه را چو ره پنداشته","شوره‌اش خوش آمده حب کاشته","پهلوان به چه دلیلی شوره‌زار را راه خود می‌داند، در حالی که برایش کاشتن محبت و دوستی بهتر است."],[818,"چون خیالی دید آن خفته به خواب","جفت شد با آن و از وی رفت آب","آن خفته در خواب، وقتی خیال معشوقش را دید، احساس کرد که با او هماهنگ شده و از این رو اشک او، که نمایانگر محبت و احساساتش است، رها شد و جاری گردید."],[818,"چون برفت آن خواب و شد بیدار زود","دید که آن لعبت به بیداری نبود","پس از اینکه آن خواب از بین رفت و او زود بیدار شد، متوجه شد که آن کنیزک در واقع در حالت بیداری وجود ندارد و تنها خیال او بوده است."],[818,"گفت بر هیچ آب خود بردم دریغ","عشوه آن عشوه‌ده خوردم دریغ","گفت به هیچ آبی غم ندارد که خودم را به خطر انداختم، چرا که از زیبایی و فریب آن دختر لذت بردم و این برایم پر از حسرت است."],[818,"پهلوان تن بد آن مردی نداشت","تخم مردی در چنان ریگی بکاشت","آن مردی که از نظر قهرمانی و شجاعت قابل توجه نبود، در دل خود، حتی در شرایط سخت و دشوار، نتوانست نشانه‌ای از مردانگی و بزرگواری از خود نشان دهد."],[818,"مرکب عشقش دریده صد لگام","نعره می‌زد لا ابالی بالحمام","عشق او همچون مرکبی سرکش است که صد لگام (زین و افسار) را پاره کرده و بی‌باکانه در حال نعره‌زدن و هیاهو است، گویی به سمت شغف و شور و شوقی دیوانه‌وار در حال حرکت است."],[818,"ایش ابالی بالخلیفه فی‌الهوی","استوی عندی وجودی والتوی","عشق او نسبت به خلیفه در نظر من به قدری قوی و بی‌پرواست که وجود و عدم من در برابر آن هیچ است."],[818,"این چنین سوزان و گرم آخر مکار","مشورت کن با یکی خاوندگار","در این بیت، مولانا به بیان این مطلب می‌پردازد که در شرایط دردناک و سخت، بهتر است با یک صاحب‌نظر یا فرد با تجربه مشورت شود تا راه‌حل مناسبی برای مشکل پیدا شود. به طور کلی، اهمیت مشورت کردن در مواجهه با مسائل دشوار را مورد تأکید قرار می‌دهد."],[818,"مشورت کو عقل کو سیلاب آز","در خرابی کرد ناخنها دراز","عقل و فکر کجاست که در این وضعیت سخت مشورت کند، وقتی که نشانه‌های بدی در حال ظهور است، مانند طوفانی که به خرابی می‌انجامد و ناخن‌های دراز مانند چیزی مضر و زننده‌اند."],[818,"بین ایدی سد و سوی خلف سد","پیش و پس کم بیند آن مفتون خد","مردم گاهی در برابر قدرت و مقام، چشم خود را می‌بندند و نمی‌توانند آنچه را که در اطرافشان می‌گذرد ببینند. در این بیت، اشاره می‌شود به اینکه انسان در میان مشکلات و چالش‌ها، درک درستی از شرایط ندارد و مانند کسی که تحت تاثیر قدرت است، به سادگی تحت تأثیر قرار می‌گیرد."],[818,"آمده در قصدجان سیل سیاه","تا که روبه افکند شیری به چاه","سیل سیاه به‌صورت ناگهانی و با سرعت به سمت جان انسان سرازیر شده و مانند شیر بزرگ و توانا به چاه می‌افتد، به‌گونه‌ای که در این دگرگونی، اراده و قدرت انسان تهدید می‌شود."],[818,"از چهی بنموده معدومی خیال","تا در اندازد اسودا کالجبال","از چه چیز به وجود آمده که خیال نابود را به نمایش می‌گذارد تا سیاهی را مانند کوه در افکند؟"],[818,"هیچ‌کس را با زنان محرم مدار","که مثال این دو پنبه‌ست و شرار","هیچ‌کس را نباید با زنان محرم دانست؛ زیرا این دو مانند پنبه و آتش هستند که پنبه در برابر آتش می‌سوزد و از بین می‌رود."],[818,"آتشی باید بشسته ز آب حق","هم‌چو یوسف معتصم اندر زهق","برای رهایی از خطر و آتش فتنه، باید به اندازه یوسف که از زلیخا دوری جسته، با آب حق (راستی و صداقت) خود را پاک و دور از آتش گناه و فساد کرد."],[818,"کز زلیخای لطیف سروقد","هم‌چو شیران خویشتن را واکشد","یعنی زلیخا که زنی زیبا و ظریف است، مانند شیران با قدرت و شجاعت، از خویش و خودخواهی‌ها فاصله می‌گیرد و به دیگران توجه می‌کند."],[818,"بازگشت از موصل و می‌شد به راه","تا فرود آمد به بیشه و مرج‌گاه","از موصل بازگشت و در راه بود، تا این‌که به جنگل و مرتع رسید."],[818,"آتش عشقش فروزان آن چنان","که نداند او زمین از آسمان","عشق او به شدت شعله‌ور است به‌گونه‌ای که او حتی نمی‌تواند تفاوت بین زمین و آسمان را تشخیص دهد."],[818,"قصد آن مه کرد اندر خیمه او","عقل کو و از خلیفه خوف کو","آن زن زیبا (کنیزک) هدف عشق خود را در خیمه مردی (صاحب موصل) قرار داده است و عقل و ترس از خلیفه را نادیده می‌گیرد."],[818,"چون زند شهوت درین وادی دهل","چیست عقل تو فجل ابن الفجل","زمانی که شهوت در این مسیر شعله‌ور می‌شود، عقل تو چه فایده‌ای دارد، چون عقل همواره تحت تأثیر این شهوت قرار می‌گیرد و به درد نمی‌خورد."],[818,"صد خلیفه گشته کمتر از مگس","پیش چشم آتشینش آن نفس","این بیت به توصیف حس انسانی در برابر نفس و شهوت می‌پردازد. مقایسه می‌کند که حتی صد خلیفه (یا مقام‌داران بزرگ) در برابر نفس آتشین و خواسته‌های نفسانی، همچون مگسی بی‌اهمیت و کم‌ارزش هستند. به عبارت دیگر، تمایل به شهوت و خواسته‌های نفسانی می‌تواند همه مقام‌ها و عظمت‌ها را بی‌ارزش کند."],[818,"چون برون انداخت شلوار و نشست","در میان پای زن آن زن‌پرست","زمانی که او شلوار خود را درآورد و در کنار آن زن پرست نشست، به‌طور واضحی نشان‌دهنده‌ی تسلیم شدن و گذراندن لحظات صمیمی و نزدیک با اوست."],[818,"چون ذکر سوی مقر می‌رفت راست","رستخیز و غلغل از لشکر بخاست","زمانی که نام و یاد جنگ و خون‌ریزی به میان می‌آید، شور و هیجان در لشکر به وجود می‌آید و همه در حال آماده‌باش هستند."],[818,"برجهید و کون‌برهنه سوی صف","ذوالفقاری هم‌چو آتش او به کف","کسی ناگهان از جایش بلند شد و با سلاحی به نام ذوالفقار (شمشیری که متعلق به علی است) به سمت صف دشمن رفت، گویی آتش در دستانش دارد."],[818,"دید شیر نر سیه از نیستان","بر زده بر قلب لشکر ناگهان","شیر نر سیاهی ناگهان از میان نیستان به طرف لشکر یورش می‌برد و بر قلب آن‌ها حمله می‌کند."],[818,"تازیان چون دیو در جوش آمده","هر طویله و خیمه اندر هم زده","تازیان (اعراب) مانند دیوها به شدت در حال حرکت و فعالیت هستند و هر کجا که می‌رسند، طویله‌ها و خیمه‌ها را به هم می‌زنند."],[818,"شیر نر گنبذ همی‌کرد از لغز","در هوا چون موج دریا بیست گز","شیر نر در میدان نبرد، به خاطر قدرت خود، به گونه‌ای حرکت می‌کند که به نظر می‌رسد در هوا لغزنده است، همچون موج دریا که به جلو می‌رود. این تصویر نشان‌دهنده تسلط و قدرت او در شرایط بحرانی است."],[818,"پهلوان مردانه بود و بی‌حذر","پیش شیر آمد چو شیر مست نر","این مرد پهلوان و شجاع بود و بدون ترس به سمت شیر رفت، مانند شیر نر که در مستی خود به جلو می‌آید."],[818,"زد به شمشیر و سرش را بر شکافت","زود سوی خیمه مه‌رو شتافت","با شمشیرش ضربه‌ای زد و به سرعت سر او را از بدنش جدا کرد و سپس به سوی خیمه‌ی آن دختر زیبا دوید."],[818,"چونک خود را او بدان حوری نمود","مردی او هم‌چنین بر پای بود","وقتی که آن مرد خودش را مانند یک حوری زیبا نشان داد و به خود آراست، مرد دیگر هم به خاطر او بر پا ایستاده و نیفتاد."],[818,"با چنان شیری به چالش گشت جفت","مردی او مانده بر پای و نخفت","مردی که در مقابل آن شیر قرار گرفت، به خاطر دلاوری و شجاعتش، نه تنها ترسی به دل راه نداد، بلکه به حالت ایستاده باقی ماند و خوابش نبرد."],[818,"آن بت شیرین‌لقای ماه‌رو","در عجب در ماند از مردی او","آن دختر زیبا و خوش‌چهره، از مردانگی و شجاعت او شگفت‌زده شده و متعجب است."],[818,"جفت شد با او به شهوت آن زمان","متحد گشتند حالی آن دو جان","آن دو نفر به خاطر شهوت و خواسته‌های نفسانی با هم هماهنگ و یکپارچه شدند و در آن لحظه، روح و جانشان به هم پیوست."],[818,"ز اتصال این دو جان با همدگر","می‌رسد از غیبشان جانی دگر","از پیوند این دو جان با یکدیگر، روحی از عالم غیب به آنها می‌رسد که به آنها زندگی و انرژی جدیدی می‌بخشد."],[818,"رو نماید از طریق زادنی","گر نباشد از علوقش ره‌زنی","اگر کسی به خاطر محبت و دوستی و به‌دست‌آوردن روحی نو و تازه به سفر برود، مسیر او را نمی‌تواند کسی که به نیت بد و خیانت آمده، منحرف کند."],[818,"هر کجا دو کس به مهری یا به کین","جمع آید ثالثی زاید یقین","هر جا که دو نفر به خاطر دوستی یا دشمنی با هم جمع شوند، فرد سومی هم به‌طور حتم ظهور می‌کند."],[818,"لیک اندر غیب زاید آن صور","چون روی آن سو ببینی در نظر","اما در عالم غیب، آن اشکال و تصاویری به وجود می‌آید که وقتی آن سوی این دنیا را ببینی، در نظر تو نمایان می‌شود."],[818,"آن نتایج از قرانات تو زاد","هین مگرد از هر قرینی زود شاد","نتایج و ثمرات اعمال و کارهای تو از زمان‌های گذشته به دست می‌آید؛ پس از هر نشانه و نشانه‌ای به سرعت شادمان نشو."],[818,"منتظر می‌باش آن میقات را","صدق دان الحاق ذریات را","در این بیت اشاره شده است که باید به وقت معین و موعود (میقات) منتظر بود و برای به حقیقت پیوستن سه‌ نسل (ذریات) باید به صدق و راست‌گویی باور داشت."],[818,"کز عمل زاییده‌اند و از علل","هر یکی را صورت و نطق و طلل","هر یک از موجودات، بر اساس اعمال و علل مختلفی که دارند، دارای شکل و صدایی خاص و ویژگی‌های مشخصی هستند."],[818,"بانگشان درمی‌رسد زان خوش حجال","کای ز ما غافل هلا زوتر تعال","صدا و فریاد آنان (افرادی که در غفلت‌اند) از آن لباس خوش (پوشش زیبا) به گوش می‌رسد. ای کسی که از ما غافل شده‌ای، بیا و زودتر به سوی ما بیا."],[818,"منتظر در غیب جان مرد و زن","مول مولت چیست زوتر گام زن","افرادی که در غیب هستند (مانند مردان و زنان روحانی) منتظرند. ای مول (مولای عزیز)، منظور تو چیست؟ بهتر است زودتر اقدام کنی و قدم برداری."],[818,"راه گم کرد او از آن صبح دروغ","چون مگس افتاد اندر دیگ دوغ","او از صبح زود دروغ‌گو راه خود را گم کرده است، مثل مگسی که در دیگ دوغ بیفتد و نتواند از آن خارج شود."],[819,"چند روزی هم بر آن بد بعد از آن","شد پشیمان او از آن جرم گران","او چند روز بعد از آن کار زشت خود پشیمان شد و احساس ندامت کرد."],[819,"داد سوگندش کای خورشیدرو","با خلیفه زینچ شد رمزی مگو","او (سرلشکر) سوگند می‌خورد که ای دختر زیبارو، هیچ رمزی درباره این موضوع به خلیفه نگوید."],[819,"چون بدید او را خلیفه مست گشت","پس ز بام افتاد او را نیز طشت","وقتی سرلشکر خلیفه را در حال مستی دید، او به شدت ترسید و از بام افتاد، گویی که طشت (ظرف بزرگ) نیز بر سرش افتاده است."],[819,"دید صد چندان که وصفش کرده بود","کی بود خود دیده مانند شنود","او (سرلشکر) دید که آن چیزهایی که درباره کسی گفته شده، بسیار بیشتر از آن چیزی است که او قبلا شنیده بود؛ بنابراین، حالا که با چشم خود مشاهده کرده، حقیقت را بهتر فهمیده است."],[819,"وصف تصویرست بهر چشم هوش","صورت آن چشم دان نه زان گوش","تصویر درک شده از چیزی برای چشم هوش، و درک درست آن تصویر به چشم دان مربوط می‌شود، نه به آنچه که از طریق گوش شنیده می‌شود."],[819,"کرد مردی از سخن‌دانی سؤال","حق و باطل چیست ای نیکو مقال","مردی از دانایان پرسید که حق و باطل چیست و چه چیزی آن‌ها را از یکدیگر متمایز می‌کند، ای سخن شایسته و نیکو."],[819,"گوش را بگرفت و گفت این باطلست","چشم حقست و یقینش حاصلست","او (مرد با سخن‌دان) گوش را بسته و می‌گوید که این گفته باطل است، در حالی که چیزی که با چشم دیده شده، حقیقت و یقین است."],[819,"آن به نسبت باطل آمد پیش این","نسبتست اغلب سخنها ای امین","سخنانی که به نسبت باطل گفته می‌شود، در مقایسه با حقیقت، چیزی جز نسبت‌های ظاهری و نادرست نیستند، ای امین (دوست)."],[819,"ز آفتاب ار کرد خفاش احتجاب","نیست محجوب از خیال آفتاب","خفاش اگر از نور آفتاب پنهان شود، دلیل بر این نیست که آفتاب خود را پنهان کرده و از خیال او دور شده است. این بیت به معنای این است که اگر کسی در سایه یا تاریکی قرار گیرد، باز هم نور حقیقت و واقعیت موجود است و آن شخص نمی‌تواند ادعا کند که حقیقت در دسترس او نیست."],[819,"خوف او را خود خیالش می‌دهد","آن خیالش سوی ظلمت می‌کشد","ترس او ناشی از خیالی است که خود آن را به او می‌دهد و همین خیال او را به سوی تاریکی و ظلمت می‌کشاند."],[819,"آن خیال نور می‌ترساندش","بر شب ظلمات می‌چفساندش","آن خیال نورانی او را در شب تاریکی می‌ترساند و در آن ظلمت به او چسبیده و متوقفش می‌کند."],[819,"از خیال دشمن و تصویر اوست","که تو بر چفسیده‌ای بر یار و دوست","تو به خاطر تصور دشمن و تصویر او به دوستان و یاران خود چسبیده‌ای و از آن‌ها دور شده‌ای."],[819,"موسیا کشفت لمع بر که فراشت","آن مخیل تاب تحقیقت نداشت","موسی، آن کس که با درخشش و نور خود کارساز بوده، به کسی دیدار کرد که خیال و تصورش، تاب تحمل حقیقت را نداشت."],[819,"هین مشو غره بدانک قابلی","مر خیالش را و زین ره واصلی","احتیاط کن که به خیال قدرت و شجاعت خود مغرور نشوی، زیرا این خیال به هیچ‌وجه مستند و حقیقی نیست و نمی‌تواند تو را به هدف برساند."],[819,"از خیال حرب نهراسید کس","لا شجاعه قبل حرب این دان و بس","هیچ کس از خیال جنگ نترسد؛ زیرا شجاعت قبل از جنگ است و فقط همین را بدانید."],[819,"بر خیال حرب حیز اندر فکر","می‌کند چون رستمان صد کر و فر","سرلشکر در فکر جنگ، مانند رستم، به یاد قصه‌های شجاعت و دلاوری‌ها می‌افتد و در خیال خود به مسائل مختلفی می‌اندیشد."],[819,"نقش رستم که آن به حمامی بود","قرن حمله فکر هر خامی بود","نقش رستم که در حمام نقش بسته بود، یادآوری از زمان حمله‌اش به خاطر هر فکر خامی بود که به ذهنش خطور می‌کرد."],[819,"این خیال سمع چون مبصر شود","حیز چه بود رستمی مضطر شود","وقتی خیال و اندیشه انسان، مانند گوش شنوا و بینا، به درستی متوجه شود، دیگر چه نیازی دارد که رستم (نماد قدرت و شجاعت) در حالت اضطراب و نگرانی باشد؟"],[819,"جهد کن کز گوش در چشمت رود","آنچ که آن باطل بدست آن حق شود","کوشش کن تا آنچه را که از طریق گوش در چشمت می‌آید، به خوبی درک کنی؛ زیرا آنچه که باطل به دست آورده، می‌تواند در نهایت به حقیقت تبدیل شود."],[819,"زان سپس گوشت شود هم طبع چشم","گوهری گردد دو گوش هم‌چو یشم","پس از آن، گوش تو هم مانند چشم، گوهرین می‌شود و دو گوشت هم مانند یشم زیبا و قیمتی می‌گردد."],[819,"بلک جمله تن چو آیینه شود","جمله چشم و گوهر سینه شود","تن آدمی مانند یک آیینه می‌شود و همه چشم‌ها و گوهر وجودش مانند سینه‌اش درخشان و بی‌نظیر می‌گردند."],[819,"گوش انگیزد خیال و آن خیال","هست دلاله وصال آن جمال","خیال معشوق در گوش دل می‌نشیند و این خیال است که راهنمای وصال به زیبایی او می‌شود."],[819,"جهد کن تا این خیال افزون شود","تا دلاله رهبر مجنون شود","تلاش کن تا این خیال قوی‌تر و بیشتر شود، زیرا خیال می‌تواند رهنما و هدایت‌کننده عاشق شود."],[819,"آن خلیفه گول هم یک چند نیز","ریش گاوی کرد خوش با آن کنیز","خلیفه، به طرز فریبی و به شکل مکارانه‌ای، با آن کنیزک صحبت کرد و به او وعده‌های شیرینی داد تا او را فریب دهد."],[819,"ملک را تو ملک غرب و شرق گیر","چون نمی‌ماند تو آن را برق گیر","دولت و قدرت را از آن خود کن، هم در غرب و هم در شرق، چرا که مانند برق، دائمی و پایدار نیستند و فانی‌اند."],[819,"مملکت کان می‌نماند جاودان","ای دلت خفته تو آن را خواب دان","مملکت مانند چیزی است که همیشگی نیست و همیشه در حال تغییر است. اگر دلت به آن دلخوش است، بدان که در خواب است."],[819,"تا چه خواهی کرد آن باد و بروت","که بگیرد هم‌چو جلادی گلوت","هرچقدر که بخواهی با قدرت و طمع خود پیش بروی، زمانی خواهند آمد که مانند مجازات‌کننده‌ای، بلایی بر سرت نازل می‌شود و تو را در تنگنا قرار می‌دهد."],[819,"هم درین عالم بدان که مامنیست","از منافق کم شنو کو گفت نیست","در این دنیا هیچ پناهگاهی از دسیسه و نفاق وجود ندارد؛ کمتر به کسی که می‌گوید نفاق و ریا وجود ندارد، توجه کن."],[820,"حجتش اینست گوید هر دمی","گر بدی چیزی دگر هم دیدمی","او می‌گوید که هر لحظه اگر چیزی بدی ببیند، آن را دلیل بر وجود نداردن آخرت می‌گیرد."],[820,"گر نبیند کودکی احوال عقل","عاقلی هرگز کند از عقل نقل","اگر کودک حال عقل را نبیند، هیچ‌گاه نمی‌تواند از عقل چیزی بگوید یا آن را بفهمد."],[820,"ور نبیند عاقلی احوال عشق","کم نگردد ماه نیکوفال عشق","اگر عاقل احوال عشق را نبیند، از ارزش و زیبایی عشق کم نمی‌شود؛ عشق همچنان باطل نیست و به نور خود ادامه می‌دهد."],[820,"حسن یوسف دیده اخوان ندید","از دل یعقوب کی شد ناپدید","خوش‌چهرگی یوسف، از نظر برادرانش پنهان مانده بود، زیرا دل یعقوب به یاد یوسف غمناک و درگیر شده بود و باعث می‌شد که خوشی و زیبایی او از دیده‌ها ناپدید شود."],[820,"مر عصا را چشم موسی چوب دید","چشم غیبی افعی و آشوب دید","موسی وقتی عصا را دید، فقط آن را به‌عنوان یک چوب می‌پنداشت، اما چشم باطنی‌اش افعی و هیاهویی را که از آن برمی‌خیزد، مشاهده می‌کرد."],[820,"چشم سر با چشم سر در جنگ بود","غالب آمد چشم سر حجت نمود","چشم ظاهر، یعنی چشم معمولی آدمی، با چشم بصیرت در حال جنگ است و در این جنگ، آنچه که به چشم ظاهر دیده می‌شود، برتری پیدا کرده و حجت می‌آورد."],[820,"چشم موسی دست خود را دست دید","پیش چشم غیب نوری بد پدید","چشم موسی، به عنوان یک پیامبر و نمونه‌ای از انسان، به دست خود نگریست و آن را مانند یک جسم عادی دید، ولی در واقع بر اساس بصیرت معنوی‌اش، نوری از عالم غیب را مشاهده کرد که به او حقیقتی فراتر از ظاهر نشان می‌دهد."],[820,"این سخن پایان ندارد در کمال","پیش هر محروم باشد چون خیال","این سخن هیچ‌گاه پایان نمی‌یابد، زیرا در مقام کمال، کسی که محروم است، فقط خیالات دارد و نمی‌تواند حقیقت را درک کند."],[820,"چون حقیقت پیش او فرج و گلوست","کم بیان کن پیش او اسرار دوست","حقیقت نزد خدا مانند فرجی و گلوئی است که همیشه برای انسان گشوده است، بنابراین تو نیز لازم نیست اسرار دوست را در حضور او بیان کنی."],[820,"پیش ما فرج و گلو باشد خیال","لاجرم هر دم نماید جان جمال","در نظر ما، گلو و فرج (مسیر عبور) یک خیال است و به همین دلیل، هر لحظه جان، زیبایی (جمال) خود را نشان می‌دهد."],[820,"هر که را فرج و گلو آیین و خوست","آن لکم دین ولی دین بهر اوست","هر کسی که حال و روحش به خوبی و دیانت نزدیک باشد، دین او نیز از آن اوست و در واقع دین به او تعلق دارد."],[820,"با چنان انکار کوته کن سخن","احمدا کم گوی با گبر کهن","با چنین انکاری که او دارد، سخن را کوتاه کن، ای احمق! کم صحبت کن با آن کافر قدیمی."],[821,"آن خلیفه کرد رای اجتماع","سوی آن زن رفت از بهر جماع","خلیفه تصمیم گرفت که به قصد نزدیکی، به سوی آن زن برود."],[821,"ذکر او کرد و ذکر بر پای کرد","قصد خفت و خیز مهرافزای کرد","خلیفه با یادآوری زن، به او نزدیکی و همخوابگی را پیشنهاد می‌کند و قصد دارد تا عشق و محبت را بین خود و او برقرار کند."],[821,"چون میان پای آن خاتون نشست","پس قضا آمد ره عیشش ببست","وقتی که خلیفه در میان پای آن زن زیبا نشسته، قضا و سرنوشت موجب می‌شود که او از لذت و خوشی محروم شود."],[821,"خشت و خشت موش در گوشش رسید","خفت کیرش شهوتش کلی رمید","موش‌ها به خاطر ایجاد سر و صدا، به گوش او رسیدند و این باعث شد که شهوت او از بین برود و دیگر نتواند بر این حال ادامه دهد."],[821,"وهم آن کز مار باشد این صریر","که همی‌جنبد بتندی از حصیر","این صدا که شبیه به صدای مار است، از کجا می‌آید؟ گویی از زیر حصیر به شدت در حال حرکت است و نوعی ترس و تردید ایجاد می‌کند."],[822,"زن بدید آن سستی او از شگفت","آمد اندر قهقهه خنده‌ش گرفت","زن از ضعف و سستی خلیفه شگفت‌زده شد و به خاطر این وضعیت به خنده افتاد."],[822,"یادش آمد مردی آن پهلوان","که بکشت او شیر و اندامش چنان","زن به یاد مردی پهلوان افتاد که شیر را کشته و دارای بدنی چنان نیرومند است."],[822,"غالب آمد خنده زن شد دراز","جهد می‌کرد و نمی‌شد لب فراز","زن به خنده افتاد و این خنده غالب شد بر او، به‌طوری‌که کوشش می‌کرد خود را کنترل کند اما موفق نمی‌شد و لب‌هایش بالا نمی‌رفت."],[822,"سخت می‌خندید هم‌چون بنگیان","غالب آمد خنده بر سود و زیان","او به شدت می‌خندید، مانند افراد مست که به حالت طبیعی خود توجهی ندارند. با این خنده، او نشان می‌دهد که مسأله‌ای که در آن قرار دارد، کم‌اهمیت‌تر از آن چیزی است که باید باشد."],[822,"هرچه اندیشید خنده می‌فزود","هم‌چو بند سیل ناگاهان گشود","هر چه بیشتر درباره موضوع فکر می‌کرد، خنده‌اش بیشتر می‌شد، مانند اینکه ناگهان دریچه‌ای در برابر سیل باز شود و همه‌چیز به بیرون بریزد."],[822,"گریه و خنده غم و شادی دل","هر یکی را معدنی دان مستقل","گریه و خنده، غم و شادی، هرکدام یک منبع جداگانه و مستقل از احساسات در دل انسان هستند."],[822,"هر یکی را مخزنی مفتاح آن","ای برادر در کف فتاح دان","هر کسی یک منبعی از احساسات و رازها دارد که کلید آن را باید در دست کسی دانست که می‌تواند آنها را باز کند، برادر."],[822,"هیچ ساکن می‌نشد آن خنده زو","پس خلیفه طیره گشت و تندخو","خنده آن کنیزک هیچ‌وقت متوقف نمی‌شد و این باعث شد که خلیفه عصبی و تندخو شود."],[822,"زود شمشیر از غلافش بر کشید","گفت سر خنده واگو ای پلید","خلیفه با دیدن خنده کنیزک به شدت عصبانی شد و سریعا شمشیرش را بیرون کشید و گفت: «به خاطر این خنده‌ات، حقیقت را بگو، ای پلید!"],[822,"در دلم زین خنده ظنی اوفتاد","راستی گو عشوه نتوانیم داد","این بیت بیانگر این است که از خنده آن کنیزک، در دل خلیفه گماناتی ایجاد شده است؛ زیرا او فکر می‌کند که نمی‌تواند به طور واقعی عشوه و ناز کند، بلکه این خنده نشانه‌ای از حقیقتی دیگر است."],[822,"ور خلاف راستی بفریبیم","یا بهانه چرب آری تو به دم","اگر بخواهیم خلاف حقیقت را بپوشانیم یا با دلیل و بهانه‌ای شکیل تو را فریب دهیم، این کار به سادگی میسر است."],[822,"من بدانم در دل من روشنیست","بایدت گفتن هر آنچ گفتنیست","در درون من نوری وجود دارد که می‌دانم باید به تو هر چیزی را که لازم است بگویم."],[822,"در دل شاهان تو ماهی دان سطبر","گرچه گه گه شد ز غفلت زیر ابر","دل شاهان مانند ماهی روشن و بزرگ است، اما گاهی بر اثر غفلت، مانند اینکه ماه پنهان شود زیر ابر، درخشش آن مخفی می‌ماند."],[822,"یک چراغی هست در دل وقت گشت","وقت خشم و حرص آید زیر طشت","در دل انسان یک شعله و نوری وجود دارد که در زمان خشم و حرص آنها را زیر پوششی مانند طشت می‌برد، به تعبیر دیگر، در لحظه‌های منفی احساسات، این نور درونی پنهان می‌شود."],[822,"آن فراست این زمان یار منست","گر نگویی آنچ حق گفتنست","فراستی که در این زمان با من است، یاری می‌کند. اگر تو هم آنچه را که باید بگویی، نگویی، این به نفع تو نخواهد بود."],[822,"من بدین شمشیر برم گردنت","سود نبود خود بهانه کردنت","با این شمشیر نمی‌توانم بر گردنت ضربه بزنم، زیرا این کار سودی ندارد و تنها بهانه‌ای برای زدن تو خواهد بود."],[822,"ور بگویی راست آزادت کنم","حق یزدان نشکنم شادت کنم","اگر بگویی که می‌خواهم تو را آزاد کنم، این را به درستی می‌گویم و به خاطر خدا نمی‌خواهم شادی تو را بشکنم."],[822,"هفت مصحف آن زمان برهم نهاد","خورد سوگند و چنین تقریر داد","در آن زمان، هفت نسخه از قرآن را بر روی هم قرار داد و با قسم خوردن به این شکل توضیح داد."],[823,"زن چو عاجز شد بگفت احوال را","مردی آن رستم صد زال را","زن که در برابر مردی چون رستم، پسر زال، ناتوان شده بود، احوال و داستان خود را برای او شرح داد."],[823,"شرح آن گردک که اندر راه بود","یک به یک با آن خلیفه وا نمود","این کنیزکی که در راه بود، شرح و توضیح آن گردک (بار دیگر) را یکی یکی به خلیفه بیان کرد و همه چیز را به او گفت."],[823,"شیر کشتن، سوی خیمه آمدن","وان ذکر قایم چو شاخ کرگدن","شیر را کشتند و به سمت چادر (خیمه) آمدند و این اتفاق همانند شاخ کرگدن است که محکم و ثابت باقی می‌ماند."],[823,"باز این سستی این ناموس‌کوش","کاو فرو مرد از یکی خش‌خشت موش","در این بیت، صحبت از مردی است که به دلیل سستی و ناتوانی خود به طور ناخواسته به دام یک موش افتاده است. این توصیف، نشان‌دهنده ضعف و ناباوری او در برابر خطرات و تهدیدات است، به گونه‌ای که او از یک موجود کوچک و بی‌آزار نیز آسیب می‌بیند."],[823,"رازها را می‌کند حق آشکار","چون بخواهد رست، تخم بد مکار","خداوند رازها را به طور آشکار و روشن درمی‌آورد، وقتی که بخواهد به ریشه‌های زشتی و بدی برسد."],[823,"آب و ابر و آتش و این آفتاب","رازها را می برآرد از تراب","آب، ابر، آتش و خورشید سبب می‌شوند که رازها از زمین بیرون بیایند و نمایان شوند."],[823,"این بهار نو ز بعد برگ‌ریز","هست برهان وجود رستخیز","این بهار تازه که بعد از ریزش برگ‌ها به وجود آمده، دلیل و نشانه‌ای از قیامت و رستاخیز است."],[823,"در بهار آن سرّها پیدا شود","هرچه خورده‌ست این زمین رسوا شود","در بهار، حقیقت‌ها آشکار می‌شود و هر چیزی که این زمین پنهان کرده، فاش خواهد شد."],[823,"بردمد آن از دهان و از لبش","تا پدید آید ضمیر و مذهبش","اگر راز او از دهان و لبش بیرون بیاید، باور و اندیشه‌اش به وضوح نمایان خواهد شد."],[823,"سرّ بیخ هر درختی و خورش","جملگی پیدا شود آن بر سرش","راز اصلی هر درخت و میوه‌اش در بالاترین نقطه آن قابل مشاهده است."],[823,"هر غمی کز وی تو دل‌آزرده‌ای","از خمار می بود کان خورده‌ای","هر اندوه و غمی که تو از آن رنجیده‌ای، به دلیل سازش با خمار شرابی است که نوشیده‌ای."],[823,"لیک کی دانی که آن رنج خمار","از کدامین می برآمد آشکار","اما چگونه می‌توانی بفهمی که آن درد و اندوه ناشی از چه نوع شرابی است که پنهان است؟"],[823,"این خمار اشکوفه آن دانه است","آن شناسد کاگه و فرزانه است","این حس نشئه و شیدایی، نتیجه جوانه‌زدن و شکوفایی دانه‌ای است که به بار نشسته. همان‌طور که کسی که آگاه و دانا است، این حقیقت را می‌داند."],[823,"شاخ و اشکوفه نماند دانه را","نطفه کی ماند تن مردانه را؟","اگر شاخ و گل‌وگلی به‌عنوان نشانه‌هایی از حیات و نمو را در نظر بگیریم، در اینجا به این نکته اشاره می‌شود که دانه (نطفه) نمی‌تواند دائما در زمین بماند و باید به مرحله‌ی رشد و نمو برسد، همان‌طور که بدن مرد نمی‌تواند همواره در حالت نطفه باقی بماند و باید بزرگ شود."],[823,"نیست مانندا هیولا با اثر","دانه کی ماننده آمد با شجر؟","هیولا، که به معنای ماده خام یا شکل‌نایافته است، هیچ‌گونه شباهتی با اثر دانه ندارد. به عبارت دیگر، هیولا نمی‌تواند مانند درختی که از دانه به وجود می‌آید، وجودی مشابه داشته باشد."],[823,"نطفه از نانست کی باشد چو نان","مردم از نطفه‌ست کی باشد چنان","نطفه، که نشانه آغاز حیات است، چگونه می‌تواند از نان به وجود آید، در حالی که انسان‌ها از نطفه زاده می‌شوند و بر این اساس، نمی‌توان نطفه را ناشی از نان دانست."],[823,"جنی از نارست کی ماند به نار","از بخارست ابر و نبود چون بخار","جن‌ها وقتی به آتش (نار) تعلق ندارند، چگونه می‌توانند از آتش جدا بمانند؟ ابر هم از بخار آب شکل می‌گیرد، اما خود بخار نیست."],[823,"از دم جبریل عیسی شد پدید","کی به صورت هم‌چو او بد یا ندید","از نفس جبرئیل، عیسی به وجود آمد. آیا مانند او، کسی به این زیبایی و بزرگی دیده شده است یا نه؟"],[823,"آدم از خاکست کی ماند به خاک","هیچ انگوری نمی‌ماند به تاک","انسان همواره از خاک به وجود می‌آید و سرانجام به خاک برمی‌گردد، مثل این‌که انگور روی درخت نمی‌تواند همیشه باقی بماند و سرانجام می‌پوسد."],[823,"کی بود دزدی به شکل پای‌دار","کی بود طاعت چو خلد پایدار","چه کسی از دزدی که مانند پایه‌ای استوار و ثابت به نظر می‌رسد، می‌تواند سرگرم اطاعت خداوند باشد؟ این نشانی از این است که اطاعت واقعی میان دزدی و ثبات وجود ندارد."],[823,"هیچ اصلی نیست مانند اثر","پس ندانی اصل رنج و درد سر","هیچ بنیادی وجود ندارد که مانند تأثیر عواطف و حوادث باشد، بنابراین نمی‌توانی اصل رنج و درد را درک کنی."],[823,"لیک بی‌اصلی نباشدت این جزا","بی‌گناهی کی برنجاند خدا","جزا و پاداشی بدون علت و دلیل وجود ندارد. خداوند بر کسی که بی‌گناه است، ظلم نمی‌کند و او را رنج نخواهد داد."],[823,"آنچ اصلست و کشنده آن شی است","گر نمی‌ماند بوی هم از وی است","هر چیزی که اصل و سبب کشندگی یک موضوع است، اگر وجود نداشته باشد، دیگر بویی از آن موضوع باقی نخواهد ماند. این اشاره به آن دارد که ویژگی‌ها و آثار چیزها وابسته به اصل و حقیقت آن‌هاست."],[823,"پس بدان رنجت نتیجه زلتی‌ست","آفت این ضربتت از شهوتی‌ست","پس بدان که رنج تو نتیجه یک لغزش است و آسیب این زخم تو ناشی از هوس و خواهش‌های نفسانی‌ات می‌باشد."],[823,"گر ندانی آن گنه را ز اعتبار","زود زاری کن طلب کن اغتفار","اگر نمی‌دانی آن گناهی که باعث این وضعیت شده چقدر اهمیت دارد، فوری به درگاه خداوند رو کن و طلب عفو و بخشش کن."],[823,"سجده کن صد بار می‌گوی ای خدا","نیست این غم غیر درخورد و سزا","خدا را صد بار سجده کن و بگو، ای خدا! این غم و مصیبت برای من شایسته و مناسب نیست."],[823,"ای تو سبحان پاک از ظلم و ستم","کی دهی بی‌جرم جان را درد و غم","تو ای خداوند پاک از ظلم و ستم، چگونه می‌گذاری که جان بی‌گناه من به درد و غم دچار شود؟"],[823,"من معین می‌ندانم جرم را","لیک هم جرمی بباید گرم را","من نمی‌دانم گناه او چیست، اما وجود یک گناهی برای این درد و اندوه لازم است."],[823,"چون بپوشیدی سبب را ز اعتبار","دایما آن جرم را پوشیده دار","اگر دلیل و علت این رفتار را به‌خاطر آبروی خود مخفی نگه‌داری، همیشه باید آن گناه را نیز پنهان نگه‌داری."],[823,"که جزا اظهار جرم من بود","کز سیاست دزدیم ظاهر شود","من سزاوار مجازات هستم، زیرا از ترس در برابر قدرت و سیاست، جرایم خود را پنهان کرده‌ام و حالا در معرض افشا قرار دارم."],[824,"شاه با خود آمد استغفار کرد","یاد جرم و زلت و اصرار کرد","شاه به خود گفت که از کرده‌های نادرست و اشتباهاتش پشیمان است و برای آنها عذرخواهی و طلب بخشش می‌کند."],[824,"گفت با خود آنچ کردم با کسان","شد جزای آن به جان من رسان","شاه با خود فکر می‌کند که هرچه بر سر دیگران آورده، حالا عذاب آن بر جان خودش نازل شده است."],[824,"قصد جفت دیگران کردم ز جاه","بر من آمد آن و افتادم به چاه","من به قصد آسیب رساندن به دیگران دست به عمل زشتی زدم، اما این کار باعث شد که همان بدی به خودم بازگردد و در وضعی سخت و دشوار قرار گرفتم."],[824,"من در خانه کسی دیگر زدم","او در خانه مرا زد لاجرم","اگر من در خانه کسی دیگر به او آسیب بزنم، او هم پاسخ آن را در خانه من می‌دهد. با این بیان، اشاره دارد که هر عمل زشتی که انجام دهیم، عواقب و انتقامی در پی خواهد داشت."],[824,"هر که با اهل کسان شد فسق‌جو","اهل خود را دان که قوادست او","هر کسی که با مردم بدکار و فاسد باشد، باید بداند که خودش هم در این فساد و گناه شریک است و او خود موجب بروز فساد در میان آنهاست."],[824,"زانک مثل آن جزای آن شود","چون جزای سیئه مثلش بود","چون کسی کار بدی انجام دهد، پاداش آن نیز باید متناسب با آن بدی باشد؛ به همین دلیل، مجازات او شبیه به عمل زشتش خواهد بود."],[824,"چون سبب کردی کشیدی سوی خویش","مثل آن را پس تو دیوثی و بیش","وقتی تو سبب این اتفاق شدی و او را به سوی خود کشاندی، پس تو هم بی‌حیا و پست هستی و از این بابت در وضعیت بدتری قرار داری."],[824,"غصب کردم از شه موصل کنیز","غصب کردند از من او را زود نیز","من از شاه موصل (حاکم موصل)، کنیزی را به زور گرفتم و آنان نیز به سرعت کنیزی از من را غصب کردند."],[824,"او کامین من بد و لالای من","خاینش کرد آن خیانتهای من","او می‌گوید که دشمنی و خیانت من سبب شده است که به چنین وضعی دچار شوم و این خیانت‌ها که خودم انجام داده‌ام، برای آن خائن، یعنی کسی که از من خیانت دیده، بهانه‌ای شده است."],[824,"نیست وقت کین‌گزاری و انتقام","من به دست خویش کردم کار خام","الان زمان انتقام‌جویی نیست؛ من خودم با دست خودم کار نادانی انجام دادم."],[824,"گر کشم کینه بر آن میر و حرم","آن تعدی هم بیاید بر سرم","اگر من بر آن سردار و حرمش کینه‌ای به دل بپرورانم، سختی و عذاب ناشی از این ظلم به خودم برمی‌گردد."],[824,"هم‌چنانک این یک بیامد در جزا","آزمودم باز نزمایم ورا","همان‌طور که این عذاب و کیفر به من رسید، من هم دوباره آن را امتحان نمی‌کنم و به او ظلم نخواهم کرد."],[824,"درد صاحب موصلم گردن شکست","من نیارم این دگر را نیز خست","صاحب موصل به خاطر ظلم‌هایی که انجام داده، به درد و رنج می‌افتد و من دیگر نمی‌توانم شاهد این درد او باشم و به او سختی بیشتری وارد آورم."],[824,"داد حق‌مان از مکافات آگهی","گفت ان عدتم به عدنا به","حق ما را از عذاب و مجازات آگاه کردی، گفتی اگر به کارهای بد خود بازگردید، ما نیز به عذاب‌تان برمی‌گردیم."],[824,"چون فزونی کردن اینجا سود نیست","غیر صبر و مرحمت محمود نیست","زیاد کردن در این شرایط فایده‌ای ندارد و تنها صبر و مهربانی نیکوست."],[824,"ربنا انا ظلمنا سهو رفت","رحمتی کن ای رحیمیهات رفت","ای خدای ما، ما به خود ظلم کردیم و از رحمت تو به دور شدیم. پس ای رحیم، بر ما رحم کن و ما را ببخش."],[824,"عفو کردم تو هم از من عفو کن","از گناه نو ز زلات کهن","من گناهان خود را بخشیده‌ام، تو نیز از من بگذر و بر گناهان جدیدم چشم‌پوشی کن، همان‌طور که بر اشتباهات گذشته‌ام گذشتی."],[824,"گفت اکنون ای کنیزک وا مگو","این سخن را که شنیدم من ز تو","مولانا با گفتن این بیت به یک کنیزک می‌گوید که اکنون دیگر از او نخواهد خواست که چیزی را پنهان کند، زیرا او از آنچه که شنیده آگاه است. به این شکل، او به کنیزک می‌فهماند که نسبت به مسأله‌ای خاص اطلاعاتی دارد و نیازی به پنهان‌کاری نیست."],[824,"با امیرت جفت خواهم کرد من","الله الله زین حکایت دم مزن","من قصد دارم که تو را با امیر خود (شاه) پیوند دهم، اما از خداوند کمک می‌خواهم و در مورد این موضوع چیزی نگو."],[824,"تا نگردد او ز رویم شرمسار","کو یکی بد کرد و نیکی صد هزار","نمی‌خواهم که او از من خجالت بکشد، چون کسی که یک کار بد کرده، هزاران کار خوب انجام داده است."],[824,"بارها من امتحانش کرده‌ام","خوب‌تر از تو بدو بسپرده‌ام","من بارها او را سنجیده‌ام و بهتر از تو را به او سپرده‌ام."],[824,"در امانت یافتم او را تمام","این قضایی بود هم از کرده‌هام","در این بیت، مولانا به این نکته اشاره می‌کند که اعتماد و امانت‌داری فرد مورد نظر (که به احتمال زیاد به امیر و یا رهبر اشاره دارد) را تایید می‌کند و می‌گوید که همه این وقایع نتیجه اعمال خود اوست. به عبارت دیگر، نیت و اقدامات خود فرد باعث این پیامدها شده است و او در نهایت خود را در دامی که برای دیگران گسترده، گرفتار کرده است."],[824,"پس به خود خواند آن امیر خویش را","کشت در خود خشم قهراندیش را","امیر به درون خود رفت و خشم و قهرش را از دل خواند، یعنی تصمیم گرفت که خشمش را کنترل کند و به یاد خود بیاورد که باید عاقلانه رفتار کند."],[824,"کرد با او یک بهانه دل‌پذیر","که شدستم زین کنیزک من نفیر","او بهانه‌ای زیبا و دل‌پذیر برای گفتگو با امیرش درست کرد و گفت که به خاطر این کنیزک، من به شدت نگران و ناراحت هستم."],[824,"زان سبب کز غیرت و رشک کنیز","مادر فرزند دارد صد ازیز","به خاطر غیرت و حسادت کنیز نسبت به مادرش، فرزندش باید بارها از او و رازهایش پنهان بماند و به او آسیب نرسد."],[824,"مادر فرزند را بس حقهاست","او نه درخورد چنین جور و جفاست","مادر فرزند حقوق و وظایف زیادی بر گردن دارد و شایسته نیست که بر او ظلم و بی‌عدالتی روا داشته شود."],[824,"رشک و غیرت می‌برد خون می‌خورد","زین کنیزک سخت تلخی می‌برد","غیور بودن و حسادت باعث می‌شود که انسان به شدت عذاب ببیند و از کنیزکی که مورد علاقه‌اش است، رنج ببرد و تلخی زیادی را تحمل کند."],[824,"چون کسی را داد خواهم این کنیز","پس ترا اولیترست این ای عزیز","وقتی بخواهم به کسی کنیزی را بدهم، تو اولویت بیشتری داری، ای عزیز."],[824,"که تو جانبازی نمودی بهر او","خوش نباشد دادن آن جز به تو","تو به خاطر او فداکاری کردی و سزاوار نیست که این کنیز به غیر از تو داده شود."],[824,"عقد کردش با امیر او را سپرد","کرد خشم و حرص را او خرد و مرد","شاه تصمیم گرفت تا با امیر پیمان ببندد و او را به حال خود واگذار کند، و خشم و حرص خود را تحت کنترل درآورد و به سعه‌صدر و حکمت رفتار کند."],[825,"گر بدش سستی نری خران","بود او را مردی پیغامبران","اگر او هم مانند نرهای خران (که معروف به سستی‌اند) ضعیف باشد، از او به عنوان مردی که شایسته پیغامبران است، یاد نمی‌شود."],[825,"ترک خشم و شهوت و حرص‌آوری","هست مردی و رگ پیغامبری","فردی که از خشم و شهوت و حرص دوری کند، در واقع به درجه‌ای از انسانیت و بزرگی رسیده و از ویژگی‌های پیامبران برخوردار است."],[825,"نری خر گو مباش اندر رگش","حق همی خواند الغ بگلربگش","سخن از این است که نر خر (خر نر) را به کار نگیری، زیرا در رگ او ندای حق وجود دارد و به نوعی مشخص می‌کند که او ظرفیت الهی دارد، به شرطی که خود را از غرایز و تمایلات دنیوی دور نگه دارد."],[825,"مرده‌ای باشم به من حق بنگرد","به از آن زنده که باشد دور و رد","مردن من بهتر است از اینکه زنده باشم و از حق دور و جدا باشم."],[825,"مغز مردی این شناس و پوست آن","آن برد دوزخ برد این در جنان","جوهر حقیقی انسان، یعنی عقل و صفات نیکو، او را به بهشت می‌برد، در حالی که ظاهر و صفات ناپسند او، رنج و عذاب را به دنبال دارد و او را به دوزخ می‌فرستد."],[825,"حفت الجنه مکاره را رسید","حفت النار از هوا آمد پدید","رسیدن به بهشت از طریق تحمل سختی‌ها و ناملایمات است، در حالی که رسیدن به آتش جهنم از تمایلات و خواسته‌های نفسانی ناشی می‌شود."],[825,"ای ایاز شیر نر دیوکش","مردی خر کم فزون مردی هش","ای ایاز، شیر نر که قوی و شجاع است، تو را به مردی تشبیه می‌کند که نمی‌تواند از روی قوی بودن خود فراتر رود. حتی اگر تو به خاطر اوضاع یا موقعیت خاصی در زندگی‌ات برتری کنی، باز هم در نهایت به اندازه‌ی واقعی خودت به حساب می‌آیی."],[825,"آنچ چندین صدر ادراکش نکرد","لعب کودک بود پیشت اینت مرد","آنچه که او درک نکرده و نمی‌تواند بفهمد، مثل بازی کودکی است که به چالش‌های بزرگسالان نمی‌رسد. در واقع، او هنوز به فهم مسائل بزرگ و جدی نرسیده و در سطحی از شناخت باقی مانده است."],[825,"ای به دیده لذت امر مرا","جان سپرده بهر امرم در وفا","ای کسی که با دیدن لذت کار من، جان خود را به من داده‌ای، به خاطر خواسته‌ام در وفاداری و پایبندی به من."],[825,"داستان ذوق امر و چاشنیش","بشنو اکنون در بیان معنویش","حالا داستان لذت و شیرینی امر الهی را بشنو که منظور از آن، معنای عمیق و روحانی آن است."],[826,"شاه روزی جانب دیوان شتافت","جمله ارکان را در آن دیوان بیافت","روزی شاه به سمت دیوان رفت و تمام ارکان و اعضای مهم را در آن‌جا دید."],[826,"گوهری بیرون کشید او مستنیر","پس نهادش زود در کف وزیر","او (شاه) گوهری درخشان و زیبا بیرون آورد و به سرعت آن را در دست وزیر گذاشت."],[826,"گفت چونست و چه ارزد این گهر","گفت به ارزد ز صد خروار زر","وزیر در پاسخ به سوال شاه درباره ارزش این گوهر می‌گوید: این سنگ قیمتی به اندازه‌ای ارزش دارد که برابر با صد خروار طلا است."],[826,"گفت بشکن گفت چونش بشکنم","نیک‌خواه مخزن و مالت منم","وزیر پاسخ می‌دهد که باید این گوهر را بشکنم، اما در اینجا به نیکی و خیرخواهی می‌گوید که من برای تو و برای حفظ مال و سرمایه‌ات این پیشنهاد را می‌کنم."],[826,"چون روا دارم که مثل این گهر","که نیاید در بها گردد هدر","چگونه می‌توانم اجازه دهم که چنین گوهر ارزشمندی که هیچ‌گاه به این قیمت نمی‌ارزد، بیهوده تلف شود؟"],[826,"گفت شاباش و بدادش خلعتی","گوهر از وی بستد آن شاه و فتی","شاه به وزیر گفت تا همه را شاد کند و او را با لباس و هدایایی که با گوهر تزیین شده بود، تقدیر کند. اما در حقیقت همان لباس و گوهر را از او گرفت."],[826,"کرد ایثار وزیر آن شاه جود","هر لباس و حله کو پوشیده بود","وزیر آن شاه، در اقدامی سخاوت‌مندانه، هر لباس و زیورآلاتی که بر تن داشت را به عنوان انعام و هدیه ارائه کرد."],[826,"ساعتیشان کرد مشغول سخن","از قضیه تازه و راز کهن","وزیر، مشغول سخن گفتن شد و درباره ماجرای جدید و رازی قدیمی در حال صحبت بود."],[826,"بعد از آن دادش به دست حاجبی","که چه ارزد این به پیش طالبی","بعد از آن، این گوهر را به دست یک حاجب داد که ببیند این چیز چقدر ارزش دارد و آن را به کسی بدهد که خواهانش است."],[826,"گفت ارزد این به نیمه مملکت","کش نگهدارا خدا از مهلکت","وزیر می‌گوید آیا این گوهر به‌اندازه نیمه مملکت ارزش دارد؟ پس ای خدا ما را از چنگال خطر نجات بده."],[826,"گفت بشکن گفت ای خورشیدتیغ","بس دریغست این شکستن را دریغ","شاه به وزیر می‌گوید که این گوهر را بشکن، اما وزیر در پاسخ می‌گوید که این کار شگفت‌انگیز و ناراحت‌کننده است و جای افسوس دارد که چنین گوهر باارزشی را بشکنیم."],[826,"قیمتش بگذار بین تاب و لمع","که شدست این نور روز او را تبع","قیمتش را بگذارید میان تابش و درخشش، زیرا این نور مانند روز، او را پرالتهاب کرده است."],[826,"دست کی جنبد مرا در کسر او","که خزینه شاه را باشم عدو","کس نمی‌تواند به من کمک کند تا این گنج گرانبها را بشکنم که من دشمن خزانه شاه هستم و فقط باعث زیان آن می‌شوم."],[826,"شاه خلعت داد ادرارش فزود","پس دهان در مدح عقل او گشود","شاه لباس با ارزشی به او تقدیم کرد و بدین ترتیب از صفات و فضایل عقل او ستایش کرد و زبان به مدح او گشود."],[826,"بعد یک ساعت به دست میر داد","در را آن امتحان کن باز داد","بعد از گذشت یک ساعت، در را به دست مرد (وزیر) داد و گفت که این آزمایش را امتحان کن و دوباره باز کن."],[826,"او همین گفت و همه میران همین","هر یکی را خلعتی داد او ثمین","او همین سخن را گفت و همه بزرگانی که حضور داشتند نیز همین را تأیید کردند، سپس به هر یک از آن‌ها هدایایی داد که ارزشمند و گرانبها بود."],[826,"جامگیهاشان همی‌افزود شاه","آن خسیسان را ببرد از ره به جاه","شاه برای خسیسان (فقرای) بی‌کاره و بی‌مصرف، چیزی می‌افزاید و از راه (زندگی) به مقام و جاه می‌برد."],[826,"این چنین گفتند پنجه شصت امیر","جمله یک یک هم به تقلید وزیر","امیران و فرمانروایان، به تقلید از وزیر، به دور یکدیگر جمع شده‌اند و درباره موضوعی که وزیر مطرح کرده، صحبت می‌کنند و هر یک به نوبه خود نظر می‌دهند."],[826,"گرچه تقلیدست استون جهان","هست رسوا هر مقلد ز امتحان","اگرچه تقلید از دیگران در این دنیا وجود دارد، اما این رفتار باعث رسوایی می‌شود و هر کسی که از دیگران تقلید کند، در آزمایش و امتحان واقعی خود به مشکل برمی‌خورد."],[827,"ای ایاز اکنون نگویی کین گهر","چند می‌ارزد بدین تاب و هنر","ای ایاز، اکنون نگو که این گوهر چه ارزشی دارد با این زیبایی و مهارت."],[827,"گفت افزون زانچ تانم گفت من","گفت اکنون زود خردش در شکن","ایاز گفت: «چیزی بیشتر از آنچه می‌دانم (چیزی که می‌دانم) وجود دارد»، و سپس گفت: «اکنون وقت آن است که درنگ نکنم و بلافاصله خرد را به چالش بکشم (خرد خود را آزمون کنم و در جهت بالا بردن آن تلاش کنم)."],[827,"سنگها در آستین بودش شتاب","خرد کردش پیش او بود آن صواب","آیاز که سنگ‌ها را در آستینش پنهان کرده بود، با شتاب از روی خرد، آن‌ها را در برابرش خرد کرد و در این کار به درستی عمل کرد."],[827,"ز اتفاق طالع با دولتش","دست داد آن لحظه نادر حکمتش","به دلیل خوش‌شانسی و تقدیر، در آن لحظه نادر، فرصت و موقعیتی مناسب و هوشمندانه برای او (ایاز) فراهم شد."],[827,"یا به خواب این دیده بود آن پر صفا","کرده بود اندر بغل دو سنگ را","او در خواب، آن پر فخر و زیبایی را دیده بود که در آغوشش دو سنگ را به همراه دارد. این اشاره به ارزش‌های ظاهری و مادی دارد که ممکن است در نظر برخی از افراد مهم به نظر برسند، اما در واقع ارزش واقعی را ندارند."],[827,"هم‌چو یوسف که درون قعر چاه","کشف شد پایان کارش از اله","همان‌طور که یوسف در عمق چاه به دست عدالت الهی شناخته شد، پایان کار او نیز از سوی خداوند روشن شد."],[827,"هر که را فتح و ظفر پیغام داد","پیش او یک شد مراد و بی‌مراد","هر کسی که پیروزی و موفقیت برایش پیام می‌آورد، هدف و مقصودش برای او روشن و بدون هر گونه تردیدی خواهد بود."],[827,"هر که پایندان وی شد وصل یار","او چه ترسد از شکست و کارزار","هر کسی که به وصل معشوق و یار خود دست یابد، از شکست و جنگ نمی‌ترسد و استقامت دارد."],[827,"چون یقین گشتش که خواهد کرد مات","فوت اسپ و پیل هستش ترهات","زمانی که او به یقین رسید که قهر و شکست نخواهد کرد و رمیدگی اسب و فیل را در می‌یابد، ترس او از چیزهای بی‌معنی و پوچ از بین می‌رود."],[827,"گر برد اسپش هر آنک اسپ‌جوست","اسپ رو گو نه که پیش آهنگ اوست","اگر هر کسی به دنبال اسب خود برود و آن را برباید، نباید بگوید که پیشوای او (اسب) است. در واقع، این اشاره به این است که پیروی از توهمات و چیزهای ظاهری ما را از حقیقت دور می‌کند و باید در تفکر و شناخت دقت کنیم."],[827,"مرد را با اسپ کی خویشی بود","عشق اسپش از پی پیشی بود","مرد و اسب در دوستی و رابطه‌ای با هم نیستند؛ عشق مرد به اسب به خاطر این است که اسب او را به جلو می‌برد و به پیشرفت کمک می‌کند."],[827,"بهر صورتها مکش چندین زحیر","بی‌صداع صورتی معنی بگیر","به جای اینکه خود را در ظاهرها و شکل‌های مختلف مشغول کنی و دردسر بکشی، به معنای واقعی امور توجه کن و از آن‌ها درس بگیر."],[827,"هست زاهد را غم پایان کار","تا چه باشد حال او روز شمار","زاهد (آن کسی که از دنیا و لذات آن کناره می‌گیرد) به غم و اندیشه درباره پایان کارش مشغول است و می‌خواهد بداند در روزهای آینده چه حالتی خواهد داشت."],[827,"عارفان ز آغاز گشته هوشمند","از غم و احوال آخر فارغ‌اند","عارفان از همان ابتدا با درک و هوشیاری خود شروع به کار کرده‌اند و از نگرانی‌های مربوط به پایان کار و وضعیت‌های نهایی بی‌خبر و فارغ هستند."],[827,"بود عارف را همین خوف و رجا","سابقه‌دانیش خورد آن هر دو را","عارف همچنان که به یاد گذشته و علمش به حقایق، همواره میان ترس و امید زندگی می‌کند. این ترس و امید ناشی از آگاهی او از امور گذشته و آینده است."],[827,"دید کو سابق زراعت کرد ماش","او همی‌داند چه خواهد بود چاش","کسی که پیش از این اقدام به کشاوری کرده، می‌داند که در آینده چه چیزی خواهد داشت و از آنچه می‌کارد، آگاه است."],[827,"عارفست و باز رست از خوف و بیم","های هو را کرد تیغ حق دو نیم","عارف از ترس و امیدهای فانی رها شده است و حقیقت او را به حدی قوی کرده که مانند تیغی دو لبه، توانسته است موانع را از میان بردارد."],[827,"بود او را بیم و اومید از خدا","خوف فانی شد عیان گشت آن رجا","او در برابر خداوند هم ترس و هم امید داشت، اما ترس او از بین رفت و امیدش به حقیقت آشکار شد."],[827,"چون شکست او گوهر خاص آن زمان","زان امیران خاست صد بانگ و فغان","وقتی که آن گوهر خاص که در آن زمان بود، شکسته شد، صدای فریاد و ناله از سوی امیران بلند شد."],[827,"کین چه بی‌باکیست والله کافرست","هر که این پر نور گوهر را شکست","هر که بدون ترس و با بی‌توجهی به ارزش و نورانی بودن حقیقت، این گوهر را بشکند، حقیقتا کافر است."],[827,"وآن جماعت جمله از جهل و عما","در شکسته درّ امر شاه را","آن جمع از نادانی و نادیدگی، درّ گرانبهایی را که به عنوان فرمان شاه به آنها داده شده، به راحتی از دست می‌دهند و نمی‌فهمند که چه چیزی را از دست می‌دهند."],[827,"قیمتی گوهر نتیجه مهر و ود","بر چنان خاطر چرا پوشیده شد","قیمتی‌ترین گوهر، نتیجه محبت و دوستی است؛ پس چرا این احساس در دل چنین فردی پنهان مانده است؟"],[828,"گفت ایاز ای مهتران نامور","امر شه بهتر به قیمت یا گهر","ایاز به بزرگان و معتبران می‌گوید که آیا فرمان شاه (سلطان) شما بهتر است یا ارزش و قیمت گوهر (جواهرات)؟"],[828,"امر سلطان به بود پیش شما","یا که این نیکو گهر بهر خدا","آیا فرمان سلطان در نظر شما بهتر است یا این گوهر نیکو برای خدا ارزش بیشتری دارد؟"],[828,"ای نظرتان بر گهر بر شاه نه","قبله‌تان غولست و جاده راه نه","ای توجه شما به ارزش و مروت شاه نیست، بلکه به غولی (شکست و ناکامی) تبدیل شده و مسیر درست را گم کرده‌اید."],[828,"من ز شه بر می‌نگردانم بصر","من چو مشرک روی نارم با حجر","من به خاطر محبت و توجه شاه، به او پشت نمی‌کنم. اگر کسی مثل مشرک‌ها به سنگ نگاه کند، نشان می‌دهد که باطل را بر حق ترجیح می‌دهد."],[828,"بی‌گهر جانی که رنگین سنگ را","برگزیند پس نهد شاه مرا","ایاز با این سخن می‌گوید که اگر کسی بی‌نهایت ارزشمند باشد و جانی خالی از ویژگی‌های انسانی داشته باشد، او حاضر است رنگین‌سنگ (جواهری زینتی) را بر انتخاب شاه (به عنوان مقام و ارزش بالاتر) ترجیح دهد و این انتخاب او را نابود می‌کند."],[828,"پشت سوی لعبت گل‌رنگ کن","عقل در رنگ‌آورنده دنگ کن","به سمت زیبایی‌ها و جذابیت‌های ظاهری که همانند گل رنگارنگ است، نرو و عقل خود را در پی رنگ و لعاب آن نزن."],[828,"اندر آ در جو سبو بر سنگ زن","آتش اندر بو و اندر رنگ زن","در درون ظرفی که از سفال است، بر روی سنگ بزن و آتش را به آن رنگ و عطر ببخش."],[828,"گر نه‌ای در راه دین از ره‌زنان","رنگ و بو مپرست مانند زنان","اگر در راه دین نباشی و از ره‌زنان (دزدان دین) تأثیر بگیری، مانند زنانی که به ظواهر و زینت‌ها توجه دارند، به سمت رنگ و بو (ظاهر فریبنده) نرو."],[828,"سر فرود انداختند آن مهتران","عذرجویان گشته زان نسیان به جان","آن بزرگان که به دنبال عذر و بهانه هستند، سرشان را به نشانه ضعف و شکست پایین انداختند، زیرا فراموشی (نسیان) آنها باعث آسیب به جانشان شده است."],[828,"از دل هر یک دو صد آه آن زمان","هم‌چو دودی می‌شدی تا آسمان","از دل هر یک از آن بزرگان، دو صد آه بلند برمی‌خاست که در آن لحظه مانند دودی به آسمان می‌رفت."],[828,"کرد اشارت شه به جلاد کهن","که ز صدرم این خسان را دور کن","شاه به جلاد قدیمی اشاره کرد و گفت که این افراد نالایق را از جایگاه من دور کن."],[828,"این خسان چه لایق صدر من‌اند","کز پی سنگ امر ما را بشکنند","این افراد پست چه جایگاهی نزد من دارند که به خاطر به دست آوردن سنگ‌های قیمتی، دستور من را نادیده و شکسته می‌گیرند؟"],[828,"امر ما پیش چنین اهل فساد","بهر رنگین سنگ شد خوار و کساد","کارهای ما در برابر این انسان‌های فاسد به خاطر حفظ موقعیت و مقام، به بدی و بی‌ارزشی کشیده شده و در بازار اعتبار و محبوبیت آسیب دیده است."],[829,"پس ایاز مهرافزا بر جهید","پیش تخت آن الغ سلطان دوید","ایاز، نام شخصی مهم و زیرک، با شتاب به سوی تخت سلطان دوید. او به‌عنوان یک فرد مهربان و وفادار، تحت تأثیر موقعیت قرار گرفت و برای جلب توجه سلطان به‌سرعت اقدام کرد."],[829,"سجده‌ای کرد و گلوی خود گرفت","کای قبادی کز تو چرخ آرد شگفت","ایاز با تواضع و فروتنی به زمین افتاد و در حال سجده گلوی خود را گرفت، در حالی که از قدرت و جلال تو، قبادی (شخصیتی با خصوصیات برجسته) شگفت‌زده می‌شود."],[829,"ای همایی که همایان فرخی","از تو دارند و سخاوت هر سخی","ای پرنده‌ای که همچون پرندگان بلندپرواز، بزرگ‌ترها و خوشنام‌ترها از تو برخوردارند و سخاوت هر بخشنده‌ای نیز از تو نشأت می‌گیرد."],[829,"ای کریمی که کرمهای جهان","محو گردد پیش ایثارت نهان","ای انسان سخاوتمند که با کرم و بخشش‌های خود سبب می‌شوی که تمام کرم‌های دیگر در برابر ایثار و فداکاری تو ناپدید شوند و انگار هیچ‌گاه وجود نداشته‌اند."],[829,"ای لطیفی که گل سرخت بدید","از خجالت پیرهن را بر درید","ای لطیف و مهربان، وقتی گل سرخ تو را دید، از خجالت لباس خود را به خاطر عشق و شوق بر درید."],[829,"از غفوری تو غفران چشم‌سیر","روبهان بر شیر از عفو تو چیر","از بخشش و رحمت تو، چشم‌های سیر و پرخوری مانند روباهان در برابر شیر، مغرور و بی‌پروا می‌شوند. این عفو و بخشش توست که به آنها این جسارت را می‌دهد."],[829,"جز که عفو تو کرا دارد سند","هر که با امر تو بی‌باکی کند","هیچ‌کس نمی‌تواند از عفو و بخشش تو بهره‌مند شود، مگر این‌که تو خود او را ببخشی؛ هر کسی که به دستورات تو بی‌احترامی کند، محکوم به مجازات است."],[829,"غفلت و گستاخی این مجرمان","از وفور عفو تست ای عفوران","غفلت و بی‌ادبی این مجرمان ناشی از فراوانی عفو توست، ای کسی که بخشش می‌کنی."],[829,"دایما غفلت ز گستاخی دمد","که برد تعظیم از دیده رمد","غفلت و بی‌احتیاطی همواره بر گستاخی حاکم شده و باعث می‌شود که شخص در نتیجه‌ی آن تعظیم و احترام را از نظر دور کند."],[829,"غفلت و نسیان بد آموخته","ز آتش تعظیم گردد سوخته","غفلت و فراموشی، که نتیجه نادانی است، از آتش تعظیم (احترام) به شدت آسیب می‌بیند و نابود می‌شود."],[829,"هیبتش بیداری و فطنت دهد","سهو نسیان از دلش بیرون جهد","وقتی انسان به عظمت و هیبت خداوند واقف باشد، بیدار و هوشیار می‌شود و خطا و فراموشی از دل او خارج می‌شود."],[829,"وقت غارت خواب ناید خلق را","تا بنرباید کسی زو دلق را","در زمان حمله یا غارت، خواب به کسی نمی‌آید و مردم بیدار می‌شوند تا از خطر آگاه شوند."],[829,"خواب چون در می‌رمد از بیم دلق","خواب نسیان کی بود با بیم حلق","وقتی خواب به سراغ آدم می‌آید و سایه‌ی دلق (لباس اشرافی) او را تهدید می‌کند، فراموشی هم نمی‌تواند با ترس از کار عیبی داشته باشد."],[829,"لاتؤاخذ ان نسینا شد گواه","که بود نسیان بوجهی هم گناه","اگر ما فراموش کردیم، گناهی نخواهد بود، چون فراموشی به نوعی خودش گناه نیست و در واقع نشانه‌ای از آن است که ما به خدای بزرگ مسئولیت‌پذیری داریم."],[829,"زانک استکمال تعظیم او نکرد","ورنه نسیان در نیاوردی نبرد","چون او در برابر عظمت خداوند به طور کامل ارادت و احترام نداشت، بنابراین نسیان (فراموشی) به وجود آمد وگرنه فراموشی از او سر نمی‌زد."],[829,"گرچه نسیان لابد و ناچار بود","در سبب ورزیدن او مختار بود","هرچند فراموشی (نسیان) امری طبیعی و اجتناب‌ناپذیر است، اما او (مرد) در رفتارش مختار و آزاد بوده است که به آن دقت کند و از آن پرهیز کند."],[829,"که تهاون کرد در تعظیمها","تا که نسیان زاد یا سهو و خطا","کسی که در انجام محترمانه و بزرگداشت‌ها کوتاهی کرد، در نتیجه یا به سبب فراموشی یا اشتباه کارش را توجیه می‌کند."],[829,"هم‌چو مستی کو جنایتها کند","گوید او معذور بودم من ز خود","انسانی که در حال مستی اقدام به جنایت و کارهای زشت می‌کند، برای توجیه کارهایش می‌گوید که من خودم را نمی‌شناختم و معذور هستم."],[829,"گویدش لیکن سبب ای زشتکار","از تو بد در رفتن آن اختیار","او به زشتکاری می‌گوید که دلیل این که از تو کار بدی صادر شده، همان اختیار خودت بوده که از دست رفته است."],[829,"بی‌خودی نامد بخود تش خواندی","اختیارت خود نشد تش راندی","بی‌خودی به سراغ خودت نیامدی و خودت را شناختی، لذا اختیارت به خودت تعلق ندارد و آن را از دست داده‌ای."],[829,"گر رسیدی مستی بی‌جهد تو","حفظ کردی ساقی جان عهد تو","اگر در حین مستی به سر رسیدی و بی‌تلاشی توانستی خود را حفظ کنی، ای ساقی (ساقی همان کسی است که شراب می‌دهد)، جان همیشه با وفای تو در یاد است."],[829,"پشت‌دارت بودی او و عذرخواه","من غلام زلت مست اله","ای شاه بزرگ، ای کسی که به هر خطایی از بندگان عذر می‌پذیری، من به خاطر اشتباهات خود که باعث زلت و خطا در خدمت تو شده‌ام، از تو درخواست عفو و بخشش دارم."],[829,"عفوهای جمله عالم ذره‌ای","عکس عفوت ای ز تو هر بهره‌ای","عفوهای تمام موجودات در دنیا در مقایسه با عفو تو مثل ذره‌ای کوچک است؛ زیرا از تو هر کس بهره‌ای می‌برد."],[829,"عفوها گفته ثنای عفو تو","نیست کفوش ایها الناس اتقوا","عفوها تنها وصف و ستایش عفو تو نیست؛ ای مردم، از عذاب الهی بپرهیزید."],[829,"جانشان بخش و ز خودشان هم مران","کام شیرین تو اند ای کامران","از آن‌ها (امرا) جان ببر و خود را از آن‌ها جدا نکن، زیرا کام شیرین تو (لذت و خوشی زندگی) در گرو آن‌هاست، ای کامران (ملک و پادشاه)."],[829,"رحم کن بر وی که روی تو بدید","فرقت تلخ تو چون خواهد کشید","بر او رحم کن، زیرا او چهره‌ات را دیده و حالا که با جدایی تلخ تو مواجه است، چگونه این فراق را تحمل خواهد کرد."],[829,"از فراق و هجر می‌گویی سخن","هر چه خواهی کن ولیکن این مکن","تو هر چه بخواهی درباره فراق و جدایی صحبت کن، اما این موضوع را مطرح نکن که کسی به خاطر آن دچار اندوه و غم می‌شود."],[829,"صد هزاران مرگ تلخ شصت تو","نیست مانند فراق روی تو","مرگ‌های دردناک و سختی که بر انسان می‌گذرد، به هیچ وجه به تلخی دوری و فراق چهره تو نمی‌رسد."],[829,"تلخی هجر از ذکور و از اناث","دور دار ای مجرمان را مستغاث","ای مجرمان، دوری و فراق از مردان و زنان را فراموش کن، زیرا تلخی این جدایی از همه آنچه که می‌شناسی، بیشتر است."],[829,"بر امید وصل تو مردن خوشست","تلخی هجر تو فوق آتشست","مردن به امید وصال تو خوشایند است، اما تلخی دوری از تو از آتش هم شدیدتر است."],[829,"گبر می‌گوید میان آن سقر","چه غمم بودی گرم کردی نظر","گبر (کافر) می‌گوید که وقتی در آن جهنم (سقر) بودم، چه غمی داشتم، چون نگاه تو (خدا یا معشوق) مرا گرم و شاداب کرد."],[829,"کان نظر شیرین کننده رنجهاست","ساحران را خونبهای دست و پاست","این نظر شیرین و دل‌انگیز باعث تسکین و آرامش رنج‌هاست و برای ساحران، بهایی است که برای انجام کارهای خود پرداخت می‌کنند."],[830,"نعره لا ضیر بشنید آسمان","چرخ گویی شد پی آن صولجان","رعد گزندگریزی که آسمان بشنید گویی جهان چو گوی پی ضربه‌ی چوگانی غلتید"],[830,"ضربت فرعون ما را نیست ضیر","لطف حق غالب بود بر قهر غیر","چماق دیکتاتور نمی‌تواند همواره آزار دهنده باشد زیرا لطف طبیعت چون رعد بر تندر خشم او غلبه دارد"],[830,"گر بدانی سرّ ما را ای مضل","می‌رهانیمان ز رنج ای کوردل","اگر بدانید حقیقت ما را، ای گمراه، ما را از این رنج نجات می‌دهید، ای دل‌کور."],[830,"هین بیا زین سو‌، ببین کاین ارغنون","می‌زند یا لیت قومی یعلمون","به بشنو از ما که این نغمه‌ی ساز است یا شاخ گاو ملتی جاهل"],[830,"داد ما را داد‌ حق، فرعونی‌یی","نی چو فرعون ملکت فانی‌یی","ما از خدا حق و عدالت می‌طلبیم و مانند فرعون نیستیم که بر حکمرانی فانی خود تکیه کند."],[830,"سر بر آر و ملک بین زنده ، جلیل","ای شده غره به مصر و رود نیل","سر خود را بالا ببر و حکومت زنده و بزرگ را ببین، ای کسی که به مصر و رود نیل دلخوش کرده‌ای."],[830,"گر تو ترک این نجس خرقه کنی","نیل را در نیل جان غرقه کنی","اگر تو این لباس ناپاک (خرقه، که نمادی از پلیدی یا دنیاپرستی است) را کنار بگذاری، می‌توانی با روح و جان‌ات به عمق نیل (رود نیل) بروی و به سرچشمه حیات و پاکی دست یابی."],[830,"هین بدار از مصر ای فرعون دست","در میان مصر جان صد مصر هست","ای فرعون، از مصر (مصر به معنای سرزمین و زندگی مادی) دست بردار، زیرا در دل این سرزمین، جان و حقیقتی عمیق‌تر از خود مصر وجود دارد که صد بار بیشتر از آنچه به ظاهر می‌بینی ارزشمند است."],[830,"تو انا و رب همی‌گویی به عام","غافل از ماهیت این هر دو نام","تو می‌گویی «من» و «خدای» ما، اما از حقیقت و ماهیت این دو واژه غافلی."],[830,"رب بر مربوب کی لرزان بود‌؟","کی انا دان بند جسم و جان بود‌؟","صاحب و خداوند (واقعی) کی به مربوب خود لرزان و وحشت‌زده می‌شود؟ کی کسی که انادان است (کسی که معنی انا را می‌داند) اسیر و دربند جسم و جان می‌گردد؟"],[830,"نک انا ماییم رسته از انا","از انای پر بلای پر عنا","ما همان کسانی هستیم که از «ما» به «من» در آمدیم، از وجودی پر از بلا و عذاب به وجودی رها و آزاد رسیدیم."],[830,"آن انایی بر تو ای سگ‌، شوم بود","در حق ما دولت محتوم بود","این \"انایی\" که به تو نسبت داده می‌شود، به نوعی تحقیر و ذلت است، و ما بر اساس تقدیر الهی به سعادت و نیکبختی خواهیم رسید."],[830,"گر نبودیت این انایی کینه‌کش","کی زدی بر ما چنین اقبال خوش","اگر این خودخواهی و انایی تو وجود نداشت، چگونه چنین خوشبختی و خوش‌اقبالی بر ما می‌بارید؟"],[830,"شکر آنک از دار فانی می‌رهیم","بر سر این دار پندت می‌دهیم","خوشحالم که از این دنیای فانی می‌رویم و به‌جای نگران بودن، درس و پند می‌دهیم."],[830,"دار قتل ما براق رحلت است","دار ملک تو غرور و غفلت است","این جهان که ما در آن زندگی می‌کنیم، مانند جایی است که ما را به سوی مرگ می‌برد و اینجا جایگاه واقعی تو، یعنی خداوند، است که در آن غفلت و فریب وجود دارد."],[830,"این حیاتی خفیه در نقش ممات","وان مماتی خفیه در قشر حیات","در اینجا بیان می‌شود که نوعی زندگی در عالم پنهانی وجود دارد که در سایه مرگ قرار دارد، و همچنین مرگ نیز در واقع در لایه‌ای از زندگی نهفته است. به عبارت دیگر، آنچه که به نظر می‌رسد مرگ است، ممکن است حاوی زندگی باشد و آنچه که به عنوان حیات شناخته می‌شود، ممکن است در برگیرنده‌ مرگ باشد."],[830,"می‌نماید نور نار و نار نور","ورنه دنیا کی بدی دارالغرور‌؟","به نظر می‌رسد که زندگی در این دنیا هم نور و روشنی دارد و هم ظلمت و آتش، اما مگر می‌توان این دنیا را محل فریب و نیرنگ دانست؟"],[830,"هین مکن تعجیل‌، اول نیست شو","چون غروب آری‌، بر آ از شرق ضو","نکن عجله، نیستی اول را فراموش کن؛ چون هنگام غروب، نور از سمت شرق می‌تابد."],[830,"از انایی ازل دل دنگ شد","این انایی سرد گشت و ننگ شد","از زمان ازل، عشق و محبت دل را پر کرده است و این منیت، سرد و ننگین شده است."],[830,"زان انای بی‌انا خوش گشت جان","شد جهان او از انایی جهان","از آن من‌ بی‌من، جان خوش و تازه گشت؛ و او از من‌بودن جهان‌، رها شد. (در مصرع دوم جهان اولی به‌معنی جهیده و جهنده است که در بیت معنی کاملا جدا و رها می‌دهد)"],[830,"از انا چون رست اکنون شد انا","آفرین‌ها بر انای بی عنا","وقتی از «منیت» رها شویم، آن‌گاه «منیت» معنوی و واقعی ما به وجود می‌آید و بر این وجود واقعی باید احترام گذاشت و افتخار کرد."],[830,"کو گریزان و انایی در پیش","می‌دود چون دید وی را بی ویش","کسی که از خود بگریزد و در تلاش است تا به «من» خود برسد، به محض دیدن «او» که بدون آن «من» و خودخواهی است، در پی او می‌دود."],[830,"طالب اویی نگردد طالبت","چون بمردی طالبت شد مطلبت","طالب تو نیست که در جستجوی تو باشد، وقتی که تو مرده‌ای، طلب تو هم از بین می‌رود."],[830,"زنده‌ای‌، کی مرده‌شو شوید ترا‌؟","طالبی‌، کی مطلبت جوید ترا‌؟","اگر زنده‌ای، چگونه می‌خواهی مرده شوی؟ اگر طالب چیزی هستی، چگونه آن چیز تو را جستجو خواهد کرد؟"],[830,"اندرین بحث ار خرد ره‌بین بدی","فخر رازی رازدان دین بدی","در این گفتگو اگر خرد و بصیرت منجر به درک درست از مسائل شود، فخر رازی (فخرالدین رازی، عالم و فیلسوف) می‌تواند به عنوان یک آگاه و رازدان دین در نظر گرفته شود."],[830,"لیک چون من لمن یذق لم یدر بود","عقل و تخییلات او حیرت فزود","اما هنگامی که کسی طعم حقیقت را بچشد، دیگر نمی‌داند عقل و اندیشه‌هایش چیست و این موجب حیرت و شگفتی او بیشتر می‌شود."],[830,"کی شود کشف از تفکر این انا","آن انا مکشوف شد بعد از فنا","کشف و درک حقیقت و معنای عمیق‌تر چیزی، زمانی برای انسان ممکن می‌شود که از مفهوم «من» و خودخواهی فراتر برود و به حالت فنا و نابودی از خود برسد. تنها در این حالت است که می‌تواند به معنی واقعی «انا» یعنی وجود و حقیقت دست یابد."],[830,"می‌فتد این عقل‌ها در افتقاد","در مغاکی حلول و اتحاد","عقل‌ها در جستجوی حقیقت و درک عمیق، به قهری در گمراهی و سردرگمی می‌افتند و به جایی می‌رسند که در آنجا ادغام و وحدت با معانی عمیق وجود دارد."],[830,"ای ایاز گشته فانی ز اقتراب","هم‌چو اختر در شعاع آفتاب","ای ایاز (که نام یکی از یاران اوست) تو نیز مانند ستاره‌ای که در نزدیکی آفتاب قرار دارد، از بین رفته و غیرموجود شده‌ای. به این معنا که نزدیکی به حقیقت یا کمال، وجود ظاهری را از بین می‌برد."],[830,"بلک چون نطفه مبدل تو به تن","نه از حلول و اتحادی مفتتن","تو مانند نطفه‌ای هستی که به جسم تبدیل می‌شود و نباید گمراه شوی و به اشتباه به اتحاد یا حلول (آمیختگی روح و جسم) فکر کنی."],[830,"عفو کن ای عفو در صندوق تو","سابق لطفی همه مسبوق تو","ای خداوند بزرگ، تو که عفو و بخشش در وجودت همچون یک گنجینه است، پس مرا ببخش، زیرا پیش از این همیشه لطف و محبت تو شامل حال من بوده است."],[830,"من کی باشم که بگویم عفو کن","ای تو سلطان و خلاصه امر کن","من چه کسی هستم که از تو بخواهم مرا ببخشی، ای سلطان؟ در واقع تو خودت باید سرنوشت را تعیین کنی."],[830,"من کی باشم که بوم من با منت","ای گرفته جمله منها دامنت","من چه کسی هستم که از تو عذرخواهی کنم در حالی که همه وجودم به دست توست و تمام وجودم از آن توست؟"],[831,"من کی آرم رحم خلم آلود را","ره نمایم حلم علم‌اندود را","من چگونه می‌توانم رحمتی را به کسی که در آلودگی قرار دارد، ارائه دهم؟ من فقط علم و حلم (خودداری) را می‌شناسم که در این زمینه راهنمایی می‌کند."],[831,"صد هزاران صفع را ارزانیم","گر زبون صفعها گردانیم","اگر صفت‌های زشت و ناپسند را به‌راحتی ببخشیم و خوارشان کنیم، این به معنای آن است که ارزش و اهمیتی برای آن‌ها قائل نیستیم."],[831,"من چه گویم پیشت اعلامت کنم","یا که وا یادت دهم شرط کرم","من نمی‌دانم چه بگویم تا به تو بفهمانم یا یادآوری کنم که شرط بخشندگی چیست."],[831,"آنچ معلوم تو نبود چیست آن","وآنچ یادت نیست کو اندر جهان","آن‌چه که تو از حقیقت نمی‌دانی چیست و آن‌چه که فراموش کرده‌ای، چه در دنیای واقعی، در زندگی‌ات وجود دارد."],[831,"ای تو پاک از جهل و علمت پاک از آن","که فراموشی کند بر وی نهان","ای کسی که از نادانی پاکی و علمت نیز از فراموشی مصون است، بر او چیزهای پنهان نیست."],[831,"هیچ کس را تو کسی انگاشتی","هم‌چو خورشیدش به نور افراشتی","هیچ‌کس را تو مثل خودت به حساب نیاوردی و او را همچون خورشیدی درخشان و نورانی نکردی."],[831,"چون کسم کردی اگر لابه کنم","مستمع شو لابه‌ام را از کرم","اگر من را از خودت دور کرده‌ای، حالا که دردم را می‌گویم، به سخنان من گوش بده و به خاطر بخشش و مهرت به من توجه کن."],[831,"زانک از نقشم چو بیرون برده‌ای","آن شفاعت هم تو خود را کرده‌ای","چون تو مرا از نقشی که داشتم بیرون برده‌ای، پس تو خودت به نوعی در این شفاعت (میانجی‌گری) تقصیرکار شده‌ای."],[831,"چون ز رخت من تهی گشت این وطن","تر و خشک خانه نبود آن من","وقتی که از چهره‌ام (یعنی من) این سرزمین (قلب یا وجود) خالی شد، دیگر نه چیز تر و تازه‌ای در آن مانده و نه خشک و بی‌روحی؛ بنابراین، آن‌جا دیگر جایی از من نیست."],[831,"هم دعا از من روان کردی چو آب","هم نباتش بخش و دارش مستجاب","دعای من مانند آب روان است که تو به آن روح و زندگی می‌بخشی و درختش را بارور و اجابتش را ممکن می‌کنی."],[831,"هم تو بودی اول آرنده دعا","هم تو باش آخر اجابت را رجا","خودت بودی که نخست دعا را به من الهام کردی و حالا هم تو هستی که در پایان، اجابت دعا را به ما می‌دهی و ما به تو امیدواریم."],[831,"تا زنم من لاف کان شاه جهان","بهر بنده عفو کرد از مجرمان","من می‌خواهم ادعا کنم که شاه جهان به خاطر بنده‌ها از گناهکاران گذشت کرده است."],[831,"درد بودم سر به سر من خودپسند","کرد شاهم داروی هر دردمند","من در تمام وجودم درد و رنج بودم و خودم را بزرگ و محترم می‌دانستم، اما شاه (که نماد خدا یا یک شخصیت بزرگ است) به خاطر شفقت و مهربانی‌اش، درمان و تسکین هر بیمار و دردمندی شده است."],[831,"دوزخی بودم پر از شور و شری","کرد دست فضل اویم کوثری","من در دوزخ به شدت مضطرب و آشفته بودم، اما لطف و بخشش او (خدا) باعث شد که به سرمنزلی آرام و شیرین مانند کوثر (رودی در بهشت) برسم."],[831,"هر که را سوزید دوزخ در قود","من برویانم دگر بار از جسد","هر کسی را که دوزخ در قید و بند خود سوزانده، من دوباره از جسمش برمی‌افرازم و زنده می‌کنم."],[831,"کار کوثر چیست که هر سوخته","گردد از وی نابت و اندوخته","کار کوثر چیست که هر کس از آن سوخته شود، دوباره زنده و نجات یافته می‌گردد."],[831,"قطره قطره او منادی کرم","کانچ دوزخ سوخت من باز آورم","هر قطره از کوثر، مایه‌ی کرم و رحمت خداوند است و می‌تواند کسی را که در دوزخ عذاب می‌بیند، نجات دهد و او را بازگرداند."],[831,"هست دوزخ هم‌چو سرمای خزان","هست کوثر چون بهار ای گلستان","دوزخ مشابه سرمای سخت پاییز است که در آنجا تنها عذاب و اندوه وجود دارد، اما کوثر همانند بهار است که سرشار از نعمت و خوشی در گلستان بهشتی است."],[831,"هست دوزخ هم‌چو مرگ و خاک گور","هست کوثر بر مثال نفخ صور","دوزخ همانند مرگ و خاک گور است، و کوثر همچون ندای قیامت (نفخ صور) می‌ماند که نویدبخش حیات دوباره است."],[831,"ای ز دوزخ سوخته اجسامتان","سوی کوثر می‌کشد اکرامتان","شما که به خاطر طعم دوزخ و آتش عذاب، به سمت کوثر (سرچشمه حیات و نعمت) جلب می‌شوید، این جذبه به خاطر کرامت و بزرگواری شماست."],[831,"چون خلقت الخلق کی یربح علی","لطف تو فرمود ای قیوم حی","وقتی که خداوند به خلق کردن مخلوقات پرداخته، لطف و مهربانی‌ات بر آن‌ها چگونه می‌تواند برای تو سودی داشته باشد، ای قیوم زنده؟"],[831,"لالان اربح علیهم جود تست","که شود زو جمله ناقصها درست","خدای مهربان با بخشش و کرم خود می‌تواند همگان را از نقص‌ها و کمبودهایشان نجات بخشد و به آنها کمال و تمامیت ببخشد."],[831,"عفو کن زین بندگان تن‌پرست","عفو از دریای عفو اولیترست","ای خدای عزت، از بندگانی که فقط به جسم خود وابسته‌اند، عفو کن؛ چرا که بخشش تو از عفو سایرین برتر و وسیع‌تر است."],[831,"عفو خلقان هم‌چو جو و هم‌چو سیل","هم بدان دریای خود تازند خیل","عفو مردم مانند جو و سیل است و همه به سوی دریای رحمت خدا روانه می‌شوند."],[831,"عفوها هر شب ازین دل‌پاره‌ها","چون کبوتر سوی تو آید شها","عفوها مانند کبوترانی هستند که از دل‌های شکسته و آشفته ما هر شب به سوی تو، ای شاه، می‌آیند."],[831,"بازشان وقت سحر پران کنی","تا به شب محبوس این ابدان کنی","در وقت سحر، دوباره آن‌ها را به پرواز درآور چون شب برای این بدن‌های محبوس و اسیر، آزادی ببخشی."],[831,"پر زنان بار دگر در وقت شام","می‌پرند از عشق آن ایوان و بام","در غروب، بار دیگر پرندگان به عشق آن ایوان و بام پرواز می‌کنند."],[831,"تا که از تن تار وصلت بسکلند","پیش تو آیند کز تو مقبلند","وقتی که مانند تار و پود زندگی به هم می‌پیچند و از تو دور می‌شوند، آن‌ها به سوی تو می‌آیند، زیرا از تو استقبال می‌کنند."],[831,"پر زنان آمن ز رجع سرنگون","در هوا که انا الیه راجعون","زنان پرنده‌ای که بر فراز هوا پرواز می‌کنند، از وحشت بازگشت به زمین به شدت مضطرب و سرنگون شده‌اند، زیرا می‌دانند که به سوی خدا و قیامت برمی‌گردند."],[831,"بانگ می‌آید تعالوا زان کرم","بعد از آن رجعت نماند از حرص و غم","بعد از آنکه به زندگی بازگشتید، صدایی می‌آید که می‌گوید برای کرم و رحمت به جانب ما بیایید و دیگر از حرص و غم خودتان رها شوید."],[831,"بس غریبیها کشیدیت از جهان","قدر من دانسته باشید ای مهان","ای بزرگواران، شما در این جهان تجربه‌های زیادی از بی‌کسی و غریب‌نوازی را پشت سر گذاشته‌اید، به همین دلیل قدر و مقام من را بدانید."],[831,"زیر سایه این درختم مست ناز","هین بیندازید پاها را دراز","زیر سایه این درخت زیبا که مستی و ناز را به یاد می‌آورد، به آرامی پاهای خود را دراز کنید و استراحت کنید."],[831,"پایهای پر عنا از راه دین","بر کنار و دست حوران خالدین","پای‌های پر از زینت و زیبایی این صوفیان که در مسیر دین قدم برمی‌دارند، به کنار رفته و دست به حوران (موجودات زیبا در بهشت) زده‌اند. این اشاره به ولع و تمایل این افراد به زیبایی‌های دنیوی دارد."],[831,"حوریان گشته مغمز مهربان","کز سفر باز آمدند این صوفیان","حوریان مهربان که از سفر بازگشته‌اند، به حال صوفیان که در عشق و معنویت غرق شده‌اند، دچار حسرت و اندوه هستند."],[831,"صوفیان صافیان چون نور خور","مدتی افتاده بر خاک و قذر","صوفیان و عارفان پاک که مانند نور خورشید هستند، مدتی در زمین و در وضعیت ناپاکی بوده‌اند."],[831,"بی‌اثر پاک از قذر باز آمدند","هم‌چو نور خور سوی قرص بلند","آن‌ها از آلودگی و گناه خود پاک شده‌اند و مانند نوری که به سمت ماه (قرص بلند) حرکت می‌کند، به سوی عرش و مقام عالی برمی‌گردند."],[831,"این گروه مجرمان هم ای مجید","جمله سرهاشان به دیواری رسید","این گروه از مجرمان، ای مجید، دیگر به جایی رسیده‌اند که سرهایشان به دیواری برخورد کرده است؛ به معنایی، به بن‌بست و سختی افتاده‌اند."],[831,"بر خطا و جرم خود واقف شدند","گرچه مات کعبتین شه بدند","آن‌ها به اشتباهات و گناهان خود آگاه شدند، هرچند که در مقام و عظمت شه (سلطان) به مانند کعبه، باعظمت و فلک‌نورد بودند."],[831,"رو به تو کردند اکنون اه‌کنان","ای که لطفت مجرمان را ره‌کنان","هم‌اکنون به سوی تو آمده‌اند در حالی که به درد و زاری مشغولند، ای کسی که رأفت و رحم تو مجرمان را نجات می‌دهد و به آنها راه می‌دهد."],[831,"راه ده آلودگان را العجل","در فرات عفو و عین مغتسل","ای خدا، به ما راهی بده تا غرق در آلودگی‌هایمان نباشیم و از فرات (رود فرات) که نشانه‌ی پاکی و بخشش است، بهره‌مند شویم و شستشوی روحی پیدا کنیم."],[831,"تا که غسل آرند زان جرم دراز","در صف پاکان روند اندر نماز","برای پاک شدن از گناهان بزرگ و طولانی، باید خود را شستشو دهند و سپس در صف پاکان برای انجام نماز قرار بگیرند."],[831,"اندر آن صفها ز اندازه برون","غرقگان نور نحن الصافون","در آن صف‌های نماز، افرادی وجود دارند که از حد و اندازه فراتر رفته‌اند و به قدری در نور غرق شده‌اند که شایسته قرار گرفتن در صف پاکان هستند."],[831,"چون سخن در وصف این حالت رسید","هم قلم بشکست و هم کاغذ درید","زمانی که به توصیف این حالت پرداخته می‌شود، هم قلم می‌شکند و هم کاغذ پاره می‌شود."],[831,"بحر را پیمود هیچ اسکره‌ای","شیر را برداشت هرگز بره‌ای","هیچ موجود ضعیفی (بره) نمی‌تواند به جای یک موجود قوی و شجاع (شیر) برگردد، حتی اگر به عمق دریا (چیزهای بزرگ و دشوار) برود. این بیت به مفهوم ناتوانی و ضعف در برابر قدرت است."],[831,"گر حجابستت برون رو ز احتجاب","تا ببینی پادشاهی عجاب","اگر حجاب و مانعی بر تو وجود دارد، از آن بیرون برو تا بتوانی پادشاهی شگفت‌انگیز (خدا) را ببینی."],[831,"گرچه بشکستند جامت قوم مست","آنک مست از تو بود عذریش هست","اگرچه گروهی که مست بودند، جام تو را شکستند، اما عذری که برای آنها وجود دارد این است که آنها از تو مست بودند."],[831,"مستی ایشان به اقبال و به مال","نه ز باده تست ای شیرین فعال","مستی آن قوم ناشی از ثروت و خوش‌شانسی آن‌هاست و ربطی به باده تو ندارد، ای محبوب زنده و خوش‌خلق."],[831,"ای شهنشه مست تخصیص توند","عفو کن از مست خود ای عفومند","ای پادشاه مست، لطفا عفو کن و به خاطر حالتی که در مستی به سر می‌برم، من را ببخش."],[831,"لذت تخصیص تو وقت خطاب","آن کند که ناید از صد خم شراب","لذت خاصی که از شنیدن خطابه‌ی تو به دست می‌آید، به اندازه‌ای است که هیچ کدام از صد نوع شراب نمی‌تواند به آن نزدیک شود."],[831,"چونک مستم کرده‌ای حدم مزن","شرع مستان را نبیند حد زدن","وقتی مرا به حالت مستی درآورده‌ای، حدود و قوانین شرع را برای مستان نمی‌بینند و نمی‌توانند بر آن‌ها اعمال کنند."],[831,"چون شوم هشیار آنگاهم بزن","که نخواهم گشت خود هشیار من","وقتی که به حالت هشیاری برگردم، آن‌گاه مرا تنبیه کن، چون در آن زمان دیگر نمی‌خواهم انسان هشیار و مسئولیت‌پذیری باشم."],[831,"هرکه از جام تو خورد ای ذوالمنن","تا ابد رست از هش و از حد زدن","هر کسی که از جام محبت تو، ای بخشنده بزرگ، بنوشد، تا ابد از هر نوع سختی و مشکلات دیگر دور خواهد بود و دیگر به مرز و محدودیتی نخواهد رسید."],[831,"خالدین فی فناء سکرهم","من تفانی فی هواکم لم یقم","آنان که در راه عشق شما غرق شده‌اند و از سکر (مستی) آن بهره‌مندند، در جاودانگی و سرور خود باقی خواهند ماند و نمی‌توانند از این حالت بیرون بیایند."],[831,"فضل تو گوید دل ما را که رو","ای شده در دوغ عشق ما گرو","دل ما به خاطر محبت و فضلت به تو می‌گوید که برو، زیرا عشق ما به تو مانند دوغی شده که در آن گرفتار شده‌ایم."],[831,"چون مگس در دوغ ما افتاده‌ای","تو نه‌ای مست ای مگس تو باده‌ای","تو مانند مگسی هستی که در دوغ ما افتاده‌ای و حالا مست نیستی؛ بلکه در واقع خودت همان باده (شراب) هستی."],[831,"کرکسان مست از تو گردند ای مگس","چونک بر بحر عسل رانی فرس","مگس‌ها از تو مست و خوشحال می‌شوند، ای مگس، چون تو را به سمت دریاچه‌ای از عسل می‌کشانی."],[831,"کوهها چون ذره‌ها سرمست تو","نقطه و پرگار و خط در دست تو","کوه‌ها مانند ذره‌هایی به مستی درآمده‌اند و در اختیار تو هستند؛ تو به مانند یک هندسه‌دان، نقطه، پرگار و خط را در دست داری."],[831,"فتنه که لرزند ازو لرزان تست","هر گران‌قیمت گهر ارزان تست","فتنه‌ای که به خاطر آن دیگران دچار لرزش و اضطراب می‌شوند، برای تو که قدرت و عظمت داری، چیزی ناچیز و بی‌ارزش است. به عبارتی، برای کسی که دارای مقام و عظمت است، مشکلات و فتنه‌ها ارزش چندانی ندارند."],[831,"گر خدا دادی مرا پانصد دهان","گفتمی شرح تو ای جان و جهان","اگر خدا به من پانصد دهان می‌داد، باز هم نمی‌توانستم تمام ویژگی‌ها و عظمت تو، ای جان و جهان، را شرح دهم."],[831,"یک دهان دارم من آن هم منکسر","در خجالت از تو ای دانای سر","من فقط یک دهان دارم و آن هم در برابر تو، ای دانای بزرگ، خجالت‌زده و ناامید است."],[831,"منکسرتر خود نباشم از عدم","کز دهانش آمدستند این امم","من باید در خجالت از وجود خودم بیشتر از عدم، که از آنجا این امم (افراد) به وجود آمده‌اند، منکسر باشم."],[831,"صد هزار آثار غیبی منتظر","کز عدم بیرون جهد با لطف و بر","صد هزار نشانه و نشانه‌های پنهان و غیبی در انتظارند که از عدم (هیچ) خارج شوند و با لطف و رحمت خداوند به ظهور برسند."],[831,"از تقاضای تو می‌گردد سرم","ای ببرده من به پیش آن کرم","سرم به خاطر درخواست تو به گرد من می‌چرخد، ای کسی که مرا به درگاه آن بخشنده بزرگ هدایتی."],[831,"رغبت ما از تقاضای توست","جذبه حقست هر جا ره‌روست","ما به خاطر درخواست تو، علاقه‌مند و مشتاق شده‌ایم، اما در واقع این کشش و جاذبه حق است که هر جا کسی در مسیر خود حرکت کند، او را به پیش می‌برد."],[831,"خاک بی‌بادی به بالا بر جهد","کشتی بی‌بحر پا در ره نهد","خاکی که در آن وزش بادی نیست، تلاش می‌کند تا بالا رود، مانند کشتی که در دریایی وجود ندارد، اما به خاطر پا، راه را ادامه می‌دهد. این تعبیر به تلاش بی‌هدف و بی‌پایه اشاره دارد."],[831,"پیش آب زندگانی کس نمرد","پیش آبت آب حیوانست درد","هیچ‌کس پیش آب زندگی نمی‌میرد، چرا که این آب پایدار است و آب حیات است. در واقع، آب حیات منبع شفاست و زندگی را ادامه می‌دهد."],[831,"آب حیوان قبله جان دوستان","ز آب باشد سبز و خندان بوستان","آب حیات (آب زندگی) برای دوستان، جهت‌گیری و مرکز وجود آن‌هاست و این آب، درختان و گل‌های بوستان را شاداب و سبز می‌کند."],[831,"مرگ آشامان ز عشقش زنده‌اند","دل ز جان و آب جان بر کنده‌اند","عشاق، با وجود مرگ، با عشق زندگی می‌کنند و دل آن‌ها از جان و آب حیات تفکیک‌ناپذیر است."],[831,"آب عشق تو چو ما را دست داد","آب حیوان شد به پیش ما کساد","آب عشق تو به ما رسید و باعث حیات و زندگی ما شد، ولی آب زندگی (آب حیات) در مقایسه با آن عشق برای ما ارزشی ندارد و در نظر ما بی‌اهمیت است."],[831,"ز آب حیوان هست هر جان را نوی","لیک آب آب حیوانی توی","هر انسانی از آب حیات برخوردار است و زندگی‌اش به آن وابسته است، اما آب حیات تو، که همانا عشق و معنویت است، برتر و خاص‌تر از آب حیوانی معمولی است."],[831,"هر دمی مرگی و حشری دادیم","تا بدیدم دست برد آن کرم","در هر لحظه با مرگ و قیامت روبه‌رو می‌شویم، بنابراین من این فرصت را دارم که به رحمت و مهربانی خداوندی که دست به کمک می‌زند، توجه کنم."],[831,"هم‌چو خفتن گشت این مردن مرا","ز اعتماد بعث کردن ای خدا","من همچون خواب شدن، مردن من نیز از روی اعتماد به تو است، ای خدا، که مرا در روز قیامت برمی‌انگیز."],[831,"هفت دریا هر دم ار گردد سراب","گوش گیری آوریش ای آب آب","اگر هفت دریا هم هر لحظه به صورت سراب و توهم درآید، تو ای آب، آن را به گوش خود بگیر و درک کن."],[831,"عقل لرزان از اجل وان عشق شوخ","سنگ کی ترسد ز باران چون کلوخ","عقل در برابر مرگ به شدت مضطرب و لرزان است، اما عشق واقعی و شاداب مانند کلوخی در برابر باران ترسی ندارد. عشق موجب بی‌باوری و شجاعت در برابر خطرات و حوادث زندگی می‌شود."],[831,"از صحاف مثنوی این پنجمست","بر بروج چرخ جان چون انجمست","این شعر به تصویر کشیدن ارتفاع روح و جایگاه بلند جان انسان در میان کوه‌های بلند و ستاره‌ها اشاره دارد. شبیه‌سازی به آسمان و ستاره‌ها نشان‌دهنده عظمت و نورانی بودن معرفت و حقیقت در مثنوی مولاناست."],[831,"ره نیابد از ستاره هر حواس","جز که کشتیبان استاره‌شناس","تنها کشتی‌بان آگاه و اطرافی خود یعنی ستاره‌شناس می‌تواند از میان ستاره‌ها و نشانه‌ها راه را بیابد، زیرا سایر حواس به تنهایی در تشخیص مسیر ناتوانند."],[831,"جز نظاره نیست قسم دیگران","از سعودش غافلند و از قران","تنها تماشای آن است که دیگران از پیشرفت او غافلند و از تلاوت قرآن."],[831,"آشنایی گیر شبها تا به روز","با چنین استارهای دیوسوز","در شب‌ها با چنین ستاره‌های روشنی که شیطان‌سوزند، آشنا شو تا روز خود را به روشنایی برسانی."],[831,"هر یکی در دفع دیو بدگمان","هست نفط‌انداز قلعه آسمان","هر کس در دور کردن دیو (شر و بدی) دارد بدگمانی و مشغولیت، مانند نفتی است که برای روشن نگه‌داشتن قلعه آسمانی (یعنی آسمان و فضائل و ویژگی‌های اخلاقی) به کار می‌رود."],[831,"اختر ار با دیو هم‌چون عقربست","مشتری را او ولی الاقربست","اگر اختر (سیاره) هم‌چون عقرب با دیو (دشمن) در تضاد و بدی باشد، مشتری (سیاره‌ای دیگر) که در نزدیکی آن است، ولی (دوست)‌ سرسختی است."],[831,"قوس اگر از تیر دوزد دیو را","دلو پر آبست زرع و میو را","اگر قوس (کمان) به دیوانگی تیر بزند، نتیجه‌اش این است که (کسی) از دیو (شیطان) دلو (سطل) پر آب می‌گیرد و به همین ترتیب به زراعت و میوه‌کاری نیز آسیب می‌زند. در واقع، هر عمل نادرستی، از منبعی خراب به دیگر امور زیان می‌زند."],[831,"حوت اگرچه کشتی غی بشکند","دوست را چون ثور کشتی می‌کند","اگر چه ماهی بزرگ (حوت) اگر کشتی غی را بشکند، دوست (دوستی یا محبت) مانند گاو (ثور) می‌تواند کشتی را نجات دهد. به عبارتی دیگر، محبت و دوستی می‌تواند در برابر خطرات و مشکلات عظیم، مانند طوفان یا آسیب‌های بزرگ، حامی و نجات‌دهنده باشد."],[831,"شمس اگر شب را بدرد چون اسد","لعل را زو خلعت اطلس رسد","اگر شمس (شمس تبریزی، دوست مولانا) شب را بشکند و تاریکی را از بین ببرد، مانند شیر، جواهر سرخ را در خویش جای می‌دهد، در این حالت، درخشش و زیبایی او مانند پوشش گران‌بهای اطلس می‌باشد."],[831,"هر وجودی کز عدم بنمود سر","بر یکی زهرست و بر دیگر شکر","هر موجودی که از عدم به وجود آمده، درون خود هم زهر دارد و هم شکر؛ یعنی خوبی‌ها و بدی‌ها در کنار یکدیگر وجود دارند."],[831,"دوست شو وز خوی ناخوش شو بری","تا ز خمره زهر هم شکر خوری","رابطه دوستی و خوش‌رفتاری با دیگران را به جای خصومت و ناخوش‌احوالی انتخاب کن تا بتوانی از زهر زندگی نیز شیرینی (لذت) را تجربه کنی."],[831,"زان نشد فاروق را زهری گزند","که بد آن تریاق فاروقیش قند","فاروق، که به معنای کسی است که حق و باطل را از هم تشخیص می‌دهد (معمولا به علی بن ابی‌طالب اشاره دارد)، به خاطر قند و شیرینی وجودش از گزند زهر دور است و زهر نمی‌تواند به او آسیبی برساند. در واقع، وجود او چنان خالص و شیرین است که زهر نمی‌تواند به او نفوذ کند."],[832,"ای حیات دل حسام‌الدین بسی","میل می‌جوشد به قسم سادسی","حسام‌الدین، یعنی شخصی که در دل خود زندگی و شور و شوق فراوانی دارد، به شدت می‌خواهد و تمایل دارد که به سمت حقیقت و معنویت پیش برود."],[832,"گشت از جذب چو تو علامه‌ای","در جهان گردان حسامی نامه‌ای","حسام‌الدین به دلیل جذبه‌ای که دارد، مانند علامه‌ای در جهان شناخته شده است و نامه‌ای که او دارد به دیگران معرفی می‌کند."],[832,"پیش‌کش می‌آرمت ای معنوی","قسم سادس در تمام مثنوی","ای معنوی بزرگ، من برای تو هدیه‌ای می‌آورم که قسم ششم در تمام مثنوی است."],[832,"شش جهت را نور ده زین شش صحف","کی یطوف حوله من لم یطف","از شش جهت نور بخش، چرا که این شش صحیفه (کتاب) را نمی‌چرخاند کسی که اطراف آن نچرخد."],[832,"عشق را با پنج و با شش کار نیست","مقصد او جز که جذب یار نیست","عشق هیچ کار و وظیفه‌ای با شمارها و تقسیمات ندارد، هدف اصلی آن فقط جذب و نزدیک شدن به محبوب است."],[832,"بوک فیما بعد دستوری رسد","رازهای گفتنی گفته شود","هر وقت که بعدا دستوری بیاید، رازهایی که باید گفت، بیان خواهد شد."],[832,"یا بیانی که بود نزدیکتر","زین کنایات دقیق مستتر","با توجیهاتی که در کنایات پنهان وجود دارد، بیانی که واضح‌تر و نزدیک‌تر باشد، بهتر است."],[832,"راز جز با رازدان انباز نیست","راز اندر گوش منکر راز نیست","رازها تنها با افرادی که به شناخت رازها رسیده‌اند، در میان گذاشته می‌شود و در گوش کسی که به رازها ایمان ندارد، این سخنان در نمی‌آید."],[832,"لیک دعوت واردست از کردگار","با قبول و ناقبول او را چه کار","اما دعوت الهی از طرف خداوند است و او با پذیرش یا عدم پذیرش این دعوت، هیچ ارتباطی ندارد."],[832,"نوح نهصد سال دعوت می‌نمود","دم به دم انکار قومش می‌فزود","حضرت نوح به مدت نهصد سال مردم را به پرستش خدا دعوت می‌کرد، اما هر روز بر تعداد کسانی که او را انکار میکردند افزوده میشد."],[832,"هیچ از گفتن عنان واپس کشید","هیچ اندر غار خاموشی خزید","هیچ کس از گفتن بازنگشت و در عین حال هیچ‌کس در خفا و بی‌صدا هم دچار خاموشی نشد."],[832,"گفت از بانگ و علالای سگان","هیچ واگردد ز راهی کاروان","از صدا و شلوغی سگ‌ها هیچ کاروانی از مسیرش منحرف نمی‌شود."],[832,"یا شب مهتاب از غوغای سگ","سست گردد بدر را در سیر تگ","در شب‌های روشن و مهتابی، صدای عوعوی سگ‌ها باعث می‌شود که نور ماه کم‌نور و سست به نظر بیاید و در حرکت خود تعلیق ایجاد کند."],[832,"مه فشاند نور و سگ عو عو کند","هر کسی بر خلقت خود می‌تند","نور ماه می‌تابد و سگ پارس می‌کند. هر کس بر اساس ویژگی‌ها و فطرت خود، رفتار و کردار مخصوص به خود را دارد."],[832,"هر کسی را خدمتی داده قضا","در خور آن گوهرش در ابتلا","هر کس در زندگی خود را با چالشی مواجه می‌بیند، که این چالش متناسب با ارزش و استعدادهای اوست."],[832,"چونک نگذارد سگ آن نعره سقم","من مهم سیران خود را چون هلم","اگر سگ نگذارد که من دردم را فریاد کنم، نمی‌توانم خودم را از این حال رهایی بخشم."],[832,"چونک سرکه سرکگی افزون کند","پس شکر را واجب افزونی بود","چون سرکه طعم ترش و ناگواری به غذا می‌دهد، بنابراین لازم است که برای تعادل طعم، مقدار شکر بیشتری هم اضافه شود."],[832,"قهر سرکه لطف هم‌چون انگبین","کین دو باشد رکن هر اسکنجبین","سرکه و انگبین هر دو از اجزای اصلی اسکنجبین (شربت خوشمزه‌ای که معمولا از سرکه و عسل تهیه می‌شود) هستند. در اینجا، قهر سرکه می‌تواند به تلخی یا عدم رضایت اشاره داشته باشد، در حالی که لطف انگبین به شیرینی و خوشایندی مربوط است. این بیت نشان می‌دهد که تلخی و شیرینی هر دو جزء لازم و مکمل یکدیگرند."],[832,"انگبین گر پای کم آرد ز خل","آید آن اسکنجبین اندر خلل","اگر انگبین در پایش کم بیفتد، آن وقت اسکنجبین (مسکّن) هم در ریختن و طعم دادن دچار نقص می‌شود."],[832,"قوم بر وی سرکه‌ها می‌ریختند","نوح را دریا فزون می‌ریخت قند","مردم سرکه‌ها را بر سر نوح می‌ریختند، ولی دریا به خاطر نوح شیرینی (قند) بیشتری می‌ریخت."],[832,"قند او را بد مدد از بحر جود","پس ز سرکه اهل عالم می‌فزود","مساعدت و لطف الهی به نوح (ع) مانند قندی است که از دریای بخشش خداوند به او می‌رسد و به او کمک می‌کند. در حالی که مردم با سرکه و تلخی‌های خود بر او می‌افزایند، رحمت و بخشش الهی بر رنج‌ها و سختی‌های او غلبه می‌کند."],[832,"واحد کالالف کی بود آن ولی","بلک صد قرنست آن عبدالعلی","آن ولی، یعنی ولی و دوستان خدا، مانند یک واحد است، اما در واقع صد قرن از بندگان خدا، مانند عبدالعلی، در عظمت و مقام به او نمی‌رسند."],[832,"خم که از دریا درو راهی شود","پیش او جیحونها زانو زند","هرگاه خم (جای فرود) از دریا به اینجا بیاید و به او (عبدالعلی) راهی پیدا کند، رودهای بزرگ مانند جیحون به نشانه احترام در برابر او زانو می‌زنند."],[832,"خاصه این دریا که دریاها همه","چون شنیدند این مثال و دمدمه","این دریا که اشاره به آن شده، به قدری بزرگ و عظیم است که وقتی دریاهای دیگر این مثال و عظمت او را می‌شنوند، به حالتی از خوف و ترس در می‌آیند."],[832,"شد دهانشان تلخ ازین شرم و خجل","که قرین شد نام اعظم با اقل","از شرم و خجالت، زبانشان به تلخی می‌رسد، زیرا نام بزرگ خداوند (اعظم) با چیزهای کوچک و حقیر (اقل) همراه شده است."],[832,"در قران این جهان با آن جهان","این جهان از شرم می‌گردد جهان","در قرآن، این دنیا در مقایسه با دنیای دیگر (آخرت) به شدت خجالت‌زده است و حس نگرانی و عجز دارد."],[832,"این عبارت تنگ و قاصر رتبتست","ورنه خس را با اخص چه نسبتست","این عبارت که محدوده و ناقص است، به هیچ وجه با جایگاه والای خسرو (خس) نسبت ندارد. در واقع، خسرو به مرتبه‌ای عالی و ویژگی‌هایی شایسته تعلق دارد که این محدودیت‌ها را شامل نمی‌شود."],[832,"زاغ در رز نعره زاغان زند","بلبل از آواز خوش کی کم کند","زاغ به خاطر صدای زاغ‌ها در باغ ناله می‌زند، اما بلبل به خاطر صدای دلنشینش هیچ‌گاه از آوازش کم نمی‌شود."],[832,"پس خریدارست هر یک را جدا","اندرین بازار یفعل ما یشا","در این دنیا، هر کس به‌طور جداگانه انتخاب می‌کند که چه چیزی را بپسندد و چه چیزی را رد کند، مانند یک بازار که هر مشتری مطابق میل خود خرید می‌کند."],[832,"نقل خارستان غذای آتش است","بوی گل قوت دماغ سرخوش است","غذا در خارستان (محل پر از خاردار) برای آتش به معنای درد و رنج است، در حالی که بوی گل به انسان احساس خوشی و سرخوشی می‌دهد. بیانگر این است که بعضی چیزها برای برخی افراد خوشایند و برای دیگران آزاردهنده‌اند."],[832,"گر پلیدی پیش ما رسوا بود","خوک و سگ را شکر و حلوا بود","اگر پلیدی‌ها در برابر ما آشکار باشد، پس برای خوک و سگ هم شیرینی و حلوا فراهم است."],[832,"گر پلیدان این پلیدیها کنند","آبها بر پاک کردن می‌تنند","اگر پلیدان، پلیدی‌هایشان را انجام دهند، برپاکان (مردم پاکدل) تلاش می‌کنند تا آن ناپاکی‌ها را با پاکی و خلوص، از بین ببرند."],[832,"گرچه ماران زهرافشان می‌کنند","ورچه تلخان‌مان پریشان می‌کنند","هرچند ماریان زهر را پخش می‌کنند و تلخه‌ای (ناراحت‌کننده) ما را به هم می‌زنند، به این حال نباید نگران بود."],[832,"نحلها بر کوه و کندو و شجر","می‌نهند از شهد انبار شکر","زنبورها در کوه‌ها، کندوها و درختان جا می‌گیرند و از شهد آنان عسل را جمع‌آوری می‌کنند."],[832,"زهرها هرچند زهری می‌کنند","زود تریاقاتشان بر می‌کنند","زهرهایی که به وجود می‌آیند هر چند خطرناک هستند، اما به سرعت داروها و ضد زهرهایی نیز برای آن‌ها ساخته می‌شود."],[832,"این جهان جنگست کل چون بنگری","ذره با ذره چو دین با کافری","این جهان همچون جنگی است که وقتی به آن نگاه کنی، هر ذره‌ای مثل دین در برابر کافر قرار دارد. به عبارت دیگر، هر موجودی در این دنیا با موجود دیگر در حال نبرد و رقابت است."],[832,"آن یکی ذره همی پرد به چپ","وآن دگر سوی یمین اندر طلب","یک ذره (موجود کوچکی) به سمت چپ می‌پرد و دیگری به سمت راست می‌رود تا چیزی را طلب کند."],[832,"ذره‌ای بالا و آن دیگر نگون","جنگ فعلیشان ببین اندر رکون","دو ذره‌ای که در حال حرکت هستند، یکی به سمت چپ و دیگری به سمت راست، در حال حاضر درگیر جنگی هستند که در باطن و در دل وجودشان رخ می‌دهد."],[832,"جنگ فعلی هست از جنگ نهان","زین تخالف آن تخالف را بدان","جنگ فعلی، که اشاره به درگیری‌های ظاهری دارد، نتیجه جنگ‌های پنهانی و نهان است؛ این اختلافات و تضادها را باید شناخت و درک کرد."],[832,"ذره‌ای کان محو شد در آفتاب","جنگ او بیرون شد از وصف و حساب","ذره‌ای که در آفتاب محو شده است، دیگر از وصف و محاسبه بیرون رفته و از جنگ و جدال آزاد شده است. این بیت به بیان این مطلب می‌پردازد که هر چیزی که به اوج حقیقت و اتحاد با آفتاب (خدا یا نور الهی) برسد، از دنیای جدل و حساب جدا می‌شود."],[832,"چون ز ذره محو شد نفس و نفس","جنگش اکنون جنگ خورشیدست بس","زمانی که ذره در آفتاب محو می‌شود، نفس (وجود) او از میان می‌رود و اکنون تنها جنگ او با خورشید باقی مانده است."],[832,"رفت از وی جنبش طبع و سکون","از چه از انا الیه راجعون","جنبش طبع او (خواست و تمایلاتش) از بین رفته و سکون و آرامش او (حال او) به این دلیل است که به سوی خدا بازگشته و به اصل و ریشه‌اش که خداوند است، نزدیک شده است."],[832,"ما به بحر تو ز خود راجع شدیم","وز رضاع اصل مسترضع شدیم","ما از خودمان دور شده و به دریا (عشق و خدا) تو برگشتیم و به‌واسطه شیر روحانی‌ای که از تو می‌نوشیم، به اصل واقعی خود که همان تو هستی، بازگشتیم."],[832,"در فروع راه ای مانده ز غول","لاف کم زن از اصول ای بی‌اصول","در مسائل فرعی و جزئی، مانند کسانی که در دام وحشت و ترس گرفتار شده‌اند، صحبت نکن و از اصول اساسی و بنیانی دور نمان؛ تو بدون این اصول، هیچ بنیانی نداری."],[832,"جنگ ما و صلح ما در نور عین","نیست از ما هست بین اصبعین","جنگ و صلح ما نه در نور و در دیدار عینی است، بلکه هر دو از درون ما و به طور میان ما و خودمان است. کلمه «اصبعین» به دو انگشت اشاره دارد که می‌تواند نشان‌دهنده نزدیکی و ارتباط نزدیک مسائل درون ما باشد."],[832,"جنگ طبعی جنگ فعلی جنگ قول","در میان جزوها حربیست هول","جنگ طبیعی، جنگ عملی و جنگ گفتاری در میان اجزا، همگی نبردی هولناک و ترسناک هستند."],[832,"این جهان زین جنگ قایم می‌بود","در عناصر در نگر تا حل شود","این جهان به خاطر این جنگ (اختلافات و کشمکش‌ها) برپا و پایدار است. به عناصر (آب، آتش، خاک و هوا)‌ نگاه کن که تا زمانی که این جنگ وجود دارد، به همین شکل باقی می‌مانند."],[832,"چار عنصر چار استون قویست","که بدیشان سقف دنیا مستویست","چهار عنصر (آب، باد، خاک و آتش) مانند چهار ستون محکم هستند که سقف جهان بر آن‌ها قرار دارد."],[832,"هر ستونی اشکننده آن دگر","استن آب اشکننده آن شرر","هر یک از این ستون‌ها باعث آسیب و شکست دیگری می‌شود، مانند آبی که باعث خاموشی آتش می‌شود."],[832,"پس بنای خلق بر اضداد بود","لاجرم ما جنگییم از ضر و سود","آفرینش انسان بر اساس تضادها و ضدین است؛ بنابراین، ما همیشه در تضاد و جنگی بین ضرر و سود قرار داریم."],[832,"هست احوالم خلاف همدگر","هر یکی با هم مخالف در اثر","احوال هر یک از ما با دیگری متفاوت و متضاد است و هر فردی به دلایل مختلف، بر خلاف دیگری عمل می‌کند."],[832,"چونک هر دم راه خود را می‌زنم","با دگر کس سازگاری چون کنم","هر لحظه من به سمت خودم می‌روم و با دیگران تفاهم و سازگاری ندارم."],[832,"موج لشکرهای احوالم ببین","هر یکی با دیگری در جنگ و کین","وضعیت روحی من را همچون موجی از لشکرها تصور کن که هر کدام در حال جنگ و دشمنی با دیگری هستند."],[832,"می‌نگر در خود چنین جنگ گران","پس چه مشغولی به جنگ دیگران","به خودت بنگر که در درونت چگونه جنگ و نگرانی وجود دارد، پس چرا به جنگ و دعوای دیگران اهمیت می‌دهی؟"],[832,"یا مگر زین جنگ حقت وا خرد","در جهان صلح یک رنگت برد","شاید از این جنگ درون تو و حق و خرد، فردوس صلح و آرامش در جهان را به دست بیاوری و به رنگی واحد برسی."],[832,"آن جهان جز باقی و آباد نیست","زانک آن ترکیب از اضداد نیست","این جهان فقط جاودان و پایدار است، زیرا آن ترکیب و اختلاط از ضدها و تضادها وجود ندارد."],[832,"این تفانی از ضد آید ضد را","چون نباشد ضد نبود جز بقا","اگر ضدی وجود نداشته باشد، نمی‌توان از آن صحبت کرد و در نتیجه تنها چیزی که باقی می‌ماند وجود خواهد داشت. در واقع، وجود ضدها برای درک بقا ضروری است."],[832,"نفی ضد کرد از بهشت آن بی‌نظیر","که نباشد شمس و ضدش زمهریر","در بهشت بی‌نظیر، نقیض‌ها وجود ندارند؛ به این معنا که نه خورشید هست و نه چیزی که بخواهد آن را به سرما و تاریکی تبدیل کند."],[832,"هست بی‌رنگی اصول رنگها","صلحها باشد اصول جنگها","بی‌رنگی، یعنی وجود نداشتن رنگ، منبع و اساس تمام رنگ‌ها و تفاوت‌هاست؛ بنابراین، همان‌طور که صلح از تفاهم و اتحاد نشأت می‌گیرد، جنگ از تضاد و اختلاف ناشی می‌شود."],[832,"آن جهانست اصل این پرغم وثاق","وصل باشد اصل هر هجر و فراق","جهان اکنون منبع و ریشه تمام غم‌ها و کدورت‌هاست و پیوند و ارتباط میان انسان‌ها نیز در آن قرار دارد؛ به همین دلیل، جاهایی که جدایی و غم وجود دارد، از همین اصل ناشی می‌شود."],[832,"این مخالف از چه‌ایم ای خواجه ما","واز چه زاید وحدت این اعداد را","این مخالف، که با ما در تضاد است، از چه چیزی نشأت گرفته است ای آقا، و این وحدت میان اعداد چگونه به وجود آمده است؟"],[832,"زانک ما فرعیم و چار اضداد اصل","خوی خود در فرع کرد ایجاد اصل","ما چون فرع درخت هستیم و اصل یا ریشه‌ی ما با چهار ضد (سرد، گرم، تر، خشک) ایجاد شده است؛ بنابراین، خوی اصلی ما در این فرع‌ها تجلی پیدا کرده است."],[832,"گوهر جان چون ورای فصلهاست","خوی او این نیست خوی کبریاست","جان انسان از حد و مرز فصل‌ها فراتر است و ویژگی‌های آن به غرور و عظمت مربوط نمی‌شود."],[832,"جنگها بین کان اصول صلحهاست","چون نبی که جنگ او بهر خداست","جنگ‌ها در ذات خود، اساس صلح‌ها هستند، مانند نبی که جنگ او برای خداوند است."],[832,"غالبست و چیر در هر دو جهان","شرح این غالب نگنجد در دهان","غالب و پیروز در هر دو جهان خداوند است و عظمت این پیروزی به قدری زیاد است که هیچ زبانی نمی‌تواند آن را به طور کامل توصیف کند."],[832,"آب جیحون را اگر نتوان کشید","هم ز قدر تشنگی نتوان برید","اگر نتوان دریاچه جیحون را از آب آن برداشت، نمی‌توان مقدار تشنگی را هم کاهش داد."],[832,"گر شدی عطشان بحر معنوی","فرجه‌ای کن در جزیره مثنوی","اگر دلت تشنه معانی عمیق و معنوی است، زمانی را در جزیره مثنوی بگذران تا به آرامش و دل‌خوشی دست یابی."],[832,"فرجه کن چندانک اندر هر نفس","مثنوی را معنوی بینی و بس","فرجه، یعنی تنفس و آرامش، کن تا در هر نفسی بتوانی معناهای عمیق مثنوی را ببینی و تنها به ظواهر آن نپردازی."],[832,"باد که را ز آب جو چون وا کند","آب یک‌رنگی خود پیدا کند","باد وقتی که بر روی آب جو وزیده و آن را به حرکت درمی‌آورد، باعث می‌شود رنگ یکدست و سکون آب نمایان شود و زیبایی آن پدیدار گردد."],[832,"شاخهای تازه مرجان ببین","میوه‌های رسته ز آب جان ببین","شاخ‌های نو و تازه مرجان را ببین که میوه‌های زیبایی از آب جان (آب حیات) رشد کرده‌اند."],[832,"چون ز حرف و صوت و دم یکتا شود","آن همه بگذارد و دریا شود","وقتی که انسان از حرف، صدا و نفس خود عبور کند و به وحدت و حقیقتی بالاتر برسد، همه آن چیزها را رها کرده و به بی‌نهایت و معانی عمیق‌تر می‌رسد."],[832,"حرف‌گو و حرف‌نوش و حرفها","هر سه جان گردند اندر انتها","پس از آنکه در نهایت، سخن و گفتار و نوشته، همه به یک حقیقت می‌پیوندند، در اعماق وجود، این کلمات و مفاهیم به روح و جان تبدیل می‌شوند."],[832,"نان‌دهنده و نان‌ستان و نان‌پاک","ساده گردند از صور گردند خاک","نان‌دهنده (کسی که نان می‌دهد)، نان‌ستان (کسی که نان می‌گیرد) و نان‌پاک (کسی که نان را پاک و درست می‌کند) همه از ظواهر و صورت‌ها ساده و بی‌هیاهو می‌شوند و در نهایت به حقیقتی فراتر از صورت‌هایشان، یعنی خاک می‌رسند."],[832,"لیک معنیشان بود در سه مقام","در مراتب هم ممیز هم مدام","معنای آنها در سه مرحله و مقام وجود دارد؛ در این مراحل، همواره ویژگی‌های خاص خود را حفظ می‌کنند و موجودیت آنها پیوسته است."],[832,"خاک شد صورت ولی معنی نشد","هر که گوید شد تو گویش نی نشد","ظاهر انسان، یعنی صورت و جسم، به خاک تبدیل شد، اما معنای او همچنان باقی است. هر کس ادعا کند که او نیز همچون جسمش زائل شده، در واقع درک درستی از حقیقت او ندارد و او را به خوبی نشناخته است."],[832,"در جهان روح هر سه منتظر","گه ز صورت هارب و گه مستقر","در این بیت، مولانا به این نکته اشاره می‌کند که در جهان، روح‌های سه‌گانه (که ممکن است اشاره به حالات مختلف روح یا وجود انسان‌ها باشد) دائما در حال انتظار هستند. گاهی آن‌ها در شکل ظاهری و مادی (هارب) ظاهر می‌شوند و گاهی در حالت ثابت و بی‌تحرک (مستقر) قرار می‌گیرند."],[832,"امر آید در صور رو در رود","باز هم ز امرش مجرد می‌شود","امر (حکم و فرمان الهی) به صورت‌ها می‌آید و در آنها تجلی می‌کند، اما باز هم از آن حکم و فرمان خود جدا و مجرد می‌شود."],[832,"پس له الخلق و له الامرش بدان","خلق صورت امر جان راکب بر آن","خداوند امور و مخلوقات را به خود اختصاص داده و در واقع، وجود مخلوقات و اسباب زندگی به اراده او بستگی دارد، مانند راکبی که جانش به مرکوبش مربوط است."],[832,"راکب و مرکوب در فرمان شاه","جسم بر درگاه وجان در بارگاه","در این بیت، جسم انسان به عنوان سوار (راکب) و روح به عنوان مرکوب (چیزی که سوار بر آن می‌شود) توصیف شده است. بنابراین، جسم در خدمت روح و روح در نزد خداوند (شاه) قرار دارد، که نشان‌دهنده تسلط روح بر جسم و اهمیت روح در درگاه خداوند است."],[832,"چونک خواهد که آب آید در سبو","شاه گوید جیش جان را که ارکبوا","وقتی جان بخواهد که در جسم (سبو) وارد شود، شاه (خدا) به فرشتگان می‌گوید که آن را سوار کنید و در مسیر بفرستید."],[832,"باز جانها را چو خواند در علو","بانگ آید از نقیبان که انزلوا","وقتی که جان‌ها را در علو (پستی) می‌خوانند، صدایی از نگهبانان می‌رسد که بگویند: \"فرود آیید."],[832,"بعد ازین باریک خواهد شد سخن","کم کن آتش هیزمش افزون مکن","پس از این، سخن‌ها حساب‌شده‌تر و مختصرتر خواهد شد، بنابراین آتش هیزم را بیشتر نسوزان، زیرا ممکن است مشکل‌تر شود."],[832,"تا نجوشد دیگهای خرد زود","دیگ ادراکات خردست و فرود","تا زمانی که فکرها و اندیشه‌های کوچکی در ذهن نپخته و ناپخته بمانند، توانایی درک و دریافت حقیقت به تأخیر می‌افتد و در واقع درک عمیق و روشن نخواهد شد."],[832,"پاک سبحانی که سیبستان کند","در غمام حرفشان پنهان کنند","خداوند پاکی که سیبستان (بهشت) را می‌آفریند، در این ابرها (غلاف‌ها و تیره‌گی‌ها) سخنان آنان را پنهان می‌کند."],[832,"زین غمام بانگ و حرف و گفت و گوی","پرده‌ای کز سیب ناید غیر بوی","این غمامی که از آن سخن می‌گویند، تنها صدای ندا و گفتار است و از این پرده هیچ چیزی جز عطر سیب نمی‌آید."],[832,"باری افزون کش تو این بو را به هوش","تا سوی اصلت برد بگرفته گوش","تو باید مراقب این بوی خوش باشی و آن را به خوبی دریابی تا تو را به اصل و ریشه‌ات متصل کند و به حقیقت وجودت برساند."],[832,"بو نگه‌دار و بپرهیز از زکام","تن بپوش از باد و بود سرد عام","باید بو را حفظ کنی و از سرماخوردگی دوری کنی؛ لباس گرم بپوش و از باد و هوای سردی که همه‌جا هست، خودت را محافظت کن."],[832,"تا نینداید مشامت را ز اثر","ای هواشان از زمستان سردتر","تا وقتی که بوی هوا به مشامت نرسد، از اثر آن خبر نمی‌گیری. این هوا از زمستان هم سردتر است."],[832,"چون جمادند و فسرده و تن‌شگرف","می‌جهد انفاسشان از تل برف","چون موجودات بی‌جان و سردند و بدنشان کم‌جان است، نفس‌هایشان از زیر برف به سرعت خارج می‌شود."],[832,"چون زمین زین برف در پوشد کفن","تیغ خورشید حسام‌الدین بزن","وقتی زمین، این برف را بپوشاند، با تیغ خورشید که به مانند شمشیر حسام‌الدین (نگهبان دین و حقیقت است) است، بیفروزند."],[832,"هین بر آر از شرق سیف‌الله را","گرم کن زان شرق این درگاه را","به سرعت از سمت شرق، شمشیر خداوند (سیف‌الله) را بلند کن و آن را گرم کن تا از این درگاه (درگاه پروردگار) بهره‌مند شوی."],[832,"برف را خنجر زند آن آفتاب","سیلها ریزد ز که ها بر تراب","آفتاب مانند خنجری بر برف می‌تابد و آن را ذوب می‌کند، بنابراین سیلاب‌هایی از کوه‌ها به سمت زمین (تراب) سرازیر می‌شود."],[832,"زانک لا شرقیست و لا غربیست او","با منجم روز و شب حربیست او","اینکه او نه شرقی است و نه غربی، به این معناست که از مرزهای جغرافیایی فراتر رفته و فراتر از زمان و مکان، با منجم (محسوسات و پیامبران) در حال جنگ و نزاع است. این جنگ شاید نماد تضاد فهم و تفکر باشد."],[832,"که چرا جز من نجوم بی‌هدی","قبله کردی از لئیمی و عمی","چرا به جز من، از روی نادانی و کج‌فهمی، نجوم را بدون راهنمایی (که در واقع هدایت‌کننده باشد) به عنوان قبله و راهنمای خود انتخاب کردی؟"],[832,"نا خوشت ناید مقال آن امین","در نبی که لا احب الآفلین","حرفی که آن امین (خدای رسول یا پیامبر) می‌زند، برای تو خوشآیند نیست؛ زیرا او کسانی را که رو به زوال‌اند دوست ندارد."],[832,"از قزح در پیش مه بستی کمر","زان همی رنجی ز وانشق القمر","تو به خاطر اینکه به شمع نورانی (شمس) پشت کرده‌ای، از قدرت و روشنایی او دور مانده‌ای و از این جدایی رنج می‌کشی. این جدایی مثل این است که در تاریکی قمر (ماه) مانده‌ای و از روشنایی آن بی بهره‌ای."],[832,"منکری این را که شمس کورت","شمس پیش تست اعلی‌مرتبت","کسی که وجود شمس‌الدین را انکار کند، نمی‌تواند منکر شود که او از دیگران بالاتر و مقامش برتر است."],[832,"از ستاره دیده تصریف هوا","ناخوشت آید اذا النجم هوی","هرگاه ستاره‌ها به شکل‌های مختلف در آسمان دیده شوند، اگر این تغییر شکل برای تو ناخوشایند باشد، بدان که این پدیده به دلیل تأثیر هوا (جو) است."],[832,"خود مؤثرتر نباشد مه ز نان","ای بسا نان که ببرد عرق جان","ماه (که به زیبایی و تأثیرش معروف است) نمی‌تواند از نان (که غذایی ضروری برای زندگی است) مؤثرتر باشد، زیرا بسیاری از نان‌ها (یعنی سختی‌ها و مشکلات) می‌توانند جان انسان را به خطر اندازند و او را خسته کنند."],[832,"خود مؤثرتر نباشد زهره زآب","ای بسا آبا که کرد او تن خراب","زهره (یعنی ماه، در اینجا به معنای بخشی از نور و درخشندگی)، خود به تنهایی بیشتر از آب مؤثر نیست و بسیاری از اجداد و نیاکان بوده‌اند که با آب زندگی‌شان خراب شده است."],[832,"مهر آن در جان تست و پند دوست","می‌زند بر گوش تو بیرون پوست","محبت و دوستی در وجود تو نهفته است و نصیحت‌های دوست تو را تحت تأثیر قرار می‌دهد، اما این تأثیر فقط از درون تو ناشی می‌شود و نه از بیرون."],[832,"پند ما در تو نگیرد ای فلان","پند تو در ما نگیرد هم بدان","پند و نصیحت ما (دوستان) بر تو تأثیری ندارد و نصیحت تو نیز بر ما تأثیر نخواهد داشت، زیرا هر کس در درک این پندها و نصایح خود، محدودیت‌هایی دارد."],[832,"جز مگر مفتاح خاص آید ز دوست","که مقالید السموات آن اوست","فقط عشق و دوستی است که می‌تواند به ما فهم عمیق و معنوی بدهد، چرا که کلید ورود به عالم معنوی و آسمانی به دست اوست و او در حقیقت صاحب تمامی آسمان‌ها و معانی است."],[832,"این سخن هم‌چون ستاره‌ست و قمر","لیک بی‌فرمان حق ندهد اثر","این سخن به مانند ستاره و ماه است، اما بدون اجازه و فرمان خدا تأثیری نخواهد داشت."],[832,"این ستاره بی‌جهت تاثیر او","می‌زند بر گوشهای وحی‌جو","این ستاره که بلاجهت است، بدون توجه به حکمت خداوند، بر شنونده‌های وحی‌جو اثرگذار می‌شود."],[832,"کی بیایید از جهت تا بی‌جهات","تا ندراند شما را گرگ مات","اگر از جانب خداوند نیایید و به دلایلی ناآگاه و بی‌هدف حرکت کنید، نخواهید توانست از خطرات و مشکلاتی که مانند گرگ به شما حمله می‌کند، در امان بمانید."],[832,"آنچنان که لمعه درپاش اوست","شمس دنیا در صفت خفاش اوست","شمس‌الدین محمدTabligh اینجا به‌مانند نوری درخشان توصیف شده است که بر اثر تاریکی و انجماد، حالتی شبیه به خفاش پیدا کرده است. مانند خفاش که در تاریکی به پرواز در می‌آید، شمس در دنیای اطرافش با چهره‌ای غیرعادی و متفاوت حضور دارد."],[832,"هفت چرخ ازرقی در رق اوست","پیک ماه اندر تب و در دق اوست","جهان هفت آسمان (چرخ) در اختیار اوست و پیکر ماه (ماه) در حال تپش و جنبش به خاطر اوست."],[832,"زهره چنگ مسئله در وی زده","مشتری با نقد جان پیش آمده","زهره (مشتری) در عشق و زیبایی به شدت تحت تاثیر قرار گرفته و چنگ (ساز موسیقی) را نواخته است، به طوری که مشتری (سیاره) با جان و دل خود به این عشق پاسخ داده است."],[832,"در هوای دستبوس او زحل","لیک خود را می‌نبیند از محل","در حالتی که به زحل (سیاره) به عنوان کسی برای احترام و دستبوسی نزدیک می‌شود، اما خودش را نمی‌بیند و از حقیقت خود دور است."],[832,"دست و پا مریخ چندین خست ازو","وآن عطارد صد قلم بشکست ازو","مریخ به خاطر خست و ناتوانی، دست و پاهایش آسیب دیده و عطارد نیز نتوانسته از فشار و بار سنگین خود خلاص شود و به شدت صدمه دیده است."],[832,"با منجم این همه انجم به جنگ","کای رها کرده تو جان بگزیده رنگ","اگر تو با ستاره‌شناس (منجم) این همه ستاره‌ها درگیر شده‌ای، به دلیل اینکه تو روح و جان خود را رها کرده‌ای و به رنگ و شکل دنیا (رنگ و رقوم) وابسته شده‌ای."],[832,"جان ویست و ما همه رنگ و رقوم","کوکب هر فکر او جان نجوم","جان او باقی است و ما تنها رنگ و نوشته‌های ستارگان هستیم. هر فکری که او دارد، جان ستارگان است."],[832,"فکر کو آنجا همه نورست پاک","بهر تست این لفظ فکر ای فکرناک","فکر انسان، جایی است که تمامی نور و روشنایی در آن وجود دارد و این واژه \"فکر\" به عنوان یک کلمه شگفت‌انگیز است."],[832,"هر ستاره خانه دارد در علا","هیچ خانه در نگنجد نجم ما","هر ستاره‌ای در آسمان برای خود مکان و خانه‌ای دارد، اما نجم ما (به احتمال زیاد اشاره به حقیقت یا معنای عمیق وجود انسانی است) در هیچ مکان و محدوده‌ای جای نمی‌گیرد."],[832,"جای سوز اندر مکان کی در رود","نور نامحدود را حد کی بود","نور نامحدود و عظیم، نمی‌تواند در یک مکان محدود جای گیرد؛ هیچ مکانی برای آن محدودیتی وجود ندارد."],[832,"لیک تمثیلی و تصویری کنند","تا که در یابد ضعیفی عشقمند","ولی او تمثیل و تصویر می‌سازد تا عشق ضعیفش را بهتر درک کند."],[832,"مثل نبود لیک باشد آن مثیل","تا کند عقل مجمد را گسیل","اگرچه مانند چیزی نیست، اما می‌تواند نمونه‌ای باشد تا عقل را که به سرعت عمل نمی‌کند، به حرکت درآورد."],[832,"عقل سر تیزست لیکن پای سست","زانک دل ویران شدست و تن درست","عقل انسان تیز و هوشیار است، اما به خاطر دل ناپاک و ویران، پاهایش سست و ناتوان شده‌اند، به همین دلیل نمی‌تواند به درستی عمل کند."],[832,"عقلشان در نقل دنیا پیچ پیچ","فکرشان در ترک شهوت هیچ هیچ","عقل آنها در توجه به مسائل دنیا به طور پیچیده‌ای می‌چرخد، اما در افکارشان درباره‌ی ترک شهوت، هیچ نقطه‌ای از تردید و ابهام وجود ندارد."],[832,"صدرشان در وقت دعوی هم‌چو شرق","صبرشان در وقت تقوی هم‌چو برق","شخصیت‌های این بیت در زمان دعوا و مجادله، مانند شرق، پافشاری و سرسختی نشان می‌دهند و در زمان تقوا و پرهیز، همانند برق، با سرعت عمل می‌کنند."],[832,"عالمی اندر هنرها خودنما","هم‌چو عالم بی‌وفا وقت وفا","عالمی که در هنرها خود را به نمایش می‌گذارد، همانند عالمی است که در زمان وفا و صداقت، به وفای خود پایبند نیست و بی‌وفا است."],[832,"وقت خودبینی نگنجد در جهان","در گلو و معده گم گشته چو نان","زمانی که انسان به خودبینی و خودپسندی مشغول است، نمی‌تواند در این دنیا جایی داشته باشد؛ مانند نانی که در گلویش گیر کرده و در معده‌اش جایی ندارد."],[832,"این همه اوصافشان نیکو شود","بد نماند چونک نیکوجو شود","اگر انسان به دنبال خوبی‌ها باشد و صفات نیک را جست‌وجو کند، در نهایت صفات و ویژگی‌های او نیز نیکو خواهد شد و بدی‌ها از او دور می‌شود."],[832,"گر منی گنده بود هم‌چون منی","چون به جان پیوست یابد روشنی","اگر کسی در دنیا موجودی کوچک و بی‌اهمیت مثل \"منی\" باشد، زمانی که به روح و جان خود پیوندد، روشنایی و درخشندگی می‌یابد."],[832,"هر جمادی که کند رو در نبات","از درخت بخت او روید حیات","هر چیزی که از دنیای بی‌جان (جماد) به دنیای گیاهی (نبات) تبدیل شود، از درخت سرنوشتش حیات و زندگی می‌گیرد."],[832,"هر نباتی کان به جان رو آورد","خضروار از چشمه حیوان خورد","هر گیاهی که به حیات و جان رو کند، سبز و شاداب از آب حیات می‌نوشد."],[832,"باز جان چون رو سوی جانان نهد","رخت را در عمر بی‌پایان نهد","وقتی جان انسان به سوی معشوق می‌رود، آن زندگی را در مسیر بی‌پایانی که در پیش دارد، قرار می‌دهد."],[833,"واعظی را گفت روزی سایلی","کای تو منبر را سنی‌تر قایلی","سوالی از واعظی کرد کسی که ای واعظ، تو مدت زمان بیشتری بر منبر هستی و به همین خاطر برای ما معتبرتر و محترم‌تر هستی."],[833,"یک سؤالستم بگو ای ذو لباب","اندرین مجلس سؤالم را جواب","من یک سؤال دارم، پس ای صاحب اندیشه و عقل، در این مجلس به من پاسخ بده."],[833,"بر سر بارو یکی مرغی نشست","از سر و از دم کدامینش بهست‌؟","مرغی بر بالای دیوار نشسته است. سوال این است که کدام قسمت او بهتر است، سرش یا دمش؟"],[833,"گفت اگر رویش به شهر و دم به ده","روی او از دم او می‌دان که به","اگر مرغ رویش به شهر باشد و دمش به ده، از دم او می‌توان فهمید که او به کجا تعلق دارد."],[833,"ور سوی شهرست دم‌، رویش به ده","خاک آن دم باش و از رویش بجه","اگر دم مرغ به سمت شهر باشد و روی آن به سمت ده، آنگاه خاک آن دم از روی او باارزش‌تر است."],[833,"مرغ با پر می‌پرد تا آشیان","پر مردم همّت است ای مردمان","مرغ با بال‌هایش به سمت آشیانه پرندگان پرواز می‌کند، زیرا پرواز او نشان‌دهنده تلاش و همت انسان‌هاست. ای مردم، این را در نظر داشته باشید."],[833,"عاشقی که آلوده شد در خیر و شر","خیر و شر منگر تو در همّت نگر","عاشقی که در کارهای خوب و بد غرق شده، به خیر و شر توجه نکن، بلکه به کوشش و اراده‌اش نگاه کن."],[833,"باز اگر باشد سپید و بی‌نظیر","چونک صیدش موش باشد شد حقیر","اگر باز شکاری سفید و بی‌نظیر باشد، اما چون شکارش موش است، پس بزرگ و ارزشمند نخواهد بود."],[833,"ور بود جغدی و میل او به شاه","او سر بازست منگر در کلاه","اگر جغدی (پرنده‌ای که معمولا به نشانه بی‌هویتی و مذمت است) هم باشد و میلش به شاه (مقام و بزرگی) باشد، باز هم سرش (شرف و ارزشش) به خاطر آن‌که به شاه علاقه دارد، ارزشمندتر است و نباید به ظواهری مانند کلاه او (نماد ظاهر) نگاه کرد."],[833,"آدمی بر قد یک طشت خمیر","بر فزود از آسمان و از اثیر","آدمی به اندازه یک سطل بزرگ خمیر به وجود آمده است که از آسمان و از عناصر لطیف ساخته شده است."],[833,"هیچ «کرمنا» شنید این آسمان‌؟","که شنید این آدمی پر غمان","آیا هیچ‌کس از آسمان، صدای «کرمنا» (ترحم و کرامت ما) را شنیده است؟ و آیا می‌داند که این انسان، که پر از غم و اندوه است، چه احساساتی را تجربه می‌کند؟"],[833,"بر زمین و چرخ عرضه کرد کس‌؟","خوبی و عقل و عبارات و هوس‌؟","آیا کسی بر روی زمین و در آسمان به زیبایی، عقل، کلمات، و تمایلات انسانی توجه کرده است؟"],[833,"جلوه کردی هیچ تو بر آسمان‌؟","خوبی روی و اصابت در گمان‌؟","آیا توانسته‌ای خود را به گونه‌ای در آسمان نشان دهی؟ آیا زیبایی‌ ات و درک و هوش تو در تصور دیگران جلوه‌گری کرده است؟"],[833,"پیش صورت‌های حمام ای ولد","عرضه کردی هیچ سیم‌اندام خود‌؟","ای پسر، آیا هیچ‌گاه به دیدن زیبایی‌های خود در آینه‌ به گونه‌ای که در حمام نمایان می‌شود، پرداخته‌ای؟"],[833,"بگذری زان نقش‌های هم‌چو حور","جلوه آری با عجوز نیم‌کور","اگر از نقش‌های زیبا و مانند حوریان بگذری، در نهایت جلوه‌ات مانند یک زن سالخورده و نیمه‌کور می‌شود."],[833,"در عجوزه چیست که ایشان را نبود‌؟","که ترا زان نقش‌ها با خود ربود‌؟","عجوزه، زن سالخورده و ناتوان، چه چیز ویژه‌ای دارد که به او توجه نمی‌شود؟ چرا تو را از آن نقش‌ها و زیبایی‌ها چنان به خود مشغول کرده است؟"],[833,"تو نگویی من بگویم در بیان","عقل و حس و درک و تدبیرست و جان","عقل و حس و درک و تدبیر مربوط به جان انسان است و تو باید آن را درک کنی وگرنه من برایت بیان نمی‌کنم."],[833,"در عجوزه جان آمیزش‌کنیست","صورت گرمابه‌ها را روح نیست","در زندگی انسان، اگر روح و جان نباشد، حتی زیبایی ظاهری و صورت‌های خوشگل هم فاقد ارزش و حقیقت هستند. درست مانند گرمابه که اگر روح ندارد، فقط یک مکان بی‌معناست."],[833,"صورت گرمابه گر جنبش کند","در زمان او از عجوزه بر کند","اگر صورت (ظاهر) گرمابه در زمان خودش حرکت کند، به مانند عجوزه (زنی پیر و ناتوان) از جا کنده می‌شود. این به مفهوم این است که تغییرات ظاهری در دنیا، وقتی انگیزه یا حرکت ندارند، بی‌ارزش و ناپایدار هستند."],[833,"جان چه باشد با خبر از خیر و شر","شاد با احسان و گریان از ضرر","جان، چه چیزی است که از خوبی و بدی آگاه است؟ این جان شاد است وقتی که از خوبی‌ها بهره‌مند می‌شود و در برابر مشکلات و ضررها غمگین می‌شود."],[833,"چون سر و ماهیت جان مخبرست","هر که او آگاه‌تر با جان‌ترست","چون سر و ذات جان (روح) به علم و آگاهی آشناست، هر کس که از او آگاه‌تر باشد و به جان نزدیک‌تر، به همان اندازه مهم‌تر و ارزشمندتر است."],[833,"روح را تاثیر آگاهی بود","هر که را این بیش‌، اللهی بود","آگاهی در روح اثر دارد و هر کسی که از این آگاهی بیشتر برخوردار باشد، به خداوند نزدیک‌تر و از نظر روحانی والاتر است."],[833,"چون خبرها هست بیرون زین نهاد","باشد این جان‌ها در آن میدان جماد","خبرها و دانسته‌ها در عالم خارج از این جسم و وجود محدود ماست، بنابراین این جان‌ها در دنیای بی‌جان و مادی قرار دارند و می‌توانند در آن میدان وسیع و غیرمادی (جماد) حضور یابند."],[833,"جان اول مظهر درگاه شد","جان جان خود مظهر الله شد","جان اول، نماینده و مظهری از درگاه خداوند شد و جان اصلی، مظهر ذات و وجود خداوند گردید."],[833,"آن ملایک جمله عقل و جان بدند","جان نو آمد که جسم آن بدند","در این بیت گفته می‌شود که ملایکه (فرشتگان) که نماد عقل و روح هستند، همه وجود خود را به انسان (جانی که تازه به وجود آمده) داده‌اند، چرا که جسم او همان جان و روح است."],[833,"از سعادت چون بر آن جان بر زدند","هم‌چو تن آن روح را خادم شدند","وقتی سعادت به آن جان رسید، مانند تن، روح را خدمت‌گزار خود کرد."],[833,"آن بلیس از جان از آن سر برده بود","یک نشد با جان که عضو مرده بود","بلیس (ابلیس) که از روح پاک و زندگی سر برآورده، هیچ‌گاه به روح آدمی تبدیل نشد، زیرا او در اصل، جزئی از وجود مرده و بی‌روح است."],[833,"چون نبودش آن فدای آن نشد","دست بشکسته مطیع جان نشد","چون چیزی برای فدای او نیست، دست شکسته نمی‌تواند مطیع جان باشد و به معنی واقعی با جان یکی نشود."],[833,"جان نشد ناقص گر آن عضوش شکست","کان بدست اوست تواند کرد هست","اگر یک عضو یا بخشی از وجود انسان سالم نباشد و شکسته شود، به این معنا نیست که جان او ناتوان یا ناقص است؛ زیرا جان به این بدن وابسته نیست و می‌تواند موجودیتی مستقل داشته باشد."],[833,"سر دیگر هست کو گوش دگر","طوطیی کو مستعد آن شکر","مقصود این است که اگرچه سر طوطی برتر و محترم‌تر است، اما برای درک آن شیرینی (شکر) نیاز به گوش و توانایی شنیداری دارد. به عبارت دیگر، درک حقیقت و زیبایی‌ها به استعداد و توانایی فرد بستگی دارد."],[833,"طوطیان خاص را قندیست ژرف","طوطیان عام از آن خور بسته طرف","طوطی‌های خاص، (که به نوعی تعلیم‌دیده و بافضیلت هستند) از شهد گرانبها و اصیل بهره‌مندند، در حالی که طوطی‌های عام (که بی‌توجه به تربیت و معرفت هستند) از آن ماده شیرین به سختی برخوردار می‌شوند."],[833,"کی چشد درویش صورت زان زکات","معنیست آن نه فعولن فاعلات","کسی که درویش است، فقط به ظاهر زکات نمی‌دهد، بلکه زکات واقعی به معنای عمیق و معنوی آن وابسته است. در واقع، زکات حقیقی درون و روح او را می‌سازد و نه تنها به عمل ظاهری مرتبط است."],[833,"از خر عیسی دریغش نیست قند","لیک خر آمد به خلقت که پسند","قند را از خر عیسی دریغ نمی‌دارد اما اینگونه است که آن خر‌، کاه‌پسند است و کاه را می‌پسندد."],[833,"قند خر را گر طرب انگیختی","پیش خر قنطار شکر ریختی","اگر به خر قند و شیرینی بدهی و او را شاد کنی، با وجود اینکه خر را نمی‌توان با قند خوشحال کرد، در واقع بر او کار بیهوده‌ای انجام داده‌ای، چون او نمی‌تواند ارزش آن را درک کند."],[833,"معنی نختم علی افواههم","این شناس اینست ره‌رو را مهم","معنی این است که گفتن «نمی‌خواهم» بر زبان آن‌ها قفل شده و این آگاهی، نشانه این است که راه‌رو باید به این حقیقت توجه کند."],[833,"تا ز راه خاتم پیغامبران","بوک بر خیزد ز لب ختم گران","زمانی که پیامبر آخرین، خاتم پیامبران، از راه ظهور کند، طلوعی خواهد داشت که از لبان او نوری منتشر خواهد شد."],[833,"ختم‌هایی که انبیا بگذاشتند","آن به دین احمدی برداشتند","احمد، پیامبر اسلام، میراث دینی و تعالیم انبیا پیشین را پذیرفته و تکمیل کرده است. بنابراین، آموزه‌های گذشته به وسیله دین او تغییر کرده و به نوعی جدید و برتر درآمده‌اند."],[833,"قفل‌های ناگشاده مانده بود","از کف انا فتحنا برگشود","قفل‌هایی که تا به حال باز نشده بودند، به واسطه‌ی آیات و نشانه‌های الهی که در قرآن آمده است، گشوده شده و رازها و معانی جدید برای اهل فهم آشکار شده است."],[833,"او شفیع است این جهان و آن جهان","این جهان زی دین و آنجا زی جنان","او در این جهان و آن جهان شفیع است؛ این جهان به خاطر دین اوست و آن جهان به خاطر بهشت."],[833,"این جهان گوید که تو رهشان نما","وآن جهان گوید که تو مهشان نما","این جهان از تو می‌خواهد که راهنمایی و به آن‌ها کمک کنی، و آن دنیا هم از تو می‌خواهد که به آن‌ها جایی بدهی و برتری بدهی."],[833,"پیشه‌اش اندر ظهور و در کمون","اهد قومی انهم لا یعلمون","معنا: برخی از افراد در نهاد خود و در خفا نقش و موقعیتشان را نمی‌دانند و به حقیقت وجود خود آگاهی ندارند؛ در حالی که رفتار و حرفه آن‌ها در زندگی روزمره‌شان آشکار است."],[833,"باز گشته از دم او هر دو باب","در دو عالم دعوت او مستجاب","دعوت او در دو عالم (دنیا و آخرت) به گونه‌ای است که بازگشت هر دو طرف به سوی او و پاسخگویی به دعوتش قطعی و پذیرفته شده است."],[833,"بهر این خاتم شدست او که به جود","مثل او نه بود و نه خواهند بود","موضوع این بیت درباره کسی است که به خاطر ویژگی‌های بسیار خوبش، مانند جود و generosity، به عنوان خاتم و بهترین در میان افراد شناخته می‌شود. به عبارت دیگر، او به قدری باکرامت و نیکو است که هیچ کس دیگری مانند او وجود ندارد و در آینده نیز کسی به بزرگی او نخواهد آمد."],[833,"چونک در صنعت برد استاد دست","نه تو گویی ختم صنعت بر تو است","وقتی که استاد در هنر و صنعت به تو تسلط پیدا کند، نمی‌توانی بگویی که پایان این هنر به تو تعلق دارد."],[833,"در گشاد ختم‌ها تو خاتمی","در جهان روح‌بخشان حاتمی","تو در گشودگی و توسعه موجودات، مانند یک خاتم هستی و در جهان، خداوندی را معرفی می‌کنی که روح‌بخش است و تو را نیز به عنوان کسی با عظمتی معرفی می‌کند."],[833,"هست اشارات محمدالمراد","کل گشاد اندر گشاد اندر گشاد","اشارات محمد (پیامبر اکرم) به معنای گسترده‌ترین و عمیق‌ترین معانی و مفاهیم در عالم وجود است که هر چه بیشتر به آن توجه شود، ابعاد جدیدتری از آن نمایان می‌شود. به عبارت دیگر، پیام‌های او همچون گشایش‌های بی‌پایانی هستند که هر بار که به آن‌ها نگاه کنیم، ابعاد و عمق جدیدی از آن‌ها را کشف خواهیم کرد."],[833,"صد هزاران آفرین بر جان او","بر قدوم و دور فرزندان او","بر جان او، که شخصیت مهم و ارزشمندی دارد، و بر ورود و قدم‌های فرزندانش، که به خاطر ویژگی‌ها و نیکی‌هایشان او را شایسته تحسین می‌سازند، هزاران بار درود و سپاس فرستاده می‌شود."],[833,"آن خلیفه‌زادگان مقبلش","زاده‌اند از عنصر جان و دلش","خلیفه‌زادگان و فرزندان او از روح و محبت او متولد شده‌اند، نه فقط از جسم و خاک."],[833,"گر ز بغداد و هری یا از ری‌اند","بی‌مزاج آب و گل نسل وی‌اند","هرچند آن افراد از بغداد، هری یا ری باشند، اما اصل و نسبشان از نظر روح و ویژگی‌های انسانی، به آب و گل مخصوصی وابسته نیست و از این لحاظ تفاوتی ندارند."],[833,"شاخ گل هر جا که روید هم گلست","خم مل هر جا که جوشد هم ملست","هرجا که گل و شاخ آن بروید، باز هم گل است و هرجا که عسل (مل) جاری شود، آنجا هم عسل است. در واقع، این بیت به این معناست که اصل و حقیقت چیزها در هر مکان و زمان یکسان است."],[833,"گر ز مغرب بر زند خورشید سر","عین خورشیدست نه چیز دگر","اگر خورشید از مغرب (غرب) برآید، همچنان خود خورشید است و چیز دیگری نیست."],[833,"عیب‌چینان را ازین دم کور دار","هم به ستّاری خود ای کردگار","این بیت می‌گوید که خداوند، عیب‌جویان و کسانی که عیوب دیگران را می‌بینند را باید به نیروی خود از دیدن عیب‌ها منحرف سازد و به پوشاندن آنها کمک کند. خداوند قادر است تا به آن‌ها نیز نگاه عطوفت و رحمت کند."],[833,"گفت حق چشم خفاش بدخصال","بسته‌ام من ز آفتاب بی‌مثال","خداوند به خفاش چشم‌های بدی را داده و آنها را به خاطر ویژگی‌های ناپسندشان از نور آفتاب محروم کرده است."],[833,"از نظرهای خفاش کم و کاست","انجم آن شمس نیز اندر خفاست","اگرچه خفاش در تاریکی و از دور نمی‌تواند به روشنی خورشید نگاه کند، اما در حقایق و معانی، خورشید نیز مانند خفاش در حالتی پنهان است و از دیدها دور می‌ماند."],[834,"ای ضیاء الحق حسام‌الدین بیا","ای صقال روح و سلطان الهدی","ای نور خدا، حسام‌الدین، بیا و بیاور روح پاک و رهبر هدایت."],[834,"مثنوی را مسرح مشروح ده","صورت امثال او را روح ده","مولانا می‌گوید که مثنوی باید به طور واضح و روشن بیان شود، و انواع و اقسام شخصیت‌ها و امور را در آن به صورتی زنده و روح‌دار ارائه دهند."],[834,"تا حروفش جمله عقل و جان شوند","سوی خلدستان جان پران شوند","اگر حروف کلمات و معانی به درستی با عقل و روح انسان ارتباط پیدا کنند، به سوی بهشت جان پرواز می‌کنند."],[834,"هم به سعی تو ز ارواح آمدند","سوی دام حرف و مستحقن شدند","روح‌ها به خاطر تلاش تو به سمت دام و دامی از کلمات و سخنان آمدند و در آن‌جا محبوس شدند."],[834,"باد عمرت در جهان هم‌چون خضر","جان‌فزا و دستگیر و مستمر","عمر تو در این دنیا مانند خضر است که همیشه جان‌بخش و پشتیبان است و پیوسته ادامه دارد."],[834,"چون خضر و الیاس مانی در جهان","تا زمین گردد ز لطفت آسمان","چون خضر و الیاس، دو شخصیت الهی و زنده جاودانی، در جهان حاضرند، زمین به لطف تو، تبدیل به آسمان می‌شود و به کمال می‌رسد."],[834,"گفتمی از لطف تو جزوی ز صد","گر نبودی طمطراق چشم بد","گفتم اگر بخواهم از لطف تو چیزی بگویم، حتی اگر صد جزء هم باشد، باز هم در برابر طمطراق و فخامت چشم بد ناچیز است."],[834,"لیک از چشم بد زهراب دم","زخمهای روح‌فرسا خورده‌ام","در این بیت، کسی از زخم‌ها و آسیب‌های روحی‌ای که به خاطر چشم ناپاک دیگران متحمل شده صحبت می‌کند. او به نوعی می‌گوید که از تأثیرات منفی نگاه‌های ناپسند خسته و رنجور است."],[834,"جز به رمز ذکر حال دیگران","شرح حالت می‌نیارم در بیان","هرگز به طور صریح زندگی و احوال خود را بیان نمی‌کنم و فقط از طریق اشاره‌ها و رمزها حال دیگران را شرح می‌دهم."],[834,"این بهانه هم ز دستان دلیست","که ازو پاهای دل اندر گلیست","این بهانه از دستان دلی است که به خاطر عشق و محبت در چرخه‌ای از گل و زیبایی گرفتار شده است. در واقع، این دل به خاطر حالت عاشقانه‌اش، نمی‌تواند از زیبایی‌ها جدا شود و مشخص است که در عشق اسیر است."],[834,"صد دل و جان عاشق صانع شده","چشم بد یا گوش بد مانع شده","عاشقان و مؤمنان زیادی وجود دارند که به خاطر دیدگاه‌ها و شنیده‌های منفی دیگران نسبت به خداوند یا خالق خود دلیری‌شان را از دست می‌دهند و از محبت و عشق به او فاصله می‌گیرند."],[834,"خود یکی بوطالب آن عم رسول","می‌نمودش شنعه عربان مهول","خود بوطالب (عموی پیامبر اسلام، محمد) بود که به مدح و ستایش او می‌پرداخت و در زمان خود، شایعه‌های هولناک عرب‌ها را درباره او برمی‌گشتاند."],[834,"که چه گویندم عرب کز طفل خود","او بگردانید دین معتمد","عرب‌ها چه بگویند درباره کسی که از فرزند خود فاصله گرفته و دین مورد اعتمادش را کنار گذاشته است."],[834,"گفتش ای عم یک شهادت تو بگو","تا کنم با حق خصومت بهر تو","گفت ای عم، یک گواهی بده تا به خاطر تو با حق (خدا) دعوا کنم و به مخالفت برخیزم."],[834,"گفت لیکن فاش گردد ازسماع","کل سر جاوز الاثنین شاع","اما متوجه می‌شود که از شنیدن صدای کل، راز او برملا می‌شود و خودش نمی‌تواند بین دو طرف پنهان بماند."],[834,"من بمانم در زبان این عرب","پیش ایشان خوار گردم زین سبب","من در زبان این عرب، خوار و ذلیل می‌شوم به خاطر این که در حضور آن‌ها می‌مانم."],[834,"لیک گر بودیش لطف ما سبق","کی بدی این بددلی با جذب حق","اگر محبت و لطف ما پیشی گرفته باشد، دیگر بدبینی و دل‌بدخواهی نمی‌تواند اتفاق بیفتد; زیرا جذب و ارتباط با حقیقت، این مشکلات را برطرف می‌کند."],[834,"الغیاث ای تو غیاث المستغیث","زین دو شاخه اختیارات خبیث","ای کسی که پناه و مددکار طلبکاران هستی، از این دو انتخاب بد و ناپسند (اختیارات خبیث) که مرا درگیر کرده است، کمک کن."],[834,"من ز دستان و ز مکر دل چنان","مات گشتم که بماندم از فغان","من از دسیسه‌ها و نیرنگ‌های دل آن‌چنان گیج و حیران شدم که از فریاد و ناله‌ام در حالت سرگشتگی ماندم."],[834,"من که باشم چرخ با صد کار و بار","زین کمین فریاد کرد از اختیار","من که در دنیا درگیر صدها کار و مشکل هستم، از موقعیت دشواری که در آن قرار دارم، به فریاد می‌آیم و از اختیار و انتخاب خود بی‌زبان گشته‌ام."],[834,"که ای خداوند کریم و بردبار","ده امانم زین دو شاخه اختیار","ای خداوند مهربان و صبور، به من پناه بده و مرا از این دو مسیر انتخاب که در پیش دارم، حفظ کن."],[834,"جذب یک راهه صراط المستقیم","به ز دو راه تردد ای کریم","ای خداوند مهربان، جذب یک‌سویه به راه راست و درست، از دو راهی‌های پر تردید و بلاتکلیفی بهتر است."],[834,"زین دو ره گرچه همه مقصد توی","لیک خود جان کندن آمد این دوی","هرچند هدف نهایی این دو راه، رسیدن به تو (خدا) است، اما خودی و تلاش برای رسیدن به این هدف، بسیار سخت و دشوار است."],[834,"زین دو ره گرچه به جز تو عزم نیست","لیک هرگز رزم هم‌چون بزم نیست","هرچند هدف نهایی از این دو مسیر فقط تو هستی و هیچ عزم و اراده‌ای جز تو وجود ندارد، اما هرگز نباید جنگ و جدال را با شادی و خوشحالی یکسان دانست."],[834,"در نبی بشنو بیانش از خدا","آیت اشفقن ان یحملنها","در آیات قرآن، خداوند به پیامبر می‌گوید که به او وحی شده است و این موضوع را با بیانی نرم و مهرآمیز بیان کند. در اینجا، خداوند به او تأکید می‌کند که به گروهی نیکوکار و با محبت اشاره کند."],[834,"این تردد هست در دل چون وغا","کاین بود به یا که آن حال مرا","این شک در دل همچون یک آشفتگی است که شخص با خود می‌گوید این برای من بهتر است یا آن؟"],[834,"در تردد می‌زند بر همدگر","خوف و اومید بهی در کر و فر","ناامیدی و امید در دل افراد با هم تضاد دارند و به طور مداوم بر یکدیگر تأثیر می‌گذارند، گویی همواره در حال جنگ و نبرد هستند."],[835,"اولم این جزر و مد از تو رسید","ورنه ساکن بود این بحر ای مجید","این بیت اشاره دارد به اینکه تمام تغییرات و نوسانات در زندگی و جهان (مانند جزر و مد در دریا) ناشی از اراده و قدرت خداوند (مجید) است و اگر او نمی‌خواست، این دنیای متغیر و پر از حرکت ثابت می‌ماند."],[835,"هم از آنجا کین تردد دادیم","بی‌تردد کن مرا هم از کرم","من از آن جایی که ما به پی‌خورده دچار تردید و دگرگونی شده‌ایم، با لطف و کرم خود، بدون تردید و دگرگونی، مرا نیز هدایت کن."],[835,"ابتلاام می‌کنی آه الغیاث","ای ذکور از ابتلاات چون اناث","خداوند، ای پناه‌دهنده، مرا در آزمایش‌های خود امتحان می‌کنی؛ ای مایه نجات، درد و رنج من از آزمایش‌ها به حدی است که گویی مردان در سختی‌های خود ناتوانند مانند زنان."],[835,"تا بکی این ابتلا یا رب مکن","مذهبی‌ام بخش و ده‌مذهب مکن","ای پروردگارا، تا کی باید در این بلا و آزمایش بمانم؟ مرا مذهب و دینی بخش، ولی مرا با مذهب‌های گوناگون مبتلا نکن."],[835,"اشتری‌ام لاغری و پشت ریش","ز اختیار هم‌چو پالان‌شکل خویش","من مثل یک الاغ لاغر و ضعیف هستم که بر پشتش پالانی گذاشته‌اند. این نشان‌دهنده این است که بار اختیار را بر دوش دارم و احساس می‌کنم این بار بر من سنگینی می‌کند."],[835,"این کژاوه گه شود این سو گران","آن کژاوه گه شود آن سو کشان","این باریکه پر پیچ و خم (کژاوه) گاهی به یک طرف سنگینی می‌کند و گاهی به طرف دیگر می‌کشد. این اشاره به ناپایداری و تغییر در اختیار و سرنوشت انسان دارد."],[835,"بفکن از من حمل ناهموار را","تا ببینم روضه ابرار را","از من بار سنگین و مشکلات زندگی را بردار تا بتوانم جمال و زیباییشان را ببینم و به آرامش و خوشبختی دست یابم."],[835,"هم‌چو آن اصحاب کهف از باغ جود","می‌چرم ایقاظ نی بل هم رقود","من مانند آن اصحاب کهف هستم که از نعمت و بخشش خداوند در دنیا بهره‌مند می‌شوم، اما نه به حالت بیداری، بلکه در حالتی از خواب و بی‌خبر از دنیا به سر می‌برم."],[835,"خفته باشم بر یمین یا بر یسار","برنگردم جز چو گو بی‌اختیار","اگر بر سمت راست (یمین) یا چپ (یسار) خوابیده باشم، جز به گفتار و اراده خودم بازنخواهم گشت."],[835,"هم به تقلیب تو تا ذات الیمین","یا سوی ذات الشمال ای رب دین","ای پروردگار دین، من همواره در تقلب و تغییر حالت تو هستم، یا به سمت راست تو (یعنی رحمت و هدایت) و یا به سمت چپ تو (یعنی عذاب و گمراهی)."],[835,"صد هزاران سال بودم در مطار","هم‌چو ذرات هوا بی‌اختیار","مدت‌های بسیار زیادی را در عالم وجود گذراندم، مانند ذراتی از هوا که هیچ اختیاری ندارند."],[835,"گر فراموشم شدست آن وقت و حال","یادگارم هست در خواب ارتحال","اگر آن زمان و حال را فراموش کرده‌ام، نشانه‌ای از آن در خواب و تجربیات زندگی‌ام باقی مانده است."],[835,"می‌رهم زین چارمیخ چارشاخ","می‌جهم در مسرح جان زین مناخ","می‌خواهم از این درد و سختی‌های زندگی رها شوم و از گره‌های موجود در وجودم، به مکان امن و آرامی بروم که روح و جانم در آنجا آرام گیرد."],[835,"شیر آن ایام ماضیهای خود","می‌چشم از دایه خواب ای صمد","در این بیت، شاعر به زمان‌های گذشته و دوران کودکی خود اشاره می‌کند و می‌گوید که مانند یک شیر، به شیرینی و امنیت آن روزها نگاه می‌کند و مانند یک کودک به دایه‌اش، که نماد آرامش و خواب است، گرایش دارد. او به خدا (صمد)، که خود منبع آرامش و رفع نیازهاست، چشم امید دوخته است."],[835,"جمله عالم ز اختیار و هست خود","می‌گریزد در سر سرمست خود","کل عالم، به خاطر اختیاری که دارد و وجود خود، در حال فرار است و در درون خویش شاد و سرمست است."],[835,"تا دمی از هوشیاری وا رهند","ننگ خمر و زمر بر خود می‌نهند","مدت کوتاهی از آگاهی و هشیاری فاصله می‌گیرند و برای فرار از ناراحتی، عیبی مانند نشئگی (شراب‌خواری) و شلوغی (اجتماعات بی‌هدف) را بر خود می‌پوشانند."],[835,"جمله دانسته که این هستی فخ است","فکر و ذکر اختیاری دوزخ است","این دنیا و هستی، به نظر مولانا، به شکل ظاهری شگفت‌انگیزی است، اما اگر انسان به فکر و یادهای خود توجه کند، متوجه خواهد شد که اختیار و آزادای انتخاب، درست مانند دوزخی است که او را درگیر می‌کند."],[835,"می‌گریزند از خودی در بیخودی","یا به مستی یا به شغل ای مهتدی","آنان از خود و هویت واقعی‌شان دور می‌شوند، یا به خاطر مستی و حالت بی‌خودی، یا به دلیل مشغولیت و کارشان. ای هدایت‌یافته!"],[835,"نفس را زان نیستی وا می‌کشی","زانک بی‌فرمان شد اندر بیهشی","نفس انسان از آن حالت عدم و نیستی آزاد می‌شود چون که در بی‌خودی و بی‌فرمانی قرار می‌گیرد."],[835,"لیس للجن و لا للانس ان","ینفذوا من حبس اقطار الزمن","هیچ یک از جن و انس نمی‌توانند از محدودیت‌های زمان و مکان عبور کنند."],[835,"لا نفوذ الا بسلطان الهدی","من تجاویف السموات العلی","هیچ راه نفوذی و عبوری نیست جز به واسطه سلطانی که هدایت می‌کند از درون فضاهای بلند آسمان‌ها."],[835,"لا هدی الا بسلطان یقی","من حراس الشهب روح المتقی","هیچ هدایت و رهبری جز با تسلط و قدرتی که از حراست ستاره‌ها (و نور الهی) به دست می‌آید، وجود ندارد و این هدایت، روح افراد پرهیزکار را در بر می‌گیرد."],[835,"هیچ کس را تا نگردد او فنا","نیست ره در بارگاه کبریا","هیچ‌کس نمی‌تواند وارد بارگاه خداوند بزرگ شود مگر آنکه پیش از آن خود را از وجود خویش خالی کند و فنا شود."],[835,"چیست معراج فلک این نیستی","عاشقان را مذهب و دین نیستی","معراج آسمان چیست؟ این نیستی است که عاشقان به آن دست می‌یابند، زیرا مذهب و دین نیز در حقیقت به نیستی و فنا می‌انجامد."],[835,"پوستین و چارق آمد از نیاز","در طریق عشق محراب ایاز","از سر نیاز و محبت در راه عشق، پوستین و چارق (پوشش‌هایی ساده و بی‌قیمت) برای ایاز (که به معنای عاشق و مرید است) به‌دست آمده است. این نشان‌دهنده تواضع و فدای خواسته‌های دنیوی برای رسیدن به عشق الهی است."],[835,"گرچه او خود شاه را محبوب بود","ظاهر و باطن لطیف و خوب بود","هرچند ایاز به عنوان محبوب شاه شناخته می‌شود، اما او از نظر روحی و درون‌مایه نیز انسان نیکو و لطیفی است."],[835,"گشته بی‌کبر و ریا و کینه‌ای","حسن سلطان را رخش آیینه‌ای","حسن سلطان به گونه‌ای شده که خالی از کبر، ریا و کینه است، و مانند آینه‌ای می‌درخشد که زیبایی او را نشان می‌دهد."],[835,"چونک از هستی خود او دور شد","منتهای کار او محمود بد","زمانی که انسان از وجود واقعی خود فاصله می‌گیرد، به اوج کمال و فضیلت می‌رسد و به حالت محمود (ستوده) دست می‌یابد."],[835,"زان قوی‌تر بود تمکین ایاز","که ز خوف کبر کردی احتراز","ایاز، که از شخصیت‌های تاریخ ایران است، از ترس خودبرتربینی و کبر، خود را مهار کرده و قوی‌تر از آن شده است که در برابر آن تسلیم شود. این نشان می‌دهد که او توانسته بر خود تسلط پیدا کند و از ضعف‌های درونی خود فاصله بگیرد."],[835,"او مهذب گشته بود و آمده","کبر را و نفس را گردن زده","او تربیت شده و به‌گونه‌ای به کبر و نفس خود فرمانبردار شده است."],[835,"یا پی تعلیم می‌کرد آن حیل","یا برای حکمتی دور از وجل","او یا برای آموزش، به این روش‌ها و ترفندها متوسل می‌شد، یا به دلایلی بلندپروازانه و دور از ترس و وحشت این کار را انجام می‌داد."],[835,"یا که دید چارقش زان شد پسند","کز نسیم نیستی هستیست بند","همان‌طور که می‌بیند، کسی در حال تماشای زندگی و هستی است و به خاطر نسیم خوشبختی یا حالتی خوشایند، به چیزی که وضعیت را تغییر می‌دهد، راضی و خوشحال شده است؛ این نشان‌دهنده این است که گاهی اوقات اتفاقات مثبتی می‌تواند در دل ناپایداری‌ها و بحران‌ها به وجود آید."],[835,"تا گشاید دخمه کان بر نیستیست","تا بیاید آن نسیم عیش و زیست","تا زمانی که درون غار (دخمه) را که در آن وجود ندارد، باز نکنند، آن نسیم خوشی و زندگی نمی‌آید."],[835,"ملک و مال و اطلس این مرحله","هست بر جان سبک‌رو سلسله","در این مرحله، پادشاهی، دارایی و ثروت به مانند پارچه‌ای اشرافی (اطلس) هستند که برای روح‌های سبک‌بار و آزاد، زینتی به شمار می‌آید."],[835,"سلسله زرین بدید و غره گشت","ماند در سوراخ چاهی جان ز دشت","شخصی به زیبایی و زرق و برق زندگی فریبنده (سلسله زرین) دچار شگفتی و فریب می‌شود و در نتیجه، به چاه (جایگاه خطرناک و نامناسب) می‌افتد و در آن محبوس می‌ماند، در حالی که از دشت (آزادی و سرسبزی) دور شده است."],[835,"صورتش جنت به معنی دوزخی","افعیی پر زهر و نقشش گل رخی","ظاهرش به اندازه بهشت زیباست، اما باطنا مانند افعی سمّی و خطرناک است که زهر دارد و نقش صورتش به گل خوش‌رویی می‌ماند."],[835,"گرچه مؤمن را سقر ندهد ضرر","لیک هم بهتر بود زانجا گذر","اگرچه آزار و عذاب دوزخ (سقر) به مؤمنان نمی‌رسد و آنها در امان هستند، اما بهتر است که انسان از آنجا هم دوری کند و به جایی دیگر برود."],[835,"گرچه دوزخ دور دارد زو نکال","لیک جنت به ورا فی کل حال","هرچند دوزخ از او دور است و او از آن خلاصی دارد، اما در هر حال بهشت بالاتر و بهتر از آن است."],[835,"الحذر ای ناقصان زین گلرخی","که بگاه صحبت آمد دوزخی","ای ناقصان، در برابر این گلرخ (زیبارو) احتیاط کنید، زیرا هنگامی که در کنار او باشید، ممکن است به دوزخ بیفتید."],[836,"خواجه‌ای را بود هندو بنده‌ای","پروریده کرده او را زنده‌ای","شخصی بود که غلامی هندو داشت که خود به‌خوبی پرورش داده بود."],[836,"علم و آدابش تمام آموخته","در دلش شمع هنر افروخته","دانش و رسم و رسوم به‌او تماما آموخته بود و او را صاحب‌هنر بار آورده بود."],[836,"پروریدش از طفولیت به ناز","در کنار لطف آن اکرام‌ساز","با دقت و مهربانی از کودکی او را بزرگ کرد."],[836,"بود هم این خواجه را خوش دختری","سیم‌اندامی گشی خوش‌گوهر‌ی","این شخص، دختری زیبا داشت؛ سیم‌اندام و تازه و خوش‌گوهر."],[836,"چون مراهق گشت دختر طالبان","بذل می‌کردند کابین گران","وقتی دختر بالغ شد‌، خواستگاران با پیشنهاد شیربهای زیاد و فراوان می‌آمدند."],[836,"می‌رسیدش از سوی هر مهتر‌ی","بهر دختر دم به دم خوزه‌گر‌ی","و هر روز از سوی یک آدم بزرگ و مهم‌، برای آن دختر یک خوزه‌گر و خواستار می‌رسید."],[836,"گفت خواجه مال را نبود ثبات","روز آید شب رود اندر جهات","خواجه (بنده غنی) می‌گوید که مال و دارایی هیچگاه ثابت و پایدار نیست؛ روزی می‌آید که شب فرارسد و همه چیز به جهات مختلف خواهد رفت و نابود خواهد شد."],[836,"حسن صورت هم ندارد اعتبار","که شود رخ زرد از یک زخم خار","زیبایی ظاهری هیچ ارزشی ندارد وقتی که چهره دچار زردی و زخم شده باشد."],[836,"سهل باشد نیز مهترزادگی","که بود غره به مال و بارگی","اگر کسی به مقام و ثروت خود مغرور باشد و فکر کند که این‌ها او را از دیگران متمایز می‌کند، باید بداند که این‌گونه برتری‌ها بی‌اهمیت و سهل است."],[836,"ای بسا مهتر‌بچه کز شور و شر","شد ز فعل زشت خود ننگ پدر","بسیاری از جوانان ثروتمند ممکن است به خاطر رفتار زشت خود، موجب ننگ و عیب برای خانواده‌شان شوند."],[836,"پر هنر را نیز اگر باشد نفیس","کم پرست و عبرتی گیر از بلیس","اگر کسی هنری باارزش و با شخصیت داشته باشد، ولی در مسیر زندگی‌اش دچار لغزش شود، باید از شیاطحین و شیطان عبرت بگیرد و بیاموزد که چگونه به بیراهه نرود."],[836,"علم بودش چون نبودش عشق دین","او ندید از آدم الا نقش طین","این غریب، دانشی داشت که اگر عشق خداوند در دل او نبود، معنای واقعی دین را نمی‌دید و فقط ظواهر دنیوی آدم را می‌دید."],[836,"گرچه دانی دقت علم ای امین","زانت نگشاید دو دیده غیب‌بین","هرچند که تو ای امین (دستیار یا دوست) به دقت علم آگاهی، اما علم به تنهایی نمی‌تواند چشمان غیب‌بین (بینش عمیق) را برای تو بگشاید و واقعیات پنهان را نشان دهد."],[836,"او نبیند غیر دستار‌ی و ریش","از معرف پرسد از بیش و کمی‌ش","او فقط ظاهر را می‌بیند، مانند عمامه و ریش، و از معرفتی که دارد، نمی‌تواند کم و زیاد آن را بشناسد."],[836,"عارفا تو از معرف فارغی","خود همی‌بینی که نور بازغی","ای عارف، تو از شناخت و معرفت بی‌خبر هستی و فقط خود را مانند نوری درخشان می‌بینی که در واقعیت این‌گونه نیست."],[836,"کار تقوی دارد و دین و صلاح","که ازو باشد بدو عالم فلاح","اصل کار، تقوی و دین و درستکاری است زیرا از این‌ها دنیا رستگار می‌شود."],[836,"کرد یک داماد صالح اختیار","که بد او فخر همه خیل و تبار","داماد خوبی انتخاب کرد که او باعث افتخار تمام خانواده و قومش بود."],[836,"پس زنان گفتند او را مال نیست","مهتری و حسن و استقلال نیست","زن‌ها می‌گویند که او ثروت ندارد و از نظر مقام، زیبایی و استقلال هم در موقعیت خوبی نیست."],[836,"گفت آنها تابع زهدند و دین","بی‌زر او گنجی‌ست بر روی زمین","آن‌ها گفته‌اند که این افراد فقط به زهد و دین اهمیت می‌دهند و بی‌پولی او را نادیده می‌گیرند، در حالی که او ثروتی باارزش است که در دل او پنهان شده است."],[836,"چون به جد تزویج دختر گشت فاش","دست پیمان و نشانی و قماش","وقتی که مسأله ازدواج دختر به‌طور علنی روشن شد، نشانه و علامتی از پیمان و قرارداد به‌دست آمد."],[836,"پس غلام خرد که‌اندر خانه بود","گشت بیمار و ضعیف و زار زود","غلام جوانی که در خانه بود، به سرعت بیمار و ضعیف و ناتوان شد."],[836,"هم‌چو بیمار دقی او می‌گداخت","علت او را طبیبی کم شناخت","همچون بیماری که به شدت رنج می‌برد و در حال زوال است، غلام نیز به شدت ناراحت و غمناک بود و هیچ طبیبی نتوانست علت ناراحتی او را تشخیص دهد."],[836,"عقل می‌گفتی که رنجش از دل است","داروی تن در غم دل باطل است","عقل به او می‌گفت که دردش از دل است و بنابراین داروهایی که برای بدن تجویز می‌شود، دردی که مربوط به دل است را درمان نمی‌کند."],[836,"آن غلامک دم نزد از حال خویش","کز چه می‌آید برو در سینه نیش","غلام هندو درباره حال خود چیزی نمی‌گفت و از آنچه در دلش می‌گذشت، سخنی به زبان نمی‌آورد، چون نمی‌دانست رنجش از کجاست و چه چیزی او را آزار می‌دهد."],[836,"گفت خاتون را شبی شوهر که تو","باز پرسش در خلا از حال او","زن در شب زفاف به شوهرش می‌گوید که تو از حال غلام بپرس، زیرا او در دل خود غم و درد دارد که نمی‌تواند بیان کند."],[836,"تو به جای مادری او را بود","که غم خود پیش تو پیدا کند","غلام هندو احساس می‌کند که او به‌جای مادر دختر می‌تواند محرم راز او باشد، زیرا او می‌تواند درد و غم خود را در دل او بگوید و ابراز کند."],[836,"چونک خاتون کرد در گوش این کلام","روز دیگر رفت نزدیک غلام","زمانی که خانم (دختر) این صحبت را در گوش او (غلام) کرد، روز بعد به نزد او رفت."],[836,"پس سرش را شانه می‌کرد آن ستی","با دو صد مهر و دلال و آشتی","او، یعنی مادر دختر، سر غلام هندو را به آرامی شانه می‌کرد و با محبت و مهربانی بسیار، سعی داشت او را آرام کند و از دلش دردی که داشت، کم کند."],[836,"آنچنان که مادران مهربان","نرم کردش تا در آمد در بیان","غلام هندو را مادران مهربان با محبت و نوازش نرم و آرام کردند تا او بتواند feelings خود را بیان کند و صحبت کند."],[836,"که مرا اومید از تو این نبود","که دهی دختر به بیگانه عنود","غلام هندو انتظار نداشت که تو دخترش را به مردی غیربومی و نامناسب بدهی."],[836,"خواجه‌زاده ما و ما خسته‌جگر","حیف نبود که رود جای دگر","درد و رنج ما از این وضعیت ما را آزار می‌دهد و جایز نیست که خواجه‌زاده ما به مکان دیگری برود و از ما دور شود."],[836,"خواست آن خاتون ز خشمی که آمدش","که زند وز بام زیر اندازدش","آن زن به علت خشمش می‌خواست او را از بام پرت کند و به زمین بیندازد."],[836,"کو که باشد هندو‌ی مادر غر‌ی","که طمع دارد به خواجه دختر‌ی","هندوی مادر غلامی که در عشق خواجه، شوق و طمع به دختر او دارد، کیست؟"],[836,"گفت صبر اولی بود خود را گرفت","گفت با خواجه که بشنو این شگفت","غلام هندو گفت که صبر بهتر است و خود را کنترل کرد، سپس به خواجه (که به احتمال زیاد پدر دختر است) گفت که این موضوع را بشنوید، چون حالت عجیبی پیش آمده است."],[836,"این چنین گراء کی خاین بود","ما گمان برده که هست او معتمد","این‌گونه که او بی‌دلیل خیانت‌کار می‌شود، ما تصور کرده‌ایم که او مورد اعتماد است."],[837,"گفت خواجه صبر کن با او بگو","که ازو ببریم و بدهیمش به تو","خواجه به غلام گفت صبر کن و با او صحبت کن تا ما او را بگیریم و به تو بدهیم."],[837,"تا مگر این از دلش بیرون کنم","تو تماشا کن که دفعش چون کنم","من می‌خواهم این احساس را از دل او خارج کنم. تو باید تماشا کنی که چگونه این کار را انجام می‌دهم."],[837,"تو دلش خوش کن بگو می‌دان درست","که حقیقت دختر ما جفت تست","به او بگو که دلش را شاد کنی و به درستی بگو که حقیقت این است که دختر ما همسر توست."],[837,"ما ندانستیم ای خوش مشتری","چونک دانستیم‌، تو اولی‌تری","نمی‌دانستیم که تو را خوشحال می‌دانستیم، اما حالا که دانستیم، تو بهتر و شایسته‌تر هستی."],[837,"آتش ما هم درین کانون ما","لیلی آن ما و تو مجنون ما","در اینجا سخن از عشق و عشق‌ورزی است. به نوعی می‌توان گفت که آتش عشق ما در این محیط و جوّ حاکم برلیلی (عشق) قرار دارد و ما (عاشق) مانند مجنون (شخصی دیوانه به خاطر عشق لیلی) هستیم. این بیت احساساتی در مورد عشق و وابستگی به معشوق را ابراز می‌کند."],[837,"تا خیال و فکر خوش بر وی زند","فکر شیرین مرد را فربه کند","اگر فکر و خیال خوش به ذهن مردی راه یابد، این افکار شیرین او را توانمند و سرفراز می‌سازند."],[837,"جانور فربه شود لیک از علف","آدمی فربه ز عز است و شرف","حیوانات از طریق علف و تغذیه فربه و چاق می‌شوند، اما انسان‌ها به واسطه عزت و شرف و برتری‌های خود رشد می‌کنند و به کمال می‌رسند."],[837,"آدمی فربه شود از راه گوش","جانور فربه شود از حلق و نوش","انسان از طریق شنیدن و آگاهی‌ها و تجربیاتی که می‌آموزد، رشد می‌کند و به کمال می‌رسد، اما حیوانات از طریق خوردن و نوشیدن چیزها فربه و بزرگ می‌شوند."],[837,"گفت آن خاتون ازین ننگ مهین","خود دهانم کی بجنبد اندرین","آن زن گفت: من از این ننگ و عیبی که بر من وارد شده، آن‌قدر شرمنده‌ام که نمی‌توانم حتی دهانم را باز کنم و سخنی بگویم."],[837,"این چنین ژاژی چه خایم بهر او","گو بمیر آن خاین ابلیس‌خو","این‌طور بودن و شکایت کردن برای او چه فایده‌ای دارد؟ باید بگویی به آن خائن که مانند ابلیس است، بمیرد."],[837,"گفت خواجه نی مترس و دم دهش","تا رود علت ازو زین لطف خوش","خواجه به غلام می‌گوید نترس و بی‌صدا نفس بکش تا به خاطر این لطف خوب، علت درد او از بین برود."],[837,"دفع او را دلبرا بر من نویس","هل که صحت یابد آن باریک‌ریس","از معشوق بخواه که کاری کند تا او از من دور نشود، زیرا با این کار، آن زن لطیف و ظریف دوباره به حال خوبش برمی‌گردد."],[837,"چون بگفت آن خسته را خاتون چنین","می‌نگنجید از تبختر بر زمین","وقتی آن زن (خاتون) به آن خسته (مرد) گفت، او نمی‌توانست از شدت خودپسندی و غرور به زمین بیفتد و زانو بزند."],[837,"زفت گشت و فربه و سرخ و شکفت","چون گل سرخ هزاران شکر گفت","غلام به تدریج چاق و سرخ‌رنگ و شاداب شده و مانند گل سرخ، هزاران هنری که دارد را به نمایش می‌گذارد."],[837,"که گهی می‌گفت ای خاتون من","که مبادا باشد این دستان و فن","او گهگاهی به آن زن می‌گفت که نگران نباشد، زیرا ممکن است این دستان و هنرها موجب نگرانی و زحمت او نشود."],[837,"خواجه جمعیت بکرد و دعوتی","که همی‌سازم فرج را وصلتی","خواجه تصمیم گرفته که جمعی را دعوت کند و به برقراری ارتباطی که به او خوشبختی می‌بخشد، بپردازد."],[837,"تا جماعت عشوه می‌دادند و گال","که ای فرج بادت مبارک اتصال","در این بیت، اشاره به این است که جمعی از مردم (یا عشاق) با ناز و طمع به فرج (دختری) ابراز محبت و شیفتگی می‌کنند و او را تبریک می‌گویند. در واقع، نوعی تظاهر به شادی و خوشحالی به خاطر وصلتی که در راه است، وجود دارد."],[837,"تا یقین‌تر شد فرج را آن سخن","علت از وی رفت کل از بیخ و بن","چون سخن درباره فرج (و فرج یعنی گشایش و رهایی) بیشتر یقین پیدا شد، به‌طوری‌که علت اصلی آن کاملا از بین رفت."],[837,"بعد از آن اندر شب گردک به فن","امردی را بست حنی هم‌چو زن","پس از آن، در شب، گردکی را به فن و کار خود بستند که مانند زن به حنی، مردی را در خط و نشان گرفتن، کنترل کردند."],[837,"پر نگارش کرد ساعد چون عروس","پس نمودش ماکیان دادش خروس","دستش را مانند ساعد عروس آرایش کرد و سپس یک خروس به او نشان داد."],[837,"مقنعه و حله عروسان نکو","کنگ امرد را بپوشانید او","مقنعه و لباس زیبای دختران را بر سر جوان زیبا بگذارید."],[837,"شمع را هنگام خلوت زود کشت","ماند هندو با چنان کنگ درشت","شمع در خلوت به سرعت خاموش شد و هندو با آن سرپوش بزرگ در آنجا باقی ماند."],[837,"هندوک فریاد می‌کرد و فغان","از برون نشنید کس از دف‌زنان","هندوک در حال فریاد زدن و ناله کردن بود، اما هیچ‌کس صدای دف‌زنان را از بیرون نشنید."],[837,"ضرب دف و کف و نعره مرد و زن","کرد پنهان نعره آن نعره‌زن","صدای دف، کف زدن و نعره‌های مردان و زنان به گوش می‌رسد، اما نعره آن فردی که فریاد می‌زند در حقیقت به صورت پنهانی و درون خودش دیده می‌شود."],[837,"تا به روز آن هندوک را می‌فشارد","چون بود در پیش سگ انبان آرد‌؟","دختر هندی تا روز عروسی به محبت و عشق به داماد ادامه می‌دهد، چرا که در مقابل عشق و محبت، مانند سگی که در برابر انباری از غذا، نمی‌تواند کاری جز فشردن می‌تواند بکند."],[837,"زود آوردند طاس و بوغ زفت","رسم داماد‌ان فرج حمام رفت","سریعا ظرفی و چربی آوردند، که این‌ها از نشانه‌های دامادی است و داماد به حمام رفت."],[837,"رفت در حمام او رنجور جان","کون دریده هم‌چو دلق تونیان","در حمام، او در حال رنج و عذابی شدید است؛ روحش مانند پارچه‌ای که پاره شده، پریشان و زرده."],[837,"آمد از حمام در گردک فسوس","پیش او بنشست دختر چون عروس","پس از اینکه او (غلام) از حمام خارج شد و در حالی که لباس‌هایش همچون گردک فسوس (نوعی لباس درخشان) بود، پیش دختر نشسته است و او را همچون عروسی زیبا می‌بیند."],[837,"مادرش آنجا نشسته پاسبان","که نباید کاو کند روز امتحان","مادر دختر در آنجا نشسته و مراقب است که کسی روز امتحان نتواند مزاحم شود."],[837,"ساعتی در وی نظر کرد از عناد","آنگهان با هر دو دستش ده بداد","او (مادر دختر) مدتی به خاطر کینه و دشمنی به او (پسر) نگاه کرد و بعد از آن با دو دستش مهر و محبتش را نثار او کرد."],[837,"گفت کس را خود مبادا اتصال","با چو تو ناخوش عروس بد‌فعال","گفت هیچ‌کس را نباید نزدیک عروسی کند که مانند تو نامطلوب و بدخلق است."],[837,"روز رویت روی خاتونان تر","کیر زشتت شب بتر از کیر خر","این بیت به نوعی به زیبایی و جذابیت صورت معشوق اشاره می‌کند و در مقابل، زشتی و ناپسندی چیزی را که به آن اشاره شده، به ویژه در شب، به تصویر می‌کشد و این تحقیر باعث می‌شود تا شب نسبت به روز و زیبایی معشوق، بدتر به نظر برسد."],[837,"هم‌چنان جمله نعیم این جهان","بس خوش‌ست از دور پیش از امتحان","این دنیا به نظر خوش و زیبا می‌آید، اما این زیبایی قبل از آزمایش و تجربه واقعی است و وقتی به آن نزدیک می‌شویم، حقیقت آن ممکن است متفاوت باشد."],[837,"می‌نماید در نظر از دور آب","چون روی نزدیک باشد آن سراب","از دور، آب به نظر بسیار زیبا و دل‌انگیز می‌آید، اما وقتی نزدیک می‌شویم، متوجه می‌شویم که آن فقط سراب است و حقیقت ندارد."],[837,"گنده پیر‌ست او و از بس چاپلوس","خویش را جلوه کند چون نو عروس","این شخص پیر و بزرگ است و به خاطر چاپلوسی که در خود دارد، خود را به گونه‌ای نشان می‌دهد که انگار تازه عروسی است که می‌خواهد چشم‌ها را به خود جلب کند."],[837,"هین مشو مغرور آن گلگونه‌اش","نوش نیش‌آلوده او را مچش","فریب نخور به زیبایی و چهره گل مانند او؛ زیرا لب‌های او به زهر آغشته است که ممکن است به تو آسیب برساند."],[837,"صبر کن کالصبر مفتاح الفرج","تا نیفتی چون فرج در صد حرج","صبر کن، زیرا صبر کلید گشایش است، تا اینکه مانند گشایش، در مشکلات گرفتار نشوی."],[837,"آشکارا دانه پنهان دام او","خوش نماید ز اولت انعام او","دانه‌ای که به ظاهر زیبا و خوش‌نماست، در حقیقت می‌تواند دام و تله‌ای باشد که برای فریب ما گذاشته شده است. انعام و پاداشی که به ما داده می‌شود، ممکن است از همان اول فریبنده و فریبکار به نظر بیاید."],[838,"چون بپیوستی بدان ای زینهار","چند نالی در ندامت زار زار","اگر به آن عمر گرانبها وصل شدی، و حالا از آنچه گذشته ابراز ندامت و گله‌مندی می‌کنی، این ناله و ندامت برای تو بی‌فایده است."],[838,"نام میری و وزیری و شهی","در نهانش مرگ و درد و جان‌دهی","آن‌چیزی که میری و وزیری و شاهی می‌نامند در اصل مرگ و درد و جان‌کندن است."],[838,"بنده باش و بر زمین رو چون سمند","چون جنازه نه که بر گردن برند","بنده و خدمت‌گار باش و بر زمین، پیاده برو و همچون سمند، سبکرو باش (نه آنکه بر تخت روان و بر دوش بندگان) و در حقیقت مانند جنازه که بر دوش می‌برند."],[838,"جمله را حمال خود خواهد کفور","چون سوار مرده آرندش به گور","همه‌ی انسان‌ها مانند باری خواهند شد که باید بر دوش دیگری حمل شوند، همان‌طور که مرده را برای دفن به قبر می‌برند."],[838,"بر جنازه هر که را بینی به خواب","فارس منصب شود عالی رکاب","هر کس را که در خواب ببینی، جنازه‌اش به خواب فارس (شکلی از شوکت و مقام) بدل می‌شود و در نتیجه، او به مقام و مرتبه‌ای بالا می‌رسد. این نشان‌دهنده آرزوها و احساسات بلندپروازانه انسان‌هاست."],[838,"زانک آن تابوت بر خلقست بار","بار بر خلقان فکندند این کبار","برای همین است که آن تابوت (جنازه) بار سنگینی بر دوش مردم است و این بار (خوی) به دوش همه آنان گذاشته شده است."],[838,"بار خود بر کس منه بر خویش نه","سروری را کم طلب درویش به","باری که بر دوش دیگران می‌گذاری، بر دوش خود نگذار و طلب مقام و سروری نکن، حتی اگر درویش هستی."],[838,"مرکب اعناق مردم را مپا","تا نیاید نقرست اندر دو پا","مردم را به خود مغرور نکن و آنها را به زیر نفوذ نبر، زیرا اگر خودپسند شوند، به زودی خود را در انزوا و نادانی خواهند دید."],[838,"مرکبی را که آخرش تو ده دهی","که به شهری مانی و ویران‌دهی","اگر تو به یک جایی بروی و از دیگران بهره‌برداری کنی یا جایی را خراب کنی، در واقع خودت در آخر کار مسئولیت را بر عهده داری، چرا که خودت به آنجا رفته‌ای و شرایط را به وجود آورده‌ای."],[838,"ده دهش اکنون که چون شهرت نمود","تا نباید رخت در ویران گشود","اکنون که مقام و شهرت او در نظر می‌آید، نباید که به آینده و ویرانی‌ها فکر کند و خود را در معرض خطر قرار دهد."],[838,"ده دهش اکنون که صد بستانت هست","تا نگردی عاجز و ویران‌پرست","تو امروز با بخشش‌های فراوانی روبرو هستی که چنانچه از آن بهره‌مند نشوی، به ناتوانی و از دست دادن خودت گرفتار خواهی شد."],[838,"گفت پیغامبر که جنت از اله","گر همی‌خواهی ز کس چیزی مخواه","پیامبر گفت که اگر به بهشت و آرامش الهی نیاز داری، از هیچ کس چیزی نخواه و تنها به خود خداوند توکل کن."],[838,"چون نخواهی من کفیلم مر ترا","جنت الماوی و دیدار خدا","اگر نخواهی از من چیزی بخواهی، جنت محل سکونت و دیدار خدا را برای تو نمی‌توانم فراهم کنم."],[838,"آن صحابی زین کفالت شد عیار","تا یکی روزی که گشته بد سوار","این صحابی به خاطر مسئولیتش در کمک به دیگران معروف و شناخته شده شد، اما روزی به خاطر سوار شدن بد، از مقام و اعتبار خود سقوط کرد."],[838,"تازیانه از کفش افتاد راست","خود فرو آمد ز کس آنرا نخواست","تازیانه (چوبی که برای تنبیه یا هدایت حیوانات استفاده می‌شود) از دست فردی افتاد و او به دلیل خودپسندی و غرور، آن را از کسی نمی‌خواهد که به او بدهد."],[838,"آنک از دادش نیاید هیچ بد","داند و بی‌خواهشی خود می‌دهد","او (خدای) حق، از داد و انصاف خود هیچ بدی نداشته و نمی‌تواند بدی کند و بدون هیچ خواسته‌ای از کسی، به دیگران نیکی می‌کند."],[838,"ور به امر حق بخواهی آن رواست","آنچنان خواهش طریق انبیاست","اگر بخواهی چیزی را به‌خاطر فرمان خدا بخواهی، این خواسته درست و معقول است؛ زیرا خواسته‌ای که بر مبنای الهام انبیا باشد، صحیح و مورد قبول است."],[838,"بد نماند چون اشارت کرد دوست","کفر ایمان شد چو کفر از بهر اوست","هرگز بدی باقی نمی‌ماند، زیرا زمانی که دوست (خدا) اشاره کند، کفر به ایمان تبدیل می‌شود؛ یعنی اگر کسی در نظر خداوند کافر باشد، آن کفر برای اوست و تحت اراده او به ایمان تبدیل خواهد شد."],[838,"هر بدی که امر او پیش آورد","آن ز نیکوهای عالم بگذرد","هر آسیبی که به دستور و امر خدا پیش بیاید، از نیکی‌ها و خوبی‌های دنیا عبور می‌کند و در واقع، هیچ بدی حقیقی وجود ندارد مگر آنکه در نهایت به خیر و نیکی منتهی می‌شود."],[838,"زان صدف گر خسته گردد نیز پوست","ده مده که صد هزاران در دروست","اگر صدف (موجودی دریایی که مروارید در آن به وجود می‌آید) هم آسیب ببیند، نباید آن را دور بیندازید، زیرا درون آن ممکن است صدها مروارید ارزشمند وجود داشته باشد."],[838,"این سخن پایان ندارد بازگرد","سوی شاه و هم‌مزاج باز گرد","این سخن هیچ‌گاه تمام نمی‌شود، پس به سوی شاه (خدا) و هم‌مزاج (کسانی که در سلوک به او هستند) بازگرد."],[838,"باز رو در کان چو زر ده‌دهی","تا رهد دستان تو از ده‌دهی","اگر درون خود را پاک کنی و به معانی عمیق وجودت بپردازی، همچون طلا در کانی می‌توانی از دست دادن‌های خود رهایی یابی."],[838,"صورتی را چون بدل ره می‌دهند","از ندامت آخرش ده می‌دهند","انسان‌ها در نهایت، به خاطر ندامت و پشیمانی، یک چهره بهتر و زیباتر به خود می‌گیرند، اما ممکن است در نهایت همچنان به اشتباهات خود ادامه دهند."],[838,"توبه می‌آرند هم پروانه‌وار","باز نسیان می‌کشدشان سوی کار","انسان‌ها همچون پروانه‌ها به سمت نور جذبه دارند و چون به گناه می‌افتند، بعد از اندکی توبه می‌کنند، اما دوباره فراموشی برشان غلبه کرده و به کارهای پیشین خود باز می‌گردند."],[838,"هم‌چو پروانه ز دور آن نار را","نور دید و بست آن سو بار را","انسانی‌که در عشق و جذبه‌ی چیزی قرار می‌گیرد، مانند پروانه‌ای است که از دور نور آتش را می‌بیند و به سمت آن می‌رود، غافل از اینکه آن آتش، خطرساز است و او را می‌سوزاند."],[838,"چون بیامد سوخت پرش را گریخت","باز چون طفلان فتاد و ملح ریخت","وقتی که پروانه به سمت شمع می‌رود و می‌سوزد، مثل بچه‌هایی که به خاطر ترس می‌افتند و نگران از بین رفتن خود هستند، به عقب برمی‌گردد و دست‌وپا می‌زند، در حالی که مانند بچه‌ها هم خود را خراب می‌کند و مانند نمک می‌ریزد."],[838,"بار دیگر بر گمان طمع سود","خویش زد بر آتش آن شمع زود","دوباره به امید کسب منافع شخصی‌اش، بی‌دقتی کرده و به شمعی که در حال سوختن است، نزدیک شده است."],[838,"بار دیگر سوخت هم واپس بجست","باز کردش حرص دل ناسی و مست","بار دیگر، مانند هندو که شمع را می‌سوزاند، او نیز دوباره در پی سود خود رفت و حرص و آز دلش را باز کرد، در حالی که ناسی (خودبزرگ‌بینی) و مست (مستی یا نشئه) بود."],[838,"آن زمان کز سوختن وا می‌جهد","هم‌چو هندو شمع را ده می‌دهد","در زمانی که از سوختن شمع، شعله‌اش می‌جهد و به شدت نور می‌افکند، مانند هندو که در حال خوشحالی و شوق است، نشان‌دهنده غرور و خودشیفتگی است که به انسان دست می‌دهد."],[838,"که ای رخت تابان چون ماه شب‌فروز","وی به صحبت کاذب و مغرورسوز","ای کسی که همچون ماه شب‌تاب زیبا و درخشان هستی، تو با گفتگو و همراهی کسانی که ادعاهای دروغین دارند و به غرور دچارند، در خطر هستی."],[838,"باز از یادش رود توبه و انین","کاوهن الرحمن کید الکاذبین","او که از رحمت خدا و عذرخواهی‌اش غافل می‌شود، دوباره به گمراهی و فریبکاری برمی‌گردد و دیگر حالتی از توبه و ندامت ندارد."],[839,"کلما هم اوقدوا نار الوغی","اطفاء الله نارهم حتی انطفا","هر بار که آن‌ها آتش جنگ را برافروختند، خداوند آتش آن‌ها را خاموش کرد تا اینکه خودشان از شدت خشم و شورشان خاموش شدند."],[839,"عزم کرده که دلا آنجا مه‌ایست","گشته ناسی زانک اهل عزم نیست","کسی که عزمی جزم کرده است، باید بداند که در آنجا، هدف او (در واقع، مه یا روشنایی) وجود دارد و گرنه، او از اهل عزم و اراده نیست."],[839,"چون نبودش تخم صدقی کاشته","حق برو نسیان آن بگماشته","چون او تخم صدق و راست‌گویی در دلش کاشته نشده، خداوند فراموشی را بر او نهاده است."],[839,"گرچه بر آتش‌زنه دل می‌زند","آن ستاره‌ش را کف حق می‌کشد","هرچند آن ستاره، که نماد چیزهای با ارزش است، بر قلب می‌تابد و به آن امید می‌دهد، اما در نهایت حقیقت و واقعیت را از خود دور می‌کند و کف و حبابی از حقیقت را از دست می‌دهد."],[840,"شرفه‌ای بشنید در شب معتمد","برگرفت آتش‌زنه که آتش زند","شرفه، که اصطلاحی برای نوعی برادر زاده یا پسر عموی کسی است، در شب به صدای معتمد (شخصی مورد اعتماد) گوش فرا داد و آتش‌زنه‌ای برداشت تا آتش روشن کند."],[840,"دزد آمد آن زمان پیشش نشست","چون گرفت آن سوخته می‌کرد پست","دزد در آن زمان نزد او نشسته بود و وقتی که آتش جوشید، آن را به سمت پایین می‌آورد و ضعیف می‌کرد."],[840,"می‌نهاد آنجا سر انگشت را","تا شود استاره آتش فنا","دزد انگشتش را بر آتش می‌گذارد تا شعله آن بیشتر و خطرناک‌تر شود."],[840,"خواجه می‌پنداشت کز خود می‌مرد","این نمی‌دید او که دزدش می‌کشد","خواجه فکر می‌کرد که آتش را خودش خاموش می‌کند و نمی‌دانست که دزد (آتش) او را می‌کشد."],[840,"خواجه گفت این سوخته نمناک بود","می‌مرد استاره از تریش زود","خواجه می‌گوید این سوخته (آتش‌زده) به خاطر نمناکی، به‌زودی خواهد مرد و از ترش، ریشش (از مو) می‌افتد."],[840,"بس که ظلمت بود و تاریکی ز پیش","می‌ندید آتش‌کشی را پیش خویش","چون ظلمت و تاریکی بسیار بود، او (کافر) نمی‌توانست آتش‌کشی را که پیش رویش بود ببیند."],[840,"این چنین آتش‌کشی اندر دلش","دیده کافر نبیند از عمش","این آتش‌کش، یعنی کسی که آتش می‌زند، نمی‌تواند از وجود خود چیز مثبتی ببیند و دل او مثل دل کافری است که نمی‌تواند حقیقت را درک کند."],[840,"چون نمی‌داند دل داننده‌ای","هست با گردنده گرداننده‌ای","دل نمی‌داند که یک دانای حقیقی وجود دارد که همه چیز را گردانده و در حال چرخش است."],[840,"چون نمی‌گویی که روز و شب به خود","بی‌خداوندی کی آید کی رود","تو نمی‌گویی که روز و شب بدون وجود خداوندی به چه حال می‌گذرد و چه زمانی می‌آید و چه زمانی می‌رود."],[840,"گرد معقولات می‌گردی ببین","این چنین بی‌عقلی خود ای مهین","در میان مفاهیم منطقی و فکری در حال چرخش هستی، اما باید ببینی که این بی‌خردی تو چقدر عمیق است، ای بزرگوار."],[840,"خانه با بنا بود معقول‌تر","یا که بی‌بنا بگو ای کم‌هنر","وجود خانه با ساخت و سازش منطقی‌تر است یا اینکه بدون سازنده وجود داشته باشد؟ بگو، ای کسی که هنر و دانش کمتری داری."],[840,"خط با کاتب بود معقول‌تر","یا که بی‌کاتب بیندیش ای پسر","نوشتن خط و خوشنویسی با وجود کاتب بهتر و معقول‌تر است یا بدون کاتب؟ ای پسر، به این موضوع خوب فکر کن."],[840,"جیم گوش و عین چشم و میم فم","چون بود بی‌کاتبی ای متهم","حروف «ج» و «ع» و «م» نماد گوش و چشم و دهان هستند. چه فایده‌ای دارد که این اعضا بدون آنکه کسی آنها را مدیریت کند (کاتب باشد) در کار باشد، ای متهم؟"],[840,"شمع روشن بی‌ز گیراننده‌ای","یا بگیراننده داننده‌ای","شمعی که روشن است، بدون آنکه کسی آن را روشن کند، وجود ندارد؛ یا اینکه ممکن است عقل و دانش شخصی، باعث روشنایی‌اش شده باشد."],[840,"صنعت خوب از کف شل ضریر","باشد اولی یا بگیرایی بصیر","صنعت و هنر خوب از دست کسی که ناتوان و کور است بیرون نمی‌آید، بلکه تنها از دست کسی که بیناست و قدرت دارد، حاصل می‌شود."],[840,"پس چو دانستی که قهرت می‌کند","بر سرت دبوس محنت می‌زند","پس وقتی فهمیدی که خشم و قهر تو به ضرر خودت تمام می‌شود، غم و سختی زندگی به تو ضربه می‌زند."],[840,"پس بکن دفعش چو نمرودی به جنگ","سوی او کش در هوا تیری خدنگ","پس مانند نمرود که با ابراهیم به جنگ رفت، باید در برابر او (مشکلات یا دشمنان) قهر و مقاومت کنی و تیری مانند خدنگ (تیر بلند) به سمت او پرتاب کنی."],[840,"هم‌چو اسپاه مغل بر آسمان","تیر می‌انداز دفع نزع جان","نفس و شهوات را باید مانند تیرهایی به سمت آسمان پرتاب کرد، همان‌طور که سپاه مغول به دشمنان خود تیر می‌زدند، تا از بین بروند و جان را از دست نزع (ضعف و بیماری) نجات دهیم."],[840,"یا گریز از وی اگر توانی برو","چون روی چون در کف اویی گرو","اگر می‌توانی از او فرار کن، زیرا زمانی که به او روی می‌آوری، در حقیقت در کف او گرفتار شده‌ای."],[840,"در عدم بودی نرستی از کفش","از کف او چون رهی ای دست‌خوش","تو در وجود و عدم، به راحتی از چنگ او نخواهی رست و اگر در دام او افتاده‌ای، چاره‌ای جز پذیرش ندارید."],[840,"آرزو جستن بود بگریختن","پیش عدلش خون تقوی ریختن","آرزو کردن به معنای فرار از عدالت او است و در برابر این خواسته، خون تقوای شخص باید ریخته شود. وقتی کسی به آرزوها توجه می‌کند، از عدالت الهی دور می‌شود و این تقوا و جوانمردی او فدای آن آرزو می‌شود."],[840,"این جهان دامست و دانه‌آرزو","در گریز از دامها روی آر زو","این جهان مانند دام است و آرزوها همچون دانه‌هایی که در این دام افتاده‌اند. باید از دام‌ها فرار کرد و به سمت آرزوها رفت."],[840,"چون چنین رفتی بدیدی صد گشاد","چون شدی در ضد آن دیدی فساد","وقتی که با این دیدگاه به پیش رفتی، صدها گشایش و انبساط را مشاهده کردی، اما زمانی که در نقطه مقابل آن قرار گرفتی، فساد و نابسامانی را دیدی."],[840,"پس پیمبر گفت استفتوا القلوب","گرچه مفتیتان برون گوید خطوب","پیامبر فرمود: از دل‌ها سوال کنید و نظرات آن‌ها را بشنومید، حتی اگر مفتی‌ها (فقه‌دانان) بیرون بگویند که رویدادها چگونه هستند."],[840,"آرزو بگذار تا رحم آیدش","آزمودی که چنین می‌بایدش","آرزو را فراموش کن تا بر او رحم شود، زیرا شخصی که در چنین وضعیت دشواری قرار دارد، باید چنین حالتی را تجربه کند."],[840,"چون نتانی جست پس خدمت کنش","تا روی از حبس او در گلشنش","اگر نمی‌توانی چیزی از او بگیری، پس بهتر است به او خدمت کنی تا او را از حبس و گرفتاریش رها کنی و به خوشی و شادی برگردانی."],[840,"دم به دم چون تو مراقب می‌شوی","داد می‌بینی و داور ای غوی","هر لحظه که تو مراقب و هشیار می‌شوی، حقایق و واقعیت‌ها را بهتر مشاهده می‌کنی و به قضاوتی درست دست می‌یابی، ای انسان هوشیار."],[840,"ور ببندی چشم خود را ز احتجاب","کار خود را کی گذارد آفتاب","اگر چشمت را در برابر حجاب ببندی، چگونه می‌توانی کار خود را به آفتاب بسپاری و از نور و روشنایی آن بهره‌مند شوی؟"],[841,"چون امیران از حسد جوشان شدند","عاقبت بر شاه خود طعنه زدند","زمانی که امیران به خاطر حسادت بسیار ناراحت و خشمگین شدند، نهایتا به شاه خود طعنه و کنایه زدند."],[841,"کین ایاز تو ندارد سی خرد","جامگی سی امیر او چون خورد","ایاز (خدمتکار و دوست نزدیک شاه) از کسی مانند این سی امیر که دارای خرد و عقل زیادند، خیر و فضیلت ندارد، چرا که آن‌ها از حسد و کین توزیشان را می‌خورند و به خاطر حسادت نسبت به ایاز، نمی‌توانند او را برتر از خود بدانند."],[841,"شاه بیرون رفت با آن سی امیر","سوی صحرا و کهستان صیدگیر","شاه با سی امیر به سوی صحرا و کوه‌ها رفت تا به شکار برود."],[841,"کاروانی دید از دور آن ملک","گفت امیری را برو ای مؤتفک","ملک (شاه) از دور کاروانی را دید و به یکی از امیران گفت: ای کسی که به خود می‌بالید، برو و با این کاروان صحبت کن."],[841,"رو بپرس آن کاروان را بر رصد","کز کدامین شهر اندر می‌رسد","به آن کاروان نزدیک برو و بپرس که از کدام شهر به اینجا می‌رسند."],[841,"رفت و پرسید و بیامد که ز ری","گفت عزمش تا کجا درماند وی","رفت و پرسید و برگشت و گفت که از شهر ری به کجا می‌رود و در کجا متوقف شده است."],[841,"دیگری را گفت رو ای بوالعلا","باز پرس از کاروان که تا کجا","مولانا به شخص دیگری می‌گوید که بجنبد و از بوالعلا (به معنای بزرگ‌مرد یا شخص محترم) بخواهد از کاروان بپرسد که مقصدشان کجا است."],[841,"رفت و آمد گفت تا سوی یمن","گفت رختش چیست هان ای موتمن","به کاروانی که در راه یمن می‌رود، می‌گوید که از موتمن (نفر معتمد یا مسئول) بپرسد که این فرد (که او به آن اشاره دارد) چه لباسی دارد."],[841,"ماند حیران گفت با میری دگر","که برو وا پرس رخت آن نفر","او متعجب ماند و به یکی از امیران دیگر گفت که به آن فرد (معروض) برود و از او درباره آثاری که از او به جا مانده، بپرسد."],[841,"باز آمد گفت از هر جنس هست","اغلب آن کاسه‌های رازیست","او (امیر) به بازگشت و گفت که از هر گروه و طبقه، بیشتر آن کاسه‌ها از راز و حقیقت خبر می‌دهند."],[841,"گفت کی بیرون شدند از شهر ری","ماند حیران آن امیر سست پی","امیر سست‌پی، وقتی که از شهر ری بیرون رفتند، حیران و سرگردان ماند."],[841,"هم‌چنین تا سی امیر و بیشتر","سست‌رای و ناقص اندر کر و فر","در این بیت گفته شده است که تا سی امیر و حتی بیشتر، افرادی ضعیف‌الایمان و ناتوان در فکر و تصمیم‌گیری در کارها هستند و در حقیقت، در برخورد با امور مهم ناتوانند."],[841,"گفت امیران را که من روزی جدا","امتحان کردم ایاز خویش را","امیران را به یاد می‌آورم که من روزی ایاز را به طور جداگانه امتحان کردم."],[841,"که بپرس از کاروان تا از کجاست","او برفت این جمله وا پرسید راست","بپرس از کاروان که او (ایاز) از کجا رفته است؛ او این سؤال را به‌دقت و به‌درستی مطرح کرد."],[841,"بی‌وصیت بی‌اشارت یک به یک","حالشان دریافت بی ریبی و شک","بدون اینکه وصیت و نشانه‌ای از آن‌ها باشد، حال آن‌ها را یکی‌یکی بدون هیچ تردید و شکی فهمید."],[841,"هر چه زین سی میر اندر سی مقام","کشف شد زو آن به یکدم شد تمام","هر چه در این دنیا از مقام‌های بالای سی (سیاه) به وجود آمد، در یک لحظه و به طور کامل آشکار شد."],[842,"پس بگفتند آن امیران کین فنیست","از عنایتهاش کار جهد نیست","امیران گفتند که این هنر و زیبایی از لطف و عنایت خاص خداوند است و تلاش و کوشش انسان در این‌باره تأثیری ندارد."],[842,"قسمت حقست مه را روی نغز","داده بختست گل را بوی نغز","مه (ماه) و گل از زیبایی‌های طبیعی هستند که به دلیل لطف خداوند به ما هدیه داده شده‌اند. زیبایی روی ماه و بوی خوش گل نشان‌دهنده نعمت‌های الهی و شگفتی‌های آفرینش است."],[842,"گفت سلطان بلک آنچ از نفس زاد","ریع تقصیرست و دخل اجتهاد","سلطان گفت که آنچه از نفس انسان به وجود می‌آید، خطا و تقصیر است و در واقع، این اشتباهات ناشی از تلاش و اجتهاد خود فرد است."],[842,"ورنه آدم کی بگفتی با خدا","ربنا انا ظلمنا نفسنا","اگر انسان از خود بگوید که ما به خود ظلم کرده‌ایم، پس خداوند چه می‌تواند بگوید؟ زیرا در اینجا به گناه خودش اعتراف کرده و از آن شکایت دارد."],[842,"خود بگفتی کین گناه از نفس بود","چون قضا این بود حزم ما چه سود","تو خود گفتی که این گناه از نفس خود انسان است و چون چنین بخت و قضا این‌گونه رقم خورده، پس احتیاط و دقت ما چه فایده‌ای دارد؟"],[842,"هم‌چو ابلیسی که گفت اغویتنی","تو شکستی جام و ما را می‌زنی","چنان‌که ابلیس گفت «تو مرا گمراه کردی»، تو هم بهانه‌گیر می‌شوی و مسئولیت اشتباهات خود را بر دوش دیگران می‌گذاری."],[842,"بل قضا حقست و جهد بنده حق","هین مباش اعور چو ابلیس خلق","بلکه این قضا و سرنوشت، حقیقی است و کوشش بندگان حق هم همینطور. پس نباید مانند ابلیس، که یک چشمش معیوب بود، بهانه‌جویی کنی و از واقعیت فرار کنی."],[842,"در تردد مانده‌ایم اندر دو کار","این تردد کی بود بی‌اختیار","ما در میان دو انتخاب هستیم و به حالت تردید گرفتار شده‌ایم. این تردید، نشانه‌ای از بی‌اختیاری ماست."],[842,"این کنم یا آن کنم او کی گود","که دو دست و پای او بسته بود","من نمی‌دانم که چه کاری انجام دهم، زیرا من همچون کسی هستم که دست و پایش بسته شده است و نمی‌تواند تصمیم بگیرد."],[842,"هیچ باشد این تردد بر سرم","که روم در بحر یا بالا پرم","این تردید و شک در من مانع از تصمیم گیری درست می‌شود، گویی که من در دریا غرق شده‌ام یا به سمت بالای آسمان پرواز می‌کنم."],[842,"این تردد هست که موصل روم","یا برای سحر تا بابل روم","این سرگردانی من بین موصل و روم یا برای سفر به سحر و بابل نشان‌دهنده عدم ثبات و ناپایداری در تصمیمات و هدف‌هایم است."],[842,"پس تردد را بباید قدرتی","ورنه آن خنده بود بر سبلتی","برای وجود تردید و ترفند در مسائل، باید نیرویی وجود داشته باشد؛ در غیر این صورت، آن فقط یک شوخی و مسخره‌جی خواهد بود."],[842,"بر قضا کم نه بهانه ای جوان","جرم خود را چون نهی بر دیگران","هر چند تقدیر و سرنوشت (قضا) ممکن است مانع از آزادی عمل باشد، اما جوانان نباید به دنبال بهانه برای توجیه خطاهای خود باشند و باید در مورد اشتباهاتشان مسئولیت‌پذیر باشند، چون نمی‌توانند دیگران را به خاطر همان اشتباهات سرزنش کنند."],[842,"خون کند زید و قصاص او به عمر","می خورد عمرو و بر احمد حد خمر","زید به خاطر جرمی که مرتکب شده است، خونش ریخته می‌شود و عمر به عنوان مجازات، به جای او ناظر بر این عمل است، در حالی که عمرو نیز به دلیل ارتباطش با احمد، حاضر به تحمل عذاب الهی ناشی از خوردن خمر (شراب) می‌باشد. در واقع، هر کس به نوعی عواقب اعمال دیگران را متحمل می‌شود."],[842,"گرد خود برگرد و جرم خود ببین","جنبش از خود بین و از سایه مبین","به دور خود بچرخ و به کارهای خود دقت کن، حرکات و اعمال خود را مشاهده کن و تنها به ظواهر و سایه‌های دیگران توجه نکن."],[842,"که نخواهد شد غلط پاداش میر","خصم را می‌داند آن میر بصیر","پاداش‌ نادرست کسی که همیشه در حال خصومت است، هرگز درست نخواهد شد و آن کسی که بصیر (بینش و بصیرت دارد) این را به خوبی می‌داند."],[842,"چون عسل خوردی نیامد تب به غیر","مزد روز تو نیامد شب به غیر","اگر عسل خوردی و طعم خوش آن را چشیدی، نتیجه‌اش این است که بیماری و تب به سراغت نمی‌آید و در روز و شب تنها برای مزد و پاداشی که در انتظارش هستی، حاضری."],[842,"در چه کردی جهد کان وا تو نگشت","تو چه کاریدی که نامد ریع کشت","در چه تلاشی بوده‌ای که تو را برنده نساخته و چه کاری کرده‌ای که نتیجه‌ای از آن به دست نیاورده‌ای؟"],[842,"فعل تو که زاید از جان و تنت","هم‌چو فرزندت بگیرد دامنت","اعمال تو که از وجود و وجودت سرچشمه می‌گیرد، مانند فرزندی است که از دامان تو برمی‌خیزد و به وجود می‌آید."],[842,"فعل را در غیب صورت می‌کنند","فعل دزدی را نه داری می‌زنند","کارها و رفتارها در عالم غیب شکل می‌گیرند، مانند دزدی که به ظاهر کسی آن را انجام نمی‌دهد و هیچ فردی به سرقت متهم نمی‌شود."],[842,"دار کی ماند به دزدی لیک آن","هست تصویر خدای غیب‌دان","دزدی در واقع باقی نمی‌ماند، اما چیزی که باقی می‌ماند، تنها تصویر و نمایی از علم خداوندی است که به غیب آگاهی دارد."],[842,"در دل شحنه چو حق الهام داد","که چنین صورت بساز از بهر داد","وقتی که خداوند در دل مأمور (شحنه) الهام می‌کند، او را وامی‌دارد که چنین صورتی (یا ظاهری) برای احقاق حق و اجرای عدالت ایجاد کند."],[842,"تا تو عالم باشی و عادل قضا","نامناسب چون دهد داد و سزا","تا وقتی تو دانشمند و عادل هستی، اینجا چه‌طور می‌شود که قضا و قدر، حکم ناعادلانه و نامناسبی صادر کند؟"],[842,"چونک حاکم این کند اندر گزین","چون کند حکم احکم این حاکمین","اگر حاکم در انتخاب و گزینش مردم خوب عمل نکند، چگونه می‌تواند حکم را به درستی اجرا کند؟ این موضوع نشان‌دهنده اهمیت انتخاب صحیح و صلاحیت حاکمین در اعمال قانون است."],[842,"چون بکاری جو نروید غیر جو","قرض تو کردی ز که خواهد گرو","اگر در زمین خود جو بکاری، جز جو نمی‌روید. اگر در این کار به کسب و قرض پرداخته‌ای، باید برگرداننده‌ی آن باشی و به کسی دیگر ارتباطی ندارد."],[842,"جرم خود را بر کسی دیگر منه","هوش و گوش خود بدین پاداش ده","به جای آنکه تقصیر و اشتباهات خود را به گردن دیگران بیندازی، باید به خودت توجه کنی و از درک و فهم درست موقعیت، پاداش بگیری."],[842,"جرم بر خود نه که تو خود کاشتی","با جزا و عدل حق کن آشتی","عمل بدی که انجام دادی را به دیگران نسبت نده، زیرا خود تو باعث آن شده‌ای؛ حالا با پاداش و عدالت حق همراه شو و با آن آشتی کن."],[842,"رنج را باشد سبب بد کردنی","بد ز فعل خود شناس از بخت نی","رنج و سختی‌ها نتیجه کارهای بد انسان است، نه اینکه از سرنوشت و بخت او ناشی شود. لذا باید خود را به خاطر رفتار و کردار خویش محاسبه کند."],[842,"آن نظر در بخت چشم احول کند","کلب را کهدانی و کاهل کند","کسی که به سرنوشت و بخت خود با چشمی نادرست و احول (کج‌نظر) نگاه می‌کند، به مانند سگی می‌شود که بی‌تحرک و سست است و از درک واقعیت ناتوان است."],[842,"متهم کن نفس خود را ای فتی","متهم کم کن جزای عدل را","ای جوان، خود را به حالت اتهام ببین و تقصیرهای خود را بپذیر، نه اینکه دیگران را متهم کنی. با این کار، عواقب و مجازات‌های عادلانه را برای خود کاهش دهی."],[842,"توبه کن مردانه سر آور به ره","که فمن یعمل بمثقال یره","توبه کن و با اراده و عزم راسخ به راه نیک برگرد، زیرا هر کسی که عمل کوچک و بزرگی انجام دهد، حتما نتیجه آن را خواهد دید."],[842,"در فسون نفس کم شو غره‌ای","که آفتاب حق نپوشد ذره‌ای","از فریب نفس خود دور شو و به خود مغرور نگرد، زیرا نور حقیقت (آفتاب حق) هیچ ذره‌ای را نمی‌تواند بپوشاند و همه چیز در برابر آن آشکار است."],[842,"هست این ذرات جسمی ای مفید","پیش این خورشید جسمانی پدید","این ذرات جسمانی که مفید هستند، در حقیقت پیش این خورشید جسمانی (آفتاب) ظاهر می‌شوند."],[842,"هست ذرات خواطر و افتکار","پیش خورشید حقایق آشکار","ذراتی که در اینجا به آن اشاره شده، افکار و اندیشه‌ها هستند که پیش روی حقیقت‌های روشن و واضح قرار دارند. همان‌طور که خورشید جسمانی نور و روشنایی می‌دهد، حقیقت نیز روشنگر ذهن‌ها و افکار است."],[843,"رفت مرغی در میان مرغزار","بود آنجا دام از بهر شکار","مرغی به میان مرتع و علف‌های بلند رفت، در حالی که صیاد آنجا نشسته بود تا طعمه‌اش را به دام بیندازد."],[843,"دانه چندی نهاده بر زمین","وآن صیاد آنجا نشسته در کمین","صیاد تعدادی دانه بر روی زمین ریخته و در همان‌جا منتظر نشسته تا پرنده‌ها به دامش بیفتند."],[843,"خویشتن پیچیده در برگ و گیاه","تا در افتد صید بیچاره ز راه","صیاد خود را در زیر برگ و گیاه پنهان کرده تا صید بیچاره‌ای به دامش بیفتد."],[843,"مرغک آمد سوی او از ناشناخت","پس طوافی کرد و پیش مرد تاخت","پرنده‌ای به سوی او آمد، زیرا او را نمی‌شناخت. سپس دور او چرخید و به سمت مرد پرواز کرد."],[843,"گفت او را کیستی تو سبزپوش","در بیابان در میان این وحوش","آن مرغ با دقت به جاندار سبزپوشی که در بیابان و در میان جانوران دیگر قرار دارد، می‌گوید: تو کیستی؟"],[843,"گفت مرد زاهدم من منقطع","با گیاهی گشتم اینجا مقتنع","مرد زاهد می‌گوید: من از دنیا فاصله گرفته‌ام و اکنون در کنار این گیاه راضی و خشنود هستم."],[843,"زهد و تقوی را گزیدم دین و کیش","زانک می‌دیدم اجل را پیش خویش","زهد و تقوا را برگزیده‌ام و به همین دلیل است که مرگ را همیشه در برابر خود مشاهده می‌کنم."],[843,"مرگ همسایه مرا واعظ شده","کسب و دکان مرا برهم زده","مرگ همسایه‌ام باعث شده که من بیشتر به دین و نصیحت گوش دهم و کار و زندگی‌ام را تحت تأثیر قرار داده است."],[843,"چون به آخر فرد خواهم ماندن","خو نباید کرد با هر مرد و زن","در پایان عمر، نمی‌توان با هر کسی و به هر طریقی ارتباط برقرار کرد و باید انسان را با دقت انتخاب کرد تا در زندگی بلا و ضرر نرساند."],[843,"رو بخواهم کرد آخر در لحد","آن به آید که کنم خو با احد","وقتی که به آخر عمرم نزدیک می‌شوم و در قبر می‌روم، خواه ناخواه باید با کسی که در آنجا هست، یعنی خودم، روبه‌رو شوم و به آرامش برسم."],[843,"چو زنخ را بست خواهند ای صنم","آن به آید که زنخ کمتر زنم","وقتی که به زلف کسی گره می‌زنند، ای عشق زیبا، آن زمان است که کمتر به زلف خود تکیه خواهم کرد."],[843,"ای بزربفت و کمر آموخته","آخرستت جامه نادوخته","تو که خود را در لباس و زرق و برق آراسته‌ای، اما در واقع چیزی به جز ظاهری نداشته و درونت خالی و بی‌محتواست."],[843,"رو به خاک آریم کز وی رسته‌ایم","دل چرا در بی‌وفایان بسته‌ایم","ما از خاک به وجود آمده‌ایم و باید به سوی خاک برگردیم، اما چرا دل‌مان را به افرادی که وفادار نیستند، گره زده‌ایم؟"],[843,"جد و خویشانمان قدیمی چار طبع","ما به خویشی عاریت بستیم طمع","ما به عنوان انسان‌ها از نیاکان و اجدادمان ویژگی‌هایی به نام چهار طبع (خوشی، تلخی، گرمى و سردى) به ارث برده‌ایم، اما برای رسیدن به خواسته‌هایمان از این خویشاوندی‌ها سوء استفاده کرده و طمع ورزیده‌ایم."],[843,"سالها هم‌صحبتی و هم‌دمی","با عناصر داشت جسم آدمی","مدت‌ها انسان با عناصر مختلف طبیعت مانند خاک، آب، باد و آتش همراه بوده و در کنار آن‌ها زندگی کرده است. این ارتباط نزدیک به زندگی و وجود جسم انسان اشاره دارد."],[843,"روح او خود از نفوس و از عقول","روح اصول خویش را کرده نکول","روح او از نفس‌ها و عقل‌ها به دست آمده، اما خود را از اصول و ریشه‌های درونی‌اش جدا کرده و به آنها پشت کرده است."],[843,"از عقول و از نفوس پر صفا","نامه می‌آید به جان کای بی‌وفا","از افکار و روح‌های پاک، پیامی به جان می‌رسد، چون تو ای بی‌وفا، به وفا و صداقت پایبند نیستی."],[843,"یارکان پنج روزه یافتی","رو ز یاران کهن بر تافتی","دوستان قدیمی و واقعی را که به مدت طولانی با آن‌ها بودی، رها کردی و به دوستانی که فقط چند روز با آن‌ها هستی، توجه کردی."],[843,"کودکان گرچه که در بازی خوشند","شب کشانشان سوی خانه می‌کشند","کودکان هرچند در بازی کردن و سرگرمی شاد و خوشحال هستند، اما شب هنگام، به اجبار باید به خانه بازگردند."],[843,"شد برهنه وقت بازی طفل خرد","دزد از ناگه قبا و کفش برد","کودک خردسال در هنگام بازی ناگهان برهنه شد، زیرا دزدی به‌طور ناگهانی پوشاک و کفش او را برد."],[843,"آن چنان گرم او به بازی در فتاد","کان کلاه و پیرهن رفتش ز یاد","چنان مشغول بازی شد که فراموش کرد کلاه و لباسش را از دست داده است."],[843,"شد شب و بازی او شد بی‌مدد","رو ندارد کو سوی خانه رود","شب فرا رسید و او بدون کمک کسی نمی‌تواند به خانه‌اش برگردد."],[843,"نی شنیدی انما الدنیا لعب","باد دادی رخت و گشتی مرتعب","دنیا فقط یک بازی است، تو به خاطر آن لباس را بر تن کردی و به شدت ترسید‌ه‌ای."],[843,"پیش از آنک شب شود جامه بجو","روز را ضایع مکن در گفت و گو","قبل از آنکه شب فرا برسد، به دنبال لباس و امکان‌ها و فرصت‌های روز باش و روز را در صحبت و بحث هدر نده."],[843,"من به صحرا خلوتی بگزیده‌ام","خلق را من دزد جامه دیده‌ام","من در دشت مکانی خلوت برای خود انتخاب کرده‌ام و به همین دلیل، مردم را به عنوان دزدی که پوشش آنها را دیده، تصور می‌کنم."],[843,"نیم عمر از آرزوی دلستان","نیم عمر از غصه‌های دشمنان","نیمه‌ای از عمرم را در آرزوی رسیدن به معشوق گذرانده‌ام و نیمه دیگرش را در غصه و اندوه به خاطر دشمنانم."],[843,"جبه را برد آن کله را این ببرد","غرق بازی گشته ما چون طفل خرد","دست‌نیافتن به مراد و غرق شدن در بازی‌های دنیا، انسان را مانند کودکی ناپخته و ناتوان می‌کند، در حالی که عقل و هوش او باید در پیشبرد اهدافش به کار گرفته شود."],[843,"نک شبانگاه اجل نزدیک شد","خلّ هذا اللّعب بسّک لاتعد","شبانه، زمان مرگ نزدیک شده است، پس این بازی و سرگرمی را کنار بگذار و به خودت بیا."],[843,"هین سوار توبه شو در دزد رس","جامه‌ها از دزد بستان باز پس","ای کسی که در توبه نشسته‌ای، تو هم‌اکنون سوار توبه شو و از دزد، جامه‌های خود را پس بگیر. زندگی‌ات را از هر چیزی که دزدیده شده، یعنی از گناهان و معاصی، برمگردان."],[843,"مرکب توبه عجایب مرکب است","بر فلک تازد به یک لحظه ز پست","توبه، همچون وسیله‌ای شگفت‌انگیز است که می‌تواند انسان را به آسمان‌ها ببرد و در یک لحظه او را از وضعیت پست و پایین به جایگاهی بلند و عالی برساند."],[843,"لیک مرکب را نگه می‌دار از آن","کو بدزدید آن قبایت را نهان","ولی باید مراقب مرکب (توبه) خود باشی، زیرا کسی که قبای (لباس) تو را پنهانی دزدیده، ممکن است مرکب (توبه) تو را نیز بدزدد."],[843,"تا ندزدد مرکبت را نیز هم","پاس دار این مرکبت را دم به دم","برای اینکه مرکبت را دوباره دزدیده نشود، باید هر لحظه از آن مراقبت کنی."],[844,"آن یکی قج داشت از پس می‌کشید","دزد قج را برد حبلش را برید","شخصی که دزد را تعقیب می‌کرد، به او نزدیک شد، اما دزد با بریدن طنابی که او را به خود متصل کرده بود، از دستش فرار کرد."],[844,"چونک آگه شد دوان شد چپ و راست","تا بیابد کان قج برده کجاست","وقتی آن شخص متوجه شد که دزد قج (دزد محلی) فرار کرده است، به سرعت به چپ و راست دوید تا مکان دزدی را پیدا کند."],[844,"بر سر چاهی بدید آن دزد را","که فغان می‌کرد کای واویلتا","دزد را در نزد چاه دید که با صدای بلندی ناله و فریاد می‌زند و واویلا می‌گوید."],[844,"گفت نالان از چئی ای اوستاد","گفت همیان زرم در چه فتاد","شخصی که در حال ناله و شکایت است، به استادش می‌گوید که چه شده که همیان (کیسه) پولش در چه وضعیتی قرار دارد."],[844,"گر توانی در روی بیرون کشی","خمس بدهم مر ترا با دلخوشی","اگر می‌توانی در ظاهر خود را بیرون بیاوری و خود را به شکلی بهبود ببخشی، من خمس (یک‌پنجم) این مال را به تو می‌دهم تا با شادی و خوشحالی زندگی کنی."],[844,"خمس صد دینار بستانی به دست","گفت او خود این بهای ده قجست","او گفت که اگر می‌خواهی خمس (یک‌پنجم) یعنی صد دینار را بگیری، بهتر است به دست بیاوری، چراکه این مقدار به‌راستی ارزشش فقط قیمت یک ده‌قجه است. (ده‌قجه ممکن است به معنا یا نوعی کالا یا سمتی اشاره کند.)"],[844,"گر دری بر بسته شد ده در گشاد","گر قجی شد حق عوض اشتر بداد","اگر یک در بسته شود، درهای دیگری باز می‌شوند؛ و اگر کسی دچار دزدی یا مشکل شود، خداوند عوض آن را به او می‌دهد."],[844,"جامه‌ها بر کند و اندر چاه رفت","جامه‌ها را برد هم آن دزد تفت","دزدی که لباس‌های او را به سرقت برده بود، آن لباس‌ها را در چاهی انداخت و خودش هم به آن چاه رفت."],[844,"حازمی باید که ره تا ده برد","حزم نبود طمع طاعون آورد","برای رسیدن به هدفی باید با احتیاط و تدبیر پیش رفت؛ در غیر این صورت، طمع و ناپسندکاری می‌تواند به عواقبی زیانبار شبیه طاعون منجر شود."],[844,"او یکی دزدست فتنه‌سیرتی","چون خیال او را بهر دم صورتی","یک دزد است که سرشار از فتنه و نیرنگ است و به‌همین دلیل در هر لحظه شکل و ظاهری متفاوت به خود می‌گیرد."],[844,"کس نداند مکر او الا خدا","در خدا بگریز و وا ره زان دغا","هیچ‌کس از تدبیر و فریب او آگاه نیست جز خدا. پس به خدا پناه ببر و از آن نیرنگ دوری کن."],[845,"مرغ گفتش خواجه در خلوت مه‌ایست","دین احمد را ترهب نیک نیست","مرغ به صیاد می‌گوید که دین احمد (محمد) در حالتی خلوص و دور از دنیا هم نمی‌طلبد، زیرا ترهب و گوشه‌نشینی با آن سازگار نیست."],[845,"از ترهب نهی کردست آن رسول","بدعتی چون در گرفتی ای فضول","پیامبر اسلام (مصطفی) از انزوای دینی و ترهب (زندگی زاهدانه و دوری از دنیا) نهی کرده است، زیرا این کار به عنوان یک بدعت شناخته می‌شود و تو (صیاد) که در این کار اصرار داری، فضول و بیهوده‌گویی می‌کنی."],[845,"جمعه شرطست و جماعت در نماز","امر معروف و ز منکر احتراز","جمعه، برگزاری نماز جماعت است و شرکت در آن واجب است. انجام کارهای نیک و پرهیز از کارهای زشت نیز از مسائل مهم در دین به حساب می‌آید."],[845,"رنج بدخویان کشیدن زیر صبر","منفعت دادن به خلقان هم‌چو ابر","تحمل رنج و سختی ناشی از بدرفتاری دیگران، در واقع سودمندی برای مردم و دیگران است، مشابه به نفعی که ابر با باریدن بر زمین می‌زند."],[845,"خیر ناس آن ینفع الناس ای پدر","گر نه سنگی چه حریفی با مدر","بهترین مردم کسی است که به دیگران نفع برساند، پدر عزیز، ورنه اگر سنگی باشی چه حریفی با گل؟ این بیت به اهمیت خدمت به دیگران و ارزش انسانیت اشاره دارد."],[845,"در میان امت مرحوم باش","سنت احمد مهل محکوم باش","در بین مسلمین، به پیروی از سنّت پیامبر اسلام، محمد (احمد) زندگی کن و از محکومیت و عذاب دوری گزین."],[845,"گفت عقل هر که را نبود رسوخ","پیش عاقل او چو سنگست و کلوخ","عقل کسی که در درک و فهم عمیق ندارد، مانند سنگ و خرده‌سنگ است و به هیچ دردی نمی‌خورد؛ بنابراین، او در نظر عاقل‌ها بی‌ارزش و بی‌استعداد به حساب می‌آید."],[845,"چون حمارست آنک نانش امنیتست","صحبت او عین رهبانیتست","کسی که در زندگی‌اش فقط به امنیت نان و معاشش فکر می‌کند، مانند الاغی است که با او در ارتباط هستی، و این نوع زندگی به نوعی زندگی راهبان را تداعی می‌کند."],[845,"زانک غیر حق همه گردد رفات","کل آت بعد حین فهو آت","چون غیر از حق چیز دیگری از بین می‌رود، همه چیز بعد از مدتی نابود می‌شود و تنها حقیقت باقی می‌ماند."],[845,"حکم او هم حکم قبله او بود","مرده‌اش خوان چونک مرده‌جو بود","حکم خدا تعیین‌کننده خانواده و نزدیکان فرد می‌باشد، بنابراین مرده‌ای که به خاطر او (یعنی مرده‌جو) به سراغش می‌رود، باید به او احترام گذاشته شود."],[845,"هر که با این قوم باشد راهبست","که کلوخ و سنگ او را صاحبست","هر کسی که با این مردم باشد، مانند زاهدی است که غم و غصه‌هایش را به دوش می‌کشد، چرا که در زندگی‌اش فقط کلوخ و سنگ (مشکلات و سختی‌ها) دارد و آنها (مشکلات) صاحب او هستند."],[845,"خود کلوخ و سنگ کس را ره نزد","زین کلوخان صد هزار آفت رسد","کسی که با کلوخ و سنگ (یعنی اشخاص بی‌ارزش و ناچیز) باشد، هیچ‌گاه به جایی نمی‌رسد و از این دنیای پرآفت، صدمات زیادی متوجه او خواهد شد."],[845,"گفت مرغش پس جهاد آنگه بود","کین چنین ره‌زن میان ره بود","مرغ در اینجا می‌گوید که اگر جهاد (پیکار در راه حق) باشد، آن‌گاه این شخص (صیاد) به عنوان یک راه‌زن در میان راه وجود دارد. یعنی وجود خطر در مسیر، دلیل بر ضرورت جهاد است."],[845,"از برای حفظ و یاری و نبرد","بر ره ناآمن آید شیرمرد","برای نجات و حمایت و جنگ در راهی که ناامن است، مرد نیرومندی مانند شیر به میدان می‌آید."],[845,"عرق مردی آنگهی پیدا شود","که مسافر همره اعدا شود","کریم زمانی: مثال دیگر، رگ مردانگی وقتی آشکار می شود که مسافر با دشمنان و راهزنان روبرو شود. [چون در دوران قدیم (بخصوص) در میان رهها، راهزنان و حرامیان کمین می کردند، قافله مسافران همیشه در معرض تهاجم آنان بود. مسافرانی بودند که به محض رؤیت راهزنان روحیه خود را بکلّی می‌باختند و دست و پایشان از هرگونه اقدام و حرکتی فلج می‌شد، و در عوض مسافرانی نیز بودند که با رشادت مقابل آنان می‌ایستادند و از خود دفاع می‌کردند. و بدین ترتیب دلاوری بالقوّه خود را به منصه ظهور و فعلیّت می‌رساندند."],[845,"چون نبی سیف بودست آن رسول","امت او صفدرانند و فحول","وقتی که پیامبر (محمد) سلاح (نیروی نظامی) بود، آن رسول (محمد) پیروانش را مردان برجسته و قدرتمند قرار داده است."],[845,"مصلحت در دین ما جنگ و شکوه","مصلحت در دین عیسی غار و کوه","در دین ما، مصلحت و خیر در جنگ و افتخار است، اما در دین عیسی، مصلحت در گوشه‌نشینی و زندگی در غار و کوه است."],[845,"گفت آری گر بود یاری و زور","تا به قوت بر زند بر شر و شور","گفت اگر یاری و قدرت باشد، می‌توان با توان به مقابله شر و فساد پرداخت."],[845,"چون نباشد قوتی پرهیز به","در فرار لا یطاق آسان بجه","اگر قدرتی برای پرهیز وجود نداشته باشد، بهتر است که انسان از ترس ناملازم و غیرقابل تحمل، به دوری و فرار بپردازد."],[845,"گفت صدق دل بباید کار را","ورنه یاران کم نیاید یار را","اگر در کارها و اعمال خود صداقت و راست‌گویی داشته باشی، یاران و دوستان واقعی به تو خواهند پیوست، وگرنه یاران و دوست‌ها پیدا نخواهند شد."],[845,"یار شو تا یار بینی بی‌عدد","زانک بی‌یاران بمانی بی‌مدد","تا زمانی که به دوستان و یاوران ملحق نشوی، نمی‌توانی تعداد بی‌شماری از یاران را ببینی؛ زیرا بدون کمک دیگران، در تلاش‌هایت موفق نخواهی شد."],[845,"دیو گرگست و تو هم‌چون یوسفی","دامن یعقوب مگذار ای صفی","دیو، نماد شیطان یا دشمنی است، و گرگ نیز به معنای خطر و تهدید است. تو مشابه یوسف، که به خاطر محبت پدرش یعقوب دامن او را رها نمی‌کند، نباید در برابر خطرات و وسوسه‌ها قرار بگیری، پس ای صفی (درّی)، از زحمات و دشواری‌ها دوری کن."],[845,"گرگ اغلب آنگهی گیرا بود","کز رمه شیشک به خود تنها رود","گرگ معمولا زمانی به دام می‌افتد که یکی از دام‌ها به دور از گروه خود و تنها شود."],[845,"آنک سنت یا جماعت ترک کرد","در چنین مسبع نه خون خویش خورد","کسی که در چنین میدان وسیع و گسترده‌ای سنت یا مسیر جمعی را رها کند، در واقع به خود آسیب می‌زند و آسیب‌های ناشی از جدایی را متحمل می‌شود."],[845,"هست سنت ره جماعت چون رفیق","بی‌ره و بی‌یار افتی در مضیق","اگر سنت و راه جماعت ترک شود، مانند کسی می‌مانی که بدون یار و همراه، در تنگنا و سختی افتاده‌ای."],[845,"همرهی نه کو بود خصم خرد","فرصتی جوید که جامه تو برد","هم‌راهی و رفاقت به سادگی حاصل نمی‌شود و اگر کسی دشمن عقل و خرد باشد، در هر فرصتی و بهانه‌ای سعی می‌کند تا از تو بهره‌برداری کرده و لباس وجودت را از تو بگیرد."],[845,"می‌رود با تو که یابد عقبه‌ای","که تواند کردت آنجا نهبه‌ای","فردی به خاطر نفعی که از تو می‌برد، با تو همراهی می‌کند تا به مکانی برسد که بتواند از آنجا برای تو ضرر و خسارت به وجود آورد."],[845,"یا بود اشتردلی چون دید ترس","گوید او بهر رجوع از راه درس","اگر شخصی که شجاعت نداشت، ترسید و از آنچه در برابرش می‌بیند، بترسد، باید به آن فرد گفت که به خاطر یادگیری و درس گرفتن از این تجربیات، بازگردد و از این وضعیت دوری کند."],[845,"یار را ترسان کند ز اشتردلی","این چنین همره عدو دان نه ولی","یار به اشتردل (شجاع) هراسان می‌شود، پس بدان که چنین شجاعتی همراه دشمن است نه با ولی (ولی‌الله یا دوست واقعی)."],[845,"راه جان‌بازیست و در هر غیشه‌ای","آفتی در دفع هر جان‌ شیشه‌ای","راهی که به جان‌فشانی و فداکاری می‌انجامد، در هر شرایطی خطراتی دارد و برای حفظ هر انسانی، باید مراقبت شود. منظور این است که زندگی همواره با چالش‌ها و آسیب‌ها همراه است و نیاز به احتیاط و توجه دارد."],[845,"راه دین زان رو پر از شور و شرست","که نه راه هر مخنث گوهرست","راه دین به همین دلیل پر از هیجان و اشفتگی است زیرا این راه برای افرادی نیست که از مردانگی و اصالت دور شده‌اند."],[845,"در ره این ترس امتحانهای نفوس","هم‌چو پرویزن به تمییز سبوس","در این مسیر معنوی، آزمایش‌های روحی مانند جدا کردن دانه‌های خوب (سبوس) از دانه‌های بی‌ارزش است و انسان باید توانایی تشخیص حقیقت را داشته باشد، همان‌طور که پرویز (پادشاه بزرگ ایرانی) در تشخیص کیفیت‌ها دقت می‌کند."],[845,"راه چه بود پر نشان پایها","یار چه بود نردبان رایها","راه سرشار از نشانه‌ها و نشانه‌های راهنمایی در زندگی چیست و یار و دوست چه نقشی در بالا رفتن و ترقی اندیشه‌ها دارد؟"],[845,"گیرم آن گرگت نیابد ز احتیاط","بی ز جمعیت نیابی آن نشاط","اگر آن گرگ (که نماد خطر یا دشمن است) نتواند به احتیاط و مراقبت نزدیک شود، بدون داشتن جمعیت و همراهی هیچ‌گاه آن نشاط و شادی را نخواهی یافت."],[845,"آنک تنها در رهی او خوش رود","با رفیقان سیر او صدتو شود","کسی که در مسیر تنهایی خوشحال می‌رود، با همراهانش نیز می‌تواند به خوشی و شادابی برسد."],[845,"با غلیظی خر ز یاران ای فقیر","در نشاط آید شود قوت‌پذیر","اگر تو ای فقیر، با خرهای غلیظ و سنگین بار از یاران و دوستان خود جدا شوی، با این حال برای تو شادی و نشاط می‌آید و قوت و توان تو افزایش می‌یابد."],[845,"هر خری کز کاروان تنها رود","بر وی آن راه از تعب صدتو شود","هر خر (مادیان) که از کاروان جدا و تنها برود، بر او زمینی سخت و پر از زحمت وارد می‌شود. به عبارت دیگر، تنهایی و دوری از جمع باعث مشکلات و رنج‌های بیشتری می‌شود."],[845,"چند سیخ و چند چوب افزون خورد","تا که تنها آن بیابان را برد","این بیت به این مفهوم اشاره دارد که شخصی که در سفر یا مسیر خاصی تنها می‌رود، ممکن است با مشکلات و خطرات بیشتری مواجه شود. او برای عبور از بیابانی که تنهاست به چوب و سیخ (ابزارهایی برای حمل و نقل یا دفاع) نیاز دارد، نشان‌دهنده این است که در تنهایی باید بیشتر مراقب بود و آمادگی داشت."],[845,"مر ترا می‌گوید آن خر خوش شنو","گر نه‌ای خر هم‌چنین تنها مرو","این بیت به معنای آن است که اگر تو مانند خر (حیوان بارکش) به تنهایی حرکت کنی، ممکن است دچار خطر شوی. به همین دلیل، باید از نصیحت‌های دیگران، حتی اگر آنها را با صفت \"خر\" به کار ببرند، توجه کنی و به تنهایی نروی."],[845,"آنک تنها خوش رود اندر رصد","با رفیقان بی‌گمان خوشتر رود","کسی که تنها به جست و جوی هدف می‌رود، با دوستان همراهش برای رسیدن به مقصود، واقعا راحت‌تر و بهتر پیش خواهد رفت."],[845,"هر نبیی اندرین راه درست","معجزه بنمود و همراهان بجست","هر پیامبری در مسیر صحیح، معجزه‌ای از خود نشان داده و یارانش را جذب کرده است."],[845,"گر نباشد یاری دیوارها","کی برآید خانه و انبارها","اگر دیوارها وجود نداشته باشند، هیچ‌گاه خانه و انبارها نمی‌توانند برپا شوند."],[845,"هر یکی دیوار اگر باشد جدا","سقف چون باشد معلق در هوا","هر یک دیوار اگر جدا از هم باشد، سقف چگونه می‌تواند در هوا بماند و پایدار باشد؟"],[845,"گر نباشد یاری حبر و قلم","کی فتد بر روی کاغذها رقم","اگر یاری قلم و نویسنده نباشد، چگونه می‌شود که چیزی بر روی کاغذ نوشته شود؟"],[845,"این حصیری که کسی می‌گسترد","گر نپیوندد به هم بادش برد","اگر شخصی در کارش یا همه‌چیز در زندگی‌اش به هم نپیوندد و انسجام نداشته باشد، آسیب‌پذیر می‌شود و به راحتی از بین می‌رود."],[845,"حق ز هر جنسی چو زوجین آفرید","پس نتایج شد ز جمعیت پدید","خداوند از هر نوع جنسیتی، جفتی آفریده و به همین دلیل نتایج و ثمرات مختلفی از ترکیب این جفت‌ها پدید آمده است."],[845,"او بگفت و او بگفت از اهتزاز","بحثشان شد اندرین معنی دراز","در این بیت، گفتگو و تبادل نظر دو طرف (که مشخص نیستند) درباره یک موضوع مهم و پیچیده به صورت مشروح و طولانی ادامه دارد. اهتزاز به معنای حرکت و جنب و جوش است، بنابراین بحث آن‌ها به طور جدی و با جدیت دنبال می‌شود."],[845,"مثنوی را چابک و دلخواه کن","ماجرا را موجز و کوتاه کن","شعر می‌گوید که مثنوی را مختصر و دلنشین کن و داستان را به صورت خلاصه و کوتاه بیان کن."],[845,"بعد از آن گفتش که گندم آن کیست","گفت امانت از یتیم بی وصیست","مرغ از صیاد می‌پرسد که گندم متعلق به چه کسی است و صیاد جواب می‌دهد که این گندم امانتی است که متعلق به یتیم بی‌وصی (بی‌سرپرست) است."],[845,"مال ایتام است امانت پیش من","زانک پندارند ما را مؤتمن","مال یتیمان امانتی است که در دست من است، زیرا مردم بر این باورند که من امین و مورد اعتماد هستم."],[845,"گفت من مضطرم و مجروح‌حال","هست مردار این زمان بر من حلال","او می‌گوید که در این زمان که به شدت نیازمند و آسیب‌دیده‌ام، خوردن مردار (خوراک حرام) بر من جایز است."],[845,"هین به دستوری ازین گندم خورم","ای امین و پارسا و محترم","با اجازه تو، به دلیل حالتی که در آن دچار اضطرار و نیازمندی است، از تو می‌خواهم که به من اجازه دهی گندم بخورم، ای فرد امین، پارسا و محترم."],[845,"گفت مفتی ضرورت هم توی","بی‌ضرورت گر خوری مجرم شوی","مفتی (فقیه) می‌گوید اگر ضرورت وجود دارد، تو نیز باید از آن بهره بگیری؛ ولی اگر نیازی نیست و تو بخوری، مجرم خواهی شد."],[845,"ور ضرورت هست هم پرهیز به","ور خوری باری ضمان آن بده","اگر هم در شرایط ضروری قرار داری، باز هم باید از خوردن پرهیز کنی، زیرا در غیر این صورت مسئولیت و ضمانت آن با تو خواهد بود."],[845,"مرغ پس در خود فرو رفت آن زمان","توسنش سر بستد از جذب عنان","مرغ در آن لحظه به درون خود فرو رفت و متوجه شد که اسبش (توسن) از جاذبه کنترل خارج شده است."],[845,"چون بخورد آن گندم اندر فخ بماند","چند او یاسین و الانعام خواند","وقتی آن مرغ از دانه گندم که در دام صیاد بود، تغذیه کرد، دیگر در تنگنای آن دام درجا ماند و این‌گونه آیات «یاسین» و «الانعام» را خواند (که به خاطر این حالت و پریشانی‌اش، نمی‌تواند از دام رهایی یابد)."],[845,"بعد در ماندن چه افسوس و چه آه","پیش از آن بایست این دود سیاه","انسان در زمانی که در حسرت و افسوس به سر می‌برد، باید به فکر پیشگیری از مشکلات و بلایای آینده باشد، نه اینکه بعد از وقوع آنها فقط آه و افسوس بکشد."],[845,"آن زمان که حرص جنبید و هوس","آن زمان می‌گو کای فریادرس","در زمانی که حرص و تمایل‌ها به جنب و جوش می‌افتند و انسان به فکر نجات می‌افتد، او فریاد می‌زند و به کمک خواهان می‌آید."],[845,"کان زمان پیش از خرابی بصره است","بوک بصره وا رهد هم زان شکست","زمانی که پیش از خرابی بصره بود، بصره را می‌کردند آن زمان که در حال شکست است."],[845,"ابک لی یا باکیی یا ثاکلی","قبل هدم البصرة و الموصلی","ای کسی که زاری می‌کنی و گریه‌کننده‌ای، برای من بگری و برای گناهکارانی چون من بگری، پیش از آن که بصره و موصل ویران شود."],[845,"نح علی قبل موتی واغتفر","لا تنح لی بعد موتی واصطبر","قبل از مرگم بر من گریه کن و ببخشایید، بعد از مرگم برای من گریه نکن و صبر کن."],[845,"ابک لی قبل ثبوری فی‌النوی","بعد طوفان النوی خل البکا","برای من بخوان قبل از مردن، زیرا پس از مرگ، دیگر نیازی به گریه نخواهد بود. بگذار گریه ام را در طوفان زندگی، پیش از آنکه به مرگ برسم، بکنم."],[845,"آن زمان که دیو می‌شد راه‌زن","آن زمان بایست یاسین خواندن","زمانی که موجودات شیطانی (دیوها) در حال دزدی و راهزنی بودند، باید آیات سوره یس (یاسین) را خواند."],[845,"پیش از آنک اشکسته گردد کاروان","آن زمان چوبک بزن ای پاسبان","قبل از آنکه کاروان از هم بپاشد و مشکلات ایجاد شود، ای پاسبان، چوبک خود را آماده کن و به وظیفه‌ات عمل کن."],[846,"پاسبانی خفت و دزد اسباب برد","رختها را زیر هر خاکی فشرد","پاسبانی خوابش برد و دزدان همه‌چیز را برداشتند و زیر خاک پنهان کردند."],[846,"روز شد بیدار شد آن کاروان","دید رفته رخت و سیم و اشتران","صبح فرا رسید و کاروان بیدار شد و متوجه شد که بارها و دارایی‌ها و شترها ناپدید شده‌اند."],[846,"پس بدو گفتند ای حارس بگو","که چه شد این رخت و این اسباب کو","به پاسبان گفتند، ای نگهبان، بگو که این بار و وسایل کجا رفت و چه بر سرشان آمد؟"],[846,"گفت دزدان آمدند اندر نقاب","رختها بردند از پیشم شتاب","پاسبان گفت: دزدان با چهره‌های پنهانی (نقاب‌دار) آمدند و به سرعت اموال را از جلوی من برداشتند."],[846,"قوم گفتندش که ای چو تل ریگ","پس چه می‌کردی کیی ای مردریگ","قوم به او گفتند، ای فردی که مانند تل‌های ریز و بی‌ارزش هستی، پس تو در آن زمان چه کاری انجام می‌دادی، ای مرد سست و ضعیف؟"],[846,"گفت من یک کس بدم ایشان گروه","با سلاح و با شجاعت با شکوه","من تنها یک نفر هستم، در حالی که آن‌ها گروهی هستند که با سلاح و شجاعت و قدرت آماده‌اند."],[846,"گفت اگر در جنگ کم بودت امید","نعره‌ای زن کای کریمان برجهید","گفت اگر در جنگ به پیروزی امید نداری، تو هم با صدای بلند فریاد بزن تا ای بخشندگان، به کمک بیایید."],[846,"گفت آن دم کارد بنمودند و تیغ","که خمش ورنه کشیمت بی‌دریغ","در آن لحظه شمشیرها را ظاهر کردند و گفتند که اگر تسلیم نشوی، بی‌رحمانه تو را می‌زنیم."],[846,"آن زمان از ترس بستم من دهان","این زمان هیهای و فریاد و فغان","در آن زمان که از ترس خاموش شدم و نتوانستم چیزی بگویم، اکنون تمام وجودم پر از فریاد و ناله شده است."],[846,"آن زمان بست آن دمم که دم زنم","این زمان چندانک خواهی هی کنم","در آن زمان که من سکوت کردم، اکنون وقتی که بخواهم می‌توانم فریاد بزنم و صدا کنم."],[846,"چونک عمرت برد دیو فاضحه","بی‌نمک باشد اعوذ و فاتحه","زمانی که عمر تو را دیو سرزنش‌گر برباید، دیگر دعای اعوذ (به خدا پناه می‌برم) و فاتحه (سوره فاتحه) بی‌فایده و بی‌مزه خواهد بود."],[846,"گرچه باشد بی‌نمک اکنون حنین","هست غفلت بی‌نمک‌تر زان یقین","هرچند در حال حاضر از بی‌نمکی نشانه‌ای وجود دارد، اما غفلت از آن، بی‌نمک‌تر و بدون طراوت‌تر است."],[846,"هم‌چنین هم بی‌نمک می‌نال نیز","که ذلیلان را نظر کن ای عزیز","عزیزان، حتی اگر بی‌نمک و بی‌فایده باشند، باز هم ناله و شکایت می‌کنند، پس به ذلیلان نگاه کن."],[846,"قادری بی‌گاه باشد یا به گاه","از تو چیزی فوت کی شد ای اله","اگر تو قدرتی داشته باشی که هر زمان و هر مکان چیزی را از تو بگیرد، پس چه فایده‌ای دارد که از دست رفتن چیزی را به یاد بیاوری یا غصه بخوری؟"],[846,"شاه لا تاسوا علی ما فاتکم","کی شود از قدرتش مطلوب گم","ای شاه، دلسرد نشوید از آنچه از دست شما رفته، زیرا خواسته‌ها و آرزوهای شما هنوز در قدرت او ممکن است."],[847,"گفت آن مرغ این سزای او بود","که فسون زاهدان را بشنود","مرغ می‌گوید که این مجازات زاهد است که جادو و فریب زاهدان را پذیرفته و به دام آنها افتاده است."],[847,"گفت زاهد نه سزای آن نشاف","کو خورد مال یتیمان از گزاف","زاهد گفت که این عقوبت برای آن نشاف (پرنده) سزاوار نیست، زیرا او مال یتیمان را به ناحق و بی‌سبب خورده است."],[847,"بعد از آن نوحه‌گری آغاز کرد","که فخ و صیاد لرزان شد ز درد","بعد از این که زاهد شروع به نوحه‌خوانی کرد، صیاد (دام‌گذار) و فخ (گناهکار) به شدت از درد و مصیبت او به شدت لرزیدند و نگران شدند."],[847,"کز تناقضهای دل پشتم شکست","بر سرم جانا بیا می‌مال دست","به خاطر تضادهای موجود در دل و احساساتم، به شدت دچار مشکل شده‌ام. ای محبوب، بیا و به من تسکین بده و نوازش کن."],[847,"زیر دست تو سرم را راحتیست","دست تو در شکربخشی آیتیست","سرم در زیر دست تو آرام است و راحت؛ دست تو نشانه‌ای از بخشندگی و نعمت است."],[847,"سایه خود از سر من برمدار","بی‌قرارم بی‌قرارم بی‌قرار","سایه تو را از روی من بر ندار، چون من در این حال بی‌قرار و ناتوان هستم و نمی‌توانم تحمل کنم."],[847,"خوابها بیزار شد از چشم من","در غمت ای رشک سرو و یاسمن","چشم من از خواب و آرامش به خاطر غم تو دور و بیزار شده است، ای کسی که باعث حسادت من در زیبایی‌ات هستی، مانند سرو و یاسمن."],[847,"گر نیم لایق چه باشد گر دمی","ناسزایی را بپرسی در غمی","اگر من لایق نباشم، چه اهمیتی دارد؟ اگر دردی را بپرسی که ناشایست است، درمیانه غم و اندوهی چه می‌شود؟"],[847,"مر عدم را خود چه استحقاق بود","که برو لطفت چنین درها گشود","عدم به خودی خود شایستگی و ارزش خاصی ندارد، پس چگونه ممکن است که تو، ای خدا، این همه لطف و رحمت را به او عطا کرده‌ای و درهای رحمت را به روی او گشوده‌ای؟"],[847,"خاک گرگین را کرم آسیب کرد","ده گهر از نور حس در جیب کرد","کرم، که موجودی کوچک و زنده است، به خاک گرگین (خاکی که از مواد پاکیزه نیست) آسیب می‌زند و از این خاک، ده گوهر (ذاتی ارزشمند) را با استفاده از نور حس خود به درون جیبش می‌آورد."],[847,"پنج حس ظاهر و پنج نهان","که بشر شد نطفه مرده از آن","انسان دارای پنج حس ظاهری (حس‌هایی که با آن‌ها دنیا را می‌بیند و درک می‌کند) و پنج حس پنهانی (حس‌هایی که درونی‌تر و غیرملموس هستند) است، اما این حس‌ها به تنهایی نمی‌توانند او را به زندگی و تحقق برسانند، مگر اینکه وجود روحانی و الهی نیز در او باشد. در واقع، این اشاره به کمبود روح در ابتدای خلقت انسان دارد."],[847,"توبه بی توفیقت ای نور بلند","چیست جز بر ریش توبه ریش‌خند","اگر توبه بدون کمک و توفیق تو ای نور بلند (خدا) باشد، چه معنایی دارد جز اینکه گوشه‌ای از توبه را به تمسخر بگیرد؟"],[847,"سبلتان توبه یک یک بر کنی","توبه سایه‌ست و تو ماه روشنی","توبه‌های شما مثل سایه‌ای هستند که به خودی خود تأثیری ندارند و تنها با وجود روشنایی شما، که مانند ماه است، معنا پیدا می‌کنند."],[847,"ای ز تو ویران دکان و منزلم","چون ننالم چون بیفشاری دلم","من از اینکه به خاطر تو خانه و زندگی‌ام خراب شده، ناله می‌کنم. وقتی که دلم را فشار می‌دهی و به من سخت می‌گیری، دیگر چطور می‌توانم آرامش داشته باشم؟"],[847,"چون گریزم زانک بی تو زنده نیست","بی خداوندیت بود بنده نیست","من نمی‌توانم از دست تو فرار کنم، زیرا بدون تو زندگی بی‌معنا است و بدون خداوندی تو، من بنده‌ای نخواهم بود."],[847,"جان من بستان تو ای جان را اصول","زانک بی‌تو گشته‌ام از جان ملول","خود را در ناامیدی می‌بیند و از جانش درخواست می‌کند که آن را بگیرد، زیرا بدون وجود محبوبش، حال و روزش خراب و ملول شده است."],[847,"عاشقم من بر فن دیوانگی","سیرم از فرهنگی و فرزانگی","من عاشق فن دیوانگی و بی‌خودی هستم و از آداب فرهنگی و خردمندی دور شده‌ام."],[847,"چون بدرد شرم گویم راز فاش","چند ازین صبر و زحیر و ارتعاش","زمانی که به درد شرم دچار می‌شوم، رازهای بسیاری را به رو می‌آورم؛ از این‌رو به خاطر صبر و تلاطم درونم، به شوق فاش‌گویی می‌افتم."],[847,"در حیا پنهان شدم هم‌چون سجاف","ناگهان بجهم ازین زیر لحاف","من در حیا و شرم، به‌طور ناگهانی پنهان شدم، همان‌طور که چیزی زیر لحاف می‌شود."],[847,"ای رفیقان راهها را بست یار","آهوی لنگیم و او شیر شکار","ای دوستان، راستش این است که یار راه‌ها را بر ما بسته، ما مثل آهویی لنگ و ناتوان هستیم و او مانند شیری است که به دنبال شکار است."],[847,"جز که تسلیم و رضا کو چاره‌ای","در کف شیر نری خون‌خواره‌ای","جز تسلیم و رضا چاره‌ای در دست شیر درنده و خون‌خوار نیست."],[847,"او ندارد خواب و خور چون آفتاب","روحها را می‌کند بی‌خورد و خواب","او مانند آفتابی است که همیشه بیدار و زنده است و همچنان که آفتاب زندگی می‌بخشد، روح‌ها را نیز از خواب و غفلت بیدار می‌کند، هرچند خود نیازی به غذا و خواب ندارد."],[847,"که بیا من باش یا هم‌خوی من","تا ببینی در تجلی روی من","بیایید با من باشید یا هم‌خوی من (همفکر و هم‌مروت) تا زیبایی و درخشش چهره من را ببینید."],[847,"ور ندیدی چون چنین شیدا شدی","خاک بودی طالب احیا شدی","اگر تو نمی‌دیدی که چگونه عاشق و شیدا شده‌ای، در واقع مانند خاکی بودی که فقط به دنبال زندگی دوباره است."],[847,"گر ز بی‌سویت ندادست او علف","چشم جانت چون بماندست آن طرف","اگر خداوند از سوی تو نیامده و به تو روزی نداده است، چشم جانت چگونه می‌تواند به آن طرف (جایی که علف و غذا هست) امید داشته باشد و باقی بماند؟"],[847,"گربه بر سوراخ زان شد معتکف","که از آن سوراخ او شد معتلف","گربه در مکانی خالی نشسته و منتظر شده است که از آنجا مرغی را شکار کند، زیرا او به این روش اعتنا و توجه کرده است تا طعمه‌اش را به دست آورد."],[847,"گربه دیگر همی‌گردد به بام","کز شکار مرغ یابید او طعام","گربه دیگری در بالای خانه می‌چرخد تا اینکه از شکار مرغ، غذایی برای خود پیدا کند."],[847,"آن یکی را قبله شد جولاهگی","وآن یکی حارس برای جامگی","یکی از آنها به حرفه جولاهگی (بافندگی) مشغول شده و قبله‌اش یعنی راهنمایش به سوی هدفش یعنی بافتن است، در حالی که دیگری به عنوان نگهبان (حارس) برای جامه و لباس‌ها در نظر گرفته شده است."],[847,"وان یکی بی‌کار و رو در لامکان","که از آن سو دادیش تو قوت جان","یکی دیگر بی‌کار و در حال سرگردانی است که از آن ناحیه تو به او زندگی و قوت می‌بخشی."],[847,"کار او دارد که حق را شد مرید","بهر کار او ز هر کاری برید","این بیت به این معناست که هر کسی که در کارها و امور خود به خدا وابسته و پیرو او است، باید از دیگر امور و مشاغل دست بکشد و فقط به خدمت و اطاعت از خدا بپردازد."],[847,"دیگران چون کودکان این روز چند","تا شب ترحال بازی می‌کنند","دیگران مانند کودکان، مدت‌هاست که در این دنیا بازی می‌کنند و سرگرم لذات دنیوی هستند."],[847,"خوابناکی کو ز یقظت می‌جهد","دایه وسواس عشوه‌ش می‌دهد","معنای این بیت این است که خواب و بیداری همواره در حال رقابت هستند؛ در این حال، وسوسه‌های عشق همچون مادری دلسوز و فریبنده، انسان را به خود می‌کشاند و او را از حالت بیداری دور می‌کند."],[847,"رو بخسپ ای جان که نگذاریم ما","که کسی از خواب بجهاند ترا","ای جان، بخواب برو و آرام بگیر، ما نمی‌گذاریم کسی تو را از خواب بیدار کند."],[847,"هم تو خود را بر کنی از بیخ خواب","هم‌چو تشنه که شنود او بانگ آب","تو نیز باید خودت را از خواب غفلت بیدار کنی، مانند تشنگانی که صدای آب را می‌شنوند و به سمت آن می‌روند."],[847,"بانگ آبم من به گوش تشنگان","هم‌چو باران می‌رسم از آسمان","من صدای آب را به گوش تشنگان می‌رسانم، و مانند بارانی که از آسمان می‌بارد، به آن‌ها می‌رسیم."],[847,"بر جه ای عاشق برآور اضطراب","بانگ آب و تشنه و آنگاه خواب","عاشق، چرا از اضطراب و نگرانی فریاد برمی‌آوری که صدای آب و تشنگان را می‌شنوی، در حالی که خود، در خواب و غفلت هستی؟"],[848,"عاشقی بودست در ایام پیش","پاسبان عهد اندر عهد خویش","عاشقی بوده است در زمان‌های گذشته که در زمان خود، پاسبان و نگهبان عهد و پیمانش بوده است."],[848,"سالها در بند وصل ماه خود","شاهمات و مات شاهنشاه خود","سال‌ها در انتظار وصال معشوق خود بودم، چنان‌که مهر و ماه در بند هستند و هر دو در سایه پادشاهی خود گرفتارند."],[848,"عاقبت جوینده یابنده بود","که فرج از صبر زاینده بود","در نهایت، کسی که به دنبال چیزی است، آن را خواهد یافت و گشایش و آرامش از صبر و تحمل به دست می‌آید."],[848,"گفت روزی یار او که امشب بیا","که بپختم از پی تو لوبیا","یار به او گفته بود که امشب بیایید، زیرا من به خاطر شما لوبیا می‌پزم."],[848,"در فلان حجره نشین تا نیم‌شب","تا بیایم نیم‌شب من بی طلب","در فلان حجره بمان تا نیمه شب، تا من به عنوان معشوق به درخواست تو بیایم و نخواهم که تو هیچ درخواستی از من داشته باشی."],[848,"مرد قربان کرد و نانها بخش کرد","چون پدید آمد مهش از زیر گرد","مرد همه چیزش را فدای معشوق کرد و نان‌ها را بین دیگران تقسیم نمود، زیرا وقتی که محبوبش از زیر گرد و غبار ظاهر شد، شوق و عشق او را به این کار واداشت."],[848,"شب در آن حجره نشست آن گرمدار","بر امید وعده آن یار غار","آن عاشق در شب در حجره‌اش نشسته و منتظر وعده یار محبوبش است که به او نزدیک می‌شود."],[848,"بعد نصف اللیل آمد یار او","صادق الوعدانه آن دلدار او","نیمه‌شب، محبوب او با صداقت و وعده‌ای که داده بود، به سراغش آمد."],[848,"عاشق خود را فتاده خفته دید","اندکی از آستین او درید","عاشق خود را خوابیده و غافل دید و اندکی از آستین او را پاره کرد."],[848,"گردکانی چندش اندر جیب کرد","که تو طفلی گیر این می‌باز نرد","معشوق چندین گردو (گردکانی) در جیب عاشق گذاشت و گفت که تو هنوز مانند یک کودک هستی و باید از این نعمت استفاده کنی، در بازی عشق (می‌باز نرد) سرگرم نشوی."],[848,"چون سحر از خواب عاشق بر جهید","آستین و گردکانها را بدید","وقتی صبح فرا رسید و عاشق از خواب بیدار شد، آستین و گردکان‌هایی که در جیبش بود را مشاهده کرد."],[848,"گفت شاه ما همه صدق و وفاست","آنچ بر ما می‌رسد آن هم ز ماست","شاه ما می‌گوید که همه چیز بر پایه صدق و وفا قرار دارد و هر آنچه به ما می‌رسد، ریشه در خود ما دارد."],[848,"ای دل بی‌خواب ما زین ایمنیم","چون حرس بر بام چوبک می‌زنیم","ای دل، ما از این بی‌خوابی نگرانی نداریم، زیرا مانند نگهبانی که با چوب بر بام می‌زند، به امنیت و محافظت خود مطمئن هستیم."],[848,"گردکان ما درین مطحن شکست","هر چه گوییم از غم خود اندکست","غم و اندوه ما به قدری زیاد است که در این آسایشگاه، با وجود صحبت‌کردن در مورد آن، باز هم از شدت غم کاسته نمی‌شود."],[848,"عاذلا چند این صلای ماجرا","پند کم ده بعد ازین دیوانه را","ای کسی که در پی داستان ما هستی، دیگر چه نیازی به نصیحت داری؟ به این دیوانه بعد از این، پند و نصیحت نده."],[848,"من نخواهم عشوه هجران شنود","آزمودم چند خواهم آزمود","من نمی‌خواهم درد فراق و جدایی را بشنوم، زیرا بارها آن را تجربه کرده‌ام و دیگر نمی‌خواهم دوباره آن را امتحان کنم."],[848,"هرچه غیر شورش و دیوانگیست","اندرین ره دوری و بیگانگیست","هر چیزی جز شور و دیوانگی در این مسیر، که ما دور از هم و غریبه هستیم، بی‌ارزش است."],[848,"هین بنه بر پایم آن زنجیر را","که دریدم سلسله تدبیر را","به من کمک کن تا آن زنجیر را که به خاطر آزادی و رهایی از تدبیرهای worldly (دنیا) پاره کردم، دوباره به پایم ببندی."],[848,"غیر آن جعد نگار مقبلم","گر دو صد زنجیر آری بگسلم","مقبل یعنی زیبا، دلپسند (در افغانستان لغت مقبول در معنای «زیبا» فراوان بکار می‌رود)"],[848,"عشق و ناموس ای برادر راست نیست","بر در ناموس ای عاشق مایست","عشق و غیرت به یکدیگر مرتبط هستند، ای برادر. درست نیست که در انتظار ناموس یا معشوق بایستی، ای عاشق."],[848,"وقت آن آمد که من عریان شوم","نقش بگذارم سراسر جان شوم","زمان آن فرا رسیده که من بی‌پوشش شوم و تمام وجودم را در آغوش بگیرم و فانی شوم."],[848,"ای عدوّ شرم و اندیشه بیا","که دریدم پرده شرم و حیا","ای دشمن، شرم و اندیشه را کنار بگذار، زیرا من پرده شرم و حیا را پاره کردم."],[848,"ای ببسته خواب جان از جادوی","سخت‌دل یارا که در عالم توی","ای کسی که خواب جانت را گرفته‌ای، به خاطر جادوی معشوق سخت‌دل، که در عالم تو قرار دارد."],[848,"هین گلوی صبر می گیر و فشار","تا خنک گردد دل عشق ای سوار","صبر را به خود تحمیل کن و آن را فشرده نگه‌دار تا دل عاشق به آرامش برسد، ای عاشق، مانند سوارکار که باید بر خود مسلط باشد."],[848,"تا نسوزم کی خنک گردد دلش","ای دل ما خاندان و منزلش","ای دل، تا زمانی که من نسوزم و رنج نکشم، دل او خنک و آرام نخواهد شد. ما از یک خانواده و وابسته به یکدیگر هستیم و منزلت ما هم به هم مربوط می‌شود."],[848,"خانه خود را همی‌سوزی بسوز","کیست آن کس کت بگوید لایجوز","تو در حال سوختن خانه خود هستی، اما سوال اینجاست که چه کسی می‌تواند بگوید که این کار درست نیست؟"],[848,"خوش بسوز این خانه را ای شیر مست","خانه عاشق چنین اولیترست","ای شیر مست، خوشحال باش و این خانه را بسوزان، زیرا خانه عاشق به مراتب بیشتر باید سوخته شود."],[848,"بعد ازین این سوز را قبله کنم","زانکه شمعم بسوزش روشنم","بعد از این، این سوز و اشتیاق را به عنوان قبله و مقصد خود قرار می‌دهم، چون خودم مانند شمعی هستم که با این سوز و عشق روشن می‌شوم."],[848,"خواب را بگذار امشب ای پدر","یک شبی بر کوی بی‌خوابان گذر","امشب خواب را کنار بگذار، ای پدر، چون امشب باید شب‌نشینی کنی و از کنار بی‌خوابان بگذری."],[848,"بنگر اینها را که مجنون گشته‌اند","هم‌چو پروانه بوصلت کشته‌اند","به این افراد نگاه کن که مانند مجنون دیوانه شده‌اند و همچون پروانه به عشق تو به آتش افتاده و جان خود را فدای وصال تو کرده‌اند."],[848,"بنگر این کشتی خلقان غرق عشق","اژدهایی گشت گویی حلق عشق","بنگر این مردم که در عشق غرق شده‌اند، گویی مثل اژدهایی شده‌اند که در چنگال عشق گرفتارند."],[848,"اژدهایی ناپدید دلربا","عقل هم‌چون کوه را او کهربا","ای عشق، مانند اژدهایی ناپیداست و دلربا، و عقل مثل کوه سخت و محکم است که مانند کهربا (عشقی جذاب) در این معرکه گم شده است."],[848,"عقل هر عطار کآگه شد ازو","طبله‌ها را ریخت اندر آب جو","عقل هر عطار (فردی که عطر می‌فروشد و تجربه دارد) هنگامی که از حالتی آگاه شد، تمام ظرف‌های عطرش را در آب جوی ریخت. این به این معنا است که آگاهی و دانایی او باعث شد که چیزهایی که بی‌فایده هستند را کنار بگذارد."],[848,"رو کزین جو برنیایی تا ابد","لم یکن حقا له کفوا احد","تو از این جو (آب جو) بیرون نخواهی آمد و تا ابد در آن باقی خواهی ماند، زیرا حقیقتا هیچ کس مانند تو نیست و نمی‌تواند به جای تو باشد."],[848,"ای مزوّر چشم بگشای و ببین","چند گویی می‌ندانم آن و این","ای کسی که دروغ می‌گویی، چشم‌هایت را باز کن و ببین که چقدر درباره‌ی این و آن سخن می‌گویی که نمی‌دانم."],[848,"از وبای زرق و محرومی بر آ","در جهان حی و قیومی در آ","از عذاب دنیا و تظاهر به زرق و برق زندگی مادی بیرون بیا و وارد دنیای حیات و وجود پروردگار شو که او همیشه زنده و پایدار است."],[848,"تا نمی‌بینم همی‌بینم شود","وین ندانمهات می‌دانم بود","همزمان که نمی‌بینم تو را، احساس می‌کنم که وجودت در هر حالتی هست؛ با اینکه نمی‌دانم چه می‌کنی، اما از روی احساس، از وجودت خبر دارم."],[848,"بگذر از مستی و مستی‌بخش باش","زین تلوّن نقل کن در استواش","شرح جامع مثنوی معنوی از کریم زمانی: از مرتبه مستی بگذر، یعنی از سرمستی های مبتذل و گذرا صرف‌نظر کن و به دیگران مستی الهی عطا کن. (البته لازمه مست کردن دیگران اینست که خود ابتدا از باده حق مست باشی.) از رنگارنگی و تغییر احوال دنیا گذر کن و به اثبات الهی در آی. منظور بیت: از جاذبه‌های رنگارنگ نفسانی و احوال متغیّر دنیوی عبور کن و به مقام سکینه و وقار الهی برس."],[848,"چند نازی تو بدین مستی بس است","بر سر هر کوی چندان مست هست","چقدر به خودت می‌نازی و در مستی به سر می‌بری، کافی است که در هر خیابانی این همه مست وجود دارد."],[848,"گر دو عالم پر شود سرمست یار","جمله یک باشند و آن یک نیست خوار","اگر تمام جهان پر از سرمستی یار محبوب شود، همگی در آن حالت یکسان خواهند بود و آن یک هم خوار و بی‌ارزش نیست."],[848,"این ز بسیاری نیابد خواریی","خوار که بود تن‌پرستی ناریی","کسی که از پرستیژ و مقام زیادی برخوردار است، نمی‌تواند ذلیل و خوار باشد، مانند کسی که از خواب غفلت بیدار است و جوهر وجودش را در اختیار دارد. تن‌پرستی و آسان‌طلبی او را به آتش نمی‌کشاند."],[848,"گر جهان پر شد ز نور آفتاب","کی بود خوار آن تف خوش‌التهاب","هرگاه که جهان از نور آفتاب پر شود، آنچه که می‌تواند خوار باشد، آن هیجان خوشی است که در دل عاشق وجود دارد."],[848,"لیک با این جمله بالاتر خرام","چونک ارض الله واسع بود و رام","اما با این حال، بالاتر از این سطح، آسمان وجود دارد، زیرا زمین خدا وسیع و قابل پذیرش است."],[848,"گرچه این مستی چو باز اشهبست","برتر از وی در زمین قدس هست","شرح جامع مثنوی معنوی از کریم زمانی: اگرچه این مستی، یعنی مستی سالکان همچون باز سفید، زیبا و گرانقدر است. لیکن در سرزمین قدس الهی، مستی های زیباتر و گرانقدرتر از آن مستی پیدا میشود. [پس سالک نباید به مرتبه موجود خود قانع شود.]"],[848,"رو سرافیلی شو اندر امتیاز","در دمنده روح و مست و مست‌ساز","باید خود را در درخشش این روح برافراز و از حالتی که به انسان شوق حسرت می‌دهد، جدا شوی. در اینجا اشاره به حالتی دارد که در آن نفس، روح را می‌دمد و انسان را مست می‌کند، بنابراین باید برتری روحی خود را درک کنی."],[848,"مست را چون دل مزاح اندیشه شد","این ندانم و آن ندانم پیشه شد","زمانی که انسان به شدت شیدا و سرمست می‌شود، دیگر دلش به فکر و اندیشه نمی‌افتد و از آنچه نمی‌داند، بی‌توجه می‌گردد."],[848,"این ندانم وان ندانم بهر چیست","تا بگویی آنک می‌دانیم کیست","اینکه نمی‌دانم و آنکه نمی‌دانم برای چیست، تا بتوانی بگویی آنچه که می‌دانیم چیست."],[848,"نفی بهر ثبت باشد در سخن","نفی بگذار و ز ثبت آغاز کن","اگر در سخن چیزی را نفی می‌کنی، برای روشن کردن موضوع بهتر است که آن را ثبت کنی، یعنی ابتدا نقاط مثبت را بیان کن و سپس نفی را انجام بده."],[848,"نیست این و نیست آن هین واگذار","آنک آن هستست آن را پیش آر","این جمله می‌گوید که به چیزهایی که وجود ندارند توجه نکن و آنها را کنار بگذار. به جای آن، روی آنچه که واقعی و هستی دارد تمرکز کن و آن را به جلو بیاور."],[848,"نفی بگذار و همان هستی پرست","این در آموز ای پدر زان ترک مست","این بیت به معنای این است که از نفی و رد کردن مطالب دست بردار و به جای آن به پرستش و توجه به حقیقتی که وجود دارد بپرداز. باید از پدر (معلم یا راهنما) یاد بگیری که چگونه به این حقیقت عمیق‌تر و غنی‌تر توجه کنی."],[849,"اعجمی ترکی سحر آگاه شد","وز خمار خمر مطرب‌خواه شد","مردی غیر فارسی زبان از جاذبه‌های موسیقی آگاه شد و به خاطر مستی ناشی از شراب، خواهان شنیدن آواز مطرب شد."],[849,"مطرب جان مونس مستان بود","نقل و قوت و قوت مست آن بود","مطرب، جان و همراه مستان است و نغمه او غذای روح و قوتی برای مستی آن‌ها به شمار می‌آید."],[849,"مطرب ایشان را سوی مستی کشید","باز مستی از دم مطرب چشید","مطرب (خواننده یا نوازنده) این مستان را به سمت حالت مستی برد و مستی واقعی از نفس او و نغمه‌هایش به آنها رسید."],[849,"آن شراب حق بدان مطرب برد","وین شراب تن ازین مطرب چرد","شراب حقی که مطرب به آن دعوت می‌کند، شراب روحانی و معنوی است، در حالی که شراب جسمانی که از مطرب دیگر می‌چشد، همان شراب مادی و ظاهری است."],[849,"هر دو گر یک نام دارد در سخن","لیک شتان این حسن تا آن حسن","هر دو شراب (شراب حقیقی و شراب دنیایی) از نظر نام مشابه‌اند، اما در واقعیت، زیبایی و ارزششان با یکدیگر متفاوت است."],[849,"اشتباهی هست لفظی در بیان","لیک خود کو آسمان تا ریسمان","در سخن، ممکن است بعضی از واژه‌ها مشابه هم باشند، اما این به معنای شباهت واقعی آن‌ها نیست. به‌جای تمرکز بر این اشتباهات زبانی، باید به حقیقت‌ها و عمق معانی توجه کرد."],[849,"اشتراک لفظ دایم ره‌زنست","اشتراک گبر و مؤمن در تنست","علاقه‌ی به اشتراک معنایی واژه‌ها می‌تواند موجب گمراهی شود؛ همان‌طور که کافر و مؤمن در ظاهر بدن یکسان هستند، اما در حقیقت از یکدیگر بسیار متفاوتند."],[849,"جسم‌ها چون کوزه‌های بسته‌سر","تا که در هر کوزه چه بود آن نگر","جسم‌ها مانند کوزه‌های دارای دهانه بسته‌اند و باید دید که در هر کوزه چه چیزی وجود دارد؛ یعنی ارزش و کیفیت انسان‌ها را بر اساس محتوا و درون‌شان بسنجیم، نه فقط ظاهر آن‌ها."],[849,"کوزه آن تن پر از آب حیات","کوزه این تن پر از زهر ممات","این بدن یا جسم، مانند کوزه‌ای است که پر از آب حیات و زندگی است، در حالی که آن بدن دیگر، مانند کوزه‌ای است که پر از زهر و مرگ است. در اینجا به تفاوت میان جسمی که زنده‌کننده و سالم است و جسمی که مرگ و نابودی را به همراه دارد اشاره می‌شود."],[849,"گر به مظروفش نظر داری شهی","ور به ظرفش بنگری تو گم‌رهی","اگر به محتوای واقعی و باطن عمیق چیزی توجه کنی، حقیقت آن چیز را می‌بینی (شهی)، اما اگر فقط به ظاهر آن بپردازی و به شکل و ظرف آن نگاه کنی، در اشتباه خواهی بود و گمراه می‌مانی."],[849,"لفظ را ماننده این جسم دان","معنیش را در درون مانند جان","معنی این بیت این است که واژه‌ها و الفاظ مانند جسم هستند و معنای آنها، مانند جان، در درون آنها نهفته است. به عبارت دیگر، مفهوم و معنا در پشت واژه‌ها وجود دارد و باید به عمق آنها توجه کرد."],[849,"دیده تن دایما تن‌بین بود","دیده جان جان پر فن بین بود","چشم جسمی دائما به دنبال چیزهای ظاهری و مادی است، اما چشم جان به چیزهای عمیق‌تر و روحانی توجه دارد و به ویژگی‌های درونی و معنوی نگاه می‌کند."],[849,"پس ز نقش لفظ‌های مثنوی","صورتی ضال است و هادی معنوی","لفظ‌های مثنوی تنها نقش ظاهری دارند و معانی واقعی را به شکل واضح بیان نمی‌کنند؛ بنابراین، این الفاظ شاید به ظاهر گمراه‌کننده باشند، اما در واقع هدایتگر معانی عمیق و معنوی هستند."],[849,"در نبی فرمود کاین قرآن ز دل","هادی بعضی و بعضی را مضل","در نبی (پیامبر) گفته شده که قرآن برخی را به هدایت می‌برد و برخی دیگر را گمراه می‌کند."],[849,"الله الله چونک عارف گفت می","پیش عارف کی بود معدوم شی","خداوند را سپاس می‌گویم، زیرا عارف گفته است که در می (شراب) پیشرفت و آگاهی وجود دارد. عارف کیست که در حقیقت وجودی ندارد و به نیستی رسیده است؟"],[849,"فهم تو چون باده شیطان بود","کی ترا وهم می رحمان بود","فهم تو همانند می (شراب) شیطانی است که تو را به گمراهی می‌کشاند، در حالی که درک واقعی و درست از خداوند (رحمان) باید تو را به حقایق برساند."],[849,"این دو انبازند مطرب با شراب","این بدان و آن بدین آرد شتاب","این دو (مطب و شراب) همدیگر را همراهی می‌کنند و یکی از دیگری یاری می‌طلبد؛ مطرب (خواننده) به شراب اشاره دارد و شراب نیز به مطرب واکنش نشان می‌دهد و به هم سرعت می‌دهند."],[849,"پر خماران از دم مطرب چرند","مطربانشان سوی میخانه برند","عاشقان و مست‌های سکرآور به صدای مطرب، خود را به میخانه می‌بردند و به نشئگی و مستی دچار می‌شوند."],[849,"آن سر میدان و این پایان اوست","دل شده چون گوی در چوگان اوست","معنی این بیت این است که آنجا که میدان مسابقه و ستیز است، اینجا نیز پایان آن مسابقه است؛ دل انسان مانند گوی در بازی چوگان است و در حیطه قدرت و کنترل او قرار دارد، به عبارتی، دل آن کسی است که در این میدان درگیر است و تحت تأثیر اوست."],[849,"در سر آنچه هست گوش آنجا رود","در سر ار صفراست آن سودا شود","در ابتدا، هرچه در دل و ذهن وجود دارد و فکر می‌کند، در مکان درست و مناسب خود قرار می‌گیرد. وقتی که در دل انسان، درد یا بیماری وجود دارد (که به زردی صفرا اشاره دارد)، آن احساس و وضعیتی ناخوشایند (سودا) به سراغ او می‌آید."],[849,"بعد از آن این دو به بیهوشی روند","والد و مولود آن‌جا یک شوند","پس از آن، والد و فرزند به حالت غش می‌رسند و در آنجا یکی می‌شوند."],[849,"چونک کردند آشتی شادی و درد","مطربان را ترک ما بیدار کرد","وقتی که شادی و درد با هم آشتی کردند، مطربان ما را بیدار کردند و از خواب غفلت نجات دادند."],[849,"مطرب آغازید بیتی خوابناک","که انلنی الکاس یا من لا اراک","مطرب شروع به خواندن شعری خواب‌آور می‌کند و از کسی می‌خواهد که او را ببیند به سخن بیاساید و بگوید «ای کسی که در دستت جام است، من تو را نمی‌بینم."],[849,"انت وجهی لا عجب ان لا اراه","غایة القرب حجاب الاشتباه","تو چهره و حقیقت منی و تعجب ندارد که نتوانم تو را ببینم، زیرا در نزدیکی بسیار، حجاب و ابهام وجود دارد."],[849,"انت عقلی لا عجب ان لم ارک","من وفور الالتباس المشتبک","تو عقل منی و جای تعجب نیست که تو را نمی‌بینم، زیرا به خاطر وفور آشفتگی و درهم‌ریختگی، تو از نظرها پنهان شده‌ای."],[849,"جئت اقرب انت من حبل الورید","کم اقل یا یا نداء للبعید","تو به من نزدیک‌تر از رگ گردن هستی، پس چرا به تو ندا می‌زنم، ای دور؟"],[849,"بل اغالطهم انادی فی القفار","کی اکتم من معی ممن اغار","من در بیابان‌ها آن‌ها را فریب می‌زنم و ندا می‌زنم تا از وجود کسی که به من آسیب می‌زند، پنهان بمانم."],[850,"اندر آمد پیش پیغامبر ضریر","کای نوابخش تنور هر خمیر","مرد نابینایی پیش پیامبر اسلام (محمد) آمد و به او گفت: ای حاکم و بخشنده، تو برای هر درخواستی همچون نان‌پز هستی که خمیر آماده را در تنور می‌گذارد."],[850,"ای تو میر آب و من مستسقیم","مستغاث المستغاث ای ساقیم","ای تو آن کسی که کارها را به‌دست داری و من در طلب و نیاز به تو هستم. ای کسی که دیگران از تو درخواست کمک می‌کنند، ای ساقی و سیراب‌کننده."],[850,"چون در آمد آن ضریر از در شتاب","عایشه بگریخت بهر احتجاب","زمانی که آن نابینا (ضریر) با عجله وارد خانه شد، عایشه برای پنهان شدن از او فرار کرد."],[850,"زانک واقف بود آن خاتون پاک","از غیوری رسول رشکناک","عایشه، همسر پیامبر اسلام، از حساسیت و غیرت پیامبر بر زنان مطلع بود و به همین دلیل به خاطر غیرت او، از ضریر (بینا) که هیچ‌گاه او را نمی‌دید، فرار کرد."],[850,"هر که زیباتر بود رشکش فزون","زانک رشک از ناز خیزد یا بنون","هر کس که زیباتر باشد، حسادت و رشکش بیشتر بوده و این حسادت از نعمت زیبایی و ناز در او برمی‌خیزد یا ناشی از ناز اوست."],[850,"گنده‌پیران شوی را قما دهند","چونک از زشتی و پیری آگهند","کسانی که پیری و زشتی را می‌بینند، به جوانی زیبا و قشنگ حسادت می‌کنند و می‌خواهند با زبان تلخ و زشت صحبت کنند."],[850,"چون جمال احمدی در هر دو کون","کی بدست ای فر یزدانیش عون","زیبایی پیامبر احمد (محمد) در هر دو دنیا (دنیا و آخرت) دیده می‌شود؛ زیرا جمال و نیکی او به حدی است که کمک الهی (فر یزدانیش) به او می‌رسد."],[850,"نازهای هر دو کون او را رسد","غیرت آن خورشید صدتو را رسد","غیرت آن خورشید (پیامبر اسلام، محمد) به ناز و زیبایی‌های او (عایشه) تنها نمی‌رسد و او را از هر دو جهان بالاتر می‌سازد."],[850,"که در افکندم به کیوان گوی را","در کشید ای اختران هم روی را","در این بیت، شاعر اشاره به این دارد که او مانند ستاره‌ای درخشان در آسمان، دیگران را به خود جذب می‌کند و زیبایی خود را به گونه‌ای نمایش می‌دهد که ستاره‌ها نیز به او توجه می‌کنند. این تصویر نشان‌دهنده‌ی قدرت و جاذبه‌ی خاص اوست که می‌تواند دیگران را تحت تأثیر قرار دهد."],[850,"در شعاع بی‌نظیرم لا شوید","ورنه پیش نور من رسوا شوید","اگر در نور بی‌نظیر من درخشید، خود را پنهان کنید، وگرنه در برابر نور من رسوا خواهید شد."],[850,"از کرم من هر شبی غایب شوم","کی روم الا نمایم که روم","من به خاطر کرم و بزرگواری‌ام هر شب اگر غایب شوم، هرگز از اینکه خودم را نشان ندم نمی‌روم."],[850,"تا شما بی من شبی خفاش‌وار","پر زنان پرید گرد این مطار","در غیاب من، شما مانند خفاش‌ها که شب‌ها پرواز می‌کنند، دور این مکان پرواز کنید و به شادی بپردازید."],[850,"هم‌چو طاووسان پری عرضه کنید","باز مست و سرکش و معجب شوید","همان‌طور که طاووس‌ها با زیبایی و طراوت پرهای خود جلوه‌گری می‌کنند، شما هم باید خود را با نشاط و شگفتی نشان دهید و تحت تأثیر حالت مستی و سرکشی قرار بگیرید."],[850,"ننگرید آن پای خود را زشت‌ساز","هم‌چو چارق کو بود شمع ایاز","به پاهای خود زشت نگاه نکنید، زیرا مانند چارق (پوششی برای پا) که شمع ایاز (پادشاهی در ادب و زیبایی) را زشت جلوه می‌دهد، شما نیز با نگاه به زشتی‌های خود، زیبایی‌تان را پنهان می‌کنید."],[850,"رو نمایم صبح بهر گوشمال","تا نگردید از منی ز اهل شمال","من در صبح خود را نشان می‌دهم تا به دیگران بفهمانم و یادآور شوم که نباید از من بترسند، مانند کسانی که اهل شمال هستند."],[850,"ترک آن کن که درازست آن سخن","نهی کردست از درازی امر کن","رها کن آنچه که سخن طولانی و بیهوده است، چرا که او (خدا) از درازگویی نهی کرده و می‌خواهد که سخنان مختصر و مفید گفته شود."],[851,"گفت پیغامبر برای امتحان","او نمی‌بیند ترا کم شو نهان","پیامبر اسلام برای امتحان عایشه به او می‌گوید که پنهان نشود، چون او نمی‌تواند تو را ببیند، پس بهتر است کم‌کم خودت را مخفی کنی."],[851,"کرد اشارت عایشه با دستها","او نبیند من همی‌بینم ورا","عایشه با حرکات دستش اشاره‌ای می‌کند که پیامبر (مصطفی) او را نمی‌بیند، اما من می‌توانم او را ببینم."],[851,"غیرت عقل است بر خوبی روح","پر ز تشبیهات و تمثیل این نصوح","غیرت عقل بر خوبی روح (حقیقت روح) است که پر از تشبیهات و تمثیل‌های عمیق است. این نشان می‌دهد که عقل درک و شناخت روح را با استدلال‌ها و مثال‌های مختلف همراه می‌کند."],[851,"با چنین پنهانی‌یی کاین روح راست","عقل بر وی این چنین رشکین چراست","با این نوع پنهان‌کاری که حقیقت روح راست را از دید عقل مخفی می‌کند، چرا عقل این‌قدر حسادت می‌کند؟"],[851,"از که پنهان می‌کنی ای رشک‌خو","آنکه پوشیده‌ست نورش روی او","ای کسی که برای دیگران خود را پنهان می‌کنی، از که پنهان می‌شوی؟ آنکه نورش در نهان نیز روشن است و نمی‌توانی او را مخفی کنی."],[851,"می‌رود بی‌روی‌پوش این آفتاب","فرط نور اوست رویش را نقاب","این آفتاب، که به شدت نورانی است، بدون هیچ پوششی می‌رود و نشان می‌دهد که نور او آن‌قدر زیاد است که نیازی به پوشیده ماندن ندارد."],[851,"از که پنهان می‌کنی ای رشک‌ور","که آفتاب از وی نمی‌بیند اثر","ای رشک‌ور، از کی پنهان می‌شوی؟ چرا که آفتاب، که نماد حقیقت و روشنایی است، از او (کسی که در پنهان است) تأثیری نمی‌بیند و نمی‌تواند او را در خودش به جز گم نامی بیابد."],[851,"رشک از آن افزون‌ترست اندر تنم","کز خودش خواهم که هم پنهان کنم","رشک که در وجود من وجود دارد بیشتر از آنچه هست، من آن را از خودم پنهان می‌کنم."],[851,"ز آتش رشک گران‌آهنگ، من","با دو چشم و گوش خود در جنگ، من","از شدت رشک و حسد دچار آتش و هیجان² هستم، به‌طوری که احساس می‌کنم که همواره در حال نبرد با خودم هستم و نمی‌توانم آرامش داشته باشم."],[851,"چون چنین رشکیستت ای جان و دل","پس دهان بر بند و گفتن را بهل","اگر این‌قدر به رشک و حسادت مبتلا هستی، ای جان و دل، بهتر است که سکوت کنی و از گفتن بپرهیزی."],[851,"ترسم ار خامش کنم آن آفتاب","از سوی دیگر بدراند حجاب","می‌ترسم اگر من سکوت کنم، آن آفتاب (محبت یا حقیقت) از طرف دیگر دیواری را بشکند و پنهان نشود."],[851,"در خموشی گفت ما اظهر شود","که ز منع آن میل افزون‌تر شود","در زمان سکوت، گفت: «هر چه بیشتر پنهان کنی، خود را بیشتر نمایان می‌کنی؛ زیرا که از منع، انسان بیشتر به سمت آن میل می‌کند."],[851,"گر بغرد بحر غره‌ش کف شود","جوش احببت بان اعرف شود","اگر دریا در آرامش بخواهد به جوش و خروش بیفتد، عشق و محبت تو باعث می‌شود که من به شناخت تو نائل شوم."],[851,"حرف گفتن بستن آن روزنست","عین اظهار سخن پوشیدنست","گفتن و بیان کردن در حقیقت به معنای پنهان کردن آنچه در دل داریم است؛ زیرا از یک سو خود را وادار به گفتار می‌کنیم و از سوی دیگر واقعیت‌ خود را پنهان نگه می‌داریم."],[851,"بلبلانه نعره زن در روی گل","تا کنی مشغولشان از بوی گل","بلبل با صدای دلنشین بر روی گل آواز می‌خواند تا بوی گل آن‌ها را مشغول کند."],[851,"تا به قل مشغول گردد گوششان","سوی روی گل نپرد هوششان","گوش بلبلان وقتی به آواز گل مشغول می‌شود، توجه و هوش آن‌ها دیگر به روی گل معطوف نمی‌شود و منحرف می‌گردد."],[851,"پیش این خورشید کو بس روشنیست","در حقیقت هر دلیلی ره‌زنیست","در برابر این خورشید که به شدت نورانی است، حقیقتا هیچ دلیلی نمی‌تواند ما را به بی‌راهه ببرد؛ یعنی در روشنایی این نور، هیچ شبهه و تردیدی باقی نمی‌ماند."],[852,"مطرب آغازید پیش ترک مست","در حجاب نغمه اسرار الست","مطرب در حضور امیر ترک مست، نغمه‌ای را آغاز کرد که حاوی رازهای عمیق و اسرار وجودی بود."],[852,"من ندانم که تو ماهی یا وثن","من ندانم تا چه می‌خواهی ز من","نمی‌دانم تو کیستی؛ آیا تو ماهی هستی یا بت (وثن)؟ همچنین نمی‌دانم چه خواسته‌ای از من داری."],[852,"می‌ندانم که چه خدمت آرمت","تن زنم یا در عبارت آرمت","نمی‌دانم که چه خدمتی برای تو انجام دهم، آیا تنم را به خاطر تو فدای تو کنم یا در بیانی دیگر تو را ستایش کنم."],[852,"این عجب که نیستی از من جدا","می‌ندانم من کجاام تو کجا","شگفتا که تو از من جدا نیستی، ولی من نمی‌دانم که من کجا هستم و تو کجا."],[852,"می‌ندانم که مرا چون می‌کشی","گاه در بر گاه در خون می‌کشی","نمی‌دانم چرا و چگونه مرا می‌کشی، گاهی در آغوش خود و گاهی با درد و خونریزی."],[852,"هم‌چنین لب در ندانم باز کرد","می‌ندانم می‌ندانم ساز کرد","او همچنان که لبش را باز کرد، نمی‌داند چه حرفی می‌زند و در حقیقت فقط صدای سازش را می‌شناسد."],[852,"چون ز حد شد می‌ندانم از شگفت","ترک ما را زین حراره دل گرفت","وقتی صحبت از حد و اندازه فراتر رفت، متوجه شگفتی ترک شدیم که از این حرارت (احساسات) دل ما را متاثر کرد."],[852,"برجهید آن ترک و دبوسی کشید","تا علیها بر سر مطرب رسید","ترک (نوازنده ترک)، ناگهان به سمت مطرب (نوازنده) پرید و با ضربه‌ای به او رسید."],[852,"گرز را بگرفت سرهنگی بدست","گفت نه مطرب کشی این دم بدست","سرهنگی (مقام بالا در ارتش) گرزی را به دست گرفت و گفت که این زمان، وقت کشتن مطرب نیست."],[852,"گفت این تکرار بی حد و مرش","کوفت طبعم را بکوبم من سرش","او می‌گوید که این تکرار بی‌پایان و مکرر که به گوش او می‌رسد، باعث آزار و زحمتش شده است و می‌خواهد آن را از خود دور کند."],[852,"قلتبانا می‌ندانی گه مخور","ور همی‌دانی بزن مقصود بر","اگر نمی‌دانی چه می‌گویی، از گفتن خودداری کن و اگر هم می‌دانی، باید به حقیقت اصلی پی ببری و به آن بپردازی."],[852,"آن بگو ای گیج که می‌دانیش","می‌ندانم می‌ندانم در مکش","ای کسی که گیج و سرگردان هستی، بگو آیا می‌دانی؟ من نمی‌دانم، فقط می‌دانم که در این مورد حرف نزن."],[852,"من بپرسم کز کجایی هی مری","تو بگویی نه ز بلخ و نز هری","من از تو می‌پرسم که از کدام جا آمده‌ای، اما تو پاسخ می‌دهی که نه از بلخ هستم و نه از هری."],[852,"نه ز بغداد و نه موصل نه طراز","در کشی در نی و نی راه دراز","من نه از بغداد (شهر بزرگ اسلامی) هستم، نه از موصل (شهر معروف دیگر)، نه از طراز (شهری در کیش)؛ من در مسیر سختی که نی (نیای معروف موسیقی) را به ما می‌دهد، گم شده‌ام."],[852,"خود بگو من از کجاام باز ره","هست تنقیح مناط اینجا بله","من بگو، من از کدام جا هستم و اینجا چه می‌خواهم. روشن کردن موضوع و هدفم در اینجا ضروری است."],[852,"یا بپرسیدم چه خوردی ناشتاب","تو بگویی نه شراب و نه کباب","از تو سؤال کردم که چه چیزی خوردی، اما تو بگو که هیچ‌یک از شراب و کباب نبوده است."],[852,"نه قدید و نه ثرید و نه عدس","آنچ خوردی آن بگو تنها و بس","سخن از این است که نه چیزی مثل قدید (غذای تهیه‌شده از گوشت) خوردی و نه ثرید (غذای تهیه‌شده از نان و آبگوشت) و نه عدس. فقط بگو که چه خورده‌ای، همین و بس."],[852,"این سخن‌خایی دراز از بهر چیست","گفت مطرب زانک مقصودم خفیست","سخن طولانی و بی‌موردی که در اینجا گفته می‌شود، به چه دلیلی است؟ مطرب پاسخ می‌دهد که هدف من پنهان است."],[852,"می‌رمد اثبات پیش از نفی تو","نفی کردم تا بری ز اثبات بو","قبل از این که وجود تو را نفی کنم، اثبات تو را درمی‌نرم. من وجود تو را انکار کردم تا از اثبات (جایگاه و ماهیت) تو رها شوم."],[852,"در نوا آرم بنفی این ساز را","چون بمیری مرگ گوید راز را","صدای این ساز را به طوری بنواز که از طریق نفی بتوانی به ما برسانی، زیرا وقتی که انسان می‌میرد، مرگ اسرار را فاش می‌کند."],[853,"جان بسی کندی و اندر پرده‌ای","زانک مردن اصل بد ناورده‌ای","شما در زندگی بسیار تلاش کرده‌اید و در حالی که در جهان مادی هستید، نمی‌توانید به حقیقت و معنای واقعی زندگی پی ببرید، زیرا هنوز مرگ و تغییر را تجربه نکرده‌اید."],[853,"تا نمیری نیست جان کندن تمام","بی‌کمال نردبان نایی به بام","تا زمانی که نمیری، جان کندن کامل نیست. برای بالا رفتن به بام (کمال) نیاز به نردبانی کامل داری."],[853,"چون ز صد پایه دو پایه کم بود","بام را کوشنده نامحرم بود","وقتی که از صد پایه، فقط دو پایه کم باشد، کسی که می‌خواهد به بالای بام برود، نمی‌تواند به آن دسترسی پیدا کند و نمی‌تواند به آنجا نزدیک شود."],[853,"چون رسن یک گز ز صد گز کم بود","آب اندر دلو از چه کی رود","اگر رسن (طناب) یک گز (یک واحد اندازه‌گیری) کمتر باشد از صد گز، آب چگونه می‌تواند به داخل دلو (سطل) برود؟ یعنی اگر شرایط به اندازه کافی فراهم نباشد، امکان رسیدن به هدف وجود نخواهد داشت."],[853,"غرق این کشتی نیابی ای امیر","تا بننهی اندرو من الاخیر","ای امیر، تو نمی‌توانی این کشتی را غرق کنی، زیرا تا زمانی که من در این کشتی به عنوان آخرین نفر وجود دارم، کار این کشتی به خوبی پیش می‌رود و خطرناک نیست."],[853,"من آخر اصل دان کو طارقست","کشتی وسواس و غی را غارقست","من از اصل و ریشه می‌دانم که طارق (ستاره) چگونگی‌ست و این کشتی وسواس و غم را غرق کرده است."],[853,"آفتاب گنبد ازرق شود","کشتی هش چونک مستغرق شود","زمانی که آفتاب در آسمان زیاد شود، کشتی مسافرانی که در دریا هستند، به سبب غرق‌شدن و غرق‌شدن در مشکلات به شدت آسیب می‌بیند."],[853,"چون نمردی گشت جان کندن دراز","مات شو در صبح ای شمع طراز","اگر تو قبل از مرگ، به دنیای حقایق و معانی دست پیدا نکنی، آنگاه جدایی از جسم برایت دشوار و سخت خواهد بود. پس در این بیداری و آگاهی، مانند شمعی در صبح، نباید مات و بی‌حرکت بمانی."],[853,"تا نگشتند اختران ما نهان","دانک پنهانست خورشید جهان","تا زمانی که ستاره‌های خوشبختی ما غایب نشده‌اند، بدان که خورشید جهان نیز پنهان است."],[853,"گرز بر خود زن منی در هم شکن","زانک پنبه گوش آمد چشم تن","به خود سخت بگیر و خود را خرد کن، زیرا حواس ظاهری و جسمی مانند پنبه‌ای هستند که نمی‌گذارند حقیقت را ببینی."],[853,"گرز بر خود می‌زنی خود ای دنی","عکس تست اندر فعالم این منی","خودت را با نیرنگ و سختی آزار می‌زنی، ای دنیا، زیرا که آنچه در این جهان می‌بینی فقط تصویری از خودت است."],[853,"عکس خود در صورت من دیده‌ای","در قتال خویش بر جوشیده‌ای","تو در جنگ با خود، خود را در صدای من شنیده‌ای و در نبرد داخلی‌ات برانگیخته شده‌ای."],[853,"هم‌چو آن شیری که در چه شد فرو","عکس خود را خصم خود پنداشت او","همچون آن شیری که در چاه افتاده‌است، تصویر خود را دشمن خود تصور کرد."],[853,"نفی ضد هست باشد بی‌شکی","تا ز ضد ضد را بدانی اندکی","برای شناخت درست مفهوم ضد، وجود ضد آن لازم است. پس باید ابتدا ضد را انکار کنی تا بتوانی به درک بهتری از وجود ضد دیگر دست یابی."],[853,"این زمان جز نفی ضد اعلام نیست","اندرین نشات دمی بی‌دام نیست","این زمان، یعنی در حال حاضر، فقط نفی ضد و زوال آن اهمیت دارد و در این دنیا، لحظه‌ای بدون رنج و مشکل وجود ندارد."],[853,"بی‌حجابت باید آن ای ذو لباب","مرگ را بگزین و بر دران حجاب","ای ذو لباب (ای صاحب عقل و درک)، برای رسیدن به حقیقت و فهم عمیق، باید حجاب‌ها و موانع را کنار بزنی و مرگ را به عنوان راهی برای تغییر و تحول بپذیری."],[853,"نه چنان مرگی که در گوری روی","مرگ تبدیلی که در نوری روی","مرگ مورد نظر مولانا، مرگ فیزیکی نیست که باعث رفتن به گور شود، بلکه مرگی روحانی است که انسان را به درک و روشنی می‌رساند. این نوع مرگ، انسان را به تجربه‌های بالاتر و معنوی نزدیک‌تر می‌کند."],[853,"مرد بالغ گشت آن بچگی بمرد","رومیی شد صبغت زنگی سترد","بچه‌ها وقتی بزرگ می‌شوند، مانند آن رومی (که اشاره به فردی بزرگ و پخته است) دیگر ویژگی‌های دوران کودکی را کنار می‌گذارند. در واقع، انسان بالغ باید رنگ و بوی دوران کودکی را از خود بزداید و به مقام و کمال برسد."],[853,"خاک زر شد هیات خاکی نماند","غم فرج شد خار غمناکی نماند","تنوع و زیبایی زندگی انسانی (که به خاک و ماده تعلق دارد) به طرز چشمگیری تغییر کرده و دیگر نشانه‌های غم و غصه وجود ندارد. از حالت سخت و دشوار غم، خروسی به آزادی و شادی رسیده‌ایم."],[853,"مصطفی زین گفت کای اسرارجو","مرده را خواهی که بینی زنده تو","پیامبر (مصطفی) می‌فرماید، ای جویای اسرار! اگر می‌خواهی مرده را به صورت زنده ببینی، باید خود را از قید و بندهای مادی جدا کنی و به حقایق روحانی دست یابی."],[853,"می‌رود چون زندگان بر خاکدان","مرده و جانش شده بر آسمان","انسانی که از دنیا می‌رود، مانند کسانی که در این دنیا زندگی می‌کنند، به خاک سپرده می‌شود، اما روح او به مرتبه‌ای بالاتر و آسمانی می‌رود."],[853,"جانش را این دم به بالا مسکنیست","گر بمیرد روح او را نقل نیست","جان انسان این لحظه در آسمان جا دارد و اگر آن لحظه بمیرد، روح او منتقل نخواهد شد."],[853,"زانک پیش از مرگ او کردست نقل","این بمردن فهم آید نه به عقل","چون او پیش از مرگ، تغییر و انتقالی در روح خود ایجاد کرده است، درک این نوع مرگ برای عقل انسانی ممکن نیست."],[853,"نقل باشد نه چو نقل جان عام","هم‌چو نقلی از مقامی تا مقام","مردن حضرت ادریس و صلحا و عالمان، مانند انتقال از یک جایگاه به جایگاه دیگر است و این فرآیند مشابه حیاتی نیست که معمولا با مرگ جسم همراه است."],[853,"هرکه خواهد که ببیند بر زمین","مرده‌ای را می‌رود ظاهر چنین","هر کس می‌خواهد ببیند که بر زمین مرده‌ است، باید به این شکل زندگی کند که خودش را در این دنیا به نوعی بمیرد و از زندگی دنیوی خود با آگاهی و تعمق جدا شود."],[853,"مر ابوبکر تقی را گو ببین","شد ز صدیقی امیرالمحشرین","به ابوبکر تقی (که از صحابه و نزدیکان پیامبر اسلام است) بگو که او از صدیقان است و مقامش بالاتر از دیگران در روز قیامت خواهد بود."],[853,"اندرین نشات نگر صدیق را","تا به حشر افزون کنی تصدیق را","در این دنیا (نشات) ابوبکر صدیق را ببین و تصدیق او را بیشتر کن تا در قیامت (حشر) بر مقام او افزوده شود."],[853,"پس محمد صد قیامت بود نقد","زانک حل شد در فنای حل و عقد","محمد(ص) مانند صد قیامت است، زیرا او در مقام فنا و بقا بر تمام مسائل جهان احاطه دارد و به درستی همه چیز را حل می‌کند."],[853,"زاده ثانیست احمد در جهان","صد قیامت بود او اندر عیان","احمد، فرزند ثانی (یعنی پیامبر اسلام محمد) در جهان وجود دارد و او در حقیقت صد قیامت را در زمان حاضر به نمایش می‌گذارد."],[853,"زو قیامت را همی‌پرسیده‌اند","ای قیامت تا قیامت راه چند","انسان‌ها در مورد قیامت پرسش‌هایی کرده‌اند و از آن سوال می‌کنند که در این مدت بی‌پایانی که قیامت ادامه دارد، چه مسیری باید طی کرد."],[853,"با زبان حال می‌گفتی بسی","که ز محشر حشر را پرسد کسی","با حالتی که نشان می‌دهد نگران روز قیامت است، تو در دل همواره می‌گفتی که آیا کسی از محشر (محل تجمع مردگان در قیامت) می‌پرسد که حشر (جمع شدن مردم در قیامت) چگونه است یا نه؟"],[853,"بهر این گفت آن رسول خوش‌پیام","رمز موتوا قبل موت یا کرام","این سخن پیامبر خوش‌خبر اشاره دارد به اینکه زندگی واقعی را پیش از مرگ تجربه کنید، زیرا مردن به معنای از دست دادن زندگی نیست، بلکه می‌توان به حقیقت و معنای زندگی دست یافت."],[853,"همچنانکه مرده‌ام من قبل موت","زان طرف آورده‌ام این صیت و صوت","من به گونه‌ای مرده‌ام پیش از مرگ، و به همین دلیل این نشانه و صدا را از دنیای دیگر به ارمغان آورده‌ام."],[853,"پس قیامت شو قیامت را ببین","دیدن هر چیز را شرطست این","برای آنکه به حقیقت و زیبایی‌های قیامت و یا روز رستاخیز پی ببری، باید خود را در آن حال و مقام قرار دهی و به آگاهی و شناخت برسید. مشاهده‌ی هر چیزی، نیازمند شرایط خاص خود است."],[853,"تا نگردی او ندانی‌اش تمام","خواه آن انوار باشد یا ظلام","تا زمانی که به معرفت و شناخت کامل نرسی، هیچ‌کدام از تجلیات و جنبه‌های وجود، چه نورانی و چه تاریک، را نخواهی فهمید."],[853,"عقل گردی عقل را دانی کمال","عشق گردی عشق را دانی ذبال","اگر به کمال عقل برسی، می‌توانی آن را درک کنی، و اگر به عشق برسی، می‌توانی زیبایی و قشنگی آن را بشناسی."],[853,"گفتمی برهان این دعوی مبین","گر بدی ادراک اندر خورد این","اگر بر دلیل و برهان این سخن (که آدمی باید پیش از مرگ بمیرد) روشنی بخواهی، باید درک کنی که این موضوع در زندگی واقعی انسان‌ها کاملا محسوس و قابل فهم است."],[853,"هست انجیر این طرف بسیار و خوار","گر رسد مرغی قنق انجیرخوار","اگر در این طرف انجیر فراوان و ارزان باشد، به محض اینکه پرنده‌ای برسد، آنجا را پر از انجیر می‌کند و می‌خورد."],[853,"در همه عالم اگر مرد و زنند","دم به دم در نزع و اندر مردنند","در تمام عالم، مردان و زنان هر لحظه در حال جنگ و درگیری با مرگ هستند و در حالتی از مردن به سر می‌برند."],[853,"آن سخنشان را وصیتها شمر","که پدر گوید در آن دم با پسر","سخن آن‌ها را به عنوان وصیت در نظر بگیر، زیرا پدر در لحظه مرگش چنین سخنانی را به پسرش می‌گوید."],[853,"تا بروید عبرت و رحمت بدین","تا ببرد بیخ بغض و رشک و کین","این بیت می‌گوید که باید عبرت و رحمت در دل بوجود آید تا ریشه کینه، حسادت و دشمنی از بین برود. به عبارت دیگر، وقتی انسان مطلع و آگاه شود، احساسات منفی را کنار می‌گذارد."],[853,"تو بدان نیت نگر در اقربا","تا ز نزع او نسوزد دل ترا","به نیت و قصد نزدیکان نگاه کن تا از جدال و کشمکش آنها دلت نسوزد."],[853,"کل آت آت آن را نقد دان","دوست را در نزع و اندر فقد دان","هر چیزی را که در آینده به‌دست می‌آوری، به‌عنوان آنچه در حال حاضر داری، ارزشمند بدان. دوست را در حالتی که کسى را از دست داده و در سختی است، درک کن."],[853,"ور غرضها زین نظر گردد حجیب","این غرضها را برون افکن ز جیب","اگر این مقاصد و هدف‌ها از این نظر ناپیدا و پوشیده به نظر بیاید، باید این مقاصد را از دل و ذهن خود بیرون بریزی."],[853,"ور نیاری خشک بر عجزی مایست","دانکه با عاجز گزیده معجزیست","اگر نمی‌توانی بر دستاوردهای دیگران تکیه کنی، بدان که زندگی با عجز و ناتوانی هیچ فایده‌ای ندارد، زیرا در کنار افراد ناتوان، چیزی جز معجزه و شگفتی نصیب کسی نمی‌شود."],[853,"عجز زنجیریست زنجیرت نهاد","چشم در زنجیرنه باید گشاد","عجز مانند زنجیری است که تو را گرفتار کرده است، و برای اینکه از این زنجیر رهایی یابی، نباید به آن چشم بدوزی و آن را بزرگ کنی."],[853,"پس تضرع کن که ای هادی زیست","باز بودم بسته گشتم این ز چیست","پس باید از خداوند مدد بخواهی که ای راهنمای زندگی، من که قبلا آزاد بودم، حالا در قید و بند هستم. این قید و بند از چیست؟"],[853,"سخت‌تر افشرده‌ام در شر قدم","که لفی خسرم ز قهرت دم به دم","من به شدت در گناه و معصیت خود غرق شده‌ام، و به خاطر خشم تو روزبه‌روز در حال سقوط هستم."],[853,"از نصیحتهای تو کر بوده‌ام","بت‌شکن دعوی و بت‌گر بوده‌ام","من به نصیحت‌های تو گوش نکرده‌ام و همچنان در گمراهی و بت‌پرستی خود باقی مانده‌ام."],[853,"یاد صنعت فرض‌تر یا یاد مرگ","مرگ مانند خزان تو اصل برگ","به یاد مرگ بودن مانند این است که در فصل پاییز به یاد برگ‌های درختان باشی؛ مرگ هم مانند خزان است که از بین بردن زندگی و نابودی را یادآوری می‌کند. اگر به یاد مرگ باشی، می‌توانی از زندگی خود به نحو بهتری بهره‌برداری کنی."],[853,"سالها این مرگ طبلک می‌زند","گوش تو بیگاه جنبش می‌کند","سال‌هاست که مرگ با صدای طبل خود در گوش تو صدا می‌زند و تو را به جنبش و حرکت وامی‌دارد، اما تو هنوز متوجه آن نمی‌شوی و در خواب غفلت به سر می‌بری."],[853,"گوید اندر نزع از جان آه مرگ","این زمان کردت ز خود آگاه مرگ","در زمان مواجهه با انقطاع زندگی، انسان باید متوجه شود که مرگ در حال نزدیک شدن است و به او یادآوری می‌کند که باید از زندگی‌اش آگاه باشد. مرگ انسان را به تفکر درباره حال و شرایط زندگی‌اش وادار می‌سازد."],[853,"این گلوی مرگ از نعره گرفت","طبل او بشکافت از ضرب شگفت","این صدا و عرشی که از مرگ شنیده می‌شود، از شدت غم و ناله‌ای است که مثل طبل می‌شکند و به صدای قوی تبدیل می‌شود."],[853,"در دقایق خویش را در بافتی","رمز مردن این زمان در یافتی","در زمانه‌ای که تو به دقایق خود توجه می‌کنی، می‌توانی معانی عمیق‌تری از مرگ و زندگی را درک کنی."],[854,"روز عاشورا همه اهل حلب","باب انطاکیه اندر تا به شب","در روز عاشورا، تمام مردم حلب در دروازه انطاکیه گردهم می‌آیند و تا شب آنجا می‌مانند."],[854,"گرد آید مرد و زن جمعی عظیم","ماتم آن خاندان دارد مقیم","مردان و زنان بسیاری جمع می‌شوند تا برای مصیبت آن خاندان عزاداری کنند و در این نزدیکی به سر می‌برند."],[854,"ناله و نوحه کنند اندر بکا","شیعه عاشورا برای کربلا","شیعیان در ایام عاشورا به یاد واقعه کربلا نوحه‌سرایی و گریه می‌کنند."],[854,"بشمرند آن ظلمها و امتحان","کز یزید و شمر دید آن خاندان","آن ظلم‌ها و آزمایش‌هایی را که خاندان پیامبر از یزید و شمر تجربه کردند، بشمارند."],[854,"نعره‌هاشان می‌رود در ویل و وشت","پر همی‌گردد همه صحرا و دشت","ناله‌ها و فریادهای آن‌ها به طوری بلند است که در همه جا، از جمله ویل و وشت، می‌پیچد و تمام دشت‌ها و صحراها را پر می‌کند."],[854,"یک غریبی شاعری از ره رسید","روز عاشورا و آن افغان شنید","شاعر غریبی در روز عاشورا به شهر رسید و صدای ناله و افغان مردم را شنید."],[854,"شهر را بگذاشت و آن سو رای کرد","قصد جست و جوی آن هیهای کرد","شاعر شهر را ترک کرد و به سوی دیگر رفت تا به دنبال صدای ناله و عزاداری بگردد."],[854,"پرس پرسان می‌شد اندر افتقاد","چیست این غم بر که این ماتم فتاد","سؤال‌ها و کنجکاوی‌ها درباره این غم و مصیبت بود که چرا این‌قدر ماتم و اندوه بر پا شده است."],[854,"این رئیس زفت باشد که بمرد","این چنین مجمع نباشد کار خرد","این ریش سفیدی که مرده است، بزرگ و محترم بوده و مرگ او باعث شده که در این مجلس هیچ کس حاضر نشود، زیرا کارهای خرد و ناچیز آنها را این فقدان تحت‌الشعاع قرار داده است."],[854,"نام او و القاب او شرحم دهید","که غریبم من شما اهل ده اید","من از شما که اهل این منطقه هستید، می‌خواهم نام و القاب این شخص را توضیح دهید؛ چون من غریب و ناشناسم."],[854,"چیست نام و پیشه و اوصاف او","تا بگویم مرثیه ز الطاف او","نام و شغل و ویژگی‌های او چیست تا من به خاطر خوبی‌هایش مرثیه سرایی کنم؟"],[854,"مرثیه سازم که مرد شاعرم","تا ازینجا برگ و لالنگی برم","من مرثیه‌ای برای کسی می‌سازم که شاعر است تا از این‌جا رخت بربندم و بروم."],[854,"آن یکی گفتش که هی دیوانه‌ای","تو نه‌ای شیعه عدوّ خانه‌ای","شخصی به دیگری می‌گوید که ای دیوانه، تو شیعه نیستی بلکه دشمن خانه اهل بیت هستی."],[854,"روز عاشورا نمی‌دانی که هست","ماتم جانی که از قرنی بهست","در روز عاشورا نمی‌دانی که چه ماتمی برپا است، برای جان‌هایی که از زمان‌های دور بر اثر ظلم و ستم از دست رفته‌اند."],[854,"پیش مؤمن کی بود این غصه خوار","قدر عشق گوش عشق گوشوار","برای مؤمن، این غم و اندوه ارزشمند نیست، چرا که عشق برای او ارزش و اهمیت ویژه‌ای دارد و او به عشق اولویت می‌دهد."],[854,"پیش مؤمن ماتم آن پاک‌روح","شهره‌تر باشد ز صد طوفان نوح","ماتم مؤمن و سوگ او به خاطر روح پاکش از هر فاجعه و طوفان بزرگ مانند طوفان نوح، بیشتر مورد توجه و اهمیت است."],[855,"گفت آری لیک کو دور یزید","کی بدست این غم چه دیر اینجا رسید","گفت:بله، ولی دوران یزید (واقعه عاشورا)گذشته است.این غم چه زمانی اتفاق افتاده؟خبرش چقدر دیر به اینجا رسید."],[855,"چشم کوران آن خسارت را بدید","گوش کران آن حکایت را شنید","حتی انسانهای کور آن خسارت(واقعهء عاشورا) را دیدند و انسانهای کر آن ماجرا را شنیدند."],[855,"خفته بودستید تا اکنون شما","که کنون جامه دریدیت از عزا","شما تا به حال خوابیده‌اید و بی‌خبر بوده‌اید، حالا که عزا برپا کرده‌اید و جامه‌تان را به نشانه عزاداری پاره کرده‌اید."],[855,"پس عزا بر خود کنید ای خفتگان","زانک بد مرگیست این خواب گران","خفتگان، حالا که در غفلت خوابیده‌اید، خود را در عزا قرار دهید، زیرا این خواب سنگین مانند مرگی بد است."],[855,"روح سلطانی ز زندانی بجست","جامه چون دریم ، چون خاییم دست","روح پادشاهی از زندان گریخت و در تن می‌پوشد، همچون خواب و بی‌خبری که به سراغ ما می‌آید."],[855,"چونک ایشان خسرو دین بوده‌اند","وقت شادی شد چو بشکستند بند","چون این افراد، پادشاه دین بوده‌اند، زمانی که شادی فرا رسید، زنجیرهای اسارت را شکستند."],[855,"سوی شادروان دولت تاختند","کنده و زنجیر را انداختند","به سوی خوشبختی و سعادت حرکت کردند و زنجیرها و بندهایی که مانع پیشرفتشان بود را کنار گذاشتند."],[855,"روز ملکست و کش و شاهنشهی","گر تو یک ذره ازیشان آگهی","روز قیامت و پادشاهی خداوند است، اگر تو درباره آن روز و مسائلش حتی کمترین آگاهی داشته باشی."],[855,"ور نه‌ای آگه برو بر خود گری","زانک در انکار نقل و محشری","اگر از آنچه گفته شد آگاه نیستی، به خودت سرزنش کن، زیرا انکار و بی‌توجهی به حقایق، تو را به عذابی بزرگ می‌کشاند."],[855,"بر دل و دین خرابت نوحه کن","که نمی‌بیند جز این خاک کهن","برای دل و دین ویران خود گناه و اندوه ببار، زیرا او جز این زمین قدیمی و بی‌حجاب چیزی نمی‌بیند."],[855,"ور همی‌بیند چرا نبود دلیر","پشتدار و جانسپار و چشم‌سیر","اگر کسی می‌بیند، چرا دلیر و شجاع نیست؟ چرا جانش را فدای حق نمی‌کند و تنها به تماشای ظاهری بسنده می‌کند؟"],[855,"در رخت کو از می دین فرخی","گر بدیدی بحر کو کف سخی","اگر در لباس می و دین و خوشی می‌نگریستی، دریای بزرگی را می‌دیدی که در آن کف (و حباب) سخی (بخشنده) است."],[855,"آنکه جو دید آب را نکند دریغ","خاصه آن کو دید آن دریا و میغ","کسی که جو (دانه‌ی گندم) را می‌بیند، از آب (معنویت و حقیقت) دریغ نمی‌کند، مخصوصا اگر کسی باشد که دریا و ابر را دیده باشد."],[856,"مور بر دانه بدان لرزان شود","که ز خرمن‌های خوش اعمی بود","موری که بر روی دانه‌ای لرزان شده، به این دلیل است که از خرمن‌های پربرکت و فراوانی که در اطرافش وجود دارد، بی‌خبر است."],[856,"می‌کشد آن دانه را با حرص و بیم","که نمی‌بیند چنان چاش کریم","مور با حرص و نگرانی دانه را می‌کشد، زیرا نمی‌داند که چه نعمت‌های فراوانی در دسترس اوست."],[856,"صاحب خرمن همی‌گوید که هی","ای ز کوری پیش تو معدوم شی","صاحب خرمن به آن موری که به خاطر کوری‌اش فقط به دنبال دانه‌ای می‌گردد، می‌گوید: ای نابینا، تو در اینجا وجودت در حال نابودی است و چیزی نمی‌بینی."],[856,"تو ز خرمن‌های ما آن دیده‌ای","که در آن دانه به جان پیچیده‌ای","تو از خرمن‌های ما فقط همانی را دیده‌ای که در آن دانه به جان خود چسبیده‌ای، یعنی تو فقط به ظاهر ماجرا توجه کرده‌ای و عمق و حکمت آن را درک نکرده‌ای."],[856,"ای به صورت ذره کیوان را ببین","مور لنگی ، رو سلیمان را ببین","ای کسی که در ظاهر کوچک و بی‌ارزش به نظر می‌رسی، مانند یک ذره، عالم بزرگ و بی‌نظیر مثل کیوان (زحل) را ببین و حالا به سلیمان (سلطانی بزرگ و با قدرت) نیز نگاه کن."],[856,"تو نه‌ای این جسم تو آن دیده‌ای","وارهی از جسم گر جان دیده‌ای","تو تنها این جسم نیستی، بلکه آن چیزی هستی که با آن می‌بینی. اگر جان و روح را ببینی و از این جسم جدا شوی، حقیقت وجودیت را درک می‌کنی."],[856,"آدمی دیده‌ست باقی گوشت و پوست","هرچه چشمش دیده است آن چیز اوست","انسان فقط ظاهر و بدن خود را می‌بیند و هرچه چشمش می‌بیند، برای او همان چیز واقعی است و به عمق وجود خود توجهی ندارد."],[856,"کوه را غرقه کند یک خم ز نم","منفذش چون باز باشد سوی یم","اگر دری چه کوچک باشد، می‌تواند کوه را زیر آب ببرد، اگر منفذ آن باز باشد و به دریا (یم) وصل شود. این سخن به قدرت و وسعت رحمت و عطای الهی اشاره دارد که می‌تواند به بهترین شکل کارها را انجام دهد."],[856,"چون به دریا راه شد از جان خم","خم با جیحون برآرد اشتلم","زمانی که خم شراب به دریا رسیده باشد، جان آن خم به شدت برمی‌خیزد و سر و صدایی مانند جیحون (رودخانه) ایجاد می‌کند."],[856,"زان سبب قل گفته دریا بود","هرچه نطق احمدی گویا بود","به همین دلیل، چیزی که دریا به آن اشاره می‌کند، به سخنانی که احمد (پیامبر اسلام) گفته است، مربوط می‌شود و نشان‌دهنده معنا و مفهوم عمیق‌تری است."],[856,"گفته او جمله در بحر بود","که دلش را بود در دریا نفوذ","آنچه او می‌گوید همگی در عمق دریا قرار دارد و نشان‌دهنده این است که دل او به عمق دریا نفوذ کرده و به راز و حقیقت‌ آن دست یافته است."],[856,"داد دریا چون ز خم ما بود","چه عجب در ماهیی دریا بود","هرگاه دریا از خم مای ما (آب جوشان) شکل بگیرد، چه شگفتی دارد که در ماهی، خود دریا وجود داشته باشد. اینجا اشاره به آن دارد که اگر ما بخواهیم می‌توانیم از دریا و روح بزرگ و بی‌نهایت بهره‌مند شویم، چراکه در وجود ما عمق و وسعتی به همان اندازه موجود است."],[856,"چشم حس افسرد بر نقش ممر","تش ممر می‌بینی و او مستقر","چشم حس انسان به چیزهای مادی و ظاهری معطوف است و فقط آنچه را که در مسیر زندگی می‌بیند، می‌تواند تصور کند. اما حقیقت و واقعیت عمیق‌تر و پایدارتر از آن‌اند که تنها با حس قابل درک باشند."],[856,"این دوی اوصاف دید احولست","ورنه اول آخر آخر اولست","این دو ویژگی (احول بودن و نابینایی) مختص کسی است که فقط با چشم حس خود به دنیا نگاه می‌کند، در حالی که حقیقت تمامی امور در ابتدا و انتهای آنها نهفته است."],[856,"هی ز چه معلوم گردد این ز بعث","بعث را جو ، کم کن اندر بعث بحث","از کجا می‌توان فهمید که بعث (برانگیختگی دوباره) چیست؟ برای درک بهتر (معنای) بعث، باید بحث را از مسائل این دنیا (زندگی) کم کنید و به این موضوع (بعث) بپردازید."],[856,"شرط روز بعث اول مردنست","زانک بعث از مرده زنده کردنست","برای به جان آمدن دوباره (بعث) لازم است ابتدا مردن و از بین رفتن اتفاق بیفتد، زیرا بعث به معنای زنده کردن دوباره کسانی است که مرده‌اند."],[856,"جمله عالم زین غلط کردند راه","کز عدم ترسند و آن آمد پناه","تمام دانشمندان به اشتباه راهی را انتخاب کرده‌اند که از عدم و نیستی می‌ترسند و این ترس به پناهی برای آنها تبدیل شده است."],[856,"از کجا جوییم علم از ترک علم","از کجا جوییم سلم از ترک سلم","ما چگونه می‌توانیم از بی‌علمی، علم به‌دست آوریم و یا از بی‌سلمی، سلم (صلح) بیابیم؟ این پرسش به این معناست که برای به‌دست آوردن چیزهای با ارزش، باید از منابع واقعی و صحیح استفاده کنیم، نه از ناکجاآباد."],[856,"از کجا جوییم هست از ترک هست","از کجا جوییم سیب از ترک دست","ما از کجا می‌توانیم وجود و هستی را پیدا کنیم، وقتی که از وجود و هستی دست می‌کشیم؟ و چطور می‌توانیم سیب یا نعمت‌های دیگر را بخواهیم وقتی که از تلاش برای به دست آوردن آن‌ها دست می‌کشیم؟"],[856,"هم تو تانی کرد یا نعم المعین","دیده معدوم‌بین را هست بین","تو همواره در حال تحلیل و تفسیر هستی، ولی چشمت قادر نیست واقعیت‌های واقعی را ببیند و فقط چیزهای معدوم و غیرواقعی را درک می‌کند."],[856,"دیده‌ای کو از عدم آمد پدید","ذات هستی را همه معدوم دید","چشم‌هایی که از عدم به وجود آمده‌اند، تمام وجود را به صورت ناپدید و معدوم می‌بینند. این اشاره به محدودیت ادراک انسانی دارد؛ اگر کسی فقط به آنچه که نیست فکر کند، نمی‌تواند به حقیقت هستی پی ببرد."],[856,"این جهان منتظم محشر شود","گر دو دیده مبدل و انور شود","اگر دو چشم انسان به درستی و واقع‌بینی تغییر یابند، این جهان منظم و مرتب مانند روز قیامت خواهد شد."],[856,"زان نماید این حقایق ناتمام","که برین خامان بود فهمش حرام","این حقایق ناتمام به این دلیل دیده می‌شود که درک آن برای افراد نادان و ناآگاه ممکن نیست."],[856,"نعمت جنات خوش بر دوزخی","شد محرم گرچه حق آمد سخی","نعمت‌های بهشتی برای کسانی که در زنجیر عذاب‌اند، محرمانه و پنهان شده است، گرچه حق تعالی بخشنده و سخی است."],[856,"در دهانش تلخ آید شهد خلد","چون نبود از وافیان عهد خلد","برای او که از دوستان و اهل بهشت خبر و عهدی ندارد، حتی شهد شیرین بهشت هم تلخ می‌نماید."],[856,"مر شما را نیز در سوداگری","دست کی جنبد چو نبود مشتری","شما نیز در تجارت و معامله خود هیچ حرکتی نخواهید کرد، زیرا مشتری و خواهان نیستید."],[856,"کی نظاره اهل بخریدن بود","آن نظاره گول گردیدن بود","کسی که در حال خرید و معامله است، نمی‌تواند به دور و بر خود و کسانی که او را فریب می‌دهند، توجه کند و تنها درگیر خرید و فروش است."],[856,"پرس پرسان «کاین به چند و آن به چند»","از پی تعبیر وقت و ریش‌خند","مرد حریص به دنبال فهم قیمت‌ها و ارزش چیزهاست و برای این‌کار مدام سؤال می‌کند، در حالی که به مسخره و ریش‌خند می‌پردازد و در جستجوی معنای واقعی وقت و موقعیت خود می‌باشد."],[856,"از ملولی کاله می‌خواهد ز تو","نیست آن کس مشتری و کاله‌جو","از خسته‌ای به تو تقاضا دارد که کالایی بدهی، اما این شخص هیچ خریدار و خواهان واقعی نیست."],[856,"کاله را صد بار دید و باز داد","جامه کی پیمود او پیمود باد","مرد حریص بارها و بارها به دنبال کالاهای دنیا می‌گردد و حتی اگر لباس‌های جدیدی ببیند، باز هم از آنچه دارد راضی نیست و همواره در حال جست‌وجو برای کسب بیشتری است، اما در این بین به عمق نیازهای واقعی خود و معنای زندگی توجهی ندارد."],[856,"کو قدوم و کرّ و فر مشتری","کو مزاح گنگلی سرسری","ای شخصی که بی‌دقت در جست‌وجوی دنیا هستی، چرا متوجه ظهور نعمت‌های بزرگ و فراوانی که در اطرافت هستی، نمی‌شوی؟ چرا در پی اشیای پایین و کم‌اهمیت می‌روی و از عظمت خیرها و برکات ناشناخته غافلی؟"],[856,"چونک در ملکش نباشد حبه‌ای","جز پی گنگل چه جوید جبه‌ای","چون در ملک این مرد هیچ دانه‌ای نیست، فقط به دنبال چیزهایی بی‌اهمیت می‌گردد و هرگز به دنبال چیز ارزشمندی نمی‌رود."],[856,"در تجارت نیستش سرمایه‌ای","پس چه شخص زشت او چه سایه‌ای","این شخص در کسب و کار و تجارت هیچ گونه سرمایه‌ای ندارد، بنابراین نه تنها خود او به عنوان یک انسان زشت و بی‌فایده است، بلکه وضعیت او به مانند سایه‌ای بی‌معناست."],[856,"مایه در بازار این دنیا زرست","مایه آنجا عشق و دو چشم ترست","سرمایه و دارایی در دنیا، مال و ثروت است، اما در آن جهان، بزرگ‌ترین سرمایه عشق و اشک‌های پر از محبت است."],[856,"هر که او بی‌مایه‌ای بازار رفت","عمر رفت و بازگشت او خام تفت","هر کسی که بدون کسب دانش و آگاهی به این دنیا قدم گذاشته و در بستر زندگی (بازار) مشغول به کار است، عمرش به هدر رفته و در نهایت به بی‌نتیجه‌ای بازگشته است."],[856,"هی کجا بودی برادر هیچ جا","هی چه پختی بهر خوردن هیچ با","ای برادر، تو کجا بودی که در هیچ‌جا نبودنت احساس نمی‌شود؟ آیا برای خوردن چه چیزی آماده کردی؟ هیچ چیزی را برای خود نپخته‌ای."],[856,"مشتری شو تا بجنبد دست من","لعل زاید معدن آبست من","خود را به عنوان خریدار نشان بده تا دست من حرکت کند، زیرا لعل (گوهر) از معدن آب‌های من به وجود می‌آید."],[856,"مشتری گرچه که سست و باردست","دعوت دین کن که دعوت واردست","هرچند مشتری (خریدار) ممکن است ضعیف و بی‌استقامت باشد، اما او را به دعوت دین دعوت کن، زیرا این دعوت حقیقی و مهم است."],[856,"باز پران کن حمام روح گیر","در ره دعوت طریق نوح گیر","باز دست خود را برای پرواز آزاد کن و در مسیر دعوت به دین، مانند نوح پیامبر (که به نجات دریا رفت) حرکت کن. بانگ دعوت تو را به سوی معنویات و روحانیت بکشاند."],[856,"خدمتی می‌کن برای کردگار","با قبول و رد خلقانت چه کار","برای خداوند خدمت کن و نگران تأیید یا رد مردم نباش. آنچه مهم است، نیت و عمل خالص تو در راستای خداست."],[857,"آن یکی می‌زد سحوری بر دری","درگهی بود و رواق مهتری","مردی در نیمه شب به در خانه‌ای می‌کوبید که در آن یک مهتر (سرپرست) زندگی می‌کرد."],[857,"نیم‌شب می‌زد سحوری را به جد","گفت او را قایلی کای مستمد","در نیمه‌شب، شخصی به در خانه‌ای می‌کوبید و کسی که شاهد این حالت بود، به او گفت: «ای بی‌خبر! چرا در این وقت برای چه کسی سحری می‌کوبی؟"],[857,"اولا وقت سحر زن این سحور","نیم‌شب نبود گه این شر و شور","زمان سحر، نیم‌شب نیست و این شلوغی و سر و صدا به جا نیست."],[857,"دیگر آنک فهم کن ای بوالهوس","که درین خانه درون خود هست کس","ای انسان هوسباز، این را درک کن که در این خانه، درون خود تو هیچ کس وجود ندارد."],[857,"کس درینجا نیست جز دیو و پری","روزگار خود چه یاوه می‌بری‌؟","در اینجا هیچ‌کس جز موجودات بی‌خود و افسانه‌ای وجود ندارد، پس چه چیزی را با این حرف‌ها و سخنان بی‌معنی بیان می‌کنی؟"],[857,"بهر گوشی می‌زنی دف‌، گوش کو‌؟","هوش باید تا بداند‌، هوش کو‌؟","برای چه کسی دف می‌زنی؟ گوش که کجاست؟ باید هوشیاری و درک داشته باشی تا بفهمی، پس هوشیاری کجاست؟"],[857,"گفت گفتی بشنو از چاکر جواب","تا نمانی در تحیر و اضطراب","گفتی (شما) بشنو از خدمت‌گذار (مطرب) پاسخ را تا در حیرت و آشفتگی نمانی."],[857,"گرچه هست این دم بر تو نیم‌شب","نزد من نزدیک شد صبح طرب","هرچند که اکنون شب است و تو به گمان نیمه شب در اینجا ایستاده‌ای، اما برای من صبح شادی و سرور نزدیک شده است."],[857,"هر شکستی پیش من پیروز شد","جمله شب‌ها پیش چشمم روز شد","هر شکستی که بر من وارد شد، در نظر من به نوعی پیروزی درآمد و هر شب، زمانی که به نظر می‌رسید تاریکی و ناامیدی است، در برابر چشمانم به روشنایی و روز تبدیل شد."],[857,"پیش تو خون است آب رود نیل","نزد من خون نیست آبست ای نبیل","نزد تو خون شرافتمندانه است و به دلیل وضعیت دشوار من، آب نیل هم در نزد من به اندازه خون ناپاک و بی‌ارزش است، ای بزرگوار."],[857,"در حق تو آهن است آن و رخام","پیش داود نبی موم است و رام","در مورد تو، آهن و رخام وجود دارند و نشان‌دهنده سختی و استحکام هستند، اما در برابر داود پیامبر، موم و نرم بودن را نشان می‌دهند. به این معنی که او توانایی نرم کردن و شکل دادن به سختی‌ها را دارد."],[857,"پیش تو که بس گران است و جماد","مطرب است او پیش داود اوستاد","در برابر تو، سنگ و کوه سنگین و بی‌حرکت هستند، اما از نظر داود نبی، این سنگ‌ها می‌توانند سازنده و هنرمند به حساب بیایند."],[857,"پیش تو آن سنگ‌ریزه ساکت است","پیش احمد او فصیح و قانت است","در حضور تو، آن سنگ‌ریزه ساکت و بی‌صدا است، اما در حضور پیامبر احمد، آن سنگ‌ریزه زبان باز کرده و به زیبا سخن می‌گوید و در خدمت اوست."],[857,"پیش تو استون مسجد مرده‌ایست","پیش احمد عاشقی دل برده‌ایست","در برابر تو، درخت مسجد بی‌حیات و بی‌تحرک است، اما در حضور احمد (احمد، پیامبر اسلام) عشق و شور و شوقی زنده وجود دارد که دل‌ها را می‌رباید."],[857,"جمله اجزای جهان پیش عوام","مرده و پیش خدا دانا و رام","اجزای جهان برای عوام به شکل مرده و بی‌فایده‌اند، اما در نظر خداوند، به دانشی عمیق و تسلیم‌شدگی قابل فهم هستند."],[857,"آنچ گفتی کاندرین خانه و سرا","نیست کس چون می‌زنی این طبل را","شما که می‌گویی در این خانه و مکان کسی نیست، چرا این‌گونه طبل می‌زنی؟"],[857,"بهر حق این خلق زرها می‌دهند","صد اساس خیر و مسجد می‌نهند","برای رسیدن به حق، این مردم پول‌های زیادی می‌دهند و زیرساخت‌های نیکو و مساجد می‌سازند."],[857,"مال و تن در راه حج دوردست","خوش همی‌بازند چون عشاق مست","افراد با مال و جسم خود به سفر حج در سرزمین‌های دور می‌روند و مانند عاشقانی مست و سرمست از عشق خدا، از هیچ چیز نمی‌هراسند و با شوق و اشتیاق این راه را طی می‌کنند."],[857,"هیچ می‌گویند کان خانه تهی‌ست","بلک صاحب‌خانه جان مختبی‌ست","در این بیت، اشاره به این است که اگرچه به ظاهر آن خانه خالی و تهی به نظر می‌رسد، اما در واقع صاحب‌خانه، یعنی وجود خدا یا حقیقتی عمیق‌تر، در آنجا حضور دارد و از آنجا می‌تواند جان‌ها و دل‌ها را درک کند."],[857,"پر همی‌بیند سرای دوست را","آنک از نور الهستش ضیا","آن کسی که در آن خانه‌ خالی، در دل شب می‌زند بر در، می‌بیند که سرای دوستش پر از نور الهی است و این نور از خود خدا ناشی می‌شود."],[857,"بس سرای پر ز جمع و انبهی","پیش چشم عاقبت‌بینان تهی","سرای خداوند بسیار پر از جمعیت و شلوغ است، اما برای کسانی که عاقبت‌اندیش و هوشیار هستند، این سرای ظاهری در نهایت خالی و بی‌معنا است."],[857,"هر که را خواهی تو در کعبه بجو","تا بروید در زمان او پیش رو","هر کسی را که می‌خواهی در کعبه بیاب، زیرا در زمان او می‌تواند در برابر تو بیاید."],[857,"صورتی کاو فاخر و عالی بود","او ز بیت الله کی خالی بود","او (خدا) صورت و شکلی بلندمرتبه و باشکوه دارد، آیا می‌تواند از خانه خدا، یعنی کعبه، خالی باشد؟"],[857,"او بود حاضر منزه از رتاج","باقی مردم برای احتیاج","او در میان مردم، تنها و پاک است و از زرق و برق و جاه و مقام دیگران رهایی یافته، زیرا به نیازی احساس نمی‌کند."],[857,"هیچ می‌گویند کاین لبیک‌ها","بی‌ندایی می‌کنیم آخر چرا","می‌پرسند چرا ما به این نداهای لبیک پاسخ می‌دهیم در حالی که هیچ صدایی وجود ندارد."],[857,"بلک توفیقی که لبیک آورد","هست هر لحظه ندایی از احد","توفیق و اقبال هر فردی به این است که هر لحظه صدای ندا یا الهامی از حق را بشنود و پاسخ دهد."],[857,"من ببو دانم که این قصر و سرا","بزم جان افتاد و خاکش کیمیا","من می‌دانم که این قصر و خانه، محلی برای شادی و بزم روح شده است و خاک این جا، به مانند کیمیا ارزشمند و گرانبهاست."],[857,"مس خود را بر طریق زیر و بم","تا ابد بر کیمیااش می‌زنم","من پیوسته در حالت زیر و بم (در نوسان) خود را روی کیمیا می‌زنم تا به ابد ادامه دهم."],[857,"تا بجوشد زین چنین ضرب سحور","در درافشانی و بخشایش بحور","از این ضربه‌هایی که در نیمه‌شب به در می‌زنم، باید برکات و نعمت‌های زیادی به وجود بیاید و به نوعی، بهره‌مندی‌های زیادی به‌وجود آید."],[857,"خلق در صف قتال و کارزار","جان همی‌بازند بهر کردگار","مردم در صف جنگ و نبرد به خاطر خدا جان خود را به خطر می‌اندازند."],[857,"آن یکی اندر بلا ایوب‌وار","وان دگر در صابری یعقوب‌وار","یکی از مردم در مشکلات به سختی ایوب (که معروف به صبرش است) شبیه است، و فرد دیگری در صبوری مانند یعقوب (که به خاطر غم دوری فرزندش صبر کرد)."],[857,"صد هزاران خلق تشنه و مستمند","بهر حق از طمع جهدی می‌کنند","بسیاری از مردم نیازمند و تشنه هستند و به خاطر خدای حق‌طلبی و تلاش می‌کنند، بدون اینکه به دنبال منافع شخصی خود باشند."],[857,"من هم از بهر خداوند غفور","می‌زنم بر در به اومیدش سحور","من به خاطر خداوند بخشنده و مهربان به در این خانه می‌زنم تا امیدی به دست آورم."],[857,"مشتری خواهی که از وی زر بری","به ز حق کی باشد ای دل مشتری","اگر می‌خواهی که از خداوند، خیر و برکت و نعمت به دست بیاوری، باید اول از حق و حقیقت، طلب‌های خودت را بخواهی و نه از غیر."],[857,"می‌خرد از مالت انبانی نجس","می‌دهد نور ضمیری مقتبس","از مال تو چیزی می‌گیرد که خود ناپاک و نادرست است، اما در عوض، به تو روحی پاک و نورانی می‌دهد که از دل و ضمیر واقعی به دست آمده است."],[857,"می‌ستاند این یخ جسم فنا","می‌دهد ملکی برون از وهم ما","این بیت به این معناست که چیزی که از این بدن فانی و مادی گرفته می‌شود، در عوض، وجودی ماورایی و فراتر از تصور ما به ما عطا می‌کند."],[857,"می‌ستاند قطره چندی ز اشک","می‌دهد کوثر که آرد قند رشک","چند قطره اشک از چشمان انسان می‌گیرد و به جای آن، نوشیدنی بهشتی (کوثر) می‌دهد که شیرینی‌اش مانند قند است و باعث حس حسرت دیگران می‌شود."],[857,"می‌ستاند آه پر سودا و دود","می‌دهد هر آه را صد جاه سود","هر آه پر از غم و اندوه مانند دودی است که چیزهای ارزشمند و بسیاری را به همراه خود می‌آورد. این اشک‌ها و آه‌ها قدرت و تاثیر زیادی دارند و می‌توانند به جاهای مختلفی برسند و سودمند باشند."],[857,"باد آهی که ابر اشک چشم راند","مر خلیلی را بدان اواه خواند","بادی که آه و اشک چشم را از ابرها می‌راند، خلیلی را به خاطر همین آه‌ها می‌خواند."],[857,"هین درین بازار گرم بی‌نظیر","کهنه‌ها بفروش و ملک نقد گیر","در این بازار پررونق و بی‌نظیر، اجناس کهنه‌ای را بفروش و به جای آن، مال و ثروت واقعی به دست آور."],[857,"ور ترا شکی و ریبی ره زند","تاجران انبیا را کن سند","اگر تو شکی و تردیدی به دل داری، در این حالت، به تاجران (بازرگانان) و پیامبران (انبیا) نیز شک خواهی کرد، پس اسناد و مدارک آن‌ها را بررسی کن تا به یقین برسی."],[857,"بس که افزود آن شهنشه بختشان","می‌نتاند که کشیدن رختشان","به اندازه‌ای خوشبختی آن پادشاه (شهنشه) بر آنها افزوده شده که دیگر نمی‌تواند به طور طبیعی بار سفر را بر دوش بگذارد."],[858,"تن فدای خار می‌کرد آن بلال","خواجه‌اش می‌زد برای گوشمال","بلال، برای محبتش به پیامبر (احمد) و به خاطر دفاع از او، جانش را فدای خارهایی می‌کرد که خواجه‌اش به خاطر تعصبش به او می‌زد. او حاضرجوابی می‌کرد و از درد می‌کشید، ولی عشقش به پیامبر او را توانگر کرده بود."],[858,"که چرا تو یاد احمد می‌کنی","بنده بد منکر دین منی","در این بیت، گوینده از کسی می‌پرسد که چرا به یاد احمد، یعنی پیامبر اسلام، می‌افتد، در حالی که خود او بنده‌ای بد و منکر دین است. این پرسش نشان‌دهنده تضاد میان محبت به پیامبر و رفتار ناپسند خود فرد است."],[858,"می‌زد اندر آفتابش او به خار","او احد می‌گفت بهر افتخار","بلال، که بخاطر عشق به پیامبر اسلام، دچار زخم و درد شده بود، در زیر آفتاب شدید، خارها را از بدنش می‌کند و هر بار که آن‌ها را بیرون می‌آورد، نام «احد» را با افتخار بر زبان می‌آورد. این کار او به خاطر عشق و ارادتش به پیامبر است."],[858,"تا که صدیق آن طرف بر می‌گذشت","آن احد گفتن به گوش او برفت","در این بیت، بلال که به عشق پیامبر(ص) نام «احد» را می‌برد، متوجه می‌شود صداقت و پاکی قلب او (صدیق)، باعث می‌شود که این کلام به گوش او برسد و از محبت بلال بی‌خبر نماند."],[858,"چشم او پر آب شد دل پر عنا","زان احد می‌یافت بوی آشنا","چشم بلال از محبت و عشق به پیامبر (مصطفی) پر از اشک شد و دلش پر از غم و دلتنگی گشت؛ زیرا آن صدا (یک‌بار دیگر) احساس نزدیکی و آشنایی به او می‌دهد."],[858,"بعد از آن خلوت بدیدش پند داد","کز جهودان خفیه می‌دار اعتقاد","پس از آنکه بلال در آن خلوت به درد و عشق خود اشاره کرد، به او پندی داده شد که باید از یهودیان که به صورت پنهانی در دل خود کینه می‌دارند، دوری کند و به عقاید آنها اعتقاد نداشته باشد."],[858,"عالم السرست پنهان دار کام","گفت کردم توبه پیشت ای همام","من به رازهای عالم، که در دل پنهان است، آگاه هستم و آن را پنهان نگه می‌دارم. به تو، ای همام (همام، یکی از لقب‌های بلال)، گفتم که از گناهانم توبه کرده‌ام."],[858,"روز دیگر از پگه صدیق تفت","آن طرف از بهر کاری می‌برفت","روز دیگر، ابوبکر صدیق برای انجام کاری به سمت آن منطقه (تفت) می‌رفت."],[858,"باز احد بشنید و ضرب زخم خار","برفروزید از دلش سوز و شرار","بلال دوباره ندا کرد \"احد\" و زخم خار که به او زده‌اند، آتش و سوزشی از دلش برانگیخت."],[858,"باز پندش داد باز او توبه کرد","عشق آمد توبه او را بخورد","بلال دوباره نصیحتی شنید و تصمیم به توبه گرفت، اما عشق آن چنان در دلش جای دارد که توبه‌اش را تحت تأثیر قرار داد و به نوعی از بین برد."],[858,"توبه کردن زین نمط بسیار شد","عاقبت از توبه او بیزار شد","توبه کردن به این روش بسیار شد، اما در نهایت او از توبه‌اش خسته و بیزار شد."],[858,"فاش کرد اسپرد تن را در بلا","کای محمد ای عدو توبه‌ها","در این بیت، بلال با صدای بلند و به طور آشکار از درد و مشکلاتی که به خاطر محبت به پیامبر، محمد، تحمل کرده است، صحبت می‌کند و به او می‌گوید که آیا او دشمنی است که توبه‌ها را فاش می‌کند، به این معنا که از عشق به پیامبر هیچ چیزی نمی‌تواند او را وادار به بازگشت کند."],[858,"ای تن من وی رگ من پر ز تو","توبه را گنجا کجا باشد درو","یا ای بدن من، ای رگ و پی من، تو تمام وجودم را پر کرده‌ای از محبت تو، پس هیچ جایی برای توبه و بازگشت به پشیمانی در وجود من باقی نمی‌ماند."],[858,"توبه را زین پس ز دل بیرون کنم","از حیات خلد توبه چون کنم","از این پس توبه را از دل خود خارج می‌کنم، چون چگونه می‌توانم از بهشت زندگی و لذت‌ها توبه کنم؟"],[858,"عشق قهارست و من مقهور عشق","چون شکر شیرین شدم از شور عشق","عشق گونه‌ای نیروی قوی و تسلیم‌کننده است و من در برابر آن مانند شکر که در شیر حل می‌شود، به خاطر شور و شوقی که از عشق دارم، شیرین شده‌ام."],[858,"برگ کاهم پیش تو ای تند باد","من چه دانم که کجا خواهم فتاد","ای باد تند، من که به سرنوشت خود آگاهی ندارم و نمی‌دانم به کجا خواهم رسید، تنها برگ کاهم که در مقابل تو هستم."],[858,"گر هلالم گر بلالم می‌دوم","مقتدی آفتابت می‌شوم","هر چند که هلالم (ماه نو) یا بلالم (بلال، مؤذن و دوست پیامبر) هستم، به دنبال تو (آفتاب، نماد پیامبر) می‌روم و در خانه‌ات به پیروی تو هستم."],[858,"ماه را با زفتی و زاری چه کار","در پی خورشید پوید سایه‌وار","ماه (نماد زیبایی یا احوالات) در آغوش غم و ناله، چه نیازی به دنبال کردن خورشید (محبوب یا هدف) دارد، مانند سایه‌ای که به دنباله خورشید می‌رود. اینجا بیان می‌کند که در شرایط سخت و غم، اهمیت دنبال کردن هدف واقعی کم‌رنگ می‌شود."],[858,"با قضا هر کو قراری می‌دهد","ریش‌خند سبلت خود می‌کند","هر کسی که با قضا و سرنوشت خود سازش کند، در واقع به خنده و تمسخر در زندگی خود می‌پردازد و این کار مانند طنز و ریشخند به وضعیتی است که در آن قرار دارد."],[858,"کاه‌برگی پیش باد آنگه قرار","رستخیزی وانگهانی عزم‌کار","انسانی که در برابر مشکلات و دشواری‌ها مانند کاه‌برگی بی‌اراده است، ناگهان دچار تحول و برانگیختگی می‌شود و تصمیم‌های جدید می‌گیرد. این وضعیت نشان‌دهنده ناپایداری و بی‌ثباتی انسان در مواجهه با حوادث زندگی است."],[858,"گربه در انبانم اندر دست عشق","یک‌دمی بالا و یک‌دم پست عشق","اگر محبت و عشق واقعی در دل انسان باشد، او می‌تواند در حالت‌های مختلفی باشد؛ گاهی در اوج خوشحالی و شوق (بالا) و گاهی در حال غم و اندوه (پست). عشق انسان را از زمین و زمان غافل می‌کند و به او حالاتی متضاد می‌دهد."],[858,"او همی‌گرداندم بر گرد سر","نه به زیر آرام دارم نه زبر","بلال، به خاطر شدتش در عشق و محبت به پیامبر اسلام، در حالتی است که نه آرامش دارد و نه می‌تواند سرگردانی‌اش را به حالت دیگری تغییر دهد. او در گیر و دار عشق، به دور خود می‌چرخد و هیچ نشانه‌ای از سکون در او نیست."],[858,"عاشقان در سیل تند افتاده‌اند","بر قضای عشق دل بنهاده‌اند","عاشقان در چنگال شدید عشق گرفتار شده‌اند و تمام دل و وجودشان را به محبت سپردند."],[858,"هم‌چو سنگ آسیا اندر مدار","روز و شب گردان و نالان بی‌قرار","مانند سنگ‌های آسیاب که در چرخش مداوم روز و شب، همیشه در حرکت و ناله هستند، عشق به خداوند نیز انسان را در حالت بی‌قراری و تلاطم قرار می‌دهد."],[858,"گردشش بر جوی جویان شاهدست","تا نگوید کس که آن جو راکدست","حرکت و دوران آب در جوی، نشان‌دهنده جریان و زندگی آن است، بنابراین هیچ‌کس نمی‌تواند بگوید که آن آب ساکن یا بی‌حرکت است."],[858,"گر نمی‌بینی تو جو را در کمین","گردش دولاب گردونی ببین","اگر تو جوی را به‌وضوح نمی‌بینی، گردش چرخش گردون (دنیا) را مشاهده کن که در کمین آن است."],[858,"چون قراری نیست گردون را ازو","ای دل اختروار آرامی مجو","ای دل، از آنجا که هیچگونه ثبات و آرامشی در گردش زمان (گردون) وجود ندارد، پس به دنبال آرامش در این دنیا نباش."],[858,"گر زنی در شاخ دستی کی هلد","هر کجا پیوند سازی بسکلد","اگر دستت را به شاخه‌ای بزنی، هر جا که پیوندی برقرار کنی، به زمین می‌افتد و خراب می‌شود."],[858,"گر نمی‌بینی تو تدویر قدر","در عناصر جوشش و گردش نگر","اگر تو تدبیر و سرنوشت را در عناصر و تغییرات طبیعی نمی‌بینی، به جوشش و حرکت آن‌ها توجه کن."],[858,"زانک گردشهای آن خاشاک و کف","باشد از غلیان بحر با شرف","چراکه حرکت‌های آن زباله‌ها و کف روی آب، ناشی از جوشش و خروش عظیم دریا است."],[858,"باد سرگردان ببین اندر خروش","پیش امرش موج دریا بین بجوش","به حرکت و خروش باد توجه کن که همچون امری قوی موج‌های دریا را به جوش می‌آورد و به جنبش درمی‌آورد."],[858,"آفتاب و ماه دو گاو خراس","گرد می‌گردند و می‌دارند پاس","آفتاب و ماه مانند دو گاوی هستند که به دور خراسان (سرزمین نور) می‌چرخند و از آنجا نگهبانی می‌کنند."],[858,"اختران هم خانه خانه می‌دوند","مرکب هر سعد و نحسی می‌شوند","ستاره‌ها در آسمان هر کدام به سمت خاصی می‌دوند و ترکیب آنها می‌تواند خوب یا بد باشد."],[858,"اختران چرخ گر دورند هی","وین حواست کاهل‌اند و سست‌پی","اگر ستاره‌ها در آسمان دور هستند، این تو هستی که بی‌توجه و سست‌قدم به آنها می‌نگری و انگیزه‌ای برای حرکت و تلاش نداری."],[858,"اختران چشم و گوش و هوش ما","شب کجااند و به بیداری کجا","اختران، که در اینجا به معنای عقل و توجه ماست، در هنگام شب غایب هستند و در زمان بیداری نیز از ما دورند. این اشاره به وضعیت ذهنی و معنوی انسان دارد که در بیداری از درک صحیح و آگاهی باز می‌ماند."],[858,"گاه در سعد و وصال و دلخوشی","گاه در نحس فراق و بیهشی","زندگی انسان گهگاه با خوشی و وصال همراه است و گاهی اوقات او با جدایی و بی‌خبری مواجه می‌شود."],[858,"ماه گردون چون درین گردیدنست","گاه تاریک و زمانی روشنست","زندگی و دنیا مانند ماه است که گاهی در تاریکی و گاهی در روشنی قرار می‌گیرد. این تغییرات نشان‌دهنده نوسان‌های زندگی و حال و روز انسان‌هاست."],[858,"گه بهار و صیف هم‌چون شهد و شیر","گه سیاستگاه برف و زمهریر","فصل‌ها و تغییرات زمان مانند شهد شیرین و هوای خوش بهار و همچنین سردی و سختی زمستان هستند. در این دنیا، گاهی اوضاع تغییر می‌کند و به شادی و رونق و گاهی به سرما و سختی می‌انجامد."],[858,"چونک کلیات پیش او چو گوست","سخره و سجده کن چوگان اوست","وقتی که کلیات و مجموع‌های بزرگ علم و معرفت در برابر اوست، مانند گوسفندی که در پیش‌بینی او و به احترامش سر فرود می‌آورد، او همانند چوگان است که بر زمین می‌زند و حرکتش همه چیز را تحت تأثیر قرار می‌دهد."],[858,"تو که یک جزوی دلا زین صدهزار","چون نباشی پیش حکمش بی‌قرار","تو که یکی از این همه بندگان هستی، چرا با این همه جمعیت، در برابر فرمان او آرام نیستی؟"],[858,"چون ستوری باش در حکم امیر","گه در آخر حبس گاهی در مسیر","مثل این است که تو مانند اسبی باشی که در دست امیر است؛ گاهی در حبس و گاهی در راه، یعنی در دست تقدیر و سرنوشت، تو دچار بی‌ثباتی و تغییراتی خواهی شد."],[858,"چونک بر میخت ببندد بسته باش","چونک بگشاید برو بر جسته باش","زمانی که بر تو سختی‌ها و مشکلات وارد می‌شود، باید صبور باشی و خودت را ببندی؛ اما زمانی که فرصت یا موقعیتی پیش آمد، باید خودت را برای استفاده از آن فرصت باز کنی و آماده باشی."],[858,"آفتاب اندر فلک کژ می‌جهد","در سیه‌رویی خسوفش می‌دهد","خورشید در آسمان به شکل کج و غیرعادی حرکت می‌کند و این حرکت ناهنجار، به تاریکی و سیاهی خفاش اشاره دارد."],[858,"کز ذنب پرهیز کن هین هوش‌دار","تا نگردی تو سیه‌رو دیگ‌وار","از گناه دوری کن و هوشیار باش، تا مانند دیگی سیاه نشوی، یعنی در اثر نافرمانی و گناه دچار عذاب و رسوایی نشوی."],[858,"ابر را هم تازیانه آتشین","می‌زنندش کانچنان رو نه چنین","ابر را نیز با تازیانه‌ای از آتش می‌زنند، زیرا اینگونه رو به سوی او نمی‌آید و چنین نیست که به او توجه کند."],[858,"بر فلان وادی ببار این سو مبار","گوشمالش می‌دهد که گوش دار","در این بیت، اشاره به یک منطقه خاص (وادی) دارد که از خداوند طلب باران می‌شود. در واقع، به‌دلیل ناشنوا بودن بعضی انسان‌ها نسبت به نشانه‌های الهی، در اینجا بیان می‌شود که خداوند به‌واسطه این باران، درسی برای آن‌ها خواهد داشت تا متوجه شوند و به پیام‌های معنوی گوش بسپارند."],[858,"عقل تو از آفتابی بیش نیست","اندر آن فکری که نهی آمد مایست","عقل تو تنها به اندازه نور خورشید است و در اندیشه‌ای که تو را از حقیقت دور کند، جایگاهی ندارد."],[858,"کژ منه ای عقل تو هم گام خویش","تا نیاید آن خسوف رو به پیش","ای عقل، قدم‌های خود را کج نگذار و در مسیر خود بی‌راهه نرو، تا آن خسوف (کسوف یا تاریکی) به جلو نیاید و مانع روشنی‌ات نشود."],[858,"چون گنه کمتر بود نیم آفتاب","منکسف بینی و نیمی نورتاب","وقتی که گناه کمتر باشد، تنها نیمی از تابش آفتاب را می‌بینی که در حال غروب است و نیمی دیگر هم روشنایی دارد."],[858,"که به قدر جرم می‌گیرم ترا","این بود تقریر در داد و جزا","من به اندازه گناهت از تو پذیرش می‌کنم، این موضوعی است که در قضا و قدر مطرح می‌شود."],[858,"خواه نیک و خواه بد فاش و ستیر","بر همه اشیا سمیعیم و بصیر","هم نیک و هم بد، ما بر همه اشیاء در شنیدن و دیدن تسلط داریم و هیچ چیزی از نگاه ما پنهان نیست."],[858,"زین گذر کن ای پدر نوروز شد","خلق از خلاق خوش پدفوز شد","این بیت به پدر (یا خالق) خطاب می‌کند و می‌گوید که از این مراحل عبور کن، زیرا جشنی به نام نوروز فرارسیده است که به خاطر خالق نیکو، از عمل شیطان و شر و بدی پاک شده است. نوروز به عنوان نماد Renewal و تجدید حیات و شادی معرفی می‌شود."],[858,"باز آمد آب جان در جوی ما","باز آمد شاه ما در کوی ما","آب جان به معنای حیات و زندگی دوباره به جوی ما برگشته است و همچنین شاه ما، یعنی حضرت محمد (علیه‌السلام)، دوباره به کوی ما آمده است. به طور کلی، این بیت به بازگشت خوشبختی و سعادت در زندگی اشاره دارد."],[858,"می‌خرامد بخت و دامن می‌کشد","نوبت توبه شکستن می‌زند","بخت (سرنوشت) به آرامی پیش می‌رود و دامن خود را می‌کشد، زمان برای شکستن توبه فرا رسیده است."],[858,"توبه را بار دگر سیلاب برد","فرصت آمد پاسبان را خواب برد","توبه دوباره با طوفانی از بین رفت و فرصت مناسب برای توبه پیش آمد در حالی که نگهبان خوابش برده بود."],[858,"هر خماری مست گشت و باده خورد","رخت را امشب گرو خواهیم کرد","امشب به خاطر خماری و مستی، می‌خواهیم لباس خود را گرو بگذاریم تا باده بنوشیم."],[858,"زان شراب لعل جان جان‌فزا","لعل اندر لعل اندر لعل ما","از آن شراب سرخ و خوشبو که جان را صفا می‌بخشد، اجتماعی از زیبایی و لطافت است که در یکدیگر وجود دارد. این اشاره به چندلایه بودن زیبایی و تأثیر آن بر روح است."],[858,"باز خرم گشت مجلس دلفروز","خیز دفع چشم بد اسپند سوز","مجلس دوباره شاداب و سرزنده شد. برخیز و با سوزاندن اسپند، چشم بد را از بین ببر."],[858,"نعره مستان خوش می‌آیدم","تا ابد جانا چنین می‌بایدم","نعره‌های عاشقانه و شاداب من تا همیشه خوشایند است، ای جانم، که باید اینگونه باشد."],[858,"نک هلالی با بلالی یار شد","زخم خار او را گل و گلزار شد","بلالی (بلال) با محبت و عشق به پیامبر (مصطفی) همچون هلالی (به معنای روشنی و زیبایی) است. زخم خار، در عین درد، او را به مانند گل و گلزار، زیبا و خوشبو کرده است."],[858,"گر ز زخم خار تن غربال شد","جان و جسمم گلشن اقبال شد","اگرچه تنم از زخم خار به شدت آسیب دیده و مثل غربال شده، اما روح و جانم به لطف عشق تبدیل به گلستان و محلی از خوشبختی گردیده است."],[858,"تن به پیش زخم خار آن جهود","جان من مست و خراب آن ودود","در این بیت، بلال (که به محبت پیامبر مصطفی علیه‌السلام مشهور است) می‌گوید که جسم او (بدن بلال) در برابر زخم خار یک یهودی (که به او جفا می‌کند) قرار دارد، ولی روح و جان او در عشق بسیار قوی و خراب است. در واقع، عشق واقعی به پیامبر روح او را پر کرده و او را مست و بی‌خود کرده است."],[858,"بوی جانی سوی جانم می‌رسد","بوی یار مهربانم می‌رسد","بوی محبت و عشق از سوی محبوبم به جانم می‌رسد و احساسی عمیق و دلنشین را در وجودم به وجود می‌آورد."],[858,"از سوی معراج آمد مصطفی","بر بلالش حبذا لی حبذا","پس از معراج، پیامبر مصطفی (ص) به بلال، مؤذن مشهور، می‌گوید که چه خوب است و چه زیباست که تو را دوست دارم."],[858,"چونک صدیق از بلال دم‌درست","این شنید از توبه او دست شست","چون صدیق (ابوبکر) صداقت و راستگویی بلال را شنید، از توبه و برگرداندن او به سوی خدا خوشحال شد و به خدمت او شتافت."],[859,"بعد از آن صدیق پیش مصطفی","گفت حال آن بلال با وفا","بعد از آن، صدیق (ابوبکر) نزد پیامبر (مصطفی) آمد و درباره حالت بلال، که انسانی وفادار و باوفا است، سخن گفت."],[859,"کان فلک‌پیمای میمون‌بال چست","این زمان در عشق و اندر دام تست","بلال، که به خاطر وفاداری و عشقش به خداوند در آسمان‌ها جایگاهی ویژه دارد، اکنون در عشق و محبت، به دام افتاده است. این عشق و شوق او باعث شده که در آسمان‌ها همچون پرنده‌ای چالاک و با نشاط به پرواز درآید."],[859,"باز سلطانست زان جغدان برنج","در حدث مدفون شدست آن زفت‌گنج","سلطان، در میان جغدها، بر اثر ترس و نگرانی، در زیر زباله‌ها و چیزهای کهنه پنهان شده است؛ به‌طوری که گنجی ارزشمند، در وضع نامناسب و ناامیدکننده‌ای قرار دارد."],[859,"جغدها بر باز استم می‌کنند","پر و بالش بی‌گناهی می‌کنند","جغدها به باز (پرنده‌ای بزرگ و قوی) حمله می‌کنند و او را بی‌دلیل مورد آزار قرار می‌دهند."],[859,"جرم او اینست کو بازست و بس","غیر خوبی جرم یوسف چیست پس","جرم بلال این است که او پرنده‌ای آزاد و بی‌گناه است، در حالی که بقیه آدم‌ها، مانند یوسف، به خاطر ویژگی‌های خوبشان مورد ظلم و آزار قرار می‌گیرند. در واقع، بلیالی که او را می‌آزارند، هیچ جرم دیگری ندارند، جز اینکه آزادی و خوبی او را نمی‌پسندند."],[859,"جغد را ویرانه باشد زاد و بود","هستشان بر باز زان زخم جهود","جغد در ویرانه و خرابه زندگی می‌کند، زیرا زخم و درد ناشی از ظلم یهودیان بر بلال و وضعیت سخت او، باعث شده که او به چنین مکان‌هایی پناه ببرد."],[859,"که چرا می یاد آری زان دیار","یا ز قصر و ساعد آن شهریار","چرا از آن دیار می‌آیی یا از کاخ و کاخ‌نشین آن پادشاه؟"],[859,"در ده جغدان فضولی می‌کنی","فتنه و تشویش در می‌افکنی","در ده جغدان، تو به حواشی و کنجکاوی می‌پردازی و در آنجا آشوب و ناامنی به وجود می‌آوری."],[859,"مسکن ما را که شد رشک اثیر","تو خرابه خوانی و نام حقیر","خانه ما را که تو به خاطر زیبایی‌اش مورد حسادت دیوان (عوامل شیطانی) قرار داده‌ای، تو چرا به یک ویرانه و بی‌ارزش صدا می‌زنی؟"],[859,"شید آوردی که تا جغدان ما","مر ترا سازند شاه و پیشوا","تو نور و روشنی آوردی تا جغدها، که نماد تاریکی و بدخواهی هستند، تو را به عنوان پادشاه و پیشوای خود بپذیرند."],[859,"وهم و سودایی دریشان می‌تنی","نام این فردوس ویران می‌کنی","شما با خیال و توهم خود در به وجود آوردن این ویرانه، نام این بهشت را خراب می‌کنید."],[859,"بر سرت چندان زنیم ای بد صفات","که بگویی ترک شید و ترهات","ما به تو آن‌قدر ظلم و ستم می‌کنیم و با تو بدرفتاری می‌کنیم که تو ناچار خواهی شد از ما شکایت کنی و حرف‌های بی‌معنی بگویی."],[859,"پیش مشرق چارمیخش می‌کنند","تن برهنه شاخ خارش می‌زنند","او را تن برهنه به سمت مشرق می‌برند و در آنجا به میخ می‌کشند، در حالی که شاخ خارها به او آسیب می‌زند."],[859,"از تنش صد جای خون بر می‌جهد","او احد می‌گوید و سر می‌نهد","بلال در حال تحمل شکنجه و آزار بسیار است که از بدنش خون به شدت جاری می‌شود. او با تمام وجود و در این شرایط سخت، نام خدا را با صدای بلند تکرار می‌کند و به سجده می‌افتد."],[859,"پندها دادم که پنهان دار دین","سر بپوشان از جهودان لعین","به بلال، که به خاطر ایمانش و اذیت‌هایی که از یهودیان می‌دید، توصیه کردم که دینش را پنهان کند و از چشم یهودیان در امان باشد."],[859,"عاشق است او را قیامت آمدست","تا در توبه برو بسته شدست","عاشق (بلال) در حالتی قرار دارد که گویی قیامت بر او رسیده است و در این شرایط برای توبه و بازگشت به زندگی عادی، راهی ندارد."],[859,"عاشقی و توبه یا امکان صبر","این محالی باشد ای جان بس سطبر","عشق و توبه ممکن است که برای انسان دشوار باشد و صبر بر این شرایط به نظر غیرممکن می‌رسد، ای جان، همچون بار سنگین و سختی است."],[859,"توبه کرم و عشق هم‌چون اژدها","توبه وصف خلق و آن وصف خدا","توبه و مهربانی از سوی خداوند و عشق به او مانند یک اژدهاست؛ در حالی که توبه به ویژگی‌های مخلوق مربوط می‌شود و آن ویژگی‌ها به خداوند تعلق ندارد."],[859,"عشق ز اوصاف خدای بی‌نیاز","عاشقی بر غیر او باشد مجاز","عشق واقعی تنها از صفات خدای بی‌نیاز سرچشمه می‌گیرد و محبت به چیزهای غیر از او، عشق حقیقی نیست و تنها در حد مجاز است."],[859,"زانک آن حسن زراندود آمدست","ظاهرش نور اندرون دود آمدست","زیرا آن زیبایی که ظاهرا براق و درخشان است، در واقع درونش تاریکی و کدورت وجود دارد."],[859,"چون رود نور و شود پیدا دخان","بفسرد عشق مجازی آن زمان","وقتی نور از بین برود و ظاهر شود، دودی که بر جا می‌ماند، نشان‌دهنده فاسد شدن عشق مجازی است."],[859,"وا رود آن حسن سوی اصل خود","جسم ماند گنده و رسوا و بد","آن حسن (که به او اشاره شده) به اصل و ماهیت واقعی خود برمی‌گردد، در حالی که جسمش در دنیای مادی باقی می‌ماند و خوار و بی‌ارزش به نظر می‌رسد."],[859,"نور مه راجع شود هم سوی ماه","وا رود عکسش ز دیوار سیاه","نور ماه در نهایت به سوی خود ماه برمی‌گردد و انعکاس آن بر دیوار تیره دیده می‌شود."],[859,"پس بماند آب و گل بی آن نگار","گردد آن دیوار بی مه دیووار","اگر نگار (معشوق) در ذهن و دل نباشد، مانند آب و گل، بی‌ارزش و بی‌فایده خواهد بود. دیواری که نور و زیبایی را نداشته باشد، به دیواری معمولی و بی‌معنا تبدیل می‌شود."],[859,"قلب را که زر ز روی او بجست","بازگشت آن زر بکان خود نشست","قلب، که مثل طلا درخشان و ارزشمند است، وقتی به خاطر زیبایی و حضور او (شخص محبوب) به دنبال او می‌رفت، دوباره به خود برگشت و در جایگاه خود یعنی درون افراد نشسته است."],[859,"پس مس رسوا بماند دود وش","زو سیه‌روتر بماند عاشقش","عاشق، که مس (فلز بی‌ارزش‌تر) است، به خاطر سیاهی و ذلتش رسوا می‌ماند و از عشق به معشوقش حتی بیشتر سیاه‌رو و شرمنده می‌شود."],[859,"عشق بینایان بود بر کان زر","لاجرم هر روز باشد بیشتر","عشق انسان‌های بینا و آگاه به ارزش‌های واقعی، مانند طلا که گرانبهاست، باعث می‌شود که این عشق و محبت هر روز افزایش یابد."],[859,"زانک کان را در زری نبود شریک","مرحبا ای کان زر لاشک فیک","چون در معدن طلا هیچ رقیبی نیست، تو ای طلا، بی‌نظیر و بی‌همتا هستی."],[859,"هر که قلبی را کند انباز کان","وا رود زر تا بکان لامکان","هر کسی که دلش را با عشق به خداوند پیوند دهد، آنقدر با ارزش می‌شود که می‌تواند به جایی بپیوندد که هیچ مکان و زمان معینی ندارد، مانند طلا که در میان چیزهای دیگر می‌درخشد."],[859,"عاشق و معشوق مرده ز اضطراب","مانده ماهی رفته زان گرداب آب","عاشق و معشوق به دلیل تنش‌ها و ناراحتی‌هایی که در ارتباطشان دارند، به گونه‌ای بی‌حال و گیج شده‌اند، مانند ماهی که از گرداب و چرخش آب دور افتاده و نگران است."],[859,"عشق ربانیست خورشید کمال","امر نور اوست خلقان چون ظلال","عشق الهی به مانند خورشید است که کمال و تمامیت را به همراه دارد و نور او برای مخلوقات مانند سایه‌هایی است که از نور او بر زمین افتاده‌اند."],[859,"مصطفی زین قصه چون خوش برشکفت","رغبت افزون گشت او را هم به گفت","پیامبر اسلام (مصطفی) از این داستان خوشحال شد و به سبب آن، رغبت و علاقه‌اش به موضوع بیشتر شد و به گفتار ادامه داد."],[859,"مستمع چون یافت هم‌چون مصطفی","هر سر مویش زبانی شد جدا","وقتی که شنونده (مستمع) داستان را می‌شنود، مانند مصطفی (پیامبر) هر تار موی او به نوعی صدا و زبانی می‌شود، به این معنا که او به شدت تحت تأثیر قرار می‌گیرد و هر بخش از وجودش به نوعی در بیان آنچه می‌فهمد مشارکت می‌کند."],[859,"مصطفی گفتش که اکنون چاره چیست","گفت این بنده مر او را مشتریست","پیامبر (مصطفی) از او پرسید که حالا چه کاری باید انجام دهیم، و او پاسخ داد که این بنده (بلال) را کسی خریدار است."],[859,"هر بها که گوید او را می‌خرم","در زیان و حیف ظاهر ننگرم","مشتری هر چه بگوید، من او را می‌خرم و به ضرر و زیان آن اهمیتی نمی‌دهم و به ظاهر ننگ نیز توجهی ندارم."],[859,"کو اسیر الله فی الارض آمده‌ست","سخره خشم عدو الله شده‌ست","بلال، که بنده خدا در زمین است، به خاطر خشم دشمنان خدا به اسیری درآمده است."],[860,"مصطفی گفتش کای اقبال‌جو","اندرین من می‌شوم انباز تو","پیامبر (مصطفی) به صدیق (ابوبکر) گفت: ای کسی که به دنبال خوشبختی هستی، من در این کار (وصیت کردن) شریک تو می‌شوم."],[860,"تو وکیلم باش نیمی بهر من","مشتری شو قبض کن از من ثمن","از من وکیل باش و نصف بهای کالا را بگیر و برای من مشتری شو تا پول را بپذیری."],[860,"گفت صد خدمت کنم رفت آن زمان","سوی خانه آن جهود بی‌امان","گفت که من صد خدمت به تو انجام می‌دهم و سپس به سمت خانه آن یهودی بی‌رحم رفت."],[860,"گفت با خود کز کف طفلان گهر","پس توان آسان خریدن ای پدر","گفت با خود: از دست دادن و ضایع کردن گوهرهای گرانبها، مثل استعدادها و فرصت‌ها، که باید بر اثر بی‌توجهی بچه‌ها به سادگی از دست برود، به راحتی می‌تواند به‌دست بیاید، ای پدر."],[860,"عقل و ایمان را ازین طفلان گول","می‌خرد با ملک دنیا دیو غول","عقل و ایمان انسان‌ها را افرادی ساده‌دل و نادان مانند کودکان می‌خرند تا دنیا را به راحتی و با فریب به دست آورند؛ همان‌طور که دیو، غول وجود انسان را به بند می‌کشد."],[860,"آنچنان زینت دهد مردار را","که خرد زیشان دو صد گلزار را","مرده را به قدری زیبا و جذاب می‌کند که عقل انسان در برابر آن دو صد گلزار را به خیالی تبدیل می‌کند."],[860,"آن‌چنان مهتاب پیماید به سحر","کز خسان صد کیسه برباید به سحر","چنان نورانی و زیباست که ماه در شب، چنان که بیدارانی از فقر و بی‌پولی شب را به صبح می‌رسانند و ثروت به دست می‌آورند."],[860,"انبیاشان تاجری آموختند","پیش ایشان شمع دین افروختند","پیامبران به آنها یاد دادند که تجارت کنند و در مسیر زندگی‌شان نور دین را روشن کردند."],[860,"دیو و غول ساحر از سحر و نبرد","انبیا را در نظرشان زشت کرد","دیو و غول‌های جادوگر، به واسطه سحر و نبرد انبیا، این پیامبران را در چشم مردم زشت و ناپسند نشان دادند."],[860,"زشت گرداند به جادویی عدو","تا طلاق افتد میان جفت و شو","دشمن با سحر و جادو کاری کرده است که میان همسران جدایی بیفتد و آن‌ها از یکدیگر دور شوند."],[860,"دیده‌هاشان را به سحر می‌دوختند","تا چنین جوهر به خس بفروختند","دشمن با جادوگان چشمان اهل حقیقت را غبارآلود می‌کرد تا آن‌ها نتوانند ارزش واقعی گوهر را ببینند و به بهای ناچیز، مانند خس، آن را بفروشند."],[860,"این گهر از هر دو عالم برترست","هین بخر زین طفل جاهل کو خرست","این گوهر (معرفت و حقیقت) از هر دو عالم (دنیا و آخرت) بالاتر است، پس باید از این کودک نادان (انسان‌هایی که به دنیا فقط نگاه مادی دارند) خریداری شود."],[860,"پیش خر خرمهره و گوهر یکیست","آن اشک را در در و دریا شکیست","در نزد خر (حیوانی که به‌عنوان نماد جهل آمده) مهره و گوهر (در و الماس) به یک اندازه‌اند و در حقیقت، در اشک (محبت یا عشق) تفاوتی بین این دو وجود ندارد. به عبارتی دیگر، ارزش واقعی اشک و محبت فراتر از مادیات است."],[860,"منکر بحرست و گوهرهای او","کی بود حیوان در و پیرایه‌جو","انکارکننده‌ی دریا و گوهرهایش کیست که مانند حیوانی به زینت‌ها و زیورهای ظاهری وابسته است؟"],[860,"در سر حیوان خدا ننهاده است","کو بود در بند لعل و درپرست","خدا در وجود حیوان هیچ عقل و درکی قرار نداده است، او فقط در جستجوی لعل (جواهر) و در تلاش برای به دست آوردن چیزهای مادی است."],[860,"مر خران را هیچ دیدی گوش‌وار","گوش و هوش خر بود در سبزه‌زار","تو تا به حال هیچ خر را دیدی که گوشت و هوش خر باشد، در حالی که در سبزه‌زار نشسته باشد؟ این بیان به نوعی به غفلت یا ناآگاهی موجودات اشاره دارد."],[860,"احسن التقویم در والتین بخوان","که گرامی گوهرست ای دوست جان","بهترینی از آفرینش را در دو وادی (عالم) بخوان که ای دوست، جانش گرانبهاست."],[860,"احسن التقویم از عرش او فزون","احسن التقویم از فکرت برون","احسن التقویم» به معنای بهترین و نیکوترین شکل و شمایل است. این بیت می‌گوید که این نیکوترین شکل و شمایل، نه تنها از عرش الهی بالاتر است، بلکه نسبت به تصورات و خیالات انسانی نیز فراتر است."],[860,"گر بگویم قیمت این ممتنع","من بسوزم هم بسوزد مستمع","اگر بگویم که ارزش و قیمت این موضوع غیرقابل بیان است، خودم در آتش سوزانده می‌شوم و شنونده نیز باید بسوزد."],[860,"لب ببند اینجا و خر این سو مران","رفت این صدیق سوی آن خران","لبت را در اینجا ببند و این خر را (که به معنای نادانی و یا بی‌خود بودن است) به آن سو نران؛ زیرا این صدیق (ابوبکر صدیق) در راه راست و درست حرکت می‌کند و به سوی افراد نادان نمی‌رود."],[860,"حلقه در زد چو در را بر گشود","رفت بی‌خود در سرای آن جهود","وقتی که در به صدا درآمد، او وارد خانه‌ی یهودی شد. او به حالت مستی و بی‌خبری، بدون توجه به اطرافش، به درون آنجا رفت."],[860,"بی‌خود و سرمست و پر آتش نشست","از دهانش بس کلام تلخ جست","او در حالتی شگفت‌انگیز و سرمستی و شوری قرار دارد و به شدت از خود بی‌خود شده است، و از دهانش سخنان تلخی خارج می‌شود."],[860,"کین ولی الله را چون می‌زنی","این چه حقدست ای عدو روشنی","ای دشمن، چرا بر ولی‌الله (عبدالله) این گونه حسد می‌ورزی و تحت تأثیر کینه‌ی خود با او به بدی رفتار می‌کنی؟ این کار تو نشانه‌ای از تاریکی و جهل است."],[860,"گر ترا صدقیست اندر دین خود","ظلم بر صادق دلت چون می‌دهد","اگر در دین خود صداقت داری، چگونه می‌توانی بر صداقت دل کسی ظلم کنی؟"],[860,"ای تو در دین جهودی ماده‌ای","کاین گمان داری تو بر شه‌زاده‌ای","ای کسی که در دین یهودی هستی و به مواد و ظواهر توجه می‌کنی، گمان نکن که تو از نسل و نژاد بزرگی هستی."],[860,"در همه ز آیینه کژساز خود","منگر ای مردود نفرین ابد","به هیچ‌وجه به ظاهر و ظاهرگرایی خود ننگر و به تأثیر منفی آن بر خودت توجه کن، ای مورد نفرین و طرد شده از رحمت الهی."],[860,"آنچ آن دم از لب صدیق جست","گر بگویم گم کنی تو پای و دست","هر آنچه که در آن زمان از لب ابوبکر صدیق شنیده‌ام، اگر بگویم، تو ممکن است در فهم آن دچار سردرگمی و نابسمانی شوی و از مسیر حق منحرف شوی."],[860,"آن ینابیع الحکم هم‌چون فرات","از دهان او دوان از بی‌جهات","سخن‌های حکمت‌آمیز او مانند آب زلال و شیرین فرات، از دهان او به‌راحتی و بدون مانع بیرون می‌آید."],[860,"هم‌چو از سنگی که آبی شد روان","نه ز پهلو مایه دارد نه از میان","مانند آبی که از دل سنگی جاری می‌شود، نه از کنار آن آب می‌آید و نه از درونش."],[860,"اسپر خود کرده حق آن سنگ را","بر گشاده آب مینارنگ را","خداوند سنگ را به حال خود رها کرده و آب مینارنگ (آبی که به سفره زندگی می‌آورند) را از درون آن خارج کرده است."],[860,"هم‌چنانک از چشمه چشم تو نور","او روان کردست بی‌بخل و فتور","چشم تو همچون چشمه‌ای است که نور او (خدا) را بدون هیچ کم و کاستی به دیگران می‌رساند."],[860,"نه ز پیه آن مایه دارد نه ز پوست","روی‌پوشی کرد در ایجاد دوست","چیزی که از پیه یا پوست به وجود آمده است، نمی‌تواند در ایجاد دوستی تأثیری داشته باشد. در حقیقت، دوستی و محبت به چیزهای مادی وابسته نیستند."],[860,"در خلای گوش باد جاذبش","مدرک صدق کلام و کاذبش","در فضا و سکوتی که مانند گوش است، صدای باد موجب جذب می‌شود و حقیقت کلام و دروغ آن را به خوبی مشخص می‌کند."],[860,"آن چه بادست اندر آن خرد استخوان","کو پذیرد حرف و صوت قصه‌خوان","آنچه در دست خرد و قوه تفکر است، می‌تواند سخن و کلام را بپذیرد، همان‌گونه که استخوان قادر است صدای داستان‌گو را به خود جذب کند."],[860,"استخوان و باد روپوشست و بس","در دو عالم غیر یزدان نیست کس","در این دنیا، تنها خداوند یگانه و حقیقی است که از هر چیز دیگر قابل اعتمادتر و حقیقی‌تر است، و سایر موجودات مانند استخوان و باد، فقط ظاهری دارند و واقعیت واقعی آنها در دو جهان قابل مشاهده نیست."],[860,"مستمع او قایل او بی‌احتجاب","زانک الاذنان من الراس ای مثاب","این بیت به این معناست که شنونده و گوینده بدون هیچ پرده‌پوشی و حجابی به هم گوش می‌دهند، زیرا گوش‌ها از سر منشا می‌گیرند و به هم متصل هستند. به عبارت دیگر، درک و ارتباط بین آن‌ها به سادگی و بدون مانع صورت می‌گیرد."],[860,"گفت رحمت گر همی‌آید برو","زر بده بستانش ای اکرام‌خو","می‌گوید اگر رحمت خداوند به تو نزدیک می‌شود، پس تو هم باید با سخاوت عمل کنی و طلا و زر بدهی تا آن رحمت را به دست آوری. این نشان می‌دهد که اقدام به بخشش و generosity به استقبال رحمت الهی می‌انجامد."],[860,"از منش وا خر چو می‌سوزد دلت","بی‌منت حل می نگردد مشکلت","اگر از دل تو عشق و محبت می‌جوشد و می‌سوزد، مشکلاتت بی‌زحمت و بدون نیاز به شکیبایی حل خواهد شد."],[860,"گفت صد خدمت کنم پانصد سجود","بنده‌ای دارم تن اسپید و جهود","من می‌گویم که به جای هر پانصد سجود، صدهزار خدمت انجام می‌دهم و به خاطر آن بنده خوب (بلال)، که او آدمی با دل پاک و نیت خوب است و با ایمان است، حاضرم خدمت کنم."],[860,"تن سپید و دل سیاهستش بگیر","در عوض ده تن سیاه و دل منیر","این بیت به این معناست که انسانی با ظاهر زیبا و خوش‌چهره (تن سپید) ممکن است باطن و روحش (دل سیاه) ناپاک باشد؛ بنابراین در ازای او، اقدام به گرفتن ده انسان با باطن نیکو و دل‌های درخشان (دل منیر) کنید."],[860,"پس فرستاد و بیاورد آن همام","بود الحق سخت زیبا آن غلام","پس پیام فرستاد و آن همام (غلام بلال) را آوردند، که به‌راستی زیبا و خوش‌هیکل بود."],[860,"آنچنان که ماند حیران آن جهود","آن دل چون سنگش از جا رفت زود","یهودی که حیران و شگفت‌زده مانده، عواطفش همچون سنگی بی‌تحرک و بی‌احساس از موقعیتش جدا شده و سریعا تحت تأثیر قرار گرفته است."],[860,"حالت صورت‌پرستان این بود","سنگشان از صورتی مومین بود","این حالت پیروان صورت‌پرستی (مادی‌گرایی) این‌گونه است که دل‌هایشان مانند سنگی سخت و بی‌روح است، در حالی که باید همواره با ایمان و محبت متحول و نرم شوند."],[860,"باز کرد استیزه و راضی نشد","که برین افزون بده بی‌هیچ بد","بلال به خاطر اینکه چیزی بیشتر از آنچه برایش تعیین شده بود درخواست کرد، راضی نشد و خواست که او را به کنار خود راه دهد و از چیزی که باید به او داده می‌شد، کم نکرد."],[860,"یک نصاب نقره هم بر وی فزود","تا که راضی گشت حرص آن جهود","یعنی یک مقدار نقره هم به او افزودند تا حرص و طمع آن یهودی برطرف شود و رضایت او جلب گردد."],[861,"قهقهه زد آن جهود سنگ‌دل","از سر افسوس و طنز و غش و غل","یه جهود سنگ‌دل از روی افسوس و طعنه، با صدای بلند خندید."],[861,"گفت صدیقش که این خنده چه بود","در جواب پرسش او خنده فزود","صدیق، در پاسخ به آن جهود سنگ‌دل که از سر حسرت و تمسخر می‌خندید، از او می‌پرسد که این خنده به چه معناست. هرچند که در جواب، او بیشتر می‌خندد."],[861,"گفت اگر جدت نبودی و غرام","در خریداری این اسود غلام","اگر جد تو (نیاکانت) نبودند و بهای سنگینی برای خرید این غلام سیاه پرداخت نمی‌کردی، چنین نمی‌خندیدی."],[861,"من ز استیزه نمی‌جوشیدمی","خود به عشر اینش بفروشیدمی","من از درگیری و جدال با تو پرهیز می‌کردم و خودم در ازای این غلام، ده درصد او را می‌فروختم."],[861,"کو به نزد من نیرزد نیم دانگ","تو گران کردی بهایش را به بانگ","آنچه که به من داده‌ای، حتی به اندازه نیم قطعه سکه هم ارزش ندارد، اما تو بهای آن را با فریاد بالا برده‌ای."],[861,"پس جوابش داد صدیق ای غبی","گوهری دادی به جوزی چون صبی","صدیق به او پاسخ داد که تو به‌مانند یک کودک، گوهری را به بهای یک جوز در اختیار من گذاشتی."],[861,"کو به نزد من همی‌ارزد دو کون","من به جانش ناظرستم تو به لون","در این بیت، شاعر می‌گوید که برای من، وجود کسی که به او عشق ورزیده‌ام، از هر دو جهان (دنیا و آخرت) بیشتر ارزش دارد. من به خاطر او جانم را فدای او کرده‌ام و او را از نظر روح و جان، می‌نگرم."],[861,"زر سرخست او سیه‌تاب آمده","از برای رشک این احمق‌کده","او (مقصود روح یا حقیقت) مانند زر سرخ است، اما به‌خاطر حسادت این دنیای احمقانه، به صورت تیره و سیاه به نظر می‌رسد."],[861,"دیده این هفت رنگ جسمها","در نیابد زین نقاب آن روح را","چشم‌های مادی قادر به دیدن حقیقت روح نیستند و از این پرده‌های فریبنده (جسم و ظاهر) نمی‌توانند به عمق وجود و رنگ‌های مختلف روح پی ببرند."],[861,"گر مکیسی کردیی در بیع بیش","دادمی من جمله ملک و مال خویش","اگر تو در خرید و فروش خیانت می‌کنی و اموال را نادرست معامله می‌کنی، من همه املاک و دارایی خود را در اختیارت می‌گذارم."],[861,"ور مکاس افزودیی من ز اهتمام","دامنی زر کردمی از غیر وام","اگر به سود خود بر قیمت کالا بیفزایی، من از روی تلاش خود دامنم را پر از طلا می‌کردم و از کسی کمک نمی‌گرفتم."],[861,"سهل دادی زانک ارزان یافتی","در ندیدی حقه را نشکافتی","تو آسان این چیز را به دست آوردی، چون قیمتش کم بود، اما به حقه (تزویر) نگاه نکردی و آن را نشکافتی تا ببینی چه فریبی در آن نهفته است."],[861,"حقه سربسته جهل تو بداد","زود بینی که چه غبنت اوفتاد","جهل تو به سرعت یک حقه پنهان را به تو داد، اکنون متوجه خواهی شد که چه زیان بزرگی به تو رسیده است."],[861,"حقه پر لعل را دادی به باد","هم‌چو زنگی در سیه‌رویی تو شاد","تو از روی نادانی، گوهری بسیار ارزشمند را به باد داده‌ای، مثل زنگی (آدم سیاه‌رو) که در بدبختی و شکست، خود را شاد نشان می‌دهد."],[861,"عاقبت وا حسرتا گویی بسی","بخت و دولت را فروشد خود کسی","نهایتا آدم حسرت می‌خورد و انگار کسی خود را به خاطر بخت و نعمت‌هایش به بازار می‌فروشد."],[861,"بخت با جامه غلامانه رسید","چشم بدبختت به جز ظاهر ندید","بخت تو در حالتی ذلیل و برده‌وار به تو نزدیک شده، اما تو که بدبختی، فقط به ظاهر توجه می‌کنی و حقیقت امر را نمی‌بینی."],[861,"او نمودت بندگی خویشتن","خوی زشتت کرد با او مکر و فن","او (خدا) به تو نشان داد که تو بندگی خود را از زشتی‌های درونت به خوبی درک نکردی و با مکر و نیرنگ، خود را فریب دادی."],[861,"این سیه‌اسرار تن‌اسپید را","بت‌پرستانه بگیر ای ژاژخا","این انسان که اسرار تاریکی دارد و مانند طوطی حرف می‌زند، را باید مثل بت‌پرستان در نظر بگیری."],[861,"این ترا و آن مرا بردیم سود","هین لکم دین ولی دین ای جهود","ما از این دین و آن دین برای خود سود می‌خواهیم، پس به این توجه کنید که شما (یهودیان) فقط به ظواهر دین خود می‌نازید."],[861,"خود سزای بت‌پرستان این بود","جلش اطلس اسپ او چوبین بود","سزای پرستش‌کنندگان بت، این بود که در دنیا ظاهرا فریبنده و مجلل زندگی کنند، در حالی که در باطن، آن‌ها در حالی ضعیف و بی‌جان هستند، مانند اینکه اسپ آن‌ها از پارچه زیبا پوشیده شده باشد اما در واقع چووبین و بی‌کیفیت است."],[861,"هم‌چو گور کافران پر دود و نار","وز برون بر بسته صد نقش و نگار","همچون قبر کافران، که پر از دود و آتش است، از بیرون به واسطه زیبایی‌ها و نقوش مختلف پوشیده شده است."],[861,"هم‌چو مال ظالمان بیرون جمال","وز درونش خون مظلوم و وبال","مال ظالمان به ظاهر زیبا و جذاب است، اما در باطن آن، رنج و عذاب مظلومان نهفته است."],[861,"چون منافق از برون صوم و صلات","وز درون خاک سیاه بی‌نبات","منافق که از بیرون ظاهری نیکو با عبادت و نماز دارد، در درونش مانند خاکی سیاه و بی‌نبات است و هیچ گلی نمی‌روید."],[861,"هم‌چو ابری خالیی پر قر و قر","نه درو نفع زمین نه قوت بر","مانند ابری که فقط صدای توفانی می‌دهد و هیچ بارانی نمی‌بارد، در آن نه برای زمین فایده‌ای وجود دارد و نه قوتی به همراه می‌آورد."],[861,"هم‌چو وعده مکر و گفتار دروغ","آخرش رسوا و اول با فروغ","مثل وعده‌های فریبنده و سخنان دروغین، در انتها رسوا می‌شوند و در ابتدا ظاهر خوبی دارند."],[861,"بعد از آن بگرفت او دست بلال","آن ز زخم ضرس محنت چون خلال","پس از آن، او (شخصی که در بیت اشاره شده) دست بلال را گرفت، زیرا زخم دندانی‌اش (به درد و رنجی که دارد) مانند خلال دندان می‌باشد."],[861,"شد خلالی در دهانی راه یافت","جانب شیرین‌زبانی می‌شتافت","در میان دندان‌ها، خلالی وجود داشت که به سمت شیرین‌زبانی و گفتار خوش رفت."],[861,"چون بدید آن خسته روی مصطفی","خر مغشیا فتاد او بر قفا","وقتی آن خسته، روی پیامبر اسلام، مصطفی را دید، مانند یک خر بی‌حال به زمین افتاد و به پشت دراز شد."],[861,"تا بدیری بی‌خود و بی‌خویش ماند","چون به خویش آمد ز شادی اشک راند","آن شخص تا زمانی که در حالتی بی‌خود و غافل بود، به حالت شادی رسید و وقتی به خود آمد، از خوشحالی اشک ریخت."],[861,"مصطفی‌اش در کنار خود کشید","کس چه داند بخششی کو را رسید","این بیت به موضوع بخشش و کرم اشاره دارد و می‌گوید که کس نمی‌داند که آیا کسی مانند مصطفی (پیامبر اسلام) در کنار خود، بخشی از رحمت الهی را دریافت کرده است یا نه. به طور کلی، به ارزش بخشش‌ها و نیکوکاری‌ها اشاره می‌کند که ممکن است کسی از آن آگاه نباشد."],[861,"چون بود مسی که بر اکسیر زد","مفلسی بر گنج پر توفیر زد","مردی فقیر برای به دست آوردن ثروت و خوشبختی، به جای تلاش واقعی و تلاش در راه درست، به جادو و تقلب (اکسیر) متوسل شد. او فکر می‌کند که با این کار می‌تواند به گنجی بزرگ دست یابد، اما نتیجه‌اش فقط فریب و ناکامی خواهد بود."],[861,"ماهی پژمرده در بحر اوفتاد","کاروان گم شده زد بر رشاد","ماهی پژمرده‌ای در دریا افتاد و کاروانی که گمشده بود، بر سر او فریاد زد."],[861,"آن خطاباتی که گفت آن دم نبی","گر زند بر شب بر آید از شبی","خطاب‌ها و پیام‌هایی که پیامبر در آن زمان بیان کرد، اگر در شب بر انسان نازل شود، همانند روز به وضوح و روشنی خواهد بود."],[861,"روز روشن گردد آن شب چون صباح","من نتانم باز گفت آن اصطلاح","روز روشن می‌شود و آن شب، مانند صبح، روشن می‌گردد؛ اما من نمی‌توانم دوباره درباره این اصطلاح صحبت کنم."],[861,"خود تو دانی که آفتابی در حمل","تا چه گوید با نبات و با دقل","تو خود می‌دانی که در روز روشن، آفتاب چه تأثیری بر گیاهان و گل‌ها دارد و چه سخنان مثبتی درباره آن‌ها می‌تواند بگوید."],[861,"خود تو دانی هم که آن آب زلال","می چه گوید با ریاحین و نهال","تو خود می‌دانی که آن آب زلال چه پیامی به گل‌ها و نهال‌ها می‌دهد."],[861,"صنع حق با جمله اجزای جهان","چون دم و حرفست از افسون‌گران","آفرینش خداوند با تمام اجزای جهان مانند کلام و نفس است که از افسونگران (جادوگران) نشات می‌گیرد."],[861,"جذب یزدان با اثرها و سبب","صد سخن گوید نهان بی‌حرف و لب","جذب شدن به خداوند از طریق آثار و علائم مختلف، به گونه‌ای است که هزاران سخن را در دل نهفته دارد، بدون اینکه نیازی به گفتن و زبانی باشد."],[861,"نه که تاثیر از قدر معمول نیست","لیک تاثیرش ازو معقول نیست","تأثیر اعمال و کارها را نمی‌توان تنها به اندازه‌گیری معمول نسبت داد، بلکه تأثیر آن‌ها فراتر از فهم و معمولیت انسان‌هاست و درک عمیق‌تری نیاز دارد."],[861,"چون مقلد بود عقل اندر اصول","دان مقلد در فروعش ای فضول","عقل اگر در اصول و مبانی خود مقلد باشد، در جزئیات و فروع نیز صرفا تکرارکننده و بی‌فکر خواهد بود. در این حالت، عقل در تصمیم‌گیری و فهم موضوعات به کار خود مسلط نیست و به نوعی بیهوده‌گویی خواهد کرد."],[861,"گر بپرسد عقل چون باشد مرام","گو چنانک تو ندانی والسلام","اگر عقل بپرسد که شعار یا روش زندگی چگونه است، بگو همان‌طور که تو نمی‌دانی، بس است و بهتر است از این موضوع سخن نگوئیم."],[862,"گفت ای صدیق آخر گفتمت","که مرا انباز کن در مکرمت","پیامبر اسلام (مصطفی) به ابوبکر صدیق می‌گوید که قبلا به او وصیت کرده بودم که در کارهای نیک، شریک من باشد و از او انتظار داشتم که در این کارها با من همراهی کند."],[862,"گفت ما دو بندگان کوی تو","کردمش آزاد من بر روی تو","پیامبر (حضرت محمد) می‌گوید ما دو بنده خداوند هستیم که به عشق تو و به خاطر تو به آزادی رسیده‌ایم، یعنی محبت و بندگی ما به تو باعث شده که از قید و بندها آزاد شویم."],[862,"تو مرا می‌دار بنده و یار غار","هیچ آزادی نخواهم زینهار","من تو را به عنوان بنده و همراهی برای خودم می‌خواهم و هیچ نوع آزادی نمی‌خواهم، پس به من امان بده که از این رابطه جدا نشوم."],[862,"که مرا از بندگیت آزادیست","بی‌تو بر من محنت و بیدادیست","بی‌نیاز از بندگی تو، من آزاد نیستم و بدون تو، زندگی برایم پر از رنج و ظلم و ستم است."],[862,"ای جهان را زنده کرده ز اصطفا","خاص کرده عام را خاصه مرا","ای کسی که به وسیله‌ی انتخاب و برگزیدگی‌ات، جهان را حیات بخشیده‌ای، خاص و ویژه کرده‌ای مردم عادی را و من را از میان آنها برگزیده‌ای."],[862,"خوابها می‌دید جانم در شباب","که سلامم کرد قرص آفتاب","در جوانی خواب‌هایی می‌دیدم که در آن‌ها آفتاب به من سلام می‌کرد."],[862,"از زمینم بر کشید او بر سما","همره او گشته بودم ز ارتقا","من از زمین به آسمان برده شدم و همراه او (پیامبر) شدم، به خاطر پیشرفت و ترقی‌ای که به دست آورده‌ام."],[862,"گفتم این ماخولیا بود و محال","هیچ گردد مستحیلی وصف حال","گفتم این حالت عجیبی بود که به نظر غیرممکن می‌رسید و هیچ‌چیز نمی‌تواند چنین حالی را وصف کند."],[862,"چون ترا دیدم بدیدم خویش را","آفرین آن آینه خوش کیش را","وقتی تو را دیدم، خود را شناختم و به خاطر آن آینه زیبا و با اصالت، به تو تحسین می‌کنم."],[862,"چون ترا دیدم محالم حال شد","جان من مستغرق اجلال شد","وقتی تو را دیدم، حال من به کلی دگرگون شد و جانم از شگفتی و عظمت تو پرشد."],[862,"چون ترا دیدم خود ای روح البلاد","مهر این خورشید از چشمم فتاد","وقتی تو را دیدم، ای روح کشور، مهر و محبت نسبت به تو از دیدگانم رفته است، مانند اینکه نور خورشید در چشمم محو شده باشد."],[862,"گشت عالی‌همت از تو چشم من","جز به خواری ننگرد اندر چمن","چشم من فقط به کسانی که دارای همت عالی هستند نگاه می‌کند و به هیچ چیز پایینی و حقیر در باغ زندگی توجهی ندارد."],[862,"نور جستم خود بدیدم نور نور","حور جستم خود بدیدم رشک حور","من روشنایی الهی را جستجو کردم و خودم آن را دیدم. همچنین زیبایی حوریان را نیز طلب کردم و در خودم حس زیبایی آن‌ها را یافتم."],[862,"یوسفی جستم لطیف و سیم تن","یوسفستانی بدیدم در تو من","من به دنبال زیبایی و لطافت یوسف‌وار بودم و در تو، که اهل یوسفستانی (سرزمین یوسف) هستی، آن را یافتم."],[862,"در پی جنت بدم در جست و جو","جنتی بنمود از هر جزو تو","من در پی بهشت بودم و در جستجوی آن، تو را به عنوان نشانه‌ای از بهشت شناختم."],[862,"هست این نسبت به من مدح و ثنا","هست این نسبت به تو قدح و هجا","این وضعیت و رفتار، برای من ستایش و تمجید است، اما برای تو، سرزنش و عیب‌جویی محسوب می‌شود."],[862,"هم‌چو مدح مرد چوپان سلیم","مر خدا را پیش موسی کلیم","مدح و ستایشی که مرد چوپان سلیم از خداوند دارد، همانند ستایشی است که موسی کلیم (پیامبر) در حضور خداوند انجام می‌دهد."],[862,"که بجویم اشپشت شیرت دهم","چارقت دوزم من و پیشت نهم","من از تو می‌خواهم که بیشتر به من توجه کنی و از شیرینی محبتت بهره‌مند شوم، و همچنین چهارخانه (دستار) خود را به تو تقدیم کنم و پیش تو قرار دهم."],[862,"قدح او را حق به مدحی برگرفت","گر تو هم رحمت کنی نبود شگفت","خداوند در مدح صدیق، قدح و نازش را به ستایش تبدیل کرده است. اگر تو نیز رحمت کنی و لطف داشته باشی، جای تعجبی نیست."],[862,"رحم فرما بر قصور فهمها","ای ورای عقلها و وهمها","به ما رحم کن بر کاستی‌های فهم‌مان، ای کسی که بالاتر از عقل‌ها و تصورات هستی."],[862,"ایها العشاق اقبالی جدید","از جهان کهنه نوگر رسید","ای عاشقان، فرصت تازه‌ای از دنیای کهنه به دنیای نو رسیده است."],[862,"زان جهان کو چاره بیچاره‌جوست","صد هزاران نادره دنیا دروست","از آن جهانی که آنجا راهی برای رفع مشکلات بیچارگان وجود دارد، صدها چیز ارزشمند و نادر در آنجا وجود دارد."],[862,"ابشروا یا قوم اذ جاء الفرج","افرحوا یا قوم قد زال الحرج","ای مردم، شاد باشید زیرا مژده خوشی آمده است. ای قوم، خوشحال باشید چرا که مشکلات و سختی‌ها برطرف شده است."],[862,"آفتابی رفت در کازه هلال","در تقاضا که ارحنا یا بلال","آفتاب از آسمان به سمت کعبه (که به شکل هلال است) می‌رود و از بلال، موذن پیامبر، درخواست می‌کند که با صدای اذان خود، مردم را آرام کند و به نماز دعوت نماید."],[862,"زیر لب می‌گفتی از بیم عدو","کوری او بر مناره رو بگو","زیر لب به خاطر ترس از دشمن می‌گفتی که او را از روی بلندی مناره خبر کن."],[862,"می‌دمد در گوش هر غمگین بشیر","خیز ای مدبر ره اقبال گیر","هر غمگینی که می‌نالد، صدایی به او می‌رسد که باید بیدار شود و به فکر آینده و موفقیت خود باشد. با تدبیر عمل کند و برای دستیابی به خوشبختی تلاش کند."],[862,"ای درین حبس و درین گند و شپش","هین که تا کس نشنود رستی خمش","ای شخصی که در این زندان و در این وضعیت نامناسب و کثیف قرار داری، مراقب باش که تا زمانی که کسی صدایت را نشنیده، سکوت کن و خود را آرام نگه‌دار."],[862,"چون کنی خامش کنون ای یار من","کز بن هر مو بر آمد طبل‌زن","ای دوست، اکنون که باید ساکت باشی، بدان که از درون هر مویی، صدایی مانند طبل بلند شده است که خبر از عواطف و احساسات درون من می‌دهد."],[862,"آن‌چنان کر شد عدو رشک‌خو","گوید این چندین دهل را بانگ کو","دشمن رشک‌ورز آنقدر ناشنوا و کر شده است که نمی‌تواند صدای دهل‌ها را بشنود و تنها می‌پرسد صدای این دهل‌ها به چه علت است."],[862,"می‌زند بر روش ریحان که طریست","او ز کوری گوید این آسیب چیست","عشقی که طریقتی و رازی دارد، به این گل خوشبو (ریحان) می‌زند و خود آن شخص (کوری) می‌پرسد که این زیان و آسیب چه چیزی است."],[862,"می‌شکنجد حور دستش می‌کشد","کور حیران کز چه دردم می‌کند","حور که نمادی از زنان بهشتی است، به آرامی و با دقت به دردهای فردی که در حیرت و سردرگمی به سر می‌برد، نزدیک می‌شود و در تلاش است تا او را از دردش آگاه کند. این حیرت، ناشی از ندانستن علتی برای رنج و مشکل اوست."],[862,"این کشاکش چیست بر دست و تنم","خفته‌ام بگذار تا خوابی کنم","این درگیری و کشمکش که در بدن و روحم وجود دارد، دیگر مرا خسته کرده است. من در حالتی از خواب و آرامش هستم، بگذاری که به خواب بروم و از این دردها رهایی یابم."],[862,"آنک در خوابش همی‌جویی ویست","چشم بگشا کان مه نیکو پیست","اگر او را در خواب هم می‌جویی، باید چشمانت را باز کنی، زیرا او همان ماه نیکوست."],[862,"زان بلاها بر عزیزان بیش بود","کان تجمش یار با خوبان فزود","بلایای بیشتری بر عزیزان که منجر به فزون‌تر شدن محبت و دوستی با افراد نیکو می‌شود، وجود دارد."],[862,"لاغ با خوبان کند بر هر رهی","نیز کوران را بشوراند گهی","لاغ، همان طور که با نیکان و خوبان در هر راهی رفتار می‌کند، کسانی که کوردل هستند را نیز گاهی باید به هیجان آورد و تحرک بخشید."],[862,"خویش را یک‌دم برین کوران دهد","تا غریو از کوی کوران بر جهد","اگر انسان یک لحظه خود را به جمع کوران بدهد، در آن صورت صدای بلندی از سمت آن کوران بلند می‌شود."],[863,"چون شنیدی بعضی اوصاف بلال","بشنو اکنون قصه ضعف هلال","پس از آنکه برخی ویژگی‌های بلال را شنیدی، حالا داستان ضعف و ناتوانی هلال را بشنو."],[863,"از بلال او بیش بود اندر روش","خوی بد را بیش کرده بد کشش","هلال در روش و رفتار از بلال، که نماد نیکویی و فضیلت است، در مرتبه بالاتری قرار دارد؛ چراکه او در درون خود بدی را بیشتر کشته است."],[863,"نه چو تو پس‌رو که هر دم پس‌تری","سوی سنگی می‌روی از گوهری","تو مانند او که عقب‌نشینی می‌کند و هر لحظه به سمت چیزی بی‌ارزش می‌دود نیستی، بلکه به سوی جواهری باارزش می‌روی."],[863,"آن‌چنان کان خواجه را مهمان رسید","خواجه از ایام و سالش بر رسید","وقتی که مهمانی به نزد خواجه آمد، خواجه از زمان و عمر او آگاه شد."],[863,"گفت عمرت چند سالست ای پسر","بازگو و در مدزد و بر شمر","پرسید چند سال از عمرت گذشته است، ای پسر، بی‌مکافات بگو و به دروغ و تزویر نپرداز."],[863,"گفت هجده هفده یا خود شانزده","یا که پانزده ای برادرخوانده","شخصی در پاسخ به پرسش درباره سنش می‌گوید که شاید هجده ساله باشد، یا هفده، یا شانزده و یا پانزده سال دارد. این نشان‌دهنده عدم اطمینان او نسبت به سن خود است."],[863,"گفت واپس واپس ای خیره سرت","باز می‌رو تا بکس مادرت","گفت: ای نادان، به درستی که برگرد و برو تا به مادر خود برسی."],[864,"آن یکی اسپی طلب کرد از امیر","گفت رو آن اسپ اشهب را بگیر","یکی از افراد از امیر درخواست کرد که آن اسب خاکستری را بگیرد."],[864,"گفت آن را من نخواهم گفت چون","گفت او واپس‌روست و بس حرون","امیر می‌گوید که من آن اسب را نمی‌خواهم، زیرا او فقط به سمت عقب می‌رود و هیچ خاصیتی ندارد."],[864,"سخت پس پس می‌رود او سوی بن","گفت دمش را به سوی خانه کن","او به شدت به عقب برمی‌گردد و به سمت بن (احتمالا مکان یا حالتی) می‌رود. به او بگو که دم و نفسش را به سمت خانه (اصلی و حقیقی‌اش) برگرداند."],[864,"دم این استور نفست شهوتست","زین سبب پس پس رود آن خودپرست","نفس انسان به مانند اسبی است که با شهوت رانده می‌شود، به همین دلیل خودپرست و متکبر عقب‌نشینی می‌کند."],[864,"شهوت او را که دم آمد ز بن","ای مبدل شهوت عقبیش کن","هان! چون شهوت که به عنوان نفس انسانی به وجود آمده، از ریشه و اساس خود آگاه شد، آن را به حال خود رها کن و بگذار به عقب برود."],[864,"چون ببندی شهوتش را از رغیف","سر کند آن شهوت از عقل شریف","اگر شهوت را از او محدود کنی، آن شهوت به عقل شریف او آسیب می‌زند و از بین می‌رود."],[864,"هم‌چو شاخی که ببری از درخت","سر کند قوت ز شاخ نیک‌بخت","اگر شاخی را از درخت قطع کنی، همانند آن شاخ، قدرت و قوتش از بین می‌رود. اینجا تمثیل به کار رفته تا نشان دهد اگر انسان ذاتی و قوه‌ای را از خود بگیرد، دیگر توانایی و قوتش از بین می‌رود."],[864,"چونک کردی دم او را آن طرف","گر رود پس پس رود تا مکتنف","زمانی که تو سر او را قطع کردی، او به سمت دیگر می‌رود؛ اگر او عقب برود، تا احاطه شده است، برمی‌گردد."],[864,"حبذا اسپان رام پیش‌رو","نه سپس‌رو نه حرونی را گرو","خوشا به حال آن اسب‌ها که در جلوی کاروان هستند، نه به دنبال آن‌ها و نه به دست اسب‌های حرونی (اسب‌های عربی) برای بار کشیدن."],[864,"گرم‌رو چون جسم موسی کلیم","تا به بحرینش چو پهنای گلیم","اگر کسی مانند موسی کلیم (پیامبر) در دشت گرم و در حال حرکت باشد، تا زمانی که به دریای بحرین (دریا که اشاره به سعه و بزرگی دارد) برسد، مانند گلیم (پهنه‌ای از پارچه) گسترده و دراز خواهد بود. این تعبیر به حالت روحانی یا معنوی انسان در مسیر زندگی اشاره دارد."],[864,"هست هفصدساله راه آن حقب","که بکرد او عزم در سیران حب","راهی که او برای سیر و سفر در محبت حق (خدا) برگزیده، هفتصد سال است که آغاز شده است."],[864,"همت سیر تنش چون این بود","سیر جانش تا به علیین بود","اگر اراده و تلاش جسم او چنین باشد، روح او نیز باید به سطح بالاتر و عالی‌تری برسد."],[864,"شهسواران در سباقت تاختند","خربطان در پایگه انداختند","سواریان در مسابقه با هم به سرعت تاختند و سپس در نقطه‌ای به نام «پایگاه»، از عرق و خستگی در افتادند."],[865,"آن‌چنان که کاروانی می‌رسید","در دهی آمد دری را باز دید","وقتی کاروانی به یک روستا می‌رسد، در یک دروازه را باز می‌بیند."],[865,"آن یکی گفت اندرین برد العجوز","تا بیندازیم اینجا چند روز","یکی از افراد کاروان گفت: بیایید این زن سالخورده را در اینجا بگذاریم تا چند روز در این محل بمانیم."],[865,"بانگ آمد نه بینداز از برون","وانگهانی اندر آ تو اندرون","صدای زنگ به گوش رسید، نه از آنکه چیزی را به بیرون بیندازند، بلکه به ناگاه خودت را به درون متوجه کن."],[865,"هم برون افکن هر آنچ افکندنیست","در میا با آن که این مجلس سنیست","هرچه را که باید دور بیندازید، دور بیندازید و در این مجلس باقی نمانید، چون این مجلس، مجلس اهل سنت (پیروان اهل حق) است و با این حال، نباید در آن بمانید."],[865,"بد هلال استاددل جان‌روشنی","سایس و بنده امیری مؤمنی","بد هلال، یعنی یک هلال خوب و قمر، استاد دل و روشنی جان، سایس (اسب‌ران) و بنده امیری مؤمن است. این بیان به زیبایی و نورانیت آن خلق اشاره دارد که همواره در خدمت و وفاداری به یک حاکم مؤمن هستند."],[865,"سایسی کردی در آخر آن غلام","لیک سلطان سلاطین بنده نام","سایس (گماشته) به آن غلام در پایان کار چیزی نگفت، اما سلطان، پادشاه بزرگ‌ها، او را بنده نامید."],[865,"آن امیر از حال بنده بی‌خبر","که نبودش جز بلیسانه نظر","این امیر که در اینجا به او اشاره شده، از وضعیت و حال بنده (غلام) بی‌خبر است و فقط به ظواهر و سخنان او توجه دارد."],[865,"آب و گل می‌دید و در وی گنج نه","پنج و شش می‌دید و اصل پنج نه","امیر فقط به جنبه‌های ظاهری و مادی انسان‌ها توجه می‌کند و از عمق وجود و گنجینه‌های درونی آنها بی‌خبر است. او نه تنها از ارزش‌های معنوی فاصله دارد، بلکه نمی‌داند که بینش عمیق‌تری فراتر از ظاهر وجود دارد."],[865,"رنگ طین پیدا و نور دین نهان","هر پیمبر این چنین بد در جهان","ظاهر آدمی از خاک و رنگ رخسار او نشانه‌ای از طبیعت مادی‌اش است، اما حقیقت دین و نور الهی که در دل اوست، پنهان و نهفته است. هر پیامبری در جهان به همین صورت بوده است."],[865,"آن مناره دید و در وی مرغ نی","بر مناره شاه‌بازی پر فنی","در اینجا، کسی مناره‌ای را می‌بیند که بر آن، مرغی معلق است و شبیه به شاهین و هنرمندانه پرواز می‌کند. این تصویر به زیبایی و شکوه آن موجود اشاره دارد."],[865,"وان دوم می‌دید مرغی پرزنی","لیک موی اندر دهان مرغ نی","او (مناره) دومین مرغ را می‌دید که در حال پرواز است، اما موی آن مرغ در دهانش گیر کرده و نمی‌تواند به‌درستی پرواز کند."],[865,"وانک او ینظر به نور الله بود","هم ز مرغ و هم ز مو آگاه بود","او کسی است که به نور خداوند نگاه می‌کند و از حال مرغ و موی در دهان مرغ نیز آگاه است."],[865,"گفت آخر چشم سوی موی نه","تا نبینی مو بنگشاید گره","گفت: در نهایت، چشم تو باید به سوی موی معشوق نرود تا وقتی گره‌ گیسوی او را نبینی، موی او گره‌ گشایی نمی‌کند."],[865,"آن یکی گل دید نقشین دو وحل","وآن دگر گل دید پر علم و عمل","یک گل، زیبایی و نازکی‌اش را در دو چیز می‌بیند: یکی در نقش و نگار (تزئینات) و دیگری در علم و عمل، که نشان‌دهنده‌ی اهمیت دانش و رفتار صحیح است."],[865,"تن مناره علم و طاعت هم‌چو مرغ","خواه سیصد مرغ‌گیر و یا دو مرغ","تن مناره‌ای که از علم و اطاعت ساخته شده، مانند مرغی است که تنها به دنبال به‌دست آوردن سیصد پرنده یا دو پرنده می‌گردد."],[865,"مرد اوسط مرغ‌بین است او و بس","غیر مرغی می‌نبیند پیش و پس","مردی که در میانه قرار دارد، تنها مرغ را می‌بیند و غیر از مرغ چیز دیگری را نمی‌تواند در جلو و عقب خود ببیند."],[865,"موی آن نوری ست پنهان آن مرغ","که بدان پاینده باشد جان مرغ","موهای آن مرغی که در اینجا صحبتش شده، نوری پنهان هستند که با آن، جان مرغ زنده می‌ماند."],[865,"مرغ ، کان موی است در منقار او / هیچ عاریت نباشد ، کار او","","مرغی که در اینجا اشاره شده، جان و روح را نمادین نشان می‌دهد و موی او به معنای وجود یا صفات نورانی‌اش است. این وجود یا ویژگی‌ها از آن خودش است و هیچ چیز عاریتی یا قرضی در آن وجود ندارد؛ یعنی همه‌چیز در ذاتش نهفته و حقیقی است."],[865,"علم او از جان او جوشد مدام","پیش او نه مستعار آمد نه وام","علم او همواره از وجود درونی‌اش جوشیده می‌شود و این علم نه به طور امانت و نه به صورت قرضی برای او نیست."],[866,"از قضا رنجور و ناخوش شد هلال","مصطفی را وحی شد غماز حال","به طور تصادفی، هلال (شخصیتی در اینجا که به احتمال زیاد به پیامبر اسلام، حضرت محمد، اشاره دارد) بیمار و ناخوش گردید. وحی بر او نازل شد و حال او را به دیگران خبر داد."],[866,"بد ز رنجوریش خواجه‌ش بی‌خبر","که بر او بد کساد و بی‌خطر","خواجه، که اشاره به محمد پیامبر دارد، از رنج و بیماری هلال (شخصیتی نمادین) بی‌خبر است و نمی‌داند که حال او چقدر بد و ناگوار شده و او به خطر افتاده است."],[866,"خفته نه روز اندر آخر محسنی","هیچ کس از حال او آگاه نی","محسن، مدت نه روز خواب بوده و هیچ‌کس از وضعیت او خبر ندارد."],[866,"آنک کس بود و شهنشاه کسان","عقل صد چون قلزمش هر جا رسان","این بیت به توصیف شخصیتی می‌پردازد که به عنوان شهنشاه و سرآمد همه انسان‌ها (کسان) معرفی شده است. عقل او به اندازه‌ی دریا (قلزم) گسترده و در هر جا که نمایان شود، برتری و عظمت او را نشان می‌دهد. در واقع، این شخصیت به عنوان مقام بالایی در عقل و دانش شناخته می‌شود."],[866,"وحیش آمد رحم حق غم‌خوار شد","که فلان مشتاق تو بیمار شد","رحمت خداوند به کمک آمد و به خاطر علاقه فلان شخص به تو، حالاو بیمار شده است."],[866,"مصطفی بهر هلال با شرف","رفت از بهر عیادت آن طرف","حضرت محمد (مصطفی) برای عیادت هلال (که به احتمال زیاد به معنای یک شخص خاص یا نماد انسان مؤمن است) با کمال احترام و شرافت به سمت او رفت."],[866,"در پی خورشید وحی آن مه دوان","وآن صحابه در پیش چون اختران","هلال، که در اینجا به عنوان نماد معصومیت و مقام مهم روحانی آمده، در پی خورشید وحی (یعنی پیامبر) در حال حرکت است و یاران او نیز مانند ستارگان در کنار او قرار دارند. این بیان نشان‌دهنده‌ی ارادت و وفاداری صحابه به پیامبر و نقش مهم او در هدایت انسان‌هاست."],[866,"ماه می‌گوید که اصحابی نجوم","للسری قدوه و للطاغی رجوم","ماه می‌گوید که یاران پیامبر (اصحاب) مانند ستاره‌ها (اجرام آسمانی) برای هدایت شدند و برای کافران نیز مانند سنگ‌هایی برای پرتاب (عذاب) به شمار می‌آیند."],[866,"میر را گفتند که آن سلطان رسید","او ز شادی بی‌دل و جان برجهید","به میر (سلطان) خبر دادند که آن سلطان (رسول الله) رسید. او از خوشحالی چنان شاد شد که بی‌خبر از خود برخواست و پرید."],[866,"برگمان آن ز شادی زد دو دست","کان شهنشه بهر او میر آمدست","میر (دبیر) از خوشحالی دو دست خود را به نشانه شادی به هم زد، زیرا خبر رسید که آن سلطان به خاطر مصطفی (پیامبر اسلام) به او نزدیک شده است."],[866,"چون فرو آمد ز غرفه آن امیر","جان همی‌افشاند پامزد بشیر","وقتی آن امیر (محمد صلی‌الله‌علیه‌وآله) از جایگاهش پایین آمد، جان و کلامش را به دیگران منتقل می‌کرد و بشارت (خبر خوش) می‌داد."],[866,"پس زمین‌بوس و سلام آورد او","کرد رخ را از طرب چون ورد او","آن امیر در حالی که به زمین سجده کرد و سلام داد، چهره‌اش از شادی و سرور مانند گل شکفت."],[866,"گفت بسم‌الله مشرف کن وطن","تا که فردوسی شود این انجمن","گفت باید با نام خدا و با سلامتی، سرزمین خود را زیبا و با شکوه کنیم تا مانند فردوسی (شاعر بزرگ فارسی) این جمع و انجمن به اوجی از اعتبار برسد."],[866,"تا فزاید قصر من بر آسمان","که بدیدم قطب دوران زمان","می‌خواهم قصر و پناهم به اندازه‌ای بزرگ شود که به آسمان برسد، زیرا من شاهد و نشانه رهبری و محور زمان، یعنی «قطب دوران»، بوده‌ام."],[866,"گفتش از بهر عتاب آن محترم","من برای دیدن تو نامدم","او به خاطر دلخوری و تنبیه آن شخصیت محترم (احتمالا پیامبر) چیزی نمی‌گوید و بروز نمی‌دهد که برای دیدنش آمده است."],[866,"گفت روحم آن تو خود روح چیست","هین بفرما کین تجشم بهر کیست","روح من گفت: تو خود روح چیست؟ پس بگو که این تجسم (وجود ظاهری) برای چه کسی است؟"],[866,"تا شوم من خاک پای آن کسی","که به باغ لطف تستش مغرسی","می‌خواهم خاک پای کسی شوم که در باغ لطف تو قرار دارد و به او نزدیک است."],[866,"پس بگفتش کان هلال عرش کو","هم‌چو مهتاب از تواضع فرش کو","پس گفت: این هلال که مثل مهتاب از تواضع، بر زمین افتاده و مثل فرش گسترده شده، کجاست؟"],[866,"آن شهی در بندگی پنهان شده","بهر جاسوسی به دنیا آمده","آن پادشاه بزرگ (خدا یا رسول) در لباس بندگی پنهان است و برای آگاهی از حال دنیا به این جهان آمده است."],[866,"تو مگو کو بنده و آخرجی ماست","این بدان که گنج در ویرانه‌هاست","نمی‌توانی بگویی که چه کسی بنده و چه کسی آخر است؛ زیرا این امر به این حقیقت برمی‌گردد که گنج‌های ارزشمند در مکان‌های خراب و ویران هم وجود دارند."],[866,"ای عجب چونست از سقم آن هلال","که هزاران بدر هستش پای‌مال","عجب که چگونه آن هلال (ماه)، که در حالت بیماری و رنج است، می‌تواند در برابر هزاران ماه دیگر، که درخشان و زیبا هستند، نادیده گرفته شود و پایمال گردد."],[866,"گفت از رنجش مرا آگاه نیست","لیک روزی چند بر درگاه نیست","او می‌گوید که دلش از رنجی که دارد خبر ندارد، اما معلوم است که مدت زیادی در مقابل در خانه (رسول الله) بی‌خبر از حال در رنج است."],[866,"صحبت او با ستور و استرست","سایس است و منزلش این آخرست","سخن او با شتر و الاغ، در دست چوپانی است و منزل او (یعنی مقصد او) همینجا است."],[867,"رفت پیغامبر به رغبت بهر او","اندر آخر وآمد اندر جست و جو","پیامبر (مصطفی) با میل و اشتیاق به ملاقات هلال (صحابی و یار او) رفت و در آخر به جست‌وجوی او پرداخت."],[867,"بود آخر مظلم و زشت و پلید","وین همه برخاست چون الفت رسید","در آن زمان، وضعیت و حال هلال (یار پیامبر) بسیار بد و زشت بود، اما هنگامی که محبت و دوستی میان آنها شکل گرفت، این وضعیت تغییر یافت و بهبود پیدا کرد."],[867,"بوی پیغامبر ببرد آن شیر نر","هم‌چنانک بوی یوسف را پدر","پیامبر (محمد) مانند یوسف، که بوی او به پدرش (یعقوب) می‌رسید، از طریقی که شیر نر در فطرت خود دارد، بوی او را به دیگران می‌برد."],[867,"موجب ایمان نباشد معجزات","بوی جنسیت کند جذب صفات","معجزات به تنهایی باعث ایمان نمی‌شوند؛ بلکه این ویژگی‌های نفس و روح انسان‌ها هستند که صفات عالی را جذب می‌کنند و انسان را به ایمان می‌رسانند."],[867,"معجزات از بهر قهر دشمنست","بوی جنسیت پی دل بردنست","معجزات برای شکست دادن دشمنان است، اما برای جلب محبت و دوستی، ویژگی‌های نیکو و اخلاقی لازم است."],[867,"قهر گردد دشمن اما دوست نی","دوست کی گردد ببسته گردنی","دشمن تحت تاثیر قدرت شکست می‌خورد، اما دوست هرگز از رابطه‌ای که با او دارد جدا نمی‌شود. دوست به هیچ دلیلی گسسته نخواهد شد."],[867,"اندر آمد او ز خواب از بوی او","گفت سرگین‌دان درون زین گونه بو‌؟","از آن بوی و عطر از خواب بیدار شد و (با خود) گفت: عجیب است، اصطبل و این عطر خوش در آن؟"],[867,"از میان پای استوران بدید","دامن پاک رسول بی‌ندید","رسول خدا(ص) دامن پاک خود را از وسط پاهای اسب‌ها دید، اما چیزی از آن‌ها ندید که ناپاک باشد."],[867,"پس ز کنج آخر آمد غژغژان","روی بر پایش نهاد آن پهلوان","در این بیت، اشاره به آمدن یک شخصیت بزرگ (پهلوان) از گوشه‌ای دور است که با صدای غژغژ (صدای خاصی که از حرکت یا نزدیک شدن کسی به وجود می‌آید) به نزد پیامبر آمده و او را بر پاهایش می‌نهد. این اقدام بیانگر احترام و ارادت او به پیامبر است."],[867,"پس پیمبر روی بر رویش نهاد","بر سر و بر چشم و رویش بوسه داد","پیامبر بر چهره هلال، که یکی از صحابه‌اش است، ناز و محبت گذاشت و بر پیشانی و چهره‌اش بوسه زد."],[867,"گفت یا ربا چه پنهان گوهری","ای غریب عرش چونی خوشتری","پیمبر (مصطفی علیه‌السلام) به هلال (هلال بن نافع) گفت: ای غریب که از عرش به زمین فرستاده شده‌ای، چه رازهایی در وجود تو نهفته است که این‌قدر زیبا و دل‌نشین هستی؟"],[867,"گفت چون باشد خود آن شوریده‌خواب","که در آید در دهانش آفتاب‌؟","گفت: چگونه می‌تواند کسی مثل او که دیوانه‌وار و خواب‌آلود است، آفتاب در دهانش بیفتد؟ یعنی آیا چنین پدیده‌ای ممکن است؟"],[867,"چون بود آن تشنه‌ای کو گل چرد‌؟","آب بر سر بنهدش خوش می‌برد","تشنگی را در نظر بگیر که حریر و گل را می‌پرستد و در جستجوی آب است؛ آب را با لذت بر سر می‌گذارد تا سیراب شود."],[868,"هم‌چو عیسی بر سرش گیرد فرات","که ایمنی از غرقه در آب حیات","همچون عیسی که بر روی آب حرکت کرد و به او اجازه داده شد که در آب غرق نشود، محمد (مصطفی) نیز اگر یقین و ایمانش بیشتر شود، می‌تواند بر روی آب حرکت کند و از خطر غرق شدن در آب حیات ایمن باشد."],[868,"گوید احمد گر یقینش افزون بدی","خود هوایش مرکب و مامون بدی","احمد، یعنی پیامبر اسلام، می‌گوید اگر یقین او بیشتر شود، هوای او برایش مانند مرکبی امن خواهد بود که در آن سوار می‌شود."],[868,"هم‌چو من که بر هوا راکب شدم","در شب معراج مستصحب شدم","من نیز مانند عیسی که بر روی آب راه رفت، در شب معراج به یک حالت خاص و مکاشفه‌ای دست یافتم که باعث شد از زمین جدا شوم و به آسمان بروم."],[868,"گفت چون باشد سگی کوری پلید","جست او از خواب خود را شیر دید","گفت: چگونه ممکن است سگی کور و پلید از خواب بیدار شود و خود را شیر ببیند؟"],[868,"نه چنان شیری که کس تیرش زند","بل ز بیمش تیغ و پیکان بشکند","این بیت می‌گوید که این شیر واقعی، به معنای قدرت و شجاعت، آن‌قدر بزرگ و قوی است که هیچ‌کس جرئت تیراندازی به او را ندارد و حتی بخاطر بیم از او، تیغ و پیکان‌ها شکسته می‌شود."],[868,"کور بر اشکم رونده هم‌چو مار","چشمها بگشاد در باغ و بهار","این بیت به این معناست که فردی که دچار تاریکی و ناآگاهی است، مانند یک مار که در انتظار بهار و شکوفایی است، به سوی اشک و درد می‌رود و با گشایش چشمانش، زیبایی‌ها و نعمت‌های زندگی را در باغ بهار مشاهده می‌کند. این اشاره به بیداری و آگاهی دارد که در نهایت انسان را به جمال و زندگی واقعی می‌رساند."],[868,"چون بود آن چون که از چونی رهید","در حیاتستان بی‌چونی رسید","وقتی کسی از ذات و چگونگی خداوند و حقیقت‌های هستی رهایی یابد، در زندگی به حقیقتی می‌رسد که دیگر نیازی به از آن چگونگی‌ها ندارد."],[868,"گشت چونی‌بخش اندر لامکان","گرد خوانش جمله چونها چون سگان","در جهانی که محدودیت‌های فیزیکی وجود ندارد، مصدر اصلی وجود، یعنی «چونی» (حالت یا ویژگی) به هر چیزی می‌بخشد و بر تمام اشیاء و موجودات تأثیر دارد، مانند سگی که به اطراف می‌گردد و به دنبال پاسخ «چون» (چگونه) است."],[868,"او ز بی‌چونی دهدشان استخوان","در جنابت تن زن این سوره مخوان","او بدون وجود چونی و تغییر، به انسان‌ها واقعیّت و جوهر وجود را می‌دهد، پس این سوره را در حالت ناپاکی نخوانید."],[868,"تا ز چونی غسل ناری تو تمام","تو برین مصحف منه کف ای غلام","برای اینکه از حالت بی‌چونی و در شرایط ناپاکی درآیی، تو باید تمام آداب و شرایط را رعایت کنی و دستت را بر این کتاب نگذار."],[868,"گر پلیدم ور نظیفم ای شهان","این نخوانم پس چه خوانم در جهان","اگر من پاک باشم یا ناپاک، ای پادشاهان، چه تفاوتی دارد؟ پس در این دنیا چه چیزی باید بخوانم یا به چه چیزی توجه کنم؟"],[868,"تو مرا گویی که از بهر ثواب","غسل ناکرده مرو در حوض آب","تو به من می‌گویی که برای به دست آوردن پاداش، نباید بدون غسل به حوض آب بروی."],[868,"از برون حوض غیر خاک نیست","هر که او در حوض ناید پاک نیست","هر کسی که به حوض نرود و در آن آب نگیرد، از نظر روحی و معنوی پاک و بدون آلودگی نخواهد بود، چرا که در خارج از حوض فقط خاک و آلودگی وجود دارد."],[868,"گر نباشد آبها را این کرم","کو پذیرد مر خبث را دم به دم","اگر آب‌ها نبودند، این کرم (کرم می‌تواند به انسان یا موجودی اشاره داشته باشد) چگونه می‌تواند ناپاکی را (خبث) هر لحظه تحمل کند و جذب خود کند؟"],[868,"وای بر مشتاق و بر اومید او","حسرتا بر حسرت جاوید او","ناله بر کسی که عاشق و امیدوار به خداست و افسوس بر حسرتی که همیشه با او خواهد بود."],[868,"آب دارد صد کرم صد احتشام","که پلیدان را پذیرد والسلام","آب به مانند مرام و زیبایی‌های خود، که نشانه‌ای از احترام و ارادت است، می‌تواند صدها نوع موجودات خوب و بزرگ را در خود جای دهد و در عین حال، افراد ناپاک را نیز به خود می‌پذیرد و به آنها اجازه ورود می‌دهد."],[868,"ای ضیاء الحق حسام‌الدین که نور","پاسبان تست از شر الطیور","ای نور روشنایی حقیقت، حسام‌الدین، که نگهبان نور تو از شر پرندگان بدجنس است."],[868,"پاسبان تست نور و ارتقاش","ای تو خورشید مستر از خفاش","ای تو که همچون خورشید روشنایی و نور را پاسداری، قدرت تو در ارتقاء و بالا بردن نور مثل بالای یک خفاش است که پرواز می‌کند."],[868,"چیست پرده پیش روی آفتاب","جز فزونی شعشعه و تیزی تاب","پرده ای که بر روی آفتاب قرار دارد چه چیزی است جز افزایش نور و شدت تابش آن؟"],[868,"پرده خورشید هم نور ربست","بی‌نصیب از وی خفاشست و شبست","پرده‌ای که بر روی خورشید است، نور را از آن می‌گیرد و به همین دلیل، موجوداتی مانند خفاش و شب، که به تاریکی وابسته‌اند، از آن بی‌بهره می‌مانند."],[868,"هر دو چون در بعد و پرده مانده‌اند","یا سیه‌رو یا فسرده مانده‌اند","هر دو (خفاش و شب)، به دلیل دوری از نور و پنهان بودن در پرده تاریکی، یا چهره‌ای تیره دارند یا پژمرده و بی‌حال مانده‌اند."],[868,"چون نبشتی بعضی از قصه هلال","داستان بدر آر اندر مقال","چون برخی از داستان هلال (ماه نو) را نوشتی، حال داستان بدر (ماه کامل) را نیز در سخن خود ذکر کن."],[868,"آن هلال و بدر دارند اتحاد","از دوی دورند و از نقص و فساد","هلال و کامل (بدر) از نظر حقیقت یکی هستند، اما از نظر ظاهری و درک مردم، به خاطر نقص و کاستی‌هایی که دارند، از هم جدا به نظر می‌رسند."],[868,"آن هلال از نقص در باطن بریست","آن به ظاهر نقص تدریج آوریست","آن هلال (ماه) از نقص در درون خود آزاد است، اما در ظاهر، به تدریج دچار نقصان می‌شود."],[868,"درس گوید شب به شب تدریج را","در تانی بر دهد تفریج را","مولانا بیان می‌کند که شب به شب باید به آرامی و به تدریج پیش رفت؛ یعنی در کارها، صبر و شکیبایی لازم است تا نتایج بهتری حاصل شود."],[868,"در تانی گوید ای عجول خام","پایه‌پایه بر توان رفتن به بام","مولانا به عجولان می‌گوید که برای رسیدن به هدف‌های بزرگ باید صبور باشند و آرام آرام پیش بروند؛ مانند کسی که برای بالا رفتن از یک بام باید پایه‌به‌پایه پیش برود و نمی‌تواند فورا به قله برسد."],[868,"دیگ را تدریج و استادانه جوش","کار ناید قلیه دیوانه جوش","برای به نتیجه رسیدن و ایجاد کارهای بزرگ، باید به آرامی و به شیوه‌ای منظم پیش برویم. کار کردن به شکل احساسی و بی‌پروایی، باعث ایجاد هرج و مرج و ناپایداری می‌شود."],[868,"حق نه قادر بود بر خلق فلک","در یکی لحظه به کن بی‌هیچ شک","خداوند قادر است در یک لحظه آسمان‌ها و زمین را خلق کند، بدون اینکه هیچ شکی در این قدرت و توانایی‌اش باشد."],[868,"پس چرا شش روز آن را درکشید","کل یوم الف عام ای مستفید","چرا خداوند خلق آسمان و زمین را در شش روز طولانی کرد، در حالی که این کار می‌توانست در یک لحظه انجام شود، مثل یک سال برای کسی که بهره‌مند است؟"],[868,"خلقت طفل از چه اندر نه مه‌است","زانک تدریج از شعار آن شه‌است","آفرینش کودک چرا در نه ماه طول می‌کشد، زیرا این تدریج یکی از نشانه‌های پیامبر (حضرت محمد) است."],[868,"خلقت آدم چرا چل صبح بود","اندر آن گل اندک‌اندک می‌فزود","آفرینش آدم چرا به مدت سی روز طول کشید و در آن خاکی که کم‌کم شکل گرفت، تدریجا افزایش یافت؟"],[868,"نه چو تو ای خام که اکنون تاختی","طفلی و خود را تو شیخی ساختی","تو ای نادان که به سرعت و شتاب حرکت می‌کنی، مانند کودکانی که نمی‌دانند چه می‌کنند، خود را به مقام بزرگی رسانده‌ای، در حالی که هنوز در فهم و معرفت ات ناتوانی."],[868,"بر دویدی چون کدو فوق همه","کو ترا پای جهاد و ملحمه","تو به‌سرعت رفته‌ای مانند کدوئی که بالای همه تپه‌ها قرار دارد، ولی تو فقط به خاطر اینکه در جنگ و نبرد شرکت کرده‌ای، این‌چنین در حال دویدن هستی."],[868,"تکیه کردی بر درختان و جدار","بر شدی ای اقرعک هم قرع‌وار","به اینجا تکیه کردی مانند یکی که به درختان و دیواره‌ها تکیه می‌کند، ای کسی که تاسیست و بی‌مو به نظر می‌رسی."],[868,"اول ار شد مرکبت سرو سهی","لیک آخر خشک و بی‌مغزی تهی","چنانچه ابتدا سر سبز و زیبا بودی مثل سرو بلند، اما در آخر خشک و بی‌خاصیت و تهی از محتوا شده‌ای."],[868,"رنگ سبزت زرد شد ای قرع زود","زانک از گلگونه بود اصلی نبود","ای کدو (قرع) زود رنگ سبز تو به زردی گرایید، زیرا ذات و اصل تو از گل و زیبایی نبوده است و تنها ظاهری فریبنده داشته‌ای."],[869,"بود کمپیری نودساله کلان","پر تشنج روی و رنگش زعفران","زن عجوزه‌ای بود نودساله و بزرگ که چهره‌اش پر از چین و چروک بود و رنگش به زعفران می‌مانست."],[869,"چون سر سفره رخ او توی توی","لیک در وی بود مانده عشق شوی","او در حال حاضر در کنار سفره‌ای نشسته و چهره‌اش زیبا و چشم‌نواز است، ولی در واقع عشق همسرش هنوز در وجود او باقی مانده و تأثیرگذار است."],[869,"ریخت دندانهاش و مو چون شیر شد","قد کمان و هر حسش تغییر شد","او دندان‌هایش را زیبا و موهایش را مانند شیر روشن کرده و قامتش همچون کمان شده است؛ به‌طوری که تمام حس‌های او تحت تأثیر عشق تغییر کرده‌اند."],[869,"عشق شوی و شهوت و حرصش تمام","عشق صید و پاره‌پاره گشته دام","عشق و شهوت و حرص او به پایان رسیده است، و عشق او به شکار و بازیچه شدن و تکه‌تکه شدن از دام دیگر معنا ندارد."],[869,"مرغ بی‌هنگام و راه بی‌رهی","آتشی پر در بن دیگ تهی","پرنده‌ای که به موقع پرواز نمی‌کند و راهی که بی‌نشانه است، همچون آتش در ته یک دیگ خالی است. این بیت به سرنوشتی ناامیدکننده و بی‌هدف اشاره دارد که در آن هیچ چیز به درستی پیش نمی‌رود."],[869,"عاشق میدان و اسپ و پای نی","عاشق زمر و لب و سرنای نی","عاشق کسی است که در میدان جنگ و سوارکاری و همچنین در کنار موسیقی و لذت‌های زندگی، احساس شوق و علاقه دارد. او عاشق صدای نی و زیبایی‌های اطرافش است."],[869,"حرص در پیری جهودان را مباد","ای شقیی که خداش این حرص داد","حرص و طمع در پیری به یهودیان (خود یهودی‌ها) نرسد. ای بدبخت، خداوند این حرص را به تو داده است."],[869,"ریخت دندانهای سگ چون پیر شد","ترک مردم کرد و سرگین‌گیر شد","وقتی دندان‌های سگ کهنسال شد، دیگر برای انسان مفید نبود و به جایی رسید که فقط به جمع‌آوری فضولات می‌پرداخت."],[869,"این سگان شصت ساله را نگر","هر دمی دندان سگشان تیزتر","این سگ‌ها که شصت سال عمر دارند را ببین، هر لحظه دندان‌هایشان تیزتر می‌شود."],[869,"پیر سگ را ریخت پشم از پوستین","این سگان پیر اطلس‌پوش بین","این سگان پیر، که در سن و سال زیادی به سر می‌برند، پشم و موی خود را از پوستینشان ریخته‌اند. بنابراین، این سگان را که در ظاهر خود را با پارچه‌های گرانبها می‌پوشانند، به دقت بنگر."],[869,"عشقشان و حرصشان در فرج و زر","دم به دم چون نسل سگ بین بیشتر","عشق و حرص آن‌ها به خوشی و ثروت همچون نسل سگ (سگ‌ها) هر لحظه بیشتر می‌شود."],[869,"این چنین عمری که مایه دوزخ است","مر قصابان غضب را مسلخ است","این‌گونه عمری که منجر به عذاب و دوزخ می‌شود، مانند مکانی است که قاتلان و غضب‌زده‌ها در آن به slaughter (ذبح) می‌رسند."],[869,"چون بگویندش که عمر تو دراز","می‌شود دلخوش دهانش از خنده باز","وقتی به او می‌گویند که عمرش طولانی می‌شود، لبخندش باز می‌شود و خوشحال می‌شود."],[869,"این چنین نفرین دعا پندارد او","چشم نگشاید سری بر نارد او","او نفرین را به‌عنوان دعا می‌پندارد و در نتیجه، از حقیقت و واقعیت چشم‌پوشی می‌کند و به زیبایی‌های ظاهری خود می‌پردازد."],[869,"گر بدیدی یک سر موی از معاد","اوش گفتی این چنین عمر تو باد","اگر فقط یک تار موی او را از دنیای آخرت می‌دیدی، می‌گفتی که چنین عمری برای تو دوام پیدا کند."],[870,"گفت یک روزی به خواجه گیلیی","نان پرستی نر گدا زنبیلیی","یک روز به خواجه گیلانی گفتند که در این دنیا به غیر از پرستش خدا چیز دیگری نخواهی دید، و چون یک درویش نان درخواست کرد، او را گدایی دانستند که فقط با زنبیل (کیسه‌ای برای جمع‌آوری نان) زندگی‌اش را می‌گذراند."],[870,"چون ستد زو نان بگفت ای مستعان","خوش به خان و مان خود بازش رسان","وقتی از آن مرد نان گرفت، گفت: ای یاور، خوش به حال تو که خدا تو را به خانه و کاشانه‌ات برمی‌گرداند."],[870,"گفت خان ار آنست که من دیده‌ام","حق ترا آنجا رساند ای دژم","اگر خان معنای واقعی را داشته باشد و من آنجا را دیده‌ام، حق (الهی) تو را در آنجا به سلامت خواهد رساند، ای غمگین."],[870,"هر محدث را خسان باذل کنند","حرفش ار عالی بود نازل کنند","هر راوی حدیث (محدث) و گوینده‌ای را به احترام به دیگران پایین می‌آورند، حتی اگر کلامش بسیار عالی و عمیق باشد، آن را به زبانی ساده و پیش پا افتاده بیان می‌کنند."],[870,"زانک قدر مستمع آید نبا","بر قد خواجه برد درزی قبا","زیرا ارزش شنونده به آن است که چگونه سخن را می‌شنود، نه اینکه صاحب سخن چقدر بزرگ و مهم است. اگر شنونده ناتوان باشد، سخن با ارزش و خوب هم برای او تأثیر ندارد."],[871,"چونک مجلس بی چنین پیغاره نیست","از حدیث پست نازل چاره نیست","چون در مجلس چنین پیغامی (پیغام‌آور) نیست، چاره‌ای جز سخن گفتن از موضوعات پست و نازل وجود ندارد."],[871,"واستان هین این سخن را از گرو","سوی افسانه عجوزه باز رو","این سخن را از آن کسانی که در گرو (زنجیر) افسانه‌های عجوزه (زن سال‌خورده) هستند، بگیر و به حقایق پشت آن رجوع کن."],[871,"چون مسن گشت و درین ره نیست مرد","تو بنه نامش عجوز سال‌خورد","وقتی که پیر و مسن شد و در این مسیر راهی ندارد، تو نامش را «عجوز» بگذار، یعنی زنی که سالخورده است."],[871,"نه مرورا راست مال و پایه‌ای","نه پذیرای قبول مایه‌ای","نه خودی وجود دارد که مال و پایه باشد، و نه کسی هست که به خاطر داشته‌هایش مورد قبول واقع شود."],[871,"نه دهنده نی پذیرنده خوشی","نه درو معنی و نه معنی‌کشی","نه کسی خوشی را می‌دهد و نه کسی آن را می‌پذیرد، نه در این میان معنایی وجود دارد و نه معنای کشتن و از بین بردن."],[871,"نه زبان نه گوش نه عقل و بصر","نه هش و نه بیهشی و نه فکر","در این بیت اشاره شده که هیچ‌یک از ابزارهای حسی و عقلانی انسان، از جمله زبان، گوش، عقل، بینایی، هوشیاری و حتی بی‌حالی و فکر، نقشی در درک حقیقت ندارند. این موضوع بر ناتوانی فهم انسانی از معانی عمیق تر تأکید می‌کند."],[871,"نه نیاز و نه جمالی بهر ناز","تو بتویش گنده مانند پیاز","نه نیازی به زیبایی یا ناز تو دارد و نه خودت زیبایی خاصی برای جلب توجه داری، مانند پیاز که بزرگ و گنده است ولی جذاب نیست."],[871,"نه رهی ببریده او نه پای راه","نه تبش آن قحبه را نه سوز و آه","آن زن پیر، نه راهی را رها کرده و نه پا به راهی گذاشته است، نه شوق و اشتیاقی دارد و نه حالتی از درد و ناله."],[872,"سایلی آمد به سوی خانه‌ای","خشک نانه خواست یا تر نانه‌ای","سائل (درخواست‌کننده) به سوی خانه‌ای رفت و خواهان نان خشک یا نان نرم بود."],[872,"گفت صاحب‌خانه « نان اینجا کجاست ؟","خیره‌ای ؟ کی این دکان نانباست ؟»","صاحب‌خانه از سائل می‌پرسد که نان اینجا کجاست و از او می‌خواهد که خیالاتی نکند، زیرا اینجا دکان نان‌فروشی نیست."],[872,"گفت « باری اندکی پیهم بیاب »","گفت « آخر نیست دکان قصاب »","درویش گفت: «چند تکه گوشت ده» و صاحب‌خانه پاسخ داد: «محل قصابی این‌جا وجود ندارد."],[872,"گفت « پاره‌ای آرد ده، ای کدخدا »","گفت « پنداری که هست این آسیا ؟»","در اینجا درویش از کدخدا می‌خواهد که مقداری آرد به او بدهد، ولی کدخدا به او پاسخ می‌دهد که آیا فکر می‌کنی این آسیاب (آسیاب برای آرد کردن غلات) وجود دارد؟"],[872,"گفت « باری آب ده از مکرعه »","گفت « آخر نیست جو یا مشرعه »","درویش درخواست می‌کند که آبی از سیب‌زمینی (مکرعه) به او بدهند، ولی پاسخ می‌شنود که در اینجا نه جو وجود دارد و نه آب یادشده."],[872,"هر چه او درخواست از نان یا سبوس","چربکی می‌گفت و می‌کردش فسوس","چربک یعنی دروغ راست‌مانند"],[872,"آن گدا در رفت و دامن بر‌کشید","اندر آن خانه بحسبت خواست رید","گدا از آن خانه بیرون رفت و دامن خود را بالا زد تا در آن مکان، طبق خواسته‌اش، خالی کند."],[872,"گفت « هی هی » گفت « تن زن ای دژم","تا درین ویرانه خود فارغ کنم","گفت «هی هی» یعنی صدای آه و فریاد و ناله‌ای سر داد و به کسی که در آن حال غمگین و اندوهناک به نظر می‌رسید گفت که ای زن، به من آرامش بده تا بتوانم از این ویرانی راحتی بگیرم."],[872,"چون درینجا نیست وجه زیستن","بر چنین خانه بباید ریستن »","در اینجا، زندگی در چنین خانه‌ای که از زنان خالی است امکان‌پذیر نیست و باید از آنجا بیرون رفت."],[872,"چون نه‌ای بازی که گیری تو شکار","دست آموز شکار شهریار","اگر تو نیستی و بازی نمی‌کنی، چگونه می‌توانی شکار کنی آن‌هم شکار دست‌آموز شهریار (پادشاه) که در دست توست؟"],[872,"نیستی طاوس با صد نقش بند","که به نقشت چشم‌ها روشن کنند","تو طاووس نیستی که با زیبایی خود، دیگران را به شگفتی و شادی بیندازی؛ بلکه به خاطر ویژگی‌های ظاهری‌ات، چشم‌ها به تو دل‌بسته نمی‌شوند."],[872,"هم نه‌ای طوطی که چون قندت دهند","گوش سوی گفت شیرینت نهند","تو نیز مانند طوطی نیستی که وقتی قند به او بدهند، گوشش را به گفتار شیرین تو بسپارد. این یعنی تو شخصیت و جذبه‌ات را از دست داده‌ای و دیگر کسی به سخنان شیرین تو توجه نمی‌کند."],[872,"هم نه‌ای بلبل که عاشق‌وار زار","خوش بنالی در چمن یا لاله‌زار","تو هم مثل بلبل عاشق نیستی که با صدای دل‌نشین در گلستان یا باغ لاله ناله کند."],[872,"هم نه‌ای هدهد که پیکی‌ها کنی","نه چو لک‌لک که وطن بالا کنی","تو نه مانند هدهدی هستی که فرستاده باشد و خبرها را بیاورد، و نه مانند لک‌لک که خانه و محل زندگی خود را بسازد و در آن سکنا گزینید."],[872,"در چه کاری تو و بهر چت خرند ؟","تو چه مرغی و ترا با چه خورند ؟","در چه کاری مشغول هستی و برای چه چیزی به تو نیاز دارند؟ تو چه نوع پرنده‌ای هستی و با چه غذایی تغذیه می‌شوی؟"],[872,"زین دکان با مکاسان برتر آ","تا دکان فضل که الله اشتری","باید از این دکان (دنیا) به بالاتر از آن که با علم و دانش (مکاسان) مرتبط است بروی، زیرا دانش از دارایی‌های دنیوی بیشتر ارزش دارد و مثل الاغ (اشتری) نمی‌ماند که به کارهایی نادرست مشغول است."],[872,"کاله‌ای که هیچ خلقش ننگرید","از خلاقت آن کریم آن را خرید","چیزی که هیچ‌کس به آن توجهی نکرد، خداوند کریم آن را خرید."],[872,"هیچ قلبی پیش او مردود نیست","زانک قصدش از خریدن سود نیست","هیچ قلبی در نزد او غیرقابل قبول نیست، زیرا هدف او از خریدن تنها به دست آوردن سود نیست."],[873,"چون عروسی خواست رفتن آن خریف","موی ابرو پاک کرد آن مستخیف","عروسی که تصمیم به رفتن دارد، موی ابروهای خود را اصلاح کرده است تا ظاهری زیبا و مرتب داشته باشد. در اینجا \"خریف\" به معنای مرد میانسال و \"مستخیف\" به معنای ساده‌دل و بی‌خبر است."],[873,"پیش رو آیینه بگرفت آن عجوز","تا بیاراید رخ و رخسار و پوز","آن پیرزن (عجوز) به جلو آینه رفت تا چهره و صورت خود را بیاراید و زیباتر کند."],[873,"چند گلگونه بمالید از بطر","سفره رویش نشد پوشیده‌تر","عجوز (زن سالخورده) چندین بار گل و رنگ بر روی سفره صورتش مالید، اما نه تنها صورتش زیباتر نشد، بلکه کمتر هم پوشیده و پنهان گردید."],[873,"عشرهای مصحف از جا می‌برید","می‌بچفسانید بر رو آن پلید","یک عده از قاریان قرآن، آیات را به صورت فضایی از هم جدا می‌کنند و آن‌ها را بر روی فردی ناپاک می‌افکنند؛ در واقع به او به نحوی بی احترامی می‌کنند."],[873,"تا که سفره روی او پنهان شود","تا نگین حلقه خوبان شود","تا زمانی که سفره چهره و زیبایی او پنهان بماند، نگین زیبایی و جواهر خوبی‌ها خواهد بود."],[873,"عشرها بر روی هر جا می‌نهاد","چونک بر می‌بست چادر می‌فتاد","عشرها (چادر یا پوشش) را در هر مکانی می‌گسترد، چونکه زمانی که چادر را می‌بندد، به زمین می‌افتد."],[873,"باز او آن عشرها را با خدو","می‌بچفسانید بر اطراف رو","او دوباره آن عشرها (دست و پاهای چادر) را با خط و نشان و نشانه‌گذاری دور و بر بستر (چادر) قرار داد."],[873,"باز چادر راست کردی آن تکین","عشرها افتادی از رو بر زمین","او دوباره چادر را مرتب کرد و آن ده دانه که بر روی رود افتاده بود، بر زمین افتاد."],[873,"چون بسی می‌کرد فن و آن می‌فتاد","گفت صد لعنت بر آن ابلیس باد","چون آن زن بسیاری از فنون را انجام می‌داد و به نتیجه نمی‌رسید، گفت صد بار لعنت بر آن ابلیس باد."],[873,"شد مصور آن زمان ابلیس زود","گفت ای قحبه قدید بی‌ورود","ابلیس در آن لحظه به سرعت آماده شد و گفت: ای زن فاسد و بدکردار، ورود تو بی‌فایده است."],[873,"من همه عمر این نیندیشیده‌ام","نه ز جز تو قحبه‌ای این دیده‌ام","من تمام عمرم به جز تو به کسی دیگر فکر نکرده‌ام و هیچ زنی را غیر از تو نمی‌شناسم."],[873,"تخم نادر در فضیحت کاشتی","در جهان تو مصحفی نگذاشتی","تخم نادر اشاره به نطفه‌ای باارزش و یا چیز نایابی دارد که در فضیحت (بی‌حرمتی) کاشته شده است. در واقع، تو در این دنیا کارهای بدی انجام دادی و هیچ نشانه‌ی خوبی از خود به جا نگذاشتی."],[873,"صد بلیسی تو خمیس اندر خمیس","ترک من گوی ای عجوزه دردبیس","تو به مانند صد شیطان و شرارت، در هر گوشه و کنج خود را نشان می‌دهی. ای زن سالخورده و پر از درد، با این سخن تو، من نمی‌توانم شرافت و زیبایی سخن را بگویم."],[873,"چند دزدی عشر از علم کتیب","تا شود رویت ملون هم‌چو سیب","چند بار از علم و دانش خود بهره‌برداری می‌کنی تا چهره‌ات زیبا و دل‌انگیز شود مانند چهره‌ی سیب."],[873,"چند دزدی حرف مردان خدا","تا فروشی و ستانی مرحبا","مردان خدا که سخن می‌گویند، بعضی از حرف‌های آنان دزدیده شده و به فروش می‌رسد، اما این دزدی باعث می‌شود که آنها مورد تحسین قرار بگیرند."],[873,"رنگ بر بسته ترا گلگون نکرد","شاخ بر بسته فن عرجون نکرد","شاخی که بر می‌خورد (یعنی به گل می‌نشیند) تو را سرخرو نمی‌کند، درختی که خشکیده و بی‌برگ است هم نمی‌تواند تو را از عزلت و تنهایی نجات دهد."],[873,"عاقبت چون چادر مرگت رسد","از رخت این عشرها اندر فتد","سرانجام زمانی که چادر مرگ بر سرت بیفتد، تمام زیبایی‌ها و زینت‌هایت از تو گرفته می‌شود."],[873,"چونک آید خیزخیزان رحیل","گم شود زان پس فنون قال و قیل","زمانی که موت به صورت ناگهانی و سریع برسد، بعد از آن، مهارت‌ها و فنون گفتن و شنیدن دیگر معنایی نخواهد داشت و فراموش می‌شود."],[873,"عالم خاموشی آید پیش بیست","وای آنک در درون انسیش نیست","عالم خاموشی، به معنای حالتی از سکوت و آرامش روحانی، به سوی اهل علم و دانش می‌آید، و این در حالی است که درون کسی که در این حالت قرار دارد، هیچ نشانه‌ای از دوستی و محبت نیست."],[873,"صیقلی کن یک دو روزی سینه را","دفتر خود ساز آن آیینه را","سینه‌ات را چند روزی صاف و آماده کن تا بتوانی از آن به خوبی مانند یک آینه استفاده کنی. یعنی باید دل و روح خود را پاکسازی کنی تا حقیقت را بهتر درک کنی."],[873,"که ز سایه یوسف صاحب‌قران","شد زلیخای عجوز از سر جوان","زلیخا، زن یوسف که در دوران پیری‌اش به عشق او دچار شده بود، به برکت او از سایه وجودش دوباره جوانی و زیبایی پیدا کرد."],[873,"می‌شود مبدل به خورشید تموز","آن مزاج بارد برد العجوز","زنی که در سن پیری به سر می‌برد، می‌تواند به جوانی و شادابی برسد، همان‌طور که خورشید تابستان می‌تواند تغییر در مزاج و حال و احوال دیگران ایجاد کند."],[873,"می‌شود مبدل بسوز مریمی","شاخ لب خشکی به نخلی خرمی","می‌توان این عجزۀ خشک را مانند مریم، به درخت نخل خرما تبدیل کرد که بارور و خوشبو است. در اینجا به تغییر و تحول از وضعیت نامساعد به شرایط مطلوب اشاره می‌شود."],[873,"ای عجوزه چند کوشی با قضا","نقد جو اکنون رها کن ما مضی","ای زن پیر، چرا مدام با سرنوشت (قضا و قدر) درگیر هستی و از آن طلب می‌کنی؟ اکنون دیگر این کار را رها کن و به گذشته فکر نکن."],[873,"چون رخت را نیست در خوبی امید","خواه گلگونه نه و خواهی مداد","وقتی انتظار خوبی و نیکویی را ندارید، دیگر از دلبستگی به زیبایی‌های ظاهری مثل گل و رنگ به خودتان نزنید و امیدی به آن‌ها نداشته باشید."],[874,"آن یکی رنجور شد سوی طبیب","گفت نبضم را فرو بین ای لبیب","یک نفر بیمار به سمت پزشک رفت و گفت: \"لطفا نبض من را بررسی کن، ای پزشک."],[874,"که ز نبض آگه شوی بر حال دل","که رگ دستست با دل متصل","از نبض می‌توانی به حال دل پی ببری، زیرا رگ دست به دل متصل است."],[874,"چونک دل غیبست خواهی زو مثال","زو بجو که با دلستش اتصال","دل در حقیقت پنهان و نامحسوس است؛ اگر به دنبال آن هستی، باید از نشانه‌ها و آثارش مثال بیاوری، زیرا دل با وجودی نامرئی، پیوستگی و ارتباط نزدیک با تجارب و احساسات انسان دارد."],[874,"باد پنهانست از چشم ای امین","در غبار و جنبش برگش ببین","ای امین، باد همچون یک نیروی پنهان است و دیده نمی‌شود؛ اما می‌توانی اثر آن را در حرکت برگ‌ها و غبار مشاهده کنی."],[874,"کز یمینست او وزان یا از شمال","جنبش برگت بگوید وصف حال","جنبش برگ‌ها می‌تواند نشانه‌ای از حال و احساسات باشد که یا از طرف راست (ید) یا از طرف چپ (شمال) می‌آید. این به آن معناست که باید به تغییرات و حرکات اطراف دقت کنیم تا وضعیت و احساسات را بفهمیم."],[874,"مستی دل را نمی‌دانی که کو","وصف او از نرگس مخمور جو","نمی‌دانی حال دل مست را، که باید تو از نرگس مخمور بپرسی تا وصف او را بفهمی."],[874,"چون ز ذات حق بعیدی وصف ذات","باز دانی از رسول و معجزات","وقتی از حقایق الهی دوری، تنها می‌توانی از پیامبر و معجزات او درباره‌ی ذات خداوند شناخت پیدا کنی."],[874,"معجزاتی و کراماتی خفی","بر زند بر دل ز پیران صفی","بر دل کسانی که سالک مسیر حقیقتند، معجزات و کرامت‌های پنهانی از سوی پیران و عارفان و بزرگان (که به صفی نسبت داده می‌شوند) تجلی می‌کند."],[874,"که درونشان صد قیامت نقد هست","کمترین آنک شود همسایه مست","در دل برخی از انسان‌ها، رویدادهای عظیمی به وقوع می‌پیوندد که به نوعی نقد واقعی حیاتشان را نشان می‌دهد. از جمله این رویدادها، حالتی است که پرده‌برداری از حقیقت وجود آنها موجب مستی و غفلت می‌شود."],[874,"پس جلیس الله گشت آن نیک‌بخت","کو به پهلوی سعیدی برد رخت","آن نیک‌بخت که در کنار مرد صالحی به نام سعید قرار گرفت، به نزدیکی و محشور شدن با خداوند نایل آمد."],[874,"معجزه کان بر جمادی زد اثر","یا عصا با بحر یا شق‌القمر","این بیت به اشاره به معجزاتی از پیامبران است که اثرات شگرفی داشتند؛ مانند معجزه‌ی حضرت موسی که عصایش با دریا تماس گرفت و آن را شکافت، یا شق القمر که به وسیله‌ی پیامبر اسلام، محمد، انجام شد. این معجزات نشان‌دهنده‌ی قدرت الهی و تأثیری است که بر طبیعت گذاشتند."],[874,"گر ترا بر جان زند بی‌واسطه","متصل گردد به پنهان رابطه","اگر جان تو بی‌واسطه به چیزی متصل شود، به طور پنهانی و عمیق به آن رابطه پیدا می‌کند."],[874,"بر جمادات آن اثرها عاریه‌ست","از پی روح خوش متواریه‌ست","اثرهایی که بر اجسام بی‌روح (جمادات) ایجاد می‌شود، از آن خودشان نیست و عاریه است؛ بلکه به سبب روحی است که به‌طور مخفی و نامحسوس در آنها وجود دارد."],[874,"تا از آن جامد اثر گیرد ضمیر","حبذا نان بی‌هیولای خمیر","برای آنکه ضمیر و دل از آن جامد تأثیر بگیرد، باید عشق و محبت را مانند نان بدون ماده و قوام واقعی احساس کند."],[874,"حبذا خوان مسیحی بی‌کمی","حبذا بی‌باغ میوه مریمی","حبذا که نوعی نان است و در اینجا به نان عشق و محبت اشاره دارد. در اینجا اشاره به مسیحی دارد که بدون کمبود محبت و عشق، از نان محبت برخوردار شده و به میوه‌های روحانی و نعمت‌های الهی که به مریم (مادر عیسی) نسبت داده می‌شود، دست یافته است."],[874,"بر زند از جان کامل معجزات","بر ضمیر جان طالب چون حیات","معجزات از جان کامل (مسیح) بر دل جان‌جویان در جریان است و مانند حیات، آنها را زنده می‌کند."],[874,"معجزه بحرست و ناقص مرغ خاک","مرغ آبی در وی آمن از هلاک","معجزه مانند دریاست و در آن، موجودات ناقص مانند مرغ خاکی وجود دارند؛ ولی در میان آن، مرغ آبی (که نماد روح یا موجودات کامل است) از هلاکت در امان است."],[874,"عجزبخش جان هر نامحرمی","لیک قدرت‌بخش جان هم‌دمی","عجز و ناتوانی کسی که با او آشنا نیست، روح را خالی و بی‌حس می‌سازد، اما دوستی و هم‌صحبتی با کسی که با او آشنایی داریم، جان را به قوت و نشاط می‌بخشد."],[874,"چون نیابی این سعادت در ضمیر","پس ز ظاهر هر دم استدلال گیر","هرگاه این خوش‌بختی را در درون خود نیابی، پس از ظاهر هر لحظه استدلال کن و دلیل بیاور."],[874,"که اثرها بر مشاعر ظاهرست","وین اثرها از مؤثر مخبرست","اثرها بر حواس ما آشکار است، ولی این تاثیرات از عاملی پنهان و نهان خبر می‌دهد."],[874,"هست پنهان معنی هر داروی","هم‌چو سحر و صنعت هر جادوی","معنی هر دارویی پنهان است و مانند سحر و هر نوع جادویی، نیاز به شناخت عمیق‌تری دارد تا اثرش نمایان شود."],[874,"چون نظر در فعل و آثارش کنی","گرچه پنهانست اظهارش کنی","وقتی که به کارها و آثار کسی توجه کنی، هرچند که در ظاهر پنهان باشد، می‌توانی حقیقت و وجود آن را آشکار کنی."],[874,"قوتی کان اندرونش مضمرست","چون به فعل آید عیان و مظهرست","نیرویی که در درون انسان نهفته است، وقتی به عمل درآید، آشکار و نمایان می‌شود."],[874,"چون به آثار این همه پیدا شدت","چون نشد پیدا ز تاثیر ایزدت","وقتی آثار و نشانه‌های این همه چیز به وضوح آشکار می‌شود، چرا نتوانستیم به روشنی از تأثیر خداوند آگاهی یابیم؟"],[874,"نه سببها و اثرها مغز و پوست","چون بجویی جملگی آثار اوست","علت‌ها و نشانه‌ها مانند مغز و پوست نمی‌توانند جدا از هم باشند، زیرا تمامی آنچه که می‌جویی، در واقع آثار او (خدا) است."],[874,"دوست گیری چیزها را از اثر","پس چرا ز آثاربخشی بی‌خبر","اگر به تأثیرات و آثار چیزی توجه می‌کنی، پس چرا از منشأ و اصل آن چیز آگاه نیستی؟"],[874,"از خیالی دوست گیری خلق را","چون نگیری شاه غرب و شرق را","اگر از تخیل و خیال کمک می‌گیری تا دوستی با مردم پیدا کنی، چرا به سراغ پادشاهی مانند خداوندی که خالق شرق و غرب است، نمی‌روی؟"],[874,"این سخن پایان ندارد ای قباد","حرص ما را اندرین پایان مباد","این گفته هرگز پایان نمی‌یابد، ای قباد! امیدوارم در این بی‌نهایت، حرص و طمع ما نباشد."],[875,"باز گرد و قصه رنجور گو","با طبیب آگه ستارخو","برگرد و داستان بیمار را برای طبیب حکیم و دلسوز بازگو کن."],[875,"نبض او بگرفت و واقف شد ز حال","که امید صحت او بد محال","طبیب نبض بیمار را گرفت و از وضعیت او آگاهی یافت، زیرا امید به بهبودی او بسیار کم و غیرممکن به نظر می‌رسید."],[875,"گفت هر چت دل بخواهد آن بکن","تا رود از جسمت این رنج کهن","گفت هرکاری که دل می‌خواهد انجام بده تا این درد قدیمی از بدنت خارج شود."],[875,"هرچه خواهد خاطر تو وا مگیر","تا نگردد صبر و پرهیزت زحیر","هر آنچه که ذهن و دل تو می‌خواهد را انجام نده، زیرا اگر این کار را کنی، صبر و پرهیز تو از بین خواهد رفت."],[875,"صبر و پرهیز این مرض را دان زیان","هرچه خواهد دل در آرش در میان","صبر و پرهیز از این بیماری را بدانی که زیان دارد و هر چه دل بخواهد، در آن میان انجام بده."],[875,"این چنین رنجور را گفت ای عمو","حق تعالی اعملوا ما شئتم","عمو، این رنجور به خداوند اشاره کرده و می‌گوید: کارهای خود را انجام دهید، هر چه می‌خواهید بکنید، که خداوند از شما آگاه است."],[875,"گفت رو هین خیر بادت جان عم","من تماشای لب جو می‌روم","گفت برو، به سلامت باشد جان تو، من به تماشای لب‌های جوی می‌روم."],[875,"بر مراد دل همی‌گشت او بر آب","تا که صحت را بیابد فتح باب","او بر آب در حال گردش بود تا به آنچه که خواسته، یعنی صحت و سلامتی، برسد و درهای جدیدی به رویش باز شود."],[875,"بر لب جو صوفیی بنشسته بود","دست و رو می‌شست و پاکی می‌فزود","صوفی بر لب جوی نشسته بود و دست و صورتش را می‌شست تا به پاکی و پاکیزگی بیشتری دست یابد."],[875,"او قفااش دید چون تخییلیی","کرد او را آرزوی سیلیی","او (صوفی) پشت سرش را دید و هنگامی که اندیشه‌ای در سرش آمد، آرزوی زدنی (سیلی) را در دلش خواست."],[875,"بر قفای صوفی حمزه‌پرست","راست می‌کرد از برای صفع دست","حمزه‌پرست (فرقه‌ای از صوفیان) به دنبال کسی بود که با او دست بدهد و به این ترتیب، قصد داشت درد و رنج خود را فراموش کند."],[875,"کارزو را گر نرانم تا رود","آن طبیبم گفت کان علت شود","اگر من کارزو را نگوییم و او را نرانم، آن وقت می‌شود که طبیب را هم نمی‌بینم و به همان دلیل، وضع بیماری همچنان ادامه پیدا می‌کند."],[875,"سیلیش اندر برم در معرکه","زانک لا تلقوا بایدی تهلکه","اگر سیلی به او بزنم در معرکه، باید بدانم که نباید خود را به خطر بیفکنم."],[875,"تهلکه‌ست این صبر و پرهیز ای فلان","خوش بکوبش تن مزن چون دیگران","صبر و تحمل در این وضعیت، کاری نابودکننده است، ای فلانی! خوب است که او را بکوبی و مانند دیگران به او ضربه نزنی."],[875,"چون زدش سیلی برآمد یک طراق","گفت صوفی هی هی ای قواد عاق","وقتی صوفی (زاهد) سیلی به صورت او زد، او بدون تأمل از کلمات اعتراضی استفاده کرد و به او گفت که این کار نامناسب است. «قواد» در اینجا به معنی مادی‌گرایی یا انسان‌های اهل دنیا است که صوفی به او اشاره می‌کند."],[875,"خواست صوفی تا دو سه مشتش زند","سبلت و ریشش یکایک بر کند","صوفی خواست که چند مشت به صورت آن قواد بزند و یکی‌یکی موهای سبیل و ریش او را بکند."],[875,"خلق رنجور دق و بیچاره‌اند","وز خداع دیو سیلی باره‌اند","مردم به شدت رنجور، ضعیف و بی‌چاره هستند و از نیرنگ شیطان به شدت آسیب دیده‌اند."],[875,"جمله در ایذای بی‌جرمان حریص","در قفای همدگر جویان نقیص","تمام افراد بی‌گناه، با حرص و طمع به یکدیگر آزار می‌رسانند و در پی معایب و نقص‌های یکدیگر هستند."],[875,"ای زننده بی‌گناهان را قفا","در قفای خود نمی‌بینی جزا","ای کسی که به بی‌گناهان آسیب می‌زنی، در پشت سر خود جزا و کیفر اعمالت را نمی‌بینی."],[875,"ای هوا را طب خود پنداشته","بر ضعیفان صفع را بگماشته","ای کسی که خود را مانند طبیب می‌پنداری، ولی بر بی‌گناهان و ضعیفان ظلم و ستم می‌کنی و درد آن‌ها را نادیده می‌گیری."],[875,"بر تو خندید آنک گفتت این دواست","اوست که آدم را به گندم رهنماست","کسی که به تو می‌خندد و می‌گوید این دارو است، همان کسی است که آدم را به کاشت گندم و استفاده از آن راهنمایی کرده است."],[875,"که خورید این دانه، ای دو مستعین","بهر دارو تا تکونا خالدین","این دانه را شما، ای دو یاری که در طلب کمک هستید، بخورید تا به دارو تبدیل شود و شما همیشه سالم و جاویدان بمانید."],[875,"اوش لغزانید و او را زد قفا","آن قفا وا گشت و گشت این را جزا","او (شخص رنجوری که به دارو نیاز دارد) در حال لغزیدن است و کسی او را از پشت می‌زند، به طوری که سرش به پشتش می‌خورد و باعث می‌شود که او را تنبیه کنند."],[875,"اوش لغزانید سخت اندر زلق","لیک پشت و دستگیرش بود حق","او در حال لغزیدن و افتادن بود و به شدت به دردسر افتاده بود، ولی پشت و پشتیبانی‌اش حق (خدا) بود."],[875,"کوه بود آدم اگر پر مار شد","کان تریاقست و بی‌اضرار شد","اگر آدمی مانند کوه باشد و دچار حوادث و گرفتاری‌ها شود، باز هم وجود تریاقی در او هست که او را از آسیب‌ها محفوظ می‌دارد و بی‌ضرر می‌سازد."],[875,"تو که تریاقی نداری ذره‌ای","از خلاص خود چرایی غره‌ای","تو که حتی دارویی برای نجات خود نداری، چرا این‌قدر مغروری و خود را بزرگ می‌دانی؟"],[875,"آن توکل کو خلیلانه ترا","وآن کرامت چون کلیمت از کجا","تو که به نوعی سلیم و پر اعتماد به خدا هستی، کجا آن توکل و اعتماد همچون ابراهیم خلیل (که مظهر اعتماد به خداوند است) و آن کرامت و مقامی مانند موسی کلیم (که با خداوند سخن گفت) را بدست آوردی؟"],[875,"تا نبرد تیغت اسمعیل را","تا کنی شه‌راه قعر نیل را","تا زمانی که شمشیر اسماعیل (فرزند ابراهیم خلیل) بر نیافتاده و به قربانی نرفته، تو نمی‌توانی به عمق سفر و چالشی بزرگ در زندگی‌ات برسی."],[875,"گر سعیدی از مناره اوفتید","بادش اندر جامه افتاد و رهید","اگر کسی که از خاندان سادات است (سعید) از مناره‌ای بیفتد، باد در لباس او می‌افتد و او رهایی پیدا می‌کند."],[875,"چون یقینت نیست آن بخت ای حسن","تو چرا بر باد دادی خویشتن","ای حسن، وقتی که به یقین نمی‌دانی بخت و سرنوشتت چه خواهد شد، چرا خودت را به خطر می‌اندازی و به باد فنا می‌دهی؟"],[875,"زین مناره صد هزاران هم‌چو عاد","در فتادند و سر و سر باد داد","از این منار، هزاران نفر مانند قوم عاد (که در اثر عذاب الهی نابود شدند) سرنگون شده و در ویرانی‌ها قرار گرفتند و خودشان را به باد دادند."],[875,"سرنگون افتادگان را زین منار","می‌نگر تو صد هزار اندر هزار","تو افرادی را که از این برج (مناره) به زمین افتاده‌اند، با دقت ببین؛ چرا که این افراد، به‌طور تعداد بسیار زیادی (صد هزار) در این وضعیت قرار دارند."],[875,"تو رسن‌بازی نمیدانی یقین","شکر پاها گوی و می‌رو بر زمین","تو نعمت‌های بزرگی را نمی‌شناسی، پس دست از مسایل بیهوده بردار و بر روی زمین به زندگی عادی‌ات ادامه بده."],[875,"پر مساز از کاغذ و از که مپر","که در آن سودا بسی رفتست سر","از کاغذ و از هر چیز دیگر، پر از مشغله و افکار بی‌اساس نشو، چون در این افکار بی‌فایده، اندیشه‌های زیادی وجود دارد که انسان را از هدف اصلی‌اش دور می‌کند."],[875,"گرچه آن صوفی پر آتش شد ز خشم","لیک او بر عاقبت انداخت چشم","با اینکه آن صوفی در اثر خشم بسیار عصبانی و پرآتش شده، اما او بر نتیجه و پیامدهای کار خود تمرکز کرده و از آن غافل نیست."],[875,"اول صف بر کسی ماندم به کام","کو نگیرد دانه بیند بند دام","من به مدت طولانی در صف کسی ایستادم که به طمع او دانه‌ای نگیرم و به دام بیفتم."],[875,"حبذا دو چشم پایان بین راد","که نگه دارند تن را از فساد","دو چشم عقل و بصیرت که به حقیقت‌ها نگاه می‌کنند، چه خوب است که انسان را از فساد و ناپاکی‌ها نگه‌داری کنند."],[875,"آن ز پایان‌دید احمد بود کو","دید دوزخ را همین‌جا مو به مو","این بیت اشاره به بینش و بصیرت خاص پیامبر اسلام، احمد (حضرت محمد) دارد که به او این قابلیت داده شده تا دوزخ را دقیقا مشاهده کند، بدون این‌که از مکان خود دور شود. این توانایی نشان‌دهنده مقام والای او در درک حقایق است."],[875,"دید عرش و کرسی و جنات را","تا درید او پرده غفلات را","احمد (پیامبر) عرش و کرسی و بهشت‌ها را مشاهده کرد و پرده غفلت را کنار زد. این به این معناست که او توانست حقیقت‌هایی عمیق و روشن را درک کند که دیگران از آن بی‌خبر بودند."],[875,"گر همی‌خواهی سلامت از ضرر","چشم ز اول بند و پایان را نگر","اگر می‌خواهی از آسیب‌ها در امان باشی، از ابتدا به پیوند و انتهای کار توجه کن."],[875,"تا عدمها ار ببینی جمله هست","هستها را بنگری محسوس پست","اگر عدم‌ها را ببینی، همه موجودات در واقع هستند، پس باید چیزهای محسوس و پایین‌تر را نیز بررسی کنی."],[875,"این ببین باری که هر کش عقل هست","روز و شب در جست و جوی نیستست","این را ببین که هر کس، با عقل خود، روز و شب در جست‌وجوی چیزی است که وجود ندارد."],[875,"در گدایی طالب جودی که نیست","بر دکانها طالب سودی که نیست","در حال گدایی، از نعمت و بخشش‌های خداوند انتظار دارم، اما دریغ که چنین بخششی وجود ندارد. در دکان‌ها نیز به دنبال سودی هستم که در حقیقت وجود ندارد."],[875,"در مزارع طالب دخلی که نیست","در مغارس طالب نخلی که نیست","در مزارع، کسانی فقط به دنبال درآمد و سودی هستند که وجود ندارد، و در باغ‌ها فقط دنبال درخت خرما می‌گردند که وجود ندارد."],[875,"در مدارس طالب علمی که نیست","در صوامع طالب حلمی که نیست","در مکان‌های آموزشی (مدارس) کسانی به دنبال علمی هستند که وجود ندارد، و در محل‌های عبادت (صوامع) نیز متقاضی شخصیت (حلم) و بردباری هستند که در واقع در دسترس نیست."],[875,"هستها را سوی پس افکنده‌اند","نیستها را طالبند و بنده‌اند","نیازمندان به وجود و حقیقت را رها کرده‌اند و به دنبال چیزهای پوچ و بی‌معنی هستند و به آن‌ها وابسته شده‌اند."],[875,"زانک کان و مخزن صنع خدا","نیست غیر نیستی در انجلا","زیرا که وجود و منبع آفرینش خداوند تنها نیستی است و غیر از آن چیزی یافت نمی‌شود."],[875,"پیش ازین رمزی بگفتستیم ازین","این و آن را تو یکی بین دو مبین","پیش از این، رمز و رازی را بیان کرده‌ایم که تو باید آن را در میان دو چیز مشاهده کنی و از غیر آن دور باشی."],[875,"گفته شد که هر صناعت‌گر که رست","در صناعت جایگاه نیست جست","گفته شد که هر هنرمندی که در کار خود توانمند است، جایی برای او در دنیای صنعت و هنر وجود ندارد."],[875,"جست بنا موضعی ناساخته","گشته ویران سقفها انداخته","بنا، که ساخت و ساز می‌کند، مکانی است که خراب شده و به دلیل کار نکردن او، سقف‌ها خراب گشته است."],[875,"جست سقا کوزه‌ای کش آب نیست","وان دروگر خانه‌ای کش باب نیست","آب‌کش (سقا) به دنبال کوزه‌ای است که آب در آن نیست و کشاورزی هم خانه‌ای ندارد که در آن باشد؛ بنابراین، هیچ چیزی برای او پیدا نمی‌شود."],[875,"وقت صید اندر عدم بد حمله‌شان","از عدم آنگه گریزان جمله‌شان","در زمانی که شکار در عدم و عدم‌نما است، دشمنان به شدت از این وضعیت می‌ترسند و از آن فرار می‌کنند."],[875,"چون امیدت لاست زو پرهیز چیست","با انیس طمع خود استیز چیست","چرا از چیزی که امیدت را از آن می‌کنی پرهیز کنی، و چرا از دوست‌داشتن آنچه به آرزوهایت نزدیک است، دوری جویی؟"],[875,"چون انیس طمع تو آن نیستیست","از فنا و نیست این پرهیز چیست","چون دوستی و یاری تو، طمع و آرزو نیست، پس از فناء و نابودی چه پرهیز و احتیاجی داری؟"],[875,"گر انیس لا نه‌ای ای جان به سر","در کمین لا چرایی منتظر","اگر ای جان، دوست و همراهی در لا (مطلق وجود و حقیقت) نیستی، پس چرا به سر در کمین لا نشسته‌ای و منتظر هستی؟"],[875,"زانک داری جمله دل برکنده‌ای","شست دل در بحر لا افکنده‌ای","تو همه‌ی دل‌های خود را گسسته‌ای و دل‌ت را در دریا ویران و غرق کرده‌ای."],[875,"پس گریز از چیست زین بحر مراد","که بشستت صد هزاران صید داد","از چه رو از این دریا (بحر مراد) که آرزوها و خواسته‌هایت را در خود دارد می‌گریزی، در حالی که به تو صدها صید و نعمت داده است؟"],[875,"از چه نام برگ را کردی تو مرگ","جادوی بین که نمودت مرگ برگ","چرا نام برگ را مرگ گذاشتی، ای جادوگر بینا؟ چون تو مرگ را به شکل برگ به تو نشان دادی."],[875,"هر دو چشمت بست سحر صنعتش","تا که جان را در چه آمد رغبتش","چشمان تو تحت تأثیر سحر و جادوگری او بسته شده است، تا روح و جانت به چه چیزی جذب و راغب شود."],[875,"در خیال او ز مکر کردگار","جمله صحرا فوق چه زهرست و مار","در نظر او، تمام دشت‌ها و صحراها به خاطر مکر خداوند، مانند زهر و مار خطرناک و مضر هستند."],[875,"لاجرم چه را پناهی ساختست","تا که مرگ او را به چاه انداختست","چرا که او هیچ پناهگاهی برای خود نساخته است، به همین دلیل مرگ او را به دردسر انداخته و در گمراهی افکنده است."],[875,"اینچ گفتم از غلطهات ای عزیز","هم برین بشنو دم عطار نیز","ای عزیز، من این‌گونه از اشتباهات تو صحبت کردم، حالا هم به یاد داشته باش که سخنان عطار را نیز بشنو."],[876,"رحمة الله علیه گفته است","ذکر شه محمود غازی سفته است","مولانا می‌گوید که رحمت خدا بر او باد، نام سلطان محمود غازی در یادها به عنوان یک شخصیتی برجسته و مورد ستایش شناخته شده است."],[876,"کز غزای هند پیش آن همام","در غنیمت اوفتادش یک غلام","در اثر لشکرکشی به هند، یک جوان هندو به عنوان غنیمت در اختیار آن همام (سلطان محمود) قرار گرفت."],[876,"پس خلیفه‌ش کرد و بر تختش نشاند","بر سپه بگزیدش و فرزند خواند","سپس سلطان محمود او را خلیفه خود قرار داد و بر تخت سلطنت نشاند و در ارتش به او مقام و سمت ویژه‌ای داد و او را به عنوان فرزند خوانده خود پذیرفت."],[876,"طول و عرض و وصف قصه تو به تو","در کلام آن بزرگ دین بجو","در داستان تو، طول و عرض و توصیفش را در گفتار آن بزرگ دین (پیامبر یا یکی از پیشوایان دینی) جست‌وجو کن."],[876,"حاصل آن کودک برین تخت نضار","شسته پهلوی قباد شهریار","حاصل آن کودک، که اشاره به فرد یا نتیجه‌ای خاص دارد، بر این تخت نضار (تختی زیبا و با ارزش) در کنار قباد، که شهریار و پادشاهی است، قرار گرفته است."],[876,"گریه کردی اشک می‌راندی بسوز","گفت شه او را کای پیروز روز","گریه کردی و اشک می‌ریختی، پس از آن گفت شاه به او که ای پیروز! به نظر می‌رسد تو باید شجاع باشی."],[876,"از چه گریی دولتت شد ناگوار","فوق املاکی قرین شهریار","چرا گریه می‌کنی؟ وضعیت حکومت تو ناپسند شده است، در حالی که برتری تو بر زمین و ملک به عنوان پادشاه مشخص است."],[876,"تو برین تخت و وزیران و سپاه","پیش تختت صف زده چون نجم و ماه","تو بر روی این تخت نشسته‌ای و وزیران و سربازان در برابر تو صف کشیده‌اند، مانند ستاره‌ها و ماه که در آسمان در کنار یکدیگر قرار دارند."],[876,"گفت کودک گریه‌ام زانست زار","که مرا مادر در آن شهر و دیار","کودکی در حال گریه می‌گوید که علت گریه‌اش این است که مادرش او را در آن شهر و دیار رها کرده است."],[876,"از توم تهدید کردی هر زمان","بینمت در دست محمود ارسلان","تو هر بار که مرا می‌بینی، تهدید می‌کنی و از من می‌خواهی که تا وقتی محمود ارسلان در دست من است، مراقب باشم."],[876,"پس پدر مر مادرم را در جواب","جنگ کردی کین چه خشمست و عذاب","منظور این است که به خاطر تهدیدی که از طرف تو وجود دارد، پدر من مادر من را برای جنگ و انتقام آماده کرده است، و این نشان‌دهنده شدت خشم و عذاب اوست."],[876,"می‌نیابی هیچ نفرینی دگر","زین چنین نفرین مهلک سهلتر","طلاق و نفرین سرنوشت مادرش به قدری شدید و مهلک است که او هیچ نفرینی را به چنین سادگی و سختی نمی‌تواند بیابد و تصور کند."],[876,"سخت بی‌رحمی و بس سنگین‌دلی","که به صد شمشیر او را قاتلی","این بیت از بی‌رحمی و سنگدلی شخصی سخن می‌گوید که به جای کشتن فردی تنها با یک شمشیر، او را با صد شمشیر می‌کشد، که نشان‌دهنده شدت بی‌رحمی و خشونت اوست."],[876,"من ز گفت هر دو حیران گشتمی","در دل افتادی مرا بیم و غمی","من از شنیدن سخنان هر دو (سلطان محمود و غلام هندو) به شدت متحیر شده‌ام و در دل خود ترس و ناراحتی حس می‌کنم."],[876,"تا چه دوزخ‌خوست محمود ای عجب","که مثل گشتست در ویل و کرب","عجب است که چگونه محمود، اینقدر به دوزخ شبیه شده است، به طوری که در عذاب و درد شدید به سر می‌برد و مانند کسانی‌ست که در ویل (نعمت) و کرب (عذاب) قرار دارند."],[876,"من همی‌لرزیدمی از بیم تو","غافل از اکرام و از تعظیم تو","من از ترس تو به لرزه افتاده‌ام و در این حال، توجهی به احترام و بزرگی تو ندارم."],[876,"مادرم کو تا ببیند این زمان","مر مرا بر تخت ای شاه جهان","شعر از زبان شخصی است که از شاه جهان می‌خواهد مادرش را بیاورد تا او را در این لحظه ببیند، یعنی در حالی که بر تخت نشسته است. این درخواست نشان‌دهنده اهمیت مادر و آرزوی او برای دیدن فرزندش در موقعیت افتخارآمیز است."],[876,"فقر آن محمود تست ای بی‌سعت","طبع ازو دایم همی ترساندت","فقر و نیاز آن محمود (سلطان محمود) از تویی، ای کسی که اندیشه‌ات محدود است، و این فقر همیشه تو را می‌ترساند."],[876,"گر بدانی رحم این محمود راد","خوش بگویی عاقبت محمود باد","اگر رحم و مهربانی این محمود را بشناسی، می‌توانی بگویی که سرانجام محمود به خوبی و خوشی خواهد رسید."],[876,"فقر آن محمود تست ای بیم‌دل","کم شنو زین مادر طبع مضل","فقر، خاصیت محمود است؛ ای کسی که دلتوره‌ای، از این مادر که طبع (نفس) تو را گمراه کرده، چیزی نشنو."],[876,"چون شکار فقر کردی تو یقین","هم‌چوکودک اشک باری یوم دین","زمانی که فقر را به‌چنگ آوردی، همانند کودکانی که در روز دین (روز قیامت) اشک می‌ریزند، یقینا گریه خواهی کرد."],[876,"گرچه اندر پرورش تن مادرست","لیک از صد دشمنت دشمن‌ترست","هرچند در پرورش جسم انسان نقش مادر مهم است، اما باید دانست که دشمنی‌های درون و مشکلات و چالش‌های زندگی بیشتر از دشمنان بیرونی به او آسیب می‌زنند."],[876,"تن چو شد بیمار دارو جوت کرد","ور قوی شد مر ترا طاغوت کرد","وقتی بدن انسان بیمار شده باشد، پزشک را برای درمان آن به کار می‌گیرد، اما اگر بدن سالم و قوی شود، انسان به خودی خود بر طغیان و اقتدارش می‌افزاید."],[876,"چون زره دان این تن پر حیف را","نی شتا را شاید و نه صیف را","چون بدن آدمی در برابر خطرات و آسیب‌ها ضعیف و ناتوان است، نه می‌تواند از خوشی‌ها بهره‌مند شود و نه از امنیت و راحتی‌های زندگی."],[876,"یار بد نیکوست بهر صبر را","که گشاید صبر کردن صدر را","یار خوب، به انسان کمک می‌کند تا صبر کند و با این صبر، توانایی و ظرفیتش را برای تحمل سختی‌ها بیشتر کند."],[876,"صبر مه با شب منور داردش","صبر گل با خار اذفر داردش","صبر، مانند ماهی که در شب روشنایی می‌بخشد، دارای نوری است و مانند گلی که با خارهای تیز و خشن زندگی می‌کند، قدرت و زیبایی خاصی دارد."],[876,"صبر شیر اندر میان فرث و خون","کرده او را ناعش ابن اللبون","صبر همچون شیری در میان فضولات و خون است، که باعث می‌شود آن کسی که صبر دارد (غلام هندو) به شخصیت و مقام والایی دست یابد. ابن‌اللبون، گوساله‌ای است که هنوز از شیر می‌دوشند."],[876,"صبر جمله انبیا با منکران","کردشان خاص حق و صاحب‌قران","صبر، ویژگی تمام پیامبران الهی است؛ حتی در برابر کسانی که منکر آن‌ها هستند و این صبر فقط برای خداوند و صاحب قرآن است."],[876,"هر که را بینی یکی جامه درست","دانک او آن را به صبر و کسب جست","هرکس را که می‌بینی که لباس مناسبی بر تن دارد، بدان که او آن را با صبر و تلاش به دست آورده است."],[876,"هرکه را دیدی برهنه و بی‌نوا","هست بر بی‌صبری او آن گوا","هر کسی که دیدی بی‌پوشش و بی‌حالی است، بدان که به خاطر بی‌صبری او به این حالت افتاده است."],[876,"هرکه مستوحش بود پر غصه جان","کرده باشد با دغایی اقتران","هر کسی که احساس تنهایی و غم می‌کند، باید بداند که او به خاطر پیوستگی به امور مادی و دنیوی، دچار این احساس شده است."],[876,"صبر اگر کردی و الف با وفا","از فراق او نخوردی این قفا","اگر صبر کردی و در کنار وفاداری، درد جدایی او را تحمل نکردی، به تو می‌گوید که هنوز به او وابسته‌ای و این جدایی تو را آزار می‌دهد."],[876,"خوی با حق ساختی چون انگبین","با لبن که لا احب الافلین","تو در کنار حق و حقیقت به خوبی و لطافت رفتار می‌کنی، مانند شیرینی عسل که با شیر می‌آمیزد و هیچ‌گاه دوست ندارم با کسانی که در تاریکی و بی‌خبری هستند، همراه باشم."],[876,"لاجرم تنها نماندی هم‌چنان","که آتشی مانده به راه از کاروان","پس از اینکه خود را با حقیقت و حق ارتباط برقرار کردی، تنها نمانده‌ای، بلکه مانند آتش که در مسیر کاروان می‌درخشد و نمی‌میرد، همچنان زنده و با انرژی باقی مانده‌ای."],[876,"چون ز بی‌صبری قرین غیر شد","در فراقش پر غم و بی‌خیر شد","از آنجایی که بی‌صبری باعث دوری و جدایی از معشوق شده، او پر از غم و ناکامی گشته و از خیر و خوشی دور مانده است."],[876,"صحبتت چون هست زر ده‌دهی","پیش خاین چون امانت می‌نهی","تا زمانی که صحبت تو طلا و ارزشمند است، به خائنان اعتماد نکن، چرا که امانت را به آنها می‌سپاری."],[876,"خوی با او کن که امانتهای تو","آمن آید از افول و از عتو","با او رفتار کن که امانت‌های تو از آسیب و نقصان در امان خواهد بود."],[876,"خوی با او کن که خو را آفرید","خویهای انبیا را پرورید","با او رفتاری نیکو داشته باش، چراکه او ذاتش را خلق کرده و ویژگی‌های نیکوی انبیاء را در تو تقویت می‌کند."],[876,"بره‌ای بدهی رمه بازت دهد","پرورنده هر صفت خود رب بود","اگر بره‌ای به کسی بدهی، او نیز در مقابل آن به تو یک گله برمی‌گرداند، چرا که هر کسی به نسبت صفاتی که دارد، از خویش چیزی را به دیگران بازمی‌گرداند."],[876,"بره پیش گرگ امانت می‌نهی","گرگ و یوسف را مفرما همرهی","اگر بره‌ای را به گرگ بسپاری و به او اعتماد کنی، مانند این است که یوسف، پسر یعقوب را به گرگ بسپارد؛ زیرا گرگ هرگز نیت خوبی ندارد و ممکن است به او آسیب برساند."],[876,"گرگ اگر با تو نماید روبهی","هین مکن باور که ناید زو بهی","اگر گرگ به تو تظاهر کند که دوست است و به نیکی رفتار می‌کند، فریب نخور و باور نکن که از او چیزی خوب می‌آید."],[876,"جاهل ار با تو نماید هم‌دلی","عاقبت زخمت زند از جاهلی","اگر نادانی خود را با تو همدل نشان دهد، در نهایت به خاطر نادانی‌اش به تو آسیب خواهد زد."],[876,"او دو آلت دارد و خنثی بود","فعل هر دو بی‌گمان پیدا شود","این فرد دو نوع ویژگی یا خصوصیت دارد و در واقع، از هر دو جنسیت مظاهر خود را به وضوح نشان می‌دهد."],[876,"او ذکر را از زنان پنهان کند","تا که خود را خواهر ایشان کند","شخصی که در این بیت توصیف می‌شود، نامشخص کردن وجود خود به عنوان مرد را با پنهان کردن آلت تناسلی‌اش از زنان انجام می‌دهد تا بتواند خود را به عنوان خواهر آن‌ها نشان دهد."],[876,"شله از مردان به کف پنهان کند","تا که خود را جنس آن مردان کند","او (غلام هندو) با پنهان کردن شله، که نوعی دندان‌نما است، خود را به جای مردان نشان می‌دهد تا بتواند مانند آنها رفتار کند و خود را جمعی از مردان معرفی نماید."],[876,"گفت یزدان زان کس مکتوم او","شله‌ای سازیم بر خرطوم او","خدا گفت از آن شخص پنهان، ما شله‌ای (شرطی یا عذابی) برای او درست می‌کنیم که بر خرطوم او (یعنی بر نوک او) قرار گیرد."],[876,"تا که بینایان ما زان ذو دلال","در نیایند از فن او در جوال","بینایان و دانایان ما از علم و فن آن مرد (ذو دلال) بهره‌مند نمی‌شوند، زیرا به شناخت آن نمی‌رسند و در واقع درگیر روش او نمی‌شوند."],[876,"حاصل آنک از هر ذکر ناید نری","هین ز جاهل ترس اگر دانش‌وری","اگر از هر ذکر و یادآوری، فایده‌ای نبردی، بترس از نادانی که اگر آدم دانشمندی باشی، باید از او بترسی."],[876,"دوستی جاهل شیرین‌سخن","کم شنو کان هست چون سم کهن","دوستی با شخص نادان که به زبان خوش صحبت می‌کند، نشنوید؛ زیرا این دوستی مانند زهر قدیمی است که ضرر دارد."],[876,"جان مادر چشم روشن گویدت","جز غم و حسرت از آن نفزویدت","جان مادر که مایه روشنی چشم اوست، جز غم و حسرت چیزی از آن بچه به او نمی‌رسد و نمی‌تواند تأثیر مثبتی بر او بگذارد."],[876,"مر پدر را گوید آن مادر جهار","که ز مکتب بچه‌ام شد بس نزار","مادر به پدر می‌گوید که بچه‌ام در اثر رفتن به مکتب، بسیار ضعیف و بیمار شده است."],[876,"از زن دیگر گرش آوردیی","بر وی این جور و جفا کم کردیی","اگر از زنی دیگر فرزندی بیاوری، این گونه و با این بد رفتاری با او رفتار نمی‌کنی."],[876,"از جز تو گر بدی این بچه‌ام","این فشار آن زن بگفتی نیز هم","اگر جز تو کسی دیگری این بچه را به دنیا آورده بود، این فشار و سختی را نیز آن زن به تو می‌گفت."],[876,"هین بجه زین مادر و تیبای او","سیلی بابا به از حلوای او","بچه، از این مادر و تربیت او دور شو، که کتک پدر بهتر از شیرینی اوست."],[876,"هست مادر نفس و بابا عقل راد","اولش تنگی و آخر صد گشاد","مادر، نفس را به عنوان منبع و ریشه می‌شناسد و پدر، عقل را که در ابتدا موجب محدودیت و تنگی است، اما در نهایت باعث گشایش و آزادی می‌شود."],[876,"ای دهنده عقلها فریاد رس","تا نخواهی تو نخواهد هیچ کس","ای کسی که عقل‌ها را به بندگان عطا می‌کنی، فریادرس ما باش؛ زیرا اگر تو نخواهی، هیچ‌کس چیزی نخواهد."],[876,"هم طلب از تست و هم آن نیکوی","ما کییم اول توی آخر توی","ما از تو طلب می‌کنیم و تو هم نیکو هستی، پس در واقع ما در آغاز و پایان تو هستیم و همه چیز به تو وابسته است."],[876,"هم بگو تو هم تو بشنو هم تو باش","ما همه لاشیم با چندین تراش","تو هم بگو و هم بشنو، و هم وجود داشته باش؛ ما همه به شکل ظاهری هستیم و در واقع، با زحمت‌های گوناگون ساخته شده‌ایم."],[876,"زین حواله رغبت افزا در سجود","کاهلی جبر مفرست و خمود","از این ارجاع به سجده، رغبت و علاقه بیشتری به او پیدا می‌شود؛ کاهلی و سستی را به جبر و قهری منتقل کن که باعث رکود و بی‌حرکتی است."],[876,"جبر باشد پر و بال کاملان","جبر هم زندان و بند کاهلان","اگرچه جبر به معنای تقدیر و سرنوشت می‌تواند موجب پرواز و بال‌وپر دادن به انسان‌های کامل باشد، اما برای کسانی که کاهل هستند، جبر به نوعی زندان و محدودیت محسوب می‌شود."],[876,"هم‌چو آب نیل دان این جبر را","آب مؤمن را و خون مر گبر را","این جبر مانند آب نیل است که موجب زایش و زندگی مؤمنان می‌شود، در حالی که باعث مرگ و نابودی کافران (گبرها) می‌گردد."],[876,"بال بازان را سوی سلطان برد","بال زاغان را به گورستان برد","پرندگان بزرگ و باارزش را به سوی سلطان می‌برند، اما زاغان و پرندگان کم‌ارزش را به گورستان می‌برند."],[876,"باز گرد اکنون تو در شرح عدم","که چو پازهرست و پنداریش سم","باز به حال خود برگرد و در توضیح مفهوم عدم تأمل کن، زیرا عدم مانند پاز هر است و فکر می‌کنی که آن سم است."],[876,"هم‌چو هندوبچه هین ای خواجه‌تاش","رو ز محمود عدم ترسان مباش","ای خواجه، مانند آن پسر هندو، از محمود بگریز و از عدم نترس."],[876,"از وجودی ترس که اکنون در ویی","آن خیالت لاشی و تو لا شیی","تو از وجود خودت ترسیده‌ای و در خیال خود، بی‌ارزش و بی‌قیمت شده‌ای، در حالی که من می‌گویم تو هیچ نیستی."],[876,"لاشیی بر لاشیی عاشق شدست","هیچ نی مر هیچ نی را ره زدست","آن که به خود عشق ورزیده و از خود غافل شده است، هیچ چیز و هیچ کس را نمی‌بیند و از هر چیزی بی‌خبر است."],[876,"چون برون شد این خیالات از میان","گشت نامعقول تو بر تو عیان","زمانی که این افکار و خیالات از بین بروند، حقایق غیرمنطقی خودت به وضوح برایت نمایان می‌شود."],[877,"راست گفته‌ست آن سپهدار بشر","که هر آنک کرد از دنیا گذر","سخن آن فرمانده انسانی درست است که هر کس از این دنیا عبور کند، باید به یاد داشته باشد و از آنچه گذشته است، حسرت بخورد."],[877,"نیستش درد و دریغ و غبن موت","بلک هستش صد دریغ از بهر فوت","مرگ درد و ناراحتی‌ای ندارد، بلکه جای حسرت و دریغ از دست رفته‌ها و فرصت‌هایی است که از دست رفته‌اند."],[877,"که چرا قبله نکردم مرگ را","مخزن هر دولت و هر برگ را","به چه دلیل به مرگ به‌عنوان قبله نپرداختم، در حالی که او محل تجمع هر ثروت و هر نعمت است؟"],[877,"قبله کردم من همه عمر از حول","آن خیالاتی که گم شد در اجل","من در تمام عمرم به سوی آن افکاری که در گذر زمان از دست رفته‌اند، توجه کرده‌ام و آنان را به عنوان قبله و هدف خود قرار داده‌ام."],[877,"حسرت آن مردگان از مرگ نیست","زانست کاندر نقشها کردیم ایست","حسرت مردگان به خاطر مرگ نیست، بلکه به این دلیل است که عمرشان را در پی آرزوها و خیال‌ها گذرانده‌اند و در واقع چیزی را از دست داده‌اند."],[877,"ما ندیدیم این که آن نقش است و کف","کف ز دریا جنبد و یابد علف","ما نتوانستیم ببینیم که آنچه در این دنیا وجود دارد، تنها یک تصویر (نقش) است و این که مجسمه‌ای از دست‌ها که در آب دریا می‌لرزد، در اصل فقط گیاهی (علفی) را به دست آورد."],[877,"چونک بحر افکند کفها را به بر","تو بگورستان رو آن کفها نگر","چون دریا کف‌هایش را به سواحل می‌اندازد، تو به سوی قبرستان برو و آن کف‌ها را ببین."],[877,"پس بگو کو جنبش و جولانتان","بحر افکندست در بحرانتان","پس بگویید که کجاست آن حرکت و جنب و جوش شما، در حالی که دریا شما را به بحران و مشکلات افکنده است."],[877,"تا بگویندت به لب نی بل به حال","که ز دریا کن نه از ما این سؤال","به تو می‌گویند که در زندگی‌ات باید به حالت و احساست توجه کنی، نه فقط به ظواهر و حرف‌های دیگران. از تو می‌خواهند که از عمق وجود خود و درونت، نه فقط از روی ظاهر، به زندگی‌ات بپردازی."],[877,"نقش چون کف کی بجنبد بی ز موج","خاک بی بادی کجا آید بر اوج","نقش (تصویر) مانند کف روی آب، بدون حرکت می‌ماند، مگر اینکه موجی (تغییری) بیفتد؛ بدون وزش باد، خاک (زمینه) چگونه می‌تواند به اوج برسد و تغییر کند."],[877,"چون غبار نقش دیدی باد بین","کف چو دیدی قلزم ایجاد بین","وقتی که غبار نقش و اثر را دیدی، مانند این است که بادی از جایی می‌گذرد و با خود کف دریا را به همراه می‌آورد، پس به وجود دریا نیز توجه کن و آن را درک کن."],[877,"هین ببین کز تو نظر آید به کار","باقیت شحمی و لحمی پود و تار","به دقت نگاه کن که همه چیزهایی که از تو دیده می‌شود، مربوط به جسم و گوشت تو است که زودگار و موقتی هستند."],[877,"شحم تو در شمعها نفزود تاب","لحم تو مخمور را نامد کباب","چربی (شحم) تو در شمع‌ها سبب روشنی و تابش بیشتر نشده است و گوشت تو (لحم) برای مست‌ها به عنوان کباب سرو نشده است. این بیان نشان‌دهنده بی‌فایده بودن داشتن خواصی است که در حالت‌هایی دیگر استفاده نمی‌شوند."],[877,"در گداز این جمله تن را در بصر","در نظر رو در نظر رو در نظر","در این بیت، شاعر به گداز و ذوب شدن بدن اشاره دارد و می‌گوید که در هنگام تماشای معشوق، بدن انسان به گونه‌ای می‌گدازد و در دیدگان او ذوب می‌شود، به طوری که نگاه کردن به او، تمام توجه و احساسات را به خود جلب می‌کند."],[877,"یک نظر دو گز همی‌بیند ز راه","یک نظر دو کون دید و روی شاه","انسان با یک نگاه می‌تواند چیزهای بسیاری را درک کند؛ حتی با یک نگاه کوتاه، هم می‌تواند دنیای مادی و هم دنیای معنوی، به ویژه جمال و شکوه پادشاه، را ببیند."],[877,"در میان این دو فرقی بی‌شمار","سرمه جو والله اعلم بالسرار","میان دنیا و آخرت تفاوت‌های بسیاری وجود دارد که غیرقابل شمارش است، و خداوند به رازهای این تفاوت‌ها آگاه‌تر است."],[877,"چون شنیدی شرح بحر نیستی","کوش دایم تا برین بحر ایستی","وقتی که شرح و توضیح درباره دریاچه نیستی را شنیدی، همیشه تلاش کن تا در این دریا غرق نشوی و خود را نجات دهی."],[877,"چونک اصل کارگاه آن نیستیست","که خلا و بی‌نشانست و تهیست","کارگاه اصلی همه‌چیز، نیستی است که خالی و بدون نشانه و تهی از هرگونه وجود و شکل است."],[877,"جمله استادان پی اظهار کار","نیستی جویند و جای انکسار","استادان بزرگ به دنبال نشان دادن کار و اثر وجود نیستی هستند و در جستجوی نشانه‌ای از شکست و نقصان می‌باشند."],[877,"لاجرم استاد استادان صمد","کارگاهش نیستی و لا بود","پس به‌راستی استاد بزرگ استادان، کارگاه او (خدا) نیستی و عدم است و هیچ‌چیز نیست."],[877,"هر کجا این نیستی افزون‌ترست","کار حق و کارگاهش آن سرست","هرجا که نیستی بیشتر حس می‌شود، آن‌جا کار خدا و محل کارگاه او نیز به وضوح قابل مشاهده است."],[877,"نیستی چون هست بالایین طبق","بر همه بردند درویشان سبق","چون نیستی، وقتی هستی بالاتر از همه چیز را که درویشان در آن پیشی گرفته‌اند، به این معناست که در حقیقت وجود ندارد و برتر از همه، مقام آنان است."],[877,"خاصه درویشی که شد بی جسم و مال","کار فقر جسم دارد نه سؤال","در اینجا گفته می‌شود که درویش فقط وقتی که از دنیا رفته و بی‌مال و جسم شده است، واقعا دچار فقر می‌گردد. این نوع فقر به معنای کمبود مالی نیست، بلکه نداشتن جسم و مال باعث تأسف و حسرت او می‌شود."],[877,"سایل آن باشد که مال او گداخت","قانع آن باشد که جسم خویش باخت","سؤالی که کرده می‌تواند به این نتیجه برسد که کسی که مال و possessions خود را از دست بدهد، در واقع در وضعیتی قرار دارد که به آن عادت کرده و بی‌نیاز شده است. اما کسی که جسم خویش را (یعنی جان یا وجود خود را) از دست بدهد، دیگر چیزی برای رضایت نخواهد داشت."],[877,"پس ز درد اکنون شکایت بر مدار","کوست سوی نیست اسپی راهوار","از درد و غم حاضر شکایت نکن، زیرا آنچه از آن رنج می‌بری، چیزی نیست جز یک مسیر بی‌راه و بی‌نتیجه."],[877,"این قدر گفتیم باقی فکر کن","فکر اگر جامد بود رو ذکر کن","در این بیت به ما می‌گوید که ما به اندازه کافی در مورد مسائل صحبت کرده‌ایم، حالا بهتر است به فکر کردن ادامه دهیم. اگر فکر ما متوقف و بی‌تحرک باشد، باید آن را به یاد خدا آورده و به ذکر او مشغول شویم."],[877,"ذکر آرد فکر را در اهتزاز","ذکر را خورشید این افسرده ساز","ذکر (یاد خدا) باعث جنبش و تحرک فکر می‌شود، همان‌طور که خورشید می‌تواند به حالت افول و کسالت غلبه کند."],[877,"اصل خود جذبه است لیک ای خواجه‌تاش","کار کن موقوف آن جذبه مباش","شخص باید بداند که اصل و بنای وجودش بر جذبه و کشش الهی است، اما ای خواجه، تو باید خودت تلاش کنی و به کار و کوشش اهمیت بدهی، زیرا این کشش بدون تلاش تو پایدار نیست."],[877,"زانک ترک کار چون نازی بود","ناز کی در خورد جانبازی بود","چون ترک کار به مانند ناز کردن است، ناز را چگونه می‌توان با فدای خود و جانبازی دیگران درآمیخت؟"],[877,"نه قبول اندیش نه رد ای غلام","امر را و نهی را می‌بین مدام","غلام، نه به طور مداوم چیزی را قبول کن و نه انکار کن؛ فقط به نگاه کر