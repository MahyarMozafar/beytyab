ات) / کنایه: شب دراز (شب هجران و سخت) / تضاد معنوی: تخت جم، چاه بیژن. / معنی: برای آن کسی که بر تخت پادشاهی تکیه زده است، درازی شب‌ها معنایی ندارد. من سردی و سیاهی آن را در‌می‌یابم که در چاه تاریک هجران مانده‌ام. - منبع: شرح غزل‌های سعدی / دکتر محمدرضا برزگر خالقی / دکتر تورج عقدایی"],[411,"گویند سعدیا مکن از عشق توبه کن","مشکل توانم و نتوانم که نشکنم","می‌گویند ای سعدی، از عشق دست بکش و توبه کن؛ اما من می‌دانم که این کار برای من بسیار دشوار است و نمی‌توانم تحمل کنم که عشق را رها کنم."],[412,"آن دوست که من دارم، وآن یار که من دانم","شیرین‌دهنی دارد، دور از لب و دندانم","دوستی که من به آن عشق می‌ورزم و یاری که می‌شناسم، طعمی شیرین دارد، اما او از من دور است و لب‌ها و دندان‌هایش را نمی‌بینم."],[412,"بخت این نکند با من، کآن شاخ صنوبر را","بنشینم و بنشانم، گل بر سرش افشانم","بخت من اینقدر بد است که نمی‌توانم کنار آن درخت صنوبر بنشینم و گل‌هایی را بر روی سرش بریزم."],[412,"ای روی دل‌آرایت، مجموعه زیبایی","مجموع چه غم دارد، از من که پریشانم؟","ای صورت زیبای دل‌نشین، تو خود زیبایی کاملی؛ پس چرا نگران حال منی که در آشفتگی به سر می‌برم؟"],[412,"دریاب که نقشی ماند، از طرح وجود من","چون یاد تو می‌آرم، خود هیچ نمی‌مانم","درک کن که نشانی از وجود من باقی مانده است، اما وقتی به یاد تو می‌افتم، احساس می‌کنم که به کلی از بین می‌روم و هیچ نمی‌شوم."],[412,"با وصل نمی‌پیچم، وز هجر نمی‌نالم","حکم آن چه تو فرمایی، من بنده فرمانم","در عشق به تو، نه از وصال دوری می‌پیچم و نه از جدایی غمگین می‌شوم؛ فقط به آنچه تو بگویی عمل می‌کنم و مطیع دستورات تو هستم."],[412,"ای خوب‌تر از لیلی، بیم است که چون مجنون","عشق تو بگرداند، در کوه و بیابانم","ای زیباتر از لیلی، نگرانم که مبادا عشق تو مرا همچون مجنون کند و در بیابان و کوه سرگردان شوم."],[412,"یک پشت زمین دشمن، گر روی به من آرند","از روی تو بیزارم، گر روی بگردانم","اگر تمام دشمنان به من حمله کنند، من فرار نمی‌کنم و اگر کردم، الهی که از دیدارت محروم گردم. (AI: اگر تمام دشمنان دنیا پشت به من کنند، من از روی تو بیزار نخواهم شد حتی اگر تو از من روی بگردانی.)"],[412,"در دام تو محبوسم، در دست تو مغلوبم","وز ذوق تو مدهوشم، در وصف تو حیرانم","من به عشق و جذبه تو گرفتار و اسیر هستم، تحت سلطه تو قرار دارم و از زیبایی‌ات شگفت‌زده‌ام و نمی‌دانم چگونه تو را توصیف کنم."],[412,"دستی ز غمت بر دل، پایی ز پی‌ات در گل","با این همه صبرم هست، وز روی تو نتوانم","غم تو چنان بر دل من سنگینی می‌کند که به خاطر عشق تو در سختی و ناراحتی هستم و با وجود این که صبورم، نمی‌توانم از زیبایی تو چشم بپوشم."],[412,"در خفیه همی نالم، وین طرفه که در عالم","عشّاق نمی‌خسبند، از ناله پنهانم","من در خفا و پنهانی آه و ناله می‌زنم، و جالب اینجاست که در دنیای عاشقان هیچ‌کس در خواب نیست و همه از ناله‌های من باخبرند."],[412,"بینی که چه گرم آتش، در سوخته می‌گیرد؟","تو گرم‌تری زآتش، من سوخته‌تر زآنم","می‌بینی که از آتش در چوب سوخته چه شعله‌ای بلند می‌شود؛ اما تو از آتش گرم‌تر و من از آن سوخته، سوخته‌ترم. (AI: می‌بینی که از آتش در چوب سوخته چه شعله‌ای بلند می‌شود؛ اما خودت در سوز و گداز آتش من، بیشتر از آن سوخته‌ای.)"],[412,"گویند «مکن سعدی، جان در سر این سودا»","گر جان برود شاید، من زنده به جانانم","بعضی‌ها می‌گویند سعدی، عاشق این عشق نباش و جانت را برای آن فدای نکن. اما اگر جانم برود، من همچنان به معشوقم وابسته‌ام و زنده‌ام."],[413,"آن نه روی است که من وصف جمالش دانم","این حدیث از دگری پرس که من حیرانم","آنچه من از زیبایی او می‌گویم، روی او نیست. این موضوع را از کسی دیگر بپرس، چون من از زیبایی‌اش گیج شده‌ام و نمی‌توانم به درستی بیان کنم."],[413,"همه بینند نه این صنع که من می‌بینم","همه خوانند نه این نقش که من می‌خوانم","دیگران همه زیبایی و هنرهای محبوب را می‌بینند، اما آنچه من می‌بینم متفاوت است و به نوعی بی‌نظیر است. همچنین، هر کس متن‌ها و شعرها را می‌خواند، ولی من به گونه‌ای خاص و عمیق‌تر به آنچه می‌خوانم توجه دارم که درک دیگران از آن متفاوت است."],[413,"آن عجب نیست که سرگشته بود طالب دوست","عجب این است که من واصل و سرگردانم","عجیب نیست که کسی که به دنبال دوست است، سرگشته و گم شده باشد. عجیب این است که من که به دوست رسیدم، هنوز هم در سردرگمی هستم."],[413,"سرو در باغ نشانند و تو را بر سر و چشم","گر اجازت دهی ای سرو روان بنشانم","سرو، درختی بلند و زیبا، را در باغ می‌کارند و اگر تو اجازه دهی، من تو را با تمام احترام و محبت بر سر و چشم خود می‌گذارم و در کنار خود قرار می‌دهم."],[413,"عشق من بر گل رخسار تو امروزی نیست","دیر سال است که من بلبل این بستانم","عشق من به چهره تو تازه و نو نیست، زیرا مدت زیادی است که من بلبل این گلزار هستم و به تو عشق ورزیده‌ام."],[413,"به سرت کز سر پیمان محبت نروم","گر بفرمایی رفتن به سر پیکانم","به جان عزیز تو از محبت تو دست بر نمی‌دارم حتی اگر بگویی جان ببازم (به سر پیکان رفتن‌: یعنی سر بر سر نیزه رفتن) سعدی در بیتی دیگر می‌فرماید: گر بر سر پیکان برود طالب دوست/ حقا که هنوز منت دوست بروست"],[413,"باش تا جان برود در طلب جانانم","که به کاری به از این باز نیاید جانم","تا زمانی که جانم از بدن خارج نشده، در جستجوی معشوقم خواهم بود، چرا که هیچ کاری بهتر از این برای من نیست و جانم به آن وابسته است."],[413,"هر نصیحت که کنی بشنوم ای یار عزیز","صبرم از دوست مفرمای که من نتوانم","هر نصیحتی که به من می‌کنی می‌شنوم، ای دوست عزیز؛ اما از تو خواهش می‌کنم صبر را از من نخواهی، چون من ظرفیت تحمل دوری از تو را ندارم."],[413,"عجب از طبع هوسناک منت می‌آید","من خود از مردم بی‌طبع عجب می‌مانم","نکته تعجب‌آور این است که طبیعت هوسناک، گاهی به نیکی بر می‌گردد، در حالی که من از انسان‌های بی‌احساس و بی‌طبع فاصله می‌گیرم و به آنها تعلق ندارم."],[413,"گفته بودی که بود در همه عالم سعدی","من به خود هیچ نیم هر چه تو گویی آنم","تو گفته بودی که در تمام دنیا کسی مثل سعدی وجود ندارد، اما من به خودم هیچ اهمیتی نمی‌دهم و هر چه تو بگویی، من همان‌طور می‌شوم."],[413,"گر به تشریف قبولم بنوازی ملکم","ور به تازانه قهرم بزنی شیطانم","اگر با محبت و احترام به من رسیدگی کنی، مثل یک فرشته‌ام (که سجده می‌کنم)، و اگر با قهر و خشونت با من برخورد کنی، به مانند شیطانم (که رانده‌شده از درگاهم). (AI: اگر با محبت و احترام به من رسیدگی کنی، مثل یک پادشاه با من رفتار می‌کنی، و اگر با قهر و خشونت به من برخورد کنی، به مانند شیطانی خواهی شد که من را آزار می‌دهد.)"],[414,"اگر دستم رسد روزی که انصاف از تو بستانم","قضای عهد ماضی را شبی دستی برافشانم","اگر روزی فرصتی به دست آورم که از تو حق و انصاف بگیرم، شب را برای تو به یاد گذشته‌ها می‌گذرانم و دستم را به سوی تو دراز می‌کنم."],[414,"چنانت دوست می‌دارم که گر روزی فراق افتد","تو صبر از من توانی کرد و من صبر از تو نتوانم","من تو را آن‌چنان دوست دارم که اگر روزی بین ما جدایی پیش بیاید، تو می‌توانی تحمل کنی و صبر کنی اما من هرگز نمی‌توانم از تو فاصله بگیرم و صبر کنم."],[414,"دلم صد بار می‌گوید که چشم از فتنه بر هم نه","دگر ره دیده می‌افتد بر آن بالای فتانم","دل من بارها به من می‌گوید که از دیدن فتنه و زیبایی‌های آن چشم بپوشم، اما همیشه چشمم به آن محبوب زیبا می‌افتد."],[414,"تو را در بوستان باید که پیش سرو بنشینی","وگرنه باغبان گوید که دیگر سرو ننشانم","تو باید در باغ نشستی و در کنار درخت بلند (سرو) باشی، در غیر این صورت باغبان (کسی که به باغ رسیدگی می‌کند) می‌گوید که دیگر درخت بلندی نمی‌کارم."],[414,"رفیقانم سفر کردند هر یاری به اقصایی","خلاف من که بگرفته است دامن در مغیلانم","دوستانم به سفر رفته‌اند و هر یک به جایی دور از من، در حالی که من همچنان در مغیلان (منطقه‌ای در ایران) مانده‌ام و دامنم را اینجا گرفته‌ام."],[414,"به دریایی درافتادم که پایانش نمی‌بینم","کسی را پنجه افکندم که درمانش نمی‌دانم","در حال حاضر در مشکلات و سختی‌های زیادی قرار گرفته‌ام که راه نجاتی از آن‌ها نمی‌بینم. برای کمک به خودم به کسی پناه برده‌ام، اما نمی‌دانم چگونه می‌توانم از درد و رنجی که دارم رهایی یابم."],[414,"فراقم سخت می‌آید ولیکن صبر می‌باید","که گر بگریزم از سختی رفیق سست پیمانم","من : دوری از یار برایم بسیار سخت است . اما باید صبر کنم زیرا اگر از این سختی فرار کنم ، دوستی سست پیمان هستم"],[414,"مپرسم دوش چون بودی به تاریکی و تنهایی","شب هجرم چه می‌پرسی که روز وصل حیرانم","شب گذشته از تو در تاریکی و تنهایی پرسیدم که حال من چگونه است، اما چه فایده‌ای دارد که درباره هجر و دوری بپرسی، وقتی که در روز وصل هم گیج و سردرگم هستم؟"],[414,"شبان آهسته می‌نالم مگر دردم نهان ماند","به گوش هر که در عالم رسید آواز پنهانم","در شب به آرامی ناله می‌کنم تا دردهایم پنهان بماند و کسی متوجه آن‌ها نشود، اما صدای نالم به گوش هر کسی که در این دنیا برسد، می‌رسد و صدای پنهانی من شنیده می‌شود."],[414,"دمی با دوست در خلوت به از صد سال در عشرت","من آزادی نمی‌خواهم که با یوسف به زندانم","دقایقی را با دوست در تنهایی بودن، برتر از صد سال خوش‌گذرانی در زندگی‌ای است که آزادی‌ام را نمی‌خواهم، چراکه من مثل یوسف در زندان، شاد و خوشحالم."],[414,"من آن مرغ سخندانم که در خاکم رود صورت","هنوز آواز می‌آید به معنی از گلستانم","من مانند آن پرنده گویاست که در زیر خاک دفن شده، ولی صدایش هنوز می‌آید و نشان‌دهنده این است که من از باغ گلستان هستم."],[415,"ای مرهم ریش و مونس جانم","چندین به مفارقت مرنجانم","ای عشق، که برای دلم مانند مرهمی بر زخم‌ها هستی، چرا مرا با جدایی و دوری خود ناراحت می‌کنی؟"],[415,"ای راحت اندرون مجروحم","جمعیت خاطر پریشانم","ای آرامش بخش درون مجروح من؛ آسایش خاطر پریشان من."],[415,"گویند بدار دستش از دامن","تا دست بدارد از گریبانم","می‌گویند نباید دستانم را از دامنش بکشید تا اینکه او دستش را از گریبان من بردارد."],[415,"آن کس که مرا به باغ می‌خواند","بی روی تو می‌برد به زندانم","کسی که مرا به باغ دعوت می‌کند، در واقع بدون وجود تو، مرا به محبس و اسارت می‌برد."],[415,"وین طرفه که ره نمی‌برم پیشت","وز پیش تو ره به در نمی‌دانم","من نمی‌توانم به سوی تو بروم و از طرفی نمی‌دانم چگونه از نزد تو خارج شوم؛ به تعبیر دیگر، در میانه عشق و جدایی گیر کرده‌ام و گم کرده‌ام راهی برای فرار."],[415,"یک روز به بندگی قبولم کن","روز دگرم ببین که سلطانم","لحظه‌ای مرا به عنوان بنده بپذیر، و در روز دیگر ببین که چقدر با قدرت و شوکت سلطنت می‌کنم."],[415,"ای گلبن بوستان روحانی","مشغول بکردی از گلستانم","ای گلی که در بوستان روحانی مشغول پرورش و زیبایی هستی، تو باعث شدی که از گلستان خودم دور شوم و از آن بی‌خبر باشم."],[415,"زان روز که سرو قامتت دیدم","از یاد برفت سرو بستانم","از زمانی که قامت بلند تو را دیدم، تمام یاد و خاطرات سرو باغ را فراموش کردم."],[415,"آن درّ دو رسته در حدیث آمد","وز دیده بیوفتاد مرجانم","وقتی به سخن آمد و آن دو ردیف مروارید (دندانهایش) را دیدم، دیگر مرجان گران‌قیمت از چشمم افتاد."],[415,"گویند صبور باش از او سعدی","بارش بکشم که صبر نتوانم","می‌گویند که باید نسبت به او صبور باشی، اما من سعدی، توانایی صبر کردن ندارم و نمی‌توانم بار این بی‌صبری را تحمل کنم."],[415,"ای کاش که جان در آستین بودی","تا بر سر مونس دل افشانم","ای کاش جانم در آستینم بود تا بتوانم آن را بر سر محبوبی که دلم به او وابسته است، نثار کنم."],[416,"بس که در منظر تو حیرانم","صورتت را صفت نمی‌دانم","چنان در زیبایی و魅魅 تو حیران و شگفت‌زده‌ام که نمی‌توانم تو را با صفات و ویژگی‌ها توصیف کنم."],[416,"پارسایان ملامتم مکنید","که من از عشق توبه نتوانم","پارسایان (مردم پاک‌سرشت و بزرگوار)، مرا ملامت نکنید؛ زیرا من قادر نیستم از عشق دل بکنم و به آن پشت کنم."],[416,"هر که بینی به جسم و جان زنده‌ست","من به امید وصل جانانم","هر کس را که می‌بینی زنده و سرزنده است، من فقط به خاطر امید دیدار محبوبم زنده‌ام."],[416,"به چه کار آید این بقیت جان؟","که به معشوق برنیفشانم","این باقی‌مانده زندگی به چه دردی می‌خورد اگر نتوانم آن را برای معشوقم فدای او کنم؟"],[416,"گر تو از من عنان بگردانی","من به شمشیر برنگردانم","اگر تو از من دور شوی و کنترل را برگردانی، من هرگز با شمشیر به سراغ تو نخواهم آمد."],[416,"گر بخوانی، مقیم درگاهم","ور برانی، مطیع فرمانم","اگر تو مرا بخوانی، در کنار درگاهت می‌مانم و اگر مرا برانی، مطیع دستورات و احکام تو هستم."],[416,"من نه آنم که سست باز آیم","ور ز سختی به لب رسد جانم","من آدمی نیستم که در برابر سختی‌ها تسلیم شوم و بخواهم برگردم، حتی اگر جانم به لب برسد."],[416,"گر اجابت کنی و گر نکنی","چاره من دعاست، می‌خوانم","اگر به دعای من جواب بدهی یا ندهی، راه نجات من همین دعاست و من آن را می‌خوانم."],[416,"سهل باشد صعوبت ظلمات","گر به دست آید آب حیوانم","اگر به من آب حیات برسد، سختی و تاریکی‌های زندگی هم برایم آسان خواهد بود."],[416,"تا کی آخر جفا بری سعدی؟","چه کنم؟ پایبند احسانم","سعدی از کسی می‌پرسد که تا کی باید به او ظلم کند و می‌گوید چه کاری از او برمی‌آید، چون او کسی است که به لطف و نیکی دیگران وابسته است."],[416,"کار مردان تحمل است و سکون","من کی‌ام؟ خاک پای مردانم","مردان واقعی کسانی هستند که صبر و آرامش را برمی‌گزینند، اما من کی هستم که حتی به پای آن مردان هم می‌ارزم؟"],[417,"سخن عشق تو بی آن که برآید به زبانم","رنگ رخساره خبر می‌دهد از حال نهانم","من بدون آنکه از عشق تو سخنی بگویم ( همه کس عاشق بودن مرا درک می­کنند) زیرا رنگ چهره‌ی من به گونه‌­ای هست که از حال و درون من خبر می‌دهد."],[417,"گاه گویم که بنالم ز پریشانی حالم","بازگویم که عیان است چه حاجت به بیانم؟","گاه با خود چنین فکر می‌کنم که به خاطر داشتن چنین احوال پریشانی ناله سر دهم (تا شاید معشوق از حال و روز من با خبر شود) اما باز به خود می‌گویم که حال و روز من آشکار است و نیازی به بیان آن نیست."],[417,"هیچم از دنیی و عقبی نبرد گوشه خاطر","که به دیدار تو شغل است و فراغ از دو جهانم","از هنگامی که مشغول و سرگرم دیدن تو هستم سرسوزنی یه دنیا و آخرت توجه ندارم، و از هر دو جهان فارغ و رها گشته‌ام."],[417,"گر چنان است که روی من مسکین گدا را","به در غیر ببینی ز در خویش برانم","اگر چنان مقرر شده است که روزی من بیچاره و گدا، به در خانه‌ی کسی غیر از تو بروم همین حالا مرا از درگاه خود دور کن."],[417,"من در اندیشه آنم که روان بر تو فشانم","نه در اندیشه که خود را ز کمندت برهانم","من مدام در این فکر و اندیشه هستم که جان خود را تقدیم تو کنم و هرگز به این فکر نکرده‌­ام که خود را از دست تو نجات بخشم."],[417,"گر تو شیرین زمانی نظری نیز به من کن","که به دیوانگی از عشق تو فرهاد زمانم","اگر تو در حال حاضر شیرین روزگار و شاه خوبرویان هستی، نظر و عنایتی نیز به من داشته باش؛ چرا که من از شدت عشق به تو تبدیل به فرهاد روزگار شده‌ام."],[417,"نه مرا طاقت غربت نه تو را خاطر قربت","دل نهادم به صبوری که جز این چاره ندانم","نه من تاب و توان تحمل دوری از تو را دارم و نه تو میلی به نزدیک شدن به مرا داری، بنابراین تصمیم به صبوری و شکیبایی گرفته‌ام؛ چرا که جز این راه چاره­‌ای دیگر ندارم."],[417,"من همان روز بگفتم که طریق تو گرفتم","که به جانان نرسم تا نرسد کار به جانم","از همان روزی که قدم در راه عشق تو گذاشتم با خود گفتم: تا به مرگ نرسم، محال است که به وصال او برسم."],[417,"درم از دیده چکان است به یاد لب لعلت","نگهی باز به من کن که بسی در بچکانم","به یاد لب سرخگونت بسیار اشک خونین از چشمان خود می‌­ریزم، نگاه و عنایتی به من داشته باش تا ببینی چگونه زبانم کلمات مروارید مانند به پای تو نثار می‌کند."],[417,"سخن از نیمه بریدم که نگه کردم و دیدم","که به پایان رسدم عمر و به پایان نرسانم","شعر خود را که هنوز کامل نشده است و نیمه راه است به پایان می‌رسانم؛ چرا که هر چند نگاه و بررسی می­کنم می­بینم که اگر تا آخر عمر نیز مشغول سرایش شعر در وصف و مدح تو باشم باز نیز مدح و وصف تو را به پایان نمی‌توانم برسانم.(نکته: اگر چه این بیت، بیت آخر غزل سعدی است اما از این جهت که می‌خواهد شور و شوق خود را در وصف معشوق بیان کند، گفتار خود را تا اینجا نیمه می­انگارد و تکمیل آن را تا آخر عمر به حساب می‌آورد.)"],[418,"گر دست دهد هزار جانم","در پای مبارکت فشانم","اگر هزار جان داشته باشم، در راه تو قربانی می‌کنم."],[418,"آخر به سرم گذر کن ای دوست!","انگار که خاک آستانم","ای دوست، لطفا به من توجه کن و به یاد بیاور که من چقدر به پای درگاه تو ارزش قائل هستم، به اندازه خاکی که زیر پاهایت قرار دارد."],[418,"هر حکم که بر سرم برانی","سهل است، ز خویشتن مرانم","هر دستوری که بر من فرود آید آسان است؛ فقط خود را از من دور نکن. (AI: هر دستوری که بر من فرود آید آسان است؛ فقط خودم را از خودم دور نکنم.)"],[418,"تو خود سر وصل ما نداری","من عادت بخت خویش دانم","تو همچنین که به وصال ما دست نیافته‌ای، من هم به سرنوشت خود آگاه هستم."],[418,"هیهات که چون تو شاه‌بازی","تشریف دهد به آشیانم","چگونه ممکن است که مانند تو که پادشاه هنرمندی، به خانه من بیایی و برای من افتخار حضور به وجود آوری؟"],[418,"گر خانه محقر است و تاریک","بر دیده روشنت نشانم","هرچند خانه‌ام کوچک و تاریک است، اما وقتی تو را در آن ببینم، روشنایی خاصی دارد."],[418,"گر نام تو بر سرم بگویند","فریاد برآید از روانم","اگر نام تو را بر سرم بگویند، از عمق جانم فریاد می‌زنم."],[418,"شب نیست که در فراق رویت","زاری به فلک نمی‌رسانم","شبی نیست در شب‌هایی که دور از تو هستم، که ناله و فریادم به آسمان نرسد. (AI: در شب‌هایی که دور از تو هستم، نمی‌گذارم کسی از غم و اندوه من باخبر شود.)"],[418,"آخر نه من و تو دوست بودیم؟","عهد تو شکست و من همانم","آیا ما هرگز دوستان هم نبودیم؟ تو قول و قرار خود را شکستتی ولی من همچنان وفادار مانده‌ام."],[418,"من مهره مهر تو نریزم","الا که بریزد استخوانم","تا جسمم از بین برود و استخوان‌هایم بریزد، از مهره عشق تو دست نمی‌کشم. (AI: من فقط از روی عشق و محبت به تو می‌توانم به تو خدمت کنم، وگرنه برای من هیچ ارزش و معنی ندارد.)"],[418,"من ترک وصال تو نگویم","الا به فراق جسم و جانم","من هرگز از جدایی تو سخن نمی‌گویم مگر اینکه به جدایی روح و جسم من اشاره کنم."],[418,"مجنونم اگر بهای لیلی","ملک عرب و عجم ستانم","من مجنونم، اگر برای به‌دست آوردن لیلی، حتی یک قلمرو بزرگ و باارزش چون ملک عرب و عجم را بخواهند، آن را به دست می‌آورم و می‌پردازم. (AI: من دیوانه‌ام، اگر برای به‌دست آوردن لیلی، حتی یک قلمرو بزرگ و باارزش را به دست بیاورم.)"],[418,"شیرین زمان تویی به تحقیق","من بنده خسرو زمانم","شیرین تویی و من به‌طور مسلم نوکر و خدمت‌گزار بهترین و بزرگ‌ترین فرد زمان خودم، خسرو، هستم."],[418,"شاهی که ورا رسد که گوید","«مولای اکابر جهانم»","پادشاهی که شایسته است بگوید: من سرور بزرگان دنیا هستم. (AI: پادشاهی که به او برسند و بگویند من بزرگترین سرور دنیا هستم.)"],[418,"ایوان رفیعش آسمان را","گوید «تو زمین، من آسمانم»","ایوان بلند او به آسمان می‌گوید که تو زمین هستی و من آسمان، به این معنا که جایگاه او بسیار عالی و بلندتر از دیگران است."],[418,"دانی که ستم روا ندارد؟","مگذار که بشنود فغانم","آیا می‌دانی کسی هست که ظلم را تحمل نکند؟ نگذار کسی صدای ناله و فریاد من را بشنود."],[418,"هر کس به زمان خویشتن بود","من سعدی آخرالزمانم","هر کسی باید مطابق زمان خود رفتار کند، اما من، سعدی، نماینده و شاعر عصر خودم هستم."],[419,"مرا تا نقره باشد می‌فشانم","تو را تا بوسه باشد می‌ستانم","تا وقتی نقره (یعنی مال و ثروت) بر جای من است، آن را به پای تو می‌ریزم و وقتی بوسه (یعنی محبت و عشق) باشد، آن را از تو می‌گیرم."],[419,"و گر فردا به زندان می‌برندم","به نقد این ساعت اندر بوستانم","اگر فردا مرا به زندان ببرند، در عوض همین لحظه را در بوستان و در کنار تو می‌گذرانم."],[419,"جهان بگذار تا بر من سر آید","که کام دل تو بودی از جهانم","بگذار دنیا بگذرد و بر من تمام شود، چون آنچه از دنیا می‌خواستم، تو بودی. (AI: بگذار دنیا بگذرد تا آنچه می‌خواهم برایم پیش بیاید، چون آنچه تو از دنیا می‌خواستی، من بودم.)"],[419,"چه دامن‌های گل باشد در این باغ","اگر چیزی نگوید باغبانم","اگر در این باغ دامن‌های پرگل باشد، اما باغبان (خدا) چیزی نگوید و در حق من سخنی نراند، هیچ ارزشی نخواهد داشت."],[419,"نمی‌دانستم از بخت همایون","که سیمرغی فتد در آشیانم","من نمی‌دانستم که بخت خوب من چقدر بلندپرواز است که سیمرغ، پرنده‌ای افسانه‌ای و شگفت‌انگیز، به خانه‌ام می‌آید."],[419,"تو عشق آموختی در شهر ما را","بیا تا شرح آن هم بر تو خوانم","تو در شهری که ما زندگی می‌کنیم عشق را به ما یاد دادی؛ بیا تا من هم داستان و تشریح این عشق را برایت بگویم."],[419,"سخن‌ها دارم از دست تو در دل","ولیکن در حضورت بی زبانم","در دل من از دوری تو و محبتت حرف‌ها و سخنان زیادی دارم، اما وقتی در حضور تو می‌آیم، نمی‌توانم چیزی بگویم و زبانم بند می‌آید."],[419,"بگویم تا بداند دشمن و دوست","که من مستی و مستوری ندانم","باید بگویم تا هم دشمن و هم دوست بفهمند که من مستی و پنهان‌کاری را نمی‌شناسم. (AI: باید بگویم تا هم دشمن و هم دوست بفهمند که من نه حالتی از مستی دارم و نه چیزی را پنهان می‌کنم.)"],[419,"مگو سعدی مراد خویش برداشت","اگر تو سنگدلی من مهربانم","سعدی می‌گوید اگر تو به دل خود عمل کنی و احساسات مرا متوجه نشوی، من در عوض با مهربانی خود به تو پاسخ می‌دهم و از مرادم چیزی نمی‌گویم."],[419,"اگر تو سرو سیمین‌تن بر آنی","که از پیشم برانی من بر آنم","اگر تو با زیبایی و لطافت خود، قصد آن داری که مرا از نزد خود برانی، من هم بر سر آنم که: (بیت بعد) (AI: اگر تو با زیبایی و لطافت خود، از نزد من بروی، من هم اشتیاق دارم که به دنبال تو بروم.)"],[419,"که تا باشم خیالت می‌پرستم","و گر رفتم سلامت می‌رسانم","تا زمانی که در زندگی‌ هستم، به یاد تو و خاطراتت زندگی می‌کنم و اگر مردم، به تو سلام می‌رسانم. (AI: تا زمانی که در زندگی‌ام هستی، به یاد تو و خاطراتت زندگی می‌کنم و اگر روزی از من جدا شوی، به فکر تو و سلامتم خواهم بود.)"],[420,"ما همه چشمیم و تو نور ای صنم","چشم بد از روی تو دور ای صنم","ما همه مانند چشم هستیم که به تو نگاه می‌کنیم، و تو مانند نوری هستی که به ما می‌تابی، ای معشوق. چشم‌زخم از زیبایی تو دور باشد، ای محبوب."],[420,"روی مپوشان که بهشتی بود","هر که ببیند چو تو حور ای صنم","چهره‌ات را نپوشان که هر کسی که تو را ببیند، بهشتی می‌شود و مثل حورهای بهشتی خواهد بود."],[420,"حور خطا گفتم اگر خواندمت","ترک ادب رفت و قصور ای صنم","اگر به اشتباه تو را «حور» خوانده‌ام، ناشی از بی‌ادبی و قصور من است."],[420,"تا به کرم خرده نگیری که من","غایبم از ذوق حضور ای صنم","ای محبوب من، خواهش می‌کنم بر من خرده نگیر که من به خاطر علاقه‌ات و شوقی که به تو دارم، در این لحظه از حس وجود تو دور هستم."],[420,"روی تو بر پشت زمین خلق را","موجب فتنه‌ست و فتور ای صنم","چهره تو بر روی زمین مایه آشفتگی و مشکلات برای مردم است، ای معشوق."],[420,"این همه دلبندی و خوبی تو را","موضع ناز است و غرور ای صنم","وجود این همه محبت و زیبایی تو، نشان‌دهنده ناز و خودداری توست، ای معشوق."],[420,"سروبنی خاسته چون قامتت","تا ننشینیم صبور ای صنم","ای زیبارو، برای این که صبر از دست بدهیم، بلندبالایی همچون تو به پای خاسته است."],[420,"این همه طوفان به سرم می‌رود","از جگری همچو تنور ای صنم","ای زیبارو، این همه طوفان بلا که به سرم می‌آید، ناشی از جگر آتشین همچون تنورم است."],[420,"سعدی از این چشمه حیوان که خورد","سیر نگردد به مرور ای صنم","سعدی می‌گوید کسی که از چشمه حیوان (چشمه حیات یا عشق) بنوشد هرگز سیر نمی‌شود و همیشه خواهان بیشتری از آن است، ای صنم."],[421,"چون من به نفس خویشتن این کار می‌کنم","بر فعل دیگران به چه انکار می‌کنم؟","من وقتی خودم به خاطر نفس خودم چنین کاری می‌کنم، چرا باید کار دیگران را انکار کنم؟"],[421,"بلبل سماع بر گل بستان همی کند","من بر گل شقایق‌رخسار می‌کنم","پرنده‌ای در باغ گل مشغول آوازخوانی است، من نیز به زیبایی او که چهره‌اش چون گل شقایق است، می‌پردازم. (AI: پرنده‌ای که در باغ گل مشغول آوازخوانی است، من نیز در کنار گل شقایق، به زیبایی خود می‌پردازم.)"],[421,"هر جا که سرو‌قامتی و موی دلبریست","خود را بدان کمند گرفتار می‌کنم","هر کجا که زیبایی و لطافت وجود دارد، خودم را به آنجا می‌اندازم و به دلبری می‌سپارم."],[421,"گر تیغ برکشند عزیزان به خون من","من همچنان تأمل دیدار می‌کنم","اگر عزیزان (دوستان یا معشوقان) تیغ بکشند و بخواهند مرا بکشند، من همچنان در انتظار دیدار آنها خواهم ماند و به همین فکر مشغولم."],[421,"هیچم نماند در همه عالم به اتفاق","الا سری که در قدم یار می‌کنم","در تمام عالم هیچ چیز برای من باقی نمانده است، جز سری که در پای یار فدا کنم. (AI: در تمام عالم هیچ چیز برای من باقی نمانده است، جز اسراری که در حضور یار به آن مشغول هستم.)"],[421,"آن‌ها که خوانده‌ام همه از یاد من برفت","الّا حدیث دوست که تکرار می‌کنم","تمام دانسته‌ها و تجربیاتی که دارم از یادم رفته‌اند، به‌جز داستان و یاد دوست که مرتب آن را برای خودم بازگو می‌کنم."],[421,"چون دست قدرتم به تمنا نمی‌رسد","صبر از مراد نفس به ناچار می‌کنم","وقتی که قدرت من به خواسته‌ام نرسد، ناچارا از خواسته‌های خودم صبر می‌کنم و آن‌ها را کنار می‌گذارم."],[421,"همسایه گو گواهی مستی و عاشقی","بر من مده؛ که خویشتن اقرار می‌کنم","همسایه از تو نخواهم که درباره حال مستی و عشق من شهادت بدهی، چون خودم به این وضعیت اعتراف می‌کنم."],[421,"من بعد از این نه زهد فروشم نه معرفت","کان در ضمیر نیست؛ که اظهار می‌کنم","از این پس نه به زهد (زندگی پرهیزگارانه) ادامه می‌دهم و نه به دانش و معرفتی می‌پردازم که در دل ندارم، زیرا آنچه را که درونم هست بیان می‌کنم."],[421,"جان است و از محبت جانان دریغ نیست","اینم که دست می‌دهد ایثار می‌کنم","جان من از محبت معشوق دریغ نمی‌دارد، بنابراین من هم به کسی که نیازمند است کمک می‌کنم و ایثار می‌کنم."],[421,"زنّار اگر ببندی سعدی هزار بار","به زان که خرقه بر سر زنّار می‌کنم","سعدی، اگر به خود آشکارا زنار ببندی، هزار بار بهتر از اینکه آن را با خرقه پارسایی، پنهان سازی. / زنّار: غزل 111 بیت 9 / (AI: اگر به خود زنجیری ببندی، من هزار بار این را نادیده می‌گیرم چون من شما را با پوشش خود قبول می‌کنم.)"],[422,"آن کس که از او صبر محال است و سکونم","بگذشت، ده انگشت فرو برده به خونم","شخصی که نمی‌توانم بی‌او صبر و قرار داشته باشم، حالا انگشتانش را در خون من فرو کرده است. (AI: شخصی که نتوانم او را تحمل کنم و در کنار او آرامش نداشته باشم، حالا انگشتانش را در خون من فرو کرده است.)"],[422,"پرسید که چونی ز غم و درد جدایی","گفتم نه چنانم که توان گفت که چونم","وقتی از من پرسیدند حال من از غم و درد جدایی چگونه است، گفتم که نمی‌توانم حال خود را به درستی توصیف کنم."],[422,"زان گه که مرا روی تو محراب نظر شد","از دست زبان‌ها به تحمل چو ستونم","وقتی که چهره تو برایم مانند مکان اصلی عبادت و پرستش شد، از شدت عشق و ارادت به تو، دیگر نمی‌توانم به زبان‌های دیگر شرح دهم و چون یک ستون محکم ایستاده‌ام."],[422,"مشنو که همه عمر جفا برده‌ام از کس","جز بر سر کوی تو که دیوار زبونم","منظور این بیت این است که هرگز نشنو که من در تمام عمرم از کسی غیر از تو ظلم و آزار دیده‌ام، زیرا من فقط در کنار کوی تو با دیواری ضعیف و ناتوان مواجه هستم."],[422,"بیم است چو شرح غم عشق تو نویسم","کآتش به قلم در فتد از سوز درونم","نگرانی دارم که اگر درباره درد عشق تو بنویسم، آتش دلی که در درونم می‌سوزد، به نوک قلمم سرایت کند و آن را بسوزاند."],[422,"آنان که شمردند مرا عاقل و هشیار","کو تا بنویسند گواهی به جنونم","کسانی که مرا عاقل و هوشیار به حساب آوردند، حالا کجا هستند تا گواهی بدهند که من دیوانه‌ام؟"],[422,"شمشیر برآور که مرادم سر سعدیست","ور سر ننهم در قدمت عاشق دونم","سعدی از چنگال عشق و احساسات نمی‌تواند فرار کند و اگر عشق او را بکشد، او باید با سربلندی سرش را تقدیم کند؛ چرا که اگر از عشق سر بر نکند، عاشق پست و بی‌ارزشی خواهد بود."],[423,"ز دستم بر نمی‌خیزد که یک دم بی تو بنشینم","به جز رویت نمی‌خواهم که روی هیچ کس بینم","از دستم نمی‌آید که لحظه‌ای بی‌تو آرام بنشینم و جز چهره تو، هیچ‌کس دیگری را نمی‌خواهم ببینم."],[423,"من اول روز دانستم که با شیرین درافتادم","که چون فرهاد باید شست دست از جان شیرینم","من از همان ابتدا فهمیدم که انسان وقتی عاشق بشود باید مثل فرهاد دست از جان خویش بشوید و جانش را در راه عشق فدا کند."],[423,"تو را من دوست می‌دارم خلاف هر که در عالم","اگر طعنه است در عقلم اگر رخنه است در دینم","من تو را دوست دارم، حتی اگر دیگران به این عشق من ایراد بگیرند و در عقل و دین من شک کنند."],[423,"و گر شمشیر برگیری سپر پیشت بیندازم","که بی شمشیر خود کشتی به ساعدهای سیمینم","اگر شمشیر به دست بگیری، من سپر را کنار می‌زنم؛ چون با دستان خود تو را در مبارزه نزدیکی به زیبایی ضعف می‌کنم."],[423,"برآی ای صبح مشتاقان اگر نزدیک روز آمد","که بگرفت این شب یلدا ملال از ماه و پروینم","ای صبح، که مشتاقان در انتظار تو هستند، برآی اگر روز به زودی فرا برسد، چرا که شب یلدا غم و اندوهی بر من نیاورده است و من به ماه و ستاره پروین فکر نمی‌کنم."],[423,"ز اول هستی آوردم قفای نیستی خوردم","کنون امید بخشایش همی‌دارم که مسکینم","من از ابتدای وجودم، دنبال چیزی به نام «نیستی» بودم و در این مسیر، رنج‌ها را تحمل کردم. حالا تنها امیدی که دارم این است که خداوند به من رحم کند، زیرا من فردی بی‌چاره و درمانده‌ام."],[423,"دلی چون شمع می‌باید که بر جانم ببخشاید","که جز وی کس نمی‌بینم که می‌سوزد به بالینم","دل من باید مانند شمعی باشد که بر جانم نور بیفروزد، زیرا کسی جز او را نمی‌بینم که در کنارت به خاطر من می‌سوزد و از عشق من دچار رنج و آتش است."],[423,"تو همچون گل ز خندیدن لبت با هم نمی‌آید","روا داری که من بلبل چو بوتیمار بنشینم","تو مانند گل شکفته همیشه خندانی، آنقدر که حتی برای یک آن، (مثل غنچه سربسته) لب هایت بسته نمی شوند. پس من که مانند بلبل (در عشق گل آواز می خوانم) چگونه رواست که مانند پرنده ی بوتیمار، خاموش و افسرده بنشینم؟"],[423,"رقیب انگشت می‌خاید که سعدی چشم بر هم نه","مترس ای باغبان از گل که می‌بینم نمی‌چینم","رقیب (دشمن یا رقیب عشقی) با کنایه به تو زیر نظر است و انگشتش را به حالت تعجب بر لبش گذاشته است. سعدی به باغبان می‌گوید که نگران گل‌ها نباشد، چون او که به رؤیت گل‌ها افتاده، قصد چیدن آن‌ها را ندارد و به کسی آسیب نمی‌زند."],[424,"من از تو صبر ندارم که بی تو بنشینم","کسی دگر نتوانم که بر تو بگزینم","من از تو طاقت ندارم که بدون تو بمانم و نمی‌توانم کسی دیگر را برگزینم."],[424,"بپرس حال من آخر چو بگذری روزی","که چون همی‌گذرد روزگار مسکینم؟","اگر روزی از کنار من گذشتی، حال مرا بپرس که می‌خواهم بدانم در این روزگار سخت، وضعیت من چگونه است."],[424,"من اهل دوزخم ار بی‌تو زنده خواهم شد","که در بهشت نیارد خدای غمگینم","اگر بدون تو در روز حشر زنده شوم، اهل عذاب و جهنم هستم؛ که من غمگین و دل مرده را خداوند به بهشت نخواهد برد."],[424,"ندانمت که چه گویم تو هر دو چشم منی","که بی‌وجود شریفت جهان نمی‌بینم","نمی‌دانم چه باید بگویم، تو تمامی وجود من هستی و من بدون حضور تو نمی‌توانم به جهان نگاه کنم."],[424,"چو روی دوست نبینی جهان ندیدن به","شب فراق منه شمع پیش بالینم","وقتی چهره دوست را نبینی، بهتر است اصلا جهان را نبینی. در شب جدایی، شمع را بر سر بستر نگذار، زیرا بدون او روشنایی زندگی بی‌معناست."],[424,"ضرورت است که عهد وفا به سر برمت","و گر جفا به سر آید هزار چندینم","لازم است که به وعده خود تا انتها وفا کنم حتی اگر هزار برابر دچار زحمت و سختی و ستم شوم. (AI: لازمه است که به وعده خود وفا کنی و اگر بیوفایی کنی، من چه بسا دچار زحمت و سختی می‌شوم.)"],[424,"نه هاونم که بنالم به کوفتی از یار","چو دیگ بر سر آتش نشان که بنشینم","من مثل هاون نیستم که از درد کوفتن یار ناله کنم، مثل دیگ روی آتش بگذار مرا تا قرار گیرم و بسوزم. (AI: من مثل هاونی نیستم که از درد فراق یار ناله کنم، مثل دیگی که روی آتش است و منتظر است تا پر از غذا شود، من نیز منتظرم بمانم و آرامش پیدا کنم.)"],[424,"بگرد بر سرم ای آسیای دور زمان","به هر جفا که توانی که سنگ زیرینم","ای زمانه، تو مانند آسیای بزرگ چرخش کن و بر سرم بگرد، هر گونه سرزنشی که می‌خواهی بر من بیفکن، چون من سنگی هستم که زیر آن قرار دارد."],[424,"چو بلبل آمدمت تا چو گل ثنا گویم","چو لاله لال بکردی زبان تحسینم","من به تو به مانند بلبل نزدیک شدم تا تو را ستایش کنم، اما تو مثل لاله زبان ستایش مرا لال کردی. (AI: من به تو به مانند بلبل نزدیک شدم تا تو را ستایش کنم، اما تو مثل لاله زبانت را بسته‌ای و نتوانستی از زیبایی‌ات سخن بگویی.)"],[424,"مرا پلنگ به سرپنجه ای نگار نکشت","تو می‌کشی به سر پنجه نگارینم","تو ای محبوب من، با نازها و زیبایی‌های خود به من آسیب نمی‌زنی، اما من به دست‌های زیبایت کشته می‌شوم."],[424,"چو ناف آهو خونم بسوخت در دل تنگ","برفت در همه آفاق بوی مشکینم","وقتی که قلبم به خاطر درد و شوق مانند خون ناف آهو سوخت، عطر خوشم در تمام دنیا پخش شد. (AI: وقتی که قلبم به خاطر درد و شوق به یاد آهو سوخت، عطر خوشم در تمام دنیا پخش شد.)"],[424,"هنر بیار و زبان آوری مکن سعدی","چه حاجت است بگوید شکر که شیرینم","ای سعدی، هنر خود را ظاهر کن و از زبان آوری خودداری کن، زیرا نیازی نیست که بگویم من مانند شکر شیرینم."],[425,"منم یا رب در این دولت که روی یار می‌بینم","فراز سرو سیمینش گلی بر بار می‌بینم","خدای من، من در این خوشی و خوشبختی هستم که چهره محبوبم را می‌بینم و بر سر درخت زیبا و نقره‌ای‌اش، گلی را مشاهده می‌کنم."],[425,"مگر طوبی برآمد در سرابستان جان من","که بر هر شعبه‌ای مرغی شکرگفتار می‌بینم","شاید در بهشت، درخت طوبی (درختی در بهشت) در سرابستان (زمین خیالی) جان من روییده است، چرا که بر هر شاخه‌اش پرنده‌ای را می‌بینم که سخنانی شیرین و دلنشین می‌گوید."],[425,"مگر دنیا سر آمد کاین چنین آزاد در جنت","می بی‌درد می‌نوشم گل بی‌خار می‌بینم","آیا دنیا به پایان رسیده که من این‌قدر آزادانه در بهشت از درد بی‌خبر هستم و گل‌های بدون خار را می‌بینم؟"],[425,"عجب دارم ز بخت خویش و هر دم در گمان افتم","که مستم یا به خوابم یا جمال یار می‌بینم","تعجب می‌کنم از سرنوشت خودم و هر لحظه در تردید هستم که آیا مست هستم یا خواب می‌بینم، یا اینکه واقعا چهره محبوبم را می‌بینم."],[425,"زمین بوسیده‌ام بسیار و خدمت کرده تا اکنون","لب معشوق می‌بوسم رخ دلدار می‌بینم","من بارها به زمین بوسه زده‌ام و در خدمت معشوق بوده‌ام تا به اینجا رسیده‌ام که لب‌های او را می‌بوسم و چهره‌اش را می‌بینم."],[425,"چه طاعت کرده‌ام گویی که این پاداش می‌یابم","چه فرمان برده‌ام گویی که این مقدار می‌بینم","انگار من چه کار نیکو یا اطاعتی انجام داده‌ام که این‌قدر پاداش می‌گیرم، یا چه قدر از دستورات پیروی کرده‌ام که این‌ ارج و قدر را تجربه می‌کنم. (AI: انگار من چه کار نیکو یا اطاعتی انجام داده‌ام که این‌قدر پاداش می‌گیرم، یا چه قدر از دستورات پیروی کرده‌ام که این‌گونه بلاها و مشکلات را تجربه می‌کنم.)"],[425,"تویی یارا که خواب آلود بر من تاختن کردی","منم یا رب که بخت خود چنین بیدار می‌بینم","تو ای یار، که به صورت خواب آلودی به من حمله‌ور شدی، من نیز خدا را شاهد می‌گیرم که بخت و شانس خود را به این صورت بیدار و روشن می‌بینم."],[425,"چو خلوت با میان آمد نخواهم شمع کاشانه","تمنای بهشتم نیست چون دیدار می‌بینم","وقتی با او خلوت می‌کنم، دیگر نیازی به روشنایی شمع در خانه‌ام ندارم؛ چون دیدن چهره‌ات برای من از بهشت هم خواستنی‌تر است. (AI: وقتی در تنهایی به فکر می‌روم، دیگر نیازی به روشنایی شمع در خانه‌ام ندارم؛ چون دیدن چهره‌ات برای من از بهشت هم خواستنی‌تر است.)"],[425,"کدام آلاله می‌بویم که مغزم عنبرآگین شد","چه ریحان دسته بندم چون جهان گلزار می‌بینم","نمی‌دانم کدام گل خوشبویی را می‌توانم بو بکشم که باعث شده مغزم پر از عطر عنبر شود. با این حال، حتی اگر ریحان را دسته کنم، چون بهشت و گلستان را در دنیا می‌بینم، اهمیت چندانی ندارد."],[425,"ز گردون نعره می‌آید که اینت بوالعجب کاری","که سعدی را ز روی دوست برخوردار می‌بینم","صداهایی از آسمان می‌آید که کار عجیبی است، زیرا من سعدی را از روی دوستی که دارد، خوشبخت و برخوردار می‌بینم."],[426,"دلم تا عشق باز آمد، در او جز غم نمی‌بینم","دلی بی‌غم کجا جویم؟ که در عالم نمی‌بینم","هنگامی که عشق به دل باز می‌گردد، جز غم در آن نمی‌یابم. کجا می‌توانم دلی بی‌غم پیدا کنم، زیرا در این دنیا چنین دلی وجود ندارد؟"],[426,"دمی با هم‌دمی خرّم، ز جانم بر نمی‌آید","دمم با جان برآید چون که یک هم‌دم نمی‌بینم","من در لحظه‌ای با یک هم‌صحبت خوشحالم، اما از آنجا که جانم در این حالت نمی‌تواند پایدار باشد، نمی‌توانم با کسی که هم‌صحبت من باشد، ارتباط برقرار کنم."],[426,"مرا رازی‌ست اندر دل، به خون دیده پرورده","ولیکن با که گویم راز؟ چون محرم نمی‌بینم","در دل من یک رازی وجود دارد که با زخم چشمم آن را بزرگ کرده‌ام، اما نمی‌دانم با کی آن را بگویم، چون کسی را که بتوانم به او اعتماد کنم و راز خود را با او در میان بگذارم، نمی‌بینم."],[426,"قناعت می‌کنم با درد، چون درمان نمی‌یابم","تحمل می‌کنم با زخم، چون مرهم نمی‌بینم","چون درمانی برای دردهای خود نمی‌یابم، با وجود درد قناعت می‌کنم و از طرفی، چون مرهمی برای زخم‌هایم وجود ندارد، تحمل می‌کنم."],[426,"خوشا و خرّما آن دل که هست از عشق بیگانه","که من تا آشنا گشتم دل خرّم نمی‌بینم","خوشا به حال دلی که با عشق بیگانه است؛ چرا که من وقتی با عشق آشنا شدم، دیگر دل شاد و خوشی ندارم. (AI: خوشا به حال دل‌هایی که عشق بیگانه را تجربه می‌کنند؛ چرا که من وقتی با عشق آشنا شدم، دیگر دل شاد و خوشی ندارم.)"],[426,"نم چشم، آبروی من ببرد از بس که می‌گریم","چرا گریم؟ کز آن حاصل برون از نم نمی‌بینم","چشم من دیگر آبرویم را به خاطر گریه‌های مداوم از بین برده است؛ چرا باید گریه کنم وقتی که از آنچه به دست آورده‌ام، هیچ چیز باقی نمانده و نمی‌توانم چیزی را ببینم؟"],[426,"کنون دم درکش ای سعدی! که کار از دست بیرون شد","به امید دمی با دوست، وآن دم هم نمی‌بینم","ای سعدی، اکنون لب بدوز و خاموش باش، زیرا برای دمی با او بودن، اوضاع از کنترل خارج شده است و با این حال، حتی امیدی به آن لحظه هم ندارم. (AI: اکنون از خودت بیرون بیا و با دوستانت ارتباط برقرار کن، زیرا اوضاع از کنترل خارج شده است. با این حال، حتی امیدی به دیدار این دوستان ندارم.)"],[427,"من از این جا به ملامت نروم","که من این جا به امیدی گروم","من به هیچ عنوان از این مکان به خاطر سرزنش و ملامت نمی‌روم، زیرا من در اینجا با امید و آرزوی چیزی حضور دارم."],[427,"گر به عقلم سخنی می‌گویند","بیم آن است که دیوانه شوم","اگر به عقل من چیزی بگویند، نگرانم که دیوانه شده و عقل خود را از دست بدهم."],[427,"گوش دل رفته به آواز سماع","نتوانم که نصیحت شنوم","دل من متوجه آواز و موسیقی است و قادر نیست نصیحت را بشنود."],[427,"همه گو باد ببر خرمن عمر","دو جهان بی تو نیرزد دو جوم","بگذار باد همه حاصل عمرم را ببرد که دو جهان بدون تو، دو جو ارزش ندارد. (AI: همه می‌گویند که باد، خرمن عمر دو جهان بدون تو ارزشی ندارد.)"],[427,"دوستان عیب و ملامت مکنید","کآن چه خود کاشته باشم، دروم","دوستان مرا ملامت نکنید، زیرا آنچه از من می‌بینید، نتیجه‌ی کارهایی است که خود انجام داده‌ام. (AI: دوستان را ملامت نکنید، زیرا آنچه از من می‌بینید، نتیجه‌ی کارهایی است که خود انجام داده‌ام.)"],[427,"من بیچاره گردن به کمند","چه کنم گر به رکابش نروم؟","من که بیچاره و درمانده‌ام، اگر نتوانم به سمت محبوب بروم و خود را در دستان او بیندازم، چه کار می‌توانم بکنم؟"],[427,"سعدیا گفت «به خوابم بینی»","بی‌وفا یارم اگر می‌غنوم","ای سعدی، معشوق گفت: مرا به خواب ببینی؛ (پاسخ سعدی:) یار بی‌وفایی هستم اگر خوابم برد."],[428,"نه از چینم حکایت کن نه از روم","که من دل با یکی دارم در این بوم","برای من از چین و روم چیزی نگو، چون من تنها به یک نفر در این سرزمین دل بسته‌ام."],[428,"هر آن ساعت که با یاد من آید","فراموشم شود موجود و معدوم","هر زمانی که یاد او به ذهنم می‌آید، من موجود و غیرموجود را فراموش می‌کنم. (AI: هر زمانی که یاد من به ذهنش می‌آید، او دنیای موجود و غیرموجود را فراموش می‌کند.)"],[428,"ز دنیا بخش ما غم خوردن آمد","نشاید خوردن الا رزق مقسوم","از دنیا برای ما غم خوردن و ناراحت بودن مناسب نیست، زیرا باید فقط از روزی معینی که برای ما مقدر شده است بهره‌مند شویم و بیشتر از آن خود را ناراحت نکنیم."],[428,"رطب شیرین و دست از نخل کوتاه","زلال اندر میان و تشنه محروم","خرماهای شیرین و تازه از درخت نخل چیده شده، ولی من در این میان از آب زلال هم محروم و تشنه‌ام."],[428,"از آن شاهد که در اندیشه ماست","ندانم زاهدی در شهر معصوم","شاهدی که در دل ما فکر او را می‌کنیم، نمی‌دانم زاهدی (پارسا) در این شهر با شخصیت پاک و بی‌گناه وجود دارد یا نه."],[428,"به روی او نماند هیچ منظور","به بوی او نماند هیچ مشموم","هیچ زیبایی به زیبایی و حضور او نمی‌رسد و هیچ عطری به عطر و بوی او نیز نمی‌ماند. (AI: هیچ آرزویی از زیبایی و حضور او باقی نمانده و از عطر و بوی او نیز چیزی حس نمی‌شود.)"],[428,"نه بی‌او عیش می‌خواهم نه با او","که او در سلک من حیف است منظوم","من نه از زندگی با او لذت می‌برم و نه از زندگی بدون او، زیرا او در دسته من جایگاهی ندارد و وجودش برای من ناراحت‌کننده است."],[428,"رفیقان چشم ظاهربین بدوزید","که ما را در میان سرّیست مکتوم","دوستان، چشمان ظاهربین را ببندید! چون در دل ما یک راز نهفته است که کسی از آن خبر ندارد. (AI: دوستان ناچارند که به ظاهر ما توجه کنند، چون در دل ما یک راز نهفته است که کسی از آن خبر ندارد.)"],[428,"همه عالم گر این صورت ببینند","کس این معنی نخواهد کرد مفهوم","اگر تمام جهان نیز این ظاهر را ببینند، هیچ‌کس معنای واقعی این موضوع را درک نخواهد کرد."],[428,"چنان سوزم که خامانم نبینند","نداند تندرست احوال محموم","چنان می‌سوزم که افرادی که نادان و سردرگم‌اند نمی‌توانند این حال را درک کنند، و هیچ‌کس تندرست (سالم) از وضعیت کسی که در آتش عشق می‌سوزد آگاهی ندارد."],[428,"مرا گر دل دهی ور جان ستانی","عبادت لازم است و بنده ملزوم","اگر دل به من بدهی یا اگر جانم را بگیری، باید که این را بدانی که محبت و بندگی لازم و ملزوم یکدیگرند."],[428,"نشاید برد سعدی جان از این کار","مسافر تشنه و جلّاب مسموم","سعدی، از این واقعه جان به در نخواهی برد، تو چون مسافری تشنه هستی و (در مقابلت) گلاب مسموم."],[428,"چو آهن تاب آتش می‌نیارد","همی‌باید که پیشانی کند موم","چنین است که اگر آهن در برابر آتش نرم نمی‌شود، پس در این حالت باید پیشانی موم را به آتش نزدیک کرد تا ذوب شود. این به معنای این است که باید با شرایط سازگار شد و گاهی تغییر کرد تا به هدف رسید."],[429,"تو مپندار کز این در به ملامت بروم","دلم اینجاست بده تا به سلامت بروم","اشتباه مکن که فکر کنی من از این در به سرزنش می‌روم، دل من اینجاست، آن را به من پس بده که به سلامت بروم. (AI: مکن اشتباه که فکر کنی من از این در به سرزنش می‌روم، دل من اینجاست، پس به من اجازه بده که به سلامت بروم.)"],[429,"ترک سر گفتم از آن پیش که بنهادم پای","نه به زرق آمده‌ام تا به ملامت بروم","من از قبل تصمیم گرفته‌ام که از درد و رنج نروم، چون به اینجا آمده‌ام که با زرق و برق (به خاطر ظواهر) روبرو نشوم و مورد ملامت قرار نگیرم."],[429,"من هوادار قدیمم بدهم جان عزیز","نو ارادت نه که از پیش غرامت بروم","من از طرفداران قدیمی هستم و جانم را برای عشق می‌دهم. از آنهایی که تازه به تو ارادت یافته‌اند، نیستم که از بهای خسارت بگریزم. (AI: من از طرفداران قدیمی هستم و جانم را برای عشق جدیدم می‌دهم. این عشق که به من ارادت دارد، بر من واجب نیست که از قبل بهایی بپردازم.)"],[429,"گر رسد از تو به گوشم که بمیر ای سعدی","تا لب گور به اعزاز و کرامت بروم","اگر خبر از تو به گوش من برسد که (گفته‌ای): ای سعدی، بمیر! تا لب گور با احترام و بزرگی خواهم رفت. (AI: اگر خبر مرگ تو به من برسد، ای سعدی، تا لب گور با احترام و بزرگی خواهم رفت.)"],[429,"ور بدانم به در مرگ که حشرم با توست","از لحد رقص کنان تا به قیامت بروم","اگر مطمئن باشم که در روز قیامت با تو هستم، از قبر برخاسته و با شادی و رقص به سمت آن روز رفته و به دیدارت می‌آیم."],[430,"به تو مشغول و با تو همراهم","وز تو بخشایش تو می‌خواهم","من تمام فکر و حواسم به تو معطوف است و در کنار تو هستم و از تو می‌خواهم که مرا ببخشی."],[430,"همه بیگانگان چنین دانند","که منت آشنای درگاهم","همه غریبه‌ها می‌پندارند که من از آشنایان و نزدیکان درگاهت هستم. (AI: همه‌ی غریبه‌ها می‌دانند که من برای آشنا و نزدیکانم ارزشی ویژه قائل هستم.)"],[430,"ترسم ای میوه درخت بلند","که نیایی به دست کوتاهم","من از تو می‌ترسم ای میوه بالای درخت، که مبادا به دست من که اندک و کوتاه است نرسی."],[430,"تا مرا از تو آگهی دادند","به وجودت گر از خود آگاهم","وقتی به من خبر دادند که وجود تو را دارم، فهمیدم که حتی اگر از خودم هم باخبر باشم، در واقع آگاهی‌ام درباره تو مهم‌تر است."],[430,"همه در خورد رای و قیمت خویش","از تو خواهند و من تو را خواهم","همه کسانی که به دنبال یک رأی یا قیمتی هستند، به تو توجه خواهند کرد، اما من تنها تو را می‌خواهم و به چیز دیگری اهمیت نمی‌دهم."],[430,"بلبل بوستان حسن توام","چون نیفتد سخن در افواهم","من در باغ خوشبختی و زیبایی تو مانند بلبل نغمه‌خوان هستم، پس چگونه ممکن است سخنم دهان به دهان نگردد؟ (AI: من در باغ خوشبختی تو مانند بلبل هستم، اما چگونه می‌توانم سخن بگویم وقتی که در دل من چیزی برای بیان نیست؟)"],[430,"می‌کشندم که ترک عشق بگو","می‌زنندم که بیدق شاهم","مرا به خاطر عشق می‌کشند و برای ترک آن به من آسیب می‌زنند (همچون سربازی مقابل شاه در شطرنج)."],[430,"ور به صد پاره‌ام کنی زین رنگ","نه بگردم که صبغة اللهم","اگر مرا به هزار تکه هم بکنی، از عشق تو تغییر نخواهم کرد و وفاداری‌ام به رنگ عشق خداوند ادامه خواهد داشت."],[430,"سعدیا در قفای دوست مرو","چه کنم می‌برد به اکراهم","ای سعدی، در پی دوستی که می‌روی، چه کاری از دست من برمی‌آید؟ او به زور مرا به دنبال خود می‌کشد."],[430,"میل از این جانب اختیاری نیست","کهربا را بگو که من کاهم","من نمی‌توانم اراده‌ام را در این زمینه به کار ببرم، اما می‌توانم به کهربا بگویم که من کاه هستم. / کهربا: کوتاه شده کاه‌ربا، اسم مرکب، رباینده کاه، صمغ درختی است که چون مالیده شود کاه را جذب کند و در این خاصیت با سندروس مشترک است، بیجاده (لغت‌نامه) / (AI: من نمی‌توانم اراده‌ام را در این زمینه به کار ببرم، اما می‌توانم به کهربا بگویم که من در کارش هستم.)"],[431,"امشب آن نیست که در خواب رود چشم ندیم","خواب در روضه رضوان نکند اهل نعیم","امشب شب آرامی نیست که چشم دوست به خواب برود؛ زیرا اهل بهشت (نعیم) در باغ بهشت (روضه رضوان) نمی‌خوابند."],[431,"خاک را زنده کند تربیت باد بهار","سنگ باشد که دلش زنده نگردد به نسیم","تربیت بهاری می‌تواند خاک را زنده کند، اما اگر دل کسی سنگ باشد، حتی با نسیم بهاری هم زنده نخواهد شد."],[431,"بوی پیراهن گم‌کرده خود می‌شنوم","گر بگویم همه گویند ضلالی‌ست قدیم","بوی پیراهنی که گم کرده‌ام را حس می‌کنم، اما اگر بگویم این را، همه می‌گویند این حرفی بی‌پایه و اشتباه است و من به راهی گمراه رفته‌ام."],[431,"عاشق آن گوش ندارد که نصیحت شنود","درد ما نیک نباشد به مداوا‌ی حکیم","عشق باعث می‌شود که عاشق به نصیحت‌ها گوش ندهد و به درد خود توجهی نکند، زیرا درد او به هیچ دارویی از سوی پزشک (حکیم) بهبود نمی‌یابد."],[431,"توبه گویندم از اندیشه معشوق بکن","هرگز این توبه نباشد که گناهی‌ست عظیم","من می‌گویم که از فکر معشوق توبه کنم، اما این توبه هیچ‌گاه نمی‌تواند باشد، چون عشق به معشوق، گناهی بزرگ به حساب می‌آید."],[431,"ای رفیقان سفر دست بدارید از ما","که بخواهیم نشستن به در دوست مقیم","ای دوستان، از ما دل بکنید و دست بردارید، زیرا ما تصمیم داریم که برای همیشه در کنار دوست بمانیم."],[431,"ای برادر غم عشق آتش نمرود انگار","بر من این شعله چنان است که بر ابراهیم","ای برادر، غم عشق برای من مانند آتش نمرود است و این شعله عشق بر من همچون شعله آتش نمرود بر ابراهیم. (که به فرمان خداوند شعله آتش نمرود بر ابراهیم (ع) گلستان شد) / (AI: ای برادر، غم عشق برای من مانند آتش نمرود است، این شعله بر من به شدت می‌سوزد، همان‌طور که ابراهیم را می‌سوزاند.)"],[431,"مرده از خاک لحد رقص کنان برخیزد","گر تو بالای عظامش گذری وهی رمیم","اگر تو بر بالای قبر مرده‌ای بگذری، او از خاک قبرش با شادی و شوق بلند خواهد شد. این نشان‌دهنده شوق و عشق شدید او به توست."],[431,"طمع وصل تو می‌دارم و اندیشه هجر","دیگر از هر چه جهانم نه امید است و نه بیم","من امیدوارم که به وصال تو برسم و دیگر هیچ فکر جدایی در سر ندارم؛ از هر چیزی در جهان هم نه انتظاری دارم و نه ترسی."],[431,"عجب از کشته نباشد به در خیمه دوست","عجب از زنده که چون جان به درآورد سلیم","تعجب‌آور است که کسی که در مقابل خیمه دوست کشته نشده، باید تعجب‌آورتر باشد که زنده‌ای چون سلیم (شخصیتی که به سلامت و پاکی معروف است) که جانش را از دست می‌دهد."],[431,"سعدیا عشق نیامیزد و شهوت با هم","پیش تسبیح ملایک نرود دیو رجیم","سعدی می‌گوید عشق و شهوت نمی‌توانند با یکدیگر آمیخته شوند؛ زیرا کسانی که به عشق حقیقی رسیده‌اند، در مقام بندگی خداوند و در حضور فرشتگان قرار دارند، و دیوانگان و شیطانیان به آنجا راه ندارند."],[432,"ما دگر کس نگرفتیم به جای تو ندیم","الله الله تو فراموش مکن عهد قدیم","ما هیچ کسی را به جای تو نمی‌پذیریم و در غیبت تو، خدا خدا می‌کنیم. تو را فراموش نکن و به یاد داشته باش که ما به عهد و پیمان قدیم وفاداریم."],[432,"هر یک از دایره جمع به راهی رفتند","ما بماندیم و خیال تو به یک جای مقیم","هر یک از دوستان و گروهی که با هم بودیم، به راه و مسیر خود رفتند، اما ما هنوز در یک جا ماندیم و تنها به یاد تو فکر می‌کنیم."],[432,"باغبان گر نگشاید در درویش به باغ","آخر از باغ بیاید بر درویش نسیم","اگر باغبان در را به روی درویش ن-openingد (درویش کسی است که به تنگ‌دستی و سادگی زندگی می‌کند) تا او بتواند وارد باغ شود، در نهایت هم از باغ، فقط نسیمی به سوی درویش خواهد آمد و او از زیبایی باغ بی‌نصیب خواهد ماند."],[432,"گر نسیم سحر از خلق تو بویی آرد","جان فشانیم به سوغات نسیم تو نه سیم","اگر نسیم صبحگاهی از جانب تو عطر و بویی بیاورد، ما جان‌مان را برای محبت تو فدای نسیم تو می‌کنیم، نه برای چیزی از جمله نقره."],[432,"بوی محبوب که بر خاک احبا گذرد","نه عجب دارم اگر زنده کند عظم رمیم","اگر عطر محبوب بر خاکی که متعلق به دوستانش است بگذرد، تعجبی ندارد که آن خاک زندگیشان را دوباره زنده کند، حتی اگر در زندگی گذشته‌شان ناچیز و بی‌ارزش بوده باشند."],[432,"ای به حسن تو صنم چشم فلک نادیده","وی به مثل تو ولد مادر ایام عقیم","ای زیبایی تو که مانند تمثال چهره‌ات، چشم آسمان هم نتوانسته تو را ببیند، تو را در دوران بی‌فرزندی متولد شده می‌دانم."],[432,"حال درویش چنان است که خال تو سیاه","جسم دل‌ریش چنان است که چشم تو سقیم","حالت درویش (فقیر) به گونه‌ای است که خالی سیاه بر گونه‌ات وجود دارد و جسم دل‌شکسته‌ام آن‌قدر آزرده است که چشمان تو بیمار به نظر می‌رسند."],[432,"چشم جادوی تو بی‌واسطه کحل کحیل","طاق ابروی تو بی‌شائبه وسمه وسیم","چشم زیبای تو طوری تأثیرگذار است که نیازی به سرمه ندارد و ابروی تو آنقدر دلرباست که نیازی به زینت ندارد."],[432,"ای که دلداری اگر جان منت می‌باید","چاره‌ای نیست در این مسأله الا تسلیم","ای کسی که دلدار منی، اگر برای به دست آوردن جان من نیاز به منت و خواسته‌ای داری، چاره‌ای نیست جز اینکه در این موضوع تسلیم باشم و راضی شوم."],[432,"عشقبازی نه طریق حکما بود ولی","چشم بیمار تو دل می‌برد از دست حکیم","عشق‌ورزی راه و رسم دانایان نیست، اما زیبایی چشمان تو باعث می‌شود که دل حکیمان را نیز به چنگ آورد."],[432,"سعدیا عشق نیامیزد و عفت با هم","چند پنهان کنی آواز دهل زیر گلیم","ای سعدی، عشق و عفت هرگز با هم نمی‌سازند. هرچقدر هم که بخواهی عشق را پنهان کنی، صدای دهل (که به معنای نشانه‌ای از عیش و شادی است) از زیر فرش (گلیم) بیرون می‌آید و آشکار می‌شود."],[433,"ما به روی دوستان از بوستان آسوده‌ایم","گر بهار آید وگر باد خزان آسوده‌ایم","ما از دیدن دوستان در باغ خوشحال و آرامیم، فرقی نمی‌کند که فصل بهار بیاید یا باد خزان بوزد؛ در هر حال ما راحت و آسوده‌ایم."],[433,"سروبالایی که مقصود است اگر حاصل شود","سرو اگر هرگز نباشد در جهان آسوده‌ایم","اگر یار سروقامتی که داریم به دست آید، حتی اگر دیگر درخت سرو هرگز در دنیا نباشد، ما آرام و آسوده خواهیم بود. (AI: اگر هدفی که داریم به دست آید، حتی اگر آن موجود نازنین هرگز در دنیا نباشد، ما آرام و آسوده خواهیم بود.)"],[433,"گر به صحرا دیگران از بهر عشرت می‌روند","ما به خلوت با تو ای آرام جان آسوده‌ایم","اگر دیگران برای خوش‌گذرانی به دشت و بیابان می‌روند، ما در کنار تو، که مایه آرامش جان ما هستی، در خلوت خود راحت و آسوده‌ایم."],[433,"هر چه در دنیا و عقبی راحت و آسایش است","گر تو با ما خوش درآیی ما از آن آسوده‌ایم","هر چیزی که در این دنیا و دنیای آخرت، راحتی و آسایش به حساب می‌آید، اگر تو با ما باشی و خوش بگذرانیم، ما از هر کدام از آن‌ها راحت و بی‌نیاز خواهیم بود."],[433,"برق نوروزی گر آتش می‌زند در شاخسار","ور گل افشان می‌کند در بوستان آسوده‌ایم","اگر نوروز، جلوه‌ای روشن و زیبا دارد و باعث شعله‌ور شدن آتش در درختان می‌شود یا اگر گل‌ها را در بوستان می‌پراکند، ما به خاطر زیبایی‌های این روز خوشحال و آرام هستیم."],[433,"باغبان را گو اگر در گلستان آلاله‌ایست","دیگری را ده که ما با دلستان آسوده‌ایم","به باغبان بگو اگر در باغ گل‌ رنگی (آلاله) وجود دارد، گل را به دیگری بده که ما با دلبر، دل‌شاد و آرام هستیم. (AI: به باغبان بگو اگر در باغ گل‌های رنگی وجود دارد، گل دیگری را به ما بده که ما با دل شاد و آرام هستیم.)"],[433,"گر سیاست می‌کند سلطان و قاضی حاکمند","ور ملامت می‌کند پیر و جوان آسوده‌ایم","اگر سلطان و قاضی به امور سیاسی رسیدگی می‌کنند و پیران و جوانان ما را سرزنش می‌کنند، ما با خیال راحت و آسودگی زندگی می‌کنیم."],[433,"موج اگر کشتی برآرد تا به اوج آفتاب","یا به قعر اندر برد ما بر کران آسوده‌ایم","اگر موج دریا کشتی را به اوج آفتاب بالا ببرد یا به عمق دریا ببرد، ما در ساحل آرام و آسوده هستیم."],[433,"رنج‌ها بردیم و آسایش نبود اندر جهان","ترک آسایش گرفتیم این زمان آسوده‌ایم","ما در طول زندگی سختی‌های زیادی را تحمل کردیم و در دنیا هیچ راحتی نیافتیم. اکنون که از زندگی توأم با آسایش فاصله گرفته‌ایم، در آرامش به سر می‌بریم. (AI: ما در طول زندگی سختی‌های زیادی را تحمل کردیم و در دنیا هیچ راحتی نیافتیم. اکنون که از زندگی پرمشقت فاصله گرفته‌ایم، در آرامش به سر می‌بریم.)"],[433,"سعدیا سرمایه‌داران از خلل ترسند و ما","گر بر آید بانگ دزد از کاروان آسوده‌ایم","سعدی می‌گوید سرمایه‌داران از خرابکاری و دزدی می‌ترسند، اما ما که در زندگی مشکلات زیادی را تحمل کرده‌ایم، اگر صدای دزدی از کاروانی به گوش برسد، نگران نیستیم و احساس آرامش می‌کنیم."],[434,"ما در خلوت به روی خلق ببستیم","از همه بازآمدیم و با تو نشستیم","ما در تنهایی خودمان، در برابر مردم خود را پنهان کردیم و از هر چیز دیگری دور شدیم تا با تو، ای دوست، بنشینیم و وقت بگذرانیم."],[434,"هر چه نه پیوند یار بود بریدیم","وآنچه نه پیمان دوست بود شکستیم","هر چیزی که به عشق و دوستی مربوط نبود را رها کردیم و هر آنچه که با وفاداری و امانت در دوستی نبود را شکسته و کنار گذاشتیم."],[434,"مردم هشیار از این معامله دورند","شاید اگر عیب ما کنند که مستیم","مردم هوشیار از این کار دور هستند، شاید آن‌ها ما را به خاطر این که در وضعیتی شبیه به مستی هستیم، عیب‌جویی کنند."],[434,"مالک خود را همیشه غصه گدازد","ملک پری‌پیکری شدیم و برستیم","مالک خود همیشه ناراحت است، ما به یک موجود زیبا و لطیف تسلیم شدیم و به او نزدیک شدیم و از غصه رهایی یافتیم. / مالک خود: کسی که مالک خودش است و بنده کسی نیست. / (AI: مالک همیشه ناراحت است و ما به یک موجود زیبا و لطیف تبدیل شدیم و به او نزدیک شدیم.)"],[434,"شاکر نعمت به هر طریق که بودیم","داعی دولت به هر مقام که هستیم","ما به هر روشی که ممکن بود، شکر نعمت‌های خدا را به جا آوردیم و به هر سطحی که قرار داریم، خواهان نعمت‌های زندگی هستیم."],[434,"در همه چشمی عزیز و نزد تو خواریم","در همه عالم بلند و پیش تو پستیم","در نظر همه مردم ما عزیز و محترم هستیم، اما در مقابل تو (ای معشوق) خوار و ناچیز به نظر می‌رسیم؛ در کل جهان مقام و منزلت داریم، ولی در حضور تو بی‌ارزش و کوچک هستیم."],[434,"ای بت صاحب‌دلان مشاهده بنمای","تا تو ببینیم و خویشتن نپرستیم","ای عشق زیبا و محبوب دل‌باختگان، به ما نظر کن تا تو را ببینیم و تنها به خودمان نپردازیم."],[434,"دیده نگه داشتیم تا نرود دل","با همه عیاری از کمند نجستیم","ما چشم‌انتظار بودیم تا دل از دست نرود و با وجود تمام زیرکی، از دام عشق فرار نکردیم."],[434,"تا تو اجازت دهی که در قدمم ریز","جان گرامی نهاده بر کف دستیم","تا زمانی که تو اجازه بدهی، جان عزیز خود را بر دستانم می‌گذارم (تا آن را نثار مقدمت کنم)."],[434,"دوستی آن است سعدیا که بماند","عهد وفا هم بر این قرار که بستیم","دوستی واقعی این است، سعدی، که پیمان وفا پا بر جا بماند، همان‌گونه که ما تاکنون توافق کرده‌ایم."],[435,"ای سروبالای سهی، کز صورت حال آگهی","وز هر که در عالم بهی، ما نیز هم بد نیستیم","ای سرو زیبای بلند (که نماد زیبایی است) که از حال ما آگاهی، و از هر کسی در این دنیا زیباتر به نظر می‌رسیم، ما هم در جذابیت و زیبایی کم نیستیم."],[435,"گفتی «به رنگ من گلی، هرگز نبیند بلبلی»","آری نکو گفتی ولی، ما نیز هم بد نیستیم","تو گفتی که رنگی چون من، هیچ گلی را خوش نمی‌بیند. راست می‌گویی، اما ما هم زیبا هستیم و زیبایی داریم."],[435,"تا چند گویی «ما و بس»؟ کوته کن ای رعنا و بس","نه خود تویی زیبا و بس، ما نیز هم بد نیستیم","چرا همواره می‌گویی «فقط من زیبا هستم»؟ ای زیبای دل‌ربا، سخن را کوتاه کن. تو تنها زیبا نیستی، ما نیز در این زیبایی کم نیستیم."],[435,"ای شاهد هر مجلسی! وآرام جان هر کسی!","گر دوستان داری بسی، ما نیز هم بد نیستیم","ای معشوقه هر گردهمایی و آرامش‌بخش جان هر کس! اگر دوستان زیادی داری، ما نیز آشکارا کم نیستیم."],[435,"گفتی که «چون من در زمی، دیگر نباشد آدمی»","ای جان لطف و مردمی! ما نیز هم بد نیستیم","تو گفتی که وقتی من در زمین هستم، دیگر هیچ انسانی وجود ندارد. ای جان و مهربانی! اما ما هم انسان‌های خوبی هستیم و بی‌احترام نیستیم."],[435,"گر گلشن خوش‌بو تویی، ور بلبل خوش‌گو تویی","ور در جهان نیکو تویی، ما نیز هم بد نیستیم","اگر تو باغی خوشبو باشی، یا اگر تو بلبل زیبا و دلنشینی باشی، یا اگر در این دنیا انسان خوبی باشی، ما هم از خودمان بد نیستیم و قابلیت داریم."],[435,"گویی «چه شد کآن سروبن، با ما نمی‌گوید سخن؟»","گو «بی‌وفایی پر مکن»، ما نیز هم بد نیستیم","به نظر می‌رسد که گل‌عذاری که از او سخن می‌گوییم، چرا با ما سخن نمی‌گوید؟ بگو که بی‌وفایی نکن، زیرا ما هم آدم‌های خوبی هستیم و لیاقت توجه را داریم."],[435,"گر تو به حسن افسانه‌ای، یا گوهر یک دانه‌ای","از ما چرا بیگانه‌ای؟ ما نیز هم بد نیستیم","اگر تو خود زیبایی افسانه‌ای و یا گوهری بی‌نظیری، پس چرا از ما دوری؟ ما نیز موجوداتی خوب و ارزشمند هستیم."],[435,"ای در دل ما داغ تو! تا کی فریب و لاغ تو؟","گر به بود در باغ تو، ما نیز هم بد نیستیم","ای عشق تو در دل ما باقی مانده، تا کی باید فریب و دروغ تو را تحمل کنیم؟ اگر در باغ تو نیکی و زیبایی وجود دارد، ما نیز شایسته خوبی‌ها هستیم."],[435,"باری غرور از سر بنه، وانصاف درد من بده","ای باغ شفتالو و به! ما نیز هم بد نیستیم","به خاطر غرور و خودخواهی‌ات از خودت کم کن و کمی انصاف به من بده. ای باغ شفتالو، ما هم انسان‌های خوبی هستیم و دردی نداریم که نادیده‌گرفته شویم."],[435,"گفتم «تو ما را دیده‌ای، وز حال ما پرسیده‌ای»","پس چون ز ما رنجیده‌ای، ما نیز هم بد نیستیم","من به تو گفتم که تو ما را دیده‌ای و از حال ما سوال کرده‌ای، پس اگر از ما ناراحت هستی، باید بگویم که ما نیز در شرایط خوبی نیستیم."],[435,"گفتی «به از من در چگل، صورت نبندد آب و گل»","ای سست‌مهر سخت‌دل! ما نیز هم بد نیستیم","تو گفتی: من از نظر ظاهری بهتر از زیبارویان شهر چگل هستم و از گل و آب، بهتر از من نمی‌توان نقشی زد؛ اما ای دل‌سخت و بی‌محبت، ما هم بد نیستیم. (AI: تو گفتی که من از نظر ظاهری بهتر از گل و آب هستم، اما آیا دل سخت و بی‌محبت من نیز چیزی کم دارد؟)"],[435,"سعدی گر آن زیباقرین، بگزید بر ما هم‌نشین","گو «هر که خواهی برگزین»، ما نیز هم بد نیستیم","ای سعدی، اگر آن زیبای خوش‌سیرت، دیگری را انتخاب کرد و با او نشست، بگو: هر کسی که خواستی انتخاب کن، ما هم انسان‌های بدی نیستیم. (AI: ای سعدی، اگر آن زیبای خوش‌سیرت را انتخاب کردی و با ما نشست، به هر کسی که خواستی بی‌زحمت انتخاب کن، ما هم انسان‌های بدی نیستیم.)"],[436,"عمرها در پی مقصود به جان گردیدیم","دوست در خانه و ما گرد جهان گردیدیم","ما عمرها به دنبال هدف خود، همه جا را گشته‌ایم، در حالی که دوست (محبوب) در خانه است و ما بی‌خبر از او در جهان می‌گردیم."],[436,"خود سراپرده قدرش ز مکان بیرون بود","آن که ما در طلبش جمله مکان گردیدیم","خود آن شخص که ارزش و مقامش از هر مکانی بالاتر است، ما برای یافتن او در همه جا و تمامی مکان‌ها گشتیم."],[436,"همچو بلبل همه شب نعره زنان تا خورشید","روی بنمود، چو خفاش نهان گردیدیم","مانند بلبل، تمام شب با صدای بلند نواختیم تا اینکه خورشید ظاهر شد، اما مانند خفاش، پنهان شدیم."],[436,"گفته بودیم به خوبان که نباید نگریست","دل ببردند و ضرورت نگران گردیدیم","به زیبا رویان گفته بودیم که نباید به آن‌ها نگاه کنیم، اما آن‌ها دل ما را بردند و ما ناچار شدیم نگران شویم."],[436,"صفت یوسف نادیده بیان می‌کردند","با میان آمد و بی نام و نشان گردیدیم","به زیبایی و ویژگی‌های یوسف (که نمادی از زیبایی است) می‌پرداختند، اما وقتی خودمان او را ندیدیم، به حتم عشق و محبت او ما را گم کرد و بی‌خبر از هویت خود شدیم."],[436,"رفته بودیم به خلوت که دگر می نخوریم","ساقیا باده بده کز سر آن گردیدیم","ما به دور از چشم مردم و در خلوت رفته بودیم تا دیگر شراب نخوریم، اما ساقی، باده‌ای به ما بده که بر اثر آن دوباره به حال شادابی و جوانی برگشته‌ایم."],[436,"تا همه شهر بیایند و ببینند که ما","پیر بودیم و دگرباره جوان گردیدیم","می‌خواهیم همه مردم به شهر بیایند و ببینند که ما در حالت پیری بودیم، اما دوباره به جوانی برگشتیم و سرزنده شده‌ایم."],[436,"سعدیا لشکر خوبان به شکار دل ما","گو میایید که ما صید فلان گردیدیم","ای سعدی، گروهی از زیبا رویان به دنبال دل ما می‌آیند تا آن را شکار کنند، زیرا ما به دلیل محبت آن‌ها دلبسته و عاشق شده‌ایم."],[437,"بگذار تا مقابل روی تو بگذریم","دزدیده در شمایل خوب تو بنگریم","اجازه بده تا از برابر چهره‌­ی تو عبور کنیم و پنهانی در صورت زیبای تو نگاه کنیم"],[437,"شوق است در جدایی و جور است در نظر","هم جور به که طاقت شوقت نیاوریم","در هنگام جدایی و فراق، شور و شوق رسیدن به یار وجود دارد و در هنگام دیدار، ستم هجران و دیدار در پیش است؛ با این همه تحمل جور آسان­‌تر است، چرا که تاب و توان تحمل شوق تو را نداریم(نکته: سعدی هر چند بیان می­کند که در هنگام جدایی، شور و شوق رسیدن وجود دارد و در هنگام وصال، ترس جدایی، و آدم به طور معمول میان دو راهی شوق و جور، شوق را برمی‌­گزیند، اما در این بیت رندانه جور را انتخاب می‌­کند تا همچنان از وصال بهره‌­مند باشد و دلیلی که ذکر می‌­کند نیز بسیار زیباست چرا که بیان می­‌کند از آنجا که تاب و توان تحمل شوق تو را نداریم پس همین جور را انتخاب می­‌کنیم)"],[437,"روی ار به روی ما نکنی، حکم از آن توست","بازآ که روی در قدمانت بگستریم","اگر نگاهی به ما نمی­‌کنی و چهره‌­ات را از ما برمی‌­گردانی، فرمان و حکم در اختیار توست، (اما) بازگرد و ببین که چگونه چهره­‌ی خود را همچون فرشی در زیر قدم‌هایت پهن می‌­کنیم(نکته: سعدی به طور ضمنی چهره­‌ی خود را به فرش تشبیه کرده است)"],[437,"ما را سری‌ست با تو که گر خلق روزگار","دشمن شوند و سر برود هم بر آن سریم","ما با تو کاری داریم که هر چند اگر تمام مردم روزگار دشمن ما شوند و در این دشمنی سر خود را از دست دهیم باز بر همان نیت و قصد خود خواهیم ماند"],[437,"گفتی: «ز خاک بیشترند اهل عشق من»","از خاک بیشتر نه، که از خاک کمتریم","گفتی که (تعداد) عاشقان من از ذرات خاک بیشتر هستند، (اختیار دارید، لطف می­کنید)(ارزش) ما از خاک بیشتر نه که از خاک کمتر است(تجاهل العارف: در این بیت سعدی دانسته خود را به نادانی می‌­زند چرا که؛ معشوق در مقام نازیدن به خود می­‌گوید که جمعیت و تعداد عاشقان و مشتاقان من از (ذرات) خاک بیشتر است، اما شاعر از سر طنز و رندی خود را به ندانستن می‌­زند و می‌­گوید: اختیار دارید! ارزش ما از خاک کمتر است)"],[437,"ما با توایم و با تو نه‌ایم، اینت بلعجب","در حلقه‌ایم با تو و چون حلقه بر دریم","ما با تو هستیم، اما در حقیقت با تو نیستیم؛ چه وضعیت عجیب و شگفت‌آوری! در جمع و حلقه نزدیکان تو حضور داریم، اما مانند حلقه‌ای که بر در خانه آویزان است، از ورود و رسیدن به تو محرومیم. سعدی از یک تناقض دردناک در عشق سخن می‌گوید: «چون حلقه بر دریم» تصویر بسیار زیبایی است؛ حلقه در همیشه به خانه متصل است، اما هرگز وارد خانه نمی‌شود. عاشق هم درست همین وضعیت را دارد؛ به معشوق تعلق دارد، اما به وصال و صمیمیت واقعی با او نمی‌رسد."],[437,"نه بوی مهر می‌شنویم از تو ای عجب","نه روی آن که مهر دگر کس بپروریم","هر چند هیچ‌گونه نشانه­‌ای از مهر و محبت از جانب تو مشاهده نکرده‌­ایم اما جای تعجب است که به خود نیز اجازه نمی­‌دهیم سراغ عشق و مهر کس دیگری برویم(بوی مهر: کمترین نشانه­‌ای از مهر و محبت)"],[437,"از دشمنان برند شکایت به دوستان","چون دوست دشمن است شکایت کجا بریم؟","به طور معمول، مردم، شکایت از دشمنان را به پیش دوستان خود می­‌برند؛ اگر کسی معشوق و دوستش، دشمنش باشد، نزد چه کسی شکایت کند؟"],[437,"ما خود نمی‌رویم دوان در قفای کس","آن می‌برد که ما به کمند وی اندریم","ما از سر اختیار ، دوان دوان ، به دنبال کسی نمی رویم در واقع آن کسی ما را چنان با شتاب پیش میبرد که اسیر عشق او هستیم و در دام عشق او گرفتار آمده ایم"],[437,"سعدی تو کیستی؟ که در این حلقه کمند","چندان فتاده‌اند که ما صید لاغریم","سعدی! تو در میان جمعیت عاشقان او چندان اعتبار و اهمیتی نداری؛ چرا که در دام عشق او چنان عاشقانی گرانقدری وجود دارند که تو در برابر آنان همچون صیدی لاغر و بی‌­ارزش جلوه می­کنی"],[438,"ما دل دوستان به جان بخریم","ور جهان دشمن است غم نخوریم","ما دل‌های دوستان را به بهای جان خود می‌خریم، و اگر جهان با ما دشمنی کند، نگران نخواهیم بود."],[438,"گر به شمشیر می‌زند معشوق","گو بزن جان من که ما سپریم","اگر معشوق با شمشیر به ما حمله کند، بزن جان مرا، زیرا ما (دوستانش) مقابل این حملات ایستادگی می‌کنیم."],[438,"آن که صبر از جمال او نبود","به ضرورت جفای او ببریم","اگر کسی صبر به خاطر زیبایی او نداشته باشد، ناگزیر باید سختی و بی‌محبتی او را تحمل کند."],[438,"گر به خشم است و گر به عین رضا","نگهی باز کن که منتظریم","اگر او با خشم به ما نگاه کند یا با نظر رضایت، فقط کافی است یک بار نگاهی به ما بیاندازد، زیرا ما در انتظار آن لحظه هستیم."],[438,"یک نظر بر جمال طلعت دوست","گر به جان می‌دهند تا بخریم","یک نگاه به زیبایی چهره دوست کافی است که جان خود را فدای او کنیم تا بتوانیم او را به دست آوریم."],[438,"گر تو گویی خلاف عقل است این","عاقلان دیگرند و ما دگریم","اگر تو بگویی که این کار برخلاف عقل است، باید بگویم که دیگران عاقلان واقعی هستند و ما به نوعی دیگر از آدم‌ها تعلق داریم."],[438,"باش تا خون ما همی ریزد","ما در آن دست و قبضه می‌نگریم","تا زمانی که خون ما ریخته می‌شود، ما به دست و قبضه (تپانچه) نگاه می‌کنیم."],[438,"گر برانند و گر ببخشایند","ما بر این در گدای یک نظریم","اگر ما را برانند یا ببخشند، ما همچنان در این درگاه بینوا منتظر یک نگاه از آن دوست هستیم."],[438,"دوست چندان که می‌کشد ما را","ما به فضل خدای زنده‌تریم","با وجود اینکه دوست (عاشق یا معشوق) ما را به شدت آزار می‌دهد و به نوعی می‌کشد، اما ما به لطف خدا زنده‌تر از قبل هستیم و همچنان به زندگی ادامه می‌دهیم."],[438,"سعدیا زهر قاتل از دستش","گو بیاور که چون شکر بخوریم","سعدی از شخصی می‌خواهد که زهر کشنده‌ای که به او داده را بیاورد، زیرا او می‌خواهد آن را مانند شکر بخورد و از آن لذت ببرد."],[438,"ای نسیم صبا ز روضه انس","برگذر پیش از آن که درگذریم","ای نسیم خوشبو، از باغ دوستی بگذر و به ما نزدیک شو قبل از آنکه فرصت از دست برود و ما از این دنیا برویم."],[438,"تو خداوندگار باکرمی","گر چه ما بندگان بی‌هنریم","تو ای خداوندگار باکرامت و بی‌نظیر، هر چند ما بندگان تو از هنر و فضیلت بی‌بهره‌ایم."],[439,"ما گدایان خیل سلطانیم","شهربند هوای جانانیم","ما در پیشگاه دوست همچون گدایانی هستیم که در گذرگاه خیل سلطان به امید بخششی به گدایی ایستاده‌اند و چون زندانیانی هستیم که در عشق او زندانی شده‌ایم"],[439,"بنده را نام خویشتن نبود","هر چه ما را لقب دهند آنیم","عاشقان دوست را نام و نشانی نیست در این درگاه و هر چه آنها در این درگاه خطاب شوند خوانده میشوند"],[439,"گر برانند و گر ببخشایند","ره به جای دگر نمی‌دانیم","چه به درگاه دوست راه بیابیم و چه نیابیم و طرد بشویم جای دگر و راه دیگری را نمی‌شناسیم"],[439,"چون دلارام می‌زند شمشیر","سر ببازیم و رخ نگردانیم","اگر دوست به هوای جان ما هم به پا خیزد و قصد خون ما را کند اطاعت میکنیم و سر پیچی نخواهیم کرد"],[439,"دوستان در هوای صحبت یار","زر فشانند و ما سر افشانیم","عشاق به خاطر فیض بردن از محضر دوست از ارزش های دنیایی خود خرج می‌کنند ولی ما از جان خود"],[439,"مر خداوند عقل و دانش را","عیب ما گو مکن که نادانیم","به عاقلان و صاحبان خرد بگو که ما را به اتهام نادانی سرزنش نکنند (زیرا آنان از حال و فعل ما بی خبرند)"],[439,"هر گلی نو که در جهان آید","ما به عشقش هزار دستانیم","هر گلی که به دنیا بیاید، ما به خاطر عشق به آن مثل بلبل هزاران دستان هستیم"],[439,"تنگ‌چشمان نظر به میوه کنند","ما تماشاکنان بستانیم","کوتاه نظر ها و انسان های بی معرفت تنها میوه را می‌بینند ولیکن ما بستر فراهم آمدن آن را میبینیم ( اشاره به نگاه با معرفت و بی معرفت )"],[439,"تو به سیمای شخص می‌نگری","ما در آثار صنع حیرانیم","تو به صورت و وجهه مادی و فنا پذیر هر چیز توجه داری اما ما به قدرت خالق و ظرافت ها در کار او توجه داریم"],[439,"هر چه گفتیم جز حکایت دوست","در همه عمر از آن پشیمانیم","ما از هرآنچه بجز ذکر دوست در تمام عمر بر زبان راندیم نادم و پشیمانیم"],[439,"سعدیا بی‌وجود صحبت یار","همه عالم به هیچ نستانیم","اگر همه دنیا را داشته باشم اما نتوانم با دوست همنشین باشم هیچ ارزشی ندارد"],[439,"ترک جان عزیز بتوان گفت","ترک یار عزیز نتوانیم","می‌توانیم جان عزیز خود را ترک کنیم، اما هرگز نمی‌توانیم از یار عزیز خود دور باشیم."],[440,"کاش کان دل‌بر عیار که من کشته اویم","بار دیگر بگذشتی که کند زنده به بویم","ای کاش آن دلبر زیبا که من به خاطر او جان باخته‌ام، دوباره از کنارم عبور کند تا من بار دیگر زنده شوم و بوی او را استشمام کنم."],[440,"ترک من گفت و به ترکش نتوانم که بگویم","چه کنم نیست دلی چون دل او ز آهن و رویم","ترک من (دوست یا معشوق) از من جدا شده و نمی‌توانم بگویم که چه باید بکنم. دل هیچ‌کس به سختی دل او نیست و رویم (چهره‌ام) با وجود این فراق غمگین است."],[440,"تا قدم باشدم اندر قدمش افتم و خیزم","تا نفس ماندم اندر عقبش پرسم و پویم","هر زمان که قدم بردارم، پشت سر او می‌روم و حرکت می‌کنم، تا جایی که نفس دارم از او می‌پرسم و او را دنبال می‌کنم."],[440,"دشمن خویشتنم هر نفس از دوستی او","تا چه دید از من مسکین که ملول است ز خویم","من دشمن خودم هستم، هر لحظه به خاطر دوستی او، زیرا او از من بیچاره چه دیده که از رفتار من خسته شده است."],[440,"لب او بر لب من این چه خیال است و تمنا","مگر آن گه که کند کوزه‌گر از خاک سبویم","این بیت بیان می‌کند که لب آن معشوق بر لب من چه معنایی دارد و آیا فقط در خیال و آرزوست، مگر آنکه کوزه‌گر (هنرمند) از خاک، سبویی بسازد که نشان‌دهنده عشق و وصال باشد. به عبارتی، او به داشته‌های ملموس و واقعی در عشق اشاره می‌کند."],[440,"همه بر من چه زنی زخم فراق ای مه خوبان؟","نه منم تنها کاندر خم چوگان تو گویم","ای ماه خوبان، همه بر من دلیل جدایی و زخم دل می‌زنند و مرا سرزنش می‌کنند. من تنها کسی نیستم که در این بازی عشق آسیب دیده‌ام، بلکه در حماسه‌ی عشق تو، من نیز مانند یک مهره در بازی چوگان هستم."],[440,"هر کجا صاحب حسنی‌ست ثنا گفتم و وصفش","تو چنان صاحب حسنی که ندانم که چه گویم","هر جا که زیبایی هست، من از او تعریف و توصیف کرده‌ام؛ اما تو چنان زیبا هستی که نمی‌دانم چه چیزی درباره‌ات بگویم."],[440,"دوش می‌گفت که سعدی غم ما هیچ ندارد","می‌نداند که گرم سر برود دست نشویم","دیشب کسی می‌گفت که سعدی به غم ما هیچ توجهی ندارد، اما او نمی‌داند که ما چقدر از درد و رنج درون خود رنج می‌بریم."],[441,"عهد کردیم که بی‌دوست به صحرا نرویم","بی‌تماشاگه رویش، به تماشا نرویم","ما تصمیم گرفته‌ایم که بدون دوست به صحرا نرویم و بدون دیدن چهره‌اش، به تماشا نرویم."],[441,"بوستان، خانه عیش است و چمن، کوی نشاط","تا مهیا نبود عیش مهنا نرویم","بوستان محل لذت و خوشی است و چمن محل شادابی، اما تا وقتی که شرایط برای خوشی فراهم نباشد، ما به آنجا نمی‌رویم."],[441,"دیگران با همه کس، دست در آغوش کنند","ما که بر سفره خاصیم به یغما نرویم","دیگران با هر کسی راحت دوست می‌شوند و محبت می‌کنند، ولی ما که در جمع خاصی هستیم، اجازه نمی‌دهیم که در جایی که به ما تعلق دارد، دچار سرقت یا خیانت شویم."],[441,"نتوان رفت مگر در نظر یار، عزیز","ور تحمل نکند زحمت ما تا نرویم","نمی‌توانیم به دور از چهره محبوب برویم و اگر او تحمل نکند زحمت ما را، دست از رفتن خواهیم کشید. (AI: نمی‌توانیم به دور از چهره محبوب برویم و اگر او تحمل نکند که ما به زحمت بیفتیم، دست از رفتن نخواهیم کشید.)"],[441,"گر به خواری ز در خویش براند ما را","به امیدش بنشینیم و به درها نرویم","اگر ما را با ناملایمتی و تحقیر از خانه‌اش بیرون کند، در انتظار او می‌نشینیم و به درهای دیگر نمی‌رویم."],[441,"گر به شمشیر احبا تن ما پاره کنند","به تظلم به در خانه اعدا نرویم","اگر دوستانمان (احبا) با شمشیر بدن ما را تکه‌تکه کنند، ما به خاطر فریاد و یاری خواهی، به در خانه دشمنان و اعدا نخواهیم رفت."],[441,"پای گو بر سر و بر دیده ما نه چو بساط","که اگر نقش بساطت برود، ما نرویم","ای کسی که بر ما حکومت می‌کنی، مثل کسی که پایش را بر سر و چشم دیگران می‌گذارد، بر ما تسلط داشته باش؛ چون اگر زیبایی و ناز و نعمت تو از میان برود، ما از کنارت دور نخواهیم شد."],[441,"به درشتی و جفا روی مگردان از ما","که به کشتن برویم از نظرت یا نرویم","از بی‌رحمی و سخت‌گیری بر ما چشم‌پوشی کن، زیرا ما فقط با کشته شدن از مقابل دیدگانت می‌رویم وگرنه نمی‌رویم. (AI: از بی‌رحمی و سخت‌گیری بر ما چشم‌پوشی کن، زیرا ما با دیدن تو یا از دنیا می‌رویم.)"],[441,"سعدیا! شرط وفاداری لیلی آن است","که اگر مجنون گویند به سودا نرویم","سعدی! وفاداری واقعی در عشق لیلی این است که اگر کسی درباره مجنون (عاشق دیوانه لیلی) بگوید که او به دلدادگی نمی‌رسد، ما هم نبایستی به عشق بپردازیم و نباید به دلدادگی او عادت کنیم."],[442,"گر غصه روزگار گویم","بس قصه بی‌شمار گویم","اگر بخواهم غم و اندوه زندگی را بازگو کنم، داستان‌های فراوانی دارم که می‌توانم بگویم."],[442,"یک عمر هزار سال باید","تا من یکی از هزار گویم","برای این‌که من بتوانم یکی از هزاران قصه غم و اندوه خود را بگویم، باید هزار سال زندگی کنم."],[442,"چشمم به زبان حال گوید","نی آن که به اختیار گویم","چشم من به طور غیرکلامی و بدون گفتن، احساسات و حالات درونی‌ام را بیان می‌کند، نه اینکه به انتخاب خودم بگویم."],[442,"بر من دل انجمن بسوزد","گر درد فراق یار گویم","اگر من درباره درد جدایی از یار صحبت کنم، همه دل‌های جمع ما برای من می‌سوزد."],[442,"مرغان چمن فغان برآرند","گر فرقت نوبهار گویم","اگر من از جدایی بهار جدید صحبت کنم، پرندگان باغ نیز به شیون و ناله درمی‌آیند."],[442,"یاران صبوحیم کجایند","تا درد دل خمار گویم","یاران نوشیدنی‌نوش من کجا هستند تا بتوانم از غم و درد خود بگویم؟"],[442,"کس نیست که دل سوی من آرد","تا غصه روزگار گویم","کسی نیست که به نزد من بیاید تا درباره غصه‌ها و مشکلات زندگی‌ام صحبت کنم."],[442,"درد دل بی‌قرار سعدی","هم با دل بی‌قرار گویم","سعدی می‌گوید که او هم درد و غصه‌های دل بی‌قرار خود را با کسی که دلش بی‌قرار است، در میان می‌گذارد."],[443,"بکن چندان که خواهی جور بر من","که دستت بر نمی‌دارم ز دامن","هر کاری که می‌خواهی با من بکن و به من ظلم کن، چون هیچ امیدی به رهایی از تو ندارم و دست از محبت به تو برنمی‌دارم."],[443,"چنان مرغ دلم را صید کردی","که بازش دل نمی‌خواهد نشیمن","چنان دل مرا به خود captivated کرده‌ای که دیگر جایی برای پرواز و آرامش نمی‌خواهد."],[443,"اگر دانی که در زنجیر زلفت","گرفتار است در پایش میفکن","اگر می‌دانی که من به خاطر زلف‌های تو به اسارت درآمده‌ام و در زنجیر عشق تو هستم، او را به بی‌رحمی به پای من نینداز."],[443,"به حسن قامتت سروی در آفاق","نپندارم که باشد غالب‌الظن","من به زیبایی قامت تو، مانند سرو معروفی در دنیا، فکر نمی‌کنم که این احتمال وجود دارد که این سرو واقعا وجود داشته باشد."],[443,"الا ای باغبان! این سرو بنشان","و گر صاحب دلی، آن سرو برکن","ای باغبان! این سرو (معشوق) را بکار و اگر اهل دل هستی، آن سرو (که اشاره به محبوب است) را هرس کن."],[443,"جهان روشن به ماه و آفتاب است","جهان ما به دیدار تو روشن","جهان به نور ماه و خورشید روشن است، اما در چشم من، جهان فقط به خاطر دیدن تو نورانی و پرنور می‌شود."],[443,"تو بی‌زیور محلّایی و بی‌رخت","مزکّایی و بی‌زینت مزیّن","تو بدون زینت و زیور ظاهری، جایگاه و مقام والایی داری و بی‌پوشش و زینتی، زیبا و دل‌نشین هستی."],[443,"شبی خواهم که مهمان من آیی","به کام دوستان و رغم دشمن","دلم می‌خواهد شبی مهمان من شوی، در حالی که دوستان خوشحال هستند و دشمنان ناراحت."],[443,"گروهی عام را کز دل خبر نیست","عجب دارند از آه سینه من","گروهی که از عمق دل و احساسات باخبر نیستند، از آه و ناله سینه من تعجب می‌کنند."],[443,"چو آتش در سرای افتاده باشد","عجب داری که دود آید ز روزن","اگر در خانه آتش بگیرد، طبیعی است که دود از پنجره خارج شود؛ بنابراین، توقع نداشته باش که در پی دردها و اندوه‌های من نشانی نباشد."],[443,"تو را خود هر که بیند دوست دارد","گناهی نیست بر سعدی معین","هر کسی که تو را ببیند، به تو علاقه‌مند می‌شود، و این موضوع هیچ گناهی به سعدی معین (سعدی) نسبت نمی‌دهد."],[444,"یا رب آن روی است یا برگ سمن؟","یا رب آن قد است یا سرو چمن؟","ای خدای من، آیا آنچه می‌بینم، روی زیبای اوست یا برگ درخت سمن؟ آیا آن قامت شگفت‌انگیز، متعلق به اوست یا سرو چمن؟"],[444,"بر سمن کس دید جعد مشک‌بار؟","در چمن کس دید سرو سیم‌تن؟","هیچ‌کس در باغ سمن، موهای چرخان و زلف مشکین مانند تو را ندیده است. هیچ‌کس در چمن، قامت زیبا و نرم سروی مانند تو را مشاهده نکرده است."],[444,"عقل چون پروانه گردید و نیافت","چون تو شمعی در هزاران انجمن","عقل مانند پروانه به دور تو می‌چرخد و نمی‌تواند مانند تو شمعی را در میان هزاران جمعیت بیابد که اینگونه جذاب باشد."],[444,"سخت مشتاقیم پیمانی بکن","سخت مجروحیم پیکانی بکن","ما به شدت در انتظاریم که پیمانی ببندیم و از طرفی زخم‌هایمان عمیق است و نیاز داریم نوک تیری را بیرون کشی. (AI: ما به شدت در انتظاریم که پیمانی ببندیم و از طرفی زخم‌هایمان عمیق است و نیاز به فرستنده‌ای داریم تا صدای ما را به دیگران برساند.)"],[444,"وه کدامت زین همه شیرین‌تر است؟","خنده یا رفتار یا لب یا سخن؟","کدام یک از این ویژگی‌ها در تو از همه شیرین‌تر و دلپذیرتر است؟ آیا خندنت، رفتارت، لب و دندانت یا سخن گفتنت؟"],[444,"گر سر ما خواهی اینک جان و سر","ور سر ما داری اینک مال و تن","اگر در این لحظه بخواهی، جان و سر ما هست، و اکنون هم مال و جسم ما در اختیار توست."],[444,"گر نوازی ور کشی فرمان تو راست","بنده‌ایم اینک سر و تیغ و کفن","اگر خواسته‌ای را برآورده کنی یا ما را به قتل برسانی، هر دو با کمال میل تسلیم دستور تو هستیم، زیرا اکنون جان و سر و زندگی‌مان در دست توست."],[444,"صعقه می‌خواهی؟ حجابی در گذار","فتنه می‌جویی؟ نقابی بر فکن","آیا ما را بی‌هوش می‌خواهی؟ حجابت را بردار، آیا بی‌قراری ما را می‌خواهی؟ نقاب از چهره بردار. / (AI: اگر به دنبال حالتی شگفت‌انگیز و عمیق هستی، باید از موانع و حجاب‌ها عبور کنی و در میانه آشفتگی‌ها، نقابی بر چهره خود بگذاری تا بتوانی به درون دنیای واقعی‌ات نفوذ کنی.)"],[444,"من کیم کآن جا که کوی عشق توست؟","در نمی‌گنجد حدیث ما و من","من چه کسی هستم که در جایی که کوی عشق تو قرار دارد، نمی‌توانم در مورد خودم صحبت کنم؟ عشق تو آنقدر بزرگ است که از حد و مرزهای من فراتر می‌رود."],[444,"ای ز وصلت خانه‌ها دارالشفا","وی ز هجرت بیت‌ها بیت‌الحزن","تو از وصالت، منازل و خانه‌ها را به محل درمان و شفا تبدیل کرده‌ای، اما از دوری و جدایی‌ات، هر خانه‌ای به بیت و مکانی برای اندوه و غم بدل شده است."],[444,"وقت آن آمد که خاک مرده را","باد ریزد آب حیوان در دهن","زمانی فرارسیده که باد، خاک مرده را پراکنده کند و جان‌بخش آب حیات را به او برساند."],[444,"پاره گرداند زلیخای صبا","صبحدم بر یوسف گل پیرهن","نسیم صبح، گل‌های زیبا را به دور از یوسف، که به زلیخا (زن پادشاه مصر) شبیه است، می‌چرخاند و لباس او را به گل آراسته می‌کند."],[444,"نطفه شبنم در ارحام زمین","شاهد گل گشت و طفل یاسمن","شبنم که بر روی زمین نشسته، به مانند نطفه‌ای در دل زمین است که باعث به بار نشستن گل و پیدایش یاسمن شده است."],[444,"فیح ریحان است یا بوی بهشت؟","خاک شیراز است یا باد ختن؟","آیا بوی ریحان است یا عطر بهشت؟ آیا اینجا خاک شیراز است یا نسیم ختن؟"],[444,"بر گذر تا خیره گردد سروبن","در نگر تا تیره گردد نسترن","در مسیر رفتن، دقت کن که چگونه درخت سرو به زیبایی تو متحیر می‌شود و گل نسترن چگونه در سایه و تیرگی قرار می‌گیرد. (AI: در مسیر رفتن، دقت کن که چگونه گل سروبن به زیبایی خود می‌درخشد و گل نسترن چگونه در سایه و تیرگی قرار می‌گیرد.)"],[444,"بارگاه زاهدان در هم نورد","کارگاه صوفیان بر هم شکن","زاهدان همان خود را از دنیا جدا کرده‌اند و در عبادت مشغولند، باید بارگاه آن‌ها (مقام و منزلت‌شان) را در هم شکست تا کارگاه صوفیان (محل کار و زندگی عرفا) به هم بریزد."],[444,"شاهدان چستند ساقی گو «بیار»","عاشقان مستند مطرب گو «بزن»","شاهدان زیبا و شادابند، ای ساقی بگو که شراب بیاورد. عاشقان هم مست و سرمست هستند، ای مطرب بگو که ساز را بزن."],[444,"سغبه خلقم چو صوفی در کنش","شهره شهرم چو غازی بر رسن","من همانند آن صوفی‌ام که در کنشت (عبادتگاه) بازیچه مردم شده‌ام و آن طناب‌باز روی ریسمان که مشهور در شهر شده‌ام. /صوفی: غ14 ب6 / (AI: من شبیه یک صوفی در عواطف و احساساتم هستم و در کارهای خود مشهور و معروف شده‌ام مانند کسی که بر روی ریسمانی راه می‌رود.)"],[444,"تربیت را حلّه گو «در ما مپوش»","عافیت را پرده گو «بر ما متن»","به تربیت بگو: ردا و لباس بر ما مپوشان و به عافیت و تندرستی بگو: ما را در پرده‌ای تنیده مکن (مپوشان). /به زبان ساده: تربیت و عافیت نمی‌خواهیم./ (AI: تربیت را به‌طور واضح و روشن بیان کن و آن را از ما پنهان نکن. عافیت و راحتی را هم به‌طور مناسب و با احتیاط به ما عرضه کن.)"],[444,"چرخ با صد چشم چون روی تو دید","صد زبان می‌خواست تا گوید «حسن»","چرخ (آسمان) با صد نگاه به زیبایی تو خیره شد و به همین خاطر صد زبان می‌خواست که به وصف زیبایی تو بپردازد و بگوید که تو چقدر زیبا هستی."],[444,"ناسزا خواهم شنید از خاص و عام","سرزنش خواهم کشید از مرد و زن","می‌دانم که از همه مردم، اعم از خاص و عام، دشنام و نیش زبان می‌شنوم و از زنان و مردان نیز انتقاد و سرزنش را تحمل می‌کنم."],[444,"سعدیا گر عاشقی پایی بکوب","عاشقا گر مفلسی دستی بزن","سعدی، ای عاشق، اگر عاشق هستی، باید با اشتیاق و حرارت پا را به زمین بکوبی. و اگر بی‌پول و بی‌چیز هستی، باید با دست ما جالب توجهی را نشان دهی و به آن اشاره کنی."],[445,"در وصف نیاید که چه شیرین‌دهن است آن","این است که دور از لب و دندان من است آن","زیبایی و شیرینی کلام او را نمی‌توان با کلمات توصیف کرد، زیرا او دور از من و لبانم قرار دارد."],[445,"عارض نتوان گفت که دور قمر است این","بالا نتوان خواند که سرو چمن است آن","نمی‌توان گفت که این عارض (گونه یا صورت) دور از قمر (زیبا) است، و نمی‌توان خواند که این بلندی (سرا) از سرو چمن (گلی زیبا) است."],[445,"در سرو رسیده‌ست ولیکن به حقیقت","از سرو گذشته‌ست که سیمین‌بدن است آن","درست است که او به زیبایی و قامت سرو رسیده، اما در واقع از زیبایی یک سرو هم فراتر رفته و به خاطر تن زیبایش، شایسته‌تر از سرو است."],[445,"هرگز نبود جسم بدین حسن و لطافت","گویی همه روح است که در پیرهن است آن","هرگز جسمی به این زیبایی و نرمی نبود، گویی تمام روح در این بدن محجوب است."],[445,"خال است بر آن صفحه سیمین بناگوش","یا نقطه‌ای از غالیه بر یاسمن است آن","خال روی صورت او مانند یک نقطه کوچک بر صفحه نقره‌ای است، یا مانند یک نشانه زیبایی بر گل یاسمن است."],[445,"فی‌الجمله قیامت تویی امروز در آفاق","در چشم تو پیداست که باب فتن است آن","تو امروز در عالم مانند قیامت هستی و تمام علامت‌ها در دیده تو نمایان است، به‌طوری‌که این شرایط، نشانه‌ای از آشفتگی‌ها و فتنه‌ها است."],[445,"گفتم که دل از چنبر زلفت برهانم","ترسم نرهانم که شکن بر شکن است آن","گفتم می‌خواهم دلم را از چنگ زلف‌های تو آزاد کنم، اما می‌ترسم که نتوانم این کار را انجام دهم، زیرا هر بار که می‌کوشم، زنجیر محبت تو محکم‌تر می‌شود."],[445,"هر کس که به جان آرزوی وصل تو دارد","دشوار برآید که محقر ثمن است آن","هر کسی که آرزوی رسیدن به تو (در ازای جانش) را در دل دارد، باید بداند که این خواسته بسیار سخت و دشوار است؛ زیرا به نظر می‌رسد که ارزش و بهای آن (جان) ناچیز است."],[445,"مردی که ز شمشیر جفا روی بتابد","در کوی وفا مرد مخوانش که زن است آن","مردی که از اندوه و ظلم دیگران رو برمی‌گرداند و به جایی که در آن وفا و وفاداری هست می‌رسد، نمی‌توان او را مرد واقعی دانست زیرا در پی زنی (دلبستگی) است."],[445,"گر خسته‌دلی نعره زند بر سر کویی","عیبش نتوان گفت که بی‌خویشتن است آن","اگر دلی ناامید و خسته در سر کوی عشق فریاد بزند، نمی‌توان به او عیب گرفت زیرا او در حالتی از بی‌خود شدن و از خود بی‌خود بودن قرار دارد."],[445,"نزدیک من آن است که هر جرم و خطایی","کز صاحب وجه حسن آید حسن است آن","هر خطا و اشتباهی که از کسی که دارای زیبایی و حسن است، سر بزند، زیبا و قابل قبول است."],[445,"سعدی سر سودای تو دارد نه سر خویش","هر جامه که عیار بپوشد کفن است آن","سعدی برای تو عشق و خواسته‌ای برگرفته از تو دارد، نه برای خود. هر لباسی که شخص زیبا و باارزش به تن کند، در حقیقت مثل کفن است و نشان‌دهنده مرگ یا جدایی از زندگی خوشایند است."],[446,"ای کودک خوبروی حیران","در وصف شمایلت سخندان","ای کودک زیبا که در توصیف زیبایی‌ات حیرانم و نمی‌دانم چه بگویم."],[446,"صبر از همه چیز و هر که عالم","کردیم و صبوری از تو نتوان","ما در برابر تمام چیزها و انسان‌ها صبر و تحمل کردیم، اما از تو نمی‌توانیم صبر کنیم و طاقت بیاوریم."],[446,"دیدی که وفا به سر نبردی","ای سخت‌کمان سست‌پیمان","توجه کن که تو ای کسی که با کمان سختی می‌کشی، هنوز به وعده‌ات وفا نکردی و پیمان سست و ضعیفی داری."],[446,"پایان فراق ناپدیدار","و امید نمی‌رسد به پایان","فراق و جدایی به طور ناگهانی پایان نمی‌یابد و امید به پایان این وضعیت هم در دسترس نیست."],[446,"هرگز نشنیده‌ام که کرده‌ست","سرو آنچه تو می‌کنی به جولان","هرگز نشنیده‌ام که درخت سرو هم مانند تو این‌گونه زیبایی و خوش‌رقصی کرده باشد."],[446,"باور که کند که آدمی را","خورشید برآید از گریبان","هیچ‌کس باور نمی‌کند که از وجود یک انسان، نور و روشنایی مانند خورشید بیرون بیاید."],[446,"بیمار فراق به نباشد","تا بو نکند به زنخدان","کسی که به خاطر دوری معشوق بیمار شده، تا زمانی که او را نبیند و بوی عطرش را احساس نکند، بهبودی نخواهد یافت."],[446,"وین گوی سعادت است و دولت","تا با که در افکنی به میدان","این گوی سعادت و خوشبختی است که تو باید آن را هرگاه که بخواهی، به دیگران بدهی یا در میدان زندگی خود به کار بگیری."],[446,"ترسم که به عاقبت بماند","در چشم سکندر آب حیوان","می‌ترسم که در نهایت، آب حیات که باعث جوانی و زندگی ابدی است، در چشم سکندر (پادشاه بزرگ، سکندر مقدونی) بماند و او نتواند از آن استفاده کند."],[446,"دل بود و به دست دلبر افتاد","جان است و فدای روی جانان","دل «من» به دست معشوق افتاد و جان «من» فدای زیبایی و روی محبوب است."],[446,"عاقل نکند شکایت از درد","مادام که هست امید درمان","عاقل هرگز از دردی شکایت نمی‌کند تا زمانی که امیدی به درمان آن دارد."],[446,"بی مار به سر نمی‌رود گنج","بی خار نمی‌دمد گلستان","بدون درد و رنج، رسیدن به گنج و موفقیت ممکن نیست و هیچ زیبایی و خوشی بی‌ سختی به وجود نمی‌آید."],[446,"گر در نظرت بسوخت سعدی","مه را چه غم از هلاک کتان","اگر در نظر تو، سعدی، ماه را بسوزاند و نابود کند، چه اهمیتی دارد که کتان (پارچه‌ای از الیاف گیاهی) هلاک شود؟"],[446,"پروانه بکشت خویشتن را","بر شمع چه لازم است تاوان؟","پروانه که به خاطر شمع جانش را قربانی می‌کند، چه ضرورتی دارد که برای کار خود بهای آن را بپردازد؟"],[447,"برخیز که می‌رود زمستان","بگشای در سرای بستان","بلند شو که زمستان در حال رفتن است، در باغ را باز کن تا بهار بیاید."],[447,"نارنج و بنفشه بر طبق نه","منقل بگذار در شبستان","نارنج و بنفشه را بر روی میزی بگذار که مخصوص شب‌های بلند و گرم است."],[447,"وین پرده بگوی تا به یک بار","زحمت ببرد ز پیش ایوان","و این پرده را بکش تا یک‌باره زحمت و زحمت‌کشی را از جلوی ایوان بردارد."],[447,"برخیز که باد صبح نوروز","در باغچه می‌کند گل افشان","بیدار شو، زیرا باد صبحگاهی نوروز در باغچه می‌خزد و گل‌ها را به‌راستی پراکنده می‌کند."],[447,"خاموشی بلبلان مشتاق","در موسم گل ندارد امکان","در فصل گل، بلبلان عاشق نمی‌توانند خاموش بمانند و حتما باید آواز سر دهند."],[447,"آواز دهل نهان نماند","در زیر گلیم و عشق پنهان","صدای دهل هرگز نمی‌تواند در زیر گلیم مخفی بماند و عشق نیز نمی‌تواند پنهان بماند."],[447,"بوی گل بامداد نوروز","و آواز خوش هزاردستان","عطر گل در صبح عید نوروز و صدای دل‌انگیز هزار نوازنده به مشام می‌رسد."],[447,"بس جامه فروخته‌ست و دستار","بس خانه که سوخته‌ست و دکان","بسیاری از افراد به خاطر عشق و دلبستگی، مال و متاع خود را فروخته‌اند و خانه‌ها و مغازه‌ها نیز به خاطر غم و اندوهی که در زندگی‌شان وجود دارد، از بین رفته‌اند."],[447,"ما را سر دوست بر کنار است","آنک سر دشمنان و سندان","ما به خاطر دوستی و عشق به محبوب، بی‌خیال دشمنان هستیم؛ در حالی که دشمنان به فشار و سختی گرفتارند."],[447,"چشمی که به دوست برکند دوست","بر هم ننهد ز تیرباران","چشمی که روی دوست را ببیند، هیچ‌گاه از تیراندازی دشمن نمی‌ترسد."],[447,"سعدی چو به میوه می‌رسد دست","سهل است جفای بوستانبان","سعدی وقتی به میوه می‌رسد، نشان می‌دهد که گرفتن میوه برای او آسان است، و این به معنای نادیده گرفتن زحمت و رنج باغبان‌ها است."],[448,"خوشا و خرّما وقت حبیبان","به بوی صبح و بانگ عندلیبان","خوشا و خوشحالی در وقتی که محبوبان در کنار یکدیگرند، در حالی که بوی خوش صبح و صدای پرندگان خوش‌خوان حس را تازه می‌کند."],[448,"خوش آن ساعت نشیند دوست با دوست","که ساکن گردد آشوب رقیبان","ساعت خوشی است که دوست با دوست دور هم بنشینند، زیرا در این زمان تنش‌ها و رقابت‌های دشمنان آرام می‌گیرد."],[448,"دو تن در جامه‌ای چون پسته در پوست","برآورده دو سر از یک گریبان","دو نفر در یک لباس مانند پسته‌ای هستند که دو سر آن از یک پوست بیرون آمده است، یعنی به هم بسیار نزدیک و مرتبط‌اند."],[448,"سزای دشمنان این بس که بینند","حبیبان روی در روی حبیبان","دشمنان تنها این حق را دارند که مشاهده کنند دوستان، در مقابل هم، با عشق و محبت با یکدیگر روبه‌رو هستند."],[448,"نصیب از عمر دنیا نقد وقت است","مباش ای هوشمند از بی‌نصیبان","زندگی در دنیا تنها فرصتی آنی و گذراست؛ بنابراین ای هوشمند تلاش نکن که از بی‌نصیب‌ها چیزی به دست آوری."],[448,"چو دانی کز تو چوپانی نیاید","رها کن گوسفندان را به ذئبان","وقتی می‌دانی که از تو فایده‌ای نمی‌رسد، بهتر است گله گوسفندان را به گرگ‌ها بسپاری و رهایشان کنی."],[448,"من این رندان و مستان دوست دارم","خلاف پارسایان و خطیبان","من با این رندان و مستان هم‌نشینی و دوستی دارم و این انتخاب من بر خلاف رفتار پارسایان و وعاظ است که خود را در مقام معنویت و سخنرانی قرار می‌دهند."],[448,"بهل تا در حق من هر چه خواهند","بگویند آشنایان و غریبان","بگذار هرچه می‌خواهند درباره من بگویند، چه دوستان آشنا و چه بیگانگان."],[448,"لب شیرین‌لبان را خصلتی هست","که غارت می‌کند هوش لبیبان","خصلتی در لب‌های شیرین وجود دارد که باعث می‌شود افرادی که به زیبایی و لذت آنها توجه می‌کنند، هوش و فهم خود را از دست بدهند."],[448,"نشستم با جوانمردان اوباش","بشستم هر چه خواندم بر ادیبان","نشستم با جوانمردان بی‌قید و بند و همه چیزهایی را که از ادیبان آموخته بودم، فراموش کردم."],[448,"که می‌داند دوای درد سعدی","که رنجورند از این علت طبیبان","چه کسی که به واقعیات زندگی آگاه است، می‌داند چه چیزی می‌تواند به دلیلی که باعث رنج و ناراحتی سعدی شده، کمک کند؟ درمان درد او تنها در دست پزشکان نیست، بلکه آنها نیز از درد او در رنجند. (AI: کسی که به واقعیات زندگی آگاه است، می‌داند چه چیزی می‌تواند به دلیلی که باعث رنج و ناراحتی مردم شده، کمک کند. درمان درد آن‌ها تنها در دست پزشکان نیست، بلکه نیاز به درک عمیق‌تری از وضعیت وجود دارد.)"],[449,"چه خوش است بوی عشق از نفس نیازمندان","دل از انتظار خونین، دهن از امید خندان","عطر عشق از نفوس نیازمندان بسیار خوشبوست؛ دل‌هایی که از انتظار به شدت در عذابند، اما لب‌هاشان از امید لبخند می‌زنند."],[449,"مگر آن که هر دو چشمش همه عمر بسته باشد","به ورع خلاص یابد، ز فریب چشم‌بندان","تنها در صورتی می‌تواند از فریب دیگران (زیبارویان) خلاص شود که تمام عمرش با تقوا و احتیاط، چشم‌ها را بسته نگه دارد."],[449,"نظری مباح کردند و هزار خون معطل","دل عارفان ببردند و قرار هوشمندان","یک نگاه روا به دل عارفان هزاران رنج و درد و خون به جا گذاشت و آرامش و ثبات افراد باهوش را از بین برد. (AI: چشم‌اندازی آزاد به دل عارفان هزاران رنج و درد و خون به جا گذاشت و آرامش و ثبات افراد باهوش را از بین برد.)"],[449,"سر کوی ماه‌رویان، همه روز فتنه باشد","ز معربدان و مستان و معاشران و رندان","در محل سکونت زیباکنندگان و عاشقان، هر روز جاذبه‌ای وجود دارد که باعث ایجاد آشفتگی و هیجان می‌شود، و این حال و هوای شاد و پر شور را از خوشگذرانان، نازک‌دل‌ها و کسانی که اهل تفریح‌اند می‌سازد."],[449,"اگر از کمند عشقت بروم، کجا گریزم؟","که خلاص بی‌تو بند است و حیات بی‌تو زندان","اگر از دام عشق تو رها شوم، کجا می‌توانم بگریزم؟ زیرا رهایی از سرزندگی بدون تو ممکن نیست و زندگی بدون تو برای من مانند زندان است."],[449,"اگرم نمی‌پسندی، مدهم به دست دشمن","که من از تو برنگردم، به جفای ناپسندان","اگر تو من را نپسندی، (نگذار) که به دست دشمنانم بیفتم؛ اما من هرگز از تو به خاطر ظلم و بی‌رحمی دیگران دور نخواهم شد."],[449,"نفسی بیا و بنشین، سخنی بگوی و بشنو","که قیامت است چندان، سخن از دهان خندان","نفسی بیا و بنشین، کمی استراحت کن و صحبت کن یا گوش کن، زیرا سخنی از دهان خندان تو، قیامت به پا می‌کند. (AI: نفسی بیا و بنشین، کمی استراحت کن و صحبت کن یا گوش کن، زیرا در این دنیای پر از حرف‌های خوشایند، وقت زیاد نیست.)"],[449,"اگر این شکر ببینند، محدثان شیرین","همه دست‌ها بخایند، چو نیشکر به دندان","اگر اهل علم و بیان این شیرینی (سخن) را ببینند، همه دست‌ها را مانند نیشکر به دندان می‌گیرند و احساس لذت می‌کنند. (AI: اگر اهل علم و بیان این شیرینی را ببینند، همه دست‌ها به شکرگزاری خواهند آمد، درست همان‌طور که نیشکر در دندان احساس لذت می‌کند.)"],[449,"همه شاهدان عالم، به تو عاشقند سعدی","که میان گرگ صلح است و میان گوسفندان","همه افرادی که در دنیا شاهد هستند، به تو، سعدی، عشق می‌ورزند؛ زیرا تو توانسته‌ای بین دشمنان (گرگ‌ها) و دوستان (گوسفندان) صلح برقرار کنی."],[450,"بگذار تا بگرییم چون ابر در بهاران","کز سنگ گریه خیزد روز وداع یاران","(مرا به‌حال خود) بگذار تا چون ابر بهاری بگریم‌؛ زیراکه روز وداع‌، سخت است‌، (حتی) سنگ را به ناله و گریه وامی‌دارد."],[450,"هر کو شراب فرقت روزی چشیده باشد","داند که سخت باشد قطع امیدواران","فرقت‌: جدایی."],[450,"با ساربان بگویید احوال آب چشمم","تا بر شتر نبندد محمل به روز باران","محمل بر شتر نبندد: عزیمت نکند، سفر را انجام ندهد. (محمل‌: کجاوه‌ای که برای بانوان بر شتر می‌بندند)"],[450,"بگذاشتند ما را در دیده آب حسرت","گریان چو در قیامت چشم گناهکاران","ما را با دلی پر حسرت و چشمانی پراشک رها کردند؛ گریان و غمگین همچون گناهکاران در روز قیامت."],[450,"ای صبح شب‌نشینان جانم به طاقت آمد","از بس که دیر ماندی چون شام روزه‌داران","ای صبح و ای امید کسانی‌که همه شب را منتظر تو ماندند؛ چرا همچون شام روزه‌داران دیر آمدی؟ جانم بی‌طاقت شد."],[450,"چندین که برشمردم از ماجرای عشقت","اندوه دل نگفتم الا یک از هزاران","هرچه از غم‌ها و بلاهای عشق تو را تعریف‌کردم یکی از هزار نبود و نگفتم!"],[450,"سعدی به روزگاران مهری نشسته در دل","بیرون نمی‌توان کرد الا به روزگاران","ای سعدی‌، این عشق و مهر سال‌ها طول کشیده‌است؛ و به‌آسانی و بزودی از دل بیرون نخواهد شد."],[450,"چندت کنم حکایت شرح این قدر کفایت","باقی نمی‌توان گفت الا به غمگساران","چقدر برای تو داستان عشق خود را بگویم؟ همین‌قدر کافی‌است که بقیه را جز به محرمان هم‌رازها و غمگساران نخواهم گفت."],[451,"دو چشم مست میگونت ببرد آرام هشیاران","دو خواب‌آلوده بربودند عقل از دست بیداران","دو چشم زیبای تو که مست و رنگین است، آرامش هشیاران را از بین می‌برد؛ مانند افرادی که در خواب هستند و عقل و درک خود را از دست می‌دهند."],[451,"نصیحتگوی را از من بگو ای خواجه دم درکش","چو سیل از سر گذشت آن را چه می‌ترسانی از باران","ای خواجه، وقتی که سیل از بالای سر گذشت، دیگر چرا نصیحت‌گو را از من می‌گویی؟ چرا این نصیحت را در برابر باران می‌ترسانی؟"],[451,"گر آن ساقی که مستان راست هشیاران بدیدندی","ز توبه توبه کردندی چو من بر دست خماران","اگر آن ساقی (پرنده مست) که مستان (مست‌ها) را می‌بیند، افراد هشیار (هوشیار) را ببیند، از توبه (بازگشت از گناه) پشیمان می‌شود و همانند من که در دستان خماران (مست‌ها) هستم، به می‌خورد."],[451,"گرم با صالحان بی‌دوست فردا در بهشت آرند","همان بهتر که در دوزخ کنندم با گنهکاران","اگر قرار باشد بهشتی شوم اما بدون آن دلبر یگانه، بهتر می‌پسندم که در جهنم با گناهکاران باشم تا با نیکوکاران بهشت. به عبارت دیگر خوبی بهشت هم برای من، همنشینی با نیکوکاران نیست، بلکه هم نشینی با توست و اگر قرار است تو در بهشت نباشی، هم‌نشینی دوزخیان که ناله‌های من در ناله ایشان گم شود، بهتر است تا هم‌نشینی از بهشتیان رضایت داده به بهشت بدون تو."],[451,"چه بوی است این که عقل از من ببرد و صبر و هشیاری","ندانم باغ فردوس است یا بازار عطاران","من از بوی خوشی که می‌آید دیوانه شدم و نمی‌دانم این بوی خوش بهشت است یا عطر بازار عطاران."],[451,"تو با این مردم کوته‌نظر در چاه کنعانی","به مصر آ تا پدید آیند یوسف را خریداران","با این مردم کم‌فهم و بی‌خود در کنعان (مناطق اطراف مصر) به چاه برو تا برای خریدن یوسف (نماد زیبایی و ارزش) خریداران پیدا شوند. این اشاره به این است که در بین مردمی که نمی‌توانند زیبایی و ارزش را بشناسند، تو نمی‌توانی خود را نشان دهی."],[451,"الا ای باد شبگیری بگوی آن ماه مجلس را","تو آزادی و خلقی در غم رویت گرفتاران","ای باد شب، به آن ماه مجلس بگو که تو آزاد هستی و مردم به خاطر زیبایی‌ات در غم و اندوه هستند."],[451,"گر آن عیار شهرآشوب روزی حال من پرسد","بگو خوابش نمی‌گیرد به شب از دست عیاران","اگر آن شخص فریبنده و شهرآشوب روزی حال مرا پرسید، به او بگو که خوابش در شب به خاطر دست‌های عیاران (فریبکاران و بدکاران) نمی‌برد."],[451,"گرت باری گذر باشد نگه با جانب ما کن","نپندارم که بد باشد جزای خوب‌کرداران","اگر گاهی گذرت به سمت ما بیفتد، فکر نکن که جزای محبت ما بد خواهد بود، زیرا برای نیکوکاران هیچ چیز جز خوبی و پاداش نیکو نیست."],[451,"کسان گویند چون سعدی جفا دیدی تحول کن","رها کن تا بمیرم بر سر کوی وفاداران","برخی به سعدی توصیه می‌کنند که اگر در عشق دچار ایذا و جفا شده است، باید از آن جدا شود و ترک کند، و فقط بر سر کوی وفاداران بمیرد."],[452,"فراق دوستانش باد و یاران","که ما را دور کرد از دوستداران","فراق و دوری دوستان و یاران، سبب شده که ما از محبوبان و دوستداران خود دور شویم."],[452,"دلم در بند تنهایی بفرسود","چو بلبل در قفس روز بهاران","دل من به شدت در رنج تنهایی فرسوده شده، مانند بلبلانی که در قفس در فصل بهار غمگین‌اند."],[452,"هلاک ما چنان مهمل گرفتند","که قتل مور در پای سواران","سرنوشت ما را چنان بی‌توجهی گرفت که کشته شدن یک مور در زیر پای سواران هم برای کسی مهم نیست."],[452,"به خیل هر که می‌آیم به زنهار","نمی‌بینم به جز زنهارخواران","هر جا که می‌روم، افرادی را می‌بینم که به جای کمک و حمایت، فقط نگران جان خود هستند و به فکر حفاظت از خودشان هستند."],[452,"ندانستم که در پایان صحبت","چنین باشد وفای حق گزاران","نمی‌دانستم که در پایان گفتگو این‌گونه خواهد بود که تنها وفاداران به حق، باقی می‌مانند."],[452,"به گنج شایگان افتاده بودم","ندانستم که بر گنجند ماران","من در گنجی با ارزش و بزرگ قرار داشتم، اما نمی‌دانستم که در آنجا مارهایی به کمین نشسته‌اند."],[452,"دلا گر دوستی داری به ناچار","بباید بردنت جور هزاران","اگر دل تو دوستی دارد، ناگزیر باید تحمل کدورت‌ها و سختی‌های بسیاری را بکشی."],[452,"خلاف شرط یاران است سعدی","که برگردند روز تیرباران","سعدی می‌گوید که برخلاف انتظار و شرط دوستان، در زمان دشواری و بلایای روز تیراندازی، نباید یاران و دوستان شما را ترک کنند."],[452,"چه خوش باشد سری در پای یاری","به اخلاص و ارادت جان سپاران","خوشا به حال کسی که با تمام وجود و عشق، سرش را بر پاى یاری بگذارد و جانش را فدای او کند."],[453,"سخت به ذوق می‌دهد باد ز بوستان نشان","صبح دمید و روز شد خیز و چراغ وانشان","هوای صبحگاهی از بوی گلستان، دل را بسیار شاداب و خوشنود می‌کند. صبح که دمید، روز روشن شد و چراغ‌ها به یاد آن برافروخته شدند."],[453,"گر همه خلق را چو من بی‌دل و مست می‌کنی","روی به صالحان نما خمر به زاهدان چشان","اگر تو همه مردم را مانند من بی‌خود و حالمند می‌کنی، بی‌تردید به نیکوکاران نشان بده و به زاهدان شراب بچشان."],[453,"طایفه‌ای سماع را عیب کنند و عشق را","زمزمه‌ای بیار خوش تا بروند ناخوشان","گروهی به سماع (حرکت موزون و شاد از محبت) انتقاد می‌کنند و عشق را بی‌اهمیت می‌دانند، اما بهتر است که آهنگی زیبا بیاوری تا کسانی که از حال خوش دورند، خوشحال شوند."],[453,"خرقه بگیر و می بده باده بیار و غم ببر","بی‌خبر است عاقل از لذت عیش بیهشان","خرقه (ردای مخصوصی که عارفان می‌پوشند) را بگیر و می (شراب) بده و باده بیاور و غم را ببر، زیرا آدم عاقل از لذتی که در خوش‌گذرانی‌های بی‌خبرانه وجود دارد، بی‌خبر است."],[453,"سوختگان عشق را دود به سقف می‌رود","وقع ندارد این سخن پیش فسرده آتشان","سوختگان عشق، کسانی هستند که در دل شوق و محبت می‌سوزند و دود ناشی از آتش عشقشان به سقف می‌رود. این موضوع برای افرادی که خود حسی از عشق ندارند، اهمیت و ارزشی ندارد و صحبت کردن درباره آن برای کسانی که از شوق و لبریز بودن عشق بی‌خبرند، بی‌فایده است."],[453,"رقص حلال بایدت سنت اهل معرفت","دنیا زیر پای نه دست به آخرت فشان","اهل معرفت به تو می‌گوید که در زندگی دنیوی، باید با آزادی و شادی زندگی کنی و نه اینکه با کج‌سلیقگی و ناپسندهایی که بر سر آخرت می‌زنند، به آن دنیای دیگر آسیب بزنی."],[453,"تیغ به خفیه می‌خورم آه نهفته می‌کنم","گوش کجا که بشنود ناله زار خامشان","در دل خود درد و غمی دارم که به کسی نمی‌گویم و به آرامی احساساتم را پنهان می‌کنم؛ گویی گوش‌های خاموشی هستند که صدای زاری من را نمی‌شنوند."],[453,"چند نصیحتم کنی کز پی نیکوان مرو","چون نروم که بیخودم شوق همی‌برد کشان","چند بار می‌خواهی به من نصیحت کنی که به دنبال نیکان نروم؟ وقتی بی‌خود و شیدا هستم، اشتیاق مرا به سوی خود می‌کشد."],[453,"من نه به وقت خویشتن پیر و شکسته بوده‌ام","موی سپید می‌کند چشم سیاه اکدشان","من زودتر از زمان خود، احساس پیری و شکستگی کرده‌ام. چون چشم سیاه محبوبان، مو را سفید می‌کند. / اکدش: محبوب / (AI: من از زمانی که خود را شناختم، احساس پیری و شکستگی کرده‌ام. حتی با این که موهایم سفید شده، چشمانم هنوز زنگاری را در خود دارند.)"],[453,"بوی بهشت می‌دمد ما به عذاب در گرو","آب حیات می‌رود ما تن خویشتن کشان","بوی بهشت به مشام می‌رسد، اما ما به عذاب گرفتاریم. در حالی که آب حیات به سلامت و زندگی کمک می‌کند، ما با تن خود به درد و رنج ادامه می‌دهیم."],[453,"باد بهار و بوی گل متفقند سعدیا","چون تو فصیح بلبلی حیف بود ز خامشان","سعدی می‌گوید باد بهاری و عطر گل‌ها با هم هماهنگ و هم‌صدا هستند، و در این میان، وجود تو که مانند بلبل زیبا سخن می‌گویی، سزاوار است که به سخن‌های ناپخته و بی‌محتوا توجه نکنید."],[454,"دیگر به کجا می‌رود این سرو خرامان","چندین دل صاحب نظرش دست به دامان","این جوان زیبا و خوش‌حرکت (که به او «سرو خرامان» گفته می‌شود) به کجا می‌رود؟ و دل‌های زیادی که از زیبایی او تحت تأثیر قرار گرفته‌اند، به دنبال او هستند و دست به دامن او شده‌اند."],[454,"مرد است که چون شمع سراپای وجودش","می‌سوزد و آتش نرسیده‌ست به خامان","مردی وجود دارد که مانند شمع سوزان است و تمام وجودش در آتش عشق می‌سوزد، در حالی‌که آتش به خام‌ها (بی‌احساس‌ها) نرسیده است."],[454,"خون می‌رود از چشم اسیران کمندش","یک بار نپرسد که کیانند و کدامان","چشمان کسانی که در دام عشق او گرفتارند، به خاطر غم و درد می‌ریزد، ولی او حتی یک بار نمی‌پرسد که این افراد چه کسانی هستند و از کجا آمده‌اند."],[454,"گو خلق بدانید که من عاشق و مستم","در کوی خرابات نباشد سر و سامان","مردم، بدانید که من عاشق و سرمست هستم و در محله میخانه، هیچ‌گونه نظم و ترتیبی ندارم."],[454,"در پای رقیبش چه کنم گر ننهم سر","محتاج ملک بوسه دهد دست غلامان","اگر در پای رقیبش (یعنی معشوق) سرم را نگذارم، چه کار باید بکنم؟ زیرا اگر نیازمندش باشم، بوسه‌اش به دست خدمتکارانش داده می‌شود."],[454,"دل می‌تپد اندر بر سعدی چو کبوتر","زین رفتن و بازآمدن کبک خرامان","دل سعدی برای محبوبش به شدت می‌تپد مثل کبوتر، به خاطر آمدن و رفتن او که مانند کبکی با زیبایی و ناز می‌خرامد."],[454,"یا صاح متی یرجع نومی و قراری","انی و علی العاشق هذان حرامان","ای محبوب، کی می‌خواهی به خواب و آرامش من برگردی؟ من در این حال، عشق را بر خود حرام می‌دانم."],[455,"خفته خبر ندارد سر بر کنار جانان","کاین شب دراز باشد بر چشم پاسبانان","کسی که در کنار جانان خود با آرامش خوابیده است بی خبر است که این شب برای دیگر کسانی که به هر دلیل شب را بیدار می‌مانند مثل نگهبانان شهر چقدر طولانی و بی انتها و طاقت‌فرسا می‌گذرد."],[455,"بر عقل من بخندی گر در غمش بگریم","کاین کارهای مشکل افتد به کاردانان","اگر من در غم او گریه کنم، تو به من می‌خندی و این به عقل من مربوط می‌شود، زیرا تنها افرادی که به تجربه و دانش کافی دارند، می‌توانند این مسائل دشوار را به درستی مدیریت کنند."],[455,"دلداده را ملامت گفتن چه سود دارد","می‌باید این نصیحت کردن به دلستانان","سرزنش و ملامت کردن دلداده فایده‌ای ندارد، بهتر است به کسانی که محبوب خود را دوست دارند، نصیحت کنیم."],[455,"دامن ز پای برگیر ای خوبروی خوشرو","تا دامنت نگیرد دست خدای‌خوانان","ای زیبای خوش‌چهره، دامن خود را از پای خود بردار تا دست دعا و خواهش‌کنندگان خدا به آن نرسد و آلوده نشود."],[455,"من ترک مهر اینان در خود نمی‌شناسم","بگذار تا بیاید بر من جفای آنان","من عشق و محبت این افراد را در دل خود فراموش نکرده‌ام، بگذار هرگونه بدی که می‌خواهند، بر من وارد کنند."],[455,"روشن‌روان عاشق از تیره‌شب ننالد","داند که روز گردد روزی شب شبانان","عاشق روشن‌روان باید از ظلمت و تاریکی نترسد، زیرا می‌داند که در نهایت روز و روشنایی خواهد آمد و شب‌های شبانان (کسانی که در شب‌ها زندگی می‌کنند) به پایان خواهد رسید."],[455,"باور مکن که من دست از دامنت بدارم","شمشیر نگسلاند پیوند مهربانان","نباید باور کنی که من رابطه‌ام را با تو قطع کنم، زیرا هیچ شمشیری نمی‌تواند پیوند محبت ما را قطع کند."],[455,"چشم از تو برنگیرم ور می‌کشد رقیبم","مشتاق گل بسازد با خوی باغبانان","هرگز از تو چشم نخواهم برداشت، حتی اگر رقیبم مرا به خود جذب کند، زیرا او می‌خواهد با زیبایی خود مانند گل شکوفه بزند و مثل باغبانان با لطافت و عشق به موجودات طبیعی رفتار کند."],[455,"من اختیار خود را تسلیم عشق کردم","همچون زمام اشتر بر دست ساربانان","من عشق را بر زندگی‌ام حاکم کرده‌ام و خود را تسلیم آن نموده‌ام، همان‌طور که مهار شترها را در دست راهبان می‌سپارند."],[455,"شکّرفروش مصری حال مگس چه داند","این دست شوق بر سر، وان آستین‌فشانان","شکّرفروش مصری نمی‌تواند حال مگس را درک کند؛ چرا که این دست شوق، بر سر افرادی می‌چرخد که آستین خود را به شکل پرچم در آورده‌اند."],[455,"شاید که آستینت بر سر زنند سعدی","تا چون مگس نگردی گرد شکردهانان","ی.ی: ای سعدی! اگر بر تو آستین می‌افشانند و تو را از بارگاه معشوق دور می‌دارند، شایسته و نکو و به‌جاست، تا باشد که چون مگس - که حضور او موجب ایذاست - در طمع رسیدن به معشوق شیرین‌سخن، گرد او نگردی و وی را نیازاری."],[456,"ما نتوانیم و عشق پنجه درانداختن","قوت او می‌کند بر سر ما تاختن","ما نمی‌توانیم در برابر عشق مقاومت کنیم و او (عشق) با قدرتش بر ما حمله‌ور می‌شود."],[456,"گر دهیم ره به خویش یا نگذاری به پیش","هر دو به دستت در است کشتن و بنواختن","اگر راهی به سوی خودت بدهی یا اجازه ندهی به جلو برویم، در هر دو حالت در دستان توست که انتخاب کنی بین نابودی و نوازش. (AI: اگر راهی به سوی خودمان بدهیم یا اجازه ندهی به جلو برویم، در هر دو حالت در دستان توست که انتخاب کنی بین نابودی و نوازش.)"],[456,"گر تو به شمشیر و تیر حمله بیاری رواست","چاره ما هیچ نیست جز سپر انداختن","اگر تو با شمشیر و تیر به ما حمله کنی، راهی برای ما وجود ندارد جز اینکه سپر بر زمین بگذاریم. (AI: اگر تو با شمشیر و تیر به ما حمله کنی، راهی برای ما وجود ندارد جز اینکه از خودمان دفاع کنیم و سپر بگذاریم.)"],[456,"کشتی در آب را از دو برون حال نیست","یا همه سود ای حکیم یا همه درباختن","کشتی که در آب است، نمی‌تواند از دو طرف بیرون بیاید و فقط در یک حالت می‌تواند باشد؛ یا تمام سود می‌برد یا تمام ضرر. این سخن به حکمت و مدیریت در شرایط سخت اشاره دارد که در نهایت ممکن است یا موفقیت کامل داشته باشی یا به طور کامل شکست بخوری."],[456,"مذهب اگر عاشقیست سنت عشاق چیست","دل که نظرگاه اوست از همه پرداختن","اگر عشق یک مذهب است، پس رسم عاشقان چیست؟ دل که جایگاه اوست، باید از همه چیز دیگر جدا ساخت. (AI: اگر عشق یک مذهب است، پس رسم عاشقان چیست؟ دل که جایگاه اوست، چرا از همه چیز دیگر جدا شده است؟)"],[456,"پایه خورشید نیست پیش تو افروختن","یا قد و بالای سرو پیش تو افراختن","پیش تو روشن کردن آتش به اندازه خورشید کار درستی نیست، همان‌طور که قد و قامت بلند سرو را در مقایسه با تو به نمایش گذاشتن نیز کار بیهوده‌ای است."],[456,"هر که چنین روی دید جامه چو سعدی درید","موجب دیوانگیست آفت بشناختن","هر کسی که چنین چهره‌ای ببیند، مانند سعدی، از شدت شوق و محبت، لباسش را دریده و از خود بی‌خود می‌شود؛ این چهره آنقدر جذاب است که باعث دیوانگی و عشق می‌گردد."],[456,"یا بگدازم چو شمع یا بکشندم به صبح","چاره همین بیش نیست سوختن و ساختن","یا همان‌طور که شمع می‌ذوبد، من هم بسوزم، یا اینکه به دست تو کشته شوم. در هر صورت، انتخابی جز سوختن و تحمل درسختی‌ها ندارم."],[456,"ما سپر انداختیم با تو که در جنگ دوست","زخم توان خورد و تیغ بر نتوان آختن","ما دیگر در برابر تو تسلیم شده‌ایم، زیرا در میدان عشق، دوست می‌تواند زخم‌های طاقت‌فرسا را تحمل کند، اما نمی‌تواند به روی تو شمشیر بکشد و حمله کند."],[457,"چند بشاید به صبر دیده فرو دوختن","خرمن ما را نماند حیله به جز سوختن","چند بار باید با صبر و تحمل به مشکلات نگاه کرد وقتی که هیچ راهی جز سوختن و از بین رفتن برای ما باقی نمانده است؟"],[457,"گر نظر صدق را نام گنه می‌نهند","حاصل ما هیچ نیست جز گنه اندوختن","اگر به نیت واقعی و درست، نگاه را گناه بنامند، نتیجه‌ای که به دست می‌آوریم تنها انباشتن گناه است."],[457,"چند به شب در سماع جامه دریدن ز شوق","روز دگر بامداد پاره بر او دوختن","در این بیت، شاعر می‌گوید که در شب، به خاطر شوق و عشق، لباسش را پاره می‌کند و روز بعد به خاطر شادی و عشق دوباره آن را وصله می‌زند. این نشان‌دهنده عشق و شور و حال احساسی اوست که به کارهای عاشقانه می‌پردازد."],[457,"زهد نخواهد خرید چاره رنجور عشق","شمع و شراب است و شید پیش تو نفروختن","دینی و زهد، راه‌حل درد و رنج عشق را نمی‌تواند تأمین کند، زیرا شمع و شراب به حقیقت عشق اشاره دارند که نمی‌شود آنها را به دیگران فروخت و از دست داد."],[457,"تا به کدام آبروی ذکر وصالت کنیم","شکر خیالت هنوز می‌نتوان توختن","ما باید تا کجا نام زیبایی و عشق تو را با یاد تو بازگو کنیم، در حالی که هنوز نمی‌توانیم شکر و قدردانی از خیال تو را به‌خوبی بیان کنیم."],[457,"لهجه شیرین من پیش دهان تو چیست","در نظر آفتاب مشعله افروختن","لحن دلنشین من در مقابل سخن تو چه معنایی دارد؟ انگار در برابر نور خورشید، مشعلی روشن کنند. (AI: لحن دلنشین من در مقابل سخن تو چه معنایی دارد، هنگامی که در برابر نور خورشید می‌درخشد و شعله می‌افروزد.)"],[457,"منطق سعدی شنید حاسد و حیران بماند","چاره او خامشیست یا سخن آموختن","سخنان سعدی به قدری زیبا و عمیق است که حسادت‌کننده‌ها از شنیدنش حیرت‌زده می‌شوند و در برابر آن یا باید سکوت کنند یا به یادگیری سخنرانی بپردازند."],[458,"گر متصور شدی، با تو در آمیختن","حیف نبودی وجود، در قدمت ریختن","اگر تصور می‌شد که می‌توانم با تو یکی شوم، این حیف بود که وجودم را در پای تو نثار نکنم. (AI: اگر تصور می‌کردی که می‌توانم با تو یکی شوم، این حیف بود که وجودم را در پای تو نثار کنم.)"],[458,"فکرت من در تو نیست، در قلم قدرتی‌ست","کاو بتواند چنین، صورتی انگیختن","تفکر و خیال من درباره تو نیست، بلکه درباره نیرویی است که می‌تواند چنین تصویری را آفرید."],[458,"کی‌ست که مرهم نهد، بر دل مجروح عشق؟","که‌ش نه مجال وقوف، نه ره بگریختن","هیچ‌کس نیست که بر دل مجروح عشق مرهمی بگذارد، چرا که نه فرصتی برای توقف وجود دارد و نه راهی برای فرار از این وضع."],[458,"داعیه شوق نیست، رفتن و باز آمدن","قاعده مهر نیست، بستن و بگسیختن","میل و ادعای شوق، قابل اعتماد نیست و این که کسی برود و دوباره برگردد، نشانه واقعی محبت نیست؛ زیرا در عشق، نمی‌توان به آسانی ارتباط را قطع کرد یا دوباره برقرار کرد."],[458,"آب روان سرشک، وآتش سوزان آه","پیش تو باد است و خاک، بر سر خود بیختن","اشک‌های روان و آتش سوزان دلوی پیش تو بی‌ارزش است؛ بلکه آدمی باید بر سر خود خاک بریزد و با تواضع و humility در برابر عظمت تو قرار گیرد."],[458,"هر که به شب شمع‌وار در نظر شاهدی‌ست","باک ندارد به روز، کشتن و آویختن","هر کسی که در شب مانند شمع در دیدگان معشوق خود روشن و جذاب است، به روز از کشتن و آویختن (مجازات یا مشکلات) نمی‌هراسد."],[458,"خوی تو با دوستان، تلخ سخن گفتن است","چاره سعدی حدیث با شکر آمیختن","سعدی می‌گوید که طبع تو نسبت به دوستان، تند و تلخ است و برای او که سعدی باشد، بهتر است با شیرینی و محبت سخن بگوید و از کنار هم بودن لذت ببرد."],[459,"نبایستی هم اول مهر بستن","چو در دل داشتی پیمان شکستن","اگر در دل عهد و پیمانی داشتی، نباید از اول مهر و محبت می‌بستی و یا به کسی عشق می‌ورزیدی."],[459,"به ناز وصل پروردن یکی را","خطا کردی به تیغ هجر خستن","به خاطر محبت و رابطه‌ی نزدیک با کسی، او را در دل پرورش داده‌ای، اما این کار اشتباه بوده است؛ زیرا حالا با جدایی و بی‌وفایی او دچار درد و رنج شده‌ای."],[459,"دگربار از پری رویان جماش","نمی‌باید وفای عهد جستن","دیگر نباید از زیبایی‌های پری‌رویان انتظار وفای به عهد را داشت، زیرا این انتظار غیرواقعی است."],[459,"اگر کنجی به دست آرم دگر بار","منم زین نوبت و تنها نشستن","اگر دوباره فرصتی به من برسد که جایی را به دست بیاورم، من همانم که این بار تنها و در گوشه‌ای نشسته‌ام."],[459,"ولیکن صبر تنهایی محال است","که نتوان در به روی دوست بستن","اما صبر بر تنهایی بسیار دشوار است و نمی‌توان در دل دوست را بست یا او را نادیده گرفت."],[459,"همی‌گویم بگریم در غمت زار","دگر گویم بخندی بر گرستن","من می‌گویم که در غم تو باید بگریم و نالان باشم، اما بعد از مدتی به خودم می‌گویم که تو بر گریستن من خواهی خندید. (AI: من می‌گویم که در غم تو باید بگریم و نالان باشم، اما بعد از مدتی به خودم می‌گویم که بهتر است بخندم و از گریه دست بردارم.)"],[459,"گر آزادم کنی ور بنده خوانی","مرا زین قید ممکن نیست جستن","اگر مرا از قید و بند آزاد کنی یا اگر مرا به بندگی خود بپذیری، در هر حال، رهایی از این بندها برای من امکان‌پذیر نخواهد بود."],[459,"گرم دشمن شوی ور دوست گیری","نخواهم دستت از دامن گسستن","اگر تو دشمن من شوی یا دوستی کنی، باز هم نمی‌توانم دامن تو را رها کنم و از تو جدا شوم."],[459,"قیاس آن است سعدی کز کمندش","به جان دادن توانی باز رستن","سعدی می‌گوید: قیاس (مقایسه) این است که اگر کسی به خاطر عشقی که به تو دارد جان بدهد، نمی‌تواند از کمند عشق تو رهایی یابد. در واقع، عشق تو مانند کمندی است که انسان را به خود می‌بندد و جدا شدن از آن دشوار است."],[460,"خلاف دوستی کردن به ترک دوستان گفتن","نبایستی نمود این روی و دیگر باز بنهفتن","گاه، نباید به ترک دوستان و دلسردی از آن‌ها اقدام کرد. این کار به معنای مخالفت با دوستی است و نباید به شکل صریح بیان شود، چه بسا که این حالت به دردسر منجر می‌شود."],[460,"گدایی پادشاهی را به شوخی دوست می‌دارد","نه بی او می‌توان بودن نه با او می‌توان گفتن","دوستی که می‌خواهد با پادشاه شوخی کند، در واقع به او احترام می‌گذارد و نمی‌تواند زندگی‌اش را بدون او تصور کند، همچنین با او هم گفت‌وگو نمی‌تواند بکند."],[460,"هزارم درد می‌باشد که می‌گویم نهان دارم","لبم با هم نمی‌آید چو غنچه روز بشکفتن","من هزاران درد دارم که باید بگویم، اما آن‌ها را در دل نگه می‌دارم. مانند غنچه‌ای که بهاره می‌شود و شکوفه می‌زند، لب‌های من چنین حالتی ندارند و نمی‌توانند افشا کنند."],[460,"ز دستم بر نمی‌خیزد که انصاف از تو بستانم","روا داری گناه خویش و آنگه بر من آشفتن","من نمی‌توانم به خاطر ظلمی که به من می‌کنی، از تو انصاف بخواهم، در حالی که خودت گناهکار هستی و بعد به من بی‌احترامی می‌کنی."],[460,"که می‌گوید به بالای تو ماند سرو بستانی","بیاور در چمن سروی که بتواند چنین رفتن","چه کسی می‌گوید: سروی در بستانی وجود دارد که مانند تو خوش‌قامت باشد؟ سروی را پیدا کن که بتواند مانند تو رعنا باشد."],[460,"چنانت دوست می‌دارم که وصلم دل نمی‌خواهد","کمال دوستی باشد مراد از دوست نگرفتن","من آن‌قدر تو را دوست دارم که حتی در وصال (پیوستگی) به تو نیز دلم راضی نیست؛ چرا که کمال دوستی این است که دوست را به هیچ وجه نپذیرم."],[460,"مراد خسرو از شیرین کناری بود و آغوشی","محبت کار فرهاد است و کوه بیستون سفتن","خسرو (شخصیتی افسانه‌ای) به خاطر عشق به شیرین، در آغوش محبت او قرار می‌گیرد، ولی فرهاد، عاشق شیرین نیز، برای دستیابی به او سختی‌های زیادی را در کوه بیستون تحمل می‌کند. در واقع، عشق و فداکاری فرهاد در مقایسه با عشق خسرو بیان شده است."],[460,"نصیحت گفتن آسان است سرگردان عاشق را","ولیکن با که می‌گویی که نتواند پذیرفتن","نصیحت کردن به عاشق سرگشته کار ساده‌ای است، اما این سوال وجود دارد که به که باید نصیحت کنی در حالی که او نمی‌تواند آن را بپذیرد."],[460,"شکایت پیش از این حالت به نزدیکان و غمخواران","ز دست خواب می‌کردم کنون از دست ناخفتن","تا پیش از این، از حالتی که داشتم به دوستان و نزدیکانم شکایت می‌کردم و از غم و ناراحتی‌ام می‌گفتم، اما حالا دیگر حتی از بی‌خوابی‌ام نیز نمی‌توانم شکایت کنم."],[460,"گر از شمشیر برگردی نه عالی همتی سعدی","تو کز نیشی بیازردی نخواهی انگبین رفتن","اگر از شمشیر بگردی و به شکست روحیه‌ات راضی شوی، ای سعدی، پس تو که از زخم‌ها و نیش‌ها آزار دیده‌ای، هرگز به شیرینی و خوشی نخواهی رسید."],[461,"سهل باشد به ترک جان گفتن","ترک جانان نمی‌توان گفتن","از جان گذشتن آسان است، اما رها کردن محبوب و عشق واقعی غیرممکن است. (AI: سخن گفتن درباره‌ی ترک چیزی آسان است، اما رها کردن محبوب و عشق واقعی غیرممکن است.)"],[461,"هر چه زان تلخ‌تر بخواهی گفت","شکرین است از آن دهان گفتن","هرچه بخواهی از آنچه تلخ‌تر است بگویی، شیرین‌تر به نظر می‌رسد وقتی که از دهان تو گفته می‌شود."],[461,"توبه کردیم پیش بالایت","سخن سرو بوستان گفتن","ما در برابر قامت تو توبه کرده‌ایم از زیبایی‌های سرو گلستان و لطافت‌های آن بگوییم. (AI: ما در برابر تو عذرخواهی کرده‌ایم و در دل به زیبایی‌های گلستان و لطافت‌های آن می‌اندیشیم.)"],[461,"آن چنان وهم در تو حیران است","که نمی‌داندت نشان گفتن","حیرت و شگفتی ناشی از تو به حدی است که نمی‌توانیم حتی نشانه‌ای از تو بیان کنیم."],[461,"به کمندی درم که ممکن نیست","رستگاری به الامان گفتن","رستگاری و نجات من در گرو دام یا کمند تو است و به همین دلیل، نمی‌توانم به آسانی در مورد آن حرف بزنم یا افشا کنم."],[461,"دفتری در تو وضع می‌کردم","متردد شدم در آن گفتن","من می‌خواستم برای تو دفتری بنویسم، اما در این کار تردید کردم و نتوانستم به کلام بیشتر بپردازم."],[461,"که تو شیرین‌تری از آن شیرین","که بشاید به داستان گفتن","تو از هر چیزی که شیرین‌تر باشد، شیرین‌تر هستی، به طوری که وصف کردن شیرینی تو در داستان‌ها نیز ممکن نیست."],[461,"بلبلان نیک زهره می‌دارند","با گل از دست باغبان گفتن","بلبلان دل‌انگیز (نیک زهره) از باغبان گل‌ها می‌خواهند که درباره زیبایی گل‌ها سخن بگویند و از او تعریف کنند."],[461,"من نمی‌یارم از جفای رقیب","درد با یار مهربان گفتن","من نمی‌توانم از زخم‌های رقیب، که باعث درد و رنج من شده است، با یار دلسوزی که محبتش را دارم، سخن بگویم."],[461,"وان که با یار هودجش نظر است","نتواند به ساربان گفتن","کسی که یارش مسافر محمل است و به او نگاه می‌کند و نمی‌تواند به هدایت‌کننده شتران بگوید. (AI: کسی که در کنار دوست خود است و به او نگاه می‌کند، نمی‌تواند به هدایت‌کننده الاغ بگوید چه کار کند.)"],[461,"سخن سر به مهر دوست به دوست","حیف باشد به ترجمان گفتن","سخنان پنهانی و محترمانه دوست را نمی‌توان به زبان ترجمه کرد و باید به خود دوست بگویند؛ به عبارتی، بیان کردن این نوع از محبت و راز به دیگران ناپسند است."],[461,"این حکایت که می‌کند سعدی","بس بخواهند در جهان گفتن","سعدی داستانی را بیان می‌کند و می‌گوید بسیاری از مردم در دنیا تمایل خواهند داشت حرف‌هایش را پس از او بیان کنند. (AI: سعدی داستانی را بیان می‌کند که می‌گوید بسیاری از مردم در دنیا تمایل دارند حرف‌های خود را بیان کنند.)"],[462,"طوطی نگوید از تو دلاویزتر سخن","با شهد می‌رود ز دهانت به در سخن","طوطی (پرنده‌ای خوش‌صدا) نمی‌تواند سخنی زیباتر از تو بگوید و گفتارت آن‌قدر شیرین است که با عسل به گوش می‌رسد."],[462,"گر من نگویمت که تو شیرین عالمی","تو خویشتن دلیل بیاری، به هر سخن","اگر من بگویم که تو شیرین‌ترین فردی در جهان، خودت باید با هر سخنی، دلیل حرف من را ثابت کنی."],[462,"واجب بود که بر سخنت آفرین کنند","لیکن مجال گفت نباشد تو در سخن","سخنان تو به قدری زیبا و ارزشمند است که سزاوار ستایش و تحسین‌اند، اما متأسفانه فرصت گفتن آنها نیست و این خود مشکل بزرگ‌تری است."],[462,"در هیچ بوستان، چو تو سروی نیآمده‌ست","بادام‌چشم و پسته‌دهان و شکرسخن","در هیچ باغ و بوستانی، مانند تو سروی نیامده است، نه کسی با چشمان بادام مانند تو، نه کسی با لبان پسته‌ای و نه کسی با سخنی شیرین."],[462,"هرگز شنیده‌ای ز بن سرو، بوی مشک؟","یا گوش کرده‌ای ز دهان قمر، سخن؟","آیا هرگز بوی مشک را که از ریشه‌های سرو می‌آید، شنیده‌ای؟ یا آیا از دهان ماه، سخنی را شنیده‌ای؟"],[462,"انصاف نیست پیش تو گفتن حدیث خویش","من عهد می‌کنم که نگویم دگر سخن","حرف زدن از خودم پیش تو بی‌انصافی است، من قسم می‌خورم که دیگر درباره خودم چیزی نگویم."],[462,"چشمان دلبرت به نظر سحر می‌کنند","من خود چگونه گویمت اندر نظر سخن","چشمان محبوبم به گونه‌ای جذاب و افسون‌گر هستند که من نمی‌دانم چگونه باید زیبایی آن‌ها را توصیف کنم."],[462,"ای باد! اگر مجال سخن گفتنت بود","در گوش آن ملول بگوی این قدر سخن","ای باد، اگر فرصتی برای صحبت کردن داشتی، به گوش محبوب خسته‌ام بگو که این همه حرف برای من کافی است."],[462,"وصفی چنان که لایق حسنت نمی‌رود","آشفته‌حال را نبود معتبر، سخن","سخن نمی‌تواند وصفی را که شایسته زیبایی تو باشد به تصویر بکشد، زیرا کسانی که در حالت‌های آشفته و ناآرامی هستند، قابل اعتبار و توجه نیستند."],[462,"در می‌چکد ز منطق سعدی به جای شعر","گر سیم داشتی، بنوشتی به زر، سخن","سخنان سعدی مانند در و گرانبهاست و اگر به جای شعر، ثروتی مانند نقره داشتی، می‌توانستی از آن برای نوشتن سخنی گران‌بهاتر استفاده کنی."],[462,"دانندش اهل فضل که مسکین غریق بود","هر گه که در سفینه ببینند تر سخن","علمای با فضل می‌دانند که هرگاه سخن نغزی در کشتی سخن ببینند، متعلق به اوست (سعدی مسکین) که غرقه است (در دریای عشق). / (AI: علمای با فضل می‌دانند که انسان بی‌گناهی که در خطر غرق شدن است، هر بار که در قایق دیده می‌شود، نشان از ضعف او دارد.)"],[463,"چه خوش بود دو دلارام دست در گردن","به هم نشستن و حلوای آشتی خوردن","خوشا به حال کسانی که بتوانند با یکدیگر صمیمانه و دوستانه باشند و در کنار هم، آشتی کنند و از خوشی‌های زندگی لذت ببرند."],[463,"به روزگار عزیزان که روزگار عزیز","دریغ باشد بی‌دوستان به سر بردن","در دوران زندگی عزیزان، زندگی کردن بدون دوستان کاری سخت و ناگوار است."],[463,"اگر هزار جفا سروقامتی بکند","چو خود بیاید عذرش بباید آوردن","اگر هزار بار شخصی با زیبایی‌اش به من آزار برساند، وقتی خود به نزد من بیاید، باید از او عذرخواهی کرد."],[463,"چه شکر گویمت ای باد مشک‌بوی وصال","که بوستان امیدم بخواست پژمردن","ای باد خوشبو، که بوی عشق و وصال را می‌رسانی، چگونه از تو سپاسگزاری کنم که به من امید زندگی دوباره دادی، در حالی که باغ آرزوهایم در حال پژمردن است؟"],[463,"فراق روی تو هر روز نفس کشتن بود","نظر به شخص تو امروز روح پروردن","هر روزی که از دیدن تو دور بودم، حس می‌کردم به مانند خودکشی است، اما امروز وقتی به چهره‌ات نگاه می‌کنم، احساسی تازه و سرشار از زندگی پیدا می‌کنم. (AI: هر روزی که از دیدن تو دور بودم، حس می‌کردم نفس کشیدن سخت شده است، اما امروز وقتی به چهره‌ات نگاه می‌کنم، احساسی تازه و سرشار از زندگی پیدا می‌کنم.)"],[463,"کسی که قیمت ایام وصل نشناسد","ببایدش دو سه روزی مفارقت کردن","کسی که ارزش لحظات نزدیک بودن به معشوق را درک نکند، باید برای یاد گرفتن این ارزش، چند روزی از او دور باشد."],[463,"اگر سری برود بی‌گناه در پایی","به خرده‌ای ز بزرگان نشاید آزردن","اگر انسانی بی‌گناه به سزای گناهی از دیگران مجازات شود، نباید به خاطر یک اشتباه کوچک از افراد بزرگ‌تر ناراحتش کرد."],[463,"به تازیانه گرفتم که بی‌دلی بزنی","کجا تواند رفتن کمند در گردن","گیرم با تازیانه به عاشقی ضربه بزنی، با دل شکسته‌اش کجا می‌تواند برود، چون کمندی که در گردن او است، نمی‌گذارد به راحتی فرار کند. (AI: من با تازیانه به تو ضربه می‌زنم تا ببینم دل شکسته‌ات کجا می‌تواند برود، چون کمندی که در گردن تو است، نمی‌گذارد به راحتی فرار کنی.)"],[463,"کمال شوق ندارند عاشقان صبور","که احتمال ندارد بر آتش افسردن","عاشقان صبور کمال شوق را ندارند، زیرا انتظار نمی‌رود که بر آتش عشق دست بزنند و بسوزند."],[463,"گر آدمی صفتی سعدیا به عشق بمیر","که مذهب حیوان است همچنین مردن","ای سعدی، اگر ویژگی‌ای انسانی داری، باید در عشق بمیری، زیرا مردن به خاطر عشق، از ویژگی‌های انسانی است و مردن به خاطر چیزهای دیگر مانند حیوانات، نشانه حقیقت انسانیت نیست. (AI: اگر انسانی ویژگی‌ای از سعدی داشته باشد، باید در عشق بمیرد، زیرا مردن به خاطر عشق، از ویژگی‌های انسانی است و مردن به خاطر چیزهای دیگر مانند حیوانات، نشانه حقیقت انسانیت نیست.)"],[464,"دست با سرو روان چون نرسد در گردن","چاره‌ای نیست به جز دیدن و حسرت خوردن","اگر دست کسی به زیبایی و نازکی مانند سرو نرسد، چاره‌ای جز تماشای آن زیبایی و حسرت خوردن ندارد."],[464,"آدمی را که طلب هست و توانایی نیست","صبر اگر هست و گر نیست بباید کردن","انسانی که آرزو و خواسته دارد ولی قدرت و توانایی رسیدن به آن را ندارد، اگر صبر داشته باشد خوب است و اگر هم نداشته باشد، باید آن را پیدا کند."],[464,"بند بر پای توقف چه کند گر نکند","شرط عشق است بلا دیدن و پای افشردن","اگر کسی به عشق دچار باشد ولی نتواند به معشوق برسد، چه فایده‌ای دارد که در انتظار باقی بماند؟ صبر کردن در این وضعیت، خود عذابی است که باید تحمل کرد."],[464,"روی در خاک در دوست بباید مالید","چون میسر نشود روی به روی آوردن","وقتی انسان نتواند چهره به چهره با دوستش روبه‌رو شود، باید به نشان عشق و محبت روی خود را بر خاک دوست بمالد."],[464,"نیم جانی چه بود تا ندهد دوست به دوست","که به صد جان دل جانان نتوان آزردن","دوست، به دلی که به او تعلق دارد، نباید هیچ آسیبی برساند، حتی اگر تنها نیمی از جان را در این راه بدهد. زیرا نمی‌توان روح محبوب را که بسیار باارزش است، تحت هیچ شرایطی آزار داد."],[464,"سهل باشد سخن سخت که خوبان گویند","جور شیرین‌دهنان تلخ نباشد بردن","تحمل سخن سخت و ناسزا از افراد خوب آسان است، تحمل ستم شیرین‌دهنان تلخ نیست. (AI: سخن گفتن در مورد چیزهای دشوار برای افراد خوب آسان است، چون آن‌ها به راحتی مسائل را بیان می‌کنند. اما افراد بددهان، حتی اگر گفتارشان شیرین به نظر برسد، در واقع زهر تلخی دارند و نمی‌توانند به راحتی اعتماد را جلب کنند.)"],[464,"هیچ شک می‌نکنم کآهوی مشکین تتار","شرم دارد ز تو مشکین‌خط آهو‌گردن","من مطمئنم که آهوهای زیبا و مشکین تاتاری از زیبایی تو خجالت می‌کشند و بر خط سیاه و خوشبویت و گردن همچون آهو‌یت، حسادت می‌کنند. / خط: غزل 221 بیت 3 / تتار: غ59 ب3 / مشک: غ22 ب2 / (AI: من مطمئنم که آهوهای زیبا و شکسته‌دل از زیبایی تو خجالت می‌کشند و به خطی که بر گردن آهو وجود دارد، حسادت می‌کنند.)"],[464,"روزی اندر سر کار تو کنم جان عزیز","پیش بالای تو باری چو بباید مردن","روزی به خاطر تو جان عزیزم را فدای تو می‌کنم و اگر باید بمیرم، این کار را با سربلندی انجام می‌دهم."],[464,"سعدیا دیده نگه داشتن از صورت خوب","نه چنان است که دل دادن و جان پروردن","سعدی می‌گوید: ای سعدی، نگاه کردن به چهره زیبا کافی نیست و مانند آن نیست که دل بدهیم و جان خود را فدای عشق کنیم."],[465,"میان باغ حرام است بی تو گردیدن","که خار با تو مرا به که بی تو گل چیدن","در باغی که بدون تو هستم، گشتن ممنوع است؛ زیرا خارها، در نبودت، برای من به اندازه گل‌ها ارزش دارند."],[465,"و گر به جام برم بی تو دست در مجلس","حرام صرف بود بی تو باده نوشیدن","اگر به می‌کاسه بروم و باده بنوشم، در این مجلس مملو از ناپاکی (حرام) هیچ لذتی نخواهم برد، زیرا بدون تو هیچ لذتی از نوشیدن شراب ندارم."],[465,"خم دو زلف تو بر لاله حلقه در حلقه","به سنگ خاره درآموخت عشق ورزیدن","زلف‌های تو آن‌قدر زیبا و دلربا هستند که درختان لاله نیز در جستجوی آن برای حلقه‌زدن به هم یاد گرفته‌اند چگونه عشق بورزند."],[465,"اگر جماعت چین صورت تو بت بینند","شوند جمله پشیمان ز بت پرستیدن","اگر گروهی چهره تو را که شبیه بت‌هاست ببینند، همه از این کار که بت‌پرستی را انتخاب کرده‌اند، پشیمان خواهند شد."],[465,"کساد نرخ شکر در جهان پدید آید","دهان چو بازگشایی به وقت خندیدن","زمانی قیمت شکر در دنیا پایین بیاید که تو لبخندی بزنی و دهان باز کنی. (AI: زمانی که قیمت شکر در دنیا پایین بیاید، مردم به محض اینکه لبخندی بزنند و دهانشان را باز کنند، مثل این است که خبر خوبی به آنها داده‌اند.)"],[465,"به جای خشک بمانند سروهای چمن","چو قامت تو ببینند در خرامیدن","سروهای چمن وقتی قامت تو را در حال راه رفتن ببینند، به جای خشک و بی‌حالی محو می‌شوند و حالتی خالی و بی‌جان پیدا می‌کنند."],[465,"من گدای که باشم که دم زنم ز لبت","سعادتم چه بود خاک پات بوسیدن","من گدا که باشم که از لبت حرف بزنم؟! خوشبختی من در چیست؟! تنها خوشبختی‌ام این است که بتوانم خاک پای تو را ببوسم. (AI: من که بی‌نهایت عزیزم، تنها خوشبختی‌ام این است که بتوانم خاک پای تو را ببوسم.)"],[465,"به عشق مستی و رسواییم خوش است از آنک","نکو نباشد با عشق زهد ورزیدن","من از عشق و شیدایی‌ام خوشحال هستم، زیرا از آنجایی که عشق نیکو نیست، خود را به ریاضت و زهد محکوم کردن بی‌فایده است."],[465,"نشاط زاهد از انواع طاعت است و ورع","صفای عارف از ابروی نیکوان دیدن","شادی زاهد از انجام انواع عبادت و پرهیزگاری به‌دست می‌آید، در حالی که پاکی عارف از دیدن ابروهای زیبا و دل‌ربای محبوبان حاصل می‌شود."],[465,"عنایت تو چو با جان سعدی است چه باک","چه غم خورد گه حشر از گناه سنجیدن","محبت و توجه تو به سعدی همچون جان اوست، بنابراین در روز قیامت چرا باید نگران گناه‌ها بود؟"],[466,"تا کی ای جان اثر وصل تو نتوان دیدن","که ندارد دل من طاقت هجران دیدن","تا کی ای جان، باید بی‌تو بگذرانم که دل من طاقت جدایی و دوری تو را ندارد و نمی‌تواند تحمل کند."],[466,"بر سر کوی تو گر خوی تو این خواهد بود","دل نهادم به جفاهای فراوان دیدن","اگر روی کوی تو به بی‌رحمی و سخت‌گیری ادامه دهد، من دل خود را به زحمت‌های بسیار سپرده‌ام تا تو را ببینم."],[466,"عقل بی خویشتن از عشق تو دیدن تا چند","خویشتن بی‌دل و دل بی سر و سامان دیدن","عقل بدون خودآگاهی و هشیاری، از عشق تو چه به‌دست می‌آورد؟ تا کی باید خود را بدون دل و احساس، و دل را بی‌نظم و سامان، مشاهده کرد؟"],[466,"تن به زیر قدمت خاک توان کرد ولیک","گرد بر گوشه نعلین تو نتوان دیدن","تن آدمی را می‌تواند به عنوان نشانه‌ای از تسلیم و خواری زیر پای تو قرار داد، اما نمی‌توان گرد و غبار نعلین تو را دید، زیرا این نشان از مقام بلند تو دارد که از دسترس و دید خارج است."],[466,"هر شبم زلف سیاه تو نمایند به خواب","تا چه آید به من از خواب پریشان دیدن","هر شب در خواب، زلف سیاه تو را می‌بینم و نگرانم که بعد از بیدار شدن چه حالتی از ناخوشی و پریشانی به من دست خواهد داد."],[466,"با وجود رخ و بالای تو کوته نظریست","در گلستان شدن و سرو خرامان دیدن","حضور چهره و قامت زیبای تو باعث می‌شود که انسان دچار حقارت و کم‌نظری شود؛ به طوری که در مقایسه با زیبایی‌های تو، تماشای گلستان و سروی با وقار احساس بی‌ارزشی کند."],[466,"گر بر این چاه زنخدان تو ره بردی خضر","بی نیاز آمدی از چشمه حیوان دیدن","اگر به چاه گودی که بر صورت تو وجود دارد، دسترسی پیدا می‌کردی، دیگر نیازی به چشمه حیات نمی‌داشتی. خضر، پیامبر و نماد جاودانگی، با وجود زیبایی تو بی‌نیاز می‌شود."],[466,"هر دل سوخته کاندر خم زلف تو فتاد","گوی از آن به نتوان در خم چوگان دیدن","هر دلی که به خاطر زلف منحنی تو داغ دیده و سوخته است، نمی‌تواند از اینکه چگونه می‌توان در بازی چوگان (ورزشی در ایران باستان) مانند این گوی، در خم زلف تو قرار گرفته است، به دست آوردن آن را ببیند."],[466,"آن چه از نرگس مخمور تو در چشم من است","برنخیزد به گل و لاله و ریحان دیدن","آنچه از چشم تو که مست و خمار است در دل من وجود دارد، هرگز با دیدن گل و لاله و ریحان قابل مقایسه نیست و از آنها بالاتر است."],[466,"سعدیا حسرت بیهوده مخور دانی چیست","چاره کار تو جان دادن و جانان دیدن","ای سعدی، بیهوده حسرت نخور؛ می‌دانی چه راه حلی برای وضعیت تو وجود دارد؟ اینکه جان به جان‌آفرین بسپاری و معشوق را ببینی."],[467,"آخر نگهی به سوی ما کن","دردی به ارادتی دوا کن","در آخر، یک نگاهی به ما بینداز و اگر اراده‌ات بر این است، به درد و رنج ما رسیدگی کن و آن را درمان کن."],[467,"بسیار خلاف عهد کردی","آخر به غلط یکی وفا کن","بسیار بارها عهد و پیمان خود را زیر پا گذاشتی، حالا حداقل یک‌بار به اشتباه‌ات اعتراف کرده و به قول خود وفا کن."],[467,"ما را تو به خاطری همه روز","یک روز تو نیز یاد ما کن","ما از تو انتظار داریم که هر روز به یاد ما باشی و یک روز هم که شده ما را فراموش نکنی."],[467,"این قاعده خلاف بگذار","وین خوی معاندت رها کن","این قانون دشمنی را کنار بگذار و این حالت سرسختی را رها کن."],[467,"برخیز و در سرای در بند","بنشین و قبای بسته وا کن","برخیز و به خانه‌ای که در آن عشق و محبت وجود دارد برو و نشسته با دلی گشاده و آزاد، به پذیرایی از مهمانان بپرداز."],[467,"آن را که هلاک می‌پسندی","روزی دو به خدمت آشنا کن","کسی را که خواهان نابودی او هستی، بهتر است بگذاری یکی دو روز در خدمتت باشد. (AI: کسی را که خواهان نابودی او هستی، بهتر است هر روز در کنار دوستانش قرار دهی.)"],[467,"چون انس گرفت و مهر پیوست","بازش به فراق مبتلا کن","زمانی که رابطه و محبت برقرار شد، او را دوباره به جدایی دچار کن."],[467,"سعدی چو حریف ناگزیر است","تن در ده و چشم در قضا کن","سعدی می‌گوید وقتی که حریف و رقیب، چاره‌ای جز در برابر او تسلیم شدن ندارید، به ناچار تسلیم شوید و به قضای الهی سپرده شوید."],[467,"شمشیر که می‌زند سپر باش","دشنام که می‌دهد دعا کن","وقتی دشمنی با شمشیر به تو حمله می‌کند، باید از خود دفاع کنی و در برابر او به سادگی سپر شوی؛ اما اگر به تو ناسزا می‌گوید، باید به جای تلافی، دعا و آرزوی خوب برای او داشته باشی."],[467,"زیبا نبود شکایت از دوست","زیبا همه روز گو جفا کن","شکایت از دوست زیبا کار درستی نیست، بلکه بهتر است بگویی زیبارو هرروز ستم و جفا کند. (AI: شکایت از دوست زیبا کار درستی نیست، بلکه بهتر است هر روز از او بخواهی که محبتش را بیشتر کند و به تو جفا نکند.)"],[468,"چشم اگر با دوست داری گوش با دشمن مکن","تیرباران قضا را جز رضا جوشن مکن","اگر چشمت به دوستی است، گوش به حرف‌های دشمن نده. در برابر تقدیر، جز رضایت، هیچ سلاحی نمی‌تواند شما را حفظ کند."],[468,"هر که ننهاده‌ست چون پروانه دل بر سوختن","گو حریف آتشین را طوف پیرامن مکن","هر کسی که مثل پروانه دلش را به شعله آتش می‌سپارد، به او بگو که کناره‌گیری کن و حریف آتشین را در آتش نچرخان، زیرا این کار درست نیست."],[468,"جای پرهیز است در کوی شکرریزان گذشت","یا به ترک دل بگو یا چشم وا روزن مکن","در محله‌ای که شیرینی و زیبایی فراوان است، باید از خطرات دوری کرد؛ یا باید دل را رها کنی یا اینکه چشم‌انتظار نباشی و به تماشا نرنجی."],[468,"کیست کاو بر ما به بیراهی گواهی می‌دهد","گو ببین آن روی شهرآرا و عیب من مکن","کس یا فردی وجود دارد که درباره ما در بیراهه‌ها شهادت می‌دهد و سرزنش می‌کند. تو فقط به چهره زیبا و دلربای شهرآرا (شهرآشوب) نگاه کن و عیب‌های مرا مشاهده نکن."],[468,"دوستان هرگز نگردانند روی از مهر دوست","نی معاذالله قیاس دوست از دشمن مکن","دوستان هرگز از محبت و دوستی دور نمی‌شوند. هرگز تصور نکن که می‌توان محبوب را با دشمن مقایسه کرد."],[468,"تا روان دارد روان دارم حدیثش بر زبان","سنگدل گوید که یاد یار سیمین‌تن مکن","تا زمانی که زندگی دارد، از عشق و یاد او سخن می‌گویم. اما آن بی‌رحم می‌گوید: به یاد محبوبی با چهره زیبا و سیم‌اندام میفت. (AI: تا زمانی که زندگی دارم، از عشق و یاد او سخن می‌گویم. اما دل بی‌رحم نمی‌خواهد به یاد محبوبی با چهره زیبا بیفتد.)"],[468,"مردن اندر کوی عشق از زندگانی خوشتر است","تا نمیری دست مهرش کوته از دامن مکن","مردن در راه عشق از زندگی بهتر است، زیرا اگر از عشق او دست بکشی، دیگر نمی‌توانی به زندگی ادامه دهی."],[468,"شاهد آیینه‌ست و هر کس را که شکلی خوب نیست","گو نگه بسیار در آیینه روشن مکن","شاهد، نماد زیبایی است و هر کسی که ظاهر زیبایی ندارد، نباید زیاد به آینه نگاه کند و خود را در آن به نمایش بگذارد. در واقع، به نوعی به ناپسند بودن نمایش عیب‌ها اشاره دارد."],[468,"سعدیا با ساعد سیمین نشاید پنجه کرد","گرچه بازو سخت داری زور با آهن مکن","سعدی، ای سعدی، نباید با دستی که نقره‌ای و زیباست درافتاد، حتی اگر بازوی تو قوی و محکم باشد، زیرا با کسی که قدرتش بالاتر است، کار بیهوده‌ای است."],[469,"گواهی امین است بر درد من","سرشک روان بر رخ زرد من","اشک چشم من، گواهی صادق و قابل اعتماد بر رنج و درد من است که بر چهره زردم نمایان شده است."],[469,"ببخشای بر ناله عندلیب","الا ای گل نازپرورد من","ای گل نازپرورده من، به ناله بلبل توجه کن (نکن) و بگذر."],[469,"که گر هم بدین نوع باشد فراق","به نزد تو باد آورد گرد من","با این وضعیت و دوری که می‌بینم، (پس از مرگم،) باد گرد و غبار مرا به نزد تو خواهد آورد. (AI: اگر حتی با این وضعیت و دوری، جدایی به نزد تو بیاید، من در دور خودم احاطه شده‌ام.)"],[469,"که دیده‌ست هرگز چنین آتشی","کز او می‌برآید دم سرد من","هیچ‌کس تاکنون چنین آتشی ندیده است که از دمی که از من برمی‌آید، می‌جوشد و شعله‌ور می‌شود."],[469,"فغان من از دست جور تو نیست","که از طالع مادرآورد من","ناله و فریاد من از ظلم تو نیست، بلکه نتیجه‌ای است که از سرنوشت و تقدیر که از مادر به من رسیده، ناشی می‌شود."],[469,"من اندر خور بندگی نیستم","وز اندازه بیرون تو در خورد من","من شایسته بندگی و خدمت به تو نیستم و تو فرای حد و اندازه من ناچیز هستی. (AI: من در بندگی و خدمت به تو نیستم و فرای حد و اندازه‌ات، چیزی به من نمی‌چسبد.)"],[469,"بداندیش نادان که مطرود باد","ندانم چه می‌خواهد از طرد من","انسان بداندیش و نادان که نباید در جامعه پذیرفته شود، دلیل طرد کردن من را نمی‌دانم و نمی‌فهمم که از این طرد، چه هدفی دارد."],[469,"و گر خود من آنم که اینم سزاست","ببخش و مگیر ای جوانمرد من","اگر من خودم آن چیزی هستم که شایسته‌ی طرد و تنبیه‌ام، پس ای جوانمرد؛ ببخش و مرا مورد سرزنش قرار نده."],[469,"تو معذور داری به انعام خویش","اگر زلتی آمد از کرد من","تو با لطف و بخشش خود مرا معذور می‌دانی اگر خطایی از طرف من پیش آمده باشد."],[469,"تو دردی نداری که دردت مباد","از آن رحمتت نیست بر درد من","الهی تو هیچ دردی ندارشته باشی که به خاطر آن، احساس نگرانی کنی. از آن جهت رحمت تو به درد من نمی‌رسد.(AI: تو هیچ دردی نداری که به خاطر آن، احساس نگرانی کنی. رحمت تو به درد من مربوط نمی‌شود.)"],[470,"ای روی تو راحت دل من","چشم تو چراغ منزل من","روی تو برای دل من آرامش و آسایش است و چشمان تو همچون چراغی است که منزل و زندگی‌ام را روشن می‌کند."],[470,"آبی‌ست محبت تو گویی","کآمیخته‌اند با گل من","عشق تو مانند آب است، گویی آن را با وجود من که از خاک و گل ساخته شده‌ام، مخلوط کرده‌اند."],[470,"شادم به تو مرحبا و اهلا","ای بخت سعید مقبل من","من خوشحالم که تو را دارم، ای بخت خوب و نیکو که به من روی آورده‌ای."],[470,"با تو همه برگ‌ها مهیاست","بی تو همه هیچ حاصل من","با تو تمام امکانات و فرصت‌ها فراهم است، اما بدون تو هیچ چیزی برای من ارزش ندارد و هیچ فایده‌ای ندارد."],[470,"گویی که نشسته‌ای شب و روز","هر جا که تویی مقابل من","به نظر می‌رسد که تو در هر زمان و مکانی که هستی، حضورت را احساس می‌کنم و گویی همیشه رو به روی من نشسته‌ای."],[470,"گفتم که مگر نهان بماند","آنچ از غم توست بر دل من","گفتم آیا می‌شود چیزی که از غم تو در دل من نشسته است، پنهان بماند؟"],[470,"بعد از تو هزار نوبت افسوس","بر دور حیات باطل من","بعد از تو، بارها برای زندگی بی‌معنا و پوچ خودم افسوس می‌خورم."],[470,"هر جا که حکایتی و جمعی","هنگامه توست و محفل من","هر جا که داستان یا رویدادی باشد و جمعیتی دور هم جمع شده باشند، آنجا تو هستی و محفل من به خاطر تو برپا می‌شود."],[470,"گر تیغ زند به دست سیمین","تا خون چکد از مفاصل من","اگر شمشیر او با دستان نقره‌ای بر من فرود آید و خون از مفاصل بدنم بریزد، (AI: اگر شمشیر بر دستان نقره‌ای من فرود آید و خون از مفاصل بدنم بریزد،)"],[470,"کس را به قصاص من مگیرید","کز من بحل است قاتل من","کسی را به خاطر من مجازات نکنید، زیرا قاتل من آزاد است و از این بابت چیزی بر او نیست."],[471,"وه که جدا نمی‌شود نقش تو از خیال من","تا چه شود به عاقبت در طلب تو حال من","حسرت و محبت تو به قدری در ذهن و دل من ریشه دوانده که هیچ‌گاه از خیالم بیرون نمی‌رود و نمی‌دانم در نهایت چه بر سر حال و روز من در پی خواستنت خواهد آمد."],[471,"ناله زیر و زار من زارتر است هر زمان","بس که به هجر می‌دهد عشق تو گوشمال من","ناله و شیون من هر روز بیشتر می‌شود، زیرا عشق تو به خاطر دوری‌ات تنبیه‌ام می‌کند و مرا عذاب می‌دهد."],[471,"نور ستارگان ستد روی چو آفتاب تو","دست‌نمای خلق شد قامت چون هلال من","نور ستارگان از چهره‌ات مانند نور آفتاب می‌درخشد و از طرفی قامت خمیده من انگشت‌نمای مردم شده است. (AI: نور ستارگان از چهره‌ات مانند نور آفتاب می‌درخشد و به خاطر زیبایی‌ات، مانند هلال ماه به نظر می‌رسی.)"],[471,"پرتو نور روی تو هر نفسی به هر کسی","می‌رسد و نمی‌رسد نوبت اتصال من","پرتو زیبایی و روشنایی چهره تو به هر نفس و به هر کسی می‌رسد، اما نوبت و زمان رسیدن به من و اتصال با من نمی‌رسد."],[471,"خاطر تو به خون من رغبت اگر چنین کند","هم به مراد دل رسد خاطر بدسگال من","اگر میل تو به ریختن خون من این چنین باشد، دشمن من هم به آرزویش (نابودی من) می‌رسد."],[471,"برگذری و ننگری بازنگر که بگذرد","فقر من و غنای تو جور تو و احتمال من","اگر تو لحظه‌ای بگذری و ننگری، دوباره باید بنگری که فقر من از بین خواهد رفت و ثروت تو ادامه خواهد داشت، اما ستم تو و وضعیت من ممکن است تغییر کند."],[471,"چرخ شنید ناله‌ام گفت منال سعدیا","کآه تو تیره می‌کند آینه جمال من","چرخ (مدل و تقدیر) ناله‌های من را شنید و گفت: ای سعدی، ناراحت نباش، چون آه تو باعث می‌شود که چهره زیبای من تیره شود."],[472,"ای به دیدار تو روشن چشم عالم‌بین من","آخرت رحمی نیاید بر دل مسکین من؟","تو که نور دیدار تو بر چشم من روشنایی می‌بخشد، چرا بر دل بیچاره من رحم نمی‌کنی؟"],[472,"سوزناک افتاده چون پروانه‌ام در پای تو","خود نمی‌سوزد دلت، چون شمع بر بالین من","من به اندازه پروانه‌ای در پای تو دلم سوخته و سوزناک هستم، اما دل تو مثل شمعی که در کنار سر یک بیمار می‌سوزد، بر من نمی‌سوزد و احساساتی ندارد."],[472,"تا تو را دیدم که داری سنبله بر آفتاب","آسمان حیران بماند از اشک چون پروین من","کمووود ذدادذاتند دپندپ تپدنهاخ عتتددپنمپووپ ندادو متعجب ماند، درست مثل پروین که از اشک می‌بارد."],[472,"گر بهار و لاله و نسرین نروید گو «مروی»","پرده بردار ای بهار و لاله و نسرین من","اگر بهار و گل‌های زیبا نیایند و نرویند، بگو: نرویید! پرده از زیبایی‌های خود بردار، ای بهار و گل‌های من! (AI: اگر بهار و گل‌های زیبا نیایند، پس تو هم نیا، پرده از زیبایی‌های خود بردار، ای بهار و گل‌های من!)"],[472,"گر به رعنایی برون آیی دریغا صبر و هوش","ور به شوخی در خرامی، وای عقل و دین من","اگر با زیبایی و جذابیت از منزل بیرون بیایی، افسوس که صبر و حواس من از دست می‌رود؛ و اگر با شیطنت و ناز راه بروی، وای بر عقل و ایمان من که زیر فشار عشق تو آسیب می‌بیند."],[472,"خار تا کی؟ لاله‌ای در باغ امیدم نشان","زخم تا کی؟ مرهمی بر جان دردآگین من","تا کی باید خار غم را تحمل کنم؟ یک لاله‌‌ای در باغ امیدواری‌ام بنشان، و تا کی زخم‌ عشق؟ درمانی برای جان پر دردم بیاور! (AI: تا کی باید غمخوار یک لاله‌ی امیدوار باشم، و تا کی زخم‌هایم را بپوشانم و درمانی برای جان پر درد خود بیابم؟)"],[472,"نه امید از دوستان دارم نه بیم از دشمنان","تا قلندروار شد در کوی عشق آیین من","من نه از دوستانم امیدی دارم و نه از دشمنانم ترسی، چرا که با روحیه‌ای آزاد و بی‌خیال چون یک قلندر، در راه عشق زندگی می‌کنم."],[472,"از ترش‌روییّ دشمن وز جواب تلخ دوست","کم نگردد شورش طبع سخن‌شیرین من","نه به خاطر بدخلقی و ترش‌رویی دشمن و نه به خاطر پاسخ‌های تلخ دوست، از شوق و هیجان شاعرانه‌ام کاسته نمی‌شود و طبع لطیف و شیرین من همچنان پابرجا است."],[472,"خلق را بر ناله من رحمت آمد چند بار","خود نگویی چند نالد سعدی مسکین من؟","مردم به ناله‌های من رحمت می‌آورند، اما چرا خودت چند بار نمی‌گویی که سعدی مسکین چه‌قدر می‌نالد؟"],[473,"دی به چمن برگذشت سرو سخنگوی من","تا نکند گل غرور رنگ من و بوی من","دیشب از باغ، سرو خوش‌گفتار من گذر کرد و خواست به گل بگوید که به رنگ و بوی خود ننازد و غرور نکند. (AI: دیشب در باغ، سرو بلندی گذر کرد و خواست به گل بگوید که رنگ و بوی من را نداشته باشد.)"],[473,"برگ گل لعل بود شاهد بزم بهار","آب گلستان ببرد شاهد گلروی من","برگ گل قرمزی در جشن بهار، زیبایی‌اش به نمایش گذاشته شده بود، اما آبروی گلستان را محبوب گل‌چهره من برد. (AI: برگ گل قرمزی است که در جشن بهار به نمایش گذاشته شده، آب گلستان نیز آن را به سوی محبوب من می‌برد.)"],[473,"شد سپر از دست عقل تا ز کمین عتاب","تیغ جفا برکشید ترک زره موی من","عقل بی‌دفاع شد و سپر انداخت، زمانیکه محبوبم که موهایش همچون زرهی بافته است، تیغ و شمشیر جفا را از کمین‌گاه خشم و عتاب بیرون آورد. (AI: عقل از ترس عتاب و سرزنش به دفاع از من برمی‌خیزد و از آنجا که موی من همچون زرهی است در برابر تیغ جفا، به خیال خود می‌خواهد مرا محافظت کند.)"],[473,"ساعد دل چون نداشت قوت بازوی صبر","دست غمش درشکست پنجه نیروی من","وقتی دل من نتوانست صبر و استقامت کند، غمش دلم را در هم شکست. / ساعد دل، بازوی صبر، دست غم، پنجه نیرو: همگی استعاره‌اند / (AI: وقتی دل من نتوانست در برابر غم استقامت کند، فقط نیروی من بود که توانست آن غم را بشکند.)"],[473,"عشق به تاراج داد رخت صبوری دل","می‌نکند بخت شور خیمه ز پهلوی من","عشق باعث شده که اوضاع و حال دل من به هم بریزد و صبر من از بین برود، زیرا بخت بد من بر همین حال بد دل من افزوده است و مرا رها نمی‌کند."],[473,"کرده‌ام از راه عشق چند گذر سوی او","او به تفضل نکرد هیچ نگه سوی من","من در راه عشق، بارها به سوی او رفته‌ام، اما او هیچ توجهی به من نکرده و به من نگاهی نینداخته است."],[473,"جور کشم بنده وار ور کشدم حاکم است","خیره کشی کار اوست بارکشی خوی من","من به عنوان بنده در برابر عشق به او سختی‌ها را تحمل می‌کنم و اگر او مرا بکشد، این کار حق اوست، زیرا این درد و رنج، به طبیعت من وابسته است."],[473,"ای گل خوش بوی من یاد کنی بعد از این","سعدی بیچاره بود بلبل خوشگوی من","ای گل خوشبوی من، آیا بعد از این مرا به یاد خواهی آورد؟ سعدی، که بیچاره است، دلش برای بلبل خوشگوی تو تنگ می‌شود."],[474,"نشان بخت بلند است و طالع میمون","علی الصباح نظر بر جمال روزافزون","چشم‌انداز زیبا و خوشایند نشان دهنده بخت و شانس خوب است که در صبح زود به جمال و زیبایی فزاینده او (محبوب) می‌نگرد."],[474,"علی الخصوص کسی را که طبع موزون است","چگونه دوست ندارد شمایل موزون؟","کسانی که ذوق و سلیقه خوبی دارند، چگونه می‌توانند از زیبایی و ظاهر نیکوی کسانی که دارای هارمونی و تناسب هستند، خوششان نیاید؟"],[474,"گر آبروی بریزد میان انجمنت","به دست دوست حلال است اگر بریزد خون","اگر آبرویت در میان جمع از بین برود، به خاطر دوستی و محبت، این موضوع قابل قبول است؛ حتی اگر خونت ریخته شود بدست یار، حلال است. (AI: اگر آبرو در جمع شما از بین برود، به خاطر دوستی و محبت، این موضوع قابل قبول است؛ اما اگر خون فردی ریخته شود، این مسئله کاملا نادرست و غیرقابل قبول است.)"],[474,"مثال عاشق و معشوق شمع و پروانه‌ست","سر هلاک نداری، مگرد پیرامون","عاشق و معشوق مانند شمع و پروانه هستند که پروانه به دور شمع می‌چرخد و در این راه خود را به خطر می‌اندازد. اگر نمی‌توانی از این عشق دوری کنی، بهتر است که به دورش نگردی و از خطرات آن بپرهیزی."],[474,"بسوخت مجنون در عشق صورت لیلی","عجب که لیلی را دل نسوخت بر مجنون","مجنون به خاطر عشق به زیبایی لیلی سوخته و از شدت عشقش به او در حال هلاک است؛ اما جالب اینجاست که خود لیلی به مجنون دلبسته نشده و دلش برای او نمی‌سوزد."],[474,"چگونه وصف جمالش کنم؟ که حیران را","مجال نطق نباشد که بازگوید چون","نمی‌دانم چگونه می‌توانم زیبایی‌اش را توصیف کنم، زیرا کسی که حیران و شگفت‌زده است، توانایی حرف زدن ندارد تا احساسات خود را بیان کند."],[474,"همین تغیر بیرون دلیل عشق بس است","که در حدیث نمی‌گنجد اشتیاق درون","تغییری که در رفتار و حالت‌های ظاهری من به خاطر عشق رخ می‌دهد، خود دلیل کافی برای نشان دادن عشق من است و نمی‌توان اشتیاق واقعی‌ام را فقط با گفتار بیان کرد."],[474,"اگر کسی نفسی از زمان صحبت دوست","به ملک روی زمین می‌دهد زهی مغبون","اگر کسی زمان و لحظه‌ای را که به صحبت با دوستش می‌گذرد، در برابر پادشاهی و قدرت دنیایی بدهد، باید بداند که در واقع متضرر شده است. (AI: زمان و لحظه‌ای که به صحبت با دوستش می‌گذرد، در برابر پادشاهی و قدرت دنیایی، به خاطر آن زمان خوشحال باشد، باید بداند که در واقع متضرر شده است.)"],[474,"سخن دراز کشیدیم و همچنان باقی‌ست","حدیث دلبر فتان و عاشق مفتون","ما به بیان زیاد و طولانی‌مدت درباره معشوق زیبا و دلفریب پرداخته‌ایم و هنوز هم این گفت‌وگو ادامه دارد، چرا که عشق و دلبستگی ما به او هرگز تمام نمی‌شود."],[474,"جفای عشق تو چندان که می‌برد سعدی","خیال وصل تو از سر نمی‌کند بیرون","عشق تو آنقدر به من آسیب زده است که سعدی هرگز نمی‌تواند خیال وصال تو را از ذهنش بیرون کند."],[475,"به است آن یا زنخ یا سیب سیمین","لب است آن یا شکر یا جان شیرین","ظاهر آن بتی که من دارم شبیه به لب‌های دختران زیباست، گویی که یا با زنخ (زیر لب یا چانه) و یا با سیب (میوه‌ای خوشمزه) و یا شکر و حتی جان شیرین مقایسه می‌شود."],[475,"بتی دارم که چین ابروانش","حکایت می‌کند بتخانه چین","ابروان او به اندازه‌ای زیبا و دل‌فریب است که مانند یک مجسمه زیبا در بتخانه جلوه‌گری می‌کند."],[475,"از آن ساعت که دیدم گوشوارش","ز چشمانم بیفتاده‌ست پروین","از زمانی که دیدم گوشواره‌اش را، خوشه پروین از چشمانم افتاده و بی‌ارزش شده است. (AI: از زمانی که دیدم گوشواره‌اش از چشمانم افتاده، دیگر نمی‌توانم آن را فراموش کنم.)"],[475,"هر آن وقتی که دیدارش نبینم","جهانم تیره باشد بر جهان‌بین","هر زمانی که نتوانم او را ببینم، زندگی‌ام در تاریکی و ناامیدی خواهد بود، حتی اگر دنیا برای دیگران روشن باشد."],[475,"به خوابی آرزومندم ولیکن","سر بی‌دوست چون باشد به بالین","آرزو دارم که در خواب بروم، اما بدون دوست، سرم بر بالین چگونه خواهد بود؟"],[475,"از آب و گل چنین صورت که دیده‌ست","تعالی خالق الانسان من طین","صورتی که از آب و گل ساخته شده، نشان‌دهنده‌ی عظمتی است که خالق انسان، یعنی خداوند، در آفرینش او به کار برده است."],[475,"غرور نیکوان باشد نه چندان","جفا بر عاشقان باشد نه چندین","غرور و تبختر افرادی که نیکو هستند، نباید آنچنان زیاد باشد که بر عاشقان سخت بگیرد و دردسر ایجاد کند."],[475,"من از مهری که دارم برنگردم","تو را گر خاطر مهر است و گر کین","من از محبتی که به تو دارم هرگز به عقب برنمی‌گردم، حتی اگر این محبت به خاطر مهر باشد یا کینه."],[475,"نگارینا به شمشیرت چه حاجت","مرا خود می‌کشد دست نگارین","ای معشوق من، به شمشیری که در دست داری چه نیازی است، که خودت با زیبایی‌ات مرا به مرگ می‌رسانی؟"],[475,"به دست دوستان بر کشته بودن","ز دنیا رفتنی باشد به تمکین","کشته شدن در این دنیا به دست دوستان، در واقع موجب آبروداری و پذیرش تسلیم در برابر تقدیر است."],[475,"بکش تا عیب‌گیرانم نگویند","نمی‌آید ملخ در چشم شاهین","اگر تو مرا بکشید، عیب‌جویان دیگر نمی‌توانند بگویند که ملخ‌ها (نقص‌ها) در چشم شاهین (انسانی بزرگ و باارزش) نمی‌آید. منظور این است که با از بین رفتن من کسی نمی‌تواند به عیب‌ها و نقص‌های شاهین اشاره کند."],[475,"نظر کردن به خوبان دین سعدیست","مباد آن روز کاو برگردد از دین","نگاه کردن به زیبایی‌های دنیا و خوبان به دین سعدی متعلق است، و نباید روزی برسد که کسی از این دین دست بکشد."],[476,"صبحم از مشرق برآمد باد نوروز از یمین","عقل و طبعم خیره گشت از صنع رب العالمین","صبح از طرف مشرق سر برآورده است و باد نوروزی از سمت راست می‌وزد، و عقل و طبع من از مخلوقات خداوند، خیره و شگفت‌زده شده است."],[476,"با جوانان راه صحرا برگرفتم بامداد","کودکی گفتا تو پیری با خردمندان نشین","در بامداد، در کنار جوانان راه بیابان را پیش گرفتم. کودکی به من گفت تو کهن‌سال هستی و باید با دانایان و خردمندان باشی."],[476,"گفتم ای غافل نبینی کوه با چندین وقار","همچو طفلان دامنش پرارغوان و یاسمین","به او می‌گویم، ای مرد غافل، آیا نمی‌بینی که کوه چقدر باوقار و باصلابت است؟ همچون کودکانی که دامنشان از گل‌های ارغوان و یاسمن پر است."],[476,"آستین بر دست پوشید از بهار برگ شاخ","میوه پنهان کرده از خورشید و مه در آستین","بهار، آستینش را بر دست پوشیده و در آن، برگ‌های درخت میوه را پنهان کرده است تا از نور خورشید و ماه محفوظ بمانند."],[476,"باد گل‌ها را پریشان می‌کند هر صبحدم","زان پریشانی مگر در روی آب افتاده چین","هر صبح، باد، گل‌ها را به هم می‌ریزد و آشفته می‌کند. احتمالا این بی‌نظمی و آشفتگی از روی آب ناشی شده و جایی در سطح آب، یک چین و چروک پیدا شده است."],[476,"نوبهار از غنچه بیرون شد به یک تو پیرهن","بیدمشک انداخت تا دیگر زمستان پوستین","نوبهار به یکباره از میان غنچه‌ها بیرون آمد و با تو، یعنی محبوب، پیرهنی از بیدمشک (گیاهی معطر) بر تن کرد تا زمستان که لازم بود در پوستین باشد، دیگر تمام شده باشد."],[476,"این نسیم خاک شیراز است یا مشک ختن","یا نگار من پریشان کرده زلف عنبرین","این نسیم حاصل از خاک شیراز است یا عطر مشک ختن (منطقه‌ای در چین) یا اینکه محبوب من با زلف‌های عطرآگینش مرا پریشان کرده است."],[476,"بامدادش بین که چشم از خواب نوشین بر کند","گر ندیدی سحر بابل در نگارستان چین","صبح را ببین که چگونه معشوق با چشمان خواب‌آلود از خواب برمی‌خیزد. اگر سحرگاه در بابل (شهر معروف به زیبایی‌اش) را ندیده‌ای، نمی‌توانی زیبایی‌های باغ‌های چین را تصور کنی."],[476,"گر سرش داری چو سعدی سر بنه مردانه وار","با چنین معشوق نتوان باخت عشق الا چنین","اگر می‌خواهی مانند سعدی با معشوقی زیبا و دلربا برخورد کنی، باید با شهامت و مردانگی به او نزدیک شوی، زیرا با چنین معشوقی نمی‌توان عشق ورزید مگر به همین شیوه."],[477,"چه روی و موی و بناگوش و خط و خال است این","چه قد و قامت و رفتار و اعتدال است این","این افراد چه زیبایی‌هایی دارند! چهره، مو، گوش‌ها، خطوط صورت و خال‌ها همه نشان‌ دهنده زیبایی آن‌ها هستند و قد و قامت و رفتارشان هم به اندازه متعادلی است."],[477,"کسی که در همه عمر این صفت مطالعه کرد","به دیگری نگرد یا به خود محال است این","کسی که در تمام عمرش فقط به دنبال زیبایی‌های تو بوده و هیچ توجهی به دیگران نداشته، درواقع نمی‌تواند به هیچ چیز دیگری جز تو نگاه کند؛ این وضعیت غیرممکن است."],[477,"کمال حسن وجودت ز هر که پرسیدم","جواب داد که در غایت کمال است این","هر کسی که از من درباره زیبایی و کمال وجود تو سوال کرد، پاسخ داده است که تو در اوج کمال هستی."],[477,"نماز شام به بام ار کسی نگاه کند","دو ابروان تو گوید مگر هلالست این","اگر کسی در زمان غروب به آسمان نگاه کند و ابروان تو را ببیند، می‌تواند بگوید که آیا این دو ابرو همان هلال ماه است؟ یعنی زیبایی ابروان تو به حدی است که شبیه به هلال ماه به نظر می‌رسد."],[477,"لبت به خون عزیزان که می‌خوری لعل است","تو خود بگوی که خون می‌خوری، حلال است این؟!","لبت که به خون عزیزانت آلوده شده، مانند لعل (نوعی سنگ گرانبها) به زیبایی است، اما تو خود بگو آیا خوردن خون این عزیزان مجاز است؟"],[477,"چنان به یاد تو شادم که فرق می‌نکنم","ز دوستی که فراق است یا وصال است این","به خاطر یاد تو آن‌قدر خوشحالم که برایم فرقی نمی‌کند آیا دوستی به خاطر جدایی است یا به خاطر دیدار همدیگر."],[477,"شبی خیال تو گفتم ببینم اندر خواب","ولی ز فکر تو خواب آیدم؟! خیال است این","شب گذشته در خواب به یاد تو فکر کردم، اما می‌بینم که آیا از فکر تو خوابم می‌برد؟! آیا این فقط خیال است؟"],[477,"درازنای شب از چشم دردمندان پرس","عزیز من که شبی یا هزار سال است این","از طولانی شدن شب، از چشمان دردکشیدگان بپرس، ای عزیز من، که آیا شبی را دور کرده‌ای یا هزار سال را؟"],[477,"قلم به یاد تو در می‌چکاند از دستم","مداد نیست کز او می‌رود زلال است این","دست من که قلم است به یاد تو، گوهرهای گران‌بها می‌ریزد و مداد نیست که این می‌تواند به دقت نشان دهد. این اشاره به این دارد که یاد تو سبب می‌شود که کلمات زیبا و ارزشمند از من بیرون بیاید."],[477,"کسان به حال پریشان سعدی از غم عشق","زنخ زنند و ندانند تا چه حال است این","کسانی که شاهد حال نگران سعدی از غم عشق هستند، او را مسخره می‌کنند و نمی‌دانند که چه وضعیت سختی دارد."],[478,"ای چشم تو دل‌فریب و جادو","در چشم تو خیره چشم آهو","چشمان تو دل‌ربا و سحرآمیزند و من مانند آهو مجذوب آن‌ها هستم که به آن خیره شده‌ام."],[478,"در چشم منی و غایب از چشم","زآن چشم همی کنم به هر سو","تو در نگاه من حضور داری، اما از دید من پنهانی. به همین دلیل، من در همه جا به دنبال تو هستم."],[478,"صد چشمه ز چشم من گشاید","چون چشم برافکنم بر آن رو","وقتی که به آن چهره نگاه می‌کنم، صد چشمه عشق و محبت از چشمانم جاری خواهد شد."],[478,"چشمم بستی به زلف دلبند","هوشم بردی به چشم جادو","چشمم را به زلف معشوقه‌ام بسته‌ام و او با چشمان جادویی‌اش مرا فریفته و به سوی خود کشانده است."],[478,"هر شب چو چراغ چشم دارم","تا چشم من و چراغ من کو؟","هر شب مانند چراغی درخشان، روشنایی چشمم را دارم، اما با این حال نمی‌دانم کجاست چشم من و کجاست چراغ من؟"],[478,"این چشم و دهان و گردن و گوش","چشمت مرساد و دست و بازو","این ویژگی‌ها و زیبایی‌های چهره‌ات، یعنی چشمان، دهان، گردن و گوش، همه به من می‌رسند و برایم منظور و هدف‌اند، همچنین دست و بازوهایت نیز برای من اهمیت دارند."],[478,"مه گر چه به چشم خلق زیباست","تو خوب‌تری به چشم و ابرو","اگرچه ماه از نظر مردم زیبا و دلرباست، اما تو با چشم‌ها و ابروهایت زیباتر از او هستی."],[478,"با این همه چشم زنگی شب","چشم سیه تو راست هندو","با وجود این‌که چشم زنگی‌ها در شب زیبا به نظر می‌آیند، چشم سیاه تو به اندازه چشم‌های زیبا و متمایز هندو ارزشمند است."],[478,"سعدی به دو چشم تو که دارد","چشمی و هزار دانه لولو","سوگند به دو چشمت! که سعدی چشمی دارد که هزار قطره اشک از آن می‌ریزد. / لولو: مروارید و استعاره از اشک / (AI: سعدی به زیبایی چشمانت اشاره می‌کند و می‌گوید که هر چشمی ممکن است به زیبایی و درخشش چشمان تو نزدیک شود، حال آنکه تو به اندازه هزار لؤلؤ با ارزشی.)"],[479,"من از دست کمانداران ابرو","نمی‌یارم گذر کردن به هر سو","من نمی‌توانم از زیبایی و جذبه افرادی که ابروهای کمانی دارند چشم بپوشم و به راحتی از کنار آنها عبور کنم."],[479,"دو چشمم خیره ماند از روشنایی","ندانم قرص خورشید است یا رو","دو چشمان من به شدت مجذوب نور شده و نمی‌توانم تشخیص دهم که این روشنایی از خورشید است یا از چهره محبوبم."],[479,"بهشت است این که من دیدم نه رخسار","کمند است آن که وی دارد نه گیسو","آنچه را که من دیدم، بهشت است و آنچه در نظر می‌آید، چهره‌ای زیبا و دلربا نیست؛ بلکه این زیبایی به کسی تعلق دارد که دارای چنین چهره‌ای و موهایی زیبا است."],[479,"لبان لعل چون خون کبوتر","سواد زلف چون پر پرستو","لب‌های او به رنگ لعل (همان رنگ قرمز متمایل به سرخ) است و مانند خون کبوتر زیبا و دلنشین است. رنگ سیاه زلف‌هایش نیز مثل پر پرستو ظریف و زیباست."],[479,"نه آن سرپنجه دارد شوخ عیار","که با او بر توان آمد به بازو","آن یار شاداب و فریبنده، سرپنجه‌ای دارد که قدرت بازوی من حریفش نیست. (AI: این جمله به این معناست که شخصی که به ظاهر شاداب و فریبنده به نظر می‌رسد، در واقع توانایی و قدرت واقعی برای مقابله و ایستادگی ندارد. به عبارت دیگر، برخی افراد شاید ظاهری قوی یا توانا داشته باشند، اما در عمل نمی‌توانند در برابر چالش‌ها و قدرت‌ها مقاومت کنند.)"],[479,"همه جان خواهد از عشاق مشتاق","ندارد سنگ کوچک در ترازو","عاشقان به شدت خواهان و مشتاق معشوق هستند و این اشتیاق به اندازه‌ای است که حتی برای سنجش بها و ارزش این عشق، کوچک‌ترین چیزها نیز در ترازوی آنان سنگینی ندارد."],[479,"نفس را بوی خوش چندین نباشد","مگر در جیب دارد ناف آهو","بوی خوش نفسش چنان به مشام می‌رسد که گویا در گریبان خود عطر یا چیز خوشبو داشته باشد، مانند بوی ناف آهو که معروف است. / نافه آهو: غ176 ب2 / (AI: بوی خوش فقط در صورتی به مشام می‌رسد که در جیب خود عطر یا چیز خوشبو داشته باشیم، مانند بوی ناف آهو که معروف است.)"],[479,"لب خندان شیرین‌منطقش را","نشاید گفت جز ضحاک جادو","لب خندان او که با گفتار شیرینش، مانند ضحاک جادو (یا ضحاک، شخصیت افسانه‌ای) است، نباید به کسی گفته شود. به عبارت دیگر، زیبایی و خاص بودن لبخند او را نمی‌توان به سادگی توصیف کرد."],[479,"غریبی سخت محبوب اوفتاده‌ست","به ترکستان رویش خال هندو","بر روی صورتش خالی سیاه شبیه به نشانه‌ای هندی دیده می‌شود که گویی دختری غریب و زیبا در ترکستان زندگی می‌کند. (AI: دختری غریب و زیبا در ترکستان زندگی می‌کند و بر روی صورتش خالی شبیه به نشانه‌ای هندی دیده می‌شود.)"],[479,"عجب گر در چمن برپای خیزد","که پیشش سرو ننشیند به زانو","عجیب است اگر در باغ کسی به پای ایستاده باشد، در حالی که هیچ درخت مرتفعی مانند سرو در برابر او خم نشود."],[479,"و گر بنشیند اندر محفل عام","دو صد فریاد برخیزد ز هر سو","اگر در جمع عمومی بنشیند، صدای فریاد از هر طرف شنیده می‌شود."],[479,"به یاد روی گل‌بوی گل‌اندام","همه شب خار دارم زیر پهلو","من به یاد چهره زیبای محبوبی که بوی گلی را دارد، هر شب احساس ناراحتی و رنج می‌کنم، مانند خاری که زیر پهلو نشسته باشد."],[479,"تحمل کن جفای یار سعدی","که جور نیکوان ذنبیست معفو","تحمل کن رفتار ناپسند و بی‌محلی محبوب را، زیرا ظلم و سختی از جانب نیکوکاران، گناهی است که مورد بخشش قرار می‌گیرد."],[480,"گفتم به عقل پای برآرم ز بند او","روی خلاص نیست به جهد از کمند او","به عقل گفتم که از زنجیرش رهاییم و برم، اما می‌بینم که با تلاش هم نمی‌توانم از دام او رهایی پیدا کنم."],[480,"مستوجب ملامتی ای دل که چند بار","عقلت بگفت و گوش نکردی به پند او","ای دل، سزاوار ملامت هستی که چندین بار عقل تو به تو گفت و تو به نصیحت او توجه نکردی."],[480,"آن بوستان میوه شیرین که دست جهد","دشوار می‌رسد به درخت بلند او","بهشت پر از میوه‌های شیرین و لذیذ که برای رسیدن به آن‌ها تلاش زیادی لازم است، درخت بلندی به نام او دارد که به آن میوه‌ها دسترسی نمی‌یابیم."],[480,"گفتم عنان مرکب تازی بگیرمش","لیکن وصول نیست به گرد سمند او","گفتم می‌خواهم کنترل اسب تازی را به دست بگیرم، اما نمی‌توانم به سرعت و جایگاه سمند او (که نشان‌دهنده محبوب یا مقصدی خاص است) برسم."],[480,"سر در جهان نهادمی از دست او ولیک","از شهر او چگونه رود شهربند او؟","من جان خود را به خاطر او در دنیا گذاشته‌ام، اما نمی‌دانم چگونه می‌توانم به شهر او بروم، در حالی که او مرا در بند خود دارد."],[480,"چشمم بدوخت از همه عالم به اتفاق","تا جز در او نظر نکند مستمند او","چشمم به او دوخته شده و به خاطر او به همه جهان بی‌اعتنا شده‌ام، تا اینکه تنها به او نگاه کنم و کسی جز او را نبینم."],[480,"گر خود به جای مروحه شمشیر می‌زند","مسکین مگس کجا رود از پیش قند او؟","اگر او برای راندن مگس به جای بادبزن، شمشیر می‌زند، مگس بیچاره از شیرینی او چگونه دور شود؟ (AI: اگر خود شمع برای خود دارای شعله و نور است، چه جای نگرانی است که مگس بیچاره از شیرینی او دور شود؟)"],[480,"نومید نیستم که هم او مرهمی نهد","ور نه به هیچ به نشود دردمند او","من ناامید نیستم که او خود درمانی برای درد من خواهد گذاشت، و اگر هم این کار را نکند، درد من به هیچ‌وجه برطرف نخواهد شد."],[480,"او خود مگر به لطف خداوندی‌ای کند","ور نه ز ما چه بندگی آید پسند او؟","تنها در صورتی که خداوند بخواهد به ما لطف می‌کند، وگرنه از ما چه انتظاری می‌توان داشت که او را راضی کنیم؟"],[480,"سعدی چو صبر از اوت میسر نمی‌شود","اولی‌تر آن که صبر کنی بر گزند او","سعدی می‌گوید اگر نمی‌توانی از او صبر و مهربانی ببینی، بهتر است که برآسیب‌های او صبر کنی."],[481,"صید بیابان عشق چون بخورد تیر او","سر نتواند کشید، پای ز زنجیر او","کسی که گرفتار عشق شده، وقتی تیر عشق به او اصابت کند، نمی‌تواند از جایی که هست خود را رها کند و زنجیر عشق او را محکم نگه می‌دارد."],[481,"گو به سنانم بدوز یا به خدنگم بزن","گر به شکار آمده‌ست دولت نخجیر او","اگر می‌خواهی به من آسیب برسانی، یا با تیر به من بزنی، این کار را بکن؛ چون اگر به شکار آمده‌ام، این توفیق را با دقت و ظرافتی که در کمان اوست، از دست نمی‌دهم."],[481,"گفتم «از آسیب عشق، روی به عالم نهم»","عرصه عالم گرفت، حسن جهان‌گیر او","گفتم به خاطر آسیب‌های عشق، دیگر به دنیا روی نمی‌آورم؛ اما زیبایی و محبتی که او دارد، همه چیز را در دست گرفته است."],[481,"با همه تدبیر خویش، ما سپر انداختیم","روی به دیوار صبر، چشم به تقدیر او","با تمام تدابیر و چاره‌جویی که کردیم، تسلیم شدیم و به دیوار شکیبایی تکیه دادیم و به تقدیر او نگاه می‌کنیم."],[481,"چاره مغلوب نیست جز سپر انداختن","چون نتواند که سر، در کشد از تیر او","وقتی که کسی در مقابل دشمن شکست خورده، چاره‌ای جز تسلیم شدن و از خود دفاع نکردن ندارد، زیرا نمی‌تواند از تیرهای او جان سالم به در ببرد."],[481,"کشته معشوق را درد نباشد که خلق","زنده به جانند و ما زنده به تأثیر او","عاشق جان‌باخته به خاطر محبوبش دردی حس نمی‌کند، چون انسان‌های زنده به زندگی خود ادامه می‌دهند، اما عشق و تاثیر محبوب بر او سبب حیاتش است."],[481,"او به فغان آمده‌ست زین همه تعجیل ما","ای عجب و ما به جان، زین همه تأخیر او","او به خاطر شتاب ما در عشق و خواستن به هیجان آمده است، در حالی که ما به دلیل عدم رسیدن به او، هنوز در تأخیر هستیم."],[481,"در همه گیتی نگاه کردم و باز آمدم","صورت کس خوب نیست پیش تصاویر او","در تمام جهان نگاه کردم، اما هیچ‌کس به زیبایی او نیست و وقتی به تصاویر او فکر می‌کنم، می‌بینم که هیچ‌چیز واقعی نمی‌تواند با زیبایی او مقایسه شود."],[481,"سعدی شیرین‌زبان! این همه شور از کجا؟","شاهد ما آیتی‌ست وین همه تفسیر او","سعدی! این همه احساس و هیجان از کجا نشأت می‌گیرد؟ زیرا معشوق ما نشانه زیبایی است و تمام این احساسات ناشی از توصیف اوست."],[481,"آتشی از سوز عشق، در دل داوود بود","تا به فلک می‌رسد بانگ مزامیر او","داوود، پیامبر و نوازنده‌ای مشهور، به قدری در عشق و شوق الهی می‌سوزد که آواز و نغمه‌هایش به سوی آسمان می‌رود و از عشق او بی‌نهایت گرم و تاثیرگذار است."],[482,"هر که به خویشتن رود ره نبرد به سوی او","بینش ما نیاورد طاقت حسن روی او","کسی که به خود واقعی‌اش نرسد و نتواند درک و بینش لازم را پیدا کند، نمی‌تواند به زیبایی و محبت او (معشوق) دست یابد."],[482,"باغ بنفشه و سمن بوی ندارد ای صبا","غالیه‌ای بساز از آن طره مشکبوی او","ای نسیم، باغ بنفشه و سمن بوی خوشی ندارند، بنابراین از موی مشکین او، عطری معطر بساز."],[482,"هر کس از او به قدر خویش آرزویی همی‌کنند","همت ما نمی‌کند زو به جز آرزوی او","هر کسی به اندازه توان و ظرفیت خود آرزوهایی دارد، اما همت و آرزوی ما چیزی جز خود او نیست. (AI: هر کسی به اندازه توان و ظرفیت خود آرزوهایی دارد، اما همت ما به چیزی بالاتر از آرزوهای او می‌رسد.)"],[482,"من به کمند او درم او به مراد خویشتن","گر نرود به طبع من من بروم به خوی او","من به وسیله محبت و جذبه او به دام افتاده‌ام و او هم به خواسته خود می‌رسد. اگر او به خواسته‌ام نرسد، من هم به صورت او و شخصیت او خواهم رفت و همان‌طور که او می‌خواهد، تغییر می‌کنم."],[482,"دفع زبان خصم را تا نشوند مطلع","دیده به سوی دیگری دارم و دل به سوی او","من همیشه به دفع سخنان منفی و دشمنان می‌پردازم، ظاهرا چشمانم به سوی دیگری است و قلبم فقط به او تعلق دارد. (AI: من همیشه به دفع سخنان منفی و دشمنان می‌پردازم تا چشمانم به سوی دیگران نرود و قلبم فقط به او تعلق داشته باشد.)"],[482,"دامن من به دست او روز قیامت اوفتد","عمر به نقد می‌رود در سر گفت و گوی او","در روز قیامت، دامن من به دست آن محبوب خواهد افتاد و عمرم به سرعت سپری می‌شود در فکر و حرف‌های او."],[482,"سعدی اگر برآیدت پای به سنگ دم مزن","روز نخست گفتمت سر نبری ز کوی او","ای سعدی، اگر پایت در مسیر او به سنگ خورد، سکوت کن! چون در روز اول به تو گفته‌ام که از کوی او جان سالم به در نمی‌بری. (AI: اگر سعدی به سراغت بیاید، پا بر روی سنگ نگذار و در روز اول به تو گفته‌ام که از مسیر او منحرف نشو.)"],[483,"راستی گویم به سروی ماند این بالای تو","در عبارت می‌نیاید چهره زیبای تو","از صمیم قلب می‌گویم که بالای تو مانند سرو است و زیبایی چهره‌ات در کلمات نمی‌گنجد و نمی‌توان به خوبی توصیفش کرد."],[483,"چون تو حاضر می‌شوی من غایب از خود می‌شوم","بس که حیران می‌بماندم وهم در سیمای تو","وقتی تو جلوه‌گر می‌شوی، من آن‌قدر از خود بی‌خبر می‌شوم که حیرت‌زده و شگفت‌زده می‌مانم و حتی از خودم غایب می‌شوم، زیرا تمام تمرکز و توجه‌ام به چهره تو است."],[483,"کاشکی صد چشم از این بی خوابتر بودی مرا","تا نظر می‌کردمی در منظر زیبای تو","ای کاش می‌توانستم صد چشم بی‌خواب داشته باشم تا بتوانم مدام به زیبایی‌های تو نگاه کنم."],[483,"ای که در دل جای داری بر سر چشمم نشین","کاندر آن بیغوله ترسم تنگ باشد جای تو","ای تو که در دل من جا داری، بر چشم من بنشین؛ زیرا در آن مکان تنگ و تاریک، می‌ترسم که جا برای تو کم باشد."],[483,"گر ملامت می‌کنندم ور قیامت می‌شود","بنده سر خواهد نهاد آن گه ز سر سودای تو","اگر مرا سرزنش کنند یا روز قیامت نیز فرابرسد، من همچنان در مقابل تو تسلیم خواهم بود و تنها به عشق تو فکر می‌کنم."],[483,"در ازل رفته‌ست ما را با تو پیوندی که هست","افتقار ما نه امروز است و استغنای تو","ما از ابتدا با تو ارتباطی داشتیم که موجب وابستگی ما به تو شده است. این وابستگی به نیاز و احتیاج ما به تو محدود نمی‌شود و حالا نیست، بلکه همیشه وجود داشته است."],[483,"گر بخوانی پادشاهی ور برانی بنده‌ایم","رای ما سودی ندارد تا نباشد رای تو","ما بندگان تو هستیم و هر تصمیمی که بگیریم، چه ما را به مقام پادشاهی برسانی و چه از خود برانی، برای ما منظور نیست؛ زیرا بدون اراده و رأی تو، هیچ‌یک از اندیشه‌ها و نقشه‌های ما ارزشی ندارد."],[483,"ما قلم در سر کشیدیم اختیار خویش را","نفس ما قربان توست و رخت ما یغمای تو","ما قلم را بر سر اختیار خود کشیدیم، یعنی کار خویش را از دست دادیم و از خود گذشتیم. نفس و جان ما فدای توست و آنچه داریم، متعلق به توست. (AI: ما قلم را بر سر کشیدیم، یعنی کار خویش را به دست گرفتیم و از خود گذشتگی کردیم. نفس و جان ما فدای توست و آنچه داریم، متعلق به توست.)"],[483,"ما سراپای تو را ای سروتن چون جان خویش","دوست می‌داریم و گر سر می‌رود در پای تو","ما تمام وجود تو را، ای سروتن، مانند جان خود عزیز می‌دانیم و اگر جانمان هم برای تو برود، با کمال میل آن را فدای تو می‌کنیم."],[483,"وین قبای صنعت سعدی که در وی حشو نیست","حد زیبایی ندارد خاصه بر بالای تو","این لباس زیبا که سعدی با مهارت خود دوخته، هیچ چیز اضافی ندارد و زیبایی آن به خاطر تو است، به‌ویژه زمانی که بر دوش تو قرار می‌گیرد."],[484,"بیا که در غم عشقت مشوشم بی‌تو","بیا ببین که در این غم چه ناخوشم بی‌تو","بیایید تا در کنار هم باشیم، زیرا بدون تو در غم عشقت ناآرام و پریشان هستم. بیا و ببین که بدون تو چقدر ناراحت و اندوهگین هستم."],[484,"شب از فراق تو می‌نالم، ای پری‌رخسار!","چو روز گردد گویی در آتشم بی‌تو","به خاطر جدایی تو، شب‌ها را با ناله و گله می‌گذرانم، ای زیبا روی! وقتی روز می‌شود، انگار در آتش می‌سوزم بدون تو."],[484,"دمی تو شربت وصلم نداده‌ای، جانا!","همیشه زهر فراقت همی چشم بی‌تو","من هیچ وقت طعم شیرین وصال تو را نچشیده‌ام، ای محبوب! همیشه تلخی جدایی تو را احساس می‌کنم و از آن رنج می‌برم بی‌تو."],[484,"اگر تو با من مسکین چنین کنی، جانا!","دو پایم از دو جهان نیز درکشم بی‌تو","اگر تو این‌گونه با من بی‌چاره رفتار کنی، ای محبوب! حتی برای خودم هم نسبت به دو جهان، بی‌حساب و بی‌اهمیت می‌شوم، چون بدون تو ارزشی ندارم."],[484,"پیام دادم و گفتم «بیا خوشم می‌دار»","جواب دادی و گفتی که «من خوشم بی‌تو»","پیام فرستادم و گفتم که «بیا، مرا دوست داشته باش»، اما تو پاسخ دادی و گفتی که «من بدون تو خوشحالم»."],[485,"ای طراوت برده از فردوس اعلی روی تو","نادر است اندر نگارستان دنیی روی تو","ای زیبایی تو که طراوتی از بهشت بر چهره‌ات نمایان است، در دنیا همچین زیبایی نادر و منحصر به فرد است."],[485,"دختران مصر را کاسد شود بازار حسن","گر چو یوسف پرده بردارد به دعوی، روی تو","اگر دختران مصر بخواهند به زیبایی و جذابیت تو ببالند، بازار زیبایی آن‌ها کساد می‌شود؛ زیرا اگر تو همچون یوسف (پسر یعقوب) از پرده بیرون بیایی و زیبایی‌ات را نشان دهی، هیچ زیبایی دیگری نمی‌تواند به پای تو برسد."],[485,"گر چه از انگشت مانی بر نیاید چون تو نقش","هر دم انگشتی نهد بر نقش مانی روی تو","اگرچه هیچ کس نمی‌تواند به زیبایی تو طراحی کند و هنر تو را به تصویر بکشد، اما هر لحظه که نگاهم به تو می‌افتد، به یاد نقش مانی (نقش برجسته معروفی از دوره باستان) می‌افتم که شگفتی و زیبایی‌اش را به تصویر می‌کشد."],[485,"از گل و ماه و پری در چشم من زیباتری","گل ز من دل برد یا مه یا پری نی روی تو","تو از گل و ماه و پری زیباتر هستی، زیرا گل، دل من را ربود یا ماه و پری، ولی هیچ‌کدام زیبایی تو را ندارند."],[485,"ماه و پروین از خجالت رخ فرو پوشد اگر","آفتاب آسا کند در شب تجلی روی تو","اگر تو مانند آفتاب در شب چهره‌ات را آشکار کنی، ماه و ستاره‌ها از شرم زیبایی‌ات خود را مخفی می‌کنند."],[485,"مردم چشمش بدرد پرده اعمی ز شوق","گر درآید در خیال چشم اعمی روی تو","اگر فرد نابینا در خیال خود تصویر چهره تو را ببیند، مردمک چشم او از شوق ممکن است پرده نابینایی را کنار زند (و بینا شود). (AI: اگر چشمان مردم به چشمان کسی که نابینا است آسیب برساند، او از شوق ممکن است در خیال خود تصویر چهره تو را ببیند.)"],[485,"روی هر صاحب‌جمالی را به مه خواندن خطاست","گر رخی را ماه باید خواند باری روی تو","نمی‌توان هر زیبایی را به اندازه جلال تو توصیف کرد و این اشتباه بزرگی است. اگر بخواهیم آراستگی و زیبایی را با ماه مقایسه کنیم، تنها باید به روی تو اشاره کرد که واقعا شایسته این مقام است."],[485,"رسم تقوی می‌نهد در عشق‌بازی رای من","کوس غارت می‌زند در ملک تقوی روی تو","به نظر من عشق و تقوا به هم پیوند خورده‌اند، ولی چهره تو در مملکت پرهیزگاری بر طبل غارت می‌کوبد (به زبان ساده: چهره زیبای تو عامل از بین رفتن تقواست). / (AI: عشق و تقوا به هم پیوند خورده‌اند و در این میان، نظرات و خواسته‌های من به گونه‌ای با شدت بیان می‌شود که انگار در دنیای تقوا، حالتی از بی‌نظمی وجود دارد.)"],[485,"چون به هر وجهی بخواهد رفت جان از دست ما","خوب‌تر وجهی بباید جستن اولی روی تو","هرگاه جان ما بخواهد از بدن جدا شود، بهتر است که به هر شکلی که می‌تواند برود، اما باید ابتدا به دنبال آن شکل خوب یا زیبا باشیم که همان روی تو است."],[485,"چشمم از زاری چو فرهاد است و شیرین لعل تو","عقلم از شورش چو مجنون است و لیلی روی تو","چشم من به خاطر اشک و زاری مانند فرهاد (شخصیتی حماسی عاشق) است، و عشق تو (که لب‌های تو را لعل می‌نامد) آن‌قدر برایم ارزشمند است که عقل من در شورش و بی‌تابی شبیه مجنون (دیوانه) برای لیلی (عشقی افسانه‌ای) شده است."],[485,"ملک زیبایی مسلم گشت فرمان تو را","تا چنین خطی مزور کرد انشی روی تو","زیبایی واقعی متعلق به توست، زیرا فرمان و اراده‌ات باعث شده است که این خط زیبا و دلربا به وجود آید. به طور کلی، روی تو زیبایی خاصی دارد که هیچ‌کس را در زیبایی‌اش تردید نیست."],[485,"داشتند اصحاب خلوت حرف‌ها بر من ز بد","تا تجلی کرد در بازار تقوی روی تو","مردم اهل راز و عرفان در خلوت درباره من سخن می‌گفتند و از حرف‌های بد و زشت یاد می‌کردند، اما وقتی حضور پرنور و زیبای تو در میدان تقوا آشکار شد، تمام آن سخنان از بین رفت."],[485,"خرده بر سعدی مگیر ای جان که کاری خرد نیست","سوختن در عشق وانگه ساختن بی روی تو","ای جان، از سعدی که نباید ایراد بگیری، زیرا سوختن در عشق کار کوچکی نیست؛ وقتی که معشوق تو نیست، چگونه می‌توان دوباره ساخت و زندگی کرد؟"],[486,"آن سرو ناز بین که چه خوش می‌رود به راه","وآن چشم آهوانه که چون می‌کند نگاه","سرو نازک‌اندام که چقدر زیبا در حال حرکت است، و چه چشمان زیبایی دارد که مانند نگاه آهوهاست."],[486,"تو سرو دیده‌ای که کمر بست بر میان؟!","یا ماه چارده که به سر برنهد کلاه؟!","آیا تو آن سروی را دیده‌ای که کمر خود را در میان بسته باشد؟ یا آیا آن ماه چهاردهم را دیده‌ای که کلاهی بر سر گذاشته باشد؟"],[486,"گل با وجود او چو گیاه است پیش گل","مه پیش روی او چو ستاره‌ست پیش ماه","وجود او آن‌قدر گوهر و ارزشمند است که گل‌ها در مقابلش به اندازه گیاهان معمولی به نظر می‌رسند و مه در حضور او همچون ستاره‌ها در برابر ماه کم‌نور و کوچک می‌شود."],[486,"سلطان‌صفت همی‌رود و صد هزار دل","با او چنان که در پی سلطان رود سپاه","او (خود شاعر) مانند پادشاهی حرکت می‌کند و صدها دل عاشق را با خود دارد، مانند این که سپاه در پی سلطان حرکت می‌کند."],[486,"گویند از او حذر کن و راه گریز گیر","گویم کجا روم که ندانم گریزگاه","می‌گویند از عشق او دوری کن و راهی برای فرار پیدا کن، اما من نمی‌دانم کجا بروم که از چه چیزی فرار کنم."],[486,"اول نظر که چاه زنخدان بدیدمش","گویی در اوفتاد دل از دست من به چاه","زمانی که برای اولین بار نگاه به زنخدانش (یعنی خط انداختی بر روی گردن یا گلو) انداختم، انگار که دلم به درون چاهی افکنده شد و از دستم رفت."],[486,"دل خود دریغ نیست که از دست من برفت","جان عزیز بر کف دست است گو بخواه","دل من ناراحت نیست که از دستم رفت، چون جان عزیزم در دست من است؛ اگر بخواهم می‌توانم آن را پس بگیرم."],[486,"ای هر دو دیده، پای که بر خاک می‌نهی","آخر نه بر دو دیده من به که خاک راه؟","ای نور چشمانم که قدم بر خاک می‌گذاری، بیا و بر چشمان من قدم گذار که از خاک بهتر است. (AI: ای چشمان تو که بر زمین می‌نگری، در نهایت برای تو بهتر است که بر چشمان من ننگری، زیرا من مانند خاکی هستم که راه را نشان می‌دهد.)"],[486,"حیف است از آن دهن که تو داری جواب تلخ","وآن سینه سفید که دارد دل سیاه","حیف است اگر دهن تو جواب تلخی بدهد، در حالی که سینه‌ات سفید است، اما دل تو سیاه و تیره دارد."],[486,"بیچارگان بر آتش مهرت بسوختند","آه از تو سنگدل که چه نامهربانی آه","بیچارگان به خاطر عشق و محبت تو در آتش عشق می‌سوزند، ای سنگدل، چگونه می‌توانی این‌قدر بی‌رحم و نامهربان باشی؟"],[486,"شهری به گفت‌و‌گوی تو در تنگنای شوق","شب روز می‌کنند و تو در خواب صبحگاه","عشاق در دوری تو، به شدت و مداوم درباره تو صحبت می‌کنند و در انتظار تو هستند، اما تو در خواب غفلت به سر می‌بری و توجهی به حال آن‌ها نداری."],[486,"گفتم بنالم از تو به یاران و دوستان","باشد که دست ظلم بداری ز بی‌گناه","گفتم شکایت تو را به یاران و دوستان بکنم تا شاید با این کار، تو دیگر به بی‌گناهان ظلم نکنی."],[486,"بازم حفاظ، دامن همت گرفت و گفت","از دوست جز به دوست مبر سعدیا پناه","همت (این‌جا به معنای تلاش و آرزو) دوباره خودش را در دفاع از من قرار داد و گفت: سعدی، از دوست‌ات فقط به دوست‌ات تکیه کن و پناه ببر، نه به دیگران."],[487,"پنجه با ساعد سیمین که نیندازی به","با توانای معربد نکنی بازی به","اگرپنجه با دست زیبایی نیندازی، بهتر است. و بهتر اینکه عربده‌جوی قدرتمندی را به بازی نگیری. (AI: اگر دست زیبایت را به کار نیندازی، نمی‌توانی با قدرت و مهارت، کسی را به بازی بگیری.)"],[487,"چون دلش دادی و مهرش ستدی چاره نماند","اگر او با تو نسازد تو در او سازی به","وقتی دل او را به دست آوردی و محبتش را گرفتی، اگر او با تو سازگاری نداشته باشد، دیگر چاره‌ای نخواهی داشت و تو باید خودت را با او وفق دهی."],[487,"جز غم یار مخور تا غم کارت بخورد","تو که با مصلحت خویش نپردازی به","غیر از غم معشوق را نخور تا او غمخوار کار تو باشد. و بهتر اینکه تو نمی‌خواهی به مصلحت خودت توجه کنی. (AI: غیر از غم معشوق را نخور، چون غم او تو را فرسوده می‌کند. تو که نمی‌خواهی به مصلحت خودت توجه کنی، نباید به این غم دامن بزنی.)"],[487,"سپر صبر تحمل نکند تیر فراق","با کمان‌ابرو اگر جنگ نیاغازی به","صبر انسان نمی‌تواند تیر جدایی را تحمل کند، زیرا اگر کمان ابرو به جنگ برآید، این تیر دردناک خواهد بود."],[487,"با چنین یار که ما عقد محبت بستیم","گر همه مایه زیان می‌کند انبازی به","با این یاری که ما میان خودمان عهد محبت بسته‌ایم، اگرچه ممکن است که هر چیزی زیان‌آور باشد، اما در کنار او، زیان‌دیدن فایده‌ای ندارد."],[487,"بنده را بر خط فرمان خداوند امور","سر تسلیم نهادن ز سرافرازی به","من، که بنده خداوند هستم، با افتخار تمام تسلیم فرمان او شده‌ام و این تسلیم را نشانه‌ای از سرافرازی و عزت خود می‌دانم."],[487,"گر چو چنگم بزنی پیش تو سر برنکنم","این چنین یار وفادار که بنوازی به","اگر مثل چنگ مرا بنوازی، هرگز سر از فرمان تو برنمی‌دارم. این چنین وفادار یاری که به محبت تو پاسخ می‌دهد، هرگز تسلیم نمی‌شود."],[487,"هیچ شک نیست به تیر اجل ای یار عزیز","که من از پای درآیم چو تو اندازی به","هیچ شکی نیست که اگر تو تیر مرگ را به سوی من پرتاب کنی، من حتما به زمین می‌افتم، ای دوست عزیز."],[487,"مجلس ما دگر امروز به بستان ماند","مطرب از بلبل عاشق به خوش‌آوازی به","امروز مجلس ما همچنان در باغ باقی‌مانده است و مطرب می‌نوازد و بلبل عاشق به زیبایی آواز می‌خواند."],[487,"گوش بر ناله مطرب کن و بلبل بگذار","که نگوید سخن از سعدی شیرازی به","به صدای ناله ساز گوش بده و بلبل را رها کن، زیرا که از سعدی شیرازی بهتر نغمه نمی‌سراید. (AI: به صدای ناله ساز گوش بده و بگذار بلبل بخواند، زیرا که از سعدی شیرازی سخن نگفته است.)"],[488,"ای که شمشیر جفا بر سر ما آخته‌ای","دشمن از دوست ندانسته و نشناخته‌ای","ای کسی که با بدی و ظلم بر من حمله کرده‌ای، تو دشمن را از دوست تشخیص نداده و نمی‌شناسی."],[488,"من ز فکر تو به خود نیز نمی‌پردازم","نازنینا تو دل از من به که پرداخته‌ای","من آن‌قدر مشغول فکر تو هستم که حتی به خودم هم نمی‌رسیم؛ ای نازنین، تو دل از من به چه کسی سپرده‌ای؟"],[488,"چند شب‌ها به غم روی تو روز آوردم","که تو یک روز نپرسیده و ننواخته‌ای","چند شب است که به خاطر غم چهره تو، بی‌خوابی کشیده‌ام و روزها را سپری کرده‌ام، اما تو هیچ‌گاه حتی یک روز از حال من نپرسیدی و یا به من توجه نکردی."],[488,"گفته بودم که دل از دست تو بیرون آرم","باز دیدم که قوی پنجه درانداخته‌ای","با خود گفته بودم که از عشق تو دل می‌کنم، اما دوباره متوجه شدم که تو با قدرت و چنگال قوی خود مرا به دام انداخته‌ای."],[488,"تا شکاری ز کمند سر زلفت نجهد","ز ابروان و مژه‌ها تیر و کمان ساخته‌ای","این بیت بیان می‌کند که تا زمانی که شکارچی در دنبال کردن شکارش از دام موی سر زلف معشوقه نجهیده باشد، تو با ابروها و مژه‌هایت تیر و کمان درست کرده‌ای، به گونه‌ای که او را به دام می‌اندازی. این به نوعی اشاره به زیبایی و جذابیت معشوق و تأثیر آن بر دل عاشق دارد."],[488,"لاجرم صید دلی در همه شیراز نماند","که نه با تیر و کمان در پی او تاخته‌ای","بنابراین، در شیراز هیچ دلی باقی نمانده که شکار عشق تو نشده باشد، زیرا تو با تیر و کمان عشق به سمت همه آن‌ها حمله‌ور شده‌ای."],[488,"ماه و خورشید و پری و آدمی اندر نظرت","همه هیچند که سر بر همه افراخته‌ای","در نظر تو، ماه و خورشید و پری و آدمی همه بی‌اهمیت هستند، چون تو به خاطر مقام و قدرت خود، بر فراز همه آن‌ها قرار داری."],[488,"با همه جلوه طاووس و خرامیدن کبک","عیبت آن است که بی‌مهرتر از فاخته‌ای","با وجود زیبایی و جلوه‌های خاص طاووس و راه رفتن دلربای کبک، عیب تو این است که از فاخته بی‌محبت‌تر هستی."],[488,"هر که می‌بیندم از جور غمت می‌گوید","سعدیا بر تو چه رنج است که بگداخته‌ای","هرکس که من را به خاطر درد و رنج ناشی از غم تو می‌بیند، می‌گوید سعدی، تو چه دردی را تحمل می‌کنی که اینگونه داغدار شده‌ای."],[488,"بیم مات است در این بازی بیهوده مرا","چه کنم دست تو بردی که دغل باخته‌ای","من در این بازی بیهوده در برابر غم تو بیم دارم، اما چه کار کنم وقتی که تو با تقلب برنده شده‌ای و مرا باخته‌ای؟"],[489,"ای رخ چون آینه افروخته","الحذر از آه من سوخته","ای چهره‌ات که مانند آینه می‌درخشد، مراقب باش که آه من به شدت سوزان است."],[489,"غیرت سلطان جمالت چو باز","چشم من از هر که جهان دوخته","غیرت و جذابیت سلطنت زیبایی‌ات مانند چشمان من است که از هر چه در جهان دیده، سرشته شده است."],[489,"عقل کهن بار جفا می‌کشد","دم به دم از عشق نوآموخته","عقل قدیمی و تجربه‌ام به‌خاطر رفتارهای نادرست و رنج‌های عشق جدیدی که تازه یاد گرفته‌ام، همیشه درد می‌کشد."],[489,"وه که به یک بار پراکنده شد","آنچه به عمری بشد اندوخته","افسوس که در یک لحظه، تمام دانسته‌ها و تجربه‌هایی که در طول عمر جمع کرده بودم، از میان رفت."],[489,"غم به تولای تو بخریده‌ام","جان به تمنای تو بفروخته","برای عشق و محبت تو، غم را خریده‌ام و جانم را برای رسیدن به تو فروخته‌ام."],[489,"در دل سعدیست چراغ غمت","مشعله‌ای تا ابد افروخته","در دل سعدی، عشق و غم تو همچون چراغی روشن باقی خواهد ماند و هرگز خاموش نخواهد شد."],[490,"ای که ز دیده غایبی در دل ما نشسته‌ای","حسن تو جلوه می‌کند وین همه پرده بسته‌ای","ای کسی که از دید ما دوری، اما در دل ما جا داری. زیبایی تو خود را می‌نمایاند، در حالی که این همه حجاب و پرده‌ها بر تو کشیده شده است."],[490,"خاطر عام برده‌ای خون خواص خورده‌ای","ما همه صید کرده‌ای خود ز کمند جسته‌ای","در این بایت، شاعر می‌گوید تو به دل همه مردم (عام) عشق خود را برده‌ای و از خواص (افراد خاص یا ویژه) بهره گرفته‌ای. ما همه را به دام عشق انداخته‌ای، در حالی که خودت از این کمند (دام) فرار کرده‌ای. یعنی تو با فریب و زیبایی خود، دیگران را گرفتار کرده‌ای در حالی که خودت از این وضعیت رهایی یافته‌ای."],[490,"از دگری چه حاصلم تا ز تو مهر بگسلم","هم تو که خسته‌ای دلم مرهم ریش خسته‌ای","از کسی دیگر چه فایده‌ای دارم وقتی که عشق تو را رها کنم؟ تو هم که دل من را درد آورده‌ای، مرهمی برای زخم‌های دلم نیستی («هستی» صحیح است)."],[490,"گر به جراحت و الم دل بشکستیم چه غم","می‌شنوم که دم به دم پیش دل شکسته‌ای","اگر دردی را تحمل کنیم و دل ما بشکند، چه غمی دارد وقتی می‌شنوم که هر لحظه دلی شکسته‌تر از دل خودم هست؟"],[491,"حنّاست آن که ناخن دلبند رشته‌ای؟","یا خون بی دلیست که در بند کشته‌ای؟","آیا محبت و دوستی تو همچون تار موهای محبوب است که آن را در دام خود گرفتار کرده‌ای؟ یا اینکه این حالت ناشی از دلشکستگی است که تو آن را در بند مرگ و نابودی قرار داده‌ای؟"],[491,"من آدمی به لطف تو دیگر ندیده‌ام","این صورت و صفت که تو داری فرشته‌ای","من هیچ انسانی را که به نیکی و زیبایی تو باشد، ندیده‌ام؛ تو چنان صفت و ظاهری داری که شایسته فرشتگان هستی."],[491,"وین طرفه‌تر که تا دل من دردمند توست","حاضر نبوده یک دم و غایب نگشته‌ای","محبت تو چنان قوی و عمیق است که در حالی که دل من از درد و اشتیاق می‌سوزد، تو هیچ‌گاه از یاد من نرفته‌ای و همیشه با من هستی، حتی زمانی که به نظر می‌رسد غایب هستی."],[491,"در هیچ حلقه نیست که یادت نمی‌رود","در هیچ بقعه نیست که تخمی نکشته‌ای","در هیچ جمعی نیست که یاد تو فراموش نشود و در هیچ مکان مقدسی نیست که نشانه‌ای از عشق تو وجود نداشته باشد."],[491,"ما دفتر از حکایت عشقت نبسته‌ایم","تو سنگدل حکایت ما درنوشته‌ای","ما همچنان به ثبت و روایت عشق تو نپرداخته‌ایم، اما تو با دل سنگی‌ات داستان ما را نوشته‌ای."],[491,"زیب و فریب آدمیان را نهایت است","حوری، مگر نه از گل آدم سرشته‌ای","زیبایی و جذابیت حوری‌ها به نهایت می‌رسد و دلربایی آن‌ها بی‌نظیر است، اما آیا این زیبایی در واقع ناشی از گل آدم نیست که از آن آفریده شده‌اند؟"],[491,"از عنبر و بنفشه تر بر سر آمده‌ست","آن موی مشکبوی که در پای هشته‌ای","موی خوشبو و مشکی که در زیر پای تو افتاده، از عطر عنبر و گل بنفشه تازه الهام گرفته است."],[491,"من در بیان وصف تو حیران بمانده‌ام","حدّیست حسن را و تو از حد گذشته‌ای","من در توصیف زیبایی‌های تو گیج و سردرگم مانده‌ام؛ زیبایی حد و حدودی دارد، اما تو فراتر از آن حد و مرزی هستی."],[491,"سر می‌نهند پیش خطت عارفان پارس","بیتی مگر ز گفته سعدی نبشته‌ای؟","عارفان مشهور به ادب و دانش، در برابر خط تو سر فرود می‌آورند، انگار که فقط یک بیت شعر از سعدی درباره تو نوشته شده است."],[492,"ای باغ حسن چون تو نهالی نیافته","رخساره زمین چو تو خالی نیافته","ای کسی که در باغ زیبایی‌ نهالی بی‌نظیر هستی، بر چهره زمین خالی مانند تو پیدا نمی‌شود. (AI: ای باغی که زیبایی‌ات بی‌نظیر است، بر روی زمین کسی مانند تو پیدا نمی‌شود و این زمین از نور روی تو تهی است.)"],[492,"تابنده‌تر ز روی تو ماهی ندیده چرخ","خوشتر ز ابروی تو هلالی نیافته","چرخ (آسمان) هیچ ماهی را زیباتر از چهره تو ندیده و هیچ هلالی هم خوش‌نما‌تر از ابروهای تو نیافته است."],[492,"بر دور عارض تو نظر کرده آفتاب","خود را لطافتی و جمالی نیافته","آفتاب وقتی به چهره تو نگاه می‌کند، نه تنها لطافتی (در خود) نمی‌بیند، بلکه زیبایی هم در (خود) نمی‌یابد."],[492,"چرخ مشعبد از رخ تو دلفریبتر","در زیر هفت پرده خیالی نیافته","هیچ چیز زیباتر از چهره دلربای تو، حتی گردونه آسمان، که پشت هفت پرده خیال پنهان مانده است، نیافته است."],[492,"خود را به زیر چنگل شاهین عشق تو","عنقای صبر من پر و بالی نیافته","عشق تو مانند شاهینی قوی است که مرا به دام انداخته و نتوانسته‌ام صبر کنم و هیچ راه فراری برای خود پیدا نکرده‌ام."],[492,"تا کی ز درد عشق تو نالد روان من","روزی به لطف از تو مثالی نیافته","روح من تا کی باید از درد عشق تو ناله کند؟ هر روز امیدوارم که لطافتی از تو ببینم، اما تا کنون نمونه‌ای از آن نیافته‌ام."],[492,"افتاده در زبان خلایق حدیث من","با تو به یک حدیث مجالی نیافته","داستان عشق من و تو به قدری پیچیده و عمیق است که تا کنون هیچ کس نتوانسته آن را به درستی بیان کند و هیچ فرصتی برای شرح و بسط آن پیدا نکرده است."],[492,"زایل شود هر آن چه به کلی کمال یافت","عمرم زوال یافت کمالی نیافته","هر چیزی که به کمال و تمامیت برسد، در نهایت زائل و نابود می‌شود؛ عمر من هم به سر آمده و من هیچ کمال و برتری خاصی نتوانسته‌ام به دست آورم."],[492,"گلبرگ عیش من به چه امید بشکفد","از بوستان وصل شمالی نیافته","من چه امیدی می‌توانم داشته باشم که گلبرگ شادی‌های من شکوفا شود، در حالی که هنوز به وصل دلخواهم دست نیافته‌ام (و نسیمی از باغ وصال به من نرسیده است)؟"],[492,"سعدی هزار جامه به روزی قبا کند","یک مهربانی از تو به سالی نیافته","سعدی همیشه تلاش کرده که با هزاران شیوه و لباس، خود را بیاراید، اما هیچ وقت یک مهربانی واقعی از تو در طول یک سال نصیبش نشده است."],[493,"سرمست بتی، لطیف، ساده","در دست گرفته جام باده","شخصی مست با خوشحالی، چون بتی زیبا و ساده، در حال نوشیدن شراب است. (AI: شخصی مست با خوشحالی بتی زیبا و ساده را در دست دارد و در حال نوشیدن شراب است.)"],[493,"در مجلس بزم باده‌نوشان","بسته کمر و قبا گشاده","در مجلس شادمانی و میگساری، کمر به دور خود بسته و لباس خود را باز کرده‌اند."],[493,"افتاده زمین به حضرت او","گردونش به خدمت ایستاده","در برابر آن معشوق با عظمت و مقامش، زمین در حال خم شدن و احترام گذاشتن است و آسمان هم در خدمت او ایستاده است."],[493,"خورشید و مهش ز خوب‌رویی","سر بر خطّ بندگی نهاده","خورشید و ماه به خاطر زیبایی و جمال او، سر به خاک نهادند و خود را به نشانه بندگی در مقابلش زانو زده‌اند."],[493,"خورشید که شاه آسمان است","در عرصه حسن او پیاده","خورشید که نماد زیبایی و روشنی است، در مقابل زیبایی او (معشوق) عاجز و در حال اطاعت است."],[493,"وه وه که بزرگوار حوری‌ست","از روزن جنت اوفتاده","به به! چه بزرگوار و باکرامتی است این حوری که از روزنه بهشت به زمین آمده است."],[493,"لعلش چو عقیق گوهرآگین","زلفش چو کمند تاب داده","لب‌های او مانند عقیق با ارزش است و موهایش همچون دامی پرشکوه و جذاب به نظر می‌رسد."],[493,"در گلشن بوستان رویش","زنگی‌بچگان ز ماه زاده","در باغ پر از گل (چهره‌اش)، بچه‌های زنگی (موهای سیاه) به دنیا آمده (روییده) که از ماه الهام گرفته است."],[493,"سعدی نرسد به یار هرگز","کاو شرمگن است و یار ساده","سعدی به او هرگز نمی‌تواند برسد، زیرا یار او دل ساده و بی‌پیرایه‌ای دارد. (AI: سعدی به کسی که از او خجالت می‌کشد، هرگز نمی‌تواند برسد، زیرا یار او دل ساده و بی‌پیرایه‌ای دارد.)"],[494,"ای یار جفا کرده پیوند بریده","این بود وفاداری و عهد تو ندیده؟","ای دوست که به من ظلم کردی و پیوند محبت را پاره نمودی رسم وفاداری این بود و پیمانی که شکستی و ما ندیدیم."],[494,"در کوی تو معروفم و از روی تو محروم","گرگ دهن‌آلوده یوسف ندریده","مانند گرگی که برادران یوسف (ع) به نزد یعقوب آورده اند و دهانش را با خون کبوتری خونین کردند ولی یوسف را فی الواقعه یوسف را ندریده بود من نیز در کوی تو به عشق تو معروف شده ام ولی از دیدار روی تو بی بهره ام."],[494,"ما هیچ ندیدیم و همه شهر بگفتند","افسانه مجنون به لیلی نرسیده","ما که تو را ندیدیم ولی افسانه عشق مرا مانند افسانه مجنونی که به لیلی نرسید تمام مردم شهر دهان به دهان گفتند."],[494,"در خواب گزیده لب شیرین گل اندام","از خواب نباشد مگر انگشت گزیده","همه شب در خواب لب شیرین زیبا پیکری را به دندان می گیرم و وقتی از خواب بیدار می شوم‌ می بینم که انگشت خودم را به دندان گرفتم."],[494,"بس در طلبت کوشش بی‌فایده کردیم","چون طفل دوان در پی گنجشک پریده","مانند کودکی که به دنبال گنجشک می دود در حالی که آن گنجشک پریده و به شاخ درخت رسیده من نیز در راه رسیدن به تو تلاش های بی فایده ای کرده ام."],[494,"مرغ دل صاحب نظران صید نکردی","الّا به کمان‌مهره ابروی خمیده","تنها با تیر کمان مهره انداز ابروی خود بود که موفق شدی پرنده ی دل روشن بین چون مرا صید کنی."],[494,"میلت به چه ماند؟؛ به خرامیدن طاووس","غمزه‌ت به نگه کردن آهوی رمیده","تمایل به تو به راه رفتن خرامان و آهسته و توام با ناز طاووس می مانند و غمزه ات به نگاه های مظلومانه و پر ترس آهویی که در حال فرار است."],[494,"گر پای به در می‌نهم از نقطه شیراز","ره نیست تو پیرامن من حلقه کشیده","حتی اگر تصمیم بگیرم که از شهر شیراز خارج شوم عشق تو به دور من حلقه ی بسته ای ایجاد کرده است."],[494,"با دست بلورین تو پنجه نتوان کرد","رفتیم دعا گفته و دشنام شنیده","دستان ظریف و مانند بلور تو قوی تر از آن است که بتوان پنجه در پنجه تو انداخت و با تو نبرد کرد لذا ما که رفتیم در حالی که تو را دعا کنیم و از تو دشنام شنیدیم."],[494,"روی تو مبیناد دگر دیده سعدی","گر دیده به کس باز کند روی تو دیده","اگر بعد از دیدن روی تو سعدی چشمان خود را به روی دگری باز کند امیدوارم که چشمانش کور شود و دیگر از دیدن روی تو محروم شود."],[495,"می‌برزند ز مشرق، شمع فلک زبانه","ای ساقی صبوحی! در ده می شبانه","شمع آسمان (خورشید) از سمت شرق روشن می‌شود؛ ای ساقی شراب صبحگاهی، می‌ شبانگاهی بیاور. (AI: شمع آسمان از سمت شرق روشن می‌شود و در این تاریکی شب، ای ساقی، می‌ای برای ناشنوایان بیاور.)"],[495,"عقلم بدزد لختی، چند اختیار دانش؟","هوشم ببر زمانی، تا کی غم زمانه؟","برای لحظه‌ای عقل و دانش مرا بدزد، چون چه فایده‌ای دارد که اختیار آن‌ها را داشته باشم؟ بگذار هوش و فراسم را برای مدتی ببرند، تا چه زمانی باید غم و اندوه دنیای خود را بر دوش بکشم؟"],[495,"گر سنگ فتنه بارد، فرق منش سپر کن","ور تیر طعنه آید، جان منش نشانه","اگر مشکلات و حوادث سخت به سراغت بیاید، فرق سر مرا سپر کن و اگر تهمت و کنایه به تو زده شود، جان مرا هدف قرار بده. (AI: اگر مشکلات و حوادث سخت به سراغت بیاید، از خودت محافظت کن و اگر تهمت و کنایه به تو زده شود، نشان بده که این مسائل تاثیری بر روی تو ندارد.)"],[495,"گر می به جان دهندت، بستان که پیش دانا","زآب حیات بهتر، خاک شراب‌خانه","حمیدرضا باصفا: انسان دانا؛ شراب عشق را بر هر چیزی ترجیح می دهد؛ چرا که خاک میخانه از زندگی جاودانه بهتر است!"],[495,"آن کوزه بر کفم نه، کآب حیات دارد","هم طعم نار دارد، هم رنگ ناردانه","این کوزه‌ای که در دستم است، مایه زندگی دارد و هم طعم انار را می‌دهد و هم رنگ میوه انار را دارد."],[495,"صوفی چگونه گردد، گرد شراب صافی؟","گنجشک را نگنجد، عنقا در آشیانه","صوفی چگونه می‌تواند در کنار شراب خالص باشد؟ مثل این است که یک گنجشک نمی‌تواند پرنده‌ای بزرگ مانند عنقا (پرنده‌ای افسانه‌ای) را در لانه‌اش جای دهد."],[495,"دیوانگان نترسند، از صولت قیامت","بشکیبد اسب چوبین، از سیف و تازیانه","دیوانگان از ترس روز قیامت نترسند؛ زیرا که در آن روز نیز، مانند اسب چوبی، سوار نمی‌شوند و از شمشیر و تازیانه خبری نخواهد بود."],[495,"صوفی و کنج خلوت، سعدی و طرف صحرا","صاحب هنر نگیرد، بر بی‌هنر بهانه","عارف و زاهد از دیگران کناره گرفته و تلاش دارد تا در خلوت خویش معانی زندگانی را کشف کند؛ در حالی که سعدی می‌داند برای دیدن حقایق جهان نیازی به عزلت نشینی نیست. اما سعدی بر صوفیان عیب نمی‌کند. زیرا صوفیان توانایی درک او را ندارند و کسی که دارای درک و شعور بیشتری نسبت به دیگری است، از نادانی او گلایه نمی‌کند."],[496,"ای صورتت ز گوهر معنی خزینه‌ای","ما را ز داغ عشق تو در دل دفینه‌ای","ای زیبایی تو مانند گنجی از گوهر به نظر می‌آیی؛ ما به خاطر عشق تو در دل‌مان به غم و اندوهی عمیق گرفتار شده‌ایم."],[496,"دانی که آه سوختگان را اثر بود","مگذار ناله‌ای که برآید ز سینه‌ای","می‌دانی که آه کسانی که عشقشان سوخته است، تأثیر دارد، پس نگذار که ناله‌ای از دل برآید."],[496,"زیور همان دو رشته مرجان کفایت است","وز موی در کنار و برت عنبرینه‌ای","زیور همان دو رشته مرجان (به عنوان زینتی) برای تو کافی است و دیگر نیازی به زینت‌های بیشتر مثل موی کنار صورتت و عطرهای خوشبو از نوع عنبر (که اشاره به عطر خوشی دارد) نیست."],[496,"سر در نیاورم به سلاطین روزگار","گر من ز بندگان تو باشم کمینه‌ای","هرگز در برابر سلاطین و قدرت‌های زمان سر فرود نمی‌آورم، زیرا اگر من از بندگان تو، معشوقم، باشم، به خودم اجازه نمی‌دهم که به آن‌ها توجه کنم."],[496,"چشمی که جز به روی تو بر می‌کنم خطاست","وآن دم که بی تو می‌گذرانم غبینه‌ای","چشمی که به غیر از تو نگاه کنم اشتباه است و هر لحظه‌ای که بدون تو سپری می‌کنم برای من ضرر است. (AI: چشمی که به غیر از تو نگاه کند اشتباه است و هر لحظه‌ای که بدون تو سپری می‌شود برای من شبیه تاری است.)"],[496,"تدبیر نیست جز سپر انداختن که خصم","سنگی به دست دارد و ما آبگینه‌ای","هیچ تدبیری برای مقابله با دشمنی که سلاحش سنگ است وجود ندارد، جز اینکه خود را به دفاع درآوریم؛ زیرا ما در برابر او به مانند چیزی شکننده و ظریف هستیم."],[496,"وآن را روا بود که زند لاف مهر دوست","کز دل به در کند همه مهری و کینه‌ای","سعدی می‌گوید، این کار درست است که کسی به خاطر ادعای محبت و دوستی لاف بزند، چرا که او می‌تواند از دل، تمام محبت‌ها و کینه‌ها را بیرون کند."],[496,"سعدی به پاکبازی و رندی مثل نشد","تنها در این مدینه که در هر مدینه‌ای","سعدی می‌گوید که پاکی و زیرکی او تنها به این شهر محدود نمی‌شود، بلکه در هر شهری می‌توان شهرت او را یافت. (AI: سعدی می‌گوید که پاکی و زیرکی او تنها به این شهر محدود نمی‌شود، بلکه در هر شهری می‌توان چنین ویژگی‌هایی را یافت.)"],[496,"شعرش چو آب در همه عالم چنان شده","کز پارس می‌رود به خراسان سفینه‌ای","شعر سعدی مانند آبی است که در سراسر جهان جاری شده و از پارس (ایران) به خراسان (منطقه‌ای در ایران) می‌رسد، مثل یک کشتی که در دریا سفر می‌کند."],[497,"خلاف سرو را روزی خرامان سوی بستان آی","دهان چون غنچه بگشای و چو گلبن در گلستان آی","ای انسانی که به سوی باغ بستان برو، برخلاف سرو که به آرامی قدم می‌زند، در روزی بیا و دهانت را مثل غنچه باز کن و همچون گل سرخ در گلستان حاضر شو."],[497,"دمادم حوریان از خلد رضوان می‌فرستندت","که ای حوری انسانی دمی در باغ رضوان آی","حوریان از بهشت در حال به تو دعوت کردن هستند و می‌گویند ای انسان، لحظه‌ای به باغ بهشت بیا."],[497,"گرت اندیشه می‌باشد ز بدگویان بی معنی","چو معنی معجری بربند و چون اندیشه پنهان آی","اگر نگران حرف‌های بی‌پایه و بی‌معنی بدگویان هستی، بهتر است که خود را از آن‌ها دور کنی و همچون معجزه‌ای که به شدت جذاب است، به اندیشه‌های درونی‌ات بپردازی و به درون خود بروی."],[497,"دلم گرد لب لعلت سکندروار می‌گردد","نگویی کآخر ای مسکین فراز آب حیوان آی","دل من به دور لب شیرین و سرخ تو می‌چرخد و مانند سکندر (پادشاه اسکندر که به دنبال جاودانگی بود) در جستجوی آب حیات است. نگویی که ای مسکین (یعنی من خودم) به دنبال چیزی می‌گردم که اصلش وجود ندارد."],[497,"چو عقرب دشمنان داری و من با تو چو میزانم","برای مصلحت ماها ز عقرب سوی میزان آی","اگرچه تو دشمنانی مانند عقرب داری، من مانند ترازوی میزان برای مصلحت ما هستم. پس به طرف ترازوی میزان بیا و از دشمنی‌های خود دور شو."],[497,"جهانی عشقبازانند در عهد سر زلفت","رها کن راه بدعهدی و اندر عهد ایشان آی","عاشقان واقعی در این دنیا وجود دارند؛ پس بهتر است که موهایت را رها کنی واز بی‌وفایی دست برداری و به جمع این عاشق‌ها بپیوندی."],[497,"خوش آمد نیست سعدی را در این زندان جسمانی","اگر تو یک دلی با او چو او در عالم جان آی","سعدی دوست ندارد که در این زندان جسمانی باشد و اگر تو هم با او همدل هستی، باید به دنیای معنوی و روحی بپیوندی مانند او."],[498,"قیمت گل برود چون تو به گلزار آیی","و آب شیرین چو تو در خنده و گفتار آیی","وقتی تو به باغ بیایی، ارزش گل‌ها از بین می‌رود و مانند آب شیرین، لبخند و سخنان تو، همگان را جذب می‌کند."],[498,"این همه جلوه طاووس و خرامیدن او","بار دیگر نکند گر تو به رفتار آیی","اگر تو با رفتار و طرز خودت به این مجلس بیایی، دیگر هیچ جلوه‌ای از طاووس و زیبایی‌اش را نمی‌توان تکرار کرد."],[498,"چند بار آخرت ای دل به نصیحت گفتم","دیده بردوز نباید که گرفتار آیی","ای دل، بارها به تو گفته‌ام که وارد دنیا نشوی و خودت را به سختی نیندازی، زیرا ممکن است به دام بیفتی."],[498,"مه چنین خوب نباشد تو مگر خورشیدی","دل چنین سخت نباشد تو مگر خارایی","ای دل، تو مثل ماه هم زیبا نیستی مگر اینکه مانند خورشید درخشان باشی و تو هم نباید دلی به این سختی داشته باشی مگر اینکه مانند خارها آسیب‌پذیر باشی."],[498,"گر تو صد بار بیایی به سر کشته عشق","چشم باشد مترصد که دگربار آیی","اگر تو صد بار به سراغ محبوبی که عاشقش هستم بیایی، چشم‌های من همیشه در انتظارند تا بار دیگر به تو نگاه کنند."],[498,"سپر از تیغ تو در روی کشیدن نهی است","من خصومت نکنم گر تو به پیکار آیی","من در برابر تیغ دفاع نکردن تو سپر از روی نمی‌کنم؛ یعنی حتی اگر تو به جنگ بیایی، من نمی‌خواهم با تو دشمنی کنم."],[498,"کس نماند که به دیدار تو واله نشود","چون تو لعبت ز پس پرده پدیدار آیی","هیچ‌کس نیست که در دیدن تو مجنون و شیفته نشود، زمانی که تو به عنوان یک معشوقه از پس پرده ظاهر شوی."],[498,"دیگر ای باد حدیث گل و سنبل نکنی","گر بر آن سنبل زلف و گل رخسار آیی","دیگر ای باد، دیگر از عشق و زیبایی گل و سنبل حرف نزن، زیرا اگر تو بر آن زلفی که شبیه سنبل و بر آن چهره‌ای که مانند گل است بیایی، همه حرف‌ها و داستان‌ها خود به خود بی‌معنا می‌شود."],[498,"دوست دارم که کست دوست ندارد جز من","حیف باشد که تو در خاطر اغیار آیی","دوست دارم کسی را که فقط من را دوست داشته باشد. چه حیف است که تو در دل و یاد دیگران باشی."],[498,"سعدیا دختر انفاس تو بس دل ببرد","به چنین صورت و معنی که تو می‌آرایی","سعدی، تو به قدری زیبایی و جذابیت داری که هر دختری می‌تواند دل دیگران را ببرد. زیبایی و معنای وجود تو چنان است که در هر شکل و ظاهری که داشته باشی تأثیرگذار است."],[499,"خرم آن روز که چون گل به چمن بازآیی","یا به بستان به در حجره من بازآیی","روز خوشی خواهد بود که تو مثل گل به باغ برگردی یا به باغ (بستان) و در اتاق من بیایی."],[499,"گلبن عیش من آن روز شکفتن گیرد","که تو چون سرو خرامان به چمن بازآیی","سرور و شادی من آن روز آغاز می‌شود که تو مانند سرو زیبایی به باغ برگردی و جلوه‌گر شوی."],[499,"شمع من، روز نیامد، که شبم بفروزی؟","جان من، وقت نیامد که به تن بازآیی؟","شمع من، آن روز (یک روزی، یک وقتی) فرا نرسید که شب مرا با آمدنت بیافروزی؟ (یا، شمع من، آن روز، فرانرسید. پس، چه کسی شب مرا بیافروزد؟) جان من، وقت آن نرسید که به تن بازآیی؟ («جان من» هم به معنی عزیز من و هم به معنی جان شاعر که با دادن دل و جان، امید دارد، که جانش به تن بازگردد. گویی، بی او، شاعر خود را مرده و بی‌جان می‌یابد.)"],[499,"آب تلخ است مدامم چو صراحی در حلق","تا تو یک روز چو ساغر به دهن بازآیی","حال من به اندازه یک صراحی (ظرف شراب) است که همیشه تلخ و ناگوار به نظر می‌رسد، چون هنوز تو نایستی که روزی مانند یک ساغر (جام) به دهان من بیایی و زندگی‌ام را شیرین کنی."],[499,"کی به دیدار من، ای مهرگسل! برخیزی؟","کی به گفتار من، ای عهدشکن! بازآیی؟","ای کسی که مهر و دوستی را می‌شکنی، کی به ملاقات من می‌پاری؟ و ای کسی که به وعده‌های خود وفا نمی‌کنی، کی به گفت‌وگو با من برمی‌گردی؟"],[499,"مرغ سیرآمده‌ای از قفس صحبت و من","دام زاری بنهم بو که به من بازآیی","من یک پرنده‌ای هستم که از قفس گفتگو سیر و آزاد شده‌ام و حالا می‌خواهم دام‌های زاری برای تو پهن کنم، تا شاید دوباره به من برگردی."],[499,"من خود آن بخت ندارم که به تو پیوندم","نه تو آن لطف نداری که به من بازآیی","من شانس و بختی ندارم که به تو وصل شوم، و تو نیز آن‌قدر محبت نداری که به من برگردی."],[499,"سعدی آن دیو نباشد که به افسون برود","هیچت افتد که چو مردم به سخن بازآیی","سعدی نمی‌خواهد مانند دیوی باشد که به فریب و افسون دیگران را به خود می‌کشاند. او می‌گوید هیچ دلیلی نیست که تو مثل انسان‌ها به من برگردی و با سخن و گفت‌وگو بیایی."],[500,"تا کی‌ام انتظار فرمایی","وقت نامد که روی بنمایی؟","چقدر باید منتظر بمانم تا تو مرا فرا بخوانی؟ زمان آن فرا نرسیده که چهره‌ات را به من نشان دهی؟"],[500,"اگرم زنده باز خواهی دید","رنجه شو پیش‌تر چرا نایی؟","اگر می‌خواهی دوباره مرا زنده ببینی، چرا پیش از این زحمت نمی‌کشی و به سراغ من نمی‌ای؟"],[500,"عمر کوته‌تر است از آن که تو نیز","در درازی وعده افزایی","عمر انسان کوتاه‌تر از آن است که تو بخواهی در این مدت طولانی رویای وعده‌ها را افزایش دهی."],[500,"از تو کی برخورم که در وعده","سپری گشت عهد برنایی؟","من کی می‌توانم به تو دسترسی پیدا کنم، در حالی که زمان زیادی گذشته و وعده‌ات بی‌عمل مانده است؟"],[500,"نرسیدیم در تو و نرسد","هیچ بیچاره را شکیبایی","ما به سرانجامی در عشق تو نرسیدیم و هیچ کس دیگر هم در تاب و توانایی برای تحمل این وضعیت نیست."],[500,"به سر راهت آورم هر شب","دیده‌ای در وداع بینایی","هر شب در مسیر تو، چشمانم را در حالت وداع قرار می‌دهم تا تو را ببینم."],[500,"روز من شب شود و شب روزم","چون ببندی نقاب و بگشایی","هر زمان که تو نقابت را ببندید و زمانی دیگر آن را باز کنی، روز من به شب تبدیل می‌شود و شب من به روز."],[500,"بر رخ سعدی از خیال تو دوش","زرگری بود و سیم پالایی","دوش که خواب بودم، بر چهره سعدی، تصویر تو به‌قدری زیبا بود که همچون جواهرسازی روی صورتش طلا و نقره کار کرده باشد."],[501,"تو از هر در که بازآیی، بدین خوبی و زیبایی","دری باشد که از رحمت، به روی خلق بگشایی","هر جا که تو ورود کنی، به خاطر زیبایی‌ات، در اینجا در جدیدی خواهد بود که نعمت و رحمت را به روی مردم می‌گشاید."],[501,"ملامت‌گوی بی‌حاصل، ترنج از دست نشناسد","در آن معرض که چون یوسف، جمال از پرده بنمایی","نقد سرزنش‌کننده بی‌فایده است، چون او دستش را از میوه بالنگ باز‌نمی‌شناسد وقتی زیبایی مانند تو همچون یوسف از پس پرده نمایان می‌شود. / تلمیح: داستان یوسف و زلیخا غزل 5 بیت 3 / (AI: نقد و سرزنش بی‌فایده است، مانند میوه‌ای که از دست رفته‌است. در چنین زمانی، وقتی زیبایی مانند یوسف از پس پرده نمایان می‌شود، هیچ کس به انتقاد نمی‌پردازد.)"],[501,"به زیورها بیآرایند وقتی خوب‌رویان را","تو سیمین‌تن چنان خوبی، که زیورها بیآرایی","به زیبایی تو، آن‌قدر دل‌ربا و چشم‌نواز هستی که حتی زیورآلات هم در کنار تو زیبا به نظر می‌رسند و نیاز به تزیین ندارند."],[501,"چو بلبل روی گل بیند، زبانش در حدیث آید","مرا در رویت از حیرت، فروبسته‌ست گویایی","چون بلبل وقتی که گل را می‌بیند، زبانش به صحبت باز می‌شود، اما در مورد تو به دلیل شگفتی‌ای که از زیبایی‌ات دارم، نمی‌توانم چیزی بگویم و سخن‌گفتن برایم ممکن نیست."],[501,"تو با این حسن نتوانی، که روی از خلق درپوشی","که همچون آفتاب از جام و حور از جامه پیدایی","تو با این زیبایی نمی‌توانی که از دید مردم پنهان بمانی، چرا که مانند آفتاب از زیر لیوان و مانند حوری از زیر لباس خود را نشان می‌دهی."],[501,"تو صاحب منصبی جانا! ز مسکینان نیندیشی","تو خواب‌آلوده‌ای، بر چشم بیداران نبخشایی","ای دوست، تو که مقام و جایگاهی داری، به فکر فقیران نیستی. در خواب و غفلت به سر می‌بری و نمی‌توانی به چشمان بیدار و هوشیار رحم کنی."],[501,"گرفتم سرو آزادی نه از ماء مهین زادی؟","مکن بیگانگی با ما، چو دانستی که از مایی","بر فرض که مانند سرو آزاد هستی، آیا از ماء مهین زاده نشدی؟! پس چرا با من بیگانه رفتار می‌کنی، در حالی که می‌دانی ما چه ارتباط نزدیکی داریم و از یک جنس هستیم. / ماء مهین: اشاره است به نطفه / (AI: من آزادی را از هیچ چیزی جز نرمی و لطافت نمی‌خواهم؛ پس چرا با من بیگانه رفتار می‌کنی، در حالی که می‌دانی ما چه ارتباط نزدیکی داریم؟)"],[501,"دعایی گر نمی‌گویی، به دشنامی عزیزم کن","که گر تلخ است، شیرین است، از آن لب هر چه فرمایی","اگر دعایی برای من نمی‌کنی، با دشنام هم مرا عزیز و گرامی بدار، چون حتی اگر آن دشنام تلخ باشد، از لب تو شیرین و دل‌چسب است، هر چه که بگویی."],[501,"گمان از تشنگی بردم، که دریا تا کمر باشد","چو پایانم برفت اکنون، بدانستم که دریایی","تشنه‌ی عشق و وصال تو بودم و فکر کردم به دست آوردن تو کار راحتی است، ولی وقتی به ورطه عشق تو افتادم آنگاه متوجه شدم عشق تو چقدر ژرف و عمیق است و به راحتی نمی‌توان به تو رسید. (پایاب: قسمتی از رودخانه که عمق کمتری دارد و در جای دیگه: اکنون همان پنداشتم دریای بی‌پایاب را)"],[501,"تو خواهی آستین افشان و خواهی روی درهم کش","مگس جایی نخواهد رفتن از دکان حلوایی","تو هر طور که بخواهی، یا آستین خود را به طور خوشحال افشان می‌کنی و یا با چهره‌ای درهم و ناراحت نشان می‌دهی، اما این مگس (اشاره به مگس که به شیرینی و حلاوت اشاره دارد) هرگز از دکان شیرینی‌فروش نخواهد رفت."],[501,"قیامت می‌کنی سعدی! بدین شیرین سخن گفتن","مسلم نیست طوطی را، در ایامت شکرخایی","سعدی، تو با این به زبان آوردن کلمات شیرین و دلنشین، به طور غیرقابل انکاری در روز قیامت (تعبیر از روز رستاخیز و حساب و کتاب) شکرگزاری می‌کنی، زیرا چنین سخن گفتنی از طوطی (که نماد سخن‌وری است) ساخته نیست."],[502,"تو با این لطف طبع و دل‌ربایی","چنین سنگین‌دل و سرکش چرایی؟","چرا با داشتن این همه محبت و جذابیت، اینقدر سخت‌دل و سرکش هستی؟"],[502,"به یک بار از جهان دل در تو بستم","ندانستم که پیمانم نپایی","من یک‌باره دل را به تو سپردم، اما نمی‌دانستم که این پیمان و عشق تو پابرجا نخواهد ماند."],[502,"شب تاریک هجرانم بفرسود","یکی از در درآی ای روشنایی","در شب تاریکی که به خاطر دوری معشوق به سر می‌برم، یکی از در وارد شو، ای روشنی و امید من."],[502,"سری دارم مهیا بر کف دست","که در پایت فشانم چون درآیی","سرم را آماده کرده‌ام تا آن را بر کف دستم بگذارم و وقتی تو به نزد من بیایی، آن را به پای تو بریزم."],[502,"خطای محض باشد با تو گفتن","حدیث حسن خوبان ختایی","گفتن درباره زیبایی‌های خوبان به تو، کاملا اشتباه و نادرست است، زیرا این کار نشانه بی‌وفایی و سستی عشق است."],[502,"نگاری سخت محبوبی و مطبوع","ولیکن سست‌مهر و بی‌وفایی","معشوقی که توصیف می‌شود بسیار زیبا و دل‌نشین است، اما در عین حال بی‌وفا و سست‌مهر است."],[502,"دلا گر عاشقی دائم بر آن باش","که سختی بینی و جور آزمایی","ای دل، اگر عاشق هستی، همواره بر این باور باش که ممکن است رنج دردناک و سختی‌های زیادی را تجربه کنی و تحت فشار و آزمایش قرار بگیری."],[502,"و گر طاقت نداری جور مخدوم","برو سعدی که خدمت را نشایی","اگر طاقت تحمل بدی‌های معشوق را نداری، به سوی سعدی برو، چون خدمت به معشوق کار آسانی نیست."],[503,"تو پری‌زاده ندانم ز کجا می‌آیی","کآدمیزاده نباشد به چنین زیبایی","تو مانند پریزادی هستی که نمی‌دانم از کجا آمده‌ای، چون هیچ انسانی نمی‌تواند به این اندازه زیبا باشد."],[503,"راست خواهی نه حلال است که پنهان دارند","مثل این روی و نشاید که به کس بنمایی","اگر راست بگوییم، پنهان نگه‌داشتن تو زیبایی‌ات حلال نیست، و همچنین شایسته نیست که تو را به کسی نشان ندهند."],[503,"سرو با قامت زیبای تو در مجلس باغ","نتواند که کند دعوی هم‌بالایی","با وجود زیبایی و قامت دلربای تو، هیچ درخت سرو (که نماد زیبایی است) در باغ نمی‌تواند ادعای برابری با تو را داشته باشد."],[503,"در سراپای وجودت هنری نیست که نیست","عیبت آن است که بر بنده نمی‌بخشایی","در تمام وجود تو هیچ هنری نیست که وجود نداشته باشد، عیب تو این است که برای بنده‌ای مانند من، آن هنرت را نمی‌بخشی."],[503,"به خدا بر تو که خون من بیچاره مریز","که من آن قدر ندارم که تو دست آلایی","به خدا قسم، بر تو ای محبوب، نریز خون من بیچاره را، چرا که من به اندازه‌ای ندارم که دست تو را آلوده کنم."],[503,"بی رخت چشم ندارم که جهانی بینم","به دو چشمت که ز چشمم مرو ای بینایی","من بدون چهره تو قادر به دیدن جهان نیستم، زیرا تنها با نگاه توست که می‌توانم به زیبایی‌ها بنگرم. از تو می‌خواهم که مرا از دیدار خود دور نکنید، ای بینا."],[503,"نه مرا حسرت جاه است و نه اندیشه مال","همه اسباب مهیاست تو در می‌بایی؟","من نه به مقام و ثروت فکر می‌کنم و نه برایم اهمیتی دارد؛ آیا تو می‌دانی که همه چیز برای من مهیا است و تنها تویی که در میخانه نوشیدنی (عشق) داری؟"],[503,"بر من از دست تو چندان که جفا می‌آید","خوش‌تر و خوب‌تر اندر نظرم می‌آیی","هرچقدر که از تو آزار و اذیت ببینم، برایم جذاب‌تر و زیباتر به نظر می‌رسد."],[503,"دیگری نیست که مهر تو در او شاید بست","چاره بعد از تو ندانیم به جز تنهایی","هیچ‌کس جز من قادر به دوستی و محبت تو نیست، و پس از رفتنت نمی‌دانم چگونه به جز تحمل تنهایی زندگی کنم."],[503,"ور به خواری ز در خویش برانی ما را","همچنان شکر کنیمت که عزیز مایی","اگر ما را به خواری و ذلت هم از در خود بیرون کنی، باز هم تو را شکر می‌گوییم چون هنوز برای ما عزیز هستی."],[503,"من از این در به جفا روی نخواهم پیچید","گر ببندی تو به روی من و گر بگشایی","حتی اگر تو در را به روی من ببندی و مرا طرد کنی، من به خاطر بدرفتاری‌ات از این در دور نخواهم شد و باز نخواهم گشت. گرچه برایم رنج‌آور است، اما بهت را ترک نخواهم کرد."],[503,"چه کند داعی دولت که قبولش نکنند","ما حریصیم به خدمت تو نمی‌فرمایی","آنچه که دعوت‌کننده به خدمت تو می‌کند، چه فایده‌ای دارد اگر کسی آن را نپذیرد؟ ما برای خدمت به تو اشتیاق داریم، اما تو ما را نمی‌پذیری."],[503,"سعدیا دختر انفاس تو بس دل ببرد","به چنین زیور معنی که تو می‌آرایی","ای سعدی، سخنان و غزلیات تو دل‌ها را می‌رباید، با این زینتی که تو از معنی برای آنها ایجاد می‌کنی. (AI: ای سعدی، دختران به خاطر زیبایی و جذابیت وجود تو، دل‌ها را می‌ربایند به مانند زینتی که تو برای خود ایجاد می‌کنی.)"],[503,"باد نوروز که بوی گل و سنبل دارد","لطف این باد ندارد که تو می‌پیمایی","باد نوروز با عطر گل و سنبل می‌وزد، اما این لطف خاصی ندارد وقتی که تو سخن‌سرایی می‌کنی. (AI: باد نوروز با عطر گل و سنبل می‌وزد، اما این لطف خاصی ندارد که تو از آن لذت می‌بری.)"],[504,"چه روی است آن که دیدارش ببرد از من شکیبایی","گواهی می‌دهد صورت بر اخلاقش به زیبایی","روی دل‌انگیز او به قدری جذاب است که انسان را از صبر و شکیبایی وامی‌دارد. صورت او نشانه‌ای است که اخلاق نیکویش را تأیید می‌کند و زیبایی او را بیشتر به نمایش می‌گذارد."],[504,"نگارینا به هر تندی که می‌خواهی جوابم ده","اگر تلخ اتفاق افتد به شیرینی بیندایی","ای محبوب من، هر طور که می‌خواهی می‌توانی به بی‌رحمی و شدت با من رفتار کنی، اما اگر بخواهی تلخی در این رفتار وجود داشته باشد، آن را با شیرینی خاصی بپوشان."],[504,"دگر چون ناشکیبایی ببینم صادقش خوانم","که من در نفس خویش از تو نمی‌بینم شکیبایی","از این پس هرگاه فرد بی‌تاب و ناآرامی را مشاهده کنم، به او حق می دهم همانطور که خودم از تو هیچ صبر و تحملی ندارم."],[504,"از این پس عیب شیدایان نخواهم کرد و مسکینان","که دانشمند از این صورت بر آرد سر به شیدایی","از این به بعد دیگر به عیب‌جویی از عاشقان نخواهم پرداخت و از مسکینان هم؛ زیرا که با این چهره، سرانجام عالم و دانشمند هم سر به شیدایی و جنون می‌گذارند. (AI: از این به بعد دیگر به عیب‌جویی از عاشقان نخواهم پرداخت و به مسکینان هم که از این حالت سرانجام علم و دانشی به دست می‌آورند، توجهی نخواهم کرد.)"],[504,"چنانم در دلی حاضر که جان در جسم و خون در رگ","فراموشم نه‌ای وقتی که دیگر وقت یاد آیی","همانند جان که به جسم معنا می بخشد و مانند خونی که در رگ جریان دارد در دل من همیشه حضور داری،من هیچگاه تو را از خاطر نبرده ام که بخواهم گاهی از تو یاد کنم"],[504,"شبی خوش هر که می‌خواهد که با جانان به روز آرد","بسی شب روز گرداند به تاریکی و تنهایی","هر کسی که می‌خواهد با معشوقش در روزگار خوشی بگذراند، باید در شب‌های تنهایی و تاریکی بسیار صبر کند و خاطرخواهی کند."],[504,"بیار ای لعبت ساقی بگو ای کودک مطرب","که صوفی در سماع آمد دوتایی کرد یکتایی","بیا ای محبوب، و به من بگو ای نوازنده نوجوان که صوفی در حرکات خود در مستی (سماع) به حالتی رسید که دو چیز را به صورت واحد درآورد."],[504,"سخن پیدا بود سعدی که حدش تا کجا باشد","زبان درکش که منظورت ندارد حد زیبایی","سعدی می‌گوید که او به وضوح صحبت می‌کند و می‌فهمد که چه چیزی را می‌خواهد بگوید، اما باید زبانش را کنترل کند، زیرا زیبایی و جذابیت کلامش قابل توصیف نیست و نمی‌توان برای آن مرز تعیین کرد."],[505,"خبرت خراب‌تر کرد جراحت جدایی","چو خیال آب روشن که به تشنگان نمایی","همانگونه که وقتی خیال و تصویر آب زلال به انسان‌های تشنه نشان دهی تشنگی‌­شان بیشتر می‌شود، خبر و سخن گفتن از تو نیز درد و زخم حاصل از جدایی را برای من بیشتر کرد."],[505,"تو چه ارمغانی آری که به دوستان فرستی؟","چه از این به‌ ارمغانی که تو خویشتن بیایی؟","هیچ نیازی نیست که هدیه‌ای برای دوستان و مشتاقان خود بفرستی، بهترین هدیه و ارمغان وجود نازنین خود تو است که بیایی."],[505,"بشدی و دل ببردی و به دست غم سپردی","شب و روز در خیالی و ندانمت کجایی","رفتی و دل من عاشق را همراه خود بردی و در دست غم رها کردی، با اینکه شب و روز در خیال و ذهن من هستی اما نمی­دانم کجایی."],[505,"دل خویش را بگفتم چو تو دوست می‌گرفتم","نه عجب که خوبرویان بکنند بی‌وفایی","وقتی تو را به عنوان دوست انتخاب می‌کردم، به دل خودم می­گفتم: جای شگفتی نیست اگر زیبارویان بی‌‌وفا باشند."],[505,"تو جفای خود بکردی و نه من نمی‌توانم","که جفا کنم؛ ولیکن نه تو لایق جفایی","تو تمام ظلم و جفایی که می‌توانستی در حق من انجام دهی را انجام دادی، این‌گونه نیست که من نتوانم به تو ظلم کنم اما حقیقت این است که تو سزاوار هیچگونه ظلم و جفا نیستی."],[505,"چه کنند اگر تحمل نکنند زیردستان؟","تو هر آن ستم که خواهی بکنی که پادشایی","تو از آنجا که پادشاه (خوبرویان) هستی هر ستمی که می‌خواهی می‌توانی انجام دهی و انسان‌های زیردست چاره‌ای جز تحمل و بردباری در برابر تو ندارند."],[505,"سخنی که با تو دارم به نسیم صبح گفتم","دگری نمی‌شناسم تو ببر که آشنایی","حرف و کلامی که دوست دارم با تو در میان بگذارم به نسیم صبحگاهی گفتم؛ در واقع آشنا و همنشین دیگری جز نسیم صبحگاه ندارم، ای باد سحر سخنان من را به پیش او ببر چرا که تنها تو آشنای منی."],[505,"من از آن گذشتم ای یار که بشنوم نصیحت","برو ای فقیه و با ما مفروش پارسایی","ای یار من از آن مرحله عبور کرده‌ام که نصیحت کسی را بشنوم؛ ای فقیه تو نیز مرا رها کن و زهد و پاکی خود را به رخ من نکش.(پارسایی فروختن: ادعای پارسایی و پاکدامنی داشتن، پاکی خود را به رخ دیگری کشیدن.)"],[505,"تو که گفته‌ای تأمل نکنم جمال خوبان","بکنی اگر چو سعدی نظری بیازمایی","تویی که می‌‌گویی من به زیبایی زیبارویان هرگز توجه‌­ای نمی‌کنم و فکر خودم را مشغول آنها نمی‌کنم اگر یک­بار نگاهی همچون سعدی به آنها بیفکنی حتما این کار را انجام خواهی داد."],[505,"در چشم بامدادان به بهشت برگشودن","نه چنان لطیف باشد که به دوست برگشایی","اگر در هنگام صبح که چشمان خود را باز می‌کنی به روی بهشت بازکنی چندان لطیف و دلنواز نیست که با گشودن چشم دوست و معشوق خود را ببینی."],[506,"دریچه‌ای ز بهشتش به روی بگشایی","که بامداد پگاهش، تو روی بنمایی","اگر سحر تو چهره‌ات را به کسی نشان دهی، گویی دریچه‌ای از بهشت به روی او باز کرده‌ای. (AI: در اینجا صحبت از گشایش دریچه‌ای است که به بهشت راه دارد. وقتی این دریچه باز شود، بهتر است که در صبح زود، جمال و زیبایی خود را نشان دهی."],[506,"جهان شب است و تو خورشید عالم‌آرایی","صباح مقبل آن کز درش تو بازآیی","دنیا تاریک و شب‌مانند است و تو همانند خورشید زیبایی‌، صبح با اقبال از آن کسی می‌شود که تو از در خانه‌اش وارد شوی. (AI: دنیا تاریک و شب مانند است و تو همانند خورشید زیبایی‌ که صبح نزدیک می‌شود و از در خانه‌ات بازمی‌گردی.)"],[506,"به از تو مادر گیتی به عمر خود فرزند","نیاورد که همین بود حد زیبایی","بهتر از تو، هیچ مادری در جهان فرزندی به دنیا نیاورد، چرا که خود تو معیار و نمونه زیبایی هستی."],[506,"هر آن که با تو وصالش دمی میسر شد","میسرش نشود بعد از آن شکیبایی","هر کسی که لحظه‌ای با تو وصال و نزدیکی پیدا کرد، پس از آن دیگر نمی‌تواند در برابر دوری از تو صبر کند."],[506,"درون پیرهن از غایت لطافت جسم","چو آب صافی در آبگینه پیدایی","بدن او به قدری لطیف و زیباست که مانند آب زلالی که در شیشه‌ای شفاف دیده می‌شود، درون پیرهنش نیز نمایان است."],[506,"مرا مجال سخن بیش در بیان تو نیست","کمال حسن ببندد زبان گویایی","من توان گفتن در مورد تو را ندارم، زیرا زیبایی و کمال تو قادر است زبان هر سخن‌گویی را بند بیاورد و از گفت‌وگو باز دارد."],[506,"ز گفت و گوی عوام احتراز می‌کردم","کزین سپس بنشینم به کنج تنهایی","از حرف‌های مردم عادی دوری می‌جستم، زیرا بعد از این می‌خواهم در گوشه‌ای تنها نشسته و به تفکر بپردازم."],[506,"وفای صحبت جانان به گوش جانم گفت","«نه عاشقی، که حذر می‌کنی ز رسوایی»","وفای دوست (جانان) به من می‌گوید که تو عاشق نیستی، چون از رسوایی پرهیز می‌کنی."],[506,"گذشت بر من از آسیب عشقت آن چه گذشت","هنوز منتظرم تا چه حکم فرمایی","آسیب‌هایی که از عشق تو به من رسید، بسیار بوده و من هنوز در انتظار هستم که ببینم چه دستوری می‌دهی."],[506,"دو روزه باقی عمرم فدای جان تو باد","اگر بکاهی و در عمر خود بیفزایی","دو روز باقی‌مانده از عمرم را فدای جان تو می‌کنم، اگر تو از عمر خود بکاهی و بر عمرت بیفزایی."],[506,"گر او نظر نکند سعدیا به چشم نواخت","به دست سعی تو باد است تا نپیمایی","اگر طرف مقابل (او) به سعدی با چشم مهربانی نگاه نکند، دیگر تلاش تو بی‌فایده است تا به هدف خود نرسی."],[507,"گرم راحت رسانی ور گزایی","محبت بر محبت می‌فزایی","اگر عشق و محبت را به من هدیه بدهی و یا گزند برسانی، محبت من بیشتر خواهد شد. (AI: اگر عشق و محبت را به دیگران هدیه بدهی و آرامش را به آن‌ها برسانی، محبت تو هم بیشتر خواهد شد.)"],[507,"به شمشیر از تو بیگانه نگردم","که هست از دیرگه باز آشنایی","من هرگز از تو قطع ارتباط نمی‌کنم، زیرا با تو از زمان‌های دور آشنا هستم."],[507,"همه مرغان خلاص از بند خواهند","من از قیدت نمی‌خواهم رهایی","همه پرندگان می‌خواهند از قید و بند آزاد شوند، اما من از عشق و وابستگی‌ات نمی‌خواهم رها شوم."],[507,"عقوبت هرچ از آن دشوارتر نیست","بر آنم صبر هست الا جدایی","هر عذابی که از آن دشوارتر باشد، بر من صبر است، جز جدایی از تو که برایم غیرقابل تحمل است."],[507,"اگر بیگانگان تشریف بخشند","هنوز از دوستان خوشتر گدایی","اگر کسانی غیر از دوستان به ما محبت کنند، هنوز خدمت و محبت دوستان برای ما ارزش بیشتری دارد."],[507,"منم جانا و جانی بر لب از شوق","بده گر بوسه‌ای داری بهایی","من به تو، ای محبوب، بسیار علاقه‌مندم و آن‌قدر در شوق تو هستم که جانم در خطر است. اگر بوسه‌ای از تو می‌خواهی، خواهش می‌کنم بی‌آنکه چیزی از من بخواهی، به من عطا کن."],[507,"کسانی عیب ما بینند و گویند","که روحانی ندانند از هوایی","برخی از مردم عیب و نقص ما را می‌بینند و می‌گویند که او عابد و روحانی است، اما از حال و هوای درونی او خبری ندارند."],[507,"جمیع پارسایان گو بدانند","که سعدی توبه کرد از پارسایی","همه عابدان و پارسایان بدانند که سعدی از زهد و پارسایی خود توبه کرده است."],[507,"چنان از خمر و زمر و نای و ناقوس","نمی‌ترسم که از زهد ریایی","من از شراب و موسیقی و صدای ناقوس نمی‌ترسم، بلکه بیشتر از ریاکاری و ظاهرسازی مذهبی می‌ترسم."],[508,"مشتاق توام با همه جوری و جفایی","محبوب منی با همه جرمی و خطایی","من به شدت از تو انتظار دارم و به عشق تو دلبسته‌ام، در حالی که می‌دانم تو محبوب منی با تمام عیوب و اشتباهاتم."],[508,"من خود به چه ارزم که تمنای تو ورزم","در حضرت سلطان که برد نام گدایی","من ارزش و قیمتی برای خود نمی‌بینم که بخواهم به درگاه تو درخواست کنم، زیرا در پیشگاه سلطان، حتی درخواست کردن به عنوان یک گدا نیز بی‌مقدار است."],[508,"صاحب نظران لاف محبت نپسندند","وان گه سپر انداختن از تیر بلایی","عاشقان واقعی محبت را ارزشمند می‌دانند و هیچ‌گاه وقتی که دچار درد و مصیبت شوند، از عشق و علاقه خود دست برنمی‌دارند."],[508,"باید که سری در نظرش هیچ نیرزد","آن کس که نهد در طلب وصل تو پایی","کسی که برای رسیدن به تو قدم برمی‌دارد، باید سر در نظرش هیچ ارزشی نداشته باشد. (AI: کسی که برای رسیدن به تو قدم برمی‌دارد، باید ارجی والا در نظرش داشته باشد وگرنه ارزش ندارد که حتی به یادش بیفتی.)"],[508,"بیداد تو عدلست و جفای تو کرامت","دشنام تو خوشتر که ز بیگانه دعایی","ستم تو در واقع عدل به حساب می‌آید و بی‌احترامی تو نوعی بزرگ‌منشی است. دشنام تو برای من شیرین‌تر است از دعای کسی بیگانه."],[508,"جز عهد و وفای تو که محلول نگردد","هر عهد که بستم هوسی بود و هوایی","غیر از پایبندی به عهد و وفای تو، هیچ یک از وعده‌هایی که بستم واقعی نیستند و فقط بر پایه امیال و هوس‌ها بوده‌اند."],[508,"گر دست دهد دولت آنم که سر خویش","در پای سمند تو کنم نعل بهایی","اگر فرصت به من اجازه دهد، تمنا دارم که جانم را در پای اسب تو فدای تو کنم و در عوض دستاوردی که به دست می‌آورم، فقط نعل (کفش) این اسب کافی است."],[508,"شاید که به خون بر سر خاکم بنویسند","این بود که با دوست به سر برد وفایی","شاید بر روی خاک من بنویسند که من به خاطر دوست، زندگی‌ام را با وفا سپری کردم و در نهایت بعد از مرگم به خاطر این وفاداری به خون خود آغشته شدم."],[508,"خون در دل آزرده نهان چند بماند","شک نیست که سر برکند این درد به جایی","درد و رنجی که در دل دارم، دیگر نمی‌تواند مدت زیادی پنهان بماند. به یقین، این درد روزی به جایی خواهد رسید و سرانجام او را از بین می‌برد."],[508,"شرط کرم آنست که با درد بمیری","سعدی و نخواهی ز در خلق دوایی","سعدی می‌گوید که شرط بزرگواری این است که انسان با درد و رنج زندگی کند و به فکر درمان خود از طرف دیگران نباشد."],[509,"من ندانستم از اول که تو بی مهر و وفایی","عهد نابستن از آن به که ببندی و نپایی","من از همان ابتدا نمی دانستم که تو وفادار نیستی و بی محبتی. پیمان نبستن بهتر از آن است که ببندی و به آن پایبند نباشی."],[509,"دوستان عیب کنندم که «چرا دل به تو دادم؟»","باید اول به تو گفتن که «چنین خوب چرایی؟»","دوستان به من ایراد می‌گیرند که چرا دل به تو سپردم. اما ابتدا باید از تو پرسید که چرا اینقدر خوب هستی."],[509,"ای که گفتی «مرو اندر پی خوبان زمانه»","ما کجاییم در این بحر تفکر، تو کجایی؟","ای کسی که به من گفتی که به دنبال زیبارویان نروم،در دریای وسیع اندیشه،ما چقدر عمیق و ظریف می اندیشیم و تو چقدر کوتاه نظر هستی"],[509,"آن نه خالست و زنخدان و سر زلف پریشان","که دل اهل نظر برد؛ که سرّیست خدایی","دل روشن فکران را خال و شانه و زلف زیبارویان نبرده است بلکه یک راز الهی ست."],[509,"پرده بردار که بیگانه خود این روی نبیند","تو بزرگی و در آیینه کوچک، ننمایی","پرده را از رویت بردار زیرا بیگانگان توانایی دیدن روی تو را ندارند تو آنقدر بزرگی که در آینه چشمان انسان های کوچک دیده نمی شوی."],[509,"حلقه بر در نتوانم زدن از دست رقیبان","این توانم که بیایم به محلت به گدایی","از ترس رقبا نمی توان در خانه تو را بکوبم ولی می توانم به بهانه گدایی به کوی تو بیایم."],[509,"عشق و درویشی و انگشت‌نمایی و ملامت","همه سهلست؛ تحمل نکنم بار جدایی","عشق زندگی زاهدانه انگشتمایه دیگران شدند و سرزنش دیگران را شنیدن همه آسان است تنها چیز قابل تحمل بدوش کشیدن بار جدایی توست."],[509,"روز صحرا و سماعست و لب جوی و تماشا","در همه شهر دلی نیست که دیگر بربایی","امروز روز زیبایی ست که به لب جوی و تماشای مناظر رفته و مشغول رقص و پایکوبی هستیم در تمام شهر دیگر دلی وجود ندارد که توسط تو ربوده نشده باشد."],[509,"گفته بودم چو بیایی غم دل با تو بگویم","چه بگویم که غم از دل برود چون تو بیایی","پیش از این به تو گفته بودم که بیایی غم های دلم را برایت باز گویم و اکنون که آمده ای غمی وجود ندارد بنابراین نمی دانم چه بگویم?"],[509,"شمع را باید از این خانه به در بردن و کشتن","تا به همسایه نگوید که تو در خانه مایی","باید شمع را به بیرون از خانه ببرم و آن را خاموش کنم تا همسایگان گمان کنند که تو را مشایعت کرده ام و تو از پیشم رفته ای نفهمند که تو هنوز در خانه ی مایی."],[509,"سعدی آن نیست که هرگز ز کمندت بگریزد","که بدانست که در بند تو خوش‌تر که رهایی","سعدی آن کسی نیست که از بند تو فرار کند زیرا می داند که زندگی در اسارت تو شیرین تر از زندگی در آزادی ست."],[509,"خلق گویند «برو دل به هوای دگری ده»","نکنم؛ خاصه در ایام اتابک، دوهوایی","مردم می گویند برو عاشق شخص دیگری شو ولی این روزها بخصوص در روزهایی که اتابک اعظم فرمانروای شهر است خیال خیانت ندارم."],[510,"نه من تنها گرفتارم به دام زلف زیبایی","که هر کس با دلآرامی سری دارند و سودایی","من تنها گرفتار زلف زیبای این معشوق نیستم، بلکه هر کسی که دل را به آرامش می‌آورد، هم دلداده و دچار عشق اوست."],[510,"قرین یار زیبا را چه پروای چمن باشد؟","هزاران سرو بستانی فدای سروبالایی","وقتی با یار زیبایی هم‌نشین شده‌ام، برای چه به چمن و زیبایی‌های آن اهمیت بدهم؟ هزاران سرو قد بلند در باغ وجود دارند، اما زیبایی یار من ارزش بیشتری دارد."],[510,"مرا نسبت به شیدایی کند ماه پری‌پیکر","تو دل با خویشتن داری، چه دانی حال شیدایی","محبوب تو که زیبایی مانند ماه دارد، باعث شده که من در حالت شیدایی عاشقی به سر ببرم؛ اما تو در دل خودت آرام و بی‌خیال هستی و خبری از حال و روز عاشق نیستی."],[510,"همی‌دانم که فریادم به گوشش می‌رسد لیکن","ملولی را چه غم دارد ز حال ناشکیبایی","می‌دانم که صدای فریاد من به او می‌رسد، اما او که دلی شاد دارد، چه اهمیتی به حال کسی که طاقت ندارد می‌دهد؟"],[510,"عجب دارند یارانم که دستش را همی‌بوسم","ندیدستند مسکینان سری افتاده در پایی","یارانم تعجب می‌کنند که چرا من دست او را می‌بوسم، این حال را نمی‌فهمند و به نظرشان وضعیت من حقیرانه است، در حالی که من به عشق او بسیار خاضع و تسلیم شده‌ام."],[510,"اگر فرهاد را حاصل نشد پیوند با شیرین","نه آخر جان شیرینش برآمد در تمنایی","اگر فرهاد نتوانست به وصال شیرین برسد، این بدان معنا نیست که جان شیرین او در آرزوی ملاقات با شیرین به پایان رسیده است."],[510,"خرد با عشق می‌کوشد که وی را در کمند آرد","ولیکن بر نمی‌آید ضعیفی با توانایی","عقل سعی می‌کند تا عشق را در دام خود بگیرد، اما نمی‌تواند؛ زیرا هیچ فرد ناتوانی نمی‌تواند با افراد توانا مقابله کند."],[510,"مرا وقتی ز نزدیکان ملامت سخت می‌آمد","نترسم دیگر از باران که افتادم به دریایی","زمانی که از دوستان و نزدیکان ملامت و سرزنش شدیدی می‌شنیدم، خیلی ناراحت می‌شدم، اما اکنون دیگر از مشکلات و سختی‌ها نترسیدم، چرا که مثل این است که وارد دریای عمیق شده‌ام."],[510,"تو خواهی خشم بر ما گیر و خواهی چشم بر ما کن","که ما را با کسی دیگر نمانده‌ست از تو پروایی","هر طور که بخواهی می‌توانی با ما خشمگین باشی یا به ما نگاه کنی، چون ما دیگر نسبت به هیچ‌کس جز تو دغدغه و نگرانی نداریم."],[510,"نپندارم که سعدی را بیآزاری و بگذاری","که بعد از سایه لطفت ندارد در جهان جایی","نمی‌توانم باور کنم که تو به سعدی آسیب برسانی و او را تنها بگذاری، چون بعد از محبتی که از سوی تو دارد، در دنیا جایی برای زندگی نخواهد داشت."],[510,"من آن خاک وفادارم که از من بوی مهر آید","و گر بادم برد چون شعر هر جزوی به اقصایی","من انسانی وفادار هستم که از من بوی محبت و عشق به مشام می‌رسد، و اگر روزی هم از من دور شوی، مانند بوی خوش شعر، یاد و خاطره‌ام در دوردست‌ها باقی خواهد ماند."],[511,"هر کس به تماشایی، رفتند به صحرایی","ما را که تو منظوری، خاطر نرود جایی","هر کسی به تماشای زیبایی‌های طبیعت و دشت‌ها به یک جایی رفته است. اما من هر جا که باشم باز خاطرم پیش توست که تو در نظر و منظور منی."],[511,"یا چشم نمی‌بیند یا راه نمی‌داند","هر کاو به وجود خود، دارد ز تو پروایی","یا اینکه چشم‌ها به درستی نمی‌بینند، یا اینکه راه درست را نمی‌شناسند. هر کسی که از تو دوری می‌گزیند."],[511,"دیوانه عشقت را، جایی نظر افتاده‌ست","کآن جا نتواند رفت، اندیشه دانایی","عشاق دیوانه تو را جایی دیده‌اند که او نمی‌تواند به آنجا برود؛ این جا تنها سوالی از دانایی و آگاهی است، چراکه او خود را در این عشق گرفتار کرده است."],[511,"امید تو بیرون برد، از دل همه امیدی","سودای تو خالی کرد، از سر همه سودایی","امید تو باعث شده که همه امیدهایم را کنار بگذارم و دیوانگی‌ام نسبت به تو، تمام آرزوهایم را از سرم بیرون کرده است."],[511,"زیبا ننماید سرو، اندر نظر عقلش","آن کش نظری باشد، با قامت زیبایی","سرو به خودی خود زیبا به نظر نمی‌رسد، اگر عقل انسانی نظری بیندازد، زیرا آن زیبایی فقط با قامت دلربا و دلشکستگی قابل درک است."],[511,"گویند رفیقانم «در عشق چه سر داری؟»","گویم که «سری دارم, درباخته در پایی»","دوستانم می‌پرسند که در عشق چه فکری داری؟ من پاسخ می‌دهم که سری دارم که با تمام وجودم آن را به زیر پای او انداخته‌ام. (AI: دوستانم می‌پرسند که در عشق چه رازی داری، من پاسخ می‌دهم که رازی دارم که تمام وجودم را به پای آن گذاشته‌ام.)"],[511,"زنهار نمی‌خواهم کز کشتن امانم ده","تا سیرترت بینم، یک لحظه مدارایی","درخواست دارم که در این عشق، از کشتن مرا نجات ندهی و به من امان ندهی، زیرا می‌خواهم بیشتر از تو بی‌نهایت زیبا را ببینم، بنابراین فقط یک لحظه به من رحم نکن."],[511,"در پارس که تا بوده‌ست، از ولوله آسوده‌ست","بیم است که برخیزد، از حسن تو غوغایی","در سرزمین پارس از قدیم‌الایام، مردم در آرامش بوده‌اند و هیچ شلوغی و سر و صدایی نداشته‌اند. اما اکنون بیم آن می‌رود که با ظهور زیبایی تو، این آرامش بر هم بخورد و غوغایی به پا شود."],[511,"من دست نخواهم برد، الا به سر زلفت","گر دسترسی باشد، یک روز به یغمایی","من تنها به سر زلف تو دست می‌زنم و به چیز دیگری توجه نمی‌کنم، اما اگر روزی فرصتی پیش آید، ممکن است این زلف را از تو بربایم."],[511,"گویند «تمنایی، از دوست بکن، سعدی!»","جز دوست نخواهم کرد، از دوست تمنایی","می‌گویند از دوست چیزی بخواه، ای سعدی! اما من هیچ خواسته‌ای جز دوست ندارم و تنها خواستم دوستی اوست."],[512,"همه چشمیم تا برون آیی","همه گوشیم تا چه فرمایی","همه ما منتظریم تا تو بیرون بیایی و همه ما گوش به زنگ هستیم تا چه بگویی."],[512,"تو نه آن صورتی که بی رویت","متصور شود شکیبایی","تو آنقدر زیبا و بی‌نظیری که حتی تصور کردن حالت بدون تو نشان‌دهنده صبر و شکیبایی نیست."],[512,"من ز دست تو خویشتن بکشم","تا تو دستم به خون نیآلایی","من خودم را از دست تو می‌کشم تا تو دستت را به خونم آلوده نکنی. (AI: من خودم را از دست تو دور می‌کنم تا تو دستم را به خون آلوده نکنی.)"],[512,"گفته بودی قیامتم بینند","این گروهی محب سودایی","تو گفته بودی که این گروه از عاشقان، قیامت من را خواهند دید، اما آن‌ها تنها دل‌باخته سودای عشق هستند."],[512,"وین چنین روی دل‌ستان که تو راست","خود قیامت بود که بنمایی","و این چهره دل‌ربای تو، اگر ظاهر شود، خود قیامت به حساب می‌آید."],[512,"ما تماشاکنان کوته‌دست","تو درخت بلندبالایی","ما که فقط ناظر و نگاه‌کننده تو هستیم، در برابر تو مانند درختی بلند و عظیم هستیم، اما از نظر رسیدن به تو و بهره‌گیری از وجودت ناتوان و بی‌دست و پا هستیم."],[512,"سر ما و آستان خدمت تو","گر برانی و گر ببخشایی","ما در برابر درگاه پرعظمت تو، حتی اگر ما را طرد کنی و یا مورد بخشش قرار دهی، ارزش و اهمیت خود را حفظ می‌کنیم."],[512,"جان به شکرانه دادن از من خواه","گر به انصاف با میان آیی","اگر با انصاف و درستی با من رفتار کنی، جانم را در شکرگزاری به تو تقدیم می‌کنم."],[512,"عقل باید که با صلابت عشق","نکند پنجه توانایی","عقل باید با ثبات و استقامت در عشق، به قدرت خود شوریده نشود و درگیر طمع و خواهش‌های دنیوی نگردد."],[512,"تو چه دانی؟ که بر تو نگذشته‌ست","شب هجران و روز تنهایی","تو چه می‌دانی از سختی‌ها و دردهایی که من در شب‌های دوری و روزهای تنهایی تجربه کرده‌ام؟"],[512,"روشنت گردد این حدیث چو روز","گر چو سعدی شبی بپیمایی","اگر تو در شب‌های تنهایی و غم، تجربه عاشقانه‌ای همچون سعدی داشته باشی، حقیقت و واقعیت این داستان برایت روشن خواهد شد، همان‌طور که روز روشن است."],[513,"ای ولوله عشق تو بر هر سر کویی","روی تو ببرد از دل ما هر غم رویی","عشق تو مانند سر و صدایی در هر خیابان و کوچه‌ی شهر است و دیدن تو باعث می‌شود که هر گونه غم و اندوهی از دل ما برود."],[513,"آخر سر مویی به ترحم نگر آن را","کآهی بودش تعبیه بر هر بن مویی","این بیت بیان می‌کند که یک حفره یا سوراخ کوچک در زندگی (تشبیه شده به «سر مو»)، می‌تواند باعث ایجاد احساس ناراحتی و درد عمیق شود. این آزار به عنوان یک آه و ناله، در هر تار مویی که وجود دارد، به نحوی آماده شده است."],[513,"کم می‌نشود تشنگی دیده شوخم","با آن که روان کرده‌ام از هر مژه جویی","با اینکه از هر مژه‌ام اشک جاری کرده‌ام، اما باز هم تشنگی چشمم کمتر نمی‌شود."],[513,"ای هر تنی از مهر تو افتاده به کنجی","وی هر دلی از شوق تو آواره به سویی","ای کسی که هر شخصی به خاطر محبت تو گوشه‌نشین شده و هر دلی به خاطر عشق تو سرگردان و بی‌قرار است."],[513,"ما یکدل و تو شرم نداری که برآیی","هر لحظه به دستانی و هر روز به خویی","ما همه با هم یک دل هستیم، اما تو شرم نکرده‌ای که هر لحظه با دستانی به ما بیایی و هر روز با رفتار و رحمتت به ما نیکی کنی."],[513,"در کان نبود چون تن زیبای تو سیمی","وز سنگ نخیزد چو دل سخت تو رویی","هیچ ماده‌ای در این دنیا به زیبا و باارزش بودن تن تو نیست و از دل سخت تو نمی‌توان صورتی نیکو ساخت."],[513,"بر هم نزند دست خزان بزم ریاحین","گر باد به بستان برد از زلف تو بویی","دست خزان (فصل پاییز) به باغ گل‌ها و عطرشان آسیبی نمی‌زند، حتی اگر بادی عطر زلف تو را به بستان (باغ) ببرد. این بیت به زیبایی و لطافت گل‌ها و همچنین تأثیر عطر زلف معشوق اشاره دارد."],[513,"با این همه میدان لطافت که تو داری","سعدی چه بود در خم چوگان تو گویی","سعدی می‌گوید با وجود تمام لطافت و زیبایی‌ای که تو داری، به چه چیزی شبیه هستی که در چگونگی خم چوگان (یک نوع بازی) تو را به یاد می‌آورد."],[514,"ای خسته دلم در خم چوگان تو گویی","بی‌فایده‌ام پیش تو چون بیهده گویی","ای آنکه دل خسته من هنگام بازی چون گویی در خم چوگان موهای توست، من احساس می‌کنم که در مقابل تو هیچ‌گونه ارزشی ندارم و حرف‌هایم بی‌معنا است. (AI: ای دل خسته من، هنگام بازی تو به من بی‌احترامی می‌کنی و من احساس می‌کنم که در مقابل تو هیچ‌گونه ارزشی ندارم و حرف‌هایم بی‌معنا است.)"],[514,"ای تیر غم عشق تو هر جا که رسیده","افتاده به زخمش چو کمان پشت دوتویی","ای تیر غم عشق تو در هر جایی که رفته، مانند کمانی که دو سر دارد، به زخم و درد خود افتاده است."],[514,"هم طرفه ندارم اگرم بازنوازی","زیرا که عجب نیست نکویی ز نکویی","من هیچ «عجب» ندارم، حتی اگر دوباره به من نیکی کنی، چون شگفتی ندارد که خوب بودن از خوبی انتظار می‌رود."],[514,"سعدی غمش از دست مده گر ندهد دست","کی دست دهد در همه آفاق چنویی","سعدی، اگر دستت را نمی‌گیرد، غمش را از دست مده، کجا ممکن است دوستی مانند او در جهان پیدا کنی؟ (AI: غم سعدی را از دست مده، اگر کسی دست تو را نمی‌گیرد، بدان که در هر کجا ممکن است دوستی پیدا کنی.)"],[515,"چه جرم رفت که با ما سخن نمی‌گویی","جنایت از طرف ماست یا تو بدخویی","ما نمی‌دانیم چه خطایی کرده‌ایم که با ما صحبت نمی‌کنی. آیا این گناهی از طرف ماست یا اینکه تو بدخلق و بدرفتار هستی؟"],[515,"تو از نبات گرو برده‌ای به شیرینی","به اتفاق ولیکن نبات خودرویی","تو از گل و گیاه جدا شده‌ای و طعم شیرینی را چشیده‌ای، اما در حقیقت گیاه خودرؤیی (طبیعی و آزاد) هستی و خودت را به این شیرینی محدود نکرده‌ای."],[515,"هزار جان به ارادت تو را همی‌جویند","تو سنگدل به لطافت دلی نمی‌جویی","هزار نفر جان خود را برای ارادت به تو می‌خواهند، اما تو انسان سنگدلی هستی که به لطافت دل کسی توجهی نمی‌کنی."],[515,"ولیک با همه عیب از تو صبر نتوان کرد","بیا و گر همه بد کرده‌ای که نیکویی","با وجود تمامی عیب‌ها و نقص‌هایی که در تو وجود دارد، اما نمی‌توان بر صبر خود ادامه داد. پس بیایید، حتی اگر تمام کارهای بدی کرده‌اید، به خوبی‌هایتان نیز توجه کنید."],[515,"تو بد مگوی و گر نیز خاطرت باشد","بگوی از آن لب شیرین که نیک می‌گویی","اگرچه تو درباره من بد صحبت کن، اما اگر به یاد من هستی، از آن لب شیرینت بگو که از آن خوب سخن می‌گویی و نظر خوبی داری."],[515,"گلم نباید و سروم به چشم درناید","مرا وصال تو باید که سرو گلبویی","من باید به تو برسم و با تو باشم، نه اینکه فقط به زیبایی‌ها و ناز چهره‌ات نگاه کنم. داشتن تو و وصال تو برایم از همه چیز مهم‌تر است."],[515,"هزار جامه سپر ساختیم و هم بگذشت","خدنگ غمزه خوبان ز دلق نه تویی","ما هزاران لباس و پوشش برای خود درست کردیم، ولی تیر چشمک زدن زیبایانی مانند تو، در این دلق‌ها و پوشش‌ها به ما نرسید."],[515,"به دست جهد نشاید گرفت دامن کام","اگر نخواهدت ای نفس خیره می‌پویی","با کوشش نمی‌شود که کامروا شد؛ ای نفس، اگر او تو را نخواهد، هر چقدر هم تلاش کنی، نمی‌توانی به آن برسی. (AI: اگر نفس تو چیزی را نخواهد، هر چقدر هم تلاش کنی، نمی‌توانی به آن برسی.)"],[515,"درست شد که به یک دل دو دوست نتوان داشت","به ترک خویش بگوی ای که طالب اویی","نمی‌توان دو نفر را با یک دل دوست داشت، بنابراین به خودت بگو ای کسی که او را می‌خواهی، با ترک کردن خودت این امکان را فراهم کن."],[515,"همین که پای نهادی بر آستانه عشق","به دست باش که دست از جهان فروشویی","زمانی که پا بر درگاه عشق گذاشتی، باید با دقت و توجه عمل کنی و از دنیا و مسائل آن دل بکنی و جدا شوی."],[515,"درازنای شب از چشم دردمندان پرس","تو قدر آب چه دانی که بر لب جویی","در طول شب، از درد و رنج کسانی که در عشق رنج می‌کشند، بپرس که ارزش آب را چه می‌دانی وقتی که فقط کنار جوی نشسته‌ای."],[515,"ز خاک سعدی بیچاره بوی عشق آید","هزار سال پس از مرگش ار بینبویی","از خاک سعدی بیچاره، بوی عشق به مشام می‌رسد و این عطر، حتی هزار سال بعد از مرگش هم احساس می‌شود، اگر کسی بخواهد آن را استشمام کند."],[516,"کدام کس به تو ماند که گویمت که چون اویی؟","ز هر که در نظر آید گذشته‌ای به نکویی","هیچ‌کس به اندازه تو نیست که بتوانم بگویم مانند او هستی. هر کسی را که در نظر بیاورم، او گذشته‌ای نیکوتر دارد."],[516,"لطیف‌جوهر‌ و جانی غریب‌قامت و شکلی","نظیف‌جامه و‌ جسمی بدیع‌صورت و خویی","تو دارای ویژگی‌هایی هستی که بسیار لطیف و نیکو است؛ قامت تو خاص و دل‌نواز، و شکل و ظاهرت بی‌نظیر است. لباس و جسم تو نیز زیبا و منحصر به فرد است و خوی تو به شدت زیبا و جذاب است."],[516,"هزار دیده چو پروانه بر جمال تو عاشق","غلام مجلس آنم که شمع مجلس اویی","چشمان من مانند پروانه‌ها در اطراف زیبایی تو می‌چرخند و من غلام کسی هستم که تو شمع مجالس او هستی و همه به خاطر روشنی تو به دور تو جمع می‌شوند."],[516,"ندیدم آبی و خاکی بدین لطافت و پاکی","تو آب چشمه حیوان و خاک غالیه‌بویی","آنقدر لطافت و پاکی در تو هست که هیچ آب و خاکی را به اندازه تو زیبا و خالص ندیده‌ام. تو مانند آب چشمه حیات و خاک خوشبو و معطر هستی."],[516,"تو را که درد نباشد ز درد ما چه تفاوت؟","تو حال تشنه ندانی که بر کناره جویی","تو که خودت مشکلی نداری و دردی احساس نمی‌کنی، برایت مهم نیست که ما چه دردی می‌کشیم. تو نمی‌فهمی و نمی‌دانی حال کسانی را که از تشنگی رنج می‌برند، حتی اگر در کنار چشمه‌ای نشسته باشند."],[516,"صبای روضه رضوان ندانمت که چه بادی","نسیم وعده جانان ندانمت که چه بویی","نمی‌دانم نسیم خوشبویی که از باغ بهشت به من می‌وزد چه نوع بادی است، و نمی‌دانم عطر و بویی که از وعده و دیدار محبوب به مشامم می‌رسد چه خصوصیاتی دارد."],[516,"اگر من از دل یک‌تو برآورم دم عشقی","عجب مدار که آتش درافتدم به دوتویی","تعجب نکن که من دچار آتش عشق شده‌ام و اگر نفس عشقی از دل یکتایم برآورم، آتش عشق، لباسم را بسوزاند. / دوتویی (دوتایی): نوعی لباس / (AI: اگر من از عمق دل تو حسی از عشق بروز کنم، تعجب نکن که من دچار آتش عشق شده‌ام و این عشق بر دوگانگی و جدایی من و تو دلالت دارد.)"],[516,"به کس مگوی که پایم به سنگ عشق برآمد","که عیب گیرد و گوید چرا به فرق نپویی؟","به هیچ‌کس نگو که به خاطر عشق به کسی به دردسر و مشکلات افتاده‌ام، زیرا ممکن است او عیب‌جویی کند و بگوید چرا از خود نمی‌گذری و به جای این مشکلات نمی‌روی."],[516,"دلی دو دوست نگیرد دو مهر دل نپذیرد","اگر موافق اویی به ترک خویش بگویی","یک دل دو دوست را نمی‌پذیرد و محبت دو عشق را قبول نمی‌کند، پس اگر هواخواه اویی از خود دور شو و به خود پشت کن. (AI: اگر دل کسی دوستی را نپذیرد و محبت او را قبول نکند، حتی اگر او با آن شخص هم‌نظر و همدل باشد، به راحتی می‌تواند از خود دور شود و به او پشت کند.)"],[516,"کنونم آب حیاتی به حلق تشنه فروکن","نه آنگهی که بمیرم به آب دیده بشویی","اکنون با شوق بسیار از لطف و محبت خودت به من زندگی و حیات دوباره ببخش و آب حیات را به من بنوشان، نه اینکه وقتی مرده‌ام، تنها با اشکی که از چشمانم بریزد مرا بشویی."],[516,"به اختیار تو سعدی چه التماس برآید","گر او مراد نبخشد تو کیستی که بجویی؟","ای سعدی، اگر مراد و خواسته‌ات را ندهد، چه فایده‌ای دارد که خواهش کنی؟ تو چه کسی هستی که بخواهی مرادت را طلب کنی؟ (AI: اگر مراد و خواسته‌ات را به دست نیاوری، چه فایده‌ای دارد که از سعدی خواهش کنی؟ تو چه کسی هستی که بخواهی او را به جستجو واداری؟)"],[517,"ای حسن خط از دفتر اخلاق تو بابی","شیرینی از اوصاف تو حرفی ز کتابی","حسن و زیبایی چهره‌ات باعث شده که اخلاق و رفتار تو تبدیل به یک کلام شیرین و جذاب شود که گویا از یک کتاب زیبا به زبان آمده است."],[517,"از بوی تو در تاب شود آهوی مشکین","گر باز کنند از شکن زلف تو تابی","آهوی مشکین (مشکی) به خاطر بوی تو مست و بی‌تاب می‌شود، اگر زلف‌های تابدار تو را باز کنند و اجازه دهند تا از آن سر بزند."],[517,"بر دیده صاحب‌نظران خواب ببستی","ترسی که ببینند خیال تو به خوابی","از چشم کسانی که صاحب‌نظر هستند، خواب را ربودی، زیرا می‌ترسی که خیال تو را در خواب ببینند. (AI: بر چشم کسانی که صاحب نظر هستند، خواب غلیظی نشسته است، زیرا می‌ترسند که خیال تو را در خواب ببینند.)"],[517,"از خنده شیرین نمکدان دهانت","خون می‌رود از دل چو نمک‌خورده کبابی","از خنده شیرین و لذیذی که از دهان تو برمی‌آید، قلبم مانند کبابی که نمک‌زده شده، خون می‌ریزد."],[517,"تا عذر زلیخا بنهد منکر عشاق","یوسف صفت از چهره برانداز نقابی","تا منکر عاشقان بهانه زلیخا را بپذیرد، یوسف‌گونه از چهره خود نقابی بردار! / / تلمیح: داستان یوسف و زلیخا غزل 5 بیت 3 / (AI: تا بهانه زلیخا از بین برود، عاشقان یوسف‌گونه که از چهره خود نقابی برمی‌دارند، منکر عشق نخواهند بود.)"],[517,"بی‌روی توام جنت فردوس نباید","کاین تشنگی از من نبرد هیچ شرابی","به خاطر نبودن روی تو، بهشت فردوس برای من ارزش ندارد، زیرا این عطش و تشنگی که در من است هیچ شرابی نمی‌تواند آن را از بین ببرد."],[517,"مشغول تو را گر بگذارند به دوزخ","با یاد تو دردش نکند هیچ عذابی","اگر در دوزخ هم کسی را به یاد تو بیندازند و مشغول روی تو باشد، حتی عذاب دوزخ برایش دردآور نخواهد بود."],[517,"باری به طریق کرمم بنده خود خوان","تا بشنوی از هر بن موییم جوابی","به خاطر سخاوت و بزرگی‌ام، تو را بنده خود می‌خوانم، تا از هر رشته موی من پاسخ صریحی بشنوی."],[517,"در من منگر تا دگران چشم ندارند","کز دست گدایان نتوان کرد ثوابی","به درون من ننگر، زیرا دیگران توانایی دیدن ندارند؛ چرا که از دست گدایان، انجام کار نیک ممکن نیست."],[517,"آب سخنم می‌رود از طبع چو آتش","چون آتش رویت که از او می‌چکد آبی","سخنان من به‌سرعت و به شدت مثل آتش بیرون می‌آید، درست مانند آتش چهره‌ات که از آن آب می‌چکد."],[517,"یاران همه با یار و من خسته طلبکار","هر کس به سر آبی و سعدی به سرابی","دوستان همه در کنار یار خود هستند و من که خسته‌ام فقط در جستجوی معشوقم هستم. هر کس از محبت خود بهره‌ای دارد، ولی سعدی تنها به یک سراب (چیزی که واقعی نیست) دل خوش کرده است."],[518,"تو خون خلق بریزی و روی درتابی","ندانمت چه مکافات این گنه یابی","اگر تو بی‌رحمانه و بدون رحم بر مردم ظلم کنی، نمی‌دانی که چه عواقبی از این گناه در انتظار توست."],[518,"تصدّ عنّی فی الجور و النّوی لکن","إلیک قلبی یا غایة المنی صاب","تو با ظلم و ستم از من دوری می‌کنی، اما قلبم به سمت تو می‌تپد، ای هدف نهایی آرزوهای من."],[518,"چو عندلیب چه فریادها که می‌دارم","تو از غرور جوانی همیشه در خوابی","من مثل بلبل، آواهایی از درد و فراق دارم، اما تو به خاطر خودپسندی جوانی‌ات همیشه در خواب و غفلت هستی."],[518,"إلی العداة وصلتم و تصحبونهم","و فی ودادکم قد هجرت أحبابی","شما به دشمنان پیوسته‌اید و با آنها همراهی می‌کنید، در حالی که من به خاطر وفاداری به شما دوستانم را ترک کرده‌ام."],[518,"نه هر که صاحب حسن است جور پیشه کند","تو را چه شد که خود اندر کمین اصحابی؟","مردم زیبا و جذاب همیشه بدجنس و ظالم نیستند؛ تو چرا این‌طور شده‌ای که در انتظار دوستانت نشسته‌ای؟"],[518,"أحبّتی أمرونی بترک ذکراه","لقد أطعت و لکنّ حبّه آب","دوستانم از من خواسته‌اند که یاد او را فراموش کنم. من به خواسته‌شان گوش کرده‌ام، اما عشق او همچنان در دلم باقی است."],[518,"غمت چگونه بپوشم؟ که دیده بر رویت","همی گواهی بر من دهد به کذّابی","چگونه می‌توانم غم تو را پنهان کنم، در حالی که چشمانم به چهره‌ات اشاره دارد و گواهی می‌دهد که من دروغ‌گو نیستم؟"],[518,"مرا تو بر سر آتش نشانده‌ای عجب آنک","منم در آتش و از حال من تو در تابی","تو من را در آتش عشق قرار داده‌ای و جالب اینجاست که من در آن آتش می‌سوزم، اما تو از این حال و وضع من بی‌خبر و در آرامش هستی."],[518,"من از تو سیر نگردم که صاحب استسقا","نه ممکن است که هرگز رسد به سیرابی","من هیچ‌گاه از تو سیر نمی‌شوم، زیرا تو کسی هستی که خواسته‌ام را به من می‌دهی و همچون آب، نمی‌توانم به سیرابی از تو برسید."],[519,"سر آن ندارد امشب که برآید آفتابی","چه خیال‌ها گذر کرد و گذر نکرد خوابی","امشب به نظر نمی‌رسد که خورشید طلوع کند. همه جور فکر از سر رد شد ولی خوابی به چشم نیامد."],[519,"به چه دیر ماندی ای صبح؟ که جان من برآمد","بزه کردی و نکردند مؤذنان ثوابی","ای صبح، چرا دیر آمدی؟ جان من در انتظار تو به پایان رسید و مؤذنان هم در این شب عبادتی نکردند که پاداشی ببرند."],[519,"نفس خروس بگرفت که نوبتی بخواند","همه بلبلان بمردند و نماند جز غرابی","«نوبتی» به معنای کسی است که در نقارخانه کوس ییا دهل می‌زند.اینجا خروس آنقدر خواند که نفسش گرفت، بلبلان از طولانی شدن زمان مردند و فقط کلاغ باقی ماند."],[519,"نفحات صبح دانی ز چه روی دوست دارم؟","که به روی دوست ماند که برافکند نقابی","من از چه چیزی در بوی صبح خوشم می‌آید؟ چون این بوی خوش به‌ خاطر روی محبوب است که پرده‌ای را کنار می‌زند."],[519,"سرم از خدای خواهد که به پایش اندر افتد","که در آب‌مرده بهتر که در آرزوی آبی","از خداوند می‌خواهم که سرم را در دامان او از دست بدهم و در وصالش بمیرم زیرا غرق شدن در آب بهتر از این است که در آرزوی نوشیدن چکه آبی جان بدهی"],[519,"دل من نه مرد آن‌ست که با غمش برآید","مگسی کجا تواند که بیفکند عقابی؟","دل من به قدری ضعیف است که نمی‌تواند با غم او (عشقش) دست و پنجه نرم کند، مانند مگسی که اصلا نمی‌تواند عقابی را به زمین بیندازد."],[519,"نه چنان گناهکارم که به دشمنم سپاری","تو به دست خویش فرمای اگرم کنی عذابی","من آن‌قدر گناهکار نیستم که تو بخواهی مرا به دشمن خود بسپاری؛ اگر قرار است عذابی بر من تحمیل کنی، خودت به دست خود این کار را انجام بده."],[519,"دل همچو سنگت ای دوست به آب چشم سعدی","عجب است اگر نگردد که بگردد آسیابی","عشق و محبت تو باعث می‌شود که دل من مانند سنگ باشد و به سختی تحت تأثیر قرار گیرد؛ بنابراین، جالب است اگر این دل با اشک‌هایم نرم نشود و به گردیده شدن آسیابی (یعنی نرم و ملایم) در نیاید."],[519,"برو ای گدای مسکین و دری دگر طلب کن","که هزار بار گفتی و نیامدت جوابی","ای گدای بی‌چیز، برو و درخواستی از دیگری بکن، چرا که هزار بار از تو خواستم که جوابم را بدهی و هیچ پاسخی نشنیدم."],[520,"که دست تشنه می‌گیرد به آبی؟","خداوندان فضل، آخر ثوابی","چه کسی به دست نیازمند محبت مت جرعه آب مهربانی می‌بخشد خداوندان(مالکان )حسن مگر فکر اندک ثوابی نیستید"],[520,"توقع دارم از شیرین‌زبانت","اگر تلخ است و گر شیرین‌جوابی","از زبان شیرین تو انتظار دارم که اگر تلخ یا شیرین پاسخی بدهی."],[520,"تو خود نایی و گر آیی بر من","بدان ماند که گنجی در خرابی","تو خود مانند نای هستی و اگر به سوی من بیایی، مانند این است که گنجی در ویرانه‌ای پیدا شده باشد."],[520,"به چشمانت که گر زهرم فرستی","چنان نوشم که شیرین‌تر شرابی","به چشمانت سوگند می‌خورم که اگر زهر هم به من بدهی، جوری آنرامینوشم که گویی بهترین شرابست."],[520,"اگر سروی به بالای تو باشد","نباشد بر سر سرو، آفتابی","اگر در کنار تو درخت سرو بلندی وجود داشته باشد، هیچ نیازی نیست که بر سر آن سرو آفتابی بتابد."],[520,"پری‌روی از نظر غایب نگردد","اگر صد بار بربندد نقابی","اگرچه چهره‌ی زیبا ممکن است با پوشیدن نقاب پنهان شود، اما زیبایی و جذابیت آن از نظر دور نخواهد بود، حتی اگر بارها نقاب زده شود."],[520,"بدان تا یک نفس رویت ببینم","شب و روز آرزومندم به خوابی","می‌دانم که فقط یک بار دیدار روی تو برایم کافیست، و شب و روز برای این دیدار آرزومندم حتی اگر این دیدار در خواب باشد."],[520,"امیدم هست اگر عطشان نمیرد","که باز آید به جوی رفته آبی","امید دارم که اگر عطش او (عاشق یا معشوق) از بین نرود، بار دیگر آب گمشده به جوی برگردد."],[520,"هلاک خویشتن می‌خواهد آن مور","که خواهد پنجه کردن با عقابی","مور شجاعی که قصد دارد با عقابی مبارزه کند، در واقع به نابودی خود نزدیک می‌شود، زیرا او به رغم کوچکی‌اش، توان مقابله با موجود بزرگ و قدرتمندی مثل عقاب را ندارد."],[520,"شبی دانم که در زندان هجران","سحرگاهم به گوش آید خطابی","یک شب می‌دانم که در زندان جدایی، در سحرگاه، صدایی به گوشم خواهد رسید که حاکی از پیام یا نداست."],[520,"که سعدی چون فراق ما کشیدی","نخواهی دید در دوزخ عذابی","ای سعدی، حال که رنج جدایی ما را کشیدی، به عذابی در دوزخ دچار نخواهی شد. (AI: سعدی می‌گوید که اگر ما را ترک کنی و به جدایی تن دهی، به عذابی در دوزخ دچار نخواهی شد.)"],[521,"سل المصانع رکبا تهیم في الفلوات","تو قدر آب چه دانی که در کنار فراتی؟","برکه های آب را از سوارانی که در بیابان ها سرگردانند جستجو کن؛ تو که در کنار فرات هستی قدر آب را چه می‌دانی؟"],[521,"شبم به روی تو روز است و دیده‌ها به تو روشن","و إن هجرت سواء عشیّتي و غداتي","با صورت تو شب من روز است و چشم‌هایم از تو روشن است، و اگر بروی شب و روز من یکی می‌شود."],[521,"اگر چه دیر بماندم امید برنگرفتم","مضی الزّمان و قلبي یقول إنّک آت","هرچند زمان زیادی منتظر ماندم اما ناامید نشدم، زمان گذشت و قلبم می‌گوید تو حتما می‌آیی."],[521,"من آدمی به جمالت نه دیدم و نه شنیدم","اگر گلی به حقیقت عجین آب حیاتی","من انسانی به زیبایی تو ندیدم و نشنیدم، اگر از گل ساخته‌ شده‌ای به حقیقت آمیخته با آب حیات هستی."],[521,"شبان تیره امیدم به صبح روی تو باشد","و قد تفتّش عین الحیوة في الظّلمات","در شب‌های تاریک امیدم به چهره‌ی مانند روز توست، همانا گاهی آب زندگانی در تاریکی‌ها جستجو می‌شود."],[521,"فکم تمرّر عیشي و أنت حامل شهد","جواب تلخ بدیع است از آن دهان نباتی","پس چرا اینقدر زندگی ام را تلخ می کنی، درحالی که تو دارای چنین شیرینی و شهدی هستی؟ جواب تلخ از آن دهان شکرین تو به دور است."],[521,"نه پنج روزه عمر است عشق روی تو ما را","وجدت رائحة الودّ إن شممت رفاتي","عشق ما به تو در همین پنج روز عمر نیست، بلکه اگر استخوان‌های پوسیده‌ام را بعد از مرگ ببویی، بوی عشق را از آنها استشمام می‌کنی و می یابی."],[521,"وصفت کلّ ملیح کما یحبّ و یرضی","محامد تو چه گویم؟ که ماورای صفاتی","هر زیبای نمکینی را آنگونه که دوست داری و می‌پسندی وصف کردم، اما ستایش تو را چگونه بگویم؟ که تو بالاتر از صفات هستی."],[521,"أخاف منک و أرجو و أستغیث و أدنو","که هم کمند بلایی و هم کلید نجاتی","هم از تو می‌ترسم و هم به تو امیدوارم و از تو کمک می‌خواهم و هم به تو نزدیک می‌شوم، زیرا تو هم کمند بلایی و هم کلید نجات."],[521,"ز چشم دوست فتادم به کامه دل دشمن","أحبّتي هجروني کما تشاء عداتي","به کام دل دشمن، از چشم دوست افتادم، دوستانم ترکم کردند همانگونه که دشمنانم می‌خواهند."],[521,"فراقنامه سعدی عجب که در تو نگیرد","و إن شکوت إلی الطّیر نحن في الوکنات","عجیب است اگر این اشعار سوزناک سعدی در تو اثر نکند، که اگر به پرندگان شکایت کنم در لانه‌هایشان فریاد سر می‌دهند."],[522,"تو هیچ عهد نبستی که عاقبت نشکستی","مرا بر آتش سوزان نشاندی و ننشستی","تو هیچ‌گاه پیمانی نبستی مگر آن‌که در پایان آن را شکستی؛ مرا در آتش رنج و عشق نشاندی، اما خودت در آن نماندی."],[522,"بنای مهر نمودی که پایدار نماند","مرا به بند ببستی خود از کمند بجستی","تو به من محبت نشان دادی، اما این محبت تو پایدار نماند. مرا به زنجیر محبت خود درآوردی ولی خودت از آن رها شدی."],[522,"دلم شکستی و رفتی خلاف شرط مودّت","به احتیاط رو اکنون که آبگینه شکستی","دلم را شکست و رفتی، برخلاف شرط دوستی. حالا که گلابی (آبگینه) را شکستی، باید با احتیاط رفتار کنی."],[522,"چراغ چون تو نباشد به هیچ خانه ولیکن","کس این سرای نبندد در این چنین که تو بستی","چراغی چون تو در هیچ خانه‌ای نیست، اما هیچ‌کس به این خانه‌ که تو آن را ترک کردی، قفل نمی‌زند و آن را نمی‌بندد."],[522,"گرم عذاب نمایی به داغ و درد جدایی","شکنجه صبر ندارم بریز خونم و رستی","اگر عذابم کنی با اندوه و درد جدایی، توان تحمل این شکنجه را ندارم؛ بنابراین، خون من را بریز و از دست من خلاص شو."],[522,"بیا که ما سر هستی و کبریا و رعونت","به زیر پای نهادیم و پای بر سر هستی","به نزد تو آمده‌ایم و همه کبر و عظمت و مقام خود را زیر پا گذاشته‌ایم و خود را در برابر تو خوار و مطیع کرده‌ایم."],[522,"گرت به گوشه چشمی نظر بود به اسیران","دوای درد من اول که بی‌گناه بخستی","اگر با یک نگاه به من توجه کنی، همانند یک کسی که در بند است، درمان درد من خواهی شد در حالی که بی‌گناه هستم و نمی‌خواهم به کسی آسیب برسانم."],[522,"هر آن کست که ببیند روا بود که بگوید","که من بهشت بدیدم به راستی و درستی","هر کسی که تو را ببیند، حق دارد که بگوید بهشت را دیده است و این ادعایش درست است."],[522,"گرت کسی بپرستد ملامتش نکنم من","تو هم در آینه بنگر که خویشتن بپرستی","اگر کسی را پرستش کنند، من او را سرزنش نمی‌کنم. تو نیز به آینه نگاه کن و ببین که آیا خودت را نمی‌پرستی؟"],[522,"عجب مدار که سعدی به یاد دوست بنالد","که عشق موجب شوق است و خمر علت مستی","سعدی تعجب می‌کند که چرا باید به یاد دوستش غمگین باشد، زیرا عشق باعث شوق و سرزندگی است و شراب (خمر) عامل ایجاد مستی و شیدایی."],[523,"همه عمر برندارم سر از این خمار مستی","که هنوز من نبودم که تو در دلم نشستی","بیت نخست ← اشاره دارد به «عهد الست» و جذبه آغازین بهتر از برای فهم بهتر، تفسیر این بیت را از مصرع دوم شروع کنیم و در بازگشت به مصرع اول رسیم.در عرفان اسلامی، باور بر این است که پیش از آفرینش ظاهری انسان، در عالمی پیشین به نام «عالم ذرّ» یا «عهد الست»، ارواح همه انسان‌ها با پروردگار پیمانی بستند:﴿ ألست بربّکم؟ قالوا بلى ﴾(سوره اعراف، آیه ۱۷۲)«آیا من پروردگار شما نیستم؟ گفتند: بلی»سعدی با ظرافت می‌گوید: «هنوز من نبودم که تو در دلم نشستی»؛ یعنی عشق و معرفت تو پیش از آفرینش من در فطرت من نهاده شد.این اشاره لطیف، یادآور فطرت توحیدی انسان است که پیش از شعور فردی، در ژرفای جانش «حضور حق» نقش بسته است. به بیان عرفا، عشق «حادث» نیست، بلکه «قدیم» است؛ در لحظه خلقت جسم؛ ظاهر می‌شود، نه آنکه \"پدید و بوجود\" می‌آید.و اما در باب مصرع اول گفتنیست که؛ در اصطلاح صوفیه، «مستی» حالتیست که سالک از خود بی‌خود و در جذبه الهی غرق می‌شود؛ و «خماری» حالتیست پس از آن جذبه، که شخص هنوز از تأثیر آن بیرون نیامده است؛ نه مست کامل است و نه هشیار.سعدی می‌گوید: من تا پایان عمر؛ از این حالت بیرون نخواهم آمد؛ زیرا که عشق تو ازلی‌ست و پایان نداردو در ادامه غزل یعنی در بیت دوم این موضوع را شفاف‌تر می‌سازد که در جایگاهش بدان خواهیم پرداخت."],[523,"تو نه مثل آفتابی که حضور و غیبت افتد","دگران روند و آیند و تو همچنان که هستی","تو مثل آفتاب نیستی که بیایی و بروی و دیگران را تحت تأثیر قرار دهی؛ بلکه تو همیشه در همین حال و احوال هستی و تغییر نمی‌کنی."],[523,"چه حکایت از فراقت که نداشتم ولیکن","تو چو روی باز کردی در ماجرا ببستی","تو نمی دانی که من از دوریت چه ماجرا و حکایتهایی داشتم و چه ها بر سرم آمد و میخواستم ماجراهای دوریت را بگویم اما به محض اینکه رویت را بر من گشودی، گویی تمام آن ماجراها پایان یافت و بر من در گله و حکایت را بستی"],[523,"نظری به دوستان کن که هزار بار از آن به","که تحیّتی نویسی و هدیتی فرستی","به دوستانت نگری، زیرا یک لحظه توجه و محبت به آن‌ها بهتر از این است که برایشان نامه‌ای بنویسی یا هدیه‌ای بفرستی."],[523,"دل دردمند ما را که اسیر توست یارا","به وصال مرهمی نه چو به انتظار خستی","دل دردمند ما که به عشق تو گرفتار است، دوست عزیز، به وصال (رسیدن به تو) درمانی بده، زیرا که در انتظار تو خسته و ناتوان شده‌ایم."],[523,"نه عجب که قلب دشمن شکنی به روز هیجا","تو که قلب دوستان را به مفارقت شکستی","طبیعی است که تو در روز نبرد قلب دشمنان را بشکنی، همان‌طور که با جدایی‌ات دل دوستانت را شکسته‌ای."],[523,"برو ای فقیه دانا به خدای بخش ما را","تو و زهد و پارسایی من و عاشقی و مستی","این بیت خطاب به یک فقیه دانا است که از او می‌خواهد به خدا توجه کند و در عوض زهد و پارسایی خود را رها کند، زیرا شاعر خودش عاشق و مست است و این حالت را نمی‌تواند با زهد و تقوا که فرساینده است، عوض کند."],[523,"دل هوشمند باید که به دلبری سپاری","که چو قبله‌ایت باشد به از آن که خود پرستی","دل باید از هوش و ذکاوت پر باشد تا بتوانی آن را به دلبری بسپاری، زیرا اگر معشوق تو مانند قبله‌ات باشد، بهتر است که او را دوست بداری تا اینکه فقط خود را پرستش کنی."],[523,"چو زمام بخت و دولت نه به دست جهد باشد","چه کنند اگر زبونی نکنند و زیردستی","وقتی که کنترل سرنوشت و ثروت به دست تلاش نباشد، دیگر چه کار می‌توان کرد اگر به ضعف و ناتوانی دچار شویم و در زیر دست دیگران بمانیم؟"],[523,"گله از فراق یاران و جفای روزگاران","نه طریق توست سعدی کم خویش گیر و رستی","ای سعدی، از جدایی دوستان و بی‌وفایی روزگار شکایت نکن، چرا که این رفتار تو نیست؛ کم از خود خواهی کن و رهایی را بپذیر."],[524,"یارا قدحی پر کن از آن داروی مستی","تا از سر صوفی برود علت هستی","ای دوست، لیوانی پر از شراب مستی پر کن تا از صوفی، که به فلسفه و تفکر مشغول است، راز وجود و اصل هستی فراموش شود."],[524,"عاقل، متفکر بود و مصلحت‌اندیش","در مذهب عشق آی و از این جمله برستی","عاقل کسی است که فکر می‌کند و مصلحت را در نظر دارد؛ او در مذهب عشق بیاید و از این قید و بندها رهایی یابد."],[524,"ای فتنه نوخاسته از عالم قدرت","غایب مشو از دیده که در دل بنشستی","ای فتنه‌ای که تازه از مقام قدرت ظاهر شده‌ای، از نظر غایب نشو، زیرا تو در دل من ساکن شده‌ای."],[524,"آرام دلم بستدی و دست شکیبم","برتافتی و پنجه صبرم بشکستی","تو آرامشی برای دل من به وجود آوردی و صبرم را از دستم گرفتی، به گونه‌ای که تحملم را شکست."],[524,"احوال دو چشم من بر هم ننهاده","با تو نتوان گفت به خواب شب مستی","چشمان من در حالت بی‌خوابی، نمی‌توانند احوال خود را با تو توصیف کنند، چراکه در خواب شب مستی، حال و هوای دیگری دارم."],[524,"سودازده‌ای کز همه عالم به تو پیوست","دل نیک بدادت که دل از وی بگسستی","عشقی که به تو دلبسته است، از تمامی جهان دلش را به تو سپرده و تو نیز دل خوبی به او داده‌ای، اما او از عشقش به تو جدا شده است."],[524,"در روی تو گفتم سخنی چند بگویم","رو باز گشادی و در نطق ببستی","من در حضور تو چند کلمه‌ای خواستم بگویم، اما تو با روی باز اجازه ندادیا و زبانم را بسته نگه داشتی."],[524,"گر باده از این خم بود و مطرب از این کوی","ما توبه بخواهیم شکستن به درستی","اگر این شراب از این جام باشد و نوازنده از این محله باشد، ما درستی را می‌پذیریم که نمی‌توانیم از توبه خود فاصله بگیریم و آن را بشکنیم."],[524,"سعدی غرض از حقه تن آیت حق است","صد تعبیه در توست و یکی باز نجستی","سعدی می‌گوید که هدف از خلق بدن انسان، نشان دادن نشانه‌های الهی است و در وجود هر فرد ویژگی‌های زیادی قرار داده شده است، اما یکی از آن ویژگی‌ها هنوز کشف نشده و پنهان مانده است."],[524,"نقاش وجود این همه صورت که بپرداخت","تا نقش ببینی و مصور بپرستی","هنرآفرین واقعی همه این صورت‌ها خداوند است که برای اینکه تو زیبایی‌ها را ببینی و از آن‌ها لذت ببری، آن‌ها را به تماشا درآمده و به تصویر کشیده است."],[525,"اگر مانند رخسارت گلی در بوستانستی","زمین را از کمالیت شرف بر آسمانستی","اگر مانند چهره‌ات گلی در باغ باشد، زمین از زیبایی‌ات به اندازه‌ای برتر می‌شود که نسبت به آسمان مقام والایی می‌یابد. (AI: اگر چهره‌ات مانند گلی در باغ باشد، پس از زیبایی‌ات به اندازه‌ای برتر هستی که زمین نسبت به آسمان مقام والایی دارد.)"],[525,"چو سرو بوستانستی وجود مجلس‌آرایت","اگر در بوستان سروی سخنگوی و روانستی","اگر وجود تو مانند سرو در بوستان باشد و مجلس را زیبا کند، در این صورت، تو نیز مثل سروی هستی که می‌تواند در بوستانی سخن بگوید و به زندگی رونق ببخشد."],[525,"نگارین‌روی و شیرین‌خوی و عنبربوی و سیمین‌تن","چه خوش بودی در آغوشم اگر یارای آنستی","بهترین حالت این است که محبوب با صورت زیبا، رفتار دلپذیر، بوی خوش و تن نقره‌ای خود در آغوشم باشد، اگر او توانایی داشته باشد که این کار را انجام دهد."],[525,"تو گویی در همه عمرم میسر گردد این دولت","که کام از عمر برگیرم و گر خود یک زمانستی","تو انگار در تمام عمر من، این سعادت باعث می‌شود که از زندگی بهره‌مند شوم، و اگر تو فقط یک لحظه در کنارم باشی."],[525,"جز این عیبت نمی‌دانم که بدعهدی و سنگین‌دل","دلارامی بدین خوبی دریغ ار مهربانستی","تنها ایراد من در این است که بدعهدی و دل‌سردی کسی به نام دلارام، با این همه زیبایی، اگر به مهر و محبت محتاج است، خود را از آن محروم کرده است."],[525,"شکر در کام من تلخ است بی‌دیدار شیرینش","و گر حلوا بدان ماند که زهرش در میانستی","شکر برای من تلخ است و از شیرینی‌اش بی‌بهره‌ام، و اگر هم مانند حلوا باشد، زهرش درونش مخفی است. این به این معنا است که بی‌توجهی به محبوب هر چیز لذیذ و شیرینی را به تلخی تبدیل می‌کند."],[525,"دمی در صحبت یاری ملک‌خوی پری‌پیکر","گر امید بقا باشد بهشت جاودانستی","چند لحظه در کنار یاری که مانند فرشته‌ای زیباست باشم، اگر امیدی به ماندگاری باشد، از آن بهشت جاودان بهتر است."],[525,"نه تا جان در جسد باشد وفاداری کنم با او","که تا تن در لحد باشد و گر خود استخوانستی","تا زمانی که زندگی در بدنم هست، به او وفاداری می‌کنم، حتی اگر جسمم در قبر باشد و اگر تنها استخوانی هستم... (AI: تا زمانی که زندگی در بدنم هست، به او وفاداری می‌کنم، حتی اگر در قبر باشد. و اگر تو تنها استخوانی هستی...)"],[525,"چنین گویند سعدی را که دردی هست پنهانی","خبر در مغرب و مشرق نبودی گر نهانستی","می‌گویند: سعدی دردی دارد که پنهان است. اگر این درد پنهان بود، خبری از آن در شرق و غرب عالم نمی‌بود. (AI: سعدی می‌گوید که دردی وجود دارد که پنهان است و اگر این درد نبود، خبری از آن در شرق و غرب نمی‌بود. این نشان می‌دهد که درد و مشکلات اجتماعی یا انسانی ممکن است در جاهایی وجود داشته باشد ولی ممکن است به چشم نیاید.)"],[525,"هر آن دل را که پنهانی قرینی هست روحانی","به خلوتخانه‌ای ماند که در در بوستانستی","دل هر کسی که ارتباطی پنهانی و معنوی دارد، مانند خلوت‌گاهی است که در آن بوستان و زیبایی‌ها وجود دارد."],[526,"تعالی الله چه روی است آن که گویی آفتابستی","و گر مه را حیا بودی ز شرمش در نقابستی","خداوند چه چهره‌ای دارد که می‌گویند مثل آفتاب است، و اگر ماه هم حیا داشت، از شرم خود را در نقابی پنهان می‌کرد."],[526,"اگر گل را نظر بودی چو نرگس تا جهان بیند","ز شرم رنگ رخسارش چو نیلوفر در آبستی","اگر نرگس به گل نظر داشت، آن‌گاه رنگ صورتش مانند نیلوفر در آب می‌بود و جهان را از شرم به خودش می‌کشید."],[526,"شبان خوابم نمی‌گیرد نه روز آرام و آسایش","ز چشم مست میگونش که پنداری به خوابستی","شبان خواب به چشمانم نمی‌آید و در روز هم آرامش ندارم، زیرا با وجود چشمان زیبای معشوقه‌ام که مانند شراب مست‌کنند است، گویی او در خواب است و من همیشه بیدار و در حال تردید باقی مانده‌ام."],[526,"گر آن شاهد که من دانم به هر کس روی بنماید","فقیر از رقص در حالت خطیب از می خرابستی","اگر آن معشوقه‌ای که من می‌شناسم، به هر کس رویش را نشان دهد، بی‌تردید فقیر که در حال رقص است، از می مستی‌اش بی‌خبر خواهد بود."],[526,"چنان مستم که پنداری نماند امید هشیاری","به هش بازآمدی مجنون اگر مست شرابستی","چنان مست هستم که فکر می‌کنم امیدی به بهبودی و هوشیاری ندارم. اگر تو نیز در حال نوشیدن شراب در نزد من برگردی، مانند مجنون خواهی شد."],[526,"گر آن ساعد که او دارد بدی با رستم دستان","به یک ساعت بیفکندی اگر افراسیابستی","اگر آن بازوی زیبا که او (مرد محبوب) دارد، همانند بازوی رستم دستان بود، در یک لحظه می‌توانست مرا به زمین بیندازد، اگر افراسیاب (دشمن رستم) بود."],[526,"بیار ای لعبت ساقی اگر تلخ است و گر شیرین","که از دستت شکر باشد و گر خود زهر نابستی","ای ساقی، بیا و شراب بیاور، چه تلخ باشد چه شیرین، زیرا از دست تو هم اگر تلخی باشد، باز هم شیرینی به همراه دارد، و اگر هم زهر ناب باشد، به خاطر زیبایی‌ات ارزش دارد."],[526,"کمال حسن رویت را مخالف نیست جز خویت","دریغا آن لب شیرین اگر شیرین جوابستی","زیبایی و کمال چهره‌ات را هیچ چیز نمی‌تواند منع کند به جز خودت. افسوس که اگر آن لب شیرین تو پاسخ شیرینی می‌داشت، اوضاع بهتر بود."],[526,"اگر دانی که تا هستم نظر با جز تو پیوستم","پس آنگه بر من مسکین جفا کردن صوابستی","اگر می‌دانی که من در زندگی‌ام فقط به تو نگاه می‌کنم و وابسته به تو هستم، پس در این صورت، بد رفتاری با من، درست و منطقی نیست."],[526,"زمین تشنه را باران نبودی بعد از این حاجت","اگر چندان که در چشمم سرشک اندر سحابستی","اگر باران نمی‌بارید و زمین تشنه می‌ماند، دیگر نیازی به اشک من نیست، حتی اگر چقدر در چشمانم اشک وجود داشته باشد."],[526,"ز خاکم رشک می‌آید که بر سر می‌نهی پایش","که سعدی زیر نعلینت چه بودی گر ترابستی","از خاک من غبطه می‌خورد که تو پای خویش را بر آن می‌گذاری، چون سعدی چه چیزی را زیر پای تو می‌داشت اگر که خاک بودی."],[527,"ای باد که بر خاک در دوست گذشتی","پندارمت از روضه بستان بهشتی","ای باد، تو که بر خاک دم در دوست (که محبوب است) می‌گذری، گمان می‌کنم که از باغی بهشتی عبور می‌کنی."],[527,"دور از سببی نیست که شوریده سودا","هر لحظه چو دیوانه دوان بر در و دشتی","(خطاب به باد) بی‌علت نیست که همچون آدمی عاشق و دیوانه هر لحظه با شوق و اشتیاق بر در و دشت می‌دوی. (AI: هیچ چیزی نمی‌تواند مانع از این شود که آدمی عاشق و دیوانه هر لحظه با شوق و اشتیاق بر در و دشت بگردد.)"],[527,"باری مگرت بر رخ جانان نظر افتاد","سرگشته چو من در همه آفاق بگشتی","اگر بر چهره معشوق نگاه کردی، مانند من که سرگشته و دیوانه‌وار در همه جا پرسه زدم."],[527,"از کف ندهم دامن معشوقه زیبا","هل تا برود نام من ای یار به زشتی","هرگز دامن معشوقه‌ی زیبا را رها نمی‌کنم، تا نام من با بدنامی نرود. ای محبوب، نمی‌خواهم که نامم با زشتی و ناپسندی همراه شود."],[527,"جز یاد تو بر خاطر من نگذرد ای جان","با آن که به یک باره‌ام از یاد بهشتی","جز یاد تو چیزی در دل و ذهن من نمی‌ماند، ای جان، با آن که در یک لحظه مرا از یاد بردی. / بهشتی: از مصدر هشتن، رها کردن / (AI: جز یاد تو چیزی در دل و ذهن من نمی‌ماند، ای جان، با این حال که در یک لحظه از یاد بهشت هم فراموشم می‌شود.)"],[527,"با طبع ملولت چه کند دل که نسازد","شرطه همه وقتی نبود لایق کشتی","دل چگونه می‌تواند با حال دلگیر تو کنار بیاید، در حالی که هر لحظه‌ی زندگی مناسب و شایسته‌ی آرامش نیست (و همه وقتی وزش باد موافق حرکت کشتی نیست)."],[527,"بسیار گذشتی که نکردی سوی ما چشم","یک دم ننشستم که به خاطر نگذشتی","بسیار بارها از کنار ما رد شدی بدون اینکه نگاهی به ما بیندازی، من حتی برای یک لحظه هم آرام نکردم چون در ذهنم یاد تو بودی و به خاطر تو به سر می‌بردم."],[527,"شوخی شکرالفاظ و مهی لاله‌بناگوش","سروی سمن‌اندام و بتی حورسرشتی","با وجود زیبایی و شیرینی کلام، زیبایی‌های ظاهری و جسمانی مانند گل‌های خوشبو و موهای زیبا، به گونه‌ای توصیف شده‌اند که گویی این اشیاء خود دارای جان و روح هستند؛ گلی با رنگ و عطر شیرین، سروی با قامت بلند و بتی زیبا با ویژگی‌های فرشته‌گون."],[527,"قلاب تو در کس نفکندی که نبردی","شمشیر تو بر کس نکشیدی که نکشتی","تو هیچ‌کس را در دام خود نینداختی (که نبردی) و هیچ‌کس را با شمشیر خود مجروح نکردی (که نکشتی)."],[527,"سیلاب قضا نسترد از دفتر ایام","این‌ها که تو بر خاطر سعدی بنوشتی","سرنوشت و حقیقت زندگی به اندازه‌ای قوی است که نمی‌توان آن را از یاد برد، و این خاطراتی که تو برای سعدی نوشته‌ای، در دل او جاودان مانده‌اند."],[528,"یاد می‌داری که با من جنگ در سر داشتی","رای رای توست خواهی جنگ خواهی آشتی","به یاد می‌آوری که در گذشته با من دشمنی می‌کردی؛ این تصمیم با تو است که آیا می‌خواهی ادامه بدهی یا صلح کنی."],[528,"نیک بد کردی شکستن عهد یار مهربان","این بتر کردی که بد کردی و نیک انگاشتی","تو به خوبی پیمان یاری را شکستی و این کار را با مهربانی کردی، اما این بدتر است که به این کار بدی، نیکی می‌پنداری و خود را فریب می‌دهی."],[528,"دوستان دشمن گرفتن هرگزت عادت نبود","جز در این نوبت که دشمن دوست می‌پنداشتی","دوستان را دشمن تصور کردن برای تو عادت نداشت، اما در این حال که فکر می‌کردی دشمنی، دوست است، این کار را کردی."],[528,"خاطرم نگذاشت یک ساعت که بدمهری کنم","گرچه دانستم که پاک از خاطرم بگذاشتی","ذهنم اجازه نداد که حتی برای یک ساعت هم با تو بدرفتاری کنم، با اینکه می‌دانستم که تو مرا کاملا از یاد برده‌ای. (AI: ذهنم اجازه نداد که حتی برای یک ساعت هم با تو بدرفتاری کنم، با اینکه می‌دانستم که تو به راحتی از یادم رفته‌ای.)"],[528,"همچنانت ناخن رنگین گواهی می‌دهد","بر سرانگشتان که در خون عزیزان داشتی","ناخن‌های رنگین تو، نشان‌دهنده این هستند که بر انگشتانت دلیلی برای خونریزی عزیزان خود داشتی."],[528,"تا تو برگشتی نیامد هیچ خلق اندر نظر","کز خیالت شحنه‌ای بر ناظرم بگماشتی","تا تو بازگشتی، هیچ‌کس در نظر ظاهر نشد، زیرا از خیال تو نگهبانی بر چشمم گماشته شده بود."],[528,"هر چه خواهی کن که ما را با تو روی جنگ نیست","سر نهادن به در آن موضع که تیغ افراشتی","هر کاری که می‌خواهی انجام بده، زیرا ما هیچ خصومتی با تو نداریم. ما در جایی که شمشیرت را بلند کرده‌ای، تسلیم نمی‌شویم («می‌شویم» صحیح است)."],[528,"هر دم از شاخ زبانم میوه‌ای تر می‌رسد","بوستان‌ها رست از آن تخمم که در دل کاشتی","هر لحظه از زبان من سخن تازه و دلنشینی بیرون می‌آید، مانند میوه‌ای که از درخت می‌رسد. این سخنان میوه‌ای هستند که از دانه‌ای که در دل خود کاشته‌ام، به وجود آمده‌اند."],[528,"سعدی از عقبی و دنیا روی در دیوار کرد","تا تو در دیوار فکرش نقش خود بنگاشتی","سعدی از آخرت و دنیای فانی گذشت و رو به دیوار کرد، از وقتی که تو در دیوار فکر و اندیشه‌اش، تصویر خود را بر جای بگذاشتی. (AI: سعدی از گذشت زمان و دنیای فانی یادآوری می‌کند که تو باید در دیوار فکر و اندیشه‌ات، تصویر خود را بر جای بگذاری.)"],[529,"سست پیمانا به یک ره دل ز ما برداشتی","آخر ای بد عهد سنگین دل چرا برداشتی","ای سست پیمان، با یک حرکت، دل ما را از ما جدا کردی. ای بدعهد و سنگدل، چرا این کار را کردی؟"],[529,"نوع تقصیری تواند بود ای سلطان عشق","تا به یک ره سایه لطف از گدا برداشتی","ای سلطان عشق، چه نوع خطایی ممکن است انجام داده باشی که به یکباره سایه لطف و رحمت خود را از گدا (زیردست) برداشته‌ای؟"],[529,"گفته بودی با تو در خواهم کشیدن جام وصل","جرعه‌ای ناخورده شمشیر جفا برداشتی","تو گفته بودی که می‌خواهی با من پیوندی برقرار کنی، اما بدون اینکه حتی یک لحظه از محبت و دوستی را بچشی، ناگهان به من آسیب زدی و محبت را از من دریغ کردی."],[529,"خاطر از مهر کسان برداشتم از بهر تو","چون تو را گشتم تو خود خاطر ز ما برداشتی","به خاطر عشق تو، محبت دیگران را رها کردم، اما وقتی به تو نزدیک شدم، تو هم محبت را از من دور کردی."],[529,"لعل دیدی لاجرم چشم از شبه بردوختی","در پسندیدی و دست از کهربا برداشتی","تو در زیبایی و جذابیت مانند لعل (یک نوع سنگ قیمتی) هستی، بنابراین از چشم خود به آنچه شبیه تو بود، صرف‌نظر کردی و چون در (مروارید) را پسندیدی، از کهربا (ماده‌ای معطر و قیمتی) دست کشیدی."],[529,"شمع بر کردی چراغت بازنامد در نظر","گل فرا دست آمدت مهر از گیا برداشتی","شمع روشن کردی (بر کردن در جنوب یعنی روشن کردن) و نورش در نظر تو زیباتر جلوه کرد، گل به دستت رسید و عشق گیاهان را فراموش کردی."],[529,"دوست بردارد به جرمی یا خطایی دل ز دوست","تو خطا کردی که بی جرم و خطا برداشتی","اگر دوستی به خاطر اشتباه یا گناهی دل را بگیرد، تو که بی‌دلیل و بدون خطا دل او را به دست آوردی."],[529,"عمرها در زیر دامن برد سعدی پای صبر","سر ندیدم کز گریبان وفا برداشتی","سعدی می‌گوید که عمرها در زیر دامن عشق و محبت سپری شده، اما هیچ‌گاه صبر و بردباری را در آن زمان ندیدم که از گریبان وفا و صداقت بیرون آوردی."],[530,"ندیدمت که بکردی وفا بدان چه بگفتی","طریق وصل گشادی من آمدم تو برفتی","من تو را ندیدم که به وعده‌ات وفا کردی و آنچه گفتی را عمل نمودی. راه وصال را گشودی و من برای پیوستن آمدم، اما تو رفتی و مرا تنها گذاشتی."],[530,"وفای عهد نمودی دل سلیم ربودی","چو خویشتن به تو دادم تو میل باز گرفتی","تو به قول خود وفا نکردی و دل پاک و بی‌آلایش مرا ربودی، در حالی که من خودم را به تو سپردم و تو از من رو برگرداندی."],[530,"نه دست عهد گرفتی که پای وصل بدارم","به چشم خویش بدیدم خلاف هر چه بگفتی","تو به عهد و وعده‌ات وفا نکردی و نگذاشتی که به وصل تو امیدوار باشم. با چشمان خودم دیدم که برخلاف آنچه می‌گفتی، عمل کردی."],[530,"هزار چاره بکردم که هم‌عنان تو گردم","تو پهلوان‌تر از آنی که در کمند من افتی","برای نزدیک شدن به تو هزار راه تدبیر کردم، اما تو آن قدر قوی و نیرومند هستی که قابل گرفتار شدن در دام من نیستی."],[530,"نه عدل بود نمودن خیال وصل و ربودن","چرا ز عاشق مسکین هم اولش ننهفتی","نشان دادن آرزوی وصال و در عین حال گرفتن آن از عاشق بیچاره، کار نادرستی است؛ چون تو حتی اول کار هم نتوانستی از عشقش پنهان بمانی."],[530,"تو قدر صحبت یاران و دوستان نشناسی","مگر شبی که چو سعدی به داغ عشق بخفتی","تو هیچ‌گاه ارزش و مقام دوستی و همراهی یاران را نمی‌دانی، مگر در شبی که مانند سعدی به خاطر عشق دلتنگ و غمگین خواب‌ات ببرد."],[531,"ای از بهشت جزوی و از رحمت آیتی","حق را به روزگار تو با ما عنایتی","ای که بخشی از بهشت و نشانه‌ای از رحمت الهی هستی، خدا در زمان تو نسبت به ما لطف و مرحمت دارد."],[531,"گفتم نهایتی بود این درد عشق را","هر بامداد می‌کند از نو بدایتی","عشق درد و رنجی است که به نظر می‌رسد پایانی ندارد و هر روز دوباره از سر شروع می‌شود."],[531,"معروف شد حکایتم اندر جهان و نیست","با تو مجال آن که بگویم حکایتی","معروف شده است که داستان عشق من در جهان شنیده شده و حالا فرصتی نیست که برایت بگویم چه حکایتی دارم."],[531,"چندان که بی تو غایت امکان صبر بود","کردیم و عشق را نه پدید است غایتی","تا جایی که جدا از تو صبر کردیم، همه‌ی تلاش‌ها بود، اما عشق هیچ‌گاه پایانی ندارد."],[531,"فرمان عشق و عقل به یک جای نشنوند","غوغا بود دو پادشه اندر ولایتی","عشق و عقل هر دو در یک مکان به یکدیگر گوش نمی‌دهند و میانشان درگیری و شلوغی است، مانند این که دو پادشاه در یک کشور به تنش و نزاع مشغولند."],[531,"ز ابنای روزگار به خوبی ممیزی","چون در میان لشکر منصور رایتی","میان مردم زمانه، مانند پرچم منصور، خوب و بد را از هم تشخیص می‌دهی."],[531,"عیبت نمی‌کنم که خداوند امر و نهی","شاید که بنده‌ای بکشد بی جنایتی","من عیب‌جویی نمی‌کنم، زیرا ممکن است که خداوند برای آزمایش و هدایت دیگران، شخصی را بی‌دلیلی و بدون گناه بگیرد."],[531,"زان گه که عشق دست تطاول دراز کرد","معلوم شد که عقل ندارد کفایتی","زمانی که عشق دستش را دراز کرد و به تخطی و تجاوز پرداخت، مشخص شد که عقل توانایی و کفایت لازم را ندارد."],[531,"من در پناه لطف تو خواهم گریختن","فردا که هر کسی رود اندر حمایتی","من فردا در سایه لطف تو فرار می‌کنم، زیرا هر کس به حمایتی پناه می‌برد."],[531,"درمانده‌ام که از تو شکایت کجا برم","هم با تو گر ز دست تو دارم شکایتی","در حالتی ناامید و درمانده‌ام که نمی‌دانم باید از چه کسی و کجا از تو شکایت کنم؛ حتی اگر به تو شکایت داشته باشم، باز هم نمی‌توانم از تو دور شوم."],[531,"سعدی نهفته چند بماند حدیث عشق","این ریش اندرون بکند هم سرایتی","سعدی می‌گوید که راز عشق و داستان‌های مربوط به آن تا چه زمانی باید پنهان بماند؛ این درد درون من چنان است که انگار باید بی‌پرده بیان شود."],[532,"چون خراباتی نباشد زاهدی‌؟","که‌ش به شب از در درآید شاهدی","چطور ممکن است که زاهد (کسی که به زهد و رهبانیت مشهور است) در جایی از میخانه (خرابات) نباشد؟ زیرا همواره در شب، معشوق (شاهد) از در میخانه وارد می‌شود."],[532,"محتسب گو تا ببیند روی دوست","همچو محرابی و من چون عابدی","محتسب (بازرسان شرع) بگو که وقتی صورت دوست را می‌بیند، مانند محراب که محل نماز است زیباست، و من ویژگی‌ام مانند عابدین است که در برابر آن خدا را می‌پرستند."],[532,"چون من آب زندگانی یافتم","غم نباشد گر بمیرد حاسدی","چون من آب حیات را پیدا کردم، دیگر غمی ندارم حتی اگر حسودان بمیرند."],[532,"آنچه ما را در دل است از سوز عشق","می‌نشاید گفت با هر باردی","آنچه در دل ما از سوز عشق وجود دارد، نمی‌توان با هر دلسرد و افسرده‌ای بیان کرد. (AI: آنچه در دل ما از درد عشق وجود دارد، نمی‌توان با هر زبانی بیان کرد.)"],[532,"دوستان گیرند و دلداران ولیک","مهربان نشناسد الا واحدی","دوستان و دلداران بسیاری هستند، اما تنها یک نفر است که دل مهربان را درک می‌کند و شایسته محبت است."],[532,"از تو روحانی‌ترم در پیش دل","نگذرد شب‌های خلوت واردی","من از تو در مقام روحانیت و معنویت بالاتر هستم، اما در دل کسی نمی‌تواند به آن شب‌های تنهایی و خلوتی که تو تجربه کرده‌ای، راه یابد."],[532,"خانه‌ای در کوی درویشان بگیر","تا نماند در محلت زاهدی","خانه‌ای در محله درویشان بگیر تا در محل شما زاهد یا ریاکاری باقی نماند."],[532,"گر دلی داری و دلبندیت نیست","پس چه فرق از ناطقی تا جامدی‌؟","اگر دل داری و کسی را دوست نداری، پس چه تفاوتی بین تو و موجودی بی‌جان وجود دارد؟"],[532,"گر به خدمت قائمی خواهی‌، منم","ور نمی‌خواهی‌، به حسرت قاعدی","اگر به دنبال خدمتگذاری هستی که ایستاده و ثابت‌قدم باشد، من همانم. اما اگر نمی‌خواهی، من به حسرت بنشسته‌ام. / تضاد: قائم، قاعد / (AI: اگر به دنبال کمک و پشتیبانی کسی هستی که ایستاده و ثابت قدم باشد، من همانم. اما اگر نمی‌خواهی، باید با حسرت زندگی کنی.)"],[532,"سعدیا گر روزگارت می‌کشد","گو بکش بر دست سیمین‌ساعدی","سعدی، اگر روزگار تو را می‌کشد، پس بگذار بکشید، زیرا او بر دست‌های زیبا و نازک من دست گذاشته است."],[533,"ای باد بامدادی خوش می‌روی به شادی","پیوند روح کردی پیغام دوست دادی","ای باد صبحگاهی، که با شادابی می‌گذری، روح را به شوق می‌آوری و پیام دوستی را به دوشادوشی می‌فرستی."],[533,"بر بوستان گذشتی‌؟ یا در بهشت بودی‌؟","شاد آمدی و خرم‌، فرخنده‌بخت بادی","فرخنده‌بخت بادی‌: فرخنده‌بخت و نیک‌بخت بشوی."],[533,"تا من در این سرایم این در ندیده بودم","کامروز پیش چشمم در بوستان گشادی","تا امروز که در این خانه هستم، این در را ندیده بودم، اما امروز پیش چشمانم در بوستان باز شده است."],[533,"چون گل روند و آیند این دلبران و خوبان","تو در برابر من چون سرو بایستادی","وقتی دلبران و زیباها مانند گل‌ها به جلو می‌آیند، تو مانند درخت سرو در برابر من ایستاده‌ای."],[533,"ایدون که می‌نماید در روزگار حسنت","بس فتنه‌ها بزاید تو فتنه از که زادی‌؟","اگر در روزگار زیبایی تو فتنه‌ها و مشکلاتی پیش می‌آید، پس تو چطور از این فتنه‌ها به وجود آمده‌ای؟"],[533,"اول چراغ بودی‌، آهسته شمع گشتی","آسان فراگرفتم‌، در خرمن اوفتادی","آسان فراگرفتم‌: دست‌کم و آسان گرفتم."],[533,"خواهم که بامدادی بیرون روی به صحرا","تا بوستان بریزد گل‌های بامدادی","می‌خواهم که صبح زود از خانه بیرون بروم و به دشت بروم تا در باغ، گل‌های صبحگاهی بریزد و خوشبو شود."],[533,"یاری که با قرینی الفت گرفته باشد","هر وقت یادش آید‌، تو دم‌به‌دم به یادی","هر‌وقت‌: در اینجا یعنی گاه‌گاهی‌."],[533,"گر در غمت بمیرم‌، شادی به روزگارت","پیوسته نیکوان را غم خورده‌اند و شادی","اگر بر اثر غم تو بمیرم، شادی به زندگی‌ات پیوسته است؛ کسانی که نیکوکارند و خوب زندگی کرده‌اند، همواره دچار غم شده‌اند و شادی را از دست داده‌اند."],[533,"جایی که داغ گیرد دردش دوا پذیرد","آن است داغ سعدی‌، کاول نظر نهادی","اول نظر‌: اولین نگاه."],[534,"دیدی که وفا به جا نیاوردی","رفتی و خلاف دوستی کردی","تو دیدی که به وعده‌ات عمل نکردی و رفتی و به دوستی‌ات پشت کردی."],[534,"بیچارگیم به چیز نگرفتی","درماندگیم به هیچ نشمردی","من را به خاطر بدبختی‌ام در نظر نگرفتی و به حال درماندگی‌ام اهمیتی ندادی."],[534,"من با همه جوری از تو خشنودم","تو بی گنهی ز من بیازردی","من با همه ستمت از تو راضی‌ام. با اینکه من هیچ تقصیری نداشتم، اما تو از دست من ناراحت شدی. (AI: من از همه جنبه‌ها راضی‌ام و نگرانم نیستم. تو هیچ تقصیری نداری، اما من از دست تو ناراحت شدم.)"],[534,"خود کردن و جرم دوستان دیدن","رسمیست که در جهان تو آوردی","تو این عادت را در دنیا برقرار کرده‌ای که دوستان خود را مقصر نشان دادن و خود را بی‌گناه جلوه دادن."],[534,"نازت ببرم که نازک اندامی","بارت بکشم که نازپروردی","من لازم است زیبایی و نرمش اندام تو را بپرورانم و با محبت و لطافت، تحمل سنگینی محبت‌ات را بکنم، چون تو را عزیز و نازپرورده می‌دانم."],[534,"ما را که جراحت است خون آید","درد تو چنم که فارغ از دردی","ما که به خاطر زخم‌های خود خون می‌ریزیم، دردت به جانم که از درد آسوده‌ای. (AI: ما که به خاطر زخم‌های خود خون می‌ریزیم، چطور می‌توانیم به درد تو بی‌توجه باشیم وقتی که خودمان از درد رنج می‌بریم؟)"],[534,"گفتم که نریزم آب رخ زین بیش","بر خاک درت که خون من خوردی","گفتم که دیگر اشک نریزم و چهره‌ام را بر خاک درگاه تو بریزم، چون تو با عشق و دل‌تنگی‌ام بازی کرده و خون دلم را به راه انداخته‌ای."],[534,"وین عشق تو در من آفریدستند","هرگز نرود ز زعفران زردی","عشق تو در وجود من چنان تأثیر عمیقی دارد که هیچ‌گاه از یادم نخواهد رفت و مثل زعفران زرد که به راحتی محو نمی‌شود، همیشه در خاطر من باقی خواهد ماند."],[534,"ای ذره تو در مقابل خورشید","بیچاره چه می‌کنی بدین خردی","ای ذره (مقدار کوچک) در برابر خورشید (نشانۀ بزرگی و عظمت) چه کاری از تو ساخته است که اینقدر ناچیزی؟"],[534,"در حلقه کارزار جان دادن","بهتر که گریختن به نامردی","جان دادن در میدان جنگ و ایستادگی در مقابل دشمن، بهتر از فرار کردن و خیانت به نامردی است."],[534,"سعدی سپر از جفا نیندازد","گل با گیه است و صاف با دردی","سعدی با ظلم و ستم تسلیم نمی‌شود و سپر نمی‌اندازد، (چون او می‌داند) که همراه گل علف هرز هست و با شراب صاف، درد. / صاف و درد: غزل 28 بیت 9 / (AI: سعدی می‌گوید کسی که در برابر ناملایمات و سختی‌ها خود را محافظت نمی‌کند، همچون گلی است که به راحتی آسیب می‌بیند. او می‌خواهد بگوید اگر کسی نسبت به درد و رنج بی‌توجه باشد، نمی‌تواند در زندگی پایدار بماند.)"],[535,"مپرس از من که هیچم یاد کردی","که خود هیچم فرامش می‌نگردی","از من نپرس که آیا به یاد تو هستم یا نه؛ زیرا خودت هیچ توجهی به من نمی‌کنی و من را فراموش کرده‌ای."],[535,"چه نیکو‌روی و بدعهدی که شهری","غمت خوردند و کس را غم نخوردی","ای خوش‌چهره و بی‌وفا، که شهری (گروهی از مردم) از غم تو رنج می‌بردند، اما تو به هیچ‌کس توجه نکردی و غمی برای آنها احساس نکردی."],[535,"چرا ما با تو ای معشوق طناز","به صلحیم و تو با ما در نبردی","با تو، ای معشوق زیبا که به طنازی معروفی، در آرامش و صلح هستیم، اما تو در مقابل ما با رفتار دشمنانه و جنگی برخورد می‌کنی."],[535,"نصیحت می‌کنندم سردگویان","که برگرد از غمش بی‌روی زردی","سردگویان، که به‌طور معمول پیام‌هایی از روی بی‌احساسی می‌دهند، به من نصیحت می‌کنند که از غم معشوقم دوری کنم و از غم او رنج نکشم، اما من نمی‌توانم با چنین بی‌احساسی برخورد کنم."],[535,"نمی‌دانند کز بیمار عشقت","حرارت باز ننشیند به سردی","آن‌ها نمی‌دانند که عشق تو برای من به قدری شدید است که احساس سرمایی که می‌گویند به وجود نخواهد آمد و هیچ‌گاه از بین نخواهد رفت."],[535,"ولیکن با رقیبان چاره‌ای نیست","که ایشان مثل خارند و تو وردی","اما در برابر رقیبان چاره‌ای نیست، زیرا آن‌ها مانند خارانی دردآور هستند و تو مانند گلی زیبا و خوشبو."],[535,"اگر با خوبرویان می‌نشینی","بساط نیک‌نامی درنوردی","اگر با افراد زیبا و نیکو صورت معاشرت کنی، اعتبار و نیک‌نامی خود را از دست می‌دهی."],[535,"دگر با من مگوی ای باد گلبوی","که همچون بلبلم دیوانه کردی","ای باد معطر، دیگر با من صحبت نکن، زیرا تو مرا دیوانه کرده‌ای، همان‌گونه که بلبل را دیوانه می‌کند."],[535,"چرا دردت نچیند جان سعدی","که هم دردی و هم درمان دردی","چرا سعدی دردت را به جان نخرد؟ که خودت، هم دردی و هم درمانی. (AI: چرا تو، ای جان سعدی، از درد خود نرنجی وقتی که هم خود درد را درک می‌کنی و هم دارویی برای درمان آن داری؟)"],[536,"مکن سرگشته آن دل را که دست‌آموز غم کردی","به زیر پای هجرانش لگدکوب ستم کردی","به قلبم بخاطر تحمل دوری و هجرانت ستم کردی و آن را به غم و اندوه عادت دادی. دیگر آنرا پریشان‌تر و خسته‌تر مکن."],[536,"قلم بر بی‌دلان گفتی نخواهم راند و هم راندی","جفا بر عاشقان گفتی نخواهم کرد و هم کردی","تو به بی‌دلان گفته‌ای که قلم را از آن‌ها دور نمی‌کنی، اما در واقع این کار را کردی؛ و به عاشقان گفته‌ای که به آن‌ها جفا نمی‌کنی، اما در عمل این کار را انجام داده‌ای."],[536,"بدم گفتی و خرسندم عفاک الله، نکو گفتی","سگم خواندی و خشنودم جزاک الله، کرم کردی","گفتی که بد هستم و من از این حرف خوشحالم؛ خدا تو را ببخشد. همچنین گفتی که خوب هستی و من را مانند سگ خواندی و از این هم خوشحالم؛ خدا پاداش نیکی‌هایت را بدهد."],[536,"چه لطف است این که فرمودی؟ مگر سبق اللّسان بودت؟","چه حرف است این که آوردی؟ مگر سهو القلم کردی؟","تو چه لطفی کرده‌ای که اینگونه درباره من سخن گفتی؟ آیا از قبل سخن را آماده کرده بودی؟ یا اینکه قلمت در نوشتن اشتباه کرده و آنچه را که نباید گفته بودی، به زبان آوردی؟"],[536,"عنایت با من اولی‌تر که تأدیب جفا دیدم","گل‌افشان بر سر من کن که خارم در قدم کردی","مناعت و توجه تو به من بیشتر از این است که دیگران با من رفتار کنند. من درنتیجه جفا و بی‌محبتی‌ها آسیب دیده‌ام، پس لطف کن و گل‌افشانی کن، زیرا تو با قدم‌های خود بر من خاری گذاشته‌ایی."],[536,"غنیمت دان اگر روزی به شادی در رسی ای دل","پس از چندین تحمل‌ها که زیر بار غم کردی","قلب خسته‌ی من! اگر روزی به شادی و وصال یار رسیدی، آنرا باارزش بدان، چراکه رنج‌ها و سختی‌های زیادی را بخاطر آن تحمل کرده‌ای."],[536,"شب غم‌های سعدی را مگر هنگام روز آمد؟","که تاریک و ضعیفش چون چراغ صبحدم کردی","آیا شب غم‌های سعدی فقط در روز روشن و زندگی امیدوارانه امکان‌پذیر شد؟ که آن را به روشنی صبح تبدیل کردی و از تاریکی و ضعف خارج ساختی؟"],[537,"چه باز در دلت آمد که مهر برکندی","چه شد که یار قدیم از نظر بیفکندی","چه چیزی دوباره در دلت خطور کرد که دست از مهر و محبت کشیدی؟ چه اتفاقی افتاد که دوست قدیمی ات را از نظر انداختی"],[537,"ز حد گذشت جدایی میان ما ای دوست","هنوز وقت نیامد که بازپیوندی","دوران جدایی ما خیلی طول کشیده و بیش از اندازه شده است.آیا هنوز وقت ان نرسیده که دوباره به هم بپیوندیم"],[537,"بود که پیش تو میرم اگر مجال بود","وگرنه بر سر کویت به آرزومندی","اگر فرصتی پیش می‌آمد، به سمت تو می‌رفتم، اما اگر نه، بر سر کوچه‌ات می‌ایستم و به تو فکر می‌کنم."],[537,"دری به روی من ای یار مهربان بگشای","که هیچ کس نگشاید اگر تو در بندی","ای دوست مهربان، دری به روی من باز کن، زیرا هیچ‌کس دیگری نمی‌تواند چنین کاری بکند اگر تو در قید و بند باشی و مانع آن شوی."],[537,"مرا وگر همه آفاق خوبرویانند","به هیچ روی نمی‌باشد از تو خرسندی","هرچند که در تمام جهان افراد زیبا وجود دارند، اما من هیچ‌گاه از هیچ‌کدام به اندازه تو راضی و خوشنود نخواهم بود."],[537,"هزار بار بگفتم که چشم نگشایم","به روی خوب ولیکن تو چشم می‌بندی","من بارها به خودم گفته‌ام که به روی زیبای تو نگاه نکنم، اما تو همچنان چشمانت را می‌بندی و مرا نمی‌بیند."],[537,"مگر در آینه بینی وگرنه در آفاق","به هیچ خلق نپندارمت که مانندی","جز در آینه نمی‌توانی خود را ببینی، و اگر در آینه نبینی، در دنیا هیچ‌کس تو را شبیه به خود نمی‌داند."],[537,"حدیث سعدی اگر کائنات بپسندند","به هیچ کار نیاید گرش تو نپسندی","سعدی می‌گوید اگر داستان و سخن او را تمام موجودات جهان هم بپسندند، در عین حال بی‌فایده است اگر تو آن را نپسندی."],[537,"مرا چه بندگی از دست و پای برخیزد","مگر امید به بخشایش خداوندی","من چگونه می‌توانم به بندگی پیروی کنم و از کارهایی که مرا محدود می‌کند آزاد شوم، در حالی که تنها به رحمت و بخشش خداوند امیدوارم؟"],[538,"گفتم آهن‌دلی کنم چندی","ندهم دل به هیچ دل‌بندی","من گفتم مدتی دل‌سوزی کنم و به هیچ عشقی وابسته نشوم."],[538,"وآن که را دیده در دهان تو رفت","هرگزش گوش نشنود پندی","هر کسی که زیبایی و جذابیت تو را دیده و به زبان تو علاقه‌مند شده، هرگز نصیحت و پندی نخواهد شنید که او را از این میل بازدارد."],[538,"خاصه ما را که در ازل بوده است","با تو آمیزشی و پیوندی","ما، به‌خصوص، که در آغاز خلقت با تو پیوند و ارتباطی داشتیم."],[538,"به دلت، کز دلت به در نکنم","سخت‌تر زین مخواه سوگندی","به دل تو، که از دل خودت جدا نمی‌شوم، بیشتر از این نخواهی توانست سوگند بخوری."],[538,"یک دم آخر حجاب یک سو نه","تا برآساید آرزومندی","اگر یک لحظه پرده‌ها کنار برود و آرزوهای من برآورده شود، زندگی‌ام به آرامش می‌رسد."],[538,"همچنان پیر نیست مادر دهر","که بیاورد چون تو فرزندی","معلوم است که مادر زمان چندان هم پیر نشده چون توانسته فرزندی چون تو بیاورد."],[538,"ریش فرهاد بهترک می‌بود","گر نه شیرین نمک پراکندی","ریش در اینجا به معنی زخم و رنج و ناراحتی است. ومنظور شاعر اینکه رنج فرهاد بهتر می شد اگر شیرین به دیدار او نمی رفت و با این کار نمک بر زخم عشق او نمی پاشید."],[538,"کاشکی خاک بودمی در راه","تا مگر سایه بر من افکندی","ای کاش من خاک بودم تا تو بر من سایه بیندازی و بر من رحمت کنی."],[538,"چه کند بنده‌ای که از دل و جان","نکند خدمت خداوندی","بنده‌ای که از دل و جان به خدمت خداوند نپردازد، چه کار می‌تواند بکند؟"],[538,"سعدیا دور نیک‌نامی رفت","نوبت عاشقی است یک چندی","سعدی، نیک‌نامی و شهرت از بین رفته است و حالا زمان عاشقی فرارسیده و باید برای مدتی به عشق پرداخت."],[539,"نگارا وقت آن آمد که دل با مهر پیوندی","که ما را بیش از این طاقت نمانده‌ست آرزومندی","ای معشوق، وقت آن رسیده که دل به محبت تو پیوند بخورد، زیرا ما دیگر تحمل انتظار را نداریم و تنها آرزو داریم."],[539,"غریب از خوی مطبوعت که روی از بندگان پوشی","بدیع از طبع موزونت که در بر دوستان بندی","اگر در برابر بندگان خود، روی خود را بپوشانی و آنها را از خود دور کنی، زیبایی و لطافت ذاتی‌ات را که باعث دوستی با دوستان می‌شود، دوست‌داشتنی و خاص جلوه می‌دهد."],[539,"تو خرسند و شکیبایی چنینت در خیال آید","که ما را همچنین باشد شکیبایی و خرسندی","تو در حالتی خوش و صبور به سر می‌بری، و تصور می‌کنی که ما نیز در چنین حالتی از صبر و خوشحالی هستیم، در حالی که اینطور نیست."],[539,"نگفتی بی‌وفا یارا که از ما نگسلی هرگز؟","مگر در دل چنین بودت که خود با ما نپیوندی","ای یار بی‌وفا، چرا به من نگفتی که هرگز از ما جدا نخواهی شد؟ آیا در دل تو چنین بوده که هرگز با من ارتباط نداشته باشی و به من وابسته نشوی؟"],[539,"زهی آسایش و رحمت نظر را کش تو منظوری","زهی بخشایش و دولت، پدر را کش تو فرزندی","ای کاش آسایش و رحمت تو بر نظر و نگاه خداوند باشد، زیرا تو هدف نیکویی هستی. ای کاش بخشش و سعادت برای پدر به خاطر فرزندی همچون تو باشد."],[539,"شکار آن گه توان کشتن که محکم در کمند آید","چو بیخ مهر بنشاندم درخت وصل برکندی","شکار را زمانی می‌توان کشت که محکم به دام بیفتد. اگر مروت و محبت را از ریشه قطع کنم، درخت محبت و وصال را از بیخ می‌کنم."],[539,"نمودی چند بار از خود که حافظ عهد و پیمانم","کنونت باز دانستم که ناقض عهد و سوگندی","تو چندین بار به من نشان دادی که به من وفاداری و عهدی داری، اما اکنون فهمیدم که تو پیمان شکن و ناقض سوگند هستی."],[539,"مرا زین پیش در خلوت فراغت بود و جمعیت","تو در جمع آمدی ناگاه و مجموعان پراکندی","قبل از این، تنها در گوشه‌ای از خلوت و آرامش بودم، اما تو ناگهان به جمع ما آمدی و باعث شدی که همه در هم بریزند و پراکنده شوند."],[539,"گرت جان در قدم ریزم هنوزت عذر می‌خواهم","که از من خدمتی ناید چنان لایق که بپسندی","اگر برایت جانم را فدای قدم‌هایت کنم، باز هم از تو عذرخواهی می‌کنم، چون خدمتی از من نمی‌تواند باشد که مورد رضایت تو قرار گیرد."],[539,"ترش بنشین و تیزی کن که ما را تلخ ننماید","چه می‌گویی چنین شیرین که شوری در من افکندی","هر چند صورت تو عبوس و ناراحت به نظر می‌رسد، اما باید تیز و تندخوش باشی تا ما را تلخ و ناراحت نبینی. چرا این حرف‌های شیرین را می‌زنی که در دل من شور و اضطراب ایجاد کرده است؟"],[539,"شکایت گفتن سعدی مگر باد است نزدیکت؟","که او چون رعد می‌نالد تو همچون برق می‌خندی","سعدی می‌پرسد آیا شکایت او به گوش تو می‌رسد مانند اینکه باد نزدیک توست؟ زیرا شکایت او همانند صدای رعد بلند است، اما تو در مقابل آن فقط به‌خنده‌ی برق نگاه می‌کنی و متوجه‌ی شدت آن نمی‌شوی."],[540,"خلاف شرط محبت، چه مصلحت دیدی؟","که برگذشتی و از دوستان نپرسیدی؟","چرا برعکس قول و محبت رفتار کردی و از دوستان خود خداحافظی نکردی؟ چه دلیلی برای این کار داشتید؟"],[540,"گرفتمت که نیآمد ز روی خلق آزرم","که بی‌گنه بکشی، از خدا نترسیدی؟","من تو را گرفتم و این را به سبب شرم از دیگران می‌دانم؛ زیرا که تو بدون اینکه گناهی داشته باشی، جان کسی را می‌گیری و از خدا نمی‌ترسی؟"],[540,"بپوش روی نگارین و موی مشکین را","که حسن طلعت خورشید را بپوشیدی؟","زیبایی چهره‌ات و موهای سیاهت را بپوشان، زیرا آیا نیازی به پنهان کردن زیبایی‌ات از چشم‌ها نیست؟"],[540,"هزار بی‌دل مشتاق را به حسرت آن","که لب به لب برسد، جان به لب رسانیدی","بسیاری از دل‌سوختگان را به خاطر اینکه آرزو دارند لب‌هایشان به هم برسد، به اندازه‌ای در حسرت گذاشتی که جانشان به لبشان رسیده است."],[540,"محل و قیمت خویش آن زمان بدانستم","که برگذشتی و ما را به هیچ نخریدی","به یادگیری ارزش و مقام خود پی بردم زمانی که از کنار ما رد شدی و ما را به هیچ انگاشتی."],[540,"هزار بار بگفتیم و هیچ درنگرفت","که گرد عشق مگرد ای فقیر و گردیدی","بیش از هزار بار به تو گفتیم که دور عشق نگرد و همیشه در این باره تأکید کردیم، اما تو همچنان گرفتار عشق شدی."],[540,"تو را ملامت رندان و عاشقان سعدی","دگر حلال نباشد که خود بلغزیدی","عاشقان و رندانی که سعدی به آن‌ها اشاره دارد، دیگر نمی‌توانند تو را سرزنش کنند چون خودت در عشق لغزیده‌ای و دچار اشتباه شده‌ای."],[540,"به تیغ می‌زد و می‌رفت و باز می‌نگریست","که ترک عشق نگفتی، سزای خود دیدی","او با شمشیر (یا حقیقت) به جان دل‌باختگان می‌زد و می‌رفت، اما بار دیگر نگاه می‌کرد. به این ترتیب که این عشق را ترک نکردی، خودت باید عواقب کار را ببینی."],[541,"مگر دگر سخن دشمنان نیوشیدی","که روی چون قمر از دوستان بپوشیدی","آیا به سخنان دشمنان گوش «داده‌ای» که باعث «شده‌» روی زیبا و چون ماه خود را از دوستانت پنهان کنی؟ / نیوشیدن: شنیدن"],[541,"من از جفای زمان، بلبلا نخفتم دوش","تو را چه بود که تا صبح می‌خروشیدی","من از ظلم و بدی‌های زمانه به شدت ناراحتم و نمی‌توانستم مانند بلبل در آرامش بمانم. تو چرا تا صبح به طور مداوم غمگین و نالان بودی؟"],[541,"قضا به ناله مظلوم و لابه محروم","دگر نمی‌شود ای نفس بس که کوشیدی","اجتناب از قضا یا سرنوشت برای کسی که مظلوم و محروم است، ممکن نیست. ای نفس، دیگر کافی است که تلاش کنی؛ هر چه قدر کوشش کنی، قضا تغییر نمی‌کند."],[541,"کنون حلاوت پیوند را بدانی قدر","که شربت غم هجران تلخ نوشیدی","اکنون می‌فهمی که چقدر شیرین است پیوند و ارتباط با دیگران، چرا که غم دوری و جدایی، تلخ‌کامی را به تو چشاند."],[541,"به مقتضای زمان اقتصار کن سعدی","که آن چه غایت جهد تو بود کوشیدی","سعدی، با توجه به شرایط و زمانه، باید به اندازه و به مختصری بسنده کند، زیرا آنچه که تو برای رسیدن به آن تلاش کرده‌ای، دیگر در دسترس نیست."],[542,"آخر نگاهی باز کن وقتی که بر ما بگذری","یا کبر منعت می‌کند کز دوستان یاد آوری","ای انسان عزیز، وقتی که از کنار ما می‌گذری، یک نگاهی به ما بینداز. آیا تکبر و خودپسندی تو مانع شده است که به یاد دوستانت بیفتی؟"],[542,"هرگز نبود اندر ختن بر صورتی چندین فتن","هرگز نباشد در چمن سروی بدین خوش منظری","هیچ‌گاه در ختن (شهر قدیمی، احتمالا اشاره به چین) به تعداد این زیبایی‌ها و جذابیت‌ها پیدا نمی‌شود و هیچ سروی در باغ نیز به این اندازه زیبا نیست."],[542,"صورتگر دیبای چین گو صورت رویش ببین","یا صورتی برکش چنین یا توبه کن صورتگری","ای که بر دیبای چینی صورتگری می‌کنی، بیا چهره‌اش را ببین، یا صورتی چون او ترسیم کن، یا از صورتگری توبه کن!"],[542,"ز ابروی زنگارین کمان گر پرده برداری عیان","تا قوس باشد در جهان دیگر نبیند مشتری","اگر از ابروی زنگاری و کمان‌مانند خود پرده‌برداری کنی، در این دنیا نمایان می‌شود؛ اما پس از آن، مشتری (ستاره) دیگر چنین زیبایی را نخواهد دید."],[542,"بالای سرو بوستان رویی ندارد دلستان","خورشید با رویی چنان مویی ندارد عنبری","در باغ، درخت سرو، نما و زیبایی‌ای ندارد که دل را شاد کند، چون خورشید هم نمی‌تواند چهره‌ای زیبا مانند آن موهای خوشبو و دلنشین داشته باشد."],[542,"تا نقش می‌بندد فلک کس را نبوده‌ست این نمک","ماهی ندانم یا ملک فرزند آدم یا پری","تا زمانی که فلک (آسمان) نقشی بر زندگانی می‌زند، هیچ‌کس مانند این زیبایی وجود نداشته است. نمی‌دانم این زیبایی انسان است که شبیه ماه است، یا شاید یک پری (موجودی افسانه‌ای) که فرزند آدم است."],[542,"تا دل به مهرت داده‌ام در بحر فکر افتاده‌ام","چون در نماز استاده‌ام گویی به محرابم دری","وقتی که دل به عشق تو سپرده‌ام، در دنیای خیال و فکر غرق شده‌ام، مانند کسی که در حال نماز ایستاده است و گویی در جایگاه مقدس خود قرار دارم."],[542,"دیگر نمی‌دانم طریق از دست رفتم چون غریق","آنک دهانت چون عقیق از بس که خونم می‌خوری","دیگر نمی‌دانم راه نجات کجاست و حس می‌کنم که خیلی در غم و اندوه غوطه‌ور شده‌ام، مانند یک فرد غرق‌شده. تو نیز به گونه‌ای مرا مصرف می‌کنی که دهانت گویی از زیبایی عقیق است، چون من به خاطر عشق تو بسیار رنج می‌برم و خون قلبم را می‌خوری."],[542,"گر رفته باشم زین جهان بازآیدم رفته روان","گر همچنین دامن کشان بالای خاکم بگذری","اگر از این دنیا رفته باشم، بازم به این دنیا برمی‌گردم. اگر تو به‌سرعت از بالای خاک من بگذری در حالیکه دامنم را به‌دست داری، به من توجه نکن."],[542,"از نعلش آتش می‌جهد نعلم در آتش می‌نهد","گر دیگری جان می‌دهد سعدی تو جان می‌پروری","از نعل (زین) اسب آتش بیرون می‌جهد و نعل به آتش می‌افکند. اگر دیگری جان خود را می‌دهد، سعدی تو (به عنوان یک پرورش‌دهنده و نگران) جان دیگران را پرورش می‌دهی و به حفاظت از آن می‌پردازی."],[542,"هر کس که دعوی می‌کند کاو با تو انسی می‌کند","در عهد موسی می‌کند آواز گاو سامری","هر کسی که ادعا می‌کند و به تو نزدیک می‌شود، مانند کسی است که در زمان موسی، صدای گاو سامری را می‌زند، یعنی عده‌ای هستند که با وجود نزدیکی به حق، به ظواهر غیر واقعی و باطل وابسته‌اند."],[543,"ای برق اگر به گوشه آن بام بگذری","آنجا که باد زهره ندارد؛ خبر بری","ای برق، اگر از کنار آن بام بگذر‌ی، آنجا که نسیم نمی‌تواند به راحتی نفوذ کند، خبر را برسان."],[543,"ای مرغ اگر پری به سر کوی آن صنم","پیغام دوستان برسانی بدان پری","ای مرغ، اگر بال‌ای داری و می‌توانی به کوی آن معشوق بروی، پیغام دوستان را به او برسان."],[543,"آن مشتری خصال گر از ما حکایتی","پرسد؛ جواب ده که به جانند مشتری","اگر آن شخص نیکوخصال از ما چیزی بپرسد، به او بگو که ما جان خود را برای او می‌دهیم و او برای ما عزیز است."],[543,"گو تشنگان بادیه را جان به لب رسید","تو خفته در کجاوه به خواب خوش اندری","اگر تشنگان راه بیابان در حال مرگ باشند، تو در خواب خوش در دارایی راحتی و بی‌خبری."],[543,"ای ماهروی حاضر غایب که پیش دل","یک روز نگذرد که تو صد بار نگذری","ای محبوب با چهره زیبای حاضر و غایب، که در دل من یک روز هم نمی‌گذرد که تو بارها از ذهن و قلب من بگذری و فراموش نشوی."],[543,"دانی چه می‌رود به سر ما ز دست تو؟","تا خود به پای خویش بیایی و بنگری","می‌دانی چه بر ما می‌گذرد به خاطر دوری تو؟ تا وقتی که خودت به پای خودت بیایی و ما را ببینی."],[543,"بازآی کز صبوری و دوری بسوختیم","ای غایب از نظر که به معنی برابری","برگرد و به ما ملحق شو، زیرا ما به خاطر دوری و صبوری پیش تو سوخته‌ایم. ای کسی که از دیده‌ها پنهانی، تو به معنای واقعی نمی‌توانی با ما برابر باشی."],[543,"یا دل به ما دهی چو دل ما به دست توست","یا مهر خویشتن ز دل ما به در بری","یا دل به ما بده، زیرا دل ما در اختیار توست، یا اینکه محبت خودت را از دل ما بیرون کن."],[543,"تا خود برون پرده حکایت کجا رسد","چون از درون پرده چنین پرده می‌دری","نمی‌توان به راحتی داستان را از پشت پرده بیان کرد، چون وقتی کسی این راز را از پس پرده می‌داند، چگونه می‌تواند آن را به زبان بیاورد."],[543,"سعدی تو کیستی که دم دوستی زنی؟","دعویّ بندگی کن و اقرار چاکری","سعدی از دوستش می‌پرسد که تو کی هستی که درباره دوستی صحبت می‌کنی؟ خود را بنده و خادم واقعی معرفی کن تا نشان دهی که چقدر نسبت به دوستی و وفاداری احساس تعهد داری."],[544,"ای که بر دوستان همی‌گذری","تا به هر غمزه‌ای دلی ببری","ای کسی که با ناز و غمزه بر دوستانت می‌گذری، با هر نگاه و حرکتی باعث می‌شوی که دل‌ها را بشکنی و از آن خود کنی."],[544,"دردمندی تمام خواهی کشت","یا به رحمت به کشته می‌نگری","اگر تمام دردهای من را در نظر بگیری، آیا می‌خواهی مرا completely نابود کنی یا با رحمت به وضعیت من نگاه می‌کنی؟"],[544,"ما خود از کوی عشقبازانیم","نه تماشاکنان رهگذری","ما خود اهل عشق و عاشقی هستیم و فقط ناظر و کنار نشسته نیستیم، بلکه در حقیقت در دل این عشق حضور داریم و به آن عمل می‌کنیم."],[544,"هیچم اندر نظر نمی‌آید","تا تو خورشیدروی در نظری","هیچ چیز و کسی برای من مهم نیست و به چشمم نمی‌آید، مگر اینکه تو با چهره‌ات در نظرم باشی."],[544,"گفته بودم که دل به کس ندهم","حذر از عاشقی و بی‌خبری","گفته بودم که به کسی دل نمی‌زنم و از عشق و بی‌خبری دوری می‌کنم."],[544,"حلقه‌ای گرد خویشتن بکشم","تا نیاید درون حلقه پری","می‌خواهم حلقه‌ای دور خودم بزنم تا هیچ پری (عاشق یا معشوق) نتواند به درون آن بیاید."],[544,"وین پری پیکران حلقه به گوش","شاهدی می‌کنند و جلوه گری","این پری‌های زیبا به عنوان شاهد درون حلقه ظاهر می‌شوند و زیبایی خود را به نمایش می‌گذارند."],[544,"صبر بلبل شنیده‌ای هرگز","چون بخندد شکوفه سحری؟","بلبل به صبر و شکیبایی معروف است، آیا تاکنون شنیده‌ای که او در زمانی که گل‌ها شکوفا می‌شوند، بخندد و شاد باشد؟"],[544,"پرده‌داری بر آستانه عشق","می‌کند عقل و گریه پرده‌دری","عقل در آستانه عشق، به خاطر شکافتی که درد و غم عشق ایجاد کرده است، خود را نگه می‌دارد و نمی‌تواند به طور آزادانه اظهار وجود کند. گریه هم به خاطر این درد، به نوعی به مرز شکستن و عبور از حجاب‌ها نزدیک می‌شود."],[544,"چو خوری دانی ای پسر غم عشق","تا غم هیچ در جهان نخوری","ای پسر، وقتی غم عشق را بچشی و آن را درک کنی، متوجه می‌شوی که دیگر غمی در این جهان نیست که بتواند تو را آزار دهد."],[544,"رایگان است یک نفس با دوست","گر به دنیا و آخرت بخری","یک لحظه با دوست بودن، حتی اگر به رایگان باشد، از دنیا و آخرت هم باارزش‌تر است."],[544,"قلم است این به دست سعدی در","یا هزار آستین درّ دری","قلمی که سعدی در دست دارد از جنس گرانبهایی مانند دریا است؛ بنابراین، این قلم ارزشی هزار برابر دارد."],[544,"این نبات از کدام شهر آرند؟","تو قلم نیستی که نیشکری","این گیاه از کدام شهر آورده‌اند؟ تو نمی‌توانی مثل نیشکر و شیرین باشی."],[545,"بخت آیینه ندارم که در او می‌نگری","خاک بازار نیرزم که بر او می‌گذری","من بختی ندارم که بتوانم در آن خودم را ببینم و حالتی از خودآگاهی پیدا کنم. من حتی به قدری بی‌ارزش و خوار هستم که مثل خاک در بازار، فقط زیر پا قرار دارم و به کسی توجه نمی‌کنم."],[545,"من چنان عاشق رویت که ز خود بی‌خبرم","تو چنان فتنه خویشی که ز ما بی‌خبری","من به قدری عاشق چهره تو هستم که از خودم خبر ندارم، و تو به قدری درگیر زیبایی خود هستی که از حال و روز ما بی‌اطلاعی."],[545,"به چه ماننده کنم در همه آفاق تو را","کآنچه در وهم من آید تو از آن خوبتری","به چه چیز می‌توانم تو را در سراسر عالم تشبیه کنم، در حالی که هر تصوری که در ذهن من می‌آید، تو از آن زیباتر هستی."],[545,"برقع از پیش چنین روی نشاید برداشت","که به هر گوشه چشمی دل خلقی ببری","چهره زیبای تو را نمی‌توان به سادگی از مقابل برداشت، زیرا هر نگاهی به آن دل آدم‌ها را می‌رباید."],[545,"دیده‌ای را که به دیدار تو دل می‌نرود","هیچ علت نتوان گفت به جز بی‌بصری","اگر کسی را ببینی که به خاطر دیدن تو دلش تپش نمی‌زند و تحت تأثیر قرار نمی‌گیرد، هیچ دلیلی برای این حالت نمی‌توان آورد جز اینکه او بینا نیست و نمی‌تواند زیبایی تو را ببیند."],[545,"گفتم از دست غمت سر به جهان در بنهم","نتوانم که به هر جا بروم در نظری","گفتم نمی‌توانم از غم تو رهایی یابم و به زندگی ادامه دهم، چون هر جا که بروم، تو در ذهن و خاطر من هستی."],[545,"به فلک می‌رود آه سحر از سینه ما","تو همی برنکنی دیده ز خواب سحری","آه و ناله ما در سحر به آسمان می‌رود و تو هم از خواب سحر بیدار نمی‌شوی."],[545,"خفتگان را خبر از محنت بیداران نیست","تا غمت پیش نیاید غم مردم نخوری","کسانی که خوابن و هنوز رنج و درد تجربه نکردند حال اونایی که رنج و درد دیدن نمیفهمن و تا غم تجربه نکنی نمیتونی غم بقیه رو بفهمی"],[545,"هر چه در وصف تو گویند به نیکویی هست","عیبت آن است که هر روز به طبعی دگری","هر چیزی که در توصیف تو بگویند، همه خوب و پسندیده است، اما مشکل این است که هر روز به شیوه‌ای متفاوت بیان می‌شود."],[545,"گر تو از پرده برون آیی و رخ بنمایی","پرده بر کار همه پرده نشینان بدری","اگر تو از پشت پرده بیرون بیایی و چهره‌ات را نشان بدهی، پرده‌ تیم و راز همه کسانی که در پشت پرده‌اند، کنار می‌رود."],[545,"عذر سعدی ننهد هر که تو را نشناسد","حال دیوانه نداند که ندیده‌ست پری","سعدی می‌گوید کسی که تو را نشناسد، عذر او پذیرفته نیست؛ مثل دیوانه‌ای که نمی‌داند پری را باید دیده باشد و حالش را می‌فهمد."],[546,"جور بر من می‌پسندد دلبری","زور با من می‌کند زورآوری","دلبر با زیبایی و نازش، سختی و ظلم را بر من پسندیده و بر من فشار می‌آورد."],[546,"بار خصمی می‌کشم کز جور او","می‌نشاید رفت پیش داوری","من بار سنگینی از خصومت را تحمل می‌کنم، زیرا از ظلم او نمی‌توانم به کسی شکایت کنم و به دادگاه بروم."],[546,"عقل بیچاره‌ست در زندان عشق","چون مسلمانی به دست کافری","عقل آدمی در دام عشق گرفتار است و مانند مسلمانی است که به دست یک کافر اسیر شده و از آزادی و رهایی بی‌بهره است."],[546,"بارها گفتم بگریم پیش خلق","تا مگر بر من ببخشد خاطری","بارها گفته‌ام که در جمع افراد اشک بریزم تا شاید کسی از دلش برای من بگذرد و مرا عفو کند."],[546,"باز گویم پادشاهی را چه غم","گر به خیلش در بمیرد چاکری","(دوباره با خود) می‌گویم: که اگر پیشوای یک گروهی(، یکی از غلامانش) در کنار او بمیرد، چه اهمیتی دارد."],[546,"ای که صبر از من طمع داری و هوش","بار سنگین می‌نهی بر لاغری","ای کسی که از من انتظار صبر و شکیبایی داری، و بر ضعف و ناتوانی من، بار سنگینی می‌گذاری."],[546,"زآنچه در پای عزیزان افکنند","ما سری داریم اگر داری سری","ما به خاطر محبت و احترام به عزیزان، بر خودمان شایسته است که فداکاری کنیم و اگر تو هم چنین ویژگی‌ای داری، باید به ما بپیوندی."],[546,"چشم عادت کرده با دیدار دوست","حیف باشد بعد از او بر دیگری","چشم که به دیدن دوست عادت کرده، پس از او ناراحت‌کننده است که به کسی دیگر نگاه کند."],[546,"در سراپای تو حیران مانده‌ام","در نمی‌باید به حسنت زیوری","من در تمام وجود تو شگفت‌زده و مسحور مانده‌ام و نمی‌توانم به زیبایی‌ات چیزی اضافه کنم؛ گویا تو خود زیبا و بهترین زیور هستی."],[546,"این سخن سعدی تواند گفت و بس","هر گدایی را نباشد جوهری","این سخن فقط از سعدی برمی‌آید و نه هر کسی، زیرا هر کسی لیاقت یا ویژگی خاصی ندارد که بتواند چنین حرفی بزند."],[547,"خانه صاحب‌نظران می‌بری","پرده پرهیزکنان می‌دری","صاحب‌نظران که افرادی آگاه و دارای بینش هستند، در دل خانه آن‌ها را می‌بردی، اما پرده‌داران پرهیزکار را می‌شکنی و از تمنای آنان تجاوز می‌کنی."],[547,"گر تو پری‌چهره نپوشی نقاب","توبه صوفی به زیان آوری","اگر تو با چهره زیبا و پری‌گونه‌ات نقاب توبه را کنار بزنی، این کار به ضرر صوفی خواهد بود."],[547,"این چه وجود است نمی‌دانمت","آدمیی یا ملکی یا پری","این چه موجودی است که نمی‌توانم تشخیص دهم، آیا انسان است یا فرشته یا پری؟"],[547,"گر همه سرمایه زیان می‌کند","سود بود دیدن آن مشتری","اگر تمام سرمایه‌ام هم از بین برود، دیدن آن مشتری (و زیبایی او) به اندازه‌ای سودمند است که ارزشش را دارد."],[547,"نسخه این روی به نقاش بر","تا بکند توبه ز صورتگری","بگو تا نسخه‌ای از این چهره به نقاش بدهم تا به واسطه آن، از هنر صورتگری که نباید بر آن توبه کنم، دست بردارم."],[547,"با تترت حاجت شمشیر نیست","حمله همی‌آری و دل می‌بری","برای رسیدن به خواسته‌ات به استفاده از شمشیر نیازی نیست، چون تو با چهره‌یت دل‌ها را می‌شکنی و به جنگ می‌آیی."],[547,"گر تو در آیینه تأمل کنی","صورت خود باز به ما ننگری","اگر تو به خودت در آینه نگاه کنی و به چهره‌ات فکر کنی، دیگر به ما نمی‌نگری و به ما توجهی نخواهی کرد."],[547,"خسرو اگر عهد تو دریافتی","دل به تو دادی که تو شیرین‌تری","خسرو (که اشاره به خسرو پرویز دارد) اگر به وعده و پیمان تو عمل کرده باشد، دلش را به تو سپرده است؛ زیرا تو شیرین‌تر از هر چیزی هستی."],[547,"گر دری از خلق ببندم به روی","بر تو نبندم که به خاطر دری","اگر بر دل کسی در برابر دیگران در را ببندم، اما در برابر تو هرگز در را نخواهم بست؛ زیرا تو به خاطر من و به خاطر دوست داشتن من اینقدر ارزشمندی."],[547,"سعدی اگر کشته شود در فراق","زنده شود چون به سرش بگذری","سعدی می‌گوید اگر در دوری و جدایی از محبوبش بمیرد، از آن پس نیز در زمانی که او (محبوب) به یادش بیفتد، زنده خواهد شد."],[548,"دانی چه گفت مرا آن بلبل سحری","تو خود چه آدمیی کز عشق بی‌خبری","بلبل سحری به من پیامی داد و گفت که تو چه آدمی هستی که از عشق بی‌خبری."],[548,"اشتر به شعر عرب در حالت است و طرب","گر ذوق نیست تو را کژطبع جانوری","شتر هنگامی‌که شعر عرب را می‌شنود به شاد و سرزنده می‌شود، اما اگر تو ذوق نداشته باشی، نشان‌دهنده‌ی طبیعت نادرست تو خواهد بود."],[548,"من هرگز از تو نظر با خویشتن نکنم","بیننده تن ندهد هرگز به بی بصری","من هرگز به خودم نگاه نمی‌کنم، چون بیننده واقعی هرگز تسلیم ناتوانی نمی‌شود."],[548,"از بس که در نظرم خوب آمدی صنما","هر جا که می‌نگرم گویی که در نظری","به خاطر زیبایی‌ات، ای معشوق، هر جا که نگاه می‌کنم، انگار که در هر نگاه تو را می‌بینم."],[548,"دیگر نگه نکنم بالای سرو چمن","دیگر صفت نکنم رفتار کبک دری","دیگر به تماشای قامت زیبا و بلند درختان چمن نمی‌نشینم و دیگر رفتارهای نرم و لطیف مانند کبک دری را انجام نخواهم داد."],[548,"کبک این چنین نرود سرو این چنین نچمد","طاووس را نرسد پیش تو جلوه گری","کبک به این شکل پرواز نمی‌کند و سرو هم این‌گونه خم نمی‌شود. طاووس نیز نمی‌تواند در مقابل تو خود را به نمایش بگذارد."],[548,"هر گه که می‌گذری من در تو می‌نگرم","کز حسن قامت خود با کس نمی‌نگری","هر بار که از کنار من می‌گذری، من به تو نگاه می‌کنم، چرا که تو به زیبایی قامت خود هیچ توجهی به دیگران نداری."],[548,"از بس که فتنه شوم بر رفتنت نه عجب","بر خویشتن تو ز ما صد بار فتنه‌تری","از آن‌جایی که من از رفتن تو دچار آشفتگی و پریشانی شده‌ام، تعجبی ندارد که تو نسبت به خودت و ما بسیار بیشتر از آنچه که من دچار فتنه و آشفتگی هستم، ناآرامی."],[548,"باری به حکم کرم بر حال ما بنگر","کافتد که بار دگر بر خاک ما گذری","به خاطر لطف و بخشش شما، نگاهی به وضعیت ما بیندازید و ببینید که آیا دوباره فرصتی برای عبور از کنار ما فراهم می‌شود."],[548,"سعدی به جور و جفا مهر از تو برنکند","من خاک پای توام ور خون من بخوری","به رغم تمام ظلم‌ها و بی‌وفایی‌هایت، هرگز از محبت و عشق به تو دست نمی‌کشم. من در برابر تو فروتن و مطیع هستم، حتی اگر جانم را بگیری."],[549,"دانمت آستین چرا پیش جمال می‌بری","رسم بود کز آدمی روی نهان کند پری","می‌دانم که چرا با آستین خود صورت زیبایت را می‌پوشانی؛ این رسم است که فرشته چهره‌اش را پنهان کند و زیبایی‌اش را در نظر دیگران نمایان نسازد. (AI: می‌دانم که چرا آستین خود را به سمت زیبایی می‌بری؛ این رسم است که آدمی چهره‌اش را پنهان کند و زیبایی را در نظر دیگران نمایان سازد.)"],[549,"معتقدان و دوستان از چپ و راست منتظر","کبر رها نمی‌کند کز پس و پیش بنگری","دوستان و معتقدان از دو طرف به تو نگاه می‌کنند و با حالتی مغرور به تو نزدیک نمی‌شوند، چون تو را از جلو و عقب می‌نگرند."],[549,"آمدمت که بنگرم باز نظر به خود کنم","سیر نمی‌شود نظر بس که لطیف‌منظری","به دیدارت آمده‌ام تا دوباره به خودم نگاه کنم، اما چشمانم نمی‌تواند سیر از تماشای زیبایی تو شود."],[549,"غایت کام و دولت است آن که به خدمتت رسید","بنده میان بندگان بسته میان به چاکری","هدف از رسیدن به کمال و خوشبختی، کسی است که به خدمت تو آمده است؛ یعنی بنده‌ای در میان بندگان دیگر که به خدمت تو مشغول است."],[549,"روی به خاک می‌نهم گر تو هلاک می‌کنی","دست به بند می‌دهم گر تو اسیر می‌بری","اگر تو مرا نابود کنی، من سرم را به خاک می‌گذارم و تسلیم می‌شوم. حتی اگر تو بخواهی مرا اسیر کنی، دستم را به زنجیر می‌سپارم و به این سرنوشت راضی هستم."],[549,"هر چه کنی تو برحقی حاکم و دست مطلقی","پیش که داوری برند از تو که خصم و داوری","هر کاری که تو انجام دهی درست و قانونی است و تو دارای قدرت مطلقی. چه کسی می‌تواند درباره تو قضاوت کند در حالی که تو هماه خصم و هم داوری هستی؟"],[549,"بنده اگر به سر رود در طلبت کجا رسد","گر نرسد عنایتی در حق بنده آن سری","اگر بنده (سعید) در پی تو باشد و به گردن تو بیفتد، به کجا می‌تواند برسد؟ اگر تو توجهی به این بنده نکنی، او هیچ امید و هدفی نخواهد داشت."],[549,"گفتم اگر نبینمت مهر فرامشم شود","می‌روی و مقابلی غایب و در تصوری","گفتم اگر تو را نبینم، محبتت را فراموش می‌کنم. تو می‌روی و کسی در مقابل من نیست و من همچنان در خیال تو هستم."],[549,"جان بدهند و در زمان زنده شوند عاشقان","گر بکشی و بعد از آن بر سر کشته بگذری","عاشقان حاضرند جانشان را فدای عشق کنند و حتی اگر به قتل برسند، در زمانی که زنده شوند، دوباره به عشق شما برخواهند گشت و شما با بی‌تفاوتی بر فراز اجساد آن‌ها قدم خواهید زد."],[549,"سعدی اگر هلاک شد عمر تو باد و دوستان","ملک یمین خویش را گر بکشی چه غم خوری","اگر سعدی بمیرد، عمر تو باقی باشد و تو از کشته شدن دوستانت غمگین نشوی."],[550,"دیدم امروز بر زمین قمری","همچو سروی روان به رهگذری","امروز بر روی زمین «ماه» را دیدم که مانند درختی سرسبز و سرپا، در حال حرکت به سمت رهگذری بود."],[550,"گوییا بر من از بهشت خدای","باز کردند بامداد، دری","به نظر می‌رسد در سپیده‌دم، درهای بهشت خدا به روی من گشوده شده است."],[550,"من ندیدم به راستی همه عمر","گر تو دیدی به سرو بر قمری","من در تمام عمرم تو را ندیده‌ام، اما اگر تو درخت سروی را دیده‌ای، می‌دانی که یک قمر (پرنده) بر آن نشسته است."],[550,"یا شنیدی که در وجود آمد","آفتابی ز مادر و پدری","آیا شنیدی که در عالم وجود، خورشیدی به دنیا آمد از ترکیب یک مادر و یک پدر؟"],[550,"گفتم از وی نظر بپوشانم","تا نیفتم به دیده در خطری","می‌گویم از او دوری کنم و او را از دید پنهان کنم تا در خطر نیفتم و دلم به درد نیاید."],[550,"چاره، صبر است و احتمال، فراق","چون کفایت نمی‌کند نظری","چاره‌ کار صبر و انتظار و جدایی است، زیرا دیدن او کافی نیست و نمی‌تواند همه‌ چیز را حل کند."],[550,"می‌خرامید و زیر لب می‌گفت","«عاقل از فتنه می‌کند حذری»","دختری با زیبایی خیره‌کننده به آرامی حرکت می‌کند و در زیر لب می‌گوید که عاقل باید از فتنه‌ها دوری کند و احتیاط به خرج دهد."],[550,"سعدیا پیش تیر غمزه ما","به ز تقوا ببایدت سپری","ای سعدی، در برابر تیر نگاه جفای ما، بهتر است که «سپری بهتر و محکم‌تر از» تقوا را به عنوان سپر در اختیار داشته باشی."],[551,"رفتی و همچنان به خیال من اندری","گویی که در برابر چشمم مصوری","تو رفتی، اما هنوز در ذهن من هستی و گویی تصویری از تو در برابر چشمانم وجود دارد."],[551,"فکرم به منتهای جمالت نمی‌رسد","کز هر چه در خیال من آمد نکوتری","فکر و تصورات من به نهایت زیبایی تو نمی‌رسد، زیرا از هر چیزی که در ذهنم آمده، تو زیباتر هستی."],[551,"مه بر زمین نرفت و پری دیده برنداشت","تا ظن برم که روی تو ماه است یا پری","ماه بر زمین نیفتاد و پری‌ها هم چیزی ندیدند تا من گمان کنم چهره تو مانند ماه است یا پری."],[551,"تو خود فرشته‌ای نه از این گل سرشته‌ای","گر خلق از آب و خاک تو از مشک و عنبری","تو خود فرشته‌ای و وجودت از گل و خاک نیست، اگر خلق از آب و خاک ساخته شده اند، تو از مشک و عنبر ساخته شده ای"],[551,"ما را شکایتی ز تو گر هست هم به توست","کز تو به دیگران نتوان برد داوری","شکایتی که از تو داریم، اگر وجود داشته باشد، باز هم به خود تو مربوط می‌شود؛ چون نمی‌توان از تو به دیگران شکایت کرد و داوری خواست."],[551,"با دوست کنج فقر بهشت است و بوستان","بی دوست خاک بر سر جاه و توانگری","در کنار دوست، حتی زندگی در فقر و کمبود هم بهشت و فضای خوشی است، اما بدون دوست، ثروت و مقام نیز چیزی جز خاک نیست و ارزشی ندارد."],[551,"تا دوست در کنار نباشد به کام دل","از هیچ نعمتی نتوانی که برخوری","تا زمانی که دوست در کنارت نباشد، هیچ نعمتی نمی‌تواند تو را به خواسته‌ات برساند و خوشحال کند."],[551,"گر چشم در سرت کنم از گریه باک نیست","زیرا که تو عزیزتر از چشم در سری","اگر چشمانم را به خاطر تو از گریه پر کنم، برایم اهمیتی ندارد؛ زیرا تو برای من محبوب‌تر و ارزشمندتر از چشمی هستی که در سر دارم."],[551,"چندان که جهد بود دویدیم در طلب","کوشش چه سود چون نکند بخت یاوری","هرچقدر در تلاش بودیم و برای رسیدن به معشوق دویدیم، فایده‌ای ندارد اگر بخت به ما کمک نکند و یاری ندهد."],[551,"سعدی به وصل دوست چو دستت نمی‌رسد","باری به یاد دوست زمانی به سر بری","سعدی می‌گوید: وقتی که به وصال دوست دسترسی نداری، حداقل برای یاد او در مدت زمانی به سر بر."],[552,"روی گشاده ای صنم طاقت خلق می‌بری","چون پس پرده می‌روی پرده صبر می‌دری","ای محبوب زیبا که چهره‌ات همیشه خود را نشان می‌دهد، زیبایی‌ات به حدی است که مردم طاقت دیدن تو را ندارند. تو از پس پرده‌ای که در آن پنهانی، عبور می‌کنی و صبر دیگران را می‌شکنی."],[552,"حور بهشت خوانمت ماه تمام گویمت","کآدمیی ندیده‌ام چون تو پری به دلبری","تو را به عنوان حوری بهشت می‌خوانم و تو را ماه کامل می‌دانم، زیرا تا به حال آدمی را ندیده‌ام که در محبت و دل‌ربایی مانند تو باشد."],[552,"آینه را تو داده‌ای پرتو روی خویشتن","ور نه چه زهره داشتی در نظرت برابری","تو به آینه نوری از چهره خود بخشیده‌ای، وگرنه چگونه این جسارت را داشتی (داشت) که خود را در برابر آن (تو) ببینی (ببیند)؟"],[552,"نسخه چشم و ابرویت پیش نگارگر برم","گویمش این چنین بکن صورت قوس و مشتری","چشم و ابروهای تو را باید به نقاش بگویم که این‌گونه تصویر کند که قوس (ابرو) و مشتری (چشم) تو را به تصویر بکشد."],[552,"چون تو درخت دل‌نشان تازه‌بهار و گل‌فشان","حیف بود که سایه‌ای بر سر ما نگستری","تو مانند درختی بهاری و گل‌دار هستی و حیف است که سایه‌ات بر سر ما نیفتد و ما از زیبایی‌ات بهره‌مند نشویم."],[552,"دیده به روی هر کسی برنکنم ز مهر تو","در ز عوام بسته به چون تو به خانه اندری","چشم خود را از روی هیچ‌کس بدارم نمی‌توانم، چون مهر تو در قلبم نشسته و چشمانم به تو وابسته است."],[552,"من نه مخیرم که چشم از تو به خویشتن کنم","گر تو نظر به ما کنی ور نکنی مخیری","من نمی‌توانم چشم از تو بردارم و به خودم توجه کنم، حتی اگر تو به ما نگاه کنی یا نکنی، انتخابی در دست من نیست."],[552,"پند حکیم بیش از این در من اثر نمی‌کند","کیست که برکند یکی زمزمه قلندری","نصیحت‌های حکیم دیگر در من تأثیری ندارد. چه کسی می‌تواند آوازی به شیوه قلندران بخواند؟ (AI: نصیحت‌های حکیم دیگر در من تأثیری ندارد. چه کسی می‌تواند صدای یک زاهد آزاد را خاموش کند؟)"],[552,"عشق و دوام عافیت مختلفند سعدیا","هر که سفر نمی‌کند دل ندهد به لشکری","عشق و حالت آرامش و راحتی هر دو با هم متفاوت هستند، سعدی. هر کس به سفر نمی‌رود، نباید دل به گروهی از سربازان و جنگجویان بدهد."],[553,"سرو بستانی تو یا مه یا پری","یا ملک یا دفتر صورتگری","تو در بستان مانند سرو زیبا، یا به‌سان ماه، پری، یا یک ملک و یا دفتر صورتگری هستی که زیبایی‌ات را در آن ترسیم کرده‌اند."],[553,"رفتنی داری و سحری می‌کنی","کاندر آن عاجز بماند سامری","تو در حال رفتن هستی و «افسون می‌کنی». کارهایی انجام می‌دهی که باعث می‌شود سامری در آنجا ناتوان بماند. / سامری: غزل32 بیت2"],[553,"هر که یک بارش گذشتی در نظر","در دلش صد بار دیگر بگذری","هر کسی را که یک بار از نظر تو گذر کند، در دلش بارها و بارها به یاد تو می‌افتد و تو را در نظر می‌آورد."],[553,"می‌روی و اندر پیت دل می‌رود","باز می‌آیی و جان می‌پروری","تو می‌روی و دل من در عشق تو داغدار است و وقتی برمی‌گردی، روح من زنده می‌شود و شادکامی می‌آورد."],[553,"گر تو شاهد با میان آیی چو شمع","مبلغی پروانه‌ها گرد آوری","اگر تو به میان جمع بیایی، مانند شمعی خواهی بود که پروانه‌ها دور تو جمع می‌شوند."],[553,"چند خواهی روی پنهان داشتن","پرده می‌پوشی و بر ما می‌دری","چقدر می‌خواهی چهره‌ات را پنهان کنی؟ تو پرده‌ای بر روی خود کشیده‌ای و در واقع بر ما مشخص هستی."],[553,"روزی آخر در میان مردم آی","تا ببیند هر که می‌بیند پری","روزی به میان مردم بیا تا هر کسی که تو را می‌بیند، زیبایی و دل‌نوازی‌ات را مشاهده کند."],[553,"آفتاب از منظر افتد در رواق","چون تو را بیند بدین خوش‌منظری","آفتاب وقتی در هاله زیبایی تو قرار می‌گیرد و تو را با این زیبایی‌ات می‌بیند، از جایی که هست می‌افتد و به تماشای تو می‌آید."],[553,"جان و خاطر با تو دارم روز و شب","نقش بر دل نام بر انگشتری","من تمام وجودم را به تو اختصاص داده‌ام و در طول روز و شب، تصویر تو در قلبم نقش بسته و نام تو مانند نگینی بر انگشتری برایم ارزشمندی دارد."],[553,"سعدی از گرمی بخواهد سوختن","بس که تو شیرینی از حد می‌بری","سعدی آرزو می‌کند که اگر او بتواند از شدت عشق و محبت خود بسوزد، این کار را انجام دهد، زیرا شیرینی و لطف تو به قدری زیاد است که قابل تحمل نیست."],[554,"کس درنیامده‌ست بدین خوبی از دری","دیگر نیاورد چو تو فرزند مادری","هیچ‌کس به این خوبی از در دیگری نیامده و هیچ‌کس مانند تو فرزند مادری نبوده است."],[554,"خورشید اگر تو روی نپوشی فرو رود","گوید «دو آفتاب نباشد به کشوری»","اگر تو روی خود را نپوشانی، حتی خورشید نیز غروب خواهد کرد؛ چون می‌گوید که در هیچ کشوری دو آفتاب وجود ندارد."],[554,"اول منم که در همه عالم نیامده‌ست","زیباتر از تو در نظرم هیچ منظری","من اولین کسی هستم که در کل عالم دیده‌ام و هیچ منظره‌ای به زیبایی تو در نظر من نیست."],[554,"هرگز نبرده‌ام به خرابات عشق راه","امروزم آرزوی تو در داد ساغری","هرگز به میخانه عشق نرفته‌ام، ولی امروز آرزوی تو را با فنجانی از شراب در دل دارم."],[554,"یا خود به حسن روی تو کس نیست در جهان","یا هست و نیستم ز تو پروای دیگری","یا هیچ‌کس در جهان به زیبایی روی تو وجود ندارد، یا اگر هم کسی هست، من دیگر به هیچ‌چیز جز تو فکر نمی‌کنم."],[554,"بر سرو قامتت گل و بادام روی و چشم","نشنیده‌ام که سرو چنین آورد بری","بر قامت تو، گلی و درخت بادام وجود دارد، و چشمی ندیده‌ام که به زیبایی این سرو (یعنی تو) چنین جلوه کند."],[554,"رویی که روز روشن اگر برکشد نقاب","پرتو دهد چنان که شب تیره اختری","اگر چهره‌ات در روز روشن پوشیده شود، نوری به‌وجود می‌آورد که مانند ستاره‌ای در شب تاریک می‌درخشد."],[554,"همراه من مباش که غیرت برند خلق","در دست مفلسی چو ببینند گوهری","با من نباش چون به خاطر غیرت، مردم بر می‌انگیزند و به دست کسی که زندگیش تنها به چنگ زدن به چیزهای کم‌ارزش است، مانند گوهری باارزش برخورد می‌کنند."],[554,"من کم نمی‌کنم سر مویی ز مهر دوست","ور می‌زند به هر بن موییم نشتری","من از محبت و عشق به دوست هیچ چیز کم نمی‌گذارم، حتی اگر دشمنی به سراغ من آید و به هر تار موی من آسیب بزند."],[554,"روزی مگر به دیده سعدی قدم نهی","تا در رهت به هر قدمت می‌نهد سری","روزی اگر تو به دیدن سعدی بیایی، او در هر قدمی که برمی‌دارد، سرش را به پای تو می‌گذارد."],[555,"گر برود به هر قدم در ره دیدنت سری","من نه حریف رفتنم از در تو به هر دری","اگر در راه دیدن تو هر گامی بردارم، دیگر هیچ چیز نمی‌تواند مانع رفتن من به سوی تو شود، حتی اگر از در دیگری هم بخواهم خارج شوم."],[555,"تا نکند وفای تو در دل من تغیّری","چشم نمی‌کنم به خود تا چه رسد به دیگری","وفای تو در دل من تأثیری نگذارد، من به خودم نگاه نمی‌کنم، چه برسد به اینکه به دیگری توجه کنم."],[555,"خود نبود و گر بود تا به قیامت آزری","بت نکند به نیکویی چون تو بدیع پیکری","اگر خود تو وجود نداشت و فرض کنیم که وجود داشت، تا قیامت نخواهد بود آنگونه که تو زیبا و دلربا هستی؛ هیچ کسی به زیبایی تو توسط پدر و مادری دیگر آفریده نشده است."],[555,"سرو روان ندیده‌ام جز تو به هیچ کشوری","هم نشنیده‌ام که زاد از پدری و مادری","به هیچ کشور و سرزمینی سرو روانی مانند تو ندیده‌ام و از هیچ منبعی نشنیده‌ام که تو از پدر و مادری به وجود آمده باشی."],[555,"گر به کنار آسمان چون تو برآید اختری","روی بپوشد آفتاب از نظرش به معجری","اگر ستاره‌ای چون تو به کنار آسمان بماند، آفتاب به خاطر زیبایی‌ات از دید او پنهان می‌شود."],[555,"حاجت گوش و گردنت نیست به زر و زیوری","یا به خضاب و سرمه‌ای یا به عبیر و عنبری","به زیبایی و جذابیت ظاهری مانند طلا، جواهر، رنگ‌ها و عطرها نیازی نیست. زیبایی واقعی تو از دل و روح تو سرچشمه می‌گیرد و این ظاهر خود به خود درخشان است."],[555,"تاب وغا نیاورد قوت هیچ صفدری","گر تو بدین مشاهدت حمله بری به لشکری","هیچ سواره‌نظامی نمی‌تواند بار سنگینی را تحمل کند، اگر تو با چنین قدرت و زیبایی به میدان بیایی و به دشمن حمله کنی."],[555,"بسته‌ام از جهانیان بر دل تنگ من دری","تا نکنم به هیچ کس گوشه چشم خاطری","دل تنگ من به قدری از دنیای مردم دور شده که برای آرامش و راحتی‌ام یک دری دارم، تا به هیچ‌کس نگاهی نکنم که باعث ناراحتی‌ام شود."],[555,"گرچه تو بهتری و من از همه خلق کمتری","شاید اگر نظر کند محتشمی به چاکری","هرچند که تو فردی بهتر و من از همه مردم کم‌ارزش‌تر هستم، اما شاید اگر شخص گرامی و با مقام بلندی، به حالت بنده‌وار من توجهی کند، چیزی عوض شود."],[555,"باک مدار سعدیا گر به فدا رود سری","هر که به معظمی رسد ترک دهد محقری","سعدی می‌گوید نگران نباش، اگر کسی در راه عشق یا فدای محبوبش جان خود را بدهد. کسانی که به مقام و ارزشی دست پیدا می‌کنند، از حالتی که در آن خود را حقیر می‌دانسته‌اند، فاصله می‌گیرند."],[556,"گر کنم در سر وفات سری","سهل باشد زیان مختصری","اگر بخواهم به خاطر مرگ خودم تصمیمی بگیرم، هیچ اشکالی ندارد، چون در این حالت فقط ضرر اندکی می‌بینم."],[556,"ای که قصد هلاک من داری!","صبر کن تا ببینمت نظری","ای کسی که می‌خواهی مرا هلاک کنی! لحظه‌ای صبر کن تا تو را ببینم."],[556,"نه حرام است در رخ تو نظر","که حرام است چشم بر دگری","نگاه کردن به چهره تو ایرادی ندارد، زیرا نگاه کردن به چهره دیگری نادرست است."],[556,"دوست دارم که خاک پات شوم","تا مگر بر سرم کنی گذری","دوست دارم آن‌قدر در خدمتت باشم که به خاک پای تو تبدیل شوم، تا شاید توجهی به من کنی و بر سرم نگاهی بیندازی."],[556,"متحیر نه در جمال توام","عقل دارم به قدر خود قدری","من در زیبایی تو متحیر نیستم، چون عقل من به اندازه خودم نیک می‌فهمد که چه مقدار زیبایی وجود دارد."],[556,"حیرتم در صفات بی‌چون است","کاین کمال آفرید در بشری؟","حیرت من به خاطر صفات بی‌نظیر توست که چنین کمالی را در وجود انسان خلق کرده‌ای."],[556,"ببری هوش و طاقت زن و مرد","گر تردد کنی به بام و دری","اگر هوش و قدرت زن و مرد را از بین ببری، به نشستن بر بام و در نشانه‌‌های دیگر تردید خواهی کرد."],[556,"حق به دست رقیب ناهموار","پیش خصم ایستاده چون سپری","حقی که به دست رقیب است، در مقابل دشمن نابرابر و مشکل قابل دفاع است، مانند سپری که در برابر حملات قرار دارد."],[556,"زان که آیینه‌ای بدین خوبی","حیف باشد به دست بی‌بصری","آیینه‌ای با این زیبایی، اگر به دست کسی بی‌منطق و بی‌فهم بیفتد، هدر خواهد رفت و حیف است."],[556,"آه سعدی اثر کند در کوه","نکند در تو سنگ‌دل اثری","دست‌نوشته سعدی، اشاره به این دارد که آه و گریه‌های او تأثیری بر کوه دارد، اما بر دل سنگی و بی‌رحم تو تأثیری نخواهد گذاشت."],[556,"سنگ را سخت گفتمی همه عمر","تا بدیدم ز سنگ سخت‌تری","تمام عمر بر این باور بودم که سنگ و سختی، نهایت سختی‌ها هستند، اما وقتی با سنگ‌دلی (سخت‌دلی) شخصی مواجه شدم، فهمیدم که سخت‌دل‌تر از سنگ نیز وجود دارد."],[557,"هرگز این صورت کند صورتگری؟","یا چنین شاهد بود در کشوری؟","هرگز چنین زیبایی را کسی نمی‌تواند تصویر کند؟ آیا در هیچ سرزمینی شاهدی به این زیبایی وجود دارد؟"],[557,"سرورفتاری، صنوبرقامتی","ماه‌رخساری، ملایک‌منظری","این بیت توصیف زیبایی است از یک معشوق با ویژگی‌های برجسته. او به مانند درخت صنوبر قدبلند و خوش قامت است، ماهی‌رخ و دارای چهره‌ای است که فرشتگان را مجذوب خود می‌کند."],[557,"می‌رود وز خویشتن‌بینی که هست","در نمی‌آید به چشمش دیگری","انسانی که گرفتار خودبینی است، قادر نیست دیگران را در نظر بگیرد و فقط به خود و ویژگی‌های خود توجه دارد."],[557,"صد هزارش دست خاطر در رکاب","پادشاهی می‌رود با لشکری","مشتاق او (خاطر) به سوی پادشاهی بسیار زیاد، در کنار لشکری بزرگ به راه می‌افتد."],[557,"عارضش باغی دهانش غنچه‌ای","بل بهشتی در میانش کوثری","چهره‌اش مانند باغی زیباست و لبانش همچون غنچه‌ای گلی می‌ماند. در درون او چیزهایی وجود دارد که نشان از بهشت دارد و به نوعی شبیه کیفیت یک پرنده پاکیزه و مقدس است."],[557,"ماه‌رویا! مهربانی پیشه کن","خوب‌رویی را بباید زیوری","ای ماه‌رو، لطف و مهربانی را در پیش بگیر، زیرا زیبایی و حسن چهره را باید با زینت و زیبایی همراه کرد."],[557,"بی‌تو در هر گوشه پایی در گل است","وز تو در هر خانه دستی بر سری","بی‌وجود تو، در هر جایی، چیزی به پای گل افتاده است، و به یاد تو، در هر خانه، دستی بر سر قرار دارد."],[557,"چون همایم سایه‌ای بر سر فکن","تا در اقبالت شوم نیک‌اختری","من به مانند هما (پرنده‌ای افسانه‌ای که نشانه خوشبختی است) هستم و سایه‌ام را بر سرت بینداز تا با این کار به خوش‌بختی و نیک‌فرجامی تو کمک کنم."],[557,"در خداوندی چه نقصان آیدش","گر خداوندی بپرسد چاکری؟","اگر خداوندی از نوکری بپرسد، چه چیزی به نقصان او خواهد افزود یا چه کمبودی در او به وجود می‌آید؟"],[557,"مصلحت بودی شکایت گفتنم","گر به غیر از خصم بودی داوری","شکایت من زمانی مصلحت دارد که قاضی (داور) دیگری جز دشمن نباشد."],[557,"سعدیا داروی تلخ از دست دوست","به که شیرینی ز دست دیگری","سعدی می‌گوید که بهتر است درد و رنجی که از دوست به ما می‌رسد را تحمل کنیم، زیرا این درد، از شیرینی‌ای که از دیگران می‌گیریم بهتر و ارزشمندتر است."],[557,"خاکی از مردم بماند در جهان","وز وجود عاشقان خاکستری","تنها چیزی که از آدم‌ها در دنیا باقی می‌ماند، خاک است، و وجود عاشقان که مانند خاکسترند، هم در این دنیا هیچ اثری ندارد."],[558,"هر نوبتم که در نظر ای ماه بگذری","بار دوم ز بار نخستین نکوتری","هر بار که تو را می‌بینم، ای ماه زیبا، متوجه می‌شوم که در هر بار دیدار، نسبت به بار اول زیبایی و لطف بیشتری داری."],[558,"انصاف می‌دهم که لطیفان و دلبران","بسیار دیده‌ام نه بدین لطف و دلبری","من با انصاف می‌گویم که در طول عمرم معشوقان و زیبایان بسیاری را دیده‌ام، اما هیچ‌یک به این اندازه زیبا و دلربا نبوده‌اند."],[558,"زنار بود هر چه همه عمر داشتم","الا کمر که پیش تو بستم به چاکری","هر چیزی که تا agora در زندگی داشتم، مانند زناری به دور کمرم بود، به جز کمرم که به خاطر تو به عنوان خدمتکار دین کرده‌ام."],[558,"از شرم چون تو آدمیان در میان خلق","انصاف می‌دهد که نهان می‌شود پری","از شرم توست که فرشته از انسان‌ها پنهان می‌شود. (AI: از شرم تو، انسان‌ها به گونه‌ای رفتار می‌کنند که در میان دیگران عدالت برقرار می‌شود و چیزی که پنهان است، آشکار می‌شود.)"],[558,"شمشیر اختیار تو را سر نهاده‌ام","دانم که گر تنم بکشی جان بپروری","من تمام اختیارت را به دست تو سپرده‌ام و می‌دانم اگر مرا بکشی، جانم را زنده خواهی کرد."],[558,"جز صورتت در آینه کس را نمی‌رسد","با صورت بدیع تو کردن برابری","جز چهره تو در آینه هیچ‌کس نمی‌تواند با زیبایی وصف‌ناپذیر تو مقایسه شود و برابری کند."],[558,"ای مدعی گر آنچه مرا شد تو را شود","بر حال من ببخشی و حالت بیاوری","ای مدعی، اگر آنچه بر من گذشته بر تو نیز بگذرد، ای کاش حال مرا اصلاح کنی و به من حالتی بهتر هدیه کنی."],[558,"صید اوفتاد و پای مسافر به گل بماند","هیچ افتدت که بر سر افتاده بگذری","اگر شکار در دام افتاده باشد و پای مسافر در گل بماند، آیا تو هم از کنار کسی که بر زمین افتاده است به سادگی عبور می‌کنی؟"],[558,"صبری که بود مایه سعدی دگر نماند","سختی مکن که کیسه بپرداخت مشتری","صبری که باعث سعادت سعدی بود، دیگر وجود ندارد. پس بیهوده سختی نکش، چون مشتری (خریدار) دیگر پولی نمی‌پردازد."],[559,"چون است حال بستان، ای باد نوبهاری!","کز بلبلان برآمد، فریاد بی‌قراری","ای نسیم و باد نوبهاری، حال گل‌­های باغ چگونه است؟ چرا که بلبل‌های عاشق دیگر توان صبر ندارند و فریادی، به نشان بی­قراری سر داده‌­اند.(نکته: باد، نسیم و… در ادبیات پیک و خبر رسان میان عاشق و معشوق هستند.)"],[559,"ای گنج نوشدارو! با خستگان نگه کن","مرهم به دست و ما را مجروح می‌گذاری","ای معشوقی که درمان تمام دردها در وجود توست، نگاه و عنایتی به مجروحان خود کن، داروی تمام دردها را در دست داری، اما ما را مجروح و زخمی رها می­کنی."],[559,"یا خلوتی برآور یا برقعی فروهل","ور نه به شکل شیرین، شور از جهان برآری","یا خلوتی فراهم کن و تنها عاشقانت را بدان راه بده، و یا رو بندی بر روی صورت خود قرار ده؛ وگرنه چنین که آشکارا خود را نشان داده‌ای(ایهام: ۱. به طرز شیرین و دلنشینی، ۲. به شکل شیرین معشوق خسرو پرویز ) دنیا را به آشوب و غوغا می‌کشانی."],[559,"هر ساعت از لطیفی، رویت عرق برآرد","چون بر شکوفه آید باران نوبهاری","همانگونه که باران نوبهاری بر روی شکوفه‌های لطیف می‌نشیند، هر لحظه، از شدت لطیفی، از صورت تو عرق می‌تراود.(نکته: مصراع اول مشبه، مصراع دوم مشبه به.)"],[559,"عود است زیر دامن یا گل در آستینت","یا مشک در گریبان بنمای تا چه داری","عود در زیر دامن خود پنهان کرده‌ای یا گل در آستین خود گذاشته‌ای که چنان خوشبو و معطر هستی؟ یا شاید مشک در گریبان خود نهاده­ای؛ به من نشان بده که چه داری که چنین خوشبو و خواستنی هستی؟(نکته: نکته شگفت و عجیب در این بیت هنرنمایی سعدی است که برای اینکه بیان کند تمام وجود معشوقم معطر و خوشبوست از هر قسمت اندام او مثالی می­زند؛ دامن، آستین و گریبان.)"],[559,"گل نسبتی ندارد با روی دل‌فریبت","تو در میان گل‌ها چون گل میان خاری","گل که نماد زیبایی است با چهره‌ی دلفریب تو هیچگونه نسبتی ندارد و قابل و مقایسه با صورت تو نیست؛ در واقع هنگامی که تو در میان گل‌ها هستی مثل این است که گلی در میان خار روییده باشد."],[559,"وقتی کمند زلفت دیگر کمان ابرو","این می‌کشد به زورم وآن می‌کشد به زاری","زمانی کمند زلفت مرا با قدرت به سوی دام عشق می­کشاند و زمانی دیگر کمان ابرویت مرا به سختی می‌کشد و هلاک می‌کند."],[559,"ور قید می‌گشایی، وحشی نمی‌گریزد","در بند خوب‌رویان، خوش‌تر که رستگاری","اگر زمانی بند و قید (عشق خود را) باز کنی، حتی کسانی که ذاتا گریزنده و رمنده هستند، از پیش تو فرار نمی‌کنند؛ چرا که آدمی اگر اسیر زیبارویان باشد، دلپذیرتر است که آزاد و رها باشد."],[559,"ز اول وفا نمودی چندان که دل ربودی","چون مهر سخت کردم، سست آمدی به یاری","در ابتدا که مرا عاشق خود ساختی، اظهار وفاداری کردی، اما همین که سرسختانه دلباخته تو شدم، در کار عشق و عاشقی سست شدی."],[559,"عمری دگر بباید بعد از فراق ما را","کاین عمر صرف کردیم اندر امیدواری","بعد از جدایی ، احتیاج به عمر و زندگی دیگری داریم، چرا که این عمر و زندگی را در راه انتظار و امیدواری خرج کردیم."],[559,"ترسم نماز صوفی با صحبت خیالت","باطل بود که صورت بر قبله می‌نگاری","یقین دارم که نماز صوفی در حالیکه تصویر تو همنشین اوست، باطل است؛ چرا که تو تصویر چهره‌ی خود را بر قبله‌ی او نگاشته‌ای.(نکته: صحبت کردن در میان نماز سبب ابطال آن می‌شود که سعدی نگاهی هنری بدان کرده است و معتقد است که صوفی که این همه ادعای دینداری دارد در هنگام نماز، صورت معشوق را بر قبله می‌بیند.)"],[559,"هر درد را که بینی، درمان و چاره‌ای هست","درمان درد سعدی با دوست سازگاری","تمام دردها، درمان و چاره­ای دارد؛ درمان درد سعدی نیز این است که با خوی و خواسته‌ی معشوق خود همراهی کند."],[560,"خبر از عیش ندارد که ندارد یاری","دل نخوانند که صیدش نکند دلداری","آنکه دل به عشق ندارد، از شادکامی خبری ندارد و اگر هم دلدار از او دلجوئی نکند، به طور قطع در دام عشق گرفتار نخواهد شد."],[560,"جان به دیدار تو یک روز فدا خواهم کرد","تا دگر برنکنم دیده به هر دیداری","برای دیدن تو یک روز جانم را فدای تو خواهم کرد تا دیگر هیچ‌گاه چشمم را به روی هیچ دیداری باز نکنم."],[560,"یعلم الله که من از دست غمت جان نبرم","تو به از من بتر از من بکشی بسیاری","خداوند می‌داند که من از شدت غم تو جانم را نمی‌برم، تو با من بدتر از من رفتار کنی، بسیاری را از پای درمی‌آوری."],[560,"غم عشق آمد و غم‌های دگر پاک ببرد","سوزنی باید کز پای برآرد خاری","غم عشق به قدری عمیق و سوزناک است که تمام غم‌های دیگر را از بین می‌برد. مانند سوزنی که باید خاری را از پای کسی درآورد، درد عشق نیز آن‌چنان شدید است که دیگر غم‌ها را می‌زداید."],[560,"می حرام است ولیکن تو بدین نرگس مست","نگذاری که ز پیشت برود هشیاری","سکر و مستی ناشی از شراب (می) به دلیل حرام بودن آن نادرست است، ولی تو با چشم‌های زیبا و جذاب خود اینقدر جذاب هستی که هیچ‌کس نمی‌تواند از هوشیاری و آگاهی خود فاصله بگیرد و تحت تأثیر تو قرار نگیرد."],[560,"می‌روی خرم و خندان و نگه می‌نکنی","که نگه می‌کند از هر طرفت غم‌خواری","تو با حال شاد و خندان به راحتی می‌روی و به اطراف توجهی نداری، در حالی که غم‌خواری (کسانی که به خاطر تو غمگین هستند) همواره به تو نگاه می‌کنند."],[560,"خبرت هست که خلقی ز غمت بی‌خبرند","حال افتاده نداند که نیفتد باری","تو می‌دانی که برخی از مردم از غم و ناراحتی تو بی‌خبرند و حال آنهایی که در این وضعیت هستند، نمی‌دانند که این وضعیت برایشان پیش نخواهد آمد."],[560,"سرو آزاد به بالای تو می‌ماند راست","لیکنش با تو میسر نشود رفتاری","درخت سرو آزاد، با قامت زیبای تو شباهت دارد، اما نمی‌تواند به خاطر تو رفتار خنک و آرامی داشته باشد. یعنی، شرایطی که تو ایجاد کرده‌ای مانع از آرامش اوست."],[560,"می‌نماید که سر عربده دارد چشمت","مست خوابش نبرد تا نکند آزاری","چشمان تو به قدری زیبا و با آرامش‌اند که گویی مستی و هیجان وجودشان را تحت‌الشعاع قرار داده است و به همین دلیل خواب از چشمان کسی که به تو نگاه می‌کند دور می‌شود تا آسیبی به تو نرسد."],[560,"سعدیا دوست نبینی و به وصلش نرسی","مگر آن وقت که خود را ننهی مقداری","سعدی می‌گوید که ای دوست، تو هرگز نمی‌توانی محبوب را ببینی و به وصالش نرسی، مگر اینکه حد و مرز خود را بشناسی و مقداری از خود را کنار بگذاری."],[561,"خوش بود یاری و یاری بر کنار سبزه‌زاری","مهربانان، روی بر هم، وز حسودان بر کناری","یار خوشبو و مهربان در کنار دشت پر از سبزه و گل، با دیگری در حال صحبت و خوش‌گذرانی است و در کنار این لذت، حسودان دور از آن‌ها قرار دارند."],[561,"هر که را با دل‌ستانی عیش می‌افتد زمانی","گو «غنیمت دان که دیگر، دیر دیر افتد شکاری»","هر کسی که با دل‌ربایی و عشق خوشی و سرور تجربه کند، بداند که این لحظات را باید غنیمت بشمارد، زیرا ممکن است به زودی این خوشی‌ها نایاب شوند."],[561,"راحت جان است رفتن با دلارامی به صحرا","عین درمان است گفتن، درد دل با غم‌گساری","رفتن به صحرا با محبوبی آرام‌بخش، برای روح مانند درمانی مؤثر است. همچنین، بیان کردن درد دل به کسی که غم را می‌زداید، آرامش و راحتی را به همراه دارد."],[561,"هر که منظوری ندارد، عمر ضایع می‌گذارد","اختیار این است دریاب، ای که داری اختیاری","هر کسی که هدف و مقصودی در زندگی نداشته باشد، عمر خود را به بطالت می‌گذراند. این نکته را درک کن، ای کسی که اختیار و قدرت تصمیم‌گیری داری."],[561,"عیش در عالم نبودی، گر نبودی روی زیبا","گر نه گل بودی نخواندی، بلبلی بر شاخساری","زندگی در این جهان لذت نداشت، اگر چهره زیبا وجود نداشت. اگر گل نمی‌بود، بلبل هم بر شاخه درخت نمی‌خواند."],[561,"بار بی‌اندازه دارم، بر دل از سودای جانان","آخر ای بی‌رحم، باری از دلی برگیر باری","من بار زیادی از عشق محبوبم بر دل دارم و از تو خواهش می‌کنم، ای بی‌رحم، این بار سنگین را از دلم بردار."],[561,"دانی از بهر چه معنی، خاک پایت می‌نباشم؟","تا تو را ننشیند از من، بر دل نازک غباری","من برای چه هدفی به خاک پای تو احترام می‌گذارم؟ تا اینکه با دوستی تو، بر دل حساس من کمترین غباری ننشیند."],[561,"ور تو را با خاکساری، سر به صحبت درنیاید","بر سر راهت بیفتم، تا کنی بر من گذاری","اگر تو نتوانی با تواضع و خاکساری خود، در جمع تو سخن بگویی و از این راه به من نزدیک شوی، من در مسیر تو خواهم افتاد تا تنها نگاهی به من بیندازی."],[561,"زندگانی صرف کردن، در طلب حیفی نباشد","گر دری خواهد گشودن، سهل باشد انتظاری","زندگی را صرف کردن در طلب خواسته‌ای زشت نیست، اگر بخواهی در را به روی خود باز کنی، انتظار برای این کار آسان است."],[561,"دوستان معذور دارند، از جوانمردی و رحمت","گر بنالد دردمندی، یا بگرید بی‌قراری","دوستان به خاطر جوانمردی و رحمتی که دارند، از کسانی که دچار درد و رنج هستند معذرت‌خواهی می‌کنند، حتی اگر رنج‌کشیده‌ای به خاطر دردش ناله کند یا از بی‌قراری‌اش اشک بریزد."],[561,"رفتنش دل می‌رباید، گفتنش جان می‌فزاید","با چنین حسن و لطافت، چون کند پرهیزگاری؟","رفتن او دل را می‌دزدد و صحبت کردنش جان را زنده می‌کند. با وجود این همه زیبایی و لطافت، چگونه می‌تواند پارسا (پرهیزگار) باشد؟"],[561,"عمر سعدی گر سر آید، در حدیث عشق شاید","کاو نخواهد ماند بی‌شک، وین بماند یادگاری","اگر عمر سعدی به پایان برسد، در داستان عشق، یاد او باقی خواهد ماند و او هرگز فراموش نخواهد شد. در واقع، این یادگاری از او باقی می‌ماند."],[562,"دو چشم مست تو برداشت رسم هشیاری","و گر نه فتنه ندیدی به خواب، بیداری","چشم‌های مست تو نشانه‌ای از هشیاری را نشان دادند، و اگر این نبود، هیچ فتنه‌ای را در خواب نمی‌دیدی و بیداری تو هم بی‌فایده بود."],[562,"زمانه با تو چه دعوی کند به بدمهری","سپهر با تو چه پهلو زند به غداری","زمانه و دنیا چه ادعایی می‌تواند درباره نامهربانی تو داشته باشد؟ آسمان و چرخ فلک چگونه با بی‌رحمی تو برابری کند؟ (AI: زمانه و دنیا چه ادعایی می‌تواند درباره‌ی تو داشته باشد، وقتی که آسمان این قدر با تو نامهربان است و به تو خیانت می‌کند.)"],[562,"معلمت همه شوخی و دلبری آموخت","به دوستیت وصیت نکرد و دلداری","آموزگار تو فقط شوخی و محبت را به تو یاد داد، اما در دوستی هیچ نصیحتی نکرد و به تو دلداری نداد."],[562,"چو گل لطیف ولیکن حریف اوباشی","چو زر عزیز ولیکن به دست اغیاری","شما مانند گل زیبا و لطیف هستید، اما در کنار افرادی بی‌اخلاق و فاسد قرار دارید. مانند طلا که بسیار باارزش است، اما در دستان کسانی که نادرست هستند، قرار گرفته‌اید."],[562,"به صید کردن دل‌ها چه شوخ و شیرینی","به خیره کشتن تن‌ها چه جلد و عیاری","دل‌ربایی و زیبایی تو به‌قدری جذاب و شیرین است که به راحتی دل‌ها را صید می‌کند، و کشتن جسم و جان دیگران هم با نیرنگ و فتنه‌ای که در تو هست، به‌راحتی انجام می‌شود."],[562,"دلم ربودی و جان می‌دهم به طیبت نفس","که هست راحت درویش در سبکباری","خودت دل مرا دزدیده‌ای و من برای تو جان می‌دهم، زیرا نفس تو (بوی تو) برای درویش (انسان ساده و بی‌ادعا) راحتی و آسایش را به ارمغان می‌آورد."],[562,"گر افتدت گذری بر وجود کشته عشق","سخن بگوی که در جسم مرده جان آری","اگر به طور تصادفی بر وجود کسی که به عشق کشته شده، بگذری، صحبتی بکن؛ زیرا تو می‌توانی در جسم بی‌جان او روح حیات را دمیده و زندگی ببخشی."],[562,"گرت ارادت باشد به شورش دل خلق","بشور زلف که در هر خمی دلی داری","اگر محبت و ارادت تو به تحریک دل‌هاست، پس زلفت را به هم بریز و به هم بزن، زیرا در هر فرورفتگی زلف تو، دلی عاشق و شیدا نهفته است."],[562,"چو بت به کعبه نگونسار بر زمین افتد","به پیش قبله رویت بتان فرخاری","اگر بت مانند یک مجسمه در کعبه به زمین بیفتد، معنای آن این است که در برابر قبله، روی تو برای بت‌هایی که زیبا هستند، ارزش و احترام دارد."],[562,"دهان پر شکرت را مثل به نقطه زنند","که روی چون قمرت شمسه‌ایست پرگاری","دهان تو که پر از شیرینی است، مانند یک نقطه روی کاغذ می‌نشیند، چرا که صورت تو مانند ماه است و زیبایی‌اش همواره درخشان و دل‌انگیز است."],[562,"به گرد نقطه سرخت، عذار سبز، چنان","که نیم دایره‌ای برکشند زنگاری","به دور نقطه‌ای که چهره‌ات است، گونه‌ات سبز و زیباست، مانند نیم‌دایره‌ای که رنگی زنگارین برمی‌کشند."],[562,"هزار نامه پیاپی نویسمت که جواب","اگر چه تلخ دهی در سخن، شکرباری","هرچند که جواب‌هایی که به من می‌دهی ممکن است تلخ باشد، اما می‌خواهم برایت هزار نامه بنویسم، زیرا گفتار تو برای من شیرین و دلپذیر است."],[562,"ز خلق گوی لطافت تو برده‌ای امروز","به خوب‌رویی و سعدی به خوب‌گفتاری","امروز لطافت و زیبایی تو را از مردم گرفته‌ای و سعدی را با سخن زیبا، تحت تأثیر خود قرار داده‌ای."],[563,"عمری به بوی یاری کردیم انتظاری","زآن انتظار ما را نگشود هیچ کاری","ما سال‌ها به خاطر بوی محبوبی که داشت، انتظارش را کشیدیم، اما این انتظار هیچ اثر مثبتی برای ما نداشت و هیچ چیزی را برای ما روشن نکرد."],[563,"از دولت وصالش حاصل نشد مرادی","وز محنت فراقش بر دل بماند باری","از لطف و احسان وصل او چیزی به دست نیاوردم و غم دوری‌اش همیشه بر دلم باقی مانده است."],[563,"هر دم غم فراقش بر دل نهاد باری","هر لحظه دست هجرش در دل شکست خاری","هر لحظه غم فراق او بر دل من سنگینی می‌کند و هر بار که فاصله‌اش را احساس می‌کنم، مانند یک خار در دل من فرو می‌رود."],[563,"ای زلف تو کمندی ابروی تو کمانی","وی قامت تو سروی وی روی تو بهاری","زلف تو مانند کمند و ابروی تو مانند کمان است. از طرفی، قامت تو مانند درخت سرو و روی تو مانند بهار زیبا و دل‌انگیز است."],[563,"دانم که فارغی تو از حال و درد سعدی","کاو را در انتظارت خون شد دو دیده باری","من می‌دانم که تو نسبت به حال و درد من بی‌توجه هستی، در حالی که من سعدی، در انتظار تو به شدت غمگین و گریان شده‌ام."],[563,"دریاب عاشقان را کافزون کند صفا را","بشنو تو این سخن را کاین یادگار داری","عاشقان را دریاب و به آنها کمک کن تا صفای دلشان بیشتر شود. توجه کن که این پیام را بگوش جان بسپار، زیرا این سخن را به یاد تو به‌جا گذاشته‌ام."],[564,"مرا دلیست گرفتار عشق دلداری","سمن‌بری صنمی گلرخی جفاکاری","دل من به عشق معشوقی زیبا و مکار گرفتار شده است. معشوقی که مانند گل است، ولی در عین حال به خاطر جفا و بی‌وفایی‌اش، دلم را می‌آزارد."],[564,"ستمگری شغبی فتنه‌ای دل‌آشوبی","هنروری عجبی طرفه‌ای جگرخواری","ستمگری و بدعهدی محبوبی باعث بی‌قراری و آشفتگی دل شده و هنری عجیبی دارد که آدمی را آزار می‌دهد."],[564,"بنفشه‌زلفی نسرین‌بری سمن‌بویی","که ماه را بر حسنش نماند بازاری","زلفی به رنگ بنفشه و گلی از نسرین با بوی سمن، که زیبایی‌اش به حدی است که ماه نمی‌تواند با او رقابت کند."],[564,"همای‌فری طاووس‌حسن و طوطی‌نطق","به گاه جلوه‌گری چون تذرو رفتاری","کسی که زیبایی‌اش مانند همای (پرنده‌ای زیبا) و طاووس است و حرف زدنش شبیه طوطی است، هنگامی که در برابرم ظاهر می‌شود، رفتاری دارد که به مانند پرنده‌ای نوین و لطیف است."],[564,"دلم به غمزه جادو ربود و دوری کرد","کنون بماندم بی‌او چو نقش دیواری","دل من با یک نگاه معشوق فریب خورده و از او دور شده است، اکنون مثل نقش و تصویری بر روی دیوار به حال بی‌حالی و بی‌خبر از او باقی مانده‌ام."],[564,"ز وصل او چو کناری طمع نمی‌دارم","کناره کردم و راضی شدم به دیداری","از وصال و دیدار معشوق چیزی نمی‌طلبم و به دوری از او رضایت داده‌ام و به همین دیدار بسنده کرده‌ام."],[564,"ز هر چه هست گزیر است و ناگزیر از دوست","چه چاره سازد در دام دل گرفتاری","از هر چیزی می‌توان فرار کرد، اما از دوست نمی‌توان، چه راه حلی برای کسی که در دام عشق او گرفتار شده وجود دارد؟"],[564,"در اشتیاق جمالش چنان همی‌نالم","چو بلبلی که بماند میان گلزاری","در عشق و زیبایی او به شدت ناله می‌زنم، مانند بلبل که در میان گل‌ها درگیر و ناتوان است و نمی‌تواند از آن‌ها جدا شود."],[564,"حدیث سعدی در عشق او چو بیهده ا‌ست","نزد دمی چو ندارد زبان گفتاری","سخن سعدی در عشق او بی‌فایده است، زیرا در لحظه‌ای که عشق واقعی وجود ندارد، نمی‌توان با زبان سخن گفت."],[565,"من از تو روی نپیچم گرم بیازاری","که خوش بود ز عزیزان، تحمل خواری","هرگز از تو روی نمی‌گردانم حتی اگر به من آزار برسانی، زیرا تحمل رنج و سختی از عزیزان برایم زیباست."],[565,"به هر سلاح که خون مرا بخواهی ریخت","حلال کردمت الا به تیغ بیزاری","هر طوری که بخواهی می‌توانی خون مرا بریزی و از من انتقام بگیری، اما من هیچگاه تو را به خاطر نادانی و بیزاری‌ات حلال نمی‌کنم."],[565,"تو در دل من از آن خوش‌تری و شیرین‌تر","که من ترش بنشینم ز تلخ گفتاری","تو برای من در دل، از همه چیز خوش‌تر و شیرین‌تر هستی، حتی اگر من به خاطر سخنان تلخ تو، روی نازی داشته باشم و در حالت ترش‌رو بنشینم."],[565,"اگر دعات ارادت بود و گر دشنام","بگوی از آن لب شیرین که شهد می‌باری","اگر به تو ارادت داشته باشند و حتی اگر بد بگویند، باز هم از آن لب شیرین تو که همچون عسل است، خوشحالم و لذت می‌برم."],[565,"اگر به صید روی وحشی از تو نگریزد","که در کمند تو راحت بود گرفتاری","اگر وحشی (پرنده یا حیوانی آزاد) به دام تو نگریزد، به این دلیل است که در دام تو، راحتی و امنیت دارد، اما این به معنی ناتوانی و ناچاری او نیست."],[565,"به انتظار عیادت که دوست می‌آید","خوش است بر دل رنجور عشق، بیماری","انتظار دیدار دوست برای کسی که در عشق بیمار است، حالتی خوشایند و آرامش‌بخش به دل او می‌دهد."],[565,"گرم تو زهر دهی چون عسل بیاشامم","به شرط آن که به دست رقیب نسپاری","اگر تو هم مثل عسل زهر برای من بیاوری، من آن را می‌نوشم به این شرط که آن را به دست رقیب من ندهی."],[565,"تو می‌روی و مرا چشم و دل به جانب توست","ولی چه سود؟ که جانب نگه نمی‌داری","تو می‌روی ولی من همچنان به تو چشم و دل دوخته‌ام، اما چه فایده دارد که تو به من توجهی نمی‌کنی."],[565,"گرت چو من غم عشقی زمانه پیش آرد","دگر غم همه عالم به هیچ نشماری","اگر مانند من غم عشق تو را به دردسر بیندازد، دیگر غم‌های دنیا را هیچ به حساب نمی‌آوری."],[565,"درازنای شب از چشم دردمندان پرس","که هر چه پیش تو سهل است سهل پنداری","در طول شب، از چشم‌های کسانی که در درد و رنج هستند بپرس که آن‌ها به خوبی می‌دانند چه چیزهایی به واقع دشوار است، درحالی‌که تو ممکن است آن‌ها را آسان تلقی کنی."],[565,"حکایت من و مجنون به یکدگر ماند","نیافتیم و بمردیم در طلبکاری","حکایت من و مجنون، که نمادی از عشق‌های سوزان و ناکام است، به هم شباهت دارد. ما هر دو در جستجوی چیزی بودیم که نتوانستیم به آن برسیم و در این راه، جان خود را از دست دادیم."],[565,"بنال سعدی اگر چاره وصالت نیست","که نیست چاره بیچارگان به جز زاری","سعدی می‌گوید اگر راهی برای رسیدن به وصال معشوق وجود ندارد، پس تنها راه برای بیچاره‌ها، ناله و زاری است."],[566,"نه تو گفتی که «به جای آرم» و گفتم که «نیاری»","عهد و پیمان و وفاداری و دلبندی و یاری","در این بیت، شاعر به معشوق می‌گوید که تو نگفتی که «به جای من خواهی ماند»، و من نیز پاسخ دادم که «نمی‌توانی چنین کنی»، زیرا در عشق و وفاداری و دلبندی نمی‌توان به سادگی وعده داد یا یاری کرد."],[566,"زخم شمشیر اجل به که سر نیش فراقت","کشتن اولاتر از آن که‌م به جراحت بگذاری","زخم با شمشیر اجل بهتر است تا که نیش ناشی از جدایی را تحمل کنی، کشتن سزاوارتر است تا اینکه زخم تحمل ناپذیری بر من بزنی. / شمشیر اجل: اضافه تشبیهی / که‌م،کم: که مرا / (AI: بهتر است که درد و آسیب ناشی از جدایی را تحمل کنی تا اینکه زخم تحمل ناپذیری از مرگ یا پایانی ناگوار بر تو آشکار شود.)"],[566,"تن آسوده چه داند که دل خسته چه باشد؟","من گرفتار کمندم، تو چه دانی که سواری؟","کسی که در آرامش است، نمی‌تواند درک کند دل خسته چه احساسی دارد. من در دام عشق تو گرفتار شده‌ام، اما تو چه می‌دانی که در عشق من چه بر من می‌گذرد؟"],[566,"کس چنین روی ندارد، تو مگر حور بهشتی","وز کس این بوی نیاید، مگر آهوی تتاری؟","هیچ‌کس چنین چهره و زیبایی ندارد، مگر اینکه تو یک حور بهشتی باشی. و اگر این عطر خوش از کسی به مشام برسد، تنها ممکن است از آهویی تاتاری باشد."],[566,"عرقت بر ورق روی نگارین به چه ماند؟","همچو بر خرمن گل قطره باران بهاری","عرق تو بر روی تابناک و نقشین تو مانند چیست؟ مانند قطره باران بهاری است که بر روی خوشه‌های گل می‌نشیند."],[566,"طوطیان دیدم و خوش‌تر ز حدیثت نشنیدم","شکرست آن، نه دهان و لب و دندان که تو داری","من طوطیانی را دیدم، اما هیچ چیزی به زیبایی حرف‌های تو نیست. خوش‌گذرانی و لذت بهشتی، نه به خاطر دهان و لب و دندان‌های تو، بلکه به خاطر خود توست."],[566,"ای خردمند که گفتی «نکنم چشم به خوبان»","به چه کار آیدت آن دل که به جانان نسپاری؟","به شخص خردمند که گفته است: «به زیباها چشم ندوختم»، چه فایده‌ای دارد دلی که آن را به معشوق ندهد؟"],[566,"آرزو می‌کندم با تو شبی بودن و روزی","یا شبی روز کنی چون من و روزی به شب آری","منی آرزو داشتم که یا شب را با تو بگذرانم و یا این‌که تو شب را به روز تبدیل کنی، همان‌طور که من روز را به شب می‌آورم."],[566,"هم اگر عمر بود، دامن کامی به کف آید","که گل از خار همی آید و صبح از شب تاری","اگر عمر درازی هم داشته باشم، با گرفتن یک دامن از کامی (خوشبختی) می‌توانم بهره‌مند شوم، زیرا از بین فشار و زحمت (خار) نیز لذت و زیبایی (گل) بیرون می‌آید و صبح (روشنی و روزی) از تاریکی شب (غصه و اندوه) می‌زاید."],[566,"سعدی آن طبع ندارد که ز خوی تو برنجد","خوش بود هر چه تو گویی و شکر هر چه تو باری","سعدی نمی‌تواند از رفتار و خوی تو خشمگین شود، زیرا هر چیزی که تو بگویی برایش خوشایند است و هر چیزی که تو به او هدیه کنی شیرین و ارزشمند است."],[567,"اگر به تحفه جانان هزار جان آری","محقر است نشاید که بر زبان آری","اگر به عنوان هدیه برای محبوب خود هزار جان هم بیاوری، این کار در نظر او ناچیز و سرافکندگی است و شایسته نیست که این موضوع را بر زبان بیاوری."],[567,"حدیث جان بر جانان همین مثل باشد","که زر به کان بری و گل به بوستان آری","صحبت از روح و جان درباره محبوب، همچون این است که طلا را به معدن ببری یا گل را به باغ ببری؛ به عبارت دیگر، این مسائل واضح و بدیهی نیستند که نیازی به ذکر آن‌ها باشد."],[567,"هنوز در دلت ای آفتاب رخ نگذشت","که سایه‌ای به سر یار مهربان آری","هنوز در دل تو، ای خورشید زیبایی، هیچ نشانه‌ای از محبت به معشوق مهربانت دیده نمی‌شود، که سایه‌ای از خود بر سر او نندازی."],[567,"تو را چه غم که مرا در غمت نگیرد خواب؟","تو پادشاه, کجا یاد پاسبان آری؟","تو را چه نگرانی است که من از غم تو خوابم نمی‌برد؟ تو که پادشاهی، چه نیازی به یادآوری محافظ خانه داری؟"],[567,"ز حسن روی تو بر دین خلق می‌ترسم","که بدعتی که نبوده‌ست در جهان آری","از زیبایی چهره‌ات می‌ترسم که ممکن است باعث تحولات جدیدی در دین و باورهای مردم شود، چرا که چنین بدعتی تاکنون در جهان وجود نداشته است."],[567,"کس از کناری، در روی تو نگه نکند","که عاقبت نه به شوخیش در میان آری","هیچ‌کس از کناری به چهره تو نگاه نمی‌کند، زیرا که در نهایت هیچ‌کس نمی‌تواند به شوخی و بی‌خیالی تو در این دنیا اطمینان کند."],[567,"ز چشم مست تو واجب کند که هشیاران","حذر کنند ولی تاختن نهان آری","نگاه مست تو موجب می‌شود که افراد عاقل احتیاط کنند، اما تو در خفا به دنبال نزدیک شدن و جلوه‌گری هستی."],[567,"جواب تلخ چه داری؟ بگوی و باک مدار","که شهد محض بود چون تو بر دهان آری","اگر پاسخ تلخی داری، بی‌پرواتر بگو، چرا که وقتی تو این را به زبان می‌آوری، مثل شهد شیرین می‌شود."],[567,"و گر به خنده درآیی چه جای مرهم ریش؟","که ممکن است که در جسم مرده جان آری","اگر تو با خنده به من نزدیک شوی، دیگر نیازی به مرهم نیست، چون شاید بتوانی به یک مرده هم جان ببخشی."],[567,"یکی لطیفه ز من بشنو ای که در آفاق","سفر کنی و لطایف ز بحر و کان آری","شخصی که در سفر به دنیاست و لطیفه‌ها و زیبایی‌ها را از دریا و معادن می‌خواهد بشنود، باید از من یک لطیفه بشنود."],[567,"گرت بدایع سعدی نباشد اندر بار","به پیش اهل و قرابت چه ارمغان آری؟","اگر آثار زیبا و خاص سعدی را نداشته باشی، در برابر اهل و آشناها چه چیزی برای هدیه آوردن داری؟"],[568,"کس از این نمک ندارد، که تو ای غلام داری","دل ریش عاشقان را نمکی تمام داری","هیچ کسی به اندازه تو که غلام هستی، نمک ندارد؛ تو با اشک و غم دل عاشقان را کاملا شور و تلخ کرده‌ای."],[568,"نه من اوفتاده تنها، به کمند آرزویت","همه کس سر تو دارد، تو سر کدام داری؟","من تنها در عشق تو گرفتار هستم و به کمند آرزوی تو افتاده‌ام. همه به یاد و فکر تو هستند، اما تو به یاد کدام یک از آن‌ها هستی؟"],[568,"ملکا! مها! نگارا! صنما! بتا! بهارا!","متحیرم، ندانم، که تو خود چه نام داری؟","ای ملکه! ای محبوب! ای معشوق! ای بت! ای بهار! من از شدت شگفتی و حیرت نمی‌دانم خودت چه نامی داری و کیستی."],[568,"نظری به لشکری کن، که هزار خون بریزی","به خلاف تیغ هندی، که تو در نیام داری","به لشکر دشمن نگاهی بینداز که با این تعداد کشته‌ها، ارزش هیچ‌یک از این خون‌ها به اندازه یک آسیب که تیغ هندی به تو می‌زند، نیست."],[568,"صفت رخام دارد، تن نرم نازنینت","دل سخت نیز با او، نه کم از رخام داری","تن نرم و لطیف تو همچون رخام (سنگی نرم و زیبا) است، اما دل سفت و سخت تو نیز به همان اندازه از رخام بی‌نصیب نیست و سختی دارد."],[568,"همه دیده‌ها به سویت، نگران حسن رویت","منت آن کمینه مرغم، که اسیر دام داری","همه چشم‌ها به سمت تو هستند و نگران زیبایی چهره‌ات. من که موجودی کم‌ارزش و بی‌چیز هستم، گرفتار دام تو شده‌ام."],[568,"چه مخالفت بدیدی، که مخالطت بریدی؟","مگر آن که ما گداییم و تو احتشام داری","چه مشکل یا بی‌ادبی از من دیدی که باعث شدی با من رابطه‌ات را قطع کنی؟ شاید دلیلش این است که ما در نظر تو مانند گدایان هستیم و تو در مقام و مرتبت بالایی قرار داری."],[568,"به جز این گنه ندانم، که محب و مهربانم","به چه جرم دیگر از من سر انتقام داری؟","من نمی‌دانم به جز این گناه که محب و مهربان هستم، به چه دلیل دیگری از من انتقام می‌گیری؟"],[568,"گله از تو حاش لله، نکنند و خود نباشد","مگر از وفای عهدی، که نه بر دوام داری","از تو شکایتی نمی‌کنم، زیرا هیچ‌کس جز من به خاطر وفای به عهدی که به من داشتی، نمی‌تواند این احساس را داشته باشد و این وفا پایدار نیست."],[568,"نظر از تو برنگیرم، همه عمر تا بمیرم","که تو در دلم نشستی و سر مقام داری","هرگز نگاه خود را از تو برنمی‌دارم تا زمانیکه بمیرم، چرا که برای من \"تو در میان جانی\" و جایگاهی بالا و ارزشمند داری."],[568,"سخن لطیف سعدی، نه سخن که قند مصری","خجل است از این حلاوت، که تو در کلام داری","سعدی می‌گوید که سخنانش بسیار شیرین و لطیف هستند، به‌گونه‌ای که حتی قند مصری نیز از این شیرینی احساس شرم می‌کند، چون تو در کلام خود به حلاوت و زیبایی خاصی دست یافته‌ای."],[569,"حدیث یا شکر است آن که در دهان داری","دوم به لطف نگویم که در جهان داری","سخن یا نعمت است آنچه بر زبان داری، اما از لطف و مهربانی نیست که می‌گویم که در جهان دومی و نظیری نداری. (AI: سخن یا نعمت است آنچه بر زبان داری، اما به لطف و مهربانی نمی‌توانم بگویم که در زندگی‌ات چه چیزهایی را داری.)"],[569,"گناه عاشق بیچاره نیست در پی تو","گناه توست که رخسار دل‌ستان داری","عاشق بیچاره‌ای که در پی توست، تقصیری ندارد و تقصیر از توست که چهره‌ای دل‌ربا و جذاب داری."],[569,"جمال عارض خورشید و حسن قامت سرو","تو را رسد که چو دعوی کنی، بیان داری","جمال صورت تو به اندازه زیبایی خورشید و قامت تو به خوبی سرو است، بنابراین وقتی که زیبایی‌ات را به رخ می‌کشی، گویی به حق می‌گویی و هیچ نیازی به توضیح بیشتر نیست."],[569,"ندانم ای کمر! این سلطنت چه لایق توست","که با چنین صنمی دست در میان داری","نمی‌دانم ای کمر! این زیبایی چه جذابیتی دارد که تو با چنین معشوقی در آغوش داری."],[569,"بسی‌ست تا دل گم کرده باز می‌جستم","در ابروان تو بشناختم که آن داری","مدت‌هاست که دل گمشده‌ام را می‌جویم و به این نتیجه رسیده‌ام که در ابروان تو نشانه‌ای وجود دارد که نشان می‌دهد تو آنچه را که دلم می‌خواهد، داری."],[569,"تو را که زلف و بناگوش و خد و قد این‌ست","مرو به باغ که در خانه بوستان داری","تو را با زیبایی‌هایت مانند زلف، صورت و قامت می‌شناسم، نباید به باغ بروی چون در خانه‌ات خود بوستان و زیبایی‌ها را داری."],[569,"بدین صفت که تویی دل چه جای خدمت توست؟","فراتر آی که ره در میان جان داری","با این وصف و خصوصیاتی که تو داری، دل من شایسته خدمت به تو نیست. فراتر برو، زیرا تو راهی در میان جان و دل‌ها داری که من نمی‌توانم به آن برسم."],[569,"گر این روش که تو طاووس می‌کنی رفتار","نه برج من که همه عالم آشیان داری","اگر این طرز رفتاری که تو مانند طاووس داری ادامه پیدا کند، نه تنها بر سر من که بر تمام جهان آشیانه‌ای که در آن زندگی می‌کنی، تأثیر می‌گذارد."],[569,"قدم ز خانه چو بیرون نهی، به عزت نه","که خون دیده سعدی بر آستان داری","اگر از خانه خارج شوی، به خاطر عزت خودت نیست، بلکه وای به حال تو که اشک چشم سعدی را در آستان تو می‌ریزی."],[570,"هرگز نبود سرو به بالا که تو داری","یا مه به صفای رخ زیبا که تو داری","هرگز سروی به بلندی تو نبوده و هیچ مهی به روشنی و زیبایی چهره تو وجود ندارد."],[570,"گر شمع نباشد شب دل‌سوختگان را","روشن کند این غرّه غر‍‌ّا که تو داری","حتی اگر شمعی در شب وجود نداشته باشد، این زیبایی دلربا و خیره‌کننده تو قادر است دل‌سوختگان را روشن کند."],[570,"حوران بهشتی که دل خلق ستانند","هرگز نستانند دل ما که تو داری","حوری‌های بهشتی که دل‌های دیگران را به تسخیر در می‌آورند، هرگز نمی‌توانند دل ما را بربایند، زیرا تو آنچه را که ما داریم، در خود جمع کرده‌ای."],[570,"بسیار بود سرو روان و گل خندان","لیکن نه بدین صورت و بالا که تو داری","بسیاری از سروهای باریک و گل‌های خندان وجود دارد، اما هیچ‌کدام به زیبایی و شکوه تو نیستند."],[570,"پیداست که سرپنجه ما را چه بود زور","با ساعد سیمین توانا که تو داری","مشخص است که قدرت و توانایی ما در برابر بازوی نازک و قدرتمند تو، هیچ است و نمی‌توان با آن مقایسه کرد."],[570,"سحر سخنم در همه آفاق ببردند","لیکن چه زند با ید بیضا که تو داری","سخن من در همه دنیا تاثیرگذار است، اما چه کسی می‌تواند با دست‌های معجزه‌آسا و قدرت تو رقابت کند؟"],[570,"امثال تو از صحبت ما ننگ ندارند","جای مگس است این همه حلوا که تو داری","افرادی همچون تو از نشستن و گفت‌وگو با ما شرم نمی‌کنند، زیرا این‌جا که تو هستی، همگی در مقام مگس هستند و این همه شیرینی و نعمت‌ها در اختیار توست."],[570,"این روی به صحرا کند آن میل به بستان","من روی ندارم مگر آن جا که تو داری","در این بیت سعدی می‌گوید که من تمایلی به صحرا یا باغ ندارم، مگر اینکه تو در آنجا باشی. او به این معناست که حضور معشوق برای او اهمیت دارد و بدون او هیچ جایی برایش جذاب نیست."],[570,"سعدی تو نیآرامی و کوته نکنی دست","تا سر نرود در سر سودا که تو داری","سعدی می‌گوید تو در آرامش نیستی و دست کوتاه نکن تا تمام آرزوهایی که در دل داری (سودا) از بین نرود."],[570,"تا میل نباشد به وصال از طرف دوست","سودی نکند حرص و تمنا که تو داری","اگر از سوی دوست تمایلی به وصال نباشد، هیچ فایده‌ای ندارد که تو به شدت به عشق و خواسته‌هایت اصرار کنی."],[571,"تو اگر به حسن، دعوی بکنی، گواه داری","که جمال سرو بستان و کمال ماه داری","اگر تو بخواهی درباره زیبایی خود ادعا کنی، باید شاهدی داشته باشی که نشان دهد زیبایی تو به اندازه سروهای زیبا در باغ و کمال ماه در آسمان است."],[571,"در کس نمی‌گشایم که به خاطرم درآید","تو به اندرون جان آی که جایگاه داری","من در کسی را به روی او نمی‌گشایم، مگر آنکه تو به یادم بیافتی. بیا و به قلب من وارد شو که تو در آن مقام و منزلتی داری."],[571,"ملکی مهی ندانم، به چه کنیتت بخوانم؟","به کدام جنس گویم که تو اشتباه داری؟","من نمی‌دانم چه نام یا صفتی برای تو انتخاب کنم، زیرا به هر شکل یا نوعی که تو را توصیف کنم، باز هم اشتباه کرده‌ام."],[571,"بر کس نمی‌توانم به شکایت از تو رفتن","که قبول و قوّتت هست و جمال و جاه داری","نمی‌توانم درباره تو به کسی شکایت کنم، زیرا تو قدرت و زیبایی و مقام بلندی داری که دیگران نمی‌توانند به تو ایرادی بگیرند."],[571,"گل بوستان رویت چو شقایق است لیکن","چه کنم به سرخ‌رویی؟ که دلی سیاه داری","روی گل‌های بوستان، چهره‌ات همچون شقایق زیباست، اما من چه کنم که با وجود زیبایی تو، دل تو تیره و سیاه است."],[571,"چه خطای بنده دیدی که خلاف عهد کردی؟","مگر آن که ما ضعیفیم و تو دستگاه داری","سؤال می‌شود که چه اشتباهی از این بنده سر زده که تو به عهد خود وفا نکردی؟ آیا این دلیل نمی‌شود که ما در برابر تو ضعف داریم و تو قدرت و سلطنتی بر ما داری؟"],[571,"نه کمال حسن باشد ترشی و روی شیرین","همه بد مکن که مردم همه نیکخواه داری","هر زیبایی و خوبی نمی‌تواند به معنای ترشی و زشتی باشد؛ پس نباید کارهای بد انجام دهی، زیرا مردم تو را دوست دارند و برای تو خیرخواهی می‌کنند."],[571,"تو جفا کنی و صولت، دگران دعای دولت","چه کنند از این لطافت که تو پادشاه داری؟","اگر تو به دیگران ظلم و بدی کنی و قدرت و سلطه‌ای داشته باشی، دیگران چه دعایی برای خوشبختی و موفقیت شان کنند وقتی که تو اینقدر جذاب و خوب هستی و تاج پادشاهی بر سر داری؟"],[571,"به یکی لطیفه گفتی ببرم هزار دل را","نه چنان لطیف باشد که دلی نگاه داری","تو به یکی لطیفه (شادی یا شوخی) گفتی که می‌توانم هزار دل را ببرم، اما هیچ لطیفه‌ای به اندازه‌ی محبت و توجه تو نمی‌تواند دل کسی را نگه دارد."],[571,"به خدای اگر چو سعدی برود دلت به راهی","همه شب چنو نخسبی و نظر به راه داری","اگر دلت مانند سعدی در عشق کسی باشد، هیچگاه نمی‌توانی آرام بخوابی و همیشه منتظر او خواهی بود."],[572,"این چه رفتار است کآرامیدن از من می‌بری؟","هوشم از دل می‌ربایی عقلم از تن می‌بری","تو با رفتارت باعث می‌شوی که من آرامش و آسودگی را از دست بدهم. تو با جلب توجه من، هوش و دلم را می‌گیری و عقل و اندیشیدنم را نیز از جسمم جدا می‌کنی."],[572,"باغ و لالستان چه باشد؟ آستینی برفشان","باغبان را گو «بیا» گر گل به دامن می‌بری","باغ و گلستان چه ارزشی دارد؟ تو آستین برفشان! اگر باغبان می‌خواهد گل‌ها را بچیند و با خود ببرد، بگو: بیا! / آستینی برفشان: یک آستین گل نثار کن یا دست‌افشانی و پای‌کوبی نما (منبع: شرح غزل‌های سعدی) / (AI: باغ و گلستان چه ارزشی دارد اگر باغبان در سرمای برف، آستینش را بالا نزند و بی‌خیال گل‌ها باشد؟ یعنی اگر می‌خواهی گل‌ها را بچینی و با خود ببری، باید ابتدا کار و زحمت باغبان را در نظر بگیری و به او توجه کنی.)"],[572,"روز و شب می‌باشد آن ساعت که همچون آفتاب","می‌نمایی روی و دیگر باز روزن می‌بری","این ساعت از روز، زمانی است که تو مثل آفتاب روشن و زیبا به نظر می‌رسی و دیگران از تو بهره‌مند می‌شوند، به طوری که دیگر نوری از خودت به جا نمی‌گذاری."],[572,"مویت از پس تا کمرگه، خوشه‌ای بر خرمن است","زینهار! آن خوشه پنهان کن که خرمن می‌بری","موهای تو از پشت تا کمر، خوشه‌ای شبیه خوشه‌های گندم در خرمن است. مراقب باش! آن خوشه را پنهان کن، زیرا تو در حال بردن خرمن هستی."],[572,"دل به عیاری ببردی ناگهان از دست من","دزد، شب گردد، تو فارغ، روز روشن می‌بری","دل به شیوه‌ای زیرکانه و ناگهانی از من ربوده‌ای، ای دزد عشق، در حالی که شب شده و تو بی‌خبر و آسوده‌ای، ولی روز که روشن شود، تو مسئولیت این کار را به دوش خواهی داشت."],[572,"گر تو برگردیدی از من، بی‌گناه و بی‌سبب","تا مگر من نیز برگردم، غلط، ظن می‌بری","اگر تو بدون هیچ دلیلی از من برگردی، من هم امید دارم که تو به سوی من برگردی، اما فکر نکن که این تصور من نادرست است."],[572,"چون نیاید دود از آن خرمن که آتش می‌زنی","یا ببندد خون از این موضع که سوزن می‌بری","وقتی که از خرمن آتش نمی‌گیرد، یا وقتی که با سوزن به این جای خاصی که خون جاری است، فشار می‌آوری، نشان می‌دهد که این کارها بی‌فایده است و نتیجه‌ای نمی‌دهد."],[572,"این طریق دشمنی باشد نه راه دوستی","کآبروی دوستان در پیش دشمن می‌بری","این رفتار تو نشانه دشمنی است، نه دوستی، زیرا با کارهای خود آبروی دوستانت را در برابر دشمنان به خطر می‌اندازی."],[572,"عیب مسکینی مکن افتان و خیزان در پی‌ات","کآن نمی‌آید تو زنجیرش به گردن می‌بری","نکند در پی عیب‌های مسکینی بیفتی و او را در خطر بیندازی، زیرا این کار به تو نمی‌آید و تو نام او را بر گردن خود می‌گذاری."],[572,"سعدیا گفتار شیرین پیش آن کام و دهان","در به دریا می‌فرستی زر به معدن می‌بری","سعدی، ای کاش تو به جای صحبت شیرین با آن شخص، جواهرات باارزشی را به دریا بفرستی و طلا را به معدن ببرj. در واقع، صحبت با این فرد بی‌فایده‌تر از ارسال زر به جایی غیرقابل دسترس است."],[573,"تو در کمند نیفتاده‌ای و معذوری","از آن به قوت بازوی خویش مغروری","تو به دام نیفتاده‌ای و تحت فشار نیستی، به همین دلیل به قدرت بازوی خودت فخر می‌کنی."],[573,"گر آن که خرمن من سوخت با تو پردازد","میسرت نشود عاشقی و مستوری","اگرچه خرمن معیشتم با تو سوخت و نابود شد، اما عشق و پنهانی‌ام نسبت به تو از بین نمی‌رود و همچنان ادامه دارد."],[573,"بهشت روی من آن لعبت پری رخسار","که در بهشت نباشد به لطف او حوری","بهشت حقیقی برای من آن دختر زیبارویی است که اگرچه در بهشت حوری وجود ندارد، ولی لطف و زیبایی او به اندازه‌ای است که مثل حوری‌ها دلرباست."],[573,"به گریه گفتمش «ای سرو قد سیم اندام»","اگر چه سرو نباشد بر او گل سوری","به او که کوتاه‌تر از سرو و زیباست گفتم: «به خاطر زیبایی‌ات هم که شده، اگرچه تو سرو نیستی، اما بر تو گل‌های سرخ (گل سوری) می‌روید."],[573,"درشت‌خویی و بدعهدی از تو نپسندند","که خوب منظری و دل‌فریب منظوری","افرادی که با تو ارتباط دارند، از بدخلقی و بی‌وفایی تو خوششان نخواهد آمد، زیرا تو چهره‌ی زیبا و دلربایی داری که باید مورد پسند قرار بگیری."],[573,"تو در میان خلایق به چشم اهل نظر","چنان که در شب تاریک پاره نوری","تو در نظر افراد آگاه و با بصیرت، مانند یک تکه نور در شب تاریک هستی."],[573,"اگر به حسن تو باشد طبیب در آفاق","کس از خدای نخواهد شفای رنجوری","اگر زیبایی تو به اندازه‌ای باشد که پزشکان در جهان وجود داشته باشند، هیچ‌کس از خداوند شفای بیماریش را نخواهد خواست."],[573,"ز کبر و ناز چنان می‌کنی به مردم چشم","که بی‌شراب گمان می‌برد که مخموری","به خاطر تکبر و ناز خود如此 رفتار می‌کنی که مردم فکر می‌کنند به خاطر شراب مستی، در حالی که تو در حقیقت مست نیستی."],[573,"من از تو دست نخواهم به بی‌وفایی داشت","تو هر گناه که خواهی بکن که مغفوری","من از تو ناامید هستم و هیچ انتظاری از تو ندارم، زیرا تو هر خطایی که بخواهی را مرتکب می‌شوی و من هم تو را می‌بخشم."],[573,"ز چند گونه سخن رفت و در میان آمد","حدیث عاشقی و مفلسی و مهجوری","در میان سخنان مختلف، بحث درباره عاشقی، بی‌پولی و تنهایی پیش آمد."],[573,"به خنده گفت که «سعدی سخن دراز مکن","میان‌تهی و فراوان‌سخن چو طنبوری»","سخنگو با خنده به سعدی می‌گوید که حرف‌های بی‌محتوا و طولانی نزن، چون مانند طنبور (ساز) سخن بسیار می‌زند اما توخالی است."],[573,"چو سایه هیچ کس است آدمی که هیچش نیست","مرا از این چه که چون آفتاب مشهوری","(ادامه سخن معشوق از بیت قبل:) «انسان بی‌چیز مانند سایه‌ای است که هیچ چیزی از خود ندارد، ولی من از این وضعیت تعجب می‌کنم که چرا همانند آفتاب (ای سعدی) مشهور هستی.» (AI: انسان مانند سایه‌ای است که هیچ چیزی از خود ندارد، ولی من از این وضعیت تعجب می‌کنم که چرا همانند آفتاب مشهور نیستم.)"],[574,"ما بی تو به دل بر نزدیم آب صبوری","چون سنگدلان دل بنهادیم به دوری","ما بدون تو در دل خود، آبی از صبر و شکیبایی نداریم؛ مانند سنگدل‌ها، دل خود را به دوری تو بسته‌ایم و نمی‌توانیم تحمل کنیم."],[574,"بعد از تو که در چشم من آید که به چشمم","گویی همه عالم ظلمات است و تو نوری","وقتی تو در چشم من «نیایی»، گویی که همه دنیا برایم تاریک است و تنها تو نوری هستی که در این تاریکی می‌درخشی."],[574,"خلقی به تو مشتاق و جهانی به تو روشن","ما در تو گریزان و تو از خلق نفوری","مردم به تو علاقه‌مند و جهان به خاطر تو روشن و زیباست، ولی ما از تو دوری می‌کنیم و تو از دیگران نفرت داری."],[574,"جز خط دلاویز تو بر طرف بناگوش","سبزه نشنیدم که دمد بر گل سوری","جز خط زیبای تو که بر لبه گوش سبز قرار دارد، چیز دیگری نشنیده‌ام که در بوی گل سرخ (گل سوری) دمیده شده باشد."],[574,"در باغ رو ای سرو خرامان که خلایق","گویند مگر باغ بهشت است و تو حوری","ای سرو زیبا و خرامان، در باغ رو که مردم می‌گویند این باغ بهشت است و تو مانند حوری هستی."],[574,"روی تو نه روییست کز او صبر توان کرد","لیکن چه کنم گر نکنم صبر ضروری","چهره تو چهره‌ای نیست که بتوانم به خاطر آن صبر کنم، اما چه کار کنم که بدون صبر نمی‌توانم زندگی کنم؛ صبر در این وضعیت برای من لازم و اجتناب‌ناپذیر است."],[574,"سعدی به جفا دست امید از تو ندارد","هم جور تو بهتر که ز روی تو صبوری","سعدی می‌گوید که با مشکلات و سختی‌هایی که از طرف تو می‌رسد، می‌تواند به تو امیدوار باشد، و بهتر است که درد و رنج را تحمل کند تا اینکه با شکیبایی، دوری از چهره تو را تحمل نماید. (AI: سعدی می‌گوید که با مشکلات و سختی‌هایی که از طرف تو می‌رسد، دیگر نمی‌تواند به تو امیدوار باشد، و بهتر است که درد و رنج را تحمل کند تا اینکه به عشق تو دل ببندد.)"],[575,"هر سلطنت که خواهی، می‌کن که دل‌پذیری","در دست خوب‌رویان، دولت بود اسیری","هر نوع سلطنت و قدرتی که بخواهی، به شرطی به دست می‌آید که دلپذیر و خوشایند باشی. در دستان زیبارویان، نعمت و خوشبختی مانند یک اسیر است که به آن‌ها وابسته است."],[575,"جان باختن به کویت، در آرزوی رویت","دانسته‌ام ولیکن، خون‌خوار ناگزیری","من برای دیدن روی تو جانم را فدای کوی تو کرده‌ام و می‌دانم ولی ناچار به دلیری و شجاعت نیاز است که خونم را بریزند."],[575,"ملک آن توست و فرمان، مملوک را چه درمان؟","گر بی‌گنه بسوزی، ور بی‌خطا بگیری","مملکت و سلطنت آن توست و برای من بنده چه راهی وجود دارد؟ حتی اگر بی‌گناه بسوزی یا بی‌خطا مرا مجازات کنی، باز هم من چاره‌ای ندارم."],[575,"گر من سخن نگویم، در وصف روی و مویت","آیینه‌ات بگوید، پنهان که بی‌نظیری","اگر من از زیبایی چهره و موی تو سخن نگویم، خود آینه بهتر از من تو را توصیف خواهد کرد، زیرا قدرت تو در زیبایی بی‌نظیر است و این را پنهان نمی‌توان کرد."],[575,"آن کاو ندیده باشد، گل در میان بستان","شاید که خیره ماند، در ارغوان و خیری","کسی که هرگز گل را در باغ ندیده باشد، ممکن است وقتی آن را ببیند، به زیبایی آن خیره شود و از رنگ‌های آلبالویی و سرخ آن شگفت‌زده شود."],[575,"گفتم مگر ز رفتن، غایب شوی ز چشمم","آن نیستی که رفتی، آنی که در ضمیری","من به او گفتم که اگر برود، از چشمم دور می‌شود، اما او در واقع آن غیابی نیست که من تصور می‌کنم، بلکه او هنوز در ضمیر (دل) من باقی مانده است."],[575,"ای باد صبح بستان! پیغام وصل جانان!","می‌رو که خوش‌نسیمی، می‌دم که خوش‌عبیری","ای باد صبح! تو را به عنوان فرستاده‌ای برای رساندن پیغام وصال معشوق می‌خوانم. برو، چون تو نسیمی دلپذیر هستی که خوشبو می‌وزی و زیبایی را به ارمغان می‌آوری."],[575,"او را نمی‌توان دید، از منتهای خوبی","ما خود نمی‌نماییم، از غایت حقیری","ما نمی‌توانیم معشوق را ببینیم زیرا او به اوج خوبی رسیده است، و ما به خاطر نهایت بزرگی او، نمی‌توانیم خود را نشان دهیم و احساس حقارت می‌کنیم."],[575,"گر یار با جوانان، خواهد نشست و رندان","ما نیز توبه کردیم، از زاهدی و پیری","اگر معشوق به جوانان بپیوندد و با آنها بنشیند، ما نیز از زاهدی و پیری چشم‌پوشی کرده‌ایم و به زندگانی شاداب رندان روی آورده‌ایم و توبه کرده‌ایم."],[575,"سعدی! نظر بپوشان، یا خرقه در میان نه","رندی روا نباشد، در جامه فقیری","سعدی، یا چشمانت را ببند (بر زیبارویان) یا خرقه دربیاور! باید بدانی که رند نمی‌تواند در لباس فقیرانه این‌گونه رفتار کند (جایز نیست رندی در لباس فقرا). / خرقه: غ28 ب2 / رندی: غ11 ب2 / (AI: سعدی، اگر می‌خواهی خود را پنهان کنی یا لباس خود را بپوشانی، باید بدان که نیکوکار نمی‌تواند در لباس فقیرانه رفتار کند.)"],[576,"اگر کلاله مشکین ز رخ براندازی","کنند در قدمت عاشقان سراندازی","اگر موهای سیاه خود را از چهره‌ات بکناری بگذاری، عاشقان در حضورت هم سر به سجده می‌گذارند."],[576,"اگر به رقص درآیی، تو سرو سیم‌اندام","نظاره کن که چه مستی کنند و جانبازی","اگر تو به رقص درآیی، به سروهای بلند و زیبا نگاه کن که چگونه در مستی و جان‌فشانی در عشق رفتار می‌کنند."],[576,"تو با چنین قد و بالا و صورت زیبا","به سرو و لاله و شمشاد و گل نپردازی","تو با این قامت بلند و چهره زیبا نمی‌توانی به زیبایی‌های طبیعت مانند سرو، لاله، شمشاد و گل توجه کنی."],[576,"کدام باغ چو رخسار تو گلی دارد؟","کدام سرو کند با قدت سرافرازی؟","هیچ باغ و گلی نمی‌تواند به زیبایی چهره تو باشد و هیچ سروی نمی‌تواند با قامت بلند تو برابری کند."],[576,"به حسن خال و بناگوش اگر نگاه کنی","نظر، تو با قد و بالای خود نیندازی","اگر به زیبایی خال و گوشه صورت تو خوب توجه کنی، نمی‌توانی به اندام بلند و زیبای خود توجّه کنی."],[576,"غلام باد صبایم، غلام باد صبا","که با کلاله جعدت همی کند بازی","من غلام بادی هستم که از صبح می‌وزد و با موهای حلقه‌حلقه‌ات بازی می‌کند."],[576,"بگوی «مطرب یاران! بیار زمزمه‌ای","بنال بلبل مستان! که بس خوش‌آوازی»","به مطرب دوستان بگو که یک آهنگ شاد و سرمست‌کننده پخش کند تا بلبل (که نماد عشق و زیبایی است) نغمه‌ای بخواند، زیرا صدای او بسیار دلنشین و زیباست."],[576,"که گفته است که «صد دل به غمزه‌ای ببری»؟","هزار صید به یک تاختن بیندازی","سوالی وجود دارد که چه کسی گفته است با یک نگاه زیبا می‌توان صد دل را فریب داد؟ تو می‌توانی با یک بار حمله، هزار شکار را به دام بیندازی."],[576,"ز لطف لفظ شکربار گفته سعدی","شدم غلام همه شاعران شیرازی","از زیبایی و شیرینی واژگان سعدی تحت تاثیر قرار گرفتم و به خدمت همه شاعران شیرازی درآمدم."],[577,"امیدوارم اگر صد رهم بیندازی","که بار دیگرم از روی لطف بنوازی","امیدوارم اگر صد بار هم به دشواری بیفتی، دوباره با محبت به من توجه کنی و به من نیکی کنی."],[577,"چو روزگار نسازد ستیزه نتوان برد","ضرورت است که با روزگار در سازی","وقتی روزگار به تحریک و جدال نمی‌آید، نمی‌توان به جنگ و ستیزه رفت. بنابراین لازم است با روزگار سازگاری و هماهنگی داشته باشی."],[577,"جفای عشق تو بر عقل من همان مثل است","که سرگزیت به کافر همی‌دهد غازی","بیماری عشق تو به عقل من مانند ظلمی است که یک جنگجو به کافر می‌کند؛ یعنی بسیار شدید و سخت است."],[577,"دریغ بازوی تقوا که دست رنگینت","به عقل من به سرانگشت می‌کند بازی","نیکوست که انسان تقوا و دیانت داشته باشد، اما متأسفانه منطق و عقل من را با دستان رنگین تو به سخره می‌گیرد و بازی می‌کند."],[577,"بسی مطالعه کردیم نقش عالم را","ز هر که در نظر آید به حسن ممتازی","بسیار مطالعه کردیم تا ببینیم که عالم چه نقشی دارد و در نظر هر کس، به زیبایی و ویژگی‌های خاصی شناخته می‌شود."],[577,"هزار چون من اگر محنت و بلا بیند","تو را از آن چه که در نعمتی و در نازی","اگر هزار نفر مانند من دچار رنج و درد شوند، تو را از آنچه در خوشی و زیبایی داری، آگاه نخواهم کرد."],[577,"حدیث عشق تو پیدا نکردمی بر خلق","گر آب دیده نکردی به گریه غمازی","درباره عشق تو هیچ خبری به مردم ندادم، مگر اینکه با اشک‌های ریخته‌ام نشان دهندۀ غم و اندوه خودم باشم."],[577,"زهی سوار که صد دل به غمزه‌ای ببری","هزار صید به یک تاختن بیندازی","سوار زیبایی که با یک نگاه و خم ابرویش، صد دل را تحت تأثیر قرار می‌دهد و به راحتی هزار شکار را با یک یورش به دام می‌اندازد."],[577,"تو را چو سعدی اگر بنده‌ای بود چه شود","که در رکاب تو باشد غلام شیرازی","اگر کسی مانند سعدی، که خود بنده‌ای است، در کنار تو باشد چه تفاوتی دارد که غلام (خادم) شهر شیراز باشی."],[577,"گرش به قهر برانی به لطف بازآید","که زر همان بود ار چند بار بگدازی","اگر او را با خشونت برانی، با مهربانی باز خواهد گشت، چون طلا همان طلاست حتی اگر بارها زنگ بزند."],[577,"چو آب می‌رود این پارسی به قوت طبع","نه مرکبیست که از وی سبق برد تازی","زبان فارسی مانند آبی است که به آرامی در حال حرکت است و به نیروی خلاقیت و طبیعت خود ادامه می‌دهد. این زبان آن‌قدر قوی و غنی است که نمی‌توان آن را با زبان عربی مقایسه کرد و از آن سبقت گرفت."],[578,"تو خود به صحبت امثال ما نپردازی","نظر به حال پریشان ما نیندازی","تو خود به گفتگو با افرادی مثل ما نمی‌پردازی و به وضعیت آشفته و ناراحت ما توجهی نمی‌کنی."],[578,"وصال ما و شما دیر متفق گردد","که من اسیر نیازم؛ تو صاحب نازی","دیدار من و تو دیر تحقق می‌یابد، زیرا من به شدت در تلاش برای رسیدن به تو هستم، در حالی که تو خود را در زینت‌های خود مشغول کرده‌ای."],[578,"کجا به صید ملخ، همتت فرو آید","بدین صفت که تو باز بلندپروازی","چرا به دنبال شکار ملخ هستی، در حالی که با این ویژگی‌هایی که داری، تو پرنده‌ای بزرگ و بی‌نظیری هستی که باید به دنبال شکارهای بزرگ‌تر باشی؟"],[578,"به راستی که نه هم‌بازی تو بودم من","تو شوخ‌دیده مگس بین! که می‌کند بازی!","در حقیقت من هیچ وقت در سطح و اندازه تو نبودم. بلکه فقط همانند یک مگس، ادعای باز (پرنده باز) بودن رو در می آوردم. در مصرع اول هم بازی یعنی هم سنگ و هم سطح- در مصرع دوم بازی یعنی مثل باز، مثل پرنده باز. *ی* در بازی در واقع یای نسبیت است."],[578,"ز دست ترک ختایی کسی جفا چندان","نمی‌برد که من از دست ترک شیرازی","کسی از دست ترک چینی (ختایی) آسیب چندانی نمی‌بیند، چون من خود از دست ترک شیرازی (دختران شیراز) بسیار رنج دیده‌ام."],[578,"و گر هلاک منت درخور است باکی نیست","قتیل عشق، شهید است و قاتلش غازی","اگر قرار باشد که در عشق هلاک شوم و این موضوع مورد قبول باشد، هیچ نگرانی ندارم؛ زیرا عاشق کشته‌شده در عشق، مانند شهید است و کسی که او را کشته مانند غازی است که در میدان جنگ می‌جنگد."],[578,"کدام سنگدل است آن که عیب ما گوید","گر آفتاب ببینی چو موم بگدازی","کدام آدم بی‌رحم و بی‌احساس است که عیب‌های ما را به زبان بیاورد، وقتی که تو مانند آفتاب درخشان هستی و او در برابر ذوب می‌شود مثل موم؟"],[578,"میسرت نشود سرّ عشق پوشیدن","که عاقبت بکند رنگ روی غمّازی","عشق را نمی‌توانی به سادگی پنهان کنی، چون در نهایت چهره‌ات حقیقت این غم را نشان خواهد داد."],[578,"چه جرم رفت که با ما سخن نمی‌گویی","چه دشمنیست که با دوستان نمی‌سازی","چرا بگمان می‌آید که چیزی گرفته‌ای و از ما دوری می‌کنی؟ چه مشکلی وجود دارد که با دوستانت صلح نمی‌کنی و صحبت نمی‌کنی؟"],[578,"من از فراق تو بی چاره سیل می‌رانم","مثال ابر بهار و تو خیل می‌تازی","من از دلتنگی و دوری تو، ناچار اشک‌هایم مانند سیل جاری می‌شود، همان‌طور که ابرهای بهار باران می‌بارند، و تو مانند یک لشکر به سمت من حمله‌ور می‌شوی."],[578,"هنوز با همه بدعهدیت دعاگویم","که گر به قهر برانی به لطف بنوازی","با وجود اینکه تو به عهد و پیمانت وفا نکرده‌ای، من هنوز برای تو دعا می‌کنم و امیدوارم که حتی اگر مرا با غضب دور کنی، باز هم با محبت به من نگاه کنی."],[578,"تو همچو صاحب دیوان مکن که سعدی را","به یک ره از نظر خویشتن بیندازی","تو همچون کسی که دارای دیوان (کتاب) است، رفتار نکن که سعدی را یکباره از دید خود حذف کنی و نادیده بگیری."],[579,"تا کی ای آتش سودا به سرم برخیزی؟","تا کی ای ناله زار از جگرم برخیزی؟","ای آتش عشق و اندوه، تا کی در سر و فکر من شعله‌ور خواهی بود؟ و ای ناله غمگین که از دل برمی‌خیزد، تا کی ادامه خواهی داشت؟"],[579,"تا کی ای چشمه سیماب که در چشم منی","از غم دوست به روی چو زرم برخیزی؟","ای چشمه سیماب، که در چشمان من جاری هستی، تا کی باید از غم عشق دوست، بر چهره‌ام مانند طلا (که رنگش از غم به سرخی می‌زند) بنشینی و برآیی؟"],[579,"یک زمان دیده من ره به سوی خواب برد","ای خیال ار شبی از رهگذرم برخیزی","ای خیال، اگر شبی در مسیر من قرار بگیری، باعث می‌شوی که چشمان من خوابشان ببرد و چشمان من به تو روی بیاورند."],[579,"ای دل از بهر چه خونابه شدی در بر من؟","زود باشد که تو نیز از نظرم برخیزی","ای دل، به چه دلیل شکیبایی‌ات به اندازه‌ای دردناک شده است؟ به زودی به حالت اولیه‌ات برمی‌گردی و از نظرم دور نخواهی بود."],[579,"به چه دانش زنی ای مرغ سحر نوبت روز؟","که نه هر صبح به آه سحرم برخیزی","ای مرغ سحر، به چه دانشی می‌خوانی و روز را آغاز می‌کنی؟ زیرا هر صبح لازم نیست که من از خواب بیدار شوم و به صدای تو جواب بدهم."],[579,"ای غم از همنفسی تو ملالم بگرفت","هیچت افتد که خدا را ز سرم برخیزی؟","ای غم، از همراه بودن تو، غصه‌ام زیاد شده است. آیا نمی‌دانی که اگر خداوند از دل من برود، چه بر من می‌گذرد؟"],[580,"گر درون‌سوخته‌ای با تو برآرد نفسی","چه تفاوت کند اندر شکرستان مگسی؟","اگر در دل کسی که سوخته و ناراحت است، نفسی برسد و صدایش را بلند کند، آیا این صدای او در میان شکرستان (مکانی خوشحال و شیرین) تفاوتی با صدای مگس دارد؟ به عبارت دیگر، در شرایط تلخ و غم‌انگیز، صدای غم‌انگیز او هیچ ارزشی ندارد."],[580,"ای که انصاف دل سوختگان می‌ندهی","خود چنین روی نبایست نمودن به کسی","ای کسی که به دل‌سوختگان رحم «نمی‌کنی»، نباید اینگونه به کسی «چهره نشان می‌دادی»."],[580,"روزی اندر قدمت افتم و گر سر برود","به ز من، در سر این واقعه رفتند بسی","اگر روزی به پای تو بیفتم و جانم را از دست بدهم، این درد و اتفاق برای من مهم‌تر از این است که دیگران در این ماجرا جانشان را از دست داده‌اند."],[580,"دامن دوست به دنیا نتوان داد از دست","حیف باشد که دهی دامن گوهر به خسی","نمی‌توان دامن دوست را برای دنیای فانی و بی‌ارزش رها کرد، زیرا این کار نادرست است که دامن یک گوهر باارزش را به کسی بی‌مقدار و بی‌ارزش بدهیم."],[580,"تا به امروز مرا در سخن این سوز نبود","که گرفتار نبودم به کمند هوسی","تا امروز در سخنانم این احساس سوز و اشتیاق وجود نداشت، زیرا به دام عشق و هوس گرفتار نشده بودم."],[580,"چون سراییدن بلبل که خوش آید بر شاخ","لیکن آن سوز ندارد که بود در قفسی","آواز بلبل وقتی که بر شاخه‌های درخت می‌خواند زیباست، اما آن شور و شوقی که در قفس دارد، در این آواز وجود ندارد."],[580,"سعدیا گر ز دل آتش به قلم در نزدی","پس چرا دود به سر می‌رودش هر نفسی؟","سعدی، اگر آتش عشق را با قلم بر روی کاغذ نریزی، پس چرا هر لحظه دودی از دل تو به هوا می‌رود؟"],[581,"همی‌زنم نفس سرد بر امید کسی","که یاد ناورد از من به سال‌ها نفسی","من به یاد کسی که سال‌هاست به یاد من نیست، به ناگاه نفس سرد می‌زنم و ناامید می‌شوم."],[581,"به چشم رحم به رویم نظر همی‌نکند","به دست جور و جفا گوشمال داده بسی","او (شخصی که مورد نظر است) به خاطر رحمی که به من دارد، به من نگاه نمی‌کند و به خاطر ظلم و ستمی که هنوز بر من رفته، بسیار تنبیه شده‌ام."],[581,"دلم ببرد و به جان زینهار می‌ندهد","کسی به شهر شما این کند به جای کسی","دل من را می‌برد و به جانم توجهی ندارد، کسی در شهر شما این کار را به جای کس دیگری انجام می‌دهد."],[581,"به هر چه در نگرم نقش روی او بینم","که دیده در همه عالم بدین صفت هوسی","هر چیزی را که نگاه می‌کنم، تصویر روی او را می‌بینم، زیرا چشمان من در تمام جهان به این گونه خواهان او هستند."],[581,"به دست عشق چه شیر سیه چه مورچه‌ای","به دام هجر چه باز سفید چه مگسی","عشق موجب می‌شود که هر چیزی، چه بزرگ و قوی مانند شیر سیاه و چه کوچک و ضعیف مانند مورچه، به یک اندازه اهمیت داشته باشد. همچنین، فاصله و جدایی می‌تواند هم به بزرگترین چیزها مانند باز سفید و هم به حقیرترین‌ها مانند مگس آسیب برساند."],[581,"عجب مدار ز من روی زرد و ناله زار","که کوه کاه شود گر برد جفای خسی","نباید تعجب کنی از حالتی که من دارم: رنگ زرد و ناله‌های مداوم. زیرا اگر کسی که بی‌رحمی کرده، به من ظلم کند، می‌تواند کوه را هم به کاه تبدیل کند."],[581,"بر آستان وصالت نهاده سر سعدی","بر آستین خیالت نبوده دسترسی","سعدی سرش را بر درگاه وصال محبوب گذاشته و می‌گوید که در خیال تو (محبوب) به دسترسی و رسیدن به تو نرسیده است."],[582,"یار گرفته‌ام بسی، چون تو ندیده‌ام کسی","شمعی چنین نیامده‌ست، از در هیچ مجلسی","یارانی زیادی دارم، اما مانند تو کسی را ندیده‌ام. شمعی به روشنی و زیبایی تو در هیچ مجلسی نیامده است."],[582,"عادت بخت من نبود، آن که تو یادم آوری","نقد چنین کم اوفتد، خاصه به دست مفلسی","عادت بخت من این نیست که کسی مانند تو مرا یاد کند و این‌طور کم‌ارزش به من توجه کند، به‌خصوص در شرایطی که من در وضعیت فقر و نیازمندی هستم."],[582,"صحبت از این شریف‌تر صورت از این لطیف‌تر","دامن از این نظیف‌تر، وصف تو چون کند کسی","هیچ‌کس نمی‌تواند مانند تو که بهترین و زیباترین هستی، تو را توصیف کند و از صفات خوبت بگوید."],[582,"خادمه سرای را، گو در حجره بند کن","تا به سر حضور ما، ره نبرد موسوسی","خدمت‌کار خانه را بگو در اتاق را ببندد تا کسی مانند موسى به سر ما نیاید. موسى در اینجا اشاره به داستانی است که او را بخاطر شگفتی‌هایش می‌شناسند."],[582,"روز وصال دوستان، دل نرود به بوستان","یا به گلی نگه کند، یا به جمال نرگسی","در روزی که دوستان با هم دیدار می‌کنند، دل آدم به سراغ گل و باغ نمی‌رود و نه به زیبایی گلی یا نرگسی توجه می‌کند، چرا که شادی و لذت دیدار دوستان آنقدر مهم است که همه چیز را تحت‌الشعاع خود قرار می‌دهد."],[582,"گر بکشی کجا روم، تن به قضا نهاده‌ام","سنگ جفای دوستان، درد نمی‌کند بسی","اگر مرا بکشید، نمی‌دانم کجا بروم، چون به تقدیر خود رضایت داده‌ام. درد سنگینی جفا و بی‌وفایی دوستان برایم خیلی آزاردهنده نیست."],[582,"قصه به هر که می‌برم، فایده‌ای نمی‌دهد","مشکل درد عشق را، حل نکند مهندسی","هر بار که داستان درد و رنج عشق را برای کسی تعریف می‌کنم، هیچ سودی ندارد و هیچ‌کس نمی‌تواند به من در حل این مشکل کمک کند."],[582,"این همه خار می‌خورد، سعدی و بار می‌برد","جای دگر نمی‌رود، هر که گرفت مونسی","سعدی در این بیت می‌گوید که او به خاطر عشق و احساساتش مشکلات و دردهای زیادی را تحمل می‌کند، اما با این حال، نمی‌تواند از این عشق دور شود و پایبند به آن است. هرکسی که چنین احساسی پیدا کند، نمی‌تواند از کنار محبوبش برود و او را ترک کند."],[583,"ما سپر انداختیم گر تو کمان می‌کشی","گو دل ما خوش مباش گر تو بدین دلخوشی","ما تسلیم شده‌ایم، هرچند تو می‌خواهی به ما آسیب برسانی. بگو تا دلخوش نباشیم، اگر خوشحالی تو به این است. (AI: ما تسلیم شده‌ایم، هرچند تو می‌خواهی به ما آسیب برسانی. خوشحال نباش که به این خیال خوشی دلخوشی، زیرا ما از این وضعیت راضی نیستیم.)"],[583,"گر بکشی بنده‌ایم ور بنوازی رواست","ما به تو مستأنسیم تو به چه مستوحشی","اگر ما را بکشی، ما بنده تو هستیم و در صورت محبت تو نیز برای ما اشکالی ندارد. ما به تو عادت کرده‌ایم، اما تو چرا چنین بی‌قرار و ناآرامی؟"],[583,"گفتی اگر درد عشق پای نداری گریز","چون بتوانم گریخت تا تو کمندم کشی؟","گفتی: اگر نمی‌توانی درد عشق را تحمل کنی، برو! چگونه می‌توانم فرار کنم در حالی که کمندم را می‌کشی؟ (AI: اگر نمی‌توانی درد عشق را تحمل کنی، برو. چون اگر بخواهم، می‌توانم از تو دور شوم تا تو به دامم نیفتی.)"],[583,"دیده فرودوختیم تا نه به دوزخ برد","باز نگه می‌کنم، سخت بهشتی‌وشی","چشم‌هایم را بستم تا به جهنم نروم ولی دوباره که نگاه می‌کنم تو صورتی بهشتی داری. (AI: چشم‌هایم را گشودم تا به جهنم نروم و به دقت به بهشت نگاه می‌کنم.)"],[583,"غایت خوبی که هست، قبضه و شمشیر و دست","خلق حسد می‌برند، چون تو مرا می‌کشی","خوبی‌ها و فضیلت‌هایی که وجود دارد، مانند شمشیر و دست افرادی هستند که نسبت به آن حسادت می‌ورزند، زیرا تو مستقیما به من آسیب می‌زنی."],[583,"موجب فریاد ما، خصم نداند که چیست","چاره مجروح عشق، نیست به‌جز خامشی","سبب فریاد و شکایت ما مشخص نیست و دشمن نمی‌داند که درمان درد و زخم عشق چه چیزی است؛ تنها راه حل، سکوت کردن است."],[583,"چند توان ای سلیم، آب بر آتش زدن","کآب دیانت برد، رنگ رخ آتشی","سلیم، چند بار می‌توانی تلاش کنی که آتش عشق را با آب سست کنی؟ آب دیانت می‌تواند غم و غصه را از چهره عاشق دور کند، اما نمی‌تواند چهره آتشین او را تغییر دهد."],[583,"آدمی هوشمند، عیش ندارد ز فکر","ساقی مجلس بیار، آن قدح بی‌‌هشی","انسان خردمند نمی‌تواند از افکار و نگرانی‌های خود لذت ببرد، بنابراین ای ساقی، آن جام بی‌خیالی را بیاور تا بتوانم خوش بگذرانم."],[583,"مست می عشق را عیب مکن سعدیا","مست بیفتی تو نیز، گر هم از این می‌ چشی","سعدی می‌گوید که در عشق، انسان‌هایی که در حال شرب هستند (مست می‌باشند) را مورد قضاوت قرار ندهید، چون خودتم اگر از این عشق بچشی، مست می‌شوی و همین حال را تجربه می‌کنی."],[584,"هرگز آن دل بنمیرد که تو جانش باشی","نیکبخت آن که تو در هر دو جهانش باشی","دل هرگز نمی‌میرد اگر تو زندگی‌بخش آن باشی. خوشبخت کسی است که تو در هر دو جهان، یعنی در این دنیا و آن دنیا، در کنار او باشی."],[584,"غم و اندیشه در آن دایره هرگز نرود","به حقیقت که تو چون نقطه میانش باشی","غم و اندوه به دایره زندگی کسی نمی‌تواند راه پیدا کند، زیرا تو مانند نقطه‌ای در وسط آن هستی و وجودت باعث می‌شود که همواره خوشی و آرامش در زندگی‌اش برقرار باشد."],[584,"هرگزش باد صبا برگ پریشان نکند","بوستانی که چو تو سرو روانش باشی","هرگز باد صبا، یعنی نسیم صبحگاهی، بوستانی را که تو همچون درخت سرو در آن هستی، پریشان نخواهد کرد. این به معنای آن است که وجود تو باعث استحکام و زیبایی این بوستان است و هیچ چیز نمی‌تواند آن را خراب کند."],[584,"همه عالم نگران تا نظر بخت بلند","بر که افتد که تو یک دم نگرانش باشی","تمام جهان نگران هستند تا ببینند این بخت بلند بر روی کی می‌افتد، چراکه تنها با یک لحظه توجه تو به آن شخص، همه چیز دگرگون می‌شود."],[584,"تشنگانت به لب ای چشمه حیوان مردند","تشنه‌تر آن که تو نزدیک دهانش باشی","عاشقانی که به محبت تو امیدوارند، حتی در اصل خود به لب رسیده‌اند و جان داده‌اند؛ اما آن کس که تو به او نزدیک‌تر هستی، بیشتر از همه تشنه است و بی‌تابی می‌کند."],[584,"گر توان بود که دور فلک از سر گیرند","تو دگر نادره دور زمانش باشی","اگر ممکن بود که دور زمان را از سر مردم بردارند، تو باید نادره و منحصر به فرد باشی که در این زمان حضور داری."],[584,"وصفت آن نیست که در وهم سخندان گنجد","ور کسی گفت مگر هم تو زبانش باشی","تو را نمی‌توان با کلمات و تصورهای عادی توصیف کرد؛ حتی اگر کسی بخواهد تو را به زبان آورد، صحبتش به تو نمی‌رسد و نمی‌تواند حقیقت تو را بیان کند."],[584,"چون تحمل نکند بار فراق تو کسی","با همه درد دل آسایش جانش باشی","وقتی کسی نمی‌تواند درد جدایی از تو را تحمل کند، علیرغم همه‌ی رنج‌هایی که دارد، باید آرامش و آسایش را در دلش پیدا کند."],[584,"ای که بی دوست به سر می‌نتوانی که بری","شاید ار محتمل بار گرانش باشی","ای کسی که بدون دوست نمی‌توانی زندگی کنی، ممکن است که دوستت بار سنگینی برایت به همراه داشته باشد."],[584,"سعدی آن روز که غوغای قیامت باشد","چشم دارد که تو منظور نهانش باشی","سعدی در روز قیامت، امید دارد که تو (دوست یا محبوبش) مورد توجه و مقصود پنهان او باشی."],[585,"اگر تو پرده بر این زلف و رخ نمی‌پوشی","به هتک پرده صاحب‌دلان همی‌کوشی","اگر تو جلوی این زلف و چهره‌ات را نمی‌پوشانی، در واقع به حرمت و وقار دل‌باختگان نیز آسیب می‌زنی."],[585,"چنین قیامت و قامت ندیده‌ام همه عمر","تو سرو یا بدنی، شمس یا بناگوشی؟!","من در تمام عمرم چنین زیبایی و اندامی را ندیده‌ام؛ آیا تو مانند درخت سرو زیبایی یا چهره‌ای مانند آفتاب داری، یا به زیبایی گوشواره‌ای هستی؟"],[585,"غلام حلقه سیمین گوشوار توام","که پادشاه غلامان حلقه‌درگوشی","من غلام حلقه گوشواره تو هستم و انگار که پادشاهی هستم که به خاطر این حلقه، به تو وابسته‌ام."],[585,"به کنج خلوت پاکان و پارسایان آی","نظاره کن که چه مستی کنند و مدهوشی","به محفل و گوشه‌نشینی روحانیون و افراد پاک طینت برو و ببین که آنان چگونه در حال سرخوشی و بی‌هوشی هستند."],[585,"به روزگار عزیزان که یاد می‌کنمت","علی الدّوام نه یادی پس از فراموشی","در زمان عزیزان و دوستانم، همیشه به یاد تو هستم و فراموش نمی‌کنم."],[585,"چنان موافق طبع منی و در دل من","نشسته‌ای که گمان می‌برم در آغوشی","تو آن‌قدر به روحیه و ذوق من نزدیک و هماهنگ هستی و آن‌چنان در دل من جا داری که فکر می‌کنم در آغوش من هستی."],[585,"چه نیکبخت کسانی که با تو هم‌سخنند","مرا نه زهره گفت و نه صبر خاموشی","کسانی که با تو صحبت می‌کنند خوشبختند، زیرا من نه قدرت گفتن دارم و نه صبر و توانایی سکوت کردن."],[585,"رقیب نامتناسب چه اهل صحبت توست","که طبع او همه نیش و تو سربه‌سر نوشی","رقیب ناپسند چقدر در کنار تو نشسته است، در حالی که روح و طبع او تماما خشم و آزار است و تو همیشه در صلح و آرامش به سر می‌بری."],[585,"به تربیت به چمن گفتم ای نسیم صبا","بگوی تا ندهد گل به خار چاووشی","به نسیم صبح گفتم تا به گل اطلاع دهد که به خارها جفا نکند و از آن‌ها دوری کند."],[585,"تو سوز سینه مستان ندیدی ای هشیار","چو آتشیت نباشد چگونه برجوشی؟","ای هشیار، تو سوز دل و شوق مستان را ندیده‌ای. اگر در وجودت آتش عشق نباشد، چگونه می‌توانی شور و هیجان را احساس کنی؟"],[585,"تو را که دل نبود، عاشقی چه دانی چیست؟","تو را که سمع نباشد سماع ننیوشی","کسی که دل ندارد، چه می‌داند عاشقی چیست؟ و کسی که گوش ندارد، چگونه می‌تواند صدای خوش (سماع) را بشنود؟"],[585,"وفای یار به دنیا و دین مده سعدی","دریغ باشد یوسف به هرچه بفروشی","سعدی می‌گوید وفای معشوق به دنیا و دین، ارزشی ندارد و اگر یوسف (نیکوخصال واقعی) را به چیزی بفروشی، این کار بی‌فایده است."],[586,"به پایان آمد این دفتر حکایت همچنان باقی","به صد دفتر نشاید گفت حسب‌الحال مشتاقی","این دفتر به پایان رسید؛ اما داستان همچنان ادامه دارد. نمی‌توان حالتی که مشتاق دارد را در صدها دفتر شرح داد."],[586,"کتاب بالغ منّی حبیبا معرضا عنّی","أن افعل ما تری إنّي علی عهدی و میثاقی","نامه ای است از من به دوستی که از من گریزان است / هر چه می خواهی، انجام بده؛ قطعا من بر عهد و پیمان خود هستم."],[586,"نگویم نسبتی دارم به نزدیکان درگاهت","که خود را بر تو می‌بندم به سالوسیّ و زرّاقی","ادعا نمی‌کنم که تز نزدیکان درگاه تو ام دارم. با ریا و فریبکاری خودم را به تو چسبانده‌ام."],[586,"أخلّائی و أحبابی ذروا من حبّه مابی","مریض العشق لا یبری و لا یشکو إلی الرّاقی","دوستان و یارانم مرا رها کنید در باره آنچه از دوستی او به من رسیده است (یعنی سرزنشم نکنید که با این دوستی چه به روزم آمده) بیمار عشق نه بهبود می یابد و نه به پادزهر پناه می برد."],[586,"نشان عاشق آن باشد که شب با روز پیوندد","تو را گر خواب می‌گیرد نه صاحب درد عشاقی","از نشانه‌های آن که کسی عاشق واقعی است، این است که شب را به روز پیوند می‌زند. یعنی سرتاسر شب را تا زمانی که روز شود بیدار است و خوابش نمی‌برد. اگر تو زا خواب می‌گیرد و می‌توانی بخوابی، بدان که درد عاشقان در تو نیست و عاشق نیستی"],[586,"قم املأ و اسقنی کأسا و دع ما فیه مسموما","أما أنت الّذی تسقی فعین السّمّ تریاقی","برخیز و جام را پر کن و از آن به من بنوشان و کار نداشته باش که آنچه در جام است سمی است اگر تو ساقی و نوشاننده باشی سم و زهر عینا پادزهر است."],[586,"قدح چون دور ما باشد به هشیاران مجلس ده","مرا بگذار تا حیران بماند چشم در ساقی","اگر در بزم دور باده‌نوشی، نوبت به من رسید، نوبت من را به کسانی بده که هنوز هوشیارند و مست نیستند. مرا رها کن که می‌خواهم چشمم در ساقی حیران بماند. (با دیدن ساقی مستم و نیاز به این قدح ندارم‌! سهم مرا به کسی دیگر بده!)"],[586,"سعی فی هتکی الشّانی و لمّا یدر ما شانی","أنا المجنون لا أعبا بإحراق و إغراق","دشمنم در بی آبرو کردن من کوشید در حالی که از کار/منزلت من بی خبر است / من دیوانه ام و از سوزاندن و غرق کردن باکی ندارم."],[586,"مگر شمس فلک باشد بدین فرخنده دیداری","مگر نفس ملک باشد بدین پاکیزه اخلاقی","کسی که دیدار او تا این حد فرخنده و خجسته است، حتما که خورشید آسمان است! کسی که این قدر پاکیزه اخلاق است، حتما خود فرشته است"],[586,"لقیت الأسد فی الغابات لا تقوی علی صیدی","و هذا الظّبی فی شیراز یسبینی بأحداق","شیرهای زیادی را در بیشه ها دیدم که نتوانستند مرا به دام اندازند و این بچه آهو در شیراز با حدقه های چشمش مرا اسیر کرد. (حدقه کمانی چشم را به کمند تشبیه کرده که همین شکلی است)."],[586,"نه حسنت آخری دارد نه سعدی را سخن پایان","بمیرد تشنه مستسقی و دریا همچنان باقی","مستسقی شخصی که بیماری تشنگی دارد و هرچه آب بخورد باز تشنه تر می شود . سعدی می گوید نه حسن تو تمامی دارد و نه سخن سعدی در وصف حسن تو تمام شدنی است بلکه سعدی چونان تشنه ای است که آب گوارای وصف کردن تو را اینقدر می نوشد تا بمیرد ولی دریای حسن تو به جای خود باقی است."],[587,"به قلم راست نیاید صفت مشتاقی","سادتی احترق القلب من الاشواق","احساسات یک عاشق به قدری عمیق و سوزان است که با قلم نمی‌توان آن را به درستی توصیف کرد و دل عاشق از شدت اشتیاق می‌سوزد."],[587,"نشود دفتر درد دل مجروح تمام","لو اضافوا صحف الدّهر الی اوراقی","دفتر درد دل مجروح هرگز تمام نخواهد شد، اگر صفحات زمان را به ورق‌های دیگر اضافه کنند، یعنی مشکلات و آلام دلش نه تنها پایان نمی‌یابد بلکه به تعداد ورق‌ها افزوده می‌شود."],[587,"آرزوی دل خلقی تو به شیرین سخنی","اثر رحمت حقی تو به نیک اخلاقی","آرزوی دل مردم به لطف و شیرینی کلام توست و اثر رحمت واقعی تو در رفتار نیکو و اخلاق پسندیده‌ات نمایان است."],[587,"بی عزیزان چه تمتع بود از عمر عزیز","کیف یحلو زمن البین لدی العشّاق؟","بدون وجود محبوبان، از عمر باارزش چه لذتی می‌توان برد؟ چگونه می‌تواند برای عاشقان زمان جدایی خوشایند باشد؟"],[587,"من همان عاشقم ار زان که تو آن دوست نه‌ای","انا اهواک و ان ملت عن المیثاق","من همان عاشقم، حتی اگر تو آن دوستی نباشی که باید باشی. من به تو عشق می‌ورزم و اگر از پیمانی که بین ما بود، منحرف شوی، عشق من به تو تغییر نمی‌کند."],[587,"حیث لا تخلف منظور؟ حبیبی ارنی","چه کنم؟ قصه این غصه کنم در باقی","ای محبوب، در جایی که دیگران نمی‌توانند فریب دهند، چه کاری باید انجام دهم؟ آیا می‌توانی راهی نشان دهی تا این غم را در باقی عمرم بگویم؟"],[587,"به دو چشم تو که گر بی تو برندم به بهشت","نکنم میل به حوران و نظر با ساقی","چشم‌ها و زیبایی تو برای من آن‌قدر ارزشمند است که حتی اگر به بهشت بروم و با حوریان و ساقی هم روبه‌رو شوم، باز هم تمایلی به آن‌ها نخواهم داشت."],[587,"سعدی از دست غمت چاک زده دامن عمر","بیشتر زین نکند صابری و مشتاقی","سعدی به خاطر غم تو، عمرش را می‌کند و نمی‌تواند تاب بیاورد؛ پس دیگر صبر و انتظار برایش مفهومی ندارد."],[588,"عمرم به آخر آمد عشقم هنوز باقی","وز می چنان نه مستم کز عشق روی ساقی","عمر من به پایان رسیده است، اما عشق من به تو همچنان باقی است. از شراب هم به قدری مست نیستم که از عشق زیبایی تو غافل شوم."],[588,"یا غایة الأمانی قلبی لدیک فانی","شخصی کما ترانی من غایة اشتیاقی","ای آن‌که همه آرزوهایم تویی، دل من در پیش تو از بین رفته است. من مانند تو را در اوج اشتیاق می‌بینم."],[588,"ای دردمند مفتون بر خد و خال موزون","قدر وصالش اکنون دانی که در فراقی","ای کسی که آنقدر گرفتار زیبایی‌های چهره‌ات هستم که از درد و رنج‌های عشق رنج می‌برم، آیا حالا که در دوری او هستی، می‌دانی چه آلامی را تحمل می‌کنم؟"],[588,"یا سعد کیف صرنا فی بلدة؟ هجرنا","من بعد ما سهرنا و الایدی فی العناق","ای سعدی، حال ما چطور شده است که در این دیار قرار گرفته‌ایم؟ ما بعد از شب‌زنده‌داری‌امان و در آغوش گرفتن یکدیگر، از آنجا جدا شده‌ایم."],[588,"بعد از عراق جایی خوش نایدم هوایی","مطرب بزن نوایی زان پرده عراقی","پس از تجربه زمانه در عراق، جایی را نمی‌آورم که از آنجا خوش‌تر باشد. بیایید، ای سازندگان، نوا و آواز شادی‌بخش بزنید تا از آن پرده عراقی لذت ببریم."],[588,"خان الزّمان عهدی حتّی بقیت وحدی","ردّوا علیّ ودّی بالله یا رفاقی","زمانه به من خیانت کرد و من تنها ماندم. ای دوستان، خواهش می‌کنم محبت و دوستی‌ام را برگردانید."],[588,"در سرو و مه چه گویی ای مجمع نکویی","تو ماه مشکبویی تو سرو سیم ساقی","ای کسی که به زیبایی‌های سرو و ماه می‌پردازی، درباره قدمت و زیبایت چه بگویم؟ تو همان مظهر زیبایی هستی که مانند ماه درخشانی و مانند سروی با قامت زیبا، خوش‌اندام و دلربا هستی."],[588,"ان متّ فی هواها دعنی امت فداها","یا عاذلی نباها ذرنی و ما الاقی","اگر در عشق او بمیرم، بگذار بمیریم و برای او آماده‌ام، ای پنددهنده، دیگر در کار من دخالت نکن و بگذار هر چه می‌خواهم انجام دهم."],[588,"چند از حدیث آنان خیزید ای جوانان","تا در هوای جانان بازیم عمر باقی","ای جوانان، بیایید از سخنان عاشقان گذشته بیاموزید و در گرایش به معشوق، تمام عمر خود را بگذرانید."],[588,"قام الغیاث لمّا زمّ الجمال زمّا","و اللّیل مدلهمّا و الدّمع فی المآقی","در این بیت، شاعر از موقعیتی بحرانی سخن می‌گوید که وقتی صحنه‌ای سخت و تیره پیش آمده، یاری و کمک الهی مورد نیاز است. سپس شب را به عنوان نمادی از تاریکی و مشکلات و نیز اشک‌ها را به عنوان نمایانگر غم و اندوه به تصویر می‌کشد."],[588,"تا در میان نیاری بیگانه‌ای نه یاری","درباز هر چه داری گر مرد اتفاقی","اگر در میانه کار، کسی غریبه‌ای بی‌حس و حال باشد، یاری نمی‌کند و هر چه داشته باشی نیز کمکی نخواهد کرد، چه دنیا پر از دشواری‌ها و اتفاقات ناگهانی است."],[589,"دل دیوانگی‌ام هست و سر ناباکی","که نه کاری‌ست شکیبایی و اندهناکی","من در حالتی از دیوانگی و سرکشی هستم و این وضعیت به قدری دشوار است که دیگر نمی‌توانم صبر کنم یا غم را تحمل کنم."],[589,"سر به خمخانه تشنیع فرو خواهم برد","خرقه گو در بر من دست بشوی از پاکی","من می‌خواهم به میخانه‌ای بروم که در آن از سرزنش‌ها و عیب‌جویی‌ها خبری نیست. تو هم بگذار تا در زمره پاکان باشم و لباس ملامت برتن ننموده و از بیکسی آزاد باشم."],[589,"دست در دل کن و هر پرده پندار که هست","بدر ای سینه که از دست ملامت چاکی","دل خود را به دست بگیر و هر پرده‌ای که در ذهنت وجود دارد، کنار بزن. ای سینه، تو که به خاطر ملامت دیگران پاره شده‌ای، ملامت را نپذیر."],[589,"تا به نخجیر دل سوختگان کردی میل","هر زمان بسته دلی سوخته بر فتراکی","هرچند در جستجوی دل‌هایی که سوخته‌اند، به شکار می‌رفتی، ولی همیشه دل شکسته‌ای، که بر زخم‌هایش نگریسته شده، آماده و منتظر توست."],[589,"أنت ریّان و کم حولک قلب صاد","أنت فرحان و کم نحوک طرف باکی","تو سیراب و شاداب هستی و دور و بر تو دل‌های تشنه و غمگینی هستند که به تو توجه دارند و در کنار تو حضور دارند."],[589,"یا رب آن آب حیات است بدان شیرینی؟","یا رب آن سرو روان است بدان چالاکی؟","ای خدا، آیا آن آب حیات که اینقدر شیرین است، واقعا وجود دارد؟ یا آن سرو روان که این قدر چابک و متحرک است، حقیقت دارد؟"],[589,"جامه‌ای پهن‌تر از کارگه امکانی","لقمه‌ای بیشتر از حوصله ادراکی","آدمی به چیزی نیاز دارد که از امکانات فراتر باشد و چیزهای بیشتری از آنچه که می‌تواند درک کند، به دست آورد."],[589,"در شکنج سر زلف تو دریغا دل من","که گرفتار دو مار است بدین ضحّاکی","دل من در چنگال و اسارت دو مار قرار دارد که در موهای تاب‌دار تو پیچیده شده است. در اینجا \"ضحّاک\" به معنای ظالم و ستمگر است که به شخصیت افسانه‌ای ضحاک اشاره دارد، کسی که همیشه در حال آسیب رساندن به دیگران است."],[589,"آه من باد به گوش تو رساند؟ هرگز!","که نه ما بر سر خاکیم و تو بر افلاکی","ناله و آه من هرگز به سرعت به گوش تو نمی‌رسد؛ زیرا ما در زمین و در جهان خاکی زندگی می‌کنیم، اما تو در آسمان‌ها و در جهانی بالاتر از ما هستی."],[589,"الغیاث از تو که هم دردی و هم درمانی","زینهار از تو که هم زهری و هم تریاکی","ای یاری که هم درد و هم درمان منی، از تو می‌خواهم که دوری، چراکه هم سمّی و هم دارویی."],[589,"سعدیا آتش سودای تو را آبی بس","باد بی‌فایده مفروش که مشتی خاکی","سعدی، عشق و اشتیاق تو مانند آتش است و آبی می‌تواند آن را خاموش کند. بنابراین نباید وقت و انرژی‌ات را برای چیزهای بی‌فایده و سطحی هدر بدهی، چرا که در نهایت، همه چیز به خاک و نابودی ختم می‌شود. (AI: سعدی، عشق و اشتیاق تو مانند آتش است و هیچ آبی نمی‌تواند آن را خاموش کند. بنابراین نباید وقت و انرژی‌ات را برای چیزهای بی‌فایده و سطحی هدر بدهی، چرا که در نهایت، همه چیز به خاک و نابودی ختم می‌شود.)"],[590,"عشق جانان در جهان هرگز نبودی کاشکی","یا چو بود اندر دلم کمتر فزودی کاشکی","عشق محبوب در دنیا هرگز وجود نداشت، ای کاش اگر هم بود، در دل من کمتر شدت می‌یافت."],[590,"آزمودم درد و داغ عشق باری صد هزار","همچو من معشوقه یک ره آزمودی کاشکی","در درد و رنج عشق، بارها و بارها خود را آزمودم، ولی ای کاش معشوقه‌ای هم به اندازه من یک بار امتحان می‌کرد."],[590,"نغنویدم زان خیالش را نمی‌بینم به خواب","دیده گریان من یک شب غنودی کاشکی","من نمی‌توانم به خواب آن خیالی که در سر دارم، نگاه کنم، زیرا خواب من بر اثر اشک‌هایم پر از ناراحتی است و ای کاش یک شب خواب خوشی می‌دیدم."],[590,"از چه ننماید به من دیدار خویش آن دل‌فروز","راضیم راضی چنان روی ار نمودی کاشکی","چرا آن محبوب دل‌فروز خود را به من نشان نمی‌دهد؟ اگر او روی زیبا و دل‌انگیزش را نشان می‌داد، من چقدر خوشحال می‌شدم."],[590,"هر زمان گویم ز داغ عشق و تیمار فراق","دل ربود از من نگارم جان ربودی کاشکی","هر بار که از غم عشق و رنج جدایی سخن می‌گویم، معشوقم (نگار) دل مرا می‌گیرد و جانم را می‌ستاند. کاش که او این موضوع را درک کند و اهمیتی به آن بدهد."],[590,"ناله‌های زار من شاید که گر کس نشنود","لابه‌های زار من یک شب شنودی کاشکی","شاید کسی ناله‌ها و گریه‌های من را نشنود، اما ای کاش یک شب صدای لابه‌های غمگین من را بشنوی."],[590,"سعدی از جان می‌خورد سوگند و می‌گوید به دل","وعده‌هایش را وفا باری نمودی کاشکی","سعدی با تمام وجود به وعده‌های دلش قسم می‌خورد و آرزو می‌کند که این وعده‌ها را واقعی می‌کردی."],[591,"سخت زیبا می‌روی یک‌بارگی","در تو حیران می‌شود نظّارگی","هنگامی که تو به زیبایی و شگفتی ظاهر می‌شوی، ناظر به یکباره و به شدت حیرت‌زده می‌شود."],[591,"این‌چنین رخ با پری باید نمود","تا بیاموزد پری رخسارگی","صورت زیبای تو باید این‌گونه باشد تا دیگران یاد بگیرند که چگونه باید زیبایی را به نمایش بگذارند."],[591,"هرکه را پیش تو پای از جای رفت","زیر بارش برنخیزد بارگی","هر کسی که در حضورت از جای خود بجهد و شتاب‌زده شود، زیر فشار عشق تو نمی‌تواند به راحتی از عهده آن برآید و تحمل کند."],[591,"چشم‌های نیم‌خوابت سال و ماه","همچو من مستند بی میخوارگی","چشم‌های خواب‌آلود و نیمه‌باز تو مانند حال من هستند که به خاطر نوشیدن شراب مست شده‌اند، بی‌آنکه شرابی نوشیده باشند."],[591,"خستگانت را شکیبایی نماند","یا دوا کن یا بکش یک‌بارگی","خستگی و ناامیدی تو را تاب نیاورده است؛ یا به تو کمک می‌کنم و دردهایت را درمان می‌کنم، یا این که یک‌بار برای همیشه از رنج و عذاب نجاتت می‌دهم."],[591,"دوست تا خواهی به‌جای ما نکوست","در حسودان اوفتاد آوارگی","دوست اگر بخواهد، می‌تواند به جای ما رفتار نیکو و شایسته‌ای داشته باشد، اما در میان حسودان، او نیز مانند ما به درگیری و پریشانی دچار می‌شود."],[591,"سعدیا تسلیم فرمان شو که نیست","چاره عاشق به‌جز بیچارگی","ای سعدی، تسلیم فرمان عشق شو، زیرا برای عاشق چاره‌ای جز بیچارگی و رنج وجود ندارد."],[592,"روی بپوش ای قمر خانگی","تا نکشد عقل به دیوانگی","ای قمر خانگی، روی خود را بپوشان تا عقل آدمی به دیوانگی نرود."],[592,"بلعجبی‌های خیالت ببست","چشم خردمندی و فرزانگی","عجیب است که خیال تو چنان مرا فریفته که عقل و خردم را کور کرده و از بین برده است."],[592,"با تو بباشم به کدام آبروی","یا بگریزم به چه مردانگی","نمی‌دانم با چه آبرو و شأنی در کنار تو باشم یا اینکه به کدام شجاعت و بزرگی فرار کنم."],[592,"با تو برآمیختنم آرزوست","وز همه کس وحشت و بیگانگی","آرزومندم که با تو آمیخته شوم، اما از دیگران ترس و بیگانگی دارم."],[592,"پرده برانداز شبی شمع وار","تا همه سوزیم به پروانگی","به شب، پرده را کنار بزن تا مانند شمع بسوزیم و عاشقانه زندگی کنیم، مانند پروانه‌هایی که به دور شمع می‌چرخند."],[592,"یا ببرد خانه سعدی خیال","یا ببرد دوست به همخانگی","خواب و خیال، یا دوست به دیدار و هم‌نشینی، مرا به خانه سعدی می‌برد."],[593,"بسم از هوا گرفتن که پری نماند و بالی","به کجا روم ز دستت؟ که نمی‌دهی مجالی","دیگر توان خود را از دست داده‌­ام و پر و بالی برای من باقی نمانده است، از دست تو چگونه می‌­توانم بگریزم؟ وقتی به این اسیر عشق هیچ فرصت و مجالی نمی­‌دهی!"],[593,"نه ره گریز دارم نه طریق آشنایی","چه غم اوفتاده‌ای را که تواند احتیالی؟","انسان عاشق و درمانده‌­ای که چاره‌­ای داشته باشد، هیچ اندوهی ندارد، اما من نه راه فرار از عشقت را دارم و نه می­‌توانم راهی جهت دوستی و آشنایی با تو بیابم."],[593,"همه عمر در فراقت بگذشت و سهل باشد","اگر احتمال دارد به قیامت اتصالی","تمام عمر و روزگار زندگی­‌ام در دوری از تو گذشت، اما اگر هنوز احتمال دارد که در قیامت به وصال تو برسم، تحمل آن (سپری شدن عمر) همچنان آسان است."],[593,"چه خوش است در فراقی همه عمر صبر کردن","به امید آن که روزی به کف اوفتد وصالی","اگر آدمی امید داشته باشد که بالاخره روزی به وصال معشوق خواهد رسید به راستی بسیار زیبا و دلنشین است که تمام عمرش در دوری از معشوق، صبور و شکیبا باشد(تمام عمر بار فراق را تحمل کند)."],[593,"به تو حاصلی ندارد غم روزگار گفتن","که شبی نخفته باشی به درازنای سالی","تویی که نتوانسته­‌ای شبی را که بلندای آن به طول یک سال است، بیدار باشی، چه نتیجه­‌ای دارد که از غم روزگار برایت بگویم."],[593,"غم حال دردمندان نه عجب گرت نباشد","که چنین نرفته باشد همه عمر بر تو حالی","عجیب نیست اگر نسبت به حال انسان­‌های عاشق بی­‌تفاوت هستی و غم آنها را نمی­‌خوری، چرا که در تمام عمر چنین حالی را تجربه نکرده­‌ای."],[593,"سخنی بگوی با من که چنان اسیر عشقم","که به خویشتن ندارم ز وجودت اشتغالی","با من حرفی بزن که چنان در دام محبت تو گرفتار آمده‌­ام و چنان سرگرم و مشغول تو هستم که دیگر یادی از خویشتن نمی­‌کنم."],[593,"چه نشینی ای قیامت؟ بنمای سرو قامت","به خلاف سرو بستان که ندارد اعتدالی","ای قیامت (=معشوق) چرا نشسته­‌ای؟ برخیز و نشان بده قامت بلند و متناسب خود را ، قامتی که سراسر متناسب و به اندام است، برخلاف سرو بوستان که هیچگونه تناسبی ندارد!"],[593,"که نه امشب آن سماع است که دف خلاص یابد","به طپانچه‌ای و بربط برهد به گوشمالی","چرا که مجلس سماع و رقص و پایکوبی امشب ما مجلسی نیست که دف با ضربه‌ای و ساز بربط با گوشمالی از دست نوازنده، راحت شود(مجلس امشب ما تا دیر وقت برقرار است). طپانچهلغت‌نامه دهخداطپانچه . [ ط چ / چ ] (ا) طبانچه . اصلش تپانچه است . سیلی . چک . طپنچه . لطمة. زخم با کف دست . توگوشی . بناغوشی . بناگوشی در زبان ترکی به معنی تکه چوبی است کت و کلفت که روی زمین بعد از شخم زدن می گرداندند تا کلوخ ها شکسته شده و سطح زمین صاف شود."],[593,"دگر آفتاب رویت منمای آسمان را","که قمر ز شرمساری بشکست چون هلالی","دیگر چهره­‌ی همچون آفتابت را به آسمان نشان مده، چرا که ماه از شدت شرمساری خمیده و هلال گشت."],[593,"خط مشک بوی و خالت به مناسبت تو گویی","قلم غبار می‌رفت و فرو چکید خالی","موهای خوشبو و ظریف صورتت و محل قرار گرفتن خالت چنان متناسب و هماهنگ است که گویی از قلمی که در حال نگارش خط غبار است، خالی فرو چکیده است."],[593,"تو هم این مگوی سعدی که نظر گناه باشد","گنه است برگرفتن نظر از چنین جمالی","سعدی! تو نیز دیگر این مطلب را نگو که نگاه کردن به چهره‌­ی زیبارویان گناه است، در واقع نگاه نکردن به چنین چهره­‌ای زیبا گناه است!"],[594,"ترحّم ذلّتی یا ذا المعالی","و واصلنی اذا شوّشت حالی","از تو خواهش می‌کنم که به حال سرگردان من که ذلیل و بی‌پناهم رحم کنی، و اگر در حالی که دلشوره دارم به من خبر بدهی، به من وصل و نزدیک شو."],[594,"ألا یا ناعس الطّرفین سکری","سل السّهران عن طول اللّیالی","ای خواب‌آور دو چشم، حال من را بپرس و از شب‌های طولانی بگو که مرا در غم و اندیشه غوطه‌ور کرده است."],[594,"ندارم چون تو در عالم دگر دوست","اگرچه دوستی دشمن‌فعالی","در جهان کسی مانند تو ندارم، حتی اگر کسی باشد که دوستی‌اش مضر باشد."],[594,"کمال الحسن فی الدّنیا مصون","کمثل البدر فی حدّ الکمال","کمال زیبایی در دنیا همچون ماه کامل در اوج زیبایی محفوظ و دست‌نخورده است."],[594,"مرکب در وجودم همچو جانی","مصوّر در دماغم چون خیالی","وجودم شبیه به مرکبی است که جان در آن قرار دارد، و افکارم مانند خیالی در ذهنم نقش بسته است."],[594,"فماذا النّوم؟ قیل النّوم راحه","و ما لی النّوم فی طول اللّیالی","خواب چیست؟ گفته شده خواب آرامش است، اما من چرا در طول شب‌ها نمی‌توانم بخوابم؟"],[594,"دمی دلداری و صاحب دلی کن","که برخور بادی از صاحب جمالی","لحظه‌ای من را دلدار و دلسوزی کن، زیرا نسیم خوشی از چهره زیبایی به من رسیده است."],[594,"ألم تنظر إلی عینی و دمعی؟","تری فی البحر أصداف اللّآلی","آیا به چشمانم و اشک‌هایم نگاه نکردی؟ در دریا، صدف‌های مروارید را می‌بینی."],[594,"به گوشت گر رسانم ناله زار","ز درد ناله زارم بنالی","اگر من صدای ناله غم‌انگیزم را به تو برسانم، از درد من به نظر می‌رسد که تو هم به این ناله غمناک پاسخ خواهی داد."],[594,"لقد کلّفت ما لم أقو حملا","و ما لی حیلة غیر احتمالی","ای معشوق، تو بار سنگینی بر دوشم گذاشتی که قادر به تحمل آن نیستم و هیچ چاره‌ای جز تحمل این بار ندارم."],[594,"که کوته باد چون دست من از دوست","زبان دشمنان از بدسگالی","این بیت بیان می‌کند که اگر دوستی وجود نداشته باشد، طعنه و کلام بد از دشمنان نیز نمی‌تواند به کسی آسیب بزند. به عبارتی، وقتی دوستی و محبت وجود داشته باشد، مشکلات و بدگویی‌ها نمی‌توانند انسان را ناراحت کنند."],[594,"الا یا سالیا عنّی توقّف","فما قلب المعنّی عنک سال","ای دوست، بدان که دل معشوق از یاد تو غافل نیست و لحظه‌ای از تو بازنمی‌ایستد؛ پس ای سالک، لحظه‌ای در سفر خود تأمل کن."],[594,"به چشمانت که گرچه دوری از چشم","دل از یاد تو یک دم نیست خالی","چشمانت هرچند از من دورند، اما دل هرگز تو را فراموش نکرده و همیشه مشغول یاد توست."],[594,"منعت النّاس یستسقون غیثا","أن استرسلت دمعا کاللّآلی","منع کردم مردم را که برای باران دعا کنند، زیرا اشکم مانند مروارید می‌ریزد."],[594,"جهانی تشنگان را دیده در توست","چنین پاکیزه پندارم زلالی","به نظر می‌رسد که جهانی از تشنگان در وجود تو وجود دارد و من این‌قدر تو را پاک و زلال می‌بینم که گویی منبعی برای رفع تشنگی آن‌ها هستی."],[594,"و لی فیک الإراده فوق وصف","و لکن لم تردنی؛ ما احتیالی؟","علاقه من به تو فراتر از توصیف‌هاست، اما تو مرا نمی‌خواستی، دلیلش چیست؟"],[594,"چه دستان با تو درگیرد چو روباه","که از مردم گریزان چون غزالی","دست‌هایم وقتی به تو نزدیک می‌شوند، مانند روباهی است که از انسان‌ها فرار می‌کند، در حالی که من مانند غزالی هستم که جستجوگر و معصوم است."],[594,"جرت عینای من ذکراک سیلا","سل الجیران عنّی ما جری لی","چشم‌هام از یاد تو به گریه افتاده است، از همسایه‌ها بپرس که چه بر من گذشته است."],[594,"نمایندت به هم خلقی به انگشت","چو بینند آن دو ابروی هلالی","اگر مردم ببینند که ابروهای هلالی‌ات را به زیبایی به هم دیگر نشان می‌دهند، به فکر می‌افتند که تو چقدر زیبا هستی."],[594,"حفاظی لم یزل ما دمت حیّا","و لو انتم ضجرتم من وصالی","هیچ گونه محافظتی از من سلب نخواهد شد، تا زمانی که زنده‌ام و هرچند شما از وصال و ارتباط با من خسته شده باشید."],[594,"دلت سخت است و پیمان اندکی سست","دگر در هر چه گویم بر کمالی","دل تو سخت و بی‌عاطفه است و پیمان‌های تو نیز ضعیف و ناپایدار است. هر چه درباره کمال و خوبی بگویم، بی‌فایده است."],[594,"اذا کان افتضاحی فیک حلوا","فقل لی ما لعذّالی؟ و ما لی؟","اگر در وجود تو عیب و نقصی هست که برایم شیرین و جذاب جلوه می‌کند، پس چرا باید به سرزنش‌کنندگان بگویم چه کاره‌اند و چرا به من مربوط‌اند؟"],[594,"مرا با روزگار خویش بگذار","نگیرد سرزنش در لاابالی","مرا به حال و روز خودم بگذار و به من ایراد نگیر که بی‌پروا و بی‌دقت زندگی می‌کنم."],[594,"ترانی ناظما فی الوجد بیتا","و طرفی ناثر عقد اللّآلی","اگر مرا ببینی، می‌بینی که در حال سرودن شعر هستم و مانند کسی که در حال پراکنده کردن گردنبند از جواهرات است، اشعارم را منتشر می‌کنم."],[594,"نگویم قامتت زیباست یا چشم","همه لطفی و سرتاسر جمالی","من نمی‌گویم که قامت تو زیباست یا اینکه چشمانت همه لطف دارند و تمام وجودت زیبایی است."],[594,"و ان کنتم سئمتم طول مکثی","حوالیکم، فقد حان ارتحالی","اگر شما از ماندن در کنار من خسته شده‌اید، پس زمان رفتن من فرا رسیده است."],[594,"چو سعدی خاک شد سودی ندارد","اگر خاک وی اندر دیده مالی","زمانی که سعدی از دنیا رفت، دیگر فایده‌ای ندارد که خاک او را در چشم بمالی، چرا که او دیگر وجود ندارد و تنها یادش باقی مانده است."],[595,"هرگز حسد نبردم بر منصبی و مالی","الا بر آن که دارد با دلبری وصالی","هرگز نسبت به هیچ مقام و ثروتی حسادت نکردم، مگر به کسی که با محبوب خود ارتباط نزدیک و دوستیدگی دارد."],[595,"دانی کدام دولت در وصف می‌نیاید","چشمی که باز باشد هر لحظه بر جمالی","دولت و خوشبختی واقعی را بدان که در وصف آن نمی‌توان گفت، چشمی است که همیشه به تماشای زیبایی محبوبی باز باشد."],[595,"خرم تنی که محبوب از در فرازش آید","چون رزق نیکبختان بی محنت سؤالی","تن آدمی که محبوبش از در وارد می‌شود، خوشبخت و شاداب است، مانند روزی نیکو که بدون زحمت و تلاشی به دستی می‌رسد."],[595,"همچون دو مغز بادام اندر یکی خزینه","با هم گرفته انسی وز دیگران ملالی","ما مانند دو مغز بادام در یک پوست هستیم، که با هم دوستانه و صمیمی زندگی می‌کنیم و از دیگران هیچ دل‌زدگی و ناراحتی نداریم."],[595,"دانی کدام جاهل بر حال ما بخندد","کاو را نبوده باشد در عمر خویش حالی","آیا می‌دانی چه کسی بر حال ما می‌خندد؟ کسی که هرگز در تمام زندگی‌اش حال و روزی نداشته که بخواهد بر ما بخندد."],[595,"بعد از حبیب بر من نگذشت جز خیالش","وز پیکر ضعیفم نگذاشت جز خیالی","پس از جدایی از محبوبم، جز یاد او چیزی به من نرسید و از وجود ضعیفم، تنها خیال او باقی مانده است."],[595,"اول که گوی بردی من بودمی به دانش","گر سودمند بودی بی دولت احتیالی","در آغاز که تو برتری را به دست آوردی، من بر این عقیده بودم که اگر تو در علم و دانش سودمند باشی، نیازی به داشتن قدرت و سلطنت نخواهی داشت."],[595,"سال وصال با او یک روز بود گویی","و اکنون در انتظارش روزی به قدر سالی","زمانی که با او بودم شبی به اندازه یک سال می‌گذشت، و اکنون که از او دورم، هر روز به اندازه یک سال به انتظارش می‌گذرد."],[595,"ایام را به ماهی یک شب هلال باشد","وآن ماه دلستان را هر ابرویی هلالی","روزها به مانند ماهی یک شب هلال (ماه نو) می‌گذرد و آن معشوق محبوب، هر ابرویش مانند هلال (ماه) زیباست."],[595,"صوفی نظر نبازد جز با چنین حریفی","سعدی غزل نگوید جز بر چنین غزالی","صوفی (زاهد یا عارف) تنها با دوست و یار خوبش ارتباط برقرار می‌کند و سعدی هم تنها شعر نمی‌سراید مگر درباره‌ی چنین یاری که به او زیبایی و جذابیت می‌بخشد."],[596,"مرا تو جان عزیزی و یار محترمی","به هر چه حکم کنی بر وجود من حکمی","تو برای من عزیزترین هستی و یاری محترم، هر چیزی که درباره من بگویی یا تصمیم بگیری، برای من حکم است."],[596,"غمت مباد و گزندت مباد و درد مباد","که مونس دل و آرام جان و دفع غمی","نمی‌خواهم غم و آسیب و درد تو وجود داشته باشد، زیرا تو همدم دل و آرامش جانم هستی و باعث دفع غم‌های من می‌شوی."],[596,"هزار تندی و سختی بکن که سهل بود","جفای مثل تو بردن که سابق کرمی","هرچقدر سختی و تندی و بدی کنی، باز هم تحمل کردن بی‌وفایی و بی‌مهری کسی مثل تو، آسان‌تر از آن است که با مهربانی و لطف قبلی‌ات کنار بیایم."],[596,"ندانم از سر و پایت کدام خوبتر است","چه جای فرق که زیبا ز فرق تا قدمی","نمی‌دانم کدام یک از سر و پای تو زیباتر است، زیرا زیبایی تو آن‌قدر چشمگیر است که فرقی نمی‌کند از کدام قسمت تو شروع کنیم."],[596,"اگر هزار الم دارم از تو بر دل ریش","هنوز مرهم ریشی و داروی المی","اگرچه من هزاران درد و رنج از تو در دل دارم، اما هنوز جای زخم‌هایم با محبت تو درمان می‌شود و تو برای دردهایم همچون دارویی هستی."],[596,"چنین که می‌گذری کافر و مسلمان را","نگه به توست که هم قبله‌ای و هم صنمی","تو به‌گونه‌ای از کنار مردم می‌گذری که خداوند نگاهش به توست. تو هم برای کافران و هم برای مسلمانان جاذبه‌ای و در عین حال هم‌دلی با محبوب خود (صنم) داری."],[596,"چنین جمال نشاید که هر نظر بیند","مگر که نام خدا گرد خویشتن بدمی","این زیبایی چونان نیست که هر چشمی آن را ببیند، بلکه فقط کسانی می‌توانند آن را درک کنند که نام خدا را بر خود بگذارند و با یاد او سرشار شوند."],[596,"نگویمت که گلی بر فراز سرو روان","که آفتاب جهانتاب بر سر علمی","نمی‌گویم که گلی بر بالای درخت سرو زیبا وجود دارد، زیرا خورشید تابان دنیا بر سر علم و دانش قرار دارد."],[596,"تو مشکبوی سیه چشم را که دریابد","که همچو آهوی مشکین از آدمی برمی","این بیت به زیبایی در مورد دختری با چشم‌های سیاه و خوشبو صحبت می‌کند که ویژگی‌هایش او را از دیگران متمایز می‌کند. او مانند آهو به خود جلب می‌کند و حضورش بر دل‌ها تأثیر می‌گذارد."],[596,"کمند سعدی اگر شیر شرزه صید کند","تو در کمند نیایی که آهوی حرمی","اگر کمند سعدی، که به معنای دام اوست، اسبه قوی و خطرناک را به دام بیندازد، تو هرگز به دام نیفتی که مانند آهوی حرم هستی و در این حال، به هیچ دامی نمی‌گیری."],[597,"بسیار سفر باید تا پخته شود خامی","صوفی نشود صافی تا درنکشد جامی","انسان خام برای اینکه با تجربه و کارآزموده شود باید سفرهای (جسمی و روحی) بسیار انجام دهد؛ انسان‌­های پرهیزگار نیز تا جامی از باده­‌ی عشق و معرفت ننوشند، خالص و زلال نخواهند شد."],[597,"گر پیر مناجات است ور رند خراباتی","هر کس قلمی رفته‌ست، بر وی به سرانجامی","برای هر کس سرنوشتی رقم خورده است؛ چه پیر نیایشگر باشد و چه رند خرابات."],[597,"فردا که خلایق را دیوان جزا باشد","هر کس عملی دارد، من گوش به انعامی","فردای قیامت که دیوان پاداش و کیفر برپا می‌شود ، مردم به اعمال و کردار خود امید دارند اما من به لطف و بخشش خداوند"],[597,"ای بلبل! اگر نالی، من با تو هم آوازم","تو عشق گلی داری، من عشق گل‌اندامی","ای بلبل اگر قصد فریاد کشیدن و نالیدن داری، من همراه و هم­‌آوای تو هستم؛ چرا که تو دلباخته­‌ی گلی هستی من نیز شیفته­‌ی معشوقی زیبا اندام."],[597,"سروی به لب جویی، گویند «چه خوش باشد»","آنان که ندیده‌ستند، سروی به لب بامی","کسانی که از دیدن معشوقی بالا بلند همچون سرو، بر روی پشت­‌بام محروم بوده‌­اند، دیدن سرو لب­‌جو آنان را به شگفتی وا می‌­دارد و می­‌گویند: چه زیباست!"],[597,"روزی تن من بینی، قربان سر کویش","وین عید نمی‌باشد الا به هر ایامی","روزی خواهی دید که جسم من فدای سر کویش شده است، این عید فدا شدن من برای معشوق اتفاق نمی‌­افتد مگر هر روز!"],[597,"ای در دل ریش من، مهرت چو روان در تن","آخر ز دعاگویی یاد آر به دشنامی","ای محبوبی که در دل زخم ­خورده و دردمند من هستی، و ای محبوبی که مهر و محبت من به تو همچون روان در جسم من است، دست­‌کم از عاشق دعاگوی خود حتی شده با سخن ناسزایی یادی کن."],[597,"باشد که تو خود روزی از ما خبری پرسی","ورنه که برد هیهات، از ما به تو پیغامی","امید است که روزی خود تو از حال ما جویا شوی، و گرنه محال است که کسی از طرف ما به تو پیغامی برساند."],[597,"گرچه شب مشتاقان تاریک بود اما","نومید نباید بود از روشنی بامی","هر چند شب انتظار مشتاقان و دل­‌سپردگان تاریک و طاقت‌­فرساست اما هرگز نباید از طلوع بامداد وصال و یا نمود روشنایی از فراز بام، نومید و مأیوس شد."],[597,"سعدی! به لب دریا، دردانه کجا یابی؟","در کام نهنگان رو، گر می‌طلبی کامی","سعدی! در ساحل دریا هرگز نخواهی توانست مروارید صید کنی، اگر به دنبال رسیدن به آرزوی خود هستی باید با خطر­های بزرگ مواجه شوی."],[598,"تو کدامی و چه نامی که چنین خوب خرامی","خون عشاق حلال است زهی شوخ حرامی","تو چه کسی هستی و نامت چیست که این‌گونه با زیبایی راه می‌روی؟ خون عاشقان به خاطر عشق تو حلال است، ای شوخ که کارهایت ناپسند و بی‌رحمانه است."],[598,"بیم آن است دمادم که چو پروانه بسوزم","از تغابن که تو چون شمع چرا شاهد عامی","من نگرانم که به خاطر عشق و شیدایی به تو مثل پروانه بسوزم، زیرا تو مانند شمعی که در برابر نگاه عامه خلق می‌افروزید، چه آتشی در دل این عشق می‌زنید."],[598,"فتنه انگیزی و خون ریزی و خلقی نگرانت","که چه شیرین‌حرکاتی و چه مطبوع‌کلامی","تو در بین مردم فتنه و خون‌ریزی به راه انداخته‌ای و آن‌ها نگران تو هستند؛ زیرا حرکاتت بسیار شیرین و گفتارت خوشایند است."],[598,"مگر از هیئت شیرین تو می‌رفت حدیثی","نیشکر گفت کمر بسته‌ام اینک به غلامی","گویی از زیبایی و دلنشینی تو داستان‌هایی مثل حرف‌های نیشکر به گوش می‌رسد. اکنون من با جان و دل آماده‌ام تا خدمتگزار تو باشم."],[598,"کافر ار قامت همچون بت سنگین تو بیند","بار دیگر نکند سجده بت‌های رخامی","اگر کافر (ناایمان) نفسی از قامت سنگین تو (شیرین) به تماشا بنشیند، دیگر هرگز به بت‌های بی‌جان و مادی (رخامی) سجده نخواهد کرد."],[598,"بنشین یک نفس ای فتنه که برخاست قیامت","فتنه نادر بنشیند چو تو در حال قیامی","ای فتنه، لحظه‌ای بنشین، زیرا شور و هیجان تو مانند قیامتی است که برپا شده و دیگر فتنه‌گرانی مانند تو در این حال نخواهند نشست."],[598,"بلعجب باشد از این خلق که رویت چو مه نو","می‌نمایند به انگشت و تو خود بدر تمامی","عجب است از این مردم که وقتی چهره‌ات را مانند ماه نو می‌بینند، با اشاره به تو اشاره می‌کنند، در حالی که خودت همان ماه کامل هستی."],[598,"کس نیارد که کند جور در اقبال اتابک","تو چنین سرکش و بیچاره‌کش از خیل کدامی","هیچ‌کس نمی‌تواند ظلمی بکند در دولت اتابک، در حالی که تو این‌قدر نافرمان و ضعیف‌کشی. تو از کدام گروه و طایفه‌ای؟ (AI: هیچ‌کس نمی‌تواند ظلمی به تو بکند، ای اتابک، در حالی که تو این‌قدر بی‌تاب و درمانده‌ای. این حال تو ناشی از کدام گروه است؟)"],[598,"آفت مجلس و میدان و هلاک زن و مردی","فتنه خانه و بازار و بلای در و بامی","فتنه و آشوبی که در مجالس و میدان‌ها به وجود می‌آید، باعث نابودی زن و مرد می‌شود و این فتنه‌ها در خانه و بازار، و همچنین در هر گوشه از زندگی، بلایی است که به مردم آسیب می‌زند."],[598,"در سر کار تو کردم دل و دین با همه دانش","مرغ زیرک به حقیقت منم امروز و تو دامی","من برای رسیدن به تو دل و دین خود را فدای همه‌ی دانایی‌ام کردم. اکنون من به حقیقت مرغی زیرک هستم و تو برای من مانند دام هستی."],[598,"طاقتم نیست ز هر بی‌خبری سنگ ملامت","که تو در سینه سعدی چو چراغ از پس جامی","من توان تحمل سنگین ملامت را ندارم، زیرا تو در دل سعدی همچون چراغی هستی که از پس جام پنهان شده‌ای."],[599,"چون تنگ نباشد دل مسکین حمامی","کش یار هم آواز بگیرند به دامی","کبوتری که یار هم آواز او را در دامی انداخته اند، چگونه دلتنگ نباشد؟"],[599,"دیشب همه شب دست در آغوش سلامت","وامروز همه روز، تمنای سلامی","دیشب تمام شب را در آرامش و سلامت سپری کردیم، اما امروز تمام روز در تمنای یک سلام از او هستم."],[599,"آن بوی گل و سنبل و نالیدن بلبل","خوش بود، دریغا که نکردند دوامی","بوی خوش گل و سنبل و صدای ناله بلبل (آواز سوزناک بلبل) بسیار دلنشین بود، اما افسوس که پایدار نماندند."],[599,"از من مطلب صبر جدایی که ندارم","سنگی‌ست فراق و دل محنت‌زده جامی","از من صبر در قبال جدایی طلب نکن که صبر ندارم! دل محنت زده مانند یک شیشه است و فراق و دوری و جدایی مانند سنگ. سنگ به شیشه بخورد آن را خواهد شکست. پس من نیز نمی توانم در برابر جدایی صبر و مقاومت کنم. این تاب را ندارم."],[599,"در هیچ مقامی دل مسکین نشکیبد","خو کرده صحبت که برافتد ز مقامی","کسی که به مصاحبت (با یار) عادت کرده و خو گرفته، اگر از این منزلت به زیر افتد، هرگز در جای و جایگاهی دیگر نمی تواند شکیبایی کند. دل مسکین من نیز نمی تواند صبوری کند."],[599,"بی‌دوست حرام است جهان دیدن مشتاق","قندیل بکش تا بنشینم به ظلامی","برای آدم مشتاق، دیدن جهان بدون دوست، حرام است. پس تو چراغ را بشکن تا در تاریکی بنشینم. چون وقتی دوست نیست، نمی خواهم چیزی را ببینم"],[599,"چندان بنشینم که برآید نفس صبح","کآن وقت به دل می‌رسد از دوست پیامی","آن قدر می نشینم که نفس صبح برآید. (صبح بدمد). چون که آن زمان است که از دوست پیغامی به دل دوست می رسد. (شب را تا سحر بیدار می مانم که به دلم پیغامی از دوست برسد. که این پیغام دم صبح می رسد)"],[599,"آن جا که تویی رفتن ما سود ندارد","الا به کرم پیش نهد لطف تو گامی","ما هر چقدر بخواهیم به جایی برویم که تو آنجایی، بی فایده است. نمی توانیم به آنجا برسیم. مگر این که لطف تو از روی کرامت گامی پیش نهد. (لطف تو از روی کرامت سببی ایجاد کنی که ما بتوانیم به تو برسیم)"],[599,"زآن عین که دیدی اثری بیش نمانده‌ست","جانی به دهان آمده در حسرت کامی","از آن چشمی که تو پیشتر دیده بودی، اثری و نشانیباقی نمانده، تنها جانی از من باقی مانده که بر دهانم رسیده در حسرت این که کامی از تو حاصل کنم."],[599,"سعدی سخن یار نگوید بر اغیار","هرگز نبرد سوخته‌ای قصه به خامی","سعدی، گلایه و سخن و حرف و حدیث مشکل خودش با یار را به آدمهای غریبه و اغیار نخواهد برد. چون که هرگز، سوخته، قصه ی خودش را نزد آدم خام نخواهد برد. چون خام درک و فهمی از حال و وضع آدمی که سوخته است نخواهد داشت."],[600,"صاحب نظر نباشد در بند نیک‌نامی","خاصان خبر ندارند از گفت و گوی عامی","آدمی که صاحب نظر است، توجهی به خوشنام بودن ندارد. این مسائل (خوشنامی و بدنامی) موضوع عوام (مردم عامی و معمولی) است و خواص (صاحبنظران) از این مسائل خبر ندارند و در بند آن نیستند."],[600,"ای نقطه سیاهی بالای خط سبزش","خوش دانه‌ای ولیکن بس بر کنار دامی","ای نقطه سیاهی که روی خط سبز (گرداگرد لب یا چهره) یار قرار داری، تو دانه‌ای زیبا هستی اما زیادی کنار دام قرار گرفته ای! (نزدیک شدن به تو خطرناک است و بیم افتادن در دام از آن می رود)"],[600,"حور از بهشت بیرون، ناید، تو از کجایی؟","مه بر زمین نباشد، تو ماه رخ کدامی؟","حوری از بهشت نمی‌تواند به زمین بیاید، پس تو از کجایی؟ ماه نمی تواند بر روی زمین باشد. (در آسمان است) تو چه کسی هستی که رخسارت مانند ماه است؟"],[600,"دیگر کسش نبیند در بوستان خرامان","گر سرو بوستانت بیند که می‌خرامی","اگر کسی قد مانند سرو بوستان تو را ببیند که در حال خرامیدن در بوستانی، دیگر هیچ کس را در بوستان خرامان نخواهد دید. کس دیگری به چشمش نخواهد آمد."],[600,"بدر تمام روزی، در آفتاب رویت","گر بنگرد بیآرد، اقرار ناتمامی","اگر ماه کامل و بدر تمام، روزی روی تو را در آفتاب نگاه کند، اقرار خواهد کرد که من ناتمام ام و اوست که ماه تمام است."],[600,"طوطی شکر شکستن دیگر روا ندارد","گر پسته‌ات ببیند وقتی که در کلامی","اگر طوطی، لبان چون پسته ات را ببیند وقتی که در حال سخن گفتنی، دیگر روا نخواهد دانست که خودش شکر شکنی کند. (چون که از دهان مانند پسته ی تو خجالت خواهد کشید)"],[600,"در حسن، بی‌نظیری در لطف، بی‌نهایت","در مهر بی‌ثباتی، در عهد بی‌دوامی","تو در زیبایی بی‌همتا هستی و در نیکی بی‌پایان. (اما) در محبت ثباتی نداری، و در وفا و عهد نیز دایمی نیستی."],[600,"لایق‌تر از امیری در خدمتت اسیری","خوش‌تر ز پادشاهی در حضرتت غلامی","لیاقت تو برای این که کسی بخواهد در خدمت تو اسیری کند، از امیر بیشتر است و برای این که کسی در محضر تو غلامی کند، از پادشاه هم نیکوتر و خوشتری"],[600,"ترک عمل بگفتم ایمن شدم ز عزلت","بی‌چیز را نباشد اندیشه از حرامی","وقتی که دست از کار شستم و تصمیم گرفتم که مشغول کاری نباشم، دیگر تنهایی و انزوا من را نمی آزارد. همان طور که کسی که مال و ثروتی ندارد، بیم و ترسی از دزد و راهزن ندارد و به آن فکر نمی کند."],[600,"فردا به داغ دوزخ ناپخته‌ای بسوزد","کامروز آتش عشق از وی نبرد خامی","اگر امروز کسی در آتش عشق پخته نشود و خامی او به واسطه ی آتش عشق از میان نرود و پخته نشود، فردا (در آن دنیا) این آدم ناپخته و آتش عشق نچشیده، در آتش دوزخ خواهد سوخت"],[600,"هر لحظه سر به جایی بر می‌کند خیالم","تا خود چه بر من آید زین منقطع لگامی","هر لحظه خیال من به جایی دیگر می‌پرد. نمی‌دانم از بس که خیال من افسار گسیخته است چه بر سر من خواهد آمد."],[600,"سعدی چو ترک هستی گفتی ز خلق رستی","از سنگ غم نباشد بعد از شکسته‌جامی","ای سعدی! وقتی که ترک هستی گفتی و از زندگی دست شستی، آن وقت است که از دست مردم رهایی خواهی یافت. چون که کسی که جام او شکست، دیگر نگران این نخواهد بود که سنگ بر جام او بیفتد و آن را بشکند!"],[601,"ای دریغا گر شبی در بر خرابت دیدمی","سرگران از خواب و سرمست از شرابت دیدمی","ای کاش شبی در آغوش تو بودم و رویت را می‌دیدم، در حالی که خواب‌آلود و سرمست از شراب بودم."],[601,"روز روشن دست دادی در شب تاریک هجر","گر سحرگه روی همچون آفتابت دیدمی","در روز روشن، دست مرا گرفتی که در شب تاریک فراق تو تنها هستم. ای کاش صبحگاه، روی زیبای تو را مثل آفتاب می‌دیدم."],[601,"گر مرا عشقت به سختی کشت سهل است این قدر","کاش کاندک مایه نرمی در خطابت دیدمی","اگر عشق تو مرا به سختی و رنج کشته باشد، چندان اشکالی ندارد؛ ای کاش حداقل در صحبت‌هایت کمی نرمی و مهربانی می‌دیدم."],[601,"در چکانیدی قلم بر نامه دلسوز من","گر امید صلح باری در جوابت دیدمی","اگر در نوشتن نامه دلسوزانه‌ام، با قلم خود چیزی می‌نوشتی، خوشحال می‌شدم و امیدوار بودم که نشانه‌ای از صلح در پاسخت باشد."],[601,"راستی خواهی سر از من تافتن بودی صواب","گر چو کژبینان به چشم ناصوابت دیدمی","اگر بخواهی حقیقت را از من پنهان کنی، این کار درستی نیست؛ ای کاش می‌توانستم تو را با چشم همان کژبینان، که حقیقت را به اشتباه می‌بینند، ببینم."],[601,"آه اگر وقتی چو گل در بوستان یا چون سمن","در گلستان یا چو نیلوفر در آبت دیدمی","ای کاش زمانی مرا مانند گل در باغ، یا چون سمن در گلزار، یا همچون نیلوفر در آب می‌دیدی."],[601,"ور چو خورشیدت نبینم کاشکی همچون هلال","اندکی پیدا و دیگر در نقابت دیدمی","اگر تو را مانند خورشید نتوانم دید، ای کاش یک مقدار مثل هلال ماه نمایان شوی و باقی‌مانده‌ات را در پوشش پنهان ببینم."],[601,"از منت دانم حجابی نیست جز بیم رقیب","کاش پنهان از رقیبان در حجابت دیدمی","می‌دانم که محبت تو باعث نمی‌شود مانعی وجود داشته باشد، جز اینکه من از رقیبان می‌ترسم. ای کاش می‌توانستم تو را در حالتی که از رقیبان پنهان هستی ببینم."],[601,"سر نیارستی کشید از دست افغانم فلک","گر به خدمت دست سعدی در رکابت دیدمی","آسمان و فلک در برابر ناله و فغان من سرکشی نمی‌کرد، اگر دست سعدی را در خدمت تو می‌دیدم. (AI: اگر آسمان در برابر من دست افغانیان را از کار می‌کشید، حتما دست سعدی را در خدمت تو می‌دیدم.)"],[601,"این تمنایم به بیداری میسر کی شود","کاشکی خوابم گرفتی تا به خوابت دیدمی","آرزو دارم که این تمنای من در بیداری به نتیجه برسد، اما امیدوارم که در خواب بتوانم تو را ببینم."],[602,"آسوده‌خاطرم که تو در خاطر منی","گر تاج می‌فرستی و گر تیغ می‌زنی","من آرام و راحت‌خاطر هستم زیرا تو در ذهنم هستی، چه اگر محبت می‌کنی و چه اگر با سختی و شکنجه به من آسیب می‌زنی."],[602,"ای چشم عقل، خیره در اوصاف روی تو","چون مرغ شب که هیچ نبیند به روشنی","ای عقل، تو مانند مرغ شب هستی که در تاریکی به سر می‌برد و هیچ چیزی را در روشنی نمی‌بیند، پس در زیبایی‌های چهره تو غرق شده‌ام و نمی‌توانم جز تو را ببینم."],[602,"شهری به تیغ غمزه خونخوار و لعل لب","مجروح می‌کنی و نمک می‌پراکنی","تو با نگاه تیز و کشنده‌ات و لب‌های سرخ و زیبا، دل‌ها را می‌شکنی و زخم می‌زنی و بر درد دیگران می‌افزایی."],[602,"ما خوشه‌چین خرمن اصحاب دولتیم","باری نگه کن ای که خداوند خرمنی","ما کسانی هستیم که برای دیگران در جمع‌آوری خوشی‌ها و نعمت‌ها تلاش می‌کنیم، حالا تو ای صاحب قدرت، نگاهی به حال ما بینداز."],[602,"گیرم که بر کنی دل سنگین ز مهر من","مهر از دلم چگونه توانی که بر کنی؟","اگر فرض کنیم که تو بتوانی محبت و عشق من را از دل سنگین و پر از غم من جدا کنی، اما چطور می‌توانی محبت را از دل من بزدایی؟"],[602,"حکم آن توست اگر بکشی بی‌گنه ولیک","عهد وفای دوست نشاید که بشکنی","اگر تصمیم بگیری بی‌دلیل کسی را بکشیدی، این به خود تو بستگی دارد، اما نباید به عهد و پیمان دوستی، که باید وفا کرد، خیانت کنی."],[602,"این عشق را زوال نباشد به حکم آنک","ما پاک‌دیده‌ایم و تو پاکیزه‌دامنی","این عشق هیچ‌گاه به پایان نمی‌رسد، زیرا ما افرادی پاک و بی‌آلایش هستیم و تو نیز نجیب و پاکدامن هستی."],[602,"از من گمان مبر که بیاید خلاف دوست","ور متّفق شوند جهانی به دشمنی","نگران نباش که من هرگز فکر نمی‌کنم که به دوست خلاف و نفاقی برسانم، حتی اگر همه دنیا به دشمنی با او بپردازند."],[602,"خواهی که دل به کس ندهی، دیده‌ها بدوز","پیکان چرخ را سپری باشد آهنی","اگر نمی‌خواهی دل به کسی بدهی، باید چشمانت را به سمت روزگار که مانند پیکانی نامرئی است، بگیرید؛ زیرا در این صورت، وجودت مانند سپری آهنین خواهد بود و هیچ‌کس نمی‌تواند به تو آسیب برساند."],[602,"با مدّعی بگوی که ما خود شکسته‌ایم","محتاج نیست پنجه که با ما درافکنی","به مدعی (شاکی) بگو که ما خود به قلبی شکسته و آزار دیده‌ایم و نیازی به قدرت تو نداریم تا بر ما فشار بیاوری."],[602,"سعدی چو سروری نتوان کرد لازم است","با سخت‌بازوان، به ضرورت فروتنی","ای سعدی، برای اینکه به مقام و منزلتی نمی‌توانی دست یابی، ناگزیر باید با افراد با قوّت و استحکام به تواضع و فروتنی بپردازی. (AI: برای اینکه به مقام و منزلتی دست یابی، ناگزیر باید با قوت و استحکام به تواضع و فروتنی بپردازی.)"],[603,"اگر تو میل محبّت کنی و گر نکنی","من از تو روی نپیچم که مستحبّ‌ منی","هرچند تو تمایل به محبت داشته باشی یا نداشته باشی، من از تو روی بر نخواهم گرداند؛ زیرا تو محبوب من هستی و این برای من پسندیده است."],[603,"چو سرو در چمنی، راست در تصوّر من","چه جای سرو؟ که مانند روح در بدنی","تو مانند سروی هستی که در باغی ایستاده است، اما من در ذهنم آن‌قدر خیال‌پرداز هستم که تصور می‌کنم نه فقط سرو، بلکه تو روح منی که در بدنم جای داری."],[603,"به صید عالمیانت، کمند، حاجت نیست","همین بس است که برقع ز روی برفکنی","برای شکار دل‌های مردم، نیازی به دام (کمند) نیست. همین‌که نقاب خود را از روی برداری و خود را نشان دهی، کافی است."],[603,"بیاض ساعد سیمین مپوش در صف جنگ","که بی‌تکلّف شمشیر، لشکری بزنی","به خاطر زیبایی و لطافت دست‌های سفید و نقره‌ای خود، در میدان جنگ آن‌ها را نپوشان. زیرا با یک ضربه ساده و بدون نیاز به زحمت زیادی می‌توانی دشمنان را شکست دهی."],[603,"مبارزان جهان قلب دشمنان شکنند","تو را چه شد که همه قلب دوستان شکنی؟","شجاعان دنیا دل دشمنان را می‌ترسانند و می‌شکنند، اما تو چرا دل دوستانت را می‌شکنی؟"],[603,"عجب در آن نه که آفاق در تو حیرانند","تو هم در آینه حیران حسن خویشتنی","تعجبی ندارد که دنیا به خاطر تو شگفت‌زده است، خود تو نیز در آینه از زیبایی خود حیرت‌زده‌ای."],[603,"تو را که در نظر آمد جمال طلعت خویش","حقیقت است که دیگر نظر به ما نکنی","تو که در نگاهت زیبایی چهره‌ات حقیقت دارد، دیگر نیازی نیست به ما توجه کنی."],[603,"کسی در آینه شخصی بدین صفت بیند","کند هرآینه جور و جفا و کبر و منی","اگر کسی در آینه نگاهی به خود بیندازد و این حد صفت زیبایی را مشاهده می‌کند؛ ناگزیر دچار ظلم، بی‌احترامی، خودبزرگ‌بینی و منیت می‌شود. (AI: اگر کسی در آینه نگاهی به خود بیندازد، در واقع عیب‌ها و ناهنجاری‌های خود را مشاهده می‌کند؛ مانند ظلم، بی‌احترامی، خودبزرگ‌بینی و منیت.)"],[603,"در آن دهن که تو داری سخن نمی‌گنجد","من آدمی نشنیدم بدین شکردهنی","در دهان تو که این‌قدر شیرین و دلپذیر است، هیچ سخنی جا نمی‌گیرد، چون من آدمی را ندیده‌ام که به این اندازه قندین (شیرین) باشد."],[603,"شنیده‌ای که مقالات سعدی از شیراز","همی‌ برند به عالم، چو نافه ختنی؟","زبانزد است که آثار سعدی از شهر شیراز به گوش جهانیان می‌رسد، همانطور که بوی خوش نافه ختن (منطقه‌ای مشهور به خاطر عطرش) در فضا پخش می‌شود."],[603,"مگر که نام خوشت بر دهان من بگذشت","برفت نام من اندر جهان به خوش‌سخنی","آیا جز این بود که نام نیکویت بر زبان من جاری شد؟ و نام من در جهان به خوش‌سخنی شهره شد. (AI: آیا جز این بود که نام نیکویت بر زبان من جاری شد؟ در حالی که به زیبایی سخن می‌گفتم، نام من در جهان فراموش شد.)"],[604,"زنده بی دوست خفته در وطنی","مثل مرده‌ایست در کفنی","زنده بودن بدون دوست مانند این است که آدمی در وطن خود غیابا مرده است، مثل کسی که در تابوت قرار دارد و در واقع زنده نیست."],[604,"عیش را بی تو عیش نتوان گفت","چه بود بی وجود روح تنی","زندگی را بدون تو نمی‌توان زندگی نامید؛ مانند این است که زندگی بدون وجود روح در بدن چه معنایی دارد."],[604,"تا صبا می‌رود به بستان‌ها","چون تو سروی نیافت در چمنی","زمانی که باد صبا می‌وزد و به باغ‌ها می‌رود، در هیچ چمنی مثل تو، یعنی مانند تو که مانند یک سرو زیبا و بلند است، هیچ موجودی را نمی‌توان یافت."],[604,"و آفتابی خلاف امکان است","که برآید ز جیب پیرهنی","آفتاب، نمادی از زیبایی و روشنایی، نمی‌تواند از جیب پیراهنی کهنه و تنگ بیرون بیاید. این تصویر به نوعی بیانگر غیرممکن بودن ظهور زیبایی یا نیکی از جایی است که شرایطش مساعد نیست."],[604,"وآن شکن برشکن قبائل زلف","که بلاییست زیر هر شکنی","این زلف‌های پیچیده و زیبا به قدری فریبنده‌اند که هر بار که به آن‌ها نگاه می‌کنیم، انگار بلایی در زیر هر ترفند و تماشای آن‌ها نهفته است."],[604,"بر سر کوی عشق بازاریست","که نیارد هزار جان ثمنی","در کوی عشق، بازار شوق و عشق بسیار پر رونق و شلوغ است، طوری که هیچ‌کس نمی‌تواند جان‌های زیادی را در آنجا به قیمت کمی خرید و فروش کند."],[604,"جای آن است اگر ببخشایی","که نبینی فقیرتر ز منی","اگر عشق و محبت را در نظر داشته باشی، سزاوار است که مرا ببخشی، زیرا نمی‌توانی کسی را فقیرتر از من پیدا کنی."],[604,"هفت کشور نمی‌کنند امروز","بی مقالات سعدی انجمنی","امروز هفت کشور به گرد هم نمی‌آیند و جلسه‌ای تشکیل نمی‌دهند، مگر به واسطه اشعار و نوشته‌های سعدی."],[604,"از دو بیرون نه یا دلت سنگیست","یا به گوشت نمی‌رسد سخنی","یا دلت سنگی است، یا اینکه صدای سخنان من به گوشت نمی‌رسد و نمی‌شنوی."],[605,"سروقدی میان انجمنی","به که هفتاد سرو در چمنی","بهتر است یک جوان بلندقد و زیبا در جمعی باشد، تا اینکه هفتاد درخت سرو در باغی باشند."],[605,"جهل باشد فراق صحبت دوست","به تماشای لاله و سمنی","فراق از دوست و دوری او را به تماشای لاله و سمن (دو گل زیبا) ترجیح دادن، نادانی است."],[605,"ای که هرگز ندیده‌ای به جمال","جز در آیینه مثل خویشتنی","تو که هیچگاه زیبایی را جز در آینه ندیده‌ای، پس نمی‌توانی کسی چون خودت را درک کنی."],[605,"تو که همتای خویشتن بینی","لاجرم ننگری به مثل منی","تو که خود را همسان و شبیه خود می‌دانی، از این رو به کسی چون من نمی‌نگری."],[605,"در دهانت سخن نمی‌گویم","که نگنجد در آن دهن سخنی","من در مورد سخن‌هایی که می‌خواهم بگویم، در دهان تو چیزی نمی‌گویم، زیرا آن سخنان در دهان تو نمی‌گنجند."],[605,"بدنت در میان پیرهنت","همچو روحیست رفته در بدنی","بدن تو درون پیراهنت به‌قدری زیباست که گویا روحی در یک جسم و بدن قرار دارد."],[605,"وآن که بیند برهنه اندامت","گوید این پرگل است پیرهنی","آن کسی که تو را بدون لباس ببیند، می‌گوید که این پرگل، همان پیراهنی است. یعنی زیبایی و تنوع اندام تو به قدری است که به جای برهنگی، به شکلی دیگر جلوه‌گر می‌شود."],[605,"با وجودت خطا بود که نظر","به ختایی کنند یا ختنی","وجود تو به قدری ارزشمند و محترم است که اصلا اشتباه است کسی بخواهد به آن ختای، یا شرم، نگاهی بیندازد. ضمنا «ختا» به معنای شرم و عیب است، و «ختنی» هم به معنای شرم و عفت است."],[605,"باد اگر بر من اوفتد ببرد","که نمانده‌ست زیر جامه تنی","اگر باد به من بوزد، مرا خواهد برد، زیرا که در زیر لباس تنها یک بدن باقی نمانده است."],[605,"چاره بیچارگی بود سعدی","چون ندانند چاره‌ای و فنی","سعدی می‌گوید که وقتی کسی چاره‌ای برای بیچارگی خود نمی‌داند، در واقع خودش به این بیچارگی دامن می‌زند و به نوعی در این وضعیت نادانی به سر می‌برد."],[606,"کس نگذشت در دلم تا تو به خاطر منی","یک نفس از درون من خیمه به در نمی‌زنی","مادامی که تو در خاطر و خیال من هستی، هیچ کس حتا در دل من هم نگذشت و به هیچ کس فکر نکردم. تو حتا یک لحظه و اندازه ی یک نفس هم از درون من بیرون نمی روی. خیمه زده ای و جا خوش کرده ای"],[606,"مهرگیاه عهد من تازه‌تر است هر زمان","ور تو درخت دوستی از بن و بیخ برکنی","عهد و پیمانی که با تو بستم، مثل مهرگیاهی، همیشه تر و تازه است و هرگز خشک و پژمرده نمی شود. حتی اگر تو درخت دوستی را از بن و بیخ برکنی و ریشه کن کنی"],[606,"کس نستاندم به هیچ ار تو برانی از درم","مقبل هر دو عالمم گر تو قبول می‌کنی","اگر تو من را از در خودت برانی، هیچ کس من را به پشیزی نمی خرد. مفت هم نمی خرد! اما اگر تو من را قبول کنی، در هر دو عالم، پذیرفته و مقبل خوام بود."],[606,"چون تو بدیع‌صورتی بی‌سبب کدورتی","عهد وفای دوستان حیف بود که بشکنی","شخصی مانند تو با آن چهره ی بدیع و زیبا و دلفریب، حیف است که عهد و وفای دوستان را بی دلیل بشکنی و بدون این که کاری کرده باشم که باعث مکدر شدن خاطر تو شود، عهدی که بستیم که به هم وفاکنیم را زیر پا بگذاری"],[606,"صبر به طاقت آمد از بار کشیدن غمت","چند مقاومت کند حبه و سنگ صد منی؟","صبر من تمام شد و طاقت از دست دادم و دیگر نمی توانم بار غم تو را بکشم و تحمّل کنم. مگر یک حبّه و دانه ی گندم چه قدر می تواند در مقابل سنگ صد منی آسیاب مقاومت کند؟ من هم مانند آن حبّه ام و غم تو مانند آن سنگ صد منی"],[606,"از همه کس رمیده‌ام با تو درآرمیده‌ام","جمع نمی‌شود دگر هر چه تو می‌پراکنی","از همه می گریزم و فقط با تو آرامش دارم. وقتی تو من را پریشان می کنی و خاطرم را به هر جا پراکنده می کنی، این خاطر و دل دیگر جمع و آسوده نخواهد شد."],[606,"ای دل اگر فراق او وآتش اشتیاق او","در تو اثر نمی‌کند تو نه دلی که آهنی","ای دل، اگر جدایی او و آتش شوق او بر تو تأثیر نمی‌گذارد، پس تو دل نیستی! مثل آهن بی‌روحی."],[606,"هم به در تو آمدم از تو که خصم و حاکمی","چاره پای‌بستگان نیست به جز فروتنی","برای دادخواهی از تو و ستمی که به من کردی، جای دیگری نداشتم به شکایت بروم و دوباره به درگاه تو آمدم تا از خودت گله کنم. آدمهایی که پایشان بسته است، چاره ای ندارند مگر این که فروتنی کنند. نمی توانند اعتراض یا گردنکشی کنند."],[606,"سعدی اگر جزع کنی ور نکنی چه فایده؟","سخت کمان چه غم خورد گر تو ضعیف‌جوشنی؟","ای سعدی! هیچ فایده ای ندارد اگر بخواهی داد و بیداد و حق خواهی کنی، یا سکوت کنی و چیزی نگویی! کسی که کمان سخت و محکم و قوی دارد، غصه ی تو را نخواهد خورد که سپر ضعیفی داری. می گوید به من چه! من تیر خودم را می اندازم. مشکل من نیست که سپر او ضعیف و سست است و تیر من را دفع نمی کند!"],[607,"من چرا دل به تو دادم که دلم می‌شکنی","یا چه کردم که نگه باز به من می‌نکنی","چرا من قلبم را به تو سپردم در حالی که تو آن را می‌شکنی؟ چه اشتباهی از من سر زده که حالا دیگر به من توجه نمی‌کنی؟"],[607,"دل و جانم به تو مشغول و نظر در چپ و راست","تا ندانند حریفان که تو منظور منی","دل و جان من درگیر و مشغول تو است. اما وقتی تو هستی، به این طرف و آن طرف نگاه می کنم (مثل رد گم کردن امروزی!) تا دوستانم و کسانی که با آنها مشغول صحبتیم متوجه نشوند که تو شخص مورد نظر منی."],[607,"دیگران چون بروند از نظر از دل بروند","تو چنان در دل من رفته که جان در بدنی","دیگران وقتی از دید و اطراف آدم دور می‌شوند، از دل هم فراموش می‌شوند، اما تو آن‌چنان در قلب من جا داری که مثل جان در بدن هستی."],[607,"تو همایی و من خسته بیچاره‌ گدای","پادشاهی کنم ار سایه به من برفکنی","تو مانند هما هستی که وقتی سایه ات بر کسی بیفتد، او را به پادشاهی می رسانی و من آن گدا که بیچاره و زخمی ام. اما اگر تو بر من سایه بیفکنی، من حس پادشاهی می کنم و سلطان خواهم بود."],[607,"بنده وارت به سلام آیم و خدمت بکنم","ور جوابم ندهی می‌رسدت کبر و منی","مانند بندگان و خادمان برای عرض سلام به نزد تو می آیم و به تو خدمت می کنم. و اگر جواب سلام من را هم ندهی، باز هم حق داری چون این جایگاه را داری که بخواهی تکبر و خودخواهی کنی."],[607,"مرد راضیست که در پای تو افتد چون گوی","تا بدان ساعد سیمینش به چوگان بزنی","مرد (هر آدمی) راضی است که مانند گوی که در پای چوب بازی چوگان می افتد، در پای تو بیفتد و تو با آن ساعد سفید و نقره گون خودت او را مانند چوگان که گوی را می زند و به سمتی پرتاب می کند، بزنی"],[607,"مست بی خویشتن از خمر ظلوم است و جهول","مستی از عشق نکو باشد و بی خویشتنی","مستی که ناشی از شراب است، نادان و ناروشن است.مستی و بی خویشی ناشی از عشق خوب است."],[607,"تو بدین نعت و صفت گر بخرامی در باغ","باغبان بیند و گوید که تو سرو چمنی","اگر تو با این صفات و ویژگی‌های خود و با این ناز و خرام، در باغ بخرامی، باغبان که تو را دید، خواهد گفت که تو همان درخت سرو هستی که در چمن روییده است."],[607,"من بر از شاخ امیدت نتوانم خوردن","غالب الظن و یقینم که تو بیخم بکنی","من نمی‌توانم از شاخه ی درخت امید تو میوه ای بخورم. ناامیدم از این که بتوانم به تو برسم. چون مطمئنم که تو مرا ریشه کن خواهی کرد."],[607,"خوان درویش به شیرینی و چربی بخورند","سعدیا چرب زبانی کن و شیرین سخنی","ای سعدی! اگر می خواهی که از سفره ی تو نیز بخورند، باید بدانی که از سفره ی فقیران، وقتی می خورند که شیرین و چرب باشد. غذای خشک و ساده فقیران را نمی خورند. پس اگر می خواهی مقبول باشی، چرب زبانی و شیرین سخنی کن"],[608,"ای سرو حدیقه معانی","جانی و لطیفه جهانی","ای سرو (درخت سرو، نمادی از زیبایی و بلندی) باغ معانی، تو جان و روح لطافت‌های جهانی."],[608,"پیش تو به اتفاق مردن","خوشتر که پس از تو زندگانی","بهتر است که با هم از دنیا برویم تا بعد از تو بدون تو زندگی کنم."],[608,"چشمان تو سحر اولین اند","تو فتنه آخرالزمانی","چشمان تو مانند سحر است که در اولیه‌ترین حالت خود، زنده و جذاب است و تو در عین حال، معصومانه‌ترین و فتنه‌انگیزترین چیز در آخرالزمان به شمار می‌روى."],[608,"چون اسم تو در میان نباشد","گویی که به جسم در میانی","وقتی نام تو در میان نباشد، انگار که هیچ جسمی را در بین ما نمی‌بینم."],[608,"آن را که تو از سفر بیایی","حاجت نبود به ارمغانی","وقتی تو از سفر برگردی، دیگر نیازی به هدیه و سوغاتی نیست."],[608,"گر ز آمدنت خبر بیارند","من جان بدهم به مژدگانی","اگر خبر آمدن تو را به من برسانند، من جانم را فدای این خبر خوش می‌کنم."],[608,"دفع غم دل نمی‌توان کرد","الا به امید شادمانی","برای رفع غم دل، هیچ راهی جز امید به شادمانی وجود ندارد."],[608,"گر صورت خویشتن ببینی","حیران وجود خود بمانی","اگر به ظاهرت نگاه کنی، در شگفتی و حیرت از وجود خود می‌مانی و نمی‌توانی به راحتی خود را بشناسی."],[608,"گر صلح کنی لطیف باشد","در وقت بهار و مهربانی","اگر با کسی صلح کنی، این صلح در فصل بهار و در زمان محبت و دوستی دلنشین و زیبا خواهد بود."],[608,"سعدی خط سبز دوست دارد","پیرامن خد ارغوانی","سعدی در این بیت می‌گوید او رنگ سبز را دوست دارد که نماد زندگی و طراوت است و پیرامونش رنگ ارغوانی، که به زیبایی و جذابیت اشاره دارد، قرار دارد. این توصیف نشان‌دهنده‌ی تأثیر دو رنگ متفاوت بر یکدیگر و ایجاد جلوه‌ای زیبا در طبیعت و عشق است."],[608,"این پیر نگر که همچنانش","از یاد نمی‌رود جوانی","این پیر (سعدی) را در نظر بگیر که هنوز جوانی و شادابی‌اش را فراموش نکرده است."],[609,"بر آنم گر تو باز آیی که در پایت کنم جانی","و زین کم‌تر نشاید کرد در پای تو قربانی","اگر تو دوباره به سوی من برگردی، آرزوم این است که جانم را فدای پاهایت کنم، و کمتر از این هم شایسته نیست که برای تو قربانی شوم."],[609,"امید از بخت می‌دارم بقای عمر چندانی","کز ابر لطف باز آید به خاک تشنه بارانی","امیدوارم که بخت به من کمک کند تا عمرم طولانی شود، زیرا مانند بارانی که از ابر لطف می‌بارد، ممکن است زندگی دوباره‌ای به من داده شود."],[609,"میان عاشق و معشوق اگر باشد بیابانی","درخت ارغوان روید به جای هر مغیلانی","اگر بین عاشق و معشوق فاصله و کم‌محبتی وجود داشته باشد، درخت ارغوانی (نمادی از عشق و زیبایی) تنها در جای دیگری خواهد رویید که دور از دلخوری و جدایی باشد، نه در مکانی که عشق در آن خفته است."],[609,"مگر لیلی نمی‌داند که بی‌دیدار میمونش","فراخای جهان تنگ است بر مجنون چو زندانی؟","لیلی، معشوق مجنون، آیا نمی‌داند که بدون دیدنش، برای مجنون، دنیا بسیار تنگ و محنت‌بار است و او به مانند زندانی‌ای بی‌خلاص است؟"],[609,"دریغا عهد آسانی که مقدارش ندانستم","ندانی قدر وصل الا که در مانی به هجرانی","افسوس بر عهدی که در آن روزهای خوشی به سر می‌بردم و نمی‌دانستم چقدر ارزشمند است. غیر از این، هیچ کس ارزش وصال را درک نمی‌کند، جز کسی که به جدایی مبتلا شده باشد."],[609,"نه در زلف پریشانت من تنها گرفتارم","که دل در بند او دارد به هر مویی پریشانی","من به خاطر پریشانی زلف‌های تو، تنها و گرفتار شده‌ام، زیرا دل‌ با هر تار موی تو در بند است و این وضعیت برایم دشوار و آزاردهنده است."],[609,"چه فتنه‌ست این که در چشمت به غارت می‌برد دل‌ها","تویی در عهد ما گر هست در شیراز فتّانی","این چشمان تو چه بلای بزرگی به پا می‌کنند که دل‌ها را می‌ربایند. تو اگر در شیراز فتنه‌گری داشته باشی، در زمان ما همین بس است."],[609,"نشاید خون سعدی را به باطل ریختن حقا","بیا سهل است اگر داری به خط خواجه فرمانی","نباید خون سعدی را بی‌دلیل و ناحق ریخت. حقیقت این است که اگر تو قدرت و فرمانی داری، نباید بی‌ملاحظگی کنی و این کار را ساده بپنداری."],[609,"زمان رفته باز آید ولیکن صبر می‌باید","که مستخلص نمی‌گردد بهاری بی زمستانی","زمانی که از دست رفته دوباره برمی‌گردد، اما باید صبر کرد، زیرا بهار بدون زمستان نمی‌آید و برای رسیدن به روزهای خوب، باید تلخی‌ها را تحمل کرد."],[610,"بنده‌ام گر به لطف می‌خوانی","حاکمی گر به قهر می‌رانی","من بنده‌ی تو هستم؛ اگر با لطف و محبت من را بخوانی و اگر با غضب و خشم من را برانی، فرقی نمی‌کند."],[610,"کس نشاید که بر تو بگزینند","که تو صورت به کس نمی‌مانی","هیچ‌کس شایسته نیست که به جای تو انتخاب شود، زیرا تو هیچ شبیه‌ به کسی نیستی."],[610,"ندهیمت به هر که در عالم","ور تو ما را به هیچ نستانی","اگر تو محبت و لطف خود را به هر کسی بدهی، پس هیچ‌گاه ما را از خودت دور نکن و به هیچ چیز ما را نده."],[610,"گفتم این درد عشق پنهان را","به تو گویم که هم تو درمانی","می‌گویم این عشق پنهانی را به تو بگویم چون تو خود درمان این درد هستی."],[610,"باز گفتم «چه حاجت است به قول؟»","که تو خود در دلی و می‌دانی","گفتم دیگر نیازی به گفتن نیست، زیرا تو خود در دل من هستی و از حال من باخبری."],[610,"نفس را عقل تربیت می‌کرد","کز طبیعت عنان بگردانی","عقل در تلاش بود تا نفس را اصلاح کند و آن را از خصوصیات طبیعی و غریزی‌اش دور کند."],[610,"عشق دانی چه گفت تقوا را؟","«پنجه با ما مکن که نتوانی»","عشق به تقوا می‌گوید که با ما در نیفت، زیرا تو توانایی مقابله با ما را نداری."],[610,"چه خبر دارد از حقیقت عشق؟","پای‌بند هوای نفسانی","کسی که عاشق واقعی نیست و فقط به خواسته‌های نفسانی خود وابسته است، از ماهیت واقعی عشق بی‌خبر است."],[610,"خودپرستان نظر به شخص کنند","پاک‌بینان به صنع ربانی","خودپرستان فقط به ظاهر و شخصیت افراد نگاه می‌کنند، اما افرادی که پاک‌بین هستند، به خلقت و آفرینش الهی توجه دارند."],[610,"شب قدری بود که دست دهد","عارفان را سماع روحانی","شبیست که ارزش و فضیلت مخصوصی دارد و در آن، عارفان می‌توانند به تجربیات روحانی و موسیقی معنوی دست پیدا کنند."],[610,"رقص وقتی مسلمت باشد","کآستین بر دو عالم افشانی","رقص زمانی زیبا و دلنشین است که در آن، آستین‌ها را برای هر دو جهان یعنی دنیای مادی و معنوی بگشایی و شادی خود را در میان همه پخش کنی."],[610,"قصه عشق را نهایت نیست","صبر پیدا و درد پنهانی","قصه عشق پایانی ندارد و برای آن، صبر تمام نشدنی و دردی نهان لازم است."],[610,"سعدیا دیگر این حدیث مگوی","تا نگویند قصه می‌خوانی","سعدی، دیگر از این داستان عشق صحبت نکن، تا این‌که دیگران نگویند تو داستان می‌سازی یا فقط در خیال خود قصه می‌بافی."],[611,"بهار آمد که هر ساعت رود خاطر به بستانی","به غلغل در سماع آیند هر مرغی به دستانی","بهار فرارسیده و در هر لحظه، دل‌ها به سمت باغ‌ها می‌کشاند و هر پرنده‌ای با خوشحالی و شادی، آواز بلند می‌کند."],[611,"دم عیسیست پنداری نسیم باد نوروزی","که خاک مرده باز آید در او روحی و ریحانی","نسیم باد نوروزی مثل دم عیسی (پیامبری که به زنده کردن مردگان معروف است) است، زیرا این باد باعث می‌شود که خاک مرده دوباره زنده شود و روح و عطر تازه‌ای پیدا کند."],[611,"به جولان و خرامیدن در آمد سرو بستانی","تو نیز ای سرو روحانی بکن یک بار جولانی","سروی که در باغ می‌رقصد و به زیبایی راه می‌رود، تو هم ای روحانی و پارسا، یک بار هم بخواه تا با ناز و زیبایی در میان مردم به نمایش بیایی."],[611,"به هر کویی پری رویی به چوگان می‌زند گویی","تو خود گوی زنخ داری بساز از زلف چوگانی","در هر کوی و برزنی، دختر زیبایی در حال بازی با چوگان است و این‌طور به نظر می‌رسد که تو هم مانند آن گوی زنخ‌داری، یعنی به خاطر زیبایی و زلف‌ات، می‌توانی چوگانی بسازی."],[611,"به چندین حیلت و حکمت که گوی از همگنان بردم","به چوگانم نمی‌افتد چنین گوی زنخدانی","با ترفندها و زیرکی‌های زیادی توانستم گوی را از رقبای هم‌عرضم بگیرم، اما هرگز نتوانستم گوی زنخدانی، یعنی گویی که نشانه زیبایی و دلجویی است، به چوگان بیفکنم."],[611,"بیار ای باغبان سروی به بالای دلارامم","که باری من ندیدستم چنین گل در گلستانی","باغبان، سروی زیبا و خوش‌قد را برای من بیاور که هیچ‌گاه در هیچ باغی چنین گلی زیبا ندیده‌ام."],[611,"تو آهو چشم نگذاری مرا از دست تا آن گه","که همچون آهو از دستت نهم سر در بیابانی","ای چشمان تو همچون آهو زیبا و دلرباست که نباید من را رها کنی، تا زمانی که من نیز به مانند آهو از چشمانت دور شوم و به بیابانی بیفتم."],[611,"کمال حسن رویت را صفت کردن نمی‌دانم","که حیران باز می‌مانم چه داند گفت حیرانی","من نمی‌دانم چگونه می‌توان زیبایی چهره‌ات را توصیف کرد، زیرا هر بار که تلاش می‌کنم، بیشتر دچار حیرت و شگفتی می‌شوم و در این سردرگمی نمی‌توانم چیزی بگویم."],[611,"وصال توست اگر دل را مرادی هست و مطلوبی","کنار توست اگر غم را کناری هست و پایانی","دوست داشتن و رسیدن به تو، اگر دل من آرزویی دارد، تنها در وصال تو تحقق می‌یابد و اگر غمی وجود دارد، تنها در نزد تو می‌تواند پایان یابد."],[611,"طبیب از من به جان آمد که سعدی قصه کوته کن","که دردت را نمی‌دانم برون از صبر درمانی","طبیب به تنگ آمده و خسته است و از سعدی می‌خواهد که داستان دردش را کوتاه کند، زیرا او نمی‌داند درمانی برای این درد که فراتر از صبر است، وجود دارد."],[612,"جمعی که تو در میان ایشانی","زآن جمع به در بود پریشانی","تویی که در میان این جمع قرار داری، این جمع به خاطر تو همگی آرامند و سردرگمی از آن‌ها دور شده است."],[612,"ای ذات شریف و شخص روحانی","آرام دلی و مرهم جانی","ای خداوند بزرگ و شخصیتی روحانی، تو دل را آرام می‌کنی و مانند دارویی برای جان و روح انسان‌ها هستی."],[612,"خرم تن آن که با تو پیوندد","وآن حلقه که در میان ایشانی","کسی که با تو ارتباط و دوستی برقرار کند، خوشحال و خرم است و این دوستی چون حلقه‌ای میانی است که افراد را به هم وصل می‌کند."],[612,"من نیز به خدمتت کمر بندم","باشد که غلام خویشتن خوانی","من هم آماده‌ام که به تو خدمت کنم، باشد که مرا در زمره‌ی غلامان خود به شمار آوری."],[612,"بر خوان تو این شکر که می‌بینم","بی فایده‌ای مگس که می‌رانی","شیرینی و زیبایی که در میهمانی تو دیده‌ام، به هیچ وجه، در مقایسه با کسی که می‌خواهد مگس را دور کند، بی‌فایده نیست."],[612,"هر جا که تو بگذری بدین خوبی","کس شک نکند که سرو بستانی","هر کجا که تو با این زیبایی عبور کنی، هیچ‌کس تردیدی نمی‌کند که تو شبیه به سروهای باغی هستی."],[612,"هرک این سر دست و ساعدت بیند","گر دل ندهد به پنجه بستانی","هر کسی که دست و ساعد تو را ببیند، اگر هم به زیبایی آن دل نبازد، به زاینده بودن و خوش‌تراش بودن آن دست هیچ شکی نخواهد داشت."],[612,"من جسم چنین ندیده‌ام هرگز","چندان که قیاس می‌کنم جانی","من هرگز چنین جسمی را ندیده‌ام، به اندازه‌ای که از آن می‌فهمم، روح و جانش نیز غیرقابل مقایسه است."],[612,"بر دیده من برو که مخدومی","پروانه به خون بده که سلطانی","قدم بر چشمانم بگذار که بزرگ منی، فرمان به ریختن خونم بده که پادشاه منی. /مخدوم: خواجه و سرور / پروانه: اجازه و فرمان / (AI: به چشمان من نگاه کن، زیرا معشوقی چون پروانه با اشتیاق و فداکاری عشقش را در راه سردار و سلطان تقدیم می‌کند.)"],[612,"من سر ز خط تو بر نمی‌گیرم","ور چون قلمم به سر بگردانی","من هرگز از خطی که تو بر من نوشته‌ای (و به یاد تو هستم) جدا نمی‌شوم و اگر تو بخواهی، مانند قلمی که با سرش می‌چرخاند، به دنبالت می‌چرخم."],[612,"این گرد که بر رخ است می‌بینی","وآن درد که در دل است می‌دانی","این گرد و غباری که بر چهره‌ام نشسته می‌بینی، اما آن دردی که در دل دارم، از احوال من با خبری."],[612,"دودی که بیاید از دل سعدی","پیداست که آتشی‌ست پنهانی","سعدی می‌گوید دودی که از دل او بیرون می‌آید، نشان‌دهنده آتش سوزانی در درونش است که پنهان مانده است."],[612,"می‌گوید و جان به رقص می‌آید","خوش می‌رود این سماع روحانی","سعدی می‌گوید وقتی عشق و احساسات ژرف را بیان می‌کند، جانش به وجد می‌آید و خوشی روحانی او را به رقص درمی‌آورد."],[613,"ذوقی چنان ندارد بی دوست زندگانی","دودم به سر برآمد زین آتش نهانی","زندگی بدون دوست لذتی ندارد و مثل این است که دودی بر سرم نشسته باشد، چراکه این آتش پنهانی عذاب‌آور است."],[613,"شیراز در نبسته‌ست از کاروان ولیکن","ما را نمی‌گشایند از قید مهربانی","اگرچه مسیر حرکت کاروان در شیراز باز است و می‌توان از اینجا سفر کرد اما ما همچنان نمی‌توانیم از قید مهربانی رها شویم."],[613,"اشتر که اختیارش در دست خود نباشد","می‌بایدش کشیدن باری به ناتوانی","شتری که اختیاری ندارد باید با ناتوانی و عجز باری را که بر دوشش می‌گذارند حمل کند"],[613,"خون هزار وامق خوردی به دلفریبی","دست از هزار عذرا بردی به دلستانی","خون هزار عاشق چون وامق را ریختی و از هزار زیبارو چون عذرا در زیبایی پیشی گرفته‌ای"],[613,"صورت نگار چینی بی خویشتن بماند","گر صورتت ببیند سر تا به سر معانی","اگر چهره نگارینی مانند تو، خود را از دست بدهد و بی‌هویت شود، این زیبایی بی‌نظیر در صورت تو باعث می‌شود که همه معانی و مفاهیم واقعی عشق را از سر تا پا درک کنند."],[613,"ای بر در سرایت غوغای عشقبازان","همچون بر آب شیرین آشوب کاروانی","ای کسی که در نزدیکی تو هجوم عاشقان و هیجان و جنجال آن‌ها وجود دارد، مانند همهمه‌ای که در کناره آب شیرین برپا می‌شود، این دگرگونی و شلوغی همواره در اطراف تو جریان دارد."],[613,"تو فارغی و عشقت بازیچه می‌نماید","تا خرمنت نسوزد تشویش ما ندانی","تو بی‌خبر هستی و برایت عشق فقط یک سرگرمی به نظر می‌آید، در حالی که ما در دل نگرانیم و نمی‌دانیم تا وقتی که آتش محبت تو ما را نسوزاند، چه بر سرمان می‌آید."],[613,"می‌گفتمت که جانی دیگر دریغم آید","گر جوهری به از جان ممکن بود تو آنی","می‌گویم به تو که اگر جانی دیگر هم داشتم، برایم دردآور است که اگر جواهر باارزشی بهتر از جانم موجود بود، تو همان جواهر محسوب می‌شدی."],[613,"سروی چو در سماعی بدری چو در حدیثی","صبحی چو در کناری شمعی چو در میانی","سرو در زیبایی مانند کسی است که در رقص می‌رقصد، و در کلام مانند یکی است که در داستانی شیرین صحبت می‌کند. صبح مانند نوری است که در گوشه‌ای می‌درخشد و شمعی است که در وسط جمعی روشنایی می‌دهد."],[613,"اول چنین نبودی باری حقیقتی شد","دی حظ نفس بودی امروز قوت جانی","امروز که به حقیقتی دست یافته‌ام، متوجه می‌شوم که آنچه در پیش بود، فقط نشانه‌ای از حقیقتی بزرگ‌تر بود و حالا این پیمودن راه، زندگی و قوت وجود من شده است."],[613,"شهر آن توست و شاهی فرمای هر چه خواهی","گر بی عمل ببخشی ور بی‌گنه برانی","شهر، متعلق به توست و تو شاهی که هرچه بخواهی می‌توانی انجام دهی. اگر کسی کاری نکند و بی‌عمل باشد، نیز می‌توانی او را ببخشی و اگر بی‌گناه باشد، می‌توانی او را دور کنی."],[613,"روی امید سعدی بر خاک آستان است","بعد از تو کس ندارد یا غایة الامانی","سعدی پس از جدایی از تو، تنها به آستان تو امیدوار است و از کسی دیگر انتظاری ندارد یا حتی رویاهایش به پایان رسیده است."],[614,"کبر یک سو نه اگر شاهد درویشانی","دیو خوش‌طبع به از حور گره‌پیشانی","اگر مغروری را کنار گذاشته‌ای، بشنو که درویش‌های خوش‌خلق بهتر از حوری‌های زیبا هستند."],[614,"آرزو می‌کندم با تو دمی در بستان","یا به هر گوشه که باشد که تو خود بستانی","آرزو می‌کنم که لحظه‌ای با تو در باغی باشم، یا در هر جایی که باشد، زیرا تو خود بهشت و زیبایی هستی."],[614,"با من کشته هجران نفسی خوش بنشین","تا مگر زنده شوم زآن نفس روحانی","با من که به خاطر دوری‌ات دل‌شکسته‌ام، لحظه‌ای خوش باش و آرام باش تا شاید از آن نفس پرمهر و معنوی تو زنده شوم."],[614,"گر در آفاق بگردی به جز آیینه تو را","صورتی کس ننماید که بدو می‌مانی","اگر در جهان بگردی، هیچ‌کس را به جز تصویر خودت نمی‌بینی که به خاطر آن می‌ماند."],[614,"هیچ دورانی بی فتنه نگویند که بود","تو بدین حسن مگر فتنه این دورانی","هیچ دوره‌ای را بدون آشوب و فتنه نمی‌دانند و نمی‌گویند که تو با این زیبایی در آن دوره وجود داشته‌ای، مگر اینکه خود زیبایی تو مسبب این فتنه‌ها باشد."],[614,"مردم از ترس خدا سجده رویت نکنند","بامدادت که ببینند و من از حیرانی","مردم از روی ترس خداوند به تو سجده نمی‌کنند، اما من به خاطر حیرت و شگفتی‌ام از زیبایی‌ات، در برابر تو خضوع می‌کنم."],[614,"گرم از پیش برانی و به شوخی نروم","عفو فرمای که عجز است نه بی فرمانی","اگر تو از قبل مرا دور کنی و من به شوخی نروم، لطف کن و ببخشای چون این ناتوانی است، نه بی‌اختیاری."],[614,"نه گزیر است مرا از تو نه امکان گریز","چاره صبر است که هم دردی و هم درمانی","من نمی‌توانم از تو فرار کنم و هیچ راهی برای دوری از تو وجود ندارد. تنها راه حل این است که صبر کنم، زیرا تو هم درد من هستی و هم درمان آن."],[614,"بندگان را نبود جز غم آزادی و من","پادشاهی کنم ار بنده خویشم خوانی","غم آزادی فقط مخصوص بندگان است و اگر تو مرا بنده بخوانی، من هم می‌توانم خود را پادشاه حساب کنم."],[614,"زین سخن‌های دلاویز که شرح غم توست","خرمنی دارم و ترسم به جوی نستانی","از این حرف‌های شیرینی که درباره غم تو می‌زنم، انبوهی دارم و می‌ترسم که آن را در رود جوی‌ باد نبرند."],[614,"تو که یک روز پراکنده نبوده‌ست دلت","صورت حال پراکنده‌دلان کی دانی","تو که در یک روز هم دلت ناراحت و ناآرام نبوده، حال و روز کسی که همیشه دلش پراکنده است را چگونه می‌فهمی؟"],[614,"نفسی بنده‌نوازی کن و بنشین ار چند","آتشی نیست که او را به دمی بنشانی","ای کسی که به من محبت می‌کنی، لحظه‌ای به من توجه کن و بنشین، هرچند که آتش عشق در دل من خاموش شده و نمی‌توانی آن را یک‌باره خاموش کنی."],[614,"سخن زنده‌دلان گوش کن از کشته خویش","چون دلم زنده نباشد که تو در وی جانی","به حرف‌های انسان‌های زنده گوش کن و ببین آن‌ها درباره کشته دل خود چه می‌گویند، زیرا وقتی دل من زنده نیست، تو هم در آن موجودیتی نداری."],[614,"این توانی که نیایی ز در سعدی باز","لیک بیرون روی از خاطر او نتوانی","هرچند تو نمی‌توانی به خانه سعدی بیایی، اما نمی‌توانی او را از خاطر خود فراموش کنی."],[615,"ندانمت به حقیقت که در جهان به که مانی","جهان و هر چه در او هست صورتند و تو جانی","نمی‌دانم به راستی در این دنیا باید با چه کسی بمانم، زیرا جهان و همه چیزهایی که در آن وجود دارند فقط ظاهری دارند و تو حقیقت وجودی هستی."],[615,"به پای خویشتن آیند عاشقان به کمندت","که هر که را تو بگیری ز خویشتن برهانی","عاشقان، به خاطر تو به پا می‌افتند و در دام محبّت تو گرفتار می‌شوند، زیرا هر کسی را که تو به دام بیندازی، از خود رها می‌کنی."],[615,"مرا مپرس که چونی به هر صفت که تو خواهی","مرا مگو که چه نامی به هر لقب که تو خوانی","از من حال و روزم را نپرس، چون به هر ویژگی‌ای که تو بخواهی، حال من تغییر می‌کند و نام و لقب من هم مهم نیست که به چه چیزی مرا بخوانی."],[615,"چنان به نظره اول ز شخص می‌ببری دل","که باز می‌نتواند گرفت نظره ثانی","به قدری با نگاه اول به یک شخص جذب می‌شوی که دیگر نمی‌توانی دوباره به او نگاه کنی و از اینکه دل‌تنگ او نشوی، کاری از دستت برنمی‌آید."],[615,"تو پرده پیش گرفتی و ز اشتیاق جمالت","ز پرده‌ها به درافتاد رازهای نهانی","تو برای نشان دادن زیبایی خود پرده‌ای درست کرده‌ای و به خاطر اشتیاقی که به زیبایی‌ات دارم، رازهای پنهان از پشت پرده‌ها به بیرون آمده است."],[615,"بر آتش تو نشستیم و دود شوق برآمد","تو ساعتی ننشستی که آتشی بنشانی","زمانی که زمام و اختیار کارها را به تو سپردیم تازه علاقمندتر شدیم/ تو هم برای اینکه این شوق در ما کم نشه لحظه ای درنگ نکردی"],[615,"چو پیش خاطرم آید خیال صورت خوبت","ندانمت که چه گویم ز اختلاف معانی","هرگاه که یاد چهره زیبای تو در ذهنم می‌آید، نمی‌دانم باید چه بگویم؛ زیرا معانی مختلف بر من روی می‌آورند و از هم متمایزند."],[615,"مرا گناه نباشد نظر به روی جوانان","که پیر داند مقدار روزگار جوانی","به نظر سعدی، من در نگاه کردن به چهره جوانان گناهی ندارم، زیرا تنها یک پیر می‌تواند به درستی ارزش و زیبایی روزگار جوانی را درک کند."],[615,"تو را که دیده ز خواب و خمار باز نباشد","ریاضت من شب تا سحر نشسته چه دانی","تویی که خوابی یا خماری چه می‌دانی من که تا صبح خوابم نبرده چه رنجی می‌کشم"],[615,"من ای صبا ره رفتن به کوی دوست ندانم","تو می‌روی به سلامت سلام من برسانی","ای باد صبا من راه کوی دوست را نمی‌دانم. تو که آنجا می‌روی سفر به سلامت، یادت باشد که سلام من برسانی"],[615,"سر از کمند تو سعدی به هیچ روی نتابد","اسیر خویش گرفتی بکش چنان که تو دانی","سعدی می‌گوید: هرگز سر از دام تو نمی‌توانم خارج شوم، زیرا تو مرا اسیر خود کرده‌ای؛ پس هرطور که صلاح می‌دانی با من رفتار کن."],[616,"نگویم آب و گل است آن وجود روحانی","بدین کمال نباشد جمال انسانی","وجود انسانی فراتر از جسم و مادیات است و نباید آن را تنها به آب و گل (جسم) محدود کرد؛ زیرا این وجود با کمالات روحانی و زیبایی‌های انسانی پیوند دارد."],[616,"اگر تو آب و گلی همچنان که سایر خلق","گل بهشت مخمّر به آب حیوانی","اگر تو فقط جسمی هستی مانند سایر انسان‌ها که از خاک بهشتی به همراه آب زندگی به وجود آمده،"],[616,"به هر چه خوبتر اندر جهان نظر کردم","که گویمش به تو ماند تو خوبتر ز آنی","هر چه به عنوان زیبایی در این جهان نگاه کردم تا بگویم که به تو شبیه است، فهمیدم که تو از همه آن‌ها زیباتر هستی."],[616,"وجود هر که نگه می‌کنم ز جان و جسد","مرکب است و تو از فرق تا قدم جانی","هر انسانی که به او نگاه می‌کنم، ترکیبی از جان و بدن است، اما تو از سر تا پا فقط جان هستی و هیچ‌گونه وجود مادی نداری."],[616,"گرت در آینه سیمای خویش دل ببرد","چو من شوی و به درمان خویش در مانی","اگر تو در آینه، زیبایی چهره‌ات را ببینی و دلت را تسخیر کند، چنان‌که من دلم را با زیبایی‌ات گرفته‌ام، پس تو هم باید در هنگام درمان درد خود، به عشق و زیبایی‌ات پناه ببری."],[616,"دلی که با سر زلفت تعلقی دارد","چگونه جمع شود با چنان پریشانی","دل کسی که به موی تو وابسته است، چگونه می‌تواند با این آشفتگی که در او به وجود آمده، آرام گیرد؟"],[616,"مرا که پیش تو اقرار بندگی کردم","رواست گر بنوازی و گر برنجانی","برای من که در پیش تو به بندگی خود اعتراف کرده‌ام، موجه است که اگر به من لطف کنی، یا اگر مرا آزاری برسانی."],[616,"ولی خلاف بزرگان که گفته‌اند مکن","بکن هر آن چه بشاید نه هر چه بتوانی","سعدی بر این باور است که برخلاف نظرات بزرگان که می‌گویند باید از انجام کارهایی که ممکن نیست، خودداری کرد، باید هر کاری که شایسته و مناسب است انجام داد، نه صرفا کارهایی که امکان‌پذیر هستند."],[616,"طمع مدار که از دامنت بدارم دست","به آستین ملالی که بر من افشانی","این بیت بیان می‌کند که به چیزهایی که از تو می‌خواهم، امید نداشته باش و گمان نکن که دستم را از دامنت می‌گیرم؛ زیرا تو غم و اندوهی را که بر من می‌گستری، در آستین خودت پنهان کرده‌ای."],[616,"فدای جان تو گر من فدا شوم چه شود","برای عید بود گوسفند قربانی","اگر من برای جان تو فدای شوم، چه اشکالی دارد؟ این کار به منزله قربانی کردن برای عید قربانی است و نشان‌دهنده عشق و احترام عمیق من به توست."],[616,"روان روشن سعدی که شمع مجلس توست","به هیچ کار نیاید گرش نسوزانی","سعدی که نورانی و روشنی‌بخش مجالس توست، اگر او را نتوانی بسوزانی (در غم‌ها و دردها) هیچ فایده‌ای ندارد، زیرا زندگی‌اش بدون شادی و عشق به تو بی‌معناست."],[617,"نه طریق دوستان است و نه شرط مهربانی","که به دوستان یک‌دل سر دست برفشانی","لغت نامه دهخدا: سردست برفشاندن یعنی غضب کردن"],[617,"دلم از تو چون برنجد؟ که به وهم در نگنجد","که جواب تلخ گویی، تو بدین شکردهانی","چگونه ممکن است دلم از تو برنجد؟ در حالی که حتی نمی‌توان تصور کرد که از دهان شیرین همچون شکر تو کلام تلخی بیرون بیاید."],[617,"نفسی بیا و بنشین، سخنی بگو و بشنو","که به تشنگی بمردم، بر آب زندگانی","دلم بیش از این دیگر طاقت دوری تو را ندارد، برآی و نزد من بنشین، کمی گفت‌وگو کن تا من که تشنه محبت و عشق هستم، سیراب شوم."],[617,"غم دل به کس نگویم که بگفت رنگ رویم","تو به صورتم نگه کن که سرایرم بدانی","غم دل را به کسی نمی‌گویم، زیرا او می‌داند که من در چه حالتی هستم؛ کافی است که به رنگ صورتم نگاه کند تا بفهمد چه دردی در دل دارم."],[617,"عجبت نیاید از من، سخنان سوزناکم","عجب است اگر بسوزم چو بر آتشم نشانی","عجیب نیست که من حرف‌های سوزان و دل‌سوزی می‌زنم؛ اگر نشان آتش بر من باشد، انتظار دارید که بسوزم."],[617,"دل عارفان ببردند و قرار پارسایان","همه شاهدان به صورت، تو به صورت و معانی","دل عارفان را به‌دست آوردند و آرامش پارسایان را از بین بردند، زیرا همه شاهدان تنها به ظاهر توجه کردند، ولی تو هم به ظاهر زیبایی و هم به معانی عمیق توجه داری."],[617,"نه خلاف عهد کردم که حدیث جز تو گفتم","همه بر سر زبانند و تو در میان جانی","من خلاف عهد و وعده‌ام عمل نکردم، زیرا هیچ حرفی جز محبت تو نزدم. همه در مورد عشق تو صحبت می‌کنند، و تو خودت در دل و جان من جای داری."],[617,"اگرت به هر که دنیا، بدهند حیف باشد","وگرت به هر چه عقبی، بخرند رایگانی","اگر به هر کسی در دنیا چیزی بدهند، این کار بی‌فایده و بی‌مقدار است و اگر به هر چیزی در آخرت نیز خریداری کنند، این کار نیز به صورت رایگان انجام می‌شود و ارزشی ندارد."],[617,"تو نظیر من ببینی و بدیل من بگیری","عوض تو من نیابم که به هیچ کس نمانی","اگر تو مانند من را ببینی و کسی را جای من بگذاری، هیچ کس دیگری را نمی‌توانم پیدا کنم که به جای تو باقی بماند."],[617,"نه عجب کمال حسنت که به صد زبان بگویم","که هنوز پیش ذکرت، خجلم ز بی زبانی","من بی‌زبان نمی‌توانم زیبایی‌ها و خوبی‌های تو را به‌طور کامل توصیف کنم، بنابراین خجالت‌زده‌ام از اینکه در برابر یاد تو ناتوانم و نمی‌توانم به خوبی حرف بزنم."],[617,"مده ای رفیق! پندم که نظر بر او فکندم","تو میان ما ندانی که چه می‌رود نهانی","ای رفیق! به من نصیحت نکن که به یار نگاه کرده‌ام. تو نمی‌دانی که در درون ما چه راز و احساسی وجود دارد."],[617,"مزن ای عدو! به تیرم که بدین قدر نمیرم","خبرش بگو که جانت، بدهم به مژدگانی","ای دشمن، تو به من زخم نزن، چون به این اندازه نمی‌میرم. به او بگویید که جان من را در عوض بشارت و خبر خوش می‌دهم."],[617,"بت من چه جای لیلی که بریخت خون مجنون","اگر این قمر ببینی، دگر آن سمر نخوانی","ای معشوق من، تو چه نیازی به لیلی داری که مجنون به خاطر عشق او خونش ریخته است؟ اگر تو را ببینم، دیگر عاشق سمر نخواهم شد."],[617,"دل دردمند سعدی، ز محبت تو خون شد","نه به وصل می‌رسانی، نه به قتل می‌رهانی","دل دردمند و عاشق سعدی به خاطر عشق به تو به درد آمده و به خون نشسته است. نه او را به وصل و دیدار می‌رسانی و نه با مرگ و نابودی نجاتش می‌دهی."],[618,"همه کس را تن و اندام و جمال است و جوانی","وین همه لطف ندارد تو مگر سرو روانی","همه انسان‌ها دارای بدن و ظاهر زیبا و جوانی هستند، اما هیچ‌کدام از این‌ها به خوبی و لطف تو نیست، مگر اینکه تو به مانند سرو، روح و زندگی را به همراه داشته باشی."],[618,"نظر آوردم و بردم که وجودی به تو ماند","همه اسم‌اند و تو جسمی همه جسم‌اند و تو جانی","نگاه کردم و دریافتم که وجود تو باقی است، همه افراد فقط نام دارند و تو در واقع جسم هستی، در حالی که همه اجسام موجود در تو زندگی دارند و تو جان آن‌ها هستی."],[618,"تو مگر پرده بپوشی و کست روی نبیند","ور همین پرده زنی پرده خلقی بدرانی","اگر تو پرده‌ات را بپوشانی، هیچ‌کس روی تو را نخواهد دید. اما اگر همین پرده را بدری، پرده‌نشینان (آفریدگان) را از هم متوجه خواهی کرد."],[618,"تو ندانی که چرا در تو کسی خیره بماند","تا کسی همچو تو باشد که در او خیره بمانی","تو نمی‌دانی که چرا دیگران به تو خیره می‌شوند؛ زیرا کسی مانند تو وجود ندارد که تو نیز به او خیره بمانی."],[618,"نوک تیر مژه از جوشن جان می‌گذرانی","من تنک پوست نگفتم تو چنین سخت کمانی","چشمان زیبا و مژه‌های تو مانند تیرهایی تیز هستند که به دل و جان من نفوذ می‌کنند. من با وجود پوستی نازک و حساس، نمی‌گویم که تو به این سختی و سفتی هستی."],[618,"هر چه در حسن تو گویند چنانی به حقیقت","عیبت آن است که با ما به ارادت نه چنانی","هر چه درباره زیبایی و خوبی تو بگویند، حقیقت این است که عیب تو در این است که نسبت به ما به اندازه محبت و ارادت خود نیستی."],[618,"رمقی بیش نمانده‌ست گرفتار غمت را","چند مجروح توان داشت بکش تا برهانی","دیگر رمق و توان زیادی برای تحمل غم تو نمانده است؛ کسی که به شدت در عشق تو آسیب دیده، دیگر نمی‌تواند بیشتر صبر کند، پس برای رها شدن از این درد، او را به مرگ بکش."],[618,"بیش از این صبر ندارم که تو هر دم بر قومی","بنشینی و مرا بر سر آتش بنشانی","دیگر نمی‌توانم تحمل کنم که تو هر بار با دیگران بنشینی و من در عذابی مشابه آتش بمانم."],[618,"گر بمیرد عجب ار شخص و دگر زنده نباشد","که برانی ز در خویش و دگربار بخوانی","اگر کسی بمیرد، چه شگفت‌آور است اگر شخص دیگری زنده نماند که او را از در خود براند و دوباره بخواند."],[618,"سعدیا گر قدمت راه به پایان نرساند","باری اندر طلبش عمر به پایان برسانی","سعدی، اگر رفتن تو به پایان نرسد، حداقل عمرت را در جستجوی او (محبوب) به سر ببری."],[619,"چرا به سرکشی از من عنان بگردانی","مکن که بیخودم اندر جهان بگردانی","چرا به سرکشی و طغیان نسبت به من رو بیاوری؟ نکن که اگر این کار را کنی، من را در این دنیا بی‌هدف و بیهوده می‌کنی."],[619,"ز دست عشق تو یک روز دین بگردانم","چه گردد ار دل نامهربان بگردانی","به خاطر عشق تو ممکن است روزی دین خود را تغییر دهم، اما اگر دل بی‌محبت تو را از خود دور کنم، چه اتفاقی خواهد افتاد؟"],[619,"گر اتفاق نیفتد قدم که رنجه کنی","به ذکر ما چه شود گر زبان بگردانی","اگر به طور اتفاقی هم قدمی به زحمت نیندازی و ما را به یاد نیاوری، چه می‌شود اگر زبانت را از گفتن ما دور کنی؟"],[619,"گمان مبر که بداریم دستت از فتراک","بدین قدر که تو از ما عنان بگردانی","فراموش نکن که هرچند تو می‌توانی ما را کنترل کنی، ما هرگز دست‌بردار نیستیم و همواره به تو و ارتباط‌مان وفادار خواهیم ماند."],[619,"وجود من چو قلم سر نهاده بر خط توست","بگردم ار به سرم همچنان بگردانی","وجود من مانند قلمی است که بر روی نوشته تو قرار گرفته است، پس اگر بخواهی، می‌توانی آن را جایی که می‌خواهی هدایت کنی و تغییر دهی."],[619,"اگر قدم ز من ناشکیب واگیری","و گر نظر ز من ناتوان بگردانی","اگر به خاطر ناتوانی من از دیدن یا ناشکیبی من، از نزد من دور شوی و به نظر من بی‌اعتنا باشی، این موضوع برای من بسیار دشوار و باعث رنج خواهد بود."],[619,"ندانمت ز کجا آن سپر به دست آید","که تیر آه من از آسمان بگردانی","نمی‌دانم آن سپر از کجا به دست می‌آید که بتواند تیر غم و آه من را از آسمان دور کند."],[619,"گرم ز پای سلامت به سر در اندازی","ورم ز دست ملامت به جان بگردانی","اگر از روی سلامت به سر برسی و مراقب خود نباشی، به زمین می‌افتی؛ و اگر از دست ملامت به جانت آسیبی برسد، و به دور خود بچرخانی، دچار مشکل می‌شوی."],[619,"سر ارادت سعدی گمان مبر هرگز","که تا قیامت از این آستان بگردانی","سعدی می‌گوید که هیچ‌گاه به این فکر نکن که از درگاه من دور شوی یا ارتباطت را قطع کنی، زیرا عشق و ارادتم به تو تا ابد ادامه دارد."],[620,"فرخ، صباح آن که تو بر وی نظر کنی","فیروز، روز آن که تو بر وی گذر کنی","صبح کسی که تو به او توجه کنی، مبارک و خوش‌یمن است و همچنین روز کسی که تو از کنار او عبور کنی، برایش خوش‌حال‌کننده و پربرکت خواهد بود."],[620,"آزاد، بنده‌ای که بود در رکاب تو","خرّم، ولایتی که تو آن جا سفر کنی","آزاد حقیقی، بنده‌ای است که در کنار تو زندگی می‌کند. خرم و آباد، سرزمینی است که تو به آن سفر کنی."],[620,"دیگر نبات را نخرد مشتری به هیچ","یک بار اگر تبسّم همچون شکر کنی","اگر حتی یکبار لبخندی به شیرینی شکر بزنی، دیگر هیچ مشتری‌ای نبات را حتی به ارزان ترین قیمت نیز نخواهد خرید."],[620,"ای آفتاب روشن و ای سایه همای","ما را نگاهی از تو تمام است اگر کنی","ای آفتاب روشن و ای سایه‌ خوشبختی، حتی اگر یک نگاه به ما کنی، برای همیشه ما کافی است."],[620,"من با تو دوستی و وفا کم نمی‌کنم","چندان که دشمنی و جفا بیش‌تر کنی","حتی اگر دشمنی و جفا نسبت به من را بیشتر کنی، من هرگز از دوستی و وفاداری‌ام نسبت به تو کم نمی کنم."],[620,"مقدور من سری‌ست که در پایت افکنم","گر زآن که التفات بدین مختصر کنی","اگر هدیه مختصر بنده را بپذیری، تنها چیزی که برای جلب توجه و رضایت تو، از دست من بر می آید این است که سرم را به پایت افکنم [ و خود را قربانی تو کنم]."],[620,"عمری‌ست تا به یاد تو شب روز می‌کنم","تو خفته‌ای که گوش، به آه سحر کنی؟","عمری است که من، شب تا به صبح را به یاد تو سپری می کنم، اما تو شب را به این انگیزه به خواب می گذرانی که آه سحر من را بشنوی؟"],[620,"دانی که رویم از همه عالم به روی توست","زنهار اگر تو روی به رویی دگر کنی","تو خوب می دانی که من از همه عالم روی گردان شده و تمام توجهم معطوف به توست، وای اگر با این وجود، به کسی جز من توجه کنی."],[620,"گفتی که دیر و زود به حالت نظر کنم","آری کنی چو بر سر خاکم گذر کنی","تو به من وعده دادی که دیر یا زود، به من توجه می کنی؛ آری، تو قطعا به من توجه خواهی کرد، اما وقتی که از سر قبرم عبور کنی."],[620,"شرط است سعدیا که به میدان عشق دوست","خود را به پیش تیر ملامت سپر کنی","سعدی! شرط عشق آن است که [در برابر کسانی که از معشوقه تو بدگویی می کنند، از او دفاع کنی و] خود را سپر ملامت و سرزنش قرار دهی [و با تحمل زخم زبانهای مردم، خود را سپر معشوق قرار دهی]."],[620,"وز عقل بهترت سپری باید ای حکیم","تا از خدنگ غمزه خوبان حذر کنی","و ای حکیم! برای در امان ماندن از تیر عشوه معشوق، به سپری بهتر از عقل نیاز داری [زیرا عقل برای در امان ماندن از عشق، کافی نیست]."],[621,"سرو ایستاده به، چو تو رفتار می‌کنی","طوطی خموش به، چو تو گفتار می‌کنی","به در اینجا یعنی بهتر. جمله‌ی امری است. بهتر است که طوطی خاموش باشد. معشوق را با سرو و طوطی قیاس میکند. و بهتر است سرو جای خود را بداند."],[621,"کس دل به اختیار به مهرت نمی‌دهد","دامی نهاده‌ای که گرفتار می‌کنی","هیچ‌کس دلش را تحت تاثیر محبت تو قرار نمی‌دهد؛ تو دام‌هایی گذاشته‌ای که مردم را در عشق خود گرفتار می‌کنی."],[621,"تو خود چه فتنه‌ای؟ که به چشمان ترک مست","تاراج عقل مردم هشیار می‌کنی","تو خود چه آشوبی ایجاد می‌کنی که با چشمان زیبای خود، عقل مردان باهوش را به ویرانی می‌کشانی؟"],[621,"از دوستی که دارم و غیرت که می‌برم","خشم آیدم که چشم به اغیار می‌کنی","از دوستی‌ای که با تو دارم و غیرتی که به تو دارم، خشمگین می‌شوم که به دیگران نگاه می‌کنی."],[621,"گفتی نظر خطاست، تو دل می‌بری رواست؟","خود کرده جرم و خلق گنهکار می‌کنی","تو می‌گویی که نگاه کردن به دیگران نادرست است، اما آیا برای تو که دل مرا می‌بری این کار مجاز است؟ در حالی که خودت مرتکب این خطا شده‌ای و دیگران را نیز گنهکار می‌کنی."],[621,"هرگز فرامشت نشود دفتر خلاف","با دوستان چنین که تو تکرار می‌کنی","هرگز فراموش نخواهد شد آن پرونده نافرمانی که با دوستانت داری، به‌گونه‌ای که تو آن را مکرر انجام می‌دهی."],[621,"دستان به خون تازه بیچارگان خضاب","هرگز کس این کند که تو عیار می‌کنی؟","دستان تو به خون افراد بیچاره آغشته است، آیا کسی مانند تو این کار را می‌کند؟"],[621,"با دشمنان موافق و با دوستان به خشم","یاری نباشد این که تو با یار می‌کنی","تو با دشمنان هم‌دل هستی و با دوستانت خشمگینی. این رفتار تو خوب نیست و نمی‌توانی با این حالت انتظار دوستی داشته باشی."],[621,"تا من سماع می‌شنوم پند نشنوم","ای مدعی نصیحت بی‌کار می‌کنی","هر زمانی که من به شنیدن موسیقی و خوش‌حالی مشغولم، به پند و نصیحت توجهی ندارم. ای کسی که ادعای نصیحت‌گویی را داری، در واقع فقط وقت خود را تلف می‌کنی."],[621,"گر تیغ می‌زنی سپر اینک وجود من","صلح است از این طرف که تو پیکار می‌کنی","اگر چاقو به دست می‌گیری، من برای دفاع از خود سپر نمی‌زنم، چون من صلح‌طلب هستم، اما تو از سمت دیگر در حال جنگ و درگیری هستی."],[621,"از روی دوست تا نکنی رو به آفتاب","کز آفتاب روی به دیوار می‌کنی","اگر به خاطر عشق و دوستی روی خود را به سمت آفتاب نگردانی، به طور غیرمستقیم رویت را به دیوار برگردانده‌ای، زیرا آن آفتاب که نماد عشق و روشنایی است، از روی دوست به تو می‌تابد."],[621,"زنهار سعدی از دل سنگین کافرش","کافر چه غم خورد؟ چو تو زنهار می‌کنی","سعدی از دل سنگین و خشمگین کافر بر تو زنهار می‌دهد، اما کافر چه غم دارد؟ وقتی تو خود به کسی زنهار می‌دهی."],[622,"چشم رضا و مرحمت بر همه باز می‌کنی","چون که به بخت ما رسد این همه ناز می‌کنی","به هرگسی که میرسی با ملایمت و دوستی رفتار می کنی پس چرا وقتی به من میرسی انقدر ناز میکنی؟"],[622,"ای که نیآزموده‌ای صورت حال بی‌دلان","عشق حقیقت است اگر حمل مجاز می‌کنی","تو که هنوز عاشقی را از نزدیک تجربه نکرده‌ای، باید بدانی که عشق حقیقتی عمیق و واقعی است، نه صرفا یک مسأله سطحی و ظاهری که بتوان آن را به شکل مجاز و شکلی فریبنده بپنداری."],[622,"ای که نصیحتم کنی «کز پی او دگر مرو»","در نظر سبکتکین عیب ایاز می‌کنی","ای کسی که مرا نصیحت می‌کنی که دیگر به دنبال او نرو، در نظر سبکتکین (پادشاه مشهور) به ایاز (خدمتکار و دوست وفادار او) عیب می‌گیری."],[622,"پیش نماز بگذرد سرو روان و گویدم","«قبله اهل دل منم، سهو، نماز می‌کنی»","سرو روان به معنای فردی خوش قامت و خوش‌چهره است که به عنوان پیش نماز (امام جماعت) عبور می‌کند و می‌گوید: «من قبله اهل دل هستم»، که نشان می‌دهد او به جای دیگران، خودش را در مقام غایت و هدف قرار می‌دهد و به خیال خود می‌خواهد بگوید که تو در انجام نماز اشتباه می‌کنی."],[622,"دی به امید گفتمش «داعی دولت توام»","گفت «دعا به خود بکن گر به نیاز می‌کنی»","دیروز به او گفتم که تو باعث خوشبختی منی، او پاسخ داد که اگر به چیزی نیاز داری، خودت باید دعا کنی."],[622,"گفتم «اگر لبت گزم، می خورم و شکر مزم»","گفت «خوری اگر پزم، قصه دراز می‌کنی»","گفتم اگر زبان تو را بوسه بزنم، شراب می‌نوشم و شیرینی آن را می‌چشم. او پاسخ داد که اگر از من دلتنگ شوی و بخوری، این باعث می‌شود داستان این دلتنگی طولانی شود."],[622,"سعدی خویش خوانی‌ام پس به جفا برانی‌ام","سفره اگر نمی‌نهی در به چه باز می‌کنی؟","ما سعدی را دوست خود می‌دانیم و اگر به ما ظلم کنیم، سفره‌ای را که برای مهمانی نمینهد، چرا به ما نشان می‌دهد؟"],[623,"دیدار می‌نمایی و پرهیز می‌کنی","بازار خویش و آتش ما تیز می‌کنی","تو در دیدار خود با من حضور نشان می‌دهی اما از نزدیک شدن پرهیز می‌کنی؛ در حالی که بازار عشق و احساس من را پرحرارت و مشتعل می‌کنی."],[623,"گر خون دل خوری فرح‌افزای می‌خوری","ور قصد جان کنی طرب‌انگیز می‌کنی","اگر تو از عشق من سختی بکشی و درد دل بخوری، به جای غم، شادی و خوشحالی می‌آوری؛ و اگر بخواهی به من آسیب برسانی، در واقع لذت و شادابی را به وجود می‌آوری."],[623,"بر تلخ‌عیشی من اگر خنده آیدت","شاید، که خنده شکرآمیز می‌کنی","اگر تو بر تلخ کامی من خنده بزنی، شایسته است زیرا خنده‌ات خوشایند و شکرآور باشد."],[623,"حیران دست و دشنه زیبات مانده‌ام","کآهنگ خون من چه دلاویز می‌کنی","من در حالتی از حیرت و تشویش قرار دارم، به گونه‌ای که زیبایی و دشنه در دست تو را نمی‌توان نادیده گرفت، زیرا تو با آهنگی دلنشین، خون من را تحت تأثیر قرار می‌دهی."],[623,"سعدی گلت شکفت همانا که صبحدم","فریاد بلبلان سحرخیز می‌کنی","چرا که گل تو در صبحگاهان شکفته شده و تو با صدای بلبلان سحرخیز، آهنگ زیبایی خلق می‌کنی."],[624,"روزی به زنخدانت گفتم به سیمینی","گفت ار نظری داری ما را به از این بینی","روزی به معشوقم گفتم: چانه‌ات مانند میوه به نقره‌ای است. گفت: که اگر نظری به ما داری، بهتر از این زیبایی‌ ما را می‌بینی. (AI: روزی به معشوقم گفتم که اگر نظری به ما داری، بهتر از این است که فقط به زیبایی‌ات نگاه کنی.)"],[624,"خورشید و گلت خوانم هم ترک ادب باشد","چرخ مه و خورشیدی باغ گل و نسرینی","اگر بخواهم تو را به خورشید و گل تشبیه کنم، این کار خلاف ادب خواهد بود، چون چرخ (زمان) هم با مه و خورشید و گل و نسرین در این باغ زیبا برابر است."],[624,"حاجت به نگاریدن نبود رخ زیبا را","تو ماه پری‌پیکر زیبا و نگارینی","نیازی نیست که زیبایی چهره را توصیف کنم، زیرا تو خودت ماهی زیبا و دختری بااندام لطیفی هستی."],[624,"بر بستر هجرانت شاید که نپرسندم","کس سوخته‌خرمن را گوید به چه غمگینی؟","شاید در غیبت تو کسی از من نپرسد که چرا به شدت غمگینم و در نهفت جگرم می‌سوزد؛ انگار کسی که تمام دارایی‌اش را از دست داده است."],[624,"بنشین که فغان از ما برخاست در ایامت","بس فتنه که برخیزد هر جا که تو بنشینی","نشسته‌ایم و از درد و مشکلات خود فریاد می‌زنیم؛ در زمانه تو ممکن است هرجا که تو قرار بگیری، مشکلات و فتنه‌ها برافروخته شوند."],[624,"گر بنده خود خوانی افتیم به سلطانی","ور روی بگردانی رفتیم به مسکینی","اگر خود را بنده تو بخوانیم، به مقام سلطنت می‌رسیم، اما اگر از ما روی برگردانی، به مقام مسکینی می‌رسیم."],[624,"کس عیب نیارد گفت آن را که تو بپسندی","کس رد نتواند کرد آن را که تو بگزینی","هیچ‌کس نمی‌تواند عیبی بر چیزی که تو دوست داری بگوید و هیچ‌کس نمی‌تواند چیزی را که تو انتخاب کرده‌ای رد کند."],[624,"عشق لب شیرینت روزی بکشد سعدی","فرهاد چنین کشته‌ست آن شوخ به شیرینی","عشق لب شیرین تو روزی سعدی را خواهد کشت، زیرا فرهاد نیز به خاطر آن دختر (شیرین) به همین سرنوشت دچار شده است."],[625,"شب است و شاهد و شمع و شراب و شیرینی","غنیمت است چنین شب که دوستان بینی","این شب که فرا رسیده، با وجود شاهد، شمع، شراب و شیرینی، بهترین فرصتی است برای دیدار دوستان و لذت بردن از حضور آن‌ها."],[625,"به شرط آن که منت بنده‌وار در خدمت","بایستم، تو خداوندوار بنشینی","اگر شرط این باشد که من به شکل بنده‌وار در خدمت تو قرار بگیرم، تو هم باید با مقام خدایی‌ات نشسته و ارجمند باشی."],[625,"میان ما و شما عهد در ازل رفته‌ست","هزار سال برآید همان نخستینی","بین ما و شما در روز ازل توافقی شده است که حتی با گذشت هزار سال هم هنوز همان عهد و‌توافق اولیه باقی خواهدماند."],[625,"چو صبرم از تو میسر نمی‌شود چه کنم؟","به خشم رفتم و باز آمدم به مسکینی","وقتی نمی‌توانم بر صبر و شکیبایی خود درباره تو پافشاری کنم، چه کار باید بکنم؟ به خاطر خشم، به تو بی‌احترامی کردم اما بعد از مدتی دوباره به حالتی سست و بی‌چاره بازگشتم."],[625,"به حکم آن که مرا هیچ دوست چون تو به دست","نیاید و تو به از من هزار بگزینی","چون هیچ‌کس مانند تو را نمیتوانم پیدا کنم، می‌دانم که تو هم از میان هزاران نفر، من را برخواهی گزید."],[625,"به رنگ و بوی بهار ای فقیر قانع باش","چو باغبان نگذارد که سیب و گل چینی","ای شخص قانع، به زیبایی و خوشبویی که بهار به همراه دارد راضی باش؛ همان‌طور که باغبان اجازه نمی‌دهد که تو گل و سیب بچینی."],[625,"تفاوتی نکند گر ترش کنی ابرو","هزار تلخ بگویی هنوز شیرینی","اگر تو ابروهای خود را در هم کنی و از عصبانیت یا ناراحتی تلخی بگویی، باز هم تأثیری ندارد؛ چون شیرینی روح و رابطه‌ات همچنان باقی خواهد ماند."],[625,"لگام بر سر شیران کند صلابت عشق","چنان کشد که شتر را مهار در بینی","عشق به قدری قدرت و استحکام دارد که می‌تواند کنترل و مدیریت حتی شیرهای وحشی را بر عهده بگیرد، به‌گونه‌ای که گویی کنترل شتر را در دست داری."],[625,"ز نیک‌بختی سعدی‌ست پایبند غمت","زهی کبوتر مقبل که صید شاهینی","سعدی به خاطر عشق و غم تو، خوشبخت است، ای کبوتر خوش‌خبر که در دام شاهین گرفتار شده‌ای."],[625,"مرا شکیب نمی‌باشد ای مسلمانان","ز روی خوب، لکم دینکم ولی دینی","ای مسلمانان! اشتیاق دیدار خوب‌رویان صبر و طاقتی برایم باقی نگذاشته؛[ای شما ظاهربینان که مرا منع و نکوهش می‌کنید،] آئین شما برای خودتان و دین من نیز برای خودم"],[626,"امروز چنانی ای پری‌روی","کز ماه به حسن می‌بری گوی","امروز تو آنچنان زیبا هستی، ای صورت پربهایی که زیبایی‌ات حتی از ماه هم فراتر است."],[626,"می‌آیی و در پی تو عشاق","دیوانه شده دوان به هر سوی","تو ظاهر می‌شوی و به دنبال تو، عاشقان به جنون افتاده و به هر طرف می‌دوند."],[626,"اینک من و زنگیان کافر","وان ملعب لعبتان جادوی","اکنون من مانده‌ام و گیسوان سیاه و کافرکیش یار و آن چهره زیبایی که این گیسوان افسونکار در آن بازی می‌کنند. / زنگیان کافر (گیسوان سیاه). لعبتان جادو (دو چشم افسونگر). ملعب لعبتان جادوی (چهره زیبای معشوق که محل بازی و سحر چشمان سیاه اوست) - منبع: شرح غزل‌های سعدی / دکتر محمدرضا برزگر خالقی / دکتر تورج عقدایی / (AI: من و کافران زنگی، اکنون اینجا هستیم و در این بزم، بازی‌های جادوگری را انجام می‌دهیم.)"],[626,"آورده ز غمزه سحر در چشم","در داده ز فتنه تاب در موی","به وسیله فریب و ناز چشم، جاذبه‌ای سحرآمیز به چشمانش آورده و از فتنه و آرامش در موهایش تاب و زیبایی ایجاد کرده است."],[626,"وز بهر شکار دل نهاده","تیر مژه در کمان ابروی","برای شکار دل‌ها، تیر مژه‌هایش را در کمان ابروی خود گذاشته است."],[626,"نرخ گل و گلشکر شکسته","زآن چهره خوب و لعل دلجوی","به خاطر چهره زیبا و لب‌های همچون لعل (مروارید) محبوب، قیمت گل و عطر آن کاهش یافته است."],[626,"چاکر شده شاه اخترانت","شیر فلکت شده سگ کوی","شاه ستارگان (ماه) خادم و خدمتگزار تو شده‌ و شیر فلک (خورشید) مانند سگی در کوی تو زندگی می‌کند. (AI: خادم و خدمتگزار به ستاره‌های تو شده‌ام و مانند سگی در کوی تو زندگی می‌کنم.)"],[626,"بر بام سراچه جمالت","کیوان شده پاسبان هندوی","بر روی بام زیبایی تو، کیوان (یک ستاره درخشان) به پاسبانی (نگهبانی) هندوی (دختران زیبا و دلربا) قرار گرفته است."],[626,"عارض به مثل چو برگ نسرین","بالا به صفت چو سرو خودروی","چهره‌ات مانند گل نسرین زیبا و عارض تو مانند سرو خوش قامت است."],[626,"گویی به چه شانه کرده‌ای زلف","یا خود به چه آب شسته‌ای روی","گویا تو با چه شانه‌ای زلف‌هایت را آراسته‌اید یا با چه آبی صورتت را شسته‌ای."],[626,"کز روی به لاله می‌دهی رنگ","وز زلف به مشک می‌دهی بوی","تو از چهره‌ات رنگی به لاله‌ها می‌دهی و از زلف‌هایت بویی مانند مشک برمی‌خیزد."],[626,"چون سعدی، صد هزار بلبل","گلزار رخ تو را غزل‌گوی","سعدی می‌گوید اگر من بلبل باشم، صد هزار بلبل در گلزار زیبایی رخ تو را توصیف می‌کنند و درباره‌اش شعر می‌سرایند."],[627,"خواهم اندر پایش افتادن چو گوی","ور به چوگانم زند هیچش مگوی","می‌خواهم مانند گوی (توپ) در زمین بیفتم و قدم بر او بگذارم، اما اگر او با چوگان به من ضربه بزند، هیچ چیزی نگویم."],[627,"بر سر عشاق طوفان گو ببار","در ره مشتاق پیکان گو بروی","بسیاری از مردان عاشق در حال ناراحتی و طوفان عواطف هستند، بنابراین به عشق و محبت، به آن‌ها طعنه بزن و بگو که در دل ما هر کدام از ما عاشقانی داریم که به شدت دلتنگ و خواستار تو هستند."],[627,"گر به داغت می‌کند‌، فرمان ببر","ور به دردت می‌کشد‌، درمان مجوی","اگر کسی به خاطر عشق و دلتنگی تو رنج می‌برد، به آن رنج فرمان ببر؛ و اگر به خاطر غمت درد می‌کشد، نخواهی یافت که درمانی برای آن وجود دارد."],[627,"ناودان چشم رنجوران عشق","گر فرو ریزند‌، خون آید به جوی","اگر چشم‌ های رنجور و غمگین عاشقان اشک بریزند، خون به جوی می‌ریزد."],[627,"شاد باش ای مجلس روحانیان","تا که خورد این می که من مستم به بوی","ای جمع افرادی که در مقام روحانی و معنوی هستید، خوش باشید و شاد باشید؛ زیرا من به خاطر بوی عطر این شراب، به شدت مست شده‌ام."],[627,"هر که سودا‌نامه سعدی نبشت","دفتر پرهیزگاری گو بشوی","هر کسی که نامه‌ای از عشق و احساسات سعدی را نوشته باید دفتر پرهیزکاری‌اش را بشوید و دور بیندازد، چون عشق و روحانیت او را به سمت دیگر می‌برد."],[627,"هر که نشنیده‌ست وقتی بوی عشق","گو به شیراز آی و خاک من ببوی","هر کسی که هیچگاه بوی عشق را نشنیده است، به شیراز بیا و بوی خاک من را استشمام کن."],[628,"تا کی روم از عشق تو شوریده به هر سوی؟","تا کی دوم از شور تو دیوانه به هر کوی؟","تا کی باید از عشق تو به هر سمت و سو بروم؟ تا کی باید از شدت شوق و جنون تو، دیوانه‌وار در هر خیابان و کوچه به دنبال تو بگردم؟"],[628,"صد نعره همی آیدم از هر بن مویی","خود در دل سنگین تو نگرفت سر موی","من از هر تار موی خود فریادی بلند می‌زنم، اما در دل تو که سنگین و بی‌احساس است، حتی از این نعره‌ها نیز خبری نیست."],[628,"بر یاد بناگوش تو بر باد دهم جان","تا باد مگر پیش تو بر خاک نهد روی","می‌خواهم جانم را در یاد گوش تو در معرض باد قرار دهم تا شاید باد، این جان را به زمین نزدیک تو ببرد و بر خاک تو بیفکند."],[628,"سرگشته چو چوگانم و در پای سمندت","می‌افتم و می‌گردم چون گوی به پهلوی","من چون یک توپ چوگان در پی سمند تو می‌افتم و به دور تو می‌چرخم."],[628,"خود کشته ابروی توام من به حقیقت","گر کشته نیم باز بفرمای به ابروی","من به حقیقت عاشق ابروی تو هستم و اگر هم کشته نشوم، تو باز هم اجازه بده که به ابروی تو نظر بیفکنم."],[628,"آنان که به گیسو دل عشاق ربودند","از دست تو در پای فتادند چو گیسوی","عشاقی که دلشان را با زیبایی گیسوی تو تسخیر کرده‌ای، حالا در برابر تو زانو زده و تسلیم شده‌اند."],[628,"تا عشق سرآشوب تو هم‌زانوی ما شد","سر بر نگرفتم به وفای تو ز زانوی","عشق پرهیاهوی تو باعث شده که من به خاطر تو هرگز از زانوی خود (از حالت ضعف و تسلیم) بلند نشوم و سر نزنم؛ یعنی همچنان وفادار و تسلیم هستم."],[628,"بیرون نشود عشق توام تا ابد از دل","کاندر ازلم حرز تو بستند به بازوی","عشق تو هرگز از دل من خارج نخواهد شد، زیرا در آغاز زندگی‌ام آن را به عنوان دژ و محافظتی محکم در وجودم برافراشته‌ام."],[628,"عشق از دل سعدی به ملامت بتوان برد","گر رنگ توان برد به آب از رخ هندوی","اگر عشق سعدی را از دلش به ملامت ببرند، این امکان‌پذیر است که اگر رنگ آن عشق را از چهره یک زن هندو بزداید، توانستن به آن دست پیدا کند."],[629,"گل است آن یا سمن یا ماه یا روی","شب است آن یا شبه یا مشک یا موی","آن چیزی که تو را زیبا کرده، ممکن است گل، سمن، ماه، یا چهره باشد؛ یا شاید آن را شبی که به زیبایی شباهت دارد، مشک یا مویی بپندارم."],[629,"لبت دانم که یاقوت است و تن سیم","نمی‌دانم دلت سنگ است یا روی","می‌دانم که لب‌هایت مانند یاقوت هستند و بدن تو مانند نقره می‌درخشد، اما قلبت را نمی‌شناسم؛ نمی‌دانم آیا دل‌ات مانند سنگ است یا «فلز روی»."],[629,"نپندارم که در بستان فردوس","بروید چون تو سروی بر لب جوی","نمی‌توانم تصور کنم در باغی به بهشت‌گونه‌ای، موجودی مانند تو که شبیه سروی است، بر لب جوی آب رشد کند."],[629,"چه شیرین‌لب سخنگویی که عاجز","فرو می‌ماند از وصفت سخنگوی","تو آنقدر در کلام و زیبایی‌ لبان خود جذاب و دلنشینی که حتی گویندگان ماهر هم نمی‌توانند درباره تو به خوبی صحبت کنند و از ویژگی‌های تو به درستی وصف کنند."],[629,"به بویی الغیاث از ما برآید","که ای باد از کجا آوردی این بوی","بوی عطری از ما به فریاد برخاسته است، ای باد، این عطر را از کجا آورده‌ای؟"],[629,"الا ای ترک آتشروی ساقی","به آب باده عقل از من فرو شوی","ای ساقی زیبا، با چهره آتشین، بیا و با آب باده خرد، بی‌خبر از خودم، من را شست و شو بده."],[629,"چه شهرآشوبی ای دلبند خودرای","چه بزم‌آرایی ای گلبرگ خودروی","ای عشق قوی و دلربا، چه مقدار آشوب و هیاهو به راه انداخته‌ای، و ای گل حسرت‌انگیز، چگونه این جشن و زیبایی را به وجود آورده‌ای."],[629,"چو در میدان عشق افتادی ای دل","بباید بودنت سرگشته چون گوی","وقتی به میدان عشق وارد شدی، ای دل، باید همیشه سرگردان و حیران باشی، مانند گوی که در بازی‌ها به این سو و آن سو می‌غلتد."],[629,"دلا گر عاشقی می‌سوز و می‌ساز","تنا گر طالبی می‌پرس و می‌پوی","ای دل، اگر عاشق هستی، باید بسوزی و بسازی و اگر جویای عشق هستی، باید بپرسی و در پی آن بروی."],[629,"در این ره جان بده یا ترک ما گیر","بر این در سر بنه یا غیر ما جوی","در این راه یا جانت را فدای ما کن یا ما را ترک کن. بر این در بایست و سر بگذار یا به دنبال چیز دیگر برو. (AI: در این راه یا جانت را فدای ما کن یا به ما وابسته شو. بر این در بایست یا به دنبال چیز دیگر نرو.)"],[629,"بداندیشان ملامت می‌کنندم","که تا چند احتمال یار بدخوی","افرادی که بداندیش هستند از من انتقاد می‌کنند که چرا تا این حد باید به تحمل یک شریک بدخلق ادامه داد. (AI: من از افرادی که بداندیش هستند، انتقاد می‌کنم که چرا تا این حد باید به احتمال داشتن یک شریک بدخلق ادامه داد.)"],[629,"محال است این که ترک دوست هرگز","بگوید سعدی ای دشمن تو می‌گوی","غیر ممکن است که سعدی دوستش را ترک بگوید، ای دشمن تو اینچنین بگو. (AI: غیر ممکن است که کسی که دوستش را ترک کرده، بگوید ای سعدی، من دشمن تو هستم.)"],[630,"مرحبا ای نسیم عنبربوی","خبری زآن به خشم رفته بگوی","ای نسیم خوشبو که بوی عطران دارد، سلام بر تو. خبری از آن کسی که به خاطر خشمش از من دور شده، برایم بیاور."],[630,"دلبر سست‌مهر سخت‌کمان","صاحب دوست‌روی دشمن‌خوی","دلبر من که محبتش پایدار نیست، با چهره‌ای زیبا اما خصال دشوار برخوردار است."],[630,"گو دگر گر هلاک من خواهی","بی‌گناهم بکش بهانه مجوی","اگر می‌خواهی که مرا نابود کنی، دیگر بهانه نیاور و بدون دلیل بکش، چون من بی‌گناه هستم."],[630,"تشنه ترسم که منقطع گردد","ور نه باز آید آب رفته به جوی","می‌ترسم فرد تشنه از دست برود، وگرنه می‌دانم آب رفته به جوی بازنمی‌گردد. (AI: ترسم تشنه بمانم و دیگر نتوانم آب را به جوی بازگردانم، ولی اگر بخواهم، دوباره می‌توان آب را به سمت خودم آورد.)"],[630,"صبر دیدیم در مقابل شوق","آتش و پنبه بود و سنگ و سبوی","صبر ما در برابر شوق به قدری کم است که شوق مانند آتش است و ما در برابر آن مثل پنبه، سنگ و سبو می‌باشیم؛ یعنی در مقابل شدت اشتیاق، تحمل‌مان اندک و ناپایدار است."],[630,"هر که با دوستی سری دارد","گو دو دست از مراد خویش بشوی","هر کس که رابطه‌ای با دوستی دارد، باید از خواسته‌ها و آمال خود دست بردارد."],[630,"تا گرفتار خم چوگانی","احتمالت ضرورت است چو گوی","تا گرفتار خم و پیچ راه و مسیر وجودت نشوی، احتمالش هست که از زنده بودن، به معنای واقعی زندگی کردن، دور شوی. در واقع، زندگی به ما یادآوری می‌کند که در مسیرهای پرپیچ و خم، محتاط باشیم و از چالش‌ها نترسیم."],[630,"پادشاهان و گنج و خیل و حشم","عارفان و سماع و هایاهوی","پادشاهان و ثروت و جمعیت و خدمتکاران در مقابل عارفان و حالاتی که در سماع (رقص و آواز روحانی) و لذت و شوق ایجاد می‌کند، معنا ندارد."],[630,"سعدیا شور عشق می‌گوید","سخنانت نه طبع شیرین‌گوی","ای سعدی، سخنانت از عشق تو شوق و هیجان دارد و از طبع شیرین‌گویت نیست. (AI: ای سعدی، عشق تو شوق و هیجان زیادی دارد، اما سخنانت از جذابیت و شیرینی کافی برخوردار نیستند.)"],[630,"هر کسی را نباشد این گفتار","عود ناسوخته ندارد بوی","هر کس نمی‌تواند مانند سعدی از عشق سخن بگوید؛ مثل عود سوخته که بوی خوش ندارد و تنها عود سالم می‌تواند عطر خوشی را پخش کند."],[631,"وقت آن آمد که خوش باشد کنار سبزه جوی","گر سر صحرات باشد سروبالایی بجوی","وقت آن فرا رسیده که کنار جوی سبز خوش باشیم، حتی اگر در بیابان باشد و درختان بلندی در اطراف آن باشد."],[631,"ور به خلوت با دلارامت میسر می‌شود","در سرایت خود گل افشان است سبزی گو مروی","اگر در خلوت با دلبرم (دلارام) ملاقات کنم، در سرای خود گل‌ها می‌رویند و سبزی (نرمی و زیبایی) می‌افزایند."],[631,"ای نسیم کوی معشوق این چه باد خرم است؟","تا کجا بودی که جانم تازه می‌گردد به بوی؟","ای نسیم کوی محبوب، این چه بادی است که بسیار خوشبو و خوشایند است؟ تا کجا رفته‌ای که بوی تو جان من را تازه و سرزنده می‌کند؟"],[631,"مطربان گویی در آوازند و مستان در سماع","شاهدان در حالت و شوریدگان در های و هوی","به نظر می‌رسد که نوازندگان در حال نواختن و خواندن هستند و همراهان در حال رقص و شادی هستند. دیده‌بانان در حال تماشا هستند و افرادی که عاشق شده‌اند، در حال هیجان و شور و شوق به سر می‌برند."],[631,"ای رفیق آنچ از بلای عشق بر من می‌رود","گر به ترک من نمی‌گویی به ترک من بگوی","ای دوست، آنچه از درد و مصیبت عشق بر من می‌گذرد، اگر به معشوق ترک‌زبان نمی‌گویی، پس به من بگو."],[631,"ای که پای رفتنت کند است و راه وصل تند","بازگشتن هم نشاید تا قدم داری بپوی","ای کسی که رفتنت به کندی است و راه رسیدن به معشوق سریع، تا زمانی که پا در راه داری، نباید به عقب برگردی."],[631,"گر ببینی گریه زارم ندانی فرق کرد","کآب چشم است این که پیشت می‌رود یا آب جوی","اگر گریه شدید من را ببینی، قادر نخواهی بود تشخیص دهی که این اشک که به سوی تو می‌آید، ناشی از ناراحتی من است یا آب جوی جاری."],[631,"گوی را گفتند کای بیچاره سرگردان مباش","گوی مسکین را چه تاوان است چوگان را بگوی","به گوی (همانند توپ در بازی چوگان) گفته‌اند که ای نادان و بیچاره، چرا در سرگردانی هستی؟ آیا اهمیت و مسئولیتی برای گوی مسکین در این بازی وجود دارد که چیزهایی را که در کوچکی بر دوش دارد، بازگو کند؟"],[631,"ای که گفتی دل بشوی از مهر یار مهربان","من دل از مهرش نمی‌شویم تو دست از من بشوی","ای کسی که به من گفتی از عشق و محبت یار عزیزم دل بکن، باید بگویم که من هرگز از عشق او دل نمی‌کنم، پس تو هم از من دل نکن."],[631,"سعدیا عاشق نشاید بودن اندر خانقاه","شاهد بازی فراخ و زاهدان تنگ‌خوی","ای سعدی، عاشق نباید در خانقاه (محل عبادت) باشد، زیرا در اینجا تماشای معشوق ممکن و آزادی وجود دارد، اما زاهدان (رهروان دین) خیلی محدود و تنگ‌نظر هستند."],[632,"سرو سیمینا به صحرا می‌روی","نیک بدعهدی که بی ما می‌روی","سرو سیمین اشاره به زیبایی و ظرافت دارد و در اینجا به کسی خطاب شده که در حال رفتن به دشت است. شاعر به او می‌گوید که تو به خاطر بدعهدی و بی‌وفایی خودت به این سفر می‌روی و از ما دور می‌شوی."],[632,"کس بدین شوخی و رعنایی نرفت","خود چنینی؟ یا به عمدا می‌روی؟","هیچ کس به این زیبایی و شیرینی نمی‌رسد. آیا تو عمدا به چنین حالتی دچار شده‌ای که اینگونه می‌روی؟"],[632,"روی پنهان دارد از مردم پری","تو پری‌روی آشکارا می‌روی","تو چهره‌ات را از نظر مردم پنهان کرده‌ای، اما زیبایی‌ات را به‌وضوح نشان می‌دهی و به آسانی در میان جامعه نمایان می‌شوی."],[632,"گر تماشا می‌کنی در خود نگر","یا به خوش‌تر زین تماشا می‌روی","اگر مشغول تماشا هستی، بهتر است به درون خودت نگاه کنی، یا از این تماشا بهتر است که بروی و از آنجا دور شوی."],[632,"می‌نوازی بنده را؟ یا می‌کشی؟","می‌نشینی یک نفس؟ یا می‌روی؟","آیا به بنده‌ات توجه می‌کنی و او را نوازش می‌کنی یا او را آزار می‌دهی؟ آیا مدتی کنارت می‌مانی یا دوباره می‌روی؟"],[632,"اندرونم با تو می‌آید ولیک","خائفم گر دست غوغا می‌روی","گوگل: اصطلاح \"دست غوغا رفتن\" در فارسی به معنای ایجاد آشوب، بلوا، هیاهو یا فتنه کردن است. همچنین می‌تواند به معنای تحریک و برانگیختن مردم برای ایجاد درگیری یا آشوب باشد.بنابراین، \"دست غوغا رفتن\" به طور کلی به معنای ایجاد یک وضعیت پر سر و صدا و آشفته است که معمولا با مخالفت و درگیری همراه است.به عبارت دیگر، این اصطلاح به اقدامی اشاره دارد که باعث برهم خوردن نظم و آرامش و ایجاد هرج و مرج می‌شود."],[632,"ما خود اندر قید فرمان توایم","تا کجا دیگر به یغما می‌روی","ما خود تحت کنترل و فرمان تو هستیم، اما نمی‌دانیم تا چه زمانی می‌خواهی همه چیز را به غارت ببری."],[632,"جان نخواهد بردن از تو هیچ دل","شهر بگرفتی به صحرا می‌روی","دل هیچ‌کس نمی‌تواند از تو جدا شود، زیرا تو شهر دل‌ها را به تسخیر خود درآورده‌ای و به صحرا می‌روی."],[632,"گر قدم بر چشم من خواهی نهاد","دیده بر ره می‌نهم تا می‌روی","اگر می‌خواهی پا بر روی چشم من بگذاری، چشمانم را به راهی که تو می‌روی می‌سپارم."],[632,"ما به دشنام از تو راضی گشته‌ایم","وز دعای ما به سودا می‌روی","ما از طریق دشنام‌ها و سرزنش‌های تو به نوعی راضی شده‌ایم و تو همچنان به خاطر معامله‌ای که با ما کرده‌ای، به راه خود ادامه می‌دهی."],[632,"گرچه آرام از دل ما می‌رود","همچنین می‌رو که زیبا می‌روی","هرچند تو با آرامش و سکون از دل ما می‌روی، اما همچنان به زیبایی و جاذبه‌ای که داری، می‌روی."],[632,"دیده سعدی و دل همراه توست","تا نپنداری که تنها می‌روی","سعدی می‌گوید چشمانش و دلش در کنار توست تا فکر نکنی که به تنهایی می‌روی."],[633,"ای باد صبحدم خبر دلستان بگوی","وصف جمال آن بت نامهربان بگوی","ای باد صبحگاهی، به دل‌باختگان خبر بده و زیبایی آن معشوق بی‌رحم را توصیف کن."],[633,"بگذار مشک و بوی سر زلف او بیار","یاد شکر مکن؛ سخنی زآن دهان بگوی","اجازه بده عطر مشک و بوی موی او را بیاورند؛ شکر بی‌فایده است، فقط درباره آن دهان زیبا سخن بگویید."],[633,"بستم به عشق موی میانش کمر چو مور","گر وقت بینی این سخن اندر میان بگوی","من به عشق موی میان او خود را به بند کشیده‌ام، مانند موری که زانو می‌زند؛ اگر زمانی این صحبت را شنیدی، در وسط بگو."],[633,"با بلبلان سوخته‌بال ضمیر من","پیغام آن دو طوطی شکّرفشان بگوی","پیامی را با بلبلان ناراحت و دل‌شکسته درونم به آن دو طوطی پربهار و شیرین‌زبان برسانید."],[633,"دانم که باز بر سر کویش گذر کنی","گر بشنود حدیث منش در نهان بگوی","می‌دانم که باز هم به سر کوی محبوب خواهی آمد اگر حدیث من را در دل کسی بشنود."],[633,"کای دل ربوده از بر من، حکم از آن توست","گر نیز گوییم به مثل ترک جان بگوی","ای دل که از من گرفته شده‌ای، فرمان از آن توست و اگر هم بگویم که مثل یاری را ترک کن، تو همچنان به راه خود ادامه می‌دهی."],[633,"هر لحظه راز دل جهدم بر سر زبان","دل می‌تپد که عمر بشد وارهان بگوی","هر لحظه راز دل من در دل می‌تپد و می‌خواهد که بر زبان بیاید، اما فرصت عمر می‌گذرد و این راز بیان نمی‌شود."],[633,"سرّ دل از زبان نشود هرگز آشکار","گر دل موافقت نکند کای زبان بگوی","راز دل هرگز از زبان برملا نمی‌شود، حتی اگر زبان بگوید؛ زیرا اگر دل در این مورد موافق نباشد، کلام زبان کارساز نخواهد بود."],[633,"ای باد صبح! دشمن سعدی مراد یافت","نزدیک دوستان وی این داستان بگوی","ای باد صبح! به دوستان سعدی بگو که او به اهداف و آرزوهایش دست یافته و این داستان را برایشان بازگو کن."],[634,"ای که به حسن قامتت سرو ندیده‌ام سهی","گر همه دشمنی کنی از همه دوستان بهی","ای کسی که به خاطر زیبایی قامتت مانند سروی را ندیده‌ام، اگرچه همه دشمنی کنی، اما از همه دوستان بهتر هستی."],[634,"جور بکن که حاکمان جور کنند بر رهی","شیر که پایبند شد تن بدهد به روبهی","اگر قرار است که حاکمان ستمگر طوری رفتار کنند، تصور کن که مانند یک شیر (با آنکه قوی و شجاع است) مجبور خواهد شد که تسلیم روباه (نماد فریب و نیرنگ) شود. این بدان معناست که در شرایط ظلم و زور، حتی قوی‌ترین‌ها نیز ممکن است ناچار به گزینه‌های غیراخلاقی شوند."],[634,"از نظرت کجا رود ور برود تو همرهی","رفت و رها نمی‌کنی آمد و ره نمی‌دهی","از دید تو کجا برود کسی که با تو همراه است؟ او رفته و تنها نخواهی گذاشتش، چون هیچ راهی برای رفتن به او نمی‌دهی."],[634,"شاید اگر نظر کنی ای که ز دردم آگهی","ور نکنی اثر کند دود دل سحرگهی","اگر تو به درد من نگاهی بیندازی، شاید متوجه شوی و بر آتش دلم تأثیر بگذاری، حتی اگر در صبح زود که دردم شدیدتر است، بتوانی از دود دل من خبری بگیری."],[634,"سعدی و عمرو زید را هیچ محل نمی‌نهی","وین همه لاف می‌زنیم از دهل میان تهی","سعدی و عمرو زید (دو شخصیت که به قابلیت‌های خود می‌بالند) هیچ ارزشی پیش تو ندارند، اما ما به خاطر خالی بودن خود مان از درون، مدام از خودمان بزرگ‌نمایی می‌کنیم."],[635,"اگرم حیات بخشی وگرم هلاک خواهی","سر بندگی به حکمت بنهم که پادشاهی","اگر تو بخواهی زندگی ببخشی یا مرا هلاک کنی، من با کمال تسلیم و اطاعت، سر ادب و بندگی‌ام را با حکمت تو آماده می‌کنم، زیرا تو پادشاهی."],[635,"من اگر هزار خدمت بکنم گناهکارم","تو هزار خون ناحق بکنی و بی گناهی","مفهوم این بیت این است که اگر من هزار کار نیک و خدمت انجام دهم، باز هم مقصر و گناهکار به حساب می‌آیم؛ در حالی که تو می‌توانی هزاران نفر را نابحق به قتل برسانی و همچنان بی‌گناه باشی."],[635,"به کسی نمی‌توانم که شکایت از تو خوانم","همه جانب تو خواهند و تو آن کنی که خواهی","نمی‌توانم از کسی به تو شکایت کنم، زیرا همه از تو حمایت می‌کنند و تو هر کار که بخواهی انجام می‌دهی."],[635,"تو به آفتاب مانی ز کمال حسن طلعت","که نظر نمی‌تواند که ببیندت کماهی","تو مانند آفتاب هستی که به خاطر زیبایی و کمال چهره‌ات، هیچ چشم و نگری نمی‌تواند تو را به درستی ببیند، مانند ماه که نمی‌تواند به آن زیبایی با تمام جزییاتش نگاه کند."],[635,"من اگر چنان که نهی است نظر به دوست کردن","همه عمر توبه کردم که نگردم از مناهی","من اگر به پیشنهاد تو بخواهم همیشه به دوستی نگاه کنم، تمام عمر توبه کردم که دیگر به گناهان بازنگردم."],[635,"به خدای اگر به دردم بکشی که برنگردم","کسی از تو چون گریزد که تواش گریزگاهی","اگر به من آسیب برسانی، به خدا قسم که از تو دور نمی‌شوم و فرار نمی‌کنم، چون هیچ‌کس مانند تو پناهگاهی برایم ندارد."],[635,"منم ای نگار و چشمی که در انتظار رویت","همه شب نخفت مسکین و بخفت مرغ و ماهی","من، ای محبوب، آن کسی هستم که به خاطر دیدن روی تو همه شب خوابم نبرده است، در حالی که پرنده و ماهی خوابیده‌اند."],[635,"و گر این شب درازم بکشد در آرزویت","نه عجب که زنده گردم به نسیم صبحگاهی","اگر این شب طولانی برای رسیدن به تو ادامه پیدا کند، جای تعجب نیست که به لطف نسیم صبح دوباره زنده شوم."],[635,"غم عشق اگر بکوشم که ز دوستان بپوشم","سخنان سوزناکم بدهد بر آن گواهی","اگر سعی کنم غم عشق را از دوستانم پنهان کنم، سخنان دل‌سوز و پرشور من خود به وضوح گواهی می‌دهد که من در رنج هستم."],[635,"خضری چو کلک سعدی همه روز در سیاحت","نه عجب گر آب حیوان به در آید از سیاهی","خضری (حضرت خضر)، که به عنوان موجودی جاودانه و دانا شناخته می‌شود، همانند نقاشی که سعدی را هر روز در مسافرت و گردش ببیند، نه جای تعجب است اگر آب حیات (آب زندگی جاودان) از تیرگی و سیاهی خارج شود. این بیت به ارتباط بین علم و تجربه و پیوند به زندگی ابدی اشاره دارد."],[636,"نشنیده‌ام که ماهی، بر سر نهد کلاهی","یا سرو با جوانان، هرگز رود به راهی","هرگز نشنیده‌ام که ماهی بر سر خود کلاهی بگذارد، یا این‌که سرو همچون جوانان، به راه بیفتد."],[636,"سرو بلند بستان، با این همه لطافت","هر روزش از گریبان، سر برنکرد ماهی","سرو بلند و زیبا در باغ، با این همه نرمی و لطافت، هر روز از زیر لب‌اش، بر سرش نمی‌نشیند ماهی، یعنی او به اندازه‌ای زیبا و فاخر است که حتی ماهی‌ها هم به او نمی‌رسند."],[636,"گر من سخن نگویم، در حسن اعتدالت","بالات خود بگوید، زین راست‌تر گواهی","اگر من چیزی نگویم، خود حسن اعتدال به خوبی درباره زیبایی من شهادت می‌دهد و بهتر از من گواهی می‌دهد."],[636,"روزی چو پادشاهان، خواهم که برنشینی","تا بشنوی ز هر سو، فریاد دادخواهی","روزهایی خواهد آمد که من نیز مانند پادشاهان بر تخت می‌نشینم تا از هر طرف صدای جستجوی عدالت را بشنوی."],[636,"با لشکرت چه حاجت، رفتن به جنگ دشمن؟","تو خود به چشم و ابرو، بر هم زنی سپاهی","برای جنگ با دشمن به لشکر و نیرو نیازی نیست؛ تنها با زیبایی و جذابیت تو می‌توانی دل‌ها را تسخیر کنی و قدرتی فوق‌العاده ایجاد کنی."],[636,"خیلی نیازمندان، بر راهت ایستاده","گر می‌کنی به رحمت، در کشتگان نگاهی","بسیاری از نیازمندان در مسیر تو ایستاده‌اند؛ اگر به رحمت بر آن‌ها نگاهی کنی، می‌توانی به آن‌ها امید زیادی ببخشی."],[636,"ایمن مشو که روی‌ات، آیینه‌ای‌ست روشن","تا کی چنین بماند، وز هر کناره آهی؟","به خودت مطمئن نباش که چهره‌ات مانند آیینه‌ای شفاف است؛ نمی‌دانیم تا چه زمانی چنین خواهی ماند و از هر طرف نشانه‌هایی از اندوه موجود است."],[636,"گویی چه جرم دیدی، تا دشمنم گرفتی؟","خود را نمی‌شناسم، جز دوستی گناهی","شما به چه گناهی مرا به دشمنی متهم کردی؟ من خود را جز دوست‌داشتن هیچ گناهی نمی‌شناسم."],[636,"ای ماه سرو قامت! شکرانه سلامت","از حال زیردستان، می‌پرس گاه گاهی","ای زیبای بلندقد (مانند سرو)، برای شکرگزاری از سلامتت، لحظه‌ای از حال زیردستانت (افرادی که نسبت به تو پایین‌تر هستند) بپرس و خبر بگیر."],[636,"شیری در این قضیّت، کهتر شده ز موری","کوهی در این ترازو، کم‌تر شده ز کاهی","در این وضعیت، شیر که نماد قدرت و شجاعت است، از نظر مقام و منزلت به اندازه یک مور کوچک شده است، مانند آیا وزنی که در ترازو می‌سنجند، یک کوه که باید بسیار سنگین باشد، حالا به اندازه یک کاه سبکتر شده است."],[636,"ترسم چو بازگردی از دست رفته باشم","وز رستنی نبینی، بر گور من گیاهی","می‌ترسم زمانی که به زندگانی برگردی، من از دست رفته باشم و گلی بر قبر من نکاری، بنابراین هیچ نشانی از من نخواهی دید."],[636,"سعدی به هر چه آید، گردن بنه که شاید","پیش که داد خواهی، از دست پادشاهی؟","سعدی می‌گوید: هر کار و موضوعی که برای یادآوری به ذهنت می‌آید، به آن توجه کن و برای آن اهمیت قائل شو؛ شاید در آینده در نزد کسی که قدرت و نفوذ دارد، به خاطر همین یادآوری، حق خود را بخواهی."],[637,"ندانم از من خسته‌جگر چه می‌خواهی؟","دلم به غمزه ربودی، دگر چه می‌خواهی؟","نمی دانم از من غمگین چه می خواهی حالا که دل من را با ناز و کرشمه از من ربوده ای دیگر از من چه می خواهی؟"],[637,"اگر تو بر دل آشفتگان ببخشایی","ز روزگار من آشفته‌تر چه می‌خواهی؟","اگر قرار باشد تو بر افراد آشفته و پریشان رحم کنی از حال و روزگار من آشفته تر و پریشان تر نخواهی یافت."],[637,"به هرزه عمر من اندر سر هوای تو شد","جفا ز حد بگذشت ای پسر! چه می‌خواهی؟","عمر من بیهوده در آرزوی تو صرف شد ظلم تو از حد گذشت ای پسر از من چه می خواهی؟"],[637,"ز دیده و سر من آن چه اختیار تو است","به دیده هر چه تو گویی، به سر چه می‌خواهی؟","اختیار چشم و سر من در دست توست هر چه فرمان بدهی بروی چشم از سرم چه می خواهی؟"],[637,"شنیده‌ام که تو را التماس شعر رهی‌ست","تو کآن شهد و نباتی، شکر چه می‌خواهی؟","شنیده ام که تو شعر این حقیر را دوست داری تو که معدن شهد و نباتی شعر من که مانند شکر است به چه کارت می آید؟"],[637,"به عمری از رخ خوب تو برده‌ام نظری","کنون غرامت آن یک نظر چه می‌خواهی؟","در تمام عمرم توانستم صرفا یک نگاه به روی زیبای تو بیاندازم چه چیزی به عنوان تاوان آن یک نگاه از من می خواهی؟"],[637,"دریغ نیست ز تو هر چه هست سعدی را","وی آن کند که تو گویی، دگر چه می‌خواهی؟","هر آنچه سعدی دارد از تو دریغ نخواهد کرد و گوش به فرمان تو خواهد بود دیگر از او چه می خواهی؟"],[638,"هر ساعتم اندرون بجوشد خون را","وآگاهی نیست مردم بیرون را","هر لحظه در درون من خون به جوش می‌آید و دیگران از حال من بی‌خبرند."],[638,"الا مگر آن‌ که روی لیلی دیده‌ست","داند که چه درد می‌کشد مجنون را","تنها کسی که چهره لیلی را دیده باشد، می‌داند مجنون چه درد و رنجی را تحمل می‌کند."],[639,"عشاق به درگهت اسیرند بیا","بدخویی تو بر تو نگیرند بیا","عاشقان به درگاه تو گرفتارند، پس به خاطر بدخلقی‌ات بر خودت خرده نگیر و به اینجا بیایید."],[639,"هر جور و جفا که کرده‌ای معذوری","زآن پیش که عذرت نپذیرند بیا","هرچقدر هم که ظلم و ستم کرده‌ای، معذور هستی. قبل از اینکه پوزشت را نپذیرند، بیا."],[640,"ای چشم تو مست خواب و سرمست شراب!","صاحب‌نظران تشنه و وصل تو سراب","چشمان تو خواب‌آلود و سرمست از شراب است، در حالی که خردمندان و صاحب‌نظران به‌دنبال وصال تو هستند، ولی این وصال همچون سراب است و به‌دست نمی‌آید."],[640,"مانند تو آدمی در آباد و خراب","باشد که در آیینه، توان دید و در آب","انسانی مانند تو در خوشی‌ها و بدی‌ها وجود ندارد که توانایی تو را در درک و مشاهده زیبایی‌ها داشته باشد."],[641,"چون دل ز هوای دوست نتوان پرداخت","درمانش تحمل است و سر پیش انداخت","چون انسان نتواند دل از عشق دوست بکند، تنها راه درمان این درد، تحمل کردن آن است و باید سر فرود آورد."],[641,"یا ترک گل لعل همی باید گفت","یا با الم خار همی باید ساخت","برای گفت‌وگو با محبوب یا باید به زیبایی‌های او اشاره کرد (ترک گل لعل) یا باید با زشتی‌ها و سختی‌ها (الم خار) کنار آمد."],[642,"دل می‌رود و دیده نمی‌شاید دوخت","چون زهد نباشد نتوان زرق فروخت","دل انسان در حال رفتن و جدایی است و چشم نمی‌تواند آن را ببندد. وقتی که زهد و پارسایی در کار نباشد، نمی‌توان فریب و نیرنگ را فروش کرد."],[642,"پروانه مستمند را شمع نسوخت","آن سوخت که شمع را چنین می‌افروخت","پروانه بی‌نوایی که به شمع نزدیک بود، نسوخت؛ بلکه خود شمعی که پروانه را می‌سوزاند، به‌خاطر عشق و اشتیاقش سوخت."],[643,"روزی گفتی «شبی کنم دلشادت","وز بند غمان خود کنم آزادت»","روزی گفتی که دلم را شاد می‌کنی و من را از غم‌های خود آزاد خواهی ساخت."],[643,"دیدی که از آن روز چه شب‌ها بگذشت","وز گفته خود هیچ نیامد یادت؟","می‌بینی که از آن روز چقدر شب‌ها گذشت و یاد آن چیزی که گفته بودی هیچ در ذهنت نمانده است؟"],[644,"صد بار بگفتم به غلامان درت","تا آینه دیگر نگذارند برت","چندین بار به خدمتگزاران تو گفتم که دیگر آینه‌ای در برابر تو نگذارند تا زیبایی‌ات را کسی نبیند."],[644,"ترسم که ببینی رخ همچون قمرت","کس باز نیاید دگر اندر نظرت","می‌ترسم اگر تو زیبایی صورتت را بار دیگر ببینی، کسی دیگر را تا ابد در پیش چشمت نخواهی داشت."],[645,"آن یار که عهد دوستاری بشکست","می‌رفت و منش گرفته دامان در دست","یارم که وفای عهد نکرد و پیمان وفاداری را شکست، از من جدا می‌شد در حالیکه من دست به دامان او شده بودم که منصرف شود."],[645,"می‌گفت «دگر باره به خوابم بینی»","پنداشت که بعد از آن مرا خوابی هست","به من می‌گفت: مگر مرا در خواب‌های خود ببینی (دیگر مرا نخواهی دید) او فکر می‌کرد بعد از رفتنش من می‌توانم راحت بخوابم."],[646,"شب‌ها گذرد که دیده نتوانم بست","مردم همه از خواب و من از فکر تو مست","شب‌ها می‌گذرد ولی من نمی‌توانم چشم‌هایم را ببندم. مردم همه در خواب هستند و من از فکر تو مست و گیج شده‌ام."],[646,"باشد که به دست خویش خونم ریزی","تا جان بدهم دامن مقصود به دست","امید دارم که با دست خود خونم را بریزم تا بتوانم جانم را فدای هدفی کنم که تمام آرزوهایم در آن نهفته است."],[647,"هشیار سری بود ز سودای تو مست","خوش آن که ز روی تو دلش رفت ز دست","کسی که در عشق تو به هوش باشد، به خاطر شوق تو دیوانه است و خوش به حال آن کسی که دلش از زیبایی‌های تو پر شده و دیگر دستش از آن دل خالی است."],[647,"بی‌‌تو همه هیچ نیست در ملک وجود","ور هیچ نباشد، چو تو هستی، همه هست","بدون تو، همه چیز در این عالم بی‌ارزش و هیچ است و اگر هیچ هم باشد، باز هم با وجود تو تمامی هستی ملموس و موجود است."],[648,"گر زحمت مردمان این کوی از ماست","یا جرم ترش بودن آن روی از ماست","اگر زحمت و سختی مردم این محله به خاطر ماست، یا اگر این چهره‌ی ترش و بدخلق از ماست، ما باید بیرون بیاییم و تغییر کنیم."],[648,"فردا متغیر شود آن روی چو شیر","ما نیز برون شویم چون موی از ماست","فردا چهره‌ات مانند شیر تغییر خواهد کرد و ما هم مانند مو از آنجا خارج خواهیم شد."],[649,"وه وه که قیامت‌ست این قامت راست","با سرو نباشد این لطافت که تو راست","عجب! قیامت در این قامت راست و زیبای تو به پا شده است، چرا که هیچ درخت سروی نمی‌تواند به این لطافت و زیبایی نزدیک شود."],[649,"شاید که تو دیگر به زیارت نروی","تا مرده نگوید که «قیامت برخاست»","شاید دیگر تو به زیارت نروی و وقتی که بمیری، مرده‌ها بگویند که «قیامت برپا شده است»."],[650,"سرو از قدت اندازه بالا بردست","بحر از دهنت لؤلؤ لالا بردست","تو آن‌قدر بلند و زیبا هستی که شاخ و برگ درخت سرو را به یاد می‌آورم و به خاطر صدایت، دریا مرواریدهایی را که از دهانت خارج می‌شود، به یاد می‌آورم."],[650,"هر جا که بنفشه‌ای ببینم گویم","«مویی ز سرت باد به صحرا بردست»","هر کجا که بنفشه‌ای ببینم، می‌گویم که مویی از سر تو در باد به صحرا رفته است."],[651,"امشب که حضور یار جان افروزست","بختم به خلاف دشمنان پیروزست","امشب که یار با صفا و زیبا کنارم هست، بخت من برخلاف دشمنان قوی و پیروز است."],[651,"گو «شمع بمیر و مه فرو شو» که مرا","آن شب که تو در کنار باشی روزست","ای کاش شمع خاموش شود و ماه هم غروب کند، زیرا وقتی تو در کنارم هستی، دیگر نیاز به نور روز هم ندارم."],[652,"آن شب که تو در کنار مایی روزست","و آن روز که با تو می‌رود نوروزست","شب‌هایی که تو در کنار مایی، شب‌ها روشن و دلپذیر است و روزهایی که با تو می‌گذرد، مثل نوروز یعنی جشن و سرور است."],[652,"دی رفت و به انتظار فردا منشین","دریاب که حاصل حیات امروزست","امروز را غنیمت بشمار و برای فردا منتظر نمان، زیرا آنچه از زندگی به دست می‌آوری، همین لحظه است و نباید آن را از دست بدهی."],[653,"گویند هوای فصل آزار خوش‌ست","بوی گل و بانگ مرغ گلزار خوش‌ست","می‌گویند هوای فصل غم و آزار، خوش است و بوی گل و آواز پرندگان در باغ نیز لذت‌بخش است."],[653,"ابریشم زیر و ناله زار خوشست","ای بی‌خبران! این همه با یار خوش‌ست","دل‌تنگی و اشک و غم که ظاهرا برای دیگران ناخوشایند است، به نظر شاعر زیبا و خوشایند می‌آید، زیرا این احساسات به عشق و معشوق مربوط می‌شود. شاعر به بی‌خبران از عشق می‌گوید که این درد و غم، خود نوعی خوشحالی است چون با یاد یار همراه است."],[654,"خیزم بروم چو صبر نامحتمل‌ست","جان در قدمش کنم که آرام دل‌ست","برمی‌خیزم و می‌روم، چون صبر دیگر ممکن نیست. جانم را در قدم او نثار می‌کنم، زیرا او مایه‌ی آرامش دل من است."],[654,"و اقرار کنم برابر دشمن و دوست","«کآن کس که مرا بکشت از من بحل‌ست»","با کمال میل می‌پذیرم که در برابر دشمن و دوست بیان کنم که آن کسی که مرا کشته، از من برائت دارد و منفک است."],[655,"آن ماه که گفتی ملک رحمانست","این بار اگرش نگه کنی شیطانست","آن دختری که می‌گفتی نعمت و بخشش الهی است، حالا اگر به او نگاه کنی، شیطان به نظر می‌رسد."],[655,"رویی که چو آتش به زمستان خوش بود","امروز چو پوستین به تابستانست","رویی که در فصل زمستان مانند آتش زیبا و دلگون است، امروز در تابستان مانند پوستینی که دیگر کاربرد ندارد، به نظر می‌رسد."],[656,"آن سست وفا که یار دل‌سخت من است","شمع دگران و آتش رخت من است","یار من که به او دل بسته‌ام، خود شخصی ناپایدار و بی‌وفاست، اما او برای دیگران مثل شمعی درخشان است و در عین حال آتش و دردسر زندگی من شده است."],[656,"ای با همه کس به صلح و با ما به خلاف","جرم از تو نباشد گنه از بخت من است","ای تو که با همه افراد به صلح و دوستی رفتار می‌کنی، اما با ما مخالفت می‌ورزی، باید بگویم که تقصیری از تو نیست و این بدبختی من ناشی از تقدیر و بخت من است."],[657,"از بس که بیازرد دل دشمن و دوست","گویی به گناه مسخ کردندش پوست","به خاطر اینکه دل هر دو، یعنی دشمن و دوست را خیلی آزار داده، به نظر می‌رسد به خاطر این گناه، پوست او را به شکلی تغییر داده‌اند."],[657,"وقتی غم او بر همه دلها بودی","اکنون همه غمهای جهان بر دل اوست","در گذشته، غم او بر دل تمامی افراد اثرگذار بود، اما اکنون او خود بار غم‌های جهان را به دوش می‌کشد."],[658,"ای در دل من رفته چو خون در رگ و پوست","هرچ آن به سر آیدم ز دست تو نکوست","ای تو که در وجود من به اندازه خون در رگ‌ها و پوست‌هایم نفوذ کرده‌ای، هر چیزی که بر سرم بیاید از جانب تو خوب و نیکوست."],[658,"ای مرغ سحر تو صبح برخاسته‌ای","ما خود همه شب نخفته‌ایم از غم دوست","ای پرنده صبح، تو به صبح برخاسته‌ای، در حالی که ما تمام شب را به خاطر غم عشق بی‌خوابی کشیده‌ایم."],[659,"چون حال بدم در نظر دوست نکوست","دشمن ز جفا گو ز تنم برکن پوست","حال بد من برای دوست، خوب به نظر نمی‌رسد، پس در این حالت دشمن با بی‌رحمی هر چه بیشتر، پوست من را نیز از تنم جدا کند."],[659,"چون دشمن بی‌رحم فرستاده اوست","بدعهدم اگر ندارم این دشمن دوست","اگر دشمن بی‌رحم، نماینده محبوب من است، بنابراین غداری و خیانت من دیگر مهم نیست، حتی اگر این دشمن را دوست نداشته باشم."],[660,"غازی ز پی شهادت اندر تک و پوست","وآن را که غم تو کشت، فاضل‌تر ازوست","غازی که به دنبال شهادت است، در تلاش و جستجوست، اما کسی که به خاطر غم تو جان باخته، از او برتر و ارزشمندتر است."],[660,"فردای قیامت این بدان کی ماند","کآن کشته دشمن‌ست و آن کشته دوست؟","در روز قیامت، مهم نیست که چه کسی کشته شده است؛ آیا او کسی است که به دست دشمنان افتاده یا به دست دوستان."],[661,"گر دل به کسی دهند باری به تو دوست","کت خوی خوش و بوی خوش و روی نکوست","اگر کسی را به دل بدهند، به تو می‌رسد، ای دوست؛ زیرا که زیبایی‌های تو شامل خوبی اخلاق، خوشبویی و چهره نیکوست."],[661,"از هر که وجود صبر بتوانم کرد","الا ز وجودت که وجودم همه اوست","من می‌توانم از هر کسی صبر را درخواست کنم، اما نمی‌توانم از تو که تمام وجودم به تو وابسته است، انتظار صبر داشته باشم."],[662,"گر زخم خورم ز دست چون مرهم دوست","یا مغز برآیدم چو بادام از پوست","اگر از طرف دوست آسیب ببینم، طوری‌که مثل بادام از پوستش بیرون بیایم، این درد را به خاطر او تاب می‌آورم و نگران نیستم."],[662,"غیرت نگذاردم که نالم به کسی","تا خلق ندانند که منظور من اوست","به خاطر غیرت و افتخارم اجازه ندادم که به کسی شکایت کنم تا مردم ندانند که مراد من تنها اوست."],[663,"گویند رها کنش که یاری بدخوست","خوبیش نیرزد به درشتی که دروست","می‌گویند او را رها کن چون یارش آدم بدی است، اما خوبی او ارزش ندارد که با بداخلاقی و رفتار زشت او مقایسه شود."],[663,"بالله بگذارید میان من و دوست","نیک و بد و رنج و راحت از دوست نکوست","به خدا قسم، اجازه بدهید میان من و دوستم، نیکی و بدی و رنج و راحت از دوستی نیکو جدا شود."],[664,"شب نیست که چشمم آرزومند تو نیست","وین جان به لب رسیده در بند تو نیست","هر شبی نیست که من چشم انتظار تو نباشم و این جان هم که به لب رسیده، وابسته به تو نیست."],[664,"گر تو دگری به جای من بگزینی","من عهد تو نشکنم که مانند تو نیست","اگر تو کسی دیگر را به جای من انتخاب کنی، من به عهد و پیمان خود با تو وفادار می‌مانم، زیرا هیچ‌کس به اندازه تو برای من ارزشمند نیست."],[665,"با دوست چنان که اوست می‌باید داشت","خونابه درون پوست می‌باید داشت","برای داشتن دوستی واقعی، باید به او همان‌گونه که هست، نگاه کرد و در درون خود احساسات عمیق و زجرهای پنهان را تحمل کرد."],[665,"دشمن که نمی‌توانمش دید به چشم","از بهر دل تو دوست می‌باید داشت","نباید به دشمن که نمی‌توانم او را به چشم ببینم، توجه کرد، زیرا باید برای دل تو، دوست را حفظ کرد."],[666,"بگذشت و چه گویم که چه بر من بگذشت","سیلاب محبتم ز دامن بگذشت","عشق من به تو به قدری شدید و عمیق است که نمی‌توانم وصف آن را بیان کنم، چرا که این احساس همچون سیلابی است که از دامن من گذر کرده و همه‌چیز را تحت تأثیر قرار داده است."],[666,"دستی به دلم فرو کن ای یار عزیز","تا تیر ببینی که ز جوشن بگذشت","ای دوست عزیز، دستت را در دل من فرو کن تا ببینی چطور تیر عشق به دل من نفوذ کرده و از زره‌ام عبور کرده است."],[667,"روی تو به فال دارم ای حور نژاد","زیرا که بدو بوسه همی نتوان داد","من به چهره زیبا و دل‌کش تو نگاه می‌کنم و به همین خاطر امید دارم، زیرا نتوانم به تو بوسه بزنم."],[667,"فرخنده کسی که فال گیرد ز رخت","تا لاجرم از محنت و غم باشد شاد","کسی که از زیبایی چهره‌ات فال نیکو بگیرد، قطعا به شادی و خوشی خواهد رسید و از درد و غم دور خواهد ماند."],[668,"تو هر چه بپوشی به تو زیبا گردد","گر خام بود اطلس و دیبا گردد","هر چه لباسی بپوشی، بر تو زیبنده است و حتی اگر پارچه‌اش معمولی باشد، به دلیل زیبایی تو با شکوه و دلربا به نظر می‌رسد."],[668,"مندیش که هر که یک نظر روی تو دید","دیگر همه عمر از تو شکیبا گردد","نگران نباش که هر کس فقط یک بار چهره‌ی تو را ببیند، دیگر در تمام عمر نمی‌تواند به کسی غیر از تو عشق بورزد و برای تو صبر کند."],[669,"نوروز که سیل در کمر می‌گردد","سنگ از سر کوهسار در می‌گردد","در سال نو، وقتی که سیل در شکاف‌های زمین و بسترها جاری می‌شود، سنگ‌ها از بالای کوه‌ها به پایین می‌افتند و در حرکت‌اند."],[669,"از چشمه چشم ما برفت این همه سیل","گویی که دل تو سخت‌تر می‌گردد","از چشمان ما چنان اشک و سیل روان شده که گویی دل تو از این موضوع بی‌رحم‌تر می‌شود."],[670,"کس عهد وفا چنان که پروانه خرد","با دوست به پایان نشنیدیم که برد","هیچ‌کس را مانند پروانه کوچک در دوستی نمی‌شناسیم که به عهد وفا پایبند باشد و در نهایت به خاطر عشقش به دوست از پا بیفتد."],[670,"مقراض به دشمنی سرش بر می‌داشت","پروانه به دوستیش در پا می‌مرد","پروانه (که نماد عشق و وفاداری است) در عشق به دوست به خود آسیب می‌زند و جان می‌دهد، در حالی که دشمن به هیچ‌وجه به خود این صدمه را نمی‌زند و بی‌توجهی می‌کند."],[671,"دستارچه‌ای کان بت دلبر دارد","گر بویی ازان باد صبا بردارد","دستارچه‌ای که همراه معشوق است، اگر بویی از نسیم صبح (باد صبا) به خود بگیرد، بسیار خوشبو و ارزشمند خواهد بود."],[671,"بر مرده صد ساله اگر برگذرد","در حال ز خاک تیره سر بردارد","اگر بادی از سمت صبح و نوشی به بویی از دامن دلبر بیافتد، حتی بر جسمی که صد سال از مرگش می‌گذرد، می‌تواند روحی را برآورد و از خاک پوسیده‌اش بالا ببرد."],[672,"گر باد ز گل حسن شبابش ببرد","بلبل نه حریفست که خوابش ببرد","اگر باد، گل زیبایی جوانی او را ببرد، بلبل حریف او نیست که خوابش را ببرد."],[672,"گل وقت رسیدن آب عطار ببرد","عطار به وقت رفتن آبش ببرد","گل در زمان رسیدن آب، آن را می‌برد، و عطار (فروشنده عطر) هم در زمان رفتن، آب آن گل را می‌برد. یعنی زمان بهره‌برداری و استفاده از زیبایی‌ها و نعمت‌ها مهم است."],[673,"کس نیست که غم از دل ما داند برد","یا چاره کار عشق بتواند برد","هیچ‌کس نیست که بداند چه غمی در دل ماست و یا بتواند راه حلی برای مشکلات عشق پیدا کند."],[673,"گفتم که به شوخی ببرد دست از ما","زین دست که او پیاده می‌داند برد","من به شوخی گفتم که او باید از ما جدا شود، چون او خود را در عرصه عشقی که ما داریم، بی‌دست و پا می‌داند."],[674,"هر وقت که بر من آن پسر می‌گذرد","دانی که ز شوقم چه به سر می‌گذرد؟","هر بار که آن پسر به من نگاه می‌کند، می‌دانی که از شدت شوق و هیجان، چه حالتی به سرم می‌آید؟"],[674,"گو هر سخن تلخ که خواهی فرمای","آخر به دهان چون شکر می‌گذرد","هر چیزی که می‌خواهی و ناراحت‌کننده است بگو، اما در نهایت کلامت به مانند شکر شیرین در دهان مؤثر خواهد بود."],[675,"خالی که مرا عاجز و محتال بکرد","خطی برسید و دفع آن خال بکرد","خال زیبایی که باعث ناتوانی و فریب من شده بود، با آمدن خطی (شاید نامه یا پیامی) برطرف شد."],[675,"خال سیهش بود که خونم می‌ریخت","ریش آمد و رویش همه چون خال بکرد","آن خال سیاه که بر صورتش بود، باعث شد که قلب من به شدت بی‌تابی کند و خون از من بریزد؛ اکنون ریش من و چهره‌اش به رنگ آن خال درآمده است."],[676,"چون بخت به تدبیر نکو نتوان کرد","بیفایده سعی و گفت و گو نتوان کرد","اگر خوش اقبالی بر اساس تدبیر خوب پیش نیاید، تلاش بیهوده و صحبت و مناظره هیچ فایده‌ای نخواهد داشت."],[676,"گفتم بروم صبر کنم یک چندی","هم صبر برو که صبر ازو نتوان کرد","به خودم گفتم که مدتی صبر کنم، اما کسی نگفت که صبر کردن از دست من برنمی‌آید."],[677,"شمع ارچه به گریه جانگدازی می‌کرد","گریه‌زده خنده مجازی می‌کرد","هرچند که شمع به خاطر سوختنش و قربانی شدن، غمگین و گریان بود، اما در عین حال ادای خنده را در می‌آورد و خود را شاد نشان می‌داد."],[677,"آن شوخ سرش را ببریدند و هنوز","استاده بد و زبان‌درازی می‌کرد","آن دختر بازیگوش را سرش را بریدند، اما او هنوز ایستاده بود و به زبان‌درازی و شوخی‌هایش ادامه می‌داد."],[678,"ای باد چو عزم آن زمین خواهی کرد","رخ در رخ یار نازنین خواهی کرد","ای باد، اگر قصد سفر به آن دیار را داری، آیا روی در روی یار نازنین هم خواهی شد؟"],[678,"از ماش بسی دعا و خدمت برسان","گو یاد ز دوستان چنین خواهی کرد؟","برای او (یار نازنین) دعا و خدمت بسیار رسانده‌ام، آیا یاد دوستان را این‌گونه فراموش خواهی کرد؟"],[679,"آن دوست که آرام دل ما باشد","گویند که زشتست بهل تا باشد","دوستی که آرامش دل ما را فراهم می‌کند، می‌گویند زشت است، بگذار زشت باشد."],[679,"شاید که به چشم کس نه زیبا باشد","تا یاری از آن من تنها باشد","شاید او در نظر دیگران از نظر زیبایی چندان جذاب نباشد، اما برای من که تنها و نیازمند یاری هستم، اهمیت زیادی دارد."],[680,"آن را که جمال ماه پیکر باشد","در هرچه نگه کند منور باشد","هر که زیبایی‌اش مانند ماه باشد، در هر چیزی که نگاه کند، نور و روشنی می‌آفریند."],[680,"آیینه به دست هرکه ننماید نور","از طلعت بی‌صفای او در باشد","اگر کسی با آینه به چهره‌ای نگاه کند و نور یا زیبایی از آن چهره نبیند، نشان‌دهنده بی‌زینتی و نازیبایی اوست."],[681,"آن را که نظر به سوی هر کس باشد","در دیده صاحبنظران خس باشد","کسی که به همه توجه دارد و به همه نگاه می‌کند، در نظر اهل wisdom و دانش، فردی بی‌ارزش و حقیر است."],[681,"قاضی به دو شاهد بدهد فتوی شرع","در مذهب عشق شاهدی بس باشد","اگر قاضی بخواهد در موضوع عشق حکمی بدهد، نیازی به دو شاهد نیست و یک شاهد کافی است، زیرا عشق خودش به گونه‌ای است که گواهی یک طرف می‌تواند به تنهایی اعتبار داشته باشد."],[682,"هر سرو که در بسیط عالم باشد","شاید که به پیش قامتت خم باشد","هر درخت سروی که در زمین‌های وسیع وجود دارد، ممکن است به خاطر بلندی قامت تو، به احترام تو خم شود."],[682,"از سرو بلند هرگز این چشم مدار","بالای دراز را خرد کم باشد","هرگز به قامت بلند سروهای دیگر نگاه نکن، زیرا نگاه کردن به قامت تو باعث می‌شود که دل از چشم‌های دیگر برود و دیگران را حقیر و کوچک احساس کند."],[683,"گر دست تو در خون روانم باشد","مندیش که آن دم غم جانم باشد","اگر دست تو مرا به قتل برساند، نگران نباش که آن لحظه، غم من خواهد بود."],[683,"گویم چه گناه از من مسکین آمد","کو خسته شد از من غم آنم باشد","من از بی‌پناهی و مسکینی خود می‌گویم؛ آیا گناهی از من سر زده که این‌قدر غمگینم و به خاطر من دلی خسته و غمگین شده است؟"],[684,"بیچاره کسی که بر تو مفتون باشد","دور از تو گرش دلیست پر خون باشد","کسی که عاشق و شیفته تو باشد، بی‌چاره است، زیرا حتی اگر دلی پر از درد و خون داشته باشد، از تو دور است و نمی‌تواند به تو دست یابد."],[684,"آن کش نفسی قرار بی‌روی تو نیست","اندیش که بی‌تو مدتی چون باشد","کسی که بدون تو نفس نمی‌تواند بکشد و آرامش ندارد، نگران است که بدون تو چه مدت می‌تواند دوام بیاورد."],[685,"آهو بره را که شیر در پی باشد","بیچاره چه اعتماد بر وی باشد؟","اگر آهو، بره‌اش تحت مراقبت شیر باشد، معلوم است که در چه وضع ناامنی زندگی می‌کند و نمی‌تواند به او اعتماد کند."],[685,"این ملح در آب چند بتواند بود","وین برف در آفتاب تا کی باشد؟","این نمک در آب چقدر می‌تواند دوام بیاورد و این برف در آفتاب چه مدت می‌ماند؟"],[686,"ما را به چه روی از تو صبوری باشد","یا طاقت دوستی و دوری باشد","چرا باید از تو صبر کنیم و قدرت تحمل دوستی و فراق را داشته باشیم؟"],[686,"جایی که درخت گل سوری باشد","جوشیدن بلبلان ضروری باشد","جایی که درخت گل‌های سوری (گلابی) باشد، لازم است که بلبل‌ها آواز بخوانند و سر و صدا کنند."],[687,"مشنو که مرا از تو صبوری باشد","یا طاقت دوستی و دوری باشد","من نگو که از جدایی تو صبر دارم یا می‌توانم طاقت دوری‌ات را تحمل کنم."],[687,"لیکن چه کنم گر نکنم صبر و شکیب؟","خرسندی عاشقان ضروری باشد","اما چه باید کرد اگر صبر و شکیبایی نداشته باشم؟ چون خوشنودی عاشقان لازمه و ضروری است."],[688,"آن خال حسن که دیدمی خالی شد","وان لعبت با جمال جمالی شد","آن خال زیبایی که من دیدم دیگر در صورتش نیست و آن دختر با جمال دلربایش زیباتر شد."],[688,"چال زنخش که جان درو می‌آسود","تا ریش برآورد سیه چالی شد","چال (چاله) زیبای او که باعث آرامش جانم بود، اکنون به قدری سیاه شده که لب‌هایش هم سیاه شده است."],[689,"دانی که چرا بر دهنم راز آمد","مرغ دلم از درون به پرواز آمد؟","می‌دانی چرا زبانم به بیان رازها باز شده؟ چون دل من مانند مرغی از درونش به پرواز درآمده است."],[689,"از من نه عجب که هاون رویین‌تن","از یار جفا دید و به آواز آمد","تعجبی ندارد که هاون (وسیله‌ای برای کوبیدن و مخلوط کردن مواد) که از فلز ساخته شده، از یار خود آسیب دیده و به صدا درآمده است."],[690,"روزی نظرش بر من درویش آمد","دیدم که معلم بداندیش آمد","روزی نگاه او به من درویش افتاد و متوجه شدم که معلمی بدجنس و ناپسند به نزد من آمده است."],[690,"نگذاشت که آفتاب بر من تابد","آن سایه گران چو ابر در پیش آمد","او به‌قدری بر من ستم کرد که اجازه نداد نور خوشبختی و روشنی به من برسد، مثل سایه‌ای که مانند ابر بر سرم افتاده است."],[691,"گفتم شب وصل و روز تعطیل آمد","کان شوخ دوان دوان به تعجیل آمد","گفتم که شب وصال (اتحاد) و روز استراحت (تعطیل) رسیده است، زیرا آن معشوقه بازیگوش با شتاب و عجله به سمت ما می‌آید."],[691,"گفتم که نمی‌نهی رخی بر رخ من","گفتا برو ابلهی مکن پیل آمد","گفتم که چرا بر من نگاه نمی‌کنی؟ او پاسخ داد که برو و حماقت نکن، چون او (محبوب) بسیار بزرگ و باعظمت است."],[692,"وقت گل و روز شادمانی آمد","آن شد که به سرما نتوانی آمد","زمانی که گل‌ها شکفته و روز شادی فرا رسیده، دیگر آن کسی که به خاطر سردی، نتوانسته به جمع ما بیاید، دیگر نمی‌تواند بیاید."],[692,"رفت آنکه دلت به مهر ما گرم نبود","سرما شد و وقت مهربانی آمد","کسی که دلش نسبت به محبت ما گرم نبود اکنون رفته است، حالا که هوا سرد شده و زمان مهربانی رسیده، او دیگر در کنار ما نیست."],[693,"در چشم من آمد آن سهی سرو بلند","بربود دلم ز دست و در پای افکند","در چشم من، آن سرو بلند و زیبا، دل مرا ربود و به زیر پاهایش انداخت."],[693,"این دیده شوخ می‌برد دل به کمند","خواهی که به کس دل ندهی دیده ببند","این چشم بازیگوش دل را در دام می‌افکند؛ اگر نمی‌خواهی به کسی دل ببندی، چشم‌هایت را ببند."],[694,"در خرقه توبه آمدم روزی چند","چشمم به دهان واعظ و گوش به پند","مدتی در لباس توبه و زهد به سر بردم، در این مدت چشمم به دهان واعظ بود و به نصایح او گوش می‌دادم."],[694,"ناگاه بدیدم آن سهی سرو بلند","وز یاد برفتم سخن دانشمند","به یک‌باره دیدم آن سرو بلند و باریک‌قد را که با یادآوری‌ام از آن، سخنان عالم را فراموش کردم."],[695,"گویند مرو در پی آن سرو بلند","انگشت‌نمای خلق بودن تا چند؟","می‌گویند به دنبال آن دختر زیبا و قد بلند نرو، زیرا تا کی می‌خواهی مورد تمسخر مردم باشی؟"],[695,"بی‌فایده پندم مده ای دانشمند","من چون نروم؟ که می‌برندم به کمند","ای دانشمند، به من پند بیهوده نده، زیرا من نمی‌توانم دور شوم، چرا که همواره در دام کسانی می‌افتم که مرا به خودشان می‌کشند."],[696,"کس با تو عدو محاربت نتواند","زیرا که گرفتار کمندت ماند","هیچ دشمنی نمی‌تواند با تو جنگ کند، زیرا او در دام عشق تو گرفتار شده است و نمی‌تواند از آن رهایی یابد."],[696,"نه دل دهدش که با تو شمشیر زند","نه صبر که از تو روی برگرداند","او نه می‌تواند دلش را به چنگ تو بدهد تا با تو درگیر شود و نه صبر دارد که از تو روی بگرداند."],[697,"آنان که پری‌روی و شکر گفتارند","حیف‌ست که روی خوب پنهان دارند","کسانی که چهره‌ای زیبا و سخنانی شیرین دارند، افسوس که زیبایی‌شان را پنهان می‌کنند."],[697,"فی‌الجمله نقاب نیز بی‌فایده نیست","تا زشت بپوشند و نکو بگذارند","به طور کلی، پوشاندن چهره هم ممکن است مفید باشد، تا کسانی که چهره‌ای زشت دارند، آن را بپوشانند و چهره‌های زیبا را نشان دهند."],[698,"آن کودک لشکری که لشکر شکند","دایم دل ما چو قلب کافر شکند","این کودک لشکری که با نیروی محبتش ما را دل شکستگی و غم می‌دهد، همیشه دل ما مانند قلب کافری را می‌شکند."],[698,"محبوب که تازیانه در سر شکند","به زانکه ببیند و عنان برشکند","محبوب، که مانند تازیانه بر سر انسان می‌زند و او را مجروح می‌کند، بهتر است این کار را انجام دهد تا اینکه از خشم و غیظ خود در برابر دیگری که او را تحت کنترل دارد، خود را مهار کند."],[699,"کس عیب نظر باختن ما نکند","زیرا که نظر داعی تنها نکند","هیچ‌کس عیب نداشتن ما در عشق و محبت را نمی‌بیند، زیرا که عشق فقط به خاطر خود عاشق است و نه به خاطر کسی دیگر."],[699,"بیکار بهیمه‌ای و کژطبع کسی","کو فرق میان زشت و زیبا نکند","کسی که نتواند تفاوت بین زشت و زیبا را تشخیص بدهد، در حقیقت مانند یک حیوان بیکار است که آگاهی و درکی از محیط خود ندارد."],[700,"مجنون اگر احتمال لیلی نکند","شاید که به صدق عشق دعوی نکند","اگر مجنون شانس دیدن لیلی را نداشته باشد، احتمالا نمی‌تواند به راستی ادعای عشق خود را ثابت کند."],[700,"در مذهب عشق هر که جانی دارد","روی دل ازو به هر که دنیی نکند","در عالم عشق، هرکس که زندگی و روح داشته باشد، دل خود را به کسی می‌دهد که هیچ دنائتی و پستی نداشته باشد."],[701,"آن درد ندارم که طبیبان دانند","دردیست محبت که حبیبان دانند","این درد که من دارم، برای پزشکان قابل تشخیص نیست؛ این دردی است که فقط دوستان واقعی می‌توانند آن را درک کنند."],[701,"ما را غم روی آشنایی کشتست","این حال نباید که غریبان دانند","غم و اندوه چهره آشنایی ما را به شدت رنجور کرده است و این وضع نباید به کسانی که غریبه‌اند، اطلاع داده شود."],[702,"مردان نه بهشت و رنگ و بو می‌خواهند","یا موی خوش و روی نکو می‌خواهند","مردان واقعی بهشت و زیبایی‌های ظاهری یا ویژگی‌های ظاهری مانند موهای زیبا و چهره‌ی خوش‌فرم نمی‌خواهند."],[702,"یاری دارند مثل و مانندش نیست","در دنیی و آخرت هم او می‌خواهند","دوستانی دارند که هیچ‌کس مانند آن‌ها نیست و او در این دنیا و آخرت به دنبال آنان است."],[703,"هر چند که عیبم از قفا می‌گویند","دشنام و دروغ و ناسزا می‌گویند","هرچند که پشت سرم عیب‌هایم را به زبان می‌آورند و دشنام و دروغ و ناسزا می‌گویند،"],[703,"نتوان به حدیث دشمن از دوست برید","دانی چه؟ رها کنیم تا می‌گویند","نمیشود صحبت‌های دشمن را از دوستی جدا کرد. می‌دانی چرا؟ چون اگر بخواهیم این کار را کنیم، باید رها کنیم و بگذاریم هرچه می‌خواهند بگویند."],[704,"با دوست به گرمابه درم خلوت بود","وانروی گلینش گل حمام آلود","با دوست در حمام تنها بودیم و آن چهره زیبای او مثل گلی بود که به آب حمام آغشته شده است."],[704,"گفتا دگر این روی کسی دارد دوست؟","گفتم به گل آفتاب نتوان اندود","دوست از من پرسید آیا کسی دیگر نیز مانند تو زیبایی دارد؟ گفتم که نمی‌توان به زیبایی تو با گل آفتاب که خیلی درخشنده است، به کسی اشاره کرد."],[705,"من دوش قضا یار و قدر پشتم بود","نارنج زنخدان تو در مشتم بود","دیشب سرنوشت و بخت من یار و پشتیبان من بود، و در دستم نارنجی که نشانه و نماد زیبایی تو بود."],[705,"دیدم که همی گزم لب شیرینش","بیدار چو گشتم سر انگشتم بود","وقتی بیدار شدم، متوجه شدم که در کنار لب شیرین او نشسته بودم و از زیبایی‌اش لذت می‌بردم."],[706,"داد طرب از عمر بده تا برود","تا ماه برآید و ثریا برود","زندگی را رها کن و از آن لذت ببر تا زمانی که فرصت داری، زیرا روزگار می‌گذرد و زیبایی‌ها به سرعت می‌آیند و می‌روند."],[706,"ور خواب گران شود بخسبیم به صبح","چندانکه نماز چاشت از ما برود","اگر خواب سنگین شود، بهتر است بخوابیم تا صبح بیاید، چون در این صورت نماز پیش از ظهر (نماز چاشت) از ما فوت می‌شود."],[707,"سودای تو از سرم به در می‌نرود","نقشت ز برابر نظر می‌نرود","علاقه و شوق تو هیچ‌گاه از ذهنم نمی‌رود و تصویر تو از جلو چشمم پاک نمی‌شود."],[707,"افسوس که در پای تو ای سرو روان","سر می‌رود و بی‌تو به سر می‌نرود","متأسفانه، وجود تو باعث می‌شود من دچار اندوه و ناامیدی شوم، زیرا بدون تو احساس خوشی ندارم و خیالم از رفتن به سراغ تو فرار می‌کند."],[708,"من گر سگکی زان تو باشم چه شود؟","خاری ز گلستان تو باشم چه شود؟","اگر من به اندازه یک سگی در کنار تو باشم، چه اتفاقی می‌افتد؟ اگر من به اندازه یک خار از گلستان تو باشم، چه می‌شود؟"],[708,"شیران جهان روبه درگاه تواند","گر من سگ دربان تو باشم چه شود؟","اگر شیران و پادشاهان جهان در درگاه تو باشند، چه مانعی دارد که من فقط به عنوان یک سگ دربان تو باشم؟"],[709,"چون صورت خویشتن در آیینه بدید","وان کام و دهان و لب و دندان لذیذ","وقتی که چهره‌ی خود را در آینه دید، متوجه شد که چگونه دندان‌ها و لب‌های خوش‌فرم و جذابی دارد."],[709,"می‌گفت چنانکه می‌توانست شنید","بس جان به لب آمد که بدین لب نرسید","او می‌گوید هرچقدر تلاش کرد که صدای زیبای لبانش را بشنود، تا زمانی که جانش به لبش رسید، نتوانست به آن لبان دسترسی پیدا کند."],[710,"گر تیر جفای دشمنان می‌آید","دل تنگ مکن که دوست می‌فرماید","اگر دشمنان به تو ظلم و جفا کنند، ناراحت و دلگیر نباش، زیرا دوستت به تو محبت و لطف دارد."],[710,"بر یار ذلیل هر ملامت کاید","چون یار عزیز می‌پسندد شاید","اگر ملامتی به یار بی‌ارزش برسد، نباید نگران بود؛ چون یار محبوب ممکن است آن را بپذیرد."],[711,"من چاکر آنم که دلی برباید","یا دل به کسی دهد که جان آساید","من خدمتگزار کسی هستم که دل را از کسی برباید یا دلش را به کسی بسپارد که در آرامش زندگی کند."],[711,"آن کس که نه عاشق و نه معشوق کسیست","در ملک خدای اگر نباشد شاید","کسی که نه عاشق است و نه معشوق، در عالم خداوند، اگر وجود نداشته باشد، شاید بهتر باشد."],[712,"این ریش تو سخت زود برمی‌آید","گرچه نه مراد بود برمی‌آید","ریش تو خیلی زود در می‌آید، هرچند که من چنین چیزی را نمی‌خواستم."],[712,"بر آتش رخسار تو دلهای کباب","از بس که بسوخت دود برمی‌آید","دودهایی که از سوختن دل‌ها به خاطر زیبایی و آتش چهره‌ات بلند می‌شود، نشان از شدت عشق و عاطفه‌ای است که در دل‌ها برمی‌انگیزی."],[713,"امشب نه بیاض روز برمی‌آید","نه ناله مرغان سحر می‌آید","امشب نه روشنی روز به وجود می‌آید و نه صدای پرندگان صبح شنیده می‌شود."],[713,"بیدار همه شب و نظر بر سر کوه","تا صبح کی از سنگ به در می‌آید","تمام شب بیدار بوده‌ام و به دشت نگاه می‌کنم تا ببینم کی از دل سنگ، آب به در می‌آید."],[714,"هرچند که هست عالم از خوبان پر","شیرازی و کازرونی و دشتی و لر","هر چند که در میان خوبان، افراد عالم و با فضیلتی از شهرهای شیراز، کاشان، دشت و لرستان وجود دارند،"],[714,"مولای منست آن عربی‌زاده حر","کاخر به دهان حلو می‌گوید مر","مولا (سید) من همان عربی‌زاده آزاد است که در دهانش کلام شیرین و گوارایی دارد."],[715,"بستان رخ تو گلستان آرد بار","وصل تو حیات جاودان آرد بار","وجود زیبای تو مانند باغی است که شکوفه‌های آن زندگی را به ارمغان می‌آورد و وصال تو زندگی ابدی و جاودانه‌ای را به همراه دارد."],[715,"بر خاک فکن قطره‌ای از آب دو لعل","تا بوم و بر زمانه جان آرد بار","اگر قطره‌ای از آب لب لعل تو بر روی زمین بریزیم، تا به وسیله آن، زمانه جان پیدا کند و حیات بگیرد."],[716,"از هرچه کنی مرهم ریش اولیتر","دلداری خلق هرچه بیش اولیتر","هر چه به دیگران کمک کنی و درد و زخم‌هایشان را التیام بخشی، برای تو بهتر و ارزشمندتر است، چون دلداری به مردم همیشه ارزش بیشتری دارد."],[716,"ای دوست به دست دشمنانم مسپار","گر می‌کشیم به دست خویش اولیتر","ای دوست، مرا به دست دشمنانم نسپار، زیرا اگر می‌خواهم بمی‌روم، بهتر است خودم این کار را انجام دهم."],[717,"ای دست جفای تو چو زلف تو دراز","وی بی‌سببی گرفته پای از من باز","دست بی‌وفایی تو مانند زلف‌های تو، طولانی و پیچیده است و بدون هیچ دلیلی، از من فاصله گرفته‌ای."],[717,"ای دست از آستین برون کرده به عهد","وامروز کشیده پای در دامن باز","ای دستی که از آستین بیرون آمده و به عهدی وفا نکرده، امروز پای خود را در دامن من کشیده‌ای."],[718,"تا سر نکنم در سرت ای مایه ناز","کوته نکنم ز دامنت دست نیاز","تا زمانی که در سر تو نروم، ای محبوب عزیز، از درخواست و نیازم از دامن تو دست برنمی‌دارم."],[718,"هر چند که راهم به تو دورست و دراز","در راه بمیرم و نگردم ز تو باز","هرچند که مسیر رسیدن به تو طولانی و دشوار است، ولی اگر در این راه بمیرم، هرگز از تو روی بر نخواهم گرداند."],[719,"نامردم اگر زنم سر از مهر تو باز","خواهی بکشم به هجر و خواهی بنواز","اگر از عشق تو دست بکشم و به مهر تو پشت کنم، بی‌شک تو آدمیت را از من سلب خواهی کرد؛ از یک طرف به خاطر جدایی از تو رنج می‌کشم و از طرف دیگر به محبت و نوازش تو نیاز دارم."],[719,"ور بگریزم ز دستت ای مایه ناز","هر جا که روم پیش تو می‌آیم باز","هر چقدر هم که از تو دور شوم و فرار کنم، چون تو سرچشمه محبت و دل‌باختگی من هستی، در هر مکانی که بروم دوباره به سوی تو برمی‌گردم."],[720,"ای ماه شب‌افروز شبستان‌افروز","خرم تن آنکه با تو باشد شب و روز","ای ماهی که شب‌ها را روشن می‌کنی و زیبا می‌سازی، خوشا به حال آن کسی که همیشه در کنار تو باشد و شب و روزش را با تو سپری کند."],[720,"تو خود به کمال خلقت آراسته‌ای","پیرایه مکن، عرق مزن، عود مسوز","تو خود به زیبایی تمام آفریده شده‌ای، پس خود را با زیورآلات زینت نکن، عرق مکن و عود نسوزان."],[721,"یا روی به کنج خلوت آور شب و روز","یا آتش عشق بر کن و خانه بسوز","اگر می‌خواهی از عشق و عاشقی در تنهایی بهره‌مند شوی، باید به دور از دیگران به خلوت بروی، یا اگر نمی‌توانی چنین کنی، آتش عشق را شعله‌ور کن و همه چیز را به آتش بکش."],[721,"مستوری و عاشقی به هم ناید راست","گر پرده نخواهی که درد، دیده بدوز","عشق و پنهانی بودن با هم سازگار نیست. اگر نمی‌خواهی پرده را کنار بزنی، باید چشم‌پوشی کنی و از دردهای عشق آگاه نشوی."],[722,"رویی که نخواستم که بیند همه کس","الا شب و روز پیش من باشد و بس","من آرزو داشتم هیچ‌ کسی جز من چهره‌ یار را نبیند و تنها او پیش من بماند."],[722,"پیوست به دیگران و از من ببرید","یارب تو به فریاد من مسکین رس","او به دیگران پیوست و مرا از خود دور کرد. پروردگارا به فریاد من بیچاره برس."],[723,"گر بیخبران و عیبگویان از پس","منسوب کنندم به هوی و به هوس","اگر نادانان و عیب‌جویان به من نسبت دهند که دلبسته‌ی دنیا و خوشگذرانی هستم، به من اهمیتی نمی‌دهند."],[723,"آخر نه گناهیست که من کردم و بس","منظور ملیح دوست دارد همه‌کس","من گناهی نکرده‌ام و اگر کسی به من اتهام بزند، باید بداند که این فقط نظر خودش است و در این میان، دوست عزیزم هم خواسته‌اش را از همه‌کس پنهان نمی‌کند."],[724,"منعم که به عیش می‌رود روز و شبش","نالیدن درویش نداند سببش","آدم ثروتمند که همیشه در لذت و خوش‌گذرانی است، نمی‌داند که دردی که درویش (فقیر) دارد چه علتی دارد و او همیشه در حال نالیدن است."],[724,"بس آب که می‌رود به جیحون و فرات","در بادیه تشنگان به جان در طلبش","به رغم اینکه آب‌های فراوانی مانند جیحون و فرات از طریق بادیه (بیابان) به سمت دریا می‌روند، انسان‌های تشنه در جستجوی آب به شدت در تلاش هستند و جانشان را در این مسیر می‌گذارند."],[725,"نونیست کشیده عارض موزونش","وآن خال معنبر نقطی بر نونش","صورتش به‌قدری زیباست که هیچ حرف یا علامتی نمی‌تواند وصف آن را کامل کند و آن خال زیبا که بر گونه‌اش قرار دارد، همچون نقطه‌ای است بر حرف «نون»."],[725,"نی خود دهنش چرا نگویم نقطیست","خط دایره‌ای کشیده پیرامونش","چرا از دهنش بگویم که خود مانند نقطه‌ای است که دور آن خط دایره‌ای کشیده شده، به‌طوری‌که حلقه‌ای اطرافش تشکیل می‌دهد؟"],[726,"گویند مرا صوابرایان به هوش","چون دست نمی‌رسد به خرسندی کوش","مردم می‌گویند که صبر، کار عاقلانه‌ای است، اما وقتی به خوشحالی نمی‌رسم، دیگر چه فایده دارد؟"],[726,"صبر از متعذر چه کنم گر نکنم","گر خواهم و گر نخواهم از نرمه گوش","صبر در شرایط سخت و دشوار برایم ممکن نیست، حالا چه بخواهم و چه نخواهم، اگر نتوانم خوشحال باشم."],[727,"همسایه که میل طبع بینی سویش","فردوس برین بود سرا در کویش","اگر بخواهی دیدن چهره همسایه‌ات را که مورد پسند و دلخواه تو است، به نظر می‌رسد که بهشت در کنار خانه او قرار دارد."],[727,"وآن را که نخواهی که ببینی رویش","دوزخ باشد بهشت در پهلویش","اگر نمی‌خواهی چهره‌اش را ببینی، بدان که وجود او برای تو همانند دوزخ است و در کنار او بهشت هیچ ارزشی ندارد."],[728,"یا همچو همای بر من افکن پر خویش","تا بندگیت کنم به جان و سر خویش","از من گرامی‌قدر پذیرایی کن، مانند همای (پرنده‌ای بزرگ و پادشاهی) که بال‌های خود را بر کسی می‌افکند، تا من با جان و زندگی‌ام به تو خدمت کنم."],[728,"گر لایق خدمتم ندانی بر خویش","تا من سر خویش گیرم و کشور خویش","اگر نمی‌دانی که لایق خدمت من هستی، من سر و کشور خود را به خاطر تو فدای تو می‌کنم."],[729,"ای بی‌تو فراخای جهان بر ما تنگ","ما را به تو فخرست و تو را از ما ننگ","دنیا برای ما بدون تو، تنگ و ناگوار است، ما به داشتن تو افتخار می‌کنیم، اما برای تو زشت است که با وجود ما احساس برتری کنی."],[729,"ما با تو به صلحیم و تو را با ما جنگ","آخر بنگویی که دل‌ست این یا سنگ؟","ما با تو در صلح و آرامشیم، اما تو با ما دشمنی می‌کنی. آیا نهایتا تو نمی‌توانی بگویی که این رفتار از سر محبت است یا از سنگدلی؟"],[730,"گر دست دهد دولت ایام وصال","ور سر برود در سر سودای محال","اگر روزی روزگار به من اجازه دهد که با معشوق یک جا باشم، حتی اگر این آرزو محال باشد و جانم در این مسیر برود، باز هم راضی‌ام."],[730,"یک بوسه برین نیمه خالی دهمش","از رویش و یک بوسه بران نیمه خال","می‌گوید اگر فرصتی دست دهد، یک بوسه بر نیمه خالی صورت محبوب خواهم زد و همچنین یک بوسه بر نیمه دیگر که خالی مانده است."],[731,"خود را به مقام شیر می‌دانستم","چون خصم آمد به روبهی مانستم","در گذشته خودم را در مقام و مرتبه‌ای والا مثل شیر می‌دانستم، اما وقتی دشمن به من نزدیک شد، مانند روباه، ترسیدم و نتوانستم در برابر او مقاومت کنم."],[731,"گفتم من و صبر اگر بود روز فراق","چون واقعه افتاد بنتوانستم","در زمان جدایی اگر صبر وجود داشت، می‌گفتم من و آن، اما وقتی رخداد جدایی واقع شد، نتوانستم صبر کنم."],[732,"خورشید رخا من به کمند تو درم","بارت بکشم به جان و جورت ببرم","اگر تو بخواهی، من با زیبایی چهره‌ات می‌توانم به دام بیفتم و برای رسیدن به تو، جان و زندگی‌ام را فدای محبتت می‌کنم."],[732,"گر سیم و زرم خواهی و گر جان و سرم","خود را بفروشم و مرادت بخرم","اگر به دنبال مال و ثروت هستی، و یا اگر جان و زندگی‌ام را می‌خواهی، من خود را به فروش می‌رسانم تا آنچه می‌خواهی را به دست بیاوری."],[733,"هر سروقدی که بگذرد در نظرم","در هیأت او خیره بماند بصرم","هر جوانی که از کنارم می‌گذرد، چشمانم به زیبایی او خیره می‌شود و نمی‌توانم از تماشای او دست بکشم."],[733,"چون چشم ندارم که جوان گردم باز","آخر کم از آنکه در جوانان نگرم","چون چشم من به جوانی نمی‌بیند، نمی‌توانم در جوانی قرار بگیرم، اما این موضوع از کمبود من کمتر از دیدن جوانان نیست."],[734,"شبهای دراز بیشتر بیدارم","نزدیک سحر روی به بالین آرم","در شب‌های طولانی، بیشتر بیدار می‌مانم و نزدیک سحر، به سمت بالش می‌روم."],[734,"می‌پندارم که دیده بی دیدن دوست","در خواب رود، خیال می‌پندارم","باید بپذیرم که اگر در خواب هم نباشم و در کنار دوست نباشم، در واقع در خواب به سر می‌برم و فقط خیال می‌کنم."],[735,"از جمله بندگان منش بنده‌ترم","وز چشم خداوندیش افکنده‌ترم","من از میان بندگان، خود را همچون بنده‌ای حقیرتر می‌بینم و از نظر خداوند، حتی به خاطر محبت او، خود را دچار ضعف بیشتری حس می‌کنم."],[735,"با این همه دل بر نتوان داشت که دوست","چندانکه مرا بیش کشد زنده‌ترم","با وجود اینکه دوست به من سختی می‌دهد و مرا به دردسر می‌اندازد، باز هم نمی‌توانم به او توجه دل‌سوزانه‌ای نداشته باشم؛ زیرا هر چه او من را بیشتر اذیت کند، من زنده‌تر و پایدارتر می‌شوم."],[736,"خیزم که نماند بیش ازین تدبیرم","خصم ار همه شمشیر زند یا تیرم","برمی‌خیزم چون دیگر درنگی نمی‌توانم کرد، چه این که اگر دشمن با شمشیر یا تیر به من تعرض کند، دیگر تدبیر من معنایی نخواهد داشت."],[736,"گر دست دهد که آستینش گیرم","ورنه بروم بر آستانش میرم","اگر فرصتی پیش آید که آستین او را بگیرم، این کار را می‌کنم؛ وگرنه می‌روم و به درگاه او خواهم رسید."],[737,"گر بر رگ جان ز شستت آید تیرم","چه خوشتر ازان که پیش دستت میرم","اگر تیر زهرآگین تو به رگ جانم برسد، برای من از این بهتر است که به دست تو بمیرم."],[737,"دل با تو خصومت آرزو می‌کندم","تا صلح کنیم و در کنارت گیرم","من در دل به خاطر تو با آرزوهای خصمانه‌ای روبه‌رو می‌شوم، تا این که با هم آشتی کنیم و بتوانم در کنار تو باشم."],[738,"آن دوست که دیدنش بیاراید چشم","بی‌دیدنش از گریه نیاساید چشم","دوستی که دیدنش باعث خوشحالی چشم می‌شود، بدون دیدن او، چشم هیچگاه از گریه آرام نمی‌گیرد."],[738,"ما را ز برای دیدنش باید چشم","ور دوست نبینی به چه کار آید چشم","اگر نتوانی او را ببینی، دیگر داشتن چشم برای چیست؟ چون ما باید برای دیدن او چشم داشته باشیم."],[739,"آن رفته که بود دل بدو مشغولم","وافکنده به شمشیر جفا مقتولم","کسی که به او علاقه داشتم و دل به او بسته بودم، رفته است و اکنون به واسطه ظلم و جفایش، مانند کسی که با شمشیر کشته شده باشد، در دل آسیب دیده‌ام."],[739,"بازآمد و آن رونق پارینش نیست","خط خویشتن آورد که من معزولم","آن محبوب بازگشته، اما دیگر آن جلال و زیبایی سابق را ندارد؛ او با خود خطای خود را آورده که نشان می‌دهد من از دایره محبت او کنار گذاشته شده‌ام."],[740,"میندیش که سست عهد و بدپیمانم","وز دوستیت فرار گیرد جانم","نگران نباش که من عهدی سست و پیمانی بد دارم، زیرا جانم از دوستی‌ات فراری نمی‌شود."],[740,"هرچند که به خط جمال منسوخ شود","من خط تو همچنان زنخ می‌خوانم","هرچند زیبایی من در گذر زمان کهنه و فراموش شود، من همیشه زیبایی خط تو را به یاد می‌آورم و آن را خواندنی و باارزش می‌دانم."],[741,"من بنده بالای تو شمشاد‌تنم","فرهاد تو شیرین‌دهن خوش‌سخنم","من منشی و خدمت‌گزار تو هستم و مانند فرهاد (که عاشق شیرین بود) به عشق تو زندگی می‌کنم و از هنر و سخن دلنشین تو لذت می‌برم."],[741,"چشمم به دهان توست و گوشم به سخن","وز عشق لبت فهم سخن می‌نکنم","چشمم به لب‌های تو دوخته شده و گوشم به صحبت‌های تو است، و از شدت عشق به لبت، از فهم سخنان خودم ناتوانم."],[742,"هر گه که نظر بر گل رویت فکنم","خواهم که چو نرگس مژه بر هم نزنم","هر بار که به چهره زیبایت نگاه می‌کنم، آرزو دارم که مانند نرگس، مژه‌هایم را نزنم و بی‌حرکت بمانم."],[742,"ور بی‌تو میان ارغوان و سمنم","بنشینم و چون بنفشه سر برنکنم","اگر بدون تو در میان گل‌های ارغوان و گل سمن بنشینم، حتی مانند بنفشه سرم را بالا نخواهم آورد."],[743,"آرام دل خویش نجویم چه کنم؟","وندر طلبش به سر نپویم چه کنم؟","نمی‌توانم آرامش دل خود را پیدا کنم و در حالی که در جستجوی او هستم، سر خود را به خطر نمی‌اندازم، پس چه باید بکنم؟"],[743,"گویند مرو که خون خود می‌ریزی","مادام که در کمند اویم چه کنم؟","می‌گویند تو در عشق خود در حال عذاب و درد هستی، اما وقتی که در دام عشق او گرفتارم، چه می‌توانم بکنم؟"],[744,"گفتم که دگر چشم به دلبر نکنم","صوفی شوم و گوش به منکر نکنم","گفتم دیگر به محبوبم نگاه نکنم و به دور از عشق او رهبان و صوفی شوم و به کارهای ناپسند گوش نزنم."],[744,"دیدم که خلاف طبع موزون من است","توبت کردم که توبه دیگر نکنم","متوجه شدم که عملی که به آن پرداختم، با فطرت و ذوق طبیعی من هماهنگ نیست، بنابراین تصمیم گرفتم که دیگر توبه نکنم."],[745,"من بی تو سکون نگیرم و خو نکنم","بی عارض گلبوی تو گل بو نکنم","من بدون تو آرامش نمی‌یابم و نمی‌توانم به خواب بروم، و بدون داشتن چهره زیبای تو، بوی گل را هم نمی‌چشم."],[745,"گویند فراموش کنش تا برود","الحمد فراموش کنم و او نکنم","می‌گویند فراموشش کن تا راحت شود، اما من نمی‌توانم او را فراموش کنم و او هم مرا فراموش نخواهد کرد."],[746,"خیزم قد و بالای چو حورش بینم","وآن طلعت آفتاب نورش بینم","برمی‌خیزم و قد و قامت کسی را می‌بینم که مانند خورشید زیباست و چهره‌اش مثل آفتاب درخشان است."],[746,"گر ره ندهندم که به نزدیک شوم","آخر نزنندم که ز دورش بینم","اگر اجازه ندهند که به او نزدیک شوم، لااقل از دور او را می‌بینم و دلم به تماشای او شاد می‌شود."],[747,"می‌آیی و لطف و کرمت می‌بینم","آسایش جان در قدمت می‌بینم","هر وقت تو می‌آیی، مهربانی و لطف تو را مشاهده می‌کنم و آرامش جانم را در حضور تو می‌یابم."],[747,"وآن وقت که غایبی همت می‌بینم","هر جا که نگه می‌کنمت می‌بینم","زمانی که تو غایب هستی، تلاش تو برای وجود داشتن و اثرگذارت را حس می‌کنم و هر جایی که به تو نگاه می‌کنم، ردپای تو را می‌بینم."],[748,"چون می‌کشد آن طیره خورشید و مهم","من نیز به ذل و حیف تن در ندهم","وقتی که آن خورشید (که به زیبایی و دلربایی او اشاره دارد) به من توجه و نگاهی می‌کند، من هم هیچ‌گاه خود را در برابر ذلت و بدبختی نخواهم داد."],[748,"باری دو سه بوسه بر دهانش بدهم","وانگه بکشد چو می‌کشد بر گنهم","باید دو یا سه بوسه بر دهانش بزنم و سپس او را مانند می که به گناه می‌کشد، به خودم جذب کنم."],[749,"من با دگری دست به پیمان ندهم","دانم که نیوفتد حریف از تو بهم","من با هیچ‌کس دیگری به دوستی و همکاری نمی‌پردازم، زیرا می‌دانم که رقیب من هرگز نتواند به خوبی تو را از من دور کند."],[749,"دل بر تو نهم که راحت جان منی","ور زانکه دل از تو برکنم بر که نهم؟","دل را به تو می‌سپارم، چون تو آرامش جان من هستی. اگر بخواهم دل را از تو جدا کنم، به چه کسی می‌توانم بدهیم؟"],[750,"ما حاصل عمری به دمی بفروشیم","صد خرمن شادی به غمی بفروشیم","اگر بخواهیم در یک لحظه، تمام عمر خود را از دست بدهیم، همچنین می‌توانیم صدها خوشی و شادی را فدای یک اندوه کنیم."],[750,"در یک دم اگر هزار جان دست دهد","در حال به خاک قدمی بفروشیم","اگر در یک لحظه هزار زندگی نیز فدای ما شود، باز هم حاضر هستیم که به پای آن لحظه که همچون خاک است، چیزی ببخشیم."],[751,"بگذشت بر آب چشم همچون جویم","پنداشت کزو مرحمتی می‌جویم","چشمم به اشک و آب مانند جوی است که می‌گذرد، و او (مقصود شاعر) فکر می‌کند از او طلب مهربانی می‌کنم."],[751,"من قصه خویشتن بدو چون گویم؟","ترکست و به چوگان بزند چون گویم","چگونه باید داستان خودم را به او بگویم؟ او شخصی است که چوگان بازی می‌کند و من نمی‌توانم او را ترک کنم."],[752,"یاران به سماع نای و نی جامه‌دران","ما، دیده به جایی متحیر نگران","یاران در حال شنیدن آواز نای و نی هستند و به مجلس شادی ما آمده‌اند، اما چشمانشان در حالتی حیرت‌زده و متعجب به جایی دوخته شده است."],[752,"عشق آن منست و لهو از آن دگران","من چشم برین کنم شما گوش بر آن","عشق متعلق به من است و شادی و سرگرمی برای دیگران است. من به این عشق توجه می‌کنم و شما به آن سرگرمی گوش می‌دهید."],[753,"یرلیغ ده ای خسرو خوبان جهان","تا پیش قدت چنگ زند سرو روان","ای پادشاه زیبا رویان، مرا به یاری بخوان تا در مقابل زیبایی تو، سروها نیز نتوانند خود را به چنگ بکشانند."],[753,"تا کی برم از دست جفای تو قلان","نی شرع محمدست نی یاسه خان","تا کی از ظلم و نDuringت تو فرار کنم؟ نه دستورات دین محمد (اسلام) این را مجاز می‌داند و نه یاسای خان (قانون یاسا که مربوط به چنگیزخان است) این را قبول دارد."],[754,"من خاک درش به دیده خواهم رفتن","ای خصم بگوی هرچه خواهی گفتن","من خاک در او را با مژگان و اشک خود خواهم رفت، ای دشمن نادان، هرچه می‌خواهی از من بد بگویی، بگوی."],[754,"چون پای مگس که در عسل سخت شود","چندانکه برانی نتواند رفتن","من همچون مگسی هستم که گرفتار عسل شده‌ام و در عسل فرورفته‌ام اگر بخواهم بروم، نمی‌توانم."],[755,"مه را ز فلک به طرف بام آوردن","وز روم، کلیسیا به شام آوردن","می‌توان ماه را از آسمان به زمین و بام خانه پایین آورد، می‌توان کلیسا را از روم به سرزمین شام آورد"],[755,"در وقت سحر نماز شام آوردن","بتوان، نتوان تو را به دام آوردن","می‌توان در وقت سحر، نماز شام را بجای آورد اما نمی‌توان به تو رسید و تو را به‌دام آورد!"],[756,"در دیده به جای سرمه سوزن دیدن","برق آمده و آتش زده خرمن دیدن","اگر بجای سرمه و توتیا، سوزن به‌چشم برود و اگر برق بر خرمن و هستی آدمی بزند و آن‌را خاکستر کند"],[756,"در قید فرنگ غل به گردن دیدن","به زانکه به جای دوست، دشمن دیدن","و اگر آدمی دچار اسارت فرنگی‌ها و بردگی آنها شود؛ بهتر است از آن‌که بجای دوست و یار خود، دشمن را ببیند!"],[757,"ای دوست گرفته بر سر ما دشمن","یا دوست گزین به دوستی یا دشمن","ای دوست، اگر بر سر ما تو دشمنی، پس یا دوست خود را انتخاب کن و یا در دوستی‌ای که داریم، باقی بمان."],[757,"نادیدن دوست گرچه مشکل دردیست","آسانتر ازان که بینمش با دشمن","درد بی‌دوستی با دوست، هرچند مشکل است، اما از این آسان‌تر است که او را در کنار دشمن ببینم."],[758,"ای دست تو آتش زده در خرمن من","تو دست نمی‌گذاری از دامن من","ای دست تو که با زیبایی و لطافت خود، آتش عشق را در وجود من برافروخته‌ای، هرگز از محبت و نزدیکی به من دور نمی‌شوی."],[758,"این دست نگارین که به سوزن زده‌ای","هرچند حلال نیست در گردن من","دستی که تو با سوزن آن را زخمی کرده‌ای، هرچند که از نظر شرع حلال نیست، اما این زخم‌ها برای من به اندازه‌ی پاپوش و زینت به حساب می‌آیند."],[759,"آن لطف که در شمایل اوست ببین","وآن خنده همچو پسته در پوست ببین","لطف و زیبایی که در ظاهر او وجود دارد را مشاهده کن و آن لبخندش را ببین که مثل دانه‌های پسته در پوستش جذاب و دلرباست."],[759,"نی‌نی تو به حسن روی او ره نبری","در چشم من آی و صورت دوست ببین","تو هرگز به زیبایی و نیکویی چهره او نمی‌توانی دسترسی پیدا کنی، پس به چشمان من نگاه کن و زیبایی معشوق را در آن ببین."],[760,"چون جاه و جلال و حسن و رنگ آمد و بو","آخر دل آدمی نه سنگست و نه رو","وقتی که مقام و زیبایی و خوشبویی در میان باشد، در نهایت دل انسان هم مانند سنگ بی‌احساس نیست و ممکن است به آنها جذب شود."],[760,"آن کس که نه راست طبع باشد نه نکو","نه عاشق کس بود نه کس عاشق او","انسانی که نه نیک‌طینت و نه خوش‌خلق است، نه می‌تواند عاشق کسی باشد و نه به عشق کسی در می‌آید."],[761,"یک روز به اتفاق صحرا من و تو","از شهر برون شویم تنها من و تو","در یک روز، من و تو با هم به دشت برویم و از شهر دور شویم و فقط خودمان باشیم."],[761,"دانی که من و تو کی به هم خوش باشیم؟","آن وقت که کس نباشد الا من و تو","ما چه زمانی می‌توانیم با هم خوش باشیم؟ زمانی که هیچ کس جز من و تو در کنارمان نباشد."],[762,"ما را نه ترنج از تو مرادست نه به","تو خود شکری پسته و بادام مده","ما به دنبال ترنج (میوۀ خوشمزه‌ای) از تو نیستیم و نه به تو به خاطر خودت چیزی مانند شیرینی، پسته و بادام بده."],[762,"گر نار ز پستان تو که باشد و مه","هرگز نبود به از زنخدان تو به","اگر نار (آتش) از پستان تو باشد و ماه (زیبایی) هم، هیچ‌یک به اندازه زیبایی و حسن خط خودتو نیستند."],[763,"نه سرو توان گفت و نه خورشید و نه ماه","آه از تو که در وصف نمی‌آیی آه","نه می‌توان در وصف تو به زیبایی سرو، خورشید و ماه سخن گفت، زیرا تو آن‌قدر بی‌نظیری که وصف‌نشدنی هستی و این باعث اندوه من است."],[763,"هرکس به رهی می‌رود اندر طلبت","گر ره به تو بودی نبدی اینهمه راه","هر کسی در جستجوی تو در راهی می‌رود، اگر راه به تو ختم می‌شد، این همه راه طی نمی‌شد."],[764,"ای کاش نکردمی نگاه از دیده","بر دل نزدی عشق تو راه از دیده","ای کاش به دل نمی‌نگریستم و عشق تو را از چشم نمی‌دیدم."],[764,"تقصیر ز دل بود و گناه از دیده","آه از دل و صد هزار آه از دیده","دل انسان در ارتباط با عشق مقصر است و گناه از چشم‌ها و دیده‌ها ناشی می‌شود؛ بنابراین، درد و آه‌هایی که از دل برمی‌آید، هزاران بار تنها از چشمان او قابل مشاهده است."],[765,"ای بی‌رخ تو چو لاله‌زارم دیده","گرینده چو ابر نوبهارم دیده","چشمم بدون دیدن روی تو مانند باختری است که با آرزوهایش در حسرت زندگی می‌کند و مثل ابرهای بهاری، پر از اشک و غم است."],[765,"روزی بینی در آرزوی رخ تو","چون اشک چکیده در کنارم دیده","روزی می‌رسد که در آرزوی چهره تو، چشمان من مانند اشک‌هایی که در کنارم چکیده، غمگین و پرفراق خواهند بود."],[766,"ای مطرب ازان حریف پیغامی ده","وین دل‌شده را به عشوه آرامی ده","ای مطرب، از آن دوست پیغامی برای من بیاور و به این دل غمگین، با محبت آرامش بده."],[766,"ای ساقی از آن دور وفا جامی ده","ور رشک برد حسود، گو جامی ده","ای ساقی، از آن دوری که وفا وجود دارد، به من یک جام بده، و اگر حسود حسرت برد، بگو یک جام بدهد."],[767,"ای راهروان را گذر از کوی تو نه","ما بیخبر از عشق و خبر سوی تو نه","ای رهگذران، از مسیر تو عبور نکنید، ما از عشق و خبر تو بی‌خبر هستیم."],[767,"هر تشنه که از دست تو بستاند آب","از دست تو سیر گردد از روی تو نه","هر کسی که از دست تو آب بنوشد، با دیدن روی تو سیراب می‌شود."],[768,"هرگز بود آدمی بدین زیبایی؟","یا سرو بدین بلند و خوش بالایی؟","آیا هیچ‌کس می‌تواند به زیبایی این فرد باشد؟ یا آیا سرو (درخت سرو) دیگری به این بلند و خوش شکلی وجود دارد؟"],[768,"مسکین دل آنکه از برش برخیزی","خرم تن آنکه از درش بازآیی","کسی که از کنار زیبایی او دور شود، آدمی بیچاره و بی‌زار است، و کسی که به در خانه‌اش بازگردد، خوشحال و راضی است."],[769,"گیرم که به فتوای خردمندی و رای","از دایره عقل برون ننهم پای","اگرچه بر اساس نظر یک فرد عاقل و صاحب خرد، از دایره عقل و منطق خارج نشوم، اما باز هم از احساسات درونی و میل‌های انسانی نمی‌توانم اجتناب کنم."],[769,"با میل که طبع می‌کند چتوان کرد؟","عیبست که در من آفریدست خدای","اگر خودم را مطابق با خواسته‌ها و سلیقه‌های طبیعی‌ام پیش ببرم، چه کار می‌توانم بکنم؟ اینکه خدا چنین طبیعتی را در من خلق کرده، نقصی است."],[770,"کی دانستم که بیخطا برگردی؟","برگشتی و خون مستمندان خوردی","نمی‌دانستم که تو بدون خطا برمی‌گردی، اما برگشتی و به خاطر این برگشت خود، خون بی‌گناهان را به ناحق ریختی."],[770,"بالله اگر آنکه خط کشتن دارد","آن جور پسندد که تو بی‌خط کردی","اگر کسی که دستور کشتن می‌دهد، این گونه رفتار تو را بپسندد و با بی‌گناهی تو موافق شود، به خدا سوگند."],[771,"ای کاش که مردم آن صنم دیدندی","یا گفتن دلستانش بشنیدندی","ای کاش مردم محبوبی را می‌دیدند یا صحبت‌های دلنشینش را می‌شنیدند."],[771,"تا بیدل و بیقرار گردیدندی","بر گریه عاشقان نخندیدندی","اگر مردم آن معشوق را می‌دیدند یا از زیبایی‌های او آگاه می‌شدند، دلشان پر از عشق می‌شد و دیگر از گریه عاشقان نمی‌خندیدند."],[772,"گفتم بکنم توبه ز صاحبنظری","باشد که بلای عشق گردد سپری","من تصمیم گرفتم که از نظارت و دقت نظر دیگران دست بکشم، زیرا این کار باعث می‌شود که گرفتار دردسرهای عشق شوم."],[772,"چندانکه نگه می‌کنم ای رشک پری","بار دومین از اولین خوبتری","هرچقدر که به تو نگاه می‌کنم، ای زیباروی، بار دوم تو از اولین زیبایان هم بهتر هستی."],[773,"هر روز به شیوه‌ای و لطفی دگری","چندانکه نگه می‌کنمت خوبتری","هر روز به شیوه‌ای جدید و با ناز و محبت خاصی مرا نگریسته‌ای، به‌طوری که هر روز زیباتر و دلرباتر از روز قبل به نظر می‌آیی."],[773,"گفتم که به قاضی برمت تا دل خویش","بستانم و ترسم دل قاضی ببری","گفتم که به قاضی می‌روی تا دل خود را تسکین دهم، ولی می‌ترسم که دل قاضی را هم بشکنی."],[774,"ای بلبل خوش سخن چه شیرین نفسی","سرمست هوی و پای‌بند هوسی","ای بلبل خوش‌زبان، تو چه صدای دلنشینی داری، در حال حاضر مستانه و شاداب هستی و به جذابیت‌های دنیا وابسته‌ای."],[774,"ترسم که به یاران عزیزت نرسی","کز دست و زبان خویشتن در قفسی","نگرانم که نتوانی به دوستان عزیزت برسی، چون ممکن است با چیزی که خودت بر سر زبان و دستانت آوردی، در زندانی گرفتار شوی."],[775,"ای پیش تو لعبتان چینی حبشی","کس چون تو صنوبر نخرامد به کشی","ای در برابر تو، دختران زیبا از چین و حبشه، هرگز کسی به زیبایی و قامت تو نمی‌تواند در باغ بایستد و خود را به نمایش بگذارد."],[775,"گر روی بگردانی و گر سر بکشی","ما با تو خوشیم گر تو با ما نه خوشی","اگر از ما روی برگردانی یا سر را خم کنی، ما همچنان با تو خوشیم هرچند تو با ما خوش نباشی."],[776,"ماها همه شیرینی و لطف و نمکی","نه ماه زمین که آفتاب فلکی","ما همه پر از شیرینی و محبت هستیم و از جذابیت و زیبایی برخورداریم، نه اینکه بخواهیم به زمین پستی همچون ماهی که در آسمان است، شبیه باشیم."],[776,"تو آدمیی و دیگران آدمیند؟","نی‌نی تو که خط سبز داری ملکی","تو آدمی هستی و دیگران هم آدمی‌اند؟ نه، تو که خط سبز بر پیشانی‌ات نشان ملک و فرمانروایی دارد."],[777,"کردیم بسی جام لبالب خالی","تا بو که نهیم لب بران لب حالی","شاید ما جام‌های پر از شراب زیادی نوشیدیم، اما هنوز نمی‌دانیم کجا دهانمان را بر لب‌های زیبای تو بگذاریم و از لذت آن بهره‌مند شویم."],[777,"ترسنده ازان شدم که ناگاه ز جان","بی‌وصل لبت کنیم قالب خالی","من از ترس این موضوع به حالتی افتاده‌ام که ناگهان از عشق تو جانم را از دست بدهم و بی‌عشق تو، مانند قالبی خالی شوم."],[778,"در وهم نیاید که چه شیرین‌دهنی","این‌ست که دور از لب و دندان منی","عجیب است که چگونه فردی با چنین زبانی شیرین وجود دارد، اما او از من دور است و به لب‌ها و دندان‌های من نمی‌رسد."],[778,"ما را به سرای پادشاهان ره نیست","تو خیمه به پهلوی گدایان نزنی","ما نمی‌توانیم به دربار پادشاهان برویم، تو نباید در کنار گدایان بر خیمه ما بیافزایی."],[779,"گر کام دل از زمانه تصویر کنی","بی‌فایده خود را ز غمان پیر کنی","اگر خواسته‌ها و آرزوهای خود را به تصویر بکشی و به تحقق آنها فکر کنی، هیچ فایده‌ای ندارد و تنها خود را از غم‌ها پیر و رنجور می‌کنی."],[779,"گیرم که ز دشمن گله آری بر دوست","چون دوست جفا کند چه تدبیر کنی؟","اگر از دشمن خود گلایه‌ای به دوست کنی، وقتی که خود دوست به تو ستم کند، چه راه چاره‌ای داری؟"],[780,"ای کودک لشکری که لشکر شکنی","تا کی دل ما چو قلب کافر شکنی؟","ای کودک لشکری، تو که می‌توانی لشکر را شکست دهی، تا کی دل ما را مانند دل کافر بشکنید؟"],[780,"آن را که تو تازیانه بر سر شکنی","به زآن که ببینی و عنان برشکنی","اگر کسی را که تو با تازیانه بر سر او می‌زنی، ببینی و حاکمیتش را از او بگیری، نتایجش برایت بهتر خواهد بود."],[781,"ای مایه درمان نفسی ننشینی","تا صورت حال دردمندان بینی","ای منبع آرامش و درمان، تو هرگز نمی‌نشینی و استراحت نمی‌کنی تا وضع و حال دردمندان را مشاهده کنی."],[781,"گر من به تو فرهاد صفت شیفته‌ام","عیبم مکن ای جان که تو بس شیرینی","اگر من مانند فرهاد، که عاشق شیرین بود، به تو دل باخته‌ام، عیب من را نگیرید ای جان، زیرا تو بسیار شیرینی و جذابی."],[782,"گر دشمن من به دوستی بگزینی","مسکین چه کند با تو به جز مسکینی؟","اگر دشمن من به دوستی انتخاب کند، من بی‌چاره چه کاری از دستم برمی‌آید جز اینکه ادامه دهم به ناتوانی و ضعیفی‌ام؟"],[782,"صد جور بکن که همچنان مطبوعی","صد تلخ بگو که همچنان شیرینی","هر چقدر هم که تو این‌طرف را آراسته و زیبا کنی، و حتی اگر بدگویی هم کنی، من همچنان تو را دوست خواهم داشت و برایم خوشایند خواهی بود."],[783,"گر دولت و بخت باشد و روزبهی","در پای تو سر ببازم ای سرو سهی","اگر بخت و سعادت به من روی بیاورند، تمام خوشبختی‌ام را در پای تو قربانی می‌کنم، ای سرو زیبای بلند."],[783,"سهل است که من در قدمت خاک شوم","ترسم که تو پای بر سر من ننهی","خاک شدن در قدم‌های تو برای من آسان است، اما ترس آن دارم که تو بر سر من نایستی و مرا زیر پا قرار دهی."],[784,"متی حللت بشیراز یا نسیم الصّبح","خذ الکتاب و بلّغ سلامی الأحباب","ای نسیم صبح، زمانی که به شیراز رسیدی، کتاب را بگیر و سلام من را به دوستان برسان."],[784,"اگر چه صبر من از روی دوست ممکن نیست","همی کنم به ضرورت، چو صبر ماهی از آب","گرچه صبر من به خاطر دوستی امکان‌پذیر نیست، اما به ناچار خود را تحمل می‌کنم، مانند صبوری ماهی که از آب بیرون می‌آید."],[785,"گر مرا بی‌تو در بهشت برند","دیده از دیدنش بخواهم دوخت","اگر مرا بدون تو به بهشت ببرند، چنان به تو چشم می‌دوزم که دیگر هیچ چیز را نمی‌توانم ببینم."],[785,"کاین چنینم خدای وعده نکرد","که مرا در بهشت باید سوخت","خداوند وعده نکرده که به خاطر عشق و longing (دلتنگی) من به تو، باید در بهشت بسوزم یا عذاب ببینم."],[786,"گفتم چه کرده‌ام که نگاهم نمی‌کنی؟","وآن دوستی که داشتی اول چرا کم است؟","سوال می‌کنم چه خطایی مرتکب شده‌ام که به من توجه نمی‌کنی؟ و آن دوستی که زمانی با من داشتی، چرا دیگر به اندازه گذشته نیست؟"],[786,"گفتا به جرم آنکه به هفتاد سالگی","سودای سور می‌پزی و جای ماتم است","او (مخاطب سعدی) می‌گوید به دلیل اینکه در سن هفتاد سالگی هنوز آرزوهای شاد و خوشی داری (و به دنبال شادی هستی)، سزاوار نکوهش هستی، چرا که سن تو سن اندوه و عزاست."],[787,"آشفتن چشم‌های مستت","دود دل یار مهربانست","دردی که در دل یار مهربان وجود دارد، به دلایل عشق و هوس، باعث به اشک ریختن و ناراحتی چشمان خمار و مست تو می‌شود."],[787,"وین طرفه که درد چشم او را","خونابه ز چشم ما روانست","درد چشم او باعث سرازیر شدن اشک از چشم‌های ما شده است، اما جالب اینجاست که او از این درد بی‌خبر است."],[787,"دو فتنه به یک قرینه برخاست","پیداست که آخرالزمانست","دو مشکل بزرگ با هم به وجود آمده است، و این نشان می‌دهد که به روزهای آخرالزمان نزدیک شده‌ایم."],[788,"خوب را گو پلاس در بر کن","که همان لعبت نگارینست","به زیبایان بگو که لباس پلاس بر تن کنند؛ زیرا او همان معشوق خوش‌اندام و زیباست."],[788,"زشت را گو هزار حله بپوش","که همان مرده‌شوی پارینست","به زشت‌رویان بگو که هرچقدر هم لباس‌های زیبا بر تن کنند، در واقع همچنان همانند مرده‌ای هستند که شسته می‌شوند و ارزش واقعی ندارند."],[789,"در قطره باران بهاری چه توان گفت؟","در نافه آهوی تتاری چه توان گفت؟","در باران بهاری که بسیار زیبا و دل‌انگیز است، چه وصف و سخنی می‌توان گفت؟ در بوی عطر و بوی دل‌فریب آهویی از سرزمین تتار (منطقه‌ای در آسیای مرکزی) چه می‌توان گفت؟"],[789,"گر در همه چیزی صفت و نعت بگنجد","در صورت و معنی که تو داری چه توان گفت؟","اگر در همه چیز، صفات و ویژگی‌ها جمع شود، در صورتی که تو این شکل و معنا را داری، باز هم چه می‌توان گفت؟"],[790,"سخن عشق حرامست بر آن بیهده گوی","که چو ده بیت غزل گفت مدیح آغازد","سخن گفتن درباره عشق برای کسی که به طور بیهوده صحبت می‌کند، نادرست است، چون او پس از گفتن ده بیت غزل، شروع به تعریف و تمجید از دیگران می‌کند."],[790,"حبذا همت سعدی و سخن گفتن او","که ز معشوق به ممدوح نمی‌پردازد","سعید را ستایش می‌کند که در سخن‌وری‌اش از موضوعات بیهوده و مدح دیگران دوری می‌کند و فقط به عشق و معشوق توجه دارد."],[791,"من بگویم ندیده‌ام دهنی","کز دهان تو تنگتر باشد","تنها دهنی که بسیار تنگ است، دهن توست و من هیچ دهنی را که به این تنگی باشد، ندیده‌ام."],[791,"تنگتر زین دهان فراخ ولیک","نه همه تنگها شکر باشد","دهانی که از دهان تو تنگ‌تر باشد، شاید از نظر اندازه تنگ‌تر باشد، اما نه همه دهان‌های تنگ شیرین هستند."],[792,"کوه عنبر نشسته بر زنخش","راست گویی بهی‌ست مشک‌آلود","کوه عنبر که بر زنگ زنخ (موی بالای پیشانی) نشسته، به راستی بویی خوش و مانند مشک دارد."],[792,"گر به چنگال صوفیان افتد","ندهندش مگر به شفتالود","اگر صوفیان (عارفان) او را در چنگال خود بگیرند، او را جز به شفتالو (میوه‌ای خوشمزه) نخواهند داد."],[793,"تو آن نه‌ای که به جور از تو روی برپیچند","گناه تست و من استاده‌ام به استغفار","تو آن کس نیستی که به خاطر ظلمت، از تو روی بگردانند، گناه کار تویی و من همچنان ایستاده‌ام و از تو طلب آمرزش می‌کنم."],[793,"مرا غبار تو هرگز اثر کند در دل","که خاکپای توام؟ خاک را چه غم ز غبار؟","محبت و علاقه‌ام به تو آن‌قدر عمیق است که هیچ غم و تاثیری در دل من ایجاد نمی‌کند، چون من به عشق تو به دور از هر گونه غبار و آلودگی هستم؛ بنابراین غبار و آلودگی برای من اهمیت ندارد."],[794,"بس ای غلام بدیع‌الجمال شیرین‌کار","که سوز عشق تو انداخت در جهان آتش","ای خدمتگزار خوش‌چهره و بااستعداد، سوز و آتش عشق تو در همه جا افکنده شده است."],[794,"به نفط گنده چه حاجت که بر دهان گیری","تو را خود از لب لعلست در دهان آتش","نیازی به روغن خوشبو نیست، زیرا خود تو با لبان لعلینی‌ات، آتش عشق را در دل‌ها برمی‌افروزی."],[795,"آن پریروی که از مرد و زن و پیر و جوان","هر که بینی دم صاحبنظری می‌زندش","پری زیبا و دلربا که هر کسی، چه مرد و چه زن، چه پیر و چه جوان، او را ببیند، می‌گوید که او در مسند نظر و قدرت است و می‌تواند بر همه تأثیر بگذارد."],[795,"آستینم زد و از هوش برفتم در حال","راست گفتند که دیوانه پری می‌زندش","دستش را به آستین من زد و من از هوش رفتم. در همان حال راست می‌گویند که او دیوانه است و به پری (زیبایی) می‌زند."],[796,"مرا به صورت شاهد نظر حلال بود","که هرچه می‌نگرم شاهدست در نظرم","نگاه کردن به زیبایی‌های صورت معشوق برای من اشکالی ندارد، چون هر چیزی که می‌بینم، در نظر من به نوعی به شاهدی زیبا تبدیل می‌شود."],[796,"دو چشم در سر هر کس نهاده‌اند ولی","تو نقش بینی و من نقشبند می‌نگرم","هر کسی دو چشم دارد اما تو فقط به تصویرها (نقش‌ها) نگاه می‌کنی، در حالی که من به نقش‌کشی (خلق تصاویر) مشغولم."],[797,"شبی خواهم که پنهانت بگویم","نهان از آشنایان و غریبان","شبی قصد دارم به طور پنهانی از عشق تو سخن بگویم، بدون آنکه آشناها و غریبه‌ها از این راز باخبر شوند."],[797,"چنان در خود کشم چوگان زلفت","کزو غافل بود گوی گریبان","چنان در خود غرق می‌شوم و دلم مشغول زلف تو است که فراموش می‌کنم گوی (عشق) را، و درگیر با تو هستم."],[797,"ولیکن هر گناهی را جزاییست","گناه عشق را جور رقیبان","هر گناهی پاداشی دارد، اما درد و سختی ناشی از عشق، نتیجه بی‌عدالتی رقیبان است."],[798,"هزار بوسه دهد بت‌پرست بر سنگی","که ضر و نفع محالست ازو نشان دادن","بت‌پرست (کسی که عبادت بت می‌کند) هزار بوسه بر سنگی می‌زند که هیچ گونه فایده یا ضرری از آن دیده نمی‌شود و نمی‌توان آن را به‌دست آورد."],[798,"تو بت! ز سنگ نه‌ای بل ز سنگ سخت‌تری","که بر دهان تو بوسی نمی‌توان دادن!","تو ای معشوق! به هیچ وجه به سادگی یک سنگ نیستی، بلکه از سنگ هم سخت‌تر هستی، زیرا کسی نمی‌تواند بر لبان تو بوسه‌ای بزند."],[799,"کسی ملامتم از عشق روی او می‌کرد","که خیره چند شتابی به خون خود خوردن؟","کسی مرا به خاطر عشق به او سرزنش می‌کند که چرا این‌قدر بی‌تاب و عجول هستی، در حالی که در عشق، دردی وجود دارد که انسان ناگزیر باید آن را تحمل کند."],[799,"ازو بپرس که دارد اسیر بر فتراک","ز من مپرس که دارم کمند در گردن","از او بپرس که به عشق تو گرفتار شده، اما از من نپرس که چه ترفندهایی برای تسلط بر دل تو دارم."],[800,"چند گویی که مهر ازو بردار","خویشتن را به صبر ده تسکین","چرا اینقدر می‌گویی که محبت را از او بگیر؟ خودت را با صبر آرام کن."],[800,"کهربا را بگوی تا نبرد","چه کند کاه پاره‌ای مسکین؟","کاه، موجودی ضعیف و بی‌ارزش است، در حالی که کهربا، ماده‌ای گران‌بها و باارزش است. این بیت به تضاد بین اشیای بی‌ارزش و ارزشمند اشاره دارد و بیانگر این است که نباید به چیزهای بی‌مقدار و ناچیز بها داد، زیرا در برابر چیزهای باارزش، هیچ قدرتی ندارند."],[801,"بر آن گلیم سیاهم حسد همی آید","که هست در بر سیمین چون صنوبر او","بر روی گلیم سیاه من، حسادت به وجود می‌آید، چون او در کنار یال نقره‌ای مانند صنوبر است."],[801,"گلیم بین که در آن بر، چه عیش می‌راند","سیه گلیمی من بین که دورم از بر او","به گلیم سیاه توجه کن که شادی را در آن گلیم جشن می‌گیرد. اما گلیم سیاه من را ببین که فاصله‌ام از او (عزیزم) باعث غم و اندوه‌ام شده است."],[802,"گفتم به ره ببینم و دامن بگیرمش","کای رشک آفتاب جمال منیر تو","گفتم بروم تا او را ببینم و دامنش را بگیرم که چقدر زیبا و درخشان است و من به او حسد می‌برم."],[802,"شهری بر آتش غم هجران بسوختی","اول منم به قید محبت اسیر تو","به خاطر اندوه جدایی تو، شهری را به آتش غم سوزاندم و من نخستین کسی هستم که به خاطر عشق و محبت به تو، در بند شده‌ام."],[802,"انعام کن به گوشه چشم ارادتی","تا بنده تو باشم و منت پذیر تو","اگر به من نگاه محبت‌آمیز کنی و ارادتم را بپذیری، من آماده‌ام که بنده و خدمتگزار تو باشم و از لطف تو سپاس‌گزار باشم."],[802,"صاحبدلی به تربیتم گفت زینهار","غوغا مکن که دوست ندارد نفیر تو","صاحب دل و انسان باتجربه‌ای به من گفت که مراقب باش و آرام باش، زیرا دوست ندارد آواز و صداهای تو را."],[802,"شاهد منجمست چه حاجت به شرح حال","در وی نگاه کن که بداند ضمیر تو","معشوق تو به اندازه یک ستاره درخشنده است، نیازی به توضیحات و توصیف‌های دیگر نیست؛ کافی است در او بنگری تا بفهمد چه چیزی در دل تو می‌گذرد."],[803,"وه که چه آزار بود من از مهر تو","لیک چو باز آمدی آن همه برداشتی","چه حیف است که من از عشق تو رنج می‌برم، اما وقتی به سوی من برمی‌گردی، تمام آن رنج‌ها را از بین می‌بری."],[803,"سر چو برآورد صبح بپوشد گناه","روز همه روز جنگ شب همه شب آشتی","وقتی صبح طلوع می‌کند، گناه‌هایی که در طول روز انجام شده، پوشیده می‌شود و در طول روز جنگ و جدال وجود دارد، ولی شب‌ها می‌توان آرامش و آشتی را تجربه کرد."],[804,"ز حد بگذشت مشتاقی و صبر اندر غمت یارا","به وصل خود دوایی کن دل دیوانه ما را","مشتاقی به حدی رسیده که طاقت او در غمت تمام شده است؛ ای یار، با وصال خود بر درمان دل دیوانه ما اقدام کن."],[804,"علاج درد مشتاقان طبیب عام نشناسد","مگر لیلی کند درمان غم مجنون شیدا را","فقط لیلی می‌تواند درد عاشقان را درمان کند، زیرا هیچ پزشک عمومی نمی‌تواند غم مجنون را که عاشق اوست، درمان کند."],[804,"گرت پروای غمگینان نخواهد بود و مسکینان","نبایستی نمود اول به ما آن روی زیبا را","اگر به غم و اندوه غمگین‌ها اهمیتی نمی‌دهی و نباید هم به آنها توجه کنی، پس ابتدا باید چهره زیبا و دل‌انگیز خودت را به ما نشان بدهی."],[804,"چو بنمودی و بربودی ثبات از عقل و صبر از دل","بباید چاره‌ای کردن کنون آن ناشکیبا را","وقتی که تو زیبایی خود را نشان دادی و عقل و صبر را از دل من بردی، اکنون باید کاری کرد و برای این بی‌تابی چاره‌ای اندیشید."],[804,"مرا سودای بت‌رویان نبودی پیش ازین در سر","ولیکن تا تو را دیدم گزیدم راه سودا را","تا پیش از دیدن تو، هیچ اشتیاقی به دلبران زیبا نداشتم، اما اکنون که تو را دیده‌ام، ناچار شدم به این راه عشق و خواسته‌های دل بروم."],[804,"مراد ما وصال تست از دنیا و از عقبی","وگرنه بی‌شما قدری ندارد دین و دنیا را","منظور این است که تنها هدف ما رسیدن به محبت و وصال توست و نه دنیا و آخرت، زیرا بدون تو هیچ‌یک از این دنیا و دین برای ما اهمیت ندارد."],[804,"چنان مشتاقم ای دلبر به دیدارت که از دوری","برآید از دلم آهی بسوزد هفت دریا را","چنان به تو علاقه‌مندم ای معشوق، که دوری‌ات باعث می‌شود دلی پر از درد و سوزش داشته باشم که به اندازه‌ای باشد که هفت دریا را بسوزاند."],[804,"بیا تا یک زمان امروز خوش باشیم در خلوت","که در عالم نمی‌داند کسی احوال فردا را","بیایید امروز را با هم شاد بگذرانیم و در کنار هم باشیم، زیرا هیچ‌کس در این دنیا از حال و وضعیت فردا باخبر نیست."],[804,"سخن شیرین همی گویی به رغم دشمنان سعدی","ولی بیمار استسقا چه داند ذوق حلوا را؟","سعدی می‌گوید تو در می‌گویی، اما دشمنان‌ات را نادیده بگیر، چون کسی که به بیماری استسقا (ناراحتی آب‌نرسیدن یا تشنگی) دچار شده، چه می‌داند طعم شیرین حلوا را؟ یعنی کسی که در رنج و درد است، نمی‌تواند از لذت‌ها و زیبایی‌ها بی‌خبر باشد."],[805,"می‌ندانم چه کنم چاره من این دستان را","تا به دست آورم آن دلبر پردستان را","نمی‌دانم چه باید بکنم تا بتوانم آن معشوق زیبا را به‌دست آورم."],[805,"او به شمشیر جفا خون دلم می‌ریزد","تا به خون دل من رنگ کند دستان را","او با ظلم و قساوتش دل مرا می‌آزارد و می‌کوشد تا دستانش را به رنگ خون دل من آغشته کند."],[805,"من بیچاره تهیدستم از آن می‌ترسم","که وصالش ندهد دست تهیدستان را","من، که در مظلومیت و بی‌چیزی به سر می‌برم، از این می‌ترسم که او، که پیوندی با انسان‌های بی‌چیز ندارد، مرا به وصال خود نرساند."],[805,"دامن وصلش اگر من به کف آرم روزی","ندهم تا به قیامت دگر از دست آن را","اگر روزی بتوانم به وصالش دست یابم، هرگز نخواهم داد تا روز قیامت، آن را از دست بدهم."],[805,"در صفاتش نرسد گرچه بسی شرح دهد","طوطی طبع من آن بلبل پردستان را","هرچند طوطی‌زبان من تلاش کند و هزاران صفت از زیبایی‌های او بگوید، اما نمی‌تواند به تمام زیبایی‌های او برسد؛ مثل بلبل که هرقدر وصف کند، باز هم نمی‌تواند به زیبایی‌های پرده‌دار (دختر زیبا) نزدیک شود."],[805,"هوس اوست دلم را چه توان گفت اگر","دست بر سرو بلندش نرسد پستان را؟","دل من به هوس معشوق می‌تپد، ولی چه می‌توانم بگویم؟ اگر نتوانم به او دسترسی پیدا کنم، گویی که به پستان او (به صفات و جذابیت‌های او) نخواهم رسید."],[805,"نرگس مست وی آزار دلم می‌طلبد","آنکه در عربده می‌آورد او مستان را","چشم‌های زیبای او دل مرا به درد می‌آورند و آزار می‌دهند؛ زیرا او در حال شادمانی و خرمی، مرا به عشق و محبت می‌کشاند."],[805,"گر ببینم رخ خوبش نکنم میل به باغ","زانکه چون عارض او نیست گلی بستان را","اگر چهره زیبا و دلربای او را ببینم، دیگر میلی به باغ و گل‌کاری نخواهم داشت، چرا که در برابر زیبایی صورت او، هیچ گلی در باغ ارزش ندارد."],[805,"هر که دیدست نگارین من اندر همه عمر","به تماشا نرود هیچ نگارستان را","هر کسی که در طول عمرش زیبایی من را دیده باشد دیگر هیچ نگارستان (محل نقاشی و زیبایی) را تماشا نخواهد کرد."],[805,"نیست بر سعدی از این واقعه و نیست عجب","گر غم فرقت او نیست کند هستان را","سعدی می‌گوید اگر کسی به علت دوری از محبوبش غمگین نباشد، عجیب نیست و هیچ شگفتی ندارد. او به این واقعیت اشاره می‌کند که خود او، سعدی، از این احساس خالی نیست."],[806,"ای مسلمانان فغان زان نرگس جادو فریب","کو به یک ره برد از من صبر و آرام و شکیب","ای مسلمانان، فریاد برآورید از نرگس جادویی که با زیبایی‌اش توانسته است صبر و آرامش و تحمل من را یک‌جا از من بگیرد."],[806,"رومیانه روی دارد، زنگیانه زلف و خال","چون کمان چاچیان، ابروی دارد پرعتیب","چهره‌اش مانند رومیان زیباست، موهایش به رنگ سیاه و زلفش مثل کمان خمیده است و ابروهایی پرشکوه و با قوس دارد."],[806,"از عجایب‌های عالم سی و دو چیز عجیب","جمع می‌بینم عیان در روی او من بی حجیب","من در چهره او سی و دو چیز عجیب و شگفت‌انگیز را به وضوح می‌بینم و هیچ حجاب و مانعی بین خود و او وجود ندارد."],[806,"ماه و پروین، تیر و زهره، شمس و قوس و کاج و عاج","مورد و نرگس، لعل و گل، سبزی و می، وصل و فریب","سعدی در این بیت به توصیف زیبایی‌های مختلفی می‌پردازد که همه در چهره محبوبش نمایان است. او از ماه و ستاره‌ها تا گل‌ها و رنگ‌ها به عنوان نمادهای زیبایی و عشق یاد می‌کند و به تضادهای موجود در عشق، مانند وصال و فریب، اشاره می‌کند."],[806,"بان و خطمی، شمع و صندل، شیر و قیر و نور و نار","شهد و شکّر، مشک و عنبر، در و لؤلؤ، نار و سیب","در این بیت سعدی به گستردگی زیبایی‌ها و نعمت‌های مختلف اشاره می‌کند که شامل گل‌ها، عطرها، نور و خوراکی‌هایی همچون عسل و شکر می‌شود. این عناصر نشان‌دهنده‌ی زیبایی و لذت در دنیا هستند و نمادی از خوشی‌ها و نعمت‌هایی هستند که انسان می‌تواند از آن‌ها بهره‌مند شود."],[806,"معجزات پنج پیغمبر به رویش در پدید","احمد و داود و عیسی خضر و داماد شعیب","این بیت به معجزات پنج پیامبر اشاره می‌کند که در چهره زیبای محبوب صحبت‌کننده، تجلی پیدا کرده‌اند. این پیامبران احمد (پیامبر اسلام)، داود، عیسی، خضر و شوهر شعیب هستند."],[806,"ای صنم گر من بمیرم ناچشیده زان لبان","دادگر از تو بخواهد داد من روز حسیب","ای معشوق، اگر من بمیرم، از آن لب‌های عدالت‌گرت هیچ چیز نمی‌چشد و روز قیامت، از تو به خاطر حق و انصافم درخواست خواهد کرد."],[806,"سعدیا از روی تحقیق این سخن نشنیده‌ای؟","هر نشیبی را فراز و هر فرازی را نشیب","سعدی، آیا تو به درستی متوجه نیستی که هر کاهشی (نشیب) یک اوج (فراز) و هر اوجی هم یک کاهش دارد؟"],[807,"قیامتست سفر کردن از دیار حبیب","مرا همیشه قضا را قیامتست نصیب","سفر کردن از دیار محبوب (دوست یا معشوق) برای من مانند قیامت است، زیرا همیشه سرنوشت (قضا) برای من چنان خواهد بود که بی‌محبوبی به پایان می‌رسد."],[807,"به ناز خفته چه داند که دردمند فراق","به شب چه می‌گذراند علی‌الخصوص غریب؟","کسی که در آرامش و ناز خوابیده، نمی‌داند که یک انسان دلداده و گرفتار دوری، به شب چگونه به سر می‌آورد و چه سختی‌هایی را تحمل می‌کند، به‌ویژه اگر غریب باشد و کسی را نداشته باشد."],[807,"به قهر می‌روم و نیست آن مجال که باز","به شهر دوست قدم در نهم ز دست رقیب","من با ناراحتی و در دل قهر از اینجا می‌روم و فرصتی نیست که دوباره به شهر محبوبم بروم، زیرا رقیب مانع این کار است."],[807,"پدر به صبر نمودن مبالغت می‌کرد","که ای پسر بس از این روزگار بی‌ترتیب","پدر به من می‌گفت که باید صبر و شکیبایی پیشه کنی، زیرا این روزگار پر از بلا و بی‌نظمی است و باید سختی‌ها را تحمل کنی."],[807,"جواب دادم از این ماجرا که ای بابا","چو درد من نپذیرد دوا به جهد طبیب","به پدرم گفتم، وقتی درد من درمان نمی‌شود و پزشک هم نمی‌تواند کمکی بکند، به چه دردی می‌خورد تلاش کردن؟"],[807,"مدار توبه توقع ز من که در مسجد","سماع چنگ تأمل کنم نه وعظ خطیب","از من توقع نداشته باشید که در مسجد به تأمل در سماع چنگ (نواختن موسیقی) بپردازم؛ چرا که من به موعظه‌های خطیب (واعظ) گوش نمی‌دهم و در این فضا کاری که از من خواسته‌اید را نمی‌توانم انجام دهم."],[807,"به مکتب ارچه فرستادی‌ام نکو نامد","گرفته ناخن چنگم به زخم چوب ادیب","هرچند تو من را به مکتب فرستادی، ولی نتوانسته‌ام شخصیت خوبی پیدا کنم؛ زیرا هنوز زخم چوب معلم بر دستم باقی مانده و آزارم می‌دهد."],[807,"هنوز بوی محبت ز خاکم آید اگر","جدا شود به لحد بند بندم از ترکیب","هنوز بوی محبت از وجود من به مشام می‌رسد، اگر از این دنیا جدا شوم و بمیرم، بدن من جزیی از ترکیب خاک خواهد بود."],[807,"به اختیار ندارد سر سفر سعدی","ستم غریب نباشد ز روزگار عجیب","سعدی از سرنوشت و قضا و قدر گله دارد و می‌گوید که نمی‌تواند بر سر سفره‌اش انتخاب کند و آن را به دلخواه خود بچیند، و این ستمی است که از روزگار عجیب بر او روا داشته شده است."],[808,"چشم تو طلسم جاودانست","یا فتنه آخرالزمانست","نگاه تو مانند طلسمی است که همواره اثر خودش را حفظ می‌کند یا به مانند فتنه‌ای است که در آخرالزمان ایجاد می‌شود."],[808,"تا چشم بدی به زیر بنهد","دیگر به کرشمه در نهانست","چشم بد را به زیر می‌اندازد و دیگر با نیرنگ و جلوه‌گری در خفا نیست."],[808,"ما را به کرشمه صید کردست","چشمت که چو چشم آهوانست","چشم تو به گونه‌ای است که به آرامی و با ناز، ما را به دام خود کشانده است، همچون چشمی نرم و لطیف که در چشم آهوان دیده می‌شود."],[808,"با لشکر غمزه تو در شهر","( ... ) الامانست","غزلی که تو با نگاه خود به من می‌اندازی، به اندازه‌ای خطرناک و کشنده است که جای فرار برایم نمی‌گذارد."],[808,"پیکان خدنگ غمزه تو","شک نیست که زهر بی‌کمانست","پیکان نگاه فریبنده تو بی‌شک سمی است که بدون کمان پرتاب می‌شود."],[808,"از لعل لب شکرفشانت","یک بوسه به صد هزار جانست","یک بوسه از لب‌های سرخ و زیبا و خوش‌رنگ تو، ارزشی برابر با صد هزار جان دارد."],[808,"ارزان شده است بوسه تو","ارزان چه بود که رایگانست","بوسه تو دیگر ارزش ندارد، چرا که وقتی ارزشش کم شده، انگار به طور رایگان دانسته شده است."],[808,"هستم همه ساله دست بر سر","چون پای فراق در میانست","من همیشه در طول سال، مانند کسی که پایش در فراق محبوب بند است، بر سر خودم دست می‌زنم و در درد جدایی غمگین هستم."],[808,"گویند صبور باش سعدی","این کار به گفت دیگرانست","سعدی را به صبر و شکیبایی دعوت می‌کنند و می‌گویند که این ماجرا فقط باید به گفته دیگران بسنده شود."],[809,"حالم از شرح غمت افسانه(ایست)","چشمم از عکس رخت بتخانه(ایست)","حال من از بیان غمت به مانند داستانی طولانی است و چشمانم همچون نیایشگاه، پر از تصویر چهره‌ات می‌باشد."],[809,"هر کجا بدگوهری در عا(لمست)","در کنار آنچنان دردانه(ایست)","هر جا که انسانی بدخوی وجود دارد، در کنار او شخصی با فضیلت که ارزشمند و دردانه است، نیز پیدا می‌شود."],[809,"بر امید زلف چون ز(نجیر تو)","ای بسا عاقل که چون (دیوانه‌ایست)","امید به زلف تو در دل گمراهی است، زیرا خیلی‌ها را می‌بینم که به خاطر آن زلف به دیوانگی افتاده‌اند، با اینکه عاقل هستند."],[809,"گفتم او را این چه زلفـ.........","گفت هان فی‌الجمله در.........","من از او پرسیدم این چه زلفی است که داری، او پاسخ داد که به طور کلی در هم پیچیده و گره‌خورده است."],[809,"از لبش یک نکته‌ای.........","وز خمش یک قطره‌ای (پیمانه‌ایست)","از لب او یک نکته را می‌گیریم که مانند پیمانه‌ای برای نوشیدنی است و از خمش (لبخند یا حالت لب) او یک قطره می‌چکد که همانند مقداری همان نوشیدنی می‌باشد."],[809,"با فروغ آفتاب حسـ(ـن او)","شمع گردون کمتر از (پروانه‌ایست)","حسن او و زیبایی‌اش به اندازه‌ای است که نورش مانند آفتاب می‌درخشد، و این باعث می‌شود که شمع گردون (دنیا) به لحاظ زیبایی در مقایسه با او کوچک و کم‌نورتر از یک پروانه به نظر برسد."],[809,"نازنینا رخ چه می‌پو(شی ز من)","آخر این مسکین کم (از بیگانه‌ایست)","ای نازنین، چرا روی زیبایت را از من می‌پوشانی؟ این مسکین که کم از دیگران نیست."],[809,"از بت آزر حکایت‌ها کنـ(ـند)","بت خود این است از.........","حکایت‌ها و داستان‌هایی از آزر، پدر ابراهیم خلیل، می‌گویند که بت خود او نیز همین بت است. این اشاره به بت‌پرستی و تمسخر آن دارد."],[809,"دل نه جای توست آخر چـ(ـون کنم)","در جهانم خود همین (ویرانه‌ایست)","دل برای تو نیست؛ پس چه کنم در جهانی که همین ویرانه است؟"],[809,"این نه دل خوانند کیـ.........","این نه عشق است از.........","این چیزی که آن را دل می‌نامند، خیلی چیز دیگری است و این عشق هم که می‌گویند، از نوعی دیگر است."],[810,"خسته تیغ فراقم سخت مشتاقم به غایت","ای صبا آخر چه گردد گر کنی یکدم عنایت؟","من از جدایی و دوری محبوب به شدت ناراحت و دل‌زده‌ام و بسیار مشتاق دیدار او هستم. ای نسیم، اگر فقط یک لحظه لطف و توجهی به من کنی، چه اتفاقی خواهد افتاد؟"],[810,"بگذری در کوی یارم تا کنی حال دلم را","همچنان کز من شنیدی پیش آن دلبر روایت","اگر در کوی محبوبم بگذری، حال مرا بپرس و بگو که هنوز از عشق او برایت گفته‌ام."],[810,"یک حکایت سر گذشتم پیش آن جان بازگویی","گرچه از درد فراقم هست بسیاری شکایت","تجربه‌ای را که از درد جدایی دارم، پیش آن معشوق بگویید، هرچند که در دل شکایت‌های فراوانی از این دوری دارم."],[810,"ای صبا آرام جانی چون رسی آنجا که دانی","هم بکن گر می‌توانی یک مهم ما کفایت","ای نسیم، وقتی به آنجا می‌رسی که محبوب من حضور دارد، لطفا حال مرا بگو و اگر ممکن است، به او بگویی که فقط ملاقات همین یک بار برای من کافی است."],[810,"آن بت چین و ختا را آن نگار بی‌وفا را","گو بکن باری خدا را جانب یاری رعایت","ای آن معشوق زیبا و بی‌وفا که در سرزمین چین و ختا زندگی می‌کند، به خاطر خداوند کمی به یاری من توجه کن و حالتی از محبت را از خود نشان بده."],[810,"شحنه هجر تو هر دم می‌برد صبرم به یغما","داد خود را هم ستانم گر کند وصلت حمایت","هر لحظه غم دوری تو صبرم را می‌رباید و اگر تو در کنارم بیایی، حاضرم خود را هم به تو بدهم و از تو حمایت بگیرم."],[810,"جان‌ستانی، دلربایی، پس ز من جویی جدایی","خود به شیر بی‌وفایی پروریدستست دایت","تو با ناز و دلربایی جان من را می‌گیری، اما در عین حال از من دوری می‌کنی و خودت را به بی‌وفایی شیر، یعنی به غم و اندوه پرورش داده‌ای."],[810,"آن شکایت‌ها که دارم از تو هم پیش تو گویم","نی چه گویم چون ندارد قصه هجران نهایت","شکایت‌هایی که از تو دارم را تنها برای خودت می‌گویم، نه برای دیگران، چون حرفی برای گفتن ندارم؛ قصه جدایی‌ام هیچ پایانی ندارد و کماکان ادامه دارد."],[810,"در هوای زلف بستت در فریب چشم مستت","ساکن میخانه گردد زاهد صاحب ولایت","زاهد متعهد و دیندار به خاطر زیبایی و دلربایی زلف تو و همچنین به خاطر نگاهی که از چشم مست تو می‌افتد، به راحتی از میخانه و دنیای مادی دور می‌شود و در آنجا سکونت می‌کند."],[810,"هر کسی را دلربایی، همچو ذره در هوایی","قبله هر کس به جایی، قبله سعدی سرایت","هر کسی برای خود محبوبی دارد که دلش را می‌رباید، همان‌طور که ذرات ریز در هوا وجود دارند. سعدی به این نکته اشاره می‌کند که محبوب خود برای هر کس، نشانه و قبله‌اش محسوب می‌شود و او در این جستجو به محبوبش توجه دارد."],[811,"می‌روم با درد و حسرت از دیارت خیر باد","می‌گذارم جان به خدمت یادگارت خیر باد","با حسرت و درد از دیارت می‌روم و می‌خواهم که برای یادگارت که به او خدمت کرده‌ام، خیر و سعادت آرزو کنم."],[811,"سر ز پیشت برنمی‌آرم ز دستور طلب","شرم می‌دارم ز روی گلعذارت خیر باد","بخاطر احترامی که به تو دارم، به هیچ‌وجه از پیش تو سر برنمی‌آورم و از درخواست کردن شرمنده‌ام، زیرا زیبایی تو مانند گلی است که نمی‌توان از آن روی گرداند."],[811,"هر کجا باشم دعا گویم همی بر دولتت","از خدا باد آفرین بر روزگارت خیر باد","هر جایی که باشم برای موفقیت و خوشبختی تو از خدا دعا می‌کنم. آفرین بر روزگاری که داری و امیدوارم همیشه به کامت باشد."],[811,"گر دهد عمرم امان رویت ببینم عاقبت","ور بمیرم در غریبی ز انتظارت خیر باد","اگر عمرم اجازه دهد که چهره‌ات را ببینم، در پایان زندگی‌ام خوشبختم؛ و اگر در تنهایی و دوری از تو بمیرم، انتظار تو برایم خوش یمن خواهد بود."],[811,"گر ز چین زلف تو بویی رسد بر خاک ما","زنده برخیزم ز بوی مشکبارت خیر باد","اگر بوی عطر زلف تو بر خاک ما بیفتد، از خواب برمی‌خیزم و به خاطر عطر خوشبویت، زندگی می‌کنم."],[811,"گر ز من یاد آوری بنویس آنجا قطعه‌ای","سعدیا آن گفته‌های آبدارت خیر باد","اگر از من یاد کنی و برایم نامه‌ای بنویسی، آنجا قطعه‌ای از اشعار سعدی را بنویس که در آن به یاد تو احساس خوشی کرده‌ام."],[812,"ما ترک سر بگفتیم، تا دردسر نباشد","غیر از خیال جانان، در جان و سر نباشد","ما از عشق و جدایی صحبت کردیم تا مشکلی پیش نیاید و تنها خیال محبوب در دل و جان ما باقی بماند."],[812,"در روی هر سپیدی، خالی سیاه دیدم","بالاتر از سیاهی، رنگی دگر نباشد","در چهره هر فردی که دارای زیبایی و روشنی است، نشانه‌ای از سیاهی را مشاهده کردم و به این نتیجه رسیدم که فراتر از این سیاهی، هیچ رنگ دیگری وجود ندارد."],[812,"رنگ قبول مردان، سبز و سفید باشد","نقش خیال رویش، در هر پسر نباشد","مردان ارزشمند، معمولا با رنگ‌های سبز و سفید شناخته می‌شوند، اما تصویر زیبای آن‌ها و جلوه‌هایشان تنها در هر فردی دیده نمی‌شود."],[812,"چشم وصال بینان، چشمیست بر هدایت","سری که باشد او را، در هر بصر نباشد","چشم کسانی که به وصال (دست‌یابی به معشوق) می‌رسند، چشمی است که هدایت می‌کند؛ اما چنین چشمی در هر انسانی وجود ندارد."],[812,"در خشک و تر بگشتم، مثلت دگر ندیدم","مثل تو خوبرویی، در خشک و تر نباشد","در هر مکان و زمانی که گشتم (به دنبال زیبایی)، مانند تو خوبرویی ندیدم، یعنی زیبایی تو در هیچ جا و شرایطی دیگر وجود ندارد."],[812,"شرحت کسی نداند، وصفت کسی نخواند","همچون تو ماه سیما، در بحر و بر نباشد","هیچ‌کس نمی‌تواند تو را به درستی توصیف کند و هیچ‌کس نمی‌تواند همچون تو را بیابد؛ تو مانند ماهی زیبا هستی که نه در دریا و نه در خشکی وجود دارد."],[812,"سعدی به هیچ معنی، چشم از تو برنگیرد","تا از نظر چه خیزد، کاندر نظر نباشد","سعدی هرگز چشم از تو برنمی‌دارد، زیرا که از تو دوری جستن به معنای نادیده گرفتن توست و اگر تو را از نظر بگذارد، هیچ چیز دیگری در دید نخواهد بود."],[813,"بخت و دولت به برم زآب روان باز آمد","وز سعادت به سرم سرو روان باز آمد","خوشبختی و رزق و روزی، مانند آبی که در حال جاری شدن است، دوباره به سوی من برگشت و از روی لطف و سعادت، جوانی و طراوت دوباره به زندگی‌ام سرایت کرد."],[813,"پیر بودم به وصال رخ خوبش همه روز","باز پیرانه سرم بخت جوان باز آمد","من سالخورده‌ای بودم که به وصال صورت زیبا و دلنشین او رسیدم و هر روز با دیدن او جوان‌تر شدم."],[813,"دوست باز آمد و دشمن برمید از پیشم","شکر نعمت که به تن جان گران باز آمد","دوست به سراغ من برگشته و دشمن از پیشم رفته است. شکر می‌گویم برای این نعمت که روح و جان ارزشمند من به زندگی بازگشته است."],[813,"مژدگانی بده ای دوست که محنت بگذشت","نعمت فتح و گشایش به زمان باز آمد","ای دوست، مژده بده که سختی‌ها تمام شد و نعمت پیروزی و خوشی دوباره به دوران ما برگشت."],[813,"دولت آمد به بر و بخت و سعادت برسید","مشتری از سر شادی به کمان باز آمد","دولت و خوشبختی به سراغ من آمده و بخت و سرنوشت خوب به من روی آورده است. سیاره مشتری که نمایانگر شادمانی و خوشبختی است، نیز از کنار من عبور کرده و به نشانه‌ی خوشحالی، کمان خود را به حالتی باز درآورده است."],[813,"آفتاب کرم و ماه ضیا هم برسید","تاج اقبال و کرامت به عیان باز آمد","خورشید رحمت و ماه روشنایی هم دوباره آمدند و تاج سعادت و بزرگواری به وضوح ظاهر شد."],[813,"سعدیا تاج سعادت دگر از نو برسید","کان نگار شده چون آب روان باز آمد","سعدی جان، دوباره به ما خوشبختی و سعادت رو کرده است، زیرا آن معشوق زیبا همچون آبی روان به نزد ما بازگشته است."],[814,"رفت آن کم بر تو آبی بود","یا سلام مرا جوابی بود","هنگامی که آن چهره زیبا و دلربا از نزدیک دور می‌شود، دیگر نه آبی از نگاهش برای من باقی می‌ماند و نه سلام من جوابی دریافت می‌کند."],[814,"از سر ناز وز سر خوبی","هر دمی با منت عتابی بود","تو به خاطر زیبایی و ناز خود، هر بار با طعنه و کنایه‌ای با من صحبت می‌کردی."],[814,"وعده‌های خوشم همی دادی","گویی آن وعده‌ها سرابی بود","وعده‌های شیرینی که به من داده بودی، انگار که آن وعده‌ها هیچ و پوچ بودند و فقط توهمی بودند."],[814,"روزگار وصال چون بگذشت","گویی آن روزگار خوابی بود","روزهایی که با معشوق گذراندم، به سرعت تمام شد و به نظر می‌رسد آن لحظات زیبا در واقع خواب و خیال بودند."],[814,"بر کف من ز دست ساقی بزم","هر نفس ساغر شرابی بود","دست ساقی در هر لحظه ساغری از شراب بر کف من می‌نهاد که به منزله لذتی بی‌پایان بود."],[814,"خسته مانده‌ام نمی‌پرسی","که مرا خسته خرابی بود","عاشق در حال آزار و ناامیدی است و کسی از حال او نمی‌پرسد، در حالی که او از عشق و خراب کردن دلش خسته و ناتوان شده است."],[814,"حبذا آنکه از زکات لبت","عاشقان تو را نصابی بود","خوشا به حال کسی که از لبان تو، که زکات و خیرات عشق را به همراه دارد، سهم و بهره‌ای برای عاشقان دریافت کرده باشد."],[814,"سعدیا چون زمان وصل گذشت؟","ای دریغا که چون سرابی بود","سعدی، ای کاش زمان وصال طولانی‌تر می‌بود؛ افسوس که آنچه گذشته، مانند سراب بود و حقیقت نداشت."],[815,"یاد دارم که روزگاری بود","که مرا پیش غمگساری بود","یاد دارم که زمانی بود که من را به نزد غمگساری می‌بردند، یعنی کسی که در دلش غم را احساس می‌کرد."],[815,"با لب یار و در بر دلدار","هر زمانیم کار و باری بود","همواره مشغول لذت‌بردن از لبان یار و آغوش محبوب هستیم و این موضوع، کار و فعالیت اصلی ماست."],[815,"جام عیش مرا نه دردی بود","گل وصل مرا نه خاری بود","جام خوشی و لذت من نه مشکلی داشت و نه دردی. ارتباط و وصالی که با محبوب داشتم، حاکی از رنج و غم نبود."],[815,"ز اهوی شیرگیر روبه‌باز","دل بیچاره را شکاری بود","در این بیت بیان می‌شود که عشق و زیبایی محبوب، مانند آهو که به دام شیرگیر گرفتار می‌شود، دل بیچارۀ عاشق را به دام انداخته و او را درگیر خود کرده است."],[815,"گرد آب حیات بر خورشید","از خط او بنفشه‌زاری بود","حضور آب حیات در کنار خورشید باعث رونق و شادابی بنفشه‌ها شده بود."],[815,"همه اسباب عیشم آماده","یارب آن خود چه روزگاری بود","سعدی در این بیت از شادی و خوشی‌های زندگی خود سخن می‌گوید و از خدا می‌خواهد که زمانه‌ای که همه چیز برای لذت‌بردن فراهم بود را دوباره به یاد آورد. او به یاد می‌آورد که در آن روزگار چقدر خوشبخت بوده و همه چیز به خوبی پیش می‌رفته است."],[815,"گر جهان موجها زدی ز اغیار","سعدیش بس گزیده یاری بود","اگر در جهان، تندبادها و طوفان‌های زندگی به وجود آوردی، سعدی، یار تو بسیار ارزشمند و گزیده‌ای بود."],[816,"خسرو من چون به بارگاه برآید","نعره و فریاد از سپاه برآید","وقتی خسرو من به کاخ می‌آید، نعره و فریاد از لشکر به گوش می‌رسد."],[816,"عاشق صادق ز خان و مان بگریزد","مرد توانگر ز مال و جاه برآید","عاشق واقعی از خانه و کاشانه‌اش دور می‌شود، در حالی که انسان ثروتمند از اموال و مقام خود دور نمی‌شود."],[816,"بر سر کویش نظاره کن که هزاران","یوسف مصری ز قعر چاه برآید","به جایگاه معشوق بنگر که زیبایی‌ها و نیکان زیادی مانند یوسف، که به عنوان نماد زیبایی و کمال است، از عمق مشکلات و سختی‌ها به ظهور می‌آیند."],[816,"صبح چنان صادق است در طلب او","کز هوس روی او پگاه‌ برآید","صبح به قدری روشن و شفاف است که دلتنگی و آرزو برای دیدن او (خسرو) به اندازه‌ای زیاد است که حتی شوق دیدار او در هنگام صبحگاه نیز به وضوح حس می‌شود."],[816,"صومعه داران چو........","از همگان وافضیحتاه برآید","صومعه‌داران، که معمولا به زندانیان و عابدان اشاره دارند، از مرزهای عقل و فهم خود زاویه‌ای متفاوت به دنیا دارند و از همه نظرها ممکن است از جمع دیگران زیرتر (یا حقیرتر) به نظر برسند."],[816,"غمزه او مست و.........","هر که برون آید از (پناه) برآید","غمزه او مست و خمار کننده است و هر کسی که از پناه او بیرون برود، دچار آشفتگی و سرگشتگی می‌شود."],[816,"گر به مثل دیرتر ز خواب بخیزد","صبح در آن روز چاشتگاه برآید","اگر کسی مانند دیری در خواب بماند، صبح دیرتر از خواب برمی‌خیزد و در آن روز، ساعت چاشت (وقت ناهار) به تأخیر می‌افتد."],[816,"آینه گر عکس او ز دور ببیند","از دل سنگش هزار آه برآید","اگر آینه از دور تصویر او را ببیند، از دل سنگ هم صدای هزار آه بلند می‌شود."],[816,"مرده اگر یاد او کند به دل خاک","بر سر خاکش بسی گیاه برآید","اگر مرده‌ای در دلش یاد او را داشته باشد، بر سر خاکش گیاه‌های زیادی خواهند رویید."],[816,"صبر کن ای دل.........","کار برآید چو سال و ماه برآید","دل‌تنگی نکن و صبر کن، با گذشت زمان و صبر، کارها به سامان خواهد رسید و مشکلات برطرف خواهند شد."],[816,"چون ز سرّ عشق او کنند گناهی","بوی عبادت از آن گناه برآید","هنگامی که از عشق او خطایی سر بزند، بویی از عبادت و پاکی از آن گناه به مشام می‌رسد."],[816,"ای دل سعدی نه.........","سجده کن آنجا که.........","ای دل سعدی، نه بر خاک سجده کن، بلکه بر باری بگذار که در آنجا محبت و عشق به او بیافرینی."],[817,"باد بهاری وزید، از طرف مرغزار","باز به گردون رسید، ناله هر مرغ‌ زار","باد بهاری از سمت مرغزار به راه افتاد و به آسمان رسید، در حالی که صدای هر پرنده‌ای را که در آنجا محزون و غمگین بود، به گوش می‌رساند."],[817,"سرو شد افراخته، کار چمن ساخته","نعره‌زنان فاخته، بر سر بید و چنار","سرو به شکلی بلند و ایستا درآمده و چمن به خاطر او زیبایی یافته است. فاخته نیز با صدای بلند بر سر درختان بید و چنار آواز می‌خواند."],[817,"گل به چمن در بر است، ماه مگر یا خور است","سرو به رقص اندرست، بر طرف جویبار","در چمن، گل‌ها به شکوفه درآمده‌اند و ماه یا آفتاب در آسمان است. سرو، در حال رقصیدن است و در کنار جویبار قرار دارد."],[817,"شاخ که با میوه‌هاست، سنگ به پا می‌خورد","بید مگر فارغ‌ست، از ستم نابکار","شاخه‌ای که میوه دارد، به زمین می‌خورد و آسیب می‌بیند. بید (نوعی درخت) آیا از ظلم بدکاران بی‌خبر است و بی‌خیال می‌باشد؟"],[817,"شیوه نرگس ببین، نزد بنفشه نشین","سوسن رعنا گزین، زرد شقایق ببار","نرگس را ببین که چگونه می‌نشیند و به بنفشه توجه دارد. سوسن زیبا را انتخاب کن و از زردی شقایق بهره‌مند شو."],[817,"خیز و غنیمت شمار، جنبش باد ربیع","ناله موزون مرغ، بوی خوش لاله‌زار","بپا خیز و از این فرصت بهره ببر، نسیم بهاری آمده است. صدای زیبا و هماهنگ پرندگان در حال نواختن است و بوی خوش گل‌های لاله در دشت پخش شده است."],[817,"هر گل و برگی که هست، یاد خدا می‌کند","بلبل و قمری چه خواند؟ یاد خداوندگار","هر گل و برگی که وجود دارد، به یاد خداوند ندا سر می‌دهد، پس بلبل و قمری که عاشقانه می‌خوانند، چه معنایی دارند جز یاد خداوند؟"],[817,"برگ درختان سبز، پیش خداوند هوش","هر ورقی دفتری‌ست، معرفت کردگار","برگ‌های سبز درختان در نظر خداوند هوش ( انسان هوشیار) ، هر یک مانند ورقی از اوراق کتاب شناخت خداوند می باشند"],[817,"وقت بهارست خیز، تا به تماشا رویم","تکیه بر ایام نیست، تا دگر آید بهار","بهار وقت خوشی است، پس بیایید تا از زیبایی‌های آن لذت ببریم، چرا که زندگی و فرصت‌ها دائمی نیستند و بهار دوباره تکرار نمی‌شود."],[817,"بلبل دستان بخوان، مرغ خوش‌الحان بدان","طوطی شکرفشان، نقل به مجلس بیار","بلبل که با نغمه‌های دلنشین و زیبا آواز می‌خواند، باید به دورهمی بیاید و مرغ خوش‌صدا را نیز بیاورید تا فضای مجلس را شاد کند. همچنین به طوطی که سخن‌های شیرین می‌گوید، اجازه بدهید بیاید و با حرف‌های دلپذیرش مجلس را رونق بخشد."],[817,"بر طرف کوه و دشت، روز طواف‌ست و گشت","وقت بهاران گذشت، گفته سعدی بیار","به دور کوه و دشت، زمان طواف و گشت و گذار فرارسیده است و بهار به پایان رسیده، پس سخنان سعدی را بیاور."],[818,"ایا نسیم سحر بوی زلف یار بیار","قرار دل ز سر زلف بی‌قرار بیار","ای نسیم صبحگاه، بوی موهای محبوب را بیاور تا دل بی‌قرار و پر از آشفتگی‌ام آرام گیرد."],[818,"سلامی از من مسکین بدان صنوبر بر","پیامی از آن مهروی گلعذار بیار","من از سر دردمند و بیچاره، پیامی به آن دختر زیبای مانند گل و صنوبر برسان."],[818,"حکایت از لب فرهاد ناتوان برسان","سلامی از من مسکین غمگسار بیار","حکایتی از لب فرهاد ناتوان برای او ببر و سلامی از من بیچاره و غمگین برسان."],[818,"نهان بگوی به آن دوستدار یکدل من","جواب بشنو و آنگه به آشکار بیار","به محبت و دوستداری آن شخصی که یکدل و صادق است، پنهانی بگو، ابتدا جواب او را بشنو و سپس آن را به طور علنی بیان کن."],[818,"دوای جان من و مرهم روان بویی","از آن دو زلف زره‌وار مشکبار بیار","دوای درد و تسکین‌دهنده روح من، بویی از آن دو زلف نرم و سیاه مانند زره به من بده."],[818,"بهار دیده من نیست جز که عکس رخش","تلطفی بکن و عکس آن بهار بیار","بهار در چشم من فقط تصویری از چهره توست؛ لطفی کن و آن تصویر را برایم بیاور تا بهار را ببینم."],[818,"ز بهر روشنی چشم کز رخش دورست","غبار ازان طرف و گرد از آن دیار بیار","به خاطر روشنی چشمی که از چهره‌اش دور است، از آن طرف غبار و گرد و خاکی را بیاور."],[818,"ز من درود فراوان ببر به دلبر من","به لطف مژده‌ای از وصل آن نگار بیار","برای معشوق من درود و سلام‌های بسیاری بفرست و به او این خوش‌خبر را برسان که به زودی به وصال آن دلبر زیبا دست می‌یابی."],[818,"من آن حدیث که گفتم نگاه دار و ببر","هر آن جواب که گوید به یاد دار و بیار","من از تو خواهش می‌کنم که داستانی را که برایت تعریف کردم در ذهنت نگه‌دار و هر پاسخی که او در مورد آن می‌دهد را به خاطر بسپار و به من برگردان."],[818,"در انتظار تو سعدی همیشه می‌گوید","که ای نسیم سحر بوی زلف یار بیار","سعدی همیشه در انتظار تو است و از نسیم صبح می‌خواهد که بوی موی محبوب را بیاورد."],[819,"اگر چه دل به کسی داد، جان ماست هنوز","به جان او که دلم بر سر وفاست هنوز","با وجود اینکه دل خود را به کسی سپردم، اما جان من هنوز به خاطر عشق او زنده است و وفای من به او همچنان باقی‌ست."],[819,"ندانم از پی چندین جفا که با من کرد","نشان مهر وی اندر دلم چراست هنوز؟","نمی‌دانم به چه دلیلی با من این‌قدر بدی کرده، اما چرا هنوز نشانه‌ای از محبت او در دل من باقی مانده است؟"],[819,"به راز گفتم با دل، ز خاطرش بگذار","جواب داد فلانی ازان ماست هنوز","با دل و جان درباره رازهای عشق صحبت کردم و گفتم که او (محبوب) را فراموش کنم، اما دل در پاسخ گفت که او هنوز هم از جان من جدا نیست و در یادم باقی مانده است."],[819,"چو مرده باشم اگر بگذرد به خاک لحد","به بانگ نعره برآید که جان ماست هنوز","اگر من بمیرم و به خاک سپرده شوم، صدایی بلند خواهد شد که بگوید او هنوزم عشق ماست"],[819,"عداوت از طرف آن شکسته پیمانست","وگرنه از طرف ما همان صفاست هنوز","دشمنی و کینه از سوی کسی به وجود آمده که نسبت به ما بی‌وفا شده است، و اگر این بی‌وفایی نبود، ما همچنان با صفا و دوستی برخورد می‌کردیم."],[819,"بتا تو روی ز من برمتاب و دستم گیر","که در سرم ز تو آشوب و فتنه‌هاست هنوز","ای معشوق، لطفا روی خود را از من برنگردان و دستم را بگیر، زیرا در دل من همچنان آشوب و فتنه‌ای از عشق تو وجود دارد."],[819,"کجاست خانه قاضی که در مقالت عشق","میان عاشق و معشوق ماجراست هنوز","قاضی که در مسائل عشق میان عاشق و معشوق تصمیم می‌گیرد، کجاست؟ زیرا هنوز درگیری و داستان عشق ادامه دارد."],[819,"نیازمندی من در قلم نمی‌گنجد","قیاس کردم و ز اندیشه‌ها وراست هنوز","نیاز و خواسته‌های من فراتر از کلماتی است که بتوانم با قلم بیان کنم؛ پس از تفکر بسیار فهمیدم که این خواسته‌ها همچنان باقی و برقرارند."],[819,"سلام من برسان ای صبا به یار و بگو","که سعدی از سر عهد تو برنخاست هنوز","سلام من را به یار برسان و بگو که سعدی هنوز وفادار به عهد و پیمانی که با تو داشته، استوار مانده است."],[820,"چه درد دلست اینچه من درفتادم","که در دام مهر تو دلبر فتادم؟","اینکه من به این درد و رنج گرفتار شده‌ام، ناشی از محبت و عشق توست که باعث شده‌ام به دام تو بیفتم."],[820,"چه بد کرده بودم که ناگه ازینسان","به دست تو شوخ ستمگر فتادم؟","نمی‌دانم چه گناهی مرتکب شده‌ام که ناگهان به دام تو، که مردی بازیگوش و ستمگر هستی، گرفتار شدم."],[820,"مرا با چنین دل سر عشقبازی","نبود اختیاری ولی درفتادم","من هیچ اختیاری از خود نداشتم و دل‌باخته عشق تو شدم، اما با این حال، به این بازی عاشقانه گرفتار آمدم."],[820,"به میدان عشق تو در اسب سودا","همی تاختم تیز و در سر فتادم","در عشق تو، با شتاب و بی‌تابی به پیش می‌روم و مانند سوارکاری در میدان، به سرعت حرکت می‌کنم و در دل خود فرو می‌روم."],[820,"بدینگونه هرگز نیفتادم ارچه","درین شیوه صد بار دیگر فتادم","هرگز به این شکل در عشق سقوط نکرده‌ام، هرچند که در این روش صد بار دیگر به زمین بیفتم."],[820,"ز غرقاب این غم، رهایی نیابم","که در موج دیده چو لنگر فتادم","از عمق این غم نمی‌توانم نجات یابم، چون در دریاچه اشک به مانند لنگری افتاده‌ام و نمی‌توانم حرکت کنم."],[820,"خیال لب و روی و خالش بدیدم","به سر در گل و مشک و شکر فتادم","چهره و لب و خیالی از معشوق را دیدم و به خاطر زیبایی او، مانند گل و مشک و شکر غرق لذت و شگفتی شدم."],[820,"بلغزید دستم از آن زلف مشکین","بدان خاک مشکین به چه درفتادم","دستم از زلف بلند و مشکی آن معشوقه لیز خورد و به خاکی نرم و خوشبو افتاد، اما نمی‌دانم به کدام در و چه جایی وارد شدم."],[820,"دران چاه جانم خوش افتاد لیکن","ز بدبختی خویش بر در فتادم","در چاه جانم به خوبی وارد شدم، اما به خاطر بدبختی خود، در درگاه (قبل از ورود) سرنگون شدم."],[820,"به طالع همی خورده سعدی همه عمر","که بودی تو غمخوار و غمخور فتادم","سعدی می‌گوید که به سرنوشتش همه عمر دچار شده و از بدی روزگار به شدت تأثیر پذیرفته است، حال آنکه تو (غمخوار و کسی که برای او غم می‌خورد) در کنار او نبوده‌ای."],[821,"من از تو هیچ نبریدم که هستی یار دلبندم","تو را چون بنده‌ای گشتم به فرمانت کمر بندم","من هرگز از تو جدا نشده‌ام، زیرا تو یار محبوب من هستی. من به خاطر تو مثل یک بنده شده‌ام و خود را تحت فرمان تو قرار داده‌ام."],[821,"سواری چست و چالاکی دلم بستی به فتراکی","خوشا و خرما آن دل که باشد صید دلبندم","دلی که به شتاب و با چالاکی به دام عشق تو افتاده، خوش به حالش که همچون خرما در حال شادابی و خوشی است، زیرا در دام محبت تو گرفتار شده است."],[821,"بدین خوبی بدین پاکی که رویت.........","تو را از جمله بگزیدم به جز تو یار نپسندم","به خاطر این زیبایی و پاکی که در چهره‌ات هست، تو را از میان همه انتخاب کردم و هیچ یاری غیر از تو را نمی‌پسندم."],[821,"به امّیدت طربناکم به عشقت.........","گهی از ذوق می‌گریم گهی از شوق می‌خندم","در انتظار تو به شادی و نشاط می‌گذرانم، و به خاطر عشق تو گاهی از شادی اشک می‌ریزم و گاهی از خوشحالی می‌خندم."],[821,"بسی تلخی چشیدستم که رویت را بدیدستم","به گفتار و لبت جانا تویی شکر تویی قندم","بسیاری از تلخی‌ها را تجربه کرده‌ام که به خاطر دیدن روی تو بوده است. ای جانا، تو شکر و قند هستی و با سخن و لبت زندگی‌ام را شیرین می‌کنی."],[821,"به عشقت زار و حیرانم ز مدهوشی پریشانم","ز غیرت بیخ غیرت را ز دل یکبارگی کندم","به خاطر عشق تو، برایت بسیار گریه کرده و در حیرت و گیجی به سر می‌برم. از شدت دلبستگی و غیرت، دل را به طور ناگهانی رها کرده‌ام و دیگر به هیچ چیز غیر از تو اهمیت نمی‌دهم."],[821,"نهال عشق ای دلبر به باغ دل.........","حدیث مهربانی را به گیتی زآن پراکندم","عشق تو مانند نهالی است که در باغ دل من رشد کرده است و من از آن، داستان مهربانی را در دنیا منتشر کرده‌ام."],[821,"حدیث خویش بنوشتم چو آن گفتار( بشنفتم )","چو در دل مهر تو کشتم مبارک (باد پیوندم)","داستان عشق خود را نوشتم، مانند آنچه که در دل مردم درباره‌اش می‌گویند؛ همان‌طور که عشق تو را در دل خود کاشته‌ام، پیوند ما مبارک باد."],[821,"اگر چه نیست آرامم هنوزت عا(شق خامم)","بسوزان چون سپندم خوش به عشق.........","اگرچه هنوز آرام ندارم، اما عشق خام من بسوزان، زیرا به خاطر عشق خوشحالم."],[821,"ایاز چاکرت گشتم به محمودی.........","به خود نزدیک گردانم چو خود را د.........","من به خاطر عشق تو مثل ایاز، غلام محمود، شده‌ام. خود را به تو نزدیک می‌کنم، مثل اینکه خود را به خودم نزدیک می‌کنم."],[822,"من این نامه که اکنون می‌نویسم","به آب چشم پر خون می‌نویسم","این نامه را که حالا می‌نویسم با اشک‌های خونی خود می‌نویسم، یعنی از شدت غم و اندوه."],[822,"ازین در بر نوشتم نامه لیکن","نه آن سوزست کاکنون می‌نویسم","این نامه‌ای که اکنون می‌نویسم، همان احساسی را ندارد که در گذشته داشتم و حالا آن شور و شوق را در خود نمی‌یابم."],[822,"به عذرا درد وامق می‌نمایم","به لیلی حال مجنون می‌نویسم","من به عذرا (دختری زیبا) درد و عشق وامق را نشان می‌دهم و برای لیلی (عشقی افسانه‌ای) حال مجنون (دیوانه عشق) را می‌نویسم."],[822,"نگارا قصه خود را به خدمت","نمی‌دانم که تا چون می‌نویسم","ای نازنین، نمی‌دانم که آیا باید داستان خود را برای تو بنویسم یا نه، زیرا به هر حال، وقتی می‌نویسم، باید در دل فکر کنم که آیا این کار را می‌کنم یا نه."],[822,"تو بپذیر، ارچه من عذری نیارم","تو خوش خوان، گرچه من دون می‌نویسم","تو بپذیر که هرچند من بهانه‌ای برای نوشتن ندارم، تو باز هم لذت ببر از آنچه می‌نویسم، هرچند نوشته‌هایم سطحی و کم‌ارزش باشد."],[823,"دیدی ای دل که دگر باره چه آمد پیشم","چه کنم با که بگویم چه خیال اندیشم؟","ای دل، دیدی که دوباره چه چیزی به سراغم آمد؟ این‌جا چه کنم و به چه کسی بگویم که چه فکرهایی در سر دارم؟"],[823,"کاش بر من نرسیدی ستم عشق رخت","که فرو مانده به حال دل تنگ خویشم","ای کاش عشق تو به من نمی‌رسید، زیرا که بر اثر آن در وضعیت بد و دل‌تنگی به سر می‌برم."],[823,"دلبرا نازده در مار سر زلف تو دست","چه کند کژدم هجران تو چندین نیشم","عزیزم، با طرز برخورد ناز و لطفت، چه کاری می‌تواند بکند؟ مثل مار به زلف تو دست می‌زنم، در حالی که کژدم هجرانت به من چندین ضربه می‌زند."],[823,"همچو دف می‌خورم از دست جفای تو قفا","چنگ‌وار از غم هجران تو سر در پیشم","از دست بدی‌های تو مانند ضربه‌ای که به دف می‌زنند، بی‌تاب و بی‌قرار هستم و به خاطر غم دوری تو، سرم را خم کرده‌ام همچون چنگی که به زمین نزدیک است."],[823,"آبرویم چه بری آتش عشقم بنشان","کمتر از خاکم و بر باد مده زین بیشم","آبروی من را خراب نکن؛ آتش عشق من را خاموش کن. من کمتر از خاک هستم، پس بیشتر از این آن را به باد نده."],[823,"گر به جان ناز کنی گر نکنم در رویت","تا بدانی که توانگر دلم ار درویشم","اگر به خودت ناز کنی و من در روی تو کم نگذارم، تا بدانی که اگر دل من مثل یک درویش بی‌چیزی است، اما در عشق به تو از ثروتمندترین انسان‌ها توانمندتر هستم."],[823,"دم به دم در دلم آید که دم کفر زنم","تا به جان فتنه آن طره کافر کیشم","هر لحظه در دلم احساس می‌کنم که به کفر گواهی دهم، زیرا در حالتی هستم که تحت تأثیر فریبندگی آن موهای فر کافرانه‌اش هستم."],[823,"عقل دیوانه شد از سعدی دیوانه مزاج","با پریشانی از آن بر سر حال خویشم","عقل من به دلیل جنون سعدی، که خود دیوانه و خاصیت‌های عجیبی دارد، گیج و ناتوان شده و من هم به خاطر این آشفتگی، در وضعیت مناسبی نیستم."],[824,"بیا بیا که ز عشقت چنان پریشانم","که می‌رود ز غمت بر زبان پریشانم","بیا و ببین که چقدر به خاطر عشق تو ناآرام و آشفته‌ام که حتی از غم تو حرف‌هایم درهم و برهم می‌شود."],[824,"تو فارغ از من و من در غم تو (سرگردان)","بیا ببین که ز غم بر چه سان پریشانم","تو بی‌توجه به من هستی و من در غم تو سرگردان هستم، بیا و ببین که از شدت غم چقدر آشفته‌ام."],[824,"نه روی با تو نشستن نه رای (دل کندن)","من شکسته دل اندر میان پریشانم","نه می‌توانم با تو هم‌نشین شوم و نه می‌توانم از تو دل بکنم. من دلی شکسته دارم و در میان این احساسات آشفته، به شدت پریشانم."],[824,"نمی‌توان که به دست آورم کلاله تو","چو سنبل تو شب و روز از آن پریشانم","هرگز نمی‌توانم آن رشته زریس که تو را مانند سنبل زیبا کند به دست بیاورم؛ به همین خاطر شب و روز به خاطر آن در ناراحتی و بی‌قراری هستم."],[824,"به هیچ نوع دل و دیده‌ام ز (من نبود)","ازان همیشه من از دستشان پریشانم","دل و دیدۀ من به هیچ چیز آرام نیست و همواره از فقدان تو ناآرامم."],[824,"ز دست دیده ودل هیچ کس پریش نگشت","ازین بتر که من اندر جهان پریشانم","هیچ‌کس به اندازه من در این دنیا پریشان نیست، زیرا من دچار بی‌قراری و آشفتگی ناشی از نگاه و دل‌بستگی شده‌ام."],[824,"چگونه جمع شود خاطرم که (می‌آیی)","ز دست جور تو نامهربان پریشانم","چگونه می‌توانم خود را جمع و جور کنم وقتی که به خاطر ظلم و نامهربانی تو همواره در آشفتگی هستم و آرامش ندارم؟"],[824,"ز عطر مجمر وصفت نیافتم بویی","ازان ز آتش دل چون دخان پریشانم","از بوی عطر وجود تو هیچ خبری ندارم و در دل خود، مانند دودی که از آتش بلند می‌شود، پریشان و بی‌قرارم."],[824,"دلم به وعده وصل ار چه خوش کند سعدی","چو در فراق بوم همچنان پریشانم","با اینکه دل من به وعده وصال تو خوشحال می‌شود، ای سعدی، در واقع به دلیل جدایی و فراق تو هنوز در درونم بی‌قراری و پریشانی برقرار است."],[825,"من خسته چون ندارم، نفسی قرار بی‌تو","به کدام دل صبوری، کنم ای نگار بی‌تو","من از عشق تو خسته‌ام و به اندازه‌ای بی‌قرارم که نمی‌توانم لحظه‌ای بدون تو زندگی کنم. با چه دلی می‌توانم صبر کنم و طاقت بیاورم وقتی که تو نیستی، ای معشوق من؟"],[825,"ره صبر چون گزینم، من دل به باد داده","که به هیچ وجه جانم، نکند قرار بی‌تو","من برای تحمل صبر و بردباری چطور می‌توانم اقدام کنم، در حالی که دل من به باد رفته و در هیچ شرایطی نمی‌توانم وقتی تو نیستی آرامش پیدا کنم."],[825,"صنما به خاک پایت، که به کنج بیت احزان","به ضرورتم نشیند، نه به اختیار بی‌تو","ای خدا، به خاک پای تو سجده می‌کنم، زیرا در گوشه خانه غم، به ضرورت باید بنشینم و نه به میل و خواسته‌ام، در غیاب تو."],[825,"اگرم به سوی دوزخ، ببرند باز خوش خوش","بروم ولی به جنت، نکنم گذار بی‌تو","اگر مرا به سمت دوزخ هم ببرند، با کمال میل می‌روم، اما هرگز به بهشت نمی‌روم در حالی که تو در آنجا نیستی."],[825,"سر باغ و بوستانم، به چه دل بود نگارا","که به چشم من جهان شد، همه زرنگار بی‌تو","عزیزم، حتی اگر در باغ و بوستان باشم، دل نباید خوش باشد؛ چون با نبود تو، برای من این جهان نیز رنگ و زیبایی ندارد."],[825,"نفسی به بوی وصلت، زدنم بهست جانا","که چنین بماند عمری، من دلفگار بی‌تو","با بوی وصال تو دلم را شاد و جانم را معطر می‌کنم، که اگر همین حال را تا همیشه داشته باشم، بی‌تو دلخوشی نخواهم داشت."],[825,"تو گمان مبر که سعدی، به تو برگزید یاری","به سرت که نیست او را، سر هیچ یار بی‌تو","سعدی می‌گوید تو فکر نکن که مرا به تو انتخاب کرده‌اند، چون هیچ دوستی بدون تو در سر ندارم."],[826,"ای یار ناسامان من! از من چرا رنجیده‌ای؟","وی درد و ای درمان من! از من چرا رنجیده‌ای؟","ای دوست نازنین من! چرا از من ناراحت هستی؟ ای درد و ای درمان من! چرا از من دلگیر شده‌ای؟"],[826,"ای سرو خوش‌بالای من! ای دل‌بر رعنای من!","لعل لبت حلوای من! از من چرا رنجیده‌ای؟","ای سرو زیبا و خوش‌بال من! ای دلبر خوش‌حالت! لب‌های تو مانند لعل (گوهری قرمز) شیرین و لذیذند! پس چرا از من ناراحت هستی؟"],[826,"بنگر ز هجرت چون شدم، سرگشته چون گردون شدم","وز ناوکت پرخون شدم، از من چرا رنجیده‌ای؟","نگاه کن که چطور از هجرت تو سرگشته و بی‌هدف شده‌ام و چون گردباد در حال چرخش هستم. از ناوک تیر تو (محبت یا جدایی) زخم‌های بسیاری برداشته‌ام. از من چرا رنجیده‌ای؟"],[826,"گر من بمیرم در غمت، خونم بتا در گردنت","فردا بگیرم دامنت، از من چرا رنجیده‌ای؟","اگر از غم [دوری] تو بمیرم، خونم به گردنت می‌افتد (بتا = بگذار تا، باشد که). [به همین خاطر] در قیامت (فردا) تو را بازخواست می‌کنم که چرا از من رجیده‌ای."],[826,"من سعدی درگاه تو، عاشق به روی ماه تو","هستیم نیکوخواه تو، از من چرا رنجیده‌ای؟","من سعدی، که در خدمت تو هستم و به زیبایی چهره‌ات enamored شده‌ام و خیر او را می‌خواهم، چرا از من ناراحت هستی؟"],[827,"چنان خوب رویی بدان دلربایی","دریغت نیاید به هر کس نمایی","چون تو این چهره زیبا و دلربا را داری، بهتر است که آن را فقط به هر کسی نشان ندهی و از به نمایش گذاشتن آن هر چند که زیباست، دریغ نکرده‌اید."],[827,"مرا مصلحت نیست لیکن همان به","که در پرده باشی و بیرون نیایی","من به مصلحت خود نمی‌خواهم، اما بهتر است که تو در پس پرده بمانی و خود را ظاهر نکنی."],[827,"وفا را به عهد تو دشمن گرفتم","چو دیدم مرا فتنه تو بی‌وفایی","به دلیل بی‌وفایی تو، وفا را به خاطر تو مثل دشمنی پذیرفتم، چون دیدم که تو خود در فریب و نیرنگ هستی."],[827,"چنین دور از خویش و بیگانه گشتم","که افتاد با تو مرا آشنایی","چنان از خود بی‌خبر و دور شدم و از تو بیگانه گشتم که سبب آشنایی من با تو افتادن در مشکلات و دردها بود."],[827,"اگر نه امید وصال تو بودی","ز دیده برون کردمی روشنایی","اگر امیدی به رسیدن به تو نبود، نور چشمم را از نگاه تو دور می‌کردم."],[827,"نیاید تو را هیچ غم بی‌دل من","کسی دید خود عید بی‌روستایی","هیچ کس غم تو را مثل من نمی‌بیند و از دوری تو غمگین نمی‌شود، چرا که خود را مانند عید که در روستا نیست، بدون تو احساس یتیمی می‌کنم."],[827,"من و غم ازین پس که دور از رخ تو","چه باشد اگر یک شبی پیشم آیی؟","اگر تو یک شب پیش من بیایی، دیگر هیچ غمی مانع من نخواهد شد که دور از چهره تو هستم."],[828,"هر شبی با دلی و صد زاری","منم و آب چشم و بیداری","هر شب دلی غمگین و گریانی دارم و با چشمانی پر از اشک و بی‌خوابی به سر می‌برم."],[828,"بنماندست آب در جگرم","بس که چشمم کند گهرباری","آب‌های چشمم به قدری زیاد شده که در دل من مانند مروارید جمع شده است و دیگر جانی برایم نمانده است."],[828,"دل تو از کجا و غم ز کجا؟","تو چه دانی که چیست غمخواری؟","دل تو چه ربطی به غم من دارد و غم من از کجا آمده است؟ تو چه می‌دانی غمخواری چیست و یعنی چه؟"],[828,"آگه از حال من شوی آنگاه","که چو من یک شبی به روز آری","تو زمانی می‌توانی از حال من باخبر شوی که یک شب مانند من درد و رنج را تجربه کنی."],[829,"در عهد تو ای نگار دلبند!","بس عهد که بشکنند و سوگند","در زمان تو ای محبوب عزیزم! بسیارند کسانی که پیمان‌ها را می‌شکنند و به قسم‌های خود وفا نمی‌کنند."],[829,"بر جان ضعیف آرزومند","زین بیش، جفا و جور مپسند","برای جان ناتوان آرزومند، دیگر از این بیشتر بی‌رحمی و ظلم را نپسند."],[829,"من چون تو دگر ندیده‌ام خوب","منظور جهانیان و محبوب","من هیچ‌کس را مانند تو ندیده‌ام که هم مورد توجه جهانیان باشد و هم محبوب."],[829,"دیگر نرود به هیچ مطلوب","خاطر که گرفت با تو پیوند","هیچ آرزو و خواسته‌ای دیگر در دل نمی‌ماند، چون پیوند و ارتباط با تو، همه چیز را برایم کامل کرده است."],[829,"ما را هوس تو کس نیاموخت","پروانه به جهد خویشتن سوخت","هیچ‌کس به ما یاد نداد که خواهان تو باشیم؛ مانند پروانه‌ای هستیم که برای رسیدن به تو سختی‌ها را تحمل کرده و در این راه از درون می‌سوزد."],[829,"عشق آمد و چشم عقل بر دوخت","شوق آمد و بیخ صبر برکند","عشق به قلب انسان راه پیدا کرد و عقل را از توجه به آن باز داشت. شوق نیز به قدری زیاد شد که ریشه صبر را از زمین کند."],[829,"دوران تو نادر اوفتادست","کاین حسن، خدا به کس ندادست","وجود تو در این زمان بسیار نادر است، زیرا این زیبایی را خداوند به کسی دیگر نداده است."],[829,"در هیچ زمانه‌ای نزادست","مادر به جمال چون تو فرزند","در هیچ دوره‌ای مادری، فرزندی به زیبایی تو به دنیا نیاورده است."],[829,"ای چشم و چراغ دیده و حی!","خون ریختنم چه می‌کنی هی؟","ای چشم و چراغ وجود من و حیای من! تو چه فوایدی از ریختن خون من می‌بری؟"],[829,"این جور که می‌بریم تا کی؟","وین صبر که می‌کنیم تا چند؟","این‌گونه که ما در رنج و سختی زندگی می‌کنیم، تا کی باید ادامه بدهیم؟ و این صبری که داریم، تا چه زمانی می‌توانیم تحمل کنیم؟"],[829,"هر لحظه به سر درآیدم دود","فریاد و جزع نمی‌کند سود","هر لحظه در حالات نگران‌کننده و پر از درد به سر می‌آیم، ولی فایده‌ای ندارد و منفعتی از آن حاصل نمی‌شود."],[829,"افتادم و مصلحت چنین بود","بی‌بند نگیرد آدمی پند","من به زمین افتادم و این به خاطر مصلحت و سرنوشت من اینگونه بود که انسان نباید به هیچ پند و نصیحتی گوش کند."],[829,"دل رفت و عنان طاقت از دست","سیل آمد و ره نمی‌توان بست","دل من رفته و دیگر در کنترل من نیست و طاقت و طاقت‌سنجی‌ام از بین رفته است. مانند سیلاب، به راه‌ خود ادامه می‌دهد و نمی‌توان آن را متوقف کرد."],[829,"من نیستم ار کسی دگر هست","از دوست به یاد دوست خرسند","اگر کسی دیگر هم جز من در یاد دوست باشد، من خوشحال نیستم."],[829,"مهر تو نگار سرو قامت","بر من رقم‌ست تا قیامت","محبت تو ای معشوق، مانند زیبایی و قامت راستینت، بر من نقش بسته است و این اثر تا قیامت باقی خواهد ماند."],[829,"بادست به گوش من ملامت","واندوه فراق، کوه الوند","عذاب و درد جدایی تو، مانند کوه الوند (کوهی معروف در ایران) بر گوش من سنگینی می‌کند و مرا آزار می‌دهد."],[829,"دل در طلب تو رفت و دینم","جان نیز طمع کنی یقینم","دل من برای رسیدن به تو رفته و ایمانم نیز جانم را می‌طلبد؛ می‌دانی که من به تو اطمینان دارم."],[829,"مستوجب این و بیش ازینم","باشد که چو مردم خردمند","من سزاوار این حال و حتی بیشتر از آن هستم، زیرا مانند آدم‌های خردمند فکر می‌کنم."],[829,"بنشینم و صبر پیش گیرم","دنباله کار خویش گیرم","من در جایی آرام می‌نشینم و با تحمل و شکیبایی، به کارهای خود رسیدگی می‌کنم."],[830,"می‌میرم و همچنان نظر بر چپ و راست","تا آن که نظر در او توان کرد کجاست؟","من در حال مرگ هستم و هنوز به اطراف نگاه می‌کنم تا ببینم آن کسی که باید به او نگاه کنم، کجا است."],[831,"از روی نکو صبر نمی‌شاید کرد","لیکن نه به اختیار می‌باید کرد","شاید نتوان به راحتی و بدون تلاش به صبر دست یافت، اما لازم است که به صورت ارادی و با انتخاب خود، این صبر را تمرین کنیم."],[832,"خفتی و به خفتنت پراکنده شدیم","برخاستی و به دیدنت زنده شدیم","در زمانی که خواب بودی، ما هم به خاطر خواب تو پراکنده شدیم؛ اما وقتی بیدار شدی و تو را دیدیم، زندگی دوباره در ما جاری شد."],[833,"نقاب از بهر آن باشد که بربندند روی زشت","تو زیبایی به نام ایزد چرا باید که بربندی؟","نقاب برای این است که چهره زشت تو را بپوشاند و زیبایی را به نام خداوند نشان دهد. چرا باید چهره‌ات را بپوشانی؟"],[834,"می‌شنیدم به حسن چون قمری","چون بدیدم از آن تو خوب‌تری","این جمله به این معناست که شخصی اشاره می‌کند که قبلا درباره زیبایی یک معشوق صحبت‌هایی شنیده است، اما پس از دیدن معشوقی دیگر، متوجه می‌شود که آن شخص که دیده، از همه زیباتر است."]]}