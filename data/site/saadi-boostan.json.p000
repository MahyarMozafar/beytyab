ت در میان دو شخص","/saadi/boostan/bab9/sh9"],["باب نهم در توبه و راه صواب، بخش ۱۰ - حکایت","/saadi/boostan/bab9/sh10"],["باب نهم در توبه و راه صواب، بخش ۱۱ - موعظه و تنبیه","/saadi/boostan/bab9/sh11"],["باب نهم در توبه و راه صواب، بخش ۱۲ - حکایت در عالم طفولیت","/saadi/boostan/bab9/sh12"],["باب نهم در توبه و راه صواب، بخش ۱۳ - حکایت","/saadi/boostan/bab9/sh13"],["باب نهم در توبه و راه صواب، بخش ۱۴ - حکایت","/saadi/boostan/bab9/sh14"],["باب نهم در توبه و راه صواب، بخش ۱۵ - حکایت","/saadi/boostan/bab9/sh15"],["باب نهم در توبه و راه صواب، بخش ۱۶ - حکایت مست خرمن سوز","/saadi/boostan/bab9/sh16"],["باب نهم در توبه و راه صواب، بخش ۱۷ - حکایت","/saadi/boostan/bab9/sh17"],["باب نهم در توبه و راه صواب، بخش ۱۸ - حکایت زلیخا با یوسف (ع)","/saadi/boostan/bab9/sh18"],["باب نهم در توبه و راه صواب، بخش ۱۹ - مثل","/saadi/boostan/bab9/sh19"],["باب نهم در توبه و راه صواب، بخش ۲۰ - حکایت سفر حبشه","/saadi/boostan/bab9/sh20"],["باب نهم در توبه و راه صواب، بخش ۲۱ - حکایت","/saadi/boostan/bab9/sh21"],["باب نهم در توبه و راه صواب، بخش ۲۲ - حکایت","/saadi/boostan/bab9/sh22"],["باب دهم در مناجات و ختم کتاب، بخش ۱ - سرآغاز","/saadi/boostan/bab10/sh1"],["باب دهم در مناجات و ختم کتاب، بخش ۲ - حکایت","/saadi/boostan/bab10/sh2"],["باب دهم در مناجات و ختم کتاب، بخش ۳ - حکایت بت پرست نیازمند","/saadi/boostan/bab10/sh3"],["باب دهم در مناجات و ختم کتاب، بخش ۴ - حکایت","/saadi/boostan/bab10/sh4"]],"couplets":[[0,"به نام خداوند جان‌آفرین","حکیم سخن‌ در زبان‌آفرین","به نام خداوندی که آفریننده جان است؛ خدای دانا و حکیمی که آفریننده سخن در زبان است."],[0,"خداوند بخشنده دستگیر","کریم خطابخش پوزش‌پذیر","خداونده بخشنده مهربان؛ بخشاینده و آمرزش‌گر و عفو‌کننده"],[0,"عزیزی که هر کز درش سر بتافت","به هر در که شد هیچ عزّت نیافت","عزیزی (خداوند) که هر کس از وی (خداوند) روی گردان شد ، هیچ احترام و عزتی نمی‌بیند."],[0,"سر پادشاهان گردن‌فراز","به درگاه او بر زمین نیاز","پادشاهان مغرور و گردن‌فراز هم وقتی به درگاه خداوند می‌آیند، به نشانه نیاز و بندگی سر به زمین می‌سایند."],[0,"نه گردن‌کشان را بگیرد به فور","نه عذرآوران را براند به جور","نه گردن‌کشان و طاغیان را با شتاب تنبیه می‌کند و نه توبه‌کنندگان را با جفا و جور از درگاه خود می‌راند."],[0,"وگر خشم گیرد ز کردار زشت","چو بازآمدی ماجرا درنوشت","اگر از رفتار زشت تو خشمگین شود، وقتی از کار خود پشیمان شوی و به راه درست برگردی،او نیز فراموش میکند!"],[0,"اگر با پدر جنگ جوید کسی","پدر بی‌گمان خشم گیرد بسی","اگر کسی با پدرش به ستیزه بپردازد، قطعا پدر به شدت خشمگین خواهد شد."],[0,"وگر خویش راضی نباشد ز خویش","چو بیگانگانش براند ز پیش","حتی اگر بین دو خویشاوند عدم رضایت و دلخوری وجود داشته باشد یکدیگر را طوری از خود می‌رانند که انگار دو غریبه هستند"],[0,"وگر بنده چابک نباشد به کار","عزیزش ندارد خداوندگار","و اگر برده برای کار و تلاش در خدمت به مالک خودش سریع و چابک نباشد، مالک و صاحبش او را دوست نمیدارد"],[0,"وگر بر رفیقان نباشی شفیق","به فرسنگ بگریزد از تو رفیق","اگر با دوستانت مهربان نباشی، حتی دوستانت هم از تو دور خواهند شد."],[0,"وگر ترک خدمت کند لشکری","شود شاه لشکرکش از وی بری","اگر یک جنگاور و لشکری ترک خدمت کند فرمانده و شاه لشکر به‌او مزد نمی‌دهد و از او پشتیبانی نمی‌کند."],[0,"ولیکن خداوند بالا و پست","به عصیان، در رزق بر کس نبست","اما خداوند آسمان‌ها و زمین و صاحب بالا و پست، در برابر نافرمانی، درهای روزی را به روی کسی نمی‌بندد."],[0,"دو کونش یکی قطره از بحر علم","گنه بیند و پرده پوشد به حلم","تمام دو جهان (دنیا و آخرت) یک قطره از دریای علم او هستند و همه‌چیز را می‌داند و گناهان را می‌بیند و با بزرگواری چشم‌پوشی می‌کند."],[0,"ادیم زمین، سفره عام اوست","بر این خوان یغما چه دشمن چه دوست","زمین، میزبان همگان است و همه در این دنیا بر سر این سفره نشسته‌اند، چه دشمنان و چه دوستان."],[0,"اگر بر جفاپیشه بشتافتی","که از دست قهرش امان یافتی؟","اگر در مجازات ستمگر شتاب می‌کرد‌، آیا کسی زنده می‌ماند؟"],[0,"بری ذاتش از تهمت ضد و جنس","غنی، ملکش از طاعت جن و انس","از داشتن مثل و ضد مبراست و فرمانروایی‌اش بی‌نیاز از عبادت و بندگی جن و انسان است."],[0,"پرستار امرش همه چیز و کس","بنی‌آدم و مرغ و مور و مگس","همه چیز و همه موجودات، از انسان‌ها و پرندگان تا حشرات و مگس‌ها، در خدمت و تحت فرمان خداوند هستند و او بر همه این‌ها نظارت دارد."],[0,"چنان پهن خوان کرم گسترد","که سیمرغ در قاف قسمت خورد","چنان سفره نعمت و رحمت خداوند گسترده است که حتی سیمرغ، پرنده افسانه‌ای، نیز از آن بهره‌مند می‌شود."],[0,"لطیف کرم‌گستر کارساز","که دارای خلق است و دانای راز","خداوند لطیف و بخشنده‌ای است که همه‌چیز را با لطفش می‌گستراند و به کارها رسیدگی می‌کند. او دارای صفات نیکو و دانش پنهان است."],[0,"مر او را رسد کبریا و منی","که ملکش قدیم است و ذاتش غنی","خداوند که بزرگ است و برتر از هر چیز، مختصاتی چون قدرت و غنای ذاتی دارد، در حالی که من (انسان) که همواره در معرض زوال و تغییّر هستم، تنها بخشی از مخلوقات او به شمار می‌روم."],[0,"یکی را به سر بر نهد تاج بخت","یکی را به خاک اندر آرد ز تخت","خداوند سرنوشت هر کسی را به گونه‌ای رقم می‌زند؛ به این معنا که او برخی را به مقام و اقبال وای می‌نشاند و برخی دیگر را به ذلت و زوال می‌کشاند."],[0,"کلاه سعادت یکی بر سرش","گلیم شقاوت یکی در برش","برخی افراد برگزیده به نعمت و خوشبختی دست می‌یابند و برخی دیگر به مشقت و بدبختی دچار می‌شوند."],[0,"گلستان کند آتشی بر خلیل","گروهی به آتش برد ز آب نیل","آتش را بر خلیل(اشاره به حضرت ابراهیم(علیه السلام)) مانند گلستان میکند و گروهی را از آتش به سوی نیل میبرد(اشاره به داستان حضرت موسی(علیه السلام))"],[0,"گر آن است، منشور احسان اوست","ور این است، توقیع فرمان اوست","معنی این بیت به بیت قبل برمیگردد؛ اگر خداوند آتش را به گلستان تبدیل میکند از روی لطف و عنایت و نیکویی اوست ، و اگر لشکریان فرعون را در آب نیل غرق میکند و آنها را به آتش دوزخ می اندازد این هم از روی قهر و خشم و تحت فرمان خودش است."],[0,"پس پرده بیند عمل‌های بد","هم او پرده پوشد به آلای خود","خداوند اعمال ناپسند را می‌بیند و با نیکویی خود آن را مخفی نگه می دارد."],[0,"به تهدید اگر برکشد تیغ حکم","بمانند کروبیان صمّ و بکم","اگر در مورد کسی حکم قاطعانه‌ای صادر شود، گویی که او مانند فرشتگان (کروبیان) و بی‌صدا و گنگ (صمّ و بکم) مانده است و نمی‌تواند اعتراضی کند."],[0,"وگر دردهد یک صلای کرم","عزازیل گوید نصیبی برم","هنگامی که خداوند سفره‌ی نعمت خودش رو از روی کرم و بزرگواری پهن میکند، شیطان نیز خواهد گفت که من هم سهمی از این نعمت میخواهم بردارم."],[0,"به درگاه لطف و بزرگیش بر","بزرگان نهاده بزرگی ز سر","در درگاه الهی، بزرگواران و عالمان به خاطر مقام والایشان، از روی عظمت و بزرگی سر تعظیم فرود می‌آورند."],[0,"فروماندگان را به رحمت قریب","تضرع‌کنان را به دعوت مجیب","فروماندگان (کسانی که در زندگی دچار مشکل و ناامیدی شده‌اند) را به رحمت خداوند نزدیک می‌داند و کسانی که به او تضرع و دعا می‌کنند (از روی نیاز و خواهش) را دعوت می‌کند تا به او پاسخ داده شود."],[0,"بر احوال نابوده، علمش بصیر","به اسرار ناگفته، لطفش خبیر","کارهای انجام نشده را پیشاپیش میبیند و از رازهای گفته نشده آگاهی دارد."],[0,"به قدرت، نگهدار بالا و شیب","خداوند دیوان روز حسیب","این بیت به قدرت و توانایی خداوند اشاره دارد که خداوندی که صاحب دفتر حساب روز قیامت است با قدرت و توانایی خود آسمان و زمین را نگهداری و محافظت می کند."],[0,"نه مستغنی از طاعتش پشت کس","نه بر حرف او جای انگشت کس","هیچ‌کس بدون عبادت و طاعت خداوند بی‌نیاز نیست و هیچ‌کسی نمی‌تواند در سخن خداوند، جایی برای خود تصور کند."],[0,"قدیمی نکوکار نیکی‌ پسند","به کلک قضا در رحم نقش‌بند","خداوند نیکوکاری که از روز ازل و از قدیم پروردگار جهان و جهانیان است و نیکی و خوبی و نیکوکاران را دوست دارد با قلم تقدیر چهره‌های زیبا را در رحم مادر نقاشی و تصویر‌گری میکند."],[0,"ز مشرق به مغرب مه و آفتاب","روان کرد و بنهاد گیتی بر آب","خورشید و ماه از سمت شرق تا غرب در حال حرکتند و جهان خاکی را بر روی آب بنا نهاد.(نظریه‌ی فیلسوفان زمان سعدی بوده است)"],[0,"زمین از تب لرزه آمد ستوه","فروکوفت بر دامنش میخ کوه","زمین از زلزلزه‌های بوجود آمده بشدت به لرزش در می‌آیند و خداوند برای حفاظت از زمین کوه‌ها را بمانند میخی در زمین کوفته است.(نظر فیلسوفان قدیم)"],[0,"دهد نطفه را صورتی چون پری","که کرده‌ست بر آب صورتگری؟","نطفه را به مانند پری صورت نگاری میکند، تا به حال چه کسی را دیده‌اید که بتواند بر روی آب تصویر بکشد یا به عبارتی روی آب بتواند نقاشی بکشد؟"],[0,"نهد لعل و پیروزه در صلب سنگ","گل لعل در شاخ پیروزه‌ رنگ","خداوند، سنگ سخت را به رنگ‌های زیبا و قیمتی، مانند لعل و پیروزه، تجهیز کرده و در آن‌ها نهفته است. به عبارت دیگر، او زیبایی‌های پنهان را حتی در چیزی به ظاهر سخت و بی‌جان قرار داده است."],[0,"ز ابر افکند قطره‌ای سوی یم","ز صلب افکند نطفه‌ای در شکم","از ابر، قطره‌ای به سمت دریا می‌ریزد و از صلب، نطفه‌ای در رحم قرار می‌گیرد."],[0,"از آن قطره لولوی لالا کند","وز این، صورتی سروبالا کند","معنی این بیت برمی‌گردد به بیت قبل؛ از آن قطره مروارید زیبا در کف دریا و در دل صدف بوجود می‌آید و از این نطفه، چهره‌ای خوش‌فرم و زیبا شکل می‌گیرد."],[0,"بر او علم یک ذره پوشیده نیست","که پیدا و پنهان به نزدش یکی‌ست","خداوند به خوبی می‌داند که هیچ چیزی از او پنهان نیست و برای او تفاوتی بین آشکار و نهان وجود ندارد."],[0,"مهیاکن روزی مار و مور","اگر چند بی‌دست‌وپای‌اند و زور","خداوند روزی و نعمت را برای همه مخلوقات، حتی برای مار و مور که فاقد دست و پا و توانایی هستند، مهیا می‌کند."],[0,"به امرش وجود از عدم نقش بست","که داند جز او کردن از نیست، هست؟","به اراده خداوند، وجود از هیچ به وجود آمد. چه کسی جز او می‌داند که از عدم، چگونه می‌توان به هستی رسید؟"],[0,"دگر ره به کتم عدم در برد","وز آنجا به صحرای محشر برد","دوباره راهی به تاریکی عدم پیدا نمی‌شود و از آن‌جا به روز قیامت می‌برد."],[0,"جهان متّفق بر الهیتش","فرومانده از کنه ماهیتش","جهان بر وجود خداوند متفق است، اما از ذات واقعی او درک و فهمی ندارد."],[0,"بشر ماورای جلالش نیافت","بصر منتهای جمالش نیافت","انسان نمی‌تواند عظمت و جلال خداوند را به طور کامل درک کند و نمی‌تواند نهایت زیبایی و جمال او را بیابد."],[0,"نه بر اوج ذاتش پرد مرغ وهم","نه در ذیل وصفش رسد دست فهم","نه تصور ما از ذات خداوند به اوج عظمت او می‌رسد و نه قدرت درک ما به پایین‌ترین بخش وصف او دست می‌یابد."],[0,"در این ورطه کشتی فرو شد هزار","که پیدا نشد تخته‌ای بر کنار","معنی این بیت برمی‌گردد به بیت قبل؛در این مسیر سخت و دشوار که شناخت ذات خداوند منظور است، بسیاری در برابر این امر مشکل غرق شدند و هیچ کمک یا راه نجاتی برای آنها پیدا نشد."],[0,"چه شب‌ها نشستم در این سیر، گم","که دهشت گرفت آستینم که قم","شب‌های زیادی را در این مسیر شناخت ذات حق نشستم و در افکارم گم شده بودم، تا اینکه اسرگشتگی و اضطراب دستم را گرفت و به من گفت از این افکار برون شو و برخیز."],[0,"محیط است علم ملک بر بسیط","قیاس تو بر وی نگردد محیط","علم خداوند، چون سلطانی بر گستره سرزمین حکمفرما است و شما نمی‌توانید با قیاس و مقایسه بر او احاطه یابید یا او را به چالش بکشید."],[0,"نه ادراک در کنه ذاتش رسید","نه فکرت به غور صفاتش رسید","نه فهم انسان به عمق ذات خداوند دست می‌یابد و نه تفکر او به ژرفای صفات الهی می‌رسد."],[0,"توان در بلاغت به سحبان رسید","نه در کنه بی‌چون سبحان رسید","سخن در فصاحت و شیوایی به حد سحبان وائل (خطیب معروف عرب) رسیده است و به بهترین شکل بیان می‌شود، اما کسی تا بحال به عمق ذات و وجود مطلق و بی‌نقص خداوند منزه و پاک نتوانسته است دست یابد و آن را بشناسد."],[0,"که خاصان در این ره فرس رانده‌اند","به لااحصی از تک فرومانده‌اند","خاصان درگاه حق در مسیر شناخت خداوند، با اسب‌ اندیشه تاخته و کوشیده‌اند در حالی که از عهده ثنا و ستایش خداوند نتواسته‌اند برآیند از این مسیر عقب مانده‌اند."],[0,"نه هر جای مرکب توان تاختن","که جاها سپر باید انداختن","هر مکانی برای پیشرفت و موفقیت مناسب نیست و گاهی اوقات نیاز است که در صورت نیاز تسلیم تقدیر شویم."],[0,"وگر سالکی محرم راز گشت","ببندند بر وی در بازگشت","اگر سالکی به مقام و رتبه‌ای از معرفت رسید و رازها را شناخت، برای او در بازگشت به دنیا بسته می‌شود تا به آسانی نتواند برگردد."],[0,"کسی را در این بزم ساغر دهند","که داروی بیهوشی‌اش دردهند","در این میهمانی، تنها کسی حق نوشیدن باده عشق حقیقی را دارد که از درد و رنج خود رها شود و به حالت بی‌خبری فرو برود."],[0,"یکی باز را دیده بردوخته‌ست","یکی دیده‌ها باز و پر سوخته‌ست","باز شکاریی که بال و پر دارد چشم او بسته است و نمی بیند . و بازی که چشمش باز است و بیناست پر و بالش سوخته و توانایی پریدن ندارد"],[0,"کسی ره سوی گنج قارون نبرد","وگر برد، ره باز بیرون نبرد","هیچ‌کس گنج قارون(شناخت ذات خداوند) را نتوانسته است بدست آورد و اگر کسی هم به آن برسد، هیچ‌گاه نمی‌تواند از آن خارج شود."],[0,"بمردم در این موج دریای خون","کز او کس نبرده‌ست کشتی برون","من در این امواج خون(دریای شناخت خدا) غرق می‌شوم و هیچ‌کس نتوانسته از آن خارج شود."],[0,"اگر طالبی کاین زمین طی کنی","نخست اسب بازآمدن پی کنی","اگر عزم جدی داری که در وادی معرفت خدا وارد شوی اولین کار این است که به فکر بازگشت از این مسیر نباشی و تردید و تعلق را رها کنی"],[0,"تأمل در آیینه دل کنی","صفایی به‌تدریج حاصل کنی","اگر در دل خود تأمل و فکر کنی، به‌تدریج صفا و روشنی حاصل خواهی کرد."],[0,"مگر بویی از عشق مستت کند","طلبکار عهد الستت کند","آیا بویی از عشق تو را مجذوب و دلبسته نمی‌کند و نسبت به پیمانی که در آغاز وجودت بسته شده(عهد الست)، طلبکار نمی‌شود؟"],[0,"به پای طلب ره بدان جا بری","وز آنجا به بال محبت پری","برای رسیدن به مقصد دلخواه، باید تلاش کنی و در نهایت از آنجا به آغوش عشق و محبت خداوند وارد شوی."],[0,"بدرّد یقین پرده‌های خیال","نماند سراپرده إلّا جلال","هنگامی که به یقین مرسی، دیگر هیچ پرده‌ای از خیال باقی نماند و جلوه‌ای از جلال و عظمت خداوند در برابر شما آشکار می شود."],[0,"دگر مرکب عقل را پویه نیست","عنانش بگیرد تحیّر که بیست","عقل دیگر توان حرکت و پیشروی ندارد و شگفت‌زده است، مانند اسبی که مهار آن به دست کسی نیست و به خاطر بی‌هدفی در سرگردانی قرار دارد."],[0,"در این بحر جز مرد راعی نرفت","گم آن شد که دنبال داعی نرفت","در این دریا فقط مردی که چوپانی می‌کند گم شده است، چرا که او از پی دعوت‌کننده نرفته است."],[0,"کسانی کز این راه برگشته‌اند","برفتند بسیار و سرگشته‌اند","کسانی که از این راه (طریق هدایت) منحرف شده‌اند، بسیارند و در نتیجه گمراه و سردرگم شده‌اند."],[0,"خلاف پیمبر کسی ره گزید","که هرگز به منزل نخواهد رسید","کسی که به غیر از راه پیامبر (محمد) برود، به منزل مقصود نخواهد رسید و در حقیقت به مقصد نخواهد رسید."],[0,"مپندار سعدی که راه صفا","توان رفت جز بر پی مصطفی","سعدی نمی‌گوید مسیر پاکی و سعادتی وجود ندارد، مگر اینکه از طریق پیامبر اسلام (مصطفی) سپری شود."],[1,"کریم السجایا جمیل الشیم","نبی البرایا شفیع الامم","دارای خصلت‌های نیکو و زیبایی‌های اخلاق؛ پیامبر و شفاعت کننده امت‌ها و مردم."],[1,"امام رسل، پیشوای سبیل","امین خدا، مهبط جبرئیل","امام پیامبران‌ و پیشوای راه و راهنما، امین و امانت‌دار خدا و کسی که جبرییل بر او نازل گشت."],[1,"شفیع الوری، خواجه بعث و نشر","امام الهدی، صدر دیوان حشر","شفاعت‌کننده مردم در قیامت، بزرگ و سرور بعث و روز قیامت. امام و پیشوای هدایت‌؛ و صدر و بالای روز حساب و قیامت."],[1,"کلیمی که چرخ فلک طور اوست","همه نورها پرتو نور اوست","کلیمی که تمام هستی طور اوست؛ هرچه هدایت و دانایی و نور است همه از نور اوست."],[1,"شفیع مطاع نبی کریم","قسیم جسیم نسیم وسیم","نبی کریم (پیامبر اسلام) که شفاعتش مورد قبول و احترام است، در میان فرشتگان و بندگان خدا، خوش‌هیکل و زیباست."],[1,"یتیمی که ناکرده قرآن درست","کتب‌خانه چند ملت بشست","یتیمی که هنوز قرآن را کامل نکرده بود و در آغازش بود، کتاب‌خانه و علوم چند ملت را بی‌اثر کرد.(منظور کتب تورات و انجیل است)"],[1,"چو عزمش برآهخت شمشیر بیم","به معجز میان قمر زد دو نیم","وقتی که عزم کرد و شمشیر مجازات را کشید با معجزه خود ماه را به دو نیم کرد."],[1,"چو صیتش در افواه دنیا فتاد","تزلزل در ایوان کسری فتاد","زمانی که نام و مقام او (پیامبر) در زبان‌های مردم دنیا مشهور شد، لرزشی در کاخ کسری (کاخ پادشاهان ساسانی) به وجود آمد."],[1,"به لا قامت لات بشکست خرد","به اعزاز دین آب عزی ببرد","با یک «لا» بت لات را شکست و با عزیز داشتن دین خدا، آبروی بت عزی را برد.(منظور از \"لا\" همان لااله‌الی‌الله است)"],[1,"نه از لات و عزی برآورد گرد","که تورات و انجیل منسوخ کرد","نه فقط لات و عزی را نابود کرد بلکه تورات و انجیل را نیز منسوخ کرد."],[1,"شبی بر نشست از فلک برگذشت","به تمکین و جاه از ملک درگذشت","یک شب بر مرکب سوار شد و از بزرگی و شکوه از فرشتگان پیشی گرفت."],[1,"چنان گرم در تیه قربت براند","که بر سدره جبریل از او بازماند","چنان به نهایت تقرب به بارگاه الهی رفت که جبرییل بر سدره جاماند و نتوانست پیش‌تر برود.( درخت سدره؛ مکانی که فرشتگان از آن جلوتر نمیتوانند بروند)"],[1,"بدو گفت سالار بیت‌الحرام","که ای حامل وحی برتر خرام","سالار بیت‌الحرام (حضرت رسول) به او گفت: ای آورنده پیام وحی، بالاتر بیا."],[1,"چو در دوستی مخلصم یافتی","عنانم ز صحبت چرا تافتی؟","وقتی که مرا دوستی یگانه و مخلص یافتی چرا مرا تنها گذاشتی ؟"],[1,"بگفتا فراتر مجالم نماند","بماندم که نیروی بالم نماند","جبرییل گفت‌: پیش‌تر و جلوتر راه ندارم و خسته‌ام و نیروی پرواز بیشتر ندارم."],[1,"اگر یک سر موی برتر پرم","فروغ تجلی بسوزد پرم","اگر به اندازه یک سر مو بالاتر بروم فروغ تجلی حق‌، بال و پر مرا می‌سوزاند."],[1,"نماند به عصیان کسی در گرو","که دارد چنین سیدی پیشرو","کسی که سید و پیشرو او چنین کسی است در گمراهی نمی‌ماند."],[1,"چه نعت پسندیده گویم تو را؟","علیک السلام ای نبی الوری","چه مدح و ستایش شایسته‌ای درباره تو بگویم؟ سلام بر تو، ای پیامبر پیشوای همه انسان‌ها."],[1,"درود ملک بر روان تو باد","بر اصحاب و بر پیروان تو باد","درود و آفرین و سلام فرشتگان بر روان تو و کسانی که با تو هستند، بادا!"],[1,"نخستین ابوبکر پیر مرید","عمر، پنجه بر پیچ دیو مرید","نخستین ابوبکر آن دانای اراده‌کننده و عمر کسی که پنجه دیو سرکش را بر‌پیچید. (مرید در مصرع اول یعنی اراده‌کننده‌، و مرید در مصرع دوم یعنی سرکش و شریر)"],[1,"خردمند عثمان شب زنده‌دار","چهارم علی، شاه دلدل سوار","عثمان خردمند که شب‌زنده‌دار و عابد بود، چهارم علی‌، آن شاه و فرمان‌روای دلدل‌سوار.(دلدل نام اسبی است که پیامبر سلام‌الله‌علیه به حضرت علی بخشید)"],[1,"خدایا به حق بنی فاطمه","که بر قولم ایمان کنم خاتمه","خدایا به حق فرزندان فاطمه، با دعایم خاتمه مرا ایمان بگردان."],[1,"اگر دعوتم رد کنی ور قبول","من و دست و دامان آل رسول","اگر دعای من را رد کنی یا قبول کنی، من به دست و دامان آل رسول پناه می‌برم"],[1,"چه کم گردد ای صدر فرخنده پی","ز قدر رفیعت به درگاه حی","ای پیامبر خوشبخت و ای صدرنشین روز قیامت، از بزرگی و مقام بلندت در درگاه الهی چه چیزی کم خواهد شد؟"],[1,"که باشند مشتی گدایان خیل","به مهمان دارالسلامت طفیل","معنی این بیت دنباله‌ی بیت قبل است ؛ که جمعی از گدایان نیز در مهمانی بخشش و عفو تو باشند؟"],[1,"خدایت ثنا گفت و تبجیل کرد","زمین بوس قدر تو جبریل کرد","خداوند تو را ستایش و عظیم می‌دارد و جبریل، فرشته‌ای که از جایگاه تو باخبر است، به احترام تو بر زمین می‌افتد."],[1,"بلند آسمان پیش قدرت خجل","تو مخلوق و آدم هنوز آب و گل","آسمان در برابر عظمت تو شرمنده است و تو مخلوق بودی وقتی که آدم هنوز آب و گل بود."],[1,"تو اصل وجود آمدی از نخست","دگر هرچه موجود شد فرع توست","اصل وجود از ابتدا تو بودی، موجودات و مخلوقات دیگر فقط به خاطر وجود تو خلق شده است."],[1,"ندانم کدامین سخن گویمت","که والاتری زانچه من گویمت","نمی‌دانم چه سخنی در وصفت بگویم که از هرچه گویم، ارزشمندتری."],[1,"تو را عز لولاک تمکین بس است","ثنای تو طه و یس بس است","همان عزت و مقام که خدا تو را داد و فرمود «لولاک لما خلقت الافلاک» برای عظمت و بزرگی تو کافی است، برای ثنا و آفرین و مدح تو، سوره‌های جلیل طه و یس کافی است."],[1,"چه وصفت کند سعدی ناتمام؟","علیک الصلوة ای نبی السلام","سعدی‌ ناتمام (سعدی که هنوز خود به مقصود و مقصد نرسیده ) چگونه می‌تواند تو را وصف کند؟ درود فراوان بر تو باد ای پیامبر!"],[2,"در اقصای عالم بگشتم بسی","به سر بردم ایام با هر کسی","در نقاط دور و نزدیک دنیا سفر کردم و مدت زیادی را با افراد مختلف گذراندم."],[2,"تمتع به هر گوشه‌ای یافتم","ز هر خرمنی خوشه‌ای یافتم","از هر گوشه‌ و کنار دنیا چیزهای خوبی نصیبم شد و بهره بردم و از هر جمع و گروهی تجربه‌ای به دست آوردم."],[2,"چو پاکان شیراز، خاکی‌نهاد","ندیدم، که رحمت بر این خاک باد","هیچ‌کس را مانند پاکدلان شیرازی، فروتن ندیدم که رحمت بر خاک این سرزمین سزاوار باشد."],[2,"تولای مردان این پاک‌بوم","برانگیختم خاطر از شام و روم","محبت و ارادت به مردان این سرزمین پاک (شیراز) خاطر من را از سرزمین‌های شام و روم به سمت شیراز برانگیخت."],[2,"دریغ آمدم زآن همه بوستان","تهیدست رفتن سوی دوستان","حیفم آمد که از آن همه باغ و بوستان که تماشای آن در طی این سفر نصیبم شد دست خالی به دیار خود و نزد دوستان برگردم و تحفه‌ای به ارمغان نبرم."],[2,"به دل گفتم از مصر قند آورند","بر دوستان ارمغانی برند","در دل به خودم گفتم تا برای دوستان قند مصری برای سوغات ببرم. (قند مصر در آن زمان معروف بوده است)"],[2,"مرا گر تهی بود از آن قند، دست","سخن‌های شیرین‌تر از قند هست","حال که من قند مصری برای سوغات نیاوردم، اما می‌توانم سخنانی شیرین‌تر از قند بگویم."],[2,"نه قندی که مردم به صورت خورند","که ارباب معنی به کاغذ برند","نه قندی که مردم در صورتی به شکل خوراکی می‌خورند، بلکه کسانی که به حقیقت آگاه‌اند، آن را به کاغذ منتقل کرده و معنا و مفهوم آن را در نوشته‌ها بیان می‌کنند."],[2,"چو این کاخ دولت بپرداختم","بر او ده در از تربیت ساختم","وقتی که این کتاب را نوشتم، ده در را از تربیت و آموزش برای فصلهای آن در نظر گرفتم."],[2,"یکی باب عدل است و تدبیر و رای","نگهبانی خلق و ترس خدای","باب اول، باب عدل و تدبیر و اندیشه است که از آنها امنیت خلق و ترس از خدا حاصل می‌شود"],[2,"دوم باب احسان نهادم اساس","که منعم کند فضل حق را سپاس","پایه باب دوم را بر احسان گذاشتم تا توانگران شکرگزار فضل و بخشش خدا باشند"],[2,"سوم باب عشق است و مستی و شور","نه عشقی که بندند بر خود بزور","باب سوم،درباره‌ی عشق حقیقی به خدا و شوق و هیجان رسیدن به اوست، نه عشقی که انسان‌ها به زور وادار به آن شوند."],[2,"چهارم تواضع، رضا پنجمین","ششم ذکر مرد قناعت‌گزین","چهارمین باب حکمت فروتنی است و پنجمین باب رضایت و باب ششم فردیست که همواره متذکر است و در زندگانی قناعت را ترجیح داده"],[2,"به هفتم در، از عالم تربیت","به هشتم در، از شکر بر عافیت","در مرحله هفتم، صحبت از تعلیم و پرورش است و در مرحله هشتم، به سپاسگزاری از نعمت‌های زندگی و سلامتی اشاره می‌شود."],[2,"نهم باب توبه است و راه صواب","دهم در مناجات و ختم کتاب","باب نهم؛به توبه و درخواست بخشش اشاره شده است و باب دهم و فصل خاتمه‌ی کتاب ؛ مناجات در درگاه پروردگار است."],[2,"به روز همایون و سال سعید","به تاریخ فرّخ میان دو عید","در روز خوش‌یمن و سال خوشبخت، در زمانی که دو عید خوشحال‌کننده در تاریخ فرخ و شاداب قرار دارد."],[2,"ز ششصد فزون بود پنجاه و پنج","که پر در شد این نامبردار گنج","سال ۶۵۵ ه.ق بود که بوستان که چون گنج است با واژه‌های همچون درّ کتابت شد."],[2,"بمانده‌ست با دامنی گوهرم","هنوز از خجالت به زانو سرم","با دامنی پر از چنین گوهرهایی ( منظور کتاب بوستان است)باز هنوز خجالت زده دوستان هستم و از خجالت سرم بر روی زانو است. (سعدی جان چرا خجالت؟ با این بوستان که آوردی سرت بر آسمان است نه زانو)"],[2,"که در بحر لؤلؤ صدف نیز هست","درخت بلند است در باغ و پست","که در دریای پر از مروارید با ارزش، صدف بی‌ارزش هم هست، همانطور که در باغ هم درخت بلند هست و هم درخت کوتاه ( پس ممکن است که در اشعار بوستان ، ابیات ضعیف هم وجود داشته باشد)"],[2,"الا ای خردمند پاکیزه‌خوی","خردمند نشنیده‌ام عیب‌جوی","ای خردمند پاکیزه سرشت، من در دنیا، خردمندی را سراغ ندارم که بدنبال عیب دیگران می‌گشته است."],[2,"قبا گر حریر است و گر پرنیان","به ناچار حشوش بود در میان","لباس اگرچه با حریر و پرنیان گران‌قیمت هم درست شده باشه باز هم نیاز به پارچه‌هایی برای داخل آن است که آنها ارزان‌قیمت هستند."],[2,"تو گر پرنیانی نیابی، مجوش","کرم کار فرما و حشوش بپوش","با توجه به بیت قبل: اگر همه لباس را پرنیان نیافتی آزرده مشو و از روی گذشت و بخشندگی حشو آن، که همان پارچه‌های داخلی لباس است، را نادیده بگیر."],[2,"ننازم به سرمایه فضل خویش","به دریوزه آورده‌ام دست پیش","من به دانش و فضیلت خود نمی‌بالم؛ زیرا در حال حاضر، به عنوان گدایی علم و داش و تجربیات بیشتر، دست نیاز به سمت دیگران دراز کرده‌ام."],[2,"شنیدم که در روز امیّد و بیم","بدان را به نیکان ببخشد کریم","شنیدم که در روز قیامت، افراد بدکار به دست فرد بخشنده و مهربان (خداوند بلند مرتبه) با وساطت نیکوکاران بخشیده میشوند."],[2,"تو نیز ار بدی بینیم در سخن","به خلق جهان‌آفرین کار کن","تو هم اگر در سخنان و اشعار من ابیات ضعیف دیدی از اخلاق الهی پیروی کن (اشاره به حدیث «تخلقوا بأخلاق الله») و از آنها چشم‌پوشی کن."],[2,"چو بیتی پسند آیدت از هزار","به مردی، که دست از تعنّت بدار","اگر بیتی از هزار بیت پسندت شد، به مردانگیت قسم خط عیب‌جویی را کنار بگذار و به بزرگ‌منشی بپرداز و از ابیات ضعیفم چشم بپوشان."],[2,"همانا که در فارس انشای من","چو مشک است بی‌قیمت اندر ختن","در حقیقت، نوشته‌های من در فارس مانند مشک است که در ختن بی‌اهمیت و بی‌ارزش به نظر می‌رسد.( به خاطر وجود ادیبان و شاعران پرآوازه در پارس)"],[2,"چو بانگ دهل هولم از دور بود","به غیبت درم عیب مستور بود","مثل صدای دهل که از دور خوش است تا زمانی که دور هستم عیب‌هایم پوشیده است اما اگر نزدیک بیایم عیب‌هایم آشکار می‌شود."],[2,"گل آورد سعدی سوی بوستان","به شوخی و فلفل به هندوستان","آوردن گل به بوستان از سوی سعدی کار بیهوده‌ای بود مثل فلفل بردن به هندوستان.( در اینجا منظور جسارت سرودن اشعار بوستان در شهر شیراز با وجود آنهمه شاعر و ادیب نامدار میباشد)"],[2,"چو خرما به شیرینی اندوده پوست","چو بازش کنی استخوانی در اوست","همان گونه که روی خرما با شیرینی پوشانده شده، اگر پوست شیرین آن را کنار بزنی، درونش هسته‌ی خرما وجود دارد، درون ابیات کتاب هم در بین شیرینیهای موجود مطالب ناهمگون و ناهموار هم هست."],[3,"مرا طبع از این نوع خواهان نبود","سر مدحت پادشاهان نبود","من از این نوع شعر و ستایش خاص، چیزی در طبیعت خود نمی‌یابم و نمی‌توانم پادشاهان را مدح کنم."],[3,"ولی نظم کردم به نام فلان","مگر باز گویند صاحبدلان","من به نام فلان کسی، شعری را سروده‌ام و امید است کسانی که اهل دل هستند، درباره‌اش صحبت کنند."],[3,"که سعدی که گوی بلاغت ربود","در ایام بوبکر بن سعد بود","دنباله‌ی بیت قبل؛ سعدی، شاعری بود که در هنر بیان و بلاغت، مقام والایی داشت و در زمان بوبکر بن سعد زندگی می‌کرد."],[3,"سزد گر به دورش بنازم چنان","که سید به دوران نوشیروان","شایسته است که به دوران زمامداری او افتخار کنم، مانند افتخاری که به دوران شخصی به بزرگی نوشیروان می‌کنند."],[3,"جهانبان دین‌پرور دادگر","نیامد چو بوبکر بعد از عمر","در این جهان، شخصی همچون بوبکر بن سعد بن زنگی که دین‌پرور و دادگر باشد، پس از عمر، نیامده است."],[3,"سر سرفرازان و تاج مهان","به دوران عدلش بناز، ای جهان","او سرور سربلندان و تاج افتخار بزرگان است که باید به خاطر دوران عدالتش، جهان و جهانیان به او افتخار کنند."],[3,"گر از فتنه آید کسی در پناه","ندارد جز این کشور آرامگاه","اگر از بلایای زمانه کسی به این سرزمین پناه بیاورد، غیر از این کشور که محلی آرام و بی‌خطر است، مکان دیگری ندارد."],[3,"فطوبی لباب کبیت العتیق","حوالیه من کل فج عمیق","درخت «فطوبی» در بهشت، درختی است که ثمره‌اش بهشت است و به آنجا که «کبیت العتیق» (کعبه باستانی) نزدیک است، در هر درّه عمیق و دوردستی شعاع‌های روشنی از آن می‌تابد."],[3,"ندیدم چنین گنج و ملک و سریر","که وقف است بر طفل و درویش و پیر","من چنین گنج و پادشاهی و تختی ندیده‌ام که اختصاص به کودک، فقیر و پیر دارد و برای آنان وقف شده است."],[3,"نیامد برش دردناک غمی","که ننهاد بر خاطرش مرهمی","نشد غم دردناکی به سراغش بیاید که برای آن تسکینی و راه چاره‌ای نیاورد."],[3,"طلبکار خیر است امیدوار","خدایا امیدی که دارد برآر","آنکه به دنبال خیر و خوبی است، در حق خود از خداوند امیدی در دل دارد. خدایا، آرزوی او را برآورده کن."],[3,"کله گوشه بر آسمان برین","هنوز از تواضع سرش بر زمین","با اینکه گوشه‌ی تاجش به اوج آسمان رسیده،ولی همچنان تواضع و فروتنی در او وجود دارد."],[3,"گدا گر تواضع کند خوی اوست","ز گردن فرازان تواضع نکوست","اگر کسی در حال گدایی تواضع کند، این به خاطر ذات و شخصیت اوست، اما تواضع از سوی کسانی که دارای مقام و قدرت هستند، نیکو و پسندیده نیست."],[3,"اگر زیردستی بیفتد چه خاست؟","زبردست افتاده مرد خداست","اگر کسی در موقعیت و جایگاه اجتماعی پایین‌ فروتنی کند، چه اشکالی دارد؟ و اتفاقی نیافتاده ولی در مقابل، اگر فرد با دانایی و جایگاه اجتماعی بالا فروتن باشد، انسان باخدایست."],[3,"نه ذکر جمیلش نهان می‌رود","که صیت کرم در جهان می‌رود","نه تنها از او به خوبی یاد کردن فراموش نمی‌شود بلکه آوازه و شهرت نیکوکاری و بزرگواری او در تمام جهان منتشر شده است و همه از آن مطلعند."],[3,"چنویی خردمند فرخ نژاد","ندارد جهان تا جهان است، یاد","هیچ خردمندی خوش‌ذات با فطرت و باطن پاک مانند تو در دنیا وجود ندارد و تا زمانی که دنیا برقرار است، نام تو در یادها خواهد ماند."],[3,"نبینی در ایام او رنجه‌ای","که نالد ز بیداد سرپنجه‌ای","در روزگاری که او زمامدار امور بود، هیچ فرد رنجدیده‌ای دیده نشد که از ظلم و ستم ایام حتی به اندازه‌ی نوک انگشتی نالان و شاکی باشد."],[3,"کس این رسم و ترتیب و آیین ندید","فریدون با آن شکوه، این ندید","هیچ‌کس شاهد چنین نظم و زیبایی در زمامداری نبوده است حتی فریدون با آن جلال و عظمت هم، این‌چنین چیزی را در دوران خود ندید."],[3,"از آن پیش حق پایگاهش قوی است","که دست ضعیفان به جاهش قوی است","به خاطر تمام کارهایی که گفته شد و او در دوران زندگانیش انجام داده در پیش خداوند متعال جایگاه والایی دارد و ناتوانان به شکوه و عظمتش تکیه کرده‌اند و به آن دل بسته‌اند."],[3,"چنان سایه گسترده بر عالمی","که زالی نیندیشد از رستمی","چنان قدرتش بر دنیا سایه افکنده که زال هم از رستم چنین قدرتی ندیده است."],[3,"همه وقت مردم ز جور زمان","بنالند و از گردش آسمان","مردم در تمام اوقات از بدی‌های زمان و دگرگونی‌های آسمان شکایت می‌کنند."],[3,"در ایام عدل تو ای شهریار","ندارد شکایت کس از روزگار","در زمان حکومت تو، ای پادشاه، کسی از روزگار شکایت ندارد و همه در آرامش هستند."],[3,"به عهد تو می‌بینم آرام خلق","پس از تو ندانم سرانجام خلق","در دوران حکومت‌داری تو، آرامش مردم را می‌بینم، اما نمی‌دانم سرنوشت آنها پس از تو چه خواهد شد."],[3,"هم از بخت فرخنده فرجام توست","که تاریخ سعدی در ایام توست","فرجام تو به خاطر خوش‌شانسی و بخت خوب است که سعدی در زمان تو زندگی میکند و آثارش در این دوران قابل توجه است."],[3,"که تا بر فلک ماه و خورشید هست","در این دفترت ذکر جاوید هست","تا زمانی که ماه و خورشید در آسمان وجود دارند (تا دنیا دنیاست)، یاد و نام تو در این دفتر (کتاب بوستان) باقی خواهد ماند."],[3,"ملوک ار نکو نامی اندوختند","ز پیشینگان سیرت آموختند","پادشاهان اگر نام نیکویی از خود به یادگار داشته باشند، آن‌ها را از رفتار و سیرت نیکوی اجداد خود یاد گرفته‌اند."],[3,"تو در سیرت پادشاهی خویش","سبق بردی از پادشاهان پیش","تو در رفتار و شخصیت پادشاهی خود از پادشاهان گذشته جلوتر رفته‌ای."],[3,"سکندر به دیوار رویین و سنگ","بکرد از جهان راه یأجوج تنگ","اسکندر با ساخت دیوار محکم و سنگی، راه یأجوج را از ورود به جهان بست."],[3,"تو را سد یأجوج کفر از زر است","نه رویین چو دیوار اسکندر است","دیواری که تو در برابر دشمنان (مغولان) با تدبیر خود ساختی از طلاست و نه تنها محکم است بلکه محکم‌تر و نفوذناپذیرتر از دیواری است که اسکندر در برابر یاجوج ساخت."],[3,"زبان آوری کاندر این امن و داد","سپاست نگوید زبانش مباد","کسی که در این امن و آرامش و عدالت زندگی می‌کند، اگر به زبان نیاید و شکرگزاری نکند، زبانش نگوید که او شایسته صحبت کردن نیست."],[3,"زهی بحر بخشایش و کان جود","که مستظهرند از وجودت وجود","آفرین بر تو ای دریای بخشندگی و ای معدن بزرگواری که همگان از وجود تو، وجود خود را به دست آورده‌اند و به تو تکیه دارند."],[3,"برون بینم اوصاف شاه از حساب","نگنجد در این تنگ میدان کتاب","دنبال ویژگی‌های شاه هستم، ولی صفات ویژه‌ی شاهنشاه آنقدر زیاد است که هرگز نمی‌توان آنها را در این کتاب محدود گنجاند."],[3,"گر آن جمله را سعدی انشا کند","مگر دفتری دیگر املا کند","معنی این بیت در دنباله‌ی بیت قبل است؛ اگر سعدی بخواهد آن صفات را بنویسد، می‌بایست کتاب دیگری را برای این کار بنویسد (به عبارتی منظور آن است که آنچنان صفات و ویژگی‌های شاه زیاد و فراوان است که در چند صفحه‌ در بوستان جا نمی‌شود و نیاز به کتابت کتاب دیگری دارد)."],[3,"فروماندم از شکر چندین کرم","همان به که دست دعا گسترم","من از وجود این همه بزرگواری و سخاوت شاه شگفت‌زده‌ام و بهتر می‌بینم که دست دعا به سوی خدا بگشایم."],[3,"جهانت به کام و فلک یار باد","جهان آفرینت نگهدار باد","جهان به مراد دلت باشد و شاد باشی و آسمان بر تو رحمت آورده و خالق جهان از تو حمایت کند."],[3,"بلند اخترت عالم افروخته","زوال اختر دشمنت سوخته","ستاره بلند بخت و اقبال تو روشن و جهان همواره با آن روشن باشد و ستاره دشمنت، به زوال و سوختگی دچار شود."],[3,"غم از گردش روزگارت مباد","وز اندیشه بر دل غبارت مباد","خدا نکند که غم به زندگی تو وارد شود و افکار منفی دل تو را آلوده کند."],[3,"که بر خاطر پادشاهان غمی","پریشان کند خاطر عالمی","اگر موضوعی در ذهن پادشاهان نگرانی ایجاد کند، می‌تواند خاطر کل عالم را پریشان کند."],[3,"دل و کشورت جمع و معمور باد","ز ملکت پراکندگی دور باد","خوشبختی و آرامش دل و کشور تو همیشه برقرار باشد و از بی‌ثباتی و ناهمگونی دور باشد."],[3,"تنت باد پیوسته چون دین، درست","بداندیش را دل چو تدبیر، سست","همواره به مانند دینت درست و سالم باشی و افرادی که درباره‌‌ی تو فکر بد دارند به مانند افکارشان ضعیف و مریض باشند."],[3,"درونت به تأیید حق شاد باد","دل و دین و اقلیمت آباد باد","ای کاش درونت به تأیید خدا شاد باشد و دل و ایمان و سرزمینت رونق و آبادانی داشته باشد."],[3,"جهان آفرین بر تو رحمت کناد","دگر هرچه گویم فسانه‌ست و باد","خداوند بر تو رحمت کند، زیرا هر چه در وصف تو بگویم، فقط داستان و بیهوده‌گویی است."],[3,"همینت بس از کردگار مجید","که توفیق خیرت بود بر مزید","موجب شادی و دلگرمی است این که توفیق انجام کارهای نیک از سوی خداوند بزرگ نصیبت شده است."],[3,"نرفت از جهان سعد زنگی به درد","که چون تو خلف نامبردار کرد","سعد زنگی با درد و رنج از دنیا نرفت زیرا پسری همانند تو نامدار به جانشینی خود برگزید."],[3,"عجب نیست این فرع از آن اصل پاک","که جانش بر اوج است و جسمش به خاک","وجود پسری مانند تو از از آن پادشاه بزرگ که در حال حاضر جسمش در خاک و روحش در آسمانهاست اصلا عجیب نیست."],[3,"خدایا بر آن تربت نامدار","به فضلت که باران رحمت ببار","خدایا، آن آرامگاه پاک ان فرد مشهور را به برکتت رحمت‌باران گردان."],[3,"گر از سعد زنگی مثل ماند یاد","فلک یاور سعد بوبکر باد","امیدوارم هچنانکه یاد و خاطره‌‌ی سعد زنگی به جا ماند، دنیا یار و همراه ابوبکر بن سعد باشد تا یاد و خاطره‌ی خوش در جهان از او هم به یادگار بماند"],[4,"اتابک محمد شه نیکبخت","خداوند تاج و خداوند تخت","اتابک محمد، پادشاه خوشبخت و نیکوکار، که خداوند به او تاج (سلطنت) و تخت (حکومت) داده است."],[4,"جوان جوان‌بخت روشن‌ضمیر","به دولت جوان و به تدبیر پیر","جوانی که خوشبخت و با بصیرت است، با داشتن ثروت و با تدبیر بزرگ‌سالان می‌تواند موفق باشد."],[4,"به دانش بزرگ و به همت بلند","به بازو دلیر و به دل هوشمند","دارای دانش فراوان و اراده و پشتکار قوی، و دارای قدرت جسمانی و فکری هوشیار و دلی جوان است."],[4,"زهی دولت مادر روزگار","که رودی چنین پرورد در کنار","چه خوشبختی و چه نعمتی است برای دوران و حکومت، که چنین پسری را در زمانه‌ی خود پرورانده است."],[4,"به دست کرم آب دریا ببرد","به رفعت محل ثریا ببرد","با لطف و بخششی که او دارد آبروی دریا را برد و با جاه و جلال و مقام والایی که دارد ستاره‌ی پروین را از نظرها محو کرد."],[4,"زهی چشم دولت به روی تو باز","سر شهریاران گردن فراز","آفرین بر آن چشمی که به روی تو دلخوش باشد، چرا که تو سرور پادشاهان بلندمرتبه‌ای."],[4,"صدف را که بینی ز دردانه پر","نه آن قدر دارد که یکدانه در","زمانی صدفی را می‌بینی که پر از مروارید است، ولی باید بدانی که در واقع صدفی که درون آن تنها یک دانه مروارید وجود دارد ارزشش بیشتر از تمامی آن مرواریدهاست."],[4,"تو آن در مکنون یکدانه‌ای","که پیرایه سلطنت خانه‌ای","تو همان گوهر پنهان بی‌نظیری هستی که زینت‌بخش کاخ سلطنتی می‌باشی."],[4,"نگه دار یارب به چشم خودش","بپرهیز از آسیب چشم بدش","خدایا، او را با رحمت و لطف خودت از آسیبها دور نگه دار و او را از چشم بد که ممکن است به او آسیب برساند، حفظش کن."],[4,"خدایا در آفاق نامی کنش","به توفیق طاعت گرامی کنش","پروردگارا نام و رسم او را در جهان مشهور و بلندآوازه گردان و از راه کامیابی در فرمانبرداری از اوامر خویش، او را در نزد همه محبوب و محترم کن."],[4,"مقیمش در انصاف و تقوی بدار","مرادش به دنیا و عقبی برآر","خداوندا او را در راه انصاف و پرهیزکاری راهنمایی کن و آرزوهایش را در دنیا و آخرت برآورده کن."],[4,"غم از دشمن ناپسندش مباد","وز اندیشه بر دل گزندش مباد","سعدی در اینجا می‌گوید که برای کسی که از قضاوت و نیکی پرهیز می‌کند، غم و ناراحتی بر اثر دشمنی نباید وجود داشته باشد و همچنین نگرانی و فکری منفی نباید به دل او راه یابد."],[4,"بهشتی درخت آورد چون تو بار","پسر نامجوی و پدر نامدار","تنها یک درخت بهشتی می‌تواند میوه‌ای همچون تو به بار آورد و البته از یک چنین پدر نامدار و بلندآوازه همچون پسری که به دنبال اسم و رسم است دور از ذهن و بعید نیست."],[4,"از آن خاندان خیر بیگانه دان","که باشند بدخواه این خاندان","بدان که افرادی که بدخواه این خانواده هستند، از خیر و نیکی به دور اند."],[4,"زهی دین و دانش، زهی عدل و داد","زهی ملک و دولت که پاینده باد","آفرین به این دین و دانش (بسیار ستودنی)، آفرین به این عدالت و انصاف (تحسین برانگیز)، آفرین به این پادشاهی و حکومتداری که (امیدوارم) همیشه پاینده بماند."],[4,"نگنجد کرمهای حق در قیاس","چه خدمت گزارد زبان سپاس؟","نعمت‌ها و بخشش‌های خداوند را نمی‌توان با هیچ معیاری اندازه‌گیری کرد، زیرا زبان برای تشکر از این خدمات و نعمت‌ها قاصر است."],[4,"خدایا تو این شاه درویش دوست","که آسایش خلق در ظل اوست","خدایا، تو این شاهی را که دوستدار فرودستان است و مردمان جهان در سایه‌ی او در آسایش زندگی می‌کنند را... (دنباله در بیت بعد)"],[4,"بسی بر سر خلق پاینده دار","به توفیق طاعت دلش زنده دار","(ادامه‌ی بیت قبل)؛ بر سر مردم (او و دولتش را به دور از سختیها و مشکلات) بسیار پایدار دار، و از راه کامیابیّ در اطاعت از خداوند، دلش را زنده نگه دار."],[4,"برومند دارش درخت امید","سرش سبز و رویش به رحمت سفید","خدایا، درخت امید (پادشاه ما) را بارور گردان و او را سرسبز و شاداب و با بخشایش خودت روسفید و سربلند گردان."],[4,"به راه تکلف مرو سعدیا","اگر صدق داری بیار و بیا","ای سعدی، اگر راست می‌گویی به راه تظاهر نرو و خودت را بزحمت نیانداز، ساده و بی‌پرده بیا و خودت را نشان بده."],[4,"تو منزل شناسی و شه راهرو","تو حقگوی و خسرو حقایق شنو","تو کسی هستی که مقصد و راه حقیقت را خوب می‌شناسی (و می‌توانی به درستی آگاهی بدهی) و پادشاه سالک و رونده‌ی این مسیر است. تو کسی هستی که حرف حق و راست میزنی و پادشاه کسی است که حرف حق را به خوبی گوش می‌شنود."],[4,"چه حاجت که نه کرسی آسمان","نهی زیر پای قزل ارسلان","چه نیازی است که نه فلک آسمان را زیر پای قزل‌ارسلان بگذاری؟"],[4,"مگو پای عزت بر افلاک نه","بگو روی اخلاص بر خاک نه","به ممدوح خود نگو که از روی بزرگی پا بر آسمان بگذار بلکه به او بگو با خلوص دل به درگاه خداوند متعال سجده کن."],[4,"بطاعت بنه چهره بر آستان","که این است سر جاده راستان","برو و با نهایت احترام و فروتنی، چهره‌ات را بر درگاه حق بگذار و بر او سجده کن، زیرا این سرآغاز راهی است که راه درست را به تو نشان خواهد داد."],[4,"اگر بنده‌ای سر بر این در بنه","کلاه خداوندی از سر بنه","اگر کسی در مقابل خداوند سر به خاک نهد و خضوع کند، می‌بایست تاج شاهی را از سر بردارد و فروتنی پیشه کند."],[4,"به درگاه فرمانده ذوالجلال","چو درویش پیش توانگر بنال","برای بزرگ‌ترین فرمانده با شکوه، چون درویشی در برابر ثروتمند، درخواست کمک کن و زار زار از او طلب آمرزش کن."],[4,"چو طاعت کنی لبس شاهی مپوش","چو درویش مخلص برآور خروش","هرگاه از خداوند فرمانبرداری کنی، مانند پادشاه رفتار نکن. مانند یک درویش ساده و پاک فریاد بزن."],[4,"که پروردگارا توانگر تویی","توانا و درویش پرور تویی","ای پروردگار، تو خود سرشار از توانگری و نیرومندی هستی و به فرودستان نیز لطف و عنایت عطا می‌کنی."],[4,"نه کشور خدایم نه فرماندهم","یکی از گدایان این درگهم","من نه پادشاه هستم، نه فرمانده‌ی سپاه، من یکی از گدایان این درگاه حق هستم."],[4,"تو بر خیر و نیکی دهم دسترس","وگر نه چه خیر آید از من به کس؟","خدایا تنها با کمک و یاری توست که من میتوانم به دیگران کمک کنم درغیراینصورت هیچ لطف و کاری از من به تنهایی ساخته نیست."],[4,"دعا کن به شب چون گدایان به سوز","اگر می‌کنی پادشاهی به روز","اگر در روز پادشاهی می‌کنی ، در شب، همچون گدایان با دل سوخته دعا کن."],[4,"کمر بسته گردن کشان بر درت","تو بر آستان عبادت سرت","افراد و سربازان قوی بر دروازه‌ی کاخت در حال خدمتگزاری تو هستند ولی تو بر درگاه خداوند در حال عبادت و سجده هستی."],[4,"زهی بندگان را خداوندگار","خداوند را بنده حق گزار","خوشا به حال تو که پادشاه مردمان جهان هستی و در عین حال خودت بنده‌ی شکرگژار پروردگار جهانیان می‌باشی."],[5,"حکایت کنند از بزرگان دین","حقیقت شناسان عین الیقین","بزرگان دین و همان افرادی که حقیقت جهان را با عین الیقین جستجو می‌کنند، یک داستانی را تعریف میکنند."],[5,"که صاحبدلی بر پلنگی نشست","همی راند رهوار و ماری به دست","یک شخص پارسا و پرهیزکار بر روی پلنگی نشسته بود و با سرعت او را هدایت می‌کرد، در حالی که ماری در دست داشت."],[5,"یکی گفتش: ای مرد راه خدای","بدین ره که رفتی مرا ره نمای","یکی به مرد گفت: ای مردی که در مسیر الهی قرار داری، راهی را که رفته‌ای، به من نشان بده."],[5,"چه کردی که درنده رام تو شد","نگین سعادت به نام تو شد؟","چه کار کرده‌ای که حتی درندگان نیز به تو آرامش یافته‌اند و رام تو شده‌اند و انگشتری نیکبختی در اختیار تو قرار گرفت."],[5,"بگفت ار پلنگم زبون است و مار","وگر پیل و کرکس، شگفتی مدار","پلنگ و مار و فیل و کرکس همگی در برابر من خوار و زبون هستند و تو نباید از این موضوع شگفت‌زده شوی."],[5,"تو هم گردن از حکم داور مپیچ","که گردن نپیچد ز حکم تو هیچ","تو هم هیچگاه از حکم خداوند سرپیچی نکن، تا آنزمان هیچ‌کس از دستورات تو هم سرپیچی نخواهد کرد."],[5,"چو حاکم به فرمان داور بود","خدایش نگهبان و یاور بود","هنگامی که حکمران بر اساس قوانین الهی و عدالت عمل کند، خداوند نیز او را پشتیبان و نگهبان خواهد بود."],[5,"محال است چون دوست دارد تو را","که در دست دشمن گذارد تو را","اگر خداوند تو را دوست داشته باشد، غیر ممکن است که تو را به دست دشمنان بسپارد."],[5,"ره این است، روی از طریقت متاب","بنه گام و کامی که داری بیاب","این راه، همان راه درست و حقیقی است؛ از آن منحرف نشو و داشته‌ها و موفقیت‌هایت را در این مسیر جستجو کن."],[5,"نصیحت کسی سودمند آیدش","که گفتار سعدی پسند آیدش","نصیحت و پند برای کسی مفید است که از سخنان سعدی خوشش بیاید و آن‌ها را بپسندد."],[6,"شنیدم که در وقت نزع روان","به هرمز چنین گفت نوشیروان","شنیدم که انوشیروان به هنگام مرگ، با هرمز اینگونه سخن گفت."],[6,"که خاطر‌نگهدار درویش باش","نه در بند آسایش خویش باش","باید به فکر دیگران، به ویژه درویشان و نیازمندان باشی و نه فقط به فکر آسایش خودت."],[6,"نیاساید اندر دیار تو کس","چو آسایش خویش جویی و بس","اگر تنها به فکر آرامش و آسایش خود باشی، هیچ‌کس در سرزمینت آرامش نمی‌یابد."],[6,"نیاید به نزدیک دانا پسند","شبان خفته و گرگ درد گوسفند","انسان دانا نمی پسندد که چوپان خوابیده و گرگ گوسپندان را بدرد و پاره کند"],[6,"برو پاس درویش محتاج دار","که شاه از رعیّت بود تاجدار","برو و مراقب درویش نیازمند باش، زیرا شاه از رعیت خود تاج به سر دارد."],[6,"رعیّت چو بیخند و سلطان درخت","درخت، ای پسر، باشد از بیخ سخت","فرمانروا مانند درختی‌ست که مردم ریشه آن هستند. ای پسر، استحکام درخت از ریشه‌اش است."],[6,"مکن تا توانی دل خلق ریش","وگر می‌کنی می‌کنی بیخ خویش","تا می‌توانی مردم را نیازار، چرا که با این کار، ریشه حکومت خویش را از جا می‌کنی."],[6,"اگر جاده‌ای بایدت مستقیم","ره پارسایان امید است و بیم","باید راه درست و راست را پیش بگیری و آن راه این است که به خدا امیدوار باشی و از تنبیه و کیفر او بترسی."],[6,"طبیعت شود مرد را بخردی","به امّید نیکی و بیم بدی","با امید به خوبی و ترس از بدی، خردمندی در فطرت و سرشت انسان راه می‌یابد."],[6,"گر این هر دو در پادشه یافتی","در اقلیم و ملکش بنه یافتی","آن‌گاه که این دو خصلت (امید و بیم) را در پادشاهی ببینی، سرزمین وی می‌تواند محل امن تو باشد و در آن‌جا می‌توانی با آرامش زندگی کنی."],[6,"که بخشایش آرد بر امّیدوار","به امّید بخشایش کردگار","زیرا که پادشاه آن سرزمین به امید بخشوده‌شدن توسط خدا، از گناه رعیت امیدوار به عفو پادشاهشان می‌گذرد."],[6,"گزند کسانش نیاید پسند","که ترسد که در ملکش آید گزند","او آزار و آسیب به مردم را نمی‌پسندد، چرا که از آسیب به کشور و مملکتش می‌ترسد."],[6,"وگر در سرشت وی این خوی نیست","در آن کشور آسودگی‌بوی نیست","و اگر در ذات او این ویژگی (خداترسی و پاسداری مردم) نباشد، در سرزمینش هیچ نشانی از آرامش و آسایش نخواهد بود."],[6,"اگر پای‌بندی رضا پیش گیر","وگر یک‌سواری سر خویش گیر","اگر در آن کشور پای‌بندی و ناگزیر به اقامت در آن‌جا هستی، به هرچه هست راضی باش و اگر مجرد و تنهایی، آن‌جا را ترک و به سرزمین دیگر کوچ کن و برو."],[6,"فراخی در آن مرز و کشور مخواه","که دلتنگ بینی رعیّت ز شاه","در آن سرزمین که مردم از پادشاه آزرده‌اند، به دنبال وسعت رزق و خوشی نگرد، چون نخواهی دید."],[6,"ز مستکبران دلاور بترس","از آن کاو نترسد ز داور بترس","از گردنکشان دلیر و بی‌باک (از فرمان خدا) بترس، همان‌هایی که از خدا هم نمی‌ترسند."],[6,"دگر کشور آباد بیند به خواب","که دارد دل اهل کشور خراب","پادشاهی که دل رعیت را پریشان و آزرده سازد، جز در خواب و رویا، کشورش را آباد نخواهد دید."],[6,"خرابی و بدنامی آید ز جور","رسد پیش‌بین این سخن را به غور","از ظلم و ستم، ویرانی کشور و بدنامی شاه حاصل می‌شود. شخص عاقبت‌اندیش در این سخن تأمل می‌کند."],[6,"رعیّت نشاید به بیداد کشت","که مر سلطنت را پناهند و پشت","کشتن رعیت به ستم، شایسته نیست؛ زیرا آن‌ها اساس و پشتیبان سلطنت هستند."],[6,"مراعات دهقان کن از بهر خویش","که مزدور خوش‌دل کند کار بیش","به خاطر خودت به کشاورز و روستایی احترام بگذار؛ زیرا کارگر مزدبگیر دل‌شاد، در کار تلاش بیشتری خواهد کرد."],[6,"مروّت نباشد بدی با کسی","کز او نیکویی دیده باشی بسی","انصاف نیست با آن که از او خوبی بسیار دیده‌ای، بدی کنی."],[6,"شنیدم که خسرو به شیرویه گفت","در آن دم که چشمش ز دیدن بخفت","شنیدم که خسرو پرویز به هنگام مرگ به فرزندش شیرویه گفت…"],[6,"بر آن باش تا هرچه نیّت کنی","نظر در صلاح رعیّت کنی","بکوش همیشه در تصمیم‌هایت به خیر و صلاح مردم توجه داشته باشی."],[6,"الا تا نپیچی سر از عدل و رای","که مردم ز دستت نپیچند پای","آگاه باش و دریاب که از عدالت و دادگری رو نتابی تا مردم از کشور تو به سرزمین دیگر کوچ نکنند."],[6,"گریزد رعیّت ز بیدادگر","کند نام زشتش به گیتی سمر","رعیت از ستمگر می‌گریزند و نام او را به بدی و زشتی مشهور می‌کنند."],[6,"بسی بر‌نیاید که بنیاد خود","بکند آن که بنهاد بنیاد بد","دیری نمی‌پاید که آن‌کس که بنیاد زشت‌کاری را می‌گذارد، اساس خود را نابود کند."],[6,"خرابی کند مرد شمشیر‌زن","نه چندان که دود دل طفل و زن","جنگ و شمشیرکشی سپاه، آسیب و زیان می‌رساند؛ اما زاری دل کودک و زن بیش از آن در اساس مملکت ویرانی می‌آورد."],[6,"چراغی که بیوه‌زنی برفروخت","بسی دیده باشی که شهری بسوخت","همانا بسیار دیده‌ای چراغ آه و ناله دل زنی بیوه، چگونه کشوری را آتش می‌زند."],[6,"از آن بهره‌ورتر در آفاق کیست","که در ملکرانی به انصاف زیست","هیچ‌کس از پادشاهی که در میان مردم به انصاف زندگی می‌کند، کامیاب‌تر نیست."],[6,"چو نوبت رسد زین جهان غربتش","ترحّم فرستند بر تربتش","زمانی که مرگ آن فرمانروا فرا می‌رسد، مردم از خداوند برای او طلب آمرزش و رحمت خواهند کرد."],[6,"بد و نیک مردم چو می‌بگذرند","همان به که نامت به نیکی برند","چون تمام انسان‌ها – خوب و بد – خواهند مرد، بهتر آن است که نام تو به نیکی و خوبی مشهور گردد."],[6,"خداترس را بر رعیّت گمار","که معمار ملک است پرهیزگار","رئیس و حاکم باید کسی باشد که از خدا بترسد و به مردم احترام بگذارد، زیرا او مانند معمار است که باید در ساختن و اداره کردن مملکت احتیاط کند و از گناه دوری نماید."],[6,"بد‌اندیش توست آن و خون‌خوار خلق","که نفع تو جوید در آزار خلق","شخصی که به فکر تلمید منافع تو ولو به قیمت آزار مردم است، بدخواه تو و آزارگر خلق است."],[6,"ریاست به دست کسانی خطاست","که از دستشان دست‌ها بر خداست","سپردن ریاست به کسانی خطاست که از دست ریاست آنها مردم به خدا شکایت میکنند"],[6,"نکوکارپرور نبیند بدی","چو بد پروری خصم خون خودی","انسان نیکوکار هرگز بدی را نمی‌بیند، مانند اینکه دشمنی که بدی کرده، همچون کسی است که به آخر و ریشه خود آسیب می‌زند."],[6,"مکافات موذی به مالش مکن","که بیخش برآورد باید ز بن","مجازات کسی که به دیگران آسیب می‌زند را با مال او متوقف نکن، زیرا ریشه‌اش باید از بیخ قطع شود."],[6,"مکن صبر بر عامل ظلم‌دوست","که از فربهی بایدش کند پوست","به ظلم و ستمی که از سوی کسی که به ظلم علاقه دارد تحمل نکن، زیرا او به قدری قوی و فربه شده که باید از ریشه از بین برود."],[6,"سر گرگ باید هم اوّل برید","نه چون گوسفندان مردم درید","برای مقابله با ظلم و حیله‌گری، باید در ابتدا سر آن را از بین برد و بی‌رحمانه عمل کرد، نه اینکه مانند گوسفندانی که بی‌دفاع هستند، به سادگی بگذاریم آسیب ببینیم."],[6,"چه خوش گفت بازارگانی اسیر","چو گردش گرفتند دزدان به تیر","یک بازرگان اسیر به زیبایی گفت که وقتی دزدان او را محاصره کردند و با تیر احاطه‌اش کردند، چه وضعیتی دارد."],[6,"چو مردانگی آید از رهزنان","چه مردان لشکر، چه خیل زنان","وقتی که دزدان به گندم‌کاران و نیکوکاران حمله می‌کنند، آن مردان لشکری که قوی و جنگجو هستند و همچنین زنان، چگونه می‌توانند مردانگی و شجاعت نشان دهند؟"],[6,"شهنشه که بازارگان را بخست","در خیر بر شهر و لشکر ببست","شاه بزرگ که بازرگانان را به نیکی بخشید، در خیر و سعادت بر شهر و سپاه ارتباط برقرار کرد."],[6,"کی آن‌جا دگر هوشمندان روند","چو آوازه رسم بد بشنوند؟","کیست که در آن‌جا، وقتی خبر بدی بشنوند، هوشمندان و دانایان به آن‌جا بروند؟"],[6,"نکو بایدت نام و نیکی قبول","نکو دار بازارگان و رسول","برای تو که به دنبال نام نیک و خوبی هستی، لازم است که نام نیکو و خوبی را بپذیری و در این راه، مانند یک بازرگان و فرستاده، آن را در بازار و میان مردم پخش کنی."],[6,"بزرگان مسافر به جان پرورند","که نام نکویی به عالم برند","بزرگان یا افراد برجسته در سفر و مسافرت به دل و جان خود توجه می‌کنند و تلاش می‌کنند که نام نیکی از خود به جا بگذارند."],[6,"تبه گردد آن مملکت عن‌قریب","کز او خاطر‌آزرده آید غریب","کشوری که غریبان در آن دل‌آزار شوند و از آنجا ناراضی بروند، به زودی به نابودی می‌رسد."],[6,"غریب‌آشنا باش و سیّاح‌دوست","که سیّاح جلّاب نام نکوست","باید با مسافران و غریبان خوب و دوستانه رفتار کرد، زیرا مسافران انسان‌های باارزشی هستند و باید نسبت به آن‌ها مهربانی و احترام نشان داد."],[6,"نکو دار ضیف و مسافر عزیز","وز آسیبشان بر حذر باش نیز","باید مهمان و مسافر را عزیز و محترم بشماری و همواره از آسیب رساندن به آنها دوری کنی."],[6,"ز بیگانه پرهیز کردن نکوست","که دشمن توان بود در زیّ دوست","پرهیز از بیگانگان کار خوبی است، زیرا ممکن است دشمنی در قالب دوست ظاهر شود."],[6,"غریبی که پر فتنه باشد سرش","میازار و بیرون کن از کشورش","اگر فردی بیگانه و ایجادکننده‌ی فتنه‌ای وجود دارد، او را آزار نده و بهتر است او را از سرزمینت دور کنی."],[6,"تو گر خشم بر وی نگیری رواست","که خود خوی بد دشمنش در قفاست","اگر بر آن غریبه خشم بگیری، درست است که خود او نیز صفات بدش را در قفسه قلبش دارد و در حقیقت، دشمن خودش است."],[6,"وگر پارسی باشدش زاد و بوم","به صنعاش مفرست و سقلاب و روم","اگر او ایرانی باشد و در سرزمین خودش به دنیا آمده باشد، به خاطر کارهایش او را به سرزمین‌های سلاف (یعنی سرزمین‌های باستانی) و روم بفرستید."],[6,"هم آن‌جا امانش مده تا به چاشت","نشاید بلا بر دگر کس گماشت","در آنجا به او پناه نده تا صبح شود و نتواند آسیب و مصیبت را به دیگران منتقل کند."],[6,"که گویند برگشته باد آن زمین","کز او مردم آیند بیرون چنین","می‌گویند که باد آن سرزمین برمی‌گردد، جایی که مردم از آنجا به این نحو خارج می‌شوند."],[6,"قدیمان خود را بیفزای قدر","که هرگز نیاید ز پرورده غدر","قدیم‌ها (پیشینیان) به رشد و افزایش خود و ارزش خود توجه داشته‌اند، چرا که هرگز نتیجه‌ی بد و خیانت از تربیت‌شده‌ها (افراد نادرست) به دست نمی‌آید."],[6,"چو خدمتگزاریت گردد کهن","حق سالیانش فرامش مکن","هرگاه خدمت گزاری تو قدیمی و کهنه شود، حق او را فراموش نکن و به خاطر سال‌ها خدمتش قدردانی کن."],[6,"گر او را هرم دست خدمت ببست","تو را بر کرم همچنان دست هست","اگر سالخوردگی خدمت خدمتگزار قدیمی را مانع گردید تو در عوض کرم و بخشندگی خود را در حق او ادامه بده"],[6,"شنیدم که شاپور دم در‌کشید","چو خسرو به رسمش قلم در‌کشید","شنیدم که وقتی خسرو مقرری و مواجب شاپور را قطع کرد، شاپور سکوت اختیار کرد و هیچ نگفت."],[6,"چو شد حالش از بی‌نوایی تباه","نبشت این حکایت به نزدیک شاه","چون حال او به خاطر فقر و ناداری ویران شد، این داستان را نزد شاه نوشت."],[6,"چو بذل تو کردم جوانی خویش","به هنگام پیری مرانم ز پیش","وقتی که جوانی‌ام را در خدمت تو خرج کردم، در هنگام پیری مرا از خود دور نکن."],[6,"عمل گر دهی مرد منعم شناس","که مفلس ندارد ز سلطان هراس","کار و خدمت را به مرد صاحب مال واگذار کن چون فرد بی‌چیز از سلطان ترس و واهمه ندارد."],[6,"چو مفلس فرو‌برد گردن به دوش","از او بر‌نیاید دگر جز خروش","وقتی که فرد فقیر و بیچاره بار سنگینی را بر دوش می‌کشد، دیگر از او هیچ کاری برنمی‌آید و فقط صدای ناله و زاری او به گوش می‌رسد."],[6,"چو مشرف دو دست از امانت بداشت","بباید بر او ناظری بر گماشت","اگر کسی که مسئولیت امانت را دارد، از این مسئولیت سرپیچی کند، باید ناظری بر او بگمارند تا کار او را زیر نظر داشته باشد."],[6,"ور او نیز در‌ساخت با خاطرش","ز مشرف عمل بر‌کن و ناظرش","و اگر او هم راه خطا رفت هر دو را مرخص کن"],[6,"خدا‌ترس باید امانت‌گزار","امین کز تو ترسد امینش مدار","امانت‌گزار ( امانت‌دار) باید از خدا بترسد نه از امانت‌گذار، اگر از خدا نترسد او را امین مپندار"],[6,"امین باید از داور اندیشناک","نه از رفع دیوان و زجر و هلاک","امینی که باید به او اعتماد کرد، باید از قضاوت و داوری و عواقب آن نگران باشد، نه اینکه فقط به فکر حل و فصل امور و عذاب و نابودی دیگران باشد."],[6,"بیفشان و بشمار و فارغ نشین","که از صد یکی را نبینی امین","خودت را راحت کن و بی‌دغدغه زندگی کن، زیرا از میان صد نفر، تنها یکی را ممکن است امین پیدا کنی."],[6,"دو همجنس دیرینه را هم‌قلم","نباید فرستاد یک جا به هم","دو نفر که هم‌نوع و هم‌جنس هستند و سابقه دوستی یا روابط نزدیکی دارند، نباید برای کار یا فعالیتی به یک جا بفرستاد زیرا ممکن است به هم دلسوزی کنند و در انجام کار درست قصور داشته باشند."],[6,"چه دانی که همدست گردند و یار","یکی دزد باشد، یکی پرده‌دار","تو نمی‌دانی که ممکن است در کنار هم، دو نفر با هدف‌های متفاوت و ناپاک سر و کار داشته باشند؛ یکی دزد است و دیگری کسی است که نقش پنهان‌کننده‌ای دارد."],[6,"چو دزدان ز هم باک دارند و بیم","رود در میان کاروانی سلیم","وقتی دزدان از یکدیگر نگران و ترسان هستند، در میان یک کاروان بی‌خطر، آرامش و ایمنی به وجود می‌آید."],[6,"یکی را که معزول کردی ز جاه","چو چندی برآید ببخشش گناه","اگر کسی را از مقام و جایگاهش برکنار کنی، پس از مدتی، او را به خاطر گناهانش می‌بخشند."],[6,"بر‌آوردن کام امّیدوار","به از قید بندی شکستن هزار","بهتر است آرزوهای امیدواری را برآورده کنیم تا اینکه هزار بار، بند و زنجیر را بشکنیم."],[6,"نویسنده را گر ستون عمل","بیفتد، نبرّد طناب امل","اگر پایه و اساس کار نویسنده فرو بریزد، او را نباید از امید و آرزو قطع کرد."],[6,"به فرمانبران بر شه دادگر","پدروار خشم آورد بر پسر","پادشاهانی که عادل و بخشنده‌اند، مانند پدرانی هستند که اگر فرزندانشان را به خطا ببیند، به آنان خشمگین می‌شوند."],[6,"گهش می‌زند تا شود دردناک","گهی می‌کند آبش از دیده پاک","گاه فرزند را به شدت تنبیه می‌کند تا درسی بیاموزد و گاهی با محبت و بخشش، اشک‌هایش را می‌زداید."],[6,"چو نرمی کنی خصم گردد دلیر","وگر خشم گیری شوند از تو سیر","اگر با ملایمت و نرمش رفتار کنی، دشمنان جرات پیدا می‌کنند و دلیر می‌شوند، ولی اگر خشمگین و تندخو باشی، از تو دور می‌شوند و از تو سیر می‌گردند."],[6,"درشتی و نرمی به هم در به است","چو رگ‌زن که جرّاح و مرهم‌نه است","برای برقراری توازن در رفتار، نرمی و درشتی باید به اندازه و به‌جا باشد، مانند پزشک که هم چاقو به‌دست دارد و هم قابلیت درمان."],[6,"جوان‌مرد و خوش‌خوی و بخشنده باش","چو حق بر تو پاشد تو بر خلق پاش","باید مردی نیکو و خوش‌خلق و بخشنده باشی، زیرا همان‌طور که حق و نعمت بر تو نازل می‌شود، تو نیز باید این نعمت‌ها را به مردم برسانی."],[6,"نیامد کس اندر جهان کاو بماند","مگر آن کز او نام نیکو بماند","هیچ‌کس در این دنیا نیست که برای همیشه زنده بماند، جز کسانی که نام نیکشان بعد از آنان باقی بماند."],[6,"نمرد آن که ماند پس از وی به جای","پل و خانی و خان و مهمان‌سرای","کسی نمی‌میرد که بعد از او یاد و نامش باقی بماند، مانند پل یا مسافرخانه که برای دیگران کارآمد است و یاد او را زنده نگه می‌دارد."],[6,"هر آن کاو نماند از پسش یادگار","درخت وجودش نیاورد بار","هر کسی که پس از مرگش اثری از او باقی نماند، در حقیقت مانند درختی است که ثمره‌ای برای زندگی دیگران نیاورده است."],[6,"وگر رفت و آثار خیرش نماند","نشاید پس مرگش الحمد خواند","اگر کسی از دنیا برود و اثری از خوبی‌های او باقی نماند، نمی‌توان پس از مرگ او را ستایش و شکر گفت."],[6,"چو خواهی که نامت بود جاودان","مکن نام نیک بزرگان نهان","اگر می‌خواهی نامت همیشه باقی بماند، پس نام نیک بزرگان را پنهان نکن و از آن‌ها یاد کن."],[6,"همین نقش بر‌خوان پس از عهد خویش","که دیدی پس از عهد شاهان پیش","احوال دوران پس از خودت را همان‌گونه ببین که احوال دوران پس از شاهان قبل را دیدی."],[6,"همین کام و ناز و طرب داشتند","به آخر برفتند و بگذاشتند","همین لذت‌ها و خوشی‌ها و شادی‌ها را داشتند و در نهایت از دنیا رفتند و آن‌ها را ترک کردند."],[6,"یکی نام نیکو ببرد از جهان","یکی رسم بد ماند از او جاودان","یک نفر با داشتن نام نیکو از دنیا می‌رود، اما یک رسم بد از او باقی می‌ماند که برای همیشه ماندگار خواهد بود."],[6,"به سمع رضا مشنو ایذای کس","وگر گفته آید به غورش برس","به حرف دیگران گوش نده و تحت تأثیر سخنان آن‌ها قرار نگیر، زیرا اگر کسی چیزی بگوید، به عمق آن پی ببر و خودت فکر کن."],[6,"گنهکار را عذر نسیان بنه","چو زنهار خواهند زنهار ده","اگر گنهکاری که فراموش کرده است، عذری بخواهد و به پناه متوسل شود، باید او را بخشید و حفاظت کرد."],[6,"گر آید گنهکاری اندر پناه","نه شرط است کشتن به اوّل گناه","اگر گنهکاری به پناهگاه بیاید، نباید به خاطر اولین خطایش او را بکشیم."],[6,"چو باری بگفتند و نشنید پند","بده گوشمالش به زندان و بند","اگر کسی نیاید و پند را نشنود، باید او را به زندان و زنجیر بکشانند تا درسی عبرت‌آموز ببیند."],[6,"وگر پند و بندش نیاید بکار","درختی خبیث است بیخش برآر","اگر پند و تنبیه او مؤثر واقع نشود، او مثل درختی بد و بی‌فایده است که باید ریشه‌اش را برکنیم."],[6,"چو خشم آیدت بر گناه کسی","تأمل کنش در عقوبت بسی","وقتی بر گناه کسی خشمگین می‌شوی، خوب فکر کن و درباره‌ی عواقب آن زیاد تأمل کن."],[6,"که سهل است لعل بدخشان شکست","شکسته نشاید دگرباره بست","اگر سنگ قیمتی مانند لعل بدخشان شکسته شود، ترمیم آن کار دشواری است و دیگر نمی‌توان به راحتی آن را به حالت اول بازگرداند."],[7,"ز دریای عمان برآمد کسی","سفر کرده هامون و دریا بسی","از طرف دریای عمان شخصی آمد که سفرهای دریایی و خشکی زیادی داشت (دنیا دیده بود)"],[7,"عرب دیده و ترک و تاجیک و روم","ز هر جنس در نفس پاکش علوم","تمام اقوام ترک و عرب و تاجیک و رومی را دیده بود و دانش‌ گوناگون از آنان در نهاد پاکش وجود داشت."],[7,"جهان گشته و دانش اندوخته","سفر کرده و صحبت آموخته","جهان دگرگون شده و انسان‌ها علم و دانش فراوان کسب کرده‌اند و همچنین در سفرهای خود تجربیات و گفتگوهای زیادی به دست آورده‌اند."],[7,"به هیکل قوی چون تناور درخت","ولیکن فرو مانده بی برگ سخت","دارای اندامی ستبر و بزرگ بود ولی از مال دنیا، بی برگ و نوا بود (فقیربود)"],[7,"دو صد رقعه بالای هم دوخته","ز حراق و او در میان سوخته","لباسش را انقدر روی هم وصله زده بود که لباس بسیار کلفت شده که وقتی این مسافر را داخل لباس آن طور سياه سوخته می‌بینید، تصور می‌کنید از حرارت زیاد این لباس آن وسط سوخته است.(سیاهی چهره مسافر به دلیل حمام نکردن طولانی بوده که در اییات بعد به حمام رفتن و شستن وی اشاره شده)"],[7,"به شهری در آمد ز دریا کنار","بزرگی در آن ناحیت شهریار","شخصی از دریا به شهری وارد شد که در آن ناحیه، پادشاه بزرگی اداره آن شهر را بر عهده داشت."],[7,"که طبعی نکونامی اندیش داشت","سر عجز در پای درویش داشت","کسی که به خوبی فکر می‌کرد و فکرهای نیکو می‌پروراند و در برابر درویش و نیازمند فروتنانه رفتار می‌کرد."],[7,"بشستند خدمتگزاران شاه","سر و تن به حمامش از گرد راه","خدمتکاران شاه ، مسافر را به حمام برده و سر و تنش را شستند"],[7,"چو بر آستان ملک سر نهاد","نیایش کنان دست بر بر نهاد","هنگامی که بر آستانه (درگاه) ملکوت/پادشاهی سر نهاد (تعظیم کرد)، در حالی که نیایش می‌کرد، دست بر سینه نهاد (به نشانه احترام و بندگی)"],[7,"درآمد به ایوان شاهنشهی","که بختت جوان باد و دولت رهی","به ایوان پادشاهی وارد شدم که امیدوارم بخت تو جوان و شکوفا باشد و زندگی‌ات پر از نعمت و خوشبختی گردد."],[7,"نرفتم در این مملکت منزلی","کز آسیب آزرده دیدم دلی","در این کشور به جایی نرفته‌ام که دل کسی را از بدی‌هایی که دیده آزرده کرده باشد."],[7,"ندیدم کسی سرگران از شراب","مگر هم خرابات دیدم خراب","نکته جالب این است که من کسی را ندیده‌ام که از شراب غمگین باشد، مگر اینکه در خرابات (محل آبادانی و خوش‌گذرانی) و در اثر میگساری دچار خرابی و نقصان شده باشد."],[7,"ملک را همین ملک پیرایه بس","که راضی نگردد به آزار کس","این بیت بیان می‌کند که برای یک پادشاه (ملک)، همین که آبادانی و تزئینات ملکش باشد کافی است، چرا که او نباید به آزار کسی راضی باشد."],[7,"سخن گفت و دامان گوهر فشاند","به نطقی که شه آستین برفشاند","او (چون به شایستگی سخن گفت) در حین صحبت، دامن خود را از گوهر (به نشانه احترام و محبت) پر کرد و سپس با سخنانش، آنقدر تاثیرگذار بود که شاه آستین خود را (برای نشان دادن احترام) بالا زد."],[7,"پسند آمدش حسن گفتار مرد","به نزد خودش خواند و اکرام کرد","به خاطر خوب بودن و زیبایی سخنان آن مرد، او را نزدیک خود فراخواند و با احترام پذیرایی کرد."],[7,"زرش داد و گوهر به شکر قدوم","بپرسیدش از گوهر و زاد و بوم","او (مردی که مورد احترام قرار گرفته است) به خاطر خوش‌صحبتی و آمدن مهمان، به او هدیه‌هایی از طلا و جواهر تقدیم کرد و از او درباره اصل و نسب و محل زندگی‌اش سوال کرد."],[7,"بگفت آنچه پرسیدش از سرگذشت","به قربت ز دیگر کسان بر گذشت","او (شخص مورد نظر) به پرسش‌های او درباره سوابق و گذشته‌اش پاسخ داد و در صحبت‌هایش از دیگران و روابطش با آن‌ها گذشت و اشاره‌ای نکرد."],[7,"ملک با دل خویش با گفت و گو","که دست وزارت سپارد بدو","ملک (سلطان) با دل خودش مشورت می‌کند که مسئولیت وزارت را به او (شخصی) بسپارد."],[7,"ولیکن بتدریج تا انجمن","به سستی نخندند بر رای من","اما به آرامی و به تدریج، تا زمانی که گروه به ضعف و سستی بخندند، نباید به نظری که دارم، اعتماد کنم."],[7,"به عقلش بباید نخست آزمود","به قدر هنر پایگاهش فزود","برای سنجش و ارزیابی عقل او، باید ابتدا آن را آزمایش کرد تا بر اساس توانایی و استعدادش، جایگاهش افزایش یابد."],[7,"برد بر دل از جور غم بارها","که نا آزموده کند کارها","غم و اندوهی که به دل می‌آید، بر اثر بی‌عدالتی و ظلم است و کسی که تازه در کارها تجربه‌ای ندارد، این اندوه را متحمل خواهد شد."],[7,"چو قاضی به فکرت نویسد سجل","نگردد ز دستاربندان خجل","هر کس باید در فکر و نظر خود دقیق و عمیق باشد، به‌ویژه اگر در مقام قضاوت قرار دارد؛ در این صورت، قاضی نباید از مأموری که مهمانی می‌کند یا کسانی که سرش را پوشانده‌اند (دستاربندها، یعنی روحانیون یا افراد معتبر) خجالت بکشد."],[7,"نظر کن چو سوفار داری به شست","نه آنگه که پرتاب کردی ز دست","به چیزی که در دست داری دقت کن، مانند سوفار (نوعی سبد) که آن را در آب می‌شویند و قبل از اینکه آن را پرتاب کنی، باید مطمئن شوی که آماده است."],[7,"چو یوسف کسی در صلاح و تمیز","به یک سال باید که گردد عزیز","مثل یوسف، که در کارها و شایستگی‌ها مبرّز و برجسته است، برای رسیدن به مقام‌ و عزت، به یک سال زمان نیاز دارد تا شناخته شود."],[7,"به ایام تا بر نیاید بسی","نشاید رسیدن به غور کسی","برای آنکه کسی به عمق مسائل و حکمت‌ها برسد، باید زمان زیادی بگذرد و عجله در این کار نکنید."],[7,"ز هر نوع اخلاق او کشف کرد","خردمند و پاکیزه دین بود مرد","خردمند و دین‌دار توانست از هر نوع اخلاق او به خوبی آگاهی پیدا کند و حقیقت شخصیت او را بشناسد."],[7,"نکو سیرتش دید و روشن قیاس","سخن سنج و مقدار مردم شناس","سیرت خوب او و درک روشنی که از کلام داشته را مشاهده کرد و به تبحر و شناخت او از مردم پی برد."],[7,"به رای از بزرگان مهش دید و بیش","نشاندش زبردست دستور خویش","با مشورت و نظرخواهی از بزرگ‌ترها، او (حاکم یا فرمانروا) را به مقام و جایگاه بالاتری منصوب کرد و به دستور خود به او اهمیت بیشتری داد."],[7,"چنان حکمت و معرفت کار بست","که از امر و نهیش درونی نخست","او به قدری از حکمت و دانش بهره‌مند بود که در کارها، ابتدا به درون خود توجه می‌کرد و بر اساس آن تصمیم می‌گرفت."],[7,"در آورد ملکی به زیر قلم","کز او بر وجودی نیامد الم","کارنامه‌ای از یک کشور یا سرزمین نوشته شد که از آن وضعیت نابسامانی یا نقصی به وجود نیامده است."],[7,"زبان همه حرف گیران ببست","که حرفی بدش بر نیامد ز دست","زبان همه افرادی که سخن می‌زنند را بسته‌اند، زیرا هیچ سخن زشتی از آن‌ها بیرون نیامده است."],[7,"حسودی که یک جو خیانت ندید","به کارش نیامد چو گندم تپید","حسود یا کسی که حسد می‌ورزد، به کسی که خیانت یا نفاقی در کارش ندیده، آسیب نمی‌زند و مانند گندم که در آسیاب می‌تپد، او نیز به ثمر نمی‌رسد و کارش به جایی نمی‌رسد."],[7,"ز روشن دلش ملک پرتو گرفت","وزیر کهن را غم نو گرفت","وزیر کهن، که دلش روشن و پاک است، از غم جدیدی آگاه شد و بر اثر آن، برای ملک پرتو و روشنایی به وجود آورد."],[7,"ندید آن خردمند را رخنه‌ای","که در وی تواند زدن طعنه‌ای","وزیر خردمند متوجه نشد که در وجود او چگونه می‌توان نقطه ضعفی پیدا و از آن به عکس گرفتن طعنه‌ای وارد کرد."],[7,"امین و بد اندیش طشتند و مور","نشاید در او رخنه کردن به زور","آنکه امین و مورد اعتماد است، نباید به تهمت و بدگویی متهم شود، زیرا مانند اینکه مورچه نتواند به زور در طشت (پیمانه) نفوذ کند، چنان شخصی هم نباید مورد آسیب و سوءظن قرار گیرد."],[7,"ملک را دو خورشید طلعت غلام","به سر بر، کمر بسته بودی مدام","سلطانی که دو غلام با چهره‌ای مانند خورشید در کنار او بودند، همیشه کمر خود را در خدمت او بسته و آماده بودند."],[7,"دو پاکیزه پیکر چو حور و پری","چو خورشید و ماه از سدیگر بری","دو پیکر زیبا مانند حور و پری و مانند خورشید و ماه از یکدیگر جدا هستند."],[7,"دو صورت که گفتی یکی نیست بیش","نموده در آیینه همتای خویش","دو صورت که درباره‌شان صحبت کردی بیشتر از یک صورت نیست؛ زیرا در آینه، هر دو تصویر برابر و یکسانی از هم را نشان می‌دهند."],[7,"سخنهای دانای شیرین سخن","گرفت اندر آن هر دو شمشاد بن","سخنان شیوا و دلنشین این دانا، همچون دو شمشاد در کنار هم، در آنجا به زبان آمده است."],[7,"چو دیدند کاوصاف و خلقش نکوست","به طبعش هواخواه گشتند و دوست","وقتی که مردم خوب بودن کاوصاف و خلق او را دیدند، طبق طبیعت و خویشان علاقه‌مند و دوستدار او شدند."],[7,"در او هم اثر کرد میل بشر","نه میلی چو کوتاه‌بینان به شر","در او نیز تأثیر میل انسانی وجود دارد، اما این میل مانند آن‌هایی نیست که فقط به خاطر دیدگاه محدود و کوتاه‌مدت به سمت بدی‌ها می‌روند."],[7,"از آسایش آنگه خبر داشتی","که در روی ایشان نظر داشتی","تو زمانی می‌توانی از آرامش و آسایش واقعی آگاه شوی که به چهره و رفتار آنها (ساده‌روها) توجه کرده باشی و با دیدن حالشان، درک عمیق‌تری از اوضاع پیدا کنی."],[7,"چو خواهی که قدرت بماند بلند","دل، ای خواجه، در ساده رویان مبند","اگر می‌خواهی قدرت و نفوذت حفظ شود، ای آقا، با انسان‌های ساده و بی‌تجربه در نیفت."],[7,"وگر خود نباشد غرض در میان","حذر کن که دارد به هیبت زیان","اگر خیانت و منافع شخصی در کار نباشد، باید احتیاط کرد، زیرا در این صورت ممکن است از نظر قدرت و اعتبار ضربه بخوریم."],[7,"وزیر اندر این شمه‌ای راه برد","به خبث این حکایت بر شاه برد","وزیر در اینجا با نیرنگ و حیله‌ای که دارد، قصد دارد این داستان را به شاه بگوید تا او را متوجه بدی اوضاع کند."],[7,"که این را ندانم چه خوانند و کیست!","نخواهد به سامان در این ملک زیست","نمی‌دانم این چه کسی است و چه نامی دارد! او نمی‌تواند در این کشور به زندگی مناسب ادامه دهد."],[7,"سفر کردگان لاابالی زیند","که پرورده ملک و دولت نیند","افرادی که در سفر به سر می‌برند و بی‌ملاحظگی می‌کنند، نه تنها به رشد و پیشرفت ملک و دولت کمک نمی‌کنند، بلکه به عنوان کسانی که زحمت کشیده و در خدمت کشور نیستند، به حساب می‌آیند."],[7,"شنیدم که با بندگانش سر است","خیانت پسند است و شهوت پرست","شنیدم که در میان بندگان خود (یعنی رعیت و مردم) شخصی وجود دارد که به انجام خیانت و دنبال خواسته‌های جنسی علاقه‌مند است."],[7,"نشاید چنین خیره روی تباه","که بد نامی آرد در ایوان شاه","نمی‌توان کسی را چنین نادان و بی‌توجه به عواقب دانست که با رفتار ناپسند خود، باعث لکه‌دار شدن نام دربار شاه شود."],[7,"مگر نعمت شه فرامش کنم","که بینم تباهی و خامش کنم","آیا می‌توانم نعمت و برکت شاه را فراموش کنم، در حالی که شاهد نابودی و فساد هستم و سکوت کنم؟"],[7,"به پندار نتوان سخن گفت زود","نگفتم تو را تا یقینم نبود","انتظار داشتم که درباره چیزی که مطمئن نیستم، زودتر با تو صحبت نکنم و در واقع به دلایلی که هنوز یقین نداشتم، سکوت کردم."],[7,"ز فرمانبرانم کسی گوش داشت","که آغوش را اندر آغوش داشت","هیچ‌ یک از فرمانبران من به سخن من توجه نکرد، جز کسی که همچون خود من، در آغوش دیگری آغشته بود و به او نزدیک بود."],[7,"من این گفتم اکنون ملک راست رای","چو من آزمودم تو نیز آزمای","یکی از خدمتکارانم دیده است که غلام ترک (آغوش نام غلام ترک) را در آغوش داشت"],[7,"به ناخوب تر صورتی شرح داد","که بد مرد را نیکروزی مباد","اگر کسی به بدی و زشتی بخواهد راجع به شخصی نیکوکار صحبت کند، به گونه‌ای ناخوشایند و زشت آن را توصیف می‌کند که امیدوار نباشد این شخص به خوبی و نیکویی برسد."],[7,"بداندیش بر خرده چون دست یافت","درون بزرگان به آتش بتافت","بداندیش، وقتی به چیزهای کوچک دست پیدا کرد، به بزرگان (افراد بزرگ و توانا) حمله کرد و مانند آتش بر آن‌ها افتاد."],[7,"به خرده توان آتش افروختن","پس آنگه درخت کهن سوختن","با کمترین چیز هم می‌توان آتش را روشن کرد، اما پس از آن درخت کهنسالی (درخت بزرگی که به عمر و ارج و قرب خود معروف است) می‌سوزد."],[7,"ملک را چنان گرم کرد این خبر","که جوشش برآمد چو مرجل به سر","خبر این‌قدر ملک را هیجان‌زده و آتشین کرد که مانند آب جوشیده، فوران کرد."],[7,"غضب دست در خون درویش داشت","ولیکن سکون دست در پیش داشت","اگرچه ملک بسیار خشمگین و آماده کشتن درویش بود، اما به خاطر مصلحت و تدبیر، در مقابل او آرامش و سکون را اختیار کرده بود."],[7,"که پرورده کشتن نه مردی بود","ستم در پی داد، سردی بود","کسی که در تربیت خود به کشتن دیگران عادت کرده، مردانگی ندارد؛ بلکه دنبال ظلم و ستم است و این نشان‌دهنده‌ی سردی و بی‌احساسی اوست."],[7,"میازار پرورده خویشتن","چو تیر تو دارد به تیرش مزن","به فرزند خود یا کسانی که بزرگ کرده‌ای آزار نرسان، چون او نیز می‌تواند به تو آسیب برساند."],[7,"به نعمت نبایست پروردنش","چو خواهی به بیداد خون خوردنش","انسان باید به نعمت‌هایی که در اختیار دارد، احترام بگذارد و آنها را به‌خوبی تربیت کند؛ زیرا اگر در پی ظلم و ستم به دیگران باشد، ممکن است عاقبت بدی برای او رقم بخورد."],[7,"از او تا هنرها یقینت نشد","در ایوان شاهی قرینت نشد","اگر از او (یعنی کسی که در ایوان شاهی است) هنرهای او را باور نکردی و یقین پیدا نکردی، هرگز به مقام و جایگاه او در دربار نزدیک نخواهی شد."],[7,"کنون تا یقینت نگردد گناه","به گفتار دشمن گزندش مخواه","هرگاه که به حقیقت و حقیقت‌سنجی مطمئن نشدی، نباید به اظهارات دشمن توجه کنی و از آن‌ها دچار آسیب و لطمه شوی."],[7,"ملک در دل این راز پوشیده داشت","که قول حکیمان نیوشیده داشت","پادشاه این راز را در دل پنهان کرده بود، زیرا از سخنان حکیمان درس گرفته بود."],[7,"دل است، ای خردمند، زندان راز","چو گفتی نیاید به زنجیر باز","دل، ای خردمند، مثل زندانی است که رازها را در خود نگه می‌دارد و اگر چیزی را گفتی، این راز دیگر نمی‌تواند آزاد بماند و مثل زنجیر به مکاشفه درمی‌آید."],[7,"نظر کرد پوشیده در کار مرد","خلل دید در رای هشیار مرد","او به طور پنهانی به کارهای مردی نگاهی انداخت و مشاهده کرد که در تدبیر و تفکر این مرد نقص و کمبودی وجود دارد."],[7,"که ناگه نظر زی یکی بنده کرد","پری چهره در زیر لب خنده کرد","ناگهان به یکی از بندگانش نگاهی انداخت و دید که یک پری زیبا با چهره‌ای درخشان در زیر لب می‌خندد."],[7,"دو کس را که با هم بود جان و هوش","حکایت کنانند و ایشان خموش","دو نفر که با یکدیگر هستند، یکی جان و دیگری هوش را نشان می‌دهد، و این دو درباره هم صحبت می‌کنند در حالی که خودشان ساکت هستند."],[7,"چو دیده به دیدار کردی دلیر","نگردی چو مستسقی از دجله سیر","وقتی به کسی که شجاعت و شایستگی دارد، نگاه می‌کنی، دیگر جرات نمی‌کنی که به او نزدیک شوی، مانند کسی که از طغیانی در رود دجله می‌ترسد و از آن دوری می‌کند."],[7,"ملک را گمان بدی راست شد","ز سودا بر او خشمگین خواست شد","ملک به این نتیجه رسید که شک و گمان بدی نسبت به برخی امور دارد و از این فکر خشمگین و ناراحت شده است."],[7,"هم از حسن تدبیر و رای تمام","به آهستگی گفتش ای نیک نام","به‌خاطر خوب بودن تدبیر و تصمیم‌گیری‌ها، به آرامی به او گفت: ای کسی که نام نیکویی داری."],[7,"تو را من خردمند پنداشتم","بر اسرار ملکت امین داشتم","من تو را فردی عاقل و دانا می‌دانستم و بر این باور بودم که به رازهای مملکت اعتماد دارم."],[7,"گمان بردمت زیرک و هوشمند","ندانستمت خیره و ناپسند","تصور می‌کردم تو انسان باهوش و ز clever بروی، اما در واقع فهمیدم که بی‌خود و ناپسند هستی."],[7,"چنین مرتفع پایه جای تو نیست","گناه از من آمد خطای تو نیست","منظور این است که تو را در مقام و جایگاهی بالا نمی‌بینم و نارضایتی من به خاطر خطای خودم نیست، بلکه ناشی از اشتباه توست."],[7,"که چون بدگهر پرورم لاجرم","خیانت روا داردم در حرم","زیرا من کسی را که از نیکو نسب و اصالت نیست، پرورش داده‌ام، بنابراین خیانت در حریم خودم را مجاز می‌شمارم."],[7,"برآورد سر مرد بسیاردان","چنین گفت با خسرو کاردان","مرد باسواد و فرزانه‌ای که در مقام خود، به مقاماتی چون خسرو (که به احتمال کاملا شناخته‌شده است و در این زمینه یادآور حاکمان است) مشاوره می‌دهد، نظری را مطرح کرده و بیان می‌کند."],[7,"مرا چون بود دامن از جرم پاک","نباشد ز خبث بداندیش باک","اگر دامن من از گناه پاک باشد، از نجاست و بداندیشی دیگران نگران نیستم."],[7,"به خاطر درم هرگز این ظن نرفت","ندانم که گفت آنچه بر من نرفت","نباید به خاطر پول و دارایی، همیشه فکر بدی درباره من داشته باشند، زیرا نمی‌دانم چه کسی چنین سخنانی را درباره من گفته است."],[7,"شهنشاه گفت: آنچه گفتم برت","بگویند خصمان به روی اندرت","شاه گفت: کسانی که با تو دشمنی دارند، آنچه من به تو گفتم را به تو خواهند گفت."],[7,"چنین گفت با من وزیر کهن","تو نیز آنچه دانی بگوی و بکن","وزیر پیر به من گفت که تو هم هر چه می‌دانی بگو و عمل کن."],[7,"تسبم کنان دست بر لب گرفت","کز او هر چه آید نیاید شگفت","وزیر در حالی که دستانش را به علامت تأمل بر لبش گذاشته، می‌گوید که از او هر چه صادر شود، چیزی شگفت‌آور نخواهد بود."],[7,"حسودی که بیند به جای خودم","کجا بر زبان آورد جز بدم","کسی که حسرت می‌خورد و می‌بیند که جایگاه من محفوظ است، به جز بدگویی و سخن چینی، نمی‌تواند چیزی بگوید."],[7,"من آن ساعت انگاشتم دشمنش","که بنشاند شه زیردست منش","من در آن لحظه فکر کردم که دشمن او (سلطان) کسی است که مرا به زیر دست خود می‌نشاند."],[7,"چو سلطان فضیلت نهد بر ویم","ندانی که دشمن بود در پیم؟","هرگاه پادشاه فضیلت و فضیلت‌مندی را در برابر من قرار دهد، در نمی‌یابی که آیا او در واقع دشمن من است یا نه؟"],[7,"مرا تا قیامت نگیرد به دوست","چو بیند که در عز من ذل اوست",": آیا خود نمیدانی که چون پادشاه درجه مرا از وزیر قدیم برتر قرار دهد وی دشمنی در پی آزار من خواهد شد"],[7,"بر اینت بگویم حدیثی درست","اگر گوش با بنده داری نخست","من می‌خواهم داستانی صحیح را برای تو بگویم، اگر که ابتدا به سخنان من توجه کنی."],[7,"ندانم کجا دیده‌ام در کتاب","که ابلیس را دید شخصی به خواب","شخصی در خواب ابلیس را دیده و این موضوع را در کتابی خوانده‌است، اما او به یاد نمی‌آورد که این خواب را کجا دیده است."],[7,"به بالا صنوبر، به دیدن چو حور","چو خورشیدش از چهره می‌تافت نور","شخصی در خواب ابلیس را به صورت زیبا و نورانی می‌بیند که چهره‌اش مانند خورشید می‌درخشد و زیبایی‌اش همچون حورهای بهشتی است."],[7,"فرا رفت و گفت: ای عجب، این تویی","فرشته نباشد بدین نیکویی","فرا رفت و گفت: عجب است که این تویی، زیرا هیچ فرشته‌ای به این زیبایی نیست."],[7,"تو کاین روی داری به حسن قمر","چرا در جهانی به زشتی سمر؟","تو که چهره‌ات به زیبایی ماه است، چرا در این دنیا همچون زهر مار زشت و ناپسند شده‌ای؟"],[7,"چرا نقش بندت در ایوان شاه","دژم روی کرده‌ست و زشت و تباه؟","چرا تصویر تو در کاخ شاه خراب و زشت و ناخوشایند به نظر می‌رسد؟"],[7,"شنید این سخن بخت برگشته دیو","به زاری برآورد بانگ و غریو","دیو بخت برگشته این سخن را شنید و با گریه فریاد بلندی سر داد"],[7,"که ای نیکبخت این نه شکل من است","ولیکن قلم در کف دشمن است","گفت که ای خوشبخت، ظاهر من اینگونه نیست، بلکه قلم در دست دشمن است."],[7,"مرا همچنین نام نیک است لیک","ز علت نگوید بداندیش نیک","من همچنان نام نیک دارم ، اما فرد بداندیش نمی‌تواند به دلایل خود، خوبی‌های من را بگوید"],[7,"وزیری که جاه من آبش بریخت","به فرسنگ باید ز مکرش گریخت","آن وزیری که مقام من اورا به ترس انداخته باید فرسنگ ها از او دور شد"],[7,"ولیکن نیندیشم از خشم شاه","دلاور بود در سخن، بی‌گناه","اما من از خشم پادشاه که نیرومند است و در گفتار بی‌گناه به نظر می‌رسد، نگرانی ندارم."],[7,"اگر محتسب گردد آن را غم است","که سنگ ترازوی بارش کم است","اگر محتسب (ناظر و سرپرست) به سخن من ایراد بگیرد، ناراحت‌کننده است؛ چون این نشان می‌دهد که وزن و اعتبار کلمات من کاهش یافته است."],[7,"چو حرفم برآید درست از قلم","مرا از همه حرف گیران چه غم؟","وقتی که سخنان من به درستی بیان شود، از این که دیگران چه می‌گویند برایم اهمیتی ندارد."],[7,"ملک در سخن گفتنش خیره ماند","سر دست فرماندهی برفشاند","ملک در هنگام صحبت کردن، گیج و حیران شد و فرمانده را بر سر دست خود بلند کرد."],[7,"که مجرم به زرق و زبان آوری","ز جرمی که دارد نگردد بری","مجرمی که با نیرنگ و سخن‌وری خود را از جرمش تبرئه کند، همچنان به خاطر گناهی که انجام داده، بی‌کیفر نخواهد ماند."],[7,"ز خصمت همانا که نشنیده‌ام","نه آخر به چشم خودم دیده‌ام؟","من از دشمنی تو چیزی نشنیده‌ام و نه آن را با چشم خود مشاهده کرده‌ام، پس چگونه می‌توانم به آن اعتقاد داشته باشم؟"],[7,"کز این زمره خلق در بارگاه","نمی‌باشدت جز در اینان نگاه","می‌گوید که در این جمع، جز این افراد کسی در درگاه (سلطنت) حضور ندارد و نباید به جز آن‌ها نگریست."],[7,"بخندید مرد سخنگوی و گفت","حق است این سخن، حق نشاید نهفت","مرد سخنگو با خنده گفت: این حرف درست است و نباید حقیقت را پنهان کرد."],[7,"در این نکته‌ای هست اگر بشنوی","که حکمت روان باد و دولت قوی","اگر به این نکته توجه کنی، می‌فهمی که حکمت باید در جریان باشد و قدرت باید قوی و پابرجا باشد."],[7,"نبینی که درویش بی دستگاه","به حسرت کند در توانگر نگاه","درویشی که بدون امکانات و امکانات زندگی (دستگاه) است، دیدن ثروتمندانی را که در آرامش و ثروت به سر می‌برند، با حسرت و افسوس تماشا می‌کند."],[7,"مرا دستگاه جوانی برفت","به لهو و لعب زندگانی برفت","من در جوانی از ابزارها و وسایل زندگی و لذت‌ها بهره‌مند بودم، اما اکنون می‌بینم که این‌گونه زندگی و سرگرمی‌ها سپری شده و به هدر رفته است."],[7,"ز دیدار اینان ندارم شکیب","که سرمایه داران حسنند و زیب","من نمی‌توانم در برابر زیبایی و جذابیت این افراد صبر و تحملی داشته باشم، زیرا آنها صاحبان خوبی و زیبایی هستند."],[7,"مرا همچنین چهره گلفام بود","بلورینم از خوبی اندام بود","من چهره‌ای زیبا و گندم‌گون دارم و اندامم نیز به خاطر خوبی و لطافتش همچون بلور است."],[7,"در این غایتم رشت باید کفن","که مویم چو پنبه‌ست و دوکم بدن","در این حالت، باید به رشت (شهری در شمال ایران) بروم و لباس مناسبی بپوشم؛ زیرا مویی دارم که مانند پنبه نرم است و بدنی لاغر و ضعیف دارم."],[7,"مرا همچنین جعد شبرنگ بود","قبا در بر از نازکی تنگ بود","من هم موهایی داشتیم به رنگ سیاه و فر، که لباس‌هایی که به تن داشتم از پشت تنگ و چسبان بود."],[7,"دو رشته درم در دهن داشت جای","چو دیواری از خشت سیمین به‌پای","کسی در دهانش دو رشته سکه دارد که مانند دیواری از خشت نقره به پاهایش است. در واقع، این تصویر نشان‌دهنده ثروت و امکانات اوست."],[7,"کنونم نگه کن به وقت سخن","بیفتاده یک‌یک چو سور کهن","اکنون به زمان سخن گفتن نگاه کن که مثل سوت‌های قدیمی، یکی‌یکی در حال رها شدن است."],[7,"در اینان به حسرت چرا ننگرم؟","که عمر تلف کرده یاد آورم","چرا به این‌ها نگاه نمی‌کنم و حسرت نخورم؟ چون عمرم را بیهوده صرف یادآوری این مسائل کرده‌ام."],[7,"برفت از من آن روزهای عزیز","به پایان رسد ناگه این روز نیز","روزهای خوب و باارزش زندگی من سپری شد و حالا ناگهان این روز نیز به پایان می‌رسد."],[7,"چو دانشور این در معنی بسفت","بگفت این کز این به محال است گفت","چون دانشمندی این موضوع را به خوبی درک کرد، گفت که این امر غیرممکن است."],[7,"در ارکان دولت نگه کرد شاه","کز این خوبتر لفظ و معنی مخواه","شاه به ارکان و عناصر دولت توجه کرد و گفت که از این بهتر، نه کلامی وجود دارد و نه معنایی."],[7,"کسی را نظر سوی شاهد رواست","که داند بدین شاهدی عذر خواست","نگاه به محبوب (شاهد) مقبول است برای کسی که بداند از این محبوب، عذری (پوزش) خواسته می‌شود."],[7,"به عقل ار نه آهستگی کردمی","به گفتار خصمش بیازردمی","اگر به عقل خود کمی صبر نشان نمی‌دادم، با سخنرانی‌ام او را آزار می‌دادم."],[7,"به تندی سبک دست بردن به تیغ","به دندان برد پشت دست دریغ","اگر با شتاب و بی‌احتیاط، کار را آغاز کنی و به جای تدبیر، تند عمل کنی، همانند کسی خواهی بود که با ضربه تند شمشیر به خود آسیب می‌زند و از این کار پشیمان خواهد شد."],[7,"ز صاحب غرض تا سخن نشنوی","که گر کار بندی پشیمان شوی","اگر از کسی که هدف خاصی دارد (مثل دسیسه یا دشمنی) سخن نشنوی و به حرف‌های او توجه نکنی، بهتر است؛ زیرا اگر در کارهایت دقت کنی، ممکن است بعدا از تصمیم خود پشیمان شوی."],[7,"نکونام را جاه و تشریف و مال","بیفزود و، بدگوی را گوشمال","نیکان و آدم‌های خوب را محترم می‌داشت و مال و ثروتشان را می‌افزود و آدم بدگو و بد را تنبیه و مجازات می‌کرد."],[7,"به تدبیر دستور دانشورش","به نیکی بشد نام در کشورش","به خاطر تدبیر و راهنمایی دانشمندش، نام نیک آن پادشاه در سرزمینش مشهور و معروف شد."],[7,"به عدل و کرم سالها ملک راند","برفت و نکونامی از وی بماند","این پادشاه سال‌ها با انصاف و بخشش حکومت کرد و پس از رفتن او، نام نیکش در یادها باقی ماند."],[7,"چنین پادشاهان که دین پرورند","به بازوی دین، گوی دولت برند","پادشاهانی که به پرورش دین اهمیت می‌دهند، با تأسیس و تقویت دین، بر قدرت و حکومت خود تأثیرگذارند و با این نیروی دینی، سلطنت و موفقیت خود را تأمین می‌کنند."],[7,"از آنان نبینم در این عهد کس","وگر هست بوبکر سعد است و بس","در این زمان، کسی را مانند ابوبکر صدیق نمی‌بینم و اگر هم باشد، تنها اوست که در این مقطع وجود دارد."],[7,"بهشتی درختی تو، ای پادشاه","که افکنده‌ای سایه یک ساله راه","ای پادشاه، تو مانند درختی هستی که سایه‌ای خوش و دلپذیر بر سر راه مردم افکنده‌ای و این سایه به خاطر آقایی و رهبری تو، برای یک سال ادامه دارد."],[7,"طمع بود از بخت نیک اخترم","که بال همای افکند بر سرم","امید داشتم که بخت خوب و ستاره‌ی خوش‌شانسی بر سرم سایه افکند و من را ز برکت آن بهره‌مند کند."],[7,"خرد گفت دولت نبخشد همای","گر اقبال خواهی در این سایه آی","خرد می‌گوید که اگر همای (پرنده‌ای نمادین در فرهنگ ایرانی که به خوشبختی و خوش‌شانسی اشاره دارد) به تو پول و خوشبختی ندهد، باید زیر سایه‌اش بروی و به اقبال خود فکر کنی. در واقع، فرصت‌ها و شانس‌ها را باید غنیمت شمرد."],[7,"خدایا به رحمت نظر کرده‌ای","که این سایه بر خلق گسترده‌ای","خدایا، تو با رحمتت به این سایه نگاه کرده‌ای و آن را بر مردم گسترانده‌ای."],[7,"دعا گوی این دولتم بنده‌وار","خدایا تو این سایه پاینده دار","سخنگوی این حکومت، به شکل خاضعانه از خدا می‌خواهد که این حمایت و سایه را پایدار نگه دارد."],[7,"صواب است پیش از کشش بند کرد","که نتوان سر کشته پیوند کرد","پیش از آنکه به کارهای خطرناک وارد شوی و درگیری و کشت و کشتار راه بیندازی، بهتر است که از آن کارها جلوگیری کنی، زیرا پس از کشتن کسی، دیگر نمی‌توان با او ارتباط برقرار کرد یا او را به زندگی برگرداند."],[7,"خداوند فرمان و رای و شکوه","ز غوغای مردم نگردد ستوه","خداوند، که سرکرده و دارنده قدرت و شکوه است، از هیاهو و جمعیت مردم شکست نمی‌خورد و دلسرد نمی‌شود."],[7,"سر پر غرور از تحمل تهی","حرامش بود تاج شاهنشهی","انسان مغرور و از خود راضی، قادر به تحمل سختی‌ها نیست و به همین دلیل، لیاقت نشستن بر تاج شاهی را ندارد."],[7,"نگویم چو جنگ آوری پای دار","چو خشم آیدت عقل بر جای دار","هنگامی که به جنگ می‌روی، عقل و تدبیر را کنار نگذار؛ اگر خشم بر تو غلبه کند، عقل را در جای خود محفوظ نگه‌دار."],[7,"تحمل کند هر که را عقل هست","نه عقلی که خشمش کند زیردست","هر کسی که عقل دارد، باید توانایی تحمل را داشته باشد، نه عقلی که تحت تأثیر خشمش قرار بگیرد و او را به رفتارهای ناپسند وادارد."],[7,"چو لشکر برون تاخت خشم از کمین","نه انصاف ماند نه تقوی نه دین","وقتی که سپاه خشم به بیرون حمله کرد، دیگر نه انصاف باقی می‌ماند، نه تقوا و نه دین."],[7,"ندیدم چنین دیو زیر فلک","که از وی گریزند چندین ملک","در این بیت شاعر می‌گوید که هرگز دیوی را مانند این موجود نادیده دیده که باعث فرار چندین پادشاه شده باشد. این دیو نماد ظلم یا قساوت است که بر سر مردم و پادشاهان سلطه دارد."],[8,"نه بر حکم شرع آب خوردن خطاست","وگر خون به فتوی بریزی رواست","بر اساس احکام شرع، نوشیدن آب گناهی ندارد، اما ریختن خون دیگران به فرمان قانون مجاز است."],[8,"که را شرع فتوی دهد بر هلاک","الا تا نداری ز کشتنش باک","هیچ‌کس را شرع نمی‌تواند به هلاکت برساند، مگر اینکه خود او از کشتن دیگران ترسی نداشته باشد."],[8,"وگر دانی اندر تبارش کسان","بر ایشان ببخشای و راحت رسان","اگر درباره خانواده و خویشاوندان او اطلاع داری، بر آن‌ها ببخش و آرامش بده."],[8,"گنه بود مرد ستم‌کاره را","چه تاوان زن و طفل بیچاره را؟","سزای کسی که بر مردم ستم می‌کند چه فایده‌ای دارد در حالی که زن و فرزندان بیچاره او را نیز آسیب می‌زند؟"],[8,"تنت زورمند است و لشکر گران","ولیکن در اقلیم دشمن مران","بدن تو قوی و سپاه تو زیاد است، اما در سرزمین دشمن نباید به آنجا بروی."],[8,"که وی بر حصاری گریزد بلند","رسد کشوری بی‌گنه را گزند","اگر او بر دژی بلند پناه ببرد، کشوری بی‌گناه را مورد آسیب و صدمه قرار می‌دهد."],[8,"نظر کن در احوال زندانیان","که ممکن بود بی‌گنه در میان","به زندانیان توجه کن که ممکن است بی‌گناه در بین آنها وجود داشته باشد."],[8,"چو بازارگان در دیارت بمرد","به مالش خساست بود دست‌برد","وقتی تاجر در دیارت بمیرد، به خاطر مال و ثروتش دست به دزدی نمی‌زند و از آن‌ها چشم‌پوشی می‌کند."],[8,"کز آن پس که بر وی بگریند زار","به هم باز گویند خویش و تبار","پس از اینکه بر او به شدت گریه کنند، بستگان و خانواده‌اش دوباره یکدیگر را شناسایی کرده و به یاد هم می‌آورند."],[8,"که مسکین در اقلیم غربت بمرد","متاعی کز او ماند ظالم ببرد","فقیر در سرزمین غربت از دنیا رفت و اموالی که از او باقی ماند، ظالم‌ها آن‌ها را غصب کردند."],[8,"بیندیش از آن طفلک بی‌پدر","وز آه دل دردمندش حذر","به حال آن کودک یتیم بی‌پدر فکر کن و از دل او که در درد و رنج است، بپرهیز."],[8,"بسا نام نیکوی پنجاه سال","که یک نام زشتش کند پایمال","گاهی یک نام نیک که فرد در طول پنجاه سال به دست آورده، با یک عمل بد یا نامناسب به راحتی از بین می‌رود و تحت تأثیر قرار می‌گیرد."],[8,"پسندیده‌کاران جاویدنام","تطاول نکردند بر مال عام","کارهای پسندیده و نیکوکاران همیشه در تاریخ ماندگار است و آنها هرگز بر اموال عمومی طمع نمی‌کنند."],[8,"بر آفاق اگر سر به سر پادشاست","چو مال از توانگر ستاند گداست","اگر در تمام جهان پادشاهی وجود داشته باشد، در صورتی که مال و ثروت از توانگران گرفته شود، آن گدا (فقیر) هم پادشاه است."],[8,"بمرد از تهیدستی آزاد مرد","ز پهلوی مسکین شکم پر نکرد","آزاد مرد از تهیدستی و فقر گرسنه نمی‌شود و از نیاز مسکین بیچاره بهره‌برداری نمی‌کند."],[9,"شنیدم که فرماندهی دادگر","قبا داشتی هر دو روی آستر","شنیده‌ام که پادشاهی عادل لباسی بر تن داشت که هر دو روی آن پارچه‌ای ساده و ارزان (از جنس آستر) بود و هیچ زرق‌وبرقی نداشت."],[9,"یکی گفتش ای خسرو نیکروز","ز دیبای چینی قبایی بدوز","شخصی به او گفت: ای پادشاه سعادتمند و خوش‌اقبال، لباسی شایسته از ابریشم گران‌بهای چینی برای خود بدوز."],[9,"بگفت این قدر ستر و آسایش است","وز این بگذری زیب و آرایش است","پادشاه پاسخ داد: همین لباس ساده برای پوشش تن و راحتی جسم کافی است؛ فراتر از این، چیزی جز تجمل و خودنمایی اضافه نیست."],[9,"نه از بهر آن می‌ستانم خراج","که زینت کنم بر خود و تخت و تاج","من از مردم مالیات و خراج نمی‌گیرم تا با پول آن به تخت و تاج و سر و وضع خودم جلال و زینت ببخشم."],[9,"چو همچون زنان حله در تن کنم","به مردی کجا دفع دشمن کنم؟","اگر اهل نازپروردگی و پوشیدن جامه‌های حریر و لطیف شوم، دیگر دلیری و صلابت دفاع از کشور و مقابله با دشمنان را نخواهم داشت."],[9,"مرا هم ز صد گونه آز و هواست","ولیکن خزینه نه تنها مراست","من نیز مانند هر انسانی تمایلات، هواهای نفسانی و خواسته‌های گوناگون دارم؛ اما خزانه‌ی کشور دارایی شخصی من نیست، بلکه به همگان تعلق دارد."],[9,"خزاین پر از بهر لشکر بود","نه از بهر آذین و زیور بود","خزانه‌ی عمومی باید انباشته از سرمایه باشد تا صرف امنیت و تجهیز سپاه شود، نه این‌که خرج جواهر و اشرافی‌گری درباریان گردد."],[9,"سپاهی که خوشدل نباشد ز شاه","ندارد حدود ولایت نگاه","لشکریانی که از پادشاه خود خرسند، تأمین و دلگرم نباشند، در پاسداری از مرزهای کشور انگیزه و تلاشی نشان نخواهند داد."],[9,"چو دشمن خر روستایی برد","ملک باج و ده‌یک چرا می‌خورد؟","اگر دشمن بیاید و دارایی روستایی بینوا را به غارت ببرد، حاکم به چه حقی از او مالیات و عوارض (ده‌یک: یک‌دهم محصول) می‌گیرد؟ وظیفه اصلی حکومت تأمین امنیت مردم است."],[9,"مخالف خرش برد و سلطان خراج","چه اقبال ماند در آن تخت و تاج؟","وقتی دشمن دارایی رعیت را غارت کند و پادشاه هم خراج بستاند، دیگر چه برکت و ماندگاری‌ای برای آن حکومت و پادشاهی باقی می‌ماند؟"],[9,"رعیت درخت است اگر پروری","به کام دل دوستان بر خوری","مردم مانند درختی بارور هستند؛ اگر از آن‌ها نگهداری و پشتیبانی کنی، سود و میوه آن به دولت و دوستانت می‌رسد."],[9,"به بی‌رحمی از بیخ و بارش مکن","که نادان کند حیف بر خویشتن","با ستمگری این درخت (رعیت) را ریشه‌کن و بی‌حاصل نکن؛ زیرا فرد نادان با ستم بر مردم، در واقع بر سود و منافع خود آسیب می‌زند (حیف کردن: ظلم و ضرر زدن)."],[9,"مروت نباشد بر افتاده زور","برد مرغ دون دانه از پیش مور","اعمال زور و قدرت‌نمایی در برابر فرد ناتوان، دور از جوانمردی است؛ این کار مانند رفتار پرنده‌ای فرومایه است که دانه را از جلوی مورچه‌ای ضعیف می‌رباید."],[9,"کسان بر خورند از جوانی و بخت","که بر زیردستان نگیرند سخت","تنها کسانی از اقبال مساعد و مواهب زندگی بهره‌مند و کامروا می‌شوند که بر فرودستان و زیردستان خود سخت‌گیری و بی‌رحمی نکنند."],[9,"اگر زیردستی در آید ز پای","حذر کن ز نالیدنش بر خدای","اگر بینوایی بر اثر فشار ستم از پا درآمد، از دادخواهی و شکایت بردن او به درگاه خدا (آه مظلوم) به شدت پروا کن."],[9,"چو شاید گرفتن به نرمی دیار","به پیکار خون از مشامی میار","وقتی می‌توان سرزمینی را با مدارا، تدبیر و ملایمت فتح و اداره کرد، نباید با جنگ و ستیزه‌جویی خونی از بینی کسی روان ساخت."],[9,"به مردی که ملک سراسر زمین","نیرزد که خونی چکد بر زمین","به آیین جوانمردی سوگند که پادشاهی بر تمام پهنه زمین، ارزش آن را ندارد که حتی قطره‌ای خون به ناحق بر خاک ریخته شود."],[9,"شنیدم که جمشید فرخ‌سرشت","به سرچشمه‌ای بر به سنگی نوشت","شنیده‌ام که جمشید، پادشاه نیک‌سیرت باستان، بر تخته‌سنگی در کنار سرچشمه‌ای این سخن را نگاشت:"],[9,"بر این چشمه چون ما بسی دم زدند","برفتند چون چشم بر هم زدند","پیش از ما نیز حاکمان و مردمان فراوانی کنار این چشمه زندگی کردند و درست به سرعت یک چشم‌برهم‌زدن از این جهان رفتند."],[9,"گرفتیم عالم به مردی و زور","ولیکن نبردیم با خود به گور","ما با شجاعت و قدرت بازو سراسر دنیا را تسخیر کردیم، اما در نهایت نتوانستیم سرسوزنی از این ملک و مال را با خود به درون گور ببریم."],[9,"چو بر دشمنی باشدت دسترس","مرنجانش کاو را همین غصه بس","هرگاه بر دشمن شکست‌خورده چیرگی یافتی، او را شکنجه و آزار مده؛ زیرا همان اندوه خفت و شکست برای مجازاتش کافی است."],[9,"عدو زنده سرگشته پیرامنت","به از خون او کشته در گردنت","اگر دشمن شکست‌خورده‌ات زنده اما بی‌اثر و سرگردان بماند، بسیار بهتر از آن است که بار خون و گناه کشتن او بر گردن و سرنوشتت سنگینی کند."],[10,"شنیدم که دارای فرخ تبار","ز لشکر جدا ماند روز شکار","شنیدم که یکی از شاهان که از خاندان های شاهان بود روزی که به شکار رفته بود از بقیه گروه و درباریان جدا ماند و عقب افتاد"],[10,"دوان آمدش گله‌بانی به پیش","به دل گفت دارای فرخنده کیش","یک گله‌بان با تأسیس دوید و به پیش آمد. در دلش گفت که این شخص از نسل نیکو و خوش‌خوی است."],[10,"مگر دشمن است این که آمد به جنگ","ز دورش بدوزم به تیر خدنگ","آیا این که به جنگ آمده، دشمن است؟ از دور او را با تیر و کمان هدف قرار می‌دهم."],[10,"کمان کیانی به زه راست کرد","به یک دم وجودش عدم خواست کرد","کمان کیانی را کشید و آماده پرتاب کرد ولی به یکباره چیزی در درون او مانع از پرتاب تیر شد"],[10,"بگفت ای خداوند ایران و تور","که چشم بد از روزگار تو دور","ای کسی که صاحب ایران و تور (سرزمین‌های تاریخی ایران) هستی، امیدوارم چشمان بد و آسیب‌زننده از روزگار تو دور باشد."],[10,"من آنم که اسبان شه پرورم","به خدمت بدین مرغزار اندرم","من کسی هستم که به تربیت اسب‌های نژاده می‌پردازم و در این چمن‌زار به خدمت آنها مشغولم."],[10,"ملک را دل رفته آمد به جای","بخندید و گفت: ای نکوهیده رای","ملک با دل افسرده و ناراحت به محفل آمد و با طعنه و کنایه گفت: ای کسی که رای تو مذمت شده و ناپسند است."],[10,"تو را یاوری کرد فرخ سروش","وگر نه زه آورده بودم به گوش","سروش خوش‌نوا و نیکبختی تو را یاری کرد، و اگر این کمک نمی‌بود، من برای تو زهر (بدی) می‌آوردم."],[10,"نگهبان مرعی بخندید و گفت:","نصیحت ز منعم نباید نهفت","نگهبان مرتع با لبخند گفت: نصیحت و توصیه‌ای که از شخص بخشنده باشد، نباید پنهان بماند."],[10,"نه تدبیر محمود و رای نکوست","که دشمن نداند شهنشه ز دوست","تدبیر و عقل محمود (محمود، یکی از پادشاهان سلسله غزنوی) فایده‌ای ندارد اگر دشمن نتواند تشخیص دهد که شاه از دوستش چه کسی است. در واقع، در اینجا به اهمیت شناخت و تمایز بین دوستی و دشمنی اشاره می‌شود."],[10,"چنان است در مهتری شرط زیست","که هر کهتری را بدانی که کیست","در زندگی بزرگ‌مردی، لازم است که هر کس را بشناسی و بدانی او کیست."],[10,"مرا بارها در حضر دیده‌ای","ز خیل و چراگاه پرسیده‌ای","تو بارها مرا در میان مردمان دیده‌ای و از چرای دام‌ها و چراگاه‌ها از من پرس‌وجو کرده‌ای."],[10,"کنونت به مهر آمدم پیشباز","نمی‌دانیم از بداندیش باز","اکنون با محبت و دوستی به سوی تو آمده‌ام، اما نمی‌دانم چگونه باید از دشمنان و بداندیشان دوری کنم."],[10,"توانم من، ای نامور شهریار","که اسبی برون آرم از صد هزار","ای شهریار معروف، من می‌توانم که از میان صد هزار اسب، یکی را برای تو بیاورم."],[10,"مرا گله‌بانی به عقل است و رای","تو هم گله خویش باری، بپای","من در اداره و مدیریت خود به عقل و تدبیر نیاز دارم، و تو نیز مسئولیت و هدایت مردم را در دست داری، پس باید مراقب و مسئول این وظیفه باشی."],[10,"در آن تخت و ملک از خلل غم بود","که تدبیر شاه از شبان کم بود","در آن تخت و سلطنت، غم و رنج وجود داشت زیرا تدبیر و مدیریت شاه کمتر از تدبیر شبان (گله‌بان) بود."],[11,"تو کی بشنوی ناله دادخواه","به کیوان برت کله خوابگاه؟","آیا تو ظرفیتی داری که ناله و فریاد مظلومانی را که دادخواهی می‌کنند بشنوی، یا در خواب و غفلت قرار داری و نسبت به درد آن‌ها بی‌توجهی؟"],[11,"چنان خسب کآید فغانت به گوش","اگر دادخواهی برآرد خروش","چنان بخواب برو که صدای ناله‌ات به گوش کسی نرسد؛ اگر کسی در حال دادخواهی فریاد بزند، صدای او مانند ناله‌ات به گوش تو خواهد رسید."],[11,"که نالد ز ظالم که در دور توست","که هر جور کاو می‌کند جور توست","کسی که در نزد تو از ظلم فریاد می‌زند، در واقع از کسی ناله می‌کند که در دور و بر اوست و هر ظلمی که می‌کند، به خاطر ظلم تو است."],[11,"نه سگ دامن کاروانی درید","که دهقان نادان که سگ پرورید","هیچ سگی به کاروانی آسیب نمی‌زند، مگر اینکه صاحب آن، یعنی دهقان نادان، آن را تربیت کرده باشد."],[11,"دلیر آمدی سعدیا در سخن","چو تیغت به دست است فتحی بکن","سعدی، تو در سخن و گفتار خود شجاع و دلیر هستی، مانند تیغی که در دست داری و می‌تواند پیروزی به ارمغان آورد."],[11,"بگو آنچه دانی که حق گفته به","نه رشوت ستانی و نه عشوه ده","هر آنچه را که می‌دانی بگو، زیرا حق این است که نباید دروغ بگویی و نه باید با دادن رشوه یا وعده‌های فریبنده، حقیقت را پنهان کنی."],[11,"طمع بند و دفتر ز حکمت بشوی","طمع بگسل و هرچه دانی بگوی","طمع و عشق به دنیا را رها کن و از حکمت و دانش خود دست بکش. هرچه که می‌دانی، صادقانه بگو و نه به خاطر منافع شخصی."],[12,"خبر یافت گردن‌کشی در عراق","که می‌گفت مسکینی از زیر طاق","خبر آمده که یک گردن‌کش در عراق، ادعا کرده است که کسی از زیر طاق (درب یا سازه‌ای) ناتوان و بی‌کس است."],[12,"تو هم بر دری هستی امیدوار","پس امید بر در نشینان برآر","تو هم در وضعیتی مشابه هستی و به آینده امیدوار به سر می‌بری، بنابراین باید به کسانی که در همان وضع و با آرزوهای مشابه هستند کمک کنی."],[12,"نخواهی که باشد دلت دردمند","دل دردمندان برآور ز بند","اگر نمی‌خواهی که دل تو درد داشته باشد، دل کسانی را که دردمند هستند آزاد کن و به آن‌ها کمک نما."],[12,"پریشانی خاطر دادخواه","براندازد از مملکت پادشاه","اختلال و ناراحتی ذهنی مخالفان و خواستاران عدالت، باعث راندن آن‌ها از سرزمین یک پادشاه می‌شود."],[12,"تو خفته خنک در حرم نیمروز","غریب از برون گو به گرما بسوز","تو در آرامش و راحتی خوابیده‌ای، اما در دنیای بیرون، افرادی هستند که تحت آفتاب سوزان داغی قرار دارند و غمگین و بی‌کس هستند."],[12,"ستاننده داد آن کس خداست","که نتواند از پادشه دادخواست","کسی که در برابر ظلم و بی‌عدالتی دادخواهی نمی‌تواند، تنها خداوند است که عدالت را می‌ستاند."],[13,"یکی از بزرگان اهل تمیز","حکایت کند ز ابن عبدالعزیز","یکی از رجال بزرگ با درک و فهم لازم، داستانی از ابن عبدالعزیز را نقل می‌کند."],[13,"که بودش نگینی در انگشتری","فرو مانده در قیمتش جوهری","ابن عبدالعزیز، درخواستی از حکمرانش دارد که نشان‌دهنده ارزش‌مندی او است؛ انگشتری که در دست دارد، نشان‌دهنده مقام و ثروت اوست، اما در واقع جوهر آن (بهای واقعی آن) در قیمتی که بر آن گذاشته‌اند، کمتر از ارزش واقعی‌اش است."],[13,"به شب گفتی از جرم گیتی فروز","دری بود از روشنایی چو روز","گویی قطعه‌ای از خورشید بود که درخشش به هنگام شب تاریکی را چون روز روشن می‌نمود"],[13,"قضا را درآمد یکی خشک سال","که شد بدر سیمای مردم هلال","در این بیت گفته شده است که قضا (سرنوشت) یکی از سال‌های خشک و بی‌آب و علف به وقوع پیوست که در آن هنگام، شکل مردم شبیه هلال (ماه نو) شده است، یعنی به دلیل کمبود آب و خشکسالی، چهره‌ها ضعیف و لاغر به نظر می‌رسیدند."],[13,"چو در مردم آرام و قوت ندید","خود آسوده بودن مروت ندید","وقتی در میان مردم آرامش و نیرومندی نمی‌بیند، نباید از خود راحتی و آسایش نشان دهد، زیرا نشان‌دهنده بی‌مروتی است."],[13,"چو بیند کسی زهر در کام خلق","کیش بگذرد آب نوشین به حلق","هرگاه کسی ببیند که دیگران در سختی و بدبختی هستند، با بی‌توجهی از کنار آنان عبور نمی‌کند و به راحتی نمی‌گذرد، حتی اگر خود در حال نوشیدن آب شیرین باشد."],[13,"بفرمود و بفروختندش به سیم","که رحم آمدش بر غریب و یتیم","او دستور داد و آن مال را به پول فروختند، زیرا برایش دل‌سوزی کرد و به حال یتیمان و غریب‌ها رحم آورد."],[13,"به یک هفته نقدش به تاراج داد","به درویش و مسکین و محتاج داد","سعدی می‌گوید که در این ماجرا، شخص (که در بیت قبلی به او اشاره شده) بعد از یک هفته، تمام پول به دست آمده را به افراد نیازمند، مانند درویش‌ها، مسکین‌ها و کسانی که به کمک احتیاج دارند، بخشید."],[13,"فتادند در وی ملامت کنان","که دیگر به دستت نیاید چنان","آن‌ها با سرزنش در او افتادند و گفتند که دیگر نمی‌توانی مثل آن را به دست بیاوری."],[13,"شنیدم که می‌گفت و باران دمع","فرو می‌دویدش به عارض چو شمع","شنیدم که او می‌گفت و باران اشک از چهره‌اش مانند آب از شمع می‌چکید."],[13,"که زشت است پیرایه بر شهریار","دل شهری از ناتوانی فگار","زشت است که برای یک پادشاه، تظاهر و زینت‌آرایی (پیرایه) داشته باشد در حالی که او از درد و رنج مردمی که ناتوان هستند، آگاه باشد و دلش از این وضعیت آزرده (فگار) باشد."],[13,"مرا شاید انگشتری بی‌نگین","نشاید دل خلقی اندوهگین","شاید برای من زیبا نباشد که انگشتری بدون نگین داشته باشم، زیرا دل مردم اندوهگین می‌شود."],[13,"خنک آن که آسایش مرد و زن","گزیند بر آرایش خویشتن","خوشا به حال کسی که آرامش دیگران را بر زیبایی و خوش‌ظاهر شدن خودش ترجیح می‌دهد."],[13,"نکردند رغبت هنرپروران","به شادی خویش از غم دیگران","هنرپروران و افراد بافرهنگ به خاطر خوشحالی خود، به غم و اندوه دیگران توجه نکردند و از این برای شادی خود بهره‌ای نبردند."],[13,"اگر خوش بخسبد ملک بر سریر","نپندارم آسوده خسبد فقیر","اگر پادشاهی بر تختش با خوشی و راحت بخوابد، نمی‌توانم تصور کنم که فقیر در آرامش و آسایش بخوابد."],[13,"وگر زنده دارد شب دیر باز","بخسبند مردم به آرام و ناز","اگر آن پادشاه شب تا دیر موقع بیدار باشه مردمش میتونن به راحتی و آرامش بخوابند."],[13,"بحمدالله این سیرت و راه راست","اتابک ابوبکر بن سعد راست","خوشبختانه، این ویژگی و روش صحیح اتابک ابوبکر بن سعد است."],[13,"کس از فتنه در پارس دیگر نشان","نبیند مگر قامت مهوشان","هیچ‌یک از مردم پارس دیگر نشانه‌ای از فتنه و آشوب نخواهند دید، مگر آنکه قامت زیبا و دلربای معشوقان را ببینند."],[13,"یکی پنج بیتم خوش آمد به گوش","که در مجلسی می‌سرودند دوش","شخصی از شنیدن یک غزل زیبا و دلنشین که در یک مجلس در شب گذشته خوانده می‌شد، لذت می‌برد و آن را خوشایند می‌داند."],[13,"مرا راحت از زندگی دوش بود","که آن ماهرویم در آغوش بود","دیشب آرامش و راحتی من از زندگی به خاطر این بود که آن معشوق زیبارو در آغوشم بود."],[13,"مر او را چو دیدم سر از خواب مست","بدو گفتم ای سرو پیش تو پست","وقتی او را دیدم که در خواب سرمست و خوشحال است، به او گفتم ای سرو (تشبیه به زیبایی و قامت بلند)، من در برابر تو از نظر مقام و ارزش پست هستم."],[13,"دمی نرگس از خواب نوشین بشوی","چو گلبن بخند و چو بلبل بگوی","چند لحظه‌ای نرگس را از خواب زیبا و شاداب بیدار کن تا مانند گلستان خوشبو بخندد و مثل بلبل آهنگ شادی سر دهد."],[13,"چه می‌خسبی ای فتنه روزگار؟","بیا و می لعل نوشین بیار","ای فتنه روزگار، چرا خوابیده‌ای؟ بیا و شراب قرمز و خوش طعم بیاور."],[13,"نگه کرد شوریده از خواب و گفت","مرا فتنه خوانی و گویی مخفت","شوریده (دیوانه) از خواب بیدار شد و گفت: تو مرا فتنه می‌خوانی، در حالی که خودت در خواب غفلت هستی."],[13,"در ایام سلطان روشن نفس","نبیند دگر فتنه بیدار کس","در زمان پادشاهی که درستکاری و عقل او روشن است، کسی دیگر را نباید بیدار و مضطرب ببیند که دچار فتنه و آشفتگی شده باشد."],[14,"در اخبار شاهان پیشینه هست","که چون تکله بر تخت زنگی نشست","در تاریخ پادشاهان، روایت‌هایی وجود دارد که نشان می‌دهد وقتی تکله بر تخت زنگی نشسته است، چه رویدادهایی رخ داده."],[14,"به دورانش از کس نیازرد کس","سبق برد اگر خود همین بود و بس","در دوران حکومت تکله، هیچ‌کس به او آسیب نرساند و اگر هم کسی بر او برتری می‌یافت، فقط همین خود او بود که دلیل این وضعیت بود."],[14,"چنین گفت یک ره به صاحبدلی","که عمرم به سر رفت بی حاصلی","یک بار به شخص باخودش گفت: عمر من به پایان رسید و هیچ دستاوردی نداشته‌ام."],[14,"بخواهم به کنج عبادت نشست","که دریابم این پنج روزی که هست","می‌خواهم در گوشه‌ای برای عبادت و آرامش بنشینم تا این پنج روز زندگی‌ام را درک کنم."],[14,"چو می‌بگذرد جاه و ملک و سریر","نبرد از جهان دولت الا فقیر","وقتی که زمان و سلطنت و تخت و تاج از دنیا می‌گذرد، هیچ چیز جز فقر و نیازمندی باقی نمی‌ماند."],[14,"چو بشنید دانای روشن نفس","به تندی برآشفت کای تکله بس!","وقتی دانای روشن‌نفس خبر را شنید، با خشم و تندی گفت: «ای تکله، بس کن!"],[14,"طریقت به جز خدمت خلق نیست","به تسبیح و سجاده و دلق نیست","راه و روش حق فقط در خدمت به مردم است، نه در تسبیح و سجاده و لباس‌های فاخر و تزئینی."],[14,"تو بر تخت سلطانی خویش باش","به اخلاق پاکیزه درویش باش","اینجا به پادشاه توصیه می‌شود که در سلطنت خود، نیکو رفتاری و اخلاق شایسته داشته باشد و از خصوصیات درویشان (مردم ساده و بی‌آلایش) پیروی کند."],[14,"به صدق و ارادت میان بسته‌دار","ز طامات و دعوی زبان بسته دار","با صداقت و اراده، میان را برای خود ببند و از دروغ و ادعا زبانت را وادار به سکوت کن."],[14,"قدم باید اندر طریقت نه دم","که اصلی ندارد دم بی‌قدم","در مسیر سیر و سلوک معنوی، باید به عمل و حرکت واقعی توجه کرد و صرف نفس کشیدن یا گفتن کافی نیست، زیرا بدون اقدام عملی، هیچ اصولی وجود ندارد."],[14,"بزرگان که نقد صفا داشتند","چنین خرقه زیر قبا داشتند","بزرگان و شخصیت‌های بزرگ که روح و باطن پاکی داشتند، همیشه به معنای عمیق‌تری از زندگی نگاه می‌کردند و این را در پوشش خود نیز نشان می‌دادند."],[15,"شنیدم که بگریست سلطان روم","بر نیکمردی ز اهل علوم","سلطان روم به خاطر دانشمندی از اهل علم بسیار گریه کرد."],[15,"که پایابم از دست دشمن نماند","جز این قلعه و شهر با من نماند","سلطان روم می‌گوید تنها چیزی که در برابر دشمن باقی مانده، همین قلعه و شهر است و چیز دیگری برایش نمی‌ماند."],[15,"بسی جهد کردم که فرزند من","پس از من بود سرور انجمن","مدت زیادی تلاش کردم که فرزند من بعد از من، رهبری و ریاست جمع را به عهده بگیرد."],[15,"کنون دشمن بدگهر دست یافت","سر دست مردی و جهدم بتافت","اکنون دشمن نابکار به قدرت و برتری رسیده است و تلاش من برای حفظ مقام و موقعیت فرزندم بی‌نتیجه مانده است."],[15,"چه تدبیر سازم، چه درمان کنم؟","که از غم بفرسود جان در تنم","در اینجا شاعر به سردرگمی و ناامیدی خود اشاره می‌کند و می‌گوید که نمی‌داند چه تدبیری بیندیشد یا چه راه حلی پیدا کند، زیرا غم و اندوه او به حدی رسیده که جانش را در بدنش به تنگ آورده است."],[15,"بگفت ای برادر غم خویش خور","که از عمر بهتر شد و بیشتر","به فردی که در غم و اندوه به سر می‌برد، گفته می‌شود که به جای نگرانی و غمگینی، باید به زندگی و زمان خود توجه کند، زیرا عمر او بهتر و بیشتر از آنچه که تصور می‌کند، گذشته است."],[15,"تو را این قدر تا بمانی بس است","چو رفتی جهان جای دیگر کس است","به تو فقط همین اندازه عمر و زندگی کافی است و بعد از رفتنت دیگر دنیا برای کسی دیگر است."],[15,"اگر هوشمند است و گر بی‌خرد","غم او مخور کاو غم خود خورد","اگر او آدم باهوش یا بی‌خود باشد، نگران او نباشید چرا که او بیشتر به فکر خودش است و غم خودش را می‌خورد."],[15,"مشقت نیرزد جهان داشتن","گرفتن به شمشیر و بگذاشتن","زندگی سختی‌هایش را نمی‌ارزد، چه فایده‌ای دارد که با شمشیر کسی را به تسلیم وادار کنیم و در عوض آرامش را از دست دهیم؟"],[15,"بدین پنج روزه اقامت مناز","به اندیشه تدبیر رفتن بساز","من در مدت پنج روزی که اینجا مانده‌ام، با فکر و تدبیر تلاش می‌کنم تا به بهترین نحو اقدام کنم و از درگیری و نزاع دوری کنم."],[15,"که را دانی از خسروان عجم","ز عهد فریدون و ضحاک و جم","هیچ کس از پادشاهان عجم از زمان‌های قدیم مانند فریدون، ضحاک و جم را نمی‌شناسد."],[15,"که بر تخت و ملکش نیامد زوال؟","نماند به جز ملک ایزد تعال","هیچ‌کس در دنیا وجود ندارد که سلطنت و قدرتش از بین نرود، به جز سلطنتی که خداوند به آن اراده کرده و جاودانه است."],[15,"که را جاودان ماندن امید ماند","چو کس را نبینی که جاوید ماند؟","امید جاودان ماندن برای چه کسی وجود دارد، در حالی که هیچ‌کس را نمی‌بینی که به‌طور دائمی باقی بماند؟"],[15,"که را سیم و زر ماند و گنج و مال","پس از وی به چندی شود پایمال","ثروت و دارایی مانند نقره و طلا و گنجی که انسان در دنیا جمع‌آوری می‌کند، بعد از مرگش چه زمانی باقی می‌ماند و در نهایت به دست کس دیگری می‌رسد و از آن او می‌شود."],[15,"وز آن کس که خیری بماند روان","دمادم رسد رحمتش بر روان","از کسی که خیری از او باقی بماند، رحمت و لطف او همیشه به روح‌ها می‌رسد."],[15,"بزرگی کز او نام نیکو نماند","توان گفت با اهل دل کاو نماند","اگر بزرگی باشد که نام نیکویی از او باقی نماند، می‌توان گفت او از اهل دل نیست و در حقیقت هیچ نمی‌ماند."],[15,"الا تا درخت کرم پروری","گر امیدواری کز او بر خوری","باید تا زمانی که درخت کرم‌پروری وجود دارد، امید خود را نسبت به آن حفظ کنی و از ثمرات خوبی که از آن می‌چیدی، بهره‌مند شوی."],[15,"کرم کن که فردا که دیوان نهند","منازل به مقدار احسان دهند","کرم و نیکوکاری کن، زیرا فردا که در روز قیامت اعمال را حسابرسی می‌کنند، مقام و منزلت هر کس بر اساس نیکوکاری‌اش تعیین خواهد شد."],[15,"یکی را که سعی قدم پیشتر","به درگاه حق، منزلت بیشتر","هر کس که در عبادت و کوشش برای خدا پیشتر و بیشتر تلاش کند، در نزد خداوند مقام و منزلت بالاتری خواهد داشت."],[15,"یکی باز پس خائن و شرمسار","بترسد همی مرد ناکرده کار","انسانی که خیانت کرده و شرمنده است، باید از عواقب کارهایش بترسد، زیرا مردانگی و شرافت او را به خاطر کارهای نکرده، زیر سؤال می‌برد."],[15,"بهل تا به دندان گزد پشت دست","تنوری چنین گرم و نانی نبست","نگذار تا دندان‌های تو پشت دست‌هات را گزمند، زیرا در گرمای تنور، نانی نمی‌پزی."],[15,"بدانی گه غله برداشتن","که سستی بود تخم ناکاشتن","باید بدانی که در زمان برداشت محصول، اگر در کاشت دانه‌ها سستی و اهمال کنی، محصول خوبی نخواهی داشت."],[16,"خردمند مردی در اقصای شام","گرفت از جهان کنج غاری مقام","مردی دانا در دوردست‌های شام، از دنیا در گوشه‌ای تاریک و غاری زندگی انتخاب کرده است."],[16,"به صبرش در آن کنج تاریک جای","به گنج قناعت فرو رفته پای","او در آن گوشه تاریک با صبر و شکیبایی خود به گنج قناعت و رضایت در زندگی دست یافته است."],[16,"شنیدم که نامش خدادوست بود","ملک سیرتی، آدمی پوست بود","شخصی به نام خدادوست بود که دارای ویژگی‌های نیکویی و شایسته‌ای است و از نظر اخلاقی و انسانی به شدت قابل احترام و خوش‌سیرت بود."],[16,"بزرگان نهادند سر بر درش","که در می‌نیامد به درها سرش","بزرگان در برابر در خانه او ایستادند و بر در زدن شروع کردند، اما او به هیچ‌وجه اجازه ورود هیچ‌کس را نمی‌داد."],[16,"تمنا کند عارف پاکباز","به دریوزه از خویشتن ترک آز","عارف زاهد و خالص، از خود درخواست می‌کند که به خاطر خویشتن، از خواسته‌هایش دست بکشد و عادت فقر و دریوزگی را پذیرا باشد."],[16,"چو هر ساعتش نفس گوید بده","به خواری بگرداندش ده به ده","هر زمان که نفس او را وسوسه کند و به ذلت و خواری وادار کند، او را از جایی به جای دیگر می‌کشاند."],[16,"در آن مرز کاین پیر هشیار بود","یکی مرزبان ستمکار بود","در آن ناحیه که آن پیر باهوش و دانا حضور داشت، یک مرزبان ستمگر هم وجود داشت."],[16,"که هر ناتوان را که دریافتی","به سرپنجگی پنجه برتافتی","هر ناتوانی که در برابر تو قرار می‌گرفت، به خاطر وحشی‌گری و قدرت خود او را به زیر می‌آوردی و نسبت به او بی‌رحم بودی."],[16,"جهان سوز و بی‌رحمت و خیره‌کش","ز تلخیش روی جهانی ترش","جهان به قدری سوزان، بی‌رحم و موجب درد و رنج است که تلخی آن، باعث می‌شود که بر چهره همه، غم و ناخوشی حس شود."],[16,"گروهی برفتند از آن ظلم و عار","ببردند نام بدش در دیار","گروهی از آن ظلم و ننگ فرار کردند و نام بد مرد ستمگر را در سرزمین خود بردند."],[16,"گروهی بماندند مسکین و ریش","پس چرخه نفرین گرفتند پیش","گروهی از مردم، که در فقر و سختی بودند، همچنان در آنجا باقی ماندند و با چهره‌ای پریشان و سرهایی با ریش‌های دراز، نفرت و دشنام به آن مرزبان ستمگر گفتند."],[16,"ید ظلم جایی که گردد دراز","نبینی لب مردم از خنده باز","هر جا ظلم و ستم زیادی ادامه پیدا کند، مردم دیگر نمی‌توانند لبخند بزنند و شاد باشند."],[16,"به دیدار شیخ آمدی گاه گاه","خدادوست در وی نکردی نگاه","تو بارها به ملاقات شیخ زاهد رفته‌ای، اما هر بار توجهی به او نکرده‌ای و او را نادیده گرفته‌ای."],[16,"ملک نوبتی گفتش: ای نیکبخت","به نفرت ز من در مکش روی سخت","ملک نوبتی به زاهد می‌گوید: ای نیکبخت، به خاطر نفرت از من، چهره‌ی سخت و عبوس به خود نکن."],[16,"مرا با تو دانی سر دوستی است","تو را دشمنی با من از بهر چیست؟","من با تو دوستی دارم، اما نمی‌دانم چرا تو با من دشمنی می‌کنی؟"],[16,"گرفتم که سالار کشور نیم","به عزت ز درویش کمتر نیم","فهمیدم که حاکم (سالار کشور) از لحاظ مقام و قدرت در جامعه، از درویش (شخصی فقیر و زاهد) کمتر نیست، اما از نظر احترام و اعتبار (عزت) بر او برتری دارد."],[16,"نگویم فضیلت نهم بر کسی","چنان باش با من که با هر کسی","من فضیلت یا برتری را بر کسی نمی‌گویم، جز بر کسی که با من مانند خودم باشد و به شرایط و ویژگی‌هایم نزدیک باشد."],[16,"شنید این سخن عابد هوشیار","بر آشفت و گفت: ای ملک، هوش دار","عابد با هوشیاری این سخن را شنید و ناراحت شد و به ملک (پادشاه) گفت که مراقب باشد."],[16,"وجودت پریشانی خلق از اوست","ندارم پریشانی خلق دوست","وجود تو باعث آشفتگی و پریشانی مردم است، اما من این پریشانی را بابت دوستی‌ام با تو نمی‌پذیرم."],[16,"تو با آن که من دوستم، دشمنی","نپندارمت دوستدار منی","با وجود اینکه من تو را دوست دارم، تو مرا به عنوان دشمن نپندار. در واقع، تو نیز دوست من هستی."],[16,"چرا دوست دارم به باطل منت","چو دانم که دارد خدا دشمنت؟","چرا به کسی که به ناحق منت می‌گذارد محبت کنم، وقتی می‌دانم که خداوند دشمن اوست؟"],[16,"مده بوسه بر دست من دوستوار","برو دوستداران من دوست دار","به کسی که دوستش می‌دارم، بوسه نده، بلکه با دوستان من که در دل دارم، دوست باش."],[16,"خدادوست را گر بدرند پوست","نخواهد شدن دشمن دوست، دوست","اگر خدای دوست را هم بزنند و آزار کنند، او هرگز به دشمنی با دوست نخواهد پرداخت."],[16,"عجب دارم از خواب آن سنگدل","که خلقی بخسبند از او تنگدل","متعجبم از خواب آن سنگدل، که مردم به خاطر ناز و فشار او خوابشان برهم خورده است."],[17,"مها زورمندی مکن با کهان","که بر یک نمط می‌نماند جهان","با سالخوردگان زورگویی نکن، زیرا دنیا بر یک حالت باقی نمی‌ماند و در تغییر است."],[17,"سر پنجه ناتوان بر مپیچ","که گر دست یابد برآیی به هیچ","بر روی سر پنجه ناتوان فشار نیاور، زیرا اگر یک روز به قدرت برسد ، به هیچ می رسی."],[17,"عدو را به کوچک نباید شمرد","که کوه کلان دیدم از سنگ خرد","نباید دشمن را کوچک شمرد، زیرا من کوه‌های بزرگ را از سنگ‌های کوچک دیده‌ام."],[17,"نبینی که چون با هم آیند مور","ز شیران جنگی برآرند شور","وقتی که مور و شیران جنگی در یکجا جمع می‌شوند، متوجه می‌شوی که مور هم می‌تواند جنب و جوش و شور خاصی ایجاد کند. این نشان می‌دهد که هرچند مور کوچک است، اما وقتی که با هم می‌آیند، می‌توانند تأثیرگذار باشند."],[17,"نه موری که مویی کز آن کمتر است","چو پر شد ز زنجیر محکمتر است","اگرچه مور در اندازه و حجم از مو کوچک‌تر است، اما وقتی که به زنجیر خویش وابسته شود، به خاطر اتحاد و جمعیتش قوی‌تر و محکم‌تر از مو خواهد بود."],[17,"مبر گفتمت پای مردم ز جای","که عاجز شوی گر درآیی ز پای","مبادا بگویید افرادی را که از پایشان زمین‌گیر شده‌اند، از مکان خود بلند کنید، زیرا اگر خودتان عاجز شوید، در آن موقع به سختی می‌توانید از جا بلند شوید."],[17,"دل دوستان جمع بهتر که گنج","خزینه تهی به که مردم به رنج","دل دوستان و همراهان را بهتر است که جمع کنی و حفظ کنی، چرا که داشتن یک دل شاد و صمیمی از داشتن پول و دارایی بسیار ارزشمندتر است، حتی اگر آن دارایی خالی باشد."],[17,"مینداز در پای کار کسی","که افتد که در پایش افتی بسی","به کسی که در کار دیگری سقوط می‌کند، خود را نینداز زیرا اگر تو هم در آن کار بیفتی، دردسرهای زیادی برایت به وجود می‌آید."],[17,"تحمل کن ای ناتوان از قوی","که روزی تواناتر از وی شوی","تحمل کن، ای ضعیف، در برابر قوی، زیرا ممکن است روزی تو از او قوی‌تر شوی."],[17,"به همت برآر از ستیهنده شور","که بازوی همت به از دست زور","با تلاش و اراده می‌توان از کسانی که به انسان آسیب می‌زنند، پیروزی و شوری به‌دست آورد؛ زیرا قدرت اراده و همت از نیروی بدنی و زور مهم‌تر است."],[17,"لب خشک مظلوم را گو بخند","که دندان ظالم بخواهند کند","به مظلوم که لبش خشک و بی‌طراوت است، بگو بخند تا شاید با این خوشحالی، دندان‌های ظالم را از او بگیرد و از آزار او کم کند."],[17,"به بانگ دهل خواجه بیدار گشت","چه داند شب پاسبان چون گذشت؟","خواجه به خاطر صدای دهل بیدار شد، اما او نمی‌داند که پاسبان در طول شب چه اتفاقاتی را دیده و چگونه شب را گذرانده است."],[17,"خورد کاروانی غم بار خویش","نسوزد دلش بر خر پشت ریش","کاروان غم بار خودش را میخورد و دلش به حال خرش که پشتش زخم شده نمی‌سوزد"],[17,"گرفتم کز افتادگان نیستی","چو افتاده بینی چرا نیستی؟","من متوجه شدم که افرادی که در زندگی به سختی می‌افتند، معمولا تسلیم می‌شوند و خود را بی‌اراده و بی‌حس می‌پندارند. حال اگر خودت را به‌جای آنها بگذاری و وضعیت آنان را ببینی، چرا نباید در برابر مشکلات مقاومت کنی و تسلیم نشوی؟"],[17,"بر اینت بگویم یکی سرگذشت","که سستی بود زین سخن درگذشت","من می‌خواهم داستانی را برایت بگویم درباره‌ی فردی که به خاطر سستی و بی‌توجهی‌اش به این سخن، از زندگی عقب ماند."],[18,"چنان قحط سالی شد اندر دمشق","که یاران فراموش کردند عشق","در دمشق چنان خشکسالی و قحطی شدیدی روی داد که عاشقان و دوستان، عشق و محبت را از یاد بردند (رنج گرسنگی جایی برای عشق باقی نگذاشت)"],[18,"چنان آسمان بر زمین شد بخیل","که لب تر نکردند، زرع و نخیل","آسمان چنان از باریدن خست ورزید که زمین‌های کشاورزی و نخلستان‌ها حتی قطره‌ای آب ننوشیدند و کاملا خشک شدند"],[18,"بخوشید سرچشمه‌های قدیم","نماند آب، جز آب چشم یتیم","چشمه‌های کهنسال و جوشان خشکیدند و در سراسر شهر آبی نماند، مگر اشک روان از چشمان یتیمان."],[18,"نبودی به‌جز آه بیوه زنی","اگر بر شدی دودی از روزنی","اگر از شکاف یا دودکش خانه‌ای دودی بالا می‌رفت، حاصل آتش و پخت‌وپز نبود؛ بلکه آه سوزناک زنی بیوه و درمانده بود."],[18,"چو درویش بی‌رنگ دیدم درخت","قوی بازوان، سست و درمانده سخت","درختان مانند فقیران زردچهره، بی‌برگ‌وبار و رنگ‌پریده شده بودند؛ و حتی پهلوانان و افراد نیرومند نیز از گرسنگی سست، ناتوان و به‌شدت درمانده گشته بودند."],[18,"نه در کوه سبزی نه در باغ شخ","ملخ بوستان خورده، مردم ملخ","نه در کوهستان سبزی و گیاهی روییده بود و نه در باغ‌ها شاخه و درختی برجا مانده بود؛ ملخ‌ها باغ و بوستان را خورده بودند و مردم نیز از شدت قحطی، به خوردن ملخ روی آورده بودند."],[18,"در آن حال، پیش آمدم دوستی","از او مانده بر استخوان، پوستی","در آن اوضاع سخت، یکی از دوستانم به دیدارم آمد که از شدت نحیفی و رنج، فقط پوستی بر استخوان‌هایش باقی مانده بود."],[18,"وگرچه به مکنت، قوی حال بود","خداوند جاه و زر و مال بود","این در حالی بود که او از توانایی مالی بالایی برخوردار بود و صاحب ثروت، مقام، طلا و دارایی بسیار بود."],[18,"بدو گفتم: ای یار پاکیزه‌خوی","چه درماندگی پیشت آمد؟ بگوی","به او گفتم: ای دوست نیک‌سرشت و پاک‌نهاد من! برایم بگو که چه رنج و ناتوانی‌ای بر تو عارض شده که به این حال افتاده‌ای؟"],[18,"بغرّید بر من، که عقلت کجاست؟","چو دانیّ و پرسی، سؤالت خطاست","با تندی و اعتراض بر من خروشید که: عقلت کجاست؟ وقتی وضعیت را می‌بینی و حقیقت را می‌دانی، پرسیدنت نادرست و بی‌جاست."],[18,"نبینی که سختی به غایت رسید؟","مشقّت به حدّ نهایت رسید؟","آیا نمی‌بینی که سختی روزگار به اوج خود رسیده و رنج و گرفتاری مردم بی‌نهایت شده است؟"],[18,"نه باران همی آید از آسمان","نه بر می‌رود، دود فریادخوان","نه باران رحمتی از آسمان می‌بارد، و نه فریاد و ناله دادخواهان به جایی می‌رسد تا گرهی گشوده شود."],[18,"بدو گفتم: آخر تو را باک نیست","کشد زهر، جایی که تریاک نیست","به او گفتم: تو چرا نگران و هراسانی؟ تو که ثروت داری! زهر فقط کسی را از پا درمی‌آورد که پادزهر (تریاک) نداشته باشد؛ تو که چاره و توان مالی داری چرا رنج می‌کشی؟"],[18,"گر از نیستی دیگری شد هلاک","تو را هست، بط را ز طوفان چه باک؟","اگر دیگران از فقر و بی‌پولی از بین می‌روند، تو ثروتمندی؛ مرغابی (بط) را از سیلاب و طوفان چه ترسی است؟"],[18,"نگه کرد رنجیده در من فقیه","نگه کردن عالم اندر سفیه","آن مرد دانا و اهل بینش با دلخوری و رنجیدگی به من نگریست؛ همانند نگاه سرزنش‌آمیزی که دانشمندی به فردی نادان و بی‌خرد می‌اندازد."],[18,"که مرد ارچه بر ساحل است، ای رفیق","نیاساید و دوستانش غریق","و گفت: ای دوست! انسان باانصاف و بافتوت، حتی اگر خودش در ساحل امن باشد، وقتی غرق شدن یاران و همنوعانش را ببیند، هرگز آرام و قرار نمی‌گیرد."],[18,"من از بینوایی نیم روی زرد","غم بینوایان، رخم زرد کرد","چهره زرد و تکیده من ناشی از فقر و تنگدستی خودم نیست؛ بلکه غصه و دردی که برای فقیران و مستمندان می‌خورم، رخسارم را زرد کرده است."],[18,"نخواهد که بیند خردمند، ریش","نه بر عضو مردم، نه بر عضو خویش","انسان عاقل و اهل خرد هرگز نمی‌تواند زخمی را تحمل کند؛ چه آن زخم بر تن دیگران باشد و چه بر تن خودش."],[18,"یکی اول از تندرستان منم","که ریشی ببینم بلرزد تنم","من نخستین تندرستی هستم که هرگاه زخمی بر پیکر دیگری ببینم، تمام بدنم از درد و اندوه به لرزه می‌افتد."],[18,"منغّص بود عیش آن تندرست","که باشد به پهلوی بیمار سست","خوشی و آرامش آن شخص سالمی که در کنار بیماری رنجور و ناتوان قرار دارد، تلخ، ناگوار و تباه می‌شود."],[18,"چو بینم که درویش مسکین نخورد","به کام اندرم، لقمه زهر است و درد","هنگامی که می‌بینم فرد نیازمند و مسکینی گرسنه مانده، هر لقمه‌ای که در دهان می‌گذارم برایم مانند زهر و درد جانکاه است."],[18,"یکی را به زندان درش دوستان","کجا ماندش، عیش در بوستان؟","کسی که دوستان و نزدیکانش در سیاه‌چال و زندان گرفتار باشند، چگونه ممکن است از گردش و تفریح در باغ و گلزار لذت ببرد؟"],[19,"شبی دود خلق آتشی برفروخت","شنیدم که بغداد نیمی بسوخت","شنیده‌ام که یک‌شب دود اجاق های مردم آتش سوزی به پا کرد و نیمی از شهر بغداد داشت می‌سوخت."],[19,"یکی شکر گفت اندران خاک و دود","که دکان ما را گزندی نبود","در آن ویرانی و آتش‌، یک نفر گفت: «خدا را شکر که دکان ما صدمه ندید»"],[19,"جهاندیده‌ای گفتش ای بوالهوس","تو را خود غم خویشتن بود و بس؟","آدم باتجربه‌ای به‌او گفت ای خام‌اندیش، آیا تو فقط در فکر خود هستی و بس؟"],[19,"پسندی که شهری بسوزد به نار","اگر چه سرایت بود بر کنار؟","آیا تو می‌پسندی که شهری در آتش بسوزد‌، اما خانه‌ات در امان باشد؟"],[19,"به جز سنگدل ناکند معده تنگ","چو بیند کسان بر شکم بسته سنگ","به جز آدم بی‌رحم، سیر نمی‌خورد وقتی‌که دیگران را گرسنه و تهی‌دست می‌بیند."],[19,"توانگر خود آن لقمه چون می‌خورد‌؟","چو بیند که درویش خون می‌خورد؟","آدم دارا و ثروتمند چگونه غذا می‌خورد وقتی که می‌بیند آدم فقیر، در غم و درد است؟"],[19,"مگو تندرست است رنجور‌دار","که می‌پیچد از غصه رنجوروار","مگو آدم بیماردار تندرست و سالم است؛ زیرا او (نیز همچون بیمار) دچار درد و غم است."],[19,"تنکدل چو یاران به منزل رسند","نخسبد که واماندگان از پسند","آدم مهربان وقتی‌که خود و همراهانش به‌مقصد می‌رسند برای کسانی‌که هنوز در راه مانده‌اند، نگران است."],[19,"دل پادشاهان شود بارکش","چو بینند در گل خر خارکش","پادشاهان غمگین می‌شوند وقتی‌که می‌بینند خارکش‌ها دچار مشکل شده و غمگین هستند."],[19,"اگر در سرای سعادت کس است","ز گفتار سعدیش حرفی بس است","اگر کسی نیک‌بخت و سعادتمند است، یک پند سعدی را به‌کار بگیرد برای او کافی‌است."],[19,"همینت بسنده‌ست اگر بشنوی","که گر خار کاری سمن ندروی","همین یک پند برای تو کافی است اگر به‌کار ببری؛ «اگر خار بکاری، گل و ریحان نخواهی دید» ( و اگر رنج و درد درست کنی، شادی و خوشی نخواهی‌یافت)"],[20,"خبرداری از خسروان عجم","که کردند بر زیردستان ستم؟","آیا خبر داری که پادشاهان عجم چگونه بر رعیت و زیر دستان خود ظلم و ستم کردند؟"],[20,"نه آن شوکت و پادشایی بماند","نه آن ظلم بر روستایی بماند","نه عظمت و قدرت پادشاهی باقی می‌ماند و نه ظلمی که بر مردم ضعیف روا داشته شده است."],[20,"خطا بین که بر دست ظالم برفت","جهان ماند و با او مظالم برفت","ببین که چگونه دنیا به دست ظالم خراب شد، اما در عوض، بیدادگری‌ها و ظلم‌ها از بین رفتند."],[20,"خنک روز محشر تن دادگر","که در سایه عرش دارد مقر","در روز قیامت، خوشحال و خرسند است کسی که در دنیا به دادگری رفتار کرده و در سایه عرش خداوند جایگاه محفوظ و محترمی دارد."],[20,"به قومی که نیکی پسندد خدای","دهد خسروی عادل و نیک‌رای","خداوند به گروهی که نیکی و خوبی را دوست دارند، سلطنتی عادل و دارای مشورت و تدبیر ارزانی می‌دارد."],[20,"چو خواهد که ویران شود عالمی","کند ملک در پنجه ظالمی","هرگاه که بخواهد عالمی خراب شود، ملک در دست یک ظالم قرار می‌گیرد."],[20,"سگالند از او نیکمردان حذر","که خشم خدای است بیدادگر","نیکمردان (خوبان) باید از او (ظالم) دوری کنند، زیرا خشم خدا بر بیدادگر می‌افتد."],[20,"بزرگی از او دان و منّت شناس","که زایل شود نعمت ناسپاس","بزرگی و بزرگواری را از او بدان و قدردانی کن، زیرا نعمت و财富ی که ناشی از ناسپاسی باشد، از بین می‌رود."],[20,"اگر شکر کردی بر این ملک و مال","به مالی و ملکی رسی بی‌زوال","اگر بر این نعمت‌ها و ثروت‌های خود شاکر باشی و قدردان آن‌ها، به دارایی و قدرتی پایدار و دائمی خواهی رسید."],[20,"وگر جور در پادشایی کنی","پس از پادشایی گدایی کنی","اگر در حکومت خود ظلم و بی‌عدالتی را پیشه کنی، پس از آن به وضعی خواهی رسید که مجبور به گدایی و فقر می‌شوی."],[20,"حرام است بر پادشه خواب خوش","چو باشد ضعیف از قوی بارکش","پادشاه حق ندارد در حالی که ضعیف‌تر از خود را تحت فشار قرار داده، خواب راحت داشته باشد. اگر او باعث شود که فرد ضعیف از عهده بار و مسئولیت‌های خود برنیاید، باید نگران باشد."],[20,"میازار عامی به یک خردله","که سلطان شبان است و عامی گله","آزار نرسان به مردم عادی حتی به اندازه یک دانه، زیرا که پادشاه (سلطان) مانند شبان است و مردم عادی مانند گله او هستند."],[20,"چو پرخاش بینند و بیداد از او","شبان نیست، گرگ است، فریاد از او","وقتی که مردم از او پرخاش و ظلم ببینند، او دیگر شبان نیست بلکه گرگ است که تنها فریاد و ش."],[20,"بد انجام رفت و بد اندیشه کرد","که با زیردستان جفا، پیشه کرد","آن کس که راه بد رفت و در فکر بد بود، همان کسی است که با زیردستان خود، ستم و بیداد را پیشه خود ساخت."],[20,"به سختی و سستی بر این بگذرد","بماند بر او سالها نام بد","این روزگار به هر سختی و آسونی بلاخره میگذره، در نهایت سال‌ها نام نیکی نخواهد داشت و نامش به بدی خواهد ماند."],[20,"نخواهی که نفرین کنند از پست","نکو باش تا بد نگوید کست","اگر نمی‌خواهی که دیگران تو را نفرین کنند و از تو بد بگویند، باید رفتار نیکو داشته باشی تا کسی نتواند درباره‌ات حرف بدی بزند."],[21,"شنیدم که در مرزی از باختر","برادر دو بودند از یک پدر","در سرزمینی در شمال غرب، دو برادر بودند که هر دو فرزند یک پدر بودند."],[21,"سپهدار و گردن کش و پیلتن","نکو روی و دانا و شمشیر زن","برادران، یکی از آن‌ها سپهداری (فرمانده‌ای) شجاع و قدرتمند، و دیگری گردن‌کشی (جبار و ظالم) است. هر دو از نظر ظاهر زیبا و خوش‌سیما هستند و در جنگ و نبرد نیز دارای مهارت و دانایی هستند."],[21,"پدر هر دو را سهمگین مرد یافت","طلبکار جولان و ناورد یافت","پدر هر دو برادر، مردی قوی و تنومند و جنگجو را دید که طلبکار و مدعی بود و در میدان نبرد حاضر بود."],[21,"برفت آن زمین را دو قسمت نهاد","به هر یک پسر، زآن نصیبی بداد","پدر آن زمین را به دو قسمت تقسیم کرد و به هر یک از پسرانش یک سهم داد."],[21,"مبادا که بر یکدگر سر کشند","به پیکار شمشیر کین برکشند","مبادا که پس از مرگ پدر بر یکدیگر سرکشی کنند و از روی حرص و طمع سرزمین و حکومت با هم بجنگند"],[21,"پدر بعد از آن، روزگاری شمرد","به جان آفرین جان شیرین سپرد","پدر پس از آن، مدت زمانی را حساب کرد و جان شیرینش را به جان‌آفرین، یعنی خدا، سپرد."],[21,"اجل بگسلاندش طناب امل","وفاتش فرو بست دست عمل","مرگ، امید و آرزوهای او را قطع کرد و سرانجام، کارهای او منجر به مرگش شد."],[21,"مقرر شد آن مملکت بر دو شاه","که بی حد و مر بود گنج و سپاه","در آن سرزمین، دو پادشاه مقرر شد که هرکدام بدون حد و مرز ثروت و نیرو داشته بودند."],[21,"به حکم نظر در به‌افتاد خویش","گرفتند هر یک، یکی راه پیش","بر اساس نظر و قضاوت خویش، هر یک از آن دو شاه تصمیم گرفتند که راهی را انتخاب کنند."],[21,"یکی عدل تا نام نیکو برد","یکی ظلم تا مال گرد آورد","یکی از برادران با عدل و انصاف نام نیکو به دست می‌آورد، در حالی که دیگری با ظلم و ستم فقط مال و ثروت جمع می‌کند."],[21,"یکی عاطفت سیرت خویش کرد","درم داد و تیمار درویش خورد","یکی از برادران ظالم، به جای محبت و نیکی، فقط به فکر جمع‌کردن مال بود، اما برادر دیگر با مهربانی و عطوفت، به فقرا کمک کرده و از مال خود برای پرورش آن‌ها استفاده کرد."],[21,"بنا کرد و نان داد و لشکر نواخت","شب از بهر درویش، شبخانه ساخت","او (آدم عادل) خانه‌ای بنا کرد و به درویش نان داد و شب را برای او شب‌نشینی ترتیب داد."],[21,"خزاین تهی کرد و پر کرد جیش","چنان کز خلایق به هنگام عیش","او (حاکم یا ستمگری که در بیت پیشین صحبت شده) خزانه‌های خود را خالی کرد و مخارج کرد تا به مردم در زمان خوشی و جشن، بی‌دردسر نان و ایثار کند."],[21,"برآمد همی بانگ شادی چو رعد","چو شیراز در عهد بوبکر سعد","صدای شادی به‌گونه‌ای بلند و پررنگ به گوش می‌رسد که مانند صدای رعد است و این شادی یادآور ایام خوش شیراز در زمان بوبکر سعد (نخستین حاکم شیراز) است."],[21,"خدیو خردمند فرخ نهاد","که شاخ امیدش برومند باد","خداوندی که داناست و خیرخواه است، آرزویش این است که امید او همیشه استوار و پایدار باشد."],[21,"حکایت شنو کان گو نامجوی","پسندیده پی بود و فرخنده خوی","داستانی را بشنو که درباره نام‌جویانی است که دارای صفات پسندیده و خوش‌بختی هستند."],[21,"ملازم به دلداری خاص و عام","ثناگوی حق بامدادان و شام","دولت و موقعیت خوب باید به همراه حمایت و دلجویی از همه مردم باشد، به‌طوری‌که همگان در روز و شب از او تعریف و ستایش کنند."],[21,"در آن ملک قارون برفتی دلیر","که شه دادگر بود و درویش سیر","در آن سرزمین که قارون، ثروتمند و حکم‌ران ظالم، زندگی می‌کرد، مردی دلیر و شجاع به قدرت رسید که پادشاهی عادل و بخشنده بود و به نیازمندان رسیدگی می‌کرد."],[21,"نیامد در ایام او بر دلی","نگویم که خاری که برگ گلی","در زمان او هیچ کس به دلش نرسید که گلی در آنجا بروید، مانند یک خاری که از یک گل به وجود آمده باشد."],[21,"سرآمد به تأیید ملک از سران","نهادند سر بر خطش سروران","به تأیید پادشاهی، بزرگان و سران به فرمان او سر بر زمین نهادند و تسلیم شدند."],[21,"دگر خواست کافزون کند تخت و تاج","بیافزود بر مرد دهقان خراج","سلطان خواست تا قدرت و ثروتش را بیشتر کند و به همین دلیل، مالیات بیشتری بر دهقان (کشاورز) وضع کرد."],[21,"طمع کرد در مال بازارگان","بلا ریخت بر جان بیچارگان","عاشق مال و سرمایه‌ی یک تاجر شد و بر جان آدم‌های بیچاره بلا و مشکل نازل کرد."],[21,"به امید بیشی نداد و نخورد","خردمند داند که ناخوب کرد","خردمند می‌داند که کسی که به امید سود بیشتر، چیزی را ندهد و نگیرد، در واقع کار خوبی نکرده است."],[21,"که تا جمع کرد آن زر از گربزی","پراکنده شد لشکر از عاجزی","وقتی آن شخص تمامی آن طلا را از زمین جمع کرد، سپاه (ارتش) به دلیل ناتوانی و ضعف خود پراکنده شد."],[21,"شنیدند بازارگانان خبر","که ظلم است در بوم آن بی‌هنر","بازرگانان از ظلمی که بر مردم نادان و بی‌هنر در سرزمینشان رفته، آگاه شدند."],[21,"بریدند از آنجا خرید و فروخت","زراعت نیامد، رعیت بسوخت","بازרگانان از آن سرزمین رفتند و خرید و فروش پایان یافت. کشاورزی در آنجا رونق نداشت و مردم زحمت‌کش به سختی افتادند."],[21,"چو اقبالش از دوستی سر بتافت","به ناکام دشمن بر او دست یافت","زمانی که اقبال و خوش‌شانسی او به دوستی از دست رفت، دشمن ناکامش به او دسترسی پیدا کرد و بر او چیره شد."],[21,"ستیز فلک بیخ و بارش بکند","سم اسب دشمن دیارش بکند","ناملایمات و سختی‌های زندگی باعث می‌شود که دشمنی بر او تسلط پیدا کند و به خانه‌اش آسیب برساند."],[21,"وفا در که جوید چو پیمان گسیخت؟","خراج از که خواهد چو دهقان گریخت؟","وفا را از چه کسی باید جستجو کرد وقتی که پیمان شکسته شده باشد؟ و خراج (مالیات) را از چه کسی می‌توان طلب کرد وقتی که کشاورز (دهقان) فرار کرده باشد؟"],[21,"چه نیکی طمع دارد آن بی‌صفا","که باشد دعای بدش در قفا؟","کسی که نیتش به خوبی نیست و به دیگران بی‌وفا و دورو است، چگونه می‌تواند به خیر و نیکی امید داشته باشد در حالی که دعاهای بد او پشت سرش وجود دارد؟"],[21,"چو بختش نگون بود در کاف کن","نکرد آنچه نیکانش گفتند کن","چون بخت او خراب بود، به حرف‌های نیکانش توجه نکرد و کاری نکرد که آن‌ها می‌گفتند."],[21,"چه گفتند نیکان بدان نیکمرد؟","تو برخور که بیدادگر بر نخورد","نیکان به آن مرد نیکو گفتند چه باید کرد، حالا تو باید توجه کنی که بیدادگران به نتیجه‌ای نمی‌رسند."],[21,"گمانش خطا بود و تدبیر سست","که در عدل بود آنچه در ظلم جست","او فکر می‌کرد که تدبیرش درست است، ولی این تصورش اشتباه بود و این درک سست باعث شده بود که در کار عدالت چیزی را نادیده بگیرد و به دنبال ظلم برود."],[21,"یکی بر سر شاخ، بن می‌برید","خداوند بستان نگه کرد و دید","مردی که بر بالای درخت نشسته و شاخه‌ای را که بر روی آن نشسته بریده، در واقع خود را به خطر می‌اندازد. خداوند بستان، یعنی خالق و مدیر جهان، این وضعیت را مشاهده می‌کند."],[21,"بگفتا گر این مرد بد می‌کند","نه با من که با نفس خود می‌کند","او (شخصی که مورد اشاره است) می‌گوید اگر این مرد کردار بدی انجام می‌دهد، این کار نه تنها به من آسیب می‌زند، بلکه در حقیقت به روح و نفس خودش ضرر می‌زند."],[21,"نصیحت بجای است اگر بشنوی","ضعیفان میفکن به کتف قوی","اگر نصیحتی وجود دارد، خوب است که آن را بشنوی. ضعیفان را نباید به دوش قویان بیندازی و از آنها انتظار داشته باشی که بار دشواری را تحمل کنند."],[21,"که فردا به داور برد خسروی","گدایی که پیشت نیرزد جوی","فردا در پیشگاه داور (خدا) پادشاهی خواهی آمد که ارزشش به اندازه یک گدا است و نشان می‌دهد که در دنیا، مقام و ثروت واقعی مهم نیستند."],[21,"چو خواهی که فردا بوی مهتری","مکن دشمن خویشتن، کهتری","اگر می‌خواهی فردا مقامی بلند مرتبه و با احترام داشته باشی، هرگز با دشمنی خود بر نیایی و به پستی و فرومایگی نپردازی."],[21,"که چون بگذرد بر تو این سلطنت","بگیرد به قهر آن گدا دامنت","اگر زمانی سلطنت و قدرت به تو برسد، باید بدانید که به زودی آن گدا (فقر و بیچارگی) به قهر و زور دامان تو را خواهد گرفت."],[21,"مکن، پنجه از ناتوانان بدار","که گر بفکنندت شوی شرمسار","با ناتوانان به خشونت و قساوت رفتار نکن، چون اگر آن‌ها تو را شکست دهند، باعث شرمساری تو خواهد شد."],[21,"که زشت است در چشم آزادگان","بیافتادن از دست افتادگان","برای آزادگان ناپسند و زشت است که از دست ناتوانان بیفتند و سقوط کنند."],[21,"بزرگان روشندل نیکبخت","به فرزانگی تاج بردند و تخت","بزرگان با بصیرت و خوش‌اقبال به دلیل حکمت و دانایی خود، مقام و جایگاهی برجسته و ارجمند کسب کرده‌اند."],[21,"به دنباله راستان کج مرو","وگر راست خواهی ز سعدی شنو","به دنبال افراد درستکار و راست‌کردار برو و اگر می‌خواهی همیشه درست زندگی کنی، به سخنان سعدی گوش کن."],[22,"مگو جاهی از سلطنت بیش نیست","که ایمن‌تر از ملک درویش نیست","فکر نکن مقام و جایگاهی بالاتر از پادشاهی وجود ندارد، چرا که زندگی درویشان و کسانی که از متعلقات دنیوی دل کنده‌اند، از آن بالاتر و آسوده‌تر است."],[22,"سبکبار مردم سبک‌تر روند","حق این است و صاحبدلان بشنوند","کسانی که مسئولیت کمتری دارند و آسوده و فارغ از امور دنیوی هستند، در آخرت سوال و جواب کمتری هم دارند. واقعیت و حق همین است و کسانی که صاحب تفکر هستند، آنرا درک می‌کنند."],[22,"تهیدست تشویش نانی خورد","جهانبان به قدر جهانی خورد","فقیر غم تهیه تکه‌ای نان را میخورد درحالیکه یک پادشاه بیش از اندازه غذا برای خوردن دارد."],[22,"گدا را چو حاصل شود نان شام","چنان خوش بخسبد که سلطان شام","گدا زمانیکه نان شبش تهیه می‌شود، چنان آسوده می‌خواد که انگار پادشاه سرزمین شام است و فرقی با پادشاه ندارد."],[22,"غم و شادمانی به سر می‌رود","به مرگ این دو از سر به در می‌رود","غم‌ها و شادی‌های زندگی گذرا هستند و با مرگ هر دو تمام می‌شوند."],[22,"چه آن را که بر سر نهادند تاج","چه آن را که بر گردن آمد خراج","تفاوتی نیست بین کسی که پادشاه است و بر سرش تاج گذاشته‌اند با کسی که بدهکار است و مالیات و بدهی بر گردن اوست."],[22,"اگر سرفرازی به کیوان بر است","وگر تنگدستی به زندان در است","چه آنقدر ثروتمند باشد و به جایگاهی بالاتر از سیاره زحل رسیده باشد؛ چه فقیر و تنگدستی باشد که در زندان گرفتار شده باشد."],[22,"چو خیل اجل بر سر هر دو تاخت","نمی شاید از یکدگرشان شناخت","زمانی که مرگ فرا می‌رسد، همه را با خود می‌برد و آنجاست که غنی و فقیر با هم تفاوتی ندارند و قابل تشخیص نیست چه کسی ثروتمند بوده و چه کسی تهی‌دست."],[23,"شنیدم که یک بار در حله‌ای","سخن گفت با عابدی کله‌ای","شنیدم که یک بار در شهر حله، شخصی با عابدی در موردی صحبت کرده است."],[23,"که من فر فرماندهی داشتم","به سر بر کلاه مهی داشتم","من در مقام فرماندهی بودم و بر سر خود کلاهی از نخود داشتم."],[23,"سپهرم مدد کرد و نصرت وفاق","گرفتم به بازوی دولت عراق","من از آسمان یاری و پیروزی دریافت کردم و با کمک قدرت دولت عراق به موفقیت رسیدم."],[23,"طمع کرده بودم که کرمان خورم","که ناگه بخوردند کرمان سرم","امید داشتم که به نعمت و ثروت کرمان دست یابم، اما ناگهان به مشکلات و مصائب بزرگ دچار شدم."],[23,"بکن پنبه غفلت از گوش هوش","که از مردگان پندت آید به گوش","غفلت را کنار بگذار و هوشیار باش، زیرا ممکن است از پیام‌های مردگان برای تو درس‌هایی بیاید."],[24,"نکوکار مردم نباشد بدش","نورزد کسی بد که نیک افتدش","آدم نیکوکار، بدی نمی‌کند؛ کسی که نیک‌بخت است، بدی نمی‌کند."],[24,"شر انگیز هم بر سر شر شود","چو کژدم که با خانه کمتر شود","آدم بدکار و شرّ هم به‌دنبال بدی است همچون عقرب که کمتر در خانه خود می‌ماند (و در بیرون به‌دنبال شرّ و نیش زدن است)"],[24,"اگر نفع کس در نهاد تو نیست","چنین گوهر و سنگ خارا یکی است","اگر به‌دنبال نیکی و خیر رساندن به‌دیگران نیستی‌، بدان که گوهر ‌(ذات) تو مانند سنگ خارا بی‌ارزش است."],[24,"غلط گفتم ای یار شایسته خوی","که نفع است در آهن و سنگ و روی","ای دوست گرامی و نیک‌خو، اشتباه گفتم زیرا در آهن و سنگ خارا و روی هم منفعت هست."],[24,"چنین آدمی مرده به ننگ را","که بر وی فضیلت بود سنگ را","ننگ چنین آدمی مرده باشد بهتر است زیرا سنگ هم از او بهتر است."],[24,"نه هر آدمی زاده از دد به است","که دد ز آدمی زاده بد به است","چنین نیست که هر آدمیزادی از حیوان بهتر باشد؛ حیوانات از آدمی‌زاده بد و بدکار بهترند."],[24,"به است از دد انسان صاحب خرد","نه انسان که در مردم افتد چو دد","انسان دانا و خردمند از حیوان بهتر است‌، نه آن انسان که همچون حیوانات وحشی به‌مردم حمله می‌کند و صدمه می‌زند."],[24,"چو انسان نداند به جز خورد و خواب","کدامش فضیلت بود بر دواب؟","اگر انسان بجز خوردن و خوابیدن چیزی نداند؛ چه فضیلت و برتری نسبت به چهارپایان دارد؟"],[24,"سوار نگون بخت بی راهرو","پیاده برد ز او به رفتن گرو","سوار بدبختی که اسب دارد، اما ایستاده است؛ آدم پیاده از او پیشی می‌گیرد. (یعنی آدمی باید از عقل و خرد خود بهره ببرد)"],[24,"کسی دانه نیکمردی نکاشت","کز او خرمن کام دل برنداشت","کسی نبوده که جوانمردی و نیکوکاری کند و از آن بهرمند و شادکام نشده‌باشد."],[24,"نه هرگز شنیدیم در عمر خویش","که بدمرد را نیکی آمد به پیش","همچنین در عمر خود نشنیده‌ام که آدم بد، سرانجام خوبی داشته‌باشد."],[25,"گزیری به چاهی در افتاده بود","که از هول او شیر نر ماده بود","داروغه ایی در یک چاهی چنان وحشتناک گرفتار شده بود که از ترسش ، شیر نر ماده میشد."],[25,"بداندیش مردم به جز بد ندید","بیافتاد و عاجزتر از خود ندید","آدم بداندیش و بد ذات همیشه بدی خواهد دید و در آخر از خودشان ناتوان‌تر کسی را نمی‌یابد."],[25,"همه شب ز فریاد و زاری نخفت","یکی بر سرش کوفت سنگی و گفت:","در شب به خاطر فریاد و گریه نتوانست بخوابد، یکی بر سرش سنگی زد و گفت:"],[25,"تو هرگز رسیدی به فریاد کس","که می‌خواهی امروز فریادرس؟","تو هرگز به کسی کمک کردی که حالا از دیگران کمک میخواهی؟"],[25,"همه تخم نامردمی کاشتی","ببین لاجرم بر که برداشتی","هیچ گاه مردم داری نکردی، حالا نتیجه‌اش را ببین و ببین که چی به دست آورده‌ای."],[25,"که بر جان ریشت نهد مرهمی","که دلها ز ریشت بنالد همی؟","چه کسی باید درد تو را درمان کند، در حالی که تو بر دل همگان زخم زدی"],[25,"تو ما را همی چاه کندی به راه","به سر لاجرم در فتادی به چاه","تو بر سر راه ما چاه کندی، ولی خودت با سر در چاه افتادی"],[25,"دو کس چه کنند از پی خاص و عام","یکی نیک‌محضر، دگر زشت‌نام","دو گروه هستند که برای مردم چاه میکنند، آدم‌های خوب و دیگری بدنامان"],[25,"یکی تشنه را تا کند تازه حلق","دگر تا به گردن در افتند خلق","یکی چاه را برای سیراب کردن مردم می‌کند و آن دیگری برای گرفتار کردن مردم"],[25,"اگر بد کنی چشم نیکی مدار","که هرگز نیارد گز انگور بار","اگر بدی کردی، چشم نیکوکاری نداشته باش چرا که درخت گز ، انگور نمی‌دهد"],[25,"نپندارم ای در خزان کشته جو","که گندم ستانی به وقت درو","فکر نکنم کسی که در پاییز جو کاشته، بتواند زمان درو گندم برداشت کند"],[25,"درخت زقوم ار به جان پروری","مپندار هرگز کز او بر خوری","وقتی درون جانت را پر از تلخی و پلیدی و بدخواهی (مانند زقوم) کردی، چشم نتیجه خوب از آن را نداشته باش."],[25,"رطب ناورد چوب خرزهره بار","چو تخم افکنی، بر همان چشم دار","درخت خرزهره به تو خرمای شیرین نمی‌دهد. پس مراقب باش که چه می‌کاری، چون همان را برداشت خواهی کرد."],[26,"حکایت کنند از یکی نیکمرد","که اکرام حجاج یوسف نکرد","می‌گویند از مردی خوب که به حجاج یوسف احترام نگذاشت."],[26,"به سرهنگ دیوان نگه کرد تیز","که نطعش بیانداز و خونش بریز","او به سرهنگ دیوان (مسئولان و کارگزاران حجاج یوسف) نگاه تند و تیزی کرد و فرمان داد که برایش یک پرده (دستگاه قضاوت) بیندازند و خون او (نیکمرد) را بریزند."],[26,"چو حجت نماند جفا جوی را","به پرخاش در هم کشد روی را","وقتی که دلیلی برای ظلم کردن باقی نماند، ظالم با خشونت و ستیزه‌جویی، چهره‌اش را به زشتی می‌آراید."],[26,"بخندید و بگریست مرد خدای","عجب داشت سنگین‌دل تیره‌رای","مرد خدا که به او اشاره شده، در عین حال که می‌خندید، اشک نیز می‌ریخت. این رفتار او برای دیگران عجیب بود، زیرا او دل سنگینی داشت و دارای نظر تیره و بدبین بود."],[26,"چو دیدش که خندید و دیگر گریست","بپرسید کاین خنده و گریه چیست؟","چون مرد خدا (حجاج) را دید که در یک لحظه هم می‌خندد و هم گریه می‌کند، از او پرسید دلیل این خنده و گریه چیست."],[26,"بگفتا همی گریم از روزگار","که طفلان بیچاره دارم چهار","او می‌گوید که من از شرایط سخت و دشوار روزگار می‌گریم، چون بچه‌های بیچاره‌ای دارم که به حالشان اندیشیده‌ام و نگران آینده‌شان هستم."],[26,"همی خندم از لطف یزدان پاک","که مظلوم رفتم نه ظالم به خاک","من از لطف خداوند مهربان می‌خندم، زیرا من به عنوان یک مظلوم به زمین رفته‌ام و نه به عنوان ظالم."],[26,"پسر گفتش: ای نامور شهریار","یکی دست از این مرد صوفی بدار","پسر به حجاج، ای فرمانروای مشهور، گفت: یکی از دست این مرد صوفی را کوتاه کن و او را رها کن."],[26,"که خلقی بر او روی دارند و پشت","نه رای است خلقی به یک بار کشت","مردمی بر او رو آوردند و از او حمایت کردند، اما در باطن از او دوری می‌کنند و به او اعتماد ندارند. این وضعیت نشان‌دهنده‌ی فساد اوست، چرا که تنها به یک بار خطا می‌توان او را نابود کرد."],[26,"بزرگی و عفو و کرم پیشه کن","ز خردان اطفالش اندیشه کن","بزرگی و بخشش و نیکوکاری را در نظر داشته باش و به یاد داشته باش که خردسالان هم به توجه و محبت نیاز دارند."],[26,"شنیدم که نشنید و خونش بریخت","ز فرمان داور که داند گریخت؟","گفته می‌شود که شخصی از حجاج یوسف، خبری را شنیده که او ادعا کرده آن را نشنیده است. این در حالی است که به خاطر اتهامی آن شخص را به قتل می‌رساند. در واقع، این بیت به نادرستی قضاوت و ناپایدار بودن قدرت در برابر حقیقت اشاره دارد."],[26,"بزرگی در آن فکرت آن شب بخفت","به خواب اندرش دید و پرسید و گفت:","شخص بزرگی در آن شب فکر می‌کرد و به خواب رفت. در خواب چیزی دید و از آن پرسید و صحبت کرد."],[26,"دمی بیش بر من سیاست نراند","عقوبت بر او تا قیامت بماند","مدتی کوتاه اگر شخصی با من سیاست نکند و من را مورد عذاب قرار دهد، عذاب او تا قیامت بر او باقی خواهد ماند."],[26,"نخفته‌ست مظلوم از آهش بترس","ز دود دل صبحگاهش بترس","مظلوم از عمق دلش آهی می‌کشد که خواب او را برهم زده است، پس از این آه مراقب باش و از درد و رنج او که مانند دودی در صبحگاه به بلندی می‌رسد بترس."],[26,"نترسی که پاک اندرونی شبی","بر آرد ز سوز جگر یا ربی؟","نترس که فردی پاکدامن و درستکار، یک شبه از درد دلش و سوز جگرش، چیزی از خودش نمایان خواهد کرد."],[26,"نه ابلیس بد کرد و نیکی ندید؟","بر پاک ناید ز تخم پلید","آیا ابلیس کار بدی نکرد و هیچ نیکی دریافت نکرد؟ بنابراین، از تخم ناپاک، چیزی پاک نمی‌روید."],[27,"مدر پرده کس به هنگام جنگ","که باشد تو را نیز در پرده ننگ","آبروی کسی را مبر زیرا تو نیز چیزهایی داری که اگر آشکار شوند، رسوا خواهی شد"],[27,"مزن بانگ بر شیرمردان درشت","چو با کودکان برنیایی به مشت","وقتی که زور تو به یک کودک نمی‌رسد به شیرمردان توهین مکن"],[27,"یکی پند می‌داد فرزند را","نگه دار پند خردمند را","شخصی بود که فرزند خود را پند می‌داد که این پند خردمندان را فراموش مکن"],[27,"مکن جور بر خردکان ای پسر","که یک روزت افتد بزرگی به سر","ای فرزندم، به ضعیفان جور و ستم مکن که روزی تو نیز دچار یک قوی‌تر از خود می‌شوی"],[27,"نمی‌ترسی ای گرگک کم خرد","که روزی پلنگیت بر هم درد؟","ای گرگ حقیر و درنده و نادان! آیا نمی‌ترسی از روزی یک پلنگ تو را بر هم می‌درد!؟"],[27,"به خردی درم زور سرپنجه بود","دل زیردستان ز من رنجه بود","در جوانی (یا کودکی) زورمند بودم و به ضعیفان زور می‌گفتم"],[27,"بخوردم یکی مشت زورآوران","نکردم دگر زور بر لاغران","تا آنکه روزی مشتی از یک قوی‌تر از خود خوردم از آن پس دیگر به ضعیفان ستم نکردم"],[27,"الا تا به غفلت نخفتی که نوم","حرام است بر چشم سالار قوم","ای بزرگ قوم، مواظب باش که غافل نشوی زیرا غفلت از سوی یک بزرگ و مهتر شایسته نیست"],[27,"غم زیردستان بخور زینهار","بترس از زبردستی روزگار","با زیردستان خود مهربان باش و از روزی که ضعیف شوی بترس"],[27,"نصیحت که خالی بود از غرض","چو داروی تلخ است، دفع مرض","پند و اندرزی اینچنین که خالی از غرض است و پاک است همچون داروی شفاگری است که تلخ است اما بیماری را شفا می‌بخشد."],[28,"یکی را حکایت کنند از ملوک","که بیماری رشته کردش چو دوک","درباره یکی از شاهان روایتی گفته‌اند که بیمار شد و همچون نخ خیاطی (از ضعف) لاغر و ضعیف شد"],[28,"چنانش در انداخت ضعف جسد","که می‌برد بر زیردستان حسد","چنان ضعیف و بیمار شد که به حال زیردستان خود حسد می‌برد"],[28,"که شاه ار چه بر عرصه نام‌آور است","چو ضعف آمد از بیدقی کمتر است","زیرا شاه با آنکه نام‌آور و فرمانده است اما وقتی که بیماری و ناخوشی برسد او را کمتر از یک سرباز می‌کند (شاه و بیدق اشاره به مهره‌های شطرنج نیز هست)"],[28,"ندیمی زمین ملک بوسه داد","که ملک خداوند جاوید باد","یکی از نزدیکان و خدمتکاران شاه به او گفت که فرمانروایی شاه همیشگی بادا"],[28,"در این شهر مردی مبارک دم است","که در پارسایی چنویی کم است","در این شهر مردی مبارک‌نفس و قدیس وجود دارد که در پارسایی و پرهیزگاری کم‌نظیر است"],[28,"نرفته‌ست هرگز ره ناصواب","دلی روشن و دعوتی مستجاب","تا حالا گناهی مرتکب نشده و دل پاکی دارد و دعای او برآورده می‌شود"],[28,"نبردند پیشش مهمات کس","که مقصود حاصل نشد در نفس","تا حالا نشده که کسی به او مراجعه کند و فورا به مقصود نرسد"],[28,"بخوان تا بخواند دعایی بر این","که رحمت رسد ز آسمان برین","او را فرابخوان تا دعایی کند و رحمت از آسمان نازل شود"],[28,"بفرمود تا مهتران خدم","بخواندند پیر مبارک قدم","دستور داد تا بزرگان دربارش نزد آن پیر مبارک‌قدم رفتند و او را فراخواندند"],[28,"برفتند و گفتند و آمد فقیر","تنی محتشم در لباسی حقیر","رفتند و آن درویش آمد شخصی ارجمند بود در لباس و جامه‌ای کهنه و بی‌ارزش."],[28,"بگفتا دعایی کن ای هوشمند","که در رشته چون سوزنم پای‌بند","به او گفت: ای دانا برایم دعا کن که همچون یک نخ خیاطی لاغر شده‌ام و همچون یک سوزن گرفتار شده‌ام."],[28,"شنید این سخن پیر خم بوده پشت","به تندی برآورد بانگی درشت","آن پیر کهنسال و خمیده‌قامت با خشم بر او فریاد زد"],[28,"که حق مهربان است بر دادگر","ببخشای و بخشایش حق نگر","که خدا بر دادگران مهربان است؛ ببخش تا بخشایش خدا را ببینی"],[28,"دعای منت کی شود سودمند","اسیران محتاج در چاه و بند؟","دعای من کی سودی به حال تو دارد؟ وقتی که اسیران و زندانیان در زندان و بند تو هستند؟"],[28,"تو ناکرده بر خلق بخشایشی","کجا بینی از دولت آسایشی؟","تو به مردم بخشایشی نکرده‌ای؛ چطور توقع داری که از نیکبختی و زندگی بهرمند شوی؟"],[28,"ببایدت عذر خطا خواستن","پس از شیخ صالح دعا خواستن","اول باید خطاهایت را جبران کنی؛ آنگاه است که می‌توانی از یک آدم پرهیزگار طلب دعا کنی"],[28,"کجا دست گیرد دعای ویت","دعای ستمدیدگان در پیت؟","کی دعا می‌تواند به تو کمکی کند وقتی که آه ستمدیدگان را به‌دنبال خود داری؟"],[28,"شنید این سخن شهریار عجم","ز خشم و خجالت بر آمد بهم","آن شاه عجم، این حرف را شنید و از خشم و خجالت در خود فرورفت"],[28,"برنجید و پس با دل خویش گفت","چه رنجم؟ حق است این که درویش گفت","از آن حرف رنجید و با خود گفت: چرا برنجم؟ این حرف حق و راست بود که این درویش گفت."],[28,"بفرمود تا هر که در بند بود","به فرمانش آزاد کردند زود","دستور داد تا فورا زندانیان را آزاد کردند"],[28,"جهاندیده بعد از دو رکعت نماز","به داور برآورد دست نیاز","آن پیر جهاندیده بعد از دو رکعت نماز به درگاه خدا دست نیاز و دعا برآورد"],[28,"که ای برفرازنده آسمان","به جنگش گرفتی به صلحش بمان","که ای کسی که آسمان را برافراشته‌ای و او را (یعنی این شخص را) تنبیه کردی از مجازاتش صرف‌نظر کن"],[28,"ولی همچنان بر دعا داشت دست","که شه سر برآورد و بر پای جست","آن ولی هنوز در حال دعا بود که شاه از جای برخاست"],[28,"تو گفتی ز شادی بخواهد پرید","چو طاووس، چون رشته در پا ندید","گویی که از شادی و نشاط می‌خواست پرواز کند همچون طاووسی که آزاد شود"],[28,"بفرمود گنجینه گوهرش","فشاندند در پای و زر بر سرش","دستور داد تا گوهر فراوان به او بخشیدند"],[28,"حق از بهر باطل نشاید نهفت","از آن جمله دامن بیفشاند و گفت","حق را باید گفت و بخاطر چیز باطل، حق را نباید پنهان کرد؛ از همه آن (گوهرها و زرها) دست کشید و گفت:"],[28,"مرو با سر رشته بار دگر","مبادا که دیگر کند رشته سر","بار دیگر با قضا و قدر در میفت مبادا که دیگر کند رشته سر"],[28,"چو باری فتادی نگه‌دار پای","که یک بار دیگر بلغزد ز جای","اگر یکبار تنبیه و مجازات شدی مواظب باش که بار دیگر دچار خطا و لغزش نشوی"],[28,"ز سعدی شنو کاین سخن راست است","نه هر باری افتاده برخاسته‌ست","این پند را از سعدی بشنو که راست است که هر بار افتاده‌ای برنخاسته است."],[29,"جهان ای پسر ملک جاوید نیست","ز دنیا وفاداری امید نیست","ای پسر اگاه باش که این دنیا جاودانی نیست و از این جهان نباید امید وفاداری داشت"],[29,"نه بر باد رفتی سحرگاه و شام","سریر سلیمان علیه‌السلام؟","ایا ندیدی که تخت حضرت سلیمان که بر روی باد حرکت میکرد ...."],[29,"به آخر ندیدی که بر باد رفت؟","خنک آن که با دانش و داد رفت",".... در اخر نابود شد و گذرا بود و بر باد رفت . خوشا به حال کسی که با عقل و عدالت زندگی کرد و از دنیا رفت"],[29,"کسی زین میان گوی دولت ربود","که در بند آسایش خلق بود","کسی در زندگی خود خوشبخت و موفق شد که به فکر راحتی و اسایش مردم بود"],[29,"به کار آمد آنها که برداشتند","نه گرد آوریدند و بگذاشتند","کسی که از دنیا به صورت صحیح بهره میبرد در نهایت از ان استفاده میکند و کسانی که مال جمع کردند و ان را گذاشتند سودی نبردند"],[30,"شنیدم که در مصر میری اجل","سپه تاخت بر روزگارش اجل","شنیدم که در مصر، مرگ (اجل) مانند یک سپاه به زندگی او یورش برد و بر روزگار او پایان آورد."],[30,"جمالش برفت از رخ دل فروز","چو خور زرد شد بس نماند ز روز","جمال و زیبایی او از صورتش محو شد و دل‌افروزیش را از دست داد، مانند اینکه صورت خورشید زرد و پژمرده شد و دیگر از روزگارش چیزی باقی نمانده است."],[30,"گزیدند فرزانگان دست فوت","که در طب ندیدند داروی موت","فرزانه‌ها و دانایان متوجه شدند که هیچ دارویی برای مرگ وجود ندارد، چون در علم طب به این موضوع پی برده‌اند که طبیبانی نتوانسته‌اند راهی برای جلوگیری از مرگ پیدا کنند."],[30,"همه تخت و ملکی پذیرد زوال","به جز ملک فرمانده لایزال","همه‌ی پادشاهی‌ها و قدرت‌ها به زودی زوال و نابودی را خواهند پذیرفت، به جز فرمانروایی که دائمی و نامحدود است."],[30,"چو نزدیک شد روز عمرش به شب","شنیدند می‌گفت در زیر لب","وقتی روز عمر او به پایان نزدیک می‌شد، او در دلش چیزهایی را با خود می‌گفت که دیگران هم شنیدند."],[30,"که در مصر چون من عزیزی نبود","چو حاصل همین بود چیزی نبود","در مصر کسی به مهمی و ارزشمندی من وجود ندارد و به هر حال، اگر من به اینجا رسیدم، نتیجه‌ای جز این نیست."],[30,"جهان گرد کردم نخوردم برش","برفتم چو بیچارگان از سرش","من دنیا را تغییر دادم و چیزی از آن نخوردم و مانند آدم‌های بیچاره از آن کناره‌گیری کردم."],[30,"پسندیده رایی که بخشید و خورد","جهان از پی خویشتن گرد کرد","رأی و نظر نیکو و پسندیده‌ای که انسان می‌دهد و می‌خورد، باعث می‌شود که دنیا نیز به خاطر او به چرخش و تغییر درآید."],[30,"در این کوش تا با تو ماند مقیم","که هرچ از تو ماند دریغ است و بیم","کوشش کن تا همیشه پایدار بمانی، زیرا هر چیزی که از تو باقی بماند، ارزشمند و نگران‌کننده است."],[30,"کند خواجه بر بستر جان‌گداز","یکی دست کوتاه و دیگر دراز","خواجه (یعنی شخص ثروتمند و محترم) در حالتی سخت و دردناک در بستر مرگ است. او یکی از دست‌هایش را نزدیک خود و دست دیگرش را دراز کرده است، که این نشان‌دهنده ناامیدی و طلب او برای چیزی است که در زندگی از دست داده است."],[30,"در آن دم تو را می‌نماید به دست","که دهشت زبانش ز گفتن ببست","در آن لحظه که خواجه در بستر دراز کشیده، به نظر می‌رسد که دستش در حال کمک و مهربانی است، اما ترس و وحشت او باعث شده که نتواند زبانش را برای سخن گفتن بگشاید."],[30,"که دستی به جود و کرم کن دراز","دگر دست کوته کن از ظلم و آز","دستت را برای بخشش و نیکی دراز کن، اما دستت را از ظلم و ستم کوتاه نگه‌دار."],[30,"کنونت که دست است خاری بکن","دگر کی بر آری تو دست از کفن؟","اکنون که دست تو مانند خار است و اذیت می‌کند، دیگر چه زمانی می‌خواهی دست را از زیر کفن برداری و به کار خیر بپردازی؟"],[30,"بتابد بسی ماه و پروین و هور","که سر بر نداری ز بالین گور","زمان زیادی خواهد گذشت و ماه و ستاره‌های پروین و خورشید به درخشش خود ادامه خواهند داد، اما تو که در خواب مرگ هستی، دیگر از جایت بلند نخواهی شد."],[31,"قزل ارسلان قلعه‌ای سخت داشت","که گردن به الوند بر می‌فراشت","قزل ارسلان قلعه‌ای محکم و استوار داشت که بر فراز کوه الوند قرار گرفته بود و شکوه و عظمت آن را به نمایش می‌گذاشت."],[31,"نه اندیشه از کس نه حاجت به هیچ","چو زلف عروسان رهش پیچ پیچ","فکر و تدبیر کسی برای او نیست و نیازی به کسی ندارد، چون راه او همچون زلف عروسان پرپیچ و خم است."],[31,"چنان نادر افتاده در روضه‌ای","که بر لاجوردی طبق بیضه‌ای","چنان به ندرت در باغی پیدا می‌شود که بر ظرف لاجوردی تخم‌مرغی قرار گرفته باشد."],[31,"شنیدم که مردی مبارک حضور","به نزدیک شاه آمد از راه دور","مردی خوش‌شانس از جایی دور به نزد شاه آمد."],[31,"حقایق شناسی، جهاندیده‌ای","هنرمندی، آفاق گردیده‌ای","انسانی که به درستی و حقیقت آگاه است، از تجربه‌ و دانش گسترده‌ای برخوردار بوده و به‌طور جامع جهان را مشاهده کرده است."],[31,"بزرگی، زبان آوری کاردان","حکیمی، سخنگوی بسیاردان","بزرگی و مهارت در گفتار کاردان حکیمی، او را به عنوان یک سخنگوی با دانش و آگاه معرفی می‌کند."],[31,"قزل گفت چندین که گردیده‌ای","چنین جای محکم دگر دیده‌ای؟","قزل از حکیم می‌پرسد که آیا جای استوار دیگری مانند این قلعه را دیده‌ای که این‌قدر محکم باشد؟"],[31,"بخندید کاین قلعه‌ای خرم است","ولیکن نپندارمش محکم است","قزل ارسلان می‌خندد و می‌گوید این قلعه خوش و خرم است، اما فکر نکنید که آنقدر محکم و استوار است."],[31,"نه پیش از تو گردن کشان داشتند","دمی چند بودند و بگذاشتند؟","پیش از تو نیز حاکمان یا افرادی ستمگر و گردن‌کش وجود داشتند، اما آنها نیز تنها مدتی کوتاه در قدرت ماندند و در نهایت از میان رفتند."],[31,"نه بعد از تو شاهان دیگر برند","درخت امید تو را بر خورند؟","پس از رفتن تو، آیا پادشاهان دیگر نیز به امید و آرزوهای تو پایان نخواهند داد و آن امید را نمی‌خشکانند؟"],[31,"ز دوران ملک پدر یاد کن","دل از بند اندیشه آزاد کن","به زمان سلطنت پدرت فکر کن و اجازه نده که ذهن‌ات به تجربیات منفی مشغول باشد."],[31,"چنان روزگارش به کنجی نشاند","که بر یک پشیزش تصرف نماند","او را به گونه‌ای در گوشه‌ای از زندگی‌اش قرار دادند که حتی نتواند در مورد یک پول کوچک هم تصرف و تصمیمی بگیرد."],[31,"چو نومید ماند از همه چیز و کس","امیدش به فضل خدا ماند و بس","چون از همه چیز و افراد ناامید شد، تنها به فضل خدا امیدوار ماند و بس."],[31,"بر مرد هشیار دنیا خس است","که هر مدتی جای دیگر کس است","برای انسان باهوش، دنیا چیزی جز زباله نیست، زیرا هر لحظه این دنیا به کسی دیگر می‌رسد و در دست اوست."],[31,"چنین گفت شوریده‌ای در عجم","به کسری که ای وارث ملک جم","شوریده‌ای در سرزمین عجم (ایران) چنین گفت به کسری (شاه)، که تو وارث حکومت جم (فرهنگ و تاریخ ایران) هستی."],[31,"اگر ملک بر جم بماندی و بخت","تو را کی میسر شدی تاج و تخت؟","اگر سرزمین و حکومت به جم (پادشاه اسطوره‌ای) تعلق داشت و تو هم در آن زمان بودی، آیا بخت و شانس تو به ایستادن بر تخت سلطنت فراهم می‌شد؟"],[31,"اگر گنج قارون به دست آوری","نماند مگر آنچه بخشی، بری","اگر گنج قارون، که بزرگ‌ترین ثروت‌ها را دارد، به دستت بیفتد، فقط چیزی باقی می‌ماند که آن را بین دیگران تقسیم می‌کنی و چیزی برای خودت نمی‌ماند."],[32,"چو الب ارسلان جان به جان‌بخش داد","پسر تاج شاهی به سر برنهاد","چون الب‌ارسلا ن جان خود را به خدای جان‌بخش سپرد، پسرش تاج شاهی را بر سر گذاشت."],[32,"به تربت سپردندش از تاجگاه","نه جای نشستن بد آماجگاه","او را در محل دفنش، که همان جایی است که تاج و تختش بوده، به خاک سپردند؛ زیرا دیگر جایی برای نشستن و حکومت کردن بر مردم ندارد و در این حال به طعنه و تمسخر دچار شده است."],[32,"چنین گفت دیوانه‌ای هوشیار","چو دیدش پسر روز دیگر سوار","دیوانه‌ای که هوش و حواسش جمع است، وقتی پسر را دید که روز بعد سوار بر اسب است، اینگونه گفت."],[32,"زهی ملک و دوران سر در نشیب","پدر رفت و پای پسر در رکیب","بزرگی و اقتدار و دوران زندگی هرکس در حال تغییر و ناپایداری است؛ حالا پدر در حال افول و ناتوانی است و پسر به قله‌های قدرت رسیده است."],[32,"چنین است گردیدن روزگار","سبک سیر و بدعهد و ناپایدار","روزگار به همین شکل است؛ با سرعت می‌گذرد و وفادار نیست و ثبات ندارد."],[32,"چو دیرینه روزی سرآورد عهد","جوان دولتی سر برآرد ز مهد","زمانی که روزگار قدیمی دوباره به سر آید و جوانی در اوج قدرت و سلطنت به میدان بیاید، حاکمیت و توانمندی به عرصه ظهور می‌آید."],[32,"منه بر جهان دل که بیگانه‌ای است","چو مطرب که هر روز در خانه‌ای است","به دل خود نسبت به جهان دل نبند، زیرا دنیا مانند یک مطرب است که هر روز در خانه‌ای متفاوت است و به آن وابسته نیست."],[32,"نه لایق بود عیش با دلبری","که هر بامدادش بود شوهری","عیش و خوشی با کسی که هر روز شوهرش عوض می‌شود، شایسته نیست. این اشاره به ناپایداری و بی‌ثباتی یک رابطه عاشقانه دارد."],[32,"نکویی کن امسال چون ده تو راست","که سال دگر دیگری دهخداست","در این بیت گفته می‌شود که امسال به کسی نیکوئی کن، زیرا ممکن است سال آینده آن شخص دیگری شود و این تغییر در رفتار بر عهده‌ی توست."],[33,"شنیدم که از پادشاهان غور","یکی پادشه خر گرفتی به زور","یکی از پادشاهان غور شنیدم که به زور، خر یک روستایی را گرفته است."],[33,"خران زیر بار گران بی علف","به روزی دو مسکین شدندی تلف","خرها زیر بار سنگین، بدون خوراک، هر روز دو نفر از آدم‌های فقیر را هلاک می‌کنند."],[33,"چو منعم کند سفله را، روزگار","نهد بر دل تنگ درویش، بار","هرگاه شخصی بخشنده و دست و دلباز باشد، افراد کم‌مایه و پست‌فطرت را مورد لطف خود قرار می‌دهد و این باعث می‌شود که روزگار بر دل محدود و تنگ درویش (فرد فقیر) بار سنگینی بگذارد."],[33,"چو بام بلندش بود خودپرست","کند بول و خاشاک بر بام پست","اگر آدم پستی بام بلندی داشته باشد به بام های پایین‌تر خودش ادرار میکند و خاشاک می‌ریزد"],[33,"شنیدم که باری به عزم شکار","برون رفت بیدادگر شهریار","روزی شنیدم که یک بار پادشاه ستمگر برای شکار بیرون رفت."],[33,"تکاور به دنبال صیدی براند","شبش در گرفت از حشم باز ماند","شکارچی قوی و نیرومند (تکاور) به دنبال شکار رفت، اما شب او را غافلگیر کرد و نتوانست از گروهی که با او بودند (حشم) جدا شود."],[33,"به تنها ندانست روی و رهی","بینداخت ناکام شب در دهی","تکاور (شکارچی) در تاریکی شب در جست‌وجوی صید به تنهایی توانست راه و مقصدش را پیدا کند، اما در نهایت بی‌نتیجه و ناامید به یک ده رسید."],[33,"یکی پیرمرد اندر آن ده مقیم","ز پیران مردم شناس قدیم","در آن ده، یک پیرمردی زندگی می‌کند که از میان مردم قدیم، انسانی با تجربه و آگاه به امور است."],[33,"پسر را همی‌گفت کای شادبهر","خرت را مبر بامدادان به شهر","پدر به پسرش می‌گوید، ای شاداب و خوش طبع، اسب خود را صبح زود به شهر نبر."],[33,"که این ناجوانمرد برگشته بخت","که تابوت بینمش بر جای تخت","این شخص بی‌رحم و نادان، که از شانس بدش به این حال رسیده، حالا تابوتش را جایی می‌بینم که قبلا تخت و مقامش بوده است."],[33,"کمر بسته دارد به فرمان دیو","به گردون بر از دست جورش غریو","به خاطر فرمان دیو، مردی در تلاش است و بر اثر ظلم او، ناله و فریادش به آسمان می‌رسد."],[33,"در این کشور آسایش و خرمی","ندید و نبیند به چشم آدمی","در این سرزمین هیچ آسایش و خوشی را دیده و نخواهد دید، و این وضعیت به وضوح برای انسان‌ها آشکار است."],[33,"مگر کاین سیه نامه بی‌صفا","به دوزخ برد لعنت اندر قفا","آیا ممکن است که این بدبختی و سرنوشت شوم بدون خوشی، باعث لعنتی به دنبال خود به دوزخ برود؟"],[33,"پسر گفت: راه دراز است و سخت","پیاده نیارم شد ای نیکبخت","پسر می‌گوید: مسیر طولانی و دشوار است و نمی‌توانم به تنهایی راه بروم، ای نیکبخت."],[33,"طریقی بیندیش و رایی بزن","که رای تو روشن‌تر از رای من","طوری فکر کن و تصمیمی بگیر که نظر تو در این مورد از نظر من واضح‌تر و بهتر باشد."],[33,"پدر گفت: اگر پند من بشنوی","یکی سنگ برداشت باید قوی","پدر گفت: اگر نصیحت من را بپذیری، باید برای پیشرفت و موفقیت، خود را قوی و آماده نگه‌داری."],[33,"زدن بر خر نامور چند بار","سر و دست و پهلوش کردن فگار","شلاق زدن به خر معروف (نماد کارگران یا زحمت‌کشان) و چند بار ضربه زدن به سر و بدن او نشان‌دهنده فشار و آزار است که بر او روا داشته می‌شود."],[33,"مگر کان فرومایه زشت کیش","به کارش نیاید خر پشت ریش","آیا آن فرد پست و زشت‌نهاد که در کارش از خری که پشتش را شاخی به داشتن ریش عقب افتاده به کار نمی‌آید، آن‌قدر ناتوان است که نمی‌تواند از خر استفاده کند؟"],[33,"چو خضر پیمبر که کشتی شکست","وز او دست جبار ظالم ببست","همان‌طور که خضر، پیامبر و راهنما، وقتی کشتی را شکسته است، توانسته است دست جبار و ظالم را ببندد و او را مهار کند."],[33,"به سالی که در بحر کشتی گرفت","بسی سالها نام زشتی گرفت","در سالی که در دریا کشتی واژگون شد، به مدت سال‌ها، نام بد و زشتی به آن واقعیت چسبید و شهرت پیدا کرد."],[33,"تفو بر چنان ملک و دولت که راند","که شنعت بر او تا قیامت بماند","لعنت بر چنین پادشاه و مملکتی که نامش برای همیشه بر سر زبان‌ها بماند و زشت باشد."],[33,"پسر چون شنید این حدیث از پدر","سر از خط فرمان نبردش به در","پسر وقتی از پدر این داستان را شنید، هرگز از اطاعت فرمان او سرپیچی نکرد."],[33,"فرو کوفت بیچاره خر را به سنگ","خر از دست عاجز شد از پای لنگ","ماجرای پسر بیچاره را نشان می‌دهد که با وجود بیچارگی و ناتوانی، خرش به خاطر لنگ بودنش از او فرار کرده و او نمی‌تواند آن را کنترل کند. در واقع، تلاش او بی‌فایده بوده است."],[33,"پدر گفتش اکنون سر خویش گیر","هر آن ره که می‌بایدت پیش گیر","پدر به پسرش می‌گوید که اکنون خودت را کنترل کن و در هر مسیری که باید برو."],[33,"پسر در پی کاروان اوفتاد","ز دشنام چندان که دانست داد","پسر به دنبال کاروان رفت و به حدی به او دشنام داده شد که فهمید که دیگر تحملش تمام شده است."],[33,"وز آن سو پدر روی در آستان","که یارب به سجاده راستان","پدر در آن سو در آستانه در ایستاده و در دل از خداوند می‌خواهد که به سجاده اهل حق و درستکاران، احترام و توجه کند."],[33,"که چندان امانم ده از روزگار","کز این نحس ظالم بر آید دمار","ای کاش در این روزگار سخت و نحس، آنقدر به من مهلت و فراغتی بدهی که از این ظلم و ستم رهایی یابم."],[33,"اگر من نبینم مر او را هلاک","شب گور چشمم نخسبد به خاک","اگر من نتوانم او را در شب هلاکتش ببینم، چشمانم بر اثر دیدن خاک نمی‌تواند بخوابد."],[33,"اگر مار زاید زن باردار","به از آدمی زاده دیوسار","اگر زنی که باردار است، مار بیاورد، بهتر از این است که فرزندش شبیه آدمی باشد که خلق و خوی دیوان (دیوسار) دارد."],[33,"زن از مرد موذی به بسیار به","سگ از مردم مردم‌آزار به","مرد مکار و بدجنس، همچون زنی که از او درد و رنج می‌کشد، به بی‌اعتنایی مردمواره‌ای شبیه به سگی است که به دیگران آسیب می‌زند."],[33,"مخنث که بیداد بر خود کند","از آن به که با دیگری بد کند","مردی که خود را بدرفتاری کند، بهتر است که به دیگری آسیب نرساند."],[33,"شه این جمله بشنید و چیزی نگفت","ببست اسب و سر بر نمد زین بخفت","پادشاه این سخن را شنید و چیزی نگفت، سپس اسب خود را بست و بر روی نمد (بالشت یا تشک) خوابش برد."],[33,"همه شب به بیداری اختر شمرد","ز سودا و اندیشه خوابش نبرد","پادشاه همه شب بیدار بود و ستاره‌ها را می‌شمرد و از فکر و اندیشه‌اش نتوانست بخوابد."],[33,"چو آواز مرغ سحر گوش کرد","پریشانی شب فراموش کرد","وقتی که صدای مرغ سحر را شنید، تمام اضطراب و پریشانی شب را از یاد برد."],[33,"سواران همه شب همی تاختند","سحرگه پی اسب بشناختند","سواران تمام شب با سرعت می‌تاختند و صبحگاه که شد، اسب را شناسایی کردند."],[33,"بر آن عرصه بر اسب دیدند شاه","پیاده دویدند یکسر سپاه","در آن میدان، شاه را دیدند که پیاده است و همه سربازان یک‌صدا به سمت او دویدند."],[33,"به خدمت نهادند سر بر زمین","چو دریا شد از موج لشکر، زمین","سپاهیان به احترام پادشاه، سر خود را بر زمین گذاشتند و زمین مانند دریایی شده بود که از امواج لشکر پر شده است."],[33,"یکی گفتش از دوستان قدیم","که شب حاجبش بود و روزش ندیم","یکی از دوستان قدیم او گفت که شب‌ها به او خدمت می‌کرد و روزها خدمتش به او کمتر بود."],[33,"رعیت چه نزلت نهادند دوش؟","که ما را نه چشم آرمید و نه گوش","عوام مردم (رعیت) چه بدی را در شب گذشته تحمل کردند که نه خواب به چشمانشان آمد و نه آرامشی برای گوش‌هایشان پیدا شد؟"],[33,"شهنشه نیارست کردن حدیث","که بر وی چه آمد ز خبث خبیث","پادشاه جرأت نکرد درباره‌ی آنچه بر او از بدی‌های این شخص (روستایی) اتفاق افتاده سخن بگوید."],[33,"هم آهسته سر برد پیش سرش","فرو گفت پنهان به گوش اندرش","او به آرامی سرش را پایین آورد و به طور مخفیانه در گوش او سخنی گفت."],[33,"کسم پای مرغی نیاورد پیش","ولی دست خر رفت از اندازه بیش","کس به نزد پادشاه مرغی نیاورد، اما دست او (پادشاه) به اندازه‌ای زیاد به سمت خر (غذا) رفت که حد و مرز را درنوردید."],[33,"بزرگان نشستند و خوان خواستند","بخوردند و مجلس بیاراستند","بزرگان جمع شدند و درخواست کردند تا سفره‌ای بیاورند و خوردند و مجلس را آراستند."],[33,"چو شور و طرب در نهاد آمدش","ز دهقان دوشینه یاد آمدش","او زمانی که شوری و خوشی در وجودش ایجاد شد، به یاد دهقان (کشاورز) و خاطرات گذشته‌اش افتاد."],[33,"بفرمود و جستند و بستند سخت","به خواری فکندند در پای تخت","پادشاه دستور داد که بی‌رحمانه افرادی را که مرتکب خطا شده بودند ببیند و آنها را به شدت تنبیه کند و آن افراد را در برابر او به ذلت و خواری افکندند."],[33,"سیه دل برآهخت شمشیر تیز","ندانست بیچاره راه گریز","سیاه‌دل، که از بدبختی و ناامیدی در دلش آتش می‌باشد، شمشیر تندی را از بیرون می‌کشد و نمی‌داند که چاره‌ای برای فرار از این وضعیت ندارد."],[33,"سر ناامیدی برآورد و گفت","نشاید شب گور در خانه خفت","او که ناامید شده، سرش را بلند کرده و با صدای بلند می‌گوید که در شب تاریک و ترسناک نمی‌توان در خانه خود خوابید، به خاطر احساس خطر و ناامنی که دارد."],[33,"نه تنها منت گفتم ای شهریار","که برگشته بختی و بد روزگار","من فقط از تو خواستم که عادل باشی و حالا می‌گویم که بخت من بدجوری تغییر کرده و روزگارم سیاه شده است."],[33,"چرا خشم بر من گرفتی و بس؟","منت پیش گفتم، همه خلق پس","چرا بر من خشمگین شدی؟ من فقط از روی لطف گفتم که روزگار خوبی برای تو به سر رسیده است و همه مردم از آن باخبر شده‌اند."],[33,"چو بیداد کردی توقع مدار","که نامت به نیکی رود در دیار","اگر به ظلم و ستم ادامه بدهی، نباید انتظار داشته باشی که نامت در جامعه به خوبی و نیکی یاد شود."],[33,"ور ایدون که دشوارت آمد سخن","دگر هر چه دشوارت آید مکن","اگر سخنی برای تو دشوار است، هرگز آن را نگو و انجام نده."],[33,"تو را چاره از ظلم برگشتن است","نه بیچاره بی‌گنه کشتن است","برای فرار از ظلم، باید بازگشت و اقدام کرد، نه اینکه بی‌سبب و بی‌گناه دیگران را آزار داد."],[33,"مرا پنج روز دگر مانده گیر","دو روز دگر عیش خوش رانده گیر","پنج روز دیگر برای من باقی مانده، پس دو روز دیگر را با خوشی و لذت بگذران."],[33,"نماند ستمکار بد روزگار","بماند بر او لعنت پایدار","ستمکار در روز قیامت باقی نمی‌ماند و عذاب او همیشگی خواهد بود."],[33,"تو را نیک پند است اگر بشنوی","وگر نشنوی خود پشیمان شوی","اگر تو پند خوب را بشنوی و از آن استفاده کنی، برایت سودمند است؛ اما اگر گوش ندهی و به آن عمل نکنی، در آینده برایت باعث پشیمانی خواهد شد."],[33,"بدان کی ستوده شود پادشاه","که خلقش ستایند در بارگاه؟","بدانید که پادشاهی ستایش می‌شود و مورد احترام قرار می‌گیرد که مردم او را در دربار خود ستایش کنند و درباره‌اش سخن خوب بگویند."],[33,"چه سود آفرین بر سر انجمن","پس چرخه نفرین کنان پیرزن؟","به چه فایده است که در جمع افرادی که به او تحسین می‌کنند، دعا و برکت بخواهد، در حالی که یک زن سالخورده به او بد می‌گوید و نفرین می‌کند؟"],[33,"همی گفت و شمشیر بالای سر","سپر کرده جان پیش تیر قدر","پادشاه غور در حالی که شمشیرش را در دست دارد و بر سرش نگهبانی در حال محافظت است، می‌گوید که جانش را در برابر خطر تیرهایی که ممکن است به او اصابت کند، آماده کرده است."],[33,"نبینی که چون کارد بر سر بود","قلم را زبانش روان تر بود","وقتی خطر به سر نزدیک می‌شود، انسان قدرت بیانش بیشتر می‌شود و به راحتی صحبت می‌کند."],[33,"شه از مستی غفلت آمد به هوش","به گوشش فرو گفت فرخ سروش","پادشاه در اثر مستی غافل شده بود، اما حالا به هوش آمده و فرشته‌ای به نام فرخ سروش در گوشش پیامی می‌گوید."],[33,"کز این پیر دست عقوبت بدار","یکی کشته گیر از هزاران هزار","از این پیر (یعنی فرد سالخورده یا حکیم) دست عذاب و تنبیه را کنار بگذار و از میان هزاران نفر، تنها یکی را بکش و بقیه را ببخش."],[33,"زمانی سر اندر گریبان بماند","پس آن گه به عفو آستین برفشاند","مدتی او سرش را در گریبان پنهان کرد و بعد از آن با آستین خود، نشانه‌های عفو و بخشش را نمایان کرد."],[33,"به دستان خود بند از او برگرفت","سرش را ببوسید و در بر گرفت","پادشاه در این بیت، با دستان خود، بندی که بر گردن آن روستایی بود را باز کرد، سپس سر او را بوسید و او را در آغوش گرفت."],[33,"بزرگیش بخشید و فرماندهی","ز شاخ امیدش برآمد بهی","او (پادشاه غور) بزرگیش را به او (روستایی) عطا کرد و مقام فرماندهی به اعتبار امیدش به او رسید."],[33,"به گیتی حکایت شد این داستان","رود نیکبخت از پی راستان","در دنیا، داستان این رود نیکبخت به خاطر درستکاری و صداقت او نقل می‌شود."],[33,"بیاموزی از عاقلان حسن خوی","نه چندان که از غافل عیب جوی","از خردمندان و دانایان باید خوبی‌های خود را یاد بگیری، نه اینکه فقط از نادانان و کسانی که به دنبال عیب‌جویی‌اند، بدی‌های خود را بشنوی."],[33,"ز دشمن شنو سیرت خود که دوست","هرآنچ از تو آید به چشمش نکوست","بهتر است از دشمن خود اخلاق و رفتار خود را بشنوی، زیرا دوست هر چیزی که از تو ببیند، در نظرش خوب و زیباست."],[33,"وبال است دادن به رنجور قند","که داروی تلخش بود سودمند","رنجاندن و عذاب دادن کسی که بیمار و ضعیف است، مانند این است که به او قند می‌دهی، در حالی که داروی تلخش برایش مفیدتر است."],[33,"ترش روی بهتر کند سرزنش","که یاران خوش طبع شیرین منش","اگر کسی که همیشه بدخلق و ترش‌روست، او را سرزنش کند، اثر آن بیشتر از سرزنش کسی است که خوش‌رو و خوش‌خلق است، چون سرزنش از جانب شخص بدخلق جدی‌تر و تأثیرگذارتر به نظر می‌رسد."],[33,"از این به نصیحت نگوید کست","اگر عاقلی یک اشارت بست","اگر فردی عاقل سخنی را به اشاره بزند، دیگر نیازی نیست که کسی به او نصیحتی کند یا چیزی را بگوید."],[34,"چو دور خلافت به مأمون رسید","یکی ماه پیکر کنیزک خرید","هنگامی که خلافت به مأمون رسید، او دختر کنیزکی ماهروی را خرید."],[34,"به چهر آفتابی، به تن گلبنی","به عقل خردمند بازی کنی","او (کنیزک) چهره‌ای مانند آفتاب و بدنی مانند گل دارد و با عقل و هوشمندی خود، دیگران را بازیچه کرده است."],[34,"به خون عزیزان فرو برده چنگ","سر انگشتها کرده عناب رنگ","دستش را به خون عزیزان آغشته کرده و با انگشتانش رنگ عناب را بر روی خود به جا گذاشته است."],[34,"بر ابروی عابد فریبش خضاب","چو قوس قزح بود بر آفتاب","ابروی عابد به رنگ خضاب (حنا) که مانند رنگین‌کمان زیر نور خورشید می‌درخشد، او را فریبنده و جذاب نشان می‌دهد."],[34,"شب خلوت آن لعبت حور زاد","مگر تن در آغوش مأمون نداد","در شب خلوت، آن کنیز زیبا که مانند حوری است، بدنش را در آغوش مأمون نگذاشت."],[34,"گرفت آتش خشم در وی عظیم","سرش خواست کردن چو جوزا دو نیم","مأمون به شدت خشمگین شد و مثل این بود که می‌خواهد سر او را به دو نیم کند، مانند دانه‌های جوز که از وسط شکافته می‌شوند."],[34,"بگفتا سر اینک به شمشیر تیز","بینداز و با من مکن خفت و خیز","مأمون به کنیزک گفت: حالا که اوضاع به اینجا رسیده است، با شمشیر تیز به من حمله کن و بی‌آنکه تردید کنی، با من شوخی نکن."],[34,"بگفت از چه بر دل گزند آمدت؟","چه خصلت ز من ناپسند آمدت؟","مأمون از کنیزک می‌پرسد که چه چیزی باعث شده تا به دلش بر بخورد و چه ویژگی‌ای از او را ناپسند دانسته است."],[34,"بگفت ار کشی ور شکافی سرم","ز بوی دهانت به رنج اندرم","کنیزک گفت اگر تو مرا بکشی یا سرم را بشکافی، بوی دهانت مرا به زحمت می‌اندازد."],[34,"کشد تیر پیکار و تیغ ستم","به یک بار و بوی دهن دم به دم","اگر کسی با تیر و شمشیر هم بر من ظلم کند، این ظلم و ستم به اندازه بوی بد دهان او برای من خسته‌کننده و آزاردهنده است."],[34,"شنید این سخن سرور نیکبخت","برآشفت تند و برنجید سخت","سرور نیکبخت (مأمون) وقتی این سخن را شنید، به شدت عصبانی و ناراحت شد."],[34,"همه شب در این فکر بود و نخفت","دگر روز با هوشمندان بگفت","او (سرور نیکبخت) تمام شب را در فکر و اندیشه گذراند و نتوانست بخوابد و در روز بعد با افراد باهوش و خردمند صحبت کرد."],[34,"طبیعت شناسان هر کشوری","سخن گفت با هر یک از هر دری","دانشمندان طبیعت هر کشوری درباره ویژگی‌های طبیعت و مسائل آن با دیگران صحبت می‌کنند و از هر دری وارد بحث می‌شوند."],[34,"دلش گرچه در حال از او رنجه شد","دوا کرد و خوشبوی چون غنچه شد","دل او اگرچه در حال نگران و عذاب است، اما با محبت و محرم‌نوازی این دختر، آرامش می‌یابد و مانند غنچه‌ای خوشبو و شاداب می‌شود."],[34,"پری چهره را همنشین کرد و دوست","که این عیب من گفت، یار من اوست","به دلیل زیبایی ظاهری و دل‌نشینی که دختر با چهره پری‌گونش دارد، او را هم‌نشین و دوست خود گرفت؛ زیرا کسی که این عیب من را به زبان آورد، در حقیقت یار و دوست من است."],[34,"به نزد من آن کس نکوخواه توست","که گوید فلان خار در راه توست","کسی که در حضور من از تو خوب می‌گوید و نیتش خیر توست، همان کسی است که می‌گوید در مسیر تو موانعی وجود دارد."],[34,"به گمراه گفتن نکو می‌روی","جفایی تمام است و جوری قوی","تهمت زدن به کسی که نیکوست و به او دروغ می‌گویی، ظلمی بزرگ و قوی است."],[34,"هر آن گه که عیبت نگویند پیش","هنر دانی از جاهلی عیب خویش","هر وقت که عیب تو را نگوید، هنرمند از نادانی عیب خودش را می‌فهمد."],[34,"مگو شهد شیرین شکر فایق است","کسی را که سقمونیا لایق است","نمی‌توان گفت شهد شیرین از شکر برتر است برای کسی که دچار بیماری سقمونیا (نوعی مرض) است."],[34,"چه خوش گفت یک روز دارو فروش:","شفا بایدت داروی تلخ نوش","یک روز دارو فروش گفت جمله‌ای خوب که برای درمان نیاز به داروی تلخ است، نه به چیزهای شیرین و دلپذیر."],[34,"اگر شربتی بایدت سودمند","ز سعدی ستان تلخ داروی پند","اگر می‌خواهی نوشیدنی‌ای مفید برایت باشد، از سعدی پندی بگیر که مانند داروی تلخ است."],[34,"به پرویزن معرفت بیخته","به شهد ظرافت برآمیخته","در این بیت، سخن از پرویز است (پرویز یکی از پادشاهان ساسانی) که با آگاهی و دانایی خویش، معرفت و فهم را با شیرینی و نرمی ترکیب کرده است. منظور این است که دانش و شناخت او به گونه‌ای است که هم عمیق است و هم دلنشین، مانند شیره‌ای که با لطافت طعم خوبی دارد."],[35,"شنیدم که از نیکمردی فقیر","دل آزرده شد پادشاهی کبیر","پادشاه بزرگ از نیکمردی فقیر که بی‌سبب ناراحتش کرده بود، نامش شنید."],[35,"مگر بر زبانش حقی رفته بود","ز گردن‌کشی بر وی آشفته بود","شاید به دلیل سخنی از او ناراحت شده بود که در آن برتری‌جویی و ظلمی بر او رفته بود."],[35,"به زندان فرستادش از بارگاه","که زورآزمای است بازوی جاه","او (درویش) را به دلیل قدرت‌نمایی و نافرمانی از دربار به زندان فرستادند، زیرا در برابر پادشاهی که به دنبال قدرت و جاه‌طلبی است، ایستادگی کرده بود."],[35,"ز یاران کسی گفتش اندر نهفت","مصالح نبود این سخن گفت، گفت","یکی از یاران در پنهانی به درویش صادق گفت که این سخن (انتقاد از بیدادگری پادشاه) به مصلحت نیست و نباید مطرح شود."],[35,"رسانیدن امر حق طاعت است","ز زندان نترسم که یک ساعت است","برای رساندن فرمان حق، اطاعت و فرمانبرداری ضروری است و از زندان نمی‌ترسم، چرا که این مدت فقط یک ساعت است."],[35,"همان دم که در خفیه این راز رفت","حکایت به گوش ملک باز رفت","در آن لحظه که راز این موضوع به طور پنهانی فاش شد، داستان به گوش پادشاه رسید."],[35,"بخندید کاو ظن بیهوده برد","نداند که خواهد در این حبس مرد","او (درویش) خندید چون گمان بی‌اساسی کرد و نمی‌دانست که ممکن است در این زندان جانش را از دست بدهد."],[35,"غلامی به درویش برد این پیام","بگفتا به خسرو بگو ای غلام","غلامی پیام را به درویش رساند و گفت که به پادشاه (خسرو) بگوید که او (درویش) نیز غلام اوست."],[35,"مرا بار غم بر دل ریش نیست","که دنیا همین ساعتی بیش نیست","غم و اندوهی که بر دل من است، واقعی نیست، زیرا زندگی در این دنیا از لحظه‌ای بیشتر دوام ندارد."],[35,"نه گر دستگیری کنی خرمم","نه گر سر بری بر دل آید غمم","اگر تو به من کمک کنی، خوشحال می‌شوم و اگر هم مرا بکشی، غم من کم نخواهد شد."],[35,"تو گر کامرانی به فرمان و گنج","دگر کس فرومانده در ضعف و رنج","اگر تو به پیروزی و ثروت برسی، دیگران در حال ضعف و زحمت باقی می‌مانند."],[35,"به دروازه مرگ چون در شویم","به یک هفته با هم برابر شویم","زمانی که به دروازه مرگ نزدیک می‌شویم، همه ما در آخر یک هفته به یک اندازه و برابر خواهیم بود، بی‌تفاوت به مقام و ثروت."],[35,"منه دل بر این دولت پنج روز","به دود دل خلق، خود را مسوز","به این پنج روز زندگی دل نبند، زیرا با اندوه و آتش دل مردم، خود را نسوزان."],[35,"نه پیش از تو بیش از تو اندوختند","به بیداد کردن جهان سوختند؟","آیا به جز تو کسی با نادانی و بی‌عدالتی چیزی جمع نکرده است که به خاطر ظلم و ستم خود، دنیا را به آتش کشیدند؟"],[35,"چنان زی که ذکرت به تحسین کنند","چو مردی، نه بر گور نفرین کنند","به‌گونه‌ای زندگی کن که مردم از تو به نیکی یاد کنند و به خاطر کارهای خوبت تو را ستایش کنند، نه اینکه پس از مردنت، بدگو و نفرین‌کننده تو شوند."],[35,"نباید به رسم بد آیین نهاد","که گویند لعنت بر آن، کاین نهاد","نباید بر اساس رسم نادرستی اقدام کرد که مردم بگویند بر آن لعنت و نفرین باد، زیرا این کار نادرست است."],[35,"وگر بر سرآید خداوند زور","نه زیرش کند عاقبت خاک گور؟","اگر کسی که در قدرت است، ظلم و ستم کند، آیا سرانجام او به زیر خاک نمی‌رود و در قبر نمی‌افتد؟"],[35,"بفرمود دلتنگ روی از جفا","که بیرون کنندش زبان از قفا","پادشاه ظالم دستور داد که کسی که از رنج و ظلم او ناراحت است، به خاطر جفا و ستمی که می‌بیند، زبانش را از پشت نگه دارند و آن را بیرون بیاورند."],[35,"چنین گفت مرد حقایق شناس","کز این هم که گفتی ندارم هراس","مردی که به حقیقت‌ها آگاه است، به آنچه که تو گفتی (درباره جفا و بی‌عدالتی) هیچ ترسی ندارد."],[35,"من از بی زبانی ندارم غمی","که دانم که ناگفته داند همی","من از این که بی‌پول و دارایی هستم ناراحت نیستم، زیرا می‌دانم که خداوند حتی آنچه را که در دل دارم و نگفته‌ام می‌داند."],[35,"اگر بینوایی برم ور ستم","گرم عاقبت خیر باشد چه غم؟","اگر شخصی در سختی و فقر باشد و تحت ستم دیگران قرار گیرد، چه غمی دارد وقتی که در نهایت، اوضاع به خوبی پایان می‌یابد؟"],[35,"عروسی بود نوبت ماتمت","گرت نیکروزی بود خاتمت","اگر عروسی و شادی در کار باشد، نوبت سوگواری و غم نیز فرا می‌رسد، و اگر سرنوشت نیک و خوشی باشد، پایان کار خوب خواهد بود."],[36,"یکی مشت زن بخت و روزی نداشت","نه اسباب شامش مهیا نه چاشت","مردی که در زندگی‌اش خوش‌شانس نبود، نه چیزی برای شام داشت و نه برای صبحانه."],[36,"ز جور شکم گل کشیدی به پشت","که روزی محال است خوردن به مشت","به دلیل گرسنگی و فشار زندگی، به سختی و عذاب دچار شده‌ای و هیچ امیدی برای به دست آوردن روزی و خوراک نیست."],[36,"مدام از پریشانی روزگار","دلش حسرت آورد و تن سوگوار","او به‌واسطه مشکلات و پریشانی‌هایی که در زندگی‌اش دارد، همیشه دلش پر از حسرت است و از این وضعیت غمگین و دل‌شکسته به سر می‌برد."],[36,"گهش جنگ با عالم خیره‌کش","گه از بخت شوریده، رویش ترش","گاهی او با دنیا در جنگ است و دیگر زمان‌ها به خاطر بخت بدش، چهره‌اش درهم و ترش‌رو است."],[36,"گه از دیدن عیش شیرین خلق","فرو می‌شدی آب تلخش به حلق","گاه به خاطر دیدن شادی و لذت مردم، دلش می‌گرفت و تلخی زندگی‌اش را با نوشیدن آب تلخ به حلق فرو می‌برد."],[36,"گه از کار آشفته بگریستی","که کس دید از این تلخ‌تر زیستی؟","گاهی از کارهای نامنظم و به‌هم‌ریخته‌ات گریه می‌کنی، اما آیا کسی از این زندگی تلخ‌تر هم دیده است؟"],[36,"کسان شهد نوشند و مرغ و بره","مرا روی نان می‌نبیند تره","برخی افراد زندگی خوبی دارند و از نعمت‌ها بهره‌مند هستند، اما من در فقر و تنگدستی به حدی افتاده‌ام که حتی نمی‌توانم سبزی‌ خردل (تره) روی نان خود ببینم."],[36,"گر انصاف پرسی نه نیکوست این","برهنه من و گربه را پوستین","اگر انصاف را در نظر بگیری، این وضعیت مناسب نیست که من و گربه‌ام بدون پوشش و عریان باشیم و در برابر دیگران قرار بگیریم."],[36,"چه بودی که پایم در این کار گل","به گنجی فرو رفتی از کام دل!","چه چیزی باعث شد که من در این کار، مانند گل، به گنجی بیفتم و از آرزوی دل به واقعیتم نرسم؟"],[36,"مگر روزگاری هوس راندمی","ز خود گرد محنت بیفشاندمی","آیا روزگاری من به دنبال لذت و خوشی نرفتم و خودم را در درد و رنج غوطه‌ور نکردم؟"],[36,"شنیدم که روزی زمین می‌شکافت","عظام زنخدان پوسیده یافت","روزی شنیدم که زمین شکافته شد و استخوان‌های فک و چانه‌ای پوسیده پیدا شد."],[36,"به خاک اندرش عقد بگسیخته","گهرهای دندان فرو ریخته","در خاک، دندان‌هایی که در گذشته به‌عنوان جواهر و ارزشمند شناخته می‌شدند، پخش و پراکنده شده‌اند و دیگر هیچ فایده‌ای ندارند."],[36,"دهان بی زبان پند می‌گفت و راز","که ای خواجه با بینوایی بساز","دهانی که سخن نمی‌گوید، پند و اندرز می‌داد و رازی را فاش می‌کرد که ای آقا، برای زندگی با فقر و تنگدستی باید سازگاری و مدارا کنی."],[36,"نه این است حال دهن زیر گل","شکر خورده انگار یا خون دل","این وضعیت دهان بی‌زبان همچون کسی است که شکر خورده، ولی در واقعش چیزی جز خون دل نیست؛ به عبارتی دیگر، ظاهری شیرین و دل‌نشین دارد، اما باطنی دردناک و غمگین."],[36,"غم از گردش روزگاران مدار","که بی ما بگردد بسی روزگار","غم و اندوه را به خاطر نگردش و تغییرات روزگار نباید تحمل کرد، زیرا بدون وجود ما نیز زمان به حرکت خود ادامه خواهد داد."],[36,"همان لحظه کاین خاطرش روی داد","غم از خاطرش رخت یک سو نهاد","در همان لحظه‌ای که این فکر در دل او شکل گرفت، غم از درون او کنار رفت و از وجودش رخت بربست."],[36,"که ای نفس بی رای و تدبیر و هش","بکش بار تیمار و خود را مکش","ای نفس که نه فکر و تدبیری داری و نه هشیاری، بار غم و درد را به دوش بکش و خودت را رنج نده."],[36,"اگر بنده‌ای بار بر سر برد","وگر سر به اوج فلک بر برد","اگر کسی در سختی‌ها و مشکلاتی زندگی‌اش را تحمل کند و بار سنگینی بر دوش بکشد، یا حتی اگر به اوج عظمت و مقام دست یابد، در نهایت هر دو حالت به سرنوشت او ارتباطی ندارند."],[36,"در آن دم که حالش دگرگون شود","به مرگ از سرش هر دو بیرون شود","زمانی که حالت فرد تغییر کند و مرگ بر او ناگهان فرود آید، در آن لحظه، هر دو (دنیا و آخر) از او جدا خواهند شد."],[36,"غم و شادمانی نماند ولیک","جزای عمل ماند و نام نیک","در نهایت نه غم و شادی باقی می‌ماند، بلکه تنها پاداش اعمال و نام نیک انسان باقی می‌ماند."],[36,"کرم پای دارد، نه دیهیم و تخت","بده کز تو این ماند ای نیکبخت","بخشش و generosity من برعکس سلطنت و تاج و تخت است، زیرا این کار از تو به یادگار می‌ماند و تو را نیکبخت می‌کند."],[36,"مکن تکیه بر ملک و جاه و حشم","که پیش از تو بوده‌ست و بعد از تو هم","به موقعیت و قدرت خود تکیه نکن، زیرا این امتیازها دائمی نیستند و پیش از تو هم افرادی بوده‌اند که در جایگاه تو بودند و بعد از تو نیز خواهند بود."],[36,"خداوند دولت غم دین خورد","که دنیا به هر حال می‌بگذرد","کسی که دارای قدرت و ثروت است، باید نگران سرنوشت دین و مذهب باشد، زیرا دنیا به هر حال به پایان می‌رسد و می‌گذرد."],[36,"نخواهی که ملکت برآید بهم","غم ملک و دین هر دو باید بهم","اگر نمی‌خواهی که سرزمینت دچار ویرانی و نابودی شود، باید به هر دو موضوع ملک و دین اهمیت بدهی و به هر دو رسیدگی کنی."],[36,"زرافشان، چو دنیا بخواهی گذاشت","که سعدی در افشاند اگر زر نداشت","اگر به دنبال دنیای بزرگ و مادیاتی هستی، باید بدانی که سعدی توان افشاندن طلا و ثروت را ندارد، پس در واقعیات زندگی به ثروت و زر مادی نباید بسنده کرد."],[37,"حکایت کنند از جفاگستری","که فرماندهی داشت بر کشوری","از فردی که به بد رفتاری معروف بود و فرمانده یک سرزمین بود، داستان‌هایی روایت می‌کنند."],[37,"در ایام او روز مردم چو شام","شب از بیم او خواب مردم حرام","در زمان او، زندگی مردم به مانند شب‌های تاریک و خوفناک شده بود؛ به‌طوری‌که به خاطر ترس از او، دیگر کسی نمی‌توانست بخوابد و آرامش داشته باشد."],[37,"همه روز نیکان از او در بلا","به شب دست پاکان از او بر دعا","همه روز نیکان (افراد خوب) از مشکلات و مصیبت‌های او (ستمگر) رنج می‌برند و در شب، پاکان (افراد درستکار) به دعا و نیایش روی می‌آورند."],[37,"گروهی بر شیخ آن روزگار","ز دست ستمگر گرستند زار","گروهی از مردم در آن زمان از دست ستمگری به شدت شکایت و ناله می‌کردند و به شدت ناراحت و درمانده بودند."],[37,"که ای پیر دانای فرخنده رای","بگوی این جوان را بترس از خدای","ای پیر دانای خوش فکر، به این جوان بگو که از خدا بترسد."],[37,"بگفتا دریغ آیدم نام دوست","که هر کس نه در خورد پیغام اوست","او می‌گوید که متأسف است که نام دوست را بر زبان بیاورد، زیرا هر کسی که سزاوار نیست، نمی‌تواند پیام او را درک کند."],[37,"کسی را که بینی ز حق بر کران","منه با وی، ای خواجه، حق در میان","اگر کسی را دیدی که از حقیقت دور است و به آن معتقد نیست، ای بزرگوار، با او بحث نکن و حقایق را برایش مطرح نکن، چون او توانایی درک آن را ندارد."],[37,"دریغ است با سفله گفت از علوم","که ضایع شود تخم در شوره بوم","حیف است که با آدم‌های پست درباره علم و دانش سخن بگویی، زیرا مثل این است که دانه‌ای را در خاک شور بکاری که هیچ نتیجه‌ای نخواهد داشت."],[37,"چو در وی نگیرد عدو داندت","برنجد به جان و برنجاندت","وقتی که دشمن در وجودت نفوذ می‌کند، به خوبی می‌فهمد که چگونه می‌تواند تو را آزار دهد و رنجاندنت کند."],[37,"تو را عادت، ای پادشه، حق روی است","دل مرد حق گوی از این جا قوی است","ای پادشاه، این عادت تو است که باید حقیقت را ببینی و با دل راست‌گوی خود بر این اساس عمل کنی، زیرا دل مردان راستین در اینجا از استحکام و قدرت برخوردار است."],[37,"نگین خصلتی دارد ای نیکبخت","که در موم گیرد نه در سنگ سخت","انسانی نیکبخت و با خصلت خوب، مانند انگشتری است که در موم شکل می‌گیرد و به راحتی می‌توان تغییرش داد؛ اما در سنگ سخت، هیچ نشانه‌ای نمی‌توان به جا گذاشت. این بدان معناست که انسان‌های خوب قابلیت پذیرش نصیحت و تغییر دارند، در حالی که افراد سخت‌دل این امکان را ندارند."],[37,"عجب نیست گر ظالم از من به جان","برنجد که دزد است و من پاسبان","تعجبی ندارد اگر ظالم از من که نگهبان هستم، به خاطر وظیفه‌ام ناراضی باشد، چون او خود مانند دزدی است که در برابر نگهبان قرار دارد."],[37,"تو هم پاسبانی به انصاف و داد","که حفظ خدا پاسبان تو باد","تو نیز باید با انصاف و عدالت، جان خود را حفظ کنی و از خداوند بخواه تا نگهبان تو باشد."],[37,"تو را نیست منت ز روی قیاس","خداوند را من و فضل و سپاس","تو از طرف خداوند هیچگونه نیازی به سپاسگزاری من نداری، زیرا او خود به فضل و رحمتش به من لطف کرده است."],[37,"که در کار خیرت به خدمت بداشت","نه چون دیگرانت معطل گذاشت","شخصی که در انجام کارهای نیک به تو کمک می‌کند، او مانند دیگران که فقط مانع می‌شوند و در کار خیر تلاشی نمی‌کنند، تو را تنها نمی‌گذارد."],[37,"همه کس به میدان کوشش درند","ولی گوی بخشش نه هر کس برند","همه افراد در تلاش و کوشش هستند، اما همه آنها موفق به کسب خوی generosity یا بخشندگی نمی‌شوند."],[37,"تو حاصل نکردی به کوشش بهشت","خدا در تو خوی بهشتی بهشت","تو با تلاش و کوشش نتوانستی بهشت الهی را به دست آوری، زیرا در وجود تو خصیصه‌های بهشتی وجود ندارد."],[37,"دلت روشن و وقت مجموع باد","قدم ثابت و پایه مرفوع باد","دل تو باید روشن و شاداب باشد و زمانه هم بر وفق مرادت باشد. امیدوارم که قدم‌هایت استوار و پایت نیز در جایگاه بلندی باشد."],[37,"حیاتت خوش و رفتنت بر صواب","عبادت قبول و دعا مستجاب","زندگی‌ات خوش و نیکو باشد و رفتن و خروجت بر وفق عقل و تدبیر باشد؛ عبادتت پذیرفته و دعایت مستجاب گردد."],[38,"همی تا برآید به تدبیر کار","مدارای دشمن به از کارزار","تا آن هنگام که کارها[ی آماده‌ شدن برای جنگ را راست و ریست کنیم] و تدبیرها و آماده‌سازی برای جنگ را به پایان می‌رسانیم، بهتر است که با دشمنان مدارا کنیم تا اینکه وارد جنگ شویم."],[38,"چو نتوان عدو را به قوت شکست","به نعمت بباید در فتنه بست","اگر نتوانی دشمن را با قدرت شکست دهی، بهتر است با بخشش و نعمت دادن او را از فتنه و شر خود دور کنی."],[38,"گر اندیشه باشد ز خصمت گزند","به تعویذ احسان زبانش ببند","اگر فکر می‌کنی که دشمن از تو آزار می‌بیند، زبان او را با احسان و کمک بستی، تا نتواند آسیب برساند."],[38,"عدو را به جای خسک زر بریز","که احسان کند کند، دندان تیز","برای دشمن، به جای قهر و خشونت، طلا و نعمت بپاش تا به این وسیله با بخشش و نیکی، او را به دوستی واداری و از نیش زبانی‌اش بکاهی."],[38,"چو دستی نشاید گزیدن، ببوس","که با غالبان، چاره زرق است و لوس","وقتی نمی‌توانی خود را از خطر نجات دهی، باید با کسانی که در قدرت هستند، رابطه خوبی برقرار کنی؛ زیرا در برابر غالب‌ها، راهی جز تملق و اظهار محبت وجود ندارد."],[38,"به تدبیر، رستم در آید به بند","که اسفندیارش نجست از کمند","با تدبیر و سیاست، رستم به دام خواهد افتاد، زیرا اسفندیار نتوانست از چنگال کمند رهایی یابد."],[38,"عدو را به فرصت توان کند پوست","پس او را مدارا چنان کن که دوست","دشمن را می‌توان در فرصتی مهار کرد، پس باید با او مانند دوست رفتار کنید و مدارا کنید."],[38,"حذر کن ز پیکار کمتر کسی","که از قطره سیلاب دیدم بسی","از درگیر شدن و جنگ کردن بپرهیز، زیرا کسانی را دیده‌ام که به خاطر یک قطره باران، به شدت تحت تاثیر قرار گرفته‌اند و آسیب دیده‌اند."],[38,"مزن تا توانی بر ابرو گره","که دشمن اگرچه زبون، دوست به","برای اینکه تو را اذیت نکند یا به تو آسیب نرساند، نباید بر ابرو (موارده) خود گره بگذاری و نشان دهنده سخت‌گیری باشی، زیرا حتی اگر دشمن ضعیف باشد، تو نمی‌دانی او چه زمانی می‌تواند به تو ضربه بزند."],[38,"بود دشمنش تازه و دوست ریش","کسی کش بود دشمن از دوست بیش","اگرچه دشمن به تازگی آماده‌ای برای نبرد است، اما کسی که دوستانش ریش دارد (یعنی بزرگ و با تجربه است) می‌تواند او را بیشتر از دوستانش به حساب آورد."],[38,"مزن با سپاهی ز خود بیشتر","که نتوان زد انگشت بر نیشتر","هرگز بر کسی که سپاهش از تو بیشتر است، حمله نکن، چون نمی‌توانی به او آسیب برسانی حتی به اندازه‌ای که با انگشت بر نوک نیزه فشار بیاوری."],[38,"وگر زو تواناتری در نبرد","نه مردی است بر ناتوان زور کرد","اگر در میدان نبرد از او توانمندتری، مردانگی نیست که بر ناتوان زور بگویی."],[38,"اگر پیل زوری وگر شیر چنگ","به نزدیک من صلح بهتر که جنگ","اگر فیل و شیر هر دو قدرت و زور دارند، بهتر است که با من صلح کنید تا جنگ نکنید."],[38,"چو دست از همه حیلتی در گسست","حلال است بردن به شمشیر دست","زمانی که تمام تدبیرها و راه‌های فریب به نتیجه نرسد، استفاده از شمشیر برای حق گرفتن مجاز است."],[38,"اگر صلح خواهد عدو سر مپیچ","وگر جنگ جوید عنان بر مپیچ","اگر دشمن دنبال صلح است، او را به حرفش نرسان و اجازه نده که از هدفش منحرف شود، و اگر او به جنگ تمایل دارد، فرصت را برای او محدود کن و کنترلی بر کار او داشته باش."],[38,"که گر وی ببندد در کارزار","تو را قدر و هیبت شود یک، هزار","اگر دشمن درهای جنگ را به روی تو ببندد، ارزش و قدرت تو به اندازه هزار برابر خواهد شد."],[38,"ور او پای جنگ آورد در رکاب","نخواهد به حشر از تو داور حساب","اگر او (دشمن) در میدان جنگ بیفتد، دیگر نمی‌تواند در روز قیامت از تو (شخصی که آماده جنگ است) برای آشتی و بخشش درخواست کند."],[38,"تو هم جنگ را باش چون کینه خواست","که با کینه‌ور مهربانی خطاست","اگر کسی خواهان جنگ باشد، تو نیز باید با او به جنگ بروی، زیرا در این مورد مهربانی و نرمی بی‌فایده است و تنها به کینه‌وران کمک می‌کند."],[38,"چو با سفله گویی به لطف و خوشی","فزون گرددش کبر و گردن‌کشی","هرگاه با افراد پست و بی‌ارزش با محبت و نرمی سخن بگویی، آنها به غرور و تکبر بیشتری دچار می‌شوند و سرکشی می‌کنند."],[38,"به اسبان تازی و مردان مرد","بر آر از نهاد بداندیش گرد","برای مقابله با دشمنان بداندیش، تو باید از اسبان تند و شجاع و مردان دلیر کمک بگیری و جمع‌آوری نیرو کنی."],[38,"و گر می بر آید به نرمی و هوش","به تندی و خشم و درشتی مکوش","اگر دشمن به آرامی و تدبیر پیش بیاید، با خشونت و خشم و تندی مقابل او نرو."],[38,"چو دشمن به عجز اندر آمد ز در","نباید که پرخاش جویی دگر","وقتی که دشمن از در ناتوانی وارد می‌شود، نباید باز به او حمله و پرخاش کرد."],[38,"چو زنهار خواهد کرم پیشه کن","ببخشای و از مکرش اندیشه کن","هرگاه دشمن به زنهار و عذرخواهی بیفتد، باید بخشش و بزرگواری را در پیش بگیری و از مکر و نیرنگ او دوری کنی."],[38,"ز تدبیر پیر کهن بر مگرد","که کارآزموده بود سالخورد","به سخن مشاور کهن‌سال اعتماد کن و از تجربیات او بهره ببر، زیرا او دارای تجربه و آگاهی زیادی است."],[38,"در آرند بنیاد رویین ز پای","جوانان به نیروی و پیران به رای","بنیاد کارها را جوانان به جانفشانی و قدرت بدست می‌آورند، در حالی که پیران با دانش و تدبیر خود کمک می‌کنند."],[38,"بیندیش در قلب هیجا مفر","چه دانی که زان که باشد ظفر؟","خود را در شرایط سخت و دشوار به آرامش برسان و فکر کن، زیرا نمی‌دانی که پیروزی از کجا به دست می‌آید."],[38,"چو بینی که لشکر ز هم دست داد","به تنها مده جان شیرین به باد","وقتی می‌بینی که سپاه از یکدیگر جدا شده است، جان شیرین خود را به خطر نینداز و به تنهایی اقدام نکن."],[38,"اگر بر کناری به رفتن بکوش","وگر در میان لبس دشمن بپوش","اگر در حال حاضری و در خطر هستی، یا باید تلاش کنی تا کنار بروی، یا اگر نمی‌توانی، خودت را در میان دشمن پنهان کن و به ظاهر طوری رفتار کن که حواسشان را جلب نکنی."],[38,"وگر خود هزاری و دشمن دویست","چو شب شد در اقلیم دشمن مایست","اگر تو یک هزار نفر هستی و دشمن دویست نفر، وقتی شب شود در سرزمین دشمن بایست."],[38,"شب تیره پنجه سوار از کمین","چو پانصد به هیبت بدرد زمین","در شب تاریک، سواران کمین‌نشین به قدری قوی و شجاع هستند که گویی با پنج‌صد نفر به زمین فشار می‌آورند و به دشمن آسیب می‌زنند."],[38,"چو خواهی بریدن به شب راه‌ها","حذر کن نخست از کمینگاه‌ها","اگر می‌خواهی در شب به سفر بروی و از راه‌ها عبور کنی، باید ابتدا از محل‌های کمین (جایی که دشمن در انتظار نشسته) احتیاط کنی و مراقب باشی."],[38,"میان دو لشکر چو یک روز راه","بماند، بزن خیمه بر جایگاه","اگر در میانه دو لشکر در روزی توقف کنی، بهتر است خیمه‌ات را در نقطه‌ای ثابت و مناسب برپا کنی."],[38,"گر او پیشدستی کند غم مدار","ور افراسیاب است مغزش بر آر","اگر او (دشمن) زودتر اقدام کند، جای غم نیست، زیرا حتی اگر او افراسیاب باشد، عقل او را زیر سؤال ببر."],[38,"ندانی که لشکر چو یک روزه راند","سر پنجه زورمندش نماند","تو نمی‌دانی که لشکر، با یک روز راندن، به قدرت و زورمندی خود، سر بر نخواهد داشت و نمی‌تواند مقاومت کند."],[38,"تو آسوده بر لشکر مانده زن","که نادان ستم کرد بر خویشتن","تو در آرامش و آسایش بر لشکر بایست و نترس، زیرا نادانی که بر خود ستم کند، در واقع به خود آسیب می‌زند."],[38,"چو دشمن شکستی بیفکن علم","که بازش نیاید جراحت به هم","وقتی که دشمن را شکست دادی، پرچم خود را به زمین بینداز و دیگر به او فرصتی نده که زخم‌هایی که به او وارد شده را جبران کند."],[38,"بسی در قفای هزیمت مران","نباید که دور افتی از یاوران","در پی شکست دشمن نباید به تعقیب او بپردازی؛ زیرا ممکن است از یاران خود دور شوی و تنها بمانی."],[38,"هوا بینی از گرد هیجا چو میغ","بگیرند گردت به زوبین و تیغ","اگر در هوای جنگ تو را به دور بزنند و محاصره کنند، چاره‌ات این است که به خودت و سلاح‌هایت اعتماد کنی، مانند پرنده‌ای که در آسمان پرواز می‌کند و به دقت مراقب است."],[38,"به دنبال غارت نراند سپاه","که خالی بماند پس پشت شاه","سپه باید به دنبال غارت نرود تا پشت شاه خالی نماند و او در خطر قرار نگیرد."],[38,"سپه را نگهبانی شهریار","به از جنگ در حلقه کارزار","نگهبانی و حفاظت سپاه توسط شهریار و امیر، از جنگ در میدان نبرد بهتر است و اهمیت بیشتری دارد."],[39,"دلاور که باری تهور نمود","بباید به مقدارش اندر فزود","شجاعی که یک بار جرأت به خرج داده، باید متناسب با آن شجاعتش از خود بیشتر نشان دهد."],[39,"که بار دگر دل نهد بر هلاک","ندارد ز پیکار یأجوج باک","اگر دوباره دلش به سوی نابودی برود، از جنگ با یأجوج (موجوداتی افسانه‌ای که در آخرالزمان به آدمیان آسیب می‌زنند) ترسی ندارد."],[39,"سپاهی در آسودگی خوش بدار","که در حالت سختی آید به کار","سپاهی را که در زمان آرامش خوشحال است، در مواقع دشواری به کار می‌آید."],[39,"سپاهی که کارش نباشد به برگ","چرا دل نهد روز هیجا به مرگ؟","سپر و جنگجویانی که در صلح و آسایش هستند، چرا باید دل به خطر و مرگ بدهند و خود را در معرض جنگ قرار دهند؟"],[39,"کنون دست مردان جنگی ببوس","نه آنگه که دشمن فرو کوفت کوس","اکنون است که باید دست سربازان را ببوسید، نه زمانی که دشمن به شما ضربه می‌زند و به جنگ می‌آید."],[39,"نواحی ملک از کف بدسگال","به لشکر نگه دار و لشکر به مال","باید از مردان جنگی حفاظت کرد تا سرزمین تحت تسلط افراد بد و شریر نباشد و لشکر نیز نسبت به مال و دارایی‌های خود محافظت کند."],[39,"ملک را بود بر عدو دست، چیر","چو لشکر دل آسوده باشند و سیر","چون پادشاه بر دشمن تسلط داشته باشد، دل سربازان آرام و راضی خواهد بود و در آسایش خواهند زندگی کرد."],[39,"بهای سر خویشتن می‌خورد","نه انصاف باشد که سختی برد","اگر کسی به خاطر حفظ جان خود از خطر عبور کند و به دیگران ظلم کند، این رفتار عادلانه و درست نیست و به سختی متکی بودن به زندگی خود نمی‌ارزد."],[39,"چو دارند گنج از سپاهی دریغ","دریغ آیدش دست بردن به تیغ","وقتی سپاهی گنج و ثروت دارد، برای او بسیار دشوار است که به جنگ و درگیری با شمشیر بپردازد."],[39,"چه مردی کند در صف کارزار","که دستش تهی باشد و کار، زار","مردی که در میدان جنگ باشد، بهتر است نبود او تا اینکه دستش به سلاح خالی باشد و نتواند در مبارزه شرکت کند."],[40,"به پیکار دشمن دلیران فرست","هژبران به ناورد شیران فرست","در میدان نبرد، دلیران را به جنگ با دشمن بفرست و فرماندهان کاردان را به نبرد شیران بفرست."],[40,"به رای جهاندیدگان کار کن","که صید آزموده‌ست گرگ کهن","با خرد و تدبیر کسانی که دنیا را دیده‌اند و تجربه دارند، عمل کن؛ زیرا شکارچی ماهر، گرگ کهنه را می‌شناسد و با آن بازی نمی‌کند."],[40,"مترس از جوانان شمشیر زن","حذر کن ز پیران بسیار فن","از جوانان شمشیرزن نترس، بلکه از افراد پیر که تجربه و حیله‌های زیادی دارند، باید احتیاط کنی."],[40,"جوانان پیل افکن شیرگیر","ندانند دستان روباه پیر","جوانان قوی و بی‌پروا نمی‌دانند که تدبیر و نیرنگ پیران با تجربه را باید شناخت."],[40,"خردمند باشد جهاندیده مرد","که بسیار گرم آزموده‌ست و سرد","مردی که تجربه‌دیده و خردمند است، کسی است که در زندگی فراز و نشیب‌های زیادی را پشت سر گذاشته و در مواجهه با چالش‌ها قوی و صبور بوده است."],[40,"جوانان شایسته بخت ور","ز گفتار پیران نپیچند سر","جوانان باهوش و خوشبخت، نباید از سخنان حکیمانه و تجربه‌های پیران خود دور شوند و به آن‌ها بی‌اعتنا باشند."],[40,"گرت مملکت باید آراسته","مده کار معظم به نوخاسته","اگر می‌خواهی کشورت را سامان‌دهی، به جوانان بی‌تجربه کار مهم واگذار نکن."],[40,"سپه را مکن پیشرو جز کسی","که در جنگها بوده باشد بسی","سردمدار سپاه را باید انتخاب کنی که تجربه و سابقه جنگی داشته باشد و در نبردها آزموده باشد."],[40,"به خردان مفرمای کار درشت","که سندان نشاید شکستن به مشت","به انسان‌های کم‌خود با فکر و خرد، کارهای بزرگ و سخت ندهید، زیرا مانند این است که بخواهید سندان (چکش فلزی بزرگ برای آهنگری) را با مشت بشکنید؛ این کار شدنی نیست."],[40,"رعیت نوازی و سر لشکری","نه کاری است بازیچه و سرسری","محبت به رعایای خود و فرماندهی در جنگ، کارهایی نیستند که بشود آنها را بازیچه و سرسری گرفت."],[40,"نخواهی که ضایع شود روزگار","به ناکاردیده مفرمای کار","اگر نمی‌خواهی که زمانت هدر برود، کارها را به دست فرد ناآزموده نسپار."],[40,"نتابد سگ صید روی از پلنگ","ز روبه رمد شیر نادیده جنگ","سگ شکاری و کار دیده پلنگ را نیز از پای در می‌آورد، حال آنکه شیر بی تجربه حتی از روباه گریزان می‌شود"],[40,"چو پرورده باشد پسر در شکار","نترسد چو پیش آیدش کارزار","اگر پسری از کودکی در شکار تربیت شده باشد، وقتی که با میدان جنگ روبرو شود، ترسی نخواهد داشت."],[40,"به کشتی و نخجیر و آماج و گوی","دلاور شود مرد پرخاشجوی","مرد جنگجویی که در کارهای سخت و خطرناک مانند کشتی‌گیری، شکار و تیراندازی مهارت پیدا کرده باشد، به خاطر دلاوری‌اش در برابر چالش‌ها و جنگ‌ها شجاع و نترس می‌شود."],[40,"به گرمابه پرورده و عیش و ناز","برنجد چو بیند در جنگ باز","مردی که در شرایط راحتی و خوش‌گذرانی بزرگ شده و عیش و ناز را تجربه کرده است، وقتی در میدان جنگ با سختی‌ها روبرو شود، می‌ترسد و ناراحت می‌شود."],[40,"دو مردش نشانند بر پشت زین","بود کش زند کودکی بر زمین","دو مرد را که بر روی زین اسب نشسته‌اند، نشانده‌اند و در حال جنگ هستند و کودکی را که بر روی زمین افتاده، می‌زنند."],[40,"یکی را که دیدی تو در جنگ پشت","بکش گر عدو در مصافش نکشت","اگر در جنگ مردی را دیدی که به عقب می‌رود و نمی‌جنگد، بدان که او می‌ترسد و اگر دشمن هم او را نکشد، نشان از ضعف اوست."],[40,"مخنث به از مرد شمشیر زن","که روز وغا سر بتابد چو زن","مردی که در جنگ شمشیر می‌زند، از مردی که فقط به خاطر زن بودنش به میدان می‌رود، بهتر است. زیرا در روز نبرد، اگر او را به ترس بیندازند و سرش پایین بیفتد، مانند زن می‌شود."],[40,"چه خوش گفت گرگین به فرزند خویش","چو قربان پیکار بربست و کیش","گرگین به فرزندش خوب گفت که اگر در میدان جنگ به قربانی کردن دشمن بپردازی و کار را با دقت و استحکام انجام دهی، این کار پسندیده‌ای است."],[40,"اگر چون زنان جست خواهی گریز","مرو آب مردان جنگی مریز","اگر می‌خواهی مانند زنان فرار کنی، نرو؛ به این دلیل که آبرو و اعتبار مردان جنگی را خدشه‌دار نکن."],[40,"سواری که در جنگ بنمود پشت","نه خود را که نام آوران را بکشت","سوار جنگی که در میدان نبرد نشان داد چگونه می‌جنگد، تنها به این خاطر نیست که خود را به خطر می‌اندازد، بلکه به دلیل توانایی‌اش در کشتن قهرمانان و نام‌آوران است."],[40,"شجاعت نیاید مگر زآن دو یار","که افتند در حلقه کارزار","شجاعت فقط از دو دوست با هم به وجود می‌آید که در میدان نبرد به هم کمک کنند."],[40,"دو همجنس همسفره همزبان","بکوشند در قلب هیجا به جان","دو انسان همجنس و همزبان که در یک سفر هستند، باید در دل نبرد و دشواری‌ها با هم یاری کنند و تلاش کنند تا از جان خود دفاع کنند."],[40,"که تنگ آیدش رفتن از پیش تیر","برادر به چنگال دشمن اسیر","زمانی که برادر در وضعیتی سخت و خطرناک گرفتار شود و نتواند به راحتی فرار کند، او باید با تمام قدرت و تدبیر از خود دفاع کند تا اسیر دست دشمن نشود."],[40,"چو بینی که یاران نباشند یار","هزیمت ز میدان غنیمت شمار","وقتی ببینی که یارانت در میدان نباشند، شکست را به عنوان غنیمت در نظر بگیر."],[41,"دو تن، پرور ای شاه کشور گشای","یکی اهل رزم و دگر اهل رای","دو نفر را پرورش بده، ای پادشاهی که سرزمین‌ها را فتح می‌کنی؛ یکی از آن‌ها جنگجو و دیگری اندیشمند باشد."],[41,"ز نام آوران گوی دولت برند","که دانا و شمشیر زن پرورند","از شخصیت‌های مشهور و برجسته، نامی که برآورده شود، یعنی حکومت و موفقیت به دست می‌آید، زیرا هم دانشمندان و هم جنگاوران را پرورش می‌دهند."],[41,"هر آن کاو قلم را نورزید و تیغ","بر او گر بمیرد مگو ای دریغ","هر کسی که به قلم و هنر خود بی‌اعتنا باشد و اگر هم کشته شود، نگوید افسوس که چرا اینگونه شد."],[41,"قلم زن نکودار و شمشیر زن","نه مطرب که مردی نیاید ز زن","کسانی که با قلم و هنر خوب کار می‌کنند و کسانی که با شمشیر به جنگ می‌روند، نباید در کار خود بی‌اختیار و ناتوان باشند؛ زیرا مردانی از میان زنان پیدا نمی‌شوند."],[41,"نه مردی است دشمن در اسباب جنگ","تو مدهوش ساقی و آواز چنگ","در شرایط جنگ و نزاع، هیچ دشمنی وجود ندارد؛ پس خود را در لذت‌های ساقی و صدای چنگ غرق نکن."],[41,"بسا اهل دولت به بازی نشست","که دولت برفتش به بازی ز دست","بسیاری از کسانی که در مقام قدرت و ثروت هستند، به خوش‌گذرانی و سرگرمی مشغول می‌شوند، اما در این حال، از دست دادن قدرت و ثروتشان نزدیک است و به زودی همه چیز را از دست می‌دهند."],[42,"نگویم ز جنگ بد اندیش ترس","در آوازه صلح از او بیش ترس","نگویم که نباید از جنگ بداندیش ترسید، بلکه باید از آوازه صلح که در واقع ممکن است نیرنگی باشد، بیشتر ترسید."],[42,"بسا کس به روز آیت صلح خواند","چو شب شد سپه بر سر خفته راند","بسیاری از افراد در زمان صلح، به ظاهر به آرامش و سازش دعوت می‌کنند، اما وقتی شب می‌شود، نیروهای نظامی را برای جنگ آماده می‌کنند."],[42,"زره پوش خسبند مرد اوژنان","که بستر بود خوابگاه زنان","مردانی که زره می‌پوشند و آماده جنگ هستند در آرامش می‌خوابند، اما جایی که بستر زنان است، جای خواب آن‌ها نیست."],[42,"به خیمه درون مرد شمشیر زن","برهنه نخسبد چو در خانه زن","در خیمه، مردی که شمشیر به دست دارد، نباید خواب باشد، مانند زنی که در خانه‌اش آرامش دارد. این بیت تاکید می‌کند که در زمان خطر نباید بی‌احتیاط و غافل بود."],[42,"بباید نهان جنگ را ساختن","که دشمن نهان آورد تاختن","باید جنگ را به صورت پنهانی آماده کرد، زیرا دشمن به طور ناگهانی و مخفیانه حمله می‌کند."],[42,"حذر کار مردان کار آگه است","یزک سد رویین لشکر گه است","حذر و احتیاط در کار مردان آگاه و دانا، مانند سپری است که از حمله‌ی دشمن جلوگیری می‌کند."],[43,"میان دو بدخواه کوتاه دست","نه فرزانگی باشد ایمن نشست","در میان دو دشمن با نیت بد، کسی که دستش کوتاه است و به فکر تدبیر و عاقلانه عمل نمی‌کند نمی‌تواند احساس امنیت داشته باشد."],[43,"که گر هر دو باهم سگالند راز","شود دست کوتاه ایشان دراز","اگر هر دو بدخواه با هم به دشمنی بپردازند، راز و نقشه‌شان فاش می‌شود و قدرت آن‌ها برای آسیب رساندن کاهش می‌یابد."],[43,"یکی را به نیرنگ مشغول دار","دگر را برآور ز هستی دمار","یکی را با نیرنگ و فریب مشغول کن، و دیگری را از هستی و معیشت بینداز و از میان ببر."],[43,"اگر دشمنی پیش گیرد ستیز","به شمشیر تدبیر خونش بریز","اگر دشمنی به جنگ با تو بیاید، بهتر است با تدبیر و هوشمندی به او ضربه بزنی و او را به زانو درآوری."],[43,"برو دوستی گیر با دشمنش","که زندان شود پیرهن بر تنش","با دشمن خود دوست شو، تا او در دست شما بیفتد و مانند زندانی که پیراهنی بر تن دارد، به تسلیم درآید."],[43,"چو در لشکر دشمن افتد خلاف","تو بگذار شمشیر خود در غلاف","زمانی که در سپاه دشمن اختلاف ایجاد شود، بهتر است که شمشیر خود را به غلاف بگذاری و از جنگ پرهیز کنی."],[43,"چو گرگان پسندند بر هم گزند","بر آساید اندر میان گوسفند","وقتی که گرگ‌ها در حالت جنگ و آشفتگی با هم قرار بگیرند، گوسفندها می‌توانند در میانه آرامش داشته باشند و از خطر دور بمانند."],[43,"چو دشمن به دشمن بود مشتغل","تو با دوست بنشین به آرام دل","زمانی که دشمن مشغول درگیری با دشمن دیگر است، تو با دوستانت در آرامش بنشین و استراحت کن."],[44,"چو شمشیر پیکار برداشتی","نگه دار پنهان ره آشتی","وقتی که شمشیر برای جنگ برداشتی، باید مراقب باشی و در خفا به دنبال راه صلح بگردی."],[44,"که لشکر شکوفان مغفر شکاف","نهان صلح جستند و پیدا مصاف","چندین لشکر قوی و آماده جنگ در خفا به دنبال صلح هستند، اما بر سر راه آنها مبارزه واقعی آشکار است."],[44,"دل مرد میدان نهانی بجوی","که باشد که در پایت افتد چو گوی","به تلاش بپرداز تا در میان جنگ و نبرد، حقیقت دل و نیت مردان را بشناسی، زیرا ممکن است که یکی از آنان به تو آسیب برساند، همچون گوی که به زمین سقوط می‌کند."],[44,"چو سالاری از دشمن افتد به چنگ","به کشتن درش کرد باید درنگ","اگر رهبری از دشمن به دست تو بیفتد، باید در کشتن او تأمل کنی و زود اقدام نکنی."],[44,"که افتد کز این نیمه هم سروری","بماند گرفتار در چنبری","اگر دشمنی که به دست می‌آید، به وسیله نیرنگ یا آزار، از دست برود، در این صورت قدرت و رهبری او نیز باقی نخواهد ماند و همواره در تنگنا و دشواری گرفتار خواهد شد."],[44,"اگر کشتی این بندی ریش را","نبینی دگر بندی خویش را","اگر نمی‌توانی به وضعیت سخت و دردناک خودت توجه کنی و رنجی که گرفتار آن هستی را درک کنی، پس چگونه می‌توانی به مشکلات دیگران اهمیت بدهی؟"],[44,"نترسد که دورانش بندی کند","که بر بندیان زورمندی کند؟","نگران نباشد که زمان او را به بندگی درآورد، زیرا کسانی که به بندگان زور می‌گویند، خودشان هم ممکن است تحت سلطه قرار بگیرند."],[44,"کسی بندیان را بود دستگیر","که خود بوده باشد به بندی اسیر","کسی که دیگران را در بند می‌کند، ممکن است خود نیز زمانی در بند بوده باشد."],[44,"اگر سر نهد بر خطت سروری","چو نیکش بداری، نهد دیگری","اگر کسی به خاطر محبت یا احترام به تو، به زانو درآید و سرش را بر زمین بگذارد، اگر خوبی و مهربانی را نسبت به او حفظ کنی، او نیز به دوستی و احترام به تو ادامه خواهد داد."],[44,"اگر خفیه ده دل بدست آوری","از آن به که صد ره شبیخون بری","اگر بتوانی دل کسی را نهان به دست آوری (یعنی او را به محبت و دوستی خود درآوری) بهتر از این است که صد بار به او حمله کنی و از او انتقام بگیری."],[45,"گرت خویش دشمن شود دوستدار","ز تلبیسش ایمن مشو زینهار","اگر خویشاوندت دشمن تو شود و به دروغ دوست‌داشتن خود را نشان دهد، از نیرنگ او ایمن نباش؛ حواس‌ات را جمع کن."],[45,"که گردد درونش به کین تو ریش","چو یاد آیدش مهر پیوند خویش","اگر کسی در ظاهر دوستی نشان دهد ولی در باطن نسبت به تو کینه داشته باشد، وقتی که او به یاد محبت و پیوند شما بیفتد، ممکن است نسبت به تو حسادت و کینه‌ورزی کند."],[45,"بد اندیش را لفظ شیرین مبین","که ممکن بود زهر در انگبین","با دشمن بداندیش نباید با زبانی شیرین و خوش سخن گفت، زیرا ممکن است او مانند زهر، ضرر و آسیب به همراه داشته باشد، حتی اگر در ظاهر خوشایند و جذاب به نظر برسد."],[45,"کسی جان از آسیب دشمن ببرد","که مر دوستان را به دشمن شمرد","کسی می‌تواند از آسیب دشمن در امان باشد که دوستانش را با دشمنانش یکی نبیند و به آنها بی‌اعتماد باشد."],[45,"نگه دارد آن شوخ در کیسه در","که بیند همه خلق را کیسه بر","آن فرد بازیگوش و شاداب، وقتی در کیسه‌اش را می‌بندد، به این خاطر است که می‌بیند همه مردم به کیسه‌های خود توجه دارند و در فکر مال و دارایی هستند."],[45,"سپاهی که عاصی شود در امیر","ورا تا توانی به خدمت مگیر","اگر سربازی نسبت به فرمانده خود نافرمان باشد، هرگز به خدمت او درنیایید و او را در کارها کمک نکنید."],[45,"ندانست سالار خود را سپاس","تو را هم ندارد، ز غدرش هراس","سالاری که نتواند نعمت و لطف اطرافیانش را بشناسد، به تو هم نسبت وفایی نخواهد داشت و از خصلت‌های بد او باید ترسید."],[45,"به سوگند و عهد استوارش مدار","نگهبان پنهان بر او بر گمار","به سوگند و عهدی که او را به آن وابسته کرده، به هیچ وجه نباید نگهبانی پنهانی برای او تعیین کنی، زیرا ممکن است به او آسیب برساند."],[45,"نو آموز را ریسمان کن دراز","نه بگسل که دیگر نبینیش باز","اگر کسی تازه‌کار است، باید او را با آموزش و پرورش درازمدت به خوبی راهنمایی کرد تا از مسیر درست منحرف نشود، زیرا در این صورت ممکن است دیگر نتوان به او دسترسی پیدا کرد و اصلاحش کرد."],[45,"چو اقلیم دشمن به جنگ و حصار","گرفتی، به زندانیانش سپار","هرگاه که دشمنان را در محاصره و جنگ قرار دادی، باید آن‌ها را به اسیران و زندانیان خود بسپاری."],[45,"که بندی چو دندان به خون در برد","ز حلقوم بیدادگر خون خورد","بند، در اینجا به معنای زنجیر یا قید است که به شکل دندانه‌ای در خون مانند می‌شود، و این تصویر نشان‌دهنده درد و فشاری است که بیدادگر به مردم وارد می‌کند. در واقع، این بیت به ظلم و ستم بیدادگری اشاره دارد که باعث رنج و خونریزی مردم می‌شود."],[45,"چو بر کندی از دست دشمن دیار","رعیت به سامان تر از وی بدار","زمانی‌که آسیب و ضرر از دشمنی به دست بیاید، رعیت و مردم در وضعی بهتر و منظم‌تر از او به زندگی ادامه می‌دهند."],[45,"که گر باز کوبد در کارزار","بر آرند عام از دماغش دمار","اگر دشمن در میدان نبرد بار دیگر به جنگ بیفتد، مردم عادی با تمام قدرت و انرژی خود، او را از پا در می‌آورند و از او انتقام می‌گیرند."],[45,"وگر شهریان را رسانی گزند","در شهر بر روی دشمن مبند","اگر به مردم شهر آسیبی برسد، در برابر دشمن درنگ نکن و بی‌درنگ از شهر دفاع کن."],[45,"مگو دشمن تیغ زن بر در است","که انباز دشمن به شهر اندر است","نباید بگویی که دشمن با شمشیر در بیرون در است، زیرا هم‌پیمان او (دشمن) در درون شهر حضور دارد و برای خیانت آماده است."],[46,"به تدبیر جنگ بد اندیش کوش","مصالح بیندیش و نیت بپوش","در تدبیر جنگ، به جای بدبین شدن و فکرهای ناپسند، باید به اندیشیدن درباره مصالح و منافع اقدام کنی و نیّت خود را پنهان نگه‌داری."],[46,"منه در میان راز با هر کسی","که جاسوس هم کاسه دیدم بسی","هرگز راز خود را با هرکسی در میان نگذار، حتی اگر با کسی که به او اعتماد داری، زیرا ممکن است او جاسوس باشد و راز تو را لو دهد."],[46,"سکندر که با شرقیان حرب داشت","در خیمه گویند در غرب داشت","سکندر که با مردمان شرقی جنگ داشت، در خیمه‌ای می‌نشسته است که در سمت غرب قرار دارد."],[46,"چو بهمن به زاولستان خواست شد","چپ آوازه افکند و از راست شد","وقتی بهمن، که یکی از شخصیت‌های اسطوره‌ای ایرانی است، به زاولستان (منطقه‌ای در ایران باستان) رفت، از سمت چپ صدا و شوری به پا کرد و به سمت راست حرکت کرد."],[46,"اگر جز تو داند که عزم تو چیست","بر آن رای و دانش بباید گریست","اگر غیر از تو کسی بداند که نیت و اراده‌ات چیست، پس باید بر آن نظر و دانش اشک ریخت و غم خورد."],[46,"کرم کن، نه پرخاش و کین‌آوری","که عالم به زیر نگین آوری","با سخاوت رفتار کن و نه با خشونت و دشمنی، زیرا دنیا در دست کسی است که با دانش و فضیلت بر دیگران تسلط دارد."],[46,"چو کاری بر آید به لطف و خوشی","چه حاجت به تندی و گردن کشی؟","وقتی کاری می‌تواند با مهربانی و خوشرویی انجام شود، چه نیازی به تندی و زورگویی است؟"],[46,"نخواهی که باشد دلت دردمند","دل دردمندان بر آور ز بند","اگر نمی‌خواهی دل تو در رنج و درد باشد، باید دل دردمندانی را از مشکلاتشان نجات دهی."],[46,"به بازو توانا نباشد سپاه","برو همت از ناتوانان بخواه","اگر تو نیروی کافی نداشته باشی، سپاه و قدرت فیزیکی به تنهایی کفایت نمی‌کند. بنابراین باید از عزم و اراده ناتوانان کمک بگیری."],[46,"دعای ضعیفان امیدوار","ز بازوی مردی به آید به کار","دعای افراد ضعیف و ناتوان به کمک مردان قوی و توانا خواهد آمد و تأثیرگذار است."],[46,"هر آن کاستعانت به درویش برد","اگر بر فریدون زد از پیش برد","هر کسی که از درویش یاری بگیرد، اگرچه به دستان قدرتمند فریدون (پادشاه اسطوره‌ای ایران) هم برسد، در حقیقت خود را بالاتر می‌برد."],[47,"اگر هوشمندی به معنی گرای","که معنی بماند ز صورت به جای","اگر انسان باهوشی هستی به دنبال باطن هر چیز و معنای آن باش که از صورت و ظاهر هر چیز، فقط معنی آن باقی می‌ماند."],[47,"که را دانش و جود و تقوی نبود","به صورت درش هیچ معنی نبود","هر کس که دانش، بخشندگی و تقوا ندارد، در ظاهر می‌ماند و هیچ راهی به دنیای معنا ندارد."],[47,"کسی خسبد آسوده در زیر گل","که خسبند از او مردم آسوده دل","کسی آسوده مرده، در گور خوابیده و آرامش دارد که مردم در زمان حیات او، از او به آرامش و آسایش رسیده‌باشند."],[47,"غم خویش در زندگی خور که خویش","به مرده نپردازد از حرص خویش","در زندگی، تو باید فقط غم‌خوار خودت باشی و نه غم‌خوار خویشاوندان و نزدیکان. زیرا که پس از مرگ تو، دیگران از روی طمع و توقعشان، به انسانی که وفات یافته‌است توجهی نمی‌کنند."],[47,"زر و نعمت اکنون بده کان تست","که بعد از تو بیرون ز فرمان تست",".پول، طلا و ثروتت را همین حالا ببخش. زیرا که پس از مرگ تو، فرمان دهی به این‌ها (کنترل این‌ها) از دستورات تو خارج می‌شود"],[47,"نخواهی که باشی پراکنده دل","پراکندگان را ز خاطر مهل","اگر نمی‌خواهی که فردی نگران و آشفته بشوی، باید کمک به افراد رنجدیده و پریشان را فراموش نکنی و آن‌ها را ناآرام نکنی."],[47,"پریشان کن امروز گنجینه چست","که فردا کلیدش نه در دست تست","همین حالا، مقدار اضافی اموالی که در انبار (محل نگهداری اموال) جمع‌آوری کرده‌ای را ببخش. زیرا که در آینده توانایی مدیریت و سکان آن انبار در دست تو نخواهد بود."],[47,"تو با خود ببر توشه خویشتن","که شفقت نیاید ز فرزند و زن","تا وقتی زنده هستی توشه آخرتت را جمع کن. زیرا که وقتی وفات یافتی همسر و فرزند برای تو دل نمی سوزانند."],[47,"کسی گوی دولت ز دنیا برد","که با خود نصیبی به عقبی برد","کسی در بین جهانیان پیشتازتر است و از بقیه سبقت میگیرد که از این دنیا بهره برده‌باشد و به آن را جهان آخرت ببرد."],[47,"به غمخوارگی چون سرانگشت من","نخارد کس اندر جهان پشت من","هیچ چیز و کس در جهان مانند ناخن انگشت من، پشت مرا نمی‌خارد و برای من دلسوزی نمی‌کند. (ناخن انگشت من استعاره از خود من. پشت خاریدن کنایه از انجام دادن کارهای شخصی.)"],[47,"مکن، بر کف دست نه هر چه هست","که فردا به دندان بری پشت دست","هیچ‌وقت کاری نکن که فرصتت را از دست بدهی و در آینده بخواهی، بر پشت دستت بزنی و پشیمان از این اتفاق، دستت را جلوی دهانت بگیری."],[47,"به پوشیدن ستر درویش کوش","که ستر خدایت بود پرده پوش","بکوش که اگر کسی اشتباه کوچکی کرد، تو پرده پوشی کنی و آن را پنهان کنی تا اگر تو هم مرتکب اشتباه کوچکی شدی، خداوند هم اشتباه تو را بپوشاند و پنهان کند."],[47,"مگردان غریب از درت بی نصیب","مبادا که گردی به درها غریب","غریبه‌ها را از در خانه‌ات ناامید نکن (غریبه‌ها را به خانه‌ات راه بده)، برای اینکه یک‌روز اگر خودت نیاز به کمک و رفتن به خانه‌ای داشتی، هرگز این نشود که دیگران تو را غریبه و بیگانه بخوانند و جا و راهت ندهند."],[47,"بزرگی رساند به محتاج خیر","که ترسد که محتاج گردد به غیر","آدم‌های بزرگ به فقیران و نیازمندان خوبی می‌کنند که می‌ترسند روزی خودشان به دیگران نیازمند شوند."],[47,"به حال دل خستگان در نگر","که روزی تو دلخسته باشی مگر","به حال دل کسانی که رنج دیده‌اند، آزرده خاطرند، غم دیده‌اند و ... توجه کن و به آنها کمک کن، چون ممکن است، روزی تو هم در وضعیت دلخستگی قرار بگیری و به کمک و توجه دیگران نیاز پیدا کنی."],[47,"درون فروماندگان شاد کن","ز روز فروماندگی یاد کن","در دل بیچارگان، خستگان، درماندگان و افراد ناتوان، شادی ایجاد کن و به یاد آنها باش که چه روزهایی را با بیچارگی، خستگی، درماندگی و در عجز و ناتوانی، گذرانده‌اند."],[47,"نه خواهنده‌ای بر در دیگران؟","به شکرانه خواهنده از در مران","نمی‌خواهی که دستت را بر در دیگران دراز کنی و به دیگران محتاج باشی؟ اگر نمی‌خواهی، پس برای شکرگزاری، کسی که از تو درخواستی می‌کند را از در خانه خود دور و بیرون نکن."],[48,"پدرمرده را سایه بر سر فکن","غبارش بیفشان و خارش بکن","بچه یتیمی کهپدر ندارد را مورد نوازش!واحسان خود قرار بده و باعث خوشحالی!او بشو و اندوهش را کم کن ."],[48,"ندانی چه بودش فرو مانده سخت؟","بود تازه بی بیخ هرگز درخت؟","نمی‌دانی چه چیزی باعث شده است که او (فرد مورد نظر) در شرایط سخت و نابسامانی قرار گیرد؟ آیا او همچون درختی بدون ریشه نیست که هرگز تازه و سرسبز نمی‌شود؟"],[48,"چو بینی یتیمی سر افکنده پیش","مده بوسه بر روی فرزند خویش","اگر یتیمی را ببینی که سرش را پایین انداخته و غمگین است، بر روی صورت فرزند خودت بوسه نزن."],[48,"یتیم ار بگرید که نازش خرد؟","وگر خشم گیرد که بارش برد؟","اگر یتیمی گریه کند، آیا باید نازش را بپذیریم و به او ترحم کنیم یا اگر خشمگین شود، بار گناهی بر دوش ما می‌افتد؟"],[48,"الا تا نگرید که عرش عظیم","بلرزد همی چون بگرید یتیم","گاه اگر یتیم گریه کند، عرش بزرگ خدا نیز به لرزه درمی‌آید. این نشان‌دهنده اهمیت و تأثیر احساسات ضعیفان است."],[48,"به رحمت بکن آبش از دیده پاک","به شفقت بیفشانش از چهره خاک","با مهربانی و رحمت خود، اشک‌ها را از چشمانش پاک کن و با محبت، او را از خاک دلتنگی‌هایش آزاد ساز."],[48,"اگر سایه خود برفت از سرش","تو در سایه خویشتن پرورش","اگر سایه حمایت و نگهداری پدر از سر فرزند برداشت، تو باید در زیر سایه خودت او را بزرگ کنی و از او حمایت کنی."],[48,"من آنگه سر تاجور داشتم","که سر بر کنار پدر داشتم","من وقتی سر تاج‌وری داشتم و مقام و منزلت‌ام بالا بود که در کنار پدرم بودم و از سایه حمایت او بهره‌مند بودم."],[48,"اگر بر وجودم نشستی مگس","پریشان شدی خاطر چند کس","اگر مگس بر سر من نشسته است، باعث پریشانی خاطر چندین نفر نمی‌شوی."],[48,"کنون دشمنان گر برندم اسیر","نباشد کس از دوستانم نصیر","اگر اکنون دشمنانم مرا اسیر کنند، در بین دوستانم هیچ کس نیست که به کمک و حمایت من بیاید."],[48,"مرا باشد از درد طفلان خبر","که در طفلی از سر برفتم پدر","من از رنج و درد کودکان آگاه هستم، چرا که خود در دوران کودکی‌ام پدرم را از دست داده‌ام."],[48,"یکی خار پای یتیمی بکند","به خواب اندرش دید صدر خجند","یک نفر خاری از پای یتیمی درآورد، بعدا در خواب دید که (بخاطر این احسان) در بلندای سعادت قرار گرفته"],[48,"همی گفت و در روضه‌ها می‌چمید","کز آن خار بر من چه گلها دمید","او (یتیم) می‌گوید که در حالی که در باغ‌ها گردش می‌کرد و صحبت می‌کرد، به یاد می‌آورد که از آن خار (درد و رنج) چه گل‌ها و نعمتی برایش به بار آمده است."],[48,"مشو تا توانی ز رحمت بری","که رحمت برندت چو رحمت بری","تا آنجا که می‌توانی از رحمت و لطف به دیگران غافل مشو، چون اگر از رحمت دور شوی، خود نیز رحمت را از دست خواهی داد."],[48,"چو انعام کردی مشو خودپرست","که من سرورم دیگران زیردست","وقتی احسان و نعمت داده‌ای، خودت را بالاتر از دیگران تصور نکن، زیرا من (سعدی) برتر از دیگران نیستم و آن‌ها در زیر دست من هستند."],[48,"اگر تیغ دورانش انداخته‌ست","نه شمشیر دوران هنوز آخته‌ست؟","اگر زمان (دوران) او را به نابودی کشانده است، به این معنا نیست که قدرت و تأثیر زمان (دوران) هنوز پایان یافته باشد."],[48,"چو بینی دعاگوی دولت هزار","خداوند را شکر نعمت گزار","زمانی که ببینی کسی برای تو دعا می‌کند و این دعا به اندازه هزار خداوند ارزش دارد، باید در برابر این نعمت شاکر باشی."],[48,"که چشم از تو دارند مردم بسی","نه تو چشم داری به دست کسی","مردم زیادی به تو امید دارند و تو نسبت به هیچ‌کس توقعی نداری."],[48,"«کرم» خوانده‌ام سیرت سروران","غلط گفتم، اخلاق پیغمبران","من اشتباه کرده‌ام که سیرت بزرگان را «کرم» نامیده‌ام؛ در واقع، باید اخلاق پیامبران را این‌گونه توصیف کنم."],[49,"شنیدم که یک هفته ابن‌السبیل","نیامد به مهمانسرای خلیل","شنیدم که به مدت یک هفته، هیچ مسافر در راه مانده‌ای به منزل ابراهیم خلیل، که از شدت مهمان‌نوازی همچون مهمانسرایی بود، نیامد."],[49,"ز فرخنده خویی نخوردی بگاه","مگر بینوایی در آید ز راه","ابراهیم به خاطر خوش‌خویی‌اش غذا نمی‌خورد مگر اینکه مستمندی را در راه می‌دید و او را نیز در غذایش شریک می‌کرد."],[49,"برون رفت و هر جانبی بنگرید","بر اطراف وادی نگه کرد و دید","به همین خاطر از منزل بیرون رفت و به هر سمت نظاره انداخت و اطراف را مشاهده کرد."],[49,"به تنها یکی در بیابان چو بید","سر و مویش از گرد پیری سپید","او پیرمردی را دید که وسط بیابان ایستاده بود و پیری، همچون گرد سفیدی بر سر و مویش نشسته بود."],[49,"به دلداریش مرحبایی بگفت","به رسم کریمان صلایی بگفت","ابراهیم برای دلگرمی به او سلامی کرد و به شیوه بزرگمنشان او را برای غذا خوردن آواز داد."],[49,"که ای چشمهای مرا مردمک","یکی مردمی کن به نان و نمک","ابراهیم به او گفت: ای که تمام مردمک چشمم را فرا گرفته‌ای (نشان از توجه و محبت ابراهیم به پیرمرد) مروت به خرج بده و بیا و نان و نمکی در منزل من بخور."],[49,"نعم گفت و برجست و برداشت گام","که دانست خلقش، علیه‌السلام","پیرمرد وقتی خلق‌وخوی ابراهیم را والا دید، درخواست او را قبول کرد و با شوق از جا پرید و به راه افتاد."],[49,"رقیبان مهمانسرای خلیل","به عزت نشاندند پیر ذلیل","نگاهبانان و ملازمان منزل ابراهیم پیرمرد را با احترام نشاندند."],[49,"بفرمود و ترتیب کردند خوان","نشستند بر هر طرف همگنان","ابراهیم فرمان داد و ترتیب سفره‌ای دادند. همه دور سفره نشستد."],[49,"چو بسم الله آغاز کردند جمع","نیامد ز پیرش حدیثی به سمع","زمانی که جمع غذا را با نام خدا شروع کردند، صدایی از پیرمرد به گوش کسی نرسید."],[49,"چنین گفتش: ای پیر دیرینه روز","چو پیران نمی‌بینمت صدق و سوز","ابراهیم به او گفت: ای پیرمرد کهنسال، تو را همچون پیران دیگر، که خلوص و شوق الهی دارند، نمی‌بینم."],[49,"نه شرط است وقتی که روزی خوری","که نام خداوند روزی بری؟","مگر شرط نیست که وقتی غذا می‌خوری، آن را با نام خدا آغاز کنی؟"],[49,"بگفتا نگیرم طریقی به دست","که نشنیدم از پیر آذرپرست","پیرمرد گفت: من راه و طریقی را که از پیشینیان آتش‌پرستم نشنیده باشم، نمی‌پذیرم."],[49,"بدانست پیغمبر نیک فال","که گبر است پیر تبه بوده حال","ابراهیم که از اولیای خدا (خوش‌قدم و فرخنده) بود، متوجه شد که این پیرمرد آتش‌پرست بوده و از لحاظ روحی و اعتقادی، حال بسیار بد و تباهی دارد."],[49,"به خواری براندش چو بیگانه دید","که منکر بود پیش پاکان پلید","ابراهیم وقتی متوجه شد که پیرمرد با توحید بیگانه است او را با خواری از پیش خود راند؛ چراکه انکارکننده خدا نزد پاکان و اهل حق پلید است و باید آن را رفع کرد (یا: چراکه ناپسند است پلیدی نزد پاکان باشد و باید از شرش خلاص شد)."],[49,"سروش آمد از کردگار جلیل","به هیبت ملامت کنان کای خلیل","فرشته وحی پیکی از سوی خداوند بزرگ آورد و با چهره‌ای پرهیبت و سرزنش‌کنان گفت: ای ابراهیم!"],[49,"منش داده صد سال روزی و جان","تو را نفرت آمد از او یک زمان","خداوند می‌فرماید که من صد سال به او عمر و روزی داده‌ام، اما تو تنها در یک لحظه از او خشم گرفتی."],[49,"گر او می‌برد پیش آتش سجود","تو وا پس چرا می‌بری دست جود؟","اگر او به آتش سجده می‌کند، تو چرا از بخشش به او دست می‌کشی؟"],[50,"گره بر سر بند احسان مزن","که این زرق و شید است و آن مکر و فن","به کسی که در کار خوب کردن، دسیسه و نیرنگ به کار می‌برد، نباید اعتماد کرد، زیرا که اعمال نیک او ظاهری فریبنده دارد و در واقع ممکن است مقاصد نامناسبی در پس آن باشد."],[50,"زیان می‌کند مرد تفسیر‌دان","که علم و ادب می‌فروشد به نان","انسان دانشمند و اهل تفسیر، وقتی علم و ادب خود را به خاطر معیشت و نان می‌فروشد، در واقع به خود زیان می‌رساند."],[50,"کجا عقل یا شرع فتوی دهد","که اهل خرد دین به دنیا دهد؟","آیا عقل یا دین می‌تواند اجازه دهد که انسان‌های خردمند دین خود را برای به دست آوردن دنیا بفروشند؟"],[50,"ولیکن تو بستان که صاحب‌خرد","از ارزان‌فروشان به رغبت خرد","اما تو ای باغ، آن کسی که صاحب خرد است، حاضر نیست از متاع ارزان‌فروشان به راحتی بگذرد و آن را حاصل کند."],[51,"زبان‌دانی آمد به صاحبدلی","که محکم فرومانده‌ام در گلی","زبان‌دان، یعنی کسی که در سخنوری مهارت دارد، به فرد باخودشکوفایی (صاحبدل) گفت که من به شدت در مشکلات و موانع (گل) گیر کرده‌ام و نمی‌توانم خود را رها کنم."],[51,"یکی سفله را ده درم بر من است","که دانگی از او بر دلم ده من است","من یک فرد پست و بی‌مقدار را می‌شناسم که تنها ده درهم از من دارد، اما همین مقدار برای من اهمیت زیادی دارد و احساس سنگینی بر دل من می‌گذارد."],[51,"همه شب پریشان از او حال من","همه روز چون سایه دنبال من","تمام شب به خاطر او نومید و پریشانم و همه روز مانند سایه‌ای او را دنبال می‌کنم."],[51,"بکرد از سخن‌های خاطر پریش","درون دلم چون در‌ خانه ریش","از حرف‌های او که دل مرا پریشان کرده، احساسات درونی‌ام مانند کنج خانه‌ای که موهایش ریخته است، پیداست."],[51,"خدایش مگر تا ز مادر بزاد","جز این ده درم چیز دیگر نداد","انگار خداوند وقتی او را به دنیا آورد، فقط همین ده درم (واحد پول) را به او داده و چیز دیگری به او نداده است."],[51,"ندانسته از دفتر دین الف","نخوانده به جز باب لاینصرف","او بدون آگاهی از کتاب دین و بدون خواندن الفبا، به جز موضوع‌هایی که ناپذیرفتنی است، چیزی نمی‌داند."],[51,"خور از کوه یک روز سر بر نزد","که آن قلتبان حلقه بر در نزد","در یک روز خورشید از پشت کوه طلوع نکرد و آن کسی که ناامید بود، در نزد در انتظار ماند."],[51,"در اندیشه‌ام تا کدامم کریم","از آن سنگدل دست گیرد به سیم","در فکر هستم که کدام یک از من بزرگوار است که بر اثر سنگدلی دست مرا بگیرد و به سوی دوستی و محبت بیاورد."],[51,"شنید این سخن پیر فرخ نهاد","درستی دو، در آستینش نهاد","پیر فرخ (یک عابد) شنید این گفته را و دو چیز درست و صحیح را در آستینش پنهان کرد."],[51,"زر افتاد در دست افسانه گوی","برون رفت از آنجا چو زر تازه‌روی","افسانه‌گوی (قصه‌گوی) زر (طلا) را در دستانش پیدا کرد و وقتی خبر آن را شنید، با شادابی و سرزندگی از آنجا رفت."],[51,"یکی گفت: شیخ! این ندانی که کیست؟","بر او گر بمیرد نباید گریست","کسی به عابد می‌گوید: ای شیخ! نمی‌دانی او کیست؟ اگر او بمیرد، نباید برایش گریه کرد."],[51,"گدایی که بر شیر نر زین نهد","ابو زید را اسب و فرزین نهد","گدایی که بر شیر نر سوار می‌شود، به اندازه‌ای قوی و با شهامت است که می‌تواند ابو زید را بر اسب بنشاند و فرزین (مدل شجاع و رزم‌آور) را نیز آماده کند."],[51,"بر آشفت عابد که خاموش باش","تو مرد زبان نیستی، گوش باش","عابد ناراحت شد و به آن شخص گفت که باید ساکت باشد، زیرا تو مردی هستی که نباید صحبت کنی و باید فقط شنونده باشی."],[51,"اگر راست بود آنچه پنداشتم","ز خلق آبرویش نگه داشتم","اگر آنچه که درباره شخصیت او فکر کردم درست باشد، به خاطر حفظ آبرویش سکوت کرده‌ام."],[51,"وگر شوخ‌چشمی و سالوس کرد","الا تا نپنداری افسوس کرد","اگر کسی با ظاهری شوخ و در باطن نیرنگ کند، نباید فکر کنی که او واقعا ناراحت است یا از کارش پشیمان شده."],[51,"که خود را نگه داشتم آبروی","ز دست چنان گربزی یاوه‌گوی","من برای حفظ آبرویم خود را نگه داشتم، مانند گربه‌ای که زبان به اوهام و دروغ می‌گشاید."],[51,"بد و نیک را بذل کن سیم و زر","که این کسب خیر است و آن دفع شر","نیکو و بد را با بخشش مال و ثروت از بین ببر، زیرا این کار موجب جلب خیر و دفع شر می‌شود."],[51,"خنک آن که در صحبت عاقلان","بیاموزد اخلاق صاحبدلان","خوشا به حال کسی که در کنار افراد عاقل، آداب و رفتار شخصیت‌های بزرگ و با فضیلت را یاد می‌گیرد."],[51,"گرت عقل و رای است و تدبیر و هوش","به عزت کنی پند سعدی به گوش","اگر عقل، درایت و تدبیر داری، باید با احترام و ارادت به سخنان سعدی گوش بسپاری."],[51,"که اغلب در این شیوه دارد مقال","نه در چشم و زلف و بناگوش و خال","عمدتا در این نوع سخن‌ها نمی‌توان از زیبایی‌های ظاهری مانند چشم، زلف، گوش یا خال حرف زد."],[52,"یکی رفت و دینار از او صد هزار","خلف برد صاحبدلی هوشیار","یکی درگذشت و وارثش که صاحبدلی هوشیار بود صد‌هزار دینار از او به ارث برد"],[52,"نه چون ممسکان دست بر زر گرفت","چو آزادگان دست از او بر گرفت","همان‌طور که بخیل‌ها به پول چنگ می‌زنند، آزادگان دست خود را از آن دور می‌کنند."],[52,"ز درویش خالی نبودی درش","مسافر به مهمانسرای اندرش","در خانه درویش، نباید خالی باشد؛ چرا که مسافران به مهمان‌سرای او وارد می‌شوند و او باید از میزبانی برای آنها غافل نباشد."],[52,"دل خویش و بیگانه خرسند کرد","نه همچون پدر سیم و زر بند کرد","دل خود و دیگران را شاد کرد، نه مانند پدرش که به جمع‌آوری طلا و نقره مشغول بود."],[52,"ملامت‌کنی گفتش: ای باددست‌‌‌!","به یک‌ره پریشان مکن هر‌چه هست","شخصی به باددست (شخصی که دستش در کارها می‌لنگد و ناتوان است) می‌گوید که ملامت نکند و در یک‌راه خاص (به یک روش) اوضاع را بی‌خود به هم نریزد و هر چه هست را آشفته نکند."],[52,"به سالی توان خرمن اندوختن","به یک دم نه مردی بود سوختن","برای جمع‌آوری، نیاز به زمان و تلاش است و نمی‌توان در یک لحظه به همه چیز دست یافت. از این رو، اگر کسی در تلاش برای دست‌یابی به ثروت و نعمت باشد، در یک لحظه به آن نخواهد رسید."],[52,"چو در تنگدستی نداری شکیب","نگه‌دار وقت فراخی حسیب","زمانی که در فقر و تنگدستی هستی و نمی‌توانی صبر کنی، باید در زمان رونق و فراخی خودت را کنترل کنی و از آن به‌خوبی استفاده کنی."],[52,"به دختر چه خوش گفت بانوی ده","که روز نوا برگ سختی بنه","بانوی ده به دخترش می‌گوید که در زمان سختی و دشواری‌ها، به خوش‌گویی و سخن خوش دل نبندد و باید با سختی‌ها مقابله کند."],[52,"همه‌وقت بر دار مشک و سبوی","که پیوسته در ده روان نیست جوی","همیشه بر دوش خود مشک و سبو را نبر، چرا که اگر آب در ده در جریان نباشد، هیچ‌گاه به‌دست نخواهد آمد."],[52,"به دنیا توان آخرت یافتن","به زر پنجه شیر بر تافتن","انسان می‌تواند با مال و ثروت، به سعادت و نعمت‌های آخرت دست یابد، اما نباید مانند شیر، در جستجوی فریب و طمع به دنیا باشد."],[52,"به یک بار بر دوستان زر مپاش","وز آسیب دشمن به اندیشه باش","با یک بار پخش کردن ثروت و نعمت میان دوستان، خود را بی‌فکر قرار نده و به آسیب‌هایی که از سوی دشمنان ممکن است متوجه تو شود، توجه داشته باش."],[52,"اگر تنگدستی مرو پیش یار","وگر سیم داری بیا و بیار","اگر فقیر و بی‌پول هستی، به نزد دوست نرو و از او چیزی نخواه؛ اما اگر پول داری، با خود بیاور و آن را خرج کن."],[52,"اگر روی بر خاک پایش نهی","جوابت نگوید به دست تهی","اگر به کسی که در تنگدستی است، بی‌احترامی کنی و بر او پا بگذاری، او در مقابلت جواب نخواهد داد و از فقر خود چیزی ندارد که به تو بدهد."],[52,"خداوند زر بر کند چشم دیو","به دام آورد صخر جنی به ریو","خداوند ثروت (زر) را بر می‌کشید و به چشمان دیوان (موجودات شرور) آسیب می‌زند، به طوری که آنها را به دام می‌اندازد و سنگی جنی (شیاطین) را به دام آورد."],[52,"تهی‌دست در خوبرویان مپیچ","که بی‌سیم مردم نیرزند هیچ","بی‌پولی و تنگ‌دستی خود را به زیبا رویان نزن و به دنبال آن‌ها نرو، چون مردم عاقل و نیکوکار به چنین افرادی توجه نمی‌کنند."],[52,"به دست تهی بر نیاید امید","به زر برکنی چشم دیو سپید","اگر دستت خالی باشد، به هیچ‌وجه نمی‌توانی به امید به دست آوردن ثروت (زر) چشم به دیو سپید (نماد ثروت و قدرت) داشته باشی."],[52,"وگر هرچه یابی به کف بر نهی","کفت وقت حاجت بماند تهی","اگر هر چه به دست می‌آوری را در زمان نیاز نتوانی در اختیار بگذاری، پس در آن لحظه بی‌چیز خواهی ماند."],[52,"گدایان به سعی تو هرگز قوی","نگردند، ترسم تو لاغر شوی","اگر تو به فکر کمک و بخشش به گدایان باشی، آن‌ها هرگز به توانمندی نمی‌رسند و ممکن است خودت دچار ضعف و ناتوانی شوی."],[52,"چو منّاع خیر این حکایت بگفت","ز غیرت جوانمرد را رگ نخفت","چون من کسی هستم که خیر را منع می‌کند، این داستان را گفتم تا جوانمردی غیرت نداشته باشد و از خواب بیدار نشود."],[52,"پراکنده‌دل گشت از آن عیب‌جوی","بر آشفت و گفت ای پراکنده‌گوی","آن جوانمرد از سخنان عیب‌جویانه آن فرد ناراحت و خشمگین شد و به او گفت: ای کسی که بی‌هدف و پراکنده صحبت می‌کنی..."],[52,"مرا دستگاهی که پیرامن است","پدر گفت میراث جد من است","پدرم به من گفت که این وسایل و دارایی‌هایی که در اطراف من قرار دارد، میراث جد من است."],[52,"نه ایشان به خست نگه داشتند‌؟","به حسرت بمردند و بگذاشتند؟","آیا آن‌ها به خاطر خست و دل‌نگرانی چیزی را نگه داشتند؟ در حالی که با حسرت جان سپردند و چیزی را به جا نذاشتند؟"],[52,"به دستم نیفتاد مال پدر","که بعد از من افتد به دست پسر","مال پدر به من نرسید و نمی‌دانم پس از من به پسر خواهد رسید یا نه."],[52,"همان به که امروز مردم خورند","که فردا پس از من به یغما برند","بهتر است امروز از نعمت‌ها بهره‌مند شویم، چرا که فردا بعد از من ممکن است این چیزها به تاراج برود و دیگر برای من باقی نماند."],[52,"خور و پوش و بخشای و راحت رسان","نگه می چه داری ز بهر کسان؟","بخور و بپوش و بخشش کن و به دیگران آسایش برسان، چه نیازی به نگهداری و ذخیره‌سازی برای دیگران داری؟"],[52,"برند از جهان با خود اصحاب رای","فرومایه ماند به حسرت بجای","افرادی که در دنیا با فکر و اندیشه‌ی خود زندگی می‌کنند و ویژگی‌های نیک دارند، از دنیا می‌روند، اما کسانی که بی‌مقدار و پست‌اند، با حسرت و اندوه در دنیا باقی می‌مانند."],[52,"زر و نعمت اکنون بده کآن توست","که بعد از تو بیرون ز فرمان توست","اگر اکنون ثروت و نعمت را به دیگران بدهی، آنها از آنچه به تو تعلق دارد خواهد بود، زیرا پس از تو این نعمت‌ها تحت اختیار تو نیستند."],[52,"به دنیا توانی که عقبی خری","بخر، جان من، ور نه حسرت بری","در این دنیا آنچه می‌خواستی را به دست بیاور، جانم، وگرنه در آخرت تنها حسرت بر دل خواهی گذاشت."],[53,"بزارید وقتی زنی پیش شوی","که دیگر مخر نان ز بقال کوی","زنی نزد شوهر خود گلایه کرد که از مغازه بقالی در کوچه نان خریداری نکن."],[53,"به بازار گندم‌فروشان گرای","که این جو‌فروشی‌ست گندم‌نما‌ی","به بازار گندم‌فروشان بروید، چرا که این‌جا فقط افرادی هستند که جو را به جای گندم می‌فروشند."],[53,"نه از مشتری‌، کز زحام مگس","به یک هفته رویش ندیده‌ست کس","هیچ مشتری‌ای به خاطر شلوغی مگس‌ها، در طول یک هفته او را ندیده است."],[53,"به‌دلداری آن مرد صاحب‌نیاز","به زن گفت کای روشنایی بساز","مردی که به کمک نیاز دارد، برای دلداری به زن می‌گوید تو همچون روشنی هستی که می‌توانی فضای زندگی را روشن کنی."],[53,"به امید ما کلبه اینجا گرفت","نه مردی بود نفع از او وا گرفت","ما به امید خود، اینجا کلبه‌ای ساخته‌ایم و این کلبه برای کسی نیست که از او نفعی ببریم."],[53,"ره نیک‌مردان‌ آزاده گیر","چو استاده‌ای دست افتاده گیر","راه نیکان و مردان آزاده را در پیش بگیر و مانند کسی که در برابر افرادی نیازمند قرار دارد، به آن‌ها کمک کن."],[53,"ببخشای کآنان که مرد حقند","خریدار دکان بی‌رونق‌ند","ببخشید کسانی که مردان راستین و درستکار هستند، به نوعی مشتریان یک مغازه‌ای هستند که کساد و بی‌فروش است."],[53,"جوانمرد اگر راست خواهی ولی‌ست","کرم پیشه شاه مردان علی‌ست","اگر می‌خواهی جوانمردی کنی، باید بدانی که بخشندگی و نیکوکاری ویژگی شاه مردان، علی (علی بن ابی‌طالب) است."],[54,"شنیدم که پیری به راه حجاز","به هر خطوه کردی دو رکعت نماز","شنیدم که پیرمردی در راه حجاز، به ازاء هر قدمی که برمی‌داشت، دو رکعت نماز می‌خواند."],[54,"چنان گرم رو در طریق خدای","که خار مغیلان نکندی ز پای","چنان در مسیر خدا غرق در عبادت و ذکر هستی که حتی خارهای تیز و آزاردهنده را از پای خود نمی‌کنی."],[54,"به آخر ز وسواس خاطر پریش","پسند آمدش در نظر، کار خویش","در پایان، وسواس و افکاری که او را آزار می‌داد، به نظرش قابل قبول و پسندیده آمد و او کار خود را چنین دید."],[54,"به تلبیس ابلیس در چاه رفت","که نتوان از این خوب‌تر راه رفت","او به فریب ابلیس در چاه افتاد و نتوانست از این راه، که بهتر از آن نیست، خارج شود."],[54,"گرش رحمت حق نه دریافتی","غرورش سر از جاده برتافتی","اگر رحمت خدا را دریافت نکردی، خودپسندی‌ات باعث می‌شود که از راه صحیح منحرف شوی."],[54,"یکی هاتف از غیبش آواز داد","که ای نیکبخت مبارک نهاد","صدایی از غیب شنیده شد که به فرد نیکبخت و خوش‌نهاد گفته می‌شود."],[54,"مپندار اگر طاعتی کرده‌ای","که نزلی بدین حضرت آورده‌ای","نپندار که اگر عبادتی انجام داده‌ای، به خاطر آن مقام و نزدیکی به او را به دست آورده‌ای."],[54,"به احسانی آسوده کردن دلی","به از الف رکعت به هر منزلی","آرامش و خوشنودی قلب دیگران از انجام یک عمل نیکو، ارزش بیشتری دارد از هزار رکعت نماز در هر مکان."],[55,"به سرهنگ سلطان چنین گفت زن","که خیز ای مبارک در رزق زن","زن به سرهنگ (نظامی) سلطان اشاره می‌کند و به او می‌گوید: ای مرد نیکوکار، برخیز که در روزی زن، خوشا به روزگار تو!"],[55,"برو تا ز خوانت نصیبی دهند","که فرزندکانت نظر بر رهند","برو و از سفره‌ات به دیگران بهره‌ای بدهند، زیرا فرزندانت همیشه در انتظار هستند و به تو و کارهایت چشم دوخته‌اند."],[55,"بگفتا بود مطبخ امروز سرد","که سلطان به شب نیت روزه کرد","زن گفت امروز آشپزخانه سرد است، زیرا سلطان تصمیم به روزه گرفتن در شب دارد."],[55,"زن از ناامیدی سر انداخت پیش","همی گفت با خود دل از فاقه ریش","زن به خاطر ناامیدی و دردی که دارد، سرش را پایین می‌اندازد و با خود می‌گوید که دلش از فقر و سختی رنج می‌برد."],[55,"که سلطان از این روزه گویی چه خواست؟","که افطار او عید طفلان ماست","سلطان از این روزه‌گفتن چه نتیجه‌ای می‌خواهد؟ زیرا افطار او، جشن و شادی برای بچه‌های ماست."],[55,"خورنده که خیرش برآید ز دست","به از صائم‌الدهر دنیاپرست","کسی که نیکی و خیرش از دستش به دیگران می‌رسد بهتر است از آن کسی که همیشه روزه‌دار است اما به دنیای مادی وابسته است و از آن دور نمی‌شود."],[55,"مسلّم کسی را بود روزه‌داشت","که درمانده‌ای را دهد نان چاشت","کسی که روزه‌دار است، باید به او ایمان داشت که اگر کسی در تنگنا باشد، به او نان صبحانه می‌دهد."],[55,"وگرنه چه لازم که سعیی بری","ز خود بازگیری و هم خود خوری؟","اگر نه از روی خوبی و کمک به دیگران، پس چه نیازی به تلاش داری که خودت را از چیزهایی که خوشمزه هستند، محروم کنی و فقط خودت را سیر کنی؟"],[56,"یکی را کرم بود و قوت نبود","کفافش به قدر مروت نبود","فردی خصلت سخاوتمندی و بزرگواری داشت ولی توانایی کافی بخشش و سخاوت نداشت و این باعث می‌شد که نتواند به اندازه شخصیتش عمل کند."],[56,"که سفله خداوند هستی مباد","جوانمرد را تنگدستی مباد","نمی‌بایست جوانمرد و انسان شرافتمند دچار فقر و تنگدستی شود، زیرا فرد بی‌نوا و پست در درگاه خداوند جایی ندارد."],[56,"کسی را که همت بلند اوفتد","مرادش کم اندر کمند اوفتد","اگر کسی بلند همت باشد، به راحتی به آرزوهای خود می‌رسد و هرچه برایش خواسته باشد، به دست می‌آورد."],[56,"چو سیلاب ریزان که در کوهسار","نگیرد همی بر بلندی قرار","مانند سیلابی که در کوهستان جاری است که هرگز بر بلندی نمی‌ایستد و دائما در حال ریزش و بخشش است."],[56,"نه در خورد سرمایه کردی کرم","تنک مایه بودی از این لاجرم","بیش از سرمایه خود بخشش می‌کرد و ناچار دستش خالی بود"],[56,"برش تنگدستی دو حرفی نبشت","که ای خوب فرجام نیکو سرشت","فقیری برای او چند کلمه‌ای نوشت که ای خوش عاقبت و خوش طینت"],[56,"یکی دست گیرم به چندین درم","که چندی است تا من به زندان درم","با چند درهمی مرا دستگیری کن که مدتی است به زندان افتاده‌ام"],[56,"به چشم اندرش قدر چیزی نبود","ولیکن به دستش پشیزی نبود","در نگاه او بهایی برای چیزها وجود نداشت، اما در دستش هیچ چیزی برای بخشش نبود."],[56,"به خصمان بندی فرستاد مرد","که ای نیکنامان آزاد مرد","مردی به دشمنانش پیغام فرستاد و به آنان گفت که ای نیک‌نامان، شما با شخصیت‌های آزادی روبه‌رو هستید."],[56,"بدارید چندی کف از دامنش","و گر می‌گریزد ضمان بر منش","کمی از دامن او را نگه‌دارید و اگر می‌خواهد فرار کند، برای نجاتش مسئولیت او را بر عهده بگیرید."],[56,"وز آنجا به زندانی آمد که خیز","وز این شهر تا پای داری گریز","از آن مکان به زندانی آمد که باید برود، و از این شهر تا زمانی که بتواند فرار کند، حرکتی نکند."],[56,"چو گنجشک در باز دید از قفس","قرارش نماند اندر آن یک نفس","وقتی که گنجشک، قفس را دید، دیگر نتوانست در آنجا بماند و هیچ لحظه‌ای در قفس آرام نداشت."],[56,"چو باد صبا زآن میان سیر کرد","نه سیری که بادش رسیدی به گرد","چنان‌که باد صبا از میان آنجا می‌گذشت، نه امید سیر و گردش داشت که به آنجا برسد."],[56,"گرفتند حالی جوانمرد را","که حاصل کن این سیم یا مرد را","جوانمرد (شخص با فضیلت) به حالتی افتاده است که او را تشویق می‌کنند تا یا ثروت به دست آورد یا خود را به کمال انسانی (مرد) برساند."],[56,"به بیچارگی راه زندان گرفت","که مرغ از قفس رفته نتوان گرفت","به خاطر بیچارگی و وضع دشواری که دچار شده، تصمیم به رفتن به زندان می‌گیرد، زیرا مانند این است که تلاش برای گرفتن پرنده‌ای که از قفس پرواز کرده، بی‌فایده است."],[56,"شنیدم که در حبس چندی بماند","نه شکوت نوشت و نه فریاد خواند","شخصی در زندان مدت‌ زمان طولانی‌تری را سپری کرد، اما نه به شکایت پرداخته و نه صدای اعتراض سر داد."],[56,"زمانها نیاسود و شبها نخفت","بر او پارسایی گذر کرد و گفت:","زمان‌ها برای او آرامش نداشت و شب‌ها نمی‌خوابید. پارسایی (پارسایی یا پرهیزکاری) مدتی به او گذشت و گفت:"],[56,"نپندارمت مال مردم خوری","چه پیش آمدت تا به زندان دری؟","نمی‌گویم که تو مال دیگران را می‌خوری، اما چه چیزی بر تو گذشته که به زندان افتاده‌ای؟"],[56,"بگفت ای جلیس مبارک نفس","نخوردم به حیلتگری مال کس","گفت: ای همراه، خوشحالم که با حیله و فریب اموال دیگران را نخورده‌ام."],[56,"یکی ناتوان دیدم از بند ریش","خلاصش ندیدم به جز بند خویش","یک ناتونی را دیدم که از زندانی بودن می‌نالید و برای خلاصی او چاره‌ای بجز زندانی شدن خودم ندیدم."],[56,"ندیدم به نزدیک رایم پسند","من آسوده و دیگری پایبند","نزدیک خودم هیچ‌کس را ندیدم که نظرش با من موافق باشد؛ من در آسایش هستم و دیگران به قید و بند گرفتارند."],[56,"بمرد آخر و نیکنامی ببرد","زهی زندگانی که نامش نمرد","در نهایت، آن مرد خوب‌نام و نیکوکار به سرای آخرت رفت و نام او باقی ماند. چه زندگی پرباری که نامش جاودان است."],[56,"تنی زنده دل، خفته در زیر گل","به از عالمی زنده مرده دل","یک انسان زنده‌دل، هرچند که در زیر خاک باشد، ارزش بیشتری دارد از کسانی که در این دنیا زنده‌اند اما دل و روحشان مرده است."],[56,"دل زنده هرگز نگردد هلاک","تن زنده دل گر بمیرد چه باک؟","دل زنده هرگز از بین نمی‌رود و اگر بدن زنده‌ای که دلش مرده باشد بمیرد، اهمیتی ندارد."],[57,"یکی در بیابان سگی تشنه یافت","برون از رمق در حیاتش نیافت","شخصی در بیابان سگی تشنه دید که آن سگ از بی‌آبی و تشنگی بی‌رمق شده بود."],[57,"کله دلو کرد آن پسندیده کیش","چو حبل اندر آن بست دستار خویش","آن آدم نیکوکار کلاه خود را دلو کرد و به دستار خویش بست. (حبل: طناب)"],[57,"به خدمت میان بست و بازو گشاد","سگ ناتوان را دمی آب داد","تلاش کرد و آن سگ بی‌رمق را آب نوشانید."],[57,"خبر داد پیغمبر از حال مرد","که داور گناهان از او عفو کرد","رسول اکرم خبر داد که خداوند گناهان آن شخص را بخشود."],[57,"الا گر جفاکاری اندیشه کن","وفا پیش گیر و کرم پیشه کن","بهوش باش! اگر ستمکار هستی، بیندیش و بترس و راه دوستی و بخشندگی در پیش بگیر."],[57,"کسی با سگی نیکویی گم نکرد","کجا گم شود خیر با نیکمرد؟","هیچکس نیکویی با یک سگ را فراموش نمی‌کند و بی‌مزد نمی‌گذارد؛ کار نیک آدم نیکوکار چگونه بی‌مزد می‌ماند؟"],[57,"کرم کن چنان که‌ت برآید ز دست","جهانبان در خیر بر کس نبست","تا می‌توانی نیکویی کن و خداوند درب کار خیر را بر روی هیچکس نبسته‌است."],[57,"به قنطار زر بخش کردن ز گنج","نباشد چو قیراطی از دسترنج","بهنام اعظمیان: بخشیدن مقدار زیادی زر از گنج و مال بادآورده به آسانی امکان‌پذیر است، مهم این است که بتوانی یک ذره از کار و دسترنج خودت به کسی کمک کنی و از مال خودت بگذری."],[57,"برد هر کسی بار در خورد زور","گران است پای ملخ پیش مور","هر کسی باری را که بر دوش دارد، با زحمت و تلاش به دوش می‌کشد و برای او تحمل آن سنگین است، همان‌طور که پای ملخ برای مور وزن و فشار سنگینی به حساب می‌آید."],[58,"تو با خلق سهلی کن ای نیکبخت","که فردا نگیرد خدا با تو سخت","با مردم به راحتی و نرم‌خویی رفتار کن ای فرد خوشبخت، زیرا اگر روزی به مشکلی برخوری، خداوند با تو سخت نخواهد گرفت."],[58,"گر از پا در آید، نماند اسیر","که افتادگان را بود دستگیر","اگر کسی از پا بیفتد و دچار مشکل شود، دیگر اسیر نخواهد ماند، زیرا کسانی که در سختی‌ها هستند، نیز کسی را در اختیار دارند که به آنان یاری می‌رساند."],[58,"به آزار فرمان مده بر رهی","که باشد که افتد به فرماندهی","به کسی که در راهی قرار گیرد و دچار آزاری شود، به او فرمان نده و او را آزار نکن، زیرا ممکن است روزی او به مقام و قدرتی برسد و فرامین تو را زیر پا بگذارد."],[58,"چو تمکین و جاهت بود بر دوام","مکن زور بر ضعف درویش عام","اگر قدرت و مقام تو همیشه ثابت است، به ضعیف و نیازمند زور نزن و بر او سلطه نداشته باش."],[58,"که افتد که با جاه و تمکین شود","چو بیدق که ناگاه فرزین شود","انسانی که به مقام و جاه رسیده است، مانند مهره‌ای در بازی شطرنج می‌باشد که ناگهان ممکن است توسط حریف مورد تهدید قرار گیرد و از مقامش سقوط کند."],[58,"نصیحت شنو مردم دوربین","نپاشند در هیچ دل تخم کین","ای انسان، نصیحت‌های من را بشنوید و دیده‌تان را باز کنید. در دل هرگز بذر نفرت نکارید."],[58,"خداوند خرمن زیان می‌کند","که بر خوشه‌چین سر گران می‌کند","کسی که در برابر خوشه‌چین، یعنی فردی که محصول یا نتیجه کار را برداشت می‌کند، سنگینی کند و او را بی‌احترام کند، در واقع به خود آسیب می‌زند و زیان می‌بیند. خداوند نیز از این رفتار راضی نیست، زیرا این عمل به خود فرد آسیب خواهد زد."],[58,"نترسد که نعمت به مسکین دهند","وزآن بار غم بر دل این نهند؟","نگران نباش که چون نعمت را به بیچاره‌ای می‌دهند، غم و بار سنگین بر دل او نمی‌گذارند؟"],[58,"بسا زورمندا که افتاد سخت","بس افتاده را یاوری کرد بخت","بسیاری از نیرومنسان هم هستند که به سختی می‌افتند و بخت به یاری آن‌ها می‌آید و به دیگران کمک می‌کند."],[58,"دل زیر دستان نباید شکست","مبادا که روزی شوی زیردست","اگر در برابر کسانی که از تو پایین‌تر هستند، دل خود را نشکنید و به آن‌ها ظلم نکنید، ممکن است زمانی تو خود به همان شکل دچار ذلت شوی و به زیر دست آن‌ها قرار بگیری."],[59,"بنالید درویشی از ضعف حال","بر تندرویی خداوند مال","یک درویش از وضعیت ناتوان و ضعیف خود به کسی که مال و ثروت زیادی دارد شکایت می‌کند."],[59,"نه دینار دادش سیه‌دل، نه دانگ","بر او زد به سر باری از طیر، بانگ","نه یک دینار به این درویش سیه‌دل داد، نه به او ضربه‌ای زدید؛ بلکه باعث شدید که بر سر مرغی صدا بلند شود."],[59,"دل سائل از جور او خون گرفت","سر از غم بر آورد و گفت ای شگفت","سائل (درخواست‌کننده) از ستمی که به او می‌شود، بسیار ناراحت و غمگین است و از این وضعیت به شدت متأثر شده است، به طوری که دلش از درد و ظلمی که می‌بیند، خون می‌شود و با تعجب به این شرایط نگاه می‌کند."],[59,"توانگر ترش روی، باری، چراست؟","مگر می‌نترسد ز تلخی خواست؟","چرا فرد ثروتمند با چهره‌ای عبوس و ترش برخورد می‌کند؟ آیا او از تلخی و سختی خواسته‌هایی که ممکن است بر او بیاید، نمی‌ترسد؟"],[59,"بفرمود کوته نظر تا غلام","براندش به خواری و زجر تمام","نسبت به ناتوانان و ضعیفان کینه‌توزی و بی‌رحمی نشان داد و دستور داد غلامش را به سختی و درد و زجر بیفکند."],[59,"به ناکردن شکر پروردگار","شنیدم که برگشت از او روزگار","فراموش کردن سپاسگزاری از خداوند باعث می‌شود که روزگار به بدی روی آورد و به وضعیت نامناسبی دچار شود."],[59,"بزرگیش سر در تباهی نهاد","عطارد قلم در سیاهی نهاد","عظمت و بزرگی او (شخصی که در این بیت به آن اشاره شده) به نابودی و گمراهی رسیده است؛ مانند عطارد که در زیر سایه‌ای تاریک قرار دارد و سرنوشتش به تباهی می‌انجامد."],[59,"شقاوت برهنه نشاندش چو سیر","نه بارش رها کرد و نه بارگیر","شقاوت و بدبختی او را به حالتی درآورد که مثل یک بی‌پوشش و عریان در نهایت ذلت و بی‌حالی قرار گرفت؛ نه طعامی به او داده شد و نه کسی برای کمک به او آمد."],[59,"فشاندش قضا بر سر از فاقه خاک","مشعبد صفت، کیسه و دست پاک","سرنوشت بی‌رحمانه بر سر او افتاد و او که به خاطر فقر و تنگدستی مشابه با کنامه (پشیز) خاک شده بود، کیسه‌اش را devoid از دارایی و دستانش را خالی از ثروت یافت."],[59,"سراپای حالش دگرگونه گشت","بر این ماجرا مدتی بر گذشت","حال و وضع او به خاطر این واقعه تغییر کرد و پس از مدتی این ماجرا به وقوع پیوست."],[59,"غلامش به دست کریمی فتاد","توانگر دل و دست و روشن نهاد","غلام آن شخص ثروتمند و بخشنده‌ای شد که دل و نیتش نیکو و روشن بود و به دیگران کمک می‌کرد."],[59,"به دیدار مسکین آشفته حال","چنان شاد بودی که مسکین به مال","به هنگام دیدار با فردی فقیر و پریشان، آنچنان خوشحال بودی که فقیر نیز به خاطر ثروت تو شاد می‌شد."],[59,"شبانگه یکی بر درش لقمه جست","ز سختی کشیدن قدمهاش سست","در شب، یک نفر به در خانه او آمد و لقمه‌ای درخواست کرد، به خاطر سختی‌هایی که کشیده بود قدم‌هایش ضعیف و ناتوان شده بود."],[59,"بفرمود صاحب نظر بنده را","که خشنود کن مرد درمنده را","صاحب نظر به من دستور داد که مرد بی‌چیز را خوشحال کنم."],[59,"چو نزدیک بردش ز خوان بهره‌ای","برآورد بی خویشتن نعره‌ای","وقتی نزدیک آن مرد بیچاره رفت، برخلاف میل خودش فریادی از شادی کشید."],[59,"شکسته دل آمد بر خواجه باز","عیان کرده اشکش به دیباجه راز","شخصی دل‌شکسته و رنجور به حضور خواجه (مقام‌دار) آمده و اشک‌هایش را به وضوح نشان داده و رازی را که در دل دارد، به او عیان کرده است."],[59,"بپرسید سالار فرخنده خوی","که اشکت ز جور که آمد به روی؟","سالار فرخنده‌خوی، یعنی آن کسی که نیکوست، از او سوال می‌کند که چرا اشک‌هایت به خاطر ظلمی که دیده‌ای بر رویت آمده است؟"],[59,"بگفت اندرونم بشورید سخت","بر احوال این پیر شوریده بخت","سالار فرخنده خوی (یک شخص بزرگ و با نفوذ) گفت که در دل من اضطراب و نگرانی زیادی درباره سرنوشت این پیرمرد بیچاره و بدبخت وجود دارد."],[59,"که مملوک وی بودم اندر قدیم","خداوند املاک و اسباب و سیم","من در گذشته بنده و غلام او بودم، یعنی کسی که مالک زمین‌ها و املاک و دارایی‌های زیادی است."],[59,"چو کوتاه شد دستش از عز و ناز","کند دست خواهش به درها دراز","وقتی انسان مقام و بلندپروازی‌اش کمتر می‌شود و دستش از عزت و شرف کوتاه می‌گردد، به ناچار برای برآورده کردن خواسته‌ها و نیازهایش به درها می‌زند و از دیگران درخواست می‌کند."],[59,"بخندید و گفت ای پسر جور نیست","ستم بر کس از گردش دور نیست","خندید و گفت، ای پسر، این درست نیست که بر کسی ستم کنی؛ زیرا ظلم کردن به دیگران از چرخش روزگار دور نخواهد ماند و زندگی به فرد ستمگر نیز عواقب ناخوشایندی خواهد داشت."],[59,"نه آن تندروی است بازارگان","که بردی سر از کبر بر آسمان؟","این بیت اشاره به فردی دارد که در بازار و تجارت خود دچار طغیان و خودبزرگ‌بینی شده و به خود می‌بالد که با ثروتش بر دیگران فخر می‌فروشد. سعدی می‌پرسد آیا این شخص نباید به جای تندروی و خودپسندی، به ضعف و آسیب‌پذیری انسان‌ها توجه کند؟"],[59,"من آنم که آن روزم از در براند","به روز منش دور گیتی نشاند","من من آن کسی هستم که روزی به خاطر رفتارم از در بیرون رانده خواهیم شد و در نهایت از زندگی همین دنیا و امور آن دور خواهم بود."],[59,"نگه کرد باز آسمان سوی من","فرو شست گرد غم از روی من","از آسمان توجهی به من شد و غم و اندوه از چهره‌ام زدوده گردید."],[59,"خدای ار به حکمت ببندد دری","گشاید به فضل و کرم دیگری","اگر خداوند به سبب حکمت خود در جایی در را ببندد، در جای دیگری به فضل و کرم خود در را به روی دیگران باز می‌کند."],[59,"بسا مفلس بینوا سیر شد","بسا کار منعم زبر زیر شد","بسیاری از آدم‌های بی‌بضاعت و درمانده به برکت دیگران سیر و بهره‌مند شدند، و بسیاری از کارهایی که انسان‌ها به صورت خودپسندانه و با غرور انجام می‌دهند، به واسطه لطف و بخشش دیگران زیر سوال می‌روند."],[60,"یکی سیرت نیکمردان شنو","اگر نیکبختی و مردانه رو","در وصف نیک‌مردان چیزی بشنو؛ اگر نیکبخت و بلند‌همّت هستی."],[60,"که شبلی ز حانوت گندم فروش","به ده برد انبان گندم به دوش","که شبلی روزی از مغازه گندم‌فروش یک کیسه گندم به ده برد. (شبلی: نام عارف مشهوری است)"],[60,"نگه کرد و موری در آن غله دید","که سرگشته هر گوشه‌ای می‌دوید","در میان گندم‌ها مورچه‌ای را دید که با سرگشتگی به‌این سو و آن‌سو می‌رفت."],[60,"ز رحمت بر او شب نیارست خفت","به مأوای خود بازش آورد و گفت","از غم آن (مورچه گم‌گشته) شب نتوانست بخوابد پس مورچه را به وطن خویش باز برد و گفت:"],[60,"مروت نباشد که این مور ریش","پراکنده گردانم از جای خویش","جوانمردی نیست که این مورچه بیچاره را از وطن خویش دور گردانم."],[60,"درون پراکندگان جمع دار","که جمعیتت باشد از روزگار","دل مسکینان و دردمندان را شاد کن، تا قضا و دست روزگار تو را شاد کند."],[60,"چه خوش گفت فردوسی پاک زاد","که رحمت بر آن تربت پاک باد","چه خوب گفته‌است فردوسی پاک‌زاد که‌ رحمت بر خاک پاک او بادا"],[60,"میازار موری که دانه‌کش است","که جان دارد و جان شیرین خوش است","به موری دانه‌کش آزار مرسان زیرا او نیز همچون دیگران جانی دارد و جانش را دوست دارد."],[60,"سیاه اندرون باشد و سنگدل","که خواهد که موری شود تنگدل","سنگدل است کسی که موری را تنگدل بخواهد."],[60,"مزن بر سر ناتوان دست زور","که روزی به پایش در افتی چو مور","ناتوان را میازار زیرا روزی (برای بخشش) به‌او التماس خواهی کرد."],[60,"درون فروماندگان شاد کن","ز روز فروماندگی یاد کن","مسکینان و دردمندان را شاد بگردان، (روز قیامت) و روز درماندگی را فراموش مکن."],[60,"نبخشود بر حال پروانه شمع","نگه کن که چون سوخت در پیش جمع","شمع که به پروانه رحم نکرد؛ ببین که چگونه سوخت."],[60,"گرفتم ز تو ناتوان تر بسی است","تواناتر از تو هم آخر کسی است","فرض کن که خیلی‌ها از تو ضعیف‌تر هستند؛ آخر از تو هم قوی‌تر کسی هست."],[61,"ببخش ای پسر کآدمی زاده صید","به احسان توان کرد و، وحشی به قید","ای پسر، انسان از دست دادن شکار را با نیکی و احسان می‌تواند جبران کند، اما حیوان وحشی را نمی‌توان با بند و قید درآورد."],[61,"عدو را به الطاف گردن ببند","که نتوان بریدن به تیغ این کمند","دشمن را با مهربانی و لطف خود به زنجیر ارتباط و پیوند کن، چون با خشونت و شمشیر نمی‌توان این بند را قطع کرد."],[61,"چو دشمن کرم بیند و لطف و جود","نیاید دگر خبث از او در وجود","زمانی که دشمن نیکی و سخاوت را ببیند، دیگر بدی‌اش از دلش رخت برمی‌بندد و در وجودش نمی‌ماند."],[61,"مکن بد که بد بینی از یار نیک","نروید ز تخم بدی بار نیک","اگر بدی انجام دهی، از کسی که خیرخواه توست، نتیجه‌ای نخواهی گرفت؛ زیرا از بذر بدی نمی‌توان میوه نیک برداشت کرد."],[61,"چو با دوست دشخوار گیری و تنگ","نخواهد که بیند تو را نقش و رنگ","اگر با دوست خود به سختی رفتار کنی و او را برنجانی، انتظار نداشته باش که او تو را در حال خوشی ببیند یا تفاوتی در رنگ و روی تو ببیند."],[61,"و گر خواجه با دشمنان نیکخوست","بسی بر نیاید که گردند دوست","اگر کسی با دشمنان، رفتار نیکو داشته باشد، بسیار دشوار است که بتواند آن‌ها را به دوستی تبدیل کند."],[62,"به ره بر یکی پیشم آمد جوان","به تک در پیش گوسفندی دوان","در راه، جوانی به صورت تنها با گوسفندی در حال دویدن از کنار من رد شد."],[62,"بدو گفتم این ریسمان است و بند","که می‌آرد اندر پیت گوسفند","من به آن جوان گفتم که این ریسمان و بند، موجب می‌شود که گوسفند را به دام بیندازند."],[62,"سبک طوق و زنجیر از او باز کرد","چپ و راست پوییدن آغاز کرد","بهنام اعظمیان : طنابی که بر گردن گوسفند بود را از او باز کرد ، و مرد جوان شروع کرد به چپ و راست حرکت کردن ( تا به گوینده بفهماند که این گوسفند بدون طناب و زنجیر هم در پی صاحب گوسفند خواهد آمد )"],[62,"هنوز از پیش تازیان می‌دوید","که جو خورده بود از کف مرد و خوید","بهنام اعظمیان : گوسفند بدون طناب نیز همچنان شتابان در پی مرد جوان می دوید ، چرا که از دست مرد جوان جو و گندم خورده بود ( به دلیل محبتی که تز مرد جوان دیده بود همچنان در پی او میرفت )"],[62,"چو باز آمد از عیش و شادی به جای","مرا دید و گفت ای خداوند رای","پس از اینکه او از خوش‌گذرانی و شادی بازگشت، مرا در آنجا مشاهده کرد و گفت: ای صاحب عقل و تدبیر."],[62,"نه این ریسمان می‌برد با منش","که احسان کمندی است در گردنش","این ریسمان با رفتار و منش من نمی‌آید که مرا به خود بکشاند؛ چون احسان و نیکی مانند کمندی است که دل‌ها را به تسخیر درمی‌آورد."],[62,"به لطفی که دیده‌ست پیل دمان","نیارد همی حمله بر پیلبان","پیل دمان، با لطف و مهری که از او دیده است، هرگز به جنگ پیلبان (کسی که او را تربیت کرده و بر او تسلط دارد) نمی‌رود. یعنی به خاطر محبت و نیکی‌ای که به او شده، حیوان قوی و جنگجو به او آسیب نمی‌زند."],[62,"بدان را نوازش کن ای نیکمرد","که سگ پاس دارد چو نان تو خورد","ای مرد نیکوکار، بدان افرادی را که به تو وابسته‌اند با محبت و نوازش خود در بر بگیر، چرا که پشتیبان و محافظ تو هستند به اندازه‌ای که اگر نان تو را بخورند، از تو دفاع می‌کنند."],[62,"بر آن مرد کند است دندان یوز","که مالد زبان بر پنیرش دو روز","مردی که دلش به خوبی دیگران نرم می‌شود، به اندازه‌ی یوز (نوعی حیوان درنده) دندان تیز و برنده‌ای دارد، و اگر زبانش هم به پنیر برسد، در دو روز آن را می‌مالد و می‌خورد. این به این معناست که او سرسخت و طمعکار است، حتی اگر به ظاهری خوب و مهربان جلوه کند."],[63,"یکی روبهی دید بی دست و پای","فروماند در لطف و صنع خدای","شخصی روباهی را دید که دست و پا نداشت، با دیدن این وضعیت در کار خلقت آن توسط خداوند شگفت زده شد."],[63,"که چون زندگانی به سر می‌برد","بدین دست و پای از کجا می‌خورد","که این روباه با این شرایط چطوری زندگی خود را سپری می‌کند و غذا را چگونه بدست می‌آورد."],[63,"در این بود درویش شوریده‌ رنگ","که شیری درآمد شغالی به چنگ","در همین حین که مرد به این موضوع فکر میکرد، شیری را دید که شغالی را شکار کرده بود."],[63,"شغال نگون‌بخت را شیر خورد","بماند آنچه روبه از آن سیر خورد","شیر، شغال را خورد و ته مانده آنرا رها کرد. روباه نیز ته مانده شکار شیر را خورد و سیر شد."],[63,"دگر روز باز اتفاق اوفتاد","که روزی‌رسان قوت روزش بداد","روز بعدی نیز اتفاقی مشابه افتاد و دوباره روباه به نحوی سیر شد."],[63,"یقین، مرد را دیده بیننده کرد","شد و تکیه بر آفریننده کرد","مرد از آنچه با چشمانش دیده بود کاملا مطمئن شد و یقین پیدا کرد برای کسب روزی می تواند تنها به قدرت روزی‌رسانی خدواند تکیه کند."],[63,"کز این پس به کنجی نشینم چو مور","که روزی نخوردند پیلان به زور","با خود گفت از این به بعد میخواهم مانند مورچه که بی آزار است گوشه‌ای بنشینم چون خداوند خودش روزی را میرساند، همانطور که فیل‌ها با آن همه قدرتشان، بوسیله زورشان سیر نمی‌شوند بلکه این خداوند است که به آن‌ها روزی میرساند."],[63,"زنخدان فرو برد چندی به جیب","که بخشنده روزی فرستد ز غیب","زنخدان (چال روی فک پایین صورت) را به یقیه چسباند یعنی سر فرو آورد به حالت نیاز. شروع کرد به راز و نیاز (تمنا) که خداوند از غیب جایی که او نمی‌داند روزی او را بفرستد."],[63,"نه بیگانه تیمار خوردش نه دوست","چو چنگش رگ و استخوان ماند و پوست","در این مدت هیچ کسی، نه آشنا و نه غریبه، به او توجه نکرده و به فکر او نبودند. مرد چنان لاغر شده بود که تنها پوست و استخوانش باقی مانده بود."],[63,"چو صبرش نماند از ضعیفی و هوش","ز دیوار محرابش آمد به گوش","زمانیکه از شدت ضعف طاقت و صبرش را از دست داده بود و هوش و حواس درستی برایش نمانده بود، ناگهان ندایی درونی را شنید که:"],[63,"برو شیر درنده باش، ای دغل","مینداز خود را چو روباه شل","ای حیله‌گر! تو باید همانند آن شیر درنده باشی که شکار میکرد، نه شبیه آن روباه شلی که دست و پا نداشت!"],[63,"چنان سعی کن کز تو ماند چو شیر","چه باشی چو روبه به وامانده سیر","باید انقدر تلاش کنی که مثل شیر هم خودت را سیر کنی و هم بقیه را؛ نه آنکه همانند یک روباه بی دست و پا، محتاج ته مانده‌ی غذای دیگران باشی تا سیر شوی!"],[63,"چو شیر آن که را گردنی فربه است","گر افتد چو روبه، سگ از وی به است","کسی که مانند شیر، گردن کلفت و قوی است، اگر خودش را مانند یک روباه بی دست و پا به زمین بیندازد، وجود و شرافت یک سگ از او بیشتر است."],[63,"به چنگ آر و با دیگران نوش کن","نه بر فضله دیگران گوش کن","روزی خودت را با تلاش و به دست خودت فراهم کن و با دیگران بخور نه اینکه منتظر باشی که ته مانده غذای دیگران را بخوری."],[63,"بخور تا توانی به بازوی خویش","که سعیت بود در ترازوی خویش","تا می توانی به همت بازو، مردانگی و کوشش خودت روزی کسب کن، که این سعی و تلاش تو بیهوده نخواهد بود زیرا در ترازوی اعمالت ثبت میشود و به آن پاداش داده می‌شود."],[63,"چو مردان ببر رنج و راحت رسان","مخنث خورد دسترنج کسان","مثل مرد باش، زحمت بکش و کار کن و به دیگران آسایش و راحتی برسان چراکه آدم سست‌عنصر و بی‌عرضه منتظر کمک دیگران است."],[63,"بگیر ای جوان دست درویش پیر","نه خود را بیفکن که دستم بگیر","ای جوان! تو باید دست پیران را بگیری و به آنان کمک کنی نه آنکه خودت را به زمین بیندازی تا دیگران کمکت کنند."],[63,"خدا را بر آن بنده بخشایش است","که خلق از وجودش در آسایش است","خداوند به بندگانی لطف می کند و گناهانشان را می آمرزد که دیگران به لطف وجود آنان در آسایش باشند و کمک رسان دیگران باشد."],[63,"کرم ورزد آن سر که مغزی در اوست","که دون‌همّتانند بی مغز و پوست","کسی که عاقل باشد، به دیگران می بخشد اما آنکه بی عقل و تهی از خرد باشد و بر کمک به دیگران همت نکند به جز تن و پوست ظاهری چیزی ندارد."],[63,"کسی نیک بیند به هر دو سرای","که نیکی رساند به خلق خدای","مطمئنا کسی در دنیا و آخرت خوشبخت و سعادتمند خواهد شد که به خلق خدا کمک و یاری می‌رساند."],[64,"شنیدم که مردی است پاکیزه بوم","شناسا و رهرو در اقصای روم","شنیدم که مردی وجود دارد که اهل کثافت نیست و با اطلاع از جغرافیا، در دورترین نقاط روم سفر می‌کند."],[64,"من و چند سیاح صحرانورد","برفتیم قاصد به دیدار مرد","من و چند مسافر بیابان‌گرد به سوی مردی که شناخته شده است، قاصدی فرستادیم تا او را ملاقات کنیم."],[64,"سر و چشم هر یک ببوسید و دست","به تمکین و عزت نشاند و نشست","هر کدام از آن‌ها را با عشق و احترام بوسید و دستان خود را به نشانه احترام و بزرگ‌منشی بر سر آن‌ها گذاشت و نشست."],[64,"زرش دیدم و زرع و شاگرد و رخت","ولی بی مروت چو بی بر درخت","زر و محصولات زراعی و شاگردان و لباس‌های زیبا را دیدم، اما مانند درختی که بدون میوه است، بی‌مروتی را دیدم."],[64,"به لطف و سخن گرم رو مرد بود","ولی دیگدانش عجب سرد بود","مردی که به لطف و گفتار شیرین مشهور است، اما در واقع درونش سرد و بی‌احساس است و از صمیمیت واقعی بی‌بهره است."],[64,"همه شب نبودش قرار و هجوع","ز تسبیح و تهلیل و ما را ز جوع","او در طول شب آرام و قرار نداشت و نمی‌توانست بخوابد؛ زیرا مشغول ذکر و دعا (تسبیح و تهلیل) بود، اما ما بخاطر گرسنگی در عذاب بودیم."],[64,"سحرگه میان بست و در باز کرد","همان لطف و پرسیدن آغاز کرد","صبح زود در را باز کرد و با جود و مهربانی شروع به صحبت و پرسش از حال ما نمود."],[64,"یکی بد که شیرین و خوش طبع بود","که با ما مسافر در آن ربع بود","یک نفر بود که شیرین‌زبان و خوش‌خلق بود و در آن محله با ما همسفر شده بود."],[64,"مرا بوسه گفتا به تصحیف ده","که درویش را توشه از بوسه به","تصحیف آن است که با تغییر و تبدیل نقاط کلمات، معنای مصرع یا بیت عوض شده مثلا از مدح به ذم کشد‌. در اینجا تصحیف «‌بوسه‌» می‌شود توشه."],[64,"به خدمت منه دست بر کفش من","مرا نان ده و کفش بر سر بزن","مرا به خدمت نگیر و دستت را به پاهایم نزن، بلکه به من نان بده و کفش را بر سرت بگذار."],[64,"به ایثار مردان سبق برده‌اند","نه شب زنده داران دل مرده‌اند","مردانی که ایثار کرده‌اند و در کار خیر پیشتاز هستند، بر شب‌زنده‌داران که دل‌های خالی از امید دارند، تقدم دارند."],[64,"همین دیدم از پاسبان تتار","دل مرده و چشم شب زنده‌دار","من از پاسبان تاتاری که دلش مرده و به شب زنده‌داران خیره نشده، همین را مشاهده کردم."],[64,"کرامت جوانمردی و نان دهی است","مقالات بیهوده طبل تهی است","عمل نیک و جوانمردی یعنی کمک به دیگران و نیکوکار بودن، اما سخن گفتن بیهوده و نظریه‌های بی‌فایده هیچ ارزشی ندارد."],[64,"قیامت کسی بینی اندر بهشت","که معنی طلب کرد و دعوی بهشت","در روز قیامت کسی را می‌بینی که در بهشت حضور دارد، اما به دنبال معنا و حقیقتی از بهشت است و در واقع به دنبال اثبات خود و ادعای بهشت است."],[64,"به معنی توان کرد دعوی درست","دم بی قدم تکیه گاهی است سست","فردی که در بهشت ادعای معانی و موضوعات بزرگ را می‌کند، باید بداند که برای اثبات ادعایش، تنها با زبانی نیکو نمی‌تواند استدلال کند، زیرا پایه‌اش سست و بی‌پایه است."],[65,"شنیدم در ایام حاتم که بود","به خیل اندرش بادپایی چو دود","در زمان حاتم طائی، شنیدم که در دسته و هیئت او، فردی بسیار سریع و چابک مانند دود وجود داشت."],[65,"صبا سرعتی، رعد بانگ ادهمی","که بر برق پیشی گرفتی همی","نسیم، با شتاب و سرعتی که دارد، به مانند رعدی است که صدایی تیره دارد و از رعد و برق جلوتر می‌زند."],[65,"به تک ژاله می‌ریخت بر کوه و دشت","تو گفتی مگر ابر نیسان گذشت","باران به شکل قطرات ریز بر کوه و دشت می‌بارید و گویی این باران خاص و نادر است، به‌طوری‌که به نظر می‌رسد ابرهای فصل بهار دیگر از این منطقه عبور کرده‌اند."],[65,"یکی سیل‌رفتار هامون‌نورد","که باد از پی‌اش باز ماندی چو گرد","به یکنوع مردی مانند سیل که شجاعت و بزرگی او را به یاد می‌آورد، اشاره شده است به‌طوری‌که حتی باد نیز نتوانست به او برسد و از او پیشی بگیرد."],[65,"ز اوصاف حاتم به هر مرز و بوم","بگفتند برخی به سلطان روم","حکایت‌های جوانمردی و بخشش‌های حاتم طائی را در هر جا و نزد هر قوم و ملتی نقل کرده‌اند، حتی در دربار پادشاه روم نیز درباره او صحبت شده است."],[65,"که همتای او در کرم مرد نیست","چو اسبش به جولان و ناورد نیست","هیچ‌کس را در سخاوت و بخشندگی به پای او نمی‌رسانند، همان‌طور که در شجاعت و نبرد نیز هم‌ردیفی ندارد."],[65,"بیابان‌نورد‌ی چو کشتی بر آب","که بالای سیرش نپرد عقاب","حرکت و تلاش در بیابان مانند راه رفتن بر روی آب است که هیچ پرنده‌ای به بالای آن نمی‌رود. این به نوعی نشان‌دهنده سختی و عدم تسلط بر شرایط است."],[65,"به دستور دانا چنین گفت شاه","که دعوی خجالت بود بی‌گواه","شاه به فرمان دانا گفته است که ادعای خجالت و شرم بدون شاهد و دلیل معنی ندارد."],[65,"من از حاتم آن اسب تازی‌نژاد","بخواهم، گر او مکرمت کرد و داد","من از حاتم طایی، آن جوانمرد بزرگ، خواهان اسب تازی هستم، اگر او نیکی کند و به من ببخشد."],[65,"بدانم که در وی شکوه مهی‌ست","وگر رد کند‌، بانگ طبل تهی‌ست","من می‌دانم که در شخصیت حاتم طائی عظمت و شکوهی وجود دارد و اگر او چیزی را نپذیرد، در واقع چیزی برای ستایش ندارد و همه‌چیز بی‌معنا خواهد بود."],[65,"رسولی هنرمند عالم به طی","روان کرد و ده مرد همراه وی","خدایی فرستاده‌ای هنرمند و توانمند را به سفر روانه کرد و ده مرد را نیز به همراه او فرستاد."],[65,"زمین مرده و ابر گریان بر او","صبا کرده بار دگر جان در او","زمین بی‌روح و فاقد حیات است، و ابرها مثل کسانی که در حال گریه‌اند، بر آن باران می‌بارند و دوباره زندگی به آن می‌بخشند."],[65,"به منزل‌گه حاتم آمد فرود","بر آسود چون تشنه بر زنده‌رود","به خانه حاتم طایی آمد، همان‌طور که تشنه‌مردی به کنار رودخانه زنده که آب دارد، آرامش می‌یابد و استراحت می‌کند."],[65,"سماطی بیفکند و اسبی بکشت","به‌دامن شکر دادشان‌، زر به مشت","به‌دامن‌: مقداری از چیزی مانند گندم و شکر و ... که در دامن بریزند در اینجا یعنی زیاد."],[65,"شب آن‌جا ببودند و روز دگر","بگفت آنچه دانست صاحب‌خبر","در شب آنجا ماندند و روز بعد، آنچه را که از ماجرا آگاه بود، گفت."],[65,"همی‌گفت حاتم پریشان چو مست","به دندان ز حسرت همی‌کند دست","حاتم، که در حالتی پریشان و شبیه به آدم مست است، با حسرت به دندان‌هایش نگاه می‌کند و دستش را به سمت آن‌ها می‌برد."],[65,"که ای بهره‌ور موبد نیک‌نام","چرا پیش از اینم نگفتی پیام‌؟","حاتم طایی، که فردی نیکوکار و معروف به جوانمردی است، از موبد نیکوکار می‌پرسد که چرا پیام او را قبل از این نیاورده و به او خبر نداده است."],[65,"من آن باد‌رفتار‌ دلدل‌شتاب","ز بهر شما دوش کردم کباب","من برای شما دو نفر به خاطر محبت‌تان، دیشب به خاطر شما سنگین‌ترین کارها را انجام دادم و خود را به زحمت انداختم."],[65,"که دانستم از هول باران و سیل","نشاید شدن در چراگاه خیل","از ترس باران و سیل فهمیدم که نباید در چراگاه انبوه دام‌ها قرار بگیرم."],[65,"به نوعی دگر روی و راهم نبود","جز او بر در بارگاهم نبود","به گونه‌ای دیگر نمی‌توانستم به او روی آورم و جز او کسی در درگاه من نبود."],[65,"مروّت ندیدم در آیین خویش","که مهمان بخسبد دل از فاقه ریش","من در رفتار خود جوانمردی را ندیدم که اجازه دهد مهمان به دلیل فقر و تنگدستی، ناراحت و دلشکسته بخوابد."],[65,"مرا نام باید در اقلیم فاش","دگر مرکب نامور گو مباش","باید نام من در میان مردم شناخته شود و در این زمینه من به کسی که مشهور است، نیازی ندارم."],[65,"کسان را درم داد و تشریف و اسب","طبیعی‌ست اخلاق نیکو‌، نه کسب","خوبی و نیک‌سلوکی ویژگی ذاتی انسان است و مربوط به مال و ثروت یا مقام و جواهر نیست. کسی که رفتار نیکو دارد، جزو بزرگ‌ترین و محترم‌ترین افراد است، نه کسانی که فقط از دارایی‌های مادی برخوردارند."],[65,"خبر شد به روم از جوانمرد طی","هزار آفرین گفت بر طبع وی","خبر رسید به روم درباره جوانمردی حاتم طائی و به خاطر طبیعت خوبی که داشت، هزاران ستایش بر او نثار کردند."],[65,"ز حاتم بدین نکته راضی مشو","از این خوب‌تر ماجرا‌یی شنو","از داستان حاتم طایی راضی نشو، از این بهتر ماجرایی بشنو."],[66,"ندانم که گفت این حکایت به من","که بوده‌ست فرماندهی در یمن","نمی‌دانم این داستان را چه کسی به من گفته است و فرمانده‌ای که در یمن بوده، چه کسی بوده است."],[66,"ز نام‌آور‌ان گوی دولت ربود","که در گنج‌بخشی نظیر‌ش نبود","حکایت می‌کند که حاتم طایی، که در بخشش و کمک به دیگران مشهور است، از میان شخصیت‌های نامی و معروف، برنده این مقام و عنوان است و در سخاوت و generosity هیچ‌کس به گرد پای او نمی‌رسد."],[66,"توان گفت او را سحاب کرم","که دستش چو باران فشاندی درم","می‌توان گفت که او مانند ابر بخشندگی است، چرا که دستش مانند باران، زر و پول را پراکنده می‌کند."],[66,"کسی نام حاتم نبردی برش","که سودا نرفتی از او بر سرش","هیچ‌کس درباره‌ی حاتم سخن نمی‌گوید، مگر اینکه از او درخواست یا خواسته‌ای داشته باشد و در دلش حرص و طمعی باشد."],[66,"که چند از مقالات آن بادسنج","که نه ملک دارد نه فرمان نه گنج","این شعر به حکایت و گفتارهای خوش برادرانه اشاره دارد که از فردی به نام بادسنج (کسی که درباره وضعیت روحی یا اجتماعی افراد قضاوت می‌کند) آمده، ولی خود او نه قدرتی دارد، نه فرمانروایی، و نه ثروتی. این جمله نشان‌دهنده بی‌اعتباری نظرات افرادی است که خود چیزی ندارند و فقط در مورد دیگران قضاوت می‌کنند."],[66,"شنیدم که جشنی ملوکانه ساخت","چو چنگ اندر آن بزم‌، خلقی نواخت","شنیدم که پادشاهی جشنی باشکوه برگزار کرد و در آن جشن، مردم مانند چنگ (ساز موسیقی) نغمه‌سرایی کردند و آهنگ‌های شادی‌بخش خواندند."],[66,"در‌ ذکر حاتم کسی باز کرد","دگر کس ثنا گفتن آغاز کرد","در میان جشن، کسی نام حاتم را بر زبان آورد و بعد از او، دیگران شروع به ستایش او کردند."],[66,"حسد مرد را بر سر کینه داشت","یکی را به خون خوردنش بر گماشت","مرد حسود به خاطر کینه‌اش، کسی را به قتل کسی دیگر گماشته بود تا او را به خاطر دشمنی‌اش بکشد."],[66,"که تا هست حاتم در ایام من","نخواهد به نیکی شدن نام من","تا زمانی که حاتم در این دوران زنده است، نام من به نیکی شناخته نخواهد شد."],[66,"بلا جوی راه بنی طی گرفت","به کشتن جوانمرد را پی گرفت","عارضه و بلا، راه بنی‌طی (مردمان نیکوکار) را گرفت و به سمت کشتن جوانمرد (حاتم) رفت."],[66,"جوانی به ره پیشباز آمدش","کز او بوی انسی فراز آمدش","جوانی به سمت او آمد که بوی دوستی و صمیمیت از او به مشام می‌رسید."],[66,"نکو‌روی و دانا و شیرین‌زبان","بر خویش برد آن شبش میهمان","در آن شب، جوانی زیبا و باهوش و خوش‌زبان را به خانه‌اش دعوت کرد و پذیرایی کرد."],[66,"کرم کرد و غم خورد و پوزش نمود","بد‌اندیش را دل به نیکی ربود","حاتم در این شب برای میهمانانی که در نزد او بودند، مهربانی و بخشش نشان داد و با وجود غم و ناراحتی، از آن‌ها عذرخواهی کرد تا دل کسانی که به او بد فکر کرده بودند را با کار نیکش تسخیر کند."],[66,"نهادش سحر بوسه بر دست و پای","که نزدیک ما چند روزی بپای","حاتم طایی در برابر مهمانان خود به احترام و ادب به بوسه زدن بر دست و پای آنها می‌پردازد، زیرا او می‌داند که مدت زیادی نمی‌تواند در کنار آن‌ها بماند و می‌خواهد از این لحظات بهره ببرد."],[66,"بگفتا نیارم شد اینجا مقیم","که در پیش دارم مهمی عظیم","حاتم می‌گوید نمی‌توانم در اینجا بمانم چون مسئله‌ای بزرگ و مهم در پیش دارم."],[66,"بگفت ار نهی با من اندر میان","چو یاران یکدل بکوشم به جان","گفت اگر با من دوست نباشی و کنار نروی، مانند یاران یکدل، برایت با تمام وجود تلاش می‌کنم."],[66,"به من دار گفت، ای جوانمرد، گوش","که دانم جوانمرد را پرده‌پوش","حاتم، در پاسخ به جوانمردی که به او گفت، ای جوانمرد، می‌گوید که من می‌دانم جوانمرد واقعی کسی است که عیب‌ها و ناپسندی‌های خود را پنهان می‌کند و خود را در معرض قضاوت دیگران قرار نمی‌دهد."],[66,"در این بوم حاتم شناسی مگر","که فرخنده‌رای است و نیکو‌سیر‌؟","در این دیار، آیا کسی غیر از حاتم می‌تواند به نیکی و بزرگی معروف باشد و صفات خوب را داشته باشد؟"],[66,"سرش پادشاه یمن خواسته‌ست","ندانم چه کین در میان خاسته‌ست!","پادشاه یمن، در مورد حاتم تمایل و خواسته‌ای دارد که نمی‌دانم چه دشمنی یا حسادتی در این درخواست نهفته است."],[66,"گرم ره نمایی بدان‌جا که اوست","همین چشم دارم ز لطف تو دوست","اگر مرا به آن جایی که او (پادشاه یمن) است راهنمایی کنی، من همین چشم را برای دیدار تو دارم و از لطف تو شکرگزارم."],[66,"بخندید برنا که حاتم منم","سر اینک جدا کن به تیغ از تنم","حاتم در اینجا خود را معرفی می‌کند و می‌گوید که من حاتم هستم، پس به من کمک کن و اگر قرار است که به خاطر عدم احسان من به من آسیب بزنید، این کار را بکنید."],[66,"نباید که چون صبح گردد سفید","گزندت رسد یا شوی ناامید","وقتی صبح می‌شود و روز روشن می‌شود، نباید دچار ناامیدی یا آسیب شوی."],[66,"چو حاتم به آزادگی سر نهاد","جوان را برآمد خروش از نهاد","وقتی حاتم در کار آزادگی و سخاوت تسلیم شد، جوان با هیجان و شوق فریاد زد و از درونش احساساتی برآمد."],[66,"به خاک اندر افتاد و بر پای جست","گهش خاک بوسید و گه پای و دست","او (حاتم) بر زمین افتاد و سپس بر پا ایستاد، گاهی خاک را بوسید و گاهی پا و دستش را."],[66,"بینداخت شمشیر و ترکش نهاد","چو بیچارگان دست بر کش نهاد","او شمشیر و کمانش را روی زمین انداخت و مانند بیچارگان، از جنگیدن دست برداشت و تسلیم شد."],[66,"که من گر گلی بر وجودت زنم","به نزدیک مردان نه مردم، زنم","اگر من بر وجود تو گلی بزنم، به نظر مردان، نه به نظر این مردم (عادی) اهمیت دارد."],[66,"دو چشمش ببوسید و در بر گرفت","وز آنجا طریق یمن بر گرفت","دو چشم حاتم را بوسید و او را در آغوش گرفت و از آنجا به سوی یمن حرکت کرد."],[66,"ملک در میان دو ابروی مرد","بدانست حالی که کاری نکرد","حالی‌: فورا‌."],[66,"بگفتا بیا تا چه داری خبر","چرا سر نبستی به فتراک بر؟","او گفت: بیا ببین چقدر خبر داری، چرا سر خود را در فتراک (زین) نگذاشتی؟"],[66,"مگر بر تو نام‌آوری حمله کرد‌","نیاوردی از ضعف تاب نبرد؟","آیا بر تو نام‌آوری (شخصیت بزرگ و معتبری) حمله کرده که نتوانستی از ضعف، تحمل کن؟"],[66,"جوانمرد شاطر زمین بوسه‌داد","ملک را ثنا گفت و تمکین نهاد","حاتم، جوانمرد و شجاع، با فروتنی و احترام، از پادشاه یمن قدردانی کرد و به او ارادت نشان داد."],[66,"که دریافتم حاتم نامجوی","هنرمند و خوش‌منظر و خوبروی","من فهمیدم که حاتم، فردی جستجوگر، هنرآفرین و زیباچهره است."],[66,"جوانمرد و صاحب‌خرد دیدمش","به مردانگی فوق خود دیدمش","حاتم را که جوانمرد و دانا می‌دانم، در مردانگی از همه برتر یافتم."],[66,"مرا بار لطفش دو تا کرد پشت","به شمشیر احسان و فضلم بکشت","این بیت می‌گوید که شخصی با لطف و مهربانی خود، مرا به مقام بالاتری رسانده و من را از خطر و آسیب دور کرده، به گونه‌ای که با صداقت و احسانش، قدرت و ظلم را خنثی کرده است."],[66,"بگفت آنچه دید از کرم‌های وی","شهنشه ثنا گفت بر آل طی","گفت آنچه از بخشندگی‌های حاتم، بزرگ‌زاده و پادشاه یمن، مشاهده کرده بود، و در ستایش او و خانواده‌اش (آل طی) سخن گفت."],[66,"فرستاده را داد مهری درم","که مهر است بر نام حاتم کرم","پادشاه یمن به فرستاده خود درمی (سکه‌ای از نقره) داد تا نشانه‌ای از بزرگی و کرامت حاتم باشد."],[66,"مر او را سزد گر گواهی دهند","که معنی و آوازه‌اش همرهند","سزاوار است که او (حاتم) را گواهی بدهند که شخصیت و شهرتش با یکدیگر همخوانی دارد."],[67,"شنیدم که طی در زمان رسول","نکردند منشور ایمان، قبول","شنیدم که در زمان پیامبر، هیچ‌کس از قبیله طيّ ایمان نیاوردند."],[67,"فرستاد لشکر، بشیر نذیر","گرفتند از ایشان گروهی اسیر","پیامبر بشیر و نذیر (بشارت دهنده و بیم دهنده) لشکری به سوی آنان فرستاد و لشکریان از آن قبیله گروهی را اسیر کردند."],[67,"بفرمود کشتن به شمشیر کین","که ناپاک بودند و ناپاک دین","فرمان داد که این گروه را به خاطر ناپاکی و عقاید نادرستشان با شمشیر بکشند."],[67,"زنی گفت من دختر حاتمم","بخواهید از این نامور حاکمم","زنی اعلام کرد که من دختر حاتم طایی هستم، از این حاکم مشهور درخواست کنید (تا مرا بشناسد)."],[67,"کرم کن به جای من ای محترم","که مولای من بود از اهل کرم","لطفا به من لطف و محبت کن، زیرا مولای من (پدرم) اهل بخشش بود."],[67,"به فرمان پیغمبر نیک‌رای","گشادند زنجیرش از دست و پای","به دستور پیامبر بزرگوار، زنجیرهایی که به دستان و پای حاتم (حاتم طایی، نماد بخشش و کرم) بسته بودند، باز کردند."],[67,"در آن قوم باقی نهادند تیغ","که رانند سیلاب خون، بی‌دریغ","در بقیه آن قوم شمشیر قتل نهادند به گونه‌ای که سیلاب خون جاری گردد."],[67,"به‌ زاری به شمشیر‌زن گفت زن","مرا نیز با جمله، گردن بزن","زن با زاری به شمشیرزن گفت که او را نیز مانند سایرین به قتل برساند."],[67,"مروّت نبینم رهایی ز بند","به تنها و یارانم اندر کمند","جوانمردی نیست که من به تنهایی از بند رهایی یابم و اهل قبیله‌ام در کمند گرفتار باشند."],[67,"همی‌گفت و گریان بر احوال طی","به سمع رسول آمد آواز وی","می گفت و بر احوال قبیله طی گریه می کرد. سخن او به گوش پیامبر رسید."],[67,"ببخشود آن قوم و دیگر عطا","که هرگز نکرد اصل و گوهر خطا","بخشید اولا آن مردم را و دوم عطا را [به آن مردم]؛ که آن دختر اصل گوهر خود را نشان داد. [ر ک شرح دکتر خزائلی]"],[68,"ز بنگاه حاتم یکی پیرمرد","طلب ده درم سنگ فانید کرد","از محل زندگی حاتم طائی، یک پیرمرد درخواست کرد تا ده درم (ده درهم) به او بدهد که شاید به خودش رسیده باشد."],[68,"ز راوی چنان یاد دارم خبر","که پیشش فرستاد تنگی شکر","از راوی شنیدم که خبر داده بود به حاتم طائی که مقدار کمی شکر برای او فرستاده‌اند."],[68,"زن از خیمه گفت این چه تدبیر بود؟","همان ده درم حاجت پیر بود","زن از خیمه پرسید این چه تدبیر و نقشه‌ای بود؟ همان ده فقط نیاز مردی سالخورده را برطرف می‌کرد."],[68,"شنید این سخن نامبردار طی","بخندید و گفت ای دلارام حی","حاتم طایی که فردی مشهور به بخشندگی است، این سخن را شنید و با لبخند گفت ای محبوب و دلنواز."],[68,"گر او در خور حاجت خویش خواست","جوانمردی آل حاتم کجاست؟","اگر او (حاتم طائی) برای برآورده‌کردن نیاز خود، به جوانمردی نیاز داشته باشد، باید دنبال جوانمردی به اندازه حاتم بگردد، زیرا کسی مانند او در بین مردم وجود ندارد."],[68,"چو حاتم به آزادمردی دگر","ز دوران گیتی نیامد مگر","هیچ شخصی مانند حاتم طایی به آزادمنشی و نیکوکاری در تاریخ وجود نداشته است."],[68,"ابوبکر سعد آن که دست نوال","نهد همّتش بر دهان سؤال","ابوبکر سعد کسی است که با دست نیکوئی خود بخشش می‌کند و اراده‌اش باعث می‌شود سوالات برطرف شود."],[68,"رعیت‌پناها‌! دلت شاد باد‌!","به سعی‌ات مسلمانی آباد باد‌!","ای تکیه‌گاه مردم! امیدوارم دلت شاد باشد و تلاش‌هایت باعث آبادانی و خوشبختی مسلمانان شود."],[68,"سرافرازد این خاک فرخنده بوم","ز عدلت بر اقلیم یونان و روم","این خاک خوشبخت و با سعادت به خاطر عدالت تو، بر سرزمین‌های یونان و روم درخشان و سر بلند است."],[68,"چو حاتم، اگر نیستی کام وی","نبردی کس اندر جهان نام طی","اگر تو مانند حاتم طائی، کسی کمال بخشش و احسان نیستی، دست کم مثل او، کسی را در دنیا زحمت داده‌ای، به نام نیکو مشهور نشده‌ای."],[68,"ثنا ماند از آن نامور در کتاب","تو را هم ثنا ماند و هم ثواب","اگر نام حاتم طایی در کتاب‌ها به نیکی یاد شده و او در تاریخ ستایش شده، این نشان می‌دهد که تو نیز با نیکوکاری و احسان، نام نیک از خود بر جای خواهی گذاشت و به آن ثواب خواهی رسید."],[68,"که حاتم بدان نام و آوازه خواست","تو را سعی و جهد از برای خداست","حاتم طائی به خاطر نام و شهرت خود، به خاطر خدا تلاش و کوشش می‌کند تا دیگران را یاری کند."],[68,"تکلّف بر مرد درویش نیست","وصیت همین یک سخن بیش نیست","انجام دادن کارهای سخت و غیرضروری بر انسان فقیر و درویش خوب نیست و همین یک نکته کافی است."],[68,"که چندان که جهدت بود خیر کن","ز تو خیر ماند‌، ز سعدی سخن","چقدر که تلاش کنی برای انجام کارهای نیک، از تو خیر باقی می‌ماند و این سخن از سعدی است."],[69,"یکی را خری در گل افتاده بود","ز سوداش خون در دل افتاده بود","یک مردی به دلیل فکر کردن به چیزی سخت و دردناک، غم و اندوهی در دلش حس می‌کرد، انگار که او در گلی از مشکلات گرفتار شده است."],[69,"بیابان و باران و سرما و سیل","فرو هشته ظلمت بر آفاق ذیل","در این بیت، به اوضاع سخت و ناگوار اشاره می‌شود که بیابان، باران، سرما و سیل موجب ظلمت و تاریکی در دنیا شده‌اند."],[69,"همه شب در این غصه تا بامداد","سقط گفت و نفرین و دشنام داد","شخصی همه شب به خاطر غمی که دارد، بی‌وقفه ناله و نفرین می‌کند و دشنام می‌گوید."],[69,"نه دشمن برست از زبانش نه دوست","نه سلطان که این بوم و بر زآن اوست","او نه از زبانش چیزی به دشمن می‌گوید و نه به دوست و نه به سلطان؛ زیرا این زمین و سرزمین تحت تأثیر اوست."],[69,"قضا را خداوند آن پهن‌دشت","در آن حال‌ منکر بر او بر گذشت","قضا و قدر خداوند در آن صحنه‌ی وسیع و گسترده به نحوی بر او مستولی شد که در آن زمان، کارها ناپسند به نظر می‌آمدند."],[69,"شنید این سخن‌های دور از صواب","نه صبر شنیدن‌، نه روی جواب","این سخن‌ها که دور از حقیقت و درست است را شنید، نه تحمل شنیدنش را دارم و نه قدرت پاسخ دادن به آن را."],[69,"ملک شرمگین در حشم بنگریست","که سودای این بر من از بهر چیست؟","شاه شرمنده به خدمه‌اش نگریست و از خود پرسید که چرا این فکر (دختر آوردن) برای من پیش آمده است؟"],[69,"یکی گفت شاها به تیغش بزن","که نگذاشت کس را نه دختر نه زن","یکی از مردم به شاه گفت که با تیغش (شمشیرش) بر کسی ضربه بزن، چرا که او (حشم) هیچ‌کس را - نه دختر و نه زن - بی‌نوا نگذاشته است."],[69,"نگه کرد سلطان عالی محل","خودش در بلا دید و خر در وحل","سلطان به وضع ناگوار و دردناکی که در آن گرفتار شده است، نگاه می‌کند و آن را می‌بیند؛ همچنان که در وضعیت دشواری همچون سرگشتگی و بی‌پناهی یک خر در میان گرفتاری."],[69,"ببخشود بر حال مسکین مرد","فرو خورد خشم سخن‌های سرد","سلطان به حال مرد مسکین رحم کرد و خشم خود را فرو خورد و سخنان تلخ و بی‌رحمانه‌ای بر زبان نیاورد."],[69,"زرش داد و اسب و قبا پوستین","چه نیکو بود مهر در وقت کین","در زمان کینه و دشمنی، بخشش و عطای مال، مانند دادن طلا و اسب و لباس است و نشان‌دهنده خوبی و نیکی است."],[69,"یکی گفتش ای پیر بی‌عقل و هوش","عجب رستی از قتل، گفتا خموش","کسی به پیر (سعدی) می‌گوید ای بی‌عقل و بی‌هوش، چطور از قتل رهایی یافتی؟ و او در پاسخ می‌گوید که سکوت کن."],[69,"اگر من بنالیدم از درد خویش","وی انعام فرمود در خورد خویش","اگر من از درد و رنج خود شکایت کنم، او (خداوند) به من نعمت و احسانی خواهد بخشید که برای خود او نیز لازم است."],[69,"بدی را بدی سهل باشد جزا","اگر مردی أحسن إلی من أساء","بدی را با بدی پاسخ دادن کار آسانی است، اما اگر مردی باشی، باید به کسی که به تو بدی کرده، احسان کنی."],[70,"شنیدم که مغروری از کبر مست","در خانه بر روی سائل ببست","شنیده‌ام که آدم مغروری در خانه را بر روی نیازمندی بست"],[70,"به کنجی فرو ماند و بنشست مرد","جگر گرم و آه از تف سینه سرد","آن نیازمند در گوشه‌ای نشست و آه سرد از سینه بر می‌آورد."],[70,"شنیدش یکی مرد پوشیده چشم","بپرسیدش از موجب کین و خشم","مردی نابینا‌، صدای آه و فغان او را شنید و از سبب خشمش پرسید."],[70,"فرو گفت و بگریست بر خاک کوی","جفایی کز آن شخصش آمد به روی","(ماجرا را برای مرد نابینا) تعریف کرد و افتاده‌بر خاک و گریان از جور و ستمی که از آن مرد متکبر به او رسید گفت."],[70,"بگفت ای فلان‌، ترک آزار کن","یک امشب به نزد من افطار کن","(مرد نابینا) به او گفت این ماجرا را فراموش کن و یک امشب ‌(در خانه‌ من) شام و افطار کن."],[70,"به خلق و فریبش گریبان کشید","به خانه در آوردش و خوان کشید","به مهربانی و ترفند او را به خانه برد و سفره نهاد."],[70,"بر آسود درویش روشن نهاد","بگفت ایزدت روشنایی دهاد","آن مرد نیازمند از غم و رنج آسود و دعا کرد که «ایزد و پروردگار، تو را روشنایی ببخشد!»"],[70,"شب از نرگسش قطره چندی چکید","سحر دیده بر کرد و دنیا بدید","آن شب چند قطره اشک از چشمان مرد نابینا چکید‌؛ سحرگاه چشم گشود و توانست ببیند."],[70,"حکایت به شهر اندر افتاد و جوش","که آن بی‌بصر دیده بر کرد دوش","این حکایت در شهر پیچید و جوش و خروش (در مردم افتاد) که مرد نابینا‌، بینا گشت."],[70,"شنید این سخن خواجه سنگدل","که برگشت درویش از او تنگدل","آن مرد متکبر سنگ‌دل هم ماجرا را شنید‌؛ همان کسی که درویش از بر او رنجیده‌دل رفت."],[70,"بگفتا حکایت کن ای نیکبخت","که چون سهل شد بر تو این کار سخت؟","و از مرد (دیده یافته) پرسید ای نیک‌بخت! این مشکل بزرگ تو چطور حل شد؟ (چگونه بینا شدی؟)"],[70,"که بر کردت این شمع گیتی‌فروز‌؟","بگفت ای ستمکار آشفته روز","چه کسی این چراغ درخشان را برای تو روشن کرد؟ پاسخ داد‌: ای ستم‌کار سیه‌روز!"],[70,"تو کوته‌نظر بودی و سست رای","که مشغول گشتی به جغد از همای","تو کوته‌نظر و تنگ‌نظر بودی و بد‌اندیش، که جغدی را بر هما پسندیدی (یعنی سعادت داشتن هما و کار نیک را به جغد شوم و کار ناپسند ترجیح دادی)"],[70,"به روی من این در کسی کرد باز","که کردی تو بر روی وی در، فراز","این در (بخت و اقبال) را کسی به‌روی من گشود که تو در بر روی او فراز کردی. ( فراز کردن‌: بستن)"],[70,"اگر بوسه بر خاک مردان زنی","به مردی که پیش آیدت روشنی","اگر جوان‌مردان را محترم بداری و راهرو آنها باشی، به کار نیک و مردی که پیش می‌آید روشن هستی (و شک نمی‌کنی)"],[70,"کسانی که پوشیده چشم دلند","همانا کز این توتیا غافلند","کسانی‌که چشم دلشان کور است از این توتیا (کمک به نیازمند) غافل هستند."],[70,"چو برگشته‌دولت ملامت شنید","سر انگشت حیرت به دندان گزید","وقتی آن مرد بخت‌برگشته این سرزنش را شنید‌، انگشت پشیمانی به دندان گزید."],[70,"که شهباز من صید دام تو شد","مرا بود دولت به نام تو شد","که شهباز اقبال و بخت من‌، صید تو گشت، قسمت من بود اما نصیب تو شد."],[70,"کسی چون به دست آورد جره باز","فرو برده چون موش دندان آز","کسی که شهباز را به‌دست آورده بود (با نادانی از دست داد و اکنون) همچون موش دندان حرص می‌فشرد."],[70,"الا گر طلبکار اهل دلی","ز خدمت مکن یک زمان غافلی","ای کسی که طلب‌کار و جوینده اهل دل هستی‌، از خدمت و کمک یک لحظه غفلت مکن."],[70,"خورش ده به گنجشک و کبک و حمام","که یک روزت افتد همایی به دام","به ضعفا کمک کن‌، تا روزی همای سعادت نصیب تو گردد."],[70,"چو هر گوشه تیر نیاز افکنی","امید است ناگه که صیدی زنی","وقتی تیر نیاز ‌(و کمک کردن به دیگران را) به هرجا روانه می‌کنی روزی تیرت به هدف خواهد خورد."],[70,"دری هم بر آید ز چندین صدف","ز صد چوبه آید یکی بر هدف","یک مروارید هم از چندین صدف به‌دست می‌آید و از صد تیر یکی بر هدف."],[71,"یکی را پسر گم شد از راحله","شبانگه بگردید در قافله","شخصی پسرش را در حین سفر گم کرد در تاریکی شب در میان کاروانیان ‌می‌گشت. (راحله‌: تأنیث راحل، و راحل به‌معنی کوچنده است، در اینجا مرکب منظور است.)"],[71,"ز هر خیمه پرسید و هر سو شتافت","به تاریکی آن روشنایی بیافت","از هر خیمه سراغ پسرش را گرفت و هر سوی رفت تا بالاخره پسرش را یافت."],[71,"چو آمد بر مردم کاروان","شنیدم که می‌گفت با ساروان","چون به کاروان خود برگشت‌، شنیدم که به ساربان ‌می‌گفت‌:"],[71,"ندانی که چون راه بردم به دوست!","هر آن کس که پیش آمدم گفتم اوست","نمی‌دانی که چطور دوست و یار (گم‌شده) را پیدا کردم‌؛ هر‌کس که می‌دیدم می‌پنداشتم که گم‌شده من است."],[71,"از آن اهل دل در پی هر کسند","که باشد که روزی به مردی رسند","به‌همین علت است که اهل دل در پی (شاد کردن دل) هر کسی هستند شاید که روزی به صاحب‌دلی برسند."],[71,"برند از برای دلی بارها","خورند از برای گلی خارها","بارها و مشقت‌ها را متحمل می‌شوند برای (یافتن) دلی؛ خارها می‌خورند‌، برای رسیدن به گلی."],[72,"ز تاج ملک‌زاده‌ای در مناخ","شبی لعلی افتاد در سنگلاخ","مناخ‌: جای خواب شتر‌ها."],[72,"پدر گفتش اندر شب تیره‌رنگ","چه دانی که گوهر کدام است و سنگ؟","پدر به فرزندش می‌گوید در این شب تاریک چه می‌دانی که کدام چیز ارزشمند (گوهر) است و کدام چیز بی‌ارزش (سنگ)؟"],[72,"همه سنگ‌ها پاس دار ای پسر","که لعل از میانش نباشد به در","ای پسر مراقب همه ی سنگ ها باش و هیچکدام را کم اهمیت نشمار. زیرا گوهری را که به دنبالش هستی، در میان همین سنگ ها جای دارد."],[72,"در اوباش، پاکان شوریده رنگ","همان جای تاریک و لعلند و سنگ","در میان افرادی که از ادبیات و فطرت پاک دور هستند، افرادی با دل‌های پاک و عاقل نیز وجود دارند که در ظاهری ناپسند و رنگارنگ قرار گرفته‌اند. این ابهام باعث می‌شود که آنها در مکان‌های تاریک و بی‌توجهی همچون لعل و سنگ به چشم بیایند."],[72,"چو پاکیزه‌نفسان و صاحبدلان","بر آمیخته‌ستند با جاهلان","پاکان و صاحبدلان در کنار جاهلان آمیخته‌اند و این نشان می‌دهد که هر دو گروه در یکجا قرار دارند."],[72,"به رغبت بکش بار هر جاهلی","که افتی به‌سر وقت صاحبدلی","به خاطر خوش‌رو بودن و پذیرش دوست‌داشتنی دیگران، باید بار مسئولیت جاهلان را هم به دوش بکشی، زیرا ممکن است در زمان مناسب با افراد نیکوخصال مواجه شوی."],[72,"کسی را که با دوستی سرخوش است","نبینی که چون بار دشمن کش است؟","بار دشمن کش‌: کسی که جور و سختی از نااهلان می‌کشد."],[72,"بدرّد چو گل جامه از دست خار","که خون در دل افتاده خندد چو نار","چنان که گل وقتی از خار آسیب می‌بیند، به سختی و درد دچار می‌شود، در حالی که نار (میوه‌ی انار) با وجود این که خون در دلش است، باز هم می‌خندد. این اشاره به این دارد که برخی افراد با وجود رنج و درد درونیشان، ظاهری شاد و خندان دارند."],[72,"غم جمله خور در هوای یکی","مراعات صد کن برای یکی","غم همه را در نظر بگیر و به خاطر یک نفر خودت را به زحمت بینداز و دیگران را فراموش نکن."],[72,"گرت خاک‌پایان‌ شوریده‌سر","حقیر و فقیر آید اندر نظر","خاک‌پا‌: آدم پا برهنه و بی‌کفش‌، کنایه است از آدم بی‌اهمیت."],[72,"به مردی کز ایشان به در نیست آن","به خدمت کمر بندشان بر میان","کسی که از آن گروه متواضع و فقیر فاصله دارد، بهتر است که کمر خدمت به آن‌ها را به خود ببندد و در خدمت آنان باشد."],[72,"تو هرگز مبینشان به چشم پسند","که ایشان پسندیده حق بسند","هرگز آن‌ها را با چشم دلخواه خود نبین که فقط خداوند است که آن‌ها را پسندیده است."],[72,"کسی را که نزدیک ظنت بد اوست","چه دانی که صاحب‌ولایت خود اوست؟","اگر تو به کسی که نزد تو بدنام است بدبینی، چگونه می‌توانی بدانی که او خود، دارای مقام و ارزش بالایی است؟"],[72,"در معرفت بر کسانی است باز","که درهاست بر روی ایشان فراز","در شناخت و آگاهی، باز کسی است که به درک و فهم عمیق دست یافته و درهایی به روی او گشوده شده است."],[72,"بسا تلخ عیشان تلخی چشان","که آیند در حله دامن‌کشان","بسیاری از افرادی که در زندگی خوشی‌های تلخی را تجربه می‌کنند، وقتی که به مهمانی یا جمعی می‌آیند، لباس‌های زیبا و تجملاتی به تن می‌کنند."],[72,"ببوسی گرت عقل و تدبیر هست","ملک‌زاده را در نواخانه دست","نوا‌خانه‌: محبس‌، زندان‌."],[72,"که روزی برون آید از شهربند","بلندیت بخشد چو گردد بلند","وقتی که کسی از محبوس بودن در شهر آزاد شود و به بیرون برود، خداوند به او عزت و بزرگی خواهد داد و مقامش را بالا می‌برد."],[72,"مسوزان درخت گل اندر خریف","که در نوبهارت نماید ظریف","ظریف‌: زیبا و پسندیده."],[73,"یکی زهره خرج کردن نداشت","زرش بود و یارای خوردن نداشت","شخصی بود که شجاعت‌ هزینه کردن نداشت، با‌آنکه پول داشت، توان و جرات خوردن و خرج کردن نداشت."],[73,"نه خوردی، که خاطر بر آسایدش","نه دادی، که فردا بکار آیدش","نه می‌خورد و خرج می‌کرد که آسایش بیابد، و نه داد و دهشی می‌کرد که فردای (روز قیامت) بهره‌ای ببرد."],[73,"شب و روز در بند زر بود و سیم","زر و سیم در بند مرد لئیم","پیوسته و شب و روز در فکر (شمارش و افزودن‌) پول و زرش بود و پول‌ و زر اسیر او (یعنی پولی که به‌دستش می‌رسید اسیر می‌شد و دیگر از دستش به‌در نمی‌شد)"],[73,"بدانست روزی پسر در کمین","که ممسک کجا کرد زر در زمین","روزی پسرش، دزدکی دریافت که آن خسیس، کجا زر و سیم‌هایش را پنهان می‌کند."],[73,"ز خاکش بر آورد و بر باد داد","شنیدم که سنگی در آن جا نهاد","از آن خاک که پنهانش کرده بود بیرونش آورد و زر را بر باد داد و بجای زر، سنگی در آنجا گذاشت."],[73,"جوانمرد را زر بقایی نکرد","به یک دستش آمد، به دیگر بخورد","زر و پول در دست آن جوانمرد و عیار نپایید، از یک دستش که گرفت به دست دیگر (‌فورا) خرج کرد."],[73,"کز این کم‌زنی بود ناپاک‌رو","کلاهش به بازار و میزر گرو","(همچنین آن پسر) قمارباز بازنده‌ای بود که کلاه و دستارش در بازار گرو بود (یعنی مقروض بود) کم‌زن‌: قمارباز بازنده. میزر: دستار."],[73,"نهاده پدر چنگ در نای خویش","پسر چنگی و نایی آورده پیش","(از یک سو) پدر چنگ ‌(غصه) بر گلوی خود می‌فشرد و از سوی دیگر پسر، مطرب و چنگی آورده بود (و خوش‌گذرانی می‌کرد) چنگی‌: نوازنده چنگ. نایی‌: نوازنده نی."],[73,"پدر زار و گریان همه شب نخفت","پسر بامدادان بخندید و گفت","پدر، بدحال و گریان تمام شب را نخوابید و پسر صبح‌گاه به او گفت:"],[73,"زر از بهر خوردن بود ای پدر","ز بهر نهادن چه سنگ و چه زر","زر و پول برای خرج کردن است ای پدر! اگر بماند با سنگ چه فرقی دارد؟"],[73,"زر از سنگ خارا برون آورند","که با دوستان و عزیزان خورند","زر را از (معدن و) سنگ سخت بیرون می‌آورند که با دوستان و عزیزان خرج کنند."],[73,"زر اندر کف مرد دنیاپرست","هنوز ای برادر به سنگ اندرست","زر و پول در دست آدم مال‌پرست و زراندوز، انگار که به‌دست نیامده و هنوز در زیر زمین و در سنگ است."],[73,"چو در زندگانی بدی با عیال","گرت مرگ خواهند، از ایشان منال","وقتی که با خانواده‌ات بد و نامهربان هستی، اگر مرگ تو را آرزو کنند، گله مکن و شکایت نداشته باش."],[73,"چو چشمآرو آنگه خورند از تو سیر","که از بام پنجه گز افتی به زیر","وقتی که بد‌اخلاق و خشم‌ناک هستی زمانی از تو راضی می‌شوند که دچار مرگ شوی."],[73,"بخیل توانگر به دینار و سیم","طلسمی است بالای گنجی مقیم","آدم خسیسی که ثروتمند است همچون طلسمی است که بالای گنج گذاشته‌اند."],[73,"از آن سالها می‌بماند زرش","که لرزد طلسمی چنین بر سرش","اینکه چندین سال این زر همچنان باقی است ، به این دلیل است که چنین طلسمی همواره بر سر آن بوده است ( کنایه از این که این پدر اگر این سرمایه را خرج میکرد و یا بخشش می نمود ، این سرمایه تا الان باقی نمی ماند )"],[73,"به سنگ اجل ناگهش بشکنند","به اسودگی گنج قسمت کنند","ناگهان مرگ و اجل، آن طلسم را در هم می‌شکند و به آسانی ثروتش را تقسیم می‌کنند."],[73,"پس از بردن و گرد کردن چو مور","بخور پیش از آن که‌ت خورد کرم گور","پس از بار بردن و جمع کردن، با مشقت زیاد همچون مورچه؛ خرج کن و بخور پیش از آنکه بمیری."],[73,"سخنهای سعدی مثال است و پند","به کار آیدت گر شوی کار بند","سخنان سعدی‌، همه مثال و ضرب‌المثل و پند است و برای تو سودمند، اگر به‌کار ببری."],[73,"دریغ است از این روی برتافتن","کز این روی دولت توان یافتن","حیف است از این (پند‌ها) روی بگردانی؛ که از این می‌توانی دولت و بخت بیابی."],[74,"جوانی به دانگی کرم کرده بود","تمنای پیری بر آورده بود","جوانی دست بخشش را باز‌کرده و به پولی، نیاز پیری را برآورده بود."],[74,"به جرمی گرفت آسمان ناگهش","فرستاد سلطان به کشتنگهش","دست تقدیر به جرمی او را گرفتار کرد و حاکم به قتل و کشتنش فرمان داد."],[74,"تکاپوی ترکان و غوغای عام","تماشاکنان بر در و کوی و بام","آمد و شد ترکان و شحنگان و فریاد و هیاهوی مردم در همه جا پیچیده بود."],[74,"چو دید اندر آشوب، درویش پیر","جوان را به دست خلایق اسیر","هنگامیکه آن پیر (که جوان را می‌شناخت) در آن آشوب، جوان را اسیر و گرفتار دست خلایق دید."],[74,"دلش بر جوانمرد مسکین بخست","که باری دل آورده بودش به دست","دلش بر (حال) آن جوان‌، غمگین و ریش شد زیرا روزی دل او را شاد کرده بود."],[74,"برآورد زاری که سلطان بمرد","جهان ماند و خوی پسندیده برد","گریه سر داد و آواز برآورد که «حاکم مرد و نیکی‌هایش را با خود برد»"],[74,"به هم بر همی‌سود دست دریغ","شنیدند ترکان آهخته تیغ","دست گریه و افسوس برهم می‌زد و شحنگان این را دیدند."],[74,"به فریاد از ایشان بر آمد خروش","تپانچه زنان بر سر و روی و دوش","(آنها نیز) به فریاد و فغان افتادند و بر سر و روی کوبان؛"],[74,"پیاده به سر تا در بارگاه","دویدند و بر تخت دیدند شاه","پیاده و با شتاب تا بارگاه حاکم دویدند و حاکم را بر تخت (و زنده‌) یافتند."],[74,"جوان از میان رفت و بردند پیر","به گردن بر تخت سلطان اسیر","جوان (در این گیر و دار) گریخت؛ آن پیر را گردن‌بسته به حضور حاکم بردند."],[74,"به هولش بپرسید و هیبت نمود","که مرگ منت خواستن بر چه بود؟","(حاکم‌) او را ترساند و بر او هیبت و قهر نمود که «از مرگ من (و آرزوی مرگ من) چه می‌خواستی‌؟»"],[74,"چو نیک است خوی من و راستی","بد مردم آخر چرا خواستی؟","چون‌که خوی و رفتار من نیک و درست است؛ تو چرا برای من بد می‌خواهی؟"],[74,"برآورد پیر دلاور زبان","که ای حلقه‌در‌گوش حکمت جهان","آن پیر شجاع گفت‌: ای کسی که جهان حلقه‌در‌گوش و فرمان‌بر حکم توست."],[74,"به قول دروغی که سلطان بمرد","نمردی و بیچاره‌ای جان ببرد","به یک حرف دروغ که «سلطان مرد» تو نمردی اما بیچاره‌ای از مردن نجات‌یافت."],[74,"ملک زین حکایت چنان بر شکفت","که چیزش ببخشید و چیزی نگفت","سلطان چنان از این سخن و درس، شاد شد که چیزی به او بخشید و او را تنبیه نکرد."],[74,"وز این جانب افتان و خیزان جوان","همی رفت بیچاره هر سو دوان","در سوی دیگر، آن جوان، افتان و خیزان به هر سو می‌دوید."],[74,"یکی گفتش از چار سوی قصاص","چه کردی که آمد به جانت خلاص؟","شخصی از او پرسید: چه کردی که از کشته‌شدن نجات یافتی؟"],[74,"به گوشش فرو گفت کای هوشمند","به جانی و دانگی رهیدم ز بند","به او گفت: ای هوشمند دانا، به شاد‌کردن دلی و پولی ناچیز، از بند رستم."],[74,"یکی تخم در خاک از آن می‌نهد","که روز فرو ماندگی بر دهد","آدمی تخم نیکی را از آن می‌کارد که روز نیاز و درماندگی از آن بهره ببرد."],[74,"جوی باز دارد بلایی درشت","عصایی شنیدی که عوجی بکشت","جوی و ذره‌ای نیکی، بلایی بزرگ را از سر بگرداند‌، شنیده‌ای که ضربه عصایی عوجی را کشت. (اشاره است به داستان عوج ابن عوق و ضربه عصای موسی)"],[74,"حدیث درست آخر از مصطفاست","که بخشایش و خیر دفع بلاست","روش و سخن درست را باید از مصطفا و رسول شنید که «بخشایش و خیر، دفع بلاست»"],[74,"عدو را نبینی در این بقعه پای","که بوبکر سعد است کشور خدای","دشمن (و شرّ) در این سرزمین که «بوبکر سعد» فرمان‌روا و شاه آن است جایی ندارد."],[74,"بگیر ای جهانی به روی تو شاد","جهانی، که شادی به روی تو باد","ای کسی که جهان از دیدن تو شاد است، جهانی بگیر که شادی و لبخند بر چهره‌ات بادا!"],[74,"کس از کس به دور تو باری نبرد","گلی در چمن جور خاری نبرد","در زمانه و عهدی که تو فرمان‌روایی کسی چیزی از کسی (به‌ستم‌) نبرد و گلی از خاری آزرده نشد."],[74,"تویی سایه لطف حق بر زمین","پیمبر صفت رحمة ‌للعالمین","سایه لطف حق بر زمینی و همچون پیمبر بر همگان مهربان و «رحمة للعالمین‌» هستی."],[74,"تو را قدر اگر کس نداند چه غم؟","شب قدر را می‌ندانند هم","اگر قدر تو را ندانند چه غم و چه‌باک؟ شب قدر را نیز قدر نمی‌دانند."],[75,"کسی دید صحرای محشر به خواب","مس تفته روی زمین ز آفتاب","شخصی روز قیامت را به‌خواب دید که از حرارت و تاب‌، مس بر زمین می‌گداخت."],[75,"همی بر فلک شد ز مردم خروش","دماغ از تبش می‌برآمد به جوش","فریاد و فغان مردم به آسمان رفته بود و مغزها از حرارت به‌جوش آمده بود."],[75,"یکی شخص از این جمله در سایه‌ای","به گردن بر از خلد پیرایه‌ای","یکی در آنجا در سایه‌ای نشسته بود و بر تن‌، پیرایه و آرایه‌های بهشتی داشت."],[75,"بپرسید کای مجلس آرای مرد","که بود اندر این مجلست پایمرد؟","از او پرسید که ای فخر مجلس‌، در این جایگاه چه کسی پایمرد (و ضامن) توست؟"],[75,"رزی داشتم بر در خانه، گفت","به سایه درش نیکمردی بخفت","پاسخ داد‌: درخت انگوری بر در خانه‌ام داشتم که روزی نیک‌مردی در سایه آن آرمید."],[75,"در این وقت نومیدی آن مرد راست","گناهم ز دادار داور بخواست","در این روز ناامیدی و نیاز، آن مرد راست‌کردار‌، آمرزش گناهانم را از خدای خواست."],[75,"که یارب بر این بنده بخشایشی","کز او دیده‌ام وقتی آسایشی","که‌ خدایا، بر این بنده نیکو‌کارت بخشایشی فرما، زیرا روزی از او نیکی و آسایش دیده‌ام.‌"],[75,"چه گفتم چو حل کردم این راز را؟","بشارت خداوند شیراز را","وقتی که این راز را فهمیدم، چه چیزی را بیان کردم؟ حاکم شیراز را خبری خوش دادم"],[75,"که جمهور در سایه همتش","مقیمند و بر سفره نعمتش","بسیاری از مردم در سایه‌ی تلاش و همت او (خداوند) زندگی می‌کنند و زیر سفره‌ی نعمت‌ها و برکات او روزگار می‌گذرانند."],[75,"درختی است مرد کرم، باردار","وز او بگذری هیزم کوهسار","درختی که اشاره شده، به شخصی نیکوکار تشبیه شده که اعمالش موجب ثمرات و برکات زیادی می‌شود. این شخص در نهایت، مایه‌ی خیر و منفعت برای دیگران است، همان‌طور که درخت میوه‌دار منابعی برای انسان‌ها فراهم می‌کند."],[75,"حطب را اگر تیشه بر پی زنند","درخت برومند را کی زنند؟","اگر چوب و هیزم را با تیشه قطع کنند، درختی تنومند و بلند را چگونه می‌توان خواهند زد؟"],[75,"بسی پای دار، ای درخت هنر","که هم میوه‌داری و هم سایه‌ور","ای درختی که هنر و مهارت زیادی داری، بسیار پایدار باش؛ چرا که تو نه تنها میوه تولید می‌کنی بلکه سایه‌ای هم بر سر دیگران فراهم می‌آوری."],[75,"بگفتیم در باب احسان بسی","ولیکن نه شرط است با هر کسی","ما درباره نیکی و احسان سخن‌های زیادی گفتیم، اما این نکته مهم است که نیکی را فقط با هر کسی نمی‌توان انجام داد؛ باید شرط و اصول خاصی رعایت شود."],[75,"بخور مردم آزار را خون و مال","که از مرغ بد کنده به پر و بال","از دست دادن مال و جان او که مردم را آزار می‌دهد، مانند آن است که مرغی بی‌پر و بال شده باشد؛ یعنی اگر کسی به دیگران آسیب برساند، بر اساس عدالت باید هزینه آن را بپردازد."],[75,"یکی را که با خواجه توست جنگ","به دستش چرا می‌دهی چوب و سنگ؟","اگر با خواجه (سرور یا بزرگ) تو کسی درگیر است، به چه دلیل به او چوب و سنگ می‌دهی تا بجنگد؟ این نشان می‌دهد که نباید به او کمک کنی تا بین آن‌ها درگیری ایجاد شود."],[75,"بر انداز بیخی که خار آورد","درختی بپرور که بار آورد","هرگاه درختی را پرورش می‌دهی، باید بیخ (ریشه) آن را به درستی نگه‌داری و از خاری که ممکن است آن را آسیب بزند، دور نگه‌داری تا درخت بتواند باردهی خوبی داشته باشد."],[75,"کسی را بده پایه مهتران","که بر کهتران سر ندارد گران","کسی را باید به مقام والایی برسانی که بر کسانی که در مرتبه پایین‌تری هستند، بار سنگینی نداشته باشد و ایشان را نرنجاند."],[75,"مبخشای بر هر کجا ظالمی است","که رحمت بر او جور بر عالمی است","در هر کجا که ظالمی وجود دارد، رحمت بر او موجب ستم بر جهانیان خواهد بود."],[75,"جهان‌سوز را کشته بهتر چراغ","یکی به در آتش که خلقی به داغ","کشتن کسی که باعث آتش‌سوزی در دنیا است، بهتر از روشن کردن چراغی است که دیگران را به درد و بلا می‌اندازد. در واقع، از سرخوشی و منفعت شخصی باید گذشت تا به درد و رنج دیگران پایان داد."],[75,"هر آن کس که بر دزد رحمت کند","به بازوی خود کاروان می‌زند","هر کسی که به دزد و فاسد رحمت و بخشش کند، در حقیقت خود را به زحمت می‌اندازد و به نفع آنها کمک می‌کند."],[75,"جفاپیشگان را بده سر بباد","ستم بر ستم پیشه عدل است و داد","این بیت می‌گوید کسانی که به دیگران ستم می‌کنند و بدی را پیشه کرده‌اند، سزاوارند که سرشان به باد برود. در واقع، کانچه ستمگر است، باید مجازات شود و تنها مصداق عدالت بر اساس ستم در نظر گرفته می‌شود."],[76,"شنیدم که مردی غم خانه خورد","که زنبور بر سقف او لانه کرد","مردی را شنیدم که به خاطر این‌که زنبوری در بالای خانه‌اش لانه کرده، غمگین شده است."],[76,"زنش گفت از اینان چه خواهی؟ مکن","که مسکین پریشان شوند از وطن","زن او به او گفت: از این زنبورها چه چیزی می‌خواهی؟ از این کار دست بردار، زیرا که این موجودات بیچاره برای زندگی خود ناراحت و آواره می‌شوند."],[76,"بشد مرد نادان پس کار خویش","گرفتند یک روز زن را به نیش","مرد نادان به خاطر نادانی‌اش یک روز همسرش را مورد آزار قرار داد و او را به شدت زخم کرد."],[76,"زن بی خرد بر در و بام و کوی","همی کرد فریاد و می‌گفت شوی:","زن نادان در کوچه و خیابان فریاد و زاری می‌کرد و می‌گفت شوهرم:"],[76,"مکن روی بر مردم ای زن ترش","تو گفتی که زنبور مسکین مکش","ای زن بدخلق، بر روی مردم خشمگین مشو؛ تو گفتی که زنبور بیچاره را نکش."],[76,"کسی با بدان نیکویی چون کند؟","بدان را تحمل، بد افزون کند","کسی که به افراد بد رفتاری نیکی کند، فقط باعث می‌شود که آن افراد بدتر شوند و بیشتر به بدی ادامه دهند."],[76,"چو اندر سری بینی آزار خلق","به شمشیر تیزش بیازار حلق","اگر در وجود خود، ظلم و آزار مردم را با شمشیر تیز ببینی، به همان اندازه باید خود را آزار دهی و دچار درد و رنج کنی."],[76,"سگ آخر که باشد که خوانش نهند؟","بفرمای تا استخوانش دهند","اگر یک نفر با او رفتار ناپسند و بی‌احترامی کند، در آخرت چیزی جز تضرر و زیان نخواهد داشت. بنابراین، بهتر است تا زمانی که در قدرت و موقعیت هستید، به دیگران احترام بگذارید و از آزار آنها بپرهیزید."],[76,"چه نیکو زده‌ست این مثل پیر ده","ستور لگدزن گران بار به","پیر ده منظورش این است که مثل‌زدن نیکو و حکمت‌آمیز در مورد کسی که به او آسیب می‌زند، به خاطر سنگینی و خطر او، قابل توجه است. این جمله به نوعی به نگرانی از آسیب‌پذیری در برابر قدرت و زورمندی اشاره دارد."],[76,"اگر نیکمردی نماید عسس","نیارد به شب خفتن از دزد، کس","اگر مرد نیکوکاری در شب برای حفظ امنیت پیش از خواب، خوابش نمی‌برد و به مراقبت از دزدان می‌پردازد، کسی به او تعرض نمی‌کند."],[76,"نی نیزه در حلقه کارزار","بقیمت تر از نیشکر صد هزار","نیزه در میدان جنگ ارزشی بیشتر از صد هزار نیشکر دارد."],[76,"نه هر کس سزاوار باشد به مال","یکی مال خواهد، یکی گوشمال","هر کسی که لایق مال باشد، حتما مال نمی‌گیرد؛ برخی تنها تنبیه یا گوشمالی را دریافت می‌کنند."],[76,"چو گربه نوازی کبوتر برد","چو فربه کنی گرگ، یوسف درد","اگر به گربه محبت کنی، ممکن است کبوتری را برباید و اگر گرگی را چاق کنی، یوسف (که می‌تواند نماد انسان‌های بی‌گناه باشد) درد و آسیب خواهد دید."],[76,"بنایی که محکم ندارد اساس","بلندش مکن ور کنی زو هراس","اگر بنایی محکم و استواری نداشته باشد، نباید آن را بلند بسازی، زیرا ممکن است باعث ترس و آسیب شود."],[76,"چه خوش گفت بهرام صحرانشین","چو یکران توسن زدش بر زمین","بهرام صحرانشین (که به احتمال زیاد به شخصیت اسطوره‌ای اشاره دارد) گفت سخنی خوب وقتی که اسبش ناگهان او را به زمین انداخت."],[76,"دگر اسبی از گله باید گرفت","که گر سر کشد باز شاید گرفت","بهتر است از دام‌های بیشتری بهره‌برداری کنیم تا اگر یکی از آن‌ها سرکش شد، بتوانیم دوباره آن را مهار کنیم."],[76,"ببند ای پسر دجله در آب کاست","که سودی ندارد چو سیلاب خاست","ای پسر، وقتی که آب دجله (رودی در عراق) کم شده است، کوشش نکن آن را ببندی، زیرا وقت سیلاب (به معنای طغیانی که به زودی می‌آید) هیچ فایده‌ای در این کار نیست."],[76,"چو گرگ خبیث آمدت در کمند","بکش ور نه دل بر کن از گوسفند","اگر گرگ بدجنسی به دام تو افتاد، باید او را بکشیدی، ورنه دل و جان خود را از دست خواهی داد."],[76,"از ابلیس هرگز نیاید سجود","نه از بد گهر نیکویی در وجود","از ابلیس، یعنی شیطان، هیچ‌گاه سجده و عبادت صحیحی صادر نمی‌شود و از افرادی که نژاد و خصلت بدی دارند، نیکی و خوبی در وجودشان پدید نمی‌آید."],[76,"بد اندیش را جاه و فرصت مده","عدو در چه و دیو در شیشه به","به افراد بداندیش مقام و فرصت نده، زیرا دشمنی مانند دیو در شیشه، یعنی خطر بزرگی در کمین است."],[76,"مگو شاید این مار کشتن به چوب","چو سر زیر سنگ تو دارد بکوب","اگر فکر کنی می‌توانی این مار را با چوب بکشید، باید توجه داشته باشی که ممکن است سر این مار زیر سنگی پنهان شده باشد و ممکن است به تو آسیب بزند."],[76,"قلم زن که بد کرد با زیردست","قلم بهتر او را به شمشیر دست","چنانچه فردی با قلم و نوشتن ظلمی به کسی کند، بهتر است او را با شمشیر و به شکل قهری مجازات کرد."],[76,"مدبر که قانون بد می‌نهد","تو را می‌برد تا به دوزخ دهد","کسی که قوانین نا درست و بد می‌گذارد، در نهایت تو را به جایی می‌برد که جزای آن در دوزخ است."],[76,"مگو ملک را این مدبر بس است","مدبر مخوانش که مدبر کس است","این شخص را مدبر نخوان، زیرا او به درد حکومت نمی‌خورد و حکمرانی نمی‌کند."],[76,"سعید آورد قول سعدی به جای","که ترتیب ملک است و تدبیر رای","سعید قول سعدی را آورده که در جایی که حکومت و مدیریت کشور مطرح است، ترتیب و تدبیر امور باید به درستی انجام شود."],[77,"خوشا وقت شوریدگان غمش","اگر زخم بینند و گر مرهمش","خوشا به حال شوریدگان یعنی عاشقان، اگر حتی زخم ببینند یا درد بکشند، چون عشق و شوق آن‌ها را رنجی که می‌کشند، تسلی می‌دهد و به آن‌ها مرهمی می‌سازد."],[77,"گدایانی از پادشاهی نفور","به امّیدش اندر گدایی صبور","گدایانی که از پادشاهی بیزارند، با امید به او به گدایی و کمک‌خواهی مشغولند و صبر می‌کنند."],[77,"دمادم شراب الم در کشند","وگر تلخ بینند دم در کشند","شراب عشق همواره حسرت و درد را به همراه دارد و اگر هم تلخ باشد، باز هم انسان به نوشیدن آن ادامه می‌دهد."],[77,"بلای خمار است در عیش مل","سلحدار خار است با شاه گل","عیش و نوشی که در آن نشئگی وجود دارد، عذابی به نام خمار را به همراه دارد و در عین حال، لذت آن مانند دمی است که در کنار شاه گل، آرامش‌دهنده و زیباست."],[77,"نه تلخ است صبری که بر یاد اوست","که تلخی شکر باشد از دست دوست","صبری که در یاد او سپری می‌شود، تلخ نیست؛ چراکه تلخی شکر ناشی از دوری و جدایی اوست و این تحمل برای دوست قابل قبول است."],[77,"ملامت کشانند مستان یار","سبک تر برد اشتر مست بار","مستمندان عشق، که به خاطر معشوق مورد سرزنش و ملامت قرار می‌گیرند، به اندازه‌ای سبک‌بار و رها هستند که بارشان را حتی بر دوش الاغ مست نیز می‌گذارند."],[77,"اسیرش نخواهد رهایی ز بند","شکارش نجوید خلاص از کمند","عاشق نتواند از عشقش رهایی یابد و برای رهایی از دام دلبر، تلاشی نمی‌کند."],[77,"سلاطین عزلت، گدایان حی","منازل شناسان گم کرده پی","سلطانانی که در تنهایی و عزلت زندگی می‌کنند، مانند گدایانی هستند که در خانه‌های دیگران به دنبال زندگی می‌گردند و راه خود را گم کرده‌اند."],[77,"به سر وقتشان خلق ره کی برند","که چون آب حیوان به ظلمت درند","مردم چه زمانی می‌توانند به موقع از حقشان دفاع کنند، وقتی که همچون آب حیات، در تاریکی و ظلمت غوطه‌وارند؟"],[77,"چو بیت‌المقدس درون پر قباب","رها کرده دیوار بیرون خراب","چنان که بیت‌المقدس (محل مقدس در دین یهود و مسیحیت و اسلام) درون خود پر از قباب (گنبدها و بناهای زیبا) است، دیوار بیرونی آن خراب و خراب شده است. این بیت به تضاد میان زیبایی درون (بیت‌المقدس) و نابسامانی یا خرابی بیرون اشاره دارد."],[77,"چو پروانه آتش به خود در زنند","نه چون کرم پیله به خود برتنند","پروانه‌ها به عشق آتش سوزان می‌رقصند و خود را در آتش می‌اندازند، اما کرم‌ها مثل پیله به خود نمی‌پیچند و از عشق ناامید می‌شوند."],[77,"دلارام در بر، دلارام جوی","لب از تشنگی خشک، بر طرف جوی","دل‌بر در آغوشم است، اما لبان آن محبوب به خاطر تشنگی خشک شده و در کنار جوی آب قرار دارد."],[77,"نگویم که بر آب قادر نیند","که بر شاطی نیل مستسقیند","من نمی‌گویم که موجودات در آب نمی‌توانند، بلکه می‌گویم که بر کرانه نیل (رودی در مصر) در حال سرخوشی و مستی هستند."],[78,"تو را عشق همچون خودی ز آب و گل","رباید همی صبر و آرام دل","عشق تو که همچون خودت از آب و گل است، می‌تواند به راحتی صبر و آرامش دل را از تو بگیرد."],[78,"به بیداریش فتنه بر خد و خال","به خواب اندرش پای بند خیال","در حال بیداری، زیبایی‌های چهره‌اش انسان را بلا به خود می‌کشد، و در خواب نیز به خاطر او آدمی گرفتار خیال و تصور او می‌شود."],[78,"به صدقش چنان سر نهی در قدم","که بینی جهان با وجودش عدم","اگر به صداقت او توجه کنی و به او احترام بگذاری، می‌بینی که با وجود او، تمام جهان همچون هیچ و عدم است."],[78,"چو در چشم شاهد نیاید زرت","زر و خاک یکسان نماید برت","وقتی در چشم معشوق به زیبایی و جذابیت او نگاه می‌کنی، طلا و خاک برایت یکسان به نظر می‌رسد؛ یعنی عشق او آن‌قدر ارزشمند است که دیگر چیزها اهمیت خود را از دست می‌دهند."],[78,"دگر با کست بر نیاید نفس","که با او نماند دگر، جای کس","دیگر نفسش با کسی سازگار نیست، چرا که با او همراهی نمی‌کند و هیچ‌کس دیگر جایی در دل او ندارد."],[78,"تو گویی به چشم اندرش منزل است","وگر دیده بر هم نهی، در دل است","تو گویی آن چشمی که به آن نگاه می‌کنی، برای او منزل و آرامش است و اگر پلک‌هایت را ببندی، او در دل تو جای دارد."],[78,"نه اندیشه از کس که رسوا شوی","نه قوت که یک دم شکیبا شوی","نه نگران این باش که دیگران تو را رسوا می‌کنند و نه توانایی این را داری که یک لحظه صبر کنی و دم بر نیاوری."],[78,"گرت جان بخواهد، به لب بر نهی","ورت تیغ بر سر نهد، سر نهی","اگر جان تو خواسته شود و او به لب تو اشاره کند، باید پذیرفتی حتی اگر تیغ بر سرت گذاشته شود، باید سر خود را تسلیم کنی."],[79,"چو عشقی که بنیاد آن بر هواست","چنین فتنه‌انگیز و فرمانرواست،","عشق‌هایی که اساس‌شان به خواسته‌های نفسانی و دنیوی مربوط می‌شود، طوری قوی و جذاب هستند که می‌توانند هر کسی را به خود مشغول کرده و تحت تاثیر قرار دهند."],[79,"عجب داری از سالکان طریق","که باشند در بحر معنی غریق؟","عجب نکن از سالکان راه حقیقت که در دریای معنویت غرق شده‌اند."],[79,"به سودای جانان به جان مشتغل","به ذکر حبیب از جهان مشتغل","عاشق به یاد محبوبش تمام وجودش را صرف محبت او کرده و در دل از یاد او غافل نیست. او به خاطر عشق به محبوبش از دنیا و سایر امور غافل شده است."],[79,"به یاد حق از خلق بگریخته","چنان مست ساقی که می ریخته","انسانی که به یاد خداوند از دیگران دور شده است، به اندازه فردی مست و سرمست می‌شود که شراب می‌نوشد."],[79,"نشاید به دارو دوا کردشان","که کس مطلع نیست بر دردشان","نمی‌توان به دارو و درمان آنها پرداخت زیرا هیچ‌کس از درد و مشکلاتشان باخبر نیست."],[79,"الست از ازل همچنانشان به گوش","به فریاد قالوا بلی در خروش","انسان‌ها از همان آغاز خلقت به یاد دارند که خداوند از آن‌ها پیمان گرفت و گفت آیا من پروردگار شما نیستم، و آن‌ها با هم‌صدایی پاسخ دادند بله. این یادآوری و فریاد در آن زمان هنوز در گوش آن‌ها طنین‌انداز است."],[79,"گروهی عمل دار عزلت نشین","قدمهای خاکی، دم آتشین","گروهی از مردم هستند که در کنج عزلت نشسته‌اند و با وجود اینکه در دنیای مادی زندگی می‌کنند، روح و جانشان به آتش عشق و شوق خداوندی مشغول است."],[79,"به یک نعره کوهی ز جا بر کنند","به یک ناله شهری به هم بر زنند","با یک صدای بلند، کوه‌ها را از جا می‌کنند و با یک ناله، شهرها را بر هم می‌زنند."],[79,"چو بادند پنهان و چالاک پوی","چو سنگند خاموش و تسبیح گوی","آن‌ها مانند باد هستند؛ پنهان و سریع حرکت می‌کنند و در عین حال، مانند سنگ خاموشند و مشغول ذکر و تسبیح خداوندند."],[79,"سحرها بگریند چندان که آب","فرو شوید از دیده‌شان کحل خواب","سحرگاهان چنان زیاد گریه می‌کنند که اشک‌هایشان مانند سرمه (کحل) چشم‌ها فرو می‌ریزد و خواب را از آن‌ها دور می‌کند."],[79,"فرس کشته از بس که شب رانده‌اند","سحرگه خروشان که وامانده‌اند","گروه اسب‌ها، به خاطر اینکه در شب بیدار نگه‌داشته شده‌اند و اجازه خواب نداشته‌اند، خسته و از پا افتاده‌اند و صبحگاه، با صداهایی بلند و عصبانی در حال ناله هستند."],[79,"شب و روز در بحر سودا و سوز","ندانند ز آشفتگی شب ز روز","در بحر عشق و شوق، کسانی که گرفتار این حالت شده‌اند، نمی‌توانند تفاوتی میان شب و روز قائل شوند و از شدت آشفتگی و بی‌قراری، حالتی پریشان دارند."],[79,"چنان فتنه بر حسن صورت‌نگار","که با حسن صورت ندارند کار","این فتنه‌ای که بر اثر زیبایی چهره‌ی صورت‌نگار بوجود آمده، به قدری زیاد است که دیگران با زیبایی ظاهری خود نمی‌توانند رقابت کنند."],[79,"ندادند صاحبدلان دل به پوست","وگر ابلهی داد، بی‌مغز اوست","صاحبدلان (افراد با ایمان و دل‌سوز) به ظاهر و لباس و پوست بدن عشق نمی‌ورزند، بلکه اگر کسی که درک و فهم لازم را نداشته باشد، به سادگی به دلبستگی‌های ظاهری مبتلا شود، به او بی‌مغز می‌گویند."],[79,"می صرف وحدت کسی نوش کرد","که دنیا و عقبی فراموش کرد","کسی که به مقام وحدت و یگانگی دست یافته و از دنیا و آخرت غافل شده، شراب عشق می‌نوشد."],[80,"شنیدم که وقتی گدازاده‌ای","نظر داشت با پادشازاده‌ای","شنیدم که گدا زاده‌ای به پادشاه زاده‌ای علاقه‌مند شده بود."],[80,"همی‌رفت و می‌پخت سودای خام","خیالش فرو برده دندان به کام","او در حال رفتن بود و در دلش عشق و آرزوهای خامی داشت که مانند دندان در کامش فرو رفته بود و او را می‌آزرد."],[80,"ز میدانش خالی نبودی چو میل","همه وقت پهلوی اسبش چو پیل","او همیشه در میدان به عشق معشوقش حاضر بود و هیچ‌گاه رهایی نمی‌یافت، چون می‌خواست همانند فیل، بزرگ و نیرومند در کنار اسبش بایستد."],[80,"دلش خون شد و راز در دل بماند","ولی پایش از گریه در گل بماند","او به شدت غمگین و دلتنگ است و احساساتش را در درونش نگه می‌دارد، با اینکه به خاطر غم و اندوهش به گریه افتاده، اما از آنجا که در وضعیت دشواری قرار دارد، نمی‌تواند به راحتی خود را ترمیم کند و از دردش رهایی یابد."],[80,"رقیبان خبر یافتندش ز درد","دگرباره گفتندش اینجا مگرد","رقیبان (رقبای عاشق) از درد و غم او آگاه شدند و به او گفتند که اینجا نمان، زیرا ممکن است درد و رنج تازه‌ای برایت ایجاد شود."],[80,"دمی رفت و یاد آمدش روی دوست","دگر خیمه زد بر سر کوی دوست","مدتی از نزدیکی دوست دور شد و حالا به یاد چهره او افتاده است و دوباره در سر راه او camp می‌زند."],[80,"غلامی شکستش سر و دست و پای","که ‌«باری نگفتیمت ایدر مپای‌»","غلامی که در عشق دچار شکست و آسیب شده است، به عشق‌اش می‌گوید که من به خاطر تو هیچ چیزی نمی‌گویم و در این راه فقط صبر می‌کنم."],[80,"دگر رفت و صبر و قرارش نبود","شکیبایی از روی یارش نبود","او که عاشق است، دیگر نتوانست بر رفتار یار و دوری‌اش صبر و تحمل کند و دیگر آرامش ندارد."],[80,"مگس‌وار‌ش از پیش شکر به جور","براندندی و بازگشتی به‌فور","عاشق مانند مگس که به سوی شکر می‌رود، از عشق معشوق خود به شدت دچار مشکل و رنج می‌شود ولی باز هم به سرعت به سوی او بازمی‌گردد."],[80,"کسی گفتش ای شوخ دیوانه‌رنگ","عجب صبر داری تو بر چوب و سنگ!","کسی به محبوب می‌گوید: ای جوان شاد و دیوانه! چه صبر عجیبی داری که بر سختی‌ها و دشواری‌ها مانند چوب و سنگ، تحمل می‌کنی!"],[80,"بگفت این جفا بر من از دست اوست","نه شرطی‌ست نالیدن از دست دوست","او می‌گوید که این بدرفتاری و آزار که از طرف او می‌بینم، ناشی از کار اوست و جای ناله و شکایت از دوست نیست."],[80,"من اینک دم دوستی می‌زنم","گر او دوست دارد وگر دشمنم","من اکنون از دوستی سخن می‌گویم، فرقی نمی‌کند که او مرا دوست داشته باشد یا دشمن."],[80,"ز من صبر بی او توقع مدار","که با او هم امکان ندارد قرار","انتظار نداشته باش که من بی‌او صبر کنم، زیرا حتی با او نیز نمی‌توانم آرامش داشته باشم."],[80,"نه نیروی صبرم‌، نه جای ستیز","نه امکان‌ بودن‌، نه پای گریز","نه قدرتی برای صبر کردن دارم، نه جایی برای جنگیدن، نه امکان ماندن دارم و نه راهی برای فرار."],[80,"مگو زین در بارگه سر بتاب","وگر سر چو میخم نهد در طناب","نکن سر خود را در برابر این درگاه با خشونت پایین بیاور، زیرا اگر سر تو مثل میخ به طناب آویزان شود، بیشتر در معرض آسیب قرار می‌گیری."],[80,"نه پروانه جان داده در پای دوست","به از زنده در کنج تاریک اوست؟","هیچ چیزی به اندازه پروانه‌ای که جانش را فدای عشق کند، در پیشگاه دوست ارزشمندتر نیست، حتی اگر او در گوشه‌ای تاریک و خفّت‌آور زندگی کند."],[80,"بگفت ار خوری زخم چوگان اوی؟","بگفتا به پایش در افتم چو گوی","سوال می‌کند اگر آسیب‌های ناشی از ضربه‌های او را تحمل کنی، آیا باز هم در مقابل او فروتنی می‌کنی؟ و او در پاسخ می‌گوید حاضر است به خاطر عشق و وفاداری به پای او بیفتد و مانند گوی (کره) زیر پای او باشد."],[80,"بگفتا سرت گر ببرد به تیغ؟","بگفت این قدر نبود از وی دریغ","گفت اگر سرم را به شمشیر بزند، ناراحت نمی‌شوم و چنین چیزی از او نباید غمگینم کند."],[80,"مرا خود ز سر نیست چندان خبر","که تاج است بر تارکم یا تبر","من به خودم خیلی توجهی ندارم و نمی‌دانم که آیا بر سرم تاجی هست یا تبری؛ چون در عشق به حالت مستی و بی‌خبری دچارهستم."],[80,"مکن با من ناشکیبا عتیب","که در عشق صورت نبندد شکیب","با من بی‌صبر و تحمل رفتار نکن، زیرا در عشق، صبر و شکیبایی معنا ندارد."],[80,"چو یعقوبم ار دیده گردد سپید","نبرّم ز دیدار یوسف امید","اگر مانند یعقوب (پدر یوسف) شوم و چشمانم به واسطه غم، سفید و نابینا شود، هرگز امید دیدار یوسف را از دست نخواهم داد."],[80,"یکی را که سر خوش بود با یکی","نیازارد از وی به هر اندکی","اگر کسی خوشحال و سرزنده باشد، نباید از دیگران به دلیل هیچ چیز ناچیزی رنجش و آزار ببیند."],[80,"رکابش ببوسید روزی جوان","برآشفت و برتافت از وی عنان","جوانی که سوار بود، به خاطر چیزی از فردی که از او حمایت می‌کرد، ناراحت شد و از او فاصله گرفت و افسار اسبش را کشید."],[80,"بخندید و گفتا ‌«عنان برمپیچ","که سلطان عنان برنپیچد ز هیچ","او با لبخندی گفت: «عنان را نپیچ، زیرا تنها سلطان است که می‌تواند عنان را بپیچاند و هیچ‌کس دیگری نمی‌تواند.» در اینجا او به قدرت و مقام سلطان اشاره دارد که فقط او بر کارها حکمرانی و تسلط دارد."],[80,"مرا با وجود تو هستی نماند","به یاد توام خودپرستی نماند","وجود من با حضور تو دیگر معنا ندارد و امیدی به یاد تو نمی‌برم. خودخواهی و خودپرستی در من برطرف شده است."],[80,"گرم جرم بینی مکن عیب من","تویی سر بر آورده از جیب من","اگر با من در خطا و گناه روبه‌رو هستی، عیب را به من نسبت نده، چرا که تو از وجود من به وجود آمده‌ای و در واقع، اصل مشکل از خود توست."],[80,"بدان زهره دستت زدم در رکاب","که خود را نیاوردم اندر حساب","از این رو جرأت و زهره داشتم که رکاب مرکبت را بگیرم که خود را به‌حساب نیاوردم."],[80,"کشیدم قلم در سر نام خویش","نهادم قدم بر سر کام خویش","من نام خود را با قلم بر شناسنامه‌ام نوشتم و بر آرزوهایم پا گذاشتم."],[80,"مرا خود کشد تیر آن چشم مست","چه حاجت که آری به شمشیر دست؟","چشم پر از می عشق به قدری مرا می‌کشد که نیازی به شمشیر نیست."],[80,"تو آتش به نی در زن و در گذر","که نه خشک در بیشه ماند نه تر‌»","آتش را به نی بزن و در مسیر بگذر که نه چیزی خشک در جنگل باقی می‌ماند و نه چیزی تر."],[81,"شنیدم که بر لحن خنیاگری","به رقص اندر آمد پری پیکری","شنیدم که صدای موسیقی زیبایی شنیده شد و دختری با ظاهری زیبا به رقص درآمد."],[81,"ز دلهای شوریده پیرامنش","گرفت آتش شمع در دامنش","دل‌های عشاق دور او به شدت دچار هیجان و احساس هستند و این حال و هوای شوریده گرداگردش را گرفته است، مانند شعله‌ی آتش که در دامن شمع می‌رقصند."],[81,"پراکنده خاطر شد و خشمناک","یکی گفتش از دوستداران، چه باک؟","یکی از دوستداران به او گفت که نگران نباش و از این موضوع ناراحت نشو، در حالی که او پراکنده خاطر و عصبانی شده است."],[81,"تو را آتش ای دوست دامن بسوخت","مرا خود به یک بار خرمن بسوخت","ای دوست، آتش عشق تو، دامن من را سوزانده و خودت با یک لحظه، سراسر زندگی‌ام را به نابودی کشاندی."],[81,"اگر یاری از خویشتن دم مزن","که شرک است با یار و با خویشتن","اگر کسی بخواهد به خود ببالد یا از خود تعریف کند، باید بداند که این کار نوعی شرک است، چه در رابطه با معشوق و چه در رابطه با خود."],[81,"چنین دارم از پیر داننده یاد","که شوریده‌ای سر به صحرا نهاد","من از پیر دانا این را یاد گرفته‌ام که شخص عاشق و دیوانه، مانند کسی است که به دشت و صحرا پناه می‌برد."],[81,"پدر در فراقش نخورد و نخفت","پسر را ملامت بکردند و گفت","پدر در غم دوری یار خود خوابش نبرد و دیگران فرزندانش را سرزنش کردند و گفتند که تو هم باید همینطور بی‌تابی کنی."],[81,"از انگه که یارم کس خویش خواند","دگر با کسم آشنایی نماند","چون محبوبم کسی را به خود نزدیک نخواند، دیگر با هیچ‌کس آشنایی و دوستی ندارم."],[81,"به حقش که تا حق جمالم نمود","دگر هر چه دیدم خیالم نمود","به خاطر زیبایی و جذابیتی که او (یار) به من نشان داد، همه چیزهایی که بعد از آن دیدم، فقط در ذهن من به شکل خیالات درآمد."],[81,"نشد گم که روی از خلایق بتافت","که گم کرده خویش را باز یافت","کسی که از مردم رو برگرداند و به دوری نشینی، نمی‌تواند خودش را گم کند و در نهایت دوباره خود را می‌یابد."],[81,"پراکندگانند زیر فلک","که هم دد توان خواندشان هم ملک","زیر آسمان، انسان‌ها به دو دسته تقسیم می‌شوند: برخی مانند دد (حیوانات وحشی) هستند که به بدی و شرارت تمایل دارند و برخی دیگر مانند ملک (فرشتگان) هستند که از خوبی و صفات نیکو برخوردارند."],[81,"ز یاد ملک چون ملک نارمند","شب و روز چون دد ز مردم رمند","خود را از یاد دنیا و ملک دور کن، زیرا مانند ملکی که گرفتار آتش است، زندگی‌ات از شب تا روز دچار رنج و گرفتاری خواهد بود و به‌سان ددی که از انسان‌ها می‌گریزد، همچون آنان از انسانیت فاصله خواهی گرفت."],[81,"قوی بازوانند کوتاه دست","خردمند شیدا و هشیار مست","کسانی که عاشق و شیدا هستند، در عین اینکه عاقل و بافکرند، اما به دلیل خیالات و احساساتشان از هر چیز از جمله قدرت و نفوذ کوتاه هستند."],[81,"گه آسوده در گوشه‌ای خرقه دوز","گه آشفته در مجلسی خرقه سوز","گاهی در سکوت و آرامش، در گوشه‌ای به دوختن لباس (زهد) مشغولند و گاهی در مجالس شادمانی، با شور و هیجان، در حال معنا بخشیدن به زندگی و دل‌های دیگران هستند."],[81,"نه سودای خودشان، نه پروای کس","نه در کنج توحیدشان جای کس","این افراد نه به فکر منفعت خود هستند و نه نگران دیگران. در دنیای خالص و بی‌دغدغه‌ی خود، جا و مکانی برای دیگران ندارند و به توحید و یکتایی می‌پردازند."],[81,"پریشیده عقل و پراکنده هوش","ز قول نصیحتگر آکنده گوش","عقل انسان در حالت پریشانی و عدم تمرکز قرار دارد و هوش او نیز پراکنده شده است؛ چراکه او به گفته‌های نصیحت‌کننده گوش می‌دهد اما به آن‌ها توجهی ندارد."],[81,"به دریا نخواهد شدن بط غریق","سمندر چه داند عذاب حریق؟","وقتی که کسی شجاعت رفتن به دریا را ندارد، مانند بط که به غرق شدن در آب نمی‌انجامد، چگونه می‌تواند عذاب و درد حریق (آتش) را درک کند؟"],[81,"تهیدست مردان پر حوصله","بیابان نوردان پی قافله","مردان تهیدست و بی‌پول، ولی با صبوری و شکیبایی، در بیابان‌ها در جست‌وجوی قافله‌ای هستند."],[81,"عزیزان پوشیده از چشم خلق","نه زنار داران پوشیده دلق","عزیزان واقعی و دوست‌داشتنی از دید مردم پنهان هستند و مانند کسانی که فقط پوشش ظاهری دارند و به خاطر لباس‌ها یا نشان‌ها نمی‌توان آن‌ها را شناخت."],[81,"ندارند چشم از خلایق پسند","که ایشان پسندیده حق بسند","عاشقان حقیقی به نظرات مردم توجهی ندارند، بلکه آنچه را که خدا پسندیده است، می‌پسندند."],[81,"پر از میوه و سایه‌ور چون رزند","نه چون ما سیه‌کار و ازرق بزند","آنها مانند درختان میوه‌دار هستند که پر از میوه و سایه‌اند و به خوبی می‌رویند، نه مانند ما که به خاطر گناهان و بدکرداری‌ها و به شکل سیاه و غمگین هستیم."],[81,"به خود سر فرو برده همچون صدف","نه مانند دریا بر آورده کف","انسان‌های اهل محبت و عشق، مانند صدفی هستند که در عمق دریا پنهان شده‌اند و خود را درونی می‌کنند، در حالی که برعکس دریا که تنها رویه‌اش را به نمایش می‌گذارد و کفش به سطح آب می‌آید."],[81,"نه مردم همین استخوانند و پوست","نه هر صورتی جان معنی در اوست","انسان‌ها تنها به ظاهر و جسم خود (استخوان و پوست) محدود نیستند، بلکه وجود واقعی و ارزش آن‌ها در روح و معناست که در پس چهره‌ها نهفته است."],[81,"نه سلطان خریدار هر بنده‌ای است","نه در زیر هر ژنده‌ای زنده‌ای است","نه هر سلطانی دنبال خرید هر بنده‌ای است و نه هر کسی که به ظاهر بی‌ارزش به نظر می‌رسد، در واقع زنده و ارزشمند است."],[81,"اگر ژاله هر قطره‌ای در شدی","چو خرمهره بازار از او پر شدی","اگر هر قطره بارانی (ژاله) با ارزش و زیبا می‌بود، مانند مرواریدهایی (خرمهره‌ها) که در بازار عرضه می‌شوند، بازار به شدت از آن پر می‌شد."],[81,"چو غازی به خود بر نبندند پای","که محکم رود پای چوبین ز جای","اگر غاز (پرنده‌ ای شبیه غاز) پاهایش را به خود نبندد، به راحتی در جایش محکم قرار می‌گیرد و جابه‌جا نمی‌شود. این بیان به نوعی اشاره به انسان‌ها دارد که اگر خود را محدود نکنند، می‌توانند در زندگی به طور محکم و استوار پیش بروند."],[81,"حریفان خلوت‌سرای الست","به یک جرعه تا نفخه صور مست","دوستانی که در عالم راز و حقیقت هستند، با یک نفس عمیق تا لحظه برانگیخته شدن در قیامت، در عشق به حق و معانی بلند مست و سرمست می‌شوند."],[81,"به تیغ از غرض بر نگیرند چنگ","که پرهیز و عشق آبگینه‌ست و سنگ","عاشقان و اهل محبت به خاطر اهداف خود از شمشیر استفاده نمی‌کنند، زیرا پرهیز (خودداری) و عشق مانند آبگینه (شیشه‌ای و ظریف) هستند و به سختی (سنگ) شبیه نیستند."],[82,"یکی شاهدی در سمرقند داشت","که گفتی به جای سمر قند داشت","شاهدی در سمرقند داشت که زیبایی‌اش به قدری بود که انگار سمرقند، یعنی یکی از زیباترین و معروف‌ترین شهرها، در مقابل او قرار دارد."],[82,"جمالی گرو برده از آفتاب","ز شوخیش بنیاد تقوی خراب","زیبایی چهره‌ای که به خاطر تابش آفتاب شخصیتش را به اسارت درآورده، از شیرینی و جذابیتش، باعث شده که پایه‌های تقوا و دیانت او به هم بریزد."],[82,"تعالی الله از حسن تا غایتی","که پنداری از رحمت است آیتی","خداوند از زیبایی، تا حدی متعالی شده است که می‌توان تصور کرد زیبایی او نشانه‌ای از رحمتش است."],[82,"همی رفتی و دیده‌ها در پیش","دل دوستان کرده جان برخیش","تو در حال رفتن بودی و نگاه‌ها را به دل دوستان سپرده بودی، همچنان که جان را برای عشقشان فدای این کار می‌کردی."],[82,"نظر کردی این دوست در وی نهفت","نگه کرد باری به تندی و گفت","دوست به تو نگاهی کرد و از نگاهش چیزی را پنهان کرده بود. سپس به‌سرعت گریزی زد و گفت."],[82,"که ای خیره سر چند پویی پیم","ندانی که من مرغ دامت نیم؟","ای احمق، چرا به دنبال چیزهایی می‌گردی که نمی‌دانی؟ نمی‌دانی که من یک پرنده‌ام که در دام تو افتاده‌ام؟"],[82,"گرت بار دیگر ببینم به تیغ","چو دشمن ببرم سرت بی‌دریغ","اگر دوباره تو را ببینم، مانند یک دشمن، بدون هیچ تردیدی سرت را با شمشیر می‌زنم."],[82,"کسی گفتش اکنون سر خویش گیر","از این سهل‌تر مطلبی پیش گیر","کسی به معشوق می‌گوید که حالا که در خطر جان قرار داری، بهتر است خود را جمع و جور کنی و با مشکل‌های بزرگ‌تر مواجه شوی."],[82,"نپندارم این کام حاصل کنی","مبادا که جان در سر دل کنی","نپندارم که بتوانی به این راحتی به آرزوی خود برسی، مبادا که بخواهی به خاطر به دست آوردن آن، جان خود را در خطر بیندازی."],[82,"چو مفتون صادق ملامت شنید","به درد از درون ناله‌ای برکشید","مفتون صادق، عاشق حقیقی، به هنگام شنیدن ملامت عشق، از درد درون خود صدای ناله‌ای بلند کرد."],[82,"که بگذار تا زخم تیغ هلاک","بغلطاندم لاشه در خون و خاک","اجازه بده تا با زخم شمشیری که کشته‌ام، بدنم را در خون و خاک بگذارم و غوطه‌ور شوم."],[82,"مگر پیش دشمن بگویند و دوست","که این کشته دست و شمشیر اوست","آیا ممکن است به دشمنان و دوستان بگویند که این کسی که کشته شده، قربانی دست و شمشیر اوست؟"],[82,"نمی‌بینم از خاک کویش گریز","به بیداد گو آبرویم بریز","بغیر از این که نمی‌توانم از خاک کوی معشوق فرار کنم، به ظلم و ستمی که به من می‌شود، چاره‌ای ندارم و گویی آبروی من به باد رفته است."],[82,"مرا توبه فرمایی ای خودپرست","تو را توبه زین گفت اولی‌ترست","ای خودبرتربین، تو به من می‌گویی که توبه کنم، اما خودت نیاز بیشتری به توبه داری، چون این گفتار تو از خودخواهی ناشی می‌شود."],[82,"ببخشای بر من که هرچ او کند","و گر قصد خون است نیکو کند","ای خدا، مرا ببخش که هر چه او (معشوق) انجام دهد و حتی اگر بخواهد به من آسیب برساند، من آن را به گونه‌ای نیکو می‌بینم."],[82,"بسوزاندم هر شبی آتشش","سحر زنده گردم به بوی خوشش","هر شب به یاد او و عشقش دل را آتش می‌زنم، و صبح با بوی خوش او زنده می‌شوم."],[82,"اگر میرم امروز در کوی دوست","قیامت زنم خیمه پهلوی دوست","اگر امروز به خانه دوست بروم، آنقدر شور و هیجان به پا می‌کنم که چون روز قیامت، همه جا را تحت تأثیر قرار دهم و در کنار معشوق، خیمه برپا کنم."],[82,"مده تا توانی در این جنگ پشت","که زنده‌ست سعدی که عشقش بکشت","سعدی به کسی می‌گوید تا زمانی که زنده است در این جنگ عشق، پشت‌پا نزن و تسلیم نشو، زیرا عشق او را به مرگ نزدیک کرده است."],[83,"یکی تشنه می‌گفت و جان می‌سپرد","خنک نیکبختی که در آب مرد","یک نفر تشنه در حال جان دادن بود و از سر شوق می‌گفت که خوشا به حال کسی که در آب جان می‌دهد و غرق می‌شود."],[83,"بدو گفت نابالغی کای عجب","چو مردی چه سیراب و چه خشک لب","نابالغی به او گفت: عجیب است که تو وقتی مردی، دیگر نه سیراب شده‌ای و نه لب‌هایت خشک مانده‌اند."],[83,"بگفتا نه آخر دهان تر کنم","که تا جان شیرینش در سر کنم؟","او (نابالغ) می‌گوید که دیگر نمی‌تواند دهان را تر کند، زیرا می‌خواهد جان شیرینش را در دل نگه دارد و آن را به خطر نیندازد."],[83,"فتد تشنه در آبدان عمیق","که داند که سیراب میرد غریق","عاشق به‌گونه‌ای تشنه عشق است که اگر در دریاهای عمیق هم غرق شود، تنها امیدش این است که شاید سیراب شود و زنده بماند."],[83,"اگر عاشقی دامن او بگیر","وگر گویدت جان بده، گو بگیر","اگر عاشق شوی، به دامن او چنگ بزن و اگر او به تو بگوید که جانت را فدای او کن، این را انجام بده."],[83,"بهشت‌ تن‌آسانی آنگه خوری","که بر دوزخ نیستی بگذری","تنها زمانی می‌توانی از لذت‌های زندگی بهره‌مند شوی که از مشکلات و سختی‌ها عبور کرده باشی."],[83,"دل تخم‌کاران بود رنج‌کش","چو خرمن برآید بخسبند خوش","دل کشاورزان در تلاش و زحمت است و مانند خرمنی که پس از برداشت آماده است، وقتی به دستاوردی می‌رسند، می‌توانند استراحت کرده و خوشحال باشند."],[83,"در این مجلس آن‌کس به کامی رسید","که در دور آخر به جامی رسید","در این مجلس، تنها کسی به آرزو و کامیابی دست یافت که در آخرین دور به جام شراب رسید."],[84,"چنین نقل دارم ز مردان راه","فقیران منعم، گدایان شاه","من از مردان بایسته و دانای راه نقل می‌کنم که آنها همواره در عیش و نعمت‌اند، حتی اگر به ظاهر فقیر باشند و در نقش گدا."],[84,"که پیری به دریوزه شد بامداد","در مسجدی دید و آواز داد","پیری در صبح زود به دروازه‌ای رفته و در مسجدی کسی را دید و صدایش زد."],[84,"یکی گفتش این خانه خلق نیست","که چیزی دهندت، به‌شوخی مایست","کسی به آن پیر می‌گوید اینجا خانه مردم نیست و نباید انتظار داشته باشی که کسی به تو چیزی بدهد، اینجا فقط برای شوخی و تفریح است."],[84,"بدو گفت کاین خانه کیست پس‌؟","که بخشایشش نیست بر حال کس؟","این شخص از طرف مقابل می‌پرسد که این خانه متعلق به کیست، چون به نظر می‌رسد که در اینجا هیچ کسی نمی‌تواند به هیچ‌کس چیزی ببخشد."],[84,"بگفتا خموش، این چه لفظ خطاست","خداوند خانه خداوند ماست","او گفت ساکت باش، این سخن نادرست است؛ چرا که صاحب این خانه، خود خداوند است."],[84,"نگه کرد و قندیل و محراب دید","به سوز از جگر نعره‌ای بر کشید","نگاه کرد و قندیل (چراغ روشن) و محراب (جای عبادت) را دید و با شدت عشق یا اندوهی که در دلش بود، فریادی از دل برآورد."],[84,"که حیف است از اینجا فراتر شدن","دریغ است محروم از این در شدن","خروج از این مکان بسیار زیبا و دلپذیر ناپسند است و افسوس است که از این در که به حق نزدیک شده‌ام، محروم شوم."],[84,"نرفتم به محرومی از هیچ کوی","چرا از در حق شوم زردروی‌؟","من از هیچ مکانی محروم نشده‌ام، پس چرا باید از در حق (خدا) ناامید و دلمرده شوم؟"],[84,"هم اینجا کنم دست خواهش دراز","که دانم نگردم تهیدست باز","من همین‌جا دست نیاز به سوی خواسته‌هایم دراز می‌کنم، زیرا می‌دانم که تهیدست باز نمی گردم."],[84,"شنیدم که سالی مجاور نشست","چو فریاد‌خواهان برآورده دست","روزی شنیدم که شخصی سال‌ها در کنار خانقاه و در حال عبادت و نزدیکی به خداوند نشسته بود، و همچون کسانی که در طلب کمک و دعای دیگران‌اند، دستش را به سوی آسمان بلند کرده بود."],[84,"شبی پای عمرش فرو شد به گل","تپیدن گرفت از ضعیفیش دل","شبی در میان گل و گیاه، عمر این شخص به پایان رسید و از ضعف و ناتوانی، قلب او به تپش درآمد."],[84,"سحر برد شخصی چراغش به سر","رمق دید از او چون چراغ سحر","شخصی در سحرگاه چراغش را برداشت و به سر کوه رفت، و از نور چراغش متوجه شد که نور آن مانند نور صبحگاه است."],[84,"همی‌گفت غلغل‌کنان از فرح","و من دق باب الکریم انفتح","او (شخص) به شوق و شادی از گشوده شدن دروازه بزرگ (دری که به سوی رحمت و نعمت خداوند می‌رود) سخن می‌گفت و من (سعدی) در حالتی بی‌قرار و ناآرام بودم."],[84,"طلبکار باید صبور و حمول","که نشنیده‌ام کیمیاگر ملول","کسی که طلبی دارد باید صبر و بردباری کند، زیرا من هرگز نشنیده‌ام که یک کیمیاگر از کارش خسته شود یا ناامید گردد."],[84,"چه زرها به خاک سیه در کنند","که باشد که روزی مسی زر کنند","مردم برای به دست آوردن طلا و ثروت ممکن است سرمایه‌های زیادی را بیهوده خرج کنند، اما باید بدانند که ممکن است روزی به زحمت خود ارزش واقعی بدهند و به چیزی باارزش‌تر تبدیل شوند."],[84,"زر از بهر چیزی خریدن نکوست","نخواهی خریدن به از یاد دوست","خریدن طلا برای رسیدن به یک هدف، کار خوبی است، اما هیچ چیز از یاد دوست مهم‌تر نیست، پس باید همیشه یاد او را در دل داشته باشی."],[84,"گر از دلبری دل به تنگ آیدت","دگر غمگساری به چنگ آیدت","اگر از عشق و دلبری دل‌سرد و خسته شوی، نگران نباش؛ چرا که دوباره در هنگام غم، کسی را خواهی یافت که در کنار تو باشد و غم‌هایت را تسکین دهد."],[84,"مبر تلخ عیشی ز روی ترش","به آب دگر آتشش باز کش","در موقعیت‌های ناخوشایند و تلخ زندگی، نباید با رفتارهای ترش و گرفته به آن واکنش نشان دهی؛ بلکه باید با تغییر نگرش و رویکرد، آتش غم و ناراحتی را خاموش کنی و به شرایط بهتری برسی."],[84,"ولی گر به خوبی ندارد نظیر","به اندک دل آزار ترکش مگیر","اگر کسی خوبی نداشته باشد، مانند یک شخصی که فقط به کمترین آزار هم دلسوزی نمی‌کند، از او دل نکن و او را رها نکن."],[84,"توان از کسی دل بپرداختن","که دانی که بی او توان ساختن","انتخاب دل را از کسی بکن که می‌دانی بدون او هم می‌توانی زندگی کنی."],[85,"شنیدم که پیری شبی زنده داشت","سحر دست حاجت به حق بر فراشت","پیرمردی را شنیدم که شبی از روی نیاز و درخواست، دست دعا به سوی خداوند بلند کرده بود."],[85,"یکی هاتف انداخت در گوش پیر","که ‌«بی‌حاصلی‌، رو سر خویش گیر","یک ندا یا صدایی به گوش پیر رسید که به او گفت: «عزت خود را حفظ کن و به خاطر بی‌نتیجه بودن دعایت، به دنبال دیگران نرو."],[85,"بر این در دعای تو مقبول نیست","به خواری برو یا به زاری بایست‌»","دعای تو در این درگاه قابل قبول نیست، پس یا با ذلت برو یا با زاری بایست."],[85,"شب دیگر از ذکر و طاعت نخفت","مریدی ز حالش خبر یافت، گفت","مریدی که در شب دیگری از عبادت و ذکر خسته نشده و خوابش نبرده، حالش خبر داده می‌شود."],[85,"چو دیدی کز آن روی بسته‌ست در","به بی‌حاصلی سعی چندین مبر","وقتی دیدی که آن معشوق روی خود را از تو پنهان کرده است، دیگر برای تلاش و کوشش‌های بی‌نتیجه‌ات ادامه نده."],[85,"به دیباچه بر اشک یاقوت‌فام","به حسرت ببارید و گفت ای غلام","در آغاز، به پرده‌ای که همانند اشک‌های یاقوت می‌درخشد اشاره شده و سپس شخصی با حسرت می‌گوید، ای غلام (دست‌یار)، بگذار که برایم گریه کنم."],[85,"به نومیدی آنگه بگردیدمی","از این ره، که راهی دگر دیدمی","در دنیای ناامیدی، به سوی دیگری رفتم چون راه دیگری پیدا کردم."],[85,"مپندار گر وی عنان بر شکست","که من باز دارم ز فتراک دست","مندوشت تو گمان نکن که اگر او (دوست یا معشوق) عزم جزم کرده است و سر راهی جدیدی قرار گیرد، من (احساسات و عشق خودم) را از دست می‌دهم و نمی‌توانم از این عشق رها شوم."],[85,"چو خواهنده محروم گشت از دری","چه غم گر شناسد در دیگری؟","اگر کسی که مشتاق است از یک در محروم شود، چه اهمیتی دارد که در دیگری را بشناسد؟ این نشان‌دهنده ناامیدی و بی‌ثمر بودن تلاش‌های اوست."],[85,"شنیدم که راهم در این کوی نیست","ولی هیچ راه دگر روی نیست","شنیده‌ام که در این مسیر هیچ راهی نیست، اما هیچ مسیر دیگری هم وجود ندارد که بتوان به آنجا رفت."],[85,"در این بود سر بر زمین فدا","که گفتند در گوش جانش ندا","او در این حالت با سر به زمین افتاده و جانش ندا داده می‌شود که روحش به عشق و شیدایی تسلیم شده است."],[85,"قبول است اگر چه هنر نیستش","که جز ما پناهی دگر نیستش","اگرچه کسی جز ما به او پناه نمی‌دهد، ولی این را قبول داریم که این کار هنری نیست."],[86,"یکی در نشابور دانی چه گفت","چو فرزندش از فرض خفتن بخفت؟","مردی در نیشابور (شهری در ایران) وقتی پسرش از طرفی به خواب رفت، چه گفت؟"],[86,"توقع مدار ای پسر گر کسی","که بی سعی هرگز به جایی رسی","ای پسر، انتظار نداشته باش که کسی بدون تلاش و کوشش، به موفقیتی برسد."],[86,"سمیلان چو می بر نگیرد قدم","وجودی است بی منفعت چون عدم","انسانی که شراب را نمی‌نوشد و از لذت‌های زندگی دور است، وجودش هیچ فایده‌ای ندارد و به مانند عدم است، زیرا از تجربیات و خوشی‌ها محروم است."],[86,"طمع دار سود و بترس از زیان","که بی بهره باشند فارغ زیان","از انتظار سود دست نکش و از ضرر بترس، زیرا کسانی که بی‌فایده هستند، هیچ‌گونه زیانی ندارند."],[87,"شکایت کند نوعروسی جوان","به پیری ز داماد نامهربان","نوعروسی جوان از رفتار بی‌محبت شوهرش نزد پیرمردی شکایت می‌کند."],[87,"که مپسند چندین که با این پسر","به تلخی رود روزگارم به سر","نباید بر این پسر به خاطر تلخی و بدی‌ای که دارد، آن‌قدر ناراحت باشی، زیرا روزهای زندگی‌ام به خاطر رفتار او به سختی می‌گذرد و نمی‌ارزد که بیش از این بر او بیندیشی."],[87,"کسانی که با ما در این منزلند","نبینم که چون من پریشان دلند","کسانی که هم‌اکنون در این خانه با من زندگی می‌کنند را نمی‌بینم که مانند من دل‌شکسته و پریشان باشند."],[87,"زن و مرد با هم چنان دوستند","که گویی دو مغز و یکی پوستند","زن و مرد به قدری با یکدیگر رابطه نزدیک و دوستی دارند که مانند دو مغز در یک پوست هستند و تفکیک‌ناپذیر به نظر می‌رسند."],[87,"ندیدم در این مدت از شوی من","که باری بخندید در روی من","در مدت زمانی که با شوهرم بوده‌ام، هیچ وقت او را ندیده‌ام که حتی برای یک بار هم به من لبخند بزند."],[87,"شنید این سخن پیر فرخنده فال","سخندان بود مرد دیرینه سال","این سخن را پیر فرخنده فال که انسان عاقل و با تجربه‌ای است، شنید."],[87,"یکی پاسخش داد شیرین و خوش","که گر خوبروی است بارش بکش","شیرین جواب او را داد و گفت که اگر کسی زیباست، باید تحمل سختی‌های او را هم داشت."],[87,"دریغ است روی از کسی تافتن","که دیگر نشاید چنو یافتن","ناراحت‌کننده است که از کسی روی برگردانیم که دیگر نمی‌توان مانند او را پیدا کرد."],[87,"چرا سر کشی زان که گر سر کشد","به حرف وجودت قلم در کشد؟","چرا سرکشی و خود را برتر از دیگران می‌دانی، در حالی که اگر از خود سرکشی نشان دهی، وجودت به اندازه‌ای کوچک و بی‌ارزش است که فقط با یک کلام می‌توان آن را از بین برد؟"],[87,"یکم روز بر بنده‌ای دل بسوخت","که می‌گفت و فرماندهش می‌فروخت","روزی بر بنده‌ای (غلام یا شخص زیر دست) عاشق شدم که فرمانده‌اش (سرپرستش) او را ناچیز و بی‌ارزش می‌دانست و به او بی‌محلی می‌کرد."],[87,"تو را بنده از من به افتد بسی","مرا چون تو دیگر نیفتد کسی","اگر من بنده‌ای مانند تو داشته باشم، از تو بسیار بیشتر برایم مهم و عزیز است، زیرا هیچ کس مانند تو برایم باارزش نیست."],[88,"طبیبی پری‌چهره در مرو بود","که در باغ دل قامتش سرو بود","یک پزشک خوش‌چهره در شهر مرو بود که قامت خوش او دل‌های زیادی را ربوده بود."],[88,"نه از درد دل‌های ریشش خبر","نه از چشم بیمار خویشش خبر","نه از عاشقان خود خبر داشت و نه می‌دانست که عاشق او چشم به‌راه اوست."],[88,"حکایت کند دردمندی غریب","که خوش بود چندی سرم با طبیب","دردمندی غریب حکایت می‌کند که مدتی به آن طبیب، دل باخته بودم."],[88,"نمی‌خواستم تندرستی خویش","که دیگر نیاید طبیبم به پیش","(در آن مدت) تندرستی خود را نمی‌خواستم تا آمدن طبیب به نزد من متوقف نشود."],[88,"بسا عقل زورآور چیردست","که سودای عشقش کند زیردست","چه بسیار عقل‌های قوی و زورمند در برابر هوس عشق، ضعیف و زیردست می‌گردند."],[88,"چو سودا خرد را بمالید گوش","نیارد دگر سر برآورد هوش","وقتی که عشق و سودا، عقل و خرد را مقهور می‌کند دیگر هوش و ذکاوتی نمی‌ماند."],[89,"یکی پنجه آهنین راست کرد","که با شیر زورآوری خواست کرد","شخصی دستش را مثل پنجه آهنین محکم و قوی کرد تا با شیر زورآوری کند و بر آن تسلط یابد."],[89,"چو شیرش به سرپنجه در خود کشید","دگر زور در پنجه خود ندید","وقتی شیر در چنگال آهنین او گرفتار شد، دیگر نیرویی در چنگال خودش احساس نکرد."],[89,"یکی گفتش آخر چه خسبی چو زن؟","به سرپنجه آهنینش بزن","کسی به آن مسکین می‌گوید که چرا مانند زن به خواب رفته‌ای؟ تو باید با زور و قدرت مثل پنجه‌ای آهنین به او حمله کنی."],[89,"شنیدم که مسکین در آن زیر گفت","نشاید بدین پنجه با شیر گفت","شنیدم که فردی بیچاره در زیر به دیگران می‌گوید که نباید با چنین پنجه‌ای (که نماد قدرت و زور است) با شیر (نماد شجاعت و قدرت) برخورد کرد."],[89,"چو بر عقل دانا شود عشق چیر","همان پنجه آهنین است و شیر","زمانی که عشق بر عقل آگاه تسلط پیدا کند، مانند قدرت پنجه آهنین و پنجه شیر است."],[89,"تو در پنجه شیر مرد اوژنی","چه سودت کند پنجه آهنی؟","عشق که به عقل چیره شود، بی‌فائده است که به قدرت و استحکام عقل تکیه کنی، زیرا در برابر عشق نمی‌تواند کمکی به تو کند. اینجا به مرد اوژنی (مردی قوی و دلیر) اشاره شده که حتی او نیز در برابر عشق بی‌اثر خواهد بود."],[89,"چو عشق آمد از عقل دیگر مگوی","که در دست چوگان اسیر است گوی","وقتی عشق به دل کسی وارد می‌شود، دیگر نباید درباره عقل صحبت کرد، چرا که در این حالت انسان مانند گوی در دست چوگان است و تسلطی بر خود ندارد."],[90,"میان دو عم زاده وصلت فتاد","دو خورشید سیمای مهتر نژاد","دو پسر از خانواده‌های بزرگ و با افتخار به هم پیوسته‌اند، که هر کدام به مانند دو خورشید زیبا و درخشان هستند و از نسل‌های نیکو به شمار می‌آیند."],[90,"یکی را به غایت خوش افتاده بود","دگر نافر و سرکش افتاده بود","یکی از آن دو نفر به شدت خوشحال و شاداب بود، در حالی که نفر دیگر حالتی نافرمان و سرکش داشت."],[90,"یکی خلق و لطف پریوار داشت","یکی روی در روی دیوار داشت","یکی از افراد ویژگی‌ها و حس‌های زیبایی دارد و به لطف و نیکی مشهور است، در حالی که دیگری چهره‌ای دارد که نمی‌تواند در برابر دیگران قرار گیرد و در واقع با دیواری از تنهایی و جدایی خود را محصور کرده است."],[90,"یکی خویشتن را بیاراستی","دگر مرگ خویش از خدا خواستی","یک نفر خود را با زیورهای محبت و زیبایی تزئین کرده و دیگری از خدا طلب مرگ کرده است."],[90,"پسر را نشاندند پیران ده","که مهرت بر او نیست مهرش بده","پسر را در جمعی از بزرگ‌ترها نشاندند و آن‌ها گفتند که چون محبت و دوستی تو را به او تعلق ندارد، بهتر است محبتت را به او عطا کنی."],[90,"بخندید و گفتا به صد گوسفند","تغابن نباشد رهایی ز بند","او (محبوب) خندید و گفت که حتی با صد گوسفند هم نمی‌توان از عشق و وابستگی به تو رهایی یافت؛ عشق عمیق‌تر از آن است که با مال و دارایی قابل خریداری یا رهایی باشد."],[90,"به ناخن پری چهره می‌کند پوست","که هرگز بدین کی شکیبم ز دوست؟","معنی صورت زیبا و خوش‌سیما را با انگشتانش چون رنگی بر پوست رسم می‌کند، اما من هرگز نمی‌توانم بر دوری از دوست شکیبا باشم."],[90,"نه صد گوسفندم که سیصد هزار","نباید به نادیدن روی یار","نه، حتی اگر صد گوسفند داشته باشم، ارزش آن را ندارد که روی یار را نبیینم؛ به عبارتی، هیچ چیز به اندازه دیدن روی محبوب برایم مهم نیست."],[90,"تو را هر چه مشغول دارد ز دوست","اگر راست خواهی دلارامت اوست","هر چیز که تو را به یاد دوست مشغول می‌کند، اگر به‌راستی او را بخواهی، همان دوست آرامش‌دهنده توست."],[90,"یکی پیش شوریده حالی نبشت","که دوزخ تمنا کنی یا بهشت؟","شخصی در حال مستی و شیدایی، این سؤال را مطرح کرد که آیا باید دوزخ را در آرزوهایم بخواهم یا بهشت را؟"],[90,"بگفتا مپرس از من این ماجرا","پسندیدم آنچ او پسندد مرا","او می‌گوید از من درباره این ماجرا نپرس، چون من آنچه را او بپسندد، می‌پسندم."],[91,"به مجنون کسی گفت کای نیک پی","چه بودت که دیگر نیایی به حی؟","کسی به مجنون می‌گوید: ای انسان نیکوخصال، چه اتفاقی برای تو افتاده که دیگر به حال خودت برنمی‌گردی؟"],[91,"مگر در سرت شور لیلی نماند","خیالت دگر گشت و میلی نماند؟","آیا در وجود تو هیچ احساسی از عشق لیلی باقی نمانده است که دیگر ذهن و قلبت به چیز دیگری مشغول شده است؟"],[91,"چو بشنید بیچاره بگریست زار","که ای خواجه دستم ز دامن بدار","مجنون، که در عشق لیلی سرگردان است، وقتی این سخن را می‌شنود، به شدت گریه می‌کند و از او می‌خواهد که دستش را رها نکند."],[91,"مرا خود دلی دردمند است ریش","تو نیزم نمک بر جراحت مریش","دل من هم درد دارد و رنج می‌کشد، و تو نیز با وجود اینکه به من آسیب زده‌ای، در واقع زخم‌های من را بیشتر می‌کنی."],[91,"نه دوری دلیل صبوری بود","که بسیار دوری ضروری بود","دوری از محبوب بهانه‌ای برای صبوری نیست، بلکه در مواردی دوری از او اجتناب‌ناپذیر است و نمی‌توان از آن فرار کرد."],[91,"بگفت ای وفادار فرخنده خوی","پیامی که داری به لیلی بگوی","سعدی در این بیت، از زبان مجنون خطاب به مرد وفاداری می‌گوید که اگر پیامی برای لیلی (محبوب او) دارد، فورا به او برساند. مجنون بر وفاداری و عشق خود به لیلی تأکید می‌کند و به مرد وفادار دستور می‌دهد پیامش را منتقل کند."],[91,"بگفتا مبر نام من پیش دوست","که حیف است نام من آنجا که اوست","سعدی می‌گوید که مجنون به دوستش توصیه می‌کند که نام او را نزد لیلی (عشقش) نبرد، زیرا نام او در حضور لیلی هیچ ارزشی ندارد و حیف است که در آنجا به میان آید."],[92,"یکی خرده بر شاه غزنین گرفت","که حسنی ندارد ایاز ای شگفت","شخصی (خرده‌گیر) به شاه غزنین (سلطان محمود) انتقاد می‌کند که ایاز، که یکی از خدمتگزاران اوست، هیچ زیبایی و جذابیتی ندارد و این جای تعجب است."],[92,"گلی را که نه رنگ باشد نه بوی","غریب است سودای بلبل بر اوی!","گل‌هایی که نه رنگ دارند و نه عطر، برای بلبل عجیب و غریب هستند و بلبل عاشق آنها نمی‌شود."],[92,"به محمود گفت این حکایت کسی","بپیچید از اندیشه بر خود بسی","محمود به ایاز گفت که این ماجرا را کسی پیچیده و از فکر و خیال خود برای خود دشوار کرده است."],[92,"که عشق من ای خواجه بر خوی اوست","نه بر قد و بالای نیکوی اوست","عشق من به تو، ای آقا، به خاطر همان ویژگی‌های درونیت است و نه به خاطر قد و زیبایی ظاهری‌ات."],[92,"شنیدم که در تنگنایی شتر","بیفتاد و بشکست صندوق در","شنیدم که شتری در مکانی تنگ سقوط کرد و صندوقی را شکست."],[92,"به یغما ملک آستین برفشاند","وز آنجا به تعجیل مرکب براند","سلطان محمود با شتاب و عجله فرمان داد که اموال و دارایی‌ها را به غارت ببرند و از آن مکان به سرعت خارج شوند."],[92,"سواران پی در و مرجان شدند","ز سلطان به یغما پریشان شدند","سواران از در کاخ سلطان خارج شدند و در نتیجه از مقام و موقعیت خود آشفته و پریشان گشتند."],[92,"نماند از وشاقان گردن فراز","کسی در قفای ملک جز ایاز","از شجاعان و دلیران هیچ کسی در پی ملک و سلطنت باقی نماند، جز ایاز که خدمتکار و وفادار سلطان محمود بود."],[92,"نگه کرد کای دلبر پیچ پیچ","ز یغما چه آورده‌ای؟ گفت هیچ","دلبر زیبایی به کسی نگریست و از او پرسید که چه چیزی از غارتگران و دزدان آورده‌ای؟ او در پاسخ گفت هیچ چیزی نزد من نیست."],[92,"من اندر قفای تو می‌تاختم","ز خدمت به نعمت نپرداختم","من همیشه در پی تو بودم و به خاطر تو از خدمت به دیگران کوتاهی نکردم، از نعمت‌ها و لذت‌ها دست نکشیدم."],[92,"گرت قربتی هست در بارگاه","به خلعت مشو غافل از پادشاه","اگر در بارگاه شاه نزدیکتی داری، به خاطر لباس یا مقام خود غفلت نکن از توجه به پادشاه."],[92,"خلاف طریقت بود کاولیا","تمنا کنند از خدا جز خدا","در سلوک عرفانی، برخلاف روش صوفیان، این درست نیست که اولیا از خداوند چیزی غیر از خود او را طلب کنند."],[92,"گر از دوست چشمت بر احسان اوست","تو در بند خویشی نه در بند دوست","اگر چشم‌ت به لطف و احسان دوست باشد، پس تو در قید و بند خودت هستی نه در قید و بند دوست."],[92,"تو را تا دهن باشد از حرص باز","نیاید به گوش دل از غیب راز","تا زمانی که دهان تو از حرص و طمع پر باشد، رازهای غیبی به گوش دل تو نمی‌رسد."],[92,"حقیقت سرایی است آراسته","هوی و هوس گرد برخاسته","حقیقت مکانی است زیبا که به آرزوها و تمایلات نفسانی آراسته شده و بر اثر این خواسته‌ها، گرد و غباری را به وجود آورده است."],[92,"نبینی که جایی که برخاست گرد","نبیند نظر گرچه بیناست مرد","تو نمی‌بینی که در جایی که گرد و غبار برمی‌خیزد، حتی مرد بینا هم نمی‌تواند چیزی را ببیند."],[93,"قضا را من و پیری از فاریاب","رسیدیم در خاک مغرب به آب","من و یک پیرمرد در کنار رود فاریاب (نهر معروفی در ایران) به سرنوشت (قضا) رسیدیم و در سرزمین مغرب (غرب) به آب (یا به نزدیکی آب) رسیدیم."],[93,"مرا یک درم بود برداشتند","به کشتی و درویش بگذاشتند","من یک درم داشتم که آن را گرفتند و به کشتی بردند و درویش را در آنجا رها کردند."],[93,"سیاهان براندند کشتی چو دود","که آن ناخدا نا خدا ترس بود","کشتی را چون دود از سوی سیاه‌پوستان راندند، زیرا ناخدا از ترس و ناتوانی خود قادر به کنترل آن نبود."],[93,"مرا گریه آمد ز تیمار جفت","بر آن گریه قهقه بخندید و گفت","من به علت نگرانی و زحمت خاطر جفت خود اشک ریختم، اما او به این حال من خندید و گفت."],[93,"مخور غم برای من ای پر خرد","مرا آن کس آرد که کشتی برد","غم نخور برای من ای انسان عاقل، زیرا آن کسی که می‌تواند قلب مرا شاد کند، می‌آید و مرا خوشحال می‌کند."],[93,"بگسترد سجاده بر روی آب","خیال است پنداشتم یا به خواب","تصور کردم که سجاده‌ای را بر روی آب پهن کرده‌اند، اما این فقط خیال بود و شاید هم در خواب دیدم."],[93,"ز مدهوشیم دیده آن شب نخفت","نگه بامدادان به من کرد و گفت","در آن شب مستی، چشمانم خواب ندید، اما با رسیدن صبح، نگاه کسی به من افتاد و با من سخن گفت."],[93,"تو لنگی به چوب آمدی من به پای","تو را کشتی آورد و ما را خدای","تو به خاطر ناتوانی و ضعف خود، به چوب و عصا تکیه کرده‌ای و من به پای تو کمک کردم، چون خدا ما را در این وضعیت یاری کرد."],[93,"چرا اهل معنی بدین نگروند","که ابدال در آب و آتش روند؟","چرا کسانی که به معنای واقعی زندگی توجه دارند، به این موضوع اهمیت نمی‌دهند که برخی انسان‌ها (ابدال) برای کسب جان‌فشانی و رستگاری به سختی‌ها و خطرات، مانند آب و آتش، می‌روند؟"],[93,"نه طفلی کز آتش ندارد خبر","نگه داردش مادر مهرور؟","آیا ممکن است که مادری مهرورز، کودکی را که از آتش بی‌خبر است، رها کند و مراقبش نباشد؟"],[93,"پس آنان که در وجد مستغرقند","شب و روز در عین حفظ حقند","افرادی که در شوق و عشق غرق شده‌اند، در تمام ساعات زندگی خود همواره در حال توجه به حق و حقیقت هستند."],[93,"نگه دارد از تاب آتش خلیل","چو تابوت موسی ز غرقاب نیل","خداوند مانند تابوت موسی که از غرق شدن در نیل حفظ شد، از آتش ابراهیم (خلیل) نیز نگه‌داری می‌کند."],[93,"چو کودک به دست شناور برست","نترسد وگر دجله پهناورست","کودکانی که به دست شناور در آب می‌افتند، نمی‌ترسند، حتی اگر دجله، رود بسیار بزرگی باشد."],[93,"تو بر روی دریا قدم چون زنی","چو مردان که بر خشک تردامنی؟","تو چطور بر روی دریا قدم می‌گذاری، در حالی که مانند مردان، پاهای تو بر خشکی است و بی‌خطر بودن آن را نمی‌دانی؟"],[94,"ره عقل جز پیچ بر پیچ نیست","بر عارفان جز خدا هیچ نیست","برای عارفان و کسانی که حقیقت را می‌شناسند، راه عقل و تفکر هیچ سر و سامان روشنی ندارد و در نهایت تنها خدا باقی می‌ماند و غیر او هیچ چیز اصالت و حقیقت ندارد."],[94,"توان گفتن این با حقایق شناس","ولی خرده گیرند اهل قیاس","می‌توان با کسی که به حقیقت آگاه است، در این مورد سخن گفت، اما اهل قیاس و کسانی که به تفقه عقلانی وابسته‌اند، ممکن است نقد و عیب‌جویی کنند."],[94,"که پس آسمان و زمین چیستند؟","بنی آدم و دام و دد کیستند؟","پس از آسمان و زمین چه وجودی دارد؟ انسان‌ها و دیگر مخلوقات مانند حیوانات چه جایگاهی دارند؟"],[94,"پسندیده پرسیدی ای هوشمند","بگویم گر آید جوابت پسند","ای عاقل و باهوش، سوال خوبی پرسیدی؛ اگر بخواهم جوابی بگویم که برایت قابل قبول باشد، باید به دقت فکر کنم."],[94,"که هامون و دریا و کوه و فلک","پری و آدمی‌زاد و دیو و ملک","هامون، دریا، کوه، و آسمان، به همراه پری، انسان، دیو و فرشته، همه موجوداتی هستند که در این جهان وجود دارند."],[94,"همه هرچه هستند از آن کمترند","که با هستیش نام هستی برند","هر چیز و هر موجودی که وجود دارد، از وجود خداوند و حقیقت وجودی او کمتر است، تا جایی که برای وجود خود به نام «هستی» شناخته می‌شوند."],[94,"عظیم است پیش تو دریا به موج","بلند است خورشید تابان به اوج","آب دریا به خاطر امواج بزرگش نزد تو اهمیت دارد و خورشید در اوج خود می‌درخشد."],[94,"ولی اهل صورت کجا پی برند","که ارباب معنی به ملکی درند","اهل ظاهر و شکل هرگز نمی‌توانند به عمق معانی و حقیقت برسند، در حالی که صاحبان معانی و دقایق به عرش و آسمان‌های بلند دست پیدا می‌کنند."],[94,"که گر آفتاب است یک ذره نیست","وگر هفت دریاست یک قطره نیست","اگر آفتاب (نور و حقیقت) باشد، به اندازه یک ذره هم وجود ندارد، و اگر هفت دریا (مفاهیم عمیق و وسیع) باشد، به اندازه یک قطره هم نیست. این بیان نشان‌دهنده پوچی و عدم نسبت به کمال و وسعت حقیقت است."],[94,"چو سلطان عزت علم بر کشد","جهان سر به جیب عدم در کشد","وقتی که پادشاه بزرگوار و باعلمی ظهور کند، تمام جهان به سوی عدم و نیستی گرایش پیدا می‌کند."],[95,"رئیس دهی با پسر در رهی","گذشتند بر قلب شاهنشهی","کدخدایی و پسرش به لشکر شاه رسیدند و از میان لشکریان گذشتند."],[95,"پسر چاوشان دید و تیغ و تبر","قباهای اطلس، کمرهای زر","پسر‌، چاووش‌های لشکر را دید و شمشیرها و تبرها را و لباس‌های زیبای لشکریان و کمربندهای طلای آنها را."],[95,"یلان کماندار نخجیر زن","غلامان ترکش کش تیرزن","همچنین پهلوانان و غلامان کماندار را"],[95,"یکی در برش پرنیانی قباه","یکی بر سرش خسروانی کلاه","برخی لباس‌های پرنیان پوشیده‌بودند و برخی کلاه مرصّع بر سر داشتند."],[95,"پسر کان همه شوکت و پایه دید","پدر را به غایت فرومایه دید","وقتی پسر آن همه شکوه و مقام را دید؛ جاه و مقام پدرش در نظر او حقیر به‌نظر رسید"],[95,"که حالش بگردید و رنگش بریخت","ز هیبت به بیغوله‌ای در گریخت","پس رنگ روی کدخدا زرد شد و از وحشت به خرابه‌ای پناه برد."],[95,"پسر گفتش آخر بزرگ دهی","به سرداری از سر بزرگان مهی","پسر به او گفت: تو کدخدا هستی تو از بزرگان ده سرتر هستی"],[95,"چه بودت که ببریدی از جان امید","بلرزیدی از باد هیبت چو بید؟","چه شد که از جان ناامید شدی؟ و از این شکوه و عظمت وحشت‌زده شدی؟"],[95,"بلی، گفت سالار و فرماندهم","ولی عزتم هست تا در دهم","گفت: بله، بزرگ ده هستم اما بزرگ هستم تا زمانی‌که در همان ده هستم."],[95,"بزرگان از آن دهشت آلوده‌اند","که در بارگاه ملک بوده‌اند","همان بزرگان وقتی که به بارگاه پادشاه می‌رسند (احساس حقارت می‌کنند) و از هیبت و شکوه وحشت‌زده می‌گردند."],[95,"تو، ای بی خبر، همچنان در دهی","که بر خویشتن منصبی می‌نهی","ای بی‌خبر تو بدین جهت خود را مهم می‌پنداری که هنوز در ده هستی."],[95,"نگفتند حرفی زبان آوران","که سعدی نگوید مثالی بر آن","درباره هر نکته که سخن‌وران و شاعران حرفی‌زده‌اند سعدی حکایت و داستانی می‌آورد."],[95,"مگر دیده باشی که در باغ و راغ","بتابد به شب کرمکی چون چراغ","شاید تو نیز کرمک شب‌تاب را شب‌ها در باغ یا بیشه‌ای دیده باشی"],[95,"یکی گفتش ای کرمک شب فروز","چه بودت که بیرون نیایی به روز؟","شخصی از آن کرمک شب‌تاب پرسید که چرا در روزها بیرون نمی‌آیی؟"],[95,"ببین کآتشی کرمک خاکزاد","جواب از سر روشنایی چه داد","ببین آن کرمک متواضع چه پاسخ خردمندانه‌ای داد"],[95,"که من روز و شب جز به صحرا نیم","ولی پیش خورشید پیدا نیم","من در شب و روز و همیشه در صحرا هستم اما در برابر خورشید دیده‌نمی‌شوم."],[96,"ثنا گفت بر سعد زنگی کسی","که بر تربتش باد رحمت بسی","شخصی در وصف «سعد زنگی» (که رحمت خدا بر او باد) ثنایی سرود."],[96,"درم داد و تشریف و بنواختش","به مقدار خود منزلت ساختش","سعد زنگی به او سکه‌ها داد و او را عزیز داشت و به او مهربانی کرد."],[96,"چو الله و بس دید بر نقش زر","بشورید و برکند خلعت ز بر","وقتی که آن شخص نقش الله و بس (فقط خدا) را بر روی سکه‌ها دید شوریده شد و لباس‌های خلعت (را که به هدیه گرفته بود) کند."],[96,"ز سوزش چنان شعله در جان گرفت","که برجست و راه بیابان گرفت","از آن هیجان و شور چنان بی‌تاب شد که به‌سوی بیابان و خارج شهر گریخت."],[96,"یکی گفتش از همنشینان دشت","چه دیدی که حالت دگرگونه گشت","یکی از ساکنان دشت و صحرا از او پرسید که «چه‌شد که حال تو این‌چنین دگرگون شد؟»"],[96,"تو اول زمین بوسه دادی به جای","نبایستی آخر زدن پشت پای","تو اول به (سعد زنگی) احترام گذاشتی ( و او را ثنا گفتی) نباید اینچنین به او پشت می‌کردی و بی‌احترامی."],[96,"بخندید کاول ز بیم و امید","همی لرزه بر تن فتادم چو بید","خندید و پاسخ داد: من اول از بیم و امید (حاکم) مثل بید می‌لرزیدم."],[96,"به آخر ز تمکین الله و بس","نه چیزم به چشم اندر آمد نه کس","اما در آخر برای پیروی از فرمان «فقط خدا»، دیگران در چشمم ناچیز گشتند."],[96,"به شهری در از شام غوغا فتاد","گرفتند پیری مبارک نهاد","در سرزمین شام غوغا و آشوب به‌پا شد و پیرمردی نیک‌سیرت را به‌اسیری گرفتند."],[96,"هنوز آن حدیثم به گوش اندر است","چو قیدش نهادند بر پای و دست","سخن او را، وقتی که بر دست و پای او بند می‌زدند، هنوز فراموش نکرده‌ام که"],[96,"که گفت ار نه سلطان اشارت کند","که را زهره باشد که غارت کند؟","اگر دستور سلطان نیست، چه کسی جرأت دارد این‌کارها را انجام دهد و غارت کند؟"],[96,"بباید چنین دشمنی دوست داشت","که می‌دانمش دوست بر من گماشت","شایسته است که چنین دشمنی را که از طرف دوست مأمور شده، دوست‌داشته‌باشم."],[96,"اگر عز و جاه است و گر ذل و قید","من از حق شناسم، نه از عمرو و زید","اگر بزرگی و جاه و مقام است یا ذلت و خواری؛ من همه‌چیز را از حق و پروردگار می‌بینم نه از فلان و بهمان."],[96,"ز علت مدار، ای خردمند، بیم","چو داروی تلخت فرستد حکیم","ای آدم خردمند و دانا! از هیچ بیماری و دردی مترس و اندوهگین مباش وقتی‌که حکیم داروی آن‌را برای تو می‌فرستد."],[96,"بخور هرچه آید ز دست حبیب","نه بیمار داناتر است از طبیب","هرچه که از دست دوست به تو می‌رسد، بپذیر؛ زیرا حکیم از بیمار داناتر است."],[97,"یکی را چو من دل به دست کسی","گرو بود و می‌برد خواری بسی","من دلی دارم که به دست کسی سپرده‌ام و به این اعتبار، به خاطر او رنج و خفت زیادی را تحمل می‌کنم."],[97,"پس از هوشمندی و فرزانگی","به دف بر زدندش به دیوانگی","پس از اینکه او به کمال عقل و دانایی رسید، به خاطر عشق و شیفتگی‌اش، مانند یک دیوانه به شادی و رقص پرداخت."],[97,"ز دشمن جفا بردی از بهر دوست","که تریاک اکبر بود زهر دوست","به خاطر دوستی، از دشمن بدی‌ها و جفاها را تحمل کردی، زیرا محبت و دوستی همانند تریاک (ماده‌ای آرامبخش) است که می‌تواند زهر (آسیب و درد) را بهبود ببخشد."],[97,"قفا خوردی از دست یاران خویش","چو مسمار پیشانی آورده پیش","از یاران خود لطمه و زخم خوردی، به‌گونه‌ای که مانند مسماری در پیشانی، به تو آسیب رسانده‌اند."],[97,"خیالش چنان بر سر آشوب کرد","که بام دماغش لگدکوب کرد","خیال آن شخص چنان در دل و ذهن او شلوغ و آشفته شد که فشار زیادی بر فکر و عقلش آورد و او را به سختی دچار جناح و اضطراب کرد."],[97,"نبودش ز تشنیع یاران خبر","که غرقه ندارد ز باران خبر","او خبری از سرزنش و انتقاد دوستانش ندارد زیرا در عشق به گونه‌ای غرق شده که مانند کسی است که از باران بی‌خبر است."],[97,"کرا پای خاطر بر آمد به سنگ","نیندیشد از شیشه نام و ننگ","کسی که به خاطر خود و احساساتش تصمیم می‌گیرد، نباید نگران عیب‌جویی دیگران یا شهرت و اعتبار خود باشد."],[97,"شبی دیو خود را پریچهره ساخت","در آغوش آن مرد و بر وی بتاخت","شبی یک دیو خود را با ظاهری زیبا و چون پری آراست و به آغوش آن مرد رفت و بر او حمله‌ور شد."],[97,"سحرگه مجال نمازش نبود","ز یاران کس آگه ز رازش نبود","صبح زود، وقتی او می‌خواست نماز بخواند، نتوانست به دلیل اینکه هیچ‌یک از دوستانش خبر از راز و حال او نداشتند."],[97,"به آبی فرو رفت نزدیک بام","بر او بسته سرما دری از رخام","او به آب نزدیک بام رفت و سرما او را گرفت و در آنجا درب بسته‌ای از سنگ مرمر (رخام) وجود داشت."],[97,"نصیحتگری لومش آغاز کرد","که خود را بکشتی در این آب سرد","نصیحت‌گری شروع به سرزنش کرد که چرا خود را در این آب سرد غرق کردی."],[97,"ز برنای منصف بر آمد خروش","که ای یار چند از ملامت؟ خموش","از صدای منصف (قاضی عادل) ندا برخاست که ای دوست، برای چه اینقدر عیب‌جویی می‌کنی؟ سکوت کن."],[97,"مرا پنج روز این پسر دل فریفت","ز مهرش چنانم که نتوان شکیفت","این پسر به مدت پنج روز با محبت خود مرا فریب داده و مرا به حالتی گرفتار کرده که نمی‌توانم تحمل کنم."],[97,"نپرسید باری به خلق خوشم","ببین تا چه بارش به جان می‌کشم","از کسی نپرسیدم که به خاطر خوشی‌ام چه زحمتی را به جان می‌خرم."],[97,"پس آن را که شخصم ز خاک آفرید","به قدرت در او جان پاک آفرید","انسان که از خاک ساخته شده، نشان می‌دهد که خداوند با قدرت خود روحی پاک در او دمیده است."],[97,"عجب داری ار بار امرش برم","که دایم به احسان و فضلش درم؟","عجیب است اگر انتظار داشته باشی که من فرمان او را نپذیرم، در حالی که او دائما با احسان و لطفش به من نیکی می‌کند."],[98,"اگر مرد عشقی کم خویش گیر","و گر‌نه ره عافیت پیش‌ گیر","اگر در عشق نمی‌توانی خودت را کنترل کنی و از آن دوری نکن، بهتر است به دنبال راه آرامش و عافیت بروی."],[98,"مترس از محبت که خاکت کند","که باقی شوی گر هلاکت کند","از محبت نترس، زیرا اگرچه ممکن است به فنا و هلاکت برساند، اما همچنان می‌تواند تو را باقی و جاودان کند."],[98,"نروید نبات از حبوب درست","مگر حال بر وی بگردد نخست","نبات (گیاه) از دانه‌های خوب و سالم نمی‌روید مگر آنکه ابتدا دگرگون (موارد و شرایط لازم) شود."],[98,"تو را با حق آن آشنایی دهد","که از دست خویشت رهایی دهد","عشق و ارتباط با حقیقت (حق) به تو آگاهی می‌دهد که تو را از قید و بند خودت رها می‌کند."],[98,"که تا با خودی در خودت راه نیست","وز این نکته جز بی‌خود آگاه نیست","تا زمانی که با خودت در اعماق وجودت نمی‌تونی به حقیقت دسترسی پیدا کنی، تنها راهی که برای درک این نکته وجود دارد، فراموشی خودت و بی‌خود شدن است."],[98,"نه مطرب که آواز پای ستور","سماع است اگر عشق داری و شور","تنها نوازنده‌ای که صدای پای اسب را می‌نوازد، نیازی به سکوت ندارد؛ اگر تو عاشق هستی و شور در دل داری، گوش‌سپردن به این نوای سماع لازم است."],[98,"مگس پیش شوریده‌دل پر نزد","که او چون مگس دست بر سر نزد","مگس به سر شوریده‌دل نمی‌نشیند، زیرا او مانند مگس به دنبال چیزهای بی‌ارزش نمی‌گردد و هرگز دست به سر کسی نمی‌زند."],[98,"نه بم داند آشفته‌سامان نه زیر","به آواز مرغی بنالد فقیر","نه بم (ساز) می‌داند که چطور باید نواخت و نه کسی که در آشفته‌حالی‌اش است، زیر (در زیر) به آواز مرغی (به خاطر صدای مرغ) ناله می‌کند و غمگین می‌شود."],[98,"سراینده خود می‌نگردد خموش","ولیکن نه هر وقت باز است گوش","سخن‌سرای بزرگ هرگز به خود نمی‌پردازد و خاموش می‌ماند، اما این بدان معنا نیست که همیشه در هر زمان دیگران آماده شنیدن حرف او هستند."],[98,"چو شوریدگان می‌پرستی کنند","به آواز دولاب مستی کنند","چون عاشقان می‌نوشند و مستی می‌کنند، با صدای چرخ (دولاب) به وجد و شادی می‌آیند."],[98,"به چرخ اندر آیند دولاب‌وار","چو دولاب بر خود بگریند زار","سخن از حال انسان‌هایی است که در حال مستی و عشق به سر می‌برند و مثل دولاب می‌چرخند. وقتی به حالت مستی و شور می‌آیند، مانند دولاب به طرز غم‌انگیزی بر خود می‌چرخند و احساس می‌کنند که زانوی غم به سینه می‌زنند."],[98,"به تسلیم سر در گریبان برند","چو طاقت نماند گریبان درند","وقتی انسان از شدت عشق بی‌تاب می‌شود، به ناچار سرش را در گریبان خود می‌برد و به تسلیم تن می‌دهد، زیرا دیگر تاب تحمل ندارد و گریبانش را پاره می‌کند."],[98,"مکن عیب درویش مدهوش مست","که غرق است از آن می‌زند پا و دست","نقد و عیب‌جویی از درویش بی‌هوش و مست را نکن، چرا که او به خاطر حالت مستی‌اش به شدت غرق در عشق و حال است و پا و دستش نیز از شوق به حرکت درآمده است."],[98,"نگویم سماع ای برادر که چیست","مگر مستمع را بدانم که کیست","سماع (نواهای خاص) را نمی‌توانم تعریف کنم، ای برادر، مگر اینکه بدانم شنونده‌اش چه کسی است و چه حالتی دارد."],[98,"گر از برج معنی پرد طیر او","فرشته فرو ماند از سیر او","اگر از بلندی معانی عمیق او، فرشته‌ای هم از حرکت و سیر او بازبماند و نتواند به او برسد، این نشان‌دهنده عظمت و والایی اوست."],[98,"وگر مرد لهو است و بازی و لاغ","قوی‌تر شود دیوش اندر دماغ","اگر شخصی در جست‌و‌جوی لذت و تفریح باشد، قوی‌تر از شیاطین در ذهن او نفوذ می‌کنند و او را تحت تأثیر قرار می‌دهند."],[98,"چو مرد سماع است شهوت‌پرست","به آواز خوش خفته خیزد، نه مست","چون مردی که جذب سماع و موسیقی است، اگر از شهوت و تمایلات دنیوی پر باشد، به صدای خوش بیدار می‌شود، نه به خاطر مستی."],[98,"پریشان شود گل به باد سحر","نه هیزم که نشکافدش جز تبر","با وزش باد سحرگاهی، گل به هم می‌ریزد و پریشان می‌شود، اما هیزم (چوب) فشرده و محکم است و فقط تبر می‌تواند آن را بشکند."],[98,"جهان پر سماع است و مستی و شور","ولیکن چه بیند در آیینه کور؟","دنیا پر از شادی و نشاط و سرور است، اما انسان نابینا (کور) نمی‌تواند چیزی از این زیبایی‌ها را در آینه (نماد دیدن و شناخت) ببیند و درک کند."],[98,"نبینی شتر بر نوای عرب","که چونش به رقص اندر آرد طرب؟","شتر را در حال رقص و شادمانی به خاطر آهنگ عربی ببین که چگونه به وجد می‌آید و به رقص درمی‌آید."],[98,"شتر را چو شور طرب در سر است","اگر آدمی را نباشد خر است","اگر شتر را شور و هیجان خوشی در سر باشد، نشان‌دهنده این است که اگر انسانی آن شور و شوق را نداشته باشد، مانند شتری خواهد بود که بی‌فایده است."],[99,"شکر لب جوانی نی آموختی","که دلها در آتش چو نی سوختی","تو از جوانی، شیرینی و زیبایی را نچشیدی، زیرا دل‌ها همچون نی در آتش سوخته‌اند."],[99,"پدر بارها بانگ بر وی زدی","به تندی و آتش در آن نی زدی","تو بارها به پسر خود با تندی و خشم تذکر دادی، اما او همچنان به آتش عشق و جنون دچار بود و به حرف‌های تو بی‌توجه بود."],[99,"شبی بر ادای پسر گوش کرد","سماعش پریشان و مدهوش کرد","روزی پدر به صدای آواز پسر گوش داد و متوجه شد که صدای او به قدری شورانگیز و زیباست که حال خودش را پریشان و مدهوش کرده است."],[99,"همی گفت و بر چهره افکنده خوی","که آتش به من در زد این بار نی","او در حالی که مشغول صحبت بود، چهره‌اش را پوشانده بود و می‌گوید: این بار آتش عشق به قلبم نفوذ کرد."],[99,"ندانی که شوریده حالان مست","چرا بر فشانند در رقص دست؟","نمی‌دانی که چرا دیوانه‌ها و عاشقان مست در هنگام رقص با دست‌هایشان شادی و هیجان را به نمایش می‌گذارند؟"],[99,"گشاید دری بر دل از واردات","فشاند سر دست بر کاینات","چشمان عاشقان با دیدن معشوق، دری به روی دلشان باز می‌کند و دست خود را به خاطر شوق و عشق به آسمان (کاینات) بالا می‌برند."],[99,"حلالش بود رقص بر یاد دوست","که هر آستینیش جانی در اوست","رقص بر یاد دوست مجاز است، زیرا هر آستین او نمادی از زندگی و جان است."],[99,"گرفتم که مردانه‌ای در شنا","برهنه توانی زدن دست و پا","مردانه به این معنی است که با قدرت و شجاعت عمل کنی. شاعر می‌گوید در شنا می‌توانی با شجاعت و بدون لباس، آزادانه دست و پا بزنی."],[99,"بکن خرقه نام و ناموس و زرق","که عاجز بود مرد با جامه غرق","اگر کسی نتواند شنا کند، دیگر برایش فرقی نمی‌کند که لباس و نام و آبرو داشته باشد یا نه، زیرا در نهایت ناتوانی‌اش در شنا، به او آسیب خواهد زد."],[99,"تعلق حجاب است و بی حاصلی","چو پیوندها بگسلی واصلی","حجاب و پوشش، نشان‌دهنده وابستگی‌ها و بی‌فایده بودن آنهاست، همان‌طور که اگر پیوندها و ارتباطات را قطع کنی، به اصل و ریشه واقعی دست می‌زنی."],[100,"کسی گفت پروانه را کای حقیر","برو دوستی در خور خویش گیر","کسی به پروانه گفت: ای بی‌ارزش، بهتر است که با کسی دوست شوی که با وضعیت تو مناسب باشد."],[100,"رهی رو که بینی طریق رجا","تو و مهر شمع از کجا تا کجا؟","اگر در مسیری هستی که امید و آرزو به آن راه می‌بری، باید بدان که عشق به شمع (یعنی معشوق) از کجا آغاز می‌شود و به کجا می‌رسد."],[100,"سمندر نه‌ای گرد آتش مگرد","که مردانگی باید آنگه نبرد","اگر تو سمندر نیستی، دور آتش نگرد؛ چرا که شجاعت واقعی زمانی معنا دارد که انسان در دل نبرد باشد."],[100,"ز خورشید پنهان شود موش کور","که جهل است با آهنین پنجه زور","موش کور از خورشید پنهان می‌شود، زیرا جهل او به مانند پنجه‌ای آهنین است که او را به سمت زور و قدرت هدایت نمی‌کند."],[100,"کسی را که دانی که خصم تو اوست","نه از عقل باشد گرفتن به دوست","اگر می‌دانی که شخصی دشمن توست، به احمقانه‌ترین شکل ممکن است که او را دوست بخوانی و به او نزدیک شوی."],[100,"تو را کس نگوید نکو می‌کنی","که جان در سر کار او می‌کنی","هیچ‌کس به تو نمی‌گوید که چه کار خوبی می‌کنی، زیرا جانت را در راه عشق او گذاشته‌ای."],[100,"گدایی که از پادشه خواست دخت","قفا خورد و سودای بیهوده پخت","گدایانی که از پادشاه چیزی می‌خواهند، مانند دختری که در قفا (نزدیک) اوست، به دنبال آرزویی بیهوده هستند و در حقیقت، چیزی غیرممکن را می‌طلبند."],[100,"کجا در حساب آرد او چون تو دوست","که روی ملوک و سلاطین در اوست؟","چگونه او که در مقام دوستی با تو است، می‌تواند حساب کند در حالی که چهره پادشاهان و سرورها در او وجود دارد؟"],[100,"مپندار کاو در چنان مجلسی","مدارا کند با چو تو مفلسی","نپندار که او در چنین مهمانی با کسی چون تو که در فقر و مسکنت هستی، با نرمی و محبت رفتار کند."],[100,"وگر با همه خلق نرمی کند","تو بیچاره‌ای با تو گرمی کند","اگر کسی با همه مردم نرم و ملایم باشد، ولی تو به خاطر وضعیتی که داری، بیچاره و ناتوان باشی، تنها او به تو محبت و گرمی ندارد."],[100,"نگه کن که پروانه سوزناک","چه گفت، ای عجب گر بسوزم چه باک؟","پروانه‌ای که به شدت در عشق سوخته است می‌گوید: ای شگفتی! اگر بسوزم، چه اهمیتی دارد؟"],[100,"مرا چون خلیل آتشی در دل است","که پنداری این شعله بر من گل است","من در دل خود آتش شدیدی دارم، چون ابراهیم خلیل (که در آتش سوزانده شد)، و این شعله در نظر تو شاید همان گل زیبایی باشد."],[100,"نه دل دامن دلستان می‌کشد","که مهرش گریبان جان می‌کشد","دل نمی‌تواند از عشق محبوبه‌اش دل بکند، زیرا عشق او جانش را می‌کشد و رهایش نمی‌کند."],[100,"نه خود را بر آتش به خود می‌زنم","که زنجیر شوق است در گردنم","من نمی‌توانم خودم را به آتش بزنم، چرا که شوق و عشق، مانند زنجیری بر گردنم آویخته شده و من را درگیر کرده است."],[100,"مرا همچنان دور بودم که سوخت","نه این دم که آتش به من در فروخت","دوری و غم عشق چنان بر من غلبه کرده که حتی زمان سوختن و آتش گرفتن من را نمی‌بیند. در واقع، من هنوز در حس دوری از محبوب هستم و از اینکه این آتش در جانم شعله‌ور شده، آگاهی ندارم."],[100,"نه آن می‌کند یار در شاهدی","که با او توان گفتن از زاهدی","یار در حضور معشوق هرگز کاری نمی‌کند که زاهد از بدعت‌ها و رفتارهای نابخردانه بگوید، زیرا او خود را کاملا در عشق غرق کرده است و توجهی به این مسایل ندارد."],[100,"که عیبم کند بر تولای دوست؟","که من راضیم کشته در پای دوست","اگر کسی به من ایراد بگیرد که چرا به دوست خود عشق می‌ورزم، چرا که من راضی هستم حتی اگر جانم را در راه او فدا کنم."],[100,"مرا بر تلف حرص دانی چراست؟","چو او هست اگر من نباشم رواست","چرا باید به خاطر حرص و طمع خودم هلاک شوم؟ اگر او وجود دارد و من نیستم، این امر برای من مجاز است."],[100,"بسوزم که یار پسندیده اوست","که در وی سرایت کند سوز دوست","من از شدت عشق و محبت می‌سوزم، زیرا محبوب من کسی است که در وجودش اشتیاق و محبت را احساس می‌کنم."],[100,"مرا چند گویی که در خورد خویش","حریفی به دست آر همدرد خویش","چرا مدام به من می‌گویی که برای رفع تنهایی‌ام باید رفیق و همدردی پیدا کنم؟"],[100,"بدان ماند اندرز شوریده حال","که گویی به کژدم گزیده منال","نصیحت کردن فردی که بسیار پریشان و مجنون است، همچون سخن گفتن با کژدمی است که گزیده و به کسی نمی‌تند."],[100,"کسی را نصیحت مگو ای شگفت","که دانی که در وی نخواهد گرفت","کسی را که در حالت عشق و شور است، نصیحت نکن ای شگفت‌زده، زیرا می‌دانی که او هیچ‌گاه به این نصیحت توجه نخواهد کرد."],[100,"ز کف رفته بیچاره‌ای را لگام","نگویند کآهسته ران ای غلام","بیچاره‌ای که همه چیزش را از دست داده، نمی‌توان او را به آرامی راند و به او دستور داد که با احتیاط حرکت کند."],[100,"چه نغز آمد این نکته در سندباد","که عشق آتش است ای پسر پند، باد","این نکته جالبی از سندباد نقل شده که عشق مانند آتش است، پسرم، این را خوب درک کن."],[100,"به باد آتش تیز برتر شود","پلنگ از زدن کینه ور تر شود","در اثر عشق، آتش عشق قوی‌تر از خشم و کینه است، زیرا پلنگ (نماد قدرت و خطر) نیز از یادآوری کینه و دشمنی زودتر تحت تأثیر عشق قرار می‌گیرد."],[100,"چو نیکت بدیدم بدی می‌کنی","که رویم فرا چون خودی می‌کنی","وقتی که تو را خوب می‌بینم، بدی می‌کنی و رفتار زشتی از خود نشان می‌دهی، به طوری که به رویم پشت می‌کنی و مثل کسی رفتار می‌کنی که در نظر من بی‌ارزش است."],[100,"ز خود بهتری جوی و فرصت شمار","که با چون خودی گم کنی روزگار","از خود بهتر را پیدا کن و به فرصت‌ها توجه کن؛ چرا که در کنار افرادی مثل خودت، وقت و عمرت را هدر می‌دهی."],[100,"پی چون خودی خودپرستان روند","به کوی خطرناک مستان روند","آدم‌های خودمحور و خودپرست، به جای آنکه به دنبال افراد بهتر بروند، به سوی جمع خطرناک و پر از هیجان مستان (عاشقان و مست‌ها) می‌روند."],[100,"من اول که این کار سر داشتم","دل از سر به یک بار برداشتم","در آغاز که وارد عشق شدم، یک‌باره دل را از سرم جدا کردم و تمامی وجودم را به آن عشق سپردم."],[100,"سر انداز در عاشقی صادق است","که بدزهره بر خویشتن عاشق است","عاشق واقعی کسی است که جان خود را در راه عشق می‌دهد و در این راه، زهر تلخ عشق را با جان و دل بر خود می‌خرد."],[100,"اجل ناگهی در کمینم کشد","همان به که آن نازنینم کشد","مرگ ناگهانی در کمین من است و بهتر این است که آن معشوق نازنین من مرا به قتل برساند."],[100,"چو بی شک نبشته‌ست بر سر هلاک","به دست دلارام خوشتر هلاک","هرچند که سرنوشت به طور حتم برای من نوشته شده است، اما اگر قرار است به دست معشوق خود یعنی دلارام بمیرم، این مرگ برای من شیرین‌تر است."],[100,"نه روزی به بیچارگی جان دهی؟","همان به که در پای جانان دهی","آیا نمی‌توانی روزی زندگی‌ات را در رنج و بیچارگی بگذرانی؟ بهتر است آن را در پای محبوب (جانان) فدای کنی."],[101,"شبی یاد دارم که چشمم نخفت","شنیدم که پروانه با شمع گفت","به یاد دارم که یک شب خوابم نمی‌برد و گفت‌گوی پروانه را با شمع شنیدم."],[101,"که من عاشقم گر بسوزم رواست","تو را گریه و سوز باری چراست؟","که من عاشق هستم و گریه و غم یک عاشق چیزی عادی است؛ اما تو که عاشق نیستی تو چرا گریه و زاری می‌کنی؟"],[101,"بگفت ای هوادار مسکین من","برفت انگبین یار شیرین من","شمع به او گفت‌: ای دوست دردمند من، من یار شیرین خود را از دست داده‌ام.( منظور موم شمع است که از عسل و یار خود جدا گشته است)"],[101,"چو شیرینی از من به در می‌رود","چو فرهادم آتش به سر می‌رود","وقتی که از یار خود، شیرین جدا گشته‌ام پس همچون فرهاد، آتش‌به‌سر و دردمند می‌شوم."],[101,"همی گفت و هر لحظه سیلاب درد","فرو می‌دویدش به رخسار زرد","این‌ها را می‌گفت و هر دم بیشتر و بیشتر گریه می‌کرد و سیل اشک بر روی زرد او می‌دوید."],[101,"که ای مدعی عشق کار تو نیست","که نه صبر داری نه یارای ایست","(و با زبان حال خود می‌گفت) که ای مدعی‌ عاشق بودن، عشق کار تو نیست؛ تویی که صبر و پایداری نداری."],[101,"تو بگریزی از پیش یک شعله خام","من استاده‌ام تا بسوزم تمام","تو از پیش یک ذره درد و سوختن می‌گریزی، من ایستاده‌ام تا از سر تا پای بسوزم."],[101,"تو را آتش عشق اگر پر بسوخت","مرا بین که از پای تا سر بسوخت","اگر گرما و آتش عشق‌، بال تو را سوخت؛ مرا ببین که از پا تا سر بسوخت."],[101,"همه شب در این گفت و گو بود شمع","به دیدار او وقت اصحاب، جمع","شمع، تمام شب را در این گفتگو سپری کرد و سوخت و از نور او‌، وقت اصحاب جمع بود. (وقت‌، اصحاب‌ و جمع از اصطلاحات صوفیه نیز هست)"],[101,"نرفته ز شب همچنان بهره‌ای","که ناگه بکشتش پریچهره‌ای","بهره‌ای از شب نگذشته بود که زیبارویی او را خاموش کرد."],[101,"همی گفت و می‌رفت دودش به سر","که این است پایان عشق، ای پسر","این را می‌گفت و دود بر سر او ‌می‌رفت که این است پایان عشق ای پسر!"],[101,"اگر عاشقی خواهی آموختن","به کشتن فرج یابی از سوختن","اگر می‌خواهی عاشقی و عشق را بیاموزی باید بدانی که با کشته‌شدن از سوختن، رهایی می‌یابی."],[101,"مکن گریه بر گور مقتول دوست","برو خرمی کن که مقبول اوست","برای کشته‌شده راه عشق گریه مکن بلکه برای او شادی کن زیرا او شادی را می‌پسندد."],[101,"اگر عاشقی سر مشوی از مرض","چو سعدی فرو شوی دست از غرض","اگر عاشق هستی، خود را از بلا دور مگردان و همچون سعدی دست از غرض و خواست بردار. (غرض در اینجا گویا منظور خودخواهی باشد)"],[101,"فدایی ندارد ز مقصود چنگ","و گر بر سرش تیر بارند و سنگ","فداشده عشق از معشوق دست بر نمی‌دارد حتی اگر بر سر او هزار بلا و تیر و سنگ ببارد."],[101,"به دریا مرو گفتمت زینهار","وگر می‌روی تن به طوفان سپار","به تو هشدار داده‌بودم که به دریا نروی‌؛ اگر رفتی آماده روبرو شدن با خطرات و طوفان باش."],[102,"ز خاک آفریدت خداوند پاک","پس ای بنده افتادگی کن چو خاک","خداوند تو را از خاک آفریده است، پس ای بنده، باید humble و متواضع باشی مانند خاک."],[102,"حریص و جهان سوز و سرکش مباش","ز خاک آفریدندت آتش مباش","حریص و طلبکار و پرخاشگر نباش؛ زیرا تو از خاک آفریده شده‌ای، نباید همچون آتش، ویران‌گر و destructively بزی."],[102,"چو گردن کشید آتش هولناک","به بیچارگی تن بینداخت خاک","وقتی آتش هولناک سرکشی می‌کند، بدن ضعیف و درمانده را به خاک می‌اندازد."],[102,"چو آن سرفرازی نمود، این کمی","از آن دیو کردند، از این آدمی","وقتی که آن شجاعت و عظمت را نشان داد، این ضعف و پستی از آن دیو (عناصر منفی) در درون آدمی به وجود آمد."],[103,"یکی قطره باران ز ابری چکید","خجل شد چو پهنای دریا بدید","قطره‌ای باران از ابری بر دریا فرو افتاد؛ وقتی‌که آن قطره عظمت و بزرگی دریا را دید (از حقارت و کوچکی خود) شرمنده شد."],[103,"که جایی که دریاست من کیستم؟","گر او هست حقا که من نیستم","با خود گفت: در برابر دریا من کی هستم؟ اگر او هست من اصلا وجود ندارم"],[103,"چو خود را به چشم حقارت بدید","صدف در کنارش به جان پرورید","وقتی که حقارت و کوچکی خود را دید آنگاه صدف او را در آغوش گرفت و پرورد."],[103,"سپهرش به جایی رسانید کار","که شد نامور لؤلؤ شاهوار","دست تقدیر سرانجام او را به جایی رساند که تبدیل به یک مروارید بسیار گرانبها و یگانه شد."],[103,"بلندی از آن یافت کاو پست شد","در نیستی کوفت تا هست شد","آن مقامی که به او رسید دلیلش افتادگی و تواضع بود و آن چه که وجود نداشت را تلاش کرد و با امیدش به آن رسید"],[103,"تواضع کند هوشمند گزین","نهد شاخ پر میوه سر بر زمین","آدم هوشمند شایسته تواضع و فروتنی را انتخاب می‌کند؛ شاخه‌های پربار میوه سر بر زمین خم می‌کنند."],[104,"جوانی خردمند پاکیزه‌بوم","ز دریا بر آمد به دربند روم","جوانی دانا و پاک‌سرشت از راه دریا به شهر دربند روم آمد. (دربند نام شهری است بندری که در قدیم آن را ایران‌دژ و باب‌الابواب نیز می‌نامیده‌اند)"],[104,"در او فضل دیدند و فقر و تمیز","نهادند رختش به جایی عزیز","در آن‌جوان فضل و هنر و دین و خرد دیدند و او را محترم داشته و در جایی نیکو نشاندند."],[104,"سر صالحان گفت روزی به مرد","که خاشاک مسجد بیفشان و گرد","روزی سر صالحان (یا پیش‌نماز مسجد) به او گفت که مسجد را جارو و غبارگیری کن."],[104,"همان کاین سخن مرد رهرو شنید","برون رفت و بازش کس آنجا ندید","همین‌که آن مرید، این را شنید آنجا را ترک کرد و هیچ‌کس دوباره او را در آنجا ندید. (رهرو هم به‌معنی مسافر است و هم مرید)"],[104,"بر آن حمل کردند یاران و پیر","که پروای خدمت نبودش فقیر","آن دوستان و یاران چنین تصور کردند که آن‌درویش قصد خدمت نداشت و به خدمت، اهمیت نمی‌داد."],[104,"دگر روز خادم گرفتش به راه","که «‌ناخوب کردی به رای تباه","روزی خادم آن مسجد، در راه او را دید و به‌او گفت: که با آن تصمیم غلط، کار نادرستی کردی."],[104,"ندانستی ای کودک خودپسند‌؟","که مردان ز خدمت به جایی رسند‌؟‌»","ای بچه مغرور، تو یاد نگرفته‌ای که آدم‌های بزرگ از خدمت به جایی رسیده‌اند؟"],[104,"گرستن گرفت از سر صدق و سوز","که ‌«ای یار جان‌پرور دلفروز","آن‌جوان از روی راستی گریست و گفت ‌«ای دوست عزیز و با‌محبت!"],[104,"نه گرد اندر آن بقعه دیدم‌، نه خاک","من آلوده بودم در آن جای پاک","در آن بقعه که بودم گرد و غبار و خاک ندیدم‌، تنها چیز آلوده در آن مکان پاک، من بودم."],[104,"گرفتم قدم لاجرم باز پس","که پاکیزه به مسجد از خاک و خس‌»","پس از آنجا رفتم زیرا مسجد از خاک و خاشاک، پاکیزه‌گردد بهتر است.‌»"],[104,"طریقت جز این نیست درویش را","که افکنده دارد تن خویش را","طریقت درویش راستین جز این نیست که خود را متواضع و فروتن نگه‌دارد."],[104,"بلندیت باید‌، تواضع گزین","که آن بام را نیست سلّم جز این","اگر بلندی و عزّت می‌خواهی باید راه تواضع در پیش بگیری که این بام جز این، نردبانی ندارد."],[105,"شنیدم که وقتی سحرگاه عید","ز گرمابه آمد برون بایزید","شنیده‌ام که در بامداد روز عیدی، بایزید بسطامی (عارف بزرگ) از حمام بیرون آمد."],[105,"یکی تشت خاکسترش بی‌خبر","فرو ریختند از سرایی به سر","ناگهان و بی‌خبر، از بام خانه‌ای تشتی پر از خاکستر بر سر و روی او خالی کردند."],[105,"همی‌گفت شولیده دستار و موی","کف دست شکرانه مالان به روی","در حالی که دستار (عمامه) و موهایش خاکسترین و آشفته شده بود، با خرسندی دست شکرگزاری بر چهره می‌کشید و می‌گفت:"],[105,"که ای نفس من در خور آتشم","به خاکستری روی در هم کشم؟","ای نفس سرکش من! من که سزاوار آتش دوزخم، آیا شایسته است که برای فروریختن اندکی خاکستر بر سرم، چهره در هم بکشم و خشمگین شوم؟"],[105,"بزرگان نکردند در خود نگاه","خدابینی از خویشتن بین مخواه","بزرگان و اولیای خدا هرگز به دیده خودپسندی به خود ننگریستند؛ از انسانی که خودبین و گرفتار کبر است، انتظار شناخت و دیدن حقیقت خدا را نداشته باش."],[105,"بزرگی به ناموس و گفتار نیست","بلندی به دعوی و پندار نیست","بزرگی واقعی با لاف‌زدن، نام و آوازه به دست نمی‌آید؛ والامقامی با ادعا و خیال‌بافی تحقق پیدا نمی‌کند."],[105,"تواضع سر رفعت افرازدت","تکبر به خاک اندر اندازدت","فروتنی و خاکساری، مقام تو را ارجمند و رفیع می‌سازد، در حالی که کبر و غرور، تو را به خاک مذلت می‌اندازد."],[105,"به گردن فتد سرکش تند خوی","بلندیت باید‌، بلندی مجوی","انسان سرکش و تندخو سرانجام زمین‌گیر و سرنگون می‌شود؛ اگر در پی بلندی مقام و مرتبتی، در پی فخرفروشی و برتری‌طلبی بر دیگران مباش."],[105,"ز مغرور دنیا ره دین مجوی","خدابینی از خویشتن بین مجوی","از کسی که فریفته دنیا و جاه‌طلب است انتظار دین‌داری و راهنمایی مذهب نداشته باش؛ و از شخص مغرور و خودپسند نشانه‌ای از خداشناسی طلب نکن."],[105,"گرت جاه باید مکن چون خسان","به چشم حقارت نگه در کسان","اگر در پی بزرگی و منزلت هستی، مانند انسان‌های پست و فرومایه به دیگران با دیده تحقیر و کوچکی نگاه مکن."],[105,"گمان کی برد مردم هوشمند","که در سرگرانی است قدر بلند؟","انسان خردمند و دانا هرگز گمان نمی‌برد که ارزش و منزلت والا در باد غرور داشتن و گردن‌کشی (سرگرانی) نهفته است."],[105,"از این نامورتر محلی مجوی","که خوانند خلقت پسندیده خوی","جایگاهی نیکوتر و مشهورتر از این طلب مکن که مردمان تو را انسانی خوش‌خلق و دارای سرشتی پسندیده بدانند."],[105,"نه گر چون تویی بر تو کبر آورد","بزرگش نبینی به چشم خرد؟","مگر نه این است که اگر شخصی هم‌تراز خودت در برابرت کبر بفروشد، با عقل خود او را کوچک، حقیر و نادان می‌شماری؟"],[105,"تو نیز ار تکبر کنی همچنان","نمایی، که پیشت تکبر کنان","پس اگر تو هم غرور بورزی، در چشم دیگران دقیقا به همان اندازه ناپسند و خوار جلوه می‌کنی که متکبران در نظر تو جلوه می‌کنند."],[105,"چو استاده‌ای بر مقامی بلند","بر افتاده گر هوشمندی مخند","اگر در جایگاه و مقامی والا قرار داری، چنانچه انسان عاقل و فهمیده‌ای هستی، بر کسی که شکست خورده یا فرو افتاده تمسخر مکن."],[105,"بسا ایستاده در آمد ز پای","که افتادگانش گرفتند جای","چه بسیار قدرتمندان پایداری که سقوط کردند و از پای درآمدند، و همان افتادگان و بی‌پناهان روزگار جایگاه آنان را گرفتند."],[105,"گرفتم که خود هستی از عیب پاک","تعنت مکن بر من عیب‌ناک","اصلا فرض کنیم که تو خود بی‌عیب و پاکیزه‌ای؛ باز هم حق نداری بر من که عیب‌دار و خطاکارم سرزنش و خرده‌گیری کنی."],[105,"یکی حلقه کعبه دارد به دست","یکی در خراباتی افتاده مست","یکی دست در حلقه کعبه زده و عبادت می‌کند، و دیگری مست در خرابه‌ای از پای افتاده است (حالات ظاهری بندگان دگرگون است)."],[105,"گر آن را بخواند، که نگذاردش؟","ور این را براند، که باز آردش؟","اگر خداوند به لطف خود آن فرد گناهکار را بپذیرد، چه کسی مانع او می‌شود؟ و اگر آن زاهد حلقه بر دست را از درگاهش براند، چه کسی توان بازگرداندن او را دارد؟"],[105,"نه مستظهر است آن به اعمال خویش","نه این را در توبه بسته‌ست پیش","نه آن پارسا و عابد می‌تواند به طاعات خود مغرور و دلگرم باشد، و نه درهای توبه و رحمت حق به روی این گناهکار بسته است."],[106,"شنیدستم از راویان کلام","که در عهد عیسی علیه‌السلام","امید شنیده‌ام از راویان روایت که در زمان حضرت عیسی (ع) اتفاقی افتاده است."],[106,"یکی زندگانی تلف کرده بود","به جهل و ضلالت سر آورده بود","شخصی عمر خود را در نادانی و گمراهی سپری کرده بود."],[106,"دلیری سیه نامه‌ای سخت دل","ز ناپاکی ابلیس در وی خجل","تنفر و بدنامی (سیه‌نامه) دل او، به خاطر ناپاکی و گناهانی است که از ابلیس (شیطان) در او وجود دارد و این باعث خجالت او شده است."],[106,"به سر برده ایام، بی حاصلی","نیاسوده تا بوده از وی دلی","زندگی‌اش را بدون نتیجه سپری کرده است و هرگز آرامش نداشته، چون همیشه دلش از گناهان و ناپاکی‌ها رنج می‌برده است."],[106,"سرش خالی از عقل و از احتشام","شکم فربه از لقمه‌های حرام","سر او پر از جهل و بی‌عرضگی است و از نظر اجتماعی هم به جایگاهی نرسیده، اما شکمش از غذاهای حرام پر شده است."],[106,"به ناراستی دامن آلوده‌ای","به ناداشتی دوده اندوده‌ای","تو به بی‌راستی دامن خود را آلوده کرده‌ای و به نادانی، چهره‌ات را سیاه کرده‌ای."],[106,"نه چشمی چو بینندگان راست رو","نه گوشی چو مردم نصیحت شنو","هیچ کسی مانند بینندگان درست و راستگو نیست و هیچ گوشی مانند گوش‌های مردم که نصیحت را می‌شنوند نیست."],[106,"چو سال بد از وی خلایق نفور","نمایان به هم چون مه نو ز دور","وقتی سال بدی پیش بیاید، مردم از او دوری می‌کنند و نفرتشان را نشان می‌دهند، همان‌طور که ماه نو در دور دست قابل رؤیت نیست."],[106,"هوی و هوس خرمنش سوخته","جوی نیکنامی نیندوخته","آرزوها و خواسته‌های ناپسند او باعث تباهی زندگی‌اش شده و با وجود این، در پی کسب نام و اعتبار نیکو نیست."],[106,"سیه نامه چندان تنعم براند","که در نامه جای نبشتن نماند","زندگی پر از خوشی و لذت برخی افراد به حدی است که در نامه اعمالشان، جایی برای نوشتن کارهای نیک و خوب باقی نمی‌گذارد و تنها بدی‌ها و گناهان آنها ثبت می‌شود."],[106,"گنهکار و خودرای و شهوت پرست","به غفلت شب و روز مخمور و مست","گنهکار، خودخواه و کسانی که پیرو خواسته‌های نفسانی خود هستند، در بی‌خبری و غفلت از روز و شب، مانند کسانی که مست و خوش‌گذران‌اند، به سر می‌برند."],[106,"شنیدم که عیسی در آمد ز دشت","به مقصوره عابدی برگذشت","شنیدم که عیسی (ع) به دشت آمد و از کنار عابدی که در معبد نشسته بود، عبور کرد."],[106,"به زیر آمد از غرفه خلوت نشین","به پایش در افتاد سر بر زمین","عیسی (ع) به کنار عابد آمد و آن عابد به خاطر عظمت او به زمین افتاد و سرش را بر زمین گذاشت."],[106,"گنهکار برگشته اختر ز دور","چو پروانه حیران در ایشان ز نور","گنهکاری که به سوی خوبی‌ها بازگشته، مانند پروانه‌ای است که در میان نور حیران است و نمی‌داند کدام مسیر را انتخاب کند."],[106,"تأمل به حسرت کنان شرمسار","چو درویش در دست سرمایه‌دار","انسانی که با حسرت و تأمل به زندگی نگاه می‌کند، مانند درویشی است که در برابر ثروتمند شرمنده و ناتوان از داشتن ثروت است."],[106,"خجل زیر لب عذرخواهان به سوز","ز شبهای در غفلت آورده روز","عذرخواهی کسی که شرمنده است، به خاطر درد و رنجی که از شب‌های غفلت خود با روزهای ناامیدی به بار آورده، به طور پنهانی بیان می‌شود."],[106,"سرشک غم از دیده باران چو میغ","که عمرم به غفلت گذشت ای دریغ!","از چشمانم اشک غم مانند باران می‌ریزد، و افسوس می‌خورم که عمرم بدون بهره‌برداری در غفلت سپری شد."],[106,"بر انداختم نقد عمر عزیز","به دست از نکویی نیاورده چیز","عمر باارزشم را به باد دادم و در این مدت هیچ کار خوبی انجام ندادم."],[106,"چو من زنده هرگز مبادا کسی","که مرگش به از زندگانی بسی","هرگز نباید کسی زنده باشد که مرگش بهتر از زندگی‌اش باشد."],[106,"برست آن که در عهد طفلی بمرد","که پیرانه سر شرمساری نبرد","کسی که در دوران کودکی بمیرد، از شرمندگی در پیری مصون است و دیگر با مشکلات و دردسرهای زندگی مواجه نخواهد شد."],[106,"گناهم ببخش ای جهان آفرین","که گر با من آید فبئس القرین","ای خالق جهان، گناهان مرا ببخش، چون اگر با من جمع شود، بدترین هم نشین خواهد بود."],[106,"نگون مانده از شرمساری سرش","روان آب حسرت به شیب و برش","این شخص به خاطر شرمساری و ندامت از گناهانش، سرش پایین است و از شدت حسرتی که به دل دارد، اشک می‌ریزد."],[106,"در این گوشه نالان گنهکار پیر","که فریاد حالم رس ای دستگیر","در این گوشه، گنهکار سالخورده‌ای با ناراحتی و ناله از حال خود می‌گوید و از خدایی که دستگیر او باشد، یاری می‌طلبد."],[106,"وز آن نیمه عابد سری پر غرور","ترش کرده بر فاسق ابرو ز دور","نیمه عابدی که خود را بسیار مغرور می‌دانست، به خاطر حالت زشت و ناپسند یک فرد فاسق، ابرویش را به حالت نارضایتی بالا برده است."],[106,"که این مدبر اندر پی ما چراست؟","نگون بخت جاهل چه در خورد ماست؟","چرا این تدبیرکننده (عیسی(ع)) در پی ماست؟ جاهل بدبخت چه مرتبطی به ما دارد؟"],[106,"به گردن در آتش در افتاده‌ای","به باد هوی عمر بر داده‌ای","تو هم‌اکنون در آتش عذاب گرفتار شده‌ای و عمر خود را به بیهودگی و دلواهی گذرانده‌ای."],[106,"چه خیر آمد از نفس تر دامنش","که صحبت بود با مسیح و منش؟","چگونه نفعی از نفس تازه و پالایش‌نشده او حاصل شد وقتی که سخن‌گویی با عیسی (ع) هم داشت؟"],[106,"چه بودی که زحمت ببردی ز پیش","به دوزخ برفتی پس کار خویش","چه چیزی باعث شد که تو از دنیا رخت بربندی و زحمت‌هایت را به آتش دوزخ ببری؟"],[106,"همی رنجم از طلعت ناخوشش","مبادا که در من فتد آتشش","نگرانم که زیبایی چهره ناخوشایند او باعث آتش‌سوزی در درون من نشود، یعنی احساسات من را به هم نریزد."],[106,"به محشر که حاضر شوند انجمن","خدایا تو با او مکن حشر من","در روز قیامت که همه افراد جمع می‌شوند، ای خدا، مرا در جمع آن شخص نیاور و با او محشور نکن."],[106,"در این بود و وحی از جلیل الصفات","در آمد به عیسی علیه الصلوة","و در این حال، وحی از جانب خداوند بزرگ به عیسی (ع) نازل شد."],[106,"که گر عالم است این و گر وی جهول","مرا دعوت هر دو آمد قبول","صرف‌نظر از اینکه آیا آن عابد دانشمند است یا نادان، دعوت او را برای خود پذیرفتم."],[106,"تبه کرده ایام برگشته روز","بنالید بر من به زاری و سوز","زمان‌های پررویداد را به هدر داده‌ام و اکنون که روزگار گذشته و تغییر کرده است، به زاری و درد به تو شکایت می‌کنم."],[106,"به بیچارگی هر که آمد برم","نیندازمش ز آستان کرم","هر کسی که با ناله و درماندگی به درگاه من آمد، او را از در رحمت خود طرد نمی‌کنم و به او توجه می‌کنم."],[106,"عفو کردم از وی عملهای زشت","به انعام خویش آرمش در بهشت","من از ناپاکی‌ها و کارهای زشت او گذشتم و به خاطر بخشش و بزرگواری‌ام، او را به بهشت می‌برم."],[106,"و گر عار دارد عبادت پرست","که در خلد با وی بود هم نشست","اگر فردی از عبادت خود احساس ننگ کند، به این دلیل که در بهشت نیز با کسی که اهل معصیت است، نشسته، این ننگ از او برطرف نخواهد شد."],[106,"بگو ننگ از او در قیامت مدار","که آن را به جنت برند این به نار","در قیامت از ننگ و عار زشتی نداشته باش، زیرا کسی که به خاطر عبادت و دینداریش به بهشت می‌رود، دیگر در آتش دوزخ نخواهد بود."],[106,"که آن را جگر خون شد از سوز و درد","گر این تکیه بر طاعت خویش کرد","کسی که از شدت غم و درد دچار رنج و ناله شده است، اگر بر عبادت خود و تکیه بر آن اصرار ورزد، به جایی نخواهد رسید."],[106,"ندانست در بارگاه غنی","که بیچارگی به ز کبر و منی","او در درگاه خداوندی غنی، نمی‌دانست که فقر و نادانی انسان از غرور و خودبزرگ‌بینی نشأت می‌گیرد."],[106,"کرا جامه پاک است و سیرت پلید","در دوزخش را نباید کلید","انسانی که ظاهرا لباس پاک و مناسبی دارد اما درونش آلوده و ناپاک است، مستحق ورود به بهشت نیست و نباید امیدی به آنجا داشته باشد."],[106,"بر این آستان عجز و مسکینیت","به از طاعت و خویشتن بینیت","در این بیت، سعدی می‌گوید که بهتر است انسان خود را در حال نیاز و حقارت و عجز در برابر خداوند ببیند تا اینکه بر طاعت و اعمال نیک خود مغرور باشد."],[106,"چو خود را ز نیکان شمردی، بدی","نمی‌گنجد اندر خدایی خودی","اگر خود را از نیکان به حساب بیاوری، نمی‌توانی بدی‌ها را در وجود خداوند، یا در کمالات خودت، جا بدهی."],[106,"اگر مردی از مردی خود مگوی","نه هر شهسواری به در برد گوی","اگر تو خود را از دیگران برتر نمی‌دانی، نباید خود را به دیگران معرفی کنی؛ زیرا فقط به این دلیل که کسی مقام و ثروتی دارد، نمی‌تواند خود را سزاوار تعریف و تحسین بداند."],[106,"پیاز آمد آن بی هنر جمله پوست","که پنداشت چون پسته مغزی در اوست","پیاز به دلیل نداشتن هنر و ارزش واقعی فقط پوشش خارجی دارد و مانند پسته که درونش مغز خوشمزه‌ای است، او نیز این تصور را دارد که مثل پسته ارزشمند است. در واقع، این بیت به کم‌ارزشی ظاهری اشاره دارد که فاقد محتوا و معنی درون است."],[106,"از این نوع طاعت نیاید به کار","برو عذر تقصیر طاعت بیار","از این نوع عبادت و طاعتی که به درد نمی‌خورد، هیچ فایده‌ای به دست نمی‌آید؛ به همین دلیل، بهتر است عذر و بهانه‌ای برای کارهای ناپسند خود بیاوری."],[106,"چه رند پریشان شوریده بخت","چه زاهد که بر خود کند کار سخت","این بیت به نقد افرادی می‌پردازد که در ظاهر عابد و زاهد به نظر می‌رسند، اما در دل حالتی پریشان و درونی آشفته دارند. اشاره به آن است که حتی زاهدان نیز ممکن است مشکلات روحی و بخت بد داشته باشند و به همین دلیل صرفا انجام عبادت و زهد نمی‌تواند نشان‌دهنده‌ی درست‌کاری آن‌ها باشد."],[106,"به زهد و ورع کوش و صدق و صفا","ولیکن میفزای بر مصطفی","در راستای زهد و پرهیزکاری و راستگویی و پاکی تلاش کن، اما در محبت و احترام به پیامبر اسلام، مصطفی (پیامبر محمد) بیشتر توجه کن و تلاشت را بر آن متمرکز کن."],[106,"نخورد از عبادت بر آن بی‌خرد","که با حق نکو بود و با خلق بد","عبادت و نیایش آن فرد نادان، فایده‌ای نداشت، زیرا او با خداوند خوب بود و با مردم و مخلوقات بدرفتاری می‌کرد."],[106,"سخن ماند از عاقلان یادگار","ز سعدی همین یک سخن یاد دار","این سخن که سعدی به یادگار گذاشته از عاقلان، همین یک نکته است که در ذهن خود نگه‌دار."],[106,"گنهکار اندیشناک از خدای","به از پارسای عبادت نمای","گنهکار باید بیشتر نگران خداوند باشد تا فردی که فقط به عبادت می‌پردازد اما در دل پاکی ندارد."],[107,"فقیهی کهن جامه تنگدست","در ایوان قاضی به صف بر نشست","فقیهی که لباس‌های کهنه و پاره‌ای بر تن داشت، در فضای بیرونی قاضی (قاضی که قضاوت می‌کند) نشسته بود و انتظار می‌کشید."],[107,"نگه کرد قاضی در او تیز تیز","معرف گرفت آستینش که خیز","قاضی با دقت و تیزبینی به فقیه تنگدست نگاه کرد و متوجه شد که آستینش را بالا زده است تا بهتر بتواند خود را نشان دهد و از جایش برخیزد."],[107,"ندانی که برتر مقام تو نیست","فروتر نشین، یا برو، یا بایست","نمی‌دانی که مقام تو بالاتر از این نیست؛ بنابراین یا در جای خود بمان، یا برو."],[107,"نه هر کس سزاوار باشد به صدر","کرامت به جاه است و منزل به قدر","هر کسی که شایسته مقام و احترام باشد، لزوما به خاطر مقام و منزلتش در موقعیت بالاتری قرار نمی‌گیرد؛ بلکه مقام و منزلت انسان به اندازه شایستگی‌اش است."],[107,"دگر ره چه حاجت ببیند کست؟","همین شرمساری عقوبت بست","شخصی که در مقام و اعتبار خوب باشد، نیازی به دنبال کردن مسیرهای دیگر ندارد. شرمساری او، نتیجه‌ی رفتار ناپسندش است و به همین خاطر، دچار عذاب و مجازات خواهد شد."],[107,"به عزت هر آن کاو فروتر نشست","به خواری نیفتد ز بالا به پست","هر کسی که به خاطر عزت و احترام خود، پایین‌تر برود، به خاطر این فروتنی به ذلت و خواری نمی‌افتد، حتی اگر در مقام و مرتبه پایین‌تر قرار گیرد."],[107,"به جای بزرگان دلیری مکن","چو سر پنجه‌ات نیست شیری مکن","از روی نادانی یا بی‌مبالاتی خود را به مقام و موقعیت بزرگ‌ترها نرسان و جسارت نکن، چون اگر توانایی و قدرتی در خود نمی‌بینی، نباید خود را در آن جایگاه قرار دهی."],[107,"چو دید آن خردمند درویش رنگ","که بنشست و برخاست بختش به جنگ","خردمند درویش وقتی رنگ چهره‌اش را دید که در حال نشستن و برخاستن است، متوجه شد که بختش در حال نبرد و کشمکش است."],[107,"چو آتش برآورد بیچاره دود","فروتر نشست از مقامی که بود","مانند دودی که از آتش بر میخیزد، آه و ناله از شخص درویش بلند شد و به ناچار از مقام و جایگاهی که بود به محل کم ارزشتر جا به جا شد."],[107,"فقیهان طریق جدل ساختند","لم و لا اسلّم درانداختند","فقیهان (عالم‌های دینی) راه بحث و جدل را به میان آوردند و با طرح مسأله‌های مختلف، سوالاتی را مطرح کردند که پاسخ به آن‌ها سخت و دشوار بود."],[107,"گشادند بر هم در فتنه باز","به لا و نعم کرده گردن دراز","فقیهان در بحثی که به راه افتاده، به جدال و مشاجره پرداختند و در این میان، هر یک سعی کرد با ندانم‌کاری و عدم تسلیم در برابر دیگری، به نوعی برتری خود را نشان دهد."],[107,"تو گفتی خروسان شاطر به جنگ","فتادند در هم به منقار و چنگ","تو گفتی خروس‌ها به خاطر جوجه‌کشی با هم به جنگ و درگیری افتادند و با منقار و چنگ (دست‌هایشان) درگیر شدند."],[107,"یکی بی خود از خشمناکی چو مست","یکی بر زمین می‌زند هر دو دست","یکی از خشم و عصبانیت به حال مستی افتاده و حالت غیرقابل کنترلی دارد، و دیگری به نشانه خشم، دو دست خود را به زمین می‌کوبد."],[107,"فتادند در عقده پیچ پیچ","که در حل آن ره نبردند هیچ","دو نفر در بن‌بست و مشکل عمیقی گرفتار شدند که نتوانستند راه حلی برای آن پیدا کنند."],[107,"کهن جامه در صف آخرترین","به غرش در آمد چو شیر عرین","در آخرین صف، مردی که لباس کهنه‌ای بر تن داشت، با صدای بلندی مانند شیر خشمگین اعتراض کرد."],[107,"بگفت ای صنادید شرع رسول","به ابلاغ تنزیل و فقه و اصول","او به دانشمندان بزرگ اسلام می‌گوید: ای افراد با نفوذ و محترم، پیامبر خدا (رسول) به وسیله‌ی وحی (تنزیل) و علم فقه و اصول دین، معارف الهی را به مردم ابلاغ کرده است."],[107,"دلایل قوی باید و معنوی","نه رگهای گردن به حجت قوی","برای اثبات حقایق و اقامه دلیل، باید از استدلال‌های منطقی و معنوی استفاده کرد، نه اینکه فقط به قدرت بدنی و فیزیکی (مثل رگ‌های گردن) متکی بود."],[107,"مرا نیز چوگان لعب است و گوی","بگفتند اگر نیک دانی بگوی","می‌گویند من هم مانند دیگران در این بازی زندگی در حال رقابت هستم و اگر به خوبی درکی از شرایط و مشکلات زندگی داشته باشی، باید گفتنی‌ها را بیان کنی."],[107,"به کلک فصاحت بیانی که داشت","به دلها چو نقش نگین بر نگاشت","سعدی می‌گوید با قلم و بیان زیبا و خوش‌بیانی که داشت، مانند یک نگین که بر یک انگشتر می‌نشیند، کلماتش در دل‌ها جایگاهی عمیق و ممتاز پیدا کرد."],[107,"سر از کوی صورت به معنی کشید","قلم بر سر حرف دعوی کشید","او از دنیای زیبایی و ظرافت (صورت) خارج شد و سراغ معنای عمیق و واقعی (معنی) رفت، قلمش را به نوشتن در مورد دلایل و مدعیات (حرف دعوی) مشغول کرد."],[107,"بگفتندش از هر کنار آفرین","که بر عقل و طبعت هزار آفرین","او را از هر سو تحسین کردند و گفتند که بر عقل و طبعش (فطرتش) هزار بار آفرین و ستایش نثار می‌شود."],[107,"سمند سخن تا به جایی براند","که قاضی چو خر در وحل باز ماند","سخن باید به قدری خوب و مؤثر باشد که حتی قاضی، که در اینجا به بی‌قراری یا ناتوانی تشبیه شده است، نتواند از آن بهره‌برداری کند و در حالت درماندگی باقی بماند."],[107,"برون آمد از طاق و دستار خویش","به اکرام و لطفش فرستاد پیش","او (قاضی) از جایی که در آن نشسته بود و دستار (عمامه) خود را به نشانه احترام برداشت و به خاطر بزرگواری و لطفی که به او (شاعر یا کسی دیگر) دارد، به پیش او می‌فرستد."],[107,"که هیهات قدر تو نشناختم","به شکر قدومت نپرداختم","من نتوانستم ارزشت را بشناسم و به خاطر حضور تو سپاسگزاری نکردم."],[107,"دریغ آیدم با چنین مایه‌ای","که بینم تو را در چنین پایه‌ای","متأسفم که با وجود مقام و دانش والای تو، تو را در جایگاه پست‌تری می‌بینم که مناسب تو نیست."],[107,"معرف به دلداری آمد برش","که دستار قاضی نهد بر سرش","قاضی به دلیل موقعیت و مقامش، با نشانه‌ای مانند گذاشتن دستاری بر سرش، به او دلداری و احترام می‌دهد."],[107,"به دست و زبان منع کردش که دور","منه بر سرم پایبند غرور","او به وسیله دست و زبان، او را از این کار منع کرد و به او گفت که به خاطر غرور، سرش را به بند نکند و خود را از دیگران متمایز نکند."],[107,"که فردا شود بر کهن میزران","به دستار پنجه گزم، سر گران","فردا به دیدار بزرگان می‌روم و با کلاهی که بر سرم هست، خود را بزرگ و مهم جلوه می‌دهم."],[107,"چو مولام خوانند و صدر کبیر","نمایند مردم به چشمم حقیر","هرگاه مرا «مولا» بی‌نامند و مانند یک شخصیت بزرگ (صدر کبیر) در نظر مردم قرار دهند، در چشمان من به عنوان یک شخص حقیر و کوچک دیده می‌شوم."],[107,"تفاوت کند هرگز آب زلال","گرش کوزه زرین بود یا سفال؟","آب زلال همیشه باکیفیت و خالص است و فرقی ندارد که در ظرف طلایی باشد یا سفالی؛ ارزش واقعی چیزی به ظاهر و جنس ظرف آن بستگی ندارد."],[107,"خرد باید اندر سر مرد و مغز","نباید مرا چون تو دستار نغز","اندیشه و عقل باید در سر انسان باشد، نه اینکه مانند تو، فقط ظاهری زیبا و دستار نیکو داشته باشد، بدون دانشی عمیق."],[107,"کس از سربزرگی نباشد به چیز","کدو سربزرگ است و بی مغز نیز","هیچ‌کس نمی‌تواند با بزرگ‌منشی خود را به کسی بنزارد، زیرا کدویی که بزرگ است، بی‌مغز نیز هست."],[107,"میفراز گردن به دستار و ریش","که دستار پنبه‌ست و سبلت حشیش","به خاطر فخرفروشی و خودبزرگ‌بینی خود را بالاتر از دیگران نیاور، زیرا آنی که به آن زینت‌ها و ظواهر مغرور شده، در حقیقت چیزی بیشتر از پنبه و گیاه بی‌ارزش نیست."],[107,"به صورت کسانی که مردم وشند","چو صورت همان به که دم در کشند","تنها به ظاهر افرادی که در نظر مردم زیبا هستند اهمیت نده، بلکه همان‌طور که آن‌ها را در نظر می‌گیرند، باید به حقیقت وجودشان نیز توجه داشته باشی."],[107,"به قدر هنر جست باید محل","بلندی و نحسی مکن چون زحل","انسان باید به اندازه هنر و دانش خود مقام و مرتبه‌ای داشته باشد و از بدشانسی و ناکامی پرهیز کند، مانند زحل که در افسانه‌ها به بدی و نحسی مشهور است."],[107,"نی بوریا را بلندی نکوست","که خاصیت نیشکر خود در اوست","بلندی بوریا (چرخ‌خیاطی از نی) خوب نیست، زیرا خاصیت و ارزش نیشکر خود را ندارد و در واقع به کیفیت خود نی بستگی دارد."],[107,"بدین عقل و همت نخوانم کست","و گر می‌رود صد غلام از پست","من با این عقل و اراده، هیچ‌کس را از خودم نمی‌دانم و حتی اگر صد غلام از طبقه پایین به جلو بروند، برای من مهم نیست."],[107,"چه خوش گفت خرمهره‌ای در گلی","چو برداشتش پر طمع جاهلی","خرمهره‌ای (نوعی سنگ قیمتی) به درستی گفت که وقتی کسی گلی را از زمین برمی‌دارد، این نشان‌دهنده طمع و جاهلیتی است که در او وجود دارد. این بیت به نقد عیب‌ها و جاه‌طلبی‌های انسان‌ها می‌پردازد."],[107,"مرا کس نخواهد خریدن به هیچ","به دیوانگی در حریرم مپیچ","هیچ‌کس مرا به‌خاطر دیوانگی و رفتار عجیبم نمی‌خواهد و من را در پیچیدگی‌های حیات نمی‌فروشند."],[107,"خبزدو همان قدر دارد که هست","وگر در میان شقایق نشست","هر کسی به همان اندازه که هست و دارای ویژگی‌های واقعی خود است، ارزش دارد و اگر در میان زیبایی‌ها و گل‌های شقایق قرار گیرد، هیچ تفاوتی در ذات او نخواهد بود."],[107,"نه منعم به مال از کسی بهتر است","خر ار جل اطلس بپوشد خر است","فرد ثروتمند که به خاطر wealth خود خود را بالا می‌برد، از دیگران برتر نیست؛ حتی اگر او مانند \"خر\" (حیوانی بارکش) لباس‌های گران‌قیمتی بپوشد، همچنان همان خر است و تغییر نمی‌کند."],[107,"بدین شیوه مرد سخنگوی چست","به آب سخن کینه از دل بشست","مرد سخنگو با این روش، به راحتی و با طلاقت سخن می‌گوید و به وسیله گفتار خود، کینه‌ها و دشمنی‌ها را از دل‌ها می‌زداید."],[107,"دل آزرده را سخت باشد سخن","چو خصمت بیفتاد سستی مکن","زمانی که دل آدمی آزرده باشد، گفتن کلام دشوار است؛ حتی اگر دشمن او ضعیف و سست شده باشد، نباید او را نادیده گرفت و در گفتار کوتاه آمد."],[107,"چو دستت رسد مغز دشمن بر آر","که فرصت فرو شوید از دل غبار","هرگاه بر تو دسترسی به دشمن پیش آید، باید که او را از خود دور کنی و ناراحتی‌ها و کدورت‌ها را از دل خود بزدایی، زیرا که در این زمان، فرصت برای پاک شدن دل‌ها فراهم می‌شود."],[107,"چنان ماند قاضی به جورش اسیر","که گفت انّ هذا لیوم عسیر","قاضی، به خاطر ظلم و ستمی که در حال انجام آن بود، مانند اسیری گرفتار و ناتوان مانده است و در دلش می‌گوید امروز روز سختی برای من است."],[107,"به دندان گزید از تعجب یدین","بماندش در او دیده چون فرقدین","او از تعجب دندانش را گاز گرفت و همچنان به چهره‌اش خیره ماند، چهره‌ای که همچون ستاره‌های درخشان، جذاب و زیبا بود."],[107,"وز آنجا جوان روی همت بتافت","برون رفت و بازش نشان کس نیافت","از آنجا جوانی با اراده و عزم، به سرعت خارج شد و کسی نتوانست او را پیدا کند."],[107,"غریو از بزرگان مجلس بخاست","که گویی چنین شوخ چشم از کجاست؟","سخن از این است که در مجالس و محافل، صدای حاضران به قدری بلند شده که گویی شخصی با چشمان شوخ و بازیگوش از جایی وارد شده است و توجه همه را به خود جلب کرده است."],[107,"نقیب از پیش رفت و هر سو دوید","که مردی بدین نعت و صورت که دید؟","نقیب (رهبر) به دنبال کسی رفت و در هر طرف جستجو کرد که ببیند این مرد با چنین ویژگی‌ها و چهره‌ای کیست."],[107,"یکی گفت از این نوع شیرین نفس","در این شهر سعدی شناسیم و بس","در این شهر فقط یک نفر با این ویژگی‌های خوش‌نفس و دلنشین شناخته شده است و آن هم سعدی است."],[107,"بر آن صد هزار آفرین کاین بگفت","حق تلخ بین تا چه شیرین بگفت","به خاطر این‌که حق‌گویی ممکن است تلخ باشد، صد هزار آفرین بر او که این را گفت، تا ببینیم چه شیرینی در این سخن نهفته است."],[108,"یکی پادشه‌زاده در گنجه بود","که دور از تو ناپاک و سرپنجه بود","یک شاهزاده در گنجه وجود داشت که به خاطر دوری از تو (خدا) با گناه و آلودگی دست و پنجه نرم می‌کرد."],[108,"به مسجد در آمد سرایان و مست","می اندر سر و ساتکینی به دست","پادشاه‌زاده‌ای به مسجد وارد شد، در حالیکه گویندگان و شاعرانی مست و شاداب از سر و دل در آنجا بودند و مشغول گفتن اشعار و مزمزمه‌های دلنشین بودند."],[108,"به مقصوره در پارسایی مقیم","زبانی دلاویز و قلبی سلیم","او در مکانی خاص و مخصوص به عبادت و پارسایی مقیم است که زبانش زیبا و دلش پاک و صاف است."],[108,"تنی چند بر گفت او مجتمع","چو عالم نباشی کم از مستمع","گروهی به دور او جمع شدند و گفتند، اگر تو عالمی نباشی، کمتر از شنونده نیستی."],[108,"چو بی عزتی پیشه کرد آن حرون","شدند آن عزیزان خراب اندرون","وقتی حرون (کسی با ویژگی‌های ناپسند) خود را بی‌عزت نشان داد، آن عزیزان (افراد محترم) در دل خراب و ناامید شدند."],[108,"چو منکر بود پادشه را قدم","که یارد زد از امر معروف دم؟","وقتی پادشاه به نیکی‌ها بی‌توجه باشد و آن‌ها را انکار کند، چه کسی جرأت می‌کند از او درباره کارهای خوب سخن بگوید؟"],[108,"تحکم کند سیر بر بوی گل","فرو ماند آواز چنگ از دهل","اگر کسی بخواهد برتر از آنچه هست خود را نشان دهد، مانند این است که گرچه بوی گل را سیر به خود جذب می‌کند، اما آهنگ چنگ (نوعی ساز) هرگز از صدای دهل (ساز کوبه‌ای) کمتر نخواهد بود."],[108,"گرت نهی منکر بر آید ز دست","نشاید چو بی دست و پایان نشست","اگر تو نتوانی از چیزی که بر آن جدل می‌کنی، جلوگیری کنی، پس نباید در مقام نصیحت یا نهی بودن در جایگاه قدرت بنشینی."],[108,"وگر دست قدرت نداری، بگوی","که پاکیزه گردد به اندرز خوی","اگر قدرت عمل نداری، لااقل به زبان بگو که دیگران با نصیحت تو به راه راست هدایت شوند."],[108,"چو دست و زبان را نماند مجال","به همت نمایند مردی رجال","وقتی که انسان توانایی انجام کاری را نداشته باشد و نتواند حرف بزند، باید با تلاش و اراده خود مردانگی و شخصیت خویش را نشان دهد."],[108,"یکی پیش دانای خلوت نشین","بنالید و بگریست سر بر زمین","یک نفر نزد عالم سکوت‌نشین (که در تنهایی به دانش می‌پردازد) رفت و شروع به شکایت و گریه کرد و سرش را بر زمین گذاشت."],[108,"که باری بر این رند ناپاک و مست","دعا کن که ما بی زبانیم و دست","دعا کن برای این انسان فاسد و می‌خوار که ما از گفتن و بیان احساسات خود ناتوانیم و دست‌مان به هیچ‌جا نمی‌رسد."],[108,"دمی سوزناک از دلی با خبر","قوی تر که هفتاد تیغ و تبر","دل آگاه و حساس، سوزش و درد را به خوبی احساس می‌کند، و این درد به مراتب شدیدتر از زخم‌هایی است که با تیغ و تبر به بدن می‌زنند."],[108,"بر آورد مرد جهاندیده دست","چه گفت ای خداوند بالا و پست","مردی با تجربه و آگاه، دست خود را به سوی خداوند بلند کرد و گفت: ای خدای بالای همه چیز و پایین‌ترین حالت‌ها،."],[108,"خوش است این پسر وقتش از روزگار","خدایا همه وقت او خوش بدار","این پسر در این دنیا خوشحال و راضی است، پس ای خدا، همیشه حال او را خوب نگه‌دار."],[108,"کسی گفتش ای قدوه راستی","بر این بد چرا نیکویی خواستی؟","کسی به او (ملک زاده گنجه) گفت، ای الگوی راستگویی، چرا به این آدم بد، نیکی کردی؟"],[108,"چو بد عهد را نیک خواهی ز بهر","چه بد خواستی بر سر خلق شهر؟","اگر به کسی که به تو بی‌وفاست و بدی می‌کند، نیکی کنی، برای چه بدی و زیان به مردم شهر را خواسته‌ای؟"],[108,"چنین گفت بیننده تیز هوش","چو سر سخن در نیابی مجوش","بیننده باهوش می‌گوید که اگر به نکته اصلی موضوع پی نبری، حرف‌هایت را بی‌خود و بی‌مورد prolong نکن."],[108,"به طامات مجلس نیاراستم","ز داد آفرین توبه‌اش خواستم","من به دلیل اشتغال به سخن‌چینی‌های بی‌فایده مجلس نمی‌پردازم و فقط از خدایی که داد آفرید، توبه‌ام را درخواست کردم."],[108,"که هر گه که باز آید از خوی زشت","به عیشی رسد جاودان در بهشت","هر بار که انسان از رفتار زشت خود برگردد و به سوی نیکوئی‌ها و خوبی‌ها بازگردد، به خوشی و لذت پایدار در بهشت می‌رسد."],[108,"همین پنج روز است عیش مدام","به ترک اندرش عیشهای مدام","تنها پنج روز به شادی پایدار نیاز است و این شادی، با ترک لذت‌های ناپایدار به دست می‌آید."],[108,"حدیثی که مرد سخن ساز گفت","کسی ز آن میان با ملک باز گفت","مرد سخن‌ساز (سخنگو) حکایتی بیان کرد که کسی از میان جمع به ملک (پادشاه) تخفیف و آسایش (عذرخواهی) کرد."],[108,"ز وجد آب در چشمش آمد چو میغ","ببارید بر چهره سیل دریغ","از شدت شادی و احساساتش، اشک‌هایش مانند باران بر صورتش ریخت و چهره‌اش را تر کرد."],[108,"به نیران شوق اندرونش بسوخت","حیا دیده بر پشت پایش بدوخت","او که دچار شوق و اشتیاق شده، با خودکاری و شور در دلش، حیا و شرم از رویش را کاملا رها کرده و چشمانش را بر روی زمین و به پای کسی که دوستش دارد دوخته است."],[108,"بر نیک محضر فرستاد کس","در توبه کوبان که فریاد رس","کسی را به جلسه نیکو فرستاد تا در حال توبه، داد زدن و درخواست کمک کند."],[108,"قدم رنجه فرمای تا سر نهم","سر جهل و ناراستی بر نهم","من از طرف تو خواهش می‌کنم که تشریف بیاوری تا من سرم را به خاک بیفکنم و نادانی و ستمکاری‌ام را به زمین بگذارم و از آن توبه کنم."],[108,"دو رویه ستادند بر در سپاه","سخن پرور آمد در ایوان شاه","دو نفر با چهره‌های مختلف و نیرنگ در دروازه سپاه ایستاده‌اند و سخنانی فریبنده درباره خود می‌گویند که به دربار شاه رسیده است."],[108,"شکر دید و عناب و شمع و شراب","ده از نعمت آباد و مردم خراب","در این بیت، اشاره به نعمت‌ها و لذت‌های دنیوی مثل شکر، عناب، شمع و شراب شده است که در کنار هم، به زندگی خوش و آباد اشاره دارند، در حالی که مردم به لحاظ روحی و معنوی در دلتنگی و خرابی به سر می‌برند."],[108,"یکی غایب از خود، یکی نیم مست","یکی شعر گویان صراحی به دست","در این مجموعه، یکی از افراد به حدی در خود غوطه‌ور شده که گویی وجود خود را فراموش کرده، دیگری هم نیمه‌مست است و یکی دیگر در حال خواندن شعر و در دست داشتن یک پارچ شراب به سر می‌برد."],[108,"ز سویی بر آورده مطرب خروش","ز دیگر سو آواز ساقی که نوش","از یک سو، مطرب به شدت در حال نواختن و ایجاد هیاهو است و از سوی دیگر، صدای ساقی می‌آید که از شراب سخن می‌گوید و مردم را به نوشیدن تشویق می‌کند."],[108,"حریفان خراب از می لعل رنگ","سر چنگی از خواب در بر چو چنگ","دوستان شراب‌خوار از رنگ می لعل (قرمز) به حالت مستی و خوشی درآمده‌اند و در آغوش یکدیگر مانند چنگ (آلات موسیقی) به آرامی خوابیده‌اند."],[108,"نبود از ندیمان گردن فراز","به جز نرگس آن جا کسی دیده باز","در آن مجلس کسی جز نرگس، که با نگاهش دل‌ها را مشغول می‌کند، وجود نداشت و دیگر ندیمان یا دوستان با اعتماد به نفس (گردن فراز) در آنجا دیده نمی شدند."],[108,"دف و چنگ با یکدگر سازگار","بر آورده زیر از میان ناله زار","دوتا ساز، یعنی دف و چنگ، در کنار هم به صدای دلنشین خود ادامه می‌دهند، اما صدای آه و ناله‌ای از زیر آنها بلند می‌شود که نشان‌دهنده ناراحتی و غم است."],[108,"بفرمود و در هم شکستند خرد","مبدل شد آن عیش صافی به درد","ملک زاده‌ای دستور داد و سازها را شکستند؛ و شادی و لذت به سختی و درد تبدیل شد."],[108,"شکستند چنگ و گسستند رود","به در کرد گوینده از سر سرود","چنگ موسیقی را شکستند و موسیقی که شاداب بود، به نابودی کشیده شد. گوینده، یعنی شاعر، از آغاز شعر و سرود خود کناره‌گیری کرد."],[108,"به میخانه در سنگ بر دن زدند","کدو را نشاندند و گردن زدند","در میخانه به جای سنگ، کدو را بر زمین کوبیدند و کدو را برداشتند و گردن آن را قطع کردند."],[108,"می لاله گون از بط سرنگون","روان همچنان کز بط کشته خون","شراب قرمز مانند لاله از بدن بط بیفتاده در حال جاری شدن است، به‌طوری‌که گویی خون یک بط کشته شده است."],[108,"خم آبستن خمر نه ماهه بود","در آن فتنه دختر بینداخت زود","در این بیت، شاعر به وضعیتی اشاره دارد که در آن یک خم (خمر) به عنوان منبع شراب، در حال تخم‌ریزی و آماده شدن است و در میان این مشکلات، دختری دراثر فتنه‌ای به سرعت به دام افتاده است. این تصویر نشان‌دهنده تاثیرات مخرب عیش و نوش و به هم ریختن اوضاع است."],[108,"شکم تا به نافش دریدند مشک","قدح را بر او چشم خونی پر اشک","شکم او را تا ناحیه ناف شکافتند و از آن مشک‌ مانند خونی را که پر از اشک بود، برچهره‌اش ریختند."],[108,"بفرمود تا سنگ صحن سرای","بکندند و کردند نو باز جای","فرمان دادند که سنگ‌های صحن حیاط را برداشته و دوباره آنها را تعمیر و نو کنند."],[108,"که گلگونه خمر یاقوت فام","به شستن نمی‌شد ز روی رخام","گل‌های زیبا و رنگین را نمی‌توان با شستن بر روی سنگ مرمر، به رنگ قرمز شراب درآورد."],[108,"عجب نیست بالوعه گر شد خراب","که خورد اندر آن روز چندان شراب","عجیب نیست اگر بالای کوه و تپه خراب شده باشد، چراکه در آن روز مقدار زیادی شراب نوشیده شده است."],[108,"دگر هر که بربط گرفتی به کف","قفا خوردی از دست مردم چو دف","هر کسی که در دستش ساز بربط (ساز ایرانی) داشته باشد، او نیز از مردم ضربه می‌خورد و مانند دف (ساز کوبه‌ای) به او برخورد می‌شود."],[108,"وگر فاسقی چنگ بردی به دوش","بمالیدی او را چو طنبور گوش","اگر فرد فاسقی را با چنگ (ساز) در آغوش می‌گرفتی، مانند تنبور (ساز دیگری) او را نوازش می‌کردی."],[108,"جوان سر از کبر و پندار مست","چو پیران به کنج عبادت نشست","جوانی که به خاطر غرور و خیال باطلش مغرور بود، مانند پیران بر گوشه‌ای از عبادت مشغول شد و در حال نیایش نشسته است."],[108,"پدر بارها گفته بودش به هول","که شایسته رو باش و پاکیزه قول","پدرش بارها به او هشدار داده بود که باید با احتیاط و صداقت زندگی کند و همواره آراسته و نیکو سخن باشد."],[108,"جفای پدر برد و زندان و بند","چنان سودمندش نیامد که پند","ستم و سخت‌گیری پدر و همچنین زندان و حبس بر او چنان اثرگذار نبود که نصیحت و پند او را بر سر عقل آورد."],[108,"گرش سخت گفتی سخنگوی سهل","که بیرون کن از سر جوانی و جهل","اگر چه تو با او به سختی سخن گفته‌ای، اما سخنگوی دلسوزی به تو می‌گوید که او را از سر نادانی و جوانی‌اش برهان."],[108,"خیال و غرورش بر آن داشتی","که درویش را زنده نگذاشتی","تو به خاطر خیال و خودبزرگ‌بینی‌ات فکر می‌کردی که نمی‌توانی درویش را زنده بگذاری و او را نادیده بگیری."],[108,"سپر نفکند شیر غران ز جنگ","نیندیشد از تیغ بران پلنگ","شیر نیرومند در جنگ از ترس نمی‌افتد و به سلاح برّان پلنگ فکر نمی‌کند."],[108,"به نرمی ز دشمن توان کرد دوست","چو با دوست سختی کنی دشمن اوست","با دشمن باید نرم برخورد کرد تا امکان دوستی با او فراهم شود، چون اگر با دوست رفتار تند و سختی داشته باشی، در واقع دشمنی را برای خود می‌سازی."],[108,"چو سندان کسی سخت رویی نکرد","که خایسک تأدیب بر سر نخورد","هیچ‌کس با نرمی و لطافت نمی‌تواند بر کسی که سخت‌رو و بی‌احساس است، تأثیر بگذارد؛ مانند اینکه انسان نمی‌تواند بر روی سندان (آهنگری) تأثیر بگذارد."],[108,"به گفتن درشتی مکن با امیر","چو بینی که سختی کند، سست گیر","با امیر سخت‌دل، درشتی نکن و با او به تندی سخن نگو، اگر او در برابر تو سختی و سرسختی نشان می‌دهد، تو خود را تسلیم نکن و به نرمی رفتار کن."],[108,"به اخلاق با هر که بینی بساز","اگر زیردست است اگر سرفراز","با هر کسی که سر و کار داری، باید با اخلاق خوب رفتار کنی، چه او فردی پایین‌رتبه باشد و چه مقام‌دار و محترم."],[108,"که این گردن از نازکی بر کشد","به گفتار خوش، و آن سر اندر کشد","شخصی که گردنش از روی ناز و تبختر بالا می‌رود (فخر می‌کند)، با صحبت‌های خوب و ملایم می‌تواند خود را از این حالت خارج کند، و کسی که در حال افتادگی و فروتنی است، با گفتاری مناسب می‌تواند از این حالت خارج شود."],[108,"به شیرین زبانی توان برد گوی","که پیوسته تلخی برد تندخوی","با صحبت‌های شیرین و دلپذیر می‌توان فردی را متقاعد کرد، در حالی که افرادی که برخورد تند و بدخلق دارند، همیشه باید تلخی و زحمت را تحمل کنند."],[108,"تو شیرین زبانی ز سعدی بگیر","ترش روی را گو به تلخی بمیر","اگر به سعدی (شاعر معروف) تکیه کنی و از او بیاموزی که چگونه با شیرینی سخن بگویی، به افرادی که خلق و خوی تند و تلخ دارند، بگو که بهتر است با تلخی و کینه زندگی نکنند و خود را از این حس‌ها رها کنند."],[109,"شکر خنده‌ای انگبین می‌فروخت","که دلها ز شیرینیش می‌بسوخت","شکر، یعنی شیرینی و خوشی، با لبخندی مانند عسل می‌فروخت که دل‌ها از قند و شیرینی‌اش ذوب می‌شدند."],[109,"نباتی میان بسته چون نیشکر","بر او مشتری از مگس بیشتر","نباتی که شبیه نیشکر است، در حالی که مشتری‌اش از مگس‌ بیشتری است. یعنی این گیاه به قدری شیرین و جذاب است که حتی مگس‌ها به آن بیشتر از دیگر مشتری‌ها علاقه‌مندند."],[109,"گر او زهر برداشتی فی‌المثل","بخوردندی از دست او چون عسل","اگر او زهر بخورد، مردم به‌خاطر شیرینی‌اش، آن را از دست او مانند عسل می‌خورند."],[109,"گرانی نظر کرد در کار او","حسد برد بر گرم بازار او","اگر کسی به مقام و کار او با حسادت نگاه کند، به خاطر رونق و موفقیت او در زندگی، در دل خود حسد می‌ورزد."],[109,"دگر روز شد گرد گیتی دوان","عسل بر سر و سرکه بر ابروان","روز دیگری فرا رسید و در این دنیا، عسل به صورت او می‌ریخت و سرکه بر ابروهایش قرار گرفته بود."],[109,"بسی گشت فریادخوان پیش و پس","که ننشست بر انگبینش مگس","فریاد و انبوهی از مردم پیش و پس به‌دنبال او بودند، اما هیچ مگسی بر عسل او ننشست."],[109,"شبانگه چو نقدش نیامد به دست","به دلتنگ رویی به کنجی نشست","شب هنگام که پول و ثروتش به دست نیامد، با ناراحتی و ناامیدی در گوشه‌ای نشسته است."],[109,"چو عاصی ترش کرده روی از وعید","چو ابروی زندانیان روز عید","چون کسی که به خاطر تهدید و عذاب، چهره‌اش بدخلق و ترش شده است، همانند ابروی زندانیان در روز عید به نظر می‌رسد؛ یعنی حالتی غمگین و ناراحت دارد."],[109,"زنی گفت بازی کنان شوی را","عسل تلخ باشد ترش روی را","زنی به شوهرش گفت که اگر تو به بازی و سرگرمی بپردازی، مانند عسل تلخ خواهی بود که چهره‌ات را ترش می‌کند."],[109,"به دوزخ برد مرد را خوی زشت","که اخلاق نیک آمده‌ست از بهشت","اخلاق بد انسان را به دوزخ می‌برد و در مقابل، ویژگی‌های خوب و نیک به بهشت مربوط می‌شوند."],[109,"برو آب گرم از لب جوی خور","نه جلاب سرد ترش روی خور","برو و آب گرم از کنار جوی بنوش، نه اینکه آب سرد و ترش طعم ملاقات با کسی را بچشی."],[109,"حرامت بود نان آن کس چشید","که چون سفره ابرو به هم در کشید","نان آن کسی بر تو حرام است که به خاطرش ابروهایش را در هم کشیده و به تو بی‌احترامی کرده است."],[109,"مکن خواجه بر خویشتن کار سخت","که بدخوی باشد نگون‌سار بخت","ای خواجه، بر خودت سخت‌گیری نکن، زیرا انسان بدخوی، سرنوشتی بد و شوم خواهد داشت."],[109,"گرفتم که سیم و زرت چیز نیست","چو سعدی زبان خوشت نیز نیست؟","در این بیت، شاعر به این نکته اشاره می‌کند که ثروت و جواهرات (سیم و زر) ارزش زیادی ندارند، اگر زبان خوش و خیرخواهی چون سعدی (خودش) وجود نداشته باشد. یعنی، ارزش واقعی در حسن بیان و رفتار نیکو نهفته است."],[110,"شنیدم که فرزانه‌ای حق پرست","گریبان گرفتش یکی رند مست","شنیدم که یک شخص فرزانه و خداپرست، دچار یک رند (زندان‌نشین یا خوش‌طینت) مست شد که به او نزدیک شد و او را در آغوش گرفت."],[110,"از آن تیره دل مرد صافی درون","قفا خورد و سر بر نکرد از سکون","مردی بددل و مکار که درونش پاک نیست، به سراغ او رفت و او را زد اما او سر برداشت و عکس‌العملی نشان نداد."],[110,"یکی گفتش آخر نه مردی تو نیز؟","تحمل دریغ است از این بی تمیز","بهنام غفاری مزیدی .. یک نفر به او گفت: مگر تو هم مرد نیستی! ؟واقعا حیف است که از این آدم نفهم که قدرت تشخیص ندارد این‌گونه تحمل می‌کنی."],[110,"شنید این سخن مرد پاکیزه خوی","بدو گفت از این نوع با من مگوی","مردی با اخلاق خوب، این صحبت را شنید و به آن شخص گفت که از این دسته حرف‌ها با من نزن."],[110,"درد مست نادان ، گریبان مرد،","که با شیر جنگی سگالد نبرد؟","بهنام غفاری مزیدی؛ انسان نادان گریبان مردم را میدرد،و با مردم درگیر میشود،،مگر انسان خردمند با اراذل و اوباش ، درگیر میشود؟"],[110,"ز هشیار عاقل نزیبد که دست","زند در گریبان نادان مست","انسان هوشیار و عاقل سزاوار نیست که دست به گریبان نادانی که مست و بی‌خبر است بزند."],[110,"هنرور چنین زندگانی کند","جفا بیند و مهربانی کند","هنرور (فرد هنرمند و با استعداد) چنان با دیگران رفتار می‌کند که در عین حال که به آن‌ها آسیب می‌زند، به نوعی مهربانی نیز از خود نشان می‌دهد."],[111,"سگی پای صحرانشینی گزید","به خشمی که زهرش ز دندان چکید","سگی به مرد صحرا نشینی حمله کرد و پایش را با نهایت خشم گاز گرفت"],[111,"شب از درد بیچاره خوابش نبرد","به خیل اندرش دختری بود خرد","مردی بیچاره به خاطر درد و ناراحتی‌اش نتوانست بخوابد و در میان اندیشه‌هایش، دختری خردسال نیز وجود داشت."],[111,"پدر را جفا کرد و تندی نمود","که آخر تو را نیز دندان نبود؟","از پدرش خشمگین شد و عصبانیت رفتار کرد ، که تو مگر دندان آن نداشتی که مقابله به مثل کنی و سگ را گاز بگیری"],[111,"پس از گریه مرد پراکنده روز","بخندید کای بابک دلفروز","مرد پس از گریه و اندوهی که داشت، دوباره روز را به خاطر بابک که دلی شاد و روحی دلفروز دارد، با خنده و شادی آغاز کرد."],[111,"مرا گرچه هم سلطنت بود و بیش","دریغ آمدم کام و دندان خویش","اگر چه که من دندان داشتم ولی حیفم آمد لب و دهان خود را پای سگی آلوده کنن"],[111,"محال است اگر تیغ بر سر خورم","که دندان به پای سگ اندر برم","حتی اگر شمشیر پشت گردن من نگه دارند محال است که پای سگی را گاز بگیرم"],[111,"توان کرد با ناکسان بد رگی","ولیکن نیاید ز مردم سگی","میتوان با افراد نامرد بدقلقی کرد ولی هرگز یک انسان رفتاری مشابه با سگ از خودش نشان نخواهد داد"],[112,"بزرگی هنرمند آفاق بود","غلامش نکوهیده اخلاق بود","آدم بزرگی که هنرور و فرزانه دهر بود‌، غلامی داشت زشت‌رفتار."],[112,"از این خفرگی موی کالیده‌ای","بدی، سرکه در روی مالیده‌ای","(غلامی بود) ناپسند‌روی و ژولیده موی‌ و ترش‌روی و بداخلاق."],[112,"چو ثعبانش آلوده دندان به زهر","گرو برده از زشت رویان شهر","حرف زدن او مثل نیش افعی زهرناک بود و از همه زشت‌رویان شهر‌، سبقت برده بود و پیش افتاده بود."],[112,"مدامش به روی آب چشم سبل","دویدی ز بوی پیاز بغل","به علت بیماری چشمانش مدام آب و عفونت از آنها جاری بودو بوی بد بدنش (عرق زیر بغل)انسان را فراری می داد."],[112,"گره وقت پختن بر ابرو زدی","چو پختند با خواجه زانو زدی","هنگام پختن غذا ترش‌روی بود (و از غذا ناخرسند) و وقتی که غذا آماده می‌شد با آن‌مرد هنرور می‌نشست (و با او غذا می‌خورد)"],[112,"دمادم به نان خوردنش هم نشست","و گر مردی آبش ندادی به دست","همیشه هنگام غذا خوردن با او بود و اگر خواجه از تشنگی می‌مرد آب به دستش نمی‌داد."],[112,"نه گفت اندر او کار کردی نه چوب","شب و روز از او خانه در کند و کوب","(دیگران هرکاری کردند تغییر نمی‌کرد) و نصیحت و تنبیه هیچکدام بر او اثر نمی‌گذاشت و آن خانه شبانه‌روز از او در آشوب بود."],[112,"گهی خار و خس در ره انداختی","گهی ماکیان در چه انداختی","دیگران را اذیت می‌کرد و در راه آنها تیغ و خار می‌انداخت و یا مرغان خانگی را در چاه آب می‌انداخت (و از این قبیل کارها)"],[112,"ز سیماش وحشت فراز آمدی","نرفتی به کاری که باز آمدی","دیگران از دیدنش وحشت می‌کردند و اگر برای انجام کاری فرستاده می‌شد می‌رفت و برنمی‌گشت (انجام نمی‌داد)"],[112,"کسی گفت از این بنده بد خصال","چه خواهی؟ ادب ، یا هنر، یا جمال؟","شخصی به آن خواجه گفت از این غلام بدسیرت چه انتظار داری؟ ادبش را یا هنرش را یا زیبایی و خوبی‌اش را؟"],[112,"نیرزد وجودی بدین ناخوشی","که جورش پسندی و بارش کشی","آدمی که وجودش برای تو مایه زحمت و ناخوشی است نمی‌ارزد که دردسرهایش را متحمل می‌شوی."],[112,"منت بنده خوب و نیکو سیر","به دست آرم، این را به نخاس بر","من برای تو غلام و بنده خوب و خوش‌رفتار پیدا می‌کنم این را به بازار غلامان ببر و بفروش."],[112,"و گر یک پشیز آورد سر مپیچ","گران است اگر راست خواهی به هیچ","اگر پول ناچیزی هم برای او دادند بپذیر و بفروشش که اگر راستش را بخواهی حتی مفت، گران است."],[112,"شنید این سخن مرد نیکو نهاد","بخندید کای یار فرخ نژاد","آن مرد نیکونهاد در پاسخ خندید و گفت ای دوست خوش‌ذات و نیکو‌نسب."],[112,"بد است این پسر طبع و خویش ولیک","مرا زاو طبیعت شود خوی نیک","خوی و رفتار این غلام بد و ناپسند است (اما برای من مزیتی دارد) که خوی و رفتار مرا پسندیده و نیکو می‌گرداند."],[112,"چو زاو کرده باشم تحمل بسی","توانم جفا بردن از هر کسی","چون‌که رفتارهای بد او را تحمل می‌کنم در نتیجه می‌توانم بر خوی بد و بدی‌های دیگران نیز صبور باشم."],[112,"تحمل چو زهرت نماید نخست","ولی شهد گردد چو در طبع رست","صبر و تحمل کردن، کار سختی است و اول مانند زهر تلخ است اما همین‌که آموختی و در سرشت تو جای گرفت، چون شهد و عسل شیرین است (و مزایای بسیار دارد)"],[113,"کسی راه معروف کرخی بجست","که بنهاد معروفی از سر نخست","کسی به‌راه «معروف کرخی» راه یافت؛ که در قدم اول، غرور را کنار بگذارد."],[113,"شنیدم که مهمانش آمد یکی","ز بیماریش تا به مرگ اندکی","شنیده‌ام که مهمانی برای او آمد که تا مرگ فاصله زیادی نداشت."],[113,"سرش موی و رویش صفا ریخته","به موییش جان در تن آویخته","موی از سر او ریخته و رویش پیر گشته‌بود و جانش به مویی بند بود."],[113,"شب آنجا بیفکند و بالش نهاد","روان دست در بانگ و نالش نهاد","شب در آنجا ماند و سر بر بالش نهاد و یک‌سره از بیماری آه و ناله می‌کرد."],[113,"نه خوابش گرفتی شبان یک نفس","نه از دست فریاد او خواب کس","نه می‌خوابید و نه‌کسی می‌توانست از دست فریاد او بخوابد."],[113,"نهادی پریشان و طبعی درشت","نمی‌مرد و خلقی به حجت بکشت","درونی پریشان داشت و اخلاقی درشت و زشت؛ نمی‌مرد و جمعی را کشت."],[113,"ز فریاد و نالیدن و خفت و خیز","گرفتند از او خلق راه گریز","از فریاد و ناله و ناآرامی او، مردم از آنجا گریختند."],[113,"ز دیار مردم در آن بقعه کس","همان ناتوان ماند و معروف و بس","در آن بقعه هیچ‌کس نماند جز معروف و آن بیمار."],[113,"شنیدم که شبها ز خدمت نخفت","چو مردان میان بست و کرد آنچه گفت","شنیده‌ام که شب‌ها از پرستاری و خدمت نمی‌خوابید و همچون جوانمردان بر پای حرف خود ایستاد و کرد آنچه گفت."],[113,"شبی بر سرش لشکر آورد خواب","که چند آورد مرد ناخفته تاب؟","یک شب‌، خواب بر او حمله‌کرد؛ آخر آدمی چقدر توان نخوابیدن دارد؟"],[113,"به یک دم که چشمانش خفتن گرفت","مسافر پراکنده گفتن گرفت","یک لحظه که چشمانش را برای خوابیدن بست؛ آن مرد مهمان، پراکنده گفتن و پرت و پلا گفتن را شروع کرد."],[113,"که لعنت بر این نسل ناپاک باد","که نامند و ناموس و زرقند و باد","که لعنت بر این نسل ناپاک و گناهکار باد که ادعای نام و غیرت دارند اما در عمل دروغ هستند و باد."],[113,"پلید اعتقادان پاکیزه پوش","فریبنده پارسایی فروش","درون و عقیده آنان ناپاک است و بیرون و ظاهرشان پاک؛ آدمیانی هستند ریاکار."],[113,"چه داند لت انبانی از خواب مست","که بیچاره‌ای دیده بر هم نبست؟","یک آدم لت‌انبان که مست خواب است چطور حال یک بیمار را که نمی‌تواند بخوابد، بفهمد؟"],[113,"سخنهای منکر به معروف گفت","که یک دم چرا غافل از وی بخفت","از این حرف‌های زشت، به معروف گفت؛ که چرا یک‌لحظه خوابید."],[113,"فرو خورد شیخ این حدیث از کرم","شنیدند پوشیدگان حرم","آن شیخ بزرگوار، چیزی نگفت و پوشیدگان اهل‌خانه، ماجرا را شنیدند."],[113,"یکی گفت معروف را در نهفت","شنیدی که درویش نالان چه گفت","یکی در خلوت به معروف گفت که خود دیدی و شنیدی آن درویش بیمار چه‌چیزهایی به‌تو گفت."],[113,"برو زین سپس گو سر خویش گیر","گرانی مکن جای دیگر بمیر","پس از این‌پس به‌او بگو به جایی دیگر برود؛ اذیت نکند و در جایی دیگر بمیرد."],[113,"نکویی و رحمت به جای خود است","ولی با بدان نیکمردی بد است","نیکوکاری و مهربانی جای خود دارد اما با بدان‌، نیکویی کردن بد است."],[113,"سر سفله را گرد بالش منه","سر مردم آزار بر سنگ به","آدم فرومایه را «گرد بالش» و راحتی مده؛ همان بهتر که آدم مردم‌آزار در سختی باشد. (یا بمیرد)"],[113,"مکن با بدان نیکی ای نیکبخت","که در شوره نادان نشاند درخت","ای نیکبخت! با بدان نیکویی مکن زیرا نادان است که در شوره‌زار‌، درخت می‌کارد."],[113,"نگویم مراعات مردم مکن","کرم پیش نامردمان گم مکن","نمی‌گویم به مردم نیکی مکن؛ بلکه می‌گویم نیکویی را صرف نامردمان و فرومایگان مکن."],[113,"به اخلاق نرمی مکن با درشت","که سگ را نمالند چون گربه پشت","به آدم بدخلق و درشت‌، مهربانی مکن که هیچ‌کس پشت سگ را مثل گربه نوازش نمی‌کند."],[113,"گر انصاف خواهی سگ حق شناس","به سیرت به از مردم ناسپاس","اگر راستش را بخواهی یک سگ حق‌شناس و باوفا‌، از مردم ناسپاس و ناشکر‌، خوش‌سیرت‌تر است."],[113,"به برفاب رحمت مکن بر خسیس","چو کردی مکافات بر یخ نویس","شربت خنک را به آدم فرومایه مده که اگر دادی آن را باطل و بیهوده بدان."],[113,"ندیدم چنین پیچ بر پیچ کس","مکن هیچ رحمت بر این هیچ کس","تا حالا آدم عوضی و پیچ‌بر‌پیچ مثل این ندیده‌ام‌، به این آدم فرومایه محبت مکن."],[113,"بخندید و گفت ای دلارام جفت","پریشان مشو زین پریشان که گفت","معروف خندید و گفت‌: ای همسر مهربان، ناراحت مشو از این حرف‌های پریشان که گفت."],[113,"گر از ناخوشی کرد بر من خروش","مرا ناخوش از وی خوش آمد به گوش","اگر از درد بیماری چیز بدی به‌من گفت، آن حرف‌های ناخوش او‌، برای من خوش بود."],[113,"جفای چنین کس نباید شنود","که نتواند از بی‌قراری غنود","نباید به این حرف‌های درشت توجه کرد زیرا نمی‌تواند از بی‌قراری و بی‌تابی بخوابد."],[113,"چو خود را قوی حال بینی و خوش","به شکرانه بار ضعیفان بکش","وقتی سالم و سرحال هستی، به شکرانه این نعمت به ضعیفان کمک کن."],[113,"اگر خود همین صورتی چون طلسم","بمیری و اسمت بمیرد چو جسم","اگر آدمی همین صورت ظاهر و جسم باشد، پس از مرگ هم یادی از او نمی‌ماند."],[113,"وگر پرورانی درخت کرم","بر نیکنامی خوری لاجرم","اما اگر درخت بخشندگی و لطف بپرورانی، از نیک‌نامی و ثواب بهره می‌بری."],[113,"نبینی که در کرخ تربت بسی است","به جز گور معروف، معروف نیست","نمی‌بینی که در کرخ، آرامگاه و تربت زیاد است اما جز گور معروف هیچ‌کدام شناخته‌شده نیست؟"],[113,"به دولت کسانی سر افراختند","که تاج تکبر بینداختند","کسانی نیک‌بخت و سعادتمند گشتند که تاج غرور و تکبر را دور انداختند."],[113,"تکبر کند مرد حشمت پرست","نداند که حشمت به حلم اندر است","آدم‌ بزرگی‌خواه‌، تکبّر می‌ورزد اما نمی‌داند که بزرگی در تواضع است."],[114,"طمع برد شوخی به صاحبدلی","نبود آن زمان در میان حاصلی","گدایی گستاخ و دریده‌رو از عارفی پاک‌طینت طمع کمک کرد، در حالی که در آن لحظه آن پیر چیزی در بساط نداشت."],[114,"کمربند و دستش تهی بود و پاک","که زر برفشاندی به رویش چو خاک","کمر و دستان آن مرد خدا از مال دنیا خالی بود، اما همتی بلند داشت؛ چنان‌که اگر مالی داشت، زر را چون خاک به پای دیگران نثار می‌کرد."],[114,"برون تاخت خواهنده خیره روی","نکوهیدن آغاز کردش به کوی","آن سائل بی‌چشم‌ورو با خشم از پیش او بیرون آمد و در کوچه و بازار شروع به فحاشی و سرزنش او کرد."],[114,"که زنهار از این کژدمان خموش","پلنگان درنده صوف پوش","فریاد برآورد: پناه بر خدا از این عقرب‌های بی‌صدا، و این پلنگ‌های درنده‌ای که لباس پشمینه درویشی به تن دارند!"],[114,"که چون گربه زانو به دل برنهند","و گر صیدی افتد چو سگ در جهند","اینان در ظاهر مثل گربه زانو به بغل گرفته و کز کرده‌اند (ادعای خلوت و مراقبه دارند)، اما اگر لقمه یا شکاری پیش بیاید، مانند سگ به آن هجوم می‌برند."],[114,"سوی مسجد آورده دکان شید","که در خانه کمتر توان یافت صید","دکان مکر، فریب و ریاکاری خود را در مسجد برپا کرده‌اند؛ زیرا در خانه شخصی، شکاری نصیبشان نمی‌شود."],[114,"ره کاروان شیرمردان زنند","ولی جامه مردم اینان کنند","راهزنان واقعی به کاروان دلاوران دستبرد می‌زنند، اما این ریاکاران لباس از تن مردم بی‌دفاع درمی‌آورند."],[114,"سپید و سیه پاره بر دوخته","به سالوس و پنهان زر اندوخته","خرقه‌های وصله‌دار سیاه و سفید می‌پوشند تا زاهد به نظر برسند، اما با تزویر و پنهانی طلا و ثروت می‌اندوزند."],[114,"زهی جو فروشان گندم نمای","جهانگرد شبکوک خرمن گدای","شگفتا از این فریبکارانی که گندم نشان می‌دهند ولی جو می‌فروشند (ظاهر و باطنشان یکی نیست)؛ آوارگان مفت‌خور و شب‌گردی که چشم‌انتظار دسترنج دیگران‌اند."],[114,"مبین در عبادت که پیرند و سست","که در رقص و حالت جوانند و چست","هنگام نماز و طاعت، به ضعف و پیری تصنعی‌شان نگاه نکن؛ چرا که وقت رقص و پایکوبی سماع، چنان چابک و پرانرژی می‌شوند که گویی جوان‌اند!"],[114,"چرا کرد باید نماز از نشست","چو در رقص بر می‌توانند جست؟","اگر راست می‌گویند، چرا نمازشان را از فرط ضعف ادعایی، نشسته می‌خوانند، در حالی که در مجلس رقص به هوا می‌جهند؟"],[114,"عصای کلیمند بسیار خوار","به ظاهر چنین زرد روی و نزار","در ظاهر چهره‌ای لاغر و زردگون دارند، اما در باطن مانند عصای حضرت موسی (اژدها) همه چیز را می‌بلعند و حریص‌اند."],[114,"نه پرهیزگار و نه دانشورند","همین بس که دنیا به دین می‌خورند","نه بویی از پرهیزگاری برده‌اند و نه دانشی دارند؛ تنها هنرشان این است که از نام دین برای سیر کردن دنیای خود مایه می‌گذارند."],[114,"عبایی بلیلانه در تن کنند","به دخل حبش جامه زن کنند","عبایی ساده و مندرس به تن می‌کنند، اما درآمدهای پنهانی هنگفت خود را خرج تجملات و لباس همسرانشان می‌نمایند."],[114,"ز سنت نبینی در ایشان اثر","مگر خواب پیشین و نان سحر","از سنت پیامبر هیچ اثری در آن‌ها نمی‌بینی، مگر خواب قیلوله (پیش از ظهر) و غذای سحری (یعنی فقط به بخش‌های راحت‌طلبانه و شکم‌پرورانه دین عمل می‌کنند)."],[114,"شکم تا سر آکنده از لقمه تنگ","چو زنبیل دریوزه هفتاد رنگ","شکم‌هایشان تا گلو از غذاهای سنگین انباشته است؛ درست مانند زنبیل گدایی که لقمه‌های گوناگون و رنگارنگ در آن ریخته باشند."],[114,"نخواهم در این وصف از این بیش گفت","که شنعت بود سیرت خویش گفت","گدا گفت: بیش از این در وصف پلیدی اینان سخن نمی‌گویم؛ چرا که بازگو کردن خصلت‌های پست دیگران، خود مایه ننگ و زشتی است."],[114,"فرو گفت از این شیوه نادیده گوی","نبیند هنر دیده عیبجوی","آن یاوه‌گوی بی‌انصاف سخنان زیادی از این دست بر زبان آورد؛ چشم بدبین و عیب‌جو هیچ‌گاه خصلت نیک و هنر را نمی‌بیند."],[114,"یکی کرده بی آبرویی بسی","چه غم داردش ز آبروی کسی؟","کسی که خودش بویی از شرافت نبرده و آبرویش را ریخته، چه باکی دارد از اینکه آبروی دیگران را بریزد؟"],[114,"مریدی به شیخ این سخن نقل کرد","گر انصاف پرسی، نه از عقل کرد","شاگردی رفت و عین این ناسزاها را برای شیخ بازگو کرد؛ اگر حقیقت و انصاف را بخواهی، کار آن مرید به دور از خرد بود."],[114,"بدی در قفا عیب من کرد و خفت","بتر زو قرینی که آورد و گفت","فرد بدخواهی پشت سرم از من بدگویی کرد و رفت و خوابید؛ اما بدتر از او آن همنشینی است که سخن را برداشت و پیش من آورد!"],[114,"یکی تیری افکند و در ره فتاد","وجودم نیازرد و رنجم نداد","او تیری پرتاب کرد اما تیرش در نیمه‌راه به زمین افتاد و آسیبی به جان من نزد؛"],[114,"تو برداشتی و آمدی سوی من","همی در سپوزی به پهلوی من","اما تو رفتی و همان تیر افتاده را برداشتی و مستقیم به پهلوی من فرو کردی! (نکوهش شاهکار سخن‌چینی و خبربری)."],[114,"بخندید صاحبدل نیکخوی","که سهل است از این صعب تر گو بگوی","آن پیر روشن‌ضمیر لبخندی زد و گفت: این‌ها که چیزی نیست؛ بگو برود از این تندتر و بدتر هم بگوید!"],[114,"هنوز آنچه گفت از بدم اندکی است","از آنها که من دانم از صد یکی است","عیوبی که او برشمرد اندکی از خطاهای من است؛ در مقایسه با آنچه من از باطن خود خبر دارم، این فقط یکی از صد تاست."],[114,"ز روی گمان بر من اینها که بست","من از خود یقین می‌شناسم که هست","آنچه او از روی حدس و گمان به من نسبت داد، من به یقین می‌دانم که در درونم وجود دارد."],[114,"وی امسال پیوست با ما وصال","کجا داندم عیب هفتاد سال؟","او تازه امسال مرا دیده است؛ خطاکاری‌ها و عیب‌های هفتاد سال عمر مرا از کجا می‌تواند بداند؟"],[114,"به از من کس اندر جهان عیب من","نداند به جز عالم الغیب من","در این عالم هیچ‌کس بهتر از خودم به کاستی‌هایم آگاه نیست، مگر پروردگارم که دانای رازهای پنهان است."],[114,"ندیدم چنین نیک پندار کس","که پنداشت عیب من این است و بس","من تا به حال کسی را به این خوش‌خیالی و خوش‌گمانی ندیده‌ام! چرا که او پنداشت تمام گناهان من فقط در همین چند مورد خلاصه می‌شود."],[114,"به محشر گواه گناهم گر اوست","ز دوزخ نترسم که کارم نکوست","اگر در روز رستاخیز تنها او شاهد گناهان من باشد، از آتش دوزخ ترسی ندارم؛ زیرا او کمتر از واقعیت به خطاهایم پی برده است."],[114,"گرم عیب گوید بد اندیش من","بیا گو ببر نسخه از پیش من","اگر آن بدخواه به دنبال عیب‌جویی از من است، بگو بیاید تا خودم طوماری کامل از بدی‌هایم را به دستش بدهم!"],[114,"کسان مرد راه خدا بوده‌اند","که برجاس تیر بلا بوده‌اند","کسانی به مقام مردان حق رسیده‌اند که خود را آماج و نشانه تیرهای سختی و سرزنش خلق کرده‌اند."],[114,"زبون باش چون پوستینت درند","که صاحبدلان بار شوخان برند","وقتی آبرویت را می‌برند، فروتن و بردبار باش و کینه به دل نگیر؛ زیرا اهل معنا همواره بار آزار و دریده‌رویی نادانان را با حلم تحمل می‌کنند."],[114,"گر از خاک مردان سبویی کنند","به سنگش ملامت کنان بشکنند","حتی اگر بعد از مرگ، از خاک مدفن مردان خدا کوزه‌ای بسازند، اهل ملامت و طعنه‌زنندگان آن کوزه را هم با سنگ درهم خواهند شکست (ملامت‌گر در هر صورت به کینه‌توزی خود ادامه می‌دهد)."],[115,"ملک صالح از پادشاهان شام","برون آمدی صبحدم با غلام","ملک صالح، یکی از پادشاهان شام، صبح زود از کاخ خود خارج شد و به همراه یکی از غلامانش به بیرون رفت."],[115,"بگشتی در اطراف بازار و کوی","به رسم عرب نیمه بر بسته روی","ملک صالح در اطراف بازار و کوی قدم می‌زد و به شیوه عرب‌ها، نیمه‌روی خود را پوشانده بود."],[115,"که صاحب نظر بود و درویش دوست","هر آن کاین دو دارد ملک صالح اوست","کسی که دارای بینش و دقت نظر است و دو درویش را دوست دارد، هر کسی که این دو ویژگی را دارد، دارای ملک و سرزمین نیکو و شایسته‌ای است."],[115,"دو درویش در مسجدی خفته یافت","پریشان دل و خاطر آشفته یافت","دو درویش را در مسجدی خوابیده دیدند که دل و خاطرشان ناراحت و در هم ریخته بود."],[115,"شب سردشان دیده نابرده خواب","چو حربا تأمل کنان آفتاب","در شب سرد، چشم آن دو درویش خوابشان نبرده بود و مانند حربا (کسی که در انتظار می‌ماند) در حال تأمل و فکر به آفتاب بودند."],[115,"یکی زآن دو می گفت با دیگری","که هم روز محشر بود داوری","یکی از آن دو شخص به دیگری می‌گوید که در روز قیامت، قضاوت و داوری برپا خواهد شد."],[115,"گر این پادشاهان گردن فراز","که در لهو و عیشند و با کام و ناز","اگر این پادشاهان مغرور که در خوشی و لذت هستند و با ناز و بزرگی رفتار می‌کنند، به چنین حالتی در روز قیامت برسند، باید بدانند."],[115,"در آیند با عاجزان در بهشت","من از گور سر بر نگیرم ز خشت","در بهشت، کسانی که عزیز و محترم هستند، به همراه افراد ناتوان و عاجز به ما می‌آیند، و من از گور برنمی‌خیزم و به راحتی نمی‌توانم بیدار شوم، مانند آنکه بر روی خشت دراز کشیده‌ام."],[115,"بهشت برین ملک و مأوای ماست","که بند غم امروز بر پای ماست","بهشت جا و سرزمین نیکو و مطلوب ماست، اما غم و اندوه امروز ما را به زنجیر کشیده و رهایمان نمی‌کند."],[115,"همه عمر از اینان چه دیدی خوشی","که در آخرت نیز زحمت کشی؟","تمام عمر از این افراد چه خوبی و خوشی دیده‌ای که در آخرت نیز با زحمت و رنج مواجه خواهی شد؟"],[115,"اگر صالح آنجا به دیوار باغ","بر آید، به کفتش بدرم دماغ","اگر انسان صالحی در آنجا به دیوار باغ نزدیک شود، به او می‌گویم که به تیرگی‌ام مگیر و از من دوری کن."],[115,"چو مرد این سخن گفت و صالح شنید","دگر بودن آنجا مصالح ندید","وقتی آن مرد این حرف را زد و صالح آن را شنید، دیگر چیزی در آنجا وجود نداشت که به مصالح و مفاسد مربوط باشد."],[115,"دمی رفت تا چشمه آفتاب","ز چشم خلایق فرو شست خواب","مردی اندکی به دور رفته تا چشمه آفتاب، خواب مردم را از چشمانشان بشوید و بیدارشان کند."],[115,"دوان هر دو را کس فرستاد و خواند","به هیبت نشست و به حرمت نشاند","هر دو را کسی فرستاد و دعوت کرد تا با وقار و احترام بر جایگاه ویژه‌ای بنشینند."],[115,"بر ایشان ببارید باران جود","فرو شستشان گرد ذل از وجود","بر آن دو نفر رحمت خدا نازل شد و بخشندگی آنچنان بر آنان جاری شد که هرگونه ذلت و فرصت‌طلبی از وجودشان زدوده شد."],[115,"پس از رنج سرما و باران و سیل","نشستند با نامداران خیل","پس از تحمل سختی‌ها و نامساعدی‌های سرما، باران و سیل، گدایان در کنار افراد محترم و مشهور نشسته‌اند."],[115,"گدایان بی جامه شب کرده روز","معطر کنان جامه بر عود سوز","گدایان بدون لباس، شب را به صبح می‌رسانند و در طول روز با خوشبویی مانند عود که می‌سوزد، عطر می‌پراکنند."],[115,"یکی گفت از اینان ملک را نهان","که ای حلقه در گوش حکمت جهان","یکی از گدایان به دیگری می‌گوید که هیچ‌کس از این افراد معانی عمیق و حکمت‌های جهان را نمی‌فهمد، همچنان‌که انگشتری در گوش کسی که آن را نمی‌بیند، پنهان است."],[115,"پسندیدگان در بزرگی رسند","ز ما بندگانت چه آمد پسند؟","پسندیده‌ شدگان در مقام و عظمت به حقیقت می‌رسند، اما از بندگان ما چه چیز مورد پسند و رضایت است؟"],[115,"شهنشه ز شادی چو گل بر شکفت","بخندید در روی درویش و گفت","شاه از خوشحالی مانند گل شکفته شده لبخند زد و به درویش گفت."],[115,"من آن کس نیم کز غرور حشم","ز بیچارگان روی در هم کشم","من از آن دسته نیستم که به خاطر خودبزرگ‌بینی و غرور، به بیچارگان بی‌احترامی کنم و چهره‌ام را از آن‌ها برگردانم."],[115,"تو هم با من از سر بنه خوی زشت","که ناسازگاری کنی در بهشت","تو نیز مانند من، خود را از کردار زشت دور کن، زیرا اگر با من ناسازگار باشی، جایی در بهشت نخواهی داشت."],[115,"من امروز کردم در صلح باز","تو فردا مکن در به رویم فراز","من امروز تلاش کردم تا در صلح و آرامش با تو رفتار کنم، ولی تو فردا مرا در مقابل خودت با برتری و تکبر مواجه نکن."],[115,"چنین راه اگر مقبلی پیش گیر","شرف بایدت دست درویش گیر","اگر می‌خواهی به مقام و شرف برسی، باید تواضع را پیشه کنی و به درویش‌ها (بی‌نوایان) کمک کنی."],[115,"بر از شاخ طوبی کسی بر نداشت","که امروز تخم ارادت نکاشت","هیچ‌کس از درخت طوبی (که نماد رستگاری و معنویت است) میوه‌ای نچید، زیرا امروز کسی تخم ارادت و محبت را نمی‌کارد."],[115,"ارادت نداری سعادت مجوی","به چوگان خدمت توان برد گوی","اگر ارادت و دوستی نداری، به دنبال سعادت و خوشبختی نباش، چون تنها با خدمت و وفاداری می‌توان برنده شد."],[115,"تو را کی بود چون چراغ التهاب","که از خود پری همچو قندیل از آب؟","تو چه کسی هستی که به اندازه یک چراغ احساسات و شور و هیجان داشته باشی، در حالی که تو فقط به خاطر آب، مثل چراغی معلق از آب، وجود داری؟"],[115,"وجودی دهد روشنایی به جمع","که سوزیش در سینه باشد چو شمع","وجودی که مانند شمع در سینه‌اش آتش عشق و احساس می‌سوزد، به دیگران نوری می‌دهد و به جمع روشنایی می‌بخشد."],[116,"یکی در نجوم اندکی دست داشت","ولی از تکبر سری مست داشت","شخصی از علم نجوم و ستاره‌شناسی اندکی سررشته داشت، اما به خاطر همان دانش اندک، سرش از باد غرور و خودبینی سرمست و مغرور شده بود."],[116,"بر کوشیار آمد از راه دور","دلی پر ارادت، سری پر غرور","او از راهی دور نزد «کوشیار گیلانی» (دانشمند و منجم برجسته) رفت؛ در حالی که از سویی ادعای ارادت و شاگردی داشت، اما از سوی دیگر ذهنش آکنده از نخوت و ادعا بود."],[116,"خردمند از او دیده بردوختی","یکی حرف در وی نیاموختی","آن حکیم فرزانه (کوشیار) به او بی‌اعتنایی کرد، از او چشم پوشید و حتی یک نکته علمی یا حرف تازه هم به او یاد نداد."],[116,"چو بی بهره عزم سفر کرد باز","بدو گفت دانای گردن فراز","هنگامی که جوان دید چیزی نیاموخته و دست‌خالی قصد بازگشت کرد، آن دانای والامقام و بلندمرتبه به او گفت:"],[116,"تو خود را گمان برده‌ای پر خرد","انائی که پر شد دگر چون برد؟","تو گمان کرده‌ای که خودت سراپا عقل و دانشی؛ ظرفی (انائی) که تا لبه پر باشد، دیگر چگونه می‌تواند چیزی را در خود جای دهد؟ (ذهنی که از ادعا پر است، جایی برای پذیرش علم نو ندارد)."],[116,"ز دعوی پری زان تهی می‌روی","تهی آی تا پر معانی شوی","تو سرشار از ادعا و غروری، به همین سبب هم اکنون دست‌خالی و بی‌بهره بازمی‌گردی؛ اگر می‌خواهی سرشار از معنا و حکمت حقیقی شوی، باید فارغ از خودخواهی و ادعا نزد استاد بیایی."],[116,"ز هستی در آفاق سعدی صفت","تهی گرد و باز آی پر معرفت","مانند سعدی در این جهان از کبر، منیت و خودبینی خالی شو؛ آن‌گاه خواهی دید که سرشار از شناخت، بصیرت و معرفت بازخواهی گشت."],[117,"به خشم از ملک بنده‌ای سربتافت","بفرمود جستن کسش در نیافت","به خاطر خشم، بنده‌ای از دست ملک (سلطان) مخالفت کرد و فرمان داد که کسی را برای گرفتن او بفرستند، اما هیچ‌کس نتوانست او را پیدا کند."],[117,"چو بازآمد از راه خشم و ستیز","به شمشیر زن گفت خونش بریز","وقتی که آن شخص از راه خشم و نزاع بازگشت، به کسی که شمشیر به دست داشت دستور داد که خون او (بنده) را بریزد."],[117,"به خون تشنه جلاد نامهربان","برون کرد دشنه چو تشنه زبان","جلاد بی‌رحم که به خون تشنه است، دشنه را مانند کسی که به آب تشنه است، بیرون می‌آورد."],[117,"شنیدم که گفت از دل تنگ ریش","خدایا بحل کردمش خون خویش","من شنیدم که او از دل تنگ و ناراحت خود گفت: خدایا، مشکل و غم من را برطرف کن، چرا که خودم را به شدت مجروح کردم."],[117,"که پیوسته در نعمت و ناز و نام","در اقبال او بوده‌ام دوستکام","من همیشه در نعمت و خوشی بوده‌ام و در موقعیت خوب و مورد پسند او قرار داشته‌ام."],[117,"مبادا که فردا به خون منش","بگیرند و خرم شود دشمنش","نگران این نباش که فردا به خاطر شخصیت و منش تو کسی به تو آسیب بزند و دشمن شاد و خوشحال شود."],[117,"ملک را چو گفت وی آمد به گوش","دگر دیگ خشمش نیاورد جوش","وقتی شاه به او خبر داد که او به خدمت آمده، دیگر خشم او فروکش کرد و دیگر در اوج خشمش قرار نگرفت."],[117,"بسی بر سرش داد و بر دیده بوس","خداوند رایت شد و طبل و کوس","بسیار بر سر او فریاد می‌زدند و او را می‌بوسیدند و این خداوندی که پرچم را در دست داشت، صدای طبل و سنج را به راه انداخت."],[117,"به رفق از چنان سهمگن جایگاه","رسانید دهرش بدان پایگاه","به لطف زمان، او را به جایی مهم و باارزش رسانید که شایسته‌اش بود."],[117,"غرض زین حدیث آن که گفتار نرم","چو آب است بر آتش مرد گرم","هدف از این سخن این است که کلام ملایم و نرم مانند آب است که می‌تواند آتش یک فرد تندخو و خشمگین را خاموش کند."],[117,"تواضع کن ای دوست با خصم تند","که نرمی کند تیغ برنده کند","ای دوست، در مواجهه با دشمن تندخو تواضع کن؛ زیرا نرمی می‌تواند تیزی شمشیر را کاهش دهد."],[117,"نبینی که در معرض تیغ و تیر","بپوشند خفتان صد تو حریر","آیا نمی‌بیند که در برابر تیغ و تیر، لباس زبر و خشن بر تن می‌کنند و نه صد تا لباس حریر نرم و لطیف؟"],[118,"ز ویرانه عارفی ژنده پوش","یکی را نباح سگ آمد به گوش","از ویرانه یک عارف فقیر و ساده‌لب، صدای نباح (زنگ) سگی به گوش می‌رسد."],[118,"به دل گفت گویی سگ اینجا چراست؟","درآمد که درویش صالح کجاست؟","در دلش گفت که سگ اینجا چه کار میکند؟ و درویش صالح کجاست؟"],[118,"نشان سگ از پیش و از پس ندید","به جز عارف آنجا دگر کس ندید","نشانی از سگ آنجا ندید و فقط عارف را دید"],[118,"خجل باز گردیدن آغاز کرد","که شرم آمدش بحث این راز کرد","عارف پس از شنیدن این بحث، دچار خجالت شد و برگشت، زیرا از اینکه به این راز پی برده بود، شرمنده بود."],[118,"شنید از درون عارف آواز پای","هلا گفت بر در چه پایی؟ در آی","عارف از درون خانه صدای پای کسی را شنید که به در می‌زند و از او می‌پرسد که چرا در را باز نمی‌کند و به او دعوت می‌کند تا وارد شود."],[118,"مپندار ای دیده روشنم","کز ایدر سگ آواز کرد، این منم","ای چشمان بینای من، گمان نکن که صدای سگ از اینجا به گوش می‌رسد، بلکه این صدای من است که به گوش می‌رسد."],[118,"چو دیدم که بیچارگی می‌خرد","نهادم ز سر کبر و رای و خرد","وقتی دیدم که بیچارگی و ضعف را می‌فروشند، از سر خودخواهی و عقل و فکر خود دست کشیدم و تواضع کردم."],[118,"چو سگ بر درش بانگ کردم بسی","که مسکین تر از سگ ندیدم کسی","وقتی که به در خانه‌اش (شخصی که منظور است) بسیار صدا زدم و زوزه کردم، متوجه شدم که هیچ‌کس به اندازه سگ، در نیازمندی و بیچارگی نیست."],[118,"چو خواهی که در قدر والا رسی","ز شیب تواضع به بالا رسی","اگر می‌خواهی به مقام و مرتبه بلندی برسی، باید از راه خاکساری و تواضع بالا بروی."],[118,"در این حضرت آنان گرفتند صدر","که خود را فروتر نهادند قدر","در این مقام کسانی به جایگاه عالی دست یافتند که خود را پایین‌تر از دیگران قرار دادند."],[118,"چو سیل اندر آمد به هول و نهیب","فتاد از بلندی به سر در نشیب","وقتی سیل با شدت و فریاد وارد می‌شود، از ارتفاع می‌افتد و به سمت پایین می‌رود."],[118,"چو شبنم بیفتاد مسکین و خرد","به مهر آسمانش به عیوق برد","مانند شبنمی که به زمین می‌افتد، انسان ضعیف و نیازمند هم به سبب محبت آسمان (خدا) به خوشی و نعمت برده می‌شود."],[119,"گروهی برآنند از اهل سخن","که حاتم اصم بود، باور مکن","برخی از اهل ادب بر این باورند که حاتم اصم شاعر بود، اما تو این حرف را قبول نکن."],[119,"برآمد طنین مگس بامداد","که در چنبر عنکبوتی فتاد","صدای مگس در صبحگاه به گوش می‌رسد، و او در دام تارهای عنکبوت گرفتار شده است."],[119,"همه ضعف و خاموشیش کید بود","مگس قند پنداشتش قید بود","ضعف و ساکت بودن مگس در واقع حیله‌ای بود، او فکر کرده بود که به قند وابسته شده و گرفتار شده است."],[119,"نگه کرد شیخ از سر اعتبار","که ای پایبند طمع پای دار","شیخ (حاتم اصم) از روی احترام و اعتبار به آن شخص نگاه کرد و گفت: ای کسی که به طمع وابسته‌ای، پای تو (در این دنیا) ثابت و پابرجا نخواهد بود."],[119,"نه هر جا شکر باشد و شهد و قند","که در گوشه‌ها دامیار است و بند","هر جا که شکر و شیرینی وجود دارد، همیشه خوشی و آسایش نیست؛ ممکن است در کنار این لذت‌ها دام‌هایی برای فریب وجود داشته باشد."],[119,"یکی گفت از آن حلقه اهل رای","عجب دارم ای مرد راه خدای","یکی از افراد گفت که از آن گروه کسانی که راه درست را می‌شناسند، تعجب می‌کنم، ای مردی که در مسیر حقیقت حرکت می‌کنی."],[119,"مگس را تو چون فهم کردی خروش","که ما را به دشواری آمد به گوش؟","تو که صدای مگس را فهمیدی و به وضوح می‌شنوی، چرا به ما که در سختی قرار داریم، اهمیتی نمی‌دهی و به ندای ما نمی‌رسی؟"],[119,"تو آگاه گشتی به بانگ مگس","نشاید اصم خواندنت زین سپس","پس از اینکه از صدای مگس آگاه شدی، دیگر نیازی نیست که تو را «ناشنوا» یا «احمق» بخوانند."],[119,"تبسم کنان گفت ای تیز هوش","اصم به که گفتار باطل نیوش","حاتم اصم، شخص دقت‌نظر و تیزهوشی، با لبخند به کسی می‌گوید که بهتر است به حرف‌های بی‌اساس توجه نکند."],[119,"کسانی که با ما به خلوت درند","مرا عیب پوش و ثنا گسترند","کسانی که در خلوت با من هستند، عیب‌های من را پنهان می‌کنند و در عوض، مرا ستایش می‌کنند."],[119,"چو پوشیده دارند اخلاق دون","کند هستیم زیر، طبع زبون","زمانی که عیب‌های ما را پنهان می‌کنند و تا حدی تواضع نشان می‌دهند، در حقیقت زیر این ظاهرسازی، شخصیت و خوی زشت ما نهفته است."],[119,"فرا می‌نمایم که می‌نشنوم","مگر کز تکلف مبرا شوم","به نظر می‌رسد که می‌خواهم خودم را نشان دهم و در جمع حاضر باشم، اما این فقط به خاطر این است که از تشریفات و تظاهر آزاد شوم."],[119,"چو کالیو دانندم اهل نشست","بگویند نیک و بدم هر چه هست","اگر مرا همچون کالیو (یکی از شخصیت‌های بافرهنگ و حکیم) بدانند، هرچه که باشد، خوب و بد من را خواهند گفت."],[119,"اگر بد شنیدن نیاید خوشم","ز کردار بد دامن اندر کشم","اگر انتقاد از رفتار بد من به گوشم نرسد، از کردار ناپسند خود لذت می‌برم و خود را در آن غرق می‌کنم."],[119,"به حبل ستایش فرا چه مشو","چو حاتم اصم باش و عیبت شنو","به دام ستایش و تعریف دیگران بیفتید و به آن نپردازید، مانند حاتم اصم که به عیب‌جویی دیگران گوش می‌داد."],[120,"عزیزی در اقصای تبریز بود","که همواره بیدار و شب خیز بود","شخص گرانقدری اهل تبریز و اهل عبادت شب بود."],[120,"شبی دید جایی که دزدی کمند","بپیچید و بر طرف بامی فکند","یک شب در جایی دید که دزدی طناب به سوی بام خانه‌ای افکند (که بالا برود)"],[120,"کسان را خبر کرد و آشوب خاست","ز هر جانبی مرد با چوب خاست","(مرد پارسا) مردم را بیدار کرد؛ فریاد و آشوب بلند شد و از هر سوی مردم چوب‌به‌دست بدانجا سرازیر شدند."],[120,"چو نامردم آواز مردم شنید","میان خطر جای بودن ندید","هنگامی‌که آن دزد نامردم‌، بانگ و فریاد مردم را شنید فرار را بر قرار ترجیح داد."],[120,"نهیبی از آن گیر و دار آمدش","گریز به وقت، اختیار آمدش","آن فریاد و غوغا، در دلش ترسی افکند؛ فرصت‌یافت و از آنجا گریخت."],[120,"ز رحمت دل پارسا موم شد","که شب دزد بیچاره محروم شد","(اما) دل آن مرد پارسا (که دزد) را از دزدی محروم کرد، به‌حال دزد سوخت."],[120,"به تاریکی از پی فراز آمدش","به راهی دگر پیشباز آمدش","در تاریکی در پی او رفت و از کوچه‌ای و راهی دیگر به پیشباز (و مقابل) او رفت."],[120,"که یارا مرو کآشنای توام","به مردانگی خاک پای توام","(و به او گفت) که ای یار (‌هم‌پیشه) جایی مرو که من دوست تو (و مثل تو دزد) هستم و می‌دانم که تو مردی و شجاعت تو را قبول دارم."],[120,"ندیدم به مردانگی چون تو کس","که جنگاوری بر دو نوع است و بس","آدمی شجاع مثل تو ندیده‌ام زیرا شجاعت و جنگاوری بر دو نوع است؛"],[120,"یکی پیش خصم آمدن مردوار","دوم جان به در بردن از کارزار","یکی جنگیدن با دشمن و دیگری جان سالم به‌در بردن در جنگ."],[120,"بر این هر دو خصلت غلام توام","چه نامی؟ که مولای نام توام","شجاعت تو را در این دو خصلت و در این‌باره، قبول دارم و نوکر تو هستم، (مانند غلام خود) نامی برایم انتخاب کن که برده تو هستم (مولا در اینجا یعنی غلام)"],[120,"گرت رای باشد به حکم کرم","به جایی که می‌دانمت ره برم","اگر از روی بزرگی تصمیم بگیری و (پیشنهادم را بپذیری) به جایی که می‌دانم تو را راهنمایی می‌کنم."],[120,"سرایی است کوتاه و در بسته سخت","نپندارم آنجا خداوند رخت","خانه‌ای کوتاه‌دیوار هست با دری قفل شده و فکر‌می‌کنم که صاحب‌خانه در خانه نیست."],[120,"کلوخی دو بالای هم بر نهیم","یکی پای بر دوش دیگر نهیم","(کاری است آسان) دو کلوخ روی هم می‌گذاریم و پای بر دوش دیگری می‌نهیم (و بالا می‌رویم.)"],[120,"به چندان که در دستت افتد بساز","از آن به که گردی تهیدست باز","هر چه به‌دست آوردی قانع باش؛ از اینکه امشب بی‌هیچ‌چیزی برگردی بهتر است."],[120,"به دل‌داری و چاپلوسی و فن","کشیدش سوی خانه خویشتن","با چرب‌زبانی و حیله او را به‌سوی خانه خود برد."],[120,"جوانمرد شبرو فرو داشت دوش","به کتفش برآمد خداوند هوش","دزد خم شد و (مرد پارسا) پای بر دوش او نهاد و (از دیوار) بالا رفت."],[120,"بغلطاق و دستار و رختی که داشت","ز بالا به دامان او در گذاشت","مقداری وسایل و لباس و رخت از روی دیوار به او داد. (غلطاق: چوب زین)"],[120,"وز آنجا برآورد غوغا که دزد","ثواب ای جوانان و یاری و مزد","(پس از این) از آنجا بانگ کمک برآورد که بیایید دزد را بگیرید و ثواب و مزد ببرید!"],[120,"به در جست از آشوب، دزد دغل","دوان، جامه پارسا در بغل","آن دزد دغل از آشوبی که برخواست‌، همراه با وسایل و جامه‌ها گریخت."],[120,"دل آسوده شد مرد نیک اعتقاد","که سرگشته‌ای را برآمد مراد","آن مرد نیک‌نظر و پارسا خیالش آسوده شد که آدم سرگشته‌ای به مراد خود رسید."],[120,"خبیثی که بر کس ترحم نکرد","ببخشود بر وی دل نیکمرد","نابکار و خبیثی که به کسی رحم و ترحم نمی‌کرد، آن مرد نیک بر او بخشود."],[120,"عجب ناید از سیرت بخردان","که نیکی کنند از کرم با بدان","از سیرت و سرشت خردمندان عجیب و دور از انتظار نیست که از کرم و بزرگ‌منشی حتی بر بدان نیکی می‌کنند."],[120,"در اقبال نیکان بدان می‌زیند","وگرچه بدان اهل نیکی نیند","در اقبال و سایه نیکان است که بدان می‌زیند و روزی می‌خورند‌، اگرچه بدان اهل بخشش و نیکی نیستند."],[121,"یکی را چو سعدی دلی ساده بود","که با ساده رویی در افتاده بود","یک نفر مانند سعدی، دلش ساده و بی‌آلایش بود و به خاطر سادگی خود، با زیبا روی نوجوانی رو به رو شده بود."],[121,"جفا بردی از دشمن سختگوی","ز چوگان سختی بخستی چو گوی","که از آدم بد سخنی اینهمه ستم دیدی مانند گوی که ضربات محکم چوگان اینگونه آسیب دیده"],[121,"ز کس چین بر ابرو نینداختی","ز یاری به تندی نپرداختی","تو از کسی نرنجیدی،ناراحت نشدی ،چین به ابرو ننداختی و از روی عشق و محبت و دوست داشتن با هیچ کس تند خویی نمی کنی ."],[121,"یکی گفتش آخر تو را ننگ نیست؟","خبر زین همه سیلی و سنگ نیست؟","یکی به سعدی می‌گوید: آیا تو هیچ شرمی نداری؟ آیا از همه کتک‌ها و توهین‌هایی که به تو شده، هیچ خبری نداری؟"],[121,"تن خویشتن سغبه دونان کنند","ز دشمن تحمل زبونان کنند","تن خود را به خاطر انسان‌های پست و بی‌مقدار به ستم می‌سپارند، و از دشمنان، به خاطر ذلت و سستی، تحمل می‌کنند."],[121,"نشاید ز دشمن خطا درگذاشت","که گویند یارا و مردی نداشت","نباید از خطای دشمن گذشت و آن را نادیده گرفت، زیرا در این صورت می‌گویند که دوستی و مردی در میان نیست."],[121,"بدو گفت شیدای شوریده سر","جوابی که شاید نبشتن به زر","شیدای شوریده‌سر (مجنون) به او (لیلی) گفت: شاید بتوان جوابی به این زیبایی نوشت که از طلا هم باارزش‌تر باشد."],[121,"دلم خانه ی مهر یار است و بس","از آن می‌نگنجد در او کین کس","دل من فقط جای عشق یار است و به همین دلیل هیچ کینه‌ای نمی‌تواند در آن جا بگیرد."],[121,"چه خوش گفت بهلول فرخنده خوی","چو بگذشت بر عارفی جنگجوی","بهلول، شخصی خوش‌زبان و خوش‌خلق، به عارفی جنگجو که در حال گذر بود، سخن نیکویی گفت."],[121,"گر این مدعی دوست بشناختی","به پیکار دشمن نپرداختی","اگر این مدعی (دوست) را می‌شناختی، هرگز با دشمن به جنگ نمی‌پرداختی."],[121,"گر از هستی حق خبر داشتی","همه خلق را نیست پنداشتی","اگر از واقعیت وجود حق (خدا) آگاهی داشتی، دیگر مردم را بی‌ارزش و ناچیز نمی‌انگاشتی."],[122,"شنیدم که لقمان سیه‌فام بود","نه تن‌پرور و نازک‌اندام بود","شنیدم که لقمان، شخصیتی با پوست تیره و رنگین و نه فردی لاغر و نازک و ضعیف بود."],[122,"یکی بنده خویش پنداشتش","زبون دید و در کار گل داشتش","یک نفر، لقمان را که بنده خود می‌دانست، شخصی حقیر و پست تصور کرد و در کار خود از او بهره‌برداری می‌کرد."],[122,"جفا دید و با جور و قهرش بساخت","به سالی سرایی ز بهرش بساخت","بنده، بد رفتاری و ظلم دیگران را تحمل کرد و با آنها مدارا نمود، و در عوض، در طول سال، خانه‌ای به خاطر او ساخت."],[122,"چو پیش آمدش بنده رفته باز","ز لقمانش آمد نهیبی فراز","وقتی بنده‌ای که به لقمان ظلم کرده بود دوباره به او نزدیک شد، لقمان با شنیدن این خبر، به او هشدار داد."],[122,"به پایش در‌افتاد و پوزش نمود","بخندید لقمان که پوزش چه سود؟","بنده به پای لقمان افتاد و از او عذرخواهی کرد، اما لقمان با لبخندی پاسخ داد که عذرخواهی کردن فایده‌ای ندارد."],[122,"به سالی ز جورت جگر خون کنم","به یک ساعت از دل به در چون کنم؟","اگر به خاطر طعنه یا ملامتی از کسی دلم را به شدت رنجیده‌ام و سال‌ها به این ناراحتی دچار شدم، حالا چگونه می‌توانم در یک لحظه این غم را از دل ببرم؟"],[122,"ولی هم ببخشایم ای نیک‌مرد","که سود تو ما را زیانی نکرد","ای مرد خوب، من هم تو را می‌بخشم، چون سود تو برای ما ضرری نداشت."],[122,"تو آباد کردی شبستان خویش","مرا حکمت و معرفت گشت بیش","تو با علم و دانش خود، منزلت و جایگاه من را بهبود بخشیدی و به وسیله‌ی حکمت و شناخت، مرا آدمی آگاه‌تر کردی."],[122,"غلامی است در خیلم ای نیک‌بخت","که فرمایمش وقت‌ها کار سخت","غلامی در اختیار من است که او را به انجام کارهای دشوار می‌گمارم و این نشان از خوش‌بختی من است."],[122,"دگر ره نیازارمش سخت، دل","چو یاد آیدم سختی کار گل","دیگر نمی‌خواهم او را به زحمت بیندازم، زیرا هر زمان که به سختی‌های کار گل فکر می‌کنم، دلم به درد می‌آید."],[122,"هر آن کس که جور بزرگان نبرد","نسوزد دلش بر ضعیفان خرد","هر کسی که ظلم و ستم بزرگان را تحمل نکند، دلش برای کسانی که ضعیف و کوچکتر از او هستند نمی‌سوزد."],[122,"گر از حاکمان سختت آید سخن","تو بر زیردستان درشتی مکن","اگر از سخنان حاکمان آزرده‌خاطر هستی، بر زیردستان خشم نریز و با آنها بدرفتاری نکن."],[122,"نکو گفت بهرام‌شه با وزیر","که دشوار با زیردستان مگیر","بهرام‌شاه به وزیرش گفت که با زیردستان به سختی رفتار نکن و آنها را اذیت نکن."],[123,"شنیدم که در دشت صنعا جنید","سگی دید برکنده دندان صید","شنیده‌ام که در بیابان صنعا، جنید بغدادی (عارف بزرگ) سگی شکاری را دید که دندان‌های صیدش فروریخته و از کار افتاده بود."],[123,"ز نیروی سر پنجه شیر‌گیر","فرومانده عاجز چو روباه پیر","آن سگ از زور و چابکی پنجه‌های شیرگیرش افتاده بود و اکنون مانند روباهی پیر، ناتوان و درمانده شده بود."],[123,"پس از غرم و آهو گرفتن به پی","لگد خوردی از گوسفندان حی","سگی که روزگاری در پی‌گرفتن بزهای کوهی (غرم) و آهوان تیزپا نامدار بود، اکنون از گوسفندان قبیله (حی) لگد می‌خورد."],[123,"چو مسکین و بی‌طاقتش دید و ریش","بدو داد یک نیمه از زاد خویش","وقتی جنید سگ را این‌گونه درمانده، ناتوان و مجروح (ریش) یافت، نیمی از توشه و خوراک سفر خود را به او بخشید."],[123,"شنیدم که می‌گفت و خوش می‌گریست","که داند که بهتر ز ما هر دو کیست؟","شنیدم که جنید اشک می‌ریخت و با حسرت می‌گفت: چه کسی از باطن امور باخبر است تا بداند در پیشگاه خدا کدام‌یک از ما دو تا برتر است؟"],[123,"به ظاهر من امروز از این بهترم","دگر تا چه راند قضا بر سرم","امروز به ظاهر حال و منزلت من از این حیوان بهتر است، اما نمی‌دانم قضا و قدر الهی تا پایان عمر چه سرنوشتی برای من رقم خواهد زد."],[123,"گرم پای ایمان نلغزد ز جای","به سر بر نهم تاج عفو خدای","اگر تا پایان کار پای ایمانم در دینداری نلغزد و عاقبت‌به‌خیر شوم، به لطف و بخشش الهی به رستگاری و عزت ابدی می‌رسم؛"],[123,"وگر کسوت معرفت در برم","نماند، به بسیار از این کمترم","اما اگر جامه معرفت و ایمان از تنم درآید و بی‌عاقبت شوم، جایگاه من بسیار پست‌تر از این سگ خواهد بود؛"],[123,"که سگ با همه زشت‌نامی چو مرد","مر او را به دوزخ نخواهند برد","چرا که سگ با تمام پستی و بدنامی ظاهری‌اش، پس از مرگ بازخواستی ندارد و او را به دوزخ نمی‌برند (چون بار تکلیف و مسئولیتی بر دوش او نبوده است)."],[123,"ره این است سعدی که مردان راه","به عزّت نکردند در خود نگاه","ای سعدی، راه و رسم حقیقت همین است؛ سالکان و مردان واقعی راه خدا هیچ‌گاه به خود با غرور و خودبزرگ‌بینی ننگریستند."],[123,"از‍‍‍‍‍‍‍‍ آن بر ملائک شرف داشتند","که خود را به از سگ نپنداشتند","آنان بدان سبب بر فرشتگان برتری و فضیلت یافتند که از نهایت فروتنی و شکسته‌نفسی، خود را حتی از سگی ناتوان هم برتر نمی‌دانستند."],[124,"یکی بربطی در بغل داشت مست","به شب در سر پارسایی شکست","نوازنده بربطی بود که در حال مستی بربط را بر سر آدم پارسایی کوبید و آن‌را شکست."],[124,"چو روز آمد آن نیک‌مرد سلیم","بر سنگدل برد یک مشت سیم","روز بعد آن پارسای نیک‌مرد‌، مقداری پول برای آن آدم بی‌مروّت برد."],[124,"که دوشینه معذور بودی و مست","تو را و مرا بربط و سر شکست","که دیشب تو مست و معذور بودی که بربط خود و سر مرا شکستی."],[124,"مرا به شد آن زخم و برخاست بیم","تو را به نخواهد شد الّا به سیم","زخم من خوب شد و جای نگرانی نیست اما تو برای خرید بربط به پول نیاز داری."],[124,"از این دوستان خدا بر سرند","که از خلق بسیار بر سر خورند","از این‌رو دوستان خدا، گرامی و عزیز هستند که بسیار از مردم جور می‌بینند."],[125,"شنیدم که در خاک وخش از مهان","یکی بود در کنج خلوت نهان","شنیده‌ام که در ولایت «وخش» از مهان، شخصی بود که خلوت گزیده‌بود."],[125,"مجرّد به معنی نه عارف به دلق","که بیرون کند دست حاجت به خلق","عارف و فقیر به‌معنای کلمه نه فقط یک عارف به‌لباس و ظاهر که به مردم دست‌ حاجت دراز کند."],[125,"سعادت گشاده دری سوی او","در از دیگران بسته بر روی او","نیکبختی به‌او دری گشوده بود و او در خلوت و به‌دور از دیگران بود."],[125,"زبان‌آوری بی‌خرد سعی کرد","ز شوخی به بد گفتن نیک‌مرد","شاعری نادان با بی‌شرمی از او بد گفت."],[125,"که زنهار از این مکر و دستان و ریو","بجای سلیمان نشستن چو دیو","که وای از این حیله و ریا که او دارد و همچون دیو‌، خود را بجای سلیمان جا می‌زند."],[125,"دمادم بشویند چون گربه روی","طمع‌کرده در صید موشان کوی","این‌ها خود را پاک نشان می‌دهند (یا مدام وضو می‌گیرند) اما هدف‌شان چیز دیگری است. (یعنی مثل گربه زاهد هستند که قصد جلب اعتماد موش‌ها را دارد)"],[125,"ریاضت‌کش از بهر نام و غرور","که طبل تهی را رود بانگ دور","برای خودنمایی و نام‌، ریاضت‌کشی می‌کنند و نام‌شان همچون بانگ طبل تهی تا دوردست می‌رود."],[125,"همی‌گفت و خلقی بر او انجمن","بر ایشان تفرّج‌کنان مرد و زن","اینها را می‌گفت و جمعی مرد و زن دور او جمع شده‌بودند و تفریح می‌کردند."],[125,"شنیدم که بگریست دانای وخش","که یارب مر این بنده را توبه بخش","شنیده‌ام آن پیر دانای اهل وخش، بگریست و گفت خدایا این بنده گناهکار را نعمت توبه ببخش."],[125,"وگر راست گفت ای خداوند پاک","مرا توبه ده تا نگردم هلاک","و اگر راست گفت مرا نعمت توبه ببخش، ای خداوند پاک! تا هلاک و گمراه نشوم."],[125,"پسند آمد از عیب‌جوی خودم","که معلوم من کرد خوی بدم","کار عیب‌جوی خود را پسندیدم زیرا خوی بد مرا به‌من نمود و نشان داد."],[125,"گر آنی که دشمنت گوید، مرنج","وگر نیستی، گو برو بادسنج","اگر آن هستی که دشمنت می‌گوید رنجیده مشو و اگر آن نیستی که او می‌گوید پس به‌او بگو «برو و هرچقدر می‌خواهی اندیشه باطل کن»"],[125,"اگر ابلهی مشک را گنده گفت","تو مجموع باش او پراکنده گفت","اگر یک نادان، مشک را بدبو خواند‌، تو شاد باش که او بی‌خود و پراکنده گفت."],[125,"وگر می‌رود در پیاز این سخن","چنین است گو گنده‌مغزی مکن","وگر درباره پیاز این حرف را گفت، پس راست می‌گوید و به‌او بگو هرزه مگو."],[125,"نگیرد خردمند روشن‌ضمیر","زبان‌بند دشمن ز هنگامه‌گیر","نگیرد آدم روشن‌دل و پاک‌ضمیر، زبان‌بند دشمن ز هنگامه‌گیر"],[125,"نه آیین عقل است و رای و خرد","که دانا فریب مشعبد خورد","عاقلانه و خردمندانه نیست که آدم دانا، گول یک حیله‌گر را بخورد."],[125,"پس کار خویش آنکه عاقل نشست","زبان بداندیش بر خود ببست","آن‌که داناست زبان بداندیش و بدخواه را بر خود می‌بندد."],[125,"تو نیکو‌روش باش تا بدسگال","نیابد به نقص تو گفتن مجال","تو درست‌کار و نیکورفتار باش تا آدم بداندیش فرصت عیب‌جویی از تو را پیدا نکند."],[125,"چو دشوارت آمد ز دشمن سخن","نگر تا چه عیبت گرفت آن مکن","اگر حرف‌های دشمن تو را آزار می‌دهد ببین چه عیبی بر تو می‌گیرد پس آن‌را انجام مده."],[125,"جز آن کس ندانم نکو‌گوی من","که روشن کند بر من آهوی من","جز کسی را که عیب‌های مرا بر من آشکار می‌کند، نکوگوی‌ خود نمی‌دانم."],[126,"کسی مشکلی برد پیش علی","مگر مشکلش را کند منجلی","شخصی مسئله و مشکلی را نزد حضرت علی (ع) آورد تا مگر آن را برایش روشن و برطرف کند."],[126,"امیر عدوبند کشور‌گشای","جوابش بگفت از سر علم و رای","آن پیشوای اسیرکننده دشمنان و فاتح سرزمین‌ها، با تکیه بر دانش، عقل و اندیشه عمیق خود پاسخ او را داد."],[126,"شنیدم که شخصی در آن انجمن","بگفتا چنین نیست یا باالحسن","شنیده‌ام که فردی در آن جمع برخاست و به اعتراض گفت: ای ابالحسن (علی)، این‌گونه که می‌گویی نیست."],[126,"نرنجید از او حیدر نامجوی","بگفت ار تو دانی از این به بگوی","حیدر (علی (ع)) نام‌آور از سخن او آزرده نشد، بلکه فرمود: اگر پاسخی بهتر از این می‌دانی، بیان کن."],[126,"بگفت آنچه دانست و بایسته گفت","به گل چشمه خور نشاید نهفت","آن مرد آنچه را می‌دانست گفت و سخنی درست و شایسته ادا کرد؛ چرا که خورشید درخشان حقیقت را نمی‌توان با گل پوشاند."],[126,"پسندید از او شاه مردان جواب","که من بر خطا بودم او بر صواب","شاه مردان (حضرت علی) سخن او را پذیرفت و تحسین کرد و فرمود: من اشتباه می‌کردم و حق با او بود."],[126,"به از ما سخنگوی دانا یکی است","که بالاتر از علم او علم نیست","داناتر و بهتر از همه ما تنها یک سخنگوی خردمند وجود دارد و آن پروردگار یگانه‌ای است که دانشی فراتر از علم او نیست."],[126,"گر امروز بودی خداوند جاه","نکردی خود از کبر در وی نگاه","اگر حاکمان و صاحب‌منصبان امروزی در چنین جایگاهی بودند، از روی غرور و خودبزرگ‌بینی حتی به آن منتقد نگاه هم نمی‌کردند."],[126,"به در کردی از بارگه حاجبش","فرو‌کوفتندی به ناواجبش","دربان کاخ او را با خواری از مجلس بیرون می‌انداخت و مأموران به‌ناحق و ظالمانه او را کتک می‌زدند."],[126,"که من‌بعد بی‌آبرویی مکن","ادب نیست پیش بزرگان سخن","و به او می‌گفتند: دیگر چنین جسارتی مکن، زیرا در حضور بزرگان و قدرتمندان سخن گفتن و مخالفت خلاف ادب است!"],[126,"یکی را که پندار در سر بود","مپندار هرگز که حق بشنود","هرگز گمان مبر کسی که مغزش پر از غرور، خودبینی و توهم دانایی است، حقیقت و سخن حق را پذیرا شود."],[126,"ز علمش ملال آید از وعظ ننگ","شقایق به باران نروید ز سنگ","فرد مغرور از آموختن دانش دلزده می‌شود و شنیدن پند برایش مایه سرشکستگی است؛ همان‌طور که با بارش باران، گل شقایق بر سنگ سخت نمی‌روید."],[126,"گرت درّ دریای فضل است خیز","به تذکیر در پای درویش ریز","اگر از دریای فضل و کمال گوهری داری، برخیز و آن را با پند و اندرز، پیش پای انسان‌های فروتن و نیازمند معرفت نثار کن."],[126,"نبینی که از خاک افتاده خوار","بروید گل و بشکفد نوبهار","آیا نمی‌بینی تنها از خاکی که فروتنانه بر زمین افتاده، گل می‌روید و بهار شکوفا می‌شود؟"],[126,"مریز ای حکیم آستین‌های در","چو می‌بینی از خویشتن خواجه پر","ای دانای فرزانه، گوهر حکمت و سخن ارزشمندت را هدر نده هنگامی که می‌بینی فرد روبه‌رو از غرور و خودخواهی سرشار است."],[126,"به چشم کسان در‌نیاید کسی","که از خود بزرگی نماید بسی","کسی که ادعای بزرگی می‌کند و به خود می‌نازد، در چشم و دیدگاه دیگران کوچک و بی‌ارزش خواهد بود."],[126,"مگو تا بگویند شکرت هزار","چو خود گفتی از کس توقّع مدار","از خودت تمجید مکن تا مردم تو را ستایش و قدردانی کنند؛ زیرا وقتی خودت لب به خودستایی گشودی، دیگر نباید از کسی انتظار احترام و تعریف داشته باشی."],[127,"گدایی شنیدم که در تنگ‌جای","نهادش عمر پای بر پشت پای","شنیده‌ام که در گذرگاهی تنگ و شلوغ، پای خلیفه عمر ناخواسته بر پشت پای گدایی رفت."],[127,"ندانست درویش بیچاره کاوست","که رنجیده دشمن نداند ز دوست","آن گدای بینوا نشناخت که چه کسی پا روی پایش گذاشته است؛ چراکه انسان آسیب‌دیده و رنجور در هنگام خشم، توانایی تشخیص دوست را از دشمن ندارد."],[127,"برآشفت بر وی که کوری مگر؟","بدو گفت سالار عادل عمر","گدا با عصبانیت بر سر او فریاد زد: «مگر کوری؟» عمر، آن پیشوای دادگر، در پاسخش گفت:"],[127,"نه کورم ولیکن خطا رفت کار","ندانستم از من گنه در گذار","کور نیستم، بلکه اشتباهی پیش آمد و متوجه نشدم؛ از گناه و تقصیر من چشم‌پوشی کن و مرا ببخش."],[127,"چه منصف بزرگان دین بوده‌اند","که با زیردستان چنین بوده‌اند","بزرگان دین چه انسان‌های باانصاف و منصفی بوده‌اند که در برابر زیردستان و فرودستان جامعه تا این اندازه متواضع و بردبار رفتار می‌کردند."],[127,"فروتن بود هوشمند گزین","نهد شاخ پر‌میوه سر بر زمین","انسان دانا و برگزیده همواره اهل تواضع است؛ همانند شاخه درختی که هرچه پربارتر و پرمیوه‌تر باشد، سنگین‌تر شده و بیشتر سر به زیر و نزدیک زمین خم می‌شود."],[127,"بنازند فردا تواضع‌کنان","نگون از خجالت سر گردنان","در فردای قیامت، انسان‌های فروتن احساس سربلندی و افتخار می‌کنند؛ اما گردن‌کشان و متکبران از شرمساری سر به زیر و سرافکنده خواهند بود."],[127,"اگر می‌بترسی ز روز شمار","از آن کز تو ترسد خطا در‌گذار","اگر از حساب‌وکتاب روز قیامت هراس داری، از لغزش و خطای فردی که ضعیف‌تر از توست و از قدرت تو می‌ترسد، بگذر و عفو پیشه کن."],[127,"مکن خیره بر زیر‌دستان ستم","که دستی است بالای دست تو هم","بیهوده و گستاخانه بر افراد ناتوان و زیردست خود ستم روا مدار؛ زیرا فراموش نکن که بالاتر از قدرت و دست تو نیز قدرتی برتر (قدرت پروردگار) حاکم است."],[128,"یکی خوب‌کردار خوش‌خوی بود","که بد‌سیرتان را نکو‌گوی بود","شخصی بود که رفتار و منش خوبی داشت و با افراد بدسیرت به نیکی صحبت می‌کرد."],[128,"به خوابش کسی دید چون در‌گذشت","که باری حکایت کن از سرگذشت","کسی در خواب آن شخص خوش‌اخلاق را دید که پس از مرگش، کسی در مورد زندگی و سرگذشت او حکایت می‌کند."],[128,"دهانی به خنده چو گل باز کرد","چو بلبل به صوتی خوش آغاز کرد","کسی که در خواب دیده شده، لبخندی زیبا مانند گل بر لب دارد و با صدایی دلنشین و خوش شروع به صحبت می‌کند."],[128,"که بر من نکردند سختی بسی","که من سخت نگرفتمی بر کسی","در نسخه خرمشاهی: یعنی در جهان آخرت، رنج و عذابی ندیدم چون در این جهان به کسی سخت نگرفته بودم."],[129,"چنین یاد دارم که سقّای نیل","نکرد آب بر مصر سالی سبیل","یاد من هست که در سالی، سقا (آبیاری‌کننده) نیل (رود نیل) آب را بر مصر نریخت."],[129,"گروهی سوی کوهساران شدند","به فریاد خواهان باران شدند","گروهی به سمت کوه‌ها رفتند و با صدای بلند از باران درخواست کردند."],[129,"گرستند و از گریه جویی روان","نیامد مگر گریه آسمان","آن‌ها گرسنه بودند و به قدری گریه کردند که آب از چشمانشان سرازیر نشد، مگر اینکه باران آسمان بارید."],[129,"به ذوالنّون خبر برد از ایشان کسی","که بر خلق رنج است و زحمت بسی","به ذوالنون، کسی خبر داد که در میان مردم، زحمت و رنج زیادی دارد."],[129,"فرو‌ماندگان را دعایی بکن","که مقبول را رد نباشد سخن","برای کسانی که در وضعیت پست و فرودستی قرار دارند، دعا و نیکی کن، زیرا سخن کسی که در دل مورد قبول است هرگز رد نخواهد شد."],[129,"شنیدم که ذوالنّون به مدین گریخت","بسی بر نیامد که باران بریخت","شنیدم که ذوالنون مصری به مدین فرار کرد و باران زیادی در آنجا بارید."],[129,"خبر شد به مدین پس از روز بیست","که ابر سیه‌دل بر ایشان گریست","در مدین پس از گذشت بیست روز مطلع شدند که ابرهای سیاه بر آن‌ها باران می‌بارد."],[129,"سبک عزم باز‌آمدن کرد پیر","که پر شد به سیل بهاران غدیر","پیر (ذوالنون مصری) به آرامی و با تصمیم محکم برگشت که به دلیل بارش باران‌های بهاری، آب غدیر (رودی) پر شده است."],[129,"بپرسید از او عارفی در نهفت","چه حکمت در این رفتنت بود؟ گفت","عارفی که در حال حاضر پنهان است، از او پرسید که رفتن تو به کجا و به چه خاطر بود؟ او جواب داد."],[129,"شنیدم که بر مرغ و مور و ددان","شود تنگ روزی به فعل بدان","شنیدم که حتی برای مرغ، موری و ددان (موش‌ها) نیز روزی سخت و تنگ می‌شود به خاطر کارهای بد و ناپسند."],[129,"در این کشور اندیشه کردم بسی","پریشان‌تر از خود ندیدم کسی","در این سرزمین، وقتی به فکر فرو رفتم، کسی را پریشان‌تر از خودم ندیدم."],[129,"برفتم مبادا که از شرّ من","ببندد در خیر بر انجمن","من می‌ترسم که اگر از من آسیب یا ضرری به کسی برسد، در نیکی و خوبی بر جمع‌های مردم بسته شود."],[129,"بهی بایدت لطف کن کان بهان","ندیدندی از خود بتر در جهان","باید بر تو لطف کند چون در دنیا بدتر از خود را ندیده‌اند."],[129,"تو آنگه شوی پیش مردم عزیز","که مر خویشتن را نگیری به چیز","تو زمانی در نظر مردم محترم و ارزشمند خواهی بود که خود را به چیزهای مادی و دنیوی نگیرے و به عظمت درونیت توجه کنی."],[129,"بزرگی که خود را به خردی شمرد","به دنیا و عقبی بزرگی ببرد","بزرگی که خود را کوچک ببیند و تواضع کند، در دنیا و آخرت به مقام و بزرگی می‌رسد."],[129,"از این خاکدان بنده‌ای پاک شد","که در پای کمتر کسی خاک شد","از این دنیای فانی، بنده‌ای مخلص و پاک پاکتراز آنچه خیال می‌شود، به رحمت خدا رفت که غالبا در مقابل افراد کم‌قدر هم خضوع و تواضع می‌کرد."],[129,"الا ای که بر خاک ما بگذری","به خاک عزیزان که یاد آوری","ای کسی که بر خاک ما پا می‌گذاری، به یاد عزیزانت بیفت و به احترام آنها خاک را بوسه بزن."],[129,"که گر خاک شد سعدی، او را چه غم؟","که در زندگی خاک بوده‌ست هم","اگر سعدی هم به خاک برود، برای او نگران نباشید، چون او در زندگی هم همواره در میان خاک‌ها و مشکلات بوده است."],[129,"به بیچارگی تن فرا خاک داد","وگر گرد عالم برآمد چو باد","انسان، با فقری که به جسمش داده می‌شود، مانند خاک می‌شود، و حتی اگر بر افرازده و مشهور شود، همچنان مثل بادی است که می‌وزد و زودگذر است."],[129,"بسی برنیاید که خاکش خورد","دگر باره بادش به عالم برد","هیچ چیز نمی‌تواند او را از خاک بردارد، چرا که اگر باد هم او را به عالم ببرد، دوباره به خاک برمی‌گردد."],[129,"مگر تا گلستان معنی شکفت","بر او هیچ بلبل چنین خوش نگفت","تا زمانی که گلستان معنایی برای او شکوفا نشده، هیچ بلبل نمی‌تواند به زیبایی درباره‌اش سخن بگوید."],[129,"عجب گر بمیرد چنین بلبلی","که بر استخوانش نروید گلی","عجیب است اگر چنین بلبل نازنینی بمیرد و بر روی استخوانش گلی نروید."],[130,"شبی زیت فکرت همی سوختم","چراغ بلاغت می افروختم","شبی در اندیشه خود می‌سوختم و چراغ بلاغت را روشن می‌کردم."],[130,"پراکنده گویی حدیثم شنید","جز احسنت گفتن طریقی ندید","شنیدم که کسی در مورد سخنانم می‌گوید و فقط از روی احترام و تحسین، نه به خاطر فهم و نقد، چیز دیگری نگفته است."],[130,"هم از خبث نوعی در آن درج کرد","که ناچار فریاد خیزد ز درد","در نوع بشر، ناشی از ویژگی‌های بدی است که باعث می‌شود فرد به خاطر درد و رنجی که دارد، ناگزیر فریاد بزند."],[130,"که فکرش بلیغ است و رایش بلند","در این شیوه زهد و طامات و پند","کسی که اندیشه‌اش عمیق و اثرگذار است و سخنانش ارزشمند و معنادار است، در این روش زهد (خودکنترلی) و نصیحت‌ها، به خوبی عمل می‌کند."],[130,"نه در خشت و کوپال و گرز گران","که این شیوه ختم است بر دیگران","در این بیت سعدی به این موضوع اشاره می‌کند که نه در ابزارهای سخت و سنگین مانند خشت (خشت‌کاری) و کوپال (سپر) و گرز (چماق) باید به دنبال قدرت و تسلط باشیم، بلکه این گونه روش‌ها و شیوه‌ها به پایان می‌رسند و در نهایت به دیگران می‌رسند. یعنی اصل و اساس روش زندگی و زهد در چیزهای مادی و قدرت‌نمایی نیست."],[130,"نداند که ما را سر جنگ نیست","وگر نه مجال سخن تنگ نیست","او نمی‌داند که ما قصد نزاع و جنگ نداریم، و اگر نه، برای گفتگو فضای کافی وجود دارد."],[130,"توانم که تیغ زبان بر کشم","جهانی سخن را قلم در کشم","من می‌توانم با کلامم مثل شمشیری بر علیه دشمن بمیرم و قدرت سخن را چون قلمی بیافزایم."],[130,"بیا تا در این شیوه چالش کنیم","سر خصم را سنگ، بالش کنیم","بیایید با هم به این روش مبارزه بپردازیم و سر دشمن را مانند بالش نرم کنیم."],[130,"سعادت به بخشایش داورست","نه در چنگ و بازوی زور آورست","سعادت و خوشبختی در هدیه و لطف خداوند به دست می‌آید، نه در قدرت و زور بازو."],[130,"چو دولت نبخشد سپهر بلند","نیاید به مردانگی در کمند","اگر بخت و اقبال به کسی عطا نکند، از مردانگی و شجاعت آن‌گونه که باید، نتوان خواهد آمد و این شخص در دام و تله نخواهد افتاد."],[130,"نه سختی رسید از ضعیفی به مور","نه شیران به سرپنجه خوردند و زور","مشکل یا سختی‌ای به ضعیفان مانند مور (موجود کوچک) نمی‌رسد و شیران (قدرتمندان) نیز با قدرت و زور خود آسیب نمی‌بینند."],[130,"چو نتوان بر افلاک دست آختن","ضروری است با گردشش ساختن","اگر انسان نتواند به اوج آسمان‌ها دست یابد و به مقامات بالا برسد، لازم است با دورانی که در زندگی دارد، سازگاری و تطابق ایجاد کند."],[130,"گرت زندگانی نبشته‌ست دیر","نه مارت گزاید نه شمشیر و شیر","اگر زندگانی برای تو به درازا نوشته شده باشد، نه مار به تو آسیبی می‌زند و نه شمشیر و شیر (حیوانات درنده)."],[130,"وگر در حیاتت نمانده‌ست بهر","چنانت کشد نوشدارو که زهر","اگر در زندگی‌ات چیزی نمانده باشد، چه فایده دارد که کسی برای تو دارویی بیاورد که زهر (عذاب) را برطرف کند؟"],[130,"نه رستم چو پایان روزی بخورد","شغاد از نهادش برآورد گرد؟","آیا رستم، قهرمان اسطوره‌ای ایران، هنگام پایانی روزی که شغاد (برادرش) به او زهر داده بود، غافل از این خطر بود؟"],[131,"مرا در سپاهان یکی یار بود","که جنگاور و شوخ و عیار بود","در سپاهان یکی از دوستان من بود که هم جنگجو و دلیر و هم شوخ طبع و زنده دل بود."],[131,"مدامش به خون دست و خنجر خضاب","بر آتش دل‌ خصم از او چون کباب","او همواره دستش و خنجرش به خون آغشته بود و از شدت خشم و قساوت، دل دشمنان را می‌سوزاند، مانند کبابی که روی آتش می‌پزد."],[131,"ندیدمش روزی که ترکش نبست","ز پولاد پیکانش آتش نجست","در روزی که او را ندیدم، هیچ‌گاه تیرش را نکشانده بود و آهن پیکانش به آتش نمی‌افتاد."],[131,"دلاور به سرپنجه گاوزور","ز هولش به شیران در افتاده شور","در این بیت، شاعر به وصف دلاوری می‌پردازد که با قدرت و شجاعت خود (سرپنچه گاوزور) به وحشت افتاده و شیران را به هراس انداخته است. این دلاور چنان به حریفان خود ابهت و ترس می‌دهد که همه از او می‌گریزند."],[131,"به دعوی چنان ناوک انداختی","که عذرا به هر یک یک انداختی","تو به گونه‌ای تیر پرتاب کردی که عذرا (دختری زیبا) هر تیر را در قلب یک نفر فرود آوردی."],[131,"چنان خار در گل ندیدم که رفت","که پیکان او در سپرهای جفت","چنان خاری در گل نمی‌بینم که سنگر نرمی که پیکان او به آن اصابت کند، پشت سرش داشته باشد."],[131,"نزد تارک جنگجویی به خشت","که خود و سرش را نه در هم سرشت","خشت‌: نوعی از سلاح جنگ است که نیزه‌ای کوتاه و سنگین‌وزن است."],[131,"چو گنجشک روز ملخ در نبرد","به کشتن چه گنجشک پیشش چه مرد","در روزی که ملخ‌ها به جنگ مشغولند، مانند یک گنجشک، چه تفاوتی دارد که گنجشک را بکشند یا مردی را؟ این بیان نشان‌دهنده بی‌اهمیتی و سهل بودن مرگ در آن وضعیت است."],[131,"گرش بر فریدون بدی تاختن","امانش ندادی به تیغ آختن","اگر بر فریدون (پادشاه اسطوره‌ای ایران) حمله‌کردی، به او امان نخواهی داد و با شمشیر او را خواهی زد."],[131,"پلنگانش از زور سرپنجه زیر","فرو برده چنگال در مغز شیر","فریدون، با قدرت و توانایی بی‌نظیر خود، دشمنان را به شدت شکست داده و چنگال پلنگ‌ها (نشانه‌ای از نبرد سخت و وحشیانه) بر سر شیر (نماد قدرت) را به تصویر کشیده است."],[131,"گرفتی کمربند جنگ آزمای","وگر کوه بودی بکندی ز جای","اگر کمربند جنگیدن را ببندی و به کارزار آماده شوی، توانایی تو به حدی است که کوه را هم از جا می‌کنی و برمی‌داری."],[131,"زره پوش را چون تبرزین زدی","گذر کردی از مرد و بر زین زدی","تو از کنار زره‌پوش، مانند تبرزین (تیری که به سرعت و قدرت عبور می‌کند) گذشتی و بر رکاب (زین) سوار شدی، یعنی بدون درنظر گرفتن افراد، به سرعت از کنار آنان عبور کردی."],[131,"نه در مردی او را نه در مردمی","دوم در جهان کس شنید آدمی","نه او در مردانگی چیزی دارد و نه در میان مردم دیگر، هیچ‌کس در جهان آدمی را مانند او نشنیده است."],[131,"مرا یک دم از دست نگذاشتی","که با راست طبعان سری داشتی","تو همیشه مرا تنها نگذاشتی و به خاطر اینکه با انسان‌های درستکار در ارتباط بودی، این فرصت برای من فراهم شد."],[131,"سفر ناگهم زان زمین در ربود","که بیشم در آن بقعه روزی نبود","سفر ناگهانی‌ام از آن دیار به خاطر آن بود که در آن مکان، روزی و روزگار خوبی نداشتم."],[131,"قضا نقل کرد از عراقم به شام","خوش آمد در آن خاک پاکم مقام","این بیت بیان می‌کند که سرنوشت او را از عراق به شام منتقل کرده و او در آن سرزمین پاک و زیبا خوشحال است و آنجا را جایگاه خود می‌داند."],[131,"مع القصه چندی ببودم مقیم","به رنج و به راحت، به امید و بیم","خلاصه اینکه مدتی در آنجا زندگی کردم، در حالی که گاه در سختی و گاه در آسایش بودم و همیشه میان امید و ترس به سر می‌بردم."],[131,"دگر پر شد از شام پیمانه‌ام","کشید آرزومندی خانه‌ام","پس از مدتی انتظار و تحمل سختی‌ها، حالا دیگر دل من از آرزوهای ناتمام پر شده است و در این شرایط، جای خالی خانه‌ام که آرزوی آن را دارم بیشتر احساس می‌کنم."],[131,"قضا را چنان اتفاق اوفتاد","که بازم گذر بر عراق اوفتاد","چنان بر سرنوشت من اتفاق افتاد که دوباره به عراق رسیدم."],[131,"شبی سر فرو شد به اندیشه‌ام","به دل برگذشت آن هنر پیشه‌ام","شب، سرم را به فکر فرو برد و دل‌ام به یاد آن هنرمند مشهور (که در گذشته با او آشنا بودم) افتاد."],[131,"نمک ریش دیرینه‌ام تازه کرد","که بودم نمک خورده از دست مرد","هنرپیشه‌ای که مدتی با او ارتباط داشتم، دوباره احساس من را تازه کرد و من که قبلا از او سود برده بودم، حالا به او وابسته شده‌ام."],[131,"به دیدار وی در سپاهان شدم","به مهرش طلبکار و خواهان شدم","به خاطر محبت و علاقه‌ام به او، به شهر سپاهان رفتم و از او خواستم که به من توجه کند."],[131,"جوان دیدم از گردش دهر، پیر","خدنگش کمان، ارغوانش زریر","جوانی را دیدم که از ناگزیری روزگار، به پیری رسیده است؛ تیرش مانند کمانی است که به دستش دارد و چهره‌اش به زیبایی گل ارغوانی است."],[131,"چو کوه سپیدش سر از برف موی","دوان آبش از برف پیری به روی","جوانی را دیدم که مثل کوهی است که برف سپید بر سرش نشسته و موهایش نیز در این برف دوانده شده، نشانه پیری است که بر چهره‌اش نمایان شده."],[131,"فلک دست قوت بر او یافته","سر دست مردیش بر تافته","روزگار بر او قدرت یافته و او را در وضعیت دشواری قرار داده است، به‌طوری که سرنوشت، او را از مردی و توانایی به ضعف و ناتوانی کشانده است."],[131,"به‌در کرده گیتی غرور از سرش","سر ناتوانی به زانو برش","دنیا (گیتی) از سر او (مردی که در این بیت اشاره شده) به خاطر ناتوانی و دست‌نیافتن به قدرت، دچار غرور و فریب شده و او را به زانو درآورده است."],[131,"بدو گفتم ای سرور شیر گیر","چه فرسوده کردت چو روباه پیر؟","به او گفتم، ای آقایی که بسیار قوی هستی، چه چیزی تو را مثل یک روباه پیر و فرسوده کرده است؟"],[131,"بخندید کز روز جنگ تتر","بدر کردم آن جنگجویی ز سر","او با لبخند گفت که در روز جنگ تتر، آن جنگجو را شکست داده است و او را از سر به زیر کرده است."],[131,"زمین دیدم از نیزه چو نیستان","گرفته علم‌ها چو آتش در آن","زمین را دیدم که مانند نیستان (مکانی پر از نی) آتش گرفته و نیزه‌ها به شکل علم‌ها (پرچم‌ها) در آن قرار دارند."],[131,"بر انگیختم گرد هیجا چو دود","چو دولت نباشد تهور چه سود؟","گرد هیجا یعنی گرد و غبار جنگ، که به دلیل هیجان و درگیری در نبرد به وجود می‌آید. شاعر می‌گوید که اگر دولت و کامیابی نباشد، اقدام به طغیان و شجاعت (تهور) چه فایده‌ای دارد، چون بدون پشتیبانی و موفقیت، تلاش‌ها بی‌نتیجه خواهند بود."],[131,"من آنم که چون حمله آوردمی","به رمح از کف انگشتری بردمی","من همان کسی هستم که وقتی به حمله می‌روم، نبرد را با نیزه انجام می‌دهم و انگشترم را از دست برمی‌دارم."],[131,"ولی چون نکرد اخترم یاوری","گرفتند گردم چو انگشتری","چون ستاره (سرنوشت) به من یاری نکرد، احساس کردم که به دور من، چون انگشتری، حلقه‌ای از مشکلات و سختی‌ها ایجاد شده است."],[131,"غنیمت شمردم طریق گریز","که نادان کند با قضا پنجه تیز","با توجه به وضعیت سخت و ناگوار، تصمیم گرفتم که فرار کردن را یک فرصت خوب به شمار آورم، زیرا افراد نادان به‌جای پذیرش سرنوشت، به سرنوشت خود حمله می‌کنند و نتیجه‌ای بدتر می‌سازند."],[131,"چه یاری کند مغفر و جوشنم","چو یاری نکرد اختر روشنم؟","اگر ستاره خوشبختی من یاری نکند، چه فایده‌ای دارد که من کلاه‌خود و زره‌ای به تن دارم؟"],[131,"کلید ظفر چون نباشد به دست","به بازو در فتح نتوان شکست","اگر کلید پیروزی در دست نباشد، با زور بازو و قدرت هم نمی‌توان به فتح و موفقیت دست یافت."],[131,"گروهی پلنگ افکن پیل زور","در آهن سر مرد و سم ستور","گروهی از شجاعان و جنگجویان، همچون پلنگ که در کمین نشسته، با قدرت و قوت بسیار به میدان آمده‌اند و در مقابل دشمنان به مبارزه می‌پردازند، با زره‌های استحکام یافته و سم‌های چالاک مانند اسب‌ها، آماده نبرد هستند."],[131,"همان دم که دیدیم گرد سپاه","زره جامه کردیم و مغفر کلاه","در آن لحظه که سپاه را دیدیم، زره پوشیدیم و کلاهی با حفاظ بر سر گذاشتیم."],[131,"چو ابر اسب تازی برانگیختیم","چو باران بلارک فرو ریختیم","سوارکاران را مانند ابر رعدآسا به حرکت درآوردیم و همچون باران بر دشمنان فرود آمدیم."],[131,"دو لشکر به هم بر زدند از کمین","تو گفتی زدند آسمان بر زمین","دو ارتش به هم حمله کردند و از کمینی که در کمین‌گاه سپر کرده بودند، چنان صدایی ایجاد کردند که گویی آسمان به زمین افتاده است."],[131,"ز باریدن تیر همچو تگرگ","به هر گوشه برخاست طوفان مرگ","خورشید جنگ به قدری تیر بارید که مانند تگرگ، در هر گوشه‌ای طوفان مرگ به پا کرد."],[131,"به صید هژبران پرخاش ساز","کمند اژدهای دهن کرده باز","برای صید کسبه بزرگ و قوی (هژبران)، کمند اژدهایی را که دهانش را باز کرده، باید به کار گرفت."],[131,"زمین آسمان شد ز گرد کبود","چو انجم در او برق شمشیر و خود","زمین به رنگ آبی و تاریک درآمد و مانند آسمان شد، در آنجا همچون ستاره‌ها، درخشش شمشیرها خود را نشان داد."],[131,"سواران دشمن چو دریافتیم","پیاده سپر در سپر بافتیم","وقتی سواران دشمن متوجه ما شدند، ما نیز به صورت پیاده در کنار هم ایستادیم و سپرهایمان را به هم بافتیم تا از خود دفاع کنیم."],[131,"به تیر و سنان موی بشکافتیم","چو دولت نبد روی بر تافتیم","چون دولت به ما روی نیاورد و ما را یاری نکرد، با تیر و نیزه به جان هم افتادیم و موهای یکدیگر را شکستیم."],[131,"چه زور آورد پنجه جهد مرد","چو بازوی توفیق یاری نکرد؟","چنانچه کوشش و تلاش فردی (مرد) بدون کمک و حمایت موفقیت حاصل نکند، چه نیرویی به کار خواهد برد؟ به عبارتی، اگر یاری از جانب توفیق نباشد، تلاش و زور بازوی او بی‌فایده است."],[131,"نه شمشیر گندآوران کند بود","که کین آوری ز اختر تند بود","نه شمشیر کسانی که به گناه آلوده‌اند مؤثر نیست، زیرا انتقام‌جویی از سرنوشت ناگوار اتفاق می‌افتد."],[131,"کس از لشکر ما ز هیجا برون","نیامد جز آغشته خفتان به خون","هیچ‌کس از سپاه ما از میدان جنگ برنگشت، جز افرادی که لباس‌هایشان به خون آلوده شده است."],[131,"چو صد دانه مجموع در خوشه‌ای","فتادیم هر دانه‌ای گوشه‌ای","ما همچون دانه‌های یک خوشه خرما، در کنار هم قرار گرفتیم و هر کدام در گوشه‌ای از این جمعیت به سر می‌بریم."],[131,"به نامردی از هم بدادیم دست","چو ماهی که با جوشن افتد به شست","ما به خاطر بی‌وفایی و نامردی یکدیگر را رها کردیم، مانند ماهی که وقتی به دست کسی می‌افتد که زره به تن دارد، از هم جدا می‌شود."],[131,"کسان را نشد ناوک اندر حریر","که گفتم بدوزند سندان به تیر","در اینجا شاعر اشاره می‌کند که کسانی که از ارزش و مقام خود بی‌خبر هستند، نمی‌توانند خود را در شرایط سخت و خطرناک قرار دهند، مانند این که من گفتم تا با خیال راحت از چیزی باارزش محافظت کنیم، اما آن‌ها به درستی نتوانستند این چالش را درک کنند."],[131,"چو طالع ز ما روی بر پیچ بود","سپر پیش تیر قضا هیچ بود","وقتی سرنوشت از ما روی برگرداند و به ما روی خوش نشان ندهد، هیچ چیز نمی‌تواند ما را در برابر تیر قضا و تقدیر حفظ کند."],[131,"از این بوالعجب‌تر حدیثی شنو","که بی بخت کوشش نیرزد دو جو","شنیده‌ای درباره کسانی که در سختی و بی‌فرجامی به سر می‌برند؛ اینکه تلاش و کوشش آنها به اندازه دو جو هم ارزش ندارد و بی‌فایده است."],[132,"یکی آهنین پنجه در اردبیل","همی بگذرانید پیلک ز پیل","مردی زورمند و اهل اردبیل که تیر کمانش از فیل می‌گذشت. (پیلک: نوعی تیر‌. پیل به‌نظر می‌رسد که در اینجا نام نوعی سپر یا زره باشد)"],[132,"نمد پوشی آمد به جنگش فراز","جوانی جهان سوز پیکار ساز","در جنگ، یک جنگنجوی ساده و نمدپوش در مقابلش قرار گرفت؛ جوانی بود جنگاور و جنگی."],[132,"به پرخاش جستن چو بهرام گور","کمندی به کتفش بر از خام گور","که در جنگاوری مثل بهرام گور بود و کمندی از چرم گور با خود داشت."],[132,"چو دید اردبیلی نمد پاره پوش","کمان در زه آورد و زه را به گوش","وقتی اردبیلی آن نمدپاره‌پوش را دید کمان را با تمام قدرت تا بناگوش کشید."],[132,"به پنجاه تیر خدنگش بزد","که یک چوبه بیرون نرفت از نمد","و پیاپی به‌او تیر زد، پنجاه تیر خدنگ و تیز؛ که حتی یکی از آنها از نمد عبور نکرد!"],[132,"درآمد نمدپوش چون سام گرد","به خم کمندش درآورد و برد","جوان نمدپوش همچون سام پهلوان نزدیک رسید و با کمند او را اسیر کرد."],[132,"به لشکرگهش برد و در خیمه دست","چو دزدان خونی به گردن ببست","او را به لشکرگاه برد و همچون راهزنان قاتل او را به‌گردن بست."],[132,"شب از غیرت و شرمساری نخفت","سحرگه پرستاری از خیمه گفت","آن (اردبیلی) از غیرت و شرمندگی نتوانست بخوابد؛ صبحدم پرستاری از درون خیمه از او پرسید:"],[132,"تو کآهن به ناوک بدوزی و تیر","نمدپوش را چون فتادی اسیر؟","تو که با تیر و پیکان، آهن را پاره می‌کنی؛ چطور اسیر یک نمدپوش شدی؟"],[132,"شنیدم که می‌گفت و خون می‌گریست","ندانی که روز اجل کس نزیست؟","شنیده‌ام که گریه می‌کرد و پاسخ داد: نمی‌دانی که وقتی اجل برسد، کسی جان به‌در نمی‌برد؟"],[132,"من آنم که در شیوه طعن و ضرب","به رستم در آموزم آداب حرب","من در جنگ، چنان ماهرم که فنون تیراندازی و ضربه‌زنی را به رستم یاد می‌دهم."],[132,"چو بازوی بختم قوی حال بود","ستبری پیلم نمد می‌نمود","وقتی‌که بازوی بخت و اقبالم قوی و زورمند بود؛ ستبری پیل در برابرم مثل نمد بود."],[132,"کنونم که در پنجه اقبیل نیست","نمد پیش تیرم کم از پیل نیست","اکنون که بخت و اقبال ندارم؛ نمد در برابر تیر من همچون پیل است!"],[132,"به روز اجل نیزه جوشن درد","ز پیراهن بی اجل نگذرد","در روز اجل، نیزه از آهن می‌گذرد اما بی‌اجل از پیراهن یک‌لا هم نمی‌گذرد."],[132,"کرا تیغ قهر اجل در قفاست","برهنه‌ست اگر جوشنش چند لاست","کسی که مرگش فرا برسد؛ برهنه است حتی اگر جوشنی چند‌لایه پوشیده باشد."],[132,"ورش بخت یاور بود، دهر پشت","برهنه نشاید به ساطور کشت","وقتی‌که تقدیر نباشد؛ برهنه را با ساطور هم نمی‌توان کشت."],[132,"نه دانا به سعی از اجل جان ببرد","نه نادان به ناساز خوردن بمرد","نه دانا می‌تواند با تلاش و زیرکی از اجل بگریزد؛ و نه نادان، بی‌اجل با خوردن چیزی ناساز می‌میرد."],[133,"شبی کردی از درد پهلو نخفت","طبیبی در آن ناحیت بود و گفت","شبی کردی از بیماری و درد پهلو نتوانست بخوابد؛ پزشکی در آن ناحیه بود و گفت:"],[133,"از این دست کاو برگ رز می‌خورد","عجب دارم ار شب به پایان برد","از این غذاهای ناسازگار که او خورده است؛ فکر نمی‌کنم که تا صبح زنده بماند."],[133,"که در سینه، پیکان تیر تتار","به از ثقل مأکول ناسازگار","زیرا غذای سنگین ناسازگار از زخم تیر تاتار هم بدتر و کشنده‌تر است."],[133,"گر افتد به یک لقمه در روده پیچ","همه عمر نادان بر آید به هیچ","اگر با یک لقمه ناسازگار در روده پیچ بیفتد عمر آدم نادان را تباه می‌کند."],[133,"قضا را طبیب اندر آن شب بمرد","چهل سال از این رفت و زنده‌ست کرد","از قضا آن شب، آن طبیب مرد و از آن ماجرا چهل سال گذشته‌است و کرد زنده‌است."],[134,"یکی روستایی سقط شد خرش","علم کرد بر تاک بستان سرش","خر یک روستایی سقط شد و آن‌روستایی سر خر را بالای تاکستان علم کرد. (تا دفع چشم‌زخم کند)"],[134,"جهاندیده پیری بر او بر گذشت","چنین گفت خندان به ناطور دشت","پیری جهان‌دیده از آنجا می‌گذشت (و با دیدن آن) خندید و گفت:"],[134,"مپندار جان پدر کاین حمار","کند دفع چشم بد از کشتزار","ای فرزندم، مپندار که سر این خر می‌تواند چشم بد را از کشتزار تو دور کند."],[134,"که این دفع چوب از سر و گوش خویش","نمی‌کرد تا ناتوان مرد و ریش","که این خر در زمان زنده‌بودن نتوانست ضرب چوب را از سر و گوش خود دفع کند تا آنکه ناتوان و زخمی مرد."],[134,"چه داند طبیب از کسی رنج برد","که بیچاره خواهد خود از رنج مرد؟","طبیب چطور می‌تواند بیماری را از کسی دفع کند، وقتی‌که خود از بیماری می‌میرد؟"],[135,"شنیدم که دیناری از مفلسی","بیفتاد و مسکین بجستش بسی","شنیده‌ام که دیناری از دست آدم تهی‌دستی افتاد و هرچه جست، نتوانست آن‌را بیابد."],[135,"به آخر، سر ناامیدی بتافت","یکی دیگرش ناطلب‌کرده یافت","در آخر و با ناامیدی آنجا را ترک کرد، شخص دیگری بدون آنکه بخواهد آن دینار را پیدا کرد."],[135,"به بدبختی و نیکبختی قلم","بگردید و ما همچنان در شکم","قلم تقدیر به بدبختی و نیکبختی گشته‌ و سرنوشت ما را نوشته‌است؛ از زمانیکه ما در شکم مادر هستیم و متولد نگشته‌ایم."],[135,"نه روزی به سرپنجگی می‌خورند","که سرپنجگان تنگ‌روزی‌ترند","آدمیان، روزی و قسمت را با زور و سرپنجگی نمی‌خورند؛ چنانکه قوی‌ها تنگ‌روزی‌تر هستند و روزگار بر آن‌ها دشوارتر است."],[135,"بسا چاره‌دانا به سختی بمرد","که بیچاره گوی سلامت ببرد","بسیار آدمیان دانا و چاره‌گر که از سختی و تنگدستی مرده‌اند و آدم ناتوان و بیچاره نجات یافته‌است."],[136,"فرو کوفت پیری پسر را به چوب","بگفت ای پدر بی گناهم مکوب","پیرمردی پسرش را با چوب می‌زد؛ پسر گفت: مرا مزن ای پدر! بی‌گناه هستم."],[136,"توان بر تو از جور مردم گریست","ولی چون تو جورم کنی چاره چیست؟","می‌توان از جور و ستم مردم به‌تو پناه برد اما وقتی‌که تو بر من جور کنی، چه کنم؟"],[136,"به داور خروش، ای خداوند هوش","نه از دست داور برآور خروش","ای صاحب‌خرد و ای هوشیار! به خدا فغان کن و نیاز ببر؛ نه‌آنکه از دست خدا فغان کنی."],[137,"بلند اختری نام او بختیار","قوی دستگه بود و سرمایه‌دار","آدم نیکبختی بود به‌نام «‌بختیار‌» که ثروتمند و سرمایه‌دار بود."],[137,"به کوی گدایان درش خانه بود","زرش همچو گندم به پیمانه بود","بختیار در محله فقیران خانه و مسکن داشت؛ پیمانه‌اش از زر پر بود‌، به‌آسانی و فراوانی گندم."],[137,"چو درویش بیند توانگر به ناز","دلش بیش سوزد به داغ نیاز","وقتی‌که آدم نادار و درویش، آدم ثروتمند را در ناز و نعمت می‌بیند بیشتر دلش بر حال تهی‌دستی خود می‌سوزد."],[137,"زنی جنگ پیوست با شوی خویش","شبانگه چو رفتش تهیدست، پیش","زنی (در آن محله) وقتی‌که شوهرش با دست تهی به‌خانه رفت، با شوهر به مشاجره و جنگ برخاست."],[137,"که کس چون تو بدبخت، درویش نیست","چو زنبور سرخت جز این نیش نیست","که هیچکس مثل تو بدبخت و فقیر نیست؛ مثل زنبور درشت سرخ هستی که عسل نمی‌دهی و جز این نیش چیزی نداری."],[137,"بیاموز مردی ز همسایگان","که آخر نیم قحبه رایگان","مردی و مردانگی را از همسایه‌ها بیاموز؛ من که قحبه مفت و مجانی نیستم!"],[137,"کسان را زر و سیم و ملک است و رخت","چرا همچو ایشان نه‌ای نیکبخت؟","مردم همه‌، پول و ثروت و ملک و اسباب و تجملات دارند؛ چرا تو مثل آنها نیکبخت نیستی؟"],[137,"بر آورد صافی‌دل صوف‌پوش","چو طبل از تهیگاه خالی خروش","آن مرد پاک‌دل و پرهیزگار از سینه فغان برآورد؛"],[137,"که من دست قدرت ندارم به هیچ","به سرپنجه دست قضا بر مپیچ","که من‌، هیچکاره هستم و قدرت بر چیزی ندارم؛ با دست قضا در نیفت."],[137,"نکردند در دست من اختیار","که من خویشتن را کنم بختیار","به من اختیار ندادند که «بختیار» باشم."],[138,"یکی پیر درویش در خاک کیش","چه خوش گفت با همسر زشت خویش","پیر‌مردی تنگدست در جزیره کیش، به‌همسر زشت‌روی خود چه خوش و بجا گفت:"],[138,"چو دست قضا زشت‌رویت سرشت","میندای گلگونه بر روی زشت‌","‌«وقتی که تقدیر تو را زشت خلق کرده‌، پس آرایش مکن‌»"],[138,"که حاصل کند نیکبختی به زور؟","به سرمه که بینا کند چشم کور؟","چه کسی می‌تواند تقدیر را عوض کند و به‌زور نیکبخت شود؟ با سرمه چطور می‌شود نابینا، بینا شود؟"],[138,"نیاید نکوکاری از بد رگان","محال است دوزندگی از سگان","از بدرگان و بدسرشتان نیز نباید انتظار و توقع نیکوکاری داشت؛ محال است سگی‌، دوزندگی و خیاطی کند!"],[138,"همه فیلسوفان یونان و روم","ندانند کرد انگبین از زقوم","اگر تمام فیلسوفان یونان و روم را جمع‌کنی نمی‌توانند از زقوم تلخ، عسل بگیرند٬ ( زقوم‌: درخت دوزخی)"],[138,"ز وحشی نیاید که مردم شود","به سعی اندر او تربیت گم شود","جانور وحشی تبدیل به آدمی ‌نمی‌شود و هرچه سعی کنی و تربیت کنی در او گم و بی‌اثر می‌شود."],[138,"توان پاک‌‎کردن ز زنگ آینه","ولیکن نیاید ز سنگ آینه","می‌شود زنگار آینه را پاک کرد اما نمی‌شود سنگ را به آینه تبدیل کرد."],[138,"به کوشش نروید گل از شاخ بید","نه زنگی به گرمابه گردد سپید","با تلاش نمی‌شود از درخت بید، گل‌سرخ رویاند و با حمام‌کردن، سیاه و زنگی‌، سپید نمی‌گردد."],[138,"چو رد می‌نگردد خدنگ قضا","سپر نیست مر بنده را جز رضا","وقتی که تیر قضا، خطا نمی‌رود، بنده جز تسلیم و رضا چاره‌ای ندارد."],[139,"چنین گفت پیش زغن کرکسی","که نبود ز من دوربین‌تر کسی","روزی کرکسی به زغنی گفت: کسی دوربین‌تر و تیزبین‌تر از من وجود ندارد."],[139,"زغن گفت از این در نشاید گذشت","بیا تا چه بینی بر اطراف دشت","زغن گفت قابل قبول نیست؛ بیا امتحان کنیم تا چه‌می‌توانی در این دشت ببینی."],[139,"شنیدم که مقدار یک روزه راه","بکرد از بلندی به پستی نگاه","شنیده‌ام که (کرکس) مقدار راه سفر یک‌روزه را از بلندی دید."],[139,"چنین گفت دیدم گرت باور است","که یک دانه گندم به هامون بر است","و گفت‌: اگر باور می‌کنی در آن دشت دوردست، یک دانه‌گندم را می‌بینم."],[139,"زغن را نماند از تعجب شکیب","ز بالا نهادند سر در نشیب","زغن از تعجب و شگفتی فراوان‌، بی‌صبر شد؛ از اوج آسمان به پایین آمدند."],[139,"چو کرکس بر دانه آمد فراز","گره شد بر او پایبندی دراز","وقتی که کرکس به‌نزدیک آن دانه آمد؛ دامی بر پای او گره شد."],[139,"ندانست از آن دانه‌ای خوردنش","که دهر افکند دام در گردنش","ندانست از آن دانه‌ای خوردنش‌، که دهر افکند دام در گردنش"],[139,"نه آبستن در بود هر صدف","نه هر بار رامی زند بر هدف","هر صدفی‌، در و مروارید ندارد؛ تیر رامی هر بار به‌هدف نمی‌خورد. («رامی» یا ابن‌حرب، نام شخصی در صدر اسلام)"],[139,"زغن گفت از آن دانه دیدن چه سود","چو بینایی دام خصمت نبود؟","زغن به او گفت از آن دانه دیدن و تیزبینی چه سود؟ وقتی که نتوانستی دام دشمن را ببینی."],[139,"شنیدم که می‌گفت و گردن به بند","نباشد حذر با قدر سودمند","شنیده‌ام درحالیکه گردن دربند بود می‌گفت: از تقدیر، نمی‌توان گریخت."],[139,"اجل چون به خونش بر آورد دست","قضا چشم باریک بینش ببست","وقتی که اجل، قصد کشتن او کرد؛ قضا چشم تیزبین او را بست."],[139,"در آبی که پیدا نگردد کنار","غرور شناور نیاید به کار","در دریایی که بی‌پایان است؛ غرور و زور شناگر چاره‌ساز نیست."],[140,"چه خوش گفت شاگرد منسوج باف","چو عنقا بر آورد و پیل و زراف","شاگرد منسوج باف چه درست گفت وقتی‌که داشت هما و زرافه و فیل نقش می‌زد."],[140,"مرا صورتی بر نیاید ز دست","که نقشش معلم ز بالا نبست","هیچ طرح و صورتی نمی‌توانم بزنم بجز آنها که استاد از بالا بست."],[140,"گرت صورت حال بد یا نکوست","نگارنده دست تقدیر، اوست","اگر وضعیت اکنون تو خوب یا بد است، نویسنده‌ی سرنوشت تو همان خداست."],[140,"در این‌، نوعی از شرک پوشیده هست","که زیدم بیازرد و عمروم بخست","در گفتن اینکه «زید مرا آزرد» یا «عمرو مرا زد» نوعی شرک خفی و پوشیده هست."],[140,"گرت دیده بخشد خداوند امر","نبینی دگر صورت زید و عمرو","اگر خداوند به تو بینش عطا کند، دیگر هیچگاه صورت و ظاهر زید و عمرو را نخواهی دید."],[140,"نپندارم ار بنده دم در کشد","خدایش به روزی قلم در کشد","نپندارم ار بنده دم در کشد، خدا روزی‌اش را ندهد"],[140,"جهان‌آفرینت گشایش دهاد","که گر وی ببندد‌، که داند گشاد‌؟","پروردگار به‌تو گشایش بدهد؛ زیرا اگر او ببندد، چه‌کسی می‌تواند بگشاید؟"],[141,"شتر بچه با مادر خویش گفت:","«پس از رفتن، آخر زمانی بخفت»","شتربچه‌ای به مادرش گفت‌: «رفتن بس است؛ کمی هم استراحت کنیم»"],[141,"بگفت «ار به دست من استی مهار","ندیدی کسم بارکش در قطار»","پاسخ داد: «اگر مهار در دست من بود، هرگز بارکش کاروان نمی‌شدم»"],[141,"قضا کشتی آنجا که خواهد برد","وگر ناخدا جامه بر تن درد","سرنوشت‌، کشتی را به‌آنجا می‌برد که خود خواهد، حتی اگر ناخدا (از خشم و غصه) جامه بر تن خویش پاره کند."],[141,"مکن سعدیا دیده بر دست کس","که بخشنده پروردگار است و بس","ای سعدی! چشم بر دست کسی مدوز که تنها بخشنده و روزی‌دهنده‌، پروردگار است و دیگر هیچکس."],[141,"اگر حق پرستی ز درها بست","که گر وی براند نخواند کست","اگر خدا پرست هستی او برای تو کافی است و اگر او تو را نپذیرد هیچ‌کس نمی‌تواند خواسته‌ات را روا کند."],[141,"گر او تاجدارت کند سر بر آر","وگر نه سر ناامیدی بخار","اگر او تو را تاجدار کند امیدوار باش وگرنه برو و ناامید باش."],[142,"عبادت به اخلاص نیت نکوست","وگر نه چه آید ز بی مغز پوست؟","عبادت باید با نیت خالص و درست انجام شود، در غیر این صورت، چه فایده‌ای از ظاهر کار بدون عمق و بی‌معنا خواهد بود؟"],[142,"چه زنار مغ در میانت چه دلق","که در پوشی از بهر پندار خلق","هیچ‌کدام از زینت‌ها و پوشش‌هایی که برای ظاهر خود به کار می‌بری، ارزش و فایده‌ای ندارند؛ مهم این است که درونت چه حالتی دارد و نیت تو چقدر خالص است، نه اینکه فقط به خاطر نظر دیگران خود را متظاهر کنی."],[142,"مکن گفتمت مردی خویش فاش","چو مردی نمودی مخنث مباش","مگو خود را مرد تلقی کن، وقتی که به وضوح رفتار زنانه‌ای داری؛ زیرا اگر در ظاهر مرد هستی، نباید به حالت‌های زنانه تمایل نشان بدهی."],[142,"به اندازه بود باید نمود","خجالت نبرد آن که ننمود و بود","انسان باید به اندازه و ظرفیت خود ظاهر شود و خجالت نکشد از کسی که به اندازه واقعی‌اش نشان نداده و وجود ندارد."],[142,"که چون عاریت بر کنند از سرش","نماید کهن جامه‌ای در برش","وقتی که عاریه را از او بگیرند، مشخص می‌شود که او لباس کهنه‌ای به تن دارد؛ یعنی کسی که خود را به نیکی و دارایی نشان می‌دهد، وقتی از آنچه در ظاهر دارد محروم شود، واقعیات زندگی‌اش نمایان می‌شود."],[142,"اگر کوتهی پای چوبین مبند","که در چشم طفلان نمایی بلند","اگر پای چوبی را کوتاه نکنی، باعث می‌شود در نظر بچه‌ها قد بلندی داشته باشی."],[142,"وگر نقره اندوده باشد نحاس","توان خرج کردن بر ناشناس","اگر چیزی که به نظر باارزش می‌آید، در اصل بی‌ارزش باشد، نمی‌توان آن را به کسی ناشناخته و بدون اعتبار فروخت."],[142,"منه جان من آب زر بر پشیز","که صراف دانا نگیرد به چیز","به خاطر نگذار جانم را با طلا، زیرا صراف آگاه، این چیز ناچیز را قبول نمی‌کند."],[142,"زر اندودگان را به آتش برند","پدید آید آنگه که مس یا زرند","افرادی که به طمع مال و ثروت، خود را زینت‌کرده‌اند، در سختی و گرفتاری آشکار می‌شوند و مشخص می‌شود که آیا واقعیند یا فقط ظاهری از طلا و زر دارند و در حقیقت مس هستند."],[142,"ندانی که بابای کوهی چه گفت","به مردی که ناموس را شب نخفت؟","بابای کوهی به مردی که در شب از ترس وفاداری به ناموس خود نمی‌توانست بخوابد، چه گفت؟ تو از این موضوع بی‌خبر هستی."],[142,"برو جان بابا در اخلاص پیچ","که نتوانی از خلق رستن به هیچ","به کسی که به نیکی‌هایش ریا می‌ورزد، بگو بی‌جواب ریاکاری درون را کنار بگذارد، زیرا هرگز نمی‌تواند از نگاه مردم پنهان بماند."],[142,"کسانی که فعلت پسندیده‌اند","هنوز از تو نقش برون دیده‌اند","کسانی که اعمال خوب تو را پسندیده و ستوده‌اند، هنوز نمی‌توانند به درستی باطن واقعی تو را بشناسند و فقط از ظاهر کارهایت قضاوت کرده‌اند."],[142,"چه قدر آورد بنده حوردیس","که زیر قبا دارد اندام پیس؟","بنده (که ممکن است به یک خدمتکار یا مرید اشاره داشته باشد) چقدر برای به دست آوردن مقام و زیبایی ظاهری تلاش کرده است، در حالی که زیر لباس (قبا) او اندامی ناپسند و زشت وجود دارد. این بیت به انتقاد از ریاکاری و تظاهر به خوبی‌ها در حالی که در باطن عیب وجود دارد، پرداخته است."],[142,"نشاید به دستان شدن در بهشت","که بازت رود چادر از روی زشت","راه یافتن به بهشت از طریق اعمال نیک، نباید به خاطر زشتی‌ها و عیوبی باشد که در درون ما وجود دارد؛ زیرا اگر اعمال نیک بر پایه ریا باشد، در نهایت آن‌ها از بین خواهند رفت و زیبایی واقعی پنهان می‌ماند."],[143,"شنیدم که نابالغی روزه داشت","به صد محنت آورد روزی به چاشت","شنیده‌ام که کودکی روزه‌گرفت و با صد زحمت (بیدار شد) و چاشت خورد. (چاشت یعنی طعام بامداد یا اولین غذایی که بعد از بیدار شدن در صبح خورده می‌شود)"],[143,"به کتابش آن روز سائق نبرد","بزرگ آمدش طاعت از طفل خرد","آن‌روز‌، سائق او را به مدرسه نبرد‌، چون از نظر او، روزه برای کودک دشوار بود. (سائق یعنی کسی که افسار چارپایی را می‌کشد. کتاب: مدرسه)"],[143,"پدر دیده بوسید و مادر سرش","فشاندند بادام و زر بر سرش","پدر و مادر به او آفرین گفتند و محبت کردند و به مبارکی و شادی‌، بر سر او آجیل و پول افشاندند."],[143,"چو بر وی گذر کرد یک نیمه روز","فتاد اندر او ز آتش معده سوز","وقتی‌که نصف روز بر او گذشت، آتش گرسنگی در معده‌اش افتاد."],[143,"به دل گفت اگر لقمه چندی خورم","چه داند پدر غیب یا مادرم؟","با خود گفت: اگر چند لقمه بخورم، پدر یا مادرم از پنهان و غیب چه‌می‌دانند؟"],[143,"چو روی پسر در پدر بود و قوم","نهان خورد و پیدا به سر برد صوم","وقتی‌که پسر فقط به پدر و بستگان توجه‌کرد، در پنهان غذا خورد و در ظاهر روزه گرفت."],[143,"که داند چو در بند حق نیستی","اگر بی وضو در نماز ایستی؟","کی می‌فهمد‌، وقتی‌که به خدا بی‌توجه هستی، اگر بی‌وضو در نماز بایستی؟"],[143,"پس این پیر از آن طفل نادان تر است","که از بهر مردم به طاعت در است","پس آن پیر که برای خوشایند مردم، عبادت می‌کند از آن کودک‌، نادان‌تر است."],[143,"کلید در دوزخ است آن نماز","که در چشم مردم گزاری دراز","نمازی که برای خودنمایی به مردم‌، دراز می‌کنی، کلید در دوزخ است."],[143,"اگر جز به حق می‌رود جاده‌ات","در آتش فشانند سجاده‌ات","اگر مقصد و نیت تو جز خداست؛ سجاده و عبادت تو را در آتش می‌اندازند."],[144,"سیهکاری از نردبانی فتاد","شنیدم که هم در نفس جان بداد","سیهکار (شخصی که کردار بدی داشته) از نردبانی سقوط کرد و شنیدم که در همان حال جانش را از دست داد."],[144,"پسر چند روزی گرستن گرفت","دگر با حریفان نشستن گرفت","پسری چند روز گرسنه ماند و سپس دوباره با دوستانش به دور هم نشستن و مجلس‌گرفتن پرداخت."],[144,"به خواب اندرش دید و پرسید حال","که چون رستی از حشر و نشر و سؤال؟","او در خواب دید که از دوزخ رهایی یافته و از او پرسید که حالا که از محاسبه و سوالات قیامت نجات یافته‌ای، وضعیت‌ات چگونه است؟"],[144,"بگفت ای پسر قصه بر من مخوان","به دوزخ در افتادم از نردبان","او به پسرش گفت که داستان‌ها را برایم نگو، چون من به دوزخ افتاده‌ام و از نردبان به پایین آمده‌ام."],[144,"نکو سیرتی بی تکلف برون","به از نیکنامی خراب اندرون","نیکوکرداری و اخلاق خوب بدون تظاهر و زرق و برق، بهتر از داشتن نام و شهرت نیکو اما با باطنی خراب و بد است."],[144,"به نزدیک من شبرو راهزن","به از فاسق پارسا پیرهن","از نظر من، شب‌رو که دزد راه است، بهتر از فرد پارسای فاسق و به ظاهر نیکوکار است."],[144,"یکی بر در خلق رنج آزمای","چه مزدش دهد در قیامت خدای؟","اگر کسی در این دنیا بر دیگران زحمت و رنجی را تحمل کند، خداوند در قیامت چه پاداشی به او می‌دهد؟"],[144,"ز عمرو ای پسر چشم اجرت مدار","چو در خانه زید باشی به کار","ای پسر، به عمر خود ارزش و پاداشی نخواهی داد، همچنان که اگر در خانه زید (مردی با نفوذ و ثروتمند) کار کنی، انتظار پاداش نداشته باش."],[144,"نگویم تواند رسیدن به دوست","در این ره جز آن کس که رویش در اوست","نمی‌گویم کسی می‌تواند به دوست برسد، مگر آنکه چهره‌اش را در او ببینید."],[144,"ره راست رو تا به منزل رسی","تو در ره نه‌ای، زین قبل واپسی","برای رسیدن به منزل، باید از مسیر درست حرکت کنی و در این راه که به دوستی منتهی می‌شود، نباید از مسیر خود برگردی."],[144,"چو گاوی که عصار چشمش ببست","دوان تا به شب، شب همان جا که هست","انسانی مانند گاوی است که چشمانش بسته شده و بی‌هدف می‌دود، تا وقتی که شب فرامی‌رسد و او در همان نقطه‌ای که بود، می‌ماند."],[144,"کسی گر بتابد ز محراب روی","به کفرش گواهی دهند اهل کوی","اگر کسی از جایگاه عبادی‌اش منحرف شود و به کفر روی آورد، مردمان آن کوی گواهی بر کفر او خواهند داد."],[144,"تو هم پشت بر قبله‌ای در نماز","گرت در خدا نیست روی نیاز","اگر تو در نماز به قبله پشت کنی و روی‌ات نیز به خدا نباشد، نیکی و خضوع تو به چه کار می‌آید؟"],[144,"درختی که بیخش بود برقرار","بپرور، که روزی دهد میوه بار","درختی را بپرور که ریشه‌اش سالم و پایدار است، زیرا این درخت روزی میوه و محصول خوبی خواهد داد."],[144,"گرت بیخ اخلاص در بوم نیست","از این بر کسی چون تو محروم نیست","اگر در دل تو ریشه صداقت و اخلاص نباشد، از این پس هر کس دیگری هم مانند تو محروم نخواهد شد."],[144,"هر آن کافکند تخم بر روی سنگ","جوی وقت دخلش نیاید به چنگ","هر کسی که بذر خود را بر روی سنگ پانی بیفشاند، به زودی به نتیجه‌ای نخواهد رسید و نفعی در آن نخواهد داشت."],[144,"منه آبروی ریا را محل","که این آب در زیر دارد وحل","آبروی ریاکار را به محلی نندازید؛ زیرا این آب (آبرو) در زیر، عاقبتی بد دارد."],[144,"چو در خفیه بد باشم و خاکسار","چه سود آب ناموس بر روی کار؟","اگر من در پنهان بد و بی‌ادب باشم و در ظاهر متواضع، چه فایده‌ای دارد که ناموس و آبرویم را در ظاهر حفظ کنم؟"],[144,"به روی و ریا خرقه سهل است دوخت","گرش با خدا در توانی فروخت","اگر بخواهی به ظاهر و ریا کار کنی، دوختن یک خرقه (لباس صوفیانه) کار دشواری نیست، اما اگر بتوانی با خداوند ارتباط واقعی برقرار کنی، این ارزشمندتر است."],[144,"چه دانند مردم که در جامه کیست؟","نویسنده داند که در نامه چیست","مردم نمی‌دانند که در ظاهر و لباس چه کسی وجود دارد، فقط نویسنده نامه (یعنی خدا یا کسی که حقیقت را می‌داند) می‌داند که در نوشته و در دل چه خبری است."],[144,"چه وزن آورد جایی انبان باد","که میزان عدل است و دیوان داد؟","انبان باد به چه اندازه‌ای می‌تواند سنگینی کند، در حالی که میزان عدالت و دیوان داد وجود دارد؟"],[144,"مرائی که چندین ورع می‌نمود","بدیدند و هیچش در انبان نبود","آدمی که در ظاهر، بسیار خود را پرهیزکار نشان می‌داد، را در باطن دیدند و متوجه شدند که هیچ چیز در درونش نیست."],[144,"کنند ابره پاکیزه‌تر ز آستر","که آن در حجاب است و این در نظر","چیزی که در نگاه مردم است، از نظر پاک‌تر و زیباتر به نظر می‌رسد تا چیزی که پنهان و در حجاب است. این جمله به ارزش نمایان شدن خالصی و زیبایی در برابر چشم‌ها اشاره دارد."],[144,"بزرگان فراغ از نظر داشتند","از آن پرنیان آستر داشتند","بزرگان در حالتی از آرامش و آسایش بودند و از چیزی که در ظاهر زیباست، چشم پوشیده بودند، زیرا آن زیبایی به مانند آستری بر روی یک پارچه نازک است."],[144,"ور آوازه خواهی در اقلیم فاش","برون حله کن گو درون حشو باش","اگر می‌خواهی در جامعه شناخته شوی و نامت بر سر زبان‌ها بیفتد، باید ظاهرت را زیبا و فریبنده جلوه‌گر کنی، حتی اگر در باطن چیز دیگری باشی."],[144,"به بازی نگفت این سخن بایزید","که از منکر ایمن‌ترم کز مرید","بایزید، عارف معروف، به طعنه می‌گوید که من بیشتر از مریدان خود از منکر (بدی‌ها) بی‌خطرم."],[144,"کسانی که سلطان و شاهنشهند","سراسر گدایان این درگهند","افرادی که در مقام سلطنت و پادشاهی هستند، در حقیقت همه دورن این درگاه (درگاه خداوند) فقیر و نیازمند هستند."],[144,"طمع در گدا، مرد معنی نبست","نشاید گرفتن در افتاده دست","تمایل به بهره‌کشی از گدا، نشان‌دهنده نقص معنوی انسان است و نباید انسانی که در سختی افتاده را استثمار کرد."],[144,"همان به گر آبستن گوهری","که همچون صدف سر به خود در بری","انسان در جنینی مانند صدف، همواره در حال پرورش و نگهداری یک گوهری است که هنوز به دنیا نیامده است. این اشاره به ارزش‌مند بودن فطرت و استعدادهای درونی انسان دارد که به تدریج به کمال می‌رسند."],[144,"چو روی پرستیدنت در خداست","اگر جبرئیلت نبیند رواست","اگر محبت و پرستش تو به خداوند باشد، جایز است که اگر فرشته جبرئیل تو را نمی‌بیند، در مقامی غیر از مقام نبی و پیامبر قرار داشته باشی."],[144,"تو را پند سعدی بس است ای پسر","اگر گوش گیری چو پند پدر","خدا را در نظر بگیر و به نصیحت‌های سعدی گوش کن، زیرا این نصیحت‌ها برای تو به اندازه پندهای پدر مهم و ارزشمند است."],[144,"گر امروز گفتار ما نشنوی","مبادا که فردا پشیمان شوی","اگر امروز سخنان ما را نشنوی و توجه نکنی، ممکن است فردا به خاطر این بی‌توجهی پشیمان شوی."],[144,"از این به نصیحتگری بایدت","ندانم پس از من چه پیش آیدت!","اگر به نصیحت من گوش نکنی، نمی‌دانم بعد از من چه بر سرت خواهد آمد!"],[145,"خدا را ندانست و طاعت نکرد","که بر بخت و روزی قناعت نکرد","کسی که خدا را نشناخته و اطاعتش نکرده، به خاطر اینکه در زندگی‌اش راضی به قناعت نبوده و همیشه به دنبال خوشبختی و روزی بیشتر بوده، به این وضعیت دچار شده است."],[145,"قناعت توانگر کند مرد را","خبر کن حریص جهانگرد را","قناعت انسان را غنی و بی‌نیاز می‌کند، اما به حریص و دنیا طلب بگو که این حس وابستگی به مال و دنیا او را به سختی می‌اندازد."],[145,"سکونی به دست آور ای بی ثبات","که بر سنگ گردان نروید نبات","برای رسیدن به آرامش و ثبات در زندگی، باید به دنبال امکاناتی باشی که پایدار و مطمئن هستند، چرا که مانند گیاهانی که روی سنگ نمی‌رویند، تو نیز نمی‌توانی در شرایط بی‌ثباتی رشد کنی."],[145,"مپرور تن ار مرد رای و هشی","که او را چو می‌پروری می‌کشی","اگر مردی حکیم و باهوش هستی، تن خود را پرورش نده؛ زیرا اگر تو را مانند می‌پرورانند، در واقع خودت را می‌کشی."],[145,"خردمند مردم هنر پرورند","که تن پروران از هنر لاغرند","افراد دانا و خردمند به تربیت و پرورش هنر می‌پردازند، در حالی که کسانی که فقط به تمایلات جسمی و تن پروری می‌پردازند معمولا از هنر و دانش خالی هستند."],[145,"کسی سیرت آدمی گوش کرد","که اول سگ نفس خاموش کرد","آدمی که به سیرت و باطن انسان‌ها توجه کند، در ابتدا باید نفس اماره خود را خاموش کند و به کنترل آن بپردازد."],[145,"خور و خواب تنها طریق دد است","بر این بودن آیین نابخرد است","تنها راه زندگی حیوانات، خوردن و خوابیدن است و ادامه دادن این زندگی برای انسان، نشانه نادانی و بی‌خردی است."],[145,"خنک نیکبختی که در گوشه‌ای","به دست آرد از معرفت توشه‌ای","خوش به حال کسی که در سکوت و تنهایی بتواند از دانش و فهم خود، توشه‌ای برای زندگی‌اش جمع‌آوری کند."],[145,"بر آنان که شد سر حق آشکار","نکردند باطل بر او اختیار","افرادی که حقیقت بر آنان روشن شده است، نمی‌توانند باطل را انتخاب کنند و سال به حرف‌های نادرست روی آورند."],[145,"ولیکن چو ظلمت نداند ز نور","چه دیدار دیوش چه رخسار حور","اما زمانی که ظلمت، نوری را نمی‌شناسد، چگونه می‌تواند زیبایی دیو را با زیبایی حور (موجودات بهشتی) مقایسه کند. در اینجا اشاره به نادانی و محدودیت در درک حقیقت‌ها و زیبایی‌ها دارد."],[145,"تو خود را از آن در چه انداختی","که چه را ز ره باز نشناختی","تو چرا خود را به چالش انداخته‌ای که از راه حقیقت و واقعیت چیزی را نمی‌توانی تشخیص بدهی؟"],[145,"بر اوج فلک چون پرد جره باز","که در شهپرش بسته‌ای سنگ آز؟","آیا تو بر افرازگی و بلندی آسمان مثل پرنده‌ای پرواز می‌کنی که سنگی به بال‌هایش بسته‌ای؟ این تعبیر نشان می‌دهد که اگر آدمی به تمایلات و خواسته‌های نفسانی خود وابسته باشد، قادر به پرواز و رسیدن به ارتفاعات معنوی نخواهد بود."],[145,"گرش دامن از چنگ شهوت رها","کنی، رفت تا سدرةالمنتهی","اگر دامن خود را از چنگال شهوت (هرزه‌خواهی) آزاد کنی، به مقام و جایگاه والایی خواهی رسید."],[145,"به کم کردن از عادت خویش خورد","توان خویشتن را ملک خوی کرد","با کم کردن از عادات و خواسته‌های خود، می‌توان قدرت و کنترل بیشتری بر زندگی و سرنوشت خود پیدا کرد."],[145,"کجا سیر وحشی رسد در ملک","نشاید پرید از ثری بر فلک","سیر وحشی نمی‌تواند در سرزمین‌های انسان‌ها قرار گیرد و نمی‌تواند از ستاره‌های بلند به زمین بپرد."],[145,"نخست آدمی سیرتی پیشه کن","پس آن گه ملک خویی اندیشه کن","ابتدا باید آدابی را که در رفتار و شخصیت خود باید داشته باشی، ایجاد کنی و سپس به فکر مقام و سلطنت خود باش."],[145,"تو بر کره توسنی بر کمر","نگر تا نپیچد ز حکم تو سر","به کمر اسب نر که می‌تازند، نگاه کن تا از فرمان تو منحرف نشود."],[145,"که گر پالهنگ از کفت درگسیخت","تن خویشتن کشت و خون تو ریخت","اگر تو از دست خودت (یعنی بی‌احتیاطی) دچار آسیب و زیان شوی، به خودت صدمه زدی و خونت ریخته می‌شود."],[145,"به اندازه خور زاد اگر مردمی","چنین پر شکم، آدمی یا خمی؟","اگر انسان‌ها به اندازه‌ای که می‌خورند زاد و روزی داشته باشند، آیا چنین شکم پر و بی‌مقدار بودن، نشانه‌ای از انسانیت است یا نشانه‌ای از حیوانیت؟"],[145,"درون جای قوت است و ذکر و نفس","تو پنداری از بهر نان است و بس","در وجود انسان نیاز به خوراک و ذکر (یاد خدا) و نفس کشیدن وجود دارد، اما فکر می‌کنی که تمام اینها فقط برای تأمین نان و مایحتاج زندگی است."],[145,"کجا ذکر گنجد در انبان آز؟","به سختی نفس می‌کند پا دراز","ذکر و یاد خدا در دل کسی که دچار طمع و آز است، جایی ندارد. او به سختی نفس می‌کشد و برای دستیابی به خواسته‌هایش تلاش می‌کند."],[145,"ندارند تن پروران آگهی","که پر معده باشد ز حکمت تهی","تن پروران، افرادی که به راحتی زندگی می‌کنند و زحمت نمی‌کشند، نمی‌دانند که پر بودن شکم به معنای نادانی و خالی بودن از حکمت و آگاهی است."],[145,"دو چشم و شکم پر نگردد به هیچ","تهی بهتر این روده پیچ پیچ","چشمان و شکم پر هرگز انسان را سیراب نمی‌کند، بلکه بهتر است روده‌های پیچ‌دار وجود انسان را خالی نگه داریم."],[145,"چو دوزخ که سیرش کنند از وقید","دگر بانگ دارد که هل من مزید؟","جهنم هم هرگز سیر نمی‌شود و وقتی آن را از گناهان و دردها خالی می‌کنند، باز هم فریاد می‌زند که آیا چیزی بیشتر نمی‌خواهید؟ این به این معناست که همیشه طلب بیشتری دارد و هرگز ارضا نمی‌شود."],[145,"همی میردت عیسی از لاغری","تو در بند آنی که خر پروری","عیسی از شدت لاغری تو در حال جان دادن است، اما تو توجهی به این ندارید و تنها به پرورش خر (و عشق به دنیای مادی) اهمیت می‌دهید."],[145,"به دین، ای فرومایه، دنیا مخر","تو خر را به انجیل عیسی مخر","ای انسان حقیر، به خاطر دنیا دین خود را خراب نکن؛ نه دین را فدای دنیا کن و نه ارزش‌های معنوی را به خاطر حیوانات و دنیا به خطر بینداز."],[145,"مگر می‌نبینی که دد را و دام","نینداخت جز حرص خوردن به دام؟","آیا نمی‌بینی که وحش‌ها (دد) و حیوانات (دام) را فقط از روی طمع و حرص به دام می‌اندازند؟"],[145,"پلنگی که گردن کشد بر وحوش","به دام افتد از بهر خوردن چو موش","پلنگی که بر روی جانوران طعمه خود تکیه می‌کند و گردن‌کشی می‌کند، به دام می‌افتد تا از آنها خوراک به‌دست آورد، مانند موشی که به خاطر غذایی که می‌خورد، در دام گرفتار می‌شود."],[145,"چو موش آن که نان و پنیرش خوری","به دامش درافتی و تیرش خوری","کسی که مانند موش، به نان و پنیرش حریص باشی، در دام او می‌افتی و آسیب می‌بینی."],[146,"مرا حاجیی شانه عاج داد","که رحمت بر اخلاق حجاج باد","حاجی ای به من شانه ای از جنس عاج هدیه داد (رسم حاجیان قدیمی، دادن چنین سوغات هایی بوده)"],[146,"شنیدم که باری سگم خوانده بود","که از من به نوعی دلش مانده بود","شنیده بودم که یک بار من را سگ خوانده بود (پشت سرم مرا سگ صدا زده بود و توهین کرده بود)، به نوعی از من در دلش چیزی مانده بود."],[146,"بینداختم شانه کاین استخوان","نمی‌بایدم دیگرم سگ مخوان","آن شانه ی عاج را انداختم و هدیه ی او را نپذیرفتم، گفتم این استخوان تو را نمیخواهم ولی دیگر مرا سگ نخوان! (تشبیه شانه‌ی عاج به استخوان دادن به سگ)"],[146,"مپندار چون سرکه خود خورم","که جور خداوند حلوا برم","فکر نکن چون سرکه ی خودم را می‌خورم قرار است منت صاحب شیرینی را ببرم! (سرکه در برابر حلوا، نماد خوراک بدون شیرینی و نامطلوب است)"],[146,"قناعت کن ای نفس بر اندکی","که سلطان و درویش بینی یکی","ای نفس، سعی کن که به اندک چیزی که داری قانع باشی، که در این صورت شاه و گدا را برابر میبینی (اگر طمع و آز نداشته باشی سلطان و درویش برای تو فرقی نمیکند و عزت خود را با منت کشیدن از بین نمی‌بری)"],[146,"چرا پیش خسرو به خواهش روی","چو یک سو نهادی طمع، خسروی","چرا به خاطر خواهش و درخواست خود، در برابر شاه (خسرو) طمع کرده‌ای، در حالی که خود را از او پایین‌تر می‌دانی؟"],[146,"وگر خود پرستی شکم طبله کن","در خانه این و آن قبله کن","اگر خودت را فقط به شکم و خوراک خود مشغول کنی، در خانه دیگران، خود را مانند قبله‌ای برای خود قرار می‌دهی، یعنی خود را محور زندگی و خوشی‌هایشان می‌سازی."],[147,"یکی پر طمع پیش خوارزمشاه","شنیدم که شد بامدادی پگاه","یک شخص پر طمع به نزد خوارزمشاه (سلطنت در آن زمان) آمد و شنیدم که در هنگام صبح زود، به دیدن او رفته بود."],[147,"چو دیدش به خدمت دوتا گشت و راست","دگر روی بر خاک مالید و خاست","وقتی خوارزمشاه او (شخص طمعکار) را دید که به خدمتش آمده، او (شخص طمعکار) دو زانو نشست و سرش را به خاک مالید و بلند شد."],[147,"پسر گفتش ای بابک نامجوی","یکی مشکلت می‌بپرسم بگوی","پسر به پدرش، بابک نامجوی، گفت: \"من یک سوال درباره مشکلی دارم، می‌خواهم بپرسم، لطفا جواب بده."],[147,"نگفتی که قبله‌ست سوی حجاز","چرا کردی امروز از این سو نماز؟","چرا نگفتی که کعبه و قبله‌ اصلی به سمت حجاز است؟ پس چرا امروز به سمت دیگری نماز خواندی؟"],[147,"مبر طاعت نفس شهوت پرست","که هر ساعتش قبله دیگر است","از پیروی از نفس و خواسته‌های شهوانی خودداری کن؛ زیرا هر لحظه تمایلات او به سوی چیزی جدید کشیده می‌شود و در واقع، ثبات و جهت مشخصی ندارد."],[147,"مبر ای برادر به فرمانش دست","که هر کس که فرمان نبردش برست","ای برادر، به فرمان نفس اماره (شهوت) گوش نده، زیرا کسی که از این فرمان اطاعت نکند، هلاک می‌شود."],[147,"قناعت سرافرازد ای مرد هوش","سر پر طمع بر نیاید ز دوش","قناعت انسان را سرافراز و بلند مرتبه می‌کند، ای مرد خردمند؛ و طمع و آرزوهای بی‌پایان سنگینی بر دوش انسان می‌آورند که نباید به آن‌ها توجه کرد."],[147,"طمع آبروی توقر بریخت","برای دو جو دامنی در بریخت","آبروی شخصی که طمع دارد، برای به دست آوردن دو پول ناچیز هدر می‌رود."],[147,"چو سیراب خواهی شدن ز آب جوی","چرا ریزی از بهر برف آبروی؟","اگر می‌خواهی از آب جوی سیراب شوی، چرا برای حفظ آبرویت دچار زحمت می‌شوی؟"],[147,"مگر از تنعم شکیبا شوی","وگرنه ضرورت به درها شوی","اگر از زندگی راحت به صبر و تحمل نرسیده‌ای، در غیر این صورت ناچار خواهی شد در مشکلات و سختی‌ها به درهای دیگر بروی."],[147,"برو خواجه کوتاه کن دست آز","چه می‌بایدت ز آستین دراز؟","ای خواجه، دست خود را از طمع و آز کوتاه کن؛ چه نیازی داری به آنچه از دست دیگران بیرون می‌آید؟"],[147,"کسی را که درج طمع در نوشت","نباید به کس عبد و خادم نبشت","کسی را که آرزوی زیاد دارد و طمع به مال دیگران می‌ورزد، نباید به عنوان بنده و خدمتکار دیگران در نظر گرفت."],[147,"توقع براند ز هر مجلست","بران از خودش تا نراند کست","انتظارات و توقعات را باید از هر جمعیتی (مجلسی) دور کرد تا فردی را که طلبی از او می‌شود، دور نسازد و از خود برنگرداند."],[148,"یکی را تب آمد ز صاحبدلان","کسی گفت شکّر بخواه از فلان","شخص فرهیخته‌ای به شدت بیمار شده بود و کسی به او گفت که برای بهبودی‌اش از شخص خاصی شکر بخواهد."],[148,"بگفت ای پسر تلخی مردنم","به از جور روی ترش بردنم","گفت ای پسر، مرگ تلخ من به مراتب از رنج ناشی از ترشرویی او بهتر است."],[148,"شکر عاقل از دست آن کس نخورد","که روی از تکبر بر او سرکه کرد","عاقل از کسی که به خاطر تکبرش به او بی‌اعتنایی می‌کند، هرگز شکر طلب نمی‌کند."],[148,"مرو از پی هر چه دل خواهدت","که تمکین تن نور جان کاهدت","به دنبال هر چیزی که دلت می‌خواهد نرو، زیرا پیروی از خواسته‌های جسمی می‌تواند روح تو را ضعیف کند."],[148,"کند مرد را نفس اماره خوار","اگر هوشمندی عزیزش مدار","نفس اماره، نفس سرکش و وسوسه‌گر است که انسان را به سمت خواسته‌های نادرست می‌کشاند. اگر مردی هوشمند باشد، نباید بگذارد که این نفس او را ذلیل و خوار کند."],[148,"اگر هرچه باشد مرادت خوری","ز دوران بسی نامرادی بری","اگر هرچه هست، تنها هدف تو خوردن باشد، از شر بسیاری از بدشانسی‌ها نجات پیدا می‌کنی."],[148,"تنور شکم دم به دم تافتن","مصیبت بود روز نایافتن","شکم در حال تلاش برای هضم غذا به مصیبت و درد دچار می‌شود، مانند تنوری که همیشه در حال گرم شدن است تا غذا بپزد، و در روزهایی که غذا نمی‌یابی، این مصیبت بیشتر می‌شود."],[148,"به تنگی بریزاندت روی رنگ","چو وقت فراخی کنی معده تنگ","وقتی که در تنگدستی و کمیابی قرار داری، چهره‌ات تغییر می‌کند و رنگت پریده می‌شود، اما زمانی که به فراخی و وفور می‌رسی، معده‌ات هم تنگ می‌شود و دیگر نیازی به غذا ندارید."],[148,"کشد مرد پرخواره بار شکم","وگر در نیابد کشد بار غم","مردی که زیاده‌خوری می‌کند، سنگینی بار شکمش را تحمل می‌کند و اگر نتواند به مقدار کافی بخورد، بار غم و اندوه را به دوش می‌کشد."],[148,"شکم بنده بسیار بینی خجل","شکم پیش من تنگ بهتر که دل","نمی‌توانی از چاقی و شکم بزرگ من بترسی، زیرا شکم من به دلیل ضعف در روح و دل تنگ من به وجود آمده است. بهتر است که به درون نگری و دل را بهتر بسازی تا به این مسائل ظاهری توجه نکنی."],[149,"چه آوردم از بصره دانی عجب","حدیثی که شیرین تر است از رطب","از بصره چه خبر آورده‌ام، داستانی عجیب و جالب که شیرین‌تر از خرما است."],[149,"تنی چند در خرقه راستان","گذشتیم بر طرف خرماستان","ما عده‌ای از پیرایه‌پوشان زاهدی را در کنار باغ خرما ملاقات کردیم."],[149,"یکی در میان معده انبار بود","ز پر خواری خویش بس خوار بود","یکی از آن‌ها در دلش انباری از خوراک داشت، اما به خاطر تنبلی و بی‌کفایتی خود به شدت خوار و ذلیل شده بود."],[149,"میان بست مسکین و شد بر درخت","وز آنجا به گردن در افتاد سخت","مسکینی که در وسط تنگدستی و فقر بوده، به درختی رسیده و تلاش کرده تا میوه‌ای از آن بچیند، اما به‌طور ناگهانی از بالای درخت به زمین افتاده است."],[149,"نه هر بار خرما توان خورد و برد","لت انبان بد عاقبت خورد و مرد","هر بار نمی‌توان از خرما خورده و آن را برداشت کرد، زیرا پرخوری و بی‌توجهی به حد و اندازه می‌تواند به دردسر و عاقبت بد بیانجامد."],[149,"رئیس ده آمد که این را که کشت؟","بگفتم مزن بانگ بر ما درشت","رئیس ده آمد و پرسید که چه کسی این محصول را برداشت کرده است؟ من گفتم به او که بر ما فریاد نزن و به طور تند صحبت نکن."],[149,"شکم دامن اندر کشیدش ز شاخ","بود تنگدل رودگانی فراخ","شکم، به دلیل داشتن دل تنگ و ناراحت، در دامن او کشیده شد که نشانه‌ای از مشکل و فشار مالی است. به عبارتی، فردی که پرخور و طمع‌کار است، دچار مشکلات و محدودیت‌های بیشتری خواهد شد."],[149,"شکم بند دست است و زنجیر پای","شکم بنده نادر پرستد خدای","شکم به دست و زنجیر پا شده، و بنده به خاطر آن، مانند نادر (پادشاه مشهور) خدا را می‌پرستد. این بیان به طور ضمنی نشان می‌دهد که وابستگی به شکم و دنبال کردن لذت‌های دنیوی انسان را به بندگی و ذلت می‌کشاند."],[149,"سراسر شکم شد ملخ لاجرم","به پایش کشد مور کوچک شکم","این بیت به آن اشاره دارد که اگر شکم شخصی به اندازه‌ای بزرگ شود که همچون ملخ شود، در آن صورت زحمات کوچک مانند مور، او را به زمین خواهند کشید. به عبارتی، زیاده‌روی در خوردن و سیری می‌تواند باعث مشکلات و زحمت‌هایی شود که انسان را ذلیل و درگیر می‌کند."],[149,"برو اندرونی به دست آر، پاک","شکم پر نخواهد شد الّا به خاک","به درون خودت برو و تلاش کن، زیرا شکم هرگز پر نخواهد شد مگر با خاک و پشیمانی."],[150,"شکم صوفیی را زبون کرد و فرج","دو دینار بر هر دوان کرد خرج","گرسنگی و میل به زن‌، صوفی‌یی را در فشار قرار داد؛ دو دینار برای هردو خرج کرد."],[150,"یکی گفتش از دوستان در نهفت","چه کردی بدین هر دو دینار؟ گفت","دوستی به‌طور خصوصی از او پرسید؛ چه‌کردی با آن دو دینار؟ پاسخ‌داد"],[150,"به دیناری از پشت راندم نشاط","به دیگر، شکم را کشیدم سماط","به یک‌دینار از کمر خود، نشاط راندم و با دینار دیگر، شکم را مهمان کردم."],[150,"فرومایگی کردم و ابلهی","که این همچنان پر نشد وآن تهی","ابلهی و پستی کردم زیرا نه این پر شد و نه آن خالی."],[150,"غذا گر لطیف است و گر سرسری","چو دیرت به دست اوفتد خوش خوری","غذا چه خوشمزه باشد چه نامطبوع؛ وقتی که دیر به دست تو بیفتد آن‌را با لذت می‌خوری."],[150,"سر آنگه به بالین نهد هوشمند","که خوابش به قهر آورد در کمند","آدم دانا، وقتی می‌خوابد که شدیدا نیاز به خواب داشته باشد."],[150,"مجال سخن تا نیابی مگوی","چو میدان نبینی نگه دار گوی","وقتی که فرصت برای حرف‌زدن نمی‌یابی‌، خموش باش؛ وقتی که بازی و میدان‌ (چوگان) وجود ندارد گوی را نگه‌دار."],[150,"وز اندازه بیرون، مرو پیش زن","نه دیوانه‌ای تیغ بر خود مزن","بیش از اندازه با زن آمیزش مکن؛ این کار از دیوانگی است، به‌خود زیان مزن."],[150,"به بی رغبتی شهوت انگیختن","به رغبت بود خون خود ریختن","اگر شهوت خود را به‌زور تحریک کنی و آمیزش نمایی چنان‌است که خون خود را با دست خود ریخته‌ای (به‌تندرستی خود، لطمه زده‌ای)"],[151,"یکی نیشکر داشت بر طبقری","چپ و راست گردیده بر مشتری","مردی نیشکر دارد که بر سینی (یا ظرفی) گذاشته شده و دور آن را زینت داده‌اند."],[151,"به صاحبدلی گفت در کنج ده","که بستان و چون دست یابی بده","به صاحبدلی در گوشه ای از ده پیشنهاد کرد اکنون بردار و وقتی که دستت باز شد پولش را بده"],[151,"بگفت آن خردمند زیبا سرشت","جوابی که بر دیده باید نبشت","خردمند زیبا سرشت گفت: جوابی که باید بر چشم نوشته شود."],[151,"تو را صبر بر من نباشد مگر","ولیکن مرا باشد از نیشکر","تو هیچ صبری بر تحمل من نداری، اما من از نیشکر یعنی از آنچه شیرین است، تحمل دارم."],[151,"حلاوت ندارد شکر در نیش","چو باشد تقاضای تلخ از پیش","شکر وقتی خوشمزه و شیرین است که نی (قند) باشد، ولی اگر از پیش درخواست تلخی شود، دیگر دلچسبی ندارد."],[152,"یکی را ز مردان روشن ضمیر","امیر ختن داد طاقی حریر","امیر ختن یکی از مردان دانا و آگاه بود که به او طاقی از حریر داده شد."],[152,"ز شادی چو گلبرگ خندان شکفت","نپوشید و دستش ببوسید و گفت:","ز شادی مانند گلبرگ خندان شکفته شد، دستش را بوسید و گفت:"],[152,"چه خوب است تشریف میر ختن","وز او خوب تر خرقه خویشتن","تشریف میر ختن یعنی مقام و جایگاه میر ختن (نخست وزیر)، بسیار خوب و دلپذیر است، اما مقام و شخصیت آدمی خود فرد، حتی از او هم بهتر است."],[152,"گر آزاده‌ای بر زمین خسب و بس","مکن بهر قالی زمین بوس کس","اگر انسان آزاده‌ای بر زمین بخوابد، نباید برای کسی که بر روی فرش می‌خوابد، تحقیر و بی‌احترامی کند."],[153,"یکی نان‌خورش جز پیازی نداشت","چو دیگر کسان برگ و سازی نداشت","چیزی که این شخص برای خوردن داشت فقط نان و پیاز بود و مانند دیگران خوراک و خوشمزگی نداشت."],[153,"پراکنده‌ای گفتش ای خاکسار","برو طبخی از خوان یغما بیار","پراکنده‌ای به خاکساری گفت برود و غذایی از سفره یغما (دزدی) بیاورد، یعنی غذایی که به غارت و دزدی به دست آمده است."],[153,"بخواه و مدار از کس ای خواجه باک","که مقطوع روزی بود شرمناک","ای خواجه، بخواه و از کسی دست نکش، زیرا که نداشتن روزی از ابتدا یک عیب بزرگ است."],[153,"قبا بست و چابک نوردید دست","قبایش دریدند و دستش شکست","او به لباسی شیک و زیبا (قبا) پوشید و با شتاب به سوی هدفش رفت، اما در این روند، لباسش پاره شد و دستش نیز آسیب دید."],[153,"شنیدم که می‌گفت و خون می‌گریست","که ای نفس، خودکرده را چاره چیست؟","آدمی شنیدم که می‌گفت و به شدت ناراحت بود، در حال گریه و زاری بود و می‌پرسید ای نفس (خود)، برای کسی که خود باعث این سرنوشتش شده، چه راهی وجود دارد؟"],[153,"بلا جوی باشد گرفتار آز","من و خانه من‌بعد و نان و پیاز","مردم گرفتار بلا و مصیبت، به دنبال آز و آرزوهای من هستند، در حالی که من و خانواده‌ام به نان و پیاز نیاز داریم."],[153,"جوینی که از سعی بازو خورم","به از میده بر خوان اهل کرم","بهتر است که از زحمت و تلاش خودم برای کسب روزی بخورم، تا اینکه از سفره دیگران و برکت آن‌ها استفاده کنم."],[153,"چه دلتنگ خفت آن فرومایه دوش","که بر سفره دیگران داشت گوش","فرومایه‌ای که به دیگران تکیه می‌کند و شب را در غم و دلتنگی می‌گذراند، واقعا متأسف و ناراحت‌کننده است."],[154,"یکی گربه در خانه زال بود","که برگشته ایام و بدحال بود","گربه‌ای در خانه زال وجود داشت که به دلیل گذشت زمان و تغییر وضعیت، حال خوبی نداشت."],[154,"دوان شد به مهمان‌سرای امیر","غلامان سلطان زدندش به تیر","گربه به سرعت به مهمان‌سرای امیر دوید و غلامان سلطان او را با تیر زدند."],[154,"چکان خونش از استخوان، می‌دوید","همی گفت و از هول جان می‌دوید","خونش از بدنش جاری می‌شد و او به شدت می‌دوید و در حال فرار، به خاطر ترس از جانش این جمله را تکرار می‌کرد."],[154,"اگر جستم از دست این تیرزن","من و موش و ویرانه پیرزن","اگر از دستان این تیرانداز فرار کنم، به یک موش و ویرانه‌ای که به پیرزنی تعلق دارد، می‌رسم."],[154,"نیرزد عسل، جان من، زخم نیش","قناعت نکوتر به دوشاب خویش","زخم نیش قناعت بهترین و باارزش‌ترین چیز است و به خاطر آن، هرچند عسل هم نیرزد، جان من ارزش دارد."],[154,"خداوند از آن بنده خرسند نیست","که راضی به قسم خداوند نیست","خداوند از بندگانی که به مقدرات خود راضی نیستند و قناعت نمی‌کنند، خوشنود نمی‌شود."],[155,"یکی طفل دندان برآورده بود","پدر سر به فکرت فرو برده بود","کودکی نوپا دندان درآورده بود و پدرش از ترس و دغدغه تأمین خوراک او، سر به گریبان اندیشه و نگرانی فرو برده بود."],[155,"که من نان و برگ از کجا آرمش؟","مروت نباشد که بگذارمش","با خود می‌گفت: من خوراک و توشه و لوازم زندگی او را از کجا فراهم کنم؟ از جوانمردی و انصاف هم دور است که او را به حال خود رها کنم."],[155,"چو بیچاره گفت این سخن، نزد جفت","نگر تا زن او را چه مردانه گفت:","هنگامی که آن مرد درمانده این دغدغه را نزد همسرش بیان کرد، ببین که آن زن چقدر شجاعانه، خردمندانه و باهمت به او پاسخ داد:"],[155,"مخور هول ابلیس تا جان دهد","همان کس که دندان دهد نان دهد","فریب ترس و وسوسه شیطان را مخور؛ تا زمانی که انسان جان در بدن دارد، همان پروردگاری که دندان برای جویدن داده، نان و روزی آن را هم خواهد رساند."],[155,"تواناست آخر خداوند روز","که روزی رساند، تو چندین مسوز","آفریدگاری که روشنایی و وسعت روز را پدید می‌آورد، تواناست که روزی را هم برساند؛ پس تو جان خود را این‌چنین در آتش اضطراب مسوزان."],[155,"نگارنده کودک اندر شکم","نویسنده عمر و روزی است هم","همان خالقی که کودک را در تاریکی رحم مادر صورت‌گری و تصویر کرده، اندازه طول عمر و مقدار روزی او را نیز مقدر و ثبت نموده است."],[155,"خداوندگاری که عبدی خرید","بدارد، فکیف آن که عبد آفرید","اربابی انسانی وقتی برده‌ای را می‌خرد، خوراک و آسایش او را تأمین می‌کند و نگاهش می‌دارد؛ پس چگونه ممکن است خدایی که خود بنده را آفریده، او را تباه سازد؟"],[155,"تو را نیست این تکیه بر کردگار","که مملوک را بر خداوندگار","شگفتا که تو به آفریدگار توانا آن‌قدر توکل و اطمینان نداری که یک برده خریده‌شده به صاحب و ارباب ناتوان خود دارد!"],[155,"شنیدی که در روزگار قدیم","شدی سنگ در دست ابدال سیم","آیا شنیده‌ای که در گذشته می‌گفتند سنگ در دست مردان پاک‌نهاد و اولیای خدا (ابدال) تبدیل به نقره و سیم می‌شد؟"],[155,"نپنداری این قول معقول نیست","چو قانع شدی سیم و سنگت یکی است","گمان مبر که این سخن دور از عقل یا امری غیرمنطقی است؛ حقیقت این است که اگر به مقام قناعت برسی، نقره و سنگ در نظرت تفاوتی نخواهند داشت و نیازی به زر احساس نخواهی کرد."],[155,"چو طفل اندرون دارد از حرص پاک","چه مشتی زرش پیش همت چه خاک","همان‌طور که کودک دلی پاک و پیراسته از حرص دارد، در پیشگاه انسان والاهمّت و قناعت‌پیشه نیز یک مشت زر با مشتی خاک بی‌ارزش برابر است."],[155,"خبر ده به درویش سلطان‌پرست","که سلطان ز درویش مسکین‌ترست","به آن فرد تهیدستی که پادشاهان را بزرگ می‌پندارد و به موقعیتشان غبطه می‌خورد بگو: پادشاه به خاطر افزون‌طلبی، از درویش هم بینواتر و محتاج‌تر است."],[155,"گدا را کند یک درم سیم سیر","فریدون به ملک عجم نیم سیر","یک سکه نقره، نیازمند را سیر و خرسند می‌سازد، اما پادشاه بزرگی مانند فریدون حتی با داشتن تمام قلمرو ایران هم طمعش سیراب نمی‌شود و حریص باقی می‌ماند."],[155,"نگهبانی ملک و دولت بلاست","گدا پادشاه است و نامش گداست","پاسداری و مراقبت از فرمانروایی و ثروت، رنج و بلایی دائمی است؛ بنابراین تهیدستی که از این دغدغه‌ها رهاست، شاه واقعی جهان است هرچند به نام گدا خوانده شود."],[155,"گدایی که بر خاطرش بند نیست","به از پادشاهی که خرسند نیست","نیازمندی که دلش در بند دلبستگی‌ها و نگرانی‌های دنیا نیست، بسیار برتر از پادشاهی است که از داشته‌های خود آرامش و رضایت ندارد."],[155,"بخسبند خوش روستایی و جفت","به ذوقی که سلطان در ایوان نخفت","یک مرد روستایی و همسرش در کلبه ساده خود با چنان آرامش و لذتی به خواب می‌روند که هیچ پادشاهی در کاخ مجلل خود هرگز چنین خواب خوشی ندیده است."],[155,"اگر پادشاه است و گر پینه‌دوز","چو خفتند گردد شب هر دو روز","خواه آن فرد پادشاهی باجلال باشد و خواه کفاشی پینه‌دوز، هنگامی که چشمانشان به خواب می‌رود، شب آرام برای هر دو سپری می‌شود و در خواب هیچ امتیازی بر هم ندارند."],[155,"چو سیلاب خواب آمد و مرد برد","چه بر تخت سلطان، چه بر دشت کرد","وقتی سیلاب سنگین خواب جاری شود و هوش را از سر ببرد، تفاوتی نمی‌کند که بر تخت مرصع پادشاهی خوابیده باشی یا روی خاک و خار بیابان."],[155,"چو بینی توانگر سر از کبر مست","برو شکر یزدان کن ای تنگدست","ای انسان تهیدست، هرگاه ثروتمندی را دیدی که از فرط غرور و تکبر ناشی از مال از خود بی‌خود شده است، برو و پروردگار را سپاس بگوی؛"],[155,"نداری بحمدالله آن دسترس","که برخیزد از دستت آزار کس","خدا را سپاس بگزار که به تو آن قدرت و مکنت داده نشده که به واسطه آن به آزار و پایمال کردن حقوق دیگران دست بزنی."],[156,"شنیدم که صاحبدلی نیکمرد","یکی خانه بر قامت خویش کرد","شنیدم که مردی دانا و صالح، خانه‌ای بر اندازه‌ی خود ساخت."],[156,"کسی گفت می‌دانمت دسترس","کز این خانه بهتر کنی، گفت بس","کسی به آن مرد نیکو گفت که می‌داند می‌تواند خانه‌اش را زیباتر و بهتر بسازد، اما او پاسخ داد که همین خانه برای او کافی است و نیازی به بهتر شدن ندارد."],[156,"چه می‌خواهم از طارم افراشتن؟","همینم بس از بهر بگذاشتن","من برای چه به دنبال ساختن خانه‌ای بلند بر روی درختان هستم؟ همین که اینجا زندگی می‌کنم برای من کافی است."],[156,"مکن خانه بر راه سیل، ای غلام","که کس را نگشت این عمارت تمام","ای غلام، خانه‌ات را در مسیر سیل بنا نکن، زیرا هیچ‌کس نتوانسته است این بنا را به طور کامل بسازد."],[156,"نه از معرفت باشد و عقل و رای","که بر ره کند کاروانی سرای","این بیت می‌گوید که مالکیت و مدیریت یک خانه یا سرای خوب به دانش، عقل و تدبیر بستگی ندارد، بلکه به موقعیت و شرایطی که در آن قرار دارد وابسته است."],[157,"یکی سلطنت ران صاحب شکوه","فرو خواست رفت آفتابش به کوه","یک پادشاه صاحب قدرت و شوکت، ناگهان تاج و تختش را رها کرد و رفت. مانند خورشیدی که به کوه‌ها می‌رود و ناپدید می‌شود."],[157,"به شیخی در آن بقعه کشور گذاشت","که در دوره قائم مقامی نداشت","شخصی در آن مکان مقدس (بقعه) به یک شیخ تکیه کرده و دنیا را به او واگذار کرده، چراکه او در زمان حکمرانی، مقام و منصب نداشته است."],[157,"چو خلوت نشین کوس دولت شنید","دگر ذوق در کنج خلوت ندید","وقتی شخصی که در تنهایی و گوشه‌نشینی به خوشبختی و ثروت دست یافته، صدای دولت را می‌شنود، دیگر هیچ لذتی در آن خلوت و تنهایی نمی‌بیند."],[157,"چپ و راست لشکر کشیدن گرفت","دل پردلان زو رمیدن گرفت","دل شجاعان به خاطر شنیدن خبر لشکرکشی، به شدت ترسید و به سمت چپ و راست فرار کردند."],[157,"چنان سخت بازو شد و تیز چنگ","که با جنگجویان طلب کرد جنگ","دل شیرمردان چنان سرسخت و قوی شد و چنگال‌هایشان تیز گردید که در جستجوی نبرد با جنگجویان به میدان آمدند."],[157,"ز قوم پراکنده خلقی بکشت","دگر جمع گشتند و هم رای و پشت","از میان مردم پراکنده، گروهی به‌هم پیوستند و به یکدیگر کمک کردند و متحد شدند تا به مقابله با دشمن برآیند."],[157,"چنان در حصارش کشیدند تنگ","که عاجز شد از تیرباران و سنگ","آن‌ها او را به گونه‌ای محاصره کردند که دیگر نتوانست در برابر تیر و سنگ مقاومت کند."],[157,"بر نیکمردی فرستاد کس","که صعبم فرومانده، فریاد رس","آدم نیک‌نفس را به کمک فرستادند تا به من، که در وضعیت سخت و دشواری گرفتار شده‌ام، یاری رساند."],[157,"به همت مدد کن که شمشیر و تیر","نه در هر وغایی بود دستگیر","با اراده و تلاش کمک کن، زیرا شمشیر و تیر در هر جایی نمی‌تواند به نجات و کمک بیاید."],[157,"چو بشنید عابد بخندید و گفت","چرا نیم نانی نخورد و نخفت؟","عابدی که حرف‌های دیگران را شنید، خندید و گفت: چرا او (قارون) نان نمی‌خورد و نمی‌خوابد؟"],[157,"ندانست قارون نعمت پرست","که گنج سلامت به کنج اندر است","قارون، که ثروت را بسیار دوست داشت و به خاطر آن دچار مشکلات و حسادت شد، نمی‌دانست که بهترین و بزرگ‌ترین نعمت، آرامش درونی و سلامت است که در دل انسان قرار دارد، نه در مال و اموال."],[158,"کمال است در نفس مرد کریم","گرش زر نباشد چه نقصان و بیم؟","نیکوکاری و عظمت نفس در انسان شریف به پول و ثروت نیاز ندارد، حتی اگر او از دارایی محروم باشد، هیچ کمبودی در ارزش او به وجود نمی‌آید."],[158,"مپندار اگر سفله قارون شود","که طبع لئیمش دگرگون شود","فکر نکن اگر آدم پست مثل قارون ثروتمند شود، این موضوع باعث تغییر در طبیعت بد و پست او خواهد شد."],[158,"وگر درنیابد کرم‌پیشه، نان","نهادش توانگر بود همچنان","اگر شخص سخاوتمند نتواند نان به دست آورد، باید بداند که ثروت او همچنان به آن شکل باقی خواهد ماند."],[158,"مروت زمین است و سرمایه زرع","بده کاصل خالی نماند ز فرع","مروت (ادب و بزرگواری) مانند زمین است و برای رشد و باروری نیاز به بذری (زرع) دارد؛ بنابراین، باید تلاش کنیم که دل‌خوشی و یاری به یکدیگر را از دست ندهیم تا زندگی‌مان خالی از ثمر نباشد."],[158,"خدایی که از خاک مردم کند","عجب باشد ار مردمی گم کند","خدایی که انسان‌ها را از خاک خلق کرده، شگفت‌انگیز است اگر همان انسان‌ها را از روی زمین محو کند و ناپدید سازد."],[158,"ز نعمت نهادن بلندی مجوی","که ناخوش کند آب استاده بوی","از نعمت و امکانات زیاد به دنبال مقام بلند نباش، چرا که اگر به این فکر باشی، به زودی دچار عذاب و سختی می‌شوی."],[158,"به بخشندگی کوش کآب روان","به سیلش مدد می‌رسد ز آسمان","سعدی در این بیت می‌گوید به سیراب کردن و بخشندگی تلاش کن، زیرا آب روان که از آسمان می‌ریزد و به سیل کمک می‌کند، نشان‌دهنده‌ی این است که بخشش و generosity می‌تواند به رشد و رونق زندگی کمک کند."],[158,"گر از جاه و دولت بیفتد لئیم","دگر باره نادر شود مستقیم","اگر انسان پست‌فطرتی از مقام و ثروت خود بیفتد، بار دیگر نمی‌تواند به راستی و صداقت برگردد و به خوبی رفتار کند."],[158,"وگر قیمتی گوهری غم مدار","که ضایع نگرداندت روزگار","اگر جواهر قیمتی داری، نگران نباش، زیرا زمان نمی‌تواند آن را از بین ببرد."],[158,"کلوخ ار چه افتاده بینی به راه","نبینی که در وی کند کس نگاه","اگرچه ممکن است سنگ‌ریزه‌ها در راه بیفتند و مزاحمت ایجاد کنند، اما نباید به آن‌ها توجه کنی و نگاهمان را از هدف اصلی منحرف کنیم."],[158,"و گر خرده زر ز دندان گاز","بیفتد، به شمعش بجویند باز","اگر ذره‌ای از طلا از دندان بیفتد، با شمع به دنبال آن میگردند."],[158,"به در می‌کنند آبگینه ز سنگ","کجا ماند آیینه در زیر زنگ؟","آبگینه (شیشه) را از سنگ می‌سازند، پس چرا آیینه نتواند زیر زنگ (زنگ‌زده) بماند؟ در اینجا به طرح این سوال توجه شده است که اگر خمیره مادی شیشه قوی است، چرا آیینه (نماد زیبایی و روشنی) نمی‌تواند در برابر آلودگی و زنگار دوام بیاورد؟"],[158,"هنر باید و فضل و دین و کمال","که گاه آید و گه رود جاه و مال","هنر، فضیلت، دین و کمال از اهمیت بالایی برخوردارند، زیرا ثروت و اعتبار ممکن است در یک زمان وجود داشته باشند و در زمان دیگر از بین بروند."],[159,"شنیدم ز پیران شیرین سخن","که بود اندر این شهر پیری کهن","شنیدم از افراد با تجربه و با کلام دل‌نشین که در این شهر، شخصی سالخورده و باتجربه وجود دارد."],[159,"بسی دیده شاهان و دوران و امر","سرآورده عمری ز تاریخ عمرو","بسیاری از شاهان و دوران‌ها را دیده‌ام و عمرم را به تاریخ عمرها گذرانده و به دست آورده‌ام."],[159,"درخت کهن میوه‌ای تازه داشت","که شهر از نکویی پرآوازه داشت","درختی قدیمی میوه‌ای نو و تازه تولید کرد که شهر به خاطر زیبایی و خوبی‌اش شهرت زیادی داشت."],[159,"عجب در زنخدان آن دل فریب","که هرگز نبوده‌ست بر سرو سیب","در زنخدان (چانه) آن زن دل‌ربا چیز شگفت‌انگیزی است که هرگز بر درخت سیب (نماد زیبایی) نیست و نشان‌دهنده‌ی زیبایی خاص و منحصر به فرد اوست."],[159,"ز شوخی و مردم خراشیدنش","فرج دید در سر تراشیدنش","به دلیل شوخی و آزار مردم، او خاطرات تلخی را در سر دارد و این مسئله باعث گردیده تا در سرش مشکلاتی به وجود آید."],[159,"به موسی، کهن عمر کوته امید","سرش کرد چون دست موسی سپید","سعدی در این بیت به اشاره به موسی، نبی بزرگ، می‌گوید که با عمر طولانی‌اش، از دنیا امیدی ندارد و مانند دست‌های سفید او، که نشانه پیری است، به زودی به پایان عمر خود نزدیک خواهد شد."],[159,"ز سر تیزی آن آهنین دل که بود","به عیب پری‌رخ زبان برگشود","دل آهنین و بی‌رحم او که از شدت سختی و بی‌احساسی، دیگران را آزار می‌داد، حالا از زیبایی چهره معشوق سخن می‌گوید و زبانش به عیوب او اعتراف می‌کند."],[159,"به مویی که کرد از نکوییش کم","نهادند حالی سرش در شکم","به خاطر زیبایی و خوبی که این دختر دارد، دیگران او را به اندازه یک مو از نیکویی‌اش کم کردند و اکنون نقصی در وجود او به چشم می‌آید که در درون خود احساس می‌کند."],[159,"چو چنگ از خجالت سر خوبروی","نگونسار و در پیشش افتاده موی","چنان‌که چنگ (ساز موسیقی) به خاطر شرم، سرش را پایین می‌اندازد، دلبر زیبا هم به خاطر شرم، سرش را پایین انداخته و موهایش در پیش او افتاده است."],[159,"یکی را که خاطر در او رفته بود","چو چشمان دلبندش آشفته بود","کسی که به عشق کسی دچار شده بود، مانند چشمان معشوقش درهم ریخته و پریشان بود."],[159,"کسی گفت جور آزمودی و درد","دگر گرد سودای باطل مگرد","کسی گفت تو تجربه سختی و غم را داشتی، بنابراین به دنبال آرزوهای بی‌پایه و بی‌فایده نرو."],[159,"ز مهرش بگردان چو پروانه پشت","که مقراض، شمع جمالش بکشت","اگر از محبت او دور شوی، مانند پروانه‌ای خواهی بود که به شمع نزدیک شده و پشتش سوخته، زیرا قیچی (مقراض) زیبایی و جذابیت او را از بین می‌برد."],[159,"برآمد خروش از هوادار چست","که تردامنان را بود عهد سست","آوای بلندی از طرف حامی چالاک بلند شد، زیرا افراد بی‌ثبات و بی‌وفا به عهد و پیمان خود پایبند نیستند."],[159,"پسر خوش منش باید و خوبروی","پدر گو به جهلش بینداز موی","پسر باید نیک‌اخلاق و زیباچهره باشد، اما اگر پدر به او نادانی بیاموزد، چهره‌اش هم در نظر دیگران ناپسند خواهد شد."],[159,"مرا جان به مهرش برآمیخته‌ست","نه خاطر به مویی در آویخته‌ست","محبت و عشق من به او با جانم آمیخته شده و فقط به یک مو و ظاهر او وابسته نیست."],[159,"چو روی نکو داری انده مخور","که موی ار بیفتد بروید دگر","تا زمانی که چهره‌ی زیبایی داری، غم مخور که اگر موی سرت بریزد، دوباره درخواهد آمد."],[159,"نه پیوسته رز خوشه تر دهد","گهی برگ ریزد، گهی بر دهد","زندگی همیشه به یک شکل نیست و خوشی‌ها و ناخوشی‌ها به تناوب رخ می‌دهند؛ گاهی روزهای خوب و پرباری داریم که مثل خوشه تر می‌رسند و گاهی هم روزهای سختی که مانند برگ‌های درخت می‌ریزند."],[159,"بزرگان چو خور در حجاب اوفتند","حسودان چو اخگر در آب اوفتند","بزرگان، مانند خورشید، در پوششی پنهان می‌شوند و حسودان، مانند آتشی که به زیر آب می‌افتد، خاموش می‌شوند."],[159,"برون آید از زیر ابر آفتاب","به تدریج و اخگر بمیرد در آب","خورشید بعد از باران و ابر به آرامی نمایان می‌شود و بخار آتش در آب کم‌کم خاموش می‌شود."],[159,"ز ظلمت مترس ای پسندیده دوست","که ممکن بود کاب حیوان در اوست","ای دوست خوبم، از تاریکی نترس، چرا که ممکن است در این تاریکی، سوسوی روشنی وجود داشته باشد."],[159,"نه گیتی پس از جنبش آرام یافت؟","نه سعدی سفر کرد تا کام یافت؟","آیا دنیا پس از هر حرکتی آرام نمی‌گیرد؟ آیا سعدی سفر نکرد تا به خواسته‌اش برسد؟"],[159,"دل از بی مرادی به فکرت مسوز","شب آبستن است ای برادر به روز","دل را به خاطر بی‌مویدی و ناامیدی نسوزان، زیرا شب، در انتظار روزی بهتر است."],[160,"سخن در صلاح است و تدبیر و خوی","نه در اسب و میدان و چوگان و گوی","مهم‌ترین مسئله در زندگی، اصلاح شخصیت و تدبیر درست است، نه صرفا مهارت در بازی‌ها و سرگرمی‌هایی مانند سوارکاری، مسابقه و ورزش."],[160,"تو با دشمن نفس هم‌خانه‌ای","چه در بند پیکار بیگانه‌ای؟","تو با نفس خود، که بزرگ‌ترین مخالف و دشمن توست، زندگی می‌کنی، پس چرا به فکر جنگ و نبرد با دشمنان بیرونی هستی؟"],[160,"عنان‌باز‌پیچان نفس از حرام","به مردی ز رستم گذشتند و سام","عسر و زحمت نفس را از گناه رها کن، تا به مقام مردی و شجاعت رستم و سام (دو پهلوان نامی ایرانی) برسی."],[160,"تو خود را چو کودک ادب کن به چوب","به گرز گران مغز مردم مکوب","خودت را مانند یک کودک تربیت کن و با سختی‌ها و مشکلات زندگی برخورد کن، اما اجازه نده که بر سر دیگران بکوبی و به آنها آسیب برسانی."],[160,"وجود تو شهری است پر نیک و بد","تو سلطان و دستور دانا خرد","وجود تو مانند شهری است که پر از خوبی‌ها و بدی‌هاست، و تو فرمانروای آن شهر هستی که باید با خرد و دانایی خود بر آن حکومت کنی."],[160,"رضا و ورع: نیکنامان حر","هوی و هوس: رهزن و کیسه‌بر","نیک‌نامان در جستجوی رضایت و پرهیز از گناه هستند، در حالی که کسانی که هوس و تمایلات نفس را دنبال می‌کنند، وجودشان مملو از فریب و دزدی روحی است."],[160,"چو سلطان عنایت کند با بدان","کجا ماند آسایش بخردان؟","وقتی که سلطان (خدا) لطف و کرم خود را بر بدکاران نازل کند، دیگر چگونه ممکن است آسایش و آرامش برای فرزانه‌ها و خردمندان باقی بماند؟"],[160,"تو را شهوت و حرص و کین و حسد","چو خون در رگانند و جان در جسد","شهوت، حرص، کینه و حسد در وجود تو مانند خون در رگ‌ها و جان در بدن وجود دارند و به شدت در تو جاری هستند."],[160,"هوی و هوس را نماند ستیز","چو بینند سر پنجه عقل تیز","هوس و خواسته‌های نفسانی وقتی با قدرت عقل روبرو شوند، دیگر مقاومتی نمی‌توانند داشته باشند."],[160,"رئیسی که دشمن سیاست نکرد","هم از دست دشمن ریاست نکرد","رئیس یا فرمانده‌ای که با دشمن زیرکی و سیاست نداشت، در نتیجه نتوانست که از دست دشمن خود هم ریاست و رهبری‌اش را حفظ کند."],[160,"نخواهم در این نوع گفتن بسی","که حرفی بس ار کار بندد کسی","نمی‌خواهم در این نوع سخن بیش از حد صحبت کنم، چون ممکن است کسی حرفی بزند که برای کارش مفید باشد."],[161,"اگر پای در دامن آری چو کوه","سرت ز آسمان بگذرد در شکوه","اگر مثل کوه گوشه گیری کنی و یک جا ثابت و ساکت بنشینی در شکوه و سربلندی به بالاترین مقام دست پیدا میکنی. (پای در دامن آوردن کنایه از گوشه گیری و سکوت است.)"],[161,"زبان درکش ای مرد بسیار‌دان","که فردا قلم نیست بر بی‌زبان","زبان درکشيدن: کنايه از خاموش شدن، سکوت کردن / فردا: روز قيامت / بی زبان: شخص ساکت و کم سخن (اينجا) لال / نبودن قلم بر کسی: کنايه از مورد بازخواست قرار نگرفتن کسی. معنی: ای انسان آگاه سکوت اختيار کن زيرا که در روز قيامت، بی زبان از نظر گفتار بازخواست و مواخذه نخواهد شد."],[161,"صدف‌وار گوهرشناسان راز","دهان جز به لؤلؤ نکردند باز","انسان های آگاه فقط موقع گفتن سخنان با ارزش دهان باز می کنند همان طور که صدف فقط موقع بيرون آوردن مرواريد دهان باز می کند."],[161,"فراوان‌سخن باشد آکنده‌گوش","نصیحت نگیرد مگر در خموش","شخص پر حرف، گوشش سنگين و ناشنوا است و فرصت شنيدن سخنان ديگران را ندارد و نصيحت فقط در انسان خاموش و ساکت تأثير دارد. آکنده گوش: ناشنوا"],[161,"چو خواهی که گویی نفس بر نفس","حلاوت نیابی ز گفتار کس","اگر بخواهی پيوسته و دم به دم سخن بگويی و پرحرفی کنی، بی شک نصيحت و شیرینی سخن ديگری را نخواهی شنيد."],[161,"نباید سخن گفت ناساخته","نشاید بریدن نینداخته","نبايد نسنجيده و بدون فکر سخن گفت. همان طور که بدون اندازه گرفتن، بريدن پارچه شايسته نيست."],[161,"تأمّل‌کنان در خطا و صواب","به از ژاژخایان حاضر‌جواب","خاييدن: جويدن/ ژاژ : گياهی بی مزه و خاردار که شتر آن را از زمين می کند و می جود و نمی تواند آن را نرم کند. / ژاژ خاييدن: کنايه از بيهوده سخن گفتن / معنی: کسانی که در خوب و بد و يا درست و نادرست بودن سخن خود درنگ و انديشه می کنند بهتر از ياوه گويان حاضر جواب هستند."],[161,"کمال است در نفس انسان سخن","تو خود را به گفتار ناقص مکن","اگر چه سخن گفتن نشانه ی کمال انسان است. پس تو خود را با پر حرفی و سخن نسنجيده، بی ارزش و خوار مکن. / گفتار: در اينجا منظور پرحرفی و سخن نسنجيده است."],[161,"کم‌آواز هرگز نبینی خجل","جوی مشک بهتر که یک توده گل","هرگز شخص کم حرف و سنجيده گوی را خجل نمی بينی همان طور که يک ذره مشک معطر بهتر از يک توده گل بی ارزش است."],[161,"حذر کن ز نادان ده‌مرده‌گوی","چو دانا یکی گوی و پرورده گوی","از افراد نادان پر حرف که به اندازه ی ده تن حرف می زنند دوری کن، مثل افراد دانا کم گوی و گزيده گوی."],[161,"صد انداختی تیر و هر صد خطاست","اگر هوشمندی یک انداز و راست","بسيار حرف زدی و پرگويی کردی و تمام آن ها خطا و اشتباه بود. اگر انسان دانایی هستی، کلامت را کوتاه ولی درست بيان کن."],[161,"چرا گوید آن چیز در خفیه مرد","که گر فاش گردد شود روی‌زرد؟","چرا انسان در نهان حرفی را به زبان بیاورد که اگر آشکار شود باعث شرمندگی و سرافکندگی او شود؟"],[161,"مکن پیش دیوار غیبت بسی","بود کز پسش گوش دارد کسی","حتی در کنار ديوار هم از کسی غيبت و بدگويی نکن، زیرا ممکن است که کسی پشت ديوار، مخفیانه به سخنان شما گوش دهد."],[161,"درون دلت شهربند است راز","نگر تا نبیند در شهر باز","سرّ و راز در درون تو زندانی است، مواظب باش تا با حرف زدن بی جا راز دلت آشکار نشود."],[161,"از آن مرد دانا دهان‌دوخته‌است","که بیند که شمع از زبان سوخته‌است","انسان دانا به این علت سکوت کرده است که می بيند شمع به خاطر زبانه های آتش خود دارد میسوزد."],[162,"تکش با غلامان یکی راز گفت","که این را نباید به کس باز‌گفت","سلطان تکش با خدام خود رازی را در میان گذاشت و گفت که این راز نباید به هیچ کسی گفته شود."],[162,"به یک سالش آمد ز دل بر دهان","به یک روز شد منتشر در جهان","سخنی که سلطان تکش در دل داشت، پس از یک سال به زبانش آمد و یک روز تمام آن راز در دنیا منتشر شد."],[162,"بفرمود جلّاد را بی‌دریغ","که بردار سرهای اینان به تیغ","پادشاه به جلاد به‌طور بی‌درنگ دستور داد که سر این افراد را با شمشیر جدا کند."],[162,"یکی زآن میان گفت و زنهار خواست","مکش بندگان کاین گناه از تو خاست","یکی از آن میان (از میان افرادی که در خطر جان بودند) گفت و درخواست کرد که \"زنهار\" (به معنی درخواست امان) ندهید، این بندگان را نکشید؛ چون این گناه از تو (سلطان) ناشی شده است."],[162,"تو اوّل نبستی که سرچشمه بود","چو سیلاب شد پیش بستن چه سود؟","تو نخستین کسی نیستی که سرچشمه‌ای را مسدود کردی؛ وقتی که سیلاب جاری شد، بستن آن چه فایده‌ای دارد؟"],[162,"تو پیدا مکن راز دل بر کسی","که او خود نگوید بر هر کسی","راز دل را برای کسی فاش نکن که خودش هم آن را برای هر کسی بازگو نخواهد کرد."],[162,"جواهر به گنجینه‌داران سپار","ولی راز را خویشتن پاس دار","جواهرات را به کسانی بسپار که توانایی نگهداری از گنجینة آن را دارند، اما رازهای خود را خودت حفظ کن و به هیچ‌کس نگو."],[162,"سخن تا نگویی بر او دست هست","چو گفته شود یابد او بر تو دست","سخن وقتی که کفتن نشده، هنوز در کنترل توست، اما وقتی آن را بگویی، دیگر آن سخن از دست تو خارج می‌شود و ممکن است بر تو تأثیر بگذارد."],[162,"سخن دیو بندی است در چاه دل","به بالای کام و زبانش مهل","سخن مانند دیوی است که در دل زندانی شده و در آن چاه پنهان است، اما وقتی به زبان می‌آید، به راحتی بر زبان می‌چرخد."],[162,"توان باز‌دادن ره نرّه‌دیو","ولی باز نتوان گرفتن به ریو","می‌توان راه دیو نرّه را باز کرد، اما هرگز نمی‌توان او را به قفس برگرداند."],[162,"تو دانی که چون دیو رفت از قفس","نیاید به لا‌حول کس باز پس","تو می‌دانی که وقتی دیو از قفس بیرون می‌آید، دیگر به حالت قبلی خود و به هیچ‌کس برنمی‌گردد."],[162,"یکی طفل بر‌گیرد از رخش بند","نیاید به صد رستم اندر کمند","یک کودک می‌تواند به راحتی بر پشت یک اسب شجاع سوار شود و او را کنترل کند، در حالی که رستم، پهلوان بزرگ ایرانی، قادر نیست او را در دام بیاندازد."],[162,"مگوی آن که گر بر ملا اوفتد","وجودی از آن در بلا اوفتد","نمی‌گو که اگر کسی بر منبر بیفتد، وجودش به خاطر آن در خطر خواهد افتاد."],[162,"به دهقان نادان چه خوش گفت زن:","به دانش سخن گوی یا دم مزن","زن به دهقان نادان می‌گوید: یا به علم و دانش سخن بگو، یا اصلا حرف نزن."],[162,"مگوی آنچه طاقت نداری شنود","که جو‌کشته گندم نخواهی درود","سخنی را نگو که توان شنیدن آن را نداری، زیرا نتیجه‌اش همانند نابودی محصول گندم است که خودت آن را کاشته‌ای."],[162,"چه نیکو زده‌ست این مثل برهمن","بود حرمت هر کس از خویشتن","این مثل به خوبی بیان می‌کند که برهمن (روحانی هندو) می‌گوید احترام و حرمت هر فرد باید از خود او آغاز شود و افراد باید به خود احترام بگذارند تا دیگران نیز به آنها احترام بگذارند."],[162,"چو دشنام گویی دعا نشنوی","به جز کشته خویشتن ندروی","اگر به کسی دشنام بدهی، دعای تو مستجاب نخواهد شد و جز خودت به چیزی نمی‌توانی آسیب برسانی."],[162,"مگوی و منه تا توانی قدم","از اندازه بیرون وز اندازه کم","اگر می‌خواهی سخن نگو و خود را در موقعیت‌های نادرست قرار نده، زیرا باید به اندازه و حدود خود عمل کنی و از آن فراتر نروی."],[162,"نباید که بسیار بازی کنی","که مر قیمت خویش را بشکنی","نباید خیلی به بازی و بی‌مبالاتی بپردازی چون ممکن است ارزش و جایگاه خود را از دست بدهی."],[162,"وگر تند باشی به‌یک‌بار و تیز","جهان از تو گیرند راه گریز","اگر خیلی شتاب‌زده و تند عمل کنی، جهان برای تو فرصتی برای فرار و رهایی نمی‌گذارد."],[162,"نه کوتاه‌دستی و بیچارگی","نه زجر و تطاول به‌یک‌بارگی","این بیت بیان می‌کند که نه باید به دلیل ناتوانی و ضعف به یک باره و بدون تدبیر اقدامی کرد، و نه باید به طور ناگهانی و با شدت به دشواری‌های زندگی حمله کرد."],[163,"یکی خوب‌خلق خلق‌پوش بود","که در مصر یک‌چند خاموش بود","مردی با خلق و خوی نیکو و ظاهر زیبا در مصر مدتی ساکت و بی‌صدا بود."],[163,"خردمندمردم ز نزدیک و دور","به گردش چو پروانه جویان نور","خردمند، مردم را از نزدیک و دور به گرد خود می‌بیند، درست مانند پروانه‌هایی که برای جستجوی نور به دور یک شمع جمع می‌شوند."],[163,"تفکّر شبی با دل خویش کرد","که پوشیده زیر زبان است مرد","شبی با دل خود فکر کردم که آدمی، با وجود ظاهری که دارد، حقیقتش در درون و در زبانش نهفته است."],[163,"اگر همچنین سر به خود در‌برم","چه دانند مردم که دانشورم؟","اگر من هم مانند او (مرد جاهل) به خودم مشغول شوم، مردم چه می‌دانند که من آدم باهوش و دانایی هستم؟"],[163,"سخن گفت و دشمن بدانست و دوست","که در مصر، نادان‌تر از وی هم‌اوست","سخن گفتن او باعث شد که دشمن و دوست هر دو متوجه شوند که در مصر، آدم نادان‌تری از او هم وجود دارد."],[163,"حضورش پریشان شد و کار، زشت","سفر کرد و بر طاق مسجد نبشت","حضور او (شخصی مهم) به هم ریخت و کارش بد شد، به طوری که در بالای دیوار مسجد نوشت (چیزی که ناپسند و زشت بود)."],[163,"در آیینه گر خویشتن دیدمی","به بی‌دانشی پرده ندریدمی","اگر در آینه خودم را می‌دیدم، به خاطر نادانی‌ام پرده از خود برنمی‌داشتم."],[163,"چنین زشت از آن پرده برداشتم","که خود را نکو‌روی پنداشتم","من به خاطر خودپسندی و نادانی، چهره‌ای زشت از خودم نشان دادم و پرده‌ای را از روی حقیقت برداشتم."],[163,"کم‌آواز را باشد آوازه تیز","چو گفتی و رونق نماندت گریز","انسانی که کم‌حرف است، صدایش تیز و رساتر می‌شود، زیرا وقتی می‌گویی و شوق و شایستگی‌ات کم است، از تو دوری می‌کنند."],[163,"تو را خامشی ای خداوند هوش","وقار است و نا‌اهل را پرده‌پوش","ای کسی که دارای هوش و دانش هستی، خاموشی برای تو نیکوست، زیرا فرد بی‌دانش را باید پوشانید و از اشتباهاتش محافظت کرد."],[163,"اگر عالمی هیبت خود مبر","وگر جاهلی پرده خود مدر","اگر عالم بدون خودنمایی و با وقار باشد، نباید جلال و هیبت خود را از دست دهد و اگر جاهلی است، نباید خود را در پرده پنهان کند."],[163,"ضمیر دل خویش منمای زود","که هر‌ گه که خواهی توانی نمود","زود درباره دل و احساسات خود صحبت نکن و آن‌ها را به دیگران نشان نده، چون ممکن است در هر زمان که بخواهی، بتوانی آن‌ها را تغییر دهی یا از نو بسازی."],[163,"ولیکن چو پیدا شود راز مرد","به کوشش نشاید نهان باز کرد","اما وقتی راز یک مرد فاش شود، دیگر نمی‌توان با تلاش آن را پنهان کرد."],[163,"قلم سرّ سلطان چه نیکو نهفت","که تا کارد بر سر نبودش نگفت","قلم که راز و اسرار سلطان را به خوبی مخفی کرده، تا زمانی که در خطر و تهدیدی نیست، به هیچ‌کس چیزی نمی‌گوید."],[163,"بهایم خموشند و گویا بشر","زبان‌بسته بهتر که گویا به شر","حیوانات بی‌صدا و خاموش‌اند، اما انسان اگر زبان بگشاید و درست سخن نگوید، بهتر است که مانند آن‌ها ساکت بماند تا موجب شر و فتنه نشود."],[163,"چو مردم سخن گفت باید به هوش","و‌گر‌‌نه شدن چون بهایم خموش","انسان باید در گفتار خود هوشیار باشد وگرنه مانند چهار پایان خاموش و بی‌صدا خواهد شد."],[163,"به نطق است و عقل آدمی‌زاده فاش","چو طوطی سخنگوی نادان مباش","انسان باید با کلامش و عقلش به درستی سخن بگوید و مثل طوطی نادان فقط صحبت نکند و بی‌فکر سخن پراکنی نکند."],[163,"به نطق آدمی بهتر است از دواب","دواب از تو به گر نگویی صواب","سخن گفتن و نطق انسان از رفتار و کردار حیوانات بهتر است، زیرا اگر تو هم نتوانی سخنی درست بگویی، بهتر است سکوت کنی."],[164,"یکی ناسزا گفت در وقت جنگ","گریبان دریدند وی را به چنگ","در زمان جنگ، کسی به او (که در اینجا به نظر می‌رسد به یک فرد خاص اشاره دارد) فحش داد و او به خاطر این توهین، او را گرفت و به ستیز با او پرداخت."],[164,"قفا‌خورده عریان و گریان نشست","جهاندیده‌ای گفتش، ای خودپرست","مردی که در حال گریه و عریانی نشسته است، فردی با تجربه و دانا به او می‌گوید: ای که به خود می‌بالید و مغرور هستی، چرا این‌گونه شده‌ای؟"],[164,"چو غنچه گرت بسته بودی دهن","دریده ندیدی چو گل، پیرهن","اگر مانند غنچه، دهن‌گرفته و بسته بوده‌ای و از خودت دفاع کرده‌ای، نباید مانند یک گل، لباس زیبا و باز را ندیده‌ باشی. این بیت می‌گوید باید خود را نشان دهی و از زیبایی‌هایت بهره ببری."],[164,"سراسیمه گوید سخن، بر گزاف","چو طنبور بی‌مغز بسیار‌لاف","سخن را به طور شتاب‌زده و بی‌فکر بیان می‌کند، مانند طنبوری که بی‌مغز است و فقط لاف و گزاف می‌زند."],[164,"نبینی که، آتش زبان است ، و بس","به آبی، توان کشتنش، در نفس؟","زبان مانند آتش است که می‌تواند به سرعت انتشار یابد و باعث ایجاد مشکل شود، و تنها با سکوت و آرامش (آب) می‌توان آن را خاموش کرد."],[164,"اگر هست مرد از هنر بهره‌ور","هنر، خود بگوید، نه صاحب‌هنر","اگر کسی در هنر مهارت دارد، خودش به توانایی‌اش اشاره می‌کند و نیازی به معرفی شدن از سوی دیگران ندارد."],[164,"اگر مشک خالص نداری، مگوی","ورت هست، خود فاش گردد، به بوی","اگر مشک خوشبو و خالصی نداری، نیازی نیست بگویی که چنین چیزی داری؛ عطر و بوی خوش خودش به وضوح نشان می‌دهد که چه چیزی در دست داری."],[164,"به سوگند گفتن، که زر، مغربی است","چه حاجت؟ محک، خود بگوید که چیست","اگر کسی قسم بخورد که طلا از مغرب آمده، نیازی به این قسم نیست، چون خود طلا با کیفیت و خواصش مشخص می‌شود."],[164,"بگویند از این حرف‌گیران هزار","که سعدی، نه اهل است و آمیزگار","می‌گویند که هزاران نفر از این کسانی که به حرف و جدل عادت دارند، بر این باورند که سعدی نه از اهل علم و فضل است و نه توانایی و دانش کافی برای آمیختن با دیگران را دارد."],[164,"روا باشد ار پوستینم درند","که طاقت ندارم که، مغزم برند","اجازه داده شده که آن‌ها پوستین مرا بکنند، زیرا من طاقت این را ندارم که بیشتر از این در فشار باشم و مغزم در حال فشردگی و آزردگی است."],[165,"عضد را پسر سخت رنجور بود","شکیب از نهاد پدر دور بود","فرزند عضد به شدت بیمار بود و حالتی صبورانه از خود نشان نمی‌داد، چون به دور از محبت و حمایت پدرش بود."],[165,"یکی پارسا گفتش از روی پند","که بگذار مرغان وحشی ز بند","یک پارسا به عضد نصیحت کرد که باید اجازه دهد پرندگان وحشی را از قفس آزاد کند."],[165,"قفس‌های مرغ سحر‌خوان شکست","که در بند ماند چو زندان شکست؟","قفس‌های پرندگان خوش‌خوان (مرغ سحرخوان) شکسته شد و آیا وقتی که زندان از هم می‌پاشد، آنها دیگر در بند خواهند ماند؟"],[165,"نگه داشت بر طاق بستان سرای","یکی نامور بلبل خوش‌سرای","یکی بلبل معروف و خوش‌آواز بر بالای باغ خانه‌ای نشسته و حضور او را در آنجا مشاهده می‌کنیم."],[165,"پسر صبحدم سوی بستان شتافت","جز آن مرغ بر طاق ایوان نیافت","صبح زود، یکی از پسرها به سمت بستان رفت، اما جز آن بلبل خوش آواز که بر طاق ایوان نشسته بود، چیزی پیدا نکرد."],[165,"بخندید کای بلبل خوش‌نفس","تو از گفت خود مانده‌ای در قفس","بلبل خوش‌صدا که به زیبایی صحبت می‌کند، از شنیدن سخنان خودش در قفس خوشحال و شاداب است."],[165,"ندارد کسی با تو ناگفته کار","ولیکن چو گفتی دلیلش بیار","هیچ‌کس با تو کاری دارد که نگفته باشد، اما وقتی حرفی زدی، دلیل و مدرکش را هم ارائه بده."],[165,"چو سعدی که چندی زبان بسته‌بود","ز طعن زبان‌آوران رسته بود","سعدی که مدت‌ها خاموش بوده و حرفی نمی‌زده، از انتقادها و تیرهای زبانی که به او شده بود، رهایی یافته است."],[165,"کسی گیرد آرام دل در کنار","که از صحبت خلق گیرد کنار","انسانی می‌تواند آرامش دل خود را در کنار کسی پیدا کند که از هم‌نشینی با مردم دوری می‌کند و در تنهایی خود آسایش می‌یابد."],[165,"مکن عیب خلق، ای خردمند، فاش","به عیب خود از خلق مشغول باش","ای خردمند، عیب دیگران را آشکار نکن؛ به جای آن، به عیب خود مشغول باش و بر آن کار کن."],[165,"چو باطل سرایند مگمار گوش","چو بی‌ستر بینی بصیرت بپوش","وقتی که باطل یا حرف‌های نادرست گفته می‌شود، خود را در معرض شنیدن آن‌ها قرار نده و همچون کسی که چشمانش را بسته است، از دیدن حقیقت دوری کن."],[166,"شنیدم که در بزم ترکان مست","مریدی دف و چنگ مطرب شکست","شنیدم که در جشن و میخانه‌ای که ترکان (ترکان در اینجا به جمعی از مردم اشاره دارد) در حال مستی هستند، مریدی، ساز دف و چنگ نوازندگان را شکست."],[166,"چو چنگش کشیدند حالی به موی","غلامان و چون دف زدندش به روی","همچون ساز چنگ که مو‌ها و تارهایش را می‌کشند و می‌نوازند، غلامان موی او را گرفتند و (بر زمینش) کشیدند و همچون دف روی او را نواختند و زدند."],[166,"شب از درد چوگان و سیلی نخفت","دگر روز پیرش به تعلیم گفت","شب به خاطر درد ناشی از چوگان (بازی که در آن از چوب به نام چوگان استفاده می‌شود) و سیلی (ضربه‌ای که به خاطر آن نمی‌توان خوابید) نتوانست بخوابد. در روز، پیر (معلم یا بزرگتر) به او آموزشی می‌دهد."],[166,"نخواهی که باشی چو دف روی ریش","چو چنگ، ای برادر، سر انداز پیش","اگر نمی‌خواهی مانند دفی باشی که رویش را به خاک می‌زند، ای برادر، سر را پایین نیاور و تسلیم نشو."],[167,"دو کس گرد دیدند و آشوب و جنگ","پراکنده نعلین و پرنده سنگ","دو کس (به‌جایی رسیدند‌) و دیدند که گرد و غبار جنگ برخاسته و کفش‌ها به کناری انداخته شده بود و سنگ از هر سو پرّان."],[167,"یکی فتنه دید از طرف بر شکست","یکی در میان آمد و سر شکست","یکی از آن‌دو شخص فتنه دید و به‌کنار ایستاد اما دیگری به میانجی‌گری به‌میان جنگ رفت و سرش شکست."],[167,"کسی خوشتر از خویشتن دار نیست","که با خوب و زشت کسش کار نیست","کسی خوش‌تر و خوشحال‌تر از آدم خویشتن‌دار نیست‌؛ آنکه با خوب و زشت دیگران کاری ندارد."],[167,"تو را دیده در سر نهادند و گوش","دهان جای گفتار و دل جای هوش","تو را (انسان) به گونه‌ای آفریدند که چشم‌ها برای دیدن و گوش‌ها برای شنیدن و دل هم برای فهم و اندیشیدن قرار داده شده‌اند."],[167,"مگر باز دانی نشیب از فراز","نگویی که این کوته است، آن دراز","تا شاید بلندی و پستی را ببینی و بشناسی اما یکی را کوتاه و دیگری را دراز نخوانی."],[168,"چنین گفت پیری پسندیده هوش","خوش آید سخنهای پیران به گوش","پیری با فهم و دانا با دقت بیان می‌کند که سخنان پیران برای شنیدن، لذت‌بخش و پندآموز است."],[168,"که در هند رفتم به کنجی فراز","چه دیدم؟ چو یلدا سیاهی دراز","در سفر به هند، به گوشه‌ای بلند رفتم و آنجا چیزی مشاهده کردم که مانند یلدا، تاریکی طولانی و غلیظ بود."],[168,"تو گفتی که عفریت بلقیس بود","به زشتی نمودار ابلیس بود","تو گفتی که عفریت بلقیس به زشت‌رویی شبیه ابلیس است."],[168,"در آغوش وی دختری چون قمر","فرو برده دندان به لبهاش در","دختری زیبا و دلربا مثل ماه در آغوش آن مرد قرار دارد و او به لب‌های او دندان زده است."],[168,"چنان تنگش آورده اندر کنار","که پنداری اللیل یغشی النهار","او به قدری دختر را در آغوش گرفته که گویی شب به قدری نزدیک است که روز را پوشانده است."],[168,"مرا امر معروف دامن گرفت","فضول آتشی گشت و در من گرفت","من را برای کارهای خوب و نیکو دعوت کردند، اما سخن‌پراکنی بیهوده مثل آتش به جانم افتاد و مرا در خود گرفتار کرد."],[168,"طلب کردم از پیش و پس چوب و سنگ","که ای نا خدا ترس بی نام و ننگ","من از کسانی که به من آزار می‌زدند، چوب و سنگ خواسته‌ام تا به آن‌ها ضربه بزنم. این جمله به نوعی بیانگر احساس ناتوانی و ناامیدی من است از اینکه به آن‌ها دسترسی ندارم، و همچنین نشان می‌دهد که من از ترس عواقب بد، نمی‌خواهم در این کار نام و ننگی برای خود ایجاد کنم."],[168,"به تشنیع و دشنام و آشوب و زجر","سپید از سیه فرق کردم چو فجر","از دشنام و سر و صدا و زجر، به آرامش و روشنایی رسیدم، مانند سپیده دم که تاریکی را کنار می‌زند."],[168,"شد آن ابر ناخوش ز بالای باغ","پدید آمد آن بیضه از زیر زاغ","ابر سیاه و نامساعدی از بالای باغ ظاهر شد و باعث شد که تخم‌مرغی از زیر پر زاغ بیرون بیفتد."],[168,"ز لا حولم آن دیو هیکل بجست","پری پیکر اندر من آویخت دست","دیو هیکلی که به نشانه ناتوانی من (ز لا حول) به سمتم آمد، یک پری با قد و قامت زیبا را در دستانش گرفت و به من نزدیک شد."],[168,"که ای زرق سجاده دلق پوش","سیه‌کار دنیاخر دین‌فروش","ای کسی که به طرز خاصی از دین بهره‌برداری می‌کنی و با پوشیدن لباس‌های مذهبی و تظاهر به دینداری، در واقع شیفته دنیایی و دنیا را به‌دست می‌آوری."],[168,"مرا عمرها دل ز کف رفته بود","بر این شخص و جان بر وی آشفته بود","من سال‌هاست که برای این شخص دل‌باخته و زندگی‌ام تحت تأثیر او بوده و جانم به خاطر او نگران بوده است."],[168,"کنون پخته شد لقمه خام من","که گرمش به در کردی از کام من","اکنون لقمه‌ای که خام و ناپخته بود، پخته شده و آماده شده است، تو که آن را از دهان و کام من خارج کردی."],[168,"تظلم برآورد و فریاد خواند","که شفقت بر افتاد و رحمت نماند","او فریاد زد و از ظلمی که به او رفته شکایت کرد و گفت که دیگر کسی نیست که به او رحم کند و محبتش را نشان دهد."],[168,"نماند از جوانان کسی دستگیر","که بستاندم داد از این مرد پیر؟","هیچ‌یک از جوانان به کمک من نیامدند تا از این مرد پیر درخواستی را که داشتم، بستانند یا حمایت کنند."],[168,"که شرمش نیاید ز پیری همی","زدن دست در ستر نامحرمی","او از پیری خود شرم نمی‌کند و با بی‌شرمی دست به سوی نامحرم دراز می‌کند."],[168,"همی کرد فریاد و دامن به چنگ","مرا مانده سر در گریبان ز ننگ","او در حال فریاد زدن است و دامن من را به دست گرفته؛ من به خاطر شرم و ننگم، سرم را در گریبانم پنهان کرده‌ام."],[168,"فرو گفت عقلم به گوش ضمیر","که از جامه بیرون روم همچو سیر","عقل مرا به آرامی و در دل به من گفت که از پوشش خود بیرون بیایم و مانند سیر، که در آستانه‌ی پخته شدن به شکل ساده‌اش نمایان می‌شود، بی‌پرده و بی‌پوشش باشم."],[168,"نه خصمی که با او برآیی به داو","بگرداندت گرد گیتی به گاو","اگر با کسی در دعوا و خصومت بیفتی، دنیا (گیتی) تو را به حالت اسفناک و بی‌حالی درمی‌آورد، مثل گاوی که در گرد و غبار است."],[168,"برهنه دوان رفتم از پیش زن","که در دست او جامه بهتر که من","به دلیل نزاعی که با زنی داشتم، از پیش او به سرعت بیرون دویدم، زیرا در دستان او لباس بهتری نسبت به لباس خودم بود."],[168,"پس از مدتی کرد بر من گذار","که می‌دانیم؟ گفتمش زینهار!","مدتی بعد او دوباره به من سر زد و چون از من پرسید چه خبر است، من به او گفتم مراقب باش!"],[168,"که من توبه کردم به دست تو بر","که گرد فضولی نگردم دگر","من از تو پشیمان شدم و به خاطر تو عهد کردم که دیگر فضولی نکنم و در کار دیگران دخالت نکنم."],[168,"کسی را نیاید چنین کار پیش","که عاقل نشیند پس کار خویش","انسان عاقل نباید در کارهای خود ساکت بماند و بی‌توجهی کند، بلکه باید در مورد کارهایش اندیشیده و آگاهانه عمل کند."],[168,"از آن شنعت این پند برداشتم","دگر دیده نادیده انگاشتم","از آنچه که شنیدم، این نکته را گرفتم که دیگر به آنچه ندیده‌ام، توجه نکنم و به آن اهمیت ندهم."],[168,"زبان در کش ار عقل داری و هوش","چو سعدی سخن گوی ور نه خموش","اگر عقل و هوش داری، زبان خود را به کار بند و مانند سعدی صحبت کن، وگرنه بهتر است سکوت کنی."],[169,"یکی پیش داود طائی نشست","که دیدم فلان صوفی افتاده مست","مردی به حضور داود طائی آمد و گفت که فلان صوفی را در حال مستی و بی‌خودی دیده است."],[169,"قی آلوده دستار و پیراهنش","گروهی سگان حلقه پیرامنش","معنای این بیت این است که شخصی دستار و پیراهنش را به سبب آلودگی‌ها به حالتی غیرقابل قبول درآورده و گروهی از سگان دور او را گرفته‌اند، که نشانه ضعف و بی‌احترامی به اوست."],[169,"چو پیر از جوان این حکایت شنید","به آزار از او روی در هم کشید","وقتی پیرمرد از جوان این داستان را شنید، به خاطر آزار و ناراحتی‌ای که دید، چهره‌اش را در هم کشید."],[169,"زمانی بر آشفت و گفت ای رفیق","به کار آید امروز یار شفیق","او (پیر) از جوان (رفیق) دلخور و ناراحت شد و گفت: در این وضعیت، وجود یک دوست صمیمی و مهربان به کمک خواهد آمد."],[169,"برو زآن مقام شنیعش بیار","که در شرع نهی است و در خرقه عار","از آن مکان زشت و نیکوکار دور شو، زیرا که در دین اسلام این عمل ممنوع است و در لباس عبادت نیز شرم‌آور به شمار می‌آید."],[169,"به پشتش در آور چو مردان که مست","عنان سلامت ندارد به دست","چون او به دلیل نداشتن کنترل بر خود و وضع نامناسبش در حالتی شبیه به یک مرد دیوانه است، تو باید او را به آرامی در راه درست هدایت کنی و از پشتش پشتیبانی کنی."],[169,"نیوشنده شد زین سخن تنگدل","به فکرت فرو رفت چون خر به گل","شنونده از این سخن ناراحت و دل تنگ شد و در فکر فرو رفت، مانند الاغی که در گل گیر کرده است و نمی‌تواند حرکت کند."],[169,"نه زهره که فرمان نگیرد به گوش","نه یارا که مست اندر آرد به دوش","کسی که شجاعت و عقل لازم را نداشته باشد، نمی‌تواند به خوبی فرمان بگیرد و در پی لذتی که باعث مستی و بی‌خودیش شود، به خود آسیب می‌زند."],[169,"زمانی بپیچید و درمان ندید","ره سر کشیدن ز فرمان ندید","مدت زمانی گذشت و او نتوانست درمانی پیدا کند، زیرا نتوانست از دستور و هدایت خارج شود و از آن پیروی کرد."],[169,"میان بست و بی اختیارش به دوش","در آورد و شهری بر او عام جوش","در میانه کار، ناگهان او را مجبور کرد تا بار سنگینی را به دوش بکشد و مردم در شهر به تماشای او پرداختند و به هیجان آمدند."],[169,"یکی طعنه می‌زد که درویش بین","زهی پارسایان پاکیزه دین!","کسی به درویش طعنه می‌زند که چه ادعایی دارد و برتر از دیگران است، با اینکه اهل دین و پارسایی به حساب می‌آید و خود را پاک و بی‌ آلایش نشان می‌دهد."],[169,"یکی صوفیان بین که می خورده‌اند","مرقع به سیکی گرو کرده‌اند","یکی از صوفیان را می‌بینم که در حال نوشیدن شراب است و در عین حال، لباس کهنه و رنگ و رو رفته‌ای به خود دارد که نشان‌دهنده زهد و دوری از دنیا است."],[169,"اشارت کنان این و آن را به دست","که آن سر گران است و این نیم مست","با اشاره به دیگران، از آن‌ها بخواه که کاری را انجام دهند و خودشان در دردسر نیفتند، چرا که مسئله سنگین و دشواری است و آنچه در دست فردی دیگر است، بی‌اهمیت‌تر به نظر می‌رسد."],[169,"به گردن بر از جور دشمن حسام","به از شنعت شهر و جوش عوام","اگرچه حسام مورد ظلم و ستم دشمنان قرار گرفته، اما مقام و اعتبار او بالاتر از شهرت و سر و صدای مردم است."],[169,"بلا دید و روزی به محنت گذاشت","به ناکام بردش به جایی که داشت","انسانی در بلا و مصیبت قرار گرفت و روزی او را با سختی به جایی برد که آنجا همان مقام یا وضعی بود که در آن زندگی می‌کرد."],[169,"شب از فکرت و نامرادی نخفت","دگر روز پیرش به تعلیم گفت","او به خاطر فکر و اندیشه‌های منفی و بدشانسی‌اش شب‌ها راحت نمی‌خوابید. پیر/her به او گفت که باید یاد بگیرد و از تجربیاتش بهره‌مند شود."],[169,"مریز آبروی برادر به کوی","که دهرت نریزد به شهر آبروی","آبروی برادرت را در کوچه و خیابان حفظ کن، زیرا اگر آبرویت در شهر ریخته شود، دیگر ارزشی برای نخواهد داشت."],[170,"بد اندر حق مردم نیک و بد","مگوی ای جوانمرد صاحب‌خرد","ای جوانمرد صاحب‌خرد! درباره دیگران بد مگوی؛ چه آن شخص نیک باشد یا بد."],[170,"که بد‌مرد را خصم خود می‌کنی","وگر نیک‌مردست بد می‌کنی","اگر آن شخص آدم بدی است او را دشمن خود می‌کنی و اگر آدم خوبی است کاری زشت می‌کنی."],[170,"تو را هر که گوید فلان کس بد است","چنان دان که در پوستین خود است","اگر کسی نزد تو از دیگری بد می‌گوید بدان که دارد درباره خود حرف می‌زند و بد خودش را می‌گوید."],[170,"که فعل فلان را بباید بیان","وز این فعل بد می‌برآید عیان","زیراکه فعل بد آن شخص غایب معلوم نیست که راست باشد یا دروغ ولی این کار زشت بدگویی، عیان است."],[170,"به بد گفتن خلق چون دم زدی","اگر راست گویی سخن هم بدی","وقتی که از دیگران بد می‌گویی حتی اگر راست بگویی باز هم بد تو هستی (و داری کار بدی می‌کنی)"],[170,"زبان کرد شخصی به غیبت دراز","بدو گفت داننده‌ای سرفراز","کسی داشت که دیگری را بدگویی و غیبت می‌کرد شخص دانایی او را گفت:"],[170,"که یاد کسان پیش من بد مکن","مرا بدگمان در حق خود مکن","هرگز یاد کسانی را نزد من نکن؛ زیرا این کار باعث می‌شود که نسبت به تو بدگمان شوم."],[170,"گرفتم ز تمکین او کم ببود","نخواهد به جاه تو اندر فزود","گیرم که از احترام او کاسته شود. اما این بدگویی، مقام و ارزش تو را بیشتر نمی‌کند."],[170,"کسی گفت و پنداشتم طیبت است","که دزدی بسامان‌تر از غیبت است","شخصی گفت که دزدی از غیبت بهتر است. من پنداشتم که شوخی می‌کند؛"],[170,"بدو گفتم ای یار آشفته هوش","شگفت آمد این داستانم به گوش","به او گفتم: ای دوست حواس‌پرت من، این چیزی که می‌گویی چیز تازه و عجیبی است."],[170,"به ناراستی در چه بینی بهی","که بر غیبتش مرتبت می‌نهی؟","در دزدی چه چیزی هست که می‌گویی بهتر از غیبت است؟"],[170,"بلی گفت دزدان تهور کنند","به بازوی مردی شکم پر کنند","گفت: بله دزدان و راهزنان لااقل اینقدر شجاعت دارند که با دزدی شکم خود را پر می‌کنند."],[170,"ز غیبت چه می‌خواهد آن ساده مرد؟","که دیوان سیه کرد و چیزی نخورد!","ولی آدم بدگوی ساده‌لوح چه کسب کرد؟ نامه اعمال خود را سیاه کرد و چیزی هم بدست نیاورد."],[171,"مرا در نظامیه ادرار بود","شب و روز تلقین و تکرار بود","در دانشگاه نظامیه من مشغول تحصیل بودم و هر روز مشغول به یادگیری با تکرار مطالب بودم."],[171,"مر استاد را گفتم ای پر خرد","فلان یار بر من حسد می‌برد","من به استاد گفتم، ای انسانی با عقل و دانش، که فلان دوست (یار) به من حسد می‌ورزد."],[171,"چو من داد معنی دهم در حدیث","بر آید به هم اندرون خبیث","وقتی من معنای واقعی مطالب درسی را بیان میکنم، می‌بینم که دوستم از پیشرفت من ناراحت می‌شود"],[171,"شنید این سخن پیشوای ادب","به تندی برآشفت و گفت ای عجب!","پیشوای ادب با شنیدن این صحبت به شدت عصبانی شد و گفت جالب است که چنین چیزی مطرح می‌شود."],[171,"حسودی پسندت نیامد ز دوست","که معلوم کردت که غیبت نکوست؟","تو که حسادت دوستت به خود را بسیار بد می‌دانی، از کجا فهمیدی که بدگویی از او کار خوبی است؟"],[171,"گر او راه دوزخ گرفت از خسی","از این راه دیگر تو در وی رسی","اگر او از راه حسادت به تو به جهنم برود ، تو هم بخاطر اینکه پشت سر دوستت بدگویی میکنی، به جهنم خواهی رفت."],[172,"کسی گفت حجاج خون‌خواره‌ای است","دلش همچو سنگ سیه پاره‌ای است","یک نفر می‌گوید حجاج، حاکمی خشن و کشتارگر است و دلش به اندازه سنگی سیاه بی‌رحم و بی‌احساس است."],[172,"نترسد همی ز آه و فریاد خلق","خدایا تو بستان از او داد خلق","نگران صدای ناله و فریاد مردم نیست، ای خدا، تو حق مردم را از او بگیر."],[172,"جهاندیده‌ای پیر دیرینه زاد","جوان را یکی پند پیرانه داد","یک انسان با تجربه و کهنسال به جوانی نصیحت و اندرز پندآموزی می‌دهد."],[172,"کز او داد مظلوم مسکین او","بخواهند و از دیگران کین او","اگر از او (نوجوان) طلب حقیقت و عدالت کنند، مظلوم و بی‌پناه خواهد بود و اگر از دیگران حسد و کینه ببینند، به او آسیب خواهد رسید."],[172,"تو دست از وی و روزگارش بدار","که خود زیر دستش کند روزگار","تو از او و اوضاع او کناره بگیر، زیرا خود سرنوشت او را در دست خواهد گرفت و به زودی او را زیر فشار قرار می‌دهد."],[172,"نه بیداد از او بهره‌مند آیدم","نه نیز از تو غیبت پسند آیدم","نه از ظلم و ستم او بهره‌ای می‌برم و نه غیبت و پشت‌سرگویی تو برایم خوشایند است."],[172,"به دوزخ برد مدبری را گناه","که پیمانه پر کرد و دیوان سیاه","مدبر (عاقل) را به خاطر گناهش به دوزخ می‌برند، چون ظرفش را پر کرد و کارهای نادرست زیادی انجام داد. مفهوم این است که عدم کنترل بر رفتار و اعمال می‌تواند عواقب شدیدی داشته باشد."],[172,"دگر کس به غیبت پیش می‌دود","مبادا که تنها به دوزخ رود","دیگران در غیبت و بدگویی از کسی سخن می‌گویند تا خودشان تنها به عذاب و جهنم نیفتند."],[173,"شنیدم که از پارسایان یکی","به طیبت بخندید با کودکی","شنیدم یکی از پارسایان (مردان دیندار و پرهیزگار) با کودکی در حال خنده و شوخی بود."],[173,"دگر پارسایان خلوت نشین","به عیبش فتادند در پوستین","دیگر پارسایان عابدی که در تنهایی به پرهیزگاری می‌پردازند، به عیب و نقص او که کودک را مسخره کرده، انتقاد کردند و او را سرزنش کردند."],[173,"به آخر نماند این حکایت نهفت","به صاحب نظر باز گفتند و گفت","حکایت نهفته‌ای که در ابتدا بیان شد، سرانجام به صاحب‌نظران و دانایان گفته شد و آن‌ها هم نظر خود را بیان کردند."],[173,"مدر پرده بر یار شوریده حال","نه طیبت حرام است و غیبت حلال!","اگر کسی در حال شیدایی بر یار خود بپرده بدوزد، نه زیبایی او حرام است و نه غیبت او اجازه دارد."],[174,"به طفلی درم رغبت روزه خاست","ندانستمی چپ کدام است و راست","مظهر کودک بود که به روزه گرفتن میل و رغبت پیدا کرد، اما نمی‌دانست که کدام دستش چپ است و کدام دستش راست."],[174,"یکی عابد از پارسایان کوی","همی شستن آموختم دست و روی","من از یکی از عابدان و پارسایان در محل، شستن دست و صورت را آموختم."],[174,"که بسم الله اول به سنت بگوی","دوم نیت آور، سوم کف بشوی","باید در آغاز کار با نام خدا شروع کنی، سپس نیت خود را مشخص کن و در نهایت دستانت را بشوی."],[174,"پس آن گه دهن شوی و بینی سه بار","مناخر به انگشت کوچک بخار","پس از آن باید دهان را بشویی و سه بار با انگشت کوچک، بینی را بفشاری تا پاک شود."],[174,"به سبابه دندان پیشین بمال","که نهی است در روزه بعد از زوال","با انگشت سبابه (انگشت اشاره) دندانی را که از جلو بیرون است، به آن بمال که این کار بعد از غروب آفتاب، در روزه، ممنوع است."],[174,"وز آن پس سه مشت آب بر روی زن","ز رستنگه موی سر تا ذقن","سپس با سه مشت آب روی او را بشوی از رستنگاه موهای سر تا چانه‌اش."],[174,"دگر دستها تا به مرفق بشوی","ز تسبیح و ذکر آنچه دانی بگوی","بعد از شستن سر و پاها، باید دست‌ها را تا مرفق (آرنج) بشویی و آنچه از ذکر و نماز می‌دانی بر زبان بیاوری."],[174,"دگر مسح سر، بعد از آن غسل پای","همین است و ختمش به نام خدای","بعد از شستن دست‌ها تا مرفق، باید سر را مسح کرد و در پایان کار، با نام خدا غسل را تمام کرد."],[174,"کس از من نداند در این شیوه به","نبینی که فرتوت شد پیر ده؟","هیچ‌کس از من خبر ندارد که من چگونه به این حال درآمده‌ام؛ تو هم نمی‌بینی که پیر ده چقدر فرتوت و ضعیف شده است؟"],[174,"بگفتند با دهخدای آنچه گفت","فرستاد پیغامش اندر نهفت","دهخدا (نوعی عالم و حکیم) پیامی را که به او گفتند، به صورت مخفیانه فرستاد و پنهان نگه داشت."],[174,"که ای زشت کردار زیبا سخن","نخست آنچه گویی به مردم بکن","ای شخصی که کردار زشتی داری ولی در گفتار زیبا هستی، ابتدا باید آنچه را که به مردم می‌گویی، خودت هم به آن عمل کنی."],[174,"نه مسواک در روزه گفتی خطاست","بنی آدم مرده خوردن رواست؟","اگر در روزه مسواک زدن را خطا می‌دانید، آیا خوردن چیزهای حرام برای انسان‌ها مجاز است؟"],[174,"دهن گو ز ناگفتنیها نخست","بشوی آن که از خوردنیها بشست","برای اینکه زبانت از چیزهایی که نمی‌توان گفت پاک شود، ابتدا دهانت را بشوی، همانطور که از خوردنی‌ها پاک می‌شود."],[174,"کسی را که نام آمد اندر میان","به نیکوترین نام و نعتش بخوان","هرگاه نام فردی در جمع برده شود، او را به بهترین نام و صفات نیکو یاد کن."],[174,"چو همواره گویی که مردم خرند","مبر ظن که نامت چو مردم برند","اگر همواره بگویی که مردم نادان و احمق هستند، این باور را نداشته باش که نام تو مانند آن‌ها خواهد بود و بر تو خواهند گفت که مانند مردم عادی‌تری."],[174,"چنان گوی سیرت به کوی اندرم","که گفتن توانی به روی اندرم","به‌گونه‌ای عمل کن که رفتار و شخصیت تو در کوی من نمایان باشد، که اگر بخواهی سخن از من بگویی، بر چهره‌ام قابل مشاهده باشد."],[174,"وگر شرمت از دیده ناظر است","نه ای بی‌بصر، غیب دان حاضر است؟","اگر شرم‌ات از نگاه بیننده‌ای است، بدان که او که نمی‌بینی، باخبر و توانا به غیب‌هاست."],[174,"نیاید همی شرمت از خویشتن","کز او فارغ و شرم داری ز من؟","اگر شرم تو از خودت نیست، چرا از من که هیچ ارتباطی با تو ندارم شرمنده‌ای؟"],[175,"طریقت شناسان ثابت قدم","به خلوت نشستند چندی به هم","عارفان و راهنمایان این طریقت‌، که بر اعتقاد خود استوار و ثابت قدمند، در مکانی آرام و خلوت به مدت مدتی با یکدیگر نشسته‌اند."],[175,"یکی زان میان غیبت آغاز کرد","در ذکر بیچاره‌ای باز کرد","یکی از حاضران در مجلس غیبت را شروع کرد و به صحبت درباره فردی بیچاره و بدبخت پرداخت."],[175,"کسی گفتش ای یار شوریده رنگ","تو هرگز غزا کرده‌ای در فرنگ؟","شخصی به دوست خود می‌گوید که آیا تو اصلا در جنگ‌ها و نبردها، به ویژه در سرزمین‌های فرنگی، شرکت کرده‌ای یا اینکه همیشه در حالت‌های بی‌خیالی و سرخوشی بوده‌ای؟"],[175,"بگفت از پس چار دیوار خویش","همه عمر ننهاده‌ام پای پیش","او می‌گوید که در تمام عمرش هیچ‌گاه از چهار دیوار خانه‌اش خارج نشده و قدم به بیرون نگذاشته است."],[175,"چنین گفت درویش صادق نفس","ندیدم چنین بخت برگشته کس","درویشی با نفس پاک و راستین می‌گوید که هرگز چنین فرد بدبختی را ندیده است."],[175,"که کافر ز پیکارش ایمن نشست","مسلمان ز جور زبانش نرست","کافر از رفتار و کردار او در امان است، اما مسلمان از بدزبانیش در امان نیست."],[175,"چه خوش گفت دیوانه مرغزی","حدیثی کز او لب به دندان گزی","دیوانه مرغزی (شخصی که به نظر می‌رسد عقلش درست کار نمی‌کند) جمله‌ای زیبا و دل‌نشین گفت که به دل مردم نشسته و باعث شده‌است که آنها به دندان‌هایشان لب بزنند (یعنی از حیرت یا شگفتی دندان روی دندان بگذارند)."],[175,"من ار نام مردم بزشتی برم","نگویم به جز غیبت مادرم","اگر بخواهم از بدی‌های دیگران بگویم، تنها غیبت مادر خودم را روا می‌دانم و درباره هیچ‌کس دیگر سخن نمی‌گویم."],[175,"که دانند پروردگان خرد","که طاعت همان به که مادر برد","کسانی که تربیت‌شدگان عقل و خرد هستند، می‌دانند که عبادت و پیروی از دستورات الهی بهتر است که به خاطر مادر باشد، یعنی باید به احترام مادر عمل کرد."],[175,"رفیقی که غایب شد ای نیک نام","دو چیزست از او بر رفیقان حرام","دو ویژگی از رفیق نیک نامی که غایب شده وجود دارد که در ارتباط با دوستانش باید از آنها پرهیز کنند."],[175,"یکی آن که مالش به باطل خورند","دوم آن که نامش به غیبت برند","یکی از دو چیز این است که مال او را به ناحق مصرف کنند و دیگر اینکه نام او را در غیبت ببرند."],[175,"هر آن کو برد نام مردم به عار","تو خیر خود از وی توقع مدار","هر کسی که در غیابت در مورد تو حرف بزند و نام تو را بی‌احترامی ببرد، نباید انتظار خیر و نیکی از او داشته باشی."],[175,"که اندر قفای تو گوید همان","که پیش تو گفت از پس مردمان","کسی که در غیاب تو همان سخن را درباره تو می‌زند که در حضور تو گفته، در واقع به خاطر مردم دیگر سخن می‌گوید و قابل اعتماد نیست."],[175,"کسی پیش من در جهان عاقل است","که مشغول خود وز جهان غافل است","انسان عاقل کسی است که به خود و امور خود توجه دارد و از مشکلات و نگرانی‌های دنیای بیرون بی‌خبر و غافل است."],[176,"سه کس را شنیدم که غیبت رواست","وز این درگذشتی چهارم خطاست","شنیده‌ام که غیبت سه کس اشکال ندارد، از این سه کس بیشتر و فراتر خطاست‌؛"],[176,"یکی پادشاهی ملامت پسند","کز او بر دل خلق بینی گزند","یکی حاکم و پادشاه ظالم که به مردم ظلم می‌کند و دل مردم از ستم او دردمند است."],[176,"حلال است از او نقل کردن خبر","مگر خلق باشند از او بر حذر","از ظلم‌ها و ستم‌های او گفتن‌، حلال است تا که مردم از وی بر‌حذر باشند و از او دوری کنند."],[176,"دوم پرده بر بی‌حیایی متن","که خود می‌درد پرده بر خویشتن","دوم، تو در آبرو‌مند کردن کسی که (خود در ملأ عام) بی‌حیایی می‌کند و آبروی خود را می‌برد‌، مکوش‌."],[176,"ز حوضش مدار ای برادر نگاه","که او می‌درافتد به گردن به چاه","که خود نتیجه‌اش را که در چاه افتادن ‌(و پشیمان شدن است‌) خواهد دید‌."],[176,"سوم کژ ترازوی ناراست خوی","ز فعل بدش هرچه دانی بگوی","سوم‌، گران‌فروش بد‌کردار که (هر چه از گران‌فروشی او‌) می‌دانی مردم را آگاه کن. (تا فریب نخورند‌) (کج‌ترازو‌‌ یعنی کم‌فروش‌، گران‌فروش‌‌‌، متقلب‌)"],[177,"شنیدم که دزدی درآمد ز دشت","به دروازه سیستان برگذشت","شنیده‌ام که دزدی از دشت و صحرا به دروازه شهر سیستان رسید. (سیستان منظور شهری است که در قدیم «زرنگ‌» نیز خوانده می‌شده است‌، امروزه زرنج نامیده می‌شود‌.)"],[177,"بدزدید بقال از او نیم دانگ","برآورد دزد سیه‌کار بانگ:","بقالی (در معامله‌) نیم‌دانگ از او دزدید؛ آن دزد خطاکار فریاد بر‌آورد‌:"],[177,"خدایا تو شب‌رو به آتش مسوز","که ره می‌زند سیستانی به‌روز","خدایا‌، تو دزدان شب‌رو را مجازات مکن و مسوزان‌، این بقال‌ سیستانی در روز روشن دزدی می‌کند."],[178,"یکی گفت با صوفی‌یی در صفا","ندانی فلانت چه گفت از قفا","شخصی به یک صوفی پاک‌دل و با‌صفا گفت‌: نمی‌دانی فلانی پشت‌سر تو چه گفت!"],[178,"بگفتا خموش، ای برادر، بخفت","ندانسته بهتر که دشمن چه گفت","صوفی به‌او گفت‌: ای برادر خموش باش و برو بخواب؛ همان بهتر که ندانم بدخواه من پشت‌سر من چه‌می‌گوید."],[178,"کسانی که پیغام دشمن برند","ز دشمن همانا که دشمن‌تر‌ند","کسانی‌که پیغام و حرف‌های بدخواهان را به‌تو می‌رسانند‌، از دشمنان تو بدترند."],[178,"کسی قول دشمن نیارد به دوست","جز آن کس که در دشمنی یار اوست","کسی حرف و گفته دشمنان و بدخواهان را به‌تو نمی‌رساند مگر کسی که همچون او دشمن توست."],[178,"نیارست دشمن جفا گفتنم","چنان کز شنیدن بلرزد تنم","دشمن جرات ندارد در مقابلم به‌من بد بگوید زیرا از شنیدنش تنم به‌لرزه می‌افتد (از خشم یا از غصه)"],[178,"تو دشمن‌تری کآوری بر دهان","که دشمن چنین گفت اندر نهان","تو از آن دشمن‌، دشمن‌تر هستی زیرا آنچه‌را که بدخواه و دشمن من در پنهان می‌گوید به‌من می‌رسانی."],[178,"سخن‌چین کند تازه جنگ‌ قدیم","به خشم آورد نیک‌مرد سلیم","آدم سخن‌چین، جنگ‌ و دشمنی‌های کهنه را تازه می‌کند و و آدم‌های خوب و ساده‌دل را به‌خشم و دشمنی می‌آورد."],[178,"از آن همنشین تا توانی گریز","که مر فتنه خفته را گفت خیز","از هم‌صحبتی و هم‌نشینی با چنین آدمهایی که جنگ‌افروزی و فتنه‌انگیزی می‌کنند‌، بپرهیز!"],[178,"سیه‌چال و مرد اندر او بسته پای","به از فتنه از جای بردن به‌جای","در زندان بودن بهتر از دشمنی و کینه‌ورزی است."],[178,"میان دو تن جنگ چون آتش است","سخن‌چین بدبخت هیزم‌کش است","میان دو نفر، جنگ و دشمنی همچون آتشی سوزاننده است و آدم سخن‌چین بدبخت در این‌میان هیزم‌کش است. (یعنی همچون هیزم‌کش دوزخ جای او در دوزخ است)"],[179,"فریدون وزیری پسندیده داشت","که روشن دل و دوربین دیده داشت","فریدون‌شاه وزیری نیکو داشت که روشن‌رای و کاردان بود."],[179,"رضای حق اول نگه داشتی","دگر پاس فرمان شه داشتی","نخست رضا و خشنودی پروردگار را نگه‌می‌داشت و پس از آن فرمان و دستور شاه را."],[179,"نهد عامل سفله بر خلق رنج","که تدبیر ملک است و توفیر گنج","عامل و مسؤول سفله و پست‌، به مردم رنج و زیان می‌رساند به این بهانه که تدبیر حکومت است و این‌ باعث افزایش پول و ثروت است."],[179,"اگر جانب حق نداری نگاه","گزندت رساند هم از پادشاه","اگر طرف حق را نگیری، از سوی پادشاه هم به تو آسیب ‌می‌رسد."],[179,"یکی رفت پیش ملک بامداد","که هر روزت آسایش و کام باد","یکی پیش فریدون رفت (و پس از دعا) که هر روز آسایش و بهروزی داشته باشی."],[179,"غرض مشنو از من نصیحت پذیر","تو را در نهان دشمن است این وزیر","(گفت‌) این که می‌گویم را بدخواهی مدان بلکه نصیحت و پند است؛ وزیر تو در نهان و دور از چشم تو‌، دشمن توست."],[179,"کس از خاص لشکر نمانده‌ست و عام","که سیم و زر از وی ندارد به وام","از خاص و عام هیچکس نمانده که وزیر به او وام و قرض نداده باشد."],[179,"به شرطی که چون شاه گردن فراز","بمیرد، دهند آن زر و سیم باز","و شرط بازگرداندن قرض را به روزی موکول کرده که شاه بمیرد."],[179,"نخواهد تو را زنده این خودپرست","مبادا که نقدش نیاید به دست","این آدم خودپرست نمی‌خواهد تو را زنده ببیند چون فکر می‌کند که با مرگ تو پول‌هایش برخواهد گشت."],[179,"یکی سوی دستور دولت پناه","به چشم سیاست نگه کرد شاه","شاه نگاهی از راه تنبیه و خشم به آن وزیر دولت‌پناه و کاردان کرد."],[179,"که در صورت دوستان پیش من","به خاطر چرایی بد اندیش من؟","‌(و گفت‌) که در ظاهر‌ یک دوست چرا دشمن من هستی؟"],[179,"زمین پیش تختش ببوسید و گفت","نشاید چو پرسیدی اکنون نهفت","وزیر با احترام خاک‌بوسی کرد و گفت الان که پرسیدی شایسته نیست پنهان بدارم."],[179,"چنین خواهم ای نامور پادشاه","که باشند خلقت همه نیک خواه","ای پادشاه نامور، چنین می‌خواهم که همه مردم نیک‌خواه و خیر‌خواه تو باشند."],[179,"چو مرگت بود وعده سیم من","بقا بیش خواهندت از بیم من","چون برگشت پولم را به مرگ تو وعده و موکول کرده‌ام از ترس من‌، خواهان بقا و درازی عمر تو هستند."],[179,"نخواهی که مردم به صدق و نیاز","سرت سبز خواهند و عمرت دراز؟","آیا دوست نداری که مردم با دعا و صدقه خواهان سلامت تو و طول عمرت باشند‌؟"],[179,"غنیمت شمارند مردان دعا","که جوشن بود پیش تیر بلا","مردان‌، دعای خیر را غنیمت می‌شمارند زیرا‌که مانند زره و جوشن‌ در برابر تیر‌های بلا‌‌ست."],[179,"پسندید از او شهریار آنچه گفت","گل رویش از تازگی برشکفت","فریدون آنچه را که وزیر گفت پسندید و شاد شد."],[179,"ز قدر و مکانی که دستور داشت","مکانش بیفزود و قدرش فراشت","به قدر و جایگاهی که آن وزیر داشت افزود."],[179,"بد اندیش را زجر و تأدیب کرد","پشیمانی از گفته خویش خورد","و آن بداندیش و بد‌گو را تنبیه کرد و از گفته خود نیز پشیمان گشت."],[179,"ندیدم ز غماز سرگشته‌تر","نگون طالع و بخت برگشته‌تر","از آدم بد‌گو بیچاره‌تر و نگون‌بخت‌تر ندیده‌ام."],[179,"ز نادانی و تیره رایی که اوست","خلاف افکند در میان دو دوست","از نادانی و بداندیشی‌، میان دو دوست اختلاف می‌اندازد."],[179,"کنند این و آن خوش دگر باره دل","وی اندر میان کور بخت و خجل","آن دو دوست دوباره از هم خوشدل می‌شوند و او در میان‌، خجل و بدبخت می‌ماند."],[179,"میان دو کس آتش افروختن","نه عقل است و خود در میان سوختن","اختلاف و دشمنی افکندن میان دو شخص؛ و خود زیان دیدن، کاری عاقلانه نیست."],[179,"چو سعدی کسی ذوق خلوت چشید","که از هر که عالم زبان درکشید","کسی همچون سعدی لذت خلوت را چشید که از بدگویی‌ دیگران دوری کرد."],[179,"بگوی آنچه دانی سخن سودمند","وگر هیچ کس را نیاید پسند","آنچه که سودمند و مفید است را بگو حتی اگر دیگران نپسندند."],[179,"که فردا پشیمان برآرد خروش","که آوخ چرا حق نکردم به گوش؟","که بعدا از روی پشیمانی خروش بر‌می‌آورد و می‌گوید که چرا به آن سخن حق و درست گوش نکردم."],[180,"زن خوب فرمانبر پارسا","کند مرد درویش را پادشا","زن شایسته، حرف‌شنو و پرهیزگار، حتی مرد فقیر و تهیدست را مانند یک پادشاه، بی‌نیاز و سربلند می‌سازد."],[180,"برو پنج نوبت بزن بر درت","چو یاری موافق بود در برت","اگر همسری همراه و سازگار در کنارت داری، طبل شادی و پادشاهی بنواز (کنایه از به اوج عزت و خوشبختی رسیدن، مانند شاهانی که پنج نوبت بر درگاهشان طبل می‌زدند)."],[180,"همه روز اگر غم خوری، غم مدار","چو شب غمگسارت بود در کنار","اگر در طول روز تمام سختی‌های دنیا را بچشی باکی نیست، به شرطی که شب‌ها همدم و دلارامی کنارت باشد تا اندوهت را برطرف کند."],[180,"کرا خانه، آباد و، همخوابه، دوست","خدا را به رحمت نظر سوی اوست","هر کس که خانه‌اش روبه‌راه و همسرش مهربان و یار او باشد، لطف و رحمت خدا شامل حالش شده است."],[180,"چو مستور باشد زن و خوبروی","به دیدار او در بهشت است شوی","وقتی زن پاکدامن و زیبارو باشد، شوهر تنها با نگاه کردن به چهره‌اش احساس می‌کند در بهشت به سر می‌برد."],[180,"کسی برگرفت از جهان کام دل،","که یکدل بود با وی آرام دل","تنها کسی در این دنیا به کامیابی واقعی و خوشبختی رسیده که آرامش جانش (همسرش) با او کاملا یکدل و صمیمی باشد."],[180,"اگر پارسا باشد و خوش‌سخن","نگه در نکوییّ و زشتی مکن","اگر زنی باتقوا، پاکدامن و خوش‌گفتار بود، دیگر به زیبایی ظاهری یا نازیبایی چهره‌اش توجهی نکن."],[180,"زن خوش‌منش، دل‌نشان‌تر که خوب","که آمیزگاری بپوشد عیوب","زن خوش‌اخلاق و مهربان، از زن زیبارو دلنشین‌تر است؛ چرا که خوش‌رفتاری و سازگاری، عیب‌های دیگر (از جمله ظاهر) را می‌پوشاند."],[180,"ببرد از پری‌چهره زشت‌خوی","زن دیوسیمای خوش‌طبع، گوی","یک زن زشت‌رو ولی خوش‌اخلاق، در ارزش و جذابیت، گوی سبقت را از زیبارویی که بدخلق است می‌رباید و بر او پیروز می‌شود."],[180,"چو حلوا خورد سرکه از دست شوی","نه حلوا خورد سرکه‌اندوده‌روی","زن سازگار، حتی تلخی و ترش‌رویی (سرکه) همسرش را مانند حلوا شیرین می‌پذیرد؛ نه اینکه مثل زنان بدخو، با چهره‌ای ترش و عبوس پای خوردن حلوا بنشیند."],[180,"دلارام باشد زن نیک‌خواه","ولیکن زن بد، خدایا پناه!","زن خیرخواه و مهربان آرامش‌بخش دل است؛ اما از دست زن بدکردار، فقط باید به خدا پناه برد!"],[180,"چو طوطی کلاغش بود هم‌نفس","غنیمت شمارد خلاص از قفس","همان‌طور که همنشینی طوطی با کلاغ چنان عذاب‌آور است که رهایی از قفس (یا حتی مردن) را نعمت می‌داند، مرد نیز از زن ناسازگار بیزار و گریزان است."],[180,"سر اندر جهان نه به آوارگی","وگرنه، بنه دل به بیچارگی","(اگر با زن بد گرفتار شدی) سرت را بردار و در جهان آواره شو؛ وگرنه باید تا آخر عمر تن به درماندگی و تیره‌روزی بدهی."],[180,"تهی‌پای رفتن به از کفش تنگ","بلای سفر، به که در خانه جنگ","پابرهنه راه رفتن بهتر از پوشیدن کفش تنگ و آزاردهنده است؛ کشیدن رنج سفر و آوارگی نیز از دعوا و نزاع همیشگی در خانه بسیار بهتر است."],[180,"به زندان قاضی گرفتار به","که در خانه دیدن بر ابرو گره","گرفتار شدن در سیاه‌چال قاضی، بهتر از آن است که در خانه با اخم و ترش‌رویی همسر روبرو شوی."],[180,"سفر، عید باشد بر آن کدخدای","که بانوی زشتش بود در سرای","برای مردی که زنی بدخو و ناخوشایند در خانه دارد، رخت بستن و رفتن به سفر درست مانند رسیدن روز عید و آزادی است."],[180,"در خرمی بر سرایی ببند","که بانگ زن از وی برآید بلند","در شادی و سعادت را به روی خانه‌ای ببند که فریاد و صدای زن در آن بلند باشد (صدایش بر مرد غلبه کند و حاکم خانه باشد)."],[180,"چو زن راه بازار گیرد، بزن","وگرنه تو در خانه بنشین چو زن!","اگر زن سرخود راه کوچه و بازار در پیش گرفت، مانعش شو و تنبیهش کن؛ وگرنه بهتر است خودت دست از مردی بکشی و مثل زنان در خانه بنشینی!"],[180,"اگر زن ندارد سوی مرد، گوش","سراویل کحلیش در مرد پوش","اگر زن از شوهرش فرمان نمی‌برد و به حرف او گوش نمی‌دهد، شلوار سرمه‌ای زنانه را پای شوهر بپوشانید (چون اقتدار ندارد و سزاوار مردی نیست)."],[180,"زنی را که جهل است و ناراستی","بلا بر سر خود، نه زن خواستی","اگر زنی نادان و فریبکار اختیار کنی، در حقیقت همسر نگرفته‌ای، بلکه بر سر خودت بلا و عذاب نازل کرده‌ای"],[180,"چو در کیله یک جو امانت شکست","از انبار گندم فرو شوی دست","اگر همسرت در پیمانه‌ای کوچک حتی به اندازه یک دانه جو خیانت کرد، دیگر از محافظت کل انبار گندم ناامید شو (خیانت کوچک نشان از عدم وفاداری در کارهای بزرگ دارد)."],[180,"بر آن بنده، حق نیکویی خواسته است","که با او دل و دست زن راست است","خداوند به بنده‌ای خیر و سعادت داده است که فکر (دل) و کردار (دست) همسرش با او راستین، پاک و وفادار باشد."],[180,"چو در روی بیگانه خندید زن","دگر، مرد گو لاف مردی مزن","اگر زنی به روی مرد نامحرم و غریبه لبخند بزند، به شوهرش بگو دیگر ادعای غیرت و ناموس‌داری نکند."],[180,"زن شوخ چون دست در قلیه کرد","برو گو بنه پنجه بر روی مرد","زن گستاخ و بی‌پروا که حرمت مرد را بشکند، دیگر ابایی ندارد که پنجه بر چهره شوهرش نیز بیندازد و او را رسوا و بی‌حیثیت کند."],[180,"ز بیگانگان چشم زن کور باد","چو بیرون شد از خانه، در گور باد","چشم زن از نگریستن به نامحرمان کور باد! و هر زمان که برای کاری ناشایست از خانه بیرون رفت، بهتر است روانه گور و مرگ شود."],[180,"چو بینی که زن پای‌برجای نیست","ثبات، از خردمندی و رای نیست","وقتی دیدی زن اهل وفاداری و پاکدامنی نیست و لغزش دارد، دیگر ماندن با او و مدارا کردن نشانه عقل و دانایی نیست."],[180,"گریز از کفش در دهان نهنگ","که مردن به از زندگانی به ننگ","از دست چنین زنی حتی اگر به دهان نهنگ هم بگریزی بهتر است؛ زیرا مرگ با عزت، از زندگی با ننگ و بی‌آبرویی برتر است."],[180,"بپوشانش از چشم بیگانه روی","وگر نشنود، چه زن آنگه چه شوی!","رویش را از دید نامحرمان بپوشان، و اگر زیر بار نرفت و گوش نکرد، آنگاه دیگر تفاوتی میان زن و شوهر نیست (مردی باقی نمانده است)."],[180,"زن خوب خوش‌طبع رنج است و بار","رها کن زن زشت ناسازگار","حتی همسر خوب و سازگار هم زحمت‌ها و مسئولیت‌های خودش را دارد؛ بنابراین زنی را که بدخو و ناسازگار است باید به‌کلی رها کرد."],[180,"چه نغز آمد این یک سخن زآن دو تن","که بودند سرگشته از دست زن","چه سخن زیبا و به جایی گفتند آن دو مردی که از دست همسرانشان درمانده و کلافه بودند:"],[180,"یکی گفت : «کس را زن بد مباد»","دگر گفت : «زن در جهان خود مباد!»","یکی گفت: «خدا نکند هیچ‌کس گرفتار زن بد شود»، و دیگری گفت: «اصلا بهتر است زنی در این دنیا وجود نداشته باشد!»"],[180,"زن نو کن ای دوست هر نوبهار","که تقویم پاری نیاید به کار","ای دوست، هر سال زن جوانی اختیار کن؛ زیرا تقویم سال گذشته دیگر به کار نمی‌آید و اعتباری ندارد."],[180,"کسی را که بینی گرفتار زن","مکن سعدیا، طعنه بر وی مزن","ای سعدی، اگر دیدی کسی اسیر و دلباخته زنی شده، او را ملامت نکن و به او طعنه مزن؛"],[180,"تو هم جور بینی و بارش کشی","اگر یک سحر در کنارش کشی","زیرا تو هم اگر شبی تا صبح او را در آغوش بگیری، سحر زیبایی و محبتش می‌شوی و تمام ستم‌ها و سختی‌هایش را به جان خواهی خرید."],[181,"جوانی ز ناسازگاری جفت","بر پیرمردی بنالید و گفت","جوانی از ناسازگاری و بدخلقی همسرش، نزد پیرمردی باتجربه و دانا زبان به گلایه و ناله گشود و گفت:"],[181,"گران‌باری از دست این خصم چیر","چنان می‌برم کآسیاسنگ زیر","از دست این همسر چیره و سلطه‌جو چنان فشار و بار سنگینی را تحمل می‌کنم که درست مثل سنگ زیرین آسیاب شده‌ام (که پیوسته زیر فشار سنگ بالایی می‌ماند و خم به ابرو نمی‌آورد)"],[181,"به سختی بنه گفتش، ای خواجه، دل","کس از صبر کردن نگردد خجل","پیرمرد به او پاسخ داد: ای مرد، در برابر ناملایمات و سختی‌ها دل استوار دار و صبوری کن؛ چرا که هیچ‌کس از شکیبایی و بردباری پشیمان و شرمسار نمی‌شود."],[181,"به شب سنگ بالایی ای خانه‌سوز","چرا سنگ زیرین نباشی به روز؟","تو که شب‌ها در بستر کامروا و بالادستی (مانند سنگ بالایی آسیاب)، چرا روزها اهل مدارا و فروتنی نیستی تا مانند سنگ زیرین، سختی‌های زندگی و تندی او را تحمل کنی؟"],[181,"چو از گلبنی دیده باشی خوشی","روا باشد ار بار خارش کشی","وقتی از یک بوته گل سرخ لذت، زیبایی و عطر دیده‌ای، کاملا شایسته و منصفانه است که اگر خاری هم دارد، رنج آن خار را به جان بخری."],[181,"درختی که پیوسته بارش خوری","تحمل کن آنگه که خارش خوری","درختی را که همواره از میوه شیرینش سود می‌بری و می‌خوری، باید هنگامی هم که تیغ و خارش به دستت نشست، صبور باشی و رنجش را تحمل کنی."],[182,"پسر چون ز ده بر گذشتش سنین","ز نامحرمان گو فراتر نشین","وقتی پسر از دوران کودکی و نوجوانی عبور کرد، باید از نظر ارتباط با نامحرمان فاصله بگیرد و نسبت به آنها محتاط‌تر باشد."],[182,"بر پنبه آتش نشاید فروخت","که تا چشم بر هم زنی خانه سوخت","به خاطر نادانی و بی‌توجهی به چیزهای خطرناک، ممکن است اتفاقات بدی رخ دهد. باید مراقب بود و برای انجام کارها دقت و آگاهی داشت؛ در غیر این صورت، ممکن است همه‌چیز را از دست بدهیم."],[182,"چو خواهی که نامت بماند به جای","پسر را خردمندی آموز و رای","اگر می‌خواهی نام تو در یادها بماند، باید به پسر خود خرد و اندیشه (خردمندی) بیاموزی و او را به تفکر و تدبیر تربیت کنی."],[182,"که گر عقل و طبعش نباشد بسی","بمیری و از تو نماند کسی","اگر فرزندت نداشته باشد عقل و استعداد لازم را، هر چقدر هم که به او محبت کنی و او را بزرگ کنی، در نهایت از تو هیچ اثری به جا نمی‌ماند."],[182,"بسا روزگارا که سختی برد","پسر چون پدر نازکش پرورد","بسیاری از زمان‌ها، پسر به سختی‌های زیادی دچار می‌شود، همان‌طور که پدرش با ناز و لطف او را تربیت کرده است."],[182,"خردمند و پرهیزگارش بر آر","گرش دوست داری به نازش مدار","اگر می‌خواهی فرزندت خردمند و پرهیزگار باشد، باید او را به خوبی تربیت کنی و بیش از حد او را ناز نکنید تا در آینده نتواند از پس مشکلات برآید."],[182,"به خردی درش زجر و تعلیم کن","به نیک و بدش وعده و بیم کن","او را با حکمت و دانش، از طریق تنبیه و آموزش تربیت کن و به او وعده‌ و بیم بده تا نیک و بد را بشناسد."],[182,"نوآموز را ذکر و تحسین و زه","ز توبیخ و تهدید استاد به","برای یک دانش‌آموز تازه‌کار، ذکر و تحسین بهتر از تنبیه و تهدید است؛ زیرا تشویق و ستایش معلم می‌تواند تأثیر بیشتری در یادگیری او داشته باشد."],[182,"بیاموز پرورده را دسترنج","وگر دست داری چو قارون به گنج","به نوآموز یاد بده که زحمت و تلاش خودش را بیاموزد و اگر هم ثروتی مثل قارون دارد، نباید به آن اتکا کند."],[182,"مکن تکیه بر دستگاهی که هست","که باشد که نعمت نماند به دست","به دارایی و ثروتی که در اختیار داری تکیه نکن، زیرا ممکن است آن نعمت‌ها پایدار نباشند و از دست بروند."],[182,"به پایان رسد کیسه سیم و زر","نگردد تهی کیسه پیشه‌ور","اگر کیسه طلا و نقره به پایان برسد، کیسه کسی که حرفه و کار دارد، خالی نخواهد شد."],[182,"چه دانی که گردیدن روزگار","به غربت بگرداندش در دیار","چه می‌دانی که دوران زندگی به قدری تغییر می‌کند که او را به دوری و غربت می‌کشاند و در سرزمین‌های بیگانه قرار می‌دهد؟"],[182,"چو بر پیشه‌ای باشدش دسترس","کجا دست حاجت برد پیش کس؟","هر کسی که به کاری مشغول باشد و به آن تسلط پیدا کند، در چنین حالتی نباید دست نیاز به سوی دیگران دراز کند و از آن‌ها کمک بخواهد."],[182,"ندانی که سعدی مراد از چه یافت؟","نه هامون نوشت و نه دریا شکافت","سعدی به تو می‌گوید که ممکن است موضوعی را درک نکرده باشی؛ او نه درباره هامون (رودخانه‌ای در ایران) چیزی نوشته و نه درباره دریا توضیحی داده است."],[182,"به خردی بخورد از بزرگان قفا","خدا دادش اندر بزرگی صفا","سعدی می‌گوید که کسی که از بزرگان و فرزانگان درس بگیرد و آموزش ببیند، در بزرگسالی به او مقام و صفایی داده می‌شود."],[182,"هر آن کس که گردن به فرمان نهد","بسی بر نیاید که فرمان دهد","هر کسی که تسلیم فرمان دیگران شود، هرگز نخواهد توانست که خود فرمانروایی کند."],[182,"هر آن طفل کاو جور آموزگار","نبیند، جفا بیند از روزگار","هر کودکی که از آموزگار خود بدی ببیند و مورد بی‌مهری قرار گیرد، در طول زمان از روزگار نیز آسیب خواهد دید."],[182,"پسر را نکو دار و راحت رسان","که چشمش نماند به دست کسان","پسر را خوب تربیت کن و به او آرامش بده، تا حواسش به دست دیگران و مشکلات آنها معطوف نشود."],[182,"هر آن کس که فرزند را غم نخورد","دگر کس غمش خورد و بدنام کرد","اگر کسی نسبت به فرزندش احساس مسئولیت نکند و برای او نگران نباشد، دیگران نیز به غم و نگرانی او اهمیت نخواهند داد و در نهایت او را بدنام خواهند کرد."],[182,"نگه‌دار از آمیزگار بدش","که بدبخت و بی ره کند چون خودش","فرزندت را از دوستی با افراد بد و ناشایست دور نگه‌دار چون این افراد خودشان بدبخت و گمراه هستند و فرزند تو را نیز به همان حال درمی‌آورند."],[183,"شبی دعوتی بود در کوی من","ز هر جنس مردم در او انجمن","شبی در کوچه من مهمانی برپا بود و مردمان از هر قشر و نوعی در آنجا جمع شده بودند."],[183,"چو آواز مطرب در آمد ز کوی","به گردون شد از عاشقان های و هوی","زمانی که صدای موسیقی از کوی منتشر شد، عشق و شوق عاشقان به حدی بالا گرفت که به آسمان رفت."],[183,"پریچهره‌ای بود محبوب من","بدو گفتم ای لعبت خوب من","محبوب من چهره‌ای زیبا و مانند پری دارد. به او گفتم، ای دختر نازنین و زیبا."],[183,"چرا با رفیقان نیایی به جمع","که روشن کنی بزم ما را چو شمع؟","چرا به جمع دوستان نمی‌آیی تا مانند شمع، مجالس ما را نورانی کنی؟"],[183,"شنیدم سهی قامت سیم‌تن","که می‌رفت و می‌گفت با خویشتن","شنیدم که دختری با قامت بلند و اندام موزون، در حال راه رفتن خود را با نغمه‌ای زمزمه می‌کرد."],[183,"محاسن چو مردان ندارم به دست","نه مردی بود پیش مردان نشست","من محاسن (ریش و سبیل) مانند مردان ندارم و به همین دلیل هیچ زرنگی و مردانگی نیست که جلوی مردان بنشینم."],[183,"سیه نامه تر زآن مخنث مخواه","که پیش از خطش روی گردد سیاه","از آن جانی که رفتار زنانه دارد، آرزوی خوبی نداشته باش؛ زیرا پیش از اینکه با او خطا کنی، سیاهی و ناپاکی آن مشخص می‌شود."],[183,"از آن بی حمیت بباید گریخت","که نامردیش آب مردان بریخت","باید از انسانی که بی‌غیرت و نامرد است دوری کرد، زیرا بی‌غیرتی او باعث از بین رفتن شخصیت و مردانگی دیگران می‌شود."],[183,"پسر کاو میان قلندر نشست","پدر گو ز خیرش فرو شوی دست","پسر که به دلیل ناپاکی و بی‌فکری با گروهی بی‌اعتنا و بی‌فایده مثل قلندران نشست و در این مسیر از خوبی و نیکی پدرش دور شد، باید بدانید که دست خود را از خیر او خارج کنید."],[183,"دریغش مخور بر هلاک و تلف","که پیش از پدر مرده به ناخلف","او را بر مرگ و نابودی‌اش حسرت نخور، زیرا او قبل از پدرش (پدرش را به‌دلیل بدرفتاری) مرده و به شخص ناپسندی تبدیل شده است."],[184,"خرابت کند شاهد خانه کن","برو خانه آباد گردان به زن","هر چند که زیبایی و دلربایی معشوق می‌تواند ویران‌کننده باشد، اما بهتر است خود را از آن دور نگه‌داریم و به دنبال زندگی بهتر و مستحکم‌تری برویم."],[184,"نشاید هوس باختن با گلی","که هر بامدادش بود بلبلی","نباید با کسی که هر روز به سراغش می‌آید و مورد توجه دیگران قرار دارد، به هوس بازی و عشق ورزی پرداخت."],[184,"چو خود را به هر مجلسی شمع کرد","تو دیگر چو پروانه گردش مگرد","اگر خودت در هر جمعی مانند شمعی روشن شوی و به دیگران روشنی بدهی، دیگر مثل پروانه به دور کسی نچرخ که فقط می‌خواهد تو را جذب کند."],[184,"زن خوب خوش خوی آراسته","چه ماند به نادان نو خاسته؟","زن با شخصیت و نیکوکار و آراسته، در کنار نادانی که تازه به این دنیا آمده و از دانش بی‌بهره است، چه ارزشی خواهد داشت؟"],[184,"در او دم چو غنچه دمی از وفا","که از خنده افتد چو گل در قفا","اگر کسی به صفای دل و وفا نباشد، حتی اگر لحظه‌ای شاد و خندان باشد، زیبایی‌اش مانند گل‌هایی است که وقتی گلدهی می‌کنند، زود پژمرده می‌شوند و نمی‌توانند دائمی بمانند."],[184,"نه چون کودک پیچ بر پیچ شنگ","که چون مقل نتوان شکستن به سنگ","انسان نباید مانند کودک پیاپی و بی‌هدف بگردد، بلکه باید در رفتار خود استواری داشته باشد و در برابر موانع شکست‌ناپذیر باشد."],[184,"مبین دلفریبش چو حور بهشت","کز آن روی دیگر چو غول است زشت","زیبایی او مانند زیبایی حوری‌های بهشتی است، اما از طرفی چهره‌اش از سوی دیگر مانند غولی زشت و ناخوشایند به نظر می‌رسد."],[184,"گرش پای بوسی نداردت پاس","ورش خاک باشی نداند سپاس","اگر او (کسی که به زیبایی و دلفریبی حور بهشت می‌ماند) پای بوس تو هم نیست، باید به خاطر او خاک (تحمل) کنی، چرا که او ارزش سپاسگزاری را نمی‌داند."],[184,"سر از مغز و دست از درم کن تهی","چو خاطر به فرزند مردم نهی","اگر به خاطر خودت فرزند کسی را بی‌احترامی کنی، باید از آنچه که از مغز و دارائی‌ات داری، خالی شوی. یعنی باید هم از نظر فکری و هم از نظر مالی آماده باشی که عواقب این کار را تحمل کنی."],[184,"مکن بد به فرزند مردم نگاه","که فرزند خویشت برآید تباه","به فرزند دیگران بدی نکن، زیرا ممکن است فرزند خودت هم تحت تأثیر قرار بگیرد و دچار آسیب شود."],[185,"در این شهر باری به سمعم رسید","که بازارگانی غلامی خرید","در این شهر شایعه‌ای به گوشم رسید که بازرگانی، غلامی را خریده است."],[185,"شبانگه مگر دست بردش به سیب","که سیمین زنخ بود و خاطر فریب","در شب زمانی که دست او به سیبی رسید که زنخ‌دانش نقره‌ای بود و دل‌ربا بود."],[185,"پریچهره هرچ اوفتادش به دست","یکی در سر و مغز خواجه شکست","پریچهره، به معنی زیبای چهره، در هر فرصتی که به دست او بیفتد، در ذهن و فکر خواجه (شخص با مقام یا ثروتمند) اختلال و شکستی ایجاد می‌کند."],[185,"نه هر جا که بینی خطی دل فریب","توانی طمع کردنش در کتیب","هر جایی که خط زیبا و دل‌فریب ببینی، نباید به همین خاطر امیدوار باشی که بتوانی آن را به دست خود درآوری یا مالک آن شوی؛ یعنی نباید به ظاهر زیبایی آن تکیه کنی."],[185,"گوا کرد بر خود خدای و رسول","که دیگر نگردم به گرد فضول","او (شخصیت در شعر) به خود سوگند می‌خورد که دیگر به دنبال بحث‌های بی‌اساس و بی‌فایده نرود و به راه‌های غیرمعتبر توجه نکند."],[185,"رحیل آمدش هم در آن هفته پیش","دل افگار و سر بسته و روی ریش","در آن هفته، رحیل (سفر) به او رسید و او با دل غمگین و سر پوشیده و چهره‌ای پشمالو به سفر رفت."],[185,"چو بیرون شد از کازرون یک دو میل","به پیش آمدش سنگلاخی مهیل","وقتی او (رحیل) از کازرون خارج شد، یک یا دو میل جلوتر به سنگلاخی سخت و دشوار برخورد کرد."],[185,"بپرسید کاین قله را نام چیست؟","که بسیار بیند عجب هر که زیست","شخصی از دیگری پرسید که این قله (کوه) چه نامی دارد، زیرا هر کسی که به آن نگاه کند، از زیبایی و شگفتی آن شگفت‌زده می‌شود."],[185,"چنین گفتش از کاروان همدمی","مگر تنگ ترکان ندانی همی","دوست او از کاروان (گروه سفر) چنین گفت که آیا تو نمی‌دانی که تنگ ترکان (جایی در طبیعت) چیست؟"],[185,"برنجید چون تنگ ترکان شنید","تو گفتی که دیدار دشمن بدید","وقتی که او از زمین تنگ ترکان شکایت کرد، به نظر می‌رسد که او از شنیدن این خبر ناراحت شده و گویی دیدار با دشمن ناپسند است."],[185,"سیه را یکی بانگ برداشت سخت","که دیگر مران خر بینداز رخت","یکی از فعالان و بلکه افراد مؤثر در یک وضعیت یا مسأله، با صدای بلند هشدار داد که با توجه به شرایط، مبادا آن کس را از میان ببرید و توجیهی برای پاک کردن ماجرا پیش نگذارید."],[185,"نه عقل است و نه معرفت یک جوم","اگر من دگر تنگ ترکان روم","عقل و معرفت وجود ندارد، اگر من به جایی بروم که آنجا تنگ و باریک است و ترکان در آنجا هستند."],[185,"در شهوت نفس کافر ببند","وگر عاشقی لت خور و سر ببند","اگر شهوت نفس تو را به سمت کفر می‌کشاند، آن را مهار کن، و اگر عاشق هستی، باید سختی‌ها را تحمل کنی و سختی‌ها را در نظر بگیری."],[185,"چو مر بنده‌ای را همی پروری","به هیبت بر آرش کز او برخوری","اگر بنده‌ای را با وقار و عظمت تربیت کنی، از او به خوبی بهره‌مند خواهی شد."],[185,"وگر سیدش لب به دندان گزد","دماغ خداوندگاری پزد","اگر سرور و اربابش بر او خشمگین شود و دندانش را به لب بزند، باید خود را برای ابراز قدرت و مقام خداوندگار آماده کند."],[185,"غلام آبکش باید و خشت زن","بود بنده نازنین مشت زن","غلامی که آبکش می‌کند و در عین حال باید خشت‌زن هم باشد، یعنی کسی که خدمتگزار است، باید در برابر نازش و محبت آن کسی که او را دوست دارد، مطیع و فروتن باشد."],[185,"گروهی نشینند با خوش پسر","که ما پاکبازیم و صاحب نظر","عده‌ای با پسران نابالغ و زیبا روی نشست و برخاست می‌کنند و چون ایشان را به سبب این امر ملامت کنند ایشان گویند ما انسانهایی هستبم که به درجه‌ای از معرفت رسیده‌ایم که مرادمان ازین همنشینی با شاهدان و امردان خوبرو هواهای نفسانی نیست ‌و ما از این تهمت بری هستیم( شاهد بازی)"],[185,"ز من پرس فرسوده روزگار","که بر سفره حسرت خورد روزه‌دار","در این مورد (رجوع به معنی بیت بالا) از من که کارآزموده و جهان دیده هستم و عمر خویش را در فراز و نشیب روزگار گذرانده و این مطالب را دانسته (که این افراد نه از روی ادعای مشاهده جمال الهی که به سبب هواهای نفسانی است) که مثال این افراد مانند روزه‌داری است که بر سر سفره‌ای نشسته اما به سبب روزه‌داری نمی‌تواند از آن سفره طعامی بخورد و نصیبش حسرت است (یاد آور این مثال است که گربه دسترسی به گوست ندارد و الا از بوی آن شکایت نمی‌کرد)"],[185,"از آن تخم خرما خورد گوسپند","که قفل است بر تنگ خرما و بند","گوسفند از این جهت هسته خرما میخورد که بار خرما بسته‌بندی بسیار محکمی دارد و آن قفل و بسته است (و الا اگر به خرما دسترسی داشت که هسته آن را نمیخورد و این شاهد مثلی است برای بیت پیشین)"],[185,"سر گاو عصار از آن در که است","که از کنجدش ریسمان کوته است","این بیت هم از نظر معنی دقیقا مشابه بالایی است منتها با مثالی دیگر که گاوی که در عصاری کار می‌کند(جایی که از دانه‌های روغنی، روغن تهیه می‌کنند و قدیما گاو سنگی را که مانند آسیا برای این منظور استفاده می‌کنند را می‌چرخانده و برای آنکه بری غذا حواسش پرت نشود کیسه کاهی به گردنش می‌انداختند یا در مسیرش کاه که غذای اوست می‌ریختند تا برای غذا حواسش معطوف جای دیگری نشود و آن گاو نه آنکه نخواهد کنجد بخورد (آن محل معمولا برای گرفتن روغن از کنجد استفاده می‌شده) بلکه ریسمانی که در گردنش بسته شده مانع آن می‌شود وگرنه او دوست دارد که کنجد بخورد ولی آن طنابی که او را به آن بسته‌اند مانع می‌شود نه آنکه او نخواهد."],[186,"یکی صورتی دید صاحب جمال","بگردیدش از شورش‌ عشق حال","درویشی، انسانی زیبا را می‌بیند که عشق او را به شدت تحت تاثیر قرار داده و او را در حالتی از شور و هیجان قرار داده است."],[186,"بر انداخت بیچاره چندان عرق","که شبنم بر اردیبهشتی ورق","درویش بیچاره به حدی عرق ریخته که مانند شبنم روی برگ‌های بهشتی شده است."],[186,"گذر کرد بقراط بر وی سوار","بپرسید کاین را چه افتاده کار؟","بقراط، پزشک مشهور، در حینی که بر اسب سوار بود از کنار درویش گذشت و از او پرسید که چه بر سر او آمده است و چه مشکلی دارد."],[186,"کسی گفتش این عابد‌ی پارسا‌ست","که هرگز خطایی ز دستش نخاست","کسی به بقراط گفت که این عابد، فردی پرهیزکار و با تقواست که هیچ‌گاه مرتکب اشتباهی نمی‌شود."],[186,"رود روز و شب در بیابان و کوه","ز صحبت گریزان‌، ز مردم ستوه","انسانی که در بیابان و کوه زندگی می‌کند، روز و شب را می‌گذراند و از هم‌نشینی با مردم دوری می‌کند و از آن‌ها خسته شده است."],[186,"ربوده‌ست خاطر‌فریبی دلش","فرو رفته پای نظر در گلش","دل درویش به خاطر زیبایی و فریبندگی کسی مجذوب شده و تمام توجهش به آن زیبایی معطوف شده است تا جایی که در دام عشق او گرفتار شده و دیگر نمی‌تواند از آن خارج شود."],[186,"چو آید ز خلقش ملامت به گوش","بگرید که چند از ملامت‌؟ خموش","وقتی که ملامتی از جانب مردم به او می‌رسد، بی‌صدا می‌گرید و از خود می‌پرسد که چه فایده‌ای دارد که از ملامت شکایت کند."],[186,"مگوی ار بنالم که معذور نیست","که فریاد‌م از علتی دور نیست","نپرس که چرا راجه‌بر من شکایت می‌کنم، زیرا که صدای من ناشی از یک دلیل دور و غیرقابل کنترلی است."],[186,"نه این نقش دل می‌رباید ز دست","دل آن می‌رباید که این نقش بست","این تصویر یا نقش نمی‌تواند دل مرا برباید، بلکه آنچه دل را می‌رباید، چیزی است که با طراحی و خیال درست به وجود آمده است."],[186,"شنید این سخن مرد کار آزمای","کهنسال پرورده پخته‌رای","مردی با تجربه و صاحب‌نظر که سال‌ها در کار تعلیم و پرورش بوده، این سخن را شنید."],[186,"بگفت ار چه صیت نکویی رود","نه با هر کسی هر چه گویی رود","گفت، هرچند که نام نیکوی من به گوش می‌رسد، اما هر کس را نباید به هر چیزی که می‌گوید، اعتماد کرد."],[186,"نگارنده را خود همین نقش بود","که شوریده را دل به یغما ربود؟","آیا تنها جمال و زیبایی که خداوند خلق کرده‌است و نمودار جمال و حسن اوست همین پسران خوبروی خوش سیماست که هوش از سر آن درویش برده و او را مفتون کرده؟ در واقع گوید که این همه زیبایی‌های هستی همه نشان از صفت زیبایی خداوند است"],[186,"چرا طفل یک روزه هوشش نبرد؟","که در صنع دیدن چه بالغ چه خرد","اگر که واقعا در ادعای خود راستگو هستند پس چرا آن ظفل یک روزه که او هم مانند خوبرویان تجلی حسن و جمال الهی و مظهر جمال اوست، آن درویش هوسران را مدهوش نکرد که آن را هم خداوند خلق کرده و از زیبایی‌های خود در وجود او نهاده و اتفاقا این موجود بسیار خرد و کوچک سبب تحیر بیشتر می‌شود. برای آنکه در ادعای خود صادق است و از مشاهده مخلوقات به حسن خالق پی می‌برد همه هستی تجلی جمال و جلال الهی است. شیخ در یکی از قصائد خود که بسیار معروف است با این مطلع که بامدادان که تفاوت نکند لیل و نهار ... از آغاز این قصیده اشاره می‌کند که آفرینش همه تنبیه خداوند دل است و نیز اینهمه نقش عجب بر در و دیوار وجود. و در آن قصیده همه هستی را مظاهر زیبایی و جمال خالق کعرفی می‌کند و خلقت نارنج، برگ درختان سبز و،،، را در نظر هوشیار همه را هم سبب معرفت کردگار است)"],[186,"محقق همان بیند اندر ابل","که در خوبرویان چین و چگل","کسی که اهل تحقیق و معرفت شناس است در زیبایی و حسن خالق فرقی میان شتر و زیبا رویان منطقه چین و چگل تفاوتی نمی‌بیند و او تنها به خداوند توجه دارد و نه ظاهرپرستی و هوسرانی می‌کند"],[186,"نقابی است هر سطر من زین کتیب","فرو هشته بر عارضی دل فریب","هر سطر از نوشته‌های من مانند نقابی است که بر روی چهره‌ای جذاب و دل‌فریب افتاده است."],[186,"معانی است در زیر حرف سیاه","چو در پرده معشوق و در میغ ماه","معانی و مفهوم‌های پنهان در هر نوشته به اندازه‌ی الفاظ آن عمیق و باارزش است؛ مانند زیبایی‌های پنهان در چهره‌ی معشوق که در پس پرده و نور ماه نمایان می‌شوند."],[186,"در اوراق سعدی نگنجد ملال","که دارد پس پرده چندین جمال","در نوشته‌های سعدی نمی‌توان ملال و ناخوشی را دید، زیرا او پشت پرده معانی زیبا و بسیار جذابی را پنهان کرده است."],[186,"مرا کاین سخن‌هاست مجلس فروز","چو آتش در او روشنایی و سوز","این سخنان مانند یک مجلس روشنی است که در آن، مثل آتش، گرما و روشنی وجود دارد و باعث بیداری و آگاهی می‌شود."],[186,"نرنجم ز خصمان اگر بر تپند","کز این آتش پارسی در تبند","ناراحت نمی‌شوم از دشمنان اگر بر من بتازند، زیرا آتش عشق و دانش پارسی در وجودم می‌سوزد و شعله‌ور است."],[187,"اگر در جهان از جهان رسته‌ای است،","در از خلق بر خویشتن بسته‌ای است","اگر در این جهان، شخص ازجهان‌رسته‌ای هست؛ آن شخص کسی‌ست که با خلق ارتباطی ندارد."],[187,"کس از دست جور زبانها نرست","اگر خودنمای است و گر حق‌پرست","هیچ‌کس از آزار زبان‌ها و سخنان دیگران در امان نیست، چه آنکه خود را به نمایش بگذارد و چه کسی که اهل حق باشد و حق‌پرست باشد."],[187,"اگر بر پری چون ملک به آسمان","ز دامن در آویزدت بدگمان","اگر بر دختری زیبا مانند فرشته، که زندگی‌اش به خوبی پر از نعمت است، بیفتی و او برای تو نیکو رفتار نکند، نباید بدگمان شوی."],[187,"به کوشش توان دجله را پیش بست","نشاید زبان بداندیش بست","با تلاش و کوشش، می‌توان دجله را به مسیر درست هدایت کرد، اما نمی‌توان به زبان افرادی که بد اندیش هستند، محدودیت گذاشت."],[187,"فراهم نشینند تردامنان","که این زهد خشک است و آن دام نان","زاهدان سخت‌گیر و ریاکار به دور تو جمع می‌شوند، چون زهدی که فقط به فکر نان و روزی است، به دام می‌ماند و نتیجه‌ای از آن به دست نمی‌آید."],[187,"تو روی از پرستیدن حق مپیچ","بهل تا نگیرند خلقت به هیچ","از پرستش خدا روی بر نگردان، زیرا اگر چنین کنی، مردم نمی‌توانند تو را به خود بگیرند و تسلطی بر تو پیدا کنند."],[187,"چو راضی شد از بنده یزدان پاک","گر اینها نگردند راضی چه باک؟","اگر خدا از بنده‌اش راضی شود، نگران نیست که دیگران از او راضی نباشند."],[187,"بد اندیش خلق از حق آگاه نیست","ز غوغای خلقش به حق راه نیست","بدفکران مردم از حقیقت آگاهی ندارند و به خاطر شلوغی و حرف‌های مردم نمی‌توانند به راه حق دست پیدا کنند."],[187,"از آن ره به جایی نیاورده‌اند","که اول قدم پی غلط کرده‌اند","کسانی که در مسیر زندگی به جایی نرسیده‌اند، به این خاطر است که از همان ابتدا راه نادرستی را انتخاب کرده‌اند."],[187,"دو کس بر حدیثی گمارند گوش","از این تا بدان، ز اهرمن تا سروش","دو نفر بر یک موضوع خاص صحبت و گفتگو می‌کنند؛ یکی از شیطان تا فرشته، یعنی از بدی‌ها تا خوبی‌ها."],[187,"یکی پند گیرد دگر ناپسند","نپردازد از حرفگیری به پند","یک نفر از نصیحت‌ها بهره‌برداری می‌کند، در حالی که دیگری به نصیحت‌ها بی‌اعتنا است و از گفت‌وگو درباره آن‌ها دوری می‌کند."],[187,"فرو مانده در کنج تاریک جای","چه دریابد از جام گیتی نمای؟","کسی که در گوشه‌ای تاریک و دورافتاده نشسته است، چه چیزی می‌تواند از دنیای بزرگ و پرجنب‌وجوش بیرون ببیند و تجربه کند؟"],[187,"مپندار اگر شیر و گر روبهی","کز اینان به مردی و حیلت رهی","نگران نباش که اگر همانند شیر یا روباه باشی باز هم از مردانگی و قدرت یا با حیله و تدبیر، از قضاوت مردم نمیتونی فرار کنی"],[187,"اگر کنج خلوت گزیند کسی","که پروای صحبت ندارد بسی","اگر کسی در گوشه‌نشینی زندگی کند و از گفتگو با دیگران پرهیز کند، بی‌شک در آرامش خواهد بود."],[187,"مذمت کنندش که زرق است و ریو","ز مردم چنان می گریزد که دیو","اگر کسی در گوشه‌نشینی زندگی کند و از معاشرت با مردم دوری کند، دیگران او را به خاطر ظاهرش و رفتارهایی که به نظرشان فریبنده و نامناسب است، سرزنش می‌کنند و به او نسبت می‌دهند که از مردم فراری است، همان‌طور که دیوها از نور و مردم دوری می‌کنند."],[187,"وگر خنده روی است و آمیزگار","عفیفش ندانند و پرهیزگار","اگر کسی را خوش‌رویی و آمیختگی با زنان پاکدامن و پرهیزکار نشناسند، به او بی‌احترامی می‌شود."],[187,"غنی را به غیبت بکاوند پوست","که فرعون اگر هست در عالم اوست","فرد غنی و ثروتمند را کند و کاو میکنند و چنان میجویند که گویی اگر فرعونی در عالم وجود داشته باشد همان است"],[187,"وگر بینوایی بگرید به سوز","نگون بخت خوانندش و تیره‌روز","اگر انسان فقیر و needy‌ای به خاطر بدبختی‌اش گریه کند، او را به بدبختی و سیاهی روزگارش توصیف می‌کنند."],[187,"وگر کامرانی در آید ز پای","غنیمت شمارند و فضل خدای","اگر شخصی خوشبخت و موفقی از پا بیفتد، باید از آن به عنوان یک نعمت و لطف خداوند یاد کرد."],[187,"که تا چند از این جاه و گردن کشی؟","خوشی را بود در قفا ناخوشی","چند وقت دیگر می‌خواهی به این مقام و خودبزرگ‌بینی ادامه بدهی؟ خوشی واقعی در این است که در پس این خودستایی، ناراحتی و درد را بپذیری."],[187,"و گر تنگدستی تنک مایه‌ای","سعادت بلندش کند پایه‌ای","اگر کسی فقیر و بی‌چیز باشد، ممکن است همین فقر او را به مقام و سعادت بلندی برساند."],[187,"بخایندش از کینه دندان به زهر","که دون‌پرور است این فرومایه دهر","آدمی که از کینه و حسد دیگران می‌نالد، مانند کسی است که دندانش را در زهر فرو می‌کند؛ زیرا او در این دنیای پست و فرومایه پرورش یافته است."],[187,"چو بینند کاری به دستت در است","حریصت شمارند و دنیاپرست","وقتی که مردم ببینند که کاری به دست تو است، تو را حریص و دنیاطلب می‌پندارند."],[187,"وگر دست همت بداری ز کار","گدا پیشه خوانندت و پخته‌‌خوار","اگر همت و تلاش کنی و به کارهای سخت مشغول شوی، مردم تو را به عنوان کسانی که در پی منافع دیگران هستند و به ثروت‌طلبی افتاده‌اند، خواهد شناخت و تو را به عنوان یک گدا و بی‌سروپا به حساب می‌آورند."],[187,"اگر ناطقی، طبل پر یاوه‌ای","وگر خامشی، نقش گرماوه‌ای","اگر کسی سخن‌وری کند و حرف‌های بی‌محتوا بزند، و اگر کسی ساکت بماند، نقش و تصویر داغ و سوزان در ذهن دیگران ایجاد می‌کند."],[187,"تحمل‌کنان را نخوانند مرد","که بیچاره از بیم سر برنکرد","تحمل‌کنندگان را نمی‌توان مرد نامید، زیرا آن‌ها از ترس نمی‌توانند سرشان را بلند کنند."],[187,"وگر در سرش هول و مردانگی است","گریزند از او کاین چه دیوانگی است؟!","اگر در دل او ترس و غیرت وجود داشته باشد، مردم از او دور می‌شوند، چون این رفتار را حماقت و دیوانگی می‌دانند."],[187,"تعنت کنندش گر اندک خوری است","که مالش مگر روزی دیگری است","اگر کسی کم‌خورد به او اعتراض میکنند که مگر مال و ثروتش از آن دیگریست و از راه حرام بدست آورده است؟"],[187,"وگر نغز و پاکیزه باشد خورش","شکم بنده خوانند و تن پرورش","اگر غذا زیاد خورد و بنوشد، اعتراض میکنند که چرا این قدر تن پرست و بی موالات است"],[187,"وگر بی‌تکلف زید مالدار","که زینت بر اهل تمیز است عار","اگر چیزی به‌طور طبیعی و بدون نمایش ثروت به دست آید، وجود آن برای کسانی که در فقر به سر می‌برند، شرمندگی ندارد، زیرا ظاهرا زینت و تظاهر به دارایی مخصوص افراد با شعور و متمول است."],[187,"زبان در نهندش به ایذا چو تیغ","که بدبخت زر دارد از خود دریغ","اگر زبان را با آزار به کام خود بکشند، مانند شمشیری که به جان می‌زند، بدبختی کسی که ثروتی دارد، از خود رازی را می‌طلبد و از گفتن آن خودداری می‌کند."],[187,"و گر کاخ و ایوان منقش کند","تن خویش را کسوتی خوش کند","اگر انسان به زیبایی ظاهری خود بیفزاید و خود را با لباس‌های زیبا بپوشاند، به حقیقت، مانند یک کاخ و ایوان زینت‌یافته است."],[187,"به جان آید از طعنه بر وی زنان","که خود را بیاراست همچون زنان","بر او طعنه می‌زنند و به او اعتراض می‌کنند که چرا خود را مانند زنان آراسته کرده است، و این موضوع او را بسیار آزار می‌دهد."],[187,"اگر پارسایی سیاحت نکرد","سفر کردگانش نخوانند مرد","اگر کسی که پارسا و زاهد است، سفر نکند، مسافرانی که به دنیا گشت و گذار می‌کنند او را مرد نمی‌خوانند."],[187,"که نارفته بیرون ز آغوش زن","کدامش هنر باشد و رای و فن؟","هیچ‌کس که از آغوش همسرش بیرون نرفته باشد، نمی‌تواند هنرمند یا مدیر قدرتمندی باشد."],[187,"جهاندیده را هم بدرّند پوست","که سرگشته بخت‌برگشته اوست","این بیت اشاره دارد به اینکه حتی شخصی که جهان را دیده و تجربه‌های زیادی دارد، ممکن است مورد آزار و بی‌احترامی قرار بگیرد، زیرا وضعیت بد بختی و ناامیدی او باعث شده که در اوضاع نابسامان گرفتار باشد."],[187,"گرش حظ از اقبال بودی و بهر","زمانه نراندی ز شهرش به شهر","اگر خوش اقبالی نصیبش می‌شد و در هر زمانی به خاطر مشکلات، مجبور به ترک شهرش نمی‌شد، وضعیتش بهتر بود."],[187,"عزب را نکوهش کند خرده‌بین","که می‌رنجد از خفت و خیزش زمین","منتقدی که به همه چیز ایراد می‌گیرد به فرد مجرد و عزب نیز گیر میدهد چنانکه فکر میکند حتی زمین از خواب و خوراک آن فرد عذاب میبیند"],[187,"وگر زن کند گوید از دست دل","به گردن در افتاد چون خر به گل","اگر زن بگیرد و ازدواج کند میگوید دلش در دام عشق افتاده و گرفتارش کرده و مانند الاغی در گل گیر کرده است."],[187,"نه از جور مردم رهد زشت روی","نه شاهد ز نامردم زشت‌گوی","از بدی و ظلم مردم زشت‌رو دور نشو و از کسانی که به خاطر خودخواهی و بی‌ادبی به تو بی‌احترامی می‌کنند، فاصله بگیر."],[187,"غلامی به مصر اندرم بنده بود","که چشم از حیا در بر افکنده بود","غلامی در مصر بود که به من خدمت می‌کرد و بی‌شرمی‌اش باعث شده بود که حیا را کنار بگذارد."],[187,"کسی گفت: «هیچ این پسر عقل و هوش","ندارد، بمالش به تعلیم گوش»","کسی گفت: «این پسر هیچ شعور و درک ندارد، باید او را با روش آموزشی متمایز کرد و به او یاد داد."],[187,"شبی بر زدم بانگ بر وی درشت","هم او گفت: «مسکین به جورش بکشت!»","شبی صدای بلندی بر او زدم و با لحن تند و جدی صحبت کردم، ولی او در جواب گفت: «این مسکین با زجری که تحمل می‌کند، به زودی خواهد مرد!"],[187,"گرت برکند خشم روزی ز جای","سراسیمه خوانندت و تیره رای","اگر روزی خشم تو را از جا برکند، مردم به سرعت تو را با ناپسندی و بدفکری خواهند شناخت."],[187,"وگر بردباری کنی از کسی","بگویند غیرت ندارد بسی","اگر صبر و تحمل به خرج دهی و از کسی شکایت کنی، به تو خواهند گفت که غیرت و شرافت نداری."],[187,"سخی را به اندرز گویند: «بس!","که فردا دو دستت بود پیش و پس»","به سخن نیکو می‌گویند به کسی که سخاوتمند است: برای فردا اندیشه کن، زیرا در آن روز ممکن است دستت به سمت جلو و عقب باشد، یعنی ممکن است نیاز به کمک و حمایت دیگران داشته باشی."],[187,"وگر قانع و خویشتن‌دار گشت","به تشنیع خلقی گرفتار گشت","اگر آدمی قانع و با خودساخته شود، در برابر سرزنش مردم به راحتی خواهد گذشت."],[187,"که همچون پدر خواهد این سفله مرد","که نعمت رها کرد و حسرت ببرد","این شخص مانند پدری است که در حسرت زندگی بی‌نصیب و در غم از دست دادن نعمت‌ها می‌میرد، زیرا که تن به ذلت داده و از خوبی‌ها کناره‌گیری کرده است."],[187,"که یارد به کنج سلامت نشست؟","که پیغمبر از خبث ایشان نرست","چه کسی می‌تواند در گوشه‌نشینی آرامش پیدا کند، در حالی که پیغمبر نیز از بدی‌های این مردم فرار کرده است؟"],[187,"خدا را که مانند و انباز و جفت","ندارد، شنیدی که ترسا چه گفت؟","خداوندی را که هیچ شبیه و همتایی ندارد، آیا نشنیده‌ای که ترسا (مسیحی) چه سخنی گفته است؟"],[187,"رهایی نیابد کس از دست کس","گرفتار را چاره صبر است و بس","هیچ‌کس نمی‌تواند از دست دیگران نجات پیدا کند و تنها راه حل برای کسانی که در درد و رنج هستند، صبر کردن است."],[188,"جوانی هنرمند فرزانه بود","که در وعظ چالاک و مردانه بود","جوان هنرمند، دانا و خردمندی بود که در سخنوری و موعظه کردن بسیار چابک، مسلط و شجاعانه رفتار می‌کرد."],[188,"نکونام و صاحبدل و حق پرست","خط عارضش خوشتر از خطّ دست","خوش‌نام، اهل معرفت و خداپرست بود؛ زیبایی موی صورت و چهره‌اش از بهترین خطوط خوش‌نویسی نیز زیباتر بود."],[188,"قوی در بلاغات و در نحو چست","ولی حرف ابجد نگفتی درست","در فنون بلاغت و سخن‌دانی بسیار توانا و در قواعد دستور زبان (نحو) ماهر بود، اما حروف الفبا را درست تلفظ نمی‌کرد (نقص گفتاری یا لکنت زبان داشت)."],[188,"یکی را بگفتم ز صاحبدلان","که دندان پیشین ندارد فلان","من به یکی از اهل دل و عارفان از سر عیب‌جویی گفتم: فلان جوان دندان جلو ندارد (و به همین دلیل نقصی در بیانش هست)."],[188,"برآمد ز سودای من سرخ روی","کز این جنس بیهوده دیگر مگوی","آن مرد دانا از سخن و فکر باطل من خشمگین شد، چهره‌اش سرخ گردید و گفت: دیگر از این حرف‌های بیهوده و ناپسند نزن!"],[188,"تو در وی همان عیب دیدی که هست","ز چندان هنر، چشم عقلت ببست؟","آیا تو در وجود او فقط همان نقصی را دیدی که آشکار بود، و چشم خردت را بر آن‌همه کمال و هنر فرو بستی؟"],[188,"یقین بشنو از من که روز یقین","نبینند بد، مردم نیک بین","این سخن را با اطمینان کامل از من بپذیر که در روز رستاخیز (روز یقین)، انسان‌های نیک‌نگر و پاک‌چشم جز نیکی و خیر نخواهند دید."],[188,"یکی را که فضل است و فرهنگ و رای","گرش پای عصمت بخیزد ز جای","اگر انسانی دانا، بافرهنگ و صاحب‌نظر، ناخواسته دچار لغزشی شد و پای پاک‌دامنی‌اش لغزید،"],[188,"به یک خرده مپسند بر وی جفا","بزرگان چه گفتند؟ خذ ما صفا","به خاطر یک خطای کوچک بر او ظلم و خرده‌گیری روا مدار؛ مگر بزرگان نگفته‌اند: «آنچه زلال و پاک است برگیر (و ناپاکی را رها کن)»؟"],[188,"بود خار و گل با هم ای هوشمند","چه در بند خاری؟ تو گل دسته بند","ای انسان خردمند، گل و خار همیشه در کنار هم هستند؛ چرا تمام توجهت به خار است؟ تو گل‌ها را بچین و دسته‌گل فراهم کن."],[188,"که را زشت خویی بود در سرشت","نبیند ز طاووس جز پای زشت","کسی که بدطینتی و عیب‌جویی در ذات او نهفته است، از طاووس با آن‌همه زیبایی، جز پاهای بدترکیبش چیزی نمی‌بیند."],[188,"صفایی به دست آور ای خیره روی","که ننماید آیینه تیره، روی","ای انسان گستاخ، درون خود را پاک و صیقلی کن؛ زیرا آیینه کدر و زنگارگرفته هرگز نمی‌تواند چهره را بازتاب دهد."],[188,"طریقی طلب کز عقوبت رهی","نه حرفی که انگشت بر وی نهی","راهی پیدا کن که خودت از عذاب الهی نجات یابی، نه این‌که مدام دنبال سخن یا بهانه‌ای بگردی تا بر آن انگشت بگذاری و عیب‌جویی کنی."],[188,"منه عیب خلق ای خردمند، پیش","که چشمت فرو دوزد از عیب خویش","ای خردمند، عیوب مردم را پیش چشم خود مگذار؛ زیرا عیب‌جویی از دیگران باعث می‌شود عیب‌های درونی خودت را نبینی."],[188,"چرا دامن آلوده را حد زنم","چو در خود شناسم که تر دامنم؟","چرا باید شخص گناهکار را مؤاخذه و مجازات کنم، در حالی که می‌دانم خود من نیز به گناه و لغزش آلوده‌ام؟"],[188,"نشاید که بر کس درشتی کنی","چو خود را به تأویل پشتی کنی","شایسته نیست با دیگران به تندی و درشتی برخورد کنی، در حالی که گناهان و خطاهای خودت را با توجیه و بهانه‌تراشی ماست‌مالی می‌کنی."],[188,"چو بد ناپسند آیدت خود مکن","پس آنگه به همسایه گو بد مکن","اگر کار بد به نظرت زشت است، ابتدا خودت از آن دوری کن؛ آنگاه به دیگران بگو که کار بد نکنند."],[188,"من ار حق شناسم وگر خود نمای","برون با تو دارم، درون با خدای","اگر من واقعا خداشناس باشم یا فردی ریاکار و متظاهر، ظاهر من به تو مربوط است اما درون و نیت دلم با پروردگار است."],[188,"چو ظاهر به عفّت بیاراستم","تصرّف مکن در کژ و راستم","وقتی ظاهر اعمال من پاکیزه و محترمانه است، تو در پنهان من و درستی و نادرستی باطنم دخالت و قضاوت نکن."],[188,"اگر سیرتم خوب و گر منکر است","خدایم به سرّ، از تو داناتر است","باطن من چه نیکو باشد و چه ناپسند و زشت، پروردگار من بر اسرار درونم از تو بسیار داناتر و آگاه‌تر است."],[188,"تو خاموش اگر من بهم یا بدم","که حمّال سود و زیان خودم","تو سکوت پیشه کن، چه من آدم خوبی باشم و چه بد؛ زیرا بار سود و زیان کارهایم بر دوش خود من است نه تو."],[188,"کسی را به کردار بد کن عذاب","که چشم از تو دارد به نیکی ثواب","فقط کسی را به‌خاطر رفتار بدش مجازات و بازخواست کن که در ازای کار نیکش، از تو انتظار پاداش و مزد داشته باشد."],[188,"نکو کاری از مردم نیک رای","یکی را به ده می‌نویسد خدای","خداوند برای یک کار نیک انسان خوش‌نیت، ده برابر پاداش ثبت می‌کند."],[188,"تو نیز ای عجب هر که را یک هنر","ببینی، ز ده عیبش اندر گذر","بسیار شگفت‌انگیز است که اگر در کسی حتی یک هنر و نقطه مثبت می‌بینی، باز هم حاضر نیستی از ده خطای او چشم‌پوشی کنی."],[188,"نه یک عیب او را بر انگشت پیچ","جهانی فضیلت بر آور به هیچ","نه اینکه همان یک عیب کوچک او را دستاویز ملامت کنی و با این کار، دنیایی از فضل، دانش و کمال او را پوچ و بی‌ارزش بشماری."],[188,"چو دشمن که در شعر سعدی، نگاه","به نفرت کند ز اندرون تباه","درست مثل دشمن بدخواهی که از روی بدطینتی و فساد باطن، به شعر سعدی با بغض و نفرت نگاه می‌کند،"],[188,"ندارد به صد نکته نغز، گوش","چو زحفی ببیند بر آرد خروش","به صدها نکته لطیف، پرمحتوا و زیبای شعر گوش نمی‌دهد، اما اگر یک لغزش عروضی یا شکست وزنی ببیند، فریاد اعتراض سر می‌دهد."],[188,"جز این علّتش نیست کان بد پسند","حسد دیده نیک بینش بکند","دلیل این رفتار آن بدپسند چیزی نیست جز اینکه آتش حسادت، چشم زیباپسند و منصف او را از ریشه کور کرده است."],[188,"نه مر خلق را صنع باری سرشت؟","سیاه و سپید آمد و خوب و زشت","مگر نه اینکه همه آفرینش ساخته دست پروردگار است؟ به همین دلیل در جهان تنوع وجود دارد؛ هم سیاه و سپید هست و هم زیبا و نازیبا."],[188,"نه هر چشم و ابرو که بینی نکوست","بخور پسته مغز و بینداز پوست","هر چشم و ابرویی که می‌بینی بی‌عیب و کامل نیست؛ تو مغز پسته را بخور و پوست سختش را دور بینداز (کمالات و محاسن افراد را برگیر و عیوب و کاستی‌هایشان را نادیده بگیر)."],[189,"نفس می‌نیارم زد از شکر دوست","که شکری ندانم که در خورد اوست","من نمی‌توانم نفس بکشم و از شکر دوستی لذت ببرم، چرا که نمی‌دانم این شکر در بدن او وجود دارد یا در من."],[189,"عطایی است هر موی از او بر تنم","چگونه به هر موی شکری کنم؟","هر مویی از بدن من نشانه‌ای از عطا و بخشش او (دوست) است، بنابراین چگونه می‌توانم برای هر یک از این موی‌ها شکرگزاری جداگانه داشته باشم؟"],[189,"ستایش خداوند بخشنده را","که موجود کرد از عدم بنده را","به ستایش پروردگار بخشنده‌ای می‌پردازد که از هیچ، بنده‌اش را آفریده است."],[189,"که را قوت وصف احسان اوست؟","که اوصاف مستغرق شأن اوست","هیچ‌کس نمی‌تواند توانایی وصف احسان خداوند را داشته باشد، چراکه این صفات به‌قدری عظیم و فراگیر هستند که فراتر از درک بشرند."],[189,"بدیعی که شخص آفریند ز گل","روان و خرد بخشد و هوش و دل","شخصی که می‌تواند دنیای زیبا و دلنشینی را از مواد طبیعی مانند گل بسازد، قادر است ذهن و دل دیگران را نیز با آن زیبایی پر کند."],[189,"ز پشت پدر تا به پایان شیب","نگر تا چه تشریف دادت ز غیب","به مدت زمانی که از دوران پیش از تولد تا پایان عمرت را نگاه کن و ببین که چه نعمت‌ها و مقام‌هایی به تو از طرف غیب (خداوند) اعطا شده است."],[189,"چو پاک آفریدت بهش باش و پاک","که ننگ است ناپاک رفتن به خاک","وقتی که تو را به‌صورت پاک آفریده‌اند، شایسته است که با خوبی و پاکی زندگی کنی، زیرا ننگ است که ناپاک به خاک برگردی."],[189,"پیاپی بیفشان از آیینه گرد","که مصقل نگیرد چو زنگار خورد","مدام از آینه گرد و غبار بریز که اگر زنگار بگیرد، دیگر تمیز نخواهد شد."],[189,"نه در ابتدا بودی آب منی؟","اگر مردی از سر به در کن منی","آیا در آغاز وجود نداشتی که آب من باشی؟ اگر مرد هستی، از ابتدا به خودآگاهی برس و خود را نشان بده."],[189,"چو روزی به سعی آوری سوی خویش","مکن تکیه بر زور بازوی خویش","هرگاه که می‌خواهی به هدفی دست یابی، بر قدرت بازوی خود تکیه نکن و تنها به آن اکتفا نکن."],[189,"چرا حق نمی‌بینی ای خودپرست","که بازو به گردش درآورد و دست؟","ای خودخواه، چرا متوجه نمی‌شوی که توانایی و نیروی جسمی‌ات تو را به جایی نمی‌رساند و این نعمت‌ها تنها با کمک و اراده خداوند به دست می‌آید؟"],[189,"چو آید به کوشیدنت خیر پیش","به توفیق حق دان نه از سعی خویش","وقتی که خیر و نیکی به سعی و تلاش تو می‌رسد، بدان که این موفقیت ناشی از کمک و توفیق خداست و نه تنها به خاطر کوشش خودت."],[189,"به سرپنجگی کس نبرده‌ست گوی","سپاس خداوند توفیق گوی","هیچ‌کس به مرحله‌ای نرسیده که بتواند به تنهایی و بدون کمک خداوند، سپاسگزار توفیق‌هایی که به او داده می‌شود، باشد."],[189,"تو قائم به خود نیستی یک قدم","ز غیبت مدد می‌رسد دم به دم","تو به‌تنهایی مستقل و پایدار نیستی و هر لحظه که در غیبت کسی هستی، از او کمک و یاری می‌گیری."],[189,"نه طفل زبان بسته بودی ز لاف؟","همی روزی آمد به جوفش ز ناف","آیا تو کودک زبان‌داده‌ای بودی که دروغ بگویی؟ روزی هم می‌رسد که از زادگاهت به درونت می‌رسد."],[189,"چو نافش بریدند و روزی گسست","به پستان مادر در آویخت دست","وقتی که بند نافش را بریدند و روزی از مادری جدا شد، دستش را به سمت پستان مادر دراز کرد."],[189,"غریبی که رنج آردش دهر پیش","به دارو دهند آبش از شهر خویش","بیگانه‌ای که در زندگی با مشکلات روبروست، دارویی به او می‌دهند که از شهر خودش است."],[189,"پس او در شکم پرورش یافته‌ست","ز انبوب معده خورش یافته‌ست","پس او در شکم مادر پرورش یافته و از طریق روده‌ها غذا دریافت کرده است."],[189,"دو پستان که امروز دلخواه اوست","دو چشمه هم از پرورشگاه اوست","این بیت به ارتباط عاطفی و جسمی کودک با مادر اشاره دارد. دو پستان مادر که امروزه برای او cherished و مورد علاقه است، در واقع نماد تغذیه و پرورش او از دوران نوزادی هستند و نشان‌دهنده وابستگی و رشد او در آغوش مادر است."],[189,"کنار و بر مادر دلپذیر","بهشت است و پستان در او جوی شیر","محل و آرامگاه مادر بهشت را در کنار خود می‌داند و شیر در پستان او جاری است."],[189,"درختی است بالای جان پرورش","ولد میوه نازنین بر برش","درختی در بالای جان وجود دارد که فرزندی را پرورش می‌دهد و میوه نازش را بر روی آن می‌آورد."],[189,"نه رگ‌های پستان درون دل است؟","پس ار بنگری شیر خون دل است","دل، به مانند پستان، رگ‌هایی دارد که به آن حیاتی می‌دهد. بنابراین اگر به آن بنگری، شیر (عصاره و سود) آن به واقع همان خون دل است که به درون می‌ریزد."],[189,"به خونش فرو برده دندان چو نیش","سرشته در او مهر خون‌خوار خویش","این بیت به این معناست که او (که می‌تواند یک شیر یا هر جانور دیگری باشد) با دندانی تیز و نیش‌مانند، گوشت و خون قربانی خود را می‌گزد و در واقع، مهر و عشق خود را با این عمل، به شکل خون‌خوارانه و ویرانگر نشان می‌دهد."],[189,"چو بازو قوی کرد و دندان ستبر","براندایدش دایه پستان به صبر","وقتی که کودک به حدی قوی می‌شود که می‌تواند با بازو و دندانش بر دیگران تسلط یابد، دایه (مادر) باید با صبوری پستان خود را از او دور کند."],[189,"چنان صبرش از شیر خامش کند","که پستان شیرین فرامش کند","صبر او به قدری قوی است که می‌تواند او را از شیر مادر دور کند، طوری که طعم شیر شیرین را فراموش کند."],[189,"تو نیز ای که در توبه‌ای طفل راه","به صبرت فراموش گردد گناه","ای تو که در حال توبه‌ای، مانند یک کودک، راه صبر را فراموش کرده‌ای و گناهانت را نادیده می‌انگاری."],[190,"جوانی سر از رای مادر بتافت","دل دردمندش به آذر بتافت","جوانی از تصمیم مادرش سرپیچی کرد و دلش به عشق آتشین و دردناک عشق سوخت."],[190,"چو بیچاره شد پیشش آورد مهد","که ای سست مهر فراموش عهد","وقتی او در برابرش (مادر) بیچاره و درمانده شد، به او گفت: ای بی‌وفا، عهد قدیم را فراموش کردی؟"],[190,"نه گریان و درمانده بودی و خرد","که شبها ز دست تو خوابم نبرد؟","تو نه آنقدر گریان و درمانده بودی که خواب را از من بگیری، پس چگونه شب‌ها نمی‌توانستم بخوابم؟"],[190,"نه در مهد نیروی حالت نبود","مگس راندن از خود مجالت نبود؟","در زمانی که تو هنوز در مهد و نوزادی بودی، نیرویی برای راندن مگس از خودت نداشتی و نمی‌توانستی این کار را انجام دهی."],[190,"تو آنی کز آن یک مگس رنجه‌ای","که امروز سالار و سرپنجه‌ای","تو همان کسی هستی که به خاطر یک مگس رنج می‌کشی، در حالی که امروز در موقعیتی بزرگ و قدرتمند قرار داری."],[190,"به حالی شوی باز در قعر گور","که نتوانی از خویشتن دفع مور","به حالتی خواهی رسید که در قعر گور قرار می‌گیری و دیگر قادر نخواهی بود از زحمت‌ها و مشکلات خود فرار کنی."],[190,"دگر دیده چون برفروزد چراغ","چو کرم لحد خورد پیه دماغ؟","دیگر چشم، چگونه چراغ بینایی را برافروزد و توانایی دیدن داشته باشد زمانی که کرم لحد مغز را خورده باشد."],[190,"چو پوشیده چشمی ببینی که راه","نداند همی وقت رفتن ز چاه","اگر کسی چشمی بسته داشته باشد و نبیند، نمی‌داند که در چه راهی است و ممکن است به دام بیفتد."],[190,"تو گر شکر کردی که با دیده‌ای","وگر نه تو هم چشم پوشیده‌ای","اگر شکر می‌کنی که توانسته‌ای به حقایق با چشم خود نگاه کنی، پس اگر این امکان را نداشتی، تو هم مانند دیگرانی می‌شوی که بینایی ندارند و نمی‌توانند حقیقت را ببینند."],[190,"معلم نیاموختت فهم و رای","سرشت این صفت در نهادت خدای","فهم و درک تو به‌طور طبیعی در وجودت هست و معلم به تو نیاموخته است، بلکه این خاصیت از جانب خدا در نهاد تو قرار داده شده است."],[190,"گرت منع کردی دل حق نیوش","حقت عین باطل نبودی به گوش","اگر دل‌ات را از شنیدن حق بازداری، حق به‌طور واضح در گوش تو به عین باطل نخواهد رسید."],[191,"ببین تا یک انگشت از چند بند","به صنع الهی به هم در فگند","نگاه کن که چگونه یک انگشت از چند بند (برخی اجزای بدن) به آفرینش الهی پیوسته و متصل است."],[191,"پس آشفتگی باشد و ابلهی","که انگشت بر حرف صنعش نهی","شخصی که به کارهای خداوند در آفرینش توجه نکند و فقط به ابعاد جزیی آن بپردازد، دچار آشفتگی و نادانی است."],[191,"تأمل کن از بهر رفتار مرد","که چند استخوان پی زد و وصل کرد","به رفتار انسان خوب توجه کن؛ او چندین استخوان را به هم متصل کرده و بدن را شکل داده است."],[191,"که بی گردش کعب و زانو و پای","نشاید قدم بر گرفتن ز جای","برای این‌که کسی بتواند از جایی حرکت کند و قدم بردارد، باید پا و زانو و کعبه‌اش حرکت کند و در واقع، بدون این حرکت‌ها، ایستادن و ادامه‌دادن در یک مکان ممکن نیست."],[191,"از آن سجده بر آدمی سخت نیست","که در صلب او مهره یک لخت نیست","سجده کردن بر آدم (انسان) دشوار نیست، زیرا در وجود او تنها یک تکه از مهره نیست که بر آن تکیه کند، بلکه او ترکیبی از اجزای مختلف است."],[191,"دو صد مهره بر یکدگر ساخته‌ست","که گل مهره‌ای چون تو پرداخته‌ست","انسان از دوصد مهره یا جزء مختلف شکل گرفته است که هر کدام به دقت بر روی یکدیگر قرار گرفته‌اند. این ترکیب پیچیده و هنرمندانه به گونه‌ای است که زیبایی و ارزش وجودی او، همچون یک مهره‌ی ارزشمند، خلق شده است."],[191,"رگت بر تن است ای پسندیده خوی","زمینی در او سیصد و شصت جوی","در وجود تو، ای انسان با نیکوकारी، رگ‌ها و عروق متعددی وجود دارد که به تعداد سیصد و شصت عدد است و به طور متعارف در بدن انسان گردش می‌کنند."],[191,"بصر در سر و فکر و رای و تمیز","جوارح به دل، دل به دانش عزیز","چشم، سر، فکر، رای و عقل از اعضای بدن هستند و همه اینها به دل وابسته‌اند. دل هم باید به علم و دانش باارزش وابسته باشد."],[191,"بهایم به روی اندر افتاده خوار","تو همچون الف بر قدمها سوار","حیوانات من در اینجا در برابر تو پایین آمده و خوار شده‌اند، مانند الف که بر روی پاها سوار است."],[191,"نگون کرده ایشان سر از بهر خور","تو آری به عزت خورش پیش سر","این بیت به این معناست که در برابر خوراکی که تو (خدا) به انسان می‌دهی، آنها (بهایم و دیگر موجودات) به خاطر این نعمت و عزت حاصل از آن، سر خود را به تو تسلیم کرده‌اند. یعنی موجودات دیگر به خاطر غذایی که از تو می‌گیرند، به عزت و مقام تو افتخار می‌کنند."],[191,"نزیبد تو را با چنین سروری","که سر جز به طاعت فرود آوری","نمی‌تواند تو را چنین مقام و بزرگ‌مردی سزاوار باشد، اگر سر خود را فقط به اطاعت و فرمان‌برداری فرود نیاوری."],[191,"به انعام خود دانه دادت نه کاه","نکردت چو انعام سر در گیاه","خداوند با نعمت‌های خود به تو غذا (دانه) عطا کرده است نه چیز بی‌ارزشی مثل کاه، بنابراین سر (فکر و توجه)‌ات را در گیاهان (و دنیای مادی) مشغول نکن."],[191,"ولیکن بدین صورت دلپذیر","فرفته مشو، سیرت خوب گیر","اما با این ظاهر خوشایند فریب نخور، بلکه روح و سیرت نیکو را در خود پرورش بده."],[191,"ره راست باید نه بالای راست","که کافر هم از روی صورت چو ماست","انسان باید در مسیر درست زندگی کند، نه فقط در ظواهر و شکل ظاهری. زیرا حتی کافران نیز می‌توانند از نظر ظاهری شبیه ما باشند، اما مهم Sیرت و باطن انسان است."],[191,"تو را آن که چشم و دهان داد و گوش","اگر عاقلی در خلافش مکوش","آنکه به تو چشم، دهان و گوش عطا کرده، خداوند است؛ اگر عاقل هستی، در مقابل اراده او ایستادگی نکن و به مخالفانش نپیوند."],[191,"گرفتم که دشمن بکوبی به سنگ","مکن باری از جهل با دوست جنگ","اگر می‌خواهی دشمن را به زحمت بیندازی و او را محکوم کنی، نباید به خاطر نادانی با دوست خود درگیر شوی و به او آزار برسانی."],[191,"خردمند طبعان منت شناس","بدوزند نعمت به میخ سپاس","خردمندان با طبع خوب و فهم عمیق قدردانی را می‌شناسند و به پاس نعمت‌هایی که دارند، باید به سپاس‌گزاری از آن‌ها بپردازند."],[192,"ملک زاده‌ای ز اسب ادهم فتاد","به گردن درش مهره بر هم فتاد","ملک‌زاده‌ای که سوار بر اسب سیاه (ادهم) بود، بر اثر حادثه‌ای افتاد و گردن او به زمین برخورد کرد و مهره‌های گردنش جابه‌جا شد."],[192,"چو پیلش فرو رفت گردن به تن","نگشتی سرش تا نگشتی بدن","چون بدنش به زیر گردن پیل (فیل) فرورفت، سرش از تن جدا نشد تا اینکه بدنش هم به این حالت درآمد."],[192,"پزشکان بماندند حیران در این","مگر فیلسوفی ز یونان زمین","پزشکان در این حالت شگفت‌زده مانده‌اند، مگر اینکه فیلسوفی از یونان این موضوع را تبیین کند."],[192,"سرش باز پیچید و رگ راست شد","وگر وی نبودی زمن خواست شد","سر او دوباره به حالت طبیعی برگشت و رگش (رگ راست، مربوط به سلامتی) دوباره به حالت عادی درآمد و اگر او (پزشک یا فیلسوفی که در تصویر است) نبود، من از او درخواست کمک می‌کردم."],[192,"دگر نوبت آمد به نزدیک شاه","به عین عنایت نکردش نگاه","شاه، در نوبت بعدی، با بزرگی و عنایت به او توجه نکرد و نظری به او نینداخت."],[192,"خردمند را سر فرو شد به شرم","شنیدم که می‌رفت و می‌گفت نرم","سخن از خردمندی است که به خاطر شنیدن سخنی از کسی، سرش را به نشانه احترام و شرم پایین آورده و به آرامی از آنجا می‌رود و چیزی می‌گوید."],[192,"اگر دی نپیچیدمی گردنش","نپیچیدی امروز روی از منش","اگر دی (دیروز) به او سخت می‌گفتم و او را عذاب می‌دادم، امروز (امروز) نمی‌توانست از من روی بگرداند و از من دور شود."],[192,"فرستاد تخمی به دست رهی","که باید که بر عودسوزش نهی","تخمی به دست یک فرد راهنما داده شده که باید آن را در عودسوز (محل سوختن عود) قرار دهد. این بیت به نوعی اشاره به کار درست و تأثیرگذاری بر فرآیندها دارد."],[192,"ملک را یکی عطسه آمد ز دود","سر و گردنش همچنان شد که بود","ملک به خاطر دود دچار عطسه شد و سر و گردنش مانند قبل باقی ماند."],[192,"به عذر از پی مرد بشتافتند","بجستند بسیار و کم یافتند","همه به دنبال مردی رفتند و عذر او را خواستند، اما سعی و تلاش زیادشان بی‌نتیجه بود و او را به سختی پیدا کردند."],[192,"مکن، گردن از شکر منعم مپیچ","که روز پسین سر بر آری به هیچ","از شکر نعمت‌های الهی سرپیچی نکن و گردن خود را از آن خالی نکن؛ زیرا روزی که از دنیا بروی، هیچ چیزی از تو به جا نخواهد ماند."],[192,"شنیدم که پیری پسر را به خشم","ملامت همی کرد کای شوخ چشم","پیرمردی پسرش را به خاطر رفتارهایش که بد و بی‌محابا هستند سرزنش می‌کند و می‌گوید که تو خیلی پررو و اهل شر و شیطنت هستی."],[192,"تو را تیشه دادم که هیزم شکن","نگفتم که دیوار مسجد بکن","من به تو تیشه‌ای دادم تا هیزم بشکنی، نه اینکه به کار تخریب دیوار مسجد بپردازی."],[192,"زبان آمد از بهر شکر و سپاس","به غیبت نگرداندش حق شناس","زبان آمده تا شکر و سپاس خدا را بگوید، نه اینکه به غیبت دیگران بپردازد. کسی که حقیقتا شکرگزار است، نباید زبانش به غیبت دیگران مشغول شود."],[192,"گذرگاه قرآن و پند است گوش","به بهتان و باطل شنیدن مکوش","گذرگاه قرآن و نصیحت است، یعنی باید به مفاهیم صحیح و آموزه‌های دینی توجه کرد و به شایعات و سخنان غلط گوش نداد."],[192,"دو چشم از پی صنع باری نکوست","ز عیب برادر فرو گیر و دوست","اگر بخواهی نعمت‌های خداوند را به درستی بشناسی و شکرگزار باشی، باید از عیب‌جویی و طعنه به برادران خود دوری کنی و به آنها محبت و دوستی نشان دهی."],[193,"شب از بهر آسایش توست و روز","مه روشن و مهر گیتی‌فروز","شب برای راحتی و آسایش تو آفریده شده است و روز نیز با روشنایی و گرمای خود، به زندگی و جهان روشنی می‌بخشد."],[193,"سپهر از برای تو فراش وار","همی‌گستراند بساط بهار","آسمان به خاطر تو مانند یک پیشخدمت، سفره بهار را پهن می‌کند."],[193,"اگر باد و برف است و باران و میغ","وگر رعد چوگان زند برق تیغ","هرچند که ممکن است باد، برف، باران و ابر وجود داشته باشد و یا رعد و برق به شدت بزند، در واقع همه اینها باز هم تأثیری بر شادی و خوشبختی تو نخواهند داشت."],[193,"همه کارداران فرمانبر‌ند","که تخم تو در خاک می‌پرورند","همه کارگزاران و حکومتی‌ها پیرو تو هستند و تلاش می‌کنند تا محصول و نتایج اعمال تو را در زمین به بار آورند."],[193,"اگر تشنه مانی‌، ز سختی مجوش","که سقای ابر آبت آرد به دوش","اگر در زندگی احساس تشنگی می‌کنی، از سختی‌های آن شاکی نشو، زیرا آبی که تو نیاز داری، مانند ابر بر دوش سقایی می‌آید و به تو می‌رسد."],[193,"ز خاک آورد رنگ و بوی و طعام","تماشاگه دیده و مغز و کام","از خاک مواد و رنگ و عطر و غذا به‌دست آمده که چیزی خوش‌نما و لذت‌بخش برای چشم و طعم است."],[193,"عسل دادت از نحل و من از هوا","رطب دادت از نخل و نخل از نوی","عسل را ز زنبور به تو داده‌اند و من نیز از دل‌خوشی و محبت به تو می‌دهم. خرما را از نخل به تو می‌دهند و نخل هم از تبار و نسل خود می‌باشد."],[193,"همه نخل‌بندان بخایند دست","ز حیرت که نخلی چنین کس نبست‌!","همه درختان نخل به تعجب می‌افتند و دست از شگفتی برنمی‌دارند که نخیلی مانند این شخص (که به ویژه از او سخن می‌رود) وجود ندارد!"],[193,"خور و ماه و پروین برای تواند","قنادیل‌ سقف سرای تواند","خورشید، ماه و مجموعه ستاره‌های پروین به عنوان چراغ‌هایی در سقف خانه‌ات برای تو روشنایی می‌آورند."],[193,"ز خارت گل آورد و از نافه مشک","زر از کان و برگ تر از چوب خشک","از گل و مشک و چوب، چیزهای زیبایی تهیه کرده است؛ گل را از زمین و مشک را از نافه (خوشبوکننده‌ای که از غزال به دست می‌آید) و چوب تر را از چوب خشک به دست آورده است."],[193,"به دست خودت چشم و ابرو نگاشت","که محرم به اغیار نتوان گذاشت","چشم و ابروی زیبا را خودت با دستان خودت آفریده‌ای؛ بنابراین کسی دیگر را نمی‌توان به او نزدیک کرد و این نعمت را به او سپرد."],[193,"توانا که او نازنین پرورد","به الوان نعمت چنین پرورد","توانا، یعنی خداوند، آن موجود نازنینی را خلق کرده و به انواع نعمت‌ها پرورش داده است."],[193,"به جان گفت باید نفس بر نفس","که شکرش نه کار زبان است و بس","شکرگزاری از نعمت‌ها تنها با زبان کافی نیست؛ بلکه باید در دل و جان احساس شکر را داشته و برای هر نفسی که می‌کشیم، به خاطر آن شکرگزار باشیم."],[193,"خدایا دلم خون شد و دیده ریش","که می‌بینم انعامت از گفت بیش","خدایا، قلبم به شدت ناراحت و دلگیر شده و چشمانم پر از اشک است، زیرا می‌بینم که نعمت‌ها و لطف‌های تو فقط با سخن و گفتار توصیف نمی‌شوند."],[193,"نگویم دد و دام و مور و سمک","که فوج ملائک بر اوج فلک","من نمی‌گویم در مورد دد (وحوش) و دام (حیوانات اهلی) و مور (مورچه) و سمک (ماهی) صحبت کنم، زیرا گروهی از فرشتگان در اوج آسمان وجود دارند که برتری و عظمت خداوند را نشان می‌دهند."],[193,"هنوزت سپاس اندکی گفته‌اند","ز بیور هزاران یکی گفته‌اند","شکرگزاری تو به خاطر نعمت‌ها بسیار کم و ناچیز است، زیرا برای هر نعمت، هزاران شکر و سپاس دیگری وجود دارد که باید گفته شود."],[193,"برو سعدیا دست و دفتر بشوی","به راهی که پایان ندارد مپوی","ای سعدی، ورق و دفترت را پاک گردان و به راهی که عاقبت ندارد، نرو"],[194,"نداند کسی قدر روز خوشی","مگر روزی افتد به سختی کشی","هیچ‌کس ارزش روزهای خوب را نمی‌داند مگر اینکه روزهای سختی را تجربه کند."],[194,"زمستان درویش در تنگ سال","چه سهل است پیش خداوند مال","سختی زندگی در زمستان و فقر درویش در سال‌های تنگ، در برابر خداوند، ارزشی ندارد و او شأن و مقام بالاتری دارد."],[194,"سلیمی که یک چند نالان نخفت","خداوند را شکر صحت نگفت","سلیمی که به خاطر ناراحتی‌اش مدتی خوابش نبرد، به خدا شکر نکرد که حالش خوب شده است."],[194,"چو مردانه‌رو باشی و تیز پای","به شکرانه با کندپایان بپای","اگر در زندگی مردانه و با اراده باشی و با سرعت و شتاب عمل کنی، شایسته است که به خاطر نعمت‌ها، با کسانی که کندتر هستند، همگام شوی و به آن‌ها کمک کنی."],[194,"به پیر کهن بر ببخشد جوان","توانا کند رحم بر ناتوان","کسی که جوان و توانا است، باید به پیران کهنسال و ناتوان ارفاق و بخشش کند و بر آن‌ها رحم داشته باشد."],[194,"چه دانند جیحونیان قدر آب","ز واماندگان پرس در آفتاب","ساکنان جیحون (جیحونیان) نمی‌دانند که ارزش آب چقدر است، بنابراین از افرادی که در زیر آفتاب مانده‌اند و تشنه هستند، سوال کن تا بفهمی."],[194,"عرب را که در دجله باشد قعود","چه غم دارد از تشنگان زرود","زرود‌: نام منطقه‌ای است بی‌آب."],[194,"کسی قیمت تندرستی شناخت","که یک چند بیچاره در تب گداخت","تنها کسی ارزش سلامتی را درک می‌کند که مدتی را در بیماری و تب گذرانده باشد و رنج آن را احساس کرده باشد."],[194,"تو را تیره شب کی نماید دراز","که غلطی ز پهلو به پهلوی ناز؟","تیره‌ شب هرگز نمی‌تواند به درازای شب طولانی باشد، مگر اینکه به خاطر نازک‌خیالی و افکار پراکنده‌ات، در پهلو به پهلوی خود غلط بزنیم."],[194,"براندیش از افتان و خیزان تب","که رنجور داند درازای شب","فکر نکن به اینکه با افت و خیزهای خود، کس، رنجور است، چرا که او از طول شب آگاه نیست."],[194,"به بانگ دهل خواجه بیدار گشت","چه داند شب پاسبان چون گذشت؟","خواجه با صدای دهل بیدار شد، اما او نمی‌داند شب چگونه گذشت و پاسبان چگونه از آن مراقبت کرده است."],[195,"شنیدم که طغرل شبی در خزان","گذر کرد بر هندوی پاسبان","شنیده‌ام که شبی طغرل‌شاه در فصل خزان بر یک هندوی پاسبان گذر کرد"],[