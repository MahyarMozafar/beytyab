195,"ز باریدن برف و باران و سیل","به لرزش در افتاده همچون سهیل","(و دید که‌ آن پاسبان) از سرما و برف همچون سهیل (؟) می‌لرزید."],[195,"دلش بر وی از رحمت آورد جوش","که اینک قبا پوستینم بپوش","دلش برای او به رحم آمد و به او گفت اینک قبا‌پوستین مرا بپوش"],[195,"دمی منتظر باش بر طرف بام","که بیرون فرستم به دست غلام","کمی بر بام منتظر باش که قباپوستین را به نوکری بدهم که برایت بیاورد"],[195,"در این بود و باد صبا بروزید","شهنشه در ایوان شاهی خزید","در این گفتن بود که باد سردی وزید و طغرل‌شاه از شدت سرما درون رفت و به سرای شاهی پناه برد."],[195,"وشاقی پری چهره در خیل داشت","که طبعش بدو اندکی میل داشت","در میان آن جمع، دختری زیبا و پری‌چهره بود که قلب سلطان طغرل به او تمایل جزئی داشت."],[195,"تماشای ترکش چنان خوش فتاد","که هندوی مسکین برفتش ز یاد","تماشای تیرکمان او (پری چهره) به قدری لذت‌بخش بود که آن هندوی مسکین (نگهبان) از تمام مشکلات و غم‌هایش غافل شد."],[195,"قبا پوستینی گذشتش به گوش","ز بدبختیش در نیامد به دوش","(آن هندو‌) وعده قباپوستینی به گوشش خورد اما از بخت بد او، نصیب دوشش نشد و آن‌را نپوشید."],[195,"مگر رنج سرما بر او بس نبود","که جور سپهر انتظارش فزود‌؟","مگر آن رنج و زحمت سرما کافی نبود؟ که جور فلک‌، درد انتظار را هم به آن اضافه کرد."],[195,"نگه کن چو سلطان به غفلت بخفت","که چوبک زنش بامدادان چه گفت","به یاد داشته باش که وقتی سلطان به خواب غفلت می‌رود، چوبکی که بر دوش همسرش است، در صبح چه اسراری را به او می‌گوید."],[195,"مگر نیکبختت فراموش شد","چو دستت در آغوش آغوش شد؟","آغوش دومی نامی از نامهای غلامان است."],[195,"تو را شب به عیش و طرب می‌رود","چه دانی که بر ما چه شب می‌رود؟","تو در شب در خوشی و سرور به سر می‌بری، ولی نمی‌دانی که بر ما چه بر سر می‌آید و چه دگرگونی‌هایی را تجربه می‌کنیم."],[195,"فرو برده سر کاروانی به دیگ","چه از پا فرو رفتگانش به ریگ","کاروانی که در حال گذر است، به علت غفلتی که در مورد مشکلات مسیر داشته، به درون دیگی افتاده است. در اینجا به کسانی که در مسیر به زمین می‌افتند و گرفتار می‌شوند، اشاره دارد."],[195,"بدار ای خداوند زورق بر آب","که بیچارگان را گذشت از سر آب","ای خداوند، قایق را بر روی آب آماده کن، زیرا بیچاره‌ها در خطر غرق شدن قرار دارند و نیاز به عبور از روی آب دارند."],[195,"توقف کنید ای جوانان چست","که در کاروانند پیران سست","ای جوانان چالاک، لحظه‌ای توقف کنید، زیرا در کاروان افراد سالخورده‌ای وجود دارند که ناتوان و ضعیف هستند و به کمک نیاز دارند."],[195,"تو خوش خفته در هودج کاروان","مهار شتر در کف ساروان","تو در هودج کاروان به خوشی خوابیده‌ای، در حالی که نفر اول کاروان (ساروان) مهار شترها را در دست دارد."],[195,"چه هامون و کوهت، چه سنگ و رمال","ز ره باز پس ماندگان پرس حال","هرچند تو دارای سرزمین‌های وسیع و کوه‌های بزرگ و سنگلاخی هستی، اما از کسانی که در راه مانده‌اند، حال و احوالشان را بپرس."],[195,"تو را کوه پیکر هیون می‌برد","پیاده چه دانی که خون می‌خورد؟","کوهی بزرگ و قدرتمند مانند هیون (یعنی شیر) تو را به همراه می‌برد و تو از حالتی که در آن هستی، بی‌خبری، در حالی که خودت از شدت زحمتی که می‌کشی، فقط خون و جانت را می‌سوزانی."],[195,"به آرام دل خفتگان در بنه","چه دانند حال کم گرسنه؟","خفته‌ها در جنگل هیچ نمی‌دانند که گرسنه‌ها چه حال و روزی دارند و چه رنج‌هایی می‌کشند."],[196,"یکی را عسس دست بر بسته بود","همه شب پریشان و دلخسته بود","عسس (شحنه‌) یکی را دستگیر کرده‌بود؛ آن‌شخص تمام شب‌، آشفته و غمگین بود."],[196,"به گوش آمدش در شب تیره رنگ","که شخصی همی نالد از دست تنگ","از دل تاریکی صدای کسی را شنید که از تنگدستی و ناداشتی شکایت می‌کرد."],[196,"شنید این سخن دزد مغلول و گفت","ز بیچارگی چند نالی؟ بخفت","دزد زنجیرشده این را شنید و گفت: چرا از بیچارگی خود می‌نالی؟ (غمگین مباش و) برو بخواب. (مغلول‌ یعنی زنجیر‌شده)"],[196,"برو شکر یزدان کن ای تنگدست","که دستت عسس تنگ بر هم نبست","برو خدا را شکر کن ای تنگدست که شحنه تو را زنجیر نکرده‌است."],[196,"مکن ناله از بینوایی بسی","چو بینی ز خود بینواتر کسی","از بینوایی و ناداری شکایت مکن‌، وقتی که از تو بینواتر و بیچاره‌تر هم هست."],[197,"برهنه تنی یک درم وام کرد","تن خویش را کسوتی خام کرد","آدم برهنه (و بی‌بضاعتی‌) یک درهم قرض کرد و از پوست دباغی‌نشده‌، جامه‌ای تهیه کرد. (خام‌: پوست دباغی‌نشده. کسوت‌: جامه‌، پوشش‌)"],[197,"بنالید کای طالع بدلگام","به گرما بپختم در این زیر خام","طالع‌: سرنوشت بدلگام‌: ستوری که سرکش باشد کنایه است از نافرمان‌."],[197,"چو ناپخته آمد ز سختی به جوش","یکی گفتش از چاه زندان: «خموش!»","زمانی که شخصی ناپخته و ناتوان از سختی به خشم و هیجان می‌آید، یکی به او می‌گوید که از زندان (چاه سختی) سکوت کند و آرام بگیرد."],[197,"به جای آور، ای خام، شکر خدای","که چون ما نه‌ای خام بر دست و پای","ای خام‌: ای بی‌تجربه خام در مصرع دوم‌: کمند‌، ریسمان‌."],[198,"یکی کرد بر پارسایی گذر","به صورت جهود آمدش در نظر","یک نفر به راه راست‌سیران (پارسایان) برخورد کرد که در آن زمان به شکل یهودی دیده می‌شد."],[198,"قفایی فرو کوفت بر گردنش","ببخشید درویش پیراهنش","یک درویش به خاطر خطای خود از یک فرد بت پرست (که به او اشاره شده) عذرخواهی کرده و در حالی که لباسش را بر تن داشته، به او گفت که در این موضوع از او گذشت کند."],[198,"خجل گفت کانچ از من آمد خطاست","ببخشای بر من، چه جای عطاست؟","درویش در مقابل انتقاد یا رفتاری که از او سر زده، فکر می‌کند که هر چه که از او سر زده، اشتباه بوده و از طرفی درخواست می‌کند که او را ببخشند، زیرا اینجا جای پاداش و عطا نیست."],[198,"به شکرانه گفتا به سر بیستم","که آنم که پنداشتی نیستم","شکرانه این است که در بیست‌سالگی به تو می‌گویم من همان کسی هستم که فکر می‌کردی نیستم."],[198,"نکو سیرت بی تکلف برون","به از نیکنام خراب اندرون","انسانی با سیرت نیک و ساده‌دل، بهتر از کسی است که از بیرون نیکو به نظر می‌رسد اما در درون، خراب و بدنام است."],[198,"به نزدیک من شبرو راهزن","به از فاسق پارسا پیرهن","بهتر است که یک شخص شب‌رو و راهزن (که از نظر اخلاقی بد است) نزد من باشد تا اینکه یک فرد پارسا و ظاهرا صالح، اما در باطن فاسق و ناپاک، کنارم باشد."],[199,"ز ره باز پس مانده‌ای می‌گریست","که مسکین تر از من در این دشت کیست؟","کسی از راه بازگشته، در حال گریه بود و می‌گفت: هیچ‌کس در این دشت بیچاره‌تر از من نیست."],[199,"جهاندیده‌ای گفتش ای هوشیار","اگر مردی این یک سخن گوش دار","جهاندیده‌ای به آن شخص می‌گوید: ای فرد باهوش، اگر مرد واقعی هستی، این یک نکته را خوب گوش کن."],[199,"برو شکر کن چون به خر بر نه‌ای","که آخر بنی آدمی، خر نه‌ای","بدان که وقتی تو را سوار بر الاغ می‌کنند، شکرگزار باش، زیرا در نهایت انسان نیز ممکن است به حالت حیوانی و ذلت برسد."],[200,"فقیهی بر افتاده مستی گذشت","به مستوری خویش مغرور گشت","فقیهی، در حالتی که به زمین افتاده و مست است، از کنار او عبور کرد و به خاطر موقعیت خود، به خود مغرور شد."],[200,"ز نخوت بر او التفاتی نکرد","جوان سر برآورد کای پیرمرد","جوانی که سرکشی و خودپسندی دارد، به فقیه پیر و افتاده توجهی نکرد و او را نادیده گرفت."],[200,"برو شکر کن چون به نعمت دری","که محرومی آید ز مستکبری","برو شکر کن که به نعمت رسیده‌ای، زیرا وقتی که کسی از نعمت محروم می‌شود، به خاطر خودخواهی و تکبرش است."],[200,"یکی را که در بند بینی مخند","مبادا که ناگه درافتی به بند","به فردی که در مشکل یا در سختی است، طعنه نزن و به او بخند؛ چون ممکن است روزی خودت به همان وضعیت دچار شوی و در گرفتار بیفتی."],[200,"نه آخر در امکان تقدیر هست","که فردا چو من باشی افتاده مست؟","شاید تقدیر به گونه‌ای باشد که فردا تو نیز همچون من در وضعیتی خجالت‌آور و مستقرار قرار بگیری."],[200,"تو را آسمان خط به مسجد نوشت","مزن طعنه بر دیگری در کنشت","تو را سرنوشت به رفتن به مسجد مقدر کرده است، پس بر دیگران در جایی که خودت هستی، ایراد نگیری و طعنه نزن."],[200,"ببند ای مسلمان به شکرانه دست","که زنار مغ بر میانت نبست","ای مسلمان، به عنوان شکرگزاری، دستت را ببند (و آن را به طرف خدا بلند کن)، زیرا زنار (دستبند غیرمسلمانان) بر میانت نیست."],[200,"نه خود می‌رود هر که جویان اوست","به عنفش کشان می‌برد لطف دوست","هر کسی که طالب و جویای حقیقت (دوست) باشد، به اجبار نمی‌تواند به آن دست یابد، بلکه محبت و لطف (خدا) او را به سوی حقیقت می‌کشد و هدایت می‌کند."],[200,"نگر تا قضا از کجا سیر کرد","که کوری بود تکیه بر غیر کرد","بنگر که سرنوشت از کجا چرخید و به کجا می‌رود، چون کسی که به دیگران تکیه کرده است، خود را به نابینایی انداخته است."],[201,"سرشته‌ست بارئ شفا در عسل","نه چندان که زور آورد با اجل","در عسل خاصیتی است که می‌تواند درمانگر باشد، اما این خاصیت به اندازه‌ای نیست که بتواند بر مرگ غلبه کند."],[201,"عسل خوش کند زندگان را مزاج","ولی درد مردن ندارد علاج","عسل می‌تواند مزاج زنده‌ها را خوش کند و به سلامتی آنها کمک کند، اما هیچ درمانی برای درد مرگ ندارد."],[201,"رمق مانده‌ای را که جان از بدن","برآمد، چه سود انگبین در دهن؟","وقتی که جان از بدن فردی خارج شده و او در حال احتضار است، چه فایده‌ای دارد که عسل یا شیرینی به او داده شود؟"],[201,"یکی گرز پولاد بر مغز خورد","کسی گفت صندل بمالش به درد","وقتی که کسی به شدت آسیب می‌بیند و به زمین می‌افتد، دیگر کسی نمی‌تواند با مالش عطر یا چیز خوشبو (صندل) به او کمک کند یا دردش را تسکین دهد؛ به عبارت دیگر، در شرایط بحرانی، دیگر کارهای کوچک و بی‌مفهوم نمی‌تواند مفید باشد."],[201,"ز پیش خطر تا توانی گریز","ولیکن مکن با قضا پنجه تیز","همواره سعی کن که از خطر دوری کنی، اما هرگز با تقدیر و قضا درگیر مشو و تلاش نکن که آن را تغییر دهی."],[201,"درون تا بود قابل شرب و اکل","بدن تازه روی است و پاکیزه شکل","تا زمانی که درون انسان برای نوشیدن و خوردن مناسب باشد، بدن جوان و زیبا به نظر می‌آید و به‌طور کلی سالم است."],[201,"خراب آنگه این خانه گردد تمام","که با هم نسازند طبع و طعام","این خانه وقتی به کلی خراب و ویران می‌شود که طبیعت بدن و غذایی که می‌خورد با هم سازگاری نداشته باشند."],[201,"طبایع تر و خشک و گرم است و سرد","مرکب از این چار طبع است مرد","آدم‌ها از چهار خصلت اصلی تشکیل شده‌اند: تر، خشک، گرم و سرد. این چهار طبع یا خصوصیت، بنیاد طبیعت انسان‌ها را شکل می‌دهد."],[201,"یکی زین چو بر دیگری یافت دست","ترازوی عدل طبیعت شکست","هرگاه یکی از این طبایع بر دیگری غالب شود، ترازوی برابری و عدل طبیعت به هم می‌خورد و از تعادل خارج می‌شود."],[201,"اگر باد سرد نفس نگذرد","تف معده جان در خروش آورد","اگر باد سرد نپیچد و از ریه‌ها خارج نشود، پس معده مثل جان آدمی در حال ناآرامی و سر و صدا خواهد بود."],[201,"وگر دیگ معده نجوشد طعام","تن نازنین را شود کار خام","اگر دیگ معده به جوش نیاید، غذا برای بدن لطیف و نازنین (انسان) آماده نخواهد شد و کار به حالت خام باقی می‌ماند."],[201,"در اینان نبندد دل، اهل شناخت","که پیوسته با هم نخواهند ساخت","دل نباید به این افراد ببندد، زیرا آن‌هایی که اهل شناخت هستند، همیشه با یکدیگر توافق نخواهند کرد و در کنار هم نمی‌مانند."],[201,"توانایی تن مدان از خورش","که لطف حقت می‌دهد پرورش","توانایی جسمی را فقط به خاطر غذا و خوراکی که به ما می‌دهد، نشمار. زیرا این نعمت‌ها از لطف خداوند به ما عطا شده‌اند و منبع واقعی قوت ما، رحمت اوست."],[201,"به حقش که گر دیده بر تیغ و کارد","نهی، حق شکرش نخواهی گزارد","اگر به خودت توجه نکنی و نعمت‌های الهی را نادیده بگیری، حتی اگر در خطر مرگ هم باشی، نمی‌توانی شکر نعمت‌های خدا را به جا آوری."],[201,"چو رویی به طاعت نهی بر زمین","خدا را ثناگوی و خود را مبین","اگر صورتت را بر زمین در حال عبادت بگذاری، خدا را ستایش کن و به خیالت خودت را بزرگ نکن."],[201,"گدایی است تسبیح و ذکر و حضور","گدا را نباید که باشد غرور","انسان باید از مقام و مرتبه‌اش در حال عبادت و نزد خداوند، بیدار و آگاه باشد و هرگز نباید به خود ببالد یا مغرور شود، حتی اگر در حال دعا و ذکر و یاد خدا باشد."],[201,"گرفتم که خود خدمتی کرده‌ای","نه پیوسته اقطاع او خورده‌ای؟","من متوجه شدم که تو به‌خاطر خدمت و فداکاری‌ات در حق دیگران چیزی را دریافت کرده‌ای، نه اینکه همیشه از اموال و دارایی دیگران بهره‌مند شده باشی."],[202,"نخست او ارادت به دل در نهاد","پس این بنده بر آستان سر نهاد","ابتدا خداوند اراده و خواست را در دل انسان قرار می‌دهد، سپس این بنده سرش را در برابر خداوند به خاک می‌گذارد و تسلیم می‌شود."],[202,"گر از حق نه توفیق خیری رسد","کی از بنده چیزی به غیری رسد؟","اگر از جانب حق توفیق و خیر به کسی نرسد، آیا ممکن است که بنده‌ای چیزی به غیر خود بدهد یا به کسی کمک کند؟"],[202,"زبان را چه بینی که اقرار داد","ببین تا زبان را که گفتار داد","زبان را نبینید که فقط صحبت می‌کند، بلکه توجه کنید که چه کسی به زبان شکایت می‌کند و چه کسی به او حرف می‌زند."],[202,"در معرفت دیده آدمی است","که بگشوده بر آسمان و زمی است","در حقیقت، بینش و آگاهی انسان است که به او اجازه می‌دهد به رازهای موجود در آسمان و زمین پی ببرد."],[202,"کیت فهم بودی نشیب و فراز","گر این در نکردی به روی تو باز؟","کسی که به شناخت و درک صحیح رسیده، چگونه می‌تواند در فراز و نشیب‌های زندگی دچار سردرگمی شود، اگر در را به روی او نگشوده باشند؟"],[202,"سر آورد و دست از عدم در وجود","در این جود بنهاد و در آن سجود","وجود انسان از عدم به حیات آمده است و در این نعمت بزرگی که از رحمت و کرم خداوند (جود) برخوردار است، سر به سجده گذاشته است."],[202,"وگرنه کی از دست جود آمدی؟","محال است کز سر سجود آمدی","اگر برکات و نعمت‌های خداوند نبود، هرگز به وجود نمی‌آمدی. این غیرممکن است که از حالت عبودیت و سجده به چنین نعمتی دست پیدا کرده باشی."],[202,"به حکمت زبان داد و گوش آفرید","که باشند صندوق دل را کلید","خداوند به خاطر حکمت، زبان را آفرید و گوش را خلق کرد تا انسان‌ها بتوانند احساسات و افکار درونی خود را بیان کرده و به دیگران گوش فرا دهند؛ زبان به عنوان یک در، کلید ورود به دنیای درونی دل است."],[202,"اگر نه زبان قصه برداشتی","کس از سر دل کی خبر داشتی؟","اگر زبان را برای بیان احساسات و داستان‌ها به کار نمی‌بردی، هیچ‌کس از دل تو خبر نداشت و نمی‌توانست احساسات تو را درک کند."],[202,"وگر نیستی سعی جاسوس گوش","خبر کی رسیدی به سلطان هوش","اگر تو در تلاش نیستی و از دل خود کار نمی‌کنی، چطور می‌توانی به سلطان خرد و آگاهی خبر برسانی؟"],[202,"مرا لفظ شیرین خواننده داد","تو را سمع و ادراک داننده داد","شخصی به من گفت که تو را با کلام شیرین می‌خواند و به تو توانایی شنیدن و فهمیدن عطا کرده است."],[202,"مدام این دو چون حاجبان بر درند","ز سلطان به سلطان خبر می‌برند","این دو همواره مانند دوات در کنار هم هستند و اخبار را از سلطان (خدا) به سلطان (دل و عقل) می‌رسانند."],[202,"چه اندیشی از خود که فعلم نکوست؟","از آن در نگه کن که توفیق اوست","چرا به این فکر می‌کنی که کار نیک یا عبادت تو خوب است؟ به این شکل به کارهای خوبت نگاه کن که اینها هم از لطف و توفیق الهی است که به تو ارزانی شده است."],[202,"برد بوستانبان به ایوان شاه","به نوباوه گل هم ز بستان شاه","وقتی که باغبان‌ها گلهای نوباوه و تازه‌ی فصل را به عنوان هدیه به نزد شاه می‌برند؛ آن گلها نیز از باغ شاه هستند."],[203,"بتی دیدم از عاج در سومنات","مرصع چو در جاهلیت منات","در سومنات (شهری در هند) مجسمه‌ای از عاج دیدم که به زیبایی و تزئین، همانند مجسمه منات (الهه جاهلیت) بود."],[203,"چنان صورتش بسته تمثالگر","که صورت نبندد از آن خوبتر","آن مجسمه (بت) به گونه‌ای طراحی شده است که هیچ هنرمند دیگری قادر به ساختن مجسمه‌ای زیباتر از آن نیست."],[203,"ز هر ناحیت کاروانها روان","به دیدار آن صورت بی روان","از هر سو کاروان‌ها در حرکت‌اند تا آن چهره بدون روح را ببینند."],[203,"طمع کرده رایان چین و چگل","چو سعدی وفا ز آن بت سخت دل","چینی‌ها و مردم چگل (مردم ناحیه‌ای در هند) به محبوبیت و زیبایی آن بت دلخواه طمع ورزیده‌اند، اما مانند سعدی به خاطر وفاداری و عشق واقعی، قلبشان از آن بت سنگدل ناامید شده است."],[203,"زبان آوران رفته از هر مکان","تضرع کنان پیش آن بی زبان","زبان‌آوران، افرادی که خوب سخن می‌گویند، از هر جایی رفته‌اند و برای آن بت بی‌زبان (بت پرستان) با التماس و زاری درخواست می‌کنند."],[203,"فرو ماندم از کشف آن ماجرا","که حیی جمادی پرستد چرا؟","از فهمیدن ماجرای آن شخص حیرت‌زده شدم که چرا کسی که زنده (و دارای آگاهی) است، به پرستش جماد (موجود بی‌جان) می‌پردازد؟"],[203,"مغی را که با من سر و کار بود","نکوگوی و هم حجره و یار بود","مغی، کسی که با من ارتباط داشت، فردی نیکو گفتار و هم‌اتاقی و دوست بود."],[203,"به نرمی بپرسیدم ای برهمن","عجب دارم از کار این بقعه من","به آرامی از برهمن، یکی از شخصیت‌های هندو، پرسیدم که چرا از رفتار این معبد و مکان پرستش تعجب می‌کنم."],[203,"که مدهوش این ناتوان پیکرند","مقید به چاه ضلال اندرند","این ناتوانان دچار گیجی و سردرگمی هستند و در چاهی از گمراهی گرفتار شده‌اند."],[203,"نه نیروی دستش، نه رفتار پای","ورش بفکنی بر نخیزد ز جای","نه نیروی دست این شخص به اندازه‌ای است که بتواند کار بکند و نه رفتار پای او به قدری است که بتواند از جایش حرکت کند."],[203,"نبینی که چشمانش از کهرباست؟","وفا جستن از سنگ چشمان خطاست","چشمان او مانند کهربا است و زیبایی خاصی دارد، اما انتظار وفاداری از کسی که چشمانش سنگی و سرد است، نادرست است."],[203,"بر این گفتم آن دوست دشمن گرفت","چو آتش شد از خشم و در من گرفت","به او گفتم که آن دوست به دشمنی برخاست و از خشمش مانند آتش شعله‌ور شد و این خشمش درون من نیز نفوذ کرد."],[203,"مغان را خبر کرد و پیران دیر","ندیدم در آن انجمن روی خیر","مغان (مخصوص بت‌پرستان) را از این ماجرا باخبر کرد و در آن جمع، پیرانی را ندیدم که به خوبی و نیکی معروف باشند."],[203,"فتادند گبران پازند خوان","چو سگ در من از بهر آن استخوان","مردان بت‌پرست (گبران) به خاطر دستیابی به منافع شخصی و حیوانی خود مانند سگ‌ها به دور استخوان می‌چرخیدند و در آن وضعیت افتاده و ذلیل شده بودند."],[203,"چو آن راه کژ پیششان راست بود","ره راست در چشمشان کژ نمود","آنگاه که راه نادرست در نظر آنها درست جلوه می‌کند، راه صحیح در دیدشان نادرست به نظر می‌رسد."],[203,"که مرد ار چه دانا و صاحبدل است","به نزدیک بی‌دانشان جاهل است","اگرچه فردی دانا و با دل باشد، اما نزد نادانان به‌نظر جاهل می‌آید."],[203,"فرو ماندم از چاره همچون غریق","برون از مدارا ندیدم طریق","مثل غریق که به خاطر کمبود راه نجات از چاره‌جویی و تلاش برای بیرون آمدن از آب ناامید شده، من نیز از چاره‌جویی بی‌فایده ماندم و هیچ راهی نمی‌بینم که بتوانم از این وضعیت نجات پیدا کنم."],[203,"چو بینی که جاهل به کین اندر است","سلامت به تسلیم و لین اندر است","اگر دیدی که شخص جاهلی به دشمنی و کینه‌توزی مشغول است، بهترین راه برای حفظ سلامتی این است که با نرم‌خویی و تسلیم، از درگیری دوری کنی."],[203,"مهین برهمن را ستودم بلند","که ای پیر تفسیر استا و زند","من به ستایش برهمن بزرگ پرداختم، زیرا او پیر و آگاه به تفسیر رازها و احکام است."],[203,"مرا نیز با نقش این بت خوش است","که شکلی خوش و قامتی دلکش است","من هم از زیبایی این بت لذت می‌برم، زیرا شکل و قامت زیبا و دل‌ربایی دارد."],[203,"بدیع آیدم صورتش در نظر","ولیکن ز معنی ندارم خبر","ظاهرا زیبا و دلنشین به نظر می‌رسد، اما از معنای آن بی‌خبرم."],[203,"که سالوک این منزلم عن قریب","بد از نیک کمتر شناسد غریب","سالیانی که در این خانه زندگی می‌کنم، به زودی بر من روشن خواهد شد که تفاوت خوب و بد را کمتر از آنچه فکر می‌کردم می‌شناسم."],[203,"تو دانی که فرزین این رقعه‌ای","نصیحتگر شاه این بقعه‌ای","فرزین، کسی است که این نامه را به تو می‌فرستد و او نصیحتگری برای شاه محل است."],[203,"چه معنی است در صورت این صنم","که اول پرستندگانش منم","منظور شاعر این است که در دنیای زیبایی و جذابیت، هیچ‌چیز به اندازه‌ی معشوق و بت‌پرستی‌اش جذاب نیست و او خود را نخستین و مهم‌ترین پرستنده‌ی این زیبایی می‌داند."],[203,"عبادت به تقلید گمراهی است","خنک رهروی را که آگاهی است","پرستش به تقلید از دیگران، راهی به سوی گمراهی است. خوشا به حال آن کسی که آگاه است و درباره باورهای خود تحقیق می‌کند."],[203,"برهمن ز شادی بر افروخت روی","پسندید و گفت ای پسندیده گوی","برهمن (یکی از متکلمان هندو) به خاطر شادی‌اش چهره‌اش را درخشنده و زیبا نشان داد و گفت: ای کسی که به تو خوشامد می‌گویم، سخن بگو."],[203,"سؤالت صواب است و فعلت جمیل","به منزل رسد هر که جوید دلیل","سوال تو درست است و عمل تو نیکوست؛ هر کسی که دنبال دلیل برود، به مقصودش خواهد رسید."],[203,"بسی چون تو گردیدم اندر سفر","بتان دیدم از خویشتن بی خبر","من در سفرهای خود افرادی چون تو را زیاد دیدم که با بت‌ها (مجسمه‌های موردپرستش) مواجه شدند و از حالت واقعی خود بی‌خبر بودند."],[203,"جز این بت که هر صبح از اینجا که هست","برآرد به یزدان دادار دست","جز این بت که هر روز از اینجا به سوی خدا دعا می‌کند، هیچ چیز دیگری وجود ندارد که به مخلوقیت و خدایی او اشاره کند."],[203,"وگر خواهی امشب همینجا بباش","که فردا شود سر این بر تو فاش","اگر می‌خواهی، امشب همین جا بمان و نرو، چون فردا راز این موضوع برای تو روشن خواهد شد."],[203,"شب آنجا ببودم به فرمان پیر","چو بیژن به چاه بلا در اسیر","شب را در آنجا به فرمان پیر گذراندم، مانند بیژن که به دلیل گرفتار شدن در چاه بلا، در رنج و عذاب بود."],[203,"شبی همچو روز قیامت دراز","مغان گرد من بی وضو در نماز","یک شب مانند روز قیامت، طولانی شد و مغان (یعنی زرتشتیان) دور من gathered شدند، در حالی که بدون وضو، مشغول نماز خواندن بودند."],[203,"کشیشان هرگز نیازرده آب","بغلها چو مردار در آفتاب","کشیشان هرگز احساس تشنگی نمی‌کنند و مانند فضولات در آفتاب می‌مانند، به این معنی که آنها به روحانیت و معنویتشان بی‌اعتنا هستند و دچار یأس و ناامیدی شده‌اند."],[203,"مگر کرده بودم گناهی عظیم","که بردم در آن شب عذابی الیم","شاید به خاطر مرتکب شدن به یک کار بزرگ و خطای بزرگ بوده که در آن شب عذاب سختی را تجربه کردم."],[203,"همه شب در این قید غم مبتلا","یکم دست بر دل، یکی بر دعا","تمام شب در غم گرفتار بودم، یک دست بر روی دل گذاشته بودم و دست دیگر به دعا مشغول بودم."],[203,"که ناگه دهل زن فرو کوفت کوس","بخواند از فضای برهمن خروس","ناگهان نوازنده دهل، ضربت محکمی به آن می‌زند و صدای کوس (نوعی ساز) به گوش می‌رسد که در فضای معبد برهما، خروس می‌خواند."],[203,"خطیب سیه پوش شب بی خلاف","بر آهخت شمشیر روز از غلاف","خطیب که لباس تیره بر تن دارد، در شب بدون هیچ اشتباهی شمشیر روز را از غلاف بیرون می‌آورد."],[203,"فتاد آتش صبح در سوخته","به یک دم جهانی شد افروخته","با طلوع صبح، آتش سرخی که در عالم دیده می‌شود، به‌طور ناگهانی تمام جهان را روشن کرده و افروخته می‌کند."],[203,"تو گفتی که در خطه زنگبار","ز یک گوشه ناگه در آمد تتار","تو گفتی که در منطقه زنگبار، ناگهان طهار (تتار) از یک گوشه وارد شد."],[203,"مغان تبه رای ناشسته روی","به دیر آمدند از در و دشت و کوی","مجسمه‌پرستان (مغان) با ناپاکی و خیالات غلط به سوی معبد (دیر) آمدند، بی‌آنکه به پاکی خود توجه داشته باشند و از کوچه و دشت و هر جا که بودند، به آنجا راه یافتند."],[203,"کس از مرد در شهر و از زن نماند","در آن بتکده جای درزن نماند","در آن بتکده، نه مردی در شهر باقی ماند و نه زنی، به گونه‌ای که حتی جای درزن (زن صاحب‌خانه) نیز خالی ماند."],[203,"من از غصه رنجور و از خواب مست","که ناگاه تمثال برداشت دست","من از شدت ناراحتی و اندوه بیمار و خمار از خواب هستم که ناگهان بت را از دست شخصی برداشتند."],[203,"به یک بار از ایشان برآمد خروش","تو گفتی که دریا بر آمد به جوش","ناگهان صدای بلندی از بت‌پرستان برخاست، به‌گونه‌ای که گویی دریا به جوش آمده است."],[203,"چو بتخانه خالی شد از انجمن","برهمن نگه کرد خندان به من","وقتی معبد بت‌پرستان از جمعیت خالی شد، برهمن (روحانی هندو) به من نگریست و با لبخند به من نگاه کرد."],[203,"که دانم تو را بیش مشکل نماند","حقیقت عیان گشت و باطل نماند","می‌دانم که تو دیگر با مشکلی مواجه نخواهی بود، زیرا حقیقت نمایان شده و باطل از بین رفته است."],[203,"چو دیدم که جهل اندر او محکم است","خیال محال اندر او مدغم است","وقتی که دیدم جهل در وجود او ریشه‌دار و قوی است، فهمیدم که تصورات غیرواقعی در او به طور عمیق پنهان شده‌اند."],[203,"نیارستم از حق دگر هیچ گفت","که حق ز اهل باطل بباید نهفت","من نمی‌توانم از حق هیچ سخنی بگویم، زیرا حق باید از کسانی که باطل را می‌پرستند، پنهان بماند."],[203,"چو بینی زبر دست را زور دست","نه مردی بود پنجه خود شکست","وقتی ببینی که بالاتر از خودت کسی با زور و قدرت بر تو مسلط است، بدان که مردانگی واقعی این نیست که با او مقابله کنی و تلاشی بیهوده برای شکست او داشته باشی."],[203,"زمانی به سالوس گریان شدم","که من زآنچه گفتم پشیمان شدم","زمانی دچار ریا و تظاهر بودم و به خاطر صحبت‌هایم گریستم، زیرا از آنچه گفته بودم، احساس پشیمانی کردم."],[203,"به گریه دل کافران کرد میل","عجب نیست سنگ ار بگردد به سیل","دل کافران به گریه و اندوه می‌آید، اما تعجبی ندارد اگر سنگ‌ها در برابر طوفان جابه‌جا شوند."],[203,"دویدند خدمت کنان سوی من","به عزت گرفتند بازوی من","خدمتکاران به سرعت به سمت من آمدند و با احترام و ارادت، بازویم را گرفتند."],[203,"شدم عذرگویان بر شخص عاج","به کرسی زر کوفت بر تخت ساج","من به عنوان عذرخواهی‌کننده در مقابل شخصی عاجز (و ناتوان) از روی کرسی طلایی، بر روی تختی از چوب ساج نشستم."],[203,"بتک را یکی بوسه دادم به دست","که لعنت بر او باد و بر بت پرست","به خاطر نفرتی که از بت و بت‌پرست دارم، به یکی از بت‌ها بوسه‌ای زدم، به این امید که لعنت بر او و کسانی که او را می‌پرستند نازل شود."],[203,"به تقلید کافر شدم روز چند","برهمن شدم در مقالات زند","چند روزی به تقلید از کافران، مانند برهمنان (کسانی که پیرو آئین هندو هستند) رفتار کردم و در سخنان و گفتارشان غرق شدم."],[203,"چو دیدم که در دیر گشتم امین","نگنجیدم از خرمی در زمین","وقتی متوجه شدم در معبد (دیر) به عنوان فرد مورد اعتماد (امین) قرار گرفتم، نتوانستم از خوشحالی خود در زمین جا بگیرم و آرام بمانم."],[203,"در دیر محکم ببستم شبی","دویدم چپ و راست چون عقربی","در شب در کلیسا، محکم خودم را بستم و ناچار از خوف و نگرانی مانند یک عقرب به چپ و راست می‌رفتم."],[203,"نگه کردم از زیر تخت و زبر","یکی پرده دیدم مکلل به زر","چشمم به پرده‌ای افتاد که از زیر تخت دیده می‌شد و آن پرده با طلا تزئین شده بود."],[203,"پس پرده مطرانی آذرپرست","مجاور سر ریسمانی به دست","پس پرده، زنی آتش‌پرست را دیدم که کنار ریسمانی نشسته و در حال مراقبت است."],[203,"به فورم در آن حال معلوم شد","چو داود کآهن بر او موم شد","در آن لحظه به‌سرعت روشن شد که داود، پیامبر، وقتی آهن را می‌زند، چقدر نرم و انعطاف‌پذیر می‌شود."],[203,"که ناچار چون در کشد ریسمان","بر آرد صنم دست، فریادخوان","وقتی که ناچار و با قوت، رشته‌ را در دست می‌کشد، صنم (مجسمه یا بت) هم دستش را بالا می‌آورد و فریاد می‌زند."],[203,"برهمن شد از روی من شرمسار","که شنعت بود بخیه بر روی کار","برهمن (روحانی هندو) به خاطر زیبایی من شرمنده شد، چون موی من مانند بخیه‌ای بر روی کار او (مشغولیت و زحمتش) بود."],[203,"بتازید و من در پیش تاختم","نگونش به چاهی در انداختم","من به طرف او شتافتم و چون به او نزدیک شدم، او را به چاهی انداختم."],[203,"که دانستم ار زنده آن برهمن","بماند، کند سعی در خون من","اگر بدانم که آن برهمن زنده است، به دنبال کشتن من خواهد بود و تمام تلاشش را می‌کند."],[203,"پسندد که از من بر آید دمار","مبادا که سرش کنم آشکار","اگر چیزی از من برآید که باعث دردسر شود، دوست ندارم که آن را فاش کنم و یا به نمایش بگذارم."],[203,"چو از کار مفسد خبر یافتی","ز دستش برآور چو دریافتی","اگر از زشتی‌های کسی آگاه شدی، او را از خودت دور کن و کنار بگذار."],[203,"که گر زنده‌اش مانی، آن بی هنر","نخواهد تو را زندگانی دگر","اگر او (بی‌هنر) زنده بماند، تو دیگر هرگز زندگی خوشی نخواهی داشت."],[203,"وگر سر به خدمت نهد بر درت","اگر دست یابد ببرد سرت","اگر کسی سرش را به نشانه خضوع و خدمت به درگاه تو بگذارد، اگر به تو دست پیدا کند، نمی‌گذارد سر تو در این وضعیت بماند و تو را از بین می‌برد."],[203,"فریبنده را پای در پی منه","چو رفتی و دیدی امانش مده","بعضی از افراد فریبنده و مکار هستند، وقتی به آن‌ها نزدیک شدی، نباید اجازه دهی که از تو سوءاستفاده کنند و باید مراقب باشی که به دامشان نیفتی."],[203,"تمامش بکشتم به سنگ آن خبیث","که از مرده دیگر نیاید حدیث","من آن شخص ناپاک را به شدت تنبیه کردم و کشتم، زیرا اطمینان داشتم که او در آینده نیز سراغ بدی‌هایی نخواهد رفت و از کسی دیگر درباره‌اش خبری نخواهد آمد."],[203,"چو دیدم که غوغایی انگیختم","رها کردم آن بوم و بگریختم","وقتی دیدم که در آنجا سر و صدایی به‌پا شده، آن سرزمین را ترک کرده و فرار کردم."],[203,"چو اندر نیستانی آتش زدی","ز شیران بپرهیز اگر بخردی","وقتی در نیستان (جایی که نی می‌روید و نماد سرزمین یا جامعه‌ای است) آتش بیفروزی، باید از شیران (قدرت‌ها یا حاکمان) دوری کنی، اگر خردمند هستی."],[203,"مکش بچه مار مردم گزای","چو کشتی در آن خانه دیگر مپای","عزیزان، در جایی که بچه ماری وجود دارد، مردم را نیش می‌زند. پس اگر در جایی که او زندگی می‌کند، به آنجا نروید، مانند این که در کشتی دیگر نروند، زیرا ممکن است خطرناک باشد."],[203,"چو زنبور خانه بیاشوفتی","گریز از محلت که گرم اوفتی","اگر به زنبور عسل نزدیک شوی و او را عصبانی کنی، باید از محل زندگی‌اش فرار کنی، چون به شدت به تو حمله می‌کند."],[203,"به چابک‌تر از خود مینداز تیر","چو افتاد، دامن به دندان بگیر","چو در زندگی با شخصی قوی‌تر از خود رو به‌رو شدی، از او دوری کن و به خودت توجه بیشتری داشته باش. اگر به درافتادی، باید خودت را حفظ کنی و از مشکلات فاصله بگیری."],[203,"در اوراق سعدی چنین پند نیست","که چون پای دیوار کندی مایست","در نوشته‌های سعدی چنین نصیحتی وجود ندارد که اگر پای خود را بر روی دیوار بگذاری، بایست."],[203,"به هند آمدم بعد از آن رستخیز","وز آنجا به راه یمن تا حجیز","من به هند سفر کردم و پس از آن از آنجا به سمت یمن و سپس به حجیز (مکانی در نزدیکی مکه) حرکت کردم."],[203,"از آن جمله سختی که بر من گذشت","دهانم جز امروز شیرین نگشت","به خاطر سختی‌ها و مشکلاتی که بر من گذشته است، از دیروز تا امروز نتوانسته‌ام طعم شیرینی را بچشم و این خوشی امروز برایم تازه است."],[203,"در اقبال و تأیید بوبکر سعد","که مادر نزاید چنو قبل و بعد","در اینجا شاعر به بوبکر (که به احتمال زیاد اشاره به ابوبکر صدیق، اولین خلیفه مسلمانان دارد) اشاره می‌کند و می‌گوید که او در اقبال و تأییدش، مانند کسی نیست که مادرش فرزندی به همتایی او به دنیا آورد. این جمله نشان‌دهنده‌ی برتری بوبکر و ویژگی‌های خاص اوست."],[203,"ز جور فلک دادخواه آمدم","در این سایه‌گستر پناه آمدم","از ظلم و ناملایمات روزگار به این سایه‌ی حمایت‌گر پناه آورده‌ام."],[203,"دعاگوی این دولتم بنده‌وار","خدایا تو این سایه پاینده دار","من امید دارم که خداوند این نعمت و سعادت را برای من پایدار نگه دارد و به عنوان بنده‌ای از او دعا می‌کنم."],[203,"که مرهم نهادم نه در خورد ریش","که در خورد انعام و اکرام خویش","دلیل اینکه من زخم‌های خود را با مرهم نمی‌پوشانم این است که باید برای پذیرایی و احترام از دیگران هزینه کنم."],[203,"کی این شکر نعمت به جای آورم","و گر پای گردد به خدمت سرم؟","من در کمال شکرگزاری، نعمت‌های خود را چطور به جا بیاورم، و اگر بر سر خدمت به دیگران برسم، چه کنم؟"],[203,"فرج یافتم بعد از آن بندها","هنوزم به گوش است از آن پندها","بعد از اینکه از سختی‌ها و مشکلات رهایی یافتم، هنوز هم پندها و سخنان آموزنده آن دوران در گوشم طنین انداز است."],[203,"یکی آن که هر گه که دست نیاز","برآرم به درگاه دانای راز","هر بار که به درگاه کسی که به اسرار آگاه است و می‌تواند کمک کند، دست نیازم را بلند می‌کنم،"],[203,"به یاد آید آن لعبت چینیم","کند خاک در چشم خودبینیم","به یاد می‌آورم که آن دختر زیبا از چین، خاک در چشمان متکبر خود می‌ریزد."],[203,"بدانم که دستی که برداشتم","به نیروی خود بر نیفراشتم","می‌دانم که قدرتی که باعث شد تا دستم را بلند کنم، از نیروی خودم نیست."],[203,"نه صاحبدلان دست بر می‌کشند","که سررشته از غیب در می‌کشند","صاحبدلان (افراد با بصیرت و عارف) هرگز از کار و تلاش دست برنمی‌دارند، زیرا آن‌ها به اراده و عنایت غیبی وابسته‌اند و در عملشان به این نیرو دلگرم هستند."],[203,"در خیر باز است و طاعت ولیک","نه هر کس تواناست بر فعل نیک","در انجام کارهای خوب و شایسته، درها باز است و فرصت‌ها مهیاست، اما نه هر فردی توانایی انجام این کارها را دارد."],[203,"همین است مانع که در بارگاه","نشاید شدن جز به فرمان شاه","عبارت «همین است مانع» به این معناست که تنها این موضوع مانع ورود به بارگاه و برای پذیرفته شدن است که آن هم به دستوری از سوی شاه امکان‌پذیر است. در واقع، رفتار و عمل نیکو به تنهایی کافی نیست و باید رضا و اجازه‌ی شاه (خدا) نیز وجود داشته باشد."],[203,"کلید قدر نیست در دست کس","توانای مطلق خدای است و بس","هیچ‌کس جز خداوند قادر مطلق نمی‌تواند سرنوشت و ارزش حقیقی اشیا را تعیین کند؛ تنها اوست که فرمانروایی و قدرت را در دست دارد."],[203,"پس ای مرد پوینده بر راه راست","تو را نیست منت، خداوند راست","ای مردی که به دنبال حقیقت و راه درست هستی، بر تو منت نمی‌نهد، بلکه خود خداوند است که راه راست را نشان می‌دهد."],[203,"چو در غیب نیکو نهادت سرشت","نیاید ز خوی تو کردار زشت","اگر در باطن، خداوند سرشت نیکو و خوبی به تو داده باشد، کردار زشت و ناپسند از خود تو به وجود نخواهد آمد."],[203,"ز زنبور کرد این حلاوت پدید","همان کس که در مار زهر آفرید","حلاوت و شیرینی که از زنبور به وجود آمده، همان خدایی است که زهر را نیز در مار آفریده است. این بیت اشاره به قدرت خداوند دارد که می‌تواند چیزهای مختلف را به وجود آورد؛ هم نعمت و هم بلا."],[203,"چو خواهد که ملک تو ویران کند","نخست از تو خلقی پریشان کند","وقتی که خداوند بخواهد سلطنت تو را خراب کند، ابتدا افرادی را از تو بی‌ثبات و ناراحت می‌سازد."],[203,"وگر باشدش بر تو بخشایشی","رساند به خلق از تو آسایشی","اگر خداوند بر تو رحمت کند، به مردم از تو آرامش و آسایش خواهد رسید."],[203,"تکبر مکن بر ره راستی","که دستت گرفتند و برخاستی","تکبر نکن بر راه درست، چون کسانی تو را یاری کردند و تو را بالا بردند."],[203,"سخن سودمند است اگر بشنوی","به مردان رسی گر طریقت روی","اگر از مردان عاقل و اهل علم سخن سودمندی بشنوی، به جایی می‌رسی و به طریقت صحیحی راه پیدا می‌کنی."],[203,"مقامی بیابی گرت ره دهند","که بر خوان عزت سماطت نهند","اگر راهنمایی برایت پیش بیاید که مقام بزرگی به دست می‌آوری، آن مقام در خور و جایگاه عزت و احترام خواهد بود."],[203,"ولیکن نباید که تنها خوری","ز درویش درمنده یاد آوری","اما نباید فراموش کنی که از درویش فقیری جز یاد و خاطره نگیری و در تنهایی خود، از او بهره‌مند نشوی."],[203,"فرستی مگر رحمتی در پیم","که بر کرده خویش واثق نیم","من انتظار دارم که خداوند رحمتی به من عنایت کند، زیرا به کارهایی که قبلا انجام داده‌ام، اطمینان ندارم و ممکن است آن‌ها درست نبوده باشند."],[204,"بیا ای که عمرت به هفتاد رفت","مگر خفته بودی که بر باد رفت؟","ای کسی که عمری را که به هفتاد سال رسیده‌ای به غفلت گذرانده‌ای، آیا در خواب بودی که این همه زمان از دستت رفته است؟"],[204,"همه برگ بودن همی ساختی","به تدبیر رفتن نپرداختی","تمام عمر را تنها در ساختن ظاهر خود گذراندی و به حقیقت و مقصد اصلی زندگی توجه نکردی."],[204,"قیامت که بازار مینو نهند","منازل به اعمال نیکو دهند","در روز قیامت، وقتی که بازار نعمت‌های بهشتی برپا می‌شود، جایگاه انسان‌ها بر اساس کارهای نیکشان تعیین می‌شود."],[204,"بضاعت به چندان که آری بری","وگر مفلسی شرمساری بری","ثروت و دارایی هر کس به اندازه‌ای است که می‌تواند از آن بهره‌مند شود، و اگر کسی فقیر باشد، باید از شرم و عجز خود بگریزد."],[204,"که بازار چندان که آکنده‌تر","تهیدست را دل پراکنده‌تر","هرچه بازار پررونق‌تر و پر از کالا باشد، دل شخص بی‌بضاعت و تهیدست، بیش‌تر در اضطراب و پریشانی می‌شود."],[204,"ز پنجه درم پنج اگر کم شود","دلت ریش سرپنجه غم شود","اگر پنج درهم از دارایی‌ات کم شود، دلت به خاطر غم و اندوه دچار رنج و پریشانی می‌شود."],[204,"چو پنجاه سالت برون شد ز دست","غنیمت شمر پنج روزی که هست","وقتی که پنجاه سال از عمرتان گذشت و از دست رفت، باید پنج روزی که هنوز باقی مانده است را غنیمت بشماری و از آن استفاده کنی."],[204,"اگر مرده مسکین زبان داشتی","به فریاد و زاری فغان داشتی","اگر مرده بیچاره زبان داشت، به خاطر درد و رنجی که کشیده، بی‌وقفه ناله و فریاد می‌کرد."],[204,"که ای زنده چون هست امکان گفت","لب از ذکر چون مرده بر هم مخفت","ای انسان زنده، وقتی که امکان سخن گفتن داری، چرا باید لب از ذکر و یاد پروردگار خود ببندی، همان‌طور که مرده که قادر به حرف زدن نیست، خاموش است؟"],[204,"چو ما را به غفلت بشد روزگار","تو باری دمی چند فرصت شمار","وقتی روزگار ما را از حالت بی‌خبری دور کرد، لحظه‌ای وقت را غنیمت بشمار و از آن استفاده کن."],[205,"شبی در جوانی و طیب نعم","جوانان نشستیم چندی بهم","در جوانی، شبی را با دوستان خوش گذراندیم و از زندگی لذت بردیم."],[205,"چو بلبل، سرایان چو گل تازه روی","ز شوخی در افکنده غلغل به کوی","مثل بلبل، زیبا و با آهنگ می‌خوانیم و مانند گل، خوش‌رو و تازه‌ایم که از خوشی و شوخی در کوچه‌ها صدای شاداب و دل‌نواز ایجاد کرده‌ایم."],[205,"جهاندیده پیری ز ما بر کنار","ز دور فلک لیل مویش نهار","پیری که جهان را دیده و تجربه کرده، از ما دور است؛ چون در دوران جوانی‌اش، شب‌هایش با موهای سرش به سپیدی، و روزهایش به رنگ سیاه بوده است."],[205,"چو فندق دهان از سخن بسته بود","نه چون ما لب از خنده چون پسته بود","پیرمرد مانند فندق، زبانش بسته و بی‌سخن است و برخلاف جوان‌ها که چون پسته لب‌هایشان پرخنده است، او نمی‌تواند از دلش خنده‌ای بیافریند."],[205,"جوانی فرا رفت کای پیرمرد","چه در کنج حسرت نشینی به درد؟","ای پیرمرد، جوانی تو سپری شده است، چرا در گوشه‌ای نشسته‌ای و به درد و حسرت می‌خوری؟"],[205,"یکی سر برآر از گریبان غم","به آرام دل با جوانان بچم","ای پیرمرد، بلند شو و از غم و اندوهت فاصله بگیر و به آرامش دل، با جوانان همراه شو و به فعالیت‌های شاد و دل‌نشین بپرداز."],[205,"برآورد سر سالخورد از نهفت","جوابش نگر تا چه پیرانه گفت","سالخورده، سرش را از غم خارج کرد و به جوانان نگاه کرد تا ببیند او چه چیز عاقلانه‌ای می‌گوید."],[205,"چو باد صبا بر گلستان وزد","چمیدن درخت جوان را سزد","چنان‌که بادی نرم و خنک در گلستان وزیده می‌شود، باید درخت جوان را در بر بگیرد و نوازش کند."],[205,"چمد تا جوان است و سرسبز خوید","شکسته شود چون به زردی رسید","تا زمانی که درخت جوان و سرسبز است، باید از میوه‌هایش لذت برد، اما وقتی به زردی و پیری رسید، دیگر نمی‌توان به آن شکل استفاده کرد و خراب می‌شود."],[205,"بهاران که بید آورد بید مشک","بریزد درخت گشن برگ خشک","در بهار، وقتی درخت بید دوباره جوانه می‌زند، بید مشک هم گل‌هایش را می‌فشارد و درختی که میوه‌اش ریخته، برگ‌های خشک را می‌ریزد."],[205,"نزیبد مرا با جوانان چمید","که بر عارضم صبح پیری دمید","خود را در جمع جوانان نپندارم، زیرا در سایه پیری، صبح زندگی‌ام به پایان رسیده است."],[205,"به قید اندرم جره بازی که بود","دمادم سر رشته خواهد ربود","آن باز نری(جان) که در اختیار من بود، هر لحظه نزدیک است رشته را ببرد.یعنی مرگ و پایان زندگی من نزدیک است."],[205,"شما راست نوبت بر این خوان نشست","که ما از تنعم بشستیم دست","شما به‌راستی بر این سفره نشسته‌اید و به نعمت‌ها دست یافته‌اید، در حالی که ما از این رفاه و خوشی‌ها دست کشیده‌ایم."],[205,"چو بر سر نشست از بزرگی غبار","دگر چشم عیش جوانی مدار","وقتی بر سر مقام و بزرگی نشستی، دیگر به فکر لذت‌های جوانی نباش، زیرا آن دوران تمام شده است."],[205,"مرا برف باریده بر پر زاغ","نشاید چو بلبل تماشای باغ","برف، به معنای پیری یا مشکلات زندگی، بر پر زاغ که نماد کم‌عرضگی یا محدودیت است نشسته، نشان می‌دهد که در این شرایط، تماشای زیبایی‌ها و لذت‌های زندگی مانند بلبل تماشای باغ، برای من امکان‌پذیر نیست."],[205,"کند جلوه طاووس صاحب جمال","چه می‌خواهی از باز برکنده بال؟","وقتی زیبایی و جلوه طاووس (که نماد زیبایی و فخر است) را می‌بینی، دیگر چه نیازی به پرنده‌ای مثل باز (که نماد قدرت و شکوه است) داری که بالش را از دست داده و نمی‌تواند پرواز کند؟"],[205,"مرا غله تنگ اندر آمد درو","شما را کنون می‌دمد سبزه نو","زندگی‌ام در جوانی همچون خوشه‌ای از غله بود که در تنگی و سختی سپری شد، اما حالا شما در این دوران جوانی، از خیر و برکت سبزه‌های تازه بهره‌مند می‌شوید."],[205,"گلستان ما را طراوت گذشت","که گل دسته بندد چو پژمرده گشت؟","طراوت و شادابی گلستان ما از بین رفته است؛ چرا که وقتی گل پژمرده می‌شود، دیگر نمی‌تواند دسته‌ای از گل‌ها را ببندد."],[205,"مرا تکیه جان پدر بر عصاست","دگر تکیه بر زندگانی خطاست","به پشتیبانی پدرم تکیه می‌کنم، اما دیگر تکیه بر زندگی کردن و متکی به آن بودن، اشتباه است."],[205,"مسلم جوان راست بر پای جست","که پیران برند استعانت به دست","جوانان به راحتی و نشاط به حرکت و فعالیت می‌پردازند، در حالی که پیران برای عبور از مشکلات و چالش‌های زندگی به کمک و یاری نیاز دارند."],[205,"گل سرخ رویم نگر زر ناب","فرو رفت، چون زرد شد آفتاب","پیشانی و چهره‌ام درخشان و زیبا بوده، اما اکنون با تابش آفتاب، رنگ و روی من زرد شده است."],[205,"هوس پختن از کودک ناتمام","چنان زشت نبود که از پیر خام","آرزو کردن برای پختن چیزی از کودک ناتمام (در حال رشد) به اندازه‌ای زشت نیست که از پیر نادان (بی‌تجربه) باشد."],[205,"مرا می‌بباید چو طفلان گریست","ز شرم گناهان، نه طفلانه زیست","من باید مانند کودکان گریه کنم، نه به خاطر بی‌گناهی، بلکه به دلیل شرم از گناهانم و زندگی نکردن به طور درست و معقول."],[205,"نکو گفت لقمان که نازیستن","به از سالها بر خطا زیستن","لقمان (فیلسوف و حکیم معروف) به‌خوبی گفته که بهتر است انسان اصلا ناز کند و به زندگی نگذرد، تا اینکه سال‌ها در خطا و اشتباه زندگی کند."],[205,"هم از بامدادان در کلبه بست","به از سود و سرمایه دادن ز دست","بهتر است از صبح زود در یک کلبه (محل ساده زندگی) کار و تلاش کرد تا اینکه تمام ثروت و دارایی را به نادرستی از دست داد."],[205,"جوان تا رساند سیاهی به نور","برد پیر مسکین سپیدی به گور","جوان تا زمانی که به سن خردسالی و جوانی رسید، با خوشی و سرمستی زندگی کرد، اما پیرمرد از زمانی که به سرای آخرت (گور) رفت، حسرت روزهای جوانی‌اش را می‌خورد."],[206,"کهنسالی آمد به نزد طبیب","ز نالیدنش تا به مردن قریب","یک پیرمرد به نزد پزشک می‌آید و از درد و رنج خود شکایت می‌کند، به‌گونه‌ای که به مرگ نزدیک شده است."],[206,"که دستم به رگ بر نه، ای نیک رای","که پایم همی بر نیاید ز جای","سالمند از پزشک می‌خواهد که دستش را بگیرد و به رگش بزند، زیرا نمی‌تواند پایش را حرکت دهد و از جایش بلند شود."],[206,"بدین ماند این قامت خفته‌ام","که گویی به گل در فرو رفته‌ام","این بدن من مانند کسی است که در حال خواب است، و به نظر می‌رسد که در گلی فرو رفته‌ام و از دنیای خارج جدا شده‌ام."],[206,"برو، گفت دست از جهان در گسل","که پایت قیامت برآید ز گل","از دنیا دست بردار و برو؛ چراکه ممکن است پای تو در روز قیامت از گلی که در آن افتاده‌ای بیرون آید."],[206,"نشاط جوانی ز پیران مجوی","که آب روان باز ناید به جوی","از پیران و افراد مسن، نباید توقع شادابی و نشاط جوانی را داشت، چون همان‌طور که آب روان به جوی بازنمی‌گردد، شادابی دوران جوانی نیز به دوران پیری برنمی‌گردد."],[206,"اگر در جوانی زدی دست و پای","در ایّام پیری بهش باش و رای","اگر در جوانی و شادابی خود کارهای ناپسندی انجام دادی، در دوران پیری هوشیار و عاقل باش و درست تصمیم بگیر."],[206,"چو دوران عمر از چهل درگذشت","مزن دست و پا کآبت از سر گذشت","وقتی که عمر از چهل سال گذشت، دیگر دست و پا نزن و سعی نکن به جوانی برگردی، چون دوران جوانی دیگر سپری شده است."],[206,"نشاط از من آن گه رمیدن گرفت","که شامم سپیده دمیدن گرفت","شوق و خوشحالی من زمانی از بین رفت که شب به پایان رسید و صبح آغاز شد."],[206,"بباید هوس کردن از سر به در","که دور هوسبازی آمد به سر","باید از نیت برتر و دوری از هوس‌ها دست بردارم، زیرا هوسبازی اکنون بر روح و فکر من حاکم شده است."],[206,"به سبزه کجا تازه گردد دلم","که سبزه بخواهد دمید از گلم؟","دل من کجا را به تازگی سبز ببیند، در حالی که سبزه فقط از گل من می‌رویید؟"],[206,"تفرج‌‎کنان در هوا و هوس","گذشتیم بر خاک بسیار کس","ما در حال لذت‌بردن از خوشی‌ها و شهوات زندگی، بر روی زمین افرادی بسیاری گذر کردیم."],[206,"کسانی که دیگر به غیب اندرند","بیایند و بر خاک ما بگذرند","افرادی که دیگر در این دنیا نیستند، بیایند و بر روی خاک ما قدم بزنند و یاد ما را زنده کنند."],[206,"دریغا که فصل جوانی برفت","به لهو و لعب زندگانی برفت","متأسفانه، فصل جوانی و شادابی گذشت و ما آن را در خوش‌گذرانی و بازی‌های بی‌مورد سپری کردیم."],[206,"دریغا چنان روح‌‎پرور زمان","که بگذشت بر ما چو برق یمان","افسوس که زمانی که روح را شاد می‌کند، مانند برق کوتاه و ناگهانی بر ما گذشت."],[206,"ز سودای آن پوشم و این خورم","نپرداختم تا غم دین خورم","از عشق و آرزوهای پوچ چشم پوشیده‌ام و مشغول لذت‌های دنیوی هستم، اما هنوز موفق نشده‌ام به مسائل دینی خود بپردازم و غم آنها را بخورم."],[206,"دریغا که مشغول باطل شدیم","ز حق دور ماندیم و غافل شدیم","متأسفانه در پی حواشی زندگی و سرگرمی‌های بیهوده، از حق و حقیقت دور شده و غافل مانده‌ایم."],[206,"چه خوش گفت با کودک آموزگار","که: کاری نکردیم و شد روزگار","آموزگار به کودک می‌گوید که هیچ کار خوبی انجام نداده‌ایم و به همین دلیل زمان و زندگی‌مان به بطالت گذشت."],[207,"جوانا ره طاعت امروز گیر","که فردا جوانی نیاید ز پیر","ای جوان، امروز به راه بندگی و عبادت بپرداز، زیرا فردا دیگر نمی‌توانی جوانی را تجربه کنی و به پیری خواهی رسید."],[207,"فراغ دلت هست و نیروی تن","چو میدان فراخ است گویی بزن","دل تو آرام و بی‌دغدغه است و بدن تو در قوت و توانایی است؛ مانند یک میدان وسیع، اکنون فرصت مناسبی برای عمل و تلاش است."],[207,"قضا روزگاری ز من در ربود","که هر روزی از وی شبی قدر بود","سرنوشت یا قضا و قسمت، زمانی را از من گرفت که هر روز آن، شبی ارزشمند و مهم به حساب می‌آمد."],[207,"من آن روز را قدر نشناختم","بدانستم اکنون که در باختم","من آن زمان که جوان بودم و جوانی‌ام را غنیمت نمی‌شمردم، حالا می‌فهمم که چه فرصتی را از دست داده‌ام و به خاطر آنچه به دست نیاورده‌ام متأسفم."],[207,"چه کوشش کند پیر خر زیر بار؟","تو می‌رو که بر بادپایی سوار","پیرمرد نه توانایی دارد و نه قدرت تلاش و کار کردن، بنابراین بهتر است تو به جایی بروی که قدرت و جوانی‌ات را خرج کنی و بهره بیشتری ببری."],[207,"شکسته قدح ور ببندند چست","نیاورد خواهد بهای درست","اگر قدح شراب بشکند و بندند، با این حال سرگشته و بی‌رمق می‌ماند و نمی‌تواند برای خود بهایی مناسب بیاورد."],[207,"کنون کاوفتادت به غفلت ز دست","طریقی ندارد مگر باز بست","حال که از روی غفلت در جوانی عمر را از دست داده‌ای، دیگر راهی برای جبران این بی‌احتیاطی وجود ندارد مگر این‌که دوباره به خود جمع و رجوع کنی."],[207,"که گفتت به جیحون در انداز تن؟","چو افتاد، هم دست و پایی بزن","وقتی کسی به جیحون (رودخانه) می‌افتد، چگونه می‌تواند انتظار داشته باشد که دوباره تنش را در آن بیندازد؟ در اینجا اشاره به این است که بعد از افتادن، برای نجات خود باید دست و پا بزند و تلاش کند."],[207,"به غفلت بدادی ز دست آب پاک","چه چاره کنون جز تیمم به خاک؟","به خاطر غفلت و از دست دادن جوانی و فرصت‌ها، دیگر هیچ چاره‌ای جز تیمم به خاک نمانده است. این به معنی این است که وقتی فرصت‌های خوب را از دست می‌دهیم، نمی‌توانیم به راحتی آن‌ها را بازیابی کنیم."],[207,"چو از چابکان در دویدن گرو","نبردی، هم افتان و خیزان برو","اگر نتوانستی با چابک‌ها (آدم‌های سریع و تندرو) رقابت کنی و در دویدن از آن‌ها اثر بگذاری، پس با حالتی ناتوان و افتان و خیزان ادامه بده."],[207,"گر آن بادپایان برفتند تیز","تو بی دست و پای از نشستن بخیز","اگر آن جوانان چابک و تیزپا رفتند، تو که نیرویی نداری، از نشستن برخیز و حرکت کن."],[208,"شبی خوابم اندر بیابان فید","فرو بست پای دویدن به قید","شب هنگام در بیابان خوابم برد و در خواب، پایم به وسیله‌ی قید (دست و پاگیر) بسته شد و نتوانستم بدوم."],[208,"شتربانی آمد به هول و ستیز","زمام شتر بر سرم زد که خیز","یک شتربان به حالتی پرتنش و اضطراب به من نزدیک شد و با شدت به مهار شتر (زمام) من ضربه زد و از من خواست که بیدار شوم و حرکت کنم."],[208,"مگر دل نهادی به مردن ز پس","که بر می‌نخیزی به بانگ جرس؟","آیا به مرگ خود فکر کرده‌ای که وقتی صدای ناقوس یا زنگ شنیده می‌شود، دیگر قدرت برخواستن و حرکت نداشته باشی؟"],[208,"مرا همچو تو خواب خوش در سر است","ولیکن بیابان به پیش اندر است","من هم مانند تو خواب خوشی در سر دارم، اما در مقابل مسیر بیابان و دشواری‌ها قرار دارد و نمی‌توانم به راحتی از آن عبور کنم."],[208,"تو کز خواب نوشین به بانگ رحیل","نخیزی، دگر کی رسی در سبیل","ای کسی که از خواب خوش بیدار نمی‌شوی و به صدای حرکت کاروان توجهی نداری، دیگر چه زمانی به راه درست و زندگی واقعی خواهی رسید؟"],[208,"فرو کوفت طبل شتر ساروان","به منزل رسید اول کاروان","ساربان، که صدای طبل شتر را می‌زند، به منزل رسید و این نشان می‌دهد که کاروان به مقصدش رسیده است."],[208,"خنک هوشیاران فرخنده بخت","که پیش از دهلزن بسازند رخت","خوشا به حال کسانی که با درایت و شانس خوب، پیش از آنکه پیش‌دار و طبل‌زن به مقصد برسد، خود را آماده کرده و لباس سفر را بر تن کنند."],[208,"به ره خفتگان تا بر آرند سر","نبینند ره رفتگان را اثر","خفتگان در راه خواب هستند و تا زمانی که بیدار نشوند، آثار و نشانه‌های عابران را نمی‌بینند. در واقع، کسانی که در خوابند از پیشرفت و تحولات دیگران بی‌خبرند."],[208,"سبق برد رهرو که برخاست زود","پس از نقل بیدار بودن چه سود؟","ره‌رو (مسافر یا فردی که در راه است) زودتر حرکت کرد و به راه افتاد، اما پرسش این است که پس از این نقل و جابجایی، بیدار بودن چه فایده‌ای دارد؟"],[208,"یکی در بهاران بیفشانده جو","چه گندم ستاند به وقت درو؟","اگر کسی در بهار دانه جو را بکارد، چه فایده‌ای دارد که در فصل درو گندم برداشت کند؟ در واقع، این بیت به معنای نادرست بودن اقدام پیش از زمان مناسب است."],[208,"کنون باید ای خفته بیدار بود","چو مرگ اندر آرد ز خوابت، چه سود؟","اکنون باید ای کسی که خوابیده‌ای بیدار شوی، زیرا وقتی مرگ از خواب تو را بیدار کند، دیگر چه فایده‌ای دارد؟"],[208,"چو شیبت در آمد به روی شباب","شبت روز شد دیده بر کن ز خواب","به محض اینکه پیری به چهره جوانی می‌نشیند، روزگار پایان خوشی را آغاز می‌کند؛ بنابراین، باید از خواب بیدار شوی و واقعیت‌ها را ببینی."],[208,"من آن روز بر کندم از عمر امید","که افتادم اندر سیاهی سپید","در آن روز تصمیم گرفتم دیگر به عمرم امیدی نداشته باشم، چرا که احساس کردم به زودی به سپیدی موی کهنسالی و مرگ نزدیک می‌شوم."],[208,"دریغا که بگذشت عمر عزیز","بخواهد گذشت این دمی چند نیز","ای کاش عمر گران‌بهای من سپری نشود، اما می‌دانم که حتی این لحظه کوتاه نیز به زودی می‌گذرد."],[208,"گذشت آنچه در ناصوابی گذشت","ور این نیز هم در نیابی گذشت","هر آنچه در گمراهی و نادرستی گذشت، گذشته و دیگر قابل بازگشت نیست و اگر همین وضعیت ادامه یابد، تو هم به زودی گذر خواهی کرد و متوجه نخواهی شد."],[208,"کنون وقت تخم است اگر پروری","گر امید داری که خرمن بری","حال وقتی است که باید درخت خود را بکارید؛ اگر منتظری که در آینده محصول خوبی به دست بیاوری، باید اکنون زحمت بکشی و تلاش کنی."],[208,"به شهر قیامت مرو تنگدست","که وجهی ندارد به حسرت نشست","در روز قیامت با دست خالی و بدون عمل نیکو وارد نشو، زیرا در آنجا هیچ بهره‌ای برای کسانی که فقط حسرت می‌خورند، وجود ندارد."],[208,"گرت چشم عقل است تدبیر گور","کنون کن که چشمت نخورده‌ست مور","اگر عقل و هوش تو بیدار باشد، باید برای کارهای آینده‌ات (مثلا مرگ) تدبیری بیندیشی، زیرا تا حالا به بی‌خبری و غفلت زندگی کرده‌ای."],[208,"به مایه توان ای پسر سود کرد","چه سود افتد آن را که سرمایه خورد؟","اگر در زندگی از نیروی خود بهره‌برداری کنی، سود می‌کنی، اما چه فایده‌ای دارد اگر از سرمایه و دارایی‌ات استفاده کنی و آن را از بین ببری؟"],[208,"کنون کوش کآب از کمر در گذشت","نه وقتی که سیلابت از سر گذشت","اکنون تلاش کن که آبی که از کمر (بدن) تو می‌گذرد، از آن استفاده کنی و کاری برای خود انجام بده، نه زمانی که سیلاب (مشکلات یا عمر) از سر تو گذشت و دیگر فرصتی برای کار کردن نداشتی."],[208,"کنونت که چشم است اشکی ببار","زبان در دهان است عذری بیار","اکنون که چشمان تو پر از اشک است، از تو می‌خواهم که در زبان خود عذری بیاوری و بگویی."],[208,"نه پیوسته باشد روان در بدن","نه همواره گردد زبان در دهن","روح انسان همیشه در بدنش باقی نمی‌ماند و زبان نیز همیشه در دهانش نیست."],[208,"کنون بایدت عذر تقصیر گفت","نه چون نفس ناطق ز گفتن بخفت","اکنون باید عذر و پوزش خود را بابت کمبودها و خطاهایت بیان کنی، نه مانند نفسی که برای خواب و آسایش از سخن گفتن بازایستد."],[208,"ز دانندگان بشنو امروز قول","که فردا نکیرت بپرسد به هول","از دانایان بشنو که امروز باید حرف‌های صحیح را یاد بگیری، زیرا فردا در قیامت از تو سؤال می‌کند و این پرسش به شدت ترسناک خواهد بود."],[208,"غنیمت شمار این گرامی نفس","که بی مرغ قیمت ندارد قفس","این نفس گران‌بهار را غنیمت بدان، زیرا که بدون روح، قفس (بدن) ارزشی ندارد."],[208,"مکن عمر ضایع به افسوس و حیف","که فرصت عزیز است و الوقت سیف","عمر خود را به حسرت و ناامیدی هدر نده، چرا که زمان یک فرصت باارزش است و باید از آن به درستی بهره‌برداری کرد."],[209,"قضا زنده‌ای را رگ جان برید","دگر کس به مرگش گریبان درید","قضا (سرنوشت) جان انسان زنده‌ای را گرفته و او را به مرگ نزدیک کرده است، دیگران هم به خاطر این مرگ او به سوگ و اندوه نشسته‌اند."],[209,"چنین گفت بیننده‌ای تیز هوش","چو فریاد و زاری رسیدش به گوش","بیننده‌ای با هوش و زیرک این‌گونه گفت: وقتی که صدای فریاد و زاری به گوشش رسید."],[209,"ز دست شما مرده بر خویشتن","گرش دست بودی دریدی کفن","اگر دست شما به او می‌رسید، می‌توانستید به او کمک کنید و از مرگ نجاتش دهید، اما حالا که در دست شما نیست، او مرده و حتی اگر دست شما به او برسد، کار از کار گذشته و دیگر نمی‌توانید او را زنده کنید."],[209,"که چندین ز تیمار و دردم مپیچ","که روزی دو پیش از تو کردم بسیچ","این بیت اشاره به این دارد که دیگران را از غصه و درد خود درآورید و آنها را درگیر نکنید، زیرا زمانی پیش از این، خود فرد تلاش کرده یا رنج کشیده است. به عبارت دیگر، وی به طرف مقابل می‌گوید که از نگرانی‌هایش بپرهیزد، چون او پیشتر به اندازه کافی از این مسایل رنج برده است."],[209,"فراموش کردی مگر مرگ خویش","که مرگ منت ناتوان کرد و ریش","آیا فراموش کردی که مرگ خودت را فراموش کنی؟ مرگ به دلیل ناتوانی انسان را به زانوی درآورد و اندوه و غم را برای او به ارمغان آورده است."],[209,"محقق که بر مرده ریزد گلش","نه بر وی که بر خود بسوزد دلش","شخصی که بر جنازه‌ی مرده گلی می‌ریزد، در واقع برای خود گریه می‌کند و دلش برای خودش می‌سوزد، نه برای مرده."],[209,"ز هجران طفلی که در خاک رفت","چه نالی؟ که پاک آمد و پاک رفت","از جدایی کودکی که در خاک دفن شد، چه غم و گله‌ای داری؟ او مظلوم و بی‌گناه به دنیا آمده و بی‌گناه نیز از آن رفته است."],[209,"تو پاک آمدی بر حذر باش و پاک","که ننگ است ناپاک رفتن به خاک","تو به طور پاک و نیکو به دنیا آمده‌ای، بنابراین باید در زندگی‌ات مواظب باشی و خود را پاک نگه‌داری، زیرا این شرم‌آور است که با ناپاکی از دنیا بروی."],[209,"کنون باید این مرغ را پای بست","نه آنگه که سررشته بردت ز دست","اکنون باید از این پرنده (عشق یا خواهش نفس) مراقبت کنی و آن را تحت کنترل درآوری، نه اینکه زمانی به فکر آن بیفتی که دیگر کنترلش از دستت رفته باشد."],[209,"نشستی به جای دگر کس بسی","نشیند به جای تو دیگر کسی","اگر تو در جایی به جای دیگران نشسته‌ای، بدان که خیلی زود فرد دیگری هم به جای تو خواهد نشسته و تو را کنار خواهد زد."],[209,"اگر پهلوانی و گر تیغزن","نخواهی به در بردن الا کفن","اگر می‌خواهی مرد بزرگی باشی یا شمشیرزنی توانا، باید بدانید که در نهایت، هیچ‌چیز جز کفن و مرگ به دردت نمی‌خورد."],[209,"خر وحش اگر بگسلاند کمند","چو در ریگ ماند شود پای بند","اگر خر وحشی در بیابان از دستان شکارچی فرار کند، اما به دام ریگ‌ها بیفتد، دیگر نمی‌تواند از آنجا فرار کند و به دام خواهد افتاد."],[209,"تو را نیز چندان بود دست زور","که پایت نرفته‌ست در ریگ گور","تو هم به اندازه‌ای قدرت داری که پای تو هنوز در گور نیفتاده است؛ یعنی تا زمانی که زنده‌ای، می‌توانی از خطرها و مشکلات فرار کنی."],[209,"منه دل بر این سالخورده مکان","که گنبد نپاید بر او گردکان","به دل خود مکان نده به این place که این زمین پیر و سالخورده است و گنبد آسمان بر روی آن پایدار نمی‌ماند."],[209,"چو دی رفت و فردا نیامد به دست","حساب از همین یک نفس کن که هست","عمر انسان به لحظه حال وابسته است و گذشته (دی) رفته و آینده (فردا) هنوز نیامده است؛ بنابراین، از همین لحظه کنونی، که هست، بهره‌برداری کن."],[210,"فرو رفت جم را یکی نازنین","کفن کرد چون کرمش ابریشمین","جم (پادشاه افسانه‌ای) را که به خواب غفلت رفته بود، پس از مدت‌ها بیداری، یک انسان شایسته و نازنین به خاک سپرد و او را با کفنی زیبا همچون ابریشم می‌آراید."],[210,"به دخمه برآمد پس از چند روز","که بر وی بگرید به زاری و سوز","پس از گذشت چند روز، به آرامگاه او رفت و با ناله و گریه‌ای عمیق بر او افسوس خورد."],[210,"چو پوسیده دیدش حریرین کفن","به فکرت چنین گفت با خویشتن","وقتی دید که حریر زرد و پوسیده شده است، در فکر خود چنین گفت که..."],[210,"من از کرم برکنده بودم به زور","بکندند از او باز کرمان گور","من ابریشم رو با زور و زحمت از کرم ابریشم گرفته بودم ، اما اکنون کرم های گور کفن رو که از ابریشم هست از وی گرفتند"],[210,"در این باغ سروی نیامد بلند","که باد اجل بیخش از بن نکند","در این باغ، درختی بلند به نام سرو وجود ندارد که باد مرگ آن را از ریشه قطع نکند. این بیت به نوعی اشاره به ناپایداری زندگی و قطعیت مرگ دارد."],[210,"قضا نقش یوسف جمالی نکرد","که ماهی گورش چو یونس نخورد","تقدیر و سرنوشت به هرکسی که مانند یوسف زیبایی و شکوه ببخشد مرگ آن زیبایی را از وی می‌گیرد و او را نابود میکند مانند ماهی که یونس را خورده است"],[210,"دو بیتم جگر کرد روزی کباب","که می‌گفت گوینده‌ای با رباب:","روزی دو بیت شعر مثل کبابی دل‌سوز و جان‌گداز بود که فردی با ساز رباب (ساز موسیقی) در مورد آن شعری می‌خواند."],[210,"دریغا که بی ما بسی روزگار","بروید گل و بشکفد نوبهار","افسوس که روزهای زیادی بعد از ما سپری می‌شود و روزگار به کار خود مثل همیشه ادامه می‌دهد"],[210,"بسی تیر و دی ماه و اردیبهشت","برآید که ما خاک باشیم و خشت","ماه ها و زمان‌های بسیاری خواهد آمد و خواهد رفت در حالی که ما مرده‌ایم و تبدیل به خاک و خشت شده‌ایم و جهان بدون ما به هستی خود ادامه میدهد"],[211,"یکی پارسا سیرت حق پرست","فتادش یکی خشت زرین به دست","یک مرد پارسا و پرهیزگار که با نیکی‌ها در ارتباط بود، ناگهان خشت زرینی (نمادی از ثروت یا ارزش) به دستش افتاد."],[211,"سر هوشمندش چنان خیره کرد","که سودا دل روشنش تیره کرد","فرد باهوش و زیرک به گونه‌ای او را مجذوب کرد که آرزوها و خواسته‌های قلبی‌اش را تار کرد و در او ایجاد سردرگمی نمود."],[211,"همه شب در اندیشه کاین گنج و مال","در او تا زیم ره نیابد زوال","هر شب در این فکر بود که تا زمانی که زنده ام این گنج از بین نرود"],[211,"دگر قامت عجزم از بهر خواست","نباید بر کس دوتا کرد و راست","بیشتر از این که بخواهم به خاطر تصمیم به جمع‌آوری ثروت تلاش کنم، دیگر نمی‌توانم خودم را به دیگران نشان دهم و نیاز نیست که نقاب راست‌گویی به خود بزنم."],[211,"سرایی کنم پای بستش رخام","درختان سقفش همه عود خام","می‌خواهم خانه‌ای بسازم که پایه‌هایش از سنگ مرمر باشد و سقفش از چوب‌های خوشبو."],[211,"یکی حجره خاص از پی دوستان","در حجره اندر سرا بوستان","یک اتاق ویژه برای دوستانم می‌سازم که در همان حیاط و باغی که اشاره شده است، قرار دارد."],[211,"بفرسودم از رقعه بر رقعه دوخت","تف دیگدان چشم و مغزم بسوخت","از وقتی که نامه‌ها را به هم دوخته‌ام، آتش عشق جان و دل مرا سوزانده است."],[211,"دگر زیردستان پزندم خورش","به راحت دهم روح را پرورش","من دیگر زیر دستانم را می‌پزم و خوراکی خوشمزه می‌دهم تا روح خود را پرورش دهم."],[211,"به سختی بکشت این نمد بسترم","روم زین سپس عبقری گسترم","به سختی این نمد که برای بستر من درست کرده‌اند را نابود می‌کنم، سپس برای جلب محبت و رضایت خداوند، فرش عطرآگینی برای خود می‌گسترم."],[211,"خیالش خرف کرد و کالیوه رنگ","به مغزش فرو برده خرچنگ چنگ","تصویر خیال او را دچار جنون کرده و رنگی از کالیوه (پوشش یا زینتی که در اشعار به کار می‌رود) به ذهنش آورده که مانند خرچنگی است که در چنگ او قرار دارد."],[211,"فراغ مناجات و رازش نماند","خور و خواب و ذکر و نمازش نماند","آرامش مناجات و راز و نیاز من دیگر باقی نمانده و حتی خوردن و خوابیدن و ذکر و نماز هم برایم معنا ندارد."],[211,"به صحرا برآمد سر از عشوه مست","که جایی نبودش قرار نشست","عاشق به صحرا رفت و از سر شوق و زیبایی مست شده بود، به‌طوری که در جایی نمی‌توانست آرام بگیرد."],[211,"یکی بر سر گور گل می سرشت","که حاصل کند زآن گل گور خشت","شخصی بر مزار کسی گل می‌کاشت تا از آن گل، یک آجر برای ساختن خانه‌ای بیافریند. این کار نماد تلاش برای به دست آوردن چیزی از چیزهایی است که به نظر می‌رسد نمی‌توانند نسل جدیدی بسازند."],[211,"به اندیشه لختی فرو رفت پیر","که ای نفس کوته نظر پند گیر","پیر در فکر و اندیشه‌ای عمیق فرو رفته و به نفس خود، که دارای دیدگاه سطحی است، توصیه می‌کند که درس عبرت بگیرد."],[211,"چه بندی در این خشت زرین دلت","که یک روز خشتی کنند از گلت؟","در قلب تو چه چیزی وجود دارد که باعث می‌شود روزی بر اثرت از خاکت خشت طلا بسازند؟ این بیت به ارزش‌های درونی و روحی انسان اشاره دارد و از او می‌خواهد به خود و ظرفیت‌هایش بیندیشد."],[211,"طمع را نه چندان دهان است باز","که بازش نشیند به یک لقمه آز","طمع به اندازه‌ای نیست که بتواند به راحتی ارضا شود، چرا که یک لقمه از آن نمی‌تواند به طور کامل آن را سیراب کند."],[211,"بدار ای فرومایه زین خشت دست","که جیحون نشاید به یک خشت بست","ای انسان پست و حقیر، از این خشت (تکه‌ زمین) برخیز که نمی‌توان با یک تکه زمین (خشت) جیحون (رودخانه‌ بزرگ و مهم) را بست و مسدود کرد. یعنی ارزش و اهمیت واقعی چیزها را نمی‌توان با چیزهای بی‌اهمیت محدود کرد."],[211,"تو غافل در اندیشه سود و مال","که سرمایه عمر شد پایمال","تو در غفلت به دنبال سود و ثروت هستی، در حالی که این تلاش‌ها باعث ضایع شدن عمرت شده است."],[211,"غبار هوا چشم عقلت بدوخت","سموم هوس کشت عمرت بسوخت","گرد و غبار دنیا بر چشم عقل تو نشسته و هوای نفس و تمنیات بیهوده، عمر تو را به تباهی کشانده است."],[211,"بکن سرمه غفلت از چشم پاک","که فردا شوی سرمه در چشم خاک","غفلت ها را که همچون سرمه در چشم تو قرار دارد را از خود دور کن که فردا ( در آینده نزدیک) از دنیا می‌روی و همچون سرمه که در چشم قرا می‌گیرد تو هم در دل خاک پنهان خواهی شد"],[212,"میان دو تن دشمنی بود و جنگ","سر از کبر بر یکدگر چون پلنگ","بین دو نفر کینه و جنگی وجود داشت که ناشی از خودبزرگ‌بینی و تکبر آنها بود، به گونه‌ای که مانند پلنگ‌ها به هم حمله می‌کردند."],[212,"ز دیدار هم تا به حدی رمان","که بر هر دو تنگ آمدی آسمان","از دیدار یکدیگر چنان در رنج و عذاب بودند که آسمان بر هر دو، تنگ و محدود شده بود."],[212,"یکی را اجل در سر آورد جیش","سرآمد بر او روزگاران عیش","سرانجام مرگ، برای یکی از آن دو شخص فرا رسید و وقت خوشی و زندگی‌اش به پایان رسید."],[212,"بداندیش او را درون شاد گشت","به گورش پس از مدتی برگذشت","بداندیش در درونش خوشحال شد و از مرگ او پس از مدتی گذشت."],[212,"شبستان گورش در اندوده دید","که وقتی سرایش زر اندوده دید","در گور او را روزی خواب دید که در آنجا زیبایی و ثروتی دیده می‌شود، به طوری که دیوارهایش با طلا پوشانده شده است."],[212,"خرامان به بالینش آمد فراز","همی گفت با خود لب از خنده باز","کسی که به آرامی و با وقار به سوی او می‌رود، در دلش زمزمه می‌کند و با خود می‌گوید که لبخند به لب دارد."],[212,"خوشا وقت مجموع آن کس که اوست","پس از مرگ دشمن در آغوش دوست","نیکوست زمانه‌ای که کسی زنده باشد و پس از مرگ دشمنش در آغوش دوستش آرامش پیدا کند."],[212,"پس از مرگ آن کس نباید گریست","که روزی پس از مرگ دشمن بزیست","کاربر: از مرگ کسی که از مرگ دشمنش خشنود میشود نباید غمگین و ناراحت شد."],[212,"ز روی عداوت به بازوی زور","یکی تخته برکندش از روی گور","از روی دشمنی و کینه، یکی از افراد بی‌رحمانه جنازه‌ی او را از روی قبر بلند کرده و مورد بی‌احترامی قرار می‌دهد."],[212,"سر تاجور دیدش اندر مغاک","دو چشم جهان بینش آکنده خاک","تاجور (کسی که در اینجا اشاره به انسان دارد) در گودالی (یعنی مغاک) دیده می‌شود و دو چشمی که همواره به جهان می‌نگرد، از خاک پر شده است. این تصویر نشان‌دهنده وضعیت نامطلوب و غم‌انگیز اوست که به خاطر عداوت و مرگ به این حال افتاده است."],[212,"وجودش گرفتار زندان گور","تنش طعمه کرم و تاراج مور","وجود او در بند و محبوس قبر است و بدنش به تدارک و تغذیه کرم و مور (حشره‌ای که به لاشه‌ها حمله می‌کند) تبدیل شده است."],[212,"چنان تنگش آکنده خاک استخوان","که از عاج پر توتیا سرمه دان","بدن او به قدری در زیر خاک و درون قبر تنگ و فشرده شده که مانند کوزه‌ای پر از سسی (توتیا) که در قدیم برای سرمه‌دان استفاده می‌شده، آکنده و پر است."],[212,"ز دور فلک بدر رویش هلال","ز جور زمان سرو قدش خلال","از دور آسمان هلال (ماه) بر چهره‌اش مانند ستاره‌ می‌تابد و در نتیجه، به خاطر بدی‌های زمان، قامتش مانند سرو (درخت بلندی) آسیب دیده و دچار نقصان شده است."],[212,"کف دست و سرپنجه زورمند","جدا کرده ایام بندش ز بند","ایام (روزها) را به وسیله دست و قدرت خود از بند مشکلات و سختی‌ها آزاد کرده‌ای."],[212,"چنانش بر او رحمت آمد ز دل","که بسرشت بر خاکش از گریه گل","او به قدری تحت تأثیر رحمت و محبت قرار گرفت که از دلش به خاطر او اشک ریخت و با گریه‌اش بر خاکش گل را رویاند."],[212,"پشیمان شد از کرده و خوی زشت","بفرمود بر سنگ گورش نبشت","او از رفتار و اعمال زشت خود پشیمان شد و دستور داد بر سنگ قبرش بنویسند."],[212,"مکن شادمانی به مرگ کسی","که دهرت نماند پس از وی بسی","به خاطر مرگ کسی نباید شادمانی کنی، زیرا زندگی پس از او همچنان ادامه دارد و نمی‌توان از خوشحالی بر مرگ دیگران بهره‌مند شد."],[212,"شنید این سخن عارفی هوشیار","بنالید کای قادر کردگار","عارف هوشیار این سخن را شنید و به شدت نالید و گفت: ای خداوند توانا!"],[212,"عجب گر تو رحمت نیاری بر او","که بگریست دشمن به زاری بر او","تعجبی ندارد اگر تو بر او رحم نکنی، در حالی که دشمن به خاطر او به شدت می‌گرید و زاری می‌کند."],[212,"تن ما شود نیز روزی چنان","که بر وی بسوزد دل دشمنان","بدن ما روزی به وضعی درمی‌آید که دل دشمنان بر آن بسوزد و ناراحت شوند."],[212,"مگر در دل دوست رحم آیدم","چو بیند که دشمن ببخشایدم","اگر در دل دوست رحم و محبت نداشته باشم، چه طور ممکن است وقتی دشمن را می‌بخشم، او را با محبت و رحمت بنگرد؟"],[212,"به جایی رسد کار سر دیر و زود","که گویی در او دیده هرگز نبود","کار به جایی می‌رسد که گویی در آن زمان و مکان، هیچ‌گاه چنین واقعه‌ای رخ نداده است."],[212,"زدم تیشه یک روز بر تل خاک","به گوش آمدم ناله‌ای دردناک","روزی با تیشه‌ام بر تلی از خاک زدم که ناگهان ناله‌ای دردآور به گوشم رسید."],[212,"که زنهار اگر مردی آهسته‌تر","که چشم و بناگوش و روی است و سر","باید با احتیاط و آرامش بیشتری عمل کنی، زیرا از چشم و گوش و چهره و سر انسان اهمیت زیادی برخوردار است و نمی‌توان این اجزا را نادیده گرفت."],[213,"شبی خفته بودم به عزم سفر","پی کاروانی گرفتم سحر","یک شب در حال خواب بودم که تصمیم به سفر گرفتم و هنگام سحر به کاروانی پیوستم."],[213,"که آمد یکی سهمگین باد و گرد","که بر چشم مردم جهان تیره کرد","یک باد شدید و غبارآلود آمد که باعث شد دید مردم دنیا تاریک و ناواضح شود."],[213,"به ره در یکی دختر خانه بود","به معجر غبار از پدر می‌زدود","در مسیر، دختری بود که در خانه‌اش، چادر (معجر) او غبار از پدرش می‌زدود؛ به این معنی که در زمان گرد و غبار، پدرش را از غم و اندوه دور می‌کرد."],[213,"پدر گفتش ای نازنین چهر من","که داری دل آشفته مهر من","پدر به دخترش می‌گوید: ای عزیز، زیبایی چهره‌ات باعث شده که دل من پر از عشق و آشفتگی شود."],[213,"نه چندان نشیند در این دیده خاک","که بازش به معجر توان کرد پاک","چقدر خاک در این چشم نمی‌نشیند که بتوان آن را به حجاب (معجر) برگرداند و پاک کرد. یعنی، اگر خاکی در چشم بیفتد، به سختی می‌توان آن را پاک کرد."],[213,"بر این خاک چندان صبا بگذرد","که هر ذره از ما به جایی برد","زندگی ما در این دنیای خاکی به قدری کوتاه است که حتی یک نسیم (صبا) هر ذره‌ای از ما را به سمت مقصدی می‌برد و در این فرآیند، ما به سرعت از بین می‌رویم."],[213,"تو را نفس رعنا چو سرکش ستور","دوان می‌برد تا سر شیب گور","نفس جوان تو مانند اسب سرکش و شجاع به سرعت تو را به سر منظره مرگ می‌برد و از کنترل تو خارج می‌شود."],[213,"اجل ناگهت بگسلاند رکیب","عنان باز نتوان گرفت از نشیب","مرگ ناگهان تو را از دنیای زندگی جدا می‌کند و مانند اسبی که به سوی پایین شیب می‌رود، نمی‌توانی مهار آن را بگیری."],[214,"خبر داری ای استخوانی قفس","که جان تو مرغی است نامش نفس؟","ای استخوانی که به مانند قفس هستی، آیا می‌دانی جان تو مانند پرنده‌ای است که نفس نام دارد و در این قفس اسیر است؟"],[214,"چو مرغ از قفس رفت و بگسست قید","دگر ره نگردد به سعی تو صید","زمانی که مرغ از قفس آزاد شود و قید و بندهایش را بشکند، دیگر نمی‌توان آن را با تلاش خود به دام انداخت."],[214,"نگه دار فرصت که عالم دمی است","دمی پیش دانا به از عالمی است","فرصت را غنیمت بدان، زیرا زندگی هر لحظه‌اش ارزشمند است و حتی یک لحظه آگاهی و دانش از تمام عمر یک عالم بهتر است."],[214,"سکندر که بر عالمی حکم داشت","در آن دم که بگذشت و عالم گذاشت","سکندر که بر دنیا تسلط داشت، در لحظه‌ای که از زندگی خود گذشت و این دنیا را ترک کرد، همه چیز را از دست داد."],[214,"میسر نبودش کز او عالمی","ستانند و مهلت دهندش دمی","برای اسکندر در لحظه ی مرگ این امکان وجود نداشت که تمام عالمی که بر آن حاکم بود را از او بگیرند و در ازای آن لحظه ای فرصت بیشتر برای زندگی در این عالم را به او بدهند."],[214,"برفتند و هر کس درود آنچه کشت","نماند به جز نام نیکو و زشت","همه رفتند و هر کسی به آنچه که کشت، درود می‌فرستد، تنها چیزی که باقی می‌ماند، نام نیک و بد اوست."],[214,"چرا دل بر این کاروانگه نهیم؟","که یاران برفتند و ما بر رهیم","چرا باید دل‌نگران این جا باشیم؟ زیرا دوستان ما رفته‌اند و ما هنوز در راه هستیم."],[214,"پس از ما همین گل دمد بوستان","نشینند با یکدگر دوستان","پس از ما، همین گل‌ها در بوستان شکوفا خواهند شد و دوستان با یکدیگر خواهند بود."],[214,"دل اندر دلارام دنیا مبند","که ننشست با کس که دل بر نکند","به دل خود در این دنیای آرامش و خوشی اعتماد نکن، زیرا هیچ‌کس نمی‌تواند با دل خود در این دنیا ماندگار شود و از آن دل برکنار نخواهد شد."],[214,"چو در خاکدان لحد خفت مرد","قیامت بیفشاند از موی گرد","هنگامی که مرد در خاک‌سپاری‌اش در خاک تن می‌خوابد، در روز قیامت، موهایش که به گرد تبدیل شده، برمی‌خیزد و به یادش می‌آورد که چگونه زندگی کرده است."],[214,"سر از جیب غفلت برآور کنون","که فردا نماند به حسرت نگون","حالا که فردا برای تو جاودانه نخواهد ماند، از خواب غفلت بیدار شو و هوشیار باش، تا در آینده به حسرت نیفتی."],[214,"نه چون خواهی آمد به شیراز در","سر و تن بشویی ز گرد سفر","هرگز نباید منتظر بمانی تا به شیراز بیایی و پس از آن از گرد و غبار سفر خود پاک شوی."],[214,"پس ای خاکسار گنه عن قریب","سفر کرد خواهی به شهری غریب","ای بنده حقیر که گناه کرده‌ای، به زودی سفر خواهی کرد و به شهری نا آشنا خواهی رفت."],[214,"بران از دو سرچشمه دیده جوی","ور آلایشی داری از خود بشوی","از دو چشمت، اشک‌ها را بیرون بریز و اگر آلودگی و گناهی در وجودت هست، آن را از خود دور کن."],[215,"ز عهد پدر یادم آید همی","که باران رحمت بر او هر دمی","یاد من می‌آید که پدرم در زمان حیاتش، هر لحظه مورد الطافت و رحمت خداوند بود."],[215,"که در طفلیم لوح و دفتر خرید","ز بهرم یکی خاتم زر خرید","در دوران کودکی، از پدرم یادم می‌آید که برای من لوح و دفتری خرید و به این خاطر خاتمی از طلا نیز تهیه کرد."],[215,"به در کرد ناگه یکی مشتری","به خرمایی از دستم انگشتری","ناگهان یکی از خریداران به دکانی وارد شد و انگشتری را در مقابل من گذاشت و خواست که به جای آن خرمایی بگیرد."],[215,"چو نشناسد انگشتری طفل خرد","به شیرینی از وی توانند برد","اگر کودک کوچک انگشتری را نشناسد، دیگران به راحتی می‌توانند آن را از او بگیرند، حتی اگر آن انگشتری شیرین و جذاب باشد."],[215,"تو هم قیمت عمر نشناختی","که در عیش شیرین برانداختی","تو هم مانند آن کودک که ارزش انگشتری را نمی‌داند، بهایی برای عمر خود قائل نشده‌ای و به راحتی آن را در خوشی‌های زودگذر خرج کرده‌ای."],[215,"قیامت که نیکان بر اعلا رسند","ز قعر ثری بر ثریا رسند","در روز قیامت، مردمان نیکوکار به بالاترین درجات و مقام‌ها دست خواهند یافت و از پایین‌ترین جایگاه‌ها به جایگاهی بلند و ارزشمند خواهند رسید."],[215,"تو را خود بماند سر از ننگ پیش","که گردت برآید عملهای خویش","تو برای خودت باید از ننگ و شرم دوری کنی، زیرا اعمال خودت موجب می‌شود که در روز قیامت مورد سرزنش قرار نگیری."],[215,"برادر، ز کار بدان شرم دار","که در روی نیکان شوی شرمسار","برادر، از انجام اعمال ناپسند و شرم‌آور بپرهیز، زیرا در میان افراد نیک و شایسته، موجب خجالت و شرمندگی‌ات می‌شود."],[215,"در آن روز کز فعل پرسند و قول","اولوالعزم را تن بلرزد ز هول","در روز قیامت که اعمال و گفتار انسان‌ها از او پرسیده می‌شود، پیامبران بزرگ الهی همچون اولوالعزم در برابر خداوند از ترس و هول به لرزه می‌افتند."],[215,"به جایی که دهشت خورند انبیا","تو عذر گنه را چه داری؟ بیا","در مکانی که پیامبران به خاطر زشتی اعمال خود ترس و وحشت دارند، تو چه دلیلی برای توجیه گناهانت داری؟ بیا و عذرخواهی کن."],[215,"زنانی که طاعت به رغبت برند","ز مردان ناپارسا بگذرند","زنانی که با میل و رغبت به اطاعت از شوهران خود می‌پردازند، از مردانی که ناپاک و بی‌خود هستند، دوری می‌کنند."],[215,"تو را شرم ناید ز مردی خویش","که باشد زنان را قبول از تو بیش؟","آیا از مردی خود شرم نمی‌کنی، در حالی که زنان بیشتر از تو را قبول دارند؟"],[215,"زنان را به عذری معین که هست","ز طاعت بدارند گه گاه دست","زنان به دلیل عذر مشخصی که دارند(عادت ماهانه) ، در آن زمان از نماز خواندن دست میکشند"],[215,"تو بی عذر یک سو نشینی چو زن","رو ای کم ز زن، لاف مردی مزن","تو بدون هیچ عذر و دلیلی مثل زن (زن پریود شده )دست کشیده ای ، برو ای کسی که از زن هم کمتری، برو به دروغ ادعای مردانگی نکن"],[215,"مرا خود چه باشد زبان آوری","چنین گفت شاه سخن عنصری:","من چه حق و صلاحیتی دارم که به این سخن‌وری درباره این موضوع بپردازم، در حالی که این کلام از بزرگترین شاعران، یعنی عنصری، است؟"],[215,"«چو از راستی بگذری خم بود","چه مردی بود کز زنی کم بود؟»","اگر از صداقت دور شوی، چه ارزشی دارد؟ چه مردی وجود دارد که به خاطر زنی کم باشد؟"],[215,"به ناز و طرب نفس پرورده گیر","به ایام دشمن قوی کرده گیر","در این بیت، شاعر به اهمیت توجه به نفس و روح انسان اشاره می‌کند. او می‌گوید که در دوران خوشی و لذت، باید نفس را با ناز و شادی پرورش داد و در زمان‌های دشوار و زمان جنگ یا دشمنی نیز باید قوی و مقاوم بمانیم."],[215,"یکی بچه گرگ می‌پرورید","چو پرورده شد خواجه بر هم درید","یک مرد گرگی بچه‌اش را بزرگ کرد، اما وقتی که بزرگ شد، خواجه (مرد) او را به شدت و خشونت از خود راند."],[215,"چو بر پهلوی جان سپردن بخفت","زبان آوری در سرش رفت و گفت","وقتی که گرگ، بچه‌اش را در آغوشش گذاشت و به خواب رفت، زبانش را به کار آورد و در دلش گفت."],[215,"تو دشمن چنین نازنین پروری","ندانی که ناچار زخمش خوری؟","تو که دشمن این پرورش‌دهنده نازنین هستی، نمی‌دانی که ناچار آسیب او را خواهی دید؟"],[215,"نه ابلیس در حق ما طعنه زد","کز اینان نیاید به جز کار بد؟","ابلیس بر ما طعنه‌ای نمی‌زند، زیرا از این دسته از افراد جزکارهای ناپسند برنمی‌آید."],[215,"فغان از بدیها که در نفس ماست","که ترسم شود ظن ابلیس راست","نفس ما پر از بدی‌هاست و من نگرانم که ابلیس به حق بگوید که ما فقط بدی می‌کشیم و کار خوبی از ما نمی‌آید."],[215,"چو ملعون پسند آمدش قهر ما","خدایش بینداخت از بهر ما","وقتی که ابلیس از قهر و تنفر ما خوشحال شد، خداوند او را به خاطر ما از رحمت خویش دور کرد."],[215,"کجا سر برآریم از این عار و ننگ","که با او به صلحیم و با حق به جنگ","ما چگونه می‌توانیم از این خواری و انگ بگریزیم که با او (یعنی شخص ملعون) در صلح هستیم در حالی که با حق در حال جنگیم؟"],[215,"نظر دوست نادر کند سوی تو","چو در روی دشمن بود روی تو","اگر دوست نگاهی نادر به تو بیفکند، این در حالی است که چهره‌ات در برابر دشمن قرار داشته باشد."],[215,"گرت دوست باید کز او بر خوری","نباید که فرمان دشمن بری","اگر دوستی داری که از او بهره‌مند می‌شوی، نباید به حرف و فرمان دشمن گوش دهی."],[215,"روا دارد از دوست بیگانگی","که دشمن گزیند به همخانگی","اگر انسان دوستی را انتخاب کند، نباید از او فاصله بگیرد و بی‌توجه باشد، چرا که اگر او دشمن را به عنوان همسایه و شریک زندگی انتخاب کند، این انتخاب به ضرر او خواهد بود."],[215,"ندانی که کمتر نهد دوست پای","چو بیند که دشمن بود در سرای؟","نمی‌دانی که وقتی دوست می‌فهمد دشمن در خانه‌اش است، چقدر بی‌محبت و کم‌حوصله می‌شود؟"],[215,"به سیم سیه تا چه خواهی خرید","که خواهی دل از مهر یوسف برید؟","به چه چیزی می‌خواهی با پول و ثروت دست یابی در حالی که برای این کار باید محبت و عشق یوسف را رها کنی؟"],[215,"تو از دوست گر عاقلی بر مگرد","که دشمن نیارد نگه در تو کرد","اگر عاقل باشی، به خاطر محبت و دوستی با کسی به عقب برنگرد و از او دور نشو، زیرا دشمن هرگز نخواهد توانست همچون او به تو محبت کند."],[216,"یکی برد با پادشاهی ستیز","به دشمن سپردش که خونش بریز","یک نفر با پادشاه درگیر شد و آن پادشاه را به دشمنش سپرد تا او را بکشد."],[216,"گرفتار در دست آن کینه توز","همی گفت هر دم به زاری و سوز","آن شخص که در دست دشمن کینه‌توز گرفتار شده بود، همیشه با ناله و فریاد از درد و عذابی که می‌کشید، صحبت می‌کرد."],[216,"اگر دوست بر خود نیازردمی","کی از دست دشمن جفا بردمی؟","اگر دوستی با من بدی نکند، هرگز از دست بدی و ظلم دشمن رنج نمی‌بردم."],[216,"بتا جور دشمن بدردش پوست","رفیقی که بر خود بیازرد دوست","اگر بت، یعنی معشوق یا محبوب، با جور و ستم دشمن، کسی را آزار دهد، درد او به دلیل آزار دوستی که بر خود بیازارد، به مراتب سخت‌تر و عمیق‌تر خواهد بود."],[216,"تو از دوست گر عاقلی بر مگرد","که دشمن نیارد نگه در تو کرد","اگر عاقل هستی، به خاطر دوستت هرگز به دشمن پشت نکن، زیرا دشمن نمی‌تواند نسبت به تو نیکی و احترام داشته باشد."],[216,"تو با دوست یکدل شو و یک سخن","که خود بیخ دشمن برآید ز بن","با دوست خود هم‌دل و هم‌زبان باش، زیرا دشمن از تنش تو بهره‌برداری می‌کند و از اینجا تو را آسیب می‌زند."],[216,"نپندارم این زشت نامی نکوست","به خشنودی دشمن آزار دوست","اینکه کسی به خاطر خوشنودی دشمن به دوستانش آسیب بزند، کار زشتی است و نام نیکو به دنبال نخواهد داشت."],[217,"یکی مال مردم به تلبیس خورد","چو برخاست لعنت بر ابلیس کرد","شخصی با فریب و نیرنگ مال مردم را به دست آورد و زمانی که از کار خود برخاست، به ابلیس لعنت فرستاد."],[217,"چنین گفتش ابلیس اندر رهی","که هرگز ندیدم چنین ابلهی","ابلیس در راهی به کسی می‌گوید که تا به حال کسی این‌قدر نادان ندیده است."],[217,"تو را با من است ای فلان، آشتی","به جنگم چرا گردن افراشتی؟","ای فلان (شخص مورد خطاب)، تو با من رابطه داری، پس چرا بدون دلیل با من درگیر شده‌ای و مقابل من ایستاده‌ای؟"],[217,"دریغ است فرموده دیو زشت","که دست ملک بر تو خواهد نبشت","نمی‌توانم به خاطر زشت‌کاری تو اجازه دهم که روح پاکان بر تو نظارت کند و اعمال ناپسند تو را ثبت کند."],[217,"روا داری از جهل و ناباکیت","که پاکان نویسند ناپاکیت","تو از جهل و ناپاکی خود بی‌خبر و راضی هستی، در حالی که کسانی که پاک‌اند، ناپاکی‌هایت را می‌نویسند و یادداشت می‌کنند."],[217,"طریقی به دست آر و صلحی بجوی","شفیعی برانگیز و عذری بگوی","راهی پیدا کن و صلحی به دست آور؛ وسیله‌ای برای شفاعت ایجاد کن و دلیلی برای عذرخواهی بیاب."],[217,"که یک لحظه صورت نبندد امان","چو پیمانه پر شد به دور زمان","وقتی که زمانی به پایان نزدیک می‌شود، هیچ گونه امان و مهلتی برای انسان وجود ندارد، مانند پیمانه‌ای که وقتی پر شود، دیگر نمی‌توان از آن جلوگیری کرد."],[217,"وگر دست قدرت نداری به کار","چو بیچارگان دست زاری بر آر","اگر تو قدرتی برای انجام کارها نداری، مانند بیچارگان دست به دعا و زاری بیاور."],[217,"گرت رفت از اندازه بیرون بدی","چو گفتی که بد رفت نیک آمدی","اگر در کارهای خود از حد تجاوز کردی و بد عمل کردی، پس به خود بگو که وقتی بد رفته‌ای، به نیکی بازگشتن امکان‌پذیر است."],[217,"فرا شو چو بینی ره صلح باز","که ناگه در توبه گردد فراز","هرگاه دیدی که راه صلح و آشتی باز شده، از مناهی دوری کن و به سرعت نزدیک شو، چون ممکن است در لحظه‌ای توبه‌ات به حقیقت بدل شود."],[217,"مرو زیر بار گنه ای پسر","که حمال عاجز بود در سفر","ای پسر، زیر بار گناه نرو، زیرا کسی که عاجز است، مثل یک بارکش ضعیف در سفر نمی‌تواند خود را به جلو ببرد."],[217,"پی نیک‌مردان بباید شتافت","که هر کاین سعادت طلب کرد یافت","باید به دنبال نیکوکاران رفت، زیرا هر کس خواهان سعادت و خوشبختی باشد، به آن دست پیدا خواهد کرد."],[217,"ولیکن تو دنبال دیو خسی","ندانم که در صالحان چون رسی؟","اما تو دنبال دیو نادانی هستی و نمی‌دانم که در میان انسان‌های نیکوکار چه زمانی خواهی رسید؟"],[217,"پیمبر کسی را شفاعتگر است","که بر جاده شرع پیغمبر است","شفاعت پیامبر تنها شامل کسانی می‌شود که در مسیر دین و قوانین الهی او گام برمی‌دارند."],[217,"ره راست رو تا به منزل رسی","تو بر ره نه ای زین قبل واپسی","برای رسیدن به مقصد، باید به راه راست ادامه دهی و از بازگشت به مسیرهای نادرست خودداری کنی."],[217,"چو گاوی که عصار چشمش ببست","دوان تا به شب، شب همانجا که هست","این بیت به حالتی اشاره دارد که مانند گاویی می‌باشد که چشمش را بسته‌اند و ناچار است در همان نقطه‌ای که هست، در شب بدود. این تصویر توصیفگر اوضاع کسی است که در کارهای خود دچار سردرگمی و محدودیت است و نمی‌تواند به پیش رود."],[217,"گل آلوده‌ای راه مسجد گرفت","ز بخت نگون بود اندر شگفت","کاری باخت که در آن شگفتی و حیرتی وجود دارد. فردی که دچار بدبختی شده، به سمت مسجد رفت، اما آلوده به گناه است."],[217,"یکی زجر کردش که تبت یداک","مرو دامن آلوده بر جای پاک","یکی او را کتک زد و گفت: «دست‌هایت قطع گردد!»، مبادا که دامن آلوده‌ات را بر مکان پاک بگذاری."],[217,"مرا رقتی در دل آمد بر این","که پاک است و خرم بهشت برین","دل من به خاطر این که در بهشت، جا و مقام پاکان و خوشحالان وجود دارد، به حال او رقت و رحم می‌آید."],[217,"در آن جای پاکان امیدوار","گل آلوده معصیت را چه کار؟","در آن مکان مقدس و پاکان، هیچ جایی برای کسانی که به گناه آلوده شده‌اند، وجود ندارد."],[217,"بهشت آن ستاند که طاعت برد","کرا نقد باید بضاعت برد","بهشت را کسی به دست می‌آورد که عبادت و طاعت انجام دهد، زیرا برای رسیدن به بهشت باید عمل و کار خوب را با خود داشته باشد."],[217,"مکن، دامن از گرد زلت بشوی","که ناگه ز بالا ببندند جوی","دامن خود را از آلودگی و گناه نپاک کن، چرا که ناگهان در موقعیتی قرار می‌گیری که راه نجات از آن بسته می‌شود."],[217,"مگو مرغ دولت ز قیدم بجست","هنوزش سر رشته داری به دست","نگو که مرغ سعادت از دستم پر کشیده است؛ هنوز این خوشبختی را در دست دارم و از آن بی‌بهره نشده‌ام."],[217,"وگر دیر شد گرم رو باش و چست","ز دیر آمدن غم ندارد درست","اگر دیر به هدف خود رسیدی، با شور و نشاط به راهت ادامه بده و نگرانی نداشته باش که دیر رسیدن مشکلی ندارد."],[217,"هنوزت اجل دست خواهش نبست","بر آور به درگاه دادار دست","تا زمانی که زمان مرگ تو فرا نرسیده و مرگ به تو دست نیاندازه، به درگاه خداوند دعا کن و درخواست خود را مطرح کن."],[217,"مخسب ای گنه کار خوش خفته، خیز","به عذر گناه آب چشمی بریز","ای گنه‌کار خواب‌آلود، از خواب بیدار شو و به خاطر گناهانت عذرخواهی کن و برگرد. برای توبه کردن، حتی اگر لازم باشد، اشک بریز."],[217,"چو حکم ضرورت بود کآبروی","بریزند باری بر این خاک کوی","اگر شرایط ایجاب کند که برای حفظ آبرو، آب و گرد و غبار بر این خاک (کوی) بریزند، باید این کار را انجام دهند."],[217,"ور آبت نماند شفیع آر پیش","کسی را که هست آبروی از تو بیش","اگر آبرویت در خطر باشد، نزد کسی برو که آبرویش از تو بیشتر است و شفاعت او به درد تو می‌خورد."],[217,"به قهر ار براند خدای از درم","روان بزرگان شفیع آورم","اگر خداوند به خاطر خشمش مرا از درگذر کند، بزرگان را به عنوان شفیع و واسطه برای من می‌آورم."],[218,"همی یادم آید ز عهد صغر","که عیدی برون آمدم با پدر","یاد من می‌آید که در دوران کودکی‌ام، روز عید همراه پدرم به بیرون رفتیم."],[218,"به بازیچه مشغول مردم شدم","در آشوب خلق از پدر گم شدم","در زمان کودکی، وقتی که مردم در حال آشفتگی و مشکلات بودند، من مشغول بازی و سرگرمی بودم و از پدرم دور افتادم."],[218,"برآوردم از هول و دهشت خروش","پدر ناگهانم بمالید گوش","از ترس و وحشت، ناگهان فریاد پدر را بلند کردم و او به سرعت دستم را گرفت و به من آرامش داد."],[218,"که ای شوخ چشم آخرت چند بار","بگفتم که دستم ز دامن مدار","ای دختر نازک‌چشم، چند بار به تو گفتم که از دامن من دست نکش."],[218,"به تنها نداند شدن طفل خرد","که مشکل توان راه نادیده برد","کودک کوچک نمی‌تواند به تنهایی از پس مشکلاتی برآید که در مسیر نادیده و ناشناخته پیش رویش قرار دارد."],[218,"تو هم طفل راهی به سعی ای فقیر","برو دامن راه دانان بگیر","ای فقیر، تو نیز همچون کودکانی که در مسیر زندگی نمی‌دانند چه باید کنند، با تلاش و کوشش خود به سوی هدایت برو و از آگاهی و دانش افراد دانا بهره‌مند شو."],[218,"مکن با فرومایه مردم نشست","چو کردی، ز هیبت فرو شوی دست","با افراد پست و بی‌مقدار خانواده یا جامعه، نشست و برخاست نکن؛ چون اگر چنین کنی، از اعتبار تو کاسته می‌شود و به نفوذ شخصیتت آسیب می‌رسد."],[218,"به فتراک پاکان درآویز چنگ","که عارف ندارد ز دریوزه ننگ","به جمع پاکان و اهل حقیقت بپیوند و در دل آن‌ها جای بگیر، زیرا عارف و دانای واقعی از پایین‌کشیدن خود به زندگی پست و زیستن به سبک درویشان ننگ دارد."],[218,"مریدان به قوت ز طفلان کمند","مشایخ چو دیوار مستحکمند","مریدان (پیروان) به قدرت و توانایی مانند کودکانی هستند که با کمند (طناب) می‌توانند آنها را بگیرند، ولی مشایخ (اساتید) مانند دیواری محکم هستند که به راحتی نمی‌توان به آنها دسترسی پیدا کرد."],[218,"بیاموز رفتار از آن طفل خرد","که چون استعانت به دیوار برد","از آن کودک کوچک بیاموز که وقتی کمک می‌خواهد، به دیوار تکیه می‌زند و به آن اعتماد می‌کند."],[218,"ز زنجیر ناپارسایان برست","که در حلقه پارسایان نشست","از زنجیرهای انسان‌های ناپاک و بی‌تقوا رهایی یافته، به جمع پارسایان و نیکوکاران پیوسته است."],[218,"اگر حاجتی داری این حلقه گیر","که سلطان ندارد از این در گزیر","اگر به چیزی نیاز داری، به این جمع (حلقه) بپیوند که در اینجا کسی که قدرتی دارد، از در اینجا خارج نمی‌شود."],[218,"برو خوشه چین باش سعدی صفت","که گرد آوری خرمن معرفت","به دنبال دانش و آگاهی و کسب فضایل اخلاقی برو، زیرا مانند کشاورزی که خوشه‌ها را جمع‌آوری می‌کند، باید تلاش کنی تا خرمن معرفت را جمع‌آوری کنی."],[218,"الا ای مقیمان محراب انس","که فردا نشینید بر خوان قدس","ای کسانی که در محراب انس (محل عبادت و نزدیکی به خدا) زندگی می‌کنید، در روز قیامت بر سر سفره قدس (سفره ای مخصوص نعمت‌های بهشتی) نشسته نخواهید بود."],[218,"متابید روی از گدایان خیل","که صاحب مروت نراند طفیل","به گدایان توجه نکنید و روی خود را از آن‌ها برگردانید، زیرا کسی که محبت و جوانمردی دارد، هرگز شخص فرودستی را از کنار خود طرد نمی‌کند."],[218,"کنون با خرد باید انباز گشت","که فردا نماند ره بازگشت","اکنون باید با اندیشه و عقل همراه شد، زیرا فردا راهی برای بازگشت نخواهد بود."],[219,"یکی غله مرداد مه توده کرد","ز تیمار دی خاطر آسوده کرد","مردی در ماه مرداد (که زمان برداشت محصولات است) گندم را در انبار جمع‌آوری کرد و با این کار، از نگرانی و دغدغه‌های دلش آرامش یافت."],[219,"شبی مست شد و آتشی برفروخت","نگون بخت کالیوه، خرمن بسوخت","کالیوه، فرد بدبختی، در یک شب مست شد و آتشی روشن کرد که خرمن گندم را سوزاند."],[219,"دگر روز در خوشه چینی نشست","که یک جو ز خرمن نماندش به دست","روز بعد، او در هنگام درو و خوشه‌چینی نشسته بود، اما هیچ دانه‌ای از خرمن به دستش نیامد."],[219,"چو سرگشته دیدند درویش را","یکی گفت پرورده خویش را","وقتی درویش گیج و حیران را دیدند، یکی از آن‌ها گفت که او از فرزندان و پرورش‌یافتگان خانواده خود است."],[219,"نخواهی که باشی چنین تیره روز","به دیوانگی خرمن خود مسوز","اگر نمی‌خواهی چنین بدبخت و شوم باشی، دیوانه‌وار خرمن خود را نسوزان."],[219,"گر از دست شد عمرت اندر بدی","تو آنی که در خرمن آتش زدی","اگر عمرت را در کارهای بد هدر دادی، همانند کسی هستی که در خرمن (محل ذخیره) خود آتش روشن کرده است."],[219,"فضیحت بود خوشه اندوختن","پس از خرمن خویشتن سوختن","ننگ و عیب این است که بعد از سوختن خرمن خود، همچنان به جمع‌آوری خوشه‌ها و ذخایر بپردازی."],[219,"مکن جان من، تخم دین ورز و داد","مده خرمن نیکنامی به باد","ای دل، از دین و اخلاق خود مراقبت کن و آن را به سادگی از دست نده. نگذار که شهرت نیکوی خود را به سادگی نابود کنی."],[219,"چو برگشته بختی در افتد به بند","از او نیک‌بختان بگیرند پند","هرگاه بخت کسی رو به تنزل برود و او در مشکلات نادانی یا سوء تدبیر خود گرفتار شود، افراد خوشبخت می‌توانند از تجربه او درس بگیرند و عبرت آموزند."],[219,"تو پیش از عقوبت در عفو کوب","که سودی ندارد فغان زیر چوب","قبل از اینکه تنبیه شوی، به دنبال عفو و بخشش باش، زیرا دردی که از تنبیه به تو می‌رسد، فریاد زدن زیر ضربه چوب هیچ نفعی ندارد."],[219,"بر آر از گریبان غفلت سرت","که فردا نماند خجل در برت","برای اینکه در فردای قیامت شرمنده نباشی، از غفلت و بی‌توجهی دست بردار و خود را آگاه کن."],[220,"یکی متفق بود بر منکری","گذر کرد بر وی نکو محضری","شخصی که در خطای بزرگ و زشتی مصمم بود، از کنار کسی که در حال نیکی و عبادت بود، گذشت."],[220,"نشست از خجالت عرق کرده روی","که آیا! خجل گشتم از شیخ کوی!","جوان از خجالت و شرم عرق بر رویش نشسته و نگران است که آیا از گفته‌های شخص روحانی (شیخ) شرمنده شده است."],[220,"شنید این سخن پیر روشن روان","بر او بر بشورید و گفت ای جوان","متوجه شد که پیر روشن‌روان (شیخ) این حرف را شنید و بر او خشمگین شد و گفت: ای جوان!"],[220,"نیاید همی شرمت از خویشتن","که حق حاضر و شرم داری ز من؟","چرا باید از خودت خجالت بکشی، در حالی که خداوند در هر حال کنارت است و تو از من خجالت می‌کشی؟"],[220,"نیاسایی از جانب هیچ کس","برو جانب حق نگه دار و بس","از هیچ‌کس سستی نکن و فقط به خداوند توجه داشته باش و او را در نظر بگیر."],[220,"چنان شرم دار از خداوند خویش","که شرمت ز بیگانگان است و خویش","از خداوند خود آنقدر شرم کن که شرمت از دیگران و حتی از نزدیکان نیز بیشتر باشد."],[221,"زلیخا چو گشت از می عشق مست","به دامان یوسف در آویخت دست","زلیخا، وقتی از شراب عشق سرمست شد، به دامن یوسف چنگ زد و به او نزدیک شد."],[221,"چنان دیو شهوت رضا داده بود","که چون گرگ در یوسف افتاده بود","زلیخا به قدری تحت تأثیر امیال و شهوت خود قرار گرفته بود که همچون گرگی به جان یوسف (علیه‌السلام) افتاده و او را به دام عشق خود می‌کشید."],[221,"بتی داشت بانوی مصر از رخام","بر او معتکف بامدادان و شام","زلیخا، همسر پادشاه مصر، مجسمه‌ای از رخام (مرمر) داشت که در صبح و شب به آن تکیه می‌کرد و به آن توجه می‌کرد."],[221,"در آن لحظه رویش بپوشید و سر","مبادا که زشت آیدش در نظر","در آن لحظه زلیخا صورتش را پوشاند تا نکند روی او در نظر یوسف زشت به نظر برسد."],[221,"غم آلوده یوسف به کنجی نشست","به سر بر ز نفس ستمکاره دست","یوسف، که دلش پر از غم است، در گوشه‌ای نشسته و سرش را بر دستانش گذاشته، در حالتی از کلافگی و ناراحتی به سر می‌برد. او به خاطر ظلمی که به او شده، در اندوه عمیقی به سر می‌برد."],[221,"زلیخا دو دستش ببوسید و پای","که ای سست پیمان سرکش درآی","زلیخا دستانش را بوسید و پایش را، و به او گفت: ای کسی که در وفاداری سست و سرکش هستی، به من نزدیک شو."],[221,"به سندان دلی روی در هم مکش","به تندی پریشان مکن وقت خوش","دل را به تندی و سختی نینداز و در وقت خوشی، آن را ناآرام نکن."],[221,"روان گشتش از دیده بر چهره جوی","که برگرد و ناپاکی از من مجوی","چشمانش از اشک جاری شده و بر روی صورتش مانند جوی آب می‌ریزد، اما نه به خاطر من، بلکه به خاطر اینکه از من ناپاکی را جستجو نکند."],[221,"تو در روی سنگی شدی شرمناک","مرا شرم باد از خداوند پاک","زلیخا در برابر یوسف، به خاطر اشتباهش شرمنده است و از اینکه خود را در مقابل خداوند پاک شرمنده می‌بیند، احساس ندامت دارد."],[221,"چه سود از پشیمانی آید به کف","چو سرمایه عمر کردی تلف؟","اگر عمرت را بیهوده هدر کرده‌ای، پشیمانی چه سودی دارد؟ زندگی باید به درستی گذرانده شود تا ارزشمند باشد."],[221,"شراب از پی سرخ رویی خورند","وز او عاقبت زردرویی برند","افراد به دنبال زیبایی و جذابیت ظاهری می‌روند و به خاطر آن زیاده‌روی می‌کنند، اما در نهایت به عواقب ناگوار و زشت‌رویی دچار می‌شوند."],[221,"به عذرآوری خواهش امروز کن","که فردا نماند مجال سخن","امروز به خاطر اشتباهاتت عذرخواهی کن، چون ممکن است فردا فرصتی برای گفت‌وگو نداشته باشی."],[222,"پلیدی کند گربه بر جای پاک","چو زشتش نماید بپوشد به خاک","اگر گربه بر جای تمیز و پاک پلیدی کند، زشتی‌اش نمایان می‌شود و برای پنهان کردن آن، مجبور می‌شود بر رویش خاک بریزد."],[222,"تو آزادی از ناپسندیده‌ها","نترسی که بر وی فتد دیده‌ها؟","آیا تو از کارهای بد نمی‌هراسی که مردم تو را ببینند و دربارۀ تو قضاوت کنند؟"],[222,"براندیش از آن بنده پرگناه","که از خواجه مخفی شود چند گاه","به یاد داشته باش که نباید درباره بنده گنهکار فکر کنی که مدت زیادی بتواند از نگاه صاحبش پنهان بماند."],[222,"اگر برنگردد به صدق و نیاز","به زنجیر و بندش بیارند باز","اگر او به صداقت و نیاز بازنگردد، حتی اگر او را به زنجیر و بند هم ببرند، دوباره نخواهد آمد."],[222,"به کین‌آوری با کسی برستیز","که از وی گزیرت بود یا گریز","به جنگ و ستیز با کسی برو مگر اینکه بدانی یا توان غلبه بر او را داری یا اگر او بر تو غلبه کرد، راهی برای گریز و نجات هست."],[222,"کنون کرد باید عمل را حساب","نه وقتی که منشور گردد کتاب","اکنون باید اعمال خود را بسنجیم و حساب آنها را در این دنیا نگه‌داریم، نه زمانی که نامه اعمال در قیامت منتشر شود و برای هر یک از اعمال‌مان مورد بررسی قرار بگیرد."],[222,"کسی گرچه بد کرد هم بد نکرد","که پیش از قیامت غم خود بخورد","کسی اگرچه کارهای زشت انجام داده، اما این کارها او را به فکر و اندوه برای عاقبت کارش نمی‌اندازد، چرا که هنوز در دنیا زندگی می‌کند و روز رستاخیز و حساب و کتاب برایش نیامده است."],[222,"گر آیینه از آه گردد سیاه","شود روشن آیینه دل به آه","اگر آینه از حسرت و اندوه سیاه شود، آینه دل نیز با این اندوه روشن خواهد شد."],[222,"بترس از گناهان خویش این نفس","که روز قیامت نترسی ز کس","از گناهان خود بترس، زیرا این نفس (زندگی و وجود) تو در روز قیامت به تو کمک نخواهد کرد و نباید از کسی بترسی."],[223,"غریب آمدم در سواد حبش","دل از دهر فارغ سر از عیش خوش","به سرزمین حبشه سفر کردم و اینجا احساس غربت می‌کنم؛ از دنیا و مشکلات آن رها شده‌ام و خوشحالیم از لذت و شادی زندگی بهره‌مند است."],[223,"به ره بر یکی دکه دیدم بلند","تنی چند مسکین بر او پای بند","در راه، دکه‌ای را دیدم که چند نفر از افراد بی‌خانمان به آن درآمده و در آنجا درخواست کمک می‌کنند و وابسته به آن دکه هستند."],[223,"بسیج سفر کردم اندر نفس","بیابان گرفتم چو مرغ از قفس","سفر را آغاز کردم تا از نفس خود دور شوم، چرا که در بیابان بی‌پناهی به سر می‌برم و همچون پرنده‌ای که از قفس رها شده، به آزادی می‌اندیشم."],[223,"یکی گفت کاین بندیان شبروند","نصیحت نگیرند و حق نشنوند","یکی از کسان گفت که این زندانیان به شغف و شوق می‌روند، اما نصیحت و پند را قبول نمی‌کنند و به حق و حقیقت گوش نمی‌دهند."],[223,"چو بر کس نیامد ز دستت ستم","تو را گر جهان شحنه گیرد چه غم؟","اگر از دست تو ستمی به کسی نرسیده، دیگر نباید نگران باشی که دنیا چگونه قاضی می‌کند."],[223,"نیاورده عامل غش اندر میان","نیندیشد از رفع دیوانیان","کسی که در کار خود نادرست و فریبکار نیست، نباید نگران عواقب کارگزاران و دیوانیان باشد و به فکر اصلاح امور آن‌ها نباشد."],[223,"وگر عفتت را فریب است زیر","زبان حسابت نگردد دلیر","اگر عفت و پاکدامنی‌ات فریبنده باشد، زبانت با حساب و کتابی نخواهد بود و دلت شجاع نخواهد ماند."],[223,"نکونام را کس نگیرد اسیر","بترس از خدای و مترس از امیر","اگر انسان نیکوکار و با فضیلت باشد، هیچ‌کس او را به بند نمی‌کشد و نمی‌تواند او را گرفتار کند، اما باید از خدا بترسد و از قدرت سردار یا حاکم نترسد."],[223,"چو خدمت پسندیده آرم به جای","نیندیشم از دشمن تیره رای","هرگاه که به انجام خدمت‌های پسندیده مشغول شوم، به هیچ دشمنی با نیت بد فکر نمی‌کنم."],[223,"اگر بنده کوشش کند بنده‌وار","عزیزش بدارد خداوندگار","اگر بنده تلاش کند که مانند بندگان باصداقت و فداکار باشد، خداوندگارش را در نظر عزیز و محترم خواهد داشت."],[223,"وگر کند رای است در بندگی","ز جانداری افتد به خربندگی","اگر کسی در اطاعت و بندگی خدا به فکر بدی بیفتد، ممکن است از مقام انسانی خود پایین آمده و به درجه‌ای از فساد و زشتی برسد که شایسته او نیست."],[223,"قدم پیش نه کز ملک بگذری","که گر باز مانی ز دد کمتری","اگر قدمی برداری و از ملک خود (حکومت یا مقام) بگذری، به جانداری بزرگ‌تر از خودت می‌رسی؛ اما اگر درنگ کنی، در مقایسه با موجودات وحشی و دد، به مرتبه‌ای پایین‌تر تنزل می‌کنی."],[224,"یکی را به چوگان مه دامغان","بزد تا چو طبلش بر آمد فغان","کسی که در بازی چوگان (ورزشی با چوب و توپ) در دامغان (شهری در ایران) به ضربه‌ای محکم ضربه می‌زند، به‌گونه‌ای که صدای طبل آن بلند می‌شود و فریاد به‌پا می‌کند."],[224,"شب از بی قراری نیارست خفت","بر او پارسایی گذر کرد و گفت","او شب را از شدت بی‌قراری نتوانست بخوابد و در حالی که پارسایی (شخصی درستکار و پرهیزگار) از آنجا عبور می‌کرد، به او گفت."],[224,"به شب گر ببردی بر شحنه، سوز","گناه آبرویش نبردی به روز","اگر در شب گناهی را مرتکب شوی، آن گناه در روز سبب آبروریزی‌ات نمی‌شود."],[224,"کسی روز محشر نگردد خجل","که شبها به درگه برد سوز دل","کسی در روز قیامت شرمنده نخواهد شد که در شب‌ها با دل شکسته و گناه‌کار خود به درگاه خداوند آمده است."],[224,"هنوز ار سر صلح داری چه بیم؟","در عذرخواهان نبندد کریم","اگر هنوز هم خواهان صلح و آشتی هستی، چرا نگران هستی؟ در نزد عذرخواهان، افراد بزرگوار و بخشنده هیچ‌گاه ناز و کدورت نمی‌کنند."],[224,"ز یزدان دادار داور بخواه","شب توبه تقصیر روز گناه","از خدای دادگر تقاضا کن که در شب توبه از توشی که در روز گناه کرده‌ای، چشم‌پوشی کند."],[224,"کریمی که آوردت از نیست هست","عجب گر بیفتی نگیردت دست","خداوندی که تو را از عدم به وجود آورده و به تو کرامت بخشیده، عجیب است اگر در برابر او که این همه نعمت‌ها را به تو داده، دستان تو را نگیرد و به حال خود رها کند."],[224,"اگر بنده‌ای دست حاجت بر آر","و گر شرمسار آب حسرت ببار","اگر بنده‌ای (انسانی) درخواست کند، باید دستش را بلند کند و اگر شرمنده است، باید اشک حسرت بریزد."],[224,"نیامد بر این در کسی عذر خواه","که سیل ندامت نشستش گناه","هیچ‌کس به این در نیامده تا عذرخواهی کند، زیرا سیل پشیمانی ناشی از گناهانش او را فراگرفته است."],[224,"نریزد خدای آبروی کسی","که ریزد گناه آب چشمش بسی","خدا آبروی کسی را نریزید که به خاطر گناهانش اشک می‌ریزد و متاسف است."],[225,"به صنعا درم طفلی اندر گذشت","چه گویم کز آنم چه بر سر گذشت","در شهر صنعا، کودک ستم‌دیده‌ای به‌سختی از کنار من گذشت، و نمی‌دانم چه بر سر او آمده است و چه بر او گذشته است."],[225,"قضا نقش یوسف جمالی نکرد","که ماهی گورش چو یونس نخورد","سرنوشت نتوانسته است که زیبایی یوسف (نماد زیبایی و محبوبیت) را خلق کند، چرا که همان‌طور که ماه یونس (پیامبری که در شکم ماهی گرفتار شد) از آن گرفتار آمد، او نیز از زیبایی‌اش بهره‌مند نشده است."],[225,"در این باغ سروی نیامد بلند","که باد اجل بیخش از بن نکند","هیچ درختی در این باغ به بلندی سرو نرسید، چون باد مرگ ریشه آن را نمی‌برد."],[225,"نهالی به سی سال گردد درخت","ز بیخش بر آرد یکی باد سخت","درختی که سی سال زمان می‌برد تا به بار بنشیند، ممکن است به یکباره با وزش یک باد شدید از ریشه کنده شود."],[225,"عجب نیست بر خاک اگر گل شکفت","که چندین گل‌اندام در خاک خفت","تعجبی ندارد اگر در خاک، گلی شکفته باشد، چون دسته‌دسته گل‌های زیبا در خاک پنهان‌اند و می‌توانند روزی سر برآورند."],[225,"به دل گفتم ای ننگ مردان بمیر","که کودک رود پاک و آلوده پیر","به خود گفتم، ای شرم و ننگ مردان، برایت بهتر است که بمیر، زیرا کودک به‌راحتی می‌تواند از گناه پاک شود، اما فرد پیر آلوده به گناهان است."],[225,"ز سودا و آشفتگی بر قدش","برانداختم سنگی از مرقدش","از شدت اندوه و آشفتگی، سنگی را که بر مزار او (مرقد او) بود، از رویش برداشتم."],[225,"ز هولم در آن جای تاریک و تنگ","بشورید حال و بگردید رنگ","از اضطراب و ترس در آن مکان تاریک و بسته، حالتم تغییر کرد و رنگم عوض شد."],[225,"چو باز آمدم زآن تغیر به هوش","ز فرزند دلبندم آمد به گوش:","وقتی که دوباره به حال طبیعی و هوشیاری برگشتم، صدای فرزند عزیزم را شنیدم."],[225,"گرت وحشت آمد ز تاریک جای","به هش باش و با روشنایی در آی","اگر از تاریکی و دشواری‌ها ترسیدی، با هوشیاری به وجود روشنایی نزدیک شو و به آن پناه ببر."],[225,"شب گور خواهی منور چو روز","از اینجا چراغ عمل برفروز","اگر می‌خواهی شب قبرت مثل روز روشن شود، از همین‌جا با اعمال نیک چراغ نورانی برافروز."],[225,"تن کارکن می‌بلرزد ز تب","مبادا که نخلش نیارد رطب","تن انسان در کار و تلاش، از شدت عرق و گرما به لرزه درمی‌آید، مبادا که درخت او (یعنی تلاشش) میوه‌ای (نتیجه ای) نیاورد."],[225,"گروهی فراوان طمع ظن برند","که گندم نیفشانده خرمن برند","گروهی زیادی به امید و طمع، گمان می‌کنند که در زمین چیزی کشت نکرده‌اند، اما با این حال محصول برداشت می‌کنند."],[225,"بر آن خورد سعدی که بیخی نشاند","کسی برد خرمن که تخمی فشاند","سعدی در این بیت می‌گوید که کسی باید نگران باشد و زحماتش را حفظ کند که بی‌توجهی کند و نتیجه زحماتش را به دیگران بدهد؛ زیرا کسی که فقط به فکر خود نیست و برای دیگران هم کاری می‌کند، ممکن است به سختی نتیجه تلاشش را از دست بدهد."],[226,"بیا تا برآریم دستی ز دل","که نتوان برآورد فردا ز گل","بیایید تا امروز از دل خود نیکی کنیم، زیرا ممکن است فردا برای عمل به این نیکی دیر باشد و نتوانیم آن را انجام دهیم."],[226,"به فصل خزان در، نبینی درخت","که بی برگ ماند ز سرمای سخت","در فصل پاییز، نمی‌توانی درختی را ببینی که از سرما بی‌برگ نماند."],[226,"برآرد تهی دست‌های نیاز","ز رحمت نگردد تهی‌دست باز","دست‌های خالی دعا و نیاز، وقتی به رحمت خداوند متصل شود، همیشه پر و بی‌نیاز خواهد شد و هرگز نیازی از آنها برطرف نمی‌ماند."],[226,"مپندار از آن در که هرگز نبست","که نومید گردد بر آورده‌دست","نگران نباش که در رحمت الهی هیچ‌گاه بسته نخواهد شد، زیرا کسی که دست نیاز به سوی خداوند دراز کرده، هرگز ناامید نخواهد شد."],[226,"قضا خلعتی نامدارش دهد","قدر میوه در آستینش نهد","قضا به او لباس و جایگاهی مشهور می‌دهد و به اندازه‌ای که میوه در آستین قرار می‌گیرد، برکت و نعمت را در زندگی‌اش می‌گذارد."],[226,"همه طاعت آرند و مسکین نیاز","بیا تا به درگاه مسکین نواز","همه عبادت خداوند را به جا می اورند و به کمک خدا نیاز دارند پس به سوی درگاه کسی بیایید که نیازمندان را نوازش و حمایت می‌کند."],[226,"چو شاخ برهنه برآریم دست","که بی‌برگ از این بیش، نتوان نشست","اگر دست خود را مانند شاخه‌ای بی‌برگ دراز کنیم، یعنی در حالت نیاز و درخواست باشیم، نمی‌توانیم مدت زیادی در این وضعیت بمانیم و باید از خداوند درخواست کمک کنیم."],[226,"خداوندگارا نظر کن به جود","که جرم آمد از بندگان در وجود","خداوندا، به بخشندگی خودت نگاه کن، زیرا خطاهایی که از بندگان تو سر می‌زند، ناشی از وجود آنهاست."],[226,"گناه آید از بنده خاکسار","به امّید عفو خداوندگار","بنده خاکی، به امید بخشش خداوند، مرتکب گناه می‌شود."],[226,"کریما به رزق تو پرورده‌ایم","به انعام و لطف تو، خو کرده‌ایم","خداوندا، ما را با نعمت‌های خود روزی داده‌ای، و به خاطر لطف و رحمت تو، به این زندگی عادت کرده‌ایم."],[226,"گدا چون کرم بیند و لطف و ناز","نگردد ز دنبال بخشنده باز","زمانی که گدا (نیازمند) کرامت و لطف و ناز کسی را ببیند، توجهش از دنبال کردن بخشنده (کسی که به او کمک می‌کند) برنمی‌گردد و همچنان به او وابسته می‌ماند."],[226,"چو ما را به دنیا تو کردی عزیز","به عقبی همین‌چشم داریم نیز","خداوند تو را در دنیا برای ما عزیز و محترم قرار داده است، ما هم در آخرت از تو انتظار داریم که همین محبت و عزت را به ما بدهی."],[226,"عزیزی و خواری تو بخشی و بس","عزیز تو خواری نبیند ز کس","تو محبت و ارجمندی را به دیگران می‌آموزی، و خودت هرگز درجه پستی و ذلت را از کسی نمی‌پذیری."],[226,"خدایا به عزّت که خوارم مکن","به ذلّ گنه شرمسارم مکن","خدایا، به خاطر عظمتت، مرا خوار مکن و به خاطر گناهی که مرتکب شدم، شرمنده‌ام نکن."],[226,"مسلّط مکن چون منی بر سرم","ز دست تو به گر عقوبت برم","خداوند، مرا مانند من گناهکار و ضعیف تحت سلطه و عذاب قرار نده، زیرا اگر عذاب کنم، از دست تو نیست، بلکه به خاطر خطاهایم است."],[226,"به گیتی بتر زین، نباشد بدی","جفا بردن از دست همچون خودی","در جهان، بدتر از این وجود ندارد که از دست کسی مثل خودم، بی‌رحمانه جفا ببینم."],[226,"مرا شرمساری ز روی تو بس","دگر شرمسارم مکن پیش کس","من به خاطر روی تو شرمنده‌ام و دیگر مرا پیش کسی شرمنده نکن."],[226,"گرم بر سر افتد ز تو سایه‌ای","سپهرم بود کهترین پایه‌ای","اگر سایه‌ای از تو بر سرم بیفتد، بهترین اساس و بنیان من، آسمان است."],[226,"اگر تاج بخشی، سر افرازدم","تو بردار تا کس نیندازدم","اگر تو چیزی به من ببخشی و مرا بلند مقام کنی، آن را از من بگیر تا کسی نتواند به من حسادت کند یا آسیب برساند."],[226,"تنم می‌بلرزد چو یاد آورم","مناجات شوریده‌ای در حرم","وقتی که به یاد مناجات یک دیوانه در حرم می‌افتم، بدنم به لرزه می‌افتد."],[226,"که می‌گفت شوریده دل‌فگار","الها ببخش و به ذلّم مدار","شوریده دل به خدا می‌گفت: ای خدا، مرا ببخش و به خاطر گناهانم عذابم نکن."],[226,"همی‌گفت با حق به‌زاری بسی","میفکن که دستم نگیرد کسی","او با دل‌تنگی و زاری به خداوند می‌گوید که هیچ‌کس به یاری‌اش نمی‌آید و دستش را نمی‌گیرد، پس از خدا می‌خواهد که در این حالت، او را از رحمتش بی‌نصیب نکند."],[226,"به لطفم بخوان و مران از درم","ندارد به جز آستانت سرم","خود را به لطف و مرحمت تو نیازمند می‌دانم و از درگاه تو دور نشو، چون هیچ کس جز تو را ندارم و تنها به آستانت پناه آورده‌ام."],[226,"تو دانی که مسکین و بیچاره‌ایم","فرومانده نفس امّاره‌ایم","ما می‌دانیم که ما انسان‌ها مسکین و دردمند هستیم و در کنترل نفس سرکش خود ناتوانیم."],[226,"نمی‌تازد این نفس سرکش چنان","که عقلش تواند گرفتن عنان","این نفس سرکش چنین به شدت نمی‌تازد که عقل بتواند آن را مهار کند و کنترل کند."],[226,"که با نفس و شیطان برآید به‌زور؟","مصاف پلنگان نیاید ز مور","کسی که با نفس سرکش و شیطان به‌زور مقابله کند، مانند پلنگی است که در مبارزه با مورچگان نمی‌جنگد. این بیت بیان می‌کند که نبرد با نفس و شیطان کار سختی است و نیاز به قدرت و اراده دارد."],[226,"به مردان راهت که راهی بده","وز این‌دشمنانم پناهی بده","خداوند، به مردان راه تو هدایت و راهنمایی بده و از این دشمنان به من پناهی عطا کن."],[226,"خدایا به ذات خداوندیت","به اوصاف بی‌مثل و مانندیت","خدای بزرگ، به عظمت و شأن خودت و به صفاتی که هیچ مشابه و همتا ندارد."],[226,"به لبیک حجّاج بیت‌الحرام","به مدفون یثرب علیه‌السلام","به درخواست و ندای حاجیان خانه کعبه و نیز به احترام پیامبر اسلام (مدفون در یثرب، که به مدینه معروف است) اشاره شده است."],[226,"به تکبیر مردان شمشیر زن","که مرد وغا را شمارند زن","زنان جنگجو را هم چون مردان که در صفوف نبرد حضور دارند و شجاعت نشان می‌دهند، به حساب می‌آورند."],[226,"به طاعات پیران آراسته","به صدق جوانان نوخاسته","اعمال و عبادات سالمندان با صداقت و راستگویی جوانان تازه‌نفس آراسته و زیباست."],[226,"که ما را در آن‌ورطه یک‌نفس","ز ننگ دو گفتن به فریاد رس","بگویید ما را در آن دنیا، در وضعیت سخت نفس‌کشیدن، به کمک بیایید و کمک کنید تا به خاطر ننگ دوگویی نجات یابیم."],[226,"امید است از آنان که طاعت‌کنند","که بی‌طاعتان را شفاعت‌کنند","امیدوارم کسانی که بندگی و اطاعت خدا را انجام می‌دهند، برای کسانی که معصیت کرده‌اند، شفاعت کنند و آن‌ها را مورد رحمت قرار دهند."],[226,"به پاکان کز آلایشم دور دار","وگر زلّتی رفت، معذور دار","از پاکان خواهش می‌کنم که مرا از آلودگی‌ها دور نگه‌دارند و اگر خطایی از من سر زد، آن را به حساب نیاورند."],[226,"به پیران پشت از عبادت دوتا","ز شرم گنه دیده بر پشت پا","به افرادی که عمرشان را در عبادت گذرانده‌اند، باید با شرم نگاه کرد و از گناهان خود خجالت کشید."],[226,"که چشمم ز روی سعادت مبند","زبانم به وقت شهادت مبند","چشمم را از روی سعادت که در نظر دارم، دور نکن و زبانم را در زمان شهادت و گواهی به گفتن دشنام و بدی مشغول نکن."],[226,"چراغ یقینم فرا راه دار","ز بد کردنم دست کوتاه دار","ای یقین من، مثل چراغی در راه من روشن شو تا از بدی‌هایی که کرده‌ام دور بمانم و مرا از کارهای ناپسند بازدار."],[226,"بگردان ز نادیدنی دیده‌ام","مده دست بر ناپسندیده‌ام","ای کاش که مرا از دیدن چیزهای ناپسند دور کنی و نگذارید دستم به کارهای ناپسندنده برسد."],[226,"من آن ذره‌ام در هوای تو نیست","وجود و عدم ز احتقارم یکی است","من در عشق و هوای تو آن‌قدر کوچک و ناچیز هستم که وجود و عدم من برای خودم فرقی ندارد."],[226,"ز خورشید لطفت شعاعی بسم","که جز در شعاعت نبیند کسم","از نور و محبت تو، مانند تابش خورشید، تنها من نیرو و روشنی می‌گیرم و دیگران جز در سایه‌ات کسی را نمی‌بینند."],[226,"بدی را نگه کن که بهتر کس است","گدا را ز شاه التفاتی بس است","بهتر است که به بدی توجه نکنی زیرا فردی خوب‌تر از آن نیست؛ برای گدا، توجه و محبت شاه کافی است."],[226,"مرا گر بگیری به انصاف و داد","بنالم که عفوم نه این وعده داد","اگر مرا به انصاف و عدل بگیری و محاکمه کنی، می‌توانم شکایت کنم که عفو و بخششت این وعده را به من نداده است."],[226,"خدایا به ذلت مران از درم","که صورت نبندد دری دیگرم","خدایا، مرا با ذلت و خواری از درگاه خود طرد نکن که در غیر این صورت دربی دیگر برای من باز نخواهد شد."],[226,"ور از جهل غایب شدم روز چند","کنون کآمدم در به رویم مبند","اکنون که مدتی از نادانی و جهل دور بوده‌ام، وقتی به درگاه تو می‌آیم، در را به رویم نبند."],[226,"چه عذر آرم از ننگ تردامنی؟","مگر عجز پیش آورم کای غنی","من چه دلیلی می‌توانم برای ننگ شرمگینی‌ام بیاورم؟ آیا جز این است که بگویم ناتوان و عاجز هستم، ای خدای غنی؟"],[226,"فقیرم به جرم و گناهم مگیر","غنی را ترحم بود بر فقیر","من فقیر هستم و به خاطر جرم و گناهانم نرنجانید. انسان مرفه (غنی) به فقیر ترحم می‌کند و باید بر او لطف و محبت داشته باشد."],[226,"چرا باید از ضعف حالم گریست؟","اگر من ضعیفم پناهم قویست","نباید به خاطر ناتوانی و کمبود خود غصه خورد، چرا که اگر من ضعیف و ناتوان هستم، پناه من (خدا) قوی و تواناست."],[226,"خدایا به غفلت شکستیم عهد","چه زور آورد با قضا دست جهد؟","خدایا، ما در غفلت عهدی را که با تو بسته بودیم، شکسته‌ایم. چه نیرویی در تقدیر وجود دارد که باعث شده است ما تلاش کنیم؟"],[226,"چه برخیزد از دست تدبیر ما؟","همین نکته بس عذر تقصیر ما","از تدبیر و برنامه‌ریزی ما چه کار مثبتی برمی‌آید؟ همین نکته برای توجیه کوتاهی‌های ما کافی است."],[226,"همه هر چه کردم تو بر هم زدی","چه قوت کند با خدایی خودی؟","هرچه من انجام دادم، تو خراب کردی. چه نیرویی می‌تواند مقابل خداوندی که خودی را دارد، بایستد؟"],[226,"نه من سر ز حکمت به در می‌برم","که حکمت چنین می‌رود بر سرم","من نمی‌توانم از حکمت و دانایی فرار کنم، زیرا حکمت به شدت بر من تسلط دارد و نمی‌توانم از آن بگریزم."],[227,"سیه چرده‌ای را کسی زشت خواند","جوابی بگفتش که حیران بماند","کسی که پوست تیره‌ای دارد، به او گفته‌اند زشت. او پاسخ داده است که این حرف طوری است که کسی را متعجب می‌کند و بدون پاسخ می‌گذارد."],[227,"نه من صورت خویش خود کرده‌ام","که عیبم شماری که بد کرده‌ام","من خودم را زشت نکرده‌ام که عیب‌های من را بشماری، بلکه من به خاطر کارهای بدی که کرده‌ام این‌گونه می‌شوم."],[227,"تو را با من ار زشت رویم، چه کار؟","نه آخر منم زشت و زیبانگار","اگر من زشت‌صورت باشم، تو چه کار به من داری؟ در نهایت، من کسی هستم که هم زشت به نظر می‌آیم و هم زیبا را می‌بینم."],[227,"از آنم که بر سر نبشتی ز پیش","نه کم‌کردم ای بنده‌پرور، نه بیش","من از آن چیزی که به من داده‌ای، وقتی که پیش تو بودم نه کم گذاشته‌ام و نه زیاد."],[227,"تو دانایی آخر که قادر نیم","توانای مطلق تویی، من کیم؟","ای خداوند متعال، تو از همه چیز آگاهی و توانایی مطلق را داری، من نسبت به تو هیچ نیستم و نمی‌توانم به آنچه تو می‌دانی و می‌توانی، دست پیدا کنم."],[227,"گرم ره نمایی، رسیدم به خیر","وگر گم کنی، باز ماندم ز سیر","اگر تو راه را به من نشان دهی، به خیر و نیکی می‌رسم و اگر مرا گم کنی، در حرکت و سیر خود باز می‌مانم."],[227,"جهان‌آفرین گر نه یاری کند،","کجا بنده پرهیزکاری کند؟","اگر جهان‌آفرین (خدا) کمک نکند، چگونه ممکن است بنده‌ای که در تلاش برای پرهیزکاری و نیکوکاری است، موفق شود؟"],[227,"چه خوش گفت درویش کوتاه‌دست","که شب توبه‌کرد و سحرگه شکست","درویشی که توان مالی زیادی ندارد، به‌خوبی بیان کرده که چگونه در شب عذرخواهی و توبه کرده، اما در صبح دوباره به خطا برگشته است."],[227,"گر او توبه بخشد، بماند درست","که پیمان ما بی ثبات‌است و سست","اگر او (خدا) توبه مرا بپذیرد، من در راه درست باقی می‌مانم، چون پیمان و عهد ما در دنیا ناپایدار و ضعیف است."],[227,"به حقّت که چشمم ز باطل بدوز","به نورت که فردا به نارم مسوز","به حق تو، چشمم را از باطل دور کن و با نور خود، به من نور بده تا فردا در آتش جهنم نسوزم."],[227,"ز مسکینیم روی در خاک رفت","غبار گناهم بر افلاک رفت","از روی مسکینی‌ام، به خاک افتاده‌ام و غبار گناهانم به آسمان رفته است."],[227,"تو یک‌نوبت ای ابر رحمت، ببار","که در پیش باران، نپاید غبار","ای ابر رحمت، فقط یک بار بر ما باران نازل کن، زیرا قبل از باران، غبار گناهان بر زمین نمی‌ماند."],[227,"ز جرمم در این‌مملکت، جاه نیست","ولیکن به ملکی دگر راه نیست","من به خاطر گناهانم در این سرزمین، اعتبار و مقامی ندارم، اما در سرزمینی دیگر هم راهی برای من وجود ندارد."],[227,"تو دانی ضمیر زبان‌بستگان","تو مرهم نهی بر دل خستگان","تو می‌دانی که کسانی که زبانشان بسته است (نتوانند سخن بگویند)، تو می‌توانی با کلامت بر دل‌های خستگان تسکین ببخشی."],[228,"مغی در به روی از جهان بسته‌بود","بتی را به خدمت میان بسته‌بود","دنیا را بر او بسته بودند و در مکانی که بتی را به خدمت گرفته بودند، جز او کسی نمی‌توانست وارد شود."],[228,"پس از چندسال آن نکوهیده‌کیش","قضا حالتی صعبش آورد پیش","بعد از چند سال، آن بت‌پرست بدنام، حالتی سخت و دشوار برایش پیش آمد."],[228,"به پای بت اندر به امّید خیر","بغلتید بیچاره بر خاک دیر","بیچاره، در سرزمین معبد بت، به امید خیر و نیکی به زمین افتاد و غلتید."],[228,"که درمانده‌ام، دست گیر ای صنم!","به جان آمدم، رحم‌کن بر تنم","من در سختی و ناامیدی قرار دارم، ای معشوق! دست مرا بگیر. جانم به لب رسیده است، بر جسمم رحم کن."],[228,"بزارید در خدمتش بارها","که هیچش به‌سامان نشد کارها","باید بارها در خدمت او باشم، چون هیچ یک از کارهایم به سامان نرسیده است."],[228,"بتی چون برآرد مهمّات کس","که نتواند از خود براندن مگس؟","اگر بتی وجود داشته باشد که به نیازهای مردم اهمیت دهد، چطور ممکن است کسی نتواند مگسی را از خود دور کند؟"],[228,"برآشفت کای پای‌بند ضلال","به باطل پرستیدمت چندسال","ناراحت شد که ای کسی که به گمراهی وابسته‌ای، چند سال است که تو را به باطل پرستیدم."],[228,"مهمّی که درپیش‌دارم، برآر","و گر نه، بخواهم ز پروردگار","من هنوز به چیزی که در پیش دارم نیاز دارم، پس آن را برای من فراهم کن، وگرنه از خداوند چیزی می‌خواهم."],[228,"هنوز از بت، آلوده رویش به خاک","که کامش برآورد یزدان پاک","هرگز از بت (پرستشگاه یا معبود دروغین)، چهره‌اش به خاک آغشته می‌شود، در حالی که خواسته‌اش برآورده شده است، این از قدرت خداوند پاک است."],[228,"حقایق شناسی در این خیره‌شد","سر وقت صافی بر او تیره‌شد","در این بیت، سعدی به این نکته اشاره می‌کند که وقتی شخصی به حقیقت و معارف الهی پی می‌برد، در عین حال ممکن است که از درک و شناخت واقعی خود غافل شود و به نوعی در گمراهی و تیرگی مسیرش قرار بگیرد. او به نوعی دوگانگی میان درک حقیقت و گمراهی اشاره می‌کند."],[228,"که سرگشته‌ای دون یزدان‌پرست","هنوزش سر از خمر بتخانه مست","این بیت درباره کسی است که به شدت گمراه و سرگردان است و با وجود اینکه بنده خدا (یزدان‌پرست) است، هنوز در میخانه (بتخانه) و زیر تأثیر شراب مست می‌باشد. این فرد در حقیقت از خدا دور شده و به مسائل دنیوی و باده‌نوشی مشغول است."],[228,"دل از کفر و دست از خیانت نشست","خدایش برآورد کامی که جست","دلش به کفر (یعنی عدم ایمان) و دستش به خیانت (یعنی بی‌وفایی) عادت نکرده بود، و خدایش به او کامی بخشید که جستجو کرده بود."],[228,"فرو رفت خاطر در این‌مشکلش","که پیغامی آمد به گوش دلش","او با وجود دغدغه‌هایش، ناگهان پیغامی از دلش می‌شنود که به وی امید و آرامش می‌دهد."],[228,"که پیش صنم پیر ناقص‌عقول","بسی گفت و قولش نیامد قبول","انسانی که نزد بت، که به نوعی معبود فرضی است، می‌رود و با عقل ناقص و نادانی‌اش بسیار صحبت می‌کند، اما هیچ‌یک از گفته‌هایش مورد پذیرش قرار نمی‌گیرد."],[228,"گر از درگه ما شود نیز رد","پس آنگه چه فرق از صنم تا صمد؟","هرگاه کسی از درگاه ما (یعنی درگاه خدا) رد شود، پس چه تفاوتی بین معبود و صنم (بت) وجود دارد؟"],[228,"دل اندر صمد باید ای دوست بست","که عاجزتر اند از صنم، هر که هست","ای دوست، باید دل را به خدا (صمد) سپرد، زیرا هر کسی که به غیر خدا (صنم) وابسته باشد، ضعیف‌تر و ناتوان‌تر است."],[228,"محال است اگر سر بر این در نهی","که باز آیدت دست حاجت تهی","اگر به درگاه خداوند نروی، محال است که حاجتت برآورده نشود، زیرا او همیشه آماده‌است که دست کمک به سوی نیازمندان دراز کند."],[228,"خدایا مقصّر به کار آمدیم","تهی‌دست و امّیدوار آمدیم","ای خدا، ما در کار خود مقصّر و گناهکاریم و با دست خالی و بی‌چیز آمدیم، اما به تو امید داریم."],[229,"شنیدم که مستی ز تاب نبید","به مقصوره مسجدی در دوید","شنیدم که شخصی به خاطر از شوق تا خوردن شراب، به شدت سرمست شده و از شوق و شادمانی وارد مقصوره (محل خاصی در مسجد) شده است."],[229,"بنالید بر آستان کرم","که یارب به فردوس اعلی برم","از روی دل‌تنگی و ناله در درگاه خداوند می‌گوید: ای خدا، دوست دارم به بهشت اعلی بروم."],[229,"مؤذن گریبان گرفتش که هین","سگ و مسجد! ای فارغ از عقل و دین","مؤذن او را به خاطر رفتار ناپسندش سرزنش می‌کند و می‌گوید که تو مانند سگی در مسجد بی‌خیال از عقل و دین هستی."],[229,"چه شایسته کردی که خواهی بهشت؟","نمی‌زیبدت ناز با روی زشت","چگونه می‌توانی به بهشت امیدوار باشی در حالی که رفتار و ظاهرت شایسته آن نیست؟ زیبایی و ناز را به تو نمی‌آید وقتی که چهره‌ات زشت است."],[229,"بگفت این سخن پیر و بگریست مست","که مستم بدار از من ای خواجه دست","پیر، این سخن را گفت و به شدت گریه کرد و از خواجه خواست که او را در حال مستی رها نکند و به حمایت خود بگیرد."],[229,"عجب داری از لطف پروردگار","که باشد گنهکاری امیدوار؟","تردیدی نیست که محبت و رحمت خداوند به قدری گسترده است که حتی گناهکاران نیز می‌توانند به امید رحمت او باشند."],[229,"تو را می‌نگویم که عذرم پذیر","در توبه باز است و حق دستگیر","من تو را نمی‌گویم که عذرت را بپذیرد، بلکه می‌گویم در توبه باز است و خداوند کمک‌کننده است."],[229,"همی شرم دارم ز لطف کریم","که خوانم گنه پیش عفوش عظیم","من از لطف خداوند بخشنده شرمنده‌ام که خطای خود را در برابر عفو بزرگ او بیان کنم."],[229,"کسی را که پیری در آرد ز پای","چو دستش نگیری نخیزد ز جای","اگر شخصی در حالتی ناتوانی و پیری زمین‌خورده باشد، اگر کمکی به او نرسانی، نمی‌تواند از زمین بلند شود."],[229,"من آنم ز پای اندر افتاده پیر","خدایا به فضل خودم دست گیر","من منم که به خاطر پیری‌ام از پا افتاده‌ام، ای خدا، به لطف و رحمت خود مرا کمک کن."],[229,"نگویم بزرگی و جاهم ببخش","فروماندگی و گناهم ببخش","از تو نمی‌خواهم که به خاطر مقام و عظمت من مرا ببخشی، بلکه خواهش می‌کنم که کمبودها و گناهانم را مورد عفو قرار دهی."],[229,"اگر یاری اندک زلل داندم","به نابخردی شهره گرداندم","اگر به خاطر نادانی و به خاطر اشتباهات کمم، کسی را یاری نکنم یا کمکی نکنم، شهرت من به بی‌خردی و نادانی افزایش می‌یابد."],[229,"تو بینا و ما خائف از یکدگر","که تو پرده پوشی و ما پرده در","تو بینا هستی و ما از یکدیگر می‌ترسیم، زیرا تو رازها را می‌دانی و ما آنها را پنهان می‌کنیم."],[229,"برآورده مردم ز بیرون خروش","تو با بنده در پرده و پرده پوش","خدای بزرگ از بیرون صدای بندگانش را می‌شنود، در حالی که آن بندگان در حال راز و نیاز با او هستند و او با پوشاندن پرده، سخنانشان را می‌پوشاند و نمی‌گذارد که دیگران بشنوند."],[229,"به نادانی ار بندگان سرکشند","خداوندگاران قلم در کشند","اگر بنده‌های نادان و سرکش سرانجام به خود بیایند و اصلاح شوند، خداوندگارانی که عادل و با قلمی حسابگر هستند، به آن‌ها جزای نیکی می‌دهند و تمام نادانی آن‌ها را می‌بخشند."],[229,"اگر جرم بخشی به مقدار جود","نماند گنهکاری اندر وجود","اگر کسی از روی بخشش و سخاوت بخشی از گناهانش را ببخشند، دیگر نشانی از گنهکاری در وجود او نخواهد بود."],[229,"وگر خشم گیری به قدر گناه","به دوزخ فرست و ترازو مخواه","اگر خداوند به اندازه گناه انسان خشمگین شود، او را به جهنم می‌فرستد و نیازی به سنجش و ترازوی اعمال نیست."],[229,"گرم دست گیری به جایی رسم","وگر بفکنی بر نگیرد کسم","اگر تو دست کسی را بگیری و به او کمک کنی، در جامعه و در دل‌ها جا پیدا می‌کنی، اما اگر او را رها کنی و کمک نکنی، کسی به تو توجه نخواهد کرد."],[229,"که زور آورد گر تو یاری دهی؟","که گیرد چو تو رستگاری دهی؟","اگر تو به کسی کمک کنی، چه کسی می‌تواند در برابر او مقاومت کند؟ و چه کسی می‌تواند به خوشبختی دست یابد اگر تو مسیر رستگاری را به او نشان دهی؟"],[229,"دو خواهند بودن به محشر فریق","ندانم کدامین دهندم طریق","در روز قیامت دو گروه هستند که نمی‌دانم کدام‌یک راه درست را به من نشان خواهند داد."],[229,"عجب گر بود راهم از دست راست","که از دست من جز کجی برنخاست","عجیب است اگر راه من از مسیر درست منحرف باشد، چون از من چیزی جز کجی و انحراف سر نزده است."],[229,"دلم می‌دهد وقت وقت این امید","که حق شرم دارد ز موی سپید","دل من به امیدی می‌تپد که خدا از موی سپید من شرم دارد."],[229,"عجب دارم ار شرم دارد ز من","که شرمم نمی‌آید از خویشتن","تعجب می‌کنم اگر خداوند از من شرم کند، در حالی که من هرگز از خودم شرم ندارم."],[229,"نه یوسف که چندان بلا دید و بند","چو حکمش روان گشت و قدرش بلند","سعدی در این بیت به یوسف اشاره می‌کند که باوجود سختی‌ها و مشکلات فراوانی که در زندگی‌اش تجربه کرد، پس از آنکه حکم و تقدیرش به بار نشست، مقام و ارزش او بالا رفت. به نوعی می‌گوید حتی یوسف هم در برابر بلایای زندگی صبر کرد و در نهایت به جایی رسید که قدر و منزلتش شناخته شد."],[229,"گنه عفو کرد آل یعقوب را؟","که معنی بود صورت خوب را","آیا آل یعقوب (خانواده یعقوب) به خاطر گناه و خطاهایی که داشتند، مورد عفو قرار گرفتند؟ زیرا زیبایی ظاهر (یعنی صورت خوب) تنها به معنی و باطن وابسته است."],[229,"به کردار بدشان مقید نکرد","بضاعات مزجاتشان رد نکرد","خدای بزرگ به خاطر کردار بد آل یعقوب آن‌ها را محدود نکرد و از خوبی‌هایشان نیز دست برنداشت."],[229,"ز لطفت همین چشم داریم نیز","بر این بی‌بضاعت ببخش ای عزیز","ما به برکت محبت و لطف تو فقط همین چشم انتظار داریم، ای عزیز، و بر این بی‌چیز (کسی که چیزی ندارد) رحم کن."],[229,"کس از من سیه نامه تر دیده نیست","که هیچم فعال پسندیده نیست","نمی‌توان هیچ‌کس را پیدا کرد که به اندازه من نامه‌نگاری بدبخت و سرشار از معاصی باشد، زیرا هیچ عمل خوبی از من سر نزده است."],[229,"جز این کاعتمادم به یاری تست","امیدم به آمرزگاری تست","جز این، من به کسی جز تو اعتماد ندارم؛ امیدم به عفو و بخشش توست."],[229,"بضاعت نیاوردم الا امید","خدایا ز عفوم مکن ناامید","من جز امیدی که به تو دارم چیزی به درگاهت نیاورده‌ام، خداوندا مرا از عفو و بخششت ناامید نکن."]]}