نمی‌برم که تو چنین مهربان و نوازشگر هستی."],[327,"همتم بدرقه راه کن ای طایر قدس","که دراز است ره مقصد و من نوسفرم","ای پرنده مقدس، دعای خیر و کمک من را در این راه طولانی به‌عنوان مهاجری که تازه‌وارد است، همراهی کن."],[327,"ای نسیم سحری بندگی من برسان","که فراموش مکن وقت دعای سحرم","ای نسیم سحر، خواهش می‌کنم دعا و نیایش من را به خدا برسان و فراموش نکن که در وقت سحر، من دعای ویژه‌ای دارم."],[327,"خرم آن روز کز این مرحله بربندم بار","و از سر کوی تو پرسند رفیقان خبرم","خوشحالم آن روزی که از این مرحله (دنیا) جدا شوم و بار زندگی‌ام را بر زمین بگذارم، و اگر رفیقانم از تو درباره‌ام بپرسند، تو (معشوق) خبر مرا بدهی."],[327,"حافظا شاید اگر در طلب گوهر وصل","دیده دریا کنم از اشک و در او غوطه خورم","حافظ به خود می‌گوید شاید اگر در جست‌وجوی زیبایی و وصال محبوب، چشمانم را مانند دریا پر از اشک کنم و در آن غرق شوم، به مراد خود برسم."],[327,"پایه نظم بلند است و جهان گیر بگو","تا کند پادشه بحر دهان پر گهرم","اگر بگویی که نظم و شعر من ریشه‌دار و بلند پایه است و در تمام دنیا مشهور شده، پادشاه دریا به من جایزه و پاداشی خواهد داد تا دهنم پر از گوهر شود."],[328,"جوزا سحر نهاد حمایل برابرم","یعنی غلام شاهم و سوگند می‌خورم","مقصود این است که در صبحگاه سحری، زودتر از همه، ستاره جوزا (که در اساطیر و فال‌گیری به عنوان نشانه‌ای از اقتدار و ثروت شناخته می‌شود) بر سرم قرار گرفته و به این معناست که من خدمت‌گذار و غلام شاه هستم و او را به‌سختی قسم می‌دهم."],[328,"ساقی بیا که از مدد بخت کارساز","کامی که خواستم ز خدا شد میسّرم","ای ساقی، بیا که به برکت بخت خوب، کامی که از خدا خواسته بودم، اکنون برایم فراهم شده است."],[328,"جامی بده که باز به شادیّ روی شاه","پیرانه‌سر، هوای جوانیست در سرم","به من جامی بده تا برای شادی و خوشحالی چهره شاه، احساس جوانی کنم و به یاد روزهای جوانی‌ام بیفتم."],[328,"راهم مزن به وصف زلال خضر که من","از جام شاه جرعه‌کش حوض کوثرم","به من نگو از ویژگی‌های زلال خضر (پرهیزگاری)، چون من از جام شاه (یعنی حکمت و معرفت) نوشیده‌ام و به نعمت حوض کوثر (سرچشمه زندگی ابدی) دست یافته‌ام."],[328,"شاها اگر به عرش رسانم سریر فضل","مملوک این جنابم و مسکین این درم","ای پادشاه، حتی اگر من را به مقام عالی و عرش برسانی، باز هم من بنده و خدمتگزار این شخص (که به آن اشاره کرده‌ام) هستم و در این مورد بی‌نوایی می‌کنم."],[328,"من جرعه‌نوش بزم تو بودم هزار سال","کی ترک آبخورد کند طبع خوگرم","من هزار سال در میکده تو شراب‌نوش بوده‌ام، آیا ممکن است طبع و مزاج من که به این عادت عادت کرده، بتواند از نوشیدن بازبماند؟"],[328,"ور باورت نمی‌کند از بنده این حدیث","از گفته کمال، دلیلی بیاورم","اگر به این حرف من درباره کمال ایمان نداری، از خودم دلیلی می‌آورم تا باور کنی."],[328,"«گر برکنم دل از تو و بردارم از تو مهر","آن مهر بر که افکنم؟ آن دل کجا برم؟»","اگر من عشق و محبت خود را از تو قطع کنم و دیگر به تو محبت نداشته باشم، این عشق را به چه کسی می‌توانم منتقل کنم؟ و قلبم را به کجا ببرم؟"],[328,"منصور بن مظفّر غازیست حرز من","وز این خجسته‌نام، بر اعدا مظفّرم","منصور بن مظفر، که یک فرمانروا و غازی (جنگجو) است، حامی و پشتیبان من است و به خاطر این نام نیکو، بر دشمنانم پیروز خواهم شد."],[328,"عهد الست من همه با عشق شاه بود","وز شاهراه عمر، بدین عهد بگذرم","عهدی که در عالم قربت (عهد الست) بستم، فقط با عشق به شاه (کاملا به عشق او) بود و از مسیر زندگی خود به خاطر این عهد عبور می‌کنم."],[328,"گردون چو کرد نظم ثریّا به نام شاه","من نظم در چرا نکنم؟ از که کمترم؟","وقتی که گردون (آسمان) ستاره‌های ثریا را به نظم و ترتیب درآورده به خاطر شاه من، چرا من که درخشان‌تر از در (لؤلؤ) هستم، نظم و ترتیب نباید داشته باشم؟ آیا من از کسی کمتر هستم؟"],[328,"شاهین‌صفت چو طعمه چشیدم ز دست شاه","کی باشد التفات به صید کبوترم","من وقتی طعمه شاهین صفت (فردی با ویژگی‌های شاهین) شدم و از دست شاه نوشیدم، دیگر چه انتظاری می‌توانم از توجه به صید کبوتر (افراد معمولی یا بی‌ارزش) داشته باشم؟"],[328,"ای شاه شیرگیر چه کم گردد ار شود","در سایه تو ملک فراغت میسّرم","ای شاهی که شیر مثل تو در قوی و دلیر بودن است، اگر در سایه تو حکومت آرامش فراهم شود، چه چیزی از ارزش تو کم می‌شود؟"],[328,"شعرم به یمن مدح تو صد ملک دل گشاد","گویی که تیغ توست زبان سخنورم","شعر من به خاطر مدح و ستایش تو، مانند این است که صد سرزمین از عشق در دل من گشوده شده است، همچنان‌که زبان شاعر به قدرت تیغ تو تند و تأثیرگذار است."],[328,"بر گلشنی اگر بگذشتم چو باد صبح","نی عشق سرو بود و نه شوق صنوبرم","اگر در باغ گلی را بگذرانم مانند باد صبح، علت آن عشق به سرو است، نه اینکه به خاطر شوق درخت صنوبر باشد."],[328,"بوی تو می‌شنیدم و بر یاد روی تو","دادند ساقیان طرب یک دو ساغرم","من بوی تو را استشمام می‌کردم و ساقیان جوان به یاد چهره‌ات دو جام شورانگیز به من دادند."],[328,"مستی به آب یک دو عنب وضع بنده نیست","من سالخورده پیر خرابات‌پرورم","مستی ناشی از نوشیدن آب و یکی دو خوشه انگور، حالتی نیست که من داشته باشم. من سالخورده و پیر هستم و در خرابات (محل تجمع شراب‌نوشان و عشاق) بزرگ شده‌ام."],[328,"با سیر اختر فلکم داوری بسیست","انصاف شاه باد در این قصه یاورم","با تماشای ستاره‌ها در آسمان، داوری‌های زیادی در مورد سرنوشت و تقدیر می‌توان انجام داد، اما در این داستان فقط انصاف و قضاوت شاه باد (نیروی بالای طبیعت) پشتیبان من است."],[328,"شکر خدا که باز در این اوج بارگاه","طاووس عرش می‌شنود صیت شهپرم","خدا را شکر می‌کنم که در این مقام بلند و باعظمت، صدای آوای پرواز من را که به زیبایی شبیه طاووس است، می‌شنود."],[328,"نامم ز کارخانه عشّاق محو باد","گر جز محبت تو بود شغل دیگرم","نام من از کارگاه عاشقان پاک شده است، اگر غیر از محبت تو، شغل دیگری داشته باشم."],[328,"شبل الاسد به صید دلم حمله کرد و من","گر لاغرم وگرنه شکار غضنفرم","شیر جنگل (شبل الأسد) به دل من حمله‌ور شد و اگرچه من لاغر و ضعیف هستم، در واقع شکار شیر (غضنفر) هستم."],[328,"ای عاشقان روی تو از ذرّه بیشتر","من کی رسم به وصل تو کز ذرّه کمترم","ای عاشقان زیبایی روی تو، من هیچگاه به درجه‌ای از وصالت نمی‌رسم، چرا که من از ذره‌ای هم کمتر هستم."],[328,"بنما به من که منکر حسن رخ تو کیست","تا دیده‌اش به گزلک غیرت برآورم","به من نشان بده که چه کسی زیبایی صورت تو را انکار می‌کند تا من او را به خاطر غیرتم تنبیه کنم."],[328,"بر من فتاد سایه خورشید سلطنت","واکنون فراغت است ز خورشید خاورم","سایه خورشید سلطنت به من افکنده شده و حالا از نور خورشید شرق (دنیای مادی و مشکلات آن) آسوده‌ام و در آرامش هستم."],[328,"مقصود از این معامله بازارتیزی است","نی جلوه می‌فروشم و نی عشوه می‌خرم","منظور از این تجارت، هوش و ذکاوت است؛ من نه زیبایی را به نمایش می‌گذارم و نه جذب طنازی می‌شوم."],[329,"تو همچو صبحی و من شمع خلوت سحرم","تبسمی کن و جان بین که چون همی‌سپرم","تو همانند صبحی و من مانند شمعی هستم که در خلوت سحر می‌سوزد. کمی لبخند بزن و جانم را ملاحظه کن که چگونه در این حال با تو احساس نزدیکی و همدلی می‌کنم."],[329,"چنین که در دل من داغ زلف سرکش توست","بنفشه زار شود تربتم چو درگذرم","چونکه دلم به خاطر کردن زلف آشفته تو آتش‌زده است، قبر من وقتی که از دنیا می‌روم، به مانند گل بنفشه خواهد شد."],[329,"بر آستان مرادت گشاده‌ام در چشم","که یک نظر فکنی، خود فکندی از نظرم","چشمانم را به درگاه خواسته‌ات باز کرده‌ام تا با یک نگاه به من بیفتی و خودت را از دیدگانم دور کنی."],[329,"چه شکر گویمت ای خیل غم، عفاک الله","که روز بی‌کسی آخر نمی‌روی ز سرم","ای گروه غم، چقدر از تو سپاسگزار باشم! خدا حافظت کند که در روزهای تنهایی‌ام، تو از ذهنم نمی‌زالی و همواره در افکارم هستی."],[329,"غلام مردم چشمم، که با سیاه دلی","هزار قطره ببارد چو درد دل شمرم","من به خاطر دلی که برای دیگران می‌سوزد، به غلامی و بندگی چشم کسی هستم که با دل سیاهش هزاران اشک می‌ریزد، در حالی که من درد دل‌های خود را شمارش می‌کنم."],[329,"به هر نظر بت ما جلوه می‌کند، لیکن","کس این کرشمه نبیند که من همی‌ نگرم","هر بار که به بتی (معشوق) نگاه می‌کنم، او جلوه‌ای زیبا از خود نشان می‌دهد، اما هیچ‌کس متوجه نمی‌شود که من نیز او را می‌نگرم و این زیبایی را می‌بینم."],[329,"به خاک حافظ اگر یار بگذرد چون باد","ز شوق در دل آن تنگنا کفن بدرم","اگر یار (محبوب) به خاک حافظ (مکان حافظ) عبور کند، به اندازه‌ای از شوق و هیجان در دل تنگ و مضطربم برای او ناله می‌کنم که گویی می‌خواهم کفن (پوشش پس از مرگ) را درآورم."],[330,"به تیغم گر کشد، دستش نگیرم","وگر تیرم زند منّت پذیرم","اگر با تیغش مرا بکشد، دست او را نمی‌گیرم و اگر با تیرش به من آسیب بزند، از او شاکر خواهم بود."],[330,"کمان ابرویت را گو بزن تیر","که پیش دست و بازویت بمیرم","ای آنکه ابرویی چون کمان داری، بگذار تیر عشق را به من بزنید تا پیش از آنکه از درد عشق بمیرد، در آغوش تو جان بسپارم."],[330,"غم گیتی گر از پایم درآرد","بجز ساغر که باشد دستگیرم؟","اگر غم دنیا مرا از پا درآورد، به جز جام شراب چه چیزی می‌تواند به من کمک کند؟"],[330,"برآی ای آفتاب صبح امّید","که در دست شب هجران اسیرم","ای خورشید صبح امید، برخیز که من در تاریکی شب جدایی گرفتار شده‌ام."],[330,"به فریادم رس ای پیر خرابات","به یک جرعه جوانم کن که پیرم","ای پیر خرابات (روحانی یا مراد که در کار شراب‌خواری است)، به فریادم برس و با یک جرعه شراب مرا جوان کن، زیرا که احساس می‌کنم پیر شدم."],[330,"به گیسوی تو خوردم دوش سوگند","که من از پای تو سر بر نگیرم","دوش (دیروقت) به گیسوی تو قسم خوردم که هرگز از عشق و محبت تو دست نخواهم کشید و از پای تو (یعنی از سر نیاز و درخواست تو) برنخواهم خاست."],[330,"بسوز این خرقه تقوا تو حافظ","که گر آتش شوم در وی نگیرم","حافظ می‌گوید اگرچه من به تقوا و پارسایی (خرقه تقوا) اعتقاد دارم، اما اگر به آتش عشق دچار شوم، این پارسایی را کنار می‌گذارم و از آن چشم‌پوشی می‌کنم."],[331,"مزن بر دل ز نوک غمزه تیرم","که پیش چشم بیمارت بمیرم","با نگاهی نکن، نگذار زخم دلم عمیق‌تر شود، چون پیش چشم تو، به خاطر عشق تو، جانم را فدای تو می‌کنم."],[331,"نصاب حسن در حدّ کمال است","زکاتم ده که مسکین و فقیرم","نصیبی از زیبایی تو به کمال رسیده است، پس زکات محبتت را به من بده، زیرا من بی‌نوا و فقیر هستم."],[331,"چو طفلان تا کی ای زاهد، فریبی","به سیب بوستان و شهد و شیرم","ای زاهد، تا کی مانند بچه‌ها تحت تاثیر زیبایی‌های ظاهری و فریبنده‌ای مانند سیب‌های باغ و عسل و شیر زندگی می‌کنم؟"],[331,"چنان پر شد فضای سینه از دوست","که فکر خویش گم شد از ضمیرم","چنان دوست در دل و فکر و خیال من جا گرفته که دیگر به خودم و یادآوری‌های خودم نمی‌اندیشم."],[331,"قدح پر کن که من در دولت عشق","جوانبخت جهانم گرچه پیرم","قدح (کاسه یا جام) را پر کن، زیرا در خوشبختی عشق قرار دارم و هرچند سنم بالا رفته، اما هنوز جوانم."],[331,"قراری بسته‌ام با می فروشان","که روز غم به جز ساغر نگیرم","با می‌فروشان توافق کرده‌ام که در روزهای غم، جز لیوان شراب در دست نگیرم و به چیز دیگری توجه نکنم."],[331,"مبادا جز حساب مطرب و می","اگر نقشی کشد کلک دبیرم","مبادا که جز حساب خوشی و لذت، چیز دیگری در زندگی من نقشی بگذراند که آن را قلم دبیر (نویسنده) بزند. به عبارت دیگر، نمی‌خواهم که مشکل یا غم در زندگی‌ام تأثیر بگذارد."],[331,"در این غوغا که کس کس را نپرسد","من از پیر مغان منّت پذیرم","در این شلوغی و هرج و مرج که هیچ‌کس از حال دیگری خبر نمی‌گیرد، من شرمنده بزرگتر و اهل خرد و دانش (مرید) هستم که مرا از یاد نبرده است."],[331,"خوشا آن دم کز استغنای مستی","فراغت باشد از شاه و وزیرم","خوشا زمانی که از بی‌نیازی و لذت مستی، از دغدغه‌های شاه و وزیر آزاد باشم و هیچ فکری درباره آن‌ها نداشته باشم."],[331,"من آن مرغم که هر شام و سحرگاه","ز بام عرش می‌آید صفیرم","من همان پرنده‌ای هستم که هر شام و سحر از بام آسمان صدایم می‌رسد."],[331,"چو حافظ گنج او در سینه دارم","اگرچه مدّعی بیند حقیرم","من مثل حافظ، گنجی بزرگ در دل دارم، هرچند که دیگران مرا ناچیز و حقیر بشمارند."],[332,"نماز شام غریبان چو گریه آغازم","به مویه‌های غریبانه، قصه پردازم","هنگامی که نماز شام تنهایی و بی­‌کسی خود را با گریه آغاز می­کنم، با ناله و زاری­‌های غریب، داستان فراق و جدایی خود را شرح می­‌دهم."],[332,"به یاد یار و دیار آنچنان بگریم زار","که از جهان ره و رسم سفر براندازم","به یاد و خاطر دوست و وطن خود آن چنان درمانده خواهم گریست، تا در جهان راه و رسم سفر و مسافرت را از بین ببرم."],[332,"من از دیار حبیبم نه از بلاد غریب","مهیمنا به رفیقان خود رسان بازم","حقیقتا، من متعلق به سرزمین دوست هستم نه از سرزمین بیگانگی و بی­‌کسی، ای خدای ایمنی دهنده مرا به پیش دوستان خودم برگردان."],[332,"خدای را مددی ای رفیق ره تا من","به کوی میکده دیگر علم برافرازم","ای رفیق راه، به خاطر خدا کمکی کن تا من بتوانم بار دیگر در کوی میکده حاضر شوم."],[332,"خرد ز پیری من کی حساب برگیرد؟","که باز با صنمی طفل، عشق می‌بازم","خرد چه زمانی می‌­خواهد پیری و سال­خوردگی مرا به حساب بیاورد، چرا که هنوز من با طفلی زیبارو مشغول عشق بازی هستم."],[332,"بجز صبا و شمالم نمی‌شناسد کس","عزیز من! که بجز باد نیست دم‌سازم","ای عزیز من، به جز باد هیچگونه همدم و دمسازی ندارم، از این رو به جز باد صبا و نسیم شمال هیچ­کس دیگر مرا نمی­‌شناسد.(نکته:مصراع دوم بیت را شاید بتوان به شکل دیگری نیز خواند، بدین ترتیب که خواجه با طنزی تلخ بیان می­‌کند که: چقدر عزیز و گرامی هستم من که تنها همدم و دمسازم باد هست!)"],[332,"هوای منزل یار، آب زندگانی ماست","صبا بیار نسیمی ز خاک شیرازم","هوای کوی یار همچون آب حیات برای ما زندگی بخش است، ای باد صبا نسیمی از خاک شیراز برای من بیاور."],[332,"سرشکم آمد و عیبم بگفت روی به روی","شکایت از که کنم؟ خانگی‌ست غمّازم","اشکم سراریز شد و عیب من را (عاشق بودن ) آشکارا بیان کرد، هنگامی که سخن چین درون خانه خودم می­‌باشد از چه کسی شکایت کنم."],[332,"ز چنگ زهره شنیدم که صبح‌دم می‌گفت","«غلام حافظ خوش‌لهجه خوش‌آوازم»","هنگام صبح، از ستاره زهره با صدای چنگ این نکته را شنیدم که می­‌گفت: من بنده و غلام حافظ خوش زبان و خوش صدا هستم."],[333,"گر دست رسد در سر زلفین تو بازم","چون گوی چه سرها که به چوگان تو بازم","اگر مرا به زلف‌های تو دسترسی پیدا شود، دوباره مثل یک گوی می‌چرخم، زیرا چه سرهایی که به خاطر محبت و زیبایی تو به میدان آمده‌اند."],[333,"زلف تو مرا عمر دراز است ولی نیست","در دست، سر مویی از آن عمر درازم","زلف تو برای من زندگی طولانی و ماندگاری به ارمغان آورده است، اما من هیچ‌چیز از آن، حتی یک تار مو، در دست ندارم."],[333,"پروانه راحت بده ای شمع که امشب","از آتش دل پیش تو چون شمع گدازم","ای شمع، همچنان که پروانه را آرامش می‌دهی، به من هم آرامش بده زیرا امشب از عشق و آتش دلی که دارم، در مقابل تو همچون شمع آب می‌شوم."],[333,"آن دم که به یک خنده دهم جان چو صراحی","مستان تو خواهم که گزارند نمازم","در آن لحظه که با یک لبخند تو جانم را می‌دهم، مانند شراب مستانه‌ای که در صراحی ریخته شده، می‌خواهم که مراسم عبادتم را برگزار کنند."],[333,"چون نیست نماز من آلوده نمازی","در میکده زان کم نشود سوز و گدازم","از آن‌جا که نماز من پاک نیست، در میخانه هم نمی‌توانم نماز بخوانم، ولی این‌جا هم بی‌سوز و گداز نخواهم ماند."],[333,"در مسجد و میخانه خیالت اگر آید","محراب و کمانچه ز دو ابروی تو سازم","اگر خیال تو به مسجد یا میخانه بیفتد، من از دو ابروی تو محراب ن prayers و کمانچه‌ای می‌سازم."],[333,"گر خلوت ما را شبی از رخ بفروزی","چون صبح بر آفاق جهان سر بفرازم","اگر شبی تو با چهره‌ات به خلوت ما بیایی، مانند صبح که بر همه جا روشنایی می‌افکند، من هم بر فراز عالم ظاهر می‌شوم."],[333,"محمود بود عاقبت کار در این راه","گر سر برود در سر سودای ایازم","در نهایت، محمود (محمود غزنوی، پادشاه معروف) نتیجه کار در این مسیر (عشق یا اشتیاق) خواهد بود، اگرچه ممکن است در این راه، سر (حیات یا جان) خود را به خاطر محبت به ایاز، محبوبش، فدا کند."],[333,"حافظ غم دل با که بگویم؟ که در این دور","جز جام نشاید که بود محرم رازم","من نمی‌دانم غم دل‌ام را با چه کسی بگویم، زیرا در این زمان تنها می‌نوشیدنی (جام) است که می‌تواند رازهای من را در خودش نگه‌دارد."],[334,"در خرابات مغان گر گذر افتد بازم","حاصل خرقه و سجاده، روان دربازم","اگر در خرابات (محل فساد و بزم‌نشینی) مغان (مغ‌ها یا زرتشتیان) بگذرم، دوباره بازمی‌گردم و از خرقه و سجاده (پوشش و عبادت) که برای منافع معنوی است، روان و آزاد می‌شوم."],[334,"حلقه توبه گر امروز چو زهّاد زنم","خازن میکده فردا نکند در، بازم","اگر امروز در مراسم توبه مانند زهدپیشگان (زهّاد) حلقه توبه به دست کنم، فردا در میکده (محل نوشیدن شراب) خازن (نگهبان) اجازه نخواهد داد که وارد شوم."],[334,"ور چو پروانه دهد دست، فراغ بالی","جز بدان عارض شمعی نبود پروازم","اگر مانند پروانه دست بگشاید، نمی‌توانم به چیزی غیر از چهره‌ی شمع (یعنی محبوب) پرواز کنم و از او فاصله بگیرم."],[334,"صحبت حور نخواهم که بود عین قصور","با خیال تو اگر با دگری پردازم","من صحبت و گفتگوی حوریان را نمی‌خواهم، زیرا در مقایسه با آن، این موضوع به خاطر خیال تو و به رغم این‌که با کسی دیگر در ارتباط باشم، نقص و کمبود به شمار می‌رود."],[334,"سرّ سودای تو در سینه بماندی پنهان","چشم تر دامن اگر فاش نکردی رازم","عشق و شوق تو در دل من به طور پنهان باقی مانده است و اگر چشمان گریانم دامن تو را به خاطر این راز فاش نکرده، دلیل بر پنهانی بودن آن نیست."],[334,"مرغ سان از قفس خاک هوایی گشتم","به هوایی که مگر صید کند شهبازم","مانند پرنده‌ای از قفس خاکی (دنیا) آزاد شدم و به جایی پرواز کردم که شاید مرا شکار کند. این پرواز به سمت آسمانی است که می‌تواند برنده‌ای (شهباز) چون من را به دام بیندازد."],[334,"همچو چنگ ار به کناری ندهی کام دلم","از لب خویش چو نی یک نفسی بنوازم","اگر همچون ساز چنگ مرا در آغوش نگیری و ننوازی حداقل همچون نی مرا با لبانت یک لحظه بنواز (کنار: آغوش)"],[334,"ماجرای دل خون گشته نگویم با کس","زان که جز تیغ غمت نیست کسی دمسازم","دل من از درد عشق به شدت آزار دیده است و نمی‌خواهم این ماجرای غم‌انگیز را با کسی بگویم، زیرا هیچ‌کس جز خود تو (عشق) همراه و همدرد من نیست."],[334,"گر به هر موی، سری بر تن حافظ باشد","همچو زلفت همه را در قدمت اندازم","اگر به ازای هر موی زلفت، سرداری بر بدن حافظ باشد، من آن‌ها را همگی در راه قدم‌هایت می‌افکنم."],[335,"مژده وصل تو کو کز سر جان برخیزم","طایر قدسم و از دام جهان برخیزم","هنگامی که خبر رسیدن به تو (معشوق و معبود) به من داده شود من از زندگی و نیرنگ های او دست می کشم و از جان خود می گذرم تا به تو برسم"],[335,"به ولای تو که گر بنده خویشم خوانی","از سر خواجگی کون و مکان برخیزم","قسم به محبت تو که اگر مرا بنده خود بخوانی من برای بندگی تو حاضرم سروری جهان را رها کنم تا بنده‌ی تو باشم"],[335,"یا رب از ابر هدایت برسان بارانی","پیشتر زان که چو گردی ز میان برخیزم","پروردگارا از ابر هدایت و راهنمایی بر ما بارانی برسان (مارا راهنمایی کن) تا قبل از اینکه مهلت زندگیم به پایان رسد و بدون رستگاری چشم از این جهان فروبندم (بارش باران و بلند شدن گرد ، هنگامی که باران ببارد زمین گل شده و خاک بلند نمی شود خاک و آب < گل > عنصر وجودی انسان)"],[335,"بر سر تربت من با می و مطرب بنشین","تا به بویت ز لحد رقص کنان برخیزم","بر سر خاک من با شراب و نوازنده بنشین و شادی کن تا که من نیز با بوی وجود تو دوباره زنده شوم و رقص کنان از خاک بلند شوم"],[335,"خیز و بالا بنما ای بت شیرین حرکات","کز سر جان و جهان دست فشان برخیزم","ای معشوق زیبا و دلربا برخیز و قامت و زیبایی خود را نشان بده زیرا من از سر جان و جهان (از همه وابستگی‌های دنیوی و حتی جان خود) دست می‌شویم و رها می‌شوم."],[335,"گرچه پیرم تو شبی تنگ در آغوشم کش","تا سحرگه ز کنار تو جوان برخیزم","با اینکه پیر شده ام و دیگر جوان نیستم اگر تو مرا شبی در آغوش گیری با وجود تو صبح جوان از بستر بلند می شوم"],[335,"روز مرگم نفسی مهلت دیدار بده","تا چو حافظ ز سر جان و جهان برخیزم","در روز مرگم اگر لحظه ای به دیدن من بیایی و مرا ببینی من نیز مانند حافظ با شادی جهان را ترک بگوییم و جانم را رها می کنم"],[336,"چرا نه در پی عزم دیار خود باشم","چرا نه خاک سر کوی یار خود باشم","چرا به دیار خود نروم؟ چرا به نزد معشوق خود نروم؟"],[336,"غم غریبی و غربت چو بر نمی‌تابم","به شهر خود روم و شهریار خود باشم","وقتی‌که غم غریبی و دیار غربت را نمی‌توانم تحمل کنم؛ پس به دیار و وطن خود می‌روم و آقا و شاه خود می‌شوم.."],[336,"ز محرمان سراپرده وصال شوم","ز بندگان خداوندگار خود باشم","از نزدیکان اندرونی می‌شوم و به وصال می‌رسم؛ از بندگان محبوب خود می‌شوم."],[336,"چو کار عمر نه پیداست باری آن اولی","که روز واقعه پیش نگار خود باشم","وقتی که عاقبت زندگی خود را نمی‌دانم پس همان بهتر که در روز مرگ (یا سختی) در نزد یار خود باشم."],[336,"ز دست بخت گران‌خواب و کار بی‌سامان","گرم بود گله‌ای، رازدار خود باشم","اگر هم از دست بخت بی‌خیال و زندگی بی‌سامان خود شکایتی داشته‌باشم، با خودم درد دل می‌گویم."],[336,"همیشه پیشه من عاشقی و رندی بود","دگر بکوشم و مشغول کار خود باشم","شغل من همیشه عاشقی و رندی بوده است، پس از این نیز به همین پیشه می‌پردازم."],[336,"بود که لطف ازل رهنمون شود حافظ","وگرنه تا به ابد شرمسار خود باشم","امیدوارم که لطف ازلی و خدایی راهنمایی کند ای حافظ! وگرنه تا ابد شرمسار خود خواهم بود."],[337,"من دوستدار روی خوش و موی دلکشم","مدهوش چشم مست و می صاف بی‌غشم","من به زیبایی صورت و جذابیت موهای دلربا علاقه‌مند هستم و تسخیر چشمان مست و شراب زلال و بی‌عیب شده‌ام."],[337,"گفتی ز سرّ عهد ازل یک سخن بگو","آنگه بگویمت که دو پیمانه در کشم","گفتی از راز عهد ازل (پیمانی که خدا با انسان پیش از آفرینش جهان بسته است) یک سخن بگو. بعد از آن می‌گویم که دو پیمانه می‌ نوشم."],[337,"من آدم بهشتیم اما در این سفر","حالی اسیر عشق جوانان مهوشم","من آدم بهشتی ام، اما در این سفر (زندگی)، اسیر و گرفتار عشق جوانان زیبا هستم."],[337,"در عاشقی گزیر نباشد ز ساز و سوز","استاده‌ام چو شمع، مترسان ز آتشم","در عشق، از ساز (موسیقی) و سوختن دل (شادی و غم) چاره و فراری وجود ندارد. من همچون شمع ایستاده‌ام (و میسوزم)، مرا از شعله آتش مترسان."],[337,"شیراز معدن لب لعل است و کان حسن","من جوهریّ مفلسم، ایرا مشوّشم","شیراز سرشار از (دلبران با) لب های لعل گون است و معدن زیبایی. من گوهر فروش (زرگر) مفلس‌ام و بدین سبب پریشان‌ام (که ازین گهرها، یعنی لب لعل‌گون و حسن دلبران، مستفید شده نمیتوانم)."],[337,"از بس که چشم مست در این شهر دیده‌ام","حقّا که می نمی‌خورم اکنون و سرخوشم","از بس که چشمان مستانه‌ و خمارآلود را در این شهر دیده‌ام، واقعا این روزها دیگر شراب نمی‌خورم (نیازی به خوردن شراب با وجود این چشمان مست ندارم) و خوشحالم (چون شراب من چشمان مست زیبارویان شهر است)."],[337,"شهریست پر کرشمه حوران ز شش جهت","چیزیم نیست ور نه خریدار هر ششم","شهری است که از هر طرف پر از ناز و کرشمه حوران و زیبارویان است. من از (مال و منال) دنیا چیزی ندارم وگرنه خریدار همه حوران و زیبارویان این شهر هستم."],[337,"بخت ار مدد دهد که کشم رخت سوی دوست","گیسوی حور گرد فشاند ز مفرشم","اگر بخت یاری‌ام کند که دار و ندارم را به سوی محبوب ببرم (به سوی دوست سفر کنم)، آنگه حوران بهشتی با گیسوان خود از فرش من (اسباب سفرم) گرد راه را پاک می‌کنند."],[337,"حافظ عروس طبع مرا جلوه آرزوست","آیینه‌ای ندارم از آن آه می‌کشم","عروس ذوق و سلیقه من، نماد آرزوهای من است و من به خاطر این‌که نتوانستم از آن به‌خوبی بهره‌برداری کنم، همواره در حسرت و آه هستم."],[338,"خیال روی تو چون بگذرد به گلشن چشم","دل از پی نظر آید به سوی روزن چشم","چهره تو وقتی که در خیال بیفتد، باعث می‌شود که دل، به دنبال دیدن تو، به سمت آن روزن که جایی برای دیدن است، برود."],[338,"سزای تکیه گهت منظری نمی‌بینم","منم ز عالم و این گوشه معیّن چشم","برای آنکه در تکیه‌گاه تو، مناظر زیبایی وجود داشته باشد، من چیزی نمی‌بینم. من از این دنیا و این گوشه مشخص چشمانم دورم."],[338,"بیا که لعل و گهر در نثار مقدم تو","ز گنج‌خانه‌‌ دل می‌کشم به روزن چشم","بیا تا گوهری چون لعل و مروارید را به پای تو افشا کنم، زیرا برای تو از گنجینه دل، به چشمانم نگاه می‌کنم."],[338,"سحر سرشک روانم سر خرابی داشت","گرم نه خون جگر می‌گرفت دامن چشم","وقت سحر، اشک‌های روان من به خاطر خیانت و آسیب دیدن قلبم از عشق تو، دلیلی برای بی‌حالی و خرابی داشت؛ اگر چه اگر خون جگر من گرفته می‌شد، دامن چشمانم را نمی‌آلود."],[338,"نخست روز که دیدم رخ تو دل می‌گفت","اگر رسد خللی، خون من به گردن چشم","در نخستین روزی که چهره تو را دیدم، قلبم می‌گفت که اگر مانع یا مشکلی پیش بیاید، خونم بر گردن چشمانم خواهد بود."],[338,"به بوی مژده وصل تو تا سحر، شب دوش","به راه باد نهادم چراغ روشن چشم","به خاطر بوی خوش خبر وصل تو تا صبحگاه، دیشب چراغ چشمانم را به سوی باد روشن گذاشتم."],[338,"به مردمی که دل دردمند حافظ را","مزن به ناوک دلدوز مردم افکن چشم","به آن کسانی که دل پر درد حافظ را نزنند و با سختی‌های عشق بی‌رحمی نکنند، بگویید به چشمان دیگران آزار نرسانند."],[339,"من که از آتش دل چون خم می در جوشم","مهر بر لب زده، خون می‌خورم و خاموشم","من به شدت از عشق و آتش دل رنج می‌برم و احساساتی مشابه یک خم می دارم که در حال جوشانیدن است. با این حال، هرچند درد و غم به جانم فشار می‌آورد، به هیچ‌کس چیزی نمی‌گویم و ساکت مانده‌ام."],[339,"قصد جان است طمع در لب جانان کردن","تو مرا بین که در این کار به جان می‌کوشم","من قصد دارم جان خودم را در آرزوی لب‌های محبوب به خطر بیندازم. تو خود تماشا کن که در این کار چقدر تلاش می‌کنم و جانم را به مخاطره می‌اندازم."],[339,"من کی آزاد شوم از غم دل؟ چون هر دم","هندوی زلف بتی حلقه کند در گوشم","من هرگز از غم دل رهایی نخواهم یافت، زیرا هر لحظه زلف‌های بتی که به شکل یک هندو است، در گوشم حلقه می‌کند."],[339,"حاش للّه که نیم معتقد طاعت خویش","این قدر هست که گه گه قدحی می‌نوشم","من هرگز نمی‌توانم معتقد باشم که به بندگی خود پایبندم، زیرا گاهی شراب می‌نوشم و از این نظر آزاد هستم."],[339,"هست امیدم که علیرغم عدو روز جزا","فیض عفوش ننهد بار گنه بر دوشم","امید دارم که در روز قیامت، با وجود دشمنان، فیض بخشش الهی شامل حالم شود و بار گناهم بر دوش من نخواهد بود."],[339,"پدرم روضه رضوان به دو گندم بفروخت","من چرا ملک جهان را به جوی نفروشم؟!","پدر من به خاطر دو دانه گندم، بهشت را فروخت. من چرا باید دارایی و سرزمین گسترده جهان را به یک جوی آب بفروشم؟!"],[339,"خرقه‌پوشی من از غایت دین‌داری نیست","پرده‌ای بر سر صد عیب نهان می‌پوشم","رسیدگی به ظاهر و نشان دادن خود به عنوان یک فرد دیندار، هدف من نیست. من این لباس و پوشش را به عنوان پرده‌ای برای پنهان کردن عیوب و نقص‌های پنهان خود بر تن کرده‌ام."],[339,"من که خواهم که ننوشم به جز از راوق خم","چه کنم گر سخن پیر مغان ننیوشم؟","من فقط می‌خواهم از شراب خوشگوار ب‍خورم و جز آن چیزی ننوشم، اما اگر به نصیحت پیر مغان گوش ندهم، چه باید بکنم؟"],[339,"گر از این دست زند مطرب مجلس ره عشق","شعر حافظ ببرد وقت سماع از هوشم","اگر مطرب، (که نوازنده است) در این مجلس، با نغمه‌های دلنواز خود به عشق بزند و اشعار حافظ را بخواند، در زمان خوشی و سماع، عقل و هوش من را از دست می‌دهد."],[340,"گر من از سرزنش مدّعیان اندیشم","شیوه مستی و رندی نرود از پیشم","اگر من به حرف‌های سرزنش‌آمیز متّهمانی که خود را حق‌طلب می‌دانند توجه کنم، دیگر نمی‌توانم به شیوه خوش گذرانی و رندی‌ام ادامه دهم."],[340,"زهد رندان نوآموخته راهی به دهیست","من که بدنام جهانم چه صلاح اندیشم؟","ریاکاری و زهد کسانی که تازه به رندی و زندگی آزادانش عادت کرده‌اند، مرا به جایی نمی‌رساند. اکنون که در دنیا بدنام هستم، چه فایده‌ای دارد که بخواهم به شیوه‌های درست و صالح فکر کنم؟"],[340,"شاه شوریده‌سران خوان، من بی‌سامان را","زان که در کم‌خردی از همه عالم بیشم","ای شاه دیوانه‌ها، تو که می‌دانی من چقدر در بی‌نظمی و بی‌هویتم، به خاطر اینکه در نادانی و ناتوانی خود از همه مردم دنیا بدترم."],[340,"بر جبین نقش کن از خون دل من خالی","تا بدانند که قربان تو کافرکیشم","بر پیشانی‌ام از غم و اندوه خود علامت بگذار تا همه بفهمند که برای تو جانم را فدای عشق تو کرده‌ام."],[340,"اعتقادی بنما و بگذر بهر خدا","تا در این خرقه ندانی که چه نادرویشم","نمایش عقیده‌ات را در میان بگذار و به خاطر خدا از این لباس درویشی بگذر تا در این حالت نتوانی بفهمی که چه اندازه فقیر و تهیدستم."],[340,"شعر خونبار من ای باد، بدان یار رسان","که ز مژگان سیه، بر رگ جان زد نیشم","ای باد، شعر غم‌انگیز من را به آن یار برسان که از چشمان سیاهش بر رگ جانم زهر شده است."],[340,"من اگر باده خورم ور نه چه کارم با کس؟","حافظ راز خود و عارف وقت خویشم","اگر من شراب بنوشم یا نخورم، چه ارتباطی به دیگران دارد؟ من حافظ هستم که راز خودم را می‌دانم و عارف زمان خودم هستم."],[341,"حجاب چهره جان می‌شود غبار تنم","خوشا دمی که از آن چهره پرده برفکنم","ظاهر مادی بدن مانند غباری است که بر روی چهره روح و جان انسان نشسته است. خوشا زمانی که بتوانم این حجاب را کنار بزنم و زیبایی واقعی‌ام را نشان دهم."],[341,"چنین قفس نه سزای چو من خوش‌الحانی‌ست","روم به گلشن رضوان، که مرغ آن چمنم","این قفس برای من که خوش‌صدا هستم، مناسب نیست؛ باید به گلشن رضوان بروم، زیرا من پرنده‌ای از آن باغ هستم."],[341,"عیان نشد که چرا آمدم، کجا رفتم","دریغ و درد که غافل ز کار خویشتنم","من نمی‌دانم که چرا به دنیا آمدم و کجا رفتم. افسوس و دریغ بر من که از کارها و سرنوشت خود غافل هستم."],[341,"چگونه طوف کنم در فضای عالم قدس؟","که در سراچه ترکیب، تخته‌‌بند تنم","نمی‌دانم چگونه می‌توانم در عالم ناب و روحانی پرواز کنم، در حالی که در دنیای مادی و جسمانی‌ام، به قید و بند بدنم گرفتار شده‌ام."],[341,"اگر ز خون دلم بوی شوق می‌آید","عجب مدار که هم‌درد نافه ختنم","اگر از دل من بویی از عشق به مشام می‌رسد، تعجب نکن؛ چون من همدرد و همسان با نافه ختن هستم."],[341,"طراز پیرهن زرکشم مبین چون شمع","که سوزهاست نهانی درون پیرهنم","به زیبایی و ارزش پیراهن زربافت من توجه نکن، چون مانند شمعی است که سوز و آتش درونش پنهان است."],[341,"بیا و هستی حافظ ز پیش او بردار","که با وجود تو کس نشنود ز من که منم","مصرع دوم : وقتی وجودم سرشار از تو شد ، هیچ چیز و هیچ کس ، از من رفتار و کلامی نخواهد شنید که نشان از من و منیت در آن باشد ) فارغم از هرگونه وابستگی و دلبستگی ("],[342,"چل سال بیش رفت که من لاف می‌زنم","کز چاکران پیر مغان کمترین منم","مدت چهل سال است که من ادعا می‌کنم از میان پیروان و خدمت‌گذاران (شاگردان) مردان بزرگ عرفان و صنعت شراب‌سازی، من کمترین هستم."],[342,"هرگز به یمن عاطفت پیر می‌فروش","ساغر تهی نشد ز می صاف روشنم","هرگز به برکت محبت پیر می‌فروش، کوزه‌ام هیچ‌گاه خالی از شراب صاف و روشن نبوده است."],[342,"از جاه عشق و دولت رندان پاک‌باز","پیوسته صدر مصطبه‌ها بود مسکنم","به خاطر مقام عشق و خوشی‌های معنوی که از رندان سخی به دست آمده، همواره در بالاترین جایگاه و مقام اجتماعی قرار داشته‌ام."],[342,"در شأن من به دردکشی ظنّ بد مبر","کآلوده گشت جامه، ولی پاک‌دامنم","درباره من در مورد مصرف مشروبات الکلی بدگمانی نداشته باش، زیرا اگر جامه‌ام آلوده شده باشد، اما من از نظر اخلاقی و پاکی دامن پاک هستم."],[342,"شهباز دست پادشهم، این چه حالت است؟","کز یاد برده‌اند هوای نشیمنم","من شهباز (پرنده‌ای قوی و آزاد) دست پادشاه هستم، اما چرا این‌قدر درگیر شده‌ام؟ گویی فراموش کرده‌اند به یاد سرزمین و محل زندگی‌ام باشم."],[342,"حیف است بلبلی چو من اکنون در این قفس","با این لسان عذب، که خامش چو سوسنم","حیف است که بلبلی مثل من در این قفس باشم و با چنین زبان شیرینی سخن نگویم، مانند سوسنی که سکوت کرده است."],[342,"آب و هوای فارس عجب سفله‌پرور است","کو همرهی؟ که خیمه از این خاک برکنم","آب و هوای فارس به شدت ناامیدکننده و فرسوده‌است، و من از چه کسی کمک بگیرم تا از این سرزمین و شرایط سختش فرار کنم؟"],[342,"حافظ! به زیر خرقه قدح تا به کی کشی؟","در بزم خواجه، پرده ز کارت برافکنم","ای حافظ! تا کی قرار است در زیر لباس زهد و رهبانی، نوشیدنی بنوشی؟ من در میخانه این بزرگوار، پرده از کار تو برمی‌دارم و حقیقت را نشان می‌دهم."],[342,"توران‌شه خجسته که در من یزید فضل","شد منّت مواهب او طوق گردنم","توران‌شه، پادشاهی خوش‌یمن است که به من (حافظ) فضل و لطف بسیاری کرده است، به‌گونه‌ای که نعمت‌های او مانند طوقی به گردن من آویخته شده است."],[343,"عمریست تا من در طلب، هر روز گامی می‌زنم","دست شفاعت هر زمان در نیک نامی می‌زنم","زمان زیادی به طول یک عمر است که هر روز و مداوم در جستجو هستم. هر زمان برای اینکه شفاعتم کنند به نیک نامی مراجعه می کنم ."],[343,"بی ماه مهرافروز خود، تا بگذرانم روز خود","دامی به راهی می‌نهم، مرغی به دامی می‌زنم","بدون وجود ماه زیبای خود، برای گذراندن روزهایم، دام‌هایی در راه می‌گذارم و بدین‌وسیله مرغی را به دام می‌اندازم."],[343,"اورنگ کو؟ گلچهر کو؟ نقش وفا و مهر کو؟","حالی من اندر عاشقی، داو تمامی می‌زنم","سؤالاتی از عدم حضور مقام و شکوهمندی عشق می‌پرسد و آرزو دارد که صفا و وفای عشقی را که از او دور شده، بیابد. اکنون در عشق، به تمام چیزها و هرگونه جذابیتی توجه می‌کند."],[343,"تا بو که یابم آگهی از سایه سرو سهی","گلبانگ عشق از هر طرف، بر خوش خرامی می‌زنم","در جستجوی خبری از سایه درخت بلند و زیبایی که نشانه عشق است، صدای عشق را از جهات مختلف می‌شنوم و به خوشحالی و شادابی می‌رقصم."],[343,"هرچند کـ‌آن آرام دل، دانم نبخشد کام دل","نقش خیالی می‌کشم، فال دوامی می‌زنم","با این‌که می‌دانم آن آرامش دل، رضایت و خوشحالی من را نمی‌دهد، اما باز هم تصویرها و خیالی از آن را در ذهنم می‌سازم و برای خودم پیش‌بینی و مهر و محبت می‌کنم."],[343,"دانم سر آرد غصّه را، رنگین برآرد قصّه را","این آه خون افشان که من، هر صبح و شامی می‌زنم","می‌دانم که غم و اندوه را به نتیجه‌ای نمی‌رساند، ولی این ناله‌ی دل‌خراش که من هر صبح و شب به آن می‌پردازم، داستانی پررنگ و زیبا خلق می‌کند."],[343,"با آن که از وی غایبم، وز می چو حافظ تایبم","در مجلس روحانیان، گه گاه جامی می‌زنم","با اینکه از محبوبم دور هستم و از می، همچون حافظ، بهره‌مندم، در جمع روحانیان گاهی جرعه‌ای می‌نوشم."],[344,"بی تو ای سرو روان، با گل و گلشن چه کنم؟","زلف سنبل چه کشم عارض سوسن چه کنم؟","بی‌تو ای سرو خوش‌قد و قامت، در میان گل‌ها و باغ چه کنم؟ در حالی که موهایم مانند زلف سنبل است، با چهره‌ام مانند گل سوسن چه کار کنم؟"],[344,"آه کز طعنه بدخواه ندیدم رویت","نیست چون آینه‌ام روی ز آهن، چه کنم؟","آه که به خاطر طعنه‌ها و کنایه‌های بدخواهان، دیگر تو را نمی‌بینم. اکنون مانند آئینه‌ای هستم که رویش از آهن است و نمی‌تواند به درستی نور را منعکس کند، پس چه کار باید بکنم؟"],[344,"برو ای ناصح و بر دردکشان خرده مگیر","کارفرمای قدر می‌کند این، من چه کنم؟","ای نصیحت‌گر، رندان و باده‌نوشان را سرزنش نکن و از کار آنها ایراد نگیر، خداوند این تقدیر را برای ما رقم زده، من در برابر این شرایط چه کار می‌توانم بکنم؟"],[344,"برق غیرت چو چنین می‌جهد از مکمن غیب","تو بفرما که من سوخته خرمن چه کنم؟","وقتی غیرت و شجاعت به این اندازه از جای پنهانی نمایان می‌شود، تو به من بگو که من، که مثل خرمن سوخته ناامیدم، چه باید بکنم؟"],[344,"شاه ترکان چو پسندید و به چاهم انداخت","دستگیر ار نشود لطف تهمتن چه کنم؟","وقتی پادشاه این سرنوشت را برای من روا داشت و مرا در چاه انداخت اگر لطف رستم یاریگر من برای بیرون آمدن از چاه نشود، من چه کاری می‌توانم بکنم؟(تلمیح به داستان بیژن و منیژه)"],[344,"مددی گر به چراغی نکند آتش طور","چاره تیره‌شب وادی ایمن چه کنم؟","اگر خداوند به مدد یک چراغ، همان‌گونه که بر کوه طور آتش افروخت، به من نور نرساند، در این شب تاریک و پرخطر چه باید بکنم؟"],[344,"حافظا خلدبرین خانه موروث من است","اندر این منزل ویرانه نشیمن چه کنم؟","ای حافظ، بهشت برین خانه‌ای است که به ارث از گذشتگانم به من رسیده. چرا باید دل به این دنیای سست بنیاد و گذرا ببندم؟"],[345,"من نه آن رندم که ترک شاهد و ساغر کنم","محتسب داند که من این کارها کمتر کنم","من اهل باده‌نوشی و میخانه نیستم و نمی‌توانم به راحتی از مشروب و تماشای محبوب چشم بپوشم. نگهبان میخانه می‌داند که من این کارها را کمتر انجام می‌دهم."],[345,"من که عیب توبه‌کاران کرده باشم بارها","توبه از می وقت گل دیوانه باشم گر کنم","من بارها عیب کسانی را که توبه کرده‌اند و به می‌خوارگی برگشته‌اند، گفته‌ام؛ حالا اگر بخواهم در زمان گل، دیوانه‌وار از شراب بنوشم، چه می‌شود؟"],[345,"عشق دردانه‌ست و من غوّاص و دریا میکده","سر فروبردم در آن جا تا کجا سر برکنم","عشق، گوهری ارزشمند است و من مانند غواصی هستم که در دریا غرق می‌شود. من در میخانه سر را به عمق عشق فرود آورده‌ام، اما نمی‌دانم تا کی باید چنین باشم."],[345,"لاله ساغرگیر و نرگس مست و بر ما نام فسق","داوری دارم بسی یا رب، که را داور کنم؟","بیشتر از لاله و نرگس (که نماد زیبایی و مستی هستند) بر ما نام زشتی و فساد می‌رانند و من این را به خدا می‌گویم و می‌پرسم که آیا کسی را می‌توان پیدا کرد که به طور عادلانه این قضیه را قضاوت کند؟"],[345,"بازکش یک دم عنان ای ترک شهرآشوب من","تا ز اشک و چهره راهت پر زر و گوهر کنم","ای معشوق شهرآشوب من، لختی کنترل خود را کنار بگذار تا با اشک و زیبایی چهره‌ات، راه تو را پر از زر و جواهر کنم."],[345,"من که از یاقوت و لعل اشک دارم گنج‌ها","کی نظر در فیض خورشید بلنداختر کنم","من با داشتن گنج‌های ارزشمندی چون یاقوت و لعل، که همان اشک‌های من هستند، دیگر چه نیازی دارم که به نور خورشید بلند و باعظمت نگاه کنم."],[345,"چون صبا مجموعه گل را به آب لطف شست","کج دلم خوان، گر نظر بر صفحه دفتر کنم","وقتی که نسیم صبح، مجموع گل‌ها را به آب لطیف شستشو می‌دهد، دلم می‌گوید اگر نگاهی به ورق‌های دفتر شعر بیندازم، احتمالا چیزهای خوبی در آن هست."],[345,"عهد و پیمان فلک را نیست چندان اعتبار","عهد با پیمانه بندم، شرط با ساغر کنم","عهد و پیمان الهی (فلک) ارزش زیادی ندارد، بنابراین من به پیمانه شراب (پیمانه) اعتماد می‌کنم و شرطی با ساغر (جام شراب) می‌گذارم."],[345,"من که دارم در گدایی گنج سلطانی به دست","کی طمع در گردش گردون دون‌پرور کنم","من که در عالم فقر و قناعت خزانه بی‌نیازی را مانند شاهان در اختیار دارم، هرگز از آسمان پر گسترش فرومایگان، توقع و چشم داشتی نخواهم داشت."],[345,"گر چه گردآلود فقرم، شرم باد از همتم","گر به آب چشمه خورشید دامن تر کنم","هرچند که در فقر و تنگدستی به سر می‌برم، از تلاش و اراده‌ام شرمنده نیستم اگر سرم را به چشمه نور خورشید برسانم و آن را تر کنم."],[345,"عاشقان را گر در آتش می‌پسندد لطف دوست","تنگ چشمم گر نظر در چشمه کوثر کنم","اگر دوست عاشقان را در آتش آزمایش و می‌پسندد، من با دلسوزی و تنگ‌چشمی اگر به چشمه کوثر (منبع نعمت و برکت) نگاه کنم، از خودم راضی نخواهم بود."],[345,"دوش لعلش عشوه‌ای می‌داد حافظ را، ولی","من نه آنم کز وی این افسانه‌ها باور کنم","دیشب لب‌های سرخ او برای حافظ عشوه و ناز می‌کرد، اما من به خاطر شکوه و زیبایی‌اش آن قدر ساده نیستم که اینگونه داستان‌ها را باور کنم."],[346,"صنما با غم عشق تو چه تدبیر کنم؟","تا به کی در غم تو ناله شبگیر کنم؟","ای معشوقه، با این درد ناشی از عشق تو چه چاره‌ای می‌توانم بیندیشم؟ تا کی باید در غم تو شب‌ها ناله کنم؟"],[346,"دل دیوانه از آن شد که نصیحت شنود","مگرش هم ز سر زلف تو زنجیر کنم","دل دیوانه‌ام به خاطر نصیحت‌های دیگران دیوانه شده است، اما اگر بتوانم، او را با زنجیری از موهای زیبایت به خودم وصل می‌کنم."],[346,"آن چه در مدت هجر تو کشیدم هیهات","در یکی نامه محال است که تحریر کنم","آنچه در دوران جدایی از تو بر من گذشته بسیار دردناک و غیرقابل توصیف است و نمی‌توانم تمام آن را در یک نامه بنویسم."],[346,"با سر زلف تو مجموع پریشانی خود","کو مجالی که سراسر همه تقریر کنم؟","از آن لحظه که در پیچ‌وتاب زلف تو گم شدم، دیگر مجالی برای پرداختن به هیچ درد و پریشانی دیگری نماند؛ همه‌ی فکر و یادم در همان سر زلف تو متوقف شده است"],[346,"آن زمان کآرزوی دیدن جانم باشد","در نظر نقش رخ خوب تو تصویر کنم","وقتی که آرزوی دیدن تو در دلم باشد، چهره زیبا و دلنشینت را در ذهنم مجسم می‌کنم."],[346,"گر بدانم که وصال تو بدین دست دهد","دین و دل را همه دربازم و توفیر کنم","اگر بدانم که عشق تو به این آسانی به دست می‌آید، تمام مذهب و ایمانم را کنار می‌گذارم و به عشق تو روی می‌آورم."],[346,"دور شو از برم ای واعظ و بیهوده مگوی","من نه آنم که دگر گوش به تزویر کنم","ای واعظ، از نزد من دور شو و بی‌خود صحبت نکن، زیرا من آن فرد نیستم که به فریب و نیرنگ گوش دهم."],[346,"نیست امّید صلاحی ز فساد حافظ","چون که تقدیر چنین است، چه تدبیر کنم؟","امید به اصلاح و بهبود از فساد و تباهی حافظ وجود ندارد، زیرا سرنوشت چنین رقم خورده است، پس چه تدبیری می‌توانم اتخاذ کنم؟"],[347,"دیده دریا کنم و صبر به صحرا فکنم","واندر این کار، دل خویش به دریا فکنم","چشمم را به دریا می‌سپارم و صبرم را در بیابان رها می‌کنم و در این فرآیند، دل خود را به دریا می‌افکنم."],[347,"از دل تنگ گنه‌کار برآرم آهی","کآتش اندر گنه آدم و حوا فکنم","از دل پر از گناه و ناراحتی‌ام آهی بلند می‌کشم تا که آن آتش گناه آدم و حوا را شعله‌ور کنم."],[347,"مایه خوش‌دلی آن جاست که دل‌دار آن جاست","می‌کنم جهد که خود را مگر آن جا فکنم","خوشحالی و رضایت من بستگی به حضور معشوق دارد. تلاش می‌کنم خودم را به او برسانم، بلکه بتوانم در آنجا حضور داشته باشم."],[347,"بگشا بند قبا ای مه خورشیدکلاه!","تا چو زلفت سر سودا زده در پا فکنم","ای خورشید، بند و قفل لباس خود را باز کن تا من نیز مانند موی تو، سرمست عشق و جنون در پا باشم و آزادانه در عشق پرسه زنم."],[347,"خورده‌ام تیر فلک، باده بده تا سرمست","عقده در بند کمرترکش جوزا فکنم","با تیرهایی که تقدیر به من زده، به من شرابی بده تا سرمست شده و غم‌هایم را فراموش کنم و به خاطر کمر باریک و زیبای تو، به خیال خودم در دامان تو بیفتم."],[347,"جرعه جام بر این تخت روان افشانم","غلغل چنگ در این گنبد مینا فکنم","می‌خواهم جرعه‌ای از جام را بر این تخت نرم بریزم و صدای چنگ را در این آسمان آبی پخش کنم."],[347,"حافظا! تکیه بر ایّام چو سهو است و خطا","من چرا عشرت امروز به فردا فکنم؟","حافظ می‌گوید که تکیه بر روزهای آینده و امید به آن‌ها اشتباه و خطاست. پس چرا باید لذت‌های امروز را به آینده موکول کنم و از آن‌ها بگذرم؟"],[348,"دوش سودای رخش گفتم ز سر بیرون کنم","گفت کو زنجیر؟ تا تدبیر این مجنون کنم","شب گذشته به خیال چهره‌اش گفتم که این خیال را از سر بیرون کنم، ولی او گفت: زنجیری در کار نیست تا تدبیری برای این عاشق دیوانه اتخاذ کنم."],[348,"قامتش را سرو گفتم، سر کشید از من به خشم","دوستان از راست می‌رنجد نگارم، چون کنم؟","گفتم قامت معشوقش به زیبایی سرو است، اما او به خاطر خشم دوستانش از من فاصله گرفت. اکنون نمی‌دانم چگونه باید این دل‌مشغولی را تحمل کنم، زیرا معشوقم به راحتی از من دور می‌شود."],[348,"نکته ناسنجیده گفتم دلبرا معذور دار","عشوه‌ای فرمای تا من طبع را موزون کنم","چیزی ناپسند و ناچیز از من که عاشق تو هستم، گفته شده است، پس لطفا مرا ببخش. با ناز و عشوه‌ای که به من نشان می‌دهی، کمک کن تا روح و ذوقم را به حالت موزون برگردانم."],[348,"زردرویی می‌کشم زان طبع نازک، بی‌گناه","ساقیا جامی بده تا چهره را گلگون کنم","به خاطر طبع نازک و لطیف خود، دچار رنگ‌پریدگی و بی‌حالی شده‌ام. ساقیا، جامی به من بده تا بتوانم رنگ و رویی شاداب و گلگون پیدا کنم."],[348,"ای نسیم منزل لیلی خدا را تا به کی","ربع را برهم زنم، اطلال را جیحون کنم","ای نسیم محل لیلی (لیلی، معشوقه معروف) خدا را تا چه زمانی باید در این دشت بی‌قرار بمانم و ویرانه‌ها را مانند جیحون (رودخانه‌ای در ایران) پرآب کنم؟"],[348,"من که ره بردم به گنج حسن بی‌پایان دوست","صد گدای همچو خود را بعد از این قارون کنم","من به کمک و همراهی دوست، به گنجی از زیبایی و محبت او دست یافته‌ام و حالا تصمیم دارم به دیگران مانند خودم، که نیازمند هستند، کمک کنم و از این گنج بی‌پایان بهره‌مندشان کنم."],[348,"ای مه صاحب قران، از بنده حافظ یاد کن","تا دعای دولت آن حسن روزافزون کنم","ای ماهی که به زیبایی و مقام بلند خود شناخته می‌شوی، از حافظ یاد کن تا دعای خیر و سعادت آن زیبایی روزافزون را برای من انجام دهم."],[349,"به عزم توبه سحر گفتم استخاره کنم","بهار توبه‌شکن می‌رسد چه چاره کنم؟","به قصد توبه در سحرگاه به خودم گفتم که استخاره (از خدا راهنمایی خواستن) کنم؛ اما با وجود این، بهار توبه‌شکن (زمانی که فرصت مناسبی برای گنه‌کاران فراهم می‌شود) در حال نزدیک شدن است و من نمی‌دانم چه راهی در پیش بگیرم."],[349,"سخن درست بگویم نمی‌توانم دید","که می خورند حریفان و من نظاره کنم","نمی‌توانم به درستی صحبت کنم، چرا که حریفان در حال نوشیدن شراب هستند و من فقط می‌توانم آن‌ها را تماشا کنم."],[349,"چو غنچه با لب خندان به یاد مجلس شاه","پیاله گیرم و از شوق، جامه پاره کنم","به‌خاطر یادآوری آن مجلس خوش که در آن شادی و سرور بود، مانند غنچه با لب خندان، شراب می‌نوشم و از شوق به حدی هیجان‌زده می‌شوم که جامه‌ام را پاره می‌کنم."],[349,"به دور لاله دماغ مرا علاج کنید","گر از میانه بزم طرب کناره کنم","به دور لاله، یعنی به دور گل لاله، برای من که در غم و اندوه هستم، دارویی فراهم کنید؛ زیرا اگر از شادی و سرور میهمانی دور شوم و جدا شوم، به درد و ناراحتی دچار می‌شوم."],[349,"ز روی دوست مرا چون گل مراد شکفت","حواله سر دشمن به سنگ خاره کنم","چون روی محبوبم مانند گلی است که به آرزوی خود رسیده، به انتقام از دشمن، سر او را با سنگ خارا (سخت و تیز) می‌زنم."],[349,"گدای میکده‌ام، لیک وقت مستی بین","که ناز بر فلک و حکم بر ستاره کنم","من گدای میکده هستم، اما وقتی مست می‌شوم، می‌بینم که می‌توانم بر آسمان ناز کنم و بر ستاره‌ها حاکم شوم."],[349,"مرا که نیست ره و رسم لقمه‌پرهیزی","چرا ملامت رند شراب‌خواره کنم","من خود را که قواعد مراقبت از خود را نمی‌دانم، چرا باید سرزنش کنم کسی را که به‌خاطر شوقی که به می و شراب دارد، می‌نوشد؟"],[349,"به تخت گل بنشانم بتی چو سلطانی","ز سنبل و سمنش، ساز طوق و یاره کنم","به روی تختی از گل، بت محبوبی را چون یک پادشاه می‌نشینم و از گل‌های سنبل و سمن آن برای او تزئیناتی چون طوق و زینت‌آلات درست می‌کنم."],[349,"ز باده خوردن پنهان ملول شد حافظ","به بانگ بربط و نی، رازش آشکاره کنم","حافظ از نوشیدن پنهانی شراب خسته و بی‌حوصله شده است و با صدای ساز و نی می‌خواهد رازش را فاش کند و آن را از درون خود بیرون بیاورد."],[350,"حاشا که من به موسم گل ترک می کنم","من لاف عقل می‌زنم، این کار کی کنم","هیچ‌گاه در فصل گل، از می نوشیدن دست نخواهم کشید. من فقط به ناز و فخر، از عقل سخن می‌گویم، اما این کار را هرگز انجام نخواهم داد."],[350,"مطرب کجاست تا همه محصول زهد و علم","در کار چنگ و بربط و آواز نی کنم","معشوق و باده را طلب می‌کند و می‌گوید کجا است نوازنده تا من همه دانسته‌ها و عبادت‌هایم را فراموش کرده و به لذت آواز و موسیقی بپردازم."],[350,"از قیل و قال مدرسه حالی دلم گرفت","یک چند نیز خدمت معشوق و می کنم","از حرف و بحث‌های مدرسه خسته شدم و حالا می‌خواهم مدتی به معشوق و نوشیدن شراب بپردازم."],[350,"کی بود در زمانه وفا؟ جام می بیار","تا من حکایت جم و کاووس کی کنم","چنین وفایی در زمانه وجود ندارد، پس به من جام شراب بده تا داستان جم (پادشاه اساطیری ایران) و کاووس (پادشاه دیگر) را روایت کنم."],[350,"از نامه سیاه نترسم که روز حشر","با فیض لطف او صد از این نامه طی کنم","من از نامه سیاه (کارهای بد و گناهانم) نمی‌ترسم چون در روز قیامت با رحمت و لطف او می‌توانم از پس آن برآیم و تمام گناهانم را جبران کنم."],[350,"کو پیک صبح؟ تا گله‌های شب فراق","با آن خجسته طالع فرخنده پی کنم","کجاست پیک صبح؟ تا بتوانم ناله‌های شب‌فراق را با خوشبینی و سرنوشت نیکوی صبحگاهی پایان دهم."],[350,"این جان عاریت که به حافظ سپرد دوست","روزی رخش ببینم و تسلیم وی کنم","من این جان امانت را که دوست به من سپرده است، روزی خوشبختی رویش را می‌بینم و به او تسلیم می‌شوم."],[351,"روزگاری شد که در میخانه خدمت می‌کنم","در لباس فقر کار اهل دولت می‌کنم","مدتی است که در میخانه به عنوان خدمتکار فعالیت می‌کنم و در حالی که در لباس فقر هستم، کارهای ثروتمندان را انجام می‌دهم."],[351,"تا کی اندر دام وصل آرم تذروی خوش‌خرام","در کمینم و انتظار وقت فرصت می‌کنم","مدت زیادی است که در دام عشق و وصال هستم و به عشق زیبا و دلربا دل بسته‌ام، اما همچنان در کمین و انتظار فرصت مناسبی برای رسیدن به او هستم."],[351,"واعظ ما بوی حق نشنید بشنو کاین سخن","در حضورش نیز می‌گویم نه غیبت می‌کنم","واعظ ما که باید از حقیقت و حقایق سخن بگوید، بوی حق را درک نکرده است. البته اینجا با او در حال صحبت هستم و به او غیبت نمی‌کنم."],[351,"با صبا افتان و خیزان می‌روم تا کوی دوست","و از رفیقان ره استمداد همت می‌کنم","با نسیم صبحگاهی، افتان و خیزان به سوی کوی دوست می‌روم و از دوستانم کمک و حمایت می‌طلبم."],[351,"خاک کویت زحمت ما برنتابد بیش از این","لطف‌ها کردی بتا، تخفیف زحمت می‌کنم","خاک کوی تو دیگر نمی‌تواند زحمت ما را تحمل کند. ای بت، من بیشتر از این از لطف‌هایت انتظار ندارم و دیگر نمی‌خواهم زحمت تو را افزایش دهم."],[351,"زلف دلبر دام راه و غمزه‌اش تیر بلاست","یاد دار ای دل که چندینت نصیحت می‌کنم","زلف‌های معشوق مانند دام‌هایی هستند که انسان را به خود جذب می‌کنند و نگاه‌های او نیز مانند تیرهایی سمی‌اند که موجب درد و رنج می‌شوند. ای دل، به خاطر بسپار که من مدام تو را نصیحت می‌کنم."],[351,"دیده بدبین بپوشان ای کریم عیب‌پوش","زین دلیری‌ها که من در کنج خلوت می‌کنم","ای کریم که عیب‌ها را می‌پوشانی، چشمان بدبین را از من بپوشان؛ زیرا به خاطر این جرات‌ها و شجاعت‌هایی که من در تنهایی و خلوت انجام می‌دهم."],[351,"حافظم در مجلسی دردی‌کشم در محفلی","بنگر این شوخی که چون با خلق، صنعت می‌کنم","حافظ در مجالس شراب‌خوری حاضر می‌شود و وقتی با دیگران صحبت می‌کند، طوری رفتار می‌کند که به نظر می‌رسد شوخی و بازیگوشی می‌کند، در حالی که این رفتار بخشی از هنر او و نشان‌دهنده مهارتش در ساختن روابط است."],[352,"من ترک عشق شاهد و ساغر نمی‌کنم","صد بار توبه کردم و دیگر نمی‌کنم","مـن از عشق ومحبّت، ازدوستی و مهرورزی، ازعیش وعشرت وشادمانی، ازشاهدبازی ونظربازی، ازشادزیستن و شادکردن دلها، از پایکوبی و دست‌افشانی، دست بر نمی‌دارم. صـدبـارپ یش ازاین به توصیه‌ی نصیحتگوی، از شرابخواری و عاشقی تـوبه کرده‌ام ونتیجه ی بدگرفته‌ام یعنی خود را بیهوده ازشادکامی و محبت و عشقبازی محروم کردم. توبه‌ها جزپشیمانی حاصلی نداشته به این نتیجه رسیدم که دیگر توبه نکنم.«از حاشیه»"],[352,"باغ بهشت و سایه طوبی و قصر و حور","با خاک کوی دوست برابر نمی‌کنم","باغ بهشت، سایه درخت طوبی، قصر و حوریان بهشتی را با خاک کوی دوست که مایه عشق و محبت است، عوض نمی‌کنم و چنین نعمت‌هایی را بر آن ترجیح نمی‌دهم."],[352,"تلقین و درس اهل نظر یک اشارت است","گفتم کنایتی و مکرر نمی‌کنم","منظور شاعر این است که نصیحت و آموزش اهل علم تنها یک کنایه و اشاره است، و او بر این نکته تأکید دارد که تکرار نکرده و به آن در موردی خاص اشاره می‌کند."],[352,"هرگز نمی‌شود ز سر خود خبر مرا","تا در میان میکده سر بر نمی‌کنم","هرگز نمی‌توانم از حال و وضعیت خودم آگاه شوم تا وقتی که در میکده و در حال نوشیدن شراب نباشم."],[352,"ناصح به طعن گفت که «رو ترک عشق کن»","محتاج جنگ نیست برادر، نمی‌کنم","ناصح به من گفت که از عشق دور شو، ولی من نیازی به دعوا و جدل ندارم و این کار را نخواهم کرد."],[352,"این تقوی‌ام تمام، که با شاهدان شهر","ناز و کرشمه بر سر منبر نمی‌کنم","من ادعای تقوای کامل دارم، اما در برابر زیبایی‌های شهر، به راحتی نمی‌توانم از نمایش عشق و محبت خود صرف‌نظر کنم."],[352,"حافظ! جناب پیر مغان جای دولت است","من ترک خاک‌بوسی این در نمی‌کنم","حافظ، ای دوست! مقام و منزلت بزرگ پیر مغان (کسی که در عرفان جایگاه والایی دارد) در نظر من بسیار باارزش است و من هرگز از خاک‌ساری و احترام به این مقام دست نمی‌کشم."],[353,"به مژگان سیه کردی هزاران رخنه در دینم","بیا کز چشم بیمارت هزاران درد برچینم","با مژه­های سیاه رنگ خود، دین و ایمانم را ویران ساختی، به پیشم بیا تا هزاران درد و بلا را از چشمان خمارت دور سازم."],[353,"الا ای همنشین دل که یارانت برفت از یاد","مرا روزی مباد آن دم که بی یاد تو بنشینم","ای همدم دل و جانم که یاران و عاشقانت را فراموش کرده­‌ای، امیدوارم آن روزی که لحظه‌­ای از یادت غافل شوم هرگز نیاید."],[353,"جهان پیر است و بی‌بنیاد از این فرهادکش فریاد","که کرد افسون و نیرنگش ملول از جان شیرینم","دنیا هم کهن و سال­خورده است و هم بی‌­اساس و بی‌­بنیاد، فغان و فریاد که به راحتی عاشقان دلداده‌­­ای چون فرهاد را می‌­کشد، این دنیا با حیله و نیرنگ­‌هایش چنان کاری کرده است که من حتی از جان شیرین خودم نیز دل­‌زده و خسته شده­‌ام."],[353,"ز تاب آتش دوری، شدم غرق عرق چون گل","بیار ای باد شبگیری نسیمی زان عرقچینم","دوری از یار چونان آتشی است که از شدت سوز و گداز آن همچون گل غرق عرق شده‌­ام، ای نسیم سحرگاهی بوی خوشی از آن زلف معطر یار بیاور."],[353,"جهان فانی و باقی فدای شاهد و ساقی","که سلطانیّ عالم را طفیل عشق می‌بینم","هر دو عالم، هم فدای معشوق زیبارو و هم فدای ساقی باد؛ چرا که می­‌بینم رسیدن به سروری جهان، در گرو و وابسته به عشق است."],[353,"اگر بر جای من غیری گزیند دوست، حاکم اوست","حرامم باد اگر من جان، به جای دوست بگزینم","اگر محبوب به جای من کس دیگری را انتخاب کند، صاحب اختیار است و حق دارد، اما اگر من به جای عشق به محبوب، جان خودم را برگزینم، حرامم باد."],[353,"صباح الخیر زد بلبل، کجایی ساقیا؟ برخیز","که غوغا می‌کند در سر خیال خواب دوشینم","بلبل، صبح به خیر را به زبان نغمه‌­خوانی سرود، ای ساقی، کجایی؟ برخیز (جام شرابی بیاور) که تصویر و خیالی که دیشب در خواب دیده‌­ام، در سرم غوغا به پا کرده است."],[353,"شب رحلت هم از بستر روم در قصر حورالعین","اگر در وقت جان دادن تو باشی شمع بالینم","اگر در وقت مرگ و در هنگام جان دادن تو روشنی‌­بخش بسترم باشی، همان شب مرگ یک‌­راست از بستر مرگ به قصر حوران بهشتی خواهم رفت."],[353,"حدیث آرزومندی که در این نامه ثبت افتاد","همانا بی‌غلط باشد، که حافظ داد تلقینم","داستان شور و شوق وصال که در این نوشتار ثبت کرده­‌ام یقین بدانید که درست و بی­‌غلط است، چرا که حافظ(ایهام) آن را به من آموخته است.(ایهام: حافظ؛ ۱. شخص حافظ، ۲. نامی است از نام­‌های خداوند.)"],[354,"حالیا مصلحت وقت در آن می‌بینم","که کشم رخت به میخانه و خوش بنشینم","در حال حاضر، به نفع من است که به میخانه بروم و در آنجا به خوش‌گذرانی بپردازم."],[354,"جام می گیرم و از اهل ریا دور شوم","یعنی از اهل جهان پاکدلی بگزینم","من مشغول نوشیدن شراب می‌شوم و از افرادی که ریاکارند دور می‌زنم، یعنی از میان مردم، دوستانی را انتخاب می‌کنم که دلشان پاک و صمیمی باشند."],[354,"جز صراحی و کتابم نبود یار و ندیم","تا حریفان دغا را به جهان کم بینم","تنها چیزی که در کنارم هست، یک شیشه شراب و یک کتاب است و هیچ یار و رفیقی ندارم تا دوستان فریبکار را در این دنیا کمتر ببینم."],[354,"سر به آزادگی از خلق برآرم چون سرو","گر دهد دست که دامن ز جهان درچینم","می‌خواهم سرم را به خاطر آزادگی و فارغ بودن از قید و بندهای دنیایی بالا ببرم و مانند درخت سروی با وقار باشم، اگر خدایی مهربان و یاری وجود داشته باشد که اجازه دهد از دنیا جدا شده و هرچه را که می‌خواهم، از خود دور کنم."],[354,"بس که در خرقه آلوده زدم لاف صلاح","شرمسار از رخ ساقی و می رنگینم","به خاطر اینکه خیلی در جامه ناپاک خود به ریا و فخر و نازش پرداخته‌ام، از چهره ساقی و شراب رنگینم خجالت می‌کشم."],[354,"سینه تنگ من و بار غم او، هیهات","مرد این بار گران نیست دل مسکینم","دل تنگ و پر از غم من، بار سنگین عشق او را نمی‌تواند تحمل کند؛ با این حال، دل رنجیده و بیچاره‌ام به هیچ وجه قدرت این بار سنگین را ندارد."],[354,"من اگر رند خراباتم و گر زاهد شهر","این متاعم که همی‌بینی و کمتر زینم","من اگر کسی هستم که در میخانه‌ها (خرابات) زندگی می‌کنم و رند (شخص عیاش و بی‌قید) هستم، یا اگر هم مانند زاهدان (مردان دین‌دار) به عبادت مشغول باشم، این تنها بخاطر خوشگذرانی و لذت بردن از می (شراب) است که می‌بینی و در حقیقت من کمتر از آنچه که به نظر می‌رسم، می‌باشم."],[354,"بنده آصف عهدم دلم از راه مبر","که اگر دم زنم از چرخ بخواهد کینم","من بنده آصف، که نماینده عهد و پیمان است، هستم و از تو می‌خواهم دل مرا از حق و حقوق خود دور نکن. زیرا اگر روزی در تنهایی صحبت از زمانه کنم، ممکن است به خاطر این درد و رنج، دشمنی و کینه در دلم ایجاد شود."],[354,"بر دلم گرد ستم‌هاست خدایا مپسند","که مکدر شود آیینه مهرآیینم","دلم پر از ظلم و ستم است، ای خدا، نگذار که این وضعیت باعث ناراحتی و کدورت در عشق و محبت من شود."],[355,"گرم از دست برخیزد که با دلدار بنشینم","ز جام وصل می‌ نوشم، ز باغ عیش گل چینم","اگر روزی از دستم برآید و بتوانم که با یار بنشینم؛ مست وصالش می‌شوم و از گلزار زیبای لذت، گل خواهم چید."],[355,"شراب تلخ صوفی سوز، بنیادم بخواهد برد","لبم بر لب نه ای ساقی و بستان جان شیرینم","شراب تلخ دین‌بر‌باد‌ده، بنیادم را خواهد برد؛ لب را بر لبم بنه ای ساقی و جانم را بستان."],[355,"مگر دیوانه خواهم شد در این سودا که شب تا روز","سخن با ماه می‌گویم، پری در خواب می‌بینم","شاید از این سودا و خیال دیوانه‌شوم زیرا شب و روز با ماه هم‌سخن هستم و فرشته در خواب می‌بینم!"],[355,"لبت شکّر به مستان داد و چشمت می به میخواران","منم کز غایت حرمان نه با آنم نه با اینم","لب تو نقل و شیرینی به مستان داد و چشمت باده به می‌خواران؛ منم که از نهایت بی‌بهرگی و ناامیدی نه به آن می‌رسم نه به این."],[355,"چو هر خاکی که باد آورد، فیضی برد از انعامت","ز حال بنده یاد آور که خدمتگار دیرینم","وقتی‌که هر کمتر خاکی از تو فیض و بهره‌ای برد؛ از من نیز یادی کن که خدمتکار و ارادتمند دیرین هستم."],[355,"نه هر کو نقش نظمی زد کلامش دلپذیر افتد","تذرو طرفه من گیرم که چالاک است شاهینم","نه هرکس که نظمی سرود کلامش دلپذیر و دلنشین شد؛ تذرو عالی و شگرف را من شکار می‌کنم که شاهینی تیزپرواز هستم. (تذرو نام پرنده‌ای است)"],[355,"اگر باور نمی‌داری، رو از صورتگر چین پرس","که مانی نسخه می‌خواهد ز نوک کلک مشکینم","اگر باور نمی‌کنی که در نقش و نقاشی همچون مانی هنرمندم، برو از صورتگران و نقاشان زبده چین بپرس."],[355,"وفاداری و حق گویی نه کار هر کسی باشد","غلام آصف ثانی جلال الحق و الدینم","وفاداری و راستگویی کار هرکسی نیست؛ بنده آصف ثانی جلال الحق و الدینم"],[355,"رموز مستی و رندی ز من بشنو نه از واعظ","که با جام و قدح هر دم ندیم ماه و پروینم","رموز و اسرار مستی و رندی را از من بشنو نه از واعظ و شیخ؛ زیرا که هردم‌، جام باده به‌دست‌، هم‌نشین ماه و پروین هستم."],[356,"در خرابات مغان نور خدا می‌بینم","این عجب بین که چه نوری ز کجا می‌بینم","من در پرستشگاه زرتشتیان نور خدا را می بینم و بسیار برایم شگفت‌انگیز است که این نور از کجا می آید؟"],[356,"جلوه بر من مفروش ای ملک‌الحاج که تو","خانه می‌بینی و من خانه‌ خدا می‌بینم","ای بزرگان، این زیبایی خود را به من نشان ندهید، زیرا تو فقط خانه‌ای معمولی را می‌بینی، در حالی که من وجود خدا را در آن خانه می‌بینم."],[356,"خواهم از زلف بتان نافه‌گشایی کردن","فکر دور است همانا که خطا می‌بینم","می‌خواهم با موهای زیبا و دلربای زنان عشق بازی کنم، اما می‌دانم که چنین تفکری بیهوده است چرا که در این امر دچار اشتباه می‌شوم."],[356,"سوز دل، اشک روان، آه سحر، ناله شب","این همه از نظر لطف شما می‌بینم","آتش دل، اشک‌های جاری، آه‌های صبحگاهی و ناله‌های شبانه؛ همه این‌ها را به خاطر لطف شما درک می‌کنم."],[356,"هر دم از روی تو نقشی زندم راه خیال","با که گویم که در این پرده چه‌ها می‌بینم","هر لحظه به خاطر چهره زیبای تو تصویری می‌سازم و نمی‌دانم باید به که بگویم در این تصویر چه چیزهایی می‌بینم."],[356,"کس ندیده‌ست ز مشک ختن و نافه چین","آنچه من هر سحر از باد صبا می‌بینم","هیچ‌کس بوی خوش مشک ختن و نافه چین را مانند آنچه من هر صبح زود از وزش باد صبا می‌چشم، تجربه نکرده است."],[356,"دوستان عیب نظربازی حافظ مکنید","که من او را ز محبّان شما می‌بینم","دوستان، عیب‌جویی از عشق بازی حافظ نکنید، زیرا من او را به عنوان یکی از دوستداران شما می‌شناسم."],[357,"غم زمانه که هیچش کران نمی‌بینم","دواش جز می چون ارغوان نمی‌بینم",":غم و اندوه روزگار انتها ندارد دوای آن جز نوشیدن می، مانند رنگ ارغوانی نیست"],[357,"به ترک خدمت پیر مغان نخواهم گفت","چرا که مصلحت خود در آن نمی‌بینم","من به ترک خدمت پیر مغان (عالم عارف) نمی‌توانم اعتراف کنم، زیرا در این کار به نفع خودم نمی‌دانم."],[357,"ز آفتاب قدح ارتفاع عیش بگیر","چرا که طالع وقت آن چنان نمی‌بینم","از لطافت و روشنایی شراب لذت ببر، زیرا اوضاع و احوال زمانه به گونه‌ای است که نمی‌توانم امیدی به خوشی بیشتر داشته باشم."],[357,"نشان اهل خدا عاشقیست، با خود دار","که در مشایخ شهر این نشان نمی‌بینم","عاشقی نشانه واقعی اهل خداوند است، اما باید مراقب باشی چون در بزرگ‌ترهای این شهر، چنین نشانه‌ای را نمی‌بینم."],[357,"بدین دو دیده حیران من هزار افسوس","که با دو آینه رویش عیان نمی‌بینم","به خاطر دو چشمی که حیران و شگفت‌زده هستند، هزار بار افسوس می‌خورم که نمی‌توانم چهره‌اش را با دو آینه واضح ببینم."],[357,"قد تو تا بشد از جویبار دیده من","به جای سرو جز آب روان نمی‌بینم","قد تو وقتی از جویبار اشک‌هایم بگذرد، دیگر غیر از آب روان چیزی نمی‌بینم، یعنی زیبایی و قامت تو برای من آن‌قدر برجسته و بزرگ است که هیچ چیز دیگری به جز آن احساس نمی‌شود."],[357,"در این خمار کسم جرعه‌ای نمی‌بخشد","ببین که اهل دلی در میان نمی‌بینم","در این حالت مستی و خماری که به آن دچارم، هیچ‌کس به من شرابی نمی‌دهد، زیرا نمی‌توانم کسی با دل و محبت واقعی را در میان خود ببینم."],[357,"نشان موی میانش که دل در او بستم","ز من مپرس که خود در میان نمی‌بینم","موی میان استعاره از کمر باریک یار داره که از باریکی چون مو می‌باشد ، و آنچنان دلبسته‌ی آن شدم که دیگر خود را نمیبینم"],[357,"من و سفینه حافظ که جز در این دریا","بضاعت سخن درفشان نمی‌بینم","من و سفینه حافظ، که فقط در این دریا می‌توانم به زیبایی سخن بگویم، در واقع توانمندی و زیبایی کلامم محدود به همین جاست."],[358,"خرّم آن روز کز این منزل ویران بروم","راحت جان طلبم و از پی جانان بروم","خوشا روزی که این دنیای وانفسا را ترک کنم، جانم آسوده شود و به سوی معبودم بروم"],[358,"گر چه دانم که به جایی نبرد راه غریب","من به بوی سر آن زلف پریشان بروم","هر چند می‌دانم که در راه ناشناخته مقصدی مشخص نیست، من به دنبال نشانه خوشایند و دلربای معشوق میروم"],[358,"دلم از وحشت زندان سکندر بگرفت","رخت بربندم و تا ملک سلیمان بروم","دلم از این دنیا گرفته است می خواهم بارم را ببندم از این دنیا به آن دنیا سفر کنم"],[358,"چون صبا با تن بیمار و دل بی‌طاقت","به هواداری آن سرو خرامان بروم","با وجود اینکه تنم بیمار و دلم طاقت ندارد، اما به خاطر عشق و محبت به آن دختر زیبا و باوقار (سرو خرامان) می‌روم."],[358,"در ره او چو قلم گر به سرم باید رفت","با دل زخم‌کش و دیده گریان بروم","اگر در راه معشوق یا حق قرار است سر و جانم قربانی شود مثل قلم که روی کاغذ می‌رود و نقش می‌زند اما خود را فدا میکند، من هم آماده‌ام که مسیر را طی کنم با دلی پر از درد و زخم و چشمی اشکبار"],[358,"نذر کردم گر از این غم به درآیم روزی","تا در میکده شادان و غزل‌خوان بروم","نذر کرده‌ام اگر روزی از این غم رهایی یابم، با خوشحالی و سرودخوانی به میکده بروم."],[358,"به هواداری او ذرّه‌صفت، رقص‌کنان","تا لب چشمه خورشید درخشان بروم","برای محبت و دوستی او، همچون ذره‌ای رقصان و شاداب به سوی چشمه نورانی خورشید می‌روم."],[358,"تازیان را غم احوال گران‌باران نیست","پارسایان مددی تا خوش و آسان بروم","کسانی که با سرعت و با تاخت‌و‌تاز سفر میکنند ، حال و غم افرادی را که بند مکانی هستند را درک نمی‌کنند . ای انسان‌های درست‌کار کمکی بدهید تا من که به این مکان دلبستگی دارم و بند هستم به خوبی و آسان از اینجا بروم"],[358,"ور چو حافظ ز بیابان نبرم ره بیرون","همره کوکبه آصف دوران بروم","اگر به مانند حافظ از بیابان در نیایم، می‌توانم همراه با ستاره آصف دوران (آصف بن برخیا، وزیر سلیمان) به جایی بروم."],[359,"گر از این منزل ویران به سوی خانه روم","دگر آنجا که روم عاقل و فرزانه روم","اگر از این محل ویران به سمت خانه‌ام بروم، در آنجا دیگر مانند گذشته احمق و نادان نخواهم بود و عاقل و خردمند خواهم شد."],[359,"زین سفر گر به سلامت به وطن باز رسم","نذر کردم که هم از راه به میخانه روم","اگر از این سفر به سلامت به وطن برگردم، نذر کرده‌ام که در راه به میخانه بروم."],[359,"تا بگویم که چه کشفم شد از این سیر و سلوک","به در صومعه با بربط و پیمانه روم","می‌خواهم بگویم که از این سفر و سیر در عرفان چه تجربیاتی به دست آوردم، لذا به در صومعه می‌روم و با ساز (بربط) و جام شراب (پیمانه) می‌نشینم."],[359,"آشنایان ره عشق گرم خون بخورند","ناکسم گر به شکایت سوی بیگانه روم","اگر آشنایان در راه عشق، من را به عذاب و رنج بسیار بیندازند، برای من اهمیت ندارد و حتی اگر بخواهم به نزد بیگانه‌ای بروم و شکایت کنم، این کار در شأن من نیست."],[359,"بعد از این دست من و زلف چو زنجیر نگار","چند و چند از پی کام دل دیوانه روم","از این پس، دست من و موی زیبای محبوب همچون زنجیری که بر گردن است، به هم پیوسته خواهد بود و بارها و بارها برای رسیدن به خواسته‌های دل دیوانه خود می‌روم."],[359,"گر ببینم خم ابروی چو محرابش باز","سجده شکر کنم و از پی شکرانه روم","اگر ابروی خمیده‌اش را که مانند محراب است ببینم، به خاطر شکرگزاری پیش او سجده می‌کنم و بعد از آن به سوی او می‌روم تا قدردانی‌ام را نشان دهم."],[359,"خرّم آن دم که چو حافظ به تولّای وزیر","سرخوش از میکده با دوست به کاشانه روم","چه لحظه‌ای خوش است زمانی که مانند حافظ، با حمایت وزیر، شاد و مست از میکده، همراه با یار به خانه بازگردم."],[360,"آن که پامال جفا کرد چو خاک راهم","خاک می‌بوسم و عذر قدمش می‌خواهم","کسی که به من ظلم کرده و مرا مثل خاک پای خود نادیده گرفته، من خاک پای او را می‌بوسم و برای بی‌احترامی‌اش از او عذرخواهی می‌کنم."],[360,"من نه آنم که ز جور تو بنالم، حاشا","بنده معتقد و چاکر دولتخواهم","من از ظلم و ستم تو شکایت نمی‌کنم و هرگز چنین کاری نخواهم کرد، زیرا من یک بنده‌ی وفادار و مطیع در برابر مقام و دولت تو هستم."],[360,"بسته‌ام در خم گیسوی تو امّید دراز","آن مبادا که کند دست طلب کوتاهم","من به خاطر گیسوی تو در عشق و انتظار به‌سر می‌برم و امیدوارم، ولی نگرانم که مبادا در این جست‌وجو، قدرت و تلاشم کم شود و به مقصد نرسم."],[360,"ذرّه خاکم و در کوی توام جای خوش است","ترسم ای دوست که بادی ببرد ناگاهم","من خاکی کوچک هستم و در کوی تو خوشحالم، اما نگرانم که مبادا بادی من را ناگهانی از این مکان دور کند."],[360,"پیر میخانه سحر جام جهان‌بینم داد","و اندر آن آینه از حسن تو کرد آگاهم","پیر میخانه در سحر به من جامی داد که جهان را به من نشان می‌دهد و در آن جام، در آینه‌اش، من را از زیبایی تو آگاه ساخت."],[360,"صوفی صومعه عالم قدسم لیکن","حالیا دیر مغان است حوالتگاهم","هرچند من یک صوفی و زاهدی در دنیای پاک و مقدس هستم، اما اکنون در میخانه‌ عارفان قرار دارم و به آنجا روی آورده‌ام."],[360,"با من راه‌نشین خیز و سوی میکده آی","تا در آن حلقه ببینی که چه صاحب جاهم","با من که به راه نشسته‌ام، برخیز و به میکده برو؛ تا در آنجا ببینی که چه کسی بر فراز جایگاه خود نشسته است."],[360,"مست بگذشتی و از حافظت اندیشه نبود","آه اگر دامن حسن تو بگیرد آهم","تو بی‌خبر و مست از کنار من گذشتی و حتی به یاد من هم نبود، وای اگر دامن زیبایی‌ات به من برسد، به شدت ناله و آه می‌زنم."],[360,"خوشم آمد که سحر خسرو خاور می‌گفت","با همه پادشهی بنده تورانشاهم","خوشحال شدم که سحر، خسرو خاور (که به معنای سهراب یا یکی از پادشاهان بزرگ و معروف است) می‌گفت که من با وجود همه سلطنت‌ها، بنده توران (سرزمین توران یا سرزمین دشمنان) هستم."],[361,"دیدار شد میسّر و بوس و کنار هم","از بخت شکر دارم و از روزگار هم","دیدار معشوق برایم آسان و ممکن شده و در کنار او بوسه و نوازش وجود دارد. از شکر نعمت این خوشبختی به خاطر شانس و زندگی‌ام خیلی سپاسگزارم."],[361,"زاهد برو که طالع اگر طالع من است","جامم به دست باشد و زلف نگار هم","ای زاهد، تو راهت را بگیر و برو؛ چراکه اگر سرنوشت من خوب باشد، در این صورت همواره جام شراب در دست من خواهد بود و زلف زیبای محبوب نیز با من خواهد بود."],[361,"ما عیب کس به مستی و رندی نمی‌کنیم","لعل بتان خوش است و می خوشگوار هم","ما بابت مستی و رندی به کسی عیب نمیگیریم چرا که می دانیم که بوسه از لب زیبا رویان و نیز می گوارا خوشایند است"],[361,"ای دل بشارتی دهمت محتسب نماند","و از می جهان پر است و بت میگسار هم","ای دل، به تو خبری خوش می‌دهم که دیگر محتسبی در کار نیست و امروز دنیا از شراب پر شده و بتی که می‌نوشد نیز در اینجا وجود دارد."],[361,"خاطر به دست تفرقه دادن نه زیرکیست","مجموعه‌ای بخواه و صراحی بیار هم","به‌هم زدن خیال و احساس، عقل و هوش نیست، بلکه باید تمامی وجودت را در عشق و شادی قرار دهی و به سراغ شراب و لذت بروی."],[361,"بر خاکیان عشق فشان جرعه لبش","تا خاک لعل‌گون شود و مشکبار هم","از عشق و محبت او بر خاکی‌ها جرعه‌ای بریز تا آن خاک به رنگ لعل (قرمز) درآید و خوشبو شود."],[361,"آن شد که چشم بد نگران بودی از کمین","خصم از میان برفت و سرشک از کنار هم","چشم بد که به تو حسادت داشت و از دور در کمین بود، دیگر از بین رفت و اشک‌های حسرت هم از کنارت رخت بربست."],[361,"چون کائنات جمله به بوی تو زنده‌اند","ای آفتاب سایه ز ما برمدار هم","تمامی موجودات به خاطر بوی تو زنده‌اند، ای آفتاب، سایه‌ات را از ما دور مکن."],[361,"چون آب روی لاله و گل، فیض حسن توست","ای ابر لطف بر من خاکی ببار هم","حس زیبایی و نعمت‌های تو مانند آبی است که بر لاله و گل می‌بارد، پس ای ابر لطف، بر من زمینی نیز رحمت و فیض نازل کن."],[361,"حافظ اسیر زلف تو شد از خدا بترس","و از انتصاف آصف جم اقتدار هم","حافظ به خاطر عشقش به معشوق، به زنجیر زلف‌های او درآمده است و به او هشدار می‌دهد که از خدا بترسد و از قدرت یک فرد دیگر به نام آصف بن باجا (که توانمند و عادل بوده) عبرت بگیرد."],[361,"برهان ملک و دین که ز دست وزارتش","ایام کان یمین شد و دریا یسار هم","مسلما او (آصف جم) دلیلی روشن و غیرقابل‌انکار است برای حفظ سلطنت و دین که به واسطه وزارتش، روزها در سمت راست و دریا در سمت چپ قرار گرفتند."],[361,"بر یاد رای انور او آسمان به صبح","جان می‌کند فدا و کواکب نثار هم","آسمان به خاطر تدبیر نیک و فرخنده او، صبح را فدیه می‌کند و ستاره‌ها را به او هدیه می‌دهد."],[361,"گوی زمین ربوده چوگان عدل اوست","وین برکشیده گنبد نیلی حصار هم","زمین در چنگال و ضربه گوی بازی چوگان عدل اوست و این گنبد آبی، مانند دژی برای محافظت از آن عدالت است."],[361,"عزم سبک عنان تو در جنبش آورد","این پایدار مرکز عالی مدار هم","عزم و اراده تو که سبک و آزاد است، این مرکز استوار و مهم را در حرکت آورده است."],[361,"تا از نتیجه فلک و طور دور اوست","تبدیل ماه و سال و خزان و بهار هم","نتیجه برج آسمان و کوه طور که در آن حضرت موسی به پیامبری منصوب شد، موجب تغییراتی در ماه و سال و فصول می‌شود؛ یعنی هر جا که او حضور داشته باشد، این تحولات به وقوع می‌پیوندد."],[361,"خالی مباد کاخ جلالش ز سروران","و از ساقیان سروقد گلعذار هم","کاخ جلال او همیشه باید پر از شادمانی و خوشی باشد و از ساقی‌هایی که می می‌ریزند و زیبا و خوش‌بو هستند خالی نماند."],[362,"دردم از یار است و درمان نیز هم","دل فدای او شد و جان نیز هم","دردی که دارم ناشی از عشق یارم است و برای درمان این درد نیز به او وابسته‌ام. قلبم فدای او شده و جانم نیز به خاطر اوست."],[362,"این که می‌گویند آن خوشتر ز حسن","یار ما این دارد و آن نیز هم","می‌گویند این زیبایی‌هایی که در دنیا وجود دارد، همه مشابه یا بهتر از زیبایی‌های محبوب ماست، اما حقیقت این است که هیچ چیز به اندازه او جذابیت ندارد."],[362,"یاد باد آن کاو به قصد خون ما","عهد را بشکست و پیمان نیز هم","یاد باد کسی که به خاطر ما تصمیم به از بین بردن ما گرفت و عهد و پیمانی را که برای حفظ دوستی بسته بود، شکست."],[362,"دوستان در پرده می‌گویم سخن","گفته خواهد شد به دستان نیز هم","با دوستان به آرامی صحبت می‌کنم، زیرا این صحبت‌ها به گوش دیگران خواهد رسید و عاقبت بر افشا خواهد شد."],[362,"چون سر آمد دولت شب‌های وصل","بگذرد ایام هجران نیز هم","وقتی دوران خوش شب‌های وصال تمام شود، روزهای جدایی هم سپری خواهد شد."],[362,"هر دو عالم یک فروغ روی اوست","گفتمت پیدا و پنهان نیز هم","هر دو جهان، روشنایی و زیبایی‌شان از وجود اوست و من به تو گفتم که این حقیقت هم در آشکار و هم در نهان دیده می‌شود."],[362,"اعتمادی نیست بر کار جهان","بلکه بر گردون گردان نیز هم","به کارهای دنیا اعتماد نیست، بلکه حتی به حرکت گردش آسمان نیز نمی‌توان اطمینان داشت."],[362,"عاشق از قاضی نترسد می بیار","بلکه از یرغوی دیوان نیز هم","ساقی، شراب بیاور که عاشق نه تنها از قاضی نمی‌ترسد بلکه از بازپرس محکمه هم باکی ندارد"],[362,"محتسب داند که حافظ عاشق است","و آصف ملک سلیمان نیز هم","محتسب (نظارت‌گر بر شریعت) می‌داند که حافظ عاشق است و همچنین آصف، که وزیر سلیمان (پیامبر) و دانای بزرگ زمان خود بود، نیز این امر را درک می‌کند."],[363,"ما بی‌غمان مست دل از دست داده‌ایم","هم‌راز عشق و هم‌نفس جام باده‌ایم","ما سرمست و بی غم و بی خبریم از دنیا و پیرامون خویش جز عشق چیزی نمی دانیم و نداریم. تمام وقت با عشق و جام باده سر و کار داریم با جام شراب و عشق خلوت می کنیم درد دل می کنیم و رفیق و هم صحبت هم هستـیـم ."],[363,"بر ما بسی کمان ملامت کشیده‌اند","تا کار خود ز ابروی جانان گشاده‌ایم","ما سرزنش ها شنیده و نکوهش ها دیده ایم ما خون دلها خورده ایم از کمان ملامت سایرین ، تیر طعنه بسیار بردلمان نشسته و آزار ها کشیده ایم تا اینکه در نهایت از ابروان یار اشاره ی رضایت دریافته ایم و مشکلمان مرتفع گردیده است. دراینجا روشن می شود که چرا حافظ و یارانش در بیت پیشین خوش بودند و هیچ غمی نداشتند!."],[363,"ای گل تو دوش داغ صبوحی کشیده‌ای","ما آن شقایقیم که با داغ زاده‌ایم","ای گل سرخ ، این‌گونه به سرخی خویش مناز و جلوه گری مکن ، سرخی تو از اثرات شراب صبحگاهیست که خورده ای، تو هر روز صبح شراب می خوری و رخسارت سرخ می شود. اگر یک روز شراب نخوری معلوم می شود که صورتت چه رنگی دارد.! سرخی صورت باید ذاتی و جاودانی باشد ، همانگونه که ما شقایق ها با سرخ رویی زاده می شوییم و داغی صورت ما ذاتیست."],[363,"پیر مغان ز توبه ما گر ملول شد","گو باده صاف کن که به عذر ایستاده‌ایم","اگر راهنما و سرور ما از توبه و ترک باده خواری مـا اندوهناک گردیده، از طرف ما به او بـگـو که ماهم از کرده ی خویش پشیمانیم! بنابراین شراب را صاف و آماده کـن که ما آماده‌ی جبران و عـذر خواهی هستیم ."],[363,"کار از تو می‌رود، مددی ای دلیل راه","کانصاف می‌دهیم و ز راه اوفتاده‌ایم","ای راهنما وراه بلد اعتراف و اقرار می‌کنیم که ما گـمراه شده‌ایـم و کارمان گره خورده است! نجات و رستگاری ما فقط بازگشت بسوی تو و بسته به تـدبیر تو است ، به ما کمک کن تا راه درست را در پیش گیریم."],[363,"چون لاله، می مبین و قدح در میان کار","این داغ بین که بر دل خونین نهاده‌ایم","ظاهر بین مباش گرچه بنظر چنین می رسد که جام سرشار از شراب پیش رو دارم و روزگارم با نشاط و همه چیز وفق مراد است! نه من همانند لاله ظاهرا شاداب و چهره‌ی سرخ دارم. ما را با ظاهر لاله قیاس مکن و اگر مقایسه کردی ببین که همچون لاله داغی بر دل داریم . داغ فراق و داغ عشق است که ازازل بر دل مانهاده شده است."],[363,"گفتی که «حافظ این همه رنگ و خیال چیست؟!»","نقش غلط مبین که همان لوح ساده‌ایم","خطاب به منتقدین ومخالفان است.ای که می گویی ای حافـظ تو با این زبان شعری خیال انگیز دست به ریا و فریبکاری می زنی و اعمالت با گفته هایت همخوانی ندارد. نه اینگونه که تومی پنداری نیست وما مثل لوح بی رنگ هستیم. هیچ نقاب و ماسکی برصورت نمی زنم وآنچه که می گویم از سرچشمه ی باورها و اعتقاداتم برمی خیزد."],[364,"عمریست تا به راه غمت رو نهاده‌ایم","روی و ریای خلق به یک سو نهاده‌ایم","سال‌هاست به سوی غم تو رفته‌ایم و برای رضایت مردم، ظاهر را کنار گذاشته‌ایم."],[364,"طاق و رواق مدرسه و قال و قیل علم","در راه جام و ساقی مه رو نهاده‌ایم","قال و قیل و تمام ارکان تعلیم و آموزش را در راه رسیدن به وصال معشوق خود، فدا کرده و کنار گذاشته‌ایم."],[364,"هم جان بدان دو نرگس جادو سپرده‌ایم","هم دل بدان دو سنبل هندو نهاده‌ایم","جان خود را به آن دو چشم جادویی و دل خود را به آن گیسوان سیاه سپرده‌ایم."],[364,"عمری گذشت تا به امید اشارتی","چشمی بدان دو گوشه ابرو نهاده‌ایم","سال‌ها گذشته و ما به امید یک اشاره از تو، چشم‌مان را به آن دو گوشه ابروی جذابت دوخته‌ایم."],[364,"ما ملک عافیت نه به لشکر گرفته‌ایم","ما تخت سلطنت نه به بازو نهاده‌ایم","ما به کمک قدرت و نیروهای نظامی، به تسلط بر آرامش و خوشبختی نرسیده‌ایم و سلطنت و حکومت را با زور و شمشیر به دست نیاورده‌ایم."],[364,"تا سحر چشم یار چه بازی کند که باز","بنیاد بر کرشمه جادو نهاده‌ایم","ما منتظر هستیم ببینیم که زیبایی و جذابیت چشمان یار چه تاثیری بر ما می‌گذارد، چرا که ما همه چیز را بر اساس جذبه و فریب جادوی او بنا کرده‌ایم."],[364,"بی زلف سرکشش سر سودایی از ملال","همچون بنفشه بر سر زانو نهاده‌ایم","بدون موهای زیبا و فرّ سرکش او، ناشاد و افسرده‌ام و مانند گل بنفشه که سرش بر زانو افتاده، غم‌ناک و دلشکسته‌ام."],[364,"در گوشه امید چو نظّارگان ماه","چشم طلب بر آن خم ابرو نهاده‌ایم","در گوشه امید، مانند تماشاگرانی که در انتظار ماه هستند، چشم به آن خم ابروی معشوق دوخته‌ایم."],[364,"گفتی که حافظا دل سرگشته‌ات کجاست؟","در حلقه‌های آن خم گیسو نهاده‌ایم","حافظ به مخاطبش می‌گوید که تو از من می‌پرسی دل سرگشته‌ام کجاست؟ اما من آن را در حلقه‌های گیسوان معشوقه‌ام گذاشته‌ام."],[365,"ما بدین در نه پی حشمت و جاه آمده‌ایم","از بد حادثه این جا به پناه آمده‌ایم","ما به این در (در عشق) نیامده‌ایم تا به خاطر مقام و ثروت وارد شویم، بلکه به خاطر مشکلات و حوادثی که برایمان پیش آمده، به اینجا پناه آورده‌ایم."],[365,"رهرو منزل عشقیم و ز سرحدّ عدم","تا به اقلیم وجود این همه راه آمده‌ایم","ما مسافر مسیر عشق هستیم و از جایی که هیچ‌چیزی وجود ندارد، تا جایی که هستی وجود دارد، این همه راه را پیموده‌ایم."],[365,"سبزه خطّ تو دیدیم و ز بستان بهشت","به طلبکاری این مهرگیاه آمده‌ایم","دیدیم که خط ( مسیر ) و نیت تو ( خدا ) سبز است و خیر ، از باغ بهشت و بخاطر طلبی که از این گیاه مهر آفرین ( اشاره به گیاه هوم در اوستا ) داشتیم به این دنیا آمده ایم ."],[365,"با چنین گنج که شد خازن او روح امین","به گدایی به در خانه شاه آمده‌ایم","ما با چنین ثروتی که روح امین، که نگهبان رازها و امور مهم است، به عنوان خازن آن است، با حالت گدایی و درخواست به در خانه شاه آمده‌ایم."],[365,"لنگر حلم تو ای کشتی توفیق کجاست؟","که در این بحر کرم غرق گناه آمده‌ایم","ای کشتی توفیق، کجاست کشتی نجات و حلم تو؟ چرا که ما در این دریاى بخشش غرق گناه شده‌ایم."],[365,"آبرو می‌رود ای ابر خطاپوش ببار","که به دیوان عمل نامه‌سیاه آمده‌ایم","ای ابر بخشنده که گناهان ما را می‌پوشانی، ببار تا اینکه ما به‌خاطر اعمال زشت‌مان، نامه‌ای سیاه و ننگین برای خود نوشته‌ایم و آبروی‌مان دارد از بین می‌رود."],[365,"حافظ این خرقه پشمینه بینداز که ما","از پی قافله با آتش آه آمده‌ایم","حافظ می‌گوید این لباس پشمینه (که معمولا نشانه‌ی زهد و پرهیزگاری است) را کنار بگذار، زیرا ما به دنبال قافله‌ی عشق و محبت هستیم و از آتش عشق آمده‌ایم."],[366,"فتوی پیر مغان دارم و قولی‌ست قدیم","که حرام است می آن جا که نه یار است ندیم","من از یک عالم دینی (پیر مغان) حکمی دارم و قولی قدیمی که نوشیدن شراب در جایی که محبوب و دوست در کنار نیست، حرام است."],[366,"چاک خواهم زدن این دلق ریایی، چه کنم؟","روح را صحبت ناجنس، عذابی‌ست الیم","می‌خواهم این لباس ریاکاری را بشکافم و از بین ببرم، زیرا معاشرت با چیزهای ناپاک و غیر واقعی، عذابی دردناک برای روح است."],[366,"تا مگر جرعه فشاند لب جانان بر من","سال‌ها شد که منم بر در میخانه مقیم","سال‌هاست که من در میخانه نشسته‌ام و منتظر هستم تا محبوبم جرعه‌ای به من بدهد."],[366,"مگرش خدمت دیرین من از یاد برفت","ای نسیم سحری! یاد دهش عهد قدیم","آیا نسیم صبحگاهی به یاد دارد که من سال‌ها با او چه دوستی و محبت دیرینی داشتم؟ امیدوارم که این یادها از خاطرش نرفته باشد و به خاطر داشته باشد که ما زمانی پیمانی با هم داشتیم."],[366,"بعد صد سال اگر بر سر خاکم گذری","سر برآرد ز گلم رقص‌کنان عظم رمیم","اگر پس از صد سال بر سر خاک من عبور کنی، خاک من از شادی سر برخواهد آورد و به رقص درخواهد آمد، مانند مجسمه‌ای که از ویرانه‌ها به شکوه بازگشته است."],[366,"دلبر از ما به صد امّید ستد اول دل","ظاهرا عهد فرامش نکند خلق کریم","دلبر (معشوق) از ما به امیدهای زیادی دست یافته است، اما در ابتدا به نظر می‌رسد که وعده‌ی فراموش نکردن را به ما می‌دهد و از ویژگی نیکوی خود دست نمی‌کشد."],[366,"غنچه گو «تنگ‌دل از کار فروبسته مباش","کز دم صبح مدد یابی و انفاس نسیم»","غنچه بگو که تنگ‌دل و ناامید از کارهای بسته و مشکلات نباش، زیرا در صبح زود می‌توانی از نفس‌های تازه نسیم، یاری بگیری و به زندگی امیدوار شوی."],[366,"فکر بهبود خود ای دل ز دری دیگر کن","درد عاشق نشود به، به مداوای حکیم","ای دل، برای بهبود وضعیت خود، به فکر چاره‌ای جدید باش و از روشی متفاوت استفاده کن، زیرا درد عاشق به سادگی با درمان‌های معمولی نمی‌تواند بهبود یابد."],[366,"گوهر معرفت آموز که با خود ببری","که نصیب دگران است نصاب زر و سیم","برای شناخت و فهم بیشتر، باید گوهری از معرفت را یاد بگیری که با خود ببری. زیرا آنچه نصیب دیگران می‌شود، فقط مال و ثروت مادی (زر و سیم) است."],[366,"دام سخت است مگر یار شود لطف خدا","ور نه آدم نبرد صرفه ز شیطان رجیم","تنها با لطف خدا و یاری اوست که می‌توان از سختی‌ها نجات یافت وگرنه انسان به تنهایی نمی‌تواند در برابر وسوسه‌های شیطان مقاوم بماند."],[366,"حافظ ار سیم و زرت نیست، چه شد؟ شاکر باش","چه به از دولت لطف سخن و طبع سلیم","حافظ می‌گوید که اگر ثروت و زیبایی (سیم و زرت) در زندگی‌ات نیست، غم نخور. باید شکرگزار باشی زیرا نعمت صحبت خوب و طبع نیکو از داشتن ثروت و زیبایی بهتر است."],[367,"خیز تا از در میخانه گشادی طلبیم","به ره دوست نشینیم و مرادی طلبیم","بیا از در میخانه چیزی بگیریم تا در مسیر دوست بنشینیم و خواسته‌ای از او درخواست کنیم."],[367,"زاد راه حرم وصل نداریم مگر","به گدایی ز در میکده زادی طلبیم","برای رسیدن به حریم وصل، چیزی جز گدایی و درخواست از در میکده نداریم، چرا که بی‌نیاز نمی‌توانیم به این مقصد برسیم."],[367,"اشک آلوده ما گرچه روان است ولی","به رسالت سوی او پاک‌نهادی طلبیم","هرچند اشک‌های ما آلوده و پر از غم هستند و جاری می‌شوند، ولی ما در حقیقت در پی پاکی و از بین بردن این آلودگی، به سوی او (خدا یا معشوق) جستجو می‌کنیم."],[367,"لذت داغ غمت بر دل ما باد حرام","اگر از جور غم عشق تو دادی طلبیم","لذت تحمل داغ غم تو بر دل ما نباید حلال باشد، اگر خودت به ما این درد ناشی از بی‌وفایی و ظالم بودن عشق‌ات را عطا کرده‌ای."],[367,"نقطه خال تو بر لوح بصر نتوان زد","مگر از مردمک دیده مدادی طلبیم","هیچ‌کس نمی‌تواند نشانی از زیبایی تو را بر چشم‌هایم بگذارد، مگر اینکه از اشک و رنجی که در چشم‌هایم است تو را به من بدهی."],[367,"عشوه‌ای از لب شیرین تو دل خواست به جان","به شکرخنده لبت گفت مزادی طلبیم","دل به زیبایی و جذابیت لب‌های شیرین تو می‌خواهد و از تو می‌خواهد که با لبخند دلنوازت، نعمتی را برای ما فراهم کنی."],[367,"تا بود نسخه عطری دل سودازده را","از خط غالیه‌سای تو سوادی طلبیم","ما برای درمان دل پریشان و عاشق‌پیشه‌ام، از تو که عطر خاصی داری، نسخه‌ای تهیه کنیم."],[367,"چون غمت را نتوان یافت مگر در دل شاد","ما به امّید غمت خاطر شادی طلبیم","چون نمی‌توانیم غمت را به‌دست آوریم، تنها در دل شاد خود به امید غم تو، شادی را طلب می‌کنیم."],[367,"بر در مدرسه تا چند نشینی حافظ؟","خیز تا از در میخانه گشادی طلبیم","حافظ، به ما می‌گوید که چه مدت باید در مدرسه و در محضر علم بمانیم؟ بهتر است برخیزیم و از در میخانه، لذت و خوشی را بیابیم."],[368,"ما ز یاران چشم یاری داشتیم","خود غلط بود آنچه ما پنداشتیم","مـا از دوستان خویش توقّع کمک و مساعدت داشتـیـم ، امـّا دریغا که توقّع ما نابجا بوده و آنگونه که می پنداشتیم رشته ی دوستی و الفت ما محکم نبوده است. ما اشتباه می کردیم و ظاهراّ دوستی بین ما جاری نبوده است و اینک انتظارمان نیز بیهوده و بیجاست."],[368,"تا درخت دوستی بر کی دهد","حالیا رفتیم و تخمی کاشتیم","ما یک بذر دوستی در مزرعه ی دلمان کاشته ایم تا بـبـیـنـیـم چه زمانی این بذر شکوفا خواهد شد و چه زمانی این درخت میوه و ثمر خواهد داشت."],[368,"گفت‌و‌گو آیین درویشی نبود","ور نه با تو ماجراها داشتیم","مجادله و بحث بر سر اینکه چرا تو رسم رفاقت را به جا نیاوردی و مرتکب خطا شدی در آئین درویشی وجوانمردی درست نیست و من هم قصد مجادله ندارم وگرنه من اگر همچنان مثل سابق صوفی بودم می بایست این نامهربانی و زیر پا گذاشتن رسم رفاقت از جانب تو در محضر پیر خانقاه مطرح می شد و تو نیز مجازات می شدی."],[368,"شیوه چشمت فریب جنگ داشت","ما غلط کردیم و صلح انگاشتیم","غمزه ها و طرز نگاه کردن تو را از سادگی، به ناز و عشوه تعبیر کردیم! در حالی که ما عاشق بودیم و نمی دانستیم که این طرز نگاه تو قصد و غرضی در پی دارد و آن اعلان جنگ ونبرد است‌. ما اشتباه کردیم وصلح و آشتی تعبیر نمودیم."],[368,"گلبن حسنت نه خود شد دلفروز","ما دم همت بر او بگماشتیم","خطاب به معشوق است. یادت باشد که این بوته ی زیبایی تو خود بخود به این حد از کمال نرسیده است! این ما بودیم که شبانه روز بی وقفه مشتاقانه دعا کردیم و انرژی های مثبت را از صمیم جان و دل مامور حفاظت و سلامتی و سرافرازی تو نمودیم."],[368,"نکته‌ها رفت و شکایت کس نکرد","جانب حرمت فرو نگذاشتیم","بی توجّی های تو ما را آزرده خاطر ساخت، نامهربانی های بسیـار دیدیم ، امّا بـه حرمت تـو کسی گـله و شکایت نـکـرد.!"],[368,"گفت خود دادی به ما دل حافظا","ما محصّل بر کسی نگماشتیم","معشوق در قبال سخنان گله آمیز حافظ گفت:ای حافظ که اینقدر گله و شکایت می کنی،تـو خودت دل به مـا سپردی و عاشق ما شدی ، کسی برای تو دعوت نامه نفرستاده و تو خود پیش قدم شده و عشق ما را در دل نشاندی! ما که کسی را مـأمـور نـکـردیـم که دل تـو را بـگـیـرد و به مـا بـدهـد.!"],[369,"صلاح از ما چه می‌جویی؟ که مستان را صلا گفتیم","به دور نرگس مستت سلامت را دعا گفتیم","چرا از ما طلب اصلاح می‌کنی؟ ما به مست‌های عشق تو، در دورانی که بی‌خبر بودند، فقط آرزوی سلامتی برای تو را کرده‌ایم."],[369,"در میخانه‌ام بگشا که هیچ از خانقه نگشود","گرت باور بود ور نه سخن این بود و ما گفتیم","در میخانه‌ام را باز کن، چون هیچ یک از خانقاه (محل عبادت صوفیان) برای من باز نشده است. اگر به تو باور دارم که من را می‌خواهی، این حرف را می‌زنم و ما این را گفتیم."],[369,"من از چشم تو ای ساقی خراب افتاده‌ام لیکن","بلایی کز حبیب آید هزارش مرحبا گفتیم","من به خاطر عشق و زیبایی تو، ای ساقی، به حالت خراب و پریشان درآمده‌ام، اما بلایی که از محبوب بر انسان می‌رسد، هزار بار خوش آمد می‌گوییم و آن را می‌پذیریم."],[369,"اگر بر من نبخشایی پشیمانی خوری آخر","به خاطر دار این معنی که در خدمت کجا گفتیم","اگر من را نبخشی، در آینده پشیمان خواهی شد. پس به یاد داشته باش که ما در کجا و چه صحبت‌هایی درباره خدمت به هم داشتیم."],[369,"قدت گفتم که شمشاد است؛ بس خجلت به بار آورد","که این نسبت چرا کردیم و این بهتان چرا گفتیم","گفتم قامت تو مانند شمشاد زیباست، اما حالا از این گفته خجالت می‌کشم و از خود می‌پرسم که چرا چنین نسبتی به تو دادم و چرا این تهمت را به تو زدم."],[369,"جگر چون نافه‌ام خون گشت کم زینم نمی‌باید","جزای آن که با زلفت سخن از چین خطا گفتیم","دل من مانند نافه (نوعی عطر) خونین شد، و برای این حالتی که پیدا کرده‌ام، مجازات نکن، زیرا ما بابت آن که در مورد زلفت از چین (تروما) اشتباه صحبت کردیم، لایق چنین مجازاتی نیستیم."],[369,"تو آتش گشتی ای حافظ ولی با یار درنگرفت","ز بدعهدیّ گل گویی حکایت با صبا گفتیم","ای حافظ، تو به خاطر عشق و محبت، تبدیل به آتش شدی، اما هنگام صحبت با یارت، از بدعهدی و بی‌وفایی گل شاکی نشدی و فقط داستان آن را با صبا (باد) بازگو کردی."],[370,"ما درس سحر در ره میخانه نهادیم","محصول دعا در ره جانانه نهادیم","ما به جای درس و علم در راه میخانه، یعنی مکانی که به مستی و آزادی روح می‌پردازد، دور هم جمع شدیم و به جستجوی معنوی و عشق پرداخته‌ایم و دعاهای خود را در مسیر محبوب واقعی‌مان جاری کردیم."],[370,"در خرمن صد زاهد عاقل زند آتش","این داغ که ما بر دل دیوانه نهادیم","داغ آن آتش که ما بر دل انسان های شیفته و عاشق و از خود بی خود زدیم خرمن وجود صدها زاهد عاقل را می سوزاند و از بین می برد."],[370,"سلطان ازل گنج غم عشق به ما داد","تا روی در این منزل ویرانه نهادیم","خدای ازلی (سلطان ازل) به ما گنجی از غم عشق عطا کرد، تا ما در این خانه خراب، چهره‌ای را بگذاریم و رونق ببخشیم."],[370,"در دل ندهم ره پس از این مهر بتان را","مهر لب او بر در این خانه نهادیم","دیگر در دل خود جایی برای محبت معشوقان (بتان) باقی نمی‌گذارم، زیرا محبت لبان او را در این خانه گذاشته‌ام و همه چیز را فدای آن کرده‌ام."],[370,"در خرقه از این بیش منافق نتوان بود","بنیاد از این شیوه رندانه نهادیم","نمی‌توان در جامه‌ی زهد و دینداری به ظاهر خود را مومن نشان داد، زیرا ما استراتژی‌ای رندانه را در زندگی‌مان انتخاب کرده‌ایم."],[370,"چون می‌رود این کشتی سرگشته که آخر","جان در سر آن گوهر یک دانه نهادیم","زمانی که این کشتی سرگشته (سرگردان) دریا را طی می‌کند، آخرین امید ما این است که در دل آن، گوهر باارزش و منحصر به‌فردی را قرار داده‌ایم."],[370,"المنة للّه که چو ما بی‌دل و دین بود","آن را که لقب عاقل و فرزانه نهادیم","شکر خدا را که ما هم بی‌دل و دین بودیم، و کسی که به او لقب عاقل و فرزانه دادیم، در واقع چنین نیست."],[370,"قانع به خیالی ز تو بودیم چو حافظ","یا رب چه گداهمت و بیگانه نهادیم","ما به خیال تو قانع بودیم، مانند حافظ؛ ای پروردگار، چه شگفت است که ما را که مانند گدایان بی‌نوا هستیم، بیگانه و دور از خود قرار داده‌ای."],[371,"بگذار تا ز شارع میخانه بگذریم","کز بهر جرعه‌ای همه محتاج این دریم","اجازه بده تا از کنار در میخانه عبور کنیم، زیرا همه ما برای یک جرعه از شراب به این در نیازمندیم."],[371,"روز نخست چون دم رندی زدیم و عشق","شرط آن بود که جز ره آن شیوه نسپریم","در روز اول که با طرز رندی (بی‌خیالی و آزادگی) عشق را آغاز کردیم، شرط این عشق این بود که جز در راه آن شیوه (روش زندگی عاشقانه) گام ننهیم."],[371,"جایی که تخت و مسند جم می‌رود به باد","گر غم خوریم خوش نبود به که می خوریم","وقتی تخت و حکومت جمشید (جم) از بین می‌رود، اگر غم بخوریم، بهتر است به جای آن، میخوری کنیم و خوش بگذرانیم."],[371,"تا بو که دست در کمر او توان زدن","در خون دل نشسته چو یاقوت احمریم","من در انتظارم که چقدر می‌توانم به معشوق نزدیک شوم و او را در آغوش بگیرم، همان‌طور که یاقوت سرخ در خون غوطه‌ور است."],[371,"واعظ مکن نصیحت شوریدگان که ما","با خاک کوی دوست به فردوس ننگریم","واعظ، موعظه و نصیحت به دیوانگان نکن، زیرا ما به خاطر عشق به خاک درگاه دوست، به بهشت هم توجهی نداریم."],[371,"چون صوفیان به حالت و رقصند مقتدا","ما نیز هم به شعبده دستی برآوریم","چون صوفیان در حال ذکر و رقص هستند، ما نیز باید با تکیه بر فنون و ترفندها، حالتی شبیه به آن‌ها پیدا کنیم."],[371,"از جرعه تو خاک زمین در و لعل یافت","بیچاره ما که پیش تو از خاک کمتریم","از خوش‌گوارگی شراب تو، خاک زمین مانند مرحله‌ای زینتی و باارزش شد، اما ما، که در مقابل تو مانند خاک بی‌ارزش و کوچک‌تر هستیم، بیچاره‌ایم."],[371,"حافظ چو ره به کنگره کاخ وصل نیست","با خاک آستانه این در به سر بریم","حافظ چون به بالای کنگره کاخ وصل نمی‌شود، ناچار است که بر خاک آستانه این در بماند و خود را تسلیم کند."],[372,"خیز تا خرقه صوفی به خرابات بریم","شطح و طامات به بازار خرافات بریم","بیا برویم تا لباس درویش را به میخانه ببریم و حرف‌های بی‌معنا و افسانه‌ها را به بازار باطل‌گویی ببریم."],[372,"سوی رندان قلندر به ره آورد سفر","دلق بسطامی و سجاده طامات بریم","به سوی رندان و عاشقان سرمست برویم و در این سفر لباس بسطامی (یعنی لباس یک صوفی بزرگ به نام بسطام) و جایگاهی پراز چیزهای باطل و گمراه‌کننده را به دست آوریم."],[372,"تا همه خلوتیان جام صبوحی گیرند","چنگ صبحی به در پیر مناجات بریم","بگذار همه‌ی عارفان و زاهدان جام پر از شراب صبحگاهی بگیرند و با چنگی به صدای صبح، به درگاه پیر و رисمانده خود دعا کنیم."],[372,"با تو آن عهد که در وادی ایمن بستیم","همچو موسی ارنی گوی به میقات بریم","ما به یاد تو و بر اساس پیمانی که در مکان امن و آرام (وادی ایمن) بستیم، می‌خواهیم مانند موسی، که از خدا درخواست دیدار کرد، به محل ملاقات (میقات) برویم."],[372,"کوس ناموس تو بر کنگره عرش زنیم","علم عشق تو بر بام سماوات بریم","ما برای دفاع از ناموس و شرافت تو، زنگ سرود را بر بالای عرش (فضای آسمانی) می‌زنیم و علم عشق تو را بر سقف آسمان برافراشته خواهیم کرد."],[372,"خاک کوی تو به صحرای قیامت فردا","همه بر فرق سر از بهر مباهات بریم","خاکی که در کوی توست، در روز قیامت، همه بر سر می‌گذاریم تا به این وسیله به افتخار و بزرگی خود پافشاری کنیم."],[372,"ور نهد در ره ما خار ملامت زاهد","از گلستانش به زندان مکافات بریم","اگر زاهد با ملامت و سرزنش خود بر سر راه ما خار بگذارد، ما از گلستانش به زندان عذاب خواهیم رفت."],[372,"شرممان باد ز پشمینه آلوده خویش","گر بدین فضل و هنر نام کرامات بریم","اگر ما از زهد و نیکوکاری خود به خاطر آلودگی‌هایی که داریم، شرمنده نباشیم، در این صورت با داشتن این علم و مهارت، ناقض مقام و کرامت‌مان خواهد بود."],[372,"قدر وقت ار نشناسد دل و کاری نکند","بس خجالت که از این حاصل اوقات بریم","اگر دل ارزش زمان را نشناسد و اقدامی انجام ندهد، تنها چیزی که نصیبش می‌شود، خجالت و شرمندگی از لحظه‌های این عمر است که از دست رفته است."],[372,"فتنه می‌بارد از این سقف مقرنس برخیز","تا به میخانه پناه از همه آفات بریم","فتنه و آشوب از آسمان در حال نازل شدن است، پس بهتر است از این وضعیت ناگوار بلند شویم و به میخانه برویم تا از تمام آسیب‌ها و خطرات رهایی یابیم."],[372,"در بیابان فنا گم شدن آخر تا کی","ره بپرسیم مگر پی به مهمات بریم","در این زندگی فانی ، غرق شدن در لذت ها و درد و رنج که باعث اتلاف وقت ارزشمن هست تا کی؟باید راه و هدف اصلی زندگی را پیدا کنیم"],[372,"حافظ آب رخ خود بر در هر سفله مریز","حاجت آن به که بر قاضی حاجات بریم","ای حافظ، آب صورت زیبای خود را بر در هر بی‌ارزش نریز، زیرا نیاز آن است که به درگاه قاضی حاجات برویم و از او درخواست کنیم."],[373,"بیا تا گل برافشانیم و می در ساغر اندازیم","فلک را سقف بشکافیم و طرحی نو دراندازیم","بیا تا گلریزان کنیم و شراب در پیاله بریزیم، سپس سقف سپهر گردنده را درهم شکسته و از نو، شالوده دیگری بنیان نهیم."],[373,"اگر غم لشکر انگیزد که خون عاشقان ریزد","من و ساقی به هم تازیم و بنیادش براندازیم","اگر اندوه لشکری برای ریختن خون عاشقان فراهم کند، من و ساقی به یاری هم شتافته و بنیاد غم را از جا برکنیم."],[373,"شراب ارغوانی را گلاب اندر قدح ریزیم","نسیم عطرگردان را، شکر در مجمر اندازیم","در قدح شراب ارغوانی رنگ، گلاب بریزیم و در آتشدان نسیم که بوی عطر می‌پراکند شکر بریزیم.ریختن گلاب در شراب به‌منظور دفع مضرت سردرد به‌ویژه برای مزاج‌های گرم و انبساط خاطر بود. ریختن شکر در آتشدان به‌منظور دوام بوی خوش و رفع سردرد ناشی از بوی تند عطر و مشک بود."],[373,"چو در دست است رودی خوش، بزن مطرب سرودی خوش","که دست‌افشان غزل خوانیم و پاکوبان سر اندازیم","ای مطرب، اکنون که عودی خوش‌نوا در دسترس توست، سرودی خوش‌آهنگ بنواز تا در حالت رقص شعری بخوانیم و در حالت پایکوبی به جای دستار سر بر خاک بیندازیم"],[373,"صبا! خاک وجود ما، بدان عالی‌جناب انداز","بود کآن شاه خوبان را نظر بر منظر اندازیم","ای باد صبا، تن خاکی ما را بر در آن آستانه رفیع بینداز، شاید که بتوانیم بر آن سرور زیبایان نگاهی بیندازیم."],[373,"یکی از عقل می‌لافد، یکی طامات می‌بافد","بیا کاین داوری‌ها را به پیش داور اندازیم","یکی از داشتن عقل لاف زده، به خود می‌بالد و دیگری با ادعای داشتن کرامات گزافه‌گویی می‌کند؛ بیا تا قضاوت این دعوا‌ها را به قاضی عادل جهان یعنی خداوند واگذار کنیم."],[373,"بهشت عدن اگر خواهی، بیا با ما به میخانه","که از پای خمت روزی، به حوض کوثر اندازیم","اگر بهشت جاویدان می‌طلبی با ما به میکده بیا تا تو را به یک‌باره از پای ظرف شراب به حوض کوثر در بهشت برسانیم."],[373,"سخن‌دانی و خوش‌خوانی نمی‌ورزند در شیراز","بیا حافظ که تا خود را، به ملکی دیگر اندازیم","ای حافظ، در شیراز مردمان معنای سخنان نغز و خوش‌آواز را درک نمی‌کنند؛ بیا تا رخت خود را به سرزمینی دیگر ببریم."],[374,"صوفی بیا که خرقه سالوس برکشیم","وین نقش زرق را خط بطلان به سر کشیم","ای صوفی (زاهد)، بیا که لباس ریا و بزرگ‌منشی را کنار بگذاریم و این نقوش بیهوده را باطل کنیم."],[374,"نذر و فتوح صومعه در وجه می نهیم","دلق ریا به آب خرابات برکشیم","ما در راه خدا و به خاطر می، نذر و صدقه می‌دهیم و در عوض، لباس ریاکاری را به دور می‌ریزیم و به میخانه می‌رویم."],[374,"فردا اگر نه روضه رضوان به ما دهند","غلمان ز روضه حور ز جنت به درکشیم","اگر فردا به ما نعمت‌های بهشتی مثل باغ‌های رضوان ندهند، ما غلمان (پسران بهشتی) و حور (زنان بهشتی) را از بهشت به سمت خود می‌آوریم."],[374,"بیرون جهیم سرخوش و از بزم صوفیان","غارت کنیم باده و شاهد به بر کشیم","اگر روزی از دنیای شادی و خوشی خارج شویم، با سرخوشی و شادابی از محفل صوفیان، شراب و معشوقه را قاچاق می‌کنیم و نزد خود می‌آوریم."],[374,"عشرت کنیم ور نه به حسرت کشندمان","روزی که رخت جان به جهانی دگر کشیم","باید در زندگی خوش بگذرانیم وگرنه روزی به حسرت و افسوس خواهیم افتاد، زمانی که جان‌مان را از بدن جدا کرده و به دنیای دیگری برویم."],[374,"سر خدا که در تتق غیب منزویست","مستانه‌اش نقاب ز رخسار برکشیم","حافظ می‌گوید که سر و راز خدا که در عالم غیب پنهان و دور افتاده است، با شوری و شادی باید پرده‌اش را از روی چهره‌اش کنار بزنیم."],[374,"کو جلوه‌ای ز ابروی او تا چو ماه نو","گوی سپهر در خم چوگان زر کشیم","اگر از ابرو و زیبایی معشوق، جلوه‌ای بیابیم، آن‌گاه همچون ماه نو، نشان قمر را در خم چوگان زرین به نمایش خواهیم گذاشت."],[374,"حافظ نه حد ماست چنین لاف‌ها زدن","پای از گلیم خویش چرا بیشتر کشیم","حافظ می‌گوید لاف زدن و ادعا کردن درباره چیزهایی که به ما مربوط نیست، کار درستی نیست و نباید فراتر از ظرفیت خود صحبت کنیم."],[375,"دوستان وقت گل آن به که به عشرت کوشیم","سخن اهل دل است این و به جان بنیوشیم","در زمان گل و زیبایی، بهتر است که از شادی و خوشی بهره‌مند شویم و از گفتار دل‌باختگان لذت ببریم و به آن توجه کنیم."],[375,"نیست در کس کرم و وقت طرب می‌گذرد","چاره آن است که سجاده به می بفروشیم","در هیچ‌کس مهربانی و خضوع نیست و زمان خوشی در حال سپری شدن است. تنها راه این است که سجاده (نشانه نیایش و عبادت) را با شراب تعویض کنیم و آن را کنار بگذاریم."],[375,"خوش هوایی‌ست فرح‌بخش خدایا بفرست","نازنینی که به رویش می گل‌گون نوشیم","هوا بسیار خوش و خوشایند است، ای خدا! لطف کن و معشوقه‌ای زیبا به ما هدیه کن تا بتوانیم با نوشیدن می سرخ‌رنگ بر شادی‌مان بیفزاییم."],[375,"ارغنون ساز فلک ره‌زن اهل هنر است","چون از این غصه ننالیم و چرا نخروشیم؟","ساز آسمان، هنرمندان را فریب می‌دهد و از آنجا که ما از این غم نمی‌نالم و چرا باید بی‌صدا بمانم؟"],[375,"گل به جوش آمد و از می نزدیمش آبی","لاجرم زآتش حرمان و هوس می‌جوشیم","گل (عشق یا زیبایی) به تپش درآمد و ما رنگ شراب را از شراب نچشیدیم، بنابراین از آتش ناامیدی و آرزوهای برآورده نشده، به شدت متأثر و دلتنگ می‌شویم."],[375,"می‌کشیم از قدح لاله شرابی موهوم","چشم بد دور که بی‌مطرب و می مدهوشیم","ما از جام شراب قرمز رنگی می‌نوشیم که وجودش واقعی نیست و فقط خیال است. چشم بد از ما دور باد، چون در این حال مستی و بی‌موسیقی به سر می‌بریم."],[375,"حافظ این حال عجب با که توان گفت که ما","بلبلانیم که در موسم گل خاموشیم","خود حافظ از حال عجیبی که دارد خبر ندارد و نمی‌داند با چه کسی باید صحبت کند، چون ما مانند بلبلانی هستیم که در فصل گل و زیبایی سکوت کرده‌ایم و حرفی نمی‌زنیم."],[376,"ما شبی دست برآریم و دعایی بکنیم","غم هجران تو را چاره ز جایی بکنیم","ما در شبی دعا می‌کنیم و از خدا می‌خواهیم که برای غم جدایی تو راه حلی پیدا کنیم."],[376,"دل بیمار شد از دست، رفیقان مددی","تا طبیبش به سر آریم و دوایی بکنیم","دل بیمارم (بیماری این دل، عشق است) از دستم برفت. رفقا مدد کنید تا طبیبش (معشوق) را بر سرش حاضر کنیم و درمانش کنیم."],[376,"آن که بی‌جرم برنجید و به تیغم زد و رفت","بازش آرید خدا را که صفایی بکنیم","آن کسی که بدون هیچ دلیلی ناراحت شد و به من آسیب رساند و رفت، دوباره او را برگردانید تا ما بتوانیم با خداوند، دلخوشی و آرامش پیدا کنیم."],[376,"خشک شد بیخ طرب راه خرابات کجاست","تا در آن آب و هوا نشو و نمایی بکنیم","جایگاه خوشی و شادی در حال حاضر خشک شده است. باید بدانیم که کجا می‌توان به میخانه رفت تا در آنجا دوباره زندگی و نشاطی پیدا کنیم."],[376,"مدد از خاطر رندان طلب ای دل ور نه","کار صعب است مبادا که خطایی بکنیم","ای دل، برای کمک از یاد رندان (معنای رند: افرادی که اهل خوش‌گذرانی و عیش و نوش هستند) درخواست کن، وگرنه کار دشواری پیش رو خواهیم داشت و ممکن است دچار خطا شویم."],[376,"سایه طایر کم حوصله کاری نکند","طلب از سایه میمون همایی بکنیم","سایه پرنده کم حوصله، نمی‌تواند کار خاصی انجام دهد؛ پس بیایید از سایه میمون (که خوشحال و شاداب است) درخواست کنیم تا کاری انجام دهد."],[376,"دلم از پرده بشد حافظ خوش‌گوی کجاست","تا به قول و غزلش ساز نوایی بکنیم","دل من از پشت پرده بیرون آمده و دنباله‌دار حافظ خوش‌گوی هستم؛ کجاست تا به شعر و غزلش آهنگی نواخته و به آن بپردازیم؟"],[377,"ما نگوییم بد و میل به ناحق نکنیم","جامه کس سیه و دلق خود ازرق نکنیم","ما نباید درباره دیگران بد بگوییم و نباید به سمت بی عدالتی جدب شویم. همچنین نباید لباس کسی را سیاه کنیم منظور نابود کردن دیگران که باعث شود خویشاوندان طرف سیاه پوش شوند بخاطر پر کردن جیب خود از دارایی‌های دنیوی"],[377,"عیب درویش و توانگر به کم و بیش بد است","کار بد مصلحت آن است که مطلق نکنیم","عیب‌جویی از درویش (فقیر) و توانگر (غنی) چه کم باشد و چه زیاد ناپسند است. کار ناپسند این است که آن را به طور کامل و مطلق به همه نسبت دهیم."],[377,"رقم مغلطه بر دفتر دانش نزنیم","سر حق بر ورق شعبده ملحق نکنیم","نباید با نیرنگ و فریب، برچسب‌های غلط بر دانش خود بزنیم و حقیقت را با تظاهر و حقه‌بازی مخلوط کنیم."],[377,"شاه اگر جرعه رندان نه به حرمت نوشد","التفاتش به می صاف مروّق نکنیم","اگر شاه (پادشاه) جرعه‌ای از شراب را به احترام جمعیت رندان (نوشندگان شراب) بنوشد، ما نباید توجه او را به شراب صافی که به رنگ زرد است، جلب کنیم."],[377,"خوش برانیم جهان در نظر راهروان","فکر اسب سیه و زین مغرّق نکنیم","در برابر مسافران و سالکان دنیا، به خوشی بر جهان که همچون اسبی است سواری کنیم ولی به تجملاتی همچون سیاه بودن اسب یا آراستگی زین بی اهمیت باشیم."],[377,"آسمان کشتی ارباب هنر می‌شکند","تکیه آن به که بر این بحر معلّق نکنیم","توانایی و هنر به غایت بالا و شگفت‌انگیز است، اما اگر به شخص خاصی اتکا کنیم و او را در موقعیت حساسی قرار دهیم، ممکن است با مشکلاتی روبرو شویم. به همین دلیل بهتر است به کسی یا چیزی وابسته نباشیم و در این آب‌های پرخطر، خود را نجات دهیم."],[377,"گر بدی گفت حسودی و رفیقی رنجید","گو «تو خوش باش که ما گوش به احمق نکنیم»","اگر حسودی بدی گفته و دوستی ناراحت شده، بگو «تو خیالت راحت باشد که ما به سخنان احمقانه توجه نخواهیم کرد و ناراحت نمی‌شویم»."],[377,"حافظ ار خصم خطا گفت، نگیریم بر او","ور به حق گفت، جدل با سخن حق نکنیم","حافظ می‌گوید اگر دشمن حرف نادرستی زد، به او توجهی نخواهیم کرد و حتی اگر به حق چیزی گفت، باز هم نباید در مورد آن مشاجره کنیم."],[378,"سرم خوش است و به بانگ بلند می‌گویم","که من نسیم حیات از پیاله می‌جویم","من حال خوبی دارم و با صدای بلند اعلام می‌کنم که من از پیاله‌ی شراب، زندگی و نشاط را طلب می‌کنم."],[378,"عبوس زهد به وجه خمار ننشیند","مرید خرقه دردی‌کشان خوش‌خویم","عبوس زهد یعنی این شیوخ و واعظانی که جلوه در محراب و منبر می می کنند ، هیچ وقت چهره عبوس شون نمی تواند به مانند یک فرد شراب خور که چهره حالت خاصی دارد ، تغییر کنن. اینقدر در زهد عبات گونه دروغین فرو رفته اند که به حالت یک مست میخانه نمی توانند در بیایند یا تجربه کنند. اونها عبوسند و من حافظ مرید و راهرو دردی کشان - کسانی که تا انتهای مجلس شراب خواری ، شراب می خورند - هستم. چون این دست ادم ها لااقل دو رو و دروغگو نیستند"],[378,"شدم فسانه به سرگشتگی و ابروی دوست","کشید در خم چوگان خویش چون گویم","من دچار حوادث و سرگشتگی شدم و بر اثر زیبایی ابروهای دوست، مانند توپ در بازی چوگان در حرکت هستم؛ حالا نمی‌دانم چگونه این احساسات را بیان کنم."],[378,"گرم نه پیر مغان در به روی بگشاید","کدام در بزنم؟ چاره از کجا جویم؟","اگر پیر مغان (شخصی دانا و تجربه‌دار در عالم عرفان و تصوف) در را به روی من باز نکند، نمی‌دانم به کدام در باید بروم و از کجا باید راه چاره را پیدا کنم."],[378,"مکن در این چمنم سرزنش به خودرویی","چنان که پرورشم می‌دهند، می‌رویم","در این بیت، شاعر از خود می‌خواهد که در این باغ (چمن) او را به خاطر رفتار خود سرزنش نکنند، چون مانند گیاهی که در این زمین پرورش می‌یابد، به سرنوشت و مسیر خود ادامه خواهد داد."],[378,"تو خانقاه و خرابات در میانه مبین","خدا گواه که هر جا که هست، با اویم","تو نه خانقاه (محل نماز و عبادت) و نه خرابات (مکان شراب‌خواری) را در میانه زندگی‌ام قرار نده، زیرا خداوند گواه است که من در هر کجا که باشم، همیشه با او (خدا) هستم."],[378,"غبار راه طلب، کیمیای بهروزی‌ست","غلام دولت آن خاک عنبرین بویم","غبار راه طلب، یعنی نشانه‌های تلاش برای یافتن و رسیدن به هدف، به مانند کیمیای طلایی است که باعث خوشبختی و کامیابی می‌شود. من، که می‌خواهم به مقام و نعمت برسیم، بوی خاکی را که در آن عنبر وجود دارد، استشمام می‌کنم."],[378,"ز شوق نرگس مست بلندبالایی","چو لاله با قدح افتاده بر لب جویم","از شوق نرگس زیبا و دل‌ربا، مانند لاله که سرش را بر روی جامی خم کرده، بر لب رود می‌جویم."],[378,"بیار می که به فتوی حافظ از دل پاک","غبار زرق به فیض قدح فروشویم","می‌خواهم شرابی بیاوری که به زعم حافظ، با نیت پاک از دل، دانه‌های فریب و تظاهر را از زندگی‌ام دور کند و به لطف شراب فروش، به خوشی برسم."],[379,"بارها گفته‌ام و بار دگر می‌گویم","که من دل‌شده این ره، نه به خود می‌پویم","من چندین بار گفته‌ام و باز هم می‌گویم که من که دلم به عشق و سوز این راه رسیده است، به دنبال خودم نمی‌روم و تنها به عشق فکر می‌کنم."],[379,"در پس آینه، طوطی‌صفتم داشته‌اند","آن چه استاد ازل گفت بگو، می‌گویم","در درون آینه، مرا همچون طوطی می‌نگرند و آنچه استاد ازلی به من گفت، به امانت می‌گویم."],[379,"من اگر خارم و گر گل چمن‌آرایی هست","که از آن دست که او می‌کشدم، می‌رویم","من اگر خار هستم یا گل زیبایی در باغ، ناشی از تأثیر او هستم؛ او که در دستش قدرتی دارد و من به خاطر او به این شکل وجود دارم."],[379,"دوستان! عیب من بی‌دل حیران مکنید","گوهری دارم و صاحب نظری می‌جویم","ای دوستان! عیب و نقص من را به خاطر حالت پریشانی من سرزنش نکنید، زیرا من گوهری با ارزش دارم و کسی را در جستجوی خود می‌خواهم که به توانایی من پی ببرد."],[379,"گر چه با دلق ملمع، می گلگون عیب است","مکنم عیب کزو رنگ ریا می‌شویم","اگرچه با پوششی زیبا و رنگین (دلق ملمع) می گلگون (شراب قرمز) نوشیدن ناپسند است، اما من این عیب را پنهان می‌کنم، زیرا از این رنگ و لعاب به فریب و ریا تبدیل می‌شویم."],[379,"خنده و گریه عشاق ز جایی دگر است","می‌سرایم به شب و وقت سحر می‌مویم","عاشقان، خنده و گریه‌شان ناشی از دلیل دیگری است و من در شب و زمان سحر، مشغول سرودن و در حال نوشیدن می هستم."],[379,"حافظم گفت که «خاک در میخانه مبوی»","گو «مکن عیب که من مشک ختن می‌بویم»","حافظ می‌گوید که او به خاطر این که در میخانه (محل نوشیدنی) بوی خاک را می‌زند، نمی‌خواهد کسی او را سرزنش کند؛ زیرا او در واقع بوی مشک ختن (که عطر خوشبو و ارزشمندی است) را استشمام می‌کند."],[380,"گرچه ما بندگان پادشهیم","پادشاهان ملک صبحگهیم","هرچند که ما زیر دستان پادشاه هستیم، اما در واقع ما نیز پادشاهان کشور صبح هستیم، به معنای اینکه در عالم خود، مقام و ارزش بالایی داریم."],[380,"گنج در آستین و کیسه تهی","جام گیتی‌نما و خاک رهیم","اگرچه درون ما گنج و ثروت نهفته است، اما در عمل و ظاهر چیزی نداریم و مانند مسافران دنیا فقط در حال گذر هستیم."],[380,"هوشیار حضور و مست غرور","بحر توحید و غرقه گنهیم","ما در حالتی هوشیار و با حضور قلب هستیم، اما در عین حال به غرور گرفتاریم؛ در دریای یکتایی خداوند غرق در گناه هستیم و در این حالت انتظار داریم."],[380,"شاهد بخت چون کرشمه کند","ماش آیینه‌ رخ چو مهیم","وقتی شاهد بخت، که به زیبایی و خوش‌اقبالی اشاره دارد، ناز و کرشمه می‌کند، ما نیز زیبایی و لطافت را در چهره‌مان مانند ماه به نمایش می‌گذاریم."],[380,"شاه بیدار بخت را هر شب","ما نگهبان افسر و کلهیم","هر شب ما در کنار شاهی که بختش بیدار و خوش‌یمن است، نگهبان تاج و سر او هستیم."],[380,"گو غنیمت شمار صحبت ما","که تو در خواب و ما به دیده گهیم","صحبت ما را غنیمت بشمار، چرا که تو در خواب هستی و ما با چشم بیدار به تماشای تو نشسته‌ایم."],[380,"شاه منصور واقف است که ما","روی همّت به هر کجا که نهیم","شاه منصور می‌داند که ما در هر جا که اراده کنیم، متکی به تلاش و هدف‌گذاری خود خواهیم بود."],[380,"دشمنان را ز خون کفن سازیم","دوستان را قبای فتح دهیم","با شجاعت و قاطعیت، دشمنان را نابود می‌کنیم و به دوستان خود پاداش و نشانه‌های پیروزی خواهیم داد."],[380,"رنگ تزویر پیش ما نبود","شیر سرخیم و افعی سیهیم","ما رنگ تزویر و نیرنگ افراد را نمی‌پذیریم؛ ما همچون شیر و افعی، یعنی موجوداتی قوی و خطرناک هستیم و دلیری و خطر را در خود داریم."],[380,"وام حافظ بگو که بازدهند","کرده‌ای اعتراف و ما گوهیم","حافظ می‌گوید برای تویی که وام ما را داده‌ای، خود را به ما نشان بده و بگو چه چیزهایی از ما طلب می‌کنی. ما به صراحت می‌گوییم که گناهکار هستیم."],[381,"فاتحه‌ای چو آمدی بر سر خسته‌ای بخوان","لب بگشا که می‌دهد لعل لبت به مرده جان","اگر به سراغ کسی که در حالت خستگی و افسردگی است بیایی، فاتحه‌ای برای او بخوان و بر لب‌هایش بوسه بزن، زیرا لب‌های او به نوعی می‌تواند روحی تازه به جان مرده بیفزاید."],[381,"آن که به پرسش آمد و فاتحه خواند و می‌رود","گو نفسی که روح را می‌کنم از پیش روان","آن کسی که به سراغ من آمده، فاتحه‌ای برایم خوانده و اکنون می‌رود، بگو که من در حال رهایی روح خود هستم."],[381,"ای که طبیب خسته‌ای، روی زبان من ببین","کـاین دم و دود سینه‌ام، بار دل است بر زبان","ای پزشک خسته، به زبانم نگاه کن، زیرا اینکه در این لحظه و با این نفس و غم سینه‌ام، درد و بار سنگین دلم را بر زبان آورده‌ام."],[381,"گرچه تب استخوان من کرد ز مهر گرم و رفت","همچو تبم نمی‌رود آتش مهر از استخوان","علی‌رغم اینکه عشق و محبت تو به من تو را غیرقابل تحمل کرده و مانند تب و حرارت بدنم شده است، اما آتش این عشق هرگز از وجودم نمی‌رود و در من ادامه دارد."],[381,"حال دلم ز خال تو هست در آتشش وطن","چشمم از آن دو چشم تو خسته شده‌ست و ناتوان","دل من به خاطر عشق تو در آتش می‌سوزد و به خاطر زیبایی چشمانت، چشمان من از خستگی و ناتوانی به شدت تحت فشار هستند."],[381,"بازنشان حرارتم ز آب دو دیده و ببین","نبض مرا که می‌دهد هیچ ز زندگی نشان","اشک‌هایم داغی و حرارت زیادی را نشان می‌دهند، و اگر نبض من را ببینی، متوجه می‌شوی که هیچ نشانی از زندگی در من نیست."],[381,"آن که مدام شیشه‌ام از پی عیش داده است","شیشه‌ام از چه می‌برد پیش طبیب هر زمان؟","کسی که همیشه به من مشروب می‌دهد، چرا هر بار شیشه‌ام را پیش پزشک می‌برد؟"],[381,"حافظ از آب زندگی شعر تو داد شربتم","ترک طبیب کن بیا نسخه شربتم بخوان","حافظ می‌گوید که از آب زندگی، شعری به من داده است که مرا از درمانگر بی‌نیاز می‌کند، پس بیا و نسخه شربت من را بخوان تا به من کمک کنی."],[382,"چندان که گفتم غم با طبیبان","درمان نکردند مسکین غریبان","هر چه غم خود را به طبیبان گفتم، نتوانستند بی‌کسان و بیچارگان را درمان کنند."],[382,"آن گل که هر دم در دست بادیست","گو شرم بادش از عندلیبان","به آن گلی که هر لحظه در دست بادی است، بگو که بلبلان خجالت بکشد."],[382,"یا رب امان ده تا بازبیند","چشم محبان روی حبیبان","خداوندا، اجازه بده چشم دوست‌داران دوباره چهره معشوقان را ببیند."],[382,"درج محبت بر مهر خود نیست","یا رب مبادا کام رقیبان","مهر و موم صندوقچه‌‌ی محبت بر جای خود نیست. خداوندا مبادا که به دست رقیبان باشد."],[382,"ای منعم آخر بر خوان جودت","تا چند باشیم از بی نصیبان","ای بخشنده تا کی ما بر سفره‌ی بخشش تو از بی‌نصیبان باشیم؟"],[382,"حافظ نگشتی شیدای گیتی","گر می‌شنیدی پند ادیبان","ای حافظ اگر به اندرز ادیبان گوش می‌دادی، دلبسته‌ی جهان نمی‌شدی."],[383,"می‌سوزم از فراقت روی از جفا بگردان","هجران بلای ما شد، یا رب بلا بگردان","من از دوری تو می‌سوزم، ای پروردگارا، با دلی که از جفای تو رنج می‌برد، ای کاش بلای هجران را از ما دور کنی."],[383,"مه جلوه می‌نماید بر سبز خنگ گردون","تا او به سر درآید، بر رخش پا بگردان","ماه در آسمان به زیبایی و روشنایی می‌درخشد و تا زمانی که او در جهان ظاهر شود، باید بر پای خود بچرخد و خود را نشان دهد."],[383,"مرغول را برافشان یعنی به رغم سنبل","گرد چمن بخوری همچون صبا بگردان","به رغم زیبایی گل سنبل که در چمن رشد کرده، وزش نسیم صبا را به سمت مرغی که در باغ است، برسان."],[383,"یغمای عقل و دین را بیرون خرام سرمست","در سر کلاه بشکن در بر قبا بگردان","خود را با شور و حال در خیابان‌ها بگردان و در این میانه، بازی‌های عقل و دین را به کناری بزن و کلاهی شادمان بر سر بگذار."],[383,"ای نور چشم مستان در عین انتظارم","چنگ حزین و جامی بنواز یا بگردان","ای محبوب من که نور چشمان مست‌ها هستی، در حالی که منتظر تو هستم، با چنگی غمگین و جامی مرا نوازش کن، یا اینکه وضع مرا تغییر بده."],[383,"دوران همی‌نویسد بر عارضش خطی خوش","یا رب نوشته بد از یار ما بگردان","سال‌های عمر ما بر چهره محبوب، خطی زیبا می‌نویسند؛ ای کاش نوشته‌ای بد از او برطرف کنی و خوشی‌ها را برگردانی."],[383,"حافظ ز خوبرویان بختت جز این قدر نیست","گر نیستت رضایی حکم قضا بگردان","حافظ می‌گوید: خوش‌چهرگان (خوبرویان) یار تو چنین است که اگر نسبت به تو راضی نیست، قضا و قدر را به‌گونه‌ای تغییر بده که این عدم رضایت از میان برود."],[384,"یا رب آن آهوی مشکین به ختن باز رسان","وان سهی سرو خرامان به چمن باز رسان","ای خدا، آن آهوی زیبا و مشکین را به آغوش همسرش برگردان و نیز آن سرو خوش‌چهره و دلربا را به باغ بازگردان."],[384,"دل آزرده ما را به نسیمی بنواز","یعنی آن جان ز تن رفته به تن باز رسان","بگذار دل آشفته‌ام را با نسیمی آرامش دهی؛ به عبارتی از آن جان که از بدن رفته، دوباره به بدن برگردان."],[384,"ماه و خورشید به منزل چو به امر تو رسند","یار مه‌روی مرا نیز به من باز رسان","اگر ماه و خورشید به خواست تو به منزل خود برسند، پس دوست زیباروی مرا نیز به من برگردان."],[384,"دیده‌ها در طلب لعل یمانی خون شد","یا رب آن کوکب رخشان به یمن باز رسان","چشم‌ها به خاطر جست‌وجوی یاقوتی که در یمن است، به اشک بدل شده‌اند. ای خدا، آن ستاره‌ی درخشان را که در یمن است، به من برگردان."],[384,"برو ای طایر میمون همایون آثار","پیش عنقا سخن زاغ و زغن باز رسان","ای پرنده خوش‌شانسی که به کاروان آسمانی پیوسته‌ای، به پیش عنقا (پرنده افسانه‌ای) برو و خبرهای زاغ و زغن (پرندگان عادی و بی‌ارزش) را منتقل کن."],[384,"سخن این است که ما بی تو نخواهیم حیات","بشنو ای پیک خبرگیر و سخن باز رسان","این بیت بیانگر این است که ما بدون تو قادر به ادامه زندگی نیستیم، پس ای پیام‌آور، خبر را به ما برسان."],[384,"آن که بودی وطنش دیده حافظ یا رب","به مرادش ز غریبی به وطن باز رسان","حافظ از خدایش می‌خواهد کسی که وطنش چشمان اوست، یعنی شخصی که حافظ به او عشق ورزیده است، به خواسته‌اش برسد و او را از غربت به وطنش برگرداند."],[385,"خدا را کم نشین با خرقه پوشان","رخ از رندان بی‌سامان مپوشان","تو را به خدا قسم میدهم که با افراد با اسم و رسم و مقام کمتر نشست و برخاست کن و چهره ات را از مستمندان و رندان پوشیده نگاه ندار"],[385,"در این خرقه بسی آلودگی هست","خوشا وقت قبای می فروشان","در لباس مقام بسیار زشتی ها نهفته است, خوشا به حال کسانی که مقامشان می فروشی ست"],[385,"در این صوفی‌وشان دردی ندیدم","که صافی باد عیش دردنوشان","در میان صوفیان، هیچ دردی ندیدم که مانند درد شادمانی خمارترها و کسانی که نوشیدنی می‌نوشند، خالص باشد."],[385,"تو نازک‌طبعی و طاقت نیاری","گرانی‌های مشتی دلق‌پوشان","تو انسان حساسی هستی و نمی‌توانی بار سنگین دلفریب‌های افرادی که فقط ظاهری فریبنده دارند را تحمل کنی."],[385,"چو مستم کرده‌ای مستور منشین","چو نوشم داده‌ای زهرم منوشان","وقتی مرا مست کرده‌ای، خودت کم‌نمایان باش و مخفی بمان. چون به من شراب نوشانده‌ای، زهر را به من نده."],[385,"بیا وز غبن این سالوسیان بین","صراحی خون‌دل و بربط خروشان","بیا و ببین که چگونه این سالوس‌پیشگان (دوچهرگان) از ما کلاه‌برداری کرده‌اند، در حالی که در دست یکی صراحی (جام) پر از خون دل و در دست دیگری بربطی (ساز) در حال نواختن است."],[385,"ز دلگرمی حافظ بر حذر باش","که دارد سینه‌ای چون دیگ جوشان","حافظ از دلگرمی و دوستی خود بر حذر می‌کند و می‌گوید که ممکن است این محبت پنهان و عمیق در سینه‌اش مانند دیگ جوشان، در لحظه‌ای به خروش و ناآرامی تبدیل شود."],[386,"شاه شمشادقدان، خسرو شیرین‌دهنان","که به مژگان شکند قلب همه صف‌شکنان","پادشاه بلندبالایان و شهریار شیرین‌بیانان که با مژه‌هایش دل همه شجاعان شورش‌آور را می‌شکند‌…"],[386,"مست بگذشت و نظر بر من درویش انداخت","گفت: ای چشم و چراغ همه شیرین‌سخنان","در حال مستی بر من گذار کرد، نگاهی به من فقیر انداخت و گفت: ای سرآمد همه خوش‌کلامان‌…"],[386,"تا کی از سیم و زرت کیسه تهی خواهد بود؟","بنده من شو و برخور ز همه سیم‌تنان","تا چه زمانی می‌خواهی که جیب تو از طلا و نقره خالی باشد؟ بندگی مرا بپذیر تا از همه دلبران سیمین‌بدن بهره‌برداری کنی."],[386,"کمتر از ذره نه‌ای، پست مشو، مهر بورز","تا به خلوتگه خورشید رسی چرخ‌زنان","یک ذره گرد و غبار کمتر نیستی که خود را به خورشید می‌رساند. خود را فرومگذار و عاشق باش تا در حال رقص و چرخش به سراپرده خورشید برسی."],[386,"بر جهان تکیه مکن ور قدحی می‌ داری","شادی زهره‌جبینان خور و نازک‌بدنان","بر حال دنیا اعتماد مکن و اگر یک پیاله شراب داری به سلامتی ماهرویان و نازک‌اندامان بنوش."],[386,"پیر پیمانه‌کش من که روانش خوش باد","گفت: پرهیز کن از صحبت پیمان‌شکنان","روانشاد پیر عارف باده‌نوش من گفت که از بدقولان و عهدشکنان دوری گزین‌…"],[386,"دامن دوست به دست آر و ز دشمن بگسل","مرد یزدان شو و فارغ گذر از اهرمنان","خدا را عبادت کن و دل دوست را به دست آر (منظور خدا است)و رابطه‌ات را با دشمن قطع کن. به مردی از سوی خداوند تبدیل شو . تا بر شیطان‌ها و اهریمنان پیروز شوی و به سلامت عبور کنی."],[386,"با صبا در چمن لاله سحر می‌گفتم","که شهیدان که‌اند این همه خونین‌کفنان","با وزش نسیم صبحگاهی در باغ گل‌های لاله، از آن پرسیدم که این همه افرادی که در اینجا به صورت خونین و زخمی دراز کشیده‌اند، چه کسانی هستند و چرا کشته شده‌اند."],[386,"گفت: حافظ! من و تو محرم این راز نه‌ایم","از می لعل حکایت کن و شیرین‌دهنان","حافظ می‌گوید که کسی به او می‌گوید، ما هیچ‌کدام از راز این مساله باخبر نیستیم، پس بهتر است درباره شراب قرمز و افرادی با سخنان شیرین صحبت کنیم."],[387,"بهار و گل طرب‌انگیز گشت و توبه‌شکن","به شادی رخ گل بیخ غم ز دل بر کن","بهار و گل به شادی و سرور تبدیل شدند، و توبه‌شکن (کسی که از آرزوها و غم‌هایش دست برمی‌دارد) باید غم را از دلش کنار بگذارد و به خوشحالی توجه کند."],[387,"رسید باد صبا غنچه در هواداری","ز خود برون شد و بر خود درید پیراهن","بادی که از سمت صبا وزید، غنچه‌ای را که به محبت و عشق دل بسته بود، به حرکت درآورد و آن غنچه به خاطر این احساس از خود خارج شد و به خود آسیب زد."],[387,"طریق صدق بیاموز از آب صافی دل","به راستی طلب آزادگی ز سرو چمن","از دل پاک و بی‌تزویر مانند آب زلال بیاموز که حقیقت را جست‌وجو کنی و به آزادی و رهایی همچون سرو باغی برسی."],[387,"ز دستبرد صبا گرد گل کلاله نگر","شکنج گیسوی سنبل ببین به روی سمن","بگو که از وزش نرم نسیم چگونه گل‌های زیبا را مواظبت می‌کند، و به دقت نگاه کن که پیچش موهای سنبل را در کنار درخشش سمن چطور به نمایش می‌گذارد."],[387,"عروس غنچه رسید از حرم به طالع سعد","بعینه دل و دین می‌برد به وجه حسن","عروس غنچه، که به طور مجازی به زیبایی و شکوفایی گل اشاره دارد، با تقدیر خوب به دنیا آمده و زیبایی‌اش دل و دین را تحت تاثیر قرار می‌دهد. این زیبایی به قدری است که دل و ایمان انسان را جذب می‌کند."],[387,"صفیر بلبل شوریده و نفیر هزار","برای وصل گل آمد برون ز بیت حزن","صدای بلبل عاشق و ناله هزاران دیگر به خاطر وصال گل از محل غم و اندوه خارج شده است."],[387,"حدیث صحبت خوبان و جام باده بگو","به قول حافظ و فتوی پیر صاحب فن","حافظ از شنیدن و گفتن درباره سخن گفتن با خوبان و نوشیدن شراب (که در ادبیات فارسی نماد لذت و عشق است) دعوت می‌کند و بر این نکته تأکید می‌کند که این موضوعات، بر اساس نظر و تأیید افراد مجرب و صاحب‌نظر دانسته می‌شوند."],[388,"چو گل هر دم به بویت جامه در تن","کنم چاک از گریبان تا به دامن","هر لحظه به بوی تو مانند گل، لباس خود را چاک می‌کنم و از گردن تا دامن آشکار می‌سازم."],[388,"تنت را دید گل گویی که در باغ","چو مستان جامه را بدرید بر تن","تو مانند گلی هستی که در باغ می‌درخشی و تماشای زیبایی‌ات، مرا به شدت شاداب و مست می‌کند؛ به‌طوری‌که انگار جامه‌ام را از شوق برمی‌دارم و به تو نزدیک می‌شوم."],[388,"من از دست غمت مشکل برم جان","ولی دل را تو آسان بردی از من","من از غم تو به سختی جان می‌برم، اما تو به راحتی دل مرا از خودت دور کردی."],[388,"به قول دشمنان برگشتی از دوست","نگردد هیچ کس با دوست دشمن","به گفته دشمنان، تو به عشق و دوستی پشت کردی، اما هیچ‌کس نمی‌تواند با دوست، دشمنی کند."],[388,"تنت در جامه چون در جام باده","دلت در سینه چون در سیم آهن","بدن تو در لباس مانند جام شراب است و دل تو در سینه مثل آهن است که درونش سیم است. این نکته را می‌رساند که ظاهر به زیبایی جام شراب است، ولی درونت مانند آهنی سخت و محکم است."],[388,"ببار ای شمع اشک از چشم خونین","که شد سوز دلت بر خلق روشن","ای شمع، اشک از چشمان خونینت بریز، زیرا سوزش دل تو به خوبی برای دیگران روشن شده است."],[388,"مکن کز سینه‌ام آه جگرسوز","برآید همچو دود از راه روزن","از سینه‌ام آهی جانسوز برمی‌خیزد که مانند دود از روزنه بیرون می‌آید، پس چنین نکنید که باعث رنجش و آزار من شوید."],[388,"دلم را مشکن و در پا مینداز","که دارد در سر زلف تو مسکن","دلم را نشکن و زیر پا نگذار که در زلف تو، محل نشستن و آرامش من است."],[388,"چو دل در زلف تو بسته‌ست حافظ","بدین سان کار او در پا میفکن","چون دل حافظ به زلف تو وابسته است، نباید کار او را با پا از بین ببری."],[389,"افسر سلطان گل پیدا شد از طرف چمن","مقدمش یا رب مبارک باد بر سرو و سمن","تاج یا افسر سلطنتی که در میان گل‌ها و گیاهان باغ ظاهر شده، منظرۀ زیبایی را به وجود آورده است، خدایا، بر این زیبایی بر درختان سرو و گلابی که در باغ هستند، مبارک باد."],[389,"خوش به جای خویشتن بود این نشست خسروی","تا نشیند هر کسی اکنون به جای خویشتن","خوشا به حال کسی که با همت و بزرگی خود در این جایگاه نشسته است، زیرا اکنون هر کسی می‌تواند در جایگاه خودش به خوبی نقش‌آفرینی کند."],[389,"خاتم جم را بشارت ده به حسن خاتمت","کاسم اعظم کرد از او کوتاه دست اهرمن","به خاتم جم (خاتم مخصوص که از اسطوره‌های ایرانی است) بگو که به حسن خاتمه (پایان نیک) بشارت دهد، زیرا کاسم اعظم (شخصیتی بزرگ و مهم) از دست اهرمن (نماد شر) کوتاه آمده است."],[389,"تا ابد معمور باد این خانه کز خاک درش","هر نفس با بوی رحمان می‌وزد باد یمن","نمی‌دانم این خانه تا ابد آباد بماند یا نه، اما هر بار که از در آن وارد می‌شوم، بوی خوش و دل‌نشین رحمت الهی، مانند باد یمن، مرا نوازش می‌کند."],[389,"شوکت پور پشنگ و تیغ عالمگیر او","در همه شهنامه‌ها شد داستان انجمن","شوکت و عظمت پور پشنگ (فرزند بزرگ زال و نوه رستم) و شمشیرش که در همه داستان‌های شاهنامه، نشانه‌ای از قدرت و شکوه او به حساب می‌آید، به عنوان یکی از قهرمانان جاودانه جلوه‌گر شده است."],[389,"خنگ چوگانی چرخت رام شد در زیر زین","شهسوارا چون به میدان آمدی گویی بزن","گویی که چوگانی (سوار) خنگ و نادانی با زیر زین سوار (شهسوار) رام شده است. هنگامی که تو به میدان وارد می‌شوی، انگار که این خنگ را بی‌رحمانه بزن."],[389,"جویبار ملک را آب روان شمشیر توست","تو درخت عدل بنشان بیخ بدخواهان بکن","آب جویبار این سرزمین از قدرت و دلیری توست. تو باید درخت عدالت را بکاری و ریشه‌های بدخواهان را قطع کنی."],[389,"بعد از این نشگفت اگر با نکهت خلق خوشت","خیزد از صحرای ایذج نافه مشک ختن","اگر بعد از این بوی خوش اخلاق و رفتار زیبا و دلنشین تو به مشام برسد، باید شگفت‌زده نشوم؛ چون این بوی خوش شبیه به خوشبویی است که از بیابان ایذج (منطقه‌ای در ایران) و از نافه مشک ختن (شهری در ختن، معروف به معطر بودن) برخاسته است."],[389,"گوشه گیران انتظار جلوه خوش می‌کنند","برشکن طرف کلاه و برقع از رخ برفکن","گوشه‌نشینان در انتظار دیدن زیبایی‌ها هستند، پس کلا‌ه و نقاب را از صورت کنار بزن تا چهره‌ات نمایان شود و زیبایی‌ات را به نمایش بگذاری."],[389,"مشورت با عقل کردم گفت حافظ می بنوش","ساقیا می ده به قول مستشار مؤتمن","حافظ با عقل خود مشورت کرده و می‌گوید که او به او پیشنهاد می‌کند که از ساقی شراب بنوشد، زیرا مستشار مؤتمن به او وعده داده که شراب خواهد داد."],[389,"ای صبا بر ساقی بزم اتابک عرضه دار","تا از آن جام زرافشان جرعه‌ای بخشد به من","ای نسیم، به ساقی بزم اتابک، بگو تا به من از آن جام زرد و نورانی جرعه‌ای بدهد."],[390,"خوش‌تر از فکر می و جام چه خواهد بودن؟","تا ببینم که سرانجام چه خواهد بودن","بهتر از اندیشیدن به شراب و جام، چه چیزی می‌تواند باشد، تا ببینم در نهایت چه سرنوشتی در انتظار من است."],[390,"غم دل چند توان خورد؟ که ایام نماند","گو نه دل باش و نه ایام چه خواهد بودن؟","غم دل را چه مقدار می‌توان تحمل کرد؟ زیرا روزگار پایدار نیست. پس نه به فکر دل باش و نه به فکر روزگار، زیرا زندگی چه خواهد شد، مشخص نیست."],[390,"مرغ کم‌حوصله را گو غم خود خور که بر او","رحم آن کس که نهد دام چه خواهد بودن؟","به مرغی با حوصله کم بگو که غم خود را بخورد، زیرا برای او اهمیتی ندارد که کسی که دام می‌نهد، بر او رحم کند یا نه."],[390,"باده خور غم مخور و پند مقلد منیوش","اعتبار سخن عام چه خواهد بودن؟","نوشیدن شراب را بر خود واجب کن و به غم (دلتنگی) فکر نکن. اینکه فقط به حرف‌های دیگران (مقلد) گوش بدهی و اعتبار آنها را به حساب بیاوری، نتیجه‌ای خوبی نخواهد داشت."],[390,"دست‌رنج تو همان به که شود صرف به کام","دانی آخر که به ناکام چه خواهد بودن؟","بهتر است آنچه را به دست آورده‌ای، صرف لذتی کنی که می‌دانی در نهایت چه سرنوشتی برای ناامیدان خواهد بود."],[390,"پیر میخانه همی‌خواند معمایی دوش","از خط جام، که فرجام چه خواهد بودن؟","پیر میخانه (شیخی در میخانه) دیشب معما یا راز عجیبی را از روی خطی که بر جام (جام شراب) بود، گفت و حالا سوالش این است که در نهایت و سرانجام چه خواهد شد؟"],[390,"بردم از ره دل حافظ به دف و چنگ و غزل","تا جزای من بدنام چه خواهد بودن","حافظ با دف، چنگ و شعر غزل، دل خود را مشغول کرده و با این کارها می‌خواهد بدنامی و آسیب‌هایی که از عشق یا زندگی برایش پیش آمده، به نوعی جبران کند و نمی‌داند در نهایت چه عواقبی در انتظارش است."],[391,"دانی که چیست دولت؟ دیدار یار دیدن","در کوی او گدایی، بر خسروی گزیدن","می‌دانی خوشبختی چیست؟ خوشبختی این است که در کوی محبوب دیدار او را داشته باشی، حتی اگر در این راه به گدایی و خواری بیفتی، اما انتخاب او به عنوان عشق، از مقام‌ها و ثروت‌ها باارزش‌تر است."],[391,"از جان طمع بریدن آسان بود ولیکن","از دوستان جانی، مشکل توان بریدن","ترک کردن طمع و علاقه از جان کار ساده‌ای است، اما جدا شدن از دوستانی که جان در آن‌ها است، کار دشواری است."],[391,"خواهم شدن به بستان، چون غنچه با دل تنگ","وآنجا به نیک‌نامی، پیراهنی دریدن","می‌خواهم به باغ بروم و مثل غنچه با دل مضطرب، در آنجا به نیک‌نامی، لباس خود را پاره کنم."],[391,"گه چون نسیم با گل، راز نهفته گفتن","گه سرّ عشق‌بازی، از بلبلان شنیدن","گاهی مانند نسیم با گل، رازهای پنهان را در میان می‌گویم و گاهی سرّ عشق و دلدادگی را از بلبلان می‌شنوم."],[391,"بوسیدن لب یار، اول ز دست مگذار","کآخر ملول گردی، از دست و لب گزیدن","بوسه زدن به لب معشوق را هرگز ترک نکن، چون در نهایت اگر این کار را رها کنی، دلت از یاد او و بوسه‌هایی که داشتید، می‌گیرد."],[391,"فرصت شمار صحبت، کز این دوراهه منزل","چون بگذریم دیگر، نتوان به هم رسیدن","همدمی و صحبت و دوستی را غنیمت بشمار زیرا زندگی کوتاه است و دیگر همدیگر را نخواهیم دید. ( دوراهه منزل یعنی یک مسافت کوتاه. راه اصطلاح مسافرتی قدیم بوده است که پس از آن یک توقف و استراحت کوتاه انجام می‌شده‌است)"],[391,"گویی برفت حافظ، از یاد شاه‌ یحیی","یا رب به یادش آور، درویش پروریدن","حافظ گویی از یاد شاه یحیی رفته است، ای خدای، تو او را به یاد بیاور، که درویش را پرورانده است."],[392,"منم که شهره شهرم به عشق ورزیدن","منم که دیده نیالوده‌ام به بد دیدن","این منم که در تمام شهر به عشق ورزیدن شناخته شده‌اممنم که چشمانم را به دیدن بدی و با چشم شهوت نیالوده‌ام و تنها زیبایی را با چشم عشق دیده‌ام"],[392,"وفا کنیم و ملامت کشیم و خوش باشیم","که در طریقت ما کافریست رنجیدن","اگر یار با ما مهربان نیست و وفا نمی‌کند، ما وفادار بمانیم و جور و سرزنش‌های او را تحمل کنیم و خوشحال باشیمچرا که در رسم و راه عاشقی، رنجیدن از معشوق کفر است"],[392,"به پیر میکده گفتم که چیست راه نجات","بخواست جام می و گفت عیب پوشیدن","از پیر مغان و مرشد میکده پرسیدم که راه نجات و رستگاری چیستاو جام شرابی خواست و گفت راه نجات، پرده پوشی و چشم پوشی از خطاهای آدمها است"],[392,"مراد دل ز تماشای باغ عالم چیست؟","به دست مردم چشم از رخ تو گل چیدن","خواسته و مراد دل از تماشای جهان و زیبایی‌های آن چیست؟ مگر نه این است که با مردمک چشم، روی زیبای تو را ببینیم و از گلستان عالم، گل روی تو را بچینیم"],[392,"به می پرستی از آن نقش خود زدم بر آب","که تا خراب کنم نقش خود پرستیدن","به می‌خواری و می‌پرستی روی آوردم تا هستی خود را در شراب بیفکنم و از خودپرستی رها شومیعنی می‌پرستی نیز بهتر از خودپرستی است"],[392,"به رحمت سر زلف تو واثقم ورنه","کشش چو نبود از آن سو چه سود کوشیدن؟","به لطف و عنایت سر زلف تو امیدوارم، وگرنه اگر از سوی تو کشش و علاقه‌ای نباشد، تلاش و کوشش من بی‌فایده است"],[392,"عنان به میکده خواهیم تافت زین مجلس","که وعظ بی‌عملان واجب است نشنیدن","از این مجلس روی به سوی میکده خواهیم آورد، چرا که نشنیدن نصیحت کسانی که خود به گفته‌هایشان عمل نمی‌کنند، واجب و لازم است"],[392,"ز خطّ یار بیاموز مهر با رخ خوب","که گرد عارض خوبان خوش است گردیدن","از خط رخ یار بیاموز که چگونه با زیبارویان مهر بورزی، چرا که نگریستن به چهره زیبارویان و بودن در کنارشان خوش و دلپذیر است(خط یار در اینجا به موی تازه‌روییده بر چهره معشوق اشاره دارد، و تناسبی با نوشته‌ی بر کاغذ)"],[392,"مبوس جز لب ساقی و جام می حافظ","که دست زهد فروشان خطاست بوسیدن","حافظ، جز لب ساقی و جام شراب را مبوس، چرا که بوسیدن دست زاهدان زهدفروش خطایی بزرگ است"],[393,"ای روی ماه‌منظر تو نوبهار حسن","خال و خط تو مرکز حسن و مدار حسن","ای چهره مانند ماه تو، بهار زیبایی است. خال و خطوط صورت تو، مرکز و محور زیبایی هستند."],[393,"در چشم پرخمار تو پنهان فسون سحر","در زلف بی‌قرار تو پیدا قرار حسن","در چشم‌های خمار تو جاذبه‌ای سحرآمیز نهفته است و در موهای نامنظم و بی‌قرار تو، آرامشی زیبایی وجود دارد."],[393,"ماهی نتافت همچو تو از برج نیکویی","سروی نخاست چون قدت از جویبار حسن","هیچ موجودی به زیبایی و نیکی تو از آسمان نیفتاده است و هیچ درختی به قامت تو از کنار آب‌های زلال سر بر نیاورده است."],[393,"خرّم شد از ملاحت تو عهد دلبری","فرّخ شد از لطافت تو روزگار حسن","ملاحت و زیبایی تو باعث شادی و خوشی شد و دوره دلبری به برکت لطافت و نرمی تو به روزهای خوش و خوشایند تبدیل گردید."],[393,"از دام زلف و دانه خال تو در جهان","یک مرغ دل نماند نگشته شکار حسن","به‌خاطر زیبایی و جذابیت زلف و جای خال تو، دیگر در این دنیا دلی نمانده که در دام عشق نفرود و قربانی زیبایی تو نشده باشد."],[393,"دائم به لطف دایه طبع از میان جان","می‌پرورد به ناز، تو را در کنار حسن","طبیعت و فطرت همیشه به نرمی و لطافت از وجود من مراقبت می‌کند و به آرامی تو را در کنار زیبایی می‌پروراند."],[393,"گرد لبت بنفشه از آن تازه و تر است","کآب حیات می‌خورد از جویبار حسن","بنفشه‌هایی که دور لب‌های تو رشد کرده‌اند، به خاطر زیبایی و طراوتی که دارند، گویی از جویبار زیبایی حیات می‌گیرند."],[393,"حافظ طمع برید که بیند نظیر تو","دیّار نیست جز رخت اندر دیار حسن","حافظ ناامید شده است که مانند تو را در سرزمین زیبایی‌ها پیدا کند؛ زیرا جز چهره زیبای تو در جایی دیگر زیبایی‌ وجود ندارد."],[394,"گلبرگ را ز سنبل مشکین، نقاب کن","یعنی که رخ بپوش و جهانی، خراب کن","به من بگو که گلبرگ را با سنبل خوشبو بپوشانی، تا چهره ات را بپوشانی و دل‌های دیگران را ویران کنی."],[394,"بفشان عرق ز چهره و اطراف باغ را","چون شیشه‌های دیده ما پرگلاب کن","عرق خود را بر زمین و دور باغ بریز، مانند افشانه‌های عطر که شیشه‌های چشمان ما را پر از عطر گل می‌کند."],[394,"ایّام گل، چو عمر به رفتن شتاب کرد","ساقی به دور باده گلگون، شتاب کن","ایام گل (یعنی دوره blossoming گل‌ها) که شبیه عمر انسان به سرعت می‌گذرد، ای ساقی، در پر کردن جام از شراب گلگون (شراب قرمز) سریع‌تر باش."],[394,"بگشا به شیوه، نرگس پرخواب مست را","وز رشک، چشم نرگس رعنا به خواب کن","به شیوه‌ای زیبا، چشمان خواب‌آلود و مست نرگس (عشوه) را باز کن، و از حسادت، چشم‌های نرگس (دلبند) را به خواب ببر."],[394,"بوی بنفشه بشنو و زلف نگار گیر","بنگر به رنگ لاله و عزم شراب کن","بوی بنفشه را استشمام کن و به موهای زیبا و خوش‌بوی محبوبت نگاه کن. بر اثر این زیبایی، رنگ لاله را ببین و تصمیم بگیر که شراب بنوشی."],[394,"زآن جا که رسم و عادت عاشق‌کشی توست","با دشمنان، قدح کش و با ما عتاب کن","چون تو عادت داری که عاشقان را به شدت می‌کشی و با دشمنان رفتار می‌کنی، بنابراین، جامی بنوش و با ما با مهربانی و صحبت درددل کن."],[394,"همچون حباب، دیده به روی قدح گشای","وین خانه را قیاس اساس از حباب کن","چشم‌هات را همچون حباب به روی جام باز کن و این خانه را به خاطر حبابی بودنش شبیه خود آن حباب تصور کن."],[394,"حافظ وصال می‌طلبد از ره دعا","یا رب! دعای خسته‌دلان، مستجاب کن","حافظ از خداوند می‌خواهد که آرزوی وصل معشوق را به واسطه دعا برآورده کند و از او می‌خواهد که دعاهای دل‌شکسته‌ها را مستجاب کند."],[395,"صبح است ساقیا قدحی پرشراب کن","دور فلک درنگ ندارد شتاب کن","ای ساقی، صبح شده است، ظرف شراب را پر کن؛ زمان برای لحظه‌ای نمی‌ایستد، پس تو نیز عجله کن! و جام شراب را به ما بده"],[395,"زان پیش‌تر که عالم فانی شود خراب","ما را ز جام باده گلگون خراب کن","ای ساقی قبل از آنکه این دنیای ناپایدار و زودگذر ، خراب و ویران شود، ما را از شراب سرخرنگ مست و مدهوش کن"],[395,"خورشید می ز مشرق ساغر طلوع کرد","گر برگ عیش می‌طلبی ترک خواب کن","شراب همچون خورشیدی از مشرق ساغر برآمد و ظاهر شد، اگر به دنبال توشه‌ای برای عیش و خوشگذرانی هستی، خواب را رها کن"],[395,"روزی که چرخ از گل ما کوزه‌ها کند","زنهار کاسه سر ما پرشراب کن","یعنی وقتی روزگار ما را به خاک تبدیل کرد و کوزه‌گر از آن خاک، روی چرخ کوزه‌گری ظرف و کوزه ساخت، از خاک سر ما نیز کاسه‌ای بساز و آن را از شراب پر کن."],[395,"ما مرد زهد و توبه و طامات نیستیم","با ما به جام باده صافی خطاب کن","من اهل پرهیزکاری و توبه و ادعاهای پوچ و بی‌معنی نیستم، اگر می‌خواهی با من صحبت کنی در مورد جام شراب ناب صحبت کن(نکته: نکته قابل توجه و رندانه حافظ در این بیت قرار دادن و مترادف دانستن طامات، با زهد و توبه هست)"],[395,"کار صواب، باده پرستی‌ست حافظا","برخیز و عزم جزم به کار صواب کن","ای حافظ، کار درست، علاقه شدید به سرمستی است؛ پس برخیز و برای انجام کار درست تصمیم محکمی بگیر."],[396,"ز در در آ و شبستان ما منور کن","هوای مجلس روحانیان معطر کن","عزیزم، به میهمانی ما بیا و فضای شبستان ما را روشن کن؛ هوای محیط ما را که به جمع روحانیان مربوط می‌شود، خوشبو کن."],[396,"اگر فقیه نصیحت کند که عشق مباز","پیاله‌ای بدهش گو دماغ را تر کن","«فقیه نصیحت کند که عشق مباز»یعنی اگر عالم ظاهرگرا تو را از عشق ورزیدن بازداشت و توصیه کرد از راه عشق دوری کنی.«پیاله‌ای بدهش گو دماغ را تر کن»یعنی جامی به او بده و بگو ابتدا حال و هوای خشک و ذهن گرفتار جمودت را تر کن؛ کنایه از این‌که کسی که طعم عشق و شور را نچشیده، صلاحیت داوری و نصیحت درباره عشق را ندارد."],[396,"به چشم و ابروی جانان سپرده‌ام دل و جان","بیا بیا و تماشای طاق و منظر کن","دل و جانم را به چشم و ابروی معشوق سپرده‌ام؛ بیا و زیبایی‌های چهره‌ات و مناظر زیبای حول و حوش را تماشا کن."],[396,"ستاره شب هجران نمی‌فشاند نور","به بام قصر برآ و چراغ مه بر کن","در شب دوری از یار، ستاره‌ها نورشان را بر بام قصر نمی‌تابانند، بنابراین ای محبوب، به آسمان برو و نور مه را روشن کن."],[396,"بگو به خازن جنت که خاک این مجلس","به تحفه بر سوی فردوس و عود مجمر کن","به خازن بهشت بگو که خاک این محفل را به عنوان هدیه به سوی بهشت بفرستد و عطر خوش عود را در جاهای مختلف بپاشد."],[396,"از این مزوجه و خرقه نیک در تنگم","به یک کرشمه صوفی‌وشم قلندر کن","به خاطر خوش‌صحبتی و رفتار دلنشین و زیبا از دنیای مادی و ظاهری خود (که در اینجا مزوجه و خرقه symbolize می‌کند) عبور کرده و با یک ناز و کرشمه، مرا به مقام و حالتی برسان که شبیه به حال و هوای یک صوفی یا عارف رهاشده (قلندر) باشم."],[396,"چو شاهدان چمن زیردست حسن تواند","کرشمه بر سمن و جلوه بر صنوبر کن","چون معشوقان باغ زیبا زیر دست تو هستند، با ناز و طنازی بر گل‌ها و زیبایی‌ها جلوه‌گری کن."],[396,"فضول نفس حکایت بسی کند ساقی","تو کار خود مده از دست و می به ساغر کن","نفس انسان حرف‌های بیهوده‌ای می‌زند، اما ای ساقی، کار خود را رها نکن و شراب را در جام بریز."],[396,"حجاب دیده ادراک شد شعاع جمال","بیا و خرگه خورشید را منور کن","چشمان من مانع درک زیبایی‌های تو شده است، بیا و خورشید را که رمز روشنی و زیبایی است، روشن کن."],[396,"طمع به قند وصال تو حد ما نبود","حوالتم به لب لعل همچو شکر کن","آرزو و امید من برای رسیدن به شیرینی وصال تو بیشتر از حد و مرز نیست، پس خواهش می‌کنم لب لعل تو را مانند شکر تسلیم من کن."],[396,"لب پیاله ببوس آنگهی به مستان ده","بدین دقیقه دماغ معاشران تر کن","لب پیاله را ببوس و سپس به مستان ارائه بده، تا در این لحظه لذت، حالت و روحیه دوستان را شادتر کنی."],[396,"پس از ملازمت عیش و عشق مه‌رویان","ز کارها که کنی شعر حافظ از بر کن","وقتی که در کنار لذت و عشق به زیبایانی که مانند ماه هستند وقت می‌گذرانی، باید فراموش کنی که چه کارهایی انجام می‌دهی؛ به یاد داشته باش که شعر حافظ را حفظ کنی."],[397,"ای نور چشم من سخنی هست گوش کن","چون ساغرت پر است بنوشان و نوش کن","ای روشنی چشم من، یک حرفی هست که باید توجه کنی؛ چون لیوانت پر از شراب است، بیفشان و بنوش."],[397,"در راه عشق وسوسه اهرمن بسیست","پیش آی و گوش دل به پیام سروش کن","در مسیر عشق، وسوسه و فریب‌های شیطانی بسیار وجود دارد؛ پس به جلو بیا و دل خود را به شنیدن پیام ملایم و الهام‌بخش فرشتگان آماده کن."],[397,"برگ نوا تبه شد و ساز طرب نماند","ای چنگ ناله برکش و ای دف خروش کن","نغمه و شادی از بین رفته و دیگر سازی برای خوشحالی نیست؛ ای چنگ، آواز ناله سر بده و ای دف، سر و صدا کن."],[397,"تسبیح و خرقه لذّت مستی نبخشدت","همّت در این عمل طلب از می‌فروش کن","عمل عبادت و تزکیه (تسبیح و خرقه) نمی‌تواند تو را به لذت و مستی برساند؛ پس در این کار، از کسی که دارای معرفت و عشق واقعی به می‌است (می‌فروش)، یاری بجوی."],[397,"پیران سخن ز تجربه گویند گفتمت","هان ای پسر که پیر شوی پند گوش کن","پیرمردها با تجربه‌های خود می‌گویند، ای پسر، به تو هشدار می‌دهم که زمانی خواهی پیر شد، پس به نصیحت‌ها گوش بده."],[397,"بر هوشمند سلسله ننهاد دست عشق","خواهی که زلف یار کشی ترک هوش کن","اگر می‌خواهی به عشق برسید و به زلف معشوق دست بزنی، باید از هوش و عقل خود بگذری و آن را کنار بگذاری. عشق چیزی فراتر از خرد است و برای رسیدن به آن، باید به جنون آن رو آورد."],[397,"با دوستان مضایقه در عمر و مال نیست","صد جان فدای یار نصیحت نیوش کن","با دوستان هیچ محدودیتی در صرف عمر و مال نیست، پس صد بار جانم را فدای دوست می‌کنم. به حرف نصیحت‌گونه گوش کن."],[397,"ساقی که جامت از می صافی تهی مباد","چشم عنایتی به من دردنوش کن","ساقی، بگذار که جام پر از شراب صاف و خالی نماند و از طرف تو، محبت و توجهی به من داشته باش و زحمات من را از بین نبر."],[397,"سرمست در قبای زرافشان چو بگذری","یک بوسه نذر حافظ پشمینه‌پوش کن","آن روز که خرسند و شاداب از نصیحت حافظ بهره بردی، او را به نیکی یاد کن"],[398,"کرشمه‌ای کن و بازار ساحری بشکن","به غمزه رونق و ناموس سامری بشکن","به زیبایی و طنازی خود جلوه‌ای نشان بده و با اشاره‌ای دل‌ها را به شوق بیاور. با چشمک و ناز خود، زینت و شوکت را به مانند سحر و جادو از بین ببر."],[398,"به باد ده سر و دستار عالمی یعنی","کلاه گوشه به آیین سروری بشکن","به باد بده که کلاه و طرفه‌های خود را به نشانه سلطنت و سروری به حساب نیاورند و بشکن. در واقع، این اشاره به واگذاری و بی‌اعتنایی نسبت به مقام و لباس‌های ظاهری است."],[398,"به زلف گوی که آیین دلبری بگذار","به غمزه گوی که قلب ستمگری بشکن","به موهای زیبا بگو که اصول عاشق شدن را به کار گیرد و به ناز و ادا بگو که دل بی‌رحمی را بشکند."],[398,"برون خرام و ببر گوی خوبی از همه کس","سزای حور بده رونق پری بشکن","به بیرون بیا و از خودت زیبایی و خوبی را به همه نشان بده، جوری که زیبایی حوری‌ها را هم تحت‌الشعاع قرار دهی و رونق جانان را از بین ببری."],[398,"به آهوان نظر شیر آفتاب بگیر","به ابروان دوتا قوس مشتری بشکن","از زیبایی و جلوه دل‌انگیز چشم‌ها و ابروان محبوب سخن می‌گوید و می‌خواهد که با نگاه به آن‌ها، دل را از عشق او سیراب کند و زیبایی‌هایش را نشانه‌گذاری کند. در اینجا، \"شیر آفتاب\" اشاره به زیبایی فوق‌العاده او دارد و \"قوس مشتری\" به قوس ابروانش اشاره می‌کند که دل‌انگیز و جذاب است."],[398,"چو عطرسای شود زلف سنبل از دم باد","تو قیمتش به سر زلف عنبری بشکن","وقتی بادی زلف سنبل مانند عطر پخش کند، ارزشش را با سر زلفی که شبیه عنبر است، بشکن. یعنی زیبایی و طراوت زلف سنبل را با بوی خوش عنبر مقایسه کن و به آن بها بده."],[398,"چو عندلیب فصاحت فروشد ای حافظ","تو قدر او به سخن گفتن دری بشکن","حافظ می‌گوید مانند بلبل که طراوت و شیوایی را با سخن گفتن خود به نمایش می‌گذارد، تو هم ارزش او را در هنر سخنوری بشناس و آن را به ظاهر در بیاور."],[399,"بالابلند عشوه‌گر نقش‌باز من","کوتاه کرد قصّه زهد دراز من","معشوقه‌ی من که بسیار فریبنده و بازیگوش است، باعث شد که داستان زهد و ریاضت طولانی من به سرعت تمام شود و بی‌خود و بی‌فایده شود."],[399,"دیدی دلا که آخر پیری و زهد و علم","با من چه کرد دیده معشوقه‌باز من؟","آیا متوجه شدی که چطور این روحیه ی (دل سپار) من، در نهایت، با وجود تمام سالخوردگی، خودداری از هوس ها و بار دانشی که اندوخته ام، مرا دل باخته و داغ دارم کرد؟"],[399,"می‌ترسم از خرابی ایمان که می‌برد","محراب ابروی تو، حضور نماز من","نگرانم که ایمانم خراب شود، چراکه ابروهای زیبای تو به قدری جذابیت دارند که مرا از یاد نماز و عبادت دور می‌کنند."],[399,"گفتم به دلق زرق بپوشم نشان عشق","غمّاز بود اشک و عیان کرد راز من","گفتم که با کلاهی زریّن نشانه عشق را بپوشانم، اما عشق به طریقی مشخص شد و اشک‌هایم راز دلم را فاش کردند."],[399,"مست است یار و یاد حریفان نمی‌کند","ذکرش به خیر‌، ساقی مسکین‌نواز من","یار مست است و به یاد دوستانش نیست، یادش به خیر، آن یار چون شراب من"],[399,"یا رب کی آن صبا بوزد کز نسیم آن","گردد شمامه کرمش، کارساز من؟","ای خدا، کی آن نسیم صبحگاهی خواهد وزید که با وزش آن، بوی خوش گل‌های کرم برآید و برای من مفید و کمک‌کننده باشد؟"],[399,"نقشی بر آب می‌زنم از گریه، حالیا","تا کی شود قرین حقیقت، مجاز من","از شدت گریه، اثری که به روح و دل من زده می‌شود و به صورت نقش بر آب به جا می‌ماند، نمی‌دانم تا کی باید منتظر بمانم تا این احساس واقعی شود و صرفا خیال من نماند."],[399,"بر خود، چو شمع، خنده‌زنان، گریه می‌کنم","تا با تو سنگ‌دل چه کند سوز و ساز من؟","من همچون شمعی که در حال سوختن است، با لبخند بر چهره در حال گریه‌ام تا ببینم سنگ‌دل تو با آتش عشق و احساسات من چه خواهد کرد."],[399,"زاهد؛ چو از نماز تو کاری نمی‌رود","هم مستی شبانه و راز و نیاز من","ای زاهد، وقتی که از نماز تو فایده‌ای نیست، پس مستی شبانه و راز و نیاز من چه اشکالی دارد؟"],[399,"«حافظ»، ز گریه سوخت بگو حالش ای صبا","با شاه دوست‌پرور دشمن‌گداز من","حافظ به صبا (نسیم) می‌گوید حالش را بگوید؛ او از شدت گریه سوخته و به یاد شاهی است که دوست‌پرور و دشمن‌گداز است، به این معنا که او حامی دوستانش است و دشمنانش را خوار می‌کند."],[400,"چون شوم خاک رهش دامن بیفشاند ز من","ور بگویم دل بگردان رو بگرداند ز من","اگر روزی دمی به جایی برسم که به خاک پای او بیفتم، او به راحتی دامنش را از من کنار خواهد زد و اگر از او بخواهم که دلش را از من برگرداند، همین کار را خواهد کرد."],[400,"روی رنگین را به هر کس می‌نماید همچو گل","ور بگویم بازپوشان بازپوشاند ز من","روی زیبا و دل‌فریب او همچون گل به هر کسی نشان داده می‌شود، اما اگر بخواهم او را از دیگران پنهان کنم، او نیز مرا از خود دور می‌کند و خود را می‌پوشاند."],[400,"چشم خود را گفتم آخر یک نظر سیرش ببین","گفت می‌خواهی مگر تا جوی خون راند ز من؟","به کسی که به او اشاره می‌کند، می‌گوید که می‌خواسته یک نظر به چشمانش بیندازد. او پاسخ می‌دهد که آیا واقعا می‌خواهد این کار را بکند، چون ممکن است به نتایجی خطرناک و آسیب‌زننده (مانند جاری شدن خون) منجر شود."],[400,"او به خونم تشنه و من بر لبش تا چون شود","کام بستانم از او یا داد بستاند ز من","دوست من به خون من تشنه است و من در آستان او هستم تا ببینم آیا می‌توانم از محبت او بهره‌مند شوم یا او خواسته‌ام را مستجاب کند و در عوض چیزی به من بدهد."],[400,"گر چو فرهادم به تلخی جان برآید باک نیست","بس حکایت‌های شیرین باز می‌ماند ز من","اگر مثل فرهاد، که به خاطر شیرین جانش را با تلخی فدای عشق کرد، جانم هم به خطر بیفتد، اهمیتی ندارد؛ زیرا باز هم داستان‌های شیرین و خوشایند وجود دارد که از من باقی می‌ماند."],[400,"گر چو شمعش پیش میرم بر غمم خندان شود","ور برنجم خاطر نازک برنجاند ز من","اگر به مانند شمع در کنار او باشم، غم‌های من باعث شادی او خواهد شد، و اگر از او دلگیر شوم، احساس لطیف او رنجیده خاطر می‌شود."],[400,"دوستان جان داده‌ام بهر دهانش بنگرید","کو به چیزی مختصر چون باز می‌ماند ز من","دوستان، جان خود را برای جلب توجه او فدای کرده‌ام. به او نگاه کنید که چقدر مختصر و ساده است، اما من همیشه از رسیدن به او ناامید مانده‌ام."],[400,"صبر کن حافظ که گر زین دست باشد درس غم","عشق در هر گوشه‌ای افسانه‌ای خواند ز من","صبر کن حافظ، چون اگر اینگونه باشد، تو می‌دانی که غم عشق من در هر گوشه‌ای داستانی است که از من روایت می‌شود."],[401,"نکته‌ای دلکش بگویم خال آن مه‌رو ببین","عقل و جان را بسته زنجیر آن گیسو ببین","می‌خواهم نکته‌ای جذاب بگویم، به خال آن دختر زیبای ماهرو نگاه کن. عقل و جان من تحت تأثیر زنجیری است که از گیسوی او آویخته شده."],[401,"عیب دل کردم که وحشی‌وضع و هرجایی مباش","گفت چشم شیرگیر و غنج آن آهو ببین","از دلم عیب گرفتم که این قدر انس ناپذیر و هرجایی نباش. گفت: به چشم‌های شیر گیر و کرشمه‌های آهوانه آن یار بنگر"],[401,"حلقه زلفش تماشاخانه باد صباست","جان صد صاحب‌دل آن جا بسته یک مو ببین","زلف محبوب به مانند یک تماشاخانه است که نسیم صبح در آن در حال وزیدن است و جان‌های بسیاری که دل‌باخته‌اند، تنها به بهانه‌ی یک رشته مو به او وابسته‌اند و در حسرت او هستند."],[401,"عابدان آفتاب از دلبر ما غافل‌اند","ای ملامت‌گو خدا را رو مبین آن رو ببین","عابدان و اهل عبادت که به نور آفتاب توجه دارند، از محبوب من غافل هستند. ای کسی که مرا به خاطر این غفلت ملامت می‌کنی، به خدا قسم، آن چهره را نادیده نگیرید و بنگرید."],[401,"زلف دل‌دزدش صبا را بند بر گردن نهاد","با هواداران ره رو حیله هندو ببین","زلف‌های دل‌ربای محبوب، صبا (نسیم صبح) را به عنوان زنجیری بر گردن خود انداخته است و با یارانش در مسیر عاشقی، فریب‌های عاشقانه‌ی هندوها را مشاهده کن."],[401,"این‌که من در جست‌وجوی او ز خود فارغ شدم","کس ندیده‌ست و نبیند مثلش از هر سو ببین","من در پی یافتن او، از خود بی‌خبر و بی‌نیاز شدم. هیچ‌کس این‌گونه را نه دیده و نه خواهد دید؛ پس در هر جهتی می‌توانی به این موضوع توجه کنی."],[401,"حافظ ار در گوشه محراب می‌نالد رواست","ای نصیحت‌گو خدا را آن خم ابرو ببین","اگر حافظ در گوشه محراب (محلی برای عبادت) می‌نالد و غمگین است، این کارش باصلاحیت است؛ ای نصیحت‌گو، به آن حالت دل‌فریب ابرو نگاه کن که در دل او چه تأثیری دارد."],[401,"از مراد شاه منصور ای فلک سر برمتاب","تیزی شمشیر بنگر قوّت بازو ببین","ای آسمان، از خواسته شاه منصور چشم بر مدار و تیزی و تند بودن شمشیر او را ببین و همچنین به قدرت بازوان او توجه کن."],[402,"شراب لعل‌کش و روی مه‌جبینان بین","خلاف مذهب آنان جمال اینان بین","شراب سرخی که رنگش شبیه به لعل است و چهره‌ی زیبا و درخشان افرادی که پیشانی‌شان خوش‌فرم است را تماشا کن؛ زیبایی این افراد با باورهای دینی دیگران در تعارض است."],[402,"به زیر دلق ملمّع کمندها دارند","درازدستی این کوته‌آستینان بین","کسانی که دلق (لباس) زینتی و رنگین پوشیده‌اند، با کمند (قلاب یا طناب) به کار خود مشغولند و دراز دستی (حرص و طمع) دارند، در حالی که افرادی با آستین‌های کوتاه، به دنیای مادی نمی‌رسند."],[402,"به خرمن دو جهان سر فرونمی‌آرند","دماغ و کبر گدایان و خوشه‌چینان بین","خسّت و تکبّر گدایان و کسانی که در جستجوی خوشی و نعمت هستند موجب نمی‌شود که دمی از سر دو جهان که همان دنیا و آخرت است، سر تسلیم فرود بیاورند."],[402,"بهای نیم کرشمه هزار جان طلبند","نیاز اهل دل و ناز نازنینان بین","عشق و زیبایی که از نظر اهل دل جذاب است، به قدری ارزشمند و نایاب است که هر کسی حاضر است جانش را برای یک نیم نگاه از آن معشوقه بدهد. ناز و خودخواهی معشوقه هم باعث می‌شود این محبت بیشتر بطلبد و سخت‌تر به دست بیاید."],[402,"حقوق صحبت ما را به باد داد و برفت","وفای صحبت یاران و همنشینان بین","دوستی و محبت ما را به سخره گرفت و ترک کرد. وفاداری و صداقت در دوستی‌ها را از یاران و هم‌صحبت‌ها ببین."],[402,"اسیر عشق شدن چاره خلاص من است","ضمیر عاقبت‌اندیش پیش‌بینان بین","گرفتار عشق شدن، راه نجات من است؛ آن کسانی که آینده‌نگر و عاقبت‌اندیش هستند، این حقیقت را متوجه هستند."],[402,"کدورت از دل حافظ ببرد صحبت دوست","صفای همّت پاکان و پاک‌دینان بین","حافظ می‌گوید که صحبت و هم‌نشینی با دوست، غم و تیرگی دل او را برطرف می‌کند. او از طرف دیگر به کسانی اشاره می‌کند که همّت و نیت پاکی دارند و این افراد نیز باید مورد توجه قرار گیرند."],[403,"می‌فکن بر صف رندان نظری بهتر از این","بر در میکده می‌کن گذری بهتر از این","بهتر است نگاهی مهربانانه و دلپذیرتر از این بر رندان (افراد شاد و عیاش) بیندازی و از در میکده (محل نوشیدن شراب) عبور کنی که زیبایی و جذابیت بیشتری از این را دارد."],[403,"در حق من لبت این لطف که می‌فرماید","سخت خوب است ولیکن قدری بهتر از این","لطفی که تو درباره من می‌کنی، گرچه بسیار خوب است، اما با این حال، ارزش و مقدار آن بیشتر از این است."],[403,"آن که فکرش گره از کار جهان بگشاید","گو در این کار بفرما، نظری بهتر از این؟","کسی که می‌تواند با فکر و اندیشه‌اش مشکلات و معضلات جهان را حل کند، آیا تو نمی‌توانی نظری بهتر از این ارائه بدهی؟"],[403,"ناصحم گفت که جز غم چه هنر دارد عشق","برو ای خواجه عاقل هنری بهتر از این؟!","ناصح به من گفت که عشق جز غم هیچ هنری ندارد. برو ای انسان عاقل، آیا هنری بالاتر از این وجود دارد؟"],[403,"دل بدان رود گرامی چه کنم گر ندهم؟","مادر دهر ندارد پسری بهتر از این","اگر عاشق آن فرزند عزیز نشوم، چکار کنم؟ مادر روزگار پسری بهتر از این ندارد!"],[403,"من چو گویم که قدح نوش و لب ساقی بوس","بشنو از من که نگوید دگری بهتر از این","وقتی من می‌گویم که نوشیدنی را بنوش و لب‌های ساقی را ببوس، از من بشنو که هیچ کس دیگر بهتر از این را نمی‌گوید."],[403,"کلک حافظ شکرین میوه نباتی‌ست، بچین","که در این باغ نبینی ثمری بهتر از این","شعر حافظ به میوه‌ای به نام «کلک»، که از شکر درست می‌شود، اشاره دارد و می‌گوید که این میوه بسیار شیرین و خوشمزه است. از نظر او، در این باغ هیچ میوه‌ای بهتر از آن وجود ندارد، پس باید آن را بچینید و از آن لذت ببرید."],[404,"به جان پیر خرابات و حق صحبت او","که نیست در سر من جز هوای خدمت او","من به جان پیر خرابات (پیر عرصه می‌پرستی) و به حق صحبت او، احترام می‌گذارم، زیرا در ذهن من جز عشق و خدمت به او چیزی نیست."],[404,"بهشت اگر چه نه جای گناهکاران است","بیار باده که مستظهرم به همت او","اگرچه بهشت جای گنه‌کاران نیست، اما به من شراب بیاور چون به خاطر اراده او به زندگی ادامه می‌دهم."],[404,"چراغ صاعقه آن سحاب روشن باد","که زد به خرمن ما آتش محبت او","صاعقه، روشن‌ترین چراغ است که از سمت ابر (سحاب) به سوی ما تابیده و باعث آتش‌سوزی در خرمن (محصول) ما شده است. این تصویر نشان‌دهنده عشقی عمیق و پرقدرت است که از جانب او (محبوب) به قلب ما آمده و زندگی ما را تحت تأثیر قرار داده است."],[404,"بر آستانه میخانه گر سری بینی","مزن به پای که معلوم نیست نیت او","اگر به در ورودی میخانه (جای شراب‌خوری) نگاهی بیندازی، نیازی به ایستادن و کوبیدن پا نیست، زیرا نیت (خودش) مشخص نیست و معلوم نیست با چه قصدی آمده است."],[404,"بیا که دوش به مستی سروش عالم غیب","نوید داد که عام است فیض رحمت او","بیا که شب گذشته در حالت مستی، ندا و پیغام آسمانی به من رسید که رحمت او عام و گسترده است."],[404,"مکن به چشم حقارت نگاه در من مست","که نیست معصیت و زهد بی مشیت او","به من مست با دید حقارت نگاه نکن، زیرا گناه و پارسایی (زهد) بدون اراده و فرمان او وجود ندارد."],[404,"نمی‌کند دل من میل زهد و توبه ولی","به نام خواجه بکوشیم و فر دولت او","دل من به زهد و توبه علاقه‌ای ندارد، اما به خاطر خواجه (خدا) تلاش می‌کنیم تا به رحمت و نعمت او دست یابیم."],[404,"مدام خرقه حافظ به باده در گرو است","مگر ز خاک خرابات بود فطرت او","خرقه (ردای زهد) حافظ همواره به خاطر باده در دسترس است، مگر آنکه طبیعت او از خاک خرابات (مکانی که در آن شراب می‌نوشند) باشد."],[405,"گفتا برون شدی به تماشای ماه نو","از ماه ابروان منت شرم باد رو","گفتند تو برای تماشای ماه نو (چهره زیبا) از چهره ابروان من بیرون رفتی، پس باید از این کار شرمنده شوی."],[405,"عمری‌ست تا دلت ز اسیران زلف ماست","غافل ز حفظ جانب یاران خود مشو","مدت زیادی است که دل تو از عشق و اسارت زلف‌های ما بی‌خبر است، پس مراقب باش که به خاطر غافل شدن از بندی‌ها و وابستگی‌های خود نسبت به دوستانت، دچار مشکل نشوی."],[405,"مفروش عطر عقل به هندوی زلف ما","کان‌جا هزار نافه مشکین به نیم‌جو","برای زلف‌های ما، عطر عقل را به هندوستان نفروش، چون در آنجا هزاران بوی خوش مشک را می‌توان با هزینه اندکی به دست آورد."],[405,"تخم وفا و مهر در این کهنه کشته‌زار","آن‌گه عیان شود که بود موسم درو","محبت و وفا در این زمین قدیمی و بی‌ثمر تنها زمانی آشکار خواهد شد که زمان برداشت محصول برسد."],[405,"ساقی بیار باده که رمزی بگویمت","از سرّ‌ اختران کهن‌سیر و ماه نو","ای ساقی، باده‌ای بیاور تا از رازهای ستاره‌های کهن و ماه نو برایم بگویی."],[405,"شکل هلال هر سر مه می‌دهد نشان","از افسر سیامک و ترک کلاه زو","شکل هلالی هر سر ماه، نشان‌دهنده تاجی است که سیامک (پادشاه افسانه‌ای اسطوره‌ای ایران) بر سر دارد و همچنین به کلاه ترک‌ها اشاره دارد. این بیت به زیبایی و روشنی ظاهری ماه و تداعی آن با نمادهای پادشاهی و فرهنگ اشاره می‌کند."],[405,"حافظ جناب پیر مغان مأمن وفاست","درس حدیث عشق بر او خوان و زو شنو","حافظ می‌گوید که آن پیر مغان، پناهگاه وفاداری است و درس‌های عشق را از او بیاموز و از او بشنو."],[406,"مزرع سبز فلک دیدم و داس مه نو","یادم از کشته خویش آمد و هنگام درو","در آسمان، زمین سرسبزی را دیدم و هلال ماه نو به یادم آورد که وقت برداشت محصول خود رسیده است."],[406,"گفتم ای بخت بخفتیدی و خورشید دمید","گفت با این همه از سابقه نومید مشو","گفتم ای عمر گذشتی و فرصت از دست رفت. روز قیامت آمد. گفت با این همه از سبقت و لطف پروردگار نا امید نباش."],[406,"گر روی پاک و مجرد چو مسیحا به فلک","از چراغ تو به خورشید رسد صد پرتو","اگر مانند مسیحا (نبی بزرگوار) پاک و بی‌دغدغه باشی، روشنایی و نورانیتی که از وجود تو می‌تابد، به اندازه‌ای خواهد بود که خورشید نیز تحت تاثیر آن قرار می‌گیرد و صد پرتو از آن ساطع می‌شود."],[406,"تکیه بر اختر شب‌دزد مکن کاین عیار","تاج کاووس ببرد و کمر کیخسرو","به یک امروز و روزگار تکیه نکن، چراکه این دزد به ترفند خود تاج کاووس و کمربند کیخسرو را ربود."],[406,"گوشوار زر و لعل ار چه گران دارد گوش","دور خوبی گذران است نصیحت بشنو","این نصیحت را همانند گوشواره‌ی ارزشمندی آویزه‌ی گوش کن. هرچند که به گوشت گران می‌آید (مانند گوشواره‌ی‌ طلا و عقیق واقعی که سنگین و مایه‌ی آزار است ولی باز به گوش می‌آویزی) که روز و روزگار خوب نیز هم می‌گذرد."],[406,"چشم بد دور ز خال تو که در عرصه حسن","بیدقی راند که برد از مه و خورشید گرو","چشمان بد از نیکویی تو دور باشد، زیرا خال تو در میدان زیبایی، بازیگری است که برنده آن میدان، ماه و خورشید را به گرو می‌برد."],[406,"آسمان گو مفروش این عظمت کاندر عشق","خرمن مه به جوی خوشه پروین به دو جو","به فلک و آسمان بگو که عظمت تو در برابر شکوه عشق هیچ است‌؛ در بازار عشق‌، خرمن ماه را به یک جو و خوشه پروین را به دو جو نمی‌خرند! (‌«خرمن ماه‌» یا خیمه ماه یعنی هاله‌ای که بر دور ماه در بعضی شب‌ها وقتی که ماه در نهایت درخشش است‌، گرد آید. جو علاوه بر معنی دانه جو، در گذشته مقداری پول ناچیز از جنس مس بوده است.)"],[406,"آتش زهد و ریا خرمن دین خواهد سوخت","حافظ این خرقه پشمینه بینداز و برو","زهد و ریا، مانند آتش، می‌توانند دین و ایمان واقعی را نابود کنند. حافظ به فردی که پوشش پشمینه‌ای (خرقه) به نشانه‌ی زهد بر تن دارد، می‌گوید که آن را کنار بگذارد و به سوی عشق و حقیقت برود."],[407,"ای آفتاب آینه دار جمال تو","مشک سیاه مجمره گردان خال تو","ای آفتاب که زیبایی تو مانند آینه‌ای است که جلوه‌گر ظاهرت است، چهره‌ی تو همچون دودی‌ است که از مشک سیاه به وجود می‌آید و به گردی از خال تو منتشر می‌شود."],[407,"صحن سرای دیده بشستم ولی چه سود","کـ‌این گوشه نیست درخور خیل خیال تو","با اینکه من پلک‌های خود را برای دیدن تصویر تو شستشو کردم، اما چه فایده‌ای دارد؟ زیرا این گوشه چشمم برای تحمل انبوه خیالاتی که از تو دارم، کوچک و ناچیز است."],[407,"در اوج ناز و نعمتی ای پادشاه حسن","یا رب مباد تا به قیامت زوال تو","ای پادشاه زیبایی، در اوج دل‌فریبی و نعمت هستی، امیدوارم که Beauty و جمال تو هرگز تا قیامت نابود نشود."],[407,"مطبوعتر ز نقش تو صورت نبست باز","طغرانویس ابروی مشکین مثال تو","هیچ تصویری زیباتر از چهره تو نیست و هیچ خوشنویسی نمی‌تواند ابروی مشکی تو را به زیبایی ترسیم کند."],[407,"در چین زلفش ای دل مسکین چگونه‌ای","کآشفته گفت باد صبا شرح حال تو","ای دل بیچاره، در زلف‌های چین‌دار او، حال و روزت چگونه است که باد صبا مختصری از مشکلات و احساسات تو را به او می‌رساند؟"],[407,"برخاست بوی گل ز در آشتی درآی","ای نوبهار ما رخ فرخنده فال تو","بوی گل به خاطر آشتی بلند شده است. ای بهار تازه، به درون بیا که چهره‌ی خوش‌یمنی به فال تو مربوط می‌شود."],[407,"تا آسمان ز حلقه به گوشان ما شود","کو عشوه‌ای ز ابروی همچون هلال تو","اگر ما بتوانیم به گردن ما حلقه‌ای بزنیم، آنگاه آسمان هم خاضع و مطیع ما خواهد بود، پس منتظر هستیم تا عشوه‌ای از ابروی زیبای تو، که مانند هلال است، ببینیم."],[407,"تا پیش بخت باز روم تهنیت کنان","کو مژده‌ای ز مقدم عید وصال تو","تا زمانی که بخت خوش با شکوه و احترام در برابر ما ظاهر شود، باید خوشحالی و تبریک بگوییم و خبر خوبی از آمدن عید وصال تو (به معشوق) داشته باشیم."],[407,"این نقطه سیاه که آمد مدار نور","عکسیست در حدیقه بینش ز خال تو","این لکه سیاهی که در زندگی‌ام به وجود آمده، نشانه‌ای از نورانی است که به خاطر زیبایی و جذابیت تو دیده می‌شود. در واقع، زیبایی تو در دل من مانند خالی است که همه توجه و احساسات مرا به خود جلب کرده است."],[407,"در پیش شاه عرض کدامین جفا کنم","شرح نیازمندی خود یا ملال تو","در برابر سلطان چه بی‌عدالتی می‌توانم بکنم؟ آیا باید نیازهای خودم را بگویم یا غم و اندوه تو را شرح دهم؟"],[407,"حافظ در این کمند سر سرکشان بسیست","سودای کج مپز که نباشد مجال تو","حافظ در این دام (کمند) از خودبزرگ‌نمایی‌های سرکشان و طعنه‌زنان صحبت می‌کند و می‌گوید که وسوسه‌ها و آرزوهای نادرست را دنبال نکن، زیرا مجال و فرصتی برای تو نخواهد بود."],[408,"ای خونبهای نافه چین خاک راه تو","خورشید سایه‌پرور طرف کلاه تو","ای ارزش جان و خون من که با زیبایی‌ات همچون نافه (گلاب) چینی، راهت را می‌پیمایم، مانند خورشید که سایه را بر طرف کلاه تو قرار می‌دهد."],[408,"نرگس کرشمه می‌برد از حد برون خرام","ای من فدای شیوه چشم سیاه تو","نرگس (گلی که به خاطر زیبایی‌اش معروف است) با ناز و عشوه‌ای فراتر از حد خود، راه می‌رود. ای کاش من فدای روش و طرز نگاه چشم سیاه تو شوم."],[408,"خونم بخور که هیچ ملک با چنان جمال","از دل نیایدش که نویسد گناه تو","من به خاطر عشقت و زیبایی‌ات به سختی و درد دچار شده‌ام، چون هیچ فرشته‌ای نمی‌تواند با چهره زیبا و خیره‌کننده‌ات خطایی در دل بنویسد و تو را گناهکار بشمارد."],[408,"آرام و خواب خلق جهان را سبب تویی","زان شد کنار دیده و دل تکیه‌گاه تو","تو عامل آرامش و خواب مردم جهان هستی، به همین دلیل کنار چشمان من و قلب من، تکیه‌گاه و پناه تو هستی."],[408,"با هر ستاره‌ای سر و کار است هر شبم","از حسرت فروغ رخ همچو ماه تو","هر شب به خاطر حسرت نور صورت تو، به ستاره‌ها نگاه می‌کنم و با آن‌ها ارتباط دارم."],[408,"یاران همنشین همه از هم جدا شدند","ماییم و آستانه دولت پناه تو","دوستان و همراهان همه از یکدیگر دور شده‌اند و اکنون فقط ما مانده‌ایم و در آستانه درگاه و حمایت تو ای پناهی که به ما امید داده‌ای."],[408,"حافظ طمع مبر ز عنایت که عاقبت","آتش زند به خرمن غم دود آه تو","حافظ، از رحمت و لطف خداوند ناامید مشو، زیرا در نهایت درد و اندوه تو مانند آتشی می‌سوزاند و خرمن غم‌هایت را خواهد زد."],[409,"ای قبای پادشاهی، راست بر بالای تو","زینت تاج و نگین از گوهر والای تو","ای لباس سلطنت، واقعا بر فراز تو زیبایی تاج و نگین از سنگ‌های قیمتی و باارزش تو است."],[409,"آفتاب فتح را هر دم طلوعی می‌دهد","از کلاه خسروی رخسار مه‌سیمای تو","هر لحظه آفتاب پیروزی از سر تو که مانند یک پادشاه است، می‌تابد و زیبایی چهره‌ات را درخشنده‌تر می‌کند."],[409,"جلوه‌گاه طایر اقبال باشد هر کجا","سایه‌ اندازد همای چتر گردون‌سای تو","هر جایی که سایه همای چتر گردون (عالم هستی) بگسترد، آنجا جایگاه طایر اقبال و خوشبختی است. به عبارت دیگر، هر جا تو (به عنوان نشانه‌ای از نعمت و خوشبختی) باشید، آنجا محلی برای موفقیت و شایستگی خواهد بود."],[409,"از رسوم شرع و حکمت با هزاران اختلاف","نکته‌ای هرگز نشد فوت از دل دانای تو","با وجود اختلافات زیاد در مسائل دینی و فلسفی، هیچ نکته‌ای از ذهن و فهم عمیق تو، که دانای بزرگ هستی، دور نمانده است."],[409,"آب حیوانش ز منقار بلاغت می‌چکد","طوطی خوش‌لهجه یعنی کلک شکّرخای تو","طوطی خوش‌صدا که نماینده‌ای از بلاغت و بیان زیباست، از منقار خود آب حیات می‌چکاند که به معنای زیبایی و لطافت شیوایی کلام توست. کلک شکّرخای تو به نوعی به بیان زیبا و فریبنده‌ات اشاره دارد."],[409,"گرچه خورشید فلک چشم و چراغ عالم است","روشنایی‌بخش چشم اوست خاک پای تو","هرچند خورشید در آسمان منبع نور و روشنایی جهان است، اما نور و روشنی واقعی از چشمان تو است که مانند خاک پای توست."],[409,"آن چه اسکندر طلب کرد و ندادش روزگار","جرعه‌ای بود از زلال جام جان‌افزای تو","اسکندر، پادشاه بزرگ و فاتح، در جستجوی قدرت و دارایی‌های فراوان بود، اما آنچه او در نهایت نتوانست به دست آورد، تنها یک قطره از آب زلال و زندگی‌بخش وجود توست، که نشان‌دهنده ارزش و اهمیت واقعی تو است."],[409,"عرض حاجت در حریم حضرتت محتاج نیست","راز کس مخفی نماند با فروغ رای تو","در پیشگاه تو نیازی به بیان خواسته‌ها نیست، زیرا هیچ رازی با روشنایی عقل و فکر تو پنهان نخواهد ماند."],[409,"خسروا ! پیرانه‌سر، حافظ جوانی می‌کند","بر امید عفو جان‌بخش گنه‌فرسای تو","ای پادشاه! در سن پیری، حافظ هنوز به یاد جوانی است و امیدوار است که تو با بخشش جان‌بخش خود گناهان او را ببخشی."],[410,"تاب بنفشه می‌دهد طرّه مشک‌سای تو","پرده غنچه می‌درد خنده دلگشای تو","حافظ در این بیت با زبانی نمادین به زیبایی مطلق معشوق اشاره می‌کند. «طره مشک‌سای» نمادی از زلف الهی است که مشک را شرمنده می‌کند، یعنی بوی خوشش از هر عطر طبیعی برتر است. «خنده دلگشا» نماد تجلیات جمال الهی است که همچون نوری، حجاب‌های طبیعت (پرده غنچه) را می‌درد. این بیت آغازی‌ست بر شهود جمال محبوب حقیقی."],[410,"ای گل خوش‌نسیم من بلبل خویش را مسوز","کز سر صدق می‌کند شب همه شب دعای تو","«بلبل» نماینده سالک عاشق است و «گل خوش‌نسیم» اشاره به ذات محبوب است که به جهان حیات و طراوت می‌بخشد. حافظ خود را این بلبل می‌داند و از معشوق می‌خواهد که این عاشق صادق را که با صدق و خلوص در شب‌های تاریک به دعا و مناجات مشغول است، نسوزاند. این اشاره‌ای‌ست به مرحله توبه و انابه در سلوک، جایی که سالک با اخلاص کامل رو به معشوق دارد."],[410,"من که ملول گشتمی از نفس فرشتگان","قال و مقال عالمی می‌کشم از برای تو","حافظ می‌گوید حتی از «نفس فرشتگان» که نماد پاکی و عاری بودن از شهوت‌اند، خسته شده‌ام، و اکنون «قال و مقال» یعنی کشمکش‌های عاشقانه و دنیایی را تنها برای تو، ای معشوق الهی، تحمل می‌کنم. این نشانگر عبور از مقام ملکوت به جبروت است؛ همان‌جا که عارف برای قرب به حق، از خلوت فرشتگان نیز می‌گذرد و به میان آتش و خون عاشقی می‌زند."],[410,"دولت عشق بین که چون از سر فقر و افتخار","گوشه تاج سلطنت می‌شکند گدای تو","این بیت، فقر عاشقانه را از سلطنت دنیوی بالاتر می‌داند، و گدای عاشق را بر تخت عزت می‌نشاند."],[410,"خرقه زهد و جام می گرچه نه درخور همند","این همه نقش می‌زنم از جهت رضای تو","حافظ به ظاهر متناقض «زهد» و «می» اشاره می‌کند؛ اما در عرفان، «می» نماد شور و جذبه الهی‌ست، و «زهد» نماد تلاش انسان برای کنترل نفس. حافظ می‌گوید اگرچه این دو در ظاهر سازگار نیستند، اما من همه این بازی‌ها را برای رضایت تو – یعنی محبوب حقیقی – انجام می‌دهم. این همان جمع اضداد است که در عرفان اسلامی جایگاه بلندی دارد."],[410,"شور شراب عشق تو آن نفسم رود ز سر","کاین سر پر هوس شود خاک در سرای تو","زمانی این شور عشق و عاشقی تو از سر من بیرون خواهد رفت که من بمیرم و سر پر از هوی و هوس من تبدیل به خاک در خانه تو شود"],[410,"شاه‌نشین چشم من تکیه‌گه خیال توست","جای دعاست شاه من بی‌تو مباد جای تو","چشم من محل نشستن خیال تو است و در آنجا نیز دعا می‌شود. خدا نکند که من بدون تو باشم، ای شاه من!"],[410,"خوش چمنیست عارضت خاصه که در بهار حسن","حافظ خوش‌کلام شد مرغ سخن‌سرای تو","چهره زیبای تو مانند باغی خوشبو و دلنشین است، به‌ویژه در ایام بهار که حافظ، شاعر خوش‌زبان، به شیوایی از زیبایی‌ها و سخن‌سرایی تو سخن می‌گوید."],[411,"مرا چشمی‌ست خون‌افشان ز دست آن کمان‌ابرو","جهان بس فتنه خواهد دید از آن چشم و از آن ابرو","از دست آن محبوبی که ابرویی همچون کمان دارد، چشمانم اشک خونین می‌بارد؛ مردم دنیا نیز از دست آن چشم و ابرو بلاهای بسیاری خواهند دید."],[411,"غلام چشم آن ترکم که در خواب خوش مستی","نگارین گلشنش روی است و مشکین سایبان ابرو","من بنده‌ی چشم آن زیبارویی هستم که در خواب ناز مستی، چهره‌ای چون باغ پر نقش و نگار دارد و ابرویی همچون سایبانی سیاه که بر روی آن باغ قرار گرفته است."],[411,"هلالی شد تنم زین غم که با طغرا‌ی ابرو‌یش","که باشد مه که بنماید ز طاق آسمان ابرو؟","به سبب این غصه تنم همچون ماه خمیده و نحیف شد، که با وجود ابروی هلالی یار من، ماه چگونه جرات می‌کند که از طاق آسمان ابرو نشان دهد و جلوه‌گری کند؟"],[411,"رقیبان غافل و ما را از آن چشم و جبین هر دم","هزاران گونه پیغام است و حاجب در میان، ابرو","رقیبان و نگهبانان یار بی‌خبرند که از چشم و پیشانی معشوق هر لحظه هزاران گونه پیغام به ما می‌رسد و ابرو همچون پرده‌داری در این میان است."],[411,"روان گوشه‌گیران را جبینش طرفه گلزار‌ی‌ست","که بر طرف سمن‌زارش همی گردد چمان ابرو","پیشانی معشوق برای روح و جان گوشه‌نشینان مانند گل‌زاری شگفت و زیباست که در کنار صورت سفید همچون سمن‌زارش، ابروان کمانی زیبای او در حال خرامیدن و عشوه‌گری هستند."],[411,"دگر حور و پری را کس نگوید با چنین حسنی","که این را این چنین چشم است و آن را آن چنان ابرو","بعد از دیدن زیبایی معشوق من، دیگر هیچ‌کس از زیبایی حور و پری صحبت نخواهد کرد و نخواهد گفت که حوریان چشمانی سیاه و زیبا دارند و پریان ابروان آن چنانی.(رونق بازار حور و پری از بین خواهد رفت)."],[411,"تو کافر‌دل نمی‌بندی نقاب زلف و می‌ترسم","که محرابم بگرداند خم آن دل‌ستان ابرو","تو ای معشوق سنگ‌دل و بی‌رحم، نقاب گیسوی زیبای خود را بر چهره‌ات نمی‌اندازی و می‌ترسم که ابروی کمانی زیبای تو، محراب من را تغییر دهد."],[411,"اگر چه مرغ زیرک بود حافظ در هوادار‌ی","به تیر غمزه صیدش کرد چشم آن کمان‌ابرو","هر چند حافظ در عاشقی و خاطرخواهی چونان پرنده‌ای زیرک رفتار می‌کرد اما، چشم دل‌فریب آن معشوق کمان ابرو با تیر ناز و عشوه او را شکار کرد."],[412,"خط عذار یار که بگرفت ماه از او","خوش حلقه‌ای‌ست لیک به در نیست راه از او","خط زیبای صورت یار که ماه از آن الهام گرفته، مانند یک حلقه زیباست؛ اما به نظر می‌رسد نمی‌توان از آن گریخت."],[412,"ابروی دوست گوشه محراب دولت است","آن جا بمال چهره و حاجت بخواه از او","ابروی محبوب، مانند گوشه‌ای از معبد قدرت و کمال است؛ در آنجا با زیبایی و وقار خود طلب آرزوهایت را از او کن."],[412,"ای جرعه‌نوش مجلس جم! سینه پاک دار","کآیینه‌ای‌ست جام جهان‌بین که آه از او","ای کسی که در مجلس جم، شراب را می‌نوشی! دل خود را پاک نگه‌دار، زیرا سینه‌ات مانند آیینه‌ای است که جهان را می‌بیند و عواقب ناگفته‌ای در دل دارد."],[412,"کردار اهل صومعه‌ام کرد می‌پرست","این دود بین که نامه من شد سیاه از او","رفتار و کردار اهل خانقاه (صومعه) باعث شده که من به می‌پرستی روی آورم. این دود را ببین که نامه من را از گناه و سیاهی پر کرده است."],[412,"سلطان غم هر آن چه تواند بگو بکن","من برده‌ام به باده‌فروشان پناه از او","غم، مانند یک پادشاه، هر چه بتواند بر زبان می‌آورد و انجام می‌دهد، اما من از دست او به باده‌فروشان پناه آورده‌ام."],[412,"ساقی چراغ می به ره آفتاب دار","گو بر فروز مشعله صبحگاه از او","ای ساقی، نور شراب را مانند آفتاب بر سر راه قرار بده تا صبحگاه، شمع روشنی را از او برافروخته کند."],[412,"آبی به روزنامه اعمال ما فشان","باشد توان سترد حروف گناه از او","باید در اعمال ما نمادی از نیکی و آب پاکی بریزند تا بتوانیم نشانه‌های گناه را از بین ببریم."],[412,"حافظ که ساز مطرب عشاق ساز کرد","خالی مباد عرصه این بزمگاه از او","حافظ به شاعرانه اشاره می‌کند که او با موسیقی و ساز خود، دل‌های عاشقان را نوازش می‌کند و امیدوار است که این مجلس عشق هرگز از وجود او خالی نماند."],[412,"آیا در این خیال که دارد گدای شهر","روزی بود که یاد کند پادشاه از او؟","آیا زمانی بود که گدای شهر به یاد پادشاه بیفتد؟"],[413,"گلبن عیش می‌دمد ساقی گل‌عذار کو؟","باد بهار می‌وزد باده خوش‌گوار کو؟","باغ گلستان شادی باز می‌شود، ای ساقی، دختر زیبایی کجاست؟ نسیم بهار می‌وزد، شراب خوشمزه کجاست؟"],[413,"هر گل نو ز گل‌رخی یاد همی کند ولی","گوش سخن‌شنو کجا؟ دیده اعتبار کو؟","هر گل تازه‌ای از زیبایی محبوب یاد می‌کند، اما کجاست گوش شنوا که این را بشنود؟ کجاست آن چشم با اعتبار که به این زیبایی‌ها توجه کند؟"],[413,"مجلس بزم عیش را غالیه مراد نیست","ای دم صبح خوش‌نفس نافه زلف یار کو؟","در این بیت، سخن از این است که جمع شادمانی و خوشی، برای من به آرزویم نمی‌رسد و نمی‌توانم از آن لذت ببرم. ای صبح خوشبو، کجا است عطر و رایحه زلف یار من؟"],[413,"حسن‌فروشی گلم نیست تحمل ای صبا","دست زدم به خون دل بهر خدا نگار کو؟","نسیم صبا، حسن و زیبایی را به من نمی‌فروشد که من آن را تحمل کنم. به خاطر خدا، من با دلی پر از غم به زیبایی‌ام دست زدم؛ حالا محبوب من کجاست؟"],[413,"شمع سحرگهی اگر لاف ز عارض تو زد","خصم زبان دراز شد خنجر آبدار کو؟","اگر شمع در صبحگاه ستاره‌ایی از زیبایی‌های تو را به دشمن بگوید، پس چرا زبانش به طعنه و کنایه دراز می‌شود و همچنان خنجر آبداری در دستش نیست؟"],[413,"گفت «مگر ز لعل من بوسه نداری آرزو؟»","مردم از این هوس ولی قدرت و اختیار کو؟","معشوق می‌گوید که آیا آرزوی بوسه‌ای از لب‌های من نداری؟ من از این خواسته جدا نگران و دل‌مرده‌ام، اما قدرت و اختیار بر برآوردن این آرزو در دستم نیست."],[413,"حافظ اگر چه در سخن خازن گنج حکمت است","از غم روزگار دون، طبع سخن‌گزار کو؟","حافظ می‌گوید با اینکه او از کلمات حکمت‌آمیز و ارزشمندی برخوردار است، اما در میانه غم و مشکلات روزگار پست، جایی برای سخن گفتن و استعدادی برای بیان احساساتش نمی‌یابد."],[414,"ای پیک راستان خبر یار ما بگو","احوال گل به بلبل دستان‌سرا بگو","ای فرستاده راستگو، خبر یار ما را به ما برسان و احوال گل را به بلبل داستان‌گو بگو."],[414,"ما محرمان خلوت انسیم غم مخور","با یار آشنا سخن آشنا بگو","ما دوستان نزدیک فضای صمیمیت و دوستی هستیم، نگران نباش. با یار آشنا درباره حرف‌های آشنا صحبت کن."],[414,"بر هم چو می‌زد آن سر زلفین مشک‌بار","با ما سر چه داشت؟ ز بهر خدا بگو","با ما چه کار داشت؟ وقتی که آن سر زلف مشکینش مثل می به هم می‌خورد، هرگز رازی را فدای ما نکند. خواهش می‌کنم به خاطر خدا بگو."],[414,"هر کس که گفت «خاک در دوست توتیاست»","گو «این سخن معاینه در چشم ما بگو»","هرکسی که بگوید \"خاک در دوست مانند توتیا سرمه‌ایست بر چشم\"، به او بگو \"این سخن را بر اساس دیده‌ها و تجربیات ما بگو\"."],[414,"آن کس که منع ما ز خرابات می‌کند","گو «در حضور پیر من این ماجرا بگو»","کسی که ما را از رفتن به میکده و خلاصه لذت‌های دنیوی منع می‌کند، به او بگو که در حضور استاد و پیر من درباره‌ی این موضوع صحبت کن."],[414,"گر دیگرت بر آن در دولت گذر بود","بعد از ادای خدمت و عرض دعا بگو","اگر کسی دیگر غیر از تو در درگاه کسی برای رسیدن به مقام و منصب، در حال عبور باشد، پس از اینکه خدمت او را انجام دادی و دعایی برایش کردی، این ماجرا را به او بگو."],[414,"هر چند ما بدیم تو ما را بدان مگیر","شاهانه ماجرای گناه گدا بگو","با وجود اینکه ما در نظر تو انسان‌های بدی هستیم، تو نباید ما را این‌گونه بشماری، بلکه قهرمانی و عظمت خود را در داستان گناه یک گدا به رخش بکش."],[414,"بر این فقیر، نامه آن محتشم بخوان","با این گدا حکایت آن پادشا بگو","برای این فقیر، نامه آن شخص محترم را بخوان و داستان آن پادشاه را برای این گدا بگو."],[414,"جان‌ها ز دام زلف چو بر خاک می‌فشاند","بر آن غریب ما چه گذشت؟ ای صبا بگو","زلف معشوق جان‌ها را در دام خود اسیر کرده و با خود بر زمین می‌افکند. حالا بگو که بر آن غریب (قدرت یا معشوق) چه گذشته است، ای نسیم."],[414,"جان‌پرور است قصّه ارباب معرفت","رمزی برو بپرس، حدیثی بیا بگو","قصه کسانی که در معرفت و شناخت عمیق هستند، نقشی دل‌انگیز و جان‌پرور دارد. ای صبا، برو از آن‌ها بپرس تا داستانی را برایت بگویند."],[414,"حافظ گرت به مجلس او راه می‌دهند","می نوش و ترک زرق ز بهر خدا بگو","اگر حافظ تو را به مجلس اهل معرفت راه بدهند، از شراب بنوش و به خاطر خدا از ریا و تظاهر دست بکش."],[415,"خنک نسیم معنبر شمامه‌ای دل‌خواه","که در هوای تو برخاست بامداد پگاه","نسیم خوش و معطر مثل شمامۀ خوشبو و دلپذیر که در صبح زود به خاطر تو وزید، بسیار مطبوع و دلنشین است."],[415,"دلیل راه شو ای طایر خجسته‌لقا","که دیده آب شد از شوق خاک آن درگاه","ای پرنده خوشبخت، دلیل و راهنمای من باش، زیرا چشمانم از شوق به خاک درگاه آن محبوب پرآب شده است."],[415,"به یاد شخص نزارم که غرق خون دل است","هلال را ز کنار افق کنید نگاه","به یاد کسی که در غم و درد سوزان غرق شده است، خواهش می‌کنم هلال ماه را از کنار افق ببینید و روشنایی‌اش را به یاد او متوجه سازید."],[415,"منم که بی تو نفس می‌کشم، زهی خجلت","مگر تو عفو کنی ور نه چیست عذر گناه؟","من بدون تو زندگی می‌کنم و این باعث خجالت من است؛ ای کاش تو مرا ببخشی، وگرنه برای گناهم چه توجیهی دارم؟"],[415,"ز دوستان تو آموخت در طریقت مهر","سپیده دم که صبا چاک زد شعار سیاه","سپیده‌دم از عاشقان تو راه عاشقی را آموخت که با دست صبا، پیراهن سیاه خود را چاک زد."],[415,"به عشق روی تو روزی که از جهان بروم","ز تربتم بدمد سرخ‌گل به جای گیاه","زمانی که من از این دنیا می‌روم و به خاک سپرده می‌شوم، عشق به تو باعث می‌شود که از گور من گل‌های سرخ بروید به‌جای گیاهان معمولی."],[415,"مده به خاطر نازک ملالت از من زود","که حافظ تو خود این لحظه گفت «بسم الله»","به خاطر نازک و لطیف خود رنجش راه مده و از من زود مرنج؛ زیرا حافظ و نگهبان تو این لحظه گفت «بسم الله»"],[416,"عیشم مدام است، از لعل دل‌خواه","کارم به کام است، الحمدلله","زندگی‌ام همیشه خوش و شاداب است و از جواهر محبوبم بهره‌مندم، بنابراین کارهایم به خوبی پیش می‌رود و از این وضعیت شکرگزارم."],[416,"ای بخت سرکش! تنگش به بر کش","گه جام زرکش، گه لعل دل‌خواه","ای بخت سرکش! گاهی با ظرف زرین حالم را خوب کن و گاهی با لعل محبوبم."],[416,"ما را به رندی، افسانه کردند","پیران جاهل، شیخان گمراه","پیران نادان و شیخ‌های گمراه، ما را به جوانی و رندی و شادابی تشویق کردند و درباره آن افسانه‌ها از ما سخن گفتند."],[416,"از دست زاهد، کردیم توبه","وز فعل عابد، استغفرالله","از دست زاهد (مقامات روحانی و پرهیزگار) دست کشیدیم و از اعمال عابد (پرستندة سخت‌کوش) توبه کردیم و به خدا پناه بردیم."],[416,"جانا چه گویم شرح فراقت؟","چشمی و صد نم، جانی و صد آه","ای جانا، چه بگویم؟ غم دوری تو را چگونه بیان کنم، چشمانم پر از اشک و صدای دلbreakم پر از آه است."],[416,"کافر مبیناد، این غم که دیده‌ست","از قامتت سرو، از عارضت ماه","کافر نپندارد که این غم و اندوه، به خاطر قامت زیبا و خوش‌فرم تو (که چون سرو است) و چهره‌ات (که چون ماه است) به من رسیده است."],[416,"شوق لبت برد، از یاد حافظ","درس شبانه، ورد سحرگاه","شوق لب‌ های تو باعث شد که حافظ راز و نیاز سحرگاهی و درس خلوت شبانه را از یاد ببرد ."],[417,"گر تیغ بارد در کوی آن ماه","گردن نهادیم الحکم للّه","اگر در کوی آن زیبارو شمشیر ببارد ما گردن بر سر راه آن می‌گذاریم و از آنجا نمی‌رویم تا خدا چه بخواهد."],[417,"آیین تقوا ما نیز دانیم","لیکن چه چاره با بخت گمراه؟","ما هم از اصول تقوا باخبر هستیم، اما چه کنیم با تقدیر"],[417,"ما شیخ و واعظ کمتر شناسیم","یا جام باده یا قصه کوتاه","ما آخوندها و شیخها را نمی‌شناسیم، اگر می‌خواهی با ما همصحبت شوی از شراب صحبت کن یا هیچ حرفی نزن."],[417,"من رند و عاشق در موسم گل","آن گاه توبه، استغفرالله","به من رند و عاشق می‌گویی که وقت بهار و موسم گل توبه کنم؟! دهانت را آب بکش! برای معنی دوم سوالی نمی‌خوانیم: من در بهاران رند و عاشق هستم (می‌شوم) و آن گاه که بهاران تمام می‌شود توبه میکنم و از خدا طلب آمرزش می‌کنم. یعنی من در وقت خوب و مناسب عشق و حال خودم را می‌کنم و بعد که شرایط عوض شد، زاهدانه توبه می‌کنم"],[417,"مهر تو عکسی بر ما نیفکند","آیینه‌رویا! آه از دلت آه","عشق و محبت تو هیچ اثری بر ما نداشته، ای کسی که مانند آینه زیبا هستی! آه از دل خودم، آه!"],[417,"الصبر مرّ و العمر فان","یا لیت شعري حتّام ألقاه","صبر، تلخ و دردناک است و عمر نیز به زودی پایان می‌پذیرد. کاش می‌دانستم تا چه زمانی باید به این وضعیت ادامه دهم."],[417,"حافظ چه نالی گر وصل خواهی","خون بایدت خورد در گاه و بی‌گاه","حافظ! چرا آه و ناله می‌کنی؟ اگر می‌خواهی به آن که عاشقش هستی برسی باید وقت و بی‌وقت زخم بخوری و رنج بکشی. آه و ناله ندارد."],[418,"وصال او ز عمر جاودان به","خداوندا مرا آن ده که آن به","وصال او (معشوقه) از عمر جاودانه بهتر است. خداوندا به من «آن» را بده که من خودم می‌دانم «آن» بهتر است... یا... خداوندا به من آن‌چیزی را عطا کن که تو می‌دانی همان بهتر است... یا ... وصال خداوند از عمر جاودانه بهتر است. خداوندا به من مرگ را ببخش که مرگ بهتر است."],[418,"به شمشیرم زد و با کس نگفتم","که راز دوست از دشمن نهان به","او به من زخم زد و به هیچ‌کس نگفتم که بهتر است راز دوست را از دشمنی پنهان کنی (باز با اینکه زخم بر من زد که کار دشمنان است، همچنان دوست‌تر از خیلی‌ها می‌دانمش)."],[418,"به داغ بندگی مردن بر این در","به جان او که از ملک جهان به","با حسرت بندگی کردن اگر بر این آستانه و درگاه بمیری، به جان او قسم که از پادشاهی بر جهان بهتر است."],[418,"خدا را از طبیب من بپرسید","که آخر کی شود این ناتوان به؟","شما را به خدا قسم می‌دهم، از طبیب من بپرسید که بالأخره کی این ناتوان بهتر خواهد شد؟"],[418,"گلی کآن پایمال سرو ما گشت","بود خاکش ز خون ارغوان به","گلی که زیر پای سرو ما (معشوق و محبوب) خاکسار شد، فکر نکن خاک شد و بی‌مقدار شد، خاکش حتی بهتر از خون ارغوان است."],[418,"به خلدم دعوت ای زاهد! مفرما","که این سیب زنخ، زآن بوستان به","ای زاهد، مرا به بهشت دعوت نکن؛ که این رخساره و زیبایی از تمام آن بوستان بهتر است (نکته گفتنی این است که در معنی کردن شیرینی تناسب و بلاغت شعری انتخاب کردن یک سیب و رها کردن یک باغ از بین می‌رود)."],[418,"دلا! دائم گدای کوی او باش","به حکم آن که دولت جاودان به","ای دل، همیشه از درگاه او طلبکار و نیازمند باش، چرا که او دولتی جاودانه دارد و نعمت و خوشبختی جاودان در انتظار توست."],[418,"جوانا! سر متاب از پند پیران","که رأی پیر از بخت جوان به","ای جوان، از نصیحت‌های پیران سرپیچی نکن. چرا که رأی و نظر پیران از بخت جوانی تو بهتر است."],[418,"شبی می‌گفت چشم کس ندیده‌ست","ز مروارید گوشم در جهان به","شبی کسی به من می‌گفت که چشم هیچکس از مرواید و گوشواره بندگی‌ای که در گوش من است، زیباتر و بهتر ندیده است (شنیدن این نکته را با وجود تاریکی شب هم بسنجید)"],[418,"اگر چه زنده‌رود آب حیات است","ولی شیراز ما از اصفهان به","اگرچه زنده‌رود آب حیات به شمار می‌آید، ولی اجالتا شیراز ما از اصفهان بهتر است."],[418,"سخن اندر دهان دوست شکّر","ولیکن گفته حافظ از آن به","سخنی که از دهان دوست شنیده شود مانند شکر است اما گفته حافظ از آن نیز، بهتر."],[419,"ناگهان پرده برانداخته‌ای، یعنی چه؟","مست از خانه برون تاخته‌ای، یعنی چه؟","ناگهان پرده را کنار زده‌ای و خود را نمایش داده‌ای، یعنی چه؟ به‌ناگاه مست و سرمست از خانه خارج شده‌ای، یعنی چه؟"],[419,"زلف در دست صبا، گوش به فرمان رقیب","این چنین با همه درساخته‌ای، یعنی چه؟","تو با زلفتان در دست باد صبا به رقیب (کسیکه با او رقابت می‌کند) گوش داده و به طرز عجیبی با همه چیز تطبیق داده‌ای."],[419,"شاه خوبانی و منظور گدایان شده‌ای","قدر این مرتبه نشناخته‌ای، یعنی چه؟","ای محبوب و شاه زیبایان، تو به‌قدری در نظر گدایان و عاشقان ارزشمند شده‌ای که نمی‌دانی چقدر این مقام و منزلت مهم است."],[419,"نه سر زلف خود اول تو به دستم دادی","بازم از پای درانداخته‌ای، یعنی چه؟","تو در ابتدا زلفت را در دست من گذاشتی تا آن را در دست بگیرم، اما اکنون خودت مرا از پای درآورده‌ای و باعث افتادنم کرده‌ای."],[419,"سخنت رمز دهان گفت و کمر سرّ‌ میان","وز میان، تیغ به ما آخته‌ای، یعنی چه؟","سخنان تو رمزهایی هستند که به زبان آورده‌اند و در دل خود اسراری دارند، اما از بابت راز و سرّ میانه ما، تو با رفتار و عمل خود بر ما تیغ زده‌ای و ما را زخمی کرده‌ای."],[419,"هر کس از مهره مهر تو به نقشی مشغول","عاقبت با همه کج باخته‌ای، یعنی چه؟","هر کسی که به خاطر محبت و عشق تو، در پی چیزی می‌گردد، در نهایت سرنوشتی ناخوشایند خواهد داشت و در زندگی به شکست دچار خواهد شد."],[419,"حافظا در دل تنگت چو فرود آمد یار","خانه از غیر نپرداخته‌ای، یعنی چه؟","حافظ می‌گوید وقتی دوست در دل تنگ تو آمده، دیگر نمی‌توانی به هیچ چیز غیر از او فکر کنی و از آن‌ها غافل شده‌ای."],[420,"در سرای مغان رفته بود و آب‌زده","نشسته پیر و صلایی به شیخ و شاب زده","درب منزل پیر روحانی آب و جاروب کرده بود و به انتظار نشسته بود و دعوتش از پیر و جوانان اهل عشق بود تا در کار شراب و مستی خدمت رساند"],[420,"سبوکشان همه در بندگیش بسته کمر","ولی ز ترک کله چتر بر سحاب زده","تمام کسانی که مدعی فهم و درک هستند ، کمر به خدمت این پیر فرزانه بسته اند درحالی که به سبب دست شستن از عقل و عروج و پیوستن به کمال هستی ، بر ابر نیز سایه می افکنند"],[420,"شعاع جام و قدح نور ماه پوشیده","عذار مغ‌بچگان راه آفتاب زده","شعاع‌های حاصل از جام و لیوان مانند نور ماه، صورت زیبا و دلربای بیدمشکان (مغ‌بچگان) را پوشانده و راهی به سمت آفتاب ایجاد کرده است."],[420,"عروس بخت در آن حجله با هزاران ناز","شکسته کسمه و بر برگ گل، گلاب زده","عروس بخت (شانس یا سرنوشت خوب) در آن اتاق (حجله) با ناز و کرشمه بسیار، گیسوانش را باز گذاشته و بر روی برگ گل، گلاب ریخته است."],[420,"گرفته ساغر عشرت فرشته رحمت","ز جرعه بر رخ حور و پری گلاب زده","فرشته‌ای که مظهر رحمت است، جام شادی را گرفته و از شراب به چهره حوری و پری عطر گل زده است."],[420,"ز شور و عربده شاهدان شیرین‌کار","شکر شکسته، سمن ریخته، رباب زده","از هیجان و شلوغی شاهدان خوش‌صفت، شکر را خرد کردند، عطر نارنج و سمن (عطر خاصی) پاشید و موسیقی نواخته شد."],[420,"سلام کردم و با من به روی خندان گفت","که ای خمارکش مفلس شراب‌زده","سلام کردم و او با لبخند و روی خندان به من گفت که ای کسی که شراب‌زده و بی‌پول هستی."],[420,"که این کند که تو کردی به ضعف همت و رای؟","ز گنج‌خانه شده خیمه بر خراب زده","تو چه کسی است که به خاطر ضعف اراده و فکر خود، این کار را کرده‌ است؟ گویی خیمه‌ات را از گنجینه به ویرانه‌ای زده‌ای."],[420,"وصال دولت بیدار ترسمت ندهند","که خفته‌ای تو در آغوش بخت خواب‌زده","از برکت و کامیابی بیدار، ترس دارم که به تو نرسانند؛ زیرا تو در آغوش بختی خفته‌ای که خود به خواب رفته است."],[420,"بیا به میکده حافظ که بر تو عرضه کنم","هزار صف ز دعاهای مستجاب‌ زده","به میکده حافظ بیا که دعای من برای تو، در اینجا هزاران صف از دعاهای مستجاب را به تو نشان می‌دهد."],[420,"فلک جنیبه‌کش شاه نصرت‌الدین است","بیا ببین ملکش دست در رکاب زده","نجوم و سیارات در اینجا به شاه نصرت‌الدین اشاره دارند که در نصرت و پیروزی به او کمک می‌کنند. می‌گوید که بیا و ببین که این پادشاه در حال آماده‌سازی و خود را تجهیز کرده تا در میدان کارزار به پیروزی برسد."],[420,"خرد که ملهم غیب است بهر کسب شرف","ز بام عرش صدش بوسه بر جناب زده","خرد، که از طرف غیب الهام می‌گیرد، برای به‌دست آوردن بزرگی و شرف، صد بار بر جایگاه بلند عرش بوسه می‌زند."],[421,"ای که با سلسله زلف دراز آمده‌ای","فرصتت باد که دیوانه‌نواز آمده‌ای","ای کسی که با موهای بلند به نزد من آمده ای - امیدوارم فرصت و فراغتی داشته باشی که برای نوازش من دیوانه آمده ای"],[421,"ساعتی ناز مفرما و بگردان عادت","چون به پرسیدن ارباب نیاز آمده‌ای","برای ساعاتی عادت ناز کردن خودت را کنار بگذار - چرا که به دلجوئی نیازمندان آمده ای"],[421,"پیش بالای تو میرم چه به صلح و چه به جنگ","چون به هر حال برازنده ناز آمده‌ای","در مقابل قد و بالای تو می میرم چه با صلح و چه با جنگ - چرا که در هر حال شایسته ناز کردن هستی"],[421,"آب و آتش به هم آمیخته‌ای از لب لعل","چشم بد دور که بس شعبده‌باز آمده‌ای","لب های سرخ فام (لعل ماند) تو ماند ترکیبی از آب و آتش است - چشم بد از تو دور باد که مانند شعبده بازان ماهر آمده ای"],[421,"آفرین بر دل نرم تو که از بهر ثواب","کشته غمزه خود را به نماز آمده‌ای","آفرین بر دل نرم خوی تو که به خاطر ثواب الهی - آمده ای بر جنازه کسی که از تیر غمزه تو کشته شده است، نماز بخوانی"],[421,"زهد من با تو چه سنجد که به یغمای دلم","مست و آشفته به خلوتگه راز آمده‌ای","زهد و پارسایی من در برابر تو چه ارزشی دارد؟ تو با حالتی شاداب و گیج‌کننده، دلم را به تسخیر خود درآورده‌ای و به مکان پنهانی از رازها آمده‌ای."],[421,"گفت حافظ دگرت خرقه شراب آلوده‌ست","مگر از مذهب این طایفه باز آمده‌ای","حافظ می‌گوید که تو دیگر پرهیزگار نیستی و پوشش خشک و زاهدانه‌ات به شراب آغشته شده است. آیا ممکن است از سر مذهب این گروه (زاهدان) به این حال درآمده باشی؟"],[422,"دوش رفتم به در میکده خواب‌آلوده","خرقه تر دامن و سجّاده شراب‌آلوده","دیشب دلزده و درمانده، به میخانه رجوع کردم دلزده از اینکه دامن خرقه ی پرهیزگاری ام از فراوانی گناه تر شده و سجّاده ی عبادت ام آلوده به شراب است."],[422,"آمد افسوس‌کنان مغبچه باده‌فروش","گفت بیدار شو ای رهرو خواب‌آلوده","(وقتی با خرقه و سجّاده ی آلوده به میکده رجوع کردم( ساقی گلچهره درحالی که به حال و روز من تاسّف می خورد به استقبالم آمد و از روی دلجویی و دلسوزی گفت: ای سالک و ای رهرو، ای که به ظاهر وانمود به سیر و سلوک می‌کنی امّا در باطن به آن کار دیگر مشغولی از خواب غفلت بیدارشو!! تا کی می خواهی خود و دیگران را بفریبی؟ با خود رو راست باش و تکلیف خویش را معیّن کن. از یک سو ادّعای سیر و سلوک و تهذیب نفس می کنی از سوی دیگر در زیر خرقه چه کار ها که نمی کنی! سجّاده ی زهد بر دوش داری و در آستین خرقه شراب حمل می کنی!"],[422,"شست و شویی کن و آن‌گه به خرابات خرام","تا نگردد ز تو این دیر خراب آلوده","( مغبچه درادامه ی سخن گفت): برای رسیدن به بیداری و آگاهی باید اوّل دل و جانت را از آلودگیها شستشو دهی سپس پاک و بی ریا گام به میکده بگذاری اگر با آلودگیها وارد شوی ممکن است میکده را نیز آلوده کنی."],[422,"به هوای لب شیرین پسران چند کنی","جوهر روح به یاقوت مذاب آلوده","ای خرقه پوش متظاهر، تاکی می خواهی در هوس کامگیری از لبهای نوشین پسران زیبا روی، ذات واصل روح خویش را آلوده کنی؟ روح تو خود الماسی اصیل، حقیقی و گرانبهاست در حالی که لب سرخ پسران (یاشراب آتشین) یاقوت مجازی و فرعیست چرا ازروی هوسرانی، اصل و حقیقت(روح) را که ارزش والایی دارد با جنس فرعی و مجازی که هیچ ارزشی ندارد قرین و هم نشین می کنی و روح خویش را می‌آزاری؟!"],[422,"به طهارت گذران منزل پیری و مکن","خلعت شیب چو تشریف شباب آلوده","(درادامه ی سخن) ..... حال که به دوران کهنسالی رسیده ای سعی کن این خلعتی که از طرف خداوند به تو هدیه شده پاک نگاه داری و پاکیزه زندگی کنی کاری مکن که خلعت پیری هم مانند خلعت جوانی به ناپاکیها آلوده گردد."],[422,"پاک و صافی شو و از چاه طبیعت به در آی","که صفایی ندهد آب تراب‌آلوده","دل و جانت را از آلودگی ها پاک کن صاف و بی غش همچون آب زلال باش که از چاه به در می‌آید خود را از تعلّقات دنیوی آزاد کن که آب گل الود هیچ لطف و صفایی ندارد زلال و بی رنگ و بی ریا می‌باش تا بتوانی علاوه بر خود به پیرامونت نیز طراوت و تازگی و فیض ببخشی."],[422,"گفتم ای جان جهان دفتر گل عیبی نیست","که شود فصل بهار از می ناب آلوده","(در پاسخ به مغبچه ای که مرا سرزنش و نصیحت می کرد) گفتم: ای عزیزتر از همه ی جهانیان، اینها که گفتی و شنیدم درست، امّا ایرادی هم ندارد که در موسم بهار باده ی ناب بنوشی جرعه ای نیز به گلها بپاشی و اوراق گل را با شراب خیس کنی تا طرب انگیزتر و شاداب تر گردند."],[422,"آشنایان ره عشق در این بحر عمیق","غرقه گشتند و نگشتند به آب آلوده","آنها که عشق را می شناسند و در طریق عشق قدم بر می‌دارند با عجایب و شگفتیهای عشق آشنایی دارند آنها به رغم آنکه در دریای بیکران علایق و وابستگیهای دنیوی فرو می روند لیکن به لطف قدرت عشق حتّا به اندازه ی مویی آلوده نمی‌شوند!"],[422,"گفت حافظ لغز و نکته به یاران مفروش","آه از این لطف به انواع عتاب آلوده","مغبچه گفت: ای حافظ ختم کن اینقدر معمّا و نکات معنادار و کنایه آمیز به رخ دوستان خودمکش!حافظ دوباره به کنایه آهی از سر درد می‌کشد(البته به مزاح وشوخی) و می فرماید:سخنانت سرشار از لطایف و ظرایف است فریاد از لطف و محبّت کنایه دار و ملامت بار! امان از لطف و محبّت هایی که به سرزنش های مکدّر کننده آلوده هستند!"],[423,"از من جدا مشو که توام نور دیده‌ای","آرام جان و مونس قلب رمیده‌ای","از من فاصله نگیر چون تو برای من مانند روشنایی چشم هستی و آرامش جان و همدم قلب آشفتگی."],[423,"از دامن تو دست ندارند عاشقان","پیراهن صبوری ایشان دریده‌ای","عاشقان به خاطر تو از دامن (کنار) تو دور شده‌اند، زیرا تو پیراهن صبر و تحمل آن‌ها را چاک زده‌ای و آن‌ها را بی‌تاب کرده‌ای."],[423,"از چشم بخت خویش، مبادت گزند از آنک","در دلبری، به غایت خوبی رسیده‌ای","تسلط بر شانس و سرنوشت خود را فراموش نکن، چرا که تو در هنر عاشقی به بالاترین درجه زیبایی دست یافته‌ای."],[423,"منعم مکن ز عشق وی ای مفتی زمان","معذور دارمت که تو او را ندیده‌ای","ای مفتی زمان، از محبت و عشق او محرومم نکن. تو را معذور می‌دارم چون او را ندیده‌ای و نمی‌دانی چه حالتی دارد."],[423,"آن سرزنش که کرد تو را دوست حافظا","بیش از گلیم خویش مگر پا کشیده‌ای","سرزنش‌هایی که دوست از تو کرده، بیشتر از ظرفیت و توانایی‌ات است. آیا تو از حد خود فراتر رفته‌ای؟"],[424,"دامن‌کشان همی شد در شرب زرکشیده","صد ماهرو ز رشکش جیب قصب دریده","شرب‌: جامه از کتان لطیف‌."],[424,"از تاب آتش می، بر گرد عارضش خوی","چون قطره‌های شبنم بر برگ گل چکیده","از گرمی آتش باده‌، دانه‌های عرق همچون شبنم که بر برگ گل است بر رخسار او بود."],[424,"لفظی فصیح شیرین، قدی بلند چابک","رویی لطیف زیبا، چشمی خوش کشیده","زبانی شیرین و خوش‌سخن و قدی بلند و چابک رو و چشمانی کشیده و صورتی لطیف."],[424,"یاقوت جان‌فزایش از آب لطف زاده","شمشاد خوش‌خرامش در ناز پروریده","یاقوت لبش از آب لطافت و نرمی‌، ساخته شده و بالای خوش‌خرام او همچون شمشادی بود که با ناز بپرورند."],[424,"آن لعل دلکشش بین، وآن خنده دل‌آشوب","وآن رفتن خوشش بین، وآن گام آرمیده","لب دلربای او را ببین و آن خنده عاشق‌کش را و آن راه رفتن زیبا و آن گام‌های باوقارش را."],[424,"آن آهوی سیه‌چشم از دام ما برون شد","یاران چه چاره سازم با این دل رمیده؟","دریغ که به آن آهوی خرامنده سیاه‌چشم نرسیدیم، ای دوستان، با این دل عاشق و رمیده چه کنم؟"],[424,"زنهار تا توانی اهل نظر میآزار","دنیا وفا ندارد ای نور هر دو دیده","زنهار و دوری کن از آنکه اهل نظر را بیازاری؛ دنیا زودگذر و بی‌وفاست ای عزیز جان!"],[424,"تا کی کشم عتیبت؟ از چشم دل‌فریبت","روزی کرشمه‌ای کن، ای یار برگزیده!","عتیب‌: عتاب‌، خشم."],[424,"گر خاطر شریفت رنجیده شد ز حافظ","بازآ که توبه کردیم از گفته و شنیده","اگر خاطر عزیز و محترم تو از حافظ رنجیده گشت؛ باز آ که از هرچه گفتیم و شنیدیم پشیمان شدیم و عذر می‌خواهیم."],[424,"بس شکر بازگویم در بندگی خواجه","گر اوفتد به دستم آن میوه رسیده","باز در خدمت‌گزاری خواجه بسیار شکر خواهم گفت اگر آن میوه رسیده به‌دستم برسد."],[425,"از خون دل نوشتم، نزدیک دوست نامه","«انّی رأیت دهرا، من هجرک القیامه»","نامه‌ای به معشوق خود نوشتم؛ چنان نامه غمزده ای که انگار آن را با خون دل نوشته‌ام [که] من در فراق تو دنیا را چون روز قیامت سخت و طولانی می‌بینم."],[425,"دارم من از فراقش، در دیده صد علامت","لیست دموع عینی، هذا لنا العلامه؟","از دوری معشوق در چشمم صد نشانه و علامت وجود دارد. آیا این اشک های چشم من برای درد فراق، علامتی نیست؟"],[425,"هر چند کآزمودم، از وی نبود سودم","من جرّب المجرّب، حلّت به الندامه","هر چه توانستم او را آزمودم، ولی وصال او ممکن نشد و سودی برایم نداشت. کسی که آزموده را بار دیگر بیازماید، پشیمانی برای او رواست."],[425,"پرسیدم از طبیبی، احوال دوست گفتا","«فی بعدها عذاب، فی قربها السلامه»","از طبیب (انسان دل آگاهی) احوال دوست داشتن (عشق) را سؤال کردم. در پاسخ گفت: اگر تو از او دور باشی، عذاب است و اگر به او نزدیک باشی، برای تو سلامت و آرامش است."],[425,"گفتم «ملامت آید، گر گرد دوست گردم»","و الله ما رأینا، حبا بلا ملامه","گفتم: اگر در اطراف معشوق بگردم، مورد سرزنش و مؤاخذه قرار می گیرم. سوگند به خدا که ما هیچ عشقی را بدون ملامت ندیده‌ایم."],[425,"حافظ چو طالب آمد، جامی به جان شیرین","حتّی یذوق منه، کأسا من الکرامه","حافظ خواهان آن شد که در بهای نوشیدن جام شرابی، جان شیرین خود را فدا کند تا از آن جام، باده ای از کرامت و محبت معشوق بنوشد."],[426,"چراغ روی تو را شمع گشت پروانه","مرا ز حال تو با حال خویش پروا، نه","از نور رخسار تو چنان بر شمع رفت که خود همچون پروانه عاشق تو شد، من در عشقت چنانم که از خود بی‌خبرم."],[426,"خرد که قید مجانین عشق می‌فرمود","به بوی سنبل زلف تو گشت دیوانه","خرد که حکم زنجیر دیوانگان عشق را صادر می‌کرد، خود به عطر خوش زلف تو دیوانه شد. («بوی» معنی آرزو هم می‌دهد؛ در آرزوی رسیدن به زنجیر زلفت، دیوانه گشت.)"],[426,"به بوی زلف تو گر جان به باد رفت‌، چه شد؟","هزار جان گرامی فدای جانانه","در آرزوی وصال زلف تو هر جان که کشته گشت، همه فدای تو باد ای جان‌ جان!"],[426,"من‌ رمیده ز غیرت ز پا فتادم دوش","نگار خویش چو دیدم به دست بیگانه","من رمیده‌غیرت که به هیچ‌کس غیرت نورزیده‌ام وقتی که نگار و محبوب خود را در دست بیگانه دیدم از فرط غیرت و غم از پای در‌افتادم."],[426,"چه نقش‌ها که برانگیختیم و سود نداشت","فسون ما بر او گشته است افسانه","چه ترفند‌ها و حیله‌ها کردیم اما سود نکرد؛ فسون و حیله‌های ما برای او همچون داستانی قدیمی است."],[426,"بر آتش رخ زیبای او به جای سپند","به غیر خال سیاهش که دید به دانه؟","بر رخ پر‌حرارت و گرم او به غیر از خال سیاهش که همچون سپند (او را از چشم بد نگه‌می‌دارد) چه کسی دانه‌ای زیباتر دیده است؟"],[426,"به مژده، جان به صبا داد شمع در نفسی","ز شمع روی تواش چون رسید پروانه","در نفسی‌: در یک آن‌، فورا. پروانه: مجازا به معنی نور و پرتو چراغ و شمع || و نیز به معنی اجازه و برات."],[426,"مرا به دور لب دوست هست پیمانی","که بر زبان نبرم جز حدیث پیمانه","با لب دوست و یار خود پیمان بسته‌ام که جز سخن مستی و عشق‌، چیزی نگویم."],[426,"حدیث مدرسه و خانقه مگوی که باز","فتاد در سر حافظ هوای میخانه","از مدرسه و خانقاه سخن مگو که باز هوای می‌خانه در سر حافظ افتاد."],[427,"سحرگاهان، که مخمور شبانه","گرفتم باده با چنگ و چغانه","چغانه‌: نوعی ساز."],[427,"نهادم عقل را ره ‌توشه از می،","ز شهر هستی‌اش کردم روانه","عقل را غذای سفر و زادراه از باده دادم و او را از شهر هستی بیرون فرستادم."],[427,"نگار می‌فروشم عشوه‌ای داد،","که ایمن گشتم از مکر زمانه","معشوقی که می‌فروش است با ناز و عشوه‌ای سخن گفت و از این رو احساس امنیت کردم و از فریب‌های روزگار در امان ماندم."],[427,"ز ساقی کمان ‌ابرو شنیدم؛","که ای تیر ملامت را نشانه!","ساقی با ابروهای کمانی‌اش به من گفت که ای تیر ملامت، درست به هدف نشانه رفته است."],[427,"نبندی زان میان طرفی، کمروار،","اگر خود را ببینی در میانه","از آن معشوق کمر‌باریک چیزی نصیبت نمی‌شود، اگر خودت را در میانه ببینی."],[427,"برو، این دام بر مرغی دگر نه","که عنقا را بلند است آشیانه!","برو، این تله یا دام را برای پرنده‌ای دیگر بگذار؛ زیرا عنقا، پرنده‌ای افسانه‌ای و بزرگ، آشیانه‌اش در بلندای آسمان است."],[427,"که بندد طرف وصل از حسن شاهی؟","که با خود عشق بازد جاودانه‌؟","چه کسی می‌تواند به وصل و پیوندی از جمال و زیبایی پادشاه (خدا) دست یابد؟ چه کسی می‌تواند با خود عشق را برای همیشه حفظ کند؟"],[427,"ندیم و مطرب و ساقی، همه اوست؛","خیال آب و گل در ره، بهانه","دوستان و نوازندگان و شراب‌فروش همگی او (عشق) است؛ این تصورات از ظواهر و زیبایی‌های جهان مادی تنها یک بهانه برای رسیدن به او هستند."],[427,"بده کشتی می تا خوش برانیم،","از این دریای ناپیداکرانه","بده، یعنی به ما شراب بده تا با استفاده از آن به خوشی و لذت بپردازیم و از این دریاچه عمیق و ناشناخته زندگی عبور کنیم."],[427,"وجود ما معمایی‌ست، حافظ؛","که تحقیقش، فسون است و فسانه","وجود ما، حافظ، مانند معمایی است که برای فهمیدنش باید به جادو و افسانه‌گری روی آورد."],[428,"ساقی بیا که شد قدح لاله پر ز می","طامات تا به چند و خرافات تا به کی؟","ساقی بیا دیگر کاسه وظرف گل لاله پرشد از می تاکی باید درگیر خرافات و حرف های بی محتوا باشیم"],[428,"بگذر ز کبر و ناز که دیده‌ست روزگار","چین قبای قیصر و طرف کلاه کی","دست از خودبینی و لجبازی بردار؛ چون دنیا شاهد تنوع و تغییرات بزرگی است، از جمله قدرت و جلوه‌های زیبایی که به قیصر (امپراتور روم) و کی (نامی از شاهان ایران) تعلق دارد."],[428,"هشیار شو که مرغ چمن مست گشت، هان","بیدار شو که خواب عدم در پی است، هی","بیدار باش و هوشیار شو، زیرا پرنده‌ای که در باغ زندگی می‌کند، مست و سرمست شده است. همچنین، نگران باش که خواب نیستان و عدم در کمین تو است و ممکن است به زودی به سراغت بیاید."],[428,"خوش‌نازکانه می‌چمی ای شاخ نوبهار!","کآشفتگی مبادت از آشوب باد دی","ای شاخ درخت بهاری، با ناز و زیبایی خود می‌رقصی، اما مراقب باش که مبادا از طوفان بادهای زمستانه آسیب ببینی."],[428,"بر مهر چرخ و شیوه او اعتماد نیست","ای وای بر کسی که شد ایمن ز مکر وی","بر گردش روزگار و روش آن نمی‌توان حساب باز کرد، چه تأسف بر کسی که به فریب و نیرنگ آن اطمینان کند."],[428,"فردا شراب کوثر و حور از برای ماست","و امروز نیز ساقی مه‌روی و جام می","فردا برای ما شراب کوثر و حوریان بهشتی فراهم است و اکنون نیز ساقی زیبای ما با جام شراب به ما خدمت می‌کند."],[428,"باد صبا ز عهد صبی یاد می‌دهد","جان‌دارویی که غم ببرد درده ای صبی!","نسیم صبحگاهی یادآوری می‌کند که از دوران نوجوانی، دارویی وجود دارد که می‌تواند غم‌ها و دردها را از بین ببرد، ای نوجوان!"],[428,"حشمت مبین و سلطنت گل، که بسپرد","فراش باد هر ورقش را به زیر پی","فراش‌: فرش‌گستر، جاروب‌کش. پی‌: پا‌."],[428,"درده به یاد حاتم طی جام یک منی","تا نامه سیاه بخیلان کنیم طی","مقدار کمی شراب به یاد حاتم طایی (که فردی سخاوتمند و بخشنده است) بنوشید تا بتوانیم نامه‌های افرادی خسیس و بخیل را با یادآوری سخاوت و آزادگی خود، پاک کنیم."],[428,"زآن می که داد حسن و لطافت به ارغوان","بیرون فکند لطف مزاج از رخش به خوی","از آن شرابی که زیبایی و نرمی آن را به گل ارغوان داده، لطف و خوبی طبع و مزاجش را از چهره‌اش بیرون می‌تابد."],[428,"مسند به باغ بر که به خدمت چو بندگان","استاده است سرو و کمر بسته است نی","در باغ، کسی که مانند خدمتکاران ایستاده و آماده خدمت است، همچون سرو است که کمرش را بسته و خود را به زیبایی آراسته است."],[428,"حافظ حدیث سحرفریب خوشت رسید","تا حد مصر و چین و به اطراف روم و ری","حد‌: مرز‌."],[429,"به صوت بلبل و قمری اگر ننوشی می","علاج کی کنمت؟ آخرالدواء الکی","اگر به صدای بلبل و قمری (پرندگان خوش‌خوان) در این بهار شراب نداشته باشی، چه راهی برای درمان من داری؟ در واقع، آخرین راه درمان من همین شراب است."],[429,"ذخیره‌ای بنه از رنگ و بوی فصل بهار","که می‌رسند ز پی، رهزنان بهمن و دی","در بهار، ذخیره‌ای از زیبایی و خوشبوئی را کنار بگذار، زیرا افرادی که بهمن و دی (زمستان) را نشانه می‌زنند، به زودی برمی‌گردند."],[429,"چو گل نقاب برافکند و مرغ زد هوهو","منه ز دست پیاله، چه می‌کنی؟ هی‌هی","وقتی گل، پرده از چهره برمی‌دارد و پرنده‌ها سر و صدا می‌کنند، پس بی‌دلیل نگران پیاله‌ی می مباش، چه کار داری؟ شاد باش و خوش بگذران."],[429,"شکوه سلطنت و حسن، کی ثباتی داد؟","ز تخت جم سخنی مانده است و افسر کی","عظمت و زیبایی سلطنت و جمال چه کسی دوام و ثباتی به همراه داشته است؟ تنها نام تخت جمشید و افسر کی (کیانیان) باقی مانده است."],[429,"خزینه‌داری میراث‌خوارگان کفر است","به قول مطرب و ساقی، به فتوی دف و نی","خزینه‌داری و ذخیره‌ کردن ثروت، نزد میراث‌خواران و کافران کار پسندیده‌ای نیست. مطرب و ساقی، یعنی کسانی که در مجالس خوش‌گذارانی و جشن‌ها فعالیت دارند، این موضوع را تأیید کرده و با نواختن دف و نی (سازهای موسیقی)، دلیلی برای این ادعا ارائه می‌دهند."],[429,"زمانه هیچ نبخشد که باز نستاند","مجو ز سفله مروّت، که شیئه لا شی","زمانه هیچ‌چیز را نمی‌بخشد و به کسی رحم نمی‌کند، پس از انسان‌های پست و بی‌مروت چیزی نخواه که درستی و ارزش‌هایی داشته باشد."],[429,"نوشته‌اند بر ایوان جنة المأوی","که هر که عشوه دنیی خرید، وای به وی","عشوه دنیی خرید‌: فریب دنیا را خورد."],[429,"سخا نماند، سخن طی کنم، شراب کجاست؟","بده به شادی روح و روان حاتم طی","اگر جوانمردی و سخاوتی نمانده، من می‌خواهم سخن بگویم و از شراب لذت ببرم. پس شراب را بیاورید تا به شادی روح و روان حاتم طایی، که نماد بخشش و جوانمردی است، بنوشیم."],[429,"بخیل، بوی خدا نشنود بیا حافظ","پیاله گیر و کرم ورز، و الضّمان عليّ","بخیل‌ها نمی‌توانند بوی نزدیک شدن به خدا را حس کنند. بیا حافظ، پیاله‌ای بگیر و سخاوت را پیشه کن که من ضمانت این کار را می‌پذیرم."],[430,"لبش می‌بوسم و در می‌کشم می","به آب زندگانی برده‌ام پی","من لب او را می‌بوسم و با هر بار بوسیدن، شرابی می‌نوشم که احساس زندگی را در من زنده کرده است."],[430,"نه رازش می‌توانم گفت با کس","نه کس را می‌توانم دید با وی",": نه می‌توانم رازهای خود را با کسی در میان بگذارم و نه می‌توانم ببینم او کسی را ملاقات میکند ."],[430,"لبش می‌بوسد و خون می‌خورد جام","رخش می‌بیند و گل می‌کند خوی","لب معشوق را می‌بوسد و از این کار به شدت شاد و سرمست می‌شود و وقتی که صورت او را می‌بیند، خوشحالی‌اش دوچندان می‌شود."],[430,"بده جام می و از جم مکن یاد","که می‌داند که جم کی بود و کی کی؟","به من قدحی از شراب بده و دیگر از جم (موسس شراب) یاد نکن، زیرا شراب خود می‌داند که جم چه کسی بود و کیست."],[430,"بزن در پرده چنگ ای ماه مطرب!","رگش بخراش تا بخروشم از وی","مصرع دوم‌: تار و سیم چنگ را بزن و بخراش، تا از آن به جوش و خروش بیایم."],[430,"گل از خلوت به باغ آورد مسند","بساط زهد همچون غنچه کن طی","گل به باغ آمد و نشان از زیبایی و تازگی دارد، پس برای زاهدانی که در خلوت مانده‌اند، به جای سخت‌گیری، باید به شادابی و زندگی خوش‌آمد گفت. به نوعی تا آنجا که ممکن است، در زندگی باید مانند غنچه، خوش و شاداب بود."],[430,"چو چشمش مست را مخمور مگذار","به یاد لعلش ای ساقی بده می","چشم مستش را به خاطر نیاور که مست و سرخوشش نمی‌گذارید. ای ساقی، به یاد رنگ لعل لب او، می را به من بده."],[430,"نجوید جان از آن قالب جدایی","که باشد خون جامش در رگ و پی","روح را از آن جسمی که جدا شده است، جستجو نکن؛ زیرا خون آن می‌، در رگ‌ها و بافت‌های او جاری است."],[430,"زبانت درکش ای حافظ زمانی","حدیث بی‌زبانان بشنو از نی","ای حافظ، زبانت را از حالت بی‌زبانی فرا بگیر و زمانی که با موضوعاتی بی‌زبان صحبت می‌شود، از نی (که نماد بیان احساسات و دردهاست) بشنو."],[431,"مخمور جام عشقم، ساقی بده شرابی","پر کن قدح که بی می، مجلس ندارد آبی","ساقی شراب بیاور که خمارآلود جام عشق هستم (تشنه محبت و توجه یار هستم). جام شراب را پر کن که مجلس بدون شراب، صفایی ندارد."],[431,"وصف رخ چو ماهش، در پرده راست نآید","مطرب بزن نوایی، ساقی بده شرابی","نمی‌توان زیبایی‌های صورت چون قرص ماه یار (معشوق) با در خفا و درگوشی گفتن (با ایما و اشاره گفتن) شرح و توصیف کرد. مطرب آهنگی بزن، ساقی شرابی بیاور [تا مجلس گرم شود و من بتوانم در عالم مستی و بی‌ریایی به توصیف زیبایی‌های یار بپردازم]."],[431,"شد حلقه، قامت من، تا بعد از این رقیبت","زین در دگر نراند، ما را به هیچ بابی","قامت من [از دیدن جفا و بی‌مهری خمیده شده و] به شکل حلقه در [معشوق] چسبیده تا نگاهبان معشوق نتواند مرا از این درگاه جدا کرده و به درگاه دیگری براند."],[431,"در انتظار رویت، ما و امیدواری","در عشوه وصالت، ما و خیال و خوابی","در انتظار دیدار رخسار تو همچنان امیدوار هستیم. در حسرت شیرینی وصال تو، ما [هر شب] در رویاهای خیال‌انگیز فرو می‌رویم."],[431,"مخمور آن دو چشمم، آیا کجاست جامی؟","بیمار آن دو لعلم، آخر کم از جوابی","تشنه دیدارآن دو چشم [فریبنده چون شراب] هستم. جامی از شراب [چشمانت] کجاست تا بنوشم؟ از بس که از آن دو لب زیبا (دهان) جوابی نگرفتم، بیمار و خراب شده‌ام."],[431,"حافظ چه می‌نهی دل، تو در خیال خوبان","کی تشنه سیر گردد، از لمعه سرابی؟","حافظ [تو که می‌دانی که به وصال معشوق پس] چرا دل به خیال و رویای [وصال] خوب‌رویان (معشوقان) می‌دهی! [این مثل این است که بپرسی] کی تشنگی یک انسان تشنه از درخشش (لعمه) یک سراب رفع شده است؟"],[432,"ای که بر ماه از خط مشکین نقاب انداختی","لطف کردی سایه‌ای بر آفتاب انداختی","ای کسی که بر صورت ماه، از خط سیاه خود پوششی قرار دادی، با لطف خود سایه‌ای بر آفتاب افکنده‌ای."],[432,"تا چه خواهد کرد با ما آب و رنگ عارضت","حالیا نیرنگ نقشی خوش بر آب انداختی","به چه کارهای غافلگیرکننده‌ای با ما دست خواهد زد، وقتی که زیبایی صورت تو، مانند رنگ و بوی خوش، حالا پیش روی ما نیرنگی زیبا بر روی آب ایجاد کرده است."],[432,"گوی خوبی بردی از خوبان خلّخ شاد باش","جام کیخسرو طلب، کافراسیاب انداختی","شاد باش که از تمام خوبرویان خلخی، زیباتر هستی؛ جام کیخسروی بر دست بگیر که افراسیاب را شکست‌دادی."],[432,"هرکسی با شمع رخسارت به وجهی عشق باخت","زان میان پروانه را در اضطراب انداختی","هرکسی که به خاطر زیبایی چهره‌ات عاشق شده، به نوعی عشق ورزیده است و از آن میان تو پروانه‌ها را در حال پریشانی و اضطراب قرار داده‌ای."],[432,"گنج عشق خود نهادی در دل ویران ما","سایه دولت بر این کنج خراب انداختی","عشق بزرگ و باارزش خود را در دل خراب و ویران ما گذاشتی و سایه خوشبختی و سعادت را بر این مکان بی‌خود گستراندی."],[432,"زینهار از آب آن عارض که شیران را از آن","تشنه‌لب کردی و گردان را در آب انداختی","مراقب باشید از زیبایی آن چهره، زیرا که همان زیبایی باعث شد شیران (افراد قوی و دلیر) از تشنگی بیفتند و به زمین بیفتند."],[432,"خواب بیداران ببستی وآن گه از نقش خیال","تهمتی بر شب‌روان خیل خواب انداختی","تو خواب بیداران را با خیال‌های خود بستی و سپس با تصاویری که در ذهنت ساخته‌ای، اتهامی به شب‌روان (کسانی که شب را به خواب می‌گذرانند) روا داشتی."],[432,"پرده از رخ برفکندی یک نظر در جلوه‌گاه","وز حیا حور و پری را در حجاب انداختی","تو پرده را از روی خود کنار زدی و با یک نگاه در مکان زیبایی ظاهر شدی و به خاطر شرم، حوریان و پری‌ها را در پوشش و حجاب قرار دادی."],[432,"باده نوش از جام عالم بین که بر اورنگ جم","شاهد مقصود را از رخ نقاب انداختی","شراب بنوش از جامی که به دنیا و زیبایی‌های آن آشنا می‌کند، چون تو با جستجوی زیبایی واقعی، آنچه را که در حقیقت مطلوب است، از پشت پرده پوشش گشود‌ه‌ای."],[432,"از فریب نرگس مخمور و لعل می‌پرست","حافظ خلوت‌نشین را در شراب انداختی","از زیبایی و فریبندگی چشمان نرگس‌مانند و عشق به شراب، حافظ را که در تنهایی می‌زیسته، به مستی و نوشیدن شراب کشاندی."],[432,"وز برای صید دل در گردنم زنجیر زلف","چون کمند خسرو مالک رقاب انداختی","برای به دام انداختن دل من، زنجیری از موهای خود چون کمند خسرو (پادشاه افسانه‌ای) به گردن من انداختی."],[432,"داور داراشکوه‌ ای آن که تاج آفتاب","از سر تعظیم بر خاک جناب انداختی","ای داور داراشکوه، تو که تاج آفتاب به نشانه احترام بر زمین انداختی."],[432,"نصرة الدّین شاه یحیی آن که خصم ملک را","از دم شمشیر چون آتش در آب انداختی","نصیرالدین شاه یحیی، کسی که دشمنان سلطنت را با شمشیر خود به گونه‌ای شکست دادی که گویا آنها را در آب انداختی و آتششان خاموش شد."],[433,"ای دل مباش یک دم خالی ز عشق و مستی","وآنگه برو که رستی از نیستی و هستی","ای دل، هرگز بدون عشق و سرمستی نباش، و زمانی که به این حال دست یافتی، نجات یافته‌ای زیرا که از بودن و نبودن و تعلقات مادی رسته‌ای و رهایی یافته‌ای."],[433,"گر جان به تن ببینی مشغول کار او شو","هر قبله‌ای که بینی بهتر ز خودپرستی","گر جان به تن ببینی مشغول کار او شو زیرا به هر جانبی که روی آوری و به هر‌چه عشق بورزی‌، نکوتر و بهتر از خودپرستی است."],[433,"با ضعف و ناتوانی همچون نسیم خوش باش","بیماری اندر این ره بهتر ز تندرستی","حافظ حرکت نسیم را ضعیف و ناتوان ولی شاد تصور کرده و می گوید:« همچون نسیم در عین ضعف و ناتوانی شادمان و خوش باش زیرا که در راه عشق ناتوانی بهتر از تندرستی و سلامت است»."],[433,"در مذهب طریقت خامی نشان کفر است","آری طریق دولت چالاکی است و چستی","در مذهب سیر و سلوک، ناپختگی نشانه‌ای از بی‌ایمانی است. بله، مسیر دستیابی به موفقیت، نیازمند تیزهوشی و سرعت عمل است."],[433,"تا فضل و عقل بینی بی‌معرفت نشینی","یک نکته‌ات بگویم خود را مبین که رستی","تا وقتی فضل و عقل خود را ببینی و به‌آن مغرور باشی، بی‌معرفت خواهی ماند؛ یک پند به‌تو می‌گویم که تو را نجات خواهد داد «خود را مبین»"],[433,"در آستان جانان از آسمان میندیش","کز اوج سربلندی افتی به خاک پستی","وقتی به آستان یار (و خاک کوی یار) رسیدی از فلک و آسمان میندیش و هراس‌نداشته باش زیرا (در غیر اینصورت) از اوج سربلندی و افتخار بر خاک پستی میفتی."],[433,"خار ارچه جان بکاهد گل عذر آن بخواهد","سهل است تلخی می در جنب ذوق مستی","گر چه خار با آزار و اذیت است، ولی گل از طرف او عذر‌خواهی می‌کند (زیبایی گل‌، تیزی و اذیت خار را محو می‌کند) این مسأله اصلا سخت نیست چون تلخی شراب کنار لذت و شور مستی به راحتی قابل تحمل است."],[433,"صوفی پیاله‌پیما حافظ قرابه‌‌پرهیز","ای کوته‌آستینان تا کی درازدستی؟","آیا صوفی باده‌نوش باشد و حافظ از باده بپرهیزد؟! ای کوته‌آستینان (کنایه از صوفیان) تا کی ظلم و جور می‌کنید و مردم را از آنچه خودتان انجام می‌دهید‌، منع می‌کنید؟"],[434,"با مدّعی مگویید، اسرار عشق و مستی","تا بی‌خبر بمیرد، در درد خودپرستی","با مدعیان؛ از عشق و رازهای آن صحبت نکنید، تا به خاطر خودخواهی و خودپرستی خود از عشق دور بمانند."],[434,"عاشق شو ار نه روزی، کار جهان سرآید","ناخوانده نقش مقصود، از کارگاه هستی","عاشق شو، چون اگر عاشق نشوی، روزی خواهد رسید که کار دنیا به پایان می‌رسد و پیش از کشف هدف و مقصود زندگی‌ات بدون اینکه متوجه شوی، از جهان می‌روی."],[434,"دوش آن صنم چه خوش گفت، در مجلس مغانم","«با کافران چه کارت؟ گر بت نمی‌پرستی»","دیروز آن بت در جمع مغان، چه زیبا گفت: «با کافران چه کار داری اگر بتی را نمی‌پرستی؟»"],[434,"سلطان من خدا را، زلفت شکست ما را","تا کی کند سیاهی، چندین درازدستی؟","ای سلطان من، ترا به خدا سوگند می‌دهم [رحمی کن]، آخر زلف سیاه تو ما (بتان/داشته‌ها) را شکست! تا کی باید شب فراق تو (زلف سیاه، سیاهی) به داشته‌های پندارگونه ما بتازد؟"],[434,"در گوشه سلامت، مستور چون توان بود","تا نرگس تو با ما، گوید رموز مستی","آنجایی که چشم تو، بدون استفاده از کلام، رموز هستی را به ما می‌گوید، چگونه می‌توان در گوشه‌ای خود را پنهان کرد تا در امنیت بود؟"],[434,"آن روز دیده بودم، این فتنه‌ها که برخاست","کز سرکشی، زمانی، با ما نمی‌نشستی","سلطان من، در مراقبه/رویا دیده بودم، همان روز که [با نگاه به چشمانم] فتنه برانگیختی، سرکشی خواهی کرد و با ما همنشین نخواهی شد."],[434,"عشقت، به دست طوفان، خواهد سپرد حافظ","چون برق، از این کشاکش، پنداشتی که جستی","عشق تو حافظ را به دست طوفان خواهد سپرد. حافظا فکر می‌کنی که از این کشاکش می‌توانی بمانند برق بجهی؟"],[435,"آن غالیه‌خط گر سوی ما نامه نوشتی","گردون ورق هستی ما درننوشتی","اگر آن یار خوش خط و خوش بو برای ما نامه ای می‌نوشت ، روزگار هم طومار وجود ما را در هم نمی‌پیچید."],[435,"هر چند که هجران ثمر وصل برآرد","دهقان جهان! کاش که این تخم نکشتی","هرچند که فراق باعث به ثمر رسیدن میوه ی وصال می شود اما ای کاش خالق هستی هیچوقت تخم هجران را در جهان نمی کاشت."],[435,"آمرزش نقد است کسی را که در این جا","یاری‌ست چو حوری و سرایی چو بهشتی","هرکس که در این دنیا یاری به زیبایی حوریان بهشتی و سرایی مانند خانه های بهشتی داشته باشد پیش از آنکه از دنیا برود آمرزیده شده است."],[435,"در مصطبه عشق تنعم نتوان کرد","چون بالش زر نیست، بسازیم به خشتی","ایوان عشق جای تن‌آسانی و راحتی نیست ، اما حالا که بالش نرم و زر بافت نیست با خشت (زیر سر) می سازیم."],[435,"مفروش به باغ ارم و نخوت شداد","یک شیشه می و نوش‌لبی و لب کشتی","به خاطر باغ ارم و تکبر شداد بن عاد (وعده و وعید های زاهدان فریبکار) یک شیشه شراب نقد و یار شیرین لب و کنار کشتزار را از دست مده."],[435,"تا کی غم دنیای دنی ای دل دانا؟","حیف است ز خوبی که شود عاشق زشتی","ای صاحب معرفت تا کی میخواهی غم دنیای پست و زبون را بخوری؟ حیف است که زیبا و پاکی چون تو عاشق و اسیر زشت و ناپاکی مانند دنیا شود."],[435,"آلودگی خرقه، خرابی جهان است","کو راهروی، اهل دلی، پاک‌سرشتی؟","اگر زاهدان و عابدان آلوده شوند، نه تنها خود را بلکه جهانی را آلوده می کنند؛ کجاست راهروی حقیقی؟ کجاست صاحب معرفتی؟ کجاست شخص پاک طینتی؟"],[435,"از دست چرا هشت سر زلف تو حافظ؟","تقدیر چنین بود، چه کردی که نهشتی؟","ای محبوب، حافظ چرا زلف تو را رها کرد و به وصال تو نرسید؟ تقدیر این چنین رقم زد وگرنه چه می توانست بکند اگر رها نمی کرد؟"],[436,"ای قصه بهشت ز کویت حکایتی","شرح جمال حور ز رویت روایتی","ای کسی که بهشت‌، تنها گوشه‌ای از کوچه توست و زیبایی حور بهشت‌‌، فقط چند کلمه از وصف زیبایی توست."],[436,"انفاس عیسی از لب لعلت لطیفه‌ای","آب خضر ز نوش لبانت کنایتی","نفس حیات‌بخش عیسی‌، تنها کمی از سخنانی است که بر لب‌های سرخ تو جاری می‌شود و آب حیات خضر‌، جرعه‌ای از چشمه شیرین لب‌های توست."],[436,"هر پاره از دل من و از غصه قصه‌ای","هر سطری از خصال تو و از رحمت آیتی","هر قسمتی از دل من و داستان غصه‌هایم، هر یک از ویژگی‌های تو و رحمت تو نشانه‌ای از آیات الهی است."],[436,"کی عطرسای مجلس روحانیان شدی؟","گل را اگر نه بوی تو کردی رعایتی","کی به عطر و بوی خوش مجالس روحانیان پیوستی؟ اگر گل در اینجا بوی تو را نداشته باشد، پس چه اهمیتی دارد؟"],[436,"در آرزوی خاک در یار سوختیم","یاد آور ای صبا که نکردی حمایتی","ما در آرزوی خاک یار (معنی دوری از او) سوخته‌ایم و ای صبا (باد صبا)، یادآوری کن که تو هیچ حمایتی از ما نکردی."],[436,"ای دل به هرزه دانش و عمرت به باد رفت","صد مایه داشتی و نکردی کفایتی","ای عزیز، عمر گرانبهای تو و دانایی تو بیهوده تلف شد؛ صد مایه و امکان داشتی اما شایستگی و کفایت نشان ندادی."],[436,"بوی دل کباب من آفاق را گرفت","این آتش درون بکند هم سرایتی","بوی نفسم که مانند کباب در حال سوختن است، همه جا را پر کرده است. این آتش درونم به قدری شدید است که به درون خانه‌ام هم سرایت کرده و بر همه‌چیز تأثیر گذاشته است."],[436,"در آتش ار خیال رخش دست می‌دهد","ساقی بیا که نیست ز دوزخ شکایتی","اگر خیال روی معشوق در آتش دل افروخته من درآید، ساقی بیا، چرا که از جهنم هیچ شکایتی ندارم."],[436,"دانی مراد حافظ از این درد و غصه چیست؟","از تو کرشمه‌ای و ز خسرو عنایتی","حافظ از این درد و غصه که می‌کشد، به این اشاره دارد که اگر تو با کرشمه و زیبایی خود توجهی به او کنی و خسرو (که نماد محبت است) نیز به او لطفی داشته باشد، از این غم رهایی می‌یابد."],[437,"سبت سلمی بصدغیها فؤادي","و روحي کلّ یوم لي ینادي","عارف:(معنی تحت و لفظی)معشوقه «سلمی» با آن دو زلفش، دل من را اسیر کرد و روح من هر روز مرا ندا می‌دهد/(معنای مفهومی),. معشوقه با زلفان خویش دل مرا به اسارت کشید و اکنون روح من هر لحظه مرا به سوی او دعوت می‌کند."],[437,"نگارا بر من بی‌دل ببخشای","و واصلني علی رغم الأعادي","عارف:(معنی تحت لفظی)ای نگارا بر من بی‌دل ببخشای و مرا به وصال برسان علی‌رغم دشمنان./(معنی مفهومی)ای زیبارو، بر این دل بی‌پناه منت بگذار و مرا با وجود دشمنان به وصل خویش رسان"],[437,"حبیبا در غم سودای عشقت","توکّلنا علی ربّ العباد","عارف:(معنی تحت لفظی). ای محبوب در غم سودای عشقت، ما بر خداوند بندگان تکیه کردیم./(معنی مفهومی)ای محبوب عزیز، در غم هجران تو ما تسلیم و توکّل به خدای بندگان کردیم."],[437,"أ من انکرتني عن عشق سلمی","تزاوّل آن روی نهکو بوادی","عارف:(معنی تحت لفظی)آیا کسی که من را از عشق «سلمی» انکار کردی؟ تو از اول، آن رخ نیکو را در بادیه (در صحرا) تظاهر کردی./(معنی مفهومی)آیا تو مرا از عشق «سلمی» انکار کردی؟ از ابتدا روی آن رخ نیکو را در بادیه نمایاندی (ظاهرا به‌ظاهر دوست بودی). به غیر"],[437,"که همچون مت به بوتن دل و ای ره","غریق العشق في بحر الوداد","عارف:(معنی تحت لفظی)ایکه همچون «متّ» در بودن دل و ای راه، غریق عشق در دریاچه‌ی محبت است./(معنی مفهومی). چنان‌که منم در حال غرق‌شدن در عشق، دل همچون قایقی در دریای مهربانی غوطه‌ور است."],[437,"به پی‌ماچان غرامت بسپریمن","غرت یک وی روشتی از اما دی","عارف:(معنی تحت لفظی)به دنبال «ماچان» غرامت می‌سپاریم، اگر تو یک روز (وی = یک بار) بی‌روشی از ما دیدی/(معنی مفهومی) در پی کار «ماچان» (صف کفش‌ کن درویشان) غرامتی می‌دهیم، اگر که یک‌بار عمل ناشایستی از ما سر زد."],[437,"غم این دل بواتت خورد ناچار","و غر نه او بنی آنچت نشادی","عارف:(معنی تحت لفظی)غم این دل باید بر تو وارد شود ناچار، وگرنه او بازبینی آنچه تو را نپسندیدی./(معنی مفهومی)این غم دل ناگزیر باید بر تو وارد شود، وگرنه آنچه شایسته تو نیست، خواهی دید."],[437,"دل حافظ شد اندر چین زلفت","بلیل مظلم و اللّه هادي","عارف:(معنی تحت لفظی)دل حافظ شد در چین زلف تو، همچون شب تاریک، و خدا راهنمای است./(معنی مفهومی)دل حافظ در پیچ‌و‌تاب زلف یار گرفتار آمد، مانند شب ظلمانی، و تنها خدا راهنمای ماست."],[438,"دیدم به خواب دوش که ماهی برآمدی","کز عکس روی او شب هجران سر آمدی","دیشب در خواب دیدم که ماهی (کنایه از معشوق زیبارو) طلوع کرد،که با درخشش چهره‌اش شب هجران پایان یافت."],[438,"تعبیر رفت «یار سفرکرده می‌رسد»","ای کاج هر چه زودتر از در درآمدی","تعبیر خواب این بود که یار سفرکرده بازخواهد گشت،ای کاش هرچه زودتر از در خانه‌ام وارد می‌شدی"],[438,"ذکرش به خیر ساقی فرخنده‌فال من","کز در مدام با قدح و ساغر آمدی","یادش به‌خیر باد آن ساقی خوش‌اقبال منکه همیشه با جام و ساغر شراب وارد می‌شد."],[438,"خوش بودی ار به خواب بدیدی دیار خویش","تا یاد صحبتش سوی ما رهبر آمدی","خوشحال می‌شدیم اگر در خواب دیار خود را می‌دیدی، تا خاطره دیدار او به یاد تو بیفتد و تو را به سوی ما بکشاند."],[438,"فیض ازل به زور و زر ار آمدی به دست","آب خضر نصیبه اسکندر آمدی","اگر فیض الهی از ازل با زور و زر به‌دست می‌آمد،پس آب حیات (آب خضر) باید نصیب اسکندر می‌شد."],[438,"آن عهد یاد باد که از بام و در مرا","هر دم پیام یار و خط دلبر آمدی","یاد آن زمان بخیر که هر لحظه از هر سو پیغام عشق و نوشته‌های معشوق به من می‌رسید."],[438,"کی یافتی رقیب تو چندین مجال ظلم؟","مظلومی ار شبی به در داور آمدی","شما چه زمانی توانستی این همه فرصت ظلم را برای رقیبت فراهم کنی؟ اگر کسی مظلوم باشد، باید ببیند که در شب به دادگری (داور) مراجعه کند."],[438,"خامان ره نرفته چه دانند ذوق عشق","دریادلی بجوی دلیری سرآمدی","آنانی که در این راه خام‌اند، چه می‌دانند از شور و لذت عشق؟دلیر و دریا‌دلی را بجوی که در دلیری بی‌همتا باشد."],[438,"آن کو تو را به سنگ‌دلی کرد رهنمون","ای کاشکی که پاش به سنگی برآمدی","آن کسی که تو را با بی‌رحمی و سنگدلی هدایت کرد، ای کاش که پای او به سنگی برخورد می‌کرد.( و مکافات کارش را می‌دید)"],[438,"گر دیگری به شیوه حافظ زدی رقم","مقبول طبع شاه هنرپرور آمدی","اگر دیگری هم مانند حافظ، سبکی خوشایند و مورد پسند شاه هنرپرور را به کار می‌برد، تو نیز می‌توانستی در نظر او محبوب و مورد توجه قرار بگیری."],[439,"سحر با باد می‌گفتم حدیث آرزومندی","خطاب آمد که «واثق شو، به الطاف خداوندی»","در صبح، با وزش باد درباره آرزوهایم سخن می‌گفتم که ناگهان صدایی شنیدم که گفت: «به لطف‌های خداوند اطمینان داشته باش»."],[439,"دعای صبح و آه شب، کلید گنج مقصود است","بدین راه و روش می‌رو، که با دلدار پیوندی","دعای صبح و آه نیمه شب، کلید گشایش گنج مقصود و رسیدن به هدف است. به همین شیوه برو تا بتوانی به معشوق برسی."],[439,"قلم را آن زبان نبود، که سرّ عشق گوید باز","ورای حدّ تقریر است، شرح آرزومندی","قلم، زبان و بیان راز عشق را ندارد. (نمی‌تواند راز عشق را بیان کند.) شرح عشق و آرزومندی فراتر از این است که به نوشتن درآید."],[439,"الا ای یوسف مصری که کردت سلطنت مغرور!","پدر را باز پرس آخر، کجا شد مهر فرزندی؟","ا‌ی یوسف مصری، که سلطنت و حکومت تو را مغرور و فریفته کرد. آخر از حال پدرت بپرس. مهر و محبت فرزند کجا رفت؟"],[439,"جهان پیر رعنا را، ترحّم در جبلّت نیست","ز مهر او چه می‌پرسی؟ در او همّت چه می‌بندی؟","جبلت: یعنی سیرت و ذات:در ذات جهان پیر ولی جوان نما هیچگونه لطف و ترحمی نیست/////پس برای چه به آن دل می بندی و برای رسیدن به آن تلاش می کنی"],[439,"همایی چون تو عالی‌قدر، حرص استخوان تا کی؟","دریغ آن سایه همّت، که بر نااهل افکندی","همایی عالی‌مقام مثل تو چرا باید کرکس مردارخوار شود؟ حیف است که سایه فر و شکوه و امیدت را بر چیزی حقیر افکنده‌ای."],[439,"در این بازار اگر سودی‌ست، با درویش خرسند است","خدایا منعمم گردان به درویشی و خرسندی","در این مکان، اگر نفعی وجود دارد، خوشحالی درویش هم باعث شادی خداوند است. ای خدا، مرا نیز به درویشی و خرسندی توفیق بده."],[439,"به شعر حافظ شیراز می‌رقصند و می‌نازند","سیه‌چشمان کشمیری و ترکان سمرقندی","سیاه‌چشمان کشمیری و دختران ترک سمرقند به شعر حافظ از شادی می‌رقصند و به خود می‌بالند."],[440,"چه بودی ار دل آن ماه مهربان بودی؟","که حال ما نه چنین بودی ار چنان بودی","اگر دل آن ماه مهربان (دوست) به ما توجه می‌کرد و به ما محبت می‌نمود، وضع‌ و حال ما این‌گونه دردناک و غم‌انگیز نمی‌بود."],[440,"بگفتمی که «چه ارزد نسیم طره دوست؟»","گرم به هر سر مویی هزار جان بودی","گفتم که نسیم موهای دوست چه ارزشی دارد؟ اما می‌بینم که هر strands of hair (سر مو) هزار جان و زندگی را به ما می‌بخشد."],[440,"برات خوش‌دلی ما چه کم شدی یا رب","گرش نشان امان از بد زمان بودی","ای کاش خوش‌دل بودن ما کم نمی‌شد، زیرا اگر خوش‌دلی ما نشان امنی از بدی‌های زمان بود، زندگی‌ام تغییر می‌کرد."],[440,"گرم زمانه سرافراز داشتی و عزیز","سریر عزتم آن خاک آستان بودی","اگر در این زمان ، وضعیت خوشی و احترام داشتم، به طوری که بر بلندای مقام خود نشسته باشم، آستان تو، ای معشوق، زمین پرستیژ من بود."],[440,"ز پرده کاش برون آمدی چو قطره اشک","که بر دو دیده ما حکم او روان بودی","ای کاش تو از پرده پنهانی بیرون می‌آمدی، مانند قطره اشکی که بر چشمان ما می‌ریزد و بر آن تسلط دارد."],[440,"اگر نه دایره عشق راه بربستی","چو نقطه حافظ سرگشته در میان بودی","اگر عشق دایره‌ای نمی‌داشت و راه را نمی‌بست، تو نیز مثل حافظ که در جستجوی عشق گم شده، در میان آن بودی."],[441,"به جان او که گرم دسترس به جان بودی","کمینه پیشکش بندگانش آن بودی","به خاطر او که محبت و دوستی‌اش برای جان آدمی ارزشمند است، کمترین پیشکش بندگانش همین محبت و وفاداری است."],[441,"بگفتمی که «بها چیست خاک پایش را؟»","اگر حیات گران مایه جاودان بودی","حافظ در این بیت می‌گوید که از او پرسیده‌ام قیمت خاک پای محبوب چیست، اگر زندگی ارزشمند و جاودانه بود. این بیان نشان‌دهنده عشق عمیق و انتظاری است که عاشق دارد؛ به گونه‌ای که حتی خاک پای معشوق نیز برایش ارزشمند و گران‌بها می‌شود."],[441,"به بندگی قدش سرو معترف گشتی","گرش چو سوسن آزاده ده زبان بودی","اگر به زیبایی و قامت او (که مانند سرو است) اعتراف کرده‌ام، به این خاطر است که در نزدیکی‌اش مانند سوسن آزاد، توانا در سخن نبودم."],[441,"به خواب نیز نمی‌بینمش چه جای وصال","چو این نبود و ندیدیم باری آن بودی","هرگز او را حتی در خواب هم نمی‌بینم، پس از چه وصالی سخن بگوییم وقتی که هرگز دیداری از او نداشته‌ام؟"],[441,"اگر دلم نشدی پایبند طره او","کی‌اش قرار در این تیره‌خاکدان بودی؟","اگر دل من به محبت و وابستگی به موی او پایبند نشده باشد، پس چه چیزی باعث شده است که در این دنیای تاریک و فانی، آرامش داشته باشد؟"],[441,"به رخ چو مهر فلک بی‌نظیر آفاق است","به دل دریغ که یک ذره مهربان بودی","چهره‌اش مانند ماه بی‌نظیر و زیباست و در دل افسوس می‌خورم که کاش او حتی یک ذره محبت به من داشت."],[441,"درآمدی ز درم کاشکی چو لمعه نور","که بر دو دیده ما حکم او روان بودی","ای کاش تو به خانه‌ام می‌آمدی و مانند شعله نوری می‌درخشیدی که در نظر ما بر همه‌چیز حاکم است."],[441,"ز پرده ناله حافظ برون کی افتادی؟","اگر نه همدم مرغان صبح خوان بودی","حافظ از غزلیاتش می‌گوید که آیا از پرده و حجاب ناله‌هایش (غزل‌هایش) خارج خواهی شد؟ اگر این‌طور نیست، پس نمی‌توانی مانند هم‌نشینان پرندگان صبحگاهی باشی که می‌خوانند."],[442,"چو سرو اگر بخرامی دمی به گلزاری","خورد ز غیرت روی تو هر گلی خاری","اگر تو مانند سرو بخرامی و لحظه‌ای در باغ گل توقف کنی، به خاطر غیرت زیبایی روی تو، هر گلی تبدیل به خار خواهد شد."],[442,"ز کفر زلف تو، هر حلقه‌ای و آشوبی","ز سحر چشم تو، هر گوشه‌ای و بیماری","زلف‌های تو باعث کفر و بی‌دینی من شده است، هر حلقه‌اش برایم آشوب و ناراحتی به همراه دارد. و سحر و جاذبه‌ی چشمان تو باعث شده است که هر نقطه‌ای از نگاهی که به من می‌کنی، بیماری و غم در دل من ایجاد کند."],[442,"مرو چو بخت من ای چشم مست یار به خواب","که در پی است ز هر سویت آه بیداری","ای چشم معشوقه مست من، مانند بخت بد من، به خواب نرو؛ زیرا از هر طرف، صدای ناله و بیداری مرا در پی دارد."],[442,"نثار خاک رهت نقد جان من هر چند","که نیست نقد روان را بر تو مقداری","به پای راه تو جانم را فدای تو می‌کنم، هرچند که هیچ بهایی برای جانم در نزد تو وجود ندارد."],[442,"دلا! همیشه مزن لاف زلف دلبندان","چو تیره‌رأی شوی کی گشایدت کاری؟","ای دل! همیشه از زیبایی زلف معشوقان به طور مبالغه‌آمیز سخن نگو، زیرا وقتی که در موقعیت سخت قرار بگیری، هیچ‌کدام از این ادعاها کمکی به تو نمی‌کند و کارهایت سامان نخواهد گرفت."],[442,"سرم برفت و زمانی به سر نرفت این کار","دلم گرفت و نبودت غم گرفتاری","سرم رفت و مدتی طولانی به سر نرسید؛ این دل من را کارهایش آزار داد و نبودنت غم و اندوه به بار آورد."],[442,"چو نقطه گفتمش «اندر میان دایره آی»","به خنده گفت که «ای حافظ! این چه پرگاری»","وقتی به او گفتم که «در دایره‌ای غمگین وارد شو»، او با خنده پاسخ داد: «ای حافظ! چه سخن بیهوده‌ای می‌گویی!"],[443,"شهری‌ست پر ظریفان وز هر طرف نگاری","یاران! صلای عشق است گر می‌کنید کاری","شهر پر از آدم‌های با ذوق و هنرمند است و از هر سو، زیبارویانی دیده می‌شوند. ای دوستان! اگر می‌خواهید کاری کنید، صدای عشق در اینجا بلند شده است."],[443,"چشم فلک نبیند زین طرفه‌تر جوانی","در دست کس نیفتد زین خوب‌تر نگاری","چشم آسمان، جوانی به زیبایی و جذابیت این‌چنینی را نمی‌بیند و هیچ‌کس به خوش‌چهرگی این نگار (معشوق) نمی‌رسد."],[443,"هرگز که دیده باشد جسمی ز جان مرکّب؟","بر دامنش مبادا زین خاکیان غباری","هرگز دیده نشده که جسمی از روح ترکیب شده باشد. پس نباید بر دامن چنین وجودی، از خاکی‌ها و مادیات غباری وجود داشته باشد."],[443,"چون من شکسته‌ای را از پیش خود چه رانی؟","کم غایت توقع بوسی‌ست یا کناری","چگونه دلت می آید من را که همه وجودم مبتلای درد عشق تو است را نبینی یا از من دور بمانی، من خواسته زیادی از تو ندارم که به یک بوسه یا در کنارم و در آغوشم بودن راضی ام"],[443,"می بی‌غش است دریاب، وقتی خوش است بشتاب","سال دگر که دارد امّید نوبهاری؟","شراب بی‌حقه و خالص را دریاب و از آن استفاده کن، چون زمان شادی و خوشی مناسب است. سال آینده امیدی به بهار نو وجود ندارد، پس از فرصت لذت ببر."],[443,"در بوستان حریفان مانند لاله و گل","هر یک گرفته جامی بر یاد روی یاری","در باغ دوستان، مانند گل و لاله، هر کدام مشغول نوشیدن شرابی هستند که یادآور صورت محبوب‌شان است."],[443,"چون این گره گشایم؟ وین راز چون نمایم؟","دردی و سخت دردی، کاری و صعب کاری","نمی‌دانم چگونه می‌توانم این مشکل را حل کنم و این راز را افشا کنم، زیرا هم این درد بسیار سخت است و هم کاری که باید انجام دهم بسیار دشوار و پیچیده است."],[443,"هر تار موی حافظ در دست زلف شوخی","مشکل توان نشستن در این چنین دیاری","هر تار موی حافظ را چون زلفی بازیگوش در دست دارم، نشستن در این دیار با این همه مشکلات و سختی‌ها برایم دشوار است."],[444,"تو را که هر چه مراد است در جهان داری","چه غم ز حال ضعیفان ناتوان داری؟","تو که تمام خواسته‌های خود را در دنیا داری، چرا نگران حال ضعفا و ناتوانان هستی؟"],[444,"بخواه جان و دل از بنده و روان بستان","که حکم بر سر آزادگان روان داری","خواسته‌ام که جان و دل و روح خود را از من بستانی، چون تو اختیار و فرمان‌فرمایی بر سر آزادگان و انسان‌های آزاد داری."],[444,"میان نداری و دارم عجب که هر ساعت","میان مجمع خوبان کنی میان‌داری","عجب می‌کنم که تو در بین خوبان، رفتار می‌کنی و از هر نظر حاکم بر آنان هستی، در حالی که خودت هیچ ندارد و من نسبت به این موضوع حیرت‌زده‌ام."],[444,"بیاض روی تو را، نیست نقش درخور از آنک","سوادی از خط مشکین بر ارغوان داری","روی سفید تو نقشی ندارد، زیرا تو اشاره‌ای به زیبایی خط سیاه بر روی رنگ ارغوانی داری."],[444,"بنوش می که سبک‌روحی و لطیف مدام","علی الخصوص در آن دم که سر گران داری","از شراب بنوش که روح تو سبک و لطیف می‌شود، به‌ویژه در زمانی که دلگیر و سنگین هستی."],[444,"مکن عتاب از این بیش و جور بر دل ما","مکن هر آن چه توانی که جای آن داری","از این بیشتر به ما خشم و ستم نکن، هرچه که می‌توانی انجام بده، زیرا این کارها برای تو مناسب است."],[444,"به اختیارت اگر صد هزار تیر جفاست","به قصد جان من خسته در کمان داری","اگر تو به اندازه کافی تیر جفا داری که بتوانی به جان من خسته پرتاب کنی، در اختیار توست، و این موضوع نشان‌دهنده عمق درد من است."],[444,"بکش جفای رقیبان مدام و جور حسود","که سهل باشد اگر یار مهربان داری","اگر یار مهربان و دوست واقعی داشته باشی، دیگر جفای رقیبان و ظلم حسود برایت سخت و دردآور نخواهد بود."],[444,"به وصل دوست گرت دست می‌دهد یک دم","برو که هر چه مراد است در جهان داری","اگر در یک لحظه به وصل دوست برسی، باید سریعا بروی، چون هر چیزی که آرزو داری، در همین جهان موجود است."],[444,"چو گل به دامن از این باغ می‌بری حافظ","چه غم ز ناله و فریاد باغبان داری؟","حافظ می‌گوید: وقتی تو مانند گلی از این باغ جدا می‌شوی، چرا باید نگران ناله و فریاد باغبان باشی؟ بی‌اهمیتی به غم او، به لذت و زیبایی خود تأکید می‌کند."],[445,"صبا تو نکهت آن زلف مشک بو داری","به یادگار بمانی که بوی او داری","ای نسیم صبا، تو بوی خوش آن گیسوی سیاه خوشبو را به همراه داری...امیدوارم وزش تو پیوسته برقرار بماند، چرا که نشانه و اثر اورا با خود آورده ای"],[445,"دلم که گوهر اسرار حسن و عشق در اوست","توان به دست تو دادن گرش نکو داری","دل من که دارای رازهای زیبایی و عشق است، اگر تو آن را شایسته بدانی، می‌تواند به تو سپرده شود."],[445,"در آن شمایل مطبوع هیچ نتوان گفت","جز این قدر که رقیبان تندخو داری","در زیبایی ظاهری او هیچ چیزی نمی‌توان گفت جز این که او رقیبان بدخلق و ستیزه‌جویی دارد."],[445,"نوای بلبلت ای گل کجا پسند افتد","که گوش و هوش به مرغان هرزه گو داری","صدای بلبل تو، ای گل، کجا می‌تواند خوشایند باشد در حالی که تو به صحبت‌های بی‌اساس دیگران گوش می‌دهی و حواست به آن‌هاست؟"],[445,"به جرعه تو سرم مست گشت نوشت باد","خود از کدام خم است این که در سبو داری","بعد از نوشیدن جرعه‌ای از او، سرم مست شده است. این حالتی که برایم پیش آمده، از کدام شراب است که در سبوی تو نگه‌داری؟"],[445,"به سرکشی خود ای سرو جویبار مناز","که گر بدو رسی از شرم سر فروداری","ای سرو جویبار، به خاطر خودخواهی و سرکشی‌ات با دیگری دشمنی نکن، زیرا اگر به او برسی، از شرم سر به زیر خواهی انداخت."],[445,"دم از ممالک خوبی چو آفتاب زدن","تو را رسد که غلامان ماه رو داری","وقتی درباره سرزمین‌های زیبا صحبت می‌کنی، همچون آفتاب درخشان ظاهر می‌شوی، زیرا تو با چهره‌های زیبا و دلربا در ارتباطی و به همین خاطر الهام بخش دیگران هستی."],[445,"قبای حسن فروشی تو را برازد و بس","که همچو گل همه آیین رنگ و بو داری","زیبایی و جذابیت تو به قدری زیاد است که فقط به خاطر خودت و به عنوان یک شخص دلربا ارزشمند هستی، چون مانند گلی، همه‌ی نشانه‌های زیبایی را داری."],[445,"ز کنج صومعه حافظ مجوی گوهر عشق","قدم برون نه اگر میل جست و جو داری","در گوشه صومعه، مناجات حافظ را جستجو نکن، بلکه اگر به دنبال حقیقت عشق هستی، باید از این مکان بیرون بروی و آن را در زندگی واقعی جستجو کنی."],[446,"بیا با ما مورز این کینه‌داری","که حق صحبت دیرینه داری","به ما بپیوند و از این کینه و دشمنی دست بردار، زیرا تو حق دوستی و رفاقت را با ما داری."],[446,"نصیحت گوش کن کاین در بسی به","از آن گوهر که در گنجینه داری","پندی که می‌دهم را گوش کن که این از همه ثروت‌هایی که داری باارزش‌تر است."],[446,"ولیکن کی نمایی رخ به رندان؟","تو کز خورشید و مه آیینه داری","اما توقع مهر و رخ نمودن به رندی مانند من از تو توقع بی‌جایی است زیرا خورشید و ما آیینه تو هستند."],[446,"بد رندان مگو ای شیخ و هش دار","که با حکم خدایی کینه داری","ای شیخ، از رندان و رندی مثل من بد مگوی که این کار دشمنی با حکم و فرمان خداست."],[446,"نمی‌ترسی ز آه آتشینم؟","تو دانی خرقه پشمینه داری؟","از آه آتشینم نمی‌ترسی؟ تو که خرقه‌ای پشمین و سوزنده داری؟"],[446,"به فریاد خمار مفلسان رس","خدا را گر می دوشینه داری","به داد و کمک بی‌چیزان می‌گسار برس‌؛ با همان می دوشینه که ما را نوشاندی."],[446,"ندیدم خوش‌تر از شعر تو حافظ","به قرآنی که اندر سینه داری","ندیدم خوش‌تر از شعر تو حافظ‌، به قرآنی که اندر سینه داری."],[447,"ای که در کوی خرابات مقامی داری","جم وقت خودی ار دست به جامی داری","ای کسی که در محله خراباتی‌ها (مخالفین دین) جایگاه و مقام داری، اگر در زمان خودت (به خاطر زندگی گذران) نوشیدن از جام میسر باشد، از آن غافل مشو."],[447,"ای که با زلف و رخ یار گذاری شب و روز","فرصتت باد که خوش صبحی و شامی داری","ای کسی که با زیبایی‌ها و زلف و چهره معشوق (یار) شب و روز را سپری می‌کنی، امیدوارم این زمان برایت خوش‌یمن باشد که صبح و شام زیبایی‌های خوشی را تجربه می‌کنی."],[447,"ای صبا! سوختگان بر سر ره منتظرند","گر از آن یار سفرکرده پیامی داری","ای نسیم! عاشقانی که در راه انتظار می‌کشند، در انتظارند تا اگر پیامی از آن یار دورافتاده داری، برای آنان برسانی."],[447,"خال سرسبز تو خوش دانه عیشی‌ست ولی","بر کنار چمنش وه که چه دامی داری","خال سبز تو زینت‌دهنده لذت‌هاست، اما افسوس که در کنار چمن آن، چه دام‌های فریبنده‌ای برای شکار کردن وجود دارد."],[447,"بوی جان از لب خندان قدح می‌شنوم","بشنو ای خواجه اگر زان که مشامی داری","از لب خندان و نوشیدن باده، بوی حیاتی به مشامم می‌رسد. ای استاد، گوش کن که شاید به خاطر بوی خوشی که از تو می‌تدوی، حس می‌شود."],[447,"چون به هنگام وفا هیچ ثباتیت نبود","می‌کنم شکر که بر جور دوامی داری","هرگاه که به عهد و وفا پایبند نبودی، شکر می‌کنم که بر ظلم تو ثبات و پایداری وجود دارد."],[447,"نام نیک ار طلبد از تو غریبی چه شود؟","تویی امروز در این شهر که نامی داری","اگر غریبی بخواهد نام نیکو کسب کند، چه فایده‌ای دارد؟ تو هستی که در این شهر امروز دارای شهرت و نام و آوازه‌ای."],[447,"بس دعای سحرت مونس جان خواهد بود","تو که چون حافظ شب‌خیز غلامی داری","دعای سحرگاهی تو مونس و آرام بخش جان خواهد بود، تو که مانند حافظ (شاعر) بیدار و شب‌زنده‌دار غلامی را در اختیار داری."],[448,"ای که مهجوری عشاق روا می‌داری","عاشقان را ز بر خویش جدا می‌داری","ای کسی که جدا نگه‌داشتن عاشقان از خود را مجاز می‌دانی، با این حال در مورد آن‌ها احساس بی‌مهری می‌کنی."],[448,"تشنه بادیه را هم به زلالی دریاب","به امیدی که در این ره به خدا می‌داری","اگرچه در بیابان و دور از آب هستم و تشنه‌ام، به من محبت کن و با مهربانی‌ات دلگرمم کن. امیدوارم که این محبت‌ها مرا به خداوند نزدیک‌تر کند."],[448,"دل ببردی و بحل کردمت ای جان لیکن","به از این دار نگاهش که مرا می‌داری","ای جان، تو دل مرا دزدیده و از آن خود کرده‌ای، اما به نظرم بهتر است که به جای دلربایی، به این وضعیت ادامه ندهی و درمقابل نگاه تو که مرا به سمت خود می‌کشاند، مقاوم باشم."],[448,"ساغر ما که حریفان دگر می‌نوشند","ما تحمل نکنیم ار تو روا می‌داری","ما که از کاسه شراب خود با دیگران می‌نوشیم، اگر تو این موضوع را تحمل کنی، ما نمی‌توانیم وضعیت را تحمل کنیم."],[448,"ای مگس حضرت سیمرغ نه جولانگه توست","عرض خود می‌بری و زحمت ما می‌داری","ای مگس جای تو در حضور سیمرغ نیست, تو فقط باعث آبروریزی خود می‌شوی و برای ما زحمت ایجاد می‌کنی."],[448,"تو به تقصیر خود افتادی از این در محروم","از که می‌نالی و فریاد چرا می‌داری؟","تو به خاطر اشتباهات خود به این وضعیت دشوار دچار شده‌ای و از کسی که به او دلخوشی، شکایت می‌کنی و بی‌دلیل فریاد می‌زنی."],[448,"حافظ از پادشهان پایه به خدمت طلبند","سعی نابرده چه امید عطا می‌داری؟","حافظ می‌گوید: تو که برای رسیدن به مقام و پادشاهی هیچ تلاشی نکرده‌ای، چه امیدی به بخشش و عطا از جانب خداوند داری؟"],[449,"روزگاری‌ست که ما را نگران می‌داری","مخلصان را نه به وضع دگران می‌داری","در این دوران، تو ما را در نگرانی نگه‌داشته‌ای و مخلصان را به گونه‌ای که دگران را مورد توجه قرار می‌دهی، توجه نمی‌کنی."],[449,"گوشه چشم رضایی به منت باز نشد","این چنین عزت صاحب‌نظران می‌داری؟","گوشه چشم کسی به نام رضا به من توجه نکرده است، آیا تو این‌قدر عزت و احترام برای صاحب‌نظران قائل هستی که آنها را در نظر نگیری؟"],[449,"ساعد آن به که بپوشی تو چو از بهر نگار","دست در خون دل پرهنران می‌داری","بهتر است که برای خوشنود کردن معشوق، خود را به رنج و سختی بیندازی، زیرا تو توانایی نگهداری از خود را داری و می‌توانی از دل‌خوشی نسبت به هنر و زیبایی برآمده از این عشق، به خوبی دفاع کنی."],[449,"نه گل از دست غمت رست و نه بلبل در باغ","همه را نعره‌زنان جامه‌دران می‌داری","نه گل از غم تو رست و نه بلبل در باغ وجود دارد، تو همه را در حال ناله و بی‌تابی، که به راز دل‌شکستگی مبتلا هستند، رها کرده‌ای."],[449,"ای که در دلق ملمّع طلبی نقد حضور","چشم سری عجب از بی‌خبران می‌داری؟","ای کسی که به لباس زیبا و رنگی خود مغروری و به دنبال جلب توجه دیگران هستی، چرا از آنانی که نسبت به حقیقت وجود تو نادانند و خبر ندارند، با بی‌احترامی رفتار می‌کنی؟"],[449,"چون تویی نرگس باغ نظر ای چشم و چراغ","سر چرا بر من دل‌خسته گران می‌داری؟","ای چشم و چراغ من، تو مانند نرگس زیبای باغ هستی؛ پس چرا این گونه با دل‌خسته و اندوهگین من سخت می‌گیری؟"],[449,"گوهر جام‌جم از کان جهانی دگر است","تو تمنّا ز گل کوزه‌گران می‌داری","جوهر واقعی (گوهر جام‌جم) از معدن یا منبعی غیر از این دنیا (جهانی دگر) به دست آمده است، ولی تو به یک جسم مادی و بی‌ارزش (گل کوزه‌گران) تمایل داری."],[449,"پدر تجربه ای دل تویی آخر ز چه روی","طمع مهر و وفا زین پسران می‌داری؟","پدر، تو تجربه‌ای و باید بدانی که چرا انتظار محبت و وفا را از این پسران بی‌وفا داری؟"],[449,"کیسه سیم و زرت پاک بباید پرداخت","این طمع‌ها که تو از سیم‌بران می‌داری","برای این طمع‌ها که تو از مردان زر و سیم می‌داری، باید بهایش را با کیسه‌ای پر از نقره و طلا پرداخت."],[449,"گر چه رندیّ و خرابیّ گنه ماست، ولی","عاشقی گفت که تو بنده بر آن می‌داری","علی‌رغم اینکه ما به خاطر رندی و بی‌خبری‌مان مقصر هستیم، اما عاشقی گفت که تو بر این موضوع قراردادی داره و به همین خاطر تو را به خود وابسته می‌کند."],[449,"مگذران روز سلامت به ملامت حافظ","چه توقع ز جهان گذران می‌داری؟","حافظ می‌گوید روزهای خوش و سالم خود را به خاطر سرزنش و ملامت از دست نده، زیرا چه انتظاری از این دنیا که همیشه در حال گذر است می‌توان داشت؟"],[450,"خوش کرد یاوری فلکت روز داوری","تا شکر چون کنی و چه شکرانه آوری","خداوند در روز قیامت به یاری تو خواهد شتافت، پس تو چگونه می‌خواهی شکر او را به جا بیاوری و چه نوع شکرگزاری انجام خواهی داد؟"],[450,"آن کس که اوفتاد خدایش گرفت دست","گو بر تو باد تا غم افتادگان خوری","هر کسی که به دلیل مشکلات و دشواری‌ها به زمین می‌افتد، خداوند او را در آغوش رحمت خود می‌گیرد. بنابراین، تو نیز بر او شکر کن تا همدل با آسیب‌دیدگان باشی و غم آن‌ها را درک کنی."],[450,"در کوی عشق شوکت شاهی نمی‌خرند","اقرار بندگی کن و اظهار چاکری","در محله عشق، مقام و شوکت سلطنت ارزشی ندارد، پس باید به صراحت از بندگی و خدمتگزاری خود سخن بگویی و به آن اعتراف کنی."],[450,"ساقی به مژدگانی عیش از درم درآی","تا یک دم از دلم غم دنیا به در بری","ساقی، ای کسی که شراب به دست می‌دهی، خوش‌خبر باش و بیا تا با نوشیدن شراب، غم‌های دنیوی را از دلم دور کنی."],[450,"در شاه‌راه جاه و بزرگی خطر بسی‌ست","آن به کز این گریوه سبک‌بار بگذری","در مسیر دستیابی به مقام و بزرگی، خطرهای زیادی وجود دارد، اما بهتر است که از این بار سنگین (مسئولیت‌ها و مشکلات) رها شوی و با آسودگی پیش بروی."],[450,"سلطان و فکر لشکر و سودای تاج و گنج","درویش و امن خاطر و کنج قلندری","سلطان که به فکر لشکر و جستجوی تاج و ثروت است، درویش در آرامش خاطر و در گوشه زندگی ساده و بی‌توجهی به دنیا قرار دارد."],[450,"یک حرف صوفیانه بگویم اجازت است؟","ای نور دیده صلح به از جنگ و داوری","اجازه می‌خواهی که یک سخن صوفیانه بگویم؟ ای محبوب من، برقراری صلح بهتر از جنگ و قضاوت است."],[450,"نیل مراد بر حسب فکر و همت است","از شاه نذر خیر و ز توفیق یاوری","برآورده شدن آرزوها به افکار و همت فرد بستگی دارد، که ممکن است با نذر خیر از سوی پادشاه و همراهی لطف خدا نیز حاصل شود."],[450,"حافظ غبار فقر و قناعت ز رخ مشوی","کاین خاک بهتر از عمل کیمیاگری","حافظ از تو می‌خواهد که غبار فقر و زندگی ساده را از چهره‌ات پاک نکن، زیرا این خاک و دنیا ارزشش بیشتر از کار کیمیاگران است."],[451,"طفیل هستی عشقند آدمیّ و پری","ارادتی بنما تا سعادتی ببری","آدم و پری وابسته و مهمان‌ ناخوانده عالم عشق اند به ساحت عشق ارادتی بنما و عشق بورز تا سعادتی ببری"],[451,"بکوش خواجه و از عشق بی‌نصیب مباش","که بنده را نخرد کس به عیب بی‌هنری","زندگی یعنی آموختن هنر عشق ورزیدن؛ و اوقات، بدون عشق ارزشی ندارد"],[451,"می صبوح و شکرخواب صبحدم تا چند؟","به عذر نیم‌شبی کوش و گریه سحری","تا کی به اوقات خودت را به خوردن و خوابیدن و آسایش طلبی میگذرانی؟تلاش کن راز و نیاز شبانه و گریه و توبه صبحگاهی را به جا بیاوری"],[451,"تو خود چه لعبتی ای شهسوار شیرین‌کار","که در برابر چشمیّ و غایب از نظری؟","ای شیرین‌کار، چه مظهر زیبایی هستی که در برابر چشم‌ها هستی، ولی دیدن تو از نظرها پنهان است؟"],[451,"هزار جان مقدّس بسوخت زین غیرت","که هر صباح و مسا شمع مجلس دگری","به خاطر غیرتی که داشتم، هزار جان مقدس در هر صبح و شب به آتش سوخت که حلقه‌ای از شمع‌های مجالس دیگر می‌شدم."],[451,"ز من به حضرت آصف که می‌برد پیغام","که یاد گیر دو مصرع ز من به نظم دری؟","به آصف‌بن برخیا وزیر حضرت سلیمان چه کسی میتواند پیغام ببرد که؛بجای علم کتاب؛ از من دو مصراع شعر پارسی دری یاد بگیر ؟"],[451,"بیا که وضع جهان را چنان که من دیدم","گر امتحان بکنی می خوریّ و غم نخوری","اگر با دیدگاه من (عشق‌ورزی) به زندگی نگاه کنی، سرمست از عشق خواهی شد و همه‌ی غم‌ها فراموش می‌شوند!"],[451,"کلاه سروریت کج مباد بر سر حسن","که زیب بخت و سزاوار ملک و تاج سری","مبادا ببینم کلاه سروری و بزرگیت روی سر حسن و خوبیت لغزان شود، که زیبنده بخت بلند و سزاوار حکومت و تاج هستی"],[451,"به بوی زلف و رخت می‌روند و می‌آیند","صبا به غالیه ساییّ و گل به جلوه‌گری","باد صبا عطر زلف تو را می‌پراکند و چهره‌ی تو مانند گلی جلوه گری می کند."],[451,"چو مستعّد نظر نیستی وصال مجوی","که جام جم نکند سود وقت بی‌بصری","وقتی که لیاقت نظر انداختن یار را نداری دنبال وصال نباش فایده‌ای ندارد که جام جمشید را داشته باشی و چیزی درآن نبینی"],[451,"دعای گوشه‌نشینان بلا بگرداند","چرا به گوشه چشمی به ما نمی‌نگری؟","ذره و اندک توجه معشوق به عاشق، هم‌چون دعای افراد مستجاب‌الدعوه، همه‌ی دردها را درمان می‌کند"],[451,"بیا و سلطنت از ما بخر به مایه حسن","وزین معامله غافل مشو که حیف خوری","بیا و با خوبی و حسنی که داری سلطنت را از ما بخر، این معامله را براحتی رد نکن که ضرر خواهی کرد"],[451,"طریق عشق طریقی عجب خطرناک است","نعوذبالله اگر ره به مقصدی نبری","راه عشق، راهی بسیار خطرناک و دشواری است. به خدا پناه می‌برم از این که در این مسیر نتوانی به نتیجه و مقصود برسیدی."],[451,"به یمن همّت حافظ امید هست که باز","اری اسامر لیلای لیلة القمری","امیدوارم به برکت همت حافظ، بار دیگر ببینم که در شب‌نشینی‌ای مهتابی با معشوقم هم‌صحبتی می‌کنم"],[452,"ای که دایم به خویش مغروری","گر تو را عشق نیست معذوری","ای کسی که همیشه به خود افتخار می‌کنی، اگر عاشق نیستی، عذر و بهانه‌ای برای این غرور نداشته باش."],[452,"گرد دیوانگان عشق مگرد","که به عقل عقیله مشهوری","به دور دیوانگان عشق نگرد، زیرا که آنان به عقل و خرد خود مشهور نیستند."],[452,"مستی عشق نیست در سر تو","رو که تو مست آب انگوری","عشق تو را به حالت نشئه و مستی نیندوخته و تو فقط تحت تأثیر شراب هستی، نه عشق واقعی."],[452,"روی زرد است و آه دردآلود","عاشقان را دوای رنجوری","چهره تو زرد است و با آهی پر از درد، به عاشقان می‌گوید که درمانی برای رنج‌هایشان وجود ندارد."],[452,"بگذر از نام و ننگ خود حافظ","ساغر می‌ طلب که مخموری","حافظ از ما می‌خواهد که فراتر از مسائلی مثل شهرت و آبرو بگذریم و فقط به دنبال لذت و خوشی در نوشیدن شراب باشیم، زیرا حالتی خمار (مست) به انسان آرامش و تسکین می‌بخشد."],[453,"ز کوی یار می‌آید نسیم باد نوروزی","از این باد ار مدد خواهی، چراغ دل برافروزی","نسیم نوروزی و بهاری از سمت خانه یار می‌وزد اگر قدر این نسیم خوش‌عطر را بدانی دل تو شاد و روشن خواهد شد."],[453,"چو گل گر خرده‌ای داری، خدا را صرف عشرت کن","که قارون را غلط‌ها داد، سودای زراندوزی","اگر همچون گل چند خرده و ریزه سیم و زر داری ‌آن‌را به شادی و می‌گساری صرف کن که خیال مال‌اندوزی برای قارون‌، غلط‌ها و بلاها درست کرد."],[453,"ز جام گل، دگر بلبل، چنان مست می لعل است","که زد بر چرخ فیروزه صفیر تخت فیروزی","بلبل چنان از زیبایی گل مست گشته است که آواز شادمانه او فلک را پر کرده است. (تخت فیروزی‌: نام گوشه‌ موسیقی است و تخت فیروزه کنایه است از آسمان)"],[453,"به صحرا رو که از دامن، غبار غم بیفشانی","به گلزار آی کز بلبل، غزل گفتن بیاموزی","در این فصل زیبا به صحرا رو تا غم‌هایت را فراموش کنی و به‌گلزار بیا تا بلبل عاشق‌، به‌تو شعر عاشقانه بیاموزد."],[453,"چو امکان خلود ای دل! در این فیروزه‌ایوان نیست","مجال عیش فرصت دان، به فیروزی و بهروزی","وقتی که امکان رفتن به ایوان بلند آسمان نیست پس قدر عیش و خوشی را بدان و نیکبخت و بهروز باش."],[453,"طریق کام‌بخشی چیست؟ ترک کام خود کردن","کلاه سروری آن است، کز این ترک بر دوزی","راه و مسلک شاد کردن دیگران چیست؟ آن‌است که سخاوتمند باشی و به‌آنها ببخشی و خود ترک لذت و کام کنی؛ آنچه که سروری و بزرگی نامیده‌اند‌، از این راه به‌دست می‌آید."],[453,"سخن در پرده می‌گویم، چو گل از غنچه بیرون آی","که بیش از پنج روزی نیست، حکم میر نوروزی","این‌ را در پرده و رمزی به‌تو می‌گویم و خود معنی آن‌را بیاب؛ ‌«همچون گل از غنچه بیرون بیا که شاهی میر نوروز‌، بسیار کوتاه است و بیش از پنج روز نیست.»"],[453,"ندانم نوحه قمری، به طرف جویباران چیست","مگر او نیز همچون من، غمی دارد شبان‌روزی؟","نمی‌دانم قمری در آن‌سو و در کنار جویبار چرا ناله غم سر داده است! شاید او نیز همچون من غمی همیشگی دارد."],[453,"میی دارم چو جان، صافی و صوفی می‌کند عیبش","خدایا هیچ عاقل را، مبادا بخت بد، روزی","می و شرابی دارم که مانند جان‌، صاف و زلال است و صوفی از آن ایراد می‌گیرد؛ خدایا بخت بد را سهم و روزی آدم عاقل مکن!"],[453,"جدا شد یار شیرینت، کنون تنها نشین ای شمع!","که حکم آسمان این است اگر سازی و گر سوزی","ای شمع سوزان و عاشق‌‌، یار زیبا و شیرین تو رفت و تو را ترک کرد؛ تقدیر آسمانی این است‌، می‌خواهی با آن بساز و می‌خواهی بسوز! (یار شیرین شمع، عسل است که از موم او جدا شده است)"],[453,"به عجب علم نتوان شد، ز اسباب طرب محروم","بیا ساقی که جاهل را هنی‌تر می‌رسد روزی","شایسته نیست که آدمی به‌جهت غرور علم و دانایی‌، خود را از شادی محروم کند، ساقی می بریز و شاد کن که آدم نادان روزی‌اش را آسان‌تر به دست می‌آورد."],[453,"می اندر مجلس آصف، به نوروز جلالی نوش","که بخشد جرعه جامت، جهان را ساز نوروزی","می را در بزم و مهمانی آصف و در نوروز جلالی بنوش، زیرا جرعه جام تو جهان را نوای نوروز و زندگی تازه خواهد بخشید."],[453,"نه حافظ می‌کند تنها دعای خواجه توران‌شاه","ز مدح آصفی خواهد، جهان عیدی و نوروزی","فقط حافظ دعاگوی خواجه توران‌شاه نیست بلکه جهانیان او را مدح می‌گویند تا عیدی و نوروزی خود را بگیرند."],[453,"جنابش پارسایان راست، محراب دل و دیده","جبینش صبح‌خیزان راست، روز فتح و فیروزی","جناب او‌، محراب دل و چشم پاکان و پارسایان است، و دیدن روی او برای صبح‌خیزان عابد‌، روز پیروزی و گشایش است."],[454,"عمر بگذشت به بی‌حاصلی و بوالهوسی","ای پسر جام می‌ام ده که به پیری برسی","زندگی به بطالت و بی‌ثمر گذشت و تو، جوان، در حال خوش‌گذرانی هستی؛ برای رسیدن به سالخوردگی، جام می را به من بده تا لذت ببرم."],[454,"چه شکرهاست در این شهر که قانع شده‌اند","شاه‌بازان طریقت به مقام مگسی","در این شهر چه نعمت‌هایی وجود دارد که شاهبازهای راه حق به مقام مگسی راضی شده‌اند و دیگر چیزی نمی‌طلبند."],[454,"دوش در خیل غلامان درش می‌رفتم","گفت: «ای عاشق بیچاره تو باری چه کسی؟»","دیشب در میان جمع غلامان که به در عشق می‌رفتند، کسی گفت: «ای عاشق بدبخت، تو چه کسی هستی؟"],[454,"با دل خون‌شده چون نافه خوشش باید بود","هر که مشهور جهان گشت به مشکین‌نفسی","هر کسی که در دنیا معروف و محبوب شده، باید مانند نافه‌ای با دل خون‌گرفته، خوش‌بو و دل‌نشین باشد. این یعنی برای رسیدن به مقام و محبوبیت، باید از درد و رنج‌های عاطفی و احساسات عمیق گذشته باشی."],[454,"لمع البرق من الطّور و آنست به","فلعلّی لک آت بشهاب قبس","من در کوه طور (جایی مقدس که موسی در آن با خدا سخن گفت) نوری را دیدم و به آن نور احساس نزدیکی کردم، شاید که برافروخته شدم و به نور آتش فرستاده‌شده‌ای دست یابم."],[454,"کاروان رفت و تو در خواب و بیابان در پیش","وه که بس بی‌خبر از غلغل چندین جرسی","کاروان مسافران حرکت کرده و تو هنوز در خواب هستی، در حالی‌که بیابان و راه در مقابل توست. آه، تو چقدر از صدای زنگ‌های مکرر کاروان بی‌خبر هستی."],[454,"بال بگشا و صفیر از شجر طوبی زن","حیف باشد چو تو مرغی که اسیر قفسی","ای بال‌هایت را باز کن و از درخت طوبی، صدای خوشی تولید کن. افسوس که تو، این پرنده‌ی آزاد، در قفسی محبوس هستی."],[454,"تا چو مجمر نفسی دامن جانان گیرم","جان نهادیم بر آتش ز پی خوش‌نفسی","می‌خواهم مانند مشعلی سوزان، عشق جانانم را در آغوش بکشم. جانم را بر آتش قرار داده‌ام تا به خاطر کیفیت خوب نفس کشیدنم، خوش‌نفسی را تجربه کنم."],[454,"چند پوید به هوای تو ز هر سو حافظ","یسر الله طریقا بک یا ملتمسی","حافظ به درگاه خداوند دعا می‌کند که برای رسیدن به محبوبش (که در اینجا اشاره به خدا یا محبوب خاصی دارد) راهی آسان قرار دهد، زیرا او از هر سوی در جستجوی اوست و به شدت دلبسته‌اش شده است."],[455,"نوبهار است در آن کوش که خوش‌دل باشی","که بسی گل بدمد باز و تو در گل باشی","بهار تازه‌ای در راه است، پس سعی کن خوشدل و شاداب باشی، زیرا ممکن است گل‌های زیادی دوباره شکوفا شوند و تو در حالت ناامیدی و غم باقی بمانی."],[455,"من نگویم که کنون با که نشین و چه بنوش","که تو خود دانی اگر زیرک و عاقل باشی","من نمی‌گویم اکنون با چه کسی باید باشید و چه بنوشید، زیرا خودت می‌دانی که اگر هوشیار و عاقل باشی، باید به چه کسی و چه چیزی توجه کنی."],[455,"چنگ در پرده همین می‌دهدت پند ولی","وعظت آن گاه کند سود که قابل باشی","اگر مهارت در درک نکات مهم و آموزنده را داشته باشی، همین موسیقی و نغمه‌ها به تو درس می‌دهد، اما نصیحت و اندرز زمانی به تو فایده دارد که آمادگی و قابلیت پذیرش آن را داشته باشی."],[455,"در چمن هر ورقی دفتر حالی دگر است","حیف باشد که ز کار همه غافل باشی","در هر گوشه چمن، هر برگ داستانی تازه دارد و جای تأسف است که از همه این مسائل غافل بمانی."],[455,"نقد عمرت ببرد غصه دنیا به گزاف","گر شب و روز در این قصه مشکل باشی","بغض و ناراحتی‌های زندگی به راحتی می‌توانند عمر تو را هدر بدهند، اگر درگیر مشکلات و پیچیدگی‌های این دنیا شوی و همواره به آن‌ها فکر کنی."],[455,"گر چه راهی‌ست پر از بیم ز ما تا بر دوست","رفتن آسان بود ار واقف منزل باشی","هرچند که راه رسیدن به دوست پر از خطر است، اما اگر به مقام و منزلت خود آگاه باشی، رفتن به آن سوی آسان خواهد بود."],[455,"حافظا گر مدد از بخت بلندت باشد","صید آن شاهد مطبوع‌شمایل باشی","اگر بخت خوب به تو یاری کند، تو می‌توانی آن معشوق زیبا و خوش‌سیمای را به دست‌آوری."],[456,"هزار جهد بکردم که یار من باشی","مرادبخش دل بی‌قرار من باشی","من تمام تلاش خود را کردم تا تو یار من باشی و آرزوی دل بی‌قرارم را برآورده کنی."],[456,"چراغ دیده شب‌زنده‌دار من گردی","انیس خاطر امّیدوار من باشی","ای کاش تو نور چشمان من شوی و مونس دل امیدوار من باشی."],[456,"چو خسروان ملاحت، به بندگان نازند","تو در میانه، خداوندگار من باشی","تو هم مانند خسروان زیبا و دلربا به بندگان ناز می‌زنی، ولی من دوست دارم که در میان آنها، تو به عنوان معشوق و آقای دل من باقی بمانی."],[456,"از آن عقیق که خونین‌دلم ز عشوه او","اگر کنم گله‌ای غم‌گسار من باشی","اگر از عشوه روی لب های تو که دل من را خونین کرده گله کنم، تو باید به من غم‌ها را تسکین دهی‌ و درک نشان بدی."],[456,"در آن چمن که بتان، دست عاشقان گیرند","گرت ز دست برآید، نگار من باشی","در آن باغی که معشوقه‌ها توجه عاشقان را جلب می‌کنند، اگر تو هم از دستم آزاد شوی، باید معشوق من باشی."],[456,"شبی به کلبه احزان عاشقان آیی","دمی انیس دل سوگوار من باشی","روزی به خانه غم‌انگیز عاشقان بیا و مدتی همدم و همراه دل اندوهین من باش."],[456,"شود غزاله خورشید، صید لاغر من","گر آهویی چو تو یک دم، شکار من باشی","اگر تو مانند آهویی زیبا و دلربا یک لحظه در دسترس من باشی، من می‌خواهم تو همچون غزال خورشید به دست من بیفتی و صید من شوی."],[456,"سه بوسه کز دو لبت، کرده‌ای وظیفه من","اگر ادا نکنی، قرض‌دار من باشی","اگر سه بوسه از لبان تو، به عنوان وظیفه به من داده‌ای، اگر آنها را عمل نکنی، برای من بدهکار خواهی بود."],[456,"من این مراد ببینم به خود که نیم‌شبی","به جای اشک روان، در کنار من باشی","من فقط خواسته‌ام وقتی نیمه‌شب به جای اینکه اشک بریزم، تو در کنارم باشی و این آرزوی من است."],[456,"من ار چه حافظ شهرم، جویی نمی‌ارزم","مگر تو از کرم خویش، یار من باشی","باید توجه کرد که جو در قدیم واحد پول و کم‌ارزش بوده است. « از نقد تو هر یک جو، دینار شود روزی » سیف فرغانی"],[457,"ای دل آن دم که خراب از می گلگون باشی","بی زر و گنج به صد حشمت قارون باشی","ای دل، وقتی که مست از شراب سرخ رنگ (عشق) باشی، بدون آن که ثروت و گنجی داشته باشی، صد ها بار بیشتر از قارون جایگاه و بزرگی پادشاه را داری"],[457,"در مقامی که صدارت به فقیران بخشند","چشم دارم که به جاه از همه افزون باشی","در جایگاهی که به افراد فقیر مقام و اعتبار می‌دهند، امیدوارم که تو از همه بالاترین مقام را داشته باشی."],[457,"در ره منزل لیلی که خطرهاست در آن","شرط اول قدم آن است که مجنون باشی","در راه رسیدن به عشق لیلی، که مملو از خطرات است، اولین شرط این است که مانند مجنون (عاشق دیوانه) باشی و حتی از عقل و تدبیر خود صرف‌نظر کنی."],[457,"نقطه عشق نمودم به تو هان سهو مکن","ور نه چون بنگری از دایره بیرون باشی","من به تو نشان عشق را ارائه دادم، پس سهل‌انگاری نکن؛ وگرنه اگر به حقیقت آن بنگری، از دایره عشق و ارتباط خارج خواهی شد."],[457,"کاروان رفت و تو در خواب و بیابان در پیش","کی روی؟ ره ز که پرسی؟ چه کنی؟ چون باشی؟","کاروان مسافران رفت و تو خواب هستی، در حالی که بیابان و راه در پیش روی تو قرار دارد. حالا باید بروی، اما نمی‌دانی از که بپرسید، چه کار کنی و در چه وضعیتی قرار داری."],[457,"تاج شاهی طلبی، گوهر ذاتی بنمای","ور خود از تخمه جمشید و فریدون باشی","اگر دنبال تاج و مقام سلطنت هستی، باید نشان دهی که همچون یک گوهر ارزشمند هستی. فراموش نکن که اگر از نسل جمشید و فریدون (پادشاهان بزرگ) هستی، باید اصل و نسب و شایستگی‌ات را هم اثبات کنی."],[457,"ساغری نوش کن و جرعه بر افلاک فشان","چند و چند از غم ایام جگرخون باشی؟","بیا جامی بنوش و جرعه‌ای به آسمان بپاش، چرا باید مدام از غم روزگار و تلخی‌اش رنج بکشی؟"],[457,"حافظ از فقر مکن ناله که گر شعر این است","هیچ خوش‌دل نپسندد که تو محزون باشی","حافظ می‌گوید از فقر و تنگدستی ناله نکن، زیرا اگر این شعر باشد، هیچ‌کس با دل خوش نمی‌تواند پذیرد که تو در غم و اندوه باشی."],[458,"زین خوش رقم که بر گل رخسار می‌کشی","خط بر صحیفه گل و گلزار می‌کشی","از این نقش زیبایی که بر چهره گل می‌کشی، بر ورقه گل و باغستان هم اثر می‌گذاری."],[458,"اشک حرم‌نشین نهان‌خانه مرا","زان سوی هفت‌پرده به بازار می‌کشی","اشک من که در حرم، پنهان و دور از چشم دیگران است، تو از آن طرف هفت‌پرده (هفت پرده به معنای موانع محسوس و نامحسوس) به بازار می‌کشی و نشان می‌دهی."],[458,"کاهل روی چو باد صبا را به بوی زلف","هر دم به قید سلسله در کار می‌کشی","بدون توجه به حجاب و سختی‌هایش، آن که زیبایی‌اش مانند باد صباست، به خاطر عطر زلفش، هر لحظه مرا با خود به سمت عشق و وابستگی می‌کشاند."],[458,"هر دم به یاد آن لب میگون و چشم مست","از خلوتم به خانه خمار می‌کشی","مدام به یاد آن لب زیبا و چشمان می‌نوشی هستم و این خیال باعث می‌شود که به حالت بی‌خبری و مستی دچار شوم."],[458,"گفتی سر تو بسته فتراک ما شود","سهل است اگر تو زحمت این بار می‌کشی","گفته‌ای که سر تو در زنجیر ما باشد، این کار آسان است اگر تو برای این بار زحمت بکشی."],[458,"با چشم و ابروی تو چه تدبیر دل کنم؟","وه زین کمان که بر من بیمار می‌کشی","با دیدن چشمان و ابروی تو چه نقشه‌ای برای دل خود بکشیم؟ آه، از این کمان که بر من تیر می‌زند و مرا بیمار کرده است."],[458,"بازآ که چشم بد ز رخت دفع می‌کند","ای تازه گل که دامن از این خار می‌کشی","ای تازه گلی که با چهره‌ات چشم‌زخم‌ها را دور می‌کنی، دوباره برگرد و نزد من بیا، چرا که تو با وجود خود، سختی‌ها و دردهای این زندگی را از خود دور می‌کنی."],[458,"حافظ دگر چه می‌طلبی از نعیم دهر","می می‌خوری و طره دلدار می‌کشی","حافظ، ای دوست، چه چیزی از نعمت‌های دنیا می‌خواهی؟ تو همواره در حال نوشیدن شراب هستی و با زیبایی محبوب خود (که طره‌ی موی اوست) بازی می‌کنی."],[459,"سلیمی منذ حلّت بالعراق","ألاقی من نواها ما ألاقی","سلطانی که از زمانی که به عراق آمده، در هر نظر وی، جز غم و اندوه چیزی نمی‌بینم."],[459,"الا ای ساروان منزل دوست","إلی رکبانکم طال اشتیاقی","ای کاروان، به سوی منزل دوست بروید که اشتیاق من بسیار طولانی شده است."],[459,"خرد در زنده‌رود انداز و می نوش","به گلبانگ جوانان عراقی","عقل را در رود زنده‌رود بینداز و می بنوش که صدای جوانان عراقی بلند است."],[459,"ربیع العمر فی مرعی حماکم","حماک اللّه یا عهد التّلاقی","بهاری از زندگی در مرتع و سرزمین شما برقرار است. خداوند شما را حفظ کند، ای دوران دیدار."],[459,"بیا ساقی بده رطل گرانم","سقاک اللّه من کأس دهاق","بیا ای ساقی، به من می در پیاله ای بزرگ بده که دل سنگین و غمگینم را شاد کند. خداوند تو را از می خوشگوار سیراب کند."],[459,"جوانی باز می‌آرد به یادم","سماع چنگ و دست افشان ساقی","حالت جوانی و شادابی را در ذهنم زنده می‌کند و یادآور جشن و سرور با موسیقی چنگ و رقص و نواخته ساقی است."],[459,"می باقی بده تا مست و خوشدل","به یاران برفشانم عمر باقی","باقی‌مانده عمرم را با شراب پرکن تا بتوانم شاد و سرحال، خوشی‌هایم را با دوستانم تقسیم کنم."],[459,"درونم خون شد از نادیدن دوست","ألا تعسا لأیّام الفراق","از دیدن نکردن دوست، درونم پر از اندوه و خون شده است. ای کاش ایام جدایی و دوری از او لعنتی باشد."],[459,"دموعی بعدکم لا تحقروها","فکم بحر عمیق من سواق","پس از رفتن شما، اشک‌هایتان را کوچک نشمارید، زیرا چه بسیار دریاهای عمیق به خاطر جویبارها به وجود می‌آیند."],[459,"دمی با نیکخواهان متفق باش","غنیمت دان امور اتفاقی","لحظه‌ای با نیک‌خواهان هم‌نظر و همراه باش و از این اتفاقات و لحظات ارزشمند استفاده کن، زیرا این موقعیت‌ها گران‌بها هستند."],[459,"بساز ای مطرب خوشخوان خوشگو","به شعر فارسی، صوت عراقی","ای مطرب خوشخوان و خوشگوی، به‌خاطر شعر فارسی، صدایی شاد و دلنشین بساز که شکوه و زیبایی موسیقی عراقی را به همراه داشته باشد."],[459,"عروسی بس خوشی ای دختر رز","ولی گه گه سزاوار طلاقی","ای دختر توانمندی که در شادی و خوشی شبیه به عروسی، به گاهی هم ممکن است برای طلاق شایسته باشی."],[459,"مسیحای مجرد را برازد","که با خورشید سازد هم‌وثاقی","خداوند به تنهایی مانند مسیح (مسیحای مجرد) ستایش شده است و او را بخوانید تا با خورشید، که نماد روشنایی و حقیقت است، پیمان و دوستی برقرار کند."],[459,"وصال دوستان روزی ما نیست","بخوان حافظ غزل‌های فراقی","دیدار دوستان به ما تقدیر نشده است، بنابراین حافظ را بخوان تا غزل‌های جدایی را بشنوی."],[460,"کتبت قصّة شوقی و مدمعی باکی","بیا که بی تو به جان آمدم ز غمناکی","شوق و دلتنگی‌ام را نوشتم و اشک‌هایم را هم به‌خاطر عدم حضور تو نگران نباش، زیرا من در غم نبودنت به جانم رسیده‌ام."],[460,"بسا که گفته‌ام از شوق با دو دیده خود","أیا منازل سلمی فأین سلماک؟","بسیاری اوقات از روی شوق و اشتیاق، با دو چشم خود از منزلگاه‌های سلما پرسیده ام که کجاست سلمایتان؟"],[460,"عجیب واقعه‌ای و غریب حادثه‌ای","أنا اصطبرت قتیلا و قاتلی شاکی","من با صبر و شکیبایی آنقدر پیش‌آمد عجیبی را تحمل کرده‌ام که حالا به حال کسی بازیچه‌ای شده‌ام که خودم را به قتل رسانده‌اند، در حالی که دل قاتل (کسی که به من آسیب رسانده) نیز از من شکایت دارد."],[460,"که را رسد که کند عیب دامن پاکت؟","که همچو قطره که بر برگ گل چکد پاکی","کیست که بتواند عیب دامن پاک تو را بگیرد؟ تو مانند قطره‌ای هستی که بر روی برگ گل می‌چکد، و این نشان از پاکی و بی‌نقصی تو دارد."],[460,"ز خاک پای تو داد آب، روی لاله و گل","چو کلک صنع رقم زد به آبی و خاکی","از خاک پای تو، آب و رنگ به روی لاله و گل داده شده است؛ مانند هنری که با آب و خاک، تصویر زیبایی را خلق کرده‌اند."],[460,"صبا عبیرفشان گشت ساقیا برخیز","و هات شمسة کرم مطیّب زاکی","باد صبا چون عطر گل پخش شده است، ای ساقی بیدار شو و آن نوشیدنی خوشمزه و خالص را بیاور."],[460,"دع التّکاسل تغنم فقد جری مثل","که زاد راهروان چستی است و چالاکی","تنبلی را رها کن و از فرصتی که در دست داری بهره ببر، زیرا مثل معروفی هست که می‌گوید: کامیابی و موفقیت زادگاه افرادی است که در راه پیشرفت، تلاش و تلاش بیشتری می‌کنند."],[460,"اثر نماند ز من، بی شمایلت، آری","أری مآثر محیای من محیّاک","بدون وجود تو، هیچ اثری از من باقی نخواهد ماند. آیا نمی‌بینی که زندگی من تنها به خاطر وجود تو معنا دارد؟"],[460,"ز وصف حسن تو حافظ چگونه نطق زند؟","که همچو صنع خدایی ورای ادراکی","حافظ می‌گوید چگونه می‌تواند درباره زیبایی تو صحبت کند؟ زیرا زیبایی تو چنان است که فراتر از درک انسان‌ها و آفریده‌های خداوند است."],[461,"یا مبسما یحاکي درجا من اللّآلي","یا رب چه درخور آمد گردش خط هلالی","ای معشوقی که لبخندت مانند درّی است که در بین جواهرات می‌درخشد، پروردگارا، چه چیزی مناسب حال اوست که خط هلالی شکلش در گرداگردش باشد؟"],[461,"حالی خیال وصلت خوش می‌دهد فریبم","تا خود چه نقش بازد این صورت خیالی","حالت خیال وصل تو، احساس خوبی به من می‌دهد و مرا فریب می‌دهد؛ اما نمی‌دانم در این تصویر خیالی چه سرنوشتی در انتظارم است."],[461,"می ده که گرچه گشتم نامه‌سیاه عالم","نومید کی توان بود از لطف لایزالی","هرچند که من در زندگی دچار ناکامی و مشکلات شده‌ام و نامه‌ام در برابر عالم سیاه و ناامیدکننده‌ای قرار دارد، اما چگونه ممکن است از رحمت بی‌پایان خداوند بی‌بهره باشم؟"],[461,"ساقی بیار جامی و از خلوتم برون کش","تا در به در بگردم قلّاش و لاابالی","یار پیاله‌دار (ساقی)، برایم جامی بیاور و مرا از تنهایی‌ام بیرون ببر، تا بتوانم بی‌هدف به این سو و آن سو بروم و زندگی‌ام را بی‌خیالی سپری کنم."],[461,"از چار چیز مگذر گر عاقلی و زیرک","امن و شراب بی‌غش، معشوق و جای خالی","اگر عاقل و زیرک هستی، از چهار چیز نمی‌توانی بگذری: شراب خالص، معشوق، امنیت و جای خالی که در آن خودت راحت باشی."],[461,"چون نیست نقش دوران در هیچ حال ثابت","حافظ مکن شکایت تا می خوریم حالی","چون هیچ وقت اوضاع و احوال زندگی ثابت نیست و مثل نقش دوران تغییر می‌کند، حافظ می‌گوید تا وقتی که ما در حال خوشی و نوشیدن هستیم، نباید از چیزی شکایت کنیم."],[461,"صافیست جام خاطر در دور آصف عهد","قم فاسقني رحیقا أصفی من الزّلال","جام دل در دوران آصف (دولت‌مردی معروف در تاریخ) خالص و زلال است. پس ای ساقی، مرا با شرابی بسیار خالص و ناب سیراب کن."],[461,"الملک قد تباهی من جدّه و جدّه","یا رب که جاودان باد این قدر و این معالی","هر سلطنتی به تلاش و نیاکانش می‌نازد(مباهات می‌کند)، ای پروردگار، کاش این مقام و این ویژگی‌ها جاودانه بمانند."],[461,"مسندفروز دولت، کان شکوه و شوکت","برهان ملک و ملت بونصر بوالمعالی","دولت و حکومت، به خاطر شکوه و عظمتش، دلیل حامی و پشتیبان مملکت و ملت است، یعنی با پیروزی بزرگ و بلندمرتبه."],[462,"سلام اللّه ما کرّ اللّیالي","و جاوبت المثاني و المثالي","سلام خدا بر کسی که شب‌ها بارها به یاد کسی جاویدان بوده و در مقام مقام‌ها و شایستگی‌ها پاسخگوست."],[462,"علی وادي الأراک و من علیها","و دار باللّوی فوق الرّمال","در کنار وادی اراک و کسانی که در آنجا هستند، و در خانه‌ای که در بالای شن‌ها واقع شده، هستم."],[462,"دعاگوی غریبان جهانم","و أدعو بالتّواتر و التّوالي","من برای غریبان دنیا دعا می‌کنم و دعاهایم به طور مکرر و پیوسته به سمت آن‌ها فرستاده می‌شود."],[462,"به هر منزل که رو آرد خدا را","نگه دارش به لطف لایزالی","هر جا که خداوند برود، او را با لطف بی‌پایانش حفظ کن."],[462,"منال ای دل که در زنجیر زلفش","همه جمعیت است آشفته حالی","ای دل، غم نخور که زنجیر زلف او همه را به هم ریخته و آشفته کرده است."],[462,"ز خطت صد جمال دیگر افزود","که عمرت باد صد سال جلالی","خط تو به زیبایی‌های دیگری افزوده شده است؛ امیدوارم عمرت صد سال، با جلال و وقار بگذرد."],[462,"تو می‌باید که باشی ور نه سهل است","زیان مایه جاهی و مالی","تو باید وجود داشته باشی و در غیر این صورت، از دست دادن مال و مقام، چندان مهم نیست."],[462,"بر آن نقاش قدرت آفرین باد","که گرد مه کشد خط هلالی","خداوندی را سپاس می‌گوید که آفرینشگران را قادر می‌سازد تا با توانایی خود هاله‌ای زیبا و دل‌نواز به گرد ماه بیفرازند."],[462,"فحبّک راحتي في کلّ حین","و ذکرک مونسي في کلّ حال","دوست داشتن تو برای من آرامش‌ بخش در هر زمانی است و یاد تو همراه من در هر شرایطی است."],[462,"سویدای دل من تا قیامت","مباد از شوق و سودای تو خالی","آرزو و عشق من به تو تا ابد از بین نرود و همیشه پر از شوق و خواسته‌های تو باشد."],[462,"کجا یابم وصال چون تو شاهی","من بدنام رند لاابالی","نمی‌دانم چگونه می‌توانم به وصال و نزدیکی تو، ای شاه محبوب، دست پیدا کنم، زیرا من انسانی معروف به ناپرهیزکاری و بی‌اعتنایی هستم."],[462,"خدا داند که حافظ را غرض چیست","و علم اللّه حسبي من سؤالي","خدا می‌داند که هدف حافظ از این خواسته چیست و علم خدا چقدر برای من کافی است و نیازی به سوال ندارم."],[463,"بگرفت کار حسنت چون عشق من کمالی","خوش باش زان که نبود این هر دو را زوالی","کار زیبایی تو به‌قدری تأثیرگذار است که همانند عشق من کامل به نظر می‌رسد. خوشحال باش، زیرا این زیبایی و عشق هرگز از بین نمی‌رود."],[463,"در وهم می‌نگنجد کاندر تصور عقل","آید به هیچ معنی زین خوب‌تر مثالی","عشق و زیبایی تو به قدری فراتر از درک و تصور انسان است که هیچ عقل و منطقی نمی‌تواند آن را به خوبی توصیف کند. در واقع، هیچ نمونه‌ای از زیبایی نمی‌تواند به پای تو برسد."],[463,"شد حظ عمر حاصل گر زان که با تو ما را","هرگز به عمر روزی روزی شود وصالی","بهره زندگی ما تنها از این است که هرگز در طول عمرمان، به طور مداوم، با تو وصال و ملاقات داشته باشیم."],[463,"آن دم که با تو باشم یک سال هست روزی","وان دم که بی تو باشم یک لحظه هست سالی",": زمانی که در کنار تو هستم، احساس می‌کنم که يک سال همچون يک لحظه زود ميگذرد، اما زمانی که دور از تو هستم، یک لحظه هم برایم به اندازه یک سال می‌گذرد."],[463,"چون من خیال رویت جانا به خواب بینم؟","کز خواب می‌نبیند، چشمم به جز خیالی","من چگونه می‌توانم خواب تو را ببینم، ای محبوب؟ زیرا چشمم غیر از خیال تو در خواب هیچ چیز نمی‌بیند."],[463,"رحم آر بر دل من کز مهر روی خوبت","شد شخص ناتوانم باریک چون هلالی","به من رحم کن، زیرا عشق به روی زیبایت باعث شده که دلم ضعیف و ناتوان شود، مانند هلال که نازک و شکننده است."],[463,"حافظ مکن شکایت گر وصل دوست خواهی","زین بیشتر بباید بر هجرت احتمالی","اگر واقعا می‌خواهی به وصل دوست برسی، نباید شکایت کنی، بلکه باید بر تحمل دوری و هجرت از او افزوده کنی."],[464,"رفتم به باغ صبحدمی تا چنم گلی","آمد به گوش ناگهم آواز بلبلی","صبح زود به باغ رفتم تا گلی بچینم، که ناگهان صدای بلبلی به گوشم رسید."],[464,"مسکین چو من به عشق گلی گشته مبتلا","و اندر چمن فکنده ز فریاد غلغلی","انسانی مثل من که به عشق یک گل گرفتار شده، در چمن به خاطر فریاد و ناله‌ام، در شرایط اسف‌ناکی قرار دارد."],[464,"می‌گشتم اندر آن چمن و باغ دم به دم","می‌کردم اندر آن گل و بلبل تاملی","در آن باغ و چمن به طور مداوم گردش می‌کردم و هر لحظه در تماشای گل و بلبل، تفکر و تأمل می‌کردم."],[464,"گل یار حسن گشته و بلبل قرین عشق","آن را تفضلی نه و این را تبدلی","گل به محبوبی که زیباست شبیه شده و بلبل در عشق او همراه است. این زیبایی را می‌توان نعمت دانست، ولی این دلیلی برای تغییر و دگرگونی در عشق نیست."],[464,"چون کرد در دلم اثر آواز عندلیب","گشتم چنان که هیچ نماندم تحملی","وقتی آواز بلبل در دلم اثر گذاشت، به قدری تحت تأثیر قرار گرفتم که نتوانستم تحمل کنم و چیزی از خودم نداشتم."],[464,"بس گل شکفته می‌شود این باغ را ولی","کس بی بلای خار نچیده‌ست از او گلی","در این باغ گل‌های بسیار زیادی می‌شکفد، اما هیچ‌کس نمی‌تواند گلی را بدون برخورد با درد و رنج خاری بچیند."],[464,"حافظ مدار امید فرج از مدار چرخ","دارد هزار عیب و ندارد تفضلی","حافظ می‌گوید که امید به بهبود اوضاع را از چرخ روزگار (سرنوشت) دور کن، زیرا این چرخ مملو از عیب و نقص است و هیچ لطف و احسانی در آن وجود ندارد."],[465,"این خرقه که من دارم در رهن شراب اولی","وین دفتر بی‌معنی غرق می ناب اولی","این خرقه‌ای (جامه‌ی دراویش و اهل تصوف یک جور درجه‌ی معنوی) که من دارم سزاوارتر این که به رهن شراب ناب درآید. ( شاعر از اعتبار خودش میخواهد برای کاری هزینه کند.) و این دفتر درس هم آلوده به همان شراب سزاوارتر است. (دفتر اشعار نیست. بلکه دفتر درس و مدرسه‌ی مربوط به زمان شاعر است.)"],[465,"چون عمر تبه کردم چندان که نگه کردم","در کنج خراباتی افتاده خراب اولی","نگاه کردم و دیدم چگونه عمرم را تباه کردم (در همان مدرسه‌ای که مورد بحث است). اگر در خراباتی (خلوتگاه رندان، پرستشگاه‌های ادیان کهنتر ویرانه یا خالی، حتی میخانه‌هایی که عملا در خرابات بوده.) مدهوش افتاده بودم سزاوارتر بود."],[465,"چون مصلحت اندیشی دور است ز درویشی","هم سینه پر از آتش هم دیده پرآب اولی","وقتی مصلحت‌خواهی و دوراندیشی از درویشی دور است، در درون من هم حسرت و آتش وجود دارد و هم اشک و غم."],[465,"من حالت زاهد را با خلق نخواهم گفت","این قصه اگر گویم با چنگ و رباب اولی","من نمی‌خواهم حال زاهدانه‌ام را برای مردم تعریف کنم، زیرا اگر قرار باشد این داستان را بگویم، بهتر است با موسیقی چنگ و رباب (آلات موسیقی) بیان شود."],[465,"تا بی سر و پا باشد اوضاع فلک زین دست","در سر هوس ساقی در دست شراب اولی","تا زمانی که اوضاع آسمان در هم و برهم است و بی‌نظم است، من نمی‌توانم به خاطر هوس‌های ساقی، شراب را در دست بگیرم یا آن را بنوشم."],[465,"از همچو تو دلداری دل برنکنم آری","چون تاب کشم باری زان زلف به تاب اولی","من نمی‌توانم از دلداری و محبت تو دل بکنم؛ زیرا همان‌طور که بار سنگینی را بر دوش می‌کشم، زلف تو نیز برایم مانند بند و قید است."],[465,"چون پیر شدی حافظ از میکده بیرون آی","رندی و هوسناکی در عهد شباب اولی","وقتی که پیر شدی، حافظ، از میکده بیرون بیا و از هوسرانی و لذت‌جویی‌هایی که در جوانی داشتی، دوری کن."],[466,"زان می عشق، کز او پخته شود هر خامی","گر چه ماه رمضان است بیاور جامی","از شراب عشق که باعث پختگی و کمال می‌شود، حتی اگر در ماه رمضان، باید جامی بیاوری. این اشاره به این است که عشق و محبت بالاتر از هر قیدی است و از جایی که انسان را به کمال می‌رساند، باید استقبال کرد."],[466,"روزها رفت که دست من مسکین نگرفت","زلف شمشادقدی، ساعد سیم‌اندامی","روزها سپری شد و من، این بنده ضعیف، نتوانستم زلف کسی که مثل شمشاد قامت زیبا دارد و بازوانش مانند نقره است را در دست بگیرم."],[466,"روزه هر چند که مهمان عزیز است ای دل","صحبتش موهبتی دان و شدن، انعامی","ای دل، هرچند روزه (به عنوان یک عبادت) مهمان باارزشی است، اما بدان که صحبت و همنشینی با خدا، یک موهبت بزرگ است و دستیابی به آن، همچون دریافت یک نعمت و انعام است."],[466,"مرغ زیرک به در خانقه اکنون نپرد","که نهاده‌ست به هر مجلس وعظی دامی","مرغ زیرک (طوطی یا پرنده زیرک) نباید اکنون به در خانقاه پرواز کند، زیرا در هر مجلسی که وعظ و نصیحتی برگزار می‌شود، دام‌هایی برای فریب و شکار او گذاشته شده است."],[466,"گله از زاهد بدخو نکنم؛ رسم این است","که چو صبحی بدمد، در پی‌اش افتد شامی","از زاهد بدخو (شخصی که به ظاهر مذهبی و عابد است، ولی در باطن خوبی ندارد) شکایت نمی‌کنم؛ چرا که به این ترتیب است که وقتی صبحی (روز جدیدی) آغاز می‌شود، شام (شب یا گذشته) به دنبالش می‌آید."],[466,"یار من چون بخرامد به تماشای چمن","برسانش ز من ای پیک صبا پیغامی","دلم می‌خواهد وقتی یارم به باغ می‌آید و به تماشای گل و گیاه می‌پردازد، تو ای پیک نسیم صبح، پیغام مرا به او برسانی."],[466,"آن حریفی که شب و روز می صاف کشد","بود آیا که کند یاد ز دردآشامی؟","آیا آن دوستی که همیشه خوشگذرانی و خوش‌گویی می‌کند، هرگز به یاد دردها و رنج‌های من خواهد بود؟"],[466,"حافظا گر ندهد داد دلت آصف عهد","کام دشوار به دست آوری از خودکامی","حافظ می‌گوید: اگر آصف، وزیر سلیمان، نتواند خواسته‌های دل تو را برآورده کند، پس برای رسیدن به آرزوها باید با مشکلات و خودخواهی‌های خود دست و پنجه نرم کنی."],[467,"که برد به نزد شاهان ز من گدا پیامی؟","که به کوی می‌فروشان دو هزار جم به جامی","آیا کسی از من، که فقیر و بی‌نوا هستم، پیامی به شاهان می‌رساند؟ در جایی که می‌فروشان هزاران جواهر را در یک جام به نمایش می‌گذارند."],[467,"شده‌ام خراب و بدنام و هنوز امیدوارم","که به همت عزیزان برسم به نیک‌نامی","من به خاطر زندگی خراب و بدنامم دچار ناامیدی شده‌ام، اما هنوز امیدوارم که با کمک و تلاش نزدیکانم بتوانم به مشهوریت و نیک‌نامی دست پیدا کنم."],[467,"تو که کیمیافروشی نظری به قلب ما کن","که بضاعتی نداریم و فکنده‌ایم دامی","ای کسی که جواهرات و کیمیا را می‌فروشی، نگاهی به دل ما بینداز، زیرا ما چیزی برای عرضه نداریم و تنها برای خود تو دام گسترده‌ایم."],[467,"عجب از وفای جانان که عنایتی نفرمود","نه به نامه‌ای پیامی نه به خامه‌ای سلامی","شگفتا از وفای محبوب که هیچ توجهی نکرده است؛ نه به نامه‌ای پاسخ داده، نه پیامی فرستاده و نه حتی سلامی با قلمی نوشته."],[467,"اگر این شراب خام است اگر آن حریف پخته","به هزار بار بهتر ز هزار پخته خامی","اگر این شراب هنوز بی‌کیفیت و ناپخته است، باز هم آن رفیق و دوست که پیشرفته و با تجربه است، به هزار بار بهتر از هزار ناپخته و بی‌تجربه است."],[467,"ز رهم میفکن ای شیخ به دانه‌های تسبیح","که چو مرغ، زیرک افتد نفتد به هیچ دامی","ای شیخ، در مسیر من سنگ اندازی نکن و راه را بر من ببند؛ زیرا من مانند پرنده‌ای زیرک هستم که به راحتی در دام نمی‌فتم، حتی اگر دانه‌های تسبیح تو جذاب باشند."],[467,"سر خدمت تو دارم بخرم به لطف و مفروش","که چو بنده کمتر افتد به مبارکی غلامی","من آماده‌ام تا دل و جانم را برای خدمت به تو تقدیم کنم و هیچ چیز را به قیمت بی‌مقداری نمی‌فروشم، زیرا هر چه کمتر خود را در برابر قدرت تو مطرح کنم، خوشبخت‌تر خواهم بود که در خدمت تو هستم."],[467,"به کجا برم شکایت؟ به که گویم این حکایت؟","که لبت حیات ما بود و نداشتی دوامی","نمی‌دانم به کجا بروم و از چه کسی شکایت کنم که لب تو برای ما زندگی‌بخش بود، اما حالا دوام و پایداری نداشت و از بین رفت."],[467,"بگشای تیر مژگان و بریز خون حافظ","که چنان کشنده‌ای را نکند کس انتقامی","چشم‌های پررمز و محزون حافظ (مژگان) عشق را باز کن و بگذار خون من بریزد، چون کسی که این‌قدر دردآور و کشنده است، هیچ‌کس نمی‌تواند انتقام او را بگیرد."],[468,"أتت روائح رند الحمی و زاد غرامی","فدای خاک در دوست باد جان گرامی","عطرهای خوش بو از رند حمی (یعنی شغف و علاقه‌ی شخصی) به مشام می‌رسد و عشق من به خوشبختی فدای خاک آن دوست شود، که جان عزیز من برای او قربانی است."],[468,"پیام دوست شنیدن سعادت است و سلامت","من المبلّغ عنّی إلی سعاد سلامی؟","شنیدن پیام دوست، نشان‌دهنده خوشبختی و سلامت است. چه کسی می‌تواند از طرف من سلامی به خوشبختی برساند؟"],[468,"بیا به شام غریبان و آب دیده من بین","به سان باده صافی در آبگینه شامی","به شب تنهایی و افسردگی من بیا و اشک‌های مرا ببین که مانند شراب زلال در شیشه شام می‌درخشد."],[468,"إذا تغرّد عن ذی الأراک طائر خیر","فلا تفرّد عن روضها أنین حمامي","اگر پرنده‌ای از درختان اراک (درختی با برگ‌های عریض) آواز بخواند، پس ناله کبوتران که از باغ جدا شده‌اند، بیان‌گر جدایی از آن باغ خواهد بود."],[468,"بسی نماند که روز فراق یار سر آید","رأیت من هضبات الحمی قباب خیام","مدت زیادی نمی‌گذرد که روز جدایی از یار به پایان برسد، زیرا از تپه‌های سرسبز چنین دیده‌ام که گنبدهای خیمه‌گاه‌ها در دوردست نمایان است."],[468,"خوشا دمی که درآیی و گویمت به سلامت","قدمت خیر قدوم نزلت خیر مقام","خوشحال خواهم شد روزی که تو بیایی و به تو بگویم که چقدر خوش آمده‌ای. ورود تو بهترین ورود است و جایی که فرود آمده‌ای هم بهترین جاست."],[468,"بعدت منک و قد صرت ذائبا کهلال","اگر چه روی چو ماهت ندیده‌ام به تمامی","از تو دور افتاده‌ام و هر روز بیشتر ذوب می‌شوم و ضعیف می‌شوم، مانند هلال ماه. هرچند که نتوانستم تمام رونق و زیبایی چهره‌ات را ببینم."],[468,"و إن دعیت بخلد و صرت ناقض عهد","فما تطیّب نفسی و ما استطاب منامی","اگر من به زندگی جاودانه دعوت شوم و پیمانم را بشکنم، هیچ چیز نمی‌تواند من را خوشنود کند و خواب را برایم دل‌چسب نکند."],[468,"امید هست که زودت به بخت نیک ببینم","تو شاد گشته به فرماندهی و من به غلامی","امیدوارم به زودی تو را در خوشبختی ببینم که شاد و سرحال شده‌ای و من در مقام خدمتگزار تو هستم."],[468,"چو سلک درّ خوشاب است شعر نغز تو حافظ","که گاه لطف سبق می‌برد ز نظم نظامی","شعر زیبا و خوش آهنگ تو مانند پارچه ابریشمی است که درخشش و زیبایی خاصی دارد و گاهی به خاطر لطافت آن، از نظم و نظامی که دیگر شعرها دارند، جلوتر می‌افتد."],[469,"سینه مالامال درد است ای دریغا مرهمی","دل ز تنهایی به جان آمد خدا را همدمی","سینه سرشار از درد و غم است، ای کاش مرهم و دارویی وجود داشت. دل از شدت تنهایی و بی­ کسی به ستوه درآمد به خاطر خدا همدم و هم­ نفسی را نشان دهید."],[469,"چشم آسایش که دارد از سپهر تیزرو؟","ساقیا جامی به من ده تا بیاسایم دمی","چه کسی از این روزگار زودگذر و ناپایدار انتظار آسایش دارد؟ ای ساقی جام شرابی به من ببخش تا لحظه ­ای در پرتو مستی به آرامش برسم.(نکته: حضرت خواجه اوضاع زمانه را چنان نابسامان می­ بیند که گویی تنها با مستی و عدم فکر کردن می ­توان به آرامش رسید.)"],[469,"زیرکی را گفتم: «این احوال بین»، خندید و گفت:","«صعب‌روزی، بوالعجب‌کاری، پریشان‌عالمی»","به انسان دانا و زیرکی گفتم به این اوضاع و احوال نگاه کن! با خنده­­ی تلخی گفت: چه روزگار دشواری، شگفت کاری، و عجب دنیای نابسامان و درهمی!صعب: دشوار.بوالعجب: شگفت انگیز"],[469,"سوختم در چاه صبر از بهر آن شمع چگل","شاه ترکان فارغ است از حال ما، کو رستمی؟","صبر و شکیبایی که در راه آن معشوق زیبارو انجام می­دهم همچون چاهی است که مرا اسیر خود ساخته است، شاه ترکان (شاه زیبارویان، امیر تیمور، افراسیاب)نسبت به حال ما بی­ تفاوت است، کجاست رستمی تا ما را نجات بخشد."],[469,"در طریق عشق‌بازی امن و آسایش بلاست","ریش باد آن دل که با درد تو خواهد مرهمی","در راه زندگی عاشقانه امنیت و آسودگی بلا و مصیبت است، امیدوارم آن دلی که با داشتن درد تو به دنبال مرهم می­ گردد زخم گردد.(نکته: نکته جالب توجه و رندانه در این بیت این است که با توجه به اعتقاد حافظ که امن و آسایش را برای عشق مصیبت می­ داند در مصراع دوم دلی که به دنبال درمان عشق می گردد را زخمی می­ خواهد؛ به بیانی دیگر دعا می­ کند که دلی که عاشق شده است هر لحظه عاشق­ تر و دردمندتر گردد.)"],[469,"اهل کام و ناز را در کوی رندی راه نیست","رهروی باید جهان‌سوزی نه خامی بی‌غمی","نه صاحبان ناز و کام نه انسان های بی تجربه و بی غم،هرگز نمی‌توانند وارد محله ی رندی شوند تنها سالکانی که آشوب و غوغا در جهان به پا می‌کنند و دنیا را به آشوب میکشانند می‌توانند وارد چنین کوی و برزنی شوند (ناگفته نماند که به آشوب کشیدن دنیا در معنای مثبت آن منظور حافظ است مثل مولانا یا خود حافظ که شور و غوغایی با مفاهیم خود در دنیا به پا کرده اند )"],[469,"آدمی در عالم خاکی نمی‌آید به دست","عالمی دیگر بباید ساخت وز نو آدمی","در این عالم خاک انسان واقعی پیدا نمی­شود باید جهان دیگری ساخت و دوباره انسان دیگری آفرید.(نکته: شاید بتوان بین آدم و خاک هم ارتباط معنایی پیدا کرد. با توجه به ساخته شدن آدم از خاک بنابر آیات قرآن.)"],[469,"خیز تا خاطر بدان ترک سمرقندی دهیم","کز نسیمش بوی جوی مولیان آید همی","برخیز تا به آن زیباروی سمرقندی دل دهیم و عاشق او شویم زیرا از نسیم خوش او، بوی زندگی بخش جوی مولیان به مشام می­رسد."],[469,"گریه حافظ چه سنجد پیش استغنای عشق","کاندر این دریا نماید هفت دریا شبنمی","در برابر بی­ نیازی عشق، گریه حافظ هیچ ارزش و اعتباری ندارد؛ زیرا تمام دریاهای عالم در برابر دریای عشق، به اندازه قطره شبنمی هم، ارزش و اعتبار ندارد."],[470,"ز دلبرم که رساند نوازش قلمی","کجاست پیک صبا گر همی کند کرمی؟","من از دلبرم یاد و محبت را در کجا بیابم؟ پیک صبا (فرشته جاودان در اشعار) کجاست که اگر برآید، می‌تواند خبر عشق را به من بگوید؟"],[470,"قیاس کردم و تدبیر عقل در ره عشق","چو شبنمی است که بر بحر می‌کشد رقمی","در عشق، عقل و تدبیر به اندازه شبنمی است که بر روی دریا خطی می‌کشد و به همین دلیل، حالت آن ناپایدار و ناتوان است."],[470,"بیا که خرقه من گرچه رهن میکده‌هاست","ز مال وقف نبینی به نام من درمی","بیا که لباس زهد و رهبانی من، هرچند که در میکده‌ها به امانت گذاشته شده، اما به نام من پولی به چشم نمی‌خورد."],[470,"حدیث چون و چرا درد سر دهد ای دل","پیاله گیر و بیاسا ز عمر خویش دمی","ای دل، نگران کنکاش در موضوعاتی که ممکن است برایت دردسرساز شود، نباش. بهتر است لحظه‌ای استراحت کنی و از زندگی‌ات لذت ببری."],[470,"طبیب راه‌نشین درد عشق نشناسد","برو به دست کن ای مرده‌دل مسیح‌دمی","این شاعر به کسی که در عشق دچار درد و رنج است می‌گوید: پزشکانی که در کنار راه نشسته‌اند، درد عشق را نمی‌فهمند. پس ای مرده‌دل، مانند مسیح که به مردگان زندگی می‌بخشد، به خودت حیات بده."],[470,"دلم گرفت ز سالوس و طبل زیر گلیم","به آن که بر در میخانه برکشم علمی","دل من از نفاق و تظاهر مردم گرفته شده است و به همین خاطر تصمیم دارم برای نشان دادن اعتراض و اعتنای خود، علم و پرچمی را در دروازه میخانه برافراشته کنم."],[470,"بیا که وقت‌شناسان دو کون بفروشند","به یک پیاله می صاف و صحبت صنمی","بیا که کسانی که به وقت‌شناسی معروف‌اند، دنیا و آخرت را به یک پیاله شراب صاف و گفتگو با یار می‌فروشند."],[470,"دوام عیش و تنعم نه شیوه عشق است","اگر معاشر مایی بنوش نیش غمی","دوام لذت و خوش‌گذرانی را نمی‌توان به عنوان شیوه عشق در نظر گرفت؛ اگر تو هم‌نشین ما هستی، بهتر است از تلخی‌های زندگی بنوشی و غم را احساس کنی."],[470,"نمی‌کنم گله‌ای لیک ابر رحمت دوست","به کشته‌زار جگرتشنگان نداد نمی","من از محبوب هیچ شکایتی ندارم، اما ابر رحمت او باران رحمتش را بر باغ‌های دل شکیبایان نرسانید و باعث افزایش محبت نشد."],[470,"چرا به یک نی قندش نمی‌خرند آن کس","که کرد صد شکرافشانی از نی قلمی","چرا آن کسی که با قلمش زیبایی‌های زیادی آفریده، نمی‌تواند قند یک نی را بخرد؟ این اشاره به بی‌اعتنایی و کم‌محلی به ارزش کارهای او دارد."],[470,"سزای قدر تو شاها به دست حافظ نیست","جز از دعای شبی و نیاز صبحدمی","سزا و ارزش تو ای پادشاه به دست حافظ تعیین نمی‌شود، بلکه تنها از طریق دعا در شب و نیاز و عبادت در سحرگاه به دست می‌آید."],[471,"احمد الله علی معدلة السلطان","احمد شیخ اویس حسن ایلخانی","به خاطر رفتار درست و انصاف‌محور سلطان احمد، شیخ اویس حسن ایلخانی خدارا شکر می‌گویم."],[471,"خان بن خان و شهنشاه شهنشاه‌نژاد","آن که می‌زیبد اگر جان جهانش خوانی","حافظ در این بیت به ستایش شخصیتی بزرگ و معتبر پرداخته که در مقام او می‌توان او را خان (رئیس قبیله) و شاه (پادشاه) دانست. او را به قدری بزرگ می‌داند که اگر جان جهان را هم برایش بخوانند، شایسته‌اش است."],[471,"دیده نادیده به اقبال تو ایمان آورد","مرحبا ای به چنین لطف خدا ارزانی","دیده‌ی بی‌خبر از تو، به برکت تو خوشبختی و سعادت را دریافت کرد و از این رو، سلام بر تو که لطف خدا به این صورت به تو داده شده است."],[471,"ماه اگر بی تو برآید به دو نیمش بزنند","دولت احمدی و معجزه سبحانی","اگر ماه بدون تو طلوع کند، آن را به دو نیم می‌کنند، چون درخشش و خوشبختی احمدی (احمد) و معجزه پروردگار با تو همراه است."],[471,"جلوه بخت تو دل می‌برد از شاه و گدا","چشم بد دور که هم جانی و هم جانانی","خوشبختی تو آن‌قدر درخشان است که دل هر دو گروه، یعنی شاهان و گدایان را می‌رباید. چشم بد دور از تو، چون تو هم روح را می‌پذیری و هم زندگی را."],[471,"برشکن کاکل ترکانه که در طالع توست","بخشش و کوشش خاقانی و چنگزخانی","موهای بافته و زیبای دختران ترک را بشکن، زیرا در سرنوشت تو، بخشش و تلاش خاقانی (شاعر نامدار) و چنگزخانی (شخصیت‌های شاعری مرتبط) وجود دارد."],[471,"گر چه دوریم به یاد تو قدح می‌گیریم","بعد منزل نبود در سفر روحانی","هرچند که ما از تو دور هستیم، اما به یاد تو جام می‌نوشیم؛ فاصله مکانی در سفر معنوی مانع ارتباط ما با تو نیست."],[471,"از گل پارسیم غنچه عیشی نشکفت","حبّذا دجله بغداد و می ریحانی","به طعنه می‌گوید که با اینکه ما از گلی در پارس هستیم، خوشی و شادی به وجود نیامده است. از طرفی، دجله بغداد و شراب خوش‌عطر را بسیار می‌پسندد."],[471,"سر عاشق که نه خاک در معشوق بود","کی خلاصش بود از محنت سرگردانی","عاشق، اگرچه بر خاک معشوق سر گذاشته باشد، باز هم از درد و رنج در زندگی خود رهایی نخواهد یافت."],[471,"ای نسیم سحری خاک در یار بیار","که کند حافظ از او دیده دل نورانی","ای نسیم سحرگاه، خاکی از یار (معشوق) بیاور که حافظ بتواند با آن، چشمان دلش را نورانی کند."],[472,"وقت را غنیمت دان آن قدر که بتوانی","حاصل از حیات ای جان این دم است تا دانی","زمان را غنیمت بشمار و از آن بهترین استفاده را ببر، زیرا حاصل زندگی، همین لحظه‌ای است که در آن قرار داری."],[472,"کام‌بخشی گردون عمر در عوض دارد","جهد کن که از دولت داد عیش بستانی","خدایان و سرنوشت عمر انسان به راحتی به او خوشی و لذتی نمی‌دهند، بنابراین باید تلاش کنی تا از خوشی‌ها و نعمت‌های زندگی بهره‌مند شوی."],[472,"باغبان چو من زین جا بگذرم حرامت باد","گر به جای من سروی غیر دوست بنشانی","اگر من، باغبان این باغ، از اینجا بروم، حرام باد بر تو اگر به جای من، درختی غیر از دوست را در این باغ بکاری."],[472,"زاهد پشیمان را ذوق باده خواهد کشت","عاقلا! مکن کاری کآورد پشیمانی","فردی که به دلیل تظاهر به زهد از لذت باده نوشی محروم شده، به خاطر عشق به شراب دچار دردسر شده است، پس ای عاقل کاری نکن که باعث پشیمانی شود."],[472,"محتسب نمی‌داند این قدر که صوفی را","جنس خانگی باشد همچو لعل رمانی","محتسب (ناظر مذهبی) نمی‌داند که صوفی (عارف) چقدر باطن زیبایی دارد و احساسی لطیف دارد، مانند لعل (زمرد) رمانی که در خانه‌ها یافت می‌شود."],[472,"با دعای شب‌خیزان ای شکردهان مستیز","در پناه یک اسم است خاتم سلیمانی","با دعای افرادی که در شب بیدارند و از خدا طلب آمرزش می‌کنند، نباید به کسی که شیرین‌دهن و خوش صحبت است، نیازی داشته باشی؛ زیرا در پناه نام خداوند (که به اسم خاتم سلیمانی اشاره دارد)، می‌توانی از هرگونه گرفتاری جلوگیری کنی."],[472,"پند عاشقان بشنو و از در طرب بازآ","کاین همه نمی‌ارزد شغل عالم فانی","ای عاشقان، نصیحت‌های مرا بشنوید و از در شادی و خوشدلی بازگردید، زیرا این همه چیزهایی که در این دنیا مهم به نظر می‌رسند، ارزش داشتن را ندارند و کار در این دنیا فانی بیهوده است."],[472,"یوسف عزیزم رفت ای برادران رحمی","کز غمش عجب بینم حال پیر کنعانی","یوسف عزیزم، یعنی یوسف، که به برادرانش اشاره دارد، رفته و حالا من به خاطر غم او تعجب می‌کنم که حال پیر کنعانی (یعنی یعقوب) هم به چه وضعی درآمده است."],[472,"پیش زاهد از رندی دم مزن که نتوان گفت","با طبیب نامحرم حال درد پنهانی","با زاهد (مرد متدین) از حال رندی و لذت‌جویی صحبت نکن، زیرا نمی‌توان با پزشک غیردوست درد پنهان را در میان گذاشت."],[472,"می‌روی و مژگانت خون خلق می‌ریزد","تیز می‌روی جانا ترسمت فرومانی","تو در حال رفتن هستی و مژگان زیبا و بلندت مانند چاقو دل مردم را می‌شکافد. ای جانا، تو چنان تند می‌روی که می‌ترسم بخواهی از بین بروی و دیگر برنگردی."],[472,"دل ز ناوک چشمت گوش داشتم لیکن","ابروی کماندارت می‌برد به پیشانی","دل من به تیر چشمان تو آسیب‌دیده بود، اما ابروی کمانی تو آن‌قدر فریبنده است که حواسم را پرت می‌کند و باعث می‌شود دیگر فکر نکنم."],[472,"جمع کن به احسانی حافظ پریشان را","ای شکنج گیسویت مجمع پریشانی","حافظ از کسی خواسته است که با نیکی و محبت، او را که در پریشانی و غم به سر می‌برد، آرام کند. همچنین به او اشاره می‌کند که زیبایی و پیچیدگی موهایش باعث پریشانی و سردرگمی او شده است."],[472,"گر تو فارغی از ما ای نگار سنگین‌دل","حال خود بخواهم گفت پیش آصف ثانی","اگر تو از ما بی‌خبری، ای معشوق سنگین‌دل، می‌خواهم حال خود را به آصف ثانی (که شخصیتی حکیم و عاقل است) بگویم."],[473,"هواخواه توام جانا و می‌دانم که می‌دانی","که هم نادیده می‌بینی و هم ننوشته می‌خوانی","عزیزم من عاشق تو هستم و می‌دانم که تو هم این مطلب را می دانی؛ زیرا تو هم آنچه را که دیدنی نیست، می‌بینی و هم آنچه را که نوشته نشده است، می‌خوانی."],[473,"ملامت‌گو چه دریابد میان عاشق و معشوق؟","نبیند چشم نابینا خصوص اسرار پنهانی","سرزنشگر، از آنچه میان عاشق و معشوق می گذرد، چه می فهمد!؟ شخص نابینا، هیچ چیز، خصوصا اسرار پنهانی را نمی بیند."],[473,"بیفشان زلف و صوفی را به پابازی و رقص آور","که از هر رقعه دلقش هزاران بت بیفشانی","موی خود را در هم بریز و [با این کار] صوفی را به پایکوبی و رقص بیاور تا [در اثر رقص] از هر تکه لباسش هزاران بت بیرون بیاندازی."],[473,"گشاد کار مشتاقان در آن ابروی دلبند است","خدا را یک نفس بنشین گره بگشا ز پیشانی","باز شدن گره زندگی مشتاقانت، وابسته به ابروی دلبند توست؛ تو را به خدا، یک لحظه بنشین و گره از ابروی خود باز کن [و با این کار، گره از زندگی مشتاقانت بگشا]"],[473,"ملک در سجده آدم زمین بوس تو نیت کرد","که در حسن تو لطفی دید بیش از حد انسانی","فرشتگان به هنگام سجده بر آدم، زمین بوسی تو را نیت کردند[و به انگیزه زمین بوسی تو، بر او سجده کردند]؛ زیرا در زیبایی تو، ظرافت‌های فرا انسانی مشاهده کردند."],[473,"چراغ افروز چشم ما نسیم زلف جانان است","مباد این جمع را یا رب غم از باد پریشانی","خدایا روشنایی بخش چشم ما عاشقان، نسیم موی معشوق است؛ بنابراین، نگران پریشانی حاصل از عشق، نیستیم."],[473,"دریغا عیش شب‌گیری که در خواب سحر بگذشت","ندانی قدر وقت ای دل مگر وقتی که درمانی","حیف از لحظاتی که به جای لذت خلوت شبانه با معشوق، به خواب گذشت؛ ای دل، تو جز وقتی که فرصتها را از دست بدهی و درمانده شوی، قدر آنها را نمی دانی."],[473,"ملول از همرهان بودن طریق کاردانی نیست","بکش دشواری منزل به یاد عهد آسانی","از همراهان زندگی، ملول و ناراحت بودن، منطقی و هوشمندانه نیست؛ دشواری زندگی را به امید روزهای آسانی، تحمل کن."],[473,"خیال چنبر زلفش فریبت می‌دهد حافظ","«نگر تا حلقه اقبال ناممکن نجنبانی»","حافظ مراقب باش که خیال موی معشوق، موجب فریبت می شود؛ و مراقب باش که سراغ آینده ناممکن نروی."],[474,"گفتند خلایق که تویی یوسف ثانی","چون نیک بدیدم به حقیقت به از آنی","خلایق می‌گویند که تو همان یوسف دوم هستی، اما وقتی که بهتر نگاه و تفکر کردم فهمیدم که از آن هم بهتری."],[474,"شیرین‌تر از آنی به شکرخنده که گویم","ای خسرو خوبان که تو شیرین زمانی","تو به اندازه‌ای خوش‌رو و دلپذیر هستی که حتی در مقایسه با شیرینی عسل، لبخند تو از آن هم شیرین‌تر است، و من به عنوان یک مداح تو، ای پادشاه زیبایی‌ها، به تو می‌گویم که زمان تو شیرین است."],[474,"تشبیه دهانت نتوان کرد به غنچه","هرگز نبود غنچه بدین تنگ دهانی","دهان تو را نمی‌توان به غنچه تشبیه کرد، زیرا هیچ غنچه‌ای به اندازه دهان تو تنگ نیست."],[474,"صد بار بگفتی که دهم زان دهنت کام","چون سوسن آزاده چرا جمله زبانی؟","صد بار گفتى که از دهان خود کام تو را مى‌دهم؛چرا مانند سوسن آزاده سراپا زبان هستى؟[يعنى چرا فقط وعده مى‌دهى و عمل نمى‌کنى؟مقصود از سوسن آزاده،سوسن سفيد است که پنج‌برگ و پنج کاسبرگ دارد و معمولا برگ‌هاى آن را به زبان مانند مى‌کنند.از اين رو به آن سوسن ده‌زبان هم مى‌گويند.«چرا جمله زبانى»ناظر بر همين ويژگى سوسن است.گويى سراپاى سوسن زبان‌است.]"],[474,"گویی بدهم کامت و جانت بستانم","ترسم ندهی کامم و جانم بستانی","به نظر می‌رسد که اگر من بخواهم به تو لذتی بدهم و جانت را بگیرم، نکنه تو به من لذت ندهی و جان من را بگیری."],[474,"چشم تو خدنگ از سپر جان گذراند","بیمار که دیده‌ست بدین سخت کمانی","چشم تو مانند تیغی است که جان مرا جریحه‌دار کرده و بیمار کسی است که چنین تیرگی را با این شدت دیده است."],[474,"چون اشک بیندازیش از دیده مردم","آن را که دمی از نظر خویش برانی","وقتی که تو اشک را از چشمان مردم بریزی، آن اشک را به کسی نسبت می‌دهی که به زودی از دید خود دورش کرده‌ای."],[475,"نسیم صبح سعادت! بدان نشان که تو دانی","گذر به کوی فلان کن، در آن زمان که تو دانی","نسیم صبح خوشبختی! به نشانه‌ای که تو می‌دانی، در آن زمان که تو می‌دانی، به کوی فلان برو."],[475,"تو پیک خلوت رازی و دیده بر سر راهت","به مردمی نه به‌فرمان چنان بران که تو دانی","تو در خلوت پیام‌آور اسراری و علاقمندان، چشم‌انتظارت هستند؛ امور را آنچنان که می‌دانی مهربانانه تدبیر کن نه به حکم و اجبار."],[475,"بگو که جان عزیزم ز دست رفت، خدا را","ز لعل روح‌فزایش ببخش آن که تو دانی","بگو که جان ارزشمندم از دست رفت و از خدا خواهش می‌کنم که آن فردی را که تو می‌دانی، به خاطر لعل (لب یا زیبایی) روح‌افزایش ببخشد."],[475,"من این حروف نوشتم، چنان که غیر ندانست","تو هم ز روی کرامت، چنان بخوان که تو دانی","من این نوشته‌ها را گفتم، به گونه‌ای که کسی جز تو نفهمید. تو نیز با توجه به بزرگواری‌ات، آن را به شیوه‌ای بخوان که خود می‌دانی."],[475,"خیال تیغ تو با ما، حدیث تشنه و آب است","اسیر خویش گرفتی، بکش چنان که تو دانی","تصور تیغ تو برای ما مانند داستان تشنگی و آب شده است. تو ما را به دام محبت خود درآورده‌ای، حالا هر گونه که بخواهی با ما رفتار کن."],[475,"امید در کمر زرکشت چگونه ببندم؟","دقیقه‌ای است نگارا در آن میان که تو دانی","چگونه می‌توانم به امید و آرزو در کمربند طلا و ز serving تو تکیه کنم؟ ای محبوب، فقط تو می‌دانی در این لحظه چه احساسی دارم."],[475,"یکی است ترکی و تازی، در این معامله حافظ","حدیث عشق بیان کن، بدان زبان که تو دانی","حافظ می‌گوید که در میان عشق و روابط عشقی، زبانی وجود دارد که ترکی (زبان ترک‌ها) و تازی (زبان عربی) را به هم می‌آمیزد. او از معشوق می‌خواهد که داستان عشق را به زبانی بیان کند که خودش می‌فهمد، یعنی به شیوه‌ای که برای او آشناست."],[476,"دو یار زیرک و از باده کهن دو منی","فراغتی و کتابی و گوشه چمنی","دو دوست فهیم و باهوش و باتجربه و از شراب قدیمی در کنار هم به دور از دغدغه‌ها نشسته‌اند و در آرامش گوشه‌ای از باغ، کتابی می‌خوانند و از زندگی لذت می‌برند."],[476,"من این مقام به دنیا و آخرت ندهم","اگر چه در پی‌ام افتند هر دم انجمنی","من این موقعیت و حالت آرامش خود را به هیچ چیز در دنیا و آخرت نمی‌دهم، حتی اگر هر لحظه گروهی به دنبال من بیفتند و مرا به وجد بیاورند."],[476,"هر آن که کنج قناعت به گنج دنیا داد","فروخت یوسف مصری به کمترین ثمنی","هر کسی که به رضایت و قناعت از زندگی را به خاطر مال دنیا از دست داد، مانند کسی است که ارزش‌های بزرگ را به خاطر چیزهای کم و ناچیز از دست می‌دهد."],[476,"بیا که رونق این کارخانه کم نشود","به زهد همچو تویی، یا به فسق همچو منی","بیا تا رونق این دنیا کم نشود، چه با پرهیزکاری و زهد تو، چه با گناه و فسق من."],[476,"ز تندباد حوادث نمی‌توان دیدن","در این چمن که گلی بوده است یا سمنی","در اثر حوادث و تغییرات سریع، نمی‌توان در این باغ تشخیص داد که آیا گلی بوده یا سمنی، یعنی نشانه‌ها و زیبایی‌های گذشته تحت تأثیر مشکلات فراموش شده‌اند."],[476,"ببین در آینه جام، نقش‌بندی غیب","که کس به یاد ندارد چنین عجب زمنی","در آینه جام، تصاویری از دنیای پنهان و غیب را ببین که هیچ‌کس به خاطر ندارد که چنین زمان شگفت‌انگیزی وجود داشته است."],[476,"از این سموم که بر طرف بوستان بگذشت","عجب که بوی گلی هست و رنگ نسترنی","به رغم وزش بادهای گرم و سمی که برکنار باغ می‌گذرد، جای تعجب است که هنوز بویی از گل و رنگی از نسترن در اینجا موجود است."],[476,"به صبر کوش تو ای دل که حق رها نکند","چنین عزیز نگینی به دست اهرمنی","ای دل، تلاش کن که صبر را پیشه خود کنی؛ زیرا خداوند کسی را که این‌چنین عزیز و باارزش است، رها نخواهد کرد و او را به دست موجودی شرور نخواهد سپرد."],[476,"مزاج دهر تبه شد در این بلا حافظ","کجاست فکر حکیمی و رای برهمنی؟","حالت زمانه در این بلا به هم ریخته است. حافظ از کجا می‌تواند به فکر حکیمی یا رأی یک آدم دین‌دار (برهمن) باشد؟"],[477,"نوش کن جام شراب یک منی","تا بدان بیخ غم از دل برکنی","با تجربه کردن تمام عیار عشق الهی، از بند غصه ها و تعلقات دنیایی خلاص خواهی شد."],[477,"دل، گشاده دار چون جام شراب","سر گرفته چند چون خمّ دنی","دل را بایستی گشاده و باز نگه‌داری، مانند جام شرابی که در دست است؛ چرا که گاه دل آدمی باید از غم‌ها و مشکلات خالی باشد، مانند ظرفی که پر از شراب است."],[477,"چون ز جام بی‌خودی رطلی کشی","کم زنی از خویشتن لاف منی","وقتی از جام بی‌خودکننده سستی می‌کشی، نباید از خودت به گونه‌ای بزرگ‌منشانه صحبت کنی و به خودت لاف بزنی."],[477,"سنگسان شو، در قدم نی همچو آب","جمله رنگ‌آمیزی و تردامنی","به حالت سنگی درآ، در قدمت نه مانند آب، بلکه همه چیز را زیبا و شیرین کن و به لطافت و ظرافت درآ."],[477,"دل به می دربند تا مردانه‌وار","گردن سالوس و تقوا بشکنی","دل را به شراب بسپار تا با جسارت تمام ریاکاری و تظاهر را کنار بگذاری."],[477,"خیز و جهدی کن چو حافظ تا مگر","خویشتن در پای معشوق افکنی","برخیز و تلاشی انجام ده مانند حافظ تا شاید بتوانی خود را در پای معشوق بیندازی و تسلیم عشق او شوی."],[478,"صبح است و ژاله می‌چکد از ابر بهمنی","برگ صبوح ساز و بده جام یک منی","صبح است و شبنم از ابر بهمنی (ابر زمستانی) می‌چکد. بگذار می را به ما بدهی تا حال و هوای دل را تازه کنیم و سرمست شویم."],[478,"در بحر مایی و منی افتاده‌ام، بیار","می تا خلاص بخشدم از مایی و منی","در دنیای عشق تو غرق شده‌ام و در حالتی از عشق و هستی (مائی و منی) به سر می‌برم، بیا شراب بیاور تا از این حالت و وابستگی رهایی یابم."],[478,"خون پیاله خور که حلال است خون او","در کار یار باش که کاری‌ست کردنی","شراب را بنوش که حلال است و ارتباط با یار را مثل یک اقدام ضروری تلقی کن، زیرا این کار نیازمند عمل است."],[478,"ساقی به دست باش که غم در کمین ماست","مطرب نگاه دار همین ره که می‌زنی","ساقی، همیشه در کنار ما باش چون غم و اندوه در انتظار ماست. ای مطرب، همین راهی را که در پیش داری ادامه بده و رهایمان نکن."],[478,"می ده که سر به گوش من آورد چنگ و گفت","«خوش بگذران و بشنو از این پیر منحنی»","نوشیدنی را بده که موسیقی‌دان به من نزدیک شد و گفت: «خوش بگذران و از این پیر خمیده (که به احتمال زیاد اشاره به کسی حکیم یا سالخورده است) گوش کن."],[478,"ساقی به بی‌نیازی رندان که می بده","تا بشنوی ز صوت مغنی «هو الغنی»","ساقی به رندان بی‌نیاز، می‌دهد تا صدای خواننده را بشنوی که می‌گوید: «او بی‌نیاز است»."],[479,"ای که در کشتن ما هیچ مدارا نکنی","سود و سرمایه بسوزی و محابا نکنی","ای کسی که در قتل و آزار ما هیچ نرمش و شفقتی به خرج نمی‌دهی، حتی اگر سود و سرمایه‌ات را به خطر بیندازی، باز هم احساس ترس و احتیاط نمی‌کنی."],[479,"دردمندان بلا زهر هلاهل دارند","قصد این قوم خطا باشد هان تا نکنی","دردمندان، به خاطر مصیبت‌هایی که تحمل می‌کنند، مانند زهر هلاهل (زهر کشنده) درد دارند. اگر این گروه خطاکار (مسبب دردها) به فکر تغییر و جبران نباشند، عواقب بدی در انتظارشان خواهد بود."],[479,"رنج ما را که توان برد به یک گوشه چشم","شرط انصاف نباشد که مداوا نکنی","درد هایم را میتوانی با گوشه چشمی پایان دهی، این شرط انصاف نیست ک این درمان را از من دریغ کنی و من را مداوا نکنی"],[479,"دیده ما چو به امید تو دریاست، چرا","به تفرج گذری بر لب دریا نکنی؟","چشم ما امیدوار به توست و مانند دریا وسیع و پربار است، چرا با حضورت به ما سر نزنید و از زیبایی ما بهره‌مند نشوید؟"],[479,"نقل هر جور که از خلق کریمت کردند","قول صاحب غرضان است تو آن‌ها نکنی","هر گونه سخنی که درباره تو از دیگران می‌گویند، به خاطر اهداف خودشان است و تو نباید به آن‌ها توجه کنی."],[479,"بر تو گر جلوه کند شاهد ما ای زاهد","از خدا جز می و معشوق تمنا نکنی","ای زاهد، اگر معشوق ما به تو جلوه کند، از خدا چیزی جز شراب و معشوق را درخواست نکن."],[479,"حافظا سجده به ابروی چو محرابش بر","که دعایی ز سر صدق جز آن جا نکنی","ای حافظ دعاهایت را به ابروی یار که شبیه محراب است ببر که تو هیچ جا به جز نزد یار از سر صداقت دعا نمی کنی"],[480,"بشنو این نکته که خود را ز غم آزاده کنی","خون خوری گر طلب روزی ننهاده کنی","اگر می‌خواهی از غم و اندوه رها شوی و آزاد باشی، این نکته را خوب گوش کن. اگر خون خود را به خاطر طلب روزی نریزی و به دنبال روزی حلال باشی، به آرامش دست خواهی یافت."],[480,"آخرالامر گل کوزه‌گران خواهی شد","حالیا فکر سبو کن که پر از باده کنی","در نهایت، تو به گل و خاک تبدیل خواهی شد، پس اکنون به این فکر کن که چگونه می‌توانی سبویی (ظرفی برای نوشیدنی) بسازی که پر از شراب باشد."],[480,"گر از آن آدمیانی که بهشتت هوس است","عیش با آدمی‌یی چند پری‌زاده کنی","اگر می‌خواهی به انسان‌های خوبی که آرزوی بهشت را داری نزدیک شوی، با چند نفر از افرادی که به فرشتگان شباهت دارند، انس بگیر و از زندگی لذت ببر."],[480,"تکیه بر جای بزرگان نتوان زد به گزاف","مگر اسباب بزرگی همه آماده کنی","نمی‌توان به‌سادگی بر جایگاه بزرگ‌ترها تکیه زد و اعتبار آن‌ها را به دست آورد، مگر اینکه همه شرایط و ویژگی‌های لازم برای به بزرگ شدن را فراهم کنی."],[480,"اجرها باشدت ای خسرو شیرین‌دهنان","گر نگاهی سوی فرهاد دل‌افتاده کنی","اگر تو، ای خسرو زبانی شیرین و دلربا، به فرهاد که دلی شکسته و ناامید دارد نگاهی بیندازی، پاداش خوبی‌هایت بسیار خواهد بود و مورد محبت و احترام قرار خواهی گرفت."],[480,"خاطرت کی رقم فیض پذیرد، هیهات!","مگر از نقش پراگنده ورق ساده کنی","خاطرت چگونه می‌تواند از نعمت و لطف بهره‌مند شود، غیر ممکن است! مگر اینکه ورق ساده و بدون نقش و نگار را آماده کنی."],[480,"کار خود گر به کرم بازگذاری حافظ","ای بسا عیش که با بخت خداداده کنی","اگر حافظ خود را به بزرگواری و کرم بسپارد، ممکن است نعمت‌ها و خوشی‌های زیادی را با سرنوشت خوبی که خدا به او داده، به دست آورد."],[480,"ای صبا بندگی خواجه جلال‌الدین کن","که جهان پر سمن و سوسن آزاده کنی","ای نسیم، درود و خدمتگزاری به خواجه جلال‌الدین (شمس تبریزی) داشته باش و با این کار، جهانی پر از گل‌های خوشبو و آزاد بساز."],[481,"ای دل! به کوی عشق گذاری نمی‌کنی","اسباب جمع داری و کاری نمی‌کنی","ای دل! چرا به کوی عشق نمی‌روی و در آنجا حضور نمی‌یابی؟ تو همه امکانات و شرایط را داری، اما هیچ اقدامی نمی‌کنی."],[481,"چوگان حکم در کف و گویی نمی‌زنی","باز ظفر به دست و شکاری نمی‌کنی","چوگان (بازی که با چوب و توپ انجام می‌شود) در دست داری اما شوق بازی نداری، در حالی که پیروزی و شکار در دست توست اما از این فرصت استفاده نمی‌کنی."],[481,"این خون که موج می‌زند اندر جگر تو را","در کار رنگ و بوی نگاری نمی‌کنی","این خون که در دل تو به تپش درآمده، نشان از عشق و احساسات عمیق تو دارد، اما تو در کار جذابیت و زیبایی معشوق، تلاشی نمی‌کنی و به آن اهمیت نمی‌دهی."],[481,"مشکین از آن نشد دم خلقت که چون صبا","بر خاک کوی دوست گذاری نمی‌کنی","تو به خاطر خلقتی که داری، مانند نسیم صبا بر خاک کوی دوست (یار) نمی‌گذرانی و دل به این کار نمی‌زنی."],[481,"ترسم کز این چمن نبری آستین گل","کز گلشنش تحمل خاری نمی‌کنی","ترس من این است که تو آستین خود را از میان گل‌ها برداری، زیرا از باغ گل هیچ خاری را تحمل نمی‌کنی."],[481,"در آستین جان تو صد نافه مدرج است","وآن را فدای طره یاری نمی‌کنی","در وجود تو زیبایی‌های فراوانی وجود دارد که می‌توان آنها را فدای موهای معشوق نکرده‌ات کرد، اما تو این کار را نمی‌کنی."],[481,"ساغر لطیف و دلکش و می، افکنی به خاک","واندیشه از بلای خماری نمی‌کنی","شراب خوش‌طعم و زیبا را به زمین می‌ریزی، در حالی که از عذاب ناشی از مستی غافل هستی و به آن توجه نمی‌کنی."],[481,"حافظ برو که بندگی پادشاه وقت","گر جمله می‌کنند، تو باری نمی‌کنی","حافظ می‌گوید که ای کسی که در می‌گساری غرق هستی، هرچند دیگران بندگی پادشاه زمانه را می‌پذیرند و تسلیم او می‌شوند، تو هیچ وقت به این کار تن نمی‌کنی."],[482,"سحرگه ره ‎روی در سرزمینی","همی گفت این معما با قرینی","در صبح زود، ره‌رویی در سرزمینی در حال حرکت بود و این معما را با یک همراه (قرین) می‌گفت."],[482,"که ای صوفی شراب آن گه شود صاف","که در شیشه برآرد اربعینی","ای صوفی! شراب (حکمت و معرفت تو) آن زمان صاف و خالص می‌شود که پس از ۴۰ روز (یا ۴۰ مرحله) ریاضت، در دل تو روشن و زلال شود."],[482,"خدا زان خرقه بیزار است صد بار","که صد بت باشدش در آستینی","خدا صد بار از آن خرقه (لباس صوفیانه) بیزار است، اگر در آستینش (درونش، پشت این ظاهر زاهدانه) صد بت پنهان باشد."],[482,"مروت گر چه نامی بی‌نشان است","نیازی عرضه کن بر نازنینی","مروت (جوانمردی) هرچند که اسمش بی‌معناست، بهتر است برای کسی که دلش به رحم می‌آید (نازنینی) نیازی را ارائه‌دهی یا کمک کنی."],[482,"ثوابت باشد ای دارای خرمن","اگر رحمی کنی بر خوشه‌چینی","در روزگاران پیشین، شغلی بنام خوشه‌چینی وجود داشت. آنها که دستشان تنگ بود و خرمن و مزرعه‌ای نداشتند، پشت سر دروگر‌ها راه می‌رفتند و خوشه‌های جامانده را از زمین بر می‌داشتند و گاه صاحب مزرعه به دروگران دستور میداد که شلخته درو کنند تا چیزی هم گیر خوشه‌چین‌ها بیاید. حافظ نيز در اين بیت به این موضوع اشاره دارد.ثوابت باشد ای دارای خرمن اگر رحمی کنی بر خوشه‌چینی"],[482,"نمی‌بینم نشاط عیش در کس","نه درمان دلی نه درد دینی","هیچ‌کس را نمی‌بینم که خوشحالی و شادی زندگی را تجربه کند، نه برای درمان دل‌های شکسته و نه برای رفع مشکلات دینی."],[482,"درون‌ها تیره شد باشد که از غیب","چراغی برکند خلوت‌نشینی","دل های جهانیان تیره شده ، کاش یک آدم درست پیدا بشود و جهان را به نوری روشنا کند"],[482,"گر انگشت سلیمانی نباشد","چه خاصیت دهد نقش نگینی؟","اگر چه بهترین علم ها دست کسی بیافتد، اگر انسان بزرگی نباشد هیچ سودی برای انسان ها و انسانیت ندارد"],[482,"اگر چه رسم خوبان تندخویی‌ست","چه باشد گر بسازد با غمینی؟","با این که شیوه‌ی زیبارویان، بدرفتاری و تندخویی با هواداران و عاشقان است، اگر زیبارویی با عاشق دل شکسته‌ به نرمی رفتار کند، چه اتفاقی می افتد؟"],[482,"ره میخانه بنما تا بپرسم","مآل خویش را از پیش‌بینی","من را به سمت میخانه راهنمایی کن تا بتوانم درباره سرنوشت خودم از پیشگوئی‌ها بپرسم."],[482,"نه حافظ را حضور درس خلوت","نه دانشمند را علم‌ الیقینی","نه حافظ در مجالس و نشست‌های خصوصی حاضر است و نه دانشمند به علم واقعی و قطعی دست یافته است."],[483,"تو مگر بر لب آبی به هوس بنشینی","ور نه هر فتنه که بینی همه از خود بینی","تو فقط بر لب آبی نشسته‌ای به خاطر هوس و اشتیاق، و اگر نه، هر مشکلات و فتنه‌هایی که می‌بینی، همه ناشی از خود تو است."],[483,"به خدایی که تویی بنده بگزیده او","که بر این چاکر دیرینه کسی نگزینی","من به خدای تو که تو بنده برگزیده او هستی و این چاکر قدیمی را رها نمی‌کنی، سوگند می‌خورم که هیچ‌کس دیگری را انتخاب نخواهی کرد."],[483,"گر امانت به سلامت ببرم باکی نیست","بی‌دلی سهل بود گر نبود بی‌دینی","اگر امانت را با احتیاط به مقصد برسانم، از هیچ چیز نمی‌ترسم. بی‌احساسی کار آسانی است، اگر بی‌دینی وجود نداشته باشد."],[483,"ادب و شرم تو را خسرو مه‌رویان کرد","آفرین بر تو که شایسته صد چندینی","شرم و ادب تو باعث شده است که مانند خسرو، پادشاه زیبا به نظر بیایی. آفرین بر تو که به راستی شایسته ویژگی‌های برتری هستی."],[483,"عجب از لطف تو ای گل که نشستی با خار","ظاهرا مصلحت وقت در آن می‌بینی","تو ای گل، جالب است که با وجود خردی و زیبایی‌ات، در کنار خار نشسته‌ای. به نظر می‌رسد که تو چنین انتخابی را به خاطر مصلحت و فایده‌ای که می‌بینی انجام داده‌ای."],[483,"صبر بر جور رقیبت چه کنم گر نکنم؟","عاشقان را نبود چاره به جز مسکینی","اگر بر نامهربانی‌ها و ظلم معشوقم صبر نکنم، چه کاری باید انجام دهم؟ عاشقان چاره‌ای جز فروتنی و مسکینی ندارند."],[483,"باد صبحی به هوایت ز گلستان برخاست","که تو خوش‌تر ز گل و تازه‌تر از نسرینی","باد صبحگاهی به خاطر تو از گلستان وزید، زیرا تو زیباتر از گل و تازه‌تر از گل سرخ هستی."],[483,"شیشه‌بازی سرشکم نگری از چپ و راست","گر بر این منظر بینش نفسی بنشینی","اشک های چشمم که همچون شیشه می‌درخشند را از چپ و راست می‌بینی اگر در این منظری که چشمانم عاشقانه چشم بسته لحظه‌ای بنشینی"],[483,"سخنی بی‌غرض از بنده مخلص بشنو","ای که منظور بزرگان حقیقت بینی","ای کسی که بزرگان را از روی بصیرت می‌بینی، سخنی بدون نیت و با صداقت از من که خواسته‌ام خدمتگزار تو باشم، بشنو."],[483,"نازنینی چو تو پاکیزه‌دل و پاک‌نهاد","بهتر آن است که با مردم بد ننشینی","بهتر است کسی مانند تو که دل و نیت پاکی دارد، با انسان‌های بد و ناپاک مشغول دوستی و نشست و برخاست نشود."],[483,"سیل این اشک روان صبر و دل حافظ برد","بلغ الطّاقة یا مقلة عینی بیني","این اشک‌های روان که همچون سیل هستند، ای نور دیده‌ام جدایی، توانم را رد کرده است. (از توانم خارج شده)"],[483,"تو بدین نازکی و سرکشی ای شمع چگل","لایق بندگی خواجه جلال‌الدینی","ای شمع (نور) زیبا و نازک، تو با این همه سرکشی و زیبایی، سزاوار آن هستی که تحت خدمت خواجه جلال‌الدین باشی."],[484,"ساقیا سایه ابر است و بهار و لب جوی","من نگویم چه کن ار اهل دلی خود تو بگوی","ای ساقی، سایه ابر و بهار و لب جوی در حال حاضر است، من نمی‌توانم بگویم چه باید کرد؛ تو که خود اهل دل هستی، بگو چه باید کرد."],[484,"بوی یک‌رنگی از این نقش نمی‌آید خیز","دلق آلوده صوفی به می ناب بشوی","بوی صداقت و یکدلی از این تصویر (عمل صوفی) متصوّر نمی‌شود، بنابراین برخیز و لباس آلوده صوفی را با شراب خالص بشوی که پاکی و صفا را به ارمغان آورد."],[484,"سفله‌طبع است جهان، بر کرمش تکیه مکن","ای جهان‌دیده! ثبات قدم از سفله مجوی","جهان به خاطر طبع پست و بی‌ارزشش، قابل اعتماد نیست و نمی‌توان به کرم و بخشندگی‌اش تکیه کرد. ای کسی که تجربه‌های زیادی در زندگی داشته‌ای، نباید از افرادی که ذات پست و سطحی دارند، ثبات و استقامت را طلب کنی."],[484,"دو نصیحت کنمت بشنو و صد گنج ببر","«از در عیش درآ و به ره عیب مپوی»","به تو دو نصیحت می‌کنم که خوب به آنها گوش بده و از آنها بهره‌مند شو. اول اینکه از زندگی لذت ببر و دوم اینکه به عیوب دیگران توجه نکن و در مورد آنها قضاوت نکن."],[484,"شکر آن را که دگربار رسیدی به بهار","بیخ نیکی بنشان و ره تحقیق بجوی","شکر نعمت را به‌جا آور که دوباره به زمان بهار (دوران شکوفایی و شادی) رسیده‌ای؛ ریشه کارهای نیک را در زندگی استوار کن و به دنبال حقیقت و شناخت واقعی باشید."],[484,"روی جانان طلبی، آینه را قابل ساز","ور نه هرگز گل و نسرین ندمد ز آهن و روی","برای دیدار معشوق، اگر آینه را قابل و شایسته کن؛ در غیر این صورت، گلی و نسرینی از آهن و روی (جسم) نخواهد رویید. این به این معنی است که باید خود را برای عشق و جمال محبوب آماده کرد، وگرنه چیزی زیبا به وجود نخواهد آمد."],[484,"گوش بگشای که بلبل به فغان می‌گوید","خواجه تقصیر مفرما گل توفیق ببوی","بلبل به شدت ناله و فریاد می‌زند که ای خواجه، تقصیر مرا نپذیر، بگذار گل خوشبویی از توفیق و موفقیت در دسترس باشد."],[484,"گفتی از حافظ ما بوی ریا می‌آید","آفرین بر نفست باد که خوش بردی بوی","تو گفتی که شعر حافظ بوی ریا می‌دهد، اما من به تو آفرین می‌گویم که نفس پاکی داری و بویی خوش از تو ساطع است."],[485,"بلبل، ز شاخ سرو، به گلبانگ پهلوی","می‌خواند دوش، درس مقامات معنوی","بلبل از شاخه سرو، صدای زیبایی را از خود خارج می‌کرد و در شب گذشته، به زیبایی و شیوایی درس‌هایی درباره مراتب روحانی و معنوی را می‌خواند."],[485,"یعنی بیا، که آتش موسی، نمود گل","تا از درخت، نکته توحید بشنوی","یعنی بیا، که آتش قدس موسی (موسی پیامبر) به گل تبدیل شده است، تا از درخت (وجود) نکته‌های یکتاپرستی را بشنوی."],[485,"مرغان باغ، قافیه‌سنجند و بذله‌گوی","تا خواجه می خورد، به غزل‌های پهلوی","پرندگان باغ شعر می‌سرایند و شوخی می‌کنند تا وقتی که خواجه، یعنی حافظ، شراب می‌نوشد، غزل‌های زیبا و دلنشین بسرایند."],[485,"جمشید، جز حکایت جام، از جهان نبرد","زنهار! دل مبند، بر اسباب دنیوی","برای جمشید (که شاه جهان بود) جز حکایت جام از این زندگی و دنیا چیزی نماند، پس تو نیز عبرت بگیر و بیاموز که به اسباب دنیا دل نبندی."],[485,"این قصّه عجب شنو از بخت واژگون","ما را بکشت یار، به انفاس عیسوی","این داستان شگفت‌انگیز را بشنوند که بخت بد ما را به خاطر دم‌های عیسی (پیشوای مذهبی) یار کشت و نابود کرد."],[485,"خوش، وقت بوریا و گدایی و خواب امن","کاین عیش، نیست درخور اورنگ خسروی","این روزها که در سختی و فقر به سر می‌برم و خواب آرامی دارم، این لذت و خوشی که می‌برم، به اندازه‌ای نیست که شایسته‌ی مقام والای شاهی باشد."],[485,"چشمت، به غمزه، خانه مردم، خراب کرد","مخموریـت مباد، که خوش مست می‌روی","چشم تو با ناز و حرکات خود، خانه مردم را ویران کرد. امیدوارم که ماری که به خاطر مستی به راه می‌روی، تو را از این حال دور کند، زیرا تو به خوبی مست و شاداب هستی."],[485,"دهقان سال‌خورده، چه خوش گفت با پسر","کای نور چشم من! به جز از کشته، ندروی","دهقان سال‌خورده به پسرش گفت، ای نور چشمانم! جز از محصول و زراعت، چیزی دیگر به دست نخواهی آورد."],[485,"ساقی، مگر وظیفه حافظ، زیاده داد","کآشفته گشت، طرّه دستار مولوی","ساقی، آیا این وظیفه حافظ است که بیش از حد به او شراب بدهی تا مولوی را در حالی که بی‌خود شده، با موهای آشفته‌اش ببینی؟"],[486,"ای بی‌خبر بکوش که صاحب‌خبر شوی","تا راهرو نباشی کی راهبر شوی؟","ای کسی که بی‌خبر هستی، تلاش کن تا به دانایی و آگاهی برسی، زیرا اگر در مسیر سیر نکنی، چگونه می‌توانی راهنمای کسانی باشی که در این مسیر قرار دارند؟"],[486,"در مکتب حقایق پیش ادیب عشق","هان ای پسر بکوش که روزی پدر شوی","در مکتب حقایق عشق، تلاش کن تا مانند پدر خود، انسانی کامل و فرهیخته شوی."],[486,"دست از مس وجود چو مردان ره بشوی","تا کیمیای عشق بیابی و زر شوی","برای اینکه به کیمیای عشق دست پیدا کنی و به مقام والاتری برسید، باید از مادیات و امور دنیوی رها شوی و مانند مردان بزرگ، خود را از بند این چیزها آزاد کنی."],[486,"خواب و خورت ز مرتبه خویش دور کرد","آن گه رسی به خویش که بی خواب و خور شوی","خواب و خوردن تو را از مقام و جایگاه واقعی‌ات دور کرده است. زمانی به خودت برمی‌گردی که از خواب و غذا بی‌نیاز شوی و به بالاترین حالت روحی برسید."],[486,"گر نور عشق حق به دل و جانت اوفتد","بالله کز آفتاب فلک خوب‌تر شوی","اگر نور عشق خدا در دل و جانت بتابد، به خدا قسم که از آفتاب آسمان هم بهتر خواهی شد."],[486,"یک دم غریق بحر خدا شو گمان مبر","کز آب هفت بحر به یک موی تر شوی","لحظه‌ای در دریا و وجود خدا غرق شو و فکر نکن که با یک قطره از آب هفت دریای دیگر خیس خواهی شد."],[486,"از پای تا سرت همه نور خدا شود","در راه ذوالجلال چو بی پا و سر شوی","اگر از پای تا سرت پر از نور خدا شود و در راه خداوند بزرگ (ذوالجلال) گام برداری، به گونه‌ای خواهی شد که هم مانند کسی بی‌پا و بی‌سر به حقیقت وصل شده‌ای."],[486,"وجه خدا اگر شودت منظر نظر","زین پس شکی نماند که صاحب‌نظر شوی","اگر چهره خداوند بر تو جلوه کند و به تو بنگرد، هیچ شکی باقی نمی‌ماند که تو نیز صاحب‌نظر و بینش خواهی شد."],[486,"بنیاد هستی تو چو زیر و زبر شود","در دل مدار هیچ که زیر و زبر شوی","اگر بنیاد وجود تو در زندگی تغییر کند، نباید به دل هیچ‌چیز به جز این موضوع توجه کنی که در این تغییر و تحول دچار نوسان شوی."],[486,"گر در سرت هوای وصال است حافظا","باید که خاک درگه اهل هنر شوی","اگر در ذهن تو آرزوی وصال معشوق وجود دارد، ای حافظ، باید به دامن اهل هنر و ادب بیفتی و تواضع کنی."],[487,"سحرم هاتف میخانه به دولت‌خواهی","گفت: باز آی که دیرینه این درگاهی","سحرگاه که میخواران میخانه را ترک می‌کنند هاتف میخانه به‌قصد دولت‌خواهی و نیکی به من گفت بازآ که تو دیرینه و پیشکسوت این درگاه هستی."],[487,"همچو جم جرعه ما کش که ز سرّ دو جهان","پرتو جام جهان‌بین دهدت آگاهی","همچون جمشید از باده ما بنوش تا جام جهان‌بین سرّ دو جهان را بر تو آشکار کند."],[487,"بر در میکده، رندان قلندر باشند","که ستانند و دهند افسر شاهنشاهی","درگاه میکده جای رندان قلندر و زیرکان پاک‌باز است که در آنجا تاج شاهی می‌گیرند و می‌بخشند."],[487,"خشت، زیر سر و بر تارک هفت‌اختر پای","دست قدرت نگر و منصب صاحب‌جاهی","در زیر سر خشتی گلین دارند و اما قدم‌شان بر هفت فلک است؛ مقام و قدرت‌شان را بنگر و ارزش آنها را."],[487,"سر ما و در میخانه که طرف بامش","به فلک بر شد و دیوار بدین کوتاهی","سر نیاز ما بر در میخانه است که با دیوار بدان کوتاهی از فلک بلند‌تر است."],[487,"قطع این مرحله بی‌همرهی خضر مکن","ظلمات است، بترس از خطر گمراهی","این راه را بی‌خضر مپیما که راهی است تاریک و ظلمات؛ و از گمراهی بیم داشته باش."],[487,"اگرت سلطنت فقر ببخشند، ای دل!","کمترین ملک تو از ماه بود تا ماهی","اگر به‌تو مقام بلندمرتبه فقر را ببخشند و بدهند؛ کمترین فرمان‌روایی تو و کمترین ملک تو از اوج آسمان تا قعر دریاست."],[487,"تو دم فقر ندانی زدن از دست مده","مسند خواجگی و مجلس تورانشاهی","تو افسون و دم فقر را نمی‌دانی و به‌آن مقام نرسیده‌ای پس بجای آن مسند و مجلس توران‌شاهی را دریاب."],[487,"حافظ خام‌طمع! شرمی از این قصّه بدار","عملت چیست که فردوس برین می‌خواهی‌؟","ای حافظ خام‌طمع و خوش‌خیال، دست از این آرزوهای بزرگ بردار؛ چه کرده‌ای که بهشت برین را توقع داری؟"],[488,"ای در رخ تو پیدا انوار پادشاهی","در فکرت تو پنهان، صد حکمت الهی","در چهره تو نشانه‌های سلطنت و زیبایی نمایان است و در دلت راز و اندیشه‌های خدایی زیادی نهفته است."],[488,"کلک تو بارک الله بر ملک و دین گشاده","صد چشمه آب حیوان از قطره سیاهی","قلم تو به راستی بر ملک و دین گشوده و برکت می‌آورد، و از یک قطره سیاهی، صد چشمه آب حیات را به وجود می‌آورد."],[488,"بر اهرمن نتابد انوار اسم اعظم","ملک آن توست و خاتم فرمای هر چه خواهی","بر نیروهای شیطانی نوری از نام بزرگ خدا نمی‌تابد، و سلطنت و قدرت واقعی از آن توست؛ تو هستی که هرچه بخواهی، فرمان می‌دهی."],[488,"در حکمت سلیمان هر کس که شک نماید","بر عقل و دانش او خندند مرغ و ماهی","هر کسی که به حکمت سلیمان شک کند، مرغ و ماهی به او می‌خندند و بر عقل و دانش او تمسخر می‌کنند."],[488,"باز ار چه گاه گاهی بر سر نهد کلاهی","مرغان قاف دانند آیین پادشاهی","اگرچه گاهی اوقات کسی بر سرش کلاهی می‌گذارد (به معنای به مقام و رتبه‌ای می‌رسد)، اما پرندگان قاف (که به دوره‌ای علمی و معرفتی اشاره دارد) می‌دانند که نشانه‌ی واقعی پادشاهی چیست."],[488,"تیغی که آسمانش از فیض خود دهد آب","تنها جهان بگیرد بی منّت سپاهی","شمشیری که بخت و تقدیرو اراده‌ی آسمانی آن را آبدیده کند (آبکاری فلزات برای استحکام آن) به دلیل اینکه مقدر شده پیروزمند باشد به تنهایی می‌تواند دنیا را بگیرد. یعنی آنچه اصل و شرط کار است فیض و مدد الهی است نه تلاش فردی، هرچند تلاش شخصی هم لازم است"],[488,"کلک تو خوش نویسد در شأن یار و اغیار","تعویذ جان‌فزایی افسون عمرکاهی","نقش و قلم تو به زیبایی درباره یار و دیگران می‌نویسد و برای زندگی بخشیدن به آن‌ها، به شیوه‌ای جادو مانند اثری را خلق می‌کند که عمر را کوتاه می‌کند."],[488,"ای عنصر تو مخلوق از کیمیای عزّت","و ای دولت تو ایمن از وصمت تباهی","ای انسان، تو از گنجینه‌ی ارزش و کرامت آفریده شده‌ای و برکت و خوشبختی‌ات از عیب و زوال در امان است."],[488,"ساقی بیار آبی از چشمه خرابات","تا خرقه‌ها بشوییم از عجب خانقاهی","بیار ای ساقی، آبی از چشمه خرابات (محل شراب‌خواری) تا لباس‌های زهد و رهبانی‌امان را از خودپرستی و تکبر پاک کنیم."],[488,"عمری‌ست پادشاها کز می تهی‌ست جامم","اینک ز بنده دعوی، وز محتسب گواهی","سال‌هاست که پادشاهی که در دست دارد، جام من از می خالی است و اکنون از طرف بنده‌ات ادعایی دارم، و محتسب (ناظر بر رفتار مردم) نیز گواهی می‌دهد."],[488,"گر پرتوی ز تیغت، بر کان و معدن افتد","یاقوت سرخ‌رو را بخشند رنگ کاهی","اگر پرتو تیغ تو بر زمین و معدن بیفتد، یاقوت سرخ که رنگش به شدت زیباست، رنگ کاهی می‌گیرد."],[488,"دانم دلت ببخشد بر عجز شب‌نشینان","گر حال بنده پرسی از باد صبحگاهی","می‌دانم که قلبت بر کسانی که شب‌ها را در غم و عجز می‌گذرانند، رحم می‌کند؛ اما اگر حال من را از باد صبحگاهی بپرسی، ممکن است در جواب بگویم که وضع و حال خوبی ندارم."],[488,"جایی که برق عصیان بر آدم صفی زد","ما را چگونه زیبد دعوی بی‌گناهی؟","مکانی که در آن، برافروختگی و طغیان بر آدم، انسانی بی‌گناه، ظاهر شد، چگونه می‌توانیم ادعای بی‌گناهی کنیم؟"],[488,"حافظ چو پادشاهت گهگاه می‌برد نام","رنجش ز بخت منما بازآ به عذرخواهی","حافظ می‌گوید: وقتی پادشاه تو گاهی نام من را به عنوان کسی که رنجیده شده یاد می‌کند، من را به یاد بیاور و دوباره برای عذرخواهی نزد من بازگرد."],[489,"در همه دیر مغان نیست چو من شیدایی","خرقه جایی گرو باده و دفتر جایی","در تمام میخانه‌ها و دیر‌های مغان عاشق و شیدایی مثل من یافت نمی‌شود در یکی خرقه‌ام را گرو گذاشته‌ام و در دیگری کتابم را."],[489,"دل که آیینه شاهی‌ست غباری دارد","از خدا می‌طلبم صحبت روشن‌رایی","دل انسان که مانند آینه‌ای است که باید همیشه صاف و روشن باشد، اما اکنون به خاطر خطاها و غفلت‌ها غبارآلود شده است. از خدا خواهانم که مرا به صحبت و دوستی با کسانی راهنمایی کند که روشنایی و آگاهی عطا می‌کنند."],[489,"کرده‌ام توبه به دست صنم باده‌فروش","که دگر می نخورم بی‌ رخ بزم‌آرایی","من به خاطر زیبایی و جذبه معشوق (صنم) که باده‌فروش است، از نوشیدن می توبه کرده‌ام، زیرا دیگر نمی‌خواهم می بنوشم؛ بدون حضور او در بزم که شادابی‌اش را به جمع می‌آورد."],[489,"نرگس ار لاف زد از شیوه چشم تو مرنج","نروند اهل نظر از پی نابینایی","اگر نرگس (گل نرگس) از زیبایی و خاص بودن چشم تو سخن بگوید، ناراحت نشو، زیرا اهل نظر و کسانی که فهم و تأمل دارند، هرگز به دنبال زیبایی‌های ظاهری نمی‌روند و چشم دلشان بینا است."],[489,"شرح این قصه مگر شمع برآرد به زبان","ورنه پروانه ندارد به سخن، پروایی","تنها شمع است که می‌تواند داستان عشق را بازگو کند، زیرا پروانه از عشق بی‌پرواست و در بیان احساساتش ناتوان است."],[489,"جوی‌ها بسته‌ام از دیده به دامان که مگر","در کنارم بنشانند سهی‌بالایی","چشمان خود را از اشک پر کرده‌ام و بر دامان (پوششی) خود می‌ریزم تا شاید کسی را که بال‌های زیبایی دارد، در کنارم بنشاند."],[489,"کشتی باده بیاور که مرا بی‌ رخ دوست","گشت هر گوشه چشم از غم دل، دریایی","باده را بیاور که بدون دیدن چهره دوست، هر طرفی که نگاه می‌کنم، غم دل‌ام مانند دریا وسیع شده است."],[489,"سخن غیر مگو با من معشوقه‌پرست","کز وی و جام می‌ام نیست به کس پروایی","با معشوقی که عاشق او هستم، در مورد چیزهای دیگر صحبت نکن، زیرا من از او و شرابم به هیچ‌کس اهمیت نمی‌دهم."],[489,"این حدیثم چه خوش آمد که سحرگه می‌گفت","بر در میکده‌ای، با دف و نی، ترسایی","از این حدیث خیلی‌خوشم آمد که سحرگاه ترسایی بر در میکده‌ای با دف و نی می‌خواند:"],[489,"«گر مسلمانی از این است که حافظ دارد","آه اگر از پی امروز بود فردایی»","این گونه که حافظ و دیگران خود را مسلمان می‌پندارند، فردا اگر قیامتی باشد وای به حال همه آن هاست"],[490,"به چشم کرده‌ام ابروی ماه‌سیمایی","خیال سبزخطی، نقش بسته‌ام جایی","به چشمانم ابروی زیبا و ماه‌مانند را منسوب کرده‌ام و در جایی از زندگی‌ام با تصویری از یاد معشوق و خط سبز او، به زیبایی نقش بسته‌ام."],[490,"امید هست که منشور عشق‌بازی من","از آن کمانچه ابرو رسد به طغرایی","امیدوارم که احساس عشق و عاشق‌پیشگی‌ام از آن کمان ابرویی که شبیه طغرا (امضای شاه) است، به وجود آید."],[490,"سرم ز دست بشد، چشم از انتظار بسوخت","در آرزوی سر و چشم مجلس‌آرایی","سرم از دست رفت و چشمم از انتظار سوخت در خیال سر و چهره زیبای کسی که مجالس را زینت می‌برد."],[490,"مکدّر است دل، آتش به خرقه خواهم زد","بیا! ببین! که کرا می‌کند تماشایی","دل من تیره و نابسامان است و می‌خواهم آتش به این لباس روحانی خود بزنم. بیا و ببین که چه کسی می‌تواند این نمایش را تماشا کند."],[490,"به روز واقعه، تابوت ما ز سرو کنید","که می‌رویم به داغ بلندبالایی","در روز قیامت، تابوت ما را با چوب سرو مانند بسازید، زیرا می‌رویم به خاطر مصیبتی بزرگ و اندوهی عمیق."],[490,"زمام دل به کسی داده‌ام من درویش","که نیستش به کس از تاج و تخت، پروایی","من من خود را به دل کسی سپرده‌ام که او نه به تاج و تخت اهمیت می‌دهد و نه به مقام و قدرت دیگران، زیرا من یک درویش هستم و دلبسته‌اش."],[490,"در آن مقام که خوبان ز غمزه، تیغ زنند","عجب مدار سری اوفتاده در پایی","در جایی که زیبایان با یک نگاه، ضربه‌ای مهلک می‌زنند، تعجب نکن که کسی به خاطر عشق به آن‌ها احساس ذلت کرده و به خاک بیفتد."],[490,"مرا که از رخ او، ماه در شبستان است","کجا بود به فروغ ستاره، پروایی؟","من وقتی زیبایی چهره‌اش را می‌بینم، مانند این است که ماه در شبستان (سالن) درخشیده است؛ بنابراین من چگونه می‌توانم به نور ستاره‌ها اهمیت بدهم؟"],[490,"فراق و وصل چه باشد؟ رضای دوست طلب","که حیف باشد از او، غیر او، تمنایی","فراق و وصال (جدایی و نزدیکی) چه معنایی دارد وقتی که رضایت و خوشنودی دوست را می‌طلبیم؟ این خیلی بی‌معناست که غیر او آرزویی داشته باشیم."],[490,"درر ز شوق برآرند ماهیان به نثار","اگر سفینه حافظ رسد به دریایی","ماهی‌ها از شوق به طرف کشتی حافظ، لؤلؤ و در (جواهرات) می‌ریزند اگر کشتی او به دریا برسد."],[491,"سلامی چو بوی خوش آشنایی","بدان مردم دیده روشنایی","سلامی مانند بوی خوش و آشنایی به آنها که در ورای بینایی، در روشنایی زندگی می‌کنند."],[491,"درودی چو نور دل پارسایان","بدان شمع خلوتگه پارسایی","سلامی مانند نور دل پارسایان (شایسته‌خویان) به آن شمعی که در جای خلوت پارسایی درخشان است."],[491,"نمی‌بینم از همدمان، هیچ بر جای","دلم، خون شد از غصّه؛ ساقی! کجایی؟","به نظر می‌رسد از هم‌عصرانم هیچ‌کس را نمی‌بینم و دل‌ام به شدت از غم و اندوه خونین شده است؛ ساقی! تو کجایی؟"],[491,"ز کوی مغان، رخ مگردان! که آنجا","فروشند مفتاح مشکل‌گشایی","از محله‌ی می فروشان روی خود را بر نگردان، چون در آن‌جا کلید حل مسائل و مشکلات را به مردم می‌فروشند."],[491,"عروس جهان گرچه در حدّ حسن است","ز حد می‌برد شیوه بی‌وفایی","جهان هرچند مانند عروس، در زیبایی بی‌نظیر است، اما روش بی‌وفایی را از حد می گذراند"],[491,"دل خسته من گرش همّتی هست","نخواهد ز سنگین‌دلان، مومیایی","دل خسته‌ام اگر اراده‌ای داشته باشد، نمی‌تواند از دل‌های سنگین‌دل، مانند مومیایی (که نوعی مومیایی کردن است) چیزی بخواهد."],[491,"می صوفی‌افکن، کجا می‌فروشند؟","که در تابم از دست زهد ریایی","شراب صوفی‌نما کجا فروخته می‌شود؟ چون من دیگر از دست عبادت‌های ظاهری و ریایی خسته‌ام."],[491,"رفیقان، چنان، عهد صحبت شکستند","که گویی نبوده‌ست خود، آشنایی","دوستان و همراهان، به گونه‌ای پیمان دوستی را شکسته‌اند که انگار هرگز هیچ آشنایی نداشته‌ایم."],[491,"مرا گر تو بگذاری، ای نفس طامع!","بسی پادشایی کنم در گدایی","اگر تو، ای نفس طماع، مرا رها کنی، در حالی که من در فقر و گدایی هستم، می‌توانم به مقام‌های بلند و پادشاهی دست یابم."],[491,"بیاموزمت کیمیای سعادت","ز هم‌صحبت بد، جدایی! جدایی!","به تو یاد می‌دهم که چطور به خوشبختی دست یابی، زیرا که دوری از دوستی‌های بد و نادرست، زمینه‌ساز چنین سعادت و خوشبختی است."],[491,"مکن «حافظ» از جور دوران، شکایت!","چه دانی تو، ای بنده! کار خدایی؟","ای حافظ، از بدی‌های زمان شکایت نکن! تو که بنده‌ای و نمی‌دانی کار خدا چقدر بزرگ و حکمتش عمیق است."],[492,"ای پادشه خوبان! داد از غم تنهایی","دل، بی‌‌تو، به جان آمد؛ وقت است که بازآیی","ای پادشاه زیبایی‌ها! از غم تنهایی دلم فریاد می‌زنم، بی‌تو، جانم به سر آمده است؛ وقت آن است که به سوی من بازگردی."],[492,"دائم، گل این بستان، شاداب نمی‌ماند","دریاب ضعیفان را در وقت توانایی!","گل‌های این باغ همیشه شاداب نمی‌مانند، بنابراین در زمانی که قادر هستی به نیازمندان توجه کن و به آن‌ها کمک کن."],[492,"دیشب، گله زلفش با باد، همی کردم","گفتا: «غلطی! بگذر زین فکرت سودایی!»","دیشب، موهای او با باد بازی می‌کرد و من گفتم که این کار اشتباه است؛ فراموش کن این فکر عاشقانه‌ات را."],[492,"صد باد صبا، این‌جا، با سلسله می‌رقصند","این است حریف ای دل! تا باد نپیمایی","بسیاری از نسیم‌های صبا در اینجا به صورت زنجیره‌وار در حال رقصیدن هستند، ای دل! این حال و هوا بر کسی عوض نخواهد شد تا زمانی که باد را نشناسی و نپذیری."],[492,"مشتاقی و مهجوری، دور از تو چنانم کرد","کز دست بخواهد شد پایاب شکیبایی","من شیدای تو و بی‌خبر از تو هستم، به گونه‌ای که گویی شکیبایی و صبرم به سر آمده و دیگر طاقت دوری‌ات را ندارم."],[492,"یا رب! به‌ که شاید گفت این نکته که در عالم","رخساره به کس ننمود آن شاهد هرجایی؟","ای خدای بزرگ! این نکته را به چه کسی می‌توان گفت که در دنیا هیچ‌کس نتوانسته است آن معشوق خوش‌چهره و زیبای پنهان را مشاهده کند؟"],[492,"ساقی! چمن گل را بی‌‌روی تو، رنگی نیست","شمشاد، خرامان کن! تا باغ بیارایی","ای ساقی! اگر تو در این باغ نباشی، چمن گل هیچ زیبایی ندارد. پس بیفزا تا این باغ را زیباتر کنی."],[492,"ای درد توام درمان در بستر ناکامی!","وی یاد توام مونس در گوشه تنهایی!","ای درد تو، هم درمان من هستی و هم بر بستر ناکامی‌ام قرار داری! یاد تو، همدم من در گوشه تنهایی‌ام است."],[492,"در دایره قسمت، ما، نقطه تسلیمیم","لطف، آن‌چه تو اندیشی؛ حکم، آن‌چه تو فرمایی","ما در دایره سرنوشت خود پذیرفته‌ایم که تسلیم خواسته‌های معشوق باشیم و فقط به آنچه تو فکر می‌کنی و آنچه تو دستور می‌دهی، عمل کنیم."],[492,"فکر خود و رای خود در عالم رندی نیست","کفر است در این مذهب، خودبینی و خودرایی","در جهان رندی، اگر به فکر و رای خود اهمیت بدهی و فقط به خودت توجه کنی، این یک نوع کفر است و با اصول این مذهب سازگار نیست."],[492,"زین دایره مینا، خونین‌جگرم، می ده!","تا حل کنم این مشکل در ساغر مینایی","از این عالم دلخونم از شراب معرفت به من عطا کن تا به واسطه ی این جام بلورین با میناکاری شده(حاوی معرفت)این مشکل را حل کنم"],[492,"«حافظ»! شب هجران شد، بوی خوش وصل آمد","شادیت، مبارک باد! ای عاشق شیدایی!","ای حافظ! شب جدایی به پایان رسید و بوی خوش وصال محبوب به مشام رسید، پس خوشحالی‌ات مبارک باشد، ای عاشق سرخوش!"],[493,"ای دل! گر از آن چاه زنخدان به درآیی","هر جا که روی، زود، پشیمان به درآیی","ای دل اگر از آن گودی چانه معشوق بیرون آیی هر جای دیگری که بروی پشیمان و زود بر میگردی"],[493,"هش دار که گر وسوسه عقل کنی گوش","آدم‌صفت از روضه رضوان به درآیی","مواظب و به هوش باش که اگر به وسوسه های عقل گوش بدهی مانند آدم از بهشت بیرون و دور میشوی"],[493,"شاید که به آبی، فلکت، دست نگیرد","گر تشنه‌لب از چشمه حیوان به درآیی","اگر به چشمه طبیعی و زنده حیوان برسی و از آن ننوشی و تشنه بیرون شوی جا دارد که آبی از آسمان و روزگار اندکی تو را یاری نکند"],[493,"جان می‌دهم از حسرت دیدار تو، چون صبح","باشد که چو خورشید درخشان به درآیی","از شوق و حسرت دیدار تو جان خودم را مانند صبح تسلیم میکنم تا آنکه مانند خورشید درخشان طلوع کنی و بیرون بیایی"],[493,"چندان، چو صبا بر تو گمارم دم همّت","کز غنچه چو گل، خرّم و خندان به درآیی","اگر دم صبا را بر تو بگذارم، به حدی که تلاش و همت من باشد، تو همچون گلی خوشبو و خندان به وجود می‌آیی."],[493,"در تیره‌شب هجر تو، جانم به لب آمد","وقت است که همچون مه تابان به درآیی","در تاریکی شب جدایی تو، جانم به لب رسیده و اکنون زمانی است که باید مانند ماه روشن، وارد زندگی‌ام شوی."],[493,"بر رهگذرت بسته‌ام از دیده، دو صد جوی","تا بو که تو چون سرو خرامان به درآیی","به خاطر یاد تو، پیوسته بر راهی که تو می‌روی، از چشمم دو صد اشک جاری شده تا ببینم که آیا تو مانند سرو خوش‌حالت، به خانه‌ام خواهی آمد یا نه."],[493,"حافظ! مکن اندیشه که آن یوسف مه‌رو","بازآید و از کلبه احزان به درآیی!","ای حافظ! نگران نباش که آن یوسف زیبا دوباره برنمی‌گردد و از دنیای غم و اندوه خارج نخواهد شد."],[494,"می خواه و گل‌افشان کن، از دهر چه می‌جویی؟","این گفت سحرگه گل «بلبل! تو چه می‌گویی؟»","شراب بنوش و گل بپاش (شاد باش). از زندگی به دنبال چه می‌گردی؟ این را گل در صبح زود به بلبل گفت، «تو چه نظری داری؟»"],[494,"مسند به گلستان بر، تا شاهد و ساقی را","لب گیری و رخ بوسی، می نوشی و گل بویی","در باغ گل، تکیه‌گاه مناسبی فراهم کن تا یک طرف شاهد و ساقی را در آغوش بگیری و صورتش را ببوسی، شراب بنوشی و بوی گل‌ها را استشمام کنی."],[494,"شمشاد، خرامان کن وآهنگ گلستان کن","تا سرو بیآموزد از قدّ تو، دل‌جویی","شمشاد، با ناز قدم بردار و بسوی گلستان بیا. تا سرو، از قامت زیبای تو دل‌ربایی را یاد بگیرد."],[494,"تا غنچه خندانت، دولت به که خواهد داد","ای شاخ گل رعنا! از بهر که می‌رویی؟","تو که مثل غنچه‌ای خندان و شکفته‌ای، این زیبایی رو به چه کسی خواهی بخشید؟ای شاخه زیبای گل، برای چه کسی در حال شکفتنی؟"],[494,"امروز که بازارت، پرجوش خریدار است","دریاب و بنه گنجی از مایه نیکویی","امروز به خاطر اینکه جذابیت و زیبایی‌ات مورد توجه بسیاری قرار دارد، از این موقعیت استفاده کن و زیباترین ویژگی‌های خود را به نمایش بگذار."],[494,"چون شمع، نکورویی در رهگذر باد است","طرف هنری بربند از شمع نکورویی","مانند شمعی که در معرض باد قرار دارد، زیبایی و نیکی در اجتماع شناخته شده است. پس از شمع نیکو بهره‌مند شو، زیرا نقش آن در زیبایی هنری مهم است."],[494,"آن طرّه که هر جعدش، صد نافه چین ارزد","خوش بودی اگر بودی، بوییش ز خوش‌خویی","آن موی زیبا که هر حلقه‌اش به اندازه‌ صد نافه‌ی (عطر) چین خوش‌بو هست، اگر بوی خوش‌اخلاقی را از آن احساس می‌کردیم، بسیار زیباتر می‌بود."],[494,"هر مرغ به دستانی در گلشن شاه آمد","بلبل به نواسازی، حافظ به غزل‌گویی","در باغ پادشاه، هر پرنده ای با هنر (نغمه‌ی) خاصی آمده است؛ بلبل با نوای دل‌انگیزش و حافظ با غزل سرایی اش."]]}