� مستی‌ات غرق شده‌ای، ای هستی ما که همیشه وجودت در ما جریان دارد."],[511,"با تو بی لب این زمان من نو به نو","رازهای کهنه گویم می‌شنو","در اینجا شاعر به معشوقش اشاره می‌کند و می‌گوید که با وجود نبودن لب او (که به نوعی نشان‌دهنده ارتباط فیزیکی یا صحبت است) در این لحظه تازه و دائما تغییر می‌کند و رازهای قدیمی را برایش بازگو می‌کند. او از معشوقش می‌خواهد که به این رازها گوش دهد."],[511,"زانک آن لبها ازین دم می‌رمد","بر لب جوی نهان بر می‌دمد","زیرا آن لب‌ها از حالا در حال رفتن و دور شدن هستند و به نوعی در کنار جوی آب نهان و پنهانی می‌دمند و می‌وزند."],[511,"گوش بی‌گوشی درین دم بر گشا","بهر راز یفعل الله ما یشا","در این لحظه، گوش خود را به صدای عاشقانه‌ای که می‌شنوی باز کن، تا برایت بگشاید که خداوند چه کارهایی می‌کند و چه رازی در پس این صدا نهفته است."],[511,"چون صلای وصل بشنیدن گرفت","اندک اندک مرده جنبیدن گرفت","زمانی که صدای وصال را شنید، به آرامی چنان بی‌حال و بی‌جان بود که کم‌کم روحش به او بازگشت و شروع به حرکت کرد."],[511,"نه کم از خاکست کز عشوه صبا","سبز پوشد سر بر آرد از فنا","انسان که در ابتدا به صورت خاکستری بی‌جان به نظر می‌رسد، با جاذبه‌ی عشق و نشاطی که در باد صبا وجود دارد، می‌تواند از فناء و نابودی خود برخیزد و به زندگی و حیات نوین دست یابد."],[511,"کم ز آب نطفه نبود کز خطاب","یوسفان زایند رخ چون آفتاب","از آب نطفه کمتر نیست که از دستور و پیام یوسف‌ها (که به زیبایی مشهور هستند) چهره‌هایی چون آفتاب زاده می‌شوند."],[511,"کم ز بادی نیست شد از امر کن","در رحم طاوس و مرغ خوش‌سخن","هیچ چیزی کمتر از وزش باد نیست که به سبب دستور الهی در رحم طاوس و مرغ خوش‌سخن، موجودی تازه به وجود می‌آید."],[511,"کم ز کوه سنگ نبود کز ولاد","ناقه‌ای کان ناقه ناقه زاد زاد","از کوه سنگ، چیز کمتری نیست که ناگزیر از آن، ناقه‌ای به دنیا بیاید؛ این ناقه هم از ناقه‌های دیگر زاده می‌شود."],[511,"زین همه بگذر نه آن مایه عدم","عالمی زاد و بزاید دم به دم","از این همه حوادث و رویدادها بگذر، زیرا این‌ها چیزی جز نبود و عدم نیست و جهان به‌طور مداوم از این عدم جوانه می‌زند و به وجود می‌آید."],[511,"بر جهید و بر طپید و شاد شاد","یک دو چرخی زد سجود اندر فتاد","عاشق از خوشحالی بسیار، ناگهان پرید و تند و سریع به چرخش درآمد و سپس به حالت سجده افتاد."],[512,"گفت ای عنقای حق جان را مطاف","شکر که باز آمدی زان کوه قاف","ای عنقای حق (پرنده‌ای افسانه‌ای و نماد عشق و جاودانگی)، جان را جایی برای شکرگزاری است که تو از آن کوه قاف (جای دور و روحانی) بازگشتی."],[512,"ای سرافیل قیامتگاه عشق","ای تو عشق عشق و ای دلخواه عشق","ای سرافیل، که در هنگام قیامت برای احیای عشق می‌دمد، تو خود عشق حقیقی هستی و محبوب دل‌های عاشقان."],[512,"اولین خلعت که خواهی دادنم","گوش خواهم که نهی بر روزنم","اگر بخواهی اولین پاداش یا هدیه‌ای را به من بدهی، باید در گوش من بگویی که بر در روزنه من چه بگذارند."],[512,"گرچه می‌دانی بصفوت حال من","بنده‌پرور گوش کن اقوال من","با اینکه از حال من و بی‌خودیم آگاهی، اما به‌عنوان یک بندۀ خدا، به حرف‌هایم گوش کن."],[512,"صد هزاران بار ای صدر فرید","ز آرزوی گوش تو هوشم پرید","من همیشه امیدوارم که صدها بار، ای فرید صدر، از شنیدن صدای تو به شوق بیفتم و این امیدم به اندازه‌ای است که به حیاتم رونق می‌بخشد."],[512,"آن سمیعی تو وان اصغای تو","و آن تبسمهای جان‌افزای تو","تو آن شنوایی و توجهی که محبتی از سمت توست و آن لبخندهای روح‌افزای تو که جان را تسکین می‌دهد."],[512,"آن بنوشیدن کم و بیش مرا","عشوه جان بداندیش مرا","عشق و محبت من به تو، نه آنقدر کم است که ناچیز باشد و نه آنقدر زیاد است که از حد بگذرد؛ بلکه حالتی متعادل و مطلوب دارد که به روح من جان می‌بخشد."],[512,"قلبهای من که آن معلوم تست","بس پذیرفتی تو چون نقد درست","قلب‌های من که نشان‌دهنده احساسات واقعی من است، تو آن‌ها را به خوبی پذیرفته‌ای، مانند یک پول درست و با ارزش که به آسانی قابل شناسایی است."],[512,"بهر گستاخی شوخ غره‌ای","حلمها در پیش حلمت ذره‌ای","برای گستاخی و خودبزرگ‌بینی تو، صبر و حوصله‌ام در مقابل حلم و بردباری تو مثل یک ذره است."],[512,"اولا بشنو که چون ماندم ز شست","اول و آخر ز پیش من بجست","ابتدا بشنو که وقتی از خودم رهایی یافتم، در آغاز و پایان، همه چیز از پیش من گریخت."],[512,"ثانیا بشنو تو ای صدر ودود","که بسی جستم ترا ثانی نبود","ای کسی که رحمت و محبت تو در صدر است، بشنو که من بسیار دنبالت گشته‌ام و هیچ‌چیز مانند تو را نیافته‌ام."],[512,"ثالثا تا از تو بیرون رفته‌ام","گوییا ثالث ثلاثه گفته‌ام","اعلا، گویی وقتی که از تو دور شده‌ام، در واقع چیزی را که باید بگویم، سه بار تکرار کرده‌ام."],[512,"رابعا چون سوخت ما را مزرعه","می ندانم خامسه از رابعه","عاشق در اینجا می‌گوید که حالا که جان و دلش سوخته و ویران شده، نمی‌تواند مانند مزرعه‌ای بارور از عشق بهره‌مند باشد و از این حالتی که در آن قرار دارد، چیزی جز سوختگی و تلخی را نمی‌بیند."],[512,"هر کجا یابی تو خون بر خاکها","پی بری باشد یقین از چشم ما","هر جا که در زمین نشانه‌ای از خون ببینی، مطمئن باش که این خون از چشم ما ریخته شده است."],[512,"گفت من رعدست و این بانگ و حنین","ز ابر خواهد تا ببارد بر زمین","عاشق می‌گوید که من مانند رعد هستم و این صدای بلندی که می‌شنوید، از ابر است و به زودی باران بر زمین خواهد بارید. این تعبیر نشان‌دهنده شدت احساس و عشق اوست که به زودی به حقیقت می‌پیوندد."],[512,"من میان گفت و گریه می‌تنم","یا بگریم یا بگویم چون کنم","من در میان گفتن و گریه کردن هستم و نمی‌دانم باید گریه کنم یا بگویم چه کنم."],[512,"گر بگویم فوت می‌گردد بکا","ور نگویم چون کنم شکر و ثنا","اگر بگویم که دلم می‌سوزد و می‌گریم، از من تباه می‌شود، و اگر هم سکوت کنم، نمی‌دانم چگونه باید شکر و ستایش معشوق را به جا آورم."],[512,"می‌فتد از دیده خون دل شها","بین چه افتادست از دیده مرا","عشق و درد من به قدری شدید است که اشک‌های خونین از چشمانم بیرون می‌ریزد. بگو ببین، چه حالتی به من دست داده است که این‌طور اشک می‌ریزم."],[512,"این بگفت و گریه در شد آن نحیف","که برو بگریست هم دون هم شریف","این جمله را آن نحیف (مردی ضعیف و ناتوان) گفت و در حالی که گریه می‌کرد، بر او (معشوق) که به خاطر او گریسته بود، دلتنگی و محبتش نمایان شد، چه او (ناتوان) هم از افراد دردمند و ضعیف است و هم از افراد محترم و شریف."],[512,"از دلش چندان بر آمد های هوی","حلقه کرد اهل بخارا گرد اوی","این فرد عاشق از دلش احساسات شدیدی بیرون آمد که به اندازه‌ای بود که موجب گردهمایی مردم بخارا دور او شد."],[512,"خیره گویان خیره گریان خیره‌خند","مرد و زن خرد و کلان حیران شدند","مردان و زنان، بزرگ و کوچک، همگی در شگفتی و حیرت به یکدیگر نگاه می‌کنند؛ برخی با تعجب سخن می‌گویند و برخی دیگر با اشک می‌گریند، و حتی بعضی با خنده به این وضعیت واکنش نشان می‌دهند."],[512,"شهر هم هم‌رنگ او شد اشک ریز","مرد و زن درهم شده چون رستخیز","شهر نیز به رنگ او درآمد و مردم، مرد و زن، با اشک ریختن به حالت رستخیز (قیامت) درآمدند و در هم آمیخته شدند."],[512,"آسمان می‌گفت آن دم با زمین","گر قیامت را ندیدستی ببین","در آن لحظه، آسمان به زمین می‌گفت که اگر قیامت را ندیده‌ای، حالا آن را ببین."],[512,"عقل حیران که چه عشق است و چه حال","تا فراق او عجب‌تر یا وصال","عقل در شگفتی است که عشق چیست و حالت آن چگونه است، آیا دوری از محبوب (فراق) عجیب‌تر است یا نزدیک شدن به او (وصال)؟"],[512,"چرخ بر خوانده قیامت‌نامه را","تا مجره بر دریده جامه را","زمان، صفحات روز جزا را ورق می‌زند و آنچه در آن ثبت شده است را برای محاسبه و پاسخگویی می‌گیرد و به آن کسانی که به طور بی‌پروا و بی‌احتیاط در زندگی خود عمل کرده‌اند، نشان می‌دهد."],[512,"با دو عالم عشق را بیگانگی","اندرو هفتاد و دو دیوانگی","در عشق، هم دنیا و هم آخرت برای عاشق ناشناخته و نامأنوس است و در این عشق، دیوانگی‌هایی به تعداد هفتاد و دو نوع به وجود می‌آید."],[512,"سخت پنهانست و پیدا حیرتش","جان سلطانان جان در حسرتش","حیرت عشق و شگفتی‌های آن به قدری عمیق و پنهان است که حتی جان‌داران بزرگ و سلطنت‌طلب نیز به خاطر آن در آرزوی وصال و نزدیک شدن به معشوق هستند."],[512,"غیر هفتاد و دو ملت کیش او","تخت شاهان تخته‌بندی پیش او","جز هفتاد و دو ملت، همه‌ی ملت‌ها و آیین‌ها در برابر او همچون تخته‌چوبی در مقابل تخت پادشاهان هستند."],[512,"مطرب عشق این زند وقت سماع","بندگی بند و خداوندی صداع","مطرب عشق، یعنی موسیقی و لذت عشق، در این زمان که وقت رقص و سماع است، بندگی و عبودیت را درهم می‌آمیزد و در برابر خداوند، سر درد (صداع) را از سر می‌کشد و به او توجه می‌کند."],[512,"پس چه باشد عشق دریای عدم","در شکسته عقل را آنجا قدم","عشق به مانند دریای بی‌انتهای نیستی است که در آن، عقل آدمی ناتوان و شکسته می‌شود و نمی‌تواند آن را درک کند."],[512,"بندگی و سلطنت معلوم شد","زین دو پرده عاشقی مکتوم شد","از این دو پرده یعنی بندگی و سلطنت، ماهیت عاشقی مشخص می‌شود و هر چیزی که در عشق مخفی بوده، آشکار می‌گردد."],[512,"کاشکی هستی زبانی داشتی","تا ز هستان پرده‌ها برداشتی","ای کاش که هستی (وجود) زبان و ابزاری داشت تا پرده‌ها و موانع میان واقعیت و عشق را کنار می‌زد و حقیقت را نشان می‌داد."],[512,"هر چه گویی ای دم هستی از آن","پرده دیگر برو بستی بدان","هرچه که تو بگویی، ای وجود هستی، از آن طرف پرده‌ای که وجود دارد، دور شده‌ای و به آن راهی نداری."],[512,"آفت ادراک آن قالست و حال","خون بخون شستن محالست و محال","آفت فهمیدن حقایق، گفتار و حالت‌های ظاهری است و اتصال دل به عشق و حقیقت غیر ممکن و دشوار است."],[512,"من چو با سوداییانش محرمم","روز و شب اندر قفس در می‌دمم","من به خاطر دوستی و عشق به معشوق، همچنان در حال و هوای او زندگی می‌کنم و در هر لحظه از شبانه‌روز، در این قفس (قفس دل یا جسم) مشغول عشق‌بازی و مستی هستم."],[512,"سخت مست و بی‌خود و آشفته‌ای","دوش ای جان بر چه پهلو خفته‌ای","دیشب تو به شدت مست و بی‌خود و نابسامان بودی، ای جان! چرا به پهلو خوابیده‌ای و بی‌خبر هستی؟"],[512,"هان و هان هش دار بر ناری دمی","اولا بر جه طلب کن محرمی","ای عاشق، هوشیار باش و از آتش عشق و عذاب آن در امان بمان. لحظه‌ای دقت کن و ابتدا به دنبال کسی بگرد که بتواند در این راه به تو کمک کند و همراهت باشد."],[512,"عاشق و مستی و بگشاده زبان","الله الله اشتری بر ناودان","عاشق در حال مستی و نشئگی است و به زبان می‌آورد نام خدا را، مثل اینکه در حال زاری و ناله که در زیر باران صدای خرگوشی را می‌دهد که بر ناودان می‌خندد."],[512,"چون ز راز و ناز او گوید زبان","یا جمیل الستر خواند آسمان","عاشق وقتی درباره راز و زیبایی معشوق صحبت می‌کند، زبانش به قدری شیوا و شیرین می‌شود که کلامش را آسمان زیبا و دل‌نواز می‌خواند."],[512,"ستر چه در پشم و پنبه آذرست","تا همی‌پوشیش او پیداترست","هرچند ستر (پوشش) در پشم و پنبه، آتش را پنهان می‌کند، اما به همین دلیل، وجود او (خدای) بیشتر نمایان می‌شود."],[512,"چون بکوشم تا سرش پنهان کنم","سر بر آرد چون علم کاینک منم","هرگاه تلاش می‌کنم تا او را پنهان کنم، خود او خود را نشان می‌دهد و می‌گوید که من همین‌جا هستم."],[512,"رغم انفم گیردم او هر دو گوش","کای مدمغ چونش می‌پوشی بپوش","با اینکه من تلاش می‌کنم او را پنهان کنم، اما او تمام وجودم را در دست گرفته و به راحتی قابل مشاهده است، بنابراین نمی‌توانم از او دور بمانم."],[512,"گویمش رو گرچه بر جوشیده‌ای","همچو جان پیدایی و پوشیده‌ای","به او می‌گویم برو، هرچند که از عشق به من به شدت شوریده‌ای، تو همچون جان در وجود من هستی و در عین حال پنهانی."],[512,"گوید او محبوس خنبست این تنم","چون می اندر بزم خنبک می‌زنم","عاشق می‌گوید که این بدن من همچون زندانی است و حالتی شاداب و سرخوش دارم، مانند می‌نوشی که در جشن و بزم، نغمه می‌زند."],[512,"گویمش زان پیش که گردی گرو","تا نیاید آفت مستی برو","به او می‌گویم پیش از اینکه در دام عشق گرفتار شوی، مواظب باش که آفت مستی بر تو نازل نشود."],[512,"گوید از جام لطیف‌آشام من","یار روزم تا نماز شام من","می‌گوید: معشوق من در روز مانند یک جام زلال و خوش طعم است، او را می‌نوشم و از او بهره‌مند می‌شوم، تا اینکه به هنگام نماز شب می‌رسد."],[512,"چون بیاید شام و دزدد جام من","گویمش وا ده که نامد شام من","وقتی شب می‌رسد و یار من، جامم را می‌رباید، به او می‌گویم که چرا نیامده که شب من را به سر آورد."],[512,"زان عرب بنهاد نام می مدام","زانک سیری نیست می‌خور را مدام","عرب (مرد عربی) نام شراب را «می» گذاشت، زیرا شرابی که انسان همیشه می‌نوشد و تمام نمی‌شود، هیچ‌گاه سیر کننده نیست."],[512,"عشق جوشد باده تحقیق را","او بود ساقی نهان صدیق را","عشق، نوشیدنی شناخت و حقیقت را به جوش می‌آورد و آن کسی که آن را به ما می‌دهد، ساقی پنهانی و باوفاست."],[512,"چون بجویی تو بتوفیق حسن","باده آب جان بود ابریق تن","هرگاه تو به مدد و یاری حسن و زیبایی باده را جستجو کنی، بدان که آب جان تو در ظرف تن تو قرار دارد."],[512,"چون بیفزاید می توفیق را","قوت می بشکند ابریق را","هرگاه که توفیق در نوشیدن می (شراب) افزوده شود، نیروی می (شراب) ظرف را می‌شکند."],[512,"آب گردد ساقی و هم مست آب","چون مگو والله اعلم بالصواب","ساقی به قدری نشاط و شوق در دل‌ها می‌افزاید که خود نیز مانند آب می‌شود و مست از آن می‌گردد. در این حال، بیان حقیقت آنچه در این وضعیت اتفاق می‌افتد، دشوار است و فقط خداوند می‌داند که چه درست است."],[512,"پرتو ساقیست کاندر شیره رفت","شیره بر جوشید و رقصان گشت و زفت","ساقی که شعف و نور از وجودش ساطع است، در شیره (عصاره) رفت و این عصاره به جوش آمد و به حالت رقص و شادابی درآمد."],[512,"اندرین معنی بپرس آن خیره را","که چنین کی دیده بودی شیره را","از این معنا بپرس از آن شخص حیران که آیا او چنین پدیده‌ای (شیره‌ای که چنین حالتی دارد) را قبلا دیده است یا نه."],[512,"بی تفکر پیش هر داننده هست","آنک با شوریده شوراننده هست","هر کسی که بدون تفکر و تأمل به سمت دانایان می‌رود، در واقع نشان‌دهنده بی‌قراری و دیوانگی خود است."],[513,"یک جوانی بر زنی مجنون بدست","می‌ندادش روزگار وصل دست","یک جوانی دیوانه بر زنی بود و روزگار وصال را به او نمی‌داد."],[513,"بس شکنجه کرد عشقش بر زمین","خود چرا دارد ز اول عشق کین؟","عشق او از ابتدا باعث درد و رنجش شده است، ولی دلیل این همه رنج و شکنجه چیست که او همچنان در زمین خود، یعنی در وجود خودش، به آن عشق ادامه می‌دهد؟"],[513,"عشق از اول چرا خونی بود؟","تا گریزد آنک بیرونی بود","عشق از ابتدا چرا باعث درد و رنج بود؟ تا آنکه کسی که بیگانه و دور بود، از آن بگریزد."],[513,"چون فرستادی رسولی پیش زن","آن رسول از رشک گشتی راه‌زن","وقتی تو، پیامبری را به سوی زن فرستادی، آن پیامبر به خاطر حسادت، تبدیل به راهزنی شد."],[513,"ور بسوی زن نبشتی کاتبش","نامه را تصحیف خواندی نایبش","اگر نویسنده‌ای را برای ارسال نامه به زن خود به کار نگیری و آن نامه را به درستی نخوانی، پیام‌رسانی که فرستادی با مشکل مواجه خواهد شد."],[513,"ور صبا را پیک کردی در وفا","از غباری تیره گشتی آن صبا","اگر به نسیم صبحگاهی پیامی بفرستی و وفادار باشد، از غباری تیره و ناپاکی نجات می‌یابد و تبدیل به یکی دل‌انگیز و خوشبو می‌شود."],[513,"رقعه گر بر پر مرغی دوختی","پر مرغ از تف رقعه سوختی","اگر بر پر پرنده‌ای پارچه‌ای بدوزی، پر آن پرنده به خاطر حرارت پارچه می‌سوزد."],[513,"راههای چاره را غیرت ببست","لشکر اندیشه را رایت شکست","غیرت و غیرت‌ورزی مانع از یافتن راه‌حل‌ها شد و افکار و اندیشه‌ها را شکست و از حرکت بازداشت."],[513,"بود اول مونس غم انتظار","آخرش بشکست کی هم انتظار","ابتدا کسی که مونس و همراه غم انتظار بود، اکنون به پایان رسیده و این انتظار را شکسته است. این بلای طولانی، دیگر طاقت‌فرسا شده و دیگر نمی‌توان به آن ادامه داد."],[513,"گاه گفتی کاین بلای بی‌دواست","گاه گفتی نه حیات جان ماست","گاهی گفتی که این درد و غم، بر روی ما درمان ندارد، و گاهی نیز گفتی که این عشق و امید، حیات زندگی ماست."],[513,"گاه هستی زو بر آوردی سری","گاه او از نیستی خوردی بری","گاهی تو از او سر برمی‌آوری و وجودش را به یاد می‌آوری، و گاهی او از عدم و نیستی به تو یاری می‌رساند."],[513,"چونک بر وی سرد گشتی این نهاد","جوش کردی گرم چشمه اتحاد","چون وقتی که با او سرد و بی‌علاقه شدی، این عشق و احساس درونت به جوش آمد و حالت مثل چشمه‌ای که گرم باشد و به هم پیوسته، دوباره فعال و پرشور شد."],[513,"چونک با بی‌برگی غربت بساخت","برگ بی‌برگی به سوی او بتاخت","وقتی که عاشق با بی‌برگی و تنهایی غربت کنار آمد، بی‌برگی و تنها بودنش به سمت محبوبش شتابان رفت."],[513,"خوشه‌های فکرتش بی‌کاه شد","شب‌روان را رهنما چون ماه شد","فکر و اندیشه‌اش مانند خوشه‌ای است که بدون کاه و زباله به بار نشسته است و شب‌روان (مسافران شب یا عابران شب) را مانند ماه، راهنمایی می‌کند."],[513,"ای بسا طوطی گویای خمش","ای بسا شیرین‌روان روترش","بسیاری از طوطی‌ها که سخنگو هستند، در واقع خاموش هستند و بسیاری از افرادی که ظاهرا خوش‌رو به نظر می‌رسند، در باطن تلخ و ناخوشایندند."],[513,"رو به گورستان دمی خامش نشین","آن خموشان سخن‌گو را ببین","به لحظاتی در کنار گورستان برو و ساکت باش؛ در آنجا شاهد خموشان و بی‌زبانانی باش که پیش از این در سخن‌گویی طعنه‌زن بودند."],[513,"لیک اگر یکرنگ بینی خاکشان","نیست یکسان حالت چالاکشان","اگر به خاک مردگان نگاه کنی، می‌بینی که ظاهرشان یکسان است، اما حالت و رفتار آنها در زمان زندگی با هم فرق داشته و متفاوت بوده است."],[513,"شحم و لحم زندگان یکسان بود","آن یکی غمگین دگر شادان بود","زندگی افراد در ظاهر یکسان است، ولی یکی از آن‌ها غمگین و دیگری شاد است، که نشان می‌دهد احساسات و حالات درونی انسان‌ها با هم متفاوت است."],[513,"تو چه دانی تا ننوشی قالشان","زانک پنهانست بر تو حالشان","تو چه می‌دانی حال آن‌ها چگونه است، تا وقتی که از حرف‌هایشان نشنوی؛ چون حال آن‌ها در دل‌هایشان نهفته و پنهان است."],[513,"بشنوی از قال های و هوی را","کی ببینی حالت صدتوی را","اگر به سخنان عاشقانه و شریعت‌وار دیگران گوش دهی، هرگز نمی‌توانی حالتی چون حال خودت را ببینی و درک کنی."],[513,"نقش ما یکسان بضدها متصف","خاک هم یکسان روانشان مختلف","نقش و تاثیر ما در دنیا به مواردی که با آن‌ها در تضادیم متصل است و این که خاک از یک نوع است، در حالی که روان‌ها و روح‌ها متفاوت هستند."],[513,"همچنین یکسان بود آوازها","آن یکی پر درد و آن پر نازها","آوازها نیز یکسان بود، اما یکی از آن‌ها پر از درد و غم و دیگری پر از ناز و لطافت بود."],[513,"بانگ اسپان بشنوی اندر مصاف","بانگ مرغان بشنوی اندر طواف","اگر صدای اسبان را در میدان جنگ بشنوی، صدای پرندگان را نیز در دور و بر خانه یا در هنگام طواف (گردش حول کعبه) خواهی شنید."],[513,"آن یکی از حقد و دیگر ز ارتباط","آن یکی از رنج و دیگر از نشاط","این بیت بیان می‌کند که احساسات و حالاتی که انسان‌ها تجربه می‌کنند، بستگی به نوع ارتباط یا فاصله‌ای دارد که با دیگران دارند. یکی می‌تواند به خاطر حسد یا کینه در عذاب باشد، در حالی که دیگری به خاطر روابط مثبت و شادمانی، خوشحال و سرمست است."],[513,"هر که دور از حالت ایشان بود","پیشش آن آوازها یکسان بود","هر کسی که از حال و وضعیت عاشقان دور باشد، برای او صدای عاشقان هیچ تفاوتی نخواهد داشت."],[513,"آن درختی جنبد از زخم تبر","و آن درخت دیگر از باد سحر","درختی که از زخم تبر آسیب دیده است، به سختی می‌لرزد و به نوعی متأثر از درد و رنج خود است، اما درخت دیگری که از وزش نسیم صبحگاهی تکان می‌خورد، آسیب‌پذیری کمتری دارد و زندگی را در لطافت و آرامش تجربه می‌کند. این دو درخت نماد تضاد بین درد و آرامش هستند."],[513,"بس غلط گشتم ز دیگ مردریگ","زانک سرپوشیده می‌جوشید دیگ","زیاد اشتباه کرده‌ام و به راه‌های نادرست رفته‌ام، زیرا دلایل و مسائلی که در درونم وجود دارد، مخفی و پنهان هستند و بی‌خبر از آن می‌جوشند."],[513,"جوش و نوش هرکست گوید بیا","جوش صدق و جوش تزویر و ریا","هر کس درباره خود و احساساتش می‌گوید که آمده و در حال شادابی و سرزندگی است، اما در حقیقت، هم جوش و خروش او دروغین و ناشی از فریب‌کاری و ریا است."],[513,"گر نداری بو ز جان روشناس","رو دماغی دست آور بوشناس","اگر از جان روشناس (واقعی و آشنا) بویی نمی‌شنوی، باید دماغی (حس و درکی) پیدا کنی که بوی او را تشخیص دهد."],[513,"آن دماغی که بر آن گلشن تند","چشم یعقوبان هم او روشن کند","این دماغی که بوی گلستان را تشخیص می‌دهد، همان دماغی است که می‌تواند چشمان یعقوبیان (یعقوب، پیامبر معروف و پدر یوسف) را نیز روشن کند. به این معنا که بوی خوش آن گلشن، تنها برای کسانی که بصیرت و درک عمیق دارند، قابل احساس است."],[513,"هین بگو احوال آن خسته‌جگر","کز بخاری دور ماندیم ای پسر","بگو اا حال آن دلی ازرده و رنج‌کشیده را که از دوری محبت و معشوق در عذاب است، ای پسر."],[514,"کان جوان در جست و جو بد هفت سال","از خیال وصل گشته چون خیال","جوانی به مدت هفت سال در پی وصال محبوب خود بوده و به خاطر این جست‌وجو، در خیال وصال غرق شده است."],[514,"سایه حق بر سر بنده بود","عاقبت جوینده یابنده بود","سایه خداوند بر سر بنده‌ای که در جست‌وجو است، در نهایت موجب می‌شود که آن جوینده به مراد خود برسد."],[514,"گفت پیغامبر که چون کوبی دری","عاقبت زان در برون آید سری","پیامبر می‌گوید که اگر به در خانه‌ای بکوبی، در نهایت سر کسی از آن در بیرون می‌آید."],[514,"چون نشینی بر سر کوی کسی","عاقبت بینی تو هم روی کسی","اگر مدتی در جایی بنشینی و به دنبال کسی بگردی، در نهایت او را خواهی دید و ملاقات خواهی کرد."],[514,"چون ز چاهی می‌کنی هر روز خاک","عاقبت اندر رسی در آب پاک","اگر هر روز از چاهی خاکی به بیرون بکشی، در نهایت به آب زلال آن چاه دست پیدا خواهی کرد. این بیت به تلاش مستمر و کوشش در رسیدن به هدف اشاره دارد."],[514,"جمله دانند این اگر تو نگروی","هر چه می‌کاریش روزی بدروی","اگر تو در جستجوی چیزی نباشی، دیگران می‌دانند که تو چه می‌کنی، و هر چیزی که بکاری، روزی به ثمر می‌رسد."],[514,"سنگ بر آهن زدی آتش نجست","این نباشد ور بباشد نادرست","اگر بر سنگ، چکش بزنید، آتش نمی‌افتد؛ این طبیعی است و اگر این‌طور باشد، نادرست است."],[514,"آنک روزی نیستش بخت و نجات","ننگرد عقلش مگر در نادرات","کسی که در روزهای نیک بختی و نجات نگاهش به عقل و درستی نیست، تنها زمانی از عقلش استفاده می‌کند که در شرایط نادر و خاص قرار بگیرد."],[514,"کان فلان کس کشت کرد و بر نداشت","و آن صدف برد و صدف گوهر نداشت","فلانی در زندگی‌اش تلاشی کرده و زحمت کشیده اما نتیجه‌ای که به دست آورده، ارزشی ندارد و مانند صدفی است که درونش دانه‌ای قیمتی ندارد."],[514,"بلعم باعور و ابلیس لعین","سود نامدشان عبادتها و دین","بلعم باعور و ابلیس لعین، به رغم عبادت و دین‌داریشان، نتوانستند از سود و منفعتی در زندگی خود بهره‌مند شوند."],[514,"صد هزاران انبیا و ره‌روان","ناید اندر خاطر آن بدگمان","بدگمان به خدا و حقایق معنوی نمی‌تواند صدها هزار پیامبر و رهرو را در ذهن خود بپذیرد یا به آن‌ها فکر کند."],[514,"این دو را گیرد که تاریکی دهد","در دلش ادبار جز این کی نهد","این شخص که به تاریکی و ناامیدی دچار شده، به جز خود، هیچ‌کس دیگری را نمی‌تواند مقصر بداند و در دلش احساس تنهایی و ناامیدی می‌کند."],[514,"بس کسا که نان خورد دلشاد او","مرگ او گردد بگیرد در گلو","بسیاری از کسانی که در زندگی خوشحال و دلشاد به نظر می‌رسند، در واقع با مرگ خود مواجه می‌شوند و این شادی ظاهری آن‌ها ممکن است به یک فاجعه تبدیل شود."],[514,"پس تو ای ادبار رو هم نان مخور","تا نیفتی همچو او در شور و شر","تو ای بخت بد از خوشی‌های دنیا بهره‌مند نباش و نان نخور، تا مانند او در غم و آشفتگی گرفتار نشوی."],[514,"صد هزاران خلق نانها می‌خورند","زور می‌یابند و جان می‌پرورند","بسیاری از مردم روزی می‌خورند و زندگی می‌گذرانند، اما در عوض آن، فقط به زندگی مادی و جسمی خود اهمیت می‌دهند و مراقب روح و جان خود نیستند."],[514,"تو بدان نادر کجا افتاده‌ای","گر نه محرومی و ابله زاده‌ای","اگر بدانستی که در کدام مکان نادر و خاص قرار داری، دیگر از نعمت‌ها و فرصت‌ها محروم نمی‌شدی و مانند کسی که نادان است، به باطل نمی‌پرداختی."],[514,"این جهان پر آفتاب و نور ماه","او بهشته سر فرو برده به چاه","این جهان پر از روشنی و زیبایی مانند آفتاب و ماه است، اما برخی افراد مانند کسی هستند که در چاهی افتاده و از این نورها بی‌خبرند، یعنی از نعمت‌های زندگی و حقیقت زندگی غافلند."],[514,"که اگر حقست پس کو روشنی","سر ز چه بردار و بنگر ای دنی","اگر این حقیقتی که می‌گویی درست است، پس چرا نور و روشنی را از سر برداشته‌ای؟ ای دنیا، نگاه کن به دور و بر خود."],[514,"جمله عالم شرق و غرب آن نور یافت","تا تو در چاهی نخواهد بر تو تافت","تمام عالم، چه در شرق و چه در غرب، به نور حقیقت دست یافته‌اند، اما تو در چاهی از جهل قرار گرفته‌ای که اجازه نمی‌دهد این نور بر تو بتابد."],[514,"چه رها کن رو به ایوان و کروم","کم ستیز اینجا بدان کاللج شوم","به راه نرو و به ایوان و دنیای بی‌ارزش نظر نکن، چرا که در اینجا درگیر می‌شوی و به بی‌فایده بودن این زندگی پی می‌بری."],[514,"هین مگو کاینک فلانی کشت کرد","در فلان سالی ملخ کشتش بخورد","بیت به این معناست که نباید درباره قدرت و تاثیر ملخ‌ها یا حوادث بد گذشته صحبت کرد و به یادآوری آنها پرداخت، چون در واقع این یادآوری‌ها نمی‌تواند به حل مشکلات امروز کمک کند. به عبارت دیگر، نباید به اتفاقات ناگواری که در گذشته برای دیگران افتاده است، دل سپرد."],[514,"پس چرا کارم که اینجا خوف هست","من چرا افشانم این گندم ز دست","چرا که وقتی در اینجا خطر وجود دارد، من چرا باید گندم را از دست بدهم و پخش کنم؟"],[514,"و آنک او نگذاشت کشت و کار را","پر کند کوری تو انبار را","و او (خدای) نگذاشت تا زراعت و کار تو کامل شود، و این نادانی توست که انبار را خالی می‌بیند."],[514,"چون دری می‌کوفت او از سلوتی","عاقبت در یافت روزی خلوتی","وقتی او با عشق و اشتیاق از تنهایی‌اش پیوسته می‌کوبید، در نهایت به روزی رسید که دوباره به خلوت و سکوتی دست پیدا کند."],[514,"جست از بیم عسس شب او به باغ","یار خود را یافت چون شمع و چراغ","او به خاطر ترس از نگهبانان شب، در باغ معشوقش جستجو کرد و در آنجا مانند شمع و چراغ، معشوقش را پیدا کرد."],[514,"گفت سازنده سبب را آن نفس","ای خدا تو رحمتی کن بر عسس","سازنده هر علتی، یعنی خدا، را صدا می‌زند و از او درخواست رحمت برای عسس (نگهبان شب) دارد."],[514,"ناشناسا تو سببها کرده‌ای","از در دوزخ بهشتم برده‌ای","تو به روش‌های ناشناخته‌ای باعث شده‌ای که از در جهنم به بهشت بروم."],[514,"بهر آن کردی سبب این کار را","تا ندارم خوار من یک خار را","به خاطر آنکه سبب این کار را برای من فراهم کردی، حتی اگر خار کوچکی هم از من نرود، من خوار نمی‌شوم."],[514,"در شکست پای بخشد حق پری","هم ز قعر چاه بگشاید دری","خداوند در هنگام شکست و ناکامی به انسان روح امید می‌بخشد و حتی از عمیق‌ترین مشکلات، راه نجاتی فراهم می‌کند."],[514,"تو مبین که بر درختی یا به چاه","تو مرا بین که منم مفتاح راه","به چشمانت نگاه نکن که آیا من بر درختی نشسته‌ام یا در چاهی افتاده‌ام، بلکه من را ببین که در واقع خودم کلید و راهگشای مسیری هستم."],[514,"گر تو خواهی باقی این گفت و گو","ای اخی در دفتر چارم بجو","اگر تو می‌خواهی ادامه این بحث و گفت‌وگو را بشنوی، ای برادر، آن را در بخش چهارم مثنوی جست‌وجو کن."],[515,"ای ضیاء الحق حسام الدین توی","که گذشت از مه به نورت مثنوی","ای حسام‌الدین، تو نور حقیقت و روشنایی هستی که از ماه نیز فراتر رفته‌ای و به نور خداوندی رسیده‌ای."],[515,"همت عالی تو ای مرتجا","می‌کشد این را خدا داند کجا","همت و اراده‌ی بلند تو، ای امید، باعث می‌شود که این مثنوی به جایی برود که خدا بهتر از همه می‌داند کجاست."],[515,"گردن این مثنوی را بسته‌ای","می‌کشی آن سوی که دانسته‌ای","تو گردن این مثنوی را به دست خود بسته‌ای و به سوی مقصدی که می‌دانی می‌کشی."],[515,"مثنوی پویان کشنده ناپدید","ناپدید از جاهلی کش نیست دید","مثنوی مانند یک نهر روان است که در هر لحظه، دانش و آگاهی را از جاهلان مخفی می‌کند و از دید آنها پنهان است."],[515,"مثنوی را چون تو مبدا بوده‌ای","گر فزون گردد توش افزوده‌ای","مولانا به این نکته اشاره دارد که چون تو خود به‌عنوان منبع و آغازگر مثنوی بوده‌ای، اگر این اثر بیشتر و پربارتر شود، به‌واسطه تو و تلاش‌های تو خواهد بود."],[515,"چون چنین خواهی خدا خواهد چنین","می‌دهد حق آرزوی متقین","اگر تو چنین بخواهی، خداوند هم چنین را خواهد خواست و به حق، آرزوی پرهیزگاران را می‌دهد."],[515,"کان لله بوده‌ای در ما مضی","تا که کان الله پیش آمد جزا","تو در گذشته به خاطر خداوند در دل ما بوده‌ای و تا زمانی که خداوند به تو پاداش ندهد، جزا و پاداشی برای تو نخواهد بود."],[515,"مثنوی از تو هزاران شکر داشت","در دعا و شکر کفها بر فراشت","شکر و دعاهای تو در مثنوی به اندازه‌ای زیاد بود که باعث شد دست‌هایت به نشانه سپاس‌گذاری بالا برود."],[515,"در لب و کفش خدا شکر تو دید","فضل کرد و لطف فرمود و مزید","خدا شکر تو را در لب و کفش (زبان و دست) می‌بیند و بر تو نعمت و رحمت خود را نازل کرده و بر آن افزوده است."],[515,"زانک شاکر را زیادت وعده است","آنچنانک قرب مزد سجده است","شکرگزاران به خاطر شکرگذاری خود پاداش بیشتری دریافت می‌کنند، مشابه این که نزد خداوند، تقرب به او از سجده کردن ارزش بیشتری دارد."],[515,"گفت واسجد واقترب یزدان ما","قرب جان شد سجده ابدان ما","خداوند می‌گوید که سجده کنید و به من نزدیک شوید، زیرا نزدیکی حقیقی به من با جان شما حاصل می‌شود و نه فقط با بدن‌تان."],[515,"گر زیادت می‌شود زین رو بود","نه از برای بوش و های و هو بود","بوش (بر وزن شوق) یعنی کرّ و فر و خودنمایی همراه با شادی."],[515,"با تو ما چون رز به تابستان خوشیم","حکم داری هین بکش تا می‌کشیم","با تو مانند گل سرخ در تابستان شاداب و خوشحال هستیم. تو سرپرستی ما را بر عهده داری، پس هین، بکش تا ما هم به تو پاسخ دهیم."],[515,"خوش بکش این کاروان را تا به حج","ای امیر صبر مفتاح الفرج","ای امیر، با شوق و خوشی این کاروان را به راه انداز تاکم به سوی حج برویم که صبر، کلید گشایش و رهایی است."],[515,"حج زیارت کردن خانه بود","حج رب البیت مردانه بود","حج، زیارت خانه خدا (کعبه) است و اصل آن به پرستش و بندگی خدا مربوط می‌شود و این نوع عبادت، نشانه‌ای از مردانگی و دلیری است."],[515,"زان ضیا گفتم حسام‌الدین ترا","که تو خورشیدی و این دو وصفها","از آن نور (ضیا) من درباره حسام‌الدین صحبت کردم، زیرا تو مانند خورشید هستی و این دو ویژگی تو هستند."],[515,"کین حسام و این ضیا یکیست هین","تیغ خورشید از ضیا باشد یقین","حسام‌الدین و نور (یا ضیا) هر دو یکی هستند، پس بدان که تیغ خورشید از همین نور می‌باشد."],[515,"نور از آن ماه باشد وین ضیا","آن خورشید این فرو خوان از نبا","نور مربوط به ماه است و این روشنایی مربوط به خورشید؛ این نور را از ندا و فراخوانی درک کن."],[515,"شمس را قرآن ضیا خواند ای پدر","و آن قمر را نور خواند این را نگر","ای پدر، شمس (شمس‌الدین تبریزی) را به سبب نورش به قرآنی روشن تشبیه کرده‌اند و ماه (قمر) را به نوری که از آن ساطع می‌شود، لقب داده‌اند؛ به این موضوع توجه کن."],[515,"شمس چون عالی‌تر آمد خود ز ماه","پس ضیا از نور افزون دان به جاه","شمس به خاطر اوج مقامش از ماه برتر است؛ بنابراین، روشنایی او را در مقایسه با نور ماه بیشتر بدان و به اهمیت او در جایگاهش پی ببر."],[515,"بس کس اندر نور مه منهج ندید","چون برآمد آفتاب آن شد پدید","هیچ‌کس در نور ماه، راه و نشانه را نمی‌بیند، اما وقتی خورشید طلوع می‌کند، همه چیز نمایان می‌شود."],[515,"آفتاب اعواض را کامل نمود","لاجرم بازارها در روز بود","آفتاب، عیب‌ها و نواقص را برطرف کرد، به همین دلیل بازارها در روز پررونق و شلوغ هستند."],[515,"تا که قلب و نقد نیک آید پدید","تا بود از غبن و از حیله بعید","تا زمانی که دل و کالای خوب آشکار شود، انسان باید از فریب و نیرنگ دور باشد."],[515,"تا که نورش کامل آمد در زمین","تاجران را رحمة للعالمین","تا هنگامی که نور او، یعنی نور خدا یا پیامبر، به طور کامل بر زمین تابید، تاجران و کسبه تحت رحمت و نعمت او قرار گرفتند."],[515,"لیک بر قلاب مبغوضست و سخت","زانک ازو شد کاسد او را نقد و رخت","اما بر افرادی که از او متنفرند و او را نمی‌پسندند، بسیار سخت است؛ چون به خاطر آن نفرت و بیزاری، اموالشان از دست رفته و کاسبی‌شان نابود شده است."],[515,"پس عدو جان صرافست قلب","دشمن درویش کی بود غیر کلب","دشمن، جان صراف (تاجری) است و قلب او مانند تابی (درویش) است که در آن چیزی جز وفاداری و محبت نیست."],[515,"انبیا با دشمنان بر می‌تنند","پس ملایک رب سلم می‌زنند","انبیا (پیامبران) با دشمنان خود مقابله می‌کنند و در این حال فرشتگان خداوند (ملایک) به آنها سلام می‌فرستند."],[515,"کین چراغی را که هست او نور کار","از پف و دمهای دزدان دور دار","این چراغ را که او نور (راهنما و حقیقت) است، از خوراک و نفس‌های دزدان (بدان معنی که می‌خواهند نور را خاموش کنند) دور نگه‌دار."],[515,"دزد و قلابست خصم نور بس","زین دو ای فریادرس فریاد رس","دزد و قلاب (دوربین، خفه‌کننده) دشمن نور هستند، پس ای فریادرس و کمک‌کننده، به فریاد برس."],[515,"روشنی بر دفتر چارم بریز","کآفتاب از چرخ چارم کرد خیز","ای نور، بر دفتر چهارم روشنی بپاش، زیرا خورشید از افق چهارم طلوع کرد."],[515,"هین ز چارم نور ده خورشیدوار","تا بتابد بر بلاد و بر دیار","ای نور چرخ چهارم، مانند خورشید، نور خود را به دیگر نقاط زمین بتابان تا بر شهرها و دیارها روشنایی بپاشی."],[515,"هر کش افسانه بخواند افسانه است","وآنک دیدش نقد خود مردانه است","هر کس به داستان‌ها و افسانه‌ها گوش دهد، برای او آن افسانه حقیقتی است، اما اگر ببیند که نقد و دیدگاه‌های خود را به‌طور واقعی و با شجاعت بررسی کند، درک بهتری خواهد داشت."],[515,"آب نیلست و به قبطی خون نمود","قوم موسی را نه خون بد آب بود","آب نیل برای قوم موسی به رنگ خون درآمد، اما در واقع خون نبود و فقط جلوه‌ای از آب نیل به نظر می‌رسید."],[515,"دشمن این حرف این دم در نظر","شد ممثل سرنگون اندر سقر","دشمن این سخن که اکنون بیان می‌شود، در نظرش به گونه‌ای تصویر می‌شود که در حال سقوط و آتش دوزخ است."],[515,"ای ضیاء الحق تو دیدی حال او","حق نمودت پاسخ افعال او","ای روشنی حق، تو حال او را دیدی و حق، پاسخ کارهای او را به تو نشان داد."],[515,"دیده غیبت چو غیبست اوستاد","کم مبادا زین جهان این دید و داد","چشم‌های غیرمادی، مثل خود غیبت، استاد و معلم نیستند؛ پس نباید به این جهان و آنچه در آن دیده و داده می‌شود، اعتماد کرد."],[515,"این حکایت را که نقد وقت ماست","گر تمامش می‌کنی اینجا رواست","این داستان که مربوط به زمان ماست، اگر تمامش را اینجا بیان کنی، کاری نیکوست."],[515,"ناکسان را ترک کن بهر کسان","قصه را پایان بر و مخلص رسان","ناچیزها را رها کن و به خاطر افراد دیگر به داستان خاتمه بده و آنچه را که لازم است به‌طور خلاصه بیان کن."],[515,"این حکایت گر نشد آنجا تمام","چارمین جلدست آرش در نظام","اگر این داستان به پایان نرسد، به‌نوعی در حکم جلد چهارم کتاب است و آرش (که در داستان‌های فارسی نماد قهرمانی است) در ساختار نظم قرار دارد."],[516,"اندر آن بودیم کان شخص از عسس","راند اندر باغ از خوفی فرس","ماجرا از این قرار بود که آن شخص ( مرد ) از ترس نگهبانان٬اسبی را به داخل باغ راند."],[516,"بود اندر باغ آن صاحب‌جمال","کز غمش این در عنا بد هشت سال","در آن باغ همان شخص زیبارویی که به سبب غم دوری او هشت سال در رنج و سختی به سر برده بود حضور داشت."],[516,"سایه او را نبود امکان دید","هم‌چو عنقا وصف او را می‌شنید","( پیش از این اتفاق) حتی امکان دیدن سایه او را هم نداشت؛ درست مثل عنقا که خودش دیده نمی‌شود و فقط وصف و آوازه‌اش را می‌شنوند."],[516,"جز یکی لقیه که اول از قضا","بر وی افتاد و شد او را دلربا","جز یک بار که از روی اتفاق، برای نخستین بار چشمش به او افتاد و همان دیدار باعث شد آن شخص برایش دلربا و محبوب شود."],[516,"بعد از آن چندان که می‌کوشید او","خود مجالش می‌نداد آن تندخو","بعد از آن دیدار، هرقدر تلاش می‌کرد، آن شخص تندخو به او فرصت و امکان نزدیک شدن نمی‌داد."],[516,"نه به لابه چاره بودش نه به مال","چشم پر و بی‌طمع بود آن نهال","نه التماس و زاری می‌توانست کاری از پیش ببرد و نه پول و مال می‌توانست دل او را به دست آورد؛ آن شخص بی طمع و چشم و دل سیر بود."],[516,"عاشق هر پیشه‌ای و مطلبی","حق بیالود اول کارش لبی","هر شخصی که عاشق خواسته ای است از ابتدا حق لذت آن عشق را بر او چشانده است .انسان در ابتدا با حقیقتی آشنا شده؛سپس به عالم کثرت آمده و آن آشنایی را به‌صورت یک شوق مبهم و درونی با خود حمل می‌کند؛بنابراین تمام زندگی‌اش تبدیل به جست‌وجوی چیزی می‌شود که گویی قبلا آن را چشیده اما اکنون از آن دور افتاده است"],[516,"چون بدان آسیب در جست آمدند","پیش پاشان می‌نهد هر روز بند","اما همین که عاشقان برای رسیدن به آن مطلوب به جست‌وجویش برمی‌آیند، هر روز مانع و بندی تازه بر سر راهشان قرار می‌دهد."],[516,"چون در افکندش بجست و جوی کار","بعد از آن در بست که کابین بیار","وقتی او را به جست‌وجوی این کار و مطلوب انداخت، پس از آن در وصال را بست و گفت: اگر می‌خواهی به خواسته ات برسی، باید کابین/مهر را بیاوری. یعنی:اول او را به طلب انداخت، بعد شرط و مانعی برای رسیدن قرار داد."],[516,"هم بر آن بو می‌تنند و می‌روند","هر دمی راجی و آیس می‌شوند","آنان به امید رسیدن به مطلوب، همچنان پیش می‌روند؛ اما لحظه ای امیدوار می‌شوند و لحظه‌ای بعد ناامید."],[516,"هر کسی را هست اومید بری","که گشادندش در آن روزی دری","هر کسی که امیدی برای رسیدن به مقصود و گشایش دارد، به این امید است که روزی دری به روی او گشوده شود."],[516,"باز در بستندش و آن درپرست","بر همان اومید آتش پا شدست","باز هم آن در را به رویش بستند؛ اما آن عاشق درپرست، همچنان به همان امید باقی ماند و با شتاب و بی‌قراری به تلاش و رفت‌وآمد ادامه داد.در پرست : کسی که در را می‌پرستد؛ کنایه از کسی که تمام امید و توجهش به گشوده‌شدن همان در است."],[516,"چون درآمد خوش در آن باغ آن جوان","خود فرو شد پا به گنجش ناگهان","جوان وارد باغ شد و ناگهان گنجی پیدا کرد."],[516,"مر عسس را ساخته یزدان سبب","تا ز بیم او دود در باغ شب","«خداوند، عسس و نگهبان را وسیله و سبب قرار داده بود تا آن جوان از ترس او شبانه به باغ برود."],[516,"بیند آن معشوقه را او با چراغ","طالب انگشتری در جوی باغ","معشوقه اش را چراغ بر دست می بیند که در جوی آب موجود در باغ به دنبال انگشتری می گردد."],[516,"پس قرین می‌کرد از ذوق آن نفس","با ثنای حق دعای آن عسس","جوان از شدت خوشحالی، در کنار اینکه خدا را ستایش می‌کرد، برای عسس هم دعا می‌کرد.قرین‌ می کرد یعنی همراه می کرد چه چیزی را همراه می کرد ؟ ثنای حق و دعاگویی نگهبان را."],[516,"که زیان کردم عسس را از گریز","بیست چندان سیم و زر بر وی بریز","من به خاطر فرار کردن از عسس، به او زیان رساندم؛ خدایا، چندین برابر آن، سیم و زر نصیب او کن."],[516,"از عوانی مر ورا آزاد کن","آنچنان که شادم او را شاد کن","خدایا، او را از عوانی ( پاسبان بودن ) و ستمگری آزاد کن؛ و همان‌طور که مرا شاد کردی، او را نیز شاد و خوشحال کن."],[516,"سعد دارش این جهان و آن جهان","از عوانی و سگی‌اش وا رهان","( خداوندا) در هردو جهان او را سعادتمند گردان و از پاسبانی و فرومایگی رهایی اش ده.(لازم و ملزوم بودن عوانی و سگی قابل توجه است)."],[516,"گرچه خوی آن عوان هست ای خدا","که هماره خلق را خواهد بلا","خدایا، هرچند خصلت و عادت این عوان چنین است که همیشه برای مردم گرفتاری و بلا می‌خواهد."],[516,"گر خبر آید که شه جرمی نهاد","بر مسلمانان شود او زفت و شاد","اگر خبری برسد که شاه بر مسلمانان جرم و ستمی روا داشته، این عوان از این خبر بسیار شاد می شوند."],[516,"ور خبر آید که شه رحمت نمود","از مسلمانان فکند آن را به جود","اگر خبر برسد که شاه به مسلمانان رحم کرده و چیزی به آنان بخشیده است، این عوان از آن بخشش شاه نسبت به مردم، برای خودش بهره و سهم برمی‌دارد."],[516,"ماتمی در جان او افتد از آن","صد چنین ادبارها دارد عوان","( در ادامه بیت قبلی است ) اگر خبر برسد که شاه به مردم رحم و بخشش کرده، برای این عوان چنان است که انگار مصیبت و ماتمی به جانش افتاده است."],[516,"او عوان را در دعا در می‌کشید","کز عوان او را چنان راحت رسید","او عوان ( پاسبان) را دعا می کرد چرا که به واسطه او به چنین گشایش و آسایشی رسیده بود."],[516,"بر همه زهر و برو تریاق بود","آن عوان پیوند آن مشتاق بود","عوان( عسس٬نگهبان) برای همه ی مردم مانند زهر اما برای مرد عاشق همانند پادزهر و تریاق بود و باعث پیوند و رسیدن مشتاق به معشوق ."],[516,"پس بد مطلق نباشد در جهان","بد به نسبت باشد این را هم بدان","پس در جهان چیزی که از هر جهت و برای همه، «بد مطلق» باشد وجود ندارد؛ بدی معمولا نسبی است و به شرایط، شخص و نتیجه‌ای که از آن حاصل می‌شود بستگی دارد."],[516,"در زمانه هیچ زهر و قند نیست","که یکی را پا دگر را بند نیست","در این جهان هیچ چیز کاملا زهر یا کاملا قند نیست؛ ممکن است یک چیز برای یک نفر سودمند و گوارا باشد، اما برای دیگری زیان‌آور و مانع شود."],[516,"مر یکی را پا دگر را پای‌بند","مر یکی را زهر و بر دیگر چو قند","هر کسی در زندگی‌اش با چالش‌ها و لذت‌ها مواجه است؛ برخی بر اثر مشکلاتی که با آن‌ها روبه‌رو می‌شوند، به بند می‌افتند و برخی دیگر از تجربه‌های تلخ به خوشی می‌رسند. این دوگانگی نشان‌دهنده این است که برای هر کس، تجربه‌ها و شرایط زندگی ممکن است به شکل‌های متفاوت معنا پیدا کند."],[516,"زهر مار آن مار را باشد حیات","نسبتش با آدمی باشد ممات","زهر مار برای خود مار زنده‌کننده است، اما نسبت به انسان، مرگ‌آور و مهلک است."],[516,"خلق آبی را بود دریا چو باغ","خلق خاکی را بود آن مرگ و داغ","برای موجودات آبی مانند ماهی‌ها، دریا همچون یک باغ وسیع و زیبا است؛ اما برای موجودات خاکی مانند انسان‌ها، زندگی با مرگ و غم همراه است."],[516,"همچنین بر می‌شمر ای مرد کار","نسبت این از یکی کس تا هزار","ای مرد، این موضوع را نیز در نظر بگیر که کارهای هر شخص، از یک نفر تا هزار نفر، به هم ارتباط دارد و تأثیر می‌گذارد."],[516,"زید اندر حق آن شیطان بود","در حق شخصی دگر سلطان بود","زید در مورد آن شیطان (شخص بد) به‌راستی بد بوده، اما در مورد فرد دیگری (شخص دیگر) به عنوان سلطان (قدرتمند و محترم) به حساب می‌آید. این بیان نشان‌دهنده دوگانگی قضاوت درباره یک شخص است که بسته به شرایط و زمینه تغییر می‌کند."],[516,"آن بگوید زید صدیق سنیست","وین بگوید زید گبر کشتنیست","یکی می‌گوید زید در حقیقت شخصی درستکار و اهل تسنّی است و دیگری می‌گوید زید کافر و باید او را کشت."],[516,"زید یک ذات است ، بر آن یک جنان","او برین دیگر همه رنج و زیان","زید یک وجود واحد است، اما بر اساس نگاه و برداشت‌ها، او برای برخی انسان‌های خوب و برای برخی دیگر مسبب رنج و زیان است."],[516,"گر تو خواهی کو ترا باشد شکر","پس ورا از چشم عشاقش نگر","اگر می‌خواهی بدانید که چه کسی را شکرگزاری کنیم، پس او را از دید دل‌باخته‌ها تماشا کن."],[516,"منگر از چشم خودت آن خوب را","بین به چشم طالبان مطلوب را","به جای این که با دید خود به زیبایی محبوب نگاه کنی، از منظر عاشقان خواسته‌های خود او را تماشا کن."],[516,"چشم خود بر بند زان خوش‌چشم تو","عاریت کن چشم از عشاق او","چشم خود را بر اساس درک و سلیقه‌ات نبند و آن را به عشق و زیبایی که او دارد بسپار. به عبارت دیگر، از دیدگاه عاشقان او نگاه کن و به زیبایی‌های او توجه کن."],[516,"بلک ازو کن عاریت چشم و نظر","پس ز چشم او بروی او نگر","چشم خود را به عشق او قرض بده و از دیدگاه او به معشوق نگاه کن؛ یعنی زیبایی و کمال را از دید او ببین."],[516,"تا شوی آمن ز سیری و ملال","گفت کان الله له زین ذوالجلال","تا زمانی که در آرامش و امنیت از گرسنگی و بی‌حوصلگی قرار بگیری، آنگاه می‌گویی که خداوند، صاحب عظمت و جلال، آراسته است."],[516,"چشم او من باشم و دست و دلش","تا رهد از مدبریها مقبلش","منظور در این بیت این است که چشم او (معشوق) من هستم و دست و دلش (اعضا و احساسات او) به سوی من است، تا از تدبیرهای دنیا رهایی یابد و به سوی من بیفتد."],[516,"هر چه مکروه ست چون شد او دلیل","سوی محبوبت حبیبست و خلیل","هر چیزی که ناخوشایند و بد به نظر می‌رسد، زمانی که به سوی محبوب تو (معشوق) دلالت کند، در واقع دوست و محبوب توست و به مانند یک دوست صمیمی است."],[517,"آن یکی واعظ چو بر تخت آمدی","قاطعان راه را داعی شدی","وقتی آن واعظ بر جایگاه خود نشست ، قاطعان طریق و دزدان راه را دعا کرد."],[517,"دست برمی‌داشت یا رب رحم ران","بر بدان و مفسدان و طاغیان","خداوندا ، رحم کن بر بدکاران و فسادگران و ستمگران"],[517,"بر همه تسخرکنان اهل خیر","برهمه کافردلان و اهل دیر","بر همه کسانی که اهل خوبی و نیکی را مسخره میکنند ، و نیز بر همه کافران و کسانی که دل تاریکی دارند و در معبدهای باطل فعالیت دارند"],[517,"می‌نکردی او دعا بر اصفیا","می‌نکردی جز خبیثان را دعا","نه تنها دعایی درحق خالصان که منظور پیامبران و بزرگان هست نکرد بلکه هر چه دعا کرد درحق ظالمان کرد"],[517,"مر ورا گفتند کین معهود نیست","دعوت اهل ضلالت جود نیست","به او گفتند اینکه دعا کردن برای اهل ضلالت (گمراهان) معمول نیست و چنین کار نیکوی نیست."],[517,"گفت نیکویی ازینها دیده‌ام","من دعاشان زین سبب بگزیده‌ام","او می‌گوید که از نیکوکاران و خیرخواهان چیزهای خوبی دیده‌ام و به همین دلیل دعاهای آن‌ها را انتخاب کرده‌ام و به‌کار می‌برم."],[517,"خبث و ظلم و جور چندان ساختند","که مرا از شر به خیر انداختند","زحمت‌ها و ظلم‌هایی که به من کردند به قدری زیاد بود که توانستم از شر به سمت خیر و نیکی بروم."],[517,"هر گهی که رو به دنیا کردمی","من ازیشان زخم و ضربت خوردمی","هر بار که به دنیای مادی و مشکلات آن رو آوردم، از ظلم و آسیب‌های آن‌ها (ظالمین) ضربه خوردم و صدمه دیدم."],[517,"کردمی از زخم آن جانب پناه","باز آوردندمی گرگان به راه","از زخم و آزار آن افراد بی‌دین و سخت‌دل، به سوی پناهگاهی دیگر روی آوردم و گرگ‌ها (که نماد خطر و دسیسه هستند) مرا به راه خود کشاندند."],[517,"چون سبب‌ساز صلاح من شدند","پس دعاشان بر منست ای هوشمند","وقتی که آن‌ها که باعث بهبودی من شدند، پس دعای آن‌ها برای من است ای خردمند."],[517,"بنده می‌نالد به حق از درد و نیش","صد شکایت می‌کند از رنج خویش","بنده به خداوند از درد و زخم‌هایش شکایت می‌کند و به‌طور مکرر از رنج‌هایی که تحمل کرده، ناله می‌زند."],[517,"حق همی گوید که آخر رنج و درد","مر ترا لابه کنان و راست کرد","خداوند می‌گوید که در نهایت، رنج و سختی تو باعث خواهد شد که با صداقت و از صمیم قلب درخواست کمک کنی."],[517,"این گله زان نعمتی کن کت زند","از در ما دور و مطرودت کند","این گله (گله‌ای از مردم یا خواسته‌ها) از نعمتی است که تو را از در ما دور و طرد می‌کند. یعنی اگر به این خواسته‌ها توجه کنی، از رابطه‌ات با ما (یا خدا) دور می‌شوی و از نعمت‌های واقعی محروم خواهی ماند."],[517,"در حقیقت هر عدو داروی تست","کیمیا و نافع و دلجوی تست","در واقع، هر دشمنی برای تو دارویی است که مانند کیمیا اثرگذار و مفید است و باعث خوشحالی و دل‌جویی تو می‌شود."],[517,"که ازو اندر گریزی در خلا","استعانت جویی از لطف خدا","وقتی از دشمن فرار کنی و به خلوت پناه میبری از لطف و رحمت خدا کمک می‌خواهی."],[517,"در حقیقت دوستانت دشمن‌اند","که ز حضرت دور و مشغولت کنند","در واقع، دوستانی که در اطرافت هستند، به نوعی دشمن تو هستند ، چرا که تو را از خداوند دور کرده و به کارهای دنیوی مشغول می‌کنند."],[517,"هست حیوانی که نامش اشغرست","او به زخم چوب زفت و لمترست","یک حیوانی هست به نام خارپشت که با ضرب و زخم چوب زدن چاق و تنبل میشود."],[517,"تا که چوبش می‌زنی به می‌شود","او ز زخم چوب فربه می‌شود","هر زمانی که چوب به او زده می‌شود، او به دلیل زخم چوب چاق و فربه‌تر می‌شود."],[517,"نفس مؤمن اشغری آمد یقین","کو به زخم رنج زفتست و سمین","نفس مؤمن قطعا مانند خارپشتی است که با زخم رنج و تعب ، به ثمر می‌رسد و از نظر معنوی چاق و فربه میشود و به مراتب بالا می‌رسد."],[517,"زین سبب بر انبیا رنج و شکست","از همه خلق جهان افزونترست","به همین دلیل، پیامبران بیشتر از دیگر مردم دنیا رنج و شکست را متحمل می‌شوند."],[517,"تا ز جانها جانشان شد زفت‌تر","که ندیدند آن بلا قوم دگر","این مردم به خاطر سختی‌ها و رنج‌هایی که دیده‌اند، در وضعیت بدتری از دیگر اقوام قرار دارند و به همین دلیل نتوانسته‌اند عذاب و مصیبت‌های خود را تحمل کنند."],[517,"پوست از دارو بلاکش می‌شود","چون ادیم طایفی خوش می‌شود","پوست (به هنگام دباغی) از تأثیر داروهایی که به آن می‌زنند پاک می‌شود ، همان‌طور که چرم طائفی(چرم یمنی) با دباغی خوش و زیبا می‌شود."],[517,"ورنه تلخ و تیز مالیدی درو","گنده گشتی ناخوش و ناپاک بو","وگرنه اگر به تلخی و زشتی روی آن پوست مواد اضافی(موادی غیر از داروهای دباغی) بمالی ، پوست گندیده و ناخوش و کثیف خواهد شد . کنایه از اینکه صفات رذیله روح را آلوده میکند."],[517,"آدمی را پوست نامدبوغ دان","از رطوبتها شده زشت و گران","انسان مانند پوست دباغی نشده است. به دلیل رطوبت‌ها و کثیفی‌ها، به نوعی زشت و ناپسند و سنگین در آمده است."],[517,"تلخ و تیز و مالش بسیار ده","تا شود پاک و لطیف و با فره","تلاش و سختی و مجاهده و ریاضت بسیاری بخرج بده ، تا پوست روحت پاک و لطیف و خوب شود"],[517,"ور نمی‌تانی رضا ده ای عیار","گر خدا رنجت دهد بی‌اختیار","اگر ه‍م نمی‌توانی ریاضت بکشی و مجاهده نفس کنی خشنود و راضی باش ای انسان باارزش ، چرا که وقتی که خدا رنج و درد به تو ارزانی دارد و بدانی در این رنج هیچ اختیاری نداری که آنرا از خودت دور کنی پرورش پیدا خواهی کرد ."],[517,"که بلای دوست تطهیر شماست","علم او بالای تدبیر شماست","مشکلات و سختی‌هایی که حضرت دوست به تو ارزانی میدارد ، باعث پاکسازی و بهبود شما می‌شود . و البته دانش او بر تدبیر شما برتری و تسلط مسلم دارد."],[517,"چون صفا بیند بلا شیرین شود","خوش شود دارو چو صحت‌بین شود","وقتی که انسان معنوی به صفا و پاکی دست پیدا کند، درد و بلا برایش شیرین و خوشایند می‌شود ، مانند وقتی که مریضی بهبودی اش را مجسم می‌کند و داروی ناخوشایند و تلخ را مینوشد ."],[517,"برد بیند خویش را در عین مات","پس بگوید اقتلوني یا ثقات","در عین حالی که در شطرنج بلاها مات شده و شکست خورده ولی در حقیقت برد خویش را میبیند . پس با افتخار فریاد می‌زند: \"مرا بکشید ای معتمدین !\""],[517,"این عوان در حق غیری سود شد","لیک اندر حق خود مردود شد","این واعظ در مورد دیگران فایده‌مند واقع می‌شود، اما در حق خودش پذیرفته نمی‌شود و مقبول نیست."],[517,"رحم ایمانی ازو ببریده شد","کین شیطانی برو پیچیده شد","ایمان او از رحم و محبت جدا شده و این کینه و دشمنی شیطانی بر او حاکم شده است."],[517,"کارگاه خشم گشت و کین‌وری","کینه دان اصل ضلال و کافری","خشم و کینه در دل او مانند کارگاهی شده است که از آن، ضلالت و کفر به وجود می‌آید و این احساسات زشت ریشه‌ زورگویی و انحراف از حقیقت است."],[518,"گفت عیسی را یکی هشیار سر","چیست در هستی ز جمله صعب‌تر","یک فرد باهوش از عیسی علیه‌السلام می‌پرسد که در زندگی چه چیزی از همه دشوارتر است."],[518,"گفتش ای جان صعب‌تر خشم خدا","که از آن دوزخ همی لرزد چو ما","عیسی (علیه‌السلام) به آن شخص می‌گوید که دشوارتر از خشم خداوندی نیست، زیرا این خشم حتی از دوزخ هم موجب ترس و لرز است."],[518,"گفت ازین خشم خدا چبود امان","گفت ترک خشم خویش اندر زمان","او می‌گوید آیا از این خشم خدا راه نجاتی وجود دارد؟ در پاسخ به او گفته می‌شود که باید در زمان‌های مناسب خشم خود راکنار بگذارد."],[518,"پس عوان که معدن این خشم گشت","خشم زشتش از سبع هم در گذشت","پس وقتی که عیسی علیه‌السلام به خشم خداوند توجه کرد، متوجه شد که این خشم، سرچشمه‌ای از صفات ناپسند است و حتی خشم او که از صفات درنده است، از این خشم الهی فراتر می‌رود."],[518,"چه امیدستش به رحمت جز مگر","باز گردد زان صفت آن بی‌هنر","امید او به رحمت خداوند چیست، هنگامی که آن بی‌سزا و فاقد ارزش، از صفات زشت خود برنمی‌گردد؟"],[518,"گرچه عالم را ازیشان چاره نیست","این سخن اندر ضلال افکندنیست","اگرچه مردم برای رهایی از مشکلاتی که دارند، امیدی به این عیسی ندارند، اما این حرف باعث می‌شود که آن‌ها در گمراهی بیشتری قرار بگیرند و از حقیقت دور شوند."],[518,"چاره نبود هم جهان را از چمین","لیک نبود آن چمین ماء معین","جهان از چنان چالشی رهایی ندارد، اما آن چالش، آب مشخصی نیست که از آن سیراب شویم."],[519,"چونک تنهااش بدید آن ساده مرد","زود او قصد کنار و بوسه کرد","چون آن مرد ساده تنها او را دید، به سرعت تصمیم گرفت که به کنارش برود و او را ببوسد."],[519,"بانگ بر وی زد به هیبت آن نگار","که مرو گستاخ ادب را هوش دار","معشوق با شکوه و زیبایی بر عاشق نگاه می‌کند و با صدای بلند به او می‌گوید که مراقب ادب و احترام خود باشد و در این خلوت، بی‌پروا عمل نکند."],[519,"گفت آخر خلوتست و خلق نی","آب حاضر تشنه هم‌چون منی","عاشق می‌گوید که اینجا خلوت است و مردم حضور ندارند، حالا من تشنه عشق و محبت هستم و آب (مانند محبت) برای من به سختی پیدا می‌شود."],[519,"کس نمی‌جنبد درینجا جز که باد","کیست حاضر کیست مانع زین گشاد","در اینجا هیچ‌کس جز باد حرکت نمی‌کند؛ آیا کسی حاضر است و آیا مانعی بر سر راه این آزادی وجود دارد؟"],[519,"گفت ای شیدا تو ابله بوده‌ای","ابلهی وز عاقلان نشنوده‌ای","معشوق به عاشق می‌گوید که تو کم‌خودآگاه و نادانی و از عاقلان سخن‌ها نشنیده‌ای."],[519,"باد را دیدی که می‌جنبد بدان","بادجنبانیست اینجا بادران","انگار باد را دیدی که در حال حرکت است، ولی آن حرکت به خاطر جنبش خود باد نیست، بلکه به خاطر همین بادی است که در اینجا وجود دارد."],[519,"جزو بادی که به حکم ما درست","بادبیزن تا نجنبانی نجست","جزو بادی که به فرمان ما می‌چرخد، باید در سکوت بماند تا به حرکت درنیاید و نجنباند."],[519,"جنبش این جزو باد ای ساده مرد","بی‌تو و بی‌بادبیزن سر نکرد","این جزو باد، حرکتی ندارد و بی‌تو و بی‌بادبیزن آرام و ساکن است، ای مرد ساده."],[519,"جنبش باد نفس کاندر لبست","تابع تصریف جان و قالبست","حرکت و جنبش باد که در نفس توست، تحت تأثیر روح و جسم تو قرار دارد و به همین دلیل به آن وابسته است."],[519,"گاه دم را مدح و پیغامی کنی","گاه دم را هجو و دشنامی کنی","گاهی نفس را تو ستایش می‌کنی و پیام خوب به آن می‌دهی، و گاهی هم نفس را مذمت می‌کنی و به آن دشنام می‌دهی."],[519,"پس بدان احوال دیگر بادها","که ز جزوی کل می‌بیند نهی","برخی از بادها نیز در حالت‌های متفاوتی قرار دارند که از اجزای کل و هر چیز جدا نشدنی هستند و درک آنها بسته به شرایط و اوضاع مختلف است."],[519,"باد را حق گه بهاری می‌کند","در دیش زین لطف عاری می‌کند","باد در فصل بهار به خاطر لطفی که دارد، دیگران را از این نعمت بی‌بهره می‌کند."],[519,"بر گروه عاد صرصر می‌کند","باز بر هودش معطر می‌کند","باد سرد و خشن که به گروه عاد (قوم عاد در داستان‌های قرآنی) نسبت داده شده، دوباره بر آنها می‌وزد و آنها را معطر می‌کند، یعنی به گونه‌ای بر آنها تأثیر می‌گذارد که بوی خوشی را برایشان به ارمغان می‌آورد."],[519,"می‌کند یک باد را زهر سموم","مر صبا را می‌کند خرم‌قدوم","یک باد سموم و مضر را به طوری تغییر می‌دهد که به یک نسیم خوشبو و دلپذیر تبدیل شود. نسیم صبا (باد خوشی) را به وجود می‌آورد که برکت و شادابی به ارمغان می‌آورد."],[519,"باد دم را بر تو بنهاد او اساس","تا کنی هر باد را بر وی قیاس","باد دم، بنیاد وجود تو را گذاشته است تا بتوانی هر بادی را با او مقایسه کنی."],[519,"دم نمی‌گردد سخن بی‌لطف و قهر","بر گروهی شهد و بر قومیست زهر","سخن در absence از محبت و قهر هرگز به زیبایی و دلنشینی نمی‌رسد، همچنان که برای یک گروهی خوشحالی و شیرینی دارد، برای گروهی دیگر درد و تلخی می‌آورد."],[519,"مروحه جنبان پی انعام کس","وز برای قهر هر پشه و مگس","مروحه (بادی که از آن به عطر و خوشبوئی اشاره دارد) به خاطر انعام و بخشش از جانب کسی تکان می‌خورد، اما از نشانه‌های خشم و قهر هر پشه و مگس نیز دور نیست. در واقع، این بیت به تضاد میان لطف و سختی‌ها در زندگی اشاره دارد."],[519,"مروحه تقدیر ربانی چرا","پر نباشد ز امتحان و ابتلا","تقدیر الهی چرا نباید در معرض آزمایش و سختی‌ها باشد؟"],[519,"چونک جزو باد دم یا مروحه","نیست الا مفسده یا مصلحه","هیچ چیز جز جریان باد یا هوای نرم (مروحه) وجود ندارد که مشکلات یا نفعی به همراه نداشته باشد؛ به عبارت دیگر، هر چیزی که به ما می‌رسد، یا به نوعی به ما آسیب می‌زند یا به نفع ماست."],[519,"این شمال و این صبا و این دبور","کی بود از لطف و از انعام دور","این بادهای شمال و صبا (بادهای خوش) و دبور (باد ملایم) چه ارتباطی با دوری از لطف و نعمت خداوند دارد؟"],[519,"یک کف گندم ز انباری ببین","فهم کن کان جمله باشد همچنین","یک مقدار گندم را از انباری ببین و درک کن که آن مقدار تنها نشان‌دهنده کلیّت است و می‌تواند به همه آن انبار اشاره کند."],[519,"کل باد از برج باد آسمان","کی جهد بی مروحه آن بادران","هیچ بادی از آسمان نمی‌تواند حرکت کند و به سمت جلو برود مگر اینکه بادبان‌هایی (مروحه) وجود داشته باشد که آن را هدایت کنند."],[519,"بر سر خرمن به وقت انتقاد","نه که فلاحان ز حق جویند باد","در هنگام جدا کردن کاه از گندم، کشاورزان از خدا طلب باد می‌کنند تا به این واسطه کاه از گندم جدا شود."],[519,"تا جدا گردد ز گندم کاهها","تا به انباری رود یا چاهها","تا زمانی که کاه‌ها از گندم جدا شوند و گندم ها به انبارها و کاه‌ها به چاه‌ها منتقل شوند."],[519,"چون بماند دیر آن باد وزان","جمله را بینی به حق لابه‌کنان","زمانی که نسیم دیرتر از همیشه بوزد، تو همه کشاورزان را خواهی دید که به حق، در حال دعا و درخواست هستند."],[519,"همچنین در طلق آن باد ولاد","گر نیاید بانگ درد آید که داد","به اعتقاد قدما برای تولد لازم بوده بادی در رحم مادر ایجاد شود و بچه را به بیرون هل بدهد، وقتی این باد در رحم مادر وزیده نشود مادر را درد زایمان فرا می‌گیرد و فریاد سر می‌دهد."],[519,"گر نمی‌دانند کش راننده اوست","باد را پس کردن زاری چه خوست","به اعتقاد قدما بادی که در رحم موجب زایمان می‌شد را خدا ایجاد می‌کرد و اگر چنانچه این باد وزیدن نمی‌گرفت و مادر دچار درد شدید می‌شد قابله دست به دعا برمی‌داشت و از خدا طلب باد در رحم می‌کرد."],[519,"اهل کشتی همچنین جویای باد","جمله خواهانش از آن رب العباد","اهل کشتی، که به سفر در دریا مشغولند، همواره به دنبال وزش باد هستند، زیرا همه آنها خواسته و نیازشان را از جانب خداوندی (رب‌العباد) می‌طلبند."],[519,"همچنین در درد دندانها ز باد","دفع می‌خواهی بسوز و اعتقاد","بنا به اعتقاد قدما درد دندان ناشی از وجود باد در دندان بود و کسی که دندان درد می‌گرفت با عجر و لابه از خدا می‌خواست تا درد دندانش از بین برود."],[519,"از خدا لابه‌کنان آن جندیان","که بده باد ظفر ای کامران","از خدا خواهش کن که مانند جندان (مترسک) به تو باد پیروزی عطا کند، ای کامیاب."],[519,"رقعه تعویذ می‌خواهند نیز","در شکنجه طلق زن از هر عزیز","عاشقانی که در درد و رنج هستند، به دنبال برگه‌ای از دعا یا تعویذ می‌گردند تا در این حال سختی که در عشقشان می‌گذرانند، به کمکشان بیاید."],[519,"پس همه دانسته‌اند آن را یقین","که فرستد باد رب‌العالمین","همه می‌دانند که باد، از جانب خداوند رب‌العالمین فرستاده می‌شود و این موضوع برای همه روشن است."],[519,"پس یقین در عقل هر داننده هست","اینک با جنبنده جنباننده هست","پس به طور قطع در عقلی که هر آگاه و دانا دارد، این حقیقت موجود است که هر متحرکی نیازمند محرک است."],[519,"گر تو او را می‌نبینی در نظر","فهم کن آن را به اظهار اثر","اگر تو او را در چشمت نمی‌بینی، درک کن که وجودش را با آثار و نشانه‌هایش می‌توان فهمید."],[519,"تن به جان جنبد نمی‌بینی تو جان","لیک از جنبیدن تن جان بدان","تو به حرکات و جنبش‌های جسم چیزی نمی‌نگری، اما بدان که روح از حرکت‌های جسمی آگاه است و در آن زندگی می‌کند."],[519,"گفت او گر ابلهم من در ادب","زیرکم اندر وفا و در طلب","اینجا پسر نسبت به رفتار و بی‌ادبی خودش اظهار ندامت می‌کنه و ادعا می‌کنه در عشق دختر ثابت قدم است."],[519,"گفت ادب این بود خود که دیده شد","آن دگر را خود همی‌دانی تو لد","دختر به پسر با طعنه می‌گوید که معیار ادبت همین رفتارت بود که ازت دیدم(تلاش پسر برای بوسیدن دختر بدون میل او) عشقت هم مانند همین رفتارت فاقد اصالت است ای دشمن بزرگ عشق. لد: دشمن بزرگ"],[520,"صوفیی آمد به سوی خانه روز","خانه یک در بود و زن با کفش‌دوز","صوفی که به خیانت همسرش شک کرده بود در هنگام روز سر زده به خانه می‌رود و با در بسته مواجه می‌شود. یک در: دو لت بسته شده در کنایه از در بسته. دو در: دو لت باز شده در و کنایه از در باز."],[520,"جفت گشته با رهی خویش زن","اندر آن یک حجره از وسواس تن","رهی: غلام و چاکر. زن با معشوق خود حین انجام عمل جنسی در آن خانه‌ی کوچک بودند."],[520,"چون بزد صوفی به جد در چاشتگاه","هر دو درماندند نه حیلت نه راه","در صبح زود، وقتی که صوفی با جدیت (با شوخی) به مغازه رفته بود، هر دو در موقعیتی دشوار قرار گرفتند و نه تدبیری برای فرار داشتند و نه راهی برای نجات."],[520,"هیچ معهودش نبد کو آن زمان","سوی خانه باز گردد از دکان","صوفی همچین عادتی نداشت که در آن زمان در خانه حاضر شود."],[520,"قاصدا آن روز بی‌وقت آن مروع","از خیالی کرد تا خانه رجوع","در آن روز، صوفی که پرتکاپو و نگران بود، به دلخواه خود تصمیم می‌گیرد که بازگردد به خانه، با یک خیال و فکر مشخص در ذهنش."],[520,"اعتماد زن بر آن کو هیچ بار","این زمان فا خانه نامد او ز کار","زن مطمئن بود که همسرش هیچ وقت در آن ساعت به خانه نخواهد آمد."],[520,"آن قیاسش راست نامد از قضا","گرچه ستارست هم بدهد سزا","از قضا تفکرش نسبت به ساعت ورود و خروج همسرش در این روز مشخص درست نبود و نتیجه‌ی دلخواه را به دست نیاورد. خدا گرچه ستار العیوب است و در خیلی از موقعیت‌ها پوشاننده‌ی رفتارهای غلط است و فرصت اصلاح می‌دهد ولی در عین حال سزادهنده‌ی افعال تقبیح شده هم هست و افرادی که فعل شر را بارها و بارها انجام می‌دهند را به سزای اعمالشان می‌رساند."],[520,"چونک بد کردی بترس آمن مباش","زانک تخمست و برویاند خداش","وقتی کار بدی می‌کنی، باید از عاقبتش بترسی و خودت را در امان ندان. زیرا آن کار بد، بذر سوء است که خداوند به بار می‌آورد."],[520,"چند گاهی او بپوشاند که تا","آیدت زان بد پشیمان و حیا","مدتی او در تلاش است که این کار زشت را پنهان کند تا زمانی که تو از آن کار بد پشیمان شوی و شرمنده باشی."],[520,"عهد عمر آن امیر مؤمنان","داد دزدی را به جلاد و عوان","در عهد خلافت خلیفه‌ی دوم، جناب عمر دزدی را می‌گیرد و اورا به دست جلاد می‌سپارد تا اورا به سزای اعمالش برساند."],[520,"بانگ زد آن دزد کای میر دیار","اولین بارست جرمم زینهار","دزد فریاد کرد که ای فرمانروای کشور، این اولین بار است که من مرتکب جرم می‌شوم، پس مرا ببخش."],[520,"گفت عمر حاش لله که خدا","بار اول قهر بارد در جزا","عمر گفت که هرگز نخواهم باور کرد که خدا برای بار اول در جزا (پاسخ به اعمال) قهر و کیفر برد و اینکه الان گرفتار شدی به این معنا است که سابقا هم این کار را کرده بودی."],[520,"بارها پوشد پی اظهار فضل","باز گیرد از پی اظهار عدل","خداوند بارها به خاطر نمایش رحمت و فضلش، بر صلاح و خوبی بندگانش می‌افزاید، اما اگر در مواقعی لازم باشد، عدالت را نیز آشکار می‌کند و از این رو، گاهی به تنبیه و مجازات می‌پردازد."],[520,"تا که این هر دو صفت ظاهر شود","آن مبشر گردد این منذر شود","خداوند می‌خواهد هر دو صفت خودش را نشان دهد هم عدالت و انصافش که منجر به انذار خواهد شد و هم دانش و فضیلتش که در برگیرنده‌ی بشارتش است."],[520,"بارها زن نیز این بد کرده بود","سهل بگذشت آن و سهلش می‌نمود","زن قبل از این نیز بارها چنین کارهایی کرده بود، ولی این موضوع برای او آسان به نظر می‌رسید و آن را بی‌اهمیت می‌پنداشت."],[520,"آن نمی‌دانست عقل پای‌سست","که سبو دایم ز جو ناید درست","او نمی‌دانست که عقلش ناتوان است و نمی‌تواند درستی را همیشه حفظ کند، زیرا مانند سبویی است که به‌طور مداوم از چشمه پر نمی‌شود."],[520,"آنچنانش تنگ آورد آن قضا","که منافق را کند مرگ فجا","سرنوشت به قدری او را در تنگنا قرار داد که باعث شد انسان نفاق‌کار به صورت ناگهانی و غیرمنتظره‌ای بمیرد."],[520,"نه طریق و نه رفیق و نه امان","دست کرده آن فرشته سوی جان","این بیت به حالت بی‌نظمی و تنهایی اشاره دارد. گویا فردی در شرایطی دشوار و ناامید کننده قرار دارد، بدون راهی برای پیش رفتن و یا دوستی که در کنار او باشد. فقط فرشته‌ی مرگ آن جا است که دست خودش را به سوی جان زن دراز کرده است. در کل، این بیانگر حس اضطراب و فقدان راه چاره است."],[520,"آنچنان کین زن در آن حجره جفا","خشک شد او و حریفش ز ابتلا","زن و هم‌نشینش به واسطه‌ی این مخمصه‌ای که درش بودند، هردو خشکشون زده بود."],[520,"گفت صوفی با دل خود کای دو گبر","از شما کینه کشم لیکن به صبر","صوفی به دل خود می‌گوید: ای دو کافر (گبر اشاره به کافران) که من از شما کینه دارم، اما این کینه را با صبر و تحمل کنترل می‌کنم."],[520,"لیک نادانسته آرم این نفس","تا که هر گوشی ننوشد این جرس","من الان آبروی شمارو نمی‌ریزم تا همه صدای این رسوایی را نشنوند."],[520,"از شما پنهان کشد کینه محق","اندک اندک هم‌چو بیماری دق","کینه‌ای که شخصی از شما پنهان می‌کند، به آرامی و به طور تدریجی در دل او رشد می‌کند، مانند یک بیماری (دق) که به آرامی فرد را می‌خورد."],[520,"مرد دق باشد چو یخ هر لحظه کم","لیک پندارد بهر دم بهترم","مردی که به بیماری دق مبتلا است، مانند یخ همیشه در حال آب شدن است و هر لحظه از او کم می‌شود، اما او فکر می‌کند که هر لحظه حالش بهتر می‌شود."],[520,"هم‌چو کفتاری که می‌گیرندش و او","غره آن گفت کین کفتار کو","وقتی شکارچیان قصد شکار کفتار را دارند و می‌دانند او کجاست برای سهولت امر شکار کمین می‌کنند و می‌گوید کفتار کجاست؟ و کفتار که به خود غره می‌شود و فکر می‌کند کسی اورا نمی‌بیند با خیال آسوده بیرون می‌رود و به دام شکارچیان می‌افتد."],[520,"هیچ پنهان‌خانه آن زن را نبود","سمج و دهلیز و ره بالا نبود","هیچ‌یک از مکان‌های پنهانی نتوانست آن زن را پنهان کند و نه جایی درون یا راهی برای فرار وجود داشت."],[520,"نه تنوری که در آن پنهان شود","نه جوالی که حجاب آن شود","نه تنوری در خانه بود که بشود در آن کفاش‌ را پنهان کرد و نه پرده‌ای که بشود اورا پشت آن پنهان کرد."],[520,"هم‌چو عرصه پهن روز رستخیز","نه گو و نه پشته نه جای گریز","در روز رستخیز که روز قیامت است، همه‌چیز بسیار واضح و آشکار خواهد بود و هیچ گوشه‌ی امنی برای پنهان شدن وجود ندارد، نه کوهی برای پناه بردن و نه مکانی برای فرار."],[520,"گفت یزدان وصف این جای حرج","بهر محشر لا تری فیها عوج","خداوند وصف این مکان را چنین بیان کرده است که در روز قیامت در آنجا هیچ ناهماهنگی و کجی وجود ندارد."],[521,"چادر خود را برو افکند زود","مرد را زن ساخت و در را بر گشود","زن چادر خود را به سر پسر کفاش انداخت تا وانمود کند که او نیز زن است."],[521,"زیر چادر مرد رسوا و عیان","سخت پیدا چون شتر بر نردبان","در حالی که مرد به علت داشتت هیکل مردانه، جنسیتش مشخص بود مانند شتری که بر روی نردبان است و قابلیت پنهان شدن ندارد."],[521,"گفت خاتونیست از اعیان شهر","مر ورا از مال و اقبالست بهر","زنی از افراد شناخته‌شده شهر می‌گوید که او از مال و خوشبختی بهره‌مند است."],[521,"در ببستم تا کسی بیگانه‌ای","در نیاید زود نادانانه‌ای","در را بستم تا کسی بیگانه وارد نشود، تا این فرد بزرک را ببیند."],[521,"گفت صوفی چیستش هین خدمتی","تا بر آرم بی‌سپاس و منتی","صوفی گفت: این کار (خدمت) چیست که من انجام دهم تا بدون دریافت پاداش و منت برآورم؟"],[521,"گفت میلش خویشی و پیوستگیست","نیک خاتونیست حق داند که کیست","زن گفت: این خانم برای خواستگاری دخترمان این‌جا است و میل به برقراری رابطه خویشاوندی با ما دارد و خدا می‌داند که چه زن خوبی هست ایشون."],[521,"خواست دختر را ببیند زیر دست","اتفاقا دختر اندر مکتبست","ایشون اومده بودند که دخترمان را ببیند، غافل از اینکه او در حال حاضر در مدرسه است."],[521,"باز گفت ار آرد باشد یا سبوس","می‌کنم او را به جان و دل عروس","این خانم اما می‌گوید من دختر را چه خوشگل و چه زشت باشد ندیده طلب می‌کنم برای پسرم."],[521,"یک پسر دارد که اندر شهر نیست","خوب و زیرک چابک و مکسب کنیست","او یک پسر دارد که در شهر زندگی نمی‌کند و این پسر انسان شایسته، با استعداد و زیرکی است که در کار و کسب خود موفق و چابک است."],[521,"گفت صوفی ما فقیر و زار و کم","قوم خاتون مال‌دار و محتشم","صوفی گفت وضعیت مالی ما قابل مقایسه با این خانم نیست چرا که ما فقیر و نیازمند هستیم اما ایشان ثروتمند و محتشم."],[521,"کی بود این کفو ایشان در زواج","یک در از چوب و دری دیگر ز عاج","کفو یا همتای یکدیگر در ازدواج چه کسی است؟ یکی در چوبی و دیگری در عاجی است که به نوعی اشاره به تفاوت‌های اجتماعی و اقتصادی دارد."],[521,"کفو باید هر دو جفت اندر نکاح","ورنه تنگ آید نماند ارتیاح","برای ازدواج، باید هر دو طرف هم‌تراز و هم‌کفو یکدیگر باشند، وگرنه در زندگی مشترک مشکلات و ناآرامی‌ها به وجود می‌آید."],[522,"گفت گفتم من چنین عذری و او","گفت نه من نیستم اسباب جو","زن می‌گوید که من بهانه‌ای برای عدم تمایل ندارم و او پاسخ می‌دهد که من به دنبال دلیل و توجیه نیستم."],[522,"ما ز مال و زر ملول و تخمه‌ایم","ما به حرص و جمع نه چون عامه‌ایم","ما از ثروت و طلا خسته شده‌ایم و نسب و اصل خود را فراموش کرده‌ایم. ما مانند مردم عادی به دنبال حرص و جمع‌آوری نیستیم."],[522,"قصد ما سترست و پاکی و صلاح","در دو عالم خود بدان باشد فلاح","هدف ما پوشاندن عیوب و رسیدن به پاکی و درستی است و در هر دو دنیا، فلاح و رستگاری به همان وابسته است."],[522,"باز صوفی عذر درویشی بگفت","و آن مکرر کرد تا نبود نهفت","صوفی دوباره از درویشی عذرخواهی کرد و آنچه را که قبلا گفته بود، تکرار کرد تا چیزی پنهان نماند."],[522,"گفت زن من هم مکرر کرده‌ام","بی‌جهازی را مقرر کرده‌ام","زن گفت که من هم چندین بار بر بی‌جهاز بودن تأکید کرده‌ام و این موضوع را به طور واضح مطرح کرده‌ام."],[522,"اعتقاد اوست راسختر ز کوه","که ز صد فقرش نمی‌آید شکوه","ایمان و اعتقاد او به اندازه‌ای محکم و استوار است که نمی‌توان آن را با هیچ چیز دیگری مقایسه کرد؛ حتی اگر او در فقر و تنگدستی به سر ببرد، هرگز از آن شکایت نمی‌کند."],[522,"او همی‌گوید مرادم عفتست","از شما مقصود صدق و همتست","او (شخصی که در این بیت صحبت می‌کند) می‌گوید که هدف من عفت و پاکدامنی است و از شما می‌خواهم که صداقت و جدیت را درک کنید."],[522,"گفت صوفی خود جهاز و مال ما","دید و می‌بیند هویدا و خفا","صوفی گفت که خود مال و دستگاه (جهاز) و ثروت ما را می‌بیند، هم‌چنان‌که در ظاهر و پنهان وجود دارد."],[522,"خانه تنگی مقام یک تنی","که درو پنهان نماند سوزنی","مقام یک فرد بسیار محدود و تنگ است و در این خانه حتی یک سوزن هم نمی‌تواند پنهان بماند. این به معنی آن است که حقیقت یا باطن انسان نمی‌تواند در پنهانی قرار گیرد و همیشه آشکار است."],[522,"باز ستر و پاکی و زهد و صلاح","او ز ما به داند اندر انتصاح","او (خداوند) از ما بی‌نیاز است و فقط در جریانپاکی، زهد و صلاح معنوی‌‌اش با ما آشناست."],[522,"به ز ما می‌داند او احوال ستر","وز پس و پیش و سر و دنبال ستر","او از ما بهتر می‌داند که حال ستردگی (پوشیدگی و پاکی) چیست و از جزئیات مختلف آن، چه در جلو و چه در پس، آگاه است."],[522,"ظاهرا او بی‌جهاز و خادمست","وز صلاح و ستر او خود عالمست","به ظاهر آن شخص بی‌پول و خدمتکار است، اما در واقع از نظر صلاح و مستوری دانشمند و عالم است."],[522,"شرح مستوری ز بابا شرط نیست","چون برو پیدا چو روز روشنیست","بی‌نیاز از توضیح و توجیه درباره پنهان‌کاری‌ها و پوشش‌ها نیست، چرا که وقتی حقیقت روشن شود، مانند روز روشن و واضح خواهد بود."],[522,"این حکایت را بدان گفتم که تا","لاف کم بافی چو رسوا شد خطا","این داستان را به تو گفتم تا بفهمی که وقتی کسی دروغ بگوید و رسوا شود، دیگر نمی‌تواند به ادعایش ادامه دهد و همچنان بر دروغ خود پافشاری کند."],[522,"مر ترا ای هم به دعوی مستزاد","این بدستت اجتهاد و اعتقاد","تو ای کسی که در ادعای خود به مقام والایی رسیده‌ای، این توانایی و ایمان به دست تو است که به حقیقت و دانش می‌رسد."],[522,"چون زن صوفی تو خاین بوده‌ای","دام مکر اندر دغا بگشوده‌ای","چون تو در مقام یک صوفی (عالم یا عارف) به زن خیانت کرده‌ای، دام فریب و نیرنگ را برای او گشوده‌ای."],[522,"که ز هر ناشسته رویی کپ زنی","شرم داری وز خدای خویش نی","تو از هر چهره‌ی ناپاکی شرم‌زده‌ای و بر خودت خجالت می‌کشی، اما از خداوند خودت شرم نداری و به او بی‌اعتنایی می‌کنی."],[523,"از پی آن گفت حق خود را بصیر","که بود دید ویت هر دم نذیر","خداوند به عنوان «بصیر» یعنی بینا معرفی می‌شود، زیرا او همیشه و در هر لحظه می‌بیند و بر وضعیت‌ها واقف است."],[523,"از پی آن گفت حق خود را سمیع","تا ببندی لب ز گفتار شنیع","خداوند به خاطر این‌که شنونده‌ای تواناست، این ویژگی‌اش را بیان می‌کند تا تو از گفتن حرف‌های زشت خودداری کنی و زبانت را ببندی."],[523,"از پی آن گفت حق خود را علیم","تا نیندیشی فسادی تو ز بیم","خداوند می‌گوید که او عالم است تا تو به خاطر ترس از فساد و نادرستی، دیگر به چیزهای نامناسب فکر نکنی."],[523,"نیست اینها بر خدا اسم علم","که سیه کافور دارد نام هم","این صفات مثل «علم» برای خداوند، تنها نام‌هایی هستند و به خودی خود بیانگر حقیقی بودن این ویژگی‌ها نیستند، درست مانند کافور که رنگ سیاه دارد و نمی‌تواند به عنوان یک نام به خداوند نسبت داده شود."],[523,"اسم مشتقست و اوصاف قدیم","نه مثال علت اولی سقیم","اسم خداوند، وصف و نامی است که از آن مشتق شده، در حالی که اوصاف الهی قدیمی و ازلی هستند و به هیچ چیز دیگر شبیه نیستند، نه مثل علل اولی که ضعیف و ناقص هستند."],[523,"ورنه تسخر باشد و طنز و دها","کر را سامع ضریران را ضیا","اگر خداوند فقط به نام‌های سمیع (شنوا) و بصیر (بینا) خوانده شود، این به منزله تمسخر و شوخی با حقیقت است، زیرا در این صورت، قدرت و علم او به ضعیفان و نابیناها که در تاریکی هستند، نمی‌تواند نور و روشنی دهد."],[523,"یا علم باشد حیی نام وقیح","یا سیاه زشت را نام صبیح","علم ممکن است به نامی زیبا و زنده اشاره کند، در حالی که ممکن است نازیبا و زشت را به نامی خوشایند و مناسب بخوانند. در واقع، نام‌ها می‌توانند بر اساس ظاهر یا ویژگی‌های واقعی و نادرست انتخاب شوند."],[523,"طفلک نوزاده را حاجی لقب","یا لقب غازی نهی بهر نسب","لقب‌هایی مانند حاجی یا غازی که به یک نوزاد داده می‌شود، به خاطر نسب و خانواده‌اش است و در واقع به خود او ارتباطی ندارد."],[523,"گر بگویند این لقبها در مدیح","تا ندارد آن صفت نبود صحیح","اگر بگویند این نام‌ها در ستایش خداوند بی‌معناست، پس اگر آن صفات حقیقتا موجود نباشد، درست نیست."],[523,"تسخر و طنزی بود آن یا جنون","پاک حق عما یقول الظالمون","این شعر به اتهاماتی که به خداوند زده می‌شود، اشاره دارد. بیانگر این است که ممکن است برخی افراد به توهین یا تمسخر در مورد خداوند بپردازند و او را به جنون متهم کنند، در حالی که حقیقت خداوند فراتر از این تصورات نادرست است."],[523,"من همی دانستمت پیش از وصال","که نکورویی ولیکن بدخصال","من قبل از اینکه با تو دیدار کنم، می‌دانستم که تو زیبارویی، اما اخلاق نیکویی نداری."],[523,"من همی دانستمت پیش از لقا","کز ستیزه راسخی اندر شقا","من قبل از ملاقات و وصالت، می‌دانستم که تو در مشکل و سختی به سر می‌بری و در جدال هستی."],[523,"چونک چشمم سرخ باشد در عمش","دانمش زان درد گر کم بینمش","وقتی که چشمانم در خواب بی‌نهایت قرمز باشد، می‌فهمم که از آن درد اگر او را کمتر ببینم."],[523,"تو مرا چون بره دیدی بی شبان","تو گمان بردی ندارم پاسبان","تو وقتی مرا مثل یک بره بی‌پدر و شبان دیدی، فکر کردی که من نگهبان و محافظی ندارم."],[523,"عاشقان از درد زان نالیده‌اند","که نظر ناجایگه مالیده‌اند","عاشقان به خاطر درد و رنجی که کشیده‌اند ناله کرده‌اند، زیرا که خدا در لحظات ناگهانی به آن‌ها نظر کرده است و این توجه باعث شده تا آن‌ها درد و رنج بیشتری را احساس کنند."],[523,"بی‌شبان دانسته‌اند آن ظبی را","رایگان دانسته‌اند آن سبی را","عشاق آگاه شده‌اند که آن فراوانی و نعمت‌های الهی به‌راحتی بدون هیچ هزینه‌ای در دسترس است."],[523,"تا ز غمزه تیر آمد بر جگر","که منم حارس گزافه کم نگر","غمزه‌ای که بر دل من تیر می‌زند، نشان می‌دهد که من نگهبان بی‌دلی و بی‌احتیاطی نیستم."],[523,"کی کم از بره کم از بزغاله‌ام","که نباشد حارس از دنباله‌ام","من، چون بره یا بزغاله‌ای کوچک هستم، که اگر حارسی در پی من نباشد، به سادگی آسیب می‌بینم و به خطر می‌افتم."],[523,"حارسی دارم که ملکش می‌سزد","داند او بادی که آن بر من وزد","من همواره نگهبانی دارم که شایسته مقام اوست و او می‌داند بادی که به من می‌وزد، چه تاثیراتی دارد."],[523,"سرد بود آن باد یا گرم آن علیم","نیست غافل نیست غایب ای سقیم","سرد یا گرم بودن آن باد (نفس) برای خداوند عالم (علیم) اهمیتی ندارد، زیرا او غافل و غایب نیست، حتی اگر تو به عنوان بیمار (سقیم) احساس کنی که او دور است."],[523,"نفس شهوانی ز حق کرست و کور","من به دل کوریت می‌دیدم ز دور","نفس شهوانی انسان از درک حقیقت ناتوان و نابینا است؛ من به دلیل دل کور تو، عواقب این ناتوانی را از فاصله‌ها می‌دیدم."],[523,"هشت سالت زان نپرسیدم به هیچ","که پرت دیدم ز جهل پیچ پیچ","من به مدت هشت سال درباره تو نپرسیدم و سراغ نگرفتم چون در جهل و نادانی خودم اسیر بودم و نمی‌توانستم واقعیت تو را درک کنم."],[523,"خود چه پرسم آنک او باشد بتون","که تو چونی چون بود او سرنگون","من چه چیزی از خود بپرسم وقتی او وجود دارد، زیرا تو چه هستی و حال تو چگونه است، او را تحت تأثیر قرار می‌دهد."],[524,"شهوت دنیا مثال گلخنست","که ازو حمام تقوی روشنست","شهوت و لذات دنیوی مشابه به گلخن (مکان گرم و کثیف) هستند، در حالی که تقوی و پرهیزگاری مانند یک حمام پاک و تمیز می‌باشد که انسان را از آلودگی‌ها دور می‌کند."],[524,"لیک قسم متقی زین تون صفاست","زانک در گرمابه است و در نقاست","ولی قسم می‌خورم که متقی از این تون (محیط آلوده و پست) پاک و دور است، زیرا او در گرمابه (محل پاکی و صفا) و در نقاوت (پاکی و زلالی) به سر می‌برد."],[524,"اغنیا ماننده سرگین‌کشان","بهر آتش کردن گرمابه‌بان","ثروتمندان مانند کسانی هستند که سرگین (فضولات) را جمع می‌کنند تا به آتش گرمابه‌بان (کسی که در گرمابه کار می‌کند) اضافه کنند. یعنی آنها با ناپاکی‌های خود به دنبال گرم کردن و رونق دادن به گرمابه هستند."],[524,"اندریشان حرص بنهاده خدا","تا بود گرمابه گرم و با نوا","حرص و طمع افراد ثروتمند در دنیا به قدری است که خداوند به آن‌ها اجازه داده تا در زندگی خود مانند یک گرمابه، داغ و پرجنب‌وجوش باشند."],[524,"ترک این تون گوی و در گرمابه ران","ترک تون را عین آن گرمابه دان","مولانا به ما می‌گوید که از این دنیای پرزرق و برق و فریبنده (تون) بگذر و به دنیای معنوی (گرمابه) توجه کن. ترک دنیا را به‌گونه‌ای ببین که همانند رفتن به گرمابه، به معنای جستجوی آرامش و شفا باشد."],[524,"هر که در تونست او چون خادمست","مر ورا که صابرست و حازمست","هر کس که در گودال و تون به کار مشغول است، مانند خادمی است که کارش را انجام می‌دهد و او که صبر و حزم دارد، ارزش بیشتری دارد."],[524,"هر که در حمام شد سیمای او","هست پیدا بر رخ زیبای او","هر کس که در حمام برود، چهره‌اش به وضوح بر چهره‌ی زیبا و دلنشینش نمایان می‌شود."],[524,"تونیان را نیز سیما آشکار","از لباس و از دخان و از غبار","چهره تونیان، که اشاره به انسان‌هایی مانند تو دارد، از لباس و بخار و گرد و غبار پنهان نمی‌شود، و این نشان‌دهنده نمود بیرونی آن‌هاست."],[524,"ور نبینی روش بویش را بگیر","بو عصا آمد برای هر ضریر","اگر نتوانی روش و حالت او را ببینی، فقط بوی او را بگیر؛ زیرا بوی او مانند عصا برای هر نابینا (که نمی‌تواند ببیند) می‌آید."],[524,"ور نداری بو در آرش در سخن","از حدیث نو بدان راز کهن","اگر سخنان نو را نمی‌فهمی و از معانی آن‌ها بویی نمی‌گیری، به این راز کهن دقت کن."],[524,"پس بگوید تونیی صاحب ذهب","بیست سله چرک بردم تا به شب","او می‌گوید تو که صاحب طلا هستی، من بیست سکه از تو را غارت کردم تا شب فرا برسد."],[524,"حرص تو چون آتشست اندر جهان","باز کرده هر زبانه صد دهان","حرص انسان مانند آتش است که در دنیا وجود دارد و به هر طرف شعله‌ور می‌شود و هرگونه خواسته و تمایل را به خود می‌کشد."],[524,"پیش عقل این زر چو سرگین ناخوشست","گرچه چون سرگین فروغ آتشست","در نظر عقل، طلا و زر به مانند مدفوع (سرگین) ناپسند و بی‌ارزش است، هرچند که طلا همچون سرگین با نور آتش (حرص و طمع) می‌درخشد و توجه را جلب می‌کند."],[524,"آفتابی که دم از آتش زند","چرک تر را لایق آتش کند","آفتابی که به آتش اشاره می‌کند، می‌تواند چیزهای کثیف و چرکین را به حالت پاکیزه و شایسته آتش درآورد."],[524,"آفتاب آن سنگ را هم کرد زر","تا بتون حرص افتد صد شرر","آفتاب می‌تواند سنگ را به طلا تبدیل کند، اما حرص و طمع انسان باعث ایجاد مشکلات و گرفتاری‌های زیادی می‌شود."],[524,"آنک گوید مال گرد آورده‌ام","چیست یعنی چرک چندین برده‌ام","کسی که می‌گوید من اموال زیادی جمع کرده‌ام، در حقیقت چه چیزهایی به دست آورده که تنها زباله و چرک گردآوری کرده است."],[524,"این سخن گرچه که رسوایی‌فزاست","در میان تونیان زین فخرهاست","این سخن، هرچند که باعث رسوایی بیشتر می‌شود، در نزد افراد فخرکننده، نوعی افتخار به‌شمار می‌آید."],[524,"که تو شش سله کشیدی تا به شب","من کشیدم بیست سله بی کرب","تو دو بار effort و زحمت کشیدی تا شب را به پایان برسانی، ولی من بیست بار بیشتر از تو زحمت کشیدم و این کار برای من سخت و پرمشقت‌تر از تو بود."],[524,"آنک در تون زاد و پاکی را ندید","بوی مشک آرد برو رنجی پدید","اگر در معدن (تون) که محل زحمت و سختی است، بوی خوش و پاکی مانند بوی مشک را نبینی، این باعث ایجاد رنج و ناراحتی خواهد شد."],[525,"آن یکی افتاد بیهوش و خمید","چونک در بازار عطاران رسید","او (دباغ) هنگامی که به بازار عطاران رسید، به‌قدری از بوی عطر و مشک مست و بیهوش شد که بر زمین افتاد و خمیده گردید."],[525,"بوی عطرش زد ز عطاران راد","تا بگردیدش سر و بر جا فتاد","بوی عطر عطاران به او چنان أثر گذاشت که به شدت غش کرد و بی‌خبر بر زمین افتاد."],[525,"هم‌چو مردار اوفتاد او بی‌خبر","نیم روز اندر میان ره‌گذر","او مانند یک مردار بی‌خبر بر زمین افتاده است، در حالی که در نیم روز، در میان راه گذرکنندگان قرار دارد."],[525,"جمع آمد خلق بر وی آن زمان","جملگان لاحول‌گو درمان کنان","مردم آنجا جمع شدند و دور او را گرفتند و با حالتی سرزنش‌آمیز گفتند که هیچ چیزی نمی‌توانند برای او انجام دهند و در عین حال درخواست درمان او را دارند."],[525,"آن یکی کف بر دل او می براند","وز گلاب آن دیگری بر وی فشاند","یکی از افراد به آرامی بر دل دباغ می‌کوبید و او را دلداری می‌داد، و فرد دیگری هم بر او گلاب می‌پاشید."],[525,"او نمی‌دانست کاندر مرتعه","از گلاب آمد ورا آن واقعه","او نمی‌دانست که در باغ (مرتعه) چه اتفاقی افتاده و چرا از عطر گل (گلاب) به او آن حالت دست داده است."],[525,"آن یکی دستش همی‌مالید و سر","وآن دگر کهگل همی آورد تر","یکی شروع کرد دست و سر او را مالید تا حالش را بهتر کند، یکی دیگه هم مقداری کاه‌گل خشک نشده آورد برای دفع تب"],[525,"آن بخور عود و شکر زد به هم","وآن دگر از پوششش می‌کرد کم","بخور عود و شکر را با هم ترکیب کرد و دیگری کمتر از پوشش خود را می‌پوشاند."],[525,"وآن دگر نبضش که تا چون می‌جهد","وان دگر بوی از دهانش می‌ستد","نبض او به شدت می‌زند و عطر خوشی از دهانش منتشر می‌شود."],[525,"تا که می خوردست و یا بنگ و حشیش","خلق درماندند اندر بیهشیش","در حالی که او (شخص مورد نظر) در حال نوشیدن بوده و یا از بنگ (ماده مخدر) و حشیش استفاده می‌کرده است، مردم به شدت درمانده و ناتوان شده‌اند و در این حالت بی‌هوشی او گرفتار شده‌اند."],[525,"پس خبر بردند خویشان را شتاب","که فلان افتاده است آن‌جا خراب","خویشاوندان او را با عجله خبر کردند که فلانی در آن‌جا به حال خراب و بی‌هوش افتاده است."],[525,"کس نمی‌داند که چون مصروع گشت","یا چه شد کور افتاد از بام طشت","هیچ‌کس نمی‌داند که در چه حالی او (آن دباغ) به زمین افتاد یا چرا به طور ناگهانی از بالای بام روی طشت (سینی بزرگ) افتاده است."],[525,"یک برادر داشت آن دباغ زفت","گربز و دانا بیامد زود تفت","دباغ زفت (دیباج‌دوز) یک برادر داشت که مغرور و باهوش بود و به سرعت آمد."],[525,"اندکی سرگین سگ در آستین","خلق را بشکافت و آمد با حنین","اندکی از فضولات سگ در آستین مردم را شکافت و به همراه ناله‌ای (حنین) بیرون آمد."],[525,"گفت من رنجش همی دانم ز چیست","چون سبب دانی دوا کردن جلیست","گفت: من می‌دانم که رنج و ناراحتی‌ام از چه چیزی است. وقتی که علت را بفهمی، درمان آن آسان خواهد بود."],[525,"چون سبب معلوم نبود مشکلست","داروی رنج و در آن صد محملست","تا زمانی که علت رنج مشخص نباشد، درمان آن دشوار است و در این حالت، راه‌حل‌های زیادی وجود دارد که هر یک می‌تواند به نحوی مشکل را حل کند."],[525,"چون بدانستی سبب را سهل شد","دانش اسباب دفع جهل شد","وقتی که تو به دانستن علت چیزی نائل شدی، فهمیدن و دانستن آن آسان می‌شود و عوامل جلوگیری از نادانی برطرف می‌گردد."],[525,"گفت با خود هستش اندر مغز و رگ","توی بر تو بوی آن سرگین سگ","او با خود می‌گوید که در درون مغز و رگ او، بوی سرگین سگ وجود دارد."],[525,"تا میان اندر حدث او تا به شب","غرق دباغیست او روزی‌طلب","نفس دباغ، که مشغول به کار است، با بوی بدم، او را از پای درآورده؛ و روزها در پی تامین معاش خود است، در حالی که شب‌ها به کار دباغی می‌پردازد."],[525,"پس چنین گفته‌ست جالینوس مه","آنچ عادت داشت بیمار آنش ده","جالینوس، پزشک مشهور باستان، گفته است که برای بهبود حال بیمار، باید همان چیزی را به او داد که عادت دارد."],[525,"کز خلاف عادتست آن رنج او","پس دوای رنجش از معتاد جو","رنج این فرد برخلاف عادتش است، بنابراین باید داروی رنجش را از چیزی که به آن عادت دارد، جستجو کند."],[525,"چون جعل گشتست از سرگین‌کشی","از گلاب آید جعل را بیهشی","وقتی که سرگین (مدفوع) را در می‌آورند تا گلاب (عطر) درست شود، در این فرآیند، بی‌هوشی و عدم آگاهی حاصل می‌شود."],[525,"هم از آن سرگین سگ داروی اوست","که بدان او را همی معتاد و خوست","داروی آن سگ، همان سرگین است که او به آن عادت کرده و به آن خو گرفته است."],[525,"الخبیثات الخبیثین را بخوان","رو و پشت این سخن را باز دان","این بیت به این معناست که سخن از «خبیثات» به «خبیثین» (اشخاص بد) اشاره دارد؛ یعنی بدی‌ها و زشتی‌ها به بدکاران و افراد ناپاک بازمی‌گردند. در واقع، این جمله به پتک خوبی‌ها برای جستجوی حقیقت در معنای ناپسند می‌پردازد، و به نوعی تأکید دارد که اشیاء ناپاک در پیوند با ناپاکی انسان‌ها هستند."],[525,"ناصحان او را به عنبر یا گلاب","می دوا سازند بهر فتح باب","ناصحان (پنددهندگان) او را با خوشبویی‌هایی مانند عنبر یا گلاب معالجه می‌کنند تا دروازه‌ای به روی او باز کنند."],[525,"مر خبیثان را نسازد طیبات","درخور و لایق نباشد ای ثقات","مردان ناپاک و بدذات را نمی‌توان با چیزهای پاک و نیکو، شایسته و لایق کرد."],[525,"چون ز عطر وحی کر گشتند و گم","بد فغانشان که تطیرنا بکم","چون از بوی عطر وحی بی‌خبر و گم گشتند، فریادشان برآمد که ما از این عطر پاک و خوشبو به دور افتاده‌ایم."],[525,"رنج و بیماریست ما را این مقال","نیست نیکو وعظتان ما را به فال","رنج و بیماری ما به خاطر این صحبت‌ها نیست و نصیحت‌های نیک شما برای ما خوشایند نیست."],[525,"گر بیاغازید نصحی آشکار","ما کنیم آن دم شما را سنگسار","اگر نصیحتی صریح و واضح آغاز کنید، ما در آن لحظه شما را مورد توبیخ و انتقاد قرار خواهیم داد."],[525,"ما بلغو و لهو فربه گشته‌ایم","در نصیحت خویش را نسرشته‌ایم","ما به خاطر سرگرمی و بازی‌های بیهوده بزرگ و چاق شده‌ایم و در نصیحت به خودمان توجهی نکرده‌ایم."],[525,"هست قوت ما دروغ و لاف و لاغ","شورش معده‌ست ما را زین بلاغ","نیروی ما دروغ و تظاهر است و آشفتگی درون ما نتیجه این سخنان پر زرق و برق است."],[525,"رنج را صدتو و افزون می‌کنید","عقل را دارو به افیون می‌کنید","شما با سختی و رنج زیاد، این مشکلات را دوچندان می‌کنید، در حالی که با استفاده از عقل و حکمت می‌توان بر این مشکلات غلبه کرد."],[526,"خلق را می‌راند از وی آن جوان","تا علاجش را نبینند آن کسان","آن جوان باعث می‌شود مردم از او دور شوند تا اینکه درمانش را آن افراد نبینند."],[526,"سر به گوشش برد هم‌چون رازگو","پس نهاد آن چیز بر بینی او","او سرش را به گوش جوان دباغ می‌برد و مانند کسی که راز می‌گوید، آن چیز را بر بینی او می‌گذارد."],[526,"کو به کف سرگین سگ ساییده بود","داروی مغز پلید آن دیده بود","در این بیت، مولانا به دارویی اشاره می‌کند که از سرگین (مدفوع) سگ تهیه شده است. او می‌گوید دارویی که برای بهبود حال کسی استفاده می‌شود، از چیزی به ظاهر کثیف و پلید ساخته شده و نشان‌دهنده‌ی این است که گاهی اوقات چیزهای ناپسند می‌توانند برای درمان و بهبود موثر باشند."],[526,"ساعتی شد مرد جنبیدن گرفت","خلق گفتند این فسونی بد شگفت","مدتی گذشت و مرد جانی دوباره پیدا کرد و شروع به تکان خوردن کرد. مردم گفتند این یک جادو یا افسون عجیب و غریب است."],[526,"کین بخواند افسون به گوش او دمید","مرده بود افسون به فریادش رسید","او (مرد) به وسیله افسون یا جادو که در گوشش خوانده شد، دوباره زنده شد و به زندگی بازگشت. صدای افسون، او را از حالت مرده‌گی درآورد و به خاطر آن فریاد زد."],[526,"جنبش اهل فساد آن سو بود","که زنا و غمزه و ابرو بود","آدم‌های فاسد و گنهکار در سمت دیگر مشغول زنا و عشق‌بازی و جلوه‌گری هستند."],[526,"هر کرا مشک نصیحت سود نیست","لاجرم با بوی بد خو کرد نیست","هر کسی که نصیحت و پند برای او سودمند نباشد، در نتیجه با بوی بد و ناپسند خو می‌گیرد و عادت می‌کند."],[526,"مشرکان را زان نجس خواندست حق","کاندرون پشک زادند از سبق","خداوند مشرکان را به خاطر نجاست درونی‌شان مورد سرزنش قرار داده است، زیرا آنها از نادانی و گمراهی به دنیا آمده‌اند، همان‌طور که حشرات از فضولات زاده می‌شوند."],[526,"کرم کو زادست در سرگین ابد","می‌نگرداند به عنبر خوی خود","کرم (نوعی کرم که در خاک و سرگین زندگی می‌کند) که از فضولات گاو به وجود می‌آید، در ابدیت خود به زینت و خوشبویی (یعنی عنبر) خود نگاه می‌کند و آن را به نمایش می‌گذارد."],[526,"چون نزد بر وی نثار رش نور","او همه جسمست بی‌دل چون قشور","وقتی که نور او (نور حق) به بر او نثار می‌شود، همه بدن او بی‌روح و خالی از دل می‌ماند، مانند قشور، که فقط پوسته‌ای است بدون محتوا."],[526,"ور ز رش نور حق قسمیش داد","هم‌چو رسم مصر سرگین مرغ‌زاد","اگر کسی از نور حق قسم بخورد، مانند رسم مصر که سرگین مرغ را به آن می‌زنند، در حقیقت به شکل ظاهری و سطحی او دچار می‌شود."],[526,"لیک نه مرغ خسیس خانگی","بلک مرغ دانش و فرزانگی","اما این‌جا صحبت از مرغی است که خسیس نیست و به نوعی نادان و بی‌فایده به شمار نمی‌آید؛ بلکه این مرغ به علم و فرزانگی مرتبط است و نیازی به دل‌نگرانی ندارد."],[526,"تو بدان مانی کز آن نوری تهی","زآنک بینی بر پلیدی می‌نهی","تو باید بدانی که اگر از آن نور (دانش و خرد) خالی شوی، به خاطر آن است که پلیدی‌ها را نمی‌بینی و درک نمی‌کنی."],[526,"از فراقت زرد شد رخسار و رو","برگ زردی میوه ناپخته تو","به خاطر دوری تو، چهره‌ام زرد و پژمرده شده و برگ‌های میوه‌ای که هنوز نرسیده است، زرد گشته‌اند."],[526,"دیگ ز آتش شد سیاه و دودفام","گوشت از سختی چنین ماندست خام","دیگ به خاطر حرارت آتش سیاه و پر از دود شده است و نشان می‌دهد که گوشت به خاطر سختی این شرایط همچنان خام و نپخته مانده است. این تصویر به حالتی اشاره دارد که در آن انتظار و فراق موجب نمی‌شود که فرد به بلوغ و پختگی برسد."],[526,"هشت سالت جوش دادم در فراق","کم نشد یک ذره خامیت و نفاق","من هشت سال تو را در فراق و دوری مورد آزمایش و جستجو قرار دادم، اما نتیجه‌ای نگرفتم و همچنان در تو خامی و نفاق وجود دارد."],[526,"غوره تو سنگ بسته کز سقام","غوره‌ها اکنون مویزند و تو خام","غوره تو (غوره به معنی انگور نرسیده) به علت بیماری و درد، سخت و سنگی شده است، در حالی که اکنون غوره‌ها (انگورهای نرسیده) در حال پندار و رشد هستند و تو هنوز نا­پخته و خام باقی مانده‌ای."],[527,"گفت عاشق امتحان کردم مگیر","تا ببینم تو حریفی یا ستیر","عاشق می‌گوید که من از تو امتحان گرفته‌ام، اما این امتحان را نپذیر، زیرا می‌خواهم بدانم آیا تو با من هم‌پایه و هم‌تراز هستی یا خیر."],[527,"من همی دانستمت بی‌امتحان","لیک کی باشد خبر هم‌چون عیان","من از قبل می‌دانستم تو چه ویژگی‌هایی داری و به اندازه امتحان نیاز به آزمایش نبود. اما آیا می‌شود اطلاعاتی مانند آگاهی عینی و واقعی به دست آورد؟"],[527,"آفتابی نام تو مشهور و فاش","چه زیانست ار بکردم ابتلاش","نام تو همچون خورشید معروف و شناخته است، پس چه ایرادی دارد اگر به خاطر تو دچار آزمایش و سختی شوم؟"],[527,"تو منی من خویشتن را امتحان","می‌کنم هر روز در سود و زیان","من در هر روز خودم را در آزمون می‌گذارم تا ببینم چه چیز برای من سودمند است و چه چیز زیان‌آور."],[527,"انبیا را امتحان کرده عدات","تا شده ظاهر ازیشان معجزات","انبیاء (پیامبران) را با آزمایش‌هایی از سوی خداوند مورد آزمون قرار داده‌اند، تا نشانه‌های معجزه‌آسا و صفات ویژه ایشان در اثر این آزمایش‌ها آشکار شود."],[527,"امتحان چشم خود کردم به نور","ای که چشم بد ز چشمان تو دور","چشم خود را با نور الهی و الهام از خداوند آزمایش کرده‌ام،‌ ای کسی که نگاه بد از چشمان تو دور است."],[527,"این جهان هم‌چون خرابست و تو گنج","گر تفحص کردم از گنجت مرنج","این جهان مانند یک ویرانه است، ولی تو درون آن گنجینه‌ای هستی. اگر من در جستجوی گنج تو برآیم، تو ناراحت نشو."],[527,"زان چنین بی‌خردگی کردم گزاف","تا زنم با دشمنان هر بار لاف","به خاطر نادانی و بی‌خردی‌ام کارهای بیهوده‌ای انجام دادم و هر بار سعی می‌کنم در برابر دشمنانم بزرگ‌نمایی کنم و خودم را به آنها نشان دهم."],[527,"تا زبانم چون ترا نامی نهد","چشم ازین دیده گواهیها دهد","وقتی زبانم مانند تو چیزی بگوید، چشم‌هایم از این دیده، شهادت‌هایی را آشکار می‌کنند."],[527,"گر شدم در راه حرمت راه‌زن","آمدم ای مه به شمشیر و کفن","اگر در مسیر عشق تو دچار گناه یا خطا شدم، ای مهر (که به عنوان معشوق خطاب شده‌ای)، به خاطر حرمت و ارادت به تو به شکل یک راهزن در آمده‌ام، با شمشیر و کفن، که نشان‌دهنده خطر و جدیت در این مسیر است."],[527,"جز به دست خود مبرم پا و سر","که ازین دستم نه از دست دگر","تنها با دست خودم می‌توانم پا و سرم را حرکت دهم و از این دستان خودم است که قدرت دارم، نه از دستان دیگری."],[527,"از جدایی باز می‌رانی سخن","هر چه خواهی کن ولیکن این مکن","تو هر نوع سخنی که بخواهی بگو، اما به یاد داشته باش که من را از جدایی باز نخواهی گرداند."],[527,"در سخن آباد این دم راه شد","گفت امکان نیست چون بیگاه شد","در این بیت، شاعر می‌گوید که در شرایط و اوضاع فعلی، سخن گفتن یا عمل کردن دشوار شده و ممکن نیست، زیرا زمان مناسب این کار سپری شده است."],[527,"پوستها گفتیم و مغز آمد دفین","گر بمانیم این نماند همچنین","ما درباره ظاهر و شکل‌ها صحبت کردیم، اما حقیقت و معنای عمیق آن‌ها همواره پنهان است. اگر در این دنیا بمانیم، این حقیقت باقی نخواهد ماند."],[528,"در جوابش بر گشاد آن یار لب","کز سوی ما روز سوی تست شب","در پاسخ به او، لب آن معشوق را باز کردم، که از طرف ما روز است و از طرف تو شب."],[528,"حیله‌های تیره اندر داوری","پیش بینایان چرا می‌آوری","چرا در قضاوت و داوری، ترفندهای ناپاک و تیره را برای بینایان به کار می‌گیری؟"],[528,"هر چه در دل داری از مکر و رموز","پیش ما رسواست و پیدا هم‌چو روز","هر چیزی که در دل داری، از فریب و رازهایت در برابر ما روشن و نمایان است، مانند روشنایی روز."],[528,"گر بپوشیمش ز بنده‌پروری","تو چرا بی‌رویی از حد می‌بری","اگر ما از رفتار محبت‌آمیز تو چیزی را بپوشانیم، چرا تو بی‌رویی و از حد خود فراتر می‌روی؟"],[528,"از پدر آموز که آدم در گناه","خوش فرود آمد به سوی پایگاه","از پدر بیاموز که آدم (انسان) با گناه به سوی مقام و جایگاه خود سقوط کرده است."],[528,"چون بدید آن عالم الاسرار را","بر دو پا استاد استغفار را","وقتی آن عالم اسرار را دید که بر دو پایش ایستاده و به درگاه خدا طلب مغفرت می‌کند،۔"],[528,"بر سر خاکستر انده نشست","از بهانه شاخ تا شاخی نجست","به معنای غم و اندوه می‌رسد که در دلش نشسته است و از هیچ بهانه‌ای برای فرار از این غم به وجود نمی‌آورد. به عبارت دیگر، خود را در اندوه غم به حال سکون و سکوت رها کرده و بهانه‌ای برای رهایی از آن ندارد."],[528,"ربنا انا ظلمنا گفت و بس","چونک جانداران بدید از پیش و پس","عاشق فقط با گفتن \"پروردگارا، ما ظلم کردیم\" به عذرخواهی اکتفا کرد، چرا که جانداران را از جلو و عقب مشاهده کرد و متوجه شد که هر کدام در نظر خود، خطاهایی دارند."],[528,"دید جانداران پنهان هم‌چو جان","دورباش هر یکی تا آسمان","جانداران پنهان را نیز مانند جان دورباش را دیده‌اند، هر کدام تا آسمان به دور هستند."],[528,"که هلا پیش سلیمان مور باش","تا بنشکافد ترا این دورباش","بهتر است که مانند موری در پیش سلیمان (حاکمی حکیم) باشی تا او بتواند تو را از این دوری و غفلت رها کند."],[528,"جز مقام راستی یک دم مه‌ایست","هیچ لالا مرد را چون چشم نیست","هیچ چیز جز مقام حقیقت و راستی ارزشمند نیست، زیرا زیبایی و شوق، مانند نور ماه است که فقط برای یک لحظه نمایان می‌شود و مرد را از درک حقیقت باز می‌دارد، همان‌طور که چشمی که نمی‌بیند نمی‌تواند به زیبایی‌ها دست یابد."],[528,"کور اگر از پند پالوده شود","هر دمی او باز آلوده شود","اگر انسان از پند و نصیحت بهره‌مند شود، هر لحظه دوباره به گناه و آلودگی بازمی‌گردد."],[528,"آدما تو نیستی کور از نظر","لیک اذا جاء القضا عمی البصر","انسان‌ها از نظر و دیدگاه خود کور نیستند، اما وقتی قضا و تقدیر بر آن‌ها وارد می‌شود، به‌طرزی نادیده دچار نابینایی می‌شوند."],[528,"عمرها باید به نادر گاه‌گاه","تا که بینا از قضا افتد به چاه","انسان‌ها معمولا اشتباه می‌کنند و به خاطر عیوب خود را نادیده می‌گیرند، ولی گاهی اوقات در طول عمر، فردی آگاه و بینا به طور ناگهانی دچار مشکلات و سقوط می‌شود."],[528,"کور را خود این قضا همراه اوست","که مرورا اوفتادن طبع و خوست","کور، به معنای در اینجا اشاره به فرد نادان یا بی‌خبر دارد، خود به همراهی قضا و تقدیر در زندگی‌اش است، یعنی او به خاطر ناشنیدگی و آگاهی نداشتن، دچار افت و شکست می‌شود. در واقع، او به خاطر طبع و خوی نا مناسبش به این سرنوشت دچار شده است."],[528,"در حدث افتد نداند بوی چیست","از منست این بوی یا ز آلودگیست","وقتی در حادثه‌ای بیفتد، نمی‌داند که این بوی خوشی که می‌شنود از من است یا به خاطر آلودگی است."],[528,"ور کسی بر وی کند مشکی نثار","هم ز خود داند نه از احسان یار","اگر کسی بر او عطر مشکی بریزد، او می‌داند که این بوی خوش به خاطر محبت یار نیست، بلکه از خود اوست."],[528,"پس دو چشم روشن ای صاحب‌نظر","مر ترا صد مادرست و صد پدر","چشم‌های روشنت، ای صاحب نظر، برای تو به اندازه صد مادر و صد پدر اهمیت دارند و به نوعی نشان‌دهنده‌ی محبت و شناخت عمیق‌اند."],[528,"خاصه چشم دل آن هفتاد توست","وین دو چشم حس خوشه‌چین اوست","چشم دل که یکی از جلوه‌های باطن و معنوی انسان است، متعلق به هفتاد خصلت یا ویژگی خوب است، در حالی که این دو چشم ظاهری که حس را تجربه می‌کنند، تنها به خوشی‌های دنیوی و مادی مشغولند."],[528,"ای دریغا ره‌زنان بنشسته‌اند","صد گره زیر زبانم بسته‌اند","ای کاش، دزدان راه (غافل‌ها) نشسته‌اند و صد مشکل و گره بر زبان من بسته‌اند."],[528,"پای‌بسته چون رود خوش راهوار","بس گران بندیست این معذور دار","کسی که پای‌بسته است، چگونه می‌تواند خوش و روان حرکت کند؟ این بند سنگین است، پس مرا معذور بدار"],[528,"این سخن اشکسته می‌آید دلا","کین سخن درّست غیرت آسیا","این سخن به نظر ناپخته و ضعیف می‌رسد، ای دل، زیرا واقعیت‌ها و حقایق باید با جوانمردی و شجاعت بیان شوند."],[528,"در اگر چه خرد و اشکسته شود","توتیای دیده خسته شود","اگرچه در دل انسان خرد و شکسته‌ای وجود دارد، اما این درد و اندوه باعث می‌شود که چشم او چون توتیای (نوعی دارو) احساس خستگی و رنج بکند."],[528,"ای در از اشکست خود بر سر مزن","کز شکستن روشنی خواهی شدن","ای بر اساس شکست و مصیبت خود، برای خود زاری و ناله نکن، زیرا از طریق شکست و نابودی نمی‌توانی به روشنی و آگاهی دست یابی."],[528,"همچنین اشکسته بسته گفتنیست","حق کند آخر درستش کو غنیست","اگرچه ویرانی و شکسته شدن در مورد عشق به ظاهر ناپسند است، اما در نهایت این درد و رنج به حق می‌رسد و در پایان، کسی که واقعا توانمند و بی‌نیاز است، به آن می‌رسد."],[528,"گندم ار بشکست و از هم در سکست","بر دکان آمد که نک نان درست","اگر گندم شکسته و از هم جدا شود، نمی‌تواند نان خوبی تولید کند و تنها مانده بر دکان می‌ماند."],[528,"تو هم ای عاشق چو جرمت گشت فاش","آب و روغن ترک کن اشکسته باش","ای عاشق، وقتی که جرم و خطای تو آشکار شد، باید از ترس و شرم مانند آب و روغن که هرگز با هم مخلوط نمی‌شوند، از هم جدا شوی و رضایت بدهی که در این وضعیت، ضعف و ناتوانی تو مشخص باشد."],[528,"آنک فرزندان خاص آدم‌اند","نفحه انا ظلمنا می‌دمند","فرزندان خاص آدم (که به معنای پیامبران و بندگان خاص خدا هستند) از نفحه و بوی روحانی‌ای که ناشی از اعتراف به ظلم و گناه است دم می‌زنند و به این وسیله توجه خدا را جلب می‌کنند."],[528,"حاجت خود عرضه کن حجت مگو","هم‌چو ابلیس لعین سخت‌رو","نیاز خود را بیان کن و بهانه‌های بی‌معنا نیاور، مانند ابلیس لعین که سخت‌کوش و مقاوم است و بهانه می‌آورد."],[528,"سخت‌رویی گر ورا شد عیب‌پوش","در ستیز و سخت‌رویی رو بکوش","اگر کسی در برابر تو سخت‌رو و بی‌احساس باشد، این ویژگی او را بپوشان و در گفتگو و تعامل با او تلاش کن که بر سخت‌رویی و بی‌احساسی‌اش غلبه کنی."],[528,"آن ابوجهل از پیمبر معجزی","خواست هم‌چون کینه‌ور ترکی غزی","ابوجهل، که دشمنی با پیامبر اسلام (محمد) داشت، از او خواست معجزه‌ای نشان دهد، مانند کسی که از روی کینه و دشمنی، از دشمن خود انتظارات بی‌مورد می‌کشد."],[528,"لیک آن صدیق حق معجز نخواست","گفت این رو خود نگوید جز که راست","ولی آن صدیق (ابوبکر صدیق) که فردی راستگو و درستکار است، درخواست معجزه‌ای از پیامبر نکرد؛ چون او می‌دانست که خود پیامبر جز حقیقت و راست را نمی‌گوید."],[528,"کی رسد هم‌چون توی را کز منی","امتحان هم‌چو من یاری کنی","کی مثل تو را پیدا می‌کنم که از من نظرخواهی کند و مانند من به یاری دیگران بشتابد؟"],[529,"مرتضی را گفت روزی یک عنود","کو ز تعظیم خدا آگه نبود","روزی شخصی مغرور و ناسپاس به مرتضی (علی بن ابی‌طالب) گفت که او از عظمت و احترام به خدا اطلاعی ندارد."],[529,"بر سر بامی و قصری بس بلند","حفظ حق را واقفی ای هوشمند","تو در مکانی عالی و برجسته قرار داری، بنابراین از دانش و آگاهی خود در مورد حفظ اصول و حقوق درست استفاده کن، ای فرد باهوش."],[529,"گفت آری او حفیظست و غنی","هستی ما را ز طفلی و منی","گفت که بله، او (خدا) نگهدار و غنی است و ما را از زمان طفولیت و وجود ناتوانی‌مان حفظ کرده است."],[529,"گفت خود را اندر افکن هین ز بام","اعتمادی کن بحفظ حق تمام","خود را به خدا بسپار و از جایگاه اعتماد و اطمینان، به سوی او بیا، زیرا او تمام حقوق را پاس می‌دارد و حفظ می‌کند."],[529,"تا یقین گردد مرا ایمان تو","و اعتقاد خوب با برهان تو","تا زمانی که ایمان و اعتقاد تو به من روشن و ثابت نشود، یقین کامل به آن را پیدا نخواهم کرد."],[529,"پس امیرش گفت خامش کن برو","تا نگردد جانت زین جرئت گرو","امیر مؤمنان به او گفت که سکوت کن و برو، تا جانت به خاطر این جسارت در خطر نیفتد."],[529,"کی رسد مر بنده را که با خدا","آزمایش پیش آرد ز ابتلا","بنده چه زمانی به جایی می‌رسد که بخواهد خدا را در آزمایش قرار دهد و خود را در معرض امتحان الهی بگذارد؟"],[529,"بنده را کی زهره باشد کز فضول","امتحان حق کند ای گیج گول","بنده چگونه می‌تواند جرأت کند که بر سر امتحان و آزمایش الهی بیفتد و در کارهای بی‌فایده و بیهوده خود را درگیر کند، ای گمراه و حیران؟"],[529,"آن خدا را می‌رسد کو امتحان","پیش آرد هر دمی با بندگان","خدا هر لحظه بندگان را با امتحانات مختلف آزمایش می‌کند تا توانایی و ایمان آن‌ها را بسنجد."],[529,"تا به ما ما را نماید آشکار","که چه داریم از عقیده در سرار","خداوند تا ما را به خود نشان دهد و آشکار کند که در دل و اندیشه‌مان چه عقاید و باورهایی داریم."],[529,"هیچ آدم گفت حق را که تو را","امتحان کردم درین جرم و خطا","هیچ انسانی نتوانسته است بگوید که حق (خدا) را در این گناهان و اشتباهات مورد آزمایش قرار داده‌ام."],[529,"تا ببینم غایت حلمت شها","اه کرا باشد مجال این کرا","بگذار تا ببینم نهایت صبر و بردباری تو بر چه کسی است، و این کسی که تو بر او حلم و بردباری می‌کنی، چه کسی است."],[529,"عقل تو از بس که آمد خیره‌سر","هست عذرت از گناه تو بتر","به خاطر اینکه عقل تو به شدت گرفتار و سرگردان شده، عذر و بهانه‌ات برای گناه بیش از حد به نظر می‌رسد."],[529,"آنک او افراشت سقف آسمان","تو چه دانی کردن او را امتحان","خدای متعال که آسمان را با قدرت خود برافراشته است، تو چگونه می‌دانی که او چگونه باید آزمایش شود؟"],[529,"ای ندانسته تو شر و خیر را","امتحان خود را کن آنگه غیر را","ای تو که نمی‌دانی خوب و بد چیست، ابتدا خودت را امتحان کن و بعد سراغ دیگران برو."],[529,"امتحان خود چو کردی ای فلان","فارغ آیی ز امتحان دیگران","وقتی خودت را امتحان کردی، ای فلانی، از امتحان دیگران بی‌نیاز می‌شوی و فارغ می‌میانی."],[529,"چون بدانستی که شکردانه‌ای","پس بدانی کاهل شکرخانه‌ای","وقتی دانستی که شکرگزاری را می‌دانی و در آن توانمندی، پس متوجه می‌شوی که اگر در شکرگزاری ساکت باشی، در واقع در شکرگذاری کوتاهی کرده‌ای."],[529,"پس بدان بی‌امتحانی که اله","شکری نفرستدت ناجایگاه","پس به خاطر نداشتن امتحانی از تو، خداوند شکر و سپاس را به جایی نمی‌فرستد که شایسته‌ی آن نباشی."],[529,"این بدان بی‌امتحان از علم شاه","چون سری نفرستدت در پایگاه","این به این معناست که این شخص (علم شاه) بدون امتحان و سنجش، به تو مقام و جایگاهی می‌دهد که باید شایسته‌اش باشی و تو نمی‌توانی در آن جایگاه قرار بگیری مگر اینکه سزاوارش باشی."],[529,"هیچ عاقل افکند در ثمین","در میان مستراحی پر چمین","هیچ عاقل و دانایی نمی‌گذارد چیز باارزشی را در جایی که پر از کثافت و زباله است، بیندازد."],[529,"زانک گندم را حکیم آگهی","هیچ نفرستد به انبار کهی","چون حکیم و دانا از خواص و ویژگی‌های گندم آگاه است، هرگز آن را به انباری نمی‌فرستد تا فساد یابد یا نابود شود."],[529,"شیخ را که پیشوا و رهبرست","گر مریدی امتحان کرد او خرست","اگر شیخی که پیشوای یک گروه یا فرقه است، مریدی را آزمایش کند و او موفق نشود، آن مرید مثل الاغ است که ناتوان و بی‌فایده به نظر می‌رسد."],[529,"امتحانش گر کنی در راه دین","هم تو گردی ممتحن ای بی‌یقین","اگر تو او را در مسیر دین امتحان کنی، خودت هم در این آزمون دچار تست و سنجش خواهی شد، پس مراقب باش که شک و تردید در دل تو وجود دارد."],[529,"جرات و جهلت شود عریان و فاش","او برهنه کی شود زان افتتاش","آدمی به واسطه جرات و نادانی‌اش، به وضوح و آشکار در برابر حقیقت و واقعیت قرار می‌گیرد. او به سبب ترسی که از این حقیقت دارد، خود را نمی‌پوشاند و در نهایت به وضعیت عریان و آشکاری می‌رسد."],[529,"گر بیاید ذره سنجد کوه را","بر درد زان که ترازوش ای فتی","اگر ذره‌ای به وزن کوه بیاید، این نشان‌دهنده زشتی و درد است، زیرا که سنگینی و میزان او (ذره) بسیار کم است و در قیاس با چیزی به عظمت کوه به آسانی سنجیده می‌شود."],[529,"کز قیاس خود ترازو می‌تند","مرد حق را در ترازو می‌کند","مرد حق به سبب قیاس و سنجش خود، به ترازوی خود اعتماد نمی‌کند و او را نمی‌سنجد."],[529,"چون نگنجد او به میزان خرد","پس ترازوی خرد را بر درد","اگر مرد حق از نظر خرد قابل سنجش نباشد، پس سنجش‌های خرد که به معیارهای محدود انسانی است، ناتوان از درک او خواهند بود."],[529,"امتحان هم‌چون تصرف دان درو","تو تصرف بر چنان شاهی مجو","امتحان کردن مثل تصرف و تسلط بر دانایی است، تو هم در امتحان کردن، قدرت بر آن شاهی که دانش و معرفتش بالاست را نطلب."],[529,"چه تصرف کرد خواهد نقشها","بر چنان نقاش بهر ابتلا","نقاش برای آزمودن و امتحان، طرح‌ها و نقش‌هایی می‌کشد که تجلی اراده و خواست خود اوست. در واقع، در اینجا به نکته‌ای اشاره می‌شود که نقاش با خلق آثارش، قدرت و توانایی‌اش را نشان می‌دهد."],[529,"امتحانی گر بدانست و بدید","نی که هم نقاش آن بر وی کشید","اگر امتحانی دانست و دید که آن نقاش چه چیزی بر او ترسیم کرده است، دیگر از این به بعد خود نقاش نمی‌تواند او را آزمون کند."],[529,"چه قدر باشد خود این صورت که بست","پیش صورتها که در علم ویست","این بیت به تمایز و تفاوت بین اشکال ظاهری و باطنی اشاره دارد و می‌پرسد که این صورت خارجی که مطرح شده، چه اندازه از حقیقت و علم واقعی او (خدای) دور است. در واقع، به ارزش و عمق معنوی علم و معرفت اشاره می‌کند که فراتر از ظاهرهاست."],[529,"وسوسه این امتحان چون آمدت","بخت بد دان کآمد و گردن زدت","وقتی وسوسه و امتحان به تو روی می‌آورد، بدی‌های آن را بشناس و بدان که این بخت بد به تو حمله کرده و تو باید با آن مقابله کنی."],[529,"چون چنین وسواس دیدی زود زود","با خدا گرد و در آ اندر سجود","وقتی چنین وسوسه‌ای را تجربه می‌کنی، سریعا به یاد خدا بیفت و به سجده برو."],[529,"سجده گه را تر کن از اشک روان","کای خدا تو وا رهانم زین گمان","سجده‌ات را با اشک و دعا تر کن و از خدا بخواه که مرا از این شک و گمان رهایی بخشد."],[529,"آن زمان کت امتحان مطلوب شد","مسجد دین تو پر خروب شد","وقتی که زمان امتحان فرا رسید، مسجد دین تو پر از خروس‌ها (نماد بیداری و هشیاری) شد."],[530,"چون درآمد عزم داودی به تنگ","که بسازد مسجد اقصی به سنگ","داود تصمیم گرفته بود که مسجد اقصی را با سنگ بسازد، اما وقتی به این کار عزم جزم کرد، احساس کرد که این کار برایش دشوار است."],[530,"وحی کردش حق که ترک این بخوان","که ز دستت برنیاید این مکان","خداوند به داوود وحی کرد که از ساختن این مسجد دست بردارد، زیرا این کار از توان تو خارج است."],[530,"نیست در تقدیر ما آنک تو این","مسجد اقصی بر آری ای گزین","ما در سرنوشت خود نمی‌توانیم آنچه تو می‌خواهی، یعنی ساختن این مسجد اقصی را به انجام برسانیم، ای کسی که انتخاب شده‌ای."],[530,"گفت جرمم چیست ای دانای راز","که مرا گویی که مسجد را مساز","داود علیه‌السلام می‌پرسد که ای عالم رازها، جرم من چیست که به من می‌گویی مسجد را نساختی."],[530,"گفت بی‌جرمی تو خونها کرده‌ای","خون مظلومان بگردن برده‌ای","او می‌گوید که تو بی‌گناه نیستی و با اعمال خود، خون انسان‌های بی‌گناه زیادی را بر دوش خود داری."],[530,"که ز آواز تو خلقی بی‌شمار","جان بدادند و شدند آن را شکار","بسیاری از مردم به خاطر صدای دلنواز و زیبا تو جان خود را از دست دادند و به نوعی به طعمه‌ای برای این صدا تبدیل شدند."],[530,"خون بسی رفتست بر آواز تو","بر صدای خوب جان‌پرداز تو","بسیاری از انسان‌ها تحت تأثیر صدای زیبا و دلنواز تو جان خود را از دست داده‌اند."],[530,"گفت مغلوب تو بودم مست تو","دست من بر بسته بود از دست تو","گفت من در برابر تو تسلیم بودم و تحت تأثیر تو قرار داشتم، به‌گونه‌ای که نمی‌توانستم اقدامی انجام دهم و دستم از قدرت تو به‌دست تو بسته شده بود."],[530,"نه که هر مغلوب شه مرحوم بود","نه که المغلوب کالمعدوم بود","نه اینکه هر کسی که مغلوب می‌شود، حتما باید بی‌رحم و بی‌احساس باشد، و نه اینکه مغلوب شدن به معنای وجود نداشتن و نابودی است."],[530,"گفت این مغلوب معدومیست کو","جز به نسبت نیست معدوم ایقنوا","این شخص مغلوب، وجودی ندارد و تنها به لحاظ نسبت و ارتباط شناخته می‌شود؛ بنابراین، او در حقیقت معدوم است و این موضوع را به یقین دریابید."],[530,"این چنین معدوم کو از خویش رفت","بهترین هستها افتاد و زفت","کسی که از خود رفته و از هویت واقعی‌اش دور شده، به بهترین و باارزش‌ترین موجودات تبدیل شده و دچار ضعف و نقصان می‌شود."],[530,"او به نسبت با صفات حق فناست","در حقیقت در فنا او را بقاست","انسان نسبت به صفات خداوند همچون فنا و زوال است، اما در واقع در این فنا و نیستی، وجود حقیقی و بقای او نهفته است."],[530,"جمله ارواح در تدبیر اوست","جمله اشباح هم در تیر اوست","تمامی ارواح تحت تدبیر و رهنمود او (خدا) هستند و همه اجسام (اشباح) نیز در اختیار اراده او قرار دارند."],[530,"آنک او مغلوب اندر لطف ماست","نیست مضطر بلک مختار ولاست","او کسی است که در محبت و لطف ما مغلوب شده و نه در حال اضطرار است، بلکه به اختیار خود و با میل ما قرار دارد."],[530,"منتهای اختیار آنست خود","که اختیارش گردد اینجا مفتقد","کمال و نهایت اختیار در این است که اختیار به دست خود انسان باشد، و اگر انسان در جایی از اختیار خود محروم شود، در واقع آن اختیار را از دست داده است."],[530,"اختیاری را نبودی چاشنی","گر نگشتی آخر او محو از منی","اختیار هیچ طعمی ندارد و جذابیت آن به دلیل وجود \"من\" (خود) است؛ اگر انسان از خودآگاهی و منیت خود محو شود، دیگر اختیاری نخواهد داشت."],[530,"در جهان گر لقمه و گر شربتست","لذت او فرع محو لذتست","در این دنیا هر چیزی که وجود دارد، چه غذا و چه نوشیدنی، لذت واقعی آن چیزی فراتر از خود لذت‌هاست و وابسته به غیبت و محو خود لذت‌ها است."],[530,"گرچه از لذات بی‌تاثیر شد","لذتی بود او و لذت‌گیر شد","حتی اگر از لذت‌ها تأثیر نپذیرد، خود او لذتی است که از آن بهره‌مند می‌شود."],[531,"گرچه بر ناید به جهد و زور تو","لیک مسجد را برآرد پور تو","هرچند که با تلاش و کوشش خود نمی‌توانی چیزی را به دست بیاوری، اما فرزند تو می‌تواند مسجدی را بنا کند و فراهم آورد."],[531,"کرده او کرده تست ای حکیم","مؤمنان را اتصالی دان قدیم","ای حکیم، بدان که کارهای هر مؤمنی، به نوعی به کارهای دیگر مؤمنان مربوط و پیوند دارد. این پیوند و ارتباط بین مؤمنان، از دیرباز وجود داشته و یک امر طبیعی است."],[531,"مؤمنان معدود لیک ایمان یکی","جسمشان معدود لیکن جان یکی","مؤمنان شاید در تعداد کم باشند، اما ایمان آن‌ها یکی است. هر چند جسم‌هایشان متعددند، ولی روح و جان آن‌ها به مثابه‌ای واحد است."],[531,"غیرفهم و جان که در گاو و خرست","آدمی را عقل و جانی دیگرست","غیر از فهم و روح که در حیواناتی مثل گاو و خر وجود دارد، انسان دارای عقل و جان متفاوت و برتری است."],[531,"باز غیرجان و عقل آدمی","هست جانی در ولی آن دمی","به جز جان و عقل انسانی، نوعی جان دیگر وجود دارد که مخصوص ولی (اولیای الهی) است و در زمان رستاخیز (یا لحظه‌ای خاص) در آن‌ها بروز می‌کند."],[531,"جان حیوانی ندارد اتحاد","تو مجو این اتحاد از روح باد","اتحاد واقعی در انسان‌ها و موجودات زنده به دلیل روح الهی و معنوی آنهاست، نه به خاطر شباهت‌های جسمی یا حیوانی. بنابراین، نباید انتظار اتحاد را در جنبه‌های حیوانی جستجو کرد، بلکه این اتحاد در بعد روحانی و معنوی افراد است."],[531,"گر خورد این نان نگردد سیر آن","ور کشد بار این نگردد او گران","اگر کسی این نان را بخورد، سیر نمی‌شود و آن بار را که بر دوش دارد، سبک نمی‌کند، یعنی به راحتی از عهده بارش برنمی‌آید. به عبارتی دیگر، این نان و آن بار در واقع نمی‌توانند به او کمک کنند تا حال بهتری پیدا کند."],[531,"بلک این شادی کند از مرگ او","از حسد میرد چو بیند برگ او","این شادی از خود مرگ او ناشی می‌شود، یعنی وقتی کسی از حسد می‌میرد، به خاطر دیدن موفقیت یا پیشرفت دیگران، خود را ناراحت می‌کند."],[531,"جان گرگان و سگان هر یک جداست","متحد جانهای شیران خداست","روح و جان گرگ‌ها و سگ‌ها از هم جداست، اما جان شیران خدا با یکدیگر متحد است. این بیت به تشابه و پیوستگی روح‌های بزرگ و والا اشاره دارد، در حالی که موجودات کوچک‌تر و پست‌تر روح‌های جداگانه‌ای دارند."],[531,"جمع گفتم جانهاشان من به اسم","کان یکی جان صد بود نسبت به جسم","جمعی از جان‌ها را با یکدیگر به خاطر این تصور می‌کنم که در حقیقت، همه آن‌ها به یک جان واحد تعلق دارند و این ارتباط بین جان‌ها همچون این است که صد جان با جسم واحدی نسبت دارند."],[531,"هم‌چو آن یک نور خورشید سما","صد بود نسبت بصحن خانه‌ها","همان‌طور که نور خورشید، یک نور است ولی در مکان‌های مختلف به صورت‌های متعدد و جدا تجلی می‌کند، جان‌ها نیز با وجود اینکه متفاوت به نظر می‌رسند، در اصل و حقیقت واحد هستند."],[531,"لیک یک باشد همه انوارشان","چونک برگیری تو دیوار از میان","همه انوار (نورها) آنها یکسانند، مانند اینکه اگر دیواری را از وسط برداری، همه نورها به یکجا می‌ریزد و یک‌پارچگی آنها مشخص می‌شود. به این معنی است که ارتباط و اتحاد مؤمنان و خردمندان به صورت قوی و یکپارچه است."],[531,"چون نماند خانه‌ها را قاعده","مؤمنان مانند نفس واحده","وقتی قاعده و ساختار خانه‌ها از میان برود، مؤمنان نیز مانند یک نفس واحد دیگر وجود ندارند و اتحاد آنها از بین می‌رود."],[531,"فرق و اشکالات آید زین مقال","زانک نبود مثل این باشد مثال","اختلاف‌ها و اشکالاتی که در این بحث به وجود می‌آید به این دلیل است که هیچ مثال مشابهی نمی‌توان یافت."],[531,"فرقها بی‌حد بود از شخص شیر","تا به شخص آدمی‌زاد دلیر","اختلاف‌ها و فرق‌ها بسیار زیاد است؛ از فردی چون شیر (که نماد قدرت و شجاعت است) تا انسانی دلیر، همه تحت تأثیر این تفاوت‌ها قرار دارند."],[531,"لیک در وقت مثال ای خوش‌نظر","اتحاد از روی جانبازی نگر","اما در مورد اتحاد، ای نیک‌نظر، در زمان مثال به این نکته توجه کن که باید از روی فداکاری و ایثار نگاه کنی."],[531,"کان دلیر آخر مثال شیر بود","نیست مثل شیر در جمله حدود","دلیر آخر، یعنی در نهایت شجاعت و دلیری، مانند شیر است و هیچ موجود دیگری نمی‌تواند به او در این خصوص شباهت پیدا کند."],[531,"متحد نقشی ندارد این سرا","تا که مثلی وا نمایم من ترا","تا زمانی که نتوانم مثالی برای تو بزنم، این خانه اصلا یک شکل و نقش مشخصی ندارد و خالی است از اتحاد."],[531,"هم مثال ناقصی دست آورم","تا ز حیرانی خرد را وا خرم","من می‌خواهم مثال ناقصی ارائه دهم تا از حیرت و سردرگمی عقل و فکر را رها سازم."],[531,"شب بهر خانه چراغی می‌نهند","تا به نور آن ز ظلمت می‌رهند","در شب، برای هر خانه چراغی قرار می‌دهند تا با نور آن، از تاریکی دور شوند و در روشنایی زندگی کنند."],[531,"آن چراغ این تن بود نورش چو جان","هست محتاج فتیل و این و آن","این بیت می‌گوید که بدن انسان مانند چراغی است که نورش به روح (جان) وابسته است و برای روشن کردن آن نیاز به فتیله و دیگر اجزاء دارد. در واقع، جان به عنوان شعور و آگاهی، باعث روشنایی و زندگی در این بدن است."],[531,"آن چراغ شش فتیله این حواس","جملگی بر خواب و خور دارد اساس","چراغی که با شش فتیله روشن می‌شود، به حواس ما مربوط می‌شود و همه آن‌ها به خواب و غذا وابسته‌اند."],[531,"بی‌خور و بی‌خواب نزید نیم دم","با خور و با خواب نزید نیز هم","بی‌خور و بی‌خواب، نزدیک به نیم دم (آخر دم) است، اما با خور و خواب نیز به همین نزدیکی می‌شود. به عبارت دیگر، کسی که نه می‌خورد و نه می‌خوابد، به حال مرگ نزدیک است، اما اگر غذا و خواب باشد، باز هم در نزدیکی مرگ قرار دارد."],[531,"بی‌فتیل و روغنش نبود بقا","با فتیل و روغن او هم بی‌وفا","بدون فتیله و روغن، چیزی پابرجا نمی‌ماند؛ حتی فتیله و روغن هم از وفاداری به جا نمی‌مانند."],[531,"زانک نور علتی‌اش مرگ‌جوست","چون زید که روز روشن مرگ اوست","چون نور علت مرگ است، مانند زید که در روز روشن می‌میرد."],[531,"جمله حسهای بشر هم بی‌بقاست","زانک پیش نور روز حشر لاست","تمام حس‌های انسانی ناپایدار و زودگذر است، زیرا در برابر نور روز قیامت، که حقیقت و واقعیت را نمایان می‌کند، مثل خاک و نیستی است."],[531,"نور حس و جان بابایان ما","نیست کلی فانی و لا چون گیا","نور حواس و جان پدران ما دائمی نیست و کلا فناپذیر است، مانند گیاه که در گذر زمان زائل می‌شود."],[531,"لیک مانند ستاره و ماهتاب","جمله محوند از شعاع آفتاب","اما مانند ستاره‌ها و ماه، همه از تابش آفتاب بهره‌مند هستند و به یک نور وابسته‌اند."],[531,"آنچنان که سوز و درد زخم کیک","محو گردد چون در آید مار الیک","سوز و درد ناشی از زخم و جراحت مانند درد کیک (مکافاتی که بر سر انسان می‌آید) وقتی به پایان می‌رسد که ماری به خانه بیفتد؛ یعنی، در زمانی که مشکل یا درد بزرگ‌تری پیش‌آمده، دردهای کوچک‌تر فراموش می‌شوند و به چشم نمی‌آیند."],[531,"آنچنان که عور اندر آب جست","تا در آب از زخم زنبوران برست","چنان‌که عور (کسیکه بینا نیست) در آب می‌افتد و جستجو می‌کند تا از زخم زنبوران رهایی یابد، در اینجا مقصود بیان حالتی است که انسان به شدت در تلاش است تا از دردها و آلام رهایی یابد."],[531,"می‌کند زنبور بر بالا طواف","چون بر آرد سر ندارندش معاف","زنبور بر بالای گل‌ها دور می‌زند و طواف می‌کند، اما وقتی سرش می‌رسد، از آنچه خود را به دردسر انداخته، معاف می‌شود. این تصویر نشان دهنده تلاش و کوششی است که بدون در نظر گرفتن خطرات، به هدف خود می‌رسد."],[531,"آب ذکر حق و زنبور این زمان","هست یاد آن فلانه وان فلان","آب ذکر خدا و زنبور حالا یادآور افرادی خاص است که در این زمان به یاد آن‌ها هستیم."],[531,"دم بخور در آب ذکر و صبر کن","تا رهی از فکر و وسواس کهن","به خروسی که در آب ذکر خدا دم می‌زند گوش کن و با صبوری انتظار بکش تا از افکار و وسواس‌های قدیمی آزاد شوی."],[531,"بعد از آن تو طبع آن آب صفا","خود بگیری جملگی سر تا به پا","پس از اینکه در آب ذکر مشغول شدی و صبر کنی، تو نیز به طبع و ذات آن آب زلال دست می‌یابی و در تمام وجودت تأثیر آن را احساس می‌کنی."],[531,"آنچنان که از آب آن زنبور شر","می‌گریزد از تو هم گیرد حذر","زنبور در آب از شرّ و خطر دوری می‌کند؛ تو نیز باید از نزد دیگران و آزار آنها دوری کنی و حواست به حفظ خود باشد."],[531,"بعد از آن خواهی تو دور از آب باش","که بسر هم‌طبع آبی خواجه‌تاش","اگر بخواهی از آب دور بمانی، باید مراقب هم‌طبعان خود یعنی افرادی که طبعی مشابه تو دارند نیز باشی، زیرا این افراد به‌طور طبیعی تو را به سمت خود جذب می‌کنند."],[531,"بس کسانی کز جهان بگذشته‌اند","لا نیند و در صفات آغشته‌اند","بسیاری از افرادی که از دنیا رفته‌اند، در صفات و ویژگی‌های خود به آن چیزی که می‌گذرد، آغشته و درگیر شده‌اند."],[531,"در صفات حق صفات جمله‌شان","هم‌چو اختر پیش آن خور بی‌نشان","صفات حق، مانند ستاره‌هایی هستند که در برابر خورشید پنهان می‌شوند و قابل رؤیت نیستند. به عبارتی دیگر، معرفی کردن صفات الهی به وضوح، به اندازه‌ی تابش خورشید بر ستاره‌ها نیست، چون در حضور حقیقت الهی، آن صفات به خوبی مشخص نمی‌شوند."],[531,"گر ز قرآن نقل خواهی ای حرون","خوان جمیع هم لدینا محضرون","اگر می‌خواهی از قرآن نقل کنی، ای حرون (علامت اشاره به یک شخصیت معنوی یا علمی)، همه علمای ما در محضر ما حاضر هستند."],[531,"محضرون معدوم نبود نیک بین","تا بقای روحها دانی یقین","محضرون (حضور)، وجود ندارد مگر برای کسانی که درک روشنی دارند؛ تا زمانی که به سبب وجود روح‌ها مطمئن شوی و بقای آنها را بشناسی."],[531,"روح محجوب از بقا بس در عذاب","روح واصل در بقا پاک از حجاب","روحی که از بقای ابدی محروم است، در عذاب و درد به سر می‌برد، در حالی که روحی که به بقای واقعی رسیده، از تمام حجاب‌ها و موانع پاک و آزاد است."],[531,"زین چراغ حس حیوان المراد","گفتمت هان تا نجویی اتحاد","از چراغ حس حیوانی (حس‌های جانداران) به تو گفتم که تا اتحاد را جستجو کنی."],[531,"روح خود را متصل کن ای فلان","زود با ارواح قدس سالکان","خودت را به روح پاک و مقدس سالکان متصل کن، ای فلان (در اینجا احتمالا به شخص خاصی اشاره دارد)، تا هرچه زودتر به کمال و روشنایی برسی."],[531,"صد چراغت ار مرند ار بیستند","پس جدا اند و یگانه نیستند","اگر صد چراغ هم داشته باشی، اگرچه در ظاهر شبیه به هم هستند، اما باز هم جدا از یکدیگرند و یگانه نیستند."],[531,"زان همه جنگند این اصحاب ما","جنگ کس نشنید اندر انبیا","این گروه از پیامبران (انبیا) به هیچ‌وجه در جنگ و نزاع نیستند و هیچ‌کس خبری از جنگ آن‌ها نشنیده است."],[531,"زانک نور انبیا خورشید بود","نور حس ما چراغ و شمع و دود","نور پیامبران مانند خورشید است، در حالی که امکانات حسی ما مانند چراغ، شمع و دود هستند که روشنایی کمتری دارند و در واقع ناپایدار و زودگذرند."],[531,"یک بمیرد یک بماند تا به روز","یک بود پژمرده دیگر با فروز","اگر یکی از انبیای الهی بمیرد و دیگری زنده بماند، در حقیقت همه آنان به‌صورت یک وجود واحد تحت تأثیر همدیگر هستند؛ یعنی اگر یکی از ایشان را نادیده بگیریم یا انکار کنیم، کیان‌اند و مقامشان تحت تأثیر قرار می‌گیرد، به‌طوری‌که وجود یکی به عدم دیگری مرتبط است."],[531,"جان حیوانی بود حی از غذا","هم بمیرد او بهر نیک و بذی","جان حیوانات به غذا وابسته است و اگر از آن محروم شوند، می‌میرند. زندگی آن‌ها به خوبی و نعمت‌ها بستگی دارد."],[531,"گر بمیرد این چراغ و طی شود","خانه همسایه مظلم کی شود","اگر این چراغ (علم و دانش) خاموش شود، خانه همسایه هم تاریک خواهد شد. چون نور الهام و دانش به یکدیگر وابسته‌اند و قطع نور یکی، تاریکی دیگری را به دنبال دارد."],[531,"نور آن خانه چو بی این هم به پاست","پس چراغ حس هر خانه جداست","اگر نور آن خانه هم بدون این چراغ روشن باشد، پس چراغ حواس هر خانه به‌طور جداگانه‌ای وجود دارد و به هم وابسته نیست."],[531,"این مثال جان حیوانی بود","نه مثال جان ربانی بود","این مثال، مانند جان موجودات زنده است و نه مانند جان الهی و الهام‌بخش. مولانا به تفاوت میان روح انسانی و روح پروردگار اشاره دارد."],[531,"باز از هندوی شب چون ماه زاد","در سر هر روزنی نوری فتاد","از هندوی شب (که به معنی یکی از کشورهای شرق است) مانند ماه نوری متولد شد و در هر شکاف و روزنه‌ای نوری تابید. این تصویر به توفیق یا برکت و روشنایی‌ای اشاره دارد که از این هندوی شب برمی‌خیزد و به همه جا نفوذ می‌کند."],[531,"نور آن صد خانه را تو یک شمر","که نماند نور این بی آن دگر","اگر نور یک خانه را حساب کنی، باید نور صد خانه را هم در نظر بگیری، زیرا وقتی یکی از این خانه‌ها در تاریکی باشد، نور بقیه هم تحت تاثیر قرار می‌گیرد و نمی‌توان آن را جدا کرد."],[531,"تا بود خورشید تابان بر افق","هست در هر خانه نور او قنق","تا زمانی که خورشید روشن بر آسمان وجود دارد، در هر خانه نوری از او هست و زندگی در آن خانه‌ها رونق دارد."],[531,"باز چون خورشید جان آفل شود","نور جمله خانه‌ها زایل شود","هنگامی که خورشید جان، یعنی روح یا زندگی، از بین برود، نور و حیات تمام خانه‌ها یا موجودات نیز از بین خواهد رفت."],[531,"این مثال نور آمد مثل نی","مر ترا هادی عدو را ره‌زنی","این مثال نور مانند نی است که تو را به سوی هدایت می‌کند و در عین حال باعث می‌شود که دشمنان را فریب دهی."],[531,"بر مثال عنکبوت آن زشت‌خو","پرده‌های گنده را بر بافد او","شاعر به تشبیه عنکبوت می‌پردازد که بافت‌های بزرگ و زشت‌اش را می‌سازد. این تشبیه نشان‌دهنده نوعی بدی یا تاریکی است که بر ذهن یا افکار انسان‌ها می‌افتد و مانع از درک حقیقت می‌شود."],[531,"از لعاب خویش پرده نور کرد","دیده ادراک خود را کور کرد","مدت زمان طولانی انسان با حواس و ادراک خود، دچار غفلت و سری بودن است و به واسطه تمایلات و خواسته‌های دنیوی، بصیرت و درک صحیح خود را از دست می‌دهد."],[531,"گردن اسپ ار بگیرد بر خورد","ور بگیرد پاش بستاند لگد","اگر کسی گردن اسبی را بگیرد، باید مراقب باشد چون ممکن است اسب لگدی به او بزند. این بدان معناست که در برخورد با مسائل و چالش‌ها باید احتیاط کرد و به دقت عمل کرد، زیرا ممکن است به نتیجه‌ای ناخوشایند منجر شود."],[531,"کم نشین بر اسپ توسن بی‌لگام","عقل و دین را پیشوا کن والسلام","به کم نشین بر اسپ توسن بی‌لگام اشاره دارد به این که بدون داشتن عقل و دین به کجا می‌روی و از آن‌ها پیروی نکن. بر این مبنا، عقل و دین باید رهبر و راهنمای تو باشند تا در مسیر درست حرکت کنی."],[531,"اندرین آهنگ منگر سست و پست","کاندرین ره صبر و شق انفسست","در این مسیر ننگر که ضعیف و پست است، زیرا در این راه صبر و تلاش و استقامت لازم است."],[532,"چون سلیمان کرد آغاز بنا","پاک چون کعبه همایون چون منی","زمانی که سلیمان شروع به ساختن این بنا کرد، پاکی و عظمت آن مانند کعبه‌ی شریف بود."],[532,"در بنااش دیده می‌شد کر و فر","نی فسرده چون بناهای دگر","در ساخت مسجد، از زیبایی و عظمت آن چیزی کم نمی‌شد و هیچ نقصی در آن دیده نمی‌شد، حتی اگر آن را با دیگر بناها مقایسه کنیم."],[532,"در بنا هر سنگ کز که می‌سکست","فاش سیروا بی‌همی گفت از نخست","هر سنگی که در بنای مسجد می‌شکست، بدون هیچ تردیدی از ابتدا ندا می‌داد و ویژگی‌های خود را نشان می‌داد."],[532,"هم‌چو از آب و گل آدم‌کده","نور ز آهک پاره‌ها تابان شده","مانند اینکه انسان از آب و گل ساخته شده است، نور مسجد نیز از پاره‌های آهک روشن شده و درخشان گشته است."],[532,"سنگ بی‌حمال آینده شده","وان در و دیوارها زنده شده","سنگ‌هایی که بار آن‌ها را کسی حمل نکرده، به نوعی آینده‌نگر شده و این در و دیوارها به حیات و زنده بودن رسیده‌اند."],[532,"حق همی‌گوید که دیوار بهشت","نیست چون دیوارها بی‌جان و زشت","خداوند می‌گوید که دیوارهای بهشت وجود ندارند، چون دیوارها بدون روح و زشت هستند."],[532,"چون در و دیوار تن با آگهیست","زنده باشد خانه چون شاهنشهیست","معنای بیت این است که وقتی در و دیوار وجود انسان آگاه و هوشیار باشند، آن خانه نیز مانند یک شاه، زنده و پرتوان خواهد بود. به عبارت دیگر، وجود آگاهی و شعور در انسان باعث بوجود آمدن وجودی با روح و زندگی در خانه‌اش می‌شود."],[532,"هم درخت و میوه هم آب زلال","با بهشتی در حدیث و در مقال","در بهشت، هم درخت و هم میوه و هم آب زلال وجود دارد که در سخن و روایت‌ها درباره آن بحث شده است."],[532,"زانک جنت را نه ز آلت بسته‌اند","بلک از اعمال و نیت بسته‌اند","بهشت را نه به وسیله ابزار و وسایل می‌سازند، بلکه به وسیله اعمال نیک و نیت‌های پاک شکل می‌دهند."],[532,"این بنا ز آب و گل مرده بدست","وان بنا از طاعت زنده شدست","این بنا (مسجد) از آب و گل و مواد بی‌جان ساخته شده، اما این بنا (انسان) به واسطه‌ی اعمال نیک و عبادت‌هایش جان گرفته و زنده شده است."],[532,"این به اصل خویش ماند پرخلل","وان به اصل خود که علمست و عمل","این مجموعه به طبیعت واقعی خود باقی می‌ماند و دارای نقص‌هایی است، در حالی که آن چیزی که علم و عمل است، به اصل خود وفادار می‌ماند و هیچ کرانش ناپایداری ندارد."],[532,"هم سریر و قصر و هم تاج و ثیاب","با بهشتی در سؤال و در جواب","این بیت به این معناست که هر چیزی از جمله تخت و کاخ، تاج و لباس‌های با شکوه، در روز قیامت به درگاه خداوند در حال پرسش و پاسخ قرار می‌گیرد، گویی که در آن روز همه چیز باید پاسخگو باشد و هیچ چیز از حساب و کتاب مستثنی نیست."],[532,"فرش بی‌فراش پیچیده شود","خانه بی‌مکناس روبیده شود","فرش بدون زیرانداز جمع می‌شود و خانه بدون در و سقف و محافظ خالی می‌شود."],[532,"خانه دل بین ز غم ژولیده شد","بی‌کناس از توبه‌ای روبیده شد","دل انسان به خاطر غم‌های فراوان و بی‌کسی به هم ریخته و بی‌نظم شده است، و توبه‌ای که کرده، او را از حالت ناامیدی و پریشانی رها نکرده است."],[532,"تخت او سیار بی‌حمال شد","حلقه و در مطرب و قوال شد","تخت او (یعنی تخت خداوند) دیگر نمی‌نشیند و بدون باربران (حمال‌ها) می‌چرخد و حلقه و در (بسته) و مطلوبش به آوازخوان و داستان‌گو تبدیل شده است."],[532,"هست در دل زندگی دارالخلود","در زبانم چون نمی‌آید چه سود","در دل زندگی، جایگاه ابدیت و جاودانگی وجود دارد، اما اگر این حقیقت در زبان من قابل بیان نباشد، چه فایده‌ای دارد؟"],[532,"چون سلیمان در شدی هر بامداد","مسجد اندر بهر ارشاد عباد","هر روز صبح وقتی که سلیمان وارد مسجد می‌شد، برای هدایت و راهنمایی بندگان خدا تلاش می‌کرد."],[532,"پند دادی گه بگفت و لحن و ساز","گه به فعل اعنی رکوعی یا نماز","شما هنگام سخن گفتن، هم نصیحت می‌کنید و هم با لحن زیبا و موزون، به اعمال و حرکات مانند رکوع یا نماز اشاره می‌کنید."],[532,"پند فعلی خلق را جذاب‌تر","که رسد در جان هر باگوش و کر","پند و نصیحتی که بر اساس عمل به آن داده شود، برای مردم دلنشین‌تر و تأثیرگذارتر است و به آسانی در دل هر شنونده‌ای، چه شنوا و چه ناشنوا، نفوذ می‌کند."],[532,"اندر آن وهم امیری کم بود","در حشم تاثیر آن محکم بود","در آن تخیل و تصور، امیری وجود نداشت، اما تأثیر آن بر جمعیت و پیروانش بسیار قوی و محکم بود."],[533,"قصه عثمان که بر منبر برفت","چون خلافت یافت بشتابید تفت","وقتی عثمان بر منبر رفت و خلافت را به دست آورد، با شتاب و چابکی به کار خود پرداخت."],[533,"منبر مهتر که سه‌پایه بدست","رفت بوبکر و دوم پایه نشست","عثمان، پس از به‌دست گرفتن خلافت، بر منبر نشست که در واقع نماد رهبری و هدایت مسلمین بود. نخستین پایه منبر به ابوبکر تعلق داشت و پایه دوم به عمر."],[533,"بر سوم پایه عمر در دور خویش","از برای حرمت اسلام و کیش","عثمان، به عنوان خلیفه، بر پایه سوم نشسته است و این کار او به خاطر احترام به اسلام و دین است که در دوران عمر به دست آمده بود."],[533,"دور عثمان آمد او بالای تخت","بر شد و بنشست آن محمودبخت","در دوران خلافت عثمان، او به جایگاه قدرت نشسته و به مقام رهبری دست یافته است. در این بیت به توصیف خوشبختی و شایستگی او در این موقعیت اشاره شده است."],[533,"پس سؤالش کرد شخصی بوالفضول","که آن دو ننشستند بر جای رسول","شخصی فضول از عثمان سوال کرد که چرا آن دو (ابوبکر و عمر) بر جای پیامبر ننشسته‌اند."],[533,"پس تو چون جستی ازیشان برتری","چون برتبت تو ازیشان کمتری","اگر تو از آنها برتری جسته‌ای، بدان که برتری‌ات از نظر معنوی است و نسبت به آنها کمتر از آنچه که به نظر می‌رسد، هستی."],[533,"گفت اگر پایه سوم را بسپرم","وهم آید که مثال عمرم","اگر من پایه سوم را رها کنم، ممکن است که به یاد عمر (عمر بن خطاب) بیفتم."],[533,"بر دوم پایه شوم من جای‌جو","گویی بوبکرست و این هم مثل او","من می‌خواهم بر پایه دوم به جایگاه خود بیفتم و در این مقام بگویم که من مانند ابوبکر هستم و این موقعیت نیز مشابه اوست."],[533,"هست این بالا مقام مصطفی","وهم مثلی نیست با آن شه مرا","این مقام بلند و والای پیامبر اکرم (مصطفی) است و هیچ‌کس را نمی‌توان با او مقایسه کرد."],[533,"بعد از آن بر جای خطبه آن ودود","تا به قرب عصر لب‌خاموش بود","پس از آن، در محل برگزاری خطبه، حضرت عثمان، محبوب و دوست‌داشتنی، تا زمان نزدیک عصر، سکوت کرد و سخنی نگفت."],[533,"زهره نه کس را که گوید هین بخوان","یا برون آید ز مسجد آن زمان","هیچ‌کس جرات ندارد که بگوید: «بشتابید و نماز را بخوانید» یا آن زمان از مسجد خارج شود."],[533,"هیبتی بنشسته بد بر خاص و عام","پر شده نور خدا آن صحن و بام","در این بیت، سخن از هیبت و جلال خدای متعال است که بر همگان، اعم از خاص و عام، سایه افکنده و آن نور الهی فضای مسجد و بام آن را روشن کرده است. این تصویر نشان‌دهنده‌ی فراگیری حضور و نور خداوند در میان مردم است."],[533,"هر که بینا ناظر نورش بدی","کور زان خورشید هم گرم آمدی","هر کس که با بصیرت و آگاهی به نور الهی بنگرد، از روشنی و هدایت آن بهره‌مند می‌شود و اگر کسی بینا نباشد، از روشنایی این خورشید بی‌نصیب خواهد ماند."],[533,"پس ز گرمی فهم کردی چشم کور","که بر آمد آفتابی بی‌فتور","در نتیجه گرمی و روشنایی فهم، کسی که کور است، بینا می‌شود، زیرا آفتابی که به طور مداوم و بی‌نقص می‌تابد، دیدگان او را باز می‌کند."],[533,"لیک این گرمی گشاید دیده را","تا ببیند عین هر بشنیده را","این گرمی و فهمی که به انسان دست می‌دهد، باعث می‌شود که او بتواند واقعیت هر چیزی را که شنیده است، به وضوح ببیند."],[533,"گرمیش را ضجرتی و حالتی","زان تبش دل را گشادی فسحتی","گرمای عشق و شوق، حالتی شگفت و تنگی به دل بخشید که آن را گشاد و وسیع کرد."],[533,"کور چون شد گرم از نور قدم","از فرح گوید که من بینا شدم","وقتی کور از شوق و شادی نور قدم را احساس می‌کند، می‌گوید که من بینا شدم."],[533,"سخت خوش مستی ولی ای بوالحسن","پاره‌ای راهست تا بینا شدن","بوالحسن، سخت خوشحال و سرمست به‌نظر می‌رسد، اما باید دانست که راهی وجود دارد که او را به بینایی واقعی می‌رساند."],[533,"این نصیب کور باشد ز آفتاب","صد چنین والله اعلم بالصواب","این نصیب انسان‌های نابینا خواهد بود، اگر در برابر آفتاب (حقایق و روشنایی‌ها) قرار بگیرند. به راستی، خداوند داناتر است که چه چیزی درست است و چه چیزی نادرست."],[533,"وآنک او آن نور را بینا بود","شرح او کی کار بوسینا بود","کسی که آن نور (حقیقت) را می‌بیند، باید بداند که هیچ چیز به اندازه‌ی شناخت و باور به آن نور، ارزشمند نیست."],[533,"ور شود صد تو که باشد این زبان","که بجنباند به کف پرده عیان","اگر صد نفر هم مانند تو باشند، چه فایده‌ای دارد، چون این زبان (زبان گویا) نمی‌تواند پرده حقیقت را به حرکت درآورد و آن را عیان کند."],[533,"وای بر وی گر بساید پرده را","تیغ اللهی کند دستش جدا","ناله و افسوس به حال کسی که پرده حقیقت را کنار بزند، خشم و قهر الهی به سرنوشت او می‌انجامد و او را از خود دور می‌کند."],[533,"دست چه بود خود سرش را بر کند","آن سری کز جهل سرها می‌کند","منظور این است که دست چه قدرتی دارد که بتواند سر او را از تن جدا کند، حال آنکه او (جاهل) با جهل خود، سرهای دیگران را بریده و آسیب زده است."],[533,"این به تقدیر سخن گفتم ترا","ورنه خود دستش کجا و آن کجا","این جمله را به خاطر تقدیر و سرنوشت گفتم، وگرنه او چگونه می‌تواند با دستش به چیزی دست یابد در حالی که موضوع بسیار فراتر از توانایی‌های اوست."],[533,"خاله را خایه بدی خالو شدی","این به تقدیر آمدست ار او بدی","اگر به خواهر (خاله) آسیب برسانی، خودت هم به همان اندازه آسیب می‌بینی و این موضوع به سرنوشت مربوط می‌شود، اگر او (خواهر) آسیب می‌دید."],[533,"از زبان تا چشم کو پاک از شک ست","صد هزاران ساله گویم اندکست","تا زمانی که زبان نتواند به درستی از شک و تردید پاک شود، حتی اگر صد هزار سال بگذرد، باز هم کم و ناچیز خواهد بود."],[533,"هین مشو نومید نور از آسمان","حق چو خواهد می‌رسد در یک زمان","هرگز ناامید نشو چرا که نور الهی از آسمان همواره می‌تابد و به محض اینکه بخواهد، به زمین می‌رسد."],[533,"صد اثر در کانها از اختران","می‌رساند قدرتش در هر زمان","قدرت الهی در هر زمان آثار زیادی مانند ستاره‌ها را به عالم هستی می‌رساند."],[533,"اختر گردون ظلم را ناسخست","اختر حق در صفاتش راسخست","در این بیت، به دو نوع اختر (ستاره) اشاره شده است. اختر گردون که نشانه‌ای از ظلم است، به خاطر قدرتی که در ظلم و فساد دارد، و اختر حق که نمایانگر صفات نیک و راستین است و در وجود خود ثابت و راسخ است. به طور کلی، اشاره به تقابل بین ظلم و حق دارد."],[533,"چرخ پانصد ساله راه ای مستعین","در اثر نزدیک آمد با زمین","زمانی که سیاره زحل به مدت پانصد سال در حرکت است، چرخش آن به این صورت است که به زمین نزدیک می‌شود و بر این اساس تأثیر خاصی بر آن دارد."],[533,"سه هزاران سال و پانصد تا زحل","دم بدم خاصیتش آرد عمل","عمل و کار و تلاش انسان، با کارکرد سیاره زحل که نشان‌دهنده محدودیت‌هاست، رابطه‌ای نزدیک و تاثیرگذار دارد. زحل، که نماد زمان و محدودیت‌هاست، هر لحظه خاصیتی را به آنچه انجام می‌دهیم می‌افزاید."],[533,"در همش آرد چو سایه در ایاب","طول سایه چیست پیش آفتاب","در این بیت اشاره به این است که سایه وقتی که خورشید (آفتاب) می‌آید، در واقع در هم می‌رود و ناپدید می‌شود. در واقع، طول سایه به معنای وجود سایه در غیاب نور آفتاب است و با آمدن آفتاب، سایه از بین می‌رود."],[533,"وز نفوس پاک اختروش مدد","سوی اخترهای گردون می‌رسد","از نفوس پاک و نی‌های راستین، یاری و کمک به سوی ستاره‌های آسمان می‌رسد."],[533,"ظاهر آن اختران قوام ما","باطن ما گشته قوام سما","ظاهر آن ستاره‌ها (اختران) دلیل است بر وجود ما، در حالی‌که باطن ما (حقیقت ما) سبب وجود آسمان است."],[534,"پس به صورت عالم اصغر توی","پس به معنی عالم اکبر توی","انسان به لحاظ ظاهر، موجودی کوچک و محدود به نظر می‌رسد، اما از نظر باطنی و معنوی، تجلی‌دهنده‌ی نظام بزرگ‌تر و حقیقت‌های عمیق‌تری است."],[534,"ظاهر آن شاخ اصل میوه است","باطنا بهر ثمر شد شاخ هست","ظاهر شاخ درخت، نمایانگر میوه است، اما در باطن، این شاخ برای باروری و تولید ثمر ایجاد شده است."],[534,"گر نبودی میل و اومید ثمر","کی نشاندی باغبان بیخ شجر","اگر تمایل و امید به میوه و ثمر وجود نداشت، باغبان هرگز ریشه درخت را نمی‌کاشت."],[534,"پس به معنی آن شجر از میوه زاد","گر به صورت از شجر بودش ولاد","شجر (درخت) به میوه‌اش معروف است و اگر میوه‌ای وجود داشته باشد، نشان‌دهنده‌ی زاده‌شدنش از درخت است؛ بنابراین اگر آدمی به شکل انسان به دنیا آمده، نشان از این است که حقیقت او نیز از یک دانش و وجود عالی‌تر و برتر ناشی می‌شود."],[534,"مصطفی زین گفت که آدم و انبیا","خلف من باشند در زیر لوا","مصطفی (پیامبر اسلام) گفته است که آدم و پیامبران (انبیا) جانشین او هستند و در زیر پرچم (لوا) او قرار دارند."],[534,"بهر این فرموده است آن ذو فنون","رمز نحن اخرون السابقون","این جمله اشاره به این دارد که آن کسی که در علوم مختلف دارای دانش و مهارت است، به نوعی با پیشینیان و بزرگ‌ترها در علم و دانش مرتبط است و به تعبیری نشان می‌دهد که ما هم در زمره کسانی هستیم که پیشتر از ما علم و تجربه را کسب کرده‌اند."],[534,"گر بصورت من ز آدم زاده‌ام","من به معنی جد جد افتاده‌ام","اگرچه من از نظر ظاهر و شکل، انسان هستم و از نسل آدم به وجود آمده‌ام، اما از نظر معنوی و باطن، به حقیقتی بزرگ‌تر و عمیق‌تر از نیاکانم وابسته‌ام."],[534,"کز برای من بدش سجده ملک","وز پی من رفت بر هفتم فلک","سجده ملائکه به خاطر من است، و به دنبال من به آسمان هفتم رفتند."],[534,"پس ز من زایید در معنی پدر","پس ز میوه زاد در معنی شجر","انسان از من (خدا) متولد می‌شود، مانند اینکه پدر از فرزند زاده می‌شود. همچنین، درخت از میوه‌اش به وجود می‌آید که نشان‌دهنده ارتباط و وابستگی بین ریشه و میوه است."],[534,"اول فکر آخر آمد در عمل","خاصه فکری کو بود وصف ازل","فکر اولیه که در نهایت منجر به عمل می‌شود، به ویژه فکری که توصیف کننده ازلیت (بی‌زمانی) است، در اینجا مد نظر است. یعنی، در ابتدا، یک اندیشه جاودانه وجود دارد که بر تمامی اعمال و کارها تأثیر می‌گذارد."],[534,"حاصل اندر یک زمان از آسمان","می‌رود می‌آید ایدر کاروان","در یک لحظه، همه‌ی رخدادها از آسمان به زمین می‌آید و می‌رود، مانند کاروانی که از جایی به جایی سفر می‌کند."],[534,"نیست بر این کاروان این ره دراز","کی مفازه زفت آید با مفاز","در این ابیات اشاره شده که در این کاروان (زندگی و سفر آدمی) این مسیر طولانی نیست و لزومی ندارد که هر کسی به مقصد نهایی برسد، زیرا رسیدن به هدف به آسانی امکان‌پذیر نیست و نیاز به تلاش صحیح دارد."],[534,"دل به کعبه می‌رود در هر زمان","جسم طبع دل بگیرد ز امتنان","دل در هر زمانی به سوی کعبه (مکان مقدس) می‌رود، اما جسم و طبیعت انسان از درک این معنای بلند و عمیق بی‌بهره می‌ماند و تنها به دنیا و ظواهر آن می‌چسبد."],[534,"این دراز و کوتهی مر جسم راست","چه دراز و کوته آنجا که خداست","اینکه طول و کوتاهی جسم تنها مربوط به دنیای مادی است و در حقیقت، زمانی که به خدا بر می‌رسیم، دیگر این اندازه‌گیری‌ها معنایی ندارند."],[534,"چون خدا مر جسم را تبدیل کرد","رفتنش بی‌فرسخ و بی‌میل کرد","زمانی که خداوند جسم (آدمی) را دگرگون کرد، حرکت او را بدون فاصله و بدون هیچ‌گونه تمایلی ساخت، به گونه‌ای که گویا او در هیچ مکانی قرار ندارد."],[534,"صد امیدست این زمان بردار گام","عاشقانه ای فتی خل الکلام","در این بیت، شاعر به شخصی می‌گوید که در این زمان، صد امید وجود دارد و باید با عشق و شجاعت گام بردارد، همچون فرزند جوانی که سخن جدیدی می‌گوید. این تعبیر به تلاشی پرشور و اشتیاق برای دستیابی به آرزوها اشاره دارد."],[534,"گرچه پله چشم بر هم می‌زنی","در سفینه خفته‌ای ره می‌کنی","هرچند با بستن چشم در حالتی شبه خواب (یا غفلت) به نظر می‌رسد که گام برمی‌دارید، اما در واقع در کشتی (سفینه) خوابیده‌اید و در این حالت راه و هدفی نمی‌یابید."],[535,"بهر این فرمود پیغامبر که من","هم‌چو کشتی‌ام به طوفان زمن","پیامبر به این دلیل فرمود که من نیز مانند کشتی هستم در میان طوفان‌های زمان."],[535,"ما و اصحابم چو آن کشتی نوح","هر که دست اندر زند یابد فتوح","ما و پیروانم مانند کشتی نوح هستیم؛ هر کس که به ما متصل شود، به رستگاری (نجات) می‌رسد."],[535,"چونک با شیخی تو دور از زشتیی","روز و شب سیاری و در کشتیی","هر زمان که با یک استاد و عارف در ارتباط هستی، از زشتی‌ها دوری و در حالی که روز و شب در حال سفر و حرکت هستی، در این کشتی (کشتی نور و هدایت) قرار داری."],[535,"در پناه جان جان‌بخشی توی","کشتی اندر خفته‌ای ره می‌روی","تو در کشتی نجاتی که در آن به سر می‌بری، به امنیت و آرامش روحی دست یافته‌ای و با این حال، در حال حرکت به سمت هدف و راهی صحیح هستی."],[535,"مسکل از پیغامبر ایام خویش","تکیه کم کن بر فن و بر کام خویش","ای پیامبر (محمد) را به یاد داشته باش و به او تکیه کن و بر دانش و خواسته‌های خود تکیه نکن، زیرا این مسیر شما را به مقصد نمی‌رساند."],[535,"گرچه شیری چون روی ره بی‌دلیل","خویش‌بین و در ضلالی و ذلیل","هرچند که شخصی مانند شیر، در مسیر خود با اطمینان و بدون دلیل حرکت می‌کند، اما او تهی از حقیقت و در حال گمراهی و ذلالت است."],[535,"هین مپر الا که با پرهای شیخ","تا ببینی عون و لشکرهای شیخ","فقط به شیخ نگاه کن و با او پرواز کن تا بتوانی یاری و لشکر او را ببینی."],[535,"یک زمانی موج لطفش بال تست","آتش قهرش دمی حمال تست","یک زمانی، موج محبت و رحمت خداوند تو را بالا می‌برد و در زمانی دیگر، عذاب و قهر او تو را به زمین می‌زند."],[535,"قهر او را ضد لطفش کم شمر","اتحاد هر دو بین اندر اثر","قهر خداوند را نباید کمتر از لطف او دانست؛ زیرا این دو حالت، تأثیراتی مشترک دارند و در حقیقت، هر دو بخشی از ذات او هستند."],[535,"یک زمان چون خاک سبزت می‌کند","یک زمان پر باد و گبزت می‌کند","گاهی تو را همچون خاک، سرسبز و زنده می‌کند و زمانی دیگر، همچون توده‌ای گرد و غبار، بی‌تحرک و خشک می‌سازد."],[535,"جسم عارف را دهد وصف جماد","تا برو روید گل و نسرین شاد","عارف مانند یک جسم بی‌روح به نظر می‌رسد تا زمانی که درون او احساسات و ویژگی‌های عالی و روحانی (مانند گل و نسرین) شکفتی و زندگی و سرزندگی در او جوانه بزند."],[535,"لیک او بیند نبیند غیر او","جز به مغز پاک ندهد خلد بو","انسان عارف فقط خداوند را می‌بیند و جز او چیزی را نمی‌نگرد. او که دلش پاک و خالی از هرگونه انکار باشد، می‌تواند زندگی واقعی و خوشبو را تجربه کند."],[535,"مغز را خالی کن از انکار یار","تا که ریحان یابد از گلزار یار","خود را از انکار و کفران محبت خدا خالی کن تا بتوانی خوشبو و معطر از لطافت و زیبایی خدا بهره‌مند شوی."],[535,"تا بیابی بوی خلد از یار من","چون محمد بوی رحمن از یمن","برای اینکه بوی بهشت را از یار من حس کنی، باید مانند محمد (پیامبر اسلام) بوی رحمت و خشنودی خدا را از یمن (کشور زادگاه او) استشمام کنی."],[535,"در صف معراجیان گر بیستی","چون براقت بر کشاند نیستی","اگر در صف معراجیان قرار بگیری، مانند اسب خوب و سریع و باارزش نیستی، بلکه در واقع از وجود خود تهی هستی و فقط به شوق وجود آن‌ها و در پی پیوستن به آن‌ها هستی."],[535,"نه چو معراج زمینی تا قمر","بلک چون معراج کلکی تا شکر","این‌جا اشاره به این است که معراج (صعود) انسانی به عالم بالا، مانند معراج مادی نیست که به قمر (ماه) ختم شود، بلکه باید آن‌چنان باشد که به معنای واقعی و روحانی برسد و مانند خوشبو شدن شکر (نماد شیرینی و لطافت) باشد. یعنی در این حالت، صعود روحی و معنوی به مقصدی بالاتر و زیباتر می‌انجامد."],[535,"نه چو معراج بخاری تا سما","بل چو معراج جنینی تا نهی","این بیت به این معناست که معراج برخی از موجودات، مانند بخار، به آسمان نمی‌رسد، بلکه مانند معراج موجودات جنینی است که به حیات و وجود کامل نرسیده‌اند و در مراحل ابتدایی هستند."],[535,"خوش براقی گشت خنگ نیستی","سوی هستی آردت گر نیستی","اگر در حالتی از نادانی و بی‌خبری هستی، باید به حقیقت و وجود بپیوندی، زیرا این وجود و هستی می‌تواند تو را از آن حالت بی‌هویتی خارج کند و به سوی کمال و آگاهی هدایت نماید."],[535,"کوه و دریاها سمش مس می‌کند","تا جهان حس را پس می‌کند","این بیت بیان می‌کند که کوه‌ها و دریاها با قدرت و تاثیر خود، حس و دنیا را از افراد دور می‌کنند و آن‌ها را به سوی معنویت و حقیقت بالاتر هدایت می‌کنند."],[535,"پا بکش در کشتی و می‌رو روان","چون سوی معشوق جان جان روان","در این بیت به این موضوع اشاره شده که با تلاش و حرکت به سمت عشق و معشوق، روح و جان از قید و بندها رها می‌شود و به سوی کمال و زندگی واقعی روان می‌گردد. به نوعی تشبیه شده است به در رفتن از خطر در کشتی نوح، که نجات تنها در پیوستن به آن‌جاست."],[535,"دست نه و پای نه رو تا قدم","آن چنانک تاخت جانها از عدم","برای رسیدن به مقام و معنای والای انسانی، تنها به دست و پا بسنده نکن، بلکه به اندازه‌ای پیش برو که جان‌ها از وجود و عدم عبور کنند و به حقیقت برسند."],[535,"بردریدی در سخن پرده قیاس","گر نبودی سمع سامع را نعاس","در سخن خود، پرده قیاس را پاره کردید، زیرا اگر نبودید، گوش شنونده به خواب می‌رفت و نمی‌شنید."],[535,"ای فلک بر گفت او گوهر ببار","از جهان او جهانا شرم دار","ای آسمان، بر اساس گفتۀ او، گوهرها را از عالم بر زمین ببار، زیرا در برابر عالم او، یعنی خداوند، دنیا باید شرم کند."],[535,"گر بباری گوهرت صد تا شود","جامدت بیننده و گویا شود","اگر گوهر تو باران بگیرد، ارزش آن به صد برابر می‌رسد و تو را درک کردنی واضح و نمایان می‌سازد."],[535,"پس نثاری کرده باشی بهر خود","چونک هر سرمایه تو صد شود","تو برای خود نثری (هدیه، بخشش) کرده‌ای، زیرا هر سرمایه و ثروتی که داری، در اثر آن بخشش، چند برابر می‌شود."],[536,"هدیه بلقیس چل استر بدست","بار آنها جمله خشت زر بدست","بلقیس، ملکه سبا، به سلیمان علیه‌السلام هدیه‌ای شامل چهل استر را فرستاد که آنان بار خشت‌های طلا را به دوش داشتند."],[536,"چون به صحرای سلیمانی رسید","فرش آن را جمله زر پخته دید","وقتی به سرزمین سلیمان رسید، همه فرش‌ها را از طلا و زر پخته (به‌طرز ظریفی) مشاهده کرد."],[536,"بر سر زر تا چهل منزل براند","تا که زر را در نظر آبی نماند","برای اینکه زر را در نظر کسی دیده نشود، باید آن را تا چهل منزل جابه‌جا کنند و دقیقا نگه‌داری کنند."],[536,"بارها گفتند زر را وا بریم","سوی مخزن ما چه بیگار اندریم","بارها توصیه کردند که طلا را به سمت مخزن ما ببریم، اما ما چرا این کار را بکنیم و خود را به زحمت بیندازیم؟"],[536,"عرصه‌ای کش خاک زر ده دهیست","زر به هدیه بردن آنجا ابلهیست","در جایی که خاک است، بردن طلا و زر برای هدیه معنا ندارد و این کار نادانی است."],[536,"ای ببرده عقل هدیه تا اله","عقل آنجا کمترست از خاک راه","ای کسی که عقل تو را فرستاده‌ات کرده، هدیه‌ای ببر به آنجا، چون در آن مکان عقل خدایی که حاکم است، کمتر از خاک راه (یعنی بی‌ارزش) است."],[536,"چون کساد هدیه آنجا شد پدید","شرمساریشان همی واپس کشید","زمانی که هدیه به‌خاطر کاهش ارزشش در نظر سلیمان مشخص شد، شرم و خجالت آنها آنها را عقب نشینی داد."],[536,"باز گفتند ار کساد و ار روا","چیست بر ما بنده فرمانیم ما","آن‌ها دوباره گفتند که اگر هدیه کساد و ناچیز باشد یا اینکه خوب و رواج داشته باشد، ما به هر حال بندگان (سلیمان) هستیم و باید طبق فرمان او عمل کنیم."],[536,"گر زر و گر خاک ما را بردنیست","امر فرمان‌ده به جا آوردنیست","اگر چه طلا یا خاک در دست ما باشد، برای ما مهم نیست، بلکه فقط فرمان فرمانده است که باید اجرا شود."],[536,"گر بفرمایند که واپس برید","هم به فرمان تحفه را باز آورید","اگر دستور بدهند که چیزی را به عقب برگردانید، باید به فرمان آن هدیه را دوباره بیاورید."],[536,"خنده‌ش آمد چون سلیمان آن بدید","کز شما من کی طلب کردم ثرید","سلیمان وقتی هدیه بلقیس را دید، خندید و گفت: از شما چیزی نمی‌خواستم که این غذا (ثرید) را درخواست کنم."],[536,"من نمی‌گویم مرا هدیه دهید","بلک گفتم لایق هدیه شوید","من به شما نمی‌گویم که هدیه‌ای به من بدهید، بلکه می‌گویم خودتان شایسته و لایق دریافت هدیه‌ای هستید."],[536,"که مرا از غیب نادر هدیه‌هاست","که بشر آن را نیارد نیز خواست","هدیه‌هایی از عالم غیب برای من وجود دارد که انسان‌ها حتی فکرش را هم نمی‌کنند که چنین چیزهایی را بخواهند."],[536,"می‌پرستید اختری کو زر کند","رو باو آرید کو اختر کند","او (بلقیس) ستاره‌ای را می‌پرستید که با زر و طلا درخشان می‌شود و کسی را به نزد او می‌آورد که همچون آن ستاره درخشان و آموزگار است."],[536,"می‌پرستید آفتاب چرخ را","خوار کرده جان عالی‌نرخ را","آفتاب را می‌پرستیدند و به همین دلیل، جان باارزش و باکیفیت خود را خوار کرده بودند."],[536,"آفتاب از امر حق طباخ ماست","ابلهی باشد که گوییم او خداست","خورشید تنها به فرمان و اراده خدا روشن می‌شود و کسی که بگوید خورشید خداست، نادان و احمق است."],[536,"آفتابت گر بگیرد چون کنی","آن سیاهی زو تو چون بیرون کنی","اگر خورشید را بگیری و از نورش محروم کنی، آن تاریکی که از آن ناشی می‌شود، تو را از نور و روشنایی دور خواهد کرد."],[536,"نه به درگاه خدا آری صداع","که سیاهی را ببر وا ده شعاع","تو در درگاه خداوند شکایت نکن که از مشکلات برطرف شدن، مثل این می‌ماند که باید ابتدا تاریکی را کنار بگذاری تا نور بتابد."],[536,"گر کشندت نیم‌شب خورشید کو","تا بنالی یا امان خواهی ازو","اگر در نیمه‌شب تو را بکشند، خورشید کجاست که به او نالنی یا از او خواهش امان کنی؟"],[536,"حادثات اغلب به شب واقع شود","وان زمان معبود تو غایب بود","بسیاری از حوادث در شب رخ می‌دهد و در آن زمان، پروردگار تو از دیدگان پنهان است."],[536,"سوی حق گر راستانه خم شوی","وا رهی از اختران محرم شوی","اگر به‌سوی خدا با نیت درست و خالصانه خم شوی و از ستارگان (یعنی مادیات و تعلقات دنیوی) رها گردی، به مقام نزدیکی و آگاهی از حق رستگار خواهی شد."],[536,"چون شوی محرم گشایم با تو لب","تا ببینی آفتابی نیم‌شب","وقتی که محرم رازها شوی، من با تو سخن می‌گویم و درهای دانش را به روی تو باز می‌کنم تا بتوانی نوری را که در تاریکی شب منتشر می‌شود، ببینی."],[536,"جز روان پاک او را شرق نه","در طلوعش روز و شب را فرق نه","جز روح و نفس پاک خدا، هیچ چیز دیگری نمی‌تواند مانند طلوع خورشید، روز و شب را از هم جدا کند."],[536,"روز آن باشد که او شارق شود","شب نماند شب چو او بارق شود","روز زمانی خواهد بود که او (سلیمان) نورافشانی کند و شب نمی‌ماند، چرا که وقتی او درخشان شود، شب نیز روشنایی خواهد یافت."],[536,"چون نماید ذره پیش آفتاب","هم‌چنانست آفتاب اندر لباب","هر گاه که ذره‌ای در برابر آفتاب ظاهر می‌شود، آن ذره نیز به مانند آفتاب در لباسی از نور جلوه می‌کند."],[536,"آفتابی را که رخشان می‌شود","دیده پیشش کند و حیران می‌شود","وقتی آفتاب درخشان و تابناک را می‌بینی، چشمانت به‌خودش جذب می‌شود و از زیبایی‌اش حیرت‌زده می‌شوی."],[536,"هم‌چو ذره بینیش در نور عرش","پیش نور بی حد موفور عرش","چنان که ذره‌ای در نور عرش، پیش نور بی‌پایان و پراکنده عرش دیده می‌شود."],[536,"خوار و مسکین بینی او را بی‌قرار","دیده را قوت شده از کردگار","خداوند، او (بلقیس) را در حالتی ضعیف و بی‌قرار می‌بیند، در حالی که چشم او به‌خاطر توجه به خداوند و قدرت او به قوت و توانایی رسیده است."],[536,"کیمیایی که ازو یک ماثری","بر دخان افتاد گشت آن اختری","کیمیای (طلای) خاصی که از آن، تأثیری بر بخار (دخان) ناشی شد، باعث تبدیل آن بخار به ستاره‌ای درخشان گردید."],[536,"نادر اکسیری که از وی نیم تاب","بر ظلامی زد به گردش آفتاب","ماده نادری که از آن یک نوع نور و روشنی به ظلمت و تاریکی می‌تاباند، مانند تابش آفتاب در دوران خود."],[536,"بوالعجب میناگری کز یک عمل","بست چندین خاصیت را بر زحل","عجب از میناگری که با یک عمل، چندین خاصیت را به زحل (سیاره‌ی زحل) می‌دهد. این اشاره به هنر و مهارت میناگر دارد که توانسته است با مهارت خود اثرات مختلفی ایجاد کند."],[536,"باقی اخترها و گوهرهای جان","هم برین مقیاس ای طالب بدان","ای طالب و جوینده، باقی ستاره‌ها و جواهرهای معنوی (امور روحانی) نیز بر پایه و مقیاسی مشابه اندازه‌گیری می‌شوند."],[536,"دیده حسی زبون آفتاب","دیده ربانیی جو و بیاب","چشم‌های حسی و مادی انسان همچون موجودی ضعیف و زبون در برابر نور و روشنایی آفتاب هستند، اما چشم دل و روح باید به درک و مشاهده حقایق ربانی بپردازد و درپی آن برآید."],[536,"تا زبون گردد به پیش آن نظر","شعشعات آفتاب با شرر","برای رسیدن به درک بالاتر و دیدن تجلیات الهی، باید از دیدگاه محدود و مادی خود بازگردیم، چون جلوه‌های معنوی مانند نور خورشید با شدت و صفای خود، دید ما را تحت تأثیر قرار می‌دهند و ما را از ضعف و ناتوانی مادی خود دور می‌کنند."],[536,"که آن نظر نوری و این ناری بود","نار پیش نور بس تاری بود","نظر بلقیس (ملکه سبا) نوری است درخشان و استثنایی، در حالی‌که آتش (نار) به‌مثابه تاریکی و کدرکننده‌ای است که در مقابل نور قرار می‌گیرد. به عبارتی دیگر، نور ناشی از نظر او بسیار برتر از آتش است که تنها تاریکی به همراه دارد."],[537,"گفت عبدالله شیخ مغربی","شصت سال از شب ندیدم من شبی","عبدالله شیخ مغربی می‌گوید که او در طول شصت سال، هیچ شبی را تاریک و ظلمانی ندیده است."],[537,"من ندیدم ظلمتی در شصت سال","نه به روز و نه به شب نه ز اعتلال","من در شصت سالی که گذراندم، هرگز تاریکی‌ای را ندیدم، نه در روز و نه در شب، و نه به خاطر حالتی ناخوش."],[537,"صوفیان گفتند صدق قال او","شب همی‌رفتیم در دنبال او","صوفیان می‌گویند: حقیقت کلام او را درک کردیم و در شب‌های تار، همیشه در پی او بودیم."],[537,"در بیابانهای پر از خار و گو","او چو ماه بدر ما را پیش‌رو","شیخ عبدالله مغربی در بیابان‌های پر از خار و سختی مانند ماهی کامل (بدر) برای ما راهنمایی می‌کرد و ما را جلو می‌برد."],[537,"روی پس ناکرده می‌گفتی به شب","هین گو آمد میل کن در سوی چپ","او که بر اثر حرکت در بیابان ناهموار، به چپ متمایل شده و قبل از آن به راست می‌رفت، در دل شب به دنبال یک راهنما به سوی چپ حرکت کرد، به این منظور که به بهترین مسیر برسد."],[537,"باز گفتی بعد یک دم سوی راست","میل کن زیرا که خاری پیش پاست","پس از مدتی، دوباره گفتی که به سمت راست برو، زیرا که خار یا دشواری‌ای در برابر پای تو قرار دارد."],[537,"روز گشتی پاش را ما پای‌بوس","گشته و پایش چو پاهای عروس","شیخ عبدالله مغربی در روزی با دوستانش به زیارت می‌رود و به احترام او، همه به زمین زانو زده و پای او را می‌بوسند، مانند اینکه عروس را گرامی می‌دارند."],[537,"نه ز خاک و نه ز گل بر وی اثر","نز خراش خار و آسیب حجر","هیچ تأثیری از خاک و گل بر او نیست و نه از خراش‌ها و آسیب‌هایی که از خار و سنگ به وجود می‌آید."],[537,"مغربی را مشرقی کرده خدای","کرده مغرب را چو مشرق نورزای","خداوند شیخ عبدالله مغربی را به روشنایی و نور تبدیل کرده است، به‌طوری که او را از مغرب به مشرق برده و نورانی کرده است."],[537,"نور این شمس شموسی فارس است","روز خاص و عام را او حارس است","نور این خورشید، خورشید ایرانی (یا فارس) است و او، نگهبان روزها برای همگان است."],[537,"چون نباشد حارس آن نور مجید","کو هزاران آفتاب آرد پدید","اگر آن نور بزرگ و قدسی که هزاران آفتاب را به درستی به نمایش می‌گذارد، محافظی نداشته باشد، دیگر هیچ چیز به درستی نمایان نمی‌شود."],[537,"تو به نور او همی رو در امان","در میان اژدها و کژدمان","تو به نور خداوند (نور مجید) روی و در امان هستی، حتی در میان موجودات خطرناکی مانند اژدها و مارهای کژدم."],[537,"پیش پیشت می‌رود آن نور پاک","می‌کند هر ره‌زنی را چاک‌چاک","نور پاکی که به جلو می‌آید، باعث می‌شود که هر دزد و راهزنی، از آسیب و زیان دور شود و به سلامت عبور کند."],[537,"یوم لا یخزی النبی را راست دان","نور یسعی بین ایدیهم بخوان","روزی خواهد آمد که پیامبر (ص) در آن روز شرمنده نخواهد شد و نور ایمان در پیش روی مردم خواهد درخشید."],[537,"گرچه گردد در قیامت آن فزون","از خدا اینجا بخواهید آزمون","هرچند در قیامت چیزهایی فراتر از قدرت خداوند اتفاق می‌افتد، اما در این دنیا از او طلب کنید و آزمایش کنید."],[537,"کو ببخشد هم به میغ و هم به ماغ","نور جان والله اعلم بالبلاغ","خداوند می‌تواند به انسان‌ها هم از شوق و عطوفت (میغ) و هم از قهر و خشونت (ماغ) نور و روشنی بخشید، و این امر به علم و اراده او بستگی دارد."],[538,"باز گردید ای رسولان خجل","زر شما را دل به من آرید دل","ای رسولان، با حالتی شرمنده و خجالت‌زده برگردید و به جای این زر و اموال، دل‌های خود را به من بدهید."],[538,"این زر من بر سر آن زر نهید","کوری تن فرج استر را دهید","این طلا را بر روی آن طلا بگذارید تا کوری و بی‌نوری تن کم‌کم برطرف شود و در واقع معنای آن به روشنی گراید."],[538,"فرج استر لایق حلقه زرست","زر عاشق روی زرد اصفرست","فرج استر (دمی که در آن زندگی و امید به امیدها می‌رسد) شایسته حلقه زر است، در حالی که زر به عشق به چهره زرد و رنگ‌پریده محبوب اشاره دارد."],[538,"که نظرگاه خداوندست آن","کز نظرانداز خورشیدست کان","این بیت به این اشاره دارد که آنچه خداوند مشاهده می‌کند و بر آن نظر دارد، از نور و روشنی خورشید نیز فراتر است. در واقع، دید خداوند برتر و عمیق‌تر از هر نوری است که می‌توان تصور کرد."],[538,"کو نظرگاه شعاع آفتاب","کو نظرگاه خداوند لباب","کجاست نظرگاه که همانند شعاع آفتاب، نظر خداوند بر آن می‌تابد؟"],[538,"از گرفت من ز جان اسپر کنید","گرچه اکنون هم گرفتار منید","من از سپرنندگی و پناهندگی جانم به شما غمگین هستم، هرچند که اکنون هم به دام من افتاده‌اید."],[538,"مرغ فتنه دانه بر بامست او","پر گشاده بسته دامست او","مرغ فتنه به معنای آزار و وسوسه در حال پرواز بر بام است، اما درواقع دانه‌ای که می‌بیند باعث شده که دام بسته شده باشد و او را به دام بیندازد. اینجا اشاره به این است که در ظاهر، چیزی جذاب به نظر می‌رسد، اما در حقیقت ممکن است فریب‌دهنده باشد و باعث افتادن در دام شود."],[538,"چون به دانه داد او دل را به جان","ناگرفته مر ورا بگرفته دان","چون دل او را به دانه (چرخه فریب) داد، جانش را از او نگرفت، دانایی و حکمت را به دست آورد و گرفته شد."],[538,"آن نظرها که به دانه می‌کند","آن گره دان کو به پا برمی‌زند","نگاه‌هایی که به دانه (حبت یا شیرینی) می‌شود، همان گره‌ای است که فرد می‌تواند بر پا زند و به زندگی و کارهای خود مشغول شود. اینجا به شدت وابستگی انسان به جذابیت‌ها و لذت‌های دنیوی اشاره دارد."],[538,"دانه گوید گر تو می‌دزدی نظر","من همی دزدم ز تو صبر و مقر","دانه (به عنوان نماد روح یا قلب) می‌گوید اگر تو به من نگاه بد کنی و مرا بدزدی، من نیز از تو صبر و آرامش را می‌دزدم."],[538,"چون کشیدت آن نظر اندر پیم","پس بدانی کز تو من غافل نیم","وقتی که نگاه تو مرا جلب کند، بفهمی که من به تو بی‌توجه نیستم و غافل نیستم."],[539,"پیش عطاری یکی گل‌خوار رفت","تا خرد ابلوج قند خاص زفت","مردی که عاشق گل (گل و گیاه) بود، نزد عطاری رفت تا قند خاص و شیرینی گران‌قیمتی را بخرد. او برای این کار به عطاری مراجعه کرد و نیتش خرید شیرینی بود."],[539,"پس بر عطّار طرّار دودل","موضع سنگ ترازو بود گل","در این بیت، مولانا به عطاری اشاره می‌کند که به همان اندازه که تردید دارد، سنگ ترازویش نیز محل و موضعی است که گل است. این نشان‌دهنده عدم ثبات و بی‌پایه بودن کار عطّار در مقایسه با واقعیت است."],[539,"گفت گل سنگ ترازوی منست","گر ترا میل شکر بخریدنست","عطار می‌گوید که گل سنگ ترازوی اوست؛ یعنی ترازوی او سنگینی و اعتبار ندارد و اگر تو بخواهی شکر بخری، باید از این سنگ رنج بکشید و به هدف خود برسید."],[539,"گفت هستم در مهمی قندجو","سنگ میزان هر چه خواهی باش گو","گفت من در کار مهمی هستم و به دنبال قند هستم، تو بگو هر چیزی که بخواهی را اندازه می‌زنم."],[539,"گفت با خود پیش آن‌که گل‌خورست","سنگ چه بود گل نکوتر از زرست","او با خود می‌گوید که در برابر کسی که از گل (مواد اولیه) می‌خورد، سنگ چه ارزشی دارد؟ زیرا گل از طلا هم بهتر و نیکوتر است."],[539,"هم‌چو آن دلّاله که گفت ای پسر","نو عروسی یافتم بس خوب‌فرّ","مانند آن دلالی که گفت ای پسر، من عروسی یافتم که خیلی زیبا و خوش‌فر است."],[539,"سخت زیبا لیک هم یک چیز هست","کان ستیره دختر حلواگرست","دختر حلواگر (نانی که شیرینی درست می‌کند) خیلی زیباست اما یک نکته وجود دارد که او کلاهی دارد. در اینجا اشاره به این است که زیبایی ظاهری یک نکته‌ی منفی یا عیب دارد."],[539,"گفت بهتر این چنین خود گر بود","دختر او چرب و شیرین‌تر بود","می‌گوید اگر دخترش هم این‌گونه باشد، بهتر است؛ زیرا او خود (دختر) از نظر شیرینی و مطلوبیت، چرب‌تر و خوشمزه‌تر خواهد بود."],[539,"گر نداری سنگ و سنگت از گلست","این به و به گل مرا میوه‌ی دلست","اگر سنگی نداری و سنگت از گل درست شده، این گل و زیبایی برای من میوه‌ای محبوب و دوست‌داشتنی است."],[539,"اندر آن کفه‌ی ترازو ز اعتداد","او به جای سنگ آن گل را نهاد","در کفه‌ی ترازو به جای سنگ که به عنوان وزنه استفاده می‌شود، گل را گذاشتند تا نشان‌دهنده بی‌ارزشی آن باشد."],[539,"پس برای کفه‌ی دیگر به دست","هم به قدر آن شکر را می‌شکست","عطاری که در کفه‌ی ترازو به جای سنگ، گل گذاشته بود، حالا برای اینکه ترازویش به‌درستی کار کند، در کفه‌ی دیگر به اندازه‌ی همان شکر گل را می‌شکست."],[539,"چون نبودش تیشه‌ای او دیر ماند","مشتری را منتظر آنجا نشاند","چون او (عطار) تیشه‌ای نداشت، مدت زیادی در آنجا منتظر ماند تا مشتری (خریدار) را ببیند."],[539,"رویش آن سو بود گل‌خور ناشکفت","گل ازو پوشیده دزدیدن گرفت","مشتری که به سمت او (عطار) بوده، در حالتی بود که از نشانه‌های عشق و محبت بی‌بهره مانده و احساس نمی‌کند به خاطر گلی که بر دوش اوست، به سمت عطار می‌آید. در این لحظه، او در حال دزدیدن چیزی است."],[539,"ترس ترسان که نباید ناگهان","چشم او بر من فتد از امتحان","نگران و ترسان باش که ناگهان نگاه او (عطار) به من نیفتد و من مورد آزمایش قرار گیرم."],[539,"دید عطار آن و خود مشغول کرد","که فزون‌تر دزد هین ای روی‌زرد","عطار متوجه شد و خود را مشغول نشان داد تا دزد را بیشتر ترغیب کند که او کمتر مراقب باشد و بیش‌تر دزدی کند."],[539,"گر بدزدی وز گل من می‌بری","رو که هم از پهلوی خود می‌خوری","اگر از من گلی بدزدی و ببری، بدان که خودت هم از کنار خودت می‌خوری، یعنی به خود ضرر می‌زنی."],[539,"تو همی ترسی ز من لیک از خری","من همی‌ترسم که تو کمتر خوری","تو از من می‌ترسی، اما من هم از تو می‌ترسم، چرا که نگرانم تو کمتر از آنچه باید بخوری، بخوری."],[539,"گرچه مشغولم چنان احمق نیم","که شکر افزون کشی تو از نیم","هرچند که من در کار خود بسیار مشغول و جدی هستم، اما به اندازه‌ای هم احمق نیستم که تو از من بیشتر از آنچه هست، سود ببری."],[539,"چون ببینی مر شکر را ز آزمود","پس بدانی احمق و غافل که بود","وقتی که شکر را از روی تجربه ببینی، متوجه می‌شوی که احمق و نادان کیست."],[539,"مرغ زان دانه نظر خوش می‌کند","دانه هم از دور راهش می‌زند","پرنده به خاطر دانه‌ای که از دور می‌بیند به آن نگاه خوشی می‌کند، اما دانه هم از فاصله او را فریب می‌دهد و به سمت خود می‌کشاند."],[539,"کز زنای چشم حظّی می‌بری","نه کباب از پهلوی خود می‌خوری","تو از نگاه کردن به زیبایی‌های دیگران لذت می‌بری و این لذت به اندازه خوردن غذا از پهلوی خودت نیست، بلکه فقط از طریق چشم و نگاه به دست می‌آوری."],[539,"این نظر از دور چون تیرست و سمّ","عشقت افزون می‌شود صبر تو کم","این نگاه از راه دور مانند تیر است و اثر عشق تو را بیشتر می‌کند، در حالی که صبر تو کمتر و کمتر می‌شود."],[539,"مال دنیا دام مرغان ضعیف","ملک عقبی دام مرغان شریف","مال دنیا، وسیله‌ای است برای به دام انداختن انسان‌های ضعیف، ولی ملک آخرت، مکانی است برای گرفتار کردن انسان‌های بزرگ و شریف."],[539,"تا بدین ملکی که او دامست ژرف","در شکار آرند مرغان شگرف","این دنیا مانند دامی عمیق است که پرندگان بزرگ و باارزش را به دام می‌اندازد و در واقع این دنیا به‌عنوان یک میدان شکار برای این مرغان به حساب می‌آید."],[539,"من سلیمان می‌نخواهم ملکتان","بلک من برهانم از هر هلکتان","من نمی‌خواهم مانند سلیمان، که پادشاهی و سلطنت شما را داشته باشد؛ بلکه هدف من این است که شما را از هر زحمتی که به شما آسیب می‌زند، نجات دهم."],[539,"کاین زمان هستید خود مملوک ملک","مالک ملک آن‌که بجهید او ز هلک","اکنون شما خود برده و مملوک کسی هستید که مالک ملک است، و آن مالک کسی است که از این دنیا (هلک) رفته و به حقیقت دست یافته است."],[539,"بازگونه ای اسیر این جهان","نام خود کردی امیر این جهان","تو همچنان اسیر این دنیا هستی، اما نام خود را شاه این جهان گذاشته‌ای."],[539,"ای تو بنده‌ی این جهان محبوس جان","چند گویی خویش را خواجه‌ی جهان","تو که اسیر این دنیایی، چرا خود را آقای جهان می‌دانی؟ بگو مگر چقدر می‌توانی به جان خودت ببالید و بزرگ باشی؟"],[540,"ای رسولان می‌فرستمتان رسول","رد من بهتر شما را از قبول","ای رسولان، من شما را به سوی بلقیس می‌فرستم؛ رسالتی که در مقایسه با قبول هدیه، برایتان بهتر است."],[540,"پیش بلقیس آنچ دیدیت از عجب","باز گویید از بیابان ذهب","آنچه شما از شگفتی‌های خود در برابر بلقیس (ملکه سبا) دیده‌اید، از بیابان‌های طلا (مظاهر جلال و شکوه) برای او تعریف کنید."],[540,"تا بداند که به زر طامع نه‌ایم","ما زر از زرآفرین آورده‌ایم","سلیمان می‌خواهد به بلقیس و دیگران بفهماند که ما به طمع طلا و زر نیامده‌ایم، بلکه این طلا را از آفریدگار زر و طلا به ارمغان آورده‌ایم."],[540,"آنک گر خواهد همه خاک زمین","سر به سر زر گردد و در ثمین","اگر بخواهد، می‌تواند همه خاک زمین را تبدیل به طلا کند و آن را با ارزش و گران‌بها سازد."],[540,"حق برای آن کند ای زرگزین","روز محشر این زمین را نقره گین","در روز محشر، خداوند این زمین را به جای خاکی، به رنگ نقره در می‌آورد و آن را زینت می‌بخشد."],[540,"فارغیم از زر که ما بس پر فنیم","خاکیان را سر به سر زرین کنیم","ما از طلا و زر بی‌نیازیم، چون ما خود پر از هنر و دانش هستیم؛ ما انسان‌های معمولی را از سر تا پا به زر تبدیل می‌کنیم، یعنی آنها را به بالاترین مرتبه‌های کمال و ارزش می‌رسانیم."],[540,"از شما کی کدیه زر می‌کنیم","ما شما را کیمیاگر می‌کنیم","ما از شما به دنبال طلا و زر نیستیم و قصد نداریم که شما را به کیمیاگری، که هنر تبدیل خاک به طلاست، وادار کنیم."],[540,"ترک آن گیرید گر ملک سباست","که برون آب و گل بس ملکهاست","اگرچه سرزمین سبا (یمن) را ترک کند، باز هم باید بداند که خارج از آن دیار، آب و گل‌های بسیاری وجود دارد که سرزمین‌های دیگری را شکل می‌دهد."],[540,"تخته‌بندست آن که تختش خوانده‌ای","صدر پنداری و بر در مانده‌ای","آن‌کس که به خالی بودن تخت سلطنت خود، هنوز خود را پادشاه می‌داند و بر در آن می‌نشیند، در حقیقت زندانی تخته است و شایستگی به عنوان پادشاه را ندارد."],[540,"پادشاهی نیستت بر ریش خود","پادشاهی چون کنی بر نیک و بد","اگر بر خودت پادشاهی می‌کنی، باید بر کارهای خوب و بد خود حاکم باشی، نه فقط بر ظاهر و چیزهای سطحی."],[540,"بی‌مراد تو شود ریشت سپید","شرم دار از ریش خود ای کژ امید","اگر بدون رسیدن به خواسته‌ات، موی سپیدت را ببینی، باید از سپیدی آن خجالت بکشی، ای کسی که امیدت بر اساس نادرست بنا شده است."],[540,"مالک الملک است هر کش سر نهد","بی‌جهان خاک صد ملکش دهد","هر کسی که سر به درگاه خداوند بگذارد و خود را به او تسلیم کند، به او قدرت و فراوانی بیشتری اعطا می‌شود و از این طریق هر نوع نعمت و سلطنتی به او داده خواهد شد."],[540,"لیک ذوق سجده‌ای پیش خدا","خوشتر آید از دو صد دولت ترا","ولی لذت و شادی ناشی از سجده کردن برای خداوند، از داشتن دو صد ملک و سلطنت برای تو دلپذیرتر است."],[540,"پس بنالی که نخواهم ملکها","ملک آن سجده مسلم کن مرا","پس از این همه، به خیال خود بگو که من علاقه‌ای به سلطنت‌ها ندارم و فقط می‌خواهم با سجده‌ام به خداوند، خود را تسلیم کنم."],[540,"پادشاهان جهان از بدرگی","بو نبردند از شراب بندگی","پادشاهان جهان از بویی که به خاطر شراب بندگی و خدمت به خدا می‌آید، آگاهی ندارند و از آن بی‌خبرند."],[540,"ورنه ادهم‌وار سرگردان و دنگ","ملک را برهم زدندی بی‌درنگ","اگر این مهر و محبت الهی نبود، مانند اسب‌های سراسر سیاه و سرگردان، سلطنت و حکومت را بدون تأمل بر هم می‌زدند."],[540,"لیک حق بهر ثبات این جهان","مهرشان بنهاد بر چشم و دهان","اما خداوند به منظور پایداری این دنیا، محبت و مهر را بر چشم و دهان آن‌ها قرار داد."],[540,"تا شود شیرین بریشان تخت و تاج","که ستانیم از جهانداران خراج","برای این‌که زندگی بر این افراد شیرین شود و تاج و تختی داشته باشند، باید خراجی از جهان‌داران بگیریم."],[540,"از خراج ار جمع آری زر چو ریگ","آخر آن از تو بماند مردریگ","اگر از خراج و مالیات، مقدار زیادی طلا جمع کنی، در نهایت همه آن طلاها نیز به تو تعلق نخواهد داشت و در پایان، آنچه می‌ماند فقط گرد و غبار و بی‌ارزشی خواهد بود."],[540,"همره جانت نگردد ملک و زر","زر بده سرمه ستان بهر نظر","جانت را همسفر کن و نه ملک و طلا، زیرا این دنیای مادی بگذارد و چیزی از آن باقی نمی‌ماند. به‌جای طلا، عاقلانه است که از چشم‌نوازی و زیبایی‌های دل‌نشین بهره‌گیری کنی."],[540,"تا ببینی کین جهان چاهیست تنگ","یوسفانه آن رسن آری به چنگ","جهان مانند چاه تنگی است که در آن گرفتار شده‌ایم و برای رهایی از آن باید مثل یوسف، به وسیله‌ی رسن (به معنای کمک یا وسیله) از چنگال آن بیرون بیاییم."],[540,"تا بگوید چون ز چاه آیی به بام","جان که یا بشرای هذا لی غلام","چون از چاه بیرون بیایی و به بلندی جان برسی، صدای احدی را می‌شنوی که می‌گوید: \"این چه بشارتی است که غلامی از چاه بیرون آمده است؟"],[540,"هست در چاه انعکاسات نظر","کمترین آنک نماید سنگ زر","در چاه، تصویرها و انعکاس‌ها دیده می‌شوند و هر سنگی در آنجا می‌تواند به نظر زر براق و قیمتی بیاید."],[540,"وقت بازی کودکان را ز اختلال","می‌نماید آن خزفها زر و مال","در زمان بازی بچه‌ها، وجود چیزهای بی‌ارزش همچون زیورآلات و پول باعث اختلال و حواس‌پرتی می‌شود."],[540,"عارفانش کیمیاگر گشته‌اند","تا که شد کانها بر ایشان نژند","عارفان مانند کیمیاگرانی شده‌اند که به واسطه دانش و شناخت خود، از چیزهای بی‌ارزش و عادی، ارزش و طلا می‌سازند و این حقایق را به دست می‌آورند."],[541,"آن یکی درویش گفت اندر سمر","خضریان را من بدیدم خواب در","یکی از درویشان گفت که در خواب دیدم که در سمر (جایی در یمن) خضریان (نوعی درخت) را."],[541,"گفتم ایشان را که روزی حلال","از کجا نوشم که نبود آن وبال","گفتم به آن درویشان که از کجا می‌توانم روزی حلال به دست آورم، در حالی که آن روزی برایم دشواری به همراه ندارد."],[541,"مر مرا سوی کهستان راندند","میوه‌ها زان بیشه می‌افشاندند","مرا به سمت کوهستان راندند و میوه‌ها را از آن جنگل بر سرم ریختند."],[541,"که خدا شیرین بکرد آن میوه را","در دهان تو به همتهای ما","خداوند آن میوه را که تلخ و ترش بود، به تو شیرین کرد به خاطر تلاش و کوشش ما."],[541,"هین بخور پاک و حلال و بی‌حساب","بی صداع و نقل و بالا و نشیب","سعی کن از روزی حلال و پاک استفاده کنی و در این دنیا از نگرانی و مشکلات فارغ باش. این روزی به تو آرامش می‌دهد و باعث می‌شود از ناملایمات زندگی آزاد شوی."],[541,"پس مرا زان رزق نطقی رو نمود","ذوق گفت من خردها می‌ربود","پس از آن که از روزی حلال و پاک بهره‌مند شدم، ذوقی به من دست داد که به‌وسیله‌اش حقایق را دریافتم و فهمیدم که این نعمت، عقل و خرد را از من می‌رباید و به من الهام می‌کند."],[541,"گفتم این فتنه‌ست ای رب جهان","بخششی ده از همه خلقان نهان","من گفتم این مسئله باعث آزرم و پریشانی من است، ای پروردگار جهان، لطفی کن و از بین همه مردم آنچه را که پنهان است، به من عطا کن."],[541,"شد سخن از من دل خوش یافتم","چون انار از ذوق می‌بشکافتم","وقتی صحبت از من شد، شادی و خوشحالی را احساس کردم مانند حسی که وقتی اناری را می‌شکافم و از طعم شیرین آن لذت می‌برم."],[541,"گفتم ار چیزی نباشد در بهشت","غیر این شادی که دارم در سرشت","گفتم اگر در بهشت هیچ چیزی غیر از این شادی که من در وجودم دارم وجود نداشته باشد، من راضی هستم."],[541,"هیچ نعمت آرزو ناید دگر","زین نپردازم به حور و نیشکر","هیچ نعمت دیگری برایم آرزویی نیست و از این به بعد به خوشی‌های بهشتی همچون حور و نیشکر (شکر) توجه نخواهم کرد."],[541,"مانده بود از کسب یک دو حبه‌ام","دوخته در آستین جبه‌ام","قبل از اینکه به کسب بپردازم، فقط یکی دو حبه (دانه) از درآمدم مانده بود که آن‌ها را در آستین جبه‌ام (لباس) گذاشته‌ام."],[542,"آن یکی درویش هیزم می‌کشید","خسته و مانده ز بیشه در رسید","یک درویش که هیزم می‌برید، به خاطر خستگی و فرسودگی ناشی از کار طولانی، از جنگل برگشته و حال خوبی نداشت."],[542,"پس بگفتم من ز روزی فارغم","زین سپس از بهر رزقم نیست غم","سپس گفتم که چون در روزی کمبود ندارم، دیگر برای رزق و روزی‌ام نگران نیستم."],[542,"میوه مکروه بر من خوش شدست","رزق خاصی جسم را آمد به دست","مقدار مشخصی از رزق مخصوص بدنم به من رسیده است و به همین خاطر، میوه‌ای که ممکن است نامطلوب به نظر بیاید، برای من خوشایند شده است."],[542,"چونک من فارغ شدستم از گلو","حبه‌ای چندست این بدهم بدو","وقتی که من از مشکلات و گرفتاری‌ها آزاد شدم، چند دانه‌ای از این پول را به هیزم‌کش می‌دهم."],[542,"بدهم این زر را بدین تکلیف‌کش","تا دو سه روزک شود از قوت خوش","من می‌خواهم این سکه را به هیزم‌کش بدهم تا شاید به مدت دو یا سه روز از قوت و غذا برخوردار شود."],[542,"خود ضمیرم را همی‌دانست او","زانک سمعش داشت نور از شمع هو","او (هیزم‌کش) می‌دانست که من چه نیتی دارم، زیرا گوشش مثل نوری است که از شمع می‌تابد و به تمام اسرار و درون‌مایه‌ها آگاه است."],[542,"بود پیشش سر هر اندیشه‌ای","چون چراغی در درون شیشه‌ای","در حضور او، تمام اندیشه‌ها مانند چراغی درون شیشه روشن و نمایان هستند."],[542,"هیچ پنهان می‌نشد از وی ضمیر","بود بر مضمون دلها او امیر","هیچ چیزی از پنهان‌کارها و نیت‌های مردم بر او که سرور دل‌هاست، پوشیده نمی‌ماند و او بر محتوای دل‌ها آگاهی دارد."],[542,"پس همی منگید با خود زیر لب","در جواب فکرتم آن بوالعجب","پس خودت را زیاد درگیر نکن و در دل با خود زیر لب چیزی نگو، زیرا فکر کردن به این موضوع، به نظر عجیب و غریب می‌آید."],[542,"که چنین اندیشی از بهر ملوک","کیف تلقی الرزق ان لم یرزقوک","این بیت اشاره دارد به اینکه کسانی که درباره گذران زندگی و معاش خود به دربار و ملوک فکر می‌کنند، باید بدانند که اگر از آن‌ها روزی نرسد، نباید ناامید شوند. معیشت خود را تنها به درگاه ملوک وابسته نکنند و به تسلیم و انتظار در برابر آن‌ها وابسته نباشند."],[542,"من نمی‌کردم سخن را فهم لیک","بر دلم می‌زد عتابش نیک نیک","من به خوبی نمی‌توانستم معنای کلام را درک کنم، اما در درونم احساس می‌کردم که او به من به خاطر نیت و نیت‌ام طعنه می‌زند و این عتاب را به من گوشزد می‌کند."],[542,"سوی من آمد به هیبت هم‌چو شیر","تنگ هیزم را ز خود بنهاد زیر","او با قدرت و وقار مانند شیر به سمت من آمد و هیزم را به‌سرعت و با خشم از زیر خود برداشت و به زمین گذاشت."],[542,"پرتو حالی که او هیزم نهاد","لرزه بر هر هفت عضو من فتاد","حالت و انرژی که آن هیزم‌کش به من منتقل کرد، باعث شد که تمام بدنم بلرزد و شوق و هیجان در من ایجاد شود."],[542,"گفت یا رب گر ترا خاصان هی‌اند","که مبارک‌دعوت و فرخ‌پی‌اند","ای خدا، اگر جمعی از خاصان تو وجود دارند که در دعا کردن و دعوت به کار نیکو به خوش‌اقبالی و شگون مشهورند،"],[542,"لطف تو خواهم که میناگر شود","این زمان این تنگ هیزم زر شود","خود را در این لحظه نیازمند لطف تو می‌دانم تا این چوب‌های خشک و تنگ، به طلا تبدیل شود."],[542,"در زمان دیدم که زر شد هیزمش","هم‌چو آتش بر زمین می‌تافت خوش","در آن زمان که هیزم‌کش نیت خوبی داشت و با صفا رفتار کرد، هیزمش به طوری درخشان و پرنور شد مانند طلا که بر زمین می‌درخشید و این نشان از اثرات نیک نیت او دارد."],[542,"من در آن بی‌خود شدم تا دیرگه","چونک با خویش آمدم من از وله","در آن لحظه بی‌خبر از خود شدم و غرق در حالتی عمیق و روحانی گشتم، زیرا وقتی به خود آمدم، متوجه شدم که از شگفتی و حیرت به حالتی دیگر رفته‌ام."],[542,"بعد از آن گفت ای خداگر آن کبار","بس غیورند و گریزان ز اشتهار","پس از آن گفت: ای خدا، اگر این افراد بزرگ (کبار، منظور علمای بزرگ یا اهل فضل) بسیار حساس و فراری از شهرت هستند،"],[542,"باز این را بند هیزم ساز زود","بی‌توقف هم بر آن حالی که بود","این بیت اشاره دارد به اینکه باید برای هیزم‌کش، که در برابر نیت او حساس شده، فورا و بدون تأخیر اقدام کند، در حالی که او همچنان در همان حالت و وضعیتی که قبلا بوده، قرار دارد."],[542,"در زمان هیزم شد آن اغصان زر","مست شد در کار او عقل و نظر","در آن زمان، وقتی که هیزم به شکل شاخه‌های طلا درآمد، عقل و درک او در کارش مشغول به خود غرق شد و از حقیقت دور شد."],[542,"بعد از آن برداشت هیزم را و رفت","سوی شهر از پیش من او تیز و تفت","پس از آنکه هیزم را برداشت، او با تیزی و جدیت به سمت شهر رفت و از کنار من دور شد."],[542,"خواستم تا در پی آن شه روم","پرسم از وی مشکلات و بشنوم","من تصمیم گرفتم تا به دنبال آن پادشاه بروم و از او در مورد مشکلات و مسائلم سؤال کنم و پاسخ بشنوم."],[542,"بسته کرد آن هیبت او مر مرا","پیش خاصان ره نباشد عامه را","آن هیبت و عظمت خداوند باعث شد که من نتوانم در محفل خاصان، جایی برای خود بیابم و تنها مردم عادی را ملاقات کنم."],[542,"ور کسی را ره شود گو سر فشان","کان بود از رحمت و از جذبشان","اگر کسی به راهی دست یابد و سرش را به خاطر دیگران فدای خود کند، این نتیجه رحمت و جاذبه‌های معنوی آنهاست."],[542,"پس غنیمت دار آن توفیق را","چون بیابی صحبت صدیق را","پس این فرصت را غنیمت بشمار، زمانی که با مردی صالح و با صداقت (صدیق) نشست و برخاست و دوستی داری."],[542,"نه چو آن ابله که یابد قرب شاه","سهل و آسان در فتد آن دم ز راه","منظور این است که نباید مانند آن فرد جاهل بود که به آسانی و بدون زحمت به مقام و نزدیکی به شاه دست می‌یابد، زیرا او در آن لحظه از راه درست خارج می‌شود."],[542,"چون ز قربانی دهندش بیشتر","پس بگوید ران گاوست این مگر","وقتی به کسی که قربانی بیشتری می‌دهند، می‌گویند گوشتش از ران گاو است، او ممکن است بخواهد بگوید که این گوشت فقط باید متعلق به گاو باشد و نوعی طعنه به دیگران است که ادعا می‌کنند چیزی را دارند که در واقع ندارند."],[542,"نیست این از ران گاو ای مفتری","ران گاوت می‌نماید از خری","اینکه می‌گویی این چیز از ران گاو است، دروغ است؛ چرا که در واقع، ران گاو تو را به خری شبیه می‌کند، نه به خود آن."],[542,"بذل شاهانه‌ست این بی رشوتی","بخشش محضست این از رحمتی","این بخشش از جانب خداوند است و از روی رحمت انجام می‌شود، نه به خاطر توقع پاداش یا رشوه. این نوع کمک و صدقه به اندازه‌ای با شکوه و از روی سخاوت است که نباید به آن به چشم معامله نگاه کرد."],[543,"هم‌چنان که شه سلیمان در نبرد","جذب خیل و لشکر بلقیس کرد","سلیمان، مانند پادشاهی که با قدرت و تدبیر، لشکر بلقیس را به سوی خود جلب کرد، اقدام نمود."],[543,"که بیایید ای عزیزان زود زود","که برآمد موجها از بحر جود","ای عزیزان، زود بیایید، زیرا امواج بخشش و سخاوت از دریا بیرون آمده است."],[543,"سوی ساحل می‌فشاند بی‌خطر","جوش موجش هر زمانی صد گهر","موج بی‌خطر دریا هر زمان گوهرهای زیادی را به سمت ساحل می‌اورد."],[543,"الصلا گفتیم ای اهل رشاد","کین زمان رضوان در جنت گشاد","ما به شما گفتیم، ای مردم باهوش و با صداقت، این زمان، زمان ورود به بهشت است که در آن درهای رحمت و نعمت باز شده است."],[543,"پس سلیمان گفت ای پیکان روید","سوی بلقیس و بدین دین بگروید","سلیمان به پیامبران گفت که به سوی بلقیس (ملکه سبا) بروند و او را دعوت کنند که به این دین (اسلام) ایمان بیاورد."],[543,"پس بگوییدش بیا اینجا تمام","زود که ان الله یدعوا بالسلام","به بلقیس بگویید که به سرعت به اینجا بیاید؛ زیرا خداوند دعوت به سلامتی می‌کند."],[543,"هین بیا ای طالب دولت شتاب","که فتوحست این زمان و فتح باب","ای کسی که به دنبال دستیابی به نعمت‌ها و موفقیت‌ها هستی، شتاب کن و بیایید، زیرا این زمان، زمان پیروزی و گشایش است."],[543,"ای که تو طالب نه‌ای تو هم بیا","تا طلب یابی ازین یار وفا","اگر تو هم به دنبال توانگری نیستی، باز هم بیا و از این یار وفادار بهره‌مند شو و چیزی بیاب."],[544,"ملک برهم زن تو ادهم‌وار زود","تا بیابی هم‌چو او ملک خلود","ای ادهم، به طور سریع و بدون تردید قدرت سلطنت را بر هم بزن تا بتوانی مانند او به ملک جاودان برسیدی."],[544,"خفته بود آن شه شبانه بر سریر","حارسان بر بام اندر دار و گیر","آن پادشاه، شبانه بر تخت خود در حارسان (شهری در ایران) خوابیده بود و در بالای تکیه‌گاهش به خواب رفته بود."],[544,"قصد شه از حارسان آن هم نبود","که کند زان دفع دزدان و رنود","قصد حاکم از خوابیدن بر بام حارسان این نبود که بخواهد از دزدان و ستمگران جلوگیری کند."],[544,"او همی دانست که آن کو عادلست","فارغست از واقعه آمن دلست","او (مولانا) می‌دانست که کسی که عادل است، از حوادث و نگرانی‌ها بی‌خبر و آرام است."],[544,"عدل باشد پاسبان گامها","نه به شب چوبک‌زنان بر بامها","عدل، محافظ و نگهبان قدم‌هاست و نه مانند کسانی که در شب با چوب بر بام‌ها می‌کوبند."],[544,"لیک بد مقصودش از بانگ رباب","هم‌چو مشتاقان خیال آن خطاب","مقصود او از صدای رباب، همچون عاشقانی است که انتظار شنیدن پیامی را دارند و به خاطر آن باز هم برانگیخته می‌شوند."],[544,"ناله سرنا و تهدید دهل","چیزکی ماند بدان ناقور کل","ناله ساز سرنا و صداهای تهدیدآمیز دهل، چیزی شبیه به صدای ناقوس کلیساست که در واقع علامتی برای بیدار کردن انسان‌ها از خواب غفلت و توجه به حقیقت است."],[544,"پس حکیمان گفته‌اند این لحنها","از دوار چرخ بگرفتیم ما","حکیمان گفته‌اند که این نواها و آوازها را از گردش و چرخش کائنات گرفته‌ایم."],[544,"بانگ گردشهای چرخست این که خلق","می‌سرایندش به تنبور و به حلق","این صداهایی که مردم به وسیله تنبور و حلق می‌خوانند، ناشی از حرکت دایره‌ای و گردش چرخ‌ طبیعت است."],[544,"مؤمنان گویند که آثار بهشت","نغز گردانید هر آواز زشت","مؤمنان می‌گویند که زیبایی‌های بهشت باعث شده است تا صدای نغز و دلنشین ایجاد شود و هر صدای زشتی به خوبی‌ها و زیبایی‌ها تبدیل شود."],[544,"ما همه اجزای آدم بوده‌ایم","در بهشت آن لحن‌ها بشنوده‌ایم","ما همه از اجزای آدم هستیم و پیش از این در بهشت بوده‌ایم و آن صداهای زیبا را شنیده‌ایم."],[544,"گرچه بر ما ریخت آب و گل شکی","یادمان آمد از آنها چیزکی","با وجود اینکه بر ما آب و گل (خاک) ریخته شده و به دنیای مادی آمده‌ایم، با این حال یادمان می‌آید که از آن بالاتر ساخته شده‌ایم و نشانه‌هایی از آن حالت وضعیت عالی در ما باقی مانده است."],[544,"لیک چون آمیخت با خاک کرب","کی دهند این زیر و آن بم آن طرب","زمانی که آب با خاک کربلا مخلوط شود، آیا قدرت دارد که این زیر و آن بالا را به نوعی خوشی و شادمانی تبدیل کند؟ اشاره به ترکیب آب و خاک کربلا و لزوم وجود شرایط خاص برای به وجود آمدن احساسی خوشایند دارد."],[544,"آب چون آمیخت با بول و کمیز","گشت ز آمیزش مزاجش تلخ و تیز","وقتی آب با ادرار مخلوط می‌شود و به لباس (کمیز) می‌چسبد، به خاطر این ترکیب، مزاجش تلخ و تند می‌شود."],[544,"چیزکی از آب هستش در جسد","بول گیرش آتشی را می‌کشد","در بدن انسان چیزی از آب وجود دارد که مانند بول، آتش غم را می‌سوزاند."],[544,"گر نجس شد آب این طبعش بماند","که آتش غم را به طبع خود نشاند","اگر این آب نجس شود، طبع آن به همین حالت باقی می‌ماند و آتش غم را با خود همراه می‌کند."],[544,"پس غدای عاشقان آمد سماع","که درو باشد خیال اجتماع","پس از آن، غذایی برای عاشقان رسید که در آن، تصور و خیال جمع شدن و اتحاد وجود دارد."],[544,"قوتی گیرد خیالات ضمیر","بلک صورت گردد از بانگ و صفیر","خیالات درون انسان، با شنیدن صداها و نواهای عاشقانه قدرتمند می‌شود و به گونه‌ای شکل و صورت پیدا می‌کند."],[544,"آتش عشق از نوا‌ها گشت تیز","آن چنان که آتش آن جوزریز","آتش عشق به خاطر نواها و آوازها شعله‌ور و تند شد، به‌گونه‌ای که مانند آتش در دیگ جوز (گردو) به شدت و خروش درآمد."],[545,"در نغولی بود آب آن تشنه راند","بر درخت جوز جوزی می‌فشاند","آن تشنه به درخت جوز نزدیک بود و بر آن درخت جوزی می‌فشاند تا آب را بهتر بیابد."],[545,"می‌فتاد از جوزبن جوز اندر آب","بانگ می‌آمد همی دید او حباب","او از درخت جوز میوه‌ها را به سمت آب می‌ریخت و صدای حباب‌هایی که در آب ایجاد می‌شد را می‌شنید."],[545,"عاقلی گفتش که بگذار ای فتی","جوزها خود تشنگی آرد ترا","عاقلی به آن مرد تشنه می‌گوید که باید جوزها را رها کند، زیرا خود تشنگی تو را به آب نخواهد رساند."],[545,"بیشتر در آب می‌افتد ثمر","آب در پستیست از تو دور در","برای این که با آب بیشتر به ثمر برسی، باید به پستی‌ها و جاهای نزدیک‌تر بروی، چون آب در جاهای پایین‌تر می‌ماند و تو اینگونه از آن دور نخواهی بود."],[545,"تا تو از بالا فرو آیی به زور","آب جویش برده باشد تا به دور","تا زمانی که تو از بالا به سمت پایین نایستی و به زور آب نیفتی، جوی آب نمی‌تواند تو را به خود ببرد و به دور کند."],[545,"گفت قصدم زین فشاندن جوز نیست","تیزتر بنگر برین ظاهر مه‌ایست","هدف من از پخش کردن جوز در این آب، چیزی جز این نیست که تو بهتر و دقیق‌تر به این ظاهر زیبا توجه کنی، که در واقع همچون ماهی درخشان است."],[545,"قصد من آنست که آید بانگ آب","هم ببینم بر سر آب این حباب","من هدفم این است که صدای آب را بشنوم و همچنین ببینم که حبابی بر روی سطح آب شکل می‌گیرد."],[545,"تشنه را خود شغل چه بود در جهان","گرد پای حوض گشتن جاودان","تشنگی انسان چه کار او را در این دنیا مشغول می‌کند، اینکه مدام دور حوض بچرخد و به دنبال آب بگردد، نشانه‌ای از بی‌فایده بودن تلاش اوست."],[545,"گرد جو و گرد آب و بانگ آب","هم‌چو حاجی طایف کعبه صواب","انسان تشنه، مثل یک زائر که در اطراف کعبه می‌گردد، به دور جو و آب می‌چرخد و صدای آب برایش همچون نوای خوشی است که او را به شوق می‌آورد."],[545,"هم‌چنان مقصود من زین مثنوی","ای ضیاء الحق حسام‌الدین توی","مقصود من از این مثنوی، ای نور حق، حسام‌الدین، همین است که تویی."],[545,"مثنوی اندر فروع و در اصول","جمله آن تست کردستی قبول","تمام مضامین و موضوعات مثنوی در فروع و اصول، به خود تو مربوط می‌شود. تو باید آن‌ها را به تأمل و درک خود بپذیری."],[545,"در قبول آرند شاهان نیک و بد","چون قبول آرند نبود بیش رد","شاهان نیک و بد هر چیزی را که بپذیرند، رد و ضعفی در آن وجود ندارد، یعنی اگر چیزی مورد قبول واقع شود، دیگر رد نمی‌شود."],[545,"چون نهالی کاشتی آبش بده","چون گشادش داده‌ای بگشا گره","هرگاه درختی بکارید، باید به آن آب بدهید و به آن کمک کنید تا رشد کند؛ پس چنان‌که به درختی آب داده‌اید، فضا را برای شکوفایی‌اش فراهم کنید و موانع را از سر راهش بردارید."],[545,"قصدم از الفاظ او راز توست","قصدم از انشایش آواز توست","من هدفم از بیان واژه‌های او، فاش کردن راز تو است و هدفم از گفتن سخنانش، بیان صدای تو است."],[545,"پیش من آوازت آواز خداست","عاشق از معشوق حاشا که جداست","صدای تو برای من مانند صدای خداوند است و عاشق هرگز از معشوق خود جدا نمی‌شود."],[545,"اتصالی بی‌تکیف بی‌قیاس","هست رب‌الناس را با جان ناس","ارتباطی بین خداوند و جان انسان‌ها وجود دارد که نه قابل توصیف است و نه قابل اندازه‌گیری. این ارتباط از نوعی خاص و بی‌نهایت است که ما را به نیروی رب‌الناس (پروردگار انسان‌ها) متصل می‌کند."],[545,"لیک گفتم ناس من نسناس نی","ناس غیر جان جان‌اشناس نی","من گفتم که مردم من مانند نسل‌های قبلی نیستند و آنها که جان را می‌شناسند، با دیگران متفاوت‌اند."],[545,"ناس مردم باشد و کو مردمی","تو سر مردم ندیدستی دمی","مردم معمولا به انسان‌ها اشاره دارد، اما آیا تو هم به حقیقت انسانیت توجه کرده‌ای؟ آیا یک لحظه نیز به سرشت واقعی مردم نگاه کرده‌ای؟"],[545,"ما رمیت اذ رمیت خوانده‌ای","لیک جسمی در تجزی مانده‌ای","اگرچه تو می‌گویی که من از دل و جان برای هدفی تلاش کرده‌ام، اما در واقع، تو در احساسات و جسم خود گرفتار مانده‌ای و از حقیقت دوری."],[545,"ملک جسمت را چو بلقیس ای غبی","ترک کن بهر سلیمان نبی","ای غبی (دختر عاقل و باهوش)، جسم خود را مانند بلقیس، ملکه سبا، رها کن تا به سلیمان نبی (پادشاه بزرگ و پیامبر) بپیوندی. یعنی وابستگی‌های مادی و جسمی را کنار بگذار و به مسائل معنوی و روحانی توجه کن."],[545,"می‌کنم لا حول نه از گفت خویش","بلک از وسواس آن اندیشه کیش","من از روی گفته خودم نمی‌گویم \"لا حول ولاقوة الا بالله\"، بلکه این جمله را از وسواس و فکر نادرستی که به سرم آمده، می‌زنم."],[545,"کو خیالی می‌کند در گفت من","در دل از وسواس و انکارات ظن","انسان‌هایی هستند که در دل خود از وسواس و تردیدها و شک‌ها رنج می‌برند، اما در ظاهر خود را قوی و مطمئن نشان می‌دهند."],[545,"می‌کنم لا حول یعنی چاره نیست","چون ترا در دل بضدم گفتنیست","می‌گوید که من دیگر از فایده‌ای برای خودم و تو جایی ندارم، چون در دل من چیزهایی وجود دارد که نمی‌توانم بگویم و تو هم احساس می‌کنی که از درون با من در تضادی."],[545,"چونک گفت من گرفتت در گلو","من خمش کردم تو آن خود بگو","وقتی که من گفتم تو را در گلویم دارم و نمی‌توانم حرف بزنم، من سکوت کردم و تو خودت بگو که چه می‌خواهی بگویی."],[545,"آن یکی نایی خوش نی می‌زدست","ناگهان از مقعدش بادی بجست","مردی که نواهای خوشی با نی می‌زد، ناگهان بادی از پشت او خارج شد."],[545,"نای را بر کون نهاد او که ز من","گر تو بهتر می‌زنی بستان بزن","کسی که در حال نواختن نی است، آن را بر نشیمن خود گذاشته و به یاری می‌گوید که اگر تو در نواختن بهتر هستی، پس بیایید و نواختن را امتحان کن."],[545,"ای مسلمان خود ادب اندر طلب","نیست الا حمل از هر بی‌ادب","ای مسلمان، هیچ چیز به جز درک و فهم رفتار خوب در جستجو (طلب) یاد نمی‌دهد، جز این که با هر شخص بی‌ادبی، خود را به دوش بکشیم و آن را تحمل کنیم."],[545,"هر که را بینی شکایت می‌کند","که فلان کس راست طبع و خوی بد","هر کسی که شکایت می‌کند که فردی دارای طبیعت و خوی ناپسند است، خود او هم از نظر اخلاقی مشکل دارد و در واقع نمایش‌دهنده بدخویی است."],[545,"این شکایت‌گر بدان که بدخو است","که مر آن بدخوی را او بدگو است","شکایت‌کننده باید بداند که خود او هم دارای خوی بدی است و کسی که او از آن شکایت می‌کند، در واقع به ویژگی‌های منفی خود او اشاره دارد."],[545,"زانک خوش‌خو آن بود کو در خمول","باشد از بدخو و بدطبعان حمول","خوش‌خو کسی است که در دور از خشم و بداخلاقی دیگران زندگی می‌کند و تحت تأثیر خصومت‌ها و طبع‌های بد آنها قرار نمی‌گیرد."],[545,"لیک در شیخ آن گله ز آمر خداست","نه پی خشم و ممارات و هواست","تنها در شیخ، آن خواسته و گلایه از طرف خداوند است و این به خاطر خشم و جدل یا دلخواه خود او نیست."],[545,"آن شکایت نیست هست اصلاح جان","چون شکایت کردن پیغامبران","شکایت کردن در واقع نشانه‌ای از اصلاح و بهبود روح است، نه به معنای واقعی آن، چون پیامبران نیز از شکایت استفاده می‌کنند برای ارتقای وضعیت روحی مردم."],[545,"ناحمولی انبیا از امر دان","ورنه حمالست بد را حلمشان","ناحمولی پیامبران نسبت به امور الهی از جهتی دانایی و بصیرت آنهاست، وگرنه آنها مانند یک بارکش هستند که بدی‌ها را تحمل می‌کنند."],[545,"طبع را کشتند در حمل بدی","ناحمولی گر بود هست ایزدی","طبع (سرشت) انسان در برابر رفتارهای زشت و ناپسند به شدت تحت فشار قرار می‌گیرد؛ اما اگر صفت حلم (برخورد آرام و تحمل) از جانب خداوند وجود داشته باشد، ممکن است این فشار قابل تحمل شود."],[545,"ای سلیمان در میان زاغ و باز","حلم حق شو با همه مرغان بساز","ای سلیمان، باید در بین زاغ و باز (پرندگان مختلف) حلم و بردباری الهی را داشته باشی و با همه مرغان (آدم‌ها و موجودات) سازگاری و در صلح زندگی کنی."],[545,"ای دو صد بلقیس حلمت را زبون","که اهد قومی انهم لا یعلمون","ای بلقیس، تو که با صدها زیبایی و قدرت، به خاطر حیا و صبرت (حلمت) در مقابل دیگران به زهد و فقر شناخته می‌شوی، برای قومی که درک درستی از تو ندارند، چیزی جز نادانی و بی‌خبری نیست."],[546,"هین بیا بلقیس ورنه بد شود","لشکرت خصمت شود مرتد شود","ای بلقیس، سریع به من بپیوند وگرنه لشکر تو نسبت به تو نافرمان و غیرمؤمن خواهند شد."],[546,"پرده‌دار تو درت را بر کند","جان تو با تو به جان خصمی کند","خداوند پرده‌ای را از روی تو برداشت، و جان تو در برابر دشمنی که داری، به تو آسیب خواهد زد."],[546,"جمله ذرات زمین و آسمان","لشکر حق‌اند گاه امتحان","اجزای زمین و آسمان سپاهیان خداوند هستند و گاهی برای آزمایش انسان‌ها به کار می‌روند."],[546,"باد را دیدی که با عادان چه کرد","آب را دیدی که در طوفان چه کرد","به باد نگاه کن که چگونه با قوم عاد برخورد کرد و آنها را نابود کرد. همچنین به آب توجه کن که چطور در طوفان، افرادی را در تسلط خود گرفت و به هلاکت رساند."],[546,"آنچ بر فرعون زد آن بحر کین","وآنچ با قارون نمودست این زمین","هرچه بر فرعون انجام شد و دریا به خاطر انتقام از او او را غرق کرد، و هر آنچه زمین به خاطر قارون به او نشان داد، همه نشان‌دهنده قدرت و قهر الهی است."],[546,"وآنچ آن بابیل با آن پیل کرد","وآنچ پشه کله نمرود خورد","آنچه در بابل اتفاق افتاد و آن فیل را به زمین انداخت، و همچنین آنچه مگس گنده‌ای برای نمرود انجام داد و او را از بین برد، نشان‌دهنده قدرت پروردگار است."],[546,"وآنک سنگ انداخت داودی بدست","گشت شصد پاره و لشکر شکست","داود به‌وسیلۀ سنگ‌هایی که در دست داشت، شصت‌پاره کرد و لشکر دشمن را شکست داد."],[546,"سنگ می‌بارید بر اعدای لوط","تا که در آب سیه خوردند غوط","خداوند بر دشمنان لوط سنگ می‌ریخت تا آنها در آب سیاه گرفتار شوند و غرق گردند."],[546,"گر بگویم از جمادات جهان","عاقلانه یاری پیغامبران","اگر بگویم که جمادات، یعنی موجودات بی‌جان، به‌طور عاقلانه‌ای پیامبران را یاری می‌کنند، منظورم این است که حتی اشیاء بی‌روح نیز می‌توانند در خدمت اهداف الهی قرار گیرند."],[546,"مثنوی چندان شود که چل شتر","گر کشد عاجز شود از بار پر","در این بیت اشاره به این است که اگر شعری همانند مثنوی (که اثر مولاناست) سنگین و با ارزش باشد، حتی اگر شخصی بخواهد آن را بار کند، از سنگینی آن ناتوان خواهد شد. به عبارت دیگر، مفهوم این است که بار سنگین معانی و مفاهیم عمیق شعر، برای هر کسی قابل تحمل نخواهد بود."],[546,"دست بر کافر گواهی می‌دهد","لشکر حق می‌شود سر می‌نهد","دست به کافر گواهی می‌دهد، یعنی نشانه‌هایی از کفر بر او وجود دارد، و لشکر حق، یعنی گروه مؤمنین و جان‌فدایان حق، سر به زمین می‌ساید و تسلیم می‌شود."],[546,"ای نموده ضد حق در فعل درس","در میان لشکر اویی بترس","ای کسی که در اعمال خود با حق مخالفت می‌کنی، در میان لشکر حق باشید و بترس."],[546,"جزو جزوت لشکر او در وفاق","مر ترا اکنون مطیع‌اند از نفاق","تو هم جزئی از سپاه او هستی و اکنون همه آن‌ها بر اساس اتحاد و همدلی عمل می‌کنند، نه بر اساس نفاق و تعارض."],[546,"گر بگوید چشم را کو را فشار","درد چشم از تو بر آرد صد دمار","اگر کسی به تو بگوید که چشمت را ببند، بداند که دردی از ناحیه خودت بر تو و دیگران می‌فرستد که بسیار دردناک خواهد بود."],[546,"ور به دندان گوید او بنما وبال","پس ببینی تو ز دندان گوشمال","اگر کسی به تو بگوید که دندان را نشان بده تا عواقب آن را ببینی، پس متوجه می‌شوی که چگونه دندان باعث زحمت و درد می‌شود."],[546,"باز کن طب را بخوان باب العلل","تا ببینی لشکر تن را عمل","در این بیت به اهمیت شناخت و درک بیماری‌ها و علل آن‌ها اشاره شده است. مولانا از شنونده می‌خواهد که به علم طب توجه کند و به مطالعه‌ی علت‌ها بپردازد تا بتواند وضعیت جسمانی یا «لشکر تن» خود را بهتر درک کند و به بهبود آن بپردازد."],[546,"چونک جان جان هر چیزی ویست","دشمنی با جان جان آسان کیست","جان، منبع حیات هر چیز است و در حقیقت، خود جان، همان جان است. بنابراین، دشمنی با آنچه سرچشمه حیات دارد، به آسانی ممکن نیست."],[546,"خود رها کن لشکر دیو و پری","کز میان جان کنندم صفدری","خود را از لشکر دیوان و پریان (موجودات شر) رها کن، زیرا آنها می‌توانند جان انسان را به صفری (کاستی، نقصان) برسانند."],[546,"ملک را بگذار بلقیس از نخست","چون مرا یابی همه ملک آن تست","بلقیس را رها کن؛ چون خداوند (ملک) را از ابتدا به تو داده و وقتی که مرا می‌بیند، تمام ملک برای تو خواهد بود."],[546,"خود بدانی چون بر من آمدی","که تو بی من نقش گرمابه بدی","تو می‌دانی که وقتی به نزد من آمدی، نشان از محبت تو به من هست و تو بدون من نمی‌توانی به خوبی از چیزی همچون گرمابه استفاده کنی."],[546,"نقش اگر خود نقش سلطان یا غنیست","صورتست از جان خود بی چاشنیست","اگر نقشی که تصور می‌شود، نقش یک سلطان یا فرد ثروتمند است، این نقش تنها یک تصویر و ظاهر است و از روح و جان واقعی او بی‌خبر است و هیچ‌گونه عمق و معنایی ندارد."],[546,"زینت او از برای دیگران","باز کرده بیهده چشم و دهان","زینت او (شخصی یا چیزی که مورد اشاره است) برای دیگران نمایان شده، اما بی‌فایده است؛ چراکه فقط به چشم‌ها و دهان‌ها (ظاهر) پرداخته شده و چیز ارزشمندی در باطن ندارد."],[546,"ای تو در بیگار خود را باخته","دیگران را تو ز خود نشناخته","ای کسی که در کار و دنیا خود را گم کرده‌ای و به اشتباه توجه‌ات به دیگران معطوف است، تو خود را نمی‌شناسی و به هویت واقعی‌ات پی نبرده‌ای."],[546,"تو به هر صورت که آیی بیستی","که منم این والله آن تو نیستی","تو هرطور که جلوه‌گری کنی، در واقع ایستاده‌ای که من هستم، ولی بدان که این حالت واقعی تو نیست."],[546,"یک زمان تنها بمانی تو ز خلق","در غم و اندیشه مانی تا به حلق","یک زمانی باید به دور از مردم باشی و در تنهایی به فکر و اندیشه فرو بروی تا به حقیقت وجود خود، یعنی راز درونت، پی ببری."],[546,"این تو کی باشی که تو آن اوحدی","که خوش و زیبا و سرمست خودی","اینکه تو چه کسی هستی که خودت را به جای اوحدی (خدا) قرار می‌دهی، در حالی که او خوش و زیبا و سرمست است و تو فقط خود را می‌بینی."],[546,"مرغ خویشی صید خویشی دام خویش","صدر خویشی فرش خویشی بام خویش","تو خودت را به دام‌ها و محدودیت‌های خودت گرفتار کرده‌ای، پرنده آزادی‌ات را در قفس خودت حبس کرده‌ای و عرش و جایگاه والایی که در اختیار داری، تحت تسلط خودت است."],[546,"جوهر آن باشد که قایم با خودست","آن عرض باشد که فرع او شدست","جوهر اصلی چیزها همان ذات آن‌هاست که مستقل از دیگران وجود دارد، در حالی که ویژگی‌ها و صفات ظاهری، تابع و فرع بر آن جوهر هستند."],[546,"گر تو آدم‌زاده‌ای چون او نشین","جمله ذریات را در خود ببین","اگر تو هم مثل آدم (آدم علیه‌السلام) زاده شده‌ای، باید تمام فرزندان و نسل‌های خود را در وجود خود حس کنی و درک کنی."],[546,"چیست اندر خم که اندر نهر نیست","چیست اندر خانه کاندر شهر نیست","در این بیت، سوال می‌شود که چه چیزی در خم (مکان یا وضعیت) وجود دارد که در نهر (آب یا جریان زندگی) وجود ندارد و یا چه چیزی در خانه (محل زندگی) هست که در شهر (مجموعه زندگی) نیست. این سوال، کنجکاوی و جست‌وجوی عمیق‌تری را درباره‌ی معنای وجود و عدم در مکان‌ها مطرح می‌کند."],[546,"این جهان خمست و دل چون جوی آب","این جهان حجره‌ست و دل شهر عجاب","این دنیا مانند یک خم (محل مشروب‌سازی) است و دل آدمی همچون جوی آبی است که در آن جریان دارد. این دنیا مانند یک حجره (اتاق) است و دل همانند شهری است پر از شگفتی و شگفتی‌ها."],[547,"هین بیا که من رسولم دعوتی","چون اجل شهوت‌کشم نه شهوتی","بیایید، من پیام‌آور هستم و دعوتی دارم مثل دعوت اجل. من شهوت را می‌طلبم، اما نه به خاطر شهوت‌پرستی."],[547,"ور بود شهوت امیر شهوتم","نه اسیر شهوت روی بتم","اگر من همسرای شهوت‌ها بودم، ولی امیر و فرمانروا بر شهوت‌هایم نیستم، بلکه تنها اسیر زیبایی معشوقم هستم."],[547,"بت‌شکن بودست اصل اصل ما","چون خلیل حق و جمله انبیا","منبع و ریشه ما از ابتدا بت‌شکنی بوده است، همان‌طور که خلیل (ابراهیم) نبوت و حق را شناخت و همه پیامبران نیز این راه را پیمودند."],[547,"گر در آییم ای رهی در بتکده","بت سجود آرد نه ما در معبده","اگر ما، ای رهی (طارق)، وارد بتکده شویم، بت (مجسمه پرستیده شده) نیز به احترام ما سجده می‌کند نه این که ما در معبد (جایگاه عبادت) سجده کنیم."],[547,"احمد و بوجهل در بتخانه رفت","زین شدن تا آن شدن فرقیست زفت","احمد (پیامبر اسلام) و ابو جهل (دشمن آن حضرت) به یک مکان (بتخانه) وارد شدند، اما ورود آنها به این مکان تفاوت زیادی دارد؛ زیرا در حالی که احمد با هدفی معنوی و خدایی به آنجا قدم گذاشته، ابو جهل با نیت کفر و شرک آمده است."],[547,"این در آید سر نهند او را بتان","آن در آید سر نهد چون امتان","وقتی کسی به حقیقت و واقعیت خداوند نزدیک شود، بت‌ها سر به زیر می‌نهند و تسلیم می‌شوند، و وقتی کسی از مسیر حق منحرف شود، بت‌ها بر او تسلط پیدا می‌کنند و او را به خود می‌کشند."],[547,"این جهان شهوتی بتخانه‌ایست","انبیا و کافران را لانه‌ایست","این جهان، جایی است پر از تمایلات و خواسته‌ها که مانند یک بتخانه می‌ماند و مکانی است برای انبیا و کافران به عنوان محل زندگی و فعالیت‌هایشان."],[547,"لیک شهوت بنده پاکان بود","زر نسوزد زانک نقد کان بود","شهوت متعلق به بندگان پاک است، زیرا طلا در آتش نمی‌سوزد و اصل هر چیز با ارزش باقی می‌ماند."],[547,"کافران قلب‌اند و پاکان هم‌چو زر","اندرین بوته درند این دو نفر","کافرها مانند دل‌های سیاه هستند و پاکان مانند طلا در کوره‌ آزمایش. این دو گروه به طور واضح از یکدیگر متمایز هستند."],[547,"قلب چون آمد سیه شد در زمان","زر در آمد شد زری او عیان","وقتی قلب تاریک می‌شود، در زمان مناسب، طلا در آن ظاهر می‌گردد و خالص و روشن می‌شود."],[547,"دست و پا انداخت زر در بوته خوش","در رخ آتش همی خندد رگش","زر (طلا) در بوته قوی و به خوبی تکان می‌خورد و در آتش به خوشی می‌خندد، انگار رگ (عروق) آن نیز تحت تأثیر این سرور است. این تصویر به معنای استعداد و تحولی اشاره دارد که در شرایط سخت و پس از آزمایش به‌وجود می‌آید."],[547,"جسم ما روپوش ما شد در جهان","ما چو دریا زیر این که در نهان","وجود ما مانند پوششی است که در این دنیا قرار دارد، همان‌طور که دریا زیر این پوسته است. در واقع، جنس و کیفیت ظاهری ما نمی‌تواند عمق درون ما را نمایان کند."],[547,"شاه دین را منگر ای نادان بطین","کین نظر کردست ابلیس لعین","ای نادان، به شاه دین (سلیمان) نگاه نکن، چون ابلیس ملعون هم به خاطر حسادت و کینه‌اش به تنها چیزی که توجه کرد، همین نگاه است."],[547,"کی توان اندود این خورشید را","با کف گل تو بگو آخر مرا","چگونه می‌توان این خورشید را که نماد حقیقت و روشنایی است با خاک و گل پوشاند؟ تو بگو که چطور ممکن است."],[547,"گر بریزی خاک و صد خاکسترش","بر سر نور او برآید بر سرش","اگر خاک و صد خاکستر را هم بر سر نور او بریزی، باز هم نور او برتری خواهد داشت و بر سر این چیزها می‌درخشد."],[547,"که کی باشد کو بپوشد روی آب","طین کی باشد کو بپوشد آفتاب","ای کسی که می‌توانی آفتاب را بپوشانی و بر روی آبی طین، یعنی گل‌آلود، بایستی، کیستی که این کارها را کنی؟"],[547,"خیز بلقیسا چو ادهم شاه‌وار","دود ازین ملک دو سه روزه بر آر","بلقیس، ملکه سبا، همان‌طور که آدهم (سلیمان) با شکوه است، از این سرزمین که مدت کوتاهی است در آن هستی، برخیز و بلافاصله دست به کار کن."],[548,"بر سر تختی شنید آن نیک‌نام","طقطقی و های و هویی شب ز بام","در بالای تخت نشسته بود و صدای شادمانی و سر و صدای مردم را از شب بر فراز بام شنید. طقطق، شخصیت نیک‌نامی است که به نظر می‌رسد مورد احترام است."],[548,"گامهای تند بر بام سرا","گفت با خود این چنین زهره کرا","نفس حیات‌بخش را که بر بام سرا، پشت سرش بر صداهای شب حاکم است، گفت: «این شخصی که از این صداها برمی‌آید، کیست؟ آیا عاقل و زیرکی است یا کسی شجاع و دلیر؟"],[548,"بانگ زد بر روزن قصر او که کیست","این نباشد آدمی مانا پریست","صدا زد به درب قصر، و پرسید که چه کسی بیرون است. گفتند که این فرد، آدمی نیست بلکه پری زیباست."],[548,"سر فرو کردند قومی بوالعجب","ما همی گردیم شب بهر طلب","گروهی شگفت‌انگیز سرهای خود را پایین آورده‌اند و ما نیز شبانه در جستجوی چیزی می‌گردیم."],[548,"هین چه می‌جویید گفتند اشتران","گفت اشتر بام بر کی جست هان","گفتند چه چیزی را جست‌وجو می‌کنید؟ آن‌ها پاسخ دادند که شتران را. او گفت: شتر بام را بر چه کسی جست‌وجو می‌کنید؟"],[548,"پس بگفتندش که تو بر تخت جاه","چون همی جویی ملاقات اله","به او گفتند که تو در مقام و جایگاه بلند خود، چطور به دنبال ملاقات با خدا هستی؟"],[548,"خود همان بد دیگر او را کس ندید","چون پری از آدمی شد ناپدید","ابراهیم ادهم، که به مقام و جاه خود دست یافته بود، در واقع همانند یک پری است که از میان آدمیان ناپدید شده و هیچ‌کس او را نمی‌تواند ببیند. این نشان می‌دهد که او از عالم مادی فاصله گرفته است."],[548,"معنی‌اش پنهان و او در پیش خلق","خلق کی بینند غیر ریش و دلق","او به قدری از چشم انسان‌ها دور شده و باطنش پنهان است که مردم فقط ظاهرش را می‌بینند، نه حقیقت وجودش را؛ در واقع فقط ریش و دلق او را می‌بینند."],[548,"چون ز چشم خویش و خلقان دور شد","هم‌چو عنقا در جهان مشهور شد","وقتی ابراهیم ادهم از چشم خود و مردم دور شد، مانند پرنده‌ای افسانه‌ای به نام عنقا، در دنیا شناخته و مشهور گشت."],[548,"جان هر مرغی که آمد سوی قاف","جمله عالم ازو لافند لاف","هر پرنده‌ای که به قاف، محل وصال یا آغاز و نهایت سفر روحانی، نزدیک می‌شود، همه موجودات عالم از او سخن می‌گویند و به او افتخار می‌کنند."],[548,"چون رسید اندر سبا این نور شرق","غلغلی افتاد در بلقیس و خلق","وقتی این نور شرقی به سبا (سرزمین بلقیس) رسید، سر و صدای زیادی در بلقیس و میان مردم ایجاد شد."],[548,"روحهای مرده جمله پر زدند","مردگان از گور تن سر بر زدند","همه روح‌های مرده به حیات درآمدند و مردگان از گورها بیرون آمدند."],[548,"یک دگر را مژده می‌دادند هان","نک ندایی می‌رسد از آسمان","آن‌ها به یکدیگر بشارت می‌دادند که توجه کنید، ندایی از آسمان به گوش می‌رسد."],[548,"زان ندا دینها همی‌گردند گبز","شاخ و برگ دل همی گردند سبز","از آن نداها، دین‌ها و آئین‌ها رونق می‌گیرند، مثل اینکه شاخ و برگ دل نیز زنده و سرسبز می‌شود."],[548,"از سلیمان آن نفس چون نفخ صور","مردگان را وا رهانید از قبور","نفس آدمی را از سلیمان، که در اینجا نماد حکمت و قدرت است، مانند صدایی می‌داند که مردگان را از خواب عمیق بیدار می‌کند و به زندگی بازمی‌گرداند. این اشاره به قدرت روح و روحانیت در احیای انسانی و معنوی دارد."],[548,"مر ترا بادا سعادت بعد ازین","این گذشت الله اعلم بالیقین","ای ابراهیم ادهم، برای تو آرزوی سعادت دارم پس از این، زیرا خداوند بهتر از هر کسی به حقایق آگاه است."],[549,"قصه گویم از سبا مشتاق‌وار","چون صبا آمد به سوی لاله‌زار","هوا بوی آشنایی دارد و من مشتاقانه داستانی از سرزمین سبا را تعریف می‌کنم، زیرا مانند باد (صبا) که به باغ لاله‌ها می‌رسد، شوق و محبت به سوی آن می‌روم."],[549,"لاقت الاشباح یوم وصلها","عادت الاولاد صوب اصلها","در روزی که بلقیس به سلیمان وصل شد، مانند فرزندان که به ریشه خود برمی‌گردند، او نیز به اصل و منشأ خویش یعنی به سلیمان و دین او بازگشت."],[549,"امة العشق الخفی فی الامم","مثل جود حوله لوم السقم","حب و عشق پنهانی در میان همگان مانند بخشندگی حلقه‌ای است که عذر و ناتوانی را می‌پوشاند و از آن می‌پرهیزد."],[549,"ذلة الارواح من اشباحها","عزة الاشباح من ارواحها","روح‌ها در وجود خود ناتوان و ضعیف هستند، اما برای بدن‌ها (اشباح) قدر و منزلتی دارند که به خاطر روح‌هایشان است."],[549,"ایها العشاق السقیا لکم","انتم الباقون و البقیالکم","ای عاشقان، به شما خوش بگذرد، زیرا شما تنها کسانی هستید که باقی می‌مانید و باقی بودن فقط متعلق به شماست."],[549,"ایها السالون قوموا واعشقوا","ذاک ریح یوسف فاستنشقوا","ای کسانی که در جستجوی حقیقت هستید، برخیزید و عشق بورزید، چرا که بوی خوشی که شبیه بوی یوسف است، به مشام می‌رسد؛ این را استشمام کنید."],[549,"منطق‌الطیر سلیمانی بیا","بانگ هر مرغی که آید می‌سرا","سلیمان، که توانایی فهم زبان پرندگان را داشت، بیا و صدای هر پرنده‌ای که می‌آید را بشنو و درک کن."],[549,"چون به مرغانت فرستادست حق","لحن هر مرغی بدادستت سبق","خداوند به پرندگان تو صدا و لحن مخصوص هر یک را داده است تا درک کنند و پیشی بگیرند."],[549,"مرغ جبری را زبان جبر گو","مرغ پر اشکسته را از صبر گو","مرغ جبری یعنی موجودی که تحت سلطه‌ی تقدیر و سرنوشت است، باید از زبان تقدیر صحبت کند. اما مرغ پر شکسته، که به معنای موجودی آسیب‌دیده و ناتوان است، باید از صبر و استقامت سخن بگوید."],[549,"مرغ صابر را تو خوش دار و معاف","مرغ عنقا را بخوان اوصاف قاف","مرغی که صبر دارد را تو دوست بدار و از مرغ عنقا (که نماد آرزوهای بزرگ و غیرقابل دسترس است) اوصاف قاف (قاف، کوهی خیال‌انگیز در افسانه‌ها) را بخوان."],[549,"مر کبوتر را حذر فرما ز باز","باز را از حلم گو و احتراز","ای کبوتر، از باز (شخصی که شکارچی است) دوری کن و از او بپرهیز، زیرا باید از روی عقل و دوراندیشی (حلم) با احتیاط عمل کنی."],[549,"وان خفاشی را که ماند او بی‌نوا","می‌کنش با نور جفت و آشنا","هر خفاشی که بی‌کسی مانده، باید با نور و روشنایی آشنا شود و جفتی برای خود پیدا کند تا از تنهایی‌اش رهایی یابد."],[549,"کبک جنگی را بیاموزان تو صلح","مر خروسان را نما اشراط صبح","به کبک جنگی یاد بده که به صلح و آرامش، نشانه‌های صبح را به خروس‌ها نشان دهد. این بیت به آشتی و هماهنگی میان موجودات و اهمیت صلح اشاره دارد."],[549,"هم‌چنان می‌رو ز هدهد تا عقاب","ره نما والله اعلم بالصواب","همچنان که هدهد به‌سوی عقاب می‌رود تا او را به راهی درست هدایت کند، بدان که فقط خداوند از حقیقت و درست بودن راه مطلع است."],[550,"چون سلیمان سوی مرغان سبا","یک صفیری کرد بست آن جمله را","وقتی سلیمان به سمت مرغان سبا نوازش یا علامتی برای ارتباط فرستاد، آنها را به صفی منظم و با هم جمع کرد."],[550,"جز مگر مرغی که بد بی‌جان و پر","یا چو ماهی گنگ بود از اصل کر","فقط پرنده‌ای که بی‌جان و بدون پر بود، یا مانند ماهی بی‌صدا، از اصل کر (به‌معنای ناتوانی و بی‌صدا بودن) است. این بیان نشان‌دهنده حالتی است که فرد یا موجودی در خواب یا ناتوانی به سر می‌برد و توانایی پاسخگویی یا شنوایی ندارد."],[550,"نی غلط گفتم که کر گر سر نهد","پیش وحی کبریا سمعش دهد","اگر کسی که ناشنواست، حتی سرش را به سوی وحی بزرگ (خدا) هم بگذارد، باز هم نخواهد شنید؛ بنابراین، بیان این موضوع که نمی‌تواند درک کند، صحیح نیست."],[550,"چونکه بلقیس از دل و جان عزم کرد","بر زمان رفته هم افسوس خورد","بلقیس وقتی تصمیم گرفت که به ‌سوی ایمان برگردد، از گذشته‌اش و زمانی که در کاخ و سلطنت زندگی می‌کرد، ابراز پشیمانی و افسوس کرد."],[550,"ترک مال و ملک کرد او آن چنان","که بترک نام و ننگ آن عاشقان","بلقیس به قدری به عشق و ایمانش پایبند شده که مال و دارایی و مقام و شهرتش را رها کرده است، همان‌طور که عاشقان برای رسیدن به معشوق، از نام و ننگ خود می‌گذرند."],[550,"آن غلامان و کنیزان به ناز","پیش چشمش هم‌چو پوسیده پیاز","غلامان و کنیزان در برابر او، مانند پیازهای خراب و بی‌ارزش به نظر می‌رسند."],[550,"باغ‌ها و قصرها و آب رود","پیش چشم از عشق گلحن می‌نمود","باغ‌ها و قصرها و آب رود در مقابلش به خاطر عشقش به گلحن، بی‌ارزش و بی‌اهمیت به نظر می‌رسید."],[550,"عشق در هنگام استیلا و خشم","زشت گرداند لطیفان را به چشم","عشق در زمان قدرت و خشونت، زیبایی و لطافت را در نظر انسان‌ها ناپسند و زشت می‌سازد."],[550,"هر زمرّد را نماید گندنا","غیرت عشق این بود معنیّ لا","در این بیت گفته می‌شود که هر زمرد به خاطر غیرت عشق، ناپاکی و گندیدگی خود را نشان می‌دهد. اینجا به معنای «لا» اشاره شده که می‌گوید در عشق حقیقی، هیچ چیزی جز عشق وجود ندارد و عشق همه چیز را از غبار می‌شوید."],[550,"لا اله الّا هو اینست ای پناه","که نماید مه ترا دیگ سیاه","بلقیس به جای تکیه‌گاه‌های دنیوی و ملک و ثروت، به عشق و ایمان روی می‌آورد و در این مسیر به حقیقتی غیر از خداوند نمی‌رسد، و این مسأله را مشابه نمایان شدن مه در دیگ سیاه می‌داند."],[550,"هیچ مال و هیچ مخزن هیچ رخت","می دریغش نامد الّا جز که تخت","هیچ مالی و هیچ گنج و دارایی او را که به او تعلق داشته باشد، با او نمانده است، مگر تخت سلطنت که فقط به عنوان چیزی مادی از او باقی مانده است."],[550,"پس سلیمان از دلش آگاه شد","کز دل او تا دل او راه شد","سلیمان متوجه شد که دل بلقیس از ایمان و محبت او پر شده است و احساسات او به او وصل شده است."],[550,"آن کسی که بانگ موران بشنود","هم فغان سرّ دوران بشنود","هر کسی که صدای مورچه‌ها را می‌شنود، درد و زاری سرنوشت و زمان را نیز حس می‌کند."],[550,"آنکه گوید راز قالت نملة","هم بداند راز این طاق کهن","این بیت بیان می‌کند که کسی که می‌تواند سخن مورچه را بفهمد، قادر است راز این ساختمان قدیمی (طاق کهن) را نیز درک کند. در واقع این اشاره به عمق درک و فهم انسان دارد و نشان می‌دهد که دانایی در هر مقیاسی محقق می‌شود."],[550,"دید از دورش که آن تسلیم کیش","تلخش آمد فرقت آن تخت خویش","بلقیس از دور متوجه شد که تسلیم به مذهب جدیدی که سخت است، او را از تخت سلطنتش جدا کرده و به فراغ و جدایی دچار کرده است."],[550,"گر بگویم آن سبب گردد دراز","که چرا بودش به تخت آن عشق و ساز","اگر بگویم که چه دلیلی باعث شد بلقیس مدت طولانی بر تختش باشد، در این صورت طولانی خواهد شد و آن عشق و موزون بودنش را از یاد خواهد برد."],[550,"گرچه این کلک قلم خود بی‌حسیست","نیست جنس کاتب او را مونسیست","هرچند این قلم که نوشته می‌کشد بی‌روح است، اما وجود نویسنده‌ی آن با روح و احساس است و این شخص به نوعی با آن مرتبط و همدم می‌باشد."],[550,"هم‌چنین هر آلت پیشه‌وری","هست بی‌جان مونس جانوری","همچنین هر ابزار و وسیله‌ای که در دست یک پیشه‌ور یا حرفه‌ای است، بدون روح و جان، برای او همانند یک همدمی بی‌احساس به شمار می‌آید."],[550,"این سبب را من معیّن گفتمی","گر نبودی چشم فهمت را نمی","من این دلیل و علت را برای تو مشخص کردم؛ اگر درک و فهم تو نبود، این توضیح را نمی‌گفتم."],[550,"از بزرگی تخت کز حد می‌فزود","نقل کردن تخت را امکان نبود","بلقیس از بزرگی و عظمتی که تخت‌اش داشت، قدرت برکناری آن تخت را نداشت و قادر به جدایی از آن نبود."],[550,"خرده کاری بود و تفریقش خطر","هم‌چو اوصال بدن با همدگر","استحکام و یکپارچگی حکومت و قدرت سلیمان را مانند پیوند اعضای بدن دانسته و می‌گوید هرگونه نقص و جدایی در آن، خطرناک است و می‌تواند به سقوط و نابودی منجر شود."],[550,"پس سلیمان گفت گرچه فی‌الاخیر","سرد خواهد شد برو تاج و سریر","سلیمان می‌گوید اگر چه در نهایت ممکن است بلقیس بی‌احساس و سرد شود، اما برو تاج و تخت را بیاورید تا او دوباره به مقام و محبت برگردد."],[550,"چون ز وحدت جان برون آرد سری","جسم را با فرّ او نبود فری","زمانی که جان از وحدت خارج شود و از جسم جدا گردد، در آن لحظه از عشق و محبت الهی، هیچ فریبی یا نیرنگی وجود نخواهد داشت."],[550,"چون برآید گوهر از قعر بحار","بنگری اندر کف و خاشاک خوار","زمانی که امتیاز و ارزش حقیقی (گوهر) از عمق دریاها (قعر بحار) نمایان شود، متوجه خواهی شد که در آن لحظه، حتی خاشاک (زائدات و چیزهای بی‌ارزش) در مقایسه با آن گوهر، بی‌اهمیت و خوار هستند."],[550,"سر بر آرد آفتاب با شرر","دمّ عقرب را کی سازد مستقر","آفتاب به بالای آسمان می‌رسد، اما آیا می‌تواند با خطر و آتش گزنده عقرب هم‌زمان مستقر شود؟ منظور این است که نمی‌توان دو حقیقت متضاد را در یک جا جمع کرد."],[550,"لیک خود با این همه بر نقد حال","جست باید تخت او را انتقال","با وجود این همه نکته‌های آشکار، باید به او توجه کرد و تخت سلطنتش را منتقل کرد."],[550,"تا نگردد خسته هنگام لقا","کودکانه حاجتش گردد روا","در ملاقات و وصال، وقتی که دوست را می‌بینی، نباید خسته شوی و از شوق مثل یک کودک به خواسته‌ات دست یابی."],[550,"هست بر ما سهل و او را بس عزیز","تا بود بر خوان حوران دیو نیز","در اینجا اشاره شده که برای ما چیزی ساده و آسان به نظر می‌رسد، اما برای او (بلقیس) بسیار ارزشمند و گرانبهاست، زیرا او در نزد حوران (پرستاران بهشتی) قرار دارد و حتی دیو (موجودات شر) نیز در کنار او وجود دارند."],[550,"عبرت جانش شود آن تخت ناز","هم‌چو دلق و چارقی پیش ایاز","بلقیس در جریان تحولش از سلطنت، به قدری تحت تأثیر قرار گرفته که دیگر به تخت و سلطنت خود، همچون لباسی کهنه و بی‌ارزش می‌نگرد و آن را رها کرده است."],[550,"تا بداند در چه بود آن مبتلا","از کجاها در رسید او تا کجا","باید بدانیم دلیل و علتی که بلقیس به این وضعیت گرفتار شده است چیست و او از کجا به این سرنوشت دچار شده و تا کجا پیش رفته است."],[550,"خاک را و نطفه را و مضغه را","پیش چشم ما همی‌دارد خدا","خداوند بادید خود، عناصر اولیه زندگی مانند خاک، نطفه (سلول‌های جنسی) و مضغه (نقطه آغازین رشد جنینی) را برای ما به تصویر می‌کشد و نشان می‌دهد که از چه چیزهایی آغاز شده‌ایم."],[550,"کز کجا آوردمت ای بدنیت","که از آن آید همی خفریقیت","شما از کجا آمده‌ای ای بدنیت (بدن ناپاک)، که از آنجا همواره ذلت و خفّت می‌آید؟"],[550,"تو بر آن عاشق بدی در دور آن","منکر این فضل بودی آن زمان","تو در آن زمان که از عشق دور بودی و به منکران فضل و کرامت بی‌توجه بودی، چنین احساسی نداشتی."],[550,"این کرم چون دفع آن انکار تست","که میان خاک می‌کردی نخست","نیکی و لطفی که اکنون مانع انکار تو شده، شبیه به دلیلی است که تو در ابتدا برای توجیه خود می‌آورده‌ای."],[550,"حجت انکار شد انشار تو","از دوا بدتر شد این بیمار تو","انکاری که تو می‌کنی، برای تو حجت و دلیل می‌شود، اما در حقیقت، حال تو را از بیماری بدتر می‌کند؛ این مشکل تو تنها با دوا و درمان اصلاح می‌شود."],[550,"خاک را تصویر این کار از کجا","نطفه را خصمی و انکار از کجا","این بیت درباره بهت و حیرت از اینکه چگونه می‌توان به این مسئله پی برد که نطفه (آغاز زندگی) از کجا آمده و بر سر خاک (جهان مادی) چه تغییراتی رخ داده است. سوال این است که منبع این تحولات و تضادها (خصم و انکار) چیست و از کجا نشئت گرفته‌اند."],[550,"چون در آن دم بی‌دل و بی‌سر بدی","فکرت و انکار را منکر بدی","وقتی که در آن لحظه بی‌دل و بی‌خود بودی، تفکر و انکار را هم انکار کردی."],[550,"از جمادی چونک انکارت برست","هم ازین انکار حشرت شد درست","وقتی که انکار و نادانی تو از حالت جمود و بی‌تحرکی بیرون آمد، همین انکار بود که باعث تحقق حشر و قیامت تو شد."],[550,"پس مثال تو چو آن حلقه‌زنیست","کز درونش خواجه گوید خواجه نیست","پس تو مانند آن انسان حلقه‌زن هستی که از درون جسمش صدایی می‌آید که می‌گوید: من آقا و صاحب‌اختیار نیستم."],[550,"حلقه‌زن زین نیست دریابد که هست","پس ز حلقه بر ندارد هیچ دست","حلقه‌زن (کسی که حلقه می‌زند، یعنی صنف یا رسته‌ای که با حلقه سر و کار دارد) نمی‌تواند از وجود خود باخبر شود، زیرا وقتی در این کار مشغول است، هرگز دستش را از حلقه برنمی‌دارد."],[550,"پس هم انکارت مبین می‌کند","کز جماد او حشر صد فن می‌کند","انکار تو نشان می‌دهد که از جماد (موجودات بی‌روح) او هزاران جلوه و فنونی را خلق می‌کند. یعنی هرگونه انکاری در واقع نشان‌دهنده وجود شکوه و ذاتی عمیق در آن موجود است."],[550,"چند صنعت رفت ای انکار تا","آب و گل انکار زاد از هل اتی","چندین کار و هنری که به وسیله انکار انجام شده، دیگر جایی ندارد؛ چون این آب و گل (انسان) از حالتی که در آن است، بیدار شده و به حقیقت ایمان آورده است."],[550,"آب وگل می‌گفت خود انکار نیست","بانگ می‌زد بی‌خبر که اخبار نیست","آب و گل (موجودات مادی) می‌گفتند که وجود ندارند و نپذیرفته‌اند (انکار می‌کردند)، اما در واقع به شکل ناخواسته‌ای فریاد می‌زدند و نشان می‌دادند که بی‌خبر از حقیقت هستند و خبر از این انکار ندارند."],[550,"من بگویم شرح این از صد طریق","لیک خاطر لغزد از گفت دقیق","من می‌توانم این موضوع را از صد راه توضیح دهم، اما ذهن من در گفتن جزئیات دقیق نمی‌توانند متمرکز بماند و به راحتی از آن خارج می‌شود."],[551,"گفت عفریتی که تختش را به فن","حاضر آرم تا تو زین مجلس شدن","عفریت (موجودی قدرتمند و افسانه‌ای) گفت می‌توانم تخت بلقیس را با استفاده از توانایی‌ام در همین حال و به سرعت به اینجا بیاورم تا تو از آن استفاده کنی."],[551,"گفت آصف من به اسم اعظمش","حاضر آرم پیش تو در یک دمش","آصف، وزیر سلیمان، می‌گوید که با استفاده از اسم اعظم الهی، می‌تواند تخت بلقیس را در کسری از زمان به حضور بیاورد."],[551,"گرچه عفریت اوستاد سحر بود","لیک آن از نفخ آصف رو نمود","هرچند عفریت (موجودی فراطبیعی و قدرتمند) استاد سحر و جادو بود، اما در واقع تخت بلقیس با نفس و نفخه (دم) آصف (وزیر و پیامبر سلیمان) ظاهر شد."],[551,"حاضر آمد تخت بلقیس آن زمان","لیک ز آصف نه از فن عفریتیان","تخت بلقیس در آن زمان حاضر شد، اما این اتفاق به خاطر آصف (سروان سحر و معجزه) بود و نه به دلیل توانایی عفریت‌ها."],[551,"گفت حمدالله برین و صد چنین","که بدیدستم ز رب العالمین","سلیمان می‌گوید شکر و سپاس خدا را به خاطر این نعمت و حتی بیشتر از آن، زیرا این معجزه را از سوی پروردگار جهانیان مشاهده کرده‌ام."],[551,"پس نظر کرد آن سلیمان سوی تخت","گفت آری گول‌گیری ای درخت","سلیمان به تخت بلقیس نگاه کرد و گفت: بله، ای درخت، تو گول‌گیر هستی و می‌توانی در این کار کمک کنی."],[551,"پیش چوب و پیش سنگ نقش‌کند","ای بسا گولان که سرها می‌نهند","در برابر چوب و سنگ، نقش‌هایی می‌زنند؛ زیرا بسیاری از نادانان و فریب‌خورده‌ها، به راحتی سر خود را به تقدیر می‌سپارند."],[551,"ساجد و مسجود از جان بی‌خبر","دیده از جان جنبشی واندک اثر","سجده‌کننده و سجده‌شونده از خویش بی‌خبرند و چشم آن‌ها از حقیقت جان، حرکتی سطحی و کم‌رنگ دارد."],[551,"دیده در وقتی که شد حیران و دنگ","که سخن گفت و اشارت کرد سنگ","در زمانی که چشم‌ها از حیرت و شگفتی به حالت بی‌حرکتی درآمد، سنگ نیز سخن گفت و اشاره‌ای کرد."],[551,"نرد خدمت چون به ناموضع بباخت","شیر سنگین را شقی شیری شناخت","چون نرد خدمت (برخی از انواع بازی‌ها یا شرط‌بندی) به نتیجه نرسید و باخت، آن شیر سنگین (شیر نماد قدرت سلیمان) به شقی (فردی بدخواه و سنگدل) شناخته شد."],[551,"از کرم شیر حقیقی کرد جود","استخوانی سوی سگ انداخت زود","شیر حقیقی (که در اینجا به معنای خداوند است) با نیکی و بزرگی خود، به سرعت استخوانی را به سوی سگ انداخت، و این نشان‌دهنده لطف و بخشش اوست."],[551,"گفت گرچه نیست آن سگ بر قوام","لیک ما را استخوان لطفیست عام","سلیمان در اینجا می‌گوید، اگرچه آن سگ حاضر نیست و در واقع وجود ندارد، اما ما استخوانی داریم که نشان‌دهنده لطف و جود (بخشش) خداوند است و به همه می‌رسد."],[552,"قصه راز حلیمه گویمت","تا زداید داستان او غمت","داستان حلیمه را برایت می‌گویم تا غم داستان او را از دل تو بزداید."],[552,"مصطفی را چون ز شیر او باز کرد","بر کفش برداشت چون ریحان و ورد","حلیمه وقتی که شیر را از محمد (مصطفی) گرفت، مانند گل ریحان و گل سرخ او را بر دستانش برداشت."],[552,"می‌گریزانیدش از هر نیک و بد","تا سپارد آن شهنشه را به جد","او (مصطفی) را از هر کار خوب و بد می‌رانند تا بتواند آن شاه بزرگ (مصطفی) را به جدش (پدربزرگش) بسپارد."],[552,"چون همی آورد امانت را ز بیم","شد به کعبه و آمد او اندر حطیم","او (محمد صلی‌الله علیه و سلم) به خاطر ترسی که داشت، امانتی را که به دست داشته به کعبه می‌برد و وارد حطیم، که بخشی از کعبه است، می‌شود."],[552,"از هوا بشنید بانگی کای حطیم","تافت بر تو آفتابی بس عظیم","حطیم، شنید از آسمان صدایی که به او می‌گفت که خورشیدی بزرگ و نورانی بر تو خواهد تابید."],[552,"ای حطیم امروز آید بر تو زود","صد هزاران نور از خورشید جود","ای حطیم (نکته‌ای که اشاره به مقام و عظمت او دارد)، امروز به زودی بر تو صدها هزار نور از خورشید بخشش و جود می‌تابد."],[552,"ای حطیم امروز آرد در تو رخت","محتشم شاهی که پیک اوست بخت","ای حطیم (حطیم، نام مکانی در کنار خانه کعبه) امروز در تو رخت و لباس بسیار شیک و با شکوهی خواهد آمد که پیام‌آور او بخت و اقبال خوب است."],[552,"ای حطیم امروز بی‌شک از نوی","منزل جانهای بالایی شوی","ای حطیم، امروز به‌طور حتم تو محل ورود جان‌های بزرگ و والامی‌خواهی شد."],[552,"جان پاکان طلب طلب و جوق جوق","آیدت از هر نواحی مست شوق","روح پاکان جستجوی حق را طلب می‌کند و به همین دلیل انبوهی از آنان به سمت تو می‌آیند، شاداب و مشتاق."],[552,"گشت حیران آن حلیمه زان صدا","نه کسی در پیش نه سوی قفا","حلیمه از آن صدا حیران و شگفت‌زده شد، نه کسی در پیش او بود و نه کسی در پشت سرش."],[552,"شش جهت خالی ز صورت وین ندا","شد پیاپی آن ندا را جان فدا","حلیمه، در شگفتی و حیرت، صدا و ندا را از هر سو می‌شنید و هیچ‌کس را نمی‌دید، پس جانش فدای آن ندا شد که به‌طور مکرر شنیده می‌شد."],[552,"مصطفی را بر زمین بنهاد او","تا کند آن بانگ خوش را جست و جو","حضرت مصطفی (پیامبر اسلام) را به زمین انداختند تا صدا و ندا (پیام الهی) را جستجو کند."],[552,"چشم می‌انداخت آن دم سو به سو","که کجا است این شه اسرارگو","حلیمه به اطراف نگاه می‌کرد تا ببیند این پیامبر بزرگ، که اسرار را می‌داند، کجاست."],[552,"کین چنین بانگ بلند از چپ و راست","می‌رسد یا رب رساننده کجاست","این صدا و ندا از همه‌ سو به گوش می‌رسد، ای خدا، تو کسی را بفرست که به ما برساند این صدا از کجا می‌آید."],[552,"چون ندید او خیره و نومید شد","جسم لرزان هم‌چو شاخ بید شد","وقتی او (حلیمه) مصطفی (صلی‌الله علیه و سلم) را ندید، خیره و ناامید شد و بدنش مانند شاخ بید که در باد می‌لرزد، لرزید."],[552,"باز آمد سوی آن طفل رشید","مصطفی را بر مکان خود ندید","حلیمه دوباره به سمت آن بچه نیکو (مصطفی) برگشت، اما نتوانست او را در محل خود پیدا کند."],[552,"حیرت اندر حیرت آمد بر دلش","گشت بس تاریک از غم منزلش","دل حلیمه از شدت حیرت و غم به شدت مضطرب و تاریک شده و از فقدان فرزندش احساس افسردگی می‌کند."],[552,"سوی منزلها دوید و بانگ داشت","که کی بر دردانه‌ام غارت گماشت","حلیمه به سمت خانه‌های مردم دوید و فریاد می‌زد که چه کسی بر نوازد محبوب من، محمد (ص)، حمله کرده است."],[552,"مکیان گفتند ما را علم نیست","ما ندانستیم که آنجا کودکیست","مکیان می‌گویند که ما هیچ اطلاعی نداریم و نمی‌دانستیم که در آنجا کودکی وجود دارد."],[552,"ریخت چندان اشک و کرد او بس فغان","که ازو گریان شدند آن دیگران","حلیمه به قدری اشک ریخت و ناله کرد که دیگران نیز از گریه او به گریه افتادند."],[552,"سینه کوبان آن چنان بگریست خوش","که اختران گریان شدند از گریه‌اش","حلیمه آن‌قدر از شدت گریه و اندوه سینه‌زنی کرد و اشک ریخت که حتی ستاره‌ها نیز از اندوه او تحت تأثیر قرار گرفتند و گریان شدند."],[553,"پیرمردی پیشش آمد با عصا","کای حلیمه چه فتاد آخر ترا","پیرمردی، که عصایی به دست دارد، به حلیمه می‌گوید: چه بر سرت آمده که این‌گونه ناراحت و نگران به نظر می‌رسی؟"],[553,"که چنین آتش ز دل افروختی","این جگرها را ز ماتم سوختی","تو با اشک و حسرت دل‌های ما را آتش زده‌ای و از غم و اندوهی که به ما داده‌ای، جگرمان سوزانده شده است."],[553,"گفت احمد را رضیعم معتمد","پس بیاوردم که بسپارم به جد","پیر عرب به حلیمه می‌گوید که او را به احمد (پیامبر اسلام) بسپارد و به جد او (عبدالمطلب) که فرد معتمدی است، اعتماد کند."],[553,"چون رسیدم در حطیم آوازها","می‌رسید و می‌شنیدم از هوا","وقتی به مکان حطیم رسیدم، صدای آوازها به گوشم می‌رسید و از هوا می‌شنیدم."],[553,"من چو آن الحان شنیدم از هوا","طفل را بنهادم آنجا زان صدا","وقتی آن نغمه‌ها را از هوا شنیدم، کودک را در آنجا گذاشتم به خاطر آن صدا."],[553,"تا ببینم این ندا آواز کیست","که ندایی بس لطیف و بس شهیست","خواهم ببینم صدایی که می‌شنوم از آن کیست، زیرا این صدا بسیار دل‌نشین و زیباست."],[553,"نه از کسی دیدم بگرد خود نشان","نه ندا می منقطع شد یک زمان","نمی‌توانم نشانه‌ای از کسی اطراف خود ببینم و صدای لطیف هم به ناگهان قطع شد."],[553,"چونک واگشتم ز حیرتهای دل","طفل را آنجا ندیدم وای دل","وقتی از حیرت‌های درونم خارج شدم، آنجا دیگر خبری از کودک نیست و قلبم به شدت غمگین و ناراحت است."],[553,"گفتش ای فرزند تو انده مدار","که نمایم مر ترا یک شهریار","گفت: ای فرزند، غم و اندوه را به دل راه نده، زیرا من به تو یک پادشاه را نشان می‌دهم."],[553,"که بگوید گر بخواهد حال طفل","او بداند منزل و ترحال طفل","اگر کسی بخواهد حال کودک او را بداند، باید از مکان و محل توقف کودک آگاه شود."],[553,"پس حلیمه گفت ای جانم فدا","مر ترا ای شیخ خوب خوش‌ندا","حلیمه به شیخ که خوب و نیکو گفتار است، می‌گوید: ای جانم، جانم فدای تو باد."],[553,"هین مرا بنمای آن شاه نظر","کش بود از حال طفل من خبر","حلیمه از آن شیخ می‌خواهد که به او نشان دهد آن شاه که به او نظر دارد، از حال بچه‌اش خبر دارد."],[553,"برد او را پیش عزی کین صنم","هست در اخبار غیبی مغتنم","پیر عرب، حلیمه را به بت عزی (یکی از خدایان قبیله‌ای) می‌برد زیرا این بت در اخبار غیبی (امور پنهان و پیشگویی) اهمیت زیادی دارد."],[553,"ما هزاران گم شده زو یافتیم","چون به خدمت سوی او بشتافتیم","ما بسیاری از گم‌شدگان را که از راه او دور افتاده بودند، پیدا کردیم زمانی که به سوی او رفتیم و نیازمند یاری‌اش شدیم."],[553,"پیر کرد او را سجود و گفت زود","ای خداوند عرب ای بحر جود","پیر عرب او را به سجده می‌اندازد و می‌گوید: ای صاحب بزرگواری، ای دریای generosity (بخشش)! سریع به ما لطف کن."],[553,"گفت ای عزی تو بس اکرامها","کرده‌ای تا رسته‌ایم از دامها","عزی، ای خدایی که خیلی به ما احترام گذاشته‌ای و ما را از مشکلات و سختی‌ها نجات داده‌ای."],[553,"بر عرب حقست از اکرام تو","فرض گشته تا عرب شد رام تو","عرب به خاطر محبت و احترام‌هایی که تو به او کرده‌ای، ملزم است که نسبت به تو، یعنی خدای مردم، ارادت و اطاعت داشته باشد؛ به‌گونه‌ای که او اکنون تسلیم تو شده است."],[553,"این حلیمه سعدی از اومید تو","آمد اندر ظل شاخ بید تو","حلیمه سعدی، که مادر شیرخواره پیامبر محمد است، به امید تو به اینجا آمده و در سایه درخت بید تو قرار گرفته است."],[553,"که ازو فرزند طفلی گم شدست","نام آن کودک محمد آمدست","کودکی از او (حلیمه) گم شده است و نام این کودک محمد است."],[553,"چون محمد گفت آن جمله بتان","سرنگون گشتند و ساجد آن زمان","وقتی محمد این جملات را بیان کرد، همه آن بت‌ها به زمین افتادند و در آن لحظه سجده کردند."],[553,"که برو ای پیر این چه جست و جوست","آن محمد را که عزل ما ازوست","برو ای پیر، این چه سخن و کنجکاوی است؟ آن محمد، ما را از خود دور کرده است."],[553,"ما نگون و سنگسار آییم ازو","ما کساد و بی‌عیار آییم ازو","ما به خاطر او سقوط کرده و در تحقیر هستیم و بدون ارزش و بی‌خریدار شده‌ایم."],[553,"آن خیالاتی که دیدندی ز ما","وقت فترت گاه گاه اهل هوا","در زمان‌هایی که ما دچار رکود و سردرگمی بودیم، برخی افراد (اهل هوا) خیال‌هایی را از ما می‌دیدند، که نشان‌دهنده افکار و خواسته‌های باطل‌شان بود."],[553,"گم شود چون بارگاه او رسید","آب آمد مر تیمم را درید","وقتی که در برابر او (خدا) حاضر می‌شویم، مانند این است که تمام غبارها و موانع از بین می‌رود و تلاش‌ها و ریاضت‌های ما بی‌فایده می‌شود."],[553,"دور شو ای پیر فتنه کم فروز","هین ز رشک احمدی ما را مسوز","ای پیر، از ما دور شو تا فتنه و آتش کمتر شعله‌ور شود. خواهش می‌کنم، به خاطر حسادت و رشک به مقام احمد (پیامبر اسلام) ما را دچار آتش حسرت و اندوه نکن."],[553,"دور شو بهر خدا ای پیر تو","تا نسوزی ز آتش تقدیر تو","ای پیر، به خاطر خدا از ما دور شو تا مبادا از آتش سرنوشت بدی که برای تو رقم خورده، آسیب ببینی."],[553,"این چه دم اژدها افشردنست","هیچ دانی چه خبر آوردنست","این چه صدایی است که مانند صدای اژدها به گوش می‌رسد؟ آیا می‌دانی چه خبر مهمی را به همراه دارد؟"],[553,"زین خبر جوشد دل دریا و کان","زین خبر لرزان شود هفت آسمان","از این خبر دل دریا به جوش می‌آید و کانی که در اعماق دریا وجود دارد، از این خبر لرزان می‌شود، به گونه‌ای که هفت آسمان نیز به لرزه در می‌آید."],[553,"چون شنید از سنگها پیر این سخن","پس عصا انداخت آن پیر کهن","وقتی آن پیر کهن، این سخن را از سنگ‌ها شنید، عصای خود را بر زمین انداخت."],[553,"پس ز لرزه و خوف و بیم آن ندا","پیر دندانها به هم بر می‌زدی","پیر از ترس و لرز ناشی از آن ندا، دندان‌هایش را به هم می‌سایید."],[553,"آنچنان که اندر زمستان مرد عور","او همی لرزید و می‌گفت ای ثبور","مرد کور در فصل زمستان به شدت می‌لرزد و به دنبال کمک می‌گوید ای واویلا."],[553,"چون در آن حالت بدید او پیر را","زان عجب گم کرد زن تدبیر را","در آن حالت، آن زن حلیمه پیر را دید و به خاطر وضعیتی عجیب و غیرمنتظره، تدبیر و نقشه‌اش را فراموش کرد."],[553,"گفت پیرا گر چه من در محنتم","حیرت اندر حیرت اندر حیرتم","پیر عرب می‌گوید: ای حلیمه، هرچند من در مشکلات و گرفتاریم، باز هم در حیرت و شگفتی هستم و به درون این حیرت فرورفته‌ام."],[553,"ساعتی بادم خطیبی می‌کند","ساعتی سنگم ادیبی می‌کند","گاهی مانند باد، توانایی سخن گفتن و خطابت دارم و لحظه‌ای دیگر، مانند سنگ، به فکر و اندیشه‌های عمیق و علمی می‌افتم."],[553,"باد با حرفم سخنها می‌دهد","سنگ و کوهم فهم اشیا می‌دهد","باد با کلام من صحبت می‌کند و احساسات و اندیشه‌ها را منتقل می‌کند، در حالی که سنگ و کوه نیز به من در درک واقعیات کمک می‌کنند."],[553,"گاه طفلم را ربوده غیبیان","غیبیان سبز پر آسمان","گاهی اوقات بچه‌ام را موجودات غیبی (کسانی که در عالم غیب هستند) می‌ربایند، آن‌ها که سبزپوش و در آسمان ساکن‌اند."],[553,"از که نالم با که گویم این گله","من شدم سودایی اکنون صد دله","نمی‌دانم از چه کسی یا به چه کسی شکایت کنم، زیرا دیوانه و دل‌باخته شده‌ام و حالا با صد دل، در درد و گله‌ام."],[553,"غیرتش از شرح غیبم لب ببست","این قدر گویم که طفلم گم شدست","غیرت او (خدای) باعث شد که نتوانم درباره غیب و اسرار الهی صحبت کنم، فقط می‌توانم بگویم که بچه‌ام گم شده است."],[553,"گر بگویم چیز دیگر من کنون","خلق بندندم به زنجیر جنون","اگر بخواهم چیز دیگری بگویم، هم‌اکنون مردم مرا به زنجیر جنون می‌بندند."],[553,"گفت پیرش کای حلیمه شاد باش","سجده شکر آر و رو را کم خراش","پیر به حلیمه می‌گوید که شاد باش و به خاطر نعمت‌ها سجده شکر به جا آور، و در این حال به خودت آسیب نزن و خود را خراش نده."],[553,"غم مخور یاوه نگردد او ز تو","بلک عالم یاوه گردد اندرو","غم نخور که از تو کسی بی‌خود نمی‌شود، بلکه این جهان است که بی‌معنا و بی‌خود می‌شود."],[553,"هر زمان از رشک غیرت پیش و پس","صد هزاران پاسبانست و حرس","هر لحظه از حسادت و غیرت، صدها پاسبان و نگهبان وجود دارد که در اطراف ما هستند."],[553,"آن ندیدی کان بتان ذو فنون","چون شدند از نام طفلت سرنگون","تو آن بت‌های مختلف‌الهنر را ندیدی که چگونه از نام فرزندت (طفلت) به زمین افتادند و ناتوان شدند."],[553,"این عجب قرنیست بر روی زمین","پیر گشتم من ندیدم جنس این","عجب است که در این دوره بر روی زمین، من سالخورده شدم و هنوز چنین چیزی با این خصوصیات را ندیده‌ام."],[553,"زین رسالت سنگها چون ناله داشت","تا چه خواهد بر گنه کاران گماشت","از این رسالت (وظیفه) سنگ‌ها چون ناله و فریاد داشتند، معلوم می‌شود که بر گنه‌کاران (آنان که دچار گناه‌اند) چه عذاب و مجازاتی خواهد گذاشت."],[553,"سنگ بی‌جرمست در معبودیش","تو نه‌ای مضطر که بنده بودیش","سنگ در عبودیت و پرستش خدا بی‌گناه و بی‌جرم است، اما تو که در شرایط سخت و اضطرار قرار داری به خاطر بندگی خودت باید به خدا روی بیاوری."],[553,"او که مضطر این چنین ترسان شدست","تا که بر مجرم چه‌ها خواهند بست","مضطر (فردی که در تنگنا و نیاز است) به شدت ترسیده و نگران است که ممکن است چه عواقبی برای شخص مجرم (گناهکار) در نظر بگیرند."],[554,"چون خبر یابید جد مصطفی","از حلیمه وز فغانش بر ملا","پدربزرگ مصطفی (محمد) از گم شدن حلیمه (مادر شیرخوار محمد) با خبر شد و صدای نالۀ او را شنید."],[554,"وز چنان بانگ بلند و نعره‌ها","که بمیلی می‌رسید از وی صدا","صدای بلند و ناله‌هایی که از عبدالمطلب به گوش می‌رسید، به قدری قوی و دلخراش بود که احساس می‌کردی این صدا به شدت دل‌تنگی و غم او را منتقل می‌کند."],[554,"زود عبدالمطلب دانست چیست","دست بر سینه همی‌زد می‌گریست","عبدالمطلب به زودی متوجه شد که چه اتفاقی افتاده است، در حالی که با دستانش بر سینه‌اش می‌زد و گریه می‌کرد."],[554,"آمد از غم بر در کعبه بسوز","کای خبیر از سر شب وز راز روز","عبدالمطلب به خاطر غم و اندوهش، بر در کعبه آمده و می‌سوزد و با ناله و اشک از خدا می‌خواهد که او را از مشکلات و حوادث شبانه‌اش آگاه کند و رازهای روز را بشنود."],[554,"خویشتن را من نمی‌بینم فنی","تا بود هم‌راز تو هم‌چون منی","من نمی‌توانم در خودم مهارت یا هنری ببینم که در خور تو باشد، مانند تو که رازها را می‌دانی و با من یکی هستی."],[554,"خویشتن را من نمی‌بینم هنر","تا شوم مقبول این مسعود در","من نمی‌توانم خودم را هنرمند ببینم، پس چگونه می‌توانم مورد محبت و قبول مسعود (خدای مسعود) قرار بگیرم؟"],[554,"یا سر و سجده مرا قدری بود","یا باشکم دولتی خندان شود","شاید باید بگویم که یا با سر و سجده‌ام مقداری ارزش و مقام داشته باشد، یا سایه من باعث شود که گشایشی و خوشی به وجود آید."],[554,"لیک در سیمای آن در یتیم","دیده‌ام آثار لطفت ای کریم","در چهره آن یتیم، نشانه‌های محبت و نیکویی تو را مشاهده کرده‌ام، ای بخشنده و مهربان."],[554,"که نمی‌ماند به ما گرچه ز ماست","ما همه مسیم و احمد کیمیاست","ما هیچ‌گاه به چیزی که از ماست، نمی‌مانیم؛ زیرا ما همه مسیم (موجوداتی زودگذر) هستیم و احمد (پیامبر محمد) کیمیاست (فردی ارزشمند و گرانبها)."],[554,"آن عجایبها که من دیدم برو","من ندیدم بر ولی و بر عدو","من در زندگی‌ام چیزهایی را دیده‌ام که هیچ‌کس دیگری، چه دوست و چه دشمن، مشاهده نکرده است."],[554,"آنک فضل تو درین طفلیش داد","کس نشان ندهد به صد ساله جهاد","تو به این کودک، که همان محمد (صلی الله علیه و آله) است، آنقدر فضل و برکت عطا کرده‌ای که هیچ کسی نمی‌تواند در طول صد سال جنگ و تلاش، چنین چیزی را نشان دهد."],[554,"چون یقین دیدم عنایتهای تو","بر وی او دریست از دریای تو","وقتی که مطمئن شدم که لطف و عنایات تو بر او جاری است، او را همچون دری می‌بینم که از دریای تو ناشی می‌شود."],[554,"من هم او را می شفیع آرم به تو","حال او ای حال‌دان با من بگو","من نیز به شفاعت او (محمد) نزد تو می‌روم؛ حال او را به من بگویید، ای دانای حال‌ها."],[554,"از درون کعبه آمد بانگ زود","که هم‌اکنون رخ به تو خواهد نمود","سروصدایی از داخل کعبه به گوش می‌رسد که خبر می‌دهد شخصی به زودی بر تو ظاهر خواهد شد."],[554,"با دو صد اقبال او محظوظ ماست","با دو صد طلب ملک محفوظ ماست","با وجود اینکه ما از دو صد خوش شانسی و خوشبختی برخورداریم، ولی با دو صد جستجو و درخواست، آن ملک و مقام ما محفوظ و امن است."],[554,"ظاهرش را شهره گیهان کنیم","باطنش را از همه پنهان کنیم","ظاهر این موضوع را برای مردم مشهور و معروف کنیم، اما باطن آن را از همه مخفی نگه ‌داریم."],[554,"زر کان بود آب و گل ما زرگریم","که گهش خلخال و گه خاتم بریم","ما از آبی و گلی که ساخته شده‌ایم، به مانند زر و طلا هستیم، و در برخی مواقع مانند گلی (نشانه ناپایداری) زینت‌هایی مثل خلخال به پا داریم و در مواقع دیگر، همچون طلا، انگشترهایی به‌دست می‌کنیم."],[554,"گه حمایلهای شمشیرش کنیم","گاه بند گردن شیرش کنیم","گاهی حمایل‌های شمشیر او را می‌سازیم و زمانی بند گردن شیر او را قرار می‌دهیم."],[554,"گه ترنج تخت بر سازیم ازو","گاه تاج فرقهای ملک‌جو","گاهی ما ترنج (نوعی میوه) را بر تخت او می‌گذاریم، و گاهی تاجی را بر سر او که جویای مقام پادشاهی است، قرار می‌دهیم."],[554,"عشقها داریم با این خاک ما","زانک افتادست در قعده رضا","ما عشق‌های زیادی به این زمین داریم، زیرا اینجا در ناز و آرامش الهی افتاده است."],[554,"گه چنین شاهی ازو پیدا کنیم","گه هم او را پیش شه شیدا کنیم","گاهی باید چنین شاهی (محمد) را از او (عشق و محبت) بیابیم و گاهی هم او (محبت) را به پیش آن پادشاه (محمد) هさて کنیم."],[554,"صد هزاران عاشق و معشوق ازو","در فغان و در نفیر و جست و جو","صدها هزار عاشق و معشوق از او در حال ناله و فریاد و جست‌وجو هستند."],[554,"کار ما اینست بر کوری آن","که به کار ما ندارد میل جان","کار ما این است که برای کسی که به ما توجهی ندارد، بی‌حس و بی‌فایده تلاش نکنیم."],[554,"این فضیلت خاک را زان رو دهیم","که نواله پیش بی‌برگان نهیم","این بیت به فضیلت خاک اشاره دارد و می‌گوید ما این ارزش را به خاک می‌دهیم به خاطر این که غذا و نان را به کسانی که بی‌نعمت و فقیر هستند می‌دهیم."],[554,"زانک دارد خاک شکل اغبری","وز درون دارد صفات انوری","خاک به ظاهر رنگ و شکل کثیفی دارد، اما در باطن خود ویژگی‌ها و صفات عالی و نورانی را در خود جای داده است."],[554,"ظاهرش با باطنش گشته به جنگ","باطنش چون گوهر و ظاهر چو سنگ","ظاهر انسان (یا چیزی) با باطن او در تضاد و در حال جنگ است؛ باطن او مانند گوهر باارزش است و ظاهر او مانند سنگ بی‌ارزش."],[554,"ظاهرش گوید که ما اینیم و بس","باطنش گوید نکو بین پیش و پس","ظاهرش می‌گوید که تنها همین چیزهایی هستیم که می‌بینید، اما باطنش بیان می‌کند که خوب است به آنچه در درون داریم توجه کنید و تفاوت ما در جلو و عقب را ببینید."],[554,"ظاهرش منکر که باطن هیچ نیست","باطنش گوید که بنماییم بیست","ظاهرش مانند منکر است، اما باطن او هیچ چیز نیست. در حالی که باطنش می‌گوید که باید خود را بیست نشان دهیم."],[554,"ظاهرش با باطنش در چالش‌اند","لاجرم زین صبر نصرت می‌کشند","ظاهر و باطن او در تضاد و چالش هستند، به همین خاطر، صبر و تحمل را به خاطر پیروزی و نصرت برمی‌گزینند."],[554,"زین ترش‌رو خاک صورتها کنیم","خنده پنهانش را پیدا کنیم","به خاطر تلخی و غم ناشی از ظواهر دنیوی، باید تلاش کنیم تا لبخند نهفته و شادی باطنی را درون انسان‌ها و دنیا پیدا کنیم."],[554,"زانک ظاهر خاک اندوه و بکاست","در درونش صد هزاران خنده‌هاست","چهره‌های غمگین و اندوهناک به ظاهر دیده می‌شوند، اما در درون آن‌ها هزاران خنده و شادی نهفته است."],[554,"کاشف السریم و کار ما همین","کین نهانها را بر آریم از کمین","کاشف (آشکارکننده) رازها و پنهانی‌ها، کار ما همین است که اسرار نهفته را از مکان‌های پنهان خارج کنیم و برملا سازیم."],[554,"گرچه دزد از منکری تن می‌زند","شحنه آن از عصر پیدا می‌کند","هرچند دزد، یعنی شخص بد یا گناهکار، از کارهای زشت و خطاهایش به خود می‌بالد و فرار می‌کند، اما مقام و مأمور قانون (شحنه) می‌تواند او را از زمان و مکان شناسایی کند و به دنبال او بیفتد."],[554,"فضلها دزدیده‌اند این خاکها","تا مقر آریمشان از ابتلا","این زمین‌ها به وسیله‌ی دزدی از فضائل خالی شده‌اند، تا ما بتوانیم آن‌ها را از گرفتاری‌ها و آزمایش‌ها نجات دهیم و به مقام و جایگاه واقعی‌شان برسانیم."],[554,"بس عجب فرزند کو را بوده است","لیک احمد بر همه افزوده است","عجیب است که فرزندی وجود دارد که در نسل او پیشینیان همگی به او تعلق دارند؛ اما احمد (محمد) به تنهایی بر همه آنها برتری یافته و افزوده شده است."],[554,"شد زمین و آسمان خندان و شاد","کین چنین شاهی ز ما دو جفت زاد","زمین و آسمان به خاطر به دنیا آمدن این شاه بزرگ، بسیار شاد و خندان شده‌اند، چون این پادشاه دو پسر (حسن و حسین، فرزندان علی و فاطمه) به دنیا آورده است."],[554,"می‌شکافد آسمان از شادیش","خاک چون سوسن شده ز آزادیش","آسمان از خوشحالی شکاف برمی‌دارد و این شکاف به خاطر شادمانی زمین است، زیرا زمین مانند سوسن به خاطر آزادی‌اش به گل نشسته و زیبا شده است."],[554,"ظاهرت با باطنت ای خاک خوش","چونک در جنگ‌اند و اندر کش‌مکش","ظاهر تو با باطن تو ای زمین خوش (زیبا و دلپذیر) هماهنگ نیست، زیرا در وجود تو جنگ و تناقض وجود دارد و این ناهماهنگی در کشمکش است."],[554,"هر که با خود بهر حق باشد به جنگ","تا شود معنیش خصم بو و رنگ","هر کسی که در جستجوی حق باشد، همواره در حال مبارزه است تا به معنای واقعی خود برسد و از زوایای ظاهری و فریبنده دور شود."],[554,"ظلمتش با نور او شد در قتال","آفتاب جانش را نبود زوال","این بیت بیان می‌کند که در نبرد و چالش‌های زندگی، ظلمت (ناامیدی یا مشکلات) با نور و روشنایی وجود او (اشاره به صفات مثبت و الهی محمد) تبدیل به روشنی می‌شود و جان او هیچ‌گاه از میان نمی‌رود و نمی‌میرد."],[554,"هر که کوشد بهر ما در امتحان","پشت زیر پایش آرد آسمان","هر کسی که در امتحان و آزمایش برای ما تلاش کند، خداوند او را تا جایی بالا می‌برد که زیر پایش آسمان قرار می‌گیرد."],[554,"ظاهرت از تیرگی افغان کنان","باطن تو گلستان در گلستان","ظاهر تو با ناله و زاری شبیه تیرگی و غم است، اما باطن تو مانند گلستانی سرشار از زیبایی و طراوت است."],[554,"قاصد او چون صوفیان روترش","تا نیامیزند با هر نورکش","پیام‌آور او (محمد) مانند صوفیان، با چهره‌ای مهربان و دل‌فریب است و نمی‌گذارد با هر کسی که نور را می‌پراکند، اختلاط کند."],[554,"عارفان روترش چون خارپشت","عیش پنهان کرده در خار درشت","عارفان مانند خارپشت هستند که لذت‌ها و شادی‌های خود را در مکانی پنهان کرده‌اند؛ همان‌طور که خارپشت خودش را در بین خارها مخفی می‌کند."],[554,"باغ پنهان گرد باغ آن خار فاش","کای عدوی دزد زین در دور باش","باغی بزرگ و پنهان درون باغ دیگری وجود دارد که خاردار است؛ پس ای دشمن دزد، از این در دور باش و به آن نزدیک نشو."],[554,"خارپشتا خار حارس کرده‌ای","سر چو صوفی در گریبان برده‌ای","این بیت به کسی اشاره دارد که بذر حسادت، دشمنی یا بدخواهی را در دل خود پرورش داده و همچون خار حارس (دفاع کننده) به گونه‌ای از خود مراقبت می‌کند که در ظاهر، مانند یک عارف یا صوفی به نظر می‌رسد، در حالی که در باطن کینه و دشمنی دارد."],[554,"تا کسی دوچار دانگ عیش تو","کم شود زین گلرخان خارخو","اگر کسی بخواهد خوشی و لذت تو را کاهش دهد، باید بداند که از زیبایی‌های گل‌رخی که خار دارد، نمی‌توان غافل شد."],[554,"طفل تو گرچه که کودک‌خو بدست","هر دو عالم خود طفیل او بدست","هرچند کودک تو همچنان بداخلاق و بی‌تجربه است، اما در واقع او چونان موجودی بزرگ و ارزشمند، زیر سرپرستی و تاثیر اوست که بزرگ‌ترین دو عالم را در دستان او قرار می‌دهد."],[554,"ما جهانی را بدو زنده کنیم","چرخ را در خدمتش بنده کنیم","ما جهان را به خاطر او (محمد) زنده می‌کنیم و آسمان را در خدمت او به تسلیم درمی‌آوریم."],[554,"گفت عبدالمطلب کین دم کجاست","ای علیم السر نشان ده راه راست","عبدالمطلب می‌گوید: «این لحظه کجاست؟ ای دانای رازها، راه درست را به من نشان بده."],[555,"از درون کعبه آوازش رسید","گفت ای جوینده آن طفل رشید","از داخل کعبه صدایی به گوش می‌رسد که می‌گوید ای کسی که در جستجوی اویی، آن کودک شایسته را پیدا کن."],[555,"در فلان وادیست زیر آن درخت","پس روان شد زود پیر نیکبخت","محمد علیه‌السلام در آن وادی مشخص پایین آن درخت است و پیر نیکبخت به سرعت به آن سو می‌رود."],[555,"در رکاب او امیران قریش","زانک جدش بود ز اعیان قریش","امیران قریش در پیوستگی و همراهی با او هستند، زیرا جدش از شخصیت‌های برجسته و مهم قریش به شمار می‌رفته است."],[555,"تا به پشت آدم اسلافش همه","مهتران بزم و رزم و ملحمه","از زمان آدم به این سو، نیاکان محمد در جنگ‌ها و میهمانی‌ها همواره بزرگوار و پیشوای قوم خود بوده‌اند."],[555,"این نسب خود پوست او را بوده است","کز شهنشاهان مه پالوده است","این نسب که در اینجا به آن اشاره شده، مثل پوست او را در بر گرفته و از نسل شاهان بزرگ و پاکیزه‌ای است که در تاریخ وجود داشته‌اند."],[555,"مغز او خود از نسب دورست و پاک","نیست جنسش از سمک کس تا سماک","مغز (روح یا ذات) او از نسل‌های دور و پاکی آمده است و اصلش از یک جنس و نوع خاص نیست."],[555,"نور حق را کس نجوید زاد و بود","خلعت حق را چه حاجت تار و پود","هیچ‌کس نور حقیقت را برای زاد و توشه نمی‌جوید، و چه نیازی به کتان و پشم (یعنی مادیات) برای درک و دریافت آن خلعت الهی وجود دارد."],[555,"کمترین خلعت که بدهد در ثواب","بر فزاید بر طراز آفتاب","کمترین پاداشی که او (حق) به کسی بدهد، در ثواب و پاداش او افزوده می‌شود و وزن و ارزش آن پاداش به اندازه آفتاب است."],[556,"خیز بلقیسا بیا و ملک بین","بر لب دریای یزدان در بچین","بلقیس، برخیز و به سوی ملک خود بیا و از دریاچه رحمت خداوند، نعمت‌ها و لطف‌ها را برداشت کن."],[556,"خواهرانت ساکن چرخ سنی","تو بمرداری چه سلطانی کنی","خواهران تو در آسمان‌های بلند و جاودان زندگی می‌کنند، پس تو چه سلطنت و قدرتی داری که آن‌ها را از این مقام برکنار کنی؟"],[556,"خواهرانت را ز بخششهای راد","هیچ می‌دانی که آن سلطان چه داد","تو از بخشش‌ها و رحمت‌های خداوند اصلا اطلاع نداری و نمی‌دانی که آن سلطان (خدا) چه عطاهایی به خواهرانت (مخلوقاتش) داده است."],[556,"تو ز شادی چون گرفتی طبل‌زن","که منم شاه و رئیس گولحن","تو از خوشحالی طبل می‌زنی و اعلام می‌کنی که من شاه و رئیس گروه هستم."],[557,"آن سگی در کو گدای کور دید","حمله می‌آورد و دلقش می‌درید","سگی نابینا در کوچه‌ای گدای دیگری را می‌بیند که در حال حمله به اوست و لباسش را پاره می‌کند. در اینجا، سگ نماینده کسانی است که از وضعیت نادانی و بی‌خبری آگاه نیستند و در نتیجه به دیگران آسیب می‌زنند."],[557,"گفته‌ایم این را ولی باری دگر","شد مکرر بهر تاکید خبر","ما این موضوع را قبلا گفته‌ایم، ولی اکنون دوباره آن را تکرار می‌کنیم تا بر اهمیت آن تأکید کنیم."],[557,"کور گفتش آخر آن یاران تو","بر کهند این دم شکاری صیدجو","کور به یاران خود می‌گوید که آن‌ها هم‌اکنون بر چه کسی یا چه چیزی شکار می‌کنند. این نشان‌دهنده‌ی غفلت او از آن‌چه در اطرافش در حال وقوع است، و تأکید بر جستجوی نادرست است."],[557,"قوم تو در کوه می‌گیرند گور","در میان کوی می‌گیری تو کور","مردم هم‌نوع تو در کوه، جایگاه خود را پیدا می‌کنند، اما تو در همین خیابان، گرفتار دنیا و غافل هستی."],[557,"ترک این تزویر گو شیخ نفور","آب شوری جمع کرده چند کور","شیخ نفور که به عنوان محققی مطرح است، به انسان‌ها می‌گوید که از تزویر و فریبکاری دست بکشند؛ زیرا عده‌ای در جستجوی آب شور و بی‌فایده‌ای هستند که آنها را به کوری و غفلت می‌کشاند."],[557,"کین مریدان من و من آب شور","می‌خورند از من همی گردند کور","مریدان من، که به من وابسته‌اند، از آب شور و زهرآگین من می‌نوشند و به همین دلیل کور و نادان می‌شوند."],[557,"آب خود شیرین کن از بحر لدن","آب بد را دام این کوران مکن","خودت را از صفات و ویژگی‌های خوب پر کن و از نعمت‌های الهی بهره‌مند شو، زیرا آب بد را بر این افراد نا بینا نریزید و آنها را به گمراهی نیفکن."],[557,"خیز شیران خدا بین گورگیر","تو چو سگ چونی بزرقی کورگیر","به خدا شتاب کن و از خواب بیدار شو، زیرا در این دنیا مانند گورگیران (کسانی که مرده‌ها را می‌گیرند) در حال کندن و جستجوی مال دنیا هستی، در حالی که مانند سگ، نابینا و کور در پی چیزهای بی‌ارزش می‌دوی."],[557,"گور چه از صید غیر دوست دور","جمله شیر و شیرگیر و مست نور","گور، چه فرقی دارد از صید غیر از دوست؟ زیرا همۀ شیرها و کسانی که در پی شکارند، در نور مستی قرار دارند."],[557,"در نظاره صید و صیادی شه","کرده ترک صید و مرده در وله","انسان در تماشای شکار و شکارچی به شدت غرق شده و از پیگیری شکار و مرده دریغ می‌ورزد."],[557,"هم‌چو مرغ مرده‌شان بگرفته یار","تا کند او جنس ایشان را شکار","مرغ‌های مرده چون منتظرند که یار آنها را بگیرد تا شکار خود را به‌دست آورد، این بیانگر این است که انسان‌ها نیز گاهی در غفلت و وابستگی به دنیا قرار می‌گیرند و در انتظار فرصتی برای جذب نعمت‌ها هستند."],[557,"مرغ مرده مضطر اندر وصل و بین","خوانده‌ای القلب بین اصبعین","مرغ مرده در حال اضطراب و ناچاری، به وصل و پیوندش بین دو انگشت اشاره می‌کند. این تصویر نشان‌دهنده‌ی محدودیت و ضعف اوست، به طوری که در وضعیت فعلی‌اش نمی‌تواند کار زیادی انجام دهد."],[557,"مرغ مرده‌ش را هر آنک شد شکار","چون ببیند شد شکار شهریار","وقتی مرغ مرده‌ای را شکار کنند، اگر او ببیند که شکار شهریار (پادشاه) شده، از این موضوع خوشحال می‌شود. این بیت به اهمیت و ارزش‌گذاری در نظر انسان‌ها اشاره دارد و نشان می‌دهد که حتی اگر موجودی بی‌جان هم باشد، در موقعیت خاصی احتمالا به آن افتخار می‌کند."],[557,"هر که او زین مرغ مرده سر بتافت","دست آن صیاد را هرگز نیافت","هر کس که از این مرغ مرده (دنیا) دور شود و به سوی چیز دیگری برود، هرگز به دست صیاد (خدای دنیا) نخواهد رسید."],[557,"گوید او منگر به مرداری من","عشق شه بین در نگهداری من","آن شخص می‌گوید: به مرده بودن من نگاه نکن، عشق به خدا را ببین که چگونه مرا حفظ کرده است."],[557,"من نه مردارم مرا شه کشته است","صورت من شبه مرده گشته است","من مرده نیستم، بلکه عشق به شه (خدا یا حقیقت) مرا از زندگی دنیاوی بی‌خبر کرده است؛ به همین خاطر، ظاهر من مثل مردگان شده است."],[557,"جنبشم زین پیش بود از بال و پر","جنبشم اکنون ز دست دادگر","جنبش من پیش از این به خاطر بال و پر خودم بود، اما اکنون این حرکت را از دست خداوند دریافت کرده‌ام."],[557,"جنبش فانیم بیرون شد ز پوست","جنبشم باقیست اکنون چون ازوست","حرکت و جنبش من از پوسته مادی بدنم خارج شده و به حقیقت روحانی پیوسته است، اما باقی مانده من هنوز به همان روح وابسته است."],[557,"هر که کژ جنبد به پیش جنبشم","گرچه سیمرغست زارش می‌کشم","هر کس که در راه نادرست حرکت کند، حتی اگر به مقام بالا و شریف مانند سیمرغ برسد، من او را به زیر می‌کشم و نمی‌گذارم که برتری‌اش نمایان شود."],[557,"هین مرا مرده مبین گر زنده‌ای","در کف شاهم نگر گر بنده‌ای","هرگز مرا به عنوان یک مرده ننگر، اگر چنانچه زنده‌ای به دست شاه در دست من وجود دارد، به مقام بندگی‌ام توجه کن."],[557,"مرده زنده کرد عیسی از کرم","من به کف خالق عیسی درم","عیسی (پیامبر) به لطف و مهربانی خود مردگان را زنده می‌کرد، اما من به دست خدا که خالق عیسی است، در واقع زنده‌ام و از او زندگی می‌گیرم."],[557,"کی بمانم مرده در قبضه خدا","بر کف عیسی مدار این هم روا","چگونه می‌توانم در دستان خدا مرده بمانم، در حالی که عیسی (پیامبر) می‌تواند مرا زنده کند؟ این وضعیت ناپسند است."],[557,"عیسی‌ام لیکن هر آنکو یافت جان","از دم من او بماند جاودان","من به عیسی (علیه‌السلام) شباهت دارم، اما هر کس که جانش را بر اثر مشی من به دست آورد، او جاودانه خواهد ماند."],[557,"شد ز عیسی زنده لیکن باز مرد","شاد آنکو جان بدین عیسی سپرد","کسی که با عیسی (پیامبر) زنده شده و زندگی دوباره یافته، اما اگر جانش را به او نسپرد، همچنان مرده و بی‌خبر از شادی و سرزندگی است."],[557,"من عصاام در کف موسی خویش","موسیم پنهان و من پیدا به پیش","من مانند عصای موسی هستم که او را در دست دارد، در واقع در باطن من همانی است که موسی دارد، اما در ظاهر فقط خودم را می‌بینید."],[557,"بر مسلمانان پل دریا شوم","باز بر فرعون اژدها شوم","من می‌خواهم در میان مسلمانان به عنوان پلی برای عبور از دریا و رسیدن به حق عمل کنم، اما در عین حال اگر فرعون (نماد ظلم و کفر) باشم، به شکل اژدهایی خطرناک تبدیل خواهم شد."],[557,"این عصا را ای پسر تنها مبین","که عصا بی‌کف حق نبود چنین","عصای موسی را، ای پسر، به تنهایی ننگر که این عصا بدون کفایت و قدرت الهی چنین کارها نمی‌کند."],[557,"موج طوفان هم عصا بد کو ز درد","طنطنه جادوپرستان را بخورد","موج طوفان نیز مانند عصا در دست خداوند است، زیرا از درد و فریب جادوگران و ساحران ناشی می‌شود و آن‌ها را در آزار می‌زند."],[557,"گر عصاهای خدا را بشمرم","زرق این فرعونیان را بر درم","اگر تعداد عصاهای خدا را بشمارم، زرق و فریب و تظاهر این فرعونیان، یعنی بزرگ‌مردان ستمگر، جلو در خانه‌ام خواهد بود."],[557,"لیک زین شیرین گیای زهرمند","ترک کن تا چند روزی می‌چرند","اما این مرفه‌ها و خوش‌گذران‌ها را رها کن، چون زندگی‌ آن‌ها مانند عسل شیرین، ولی در حقیقت زهرآلود و مضر است. تا کی می‌خواهی در دنیا و خوشی‌های آن غرق شوی؟"],[557,"گر نباشد جاه فرعون و سری","از کجا یابد جهنم پروری","اگر جاه و مقام فرعون نباشد و شخصی هم نتواند به مقام بلند برسد، از کجا می‌تواند به جهنم و عذاب آن راه پیدا کند؟"],[557,"فربهش کن آنگهش کش ای قصاب","زانک بی‌برگ‌اند در دوزخ کلاب","ای قصاب، او را فربه کن (چاق‌اش کن) و سپس بکش، زیرا در دوزخ، سگ‌ها بی‌برگ‌اند و به جایی در نمی‌آیند. اینجا به نادانی کسانی اشاره دارد که به دنیا دل‌بسته‌اند و از عواقب آن غافلند."],[557,"گر نبودی خصم و دشمن در جهان","پس بمردی خشم اندر مردمان","اگر در این دنیا خصم و دشمنی وجود نداشت، انسان‌ها نیز به خاطر خشم و تضاد نمی‌مردند و زندگی‌اشان به آرامی سپری می‌شد."],[557,"دوزخ آن خشمست خصمی بایدش","تا زید ور نی رحیمی بکشدش","دوزخ همان خشم است، و وجود دشمنی در عالم ضروری است تا انسان به رشد و ترقی برسد؛ اگر نبود، رحمت و مهربانی او را از جلو رفتن بازمی‌دارد."],[557,"پس بماندی لطف بی‌قهر و بدی","پس کمال پادشاهی کی بدی","پس از قهر و بدی، لطف و رحمت باقی می‌ماند و این نشان‌دهنده تکامل و کمال در فرمانروایی است که در آن، بدی جایی ندارد."],[557,"ریش‌خندی کرده‌اند آن منکران","بر مثلها و بیان ذاکران","منکران، به بیان و مثل‌های یاد شده از سوی ذاکران (گفت‌وگوی کنندگان در باب حقیقت و معنویت) خنده کرده و آن‌ها را تمسخر می‌کنند."],[557,"تو اگر خواهی بکن هم ریش‌خند","چند خواهی زیست ای مردار چند","اگر می‌خواهی به مسخره کردن و ریش‌خند زدن ادامه دهی، در این صورت چند صباحی دیگر زندگی خواهی کرد، ای کسی که مانند مرده‌ای هستی."],[557,"شاد باشید ای محبان در نیاز","بر همین در که شود امروز باز","ای کسانی که به عشق و محبت می‌پردازید، شاد باشید؛ زیرا امروز در این در (درگاه خدا) که همیشه بسته بود، باز شده و این فرصتی است برای نیاز و درخواست شما."],[557,"هر حویجی باشدش کردی دگر","در میان باغ از سیر و کبر","هر نوعی از سبزیجات که به خودت مربوط می‌شود (یا با آن نسبت داری)، در باغی دیگر از طمع و بزرگ‌منشی در سر می‌پروراند."],[557,"هر یکی با جنس خود در کرد خود","از برای پختگی نم می‌خورد","هر شخصی برای تکامل و پختگی خود از چیزهایی استفاده می‌کند که مربوط به ذات و جنس خودش است."],[557,"تو که کرد زعفرانی زعفران","باش و آمیزش مکن با دیگران","تو که رنگ و بوی زعفران را به خود گرفته‌ای، باید همانند زعفران باشی و با دیگران که رنگ و بوی متفاوت دارند، درآمیختگی نداشته باشی."],[557,"آب می‌خور زعفرانا تا رسی","زعفرانی اندر آن حلوا رسی","اگر می‌خواهی مثل زعفران باکیفیت و باارزش باشی، باید به زندگی و وجود خود توجه کنی و از عسل و لذت‌های دنیایی بهره‌برداری کنی تا در مرحله‌ای به کیفیت بالاتری برسی."],[557,"در مکن در کرد شلغم پوز خویش","که نگردد با تو او هم‌طبع و کیش","به خودت فشار نیاور و خودت را درگیر کارهای بیهوده نکن، زیرا که شلغم (نمادی از چیزهای معمولی و بی‌ارزش) هرگز نمی‌تواند هم‌نوع و هم‌جنس تو شود."],[557,"تو بکردی او بکردی مودعه","زانک ارض الله آمد واسعه","تو هم کارهای خود را کردی، و او نیز کارهای خود را انجام داد. این را بدان که زمین خدا وسیع است و امکانات زیادی در آن وجود دارد."],[557,"خاصه آن ارضی که از پهناوری","در سفر گم می‌شود دیو و پری","خصوصا آن سرزمین‌هایی که در وسعت خود، انسان را در سفر از واقعیت و حقیقت گم می‌کنند، موجودات خیالی مانند دیو و پری را به وجود می‌آورند."],[557,"اندر آن بحر و بیابان و جبال","منقطع می‌گردد اوهام و خیال","در آن دریا و بیابان و کوه‌های بلند، توهمات و خیال‌ها پایان می‌یابند و واقعیات نمایان می‌شوند."],[557,"این بیابان در بیابانهای او","هم‌چو اندر بحر پر یک تای مو","این بیابان (دنیای مادی) در مقایسه با بیابان‌های دیگر (جهانت‌های مختلف) مانند دریایی است که پر از تار مویی است. اشاره به این دارد که دنیای مادی به اندازه‌ای کوچک و ناچیز است."],[557,"آب استاده که سیرستش نهان","تازه‌تر خوشتر ز جوهای روان","آبی که در جایی ساکن و ایستاده است، اگرچه به ظاهر جاندار و شاداب است، اما تازه‌تر و لذت‌ بخش‌تر از جوی‌های روانی است که مداوم جاری می‌شوند."],[557,"کو درون خویش چون جان و روان","سیر پنهان دارد و پای روان","انسان درون خود، همچون جان و روح، با نیازی پنهان سیر می‌کند و همیشه در جستجوی چیزی فراتر از آنچه که در ظاهر می‌بیند، است."],[557,"مستمع خفتست کوته کن خطاب","ای خطیب این نقش کم کن تو بر آب","مخاطب خواب‌آلود و بی‌توجه است، ای سخنران، سخن خود را کوتاه کن و این نقاشی را که به صورت تو خالی و بی‌محتواست، کم‌رنگ‌تر کن."],[557,"خیز بلقیسا که بازاریست تیز","زین خسیسان کسادافکن گریز","بلقیس که زنی باهوش و تیزهوش است، را به حرکت وادار کن، زیرا در این بازار (دنیا) افرادی بی‌ارزش وجود دارند که باعث کسادی و خرابی آن می‌شوند."],[557,"خیز بلقیسا کنون با اختیار","پیش از آنک مرگ آرد گیر و دار","بلقیس، باید با اراده و تصمیم خود به فعالیت و تلاش بپردازد، زیرا پیش از آنکه مرگ او را گرفتار کند، باید از فرصت‌ها استفاده کند."],[557,"بعد از آن گوشت کشد مرگ آنچنان","که چو دزد آیی به شحنه جان‌کنان","زمانی که مرگ فرا برسد، مثل دزدی که به ناگاه به خانه‌ای وارد می‌شود، جان آدمی را به زور می‌گیرد و او را از دنیا می‌برد."],[557,"زین خران تا چند باشی نعل‌دزد","گر همی دزدی بیا و لعل دزد","تو تا کی باید مانند خرانی که نعل دزدیده‌اند، در این زندگی دنیوی بگردی؟ اگر دزدی می‌کنی، بیا و جواهرات واقعی و والای روحانی را دزدیده و به دست بیاور."],[557,"خواهرانت یافته ملک خلود","تو گرفته ملکت کور و کبود","خواهران تو (روحانیان) به سرای جاودانی رسیده‌اند، ولی تو تنها ملکی (دنیا) را به دست آورده‌ای که ناپایدار و نقصانی است."],[557,"ای خنک آن را کزین ملکت بجست","که اجل این ملک را ویران‌گرست","خوشا به حال کسی که از این دنیا و ملک مادی بگریزد، زیرا که مرگ، ویران‌کننده این ملک و زندگی دنیوی است."],[557,"خیز بلقیسا بیا باری ببین","ملکت شاهان و سلطانان دین","بلقیس، ملکه سبا، از خواب بیدار شو و به دیدن سرزمین پادشاهان و حاکمان دین حاضر شو."],[557,"شسته در باطن میان گلستان","ظاهر آحادی میان دوستان","در باطن انسان‌ها، محبت و دوستی وجود دارد، اما در ظاهر، گاهی اوقات مانند گلستان، اختلاف و تفرقه به چشم می‌خورد. این نشان‌دهنده‌ی تفاوت میان احوال درونی و ظاهر سازی در روابط دوستانه است."],[557,"بوستان با او روان هر جا رود","لیک آن از خلق پنهان می‌شود","بوستان روحانی در هر جا که برود، با او همراه است، اما این حقیقت برای مردم عادی پنهان می‌ماند."],[557,"میوه‌ها لابه‌کنان کز من بچر","آب حیوان آمده کز من بخور","میوه‌ها به ناله و زاری می‌گویند که از من به آب حیات و زندگی دست پیدا کرده‌اند، پس از من بخورید و بهره‌مند شوید."],[557,"طوف می‌کن بر فلک بی‌پر و بال","هم‌چو خورشید و چو بدر و چون هلال","مانند خورشید، ماه و هلال، به آسمان بپرواز و به طور آزاد و بدون هیچ قید و شرطی حرکت کن. این جمله ما را به آزادی و کمال روحانی دعوت می‌کند که نه وابسته به دنیا باشیم و نه محدود به مسائل مادی."],[557,"چون روان باشی روان و پای نی","می‌خوری صد لوت و لقمه‌خای نی","اگر روح انسان آزاد و رها باشد، مانند آبی روان نمی‌تواند در قید و بند ماده و خواسته‌های دنیوی بماند و به راحتی از نعمت‌ها و لذت‌های معنوی بهره‌مند می‌شود."],[557,"نی‌نهنگ غم زند بر کشتیت","نی پدید آید ز مردم زشتیت","غم و اندوه مانند نی‌نهنگ بر کشتی زندگی‌ات فشار می‌آورد و این غم را از زشتی‌های مردم به وجود می‌آید."],[557,"هم تو شاه و هم تو لشکر هم تو تخت","هم تو نیکوبخت باشی هم تو بخت","تو هم پادشاه و هم سرباز هستی؛ هم تخت و تاج تو را می‌سازد و هم خوشبختی تو، و در واقع خود تو سرنوشت‌ساز هستی."],[557,"گر تو نیکوبختی و سلطان زفت","بخت غیر تست روزی بخت رفت","اگر تو خوشبخت و صاحب مقام و ثروت هستی، بدان که این خوشبختی و قدرت تنها برای تو نیست و روزی این بخت از تو جدا خواهد شد."],[557,"تو بماندی چون گدایان بی‌نوا","دولت خود هم تو باش ای مجتبی","تو مانند گدایان بی‌نوا مانده‌ای و از نعمت‌های روحانی خود غافلی، در حالی که خودت از آن نعمت‌ها صاحب می‌شوی، ای مجتبی (لقب اشاره به یکی از افراد مقدس، مانند امام مجتبی)."],[557,"چون تو باشی بخت خود ای معنوی","پس تو که بختی ز خود کی گم شوی","اگر تو به سیرت معنوی خود بپردازی و خوب و نیکو باشی، دیگر چگونه ممکن است که بخت و شانس خوبت را از دست بدهی."],[557,"تو ز خود کی گم شوی ای خوش‌خصال","چونک عین تو ترا شد ملک و مال","تو چگونه گم می‌شویی ای خوش‌اخلاق، وقتی که خودت و همه‌چیزهایی که به تو تعلق دارد، همان ثروت و دارایی تو هستند."],[558,"ای سلیمان مسجد اقصی بساز","لشکر بلقیس آمد در نماز","ای سلیمان، مسجد اقصی را بساز، زیرا لشکر بلقیس برای نماز حاضر شده است."],[558,"چونک او بنیاد آن مسجد نهاد","جن و انس آمد بدن در کار داد","زمانی که سلیمان علیه‌السلام اساس مسجد اقصی را بنا کرد، جن و انسان به کمک او شتافتند و در ساخت آن تلاش کردند."],[558,"یک گروه از عشق و قومی بی‌مراد","هم‌چنانک در ره طاعت عباد","گروهی از مردم به عشق و محبت خداوندشان پیوسته‌اند، اما به هیچ خواسته‌ای نرسیده‌اند. مانند این افراد، برخی دیگر نیز در مسیر عبادت و اطاعت از خداوند هستند."],[558,"خلق دیوانند و شهوت سلسله","می‌کشدشان سوی دکان و غله","مردم مانند دیوانه‌ها هستند و شهوت آنها را به‌سوی بازارها و کالاها می‌کشاند."],[558,"هست این زنجیر از خوف و وله","تو مبین این خلق را بی‌سلسله","این زنجیری که شما می‌بینید، از ترس و وحشت ناشی می‌شود و این‌طور نیست که این افراد (خلق) بدون رشته و پیوند باشند."],[558,"می‌کشاندشان سوی کسب و شکار","می‌کشاندشان سوی کان و بحار","خداوند انسان‌ها را به سوی تلاش و کار کشانده و آن‌ها را به جستجوی روزی و منابع زندگی وادار می‌کند، خواه این منابع در دل زمین (معادن) باشد یا در دریاها."],[558,"می‌کشدشان سوی نیک و سوی بد","گفت حق فی جیدها حبل المسد","خداوند انسان‌ها را به سمت کارهای نیک و بد می‌کشاند. در اینجا اشاره به آیه‌ای از قرآن است که می‌گوید خداوند بر گردن‌های انسان‌ها رشته‌ای است (اشاره به رهبری و هدایت الهی) که آن‌ها را به سوی اعمالشان هدایت می‌کند."],[558,"قد جعلنا الحبل فی اعناقهم","واتخذنا الحبل من اخلاقهم","ما رشته اخلاق را در گردن آنها قرار داده‌ایم و رشته‌ای را از ویژگی‌های آنها برگزیده‌ایم."],[558,"لیس من مستقذر مستنقه","قط الا طایره فی عنقه","هیچ موجود ناپاکی وجود ندارد که در دامی نیفتد، مگر اینکه پرنده‌ای به گردن او باشد."],[558,"حرص تو در کار بد چون آتشست","اخگر از رنگ خوش آتش خوشست","حرص و میل تو به کارهای نیک مثل آتش است که زبانه‌هایش از رنگ زیبا و دل‌فریب آتش خوش محسوب می‌شود. در واقع، این حرص در ظاهر زیباست، اما در باطن می‌تواند خطرناک و ویرانگر باشد."],[558,"آن سیاهی فحم در آتش نهان","چونک آتش شد سیاهی شد عیان","سیاهی که به عنوان زغال در آتش پنهان است، وقتی آتش افروخته می‌شود، خود را نمایان می‌کند. به این معنا که کارهای پنهان و ناپسند انسان زمانی که برملا شوند، آشکار می‌گردند."],[558,"اخگر از حرص تو شد فحم سیاه","حرص چون شد ماند آن فحم تباه","حرص تو باعث شد که اخگر (فوران آتش) به فحم سیاه تبدیل شود و وقتی حرص تو تمام شد، آن فحم نیز نابود شد."],[558,"آن زمان آن فحم اخگر می‌نمود","آن نه حسن کار نار حرص بود","در آن زمان، آن ماده سیاه (فحم) مانند شعله آتش به نظر می‌رسید، اما این زیبایی، ناشی از کار خوب نبود، بلکه به خاطر حرص و طمع (نار) بود."],[558,"حرص کارت را بیاراییده بود","حرص رفت و ماند کار تو کبود","حرص و طمع، کار تو را زینت داده بود، اما حالا که حرص رفته است، کار تو به بدی و نقصان رسیده است."],[558,"غوله‌ای را که بر آرایید غول","پخته پندارد کسی که هست گول","کسی که غول بزرگ را تزیین می‌کند، به‌طور ناآگاهانه آن را به‌عنوان غول پخته تصور می‌کند، در حالی که او خود در واقع فریفته و گول خورده است."],[558,"آزمایش چون نماید جان او","کند گردد ز آزمون دندان او","وقتی آزمون جان او را نشان می‌دهد، او از تجربه‌اش قوی‌تر و سرفرازتر می‌شود."],[558,"از هوس آن دام دانه می‌نمود","عکس غول حرص و آن خود خام بود","این بیت به این معناست که هوس و تمایلات انسان مانند دام‌هایی است که خطرات و مشکلاتی را به همراه دارد. غول حرص، که نشانه‌ای از طمع و آرزوهای بی‌پایان است، در حقیقت خود را نشان می‌دهد و انسان را در دام خود اسیر می‌کند، در حالی که خود او (انسان) نیز در رنج و سختی قرار دارد."],[558,"حرص اندر کار دین و خیر جو","چون نماند حرص باشد نغزرو","حرص در کار دین و خیر، چون نباشد، به طور طبیعی باقی نمی‌ماند و این حرص است که باعث لطافت و زیبایی می‌شود."],[558,"خیرها نغزند نه از عکس غیر","تاب حرص ار رفت ماند تاب خیر","خیر و نیکی‌ها به خاطر تقلید از دیگری به وجود نمی‌آیند. اگر حرص بر دنیا و خواسته‌های آن از بین برود، فقط نیکی و خیر واقعی باقی خواهد ماند."],[558,"تاب حرص از کار دنیا چون برفت","فحم باشد مانده از اخگر بتفت","هنگامی که حرص و خواهش‌های دنیوی از میان برود، درک حقیقت باقی می‌ماند و مانند آتش خاموشی که فقط خاکسترش باقی می‌ماند، تنها جاودانگی و خرد در ما می‌ماند."],[558,"کودکان را حرص می‌آرد غرار","تا شوند از ذوق دل دامن‌سوار","حرص و طمع به کار دنیا باعث می‌شود که کودکان در بازی و لذت خود، شوق و ذوقی داشته باشند و این شوق آنها را به فعالیت‌ها و بازی‌های سرگرم‌کننده وا می‌دارد."],[558,"چون ز کودک رفت آن حرص بدش","بر دگر اطفال خنده آیدش","زمانی که حرص و ولع کودکانه از او دور شود، دیگر بچه‌ها از رفتار او می‌خندند و به او با شگفتی نگاه می‌کنند."],[558,"که چه می‌کردم چه می‌دیدم درین","خل ز عکس حرص بنمود انگبین","در این بیت، گوینده به تأمل در کارهای خود می‌پردازد و به این نکته اشاره می‌کند که در این بی‌سنگ‌بنایی (خل) چه چیزهایی را می‌ساخته و می‌دیده؛ حاصل کارش به خاطر تأثیر حرص به روشنی نمایان می‌شود، همان‌طور که رنگ زرد عسل (انگبین) به وضوح تصویرها را نشان می‌دهد."],[558,"آن بنای انبیا بی حرص بود","زان چنان پیوسته رونقها فزود","بنای پیامبران به خاطر خلوص نیت و بی‌حرص بودنشان هرگز کم‌سرعت نشده و همواره رونق و شکوه آن افزایش یافته است."],[558,"ای بسا مسجد بر آورده کرام","لیک نبود مسجد اقصاش نام","بسیاری از مساجد ساخته شده‌اند که دارای ویژگی‌های خاص و شگرف هستند، اما هیچ‌یک به نام مسجد اقصی نمی‌رسد."],[558,"کعبه را که هر دمی عزی فزود","آن ز اخلاصات ابراهیم بود","هر بار که کعبه به شکوه و عظمت خود افزوده می‌شود، این ناشی از اخلاص و نیت خالصانه ابراهیم است."],[558,"فضل آن مسجد خاک و سنگ نیست","لیک در بناش حرص و جنگ نیست","فضیلت و ارزش مسجد فقط به خاک و سنگ آن نیست، بلکه در ساخت و بنا کردن آن، حرص و جنگ و حسد جای ندارد."],[558,"نه کتبشان مثل کتب دیگران","نی مساجدشان نی کسب وخان و مان","کتاب‌های آن‌ها مانند کتاب‌های دیگران نیست و مساجد آن‌ها نیز همچون خانه‌ها و محل‌های کسب و کار نیست."],[558,"نه ادبشان نه غضبشان نه نکال","نه نعاس و نه قیاس و نه مقال","آداب و رفتارشان مانند دیگران نیست؛ نه ادب دارند، نه خشم، نه دعا و نذر، نه خواب و استراحت، نه استدلال و قیاس، و نه سخن."],[558,"هر یکیشان را یکی فری دگر","مرغ جانشان طایر از پری دگر","هر یک از آنها (ملایکه و دیگر موجودات) دارای یک کمک یا یاری از نوعی دیگر هستند، و جان هر یک مانند پرنده‌ای از نوعی دیگر یا به عبارتی دیگر برای پرواز است."],[558,"دل همی لرزد ز ذکر حالشان","قبله افعال ما افعالشان","دل انسان از یاد کردن حال آن پرندگان می‌لرزد؛ چرا که اعمال ما، قبله و مرجع افعال آن‌هاست."],[558,"مرغشان را بیضه‌ها زرین بدست","نیم‌شب جانشان سحرگه بین شدست","پرنده‌های آن قوم تخم‌هایی طلایی دارند و در نیمه‌های شب، جانشان در سحرگاه در حال پرواز و زندگی دوباره است."],[558,"هر چه گویم من به جان نیکوی قوم","نقص گفتم گشته ناقص‌گوی قوم","هر چه من از خوبی‌های این قوم بگویم، در واقع به آن‌ها ایراد گرفته‌ام و چیزی ناقص گفته‌ام."],[558,"مسجد اقصی بسازید ای کرام","که سلیمان باز آمد والسلام","ای انسان‌های نیکوکار، بیایید مسجد اقصی را بسازید که سلیمان (پادشاه بنی‌اسرائیل و پیامبر) به زودی بازمی‌گردد و بر ما سلام خواهد داد."],[558,"ور ازین دیوان و پریان سر کشند","جمله را املاک در چنبر کشند","اگر دیوان و پریان سرکشی کنند، همه را در دام خود گرفتار می‌کنند و در چنگال خویش اسیر می‌سازند."],[558,"دیو یک دم کژ رود از مکر و زرق","تازیانه آیدش بر سر چو برق","دیو وقتی از نیرنگ و فریب خود خارج شود، به اندازه‌ای تحت فشار و ضربه قرار می‌گیرد که مانند صاعقه به سرش می‌خورد."],[558,"چون سلیمان شو که تا دیوان تو","سنگ برند از پی ایوان تو","به مانند سلیمان باش تا دیوان و موجودات ناپاک از درگاه تو دور شوند و به تو آسیبی نرسانند."],[558,"چون سلیمان باش بی‌وسواس و ریو","تا ترا فرمان برد جنی و دیو","مثل سلیمان باش که بی‌نگرانی و تردید است، تا جن و دیو نیز به تو تسلیم شوند و از تو پیروی کنند."],[558,"خاتم تو این دلست و هوش دار","تا نگردد دیو را خاتم شکار","خاتم تو، که نماد قدرت و سلطنت است، در واقع دل و عقل تو هستند. باید هوشیار باشی تا مبادا دلت فریب دیو‌ها را بخورد و آن‌ها نتوانند تو را به دام بیندازند."],[558,"پس سلیمانی کند بر تو مدام","دیو با خاتم حذر کن والسلام","سلیمان همواره بر تو نظارت دارد، بنابراین باید از دیو بپرهیزی و به این موضوع توجه کنی."],[558,"آن سلیمانی دلا منسوخ نیست","در سر و سرت سلیمانی کنیست","سلیمان، پیامبر بزرگ، از بین نرفته و هنوز هم در دل تو وجود دارد، و تو نیز می‌توانی به او اقتدا کنی و مانند او عمل کنی."],[558,"دیو هم وقتی سلیمانی کند","لیک هر جولاهه اطلس کی تند","دیو نیز زمانی که به کار سلیمان مشغول می‌شود، نمی‌تواند کارش را به خوبی انجام دهد؛ چرا که هر استادکار یا جولاهه‌ای که پارچه قیمتی (اطلس) را می‌بافد، باید مهارت و توانایی خاصی داشته باشد."],[558,"دست جنباند چو دست او ولیک","در میان هر دوشان فرقیست نیک","سلیمان به کمک ملایکه و دیگر نیروی‌های موجود مشغول ساخت و سامان‌دهی است، اما هر کدام از آنها در کار خود استعداد و قدرت متفاوتی دارند، به همین خاطر در میان آنها تفاوتی واضح وجود دارد."],[559,"شاعری آورد شعری پیش شاه","بر امید خلعت و اکرام و جاه","شاعری شعری به نزد شاه آورد به امید دریافت هدیه و احترام و پیشرفت در مقام و موقعیت اجتماعی."],[559,"شاه مکرم بود فرمودش هزار","از زر سرخ و کرامات و نثار","شاه بزرگوار بود و به شاعر دستور داد هزار دینار (زر سرخ) و هدیه‌هایی دیگر به او بدهند."],[559,"پس وزیرش گفت کین اندک بود","ده هزارش هدیه وا ده تا رود","وزیر به شاه می‌گوید که این مبلغ کم است و باید این هدیه را ده برابر کند تا ارزش بیشتری پیدا کند."],[559,"از چنو شاعر نس از تو بحردست","ده هزاری که بگفتم اندکست","اگر شاعر به تو اینقدر درک و توانایی دارد، پس ده‌هزار که من گفتم چیزی نیست و واقعا اندک به حساب می‌آید."],[559,"فقه گفت آن شاه را و فلسفه","تا برآمد عشر خرمن از کفه","فقیه (عالم دینی) و فیلسوف (عالم فلسفه) به شاه گفتند که باید از ده هزار، یک دهم آن (عشر) به عنوان حق خراج و مالیات برداشته شود."],[559,"ده هزارش داد و خلعت درخورش","خانه شکر و ثنا گشت آن سرش","شاه ده هزار درهم به شاعر داد و همراه آن هدیه‌ای مناسب به او بخشید، به طوری که منزلت و مقامش به خاطر این بخشش شکر و ثنا ایجاد کرد."],[559,"پس تفحص کرد کین سعی کی بود","شاه را اهلیت من کی نمود","شاه بررسی کرد که تلاش برای این کار به چه کسی تعلق دارد و من چه لیاقتی برای این مقام دارم."],[559,"پس بگفتندش فلان‌الدین وزیر","آن حسن نام و حسن خلق و ضمیر","پس به او گفتند که وزیر به نام «فلان‌الدین» است که هم حسن‌نام و هم نیک‌خلق و باطنی پاک دارد."],[559,"در ثنای او یکی شعری دراز","بر نبشت و سوی خانه رفت باز","شاعر شعری طولانی در ستایش وزیر بوالحسن نوشت و سپس به سمت خانه‌اش رفت."],[559,"بی‌زبان و لب همان نعمای شاه","مدح شه می‌کرد و خلعتهای شاه","شاعر به شکلی بی‌صدا و بدون استفاده از زبان و لب، در حال ستایش و مدح شاه بود و هدایای او را وصف می‌کرد."],[560,"بعد سالی چند بهر رزق و کشت","شاعر از فقر و عوز محتاج گشت","پس از گذشت چند سال، به خاطر تامین معیشت و درآمد، شاعر به دلیل فقر و نیاز مالی به وضعیتی دشوار افتاده است."],[560,"گفت وقت فقر و تنگی دو دست","جست و جوی آزموده بهترست","او می‌گوید در زمان فقر و تنگدستی بهتر است که از کسی که تجربه و سابقه کرم دارد، درخواست کمک کنیم."],[560,"درگهی را که آزمودم در کرم","حاجت نو را بدان جانب برم","ساحتی را که قبلا به خاطر مهربانی‌اش آزموده‌ام، درخواستم را به آن سو می‌برم تا به حاجتم پاسخ داده شود."],[560,"معنی الله گفت آن سیبویه","یولهون فی الحوائج هم لدیه","خدای بزرگ، این شاعر (سیبویه) را در برآورده شدن نیازهایمان بسیار مورد توجه قرار می‌دهد و در حقیقت، ما در می‌یابیم که آنچه می‌خواهیم نزد اوست."],[560,"گفت الهنا فی حوائجنا الیک","والتمسناها وجدناها لدیک","گفتند: ای پروردگار ما، در امور و نیازهایمان به تو روی آوردیم و هنگامی که به درگاه تو درخواست کردیم، آنها را در وجود تو یافتیم."],[560,"صد هزاران عاقل اندر وقت درد","جمله نالان پیش آن دیان فرد","در زمان گرفتاری و درد، صدها هزار انسان عاقل به سوی دیوانگان بی‌فکر (دیان فرد) می‌روند و همگی ناله و فریاد می‌کنند."],[560,"هیچ دیوانه فلیوی این کند","بر بخیلی عاجزی کدیه تند","هیچ دیوانه‌ای انجام این کار را نمی‌کند، زیرا بر اثر بخلی و ناتوانی از انجام آن، به تندی و بی‌فکری خود دچار می‌شود."],[560,"گر ندیدندی هزاران بار بیش","عاقلان کی جان کشیدندیش پیش","اگر عاقلان هزاران بار هم آن را ببینند، باز هم نمی‌دانند که جانشان را برای چه چیزی می‌کشند."],[560,"بلک جمله ماهیان در موجها","جمله پرندگان بر اوجها","همه ماهی‌ها در آب و در امواج در حال شنا کردن هستند و همه پرندگان در آسمان و در اوج در حال پروازند."],[560,"پیل و گرگ و حیدر اشکار نیز","اژدهای زفت و مور و مار نیز","در این بیت، اشاره به موجودات و نمادهایی است که در دل طبیعت و داستان‌ها وجود دارند؛ مثل فیل و گرگ و حیدر (نشان‌دهنده دلاوری و قدرت) و همچنین اژدها (یک موجود افسانه‌ای) و سایر مخلوقات کوچک‌تر مانند موریانه و مار. این تصویرسازی به تنوع و وسعت موجودات عالم اشاره دارد."],[560,"بلک خاک و باد و آب و هر شرار","مایه زو یابند هم دی هم بهار","هر چیزی از جمله خاک و باد و آب و هر آتش، از او (خدا) نشأت می‌گیرد و هر دو (زمستان و بهار) نیز از او بهره‌مند می‌شوند."],[560,"هر دمش لابه کند این آسمان","که فرو مگذارم ای حق یک زمان","هر لحظه این آسمان از من درخواست می‌کند که مرا رها نکن، ای خداوند، حتی برای یک لحظه."],[560,"استن من عصمت و حفظ تو است","جمله مطوی یمین آن دو دست","عصمت و حفاظت من به وسیله تو است؛ همه این اعمال و کارها در دستان تو نهفته است."],[560,"وین زمین گوید که دارم بر قرار","ای که بر آبم تو کردستی سوار","زمین می‌گوید که من پایدار هستم، ای کسی که تو بر روی آب‌ها سواری می‌کنی."],[560,"جملگان کیسه ازو بر دوختند","دادن حاجت ازو آموختند","گروهی برای او کیسه‌هایی دوخته‌اند و از او یاد گرفته‌اند که چگونه باید نیازهای خود را برآورده کنند."],[560,"هر نبیی زو برآورده برات","استعینوا منه صبرا او صلات","هر پیامبری برای خود نامه‌ای از خداوند گرفته که در آن دستور داده‌اند برای یاری به او صبر کنید و نماز بخوانید."],[560,"هین ازو خواهید نه از غیر او","آب در یم جو مجو در خشک جو","از او بخواهید، نه از دیگران، زیرا آب زندگی را تنها از او می‌توان یافت؛ در جستجوی آب در جوی خشک نروید، بلکه در دریا جستجو کنید."],[560,"ور بخواهی از دگر هم او دهد","بر کف میلش سخا هم او نهد","اگر بخواهی از کس دیگری هم چیزی به تو می‌دهد، اما او کسی است که باید خواسته‌ات را از دلش بخواهی و تنها او می‌تواند با generosity (بخشش) به تو بدهد."],[560,"آنک معرض را ز زر قارون کند","رو بدو آری به طاعت چون کند","شاعر می‌گوید کسی که خواسته‌های خود را به طلا و ثروت گزاف می‌آراید، چگونه می‌تواند به آسیبی که به او می‌رسد، رضایت دهد و اطاعت کند. این بیت به گروهی اشاره دارد که از ثروت به‌عنوان ابزاری برای دستیابی به قدرت یا مقام استفاده می‌کنند، اما در واقع از عواقب آن آگاه نیستند."],[560,"بار دیگر شاعر از سودای داد","روی سوی آن شه محسن نهاد","شاعر دوباره از روی طمع و امید به دریافت پاداش، به سمت شاه محسن روی آورد."],[560,"هدیه شاعر چه باشد شعر نو","پیش محسن آرد و بنهد گرو","هدیه شاعر به محسن چه خواهد بود؟ شعری تازه خواهد آورد و آن را به عنوان امانت به او خواهد سپرد."],[560,"محسنان با صد عطا و جود و بر","زر نهاده شاعران را منتظر","محسن با عطا و بخشش بسیار، شاعران را در انتظار گذاشته است و آن‌ها به امید دریافت پاداش در پی او هستند."],[560,"پیششان شعری به از صدتنگ شعر","خاصه شاعر کو گهر آرد ز قعر","شاعر در مقابل این بخش بزرگی از بخشش و جود، شعری می‌سراید که از صدها شعر بهتر است؛ زیرا شاعر از عمق وجود خود، گوهرهایی را بیرون می‌آورد که ارزشمندتر از هر چیز دیگرند."],[560,"آدمی اول حریص نان بود","زانک قوت و نان ستون جان بود","آدمی در ابتدا به خاطر نیاز به غذا و نان طمع و حرص دارد، زیرا نان بنیاد و اساس زندگی اوست."],[560,"سوی کسب و سوی غصب و صد حیل","جان نهاده بر کف از حرص و امل","انسان برای به دست آوردن روزی و ثروت، به هر ترفند و نیرنگی متوسل می‌شود و برای رسیدن به خواسته‌هایش، جان خود را به خطر می‌اندازد، به خاطر حرص و آرزوهایش."],[560,"چون بنادر گشت مستغنی ز نان","عاشق نامست و مدح شاعران","چون بندرها و مناطق مختلف بی‌نیاز از نان و غذا شدند، نام عاشقان و ستایش شاعران در میان مردم مشهور و مطرح شده است."],[560,"تا که اصل و فصل او را بر دهند","در بیان فضل او منبر نهند","وقتی به اصل و نسب او توجه کنند و به تعریف و تمجید از او بپردازند، او را بر منبری قرار می‌دهند تا به دیگران درباره‌ی فضایلش بگویند."],[560,"تا که کر و فر و زر بخشی او","هم‌چو عنبر بو دهد در گفت و گو","تا زمانی که قدرت و جذابیت او مانند بوی خوش عنبر در کلام و گفتار او احساس شود."],[560,"خلق ما بر صورت خود کرد حق","وصف ما از وصف او گیرد سبق","خلق (آفریدگان) به شکل خود حق را می‌سازد، یعنی مردم ویژگی‌ها و صفات خود را به جهان نسبت می‌دهند و وصف خداوند را از طریق صفات خود درک می‌کنند و به آن فخر می‌فروشند."],[560,"چونک آن خلاق شکر و حمدجوست","آدمی را مدح‌جویی نیز خوست","چون خداوند خلاق (آفریدگار) شکر و ستایش را دوست دارد، انسان نیز به ستایش و مدح دیگران تمایل دارد."],[560,"خاصه مرد حق که در فضلست چست","پر شود زان باد چون خیک درست","مرد حق که در شایستگی و فضیلت سرآمد است، به‌راحتی و به سرعت از فضایل و خوبی‌ها پر می‌شود، مانند خیکی که به‌طور صحیح و مناسب پر شده باشد."],[560,"ور نباشد اهل زان باد دروغ","خیک بدریدست کی گیرد فروغ","اگر اهل فضل و دانایی در میان نباشد، باد علم مانند دروغ است و موجب پاره شدن خیک (زبان) خواهد شد، و نمی‌تواند نور و روشنی (فروغ) به ارمغان آورد."],[560,"این مثل از خود نگفتم ای رفیق","سرسری مشنو چو اهلی و مفیق","این سخن را بی‌دلیل و سطحی از خود نگفتم، ای دوست؛ آن را با دقت و تأمل بشنو، مانند کسانی که اهل فهم و درک عمیق هستند."],[560,"این پیمبر گفت چون بشنید قدح","که چرا فربه شود احمد به مدح","این پیامبر (احمد) از شنیدن آن گفته (مدح) نگران است و می‌پرسد چرا باید به خاطر تعریف و تمجید او، چنین افراد بزرگ و فربه شوند."],[560,"رفت شاعر پیش آن شاه و ببرد","شعر اندر شکر احسان کان نمرد","شاعر به نزد آن شاه رفت و شعری را به‌عنوان شکرانه احسانی که از او دریافت کرده، ارائه داد، چرا که شاعر از زنده بودن شاه خوشحال بود."],[560,"محسنان مردند و احسانها بماند","ای خنک آن را که این مرکب براند","نیکوکاران وفات کردند و اعمال نیک آن‌ها باقی ماند. خوشا به حال کسی که بتواند این بار سنگین را به دوش بکشد و آن را به سرانجام برساند."],[560,"ظالمان مردند و ماند آن ظلمها","وای جانی کو کند مکر و دها","ظالم‌ها از دنیا رفتند، اما ظلم‌هایی که کردند همچنان باقی است. وای بر کسی که برای پیاده‌سازی این نیرنگ و نقشه‌ها جان خود را در معرض خطر قرار دهد."],[560,"گفت پیغامبر خنک آن را که او","شد ز دنیا ماند ازو فعل نکو","پیامبر گفت خوشا به حال کسی که از این جهان رفته و کارهای نیکش هنوز در یادها باقی مانده است."],[560,"مرد محسن لیک احسانش نمرد","نزد یزدان دین و احسان نیست خرد","مرد نیکوکار در دنیا وجود دارد، اما احسان و نیکی او در نزد خداوند از بین نمی‌رود. در واقع، دین و نیکی از ارزش‌های کوچک و کم‌اهمیت نیستند."],[560,"وای آنکو مرد و عصیانش نمود","تا نپنداری به مرگ او جان ببرد","آه از کسی که در زندگی کارهای زشت و نادرست انجام داده است، زیرا نباید پنداشت که با مرگ او روحش از عذاب این اعمال رهایی می‌یابد."],[560,"این رها کن زانک شاعر بر گذر","وام‌دارست و قوی محتاج زر","این را رها کن، زیرا شاعر در حال عبور است و بدهکار است و به شدت به پول نیاز دارد."],[560,"برد شاعر شعر سوی شهریار","بر امید بخشش و احسان پار","شاعر شعری را به سوی پادشاه فرستاد تا به امید دریافت انعام و مهربانی برود."],[560,"نازنین شعری پر از در درست","بر امید و بوی اکرام نخست","شاعر با محبت و ظرافت شعری زیبا و پرمحتوا سروده و امید دارد که همان ابتدا با بوی احترام و بزرگ‌داشت مورد توجه قرار گیرد."],[560,"شاه هم بر خوی خود گفتش هزار","چون چنین بد عادت آن شهریار","شاه نیز به عادت خود گفت که با وجود این رفتار بد، باید هزار چیز بگوید."],[560,"لیک این بار آن وزیر پر ز جود","بر براق عز ز دنیا رفته بود","این بار وزیر، که بسیار سخاوتمند و بخشنده است، با شکوه و زیبایی از دنیا رفته بود."],[560,"بر مقام او وزیر نو رئیس","گشته لیکن سخت بی‌رحم و خسیس","وزیر جدید که به مقامش رسیده، از نظر روحی بسیار سخت‌گیر و خسیس است و احساس نیکوکاری ندارد."],[560,"گفت ای شه خرجها داریم ما","شاعری را نبود این بخشش جزا","شاه گفت: ای وزیر، ما هزینه‌های زیادی داریم و برای شاعری که اینجا نیست، بخشش و پاداشی نمی‌توانیم در نظر بگیریم."],[560,"من به ربع عشر این ای مغتنم","مرد شاعر را خوش و راضی کنم","من با دادن یک چهارم از ده درصد (ربع عشر) مالی که باید پرداخت کنم، می‌توانم شاعر را راضی و خوشحال کنم."],[560,"خلق گفتندش که او از پیش‌دست","ده هزاران زین دلاور برده است","مردم به او گفتند که او از قبل، ده هزار شمشیر از این دلاوران گرفته است."],[560,"بعد شکر کلک خایی چون کند","بعد سلطانی گدایی چون کند","شاعر می‌پرسد که پس از شکرگزاری و نعمت‌های زندگی، چگونه می‌توان از سلطنت به فقر و گدایی افتاد و این تغییر وضعیت چگونه ممکن است."],[560,"گفت بفشارم ورا اندر فشار","تا شود زار و نزار از انتظار","شاعر می‌گوید که به او (شاه) فشار می‌آورم تا به حدی بیافتد که از شدت انتظار زار و نزار شود."],[560,"آنگه ار خاکش دهم از راه من","در رباید هم‌چو گلبرگ از چمن","اگر من خاک او را بدهم، او هم مانند گلبرگی که از باغ جدا می‌شود، به دست من می‌آید و به من می‌چسبد."],[560,"این به من بگذار که استادم درین","گر تقاضاگر بود هر آتشین","این موضوعی را به من بسپار که اگر استادم به من تقاضا کند، هرچقدر هم سخت و دشوار باشد، من آن را قبول می‌کنم."],[560,"از ثریا گر بپرد تا ثری","نرم گردد چون ببیند او مرا","اگر از آسمان هم به زمین بیفتد، زمین نرم می‌شود، چون او مرا می‌بیند."],[560,"گفت سلطانش برو فرمان تراست","لیک شادش کن که نیکوگوی ماست","سلطان به شاعر می‌گوید که برو و از او فرمان بگیر، اما در عین حال او را شاد کن، زیرا او شخصی خوش‌زبان و نیکو سخن است."],[560,"گفت او را و دو صد اومیدلیس","تو به من بگذار این بر من نویس","شاعر از وزیر می‌خواهد که دوصد امید و آرزو را به او بسپارد و این خواسته را به او بنویسد، تا او بداند چه چیزهایی را انتظار دارد."],[560,"پس فکندش صاحب اندر انتظار","شد زمستان و دی و آمد بهار","پس صاحب این اشعار، به انتظار شاعر نشسته بود و در طول زمستان و دی (ماه‌های سرد سال) گذشت، و پس از آن بهار آمد."],[560,"شاعر اندر انتظارش پیر شد","پس زبون این غم و تدبیر شد","شاعر در انتظار ماند و به مرور زمان پیر شد، و به خاطر غم و نگرانی از این انتظار، به حالت ضعیف و ناتوانی رسید."],[560,"گفت اگر زر نه که دشنامم دهی","تا رهد جانم ترا باشم رهی","شاعر می‌گوید: اگر طلا به من نمی‌دهی، لااقل مرا با دشنام نده تا بتوانم جانم را از این وضعیت رها کنم."],[560,"انتظارم کشت باری گو برو","تا رهد این جان مسکین از گرو","انتظار من به شدت به خاطر این بار سنگین در طولانی شده است، بنابراین برو تا جان بیچاره‌ام از این قید و بند آزاد شود."],[560,"بعد از آنش داد ربع عشر آن","ماند شاعر اندر اندیشه گران","شاعر پس از دریافت یک چهارم (ربع عشر) مالیاتی که به او تعلق می‌گیرد، همچنان در افکار سنگین و عمیق خود غرق شده است."],[560,"کانچنان نقد و چنان بسیار بود","این که دیر اشکفت دسته خار بود","این مقدار پول که این‌قدر زیاد است، به نظر می‌رسد که به اندازه دیرینگی و زحمتی که برای آن کشیده شده، کافی نیست و مثل این است که فقط تلخی و سختی به همراه آورده است."],[560,"پس بگفتندش که آن دستور راد","رفت از دنیا خدا مزدت دهاد","به او گفتند که آن وزیر خوب به رحمت خدا رفته است و خدا پاداشش دهد."],[560,"که مضاعف زو همی‌شد آن عطا","کم همی‌افتاد بخشش را خطا","عطایایی که به او داده می‌شد، به خاطر خطاهای او در توزیع، به تدریج کمتر و کمتر می‌شد."],[560,"این زمان او رفت و احسان را ببرد","او نمرد الحق بلی احسان بمرد","او (شاعر) به امید احسان و هدیه‌ای به نزد شاه رفت، اما در واقع احسان و بخشندگی در دل او مرده و از دست رفته است، نه اینکه شاعر خود بمیرد."],[560,"رفت از ما صاحب راد و رشید","صاحب سلاخ درویشان رسید","صاحب راد و رشید که یک فرد باخصوصیات خوب و شجاع است، از میان ما رفت و کسی به نام صاحب سلاخ، که به طور معمول اشاره به یک فرد قسی‌القلب یا سخت‌گیر دارد، به درویشان رسید."],[560,"رو بگیر این را و زینجا شب گریز","تا نگیرد با تو این صاحب‌ستیز","از اینجا برو و شب را ترک کن، زیرا این شخص دشمن و ستیزه‌جوست و ممکن است تو را آزار دهد."],[560,"ما به صد حیلت ازو این هدیه را","بستدیم ای بی‌خبر از جهد ما","ما با روش‌های زیادی از او این هدیه را گرفتیم، ای کسی که از تلاش ما بی‌خبری."],[560,"رو بایشان کرد و گفت ای مشفقان","از کجا آمد بگویید این عوان","شاعر به کسانی که دور او جمع شده‌اند، می‌گوید: ای مهربانان، از کجا و با چه وضعیتی این فرد (عوان) به نزد ما آمد؟"],[560,"چیست نام این وزیر جامه‌کن","قوم گفتندش که نامش هم حسن","وزیری که در اینجا صحبت از اوست، دارای نامی است که قوم او را حسن می‌خوانند. این بیان بر اهمیت و اعتبار این وزیر می‌افزاید و به نامش توجه می‌کند."],[560,"گفت یا رب نام آن و نام این","چون یکی آمد دریغ ای رب دین","گفت ای پروردگار، چرا نام این و آن یکی است؟ دریغ بر دین و ایمان من."],[560,"آن حسن نامی که از یک کلک او","صد وزیر و صاحب آید جودخو","حسنی که به خاطر او از یک قلم، صد وزیر و مرد بزرگ با صفات نیکو به وجود می‌آید، نشان‌دهنده عظمت و کرامت اوست."],[560,"این حسن کز ریش زشت این حسن","می‌توان بافید ای جان صد رسن","حسنی که از ریش زشت و بد شکل به دست می‌آید، می‌توان با آن، ای جان، صد رشته و طناب بافت."],[560,"بر چنین صاحب چو شه اصغا کند","شاه و ملکش را ابد رسوا کند","اگر کسی مانند شاه به گوشه گناه‌کاری و زشتی کسی توجه کند، به این ترتیب خود را رسوا و ننگین خواهد کرد."],[561,"چند آن فرعون می‌شد نرم و رام","چون شنیدی او ز موسی آن کلام","فرعون، زمانی که از موسی آن سخن را شنید، نرم و رام می‌شد و خود را تسلیم می‌کرد."],[561,"آن کلامی که بدادی سنگ شیر","از خوشی آن کلام بی‌نظیر","موسی کلامی را گفت که آنقدر تاثیرگذار بود که حتی سنگ هم نرم و حساس شد و از شادی به‌واسطه آن کلام، به حقیقتی تغییر کرد."],[561,"چون بهامان که وزیرش بود او","مشورت کردی که کینش بود خو","چون هامان، وزیر فرعون، مشورت کرد با او (فرعون) که بداند چه در خوی او نهفته است."],[561,"پس بگفتی تا کنون بودی خدیو","بنده گردی ژنده‌پوشی را بریو","سپس گفتی که تا به حال تو آقای بنده‌ای بودی که به شخصی ژنده‌پوش و بی‌ارزش، احترام گذاشته‌ای."],[561,"هم‌چو سنگ منجنیقی آمدی","آن سخن بر شیشه خانه او زدی","تو مانند یک سنگ منجنیق قدرتمند به او حمله‌ور شدی و آن سخن به مانند یک سنگ به شیشه خانه‌اش ضربه زد و آن را شکست."],[561,"هر چه صد روز آن کلیم خوش‌خطاب","ساختی در یک‌دم او کردی خراب","هرچقدر که موسی (کلیم) برای هدایت و راهنمایی دیگران تلاش کرد و سخنان زیبا و تاثیرگذاری گفت، تنها در یک لحظه، آن تلاش‌ها از بین رفت و به اثر نرسید."],[561,"عقل تو دستور و مغلوب هواست","در وجودت ره‌زن راه خداست","عقل تو تحت تأثیر هوای نفس است و در وجود تو، هوای نفس مانع پیروی از راه خدا شده است."],[561,"ناصحی ربانیی پندت دهد","آن سخن را او به فن طرحی نهد","اگر ناصح با بصیرت و الهام الهی به تو نصیحت کند، آن سخن را به گونه‌ای خواهد گفت که به خوبی در ذهنت بنشیند و تأثیرگذار باشد."],[561,"کین نه بر جایست هین از جا مشو","نیست چندان با خود آ شیدا مشو","کینه در دل‌ها باقی نمانده است، پس از آنجا بیرون نرو و خود را در کینه‌وری درگیر نکن."],[561,"وای آن شه که وزیرش این بود","جای هر دو دوزخ پر کین بود","وای به حال آن پادشاهی که وزیرش اینگونه باشد؛ زیرا در آن صورت جای هر دو دوزخ پر از کینه خواهد بود."],[561,"شاد آن شاهی که او را دست‌گیر","باشد اندر کار چون آصف وزیر","خوشا به حال آن پادشاهی که وزیری چون آصف دارد که در کارها او را یاری می‌کند. آصف، وزیر حضرت سلیمان بود و به حکمت و تدبیر معروف است."],[561,"شاه عادل چون قرین او شود","نام آن نور علی نور این بود","زمانی که شاه عادل با وزیر عادل و لایق همراه می‌شود، این اتحاد سبب نورانی‌تر شدن سلطنت و عظمت او می‌گردد. در واقع، نام این حالت را نور بر نور گذاشته‌اند."],[561,"چون سلیمان شاه و چون آصف وزیر","نور بر نورست و عنبر بر عبیر","وقتی که سلیمان شاه و آصف، وزیر او، با هم باشند، نور و روشنایی، بر نور و روشنایی افزوده می‌شود و عطر خوش عنبر بر عطر خوش عبیر افزوده می‌شود."],[561,"شاه فرعون و چو هامانش وزیر","هر دو را نبود ز بدبختی گزیر","فرعون و وزیرش هامان، هر دو با وجود مقام و قدرت، نمی‌توانستند از بدبختی و شقاوت خود بگریزند."],[561,"پس بود ظلمات بعضی فوق بعض","نه خرد یار و نه دولت روز عرض","برخی از تاریکی‌ها بر روی هم انباشت شده‌اند، نه عقل می‌تواند یاری دهد و نه قدرت روز روشنایی برای نمایش حقیقت وجود دارد."],[561,"من ندیدم جز شقاوت در لئام","گر تو دیدستی رسان از من سلام","من هیچ چیزی جز بدبختی و شقاوت در انسان‌های پست ندیدم. اگر تو او را دیدی و حالش را بهتر از من می‌دانی، سلام من را به او برسان."],[561,"هم‌چو جان باشد شه و صاحب چو عقل","عقل فاسد روح را آرد بنقل","همان‌طور که جان برای بدن است، پادشاه و صاحب‌منصب هم مانند عقل هستند؛ اگر عقل فاسد باشد، روح را به تباهی می‌کشاند."],[561,"آن فرشته عقل چون هاروت شد","سحرآموز دو صد طاغوت شد","عقل اگر تحت تاثیر فساد و افساد قرار بگیرد، مانند هاروت (که در افسانه‌ها به سحر و جادو معروف است) می‌شود و به جای راهنمایی، مایه فریب و گمراهی می‌شود که موجب ایجاد قدرت‌های ناحق و طاغوت‌ها می‌شود."],[561,"عقل جزوی را وزیر خود مگیر","عقل کل را ساز ای سلطان وزیر","عقل جزئی را به عنوان وزیر و راهنما قبول نکن، بلکه باید با عقل کل و جامع ارتباط برقرار کنی و آن را راهنمای خود قرار دهی، ای پادشاه."],[561,"مر هوا را تو وزیر خود مساز","که برآید جان پاکت از نماز","هوا و نفس خود را وزیر خویش قرار نده، زیرا که اگر چنین کنی، جان پاکت از عبادت و نماز جدا خواهد شد."],[561,"کین هوا پر حرص و حالی‌بین بود","عقل را اندیشه یوم دین بود","هوا (نفسانیت و خواهشات نفس) پر از حرص و شتاب است، اما عقل دارای اندیشه و تفکر برای روز حساب (یوم دین) است."],[561,"عقل را دو دیده در پایان کار","بهر آن گل می‌کشد او رنج خار","عقل در پایان کار دو چشم دارد، به خاطر آن گل (خوبی یا حقیقت) زحمت خار (مشکلات و سختی‌ها) را می‌کشد."],[561,"که نفرساید نریزد در خزان","باد هر خرطوم اخشم دور از آن","هرگز نباید بگذاریم که در فصل خزان، باد، خرطوم آتشین و سرخ (اخشم) خود را به زمین برساند و آن را خراب کند. در این بیت به نوعی هشدار داده می‌شود که باید از تاثیرات منفی و خطرناک دوری کرد."],[562,"ورچه عقلت هست با عقل دگر","یار باش و مشورت کن ای پدر","اگرچه عقل تو با عقل دیگری متفاوت است، اما با او دوست باش و مشورت کن ای پدر."],[562,"با دو عقل از بس بلاها وا رهی","پای خود بر اوج گردونها نهی","با داشتن دو عقل و تدبیر، از بلاها و مشکلات می‌توانی رهایی پیدا کنی و همچنین می‌توانی خود را به اوج و بلندی‌ها برسانی."],[562,"دیو گر خود را سلیمان نام کرد","ملک برد و مملکت را رام کرد","دیو اگرچه خود را سلیمان بنامد، اما همچنان قدرت و سلطه بر مملکت را به دست آورد و آن را به تسخیر درآورد."],[562,"صورت کار سلیمان دیده بود","صورت اندر سر دیوی می‌نمود","دیو، کارهای سلیمان را دیده و تقلید کرده است، اما در درون خود، ظاهری زشت و ناپسند دارد که نمایانگر واقعی‌اش است."],[562,"خلق گفتند این سلیمان بی‌صفاست","از سلیمان تا سلیمان فرقهاست","مردم می‌گویند این سلیمان، یعنی دیو، چیزی از سلیمان واقعی ندارد و بین این دو، تفاوت‌های زیادی وجود دارد."],[562,"او چو بیداریست این هم‌چون وسن","هم‌چنانک آن حسن با این حسن","شخصیت سلیمان که بیدار و هوشیار است مانند گیاه و درختی است که از خواب زودتر بیدار می‌شود، و به همین ترتیب، زیبایی واقعی او نیز با زیبایی ظاهری دیو قابل مقایسه نیست."],[562,"دیو می‌گفتی که حق بر شکل من","صورتی کردست خوش بر اهرمن","دیو می‌گوید که خداوند به من شکلی زیبا داده است که مرا شبیه به موجودات نیکو (مانند سلیمان) ساخته، اما در واقع من از نوعی شرارت و بدی هستم."],[562,"دیو را حق صورت من داده است","تا نیندازد شما را او بشست","دیو می‌گوید: خدا شکل من را به این صورت درآورده است تا شما را گمراه نکند و به بی‌راهه نبرد."],[562,"گر پدید آید به دعوی زینهار","صورت او را مدارید اعتبار","اگر کسی به ظاهر ادعا کند که مثل سلیمان است، به او اطمینان نکنید و به صورتش اعتبار نگذارید، زیرا ممکن است آنچه می‌گوید درست نباشد."],[562,"دیوشان از مکر این می‌گفت لیک","می‌نمود این عکس در دلهای نیک","دیوها از نیرنگ خود اینگونه می‌گفتند، اما در دل‌های نیکوکار، از ظاهر خود تصویر متفاوتی می‌ساختند."],[562,"نیست بازی با ممیز خاصه او","که بود تمییز و عقلش غیب‌گو","این بیت می‌گوید که بازی با کسانی که از عقل و تمییز خاصی برخوردارند، ممکن نیست؛ زیرا این افراد دارای بصیرت و درک عمیق‌اند که می‌توانند رازها و نیرنگ‌ها را تشخیص دهند."],[562,"هیچ سحر و هیچ تلبیس و دغل","می‌نبندد پرده بر اهل دول","هیچ جادو، هیچ فریب و حقه‌ای نمی‌تواند حقیقت را از نیکان و اهل مقام بپوشاند."],[562,"پس همی گفتند با خود در جواب","بازگونه می‌روی ای کژ خطاب","آنها با خودشان می‌گویند: «آیا تو دوباره به آن راه نادرست بازخواهی گشت، ای کسی که در کردار و گفتار کج و معوج هستی؟"],[562,"بازگونه رفت خواهی همچنین","سوی دوزخ اسفل اندر سافلین","اگر همچنان به این راه ادامه بدهی، به سوی جهنم و جایگاه‌های پست و فرودین خواهی رفت."],[562,"او اگر معزول گشتست و فقیر","هست در پیشانیش بدر منیر","اگر او (سلیمان) از مقام خود معزول شده و فقیر است، در پیشانی‌اش نور و روشنایی وجود دارد."],[562,"تو اگر انگشتری را برده‌ای","دوزخی چون زمهریر افسرده‌ای","تو اگر انگشتری را برده‌ای، مثل کسی هستی که به جهنم رفته و در سرمای طاقت‌فرسا غمگین و افسرده است."],[562,"ما ببوش و عارض و طاق و طرنب","سر کجا که خود همی ننهیم سنب","ما به بوییدن عطر و بوسیدن صورت و طاق و اوهام مشغولیم، ولی خود را از این زیبایی‌ها دور می‌کنیم و از آنها بی‌خبر هستیم."],[562,"ور به غفلت ما نهیم او را جبین","پنجه مانع برآید از زمین","اگر ما به غفلت او را بر روی زمین بگذاریم، دست‌های او که مانع هستند، از زمین بلند خواهند شد."],[562,"که منه آن سر مرین سر زیر را","هین مکن سجده مرین ادبار را","سلیمان علیه‌السلام به دیو هشدار می‌دهد که سرش را به زیر نیاورد و در درگاه خداوند سجده نکند، زیرا در پس‌زمینه، سرتاسر دیو نشاندهنده‌ی انحطاط و رویگردانی است. تنظیم رفتار و خود را در مقام سلیمان قرار ندهد."],[562,"کردمی من شرح این بس جان‌فزا","گر نبودی غیرت و رشک خدا","اگر غیرت و حسد خداوند وجود نداشت، من می‌توانستم این موضوع را به‌طور مفصل و جان‌افزا برای تو توضیح دهم."],[562,"هم قناعت کن تو بپذیر این قدر","تا بگویم شرح این وقتی دگر","قناعت کن و به همین اندازه‌ای که دارم می‌گویم رضایت بده، تا در زمان دیگری بیشتر توضیح دهم."],[562,"نام خود کرده سلیمان نبی","روی‌پوشی می‌کند بر هر صبی","سلیمان نبی نام خود را بر چهره دیو می‌گذارد و او (دیو) به همین بهانه، در کارهای سلیمان به تظاهر می‌پردازد و خود را شبیه او نشان می‌دهد."],[562,"در گذر از صورت و از نام خیز","از لقب وز نام در معنی گریز","از ظواهر و نام‌ها عبور کن و به معنی و باطن هر چیز توجه کن. به جای آنکه به عناوین و لقب‌ها بچسبی، به عمق مفهوم و حقیقت آنها بیا و سعی کن آنچه را که در پس ظاهر نهفته است، دریابی."],[562,"پس بپرس از حد او وز فعل او","در میان حد و فعل او را بجو","پس از او بپرس که حدود و مرزهایش چه هستند و اعمال او چگونه است، و میان این دو، یعنی حد و فعل او، به جستجوی حقیقت بپرداز."],[563,"هر صباحی چون سلیمان آمدی","خاضع اندر مسجد اقصی شدی","هر روز صبح، مانند سلیمان (پیامبر بزرگ) با تواضع و زیادی، به مسجد اقصی می‌آمدی."],[563,"نوگیاهی رسته دیدی اندرو","پس بگفتی نام و نفع خود بگو","سلیمان علیه‌السلام در مسجد اقصی گیاهی را دید و از آن خواست که نام و فایده‌اش را بگوید."],[563,"تو چه دارویی چیی نامت چیست","تو زیان کی و نفعت بر کیست","سلیمان علیه‌السلام از گیاهان می‌پرسد که هر کدام چه خاصیتی دارند، نامشان چیست و برای چه کسی سودمند یا زیان‌آور هستند."],[563,"پس بگفتی هر گیاهی فعل و نام","که من آن را جانم و این را حمام","سلیمان علیه‌السلام می‌گوید که هر گیاهی دارای خاصیت و نام خاصی است و من آن گیاه را جان می‌دهم، در حالی که این گیاه برای من مانند حمام است. یعنی او به اهمیت و ارزش خاص هر گیاه اشاره می‌کند و این‌که چگونه آنها می‌توانند از منافع و مضرات متفاوتی برخوردار باشند."],[563,"من مرین را زهرم و او را شکر","نام من اینست بر لوح از قدر","من دارویی را که زهر است شناخته‌ام و این دارو را شکر می‌نامند. این نام در قضا و قدر بر لوح محفوظ نوشته شده است."],[563,"پس طبیبان از سلیمان زان گیا","عالم و دانا شدندی مقتدی","طبیبان به سبب آگاهی و دانشی که از سلیمان و آن گیاه (عقاقیر) به دست آوردند، به مراتب بالایی از علم و دانش رسیدند و به‌عنوان پیشوایان و راهنماها شناخته شدند."],[563,"تا کتبهای طبیبی ساختند","جسم را از رنج می‌پرداختند","طبابت را به گونه‌ای برکت و فایده‌ای برای جسم می‌بخشیدند که بیماری و رنج را از آن دور می‌کردند."],[563,"این نجوم و طب وحی انبیاست","عقل و حس را سوی بی‌سو ره کجاست","این علم نجوم و پزشکی از وحی پیامبران سرچشمه می‌گیرد و عقل و حس انسان نمی‌توانند به تنهایی به درک معانی عمیق بپردازند و راهی به سوی مقصدهای حقیقی ندارند."],[563,"عقل جزوی عقل استخراج نیست","جز پذیرای فن و محتاج نیست","عقل محدود انسان، تنها به فکر و دانش جزئی و مختص خود بسنده می‌کند و از توانایی درک عمیق و فراگیر بی‌بهره است و نیازمند آموزش و هدایت است."],[563,"قابل تعلیم و فهمست این خرد","لیک صاحب وحی تعلیمش دهد","این خرد قابل یادگیری و درک است، اما تنها کسی که وحی دارد می‌تواند به طور درست آن را آموزش دهد."],[563,"جمله حرفتها یقین از وحی بود","اول او لیک عقل آن را فزود","تمام سخنان و گفته‌ها یقینا از وحی الهی نشأت گرفته است، اما عقل انسانی آن را تکمیل و پرورش می‌دهد."],[563,"هیچ حرفت را ببین کین عقل ما","تاند او آموختن بی‌اوستا","هیچ‌یک از سخنان تو را ننگر، زیرا این عقل ما است که از او می‌آموزد و بدون استاد نمی‌تواند به کسب علم بپردازد."],[563,"گرچه اندر مکر موی‌اشکاف بد","هیچ پیشه رام بی‌استا نشد","هرچند موی‌اشکاف (نوعی مکر و فریب) در کارش بسیار زبردست و ماهر است، اما هیچ کسی نمی‌تواند به وسیله‌ی فریب و بی‌استادی به چیزی دست یابد و آرامش پیدا کند."],[563,"دانش پیشه ازین عقل ار بدی","پیشه بی‌اوستا حاصل شدی","اگر انسانی که دانش دارد، در مدرسه‌ای که استاد آن مختار نیست، به درس و تحصیل بپردازد، نتیجه‌ای جز بدی نخواهد داشت."],[564,"کندن گوری که کمتر پیشه بود","کی ز فکر و حیله و اندیشه بود","کندن گور، کاری نیست که به مهارت یا حرفه‌ای خاص نیاز داشته باشد، بلکه بیشتر به تفکر و تدبیر وابسته است."],[564,"گر بدی این فهم مر قابیل را","کی نهادی بر سر او هابیل را","اگر این درک، بد باشد، باید پرسید که چگونه توانستی بر سر هابیل، برادر قابیل، این کار را انجام دهی."],[564,"که کجا غایب کنم این کشته را","این به خون و خاک در آغشته را","قابیل در این بیت در فکر است که چگونه باید جسد هابیل را پنهان کند، جسدی که از خون و خاک آغشته شده است."],[564,"دید زاغی زاغ مرده در دهان","بر گرفته تیز می‌آمد چنان","زاغی را دید که در دهانش جنازه‌ای را گرفته و به سرعت در حال حرکت است."],[564,"از هوا زیر آمد و شد او به فن","از پی تعلیم او را گورکن","زاغ از هوا پایین آمد و به هنر گورکنی پرداخت، در پی یادگیری این فن بود."],[564,"پس به چنگال از زمین انگیخت گرد","زود زاغ مرده را در گور کرد","زاغ به سرعت و با دستانش از زمین خاک برداشت و مرده را در گور قرار داد."],[564,"دفن کردش پس بپوشیدش به خاک","زاغ از الهام حق بد علم‌ناک","قابیل جسد زاغ را دفن کرد و سپس آن را با خاک پوشاند. این کار زاغ به قابیل الهام شده بود و نشان‌دهنده دانش او در دفن مردگان بود."],[564,"گفت قابیل آه شه بر عقل من","که بود زاغی ز من افزون به فن","قابیل در اینجا از زاغ که به‌خوبی بلد بود چگونه مرده را دفن کند، بهره‌برداری می‌کند و می‌گوید: \"ای کاش من هم به اندازه زاغ در این کار ماهر بودم.\" در واقع او حسرت می‌خورد که زاغ از او در این زمینه بهتر است."],[564,"عقل کل را گفت مازاغ البصر","عقل جزوی می‌کند هر سو نظر","عقل کلی (عقل جامع و فراگیر) به ما گفت که زاغ (پرنده‌ای که نشانه زشتی و بیهودگی است) فقط به ظاهر می‌نگرد، در حالی که عقل جزئی (عقل محدود و فردی) به هر سمت و سویی توجه می‌کند و نمی‌تواند به عمق مسائل پی ببرد."],[564,"عقل مازاغ است نور خاصگان","عقل زاغ استاد گور مردگان","عقل انسان مانند زاغی است که مخصوص کسانی است که به‌طور خاص و دقیق می‌توانند دیدگاه‌های خود را در مورد زندگی و مرگ شکل دهند. زاغ به‌عنوان استاد دفن مردگان شناخته می‌شود، و این بیانگر این است که عقل ما در حقیقت به محدودیت‌های خود در درک مسائل عمیق وجودی مربوط است."],[564,"جان که او دنباله زاغان پرد","زاغ او را سوی گورستان برد","جان که مانند زاغ‌ها به دنبال چیزهای بی‌فایده و دنیوی است، در نهایت توسط آن زاغ به سمت گورستان و مرگ کشیده می‌شود."],[564,"هین مدو اندر پی نفس چو زاغ","کو به گورستان برد نه سوی باغ","مبادا به دنبال نفس و خواسته‌های آن بروی، چراکه این نفس تو را به سوی گورستان و مرگ می‌برد، نه به باغ و زندگی خوش."],[564,"گر روی رو در پی عنقای دل","سوی قاف و مسجد اقصای دل","اگر با دل و نیت خالص به دنبال سرشت و حقیقت الهی بروی، به قاف (جایی که در افسانه‌ها، عنقا زندگی می‌کند و نماد کمال است) و مسجد اقصای دل (مکانی مقدس در قلب) دست خواهی یافت."],[564,"نوگیاهی هر دم ز سودای تو","می‌دمد در مسجد اقصای تو","هر لحظه، گیاهی تازه از عشق و آرزوی تو در درون دل بزرگ تو (مسجد اقصای دل) رشد می‌کند."],[564,"تو سلیمان‌وار داد او بده","پی بر از وی پای رد بر وی منه","تو مانند سلیمان باید او را کمک کنی و از او خواسته‌هایت را بپذیری، اما پا بر سرش نگذار و او را ضعیف نکن."],[564,"زانک حال این زمین با ثبات","باز گوید با تو انواع نبات","زیرا وضعیت این زمین پایدار، به تو انواع گیاهان و نباتات را نشان می‌دهد."],[564,"در زمین گر نیشکر ور خود نیست","ترجمان هر زمین نبت ویست","اگر در این زمین نیشکر وجود نداشته باشد، کسی نمی‌تواند معنا یا ترجمه‌ی (مشروح) هر نوع زمین را بگوید؛ چرا که هر زمین بر اساس گیاهانی که در آن می‌روید، معنا و خصائص خاص خود را پیدا می‌کند."],[564,"پس زمین دل که نبتش فکر بود","فکرها اسرار دل را وا نمود","پس دل انسان مانند زمین است که فکر و اندیشه در آن می‌روید و این فکرها، رازهای درون دل را آشکار می‌سازند."],[564,"گر سخن‌کش یابم اندر انجمن","صد هزاران گل برویم چون چمن","اگر در مجلسی کسی باشد که سخن‌چینی کند، من نیز مانند گل‌های بسیار در چمن، سر و زبانم به گفت‌وگو و اظهار نظر باز می‌شود."],[564,"ور سخن‌کش یابم آن دم زن به مزد","می‌گریزد نکته‌ها از دل چو دزد","اگر در آن لحظه، سخن‌کش را ببینم، او با شجاعت و فریب به سراغ نکته‌ها می‌رود و به راحتی از دل من می‌دزدد، مانند دزدی که از روی ناآرامی و بی‌نظمی می‌گریزد."],[564,"جنبش هر کس به سوی جاذبست","جذب صدق نه چو جذب کاذبست","هر کسی به سمتی حرکت می‌کند که او را به خود جلب می‌کند، و این جلب یا جذب واقعی و راستین است، نه جذب نادرست و جعلی."],[564,"می‌روی گه گمره و گه در رشد","رشته پیدا نه و آنکت می‌کشد","تو گاهی در راه‌های نادرست و گاهی در مسیر صحیح حرکت می‌کنی؛ در چنین حالتی، چیزی درونت تو را به سمت خود می‌کشد."],[564,"اشتر کوری مهار تو رهین","تو کشش می‌بین مهارت را مبین","شتر کور به وسیله‌ی مهار تو به راه می‌رود، بنابراین کشش و قدرت تو را ببین و مهارت خود را نشناس."],[564,"گر شدی محسوس جذاب و مهار","پس نماندی این جهان دارالغرار","اگر به جای موجودی محسوس و جذاب قرار بگیری و تحت تأثیر آن قرار بگیری، دیگر در این جهان که پر از عدم و نامعینی است، باقی نخواهی ماند."],[564,"گبر دیدی کو پی سگ می‌رود","سخره دیو ستنبه می‌شود","گبر (یعنی زرتشتی) را دیدی که چگونه پی سگ می‌رود، و به این دلیل به صورت سخره دیو (یعنی موجودی ترسناک و زشت) در می‌آید."],[564,"در پی او کی شدی مانند حیز","پی خود را واکشیدی گبر نیز","تو که در پی او (سگ) رفتی، شبیه به کسی شده‌ای که در پی خود می‌دود و خود را می‌کشد. مانند گبر (کسی که به زرتشتیان اشاره دارد) که به دنبال خود می‌افتد و خود را به زحمت می‌اندازد."],[564,"گاو گر واقف ز قصابان بدی","کی پی ایشان بدان دکان شدی","اگر گاو از کار قصاب‌ها آگاه باشد، هرگز به دنبال آن‌ها به دکان‌شان نمی‌رود."],[564,"یا بخوردی از کف ایشان سبوس","یا بدادی شیرشان از چاپلوس","اگر تو از دست قصابان و دکانشان چیزی بخوری، مانند سبوس گندم، یا به خاطر چاپلوسی، شیر آن‌ها را به آن‌ها بدهی، هیچ یک از این‌ها تو را به حقیقت و هدف اصلی نمی‌رساند."],[564,"ور بخوردی کی علف هضمش شدی","گر ز مقصود علف واقف بدی","اگر علف بخوری و آن را هضم کنی، به هدف و مقصد آن علف واقف نمی‌شوی."],[564,"پس ستون این جهان خود غفلتست","چیست دولت کین دوادو با لتست","ستون و پایه این جهان، خود غفلت و بی‌خبری است. دولت و قدرتی که در این دنیا هست، در واقع دو دوتا کردن (تنش و تضاد) و خلاصه، فقط به یک جا (مرگ) ختم می‌شود."],[564,"اولش دو دو به آخر لت بخور","جز درین ویرانه نبود مرگ خر","تنها در این ویرانی و زندگی بی‌هدف، هیچ چیزی جز مرگ و فنا وجود ندارد و در پایان، فقط عاقبتی دوگانه است: یا به کمال و مقام می‌رسی یا به نهایت تباهی."],[564,"تو به جد کاری که بگرفتی به دست","عیبش این دم بر تو پوشیده شدست","تو به طور جدی مشغول کاری هستی که از معایب آن در حال حاضر بی‌خبری و بر تو پنهان مانده است."],[564,"زان همی تانی بدادن تن به کار","که بپوشید از تو عیبش کردگار","به همین دلیل، تو باید تن را به کاری بسپاری که خداوند عیب آن کار را از تو پنهان کرده است."],[564,"همچنین هر فکر که گرمی در آن","عیب آن فکرت شدست از تو نهان","هر فکری که در دل تو حرارتی ایجاد کند، عیب آن فکر نیز از تو پنهان است."],[564,"بر تو گر پیدا شدی زو عیب و شین","زو رمیدی جانت بعد المشرقین","اگر عیب و ناپاکی از تو آشکار شود، باید از آن بگریزی و جانت را از آلودگی‌ها دور نگه‌داری، زیرا این امر نشان‌دهنده ناپاکی در ذاتی است که باید از آن دوری کرد."],[564,"حال که آخر زو پشیمان می‌شوی","گر بود این حال اول کی دوی","اگر در نهایت از او پشیمان می‌شوی، آن وقت چرا از همان ابتدا به دوستی با او ادامه دادی؟"],[564,"پس بپوشید اول آن بر جان ما","تا کنیم آن کار بر وفق قضا","بنابراین باید ابتدا آنچه را که در دل داریم و بر جان ما است، پوشیده نگه داریم تا بتوانیم کارهایمان را مطابق با سرنوشت و قضا پیش ببریم."],[564,"چون قضا آورد حکم خود پدید","چشم وا شد تا پشیمانی رسید","وقتی قضاوندی حکم خود را در زندگی آشکار کرد، انسان متوجه امور می‌شود و این آگاهی او را به پشیمانی می‌اندازد."],[564,"این پشیمانی قضای دیگرست","این پشیمانی بهل حق را پرست","این نوع پشیمانی ناشی از قضا و قدر دیگری است و چنانچه به دنبال حق و حقیقت باشی، نباید به این پشیمانی بی‌اهمیت توجه کنی."],[564,"ور کنی عادت پشیمان خور شوی","زین پشیمانی پشیمان‌تر شوی","اگر به عادت پشیمانی ادامه دهی، بیشتر از این پشیمانی به سراغت می‌آید و در نتیجه بیشتر ناراحت و پشیمان می‌شوی."],[564,"نیم عمرت در پریشانی رود","نیم دیگر در پشیمانی رود","نیمی از زندگی‌ات در اضطراب و نگرانی می‌گذرد و نیم دیگرش نیز در حسرت و پشیمانی."],[564,"ترک این فکر و پریشانی بگو","حال و یار و کار نیکوتر بجو","ترک این افکار و پریشانی‌ها را رها کن و به جای آن، حال خود و یار (دوست) و کارهای بهتر را جستجو کن."],[564,"ور نداری کار نیکوتر به دست","پس پشیمانیت بر فوت چه است","اگر کاری که بهتر و نیکوتر است به دست نمی‌آوری، دیگر چه فایده دارد که بابت از دست رفتن آن کار نیکو احساس پشیمانی کنی؟"],[564,"گر همی دانی ره نیکو پرست","ور ندانی چون بدانی کین بد است","اگر می‌دانی که راه نیک و درست چیست، خوب است که آن را بپرستی و دنبال کنی؛ اما اگر نمی‌دانی، وقتی بد را بشناسی، متوجه خواهی شد که راه نیک چیست."],[564,"بد ندانی تا ندانی نیک را","ضد را از ضد توان دید ای فتی","تا زمانی که نیکی و خوبی را نشناسی، نمی‌توانی بدی را بفهمی؛ زیرا تنها از طریق شناخت مخالف‌ها (نیکی و بدی) است که می‌توانی آن‌ها را درک کنی، ای جوان."],[564,"چون ز ترک فکر این عاجز شدی","از گناه آنگاه هم عاجز بدی","وقتی از تفکر در مورد کارهای زشت خود باز بمانی و نتوانی بر گناه خود تأمل کنی، در آن صورت به خودی خود هم ناتوان و بی‌عمل خواهی شد."],[564,"چون بدی عاجز پشیمانی ز چیست","عاجزی را باز جو کز جذب کیست","زمانی که بدی باعث می‌شود انسان از پشیمانی بی‌نصیب بماند، این نشانه عاجزی اوست. پس باید در جستجوی دلیل این عاجزی باشد که منبع آن چه چیزی است."],[564,"عاجزی بی‌قادری اندر جهان","کس ندیدست و نباشد این بدان","در دنیا هیچ‌کس بی‌نقصی و بی‌عجز را ندیده و وجود ندارد، بنابراین عاجزی و ناتوانی بخشی از طبیعت انسانی است."],[564,"همچنین هر آرزو که می‌بری","تو ز عیب آن حجابی اندری","هر آرزویی که به دنبال آن هستی، به خاطر عیبی که در خودت وجود دارد، مانعی بر سر راه تو شده است."],[564,"ور نمودی علت آن آرزو","خود رمیدی جان تو زان جست و جو","اگر علت آرزوی خود را نشان دهی، جان تو از آن تلاش و جست‌وجو رهایی می‌یابد."],[564,"گر نمودی عیب آن کار او ترا","کس نبردی کش کشان آن سو ترا","اگر عیب آن کار (که اشاره به ناپسند بودن آن دارد) را نشان می‌دادی، هیچ‌کس تو را به آن سمت نمی‌کشید و مجبور نمی‌شدی به آنجا بروی."],[564,"وان دگر کار کز آن هستی نفور","زان بود که عیبش آمد در ظهور","کار دیگری که از آن نفرت داری، به‌خاطر این است که عیب آن کار در معرض نمایش قرار گرفته است."],[564,"ای خدای رازدان خوش‌سخن","عیب کار بد ز ما پنهان مکن","خدای دانا و سخنگو، لطفا عیب کارهای بد ما را از دید ما پنهان کن و به ما نشان نده."],[564,"عیب کار نیک را منما به ما","تا نگردیم از روش سرد و هبا","عیب کار نیک ما را به ما نگو، زیرا این کار باعث می‌شود که از روش نیک و صواب دور شویم و به سرگردانی و تردید بیفتیم."],[564,"هم بر آن عادت سلیمان سنی","رفت در مسجد میان روشنی","مولانا به عادت سلیمان، پیامبر و پادشاه، اشاره می‌کند که در نور و روشنی در مسجد عبادت و زندگی می‌کرد. این تصویر به معنای توجه به علم و عبادت در فضایی روشن و معنوی است."],[564,"قاعده هر روز را می‌جست شاه","که ببیند مسجد اندر نو گیاه","شاه (سلیمان) هر روز عادت خود را دنبال می‌کرد تا ببیند در داخل مسجد، گیاه تازه‌ای (نشانه‌ای از حیات و سرسبزی) رشد کرده است."],[564,"دل ببیند سر بدان چشم صفی","آن حشایش که شد از عامه خفی","دل باید با چشم پاک و صاف خود، آن گیاهان را ببیند که از نظر مردم عادی نهان و پنهان مانده‌اند."],[565,"صوفیی در باغ از بهر گشاد","صوفیانه روی بر زانو نهاد","صوفی‌ای در باغ نشسته بود تا حال و هوای روحانی‌اش را گسترش دهد و برای این کار، به حالتی از خضوع و تفکر، روی به زانو گذاشته بود."],[565,"پس فرو رفت او به خود اندر نغول","شد ملول از صورت خوابش فضول","او به درون خود فرو رفت و به حالت تامل و تفکر مشغول شد و از آن حالت خواب‌آلود و بی‌فایده خسته و ملول گردید."],[565,"که چه خسپی آخر اندر رز نگر","این درختان بین و آثار و خضر","چرا تو درختان و زیبایی‌های گلستان را نمی‌بینی و به چیزهای دیگر فکر می‌کنی؟ به این زیبایی‌ها و نشانه‌های زندگی دقت کن."],[565,"امر حق بشنو که گفته‌ست انظروا","سوی این آثار رحمت آر رو","خدای حق به شما گفته است که به این نشانه‌های رحمت و نعمت توجه کنید و به سوی آن‌ها رو کنید."],[565,"گفت آثارش دلست ای بوالهوس","آن برون آثار آثارست و بس","آثار خداوند در درون دل انسان است، ای کسی که به ظواهر مادی دنیا عشق می‌ورزی؛ آنچه در بیرون وجود دارد تنها نشانه‌هایی از آن آثار واقعی است و بس."],[565,"باغها و سبزه‌ها در عین جان","بر برون عکسش چو در آب روان","باغ‌ها و چمن‌ها در واقع دارای جان و حیات‌اند و تصویر آنها همانند انعکاسشان در آب روان است."],[565,"آن خیال باغ باشد اندر آب","که کند از لطف آب آن اضطراب","این بیت اشاره به این دارد که تصویر باغی که در آب منعکس شده، تنها خیال و تصور است و این خیال به دلیل نعمت و لطفی که آب دارد، باعث نگرانی و پریشانی می‌شود. این اضطراب به خاطر دور بودن از واقعیت آن باغ است."],[565,"باغها و میوه‌ها اندر دلست","عکس لطف آن برین آب و گلست","باغ‌ها و میوه‌ها در دل انسان وجود دارند و لطف خداوند به وسیله این آب و گل به ما می‌رسد."],[565,"گر نبودی عکس آن سرو سرور","پس نخواندی ایزدش دار الغرور","اگر آن جوان زیبا و باوقار (سرو سرور) نبود و وجودش در دل تو تصویری نداشت، هرگز نام خدا را به عنوان منبع فریبندگی و زیبایی نمی‌خواندی."],[565,"این غرور آنست یعنی این خیال","هست از عکس دل و جان رجال","این حس غرور و خودبینی ناشی از تصورات و خیال‌های درون دل و روح افراد بزرگ است."],[565,"جمله مغروران برین عکس آمده","بر گمانی کین بود جنت‌کده","مغروران به خاطر این خیال و تصویر فریبنده‌ای که از خود دارند، بر این باورند که آنچه می‌بینند، بهشت است."],[565,"می‌گریزند از اصول باغها","بر خیالی می‌کنند آن لاغها","آن لاغرهای ضعیف از اصول باغ‌ها فرار می‌کنند و تنها به خیال و تصور می‌پردازند."],[565,"چونک خواب غفلت آیدشان به سر","راست بینند و چه سودست آن نظر","وقتی که خواب غفلت بر آن‌ها غلبه کند، حقیقت را می‌بینند، اما این دیدن چه فایده‌ای دارد؟"],[565,"بس به گورستان غریو افتاد و آه","تا قیامت زین غلط وا حسرتاه","در گورستان صدای گریه و زاری به گوش می‌رسد و این ندا تا قیامت ادامه خواهد داشت؛ یعنی از بی‌خبری و غفلت از حقیقت زندگی حسرت خواهند خورد."],[565,"ای خنک آن را که پیش از مرگ مرد","یعنی او از اصل این رز بوی برد","خوش به حال کسی که قبل از مرگ، از حقیقت و زیبایی‌های زندگی مثل گل و عطرش آگاه شده و بهره‌مند شده باشد."],[566,"پس سلیمان دید اندر گوشه‌ای","نوگیاهی رسته هم‌چون خوشه‌ای","سلیمان در یک گوشه از مسجد قصی (مسجد الاقصی) گیاهی نو و تازه را دید که مانند خوشه‌ای رشد کرده بود."],[566,"دید بس نادر گیاهی سبز و تر","می‌ربود آن سبزیش نور از بصر","سلیمان گیاهی بسیار نادر و تازه سبز را دید که سبزی‌اش از نگاه او می‌درخشید؛ به‌طوری‌که آن سبز بودنش برای او جذاب و خیره‌کننده بود."],[566,"پس سلامش کرد در حال آن حشیش","او جوابش گفت و بشکفت از خوشیش","سلیمان علیه‌السلام به آن گیاه (خروب) سلام کرد و آن گیاه به او پاسخ داد و از خوشحالی شکفت و رشد کرد."],[566,"گفت نامت چیست برگو بی‌دهان","گفت خروب است ای شاه جهان","حشیش به سلیمان می‌گوید که نام من خروب است، ای شاه جهان."],[566,"گفت اندر تو چه خاصیت بود‌؟","گفت من رستم مکان ویران شود","رستم در پاسخ می‌گوید که خاصیت او این است که هر مکان ویران و خراب شود، یعنی قدرت و اثرگذاری او به اندازه‌ای است که می‌تواند هر چیزی را نابود کند."],[566,"من که خروبم خراب منزلم","هادم بنیاد این آب و گلم","هادم‌: ویران‌کننده‌."],[566,"پس سلیمان آن زمان دانست زود","که اجل آمد سفر خواهد نمود","سلیمان فهمید که زمان مرگش نزدیک است و باید به سفر آخرت برود."],[566,"گفت تا من هستم این مسجد یقین","در خلل ناید ز آفات زمین","سلیمان گفت تا وقتی که من زنده‌ام، این مسجد قطعا از آسیب‌ها و خطرات زمینی در امان خواهد بود."],[566,"تا که من باشم وجود من بود","مسجداقصی مخلخل کی شود","وجود من، برقراری و حفاظت این مسجد اقصی را بیمه می‌کند و وقتی من هستم، هیچ آفتی نمی‌تواند آن را تهدید کند."],[566,"پس که هدم مسجد ما بی‌گمان","نبود الا بعد مرگ ما بدان","مسجد وجود ما نابود نخواهد شد مگر بعد از مرگ ما."],[566,"مسجدست آن دل که جسمش ساجدست","یار بد خروب هر جا مسجدست","دل مانند مسجد است که در آن جسم (بدن) به سجده می‌افتد. اگر یار بد و بدخواهی در دل باشد، هر مکانی که دل را مسجد بدانیم، بی‌ارزش خواهد بود."],[566,"یار بد چون رست در تو مهر او","هین ازو بگریز و کم کن گفت وگو","زمانی که دوستی نامناسب در تو احساس محبت به وجود آورد، از او دوری کن و صحبت کردن با او را کاهش بده."],[566,"برکن از بیخش که گر سر بر زند","مر ترا و مسجدت را بر کند","از ریشه‌ات جدا شو، چرا که اگر سر بزند، تو و مسجدت را نابود خواهد کرد."],[566,"عاشقا خروب تو آمد کژی","هم‌چو طفلان سوی کژ چون می‌غژی","ای عاشق، امروز خروسی آمده که کج و معوج است، همچون کودکانی که به سمت کج و معوج می‌لغزند."],[566,"خویش مجرم دان و مجرم گو مترس","تا ندزدد از تو آن استاد درس","خودت را به عنوان یک مجرم بشناس و از گفتن این موضوع نترس، زیرا استاد درسی که داری، چیزی از تو نخواهد دزدید."],[566,"چون بگویی جاهلم تعلیم ده","این چنین انصاف از ناموس به","وقتی بگویی که من بی‌خبر و نادان هستم، مرا تعلیم بده، نشان می‌دهد که انصاف و عدالت در مورد نیکوکاری و آداب اجتماعی را فراموش کرده‌ای."],[566,"از پدر آموز ای روشن‌جبین","ربنا گفت و ظلمنا پیش ازین","ای روشن‌جبین، از والدت بیاموز و بگو «خداوندا، ما قبل از این ظلم کردیم»؛ یعنی از گذشته‌های نادرست خود پشیمان باش و از دیگران یاد بگیر."],[566,"نه بهانه کرد و نه تزویر ساخت","نه لوای مکر و حیلت بر فراخت","او (ابلیس) نه بهانه‌ای آورد و نه فریبی را تنظیم کرد و نه پرچم مکر و حقه‌ای را برافراشت."],[566,"باز آن ابلیس بحث آغاز کرد","که بدم من سرخ رو کردیم زرد","ابلیس دوباره بحث را شروع کرد و گفت که من بد هستم، اما چهره‌ام سرخ است و از حالت شرم و تنهایی، رنگم زرد شده است."],[566,"رنگ رنگ تست صباغم توی","اصل جرم و آفت و داغم توی","رنگ و شکل تو به من مربوط است، اما من در اصل خود، گناه و درد را دارم."],[566,"هین بخوان رب بما اغویتنی","تا نگردی جبری و کژ کم تنی","بشنو که بگو، خداوندی که مرا به گمراهی کشاندی، تا ما به بیراهه نرویم و به سمت بدی و انحراف متمایل نشویم."],[566,"بر درخت جبر تا کی بر جهی","اختیار خویش را یک‌سو نهی","تنها بر درخت جبر نایست و خود را به دیوانگی بزن، چرا که نمی‌توانی همیشه اختیار خود را کنار بگذاری و بی‌عمل بمانی."],[566,"هم‌چو آن ابلیس و ذریات او","با خدا در جنگ و اندر گفت و گو","این بیت به مقایسه حالتی می‌پردازد که ابلیس و پیروانش (ذریات او) با خدا در جنگ و جدل هستند. مولانا به این موضوع اشاره می‌کند که انسان نیز ممکن است به مانند ابلیس در حال تخالف و بحث با خداوند باشد."],[566,"چون بود اکراه با چندان خوشی","که تو در عصیان همی دامن کشی","چگونه ممکن است که با چنین شادی و لذتی، تو در نافرمانی و عصیان دامن بگرفتی؟"],[566,"آن‌چنان خوش کس رود در مکرهی","کس چنان رقصان دود در گم‌رهی","هیچ کسی به اندازه آن شخص خوشحال نیست که در حالی که در وضع ناپسند و خطاکاری قرار دارد، خود را سرگرم و شاداب نشان می‌دهد. به عبارتی دیگر، کسی که در گمراهی است، ممکن است طوری رفتار کند که گویی در شادی و خوشی به سر می‌برد."],[566,"بیست مرده جنگ می‌کردی در آن","کت همی‌دادند پند آن دیگران","در موقعیتی که مردانی در جنگ می‌جنگیدند، آن‌قدر درگیر کارزار بودند که دیگران به آن‌ها نصیحت می‌کردند."],[566,"که صواب اینست و راه اینست و بس","کی زند طعنه مرا جز هیچ‌کس","تنها کسی که می‌تواند به من خرده بگیرد و طعنه بزند، کسی است که خود در مسیر درست و حقیقی قدم گذاشته باشد. بنابراین، درست و راستین فقط یک راه وجود دارد و آن راه چیست."],[566,"کی چنین گوید کسی کو مکر هست","چون چنین جنگد کسی کو بی‌رهست","کسی که دارای نیرنگ و مکر باشد، هرگز چنین سخنانی نمی‌گوید و کسی که در مسیر درست و بی‌راهی نیست، در چنین مسائلی نمی‌جنگد."],[566,"هر چه نفست خواست داری اختیار","هر چه عقلت خواست آری اضطرار","هر چیزی که نفس تو خواست، تو می‌توانی آن را داشته باشی، اما هر چه عقل تو بخواهد، ناچار هستی که آن را بپذیری."],[566,"داند او کو نیک‌بخت و محرمست","زیرکی ز ابلیس و عشق از آدمست","کسی که نیکبخت و در مقام راز آشناست، زیرکی و خرد را از ابلیس می‌آموزد و عشق را از آدم (نیز از مقام انسانی) می‌شناسد."],[566,"زیرکی سباحی آمد در بحار","کم رهد غرقست او پایان کار","زیرکی و هوش، مانند شناگری است که در دریاهای گسترده‌ای قرار دارد و اگر مراقب نباشد، غرق خواهد شد. در نهایت، آگاهی و هوشمندی نیز خطراتی را به همراه دارد و ممکن است به سرانجام ناپسندی منجر شود."],[566,"هل سباحت را رها کن کبر و کین","نیست جیحون نیست جو دریاست این","بهتر است که از غرور و کینه دست بکشید، چرا که نه تنها جیحون (رودی در ایران) بلکه حتی دریای عمیق هم در برابر این دریایی که ما در آن هستیم چیزی نیست."],[566,"وانگهان دریای ژرف بی‌پناه","در رباید هفت دریا را چو کاه","ناگهان دریای عمیق و لجام‌گسیخته، هفت دریا را مانند کاه در می‌برد."],[566,"عشق چون کشتی بود بهر خواص","کم بود آفت بود اغلب خلاص","عشق مانند کشتی‌ای است که فقط برای افراد خاصی مناسب است و برای دیگران می‌تواند مشکل‌ساز و خطرناک باشد."],[566,"زیرکی بفروش و حیرانی بخر","زیرکی ظنست و حیرانی نظر","زیرکی را به بهای ارزان بفروش و به جای آن حیرانی را در خود بخر، زیرا زیرکی تنها توهم است و حیرانی واقعی بینش و آگاهی می‌آورد."],[566,"عقل قربان کن به پیش مصطفی","حسبی الله گو که الله‌ام کفی","عقل و خرد خود را به خاطر محبت و ارادت به پیامبر (مصطفی) فدای او کن و بگو که خداوند برای من کافی است."],[566,"هم‌چو کنعان سر ز کشتی وا مکش","که غرورش داد نفس زیرکش","کنعان، فرزند یعقوب، از سخن گفتن با برادرانش غافل شد و به خاطر غرور ناشی از نفس خود، خود را در معرض خطر قرار داد. در اینجا مولانا می‌گوید که نباید مانند کنعان، از کشتی (زندگی) سر خود را بیرون آورد و با غرور و خودبینی به گفتگو بپردازد، زیرا نفس می‌تواند او را به سقوط و نابودی بکشاند."],[566,"که برآیم بر سر کوه مشید","منت نوحم چرا باید کشید","چرا باید بار منت نواختن نوح (پیامبر) را بر دوش خود بگذارم و به بالای کوه مشید بروم؟"],[566,"چون رمی از منتش بر جان ما","چونک شکر و منتش گوید خدا","هرگاه که بار گران منت او بر وجود ما سنگینی کند، خداوند همین طور با شکر و نعمتش به ما می‌گوید که این منت از سوی اوست."],[566,"تو چه دانی ای غراره پر حسد","منت او را خدا هم می‌کشد","ای شخص حسود، تو چه می‌دانی؟ خداوند با رحمت و نعمت خود او را نیز از میان برمی‌دارد و به عاقبت او توجه می‌کند."],[566,"کاشکی او آشنا ناموختی","تا طمع در نوح و کشتی دوختی","کاش او (غراره) آشنا و دوست‌داشتنی نمی‌شد تا به طمع نجاتی که نوح و کشتی‌اش داشتند، دچار نشود."],[566,"کاش چون طفل از حیل جاهل بدی","تا چو طفلان چنگ در مادر زدی","کاش مانند یک کودک از نادانی و فریب خوردن نجات می‌یافتی تا مثل بچه‌ها به آغوش مادر می‌رفتی و آرامش می‌گرفتی."],[566,"یا به علم نقل کم بودی ملی","علم وحی دل ربودی از ولی","اگر علم قوی‌تری داشته بودی، آن‌گاه علم وحی از دل تو می‌رفت و تو را به وصال ولی (خدا یا ولی‌الله) می‌رساند."],[566,"با چنین نوری چو پیش آری کتاب","جان وحی آسای تو آرد عتاب","اگر تو این‌چنین نوری را داشته باشی و کتاب جان را پیش ببری، وحی الهی به تو سرزنش و عتاب می‌کند."],[566,"چون تیمم با وجود آب دان","علم نقلی با دم قطب زمان","اگر بتوانی با وجود آب، به تیمم بسنده کنی، به معنای آن است که علوم نقلی (گفته‌ها و نصوص) را با دلایل و استدلالات درست نمی‌پذیری و به معلم بزرگی مانند قطب زمان (شخصیت مهم و تاثیرگذار) احتیاج نداری."],[566,"خویش ابله کن تبع می‌رو سپس","رستگی زین ابلهی یابی و بس","خود را معمولی و بی‌پرده نشان بده تا از طریق این سادگی و نادانی به رستگاری و خوشبختی واقعی دست یابی و بس."],[566,"اکثر اهل الجنه البله ای پسر","بهر این گفته‌ست سلطان البشر","بسیاری از اهل بهشت، افرادی ساده و بی‌غرض هستند، ای پسر، و این سخن به خاطر این است که پیامبر بشر، یعنی محمد (ص)، چنین گفته است."],[566,"زیرکی چون کبر و باد انگیز تست","ابلهی شو تا بماند دل درست","زیرکی و خودبینی مثل کبر (فخر و انکساری که از بالندگی و بزرگی به وجود می‌آید) و باد (تکبر) است؛ پس بهتر است که ابله باشی (ساده‌دل و بی‌تکبر) تا دل تو سالم و با آرامش باقی بماند."],[566,"ابلهی نه کو به مسخرگی دوتوست","ابلهی کو واله و حیران هوست","ابلهی به معنای کسی که به حماقت و مسخرگی می‌پردازد، نیست. بلکه ابله واقعی کسی است که در عشق و شگفتی نسبت به محبوب خود حیران و مجذوب است."],[566,"ابلهان‌اند آن زنان دست بر","از کف ابله وز رخ یوسف نذر","زنان ابلهی هستند که توجهشان به یوسف بوده و از عشق او دست برنداشته‌اند. آنها به خاطر یوسف خود را به مسخرگی می‌اندازند و نذری برای او دارند."],[566,"عقل را قربان کن اندر عشق دوست","عقلها باری از آن سویست کوست","عقل را در راه عشق به دوست فدای کن، زیرا عقل‌ها از آن طرف آمده‌اند، پس دوست کیست؟"],[566,"عقلها آن سو فرستاده عقول","مانده این سو که نه معشوقست گول","عقل‌ها را به سوی معشوق فرستاده‌اند، اما عقول (قوه‌های عقل) در اینجا باقی مانده‌اند و به خاطر نداشتن معشوق، در اشتباه و گمراهی هستند."],[566,"زین سر از حیرت گر این عقلت رود","هر سو مویت سر و عقلی شود","اگر از حیرت و سرگردانی، عقل تو نرود، هر جا که بروی، موهایت به دنبال تو خواهد بود و عقل و فکر تو همواره همراهت خواهد شد."],[566,"نیست آن سو رنج فکرت بر دماغ","که دماغ و عقل روید دشت و باغ","فکرت و اندیشه‌هایت را به خودت فشار نیاور، زیرا ذهن و عقل تو فراتر از این رنج‌ها می‌تواند به شکوفایی و زیبایی برسد."],[566,"سوی دشت از دشت نکته بشنوی","سوی باغ آیی شود نخلت روی","از دشت و محیط خود نکته‌ها و درس‌هایی را بگیر و هنگامی که به باغ می‌روی، ثمره و بهره‌اش را مشاهده کن."],[566,"اندرین ره ترک کن طاق و طرنب","تا قلاوزت نجنبد تو مجنب","در این راه، طاق و طرنب را رها کن تا برجستگی و برآمدگی تو حرکت نکند. منظور این است که از موانع و حواشی دوری کن تا خودت را نتوانی تحت تأثیر حرکت ناخواسته قرار دهی."],[566,"هر که او بی سر بجنبد دم بود","جنبشش چون جنبش کزدم بود","هر کسی که بدون سر حرکت کند، حرکاتش به‌خاطر نفسش است؛ حرکاتی که به‌طور طبیعی و بی‌فکر انجام می‌دهد، مانند حرکاتی که یک بی‌سر انجام می‌دهد."],[566,"کژرو و شب کور و زشت و زهرناک","پیشه او خستن اجسام پاک","کسی که منحرف، نابینا و دارای کارهای زشت و ضررآور است، بدن‌های پاک را می‌آزارد و آسیب می‌زند."],[566,"سر بکوب آن را که سرش این بود","خلق و خوی مستمرش این بود","سرت را به آن چیز که چنین حال و رفتاری دارد، بکوب، چرا که این خصوصیات دائم و همیشگی اوست."],[566,"خود صلاح اوست آن سر کوفتن","تا رهد جان‌ریزه‌اش زان شوم‌تن","صلاح او در این است که به سر او کوبیده شود تا جان او از این بدن شرور رها گردد."],[566,"واستان آن دست دیوانه سلاح","تا ز تو راضی شود عدل و صلاح","آن دست دیوانه (که اشاره به سلیمان دارد) را از سلاح بگیر تا او به تو راضی شود و عدالت و درستی برپا گردد."],[566,"چون سلاحش هست و عقلش نه ببند","دست او را ورنه آرد صد گزند","اگر او سلاح دارد اما عقلش را ندارد، باید دست او را ببندی، وگرنه زیان‌های زیادی به بار خواهد آورد."],[567,"بدگهر را علم و فن آموختن","دادن تیغی به دست راه‌زن","آموختن دانش و مهارت یا دادن قدرت به فردی فاسد و بدسیرت، مانند این است که به دست یک دزد و راهزن شمشیری برا و تیز بدهی."],[567,"تیغ دادن در کف زنگیّ مست","به که آید علم، ناکس را به دست","خطر اینکه تیغ برنده را در دستان یک یاغی که مست هم باشد قرار دهی، کمتر از این است که به دست انسان ناکس و بی‌معرفت علم و قدرت بدهی."],[567,"علم و مال و منصب و جاه و قران","فتنه آمد در کف بدگوهران","علم و مال و قدرت و ثروت اگر در اختیار انسان‌های نابخرد و بدذات بیفتند تبدیل به ابزاری برای فتنه و شر بیشتر در جهان می‌شود."],[567,"پس غزا زین فرض شد بر مؤمنان","تا ستانند از کف مجنون، سنان","پس به همین دلیل جنگ بر مومنان و دانایان واجب شد تا قدرت را از دست یاغی های نادان بگیرند"],[567,"جان او مجنون، تنش شمشیر او","واستان شمشیر را زان زشت‌خو","او آنقدر به این مال و منال و قدرت وابسته است که این کار را سخت میکند، ولی خرمندان باید کمر همت ببندند و ابزار قدرت را از دست نامحرم آن خارج کنند."],[567,"آن‌چه منصب می‌کند با جاهلان","از فضیحت؛ کی کند صد ارسلان؟","آن کاری که قدرت و مال با انسان‌های بدذات و پلید می‌کند باز به پای این نمی‌رسد که صد جاهل از روی جهل آبروریزی کنند."],[567,"عیب او مخفیست؛ چون آلت بیافت","مارش از سوراخ بر صحرا شتافت","بدذاتی و نیت شوم اون پیدا نیست مادامی که ابزار آن کار را که قدرت باشد در اختیار ندارد، به محض یافتن قدرت ذات حقیقی خودش را رو خواهد کرد."],[567,"جمله صحرا مار و کژدم پر شود","چونک جاهل، شاه حکم مر شود","اگر انسان نادان به حکمرانی و پادشاهی برسد فساد و بدبختی جامعه را در بر میگیرد."],[567,"مال و منصب، ناکسی کآرد به دست","طالب رسوایی خویش، او شدست","انسان نادان و ناآگاه اگر به مال و منصبی هم برسد، باز همان مال و منصب بلای جان او خواهد شد."],[567,"یا کند بخل و عطاها کم دهد","یا سخا آرد به ناموضع نهد","یا بخل و خساست پیشه می‌کند و مردمان رو تنگ می‌آورد یا سخاوت بیش از حد و اندازه که یاغی‌ها سرکش‌تر می‌شوند. به عبارتی عاجز در میانه‌روی است."],[567,"شاه را در خانه بیذق نهد","این چنین باشد عطا کاحمق دهد","لطف و عطای جاهل به مردمان میدهد، به مانند این است که پادشاه را در خانه سرباز ببرند و از او پذیرایی کنند."],[567,"حکم چون در دست گمراهی فتاد","جاه پندارید در چاهی فتاد","زمانی که قدرت و تصمیم‌گیری به دست آدمی نادان و گمراه بیفتد، مانند این است که درون یک چاه عمیق افتاده و به هیچ‌کجا نمی‌تواند برود."],[567,"ره نمی‌داند؛ قلاووزی کند","جان زشت او، جهان‌سوزی کند","کسی (حاکمی) که خود راه را بلد نیست (خودش را نشناخته) چگونه می‌تواند راهبر و رهبر باشد؟ نادانی او جهانی رو تحت تاثیر قرار میده."],[567,"طفل راه فقر، چون پیری گرفت","پی‌روان را غول ادباری گرفت","حاکم نادان که به پیری رسید، از شدت این نادانی پیروان‌ش هم به وحشت خواهند افتاد از اینکه او به موجود بدتری تبدیل شده است."],[567,"که بیا تا ماه بنمایم تو را","ماه را هرگز ندید آن بی‌صفا","اگر هم بخواهد نور رو روشنایی را به پیروان خود نشان دهد چون هیچ علم و آگاهی از آن تا به حال کسب نکرده نمی‌تواند که این دم آخری هم سعادتمند شود."],[567,"چون نمایی؟ چون ندیدستی به عمر","عکس مه در آب هم ای خام غمر","علت این بی‌خبری آن است که در طول عمر حتی بویی هم از انسانیت و معرفت نبرده است."],[567,"احمقان سرور شدستند و ز بیم","عاقلان سرها کشیده در گلیم","در صورتی که احمق‌ها در مقام‌ها و منصب‌های بالا و در راس کار هستند، عاقلان و خرمندان (از حیث آبرو و درستکاری) سر به کار خود دارند و دور از جاه و مقام‌های دنیوی زندگی را سپری می‌کنند."],[568,"خواند مزمل نبی را زین سبب","که برون آ از گلیم ای بوالهرب","مزمل نبی (پیامبر که در آیه‌ای به این نام اشاره شده) را به این دلیل خواندند که باید از گلیم (پوشش و غفلت دنیوی) بیرون بیاید، ای بوالهرب (کنایه از کسی که در حال غفلت و خواب است)."],[568,"سر مکش اندر گلیم و رو مپوش","که جهان جسمی‌ست سرگردان‌، تو هوش","در این بیت به فردی که در حال ضعف و ناتوانی است گفته می‌شود که سر خود را در گلیم (پوششی که برای محافظت استفاده می‌شود) پنهان نکند و روی خود را نپوشد. جهان مادی بی‌ثبات و پر از پریشانی است، بنابراین باید آگاه و هوشیار باشد و خود را از واقعیت‌ها دور نکند."],[568,"هین مشو پنهان ز ننگ مدعی","که تو داری شمع وحی شعشعی","ای مدعی (مدعی به معنای کسی که ادعای معرفت یا مقام دارد)، از پنهان شدن اجتناب کن، زیرا تو خود دارای شعله‌ای از وحی الهی هستی که نورش درخشان است."],[568,"هین قم اللیل که شمعی ای همام","شمع اندر شب بود اندر قیام","ای همام (دوست یا رفیق)، شتاب کن و از خواب بیدار شو، زیرا شمعی هستی که در شب، روشنی می‌بخشی و این روشنایی تو فقط در زمان قیام و بیداری دارای ارزش است."],[568,"بی‌فروغت روز روشن هم شب‌ست","بی‌پناهت شیر اسیر‌ ارنب‌ست","ارنب‌: خرگوش"],[568,"باش کشتیبان درین بحر صفا","که تو نوح ثانی‌یی ای مصطفی","ای مصطفی، تو مانند نوح، در این دریای پاک و زلال، باید قایقرانی کنی."],[568,"ره‌شناسی می‌بباید با لباب","هر رهی را خاصه اندر راه آب","برای طی کردن هر مسیر و شناخت آن، باید با خرد و درک کامل پیش بروی و به‌خصوص در مسیری که آب وجود دارد، باید بیشتر دقت کنی."],[568,"خیز بنگر کاروان‌ ره‌زده","هر طرف غولی‌ست کشتیبان شده","منظور از غول در اینجا دیوهایی است که در ظاهر آشنایان یا هر شکل که می‌خواهند در می‌آیند و مردم را در راه‌ها به بیراهه برده و گمراه می‌کنند. در افسانه‌گفتن دختر پادشاه اقلیم پنجم از هفت پیکر نظامی (داستان ماهان مصری‌) این غول‌ها چندین بار ماهان را گمراه می‌کنند."],[568,"خضر وقتی‌، غوث هر کشتی توی","هم‌چو روح‌الله مکن تنها روی","خضر، که نماد راهنمایی است و به او کمک می‌شود، در شرایط بحرانی و فساد، یاری‌گر هر کشتی است. پس مانند روح‌الله (عیسای مسیح) در زمانه‌ی دشواری، به تنهایی نمانید و از او کمک بگیرید."],[568,"پیش این جمعی چو شمع آسمان","انقطاع و خلوت آری را بمان","در میان این جمع، تو مانند شمعی هستی که در آسمان می‌درخشد، اما باید در زمان انقطاع و خلوت نیز بمانی و دوری از دیگران را تجربه کنی."],[568,"وقت خلوت نیست اندر جمع آی","ای هدی چون کوه قاف و تو همای","در این بیت، مولانا به فردی که هدایتگر است (هدی) می‌گوید که در موقعیت‌های خلوت و تنهایی نباید به جمع بیافتد، چون این زمان برای جمع شدن مناسب نیست. او او را با کوه قاف که نماد عظمت و دوری است مقایسه می‌کند و به او یادآوری می‌کند که مثل همای (پرنده‌ای افسانه‌ای) آزاد و مستقل باشد."],[568,"بدر بر صدر فلک شد شب روان","سیر را نگذارد از بانگ سگان","سیر یعنی سیر و حرکت ماه"],[568,"طاعنان هم‌چون سگان بر بدر تو","بانگ می‌دارند سوی صدر تو","سختی‌های و انتقادات بر تو مانند صدای سگان است که به سوی ماه (بدر) تو حمله‌ور می‌شوند."],[568,"این سگان کرند از امر انصتوا","از سفه وع‌وع‌کنان بر بدر تو","این «سگان» که به طور مجازی به تعبیر کسانی که انتقاد یا ناسزا می‌گویند، به‌کار رفته‌اند، از فهم حقیقت ناتوانند و فقط ناله و فریاد می‌کنند، به این معنا که نمی‌توانند به حقیقت یا پیامی که تو، یعنی مخاطب، می‌گویی، گوش دهند و درک کنند."],[568,"هین بمگذار ای شفا رنجور را","تو ز خشم کر عصای کور را","ای شفا، رنجور را رها کن و او را ترک کن، چون تو با عصبانیّت، عصای کور را تهی می‌کنی."],[568,"نه تو گفتی قاید اعمی به راه‌؟","صد ثواب و اجر یابد از اله‌؟","تو نگفتی و وعده ندادی که ...؟ و مصرع و بیت بعدی نیز به صورت پرسشی خوانده می‌شود."],[568,"هر که او چل گام کوری را کشد‌؟","گشت آمرزیده و یابد رشد‌؟","هر کس که برای راهنمایی و یاری کردن افراد ناتوان (کور) قدم بردارد، بخشوده می‌شود و به هدایت و رشد دست پیدا می‌کند."],[568,"پس بکش تو زین جهان بی‌قرار","جوق کوران را قطار اندر قطار","پس از این، تو باید از این دنیا که پر از بی‌قراری است، در جمع افرادی که در تاریکی و نادانی به سر می‌برند، بکش و آنها را به صف درآور."],[568,"کار هادی این بود تو هادی‌یی","ماتم آخر زمان را شادی‌یی","وظیفه هادی (رهنما) این است که تو هم هادی باشی، زیرا در آخر زمان، ماتم و غم وجود دارد و تو باید موجب شادی و خوشحالی شوی."],[568,"هین روان کن ای امام المتقین","این خیال‌اندیشگان را تا یقین","ای امیر پرهیزکاران، بهره‌ای از خود را به آنهایی که فقط در خیال و تصورات زندگی می‌کنند بده تا به شناخت و یقین برسند."],[568,"هر که در مکر تو دارد دل گرو","گردنش را من زنم‌، تو شاد رو","هرکسی که دلش به مکر و فریب تو وابسته است، گردن او را من می‌زنم و تو خوشحال خواهی شد."],[568,"بر سر کوریش کوری‌ها نهم","او شکر پندارد و زهرش دهم","من با مکری که دارم، بر سر کسی که نابیناست، ناراحتی‌ها و مشکلاتش را می‌گذارم. او خیال می‌کند که این کار شکرگزاری است، در حالی که من در واقع زهر و ضرر به او می‌رسانم."],[568,"عقل‌ها از نور من افروختند","مکرها از مکر من آموختند","عقل‌ها به واسطه نور من روشنایی یافتند و از فریب‌ها و نیرنگ‌های من، فریب و نیرنگ را یاد گرفتند."],[568,"چیست خود آلاجق آن ترکمان‌؟!","پیش پای نره پیلان جهان‌؟","آلاجق، نام مردی ترکمان است که در مقایسه با بزرگی و قدرت نره پیلان (فیل‌های نر) جهان، به نظر کوچک و بی‌اهمیت می‌آید. شاعر به کنایه می‌گوید که چه ارزش و عظمت و جایگاهی دارد او در برابر مخلوقاتی چون فیل‌ها که نماد بزرگی و قدرت هستند."],[568,"آن چراغ او به پیش صرصرم","خود چه باشد ای مهین پیغامبرم‌؟","این معشوق یا روشنایی که به عنوان چراغ معرفی شده، در برابر طوفان درونی من چه اهمیتی دارد، ای پیامبر بزرگ من؟"],[568,"خیز در دم تو به صور سهمناک","تا هزاران مرده بر روید ز خاک","قیامت، در دم تو به صدا درمی‌آید و زنگ خطر به صدا در می‌آید، تا هزاران مرده از زیر خاک برخیزند و زنده شوند."],[568,"چون تو اسرافیل وقتی راست خیز","رستخیزی ساز پیش از رستخیز","تو مانند اسرافیل که در روز قیامت به صدا در می‌آید، اکنون نیز برخیز و به پیشواز رستاخیز بشتاب، پیش از آنکه رستاخیز واقعی آغاز شود."],[568,"هر که گوید ‌«کو قیامت؟‌»‌ ای صنم","خویش بنما که قیامت نک منم","هر کسی که بگوید «قیامت کجاست؟»، ای معشوق من، خود را به من نشان بده؛ زیرا قیامت خود من هستم."],[568,"در نگر ای سایل محنت‌زده","زین قیامت صد جهان افزون شده","ای سؤال‌کننده محنت‌دیده، در نظر داشته باش که در این قیامت، صدها جهان بیشتر از قبل ایجاد شده است."],[568,"ور نباشد اهل این ذکر و قنوت","پس جواب الاحمق ای سلطان سکوت","اگر کسانی در این دعا و عبادت نباشند، پس جواب احمقانه این سکوت، ای فرمانروا، چیست؟"],[568,"ز آسمان‌ حق سکوت آید جواب","چون بود جانا دعا نامستجاب","از آسمان حق، سکوتی می‌آید که پاسخ‌دهنده است، اما ای جانا، دعا بی‌جواب می‌ماند."],[568,"ای دریغا وقت خرمن‌گاه شد","لیک روز از بخت ما بیگاه شد","دوران برداشت محصول در حال نزدیک شدن است، اما شگفتا که خوش‌شانسی ما باعث شده هنوز روز به این زمان نرسد."],[568,"وقت تنگ‌ست و فراخی این کلام","تنگ می‌آید بر او عمر دوام","زمان بسیار محدود است و شرایط سختی در اینجا حاکم است. در این اوضاع، این سخن به کسی که مدت عمرش طولانی است، به‌خوبی نمی‌رسد."],[568,"نیزه‌بازی اندرین کوه‌های تنگ","نیزه‌بازان را همی‌آرد به تنگ","نیزه‌بازی در این کوه‌های تنگ، باعث می‌شود که نیزه‌داران به زحمت بیفتند و در تنگنا قرار بگیرند."],[568,"وقت تنگ و خاطر و فهم عوام","تنگ‌تر صد ره ز وقت است ای غلام","صد ره‌: صد بار‌، صد مرتبه"],[568,"چون جواب احمق آمد خامشی","این درازی در سخن چون می‌کشی","وقتی که جواب فرد نادان احمقانه باشد، سکوت بهتر است؛ چون در این وضعیت، طولانی صحبت کردن موجب اتلاف وقت و بی‌فایده خواهد بود."],[568,"از کمال رحمت و موج کرم","می‌دهد هر شوره را باران و نم","از شدت رحمت و بخشندگی خداوند، حتی زمین‌های خشک و شوره‌زار هم از باران و رطوبت بهره‌مند می‌شوند."],[569,"بود شاهی بود او را بنده‌ای","مرده عقلی بود و شهوت‌زنده‌ای","شاهی وجود داشت که بنده‌ای داشت؛ این بنده از لحاظ عقل مانند مرده بود، اما از نظر شهوت بسیار زنده و فعال بود."],[569,"خرده‌های خدمتش بگذاشتی","بد سگالیدی نکو پنداشتی","خرده‌هایی که از خدمت او بر جای گذاشتی، نشانه خوبی داشت که او را نیکو پنداشتی."],[569,"گفت شاهنشه جرااش کم کنید","ور بجنگد نامش از خط بر زنید","شاه به وزیر یا فرمانده می‌گوید که اگر او (این فرد) عقلش کم است، باید او را از کار برکنار کنید و در صورتی که جنگ کند، نامش را از روی خط مبارزات و تاریخ پاک کنید."],[569,"عقل او کم بود و حرص او فزون","چون جرا کم دید شد تند و حرون","عقل او کم بوده و حرص و طمعش زیاد بوده است. وقتی کمبود عقل خود را مشاهده کرده، نگران و تندخو شده است."],[569,"عقل بودی گرد خود کردی طواف","تا بدیدی جرم خود گشتی معاف","عقل تو به دور خود می‌چرخید و در جستجوی حقیقت بود تا وقتی که عیوب و shortcomings خود را شناخت و به همین سبب عذرش پذیرفت شد."],[569,"چون خری پابسته تندد از خری","هر دو پایش بسته گردد بر سری","زمانی که خر که به پایش بسته شده، به سرعت حرکت می‌کند، هر دو پایش به خاطر همین بندها بر روی سرش می‌افتد. این تصویر به معنای این است که اکنون او در وضعیتی قرار دارد که به خاطر محدودیت‌ها و وابستگی‌هایش نمی‌تواند به درستی حرکت کند."],[569,"پس بگوید خر که یک بندم بسست","خود مدان کان دو ز فعل آن خسست","خر می‌گوید، چون یکی از بندهایش شل شده، نباید خود را آزاد تصور کند، زیرا هر دو پای او به خاطر آن عمل، به هم بسته است و حقیقت او هنوز در قید و بند است."],[570,"در حدیث آمد که یزدان مجید","خلق عالم را سه گونه آفرید","در حدیث آمده که خداوند بزرگ، جهان را به سه نوع موجود خلق کرده است."],[570,"یک گره را جمله عقل و علم و جود","آن فرشته‌ست او نداند جز سجود","عقل و دانش و داشتن بخشندگی، همه صفات فرشتگان هستند و آن فرشته (یعنی انسان) فقط می‌داند که باید با عشق و احترام در برابر خداوند سجود کند."],[570,"نیست اندر عنصرش حرص و هوا","نور مطلق زنده از عشق خدا","او (انسان) در وجودش حرص و خواسته‌های نفسانی نیست؛ بلکه نور خالص و زنده‌ای است که از محبت و عشق به خدا نشأت گرفته است."],[570,"یک گروه دیگر از دانش تهی","هم‌چو حیوان از علف در فربهی","گروهی دیگر از انسان‌ها وجود دارند که از دانش خالی‌اند و مانند حیوانات فقط به دنبال مواد غذایی و فربهی (چاق شدن) هستند."],[570,"او نبیند جز که اصطبل و علف","از شقاوت غافلست و از شرف","او (انسانی که به مقام والای خود نرسیده) جز اصطبل و علف را نمی‌بیند و از بدبختی خود بی‌خبر است و از مقام و شرف بالای انسانی غافل است."],[570,"این سوم هست آدمی‌زاد و بشر","نیم او ز افرشته و نیمیش خر","انسان دارای دو بعد است؛ یک بعد او مانند فرشتگان و بعد دیگرش شبیه به خر و حیوانات است. این شعر به تضاد میان جنبه‌های معنوی و جسمانی انسان اشاره دارد."],[570,"نیم خر خود مایل سفلی بود","نیم دیگر مایل عقلی بود","نیمی از وجود انسان متمایل به دنیاست و جنبه حیوانی او را نشان می‌دهد، و نیمه دیگرش گرایش به عقل و شناخت را دارد."],[570,"آن دو قوم آسوده از جنگ و حراب","وین بشر با دو مخالف در عذاب","دو طایفه، یعنی ملائکه و حیوانات، از جنگ و درگیری به دور هستند و آرامش دارند، اما انسان‌ها به خاطر وجود دو نیروی مخالف، عقل و شهوت، در عذاب و ناآرامی به سر می‌برند."],[570,"وین بشر هم ز امتحان قسمت شدند","آدمی شکلند و سه امت شدند","این انسان‌ها نیز به آزمون الهی دچار شدند و بر اساس آن آزمایش، به سه گروه مختلف تقسیم شدند و آدمی شکل و ظاهر می‌باشند."],[570,"یک گره مستغرق مطلق شدست","هم‌چو عیسی با ملک ملحق شدست","این بیت به شخصی اشاره دارد که به یک حالت عمیق روحانی رسیده و تمامیت وجودش در این حالت غرق شده است. او همانند عیسی (ع) که با فرشتگان ارتباط نزدیک دارد، به مقام و مرتبه‌ای نزدیک به ملائکه رسیده است."],[570,"نقش آدم لیک معنی جبرئیل","رسته از خشم و هوا و قال و قیل","آدم پس از تکوین، نقش و وظیفه‌اش را می‌داند، اما معنای جبرئیل، یعنی فرشته‌ای که نماد وحی و خداوندی است، از خشم و تمایلات نفسانی و گفتگوهای بیهوده آزاد است."],[570,"از ریاضت رسته وز زهد و جهاد","گوییا از آدمی او خود نزاد","شخصی که از ریاضت‌های روحی و زهد و جهاد عبور کرده است، به نوعی از حالت انسانی خود فراتر رفته و به مقام و مرتبه‌ای والاتر دست یافته است. این گویی از قید و بندهای انسانیت خود رها شده و به نوعی وجودی متفاوت و عالی‌تر تبدیل شده است."],[570,"قسم دیگر با خران ملحق شدند","خشم محض و شهوت مطلق شدند","گروهی دیگر به خران (خرها) ملحق شدند و دیگر چیزی جز خشم و شهوات غیر قابل کنترل در آنها وجود ندارد."],[570,"وصف جبریلی دریشان بود رفت","تنگ بود آن خانه و آن وصف زفت","جبریل (فرشته وحی) را توصیف کردند که در آن فرم و شکل خاصی دارد، اما آنجا که او حضور دارد، آنجا تنگ و سخت است و این توصیف برای او سنگین و دشوار می‌نماید."],[570,"مرده گردد شخص کو بی‌جان شود","خر شود چون جان او بی‌آن شود","اگر فردی بدون ایمان و روح باشد، به حالتی مرده و مثل یک خر تبدیل می‌شود، چون جان او از او جدا شده است."],[570,"زانک جانی کان ندارد هست پست","این سخن حقست و صوفی گفته است","کسی که روح و جان ندارد، بی‌ارزش و پست است و این سخن حقیقت دارد و همان‌طور که عارفان گفته‌اند، نشان‌دهنده اهمیت روح در وجود انسان است."],[570,"او ز حیوانها فزون‌تر جان کند","در جهان باریک کاریها کند","انسان با روح و جان خاص خود از دیگر حیوانات برتر است و در این جهان به کارهای دقیق و مهمی مشغول است."],[570,"مکر و تلبیسی که او داند تنید","آن ز حیوان دگر ناید پدید","مکرت و فریبکاری که او می‌داند بافته است، از حیوانات دیگر به وجود نمی‌آید."],[570,"جامه‌های زرکشی را بافتن","درها از قعر دریا یافتن","بهتر است که به جای تلاش برای انجام کارهای دشوار و پیچیده، به یافته‌های واقعی و طبیعی توجه کنیم، همانند اینکه به جای بافتن پارچه‌های نفیس، در عمق دریا به دنبال چیزهای با ارزش باشیم."],[570,"خرده‌کاریهای علم هندسه","یا نجوم و علم طب و فلسفه","این بیت به بیان اهمیت و ارزش علم و دانش می‌پردازد. خرده‌کاری‌ها و جزئیات علوم مختلفی چون هندسه، نجوم، طب و فلسفه اشاره می‌کند و نشان می‌دهد که تلاش در یادگیری و کمال دانش‌های مختلف، برتر از صرفا سرگرم شدن به لذت‌های دنیوی است."],[570,"که تعلق با همین دنیاستش","ره به هفتم آسمان بر نیستش","کسی که به دنیای مادی و تعلقات آن وابسته است، نمی‌تواند به جهان معنوی و آسمانی دست یابد."],[570,"این همه علم بنای آخورست","که عماد بود گاو و اشترست","علم و دانش همچون محلی برای نگهداری است که اساس آن بر روی وجود گاو و شتر قرار دارد، یعنی حیوانات برای تأمین نیازها و کارها در این محل قرار دارند. به عبارت دیگر، علم از نیازهای ابتدایی زندگی و موجودات زنده نشأت می‌گیرد و به عنوان پایگاهی برای برقراری نظم و ساختار در زندگی انسانی تلقی می‌شود."],[570,"بهر استبقای حیوان چند روز","نام آن کردند این گیجان رموز","برای حفظ بقا و زندگی حیوانات، چند روز را به نام این شور و شوق (زندگی و رفتارهای غریزی) نامیده‌اند."],[570,"علم راه حق و علم منزلش","صاحب دل داند آن را با دلش","صاحب دل، کسی است که با درک عمیق و قلبی، راه حق و جایگاه آن را می‌شناسد و این شناخت را تنها از روی علم و دانش به دست آورده است."],[570,"پس درین ترکیب حیوان لطیف","آفرید و کرد با دانش الیف","خداوند انسان را مخلوقی لطیف و با روح و عقل آفریده است و این آفریدگی به گونه‌ای است که او را به دانش و آگاهی متصل می‌سازد."],[570,"نام کالانعام کرد آن قوم را","زانک نسبت کو بیقظه نوم را","آن گروه را که به آنها می‌گویند «کالانعام» (حیوانات) به خاطر این است که نسبت به هوشیاری و آگاهی در خواب به سر می‌برند."],[570,"روح حیوانی ندارد غیر نوم","حسهای منعکس دارند قوم","این بیت می‌گوید که انسان‌ها مثل حیوانات فقط نوعی روح حیوانی ندارند و خواب (نوم) حس‌های آن‌ها را منعکس می‌کند. در واقع، انسان‌ها دارای حس‌هایی هستند که فراتر از خواب و حالت‌های حیوانی‌شان است."],[570,"یقظه آمد نوم حیوانی نماند","انعکاس حس خود از لوح خواند","زمانی که انسان بیدار می‌شود، خواب حیوانی او برطرف می‌شود و او می‌تواند احساسات و تجارب خود را از درون خود به‌درستی بشناسد و تفسیر کند."],[570,"هم‌چو حس آنک خواب او را ربود","چون شد او بیدار عکسیت نمود","همان‌طور که حس خواب کسی را می‌رباید و او را در حالت خواب می‌برد، وقتی آن شخص بیدار می‌شود، دوباره واقعیات و تصاویر را درک می‌کند."],[570,"لاجرم اسفل بود از سافلین","ترک او کن لا احب الافلین","بنابراین، کسی که شهواتش بر عقلش غلبه کند، قطعا به موجودات پست‌تر از خود تعلق دارد، پس او را رها کن زیرا من افرادی که به پستی می‌رسند را دوست ندارم."],[571,"زانک استعداد تبدیل و نبرد","بودش از پستی و آن را فوت کرد","زیرا او استعداد تغییر و نبرد را از پستی دارد اما آن را از دست داده است."],[571,"باز حیوان را چو استعداد نیست","عذر او اندر بهیمی روشنیست","اگر حیوان استعدادی برای پیشرفت و ارتقا نداشته باشد، عذری برای او وجود ندارد و در طبیعت خود (به عنوان یک موجود بی‌فکر) روشن است."],[571,"زو چو استعداد شد کان رهبرست","هر غذایی کو خورد مغز خرست","هر کس که استعداد و قابلیت دارد، به رهبری و هدایت می‌رسد. به هر غذایی که بخورد، اثرات آن به روح و ذهنش خواهد رسید، حتی اگر آن غذا از مغز خر باشد، که به معنای بی‌ارزشی و ناپسندی است."],[571,"گر بلادر خورد او افیون شود","سکته و بی‌عقلیش افزون شود","اگر بلادر (محصولات غیرمجاز) بخورد، مانند افیون می‌شود و باعث افزایش سکته و بی‌عقلی او خواهد شد."],[571,"ماند یک قسم دگر اندر جهاد","نیم حیوان نیم حی با رشاد","در اینجا مولانا به وضعیتی اشاره می‌کند که انسان‌ها در جنگ و جهاد درونی خودشان به نوعی دچار سردرگمی و دوگانگی هستند؛ یعنی نه کاملا حیوانی هستند و نه به طور کامل انسانی و شجاع. آن‌ها در این حالت میان حالت‌های مختلف در حال مبارزه‌اند."],[571,"روز و شب در جنگ و اندر کش‌مکش","کرده چالیش آخرش با اولش","انسان در طول روز و شب درگیر جنگ و نبرد با مشکلات و چالش‌هاست و سرانجام این درگیری به همان نقطه آغازین خود می‌رسد."],[572,"هم‌چو مجنون‌اند و چون ناقه‌ش یقین","می‌کشد آن پیش و این واپس به کین","چون مجنون و ناقه به هم وابسته‌اند، یکی به جلو حرکت می‌کند و دیگری به عقب بازمی‌گردد؛ در این رابطه، مجنون به دنبال عشقش می‌رود و ناقه تحت تأثیر احساساتش دچار درگیری می‌شود."],[572,"میل مجنون پیش آن لیلی روان","میل ناقه پس پی کره دوان","مجنون به سوی لیلی به شدت تمایل دارد و در حالی که ناخواسته ناقه (شتر) به سمت کره (مرکز) برمی‌گردد."],[572,"یک دم ار مجنون ز خود غافل بدی","ناقه گردیدی و واپس آمدی","اگر مجنون یک لحظه از خودش غفلت کند، مثل این می‌شود که ناقه (شتر) او به عقب برمی‌گردد و او را به نقطه اول برمی‌گرداند."],[572,"عشق و سودا چونک پر بودش بدن","می‌نبودش چاره از بی‌خود شدن","عشق و شور اگر وجودش را پر کند، بدنش دیگر در دست خود نیست و راهی جز بی‌خود شدن ندارد."],[572,"آنک او باشد مراقب، عقل بود","عقل را، سودای لیلی در ربود","در این بیت، مولانا می‌گوید وقتی عقل خود را در کنترل داشته باشد و مراقب باشد، در واقع عقل است که بر او حاکم می‌شود، اما این عشق و آرزوی لیلی (نمادی از عشق) او را به سمت خود می‌کشد و از حالت تعادل خارج می‌کند."],[572,"لیک ناقه بس مراقب بود و چست","چون بدیدی او مهار خویش سست","ولی شتری که در داستان صحبت می‌شود، بسیار مراقب و چابک بود، اما وقتی که دیدی که مهارش شل شده است، متوجه می‌شوی که او در خطر افتاده است."],[572,"فهم کردی زو که غافل گشت و دنگ","رو سپس کردی به کره بی‌درنگ","متوجه شدی که او (مجنون) از آن غافل شده و به خواب رفته است، سپس بی‌معطلی به سمت کره (مرغزار) رفتی."],[572,"چون به خود باز آمدی دیدی ز جا","کو سپس رفتست بس فرسنگها","زمانی که به خودت بازمی‌گردی، متوجه می‌شوی که از مکانی که بودی، به اندازه فراوانی فاصله گرفته‌ای."],[572,"در سه روزه ره بدین احوالها","ماند مجنون در تردد سالها","مجنون در مدت سه روز، با این وضعیت و حالت‌های متغیر، همچنان در تردید و بلاتکلیفی‌اش باقی ماند، حال آنکه این تردید او می‌توانست سال‌ها به طول بینجامد."],[572,"گفت ای ناقه چو هر دو عاشقیم","ما دو ضد پس همره نالایقیم","مجنون به شترش می‌گوید که چون ما هر دو عاشق هستیم، نمی‌توانیم در یک مسیر حرکت کنیم، زیرا ما دو ضد همدیگریم و بنابراین نمی‌توانیم با هم همراه باشیم."],[572,"نیستت بر وفق من مهر و مهار","کرد باید از تو صحبت اختیار","تو با من سازگار نیستی و نمی‌توانی من را به خواسته‌هایم برسانی، به همین دلیل باید از تو جدا شوم و به سمت صحبت و انتخابی که خودم می‌خواهم بروم."],[572,"این دو همره یکدگر را راه‌زن","گمره آن جان کو فرو ناید ز تن","این دو، یعنی جان و تن، همواره در حال نزاع و جنگ با یکدیگر هستند و تن، چون گمراهی در راه، مانع از رسیدن جان به مقصدش می‌شود."],[572,"جان ز هجر عرش اندر فاقه‌ای","تن ز عشق خاربن چون ناقه‌ای","روح انسان به خاطر دوری از عرش و عالم بالا در تنگنا و پریشانی است، و جسم او به عشق و وابستگی به مادیات مانند یک شتر در بیابان گرفتار مانده است."],[572,"جان گشاید سوی بالا بالها","در زده تن در زمین چنگالها","روح انسان به سمت آسمان پرواز می‌کند و بال و پر می‌زند، ولی تن او به زمین گرفتار شده و در چنگال‌های مادیات اسیر است."],[572,"تا تو با من باشی ای مرده وطن","پس ز لیلی دور ماند جان من","تا وقتی که تو همراه من باشی، ای شخصی که از سرزمین خود رفته‌ای و مرده‌ای، روح من از لیلی دور خواهد ماند."],[572,"روزگارم رفت زین گون حالها","هم‌چو تیه و قوم موسی سالها","زمان من نیز مانند حالاتی که قوم موسی در بیابان سرگردان بودند، به همین منوال گذشت و تلف شد."],[572,"خطوتینی بود این ره تا وصال","مانده‌ام در ره ز شستت شصت سال","من مدت طولانی به خاطر مشکلاتی که در مسیر عشق دارم، در این راه مانده‌ام و گویی برای رسیدن به معشوق، شصت سال در انتظار گذاشته‌ام."],[572,"راه نزدیک و بماندم سخت دیر","سیر گشتم زین سواری سیرسیر","من در مسیری که به وصال محبوب نزدیک است، بسیار دیر مانده‌ام و به خاطر این سفر طولانی و سخت، خسته شده‌ام."],[572,"سرنگون خود را از اشتر در فکند","گفت سوزیدم ز غم تا چندچند","مجنون از روی اجبار و غم، خود را از اسبش به زمین می‌اندازد و می‌گوید که تا کی باید از درد و اندوه رنج ببرم."],[572,"تنگ شد بر وی بیابان فراخ","خویشتن افکند اندر سنگلاخ","او در بیابانی وسیع گرفتار آمده و از شدت فشار، خود را به سنگلاخ (زمین سنگی و ناهموار) می‌اندازد."],[572,"آنچنان افکند خود را سخت زیر","که مخلخل گشت جسم آن دلیر","مجنون آن‌چنان خود را به شدت در زیر فشار می‌اندازد که جسم دلیر او دچار پریشانی و به هم ریختگی می‌شود."],[572,"چون چنان افکند خود را سوی پست","از قضا آن لحظه پایش هم شکست","وقتی او خود را به سوی پایین پرتاب کرد، به ناچار در آن لحظه پایش نیز شکست."],[572,"پای را بر بست و گفتا گو شوم","در خم چوگانش غلطان می‌روم","پایش را باند کرده و گفت که می‌خواهم در مسیر بازی چوگان به پهلو بروم و به سمت دیگری بروم."],[572,"زین کند نفرین حکیم خوش‌دهن","بر سواری کو فرو ناید ز تن","نفرین حکیمی با زبان شیرین بر سوار نادانی است که از سر و روی خود نمی‌تواند پایین بیاید."],[572,"عشق مولی کی کم از لیلی بود","گوی گشتن بهر او اولی بود","عشق مولی (خدا) به هیچ‌وجه کمتر از عشق لیلی (معشوق معروف) نیست، پس برای او (خدا) گوی‌وار در عشق افتادن بسیار مناسب‌تر است."],[572,"گوی شو می‌گرد بر پهلوی صدق","غلط غلطان در خم چوگان عشق","در بازی عشق، مانند بازی چوگان، با صدق و راستگویی، باید به دور خود بچرخیم و از دروغ و غلطی که در مسیر وجود دارد دوری کنیم. در واقع، در این عشق حقیقی، صداقت باید مانند توپی در میدان باشد که همیشه در حرکت است."],[572,"کین سفر زین پس بود جذب خدا","وان سفر بر ناقه باشد سیر ما","این سفر که از این به بعد شروع می‌شود، سفر جذب خداوند است و این سفر بر ناقه (شتر) انجام می‌شود که ما را به سوی هدف می‌برد."],[572,"این چنین سیریست مستثنی ز جنس","کان فزود از اجتهاد جن و انس","این سفر که از آن صحبت می‌شود، خاص و منحصر به فرد است و به هیچ‌وجه از آنچه که در دنیا معمول است، قابل مقایسه نیست؛ این سیر نتیجه تلاش و کوشش واقعی جن و انس است."],[572,"این چنین جذبیست نی هر جذب عام","که نهادش فضل احمد والسلام","این نوع جذبی که در اینجا توضیح داده می‌شود، مانند هر جذب عمومی نیست؛ بلکه اساس و بنیان آن فضیلت و شخصیت احمد (پیامبر اسلام) است که در آن سلام و درود فرستاده شده."],[573,"قصه کوته کن برای آن غلام","که سوی شه بر نوشته‌ست او پیام","برای آن غلامی که پیامی برای شاه نوشته، داستان را کوتاه کن."],[573,"قصه پر جنگ و پر هستی و کین","می‌فرستد پیش شاه نازنین","داستانی پر از جنگ، زندگی و نزاع به سوی شاه نازنین فرستاده می‌شود."],[573,"کالبد نامه‌ست اندر وی نگر","هست لایق شاه را آنگه ببر","درون این نامه، محتوایی وجود دارد که باید به آن توجه کرد و ببیند آیا این محتوا شایسته و مناسب شاه است یا نه."],[573,"گوشه‌ای رو نامه را بگشا بخوان","بین که حرفش هست در خورد شهان","نامه را باز کن و بخوان؛ ببین که آیا محتوایش مناسب و شایسته پادشاهان است یا خیر."],[573,"گر نباشد درخور آن را پاره کن","نامه دیگر نویس و چاره کن","اگر این نامه مناسب نیست، آن را پاره کن و نامه‌ای دیگر بنویس و برای حل این مشکل اقدام کن."],[573,"لیک فتح نامه تن زپ مدان","ورنه هر کس سر دل دیدی عیان","اما نباید گمان کنی که گشودن نامه جسم آسان است؛ چون هر کس که حقیقت دل را به وضوح ببیند، می‌فهمد که کار سختی است."],[573,"نامه بگشادن چه دشوارست و صعب","کار مردانست نه طفلان کعب","نوشتن نامه یا داستان کار دشواری است و مختص مردان بزرگ است، نه بچه‌های بی‌تجربه و کوچک."],[573,"جمله بر فهرست قانع گشته‌ایم","زانک در حرص و هوا آغشته‌ایم","ما به فهرست اکتفا کرده‌ایم، چرا که در طی حرص و تمایلات خود فراموش کرده‌ایم به معنای اصلی و محتوای نامه توجه کنیم."],[573,"باشد آن فهرست دامی عامه را","تا چنان دانند متن نامه را","فهرست، مردم را به دام می‌اندازد تا آن‌ها فقط به ظاهر مسائل توجه کنند و متن اصلی نامه را درک نکنند."],[573,"باز کن سرنامه را گردن متاب","زین سخن والله اعلم بالصواب","سرنامه را باز کن و آن را دور ننداز، زیرا خداوند بهترین قضاوت‌کننده است و از درون سخن آگاه‌تر است."],[573,"هست آن عنوان چو اقرار زبان","متن نامه سینه را کن امتحان","عنوانی که در نامه می‌نویسی، مانند اقرار و اعترافی است که با زبان بیان می‌شود. آن را با قلب و سینه‌ات آزمایش کن تا ببینی آیا واقعا درونی و صادق است یا خیر."],[573,"که موافق هست با اقرار تو","تا منافق‌وار نبود کار تو","این بیت می‌گوید که آنچه که تو به آن اعتراف می‌کنی باید با عملت هم‌خوانی داشته باشد، زیرا اگر چنین نباشد، مانند یک فرد منافق عمل کرده‌ای."],[573,"چون جوالی بس گرانی می‌بری","زان نباید کم که در وی بنگری","اگر بار سنگینی به دوش می‌کشی، نباید آن را کم کنی، بلکه باید به دقت به محتوای درون آن نگاه کنی."],[573,"که چه داری در جوال از تلخ و خوش","گر همی ارزد کشیدن را بکش","هرچه در کیسه‌ات داری، چه تلخ و چه شیرین، اگر ارزش اضافی کشیدن این بار را دارد، آن را بکش."],[573,"ورنه خالی کن جوالت را ز سنگ","باز خر خود را ازین بیگار و ننگ","اگر در جوال خود چیز مفیدی نداری، آن را از سنگ و بارهای اضافی خالی کن و همچنین بار بی‌فایده و ننگین را از دوش خود بردار."],[573,"در جوال آن کن که می‌باید کشید","سوی سلطانان و شاهان رشید","در کیسه‌ات چیزهایی را قرار بده که شایسته است به دست پادشاهان و فرمانروایان نیکو برسد."],[574,"یک فقیهی ژنده‌ها در چیده بود","در عمامه خویش در پیچیده بود","فقیهی که لباس‌های کهنه و ساده‌ای پوشیده بود، در عمامه‌اش چیزهای جالبی جمع کرده و آنها را در آن پیچیده بود."],[574,"تا شود زفت و نماید آن عظیم","چون در آید سوی محفل در حطیم","فقیه بازم در عین حال که دستار بزرگ و آراسته‌ای به سر دارد، وقتی به محفل می‌آید، به خاطر زرق و برق و عظمت ظاهری‌اش افرادی که در آنجا هستند تحت تأثیر قرار می‌گیرند."],[574,"ژنده‌ها از جامه‌ها پیراسته","ظاهرا دستار از آن آراسته","ظاهر این دستار (کلاه بزرگ) زیبا و آراسته است، اما در باطن، او (منافق) از جامه‌های کهنه و ژنده خود را پاک نکرده است."],[574,"ظاهر دستار چون حله بهشت","چون منافق اندرون رسوا و زشت","ظاهر این دستار مانند حله بهشت زیبا و جذاب است، اما در درون آن، شخصی منافق و زشت نهفته است که در واقعیت چیزی جز ناپاکی ندارد."],[574,"پاره پاره دلق و پنبه و پوستین","در درون آن عمامه بد دفین","درون دستار بزرگ آن فقیه، پارچه‌های پاره و دلق و پنبه و پوستین به‌هم‌ریخته و پنهان شده بود."],[574,"روی سوی مدرسه کرده صبوح","تا بدین ناموس یابد او فتوح","او به سمت مدرسه می‌رود تا با شرکت در این روزه‌داری (صبحانه‌خوردن) به موفقیتی دست یابد و به اهداف خود برسد."],[574,"در ره تاریک مردی جامه کن","منتظر استاده بود از بهر فن","مردی در یک راه تاریک ایستاده بود و منتظر کسی بود تا کار خاصی را انجام دهد."],[574,"در ربود او از سرش دستار را","پس دوان شد تا بسازد کار را","مرد از سر فقیه دستار او را ربود و سپس با سرعت فرار کرد تا کار خود را پیش ببرد."],[574,"پس فقیهش بانگ برزد کای پسر","باز کن دستار را آنگه ببر","فقیه به پسر گفت که دستار را باز کن و سپس آن را ببر."],[574,"این چنین که چار پره می‌پری","باز کن آن هدیه را که می‌بری","ای جوان، تو مانند پرنده‌ای هستی که به چهار سو می‌پری، حالا آن هدیه‌ای را که با خود می‌بری باز کن و نشان بده."],[574,"باز کن آن را به دست خود بمال","آنگهان خواهی ببر کردم حلال","به آن شیئی که می‌خواهی ببری، با دقت نگاه کن و آن را با دستان خود لمس کن. سپس آن را که حلال است و بدون خجالت می‌توانی ببری، ببر."],[574,"چونک بازش کرد آنک می‌گریخت","صد هزاران ژنده اندر ره بریخت","وقتی او (فقیه) دستار را باز کرد، آنکه در حال فرار بود (دزد) صدها لباس پاره و کهنه را در راه رها کرد."],[574,"زان عمامه زفت نابایست او","ماند یک گز کهنه‌ای در دست او","آن عمامه‌ی بزرگ که هنوز بر سر فقیه نایستاده و بر زمین افتاده، او را تنها با یک پاره پارچه کهنه در دستش رها کرده است."],[574,"بر زمین زد خرقه را کای بی‌عیار","زین دغل ما را بر آوردی ز کار","او خرقه (ردای) خود را بر زمین می‌زند و می‌گوید: ای بی‌ارزش، به خاطر دغل‌بازی‌ات ما را از کار و کوشش بازداشتی."],[575,"گفت بنمودم دغل لیکن ترا","از نصیحت باز گفتم ماجرا","دنیا می‌گوید که من به تو نیرنگ نشان دادم، اما من از سر نصیحت به تو گفتم که از این ماجرا دوری کن."],[575,"هم‌چنین دنیا اگر چه خوش شکفت","بانگ زد هم بی‌وفایی خویش گفت","دنیا نیز اگرچه زیبا و دل‌فریب است، در حقیقت به بی‌وفایی و ناپایداری خود اذعان داشته و این را به‌صراحت بیان می‌کند."],[575,"اندرین کون و فساد ای اوستاد","آن دغل کون و نصیحت آن فساد","در این دنیا و وضعیت فاسد، ای استاد، این دنیا دغل و نیرنگ است و نصیحتش نیز فریب‌دهنده و بی‌پایه است."],[575,"کون می‌گوید بیا من خوش‌پیم","وآن فسادش گفته رو من لا شی‌ام","کون (وجود) می‌گوید من خوب و زیبا هستم و فساد (نقص و زوال) می‌گوید تو هیچ چیزی نیستی و بهتر است به من پشت کنی."],[575,"ای ز خوبی بهاران لب گزان","بنگر آن سردی و زردی خزان","ای کسی که با زیبایی‌ات مانند بهار لب‌ها را خوشبو و شیرین می‌کنی، به سردی و زردی پاییز نگاه کن."],[575,"روز دیدی طلعت خورشید خوب","مرگ او را یاد کن وقت غروب","در روز وقتی که زیبایی خورشید را می‌بینی، یادت باشد که آن زیبایی با غروب و مرگش پایان می‌یابد."],[575,"بدر را دیدی برین خوش چار طاق","حسرتش را هم ببین اندر محاق","اگر در روز روشن، ماه کامل را بر بالای آسمان ببینی، حسرت و غم آن را هم در زمانی که در سایه (محاق) قرار می‌گیرد، به یاد داشته باش."],[575,"کودکی از حسن شد مولای خلق","بعد فردا شد خرف رسوای خلق","کودکی با زیبایی خود در میان مردم محبوب و مورد توجه بود و در نتیجه، به مقام بلندی دست یافت. اما دقت کن که فردا، آن زیبایی به پیری و فضیحت تبدیل خواهد شد و دیگر مورد توجه نخواهد بود."],[575,"گر تن سیمین‌تنان کردت شکار","بعد پیری بین تنی چون پنبه‌زار","اگر جوانی با زیبایی و ناز می‌تواند تو را فریب دهد و به چنگ آورد، در دوران پیری با این حال، بدن تو چون پنبه‌ای نرم و بی‌ارزش خواهد شد."],[575,"ای بدیده لوتهای چرب خیز","فضله آن را ببین در آب‌ریز","ای کسی که در دلت خیالات فریبنده و لذت‌طلبانه چنین می‌خزد، فضله‌ی این لذات را در جوی آب ببین که حقیقتا زشت و ناپسند است."],[575,"مر خبث را گو که آن خوبیت کو","بر طبق آن ذوق و آن نغزی و بو","به کسی که ناپاکی و بدی را می‌جوشاند، بگو کجاست آن خوبی و زیبایی که مطابق با ذوق و طعم و عطرش باشد."],[575,"گوید او آن دانه بد من دام آن","چون شدی تو صید شد دانه نهان","او به دانه‌ای که بد و نامناسب است، اشاره می‌کند و می‌گوید که وقتی تو در دام آن گرفتار شدی، دانه‌ی نهان، یعنی چیزی در پس‌پرده یا نادیده، تو را صید کرده است. در واقع، این بیت به فریبندگی دنیای بیرونی و عواقب گرفتار شدن در آن اشاره دارد."],[575,"بس انامل رشک استادان شده","در صناعت عاقبت لرزان شده","بسیاری از دست‌ها که به دنبال یادگیری هنرها هستند، حسادت استادان را برانگیخته‌اند و در نهایت این تلاش و شوق به نتیجه نرسیده و به ناامیدی بدل شده است."],[575,"نرگس چشم خمار هم‌چو جان","آخر اعمش بین و آب از وی چکان","چشم‌های خمار و فریبنده‌ای که مانند گل نرگس هستند، جان را به یاد می‌آورد، و با زیبایی خاص خود آب را به طور بی‌وقفه فرو می‌رسانند. این تصویر نشان‌دهنده جذابیت و تاثیری است که زیبایی می‌تواند بر افراد بگذارد."],[575,"حیدری کاندر صف شیران رود","آخر او مغلوب موشی می‌شود","هر که به ظاهر در میان شیران و قوی‌تر از دیگران است، در نهایت ممکن است به سادگی و ناتوانی در برابر موجودات کوچک و بی‌اهمیت مانند موش‌ها شکست بخورد و مغلوب شود."],[575,"طبع تیز دوربین محترف","چون خر پیرش ببین آخر خرف","انسانی با ذهن تیز و دوربین، در نهایت مانند یک خر پیر می‌شود و در فهم نادرست و احمقانه‌ای گرفتار می‌آید."],[575,"زلف جعد مشکبار عقل‌بر","آخرا چون دم زشت خنگ خر","زلف‌های مشکی و مجعد مانند صفات بالای عقل، در آخر کار به اندازه‌ی دم زشت و بی‌فایده‌ی خر می‌شود. این بیت به بی‌وفایی دنیا و فریبندگی ظاهری اش اشاره دارد."],[575,"خوش ببین کونش ز اول باگشاد","وآخر آن رسواییش بین و فساد","خوب است که ظاهر او را از ابتدا زیبا و فریبنده ببینی، اما در نهایت باید رسوایی و فساد او را هم ببینی."],[575,"زانک او بنمود پیدا دام را","پیش تو بر کند سبلت خام را","زیرا او به‌روشنی دام را برای تو نشان داد و راه خامی را از تو دور کرد."],[575,"پس مگو دنیا به تزویرم فریفت","ورنه عقل من ز دامش می‌گریخت","دنیا به خاطر فریبکاری‌اش تو را فریب داده است، اما اگر عقل من بود، از دام این دنیا فرار می‌کرد."],[575,"طوق زرین و حمایل بین هله","غل و زنجیری شدست و سلسله","دنیا مانند یک طوق زرین و زینتی است که در ظاهر زیبا و جذاب به نظر می‌رسد، اما در واقع انسان را به غل و زنجیر و زحمات بی‌پایان دچار کرده و او را در بند خود می‌سازد."],[575,"همچنین هر جزو عالم می‌شمر","اول و آخر در آرش در نظر","هر چیزی در این جهان باید به عنوان جزئی از عالم دانسته و شمارش شود، و در نظر گرفتن ابتدای آن (آغاز) و انتهای آن (پایان) مانند نظر به تیر آرش، که نشانه‌گذار فاصله‌ها و مرزهاست، اهمیت دارد."],[575,"هر که آخربین‌تر او مسعودتر","هر که آخوربین‌تر او مطرودتر","هرکسی که بیشتر به آخرت و پایان کارها توجه داشته باشد، خوشبخت‌تر و موفق‌تر است، و هرکسی که فقط به دنیا و خوشی‌های آن نگاه کند، از رحمت و برکت دورتر است."],[575,"روی هر یک چون مه فاخر ببین","چونک اول دیده شد آخر ببین","ظاهر هر فردی را زیبا و دل‌ربا تصور کن، ولی باید بدانیم که اولیه‌ها و آغازها را در نظر بگیریم تا به نتایج نهایی برسیم."],[575,"تا نباشی هم‌چو ابلیس اعوری","نیم بیند نیم نی چون ابتری","تا زمانی که مانند ابلیس نابینا و نادان نباشی، نمی‌توانی تمام حقیقت را ببینی؛ تو فقط بخش‌هایی از آن را می‌نگری و بخش‌هایی دیگر را نادیده می‌گیری."],[575,"دید طین آدم و دینش ندید","این جهان دید آن جهان‌بینش ندید","این روزها که آدمی به جهان مادی و ظاهری می‌نگرد، حقیقت وجودی و دین واقعی او را نمی‌بیند، بلکه او باید به جهان معنوی نگاه کند که از آن غافل است."],[575,"فضل مردان بر زنان ای بو شجاع","نیست بهر قوت و کسب و ضیاع","ارزش و برتری مردان بر زنان، ای بوشجاع، به خاطر قدرت و تلاش در کسب روزی نیست."],[575,"ورنه شیر و پیل را بر آدمی","فضل بودی بهر قوت ای عمی","اگر قرار باشد که شیر و فیل بر آدمی فضیلت داشته باشند، این به خاطر قدرت و توانایی آن‌ها است. ولی در واقع، انسان به خاطر عقل و فهم خود برتری دارد و این ویژگی‌ها مهم‌تر از قدرت جسمی هستند."],[575,"فضل مردان بر زن ای حالی‌پرست","زان بود که مرد پایان بین‌ترست","فضیلت مردان بر زنان به این دلیل است که مردان بیشتر به فکر پایان کار و عاقبت هستند، در حالی‌که زنان بیشتر به حال و لحظه‌های فعلی توجه دارند."],[575,"مرد کاندر عاقبت‌بینی خمست","او ز اهل عاقبت چون زن کمست","مردی که در عاقبت‌نگری تنها به فکر خود و در نتیجه منافع شخصی‌اش باشد، در حقیقت از زنان کمتر عاقبت‌بین است، چرا که زنان معمولا به عواقب کارهای خود بیشتر توجه می‌کنند."],[575,"از جهان دو بانگ می‌آید به ضد","تا کدامین را تو باشی مستعد","از این دنیا دو ندا به گوش می‌رسد که هر کدام در تضاد با دیگری هستند؛ حال تو باید ببینی کدام یک از این نداها تو را برای پذیرش و انجام کارهایشان آماده می‌کند."],[575,"آن یکی بانگش نشور اتقیا","وان یکی بانگش فریب اشقیا","یک صدا از عالم وجود کارکنان پارسا را به نیکی و تقوی دعوت می‌کند و صدای دیگری به فریب‌کاری و ناپاکی بدکاران می‌پردازد."],[575,"من شکوفه خارم ای خوش گرمدار","گل بریزد من بمانم شاخ خار","من مانند شکوفه‌ای از خار هستم که اگر کسی مرا گرم نگه‌دارد و از من مراقبت کند، گل‌ها می‌ریزند و من به عنوان شاخ خار باقی می‌مانم. این بیت به بی‌وفایی و ناپایداری دنیا اشاره دارد، که اگرچه ممکن است به ظاهری زیبا باشد، اما در حقیقت ریشه در تلخی و زحمت دارد."],[575,"بانگ اشکوفه‌ش که اینک گل‌فروش","بانگ خار او که سوی ما مکوش","صدای شکوفه‌ای که اکنون گل‌فروش (فروشنده گل) را صدا می‌زند، صدای خار (به معنای گل نبودن است) است و نباید به سوی ما بیایی؛ یعنی نباید به ما وابسته شوی."],[575,"این پذیرفتی بماندی زان دگر","که محب از ضد محبوبست کر","اگر تو این را پذیرفته‌ای که از آن دیگری بمانی، بدان که محبت حقیقی از ضد محبوب می‌آید و محبت واقعی به چیزی که آن را دوست داریم در تضاد با آنچه که دوست نداریم شکل می‌گیرد."],[575,"آن یکی بانگ این که اینک حاضرم","بانگ دیگر بنگر اندر آخرم","من یک صدا دارم که می‌گوید «من اکنون حاضر هستم»، اما صدای دیگری هم دارم که به تو می‌گوید به نتیجه نهایی نگاه کن."],[575,"حاضری‌ام هست چون مکر و کمین","نقش آخر ز آینه اول ببین","اگرچه من اکنون در دسترس و حاضر هستم، اما باید توجه کنی که چهره واقعی من ممکن است در نهایت فریبنده باشد. باید به عواقب و نتایج نهایی کارها دقت کنی، نه فقط به ظاهر اولیه‌ام."],[575,"چون یکی زین دو جوال اندر شدی","آن دگر را ضد و نا درخور شدی","وقتی که تو در یکی از این دو کیسه (جوال) قرار گرفتی، دیگر آن کیسه دیگر برای تو ناسزا و نامناسب و بی‌فایده می‌شود."],[575,"ای خنک آنکو ز اول آن شنید","کش عقول و مسمع مردان شنید","خوشا به حال کسی که از ابتدا به سخنان حکیمانه و نصایح دیگران گوش فرا داده و درک کرده است، زیرا او از عقل و فهم بیشتری برخوردار است."],[575,"خانه خالی یافت و جا را او گرفت","غیر آنش کژ نماید یا شگفت","آن شخص در خانه‌ای خالی را پیدا کرد و در آن جا مستقر شد، اما اگر غیر از آن باشد، ممکن است وضعیت‌ها را بدتر یا حیرت‌انگیز کند."],[575,"کوزه نو کو به خود بولی کشید","آن خبث را آب نتواند برید","کوزه‌ای نو برای جمع‌آوری آب ساخته شد، اما این کوزه نمی‌تواند آلودگی و پلیدی که در آن وجود دارد را برطرف کند. به عبارتی، هر چیزی اگر از ابتدا ناپاک باشد، حتی تازه و نو هم که باشد، نمی‌تواند پاکی را به خود بگیرد."],[575,"در جهان هر چیز چیزی می‌کشد","کفر کافر را و مرشد را رشد","در این دنیا هر چیزی جاذبه‌ای دارد؛ کافر به کفر خود کشیده می‌شود و مرشد نیز به سوی رشد و کمال خود."],[575,"کهربا هم هست و مغناطیس هست","تا تو آهن یا کهی آیی بشست","در این دنیا هم سنگ‌های کهربا وجود دارد و هم قدرت مغناطیس، ولی تنها زمانی تأثیرگذارند که تو به آن‌ها نزدیک شوی و جذب‌شان کنی."],[575,"برد مغناطیست ار تو آهنی","ور کهی بر کهربا بر می‌تنی","اگر تو مانند آهن هستی، برد مغناطیس تو را جذب می‌کند، و اگر هم چون کهربا هستی، بر روی آن نشسته و جاذبه‌اش را نمی‌چشی."],[575,"آن یکی چون نیست با اخیار یار","لاجرم شد پهلوی فجار جار","کسی که با نیکان و خوبان نیست و پیوند ندارد، به ناچار نزدیک زشت‌کاران و بدکاران می‌شود."],[575,"هست موسی پیش قبطی بس ذمیم","هست هامان پیش سبطی بس رجیم","موسی در برابر قبطی (مردم فرعونی) انسانی پاک و بافضیلت است، در حالی که هامان (وزیر فرعون که نماد فساد و پلیدی است) در کنار سبطی (موسی) شخصیتی فرومایه و زشت دارد. این بیت به تضاد بین شخصیت‌های خوب و بد اشاره دارد."],[575,"جان هامان جاذب قبطی شده","جان موسی طالب سبطی شده","جان هامان به خاطر ویژگی‌های منفی‌اش و ظلمش، به قبطی‌ها متمایل شده و در مقابل، جان موسی به خاطر طلب خوبی‌ها و ویژگی‌های نیکو، به سمت بنی‌اسرائیل (سبطی) کشیده شده است."],[575,"معده خر که کشد در اجتذاب","معده آدم جذوب گندم آب","معده خر که خوراکش علف و گیاه است، اگر در جاذبه معده انسان، که غذایش گندم و آب است، قرار بگیرد، به آن جذب می‌شود. این بیت به تفاوت‌های طبیعی و نیازهای افراد اشاره دارد و می‌گوید که هر موجودی بر اساس نیازها و نوع خوراکش، به چیزهایی خاص جذب می‌شود."],[575,"گر تو نشناسی کسی را از ظلام","بنگر او را کوش سازیدست امام","اگر تو نتوانی کسی را از روی ظاهر بشناسی، باید به او توجه کنی و ببینی که چه کارها و اعمالی دارد؛ زیرا ممکن است او از نظر روحانی و باطنی مانند یک پیشوای بزرگ باشد."],[576,"زانک هر کره پی مادر رود","تا بدان جنسیتش پیدا شود","هر نوزاد در آغاز زندگی به سمت مادرش می‌رود تا هویت و ویژگی‌های خود را از او بگیرد و به جنسیت و ماهیتش پی ببرد."],[576,"آدمی را شیر از سینه رسد","شیر خر از نیم زیرینه رسد","انسان به اندازه تلاشی که می‌کند و از قدرت الهی بهره‌مند می‌شود، از نعمت‌ها و دانش‌های الهی برخوردار می‌شود؛ گویی که از سینه‌اش شیری زنده می‌چشد و این نعمت‌ها همانند شیر از پایین‌ترین سطح وجود او می‌رسد."],[576,"عدل قسامست و قسمت کردنیست","این عجب که جبر نی و ظلم نیست","عدل، سهمی است که به هرکس داده می‌شود و این شگفتی در آن است که نه جبر وجود دارد و نه ظلم. یعنی در نظام قضا و قدر، انسان با اختیار خود سهم خود را می‌پذیرد و در آن اجبار یا ستمی نیست."],[576,"جبر بودی کی پشیمانی بدی","ظلم بودی کی نگهبانی بدی","اگر جبر وجود داشت، هیچ‌گاه انسان نمی‌توانست از کارهای خود پشیمان شود و اگر ظلم در کار بود، هیچ کس نمی‌توانست از چیزی محافظت کند."],[576,"روز آخر شد سبق فردا بود","راز ما را روز کی گنجا بود","زمانی که روز آخر فرا می‌رسد، دیگر فرصتی برای فردا وجود ندارد و رازهای ما تنها در روز معین و خاصی آشکار خواهند شد."],[576,"ای بکرده اعتماد واثقی","بر دم و بر چاپلوس فاسقی","ای کسی که به آدم‌های فاسد و چاپلوس دل بسته‌ای و به آن‌ها اعتماد کرده‌ای."],[576,"قبه‌ای بر ساختستی از حباب","آخر آن خیمه‌ست بس واهی‌طناب","تو بر اساس توهمات و خیالات خود، یک قبه یا بنای ظاهری ساخته‌ای که در واقع آن‌قدر ضعیف و بی‌اساس است که مانند حباب می‌پنداری. تنها چیزی که در آن‌جا قرار دارد، «خیمه‌ای» بی‌پایه و اساس است."],[576,"زرق چون برقست و اندر نور آن","راه نتوانند دیدن ره‌روان","از دیدگاه مولانا، زرق (ظاهر و غل و زنجیر دنیا) مانند برقی است که ناگهان می‌درخشد و در نور حقیقتی که وجود دارد، مسافران حقیقت نمی‌توانند راه را ببینند. در واقع، دنیا و ظواهر آن مانع از درک حقیقت هستند."],[576,"این جهان و اهل او بی‌حاصل‌اند","هر دو اندر بی‌وفایی یکدل‌اند","این دنیا و مردم آن بی‌فایده و بی‌ارزش هستند و همگی در عدم وفا و عدم پایبندی به چیزی مشترک‌اند."],[576,"زاده دنیا چو دنیا بی‌وفاست","گرچه رو آرد به تو آن رو قفاست","فرزندان این دنیا هم مانند خود دنیا بی‌وفا هستند، هرچند اگر کسی به تو روی خوش نشان دهد، در واقع آن روی خوش ناپایدار است."],[576,"اهل آن عالم چو آن عالم ز بر","تا ابد در عهد و پیمان مستمر","ساکنان آن عالم (جهان معنوی) همچون خود آن عالم به‌طور دائم در عهد و پیمان با یکدیگر هستند و این رابطه‌ی مستمر تا ابد ادامه دارد."],[576,"خود دو پیغمبر به هم کی ضد شدند","معجزات از همدگر کی بستدند","پیامبران به چه دلیلی با یکدیگر مخالف شدند؟ آیا معجزاتی که هرکدام داشتند، نتیجه یکدیگر را تحت‌الشعاع قرار داد؟"],[576,"کی شود پژمرده میوه آن جهان","شادی عقلی نگردد اندهان","میوه عالم بالا هرگز پژمرده نمی‌شود و شادی واقعی که از عقل و معرفت می‌آید، در آن جا همیشه وجود دارد."],[576,"نفس بی‌عهدست زان رو کشتنیست","او دنی و قبله‌گاه او دنیست","نفس انسان تا زمانی که به دنیا وابسته است و با آن پیمان بسته، همیشه در حال آسیب‌پذیری و زوال است. دنیای مادی، هدف و جهت‌گیری اصلی نفس او را تشکیل می‌دهد و باعث می‌شود به آنچه در این دنیا وجود دارد، وابسته باشد."],[576,"نفسها را لایقست این انجمن","مرده را درخور بود گور و کفن","این جمع تنها برای نفس‌های مرده مناسب است و از آن‌جا که این نفس‌ها در مرحله بی‌حالی و ناتوانی هستند، درخور گور و کفن‌اند."],[576,"نفس اگر چه زیرکست و خرده‌دان","قبله‌اش دنیاست او را مرده دان","اگرچه نفس انسان هوشمند و دانشمند به نظر می‌رسد، ولی چون هدف اصلی‌اش دنیا و امور دنیوی است، در واقع به حسرت و عدم حیات حقیقی، مرده‌ای بیش نیست."],[576,"آب وحی حق بدین مرده رسید","شد ز خاک مرده‌ای زنده پدید","وحی الهی به این انسان مرده‌ی بی‌جان رسید و او را از حالت مردگی خارج کرد، به‌گونه‌ای که از خاکی که مرده بود، زندگی و حیات تازه‌ای پدید آمد."],[576,"تا نیاید وحش تو غره مباش","تو بدان گلگونه طال بقاش","تا زمانی که وحشت و ترس در تو نیاید، فریب نخور و خود را گول نزن. تو باید به زیبایی و لطافت آن نور الهی واقف باشی و به یاد داشته باشی."],[576,"بانگ و صیتی جو که آن خامل نشد","تاب خورشیدی که آن آفل نشد","اگر کسی تاب و توان پذیرش حقیقت را ندارد، نباید به او فشار آورد، زیرا حقیقت مانند نور خورشید است و فقط کسانی که لیاقت آن را دارند، می‌توانند آن را درک کنند."],[576,"آن هنرهای دقیق و قال و قیل","قوم فرعون‌اند اجل چون آب نیل","هر هنر و زیبایی که مردم به آن دلبسته‌اند، مانند گفت‌وگوها و مباحثات سطحی، شباهتی به هنرهای عمیق و حقیقی ندارد و در واقع، این‌ها یادآور فرعونیان هستند که به زودی به سرنوشت خود خواهند رسید. مانند آب نیل که در نهایت به هلاکت آنها انجامید."],[576,"رونق و طاق و طرنب و سحرشان","گرچه خلقان را کشد گردن کشان","زرق و برق و جاذبه‌های هنر ساحران، هرچند که مردم را به خود جذب می‌کند و تحت تأثیر قرار می‌دهد، اما در واقع این‌ها چیزی جز فریب نیست و دشواری و مشکلاتی را به دنبال دارد."],[576,"سحرهای ساحران دان جمله را","مرگ چوبی دان که آن گشت اژدها","سحر و جادوهایی که ساحران انجام می‌دهند، در واقع اشاره به مرگ و فنا دارد و مانند چوبی است که به اژدهایی تبدیل می‌شود. یعنی این سحرها ظاهری فریبنده دارند، اما در حقیقت meaningless و بی‌اساس هستند."],[576,"جادویها را همه یک لقمه کرد","یک جهان پر شب بد آن را صبح خورد","تمام جادوها و ترفندها را در یک لحظه جمع کرده و یک دنیای تاریک را که پر از شب بود، به صبح روشن تبدیل کرد."],[576,"نور از آن خوردن نشد افزون و بیش","بل همان سانست کو بودست پیش","نور حاصل از این خوردن افزایش نمی‌یابد و همچون گذشته که بود، همان‌طور باقی می‌ماند."],[576,"در اثر افزون شد و در ذات نی","ذات را افزونی و آفات نی","در نتیجه، اصل ماهیت هیچ‌گاه در اثر تغییر نمی‌کند و دچار زیادتی یا نقص نمی‌گردد؛ تغییرات فقط در نتایج و ظواهر دیده می‌شود، نه در ذات حقیقی."],[576,"حق ز ایجاد جهان افزون نشد","آنچ اول آن نبود اکنون نشد","حق با ایجاد جهان بیشتر نشده و آنچه در آغاز بود، همان قدر باقی مانده است."],[576,"لیک افزون گشت اثر ز ایجاد خلق","در میان این دو افزونیست فرق","ولی افزایش اثر از ایجاد مخلوقات در این جهان یک تفاوت با افزایش واقعی دارد."],[576,"هست افزونی اثر اظهار او","تا پدید آید صفات و کار او","اثر نمایان شدن خداوند، به اندازه‌ای است که صفات و کارهای او در دنیا به وضوح و روشنی نمایان می‌شود."],[576,"هست افزونی هر ذاتی دلیل","کو بود حادث به علتها علیل","هر ویژگی یا صفتی که در موجودی وجود دارد، نشانه‌ای است بر اینکه آن موجود به خاطر یک علت خاص به وجود آمده و خود به تنهایی نمی‌تواند مستقل باشد، زیرا باعث ایجاد مشکلات و ناتوانی خواهد شد."],[577,"گفت موسی سحر هم حیران‌کنیست","چون کنم کین خلق را تمییز نیست","موسی می‌گوید سحر نیز باعث حیرت نمی‌شود؛ زیرا نمی‌دانم چگونه این کار را انجام دهم، چرا که مردم توانایی تشخیص حق را ندارند."],[577,"گفت حق تمییز را پیدا کنم","عقل بی‌تمییز را بینا کنم","حق گفت: من درک و تمییز را در تو به وجود می‌آورم، و عقل بدون تمییز را نیز به بینایی و فهمی شایسته می‌رسانم."],[577,"گرچه چون دریا برآوردند کف","موسیا تو غالب آیی لا تخف","چنان‌که اگر دریا کف‌های زیادی روی خود داشته باشد، اما تو همچنان بر آن غالب هستی و نترس."],[577,"بود اندر عهد خود سحر افتخار","چون عصا شد مار آنها گشت عار","در زمان‌های گذشته، سحر و جادو به عنوان یک امر افتخارآمیز و برجسته تلقی می‌شد، اما در نهایت، مانند عصایی که به مار تبدیل می‌شود، سحرکاران در برابر قدرت‌های الهی و حقایق بزرگ شکست خوردند و این شکست عیبی برای آن‌ها به حساب آمد."],[577,"هر کسی را دعوی حسن و نمک","سنگ مرگ آمد نمکها را محک","هر کسی ادعا می‌کند که زیبا و خوش‌خوی است، اما در نهایت مرگ، همچون نمکی که می‌تواند میزان واقعی را مشخص کند، همه را آزمایش می‌کند."],[577,"سحر رفت و معجزه موسی گذشت","هر دو را از بام بود افتاد طشت","سحر و معجزه موسی گذشته است و هر دوی آنها از بلندی در حال سقوط هستند. این نشان‌دهنده پایان شگفتی‌ها و قدرت‌های خیره‌کننده است."],[577,"بانگ طشت سحر جز لعنت چه ماند","بانگ طشت دین به جز رفعت چه ماند","صدای طشت سحر، جز نفرین و لعنت چیزی ندارد و صدای طشت دین نیز، جز بالا رفتن و علو جایگاه، هیچ معنی دیگری ندارد."],[577,"چون محک پنهان شدست از مرد و زن","در صف آ ای قلب و اکنون لاف زن","چون معیاری که مشخص‌کننده حق و باطل است، از مردان و زنان پنهان شده است، ای دل، حالا باید با قوت و اطمینان، ادعای خود را بیان کنی."],[577,"وقت لافستت محک چون غایبست","می‌برندت از عزیزی دست دست","زمانی که حال لاف زنی و ادعا کردن است، اگر محک (معیار) غایب باشد، تو را از عزیزان و برگزیدگان دور می‌کنند."],[577,"قلب می‌گوید ز نخوت هر دمم","ای زر خالص من از تو کی کمم","قلب به طعنه می‌گوید: ای طلا (زر خالص)، من با هر ترفند و فخر و بزرگی که تو داری، هیچ کمبود و نقصی از تو ندارم."],[577,"زر همی‌گوید بلی ای خواجه‌تاش","لیک می‌آید محک آماده باش","زر (طلا) پاسخ می‌دهد که بله، ای خواجه‌تاش، اما باید منتظر بمانی تا محک (آزمون) بیاید و نشت و نمای حقیقی تو را نشان دهد."],[577,"مرگ تن هدیه‌ست بر اصحاب راز","زر خالص را چه نقصانست گاز","مرگ بدن، چیزی شبیه یک هدیه برای کسانی است که به درون خود آگاهند و اسرار را می‌دانند. برای طلای خالص، هیچ کمبودی از نظر کیفیت وجود ندارد، حتی اگر در آتش ذوب شود."],[577,"قلب اگر در خویش آخربین بدی","آن سیه که آخر شد او اول شدی","اگر قلبت در نظر خودت فقط پایان چیزها را ببیند، آن بدی که در آخر به وجود آمده، در حقیقت همان چیزی است که ابتدا به وجود آمده است."],[577,"چون شدی اول سیه اندر لقا","دور بودی از نفاق و از شقا","وقتی که در گردهمایی و وصال حق، به اوج مقامات رسیدی، در آن زمان دور از نفاق (دوگانگی) و شقاوت (بدبختی) خواهی بود."],[577,"کیمیای فضل را طالب بدی","عقل او بر زرق او غالب بدی","کسی که به دنبال دانش و فضیلت است، عقل او بر ظاهر فریبنده و زرق و ورق غلبه پیدا می‌کند. به عبارتی، کسی که حقیقت را می‌جوید، نباید به طلا و زرق و برق دنیا فریب بخورد."],[577,"چون شکسته‌دل شدی از حال خویش","جابر اشکستگان دیدی به پیش","وقتی که به خاطر وضعیت خود غمگین و شکسته‌دل می‌شوی، افرادی را که مانند تو دچار شکستگی و درد هستند، در مقابل خود می‌بینی."],[577,"عاقبت را دید و او اشکسته شد","از شکسته‌بند در دم بسته شد","در نهایت، او (موسی) به حقیقتی پی می‌برد و از درد و رنجی که تحمل کرده است، متاثر و اندوهگین می‌شود. از درون آن زخم و شکست، به حالتی عمیق و غمگین می‌رسد."],[577,"فضل مسها را سوی اکسیر راند","آن زراندود از کرم محروم ماند","زراندودی که با طلا پوشیده شده، به خاطر زشتی‌اش به سمت اکسیر (عنصری که می‌تواند طلا متحول کند) رانده می‌شود و به دلیل خوبی و کرم (سخاوت) از آن محروم می‌ماند."],[577,"ای زراندوده مکن دعوی ببین","که نماند مشتریت اعمی چنین","ای کسی که به طلا و زر آراسته‌ای، ادعای خود را کنار بگذار، زیرا مشتریان نابینا و نادان، همچنان مثل تو نمی‌توانند چیزی را ببینند و ارزش تو را درک کنند."],[577,"نور محشر چشمشان بینا کند","چشم بندی ترا رسوا کند","در روز محشر، نور حقیقت چشمان آنها را بیدار و بینا می‌کند و باعث می‌شود که نیرنگ‌ها و ترفندهایت را آشکار کند و رسوایت سازد."],[577,"بنگر آنها را که آخر دیده‌اند","حسرت جانها و رشک دیده‌اند","به آن کسان توجه کن که در نهایت درد و حسرت جان‌ها را دیده‌اند و به آرزوی دیگران حسرت می‌خورند."],[577,"بنگر آنها را که حالی دیده‌اند","سر فاسد ز اصل سر ببریده‌اند","به کسانی توجه کن که حال و وضعیت خود را درک کرده‌اند و از بنیاد وجود خود جدا شده و بی‌ریشه و نابود شده‌اند."],[577,"پیش حالی‌بین که در جهلست و شک","صبح صادق صبح کاذب هر دو یک","کسی که در حالت آگاهی و روشن‌بینی قرار دارد، باید بداند که فرد جاهل و شک‌زده، مانند کسی است که در تاریکی نفس می‌کشد، و هر دو در حقیقت به یک اندازه از واقعیت دور هستند."],[577,"صبح کاذب صد هزاران کاروان","داد بر باد هلاکت ای جوان","صبح کاذب، یعنی صبح دروغین و نابجا، باعث از دست رفتن و نابودی بسیاری از کاروان‌ها شده است. ای جوان، مراقب باش که این زمان نادرست تو را به خطر نیندازد."],[577,"نیست نقدی کش غلط‌انداز نیست","وای آن جان کش محک و گاز نیست","در اینجا به این موضوع اشاره می‌شود که حتی ارزش‌های ارزش‌گذاری و امتحان‌های نادرست هم نمی‌توانند حقیقت را تحریف کنند. همچنین، جان‌ها به خاطر سختی‌ها و فشارهایی که از طرف این آزمون‌ها می‌کشند، صدمه نمی‌بینند و قدرت حقیقی آنها از بین نمی‌رود."],[578,"بو مسیلم گفت خود من احمدم","دین احمد را به فن برهم زدم","مسیلمه، که ادعای نبوت کرده، می‌گوید من خود را احمد معرفی می‌کنم و دین پیامبر احمد (حضرت محمد) را با کج‌فهمی و نادرست به هم ریختم."],[578,"بو مسیلم را بگو کم کن بطر","غره اول مشو آخر نگر","به بو مسیلم بگو که اعتماد به نفس و غرور بیش از اندازه‌اش را کاهش دهد و به جای اینکه فقط به اولویت‌های خود فکر کند، نهایت کارش را هم در نظر بگیرد."],[578,"این قلاوزی مکن از حرص جمع","پس‌روی کن تا رود در پیش شمع","به خاطر حرص و طمع، صحبت‌های بیهوده نکن و عقب نرو، بلکه باید به جلو حرکت کنی و به نور هدایت نزدیک شوی."],[578,"شمع مقصد را نماید هم‌چو ماه","کین طرف دانه‌ست یا خود دامگاه","شمع، مقصد را مانند ماه روشن می‌کند، زیرا این سوی شمع دانه‌ای وجود دارد یا خود دامگاهی است که در آن حضور دارد."],[578,"گر بخواهی ور نخواهی با چراغ","دیده گردد نقش باز و نقش زاغ","اگر بخواهی یا نخواهی، با چشم روشنت بعدها و تصویرهای مختلف دیده می‌شود، حتی تصویر پرنده‌ای مانند باز و زاغ."],[578,"ورنه این زاغان دغل افروختند","بانگ بازان سپید آموختند","اگر زاغان حیله‌گر به چیزی دست یازند، دیگران هم صدای پرندگان سفید را یاد می‌گیرند و از آن تقلید می‌کنند."],[578,"بانگ هدهد گر بیاموزد فتی","راز هدهد کو و پیغام سبا","اگر هدهد صدای خود را بلند کند و رازی بیان کند، باید ببینیم که هدهد کجاست و پیغام سلیمان را از سرزمین سبا به کجا می‌رساند."],[578,"بانگ بر رسته ز بر بسته بدان","تاج شاهان را ز تاج هدهدان","اگر هدهد به درستی بیاموزد و پیام را برساند، باید در عوض به شاهان و بزرگانی که در مقام و مقام‌ها هستند، احترام بگذارد و به راز زندگی آن‌ها واقف باشد."],[578,"حرف درویشان و نکته عارفان","بسته‌اند این بی‌حیایان بر زبان","درویشان و عارفان حقایق عمیق و نغز را در سخنان خود بیان کرده‌اند، اما این افراد بی‌شرم (بی‌حیایان) سخن آن‌ها را مسدود کرده و نمی‌توانند آنها را درست بیان کنند."],[578,"هر هلاک امت پیشین که بود","زانک چندل را گمان بردند عود","هر آنچه بلا و نابودی بر سر امم گذشته آمده، به این دلیل بوده که آنها در مورد چوبی که به سمت آتش می‌رفت (درخت چندل)، گمان بد کردند و فکر کردند که می‌تواند در آتش برگردد."],[578,"بودشان تمییز کان مظهر کند","لیک حرص و آز کور و کر کند","آن‌ها توانایی تمییز میان خوب و بد را داشتند، اما حرص و آز باعث می‌شود که نابینا و ناشنوا شوند و نتوانند حقیقت را ببینند."],[578,"کوری کوران ز رحمت دور نیست","کوری حرص است که آن معذور نیست","کسانی که نابینا هستند، از رحمت خدا دور نیستند، بلکه نابینایی ناشی از حرص و طمع است که قابل توجیه نیست."],[578,"چارمیخ شه ز رحمت دور نی","چار میخ حاسدی مغفور نی","خداوند با رحمت خود از چهار میخ (یعنی از چهار عنصر یا جهات) دور نیست، اما حاسد که همیشه به دیگران حسادت می‌ورزد تحت عذاب و عدم مغفرت قرار دارد."],[578,"ماهیا آخر نگر بنگر بشست","بدگلویی چشم آخربینت ببست","ای انسان، در آخر به این حقیقت بنگر که همچون ماهی در آب هستی، و اگر آخرین چشمانت را به دنیا ببندی و بر روی گل و لجن‌های آن متمرکز شوی، به زشتی و آلودگی گرفتار می‌ شوی."],[578,"با دو دیده اول و آخر ببین","هین مباش اعور چو ابلیس لعین","با دو چشم خود از ابتدا و انتهای چیزها را ببین و مانند ابلیس لعنت‌شده نباش که یک‌سویه و کور است."],[578,"اعور آن باشد که حالی دید و بس","چون بهایم بی‌خبر از بازپس","کسی که فقط ظاهری از بینایی دارد و فقط به آنچه مقابلش است نگاه می‌کند، مانند حیواناتی که از گذشته یا آینده خود بی‌خبر هستند، نه درک عمیق‌تری از واقعیت دارند و نه به تفکر در مورد آنچه فراتر از لحظه حال است می‌پردازند."],[578,"چون دو چشم گاو در جرم تلف","هم‌چو یک چشمست کش نبود شرف","اگر دو چشم یک گاو را با هم در نظر بگیریم، آنها از نظر جرم و اندازه شبیه یک چشم هستند و در اینجا به این نکته اشاره می‌شود که در حالی که یک گاو از نظر فیزیکی دو چشم دارد، این دو چشم از نظر ارزش و شخصیت هیچ برتری بر یک چشم ندارند."],[578,"نصف قیمت ارزد آن دو چشم او","که دو چشمش راست مسند چشم تو","دو چشم او (که به گاو در بیت پیشین اشاره دارد) نصف قیمت هم نمی‌ارزد، چون دو چشمی که راست بر مسند چشم تو (انسان) قرار دارد، ارزش بیشتری دارد."],[578,"ور کنی یک چشم آدم‌زاده‌ای","نصف قیمت لایقست از جاده‌ای","اگر تو فقط یک چشم از آدم‌زاده‌ای (انسانی) را از جاده‌ای (راهی) خراب کنی، ارزش آن به نصف هم نمی‌رسد."],[578,"زانک چشم آدمی تنها به خود","بی دو چشم یار کاری می‌کند","چشم انسان به تنهایی و بدون یاری دیگری، قدرت و اثرگذاری خاصی دارد و می‌تواند کارهای زیادی انجام دهد."],[578,"چشم خر چون اولش بی آخرست","گر دو چشمش هست حکمش اعورست","چشم الاغ یعنی همان چشم خر تنها به یک طرف نگاه می‌کند و چون بینا نیست، توانایی درست دیدن را ندارد. پس اگرچه او دو چشم دارد، ولی چون یکی از چشم‌ها نمی‌تواند درست ببیند، در حکم فردی نابینا است."],[578,"این سخن پایان ندارد وان خفیف","می‌نویسد رقعه در طمع رغیف","این گفت‌وسو پایان ندارد و آن حقیر (شخصی که در اینجا از او سخن می‌رود) در آرزوی لقمه‌ای نان، دائم مطالبی را می‌نویسد."],[579,"رفت پیش از نامه پیش مطبخی","کای بخیل از مطبخ شاه سخی","غلام ما به نزد مطبخ‌دار (آشپز) رفت و به او گفت: ای بخیل، تو از سفره فراخ و بخشش شاه دوری می‌کنی."],[579,"دور ازو وز همت او کین قدر","از جری‌ام آیدش اندر نظر","دوری از او و از همت او باعث شده است که اینقدر از جری (رنج و عذاب) به من برسد و در نظر او کوچک و بی‌ارزش شوم."],[579,"گفت بهر مصلحت فرموده است","نه برای بخل و نه تنگی دست","او می‌گوید که این تصمیم به خاطر دلسوزی و صلاح کار گفته شده است، نه به خاطر خساست و نه به خاطر ناتوانی مالی."],[579,"گفت دهلیزیست والله این سخن","پیش شه خاکست هم زر کهن","گفت که این سخن، مانند دهلیزی است که در آن نزد شاه، خاکی هم به اندازه طلا موجود است؛ یعنی این مکالمه و گفت‌وگو در پیشگاه پادشاه ارزش و اهمیت دارد، حتی اگر ظاهری بی‌اهمیت یا گلی داشته باشد."],[579,"مطبخی ده گونه حجت بر فراشت","او همه رد کرد از حرصی که داشت","مطبخی (آشپز) به ده گونه دلیل برتری خود را مطرح کرد، اما او (شه) همه آن‌ها را به‌خاطر حرص و طمعی که داشت، رد کرد."],[579,"چون جری کم آمدش در وقت چاشت","زد بسی تشنیع او سودی نداشت","وقتی جری، غلام، در وقت صبحانه کم آورد و به خاطر آن سرزنش‌های زیادی دریافت کرد، این سرزنش‌ها برای او هیچ فایده‌ای نداشت."],[579,"گفت قاصد می‌کنید اینها شما","گفت نه که بنده فرمانیم ما","قاصدی گفت آیا شما می‌خواهید این کارها را انجام دهید؟ او پاسخ داد که نه، ما فقط بنده‌ای هستیم که از فرمان شما پیروی می‌کنیم."],[579,"این مگیر از فرع این از اصل گیر","بر کمان کم زن که از بازوست تیر","این را از فرع و جزئیات برداشت نکن؛ به اصل و ریشه توجه کن. بر کمان کم نزن و تیر را از بازو بکش، زیرا تیر فقط به وسیله بازو پرتاب می‌شود."],[579,"ما رمیت اذ رمیت ابتلاست","بر نبی کم نه گنه کان از خداست","تو در هنگام پرتاب تیر یا مواجهه با مشکلات، تنها ابزاری هستی که خداوند به‌وسیله تو عمل می‌کند و این آزمون توست، نه اینکه گناهی از جانب تو باشد که باید عذاب شوی. در واقع، نبی (پیامبر) هم به خواست خداوند و برای آزمودن مردم عمل می‌کند."],[579,"آب از سر تیره است ای خیره‌خشم","پیشتر بنگر یکی بگشای چشم","غضب و خشم تو اکنون به اندازه‌ای زیاد است که به نفع تو نیست. بهتر است که ابتدا با نگاهی عمیق‌تر و آگاهانه‌تر به اوضاع فکر کنی و حس خود را کنترل کنی."],[579,"شد ز خشم و غم درون بقعه‌ای","سوی شه بنوشت خشمین رقعه‌ای","از روی خشم و غم، نامه‌ای خشمگین به سوی پادشاه نوشت و به او ارسال کرد."],[579,"اندر آن رقعه ثنای شاه گفت","گوهر جود و سخای شاه سفت","در آن نوشته، به ستایش شاه پرداخته و آن‌طور که شایسته است، ارزش generosity و بخشش او را برجسته کرده است."],[579,"کای ز بحر و ابر افزون کف تو","در قضای حاجت حاجات‌جو","ای کسی که از دریا و ابر، دست تو سرازیر است و در برآورده شدن نیازها، دستت پربار و غنی است."],[579,"زانک ابر آنچ دهد گریان دهد","کف تو خندان پیاپی خوان نهد","ابر، آنچه را از باران می‌ریزد، به خاطر گریه و ناامیدی می‌دهد، اما دست تو که همیشه خندان است، به طور مداوم نعمت و روزی می‌آورد."],[579,"ظاهر رقعه اگر چه مدح بود","بوی خشم از مدح اثرها می‌نمود","اگرچه متن نامه (رقعه) ظاهرا در ستایش و مدح بود، اما بوی خشم از همان مدح به وضوح در آن حس می‌شد."],[579,"زان همه کار تو بی‌نورست و زشت","که تو دوری دور از نور سرشت","کار تو به خاطر دوری‌ات از نور حقیقت، بی‌فایده و زشت است. تو به علت ناآگاهی و فاصله از اصل خود، از نور و روشنی تهی هستی."],[579,"رونق کار خسان کاسد شود","هم‌چو میوه تازه زو فاسد شود","کار و فعالیت افراد پست و بی‌ارزش نیز منسجم و رونق می‌یابد، اما به‌زودی این رونق از بین می‌رود و مثل میوه تازه‌ای که فاسد می‌شود، ضایع می‌شود."],[579,"رونق دنیا برآرد زو کساد","زانک هست از عالم کون و فساد","رونق و رونق‌گیری دنیا به خاطر شخصی است که از کائنات و آلودگی‌های آن سرچشمه می‌گیرد، بنابراین به خاطر فساد و نقصان‌هایی که در جهان وجود دارد، دنیا کساد و بی‌فتوای می‌شود."],[579,"خوش نگردد از مدیحی سینه‌ها","چونک در مداح باشد کینه‌ها","مدح و ستایش در دل‌ها شادمانی ایجاد نمی‌کند، چون اگر در دل آدمی کینه و دشمنی باشد، هرچند که او به مدح می‌پردازد، اثر مثبتی نخواهد داشت."],[579,"ای دل از کین و کراهت پاک شو","وانگهان الحمد خوان چالاک شو","ای دل، از کینه و تنفر پاک شو و به سرعت و نشاط، به ستایش پروردگار بپرداز."],[579,"بر زبان الحمد و اکراه درون","از زبان تلبیس باشد یا فسون","اگر در ظاهر بگوییم «الحمد لله» ولی در باطن دلی پر از اکراه و کینه داشته باشیم، این گفتار ما در واقع نیرنگ یا فریب است."],[579,"وانگهان گفته خدا که ننگرم","من به ظاهر من به باطن ناظرم","خداوند می‌فرماید که من تنها به ظاهر انسان‌ها توجه نمی‌کنم، بلکه باطن و درون آن‌ها را می‌نگرم."],[580,"آن یکی با دلق آمد از عراق","باز پرسیدند یاران از فراق","مردی که با لباس دلق (لباس فقیران) از عراق آمد، یاران از او درباره فراق (فراق دوستان یا محبوب) پرسیدند."],[580,"گفت آری بد فراق الا سفر","بود بر من بس مبارک مژده‌ور","او می‌گوید که اگرچه درد فراق خوب نیست، اما سفر برای من بسیار خوشایند و مژده‌آور است."],[580,"که خلیفه داد ده خلعت مرا","که قرینش باد صد مدح و ثنا","خلیفه به من ده لباس (خلعت) داد و همراه آن صدجور مدح و ستایش برای من باشد."],[580,"شکرها و حمدها بر می‌شمرد","تا که شکر از حد و اندازه ببرد","او در حمد و ثنای ممدوح زیادی و زیاده‌روی کرد، به‌طوری که مدح‌هایش فراتر از واقعیت و اندازه شد."],[580,"پس بگفتندش که احوال نژند","بر دروغ تو گواهی می‌دهند","به او گفتند که حال و احوال غمگین و ناراحت تو نشان‌دهنده دروغ‌گویی‌ات است."],[580,"تن برهنه سر برهنه سوخته","شکر را دزدیده یا آموخته","آیا این شخص بی‌پوشش، ظاهرش نشان‌دهنده‌‍‌ی شکر و زیبایی است، یا او شکر را تنها دزدیده یا به طور مصنوعی یاد گرفته است؟"],[580,"کو نشان شکر و حمد میر تو","بر سر و بر پای بی توفیر تو","کجا است نشانه شکر و ستایش تو ای شاه، که بر سر و پای من نیست؟ تو بدون تأثیر و اثر خود، اینجا حضور نداری."],[580,"گر زبانت مدح آن شه می‌تند","هفت اندامت شکایت می‌کند","اگر زبان تو به مدح آن پادشاه مشغول است، هفت بخش بدنت از درون به ناراحتی و شکایت مشغول است."],[580,"در سخای آن شه و سلطان جود","مر ترا کفشی و شلواری نبود","در سخاوت آن شاه و سلطان بخشش، تو حتی کفش و شلوار مناسب هم نداری، به این معنا که تو هیچ چیزی برای نشان دادن سخاوت او نداری."],[580,"گفت من ایثار کردم آنچ داد","میر تقصیری نکرد از افتقاد","این شخص می‌گوید من از خودگذشتگی (ایثار) کردم و آنچه که میر، یعنی کسی با مقام بالا، در حق من نداد، من به دیگران بخشیدم. به عبارتی، او خود را فدای دیگران کرده و آنچه که نباید به او تعلق می‌گرفت، به دیگران داده است."],[580,"بستدم جمله عطاها از امیر","بخش کردم بر یتیم و بر فقیر","تمامی هدیه‌ها و بخشش‌هایی که از امیر گرفتم، را به یتیمان و فقیران بخشیدم."],[580,"مال دادم بستدم عمر دراز","در جزا زیرا که بودم پاک‌باز","من برای دیگران مال داده‌ام و عمر طولانی خود را در عوض آن گرفته‌ام، زیرا در دل بی‌نیاز و بخشنده بوده‌ام."],[580,"پس بگفتندش مبارک مال رفت","چیست اندر باطنت این دود نفت","به او گفتند: صرف‌نظر از اینکه مال را بخشیدی، در درون خود چه چیزی داری که شبیه دود نفت است و باعث برمی‌خیزد؟ این اشاره به دلایل ناپاکی و غم درون اوست."],[580,"صد کراهت در درون تو چو خار","کی بود انده نشان ابتشار","در درون تو، مانند خار، چیزهای ناخوشایند و کراهت‌آوری وجود دارد که نشان‌دهنده غم و حزن توست."],[580,"کو نشان عشق و ایثار و رضا","گر درستست آنچ گفتی ما مضی","کجاست نشان عشق و ایثار و رضایت؟ اگر واقعا آن چیزی که گفتی درست است، پس چرا این ویژگی‌ها در تو دیده نمی‌شود؟"],[580,"خود گرفتم مال گم شد میل کو","سیل اگر بگذشت جای سیل کو","من، خود را به چیزی مشغول کردم و ثروت و دارایی‌ام از بین رفت، همان‌طور که وقتی سیل می‌آید، دیگر اثری از مکان قبلی‌اش نمی‌ماند."],[580,"چشم تو گر بد سیاه و جان‌فزا","گر نماند او جان‌فزا ازرق چرا","اگر چشمان تو هم سیاه و زیبا باشد، ولی جان تو از روح و زندگی خالی و بی‌روح باشد، پس چرا در این صورت از زیبایی آن چشمان لذت ببریم؟"],[580,"کو نشان پاک‌بازی ای ترش","بوی لاف کژ همی‌آید خمش","ای کسی که بویی تلخ و ناخوش از تو می‌آید، نشانه‌ای از پاک‌بازی و صداقت در تو نیست و فقط دروغ و تظاهر را می‌توان در تو دید."],[580,"صد نشان باشد درون ایثار را","صد علامت هست نیکوکار را","در درون کسی که ایثار می‌کند، نشانه‌ها و نشانه‌های فراوانی از نیکوکاری وجود دارد که به خوبی مشخص است."],[580,"مال در ایثار اگر گردد تلف","در درون صد زندگی آید خلف","اگر در ایثار مال انسان به هدر رود، در عوض صد زندگی و برکت بیشتر به دست خواهد آورد."],[580,"در زمین حق زراعت کردنی","تخمهای پاک آنگه دخل نی","انسان باید در زمین حقیقت بذری از نیکی و صداقت بکارد تا در نهایت از آن نتیجه و بهره‌برداری مفید حاصل شود."],[580,"گر نروید خوشه از روضات هو","پس چه واسع باشد ارض الله بگو","اگر از باغ‌های بهشت، خوشه‌ای برنگردد، پس چرا زمین خدا چنین وسیع خواهد بود؟"],[580,"چونک این ارض فنا بی‌ریع نیست","چون بود ارض الله آن مستوسعیست","این زمین فانی بدون مال و ملک نیست، زیرا اگر زمین خدا وسیع است، پس دلیلی ندارد که این زمین را در دسترس نداشته باشد."],[580,"این زمین را ریع او خود بی‌حدست","دانه‌ای را کمترین خود هفصدست","این زمین (موجودات) در حقیقت، بدون حد و مرز است و از نظر خداوند، حتی کم‌ترین چیز (دانه‌ای) در آن، دارای ارزشی بیشمار و به اندازه هفتصد برابر است."],[580,"حمد گفتی کو نشان حامدون","نه برونت هست اثر نه اندرون","تو گفتی حمد و ستایش، ولی نشانه‌ای از حامدون (حمدکنندگان) در تو نیست؛ نه نشانه‌ای از آن‌ها در ظاهر وجود دارد و نه در باطن تو."],[580,"حمد عارف مر خدا را راستست","که گواه حمد او شد پا و دست","حمدی که عارف به خدا می‌کند، حقیقی و راستین است، چرا که پا و دست او گواهی بر این حمد هستند و نشان می‌دهند که وجودش در این حمد صداقت دارد."],[580,"از چه تاریک جسمش بر کشید","وز تک زندان دنیااش خرید","مداح به خاطر تاریکی و غم درونش که ناشی از دنیا و زندان مادی است، به ظاهر خود توجه کرده و برای پوشاندن آن، به تمجید و ستایش‌گری روی آورده است."],[580,"اطلس تقوی و نور مؤتلف","آیت حمدست او را بر کتف","او با تقوا و نوری چون پارچه اطلس، پرچم و نشانی از آیات حمد (سپاس) دارد که بر دوش (کتف) او است."],[580,"وا رهیده از جهان عاریه","ساکن گلزار و عین جاریه","او از دنیا و تعلقات آن آزاد شده و در جایی آرامش یافته است، مانند گلزار و چشمه‌ای که جاری است و به زندگی و طراوت ادامه می‌دهد."],[580,"بر سریر سر عالی‌همتش","مجلس و جا و مقام و رتبتش","او در بالاترین مرتبه و مقام نشسته است و جایگاه و منزلت او بسیار بلند و عالی است."],[580,"مقعد صدقی که صدیقان درو","جمله سر سبزند و شاد و تازه‌رو","جایگاه صدق و راستی که در آن، افراد راستین و درستکار قرار دارند، همه سرزنده، شاداب و جوان هستند."],[580,"حمدشان چون حمد گلشن از بهار","صد نشانی دارد و صد گیر و دار","ستایش آن‌ها مانند ستایش گلستان در بهار نشانه‌های زیادی دارد و جاذبه‌های فراوانی را به همراه دارد."],[580,"بر بهارش چشمه و نخل و گیاه","وآن گلستان و نگارستان گواه","بهار را با چشمه‌ها، نخل‌ها و گیاهانش و همچنین گلستان و نگارستانش به عنوان نشانه‌هایی برای شکوه و زیبایی یاد می‌کند."],[580,"شاهد شاهد هزاران هر طرف","در گواهی هم‌چو گوهر بر صدف","در این بیت، شاعر می‌گوید که در جهان، شاهدها و نشانه‌های بسیار زیادی وجود دارند که به غنای زیبایی و حقیقت می‌افزایند، مانند دانه‌های گوهر که در صدف می‌درخشند. این شاهدها نه‌تنها زیبایی را تأیید می‌کنند بلکه به موجب وجودشان، حقیقت هم درخشان‌تر می‌شود."],[580,"بوی سر بد بیاید از دمت","وز سر و رو تابد ای لافی غمت","اگر از تو بویی بد بیاید، نشان‌دهنده این است که مشکلی در وجود تو هست و خودت در حال نشان دادن درد و غم خود هستی، در حالی که فقط دروغ می‌گویی و تظاهر به خوشی می‌کنی."],[580,"بوشناسانند حاذق در مصاف","تو به جلدی های هو کم کن گزاف","بوی خوش را دانایان و اهل فن در گیرودار جنگ تو تشخیص می‌دهند، پس در صحبت و رفتار خود از افراط و زیاده‌گویی پرهیز کن."],[580,"تو ملاف از مشک کان بوی پیاز","از دم تو می‌کند مکشوف راز","تو به خاطر خوشبویی، مانند مشکی هستی که بوی پیاز از دهان تو به مشام می‌رسد؛ این بوی ناخوشایند از حقیقت درونت راز را فاش می‌کند."],[580,"گل‌شکر خوردم همی‌گویی و بوی","می‌زند از سیر که یافه مگوی","تو می‌گویی که شکر نوش جان کرده‌ام، اما بوهایی که از تو می‌آید نشان می‌دهد که تو از سیر (سبزی معطر که بوی مطبوعی ندارد) استفاده کرده‌ای؛ پس در ادعایت مبالغه نکن و آن را نگو."],[580,"هست دل ماننده خانه کلان","خانه دل را نهان همسایگان","دل انسان مانند یک خانه بزرگ است و رازهای درون آن برای همسایگان (دیگران) پنهان می‌ماند."],[580,"از شکاف روزن و دیوارها","مطلع گردند بر اسرار ما","از روزنه‌ها و درزهای دیوارها، دیگران از رازهای درون ما باخبر می‌شوند."],[580,"از شکافی که ندارد هیچ وهم","صاحب خانه و ندارد هیچ سهم","از شکافی که هیچ خیال و تصوری بر آن حاضر نیست و صاحب خانه هم از آن بهره‌ای ندارد، درمی‌یابیم که اسرار درون انسان‌ها نه تنها پنهان است بلکه درک آن برای دیگران غیرممکن است."],[580,"از نبی بر خوان که دیو و قوم او","می‌برند از حال انسی خفیه بو","از نبی (پیامبر) خبر و داستان بخوان که دیو (نیروهای شر) و پیروان او از وضعیت و حال انسی (انسان‌ها) خبر ندارند و از آنها دور هستند. این مصداقی است بر پنهان بودن برخی از حقایق و اوضاع از دیدگاه کسانی که در ظلمات و شر هستند."],[580,"از رهی که انس از آن آگاه نیست","زانک زین محسوس و زین اشباه نیست","انسان‌ها از مسیری به هم مرتبط می‌شوند که خودشان از آن خبر ندارند، زیرا این رابطه و هماهنگی در چیزهای محسوس و ظاهری نیست."],[580,"در میان ناقدان زرقی متن","با محک ای قلب دون لافی مزن","در میان ناقدان که ظاهر و باطن را می‌سنجند، ای دل فریبنده، دروغ و بهتان نزن و خود را بزرگ‌تر از آنچه هستی، نشان نده."],[580,"مر محک را ره بود در نقد و قلب","که خدایش کرد امیر جسم و قلب","محک یعنی معیار یا سنجش، در نقد و ارزیابی درست و نادرست. این معیار مسیر و راهی دارد که از طریق آن می‌توان به حقیقت دل و قلب پی برد، زیرا خدایی که جسم و قلب را به امیری رسانده، اصل و حقیقت را می‌داند."],[580,"چون شیاطین با غلیظیهای خویش","واقف‌اند از سر ما و فکر و کیش","شیاطین از طریق خصوصیات و رفتارهای خود، به خوبی از اندیشه‌ها و عقاید ما آگاه هستند."],[580,"مسلکی دارند دزدیده درون","ما ز دزدیهای ایشان سرنگون","شیاطین با رفتارهای پنهانی خود، عقیده‌ای بر ما دارند که باعث سقوط ما می‌شود و از دزدی‌های آنها به حال ما آسیب می‌رسد."],[580,"دم به دم خبط و زیانی می‌کنند","صاحب نقب و شکاف روزنند","آن‌ها هر لحظه خطا و ضرر می‌زنند و در دنیا به گمان خود در حال پیشرفت و نفوذ هستند."],[580,"پس چرا جان‌های روشن در جهان","بی‌خبر باشند از حال نهان","چرا جان‌های پاک و روشن در این جهان از وضعیت‌های پنهان و درونی خود بی‌خبرند؟"],[580,"در سرایت کمتر از دیوان شدند","روحها که خیمه بر گردون زدند","روح‌ها که بر گردون (آسمان) خیمه زده‌اند، از دیوان (دیوها) کمترند و در وجودشان شرارت و خباثت کمتری وجود دارد."],[580,"دیو دزدانه سوی گردون رود","از شهاب محرق او مطعون شود","دیو، به طرز پنهانی، به سوی آسمان می‌رود و از شهابی که او را می‌سوزاند، مورد نکوهش و سرزنش قرار می‌گیرد."],[580,"سرنگون از چرخ زیر افتد چنان","که شقی در جنگ از زخم سنان","کسی که از آسمان پایین می‌آید، مانند یک مرد شقی که در جنگ به خاطر زخم تیر (سنان) به زمین می‌افتد."],[580,"آن ز رشک روحهای دل‌پسند","از فلکشان سرنگون می‌افکنند","افرادی که روح و دل لطیفی دارند، به خاطر حسادت، این شخص را از مقام خود پایین می‌آورند و به او آسیب می‌زنند."],[580,"تو اگر شلی و لنگ و کور و کر","این گمان بر روحهای مه مبر","اگر تو دچار نقصی مانند لنگی، کوری یا کری هستی، نگذار که این ویژگی‌ها بر روح‌ها و افراد بافضیلت تأثیر منفی بگذارد."],[580,"شرم دار و لاف کم زن جان مکن","که بسی جاسوس هست آن سوی تن","شرم کن و از دروغ گفتن پرهیز کن؛ زیرا روح‌های باطنی و پنهانی در آن سوی ظاهر تو وجود دارند و آنها امور را می‌بینند."],[581,"این طبیبان بدن دانش‌ورند","بر سقام تو ز تو واقف‌ترند","این پزشکان الهی در زمینه معنوی و روحانی، از تو به بیماری‌ها و مشکلات تو آگاه‌تر هستند و از حال تو اطلاعات بیشتری دارند."],[581,"تا ز قاروره همی‌بینند حال","که ندانی تو از آن رو اعتلال","این افراد می‌توانند از حال تو پی ببرند، حتی اگر تو خودت از علت بیماری و مشکلاتت بی‌خبر باشی، زیرا مانند یک بطری (قاروره) که می‌توان از داخل آن دید، آن‌ها از چهره‌ات و نشانه‌های بیرونی‌ات حال تو را درمی‌یابند."],[581,"هم ز نبض و هم ز رنگ و هم ز دم","بو برند از تو بهر گونه سقم","از نبض و رنگ چهره و نفس تو می‌توانند حال و مشکلات هر نوع بیماری به‌ویژه بیماری‌های روحی و دینی‌ات را بفهمند."],[581,"پس طبیبان الهی در جهان","چون ندانند از تو بی‌گفت دهان","طبیبان الهی که نمی‌توانند از هر طریق و حرفی درباره‌ تو چیزی بفهمند، در واقع در دنیای حقیقی و معنوی ما ساکن هستند."],[581,"هم ز نبضت هم ز چشمت هم ز رنگ","صد سقم بینند در تو بی‌درنگ","طبیبان الهی به راحتی و به سرعت می‌توانند از طریق نبض، چشم و رنگ پوست تو، بیماری‌های روحی و دینی‌ات را تشخیص دهند."],[581,"این طبیبان نوآموزند خود","که بدین آیاتشان حاجت بود","این طبیبان که تازه‌کارند، برای فهم و تشخیص امراض دینی و روحی دیگران، به این نشانه‌ها و علائم (مانند نبض، چشم و رنگ) نیاز دارند تا بتوانند به درستی افراد را تحلیل کنند."],[581,"کاملان از دور نامت بشنوند","تا به قعر باد و بودت در دوند","کاملان (افراد آگاه و عارف) از دور نام تو را بشنوند و به عمق وجود و حال تو پی ببرند."],[581,"بلک پیش از زادن تو سالها","دیده باشندت ترا با حالها","چنانچه کاملان و عارفان پیش از اینکه تو به دنیا بیایی، سال‌ها تو را با حالات مختلف می‌شناختند و می‌دیدند."],[582,"آن شنیدی داستان بایزید","که ز حال بوالحسن پیشین چه دید","داستان بایزید را شنیده‌ای، که از حال بوالحسن خرقانی چه چیزهایی پیش‌بینی شده است؟"],[582,"روزی آن سلطان تقوی می‌گذشت","با مریدان جانب صحرا و دشت","روزی آن سلطان تقوی (بایزید بسطامی) به همراه مریدانش در حال عبور از صحرا و دشت بود."],[582,"بوی خوش آمد مر او را ناگهان","در سواد ری ز سوی خارقان","بوی خوش ناگهان به او رسید، در حالیکه در ری (سواد ری) بود و این بوی خوش از سوی خرقان (محل زندگی ابوالحسن خرقانی) می‌آمد."],[582,"هم بدانجا ناله مشتاق کرد","بوی را از باد استنشاق کرد","آن عاشق، به همانجا که بوی خوش به مشامش رسیده، ناله و زاری می‌کند و به وسیله باد، عطر را استشمام می‌کند."],[582,"بوی خوش را عاشقانه می‌کشید","جان او از باد باده می‌چشید","عاشق با علاقه بوی خوش را استنشاق می‌کند، در حالی که روح او از نسیم شراب لذت می‌برد."],[582,"کوزه‌ای کو از یخابه پر بود","چون عرق بر ظاهرش پیدا شود","کوزه‌ای که از آب یخ (سرد) پر شده، وقتی که عرق بر رویش ظاهر می‌شود."],[582,"آن ز سردی هوا آبی شدست","از درون کوزه نم بیرون نجست","این بیت می‌گوید که به سبب سردی هوا، آب موجود درون کوزه به صورت بخار از درون کوزه خارج نمی‌شود، یعنی بخار از آب نمی‌جوشد و بیرون نمی‌آید."],[582,"باد بوی‌آور مر او را آب گشت","آب هم او را شراب ناب گشت","باد، بوی خوش را برای او آورده و آن بوی خوش او را به حالت آب درآورده است و این آب هم به مانند شراب خالص و ناب شده است."],[582,"چون درو آثار مستی شد پدید","یک مرید او را از آن دم بر رسید","وقتی نشانه‌های سرمستی و شادی در او ظاهر شد، یک مرید او در همان لحظه به او نزدیک شد."],[582,"پس بپرسیدش که این احوال خوش","که برونست از حجاب پنج و شش","مرید از ابویزید سوال می‌کند که این حال خوشی که در تو ظاهر شده، ناشی از چیست و چرا از حجاب‌های مادی و ظاهری رهایی یافته‌است. حجاب پنج و شش اشاره به عالم مادی و وجود ظاهری دارد."],[582,"گاه سرخ و گاه زرد و گه سپید","می‌شود رویت چه حالست و نوید","چهره‌ات گاهی سرخ، گاهی زرد و گاهی سفید می‌شود؛ حال تو چیست و چه خبری برای ما داری؟"],[582,"می‌کشی بوی و به ظاهر نیست گل","بی‌شک از غیبست و از گلزار کل","بوی تو مانند گل است، هرچند که در ظاهر نیستی؛ به‌طور قطع این بو از عالم غیب می‌آید و تو از گلزار اصلی هستی."],[582,"ای تو کام جان هر خودکامه‌ای","هر دم از غیبت پیام و نامه‌ای","تو ای کس که جان هر خودکامه و قدرت‌مندی، هر لحظه از جایی نامشخص پیامی و خبری به تو می‌رسد."],[582,"هر دمی یعقوب‌وار از یوسفی","می‌رسد اندر مشام تو شفا","هر لحظه مانند یعقوب (پدر یوسف) بوی خوش یوسف (که مظهر جمال و شفا است) به مشام تو می‌رسد و این بو به تو آرامش و Healing می‌دهد."],[582,"قطره‌ای بر ریز بر ما زان سبو","شمه‌ای زان گلستان با ما بگو","به ما از آن سبویی که عطری از گلستان دارد، قدری بگو و ما را با آنچه که از آن سبو به ما می‌رسد، آشنا کن."],[582,"خو نداریم ای جمال مهتری","که لب ما خشک و تو تنها خوری","ما به تو و زیبایی تو عادت نداریم، ای بزرگوار، در حالی که ما دلمان تشنه است و فقط تو این نعمت را می‌چشی و بهره‌مند می‌شوی."],[582,"ای فلک‌پیمای چست چست‌خیز","زانچ خوردی جرعه‌ای بر ما بریز","ای ایستاده در آسمان، با حوصله و سرزنده، از آنجا که نوشیدی جرعه‌ای از آن nectar (نوشیدنی محبوب)، به ما هم بنوشان."],[582,"میر مجلس نیست در دوران دگر","جز تو ای شه در حریفان در نگر","در هیچ دوره‌ای کسی مانند تو ای پادشاه در جمع حریفان و میهمانان وجود ندارد؛ هیچ کس به عظمت و جایگاه تو نخواهد بود."],[582,"کی توان نوشید این می زیردست","می یقین مر مرد را رسواگرست","هیچ‌کس نمی‌تواند این شراب را بنوشد، زیرا این شراب باعث رسوایی مردان می‌شود و حقیقت را برملا می‌کند."],[582,"بوی را پوشیده و مکنون کند","چشم مست خویشتن را چون کند","چشم مست، یعنی چشمی که از مستی و سرمستی بی‌تحمل شده، می‌تواند بوی خوش را پنهان و در دل خود نگه‌دارد. در اینجا به نوعی اشاره می‌شود که احساسات و زیبایی‌های درونی ممکن است در نگاه و حالت فرد مست منعکس شود، اما در عین حال، آن را نمی‌توان به‌طور عینی دید و شناخت."],[582,"خود نه آن بویست این که اندر جهان","صد هزاران پرده‌اش دارد نهان","این بیت می‌گوید که آن حقیقت واقعی، خود بویی نیست که در دنیا وجود دارد، بلکه آنچه در جهان می‌بینیم، صدها پرده و حجاب دارد که آن حقیقت را پنهان کرده است."],[582,"پر شد از تیزی او صحرا و دشت","دشت چه کز نه فلک هم در گذشت","وجود او چنان پر از شدت و قاطعیت است که صحراها و دشت‌ها از آن پر شده‌اند؛ به‌طوری که حتی آسمان نیز یارای مقابله با او را نداشته و از دشت‌ها عبور کرده است."],[582,"این سر خم را به کهگل در مگیر","کین برهنه نیست خود پوشش‌پذیر","این سر خم (دستگاه زخم) را با گل (کهگل) نپوشان، زیرا این لکه (زخم) عریان و بی‌پوشش نیست و خودش قابل پوشاندن است."],[582,"لطف کن ای رازدان رازگو","آنچ بازت صید کردش بازگو","از تو خواهش می‌کنم، ای کسی که به اسرار آگاه هستی، آنچه را که در این راز شکار کرده‌ای، برای ما بازگو کن."],[582,"گفت بوی بوالعجب آمد به من","هم‌چنانک مر نبی را از یمن","یعنی بوی عطر و زیبایی بوالعجب (ابوالحسن خرقانی) به مشام من رسید، مانند بوی خوشی که پیامبر از یمن دریافت می‌کرد."],[582,"که محمد گفت بر دست صبا","از یمن می‌آیدم بوی خدا","محمد (پیامبر اسلام) گفت که بوی خداوند از یمن بر دست باد (صبا) به من می‌رسد."],[582,"بوی رامین می‌رسد از جان ویس","بوی یزدان می‌رسد هم از اویس","بوی عشق و محبت (رامین) از جان ویس می‌آید، همچنین بوی الهی و روحانی از اویس نیز به مشام می‌رسد."],[582,"از اویس و از قرن بوی عجب","مر نبی را مست کرد و پر طرب","بوی شگفت‌انگیز اویس و دوره‌اش باعث مستی و شوق پیامبر (ص) شد."],[582,"چون اویس از خویش فانی گشته بود","آن زمینی آسمانی گشته بود","وقتی اویس از خود گذشت و خود را فدای عشق خدا کرد، وجودش چنان دگرگون شد که همانند آسمان درخشان می‌گردید."],[582,"آن هلیله پروریده در شکر","چاشنی تلخیش نبود دگر","هلیله‌ای که در شکر پرورش یافته، دیگر تلخی ندارد و طعم تلخ آن برطرف شده است."],[582,"آن هلیله رسته از ما و منی","نقش دارد از هلیله طعم نی","هلیله‌ای که از خودخواهی و حب و منیت (خودپسندی) رهایی یافته، طعم و بوی هلیله‌ای دیگر را دارد که با آن مقایسه می‌شود. در واقع، این هلیله نماد معنای واقعی و خالصی است که در نتیجه‌ی رهایی از خودپرستی به دست می‌آید."],[582,"این سخن پایان ندارد باز گرد","تا چه گفت از وحی غیب آن شیرمرد","این سخن همچنان ادامه دارد، برگرد و ببین چه گفت آن مرد بزرگ (شیرمرد) از وحی غیبی."],[583,"گفت زین سو بوی یاری می‌رسد","کاندرین ده شهریاری می‌رسد","از این سو بوی یاری و کمک به گوش می‌رسد و به زودی در این ده (شهر) پادشاهی و سلطنتی خواهد آمد."],[583,"بعد چندین سال می‌زاید شهی","می‌زند بر آسمان‌ها خرگهی","پس از سال‌ها انتظار، رهبری بزرگ و شایسته به دنیا می‌آید که نشانه‌های عظمتش در آسمان‌ها نمایان می‌شود."],[583,"رویش از گلزار حق گلگون بود","از من او اندر مقام افزون بود","او (شخص) مانند گل‌های زیبا و خوش‌رنگ از گلزار حق (خدا) می‌روید و حالت او نشان‌دهنده‌ی مقام والایش است."],[583,"چیست نامش گفت نامش بوالحسن","حلیه‌اش وا گفت ز ابرو و ذقن","نام او بوالحسن است و زیبایی‌اش را از ابرو و چانه‌اش بیان کرده است."],[583,"قد او و رنگ او و شکل او","یک به یک واگفت از گیسو و رو","او (بوالحسن) را از نظر قد، رنگ و شکل به طور دقیق توصیف کرد، همچنین ویژگی‌های ظاهری‌اش از جمله مو و چهره‌اش را بیان کرد."],[583,"حلیه‌های روح او را هم نمود","از صفات و از طریقه و جا و بود","خصلت‌ها و ویژگی‌های روح الهی را نیز با صفات، روش، مکان و وجود او نشان داد."],[583,"حلیه تن هم‌چو تن عاریتی‌ست","دل بر آن کم نه که آن یک ساعتی‌ست","مظاهر و زینت‌های بدن نیز مانند خود بدن امانتی و عاریتی هستند، دل نباید به آن وابسته شود؛ چرا که بدن یک زمان معین دارد و زودگذر است."],[583,"حلیه روح طبیعی هم فنا‌ست","حلیه آن جان طلب کان بر سما‌ست","پوشش زندگی طبیعی هم زائل و فناپذیر است؛ اما پوششی که روح اصلی و واقعی در جستجوی آن است، در آسمان و در عالم بالا قرار دارد."],[583,"جسم او هم‌چون چراغی بر زمین","نور او بالای سقف هفتمین","جسم آن انسان همچون چراغی در روی زمین است، ولی نور او به عظمت و بلندی، در آسمان هفتم می‌درخشد."],[583,"آن شعاع آفتاب اندر وثاق","قرص او اندر چهارم چارطاق","شعاع آفتاب در درون گنبد (قرص) او محبوس و محدود است، و در فضای چهار طاقی (برجسته) او قرار دارد. این تصویر به نوعی از محدودیت و ظاهری بودن نور اشاره دارد."],[583,"نقش گل در زیر بینی بهر لاغ","بوی گل بر سقف و ایوان دماغ","نقش گل که زیر بینی قرار دارد، برای لاغر از بوی گل در سقف و ایوان به مشام می‌رسد. یعنی، بوی خوش گل به همان اندازه که در فضا حس می‌شود، برای افرادی که لاغر هستند، بیشتر احساس می‌شود."],[583,"مرد خفته در عدن دیده فرق","عکس آن بر جسم افتاده عرق","مردی که در بهشت عدن خوابیده، اثر آن را بر بدنش می‌بیند، به‌گونه‌ای که عرق روی او نشسته و نشان‌دهنده جلوه بهشتی‌اش است."],[583,"پیرهن در مصر رهن یک حریص","پر شده کنعان ز بوی آن قمیص","پیرهنی در مصر در دست کسی که به شدت چیزهای با ارزش را می‌خواهد، وجود دارد که سرشار از عطر و بوی خوش قمیص (پیرهنی از یوسف) و کنعان (سرزمین یعقوب) شده است."],[583,"بر نبشتند آن زمان تاریخ را","از کباب آراستند آن سیخ را","در آن زمان تاریخ ولادت را نوشتند و سیخی را که برای کباب آماده کرده بودند، تزیین کردند."],[583,"چون رسید آن وقت و آن تاریخ راست","زاده شد آن شاه و نرد ملک باخت","زمانی که آن تاریخ فرا رسید، شاه و برنده بازی ملک، به دنیا آمد."],[583,"از پس آن سال‌ها آمد پدید","بوالحسن بعد وفات بایزید","بعد از آن سال‌ها، بوالحسن ظهور کرد و به دنیا آمد، که این اتفاق پس از وفات بایزید (بایزید بسطامی، عارف بزرگ) رخ داد."],[583,"جمله خوهای او ز امساک و جود","آن‌چنان آمد که آن شه گفته بود","سخنان او (بوالحسن) درباره‌ی خودداری و generosity (بخشندگی) به‌گونه‌ای است که همان‌طور که آن پیامبر (صلی الله علیه و سلم) گفته بود، به وضوح نمایان شده است."],[583,"لوح محفوظ است او را پیشوا","از چه محفوظ است‌؟ محفوظ از خطا","لوح محفوظ به پیامبر اشاره دارد و نشان می‌دهد که او در مقام رهبری و هدایت، از هر گونه خطا و اشتباهی مصون و محفوظ است."],[583,"نه نجوم‌ست و نه رمل‌ست و نه خواب","وحی حق والله اعلم بالصواب","وحی الهی نه به علم ستاره‌شناسی (نجوم)، نه به علم جفر (رمل) و نه به خواب‌های تعبیر شده وابسته است و فقط خداوند است که به حقیقت و صحیح بودن آن آگاه است."],[583,"از پی روپوش عامه در بیان","وحی دل گویند آن را صوفیان","صوفیان می‌گویند که وحی دل، معمولا در لباس عامه بیان می‌شود، به این معنا که نشانه‌های معنوی و الهامات در قالبی ساده و قابل فهم برای عموم دیده می‌شوند."],[583,"وحی دل گیرش که منظرگاه اوست","چون خطا باشد‌؟ چو دل آگاه اوست","وحی دل، جایی که او (خدا) در آن قرار دارد، به خاطر خطا چگونه می‌تواند باشد؟ زیرا دل او آگاه و باخبر از همه چیز است."],[583,"مؤمنا ینظر به نور الله شدی","از خطا و سهو آمن آمدی","مؤمن از نور خداوند بهره‌مند می‌شود و به همین خاطر از خطا و اشتباه در امان است."],[584,"صوفیی از فقر چون در غم شود","عین فقرش دایه و مطعم شود","صوفی وقتی که در فقر و نداری به غم می‌افتد، همان فقر برای او به مانند دایه‌ای می‌شود که او را nourishes می‌کند و غذا می‌دهد."],[584,"زانک جنت از مکاره رسته است","رحم قسم عاجزی اشکسته است","زیرا بهشت از نیرنگ‌ها آزاد شده و احساس رحم از روی ناتوانی ضعفی را از خود نشان داده است."],[584,"آنک سرها بشکند او از علو","رحم حق و خلق ناید سوی او","او که به خاطر بزرگی و لطافت رحمت حق و خلق، سرها را می‌شکند (یعنی متواضع و خاشع می‌شود)، به سمت او (یعنی خدا) نمی‌آید."],[584,"این سخن آخر ندارد وان جوان","از کمی اجرای نان شد ناتوان","این سخن پایانی ندارد و آن جوان به دلیل کمبود نان و غذا ناتوان شده است."],[584,"شاد آن صوفی که رزقش کم شود","آن شبه‌ش در گردد و او یم شود","شبه سنگی است سیاه و کم‌ارزش"],[584,"زان جرای خاص هر که آگاه شد","او سزای قرب و اجری‌گاه شد","هر کسی که به راز و رمز خاص زندگی معنوی پی ببرد، به مقام قرب و پاداشی بزرگ دست می‌یابد."],[584,"زان جرای روح چون نقصان شود","جانش از نقصان آن لرزان شود","وقتی روحی که ویژگی خاصی دارد، در اثر کمبود و نقصان با کندی مواجه شود، جان آن شخص از این کمبود دچار نگرانی و لرز می‌شود."],[584,"پس بداند که خطایی رفته است","که سمن‌زار رضا آشفته است","بداند که اشتباهی انجام داده و به همین دلیل باغ رضایت خدا به هم ریخته است."],[584,"هم‌چنانک آن شخص از نقصان کشت","رقعه سوی صاحب خرمن نبشت","همان‌طور که آن شخص از کمبود محصول، نامه‌ای به صاحب مزرعه نوشت،"],[584,"رقعه‌اش بردند پیش میر داد","خواند او رقعه جوابی وا نداد","شخصی که نامه (رقعه)‌اش را نزد میر (رئیس یا داور) بردند، او نامه را خواند ولی هیچ پاسخی نداد."],[584,"گفت او را نیست الا درد لوت","پس جواب احمق اولی‌تر سکوت","او (میر) گفت که این فرد، جز درد و رنجی که ناشی از محبت لوت (پیامبری در تاریخ) باشد، چیزی ندارد؛ بنابراین، جواب احمق (شخصی که سواد و فهم ندارد) باید سکوت باشد و نباید چیزی بگوید."],[584,"نیستش درد فراق و وصل هیچ","بند فرعست او نجوید اصل هیچ","او (صوفی) نه از درد جدایی و نه از درد وصال رنج می‌برد و همه اینها مشکلی فرعی و کم‌اهمیت است. او در جست‌وجوی حقیقت و اصل وجود است و به مسائل سطحی نمی‌پردازد."],[584,"احمقست و مرده ما و منی","کز غم فرعش فراغ اصل نی","کسی که درگیر خود و منیتش است و از غم فرع‌های آن رنج می‌برد، واقعا احمق و مرده است؛ زیرا او از اصل وجود خود بی‌خبر است و تنها به مسائل جزئی توجه می‌کند."],[584,"آسمان‌ها و زمین یک سیب دان","که‌ز درخت قدرت حق شد عیان","آسمان و زمین را مانند یک سیب تصور کن که از درخت قدرت خداوند به‌وجود آمده و آشکار شده است."],[584,"تو چو کرمی در میان سیب در","وز درخت و باغبانی بی‌خبر","تو همانند کرمی هستی که درون سیب واقع شده، در حالی که درخت و باغبان از وجود تو بی‌خبرند."],[584,"آن یکی کرمی دگر در سیب هم","لیک جانش از برون صاحب‌علم","آن کرم دیگری نیز در سیب وجود دارد، اما روح و وجود او از بیرون علم و دانش است."],[584,"جنبش او وا شکافد سیب را","بر نتابد سیب آن آسیب را","حرکت او به مانند جنبشی است که سیب را می‌شکافد، اما سیب نمی‌تواند آن آسیب و صدمه را تحمل کند."],[584,"بر دریده جنبش او پرده‌ها","صورتش کرمست و معنی اژدها","جنبش او که پرده‌ها را دریده و آشکار کرده، باعث می‌شود که چهره‌اش به مانند کرم و معنایش به سان اژدها به نظر آید. این نشان‌دهنده‌ی تضاد بین ظاهری نرم و لطیف و واقعیتی خطرناک و بزرگ است."],[584,"آتشی که اول ز آهن می‌جهد","او قدم بس سست بیرون می‌نهد","آتش اولیه‌ای که از آهن به وجود می‌آید، نشان می‌دهد که او (صوفی) هنوز در قدم‌های اولیه‌اش ضعیف است و نمی‌تواند به خوبی پیش برود."],[584,"دایه‌اش پنبه‌ست اول لیک اخیر","می‌رساند شعله‌ها او تا اثیر","در ابتدا، دایه این شخص ننگ و ضعف داشته، اما در نهایت به او آگاهی و روشنایی می‌بخشد و شعله‌های آتش (نماد علم و حقیقت) را تا جهانی بالاتر (اثیر) می‌رساند."],[584,"مرد اول بسته خواب و خورست","آخر الامر از ملایک برترست","انسان در آغاز به خواب و خوراک وابسته است، اما در نهایت مقامش از فرشتگان بالاتر می‌رود."],[584,"در پناه پنبه و کبریتها","شعله و نورش برآید بر سها","شعله و نوری که از پنبه و کبریت به وجود می‌آید، در واقع نشان‌دهنده قدرت و تأثیری است که از چیزهای کوچک و ساده می‌تواند بر یک چیز بزرگ و روشن (مانند ستاره سها) بگذارد."],[584,"عالم تاریک روشن می‌کند","کنده آهن به سوزن می‌کند","کنده آهن که به وسیله سوزن (آتش) روشن می‌شود، می‌تواند دلالت بر این داشته باشد که چیزی به ظاهر خسته‌کننده و بی‌فایده، با روشنایی خود جهانی تاریک را روشن می‌کند. در واقع، این بیت به قدرت تغییر و ارتقاء انسان‌ها اشاره دارد که حتی از چیزهای کوچک و ناچیز می‌تواند نور و روشنی بیافریند."],[584,"گرچه آتش نیز هم جسمانی است","نه ز روحست و نه از روحانی است","هرچند آتش نیز یک موجود مادی و جسمانی است و نه از روح نشأت می‌گیرد و نه روحانی به شمار می‌رود، با این حال..."],[584,"جسم را نبود از آن عز بهره‌ای","جسم پیش بحر جان چون قطره‌ای","جسم از وجود عزت و ارزش خاصی برخوردار نیست و در مقایسه با دریای جان، همچون قطره‌ای در بحر است. به عبارت دیگر، جسم ارزشش را از جان می‌گیرد و در برابر آن ناچیز است."],[584,"جسم از جان روزافزون می‌شود","چون رود جان جسم بین چون می‌شود","جسم به واسطه جان رشد و تکامل پیدا می‌کند، همان‌طور که آب رود باعث حیات و رونق آن می‌شود. اگر جان در جسم نباشد، جسم چگونه می‌تواند به زندگی ادامه دهد؟"],[584,"حد جسمت یک دو گز خود بیش نیست","جان تو تا آسمان جولان‌کنیست","حد و مرز جسم تو تنها یک یا دو گز (متر) بیشتر نیست، اما جان تو می‌تواند تا آسمان پرواز کند و جولان بدهد."],[584,"تا به بغداد و سمرقند ای همام","روح را اندر تصور نیم گام","تا زمانی که روح تو در تصور و خیال بماند، نمی‌توانی به بغداد و سمرقند، دو شهر بزرگ و فرهنگ‌پرور، سفر کنی حتی به اندازه یک قدم."],[584,"دو درم سنگست پیه چشمتان","نور روحش تا عنان آسمان","نگاه شما به نور روح، مانند دو درم سنگینی است که به چشمانتان تعلق دارد و تا آسمان (یا حد و مرز بالایی) کشیده شده است. این تصویر به معنای محدودیت بصیرت و درک معنوی انسان اشاره دارد و بیان می‌کند که با وجود آن نور، بینش انسانی قادر به عبور از محدودیت‌های خود نیست."],[584,"نور بی این چشم می‌بیند به خواب","چشم بی‌این نور چه بود جز خراب","روح و نور الهی بدون نیاز به چشم مادی در خواب نیز قابل مشاهده است، اما چشم مادی بدون آن نور، جز نابودی و خرابی نتیجه‌ای ندارد."],[584,"جان ز ریش و سبلت تن فارغست","لیک تن بی‌جان بود مردار و پست","جان از ریش و سبیل و جسم جداست و در واقع مستقل و فراتر از تن است، اما تن بدون جان، مرده و پست به شمار می‌آید."],[584,"بارنامه روح حیوانیست این","پیشتر رو روح انسانی ببین","روح حیوانی نوعی روح است که در قالب نیازها و خواسته‌های مادی و دنیوی ظاهر می‌شود، اما باید به روح انسانی توجه کرد که فراتر از اینهاست و شامل جنبه‌های معنوی و والای انسان می‌شود."],[584,"بگذر از انسان هم و از قال و قیل","تا لب دریای جان جبرئیل","از حواشی و بحث‌های بی‌فایده انسانی بگذر و به عمق روح‌القدس (جبرئیل) توجه کن، زیرا او به حقیقت و معرفت نزدیک‌تر است."],[584,"بعد از آنت جان احمد لب گزد","جبرئیل از بیم تو واپس خزد","بعد از اینکه جان احمد (پیامبر اسلام) قبول کرد، جبرئیل (فرشته وحی) از ترس تو (خدا) به عقب برگشت و لب به دندان گزید."],[584,"گوید ار آیم به قدر یک کمان","من به سوی تو بسوزم در زمان","اگر من به اندازه یک تیر به سوی تو بیایم، در همان لحظه برای تو ذوب می‌شوم و می‌سوزم."],[585,"این بیابان خود ندارد پا و سر","بی‌جواب نامه خسته‌ست آن پسر","این بیابان، جایی که هیچ نشانی از زندگی و هدف نیست، نه پا دارد و نه سر، و پسر خسته و نگران از اینکه پاسخی به نامه‌اش داده نشده، به سر می‌برد."],[585,"کای عجب چونم نداد آن شه جواب","یا خیانت کرد رقعه‌بر ز تاب","عجب است که چرا آن شاه به نامه‌ام جواب نداد، آیا خیانت کرده و نامه‌ام را نادیده گرفته است؟"],[585,"رقعه پنهان کرد و ننمود آن به شاه","کو منافق بود و آبی زیر کاه","غلام پیام پنهانی را از پادشاه مخفی کرد و آن را نشان نداد، زیرا او فردی نادرست و فریبکار بود که در زیر ظاهر آرامش، نیرنگی در کار داشت."],[585,"رقعه دیگر نویسم ز آزمون","دیگری جویم رسول ذو فنون","در اینجا، گوینده تصمیم می‌گیرد نامه‌ای دیگر بنویسد و به دنبال پیام‌آوری با استعداد و ماهر در مهارت‌های مختلف (ذو فنون) باشد تا از اوضاع و احوال خود مطلع شود."],[585,"بر امیر و مطبخی و نامه‌بر","عیب بنهاده ز جهل آن بی‌خبر","در این بیت، شاعر به شخصی که از روی ناآگاهی و بی‌خبری عدم رسیدگی به نامه‌ها و مسئولیت‌هایش را به دیگران نسبت می‌دهد، اشاره می‌کند و عیب و نقص او را در این خصوص به امیر، آشپز و نامه‌بر می‌چسباند. یعنی او به جای اینکه ضعف خود را بپذیرد، تقصیر را بر گردن دیگران می‌اندازد."],[585,"هیچ گرد خود نمی‌گردد که من","کژروی کردم چو اندر دین شمن","هیچ کس به دور خود نمی‌چرخد و در خود را نمی‌بیند که من در دین شمن، راهی کج و نادرست رفته‌ام."],[586,"باد بر تخت سلیمان رفت کژ","پس سلیمان گفت بادا کژ مغژ","باد را بر تخت سلیمان کج می‌دید و سلیمان به باد گفت که چنین کج حرکت نکن و در این حالت نرمال حرکت کن."],[586,"باد هم گفت ای سیلمان کژ مرو","ور روی کژ از کژم خشمین مشو","باد به سلیمان می‌گوید: ای سلیمان، کج نرو؛ اگر به‌طور کج بروی، من هم از تو خشمگین نخواهم شد."],[586,"این ترازو بهر این بنهاد حق","تا رود انصاف ما را در سبق","این ترازویی که به این منظور قرار داده شده است توسط حق است تا انصاف ما را در مسابقه و رقابت حفظ کند."],[586,"از ترازو کم کنی من کم کنم","تا تو با من روشنی من روشنم","اگر تو از ترازو چیزی را کم کنی، من هم برای تو از خودم کم می‌کنم تا با من در روشنایی باشی؛ چون من خودم نور هستم."],[586,"هم‌چنین تاج سلیمان میل کرد","روز روشن را برو چون لیل کرد","در روز روشن، تاج سلیمان نیز مانند شب تمایل و انحراف پیدا کرد. این اشاره به ایستادگی سلیمان در برابر وسوسه‌ها و انحرافات دارد، حتی در شرایطی که همه چیز روشن و واضح است."],[586,"گفت تاجا کژ مشو بر فرق من","آفتابا کم مشو از شرق من","تاج سلیمان به او می‌گوید که بر سر من کج نشو و ای آفتاب، از سمت مشرق کم نکن، یعنی از قدرت و نور من کاسته نشود."],[586,"راست می‌کرد او به دست آن تاج را","باز کژ می‌شد برو تاج ای فتی","سلیمان (علیه‌السلام) تاج را به دست راست می‌کرد، ولی باز هم کج می‌شد. او به تاج می‌گوید: ای جوان، چرا کج می‌شوی؟"],[586,"هشت بارش راست کرد و گشت کژ","گفت تاجا چیست آخر کژ مغژ","سلطان سلیمان هشت بار تلاش کرد که تاجش را راست کند، اما هر بار به سمت کج می‌رفت. او با تعجب پرسید که چرا تاجش کج می‌شود و علت این مشکل را نمی‌فهمد."],[586,"گفت اگر صد ره کنی تو راست من","کژ شوم چون کژ روی ای مؤتمن","اگر تو صد بار هم بخواهی کارهایت را درست کنی، من به خاطر کژروی و انحراف تو، کژ و نادرست خواهم شد، ای امین و مورد اعتماد."],[586,"پس سلیمان اندرونه راست کرد","دل بر آن شهوت که بودش کرد سرد","سلیمان (پیامبر و پادشاه) در درون خود را درست کرد و به خاطر تمایلات و خواسته‌های نفسانی‌اش که او را به تزلزل انداخته بود، خنثی کرد."],[586,"بعد از آن تاجش همان دم راست شد","آنچنان که تاج را می‌خواست شد","سلیمان پس از آن که دلش را به شهوات سپرد، در همان لحظه تاجش دوباره به وضعیت درست و مناسبش درآمد، به طوری که سلیمان همان‌طور که می‌خواست، تاجش را به دست آورد."],[586,"بعد از آنش کژ همی کرد او به قصد","تاج او می‌گشت تارک‌جو به قصد","پس از آنکه تاج سلیمان بر سرش راست شد، او ادامه داد به‌طور کج حرکت کردن، در حالی که اراده‌اش به سمت تاج بود و به دنبال جلب توجه تاج بود."],[586,"هشت کرت کژ بکرد آن مهترش","راست می‌شد تاج بر فرق سرش","سلیمان، در حین سعی‌اش برای گرفتن تاج، به‌دلیل اشتباهش باعث شد که باد به شکلی نادرست وزیدن گیرد، اما در نهایت تاج بر سرش به‌درستی قرار گرفت."],[586,"تاج ناطق گشت کای شه ناز کن","چون فشاندی پر ز گل پرواز کن","تاج به شکل سخنگو درآمد و به سلطانی که ناز می‌کند می‌گوید که وقتی گل را زیبا می‌افشانی، به حال پرواز کردن بپرداز."],[586,"نیست دستوری کزین من بگذرم","پرده‌های غیب این برهم درم","من هیچ دستوری ندارم که از این حال بگذرم و پرده‌های پنهان را کنار بزنم."],[586,"بر دهانم نه تو دست خود ببند","مر دهانم را ز گفت ناپسند","سخن من را با سکوت و جلوگیری از بیان تفکرات ناپسند نپرچید، بلکه تنها بر من نیکی کن و مرا از گفتار زشت بازدار."],[586,"پس ترا هر غم که پیش آید ز درد","بر کسی تهمت منه بر خویش گرد","هر وقت غم و دردی به تو رسید، آن را به خودت نسبت نده و نگو که کار کسی دیگر است. به جای تهمت زدن به خود، سعی کن عیب‌ها و مشکلات خود را به درستی ببینی."],[586,"ظن مبر بر دیگری ای دوستکام","آن مکن که می‌سگالید آن غلام","ای دوست، درباره دیگران گمان بد نبر و نکن کاری که آن غلام (که به دنبال می‌گردد) انجام داده است."],[586,"گاه جنگش با رسول و مطبخی","گاه خشمش با شهنشاه سخی","برخی اوقات او (سلیمان) با پیامبرش (رسول) در حال جنگ است و در برخی دیگر، با شاه بخشنده (شهنشاه سخی) در خشم و غضب به سر می‌برد."],[586,"هم‌چو فرعونی که موسی هشته بود","طفلکان خلق را سر می‌ربود","چنان‌که فرعون، موسی (پیامبر خدا) را تهدید می‌کرد و کودکانی را از مردم می‌کشت، این شخص نیز بر کسی که حقش را ضایع کرده، سلطه و نفوذ دارد و به مردم آسیب می‌زند."],[586,"آن عدو در خانه آن کور دل","او شده اطفال را گردن گسل","دشمن در دل فردی که کور عقل است، مانند فرعون، بچه‌ها را به ناحق و بی‌رحمی از زندگی می‌گیرد و به آن‌ها آسیب می‌زند."],[586,"تو هم از بیرون بدی با دیگران","واندرون خوش گشته با نفس گران","تو در ظاهر با دیگران بدی می‌کنی، اما در درونت با نفس خودت خوشحالی و راحتی."],[586,"خود عدوت اوست قندش می‌دهی","وز برون تهمت به هر کس می‌نهی","دشمن تو خود شخصی است که به او محبت می‌کنی و به او قند هدیه می‌دهی، در حالی که از بیرون به دیگران تهمت می‌زنی و بر آن‌ها بدگویی می‌کنی."],[586,"هم‌چو فرعونی تو کور و کوردل","با عدو خوش بی‌گناهان را مذل","تو مثل فرعون، که نسبت به حقیقت نابیناست و دلش کوردل است، با دشمن خود خوب می‌جنس و نیکو رفتار می‌کنی، در حالی که بی‌گناهان را خوار و ذلیل می‌کنی."],[586,"چند فرعونا کشی بی‌جرم را","می‌نوازی مر تن پر غرم را","چند نفر از بی‌گناهانی که به خاطر خطای خود کشته شده‌اند را به صورت ظالمانه می‌کشید و به تن خود که پر از غم است، آرامش می‌دهی."],[586,"عقل او بر عقل شاهان می‌فزود","حکم حق بی‌عقل و کورش کرده بود","عقل سلیمان (علیه‌السلام) بر عقل شاهان افزوده بود و او به واسطه‌ی حکمی که بدون بهره‌گیری از عقل و بصیرت صحیح است، دچار زلت و خطا شده بود."],[586,"مهر حق بر چشم و بر گوش خرد","گر فلاطونست حیوانش کند","خداوند حق را بر دیدگان و شنیدگان عقل می‌نهد، و اگر عقل او به بلندی عقل فلاطون باشد، باز هم به واسطه‌ی نداشتن بصیرت، مانند یک حیوان خواهد بود."],[586,"حکم حق بر لوح می‌آید پدید","آنچنان که حکم غیب بایزید","حکم خدا بر دل و جان انسان‌ها برجسته می‌شود، مانند آنچه که حکم باطنی و الهی بر باطن بایزید هم که از عارفان بزرگ است، نمایان می‌شود."],[587,"هم‌چنان آمد که او فرموده بود","بوالحسن از مردمان آن را شنود","چنین اتفاقی رخ داد که ابوالحسن همان‌طور که گفته بود، از مردم آن خبر را شنید."],[587,"که حسن باشد مرید و امتم","درس گیرد هر صباح از تربتم","حسن، مرید من است و هر صبح از آموزش‌های من بهره‌برداری می‌کند."],[587,"گفت من هم نیز خوابش دیده‌ام","وز روان شیخ این بشنیده‌ام","گفت من هم خواب ابویزید را دیده‌ام و از روح شیخ این موضوع را شنیده‌ام."],[587,"هر صباحی رو نهادی سوی گور","ایستادی تا ضحی اندر حضور","هر روز به سمت قبر می‌روی و در آنجا ایستاده‌ای تا صبح هنگام در حضور خدای خویش حاضر شوی."],[587,"یا مثال شیخ پیشش آمدی","یا که بی‌گفتی شکالش حل شدی","شیخ، مانند پیشینیان خود، ایستاده بود و یا اگر بدون گفت‌وگو در پیشگاه او حاضر می‌شدی، همه‌ی مشکلات و شبهاتت برطرف می‌شد."],[587,"تا یکی روزی بیامد با سعود","گورها را برف نو پوشیده بود","یک روزی شخصی به نام سعود آمد و مشاهده کرد که گورستان‌ها زیر برف تازه‌ای پوشیده شده‌اند."],[587,"توی بر تو برف‌ها هم‌چون علم","قبّه قبّه دید و شد جانش به غم","برف‌هایی که بر روی تو نشسته، مانند علم (پرچم) بر روی قبه (ساختمانی گرد)، دیده می‌شود و این منظره باعث شد تا جانش دچار اندوه شود."],[587,"بانگش آمد از حظیره شیخ حیّ","ها انا ادعوک کی تسعی الیّ","آهای! من می‌خوانمت تا به سمتم بشتابی"],[587,"هین بیا این سو بر آوازم شتاب","عالم ار برفست روی از من متاب","بیایید اینجا و به صدای من گوش کنید، تا اگرچه جهان پر از برف و سردی است، شما از من دور نشوید."],[587,"حال او زان روز شد خوب و بدید","آن عجایب را که اوّل می‌شنید","از آن روز به بعد حال ابوزید خوب شد و شگفتی‌هایی را دید که قبلا فقط درباره‌شان شنیده بود."],[588,"نامه دیگر نوشت آن بدگمان","پر ز تشنیع و نفیر و پر فغان","آن بدگمان، نامه‌ای دیگر نوشت که پر از انتقاد و شکایت و ناله بود."],[588,"که یکی رقعه نبشتم پیش شه","ای عجب آنجا رسید و یافت ره","شگفتا که من یک نامه به پیش شاه نوشتم، و آن نامه به سرعت به مقصد رسید و راهش را یافت."],[588,"آن دگر را خواند هم آن خوب‌خد","هم نداد او را جواب و تن بزد","او (غلام) نامه دیگری را خواند، اما (شه هم) به او پاسخ نداد و بر بدن خود ضربه‌ای زد."],[588,"خشک می‌آورد او را شهریار","او مکرّر کرد رقعه پنج بار","شاه از آن غلام خواسته و او را به جای خود به محضر دعوت کرده است، اما با این حال، غلام نامه‌اش را پنج بار به درخواست شاه دوباره می‌نویسد."],[588,"گفت حاجب آخر او بنده شماست","گر جوابش بر نویسی هم رواست","حاجب به شهریار می‌گوید که این بنده (غلام) متعلق به شماست و اگر بخواهید به او پاسخ دهید، کار درستی است."],[588,"از شهی تو چه کم گردد اگر","برغلام و بنده اندازی نظر","اگر به یک بنده و غلام خود توجه کنی، چه چیز از مقام و بزرگی تو کم می‌شود؟"],[588,"گفت این سهلست اما احمقست","مرد احمق زشت و مردود حقست","او می‌گوید که این کار (نگاه کردن به غلام و بنده) آسان به نظر می‌رسد، اما مرد احمق و زشت حقیقت این موضوع را نمی‌فهمد، زیرا او خود دارای صفت‌های منفی است و از حق و حقیقت دور است."],[588,"گرچه آمرزم گناه و زلّتش","هم کند بر من سرایت علّتش","اگرچه من گناه و خطای او را ببخشیدم، اما اثر بدی‌های او به من منتقل می‌شود و بیماری او بر من تأثیر می‌گذارد."],[588,"صد کس از گرگین همه گرگین شوند","خاصه این گر خبیث ناپسند","هر کس که در جمعی بدی را از دیگری مشاهده کند، ممکن است تحت تأثیر آن قرار گیرد و به آن بدی مبتلا شود، به ویژه اگر آن فرد شخصی ناپسند و خبیث باشد."],[588,"گر کم عقلی مبادا گبر را","شوم او بی‌آب دارد ابر را","اگر کسی کم عقل باشد، در آن صورت فرد نادانی را مانند گبر (غیریهودی) بداند، زیرا ابر (محبت یا نعمت) در اثر شومی او خشک و بی آب می‌ماند."],[588,"نم نبارد ابر از شومی او","شهر شد ویرانه از بومی او","از شومی و بدی فردی، ابر باران نمی‌بارد و به همین دلیل شهر به ویرانی و خرابی می‌زند."],[588,"از گر آن احمقان طوفان نوح","کرد ویران عالمی را در فضوح","اگر آن نادانان مانند احمق‌ها طوفان نوح را برپا کنند، جهانی را در رسوایی و ویرانی به‌هم خواهند زد."],[588,"گفت پیغامبر که احمق هر که هست","او عدوّ ماست و غول ره‌زنست","پیامبر گفت هر کس احمق است، دشمن ماست و مانند غول، راهزن و خطرناک است."],[588,"هر که او عاقل بود از جان ماست","روح او و ریح او ریحان ماست","هر کسی که عاقل باشد در حقیقت از جان ماست، روحش و عطرش مانند بوی گل ریحان ماست."],[588,"عقل دشنامم دهد من راضیم","زانک فیضی دارد از فیاضیم","عقل به من دشنام می‌دهد و من از این موضوع راضی‌ام، زیرا این دشنام فیض و نعمت خوبی از جانب خداوند دارد."],[588,"نبود آن دشنام او بی‌فایده","نبود آن مهمانیش بی‌مایده","دشنام عقل به من بی‌فایده نیست و پذیرایی او هم بی‌مفهوم نیست، زیرا هر کدام از آن‌ها در حقیقت خاصیتی دارد."],[588,"احمق ار حلوا نهد اندر لبم","من از آن حلوای او اندر تبم","اگر احمقانه حلوا به من بدهد، من از آن حلوا حرارت و تب می‌گیرم."],[588,"این یقین دان گر لطیف و روشنی","نیست بوسه کون خر را چاشنی","این را بدان که اگر لطیف و روشنایی وجود نداشته باشد، بوسه خلف و ناپاک مانند بوسه خر، بی‌ارزش و بی‌فایده است."],[588,"سبلتت گنده کند بی‌فایده","جامه از دیگش سیه بی‌مایده","سبیل (سبلتت) تو بزرگ و بی‌فایده است و مانند جامه‌ای که از دیگ سیاه درآمده، بی‌مقدار و بی‌استفاده است."],[588,"مایده عقلست نی نان و شوی","نور عقلست ای پسر جان را غذی","غذای جان، عقل است نه نان و آب. ای پسر، نور عقل نیز زندگی‌بخش است."],[588,"نیست غیر نور آدم را خورش","از جز آن جان نیابد پرورش","غیر از نور الهی، هیچ چیز دیگری نمی‌تواند غذا و nourishment روح انسان باشد؛ انسان بدون این نور نمی‌تواند به رشد و پرورش حقیقی دست یابد."],[588,"زین خورش‌ها اندک اندک باز بر","کین غذای خر بود نه آن حر","از این خوراک‌ها که به تدریج می‌رسد، غذای ناشایست همچون غذای الاغ است و نه غذای بزرگواران."],[588,"تا غذای اصل را قابل شوی","لقمه‌های نور را آکل شوی","برای اینکه غذای اصلی و حقیقی را قابل هضم کنی، باید لقمه‌های نور را بخوری."],[588,"عکس آن نورست کین نان نان شدست","فیض آن جانست کین جان جان شدست","آنچه از نور هست، عکس و سایه‌اش در نان موجود است، زیرا نان به خاطر فیض و روشنایی جان موجود شده است. در حقیقت، جان به معنای واقعی‌اش، خود جان است."],[588,"چون خوری یکبار از ماکول نور","خاک ریزی بر سر نان و تنور","زمانی که یک بار از غذای نورانی ما بخوری، بر سر نان و تنور خاک می‌ریزی. این به معنای آن است که چون از فیض و نور الهی بهره‌مند شوی، دچار غفلت از دنیای مادی و ظواهر آن خواهی شد."],[588,"عقل دو عقلست اوّل مکسبی","که در آموزی چو در مکتب صبی","عقل دو نوع است: یکی عقل مکتبی که از یادگیری و آموزش به دست می‌آید، مانند دانش‌آموزی که در مکتب علم می‌آموزد."],[588,"از کتاب و اوستاد و فکر و ذکر","از معانی وز علوم خوب و بکر","عقل انسان با استفاده از کتاب، معلم، و تأمل در افکار و یادها، مفاهیم و علوم ارزشمند و تازه‌ای را به دست می‌آورد."],[588,"عقل تو افزون شود بر دیگران","لیک تو باشی ز حفظ آن گران","عقل و فهم تو از دیگران بیشتر می‌شود، ولی تو خودت در نگه‌داشتن آن دانش، سنگین و مسئول هستی."],[588,"لوح حافظ باشی اندر دور و گشت","لوح محفوظ اوست کو زین در گذشت","حافظه‌ات مثل لوح است که در زمان و جهان می‌چرخد، اما لوح محفوظ همان است که از این دور و گشت‌ها عبور کرده و فراتر رفته است."],[588,"عقل دیگر بخشش یزدان بود","چشمه آن در میان جان بود","عقل از بخشش و عطای خداوند است و ریشه آن در عمق وجود انسان قرار دارد."],[588,"چون ز سینه آب دانش جوش کرد","نه شود گنده نه دیرینه نه زرد","وقتی که آب دانش از دل انسان فوران می‌کند، نه کثیف می‌شود، نه کهنه می‌شود و نه رنگ می‌بازد."],[588,"ور ره نبعش بود بسته چه غم","کو همی‌جوشد ز خانه دم به دم","اگر مسیر اصلی و منبع دانش او مسدود باشد، مهم نیست؛ زیرا او همچنان از درون خود به‌طور مداوم و پیوسته آگاهی و علم می‌گیرد."],[588,"عقل تحصیلی مثال جویها","کان رود در خانه‌ای از کویها","عقل تحصیلی مانند جوی‌هایی است که به خانه‌ای از محله‌ها می‌روند. این بدان معناست که دانش و علم (عقل تحصیلی) برای به دست آوردن حقیقت و واقعیت به منابع و محیط‌های مختلف می‌رسد."],[588,"راه آبش بسته شد شد بی‌نوا","از درون خویشتن جو چشمه را","وقتی که راه آب بسته می‌شود و فرد دچار困라 و بی‌پناهی می‌شود، باید از عمق وجود خود، سرچشمه ای پیدا کند و به آن جوید."],[589,"مشورت می‌کرد شخصی با کسی","کز تردد وا رهد وز محبسی","شخصی با کسی مشورت می‌کرد که از آمد و رفت‌های بی‌فایده دوری می‌جست و از حالت زندانی بودن رهایی یافته بود."],[589,"گفت ای خوش‌نام غیر من بجو","ماجرای مشورت با او بگو","گفت: ای فرد معروف و نیکو، غیر از من، درباره ماجرای مشورت با آن شخص دیگر بگو."],[589,"من عدوم مر ترا با من مپیچ","نبود از رای عدو پیروز هیچ","من دشمن تو هستم، پس با من مشورت نکن. هیچ وقت از رای دشمن به نتیجه مثبتی نمی‌رسی."],[589,"رو کسی جو که ترا او هست دوست","دوست بهر دوست لاشک خیرجوست","کسی را پیدا کن که واقعا دوست توست، زیرا دوست به خاطر دوستی‌اش همیشه خیر و نیکی را برای تو می‌خواهد."],[589,"من عدوم چاره نبود کز منی","کژ روم با تو نمایم دشمنی","من از خودم عیب و ناتوانی دارم و بهتر است که با تو مخالفتی نکنم، چون این کار از من برنمی‌آید."],[589,"حارسی از گرگ جستن شرط نیست","جستن از غیر محل ناجستنیست","فرار کردن از یک گرگ (دشمنی بزرگ) کار آسانی نیست، اما فرار از غیر آن (دشمنان کوچکتر یا مشکلات دیگر) به هیچ وجه غیرممکن نیست."],[589,"من ترا بی‌هیچ شکی دشمنم","من ترا کی ره نمایم ره زنم","من به هیچ وجه در دوستی و محبت تو شکی ندارم و به صراحت می‌گویم که با تو دشمنم؛ بنابراین چرا باید راه را به تو نشان دهم یا به تو کمک کنم؟"],[589,"هر که باشد همنشین دوستان","هست در گلخن میان بوستان","هر کسی که با دوستان هم‌نشین باشد، در میان باغ، مانند گل‌های زیباست و در حال شکوفایی است."],[589,"هر که با دشمن نشیند در زمن","هست او در بوستان در گولخن","هر کسی که با دشمن بماند و دوست نباشد، مانند این است که در یک گلخن (محل تیره و تار) قرار دارد، حتی اگر در باغ (محیط خوش و دل‌انگیز) باشد."],[589,"دوست را مازار از ما و منت","تا نگردد دوست خصم و دشمنت","دوست را از خود آزار نرسان و از او منت و توقع نداشته باش، زیرا اگر چنین کنی، ممکن است دوستت به دشمن تبدیل شود."],[589,"خیر کن با خلق بهر ایزدت","یا برای راحت جان خودت","به نفع خودت یا به خاطر رضای خدا با دیگران مهربانی و خوبی کن."],[589,"تا هماره دوست بینی در نظر","در دلت ناید ز کین ناخوش صور","اگر می‌خواهی که همیشه دوست را در نظر داشته باشی، در دل خود نباید حس کینه و تنفر را به‌وجود بیاوری."],[589,"چونک کردی دشمنی پرهیز کن","مشورت با یار مهرانگیز کن","وقتی که با کسی دشمنی کردی، از او دوری کن و به دوست مهربان خود مشورت بکن."],[589,"گفت می‌دانم ترا ای بوالحسن","که توی دیرینه دشمن‌دار من","او، به بوالحسن (که یکی از دوستان و هم‌نشینانش است)، می‌گوید که او را به خوبی می‌شناسد و می‌داند که از دیرباز دشمن او بوده است."],[589,"لیک مرد عاقلی و معنوی","عقل تو نگذاردت که کژ روی","اما مرد عاقل و با بصیرت نمی‌گذارد که تو به کژی و انحراف بروی."],[589,"طبع خواهد تا کشد از خصم کین","عقل بر نفس است بند آهنین","طبیعت انسان تمایل دارد که از دشمن خود انتقام بگیرد، اما عقل مانع این کار است و همچون زنجیری آهنین، انسان را از خشم و کینه بازمی‌دارد."],[589,"آید و منعش کند وا داردش","عقل چون شحنه‌ست در نیک و بدش","عقل مانند یک نگهبان (شحنه) است که فرد را از انجام کارهای نادرست منع می‌کند و به او کمک می‌کند تا در مسائل خوب و بد تصمیم بگیرد."],[589,"عقل ایمانی چو شحنه عادلست","پاسبان و حاکم شهر دلست","عقل همانند یک شحنه عادل است که مراقب و نگهبان شهر دل است و ایمان هم مانند آن شحنه به وظیفه خود عمل می‌کند."],[589,"هم‌چو گربه باشد او بیدارهوش","دزد در سوراخ ماند هم‌چو موش","انسانی که باهوش و زیرک است، مثل گربه‌ای بیدار و آگاه، در کمین دزدی است که در سوراخی پنهان شده و هیچ جا نمی‌تواند برود. مانند موش، او به خاطر ترس از دزد نمی‌تواند از سوراخش خارج شود."],[589,"در هر آنجا که برآرد موش دست","نیست گربه یا که نقش گربه است","هرگاه که موش در جایی ظاهر شود، گربه حضور ندارد یا اینکه فقط تصویر گربه را مشاهده می‌کنیم. یعنی در هر مکانی که خطر و حسادت وجود داشته باشد، آن خطر و حسادت نیز غایب است یا تنها به صورت ظاهری خود را نشان می‌دهد."],[589,"گربه چه شیر شیرافکن بود","عقل ایمانی که اندر تن بود","عقلی که از ایمان سرچشمه می‌گیرد، نمی‌تواند به مانند گربه‌ای باشد که در برابر شیر به تهدید و دلهره بپردازد. این عقل باید قوی و مطمئن باشد و در برابر خطرات ایمانش را حفظ کند."],[589,"غره او حاکم درندگان","نعره او مانع چرندگان","غرور او حاکم بر درندگان، صدای او مانع حضور پرندگان است."],[589,"شهر پر دزدست و پر جامه‌کنی","خواه شحنه باش گو و خواه نی","شهر پر از دزدان و کسانی است که به سرقت می‌پردازند، پس تو یا باید شحنه (پلیس) باشی و از آنها جلوگیری کنی، یا اینکه از این وضعیت فاصله بگیری."],[590,"یک سریه می‌فرستادش رسول","بهر جنگ کافر و دفع فضول","پیامبر (رسول) او را برای جنگ با کافران و دفع مزاحمان، به گروهی از جنگجویان می‌فرستاد."],[590,"یک جوانی را گزید او از هذیل","میر لشکر کردش و سالار خیل","رسول خدا (ص) جوانی از قبیله هذیل را برگزید و او را فرمانده لشکر کرد و سردار گروه نظامی قرار داد."],[590,"اصل لشکر بی‌گمان سرور بود","قوم بی‌سرور تن بی‌سر بود","بدون شک، ریشه و اساس لشکر در وجود سرور و رهبر است؛ چرا که قوم و گروهی که سرور و رهبری ندارند، همچون جسمی بی‌روح و بی‌هویت هستند."],[590,"این همه که مرده و پژمرده‌ای","زان بود که ترک سرور کرده‌ای","این همه مردمان که افسرده و ناامیدند، به خاطر این است که از شادی و خوشحالی دوری کرده‌اند."],[590,"از کسل وز بخل وز ما و منی","می‌کشی سر خویش را سر می‌کنی","از حالتی که باعث کسالت و بخل شده، و از خودخواهی و «ما و من» خرج می‌کنی، باید خود را رها کنی و به بالندگی و اوج بپردازی."],[590,"هم‌چو استوری که بگریزد ز بار","او سر خود گیرد اندر کوهسار","شخصی مانند شکارچی که از سنگینی بار خود فرار می‌کند، سرش را در کوه‌ها بالا می‌برد و آن را برمی‌دارد."],[590,"صاحبش در پی دوان کای خیره سر","هر طرف گرگیست اندر قصد خر","هر طرفی که می‌روی و در حال دویدن هستی، گوسفند خرم تنها نیست، بلکه هر سو گرگ‌های قوی در کمین هستند تا به تو حمله کنند. اینجا به یک هشدار اشاره می‌شود که عدم توجه و غفلت می‌تواند باعث آسیب دیدن شود."],[590,"گر ز چشمم این زمان غایب شوی","پیشت آید هر طرف گرگ قوی","اگر این لحظه از دیدگانم دور شوی، در هر طرف گرگ‌های قوی بر تو خواهند آمد."],[590,"استخوانت را بخاید چون شکر","که نبینی زندگانی را دگر","بدن تو به قدری نازک و ضعیف می‌شود که مانند شکر به راحتی از هم می‌شکند و در آن صورت، دیگر زندگی را نخواهی دید."],[590,"آن مگیر آخر بمانی از علف","آتش از بی‌هیزمی گردد تلف","اگر به دنبال لذت‌های زودگذر و دنیوی باشی، در نهایت مثل علفی که در آتش می‌سوزد و به دلیل نداشتن هیزم از بین می‌رود، نابود می‌شوی و دیگر نمی‌توانی دوام بیاوری."],[590,"هین بمگریز از تصرف کردنم","وز گرانی بار که جانت منم","به خود بیا و از تلاش برای فریب دادن من خودداری کن، زیرا بار سنگین این کار بر دوش توست و جان تو تحت تأثیر من قرار دارد."],[590,"تو ستوری هم که نفست غالبست","حکم غالب را بود ای خودپرست","تو مانند اسبی هستی که نفس تو بر تو غلبه دارد و به همین خاطر، حکم غالب در تو نیز مانند کسی است که خود را پرستش می‌کند."],[590,"خر نخواندت اسپ خواندت ذوالجلال","اسپ تازی را عرب گوید تعال","تو را که خود را بزرگتر از آنچه هستی می‌دانی، در حقیقت چیزی بیشتر از الاغ نیستی، زیرا وقتی تو را می‌خوانند، دیگران تو را اسب با جلال می‌نامند. عرب‌ها هم به اسب پاک و تندرو، «تعال» یعنی بیا می‌گویند."],[590,"میر آخر بود حق را مصطفی","بهر استوران نفس پر جفا","در پایان کار، رسول خدا، که به حقیقت از جانب حق فرستاده شده است، برای نفس‌هایی که دچار سختی و ظلم هستند، رحمت و نجات می‌آورد."],[590,"قل تعالوا گفت از جذب کرم","تا ریاضتتان دهم من رایضم","پیامبر (رسول خدا) فرمود: بیایید، من شما را با محبت و مهربانی جذب می‌کنم تا به شما آموزش و تربیت دهم."],[590,"نفسها را تا مروض کرده‌ام","زین ستوران بس لگدها خورده‌ام","برای اصلاح و تربیت نفس‌ها، تا به حال از این مخلوقات (مثل ستوران) ضربه‌ها و آسیب‌های زیادی خورده‌ام."],[590,"هر کجا باشد ریاضت‌باره‌ای","از لگدهااش نباشد چاره‌ای","هر جا که در مسیر سختی و تمرین (ریاضت) افرادی باشند که سختی را تحمل کرده‌اند، از درد و مشکلات آن نمی‌توان فرار کرد."],[590,"لاجرم اغلب بلا بر انبیاست","که ریاضت دادن خامان بلاست","بنابر این حقیقت، بیشتر مشکلات و سختی‌ها بر انبیاء نازل می‌شود، زیرا تمرین و تربیت دادن افراد نادان و ناپخته، خود باعث وقوع بلا و سختی است."],[590,"سکسکانید از دمم یرغا روید","تا یواش و مرکب سلطان شوید","به وسیله دم من، زبانه آتش بیفتد و به آرامی تبدیل به مرکب سلطانی شوید. این اشاره به تربیت و تأثیرگذاری دارد که کسی می‌تواند از سوی پیامبر (رسول) بگیرد تا برتری یابد."],[590,"قل تعالوا قل تعالو گفت رب","ای ستوران رمیده از ادب","خدای تعالی می‌فرماید به پیامبر که بگو بیایید، ای سواران ترسیده که از ادب و نزاکت دور افتاده‌اید."],[590,"گر نیایند ای نبی غمگین مشو","زان دو بی‌تمکین تو پر از کین مشو","ای پیامبر، اگر آن‌ها نیایند، ناامید نشو؛ زیرا این دو گروه که در موردشان صحبت می‌کنی، از پشتیبانی و دلگرمی خالی‌اند و نباید به خاطر آنان حس کینه و دشمنی در دل تو جای گیرد."],[590,"گوش بعضی زین تعالواها کرست","هر ستوری را صطبلی دیگرست","برخی از افراد نسبت به دعوت‌های پیامبر بی‌تفاوت و نادان هستند و به نوعی ناشنوا به نظر می‌رسند. هر اسب (آدمی) نیز بر اساس ویژگی‌ها و قابلیت‌های خود، شرایط متفاوتی دارد."],[590,"منهزم گردند بعضی زین ندا","هست هر اسپی طویله او جدا","برخی از اسب‌ها به ندای راه و دعوت نمی‌رسند و هر اسبی در طویله‌اش قرار دارد، یعنی هر کس به شرایط و ظرفیت خود پاسخ می‌دهد."],[590,"منقبض گردند بعضی زین قصص","زانک هر مرغی جدا دارد قفس","برخی از مردم از این داستان‌ها (قصص) به تنگ آمده و دور می‌شوند، زیرا هر پرنده‌ای قفس خود را دارد و در نتیجه نمی‌تواند آزادانه پرواز کند."],[590,"خود ملایک نیز ناهمتا بدند","زین سبب بر آسمان صف صف شدند","ملائکه (فرشتگان) نیز با هم برابر و هم‌سطح نبودند و به همین خاطر بر آسمان به صورت صف‌صف (به طور منظم) قرار گرفتند."],[590,"کودکان گرچه به یک مکتب درند","در سبق هر یک ز یک بالاترند","کودکان هرچند در یک مدرسه و در یک سطح آموزشی هستند، اما در یادگیری و توانمندی‌هایشان هر کدام از دیگری برتری دارند."],[590,"مشرقی و مغربی را حسهاست","منصب دیدار حس چشم‌راست","انسان‌ها در سراسر شرق و غرب جهان، توانایی و استعداد دیدن و درک حقیقت را دارند، اما برای فهمیدن واقعیات عمیق‌تر، چشم و درک بصری ضروری است."],[590,"صد هزاران گوشها گر صف زنند","جمله محتاجان چشم روشن‌اند","اگرچه صد هزاران گوش وجود داشته باشد و در یک صف قرار بگیرند، اما همه آنها نیازمند چشم هستند تا روشنایی و حقیقت را ببینند، زیرا فقط گوش شنوا بودن کافی نیست و شناخت واقعی با دیدن میسر می‌شود."],[590,"باز صف گوشها را منصبی","در سماع جان و اخبار و نبی","گوش‌ها صف کشیده‌اند تا به مقام و جایگاه والایی در جریان سماع (موسیقی عرفانی) و دریافت اخبار و پیام‌های نبی (پیامبر) برسند."],[590,"صد هزاران چشم را آن راه نیست","هیچ چشمی از سماع آگاه نیست","هیچ‌کدام از چشم‌ها توانایی درک و فهم آن راه را ندارند؛ زیرا هیچ چشمی از واقعیات و پیغام‌های گوش و حالت‌های معنوی آگاه نیست."],[590,"هم‌چنین هر حس یک یک می‌شمر","هر یکی معزول از آن کار دگر","هر حس از حواس پنج‌گانه، به صورت جداگانه شمارش می‌شود و هر یک از آنها به طور مستقل از کار دیگر حواس عمل می‌کند."],[590,"پنج حس ظاهر و پنج اندرون","ده صف‌اند اندر قیام الصافون","پنج حس ظاهری و پنج حس باطنی، همگی در یک صف هستند و به عنوان صفوفی در کنار یکدیگر در قیام در خدمت دین عمل می‌کنند."],[590,"هر کسی کو از صف دین سرکشست","می‌رود سوی صفی کان واپسست","هر کسی که از صف دین (گروه دنبال‌کنندگان دین) دور شده و تخطی می‌کند، به سوی جمعیتی می‌رود که عقب‌نشینی کرده و از دین دور هستند."],[590,"تو ز گفتار تعالوا کم مکن","کیمیای بس شگرفست این سخن","تو از گفتن «بیایید» کم نکن، زیرا این سخن کیمیاگری بسیار بزرگ و ارزشمندی است."],[590,"گر مسی گردد ز گفتارت نفیر","کیمیا را هیچ از وی وا مگیر","اگر این جوان از سخن تو به طلا تبدیل شود، هیچ ارزش کیمیا را از او دریغ نکن."],[590,"این زمان گر بست نفس ساحرش","گفت تو سودش کند در آخرش","اگر نفس انسان با سحر و جادوی خود مشغول شود و به کارهای ناپسند و فریبنده بپردازد، در پایان برای او سودی نخواهد داشت و به ضرر او تمام خواهد شد."],[590,"قل تعالوا قل تعالوا ای غلام","هین که ان الله یدعوا للسلام","بگو بیایید، بگو بیایید ای پسر، چون خداوند شما را به صلح دعوت می‌کند."],[590,"خواجه باز آ از منی و از سری","سروری جو کم طلب کن سروری","ای خواجه، از رویا و خیال خواهش‌های خود بازگرد و به فکر بی‌نیازی و سروری باش، چرا که طلب کردن زیاد سروری خوب نیست."],[591,"چون پیمبر سروری کرد از هذیل","از برای لشکر منصور خیل","وقتی پیامبر اکرم (ص) بر هذیل (یک قبیله) فرمانروایی کرد تا لشکر منصور (امیر مؤمنان) را تقویت کند."],[591,"بوالفضولی از حسد طاقت نداشت","اعتراض و لانسلم بر فراشت","بوالفضل، به خاطر حسد، نتوانست تحمل کند و از روی تعصب، بر رسول خدا اعتراض کرد."],[591,"خلق را بنگر که چون ظلمانی‌اند","در متاع فانیی چون فانی‌اند","بنگر به مردم که چگونه در تاریکی هستند و در چیزهای فانی و گذرا غرق شده‌اند، چرا که خودشان نیز در زوال و فانی بودن هستند."],[591,"از تکبر جمله اندر تفرقه","مرده از جان زنده‌اند از مخرقه","همه به دلیل تکبر و خودپسندی خود به تفرقه و جدایی افتاده‌اند، در حالی که از حقیقت وجود زنده‌اند و گویی در ظاهر به خواب رفته‌اند."],[591,"این عجب که جان به زندان اندرست","وانگهی مفتاح زندانش به دست","عجب است که روح در قید و بند گرفتار است، اما کلید این زندان یعنی راه رهایی را در دست دارد."],[591,"پای تا سر غرق سرگین آن جوان","می‌زند بر دامنش جوی روان","این جوان تمام وجودش در آلودگی و گناه فرورفته است و در حالی که تمام تلاشش را می‌کند، در جوی آب، تلاش می‌کند تا خود را از این آلودگی‌ها پاک کند."],[591,"دایما پهلو به پهلو بی‌قرار","پهلوی آرامگاه و پشت‌دار","شخص در حال دل‌نگرانی و اضطراب است، به‌گونه‌ای که مکررا به یک سمت و سمت دیگر می‌چرخد و آرامش ندارد، در حالی که در کنار آرامگاه و جایگاه کسی ایستاده است."],[591,"نور پنهانست و جست و جو گواه","کز گزافه دل نمی‌جوید پناه","نور حقیقت در پس پرده‌ای نهفته است و فقط کسانی که به دنبال آن هستند می‌توانند نشانه‌هایی از آن را بیابند؛ چرا که دل‌هایشان به طور بی‌مورد و تصادفی به دنبال پناهگاهی نمی‌گردد."],[591,"گر نبودی حبس دنیا را مناص","نه بدی وحشت نه دل جستی خلاص","اگر زندانی دنیا نبود و خروجی برای آن وجود نداشت، نه ترس و وحشت حس می‌شد و نه دل به دنبال رهایی می‌گشت."],[591,"وحشتت هم‌چون موکل می‌کشد","که بجو ای ضال منهاج رشد","وحشت تو مانند نگهبانی تو را در فشار می‌آورد و می‌گوید که برو و راه درست را پیدا کن ای کسی که به گمراهی رفته‌ای."],[591,"هست منهاج و نهان در مکمنست","یافتش رهن گزافه جستنست","راه رشد و هدایت وجود دارد و در جای پنهانی نهفته است. پیدا کردن آن نیاز به تلاش و کوشش بیهوده ندارد."],[591,"تفرقه‌جویان جمع اندر کمین","تو درین طالب رخ مطلوب بین","تفرقه‌افکنان در کمین هستند تا از میان تو را منفصل کنند، اما در این میان، تو به دنبال دیدن و پیدا کردن چهره مطلوب و یکتای خود باش."],[591,"مردگان باغ برجسته ز بن","کان دهنده زندگی را فهم کن","افراد مرده در باغی که با شکوه است، از عمق وجود خود درک کن که چه کسی زندگی را به آنها بخشیده است."],[591,"چشم این زندانیان هر دم به در","کی بدی گر نیستی کس مژده‌ور","چشم این زندانیان به در است و هر لحظه منتظر خبری هستند؛ اگر تو نبودی، هیچ کس به آنها مژده نمی‌دهد."],[591,"صد هزار آلودگان آب‌جو","کی بدندی گر نبودی آب جو","اگر آب جو (آب جو، نوعی نوشیدنی است) وجود نداشت، صد هزار آلودگان (افراد گناهکار و آلوده) نمی‌توانستند از آن بهره‌مند شوند یا در آن غوطه‌ور شوند. این آیه به نوعی به اهمیت وجود تجربیات و امکانات در بروز وضعیت‌های مختلف اشاره دارد."],[591,"بر زمین پهلوت را آرام نیست","دان که در خانه لحاف و بستریست","زمین پهلوت (پهلوی) آرام و ساکت نیست، زیرا درون خانه‌اش لحاف و بستر وجود دارد که نشانه‌ای از ناآرامی و دل‌مشغولی در دل آن است."],[591,"بی‌مقرگاهی نباشد بی‌قرار","بی‌خمار اشکن نباشد این خمار","کسی که بدون قرار و آرامش است، نمی‌تواند حالت مستی و سرخوشی را تجربه کند. آرامش و ثبات لازم است تا انسانی بتواند به حالت سرمستی و خوشحالی دست یابد."],[591,"گفت نه نه یا رسول الله مکن","سرور لشکر مگر شیخ کهن","معترض می‌گوید: ای رسول خدا، فرمانده سپاه را تنها کسی باید تعیین کند که سالخورده و باتجربه باشد، نه جوانی که هنوز ناپخته است."],[591,"یا رسول الله جوان ار شیرزاد","غیر مرد پیر سر لشکر مباد","ای پیامبر خدا، جوانی که از دل شیر به دنیا آمده، اگر غیر از یک مرد پیر فرمانده لشکر باشد، نباید سر پرچم لشکر قرار گیرد."],[591,"هم تو گفتستی و گفت تو گوا","پیر باید پیر باید پیشوا","تو هم گفتی که برای رهبری، لازم است که شخص با تجربه و سالخورده باشد، پس خودت هم باید به این نکته توجه کنی که پیشوای لشکر باید پیر و باتجربه باشد."],[591,"یا رسول‌الله درین لشکر نگر","هست چندین پیر و از وی پیشتر","ای پیامبر خدا، در این گروه نظامی به این موضوع توجه کن که در میان آنها تعداد زیادی پیرمرد وجود دارد که از خود آنها بزرگ‌تر و کهن‌تر هستند."],[591,"زین درخت آن برگ زردش را مبین","سیبهای پخته او را بچین","به جای این‌که به برگ‌های زرد این درخت (که نشانه ضعف و ناکامی است) توجه کنی، میوه‌های آماده و پخته‌اش (که نشان‌دهنده موفقیت و کمال است) را درآورد."],[591,"برگهای زرد او خود کی تهیست","این نشان پختگی و کاملیست","برگ‌های زرد این درخت نشان‌دهنده‌ی نداشتن چیزی نیست؛ بلکه این نشانه‌ی پختگی و کمال اوست."],[591,"برگ زرد ریش و آن موی سپید","بهر عقل پخته می‌آرد نوید","برگ زرد و ریش سفید به نشانه تجربه و پختگی عقل هستند که خبر از رسیدن به کمال و دانش می‌دهند."],[591,"برگهای نو رسیده سبزفام","شد نشان آنک آن میوه‌ست خام","برگ‌های تازه و سبز نشان‌دهنده این است که آن میوه هنوز نارس و خام است."],[591,"برگ بی‌برگی نشان عارفیست","زردی زر سرخ رویی صارفیست","برگ بدون میوه، نشان‌دهنده حالتی از عارف است که احساس دلتنگی و فقدان دارد. زردی هم همچنان نشانی از وضعیت ناخرسند و رنگ باختن روح است که به عدم و خالی شدن از برکات و لطافت‌ها اشاره می‌کند، در حالی که روی سرخ، نشانه تجلی و درخشش روحی است که در مقام طلا (زر) است."],[591,"آنک او گل عارضست ار نو خطست","او به مکتب گاه مخبر نوخطست","آن کسی که چهره‌اش به مانند گل زیباست، اگر خطش نو و تازه باشد، در محل آموزش کسی است که فقط خبر از خط نو دارد."],[591,"حرفهای خط او کژمژ بود","مزمن عقلست اگر تن می‌دود","حرف‌های نوشته شده او نامفهوم و نادرست است، زیرا اگر جسم او در حرکت باشد، عقلش به تأخیر افتاده و دچار ضعف است."],[591,"پای پیر از سرعت ار چه باز ماند","یافت عقل او دو پر بر اوج راند","هرچند پای پیر به خاطر سرعت یا شاید سن و سالش بر-ground دوباره باز بماند، اما عقل او به قدری پرتوان و قوی است که او را به اوج می‌برد."],[591,"گر مثل خواهی به جعفر در نگر","داد حق بر جای دست و پاش پر","اگر می‌خواهی مانند جعفر بنگری، باید بدان که حق به طور کامل بر دستان و پاهای او قرار گرفته است. جعفر، که معمولا به عنوان کسی با شعور و فهم عالی شناخته می‌شود، نماینده‌ای از رشد و کمال انسان به شمار می‌رود."],[591,"بگذر از زر کین سخت شد محتجب","هم‌چو سیماب این دلم شد مضطرب","از عشق و محبت دوری بکن، زیرا کینه و طمع به دل گرفته و آن را همچون جیوه ناآرام و مضطرب کرده است."],[591,"ز اندرونم صدخموش خوش‌نفس","دست بر لب می‌زند یعنی که بس","مولانا در مثنوی بر خلاف غزل‌هایش که در حال سماع احوالات و واردات غیبی را هرچه به او از جانب حضرت حق افاضه می‌شده‌است را بی پرده بیان می‌دارد اما در مثنوی چون در نقش یک معلمی است که در حال آموزش و ارشاد طالبان معارف الهیه‌اند و در جایگاهی است که وقتی آن احوالات به او دست می‌دهد باید در عین مستی مراعات ادب کند و رعایت جایکاه خود را بکند، اما وقتی که بیش از اندازه در بحر الهی مستغرق می‌شود و از جانب حضرت حق سبحانه اسرار الهی به او افاضه می‌شود و او نیز آنها را تبدیل به شعر می‌کند بی آنکه مانند دیگر شاعران در بند چیدن قافیه و اینگونه موارد باشد، به قول خودش «خون چو می‌جوشد منش از شعر رنگی می‌زنم» اما به یکباره با خود آمده و با هاتفی یا آن موجودی که نمیدانیم چیست ولی او را تلقین شعر می‌کند به او اختار میدهد که بر سر آرام و قرار آید و ای بسا که این عین ترجربه عا فانه شخص مولانا باشد که در دونش عده‌ای هستند که آنموقع انگشت بر لب می‌نهند یعنی که کافیست و بیش از این اندازه ماذون به گفتن این مطالب نیست که اینها دیگر اسرار الهی است که نباید آن را در اختیار هرکسی قرار داد و چون مثنوی کتابی بود که قرار بود در اختیار عموم مردم قرار گیرد، به او هشدار میدادند که مولانا از این ها به طرق و اشکال مختلف یاد می‌کند و در این صد خموش خوش نفس هستند و در جایی با یک نفر شخص خاص است و خلاصه به حدی در گفتار پیش رفته که دیگر نمی‌بایست از آن بیشتر قدمی بر میداشت و در ادامه هم تاکید میکند که از روی ادب باید اوامر آنها هم که از کارگزاران حضرت حق تعالی هستند اطاعت کند و دیگر دم نزند"],[591,"خامشی بحرست و گفتن هم‌چو جو","بحر می‌جوید ترا جو را مجو","خاموشی دریا مانند دریاست و حرف‌زدن مانند جوی است که نمی‌تواند به دریا برسد؛ بنابراین، به دنبال جوی که به دریا نمی‌رسد نرو."],[591,"از اشارتهای دریا سر متاب","ختم کن والله اعلم بالصواب","از نشانه‌های دریا (عشق و معرفت) روی بر نتاب، یعنی نباید از آن‌ها دور شد. در پایان، خداوند نسبت به حقیقت و درست بودن آنها آگاه‌تر است."],[591,"هم‌چنین پیوسته کرد آن بی‌ادب","پیش پیغامبر سخن زان سرد لب","این شخص بی‌ادب به طور مکرر پیش پیامبر سخنانی را بر زبان می‌آورد که از روی نادانی و سردی احساساتش است."],[591,"دست می‌دادش سخن او بی‌خبر","که خبر هرزه بود پیش نظر","او (بی‌ادب) بدون اینکه خبرش بی‌معنی و بی‌ارزش باشد، به حرف‌های پیغامبر گوش نمی‌داد و فقط به سخنان او که از نظرش بی‌اعتبار بود، واکنش نشان می‌داد."],[591,"این خبرها از نظر خود نایبست","بهر حاضر نیست بهر غایبست","این اخبار از نظر خود آدمی، در واقع نماینده او نیست و برای کسانی که حاضرند نیست، بلکه برای غایبان کاربرد دارد."],[591,"هر که او اندر نظر موصول شد","این خبرها پیش او معزول شد","هر کس که در نظر به معشوق متصل شد، دیگر برای او این خبرها و اطلاعات بی‌فایده و غیرمفید می‌شود."],[591,"چونک با معشوق گشتی همنشین","دفع کن دلالگان را بعد ازین","وقتی که با معشوق خود همراه و یکی می‌شوی، دیگر نیازی به واسطه‌ها و پیام‌آوران عشق نداری و باید آن‌ها را کنار بگذاری."],[591,"هر که از طفلی گذشت و مرد شد","نامه و دلاله بر وی سرد شد","هر کسی که از دوره کودکی عبور کرده و به سن بزرگسالی رسیده است، دیگر نیازی به واسطه‌ها و دلال‌ها برای رسیدن به مقاصدش ندارد و در واقع، پیام و راهنمایی‌ها برای او بی‌فایده و سرد شده است."],[591,"نامه خواند از پی تعلیم را","حرف گوید از پی تفهیم را","کسی که از آموزش و یادگیری بهره‌مند شده باشد، می‌تواند پس از خواندن مطالب، سخنانی بگوید که نشان‌دهنده فهم و درک او باشد."],[591,"پیش بینایان خبر گفتن خطاست","کان دلیل غفلت و نقصان ماست","حرف زدن در جمع افرادی که بصیرت و دانش دارند، نادرست است زیرا نشان‌دهنده بی‌اطلاعی و نقص ماست."],[591,"پیش بینا شد خموشی نفع تو","بهر این آمد خطاب انصتوا","سکوت و خاموشی برای تو فایده دارد، زیرا به تو گفته شده است که آرام باش و گوش کن."],[591,"گر بفرماید بگو بر گوی خوش","لیک اندک گو دراز اندر مکش","اگر رسول خدا بفرماید که بگو با شیرینی و نیکویی، باید به او بگویی، اما نباید زیاده‌گویی کنی و حرف‌های طولانی نزنی."],[591,"ور بفرماید که اندر کش دراز","هم‌چنان شرمین بگو با امر ساز","اگر او (پیامبر) فرمان دهد که مدتی بیشتر سخن بگو، تو همچنان شرمگین باش و به خواسته‌اش عمل کن."],[591,"همچنین که من درین زیبا فسون","با ضیاء الحق حسام‌الدین کنون","همچنان‌که من در این جادو و زیبایی (فسون) با نور حق و چهره درخشان حسام‌الدین (که به معنای حمایت و یاری است) اکنون هستم."],[591,"چونک کوته می‌کنم من از رشد","او به صد نوعم بگفتن می‌کشد","با توجه به ابیات پیشین که مولانا چون مستغرق در احوال الهی خویش است احساس میکند که از درون به او الهام می‌شود که در حال افشای اسراری که باید زبان در کام کشد و از گفتن پرهیز کند، اما گویا حسام الدین که مخاطب اصلی مثنوی است ازو میخواهد که آن سخن‌ها را ادامه دهد و در این بیت گوید که من هرچه تلاش میکنم تا دست از سخن گفتن بکشم او که مراد حسام الدین است با صد نو خواهش تمنای آن دارد که من به گفتن ادامه دهم"],[591,"ای حسام‌الدین ضیاء ذوالجلال","چونک می‌بینی چه می‌جویی مقال","در اینجا وقتی اصرار حسام الدین را در پیگیری موضوع می‌بیند خطاب به او گوید، ای حسام الدین که تو پرتو نوری از جانب خداوند هستی، با وجود اینکه میدانی چرا من باید از گفتن باز ایستم و دلیلش خاموش شدنم را میدانی پس چرا اصرار می‌ورزی که من ادامه بدهم؟"],[591,"این مگر باشد ز حبّ مشتهی","اسقنی خمرا و قل لی انّها","در این بیت اشاره‌ای به داستانی دارد و آن درباره یکی از ابیات خمریه ابونواس شاعر مشهور عرب در دوره عباسی دارد که آن بیت چنین است که : «الا فاسقنی خمرا و قل لی هی الخمر / ولا تسقنی سرا اذا امکن الجهر» که معنی آن می‌شود : هان ای ساقی به من شراب یده و بگو این شراب است و چون امکان آن وجود دارد که آشکارا مرا شراب دهی پس پنهانی این کار را نکن» گویند روزی او در کوی و برزن دید دو کودک مشغول مشاعره هستند و یکی از آنها این شعر او را میخواند و آن دیگری از او می‌پرسد، وقتی ابونواس به ساقی می‌گوید مرا شرابی ده پس چرا در ادامه می‌گوید و به من بگو که آین شراب است؟ آن پسر در پاسخ گوید: در اینجا همه حواس با شراب ارتباط برقرار می‌کنند به جز یکی، بینایی که شراب را می‌بیند و لامسه که جام شراب را لمس می‌کند و بویایی که بوی شراب به هنگام نوشیدن به مشامش می‌رسد و در نهایت ذائقه که آنرا می‌نوشد و تنها حسی که در این جریان هیچ دخالتی ندارد سامعه است و چون ابونواس میخواهد که با تمام حواس خود از شراب لذت ببرد به ساقی گوید که به من بگو این شراب است که حس سامعه هم از شادخواری و باده‌نوشی من بهره‌ببرد! در این هنگام ابو نواس به سمت پسر می‌رود و او را در آغوش می‌گیرد و میگوید مرحبا به تو که شعر مرا عز خود من بهتر فهم کردی. مولانا اینجا با ظرافت تمام این بیت ابونواس را تضمین کرده و در واقع این جمله از زبان حسام الدین است در پاسخ بیت پیشین که مولانا ازو پرسید تو که میدانی پس چرا تقاضای گفتن می‌کنی، حسام الدین در پاسخ به او چنین پاسخ دهد که این درخواست من از روی احساس تشنگی و اشتهای بسیار برای دریافت معانی معرفتی و غیبی باشد و با تضمین مصراع ابونواس این معنی را یادآور می‌شود که مانند گفته آن پسر که من برای استفاده و لذت بردن کامل از این لطایف معنوی میخواهم که حس سامعه‌ام نیز از دهان تو بشنود."],[591,"بر دهان تست این دم جام او","گوش می‌گوید که قسم گوش کو","این بیت با بالایی موقوف المعانی است یعنی معنی آن متصل به بالایی است که حسام الدین در ادامه به مولانا گوید اکنون تو مانند آن ساقی می‌مانی که دهانت مانند جام می‌می‌ماند و دهان به معنی آلت گفتار است یعنی گفته های تو شراب معارف الهی است و وقتی سخن می‌گویی گویی دهانت جام شرام است که بر کام جان من می‌چشانی و گوش من هم میخواهد حض بیشتر و نهایت مستی را بچشد تا تو با آوردن این اسرار الهی به بیان و در قالب گفتار حس سامعه‌ام را نیز مست کنی."],[591,"قسم تو گرمیست نک گرمی و مست","گفت حرص من ازین افزون‌ترست","مولانا در پاسخ گوید نصیبه تو از این اسرار الهی و معانی غیبی همان چشیدن است مانند شراب که خوردنش باعث گرما میشود و اندازه تو این مقدار است و اکنون هم به واسطه اینکه تو از آن مقداری که اندازه تو بود برخوردار شدی و همین سبب شده تا دچار مستی و سکر الهی به تو دست دهد که در مصراع دوم پاسخ حسام الدین به مولانا است که گوید عطش و خواست من بسیار از آنچه تو می‌گویی بیشتر است و شاید به عبارتی گوید ظرفیت من بیشتر است و او در تلاش است تا مولانا را قانع کند به گفتن ادامه آنچه در حال گفتن بود! و گویا در اینجا این مکالمه به پایان می‌رسد و مولانا که از درونش هاتفان غیبی ندا داده بودند که ماذون به گفتن بیشتر آن اسرار نیست او علیرغم اصرارهای حسام‌الدین سرباز می‌زند و البته دلیل مولانا می‌توانسته این باشد که چون مثنوی در اختیار عامه قرار می‌گیرد، مردم معمولی را درک آن نیست که اسرار غیبی و معارف روحانی را بی پرده در اختیارشان قرار داده شود و او نیز امتناع می‌ورزد ولی گویا به طریق دیگری مانند الهام کردن یا تابانیدن آن انواری که به خود او می‌رسیده حسام‌الدین را مطلع کرده اما حسام‌الدین اصرار دارد که آنها را در قالب مثنوی بشنود از مولانا والله اعلم"],[592,"در حضور مصطفای قندخو","چون ز حد برد آن عرب از گفت و گو","در حضور پیامبر اسلام، مصطفی، عربی که زبانی تند و بی‌ادب داشت، از حد خود فراتر رفت و در گفت‌وگو بی‌احترامی کرد."],[592,"آن شه والنجم و سلطان عبس","لب گزید آن سرد دم را گفت بس","پیامبر اکرم، که به عنوان بهترین و برجسته‌ترین شخصیت شناخته می‌شود، به اعتراض آن عرب که زبانی تند داشت، با جدا کردن لب، به او فهماند که باید در سخن‌گفتن احتیاط کند و کافی است."],[592,"دست می‌زد بهر منعش بر دهان","چند گویی پیش دانای نهان","آن شخص برای جلوگیری از سخنان او به دهانش می‌زد؛ چه نیاز است که بیشتر از این به دانای پنهان (خدا) بگویید؟"],[592,"پیش بینا برده‌ای سرگین خشک","که بخر این را به جای ناف مشک","تو برای شخص دانا، کثافت و زشتی را به نشان زیبایی و عطری خوشبویی نشان می‌دهی، در حالی که واقعیت آنچه را که نشان می‌دهی، زشت و ناپسند است."],[592,"بعر را ای گنده‌مغز گنده‌مخ","زیر بینی بنهی و گویی که اخ","ای مغز گنده و نابخرد، عطر خوش را زیر بینی‌ات ببر و وانمود کن که آن را حس کرده‌ای، ممکن است به تو خوش بیاید."],[592,"اخ اخی برداشتی ای گیج گاج","تا که کالای بدت یابد رواج","ای گیج و سردرگم، تو چیزی را به اشتباه برداشت کرده‌ای، تا بتوانی کالای بد خود را رایج کنی."],[592,"تا فریبی آن مشام پاک را","آن چریده گلشن افلاک را","فرصتی برای فریب‌دادن آن جان پاک و معصوم وجود ندارد، چرا که آن موجودی که از باغ آسمانی به دنیای ما آمده است، خود را از هرگونه فریب و نیرنگ مصون نگه‌داشته است."],[592,"حلم او خود را اگر چه گول ساخت","خویشتن را اندکی باید شناخت","آنچه در این بیت گفته شده این است که حتی اگر انسان‌های نیکوکار مانند پیامبر اسلام (مصطفی) به خاطر حلم و بردباری خود، گول می‌زنند و خود را می‌فریبند، باید در اندکی از خودشناسی و خودآگاهی دقت کنند."],[592,"دیگ را گر باز ماند امشب دهن","گربه را هم شرم باید داشتن","اگر دیگی (ظرفی که غذا در آن پخته می‌شود) امشب به خاطر نپخته ماند، گربه هم باید خجل باشد که دهانش را باز کند. این جمله به نوعی اشاره به شرم و خجالت در مواردی دارد که ما نمی‌توانیم به وظایف خود به درستی عمل کنیم."],[592,"خویشتن گر خفته کرد آن خوب فر","سخت بیدارست دستارش مبر","اگر آن معشوق نیکو روی، خود را در خواب زده باشد، اما همیشه درحال بیداری است و باید از او دوری کرد و دست از او کشید."],[592,"چند گویی ای لجوج بی‌صفا","این فسون دیو پیش مصطفی","ای شخص لجوج و بی‌توجه، چند بار می‌خواهی حرف بزنی؟ این جملات فریبنده، در برابر پیامبر خدا، محمد (مصطفی) به هیچ‌وجه تاثیر ندارد."],[592,"صد هزاران حلم دارند این گروه","هر یکی حلمی از آنها صد چو کوه","این گروه از انسان‌ها دارای صبری بسیار زیاد هستند و هر یک از آن‌ها همچون کوهی استوار و بزرگ، صبر و حلمی عمیق و قابل توجه دارند."],[592,"حلمشان بیدار را ابله کند","زیرک صد چشم را گمره کند","حلم و بردباری این افراد، کسانی که عاقل و بیدار هستند را به نادانی می‌کشاند، و آدم‌های باهوش و زیرک را غافل و گمراه می‌کند."],[592,"حلمشان هم‌چون شراب خوب نغز","نغز نغزک بر رود بالای مغز","حلم و صبر آن‌ها مانند شراب خوشمزه و لذت‌بخش است که به تدریج بر عقل و فکر انسان تأثیر می‌گذارد."],[592,"مست را بین زان شراب پرشگفت","هم‌چو فرزین مست کژ رفتن گرفت","مستی را ببین که از اثر آن شراب شگفت‌انگیز چگونه به حالت ناهنجاری دچار شده و راه را به بی‌راهه می‌رود. این مست مشابه فرزین (شخصی که در گذشته به خاطر مستی دچار مشکلاتی شده) است که به طور نادرست حرکت می‌کند."],[592,"مرد برنا زان شراب زودگیر","در میان راه می‌افتد چو پیر","مرد جوان به خاطر تأثیر سریع آن شراب، در میانه راه مانند یک پیرزن به حال افتاده و ناتوان می‌شود."],[592,"خاصه این باده که از خم بلی است","نه میی که مستی او یکشبیست","این باده خاصی که از این جام می‌ریزد، نه مانند شراب‌های معمولی است که تنها یک شب مستی می‌آورد؛ بلکه تأثیر عمیق‌تر و عمیق‌تری دارد."],[592,"آنک آن اصحاب کهف از نقل و نقل","سیصد و نه سال گم کردند عقل","اصحاب کهف (گروهی از جوانان مؤمن که به غار پناه بردند) به مدت سیصد و نه سال در خواب بودند و در این مدت به کلی عقل و درک خود را گم کردند، به گونه‌ای که حتی زمان و مکان را فراموش کردند."],[592,"زان زنان مصر جامی خورده‌اند","دستها را شرحه شرحه کرده‌اند","زنان مصری برای سرگرم شدن و خوشگذرانی، مشروبات الکلی نوشیده‌اند و به همین خاطر، دست‌های خود را به نشانه درد و آسیب، زخم‌زخم کرده‌اند."],[592,"ساحران هم سکر موسی داشتند","دار را دلدار می‌انگاشتند","ساحران نیز به مجذوبیت موسی دچار بودند و او را به عنوان محبوب و دلخواه خود می‌پنداشتند."],[592,"جعفر طیار زان می بود مست","زان گرو می‌کرد بی‌خود پا و دست","جعفر طیار از آن شراب (عشق و معرفت) مست بود و در نتیجه، پا و دست خود را به‌گونه‌ای که بی‌خود شده باشد، رها می‌کرد."],[593,"با مریدان آن فقیر محتشم","بایزید آمد که نک یزدان منم","با مریدان آن عارف بزرگ، بایزید، آمد و گفت که من خود بنده خدا هستم."],[593,"گفت مستانه عیان آن ذوفنون","لا اله الّا انا ها فاعبدون","بایزید (بایزید بسطامی) به صورت خلسه و مستی می‌گوید که موجودات مختلفی با علم و هنرهای متفاوت، فقط من را پرستش کنند و بجز من کسی دیگر شایسته عبادت نیست."],[593,"چون گذشت آن حال گفتندش صباح","تو چنین گفتی و این نبود صلاح","وقتی حالتی خاص بر ابویزید گذشت و او چنین سخنی گفت، مریدان به او تذکر دادند که گفتن این حرف مناسب نیست و به صلاح او نمی‌آید."],[593,"گفت این بار ار کنم من مشغله","کاردها بر من زنید آن دم هله","او در اینجا می‌گوید اگر دوباره در این مورد سخن بگویم، کاردها (ابزار تیز) بر من بزنید؛ یعنی خود را مستحق عذاب می‌داند و این را نشانه‌ای از اهمیت و خطر آن گفتار می‌داند."],[593,"حق منزّه از تن و من با تنم","چون چنین گویم، بباید کشتنم","منزّه و پاکی خداوند از جسم و وجود مادی انسان‌هاست. اگر من با وجود مادی‌ام چنین سخنانی بگویم، سزاوار است که مرا بکشند؛ زیرا این سخنان نادرست است."],[593,"چون وصیّت کرد آن آزادمرد","هر مریدی کاردی آماده کرد","زمانی که ابویزید، آن عارف بزرگ، در حال وصیت کردن بود، هر یک از مریدانش خود را آماده کردند و کارد (چاقویی) تیز و برنده‌ای به دست گرفتند."],[593,"مست گشت او باز از آن سغراق زفت","آن وصیّت‌هاش از خاطر برفت","او از می‌خوارگی و نشئه‌بودن دچار غفلت شد و به قدری مست بود که آن وصیت‌ها و توصیه‌ها را از یاد برد."],[593,"نقل آمد عقل او آواره شد","صبح آمد شمع او بیچاره شد","عقل او مانند شحنه (محافظ) در زندگی آشفته و بی‌راه شد و با آمدن صبح، شمع وجودش که نمادی از روشنایی و آگاهی است، نابود و بی‌فائده گردید."],[593,"عقل چون شحنه‌ست چون سلطان رسید","شحنه بیچاره در کنجی خزید","عقل مانند نگهبان است و وقتی که سلطان، که در اینجا اشاره به حقیقت و وجود خداست، می‌آید، نگهبان بی‌چاره در گوشه‌ای پنهان می‌شود."],[593,"عقل سایه حق بود حق آفتاب","سایه را با آفتاب او چه تاب","عقل نماینده و سایه خداوند است و خدا مانند آفتابی می‌درخشد. سایه نمی‌تواند در برابر آفتاب ثابت بماند و در واقع، وقتی نور خداوند بر عقل بتابد، عقل هم تحت تأثیر قرار می‌گیرد و تاب نمی‌آورد."],[593,"چون پری غالب شود بر آدمی","گم شود از مرد وصف مردمی","وقتی که روح یا دلی روشن مانند پری بر آدمی تسلط یابد، او از ویژگی‌های انسانی و صفات نیکو فاصله می‌گیرد و همچون پری، گم می‌شود."],[593,"هر چه گوید، آن پری گفته بود","زین سری زان آن سری گفته بود","هر چه انسانی می‌گوید، باید به خاطر داشته باشیم که آن حرف‌ها به نوعی از سوی آن پری (نماد روح یا حقیقت) بیان شده است. در واقع، سخنان انسان از درون وجود او و از حقیقتی برتر نشأت می‌گیرد."],[593,"چون پری را این دم و قانون بود","کردگار آن پری خود چون بود؟","وقتی پری این وضعیت و شرایط را دارد، پس خداوند آن پری که سبب وجود و حالت او است، چگونه باید باشد؟"],[593,"اوی او رفته، پری خود او شده","ترک بی‌الهام، تازی‌گو شده","او (ابوبصیر) به مولانا به حالت شور و حال رفته و از خودبیخودی به مرحله‌ای رسیده که مانند پری شده است و دیگر به زبان فارسی صحبت نمی‌کند، بلکه به زبان عربی سخن می‌گوید."],[593,"چون به خود آید، نداند یک لغت","چون پری را هست این ذات و صفت","وقتی انسان به خود و حقیقت وجودش برمی‌گردد، نمی‌تواند حتى یک کلمه بگوید؛ زیرا نمی‌داند که پری (روح) چگونه ذاتی و صفتی دارد."],[593,"پس خداوند پریّ و آدمی","از پری کی باشدش آخر کمی؟","خداوند، که پروردگار پری و انسان است، آیا می‌تواند کمبود و نقصی داشته باشد؟"],[593,"شیرگیر ار خون نرّه شیر خورد","تو بگویی او نکرد، آن باده کرد","اگر شیر، خون نر شیر را بنوشد، تو می‌گویی که او چنین عملی نکرده، بلکه آن باده (بسیاری از معانی) این کار را انجام داده است. این بیان نشان‌دهنده تکبر یا کج‌فهمی انسان‌ است که به جای پذیرش واقعیت‌ها، به توجیهات ساده‌انگارانه روی می‌آورد."],[593,"ور سخن پردازد از زر کهن","تو بگویی باده گفته‌ست آن سخن","اگر کسی درباره طلا و زر قدیم صحبت کند، تو چه بسا بگویی که آن سخن تحت تأثیر میگساری بیان شده است."],[593,"باده‌ای را می‌بود این شر و شور","نور حق را نیست آن فرهنگ و زور","باده‌ای که مزه و شوری دارد، شر و شور است و نور حق در آن وجود ندارد؛ بنابراین، این باده نمی‌تواند فرهنگ و قدرت واقعی را نمایان کند."],[593,"که ترا از تو به کل خالی کند","تو شوی پست او سخن عالی کند","اگر وجود تو را به طور کلی از خودت خالی کند، در این صورت تو در نظر او حقیر می‌شوی و او سخنان بزرگ و عمیق می‌گوید."],[593,"گرچه قرآن از لب پیغمبرست","هر که گوید حق نگفت، او کافرست","اگرچه قرآن از زبان پیامبر (محمد) صادر شده است، اما هر کس بگوید که او حق نگفته، کافر است."],[593,"چون همای بی‌خودی پرواز کرد","آن سخن را بایزید آغاز کرد","وقتی همای بی‌خودی (نماد روح آزاد و رها) به پرواز درآمد، با حالتSurreal (غیرعادی) و الهام‌بخش، بایزید کلامی را آغاز کرد."],[593,"عقل را سیل تحیّر در ربود","زان قوی‌تر گفت که اوّل گفته بود","تحیر و سردرگمی عقل به مانند سیلی است که او را به شدت تحت تأثیر قرار داد، زیرا سخن بایزید آنچنان قوی و مؤثر بود که قبلا هیچ‌گاه این‌چنین بیان نشده بود."],[593,"نیست اندر جبّه‌ام الّا خدا","چند جویی بر زمین و بر سما","در لباس من چیزی جز خدا نیست. چرا در زمین و آسمان به‌دنبال چیز دیگری می‌گردید؟"],[593,"آن مریدان جمله دیوانه شدند","کاردها در جسم پاکش می‌زدند","مریدان ابویزیید که به شدت تحت تأثیر افکار او قرار گرفته بودند، در حالت جنون به او حمله کردند و با کارد به جسم پاکش ضربه می‌زدند."],[593,"هر یکی چون ملحدان گرده کوه","کارد می‌زد پیر خود را بی‌ستوه","هر یک از آن مریدان مانند ملحدانی که بر گرده کوه ایستاده‌اند، بدون هیچ رحمی و با بی‌رحمی تمام، به جسم پیر خود (ابویزید) حمله می‌کنند."],[593,"هر که اندر شیخ تیغی می‌خلید","بازگونه از تن خود می‌درید","هر کسی که به شیخ (پیر) خود آسیب می‌زند و او را مورد حمله قرار می‌دهد، در واقع درد و رنجی را بر خود وارد می‌کند و از خود می‌کاهد."],[593,"یک اثر نه بر تن آن ذوفنون","وان مریدان خسته و غرقاب خون","دردی که بر تن ابوی‌زید (شیخ معروف) وارد شده، تنها بر جسم او نیست، بلکه مریدانش نیز در اثر این گفتگوها و بحث‌ها، خسته و غرق در مشکلات و رنج‌ها شده‌اند."],[593,"هر که او سویی گلویش زخم برد","حلق خود ببریده دید و زار مرد","هر کس که در زندگی‌اش درد و رنجی به او رسیده باشد، مانند کسی است که گلویش زخم برداشته و حلقش بریده شده است و به همین دلیل به شدت می‌گرید و از شدت ناراحتی به حال زار افتاده است."],[593,"وآنک او را زخم اندر سینه زد","سینه‌اش بشکافت و شد مرده ابد","آن شخص (در اینجا ابویزید) زخم در دلش خورد و دلش از آن زخم شکافت، به‌طوری که دیگر زنده نماند و برای همیشه مرد."],[593,"وآنک آگه بود از آن صاحب‌قران","دل ندادش که زند زخم گران","او (ابویزید) از حال صاحب‌قران (پیامبر اسلام) آگاه بود، اما دلش به این نمی‌داد که زخم سنگینی را به او بزند."],[593,"نیم‌دانش دست او را بسته کرد","جان ببرد الّا که خود را خسته کرد","نیم‌دانش (کمی علم و آگاهی) باعث شد که او (ابویزید) دستش بسته شود و نتواند به درستی عمل کند و جانش از اثر این محدودیت از بین رفت، مگر اینکه خود را در رنج و زحمت بیندازد تا از این بند رهایی یابد."],[593,"روز گشت و آن مریدان کاسته","نوحه‌ها از خانه‌شان برخاسته","روز گذشت و آن مریدان، که به خاطر گفته‌های ابویزید ملول و ناامید شده بودند، از خانه‌های خود بیرون آمده و نوحه و گریه سر دادند."],[593,"پیش او آمد هزاران مرد و زن","کای دو عالم درج در یک پیرهن","هزاران مرد و زن پیش او (ابویزید) آمدند و گفتند که تو تمام دو عالم را در یک لباس (تن) جمع کرده‌ای."],[593,"این تن تو گر تن مردم بدی","چون تن مردم ز خنجر گم شدی","اگر جسم تو همچون افراد عادی باشد، به‌خاطر شباهت، از حقیقت خود گم شده‌ای و در واقعیت خود را فراموش کرده‌ای."],[593,"با خودی با بی‌خودی دوچار زد","با خود اندر دیده خود خار زد","انسان وقتی به خودی و بی‌خودی دچار می‌شود، در درون خود به خود آزار می‌زند و دردهایش را می‌بیند."],[593,"ای زده بر بی‌خودان تو ذوالفقار","بر تن خود می‌زنی آن هوش دار","ای کسی که بر بی‌خودان (کسانی که از خود گذشته‌اند) حمله می‌کنی، توجه کن که تو نیز با شمشیر ذوالفقار (شمشیر امام علی) بر خودت می‌زنی و به خود آسیب می‌رسانی."],[593,"زانک بی‌خود فانی است و آمنست","تا ابد در آمنی او ساکنست","چون بی‌خود و از خود گذشته است، هرگز در اضطراب نیست و همواره در آرامش و امنیت به سر می برد."],[593,"نقش او فانی و او شد آینه","غیر نقش روی غیر آن جای نه","نقش و تصویر او از بین رفته و خود او تبدیل به آینه‌ای شده است که منعکس‌کننده غیر است و دیگر نقشی در آن وجود ندارد. در واقع، اینجا اشاره به فنا و از میان رفتن خودخواهی و خودی دارد."],[593,"گر کنی تف سوی روی خود کنی","ور زنی بر آینه، بر خود زنی","اگر به جای نگاه به خود و هویت واقعی‌ات، به ظاهر خود توجه کنی و به صورتت خیره شوی، در واقع خود را ضایع کرده‌ای و به حقیقت درونت توجهی نکرده‌ای."],[593,"ور ببینی روی زشت آن هم توی","ور ببینی عیسی و مریم توی","اگر چهره زشت خود را ببینی، هم‌چنان که عیسی و مریم (به عنوان نماد زیبایی و پاکی) را می‌بینی، در حقیقت خود را می‌بینی."],[593,"او نه اینست و نه آن او ساده است","نقش تو در پیش تو بنهاده است","او نه مشخصات ظاهری (که باید خداوند یا عارف باشد) و نه ویژگی‌های دیگر را دارد، بلکه حقیقت او سادگی و بی‌نیازی است و نقش و تصویر تو از او در ذهنت قرار دارد."],[593,"چون رسید اینجا سخن لب در ببست","چون رسید اینجا قلم درهم شکست","زمانی که به اینجا رسید، سخنگو زبانش را بست و چون به اینجا رسید، قلم نیز دیگر نتوانست بنویسد."],[593,"لب ببند ار چه فصاحت دست داد","دم مزن والله اعلم بالرّشاد","سکوت کن اگرچه در بیان سخن مهارت داری؛ چیزی نگو که خدا به راست‌گویی و هدایت داناتر است."],[593,"برکنار بامی ای مست مدام","پست بنشین یا فرود آ والسّلام","ای مست همیشگی، دور از سرزندگی بر لبه بام نشسته‌ای، بهتر است که از آن بالا پایین بیایی و به آرامی و با سلام و احترام، در جایی پایین‌تر بنشینی."],[593,"هر زمانی که شدی تو کامران","آن دم خوش را کنار بام دان","هر زمان که تو به موفقیت و خوشحالی رسیدی، آن لحظه شادابی را باید در کنار بام (بلندای زندگی) قرار دهی، یعنی مقام و ارزشت را حفظ کن."],[593,"بر زمان خوش هراسان باش تو","هم‌چو گنجش خفیه کن نه فاش تو","در زمانه‌های خوش، باید نگران و هراسان باشی، مانند گنجشکی که به طور پنهانی و نه آشکار زندگی می‌کند."],[593,"تا نیاید بر ولا ناگه بلا","ترس ترسان رو در آن مکمن هلا","تا زمانی که بلا ناگهان بر ولایت نرسیده، نترس و از آن مکانی که در آن پنهان شده‌ای، خود را بترسان."],[593,"ترس جان در وقت شادی از زوال","زان کنار بام غیبست ارتحال","در هنگام شادی، روح از ترس جدایی و مرگ در اضطراب است و این حالت ناشی از اتصال با عالم غیب است."],[593,"گر نمی‌بینی کنار بام راز","روح می‌بیند که هستش اهتزاز","اگر تو در کنار بام غیب، یعنی در حالت شادی و خوشی، رازها را نمی‌بینی، روح باطن تو این رازها را می‌بیند که در آن حالت، زندگی و حرکت وجود دارد."],[593,"هر نکالی ناگهان کان آمدست","بر کنار کنگره شادی بدست","هر نغمه و صدایی که به ناگهان به گوش می‌رسد، بر لبه خوشحالی و شادی به دست آمده است."],[593,"جز کنار بام خود نبود سقوط","اعتبار از قوم نوح و قوم لوط","تنها کنار بام خود، انسان نمی‌تواند اعتبارش را از دست بدهد، مانند قوم نوح و قوم لوط که به خاطر اعمال نادرستشان سقوط کردند."],[594,"پرتو مستی بی‌حد نبی","چون بزد هم مست و خوش گشت آن غبی","وقتی که پرتو مستی بی حد ناشی از حضور نبی بر آن فرد گمراه افتاد، او هم مست شد."],[594,"لاجرم بسیارگو شد از نشاط","مست ادب بگذاشت آمد در خباط","این طور شد که نشاط مستی باعث شد او پرگویی کند، و آن مست ادب را فراموش کرد و بی‌عقلی کرد."],[594,"نه همه جا بی‌خودی شر می‌کند","بی‌ادب را می چنان‌تر می‌کند","مستی همیشه مایه شر نیست؛ بلکه بی‌ادب است که مستی بی‌ادب‌ترش می‌کند."],[594,"گر بود عاقل نکو فر می‌شود","ور بود بدخوی بتّر می‌شود","حین مستی، اگر انسان عاقل باشد، به رفتار خوب و نیکویی می‌رسد، اما اگر فردی بدخو باشد، وضعیتش بدتر می‌شود."],[594,"لیک اغلب چون بدند و ناپسند","بر همه می را محرم کرده‌اند","اما چون بیشتر افراد بدکردار هستند، می‌ را بر همه حرام کرده‌اند."],[595,"حکم اغلب راست چون غالب بدند","تیغ را از دست ره‌زن بستدند","بیشتر اوقات، حکم و قضاوت کسانی که در قدرت‌اند درست است، زیرا آن‌ها مانند کسانی هستند که تیغ را از دست دزد گرفته‌اند و بر او تسلط یافته‌اند."],[595,"گفت پیغامبر کای ظاهرنگر","تو مبین او را جوان و بی‌هنر","پیامبر گفت: ای کسی که فقط به ظواهر نگاه می‌کنی، او را به عنوان یک جوان و بی‌مهارت نبین."],[595,"ای بسا ریش سیاه و مرد پیر","ای بسا ریش سپید و دل چو قیر","بسیاری از مردان پیر با ریش سیاه وجود دارند و بسیاری هم ریش سپید دارند اما دل‌شان مانند قیر سخت و سیاه است."],[595,"عقل او را آزمودم بارها","کرد پیری آن جوان در کارها","من بارها عقل او را آزموده‌ام و در امور به جوانی که پیری او را احاطه کرده، اطمینان پیدا کرده‌ام."],[595,"پیر پیر عقل باشد ای پسر","نه سپیدی موی اندر ریش و سر","عقل و درک انسان می‌تواند در هر سنی وجود داشته باشد و به سن و سال ارتباط ندارد؛ بلکه تنها نشانه پیری، سفیدی مو نیست."],[595,"از بلیس او پیرتر خود کی بود","چونک عقلش نیست او لاشی بود","هیچ‌کس جز ابلیس از پیران (کسانی که عمر بیشتری دارند) پست‌تر نیست، چراکه او عقل ندارد و بی‌فایده است."],[595,"طفل گیرش چون بود عیسی نفس","پاک باشد از غرور و از هوس","کودک چطور می‌تواند مانند عیسی (عیسای مسیح) باشد، در حالی که نفس پاک و بی‌غرور و رها از هوس است؟"],[595,"آن سپیدی مو دلیل پختگیست","پیش چشم بسته کش کوته‌تگیست","سپیدی مو نشانه تجربه و پختگی است، اما بعضی افراد که بینش کافی ندارند، به دلیل کم‌تجربگی نمی‌توانند این نشانه‌ها را به درستی ببینند و درک کنند."],[595,"آن مقلد چون نداند جز دلیل","در علامت جوید او دایم سبیل","آن مقلد (کسی که تقلید می‌کند) چون جز دلیل (راهنما و علم) نمی‌داند، همواره به دنبال نشانه‌ها و علامت‌ها می‌گردد تا راهی بیابد."],[595,"بهر او گفتیم که تدبیر را","چونک خواهی کرد بگزین پیر را","برای او گفتیم که اگر می‌خواهی تدبیر و مدیریت کارهایت را به خوبی انجام دهی، باید یک پیر و استاد را انتخاب کنی که تجربه و دانش کافی داشته باشد."],[595,"آنک او از پرده تقلید جست","او به نور حق ببیند آنچ هست","کسی که از پرده تقلید و پیروی از دیگران رهایی یابد، می‌تواند به نور حقیقت نگاهی عمیق‌تر داشته باشد و واقعیت را آن‌گونه که هست، ببیند."],[595,"نور پاکش بی‌دلیل و بی‌بیان","پوست بشکافد در آید در میان","نور پاک او بدون هیچ دلیلی و بی‌نیاز از توضیح، مانند نوری که پوست را می‌شکافد، به روشنی و وضوح در درون انسان‌ها می‌تابد."],[595,"پیش ظاهربین چه قلب و چه سره","او چه داند چیست اندر قوصره","آن کسی که فقط به ظاهر توجه می‌کند، چه به باطن و چه به حقیقت امور، نمی‌تواند بداند که در عمق و درون این موضوعات چه خبر است و چه می‌گذرد."],[595,"ای بسا زر سیه کرده بدود","تا رهد از دست هر دزدی حسود","شاید کسانی وجود داشته باشند که برای پنهان کردن زرق و برق خود (زر) رنگ سیاه به آن بزنند تا از دست دزدها و حسودها در امان بمانند."],[595,"ای بسا مس زر اندوده به زر","تا فروشد آن به عقل مختصر","گاهی اوقات ممکن است چیزی که به ظاهر زرین و باارزش به نظر می‌رسد، فقط به خاطر ظاهرش ارزشمند باشد و در باطن خالی از معنا و عقل باشد. در واقع، فردی که صرفا به ظواهر توجه می‌کند، عاقل نیست و به درستی نمی‌تواند ارزش واقعی اشیاء را تشخیص دهد."],[595,"ما که باطن‌بین جمله کشوریم","دل ببینیم و به ظاهر ننگریم","ما کسانی هستیم که به باطن و عمق مسائل توجه داریم و فقط به ظواهر و ظاهر نگاه نمی‌کنیم؛ بنابراین دل‌ها را می‌بینیم و به صورت‌های ظاهری اهمیت نمی‌دهیم."],[595,"قاضیانی که به ظاهر می‌تنند","حکم بر اشکال ظاهر می‌کنند","قاضیانی که فقط به ظاهر امور توجه می‌کنند، درباره‌ی مسائل قضاوت می‌کنند و اشتباهاتی را که تنها از روی ظواهر دیده می‌شود، محکوم می‌کنند."],[595,"چون شهادت گفت و ایمانی نمود","حکم او مؤمن کنند این قوم زود","وقتی کسی در مقابل قاضی شهادت می‌دهد و نشان می‌دهد که به ایمان و عقیده‌اش پایبند است، این جمعیت سریعا او را مؤمن می‌دانند."],[595,"بس منافق کاندرین ظاهر گریخت","خون صد مؤمن به پنهانی بریخت","منافقانی که در این دنیا، خود را نمایان می‌کنند، در واقع با نقشی که در ظاهر دارند، باعث ریخته شدن خون بسیاری از مؤمنان به طور مخفیانه و پنهان می‌شوند."],[595,"جهد کن تا پیر عقل و دین شوی","تا چو عقل کل تو باطن‌بین شوی","تلاش کن تا پیر و رهبر عقل و دین شوی، تا مانند عقل کل بتوانی حقیقت را در باطن ببینی."],[595,"از عدم چون عقل زیبا رو گشاد","خلعتش داد و هزارش نام داد","از عدم، یعنی از نبود، عقل زیبا و با رو نمایان شد و به او لباس بزرگی داده شد و هزار نام به او اختصاص یافت."],[595,"کمترین زان نامهای خوش‌نفس","این که نبود هیچ او محتاج کس","هیچ‌کدام از آن نام‌های زیبا و شایسته به هیچ موجودی وابسته و نیازمند نیستند."],[595,"گر به صورت وا نماید عقل رو","تیره باشد روز پیش نور او","اگر عقل فقط به صورت و ظاهر نگاه کند، نادانی او باعث می‌شود که در روز، نور و روشنی آن را نبیند."],[595,"ور مثال احمقی پیدا شود","ظلمت شب پیش او روشن بود","اگر احمق یا نادانی که درک درست ندارد، در روشنایی شب قرار بگیرد، برای او به اندازه‌ی روشنی روز نیز قابل تشخیص نخواهد بود و در حقیقت، هنوز در darkness به سر می‌برد."],[595,"کو ز شب مظلم‌تر و تاری‌ترست","لیک خفاش شقی ظلمت‌خرست","اگر کسی در تاریکی شب به‌سر ببرد، نه تنها توانایی دیدن نور را ندارد، بلکه مانند خفاش، به زندگی در ظلمت عادت کرده و از آن خوشنود است."],[595,"اندک اندک خوی کن با نور روز","ورنه خفاشی بمانی بیفروز","کم‌کم سعی کن خودت را با روشنایی روز وفق دهی وگرنه مانند خفاشی می‌مانی که در تاریکی زندگی می‌کند و از روشنایی محروم می‌شود."],[595,"عاشق هر جا شکال و مشکلیست","دشمن هر جا چراغ مقبلیست","عاشق در هر جایی که مشکلی وجود دارد، می‌رود و آن را حل می‌کند، اما دشمن در هر جا که نور و روشنی باشد، با آن مخالفت می‌کند."],[595,"ظلمت اشکال زان جوید دلش","تا که افزون‌تر نماید حاصلش","دل انسان در جستجوی مشکلات و چالش‌هاست تا بتواند از آن‌ها تجارب و دستاوردهای بیشتری به دست آورد."],[595,"تا ترا مشغول آن مشکل کند","وز نهاد زشت خود غافل کند","دل انسان را مشکلات و سختی‌ها مشغول می‌کنند تا او از عیوب و زشتی‌های درونی خود غافل بماند."],[596,"عاقل آن باشد که او با مشعله‌ست","او دلیل و پیشوای قافله‌ست","عاقل کسی است که با نور هدایت و عقل خود حرکت می‌کند و به عنوان راهنما و رهبری برای جمعیت عمل می‌کند."],[596,"پیرو نور خودست آن پیش‌رو","تابع خویشست آن بی‌خویش‌رو","پیشوای واقعی کسی است که از نور درونی خود پیروی می‌کند و به آن نور راه می‌یابد. در حالی که کسی که به خودش اعتباری ندارد و راه را به سمت بیرون می‌جوید، در حقیقت دنبال‌کننده دیگران است و نقصی در شناخت خود دارد."],[596,"مؤمن خویشست و ایمان آورید","هم بدان نوری که جانش زو چرید","مؤمن کسی است که به خود ایمان دارد و به نوری که جان او از آن بهره‌مند است، توجه دارد و از آن نور پیروی می‌کند."],[596,"دیگری که نیم‌عاقل آمد او","عاقلی را دیده خود داند او","دیگری که عقلش ناقص است، خود را عاقل می‌پندارد چون او به چشم خود عقل کامل را نمی‌بیند."],[596,"دست در وی زد چو کور اندر دلیل","تا بدو بینا شد و چست و جلیل","آنکه مانند یک فرد نابینا در سیر و سلوک به دنبال حقیقت است، وقتی به حقیقت دست پیدا کند، بینا و با سرعت و عظمت می‌شود."],[596,"وآن خری کز عقل جوسنگی نداشت","خود نبودش عقل و عاقل را گذاشت","آن خر که عقلش همچون سنگ سخت بود، خود را عاقل نمی‌دانست و به خاطر این نداشتن عقل، به دیگران نیز چیزی از عقل را منتقل نکرد."],[596,"ره نداند نه کثیر و نه قلیل","ننگش آید آمدن خلف دلیل","کسی که در مسیر زندگی راه را نمی‌شناسد، چه زیاد باشد و چه کم، برایش شرم‌آور است که بدون راهنما و به سمت غلط برود."],[596,"می‌رود اندر بیابان دراز","گاه لنگان آیس و گاهی بتاز","انسان در مسیر زندگی همچون کسی است که گاهی با کندی و ناتوانی پیش می‌رود و گاهی با شتاب و قوت. این رفتار نشان‌دهنده ناپایداری و عدم ثبات اوست."],[596,"شمع نه تا پیشوای خود کند","نیم شمعی نه که نوری کد کند","شمع تا زمانی که پیشوای خود را نداشته باشد، نمی‌تواند کاملا روشن باشد. کسی که نیمه‌عاقل است، نمی‌تواند نور و روشنی لازم را به دیگران بدهد و فقط می‌تواند چیزهایی را که نور درستی ندارند، تولید کند."],[596,"نیست عقلش تا دم زنده زند","نیم‌عقلی نه که خود مرده کند","عقلی که تا آخر عمرش زنده نیست، نشان از نیم‌عقلی دارد و به نوعی مانند مرده است که زندگی ندارد."],[596,"مرده آن عاقل آید او تمام","تا برآید از نشیب خود به بام","عاقل کامل، در مقایسه با دیگران، مانند مرده‌ای است که می‌آید تا برتری یابد و از وضعیت پایین خود به مقام بلند برسد."],[596,"عقل کامل نیست خود را مرده کن","در پناه عاقلی زنده‌سخن","برای دستیابی به عقل کامل، خود را در نظر بگیر که مرده‌ای. در سایه عاقل دیگر، به دانایی و زندگی حقیقی دست پیدا کن."],[596,"زنده نی تا همدم عیسی بود","مرده نی تا دمگه عیسی شود","آدم زنده‌ای که در زندگی‌اش با عیسی (پیامبر) هم نشین باشد، نمی‌تواند مانند کسی که مرده است به عنوان ناقص و بی‌فایده عمل کند؛ او باید در جاهای مناسب و در مواقع خاص، به کمال و حیات واقعی برسد."],[596,"جان کورش گام هر سو می‌نهد","عاقبت نجهد ولی بر می‌جهد","جان کورش، در همه‌جا حرکت می‌کند، اما سرانجام به جایی نخواهد رسید؛ او صرفا مضطرب است و بی‌هدف به جلو می‌رود."],[597,"قصه آن آبگیرست ای عنود","که درو سه ماهی اشگرف بود","قصه آن برکه (آبگیر) برای تو ای سخت‌گیر و لجوج، که در آن سه ماهی هستند که بزرگ و عالی‌اند."],[597,"در کلیله خوانده باشی لیک آن","قشر قصه باشد و این مغز جان","در کتاب کلیله و دمنه، داستان‌ها فقط به ظاهر و شکل خارجی آن‌ها پرداخته‌اند، اما عمق و حقیقت معنوی این قصه‌ها، یعنی فهم و معرفتی که از آن‌ها می‌توان کسب کرد، بسیار ارزشمندتر است."],[597,"چند صیادی سوی آن آبگیر","برگذشتند و بدیدند آن ضمیر","چندین صیاد به سمت آن آبگیر رفتند و در آنجا با طرز فکر و نیت پنهانی آن‌ها مواجه شدند."],[597,"پس شتابیدند تا دام آورند","ماهیان واقف شدند و هوشمند","صیادان با عجله به جمع‌آوری دام پرداختند تا ماهی‌ها را بگیرند، زیرا آنها متوجه وجود ماهی‌ها شده و از هوش و درک بالای خود استفاده کردند."],[597,"آنک عاقل بود عزم راه کرد","عزم راه مشکل ناخواه کرد","آن یکی که عاقل بود، تصمیم گرفت به سمت راه برود، اما تصمیم گرفتن برای او دشوار شد و نتوانست آن را عملی کند."],[597,"گفت با اینها ندارم مشورت","که یقین سستم کنند از مقدرت","او می‌گوید که با این افراد مشورت نمی‌کنم، زیرا مطمئن هستم که قدرت من را تضعیف می‌کنند و از آن سواستفاده می‌کنند."],[597,"مهر زاد و بوم بر جانشان تند","کاهلی و جهلشان بر من زند","به بهانه علاقه به محیط اطرافشان نادانی و تنبلی می‌کنند که این باعث آسیب به من میشود"],[597,"مشورت را زنده‌ای باید نکو","که ترا زنده کند وان زنده کو","برای مشورت کردن، باید با فرد زنده‌ای گفتگو کنی که تو را زنده و هوشیار کند، نه با کسی که به تو کمکی نکند."],[597,"ای مسافر با مسافر رای زن","زانک پایت لنگ دارد رای زن","ای مسافر، با مسافران مشورت کن، زیرا پای تو می‌لنگد و به تنهایی نمی‌توانی راه را خوب بروی."],[597,"از دم حب الوطن بگذر مه‌ایست","که وطن آن سوست جان این سوی نیست","از احساس حب وطن خود فاصله بگیر، زیرا روشن است که وطن واقعی در آن سوی رودخانه قرار دارد و جان تو در این طرف نیست."],[597,"گر وطن خواهی گذر آن سوی شط","این حدیث راست را کم خوان غلط","اگر می‌خواهی به وطن واقعی دست یابی، باید از اینجا عبور کنی و به آن سوی دریا بروی؛ این سخن حقیقت دارد و آن را کم نخوان و به اشتباه نگیر."],[598,"در وضو هر عضو را وردی جدا","آمدست اندر خبر بهر دعا","در وضو، برای هر یک از اعضای بدن دعایی خاص وارد شده است که نشان‌دهنده اهمیت و اثرگذاری آن عضو در ارتباط با دعا و نیایش است."],[598,"چونک استنشاق بینی می‌کنی","بوی جنت خواه از رب غنی","وقتی که بوی خوشی را به واسطه استنشاق از بینی خود حس می‌کنی، از خداوند غنی و بی‌نیاز بخواه که بوی بهشت را به تو بیاموزد."],[598,"تا ترا آن بو کشد سوی جنان","بوی گل باشد دلیل گلبنان","بوی گل تو را به سوی بهشت می‌کشاند و این بو نشانه و دلیلی بر وجود گلستان است."],[598,"چونک استنجا کنی ورد و سخن","این بود یا رب تو زینم پاک کن","وقتی که در مکان استنجا (محلی که برای تطهیر خود استفاده می‌شود) هستی و ذکر و دعا می‌خوانی، این دعا را که به خدای خود می‌گویی، این است که: «خداوندا، مرا از این حالت ناپاکی پاک کن»."],[598,"دست من اینجا رسید این را بشست","دستم اندر شستن جانست سست","من دستم به اینجا رسید و این را شستشو داد. شستن دستم، به نوعی به شستشوی جان من مربوط است و نشان می‌دهد که روح من از این عمل مقدس سست و ضعیف است."],[598,"ای ز تو کس گشته جان ناکسان","دست فضل تست در جانها رسان","ای کسی که با وجود تو، افرادی که به صورت ناقصند جان پیدا کرده‌اند، دست رحمت و نعمت توست که به جان‌ها می‌رسد."],[598,"حد من این بود کردم من لئیم","زان سوی حد را نقی کن ای کریم","من به خاطر لئیم بودن و ناپاکی خود، به حد و مرز خود محدود شده‌ام. ای کریم، از آن طرف می‌خواهم که این محدودیت را از بین ببری و مرا به موقعیتی بالاتر برسانی."],[598,"از حدث شستم خدایا پوست را","از حوادث تو بشو این دوست را","خدایا، از ناپاکی‌ها و آلودگی‌ها پاکم کن، تا این دوست را از حوادث و مشکلاتی که به او رسیده، پاکسازی کنی."],[599,"آن یکی در وقت استنجا بگفت","که مرا با بوی جنت دار جفت","شخصی در زمان شستن (استنجا) دعا کرد که مرا با بوی بهشت همراه کن."],[599,"گفت شخصی خوب ورد آورده‌ای","لیک سوراخ دعا گم کرده‌ای","شخصی گفت که دعا و ذکر خوبی را بر زبان می‌روی، اما در اصل مطلب و معنای واقعی آن دچار اشتباه شده‌ای و به مسأله‌ی اصلی نپرداخته‌ای."],[599,"این دعا چون ورد بینی بود چون","ورد بینی را تو آوردی به کون","این دعا که شبیه ورد است، مانند وردی که از بینی بیرون می‌آید، شما آن را در نشیمنگاه (کون) آورده‌اید."],[599,"رایحه جنت ز بینی یافت حر","رایحه جنت کم آید از دبر","بو و رایحه بهشت را از بینی خود حس کن؛ آیا بوی بهشت که از مقعد خارج می‌شود، به اندازه بوی بهشت از بینی می‌تواند خوشایند باشد؟"],[599,"ای تواضع برده پیش ابلهان","وی تکبر برده تو پیش شهان","تواضع و فروتنی تو نزد مردم عادی و جاهل مثل برده است، در حالی که تکبر و خود بزرگ‌بینی تو نزد شاهان و افراد برجسته نیز همانند بردگی است."],[599,"آن تکبر بر خسان خوبست و چست","هین مرو معکوس عکسش بند تست","این بیت به این نکته اشاره دارد که خودستایی و تکبر بر افراد بی‌اهمیت (خسان) برای انسان موجه و آسان است، اما به یاد داشته باش که اگر به کسانی که به مقام و منزلت افزون‌تری هستند، تکبر کنی، در واقع در دام خودت گرفتار شده‌ای."],[599,"از پی سوراخ بینی رست گل","بو وظیفه بینی آمد ای عتل","بو کردن گل از سوراخ بینی وظیفه بینی است، ای آدم نادان. اینجا شاعر به عملکرد بینی اشاره دارد و به نوعی می‌گوید که انسان باید از آنچه برایش مقرر شده استفاده کند، و به دور از نادانی باشد."],[599,"بوی گل بهر مشامست ای دلیر","جای آن بو نیست این سوراخ زیر","بوی گل برای مشام ماست، ای دلیر (شجاع)، اما این بوی خوش در این سوراخ بینی وجود ندارد."],[599,"کی ازین جا بوی خلد آید ترا","بو ز موضع جو اگر باید ترا","بوی بهشت از اینجا نمی‌آید و اگر بخواهی بوی آن را حس کنی، باید به منبع آن، یعنی محلی که از آن بروز می‌کند، بروی."],[599,"هم‌چنین حب الوطن باشد درست","تو وطن بشناس ای خواجه نخست","عشق به وطن نیز حقیقی و درست است؛ بنابراین، ای آقای محترم، ابتدا وطن خود را بشناس و آن را ارزشمند بدار."],[599,"گفت آن ماهی زیرک ره کنم","دل ز رای و مشورتشان بر کنم","ماهی زیرک تصمیم می‌گیرد که دلش را از رای و مشورت دیگران جدا کند و به خود اعتماد کند."],[599,"نیست وقت مشورت هین راه کن","چون علی تو آه اندر چاه کن","در این بیت، مولانا به شنونده می‌گوید که وقت مشورت گرفتن گذشته است، پس باید فورا اقدام کند، مانند حضرت علی که به فکر و تدبیر او نیازی نیست و باید در دل به چیزی عمیق‌تر (مرشد یا حقیقت) فکر کند. اشاره به \"آه اندر چاه\" نماد جستجو و دعوت به درون‌نگری است."],[599,"محرم آن آه کم‌یابست بس","شب رو و پنهان‌روی کن چون عسس","تنها کسی که به آه و ناله درون خود آگاه است، کمیاب و نادر است و باید مانند عسس (نظمیه یا پلیس) شب‌رو و پنهان‌کار باشد، تا بتواند حقیقت خود را پنهان کند و از نگاه دیگران دور بماند."],[599,"سوی دریا عزم کن زین آب‌گیر","بحر جو و ترک این گرداب گیر","به سمت دریا برو و از این آب‌گنداب دوری کن؛ زیرا دریا پر از زندگی و منابع خوب است، در حالی که این جا به مانند گردابی است که تو را در خود غرق می‌کند."],[599,"سینه را پا ساخت می‌رفت آن حذور","از مقام با خطر تا بحر نور","سینه را به جایی که باعث باز شدن دل و روح است می‌برد و آن فرد با احساس حضور و درک خطر، به سمت دریای نور و روشنایی می‌رود."],[599,"هم‌چو آهو کز پی او سگ بود","می‌دود تا در تنش یک رگ بود","مانند آهو که وقتی سگ به دنبالش باشد، سریع می‌دود و در تلاش است تا جان سالم به در ببرد، انسان نیز گاهی از خطرات و تهدیدات به شدت می‌گریزد تا زندگی‌اش حفظ شود."],[599,"خواب خرگوش و سگ اندر پی خطاست","خواب خود در چشم ترسنده کجاست","کسی که در پی چیزی می‌دود مانند خرگوشی است که در خوابش، سگ آن را دنبال می‌کند. در واقع خواب خرگوش و سگ در پی خطا است و این نشان می‌دهد که فرد ترسیده و در حالت بی‌خبری به سر می‌برد. خوابش باید در چشم کسی باشد که در ترس زندگی می‌کند."],[599,"رفت آن ماهی ره دریا گرفت","راه دور و پهنه پهنا گرفت","ماهی به سمت دریا روانه شد و مسیر طولانی و وسیعی را به سوی دریا طی کرد."],[599,"رنجها بسیار دید و عاقبت","رفت آخر سوی امن و عافیت","او در زندگی سختی‌ها و رنج‌های زیادی را تحمل کرد، اما در نهایت به سوی امنیت و آرامش روی آورد."],[599,"خویشتن افکند در دریای ژرف","که نیابد حد آن را هیچ طرف","شخصی خود را در دریاهای عمیق و بی‌پایانی انداخت که هیچ نهایتی ندارد و نمی‌تواند به کناره یا اطراف آن دست یابد."],[599,"پس چو صیادان بیاوردند دام","نیم‌عاقل را از آن شد تلخ کام","وقتی صیادان دام را به قید و بند یک آدم نادان آوردند، آن شخص به خاطر این فریب دچار ناامیدی و تلخی گشت."],[599,"گفت اه من فوت کردم فرصه را","چون نگشتم همره آن رهنما","او می‌گوید آه، من فرصت را از دست دادم، چون نتوانستم همراه آن راهنما باشم."],[599,"ناگهان رفت او ولیکن چونک رفت","می‌ببایستم شدن در پی بتفت","ناگهان او رفت، اما وقتی که رفت، من باید به دنبالش می‌رفتم، و این احساس نیاز به او را در خود داشتم."],[599,"بر گذشته حسرت آوردن خطاست","باز ناید رفته یاد آن هباست","حسرت خوردن بر گذشته و چیزهایی که از دست رفته، اشتباه است، زیرا آنچه رفته، دیگر برنمی‌گردد و تنها یادآوری آن، بی‌فایده است."],[600,"آن یکی مرغی گرفت از مکر و دام","مرغ او را گفت ای خواجه همام","مرغی که در دام گرفتار شده، به صاحبش که رئیس و بزرگ‌منش است، می‌گوید."],[600,"تو بسی گاوان و میشان خورده‌ای","تو بسی اشتر به قربان کرده‌ای","تو بسیاری از گاوان و میش‌ها را قربانی کرده‌ای و بسیاری از شترها را به عنوان قربانی آماده کرده‌ای."],[600,"تو نگشتی سیر زانها در زمن","هم نگردی سیر از اجزای من","تو هرگز از خوردن آن خوراک‌ها سیر نشده‌ای و در آینده هم از اجزای وجود من سیر نخواهی شد."],[600,"هل مرا تا که سه پندت بر دهم","تا بدانی زیرکم یا ابلهم","من تو را دعوت می‌کنم تا سه نصیحت به تو بگویم تا بدانی آیا زیرک هستی یا احمق."],[600,"اول آن پند هم در دست تو","ثانیش بر بام کهگل بست تو","اولین پند به تو روشن است و در دست تو قرار دارد، اما پند دوم در جایی بالاتر، بر بام، به تو داده می‌شود که در آنجا گل کم‌عمق و پوشیده‌ای وجود دارد."],[600,"وآن سوم پندت دهم من بر درخت","که ازین سه پند گردی نیکبخت","سومین پندی که به تو می‌دهم این است که به درخت ایمان بیاوری؛ چون با عمل به این سه نکته می‌توانی خوشبخت شوی."],[600,"آنچ بر دستست اینست آن سخن","که محالی را ز کس باور مکن","آنچه در دست تو است، همین است که می‌گوید؛ به هیچ‌کس اعتماد نکن که چیزی ناممکن را باور کند."],[600,"بر کفش چون گفت اول پند زفت","گشت آزاد و بر آن دیوار رفت","وقتی که او اولا نصیحتی کرد، او به شدت تحت تأثیر قرار گرفت و سپس آزاد شد و بر آن دیوار رفت."],[600,"گفت دیگر بر گذشته غم مخور","چون ز تو بگذشت زان حسرت مبر","نگران گذشته نباش و حسرت نخور، چون چیزی که از تو گذشت، دیگر به دست تو نمی‌آید."],[600,"بعد از آن گفتش که در جسمم کتیم","ده درمسنگست یک در یتیم","او بعد از آن گفت که در بدن من، ده در وجود دارم که یکی از آن‌ها اوتی (یتیم) است و به دیگران وابسته نیست. این یتیم نمایانگر حالتی از وجود اوست که مستقل و بی‌نیاز از دیگران است."],[600,"دولت تو بخت فرزندان تو","بود آن گوهر به حق جان تو","دولت و خوشبختی فرزندان تو برای تو بوده است، همان‌طور که آن گوهر (حیات و ارزش) حقیقت وجود تو است."],[600,"فوت کردی در که روزی‌ات نبود","که نباشد مثل آن در در وجود","تو در روزهایی که نمی‌توانستی در وجود داشته باشی، فوت نکردی، زیرا هرگز روزی مانند آن در عالم وجود نخواهد بود."],[600,"آنچنان که وقت زادن حامله","ناله دارد خواجه شد در غلغله","مثل این‌که در زمان زایمان، زن حامله صدای ناله دارد، خواجه نیز در آن آشفتگی و هیاهو به سر می‌برد."],[600,"مرغ گفتش نی نصیحت کردمت","که مبادا بر گذشته دی غمت","مرغ به خویش می‌گوید که من به تو نصیحت کردم که نگران گذشته و غم‌های دیروز نباشی."],[600,"چون گذشت و رفت غم چون می‌خوری","یا نکردی فهم پندم یا کری","وقتی که غم و اندوهی از گذشته دیگر بر تو گذشته و رفته، چرا هنوز به آن فکر می‌کنی؟ یا اینکه آیا پند و نصیحت مرا نپذیرفتی یا اینکه نمی‌شنوی؟"],[600,"وان دوم پندت بگفتم کز ضلال","هیچ تو باور مکن قول محال","دومین نصیحتی که به تو می‌کنم این است که از گمراهی و انحراف دوری کن و هیچ‌گاه به سخنان غیرممکن و خیالی باور نداشته باش."],[600,"من نیم خود سه درمسنگ ای اسد","ده درمسنگ اندرونم چون بود","من مرغ، کلا سه درم‌سنگ (وزن) ندارم. چطور ممکن است مرواریدی به وزن ده درم‌سنگ در شکم من جا شده باشد"],[600,"خواجه باز آمد به خود گفتا که هین","باز گو آن پند خوب سیومین","خواجه پس از آن که به هوش آمد، به خود گفت: حالا بگو آن پند خوب سوم را که به من یاد داده‌ای."],[600,"گفت آری خوش عمل کردی بدان","تا بگویم پند ثالث رایگان","او گفت: آری، تو به کارهای نیک عمل کردی، بنابراین من هم می‌توانم بدون هیچ هزینه‌ای، پند سومی را به تو بگویم."],[600,"پند گفتن با جهول خوابناک","تخم افکندن بود در شوره خاک","نکته‌های اخلاقی گفتن به انسان‌های جاهل و نادان، مانند پاشیدن دانه‌ها در خاکی نامناسب و شوره‌زار است که نتیجه‌ای نخواهد داشت."],[600,"چاک حمق و جهل نپذیرد رفو","تخم حکمت کم دهش ای پندگو","جهل و نادانی مانند پارگی‌ است که هیچ‌گاه ترمیم نمی‌شود؛ بنابراین تو ای پنددهنده، به آنها حکمت و دانایی زیادی نده، چراکه پذیرای آن نیستند."],[601,"گفت ماهی دگر وقت بلا","چونک ماند از سایه عاقل جدا","ماهی گفت: وقتی بلا و مشکل پیش می‌آید، چطور باید از سایه عاقل و خرد جدا بمانم؟"],[601,"کو سوی دریا شد و از غم عتیق","فوت شد از من چنان نیکو رفیق","ماهی به دریا رفت و از غم‌های دیرینه‌اش فارغ شد، در واقع او به خاطر دوست خوبش که از دست رفته بود، در حزن و افسردگی بود."],[601,"لیک زان نندیشم و بر خود زنم","خویشتن را این زمان مرده کنم","اما من به این فکر نمی‌کنم و به خود آسیب می‌زنم و در این لحظه خود را مانند مرده می‌کنم."],[601,"پس برآرم اشکم خود بر زبر","پشت زیر و می‌روم بر آب بر","سپس اشک‌هایم را بر روی زمین می‌ریزم و به سمت آب می‌روم."],[601,"می‌روم بر وی چنانک خس رود","نی بسباحی چنانک کس رود","من به سمت او می‌روم، مانند ساقه‌ی نازک نی که در آب حرکت می‌کند، به آرامی و بی‌صدا، همانند کسی که در آب می‌رود."],[601,"مرده گردم خویش بسپارم به آب","مرگ پیش از مرگ امنست از عذاب","من خود را باید به آب بسپارم و بمیرم، چون مرگ پیش از مرگ انسان را از عذاب نجات می‌دهد."],[601,"مرگ پیش از مرگ امنست ای فتی","این چنین فرمود ما را مصطفی","مرگ قبل از مرگ، از عذاب‌ها ای جوان، امن‌تر است؛ این سخنی است که پیامبر، مصطفی (ص)، به ما گفته است."],[601,"گفت موتواکلکم من قبل ان","یاتی الموت تموتوا بالفتن","پیامبر (مصطفی) فرمود: پیش از آنکه مرگ بیاید، شما باید بمیرید؛ یعنی باید از تعلقات دنیوی و دنیاپرستی رها شوید تا به حقیقت و معنویت برسید."],[601,"هم‌چنان مرد و شکم بالا فکند","آب می‌بردش نشیب و گه بلند","انسان در وضعیتی قرار دارد که در ظاهر مرده به نظر می‌رسد اما همچنان شکمش در حال بزرگ شدن است. آب او را به سمت پایین و بالا می‌برد، به این معنا که او در میان وضعیت‌های مختلف در حال نوسان است."],[601,"هر یکی زان قاصدان بس غصه برد","که دریغا ماهی بهتر بمرد","هر یک از آن قاصدها به شدت ناراحت شدند و غصه خوردند که ای کاش آن ماهی زنده می‌ماند و می‌توانست بهتر زندگی کند."],[601,"شاد می‌شد او کز آن گفت دریغ","پیش رفت این بازیم رستم ز تیغ","او از اینکه دوستانش نسبت به مرگ یک ماهی غصه‌دار شده بودند، شاد می‌شد و این را به حساب می‌آورد که رستم (قهرمان اسطوره‌ای) برایش داستانی می‌سازد که روی تیغ‌ها می‌جنگد."],[601,"پس گرفتش یک صیاد ارجمند","پس برو تف کرد و بر خاکش فکند","پس یکی صیاد با ارزش او را گرفت و سپس او را بیرون آورد و بر زمین انداخت."],[601,"غلط غلطان رفت پنهان اندر آب","ماند آن احمق همی‌کرد اضطراب","انسان نادان و احمق در حالی که در آب پنهان شده است، به شدت نگران و مضطرب است و نمی‌داند چگونه از این وضعیت خارج شود."],[601,"از چپ و از راست می‌جست آن سلیم","تا بجهد خویش برهاند گلیم","آن آدم ناپخته (احمق) از هر سمتی به دنبال راهی بود تا خودش را نجات دهد و از این وضعیت سخت خارج گردد."],[601,"دام افکندند و اندر دام ماند","احمقی او را در آن آتش نشاند","احمق به دام افتاد و در دام گرفتار شد و او را در آتش نشاندند، به این معنی که به واسطه نادانی و حماقتش به خطر افتاده و در شرایط بدی قرار گرفت."],[601,"بر سر آتش به پشت تابه‌ای","با حماقت گشت او همخوابه‌ایی","مرد حماقتی بر روی آتش قرار گرفت و به خاطر نادانی‌اش در آن‌جا به خواب رفت و در اثر آتش، در معرض خطر قرار گرفت."],[601,"او همی جوشید از تف سعیر","عقل می‌گفتش الم یاتک نذیر","او به خاطر حرارت آتش که عقلش را به جوش آورده بود، به تذکر و یادآوری این فکر کرد که آیا به تو هشداردهنده‌ای نیامده است؟"],[601,"او همی‌گفت از شکنجه وز بلا","هم‌چو جان کافران قالوا بلی","او (ماهی نیم‌عاقل) می‌گفت که از زجر و مصیبت رنج می‌برد و مانند جان کافران که در روز قیامت می‌گویند «آری» (به عذاب دادن) است."],[601,"باز می‌گفت او که گر این بار من","وا رهم زین محنت گردن‌شکن","او دوباره می‌گفت که اگر این بار من از زیر بار این درد و رنج طاقت‌فرسا آزاد شوم، به من فشار زیادی خواهد آمد."],[601,"من نسازم جز به دریایی وطن","آبگیری را نسازم من سکن","من به هیچ‌وجه نمی‌توانم جز در دریایی، یعنی در جایی که می‌توانم به راحتی زندگی کنم، زندگی‌ام را تشکیل دهم و خانه‌ام را بسازم."],[601,"آب بی‌حد جویم و آمن شوم","تا ابد در امن و صحت می‌روم","من در جست‌وجوی آبی بی‌پایان هستم تا ایمن شوم و همواره در آرامش و سلامتی زندگی کنم."],[602,"عقل می‌گفتش حماقت با توست","با حماقت عقل را آید شکست","عقل به او می‌گوید که حماقت در پی‌اش است و با این حماقت، عقل نیز شکست خواهد خورد."],[602,"عقل را باشد وفای عهدها","تو نداری عقل رو ای خربها","عقل به وفای عهد و پیمان‌های خود پایبند است، اما تو که حماقت را در پیش گرفته‌ای، هیچ وفایی در تو وجود ندارد."],[602,"عقل را یاد آید از پیمان خود","پرده نسیان بدراند خرد","عقل باید به یاد آورد پیمان‌هایی که بسته، اما نسیان (فراموشی) مانع آن می‌شود و خرد را از یاد می‌برد."],[602,"چونک عقلت نیست نسیان میر تست","دشمن و باطل کن تدبیر تست","وقتی که عقل و خردت خاموش است، از یاد می‌برند آنچه را که باید به خاطر داشته باشی، به همین دلیل دشمن و فریبکاری وجود دارد که نقشه‌های تو را باطل می‌کند."],[602,"از کمی عقل پروانه خسیس","یاد نارد ز آتش و سوز و حسیس","به دلیل کم‌عقلی، پروانه احمق به یاد نمی‌آورد که چگونه از آتش و سوز رنج می‌کشد."],[602,"چونک پرش سوخت توبه می‌کند","آز و نسیانش بر آتش می‌زند","آنگاه که پروانه در آتش می‌سوزد، توبه می‌کند و به یاد می‌آورد که فراموشی و خصلت طمعش دوباره او را به سوی آتش می‌کشاند."],[602,"ضبط و درک و حافظی و یادداشت","عقل را باشد که عقل آن را فراشت","عقل توانایی فهم و حفظ را دارد، و این وظیفه اوست که این مفاهیم را درک کند و نگهداری کند."],[602,"چونک گوهر نیست تابش چون بود","چون مذکر نیست ایابش چون بود","اگر چیزی در خود گوهر و ارزش نداشته باشد، نمی‌تواند درخشندگی و تابش واقعی داشته باشد؛ همان‌طور که اگر چیزی مذکر نباشد، نمی‌تواند بازگشت و جاذبه‌ای داشته باشد."],[602,"این تمنی هم ز بی‌عقلی اوست","که نبیند کان حماقت را چه خوست","این آرزو و خواسته هم ناشی از بی‌عقلی اوست که نمی‌بیند این حماقت به چه دردش می‌خورد."],[602,"آن ندامت از نتیجه رنج بود","نه ز عقل روشن چون گنج بود","ندامت و پشیمانی تنها نتیجه رنج و درد برای اوست و از عقل و درک درست او ناشی نمی‌شود؛ به عبارت دیگر، پشیمانی هیچ ارزشی ندارد وقتی که عقل در کار نبوده است."],[602,"چونک شد رنج آن ندامت شد عدم","می‌نیرزد خاک آن توبه و ندم","وقتی که رنج و درد به وجود می‌آید، ندامت هم از بین می‌رود و به هیچ چیز نمی‌ارزد؛ مانند توبه و پشیمانی که به خاطر خاک و بی‌ارزش است."],[602,"آن ندم از ظلمت غم بست بار","پس کلام اللیل یمحوه النهار","ندامت و پشیمانی از غم، به انسان بار سنگینی می‌دهد؛ اما شب با همه‌ی تیرگی‌اش، با آمدن روز روشن می‌شود و به مرور محو می‌شود."],[602,"چون برفت آن ظلمت غم گشت خوش","هم رود از دل نتیجه و زاده‌اش","زمانی که غم و ظلمات از دل انسان برطرف می‌شود، شادی و سرزندگی به قلب او باز می‌گردد و آثار خوب آن نیز در زندگی‌اش نمایان می‌شود."],[602,"می‌کند او توبه و پیر خرد","بانگ لو ردوا لعادوا می‌زند","او (شخصی که در حال توبه است) توبه می‌کند و پیر خرد (دانا) فریاد می‌زند که اگر به گذشته برگردند، دوباره به همان خطاها برمی‌گردند."],[603,"عقل ضد شهوتست ای پهلوان","آنک شهوت می‌تند عقلش مخوان","عقل در مقابل شهوت قرار دارد، ای پهلوان. کسی که به دنبال شهوت برود، نمی‌تواند او را دارای عقل بداند."],[603,"وهم خوانش آنک شهوت را گداست","وهم قلب نقد زر عقلهاست","وهم همچون شهوت، گدا و فقیر است و نمی‌تواند چیز باارزشی را به‌دست آورد. در مقابل، قلب عقل مانند نقد زر است که ارزش واقعی را مشخص می‌کند."],[603,"بی‌محک پیدا نگردد وهم و عقل","هر دو را سوی محک کن زود نقل","وهم و عقل قابل شناسایی نیستند مگر با یک معیار، بنابراین به سرعت هر دو را به سمت آن معیار ارجاع بده."],[603,"این محک قرآن و حال انبیا","چون محک مر قلب را گوید بیا","محک در اینجا به معنای معیاری است که قرآن و حالات پیامبران مانند معیاری برای سنجش دل و عقل عمل می‌کند؛ بنابراین، از ما می‌خواهد که به این معیار توجه کنیم."],[603,"تا ببینی خویش را ز آسیب من","که نه‌ای اهل فراز و شیب من","برای شناختن خودت و آسیب‌هایی که از من دیده‌ای، باید متوجه شوی که تو نه از مرتبه بالا و نه از مرتبه پایین هستی."],[603,"عقل را گر اره‌ای سازد دو نیم","هم‌چو زر باشد در آتش او بسیم","اگر عقل را مثلا با اره‌ای دو نیم کنیم، مانند طلا در آتش، به آن لطمه می‌زند و به شکل جدیدی در نمی‌آید، بلکه مخصوصیت خود را از دست می‌دهد."],[603,"وهم مر فرعون عالم‌سوز را","عقل مر موسی به جان افروز را","وهم، یعنی خیال و تصور نادرست، برای فرعون که عالم‌سوز است مایه نابودی و عذاب است، ولی عقل موسی که روشن و حیات‌بخش است، جان او را نورانی کرده و از روشنی می‌بخشد."],[603,"رفت موسی بر طریق نیستی","گفت فرعونش بگو تو کیستی","موسی بر مسیر فنا و عدم گام برداشت و فرعون به او گفت: تو کی هستی؟"],[603,"گفت من عقلم رسول ذوالجلال","حجةالله‌ام امانم از ضلال","موسی در پاسخ فرعون می‌گوید که من عقل هستم و نماینده خداوند (ذوالجلال) هستم. من حجت خدا هستم و از گمراهی و انحراف محفوظم."],[603,"گفت نی خامش رها کن های هو","نسبت و نام قدیمت را بگو","موسی به فرعون می‌گوید که از خاموشی دست بردارد و او را به شناخت و اعلام نام حقیقی‌اش، که نشانه عظمتش است، دعوت می‌کند."],[603,"گفت که نسبت مر از خاکدانش","نام اصلم کمترین بندگانش","او گفت که نسبتی که من از خاک و مادرم دارم، نام آبا و اجدادی‌ام، من را به کمترین بندگان (مخلوقات) آن خداوند مرتبط می‌کند."],[603,"بنده‌زاده آن خداوند وحید","زاده از پشت جواری و عبید","این بیت به این موضوع اشاره دارد که بنده‌ای که به خداوند یگانه مرتبط است، زاده انسان‌های معمولی و تحت تأثیر عادات و وابستگی‌ها نیست. بنده‌زاده خداوند به خودی خود ارزش و مقام بالایی دارد و وابسته به زادگاه یا شرایط اجتماعی والدینش نیست."],[603,"نسبت اصلم ز خاک و آب و گل","آب و گل را داد یزدان جان و دل","منشأ آفرینش من از خاک و آب و گل است، اما خداوند جان و دل را از این مواد به من عطا کرده است."],[603,"مرجع این جسم خاکم هم به خاک","مرجع تو هم به خاک ای سهمناک","بدن من از خاک تشکیل شده و در نهایت به همان خاک بازمی‌گردد. تو نیز که به سهم خود، از خاک هستی، همین سرنوشت را خواهی داشت."],[603,"اصل ما و اصل جمله سرکشان","هست از خاکی و آن را صد نشان","ماهیت و سرشت اصلی ما و همه ستمگران از خاک است و این حقیقت، نشانه‌های زیادی دارد."],[603,"که مدد از خاک می‌گیرد تنت","از غذایی خاک پیچد گردنت","بدن تو از خاک نشأت گرفته و برای زنده ماندن به مواد غذایی خاک نیاز دارد، بنابراین همواره در ارتباط با خاک هستی و این ارتباط به تو شکل می‌دهد."],[603,"چون رود جان می‌شود او باز خاک","اندر آن گور مخوف سهمناک","زمانی که جان انسان به سمت آسمان و تعالی می‌رود، دوباره به خاک و گور ترسناک برمی‌گردد و سرانجام همه چیز به خاک ختم می‌شود."],[603,"هم تو و هم ما و هم اشباه تو","خاک گردند و نماند جاه تو","همه ما، از جمله تو و کسانی که به تو شباهت دارند، در نهایت به خاک تبدیل می‌شوند و مقام و اعتبار تو در این دنیا باقی نخواهد ماند."],[603,"گفت غیر این نسب نامیت هست","مر ترا آن نام خود اولیترست","گفتند که غیر از این نسب، هیچ‌چیز دیگری تو را مشهور و شناخته نمی‌کند و نامی که داری به خود تو مربوط است و به آن شایسته‌تر هستی."],[603,"بنده فرعون و بنده بندگانش","که ازو پرورد اول جسم و جانش","بنده‌ای که فرعون و کارگزارانش را خدمت می‌کند، در حقیقت به وجود جسم و جان خود وابسته است که از پرورش فرعون نشأت گرفته است."],[603,"بنده یاغی طاغی ظلوم","زین وطن بگریخته از فعل شوم","بنده‌ای ستمگر و طغیان‌گر که از این سرزمین به خاطر اعمال بدش فرار کرده است."],[603,"خونی و غداری و حق‌ناشناس","هم برین اوصاف خود می‌کن قیاس","اگر با این اوصاف، یعنی خون‌ریزی، خیانت و ناشناسی حق، خود را مقایسه کنی، به ماهیت واقعیت خود پی می‌بری."],[603,"در غریبی خوار و درویش و خلق","که ندانستی سپاس ما و حق","در میان غریبی، انسان‌ها و بی‌پول‌ها مورد بی‌احترامی قرار می‌گیرند و خلق (مردم) سپاسگزاری و حقیقت ما را نمی‌شناسند."],[603,"گفت حاشا که بود با آن ملیک","در خداوندی کسی دیگر شریک","موسی علیه‌السلام می‌گوید: هرگز ممکن نیست کسی غیر از خداوند با آن پادشاه بزرگ (فرعون) در مقام خداوندی شریک باشد."],[603,"واحد اندر ملک او را یار نی","بندگانش را جز او سالار نی","تنها اوست که در حکومت خویش یاری ندارد و بندگانش هیچ سرپرست دیگری جز او ندارند."],[603,"نیست خلقش را دگر کس مالکی","شرکتش دعوی کند جز هالکی","هیچ موجودی غیر از خداوند مالک و سرپرست خلق نیست و هر کس غیر از او ادعای مالکیت و سرپرستی کند، در حقیقت دروغ می‌گوید و ظلم‌جو است."],[603,"نقش او کردست و نقاش من اوست","غیر اگر دعوی کند او ظلم‌جوست","نقش او را او کشیده و خودش نقاش است؛ اگر کسی غیر از او ادعای نقاشی کند، به معنای ظلم و ستم است."],[603,"تو نتانی ابروی من ساختن","چون توانی جان من بشناختن","تو نمی‌توانی با ظاهر من را تحت تأثیر قرار دهی، زیرا تو نمی‌توانی به عمق وجود من و روح من پی ببری."],[603,"بلک آن غدار و آن طاغی توی","که کنی با حق دعوی دوی","تو ای طاغی و خیانتکار، تنها کسی هستی که با حق دروغ می‌گویی و ادعای دوگانگی می‌کنی."],[603,"گر بکشتم من عوانی را به سهو","نه برای نفس کشتم نه به لهو","اگر من کسی را به سهو و اشتباه بکشم، این کار را نه برای هوس و نفس‌پرستی کرده‌ام و نه به خاطر تفریح و بازی."],[603,"من زدم مشتی و ناگاه اوفتاد","آنک جانش خود نبد جانی بداد","من ضربه‌ای زدم و ناگهان آن شخص از پای درآمد، در حالی که جان او در واقع جان خود او نبوده و او جانش را تقدیم کرده است."],[603,"من سگی کشتم تو مرسل‌زادگان","صدهزاران طفل بی‌جرم و زیان","من سگی را کشتم، اما تو که فرزند پیامبری، مسئول کشتن یا زجر دادن صد هزار کودک بی‌گناه و بدون گناه هستی."],[603,"کشته‌ای و خونشان در گردنت","تا چه آید بر تو زین خون خوردنت","تو بچه‌های بی‌گناهی را کشته‌ای و حالا بار سنگین این خون به گردن تو افتاده و باید ببینی عاقبت این کار و عواقب آن چه بر سر تو خواهد آورد."],[603,"کشته‌ای ذریت یعقوب را","بر امید قتل من مطلوب را","تو در واقع یعقوب (نبی بنی‌اسرائیل) را کشته‌ای و امیدوار به این هستی که من (موسی) کشته شوم و خواسته‌ات برآورده شود."],[603,"کوری تو حق مرا خود برگزید","سرنگون شد آنچ نفست می‌پزید","تو به دلیل کوری خود، حق من را انتخاب نکردی و به همین دلیل، آنچه نفس تو در پی آن بود به شکست انجامید."],[603,"گفت اینها را بهل بی‌هیچ شک","این بود حق من و نان و نمک","گفت این مطالب را رها کن، هیچ شکی در این نیست که این حق من است و نان و نمکی که بین ماست، نشانه‌ای از این حقیقی بودن است."],[603,"که مرا پیش حشر خواری کنی","روز روشن بر دلم تاری کنی","با من در روز قیامت، با تحقیر و خواری رفتار می‌کنی و در روز روشن، دل مرا تیره و تار می‌کنی."],[603,"گفت خواری قیامت صعب‌تر","گر نداری پاس من در خیر و شر","اگر در روز قیامت آبروریزی و خواری برایت سخت‌تر از هر چیز است، باید از اعمال خود در دنیا مراقبت کنی و پاس آنچه در خیر و شر انجام می‌دهی را بدهی."],[603,"زخم کیکی را نمی‌تانی کشید","زخم ماری را تو چون خواهی چشید","زخمی که از کیک به وجود می‌آید (زخمی سطحی و کم‌عمق) را نمی‌توان با زخم مار (زخمی خطرناک و عمیق) مقایسه کرد؛ چرا که زخم مار عواقب وخیمی دارد و نباید آن را نادیده گرفت."],[603,"ظاهرا کار تو ویران می‌کنم","لیک خاری را گلستان می‌کنم","به ظاهر، به نظر می‌رسد که من در حال نابود کردن کار تو هستم، اما در واقع من با ایجاد مشکل (خاری) تو، در حال شکوفا کردن زیبایی (گلستان) هستم."],[604,"آن یکی آمد زمین را می‌شکافت","ابلهی فریاد کرد و بر نتافت","یکی از افراد در حال خراب کردن زمین بود، که شخصی بی‌خود و نادان فریاد زد و این کار را نپذیرفت."],[604,"کین زمین را از چه ویران می‌کنی","می‌شکافی و پریشان می‌کنی","چرا این زمین را خراب و ویران می‌کنی و به هم می‌زنی؟"],[604,"گفت ای ابله برو و بر من مران","تو عمارت از خرابی باز دان","ای نادان، از من دور شو و مزاحم‌ام نشو، زیرا تو باید بفهمی که ساختن و آباد کردن (عمارت) از ویرانی و خراب شدن ناشی می‌شود."],[604,"کی شود گلزار و گندم‌زار این","تا نگردد زشت و ویران این زمین","تا این زمین ویران و زشت نشود، چه زمانی گلزار و مزار گندم پدیدار خواهد شد؟"],[604,"کی شود بستان و کشت و برگ و بر","تا نگردد نظم او زیر و زبر","بستان، زمین زراعت و سبز و سرسبز نمی‌شود و وضعیت آن درست نمی‌گردد تا زمانی که نظم و ترتیبی که دارد به هم نریزد و به هم بخورد."],[604,"تا بنشکافی به نشتر ریش چغز","کی شود نیکو و کی گردید نغز","برای اینکه چغز (نوعی گیاه یا علف) به خوبی خوب و زیبا شود، باید آن را با تیغ یا نشتر ببرند یا شکافند. در واقع، توضیح می‌دهد که برای دستیابی به زیبایی و کمال، گاهی لازم است مشکلات و دردها را تحمل کرد."],[604,"تا نشوید خلطهاات از دوا","کی رود شورش کجا آید شفا","تا زمانی که آلودگی‌ها و ترکیب‌های نامناسب از دارویی پاک نشود، از کجا بیماری‌ها برطرف خواهد شد و شفا به دست خواهد آمد؟"],[604,"پاره پاره کرده درزی جامه را","کس زند آن درزی علامه را","هیچ‌کس نمی‌تواند درز جامه‌ای را که پاره‌پاره شده، دوخته و اصلاح کند. درزی که این کار را می‌کند، باید یک علامه و استاد باشد."],[604,"که چرا این اطلس بگزیده را","بردریدی چه کنم بدریده را","چرا این پارچه نفیس و گرانبها را پاره کردی؟ با این حال، من با پارچه پاره شده چه کنم؟"],[604,"هر بنای کهنه که آبادان کنند","نه که اول کهنه را ویران کنند","برای آباد کردن هر بنای کهنه، لازم است که ابتدا آن را ویران نکنند و نگذارند خراب شود. در واقع، نباید ساختمان قدیمی را تخریب کرد تا برای نو کردن آن اقدام شود."],[604,"هم‌چنین نجار و حداد و قصاب","هستشان پیش از عمارتها خراب","نجار، حداد و قصاب نیز پیش از آنکه بناها را بسازند، خرابکاری می‌کنند. به این معناست که پیشرفت و ساختن مستلزم تخریب چیزهایی است که قبلا وجود داشته‌اند."],[604,"آن هلیله و آن بلیله کوفتن","زان تلف گردند معموری تن","فرآورده‌های خوشبو مثل هلیله (دارویی) و بلیله (نوعی میوه) که برای سلامتی بدن مفید هستند، هنگامی که به مقدار زیاد و بی‌رویه مورد استفاده قرار بگیرند، موجب آسیب و ضعف بدن می‌شوند و از این رو زندگی تن را ویران می‌کنند."],[604,"تا نکوبی گندم اندر آسیا","کی شود آراسته زان خوان ما","تا وقتی که گندم را در آسیا نکوبی و نرکوبی، آن خوان ما (سفره ما) چگونه می‌تواند آماده و مرتب شود؟"],[604,"آن تقاضا کرد آن نان و نمک","که ز شستت وا رهانم ای سمک","او از سمک (ماهی) تقاضا کرد که نان و نمک را به او بدهد تا بتواند از آلودگی شست (دست) او را نجات دهد."],[604,"گر پذیری پند موسی وا رهی","از چنین شست بد نامنتهی","اگر پند موسی را بپذیری و از این شست بد و بدنام رهایی یابی، به آرزو و هدف خود خواهی رسید."],[604,"بس که خود را کرده‌ای بنده هوا","کرمکی را کرده‌ای تو اژدها","به خاطر اینکه خود را زیر سلطه تمایلات و خواسته‌های نفسانی‌ات قرار داده‌ای، در حقیقت خود را مثل کرمکی کوچک در نظر گرفته‌ای، در حالی که می‌توانی مانند اژدهایی قدرتمند و بزرگ باشی."],[604,"اژدها را اژدها آورده‌ام","تا به اصلاح آورم من دم به دم","من به اژدها (کسی بزرگ و خطرناک) آمده‌ام تا او را اصلاح کنم و بهبود دهم، به تدریج و به آرامی."],[604,"تا دم آن از دم این بشکند","مار من آن اژدها را بر کند","اگر دم یکی از دو مار شکسته شود، اژدها که دشمن من است، نابود خواهد شد."],[604,"گر رضا دادی رهیدی از دو مار","ورنه از جانت برآرد آن دمار","اگر به رضایت خود زندگی کنی، می‌توانی از این دو خطر رهایی یابی، وگرنه آن دو مار (خطرات) جانت را می‌گیرند و به هلاکت می‌رسانند."],[604,"گفت الحق سخت استا جادوی","که در افکندی به مکر اینجا دوی","حقیقت این است که جادوی تو بسیار نیرومند است و به زحمت می‌توان آن را درک کرد، زیرا تو با فریب و نیرنگی که به کار بردی، در این مکان دو گروه را به وجود آوردی."],[604,"خلق یک‌دل را تو کردی دو گروه","جادوی رخنه کند در سنگ و کوه","تو با جادوت باعث شدی که مردم یکدل به دو گروه تقسیم شوند؛ همان‌طور که جادو می‌تواند در سخت‌ترین چیزها مانند سنگ و کوه رخنه کند و آنها را دچار تغییر کند."],[604,"گفت هستم غرق پیغام خدا","جادوی کی دید با نام خدا","گفت من با پیغام خدا در عمق وجودم غرق شده‌ام و هر نوع جادوگری به واسطه نام خدا قادر به دیدن و درک من نیست."],[604,"غفلت و کفرست مایه جادوی","مشعله دینست جان موسوی","غفلت و نادانی و کفر، باعث می‌شود که انسان‌ها از نور و حقیقت دین دور شوند، در حالی که آگاهی و ایمان مانند جادویی است که جان موسی را زنده و بیدار می‌کند."],[604,"من به جادویان چه مانم ای وقیح","کز دمم پر رشک می‌گردد مسیح","من چه ارزشی برای جادوگران دارم ای بی‌شرم، در حالی که نفس من به قدری نورانی است که مسیح (ع) از آن خجالت می‌کشد."],[604,"من به جادویان چه مانم ای جنب","که ز جانم نور می‌گیرد کتب","من چه شباهتی به جادوگران دارم، ای جنب، زیرا کتاب‌ها از جانم نور می‌گیرند و روح پیدا می‌کنند."],[604,"چون تو با پر هوا بر می‌پری","لاجرم بر من گمان آن می‌بری","چون تو با اهل دنیا و ظاهربینان در حال پرواز و سرخوشی هستی، طبیعی است که درباره من هم همین نظر را خواهی داشت و من را نیز همانند خودت می‌پنداری."],[604,"هر کرا افعال دام و دد بود","بر کریمانش گمان بد بود","هر کس که اعمالش شبیه به حیوانات وحشی باشد، باید در مورد کریمان (آدم‌های بزرگوار و مهربان) برداشت منفی و بدی داشته باشد."],[604,"چون تو جزو عالمی هر چون بوی","کل را بر وصف خود بینی سوی","تو که بخشی از جهان هستی، هر چیزی را به شکل و رنگ خودت می‌بینی و تفسیر می‌کنی."],[604,"گر تو برگردی و بر گردد سرت","خانه را گردنده بیند منظرت","اگر تو به خود بازگردی و سر خود را هم به سوی خود برگردانی، خانه را به شکل گردنده‌ای خواهی دید که منظر آن تغییر کرده است."],[604,"ور تو در کشتی روی بر یم روان","ساحل یم را همی بینی دوان","اگر تو در کشتی باشی و بر آب روان حرکت کنی، به خاطر اینکه دریا به سمت ساحل می‌رود، تو نیز آن ساحل را در حال حرکت به سمت خودت می‌بینی."],[604,"گر تو باشی تنگ‌دل از ملحمه","تنگ بینی جمله دنیا را همه","اگر تو دلتنگ و ناراحت باشی از جنگ و درگیری، در نتیجه تمام دنیا را تنگ و محدود می‌بینی و بر زخم‌های خود تمرکز می‌کنی."],[604,"ور تو خوش باشی به کام دوستان","این جهان بنمایدت چون گلستان","اگر تو در کنار دوستانت خوشحال باشی، این دنیا برایت مانند یک باغ گل زیبا خواهد بود."],[604,"ای بسا کس رفته تا شام و عراق","او ندیده هیچ جز کفر و نفاق","بسیاری از مردم به شام و عراق سفر کرده‌اند، اما آن‌ها هیچ زیبایی غیر از کفر و نفاق ندیده‌اند و فقط با مشکلات آنجا روبه‌رو شده‌اند."],[604,"وی بسا کس رفته تا هند و هری","او ندیده جز مگر بیع و شری","بسیاری از افرادی که به هند و هری سفر کرده‌اند، جز تجارت و خرید و فروش چیزی ندیده‌اند."],[604,"وی بسا کس رفته ترکستان و چین","او ندیده هیچ جز مکر و کمین","بسیاری از افرادی که به سرزمین‌های دوری مانند ترکستان و چین سفر کرده‌اند، جز فریب و دسیسه چیزی ندیده‌اند و تنها با نیرنگ‌ها و تله‌ها مواجه شده‌اند."],[604,"چون ندارد مدرکی جز رنگ و بو","جمله اقلیمها را گو بجو","کسی که فقط به ظاهر و اشکال ظاهری (رنگ و بو) توجه دارد و مدرکی غیر از آن ندارد، نمی‌تواند درست درک کند و به شناختی از ویژگی‌های مختلف اقوام و سرزمین‌ها برسد."],[604,"گاو در بغداد آید ناگهان","بگذرد او زین سران تا آن سران","گاو به طور ناگهانی وارد بغداد می‌شود و از بین سران و مردان می‌گذرد و به سمت دیگر آنها می‌رود. این تصویر ممکن است به تغییر ناگهانی و غیرمنتظره‌ای اشاره داشته باشد که باعث می‌شود همه چیز تحت تأثیر قرار گیرد."],[604,"از همه عیش و خوشیها و مزه","او نبیند جز که قشر خربزه","انسان در زندگی نمی‌تواند از لذت‌ها و خوشی‌های واقعی بهره‌مند شود و تنها پوسته و ظاهری از آن‌ها را می‌بیند، مانند کسی که به قشر خربزه نگاه می‌کند اما طعم و خوشمزگی آن را نمی‌چشد."],[604,"که بود افتاده بر ره یا حشیش","لایق سیران گاوی یا خریش","شخصی که بر سر راه افتاده است، نمی‌تواند به خوبی از اوضاع اطرافش بهره‌برداری کند و او همچون علفی است که در زیر پاهای گاو یا الاغ قرار دارد و در برابر آنها قرار می‌گیرد."],[604,"خشک بر میخ طبیعت چون قدید","بسته اسباب جانش لا یزید","زندگی انسان، بی‌حرکت و بی‌تحرک، مانند چوب خشک شده‌ای است که به طبیعت و شرایط خود وابسته است و به همین دلیل نمی‌تواند از محدودیت‌هایش فراتر برود."],[604,"وان فضای خرق اسباب و علل","هست ارض الله ای صدر اجل","فضای آزاد و بی‌اساس که از علل و اسباب معمول جدا شده، به‌نوعی زمین خدا و بهترین جایگاه در این دنیا است."],[604,"هر زمان مبدل شود چون نقش جان","نو به نو بیند جهانی در عیان","هر لحظه روح انسان به گونه‌ای دگرگون می‌شود و او در هر دگرگونی، جهانی جدید و آشکار را مشاهده می‌کند."],[604,"گر بود فردوس و انهار بهشت","چون فسرده یک صفت شد گشت زشت","اگر در بهشت فردوس و نهرهای آن وجود داشته باشد، با وجود اینکه زیبا هستند، اگر از یک صفت خاص سرد شده و فاقد طراوت شوند، زشت و ناپسند به نظر می‌رسند."],[605,"چنبره دید جهان ادراک تست","پرده پاکان حس ناپاک تست","چشم‌انداز و تفکر تو درباره جهان، تحت تأثیر ادراکات حسی‌ات قرار دارد. این در حالی است که حواس پاکان (انسان‌های وارسته) از حس‌های ناپاک و غفلت دورند و آگاهی واقعی‌تری دارند."],[605,"مدتی حس را بشو ز آب عیان","این چنین دان جامه‌شوی صوفیان","مدتی حس را با آب آشکار بشوی، به این ترتیب که صوفی‌ها لباس‌های خود را می‌شویند. این اشاره دارد به اینکه باید حس را از دلبستگی‌های ظاهری و مادی پاکسازی کرد تا به حقیقت و درک عمیق‌تری رسید."],[605,"چون شدی تو پاک پرده بر کند","جان پاکان خویش بر تو می‌زند","وقتی که تو پاک شدی و پرده‌ها را کنار زدی، روح‌های پاک به سمت تو می‌آیند و با تو ارتباط برقرار می‌کنند."],[605,"جمله عالم گر بود نور و صور","چشم را باشد از آن خوبی خبر","اگر تمام عالم روشنایی و صورت باشد، چشم فقط از آن زیبایی آگاه است و درک می‌کند."],[605,"چشم بستی گوش می‌آری به پیش","تا نمایی زلف و رخساره به تیش","اگر چشمت را ببندی و فقط به صدا گوش دهی، آن‌گاه می‌خواهی زلف و چهره‌ای را ببینی که وجود ندارد."],[605,"گوش گوید من به صورت نگروم","صورت ار بانگی زند من بشنوم","گوش می‌گوید که من در حالتی هستم که به چیزهای ظاهری نگاه می‌کنم، ولی اگر صدایی از آن شکل‌ها برآید، من آن صدا را می‌شنوم."],[605,"عالمم من لیک اندر فن خویش","فن من جز حرف و صوتی نیست بیش","من عالم هستم، اما در زمینه تخصص خود فقط به کلام و صدا محدودم و چیز دیگری نیست."],[605,"هین بیا بینی ببین این خوب را","نیست در خور بینی این مطلوب را","بیا و خوب را ببین، چون این خوب برای تو قابل دیدن نیست و مناسب فهم تو نیست."],[605,"گر بود مشک و گلابی بو برم","فن من اینست و علم و مخبرم","اگر مشک و گلابی وجود داشته باشد، بویی از آن‌ها می‌برم؛ چون این مهارت و دانش من است و از آن آگاه هستم."],[605,"کی ببینم من رخ آن سیم‌ساق","هین مکن تکلیف ما لیس یطاق","من نمی‌توانم چهره‌ی آن شخص زیبا را ببینم؛ لطفا به من چیزی نگو که فراتر از تحمل من است."],[605,"باز حس کژ نبیند غیر کژ","خواه کژ غژ پیش او یا راست غژ","حس نادرست تنها نادرست‌ها را می‌بیند و نمی‌تواند چیزهای درست را تشخیص دهد؛ بنابراین، اگر چیزی را نادرست ببیند، نمی‌تواند آن را درست تلقی کند."],[605,"چشم احول از یکی دیدن یقین","دانک معزولست ای خواجه معین","چشم افراد نابینا یا کم‌نور فقط می‌تواند یک چیز را به درستی ببیند و در نتیجه همه حقیقت را از دست می‌دهد. مولانا به این نکته اشاره می‌کند که چنین محدودیتی باعث می‌شود که آن فرد از درک واقعیات محروم شود."],[605,"تو که فرعونی همه مکری و زرق","مر مرا از خود نمی‌دانی تو فرق","تو که مانند فرعون (خودخواه و مغرور) هستی که همه‌جا در فریب و نیرنگ زندگی می‌کند، تو از حقیقت وجود من بی‌خبری و تفاوت من را با خود نمی‌توانی درک کنی."],[605,"منگر از خود در من ای کژباز تو","تا یکی تو را نبینی تو دوتو","به کسی که از خودخواهی دچار انحراف شده، می‌گوید که به من نگاه نکن و به خودت مشغول نشو، زیرا اگر بخواهی به من نگاه کنی، ممکن است فقط خود را ببینی و نه حقیقت خود را."],[605,"بنگر اندر من ز من یک ساعتی","تا ورای کون بینی ساحتی","نزدیک‌ترین نگاه به خود را فراموش کن و تنها برای مدتی به درون خود بیندیش، تا از دنیای مادی فراتر بروی و ساحتی دیگر را ببینی."],[605,"وا رهی از تنگی و از ننگ و نام","عشق اندر عشق بینی والسلام","باید از تنگناها و مشکلات رها شوی و از شرم و ننگ دوری کنی تا بتوانی حقیقت عشق را درک کنی و در این عشق به آرامش برسی."],[605,"پس بدانی چونک رستی از بدن","گوش و بینی چشم می‌داند شدن","وقتی از قید و بند جسم رها شدی، دیگر حس‌های بدنی مانند گوش و بینی نمی‌توانند آگاهی و شناخت تو را محدود کنند و چشم به چشمی جدید و با فهمی عمیق می‌نگرد."],[605,"راست گفته‌ست آن شه شیرین‌زبان","چشم گردد مو به موی عارفان","او در این بیت به صحبت‌های یک شاعر یا انسان باهوشی اشاره می‌کند که گفته است، عارفان حقیقت را به‌طور دقیق درک کرده و می‌توانند با بینش عمیق خود، مطالب را از جزئیات جزئی تر ببینند و حس کنند. به عبارتی، عارفان مانند کسی هستند که همه چیز را به‌صورت شفاف و واضح می‌بینند و درک می‌کنند."],[605,"چشم را چشمی نبود اول یقین","در رحم بود او جنین گوشتین","چشم، در آغاز به هیچ چیزی نمی‌بیند و تنها در رحم مادر به صورت جنینی از گوشت وجود دارد."],[605,"علت دیدن مدان پیه ای پسر","ورنه خواب اندر ندیدی کس صور","ای پسر، علت دیدن را بر پایه ظاهر نگذار، زیرا در غیر این صورت هیچ‌کس در خواب، صورتی را نخواهد دید."],[605,"آن پری و دیو می‌بیند شبیه","نیست اندر دیدگاه هر دو پیه","پری (عالمی نورانی) و دیو (موجودی تاریک) هر کدام در دیدگاه خود به گونه‌ای متفاوت به یکدیگر می‌نگرند و شباهتی نمی‌بینند، زیرا شیوه‌ی ادراک و بینش آن‌ها با هم متفاوت است."],[605,"نور را با پیه خود نسبت نبود","نسبتش بخشید خلاق ودود","نور هیچ‌گونه ارتباطی با پیه (چربی) ندارد و این نسبت را خالق، یعنی خداوند از دود به نور می‌دهد. به بیان دیگر، نور و پیه از نظر ماهیت تفاوت دارند و تنها به خاطر خلق و آفرینش، این نسبت ایجاد شده است."],[605,"آدمست از خاک کی ماند به خاک","جنیست از نار بی‌هیچ اشتراک","انسان از خاک ساخته شده است و به همین دلیل نمی‌تواند همیشه به خاک وابسته بماند؛ در حالی که جن از آتش خلق شده و هیچ گونه اشتراکی با خاک ندارد."],[605,"نیست مانندای آتش آن پری","گرچه اصلش اوست چون می‌بنگری","آتش و پری هیچ تشابه‌ای به هم ندارند، هرچند که وجود پری به آتش مربوط می‌شود. در واقع، وقتی به آتش نگاه می‌کنی، متوجه می‌شوی که آنها دو حقیقت متفاوت هستند."],[605,"مرغ از بادست و کی ماند به باد","نامناسب را خدا نسبت به داد","مرغ به خاطر پرواز در باد است، و نمی‌تواند به مدت طولانی در باد باقی بماند. این به ما می‌گوید که ارتباط نادرست و نامناسب با خداوند، مانند پرنده‌ای است که نمی‌تواند در شرایط نا مساعد دوام آورد و خداوند در حق کسی که شایسته نیست، شیوه‌ای نادرست ندارد."],[605,"نسبت این فرعها با اصلها","هست بی‌چون ار چه دادش وصلها","این ابیات می‌گویند که ارتباط فرعی‌ها (زیرمجموعه‌ها) با اصول (مجموعه‌های اصلی) به‌طور قطع و بدون شک وجود دارد، هرچند که ممکن است در ظاهر به نظر بیاید که آن‌ها جدا از هم هستند. در واقع، حتی اگر تفاوت‌هایی بین آن‌ها وجود داشته باشد، باز هم باید بدانیم که این ارتباط در حقیقت وجود دارد."],[605,"آدمی چون زاده خاک هباست","این پسر را با پدر نسبت کجاست","انسان به خاطر اینکه از خاک آفریده شده، از لحاظ روحی و معنوی به آن وابسته است. این در حالی است که این فرزند به پدر خود چه نسبتی دارد و این نسبت چگونه است؟"],[605,"نسبتی گر هست مخفی از خرد","هست بی‌چون و خرد کی پی برد","اگر نسبت و رابطه‌ای وجود دارد که برای عقل و خرد پنهان است، این به خود آن خرد و عقل ارتباطی ندارد و نمی‌تواند بر آن آگاهی یابد."],[605,"باد را بی چشم اگر بینش نداد","فرق چون می‌کرد اندر قوم عاد","اگر باد را قدرت دیدن و شناختن داده نشده باشد، همانند آن است که کسی از قوم عاد نتواند آن را تشخیص دهد یا درکش کند. در واقع، این اشاره به نادانی یا عدم آگاهی نسبت به چیزی است که وجود دارد، ولی امکانات درک آن فراهم نیست."],[605,"چون همی دانست مؤمن از عدو","چون همی دانست می را از کدو","مؤمن وقتی که از دشمن خود خبر دارد، به‌خوبی می‌تواند می را از کدو (جنسی بی‌فایده) تشخیص دهد. این بدان معناست که شناخت درست و کامل می‌تواند به تجزیه و تحلیل عمیق‌تر منجر شود."],[605,"آتش نمرود را گر چشم نیست","با خلیلش چون تجشم کردنیست","اگر چشم کسی آتش نمرود را نبیند، برای ابراهیم خلیل (ابراهیم پیامبر) که آن آتش را درک کرده، معنی این عدم دیدن چه اهمیتی دارد؟ یعنی درک و شناخت هر کس به توانایی و آگاهی خود او بستگی دارد."],[605,"گر نبودی نیل را آن نور و دید","از چه قبطی را ز سبطی می‌گزید","اگر نور نیل (رود نیل که در مصر قرار دارد) وجود نداشت، قبطی (مردم مصر) از کدام سبط (بنی‌اسرائیل) انتخاب می‌شد؟ این اشاره به این دارد که وجود نور و شناخت، سبب انتخاب و تشخیص می‌شود."],[605,"گرنه کوه و سنگ با دیدار شد","پس چرا داود را او یار شد","اگر کوه و سنگ با وجود خود دیده شوند، پس چرا داود (پیامبر بنی‌اسرائیل) در مبارزاتش حامی و یار داشت؟"],[605,"این زمین را گر نبودی چشم جان","از چه قارون را فرو خورد آنچنان","اگر چشم جان وجود نمی‌داشت، این زمین چگونه قارون (یک انسان ثروتمند و مغرور) را به کام خود می‌کشید؟ بی‌چشم جان، شناخت و درک وجود نداشت."],[605,"گر نبودی چشم دل حنانه را","چون بدیدی هجر آن فرزانه را","اگر چشم دل حنانه (عاشق) وجود نداشت، او چه می‌توانست از درد جدایی معشوق فرزانه (عاشق‌اش) را ببیند و احساس کند."],[605,"سنگ‌ریزه گر نبودی دیده‌ور","چون گواهی دادی اندر مشت در","اگر سنگ‌ریزه‌ای نبود که تو آن را ببینی، چگونه می‌توانستی در مشتت گواهی بدهی که سنگ‌ریزه‌ای هست؟ این بیان به رویکردهای حسی و محدودیت‌های ادراک انسانی اشاره دارد."],[605,"ای خرد بر کش تو پر و بالها","سوره بر خوان زلزلت زلزالها","ای خرد، تو به ما قدرت و نیرو بخش که بر اساس سوره «زلزله» (سوره ۹۹ قرآن) بیدار شو و از نشانه‌های آن آگاه گرد."],[605,"در قیامت این زمین بر نیک و بد","کی ز نادیده گواهیها دهد","در روز قیامت، زمین بر نیک و بد شهادت می‌دهد و گواهی‌هایی را از آنچه که دیده، ارائه می‌کند."],[605,"که تحدث حالها و اخبارها","تظهر الارض لنا اسرارها","پس از آنکه حال و احوال زمین و اخبار آن بیان می‌شود، زمین رازهای خود را برای ما آشکار می‌کند."],[605,"این فرستادن مرا پیش تو میر","هست برهانی که بد مرسل خبیر","اینکه مرا به نزد تو فرستادند، نشانه‌ای است بر اینکه کسی که خبر دارد، این کار را انجام داده است."],[605,"کین چنین دارو چنین ناسور را","هست درخور از پی میسور را","این‌که دارویی برای این زخم (ناسور) وجود دارد، به خاطر این است که دنبال آن می‌رویم تا به طور مناسب به نتیجه‌ای برسیم (میسور)."],[605,"واقعاتی دیده بودی پیش ازین","که خدا خواهد مرا کردن گزین","تو پیش‌تر وقایعی را مشاهده کرده‌ای که نشان می‌دهد خداوند می‌خواهد تو را برگزیده کند."],[605,"من عصا و نور بگرفته به دست","شاخ گستاخ ترا خواهم شکست","من عصا و نور (نماد قدرت و هدایت) را در دست دارم و با این ابزار، شاخه سرکش و نافرمان (که نماد مشکلات یا موانع است) را خواهم شکست و از بین می‌برم."],[605,"واقعات سهمگین از بهر این","گونه گونه می‌نمودت رب دین","حوادث سخت و جدی به خاطر این‌گونه امور تو را به دین رهنمون می‌کردند."],[605,"در خور سر بد و طغیان تو","تا بدانی کوست درخوردان تو","پیشرفت و یادگیری تو به تحمل و پذیرش سرنوشتی که دچار آن شده‌ای بستگی دارد، تا بتوانی بفهمی چه کسانی برای تو مناسب و درخور تأثیرگذاری هستند."],[605,"تا بدانی کو حکیمست و خبیر","مصلح امراض درمان‌ناپذیر","از طریق حکمت و دانایی می‌توان شناسایی کرد که چه کسی می‌تواند مشکلات و بیماری‌های سخت و درمان‌ناپذیر را اصلاح و درمان کند."],[605,"تو به تاویلات می‌گشتی از آن","کور و گر کین هست از خواب گران","تو به تفسیرها و معانی می‌پرداختی، حال آن‌که او نابیناست و اگر هم بخواهد، از خواب عمیق و غفلتش نمی‌تواند آگاه شود."],[605,"وآن طبیب و آن منجم در لمع","دید تعبیرش بپوشید از طمع","آن طبیب و منجم در نور (روشنایی) چیزی را دیده‌اند، اما در تفسیر آن، خود را از طمع و خواسته‌های شخصی دور کرده‌اند و آن را بیان نمی‌کنند."],[605,"گفت دور از دولت و از شاهیت","که درآید غصه در آگاهیت","اگر از خوشبختی و مقام سلطنت دور باشی، غم و اندوه به آگاهی و آگاهی تو راه پیدا می‌کند."],[605,"از غذای مختلف یا از طعام","طبع شوریده همی‌بیند منام","انسان از غذاهای مختلف یا از غذاهایی که طبعش را به هم می‌زند، خواب‌های متفاوت و گاهی عجیب می‌بیند."],[605,"زانک دید او که نصیحت‌جو نه‌ای","تند و خون‌خواری و مسکین‌خو نه‌ای","چون او می‌بیند که تو فردی نصیحت‌پذیر نیستی و طبع تند و خون‌خواری داری، پس نمی‌تواند به تو کمک کند."],[605,"پادشاهان خون کنند از مصلحت","لیک رحمتشان فزونست از عنت","پادشاهان برای حفظ مصلحت ممکن است اقدام به قتل کنند، اما رحمت و محبت آن‌ها بر خشم و سخت‌گیری‌شان بیشتر است."],[605,"شاه را باید که باشد خوی رب","رحمت او سبق دارد بر غضب","پادشاه باید دارای ویژگی‌های خدایی باشد، به گونه‌ای که رحمت او بر خشمش غلبه داشته باشد."],[605,"نه غضب غالب بود مانند دیو","بی‌ضرورت خون کند از بهر ریو","غضب نباید به اندازه‌ای که دیو است، قوی و غالب باشد که بی‌دلیل و ضرورت خون ریخته شود. این اشاره به این است که در مدیریت و رفتار، خشم نباید بی‌مورد و بدون دلیل باشد."],[605,"نه حلیمی مخنث‌وار نیز","که شود زن روسپی زان و کنیز","نه اینکه فرد با حلم و دلسوزی که مانند مردان نرم‌خو باشد، نمی‌تواند به زن فاسد و کنیز تبدیل شود."],[605,"دیوخانه کرده بودی سینه را","قبله‌ای سازیده بودی کینه را","در اینجا به کنایه بیان شده که انسان می‌تواند دلی را به کینه و دشمنی متمایل کند و به جای اینکه عشق و محبت را در دلش قرار دهد، کینه را در آن جایگزین کند. در واقع، سینه به عنوان مرکز احساسات تبدیل به جایی برای کینه شده است."],[605,"شاخ تیزت بس جگرها را که خست","نک عصاام شاخ شوخت را شکست","شاخ تیز تو، در واقع، به جگرهای بسیاری آسیب زده، اما این شاخ نازک و ضعیف به خاطر عصا، شکسته است. اینجا به نوعی از قدرت و آسیب‌پذیری در مقایسه با یکدیگر اشاره می‌شود."],[606,"حمله بردند اسپه جسمانیان","جانب قلعه و دز روحانیان","جسمانیان، که به دنیای مادی تعلق دارند، به قلعه‌ای که متعلق به روحانیان است حمله می‌کنند."],[606,"تا فرو گیرند بر دربند غیب","تا کسی ناید از آن سو پاک‌جیب","برای اینکه روحانیان بر دروازه‌های نادیده غیبی تسلط یابند، باید مراقب باشند که هیچ‌کس از سمت دیگر به آن‌ها نزدیک نشود و پاک‌جیب، یعنی بی‌نقص و بدون گناه باشد."],[606,"غازیان حمله غزا چون کم برند","کافران برعکس حمله آورند","غازیان (مجاهدان در راه خدا) در زمان حمله به جنگ، اگر به اندازه کافی قوی نباشند، کافران (غیرمؤمنان) به جای آن‌ها حمله می‌کنند و به جنگ می‌آیند."],[606,"غازیان غیب چون از حلم خویش","حمله ناوردند بر تو زشت‌کیش","غازیان (شجاعان) عالم غیب به خاطر صبر و بردباری خود، به تو که آدمی پست و زشت‌کیش هستی، حمله نمی‌کنند."],[606,"حمله بردی سوی دربندان غیب","تا نیایند این طرف مردان غیب","به عالم غیب حمله کردی تا مردان غیب به این سمت نیایند و از آگاهی جلوگیر شوند."],[606,"چنگ در صلب و رحمها در زدی","تا که شارع را بگیری از بدی","اگر به زاد و ولد و خانواده‌های فرزندان هجومی برسانی، به‌طوری که قوانین موجود را از بین ببری، آنگاه می‌توانی اراده‌ی الهی را از بدی‌ها نجات دهی."],[606,"چون بگیری شه‌رهی که ذوالجلال","بر گشادست از برای انتسال","وقتی تو شه‌رهی (کشیشی) را بگیری که خداوند ذات جلال کاملش را برای تربیت و هدایت مردم گشوده است، به هدفش خواهی رسید."],[606,"سد شدی دربندها را ای لجوج","کوری تو کرد سرهنگی خروج","ای انسان لجوج و کور، تو در بند و محبوس شده‌ای و نمی‌فهمی که سرهنگی تو تنها به خروجی که از آن به دست می‌آوری محدود نمی‌شود."],[606,"نک منم سرهنگ هنگت بشکنم","نک به نامش نام و ننگت بشکنم","من منم فرماندهی که سپاه تو را شکست می‌دهم، نه به خاطر نام و آوازه‌ات، بلکه به خاطر خودت و عواقب رفتارت."],[606,"تو هلا در بندها را سخت بند","چندگاهی بر سبال خود بخند","تو اکنون در بندهایی گرفتار شده‌ای، اما این بندها را محکم نگیر و چند وقتی بر زین خود بخند و شاد باش."],[606,"سبلتت را بر کند یک یک قدر","تا بدانی کالقدر یعمی الحذر","سبیلت (زبان یا گفتار) تو را برمی‌دارد تا به اندازه هر چیز توجه کنی و بفهمی که چه اندازه باید هوشیار باشی."],[606,"سبلت تو تیزتر یا آن عاد","که همی لرزید از دمشان بلاد","سبلت (دست) تو در تیزی و قدرت از عاد (قوم عاد که به خاطر طغیان و نافرمانی‌اش به عذاب الهی دچار شد) هم بیشتر است، زیرا آن قوم به خاطر ترس از قدرت و تأثیر دم (نفس) آن‌ها لرزیدند و وحشت کردند."],[606,"تو ستیزه‌روتری یا آن ثمود","که نیامد مثل ایشان در وجود","تو در دشمنی و سخت‌گیری قوی‌تر از قوم ثمود هستی، چرا که هیچ‌کس همانند آنها در جاهلیت و کفر به وجود نیامده است. قوم ثمود، قومی بودند که به پیامبر صالح (ع) کافر شدند و عذاب الهی بر سرشان آمد."],[606,"صد ازینها گر بگویم تو کری","بشنوی و ناشنوده آوری","هرچند من از این موارد زیاد بگویم، تو آن را نمی‌شنوی و گویی هیچ نشنیده‌ای."],[606,"توبه کردم از سخن که انگیختم","بی‌سخن من دارویت آمیختم","من از گفتن و صحبت کردن توبه کردم و دیگر نمی‌خواهم با سخنانم چیزی را برانگیزم. من فقط با سکوت خود به تو (دارویا که ممکن است سمبل حقیقت یا خدا باشد) پیوسته‌ام."],[606,"که نهم بر ریش خامت تا پزد","یا بسوزد ریش و ریشه‌ت تا ابد","اگر من بر ریش جوانی نزنم تا او پخته شود، ممکن است که این ریش و ریشۀ تو برای همیشه بسوزد یا بپزد."],[606,"تا بدانی که خبیرست ای عدو","می‌دهد هر چیز را درخورد او","ای دشمن، تا بفهمی، بدان که او (خدا) از هر چیزی آگاه است و برای هر چیز، آنچه مناسب و شایسته‌اش است، تقدیر می‌کند."],[606,"کی کژی کردی و کی کردی تو شر","که ندیدی لایقش در پی اثر","کی و در چه زمانی خطا کردی و چه زمانی نافرمانی را انجام دادی که لایق آن هیچ اثر و نتیجه‌ای ندیدی؟"],[606,"کی فرستادی دمی بر آسمان","نیکیی کز پی نیامد مثل آن","انسانی که نیکی را به آسمان فرستاده، باید بداند که هیچ نیکی بدون پاسخ و نتیجه نمی‌ماند؛ پس اگر در قبال اعمال خوب خود هیچ اثری نمی‌بیند، باید در مورد آن نیکی تأمل کند و ببیند که چرا پاسخی نیامده است."],[606,"گر مراقب باشی و بیدار تو","بینی هر دم پاسخ کردار تو","اگر هوشیار و بیدار باشی، در هر لحظه نتیجه اعمال خود را خواهی دید."],[606,"چون مراقب باشی و گیری رسن","حاجتت ناید قیامت آمدن","اگر با دقت و هوشیاری رفتار کنی و درک کنی که چیست، دیگر نیازی به انتظار قیامت نخواهی داشت."],[606,"آنک رمزی را بداند او صحیح","حاجتش ناید که گویندش صریح","کسی که به رمز و رازها آگاه است، نیازی به درخواست‌های صریح ندارد، زیرا او به طور صحیح می‌داند که چه باید بکند و چه می‌خواهد."],[606,"این بلا از کودنی آید ترا","که نکردی فهم نکته و رمزها","این مصیبت بر تو به خاطر نادانی‌ات می‌آید، زیرا تو نتوانستی نکته‌ها و رمزها را بفهمی."],[606,"از بدی چون دل سیاه و تیره شد","فهم کن اینجا نشاید خیره شد","وقتی که دل از بدی سیاه و تیره می‌شود، باید بفهمی که در این وضعیت، نباید خیره و حیران بمانی و باید هوشیار باشی."],[606,"ورنه خود تیری شود آن تیرگی","در رسد در تو جزای خیرگی","اگر دل انسان تیره باشد و خودش را نداند، این تیرگی به مانند تیر به او ضربه می‌زند و در نهایت پاداش نیکویی به او نمی‌رسد."],[606,"ور نیاید تیر از بخشایش است","نه پی نادیدن آلایش است","اگر تیر از بخشش به ما نرسد، نشانه آن است که ما به آلودگی‌ها توجه نکرده‌ایم."],[606,"هین مراقب باش گر دل بایدت","کز پی هر فعل چیزی زایدت","مراقب باش، اگر دل‌نگران چیزی هستی، زیرا هر عملی که انجام دهی، تبعات و نتایجی برای تو به همراه خواهد داشت."],[606,"ور ازین افزون ترا همت بود","از مراقب کار بالاتر رود","اگر همت تو از این مراقبت بیشتر باشد، به کارهایی بزرگ‌تر و والاتر دست خواهی یافت."],[607,"پس چو آهن گرچه تیره‌هیکلی","صیقلی کن صیقلی کن صیقلی","اگرچه انسان ممکن است در ظاهر دارای کمی ضعف باشد، اما باید خود را به‌گونه‌ای پرورش دهد که مانند آهن صاف و صیقلی شود، یعنی با تقوا و نورانیت درونش، زیبایی و روشنایی را بروز دهد."],[607,"تا دلت آیینه گردد پر صور","اندرو هر سو ملیحی سیمبر","تا دل تو مانند آینه شود و در آنImages زیبا و دلپسند از همه سو منعکس گردد."],[607,"آهن ار چه تیره و بی‌نور بود","صیقلی آن تیرگی از وی زدود","آهن هرچند در ابتدا تیره و بی‌نور به نظر می‌رسد، اما با سابیدن و صیقل دادن، آن تیرگی از آن زدوده می‌شود و درخشش پیدا می‌کند."],[607,"صیقلی دید آهن و خوش کرد رو","تا که صورتها توان دید اندرو","آهن اگر صیقل داده شود و سطح آن صاف و درخشان شود، می‌توان به راحتی اشکال و تصاویر را بر روی آن دید. این یعنی انسان نیز با پاکسازی روح و خودسازی، می‌تواند حقایق و معانی را بهتر درک کند."],[607,"گر تن خاکی غلیظ و تیره است","صیقلش کن زانک صیقل‌گیره است","اگر بدن خاکی و زمینی شما ضخیم و تاریک است، آن را صیقل بدهید، زیرا صیقل دادن باعث می‌شود که قابلیت دیدن را پیدا کند."],[607,"تا درو اشکال غیبی رو دهد","عکس حوری و ملک در وی جهد","تن خاکی انسان، مانند آهنی است که قابلیت صیقل خوردن و درخشش دارد؛ به طوری که در آن، اشکال غیبی و تصویر حوری‌ها و ملائکه نمایان می‌شود و تلاشی در این زمینه انجام می‌گیرد."],[607,"صیقل عقلت بدان دادست حق","که بدو روشن شود دل را ورق","خداوند حق عقل تو را صیقل داده است تا با آن دل را روشن کند و به تو فهم و آگاهی بخشد."],[607,"صیقلی را بسته‌ای ای بی‌نماز","وآن هوا را کرده‌ای دو دست باز","ای کسی که نمازی نمی‌خوانی، تو مانند صیقلی (آیینه) را بسته‌ای و نفس (هوا) را آزاد گذاشته‌ای؛ یعنی در امور معنوی خود، بی‌عمل هستی و از توجه به خدا غافلی."],[607,"گر هوا را بند بنهاده شود","صیقلی را دست بگشاده شود","اگر بندها و موانع برطرف شود، صیقلی می‌تواند دستش را باز کند و به کار بپردازد."],[607,"آهنی که آیینه غیبی بدی","جمله صورتها درو مرسل شدی","آهن که دارای کیفیت خاصی است، به عنوان یک آینه نامحسوس عمل می‌کند که تمامی تصاویر و شکل‌ها را در خود منعکس می‌کند. این به معنای آن است که انسان نیز می‌تواند به مانند این آهن، پذیرای تجلیات مختلف واقعیت‌ها باشد."],[607,"تیره کردی زنگ دادی در نهاد","این بود یسعون فی الارض الفساد","اینان که فساد می‌کنند در زمین، مانند زنگ زدن، حالتی زشت به آنچه در وجود انسان خوب و با ارزش است، می‌دهند."],[607,"تاکنون کردی چنین اکنون مکن","تیره کردی آب را افزون مکن","تا به حال چنین کردی، اکنون این کار را نکن. آب را که تیره کردی، حالا بیش‌تر تیره نکن."],[607,"بر مشوران تا شود این آب صاف","واندرو بین ماه و اختر در طواف","برای اینکه آب صاف شود و ماه و ستاره‌ها در آن به دور یکدیگر بچرخند، باید به مشاوران مراجعه شود."],[607,"زانک مردم هست هم‌چون آب جو","چون شود تیره نبینی قعر او","چون مردم هم مانند آب زلال هستند، وقتی که آب تیره می‌شود، عمق و حقیقت آن را نمی‌توان دید."],[607,"قعر جو پر گوهرست و پر ز در","هین مکن تیره که هست او صاف حر","پایین چشمه آب، گنج و جواهر زیادی وجود دارد؛ پس مراقب باش که آن را تیره نکن، زیرا آب در واقع صاف و زلال است."],[607,"جان مردم هست مانند هوا","چون بگرد آمیخت شد پرده سما","روح انسان مانند هوا است و وقتی که در محیطی قرار می‌گیرد، به‌راحتی با آنجا در می‌آمیزد و ارتباط برقرار می‌کند."],[607,"مانع آید او ز دید آفتاب","چونک گردش رفت شد صافی و ناب","چونکه انسان به گردش و تغییرات دچار می‌شود، مانع دیدن حقیقت و روشنایی (آفتاب) می‌گردد. وقتی انسان درست و بدون پرده به حقیقت بنگرد، می‌تواند آنچه را درون خود دارد به وضوح ببیند."],[607,"با کمال تیرگی حق واقعات","می‌نمودت تا روی راه نجات","حق (حقیقت) با وجود تاریکی و کدر بودن، در واقعیت‌ها (واقعات) به تو نمایان می‌شد تا تو را به سمت راه نجات هدایت کند."],[608,"ز آهن تیره بقدرت می‌نمود","واقعاتی که در آخر خواست بود","از آهن سیاه و بدحال، با قدرتی که داشت، واقعیت‌هایی را نشان می‌داد که در نهایت خواسته‌ی او بود."],[608,"تا کنی کمتر تو آن ظلم و بدی","آن همی‌دیدی و بدتر می‌شدی","تا زمانی که تو ظلم و بدی را کمتر نکنی، همواره بدی‌ها را می‌بینی و بدتر می‌شوی."],[608,"نقشهای زشت خوابت می‌نمود","می‌رمیدی زان و آن نقش تو بود","خواب‌های زشت و بدی که می‌دیدی، تو را می‌ترساند و فراری می‌کرد، در حالی که آن تصاویر در واقع از خودت بودند."],[608,"هم‌چو آن زنگی که در آیینه دید","روی خود را زشت و بر آیینه رید","شخصی مانند آن زنگی (نژاد سیاه) که در آینه صورت زشت خود را می‌بیند و بر آینه آبی می‌کند (نارضایتی یا خشم خود را بر آن نشان می‌دهد)، به نوعی به زشتی خود واکنش نشان می‌دهد."],[608,"که چه زشتی لایق اینی و بس","زشتیم آن تواست ای کور خس","تو به چه زشتی سزاوار هستی، و این زشتی تنها از آن توست، ای نابینا و ستمگر."],[608,"این حدث بر روی زشتت می‌کنی","نیست بر من زانک هستم روشنی","زشتی‌ای که بر چهره‌ات نمایان است، به من ارتباطی ندارد؛ زیرا من خود نوری هستم و به این زشتی توجه نمی‌کنم."],[608,"گاه می‌دیدی لباست سوخته","گه دهان و چشم تو بر دوخته","گاهی می‌دیدی که لباس‌های تو سوخته و دهان و چشمانت بسته شده است."],[608,"گاه حیوان قاصد خونت شده","گه سر خود را به دندان دده","گاهی می‌بینی که حیوانی به عنوان پیام‌آور، برای تو رسالت و خبر مرگی آورده و دندانش را به سر خود می‌زند."],[608,"گه نگون اندر میان آبریز","گه غریق سیل خون‌آمیز تیز","گاه انسان در میان زباله‌های زندگی، مانند انسانی که در آب‌های پرخون گرفتار شده، غرق می‌شود."],[608,"گه ندات آمد ازین چرخ نقی","که شقیی و شقیی و شقی","گاهی بر اثر گردش این چرخ، نداها به گوش می‌رسد که تو بدبختی و بدبختی و بدبختی."],[608,"گه ندات آمد صریحا از جبال","که برو هستی ز اصحاب الشمال","گاهی از کوه‌ها ندا می‌رسید که تو جزو افراد بدبخت و شقاوت‌زده هستی و در معیت گروه شمایل منفی قرار داری."],[608,"گه ندا می‌آمدت از هر جماد","تا ابد فرعون در دوزخ فتاد","به تو گاهی از هر موجود بی‌جان ندا می‌رسید که تا همیشه فرعون در دوزخ گرفتار خواهد بود."],[608,"زین بترها که نمی‌گویم ز شرم","تا نگردد طبع معکوس تو گرم","از شرم نمی‌توانم بدتر از این‌ها را بگویم تا اینکه طبع تو به سوی افکار نادرست و معکوس گرایش پیدا نکند."],[608,"اندکی گفتم به تو ای ناپذیر","ز اندکی دانی که هستم من خبیر","اندکی از حقیقت را به تو گفتم ای کسی که نمی‌پذیری، اما از همین مقدار کمی که بیان کردم، می‌فهمی که من دارای دانش و آگاهی هستم."],[608,"خویشتن را کور می‌کردی و مات","تا نیندیشی ز خواب و واقعات","در این بیت، شاعر می‌گوید که تو خود را به نوعی نابینا می‌کردی و غافل می‌گشتی تا به واقعیت‌ها و رخدادهای زندگی فکر نکنی. این به نوعی نشان‌دهنده خودفریبی یا فرار از حقیقت است."],[608,"چند بگریزی نک آمد پیش تو","کوری ادراک مکراندیش تو","چند بار می‌خواهی فرار کنی؟ هرگز به خود نمی‌آیی و از نادانی و فریبندی ذهنت آگاه نمی‌شوی."],[609,"هین مکن زین پس فراگیر احتراز","که ز بخشایش در توبه‌ست باز","از این پس خودت را حفظ کن و از کارهای ناپسند دوری کن، زیرا در توبه، درهای بخشش برای تو باز است."],[609,"توبه را از جانب مغرب دری","باز باشد تا قیامت بر وری","توبه همانند دری است که از سمت مغرب گشوده می‌شود و این در تا روز قیامت به روی گناهکاران باز است."],[609,"تا ز مغرب بر زند سر آفتاب","باز باشد آن در از وی رو متاب","تا زمانی که خورشید از سمت مغرب طلوع کند، آن در توبه باز است؛ پس از توبه روی خود را برنگردان."],[609,"هست جنت را ز رحمت هشت در","یک در توبه‌ست زان هشت ای پسر","بهشت از رحمت خداوند دارای هشت دروازه است که یکی از آن‌ها دروازه توبه است، پسر (اومدیر) این را بدان."],[609,"آن همه گه باز باشد گه فراز","وآن در توبه نباشد جز که باز","در دنیا لحظاتی هستند که انسان می‌تواند به خدا نزدیک شود و لحظاتی دیگر که از او دور می‌شود، اما در دروازه توبه همیشه باز است و تنها بازگشت به آن دروازه ممکن است."],[609,"هین غنیمت دار در بازست زود","رخت آنجا کش به کوری حسود","توبیخ می‌کند که فرصت توبه را غنیمت بشمار و زودتر از حسودان دوری کن."],[610,"هین ز من بپذیر یک چیز و بیار","پس ز من بستان عوض آن را چهار","موسی از فرعون می‌خواهد که فقط یک نکته را از او بپذیرد و در عوض، چهار ویژگی یا فضیلت بزرگ را به او بدهد."],[610,"گفت ای موسی کدامست آن یکی","شرح کن با من از آن یک اندکی","فرعون از موسی علیه‌السلام می‌خواهد که بگوید آن یک چیز چیست و از او بخواهد تا کمی بیشتر درباره‌اش توضیح بدهد."],[610,"گفت آن یک که بگویی آشکار","که خدایی نیست غیر کردگار","موسی علیه‌السلام می‌گوید: آن چیزی که باید به تو بگویم این است که هیچ خدایی جز خداوندی که جهان را می‌آفریند وجود ندارد."],[610,"خالق افلاک و انجم بر علا","مردم و دیو و پری و مرغ را","خدای آسمان‌ها و ستاره‌ها برتر از همه موجودات، چه انسان‌ها و چه دیوان و پریان و پرندگان است."],[610,"خالق دریا و دشت و کوه و تیه","ملکت او بی‌حد و او بی‌شبیه","خداوندی که دریا و دشت و کوه را آفریده، سلطنت و حکومتی دارد که بی‌نهایت است و هیچ چیز مانند او نیست."],[610,"گفت ای موسی کدامست آن چهار","که عوض بدهی مرا بر گو بیار","موسی به فرعون می‌گوید که چهار فضیلت وجود دارد که می‌توانی به عنوان عوض آنها را بگویی. فرعون از او می‌خواهد تا آن چهار فضیلت را نام ببرد."],[610,"تا بود کز لطف آن وعده حسن","سست گردد چارمیخ کفر من","اگر وعده‌های زیبا و خوشایند خداوند به من داده شود، چهارمیخ کفر و disbelief من سست خواهد شد و از بین خواهد رفت."],[610,"بوک زان خوش وعده‌های مغتنم","برگشاید قفل کفر صد منم","شاید به خاطر آن وعده‌های شیرین و باارزش، قفل کفر و disbelief من باز شود و از آن آزاد شوم."],[610,"بوک از تاثیر جوی انگبین","شهد گردد در تنم این زهر کین","شاید از تأثیر نهر شیرین عسل، وجود من از این زهر کینه پاک و زنده شود."],[610,"یا ز عکس جوی آن پاکیزه شیر","پرورش یابد دمی عقل اسیر","اگر از تأثیر آن شیر پاک و خالص چیزی بگذرد، عقل اسیر نیز ممکن است در آن یک لحظه به کمال و رشد برسد."],[610,"یا بود کز عکس آن جوهای خمر","مست گردم بو برم از ذوق امر","شاید از تأثیر و رد آن جوهای شراب، سرمست و خوشحال شوم و از لذت کار، بوی خوشی بگیرم."],[610,"یا بود کز لطف آن جوهای آب","تازگی یابد تن شوره خراب","شاید از لطف آن چشمه‌های آب، بدن خشک و ویران من به تازگی و سرسبزی برسد."],[610,"شوره‌ام را سبزه‌ای پیدا شود","خارزارم جنت ماوی شود","اگر من مثل شوره و بی‌حیات هستم، سبزه‌ای پیدا خواهد شد که مرا زنده کند و بیابان خاری که در آن هستم، به بهشتی تبدیل خواهد شد."],[610,"بوک از عکس بهشت و چار جو","جان شود از یاری حق یارجو","اگرچه من از دوزخ و عذابی که تجربه کرده‌ام به شدت رنج می‌برم، اما با یاری خداوند، به سوی بهشت و زندگی بهتر هدایت می‌شوم و روح‌ام در پی این یاری به زندگی باز می‌گردد."],[610,"آنچنان که از عکس دوزخ گشته‌ام","آتش و در قهر حق آغشته‌ام","من به قدری از تصویر جهنم دچار آتش‌سوزی و خشم خداوند شده‌ام که خود را در قهر و عذاب احساس می‌کنم."],[610,"گه ز عکس مار دوزخ هم‌چو مار","گشته‌ام بر اهل جنت زهربار","به سبب تاثر از عذاب دوزخ، چنان شده‌ام که به زهر مار تبدیل شدم و بر اهل بهشت تاثیر منفی می‌گذارم."],[610,"گه ز عکس جوشش آب حمیم","آب ظلمم کرده خلقان را رمیم","گاهی به خاطر تصویر جوشش آب حمیم (آب داغ جهنم) به حالت آب ظلم در آمده‌ام و باعث ترس و فرار مردم شده‌ام."],[610,"من ز عکس زمهریرم زمهریر","یا ز عکس آن سعیرم چون سعیر","من از اثر خشم و سردی خودم، مانند زمهریر (سرما و یخبندان) یا از اثر آتش دوزخ هستم، مانند آتش سعیر (آتش سوزان)."],[610,"دوزخ درویش و مظلومم کنون","وای آنک یابمش ناگه زبون","من به حالتی مشابه دوزخ و عذاب دچارم، چرا که درویش و مظلوم هستم. حالا اگر ناگهان به آن عذاب برسم، وای به حال من."],[611,"گفت موسی که اولین آن چهار","صحتی باشد تنت را پایدار","موسی (علیه‌السلام) گفت که اولین و مهم‌ترین فضیلت آن چهار، سلامت و تندرستی بدن توست که باید همواره باقی بماند."],[611,"این علل‌هایی که در طب گفته‌اند","دور باشد از تنت ای ارجمند","موسی در اینجا به فرعون می‌گوید که عواملی که در علم طب به عنوان عوامل بیماری و آسیب مطرح شده‌اند، باید از بدن تو دور باشند ای انسان گرامی و با ارزش."],[611,"ثانیا باشد ترا عمر دراز","که اجل دارد ز عمرت احتراز","دومین فضیلت این است که تو عمر طولانی خواهی داشت، زیرا مرگ نمی‌تواند به عمر تو آسیبی برساند."],[611,"وین نباشد بعد عمر مستوی","که بناکام از جهان بیرون روی","عمر پربار و متناسبی نخواهی داشت، اگر در پایان زندگی‌ات ناامید و بدعاقبت از دنیا بروی."],[611,"بلک خواهان اجل چون طفل شیر","نه ز رنجی که ترا دارد اسیر","انسان باید مانند کودک شیر، مشتاق مرگ باشد، نه به خاطر رنجی که از زندگی دارد، بلکه به خاطر آرزوی آن."],[611,"مرگ‌جو باشی ولی نه از عجز رنج","بلک بینی در خراب خانه گنج","اگر به دنبال مرگ هستی، نباید به خاطر ناتوانی و رنج خود باشد، بلکه باید به این دلیل باشد که در دل ویرانه‌ها، گنج و ثروتی نهفته است."],[611,"پس به دست خویش گیری تیشه‌ای","می‌زنی بر خانه بی‌اندیشه‌ای","برای به دست آوردن آن گنجینه ارزشمند، خودت باید با اراده و کوشش، ابزار لازم را به‌دست بگیری و بی‌توجه به موانع و مشکلات، به کار بپردازی."],[611,"که حجاب گنج بینی خانه را","مانع صد خرمن این یک دانه را","حجاب، که همان موانع و مشکلات است، باعث می‌شود که تو گنجی را که در خانه داری، نبینی و به خاطر همین یک مانع، از رسیدن به صدها خرمن پربار بی‌نصیب بمانی."],[611,"پس در آتش افکنی این دانه را","پیش گیری پیشه مردانه را","اگر این دانه (ذره‌ای حقیقت) را در آتش بسوزانی، جلوی کار و تلاش مردانه را می‌گیری. این بیان به اهمیت از خودگذشتگی و فداکاری در راه حقیقت و ایستادگی در برابر مشکلات اشاره دارد."],[611,"ای به یک برگی ز باغی مانده","هم‌چو کرمی برگش از رز رانده","ای کسی که مانند یک برگی از باغ مانده‌ای و همچون کرمی هستی که از گل رز رانده شده‌ای."],[611,"چون کرم این کرم را بیدار کرد","اژدهای جهل را این کرم خورد","کرم وقتی بیدار و آگاه شد، اژدهای جهل و نادانی را که درون او بود نابود کرده و از بین می‌برد."],[611,"کرم کرمی شد پر از میوه و درخت","این چنین تبدیل گردد نیکبخت","کرم به زودی به موجودی پربار و سرشار از میوه و درخت تبدیل می‌شود، و چنین تغییری نشان‌دهنده سعادت و نیکبختی است."],[612,"خانه بر کن کز عقیق این یمن","صد هزاران خانه شاید ساختن","در این بیت، شاعر به کنایه از روح و وجود انسانی سخن می‌گوید و می‌گوید که اگر خانه (بدن) را تخریب کنی، از وجود اصلی‌اش که همچون عقیق باارزش است، می‌توان صدها خانه جدید و زیبا ساخت. یعنی رها کردن محدودیت‌های مادی می‌تواند به خلق آثار و زندگی‌های ارزشمند منجر شود."],[612,"گنج زیر خانه است و چاره نیست","از خرابی خانه مندیش و مه‌ایست","گنجی در زیر خانه وجود دارد و برای به دست آوردن آن، چاره‌ای جز خرابی خانه نیست. پس نگران و دل‌نگران نباش."],[612,"که هزاران خانه از یک نقد گنج","تان عمارت کرد بی‌تکلیف و رنج","تعداد زیادی خانه می‌توان با یک مقدار طلا بنا کرد، بدون اینکه نیازی به دردسر و زحمت باشد."],[612,"عاقبت این خانه خود ویران شود","گنج از زیرش یقین عریان شود","در نهایت، این خانه‌ای که ساخته شده است، ویران خواهد شد و گنجی که زیر آن قرار دارد، به‌طور قطع نمایان خواهد شد."],[612,"لیک آن تو نباشد زانک روح","مزد ویران کردنستش آن فتوح","اما آنچه که درباره تو می‌گویند، حقیقت ندارد؛ زیرا روح حقیقت ویران‌سازی نیست، بلکه به دست آوردن و دستیابی به موفقیت و پیروزی است."],[612,"چون نکرد آن کار مزدش هست لا","لیس للانسان الا ما سعی","چون او آن کار را نکرده، مزد او نیز نیست؛ زیرا برای انسان جز آنچه که خود تلاش کرده، چیزی نیست."],[612,"دست خایی بعد از آن تو کای دریغ","این چنین ماهی بد اندر زیر میغ","ای کاش تو اینطور نمی‌کردی، چرا که بعد از آن، این موجود ارزشمند و زیبا (انسانی) در زیر ظلمت و غم (مشکلات یا موانع) قرار گرفته است."],[612,"من نکردم آنچ گفتند از بهی","گنج رفت و خانه و دستم تهی","من آن کارهایی را که درباره‌ام گفته‌اند، نکردم. گنج و ثروت و خانه‌ام رفته و حالا دستم خالی است."],[612,"خانه اجرت گرفتی و کری","نیست ملک تو به بیعی یا شری","تو خانه‌ای را اجاره کرده‌ای و این خانه متعلق به تو نیست؛ به آن شکل که خودت بخواهی نمی‌توانی آن را بفروشی یا با آن معامله‌ای کنی."],[612,"این کری را مدت او تا اجل","تا درین مدت کنی در وی عمل","این بی‌خود و نادانی را تا زمانی که مرگ به سراغ انسان نیامده، لازم است که در این مدت به کار نیک بپردازد."],[612,"پاره‌دوزی می‌کنی اندر دکان","زیر این دکان تو مدفون دو کان","تو در این دکان (وجود) دنبال پاره‌دوزی و ترمیم می‌روی، اما باید بدانی که در زیر این دکان، دو گنج (دو کان) پنهان است که باید به آن‌ها توجه کنی."],[612,"هست این دکان کرایی زود باش","تیشه بستان و تکش را می‌تراش","این دکان، جایی است که به سرعت باید از آن خارج شوی. پس چکش را بردار و تا دیر نشده، کار آنگونه که می‌خواهی انجام بده."],[612,"تا که تیشه ناگهان بر کان نهی","از دکان و پاره‌دوزی وا رهی","وقتی ناگهان تیشه را بر سنگ معدن (کان) فرود آوری و از کار بیهوده پاره‌دوزی دست برداری، یعنی از کارهایی که نتیجه‌ای ندارد، برمی‌داری."],[612,"پاره‌دوزی چیست خورد آب و نان","می‌زنی این پاره بر دلق گران","پاره‌دوزی یعنی دوخت و دوز لباس پاره، و در اینجا پرسش می‌شود که چگونه می‌توان زندگی روزمره، مانند خوردن آب و نان، را به این لباس پاره و کهنه (دلق) که از درد و رنج زندگی به زحمت دوخته شده، پیوند زد."],[612,"هر زمان می‌درد این دلق تنت","پاره بر وی می‌زنی زین خوردنت","هر زمانی که دلق تنت (لباس تو) پاره می‌شود، به خاطر این که از غذای کم‌کیفیت و نامناسب استفاده می‌کنی، آن را پاره می‌زنی."],[612,"ای ز نسل پادشاه کامیار","با خود آ زین پاره‌دوزی ننگ دار","ای پسر پادشاه کامیاب، از این کار دلق پاره‌دوزی، که ننگین است، دوری کن."],[612,"پاره‌ای بر کن ازین قعر دکان","تا برآرد سر به پیش تو دو کان","از این عمق دکان، تکه‌ای را جدا کن تا دو قنات (یا چشمه) به سمت تو نمایان شود و بیرون بیاید."],[612,"پیش از آن کین مهلت خانه کری","آخر آید تو نخورده زو بری","قبل از آنکه این فرصت محدود به پایان برسد، باید از خانه کریم خارج شوی؛ چراکه پس از آن، تو نمی‌توانی از آنجا بیرون بروی."],[612,"پس ترا بیرون کند صاحب دکان","وین دکان را بر کند از روی کان","صاحب دکان تو را از مغازه بیرون می‌کند و این مغازه را از روی معدن می‌کشد."],[612,"تو ز حسرت گاه بر سر می‌زنی","گاه ریش خام خود بر می‌کنی","تو از ناراحتی و حسرت گاهی بر سر خود می‌زنی و گاهی به ریش نادان و بی‌تجربه‌ات دست می‌کشی و آن را می‌کنی."],[612,"کای دریغا آن من بود این دکان","کور بودم بر نخوردم زین مکان","آه، افسوس! آن «من» حقیقی من بوده است، ولی من در این دنیای کور زندگی می‌کردم و از این مکان باطل، بهره‌ای نبردم."],[612,"ای دریغا بود ما را برد باد","تا ابد یا حسرتا شد للعباد","آه و افسوس، ما بر اثر وزش باد زمان از دست رفتیم و دیگر نمی‌توانیم به حالت قبلی خود بازگردیم، و این حسرتی برای بندگان خواهد بود."],[613,"دیدم اندر خانه من نقش و نگار","بودم اندر عشق خانه بی‌قرار","من در خانه خودم دیدم که نقوش و تزئیناتی وجود دارد، اما خودم در عشق، بی‌قرار و ناآرام بودم."],[613,"بودم از گنج نهانی بی‌خبر","ورنه دستنبوی من بودی تبر","من از گنج‌های پنهان ناآگاهم، و اگر خبر داشتم، مانند تبر در دست، توانایی و قدرت زیادی داشتم."],[613,"آه گر داد تبر را دادمی","این زمان غم را تبرا دادمی","اگر می‌دانستم که تبر (ابزار برش) را به من می‌دهند، افسوس که در این لحظه غم را به تبر (ابزار رهایی) تبدیل می‌کردم و از آن رها می‌شدم."],[613,"چشم را بر نقش می‌انداختم","هم‌چو طفلان عشقها می‌باختم","چشمم را بر طرح و نقش می‌انداختم و مثل کودکان در عشق‌ها غرق می‌شدم."],[613,"پس نکو گفت آن حکیم کامیار","که تو طفلی خانه پر نقش و نگار","حکیم کامیار می‌گوید که تو مانند یک کودک هستی که در خانه‌ای پر از نقش و نگار به سر می‌بری و به امور سطحی و ظاهری مشغول هستی."],[613,"در الهی‌نامه بس اندرز کرد","که بر آر از دودمان خویش گرد","در «الهی‌نامه» بسیار نصیحت کرده است که نسبت به خانواده و نسل خودت افتخار نکن و مغرور نشو."],[613,"بس کن ای موسی بگو وعده سوم","که دل من ز اضطرابش گشت گم","ای موسی، دیگر بس کن و فقط وعده سوم را بگو، چون اضطراب من به خاطر این وعده باعث گمشدگی دل من شده است."],[613,"گفت موسی آن سوم ملک دوتو","دو جهانی خالص از خصم و عدو","موسی گفت آن ملک سوم، دو جهان را خالص از دشمنی و خصومت می‌کند."],[613,"بیشتر زان ملک که اکنون داشتی","کان بد اندر جنگ و این در آشتی","بیشتر از آن ملکه‌ای که اکنون به دست آورده‌ای، که آن ملکه در زمان جنگ است و این ملکه در زمان صلح می‌باشد."],[613,"آنک در جنگت چنان ملکی دهد","بنگر اندر صلح خوانت چون نهد","اگر در زمان جنگ، چنین پادشاهی به تو عطا می‌شود، در زمان صلح باید توجه کنی که چگونه از خوان گنج و نعمت تو پذیرایی می‌کند."],[613,"آن کرم که اندر جفا آنهات داد","در وفا بنگر چه باشد افتقاد","آن کرمی که در زمان جفا به دیگران داده می‌شود، در زمان وفا و محبت چه نتایجی خواهد داشت."],[613,"گفت ای موسی چهارم چیست زود","بازگو صبرم شد و حرصم فزود","موسی از شخصی می‌خواهد که آنچه را که به چهارمین مورد اشاره شده است، به سرعت بگوید، زیرا او دیگر طاقت ندارد و «حرص» او برای دانستن بیشتر از صبرش فراتر رفته است."],[613,"گفت چارم آنک مانی تو جوان","موی هم‌چون قیر و رخ چون ارغوان","او گفت: چهارمین ویژگی آن است که تو جوانی، موی‌ات سیاه و به مانند قیر است و صورت‌ات مانند رنگ ارغوان (گل سرخ) است."],[613,"رنگ و بو در پیش ما بس کاسدست","لیک تو پستی سخن کردیم پست","رنگ و بوی زیبایی در نظر ما بی‌ارزش و بی‌خاصیت است، اما ما درباره چیزهای پست و بی‌ارزش سخن می‌گوییم و خود را به خاطر آن‌ها فریب می‌دهیم."],[613,"افتخار از رنگ و بو و از مکان","هست شادی و فریب کودکان","افتخار به زیبایی‌ها و ویژگی‌های ظاهری و همچنین به مکان‌ها، چیزی بیشتر از شادی و فریب کودکان نیست و نمی‌توان به آن دلخوش کرد."],[614,"چونک با کودک سر و کارم فتاد","هم زبان کودکان باید گشاد","وقتی با کودک‌ها صحبت می‌کنم، باید به زبان و سطح فهم آن‌ها صحبت کنم."],[614,"که برو کتاب تا مرغت خرم","یا مویز و جوز و فستق آورم","برو و کتابی بیاور تا من برای تو میوه‌هایی مثل خرما، مویز (کشمش)، گردو و فستق بیاورم و تو از اینها خوشحال شوی."],[614,"جز شباب تن نمی‌دانی به کیر","این جوانی را بگیر ای خر شعیر","تنها جوانی و نشاط را می‌فهمی، پس این جوانی را مانند تازیانه‌ای در دست بگیر و مراقب خود باش، ای مثل خر که دانه‌ای (شعیر) می‌خورید."],[614,"هیچ آژنگی نیفتد بر رخت","تازه ماند آن شباب فرخت","هیچ آسیبی به تو نمی‌رسد و تو همچنان شاداب و جوان باقی می‌مانی."],[614,"نه نژند پیریت آید برو","نه قد چون سرو تو گردد دوتو","پیری تو را غمگین نمی‌کند و قد تو همچنان چون سرو (درخت بلند و راست) نخواهد شد که به دو قسمت تقسیم شود."],[614,"نه شود زور جوانی از تو کم","نه به دندانها خللها یا الم","زور جوانی تو هیچ‌گاه کم نمی‌شود، حتی اگر دندان‌هایت خراب یا ناراحت باشد."],[614,"نه کمی در شهوت و طمث و بعال","که زنان را آید از ضعفت ملال","در این بیت بیان شده که نباید در شهوت و آمیزش با زنان، کم‌کاری کرد یا ضعف نشان داد، زیرا این امر می‌تواند باعث خستگی و کلافگی زنان شود."],[614,"آنچنان بگشایدت فر شباب","که گشود آن مژده عکاشه باب","چنان تو را از شادابی جوانی بهره‌مند خواهد کرد که مژده عکاشه (مردی که پیامبر به او خبر خوشی داده بود) به تو خبر داد."],[615,"احمد آخر زمان را انتقال","در ربیع اول آید بی جدال","احمد، پیامبر اسلام، در آخر زمان ظهور خواهد کرد و در ماه ربیع‌الاول به دنیا خواهد آمد، بی‌هیچ اختلاف و جدالی در این مورد."],[615,"چون خبر یابد دلش زین وقت نقل","عاشق آن وقت گردد او به عقل","وقتی که دل عاشق از این خبر مطلع می‌شود، در آن زمان عاشق به عقل و خرد خود می‌رسد و احساساتی عاقلانه‌تر می‌یابد."],[615,"چون صفر آید شود شاد از صفر","که پس این ماه می‌سازم سفر","وقتی ماه صفر فرا می‌رسد، باید شاد شد، زیرا با پایان این ماه، سفر جدیدی در پیش است."],[615,"هر شبی تا روز زین شوق هدی","ای رفیق راه اعلی می‌زدی","هر شب تا صبح به شوق توبه و هدایت، ای دوست، تو کوششی می‌کردی."],[615,"گفت هر کس که مرا مژده دهد","چون صفر پای از جهان بیرون نهد","هر کس به من خبر خوش بدهد که وقتی ماه صفر به پایان می‌رسد، بهشت را برای او بشارت می‌دهم."],[615,"که صفر بگذشت و شد ماه ربیع","مژده‌ور باشم مر او را و شفیع","صفر (ماه محرم) به پایان رسید و وارد ماه ربیع (که ماه خوشبختی و برکت است) شدیم. بنابراین، من باید برای او (شخصی که مژده داده) فرستاده و شفیع باشم."],[615,"گفت عکاشه صفر بگذشت و رفت","گفت که جنت ترا ای شیر زفت","عکاشه اعلام کرد که ماه صفر تمام شده و رفته است و به شیر زفت (شیر فربه یا قوی) مژده می‌دهد که بهشت از آن توست."],[615,"دیگری آمد که بگذشت آن صفر","گفت عکاشه ببرد از مژده بر","دیگری (شخصی دیگر) آمد و گفت که از آن صفر (مأموریتی) عبور کرد. او گفت که عکاشه (شخصی نامدار) مژده‌ای را می‌برد."],[615,"پس رجال از نقل عالم شادمان","وز بقااش شادمان این کودکان","پس مردان (رجال) از نقل خبر عالم خوشحال شدند و از بقای آن، این کودکان نیز شادمان شدند."],[615,"چونک آب خوش ندید آن مرغ کور","پیش او کوثر نماید آب شور","مرغ کور که به آب شیرین دسترسی ندارد، در برابر او که به اوصاف بهشت اشاره می‌کند، آب شور را به مثابه کوثر (منبعی از آب زلال و خوش) تصور می‌کند. این نشان‌دهنده ناتوانی در درک خوشی‌ها و زیبایی‌هاست."],[615,"هم‌چنین موسی کرامت می‌شمرد","که نگردد صاف اقبال تو درد","موسی (پیامبر) نیز مقام و عظمت خود را می‌شمارد و در عین حال تأکید می‌کند که نیکروزی و خوش‌اقبالی بدون درد و رنج حاصل نمی‌شود."],[615,"گفت احسنت و نکو گفت ولیک","تا کنم من مشورت با یار نیک","گفتن این جمله زیبا است، اما من باید با دوست خوبم مشورت کنم تا تصمیم بهتری بگیرم."],[616,"باز گفت او این سخن با ایسیه","گفت جان افشان برین ای دل‌سیه","فرعون به ایسیه (همسرش) گفت: «این سخن را دوباره بگو، ای کسی که دل سیاه داری و به من جان‌فشانی کن."],[616,"بس عنایتهاست متن این مقال","زود در یاب ای شه نیکو خصال","این متن با عنایت‌ها و لطف‌های زیادی همراه است، ای پادشاه با نیکوترین خلق و خوی، زود این را درک کن."],[616,"وقت کشت آمد زهی پر سود کشت","این بگفت و گریه کرد و گرم گشت","زمانی که فصل کشت فرا رسید، شکرانه این نعمت را بیان کرد و اشک ریخت و به شدت خوشحال شد."],[616,"بر جهید از جا و گفتا بخ لک","آفتابی تاجرت گشت ای کلک","فرعون از جا برخاست و با شگفتی گفت: ای نویسنده (کلک)، امانت تو (آفتاب) به من چه ارزشی بخشیده است!"],[616,"عیب کل را خود بپوشاند کلاه","خاصه چون باشد کله خورشید و ماه","عیب و نقص تمام افراد را کلاه خاصه می‌پوشاند، مانند اینکه نور خورشید و ماه به‌قدری درخشان است که روی نقص‌ها و ضعف‌ها را می‌پوشاند."],[616,"هم در آن مجلس که بشنیدی تو این","چون نگفتی آری و صد آفرین","چرا در آن مجلسی که این سخنان را شنیدی، به‌جای پاسخ مثبت و تحسین، چیزی نگفتی و حرفی نزداری؟"],[616,"این سخن در گوش خورشید ار شدی","سرنگون بر بوی این زیر آمدی","اگر این سخن را در گوش خورشید هم بگویی، گویا سر به زیر می‌اندازد و به خاطر این عطر و بوی خوش می‌آید پایین."],[616,"هیچ می‌دانی چه وعده‌ست و چه داد","می‌کند ابلیس را حق افتقاد","آیا می‌دانی ابلیس چه وعده‌ای از سوی خداوند دریافت کرده و چه مسوولیتی بر دوش او گذاشته شده است؟"],[616,"چون بدین لطف آن کریمت باز خواند","ای عجب چون زهره‌ات بر جای ماند","اگر با لطف خداوندی تو به سوی حق بازگشتی، شگفت‌انگیز است که در این حالت، شجاعت و جرأت تو همچنان پابرجا مانده است."],[616,"زهره‌ات ندرید تا زان زهره‌ات","بودی اندر هر دو عالم بهره‌ات","زهره‌ات (جرات و شهامت تو) آسیب نرساند و به هم نریخت، چرا که وجود تو (و جرات تو) در این دو عالم برایت منفعت و فایده زیادی داشت."],[616,"زهره‌ای کز بهره حق بر درد","چون شهیدان از دو عالم بر خورد","زهره‌ای که به خاطر برخورداری از نعمت‌های الهی، از درد و رنج مانند شهیدان زندگی می‌کند و از هر دو جهان، بهره‌ای می‌برد."],[616,"غافلی هم حکمتست و این عمی","تا بماند لیک تا این حد چرا","غفلت خود نیز نوعی حکمت و معرفت است، اما به شرطی که ادامه یابد؛ بنابراین، جای تعجب است که چرا این آگاهی این‌قدر محدود و ناقص باقی می‌ماند."],[616,"غافلی هم حکمتست و نعمتست","تا نپرد زود سرمایه ز دست","غفلت هم خود نوعی حکمت و نعمت است، اما این نعمت تا زمانی است که به سرعت سرمایه‌ات را از دست ندهی."],[616,"لیک نی چندانک ناسوری شود","زهر جان و عقل رنجوری شود","ولی نه، به اندازه‌ای که نادانی بر انسان غلبه کند، زهرها جان و عقلش را رنجور می‌کند."],[616,"خود کی یابد این چنین بازار را","که به یک گل می‌خری گلزار را","هیچ کس نمی‌تواند به این سادگی به چنین طرز خرید و فروش، یعنی با یک گل باغی را به‌دست آورد."],[616,"دانه‌ای را صد درختستان عوض","حبه‌ای را آمدت صد کان عوض","یک دانه را به قیمت صد درخت می‌خرند، و یک حبه جو را هم به قیمت صد کان طلا به تو می‌دهند."],[616,"کان لله دادن آن حبه است","تا که کان‌الله له آید به دست","دادن آن دانه به خدا یعنی فدای آن کردن، سبب می‌شود که آن دانه، در نهایت از جانب خدا به دست فرد دیگری برسد."],[616,"زآنک این هوی ضعیف بی‌قرار","هست شد زان هوی رب پایدار","زیرا این هوی (خواست و تمایلات دنیوی) ضعیف و ناپایدار است و نمی‌تواند آرامش دهد، در مقابل هوی رب (خواست خداوند) که پایدار و همیشگی است."],[616,"هوی فانی چونک خود فا او سپرد","گشت باقی دایم و هرگز نمرد","هوی، یا نفس سرکش و فانی انسان، وقتی که خود را به دست خدا می‌سپارد، جاودانی می‌شود و هرگز نمی‌میرد."],[616,"هم‌چو قطره خایف از باد و ز خاک","که فنا گردد بدین هر دو هلاک","مانند قطره‌ای که از باد و خاک می‌ترسد و می‌داند به خاطر این دو در معرض نابودی و فنا قرار دارد."],[616,"چون به اصل خود که دریا بود جست","از تف خورشید و باد و خاک رست","انسان در اصل، مانند دریا بزرگ و بی‌کران است، اما به خاطر تأثیرات محیطی مانند نور خورشید، باد و خاک، از این ماهیت واقعی خود دور شده و دچار نقصان شده است."],[616,"ظاهرش گم گشت در دریا و لیک","ذات او معصوم و پا بر جا و نیک","ظاهر این قطره در دریا پنهان شده است، اما حقیقت او پاک و ثابت و نیکو باقی مانده است."],[616,"هین بده ای قطره خود را بی‌ندم","تا بیابی در بهای قطره یم","ای قطره، بدون تردید و شجاعت، خودت را به دریا بسپار تا ارزش و بهایی که داری را در آغوش دریا پیدا کنی."],[616,"هین بده ای قطره خود را این شرف","در کف دریا شو آمن از تلف","ای قطره، چگونه می‌توانی از خودت چشم‌پوشی کنی و به دریا بپیوندی؟ وقتی به دریا ملحق شوی، دیگر نگران نابودی خود نخواهی بود."],[616,"خود کرا آید چنین دولت به دست","قطره‌ را بحری تقاضاگر شدست","کسی که این‌گونه نیکی و رفعت را به دست آورده، چه کسی است؟ این‌جا، قطره‌ای که به دریا وابسته است، در حال درخواست از دریایی که پر از گوهر است، قرار دارد."],[616,"الله الله زود بفروش و بخر","قطره‌ای ده بحر پر گوهر ببر","خدا را به‌خاطر بیاور و فوری اقدام کن؛ بخر و بفروش، تا بتوانی از این قطره آب، دریایی پر از گوهر به‌دست‌آوری."],[616,"الله الله هیچ تاخیری مکن","که ز بحر لطف آمد این سخن","به خدا پناه ببر و هیچ‌گونه درنگی نکن؛ زیرا این سخن از دریای لطف و رحمت خداوند نشأت می‌گیرد."],[616,"لطف اندر لطف این گم می‌شود","که اسفلی بر چرخ هفتم می‌شود","لطف الهی بر لطف‌های دیگر پنهان می‌شود، به‌طوری که موجودات پایین‌تر از آسمان به مقام بالاتر می‌رسند."],[616,"هین که یک بازی فتادت بوالعجب","هیچ طالب این نیابد در طلب","اینجا به فرعون هشدار می‌دهد که تو در یک بازی عجیب و غریب افتاده‌ای. هیچ کس مانند تو در جستجوی این نوع نعمت‌ها و حال و هواهایی که به آن مبتلا شده، نخواهد بود."],[616,"گفت با هامان بگویم ای ستیر","شاه را لازم بود رای وزیر","فرعون به هامان می‌گوید که لازم است او هم با من مشورت کند و باید احساسات خود را درباره شاه به من بگوید."],[616,"گفت با هامان مگو این راز را","کور کمپیری چه داند باز را","فرعون به هامان می‌گوید که این راز را برای او باز نکن، زیرا کور کم‌پیر (شخصی که عاقل و با تجربه نیست) چه می‌داند و چه کسی را در این مورد آگاه می‌کند."],[617,"باز اسپیدی به کمپیری دهی","او ببرد ناخنش بهر بهی","باز، که پرنده‌ای تیزپرواز و شگفت‌انگیز است، به زنی سالخورده (کمپیر) وعده می‌دهد که اگر او ناخنش را در اختیارش بگذارد، او به خاطر این هدیه، شکار خوبی برایش می‌آورد."],[617,"ناخنی که اصل کارست و شکار","کور کمپیری ببرد کوروار","ناخنی که در واقع کار اصلی و اساسی است، بریده‌ای از شکار است که کمپیر زن (زن سالخورده) را بدجوری آسیب زده و او را عاجز کرده است."],[617,"که کجا بودست مادر که ترا","ناخنان زین سان درازست ای کیا","ای کیا، مادر تو کجا بوده که ناخن‌هایت این‌قدر دراز است؟"],[617,"ناخن و منقار و پرش را برید","وقت مهر این می‌کند زال پلید","زال پلید، در وقت مهر، ناخن و منقار و پر پرنده را می‌برد، که نشان‌دهنده تبدیل یا تغییری در حالت است."],[617,"چونک تتماجش دهد او کم خورد","خشم گیرد مهرها را بر درد","وقتی او (مهر) به گنجشک کم‌غذا می‌دهد، خشمگین می‌شود و مهرها (عشق‌ها و محبت‌ها) را به خاطر دردهایش نادیده می‌گیرد."],[617,"که چنین تتماج پختم بهر تو","تو تکبر می‌نمایی و عتو","من برای تو این‌قدر زحمت کشیدم، اما تو با کبر و غرور خود را بزرگ می‌کنی و خودخواهی می‌ورزی."],[617,"تو سزایی در همان رنج و بلا","نعمت و اقبال کی سازد ترا","تو سزاوار همان رنج و مصیبت هستی و نعمت و خوشبختی چگونه می‌تواند تو را سر بالا کند و به تو کمک کند؟"],[617,"آب تتماجش دهد کین را بگیر","گر نمی‌خواهی که نوشی زان فطیر","اگر می‌خواهی کینه‌ات را فراموش کنی و آرامش بگرفتی، باید آب تتماج (آب تند و متلاطم) دل را بپذیری. در غیر این صورت، از آن نان (فطیر) نخواهی نوشید و در رنج خواهی ماند."],[617,"آب تتماجش نگیرد طبع باز","زال بترنجد شود خشمش دراز","اگر آب زلال و شفاف بر او نریزد، طبع باز زال (زال، شخصیت معروف در شاهنامه) دچار ناراحتی و کینه می‌شود و خشم او بسیار طولانی و شدید خواهد شد."],[617,"از غضب شربای سوزان بر سرش","زن فرو ریزد شود کل مغفرش","از خشم و عصبانیت شربای سوزان بر سر او (زال) ریخته می‌شود و تمام کلاهش (مغفر) را می‌پوشاند."],[617,"اشک از آن چشمش فرو ریزد ز سوز","یاد آرد لطف شاه دل‌فروز","چشم‌های او از شدت اندوه، اشک می‌ریزد و به یاد لطف و محبت دل‌فروز شاه، دلش دچار سوز و گداز می‌شود."],[617,"زان دو چشم نازنین با دلال","که ز چهره شاد دارد صد کمال","از آن دو چشم دل‌فریب و زیبا که با زیبایی و شادابی چهره، صفات و فضایل بسیاری را به نمایش می‌گذارند."],[617,"چشم مازاغش شده پر زخم زاغ","چشم نیک از چشم بد با درد و داغ","چشم زاغ (پرنده‌ای سیاه) پر از زخم شده است، زیرا چشم خوب را به خاطر چشم بد تحمل کرده و به این درد و رنج مبتلا شده است."],[617,"چشم دریا بسطتی کز بسط او","هر دو عالم می‌نماید تار مو","چشم دریا با وسعتی که دارد، به قدری بزرگ است که به خاطر وسعتش، هر دو جهان را چون تار مویی کوچک می‌نماید."],[617,"گر هزاران چرخ در چشمش رود","هم‌چو چشمه پیش قلزم گم شود","اگر هزاران چرخ (یعنی گردونه‌های زندگی و هستی) در چشم او (چشم دریا) بیفتد، مانند چشمه‌ای است که در برابر دریا گم می‌شود و از نظر خارج می‌شود."],[617,"چشم بگذشته ازین محسوسها","یافته از غیب‌بینی بوسها","چشم او از دنیای مادی فراتر رفته و با توانایی غیب‌بینی، به درک و شناختی عمیق‌تر و غیرمادی دست یافته است."],[617,"خود نمی‌یابم یکی گوشی که من","نکته‌ای گویم از آن چشم حسن","من نمی‌توانم درک کنم که کجا باید صحبت کنم، چون می‌خواهم نکته‌ای درباره چشم زیبای او بگویم، اما خودم گوش و صدایی برای گفتن ندارم."],[617,"می‌چکید آن آب محمود جلیل","می‌ربودی قطره‌اش را جبرئیل","آب محمود جلیل، که اشاره به آب حیات یا علمش دارد، به قدری با ارزش و پاک است که جبرئیل، فرشته‌ای بزرگ، حتی یک قطره از آن را می‌رباید."],[617,"تا بمالد در پر و منقال خویش","گر دهد دستوریش آن خوب کیش","اگر آن زن زیبا (کمپیر زن) بخواهد بر پر و بال خود (دودمان یا پایه‌اش) بمالد، در صورتی که دستوراتی که آن مرد زیبا (معشوق) می‌دهد را قبول کند."],[617,"باز گوید خشم کمپیر ار فروخت","فر و نور و علم و صبرم را نسوخت","باز (پرنده‌ای در داستان) می‌گوید که اگر کمپیر (زنی از داستان) خشمش را فروخت، یعنی او را آرام کرد، او فر و نور (نیک‌نامی و روشنایی) و علم و صبرش را از دست نخواهد داد."],[617,"باز جانم باز صد صورت تند","زخم بر ناقه نه بر صالح زند","باز، جانم، دوباره، صد صورت تند و زخم بر ناقه (سمبل تنهایی و بی‌کسی) می‌زند، نه بر صالح (شخص صالح و درستکار). این بیت نشان می‌دهد که آسیب و رنج واقعی از نادرستی‌ها و بی‌توجهی به وجود خود فرد ناشی می‌شود، نه از دست دیگران."],[617,"صالح از یک‌دم که آرد با شکوه","صد چنان ناقه بزاید متن کوه","صالح اگر فقط یک دم با طرز و شکوه خاصی ظاهر شود، صد ناقه‌ای مثل آنچه از کوه به دنیا می‌آید، خواهد آفرید."],[617,"دل همی گوید خموش و هوش دار","ورنه درانید غیرت پود و تار","دل به انسان توصیه می‌کند که سکوت کند و هوشیار باشد؛ اگر نه، غیرت و شرف او در خطر می‌افتد و آسیب می‌بیند."],[617,"غیرتش را هست صد حلم نهان","ورنه سوزیدی به یک دم صد جهان","غیرت او که حسی است بسیار قوی، قادر به تحمل و صبر زیاد است؛ و اگر این غیرت نبود، او می‌توانست در یک لحظه به راحتی صد جهان را بسوزاند."],[617,"نخوت شاهی گرفتش جای پند","تا دل خود را ز بند پند کند","پادشاه به جای توجه به نصیحت‌ها، دچار خودبزرگ‌بینی و خودپسندی شده است و تصمیم دارد دل خودش را از قید و بند این نصیحت‌ها آزاد کند."],[617,"که کنم با رای هامان مشورت","کوست پشت ملک و قطب مقدرت","من با مشورت چه کسی باید صحبت کنم که او پشتوانه‌ی ملک و محور قدرت است؟"],[617,"مصطفی را رای‌زن صدیق رب","رای‌زن بوجهل را شد بولهب","مصطفی (پیامبر اسلام) مشاور سیاسی و راستینی دارد، ولی مشاور بوجهل (از دشمنان پیامبر) مانند بولهب، به او خیانت کرد و نمی‌تواند به او نصیحت درستی بدهد."],[617,"عرق جنسیت چنانش جذب کرد","کان نصیحتها به پیشش گشت سرد","عطر و جذابیت جنسیت باعث شد که نصیحت‌ها و توصیه‌ها برای او بی‌اثر و بی‌اهمیت شوند."],[617,"جنس سوی جنس صد پره پرد","بر خیالش بندها را بر درد","عواطف و احساسات یک جنس، به سمت جنس دیگر جذب می‌شود و این باعث می‌شود که او همه‌چیز را به صورت غم و درد ببیند."],[618,"یک زنی آمد به پیش مرتضی","گفت شد بر ناودان طفلی مرا","زنی به نزد مرتضی علی (ع) آمد و گفت که طفلم بر لبه ناودان نشسته است."],[618,"گرش می‌خوانم نمی‌آید به دست","ور هلم ترسم که افتد او به پست","هرچند که من او را صدا می‌زنم، به من نمی‌آید و اگر او را هل دهم، می‌ترسم که او به پایین بیفتد."],[618,"نیست عاقل تا که دریابد چون ما","گر بگویم کز خطر سوی من آ","عاقل واقعی کسی است که مثل من متوجه خطراتی که در اطرافش وجود دارد، باشد. اگر بگویم که در خطر هستم، هیچ کس درک نمی‌کند."],[618,"هم اشارت را نمی‌داند به دست","ور بداند نشنود این هم بدست","نه تنها شخص عاقل نمی‌تواند به رمز و اشارات پی ببرد، بلکه اگر هم آنها را بشناسد، باز هم از شنیدن این موضوع غافل خواهد ماند."],[618,"بس نمودم شیر و پستان را بدو","او همی گرداند از من چشم و رو","من به او شیر و پستان را نشان دادم، اما او همچنان از من روی برمی‌گرداند و چشم نمی‌دوشد."],[618,"از برای حق شمایید ای مهان","دستگیر این جهان و آن جهان","ای مهمانان بزرگ و ارجمند، شما برای خداوند آمده‌اید و اوست که در این دنیا و آن دنیا حامی و پشتیبان شما خواهد بود."],[618,"زود درمان کن که می‌لرزد دلم","که بدرد از میوه دل بسکلم","دل من به شدت می‌لرزد و احساس درد می‌کند، پس زود باش و مرا درمان کن، زیرا از میوه محبوبم به شدت رنج می‌برم."],[618,"گفت طفلی را بر آور هم به بام","تا ببیند جنس خود را آن غلام","گفت مادر بچه را به بام ببرد تا او هم جنس خود، یعنی همسالانش را، ببیند و با آنها آشنا شود."],[618,"سوی جنس آید سبک زان ناودان","جنس بر جنس است عاشق جاودان","کودک به طور طبیعی به سمت جنس خود می‌رود، چون بین چیزهایی که دوست دارد و به آن‌ها تعلق دارد، احساس علاقه و محبت دائمی دارد."],[618,"زن چنان کرد و چو دید آن طفل او","جنس خود خوش خوش بدو آورد رو","زن این‌طور عمل کرد و وقتی که آن کودک خود را در خطر دید، به سمت او آمد تا به او کمک کند، زیرا او مادر همان بچه است و احساس تعلق و محبت به او دارد."],[618,"سوی بام آمد ز متن ناودان","جاذب هر جنس را هم جنس دان","زن به سمت بام آمد و از داخل ناودان، آهنگ هر جنس را می‌شنید و می‌دانست که آن‌ها چه جنسی هستند."],[618,"غژغژان آمد به سوی طفل طفل","وا رهید او از فتادن سوی سفل","طفل، به سمت ناودان غژغژان (سر و صداکنان) می‌آمد و وقتی صدای غژغژ را شنید، از افتادن به سمت پایین ترسید و دور شد."],[618,"زان بود جنس بشر پیغامبران","تا بجنسیت رهند از ناودان","بخاطر این است که جنس بشر، پیامبران دارند تا از جنسیت و طبیعت انسانی خود خارج شوند و از خطر سقوط برهند."],[618,"پس بشر فرمود خود را مثلکم","تا به جنس آیید و کم گردید گم","پس خداوند به بشر فرمود که مانند شما است تا به جنسیت (گویش و درک دنیایی) بیاید و در این حالت کمتر گمراه شود."],[618,"زانک جنسیت عجایب جاذبیست","جاذبش جنسست هر جا طالبیست","زیرا ویژگی جنسیت، شگفتی‌های جذب‌کننده‌ای دارد و هر جا که طلبی وجود داشته باشد، آن جذب‌ها نیز رخ می‌دهد."],[618,"عیسی و ادریس بر گردون شدند","با ملایک چونک هم‌جنس آمدند","عیسی و ادریس، که هر دو پیامبرند، به آسمان رفتند و با ملائک (فرشتگان) ارتباط برقرار کردند، زیرا هر دوی آن‌ها از جنس نور و پاکی بودند که سبب نزدیکی و هماهنگی‌شان با فرشتگان شد."],[618,"باز آن هاروت و ماروت از بلند","جنس تن بودند زان زیر آمدند","هاروت و ماروت، دو فرشته، از مقام و جایگاه بلند خود، به خاطر آنکه به بدن و جنس مادی تعلق داشتند، به پایین آمدند."],[618,"کافران هم جنس شیطان آمده","جانشان شاگرد شیطانان شده","کافران همانند شیطان‌ها هستند و روح آن‌ها تحت تعلیم و آموزش شیطان‌ها قرار گرفته است."],[618,"صد هزاران خوی بد آموخته","دیده‌های عقل و دل بر دوخته","انسان‌ها آموخته‌اند که هزاران ویژگی زشت و ناپسند دارند و عقل و دلشان به این بدی‌ها مشغول شده و خیره است."],[618,"کمترین خوشان به زشتی آن حسد","آن حسد که گردن ابلیس زد","کمترین افراد خوشحال‌تر، به زشتی حسد می‌پردازند، حسدی که باعث شد ابلیس از درگاه خداوند رانده شود."],[618,"زان سگان آموخته حقد و حسد","که نخواهد خلق را ملک ابد","از آن سگ‌ها آموخته شده‌اند که در حسد و کینه ورزی بی‌نهایت هستند و نمی‌خواهند دیگران به ایامی جاودانه و خوشی برسند."],[618,"هر کرا دید او کمال از چپ و راست","از حسد قولنجش آمد درد خاست","هر کسی که از خوبی و کمال دیگران به ویژه از دو طرف (چپ و راست) حسد ببرد، دچار درد و رنج می‌شود و احساس نارضایتی در او ایجاد می‌شود."],[618,"زآنک هر بدبخت خرمن‌سوخته","می‌نخواهد شمع کس افروخته","کسی که در زندگی خود دچار مصیبت و فاجعه شده، دلش نمی‌خواهد که دیگران به آن‌ها کمک کنند یا شمعی برایشان روشن کنند تا روشنایی بگیرند."],[618,"هین کمالی دست آور تا تو هم","از کمال دیگران نفتی به غم","به خود بیا و کوشش کن تا به کمال و مقام خود برسی، زیرا اگر به کمال دیگران حسادت کنی، خود را در غم و اندوه می‌افکنی."],[618,"از خدا می‌خواه دفع این حسد","تا خدایت وا رهاند از جسد","از خدا می‌خواهم که این حسد را از من دور کند تا تو را از بدن و جسم مادی آزاد سازد."],[618,"مر ترا مشغولیی بخشد درون","که نپردازی از آن سوی برون","تو مشغولی و غرق در تفکرات و دغدغه‌هایی هستی که تو را از دنیای بیرون غافل کرده است و نمی‌توانی از آنها رهایی یابی."],[618,"جرعه می را خدا آن می‌دهد","که بدو مست از دو عالم می‌دهد","خدا آنقدر به انسان نوشیدنی عرفانی می‌دهد که او از هر دو دنیای مادی و معنوی به کلی مست و غافل می‌شود."],[618,"خاصیت بنهاده در کف حشیش","کو زمانی می‌رهاند از خودیش","خاصیتی که در گیاه حشیش نهفته است، گاهی انسان را از نفس و خودخواهی‌اش رها می‌سازد."],[618,"خواب را یزدان بدان سان می‌کند","کز دو عالم فکر را بر می‌کند","خداوند خواب را به گونه‌ای تنظیم کرده است که انسان را از دو جهان (دنیا و آخرت) آزاد می‌کند و به تفکر و اندیشه می‌پردازد."],[618,"کرد مجنون را ز عشق پوستی","کو بنشناسد عدو از دوستی","عشق مجنون را به گونه‌ای تغییر داده که پوست و ظاهر او را عوض کرده است، به‌طوری که دشمنانش نمی‌توانند او را از دوستانش تشخیص دهند."],[618,"صد هزاران این چنین می‌دارد او","که بر ادراکات تو بگمارد او","او به‌طور مکرر و به طرق مختلف، چیزهایی را بر عقل و فهم تو تحمیل می‌کند که درک آن‌ها برایت دشوار است."],[618,"هست میهای شقاوت نفس را","که ز ره بیرون برد آن نحس را","نفس انسان دارای شقاوت و مشکلاتی است که این مشکلات او را از راه راست منحرف می‌کند و به سمت تباهی می‌برد."],[618,"هست میهای سعادت عقل را","که بیابد منزل بی‌نقل را","شراب‌های عقل و آگاهی وجود دارند که فرد را به مقصدی می‌برند بدون اینکه نیاز به وسایل و ابزاری باشد."],[618,"خیمه گردون ز سرمستی خویش","بر کند زان سو بگیرد راه پیش","خیمه آسمان به خاطر سرمستی و شادی من از سر جای خود برمی‌خیزد و از آن‌سو به سمت جلو حرکت می‌کند. این نشان‌دهنده آن است که شادی و نشناختن خود می‌تواند دنیای اطراف را تحت تاثیر قرار دهد."],[618,"هین بهر مستی دلا غره مشو","هست عیسی مست حق خر مست جو","ای دل، برای مستی خود فریب نخور، زیرا عیسی (پیامبر) به حقیقت مستی می‌رسد، نه به مستی‌های ظاهری؛ بنابراین به دنبال مستی حقیقی برو."],[618,"این چنین می را بجو زین خنبها","مستی‌اش نبود ز کوته دنبها","می باید در پی چنین می‌ای بود که مستی آن از خنب‌ها (نقص‌ها) نیست و به دلیل کوتاهی دنباله‌ها (عواقب یا اثرات) نمی‌تواند به حقیقت برسد."],[618,"زانک هر معشوق چون خنبیست پر","آن یکی درد و دگر صافی چو در","زیرا هر معشوق مانند خنکای است که در آن، یک درد وجود دارد و در عوض، یکی دیگر از معشوق‌ها پاک و بدون آلودگی است."],[618,"می‌شناسا هین بچش با احتیاط","تا میی یابی منزه ز اختلاط","مراقب باش که هوشیارانه بچشی، تا شرابی را پیدا کنی که از آلودگی‌ها به دور باشد و خالص باشد."],[618,"هر دو مستی می‌دهندت لیک این","مستی‌ات آرد کشان تا رب دین","هر دو نوع مستی، یعنی مستی عشق و مستی دنیا، تو را می‌دهند، اما این مستی که از عشق می‌گیری، تو را به سوی دین و حقیقت می‌کشاند."],[618,"تا رهی از فکر و وسواس و حیل","بی عقال این عقل در رقص‌الجمل","برای رهایی از فکر و وسواس و تدبیرهای بی‌فایده، باید این عقل را که همچون شتری در رقص مانده، از قید و بند آزاد کرد."],[618,"انبیا چون جنس روحند و ملک","مر ملک را جذب کردند از فلک","پیامبران مانند روح هستند و ملک (فرشته) از عرش (فلک) آن‌ها را جذب کرده است."],[618,"باد جنس آتش است و یار او","که بود آهنگ هر دو بر علو","باد، که از جنس آتش است، همواره در پی یار خود می‌گردد و هر دو به سمت علو و بلندی کشش دارند."],[618,"چون ببندی تو سر کوزه تهی","در میان حوض یا جویی نهی","وقتی که سر کوزه خالی را ببندی و آن را در وسط حوض یا جوی آب قرار دهی، نشان می‌دهد که چیزی در آن نیست و فضایی برای ورود آب وجود ندارد."],[618,"تا قیامت آن فرو ناید به پست","که دلش خالیست و در وی باد هست","درون [ کوزه ] فضایی خالیست و در آن فضا هوا( باد ) هست، [از این رو، کوزه] تا ابد هم به زیر آب فرو نخواهد رفت [چون میل هوا همانند آتش، حرکت به سوی بالاست و کوزه را با خود به بالا می‌کشد]."],[618,"میل بادش چون سوی بالا بود","ظرف خود را هم سوی بالا کشد","میل و کشش باد به سمت بالا باعث می‌شود که ظرفی که در آن قرار دارد نیز به سمت بالا حرکت کند. به عبارت دیگر، هر چیزی که تمایل و جاذبه‌ای داشته باشد، آن چیز را به سمت خود می‌کشد."],[618,"باز آن جانها که جنس انبیاست","سوی‌ایشان کش کشان چون سایه‌هاست","جان‌های پاک و باطنی که از جنس پیامبران هستند، مانند سایه‌ها به سوی آن‌ها کشیده می‌شوند."],[618,"زانک عقلش غالبست و بی ز شک","عقل جنس آمد به خلقت با ملک","زیرا عقل او بر نفسش چیره است و بدون شک، عقل در خلقت (انسان) با فرشتگان هم‌جنس است."],[618,"وان هوای نفس غالب بر عدو","نفس جنس اسفل آمد شد بدو","هوا و خواسته‌های نفس، وقتی بر دشمنان درونی غالب می‌شود، به سرشت پست و پایین می‌انجامد."],[618,"بود قبطی جنس فرعون ذمیم","بود سبطی جنس موسی کلیم","قبطی که از جنس فرعون و متعلق به او بود، دارای صفات ناپسندی است، در حالی که سبطی (از نسل) موسی کلیم از جنس و صفات او (موسی) به حساب می‌آید و در واقع نشان‌دهنده خوبی‌ها و فضیلت‌هاست."],[618,"بود هامان جنس‌تر فرعون را","برگزیدش برد بر صدر سرا","هامان، که نماینده پستی و فساد در فرعون بود، از سوی فرعون برتر از دیگران انتخاب شد و او را تا بالاترین جایگاه برداشت."],[618,"لاجرم از صدر تا قعرش کشید","که ز جنس دوزخ‌اند آن دو پلید","در نتیجه، او (فرعون) آن‌ها را از بالای جایگاه تا پایین گرفت، چرا که آن دو پلید از جنس دوزخ هستند."],[618,"هر دو سوزنده چو ذوزخ ضد نور","هر دو چون دوزخ ز نور دل نفور","هر دو (آن دو پلید) باعث سوزش و آتش‌سوزی هستند و مانند دوزخ از نور بیزارند؛ یعنی هر دو از نور ایمان و خوبی متنفرند و در برابر آن می‌سوزند."],[618,"زانک دوزخ گوید ای مؤمن تو زود","برگذر که نورت آتش را ربود","دوزخ به مؤمن می‌گوید که زود از اینجا بگذر، زیرا نور تو آتش دوزخ را خاموش می‌کند."],[618,"می‌رمد آن دوزخی از نور هم","زانک طبع دوزخستش ای صنم","دوزخ از نور می‌گریزد، زیرا طبیعت آن دوزخ در تضاد با نور است، ای دلبر من."],[618,"دوزخ از مومن گریزد آنچنان","که گریزد مومن از دوزخ به جان","دوزخ از مومن دوری می‌کند و فرار می‌کند از او، همان‌طور که مومن با تمام وجودش از دوزخ فرار می‌کند."],[618,"زانک جنس نار نبود نور او","ضد نار آمد حقیقت نورجو","چون مؤمن از آتش دوزخ گریزان است، روح او به نور و حقیقت نزدیک است و این نور در ذات او وجود دارد، بنابراین او جنس آتش نیست و حقیقتا نور را جستجو می‌کند."],[618,"در حدیث آمد که مومن در دعا","چون امان خواهد ز دوزخ از خدا","در روایتی گفته شده که مؤمن وقتی از خداوند در دعا امنیتی می‌خواهد، از آتش دوزخ درخواست می‌کند."],[618,"دوزخ از وی هم امان خواهد به جان","که خدایا دور دارم از فلان","مؤمن در دعا از خدا می‌خواهد که او را از عذاب دوزخ محفوظ نگه دارد و در این خواسته، به خصوص از خطر معینی در امان باشد."],[618,"جاذبه جنسیتست اکنون ببین","که تو جنس کیستی از کفر و دین","جاذبه جنسیت نشان‌دهنده ارتباط میان افراد است. حالا ببین که تو به کدام جنس تعلق داری، آیا به کفر تعلق داری یا به ایمان (دین)."],[618,"گر بهامان مایلی هامانیی","ور به موسی مایلی سبحانیی","اگر به کسانی که در حال گناه و نادرستی هستند تمایل داری، به آنها شبیه خواهی شد، و اگر به موسی (پیامبر) علاقه‌مند باشی، در چهره‌ات صفات الهی و پاکی نمایان خواهد شد."],[618,"ور بهر دو مایلی انگیخته","نفس و عقلی هر دوان آمیخته","اگر به هر دو طرف تمایل داری، نفس و عقل را به فعالیت و تحریک درآورده‌ای که هر دو با هم در هم آمیخته شده‌اند."],[618,"هر دو در جنگند هان و هان بکوش","تا شود غالب معانی بر نقوش","هر دو (نفس و عقل) در حال مبارزه هستند، پس تلاش کن تا معانی بر ظواهر و شکل‌ها غلبه پیدا کنند."],[618,"در جهان جنگ شادی این بسست","که ببینی بر عدو هر دم شکست","در این جهان، شادی واقعی این است که هر لحظه دشمن را ببینی که زمین‌گیر و شکست‌خورده می‌شود."],[618,"آن ستیزه‌رو بسختی عاقبت","گفت با هامان برای مشورت","آن شخص جنگجو در نهایت با هامان (یک مشاور) به سختی صحبت کرد تا از او مشورت بگیرد."],[618,"وعده‌های آن کلیم‌الله را","گفت و محرم ساخت آن گمراه را","زبان شاعر به یادآوری وعده‌های موسی (کلیم‌الله) اشاره دارد که او به گمراهان می‌دهد و آنها را به حقیقت نزدیک می‌کند."],[619,"گفت با هامان چون تنهااش بدید","جست هامان و گریبان را درید","فرعون وقتی هامان را به تنهایی دید، او را گرفت و گریبانش را پاره کرد."],[619,"بانگها زد گریه‌ها کرد آن لعین","کوفت دستار و کله را بر زمین","آن فرد پلید (لعین) نداها سر داد و به شدت گریست و دستار (عمامه) و سرش را به زمین کوبید."],[619,"که چگونه گفت اندر روی شاه","این چنین گستاخ آن حرف تباه","چگونه کسی جرأت کرد چنین سخنان زشتی را در مقابل شاه بگوید و او را مورد توهین قرار دهد؟"],[619,"جمله عالم را مسخر کرده تو","کار را با بخت چون زر کرده تو","تمام عالم را تحت سلطه خود درآورده‌ای و کارهایت را به لطف و بخت مانند طلا به بهترین شکل ساخته‌ای."],[619,"از مشارق وز مغارب بی‌لجاج","سوی تو آرند سلطانان خراج","سلطانان از سرزمین‌های دور و نزدیک بدون هیچ گونه کینه و دشمنی مال و ثروت خود را به سوی تو می‌آورند."],[619,"پادشاهان لب همی مالند شاد","بر ستانه خاک تو این کیقباد","پادشاهان با خوشحالی و شادمانی، ثروت و مال خود را به خاک تو، که نماد قدرت و عظمت کیقباد (یکی از پادشاهان افسانه‌ای ایران) است، تقدیم می‌کنند."],[619,"اسپ یاغی چون ببیند اسپ ما","رو بگرداند گریزد بی عصا","وقتی اسب سرکشی به اسب ما نگاه کند، با ترس به جهتی دیگر می‌چرخد و بدون نیاز به عصا فرار می‌کند."],[619,"تاکنون معبود و مسجود جهان","بوده‌ای گردی کمینه بندگان","تو تا به حال خدا و معبودی برای جهانیان بوده‌ای، ولی اکنون تو هم به جایگاه کوچکی از بندگان خدا تبدیل خواهی شد."],[619,"در هزار آتش شدن زین خوشترست","که خداوندی شود بنده‌پرست","بهتر است در برابر هزار مشکل و مصیبت قرار بگیریم و آزمایش‌های سختی را متحمل شویم، تا اینکه خدا را بنده‌ای در برابر خود ببینیم و به او ایسار کنیم."],[619,"نه بکش اول مرا ای شاه چین","تا نبیند چشم من بر شاه این","فرعون به هامان می‌گوید: ای پادشاه چین، ابتدا مرا نکش تا چشم من حضور تو را نبیند و در عظمت تو شک نکند."],[619,"خسروا اول مرا گردن بزن","تا نبیند این مذلت چشم من","فرعون از وزیرش هامان می‌خواهد تا اگر قرار است او را بکشند، اول او را بکشند تا او ذلت و خفت را مشاهده نکند."],[619,"خود نبودست و مبادا این چنین","که زمین گردون شود گردون زمین","این دنیا و حالتی که در آن هستیم واقعی نیست و نباید به آن اعتماد کرد، زیرا ممکن است همچون زمین گردان و تغییرپذیر، در حال ناپایداری و فریب باشد."],[619,"بندگان‌مان خواجه‌تاش ما شوند","بی‌دلان‌مان دلخراش ما شوند","اگر بندگان ما با شرافت و ارزشمند شوند، دل‌های بی‌محبت ما به شدت آزرده و به خاطر مشکلاتشان نگران خواهد شد."],[619,"چشم‌روشن دشمنان و دوست کور","گشت ما را پس گلستان قعر گور","دشمنان ما با روشنایی چشم خود، به طرز عجیبی شاداب و با نشاط هستند، در حالی که دوستان ما در غم و اندوه کور و نابینا شده‌اند، و ما در نهایت به گلستانی در اعماق قبر رفته‌ایم."],[620,"دوست از دشمن همی نشناخت او","نرد را کورانه کژ می‌باخت او","او (دوست) نمی‌توانست دوست را از دشمن تشخیص دهد و مانند نردبازی که کور است، به‌صورت نادرست اقدام می‌کرد و باخت می‌خورد."],[620,"دشمن تو جز تو نبود ای لعین","بی‌گناهان را مگو دشمن به کین","ای لعین، هیچ‌کس جز تو دشمن تو نیست؛ پس به بی‌گناه‌ها نسبت کینه نده."],[620,"پیش تو این حالت بد دولتست","که دوادو اول و آخر لتست","این وضعیت بد و نامساعدی که پیش تو قرار دارد، نشان‌دهنده دولت و احوال است که در آغاز و پایان به تو مربوط می‌شود."],[620,"گر ازین دولت نتازی خز خزان","این بهارت را همی آید خزان","اگر از این حکومت و قدرت (برایت) غافل باشی، خزانه خزان (رنج و سختی) بهار تو را هم به خزان (حالت بد) خواهد برد."],[620,"مشرق و مغرب چو تو بس دیده‌اند","که سر ایشان ز تن ببریده‌اند","مشرق و مغرب (شرق و غرب) نیز مانند تو (حضرت علی) دیده‌اند که سر (رأس) آن‌ها از بدن (تن) جدا شده است، یعنی بسیاری از انسان‌ها به خاطر نافرمانی و بدی‌کردن سرنوشت تلخی دارند."],[620,"مشرق و مغرب که نبود بر قرار","چون کنند آخر کسی را پایدار","مشرق و مغرب، جایی برای ثبات و استحکام ندارند، پس چگونه ممکن است کسی را بتوان سرپا و پایدار دانست؟"],[620,"تو بدان فخر آوری کز ترس و بند","چاپلوست گشت مردم روز چند","تو می‌دانی که باعث افتخار تو این است که مردم به خاطر ترس و وابستگی به تو، مدتی به تو احترام می‌گذارند."],[620,"هر کرا مردم سجودی می‌کنند","زهر اندر جان او می‌آکنند","هر کسی که مردم برای او سجده می‌کنند، در واقع زهر را به جان او می‌ریزند و او را فاسد می‌سازند."],[620,"چونک بر گردد ازو آن ساجدش","داند او کان زهر بود و موبدش","هرگاه ساجد (کسی که سجده می‌کند) بفهمد که سجده‌اش به چه کسی است، درمی‌یابد که سجده بر کسی که زهر است، چه باطل و نادرست است و او را به عنوان موبد (رئیس دینی یا روحانی) نمی‌شناسد."],[620,"ای خنک آن را که ذلت نفسه","وای آنک از سرکشی شد چون که او","خوشا به حال کسی که خود را به ذلت و humility وامی‌دارد و بدبخت آن کسی است که به دلیل خودبرتربینی و سرکشی دچار مشکل و گمراهی می‌شود."],[620,"این تکبر زهر قاتل دان که هست","از می پر زهر شد آن گیج مست","این تکبر را زهر کشنده‌ای بدان که از می زهرآگین به وجود آمد و سبب گیجی و مستی شده است."],[620,"چون می پر زهر نوشد مدبری","از طرب یکدم بجنباند سری","شخصی که هوشیار و با تدبیر است، وقتی از شراب زهرآلود بنوشد، از سر شادی و شگفتی لحظه‌ای سرش را تکان می‌دهد."],[620,"بعد یک‌دم زهر بر جانش فتد","زهر در جانش کند داد و ستد","پس از اینکه زهر بر جان او تاثیر گذاشت، زهر در وجودش به شدت تاثیر می‌گذارد و در درونش شکل معاملات و تغییرات شدیدی را ایجاد می‌کند."],[620,"گر نداری زهری‌اش را اعتقاد","کو چه زهر آمد نگر در قوم عاد","اگر به زهر او اعتقاد نداری، پس چرا درباره‌ی او صحبت می‌کنی و زهر او را بررسی می‌کنی؟ اشاره به قوم عاد می‌کند که یکی از اقوامی هستند که به عذاب الهی مبتلا شدند."],[620,"چونک شاهی دست یابد بر شهی","بکشدش یا باز دارد در چهی","اگر پادشاهی بر شاه دیگر مسلط شود، او را می‌کشد یا در قید و بند نگه می‌دارد."],[620,"ور بیابد خسته افتاده را","مرهمش سازد شه و بدهد عطا","اگر شاهی به فردی خسته و افتاده کمک کند و به او پاداش بدهد، این نشان‌دهنده بزرگی و جوانمردی اوست."],[620,"گر نه زهرست آن تکبر پس چرا","کشت شه را بی‌گناه و بی‌خطا","اگر این تکبر زهر نیست، پس چرا بدون هیچ گناه و خطایی شاه را کشت؟"],[620,"وین دگر را بی ز خدمت چون نواخت","زین دو جنبش زهر را شاید شناخت","در اینجا گفته می‌شود که وقتی شخص دیگری به کسی خدمت نمی‌کند و با او به خوبی رفتار می‌کند، از این دو عمل متضاد ممکن است بتواند به ماهیت زهر (غیرت و دشمنی) پی ببرد."],[620,"راه‌زن هرگز گدایی را نزد","گرگ گرگ مرده را هرگز گزد","راه‌زن هرگز به گدایی نزدیک نمی‌شود، چون او به خوبی می‌داند که گرگ (نماد خطر) حتی اگر مرده باشد، ممکن است هنوز خطرناک باشد. یعنی انسان‌های بد یا خطرناک هرگز به آن‌ها که در وضعیت ضعف و نیاز هستند، نزدیک نمی‌شوند."],[620,"خضر کشتی را برای آن شکست","تا تواند کشتی از فجار رست","خضر (پیامبر کهن) کشتی را عمدا شکست تا بتواند آن را از خطر و فساد نجات دهد."],[620,"چون شکسته می‌رهد اشکسته شو","امن در فقرست اندر فقر رو","زمانی که چیزی شکسته می‌شود، دیگر نتوان آن را به حالت اولیه برگرداند، پس در فقر و نیاز خود را تسلیم کن و به آن عادت کن."],[620,"آن کهی کو داشت از کان نقد چند","گشت پاره پاره از زخم کلند","کسی که از منبع ثروت و نعمت، چیزی به دست آورد، به خاطر زخم‌های مداوم و سختی‌هایی که کشیده، حالا به تکه‌های کوچک و پاره پاره تبدیل شده است."],[620,"تیغ بهر اوست کو را گردنیست","سایه که افکندست بر وی زخم نیست","تیغ برای کسی است که گردنی بلند دارد، زیرا سایه‌ای که بر او می‌افتد، زخم یا کسری بر او نمی‌زند."],[620,"مهتری نفطست و آتش ای غوی","ای برادر چون بر آذر می‌روی","شخصی در مقام بزرگتری و رهبری مانند نفت (به معنای ماده‌ای ارزشمند) و آتش است. ای برادر (دوستان یا مخاطب)، وقتی به آتش (مشکلات یا چالش‌ها) نزدیک می‌شوی، محتاط باش."],[620,"هر چه او هموار باشد با زمین","تیرها را کی هدف گردد ببین","هر چه سطح زمین هموار باشد، تیرها به هدف نمی‌رسند و نمی‌توانند به آنجا اصابت کنند."],[620,"سر بر آرد از زمین آنگاه او","چون هدفها زخم یابد بی رفو","هنگامی که او از زمین بلند می‌شود، مانند هدفی می‌شود که تیرها به او اصابت می‌کنند و زخم می‌خورد، اما هیچ‌گونه ترمیمی برای این زخم‌ها وجود ندارد."],[620,"نردبان خلق این ما و منیست","عاقبت زین نردبان افتادنیست","زندگی انسان و موجودات به مانند نردبانی است که بر این «ما و من» (خودخواهی و ادعاهای شخصی) تکیه دارد، اما در نهایت همگی از این نردبان سقوط خواهیم کرد."],[620,"هر که بالاتر رود ابله‌ترست","که استخوان او بتر خواهد شکست","هر کسی که در زندگی به مقام یا مرتبه‌ای بالا برسد، معمولا دچار نادانی و جهالت بیشتری می‌شود و این افزایش مقام باعث می‌شود آسیب‌پذیری او بیشتر شود."],[620,"این فروعست و اصولش آن بود","که ترفع شرکت یزدان بود","اصول اصلی و بنیادین این مسأله (که در بیت قبل اشاره شده) این است که مقام بالاتر و ارجمندتر به دلیل خودخواهی و برتری‌جویی، انسان را در مسیر خطا قرار می‌دهد و موجب می‌شود که او از یاری و هم‌دلی با خدا و یزدان دور شود."],[620,"چون نمردی و نگشتی زنده زو","یاغیی باشی به شرکت ملک‌جو","اگر نمیرند و زنده نشوند، پس در عوض به زندگی خود ادامه می‌دهند و با زندگی مشترک با یزدان (خدا) به نوعی طغیانی در دنیای مادی می‌پردازند."],[620,"چون بدو زنده شدی آن خود ویست","وحدت محضست آن شرکت کیست","زمانی که به او زنده می‌شوی، آن وجود، خود اوست و این وجود واحد و بی‌نهایت است؛ پس این شرکت و کثرت چه معنایی دارد؟"],[620,"شرح این در آینه اعمال جو","که نیابی فهم آن از گفت و گو","برای درک این حقیقت باید به آینه اعمال خود نگاه کنی، زیرا نمی‌توانی آن را تنها از طریق کلام و گفت‌وگو بفهمی."],[620,"گر بگویم آنچ دارم در درون","بس جگرها گردد اندر حال خون","اگر آنچه که در درونم دارم را بگویم، این‌قدر درد و رنجی که در دل دارم باعث می‌شود جگرها به حال خون بیفتند."],[620,"بس کنم خود زیرکان را این بس است","بانگ دو کردم اگر در ده کس است","من به اندازه کافی از دانایی و خرد افراد زیرک و باهوش در اطرافم گفته‌ام و اگر بخواهم بیشتر بگویم، دیگر صدای من به گوش کسی نخواهد رسید."],[620,"حاصل آن هامان بدان گفتار بد","این چنین راهی بر آن فرعون زد","هامان با آن سخنان ناپسند، به فرعون راهی نشان داد که او را به فساد و خطر انداخت."],[620,"لقمه دولت رسیده تا دهان","او گلوی او بریده ناگهان","دولت و ثروت به او رسیده، اما به خاطر طمع و حرصش، فرعون به مرز نابودی رسیده و در خطر است."],[620,"خرمن فرعون را داد او به باد","هیچ شه را این چنین صاحب مباد","خزانه و دارایی‌های فرعون را به باد داد، و هیچ شاهی نباید چنین عاقبتی داشته باشد."],[621,"گفت موسی لطف بنمودیم و جود","خود خداوندیت را روزی نبود","موسی می‌گوید: ما با لطف و بخشش خود، نعمت‌های الهی‌امان را به فرعون ارزانی داشته‌ایم و این برکتی از خداوند است که همیشه در دسترس نیست."],[621,"آن خداوندی که نبود راستین","مر ورا نه دست دان نه آستین","آن خدایی که حقیقتا وجود ندارد، نه دستانی دارد و نه آستینی، به معنای اینکه چنین خدایی از نظر موسی وجود واقعی ندارد و فقط نامی است بدون معنی."],[621,"آن خداوندی که دزدیده بود","بی دل و بی جان و بی دیده بود","آن خدایی که از تو دور است و تو را از حقیقت خود بی‌خبر کرده، نه دل و جان و نه چشم دارد که تو را به سوی خود بکشاند و از این حال نجات دهد."],[621,"آن خداوندی که دادندت عوام","باز بستانند از تو هم‌چو وام","خدایی که به تو اهل عوام داده، مانند وامی است که می‌توانند دوباره آن را از تو پس بگیرند."],[621,"ده خداوندی عاریت به حق","تا خداوندیت بخشد متفق","اگر خداوندی به تو عطا کرده است، باید این نعمت را در راه حق به کار ببری تا او هم تو را به مقام واقعی‌ات برساند."],[622,"آن امیران عرب گرد آمدند","نزد پیغامبر منازع می‌شدند","امیران عرب گرد هم آمده بودند و با پیامبر اسلام درباره تقسیم حکومت و حاکمیت بحث و اختلاف داشتند."],[622,"که تو میری هر یک از ما هم امیر","بخش کن این ملک و بخش خود بگیر","شما هر کدام که می‌خواهید امیر شوید، در این سرزمین تقسیم کنید و هر یک از ما نیز بخش خود را بگیرید."],[622,"هر یکی در بخش خود انصاف‌جو","تو ز بخش ما دو دست خود بشو","هر کدام از شما در بخش خودتان باید انصاف را رعایت کنید و از بخش ما (یعنی کار و مسئولیت‌های ما) دست بردارید."],[622,"گفت میری مر مرا حق داده است","سروری و امر مطلق داده است","پیامبر (مصطفی علیه‌السلام) می‌گوید که خداوند به من مقام رهبری و فرمانروایی کامل عطا کرده است."],[622,"کین قران احمدست و دور او","هین بگیرید امر او را اتقوا","این قرآنی که از سوی احمد (پیامبر اسلام) نازل شده است، برای شما چراغ راه است و باید به دستورات او پایبند باشید و از نافرمانی پرهیز کنید."],[622,"قوم گفتندش که ما هم زان قضا","حاکمیم و داد امیریمان خدا","قوم به پیامبر (مصطفی علیه‌السلام) گفتند که ما نیز به خاطر آن تقدیر (که از جانب خداوند است) حاکم هستیم و مقام امیری‌امان نیز از سوی خداوند است."],[622,"گفت لیکن مر مرا حق ملک داد","مر شما را عاریه از بهر زاد","پیامبر گفت: اما من به فرمان الهی حق حکومت دارم، در حالی که شما فقط به صورت موقت و عاریه‌وار در این جایگاه قرار دارید تا در سفر زندگی‌تان استفاده کنید."],[622,"میری من تا قیامت باقیست","میری عاریتی خواهد شکست","من تا قیامت در مقام رهبری و فرمانروایی باقی‌ام، ولی این منصب برای تو، به شکل امانتی است و در آینده از بین خواهد رفت."],[622,"قوم گفتند ای امیر افزون مگو","چیست حجت بر فزون‌جویی تو","قوم گفتند ای امیر، دیگر بیشتر از این سخن نگو، دلیل بر ادعای برتری‌جویی تو چیست؟"],[622,"در زمان ابری برآمد ز امر مر","سیل آمد گشت آن اطراف پر","در زمان بارانی که فرمانی صادر شد، سیلی به راه افتاد و اطراف را پر کرد."],[622,"رو به شهر آورد سیل بس مهیب","اهل شهر افغان‌کنان جمله رعیب","سیل بسیار وحشتناکی به سمت شهر آمده است و مردم شهر، به طور جمعی با صدای بلند و فریاد، در حال ترساندن یکدیگر و اظهار وحشت از این اتفاق هستند."],[622,"گفت پیغامبر که وقت امتحان","آمد اکنون تا گمارد گردد عیان","پیامبر (مصطفی) گفت که زمان امتحان فرا رسیده و اکنون مشخص خواهد شد که چگونه باید عمل کرد."],[622,"هر امیری نیزه خود در فکند","تا شود در امتحان آن سیل‌بند","هر امیری نیزه‌اش را به زمین می‌زند تا در این امتحان، آن سد و مانع را برطرف کند."],[622,"پس قضیب انداخت در وی مصطفی","آن قضیب معجز فرمان روا","سپس حضرت محمد (مصطفی) عصا (قضیب) خود را به سوی او (یک امیر) انداخت که این عصا معجزه و نشانه‌ای از فرمانروایی او بود."],[622,"نیزه‌ها را هم‌چو خاشاکی ربود","آب تیز سیل پرجوش عنود","آب خروشان و تند مانند سیل، نیزه‌ها را مانند خاشاکی کوچک و بی‌ارزش با خود برد."],[622,"نیزه‌ها گم گشت جمله و آن قضیب","بر سر آب ایستاده چون رقیب","نیزه‌ها همگی ناپدید شدند و آن چوب (قضیب) در بالای آب ایستاده است مانند یک رقیب."],[622,"ز اهتمام آن قضیب آن سیل زفت","روبگردانید و آن سیلاب رفت","به خاطر اهمیت و حساسیت قضیه و دقت بسیار، آن چوب (قضیب) به‌طور ناگهانی از جای خود حرکت کرد و در نتیجه، آن سیلاب بزرگ به سمت دیگر رفت."],[622,"چون بدیدند از وی آن امر عظیم","پس مقر گشتند آن میران ز بیم","وقتی امیران عرب آن دستور بزرگ و مهم را از او (پیامبر اسلام، مصطفی) دیدند، از ترس به مقر و مکان خود بازگشتند."],[622,"جز سه کس که حقد ایشان چیره بود","ساحرش گفتند و کاهن از جحود","جز سه نفر که کینه و حسد بر آن‌ها چیره شده بود، دیگران او را ساحر یا کاهن نامیدند به خاطر نادانی و انکارشان."],[622,"ملک بر بسته چنان باشد ضعیف","ملک بر رسته چنین باشد شریف","ملک و حکومت وقتی به انسان‌های ضعیف داده شود، ضعیف و ناتوان خواهد بود، اما اگر به افراد شریف و بافضیلت سپرده شود، قدرتمند و باارزش خواهد بود."],[622,"نیزه‌ها را گر ندیدی با قضیب","نامشان بین نام او بین این نجیب","اگر نیزه‌ها را ندیده‌ای، به نام آنها توجه کن؛ به نام او و به نام این نجیب (شخصیت برجسته)، که نمایانگر هویت و مقام او می‌باشد."],[622,"نامشان را سیل تیز مرگ برد","نام او و دولت تیزش نمرد","مرگ سریع و ناگهانی نام‌شان را مانند سیلی خواهد برد، اما نام و دولت او هرگز نمی‌میرد یا نابود نمی‌شود."],[622,"پنج نوبت می‌زنندش بر دوام","هم‌چنین هر روز تا روز قیام","هر روز پنج بار او (پیامبر) را می‌زنند و سختی‌ها را تحمل می‌کند و این وضعیت ادامه دارد تا روز قیامت."],[622,"گر ترا عقلست کردم لطفها","ور خری آورده‌ام خر را عصا","اگر تو عقل داری، من به تو لطف کرده‌ام و حالا برایت خر آورده‌ام، پس خر را به عصا بزن."],[622,"آنچنان زین آخرت بیرون کنم","کز عصا گوش و سرت پر خون کنم","من به گونه‌ای تو را از این دنیا بیرون می‌کنم که به حدی آسیب ببینی که گوش و سرت از خون پر شود."],[622,"اندرین آخر خران و مردمان","می‌نیابند از جفای تو امان","در این دنیا، انسان‌ها و الاغ‌ها از ظلم و ستم تو در امان نخواهند بود."],[622,"نک عصا آورده‌ام بهر ادب","هر خری را کو نباشد مستحب","عصای خود را به‌منظور ادب و تعلیم آورده‌ام، زیرا هر کسی که از رفتار درست دور است، لایق ادب و تذکر است."],[622,"اژدهایی می‌شود در قهر تو","که اژدهایی گشته‌ای در فعل و خو","اگر تو در قهر و خشم خود تغییر کنی و همچون یک اژدها رفتار نمایی، واقعا به اژدهایی تبدیل می‌شوی که در کردار و خصال خود خشمگین است."],[622,"اژدهای کوهیی تو بی‌امان","لیک بنگر اژدهای آسمان","تو اژدهایی بزرگ و بی‌وقفه هستی، اما به خود بیا و ببین که اژدهای آسمان (قدرت‌های بزرگ‌تر) هم هست که می‌تواند بر تو مسلط شود."],[622,"این عصا از دوزخ آمد چاشنی","که هلا بگریز اندر روشنی","این عصا که به دست من است، نشانه‌ای از عذاب و جهنم است، پس هر چه زودتر به روشنایی و نجات بگریز."],[622,"ورنه در مانی تو در دندان من","مخلصت نبود ز در بندان من","اگر تو در چنگال من بمانی، در واقع کسی برای نجات تو از این بند و زنجیر وجود نخواهد داشت."],[622,"این عصایی بود این دم اژدهاست","تا نگویی دوزخ یزدان کجاست","این عصا که در دست من است، نشانه‌ای از قدرت و خطر مثل اژدهاست، تا وقتی که درباره‌ی عذاب جهنم خداوند سوال نپرسید."],[623,"هر کجا خواهد خدا دوزخ کند","اوج را بر مرغ دام و فخ کند","هر کجا که خدا بخواهد، دوزخ را در اوج، بر مرغ (نماد موجوداتی که به دام می‌افتند) ایجاد می‌کند و آن را فریب می‌دهد."],[623,"هم ز دندانت برآید دردها","تا بگویی دوزخست و اژدها","همین که دردها از دندان تو بیرون می‌آید، باعث می‌شود بگویی که دوزخ و موجوداتی مانند اژدها وجود دارند."],[623,"یا کند آب دهانت را عسل","که بگویی که بهشتست و حلل","شاید آب دهانت را شیرین کند تا بگویی که اینجا بهشت است و حلال."],[623,"از بن دندان برویاند شکر","تا بدانی قوت حکم قدر","از عمق دندان شکر می‌ریزد تا بفهمی که قدرت خداوند چقدر بزرگ است."],[623,"پس به دندان بی‌گناهان را مگز","فکر کن از ضربت نامحترز","این بیت به این معناست که نباید با فکر کردن به عذاب‌ها و سختی‌های بی‌گناهان، دچار ترس و اضطراب شد، زیرا این افراد از آسیب‌ها و ضررها محفوظ هستند و نباید به بهانه‌های بی‌اساس، آن‌ها را تحت تأثیر قرار داد."],[623,"نیل را بر قبطیان حق خون کند","سبطیان را از بلا محصون کند","خون نیل (رودی در مصر) بر قبطیان (مصر) موجب شد که سبطیان (موسی و قوم بنی‌اسرائیل) از بلاها و عذاب‌ها در امان بمانند."],[623,"تا بدانی پیش حق تمییز هست","در میان هوشیار راه و مست","برای اینکه بدانی در پیشگاه حق، تمییز و تشخیص وجود دارد، باید بدانید که افراد هوشیار در انتخاب مسیرهای خود متفاوتند و میان راه روشن و مستی، تفاوت قائل می‌شوند."],[623,"نیل تمییز از خدا آموختست","که گشاد آن را و این را سخت بست","رود نیل از خداوند تمییز و تشخیص یافت که چرا جریانش (نرمی و گشادی) چنین است و چرا بعضی موارد (سختی) به شکل دیگری است."],[623,"لطف او عاقل کند مر نیل را","قهر او ابله کند قابیل را","لطف خداوند انسان را عاقل و هوشیار می‌کند، مانند نیل که به واسطه لطف الهی تمایز یافته است، اما قهر و خشم او انسان‌های نادان مانند قابیل را ابله و نادان می‌سازد."],[623,"در جمادات از کرم عقل آفرید","عقل از عاقل به قهر خود برید","در موجودات بی‌جان، خداوند با رحمت خود عقل را آفرید و عقل، به واسطه‌ی قهر و قدرتش، از عاقل (انسان) جدا می‌شود."],[623,"در جماد از لطف عقلی شد پدید","وز نکال از عاقلان دانش رمید","در اشیاء بی‌جان، به واسطه لطف عقل، موجودات زنده و باهوش به وجود می‌آیند، اما عاقلان از این دانش و فهم دور شده و از آن کناره‌گیری می‌کنند."],[623,"عقل چون باران به امر آنجا بریخت","عقل این سو خشم حق دید و گریخت","عقل مانند بارانی است که به دستور خدا در مکانی می‌بارد؛ اما وقتی به چهره‌اش خشم خداوند را می‌بیند، از آن سو فرار می‌کند."],[623,"ابر و خورشید و مه و نجم بلند","جمله بر ترتیب آیند و روند","ابر و خورشید و ماه و ستاره‌های بلند همگی به نحوی منظم و با ترتیبی خاص در آسمان ظاهر می‌شوند و در حرکت هستند."],[623,"هر یکی ناید مگر در وقت خویش","که نه پس ماند ز هنگام و نه پیش","هر چیزی در زمان مشخص خودش به وجود می‌آید و هیچ‌گاه نه از زمان خودش عقب می‌افتد و نه جلوتر می‌رود."],[623,"چون نکردی فهم این را ز انبیا","دانش آوردند در سنگ و عصا","اینکه تو قادر به درک این دانش نیستی، باعث می‌شود انبیا (پیامبران) این را از طریق اشیاء بی‌جانی مثل سنگ و عصا به تو آموزش دهند."],[623,"تا جمادات دگر را بی لباس","چون عصا و سنگ داری از قیاس","اگر تو برای فهم حقایق از جمادات دیگری به جز سنگ و عصا استفاده کنی، باید آن‌ها را در شکلی متفاوت و بدون پوشش در نظر بگیری."],[623,"طاعت سنگ و عصا ظاهر شود","وز جمادات دگر مخبر شود","عصا و سنگ به طاعت و فرمانبری از خداوند ظاهر می‌شوند و از این طریق گواهی می‌دهند که سایر موجودات بی‌جان نیز از چگونگی قدرت و اراده خدا آگاه هستند."],[623,"که ز یزدان آگهیم و طایعیم","ما همه نی اتفاقی ضایعیم","ما از قدرت الهی آگاهیم و مطیع او هستیم، بنابراین هیچ‌کدام‌مان بی‌هدف و تصادفی وجود نداریم."],[623,"هم‌چو آب نیل دانی وقت غرق","کو میان هر دو امت کرد فرق","همان‌طور که رود نیل در زمان غرق شدن مشخص است، خداوند نیز می‌تواند در میان دو گروه (مؤمنان و کافران) تفاوت قائل شود."],[623,"چون زمین دانیش دانا وقت خسف","در حق قارون که قهرش کرد و نسف","وقتی زمین را بشناسی و دانشمند باشی، می‌دانی که چه زمانی زمین قارون را در خود فرو برد و نابودش کرد."],[623,"چون قمر که امر بشنید و شتافت","پس دو نیمه گشت بر چرخ و شکافت","چون قمر (ماه) فرمان حق را شنید و با سرعت حرکت کرد، به دو نیمه تقسیم شد و در آسمان شکافت."],[623,"چون درخت و سنگ کاندر هر مقام","مصطفی را کرده ظاهرالسلام","به هر جایی که بروی، حتی در دل درخت و سنگ، تو می‌توانی نشانه‌های وجود پیامبر اسلام، حضرت محمد (مصطفی)، را ببینی و او را سلامت و آشتی‌جو بیابی."],[624,"دی یکی می‌گفت عالم حادثست","فانیست این چرخ و حقش وارثست","یک نفر می‌گفت که جهان مخلوق و ناپایدار است و این چرخ (جهان) به فنا می‌رود، و تنها خداوند (حق) وراث و مالک آن است."],[624,"فلسفیی گفت چون دانی حدوث","حادثی ابر چون داند غیوث","فلسفی می‌گوید اگر تو حدوث (یعنی به وجود آمدن) یک حادثه را بدانی، پس چگونه می‌تواند ابر (که یکی از مخلوقات است) غیاث (یعنی باران) را بداند؟ این اشاره به ناتوانی مخلوقات در درک کامل حقیقت و وجود خداوند دارد."],[624,"ذره‌ای خود نیستی از انقلاب","تو چه می‌دانی حدوث آفتاب","تو که به خودی خود وجود نداری و تنها از تأثیرات تغییرات و انقلاب‌ها ساخته شده‌ای، چه چیز از تولد و ظهور آفتاب (وجود پروردگار) می‌دانی؟"],[624,"کرمکی کاندر حدث باشد دفین","کی بداند آخر و بدو زمین","کرمکی که در درون زمین پنهان است و به طور ناچیز و کوچک زندگی می‌کند، چگونه می‌تواند درستی و حقیقت وجود خود را بشناسد؟"],[624,"این به تقلید از پدر بشنیده‌ای","از حماقت اندرین پیچیده‌ای","این جمله نشان می‌دهد که تو صرفا از روی تقلید و نادانی حرف‌هایی را تکرار می‌کنی که پدرانت گفته‌اند و به عمق و حقیقت آنها پی نبرده‌ای."],[624,"چیست برهان بر حدوث این بگو","ورنه خامش کن فزون گویی مجو","برهان و دلیلی بر حدوث (نسبی نوظهور بودن) این موضوع چیست؟ اگر نمی‌توانی چیزی برای گفتن بیاوری، بهتر است سکوت کنی و بیش از این سخن نگوئی."],[624,"گفت دیدم اندرین بحث عمیق","بحث می‌کردند روزی دو فریق","بحث عمیق و جدل شدیدی را مشاهده کردم که در آن دو گروه در حال صحبت درباره این موضوع بودند."],[624,"در جدال و در خصام و در ستوه","گشت هنگامه بر آن دو کس گروه","در جریان بحث و جدل سختی که میان آن دو نفر وجود داشت، قیل و قال و جنجال برپا شد."],[624,"من به سوی جمع هنگامه شدم","اطلاع از حال ایشان بستدم","من به سمت جمعیت شلوغ رفتم و از وضعیت آن‌ها آگاه شدم."],[624,"آن یکی می‌گفت گردون فانیست","بی‌گمانی این بنا را بانیست","یکی از گفتگوها این است که او می‌گوید: آسمان و گردونه دنیوی زایل و نابود شدنی است و بدون شک این بنای جهان یک سازنده و آفریدگار دارد."],[624,"وان دگر گفت این قدیم و بی کیست","نیستش بانی و یا بانی ویست","این شخص می‌گوید که این جهان قدیمی و بی‌خالق است و هیچ بنیانی ندارد، و یا خالق آن ناشناخته است."],[624,"گفت منکر گشته‌ای خلاق را","روز و شب آرنده و رزاق را","منکر می‌گوید که خداوندی وجود ندارد و خالقی برای عالم نیست، در حالی که شب و روز را از وجود خالق و روزی‌دهنده‌ای می‌داند که عالم را به وجود آورده و روزی می‌دهد."],[624,"گفت بی برهان نخواهم من شنید","آنچ گولی آن به تقلیدی گزید","او می‌گوید من بدون دلیل، چیزی را نمی‌پذیرم و نمی‌شنوم؛ آنچه را که تو به تقلید و از روی ظن می‌گویی، برای من پذیرفتنی نیست."],[624,"هین بیاور حجت و برهان که من","نشنوم بی حجت این را در زمن","جامعه‌ای را بیاور و دلیل و برهان بیاور، زیرا من بدون دلیل و حجت این سخنان را در زمان نمی‌پذیرم."],[624,"گفت حجت در درون جانمست","در درون جان نهان برهانمست","حجت و دلیل در درون جان من است و در باطن وجودم برهانی نهفته است."],[624,"تو نمی‌بینی هلال از ضعف چشم","من همی بینم مکن بر من تو خشم","تو به خاطر ضعف چشمانت نمی‌توانی هلال (ماه نو) را ببینی، اما من به راحتی آن را می‌بینم. پس لطفا خشمگین نشو."],[624,"گفت و گو بسیار گشت و خلق گیج","در سر و پایان این چرخ پسیج","گفت‌وگوهای زیادی در میان مردم شکل گرفت و آن‌ها در مورد سر و پایان این عالم (چرخ) در حیرت و فهم ناتوانی بودند."],[624,"گفت یارا در درونم حجتیست","بر حدوث آسمانم آیتیست","یارم می‌گوید در دل من دلیلی بر نوظهوری آسمان وجود دارد که نشانه‌ای است."],[624,"من یقین دارم نشانش آن بود","مر یقین‌دان را که در آتش رود","من مطمئن هستم که نشانه وجود خداوند این است که کسی که یقین دارد با چنین علمی، در آتش (آتش جهنم یا عذاب) می‌رود."],[624,"در زبان می‌ناید آن حجت بدان","هم‌چو حال سر عشق عاشقان","در زبان عاشقان، دلیلی و حجتی بیان می‌شود، مانند حال و وضع سر عشق که در دل آن‌ها وجود دارد."],[624,"نیست پیدا سر گفت و گوی من","جز که زردی و نزاری روی من","در گفت‌وگوی من نشانه‌ای از زندگی و شادابی وجود ندارد، جز رنگ زرد و پژمردگی چهره‌ام."],[624,"اشک و خون بر رخ روانه می‌دود","حجت حسن و جمالش می‌شود","اشک و خون بر چهره‌ام جاری می‌شود و این می‌شود نشانه‌ای بر زیبایی و نیکویی او."],[624,"گفت من اینها ندانم حجتی","که بود در پیش عامه آیتی","او (منکر الوهیت) می‌گوید که من این مسائل را نمی‌دانم، و آن حجتی که در برابر عموم مردم وجود دارد، نشانه‌ و آیتی است."],[624,"گفت چون قلبی و نقدی دم زنند","که تو قلبی من نکویم ارجمند","گفت وقتی که قلب و جان به زندگی و نفس کشیدن ادامه می‌دهند، اگر تو قلبی خوب و با ارزش داشته باشی، من هم از ارزش و خوبی قلب خودم سخن می‌گویم."],[624,"هست آتش امتحان آخرین","کاندر آتش در فتند این دو قرین","آتش امتحان آخرین، حس و حال دو نفر (عامی و خاص) را نشان می‌دهد که در آتش تجربیات و آزمایش‌ها ظهور می‌کنند و این دو به یکدیگر مربوط و نزدیک هستند."],[624,"عام و خاص از حالشان عالم شوند","از گمان و شک سوی ایقان روند","افراد عادی و خاص (فرهیختگان) از وضعیت خود آگاه می‌شوند و با ترک تردید و گمان، به یقین و ایمان نزدیک می‌شوند."],[624,"آب و آتش آمد ای جان امتحان","نقد و قلبی را که آن باشد نهان","آب و آتش به عنوان تجربه‌های امتحانی آمده‌اند تا قلبی را بسنجند که در آن حقیقتی نهفته است."],[624,"تا من و تو هر دو در آتش رویم","حجت باقی حیرانان شویم","اگر من و تو در آتش برویم، دلیل ماندگاری شگفتی‌های حیرت‌زده‌ها خواهیم بود."],[624,"تا من و تو هر دو در بحر اوفتیم","که من و تو این کره را آیتیم","این بیت نشان می‌دهد که در نهایت، اگر من و تو در عمق مسأله عمیق‌تر شویم و احساسات خود را کنار بگذاریم، متوجه خواهیم شد که وجود ما به‌عنوان نشانه‌ای از خالق است و این دنیا و تجربیات ما فقط جنبه‌ای از یک حقیقت بزرگتر هستند."],[624,"هم‌چنان کردند و در آتش شدند","هر دو خود را بر تف آتش زدند","هر دو نفر (مرد مدعی و دیگران) همچنان که در گفت‌وگو و جدل بودند، در آتش دوزخ گرفتار شدند و خود را به آتش افکندند."],[624,"از خدا گوینده مرد مدعی","رست و سوزید اندر آتش آن دعی","مدعی، که شاید به حقانیت خداوند شک داشت، با کلامش به آتش جهل و نادانی گرفتار شد و در نهایت سرنوشتش سوزان شدن در آن آتش بود."],[624,"از مؤذن بشنو این اعلام را","کوری افزون‌روان خام را","از مؤذن (کسی که اذان می‌گوید) خوب گوش کن که چه پیام‌هایی را به دیگران می‌رساند، تا نادانی و بی‌خبری جان تو را بیشتر نکند."],[624,"که نسوزیدست این نام از اجل","کش مسمی صدر بودست و اجل","این نام، یعنی «اجل» یا «مرگ»، هرگز از بین نمی‌رود، زیرا مسبب آن، که خداوند است، همیشه وجود دارد و خود اجل نیز در صدر و در بالاترین مقام است."],[624,"صد هزاران زین رهان اندر قران","بر دریده پرده‌های منکران","در قرآن، صدها هزار آیه وجود دارد که پرده‌های خرافات و انکارکنندگان حقیقت را کنار می‌زند و به روشنی حقایق را نشان می‌دهد."],[624,"چون گرو بستند غالب شد صواب","در دوام و معجزات و در جواب","وقتی که گروهی از مخالفان بر چیزهایی به اصطلاح ایمان می‌آورند، حق و حقیقت بر آن‌ها غالب می‌شود و در موضوعات دائمی، معجزات و پاسخ‌ها به وضوح نمایان می‌گردد."],[624,"فهم کردم کانک دم زد از سبق","وز حدوث چرخ پیروزست و حق","فهمیدم که اگر از پیش بودن و نو بودن دنیا سخن بگوید، باید به پیروزی و حقانیت چرخ (زمان) اعتراف کند."],[624,"حجت منکر هماره زردرو","یک نشان بر صدق آن انکار کو","دلیل اینکه او (منکر وجود خدا) همیشه رنگ باخته و زردرنگ است، این است که یک علامت برای صدق انکار او وجود ندارد."],[624,"یک مناره در ثنای منکران","کو درین عالم که تا باشد نشان","در این عالم، مناری وجود ندارد که در ستایش منکران خدا باشد و نشانی از آنها بدهد."],[624,"منبری کو که بر آنجا مخبری","یاد آرد روزگار منکری","منبری که در آن کسی وجود دارد که شیوه‌های زندگی منکر را یادآوری کند."],[624,"روی دینار و درم از نامشان","تا قیامت می‌دهد زین حق نشان","نقش دینار و درم (واحدهای پول) بر روی آن‌ها تا روز قیامت نشان از حق و حقیقتی است که در دنیا وجود دارد و این نشان از اهمیت و اعتبار آن‌ها در جامعه دارد."],[624,"سکه شاهان همی گردد دگر","سکه احمد ببین تا مستقر","سکه‌های حکومتی تغییر می‌کنند و به تدریج از بین می‌روند، اما سکه‌ای که به نام احمد (احمد، ممکن است اشاره به شخصیت برجسته‌ای باشد) است، همچنان پایدار و ثابت باقی می‌ماند."],[624,"بر رخ نقره و یا روی زری","وا نما بر سکه نام منکری","بر سکه‌های نقره و طلا، نام کسی را بنویس که وجود خداوند را انکار می‌کند."],[624,"خود مگیر این معجز چون آفتاب","صد زبان بین نام او ام‌الکتاب","نمی‌توانی این معجزه را که مانند آفتاب است، فقط برای خودت برداری؛ زیرا نام او، که در حقیقت «ام‌الکتاب» است، به گونه‌ای است که به هزار زبان گفته می‌شود."],[624,"زهره نی کس را که یک حرفی از آن","یا بدزدد یا فزاید در بیان","هیچ کس جرات ندارد که حتی یک کلمه از آنچه درباره خدا گفته می‌شود، کم یا زیاد کند."],[624,"یار غالب شو که تا غالب شوی","یار مغلوبان مشو هین ای غوی","ای دوستی که در بحث و جدل غالب می‌شوی، سعی کن همیشه در موضع قوی و پیروز قرار بگیری و تسلیم عقاید کسانی که ضعیف هستند نشو. این سخن به تو یادآوری می‌کند که در برابر نظرات ضعیف و نادرست تسلیم نشوی."],[624,"حجت منکر همین آمد که من","غیر این ظاهر نمی‌بینم وطن","منکر وجود خداوند تنها به این دلیل که چیزی جز ظاهرها نمی‌بیند، حجت خود را برمی‌دارد و به این نتیجه می‌رسد که وطن او همین دنیای مادی و ظاهری است."],[624,"هیچ نندیشد که هر جا ظاهریست","آن ز حکمتهای پنهان مخبریست","هیچ‌کس به این فکر نمی‌کند که هر چیزی که به صورت ظاهری وجود دارد، دارای حکمت‌ها و رازهای پنهانی است."],[624,"فایده هر ظاهری خود باطنیست","هم‌چو نفع اندر دواها کامنست","فایده هر چیز ظاهری در حقیقت به باطن و معنای آن وابسته است، همان‌طور که اثر مثبت در داروها نهفته است."],[625,"هیچ نقاشی نگارد زین نقش","بی امید نفع بهر عین نقش","هیچ هنرمندی تصویر نمی‌کشد مگر اینکه از آن انتظار بهره‌ای داشته باشد. هر نقشی که ایجاد می‌شود، هدف و فایده‌ای در پس خود دارد."],[625,"بلک بهر میهمانان و کهان","که به فرجه وارهند از اندهان","این جهان و آنچه در آن است برای میهمانانی ساخته شده که بعد از مرگ به عالم دیگری خواهند رفت و از این دنیای مادی عبور خواهند کرد."],[625,"شادی بچگان و یاد دوستان","دوستان رفته را از نقش آن","شادی بچه‌ها و یادآوری دوستانی که رفته‌اند، حاصل و تأثیر آن نقش و حکمت عمیق‌تر از آفرینش است."],[625,"هیچ کوزه‌گر کند کوزه شتاب","بهر عین کوزه نه بر بوی آب","کوزه‌گر (سازنده کوزه) هیچگاه به خاطر بوی آب کوزه نمی‌سازد، بلکه او برای شکل و خود کوزه اقدام به ساخت آن می‌کند. به عبارتی، هدف اصلی او از ساخت کوزه تنها وجود و شکل خود آن است و نه ویژگی‌ها یا محتویاتش."],[625,"هیچ کاسه گر کند کاسه تمام","بهر عین کاسه نه بهر طعام","هیچ سازنده‌ای (کاسه‌گر) کاسه را کامل نمی‌سازد فقط به دلیل اینکه ظرفی برای غذا باشد؛ بلکه آن را به خاطر معنای عمیق‌تری که در آن نهفته است، می‌سازد."],[625,"هیچ خطاطی نویسد خط به فن","بهر عین خط نه بهر خواندن","هیچ خوشنویسی خطی نمی‌نویسد فقط به خاطر دیدن آن، بلکه هدف او از نگارش خط، انتقال معنا و مفهومی عمیق‌تر است که در آن نهفته است."],[625,"نقش ظاهر بهر نقش غایبست","وان برای غایب دیگر ببست","نقش و تصویری که می‌بینید، برای نشان دادن معنایی پنهان و غایب است و این تصویر به منظور اشاره به یک حقیقت عمیق‌تر و دور از دسترس ما ایجاد شده است."],[625,"تا سوم چارم دهم بر می‌شمر","این فواید را به مقدار نظر","انسان باید برای درک عمیق‌تر از زندگی، علاوه بر ظاهر، به باطن و حکمت‌های پنهان توجه کند و در شمارش فوائد و معنای عمیق‌تر این زندگی، به دقت و به تدریج پیش برود، مانند شمردن اعداد که به ترتیب انجام می‌شود."],[625,"هم‌چو بازیهای شطرنج ای پسر","فایده هر لعب در تالی نگر","مانند بازی‌های شطرنج، فایده هر بازی را باید در نتایج و پیامدهای آن جستجو کرد، نه فقط در خود بازی."],[625,"این نهادند بهر آن لعب نهان","وان برای آن و آن بهر فلان","این جهان و همه چیزهایی که در آن وجود دارد به خاطر مقاصد و حکمت‌های پنهان و نهان آفریده شده‌اند و هر چیزی به نوعی به هدفی خاص اختصاص دارد، آن‌چنان که ارتباط‌ها و معنای عمیق‌تری در پس آنها نهفته است."],[625,"هم‌چنین دیده جهات اندر جهات","در پی هم تا رسی در برد و مات","چشم انسان در جستجوی حقیقت و معناست و به همین دلیل از یک جهت به جهتی دیگر می‌نگرد تا به مقصدی مشخص برسد و در نهایت دچار حیرت و شگفتی شود."],[625,"اول از بهر دوم باشد چنان","که شدن بر پایه‌های نردبان","وجود هر چیزی برای دستیابی به هدفی بالاتر است، مانند اینکه هر مرحله نردبان برای رسیدن به سطح بالاتری طراحی شده است."],[625,"و آن دوم بهر سوم می‌دان تمام","تا رسی تو پایه پایه تا به بام","آن چیز دوم، به خاطر چیز سوم است؛ یعنی همه چیزهایی که دیده می‌شوند، به خاطر معنا و هدفی بالاتر خلق شده‌اند. برای رسیدن به مقصود نهایی، باید از پایه‌ها بالا بروی تا به اوج و بام برسیدی."],[625,"شهوت خوردن ز بهر آن منی","آن منی از بهر نسل و روشنی","عشق به خوردن و لذت‌جویی به خاطر وجود انسان است و وجود انسان هم به خاطر ادامه‌ی نسل و روشنایی زندگی می‌باشد."],[625,"کندبینش می‌نبیند غیر این","عقل او بی‌سیر چون نبت زمین","انسانی که دیدگاه و بینش محدودی دارد، فقط آنچه را می‌بیند درک می‌کند و نمی‌تواند چیز دیگری فراتر از آن را ببیند. عقل او مثل گیاهی است که در زمین بدون حرکت و رشد مانده است و نمی‌تواند به‌سوی معانی عمیق‌تر برود."],[625,"نبت را چه خوانده چه ناخوانده","هست پای او به گل در مانده","نبت (درخت) چه خوانده شود و چه نخوانده، او همیشه در گل (خاک) مانده است. به این معنا که حتی در شرایطی که ممکن است از نظر ظاهری تشخیص داده نشود، هنوز ریشه‌اش در خاک پایدار است و نمی‌تواند از آن جدا شود."],[625,"گر سرش جنبد پیر باد رو","تو به سر جنبانیش غره مشو","اگر سر انسان پیر و باتجربه‌ای به حرکت درآید، تو فریب این حرکت را نخور و فکر نکن که او به چیزی رسیده است."],[625,"آن سرش گوید سمعنا ای صبا","پای او گوید عصینا خلنا","این بیت به دو بخش مرتبط به هم اشاره دارد: «سر» که به معنای بخش عقل و خرد انسان است، می‌گوید که ما گوش فرا دادیم و حرف «صبا» (نسیم خوش) را شنیدیم، اما «پا» که نماد تمایلات و خواسته‌های غیر منطقی است، واکنشی متفاوت نشان می‌دهد و می‌گوید که نافرمانی کردیم و به حرفی که شنیدیم توجه نکردیم. این تضاد میان فهم و عمل در انسان را بازتاب می‌دهد."],[625,"چون ندارد سیر می‌راند چون عام","بر توکل می‌نهد چون کور گام","چون کسی که سیر و حرکت ندارد، به دیگران تکیه می‌کند و به اهل دنیا اعتماد می‌نماید، مانند کور که بدون دیدن، قدم برمی‌دارد."],[625,"بر توکل تا چه آید در نبرد","چون توکل کردن اصحاب نرد","هرچقدر که به توکل (تکیه بر خدا) اعتقاد داشته باشی، در میدان زندگی و نبرد چقدر موفق خواهی شد؛ چون توکل مانند بازی نرد است که نتیجه‌اش به تلاش و هوش بستگی دارد."],[625,"وآن نظرهایی که آن افسرده نیست","جز رونده و جز درنده پرده نیست","نگاه‌هایی که پژمرده نیستند، تنها متعلق به افرادی هستند که در حال حرکت و پیشرفت‌اند و فقط در معرض حقایق و رازهایی قرار دارند که از دید دیگران پنهان است."],[625,"آنچ در ده سال خواهد آمدن","این زمان بیند به چشم خویشتن","انسان در این زمان می‌تواند با دیدن واقعیات حال، آنچه در آینده برایش در آینده‌ای نزدیک، حدود ده سال بعد، رخ خواهد داد را درک کند."],[625,"هم‌چنین هر کس به اندازه نظر","غیب و مستقبل ببیند خیر وشر","هر فرد به اندازه‌ای که بتواند آینده و عالم غیب را ببیند، خیر و شر را می‌بیند."],[625,"چونک سد پیش و سد پس نماند","شد گذاره چشم و لوح غیب خواند","زمانی که هیچ مانع جلو و عقب وجود ندارد، چشم قادر است به حقایق پنهان و رازهای غیب نگاه کند و آن‌ها را ببیند."],[625,"چون نظر پس کرد تا بدو وجود","ماجرا و آغاز هستی رو نمود","زمانی که نظر به درون برگشت و به وجود ما توجه کرد، ماجرای آفرینش و آغاز هستی نمایان شد."],[625,"بحث املاک زمین با کبریا","در خلیفه کردن بابای ما","بحث و گفت‌وگو درباره دارایی‌ها و ملک‌های زمین در برابر عظمت و بزرگی خداوند، به‌گونه‌ای که مردم با توجه به این قدرت و مقام الهی، به فرزندان آدم (مثلا آدم به عنوان پدر بشریت) توجه کنند."],[625,"چون نظر در پیش افکند او بدید","آنچ خواهد بود تا محشر پدید","او، که در اینجا به خدا اشاره دارد، وقتی به جلو نگاه می‌کند، می‌بیند که چه اتفاقاتی خواهد افتاد تا روز قیامت نمایان شود."],[625,"پس ز پس می‌بیند او تا اصل اصل","پیش می‌بیند عیان تا روز فصل","او (مولانا) می‌گوید که انسان می‌تواند دستاوردها و سرنوشت خود را به‌طور واضح ببیند تا زمانی که به اصل و ریشه امور، یعنی حقیقت و محتوا، دست یابد و تا روز قیامت (روز فصل) این حقیقت برای او نمایان می‌شود."],[625,"هر کسی اندازه روشن‌دلی","غیب را بیند به قدر صیقلی","هر کسی بسته به درجه روشن‌بینی و فهم خود از حقایق غیبی، می‌تواند آن حقایق را مشاهده کند؛ هرچه روشن‌دلی بیشتری داشته باشد، بیشتر از دقت و عمق آن حقایق آگاه می‌شود."],[625,"هر که صیقل بیش کرد او بیش دید","بیشتر آمد برو صورت پدید","هر کسی که درک و شناخت بیشتری پیدا کند، قابلیت مشاهده و درک چیزهای بیشتری را نیز خواهد داشت؛ هر چه بینش و علم او بیشتر شود، حقیقت‌ها و واقعیت‌ها بیشتری به او نمایان خواهد شد."],[625,"گر تو گویی کان صفا فضل خداست","نیز این توفیق صیقل زان عطاست","اگر تو بگویی که این پاکی و صفا به خاطر فضل و نعمت خداوند است، باید بدان که این توفیق و استعداد هم نتیجه همین بخشش و عطای الهی است."],[625,"قدر همت باشد آن جهد و دعا","لیس للانسان الا ما سعی","اندازه همت انسان، همان تلاش و دعا و کوشش اوست. هر انسان جز آنچه را خود برای رسیدن به خواسته‌هایش تلاش کرده، هیچ چیز دیگری نصیبش نخواهد شد."],[625,"واهب همت خداوندست و بس","همت شاهی ندارد هیچ خس","همت و اراده تنها از سوی خداوند است و هیچ انسان یا شاهی نمی‌تواند آن را به تنهایی داشته باشد."],[625,"نیست تخصیص خدا کس را به کار","مانع طوع و مراد و اختیار","خدا هیچ‌کس را به طور خاص و جداگانه معین نکرده است، بلکه او موانع و کارهایی که به اختیار و اراده انسان بستگی دارد را می‌گذارد."],[625,"لیک چون رنجی دهد بدبخت را","او گریزاند به کفران رخت را","وقتی که خداوند به یک بدبخت رنجی می‌دهد، او را به سمت کفر و انکار می‌کشاند تا از حقیقت و نورانیت دور شود."],[625,"نیکبختی را چو حق رنجی دهد","رخت را نزدیکتر وا می‌نهد","وقتی خداوند به نیکبختان سختی و رنجی می‌دهد، آنان را به خود نزدیک‌تر می‌کند."],[625,"بددلان از بیم جان در کارزار","کرده اسباب هزیمت اختیار","بددل‌ها به خاطر ترس از جان، در میدان جنگ تجهیزات شکست را انتخاب می‌کنند."],[625,"پردلان در جنگ هم از بیم جان","حمله کرده سوی صف دشمنان","دلیران در میدان جنگ، به خاطر ترس از جان خود، به سمت صف دشمنان حمله‌ور می‌شوند."],[625,"رستمان را ترس و غم وا پیش برد","هم ز ترس آن بددل اندر خویش مرد","ترس و غم، دل‌های ما را به جلو راند و باعث شد که ما نیز از ترس، بد دلی و ضعف خود درون‌مان را بیشتر بشناسیم و تقویت کنیم."],[625,"چون محک آمد بلا و بیم جان","زان پدید آید شجاع از هر جبان","زمانی که انسان با بلا و ترس مواجه می‌شود، شخصیت واقعی او نمایان می‌شود و ویژگی‌های شجاعت در فردی که قبلا ترسو بوده، بروز می‌کند."],[626,"گفت موسی را به وحی دل خدا","کای گزیده دوست می‌دارم ترا","خداوند به موسی وحی کرد که ای برگزیده، من تو را دوست دارم."],[626,"گفت چه خصلت بود ای ذوالکرم","موجب آن تا من آن افزون کنم","موسی علیه‌السلام می‌پرسد ای صاحب کرم، چه ویژگی‌ای وجود دارد که باعث شده تو محبت مرا افزایش دهی؟"],[626,"گفت چون طفلی به پیش والده","وقت قهرش دست هم در وی زده","خداوند به موسی علیه‌السلام می‌گوید که مانند کودکی که در زمان قهرش به مادرش نزدیک می‌شود و دستش را به او می‌زند، تو نیز در هنگام خشم من به من نزدیک می‌شوی و محبت من شامل حال تو است."],[626,"خود نداند که جز او دیار هست","هم ازو مخمور هم از اوست مست","انسان نمی‌داند که غیر از خداوند، جا و مکانی وجود دارد و تمام این حالت شگفتی و سرمستی که دارد، ناشی از وجود خداوند است."],[626,"مادرش گر سیلیی بر وی زند","هم به مادر آید و بر وی تند","اگر مادرش حتی سیلی به او بزند، باز هم او به سوی مادرش می‌آید و به او محبت می‌کند."],[626,"از کسی یاری نخواهد غیر او","اوست جمله شر او و خیر او","هیچ‌کس جز خداوند شادی و کامیابی نمی‌بخشد و همه‌چیز، خواه شر باشد یا خیر، از او ناشی می‌شود. بنابراین، از هیچ‌کس دیگری نباید یاری طلبید."],[626,"خاطر تو هم ز ما در خیر و شر","التفاتش نیست جاهای دگر","دل و خاطر تو نیز از ما تأثیر می‌پذیرد، اما توجه‌ات به جاهای دیگر نیست، چه در خوب و چه در بد."],[626,"غیر من پیشت چون سنگست و کلوخ","گر صبی و گر جوان و گر شیوخ","غیر از من، همه چیز در مقابل تو بی‌ارزش و بی‌معنی است، چه کودک باشد، چه جوان، و چه پیر."],[626,"هم‌چنانک ایاک نعبد در حنین","در بلا از غیر تو لانستعین","به همان‌گونه که «تنها تو را می‌پرستیم» در حنین (جنگ) که با مشکلات و سختی‌ها روبه‌رو هستیم، به غیر تو هرگز یاری نمی‌جوییم."],[626,"هست این ایاک نعبد حصر را","در لغت و آن از پی نفی ریا","عبارت «ایاک نعبد» در واقع حصر و محدودسازی عبادت را نشان می‌دهد و به این معناست که ما فقط تو را می‌پرستیم. این تأکید از روی خلوص نیت و دوری از ریا صورت گرفته است."],[626,"هست ایاک نستعین هم بهر حصر","حصر کرده استعانت را و قصر","عبارت «ایاک نستعین» هم برای تأکید بر انحصار استوانه درخواست کمک و یاری قرار داده شده و به معنای این است که تنها از تو یاری می‌طلبیم و بس."],[626,"که عبادت مر ترا آریم و بس","طمع یاری هم ز تو داریم و بس","ما تنها تو را می‌پرستیم و به جز تو از کسی یاری نمی‌خواهیم."],[627,"پادشاهی بر ندیمی خشم کرد","خواست تا از وی برآرد دود و گرد","پادشاهی به شدت بر یکی از خدمت‌گزارانش خشمگین شد و می‌خواست او را تنبیه کند و از او انتقام بگیرد."],[627,"کرد شه شمشیر بیرون از غلاف","تا زند بر وی جزای آن خلاف","پادشاه شمشیرش را از غلاف بیرون آورد تا بر آن ندیم، که خلافی کرده است، مجازات کند."],[627,"هیچ کس را زهره نه تا دم زند","یا شفیعی بر شفاعت بر تند","هیچ‌کس جرأت ندارد حتی نفس کشیدن داشته باشد یا خواستار شفاعت از کسی شود، مگر آنکه در موقعیت قوی و مناسب قرار بگیرد."],[627,"جز عمادالملک نامی در خواص","در شفاعت مصطفی‌وارانه خاص","تنها عمادالملک است که در جمع خاصان، شفاعتی مانند شفاعت پیامبر گونه می‌کند."],[627,"بر جهید و زود در سجده فتاد","در زمان شه تیغ قهر از کف نهاد","او (عمادالملک) ناگهان برخواسته و به سرعت به سجده افتاد، در حالی که پادشاه (برای خشمش) تیغ قهر را از دست گذاشت."],[627,"گفت اگر دیوست من بخشیدمش","ور بلیسی کرد من پوشیدمش","گفت اگر او دیو است، من او را بخشیدم و اگر او از جنّ است (بلیس)، من او را پنهان کردم."],[627,"چونک آمد پای تو اندر میان","راضیم گر کرد مجرم صد زیان","وقتی تو در میان ما هستی، من راضی‌ام حتی اگر کسی به من آسیب زیادی برساند."],[627,"صد هزاران خشم را تانم شکست","که ترا آن فضل و آن مقدار هست","من می‌توانم خشم‌های بسیار را کنار بزنم و نادیده بگیرم، زیرا تو آنقدر فضیلت و مقام داری که لایق این محبت و بخشش هستی."],[627,"لابه‌ات را هیچ نتوانم شکست","زآنک لابه تو یقین لابه منست","من نمی‌توانم درخواست تو را نادیده بگیرم، زیرا درخواست تو در واقع همانا درخواست من است."],[627,"گر زمین و آسمان بر هم زدی","ز انتقام این مرد بیرون نامدی","اگر زمین و آسمان را به هم بریزی و هر کاری کنی، به خاطر انتقام این مرد نمی‌توانی از چنگال او فرار کنی."],[627,"ور شدی ذره به ذره لابه‌گر","او نبردی این زمان از تیغ سر","اگر ذره ذره به خاطر او شکایت می‌کنی، این بار از تیغ سرش نبردی و نمی‌توانی از او نجات پیدا کنی."],[627,"بر تو می‌ننهیم منت ای کریم","لیک شرح عزت تست ای ندیم","ما بر تو منت می‌گذاریم ای بزرگوار و گرامی، اما تو باید بدانی که جایگاه و عظمت تو بر ما چقدر بالاست، ای خدمتگزار."],[627,"این نکردی تو که من کردم یقین","ای صفاتت در صفات ما دفین","تو کار خاصی نکردی که من انجام دادم و فقط به خاطر ویژگی‌های توست که این صفات در وجود ما پنهان شده است."],[627,"تو درین مستعملی نی عاملی","زانک محمول منی نی حاملی","تو در این حال خاص (حالت مستی) فعالی نداری و هیچ کاره‌ای، زیرا من تنها باری را به دوش دارم و تو مسئولیتی نداری."],[627,"ما رمیت اذ رمیت گشته‌ای","خویشتن در موج چون کف هشته‌ای","تو وقتی که به تیر انداختن پرداخته‌ای، خودت به دام افتاده‌ای و در این حال مانند حبابی روی آب هستی که به سرعت می‌گذرد و ناپایدار است."],[627,"لا شدی پهلوی الا خانه‌گیر","این عجب که هم اسیری هم امیر","تو به خاطر دلبستگی به دیگران، در حالی که هم خودت در بند هستی و هم به مقام و قدرت دست یازیده‌ای، در این وضع عجیبی قرار گرفته‌ای."],[627,"آنچ دادی تو ندای شاه داد","اوست بس الله اعلم بالرشاد","هر آنچه که تو به شاه گفتی، در واقع صدای اوست و فقط خدا به درست بودن راه و هدایت این امور آگاه است."],[627,"وآن ندیم رسته از زخم و بلا","زین شفیع آزرد و برگشت از ولا","آن ندیم که از درد و آسیب نجات یافته، از این شفاعت شفیع ناراحت شد و از محبت او روی گردانید."],[627,"دوستی ببرید زان مخلص تمام","رو به حایط کرد تا نارد سلام","دوستی که مخلص و دلسوز بود، از دوستی با آن شفیع کامل جدا شد و به سوی حیات و زندگی رفت، تا دیگر کسی او را نتواند با سلامی بیازارد."],[627,"زین شفیع خویشتن بیگانه شد","زین تعجب خلق در افسانه شد","این شفیع به خاطر شفاعتی که کرده، از خود بیگانه و دور شده است و مردم از این کار او شگفت‌زده شده‌اند و داستان او به افسانه تبدیل شده است."],[627,"که نه مجنونست یاری چون برید","از کسی که جان او را وا خرید","یار و دوست کسی مجنون نیست که از او بریده شود، او کسی است که جانش را برای دوست خود خریده است."],[627,"وا خریدش آن دم از گردن زدن","خاک نعل پاش بایستی شدن","در آن لحظه، او (پادشاه) جان مغضوب علیه (ندیم) را از دست مرگ نجات داد و به او (ندیم) اجازه داد به زندگی ادامه دهد، مانند اینکه برای نجات او از گردن زدن، خاک زیر پایش (نعل پاش) مهم و لازم بود."],[627,"بازگونه رفت و بیزاری گرفت","با چنین دلدار کین‌داری گرفت","او دوباره به سوی کسی رفت که از او بیزار شده بود و از دوستی با کسی که دلش را شکسته و به او ظلم کرده، جدا شد."],[627,"پس ملامت کرد او را مصلحی","کین جفا چون می‌کنی با ناصحی","خشمگین او را سرزنش کرد که چرا با کسی که به نیکی به تو نصیحت می‌کند چنین بد رفتاری می‌کنی."],[627,"جان تو بخرید آن دلدار خاص","آن دم از گردن زدن کردت خلاص","محبوب خاص تو جان تو را آزاد کرده و در آن لحظه، تو را از سر بریده شدن نجات داده است."],[627,"گر بدی کردی نبایستی رمید","خاصه نیکی کرد آن یار حمید","اگر بدی کردی، نباید فرار می‌کردی، مخصوصا اینکه یار حمید (دوست خوب) نیکی به تو کرده است."],[627,"گفت بهر شاه مبذولست جان","او چرا آید شفیع اندر میان","مردم می‌گویند که جان من برای پادشاه (در اینجا به عشق و محبت او اشاره دارد) فدای اوست، پس چرا شفیع (عبارتی که به عنوان واسطه استفاده می‌شود) باید میان بیاید و به جای من حرف بزند؟"],[627,"لی مع‌الله وقت بود آن دم مرا","لا یسع فیه نبی مجتبی","در آن لحظه نیکو، تنها محبت و رحمت خداوند برای من کافی بود، و هیچ کسی، حتی پیامبری بزرگ که مجتبی (امام حسن) است، در آن زمان نمی‌توانست به من کمک کند."],[627,"من نخواهم رحمتی جز زخم شاه","من نخواهم غیر آن شه را پناه","من به هیچ رحمت و مساعدتی غیر از درد و زخم پادشاه نیاز ندارم و جز او به هیچ کس دیگر پناه نمی‌برم."],[627,"غیر شه را بهر آن لا کرده‌ام","که به سوی شه تولا کرده‌ام","برای اینکه به سوی پادشاه توجه و تعلق خاطر پیدا کرده‌ام، به هیچ کس دیگری اهمیت نمی‌دهم و برای هیچ کس دیگر نمی‌خواهم."],[627,"گر ببرد او به قهر خود سرم","شاه بخشد شصت جان دیگرم","اگر پادشاه به طور خشمگین سر من را ببرد، او می‌تواند جان‌های زیادی از من ببخشد یا نجات دهد."],[627,"کار من سربازی و بی‌خویشی است","کار شاهنشاه من سربخشی است","من وظیفه‌ام خدمت به پادشاه و اطاعت از اوست، اما کار پادشاه بخشش و مهربانی است."],[627,"فخر آن سر که کف شاهش برد","ننگ آن سر کو به غیری سر برد","افتخار این سر در آن است که دست شاه بر آن است، و ننگ آن سر در این است که به دست دیگران تسلیم شده است."],[627,"شب که شاه از قهر در قیرش کشید","ننگ دارد از هزاران روز عید","وقتی که پادشاه در شب از غضب و خشمش به قیر (ماده‌ای سیاه و چسبناک) روی می‌آورد، این عمل برای او ننگ و عیب است، حتی اگر هزاران روز جشن و شادی به دنبال داشته باشد."],[627,"خود طواف آنک او شه‌بین بود","فوق قهر و لطف و کفر و دین بود","خود طواف آن کسی است که او شاه‌بین و آگاه است و ورای خشم و مهربانی و همچنین کفر و دین قرار دارد."],[627,"زان نیامد یک عبارت در جهان","که نهانست و نهانست و نهان","هیچ عبارتی در جهان نیامده است که به معنای واقعی نهان نباشد و در پس آن راز و اسراری وجود داشته باشد."],[627,"زانک این اسما و الفاظ حمید","از گلابه آدمی آمد پدید","این نام‌ها و واژه‌های ستودنی از صفات خداوند، از شجره وجود آدمی به وجود آمده‌اند."],[627,"علم الاسما بد آدم را امام","لیک نه اندر لباس عین و لام","علم اسماء که موجب فضیلت آدمی است، به عنوان امام شناخته می‌شود، اما این علم به معنای ظاهری و لباس‌های مادی نیست."],[627,"چون نهاد از آب و گل بر سر کلاه","گشت آن اسمای جانی روسیاه","هنگامی که این ویژگی‌های زنده و معنوی از آب و گل به سر انسان گذاشته شد، آن موجود سیاه‌رو (انسان) به کلاه و نعمت‌مندی دست پیدا کرد."],[627,"که نقاب حرف و دم در خود کشید","تا شود بر آب و گل معنی پدید","چون شخصی نمی‌تواند حقیقت را به‌وضوح بیان کند، از واژه‌ها و گفتار خود پنهان می‌شود تا معنای واقعی‌اش به تدریج درک شود."],[627,"گرچه از یک وجه منطق کاشف است","لیک از ده وجه پرده و مکنف است","این بیت می‌گوید اگرچه از یک سو، حقیقت را با منطق می‌توان شناخت و کشف کرد، اما از ده جنبه دیگر، حقیقت همچنان پنهان و پوشیده است."],[628,"من خلیل وقتم و او جبرئیل","من نخواهم در بلا او را دلیل","من خلیل زمان خود هستم و جبرئیل مظهر وحی و پیامبری است. من در مشکلات و سختی‌ها نیازی به دلیلی از او ندارم."],[628,"او ادب ناموخت از جبریل راد","که بپرسید از خلیل حق مراد","جبرئیل، که فرشته‌ای بزرگ است، از خلیل (ابراهیم) چیزی نپرسید و این نشان می‌دهد که او ادب و آداب پرسش را از جبرئیل ن learned أخذ نکرده است، بنابراین او به دنبال خواسته حقیقی خلیل نرفت."],[628,"که مرادت هست تا یاری کنم","ورنه بگریزم سبکباری کنم","اگر مقصود تو این است که به تو کمک کنم، من آماده‌ام؛ وگرنه از اینجا می‌روم و بار سنگینی به دوش نمی‌زنم."],[628,"گفت ابراهیم نی رو از میان","واسطه زحمت بود بعد العیان","ابراهیم (خلیل) گفت که وقت آن رسیده که به واسطه‌ها نیاز نداشته باشی و مستقیما با خدا صحبت کنی، زیرا بعد از تجربه و شناخت، حضور خداوند را مستقیم حس کرده است و دیگر نیازی به واسطه‌گری ندارد."],[628,"بهر این دنیاست مرسل رابطه","مؤمنان را زانک هست او واسطه","برای این دنیا، مرسل (پیامبر) واسطه‌ای است که ارتباط مؤمنان را برقرار می‌کند، چرا که او منبع و دلیل این ارتباط است."],[628,"هر دل ار سامع بدی وحی نهان","حرف و صوتی کی بدی اندر جهان","هر دلی اگر می‌شنید وحی پنهانی را، نمی‌توانست حرف و صدایی را که در جهان وجود دارد، بشنود. این بیان نشان می‌دهد که فهم واقعی وحی و الهام، نیازمند یک آمادگی و درک عمیق در دل است."],[628,"گرچه او محو حقست و بی‌سرست","لیک کار من از آن نازکترست","هرچند خلیل (خلیل‌الله، ابراهیم) به شدت متوجه خداوند است و از خود بی‌خود شده، اما کار من به مراتب ظریف‌تر و دشوارتر از اوست."],[628,"کرده او کرده شاهست لیک","پیش ضعفم بد نماینده‌ست نیک","کرده‌های ابراهیم خلیل (علیه‌السلام) به درگاه خداوند از روی قدرت و عظمت است، اما در مقابل من، که ضعیف هستم، این اعمال همچون نشانه‌ای نیکو جلوه نمی‌کند."],[628,"آنچ عین لطف باشد بر عوام","قهر شد بر نازنینان کرام","لطفی که برای مردم عادی محسوس و به چشم می‌آید، بر بزرگان و افراد محترم به صورت قهر و غضب ظاهر می‌شود."],[628,"بس بلا و رنج می‌باید کشید","عامه را تا فرق را توانند دید","برای اینکه مردم عادی بتوانند فرق میان حقیقت و ظاهرسازی را درک کنند، لازم است که بلا و رنج زیادی را تحمل کنند."],[628,"کین حروف واسطه ای یار غار","پیش واصل خار باشد خار خار","حروف و کلمات در این جهان، چون یک واسطه و همراه هستند که ما را به حقایق و معانی عمیق‌تر می‌رسانند، اما در عین حال، خودشان ممکن است مانع و غم باشند و مانند خارهایی در مسیر، ما را آزار دهند."],[628,"بس بلا و رنج بایست و وقوف","تا رهد آن روح صافی از حروف","برای رسیدن به روح پاک و بی‌آلایش، لازم است که انسان دچار بلا و زحمت شود و مدتی درنگ کند تا از موانع و الفاظ رها گردد."],[628,"لیک بعضی زین صدا کرتر شدند","باز بعضی صافی و برتر شدند","برخی از افراد نسبت به این صدا (ندای باطنی یا الهی) ناشنوا و بی‌توجه شدند، در حالی که برخی دیگر با دل پاک و خالص، به درک بالاتری دست یافتند و رشد کردند."],[628,"هم‌چو آب نیل آمد این بلا","سعد را آبست و خون بر اشقیا","این بلا همچون آب نیل بر سعد (دوستی یا خیر) نازل شده و باعث آغشته شدن خون دشمنان شده است. اینجا اشاره به یک مصیبت یا مشکل دارد که بر دوستی تأثیر گذاشته و دشمنان را آسیب‌پذیرتر کرده است."],[628,"هر که پایان‌بین‌تر او مسعودتر","جدتر او کارد که افزون دید بر","هر کسی که بینش عمیق‌تری داشته باشد و به پایان کارها درست نگاه کند، سعادت بیشتری نصیبش می‌شود و جدی‌تر باید از کسی که بیشتر می‌بیند، بیاموزد."],[628,"زانک داند کین جهان کاشتن","هست بهر محشر و برداشتن","زیرا می‌داند که این زندگی، کشت و کار است و آنچه در این دنیا به دست می‌آید، در روز قیامت برداشت خواهد شد."],[628,"هیچ عقدی بهر عین خود نبود","بلک از بهر مقام ربح و سود","هیچ عقد و پیوندی به خودی خود وجود ندارد، بلکه این روابط به‌خاطر دستیابی به مقام و سود معنا پیدا می‌کنند."],[628,"هیچ نبود منکری گر بنگری","منکری‌اش بهر عین منکری","هیچ چیزی نیست که انکاری در آن وجود داشته باشد، اگر به عمق آن نگاه کنی. انکار یا نقص آن، تنها به خاطر خود آن چیز نیست، بلکه به خاطر مقاصد و نیت‌های انسان‌هاست."],[628,"بل برای قهر خصم اندر حسد","یا فزونی جستن و اظهار خود","به خاطر حسادت یا برتر بودن در مقابل دشمن، نیازی به برتری‌جویی و خودنمایی نیست."],[628,"وآن فزونی هم پی طمع دگر","بی‌معانی چاشنی ندهد صور","افزایش و برتری در حالات و ویژگی‌ها به خاطر طمع و خواسته‌های دیگر، به خودی خود فاقد معنی و ارزش است و نمی‌تواند بر محتوا و حقیقت بیفزاید."],[628,"زان همی‌پرسی چرا این می‌کنی","که صور زیتست و معنی روشنی","تو از من می‌پرسی چرا این کار را می‌کنی؛ در حالی که صورت‌ها ظاهری شبیه به هم دارند و معنای حقیقی آن‌ها در روشنی و وضوح نمایان است."],[628,"ورنه این گفتن چرا از بهر چیست","چونک صورت بهر عین صورتیست","اگر این سوال کردن و گفتن فایده‌ای نداشته باشد، پس هدف از آن چیست؟ چون هر صورت و شکلی برای دیدن یک تصویر است."],[628,"این چرا گفتن سوال از فایده‌ست","جز برای این چرا گفتن بدست","سوال کردن در مورد دلیل و فایده چیزی، خود به خود هیچ نفعی ندارد و جز برای رسیدن به دلیل و معنای اصلی وجود ندارد."],[628,"از چه رو فایده جویی ای امین","چون بود فایده این خود همین","چرا ای امین (جبرئیل) در پی فایده‌جویی هستی؟ خود فایده همین سوال و پرسش است."],[628,"پس نقوش آسمان و اهل زمین","نیست حکمت کان بود بهر همین","نقوش آسمان و افرادی که بر زمین هستند، همگی نشانه‌هایی از حکمت هستند و این حکمت به خاطر همین موضوعات و مظاهر وجود دارد."],[628,"گر حکیمی نیست این ترتیب چیست","ور حکیمی هست چون فعلش تهیست","اگر حکیمی وجود ندارد، پس این نظم و ترتیب جهان چگونه است؟ و اگر حکیمی هست، چرا اعمال او خالی از معنی و تأثیر است؟"],[628,"کس نسازد نقش گرمابه و خضاب","جز پی قصد صواب و ناصواب","هیچ‌کس نمی‌تواند نقش و تصویر (دست‌ساخته) در گرمابه یا رنگ‌زدن مو ایجاد کند، مگر به قصد کار درست یا نادرست."],[629,"گفت موسی ای خداوند حساب","نقش کردی باز چون کردی خراب","موسی علیه‌السلام از خدا می‌پرسد که ای پروردگار، تو که نقش آفرینی انسان‌ها را به عهده داری، چرا آنچه را که ساخته‌ای خراب می‌کنی؟"],[629,"نر و ماده نقش کردی جان‌فزا","وانگهان ویران کنی این را چرا","خداوند نر و ماده را به گونه‌ای آفرینش کرده است که جان‌افزاست، اما چگونه این آفرینش زیبا را ناگهان ویران می‌کنی؟"],[629,"گفت حق دانم که این پرسش ترا","نیست از انکار و غفلت وز هوا","خداوند می‌گوید: من می‌دانم که این سوال تو ناشی از انکار و بی‌توجهی یا پیروی از هوس‌ها نیست."],[629,"ورنه تادیب و عتابت کردمی","بهر این پرسش ترا آزردمی","اگر غیر از این بود، من به خاطر این پرسش، تو را تنبیه و سرزنش می‌کردم و موجب آزار تو می‌شدم."],[629,"لیک می‌خواهی که در افعال ما","باز جویی حکمت و سر بقا","اما تو می‌خواهی که در کارهای ما علت و راز ماندگاری را جویا شوی."],[629,"تا از آن واقف کنی مر عام را","پخته گردانی بدین هر خام را","برای آگاه کردن عموم مردم، تو باید آنها را از علم و آگاهی بهره‌مند کنی و به این ترتیب افراد نادان را نیز آماده و آماده‌تر کنی."],[629,"قاصدا سایل شدی در کاشفی","بر عوام ار چه که تو زان واقفی","ای کسی که به‌عنوان پرسش‌کننده به دنبال حقیقت هستی، به مردم، هرچند تو خود از آن حقیقت آگاه هستی، نشان بده."],[629,"زآنک نیم علم آمد این سؤال","هر برونی را نباشد آن مجال","این سؤال از علم به وجود نیامده، زیرا ادراکات سطحی و ظاهری اجازه مطرح شدن چنین سؤالی را نمی‌دهند."],[629,"هم سؤال از علم خیزد هم جواب","هم‌چنانک خار و گل از خاک و آب","سؤال و جواب هر دو از دانش و علم ناشی می‌شوند، همان‌طور که خار و گل هر دو از یک منبع، یعنی خاک و آب، رشد می‌کنند."],[629,"هم ضلال از علم خیزد هم هدی","هم‌چنانک تلخ و شیرین از ندا","گمراهی و هدایت هر دو از علم ناشی می‌شود، درست مانند اینکه تلخی و شیرینی از یک صدا یا ندا به وجود می‌آید."],[629,"ز آشنایی خیزد این بغض و ولا","وز غذای خویش بود سقم و قوی","این کینه و دشمنی از آشنایی و نزدیکی ناشی می‌شود، و در حقیقت، وابستگی و تعلقات انسانی مانند خوراکی است که هم می‌تواند مفید و قوی باشد و هم مضر و ناخوشایند."],[629,"مستفید اعجمی شد آن کلیم","تا عجمیان را کند زین سر علیم","موسی علیه‌السلام که خود دارای دانش و درک عمیق است، به زبان دیگران سخن می‌گوید تا بتواند همگان را از علم و عظمت خود بهره‌مند کند و آنها را راهنمایی کند."],[629,"ما هم از وی اعجمی سازیم خویش","پاسخش آریم چون بیگانه پیش","ما هم از خداوند (که ایستاده است) ما را به حال بیگانه‌ها درآوریم و پاسخی برای او خواهیم داشت."],[629,"خرفروشان خصم یکدیگر شدند","تا کلید قفل آن عقد آمدند","خرفروشان (فروختگان خرف یا پیرمردان) به یکدیگر دشمن شدند تا اینکه کلید قفل آن توافق یا رابطه (عقد) را یافتند."],[629,"پس بفرمودش خدا ای ذولباب","چون بپرسیدی بیا بشنو جواب","خدا به حضرت موسی می‌گوید: ای ذو اللباس (موسی)، حالا که سوال کردی، بیا و پاسخ را بشنو."],[629,"موسیا تخمی بکار اندر زمین","تا تو خود هم وا دهی انصاف این","موسی، بذر خوبی را در راستای عدالت بکار، تا خودت نیز حق را به جای بیاوری و انصاف را برقرار کنی."],[629,"چونک موسی کشت و شد کشتش تمام","خوشه‌هااش یافت خوبی و نظام","موقعی که موسی، بذر را کاشت و کشتش کامل شد، خوشه‌ها را پیدا کرد که همگی خوب و منظم بودند."],[629,"داس بگرفت و مر آن را می‌برید","پس ندا از غیب در گوشش رسید","موسی، داس را گرفت و مشغول برداشت محصول شد، که ناگهان صدایی از عالم غیب در گوشش شنید."],[629,"که چرا کشتی کنی و پروری","چون کمالی یافت آن را می‌بری","موسی (علیه‌السلام) می‌پرسد که چرا باید کار را به کشتن و ویران کردن برسانی وقتی که آن چیز (موجودی) به کمال رسیده و به رشد و باروری خود نائل آمده است."],[629,"گفت یا رب زان کنم ویران و پست","که درینجا دانه هست و کاه هست","موسی از خدا می‌پرسد، ای پروردگار، چرا اینجا دانه‌های باارزش را از بین می‌بری و برای من چنین ویرانی و ذلت می‌آفرینی، در حالی که در اینجا دانه وجود دارد و باید حفظ شود؟"],[629,"دانه لایق نیست درانبار کاه","کاه در انبار گندم هم تباه","دانه (یعنی غله یا محصول با ارزش) نباید در انباری که مخصوص کاه (یعنی ضایعات و چیزهای بی‌ارزش) است ذخیره شود، و حتی کاه هم در انبار گندم (یعنی غله) به آن آسیب می‌زند."],[629,"نیست حکمت این دو را آمیختن","فرق واجب می‌کند در بیختن","آمیختن این دو (دانه و کاه) حکمت ندارد و این کار، تفاوت‌هایی را در سرنوشت آن‌ها ایجاد می‌کند."],[629,"گفت این دانش تو از کی یافتی","که به دانش بیدری بر ساختی","موسی علیه‌السلام می‌پرسد که این دانش (فهم و دانایی) را از کجا به دست آورده‌ای که از دانش نادانان به دور است."],[629,"گفت تمییزم تو دادی ای خدا","گفت پس تمییز چون نبود مرا","موسی علیه‌السلام از خداوند می‌پرسد که چرا تمییز و فرق گذاشتن میان حق و باطل را به او نداده است، در حالی که او را به این نعمت آشنا کرده است."],[629,"در خلایق روحهای پاک هست","روحهای تیره گلناک هست","در میان مردم، ارواح پاکی وجود دارند و در عین حال، ارواحی هم هستند که تیره و غمگینند."],[629,"این صدفها نیست در یک مرتبه","در یکی درست و در دیگر شبه","این موجودات، مانند صدف‌هایی هستند که در درجات و حالت‌های متفاوتی وجود دارند؛ برخی از آن‌ها به‌طور کامل درست و سالم‌اند و برخی دیگر مانند شبهه یا نقص دارند."],[629,"واجبست اظهار این نیک و تباه","هم‌چنانک اظهار گندمها ز کاه","اینکه ظهور و بروز نیکی‌ها و بدی‌ها ضروری است، مانند آنکه گندم‌ها باید از کاه جدا شوند تا مشخص شوند."],[629,"بهر اظهارست این خلق جهان","تا نماند گنج حکمتها نهان","این جهان برای ابراز و نشان دادن خلق شده است تا گنجینه‌ی حکمت‌ها پنهان نماند."],[629,"کنت کنزا کنت مخفیا شنو","جوهر خود گم مکن اظهار شو","من از همیشه گنجینه‌ای پنهان بودم و به عنوان یک راز مخفی شناخته می‌شدم، حالا باید جوهر خود را پیدا کنی و پنهان نمانی، بلکه خود را نمایان کن."],[630,"جوهر صدقت خفی شد در دروغ","هم‌چو طعم روغن اندر طعم دوغ","جوهر صداقت تو در دروغ پنهان شده است، مانند طعم روغن که در طعم دوغ محو شده است."],[630,"آن دروغت این تن فانی بود","راستت آن جان ربانی بود","این بدن فانی و زودگذر، همان دروغی است که تو به آن وابسته‌ای؛ ولی حقیقت تو همان جان الهی و روحی است که در این بدن نهفته است."],[630,"سال‌ها این دوغ تن پیدا و فاش","روغن جان اندرو فانی و لاش","سال‌ها این بدن ظاهری مانند دوغ است که به ‌وضوح مشخص است، در حالی که روغن جان (روح) در آن پنهان است و این جان نیز ناپایدار و فانی است."],[630,"تا فرستد حق رسولی بنده‌ای","دوغ را در خمره جنباننده‌ای","خداوند برای هدایت بندگانش پیامبری را می‌فرستد که مانند دوغ در ظرفی می‌چرخد و به این ترتیب جوهر واقعی یا روح آنها را نمایان می‌سازد."],[630,"تا بجنباند به هنجار و به فن","تا بدانم من که پنهان بود من","تا زمانی که حق (خدا) با روش و فن خاصی (الهام یا وحی) مرا به حرکت درآورد، نمی‌توانم بفهمم که چه چیزی در درونم پنهان است."],[630,"یا کلام بنده‌ای کان جزو اوست","در رود در گوش او کاو وحی‌جو‌ست","این بیت می‌گوید که ممکن است کلام بنده‌ای که بخشی از وجود اوست، به گوش فرد دیگری که در جستجوی وحی و آگاهی است، برسد. به عبارت دیگر، هاله‌ای از معرفت و اطلاعات از طریق کلام بنده‌ای که در مسیر الهی است، به کسی که آماده دریافت وحی است، منتقل می‌شود."],[630,"اذن مؤمن وحی ما را واعی است","آنچنان گوشی قرین داعی است","گوش مؤمن، توانایی دریافت وحی را دارد و همان‌طور که گوش می‌تواند صدا را بشنود، این گوش در کنار دعوت‌کننده، به وحی الهی پاسخ می‌دهد."],[630,"هم‌چنانکه گوش طفل از گفت مام","پر شود ناطق شود او در کلام","همان‌طور که گوش کودک از گفتار مادر پر می‌شود و او بعدها قادر به صحبت کردن می‌شود، انسان نیز با دریافت وحی و الهام الهی به درک و بیان معانی عمیق می‌رسد."],[630,"ور نباشد طفل را گوش رشد","گفت مادر نشنود گنگی شود","اگر کودک گوشش رشد نیافته باشد و از گفتار مادر چیزی نشنود، در نتیجه دچار خاموشی و ناتوانی در بیان می‌شود."],[630,"دایما هر کر اصلی گنگ بود","ناطق آنکس شد که از مادر شنود","همواره هر فرد ناشنوا در واقع بی‌گفتار است، و تنها کسی که می‌تواند سخن بگوید، کسی است که از مادرش آموخته و شنیده باشد."],[630,"دان‌که گوش کر و گنگ از آفتی‌ست","که پذیرای دم و تعلیم نیست","گوش کر و گنگ به دلیل عدم توانایی در شنیدن و یادگیری، در واقع به معنای ابتلا به یک آفت یا نقص است که اجازه نمی‌دهد به علم و آموزش دست یابد."],[630,"آنکه بی‌تعلیم بد ناطق خداست","که صفات او ز علت‌ها جداست","آن کسی که بدون آموزش می‌تواند سخن بگوید، خداست و ویژگی‌های او از علت‌ها و عوامل جدا است."],[630,"یا چو آدم کرده تلقینش خدا","بی‌حجاب مادر و دایه و ازا","یا مانند آدم که خدا او را بدون واسطه مادر و دایه تعلیم داد."],[630,"یا مسیحی که به تعلیم ودود","در ولادت ناطق آمد در وجود","این بیت به مسیح اشاره دارد که طبق تعالیم ودود (مادرش)، به طور معجزه‌آسا و بدون پدر به دنیا آمده است. در واقع، این اشاره به ولادت عیسی مسیح و ویژگی‌های خاص آن است."],[630,"از برای دفع تهمت در ولاد","که نزاده‌ست از زنا و از فساد","برای رفع اتهام نسبت به زاده شدن آیا (مسیح) که به وضوح از زنا و فساد به وجود نیامده است."],[630,"جنبشی بایست اندر اجتهاد","تا که دوغ آن روغن از دل باز داد","انسان باید تلاشی جدی انجام دهد تا معنای واقعی و اصیل خود، که به روح و عقل مربوط می‌شود، از عمق وجودش خارج گردد و به ظهور برسد، مانند اینکه باید با فعالیت و اجتهاد، روغن را از دوغ بیرون بیاورد."],[630,"روغن اندر دوغ باشد چون عدم","دوغ در هستی برآورده علم","روح حیوانی و عقل جزئی مانند دوغی هستند که حقیقت و وجود آنها در درون مثل روغن نهفته است. حال آنکه در واقع، عدم دوغ، به معنای عدم و هنجار از نظر علم و دانش در هستی است."],[630,"آنک هستت می‌نماید هست پوست","وآنک فانی می‌نماید اصل اوست","آنچه در وجود تو به‌صورت ظاهری و پوستین نمایان است، وجودی فانی و زودگذر است، اما آنچه که اصل و حقیقت وجود توست، جاودانه و باقی می‌ماند."],[630,"دوغ روغن ناگرفتست و کهن","تا بنگزینی بنه خرجش مکن","دوغ به خودی خود روغن نمی‌گیرد و کهنه می‌شود، بنابراین نباید به آن هزینه‌ای اختصاص داد. این بیان به این معناست که برخی از امور بی‌فایده و زودگذر هستند و نباید برای آن‌ها هزینه و انرژی صرف کرد."],[630,"هین بگردانش به دانش دست دست","تا نماید آنچ پنهان کرده است","این بیت می‌گوید که با استفاده از دانش و آگاهی، باید به جست‌وجو بپردازیم و حقیقتی را که در درون چیزها پنهان شده است، آشکار کنیم."],[630,"زآنکه این فانی دلیل باقی است","لابه مستان دلیل ساقی است","چون چیزهای زایل و فانی، نشانه‌ای از حقیقت پایدار و ابدی هستند، پس آنچه وجود دارد، همانند گیج‌کننده‌های می‌نوشنده نشان‌دهنده وجود معشوق و ساقی است، که در آنها می‌توان به جوهر اصلی پی برد."],[631,"هست بازیهای آن شیر علم","مخبری از بادهای مکتتم","شیر در این بیت نماد علم و دانش است و به این معنا اشاره دارد که اگر علم و دانش به خوبی به کار گرفته شود، می‌تواند اثرات بزرگ و مهمی مانند حرکت بادها داشته باشد. این اشاره به وجود توانایی و تأثیرگذاری علم دارد."],[631,"گر نبودی جنبش آن بادها","شیر مرده کی بجستی در هوا","اگر آن بادها حرکت نمی‌کردند، مرده‌ی شیر به هیچ وجه نمی‌توانست در هوا پرواز کند."],[631,"زان شناسی باد را گر آن صباست","یا دبورست این بیان آن خفاست","اگر تو این باد را بشناسی، آیا آن باد از نوع خوشایند صباست یا از نوع ناپسند دبور؟ این بیان و توصیف به آن خفا (پنهانی) اشاره دارد."],[631,"این بدن مانند آن شیر علم","فکر می‌جنباند او را دم به دم","این بدن، مانند یک شیر نیرومند است که علم و دانش به آن نیرو می‌بخشد و فکر و اندیشه را به حرکت درمی‌آورد."],[631,"فکر کان از مشرق آید آن صباست","وآنک از مغرب دبور با وباست","فکری که از سمت مشرق می‌آید مانند نسیمی دلپذیر و لطیف است، اما فکری که از سمت مغرب می‌آید، آشفته و پرغوغا است."],[631,"مشرق این باد فکرت دیگرست","مغرب این باد فکرت زان سرست","باد فکر از سمت مشرق نشان‌دهنده اندیشه و آگاهی تازه‌ای است که از آنجا می‌وزد، در حالی که باد فکر از سمت مغرب به نوعی ناپایداری و سردرگمی اشاره دارد. این تفاوت در دو سمت نشان‌دهنده تفاوت در نوع اندیشه و حسّ در هر جهت است."],[631,"مه جمادست و بود شرقش جماد","جان جان جان بود شرق فؤاد","ماه به‌عنوان موجودی بی‌جان به سرزمین زندگی اشاره دارد و جان به عنوان یک موجود زنده و فعال توصیف می‌شود که در ریشه‌ها و عمق وجود انسان و احساسات او نهفته است. در واقع، آنچه که بی‌جان است، در ظاهر به نظر می‌رسد، ولی جان و روح واقعی در دل انسان وجود دارد."],[631,"شرق خورشیدی که شد باطن‌فروز","قشر و عکس آن بود خورشید روز","شرق خورشیدی که باطن را روشنی می‌بخشد، به مانند پوسته‌ای است که تصویر آن خورشید در روز را نشان می‌دهد."],[631,"زآنک چون مرده بود تن بی‌لهب","پیش او نه روز بنماید نه شب","چون بدن بی‌روح و مرده است، نه نشانه‌ای از روز در آن دیده می‌شود و نه نشانه‌ای از شب."],[631,"ور نباشد آن چو این باشد تمام","بی‌شب و بی روز دارد انتظام","اگر آن حالت (مرده بودن) وجود نداشته باشد، آنگاه همه‌چیز به سمت نظم و امنیت می‌رود و در حالت بی‌روز و بی‌شب خواهد بود."],[631,"هم‌چنانک چشم می‌بیند به خواب","بی‌مه و خورشید ماه و آفتاب","همان‌طور که چشم در خواب بدون نور و بدون وجود خورشید، ماه و آفتاب چیزها را می‌بیند، در عالم خواب نیز می‌تواند تصاویری را مشاهده کند."],[631,"نوم ما چون شد اخ الموت ای فلان","زین برادر آن برادر را بدان","ای فلان، وقتی حالت به خواب مرگ می‌ماند، پس برادر، آن برادر را بشناس و درک کن که چه حالتی به سراغت آمده است."],[631,"ور بگویندت که هست آن فرع این","مشنو آن را ای مقلد بی‌یقین","اگر به تو بگویند که این نتیجه یا شاخه‌ای از آن اصلی است، به این حرف گوش نده و توجه نکن، ای پیرو بی‌اطلاع."],[631,"می‌بیند خواب جانت وصف حال","که به بیداری نبینی بیست سال","می‌خواهد بگوید که روح و جان تو در خواب، حالتی را می‌بیند که اگر بیدار باشی، نمی‌توانی در مدت بیست سال آن را ببینی."],[631,"در پی تعبیر آن تو عمرها","می‌دوی سوی شهان با دها","تو برای یافتن تعبیر آن خواب، سال‌ها در پی پیگیری و جستجو می‌کنی و به سمت پادشاهان می‌روی و با دلی پر از آرزو و اشتیاق در این راه تلاش می‌کنی."],[631,"که بگو آن خواب را تعبیر چیست","فرع گفتن این چنین سر را سگیست","در این بیت، صحبت از خواب و تعبیر آن است و مولانا می‌گوید که بیان کردن خواب، صرفا فرع و جزئی از موضوع اصلی است که به مانند سگی است که به سر پیوند دارد و نباید به آن توجه چندانی کرد. تعبیر خواب اهمیت چندانی ندارد و اصلی‌تر، خود خواب و درک معانی عمیق‌تر آن است."],[631,"خواب عامست این و خود خواب خواص","باشد اصل اجتبا و اختصاص","خواب به طور کلی برای همه مردم مشترک است، اما خواب‌های خاص و ویژه تنها برای افرادی خاص به عنوان نشانه و انتخاب الهی رخ می‌دهد."],[631,"پیل باید تا چو خسپد او ستان","خواب بیند خطه هندوستان","فیل نیز باید خوابش سنگین شود تا بتواند در خواب، سرزمین هندوستان را ببیند."],[631,"خر نبیند هیچ هندستان به خواب","خر ز هندستان نکردست اغتراب","خر هیچ‌گاه در خواب خود نمی‌تواند هند را ببیند، زیرا او از هند هیچ تجربه و آشنایی ندارد و نمی‌تواند از آنجا به خیال برود."],[631,"جان هم‌چون پیل باید نیک زفت","تا به خواب او هند داند رفت تفت","جان انسان باید مانند پیل (فیل) قوی و نیکو باشد تا بتواند به خواب برود و به سرزمین هند (مقصود اوج حیات) سفر کند و آن را بشناسد."],[631,"ذکر هندستان کند پیل از طلب","پس مصور گردد آن ذکرش به شب","فیل به خاطر عشقش به هندستان یاد آنجا را می‌کند و از این یاد، تصویر آن را در شب در ذهنش مجسم می‌سازد."],[631,"اذکروا الله کار هر اوباش نیست","ارجعی بر پای هر قلاش نیست","یاد خداوند کار هر نالایق و هر بی‌سر و سامانی نیست، یعنی نباید بی‌مقدمه و بدون آمادگی به سراغ ذکر خدا رفت؛ انسان باید برای این کار خود را آماده کند و ارزش آن را بداند."],[631,"لیک تو آیس مشو هم پیل باش","ور نه پیلی در پی تبدیل باش","اما تو ناامید نباش، مانند فیل قوی و استوار باش؛ وگرنه به سرنوشت پیلی که در پی تغییر است، دچار خواهی شد."],[631,"کیمیاسازان گردون را ببین","بشنو از میناگران هر دم طنین","خلق‌کنندگان طلا در آسمان را ببین و صدای جویندگان عشق و زیبایی را هر لحظه بشنو."],[631,"نقش‌بندانند در جو فلک","کارسازانند بهر لی و لک","چهره‌سازان ماهر در آسمان، به زیبایی و ظرافت شکل‌هایی می‌سازند که به خاطر سرنوشت و تقدیر انسان‌هاست."],[631,"گر نبینی خلق مشکین جیب را","بنگر ای شب‌کور این آسیب را","اگر زیبایی خلقت را نمی‌بینی و از وجود انسان‌های باارزش بی‌خبر هستی، به عنوان یک شب‌کور، این زشتی و آسیب را که در تاریکی غفلت از دست می‌دهی، تماشا کن."],[631,"هر دم آسیبست بر ادراک تو","نبت نو نو رسته بین از خاک تو","هر لحظه آسیبی بر درک و فهم تو وارد می‌شود، چرا که هر بار که از خاک (دنیا و بدی‌های آن) جدا می‌شوی، درک تازه‌ای به دست می‌آوری."],[631,"زین بد ابراهیم ادهم دیده خواب","بسط هندستان دل را بی‌حجاب","ابراهیم ادهم، عارف معروف، از بدی‌های دنیا بی‌خبر بود و در خواب و آرامش، زیبایی‌های سرزمین هند را بدون هیچ مانع و حجاب می‌دید."],[631,"لاجرم زنجیرها را بر درید","مملکت بر هم زد و شد ناپدید","آنگاه ابراهیم ادهم برای رهایی از این وضعیت سخت، زنجیرها را پاره کرد و حکومت را بر هم ریخت، به گونه‌ای که همه‌چیز ناپدید شد."],[631,"آن نشان دید هندستان بود","که جهد از خواب و دیوانه شود","این بیت اشاره به این دارد که نشانه هندوستان، تلاش و کوشش برای بیداری و رهایی از خواب غفلت و جنون است. به عبارت دیگر، هندستان نماد نگاهی هوشیارانه و کوشش برای خروج از وضعیت‌های نامطلوب است."],[631,"می‌فشاند خاک بر تدبیرها","می‌دراند حلقه زنجیرها","در این بیت به راستی از قدرت و تأثیر الهی صحبت می‌شود که می‌تواند تدابیر انسانی را نادیده گرفته و موانع و زنجیرهای زندگی را بشکند. به این معنا که در برابر اراده خداوند، تمامی تدابیر و محدودیت‌های بشر بی‌ثمر است."],[631,"آنچنان که گفت پیغامبر ز نور","که نشانش آن بود اندر صدور","پیامبر (محمد) درباره‌ی نور سخن گفت و نشانه‌ی آن را در دل‌ها (صدرها) معرفی کرد."],[631,"که تجافی آرد از دار الغرور","هم انابت آرد از دار السرور","کسی که از دنیای فریبنده و بی‌دوام فاصله بگیرد، به سوی دار آرامش و خوشی بازخواهد گشت."],[631,"بهر شرح این حدیث مصطفی","داستانی بشنو ای یار صفا","برای توضیح این روایت پیامبر (مصطفی)، داستانی را بشنو ای دوست مهربان."],[632,"پادشاهی داشت یک برنا پسر","باطن و ظاهر مزین از هنر","یک پادشاهی پسری جوان داشت که هم ظاهرش زیبا و هم باطنش پر از هنر و استعداد بود."],[632,"خواب دید او کان پسر ناگه بمرد","صافی عالم بر آن شه گشت درد","او (پادشاه‌زاده) خواب دید که ناگهان پسرش مرده است و این خبر باعث درد و اندوه او شد؛ چرا که او شخصی پاک و بی‌آلایش (صافی) بود و تولد پسرش در دنیا برای او خوشی و سرور به همراه داشت."],[632,"خشک شد از تاب آتش مشک او","که نماند از تف آتش اشک او","مشک او که ظاهرا به خاطر گرمای آتش خشک شده، دیگر نمی‌تواند اشکی بریزد. این بیان به نوعی به احساسات و وضعیت درونی فرد اشاره دارد که تحت تأثیر آتش، دچار بی‌احساسی و سردی شده است."],[632,"آنچنان پر شد ز دود و درد شاه","که نمی‌یابید در وی راه آه","شاه به قدری از دود و درد آکنده و غمگین شده بود که دیگر نمی‌توانست راهی برای آه کشیدن و ابراز احساساتش پیدا کند."],[632,"خواست مردن قالبش بی‌کار شد","عمر مانده بود شه بیدار شد","مرد بی‌حال و بیمار خواسته بود که از بدنش رها شود و بمیرد، ولی هنوز عمرش دراز بود که ناگهان پادشاه بیدار شد و به زندگی برگشت."],[632,"شادیی آمد ز بیداریش پیش","که ندیده بود اندر عمر خویش","شادی‌ای به سراغ پادشاه‌زاده آمد که تا آن زمان در طول عمرش آن را تجربه نکرده بود، و این شادی ناشی از بیداری و آگاهی او بود."],[632,"که ز شادی خواست هم فانی شدن","بس مطوق آمد این جان و بدن","او از شادی خواست که به طور کامل نابود شود و از این دنیا برود، زیرا این شادی مانند زینتی (طوق) برای جان و بدن اوست."],[632,"از دم غم می‌بمیرد این چراغ","وز دم شادی بمیرد اینت لاغ","از نفس غم، این چراغ وجود خاموش می‌شود و از نفس شادی، این موجود لاغر از بین می‌رود."],[632,"در میان این دو مرگ او زنده است","این مطوق شکل جای خنده است","در بین این دو مرگ، او هنوز زنده است و آنچه به ظاهر زیبا و شگفت‌انگیز می‌رسد، در حقیقت فقط مایه خنده و سخره است."],[632,"شاه با خود گفت شادی را سبب","آنچنان غم بود از تسبیب رب","شاه با خود اندیشید که شادی ناشی از غمی عمیق است که به وسیله خداوند به وجود آمده است."],[632,"ای عجب یک چیز از یک روی مرگ","وان ز یک روی دگر احیا و برگ","عجب است که یک چیز از یک سو به مرگ می‌انجامد و از سوی دیگر به احیا و زندگی دوباره."],[632,"آن یکی نسبت بدان حالت هلاک","باز هم آن سوی دیگر امتساک","در این بیت، شاعر به تقابل دو حالت متفاوت اشاره می‌کند: حالتی که ممکن است به انحطاط و هلاکت بیانجامد و حالتی که در طرف مقابل، در بر دارنده‌ی نگهداری یا حفظ و استحکام است. به طور کلی، منظور نشان دادن این تضاد بین نابودی و بقاست."],[632,"شادی تن سوی دنیاوی کمال","سوی روز عاقبت نقص و زوال","شادی‌های دنیوی فقط به کمال ظاهری مربوط می