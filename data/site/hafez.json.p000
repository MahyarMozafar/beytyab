شماره ۴۵۶","/hafez/ghazal/sh456"],["غزل شماره ۴۵۷","/hafez/ghazal/sh457"],["غزل شماره ۴۵۸","/hafez/ghazal/sh458"],["غزل شماره ۴۵۹","/hafez/ghazal/sh459"],["غزل شماره ۴۶۰","/hafez/ghazal/sh460"],["غزل شماره ۴۶۱","/hafez/ghazal/sh461"],["غزل شماره ۴۶۲","/hafez/ghazal/sh462"],["غزل شماره ۴۶۳","/hafez/ghazal/sh463"],["غزل شماره ۴۶۴","/hafez/ghazal/sh464"],["غزل شماره ۴۶۵","/hafez/ghazal/sh465"],["غزل شماره ۴۶۶","/hafez/ghazal/sh466"],["غزل شماره ۴۶۷","/hafez/ghazal/sh467"],["غزل شماره ۴۶۸","/hafez/ghazal/sh468"],["غزل شماره ۴۶۹","/hafez/ghazal/sh469"],["غزل شماره ۴۷۰","/hafez/ghazal/sh470"],["غزل شماره ۴۷۱","/hafez/ghazal/sh471"],["غزل شماره ۴۷۲","/hafez/ghazal/sh472"],["غزل شماره ۴۷۳","/hafez/ghazal/sh473"],["غزل شماره ۴۷۴","/hafez/ghazal/sh474"],["غزل شماره ۴۷۵","/hafez/ghazal/sh475"],["غزل شماره ۴۷۶","/hafez/ghazal/sh476"],["غزل شماره ۴۷۷","/hafez/ghazal/sh477"],["غزل شماره ۴۷۸","/hafez/ghazal/sh478"],["غزل شماره ۴۷۹","/hafez/ghazal/sh479"],["غزل شماره ۴۸۰","/hafez/ghazal/sh480"],["غزل شماره ۴۸۱","/hafez/ghazal/sh481"],["غزل شماره ۴۸۲","/hafez/ghazal/sh482"],["غزل شماره ۴۸۳","/hafez/ghazal/sh483"],["غزل شماره ۴۸۴","/hafez/ghazal/sh484"],["غزل شماره ۴۸۵","/hafez/ghazal/sh485"],["غزل شماره ۴۸۶","/hafez/ghazal/sh486"],["غزل شماره ۴۸۷","/hafez/ghazal/sh487"],["غزل شماره ۴۸۸","/hafez/ghazal/sh488"],["غزل شماره ۴۸۹","/hafez/ghazal/sh489"],["غزل شماره ۴۹۰","/hafez/ghazal/sh490"],["غزل شماره ۴۹۱","/hafez/ghazal/sh491"],["غزل شماره ۴۹۲","/hafez/ghazal/sh492"],["غزل شماره ۴۹۳","/hafez/ghazal/sh493"],["غزل شماره ۴۹۴","/hafez/ghazal/sh494"],["غزل شماره ۴۹۵","/hafez/ghazal/sh495"]],"couplets":[[0,"الا یا ایّها السّاقی ادر کأسا و ناولها","که عشق آسان نمود اوّل ولی افتاد مشکل‌ها","ای ساقی! جامی را (بین حاضران) بگردان و شرابش را بر ما بنوشان، که عشق در آغاز آسان به نظر آمد اما پر از دشواری‌ها بود."],[0,"به بوی نافه‌ای کآخر صبا زان طرّه بگشاید","ز تاب جعد مشکینش چه خون افتاد در دل‌ها","در آرزوی آن که باد بوی عطری از موهای او بیاورد، از تاب خوردن موهای او چقدر دل‌ها خون شد."],[0,"مرا در منزل جانان چه امن عیش، چون هر دم","جرس فریاد می‌دارد که بربندید محمل‌ها","من در خانه جانانم چه آرامش خوشی کردن دارم هنگامی که هر دم زنگ کاروان فریاد می‌زند که بارها را بر کجاوه‌ها ببندید."],[0,"به می سجّاده رنگین کن گرت پیر مغان گوید","که سالک بی‌خبر نبود ز راه و رسم منزل‌ها","اگر پیر مغان به تو بگوید که جانمازت را با شراب آلوده کن، این کار را بکن؛ چرا که رهرو از راه و روش و آداب خانه و جایگاه ها ناآگاه نیست."],[0,"شب تاریک و بیم موج و گردابی چنین هایل","کجا دانند حال ما سبک‌باران ساحل‌ها؟","در شبی تاریک در بیم موج دریا و گردابی چنین سهمگین؛ کسانی که سبک بار(آسوده یا با بار و بندیل سبک)ها بر کنار خشکی ساحل ها اند، حال ما را از کجا می دانند؟"],[0,"همه کارم ز خودکامی به بدنامی کشید آخر","نهان کی ماند آن رازی کزو سازند محفل‌ها؟","همه کارم از به دنبال رسیدن به خواسته دل خودم، سرانجام به بدنامی کشید؛ کی رازی که دورهمی‌هایی برای بحث در مورد آن تشکیل می‌شود پنهان می‌ماند؟"],[0,"حضوری گر همی خواهی از او غایب مشو حافظ","متی ما تلق من تهوی دع الدّنیا و اهملها","ای حافظ! اگر بودن در نزد او را می‌خواهی، از او دور و ناپیدا مباش؛ هرگاه دلدارت را دیدی، دنیا را رها کن و آن را واگذار."],[1,"صلاح کار کجا و من خراب کجا؟","ببین تفاوت ره کز کجاست تا به کجا","فاصله‌ی زیادی میان صلاح کار و من مست و خراب هست. ببین که تفاوت ره (فاصله) از کجا به کجاست! من کجا و مصلحت‌اندیشی کجا؟"],[1,"دلم ز صومعه بگرفت و خرقه سالوس","کجاست دیر مغان و شراب ناب کجا؟","از صومعه (عبادت‌گاه صوفیان) و خرقه‌ی فریبکاری ایشان دلم گرفت. به دنبال دیر مغان می‌گردم و شراب ناب که به آن‌جا پناه ببرم و این دل‌گیری و دل‌تنگی خود را آن‌جا فروشویم یا بازگویم."],[1,"چه نسبت است به‌ رندی صلاح و تقوا را؟","سماع وعظ کجا نغمه رباب کجا؟","رندی چه نسبتی با صلاح و تقوا می‌تواند داشته باشد؟ تناسبی با هم ندارند! گوش دادن به موعظه کجا و آواز و آهنگ و آوای خوش ساز (رباب) کجا؟"],[1,"ز روی دوست دل دشمنان چه دریابد؟","چراغ مرده کجا؟ شمع آفتاب کجا؟","دل (سیاه) دشمنان از رخسار دوست چه می‌تواند بفهمد؟ غرق شده در تاریکی (سیاه‌دل) کجا و خورشید فروزان کجا!"],[1,"چو کحل بینش ما خاک آستان شماست","کجا رویم بفرما ازین جناب، کجا","از آنجا که خاک درگاه شما سرمه چشم ما می‌باشد، بفرمایید که از این آستان به کجا برویم."],[1,"مبین به سیب زنخدان که چاه در راه است","کجا همی‌ روی ای دل بدین شتاب کجا؟","به طمع سیب زنخدان (اشاره به چانه‌ی یار) گمراه نشو که چاه در راه است (راه دشوار است). ای دل من، [که مرا همراهت می‌بری] با این شتاب به کجا می‌روی؟"],[1,"بشد! که یاد خوشش باد روزگار وصال","خود آن کرشمه کجا رفت و آن عتاب کجا؟","روزگار وصال گذشت و رفت! یادش به‌خیر! آن ناز و غمزه و کرشمه کجا رفت و آن سرزنش و عتاب کجا؟ دل شاعر برای روزگار وصال و هم کرشمه و هم عتاب معشوق تنگ شده است."],[1,"قرار و خواب ز حافظ طمع مدار ای دوست","قرار چیست صبوری کدام و خواب کجا؟","از حافظ انتظار قرار و خواب نداشته باش. قرار چیست؟ صبوری کدام است و خواب کجاست؟ و در معنای دوگانه‌ی قرار، هم می‌توان گفت که انتظار آرامش و آسودگی و خواب نداشته باش. و هم تکرار قرار در مصراع دوم، معنای پیمان‌شکنی را به ذهن می‌آورد. یعنی انگار که حافظ عهد کرده بود که آرام باشد و بیاساید، اما اکنون می‌گوید که قرار چیست؟ یعنی زیر قرار و عهد خود می‌زند! می‌گوید کدام قرار؟ صبوری ندارم که بر عهدی که ببندم وفا کنم و بر آن صابر باشم."],[2,"اگر آن ترک شیرازی به‌‌ دست‌ آرد دل ما را","به خال هندویش بخشم سمرقند و بخارا را","اگر آن ترک شیرازی دل ما (من) را به دست آورد، سمرقند و بخارا را به خال سیاه او خواهم بخشید."],[2,"بده ساقی می باقی که در جنّت نخواهی یافت","کنار آب رکناباد و گل‌گشت مصلّا را","ای ساقی! باقی‌مانده‌ی می را هم بده که بنوشم. که در بهشت هم جایی به این خوبی برای می نوشیدن نخواهی یافت."],[2,"فغان! کاین لولیان شوخ شیرین‌کار شهرآشوب","چنان بردند صبر از دل که ترکان خوان یغما را","ای داد! که این لولیان شوخ و شیرین‌کار و شهر آشوب چنان صبر از دل بردند که انگاری ترکان سفره را غارت می‌کنند."],[2,"ز عشق ناتمام ما جمال یار مستغنی‌ است","به آب و رنگ و خال و خط چه حاجت روی زیبا را؟","همان‌طور که روی زیبا نیازی به آرایش و بزک ندارد، جمال یار، نیازی به عشق بی‌کمال و بی‌ارزش من ندارد."],[2,"من از آن حسن روزافزون که یوسف داشت دانستم","که عشق از پرده عصمت برون آرد زلیخا را","من از زیبایی روزافزون یوسف حدس می‌زدم که عشق باعث می‌شود زلیخا قدم در راه گناه بگذارد."],[2,"اگر دشنام فرمایی و گر نفرین دعا گویم","جواب تلخ می‌زیبد لب لعل شکرخا را","اگر به من دشنام و نفرین هم بگویی باز هم من تو را دعا می‌گویم. تو جواب تلخ هم به من بدهی، لب لعل شکرخای تو زیباتر هم می‌شود! شکرخا بمعنای طوطی شکر خوار است ، که به یار زیبا روی که اخلاق تند و سخنان تیز دارد تشبیه شده،"],[2,"نصیحت گوش کن جانا که از جان دوست‌تر دارند","جوانان سعادتمند پند پیر دانا را","نصیحت من پیر مرد را گوش کن! چون که جوانان سعادت‌مند، پند پیر دانا را ارج می‌نهند و بیش‌تر از جان دوست دارند! به شکلی که یعنی ببخشید ها نصیحت می‌کنم جانا! و سپس نصیحت‌اش را در بیت بعدی می‌گوید"],[2,"حدیث از مطرب و می گو و راز دهر کمتر جو","که کس نگشود و نگشاید به حکمت این معمّا را","زیاد دنبال راز دهر نباش. خوش باش و در باره‌ی مطرب و می حرف بزن. سخن تازه بگو از مطرب و می. در باره‌ی اسرار و رازهای دنیا زیاد فکر نکن که نه تا حالا کسی با ابزار خرد و دانش نتوانسته کلید این معما را بگشاید و نه کسی بعد از این خواهد توانست! دم را به شادی بگذران و حدیث از مطرب و می بگو."],[2,"غزل گفتی و در سفتی بیا و خوش بخوان حافظ","که بر نظم تو افشاند فلک عقد ثریّا را","غزل گفتی و [با این غزل گفتنت، انگار،] در (مروارید و اشاره به سخن زیبا) [برای ساخت گردنبند] سوراخ کردی. بیا و غزلت را بخوان (هنرت را ارائه بده؛ منظور گردنبندی که ساختی). چرا که در مقابل نظم (شعر) تو، فلک (آسمان) عقد ثریا را ( گردنبند ثریا؛ خوشه‌ی پروین که به شکل گردنبند است) می‌افشاند (نثار می کند)."],[3,"صبا به لطف بگو آن غزال رعنا را","که سر به کوه و بیابان تو داده‌ای ما را","ای باد صبا! لطفی کن (به ملایمت) به آن غزال رعنا بگو که تو باعث شده‌ای که ما سر به کوه و بیابان بگذاریم. تو ما را در کوه و بیابان رها کرده‌ای."],[3,"شکر فروش که عمرش دراز باد چرا","تفقّدی نکند طوطی شکرخا را؟","چرا شکرفروش احوالی از طوطی شکرخا نمی‌پرسد و از او دل‌جویی نمی‌کند؟ چرا سراغی نمی‌گیرد که بداند او کجاست؟"],[3,"غرور حسنت اجازت مگر نداد ای گل","که پرسشی نکنی عندلیب شیدا را","ای گل! تکبّر و نخوتی که از زیبایی به تو دست داده باعث شده که احوالی از بلبل شیدای خودت نپرسی؟ یا به عبارتی: حتما زیبایی‌ات تو را مغرور کرده که از من سراغی نمی‌گیری."],[3,"به خلق و لطف توان کرد صید اهل نظر","به بند و دام نگیرند مرغ دانا را","با اخلاق نیکو و ملاطفت و نرمی و مهربانی می‌توان اهل نظر را صید کرد. پرنده دانا را نمی‌توان با به بند کشیدن و در دام انداختن گرفت."],[3,"ندانم از چه سبب رنگ آشنایی نیست","سهی‌قدان سیه‌‌چشم ماه‌سیما را","نمی‌دانم که چرا آدم‌های بلند قد و سیاه چشم و ماه سیما، رسم و آئین دوستی ندارند."],[3,"چو با حبیب نشینی و باده پیمایی","به یاد دار محبّان بادپیما را","وقتی که با یار خودت می‌نشینی و باده می‌نوشی، دوست‌دارانت را در یاد داشته باش و فراموش نکن! که باد را در می‌نوردند. جز باد چیزی به دست ندارند."],[3,"جز این قدر نتوان گفت در جمال تو عیب","که وضع مهر و وفا نیست روی زیبا را","به‌جز این مقدار، نمی‌توان عیبی برای تو بر شمرد که برای روی زیبا، روش مهر و وفا نیست. مهر و وفا برای زیبارویان قرار داده نشده است. یا: در قضیه جمال تو، به‌جز این (قدر و تقدیر) که مهر و وفا برای روی زیبا وضع نشده، به چیز دیگری نمی‌شود عیب گفت و ایراد گرفت. یعنی به قدر ایراد می‌گیرد نه به جمال."],[3,"در آسمان نه عجب گر به گفته حافظ","سرود زهره به رقص آورد مسیحا را","عجیب نیست اگر نغمه‌ای که سیاره زهره (معروف به مطرب و نوازنده فلک) بر روی شعر حافظ می‌نوازد، مسیحا را در آسمان به رقص بیاورد."],[4,"دل می‌رود ز دستم صاحب‌دلان خدا را","دردا که راز پنهان خواهد شد آشکارا","ای صاحب‌دلان شما را به خدا قسم می‌دهم که کمکم کنید! نزدیک است که دلم از دست برود! (و عشقم را آشکار کنم) افسوس و دردا که راز پنهان، آشکار خواهد شد."],[4,"کشتی‌شکستگانیم ای باد شرطه برخیز","باشد که باز بینم دیدار آشنا را","کشتی ما شکسته است. (ما، درون کشتی نشسته‌ایم) ای باد موافق، برخیز و خبر پایان توفان را برای ما بیاور، به امید این که بتوانم (بتوانیم) باز یار آشنا را ببینم (ببینیم)."],[4,"ده‌روزه مهر گردون افسانه است و افسون","نیکی به جای یاران فرصت شمار یارا","مدت کوتاه زندگی زود به پایان می‌رسد گویی که داستان و افسانه‌ای بیش نبوده است. آن را فرصتی بشمار که در حق یاران خوبی کنی."],[4,"در حلقه گل‌ و مل خوش خواند دوش بلبل","هات الصّبوح هبّوا یا ایّها السّکارا","در بزمی که با گل (معشوق بلبل) و شراب بود بلبل چه خوش آوازی خواند: می صبح‌گاهی را بیاور و بیدار شوید ای باده نوشان!"],[4,"ای صاحب کرامت شکرانه سلامت","روزی تفقّدی کن درویش بی‌نوا را","ای کسی که کرامتی داری، به شکرانه‌ی سلامت و تن‌درستی، زمانی هم به درویش بی‌نوا مهربانی کن. (اگر منظور از \"روزی\"، رزق و روزی باشد= به درویش بینوا کمک کن)"],[4,"آسایش دو گیتی تفسیر این دو حرف است","با دوستان مروّت با دشمنان مدارا","آسایش دو گیتی (این جهان و جهان آخرت) تفسیر این دو عبارت است: ۱. با دوستان مروّت کردن ۲. با دشمنان مدارا کردن. جدا از معنای مستقل و کامل این بیت که پندی در خور است که امروزه شکل ضرب‌المثل هم گرفته، می‌توان در ادامه‌ی گفته‌ی بیت پیشین که از صاحب کرامت، تفقّد می‌طلبد، این‌جا هم می‌گوید که اگر تو کریمی و من دوست تو ام، برای این‌که به آسایش دو گیتی دست یابی، با من مروّت، نرم‌دلی و انصاف و بزرگواری جوانمردی کن. و اگر دشمن هم باشم، با من مدارا و ملایمت کن."],[4,"در کوی نیک‌نامی ما را گذر ندادند","گر تو نمی‌پسندی تغییر کن قضا را","ما را در محلّه‌ی نیک‌نامی راه ندادند. سرنوشت ما این است که نیک‌نام نباشیم. و اگر تو این را نمی‌پسندی، برو و قضا را دگرگون کن."],[4,"آن تلخ‌وش که صوفی ام‌ّالخبائثش خواند","اشهی لنا و احلی من قبلة العذارا","آن شراب تلخ که صوفی آن را مادر پلیدی‌ها خوانده‌است، برای من از بوسه بر رخسار (یا بوسه‌ی دوشیزگان) لذت‌بخش‌تر و شیرین‌تر است."],[4,"هنگام تنگ‌دستی در عیش کوش و مستی","کاین کیمیای هستی قارون کند گدا را","زمانی که تنگ‌دست بودی، در کار خوش‌گذرانی و گذران زندگی و مستی باش. چون که مستی و خوشی، کیمیایی است که گدا و بی‌نوا را تبدیل به ثروتمند و دارا می‌کند. در شعر حافظ به این خاصیت مستی بسیار اشاره شده‌است که گدا خود را ثروتمند می‌بیند و شاه و گدا در عالم مستی یک‌سان اند."],[4,"سرکش مشو که چون شمع از غیرتت بسوزد","دلبر که در کف او موم است سنگ خارا","سرکش نشو. چون‌که دلبر از این سرکشی و نافرمانی تو، غیرت خواهد کشید و خشمگین خواهد شد. و تو را مانند شمعی که هرگاه سرکشی کند، آن را می‌کشند، خواهد سوزاند. سنگ خارا در کف دلبر مانند موم نرم و در اختیار او است. تو که جای خود داری!"],[4,"آیینه سکندر جام می است بنگر","تا بر تو عرضه دارد احوال ملک دارا","اگر دنبال آیینه‌ی اسکندر برای آگاهی از احوال جهان هستی، به تو بگویم که این آینه، همانا جام می است. به آن نگاه کن تا احوال مملکت دارا را به تو عرضه کند. جام می، خاصیتی داشته که از خط ساغر و از می درون آن، به نوعی فال و فرجام و راه‌نمایی می‌گرفتند. آئینه‌ی اسکندر هم خاصیتی داشته که از درون آن می‌شد مسافت زیادی را تحت نظر داشت. عبارت‌های جهان‌نما و جهان‌بین برای هر دو به کار رفته."],[4,"خوبان پارسی‌گو بخشندگان عمرند","ساقی بده بشارت رندان پارسا را","خوبان پارسی گو به آدم جان تازه و عمر دوباره‌ئی می‌بخشند. ای ساقی! این خبر خوش را به رندان پارسا (پیران پارسا) بده!"],[4,"حافظ به خود نپوشید این خرقه می‌آلود","ای شیخ پاک‌دامن معذور دار ما را","مصراع نخست: ۱. حافظ این خرقه‌ی می آلود را به اختیار خود نپوشیده است. ۲. حافظ این خرقه‌ی می آلوده را بر تن خود نمی‌پوشد. (تصمیم گرفت که نپوشد) مصراع دوم: ای شیخ که دامن‌ات پاک است، (خرقه‌ات می آلود نیست) ما را معاف بدار!"],[5,"به ملازمان سلطان که رساند این دعا را؟","که به شکر پادشاهی، ز نظر مران گدا را","چه‌کسی این دعا را به ملازمان سلطان می‌رساند که: به شکرانه‌ی پادشاهی، گدارا از نظر خودت مران! در راه شکرگزاری برای رسیدن به نعمتی، چیزی به فقرا می‌دهند."],[5,"ز رقیب دیوسیرت، به خدای خود پناهم","مگر آن شهاب ثاقب مددی دهد، خدا را!","از دست رقیب شیطان صفت، به خدای خود پناه می‌برم. مگر این که شهاب ثاقب، به خاطر خدا، کمکی کند. جمله به شکلی است که در برابر رقیب دیوسیرت و شیطان صفت عاجز است. و از او به خدا می‌پناهد (پناه می‌برد). کاری از دست او بر نمی‌آید! مگر این که همان‌طور که در قرآن نوشته که خدا شیطان‌ها را با شهاب ثاقب می‌راند و عذاب می‌دهد، شهاب ثاقب، محض رضای خدا، این بار بیاید به کمک شاعر و رقیب شیطان‌صفت را بزند."],[5,"مژه‌ی سیاهت ار کرد به خون ما اشارت","ز فریب او بیندیش و غلط مکن، نگارا","نگارا! اگر مژه‌ی سیاه تو به تو توصیه کرد که خون مرا بریزی؛ یا فرمان قتل ما را داد، از این واهمه کن که ممکن است تو را فریب بدهد. و کار اشتباهی انجام نده! ز فریب او بیندیش: بترس که او فریب‌کار است؛ به این فکر کن که ممکن است که تو را با عشوه و مکر غافل کند. مبادا کار اشتباهی کنی."],[5,"دل عالمی بسوزی چو عذار برفروزی","تو از این چه سود داری، که نمی‌کنی مدارا؟","وقتی که چهره‌ات را برافروخته می‌کنی، دل یک عالم را می‌سوزی. مگر چه سودی از این کار می‌بری که مدارا نمی‌کنی؟ برافروخته کردن رخسار، ناشی از خشم و غضب، یا دلبری و عشوه‌گری می‌تواند باشد. و برافروخته کردن به معنای شعله‌ور کردن، با سوزاندن دل مردم تناسب دارد. با آتش رخساره‌ات، دل عالم را می‌سوزانی. دل‌سوخته، معنای عاشق هم می‌دهد. چهره‌ی برافروخته‌ی تو همه‌ی عالمیان را عاشق و دل‌سوخته‌ی تو می‌کند. و در مصراع دوم، از معشوق می‌خواهد که با خلق جهان مدارا کند و دل ایشان را نسوزاند. و به طعنه می‌پرسد که مگر چه سودی عاید تو می‌شود از سوختن دل خلق؟ نکن!"],[5,"همه‌شب در این امیدم که نسیم صبحگاهی","به پیام آشنایان، بنوازد آشنا را","سرتاسر شب (هر شب) امیدوار ام بر این امید که بوی خوشی که از باد ملایم صبحگاهی می‌آید، با پیغامی آشنا (رایحه‌ئی که از یار می‌آید)، من (که آشنای او یم) را نوازش کند. شاعران، باد خوشی که می‌وزید را پیامی از یار می‌آوردند و باد صبا را پیغام‌آور یار؛ که از میان گیسوان او گذشته و عطر خوش زلف یار را برای شاعر آورده‌است."],[5,"چه قیامت است جانا، که به عاشقان نمودی؟","دل و جان فدای رویت، بنما عذار ما را","این چه قیامت است که به عاشقان نشان دادی؟ ای دل و جان فدای روی تو، رخ بنما! چهره‌ات را به ما نشان بده! قیامت در لغت، برخاستن و ایستادن هم هست. شور و آشوب و غوغایی که در روز رستاخیز به‌پا‌می‌خیزد نیز می‌تواند قیامت تلقّی شود. تصوّر کنید محبوبی را که چهره‌اش را پوشانده اما برمی‌خیزد و می‌ایستد یا را می‌رود. که قیامتی به عاشقان نموده است. و از او می‌خواهد که عذار و چهره‌ی خودش را نیز نشان دهد."],[5,"به خدا، که جرعه‌ای ده تو به حافظ سحرخیز","که دعای صبحگاهی، اثری کند شما را","تو را به خدا سوگند می‌دهم که جرعه‌ئی (شراب، پیمانه‌ی شراب یا یک جرعه شراب) در هنگام صبح به حافظ سحرخیز بده. (که او با نوشیدن آن تو را دعا کند). که دعای هنگام صبح که تاثیر زیادی دارد، بر شما اثر خواهد کرد. دعای خیر من به دنبال شما خواهد بود. جرعه نوشی در شعر حافظ در معنای نوشیدن ته‌مانده‌ی ممدوح و یار به هدف ابراز خاک‌ساری یا تبرّک یا قصد قربت یا رسیدن به آمال هم آمده."],[6,"صوفی بیا که آینه، صافی‌ست جام را","تا بنگری صفای می لعل‌فام را","صوفی بیا که جام دارای آینه بدون زنگار است تا تو، صفای می لعل‌گون را ببینی."],[6,"راز درون پرده ز رندان مست پرس","کاین حال نیست زاهد عالی‌مقام را","راز پشت پرده را از رندان مست بپرس. زیرا زاهد والاتبار، از چنین حال و هوایی برخوردار نیست."],[6,"عنقا، شکار کس نشود، دام بازچین","کآنجا، همیشه، باد به دست است، دام را","کسی نمی‌تواند ققنوس را شکار کند؛ پس دامت را برچین. زیرا اینجا، کاری از دام برنمی‌آید (وجود دام بیهوده است). [به استناد لغتنامه دهخدا «باد در دست داشتن» و «باد به مشت داشتن» یعنی «بیهوده بودن».]"],[6,"در بزم دور، یک‌دو قدح درکش و برو","یعنی طمع مدار وصال مدام را","در بزم نوبتی شراب نوشی یکی دو قدح سر بکش و برو. این به آن معنا است که امیدوار به وصال همیشگی نباش."],[6,"ای دل! شباب رفت و نچیدی گلی ز عیش","پیرانه‌‌سر مکن هنری ننگ و نام را","ای دل! روزگار جوانی گذشت و گلی از باغ عیش نچیدی. سر پیری، با آبرویت بازی نکن! [به استناد لغتنامه دهخدا، 1-«نام و ننگ» یعنی «آبرو، حیثیت، اعتبار» و 2-«هنری کردن» یعنی «هنرمند ساختن، دلیر کردن» (مجازا می‌تواند به معنی «بازی کردن» باشد).]"],[6,"در عیش نقد کوش که چون آبخور نماند","آدم بهشت، روضه دارالسّلام را","عیش نقد را دریاب که چون قسمت نبود، آدم باغ بهشت را از دست داد."],[6,"ما را بر آستان تو، بس حقّ خدمت است","ای خواجه! بازبین به ترحّم غلام را","من در درگاه و محضر تو بسیار خدمت کرده‌ام و از این بابت، حقّ خدمت بر گردن تو دارم. ای خواجه! به پاس این خدمت، به ملاطفت و ترحّم و بنده‌نوازی، اعتنا و توجهی به من که غلام و چاکر تو ام بکن."],[6,"«حافظ» مرید جام می است، ای صبا! برو!","وز بنده بندگی برسان شیخ جام را!","حافظ خواستار جام می است. صبا برو و به شیخ جام، بندگی مرا برسان. [به استناد لغتنامه دهخدا، «شیخ جام» لقب شیخ احمد جامی (احمدبن ابی‌الحسن‌بن محمد) است.] [ایشان در 22 سالگی از میخواری توبه کرده است.]"],[7,"ساقیا برخیز و درده جام را","خاک بر سر کن غم ایّام را","ساقی! برخیز و جام باده بده و اندوه زمانه را به خاک بسپار. [به خاک سپردن =فراموش کردن]"],[7,"ساغر می بر کفم نه تا ز بر","برکشم این دلق ازرق‌فام را","از ساقی می‌خواهد که جام می به او بدهد تا او بنوشد و لباس صوفیانه و زاهدانه خود را از تن دربیاورد. دلق و خرقه، لباسی بوده که آن را از سر به تن می‌کردند و از سر نیز بیرون می‌آوردند. از بر برکشم، جدا از جناس میان برها، بالاکشیدن و بیرون‌آوردن لباس از بالا را نشان می‌دهد. این حسّ از سر بیرون آوردن، به‌نوعی شکل انزجار و اعتراض‌آمیز را هم به تصوّر می‌‌آورد. این برکشیدن دلق ازرق‌فام، نشان می‌دهد که شاعر، چنین دلقی را به تن داشته و این‌چنین، قصد و ادّعای خود برای درآوردن این قماش جامه از تن خود را اعلام کرده‌است."],[7,"گرچه بدنامی‌ست نزد عاقلان","ما نمی‌خواهیم ننگ و نام را","در ادامه بیت پیشین که گفت ساغر می بر کف من بنه تا دلق ازرق‌فام را از سر بیرون آورم، ادامه می‌دهد که: گرچه این کار نزد عاقلان رسوایی و بی‌آبرویی و بدنامی محسوب می‌شود، ولی ما قید آبرو و اعتبار و خوش‌نامی خود را زده‌ایم و دیگر ننگ و نام را نمی‌خواهیم و به‌دنبال آن هم نیستیم."],[7,"باده درده چند از این باد غرور","خاک بر سر، نفس نافرجام را","باده بده! تا کی باید باد غرور داشت؟ خاک بر سر نفس نافرجام باد! (مرده‌شور ببرد نفس نافرجام را!)"],[7,"دود آه سینه نالان من","سوخت این افسردگان خام را","دود آه دل سوزان من، این خامان سرد و منجمد را سوزاند. خام در معنای آدم ناپخته و بی‌تجربه و ناآزموده، می‌تواند با محتوای کلّی غزل سازگار باشد. خاصه که در بیت‌های پیشین، درباره‌ی قضاوت عاقلان درباره اقدام شاعر در از تن بیرون‌کردن دلق ازرق‌فام گفته‌است. به‌عبارتی می‌گوید، این دود آه سینه نالان من، این آدم‌های ناپخته و منفعل و سرد و فسرده را هم سوزانده‌است."],[7,"محرم راز دل شیدای خود","کس نمی‌بینم ز خاص و عام را","از خاصّ و عام (چه آدم‌های نزدیک و آشنا و دوست و محرم و چه آدم‌‌های دور و غریبه و نامحرم) هیچ‌کس را نمی‌بینم که بتوانم راز دل شیدای خودم را با او در میان بگذارم. جدا از معنای دوست و غریبه بودن اشخاص، عبارت‌های خواصّ و عوام، خاصّان و عامیان و خاصّ و عام، نوعی دسته‌بندی مردم است به افرادی که برگزیده‌اند و به‌عبارتی شناخت و دانش و علم و اخلاق برگزیده دارند؛ و عوام‌النّاس کسانی که برگزیده نیستند و در آن طبقه فاضل‌ها قرار نمی‌گیرند."],[7,"با دلارامی مرا خاطر خوش است","کز دلم یک باره برد آرام را","خاطر و ضمیر و قلب من با دلارام و معشوقی خوش است که از دل من، به ناگهان و به‌کلّی آرام را برد. آرایه متناقض‌نما میان دل‌آرامی که آرام را از دل می‌برد و با این کار، خاطر را خوش می‌کند، هست. اگر این بیت را در ادامه بیت پیشین در نظر بگیریم، می‌شود گفت رازی که به خاصّ و عام نمی‌تواند بگوید، شاید به همین خاطر بوده که کسی باور نمی‌کرده که دل‌آرامی که از دل، آرام را برده، مایه خوشی خاطر شاعر است."],[7,"ننگرد دیگر به سرو اندر چمن","هرکه دید آن سرو سیم‌اندام را","هرکسی‌که آن یار سروقد با اندامی سفید و درخشان را ببیند، دیگر رغبتی ندارد که به درخت سروی که در چمن و سبزه‌زار هست، نگاه کند."],[7,"صبر کن حافظ به سختی روز و شب","عاقبت روزی بیابی کام را","ای حافظ، روز و شب در برابر سختی و دشواری و رنج و فقر و تنگ‌دستی صبور باش! سرانجام روزی به کام و خواسته دل و لذّت و بهره‌مندی و معشوق دست خواهی‌ یافت. میان معنی فقر و تنگ‌دستی برای سختی، با بهره‌مندی و خوشی برای کام تناسب هست."],[8,"رونق عهد شباب است دگر بستان را","می‌رسد مژده گل بلبل خوش‌الحان را","دوباره نیکویی و گرمی بازار دوران جوانی به بستان برگشته است. و به بلبل خوش آواز، مژده‌ی آمدن گل می‌رسد. به‌جز این، می‌توان گفت که بستان باعث شده است که روزگار جوانی ما رونق بگیرد و بازار آن گرم شود. در این حالت می‌توان بلبل خوش‌الحان مصراع دوم را خود شاعر در نظر گرفت که به او مژده‌ی گل (دیدار و وصل یار) رسیده است."],[8,"ای صبا گر به جوانان چمن باز رسی","خدمت ما برسان سرو و گل و ریحان را","ای باد صبا! اگر به نو رسته‌های باغ رسیدی، ارادت ما را به سرو، گل و ریحان برسان. [با توجه به آنچه که در حاشیه این غزل آمده است، «جوانان چمن» یعنی «نو رسته‌های باغ»]"],[8,"گر چنین جلوه کند مغبچه باده‌فروش","خاک‌روب در میخانه کنم مژگان را","اگر مغبچه‌ی باده‌فروش، این‌چنین خود را نشان بدهد و ناز و کرشمه و دلبری کند، مژه‌های خودم را جاروی در می خانه خواهم کرد. اگر مغبچه‌ی باده‌فروش چنین به چشم من در آید و دل از من ببرد، حاضر ام برای آن که مقیم میخانه باشم، در هیئت یک خدمت‌کار، در میخانه را جارو بزنم. آن هم با مژه‌های خودم."],[8,"ای که بر مه کشی از عنبر سارا چوگان","مضطرب‌حال مگردان، من سرگردان را","ای که بر رخ ماهت زلف مشکین می‌افکنی! من سرگردان را پریشان‌حال مکن."],[8,"ترسم این قوم که بر دردکشان می‌خندند","در سر کار خرابات کنند ایمان را","با حالتی طعنه‌آمیز می‌گوید: می‌ترسم که آن گروه و دسته‌ئی که به شراب‌خواران می‌خندند و آن‌ها را مسخره می‌کنند، خودشان سرانجام ایمان خودشان را در سر کار خرابات و کارهای عیاشی و فسق، دربازند و بدهند!"],[8,"یار مردان خدا باش که در کشتی نوح","هست خاکی که به آبی نخرد طوفان را","مفهومی که شاعر در این بیت بی نظیر در پی رساندن آن است همان خودداری از لذتی است که تورا ممکن است درگیر توفان کند! شاعر در مصراع اول مخاطب را دعوت به همراهی با یاران خدا می‌کند و در ادامه و مصراع دوم توضیح می‌دهد که اگر می‌خواهی در کشتی نوح سوار شوی و از توفان و بلا به دور باشی باید همچون خاکی (یا موجود خاکی یا همان انسان) که در کشتی نوح، بی آبی را به جان می‌خرد تا مگر نکند که طلب و دعای او توفانی را باعث شود، خوددار باشی. مردان خدا از بیم توفان آگاهند و با لذت‌های گذرا خود را به خطر پیاده شدن از کشتی نوح و از دست دادن هم‌نشینی با یاران خدا نمی‌اندازند."],[8,"برو از خانه گردون به در و نان مطلب","کآن سیه‌کاسه در آخر بکشد مهمان را","اگر به طلب نان به در خانه‌ی گردون آمده‌ای، از آن خارج شو و از او طلب نان مکن! چون که این بخیل رذل، سرانجام مهمان را خواهد کشت. می گوید این گردون، مثل شخص سیاه‌کاسه‌ئی است که نه تنها نان به تو نخواهد داد، بلکه در آخر تو را خواهد کشت! فرار کن!"],[8,"هر که را خوابگه آخر مشتی خاک است","گو چه حاجت که به افلاک کشی ایوان را","خوابگاه پایانی هر کسی، یک مشت خاک است. بگو چه نیازی است و چه فایده دارد که خانه و عمارت و کاخ خود را به آسمان برسانی و ایوان و قصر بلند بسازی؟ همه سرانجام در زیر مشتی خاک خواهیم خوابید."],[8,"ماه کنعانی من! مسند مصر آن تو شد","وقت آن است که بدرود کنی زندان را","ای یوسف کنعانی من (باستعاره مقصود جان پاک)کرسی فرمانروایی ملک مصر(به استعاره مقصود عالم معنی)تراست،هنگام آنست که زندان (باستعاره مقصود قفس تن یا زندان دنیا )را وداع کنی و عزیز و فرمانروا در ملک معنی شوی"],[8,"حافظا می خور و رندی کن و خوش باش ولی","دام تزویر مکن چون دگران قرآن را","ای حافظ! می بخور! رندی بکن! و خوش باش! اما مانند دیگران، قرآن را دامی برای مکر و فریب دادن و به دروغ زیور کردن کارهای خودت قرار نده. واژه‌ی «قرآن» در این غزل آمده‌است. و در بیت‌های این غزل تلمیح‌هایی از آیه‌ها و قصّه‌های قرآنی نیز آمده. به نوعی شاعر در بیت آخر، به صراحت این موضوع را یادآوری کرده است. به شکلی که یعنی از قرآن نیز می‌توان به درستی استفاده کرد و آن را دام تزویر نکرد."],[9,"دوش از مسجد سوی میخانه آمد پیر ما","چیست، یاران طریقت! بعد از این تدبیر ما؟","شاعر انگاری برای دوستان‌اش تعریف می‌کند که: دیشب، پیر ما، از مسجد به میخانه آمد. ای یاران طریقت، ای هم مسلکان اهل سلوک! بعد از این ما چه کاری باید بکنیم؟ نکته‌ئی که در این بیت هست این که شاعر از فعل آمد استفاده کرده! نگفته پیر ما سوی میخانه رفت! گفته سوی میخانه آمد. یعنی انگاری خود شاعر در میخانه بوده و آن‌جا حضور داشته که دیده!"],[9,"ما مریدان روی سوی قبله چون آریم؟ چون","روی سوی خانه خمّار دارد پیر ما","در ادامه‌ی بیت پیشین که دنبال تدبیری می‌گشت، می‌گوید: ما مریدان که می‌بایست پی‌رو پیر باشیم، چگونه رو به سوی قبله بیاوریم و نماز بخوانیم، وقتی که پیر ما روی به سوی خانه‌ی باده‌فروش دارد؟"],[9,"در خرابات طریقت ما به هم منزل شویم","کاین چنین رفته‌ است در عهد ازل تقدیر ما","ما مریدان، با پیر طریقت، در خرابات طریقت، با هم در یک‌جا هم منزل می‌شویم. زیرا که در عهد ازل، تقدیر ما این‌چنین رفته‌است. چاره‌ئی نیست!"],[9,"عقل اگر داند که دل در بند زلفش چون خوش است","عاقلان دیوانه گردند از پی زنجیر ما","اگر عقل بداند که دل در بند زلف یار چه قدر خوش است، عاقلان، به دنبال زنجیر ما، مانند دیوانه ها می‌گردند. عاقلان دیوانه گردند، اگر گشتن را به معنای شدن در نظر بگیریم، به‌سادگی می‌توان گفت: عاقلان از پی زنجیر ما دیوانه می‌شوند. زنجیر ما در این معنا می‌تواند همان زلف یار باشد که دل ما در بند آن است و حال خوشی هم دارد."],[9,"روی خوبت آیتی از لطف بر ما کشف کرد","زآن زمان جز لطف و خوبی نیست در تفسیر ما","۱. روی خوب تو نشانه‌یی از خوبی و زیبایی را بر ما آشکار ساخت، ۲. روی خوب تو، لطف و بخششی به ما کرد و تفسیر آیتی را بر ما آشکار ساخت که پیش از آن نمی‌دانستیم، از آن زمان به بعد، در بیان ما و شرح ما جز لطف و خوبی نمی‌آید. چیزی جز لطف و خوبی و آیتی که روی خوب تو بر ما کشف کرده را نمی‌توانیم در تفسیر آیات قرآن بیان کنیم. به عبارتی دیگر، خوبی روی تو، نشانه‌یی از لطف است. به همین سبب، از زمانی که روی تو را برهنه و آشکار دیده‌ایم، جز لطف و خوبی تفسیر دیگری نمی‌توانیم از آیات خدا کنیم."],[9,"با دل سنگینت آیا هیچ درگیرد شبی","آه آتشناک و سوز سینه شبگیر ما؟","آیا آه آتشین و سوز ناله‌ی سحرگاهی ما در دل سنگین تو هیچ تاثیری دارد؟ آه و سوز سینه‌ی شب‌گیر را هم می‌توان آه و سوزی دانست که هنگام شبگیر و سحرگاه از سینه‌ی شاعر بر می‌آید. و هم می‌توان سینه‌ی شاعر را به مرغی تشبیه کرد که هنگام سحر، آه و ناله‌های حزین و سوزناک می‌کند."],[9,"تیر آه ما ز گردون بگذرد، حافظ خموش","رحم کن بر جان خود، پرهیز کن از تیر ما","هشدار و تحذیری می‌دهد که از تیر آه ما حذر کن و بر جان خودت رحم کن. چون که تیر آه ما بسیار نافذ است و حتا از فلک هم می‌گذرد. اما این هشدار را سرراست به یار نمی‌گوید. خطاب به خود می‌گوید که خاموش باش حافظ و تیر آهی به سوی فلک پرتاب نکن. اما در مصراع دوم، پرهیز کن از تیر ما به نظر می‌رسد مخاطب‌اش یار باشد نه خود حافظ مصراع اول!"],[10,"ساقی به نور باده برافروز جام ما","مطرب بگو که کار جهان شد به کام ما","غزل با لحنی شادمانه آغاز شده‌است. از ساقی می‌خواهد که جام را با نور باده روشن و گلگون کند. و از مطرب می‌خواهد که غزلی بگوید؛ که جهان به کام ما شده‌است. برافروختن جام، در معنای روشن کردن، تشبیه شراب به آتش است که در مشعل جام قرار می‌گیرد و فروزان می‌شود. بگو در معنای سخن بگو، این معنا را می‌تواند برساند که از مطرب خواسته است، به همه بگوید و اطلاع دهد که کار جهان به کام ما شده‌است. بگو، معنای سرودن و آواز خواندن هم دارد. در این معنا، می‌توان گفت که از مطرب خواسته که نغمه‌ئی بخواند. به این دلیل که کار جهان به کام ما شده است. یعنی به شادباش آن که کار جهان به کام ایشان شده، بزمی ترتیب داده و از ساقی می‌خواهد که آتش جام را بر فروزد و از مطرب می‌خواهد که نغمه‌ئی طرب‌انگیز بخواند."],[10,"ما در پیاله عکس رخ یار دیده‌ایم","ای بی‌خبر ز لذّت شرب مدام ما","ما در پیاله (جهان) چهره یار را دیده ایم، ای بی خبر از این لذت وصل همیشگی و. لذت رحظه لحظه ما از زندگی"],[10,"هرگز نمیرد آن که دلش زنده شد به عشق","ثبت است بر جریده عالم دوام ما","آن کسی که دل‌اش به عشق زنده است، هرگز نخواهد مرد. دوام و بقا و جاودانگی ما در دفتر روزنامه‌ی عالم ثبت شده‌است."],[10,"چندان بود کرشمه و ناز سهی‌قدان","کآید به جلوه سرو صنوبرخرام ما","کرشمه و ناز سهی‌قد ها تا جایی و تا زمانی است که سرو صنوبرخرام ما به جلوه در آید. یعنی تا زمانی جرئت و مجال خودنمایی و عرض اندام دارند که او خود را نشان نداده‌است. چندان بود، معنای دیگری هم دارد: «به اندازه‌ئی هست که...» در این حالت، می‌توان گفت که کرشمه و ناز سهی‌قدان به آن اندازه‌ئی شده که سرو صنوبرخرام ما خود را نشان بدهد. یعنی زمان آن فرا رسیده‌است. چون‌که سهی‌قدان کرشمه را از حد برده‌اند."],[10,"ای باد اگر به گلشن احباب بگذری","زنهار، عرضه ده بر جانان پیام ما","ای باد! اگر به گلشن دوستان گذشتی، حتما پیام ما را به دلدار برسان."],[10,"گو نام ما ز یاد به عمدا چه می‌بری؟","خود آید آن که یاد نیاری ز نام ما","در ادامه‌ی بیت پیش، به صبا می‌گوید پیغام من را بگو! از او بپرس: چرا به عمد، نام ما را از یاد می‌بری؟ به‌هرحال، آن روزی که نام ما به یادت نیاید، خواهد رسید. به عبارتی: بالاخره روزی خواهد رسید که نام ما را به یاد نیاوری"],[10,"مستی به چشم شاهد دلبند ما خوش است","زآن رو سپرده‌اند به مستی زمام ما","معناهای متفاوت واژه را در پرانتز می‌آورم و این پرانتز به معنای مترادف بودن نیست. مستی (خماری چشم، مست بودن، گلایه، اندوه) به چشم شاهد دلبند ما خوش می‌نشیند (خوش‌آیند است). زآن‌رو (به همین خاطر است که، از آن چهره) اختیار ما را (از آن روز که ما را از شیر گرفتند)، به مستی (مست بودن، یک مست، چشم مست یار) سپرده‌اند."],[10,"ترسم که صرفه‌ای نبرد روز بازخواست","نان حلال شیخ ز آب حرام ما","برای حال شیخ نگران ام! می‌ترسم که در روز قیامت، روزی که مردم را بابت کارهای‌شان در این دنیا بازخواست می‌کنند، نان حلال شیخ، برتری و مزیتی به آب حرام ما نداشته باشد! نان حلال و آب حرام، کنایه‌هایی اند که از قول شیخ و زاهد گفته. که گویا نانی که آن‌ها می‌خورند حلال است و آبی که شاعر و رندان می‌نوشند، حرام است. عبارت‌های حرام و حلال هم اصطلاح‌های شرع است. آب حرام هم اشاره به می است و هم اشاره به نگرش شیخ به گروهی که شاعر خود را از آنان می‌داند که از دید شیخ و واعظ، آبی هم که بنوشند، حرام است! به طعنه می‌گوید که می‌ترسم سر آخر که روز بازخواست است، نان حلال آن‌ها از اب حرام ما ارج و قرب بیش‌تری نداشته باشد!"],[10,"حافظ ز دیده دانه اشکی همی‌فشان","باشد که مرغ وصل کند قصد دام ما","حافظ! دانه اشکی از دیده بیفشان؛ به امید اینکه مرغ وصل به دام تو بیفتد!"],[10,"دریای اخضر فلک و کشتی هلال","هستند غرق نعمت حاجی‌قوام ما","آسمان و ماه درون آن، به‌مانند دریا و کشتی داخل آن، همه غرق نعمت حاجی قوام ما هستند. حاجی قوام یا قوام‌الدین حسن از رجال معروف آل مظفّر بوده است که در دوران جوانی حافظ در شیراز حکم‌رانی می‌کرده‌اند. گویا حاجی قوام بزم‌ها و خوان پر نعمتی نیز داشته‌است که شاعر نیز از میهمانان او در این بزم‌ها بوده و شاعر در چند غزل نیز از او به نیکویی یاد کرده‌است."],[11,"ای فروغ ماه حسن‌، از روی رخشان شما","آب‌روی خوبی از چاه زنخدان شما","ای که فروغ ماه زیبایی (سرچشمه زیبایی)، از پرتو روی شما است! و خوبی، از چاه زنخدان شما می‌تراود!"],[11,"عزم دیدار تو دارد جان بر لب آمده","باز گردد یا برآید؟ چیست فرمان شما؟","این جان من که بر لبم رسیده است، قصد دارد که تو را ببیند. دستور شما چیست؟ باز گردد؟ یا برآید؟ در نگاه اول به نظر من می‌آمد که جان بر لب رسیدن و جان بر لب آمده کنایه از سختی و تحمّل رنج بسیار و به ستوه آمدن و طاقت از دست دادن از بابت این تحمّل سختی و رنج است. و تصویری که بود، مشقّت و سختی بسیار شاعر در راه رسیدن به دیدار و وصال معشوق بود که در میانه‌ی راه از او کسب تکلیف می‌کند که چه کنم؟ بازگردم یا به سوی تو بیایم؟ دیگر این است که این جان است که عزم دیدار دارد. نه خود شاعر! و این جان، جانی است که بر لب آمده. یعنی جان در حال احتضار و مشرف بر مرگ است. در این تصویر، بازگشتن جان به بدن، زندگی و نجات از مرگ است. و برآمدن جان، مرگ و رفتن جان از بدن. و این هر دو اتفاق، بسته به دستور و فرمان معشوق است. که اگر فرمان دهد که به دیدار یار نائل شود، جان بر لب آمده به بدن شاعر باز خواهد گشت؛ و اگر نه، جان بر لب آمده از بدن بیرون خواهد آمد. و دیگر این که برآمدن کام به معنای برآورده شدن آرزو و خواسته هم در شعر حافظ به کار رفته است."],[11,"کس به دور نرگست طرفی نبست از عافیت","به که نفروشند مستوری به مستان شما","مستان هم در مجاز اشاره به چشمان یار است و هم در معنای واقعی، کسانی که مست اند. در این حالت، مستان شما می‌تواند کسانی باشند که از چشمان شما یا عشق شما مست شده‌اند. دور نرگس هم می‌تواند زمانه و دوره‌ئی باشد که نرگس می‌شکفد. اگر نرگس را استعاره از چشم یار بگیریم، دور نرگس می‌تواند پیرامون و گرداگرد چشم باشد. هم‌چنین به دور نرگس می‌تواند گردیدن و چرخیدن عاشق به گرد چشم یار باشد. مستوری، هم به معنای پارسایی و زهد و عفت آمده و هم پوشیدگی و در پرده نشستن. مستوری فروختن در معنای نخست می‌شود متکبّرانه پارسائی و عفت خود را به رخ کسی کشیدن. نوعی نشان دادن چیزی است که دارند، با حالت متکبّرانه و خودپسندانه. هیچ کس در گرداگرد چشم تو و در دور نرگس تو، بهره و نصیبی از عافیت و سلامت نبرده است، یا به دلیل پارسایی و ورع، چشم خودش را نبسته و از دور نرگس تو چشم‌پوشی نکرده است. بهتر است که کسی به جرگه‌ی مستان تو و کسانی که مست تو اند، فخر پارسایی و پرده‌نشینی نفروشد. هر کسی در دور نرگس تو بود، از عافیت طرفی نمی‌بست. پس اگر مستور بوده‌ای و او را ندیده‌ای، بهتر است که به مستان یار فخر فروشی نکنی. بهتر آن است که در مقابل چشمان مست شما ادعای پاک‌دامنی نکنند."],[11,"بخت خواب‌آلود ما بیدار خواهد شد مگر","زان که زد بر دیده آبی، روی رخشان شما","شاعر در این بیت، بخت خود را خواب‌آلود دانسته و انتظار دارد که بخت او بیدار شود. یک راه برای بیدار کردن کسی که خوابیده‌است، این است که چند چکّه آب بر روی و حوالی چشم او بزنند. و امید دارد که روی درخشان شاعر، که بر وی افتاده است، به سان قطره‌های آبی که بر صورت شخصی خواب‌آلود می‌چکد، بخت او را بیدار کند. انگاری که روی رخشان یار، بر چشم شاعر، آبی زده‌است."],[11,"با صبا همراه بفرست از رخت گل دسته‌ای","بو که بویی بشنویم از خاک بستان شما","انگاری رخ یار به بوستانی تشبیه شده و شاعر از یار می‌خواهد که هنگامی که باد صبا می‌وزد، گل‌دسته‌ئی از این بوستان رخ‌اش همراه این باد کند و به سمت شاعر بفرستد. به این امید که از خاک بوستان شما بویی بشنویم. خاک بوستان، می‌تواند حسّ دوری از وطن هم باشد. بو به معنای اثر و نشان از چیزی هم هست. مانند اصطلاح «از انسانیت بویی نبرده»! گل‌دسته، هدیه فرستادن را هم به یاد می‌آورد."],[11,"عمرتان باد و مراد ای ساقیان بزم جم","گرچه جام ما نشد پر می به دوران شما","ای ساقیان بزم جم! الهی که عمر و مراد داشته باشید. اگرچه که جام ما به دوران ما از می پر نشد! می‌توان گفت که ساقیان بزم جم، اشاره به خود جم باستانی باشد خاصه آن که در مصراع دوّم گفته که جام ما به دوران شما از می پر نشد. اما در مصراع نخست، برای این ساقیان، آرزوی عمر و مراد کرده. و این، بیش‌تر به ذهن من می‌آورد که این ساقیان زنده اند. می‌ماند واژه‌ی دوران که به معنای روزگار و عهد و زمان است. کسی که زنده است، دوران او هنوز باقی است. و این عبارت که گرچه به دوران شما جام ما پر می نشد، برای شخص یا بزمی که معاصر است، دور از ذهن می‌نماید. مگر این که دوران را شکلی از «بزم دور» در نظر بگیریم. یعنی دوران را در معنای گردش جام در بزم در نظر بگیریم. و بگوییم در بزم دور شما، جام ما پر از می نشد."],[11,"دل خرابی می‌کند، دلدار را آگه کنید","زینهار ای دوستان‌، جان من و جان شما","دل، بی‌تابی و ناشکیبی می‌کند و حال و روز خوبی ندارد. ای دوستان! به شما پناه می‌برم! شما را سوگند می‌دهم که دل‌دار را از این حال خراب دل من آگاه کنید و به اطلاع او برسانید."],[11,"کی دهد دست این غرض یا رب که همدستان شوند‌؟","خاطر مجموع ما، زلف پریشان شما","به شکل حسرت یا آرزو عنوان می‌کند: چه زمانی این هدف و مقصود حاصل می‌شود و میسّر می‌شود که خیال و افکار ما به دست زلف پریشان و در هم بر هم شما آسوده و راحت شود. خاطر و اندیشه‌ی شاعر پریشان است. و شاعر می‌خواهد که با قرین شدن با زلف پریشان محبوب، به آسودگی و جمعیّت برسد. هم‌دستان شوند را می‌توان دو هم‌دست در نظر گرفت. دو رفیق که با هم متّفق شده‌اند. تصویر من، دو شخص که دست در دست هم گذاشته‌اند. انگاری خاطر شاعر، دست در زلف پریشان یار کرده و مجموع و آسوده‌است."],[11,"دور دار از خاک و خون دامن، چو بر ما بگذری","کاندر این ره کشته بسیارند، قربان شما","وقتی که بر ما می‌گذری، دامن خودت را بالاتر بگیر تا به خاک و خون آلوده نشود. چون که در این راه، بسیاری کشته شده‌اند. قربان شما. قربان را در هر یک از معناهایی که از لغت‌نامه‌ها آوردم می‌توان به کار برد. در معنای ندیم شاه، می‌توان این معنا را گرفت که ندیمان و نزدیکان بسیاری که داشتی در این راه کشته شده‌اند. این راه می‌تواند راهی باشد که یار به سوی شاعر می‌آید تا بر او بگذرد، می‌تواند همان راهی باشد که برای نزدیکی و قربان و ندیمی شاه می‌بایست پیمود تا به آن مرتبت رسید. قربان به معنای تیردان و کمان‌دان و ترکش هم می‌تواند این تصویر را در ذهن بیاورد که انگاری خود یار، آن اشخاص را کشته و به خاک انداخته. قربان شما به صورت صوت مخفف قربان شما بشوم، می‌تواند معنای قربان صدقه رفتن و گفتار احترام آمیز با مقام عالی هم باشد. در معنای «قربانی» هم می‌تواند در بیت بنشیند به این شکل که بسیاری در این راه قربانی شما شده‌اند. در هر کدام از این حالت‌ها، شاعر به یار می‌گوید چون که زمین راهی که از آن طریق می‌خواهی بر ما بگذری، آکنده از جنازه‌های بسیارانی است که در این راه کشته شده اند، دامن‌ات را از خاک و خون دور نگاه دار که مبادا دامنت کثیف شود؛ یا این خاک و خون، دامن‌ات را بگیرد. در این معنای آخر، می‌توان «دور دار از خاک و خون دامن» را طور دیگری نیز تعبیر کرد: نوعی تحذیر که از این خون‌ریزی و کشتار جلوگیری کن! یا دامن خودت را از این خاک و خون دور بدار! خودت را کنار بکش! چو بر ما بگذری نیز شکلی قدرت‌نمایی یا تهدید می‌تواند داشته باشد! که اگر بر ما بگذری، دامن‌ات را از خاک و خون دور بدار! چون در این راه، کسانی که دامن از خاک و خون دور نداشته‌اند، پیش از تو، بسیار کشته شده‌اند."],[11,"می‌کند حافظ دعایی، بشنو، آمینی بگو","روزی ما باد لعل شکّرافشان شما","حافظ دعایی می‌کند (من دعایی می‌کنم) بشنو و بگو آمین! دعای من این است: بادا که لعل شکّر افشان شما روزی و نصیب و قسمت ما شود."],[11,"ای صبا با ساکنان شهر یزد از ما بگو","کای سر حق‌ناشناسان گوی چوگان شما","ای صبا! از طرف ما به ساکنان شهر یزد بگو که ای کسانی که بادا که سر ناسپاسان و کسانی که حق نعمت و خوبی که به ایشان کردید را نمی‌گزارند و نمی‌شناسند، مانند گوی در پای چوگان شما باشد! (بقیه در بیت بعدی)"],[11,"گرچه دوریم از بساط قرب‌، همّت دور نیست","بنده شاه شماییم و ثناخوان شما","اگرچه که از بساط نزدیکی دوریم و از هم‌جواری با شما محروم، اما اراده و عزم ما دور نیست! بنده‌ی شاه شما و ستاینده و ثناخوان شماییم. بساط قرب می‌تواند سفره‌ئی باشد که تنها نزدیکان و خویشان بر آن می‌نشینند و این معنا با «بزم جم» که در بیت‌های پیشین این غزل آمده، تناسبی دارد. همّت دور نیست می‌تواند هم به این معنا باشد که دعا و طلب خیر ما وابسته به بعد مکان نیست و اگرچه دوریم، اما دعای خیر ما از شما دور نیست و همواره با شما است؛ هم می‌توان گفت: اگرچه از بساط قرب دوریم، اما این عزم و اراده هست که به شما نزدیک شویم و به سمت شما بیاییم."],[11,"ای شهنشاه بلند اختر‌، خدا را همّتی","تا ببوسم همچو اختر خاک ایوان شما","ای شاهنشاه بلند اقبال که ستاره‌ی بخت‌ات بلند است. از خدا همّتی می‌طلبم که مانند ستاره که خاک ایوان رفیع تو را می‌بوسد، من هم بتوانم خاک ایوان شما را ببوسم."],[12,"می‌دمد صبح و کلّه بست سحاب","الصبوح الصبوح یا اصحاب","صبح در حال طلوع کردن است و ابرها، متراکم شده‌اند انگاری که پرده‌ئی خیمه‌طور و رقیق بر آسمان بسته‌اند. ای یاران! برخیزید که شراب صبح‌گاهی بنوشیم. صبح و صبوح و اصحاب و سحاب جناس و هم‌آوایی دارند. برای دمیدن در معناهای دیگر، قرینه‌ئی نیافتم و همان دمیدن صبح به معنای طلوع آفتاب را در نظر گرفتم. هرچند دمیدن صبح به تعبیر دعا و فسون‌دمیدن نیز در شعر حافظ به کار رفته."],[12,"می‌چکد ژاله بر رخ لاله","المدام المدام یا احباب","ژاله بر رخ لاله می‌چکد[۱] ای دوستان! برای نوشیدن باده برخیزید! توصیفی از هوای مه‌آلود دم صبح می‌تواند باشد. اما در حقیقت، در هوای مه‌آلود صبح، ژاله در معنای شبنم، بر رخ لاله نمی‌چکد. از رخ لاله می‌چکد. خاصه این‌که شاعر جای دیگر نیز گفته ژاله از ابر بهمنی می‌چکد. و جایی نیز ژاله را به باده‌ئی تشبیه کرده که به درون کاسه‌ی قدح شکل لاله چکیده‌است. با این اوصاف، می‌توان ژاله را باران معنی کرد. یا می‌توانم ادعا کنم که در آن زمان، تصور می‌کردند که قطره‌های شبنم، بر برگ گل می‌چکیده. اما امروز می‌دانیم که شبنم حاصل از رطوبت صبحگاهی است نه چکّه‌های باران. هرچند عرق بر صورت یار را به شبنم تشبیه کرده باشند."],[12,"می‌وزد از چمن نسیم بهشت","هان، بنوشید دم به دم می ناب","از سبزه‌زار، بادی ملایم با عطر خوش بهشت می‌وزد، بشتابید و در هر نفس که از این نسیم استشمام می‌کنید، پی در پی و بسیار، می ناب بنوشید. وزیدن نسیم بهشت و اشاره به نوشیدن می ناب، می‌تواند اشاره به آیاتی از قرآن باشد که در توصیف بهشت، از نوشاندن باده‌ی ناب و طهور (رحیق مختوم) خبر داده‌است. که چون نسیم بهشت می‌وزد، می‌بایست باده‌ی ناب نوشید. سوره مطففین آیه 25 تا 28: يسقون من رحيق مختوم ﴿٢٥﴾ ختامه مسک ۚ وفي ذلک فليتنافس المتنافسون ﴿٢٦﴾ ومزاجه من تسنيم ﴿٢٧﴾ عينا يشرب بها المقرّبون ﴿٢٨﴾"],[12,"تخت زمرد زده است گل به چمن","راح چون لعل آتشین دریاب","گل، مانند شاهی، تخت زمرد بر چمن و مرغزار زده است. فرصت شادمانی و نشاط را غنیمت بدان و باده‌ی مانند یاقوت سرخ و آتشین را در نظر داشته باش. زمرد و لعل با هم تناسب دارند. دریاب نیز، واژه‌ی در را در خود دارد که در تبادر، با زمرد و لعل تناسب می‌یابد. خاصه که شاعر، دریافتن و در یافتن را در غزلی دیگر به صراحت کنار هم نیز آورده. راح و راح روح در معنای اصطلاحی موسیقی با آتشین در معنای سوزناک نیز تناسبی می‌سازند و این فضا، به تصویر مجلس بزم شاهانه در گوشه‌ی چمن نیز می‌افزاید."],[12,"در میخانه بسته‌اند دگر","افتتح یا مفتّح الابواب","در میخانه را دیگر بسته‌اند. به شکل دعا، از خدا که گشاینده‌ی هر دری است می‌خواهد که آن را بگشاید. دگر هم به معنای از این پس و هم در معنای دوباره و دیگربار در این بیت خوش می‌نشیند. دگر، به معنای باز و دوباره، می‌تواند به معنای بسته شدن مجدّد در میخانه باشد و هم به شکل قیدی. که: از این پس، در میخانه را بسته‌اند. در نگاهی دیگر می‌توان گفت که عبارت «دگر» در انتهای مصراع نخست، مربوط به جمله‌ی مصراع دوم باشد. یعنی: در می‌خانه را بسته‌اند. دیگربار آن را باز کن ای گشاینده‌ی درها. در نسخه‌ی 801 به‌جای دگر، مگر آمده است."],[12,"لب و دندانت را حقوق نمک","هست بر جان و سینه‌های کباب","جان و سینه‌های کباب، بر لب و دندان تو بسی حقّ نمک دارند. آن جان و سینه‌هایی که از عشق تو کباب شده‌اند، حقی بر لب و دندان تو دارند که آن‌ها را کباب کرده‌ای. انگاری که دل و جان آن‌ها را به‌دندان کشیده‌ای و خورده‌ای! امروز نیز رسم است که کسی که در نزد کسی نان و نمکی خورده‌است، به حرمت آن نان و نمک، دین و وظیفه‌ئی اخلاقی نسبت به او بر گردن‌اش می‌افتد. به گمان من، شاعر تصویری ساخته از دلبری که عاشقانی دارد که جان و دل و سینه‌ی آن‌ها کباب شده و دلبر، آن کباب را به دندان کشیده و با لب خود خورده‌است. سینه‌ی کباب، دلی است که از عشق یار، بر آتش افتاده و کباب شده؛ هم‌چنین سینه‌ی مرغی که کباب می‌کنند و به آن نمک می‌زنند و می‌خورند. و می‌گوید که آن جان و سینه‌های کباب از غم عشق تو، بر گردن لب و دندان تو حقّ نمک دارند. و می‌بایست این حق را نگه‌داری و با آن‌ها به خوبی رفتار کنی. از طرفی خود دندان یار نیز می‌تواند به سنگ نمک تشبیه شده باشد. درست برعکس همین هم می‌توان معنا کرد: لب و دندان نمکین تو، بر گردن جان و سینه‌های کباب حقّ نمک دارد. این دومین تعبیر از طرفی تشبیه دندان سفید به سنگ نمک را هم در خود دارد. در این حال، معشوق را بر گردن عاشقان محقّ می‌کند."],[12,"این چنین موسمی عجب باشد","که ببندند میکده به شتاب","در این فصل و این زمان، عجیب است که با این سرعت و تعجیل، میکده را ببندند. به‌جز به‌شتاب (با تعجیل و بدون درنگ و با عجله) می‌توان بشتاب (عجله کن) هم خواند؛ اما نظر به این‌که در میخانه را بسته‌اند، تعجیل موردی ندارد! باز اگر در حال بستن بود می‌شد تعبیر کرد که پیش از بسته شدن خود را به آن برسان!"],[12,"بر رخ ساقی پری پیکر","همچو حافظ بنوش باده ناب","هم‌چو حافظ، تو نیز با نگاه کردن به رخ ساقی پری‌پیکر، می ناب بنوش. می نوشیدن با نگاه کردن به چهره‌ی نگار خوب‌روی و به‌روی یار و بر رخ ساقی، در شعر حافظ کاری لذت‌بخش و متهوّرانه توصیف شده. هم‌چو حافظ که بر رخ ساقی خوش‌اندام می‌نگرد و با نگاه در رخ او باده‌ی ناب می‌نوشد، تو نیز این‌چنین بنوش."],[13,"گفتم ای سلطان خوبان رحم کن بر این غریب","گفت در دنبال دل، ره گم کند مسکین غریب","به او گفتم: ای سلطان خوبان! بر این غریب و دور افتاده از وطن و مسکن رحمی کن! گفت: غریب مسکین، وقتی که به دنبال دل خود بیفتد، راه خود را گم خواهد کرد. شاعر با لحنی خضوع‌آمیز، از مخاطب خود که او را سلطان خوبان می‌نامد، می‌خواهد به رسم این که سلطان است، به او به‌سان غریب و مسافر و گم‌گشته، شفقت و ترحّم و مهربانی کند. و مخاطب‌اش، به او پاسخ می‌دهد. به نوعی شماتت‌اش می‌کند که تو به دنبال دل خود رفتی و راه را گم کردی. به شکلی که انگاری شایسته و لایق ترحم و عطوفت من نیستی. خود مقصّر بودی که راه را گم کردی. غریب در مصراع دوّم بجز معنای مسافر و بی‌چاره و بی‌چیز و کسی که از وطن خود دور مانده، با توجه به عبارت‌های راه گم کردن و به دنبال چیزی رفتن، با در نظر داشتن این حقیقت که مسافران راه را با استفاده از ستاره‌ها و صور فلکی می‌یافته‌اند، می‌تواند معنای اصطلاحی غریب در نجوم را هم به ذهن بیاورد."],[13,"گفتمش مگذر زمانی، گفت معذورم بدار","خانه پروردی چه تاب آرد غم چندین غریب","به او گفتم که اندکی بمان و مرا ترک نکن و مرو، گفت: مرا ببخش! نمی‌توانم! یک خانه‌پرورد و نازپرورده، تاب و تحمّل غریبی و غریبان را ندارد. گفتم‌اش: مگذر زمانی! به او گفتم که اندکی درنگ کن و از برابر من مگذر و مرو و دور مشو. گفت: عذر مرا بپذیر! (نمی‌توانم این خواسته‌ی تو را اجابت کنم و نگذرم!) مصراع دوم را هم می‌توان در ادامه‌ی گفته‌ی معشوق و مخاطب شاعر دانست و هم می‌توان در نظر گرفت که معشوق فقط گفته‌است معذور م بدار و به راه خود ادامه داده‌است. و مصراع دوّم، گفت‌و‌گوی شاعر با خود است. و من این دومی را دوست می‌دارم. انگاری که شما به کسی بگویی اندکی بنشین و از برابر من و از نزد من مگذر و مرو، او فقط بگویید ببخشید! نمی‌شود! و برود. و شما در ادامه، با خودتان توجیه‌وار بگویید: بعله دیگه! یک آدم خانه‌پرورد و نازپرورده، تحمل و تاب غم غریبی چون من را ندارد. درکی از این درد و غم من ندارد! بماند تا من برای او بگویم هم تاب و تحمّل شنیدن‌اش را ندارد. به همین‌خاطر است که نماند و رفت. اما اگر مصراع دوم را بخواهیم در ادامه‌ی گفتار معشوق در نظر بگیریم، می‌شود دلیلی که معشوق برای نماندن‌اش آورده. انگاری که بگوید من خانه‌پرورد ام و تاب و تحمّل غریبی ندارم. می‌توان گفت که معشوق مهربانانه پوزش طلبیده و گفته که در این راه غربت و سرگشتگی که تو داری، من تاب و یارای هم‌راهی ندارم و مرا معذور بدار! و می‌رود."],[13,"خفته بر سنجاب شاهی نازنینی را چه غم؟","گر ز خار و خاره سازد بستر و بالین غریب","برداشت من این است که این بیت هم ادامه‌ی همان واگویه‌ی درونی شاعر است که از مصراع دوم بیت پیشین آغاز شده. نازنین و لطیف نازپرورده‌ئی که در رخت‌خواب شاهانه‌ئی که از پوست سنجاب ساخته شده خوابیده است، چه غم دارد اگر غریب و بی‌چاره‌ئی از بوته‌ی خار برای خود بستر ساخته باشد و به‌جای بالش، سر بر سنگ خارا بگذارد و بخوابد؟ میان خار و خاره و بستر و بالین، لفّ و نشر مرتّب هست. اصطلاح امروزی روی بالش پر قو خوابیدن، مشابه خفته بر سنجاب شاهی است."],[13,"ای که در زنجیر زلفت جای چندین آشناست","خوش فتاد آن خال مشکین بر رخ رنگین غریب",": ای کسی که در زلف مانند زنجیر تو عاشقان و یاران زیادی جای دارند، خال سیاه عطرآگین تو بر آن چهره‌ی زیبا و درخشنده‌ی تو خیلی زیبا جای گرفته است و خوش نشسته‌است. زنجیر یا سلسله، ریسمان و بندی فلزی است که از حلقه‌های تو در تو تشکیل شده. در شعر حافظ، زنجیر و سلسله، بیش‌تر به زلف یار تشبیه شده. در این بیت زلفی است که در زنجیر آن، چندین عاشق جای گزیده‌اند. یار را شخصی خطاب می‌کند که دل عاشقان زیادی در زنجیر زلف او گرفتار است؛ و می‌افزاید که آن خال مشکین هم بر رخ درخشان او خوش افتاده است. برای افتادن معناهای زیادی ضبط شده اما در این بیت، حسی که از خوش فتاد می‌گیرم، انگاری بگوید چه نیکو نشسته و چه برازنده‌است. و غریب در این بیت، قیدی است برای خوش افتادن. هم‌چنین خال مشکین بر صورت تنها است. مانند دل که در زنجیر زلف جای دارد و انگاری احوال او خوش است. خال غریب و تنها هم جای خوش و خوبی افتاده‌است."],[13,"می‌نماید عکس می، در رنگ روی مه‌وشت","همچو برگ ارغوان بر صفحه نسرین، غریب","عکس شراب در رنگ رخسار محبوب مانند رنگ برگ ارغوانی بر روی گل نسرین به نظر می‌رسد و این تصویر، احساس غریب و یکتایی دارد."],[13,"بس غریب افتاده است آن مور خط، گرد رخت","گرچه نبود در نگارستان، خط مشکین غریب","مور خط گرد رخسار تو، بسیار تنها است. هرچند، در نگارستان ارژنگ، وجود سایه‌خط جای چندان شگفتی نیست."],[13,"گفتم ای شام غریبان طرّه شبرنگ تو","در سحرگاهان حذر کن چون بنالد این غریب","به او گفتم: ای کسی که موی سیاه و شب‌‌رنگ‌ات مانند شام غریبان تاریک است! از ناله و آه هنگام سحرگاه این غریب بترس و بپرهیز. تاثیر دعا و آه سحرگاهی را به یار یادآور می‌شود و از او می‌خواهد که از آن بپرهیزد. می‌گوید ای کسی که طرّه‌ی تو چون شام غریبان سیاه است و به‌عبارتی از عشق تو روزگارم چون شب غریبان سیاه شده، این شب، سحری دارد و دوری کن از این که این غریب، در سحرگاهان، ناله‌ئی کند."],[13,"گفت حافظ آشنایان در مقام حیرتند","دور نبود گر نشیند خسته و مسکین غریب","به من پاسخ داد و گفت: ای حافظ! آشناها، سرگردان و متعجّب اند. غریب که جای خود دارد! هیچ بعید و دور نیست که غریب خسته و غم‌گین بنشیند. به عبارتی می‌گوید حال و روز آشناها هم تعریفی ندارد و متحیر مانده‌اند. تو که غریبی هیچ استبعادی ندارد که مجروح و خسته و غم‌گین در جایی بنشینی. آشنا و غریب با هم تضاد دارند و دور نیز با غریب متناسب است. به‌عبارتی در پاسخ به درخواست التفات شاعر و تهدید او به آه و ناله‌ی سحری، می‌گوید که تو نباید برای خود جایگاه خاصی قائل شوی. در جایی که آشنایان در مقام حیرت اند، غریب اگر خسته و غمگین بنشیند، موضوع عجیب و دور از انتظاری نیست."],[14,"ای شاهد قدسی، که کشد بند نقابت؟","وی مرغ بهشتی، که دهد دانه و آبت؟","ای محبوب بهشتی! چه کسی بند روبند تو را می‌کشد؟ و ای مرغ بهشتی! چه کسی دانه و آب به تو می‌دهد؟ بند نقاب کشیدن، نزدیک بودن و محرم بودن را نشان می‌دهد و دانه و آب دادن نیز نوعی هم‌خانه بودن. از مخاطب شعر خود با لحنی شبیه عتاب و آمیخته با حسادت پرسشی می‌کند. شاهد به معنای معشوق و محبوب و زیباروی آمده‌است. برخلاف «قدسی» که در ادبیات کهن و به‌ویژه ادبیات عرفانی، نوعی هاله‌ی قداست و پاکی و الاهی با خود دارد، شاهد، عبارتی با بار معنایی زمینی و چه‌بسا مذموم دارد. با این برداشت‌ها، این ترکیب شاهد قدسی، تناقضی هم در خود دارد. با نوعی دلهره آمیخته با حسادت، یا در گفت و گویی خیالی میان خود و معشوق، یا مستقیم، مورد خطاب قرار می‌دهد که چه کسی به تو نزدیک است و می‌تواند بند نقاب تو را بکشد و چهره‌ی بی روبند تو را ببیند."],[14,"خوابم بشد از دیده در این فکر جگرسوز","کآغوش که شد منزل آسایش و خوابت؟","در این فکر جگرسوز که آغوش چه کسی منزل آسایش و خواب تو شده، خواب از دیده‌ی من رفته‌است. در آغوش چه کسی می‌آسایی و به خواب می‌روی؟"],[14,"درویش نمی‌پرسی و ترسم که نباشد","اندیشه آمرزش و پروای ثوابت","حالی از تهی‌دست و درویش نمی‌پرسی! می‌ترسم که توجه و بیمی از این‌که خدا تو را بیامرزد نداشته باشی و اعتنا و میلی به انجام ثواب نداشته باشی! معروف است که پرسیدن درویش، یا به فکر نیازمندان و مستمندان بودن، ثوابی است که نیکوکار، پاداش انجام این کار خوب و پسندیده را در آخرت از خدا خواهد گرفت. انگاری شاعر در این بیت خود را درویش گفته و انتظار دارد که همان‌طور که اغنیا و نیکوکاران، برای ثواب، حالی از فقرا و نیازمندان می‌پرسند و دستی از او می‌گیرند، یار، جویای احوال او شود که ثواب دارد! و چون می‌بیند که یار چنین التفاتی به او ندارد، به طنز آمیخته به طعنه می‌گوید بیم دارم که هیچ به فکر آخرت خود نباشی! و ترس و فکر و واهمه‌ئی از بابت آمرزش حق نداری و انگار اعتنا و میل و رغبتی به انجام کار ثواب هم نداری!"],[14,"راه دل عشّاق زد آن چشم خماری","پیداست از این شیوه که مست است شرابت","آن چشم خماری تو، دل عاشقان را دزدیده‌است، یا: آن چشم خمار، نغمه‌ئی باب دل عاشقان زده‌است. از این ناز و عشوه و وضعی که داری، مشخّص است که شراب تو، مست است. «این شیوه»، شیوه‌ی چشم یار است که شرابی خوش نوشیده‌است و مست است و چنین راه دل عشاق می‌زند."],[14,"تیری که زدی بر دلم از غمزه خطا رفت","تا باز چه اندیشه کند رأی صوابت","تیری که از غمزه بر دل من زدی، خطا رفت. تا این بار ببینیم که اراده و عزم درست تو چه تدبیری خواهد اندیشید. تیری از غمزه، اگر غمزه در معنای مژه و در معنای برهم زدن مژگان از ناز و کرشمه باشد، می‌توان گفت تیری که یار از غمزه به دل یار زده، تیر مژگان و تیر نگاه و کرشمه است که بر دل یار زده. از غمزه خطا رفت را هم اگر به این شکل معنی کنیم که با ناز و غمزه زدی، به همین خاطر که دقیق نشانه‌گیری نکردی، خطا رفت و درست به هدف نخورد. و باید ببینیم که این بار که به‌درستی و با دقت و با رای صواب و قصد و عزم راست و درست تیر بزنی، چه خواهد شد. اندیشه و رای و صواب نیز در تناسبی، معنای دیگری ایجاد می‌کنند. رای صواب را حکم و اراده و میل درست و راست در نظر بگیریم. و اندیشه را هم به معنای تدبیر و تفکر و هم به معنای بیم می‌شود در نظر گرفت. تا حکم صواب تو این بار چه فکری خواهد کرد."],[14,"هر ناله و فریاد که کردم نشنیدی","پیداست نگارا که بلند است جنابت","هرچه‌قدر که ناله و فریاد کردم، تو نشنیدی. معلوم است و پیداست که درگاه و آستانه‌ی قصری که در آن زندگی می‌کنی رفیع است. (که صدای من و ناله و فریاد من به گوش تو نمی‌رسد) حسی مثل اختلاف طبقاتی امروز را به ذهن می‌آورد که ناله و فریاد ضعفا به گوش بلندمرتبه‌ها نمی‌رسد. و هم‌چنین این حس را از بیت می‌گیرم که شاعر به تضرّع یا گدایی یا عرض نیاز و زاری به در معشوق آمده و از آن‌جا سر و صدا و استغاثه کرده. اما معشوق صدای او را نشنیده و التفاتی نکرده. و شاعر به کنایه گفته پیداست و به نظر می‌رسد که جناب و آستانه‌ی تو بسیار بلند است که صدای من را نشنیدی."],[14,"دور است سر آب از این بادیه، هشدار","تا غول بیابان نفریبد به سرابت","بسیار می‌باید راه بپیمایی تا به سر آب برسی. مبادا غول بیابان در میانه‌ی راه تو را به سراب بفریبد. مخاطب این هش‌دار، می‌تواند دل خود شاعر باشد نه مخاطب شعر. و در بیت بعدی نیز دل خود را خطاب قرار داده."],[14,"تا در ره پیری به چه آیین روی ای دل","باری به غلط صرف شد ایّام شبابت","حالا که دوران جوانی تو به غلط صرف شد. ببینیم در ره پیری به چه طریق و روشی خواهی رفت. ره پیری، مسیری را به ذهن من می‌آورد که در پیری طی خواهد کرد. به آئینی رفتن یعنی به شیوه و سبکی زندگی کردن. به طعنه سخن می‌گوید: ببینیم زمان پیری خود را به چه آئین و طرز و روشی خواهی پیمود. حالا که ایّام جوانی را به غلط و به نادرستی سپری کردی. حال مشخص نیست که منظور شاعر از غلط چیست و آئین و روش کدام است! هم می‌توان گفت که در جوانی نتوانستی اندوخته‌ئی برای آخرت بیندوزی و در دوران پیری جبران کن و به مذهب و آئینی برو که چنین اندوخته‌ئی با خود ببری؛ هم می‌توان برعکس این را تلقی کرد. که در جوانی که نتوانستی به کام و آرزوی دل برسی، ببینیم پیری چه می‌کنی!"],[14,"ای قصر دل‌افروز که منزلگه انسی","یا رب مکناد آفت ایّام، خرابت","ای قصر دل‌افروز که خانه‌ی امید و منزل انس مایی. از خدا می‌خواهم که آفت ایّام، تو را خراب نکند. به نظر من، مخاطب این بیت، همانا قصر و کاخ است. البته می‌توان استعاره از معشوق یا یار هم در نظر گرفت. اما حسی که من می‌گیرم، نوعی دعای خیر برای قصر شخص بزرگی است که این قصر دل‌افروز، منزل‌گاه انس است. و منزل‌گه انس، هم می‌تواند اشاره به جایی باشد که عاشق و معشوق در آن موانست و دیدار و وصال داشته‌اند؛ و هم می‌تواند اشاره به قصر و تالار و خانه‌ی بزرگی باشد که عشاق و شاعران و اهل دل را در آن، راهی بوده و در آن مجالس انس، روزگاری خوش داشته‌اند."],[14,"حافظ نه غلامیست که از خواجه گریزد","صلحی کن و بازآ که خرابم ز عتابت","حافظ، آن غلامی نیست که از خواجه و ارباب خود بگریزد و برود. من از خشم گرفتن تو خراب ام. آشتی کن و برگرد. خواجه، سلطان و ارباب، گاهی بر بندگان خود خشم می‌گیرد. در هر حال حکم او جاری و ساری است و جرمی بر او نبود و بسته به کرم و عنایت و لطف خواجه بود که بر بنده ببخشاید و مهربانی کند یا نه. گاهی غلامان از عتاب و خشم اربابان خود می‌نالیدند یا می‌گریختند، اما غلامانی با وجود جور و جفا و خشم خواجگان، هم‌چنان به او وفادار می‌ماندند"],[15,"خمی که ابروی شوخ تو در کمان انداخت","به قصد جان من زار ناتوان انداخت","خم زیبایی که در ابرو انداختی، آهنگ جان من ناتوان را داشت."],[15,"نبود نقش دو عالم، که رنگ الفت بود","زمانه طرح محبّت، نه این زمان انداخت","نشانی از دو جهان نبود که عشق وجود داشت. روزگار، طرح محبت را در این زمان نکشیده است."],[15,"به یک کرشمه که نرگس به خودفروشی کرد","فریب چشم تو صد فتنه در جهان انداخت","نرگس با کرشمه فقط خودنمایی کرد اما چشم تو با یک کرشمه صد غوغا و آشوب در جهان افکند."],[15,"شراب‌خورده و خوی‌کرده می‌روی به چمن","که آب روی تو آتش در ارغوان انداخت","مست و گرم و عرق‌کرده در چمن راه می‌روی و طراوت روی تو ارغوان را سرخ و تب‌دار کرد."],[15,"به بزمگاه چمن، دوش، مست، بگذشتم","چو از دهان توام غنچه در گمان انداخت","دیشب از چمن به‌حالت مستی می‌گذشتم زیرا غنچه گل‌سرخ را با دهان تو اشتباهی‌گرفتم."],[15,"بنفشه طرّه مفتول خود گره می‌زد","صبا حکایت زلف تو در میان انداخت","بنفشه زلف پرتاب خود را می‌بافت؛ صبا قصه زلف تو را گفت."],[15,"ز شرم آن که به روی تو نسبتش کردم","سمن به دست صبا، خاک در دهان انداخت","سمن از شرم اینکه او را به روی تو نسبت دادم، با وزش باد دهان فروبست."],[15,"من از ورع، می و مطرب ندیدمی زین پیش","هوای مغبچگانم در این و آن انداخت","من در عمرم اهل میگساری و نشستن در مجلس مطربان نبودم، عشق مغبچگان مرا به این کارها انداخت. (ورع‌: پرهیزگاری)"],[15,"کنون به آب می لعل، خرقه می‌شویم","نصیبه ازل از خود نمی‌توان انداخت","اکنون خرقه زهد خود را با شراب سرخ می‌شویم؛ قسمت ازلی را نمی‌شود از خود دور کرد."],[15,"مگر گشایش حافظ در این خرابی بود","که بخشش ازلش، در می مغان انداخت","مثل اینکه قسمت حافظ این بود که گشایش کارش در این خرابی و مستی باشد؛ که بخشش ازلی، او را در کار می مغان انداخت."],[15,"جهان به کام من اکنون شود که دور زمان","مرا به بندگی خواجه جهان انداخت","اکنون که دنیا به میل و خواست من فراهم شده، احساس می‌کنم که در زمانه‌ای که در آن زندگی می‌کنم، به صورت برده‌ای برای قدرت و ثروت اربابان بزرگ گرفتار شده‌ام."],[16,"سینه از آتش دل، در غم جانانه بسوخت","آتشی بود در این خانه که کاشانه بسوخت","سینه‌ام به خاطر عشق و غم معشوقه‌ام مشتعل شد و به شدت درد می‌کشم. آتشی که به دل من افتاده چنان قویی بود که موجب ویرانی و نابودی خانم و زندگی‌ام شده است."],[16,"تنم از واسطه دوری دلبر بگداخت","جانم از آتش مهر رخ جانانه بسوخت","بدن من از دوری معشوق به شدت در حال احتراق است و روح من از عشق چهره beloved جانانه، همچون آتش در حال سوختن است."],[16,"سوز دل بین که ز بس آتش اشکم، دل شمع","دوش بر من ز سر مهر، چو پروانه بسوخت","دل من را ببین که از شدت درد و آتش اشک‌هایم چقدر می‌سوزد. دل شمع دیشب به خاطر عشق و محبتش به من، مانند پروانه‌ای که به شمع می‌سوزد، سوخت."],[16,"آشنایی نه غریب است که دلسوز من است","چون من از خویش برفتم، دل بیگانه بسوخت","آشنای من که نسبت به من دلسوز است، غریبه نیست. چون من از خودم خارج شدم و به اعماق درد و رنج رفتم، دل شخص دیگری که بیگانه است نیز از این حال من سوزانده شده است."],[16,"خرقه زهد مرا، آب خرابات ببرد","خانه عقل مرا، آتش میخانه بسوخت","مصرع اول‌: خرقه‌ زاهدی‌ام را به‌گرو در میخانه گذاشتم."],[16,"چون پیاله دلم از توبه که کردم بشکست","همچو لاله، جگرم بی می و خمخانه بسوخت","چون پیاله دلم به خاطر توبه‌ای که کردم شکست، مانند گل لاله، جگرم با نبودن شراب و میخانه، سوخت."],[16,"ماجرا کم کن و بازآ که مرا مردم چشم","خرقه از سر به درآورد و به شکرانه بسوخت","ماجرا و نزاع را پایان بده و باز آی، زیرا که مردم چشم من به شکرانه دیدارت خرقه (زهد) مرا به‌در آورده و سوخته است (و منتظر دیدار دوباره توست)"],[16,"ترک افسانه بگو حافظ و می نوش دمی","که نخفتیم شب و شمع به افسانه بسوخت","به افسانه بسوخت‌: به داستان (و شنیدن قصه ما) سوخت."],[17,"ساقیا آمدن عید مبارک بادت","وان مواعید که کردی مرود از یادت","ای ساقی آمدن عید مبارکت باشد و آن وعده‌ها که به من داده از خاطرت نرود. (مواعید = جمع موعود به معنی چیزی که وعده داده شده)"],[17,"در شگفتم که در این مدّت ایّام فراق","برگرفتی ز حریفان دل و دل می‌دادت","در تعجبم ه چگونه در این مدت فراق که از حریفان دل برگرفتی، این جدایی و روی‌گردانی را دلت هم قبول کرد. یعنی در این مدت که در حال اختفاء بودی و به حریفان، دیدار نشان نمی دادی، تعجب می‌کنم که چگونه دلت این را تحمل کرد. (شگفت= تعجب،‌ برگرفتی ز حریفان دل= از حریفان دل کندی، دل می‌دادت= دلت اجازه می‌داد)"],[17,"برسان بندگی دختر رز، گو به درآی","که دم و همّت ما کرد ز بند، آزادت","ای ساقی! بندگی ما را خدمت دختر رز برسان و بگو که بیرون آی. یعنی اخنفاء را ترک کن که دم همت ما تو را از غم آزاد کرد. حضرت خواجه این معنا را با کنایه تعبیر می‌فرمایند. (بندگی= خدمت . رز= درخت انگور است و دختر رز کنایه از شراب است ) (توضیح: ماه حرام ربطی به شراب ندارد و عید همایونی هم شاهدی در کلام حافظ ندارد. چنان که در پیغام اهل راز آمده است: از آمدن عيد و شادى و عيش حاصل از رو کردن بخت به محبوب يا ممدوح حکايت مى‌کند.)"],[17,"شادی مجلسیان در قدم و مقدم توست","جای غم باد، مر آن دل که نخواهد شادت","شادی و سرور اهل مجلس، در قدوم مبارک توست. جای غم باشد هر آن دلی که تو را شاد نخواهد. یعنی غمگین باشد هر دلی که شادی و خندانی تو را نخواهد."],[17,"شکر ایزد که ز تاراج خزان رخنه نیافت","بوستان سمن و سرو و گل و شمشادت","شکر خدا که بوستان سمن و سرو و گل و شمشاد تو از باد خزان در امان ماند (شاید مقصود از زیبایی و جوانی است که از تاراج سختی روزگار مدیری در امان مانده است)."],[17,"چشم بد دور کز آن تفرقه‌ات بازآورد","طالع نامور و دولت مادرزادت","چشم بد از تو دور که طالع نیک و بخت بلندت، تو را از آن تفرقه و جدایی به پیش ما باز آورد."],[17,"حافظ از دست مده دولت این کشتی نوح","ور نه طوفان حوادث ببرد بنیادت","ای حافظ، مصاحبت این کشتی نوح را از دست مده یعنی همنشینی باده‌نوشان را ترک مکن. وگرنه طوفان حوادث، بنیاد وجودت را از بین می‌برد. یعنی از باده جدا مشو ، وگرنه تمام غم ها و هموم بلیّات روزگار ، بنیاد وجودت را تلف می کند . (کشتی نوح= منظور قدحی است به شکل قایق که بعضی اشخاص آن را از نقره و بعضی از شاخ گاو و بعضی از چوب می‌سازند)."],[18,"ای نسیم سحر آرامگه یار کجاست؟","منزل آن مه عاشق‌کش عیّار کجاست؟","ای باد سحر (صبا: باد سحرگاهی که در نزد شعرا معروف هست بر اینکه نامه‌ی عاشق را به معشوق میبرد و بو و نسیم یار را به عاشق میرساند) تو که خبر داری بگو محل آرامش و خواب یار کجاست؟ منزل آن ماه زیبای عاشق کش چالاک (همگی توصیف کننده‌ی یار هست) کجاست؟"],[18,"شب تار است و ره وادی ایمن در پیش","آتش طور کجا موعد دیدار کجاست؟","شب تاریک است و راه صحیح در برابرمان نیست. در آتش کوه طور (جایی که موسی پیامبر با خداوند ملاقات کرد) که نشانه روشنایی و الهام است، دیدار ما کی و کجا خواهد بود؟"],[18,"هر که آمد به جهان نقش خرابی دارد","در خرابات بگویید که هشیار کجاست؟","آمدن به جهان همراه است با وارد شدن در چرخه‌ی فنا و ناپایداری ، در خرابات، همه مست حقیقت‌اند و آنچه «هوشیاری» دنیوی نامیده می‌شود (حسابگری، سود و زیان، ترس و امید معمولی) دیگر جایی ندارد."],[18,"آن‌کس است اهل بشارت که اشارت داند","نکته‌ها هست بسی محرم اسرار کجاست؟","کسی که به راستی بشارت می‌دهد، کسی است که می‌تواند نشانه‌ها را درک کند. دریایی از نکته‌های عمیق وجود دارد، ولی سؤال این است که افراد آگاه به این اسرار در کجا هستند؟"],[18,"هر سر موی مرا با تو هزاران کار است","ما کجاییم و ملامت‌گر بی‌کار کجاست؟","ما با تو ارتباط و درگیری‌های زیادی داریم، اما ما در کجای این دنیا هستیم و شخصی که باید ما را به خاطر این ارتباط سرزنش کند، کجاست؟"],[18,"باز پرسید ز گیسوی شکن در شکنش","کاین دل غم‌زده سرگشته گرفتار کجاست؟","اگر می‌خواهید بدانید که دل عاشق من کجا گرفتار شده بروید از گیسوی مجعد و پیچیده‌اش بپرسید."],[18,"عقل دیوانه شد آن سلسله مشکین کو؟","دل ز ما گوشه گرفت ابروی دلدار کجاست؟","عقل ما دیوانه شد آن زنجیر خوشبو (زلف یار) کجاست؟ دل با ما قهر کرد، (گوشه و اشاره) ابروی دلدار کجاست؟ (تا دل با ما آشتی کند)"],[18,"ساقی و مطرب و می جمله مهیّاست ولی","عیش بی‌یار مهیّا نشود یار کجاست؟","در این بیت، شاعر به این موضوع اشاره می‌کند که اگرچه ساقی (سرویس‌دهنده شراب)، نوازنده (مطرب) و شراب (می) آماده و فراهم هستند، اما لذت واقعی زندگی بدون وجود یار (معشوق) قابل دسترسی نیست. پس از او می‌پرسد یار کجاست؟"],[18,"حافظ از باد خزان در چمن دهر مرنج","فکر معقول بفرما گل بی‌خار کجاست؟","کاربر: حافظ می‌گوید که از سختی های روزگار در مسیر مقصودت رنجیده خاطر نشو همان طور عقل حکم میکند هیچ مقصودی بدون سختی و رنج بدست نمی آید."],[19,"روزه یک‌سو شد و عید آمد و دل‌ها برخاست","می ز خم‌خانه به‌جوش آمد و می‌ باید خواست","زمان روزه به پایان رسید و عید فرا رسید و باعث شادی دل‌ها شد. اکنون شراب از میخانه در حال جوشیدن است و باید شراب نوشید."],[19,"نوبه زهدفروشان گران‌جان بگذشت","وقت رندی و طرب کردن رندان پیداست","زمانه ی آدم های ظاهرنما و خالی از عبادت قلبی و واقعی، گذشت و زمانه ی عبادت واقعی از سوی مومنان قلبی و واقعی شروع شده."],[19,"چه ملامت بود آن را که چنین باده خورد؟","این چه عیب است بدین بی‌خردی؟ وین چه خطاست؟","چه مشکلی دارد اگر کسی این‌گونه (برای عبادت واقعی) شراب بنوشد؟ چه اشکالی است در جامعه که از بی خردی نشعت می‌گیرد؟ و این چه اشتباهی است؟"],[19,"باده‌نوشی که در او روی و ریایی نبود","بهتر از زهدفروشی که در او روی و ریاست","باده خوری که در کارش ریا نداشته باشد بهتر و ارزشمند تر از زاهدی است که به دنبال ریا و خودنمایی است"],[19,"ما نه رندان ریاییم و حریفان نفاق","آن‌که او عالم سرّ است، بدین حال گواست","ما اهل ریا و نفاق نیستیم و رفیقانی از جنس بد نیستیم. تنها کسی که به اسرار و حقیقت آگاه است، شاهد این حال ماست."],[19,"فرض ایزد بگزاریم و به کس بد نکنیم","وان چه گویند روا نیست، نگوییم رواست","فرض کنیم که خداوند وجود دارد و ما به هیچ‌کس آسیب نرسانیم. همچنین چیزهایی که دیگران می‌گویند و به نظر نادرست می‌آید، ما هم آنها را درست نمی‌دانیم و نباید آنها را تأیید کنیم."],[19,"چه شود گر من و تو چند قدح باده خوریم؟","باده از خون رزان است، نه از خون شماست","چه مشکلی دارد که من و تو چند قدح باده بخوریم، باده و شراب از درخت انگور گرفته میشود و چیزی از شما کم نمیشود و ضرری به شما نمیرسد"],[19,"این چه عیب است کز آن عیب، خلل خواهد بود؟","ور بود نیز چه شد؟ مردم بی‌عیب کجاست؟","این چه عیبی است که اگر باشد، موجب نقص خواهد شد؟ اگر هم باشد، چه اهمیتی دارد؟ مگر در دنیا کسی بدون عیب و نقص وجود دارد؟"],[20,"دل و دینم شد و دلبر به ملامت برخاست","گفت با ما منشین، کز تو سلامت برخاست","عشق و دین من با هم از دست رفت و محبوبم به اتهام و سرزنش روی آورد، به من گفت که با تو نمی‌توانم بمانم چون از تو امنیت و آسایش برنمی‌آید."],[20,"که شنیدی که در این بزم، دمی خوش بنشست؟","که نه در آخر صحبت به ندامت برخاست","کسی را که در این مهمانی لحظه‌ای خوشایند گذرانده بشنوی، که او در پایان صحبت به پشیمانی نرسید."],[20,"شمع اگر زان لب خندان به زبان، لافی زد","پیش عشاق تو شب‌ها به غرامت برخاست","اگر شمع از لب‌های خندان تو برای جذابیت و زیبایی‌ات در جمع عاشقان تعریف کند، شب‌ها برای جلب توجه و زیبایی‌ات خود را به زحمت می‌اندازد."],[20,"در چمن، باد بهاری ز کنار گل و سرو","به هواداری آن عارض و قامت برخاست","در باغ، نسیم بهاری از کنار گل و درختان سرو به خاطر زیبایی و اندام آن معشوقه به حرکت درآمد."],[20,"مست بگذشتی و از خلوتیان ملکوت","به تماشای تو آشوب قیامت برخاست","تو با حالت مستی از کنار ما گذشتی و باعث شدی که فرشتگان ملکوت، به تماشای تو، شور و غوغایی مانند قیامت برپا کنند."],[20,"پیش رفتار تو پا برنگرفت از خجلت","سرو سرکش که به ناز از قد و قامت برخاست","به خاطر شرم و حیایی که از رفتار تو دارد، سرو قدبلند و مغرور هم نتوانست قدمی بردارد، زیرا از زیبایی و ناز تو قد می‌کشد."],[20,"حافظ این خرقه بینداز مگر جان ببری","کآتش از خرقه سالوس و کرامت برخاست","حافظ می‌گوید این لباس روحانی را رها کن، اگر میخواهی جانت را نجات دهی . چرا که شعله‌ آتش از این لباس ظاهری و فریبنده برخاسته است."],[21,"چو بشنوی سخن اهل دل، مگو که خطاست","سخن‌شناس نه‌ای، جان من! خطا این جاست","وقتی کلام و اندیشه‌ی عاشقان و عارفان را می‌شنوی مگو که سخن و اندیشه‌­ای اشتباه است؛ در واقع خطا و اشتباه اصلی اینجاست که تو هنوز سخن و اندیشه‌ی درست را تشخیص نداده‌­ای"],[21,"سرم به دنیی و عقبی فرو نمی‌آید","تبارک الله ازین فتنه‌ها که در سر ماست","چنان شور و فتنه‌های عجیب و شگفتی در سرم وجود دارد که حاضر نیستم تسلیم نعمت­‌های این­ جهانی و آن­ جهانی شوم"],[21,"در اندرون من خسته‌دل ندانم کیست!","که من خموشم و او در فغان و در غوغاست","نمی‌دانم در وجود من دل‌خسته چه کسی هست، چرا که باوجود خاموش بودن من او هنوز مشغول بانگ و فریاد و جوش و خروش است(نکته: در ذهن و باور قدما این اعتقاد وجود داشت که شاعر در سرودن شعر هیچ‌گونه اختیار و اراده‌­ای ندارد بلکه نیرویی درونی او را به سرودن شعر وا می‌­دارد؛ اعراب جاهلی باور داشتند جن و یا پری در درون آنها به آنها شعر تلقین می‌کنند و آن را تابعه می‌نامیدند)"],[21,"دلم ز پرده برون شد، کجایی ای مطرب؟","بنال، هان که از این پرده، کار ما به نواست","راز دلم آشکار و من رسوا گشتم و یا دل من آهنگ و نغمه‌ی حقیقی خود را فراموش کرد؛ هان ای مطرب کجایی؟ فریاد کن چرا که از نغمه توست که حال و کار ما به سامان می‌رسد(از پرده شدن دل: ایهام دارد؛ ۱. رسوا گشتن، ۲. از نغمه و آهنگ به هنجار خود خارج شدن)"],[21,"مرا به کار جهان هرگز التفات نبود","رخ تو در نظر من چنین خوشش آراست","من هرگز به دنیا و وابستگی های آن هیچ گونه توجه ای نداشتم ، اما چهره زیبای تو این دنیا را برای من زیبا و مطلوب جلوه داده است"],[21,"نخفته‌ام ز خیالی که می‌پزد دل من","خمار صد شبه دارم شراب‌خانه کجاست؟","به سبب وجود خیالات فراوانی که دل من آرزو به وجود می‌آورد، نتوانسته‌­ام بخوابم؛ گرفتار خمار وحشتناکی به اندازه صد شب هستم، شراب­خانه کجاست؟ تا این خمار را اندکی فرو بنشانم(خمار: سردردی که پس از خوردن شراب پدیدار می­گردد و با نوشیدن جامی دیگر برطرف می‌گردد)"],[21,"چنین که صومعه آلوده شد ز خون دلم","گرم به باده بشویید، حق به دست شماست","از ریاکاری و تظاهر اهل صومعه چنان آزرده شدم که اشک خونین من فضای صومعه را آلوده ساخته است، اگر برای پاک کردن و تطهیر من مرا با شراب بشویید کار درستی انجام داده‌اید(حق به دست شماست: ایهام، ؛ ۱. حق با شماست، ۲. شرابی که در دستان شماست و مرا با آن خواهید شست، خود حق است؛ چرا که این باده دقیقا نقطه مقابل ریاکاری و تظاهر است. ۳. تنی که در دستان شماست و قصد شستنش را دارید خود حق است و حق با اوست)"],[21,"از آن به دیر مغانم عزیز می‌دارند","که آتشی که نمیرد، همیشه در دل ماست","آتش و حرارتی در دل من است که هرگز خاموش نخواهد شد؛ از همین رو در دیر مغان مرا عزیز و محترم به حساب می‌آورند(دیر مغان: آتشکده و عبادتگاه زرتشتیان؛ مترادف با کوی مغان، سرای مغان، در شعر حافظ دیر مغان نقطه مقابل ریا و تظاهر است)"],[21,"چه ساز بود که در پرده می‌زد آن مطرب","که رفت عمر و هنوزم دماغ پر ز هواست","مطرب چه ساز و نغمه ای در پشت پرده می‌نواخت (مطرب با چه سازی چنین نغمه و آهنگ به هنجاری میزد ) که با وجود اینکه عمر و سالیان زیادی از آن گذشت ، هنوز اندیشه من پر از آن آرزوست(در پرده زدن: ایهام دارد؛ ۱. پشت پرده نواختن، در مجالس معمولا پرده­ای کشیده می‌شد تا نوازندگان در پشت آن می‌‌نشستند تا اهل مجلس راحت‌تر باشند. ۲. بر طبق اصول و هنجار نواختن)"],[21,"ندای عشق تو دیشب در اندرون دادند","فضای سینه حافظ هنوز پر ز صداست","دیشب بانگی از سر عشق تو در درون من طنین‌انداز شد؛ هنوز بازتاب و انعکاس آن فریاد در تمام فضای سینه‌ی من لبریز است(دیشب: مترادف با دوش و مراد و منظور روز ازل و ابتدای خلقت است)(حافظ تصویر شگفتی خلق کرده است؛ گویی فضای سینه‌اش همچون گنبد یا هر چیز دیگری است که فریاد عشقی که خداوند در درون آن طنین‌انداز کرده است،تمام آن فضا را در برگرفته است و بازتاب و پژواک آن هنوز ادامه دارد)"],[22,"خیال روی تو در هر طریق همره ماست","نسیم موی تو، پیوند جان آگه ماست","تصویر چهره تو در هر راه و مسیری همراه من است و یاد و عطر گیسوانت با جان آگاه و بیدار من پیوندی ناگسستنی دارد."],[22,"به رغم مدّعیانی که منع عشق کنند","جمال چهره تو، حجّت موجّه ماست","در برابر کسانی که ما را از عشق ورزیدن بازمی‌دارند و عشقمان را نادرست می‌دانند، زیبایی چهره تو بهترین دلیل و برهان ما برای عاشقی است."],[22,"ببین که سیب زنخدان تو چه می‌گوید","هزار یوسف مصری، فتاده در چه ماست","به زیبایی چانه تو نگاه کن و ببین چه غوغایی برپا کرده است؛ گویی هزاران یوسف زیبارو در چاه عشق ما گرفتار شده‌اند."],[22,"اگر به زلف دراز تو، دست ما نرسد","گناه بخت پریشان و دست کوته ماست","اگر دست ما به گیسوان بلند تو نمی‌رسد و نمی‌توانیم به وصالت دست یابیم، تقصیر از بخت آشفته و ناتوانی و بی‌نصیبی خود ماست."],[22,"به حاجب در خلوت‌سرای خاص بگو","فلان ز گوشه‌نشینان خاک درگه ماست","به نگهبان درگاه خلوت‌سرای اختصاصی معشوق بگو که فلانی از عاشقان و خدمتگزاران قدیمی این آستان است؛ او از کسانی است که در گوشه‌ای، بر خاک آستان تو نشسته و چشم‌انتظار دیدار توست."],[22,"به صورت از نظر ما اگر چه محجوب است","همیشه در نظر خاطر مرفّه ماست","اگرچه معشوق از نظر ظاهری و چشم سر ما پنهان است، اما در ذهن و دل آرام و آسوده ما همیشه حضور دارد و لحظه‌ای از یادمان نمی‌رود."],[22,"اگر به سالی حافظ دری زند، بگشای","که سال‌هاست که مشتاق روی چون مه ماست","اگر حافظ پس از سال‌ها انتظار، روزی بر درگاه تو آمد و در زد، در را به رویش باز کن؛ زیرا سال‌های طولانی است که آرزومند دیدار چهره زیبای توست."],[23,"مطلب طاعت و پیمان و صلاح از من مست","که به پیمانه‌کشی شهره شدم روز الست","«از من انتظار نداشته باش مثل آدم‌های ظاهرا زاهد و مطیع رفتار کنم؛ من از همان ابتدا دل به عشق داده‌ام و راه خودم را رفته‌ام.»"],[23,"من همان دم که وضو ساختم از چشمه عشق","چار تکبیر زدم یکسره بر هرچه که هست","زمانی که برای وصال خود را با عشق اماده و پاکیزه کردم؛ از هر چیزی غیر از عشق دست کشیدم و پاک شدم"],[23,"می بده تا دهمت آگهی از سرّ قضا","که به روی که شدم عاشق و از بوی که مست","به من می شراب بده تا تو را از راز تقدیر آگاه کنم که به خاطر چهره چه کسی عاشق شدم و از بوی چه کسی مست گشتم."],[23,"کمر کوه کم است از کمر مور اینجا","ناامید از در رحمت مشو ای باده‌پرست","در این بیت، شاعر به مقایسه کمر کوه و کمر مور پرداخته و می‌گوید که در اینجا، ناامیدی و یأس از رحمت خداوند به اندازه‌ای است که برای کسی که به باده‌پرستی مشغول است، کم است. به عبارت دیگر، او به باده‌پرست توصیه می‌کند که از ناامیدی دور باشد و به رحمت خدا امید داشته باشد، حتی اگر مشکلات بزرگی مانند کوه وجود داشته باشد."],[23,"بجز آن نرگس مستانه که چشمش مرساد","زیر این طارم فیروزه کسی خوش ننشست","تنها آن نرگس مستانه، که چشمانش مرا می‌بیند، زیر این طاق فیروزه‌ای کسی جز او خوشحال نمی‌شود."],[23,"جان فدای دهنش باد که در باغ نظر","چمن آرای جهان، خوشتر از این غنچه نبست","جان من فدای لب او باد، چرا که در باغ زیبایی‌های دنیا، گلی زیباتر از این غنچه وجود ندارد."],[23,"حافظ از دولت عشق تو سلیمانی شد","یعنی از وصل تواش نیست بجز باد به دست","حافظ به این نکته اشاره دارد که عشق تو باعث شده است که او مانند سلیمان، پادشاه بزرگ، قدرتی بیابد؛ اما این قدرت و خوشبختی او تنها در سایه وصالت است و اگر تو به او نرسی، چیزی جز باد (هیچ چیزی) در دست ندارد."],[24,"شکفته شد گل حمرا و گشت بلبل مست","صلای سرخوشی، ای صوفیان باده پرست","گل سرخ شکفته شده و بلبل در حال سرودن و خواندن طرب‌آلود است. ای صوفیانی که به شراب عشق و خوش‌گذرانی مشغولید، به این حال توجه کنید."],[24,"اساس توبه که در محکمی چو سنگ نمود","ببین که جام زجاجی چه طرفه‌اش بشکست","بنیاد توبه که مانند سنگی محکم است، ببین که چگونه یک لیوان شیشه‌ای به راحتی آن‌را می‌شکند."],[24,"بیار باده که در بارگاه استغنا","چه پاسبان و چه سلطان، چه هوشیار و چه مست","باده بیاور که در محفل بی‌نیازی، چه نگهبان و چه پادشاه، چه هوشیار و چه باده‌نوش همه یکی هستند."],[24,"از این رباط دو در، چون ضرورت است رحیل","رواق و طاق معیشت، چه سربلند و چه پست","در این کاروان‌سرای دو در دنیا (مرگ و تولد) وقتی که همه موقتی و گذرا هستند چه دارا و چه بی‌چیز باشی."],[24,"مقام عیش میسر نمی‌شود بی‌رنج","بلی به حکم بلا بسته‌اند عهد الست","رسیدن به خوشی و کامروایی، بدون تحمل رنج و زحمت، ممکن نیست. بلا و سختی را از روز الست در تقدیر نهاده‌اند."],[24,"به هست و نیست مرنجان ضمیر و خوش می‌باش","که نیستی‌ست سرانجام هر کمال که هست","دل را در غم هست و نیست مرنجان و غمگین مشو‌، به جای این، سعی کن خوشحال باشی، زیرا در نهایت هر چیزی که به کمال می‌رسد، روزی نابود خواهد شد."],[24,"شکوه آصفی و اسب باد و منطق طیر","به باد رفت و از او خواجه هیچ طرف نبست","شکوه و عظمت شاهی آصفی و سوار شدن بر باد و دانایی زبان پرندگان همه بر باد رفت، و خواجه از آن سودی نکرد."],[24,"به بال و پر مرو از ره که تیر پرتابی","هوا گرفت زمانی، ولی به خاک نشست","همچون تیر پرتابی پرشتاب مباش و کمی آرام‌تر باش که تیر نیز، زمانی در اوج هوا می‌رود ولی در نهایت بر خاک می‌نشیند."],[24,"زبان کلک تو حافظ چه شکر آن گوید","که گفته سخنت می‌برند دست به دست","ای حافظ، قلم تو چطور می‌تواند شکر این نعمت را بگوید که شعرت را دست به‌دست به همه‌جا می‌برند."],[25,"زلف‌آشفته و خوی‌کرده و خندان‌لب و مست","پیرهن‌چاک و غزل‌خوان و صراحی در دست","دختر زیبا و سرخوشی با مویی به هم ریخته و چهره‌ای شاداب، لبخندی بر لب و حالتی مست، با پیراهنی که پاره است و در حال خواندن غزل، در دستش جامی دارد."],[25,"نرگسش عربده‌جوی و لبش افسوس‌کنان","نیم شب، دوش به بالین من آمد، بنشست","با چشمانی غضبناک و لب گزیدنی از روی اندوه و غم که عاشق وخواب ای وای بر تو"],[25,"سر فرا گوش من آورد به آواز حزین","گفت: ای عاشق دیرینه من، خوابت هست؟","او به آرامی سرش را نزدیک گوش من آورد و با صدای اندوهگین گفت: ای عاشق قدیمی من، آیا خواب هستی؟"],[25,"عاشقی را که چنین باده شبگیر دهند","کافر عشق بود گر نشود باده پرست","عاشقی که در شب به او چنین می‌نوشانند، اگر باده‌پرست نشود، بی‌ایمان به عشق است."],[25,"برو ای زاهد و بر دردکشان خرده مگیر","که ندادند جز این تحفه به ما روز الست","ای زاهد، برو و به دینداران و شراب‌نوشان عیب نزن، چرا که در روز پیمان نخست (روز الست)، جز این هدیه (شراب) به ما داده نشد."],[25,"آن چه او ریخت به پیمانه ما نوشیدیم","اگر از خمر بهشت است وگر باده مست","ما هر چه را که او به پیمانه ما ریخت نوشیدیم، حالا چه اگر این نوشیدنی از شراب بهشتی باشد و چه اگر از باده‌های مست‌کننده."],[25,"خنده جام می و زلف گره‌گیر نگار","ای بسا توبه که چون توبه حافظ بشکست","خنده می (شراب) و موهای درهم‌ریخته معشوق باعث می‌شود انسان بارها و بارها به پیمان و نذرهای خود خیانت کند، درست مانند حافظ که یک‌بار توبه کرده و آن را شکسته است."],[26,"در دیر مغان آمد، یارم قدحی در دست","مست از می و میخواران از نرگس مستش مست","در ميخانه، معشوق من با جامی در دست به سراغم آمد، او از شراب مست بود و باقی می‌نوشان از چشم زیبای او مست بودند"],[26,"در نعل سمند او شکل مه نو پیدا","وز قد بلند او بالای صنوبر، پست","ماه به زیر نعل اسب او بود چ از قد بلند او، درخت صنوبر کوتاه‌تر به نظر می‌رسید"],[26,"آخر به چه گویم هست از خود خبرم، چون نیست","وز بهر چه گویم نیست با وی نظرم، چون هست","چگونه می‌توانم بگویم که از حال خود خبر دارم ؟! وقتی که خبر ندارم ، چرا بگویم که معشوق رابطه‌ای ندارم ؟! درصورتی که دارم"],[26,"شمع دل دمسازم، بنشست چو او برخاست","و افغان ز نظربازان، برخاست چو او بنشست",": دل من مانند شمعی است که وقتی او نشسته،روشن است و وقتی او بلند می‌شود، من نیز خاموش می شوم.صدای فریاد و فغان نظربازان بلند است وقتی او می نشیند در کنارشان،"],[26,"گر غالیه خوش بو شد، در گیسوی او پیچید","ور وسمه کمانکش گشت، در ابروی او پیوست","اگر مشک خوش بو است به این دلیل است که در گیسوی معشوق رفته است و اگر گیاه وسمه برای آرایش ابرو استفاده میشود به این دلیل است که بر ابروی معشوق برخورد کرد"],[26,"بازآی که بازآید عمر شده حافظ","هرچند که ناید باز، تیری که بشد از شست","برگرد تا عمر تلف شده و از دست رفته حافظ برگردد هرچند میدانم تیری که رها بشود دیگر باز نمی‌گردد"],[27,"به جان خواجه و حق قدیم و عهد درست","که مونس دم صبحم، دعای دولت توست","به جان تو و به دوستی دیرینه ما قسم که هر صبح‌گاه برای نیکبختی تو دعا می‌کنم."],[27,"سرشک من که ز طوفان نوح دست برد","ز لوح سینه نیارست نقش مهر تو شست","اشک‌های من که از طوفان نوح پیشی گرفت نیز نتوانسته‌است که یاد و مهر تو را از سینه‌ام بشوید."],[27,"بکن معامله‌ای، وین دل شکسته بخر","که با شکستگی ارزد به صد هزار درست","بیا و دل شکسته من را بخر که ارزش آن از صدهزار دل سالم و بی‌درد بیشتر است."],[27,"زبان مور به آصف دراز گشت و رواست","که خواجه خاتم جم، یاوه کرد و باز نجست","مورچه‌ای به آصف طعنه زد و بجاست که اگر یار، انگشتری جم را گم کرد و نیافت. (شاعر در اینجا خود را به موری تشبیه‌کرده که به سلیمان اعتراض کرد، و گم‌شدن انگشتر شاهی نیز اشاره به‌داستان سلیمان است.)"],[27,"دلا طمع مبر از لطف بی‌نهایت دوست","چو لاف عشق زدی، سر بباز، چابک و چست","ای دل غمگین من، از لطف دوست ناامید مشو؛ وقتی که لاف عشق زدی‌، به‌آسانی سر بباز."],[27,"به صدق کوش، که خورشید زاید از نفست","که از دروغ سیه‌روی گشت صبح نخست","صداقت و یک‌رنگی را پیشه‌کن که از راستگویی تو‌، خورشید طلوع خواهد کرد؛ صبح اول از دروغ بود که بی‌آبرو شد."],[27,"شدم ز دست تو شیدای کوه و دشت و هنوز","نمی‌کنی به ترحم، نطاق سلسله سست","از عشق تو‌، دیوانه شده و سر به‌ بیابان نهاده‌ام اما تو هنوز رحم نمی‌کنی و زنجیری را که بر من نهاده‌ای‌، رها نمی‌کنی. (نطاق: یعنی قفل‌بند‌، سلسله‌: یعنی زنجیر و در شعر کنایه‌است از زلف بافته معشوق)"],[27,"مرنج حافظ و از دلبر‌ان حفاظ مجوی","گناه باغ چه باشد چو این گیاه نرست","ای حافظ از دلبران توقع مهربانی نداشته‌باش؛ گناه باغ چیست وقتی‌که این گیاه نروید. (یا گیاه مهربانی دلبران از اول وجود نداشته‌است)"],[28,"ما را ز خیال تو چه پروای شراب است؟","خم گو سر خود گیر، که خمخانه خراب است","ما با خیال تو مستیم و به‌شراب نیاز نداریم به خم بگو که پی کار خود گیر و برو که خمخانه تو بی‌رونق شد."],[28,"گر خمر بهشت است بریزید که بی دوست","هر شربت عذبم که دهی، عین عذاب است","حتی شراب بهشتی را نیز میاورید که بی محبوبم بهترین شراب هم لذتی ندارد. (عذب‌: گوارا)"],[28,"افسوس که شد دلبر و در دیده گریان","تحریر خیال خط او نقش بر آب است","حیف که یارم رفت و خیال دیدن او بیهوده است."],[28,"بیدار شو ای دیده که ایمن نتوان بود","زین سیل دمادم که در این منزل خواب است","منظور از دیده: چشم. ای چشم من از خواب بیدار شو و مراد از سیل دمادم، اشک ریختن بسیار است.منزل خواب: چشم. ای چشم من بیدار شو که از اینهمه اشک ریزی امانی نیست"],[28,"معشوق عیان می‌گذرد بر تو، ولیکن","اغیار همی‌بیند از آن بسته نقاب است","یار بر تو آشکارا می‌گذرد اما اغیار را دیده است و رخ نمی‌نماید."],[28,"گل بر رخ رنگین تو تا لطف عرق دید","در آتش شوق از غم دل، غرق گلاب است","وقتی‌که گل‌، زیبایی شبنم روی تو را دید از عشق تو دلش پر آتش گشت و غرق گلاب شد."],[28,"سبز است در و دشت بیا تا نگذاریم","دست از سر آبی که جهان جمله سراب است","تا بهار و خرمی است بیا کنار جویبار را از دست ندهیم که دنیا خیال و سرابی بیش نیست."],[28,"در کنج دماغم مطلب جای نصیحت","کـ‌این گوشه پر از زمزمه چنگ و رباب است","در مغز من جایی برای پند وجود ندارد چون پر از نغمه شاد چنگ و رباب و آهنگ و ترانه است."],[28,"حافظ چه شد ار عاشق و رند است و نظرباز","بس طور عجب لازم ایام شباب است","چه ایرادی بر رندی و عاشقی و نظربازی حافظ هست؟ جوانی‌، این حالات را با خود دارد."],[29,"زلفت هزار دل به یکی تار مو ببست","راه هزار چاره‌گر از چارسو ببست","زلف تو به یک تار موی خود، هزار دل را به خود بسته و راه‌های بسیاری برای درمان درد عشق را مسدود کرده است."],[29,"تا عاشقان به بوی نسیمش دهند جان","بگشود نافه‌ایّ و در آرزو ببست","عاشقان تا به بوی خوش نسیم او جان تازه‌ای دریافت کنند، نافه‌ای (لختی از مو) به شوق او گشوده و دروازه آرزو را بسته‌اند."],[29,"شیدا از آن شدم که نگارم چو ماه نو","ابرو نمود و جلوه‌گری کرد و رو ببست","شیدا به این خاطر دچار عشق و شیفتگی شدم که معشوقم با ابرویی مانند ماه نو خود را نشان داد و با زیبایی‌اش حجاب صورتش را بست."],[29,"ساقی به چند رنگ، می اندر پیاله ریخت","این نقش‌ها نگر که چه خوش در کدو ببست","ساقی با رنگ‌های مختلف، شراب را در پیاله ریخت. به این نقوش دقت کن که چقدر زیبا در کدو (کدو به عنوان ظرف) جا گرفته است."],[29,"یا رب چه غمزه کرد صراحی که خون خم","با نعره‌های قلقلش اندر گلو ببست","پروردگارا این چه طرز ناز و کرشمه است که جام می( این چنین خشن)با صدای بلند قلقله و بستن گلوی من ، انجام میدهد !"],[29,"مطرب چه پرده ساخت که در پرده سماع","بر اهل وجد و حال، در های‌وهو ببست","مطرب چه قطعه‌ای نواخته که در هنگام سماع، در میان دلدادگان و عاشقان، سر و صدا و هیاهو را به سکوت تبدیل کرد."],[29,"حافظ! هر آن که عشق نورزید و وصل خواست","احرام طوف کعبه دل، بی‌وضو ببست","حافظ می‌گوید هر کسی که عشق نورزید و خواستار وصال (یکی شدن با محبوب) شد، بدون آمادگی روحی و دل، مانند کسی است که در حال طواف کعبه (مظهر عشق) به‌طور بی‌وضو (بدون پاکی) وارد شده است."],[30,"آن شب قدری که گویند اهل خلوت امشب است","یا رب این تأثیر دولت در کدامین کوکب است؟","آن شب قدر که اهل خلوت و عبادت از آن می‌گویند امشب است، خدایا این سعادت از تاثیر کدام کوکب و ستاره است؟"],[30,"تا به گیسوی تو دست ناسزایان کم رسد","هر دلی از حلقه‌ای در ذکر یارب یارب است","برای آنکه دست نالایقان به وصال گیسوی تو نرسد، هر دلی در این شب و هرکس در هر محفل در ذکر یارب یارب است."],[30,"کشته چاه زنخدان توام کز هر طرف","صد هزارش گردن جان زیر طوق غبغب است","کشته مرده زیبایی چانه و چاه زنخندان تو هستم که در گرد آن چاه و غبغب، هزاران عاشق اسیر گشته‌اند."],[30,"شهسوار من که مه آیینه دار روی اوست","تاج خورشید بلندش خاک نعل مرکب است","شهسوار و ماه یگانه من که غلام اوست تاج خورشید آسمان، خاک مرکب و اسب اوست."],[30,"عکس خوی بر عارضش بین کآفتاب گرم رو","در هوای آن عرق تا هست هر روزش تب است","ببین قطره‌های عرق و شبنم که بر روی اوست چه زیباست که آفتاب در هوای چشیدن آن گلاب‌، تشنه است و هر روز تب می‌کند."],[30,"من نخواهم کرد ترک لعل یار و جام می","زاهدان معذور داریدم که اینم مذهب است","من هرگز بوسه لب یار و جام می و مستی را رها نخواهم کرد، ای زاهد مرا معذور بدار که مذهب و کیش من همین است."],[30,"اندر آن ساعت که بر پشت صبا بندند زین","با سلیمان چون برانم من که مورم مرکب است","در آن ساعت و دم که بر پشت صبا و نسیم سوار می‌شوند چطور می‌توانم همراه سلیمان بتازم وقتی که موری مرکب من است؟"],[30,"آن که ناوک بر دل من زیر چشمی می‌زند","قوت جان حافظش در خنده زیر لب است","آنکه تیر و ناوک غمزه بر دل من پنهانی می‌زند، روزی و غذای جان حافظ را نیز با خنده‌های پنهانی می‌دهد."],[30,"آب حیوانش ز منقار بلاغت می‌چکد","زاغ کلک من بنامیزد چه عالی مشرب است","آب زندگانی و حیات جاودان از منقار زاغ سیه قلم بلاغت من می‌چکد، چشم بد از او دور بادا! چه عالی‌نظر است."],[31,"خدا چو صورت ابروی دلگشای تو بست","گشاد کار من اندر کرشمه‌های تو بست","آن روز که خدا ابروی زیبای تو را نقش زد و آفرید، در همان ازل، گشودن گره کار من را در کرشمه‌ها و نازهای تو نهاد."],[31,"مرا و سرو چمن را به خاک راه نشاند","زمانه تا قصب نرگس قبای تو بست","قصب نرگس قبا‌: لباس سپید و لطیف؛ کنایه است از لطافت و روشنی تن محبوب."],[31,"ز کار ما و دل غنچه صد گره بگشود","نسیم گل چو دل اندر پی هوای تو بست","از کار ما و دل بسته و غمگین غنچه، صد شادی آورد آنگاه که نسیم خوش‌عطر بهاری عاشق تو شد."],[31,"مرا به بند تو دوران چرخ راضی کرد","ولی چه سود که سررشته در رضای تو بست","دست قضا مرا به بند تو راضی کرد اما افسوس که رهایی مرا نیز به رضای تو موکول کرد!"],[31,"چو نافه بر دل مسکین من گره مفکن","که عهد با سر زلف گره‌گشای تو بست","با گره زلفت که همچون نافه مشکین‌ است کار را بر دل مسکین من سخت نکن زیرا سر زلفت به دلم قول داده است که گره‌گشا باشد. (منظور از سر زلف گره‌گشا، انتهای زلف بافته شده است که باز است. گره افکندن کنایه است از سخت‌کردن کاری.)"],[31,"تو خود وصال دگر بودی ای نسیم وصال","خطا نگر که دل امید در وفای تو بست","ای نسیم خنک و دل‌انگیز شمال! تو لذت وصال را به من هدیه کردی، مرا بنگر که به وفای که امید بستم!"],[31,"ز دست جور تو گفتم ز شهر خواهم رفت","به خنده گفت که حافظ برو، که پای تو بست؟","از دست ستم و بی‌رحمی تو گفتم تو را ترک خواهم گفت و از این شهر خواهم رفت؛ به خنده به من گفت: برو حافظ، راه باز است! چه‌کسی پای تو را بسته‌است؟"],[32,"خلوت گزیده را به تماشا چه حاجت است","چون کوی دوست هست به صحرا چه حاجت است","کسی که خلوت را گزیده و انتخاب کرده است چه نیازی به گردش و تماشا دارد؟ وقتی که او در کوی دوست اقامت دارد چه نیاز دارد به صحرا و گلزار برود؟"],[32,"جانا به حاجتی که تو را هست با خدا","کآخر دمی بپرس که ما را چه حاجت است","ای عزیز‌، تو را قسم می‌دهم به آن نیاز که به خدا می‌بری یک بار از ما بپرس که ما چه نیاز داریم."],[32,"ای پادشاه حسن خدا را بسوختیم","آخر سؤال کن که گدا را چه حاجت است","ای پادشاه زیبایی، ما به خاطر عشق و محبت به تو جان خود را فدای تو کرده‌ایم، حالا خواهش می‌کنیم که از ما بپرسی به عنوان گدا چه نیازی داریم."],[32,"ارباب حاجتیم و زبان سؤال نیست","در حضرت کریم، تمنا چه حاجت است","صاحب‌نیاز هستیم و زبان و توان گفتن نیاز خود را نداریم در درگاه بخشندگان چه نیازی به خواهش و درخواست هست؟"],[32,"محتاج قصه نیست گرت قصد خون ماست","چون رخت از آن توست، به یغما چه حاجت است","اگر هدف تو از عشق و محبت به ما، کشتن و آسیب رساندن به ماست، نیازی به داستان‌سرایی و توضیح نیست؛ چون زیبایی تو از آن ماست و برای غارت ما به حرف زدن نیاز نیست."],[32,"جام جهان نماست ضمیر منیر دوست","اظهار احتیاج، خود آن جا چه حاجت است","وجود من که مانند یک جام شفاف و روشنی‌بخش است، در واقع تصویر و نشان دهنده دوست (محبوب) من است. بنابراین، نیاز به بیان احتیاج و نیازی به توضیح آن در اینجا وجود ندارد."],[32,"آن شد که بار منت ملّاح بردمی","گوهر چو دست داد به دریا چه حاجت است","آن روزگار رفت و گذشت که منت کشتی‌بان را می‌کشیدم، حال که گوهر را به دست آورده‌ام به (سفر به) دریا نیازی ندارم.(آن شد: آن زمان گذشت.)"],[32,"ای مدعی برو که مرا با تو کار نیست","احباب حاضرند، به اعدا چه حاجت است","ای کسی که مدعی هستی، برو که من با تو هیچ کاری ندارم. دوستان و عزیزان من حاضرند، پس به دشمنان چه نیازی است؟"],[32,"ای عاشق گدا چو لب روح‌بخش یار","می‌داندت وظیفه، تقاضا چه حاجت است","ای عاشق فقیری که لبان شیرین و زندگی‌بخش معشوق را می‌دانی، با توجه به این آگاهی، دیگر نیازی به درخواست و تقاضا نیست."],[32,"حافظ! تو ختم کن که هنر خود عیان شود","با مدعی نزاع و محاکا چه حاجت است","حافظ! تو خود را بساز و نشان بده که استعداد و هنر تو معلوم شود، نیازی به بحث و جدل با مدعیان دیگر نیست."],[33,"رواق منظر چشم من آشیانه توست","کرم نما و فرود آ که خانه، خانه توست","ایوان خانه چشم من برای تو آماده پذیرایی است ای دلبرم؛ بیا و مهمان من باش که این خانه، خانه توست. (رواق‌: یعنی بخش ورودی یک سرا و خانه که گاهی ایوان نیز گفته می‌شود)"],[33,"به لطف خال و خط از عارفان ربودی دل","لطیفه‌های عجب زیر دام و دانه توست","به لطف و زیبایی خط و خال خود، عارفان پاکدامن را عاشق خود کردی؛ چه لطیفه‌هایی در زیر دام زلف و دانه خال تو که هست."],[33,"دلت به وصل گل ای بلبل صبا خوش باد","که در چمن همه گلبانگ عاشقانه توست","ای بلبل خوش‌خوان بهاری، برای تو در کنار گل آرزوی شادی می‌نمایم زیرا با آواز عاشقانه خود چمن و بوستان را زیباتر کرده‌ای."],[33,"علاج ضعف دل ما به لب حوالت کن","که این مفرّح یاقوت در خزانه توست","مفرح یعنی نوشیدنی‌یی که از گلاب و قند و زعفران و ... برای شادی‌ و علاج ضعف دل می‌ساخته‌اند. اگر در آن یاقوت انداخته می‌شد «مفرح یاقوت‌» و اگر زر «مفرح زر» و ...‌؛ قدما بر این باور بودند که گوهر‌ آن سنگ‌های ارزشمند در شربت اثر می‌کند."],[33,"به تن مقصرم از دولت ملازمتت","ولی خلاصه جان، خاک آستانه توست","تن من در خدمت تو کوتاهی کرده است (دور از تو هستم) ولی این را بدان که دل و جان من، خاک آستانه توست."],[33,"من آن نیم که دهم نقد دل به هر شوخی","در خزانه، به مهر تو و نشانه توست","دل را به هر شوخ و شیرینی نمی‌سپارم گنجی که از عشق تو در سینه دارم به‌همان مهر باقی است."],[33,"تو خود چه لعبتی ای شهسوار شیرین کار","که توسنی چو فلک، رام تازیانه توست","عجب زیبا بتی هستی تو ای تک‌سوار ماهر که اسب سرکش فلک را رام تازیانه خود کرده‌ای."],[33,"چه جای من، که بلغزد سپهر شعبده‌باز","از این حیل که در انبانه بهانه توست","من که چیزی نیستم تو حتی روزگار پرفن و شعبده‌باز را نیز با بهانه‌‌های بی‌پایانت دست به سر ‌می‌کنی. (انبانه یعنی کیسه چرمی بزرگ که بر دوش حمل می‌کنند، در اینجا بطور خاص مقصود کیسه همراه شعبده‌بازان و تردستان است. لغزیدن کنایه است از فریب خوردن)"],[33,"سرود مجلست اکنون فلک به رقص آرد","که شعر حافظ شیرین سخن ترانه توست","آسمان و آسمانیان به‌رقص و پایکوبی می‌افتند وقتی‌که غزل حافظ در مجلس تو به‌سرود خوانده‌شود."],[34,"برو به کار خود ای واعظ این چه فریادست؟","مرا فتاد دل از ره، تو را چه افتادست؟","ای واعظ، برو به کار خودت، این چه فریادی است که برای من می‌زنی؟ دلم دچار عاشق شدن شده، تو را چه غم و دردی گرفته است؟"],[34,"میان او که خدا آفریده است از هیچ","دقیقه‌ای‌ست که هیچ آفریده نگشادست","بین او که خدا آن را از هیچ آفریده، هیچ نکته‌ای وجود ندارد که هیچ موجودی نتوانسته باشد آن را بیان کند."],[34,"به کام تا نرساند مرا لبش، چون نای","نصیحت همه عالم به گوش من بادست","تا زمانی که لب معشوق مرا به کام نرساند، تمام نصایح و پندهای دنیا مانند صدایی بی‌فایده به گوش من می‌رسد."],[34,"گدای کوی تو از هشت خلد، مستغنی‌ست","اسیر عشق تو از هر دو عالم آزادست","گدای کوی تو از هشت بهشت بی‌نیاز است و اسیر عشق تو از هر دو جهان آزاد شده است."],[34,"اگر چه مستی عشقم خراب کرد ولی","اساس هستی من زآن خراب، آبادست","هرچند که عشق باعث نابودی و ویرانی من شده است، اما در عین حال همان ویرانی، پایه و اساس وجودم را بازسازی کرده و به زندگی‌ام معنی بخشیده است."],[34,"دلا منال ز بیداد و جور یار که یار","تو را نصیب همین کرد و این از آن دادست","ای دل، از ستم و بی‌عدالتی یار غمگین نیا؛ زیرا او با این رفتار فقط به تو همان چیزی را داد که سزاوارش بودی و این به خاطر آن چیزی است که خودت به آن دچار شده‌ای."],[34,"برو فسانه مخوان و فسون مدم حافظ","کز این فسانه و افسون مرا بسی یادست","حافظ می‌گوید که ای دوست، چیزهای خیالی و جادو را برای من نگویید، زیرا من از این داستان‌ها و سحرها بسیار خاطره دارم."],[35,"تا سر زلف تو در دست نسیم افتادست","دل سودازده از غصه دو نیم افتادست","وقتی نسیم به زلف آشفته تو رسید، دل بیمار و پرغصه من هم به دو نیم تقسیم شد."],[35,"چشم جادوی تو خود عین سواد سحر است","لیکن این هست که این نسخه سقیم افتادست","چشمان جادویی تو خود به معنای واقعی مانند سیاهی سحر است، اما در واقع این وضعیت که برای من پیش آمده، درست نیست و حال خوبی ندارم."],[35,"در خم زلف تو آن خال سیه دانی چیست؟","نقطه دوده که در حلقه جیم افتادست","در پیچ زلف تو، آن خال سیاه چه معنایی دارد؟ فقط یک نقطه دوده است که در شکل حرف «ج» افتاده است."],[35,"زلف مشکین تو در گلشن فردوس عذار","چیست؟ طاووس که در باغ نعیم افتادست","زلف‌های سیاه تو در باغ بهشت چه خصوصیتی دارد؟ مانند طاووسی است که در باغ نعمت افتاده و زیبا و دل‌فریب است."],[35,"دل من در هوس روی تو ای مونس جان","خاک راهیست که در دست نسیم افتادست","دل من به شدت دل‌باخته جمال توست، ای همدم جان. دل من مانند خاکی است که در باد به حرکت درآمده و در مسیر حضور تو قرار دارد."],[35,"همچو گرد این تن خاکی نتواند برخاست","از سر کوی تو زان رو که عظیم افتادست","این تن خاکی من مانند گردی است که نمی‌تواند از سر کوی تو بلند شود، زیرا بار سنگینی بر دوش دارد و گرفتار عشق توست."],[35,"سایه قدّ تو بر قالبم ای عیسی دم","عکس روحیست که بر عظم رمیم افتادست","سایه قامت تو بر بدن من، ای عیسی، نشان‌دهنده‌ی روحی است که بر جسم فاسد و پوسیده‌ای افتاده است. عیسی به عنوان نماد حیات و روحانیت مطرح شده و به این معناست که وجود تو جان تازه‌ای به بدنی بی‌روح داده است."],[35,"آن که جز کعبه مقامش نبد از یاد لبت","بر در میکده دیدم که مقیم افتادست","کسی که جایگاهش جز کعبه نیست، به یاد لبان تو در در میکده (محل شراب‌خوری) نشسته و مقیم شده است."],[35,"حافظ گمشده را با غمت ای یار عزیز","اتحادیست که در عهد قدیم افتادست","یاد و فکر حافظ، شاعر بزرگ، به خاطر غم تو، ای یار عزیز، به نوعی پیوندی قدیمی ایجاد کرده که از زمان‌های دور باقی مانده است."],[36,"بیا که قصر امل سخت سست‌بنیادست","بیار باده که بنیاد عمر بر بادست","(ساقی) بیا که کاخ آرزوهای ما سست و بی‌بنیاد است؛ باده بریز که عمر ما به‌سرعت باد می‌گذرد."],[36,"غلام همّت آنم که زیر چرخ کبود","ز هر چه رنگ تعلّق پذیرد آزادست","بنده آزادگی و همّت کسی هستم که از هر تعلّق و وابستگی رهاست."],[36,"چه گویمت که به میخانه دوش مست و خراب","سروش عالم غیبم چه مژده‌ها دادست","زبانم نمی‌تواند شرح دهد که دیشب در میخانه و در حال مستی، چه مژده‌هایی از سروش عالم غیب شنیده‌ام."],[36,"که ای بلندنظر شاهباز سدره‌نشین","نشیمن تو نه این کنج محنت‌آبادست","(به من گفت) ای شاهباز بلند‌پرواز! جای تو این ویرانه و محنت‌کده نیست؛ جای تو بر اوج درخت سدره است. (سدره یعنی درخت بهشتی که بالای آسمان هفتم قرار دارد)"],[36,"تو را ز کنگره عرش می‌زنند صفیر","ندانمت که در این دامگه چه افتادست","تو را از عرش والا، دعوت می‌کنند، شان و جای تو آنجاست؛ چرا در این جای پرخطر گرفتار شده‌ای؟"],[36,"نصیحتی کنمت یاد گیر و در عمل آر","که این حدیث، ز پیر طریقتم یادست","پندی ارزشمند را از من بشنو و بدان عمل کن؛ که آن‌را از پیر طریقت آموخته‌ام"],[36,"غم جهان مخور و پند من مبر از یاد","که این لطیفه عشقم ز رهروی یادست","غم دنیا را مخور و این پند را فراموش مکن که این نکته عشق را از رهروی به‌یاد دارم"],[36,"رضا به داده بده وز جبین گره بگشای","که بر من و تو در اختیار نگشادست","به هرچه داری قناعت کن و شاد باش؛ که در اختیار بر ما گشوده نیست."],[36,"مجو درستی عهد از جهان سست‌نهاد","که این عجوز، عروس هزاردامادست","به وفای جهان سست‌بنیاد اعتماد مکن؛ که این پیرزن زشت هزار شوهر است."],[36,"نشان عهد و وفا نیست در تبسّم گل","بنال بلبل بی‌دل که جای فریادست","در لبخند گل نشانی از عهد و وفا نمی‌بینم؛ ای بلبل‌، فغان برآور که جای فریاد و فغان است."],[36,"حسد چه می‌بری ای سست‌نظم بر حافظ؟","قبول خاطر و لطف سخن خدادادست","چت جی پی تی: در این بیت، حافظ به حسودانی که بر او رشک می‌برند، می‌گوید که استعداد شاعری و مقبولیت سخن او، موهبتی الهی است و حسادت بر این نعمت بی‌ثمر است."],[37,"بی مهر رخت روز مرا نور نماندست","وز عمر، مرا جز شب دیجور نماندست","بدون محبت و زیبایی چهره‌ات، روزهایم بی‌نور است و از عمرم جز شب‌های تاریک و غم‌انگیز باقی نمانده است."],[37,"هنگام وداع تو ز بس گریه که کردم","دور از رخ تو، چشم مرا نور نماندست","زمانی که از تو خداحافظی کردم، آنقدر گریه کردم که دیگر نوری در چشمانم باقی نمانده است"],[37,"می‌رفت خیال تو ز چشم من و می‌گفت","هیهات از این گوشه که معمور نماندست","تصور تو از مقابل چشمانم دور می‌شد و به من می‌گفت که ای وای از این چشم که آبادان [به دیدن تو] نمانده است."],[37,"وصل تو اجل را ز سرم دور همی‌داشت","از دولت هجر تو کنون دور نماندست","بخاطر وصال تو، مرگ از ذهنم دور بود، اما حالا که از تو دورم، مرگ از من دور نیست."],[37,"نزدیک شد آن دم که رقیب تو بگوید","دور از رخت این خسته رنجور نماندست","زمانی نزدیک است که بشنوی که این عاشق رنجور و خسته، دیگر زنده نیست."],[37,"صبر است مرا چاره هجران تو لیکن","چون صبر توان کرد که مقدور نماندست؟","صبر تنها راه حل دوری تو برای من است، اما چطور می‌توانم صبر کنم وقتی که صبر من هم به اندازه‌ای نیست که بتواند ادامه پیدا کند؟"],[37,"در هجر تو گر چشم مرا آب روان است","گو خون جگر ریز که معذور نماندست","در غیبت و دوری تو، اگر چشمم مانند چشمه‌ای از آب روان جاری است، باز هم می‌توانم از دل زخم و اندوه خود خون بریزم، زیرا هیچ‌کس نمی‌تواند در برابر این حال من عذری بیاورد."],[37,"حافظ، ز غم از گریه نپرداخت به خنده","ماتم زده را داعیه سور نماندست","حافظ به خاطر غم و اندوهی که دارد، نتوانسته است از گریه به خنده تغییر حال دهد، و برای کسی که در ماتم است، فرصت شادی وجود ندارد."],[38,"باغ مرا چه حاجت سرو و صنوبر است؟","شمشاد خانه‌پرور ما از که کمتر است؟","در باغم چه نیازی به صنوبر و سرو دارم وقتی که شمشاد‌قدی در خانه دارم؟"],[38,"ای نازنین‌پسر، تو چه مذهب گرفته‌ای؟","کت خون ما حلال‌تر از شیر مادر است","ای نازنین‌پسر، تو چه دین داری که ریختن خون ما بر تو، حلال‌ است؟"],[38,"چون نقش غم ز دور ببینی شراب خواه","تشخیص کرده‌ایم و مداوا مقرّر است","وقتی که غم را از دور می‌بینی (پیش از آنکه نزدیک بیاید) شراب بنوش؛ داروی دفع آن‌را چنین تشخیص داده‌ایم."],[38,"از آستان پیر مغان، سر چرا کشیم؟","دولت در آن سرا و گشایش در آن در است","چرا از آستان پیر مغان سر بر تابیم؟ وقتی‌که بخت و گشایش از سرای اوست."],[38,"یک قصّه بیش نیست غم عشق، وین عجب","کز هر زبان که می‌شنوم، نامکرّر است","شگفت‌آور است که قصه غم عشق‌، یکی بیش نیست اما هر بار و هرکس که آن‌را تعریف می‌کند‌، تازه است و تکراری نیست."],[38,"دی وعده داد وصلم و در سر شراب داشت","امروز تا چه گوید و بازش چه در سر است","دیروز در حالت مستی بود و به من وعده‌ی وصال داد. باید دید امروز در چه حالتی چه می‌گوید. (و چه نقشه‌ای دارد)"],[38,"شیراز و آب رکنی و این باد خوش نسیم","عیبش مکن که خال رخ هفت کشور است","از شیراز و چشمه آب رکنی و باد خوشی که می‌وزد عیب نگیر که مانند خال صورت به زیبایی کل جهان افزوده است."],[38,"فرق است از آب خضر که ظلمات جای او است","تا آب ما که منبعش الله اکبر است","آبی که حضرت خضر (ع) از آن نوشید و عمر جاودانه گرفت در سرزمین تاریکی‌ها قرار داشت؛ حال ببین آب حیات ما که از خداوند بزرگ نشأت می‌گیرد چقدر ما را می‌تواند متعال کند."],[38,"ما آبروی فقر و قناعت نمی‌بریم","با پادشه بگوی که روزی مقدّر است","ما مفهوم قناعت و فقر را با تعبیرات مادی ضایع نمی‌کنیم. به پادشاه بگو که خداوند روزی معنوی ما را از پیش تعیین کرده است."],[38,"حافظ چه طرفه شاخ نباتیست کلک تو","کش میوه دلپذیرتر از شهد و شکّر است","ای حافظ قلم تو چه شاخه درخت شگفت‌آور شیرینی است که میوه‌اش (شعر) حتی دلپذیرتر از شهد و شکر است."],[39,"المنّة للّه که در میکده، باز است","زان رو که مرا بر در او، روی نیاز است","خداوند را شکر می‌گوییم که درب میکده گشوده است، چون من با دل‌تنگی و نیاز بر آستان او می‌روم."],[39,"خم‌ها، همه در جوش و خروش‌اند ز مستی","وان می که در آن‌جاست، حقیقت، نه مجاز است","همه خم‌ها در حال جوش و خروش و جنب و جوش‌اند به خاطر مستی‌ای که دارند و اینکه در می‌ای که آن‌جا است، حقیقت وجود دارد و این حالت، فقط خیال و مجاز نیست."],[39,"از وی، همه، مستی و غرور است و تکبّر","وز ما همه بیچارگی و عجز و نیاز است","او (معشوق) پر از مستی، غرور و تکبر است، در حالی که ما (عاشقان) کاملا بیچاره، ناتوان و نیازمند هستیم."],[39,"رازی که بر غیر نگفتیم و نگوییم","با دوست بگوییم که او محرم راز است","رازهایی که ما به دیگران نگفته‌ایم و نخواهیم گفت، باید با دوست خود در میان بگذاریم؛ زیرا او قابل اعتماد و حافظ رازهای ماست."],[39,"شرح شکن زلف خم اندر خم جانان","کوته نتوان کرد که این قصّه، دراز است","توضیح دادن ویژگی‌های زمانه محبوب، مانند حالت زلف او، در فراق و غم عشق ممکن نیست، زیرا این داستان بسیار طولانی و پیچیده است."],[39,"بار دل مجنون و خم طرّه لیلی","رخساره محمود و کف پای ایاز است","بار دل مجنون و پیچ موهای لیلی، چهره محمود و کف پای ایاز را به یاد می‌آورد. این شعر به زیبایی و جذابیت عشق و شگفتی‌هایی که در آن نهفته است، اشاره دارد. در واقع، دل‌تنگی مجنون و زیبایی‌های لیلی با ویژگی‌های محمود و ایاز مقایسه شده است."],[39,"بردوخته‌ام دیده چو باز از همه عالم","تا دیده من بر رخ زیبای تو، باز است","این بیت، شاعر با استفاده از دو معنای متفاوت برای واژه «باز»، معنای عمیقی را آفریده است:۱. باز (پرنده): که نگاهی تیزبین و متمرکز دارد و چشمانش را از غیر شکار (در اینجا غیر معشوق) می‌بندد.۲. باز (گشاده/در حال نگاه کردن): که در مصرع دوم به معنای گشوده ماندن چشم برای تماشای رخ محبوب است.تضاد «دوختن» (بستن) و «باز» (گشودن) در کنار تشبیه به «باز» (پرنده)، یک تصویرسازی کلاسیک و در عین حال دلنشین است که نشان می‌دهد عاشق برای رسیدن به آن یگانه دیدن (دیدار معشوق)، باید چشم بر تمام کثرت‌های عالم ببندد."],[39,"در کعبه کوی تو، هر آن‌کس که بیاید","از قبله ابروی تو در عین نماز است","هر کسی که به کوی تو بیاید، در حقیقت به پیشگاه زیبایی ابروی تو نماز می‌گذارد و او را در کعبه‌ی عشق تو می‌پرستد."],[39,"ای مجلسیان، سوز دل «حافظ» مسکین","از شمع بپرسید که در سوز و گداز است","ای کسانی که در مجلس هستید، دل «حافظ» بیچاره را از شمع بپرسید که او نیز در حال سوختن و دل‌سوزی است."],[40,"اگر چه باده فرح بخش و باد گل‌بیز است","به بانگ چنگ مخور می که محتسب تیز است","هرچند شراب شادی‌آور و نسیم گلابی خوشبوست، اما به صدای چنگ (نوعی ساز) شراب نخور زیرا که محتسب (مأمور کنترل مشروبات) تندخو و سخت‌گیر است."],[40,"صراحی‌ای و حریفی گرت به چنگ افتد","به عقل نوش که ایام فتنه‌ انگیز است","اگر با کسی که در حال نوشیدن است، هم‌مستی کنی و به دستت بیفتد، بهتر است که با عقل و هوش رفتار کنی، زیرا روزگار پر از فتنه و آشوب است."],[40,"در آستین مرقع پیاله پنهان کن","که همچو چشم صراحی، زمانه خونریز است","پیاله‌ات را در آستین خود پنهان کن، زیرا زمانه مانند چشمی در صراحی، خون‌ریز و خطرناک است."],[40,"به آب دیده بشوییم خرقه‌ها از می","که موسم ورع و روزگار پرهیز است","با اشک‌هایمان لباس‌های زهد را از شراب بشوییم، زیرا اکنون زمان پرهیزکاری و اجتناب از گناه است."],[40,"مجوی عیش خوش از دور باژگون سپهر","که صاف این سر خم جمله دردی آمیز است","{استاد محمدزاده} در زیر آسمان واژگون به دنبال خوشی نباش زیرا حتی شراب گوارا هم طعم شراب ناخالص میدهد"],[40,"سپهر بر شده پرویزنی‌ست خون افشان","که ریزه‌اش سر کسری و تاج پرویز است","آسمان با شرایطی دشوار و تاریک بر ما حکم‌فرماست و این آسمان (سپهر) به اندازه‌ای پر از خون و درگیری است که موی ریز از سر کسری (پادشاه پیشین ایران) و تاج پرویز (پادشاه معروف ایرانی) به آن افتاده است."],[40,"عراق و فارس گرفتی به شعر خوش حافظ","بیا که نوبت بغداد و وقت تبریز است","ای حافظ! تو با اشعار زیبایت عراق و فارس را تحت تأثیر قرار داده‌ای، بیایید که اکنون وقت آن است که به بغداد و تبریز بپردازیم."],[41,"حال دل با تو گفتنم، هوس است","خبر دل شنفتنم، هوس است","حرف زدن درباره دل و حال خودم با تو، فقط یک آرزو و هوس است و اینکه بخواهم حال دلم را به تو بگویم، فقط یک خیال است."],[41,"طمع خام بین که قصه فاش","از رقیبان نهفتنم، هوس است","دلبستگی به داستان عاشقانه‌ام را ببین که نمی‌توانم درباره رقبای خود، حقیقت را پنهان کنم، این نیز هوس است."],[41,"شب قدری چنین عزیز شریف","با تو تا روز خفتنم، هوس است","در شب قدری این چنین عزیز و محترم هوس دارم تا روزهنگام در کنار تو بخوابم"],[41,"وه که دردانه‌ای چنین نازک","در شب تار سفتنم، هوس است","چقدر خوب است که در این شب تاریک، محبوبی نازک و دلربا را در آغوش بگیرم."],[41,"ای صبا امشبم مدد فرمای","که سحرگه شکفتنم، هوس است","ای باد صبا، امشب به من کمک کن تا در صبحگاه بشکفم و به زندگی جدیدی آغازین داشته باشم، زیرا این آرزو و اشتیاقی است در درونم."],[41,"از برای شرف به نوک مژه","خاک راه تو رفتنم، هوس است","برای احترام و ارزشمندی به تو، حتی اگر فقط با نوک مژه‌ام خاک راهت را جارو کنم ، به دنبال آن می‌روم. این احساس، هوس و آرزوست."],[41,"همچو حافظ به رغم مدعیان","شعر رندانه گفتنم، هوس است","منظور این است که مانند حافظ که با وجود رقبای شاعری، به سرودن شعرهای فریبنده و دل‌نشین خود ادامه می‌دهد، من نیز خواهان این کار هستم و این تنها یک آرزو و تمایل است."],[42,"صحن بستان ذوق‌بخش و صحبت یاران خوش است","وقت گل خوش باد کز وی وقت می‌خواران خوش است","محیط باغ خوشایند و گفتگو با دوستان لذت‌بخش است. امیدوارم در زمان شکوفایی گل‌ها، خوش‌بختی و شادابی خاصی به می‌نوشندگان دست دهد."],[42,"از صبا هر دم مشام جان ما خوش می‌شود","آری آری طیب انفاس هواداران خوش است","هر لحظه از نسیم صبحگاهی، روح و جان ما خوشبو می‌شود. به‌راستی، بوی خوش هواداران و دوستان دلپذیر است."],[42,"ناگشوده گل نقاب، آهنگ رحلت ساز کرد","ناله‌ کن بلبل که گلبانگ دل‌افکاران خوش است","گل با عدم زیبایی و شادابی‌اش به مرگ نزدیک شده است. به بلبل بگو که ناله و آوازش در این شرایط، برای کسانی که اندیشمند و حساس به عشق هستند، زیبا و دلپذیر است."],[42,"مرغ خوشخوان را بشارت باد کاندر راه عشق","دوست را با ناله شب‌های بیداران خوش است","مرغ خوشخوان (بلبل) را خوش آمد می‌گویم، زیرا در مسیر عشق به دوست، ناله‌های شب‌های بی‌خوابی زیبا و دل‌انگیز است."],[42,"نیست در بازار عالم خوشدلی ور زان که هست","شیوه رندی و خوش‌باشی عیاران خوش است","در دنیای پر از غم و اندوه، خوشدل بودن ممکن نیست، اما اگر کسی به شیوه زیرکی و خوش‌گذران عیاران زندگی کند، این خوشی قابل تحسین است."],[42,"از زبان سوسن آزاده‌ام آمد به گوش","کاندر این دیر کهن، کار سبکباران خوش است","صدای سوسن بی‌نوا به من می‌گوید که در این معبد قدیمی، زندگی بی‌دغدغه و سبک‌بار خوب است."],[42,"حافظا! ترک جهان گفتن طریق خوشدلیست","تا نپنداری که احوال جهان‌داران خوش است","حافظ می‌گوید اینکه به بی‌توجهی به دنیا بپردازیم و از آن فاصله بگیریم، راهی به سوی خوشحالی است و نباید فکر کنی که وضعیت افراد ثروتمند و قدرتمند خوب و خوش است."],[43,"کنون که بر کف گل، جام باده صاف است","به صد هزار زبان، بلبلش در اوصاف است","اینکه اکنون روی گل، جام شراب زلالی وجود دارد، بلبل با صد هزار زبان در حال توصیف زیبایی‌های آن است."],[43,"بخواه دفتر اشعار و راه صحرا گیر","چه وقت مدرسه و بحث کشف کشّاف است؟","بخوان دفتر اشعار و به راه بیابان برو، چون چه زمانی درس و بحث در مدرسه و جستجوی حقایق مهم است؟"],[43,"فقیه مدرسه، دی، مست بود و فتوی داد","که می، حرام ولی به ز مال اوقاف است","فقیه مدرسه، دیوانه بود و فتوا داد که نوشیدن شراب حرام است، اما به هر حال از مال وقف بهتر است."],[43,"به درد و صاف، تو را حکم نیست خوش درکش","که هرچه ساقی ما کرد عین الطاف است","در این بیت، حافظ می‌گوید که در مورد شراب و نوشیدن آن، تو نمی‌توانی قضاوت کنی، زیرا هر کاری که ساقی ما انجام می‌دهد، از روی لطف و محبت است و نباید آن را نادرست دانست."],[43,"ببر ز خلق و چو عنقا، قیاس کار بگیر","که صیت گوشه‌نشینان، ز قاف تا قاف است","از میان مردم دور شو و مانند عنقا (پرنده‌ای افسانه‌ای) کار خود را بسنج؛ زیرا نام و آوازه‌ی افرادی که در کنار نشسته‌اند، از قله‌ای به قله‌ای دیگر گسترش یافته و شهرت دارند."],[43,"حدیث مدّعیان و خیال همکاران","همان حکایت زردوز و بوریاباف است","سخن مدعیان و خیال همکاران چیزی جز داستان زردوز (کسی که زر را می‌ریزد) و بوریاباف (کسی که پارچه‌ای از پشم می‌بافد) نیست، یعنی نشان می‌دهد که هر دو گروه در تلاش‌اند تا چیزی را به خود نسبت دهند که در واقع واقعیت ندارد."],[43,"خموش «حافظ» و این نکته‌های چون زر سرخ","نگاه دار که قلّاب شهر، صرّاف است","حافظ سکوت می‌کند و می‌گوید این نکته‌های گران‌بها مانند طلاهای سرخ را نگه‌دار، زیرا در این شهر، طلاساز کسی است که تنها به فکر پول و منافع خود است."],[44,"در این زمانه، رفیقی که خالی از خلل است","صراحی می ناب و سفینه غزل است","در روزگاری که پیدا کردن دوست واقعی، بی‌عیب و وفادار، بسیار دشوار شده است، اگر کسی چنین رفیقی پیدا کند، وجود او همچون صراحی‌ای پر از شراب ناب و کشتی‌ای سرشار از غزل و زیبایی است.(صراحی: ظرفی با گردن باریک برای نگهداری و ریختن شراب)(سفینه: کشتی؛ همچنین در ادبیات به مجموعه‌ای از شعرها و نوشته‌ها گفته می‌شود.)"],[44,"جریده رو که گذرگاه عافیت، تنگ است","پیاله گیر که عمر عزیز، بی‌بدل است","ای انسان، سبک‌بار و آزاد از قیدوبندهای دست‌وپاگیر زندگی حرکت کن؛ زیرا راه رسیدن به سلامت و رستگاری، راهی باریک و دشوار است. جام را برگیر و قدر لحظه‌های زندگی را بدان، زیرا این عمر عزیز جایگزینی ندارد و وقتی بگذرد، بازنمی‌گردد.(جریده‌رو: تنها و سبک‌بار حرکت‌کننده)(پیاله‌گیر: جام به دست بگیر؛ در خوانش عرفانی، پذیرای عشق و شور زندگی باش.)"],[44,"نه من ز بی‌عملی، در جهان، ملولم و بس","ملالت علما هم ز علم بی‌عمل است","نه اینکه فقط من از بی‌عملی در این دنیا خسته‌ام؛ بلکه ناراحتی علمای بزرگ هم ناشی از علمی است که به عمل نمی‌انجامد."],[44,"به چشم عقل در این رهگذار پرآشوب","جهان و کار جهان، بی‌ثبات و بی‌محل است","با دید عقلانی، در این راه پر هرج و مرج دنیا و در کارهای آن، همه چیز ناپایدار و بی‌جایگاه است."],[44,"بگیر طرّه مه‌چهره‌ای و قصّه مخوان","که سعد و نحس ز تأثیر زهره و زحل است","گوشه‌ای از موی زیبا را بگیر و درباره‌ی این موضوع صحبت نکن که خوشبختی و بدبختی به تأثیر سیاره‌های زهره و زحل بستگی دارد."],[44,"دلم، امید فراوان به وصل روی تو داشت","ولی اجل به ره عمر، رهزن امل است","دل من به رسیدن به چهره تو بسیار امیدوار بود، اما مرگ در مسیر زندگی، آرزوهایم را غارت کرد."],[44,"به هیچ دور نخواهند یافت هشیارش","چنین که «حافظ» ما، مست باده ازل است","هیچ کس نمی‌تواند مانند حافظ که مست باده جاویدان است، هوشیار و آگاه باشد."],[45,"گل در بر و می در کف و معشوق به کام است","سلطان جهانم به چنین روز، غلام است","با گل در دستانم و جام می در اختیار، و محبوبم در کنارم، احساس می‌کنم که در این لحظه آنقدر سرافراز و بلند جایگاهم که گویی سلطان عالم به خوشبختی ،در نظرم غلامی بیش نیست."],[45,"گو شمع میارید در این جمع که امشب","در مجلس ما، ماه رخ دوست، تمام است","اگر شمعی هم می‌آورید، دیگر ضرورتی ندارد، زیرا که امشب در جمع ما، زیبایی چهره معشوق به‌تمامی درخشان است."],[45,"در مذهب ما، باده، حلال است ولیکن","بی‌روی تو ای سرو گل‌اندام، حرام است","در آئین ما نوشیدن شراب مجاز است، اما در غیاب تو، ای خوش‌چهره و زیبا، این کار ناپسند و منع شده است."],[45,"گوشم همه بر قول نی و نغمه چنگ است","چشمم، همه، بر لعل لب و گردش جام است","گوشم به صدای نی و موسیقی چنگ توجه دارد و چشمانم به لبان سرخ و حرکت جام خیره است."],[45,"در مجلس ما، عطر میامیز که ما را","هر لحظه، ز گیسو‌ی تو، خوش‌بوی مشام است","در مجلس ما، عطر را با شراب ترکیب کن، زیرا هر لحظه بوی خوش گیسوان تو باعث خوشبو شدن مشام ما می‌شود."],[45,"از چاشنی قند مگو هیچ و ز شکّر","زآن رو که مرا از لب شیرین تو، کام است","در این بیت، شاعر از دوستش می‌خواهد که در مورد قند و شکر صحبت نکند، زیرا او از لب‌های شیرین معشوقش لذت می‌برد و کامش به‌وسیله آن شیرینی تأمین می‌شود. به عبارتی، شیرینی لب معشوق برای او کافی و دل‌چسب است."],[45,"تا گنج غمت در دل ویرانه‌، مقیم است","همواره مرا کوی خرابات، مقام است","هر زمان که غم تو در دل من حضور دارد و جایی برای آرامش و خوشی نمی‌گذارند، من دائما در کوی خرابات (محل گناه و رندی) ساکن هستم و آنجا برایم مقام و منزلت دارد."],[45,"از ننگ چه گویی که مرا نام ز ننگ است؟","وز نام چه پرسی که مرا ننگ ز نام است؟","چگونه می‌توانی از ننگ من سخن بگویی در حالی که خود نام من به ننگ مربوط می‌شود؟ و چگونه می‌توانی درباره نام من بپرسی در حالی که خود ننگ من از نام من نشأت می‌گیرد؟"],[45,"می‌خواره و سرگشته و رندیم و نظرباز","وآن کس که چو ما نیست در این شهر، کدام است؟","ما شراب نوش، سرگشته و آزاد و بی‌پروا هستیم درست! اما کسی را که بر خلاف ما در این شهر باشد، نمی‌شناسیم. (یعنی همه‌ در دنیا میخواره و سرگشته و ... هستند ولی به رو و زبان نمیارند)"],[45,"با محتسبم، عیب مگویید که او نیز","پیوسته، چو ما در طلب عیش مدام است","نقص‌ها و عیب‌های من را پیش محتسب بیان نکنید، زیرا او هم مانند ما همیشه در جستجوی لذت و شادی پایدار و نوشیدن دائمی شراب است."],[45,"حافظ! منشین بی‌می و معشوق، زمانی","کایّام گل و یاسمن و عید صیام است","حافظ! در حالتی که هر لحظه ای برای لذت و شادی وجود دارد، بی‌می و معشوق نباش. این زمان، شبیه به روزهای بهاری است که گل و یاسمن شکفته و عید فطر نزدیک است."],[46,"به کوی میکده هر سالکی که ره دانست","دری دگر زدن اندیشه تبه دانست","هر کسی که به میکده آشنایی داشته باشد، می‌داند که باید هر سال در این مکان، در دیگری را بزند و از تجربیات جدید بهره‌مند شود، بنابراین به این نتیجه می‌رسد که توجه به گذشته، تنها اندیشه‌ای بی‌فایده و تباه‌کننده است."],[46,"زمانه افسر رندی نداد جز به کسی","که سرفرازی عالم در این کله دانست","زمانه، برای کسی که در سرش افتخار و بزرگی دنیا را بشناسد، تاج رندی و آزادگی را نمی‌دهد."],[46,"بر آستانه میخانه هر که یافت رهی","ز فیض جام می اسرار خانقه دانست","هر کسی که در آستانه میخانه راهی پیدا کرد و از نعمت شراب بهره‌مند شد، به راز و اسرار خویش و دنیای معنوی پی می‌برد."],[46,"هر آن که راز دو عالم ز خط ساغر خواند","رموز جام جم از نقش خاک ره دانست","هر کسی که از نشانه‌های ساغر (جام) به راز و رمز دو جهان پی ببرد، می‌داند که رمه جام جم (جامی که خواص شگفت انگیزی دارد) در خاک راه نهفته است."],[46,"ورای طاعت دیوانگان ز ما مطلب","که شیخ مذهب ما عاقلی گنه دانست","از ما چیزی جز عشق و جنون نمی‌خواهند، چرا که شیخ مذهب (عالم دینی) ما نیز به گمراهی و بدی حاکم دانسته می‌شود."],[46,"دلم ز نرگس ساقی امان نخواست به جان","چرا که شیوه آن ترک دل سیه دانست","دل من دیگر از نرگس یعنی چشم‌ها یا زیبایی ساقی (دردانه) در امان نیست و نمی‌تواند آرام باشد، زیرا می‌دانم که شیوه آن دختر سیه‌چشم (زیبا) در آزار و بی‌تاب کردن عاشقان است."],[46,"ز جور کوکب طالع ،سحرگهان چشمم","چنان گریست که ناهید دید و مه دانست","چشمم از ظلم و بدیّی که ستاره فال به من آورده، در سحرگاهان به قدری گریه کرد که ناهید (زهره) و ماه هم به حال من پی بردند."],[46,"حدیث حافظ و ساغر که می‌زند پنهان","چه جای محتسب و شحنه، پادشه دانست","سخن حافظ و راز ساغر (جام شراب) که او پنهانی می‌گوید، چه نیازی به نظارت محتسب (سردسته پاسبان‌ان) و شحنه (صاحب‌منصبان) دارد، زیرا پادشاه (مقام بالا) خود این راز را می‌داند."],[46,"بلندمرتبه شاهی که نه رواق سپهر","نمونه‌ای ز خم طاق بارگه دانست","حافظ به بلندمرتبه‌ترین پادشاهی اشاره دارد که نه رواق آسمان را به عنوان نمونه‌ای از خم طاق بارگاه خود می‌داند. این به معنای عظمت و شکوه بارگاه اوست که به اندازه آسمان و بالاتر از آن است."],[47,"صوفی از پرتو می راز نهانی دانست","گوهر هر کس از این لعل، توانی دانست","صوفی با نور و درخشش می راز بزرگی را فهمید؛ اصل هرکس را از این لعل سرخ می‌توانی بشناسی."],[47,"قدر مجموعه گل، مرغ سحر داند و بس","که نه هر کو ورقی خواند، معانی دانست","ارزش گل‌ها را فقط بلبل می‌داند، نه‌هر کسی که صفحه‌ای بخواند بدان معنی‌است که آن‌را فهمیده است."],[47,"عرضه کردم دو جهان بر دل کارافتاده","به جز از عشق تو باقی همه فانی دانست","تمام دو جهان را به دل عاشق دادم، به‌جز عشق تو همه چیز را فانی و نابود دانست."],[47,"آن شد اکنون که ز ابنای عوام اندیشم","محتسب نیز در این عیش نهانی دانست","اکنون به آن مرحله رسیده‌ام که حتی از سوی مردم عادی نیز متوجه می‌شوم، و کسی که مسئولیت نظارت دارد، نیز از این لذت پنهانی که من تجربه می‌کنم، آگاه شده است."],[47,"دل‌بر، آسایش ما مصلحت وقت ندید","ور نه از جانب ما دل‌نگرانی دانست","یار ما، آسایش ما را به‌مصلحت ندید وگرنه حال ما را درک می‌کند."],[47,"سنگ و گل را کند از یمن نظر لعل و عقیق","هر که قدر نفس باد یمانی دانست","هرکسی ارزش نسیم یمانی را بفهمد، از نیکی نظر خود می‌تواند سنگ و گل را به لعل و عقیق تبدیل کند."],[47,"ای که از دفتر عقل، آیت عشق آموزی","ترسم این نکته به تحقیق ندانی دانست","ای کسی که از دانش و فهم عقل، بدنبال آموختن حقیقت عشق هستی، می‌ترسم که این نکته را به‌درستی درنیابی."],[47,"می بیاور که ننازد به گل باغ جهان","هر که غارت‌گری باد خزانی دانست","شراب بیاور زیرا کسی که بداند چگونه باد خزان به باغ گل دنیا آسیب می‌زند، نباید به زیبایی‌های دنیا ببالد."],[47,"حافظ این گوهر منظوم که از طبع انگیخت","ز اثر تربیت آصف ثانی دانست","حافظ می‌گوید این شعر زیبا که به نظم درآمده، نتیجه ذوق و talent اوست که تحت تأثیر تربیت آصف ثانی، یعنی وزیر و حکیمی بزرگ، شکل گرفته است."],[48,"روضه خلد برین خلوت درویشان است","مایه محتشمی، خدمت درویشان است","محل آرامش و سکوت درویشان بهشت برین است و حضور در آن جا باعث عزت و احترام می‌شود و خدمت به درویشان موجب بزرگی و ارج‌مندی است."],[48,"گنج عزلت که طلسمات عجایب دارد","فتح آن در نظر رحمت درویشان است","مکان خلوت و دور از دنیا که پر از عجایب و جنبه‌های مذهبی است، با نگاه و رحمت درویشان به راحتی در دسترس می‌شود."],[48,"قصر فردوس که رضوانش به دربانی رفت","منظری از چمن نزهت درویشان است","بهشت که در آن پرنده خوشبختی به نگهبانی در آمده، نمایی از باغ خوشبو و دل‌انگیز درویشان است."],[48,"آن چه زر می‌شود از پرتو آن، قلب سیاه","کیمیاییست که در صحبت درویشان است","هر چیزی که به طلا تبدیل می‌شود، تحت تأثیر آن نور، قلب تیره انسان است که در نزد درویشان (زاهدان و اهل معنویت) ارزشمند می‌شود."],[48,"آن که پیشش بنهد تاج تکبر، خورشید","کبریاییست که در حشمت درویشان است","کسی که در برابر او تاج خودبزرگ‌بینی را بگذارد، همانند خورشید بزرگی است که در میان مجد و عظمت درویشان قرار دارد."],[48,"دولتی را که نباشد غم از آسیب زوال","بی‌تکلف بشنو، دولت درویشان است","دولت و خوشی‌ای را که در آن هیچ نگرانی از آسیب و زوال وجود ندارد، بی‌زحمتی بشنوید، همان دولت درویشان است."],[48,"خسروان، قبله حاجات جهانند ولی","سببش بندگی حضرت درویشان است","پادشاهان و سلاطین، جهت درخواست نیازهای مردم هستند، اما این درویشانند که با بندگی و خضوع خود، سبب بزرگداشت و مقام آن‌ها می‌شوند."],[48,"روی مقصود که شاهان به دعا می‌طلبند","مظهرش آینه طلعت درویشان است","روی مقصود که شاهان به دعا از آن طلب می‌کنند، در حقیقت تجلی آینه چهره درویشان است."],[48,"از کران تا به کران، لشکر ظلم است ولی","از ازل تا به ابد، فرصت درویشان است","در سراسر جهان، ظلم و ستم حاکم است، اما در عوض، در هر زمانی و تا همیشه، برای درویشان (افراد ساده‌دل و زاهد) موقعیت و فرصتی وجود دارد."],[48,"ای توانگر مفروش این همه نخوت که تو را","سر و زر در کنف همت درویشان است","ای توانگر، این همه خودپسندی و بزرگی را نعرضه کن، زیرا ثروت و دارایی واقعی تو در دست توانایی و اراده درویشان است."],[48,"گنج قارون که فرو می‌شود از قهر هنوز","خوانده باشی که هم از غیرت درویشان است","گنج قارون که به خاطر قهر و خشم از دست می‌رود، هنوز هم به یاد داشته باشی که این مسأله به غیرت و شجاعت درویشان مربوط می‌شود."],[48,"حافظ ار آب حیات ازلی می‌خواهی","منبعش خاک در خلوت درویشان است","اگر به دنبال آب حیات، یعنی منبعی برای زندگی‌جاودان و معنوی هستی، باید بدان که این منبع در خاک در خلوت درویشان قرار دارد. درویشان افرادی ساده و زاهد هستند که به دور از تجملات زندگی می‌کنند و در فضاهای معنوی به سر می‌برند."],[48,"من غلام نظر آصف عهدم کو را","صورت خواجگی و سیرت درویشان است","من به نظر و دیدگاه آصف، یکی از بزرگان عهد خود، وابسته‌ام؛ که ظاهری مانند خواجه‌ها دارد ولی باطنی چون درویشان."],[49,"به دام زلف تو دل مبتلای خویشتن است","بکش به غمزه که اینش سزای خویشتن است","دل من به زلف تو گرفتار شده است، پس با یک نگاه زیبا، آن را به کشتن برسان که این مجازات برای خودم سزاوار است."],[49,"گرت ز دست برآید مراد خاطر ما","به دست باش که خیری به جای خویشتن است","اگر تو بتوانی خواسته دل ما را برآوری، بهتر است که در این دنیا بمانی، زیرا خیری در آن برای خودت هست."],[49,"به جانت ای بت شیرین دهن که همچون شمع","شبان تیره، مرادم فنای خویشتن است","ای بت شیرین دهن به جانت سوگند که در شبهای تیره مرادم همچون شمع فنا کردن خویشتن است."],[49,"چو رای عشق زدی با تو گفتم ای بلبل","مکن که آن گل خندان به رای خویشتن است","وقتی که درباره عشق با تو صحبت کردم، ای بلبل، نگو که آن گل خوش‌بو و زیبا به خودی خود خوشحال و خندان است؛ بلکه شادی و زیبایی‌اش به خاطر رای و نظر خود اوست."],[49,"به مشک چین و چگل نیست بوی گل محتاج","که نافه‌هاش ز بند قبای خویشتن است","بوی گل به مشکی که از چین و چیدمان زیبای آن می‌آید وابسته نیست، زیرا عطرش از بندهای لباس خود فرد ناشی می‌شود. یعنی زیبایی و عطر گل، به ویژگی‌های درونی و وجودی خود آن فرد وابسته است."],[49,"مرو به خانه ارباب بی‌مروت دهر","که گنج عافیتت در سرای خویشتن است","به‌سوی این دنیای ناجوانمرد مرو و از او توقع چیزی نداشته‌باش زیرا گنج سلامت و آسایش تو در خانه خود توست."],[49,"بسوخت حافظ و در شرط عشقبازی او","هنوز بر سر عهد و وفای خویشتن است","حافظ از عشق و وابستگی‌اش می‌سوزد، اما در این حال هنوز به عهد و وفای خود نسبت به معشوق پایبند و وفادار است."],[50,"لعل سیراب به‌خون‌تشنه‌، لب یار من است","وز پی دیدن او دادن جان کار من است","معشوق من لب‌هایی دارد سیراب از سرخی همچون لعل اما تشنه به خون، و در اشتیاق دیدن آن لب‌ها‌، جان دادن و جان‌بازی کار و پیشه من است."],[50,"شرم از آن چشم سیه بادش و مژگان دراز","هر که دل بردن او دید و در انکار من است","شرم باد بر کسی که به‌آن چشمان سیاه و مژگان بلند می‌نگرد وقتی که دل‌بردن آنها را از من می‌بیند و مرا نادیده می‌گیرد."],[50,"ساروان رخت به دروازه مبر‌، کان سر کو","شاهراهی‌ست که منزلگه دلدار من است","ای ساروان، به دروازه مرو و در آن محله توقف مکن که آنجا شاهراهی‌است که مأوا و منزل معشوق من است."],[50,"بنده طالع خویشم که در این قحط وفا","عشق آن لولی سرمست‌، خریدار من است","بنده و ممنون فال نیکوی خودم هستم که در این قحطی وفا و مهر، من مهر آن لولی سرمست را در دل دارم. (لولی یا کولی‌ها در رقص و شاد بودن معروف بوده‌اند در اینجا در معنایی سمبلیک و مجازی به‌کار رفته‌است.)"],[50,"طبله عطر گل و زلف عبیر افشانش","فیض یک شمّه ز بوی خوش عطار من است","بوستان گل و سنبل‌های خوش‌عطرش‌، یک رایحه از عطر عطار ( ومعشوق خوش‌عطر) من است."],[50,"باغبان همچو نسیمم ز در خویش مران","کآب گلزار تو از اشک چو گلنار من است","ای باغبان چون (نسیم که به دزدی عطرهای باغت می‌آید) با من رفتار مکن و مرا از در مران‌، اشک چشمان من است که گل‌های باغت را تازه نگه‌می‌دارد و آبیاری می‌کند."],[50,"شربت قند و گلاب از لب یارم فرمود","نرگس او که طبیب دل بیمار من است","چشمان مستش که طبیب دل دردمند و عاشق من است، برای درمان من از لبانش شربت قند و گلاب نسخه‌کرد."],[50,"آن که در طرز غزل نکته به حافظ آموخت","یار شیرین‌سخن نادره‌گفتار من است","کسی که نظم و طرز غزل‌آرایی را به حافظ آموخت یار و محبوب شیرین‌گفتار و نغزگوی بی‌همتای من است."],[51,"روزگاری‌ست که سودای بتان، دین من است","غم این کار‌، نشاط دل غمگین من است","مدتی است که هوس وصل بتان و زیبا‌یان، کیش و آیین من شده و غم این جستجو، شادی دل غمگین من را فراهم کرده است."],[51,"دیدن روی تو را دیده‌ی جان‌بین باید","وین کجا مرتبه‌ی چشم جهان‌بین من است؟","دیدن روی تو‌، چشمی جان‌بین لازم دارد، چشم جهان‌بین من کی می‌تواند؟ و کجا در آن مرتبه است؟"],[51,"یار من باش که زیب فلک و زینت دهر","از مه روی تو و اشک چو پروین من است","بیا یار من باش تا با هم فلک و روزگار را باهم زینت بخشیده و بیاراییم؛ از روی زیبای تو و اشک‌های چون اختران پروین من."],[51,"تا مرا عشق تو، تعلیم سخن‌گفتن کرد","خلق را ورد زبان، مدحت و تحسین من است","از روزی که عشق تو شعر‌گفتن به من آموخت مردمان از تحسین و آفرین گفتن به‌من باز نمی‌ایستند."],[51,"دولت فقر خدایا به من ارزانی دار","کاین کرامت، سبب حشمت و تمکین من است","خدایا ثروت فقر را به من عطا فرما که‌این بزرگی مرا صاحب‌حشمت و دولتمند می‌گرداند."],[51,"واعظ شحنه‌شناس، این عظمت گو مفروش","زان که منزلگه سلطان، دل مسکین من است","ای واعظی که دوست شحنه هستی زیاد پررویی و گستاخی مکن، زیرا که دل مسکین و دردمند من منزل‌گه و سرای سلطان است."],[51,"یا رب این کعبه‌ی مقصود، تماشاگه کیست؟","که مغیلان طریقش، گل و نسرین من است","خدایا این کعبه، منظور و مقصد کیست؟ که خارهای راهش بر من همچون گل و نسرین لطیف و نرم گشته‌است."],[51,"«حافظ» از حشمت پرویز، دگر، قصّه مخوان","که لبش، جرعه‌کش خسرو شیرین من است","حافظا از بزرگی و شوکت پرویز دیگر سخن مگو که لب او جرعه‌کش از خسرو شیرین من است."],[52,"منم که گوشه میخانه، خانقاه من است","دعای پیر مغان، ورد صبحگاه من است","آنکه مقیم گوشه میخانه است منم و آن‌را به‌چشم خانقاه خود می‌نگرم و سحرگاهان پیر خرابات را دعای خیر می‌گویم."],[52,"گرم ترانه چنگ صبوح نیست چه باک","نوای من به سحر، آه عذرخواه من است","اگرچه نوای خوش چنگ در سحرگاه در دسترس من نیست اما آه سحرگاه من به‌همان مقدار نوای چنگ خوش‌نواست."],[52,"ز پادشاه و گدا، فارغم بحمدالله","گدای خاک در دوست، پادشاه من است","خدا را شکر می‌گویم که نه بنده کسی هستم و نه کسی مرا بنده است اما بنده گدای کوی یار هستم."],[52,"غرض ز مسجد و میخانه‌ام، وصال شماست","جز این خیال ندارم، خدا، گواه من است","هدف از رفتن به مسجد و میخانه‌، دیدن شماست و بجز این قصدی ندارم خدا بر این گواه است."],[52,"مگر به تیغ اجل، خیمه برکنم ور نی","رمیدن از در دولت، نه رسم و راه من است","این دیدارهای سعادت‌بار را رسم و راه خود کرده‌ام و از آن دست بر نمی‌دارم مگر مرگ مرا باز‌دارد."],[52,"از آن زمان که بر این آستان نهادم روی","فراز مسند خورشید، تکیه‌گاه من است","از روزی که بر این آستان دولت و سعادت روی آورده‌ام بر بالای جایگاه خورشید تکیه زده‌ام."],[52,"گناه اگرچه نبود اختیار ما، «حافظ»!","تو در طریق ادب باش، گو گناه من است","گناه اگر چه در اختیار آدمی نیست اما باید مؤدب و باحیا باشد و بگوید که گناه من است."],[53,"ز گریه مردم چشمم نشسته در خون است","ببین که در طلبت حال مردمان چون است","چشمم از گریه مردم به شدت پرخون شده است. ببین که حال مردانی که در جستجوی تو هستند چقدر بد و دلسوزانه است."],[53,"به یاد لعل تو و چشم مست میگونت","ز جام غم، می لعلی که می‌خورم خون است","به خاطر یاد لعل (لب) تو و چشمان مست و زیبا و میگونت، از جام غم، شراب لعلینی که می‌نوشم، طعمش مانند خون است."],[53,"ز مشرق سر کو، آفتاب طلعت تو","اگر طلوع کند، طالعم همایون است","اگر خورشید زیبایی تو از سمت بالای کوه طلوع کند، یعنی اگر تو در زندگی‌ام حضور داشته باشی، سرنوشتم هم خوشبخت خواهد شد."],[53,"حکایت لب شیرین، کلام فرهاد است","شکنج طرّه لیلی مقام مجنون است","حکایت لب‌های شیرین تو همانند سخنان فرهاد (عاشق لیلی که برای رسیدن به او معروف است) است، و معضل و تلخی در مورد موهای افشان لیلی، همانند گرفتاری مجنون (عاشق لیلی که دیوانه‌وار او را دوست دارد) است."],[53,"دلم بجو که قدت همچو سرو دلجوی است","سخن بگو که کلامت لطیف و موزون است","دل من را جستجو کن چون قامت زیبای تو مثل سرو دل‌جوی است. صحبت کن زیرا سخن‌های تو شیرین و موزون است."],[53,"ز دور باده به جان، راحتی رسان ساقی","که رنج خاطرم از جور دور گردون است","ای ساقی، از دوری شراب، به جانم آرامشی ببخش، چرا که درد و رنج خاطر من از ظلم و بی‌رحمی روزگار است."],[53,"از آن دمی که ز چشمم برفت رود عزیز","کنار دامن من همچو رود جیحون است","از وقتی که محبوبم از نزدیکی من رفت، احساس می‌کنم که دوری او همچون جیحون، رود بزرگی، برایم دردناک و غم‌انگیز است."],[53,"چگونه شاد شود اندرون غمگینم؟","به اختیار، که از اختیار بیرون است","غمگین دل من چگونه می‌تواند شاد شود؟ این کار اراده من نیست و خارج از توانایی من است."],[53,"ز بیخودی طلب یار می‌کند حافظ","چو مفلسی که طلبکار گنج قارون است","حافظ از حالت بی‌خودیش در عشق می‌گوید، مانند فردی که در فقر و تنگدستی به دنبال ثروتی می‌گردد که متعلق به قارون است، و به همین دلیل در پی محبوب خویش می‌باشد."],[54,"خم زلف تو دام کفر و دین است","ز کارستان او یک شمه این است","زلف معشوق چنان فریبنده است که هم می‌تواند عاشق را در دام عشق زمینی گرفتار کند (کفر) و هم می‌تواند او را به وادی حقیقت و عشق الهی برساند (دین). و این تنها یکی از هزاران جلوه و شگفتی‌های معشوق است."],[54,"جمالت معجز حسن است لیکن","حدیث غمزه‌ات سحر مبین است","زیبایی تو معجزه‌آساست و اما وصف غمزه تو ممکن نیست زیرا آن‌یکی سحر و افسون آشکار است."],[54,"ز چشم شوخ تو جان کی توان برد؟","که دایم با کمان اندر کمین است","از چشم بی‌باک و بی‌شرم تو چون توان جان سالم بدر برد؟ که یک آن از تیر افکندن و غمزه باز نمی‌ایستد."],[54,"بر آن چشم سیه صد آفرین باد","که در عاشق کشی سحرآفرین است","صدها آفرین بر آن چشم‌های سیاه که در کشتن عاشق بی‌رقیب و معجزه‌گر است."],[54,"عجب علمیست علم هیئت عشق","که چرخ هشتمش، هفتم زمین است","در میان علم‌ها «علم نجوم عشق» شگرف و عجیب است که چرخ هشتم در برابر او در هفت قعر زمین پست و بی‌مقدار است."],[54,"تو پنداری که بدگو رفت و جان برد؟","حسابش با کرام الکاتبین است","مپندار که بدگو گریخت و جان سالم بدر برد وای بر حال او که حساب او با «کرام الکاتبین» است و بسیار بد سرنوشتی در انتظارش است."],[54,"مشو حافظ ز کید زلفش ایمن","که دل برد و کنون در بند دین است","ای حافظ با این وجود از مکر و کید زلف او غافل مشو؛ تو را عاشق خود کرد و دلت را ربود و به‌این بسنده نخواهد کرد؛ دین تو را نیز خواهد ربود."],[55,"دل سراپرده محبت اوست","دیده آیینه‌دار طلعت اوست","دل و قلب من سراپرده و اقامتگاه عشق اوست و چشم‌هایم مثل آیینه‌دار مدام در برابر رخ زیبای اوست."],[55,"من که سر در نیاورم به دو کون","گردنم زیر بار منت اوست","من که به دو عالم سر فرود نیاوردم از اینکه عشق او در قلبم و تصویرش در چشمانم است منت‌بار هستم و خود را مدیون او می‌دانم."],[55,"تو و طوبی و ما و قامت یار","فکر هر کس به قدر همت اوست","تو و آنانکه هوس درخت بهشت کرده‌اید همان برای شما و من به قامت یار راضی هستم بلی اندیشه و خواست هرکس به بلندی همّت اوست."],[55,"گر من آلوده‌دامنم چه عجب","همه عالم گواه عصمت اوست","اگر من گناهکار و تر‌دامن و بدنام هستم خیالی نیست تمام دنیا می‌داند که او پاک و باعصمت است."],[55,"من که باشم در آن حرم که صبا","پرده‌دار حریم حرمت اوست","در جایی که باد صبا پرده‌دار و پیام‌آور سراپرده یار است من کی باشم که ادعای پرده‌داری او را داشته باشم‌؟"],[55,"بی خیالش مباد منظر چشم","زآن که این گوشه جای خلوت اوست","چشمان من از خیال و تصویر او خالی و تهی مبادا زیرا بهترین جا برای خلوت اوست و جز او کسی دیگر در چشم من جایی ندارد."],[55,"هر گل نو که شد چمن‌آرای","ز اثر رنگ و بوی صحبت اوست","هر گل تازه و شکفته و خوش‌رنگ و بو که زینت چمن است آن‌را از هم‌نشینی با یار من بدست آورده است."],[55,"دور مجنون گذشت و نوبت ماست","هر کسی پنج روز، نوبت اوست","دور و نوبت داستان‌های مجنون به‌پایان رسید و اکنون نوبت داستان عشق ماست آری نوبت هرکس بیش از پنج روز نیست."],[55,"ملکت عاشقیّ و گنج طرب","هر چه دارم ز یمن همت اوست","پادشایی عاشقی و این گنج شادی که دارم همه از یمن و سعادت همّت و خواست یار است."],[55,"من و دل گر فدا شدیم چه باک؟","غرض اندر میان سلامت اوست","اگر من و دل هر دو در این راه فدا شویم باکی نیست؛ غرض‌ و آرزوی ما، سلامت اوست."],[55,"فقر ظاهر مبین که حافظ را","سینه گنجینه محبت اوست","به فقر و تهی‌دستی ظاهری حافظ منگر‌؛ او گنج محبت او را در سینه دارد."],[56,"آن سیه‌چرده که شیرینی عالم با اوست","چشم میگون، لب خندان، دل خرم با اوست","آن زیباروی سبزه (تیره‌گون) که شیرینی دو عالم را در خود جمع کرده و چشمان پر می و مست دارد و چهره خندان دارد‌‌؛"],[56,"گر چه شیرین‌‌دهنان پادشهان‌اند ولی","او سلیمان زمان است که خاتم با اوست","اگر‌چه خوش‌دهنان روزگار در حکم پادشاهان هستند اما لب‌های زیبای او چنان است که حکم خاتم سلیمان را دارد."],[56,"روی خوب است و کمال هنر و دامن پاک","لاجرم، همت پاکان دو عالم با اوست","زیبا روی و پاکدامن و هنرمند است و به همین خاطر‌، همّت و دعای همه پاکان دو عالم همراه و یاور اوست."],[56,"خال مشکین که بدان عارض گندمگون است","سرّ آن دانه که شد رهزن آدم با اوست","سرّ و راز آن دانه که آدم را در بهشت فریفت در آن خال سیاه است که بر چهره سبزه و گندمگون اوست."],[56,"دلبرم، عزم سفر کرد، خدا را یاران","چه کنم با دل مجروح؟ که مرهم با اوست","دلبر و محبوبم قصد سفر کرده است با این دل مجروح و زخم‌دیده چه کنم‌؟ که مرهم و داروی آن دیدار اوست؟"],[56,"با که این نکته توان گفت که آن سنگین‌‌دل","کشت ما را و دم عیسی مریم با اوست","این نکته را برای که بگویم و چه کسی آن‌را درک می‌کند که آن بی‌رحم و سنگین‌دل مرا کشته و هم‌صحبتی با او تنها زندگی‌بخش من است."],[56,"حافظ از معتقدان است گرامی دارش","زآن که بخشایش بس روح مکرم با اوست","حافظ را بی‌دین مشمار و او را گرامی بدار زیرا که بخشایش و لطف بسی روح مکرّم و گرانقدر با اوست."],[57,"سر ارادت ما و آستان حضرت دوست","که هر چه بر سر ما می‌رود ارادت اوست","سر و غرور ما بر درگاه و آستان حضرت دوست فرود آید و تسلیم است چون هر اتفاقی که برای ما می‌افتد، به خاطر ارادت و علاقه‌ای است که به او داریم."],[57,"نظیر دوست ندیدم، اگر چه از مه و مهر","نهادم آینه‌ها در مقابل رخ دوست","همچون یار خود زیبا ندیده‌ام اگرچه ماه و خورشید را آینه روی دوست خود کردم."],[57,"صبا ز حال دل تنگ ما چه شرح دهد؟","که چون شکنج ورق‌های غنچه تو بر توست","صبا چگونه می‌تواند شرح حال ما را بازگوید وقتی که دل ما همچون غنچه در هم فرورفته و گلبرگ‌های آن بسته است."],[57,"نه من سبوکش این دیر رندسوزم و بس","بسا سرا که در این کارخانه سنگ و سبوست","فقط من در این دیر که بسیار زرنگ‌ها و رندها را اسیر خود کرده‌است میخواره نیستم بسیار افراد و سرهاست که «سبوی سر» آنها بر سنگ‌های این دیر شکسته است."],[57,"مگر تو شانه زدی زلف عنبرافشان را؟","که باد غالیه‌سا گشت و خاک عنبربوست","گویا تو زلف و مویت را شانه زده‌ای که اینچنین نسیم‌، خوش‌عطر شده و خاک خوشبو شده است."],[57,"نثار روی تو هر برگ گل که در چمن است","فدای قدّ تو هر سروبن که بر لب جوست","تک‌تک برگ گل‌های زیبای چمن فدای رخ زیبای تو باد‌‌، و تک‌تک سروهای خوش‌قامت که بر لب جوی هستند فدای قد و بالای خوش تو."],[57,"زبان ناطقه در وصف شوق نالان است","چه جای کلک بریده‌زبان بیهده‌گوست؟","وقتی که زبان (که گویاست) از وصف عشق‌، نالان و ناتوان شده‌است قلم زبان‌بریده چطور می‌تواند عشق را وصف کند. (تشبیهی است از این‌رو که زبانه قلم‌نی را برای نوشتن می‌برند)"],[57,"رخ تو در دلم آمد مراد خواهم یافت","چرا که حال نکو در قفای فال نکوست","چهره تو در خاطر و یاد من آمد پس به‌آرزویم خواهم رسید زیرا بخت و حال مطلوب و سعادت‌بار از پی فال نکو و خوب می‌آید."],[57,"نه این زمان دل حافظ در آتش هوس است","که داغدار ازل همچو لاله خودروست","عشق و سوز دل حافظ مربوط به امروز و دیروز نیست، بلکه این سوز و داغ دل‌، ازلی است همچون داغ لاله صحرا."],[58,"دارم امید عاطفتی از جناب دوست","کردم جنایتی و امیدم به عفو اوست","امید دارم که دوستم به من محبت کند، هرچند که مرتکب اشتباهی شده‌ام و همچنان به عفو و بخشش او امیدوارم."],[58,"دانم که بگذرد ز سر جرم من که او","گر چه پریوش است ولیکن فرشته‌خوست","می‌دانم که او از گناه من خواهد گذشت، چرا که با وجود این‌که بسیار زیبا است، اما ذاتا انسان خوبی است."],[58,"چندان گریستیم که هر کس که برگذشت","در اشک ما چو دید روان گفت «کاین چه جوست؟»","آنچنان در گریه و اندوه فرو رفته‌ایم که هر کسی که از کنار ما می‌گذرد، وقتی اشک‌های ما را می‌بیند، با تعجب می‌پرسد این چه حالتی است؟"],[58,"هیچ است آن دهان و نبینم از او نشان","موی است آن میان و ندانم که آن چه موست","هیچ خبری از آن دهان ندارم و اثری از او نمی‌بینم، اما در میانه آن، موهایی وجود دارد و نمی‌دانم که آن‌ها چه نوع مویی هستند."],[58,"دارم عجب ز نقش خیالش که چون نرفت","از دیده‌ام که دم به دمش کار شست و شوست","تعجب می‌کنم از تصویری که از خیال او در ذهنم نقش بسته است، چون وقتی او از نظرم رفت، هر لحظه یادش در دلم همچنان تازه و زنده است."],[58,"بی گفت و گوی زلف تو دل را همی کشد","با زلف دلکش تو که را روی گفت و گوست؟","دل بدون گفت و گو با زیبایی موهای تو کشته میشود. چه کسی میتواند با زلف های دلفریب تو صحبت کند؟"],[58,"عمری‌ست تا ز زلف تو بویی شنیده‌ام","زان بوی در مشام دل من هنوز بوست","مدت زیادی است که بوی زلف تو را استشمام کرده‌ام و هنوز هم آن بوی خوش در یاد و حسرت دل من جای دارد."],[58,"حافظ بد است حال پریشان تو، ولی","بر بوی زلف یار پریشانیت نکوست","حافظ می‌گوید که حال پریشان تو بد است، اما بوی زلف یار در حالی که تو پریشان هستی، خوشبو و دلپذیر است."],[59,"آن پیک نامور که رسید از دیار دوست","آورد حرز جان ز خط مشکبار دوست","پیک معروفی که از سرزمین دوست آمد، جانم را با پیامی از خط خوشبو و خوش‌رنگ او حفظ کرد."],[59,"خوش می‌دهد نشان جلال و جمال یار","خوش می‌کند حکایت عزّ و وقار دوست","یار با جلال و زیبایی‌اش نشان و علامتی زیبا می‌دهد، و داستان افتخار و شرافت او نیز دلنشین و خوشایند است."],[59,"دل دادمش به مژده و خجلت همی‌برم","زین نقد قلب خویش که کردم نثار دوست","دل خود را به مژده‌ای درباره محبوب (دوست) دادم و حالا شرمنده و خجالت‌زده‌ام از این که این عشق و دل‌باختگی را برای او (دوست) فدای کرده‌ام."],[59,"شکر خدا که از مدد بخت کارساز","بر حسب آرزوست همه کار و بار دوست","خوشحالم که به لطف بختی که مؤثر و کمک‌رسان است، همه‌ی کارها و امور مربوط به معشوق مطابق با آرزوهای من پیش می‌رود."],[59,"سیر سپهر و دور قمر را چه اختیار؟","در گردشند بر حسب اختیار دوست","گردش آسمان و حرکت ماه چه اهمیتی دارد؟ آن‌ها بر اساس خواسته و اراده دوست (خدا) در حرکتند."],[59,"گر باد فتنه هر دو جهان را به هم زند","ما و چراغ چشم و ره انتظار دوست","اگر طوفان‌های بحران‌زا دو جهان را به هم بریزد، ما باید همچنان چراغ چشمان‌مان و راه انتظار برای دیدن دوست را روشن نگه داریم."],[59,"کحل الجواهری به من آر ای نسیم صبح","زان خاک نیکبخت که شد رهگذار دوست","ای نسیم صبح، به من کحل جواهر (سرمه‌ای ارزشمند) بیاور، چون آن خاک نیکبخت را که راهی برای رسیدن به دوست شد."],[59,"ماییم و آستانه عشق و سر نیاز","تا خواب خوش که را برد اندر کنار دوست","ما در آستانه عشق و با دل‌نهادن به راز و نیاز هستیم تا خواب خوشی که در کنار دوست نصیب چه کسی خواهد شد."],[59,"دشمن به قصد حافظ اگر دم زند چه باک؟","منّت خدای را که نیم شرمسار دوست","اگر دشمن به نیابت از حافظ، حرفی بزند یا به او آسیب بزند، نگران نباش. سپاس خدا را که من از دوست خود خجالت‌زده نیستم."],[60,"صبا اگر گذری افتدت به کشور دوست","بیار نفحه‌ای از گیسوی معنبر دوست","ای نسیم صبا، اگر از دیار یار گذر کردی، برایم عطری از گیسوی یار به‌ارمغان بیاور."],[60,"به جان او که به شکرانه جان برافشانم","اگر به سوی من آری پیامی از بر دوست","به جان عزیز او، اگر پیامی از او برایم بیاوری جان را به شکرانه می‌بخشم."],[60,"و گر چنان که در آن حضرتت نباشد بار","برای دیده بیاور غباری از در دوست","اگر نتوانستی به دیدارش بروی؛ برای چشمم از خاک در او غبار بیاور تا توتیای چشمم کنم."],[60,"من گدا و تمنای وصل او هیهات","مگر به خواب ببینم خیال منظر دوست","من گدا کجا و آرزوی وصال او کجا!؟ مگر در خواب روی زیبای او را ببینم."],[60,"دل صنوبری‌ام همچو بید لرزان است","ز حسرت قد و بالای چون صنوبر دوست","قلبم در سینه همچون درخت بید لرزان و مضطرب است؛ از حسرت قد و بالای همچون درخت صنوبر یار."],[60,"اگر چه دوست به چیزی نمی‌خرد ما را","به عالمی نفروشیم مویی از سر دوست","اگرچه دوست به ما کمترین نگاهی نمی‌کند اما مویی از سر او را به‌دنیا نمی‌فروشیم."],[60,"چه باشد ار شود از بند غم دلش آزاد","چو هست حافظ مسکین غلام و چاکر دوست","چه می‌شود اگر روزی دل دردمند حافظ، که بنده یار است، از غم آزاد شود."],[61,"مرحبا ای پیک مشتاقان بده پیغام دوست","تا کنم جان از سر رغبت فدای نام دوست","ای پیک افرادی که عشق را تجربه کرده‌اند، خوش آمدی؛ پیغام دوست را برای من بیاور. من حاضرم جانم را با کمال رغبت برای نام دوست فدای کنم."],[61,"واله و شیداست دایم همچو بلبل در قفس","طوطی طبعم ز عشق شکّر و بادام دوست","من همیشه در حال عشق و شیدایی هستم، مانند بلبل در قفس که از عشق می‌خواند. ذوق و طبع من از عشق و محبت به معشوقی که شیرینی و لذت را به من می‌دهد، سرشار است."],[61,"زلف او دام است و خالش دانه آن دام و من","بر امید دانه‌ای افتاده‌ام در دام دوست","زلف معشوق مانند دام الجلبی است و جای زلف‌های او، خالی که به آن دانه گفته می‌شود، به معنای جذبه و عشق است. من در انتظار صندوقه و دلبر، به عشق او در این دام گرفتار شده‌ام."],[61,"سر ز مستی برنگیرد تا به صبح روز حشر","هر که چون من در ازل یک جرعه خورد از جام دوست","هر کسی که در آغاز هستی یک جرعه از محبت دوست را چشیده، تا روز قیامت از سر شوق و مستی به خود نخواهد آمد و از این حال نخواهد برخاست."],[61,"بس نگویم شمّه‌ای از شرح شوق خود از آنک","دردسر باشد نمودن بیش از این ابرام دوست","می‌گویم هرگز نمی‌توانم کمی از احساس شوق خود را توضیح دهم، زیرا گفتن بیش از این، به وجود آوردن دردسر ناشی از اصرار و پایبندی به دوست خواهد بود."],[61,"گر دهد دستم کشم در دیده همچون توتیا","خاک راهی کـ‌آن مشرف گردد از اقدام دوست","اگر دستم به چیزی برسد، آن را مانند پودر توتیا (پودر سفیدی که در چشمان می‌ریزند) در چشمانم می‌کشم تا خاکی از راهی به دست آورم که با گام‌های دوست تبرک شود."],[61,"میل من سوی وصال و قصد او سوی فراق","ترک کام خود گرفتم تا برآید کام دوست","من تمایل دارم که به وصال محبوب برسم، اما او قصد جدایی دارد. من به خاطر خوشحال کردن او از خواسته‌های خود صرف‌نظر کرده‌ام تا او به خواسته‌هایش برسد."],[61,"حافظ اندر درد او می‌سوز و بی‌درمان بساز","زان که درمانی ندارد درد بی‌آرام دوست","حافظ از درد عشق و غم معشوق می‌سوزد و به همین درد نشستن را به درمان ناپذیری آن ترجیح می‌دهد، زیرا درد دوست که بی‌قراری و آرامش را به همراه دارد، هیچ درمانی ندارد."],[62,"روی تو کس ندید و هزارت رقیب هست","در غنچه‌ای هنوز و صدت عندلیب هست","هنوز کسی آن‌گونه که باید چهره تو را ندیده است، اما هزاران رقیب و عاشق در قصد رسیدن به تو هستند. تو هنوز همچون غنچه‌ای شکفته نشده‌ای، ولی صدها بلبل عاشق در هوای تو نغمه‌سرایی می‌کنند."],[62,"گر آمدم به کوی تو چندان غریب نیست","چون من در آن دیار هزاران غریب هست","اگر من هم به کوی تو آمده‌ام، چندان جای تعجب ندارد؛ زیرا در سرزمین تو هزاران عاشق غریب و آواره وجود دارند."],[62,"در عشق، خانقاه و خرابات فرق نیست","هر جا که هست پرتو روی حبیب هست","در عالم عشق، میان خانقاه و خرابات تفاوتی وجود ندارد؛ زیرا هر جا که باشی، اگر نور چهره محبوب بتابد، همان‌جا جای حضور اوست."],[62,"آن جا که کار صومعه را جلوه می‌دهند","ناقوس دیر راهب و نام صلیب هست","در جایی که صومعه را به‌عنوان محل عبادت و جلوه‌گاه دینداری معرفی می‌کنند، صدای ناقوس دیر راهبان و نشانه‌های مسیحیت نیز حضور دارد."],[62,"عاشق که شد که یار به حالش نظر نکرد","ای خواجه درد نیست وگرنه طبیب هست","کدام عاشقی بوده که به عشق گرفتار شده باشد و محبوب به حال او توجهی نکرده باشد؟ ای خواجه! اگر دردی وجود داشته باشد، طبیب هم هست؛ مشکل اینجاست که تو هنوز درد واقعی عشق را احساس نکرده‌ای."],[62,"فریاد حافظ این همه آخر به هرزه نیست","هم قصه‌ای غریب و حدیثی عجیب هست","فریادها و ناله‌های حافظ بیهوده و بی‌دلیل نیست؛ حتما در پس این سخنان، داستانی شگفت و رازی عجیب نهفته است."],[63,"اگر چه عرض هنر پیش یار بی‌ادبی‌ست","زبان خموش، ولیکن دهان پر از عربی‌ست","اگرچه بیان هنر در برابر یار دل ربا بی‌ادبی محسوب می‌شود پس بهتر است زبان را ببندیم،و این درحالیست که در زبان آوری هنرمند و ماهر هستیم و در دل احساسات و افکار واژه‌های زیبا و ادبی فراوان داریم."],[63,"پری نهفته رخ و دیو در کرشمه حسن","بسوخت دیده ز حیرت که این چه بوالعجبی‌ست","زیبایی پنهان یک پری (دختر زیبا) و در عوض، زشتی یک دیو (موجود زشت) در جذابیت و فریبندگی این زیبایی چنان است که چشمان انسان از حیرت سوخته و ناباور مانده‌اند. این زیبایی و زشتی به یکدیگر در تناقض است و حیرت‌آور به نظر می‌رسد."],[63,"در این چمن گل بی خار کس نچید، آری","چراغ مصطفوی با شرار بولهبی‌ست","در این باغ، هیچ‌کس گلی که خار نداشته باشد چیده نمی‌شود. یعنی نور و جمال حضرت محمد (مصطفی) با آتش و زشتی ابن‌ملجم (بولهب) در تضاد است و نمی‌توان آنها را با هم مقایسه کرد."],[63,"سبب مپرس که چرخ از چه سفله‌پرور شد","که کام‌بخشی او را بهانه بی‌سببی‌ست","علت اینکه سرنوشت انسان‌ها به گونه‌ای است که بعضی از افراد بی‌لیاقت و پست به مقام و منزلت می‌رسند را نپرس، زیرا اینکه او (چرخ) به این افراد خوشبختی و کامیابی می‌دهد، خود یک موضوع بی‌دلیلی است."],[63,"به نیم جو نخرم طاق خانقاه و رباط","مرا که مصطبه ایوان و پای خم طنبی‌ست","برای خرید طاق خانقاه و رباط، حتی نیم جو هم نمی‌دهم، زیرا در ایوان آن‌جا تنها مصطبه (نشسته‌گاه) و پای خم (شراب‌نوشی) وجود دارد که برای من بی‌فایده است."],[63,"جمال دختر رز، نور چشم ماست مگر","که در نقاب زجاجی و پرده عنبی‌ست","بی‌شک زیبایی می روشنی بخش چشم ماست که در نقاب بلورین و پس پرده‌ای شفاف قرار گرفته"],[63,"هزار عقل و ادب داشتم من ای خواجه","کنون که مست خرابم، صلاح بی‌ادبی‌ست","من سال‌ها عقل و ادب داشتم و تحصیلات زیادی کرده بودم، اما اکنون که در حالت مستی و خرابی هستم، به نظرم بهتر است بی‌ادب و بی‌پروایی کنم."],[63,"بیار می که چو حافظ هزارم استظهار","به گریه سحری و نیاز نیم‌شبی‌ست","بیا شراب بیاور زیرا که حافظ هزار بار از آن بهره‌برده است؛ گریه‌های سحرگاهی و درخواست‌های شبانه نشان‌دهنده حال ناامیدی و نیاز من است."],[64,"خوش‌تر ز عیش و صحبت و باغ و بهار چیست؟","ساقی کجاست؟ گو سبب انتظار چیست؟","هیچ چیز از شادی و خوشی، مثل لحظه‌های ناب دوستانه، نشستن در باغ و لذت بردن از بهار، روح‌نوازتر نیست. ساقی کجاست که به ما برسد و ما را از این انتظار دور کند؟"],[64,"هر وقت خوش که دست دهد، مغتنم شمار","کس را وقوف نیست که انجام کار چیست","هر زمان که فرصت خوشی پیش بیاید، باید آن را غنیمت شمرد؛ زیرا هیچ‌کس نمی‌داند سرانجام کارها چه خواهد بود."],[64,"پیوند عمر بسته به مویی‌ست، هوش دار","غمخوار خویش باش، غم روزگار چیست؟","عمر آدمی به یک رشته نازک شبیه است و ممکن است به راحتی قطع شود، بنابراین باید از خود و حال خوبش مراقبت کند و نگران مشکلات و غم‌های زندگی نباشد."],[64,"معنی آب زندگی و روضه ارم","جز طرف جویبار و می خوشگوار چیست؟","معنای آب حیات و باغ ارم، که نشانه‌هایی از خوشی و سعادت است، جز طعم گوارای چشمه و شراب چه ارزش دیگری دارد؟"],[64,"مستور و مست هر دو چو از یک قبیله‌اند","ما دل به عشوه که دهیم؟ اختیار چیست؟","مستور و مست (مست‌نشین و کسی که خود را پنهان کرده) هر دو از یک دسته هستند، بنابراین ما باید به چه کسی که با ناز و عشوه رفتار می‌کند، دل بسپاریم؟ در این وضعیت، اختیار و انتخاب ما چه معنایی دارد؟"],[64,"راز درون پرده چه داند فلک؟ خموش","ای مدعی! نزاع تو با پرده‌دار چیست؟","فلک (آسمان) از رازهای پنهان درون پرده (وجود انسان) اطلاعی ندارد. ای مدعی! چرا در برابر پرده‌دار (خدا یا صاحب رازها) این‌قدر دعاوی و نزاع می‌کنی؟"],[64,"سهو و خطای بنده گرش اعتبار نیست","معنی عفو و رحمت آمرزگار چیست؟","خطا و اشتباهات من اگر اهمیتی ندارند، پس معنی بخشش و رحمت خداوند چیست؟"],[64,"زاهد شراب کوثر و حافظ پیاله خواست","تا در میانه خواسته کردگار چیست","میان زهد خشک و عشق الهی، خداوند بیشتر دل عاشق و آگاه را می‌پسندد. حافظ در این بیت، به ما می‌آموزد که اصل طلب حقیقت و قرب الهی، در عشق و آگاهی است، نه در ظاهر دین و زهد خشک. پیاله حافظ نماد دل عاشق و روح آگاه است، که با جرعه‌ای از معرفت و حضور الهی، به حقیقت نزدیک می‌شود، در حالی که زهد ظاهری ممکن است تنها به شکل رعایت قواعد و ترس از عقوبت باقی بماند."],[65,"بنال بلبل اگر با منت سر یاری‌ست","که ما دو عاشق زاریم و کار ما زاری‌ست","ای بلبل، اگر قصد یاری و همدلی با من را داری، ناله سر کن؛ زیرا ما هر دو عاشقانی درمانده و نالانیم و کار عاشق زاری کردن است. (بلبل در شعر فارسی نماد عاشق و ناله و آواز او نشانه‌ای از عشق و بی‌قراری است. بلبل عاشق گل است و شاعر عاشق معشوق خویش؛ از این رو شاعر به سبب این هم‌سرنوشتی، بلبل را به زاری و ناله دعوت می‌کند.)"],[65,"در آن زمین که نسیمی وزد ز طرّه دوست","چه جای دم زدن نافه‌های تاتاری‌ست","در آن زمین که نسیمی از گیسوی دوست می‌وزد و عطر و بوی آن را با خود می‌آورد، دیگر جایی برای خودنمایی و عرض‌اندام مشک‌های خوش‌بوی تاتاری نیست؛ چراکه در برابر عطر گیسوی دوست، حتی مشک تاتاری نیز جلوه و اعتباری ندارد. (نافه، کیسه‌ای از مشک است که از ناف آهوی مشکین به دست می‌آید و «نافه‌های تاتاری» اشاره به مشک و عطر خوش‌بوی سرزمین تاتار دارد که در شعر فارسی نماد عطری بسیار خوش و ارزشمند است.)"],[65,"بیار باده که رنگین کنیم جامه زرق","که مست جام غروریم و نام هشیاری‌ست","باده بیاور تا جامه زرق‌فام را رنگین کنیم، زیرا ما از شراب غرور سیراب شده‌ایم و دیگر هشیار نیستیم."],[65,"خیال زلف تو پختن نه کار هر خامی‌ست","که زیر سلسله رفتن طریق عیّاری‌ست","تصویر زلف تو را در خاطر پروراندن کار آسانی نیست و تنها افراد نادان و خام می‌توانند چنین کنند، زیرا به دست آوردن عشق و دل‌بردن از محبوب، نیازمند تجربیات و مهارت‌های خاصی است."],[65,"لطیفه‌ای‌ست نهانی که عشق از او خیزد","که نام آن نه لب لعل و خط زنگاری‌ست","رازی ظریف وجود دارد که عشق از آن سرچشمه می‌گیرد، و این راز به عبارت‌های معمولی مثل رنگ لب یا خط زیبایی اشاره نمی‌کند."],[65,"جمال شخص، نه چشم است و زلف و عارض و خال","هزار نکته در این کار و بار دلداری‌ست","زیبایی واقعی یک فرد فقط به چشم‌ها، مو، صورت و خال او محدود نمی‌شود؛ بلکه هزاران نکته و راز در عشق و دلداری وجود دارد که نشان‌دهنده عمق و پیچیدگی این احساس است."],[65,"قلندران حقیقت به نیم جو نخرند","قبای اطلس آن کس که از هنر عاری‌ست","صوفی‌ها و حقیقت‌جویان، به بهای ناچیز، هرگز لباس نفیس و باارزش را نمی‌خرند؛ زیرا کسی که از استعداد و هنر بی‌بهره باشد، سزاوار آن لباس نیست."],[65,"بر آستان تو مشکل توان رسید آری","عروج بر فلک سروری به دشواری‌ست","رسیدن به درگاه تو کار آسانی نیست، زیرا بالا رفتن و رسیدن به مقام و مرتبه‌ای والا بسیار سخت و دشوار است."],[65,"سحر کرشمه چشمت به خواب می‌دیدم","زهی مراتب خوابی که به ز بیداری‌ست","در سحرگاه، زیبایی و جاذبه چشمانت را در خواب می‌دیدم، که چه خوب و دلپذیر است و حتی بهتر از بیداری است."],[65,"دلش به ناله میازار و ختم کن حافظ","که رستگاری جاوید در کم آزاری‌ست","دلش را از ناله و آزار خالی کن و در پایان با حافظ بگو که نجات ابدی در کم‌آزاری و بی‌دردی است."],[66,"یا رب! این شمع دل‌افروز ز کاشانه کیست؟","جان ما سوخت، بپرسید که جانانه کیست؟","پروردگارا! این شمع شادی‌بخش، متعلق به کدام خانه است؟ جان ما در آتش عشق او سوخت، از او بپرسید که معشوقه‌‌ی کیست؟"],[66,"حالیا خانه‌برانداز دل و دین من است","تا در آغوش که می‌خسبد و هم‌خانه کیست؟","اکنون کسی که در آغوش او می‌خوابد، چنان تاثیر عمیقی بر من گذاشته که باعث آسیب به دل و دین من شده است؛ پس مشخص نیست آن شخص کیست و چه جایگاهی دارد."],[66,"باده لعل لبش کز لب من دور مباد","راح روح که و پیمان‌ده پیمانه کیست؟","لب همچون شراب سرخ او که آرزو دارم از لب من دور نباشد، مایه نشاط و متعهد به چه کسی است؟ (پیمان‌ده پیمانه کنایه از وفادار و عهدبسته بودن)"],[66,"دولت صحبت آن شمع سعادت‌پرتو","باز پرسید خدا را که به پروانه کیست؟","به خدا قسم‌ بپرسید که سعادت همنشینی با آن شمع نکو طالع نصیب کدام پروانه شده است.(شمع استعاره از معشوق و پروانه استعاره از عاشق است)"],[66,"می‌دهد هر کسش افسونی و معلوم نشد","که دل نازک او مایل افسانه کیست؟","هر کسی برای او جادو و افسون خاصی دارد، اما معلوم نیست که دل حساس و لطیف او به چه قصه یا افسانه‌ای تمایل دارد."],[66,"یا رب آن شاه‌وش ماه‌رخ زهره‌جبین","درّ یکتای که و گوهر یک‌دانه کیست؟","ای خدا، آن پادشاه با چهره‌ی ماهی و پیشانی چون زهره، که همانند درّ گرانبهایی است، دردانه ی چه کسی است؟"],[66,"گفتم «آه از دل دیوانه حافظ بی‌تو»","زیر لب خنده‌زنان گفت که «دیوانه کیست؟»","حافظ در دل به خاطر نبودن محبوبش آه می‌کشد، اما در عین حال با لبخند به این نکته اشاره می‌کند که دیوانگی بدون عشق چه معنایی دارد و در اصل به نوعی به دیوانگی خودش می‌خندد."],[67,"ماهم این هفته برون رفت و به چشمم سالی‌ست","حال هجران تو چه دانی که چه مشکل حالی‌ست؟","ماه من (دلبر من) فقط یک هفته است که رفته اما به چشمم سالی گذشت (معنای دوم: این ماه این هفته تمام شد و به نظرم رسید که این یک ماه یک سال طول کشید). تو چه می‌دانی که حال دوری از یار چه حالی است؟"],[67,"مردم دیده ز لطف رخ او در رخ او","عکس خود دید، گمان برد که مشکین خالی‌ست","رخش چنان لطیف و زلال و پاک بود که مردمک دیده، تصویر خود را در آن دید و پنداشت که خالی مشکین و سیاه بر رخ او دیده است."],[67,"می‌چکد شیر هنوز از لب هم‌چون شکرش","گر چه در شیوه‌گری هر مژه‌اش قتّالی‌ست","آنقدر بچه است که هنوز از دهنش شیر می‌چکد اگر چه به قدر یک قاتل حرفه‌ای در کار دلبری حرفه‌ای است."],[67,"ای که انگشت‌نمایی به کرم در همه شهر","وه که در کار غریبان، عجبت اهمالی‌ست","ای که در کل شهر به بذل و بخشش مشهوری، چرا در حق غریبان کوتاهی می‌کنی؟"],[67,"بعد از اینم نبود شائبه در جوهر فرد","که دهان تو در این نکته خوش استدلالی‌ست","هرچه از «گوهر یگانه» شنیدم (شک داشتم) تا آنکه دهان تو را دیدم و پس از آن برایم تردیدی در وجود آن باقی نماند."],[67,"مژده دادند که بر ما گذری خواهی کرد","نیّت خیر مگردان که مبارک فالی‌ست","مژده دادند که می‌خواهی سری به ما بزنی. از این تصمیم خوبت پشیمان نشو که خوش‌یمن است."],[67,"کوه اندوه فراقت به چه حالت بکشد؟","حافظ خسته که از ناله تنش چون نالی‌ست","بار غم سخت جدایی تورا چگونه به دوش بکشم؟؟ منی که تنم همچون نی از ناله، ناتوان و خسته هست."],[68,"کس نیست که افتاده آن زلف دوتا نیست","در رهگذر کیست که دامی ز بلا نیست","هیچ‌کس نیست که زلف‌های دوتای او را ببیند و عاشق و گرفتارش نشود؛ همچون بلا که سر راه همه هست. (زلف دو تا‌: گیسوی بافته که بر طرفین گردن و سینه می‌افتد)"],[68,"چون چشم تو دل می‌برد از گوشه نشینان","همراه تو بودن گنه از جانب ما نیست","چشم تو آنقدر زیباست که دل همه را می‌برد، و اگر ما دوست داریم در کنار تو باشیم، این را نمی‌توان به حساب گناه ما گذاشت."],[68,"روی تو مگر آینه لطف الهیست","حقا که چنین است و در این روی و ریا نیست","چهره تو آیا نشانه‌ای از رحمت خداوند است؟ واقعا همین‌طور است و در این چهره زیبا و نیکویی، هیچ تزویر و فریبی وجود ندارد."],[68,"نرگس طلبد شیوه چشم تو، زهی چشم","مسکین خبرش از سر و، در دیده حیا نیست","نرگس (گلی زیبا) به دنبال شیوه نگاه توست، ای چشمان زیبا! امان از چشمان مسکین که هیچ اطلاعی از راز و حیا ندارند و فقط در دیده آنها شرم وجود ندارد."],[68,"از بهر خدا زلف مپیرای که ما را","شب نیست که صد عربده با باد صبا نیست","برای خاطر خدا موهایت را پریشان مکن، چرا که ما شبی نداریم (که از روی حسادت) با باد صبا‌، عربده و جنگ نداشته‌باشیم."],[68,"بازآی که بی روی تو ای شمع دل افروز","در بزم حریفان، اثر نور و صفا نیست","ای شمع دل‌افروز، برگرد که بدون تو در مجالس و دورهمی‌ها جایی از روشنی و زیبایی وجود ندارد."],[68,"تیمار غریبان اثر ذکر جمیل است","جانا مگر این قاعده در شهر شما نیست؟","تیمار و مراقبت از غریبان بر اثر یاد و ذکر زیبا و خوش است، ای محبوب، مگر این قاعده و رسم در شهر شما وجود ندارد؟"],[68,"دی می‌شد و گفتم صنما عهد به جای آر","گفتا غلطی خواجه در این عهد وفا نیست","دیشب به محبوبم گفتم که در این رابطه به عهد و پیمان وفا کن. او پاسخ داد که خواجه، در این زمانه، عهد وفا وجود ندارد و این حرف تو اشتباه است."],[68,"گر پیر مغان مرشد من شد چه تفاوت","در هیچ سری نیست که سرّی ز خدا نیست","اگر پیر مغان (رئیس جمعیت درویشان) معلم من شود، تفاوتی نمی‌کند، زیرا در هیچ انسانی رازی نیست که از خداوند ناشناخته باشد."],[68,"عاشق چه کند گر نکشد بار ملامت","با هیچ دلاور سپر تیر قضا نیست","عاشق چه می‌تواند بکند اگر بار سرزنش را بر دوش بکشد، زیرا هیچ دلاوری نمی‌تواند در برابر تیر تقدیر و سرنوشت از خود دفاع کند."],[68,"در صومعه زاهد و در خلوت صوفی","جز گوشه ابروی تو محراب دعا نیست","در محل عبادت زاهدان و در تنهایی صوفیان، تنها چیزی که موجب توجه و دعا می‌شود، ابروی معشوق تو است و هیچ چیز دیگری اهمیت ندارد."],[68,"ای چنگ فروبرده به خون دل حافظ","فکرت مگر از غیرت قرآن و خدا نیست","ای چنگی که دل حافظ را به درد آورده‌ای، آیا تفکر تو ناشی از غیرت قرآن و خدا نیست؟"],[69,"مردم دیده ما جز به رخت ناظر نیست","دل سرگشته ما غیر تو را ذاکر نیست","چشمهای ما تنها به چهره تو می نگرند و دل سرگشته ما فقط به یاد تو هست"],[69,"اشکم احرام طواف حرمت می‌بندد","گرچه از خون دل ریش دمی طاهر نیست","اشک‌های من مانند لباس احرام (لباس مخصوص حاجیان) است که برای دور زدن گرد خانه تو (کعبه) می‌بندم، هرچند این اشک‌ها از دل خونینم می‌ریزد و بنابراین پاک نیستند."],[69,"بسته دام و قفس باد چو مرغ وحشی","طایر سدره اگر در طلبت طایر نیست","هرچند من در قید و بند دنیای مادی هستم و همچون پرنده‌ای وحشی در دام و قفسی گرفتارم، اما اگر در طلب تو، ای معشوق (که به سدره اشاره دارد)، پرنده‌ای وجود نداشته باشد، به این قید و بند‌ها اهمیتی نمی‌دهم."],[69,"عاشق مفلس اگر قلب دلش کرد نثار","مکنش عیب که بر نقد روان قادر نیست","عاشق بی‌پول اگر قلبش را به عشق تو تقدیم کند، نباید او را سرزنش کنی؛ چرا که او توانایی پرداختن عشق را در وجودش ندارد."],[69,"عاقبت دست بدان سرو بلندش برسد","هر که را در طلبت همت او قاصر نیست","هر کسی که در آرزوی تو تلاش کند و در این راه سستی نکند، در نهایت به دست آن سرو بلند (یعنی محبوب) خواهد رسید."],[69,"از روان بخشی عیسی نزنم دم هرگز","زان که در روح فزایی چو لبت ماهر نیست","هرگز نمی‌توانم از روح‌بخش بودن عیسی، دم بزنم یا سخن بگویم، چون اگر تو مانند لب‌هایش که زیبایی خاصی دارد، در فزایش و رشد روحی موثر نباشی، صحبت کردن از آن بی‌فایده است."],[69,"من که در آتش سودای تو آهی نزنم","کی توان گفت که بر داغ، دلم صابر نیست","من در آتش عشق تو هرگز آه و ناله‌ای نمی‌کنم، چگونه می‌توان گفت که دلم بر اثر این درد، صبر و تحمل دارد؟"],[69,"روز اول که سر زلف تو دیدم گفتم","که پریشانی این سلسله را آخر نیست","در روز اول که موهایت را دیدم، به خودم گفتم که این پریشانی و بی‌نظمی موهایت هیچ‌گاه پایان ندارد."],[69,"سر پیوند تو تنها نه دل حافظ راست","کیست آن کش سر پیوند تو در خاطر نیست","دل حافظ تنها عاشق تو نیست؛ بلکه هر کسی که به یاد و خاطر تو باشد، دلی دارد که به پیوند تو وابسته است."],[70,"زاهد ظاهرپرست از حال ما، آگاه نیست","در حق ما، هرچه گوید، جای هیچ اکراه نیست","کسی که فقط به ظاهر عبادت، دین‌داری و رفتار آدم‌ها نگاه می‌کند، نمی‌تواند حال عاشقانه، عرفانی و باطنی ما را بفهمد. پس اگر ما را سرزنش کند یا درباره‌مان قضاوتی کند، مهم نیست؛ چون از حقیقت ما آگاه نیست."],[70,"در طریقت هرچه پیش سالک آید، خیر اوست","در صراط مستقیم، ای دل، کسی گمراه نیست","در آیین طریقت، چنین است که هرچه برای سالک پیش بیاید آن‌را خیر و صلاح خود می‌بیند؛ ای جان من، کسی که بر صراط مستقیم است گمراه نیست!"],[70,"تا چه بازی رخ نماید بیدقی خواهیم راند","عرصه‌ی شطرنج رندان را مجال شاه نیست","تا ببینیم در نهایت چه خواهد شد و تا آن‌زمان مهره کم‌ارزشی را در این بازی شطرنج جابجا می‌کنیم و به بازی ادامه می‌دهیم در شطرنج انسانهای رندوم زیرک، حتی شاه فرصتی برای خودنمایی نمی‌یابد. (رخ‌، بیذق (سرباز)، و شاه هرسه مهره‌های بازی شطرنج هستند)"],[70,"چیست این سقف بلند ساده بسیارنقش؟","زین معمّا، هیچ دانا در جهان، آگاه نیست","خدا می‌داند که این آسمان (و هستی) ساده و در عین حال پر نقش و نگار چیست! هیچ دانایی در جهان به راز چیستی آن آگاه نشده است."],[70,"این چه استغناست یا رب؟ وین چه قادر حکمت است؟","کاین‌همه زخم نهان است و مجال آه نیست","یارب، این چه قدرت استغنا (از اصطلاحات طریقت است) مراست و این چه قادر حکمت است که این همه درد و زخم نهانی وجود دارد اما شکوه و گلایه‌ای نیست."],[70,"صاحب دیوان ما گویی نمی‌داند حساب","کاندر این طغرا، نشان حسبة للّه نیست","فرشته نویسنده دیوان اعمال ما گویی حساب و کتاب نمی‌داند کاندر این طغرا نشان حسبة للّه نیست."],[70,"هر که خواهد گو: «بیا!» و هرچه خواهد گو: «بگو!»","کبر و ناز و حاجب و دربان، بدین درگاه نیست","هرکسی هرچه درباره ما می‌خواهد بگوید، بگوید؛ در درگاه ما غرور و ناز و نگهبان و خودپرستی جایی ندارد."],[70,"بر در میخانه رفتن، کار یکرنگان بود","خودفروشان را به کوی می‌فروشان، راه نیست","به میخانه رفتن کار آدم‌های یک‌رنگ و صادق است آدم‌های خود‌فروش در میان آدم‌های یکرنگ و صاف جایی ندارند."],[70,"هرچه هست از قامت ناساز بی‌اندام ماست","ور نه تشریف تو، بر بالای کس، کوتاه نیست","هر ایرادی هست از ماست و از خود ماست وگرنه لطف تو به هیچ‌کس کوتاهی نکرده است."],[70,"بنده‌ی پیر خراباتم که لطفش، دائم است","ور نه لطف شیخ و زاهد، گاه هست و گاه نیست","بنده پیر می‌فروش خرابات هستم که لطف و مهربانی او دایمی است؛ لطف و مهر شیخ و زاهد‌، اتفاقی و گذراست."],[70,"«حافظ»، ار بر صدر ننشیند، ز عالی‌مشربی‌ست","عاشق دردی‌کش اندر بند مال و جاه نیست","اگر حافظ در مجلس می‌گساری بر صدر نمی‌نشیند از آن است که بلند‌نظر است؛ عاشق دردی‌کش به مال و مقام بی‌اعتناست."],[71,"راهی‌ست راه عشق که هیچش کناره نیست","آن‌جا جز آن‌که جان بسپارند، چاره نیست","راه عشق، راهی بی‌پایان و بیابانی بی‌انتهاست که مقصد این سفر جز جان باختن نیست. (کناره‌: نهایت‌، پایان)"],[71,"هر گه که دل به عشق دهی، خوش دمی بود","در کار خیر، حاجت هیچ استخاره نیست","هر گاه که عشق به تو روی می‌آورد خوب و نیکو است. وقتی که قصد کار خیری داری، نیازی به استخاره گرفتن نیست و باید آن کار را انجام دهی چون خیر و خوب است."],[71,"ما را ز منع عقل مترسان و می بیار!","کآن شحنه در ولایت ما، هیچ کاره نیست","ما عاشقان و رندان را از بازدارندگی عقل مترسان. چرا که آن پاسبان (شحنه) در شهر و دیار ما کاره‌ای نیست. در این‌جا شحنه (پاسبان) کنایه از عقل است."],[71,"از چشم خود بپرس که ما را که می‌کشد؟","جانا، گناه طالع و جرم ستاره نیست","جادو و جاذبه چشمان تو است که مرا را هلاک و از خود بی‌خود می‌کند. تقصیر سرنوشت و تاثیر ستارگان نیست [که مرا به این حال و روز مبتلا کرده است]. - یا: گناه قتل مرا به گردن طالع و سرنوشت مینداز؛ آنچه مرا می‌کشد چشمان زیبای توست."],[71,"او را به چشم پاک، توان دید چون هلال","هر دیده، جای جلوه آن ماه‌پاره نیست","برای دیدن معشوق باید چشمان پاکی داشت (او در چشم ناپاک نمی‌نشیند) مثل هلال عید [که برای دیدنش باید واجد شرایط بود]. هر چشمی شایستگی دیدن روی آن تکه‌ماه را ندارد."],[71,"فرصت شمر طریقه رندی که این نشان","چون راه گنج، بر همه‌کس، آشکاره نیست","مرام و مسلک رندی را مغتنم شمار (حرمت آن را نگه دار)، چرا که این راه مثل نقشه گنجی که هر کسی از آن خبر ندارد."],[71,"نگرفت در تو، گریه «حافظ»، به هیچ رو","حیران آن دلم که کم از سنگ خاره نیست","گریه حافظ به هیچ وجه بر تو اثربخش نبود (نتوانست دل سخت تو را نرم کند). متحیّر و متعجّب مانده‌ام که چقدر تو سنگ‌دلی! (دل تو گویی که چیزی کم‌تر از سنگ خارا ندارد!)"],[72,"روشن از پرتو رویت نظری نیست که نیست","منّت خاک درت بر بصری نیست که نیست","نور چهره‌­ی تو، تمام دیده‌­ها را روشن کرده است، احسان و نیکی خاک درگاه تو مانند توتیا شفابخش هر دیده­‌ای است."],[72,"ناظر روی تو صاحب نظرانند آری","سرّ گیسوی تو در هیچ سری نیست که نیست","تنها انسان­‌های اهل بصیرت و صاحب نظر به چهره‌­ی تو نگاه می­‌کنند؛ آری، رمز و راز وجود تو همچون گیسو در سر همه وجود دارد."],[72,"اشک غمّاز من ار سرخ برآمد چه عجب؟","خجل از کرده خود پرده دری نیست که نیست","جای شگفتی نیست، اگر اشک سخن‌­چین من، سرخ و خونین فرو ریخت؛ زیرا هر کس راز دیگران را برملا سازد، از کرده­‌ی خود شرمسار و پشیمان خواهد شد."],[72,"تا به دامن ننشیند ز نسیمش گردی","سیل خیز از نظرم ره‌گذری نیست که نیست","اگر می‌­بینید تمام مسیرهای عبور و مرور از اشک­‌های سیل­‌خیز من خیس شده است، به خاطر این است که تا گرد و غباری از وزش نسیم بر دامن معشوق ننشیند."],[72,"تا دم از شام سر زلف تو هر جا نزنند","با صبا گفت و شنیدم سحری نیست که نیست","برای اینکه باد صبا، از سیاهی گیسوی همچون شب تو هر جا سخنی نگوید و در مورد آن صحبت نکند، هر سحر با آن مشغول مجادله و بحث و جدل هستم."],[72,"من از این طالع شوریده برنجم ور نی","بهره‌مند از سر کویت دگری نیست که نیست","اگر من از وصال تو محرومم دلیلی جز بخت و اقبال بد خودم ندارد، و الا همه از وصال تو بهره‌­مند و برخودار گشته‌­اند."],[72,"از حیای لب شیرین تو ای چشمه نوش","غرق آب و عرق اکنون شکری نیست که نیست","ای معشوقی که همچون چشمه­ ای گوارا نوشیدنی هستی، اگر می­‌بینی شکر غرق آب و عرق می‌­شود و آب می­‌شود، بدین سبب است که شکر ، شیرینی خود را با لب شیرین تو مقایسه کرده است و اکنون از شدت شرمساری آب شده است."],[72,"مصلحت نیست که از پرده برون افتد راز","ور نه در مجلس رندان خبری نیست که نیست","هر چند رندان بر همه­‌ی رازها آگاهند و تمام اسرار را می‌­دانند اما صلاح نمی­‌بینند که اسرار نهانی را آشکار کنند و پرده از حقیقت ماجرا کنار بزنند."],[72,"شیر در بادیه عشق تو روباه شود","آه از این راه که در وی خطری نیست که نیست","ای معشوق، شیر که نماد شجاعت و بی­باکی است در بیابان عشق تو همچون روباه ترسو و رمنده می­‌شود؛ آه از این راه عشق تو که بیمناک است و هر گونه خطری در آن وجود دارد."],[72,"آب چشمم که بر او منّت خاک در توست","زیر صد منّت او خاک دری نیست که نیست","چشمم که از خاک درگاه تو بسی منت دارد و آن را سرمه‌­ی خود می‌­کند، در آرزوی رسیدن به تو بر در هر آستانی گریسته است و خاک درگاهی نیست که زیر بار منت اشک چشمم نباشد."],[72,"از وجودم قدری نام و نشان هست که هست","ور نه از ضعف در آن جا اثری نیست که نیست","از وجودم آن اندازه نام و نشان باقی مانده است که بتوان ادعا کرد هنوز هستم و زنده‌­ام، و گرنه در این جسم نحیف و زار همه نوع ضعف و ناتوانی وجود دارد."],[72,"غیر از این نکته که حافظ ز تو ناخشنود است","در سراپای وجودت هنری نیست که نیست","ای معشوق سراپای وجودت سرشار از هنر و خوبی است و تنها یک هنر باقی مانده است و آن رضایت و خشنودی حافظ است؛ به عبارت دیگر: همه وجودت پر از کمال حسن و دلبری است، جز اینکه با من ناسازگاری و سر مهر نداری."],[73,"حاصل کارگه کون و مکان این همه نیست","باده پیش آر که اسباب جهان این همه نیست","هدف و نتیجه وجود و زندگی این دنیا به این گستردگی نیست، بنابراین باده را بیاور، زیرا وسایل و ابزار دنیا به این اندازه اهمیت ندارند."],[73,"از دل و جان شرف صحبت جانان غرض است","غرض این است، وگرنه دل و جان این همه نیست","هدف و منظور از دل و جان، تنها داشتن شرف گفتگو و ملاقات با محبوب است. اگر این را نداشته باشی، دیگر دل و جان اهمیتی ندارند و ارزشی در این دنیا ندارند."],[73,"منّت سدره و طوبی ز پی سایه مکش","که چو خوش بنگری ای سرو روان، این همه نیست","برای بدست آوردن سایه، منت درخت سدر و طوبی را مکش."],[73,"دولت آن است که بی خون دل آید به کنار","ور نه با سعی و عمل باغ جنان این همه نیست","خوشبختی واقعی به آسانی به دست می‌آید و نیازی به رنج و سختی نیست. در غیر این صورت، تلاش و کوشش برای رسیدن به بهشت هم بی‌فایده خواهد بود، زیرا آن بهشت به همین سادگی به دست نمی‌آید."],[73,"پنج روزی که در این مرحله مهلت داری","خوش بیاسای زمانی که زمان این همه نیست","پنج روزی که در این دنیا به تو فرصت داده شده است، خوب استراحت کنی و لذت ببری، زیرا زمان در این دنیا بسیار کوتاه و محدود است."],[73,"بر لب بحر فنا منتظریم ای ساقی","فرصتی دان که ز لب تا به دهان این همه نیست","ای ساقی، ما در کنار دریای فنا منتظریم و خواهش می‌کنیم که فرصتی بدانیم، زیرا فاصله‌ی بین لب و دهان، آن‌قدر کوتاه نیست."],[73,"زاهد ایمن مشو از بازی غیرت، زنهار","که ره از صومعه تا دیر مغان این همه نیست","ای زاهد، از بازی‌های دنیا بی‌خود اطمینان نکن، زیرا فاصله میان صومعه (محل عبادت زاهدان) و میکده مغان (محل زنان و شراب‌خواری) خیلی کم است و این حقیقت را نباید فراموش کنی."],[73,"دردمندیّ‌ من سوخته زار و نزار","ظاهرا حاجت تقریر و بیان این همه نیست","من که دچار درد و رنج زیادی هستم و در وضعیتی بد به سر می‌برم، به نظر می‌رسد نیازی به توضیح و بیان وضعیت خودم نیست."],[73,"نام حافظ رقم نیک پذیرفت ولی","پیش رندان رقم سود و زیان این همه نیست","نام حافظ به‌خاطر خوبی‌ها و صفاتش در نظر مردم خوب و نیکو شده، اما در جمع رندان (اهل می‌خانه و خوش‌گذرانی) این نام تنها نشان‌دهنده سود و زیان او نیست و چیزهای دیگری نیز در کار است."],[74,"خواب آن نرگس فتّان تو، بی‌چیزی نیست","تاب آن زلف پریشان تو، بی‌چیزی نیست","خواب آن نرگس فتان (زیبا) تو، چیزی نیست که بی‌معنا باشد؛ به همین ترتیب، زیبایی و تاب زلف‌های پریشان تو نیز چیزی نیست که بی‌ارزش به نظر برسد."],[74,"از لبت شیر روان بود که من می‌گفتم","«این شکر گرد نمکدان تو، بی‌چیزی نیست»","از لب تو، شیرینی‌ای به حدی بود که من می‌گفتم این شکر، درون نمکدان تو، چیز ناچیزی نیست."],[74,"جان درازی تو بادا که یقین می‌دانم","در کمان ناوک مژگان تو، بی‌چیزی نیست","برای تو آرزوی عمر طولانی دارم، زیرا می‌دانم که در نگاه نافذ و کشنده مژگان تو چیزی هست که می‌تواند دل و جان را تسخیر کند."],[74,"مبتلایی به غم محنت و اندوه فراق","ای دل! این ناله و افغان تو، بی‌چیزی نیست","ای دل! تو درگیر غم و درد جدایی هستی و ناله و فریاد تو از این وضعیت، بی‌قدر و اهمیت نیست."],[74,"دوش، باد از سر کویش به گلستان بگذشت","ای گل! این چاک گریبان تو، بی‌چیزی نیست","دیشب بادی از سوی کوی محبوب گذشت و عطر گل‌های آنجا را به همراه آورد. ای گل! این زخم و شکستگی در گریبان تو، نشانه بزرگی و اهمیت توست."],[74,"درد عشق ار چه دل از خلق نهان می‌دارد","حافظ این دیده گریان تو، بی‌چیزی نیست","عشق، هرچند که دل را از مردم پنهان می‌کند، اما این چشم‌های گریان تو، بی‌اهمیت نیست و نشان‌دهنده عواطف عمیق تو است."],[75,"جز آستان توام در جهان، پناهی نیست","سر مرا به ‌جز این در، حواله‌گاهی نیست","جز به درگاه تو، هیچ پناه دیگری در این دنیا وجود ندارد و سرنوشت و سرم را جز به این در، نمی‌توانم بسپارم."],[75,"عدو چو تیغ کشد، من سپر بیندازم","که تیغ ما، به ‌جز از ناله‌ای و آهی نیست","وقتی دشمن شمشیر می‌کشد، من سپر می‌اندازم و از خود دفاع نمی‌کنم، چون سلاح من تنها ناله و آه است و چیز دیگری ندارم."],[75,"چرا ز کوی خرابات روی برتابم؟","کز این بهم به جهان، هیچ رسم و راهی نیست","چرا از محله خراباتی‌ها دور شوم؟ زیرا در این دنیا هیچ رسم و راهی بهتری نسبت به این زندگی نیست."],[75,"زمانه گر بزند آتشم به خرمن عمر","بگو بسوز که بر من به برگ کاهی نیست","اگر روزگار سرنوشت من را خراب کند و آتش بر زندگی‌ام بزند، بگو بسوزد؛ زیرا من ارزش زیادی ندارم و همچون برگ کاهی هستم که به راحتی به باد می‌رود."],[75,"غلام نرگس جمّاش آن سهی سروم","که از شراب غرورش به کس، نگاهی نیست","من به خاطر زیبایی و جذابیت‌های چشم آن دختر خوش‌چهره و بلندبالا که در میخانه (سرای) می‌گذرد، تسلیم شده‌ام. او چنان در مستی غرق است که اصلا به دیگران توجهی ندارد."],[75,"مباش در پی آزار و هرچه خواهی کن","که در شریعت ما غیر از این، گناهی نیست","در دین و آیین ما، برای آزار دیگران ممنوعیتی وجود ندارد و می‌توانی هر کاری که می‌خواهی انجام دهی."],[75,"عنان‌کشیده رو ای پادشاه کشور حسن","که نیست بر سر راهی که دادخواهی نیست!","ای پادشاه زیبایی، با قدرت و سلطنت خود، با راندن و هدایت کردن خود، به راه بیفت؛ زیرا در این مسیر که به آن خواسته و طلبی نیست، هیچ بازخواست و دادخواهی وجود ندارد."],[75,"چنین که از همه‌سو، دام راه می‌بینم","به از حمایت زلفش، مرا پناهی نیست","در وضعیتی که از همه طرف در دام و مشکلات قرار دارم، بهتر از پناه بردن به زلف و زیبایی او، هیچ جای دیگری ندارم که به آن تکیه کنم."],[75,"خزینه دل «حافظ» به زلف و خال مده","که کارهای چنین، حدّ هر سیاهی نیست","حافظ» از کسی می‌خواهد که دلش را با زلف و سیاهی خال آن شخص آزرده نکند، زیرا کارهایی از این دست در زشتی و سیاهی حد و مرزی ندارند."],[76,"بلبلی، برگ گلی خوش‌رنگ در منقار داشت","و اندر آن برگ و نوا، خوش ناله‌های زار داشت","بلبلی در حالی که برگ گلی زیبا در منقار داشت، در آن برگ و با صدای خود ناله‌های غم‌انگیزی می‌خواند."],[76,"گفتمش: در عین وصل‌، این ناله و فریاد چیست؟","گفت ما را جلوه‌ی معشوق در این کار داشت","به او گفتم: در حالی که با هم وصال داریم، چرا این ناله و فریاد می‌زنی؟ او پاسخ داد که وجه زیبا و دیدار معشوق، باعث این حال و فریاد ماست."],[76,"یار اگر ننشست با ما نیست جای اعتراض","پادشاهی کامران بود، از گدایی عار داشت","اگر یار به ما نپیوندد، جایی برای اعتراض نیست؛ چون پادشاهی که از خوشبختی برخوردار است، از گدایی و درخواست کمک شرم دارد."],[76,"درنمی‌گیرد نیاز و ناز ما با حسن دوست","خرّم آن کز نازنینان‌، بخت برخوردار داشت","نیاز و ناز ما با زیبایی دوست، که خوشبخت از نازنینان است، سازگار نمی‌شود و نمی‌تواند در یکدیگر تاثیری بگذارند."],[76,"خیز تا بر کلک آن نقاش‌، جان افشان کنیم","کاین همه نقش عجب در گردش پرگار داشت","بیا تا با هم به دست آن نقاش برتر برویم و جان خود را فدای زیبایی‌هایی کنیم که این همه طرح شگفت‌انگیز را در دایره هستی به تصویر کشیده است."],[76,"گر مرید راه عشقی، فکر بدنامی مکن","شیخ صنعان، خرقه رهن خانه خمّار داشت","اگر واقعا سالک و پیرو راه عشق هستی، از بدنام شدن نترس. شیخ صنعان که پیر و مرشد بزرگی بود، آن‌قدر در راه عشق پیش رفت و بی توجه به حرف مردم بود که خرقه لباس درویشان بود و همچنین نماد زهد و مقام معنوی ولی ان رابرای خرید شراب در میخانه گرو گذاشت .داستان شیخ صنعان در کتاب «منطق‌الطیر» عطار آمده است"],[76,"وقت آن شیرین‌قلندر خوش که در اطوار سیر","ذکر تسبیح ملک در حلقه‌ی زنّار داشت","زمانی فرا خواهد رسید که آن زاهد شیرین‌زبان (شیرین‌قلندر) خوشحال و شاداب می‌شود، وقتی در حال سیر و سفر (دنبال عشق و حقیقت) مشغول ذکر و یاد خدا (تسبیح) است و سجده‌اش در حلقه‌ای به شکل زنّار (حلقه‌ای که نشان از زهد و رنج کشیدن دارد) قرار دارد."],[76,"چشم حافظ زیر بام قصر آن حوری‌سرشت","شیوه‌ی جنّات تجری تحتها الانهار داشت","حافظ در این بیت می‌گوید که چشمان او از زیر بام قصر آن دختری که مانند حوریان است، به زیبایی و جاذبه‌ای می‌نگرد که مانند باغ‌های بهشتی است که در آن نهرها جاری است."],[77,"دیدی که یار، جز سر جور و ستم نداشت","بشکست عهد، وز غم ما، هیچ غم نداشت","آخر دیدی که یار جز جور و ستم قصد دیگری نداشت؟ و دیدی که پیمان و عهد را شکست و به‌حال ما ترحمی نکرد؟"],[77,"یا رب مگیرش ارچه دل چون کبوترم","افکند و کشت و عزّت صید حرم نداشت","یارب مگیرش و مجازاتش مکن، اگرچه دل کبوتر بی‌پناه و بی‌گناه من را کشت و حرمت کبوتران حرم را نیز نگه نداشت."],[77,"بر من، جفا ز بخت من آمد وگرنه یار","حاشا که رسم لطف و طریق کرم نداشت","این جفا که بر من رفت از بخت بد من بود وگرنه یار اهل لطف بود و آیین و منش او از کرم دور نبود."],[77,"با این همه، هر آن‌که نه خواری کشید از او","هر جا که رفت، هیچ کسش محترم نداشت","با این‌همه‌، هر‌کسی را که او خوار نکرد، هرجا که رفت محترم نشد."],[77,"ساقی بیار باده و با محتسب بگو","انکار ما مکن که چنین جام، جم نداشت","ساقی بیار باده و به شحنه چیزی مگو و ما را انکار و رد مکن که جامی که ما می‌گیریم جمشید نداشت."],[77,"هر راهرو که ره به حریم درش نبرد","مسکین برید وادی و ره در حرم نداشت","هر راهرو که به حریم در او راه نیافت بی‌نوا و بی‌نصیب بیابان پیمود و سختی کشید و به اندرون حرم راه نیافت."],[77,"«حافظ»! ببر تو گوی فصاحت که مدّعی","هیچش هنر نبود و خبر نیز هم نداشت","حافظ، تو گوی فصاحت و سخن را ببر که مدعی و خصم نه‌تنها هیچ هنر نداشت بلکه حتی نمی‌دانست هنر و فصاحت چیست."],[78,"کنون که می‌دمد از بوستان، نسیم بهشت","من و شراب فرح‌بخش و یار حورسرشت","اکنون که فصل نسیم بهشتی است و بوی بوستان را می‌آورد زمان من و شراب شادی‌بخش است و من و یار حورصفت."],[78,"گدا چرا نزند لاف سلطنت امروز؟","که خیمه، سایه ابر است و بزمگه، لب کشت","گدا و بی‌نوا چرا از شاهی و سلطنت دم نزند امروز که سایه ابر بهاری بر سبزه‌زار خیمه زده و لب کشت‌زار بزمگه اوست."],[78,"چمن حکایت اردیبهشت می‌گوید","نه عاقل است که نسیه خرید و نقد بهشت","چمن، داستان اردیبهشت را می‌گوید؛ عاقل نیست کسی که این بهشت نقد را گذاشت و به نسیه فریب خورد."],[78,"به می عمارت دل کن که این جهان خراب","بر آن سر است که از خاک ما بسازد خشت","به می دل را خوش و آباد کن که این دنیای خراب‌بنیاد قصد آن دارد که از سر ما و خاک ما خشت بسازد."],[78,"وفا مجوی ز دشمن که پرتوی ندهد","چو شمع صومعه افروزی از چراغ کنشت","از این دنیا که دشمن توست چشم وفا و مهر نداشته باش، زیرا شمع صومعه را اگر از چراغ کنشت بیفروزی، نور ندهد."],[78,"مکن به نامه سیاهی ملامت من مست","که آگه است که تقدیر بر سرش چه نوشت","به گناهکاری و سیاه‌نامه بودن، مرا مؤاخذه و سرزنش مکن؛ که می‌داند که تقدیر بر سر او چه نوشته است؟"],[78,"قدم دریغ مدار از جنازه حافظ","که گر چه غرق گناه است، می‌رود به بهشت","از جنازه حافظ قدم دریغ مدار و به خاک‌سپاری او بیا؛ زیرا اگرچه غرق گناه است به بهشت می‌رود."],[79,"عیب رندان مکن ای زاهد پاکیزه‌سرشت!","که گناه دگران بر تو نخواهند نوشت","ای زاهد پاکدامن، به عیب‌ها و ناپاکی‌های زیرکان نپرداز و آنها را نکوب، زیرا گناهان دیگران به تو ارتباطی ندارد و در روز قیامت به پای تو نمی‌نویسند."],[79,"من اگر نیکم و گر بد، تو برو خود را باش!","هر کسی آن درود عاقبت کار، که کشت","اگر من خوب باشم یا بد، تو به خودت برس و خودت را بساز. هر کسی در نهایت نتیجه کارهایش را درو می‌کند، چه خوب و چه بد."],[79,"همه‌کس، طالب یارند؛ چه هشیار و چه مست","همه‌جا، خانه عشق است؛ چه مسجد چه کنشت","همه افراد، چه هشیار و چه مست، خواهان معشوق هستند. در هر مکان، عشق حضور دارد؛ چه در مسجد و چه در کنیسه و میخانه."],[79,"سر تسلیم من و خشت در میکده‌ها","مدّعی گر نکند فهم سخن، گو سر و خشت","من سر تسلیم بر دیوار میخانه‌ها فرود آورده‌ام ، اگر مدعی نتواند مفهوم کلام را درک کند، می‌تواند سرش را به سنگ بزند."],[79,"ناامیدم مکن از سابقه لطف ازل","تو پس پرده چه دانی که که خوب است و که زشت؟","مرا از رحمت و لطف بی‌نهایت ناامید نکن؛ تو که در پس پرده واقعیت‌ها جهان، نمی‌دانی چه چیز خوب است و چه چیز بد."],[79,"نه من از پرده تقوا به درافتادم و بس","پدرم نیز بهشت ابد از دست، بهشت","من نه تنها خودم از پرده تقوا و پرهیزکاری خارج شدم، بلکه پدرم نیز بهشت جاویدش را از دست داده است."],[79,"حافظا! روز اجل گر به کف آری جامی","یک‌سر از کوی خرابات برندت به بهشت","حافظ، اگر در روز مرگت بتوانی حرکتی بکنی و پویا و فعال باشی ،مستقیم به بهشت خواهی رفت."],[80,"صبحدم مرغ چمن با گل نوخاسته گفت","ناز کم کن که در این باغ بسی چون تو شکفت","صبح‌گاه بلبل با گل تازه‌شکفته گفت که با من کم ناز کن زیرا در این باغ‌، گل‌‌‌های همچون تو بسیارند."],[80,"گل بخندید که از راست نرنجیم ولی","هیچ عاشق سخن سخت به معشوق نگفت","گل خندید و به او پاسخ داد: از سخن راست نمی‌رنجیم ولی کسی که عاشق است اینگونه با معشوق و محبوب‌، سخن نمی‌گوید."],[80,"گر طمع داری از آن جام مرصع می لعل","ای بسا در که به نوک مژه‌ات باید سفت","اگر امید داری که از آن‌جام یگانه و مرصّع‌، باده بنوشی‌، بسیار مروارید‌های اشک باید از نوک مژگان بریزی."],[80,"تا ابد بوی محبت به مشامش نرسد","هر که خاک در میخانه به رخسار نرفت","تا ابد و هرگز بوی عشق را نشنود و نخواهد دانست که عشق و محبت چیست، آن‌کس که چهره و رخسار بر خاک در میخانه ننهد."],[80,"در گلستان ارم دوش چو از لطف هوا","زلف سنبل به نسیم سحری می‌آشفت،","دیشب در گلستان بهشت وقتی که نسیم ملایم‌ سحری، زلف سنبل را آشفته می‌کرد."],[80,"گفتم: «ای مسند جم! جام جهان‌بینت کو؟»","گفت: «افسوس که آن دولت بیدار بخفت!»","از او پرسیدم که ای تکیه‌گاه جمشید، جام جهان‌بین تو کجاست (که مرا نصیب دهی) گفت افسوس که آن دولت نیک و سعادت خفت."],[80,"سخن عشق نه آن است که آید به زبان","ساقیا می ده و کوتاه کن این گفت و شنفت","هرچه که بیان شود سخن عشق نیست، ای ساقی باده بده و این گفتگو را کوتاه کن."],[80,"اشک حافظ، خرد و صبر، به دریا انداخت","چه کند؟ سوز غم عشق نیارست نهفت","اشک و گریه حافظ‌، عقل و صبر را به دریا انداخت، چه می‌توانست کرد زیرا سوز و درد عشق را نمی‌توانست نهان کند."],[81,"آن ترک پری چهره که دوش از بر ما رفت","آیا چه خطا دید که از راه خطا رفت؟","آن ترک خوش سیما که دیشب از پیش ما رفت آیا از ما خطا و اشتباهی دید که مارا ترک کرد و به مقصد دوری(ختای ولایتی از ترکان) رفت."],[81,"تا رفت مرا از نظر آن چشم جهان‌بین","کس واقف ما نیست که از دیده چه‌ها رفت","از زمانی که از نظرگاه من آن نورچشمی عزیز رفت آن کسی که مثل چشمان من بود و به واسطه ی آن بصیرت و بینایی پیدا می‌کردم،هیچکس نمی داند که چه حال و روزی دارم و چه چیز ارزشمندی از چشمان من رفته است."],[81,"بر شمع نرفت از گذر آتش دل، دوش","آن دود که از سوز جگر بر سر ما رفت","از داغ رفتن محبوب، آن دودی که از سوز و گداز جگر، بالای سر ما بلند شد بر سر شمع که دلش آتش گرفته و می‌سوزد نرفت. (یعنی داغ رفتن تو از شعله ی آتش نیز سوزنده تر است.)"],[81,"دور از رخ تو دم به دم از گوشه چشمم","سیلاب سرشک آمد و طوفان بلا رفت","آن یار سفر کرده الهی که بلا و بدی از رخسار او دور باد، در فراق رویش، از گوشه ی چشمان اشکبارم سیلاب جاری شد و بلاهای زیادی بسان طوفان به سرم آمد."],[81,"از پای فتادیم چو آمد غم هجران","در درد بمردیم چو از دست دوا رفت","غم هجران و نبود تو ما را از پای انداخت در درد فروماندیم و مرگ را به چشم خود دیدیم زمانی که نوش‌داروی جان از دست رفت."],[81,"دل گفت وصالش به دعا باز توان یافت","عمریست که عمرم همه در کار دعا رفت","دل مشتاقانه امیدوار بود که از طریق توسّل به دعا می توان دوباره به وصل معشوق نایل شد، تمام عمرم در دعا و طلب سپری شد ولیکن توفیقی حاصل نگشت."],[81,"احرام چه بندیم؟ چو آن قبله نه این جاست","در سعی چه کوشیم؟ چو از مروه صفا رفت","حال که قبله و کعبه ی ما(معشوق) از اینجا عزم سفر کرده و رفته است احرام بستن ما چه سودی دارد ؟ عمل سعی نیز بیهوده می‌باشد چرا وقتی که قبله(معشوق) رفته و حضور ندارد کوشش کنیم ؟ بنابراین در مروه به سبب نبود معشوق هیچ صفا (خوشی و خرمی) نمانده و سعی ما هیچ نتیجه ای ندارد. (صفا و مروه: دو نقطه که حجّاج می بایست هفت مرتبه این فاصله را بصورت رفت وبرگشت طی کنند تامراسم حج کامل گردد این عمل را سعی می‌نامند.)"],[81,"دی گفت طبیب از سر حسرت چو مرا دید","هیهات که رنج تو ز قانون شفا رفت","دیشب که طبیب وضعیّت نامساعد مرا دید از سرحسرت گفت: افسوس که امکان مداوای تو میسّر نیست دور از ذهن است که تو شفا پیدا کنی.(قانون و شفا از کتاب‌های حکیم و پزشک معروف ابن‌سینا هستند کتاب قانون به پزشکی و شفا به علوم طبیعی و ریاضیات و فلسفه پرداخته‌)"],[81,"ای دوست به پرسیدن حافظ قدمی نه","زان پیش که گویند که از دار فنا رفت","ای دوست از حافظ که بیمار عشق است عیادت کن و از احوالات او پرسشی کن پیش از آنکه از دیگران بشنوی حافظ از این دنیا رفت."],[82,"گر ز دست زلف مشکینت خطایی رفت رفت","ور ز هندوی شما بر ما جفایی رفت رفت","از جانب زلف سیاه و معطّر تو اگر خطا و اشتباهی سر زد و از چشمان و خال و خط سیاه تو، ستمی به ما رسید،اشکالی ندارد زیاد مهم نمی باشد و می‌گذرم."],[82,"برق عشق ار خرمن پشمینه پوشی سوخت سوخت","جور شاه کامران گر بر گدایی رفت رفت","اگر خرقه ی درویشی من به آتش برق عشق سوخت و خاکستر شد اشکالی ندارد هرچه دارم فدای عشق باد. و اگر از طرف پادشاهی کامروا جفایی برگدایی همچون من رفت هیچ اهمیّتی ندارد."],[82,"در طریقت رنجش خاطر نباشد می بیار","هر کدورت را که بینی چون صفایی رفت رفت","در مسلک ما که در حال سیر و سلوک هستیم رنجیدن معنایی ندارد ما از هیچکس کینه به دل نمی گیریم و نمی رنجیم باده بیاور خوش باشیم اگر کدورتی هم باشد همانگونه که خوشی و خرّمی در گذرند این نیزمی گذرد وبه فراموشی سپرده می شود."],[82,"عشقبازی را تحمل باید ای دل، پای دار","گر ملالی بود بود و گر خطایی رفت رفت","ای دل در عشقبازی باید صبور و شکیبا باشی، بی تابی مکن اگر هم در عشقبازی رفتاری ملالت انگیز رخ نمود و یا خطایی از جانب معشوق صورت گرفت اشکالی ندارد تحمّل کن و مقاوم باش."],[82,"گر دلی از غمزه دلدار باری برد برد","ور میان جان و جانان ماجرایی رفت رفت","اگر از حرکات دلبرانه ی معشوق، دل عاشق زیر بار اندوه و حسرت به تنگ آمد مهم نیست و اگر میان عاشق و معشوق هر اتّفاقی رخ داد خیر است و ملالی نیست."],[82,"از سخن چینان ملالت‌ها پدید آمد ولی","گر میان همنشینان ناسزایی رفت رفت","درست است که از دشمنی سخن چینان این وضعیّت ملالت بار رقم خورده است لیکن من از حق خود می‌گذرم چرا که در میان همنشینان رخداد های این چنین غیر معمول نیست و من هیچ شکایتی از آنها ندارم ."],[82,"عیب حافظ گو مکن واعظ که رفت از خانقاه","پای آزادی چه بندی؟ گر به جایی رفت رفت","ای واعظ سخن چین که پشت سر حافظ بدگویی می‌کنی و از خانقاه رفتن او را دستآویز قرار داده و با بوق و کرنا در مجالس عمومی اعلام می کنی، آری من از خانقاه که مکان ریا و تزویر است رویگردان شدم و خود را خلاص کردم تو نمی توانی پای آزاد اندیش و آزاد مردی چون مرا به بندی ، کسی که از تمام قید و بند تعلّقات رها گشته ، هرجا که بخواهد می رود."],[83,"ساقی بیار باده که ماه صیام رفت","درده قدح که موسم ناموس و نام رفت","ای ساقی، شراب بیاور که ماه رمضان گذشت. باده را در جام بگذار که زمان مقام و حرمت به پایان رسیده است."],[83,"وقت عزیز رفت بیا تا قضا کنیم","عمری که بی حضور صراحی و جام رفت","زمان ارزشمند ما گذشته است، بیایید آن را با نوشیدن شراب و همراهی با یکدیگر بگذرانیم تا عمرمان که بدون سوار شدن بر این نعمت‌ها سپری شده است، را جبران کنیم."],[83,"مستم کن آن چنان که ندانم ز بی‌خودی","در عرصه خیال که آمد، کدام رفت","مرا چنان مست و سرمست کن که نتوانم بفهمم در دنیای خیال چه اتفاقی افتاده است و کدام حالت و وضعیت به من رسیده است و دیگر نمی‌دانم کجا هستم."],[83,"بر بوی آن که جرعه جامت به ما رسد","در مصطبه دعای تو هر صبح و شام رفت","به خاطر عطر و بوی دوست، که نوشیدنی تو به ما برسد، دعای تو هر صبح و شام به آسمان می‌رود و مورد قبول قرار می‌گیرد."],[83,"دل را که مرده بود حیاتی به جان رسید","تا بویی از نسیم می‌اش در مشام رفت","دل که قبل از این بی‌حیات بود، حالا با یاد و بوی خوش شراب او، جان تازه‌ای پیدا کرده و به زندگی برگشته است."],[83,"زاهد غرور داشت، سلامت نبرد راه","رند از ره نیاز به دارالسلام رفت","زاهد (مرد دیندار و پارسا) به خاطر غرورش نتوانست در مسیر درست و سالم قرار بگیرد، در حالی که رند (شخص خوشگذران و آزاداندیش) از طریق نیاز و درخواست به بهشت واقعی دست یافت."],[83,"نقد دلی که بود مرا صرف باده شد","قلب سیاه بود از آن در حرام رفت","دل من که همیشه مورد نقد و بررسی بود، اکنون در اثر نوشیدن شراب هزینه شده است. قلب تیره‌ام به خاطر این کار به جایی ناپاک و حرام رفته است."],[83,"در تاب توبه چند توان سوخت همچو عود؟","می ده که عمر در سر سودای خام رفت","در انتظار توبه چقدر می‌توان در آرامش و به‌دردی مانند چوب عود سوخت؟ به من شراب بده، زیرا عمر در خیال‌های بی‌مورد گذشت."],[83,"دیگر مکن نصیحت حافظ که ره نیافت","گمگشته‌ای که باده نابش به کام رفت","به هیچ‌وجه نصیحت نکن حافظ را، زیرا کسی که گم شده، هرگز راه را پیدا نخواهد کرد و باده ناب او را تحت تأثیر خود قرار داده است."],[84,"شربتی از لب لعلش نچشیدیم و برفت","روی مه پیکر او سیر ندیدیم و برفت","ما از لب‌های زیبای او جرعه‌ای نچشیدیم و او رفت، همچنین نتوانستیم به چهره دل‌فریب او به‌خوبی نگاه کنیم و او دیگر رفت."],[84,"گویی از صحبت ما نیک به تنگ آمده بود","بار بربست و به گردش نرسیدیم و برفت","به نظر می‌رسد که از گفتگو و معاشرت ما ناراحت شده بود و به همین دلیل از ما دور شد و نتوانستیم به او برسیم."],[84,"بس که ما فاتحه و حرز یمانی خواندیم","وز پی‌اش سوره اخلاص دمیدیم و برفت","به اندازه‌ای برای آن کس که رفت، دعا و ذکر (فاتحه و حرز یمانی) خواندیم و همچنین سوره اخلاص را هم بر او دمیدیم که در نهایت هیچ‌کدام به او نرسید و او رفت."],[84,"عشوه دادند که بر ما گذری خواهی کرد","دیدی آخر که چنین عشوه خریدیم و برفت","ما را با ناز و فریب خود به آمدن تشویق کردند، اما حالا می‌بینیم که به این روش فریب‌کارانه از کنار ما گذشتند و رفتند."],[84,"شد چمان در چمن حسن و لطافت لیکن","در گلستان وصالش نچمیدیم و برفت","هر چند در باغ عشق به خاطر زیبایی و لطافت او چمیدیم و لذت بردیم، اما در نهایت نتوانستیم به وصال و نزدیکی‌اش دست یابیم و او رفت."],[84,"همچو حافظ همه شب ناله و زاری کردیم","کای دریغا به وداعش نرسیدیم و برفت","مانند حافظ، ما نیز شب‌ها با ناله و زاری اشک ریختیم که افسوس، نتوانستیم به وداع او برسیم و او رفت."],[85,"ساقی بیا که یار ز رخ پرده برگرفت","کار چراغ خلوتیان باز درگرفت","ساقی بیا و باده بریز که یار چهره نمایاند و رخ او مجلس خلوتیان را روشن کرد."],[85,"آن شمع سرگرفته دگر چهره برفروخت","وین پیر سال‌خورده جوانی ز سر گرفت","آن شمع خاموش دوباره روشن شد؛ و این پیر ناتوان و ضعیف دوباره جوان و توانا شد."],[85,"آن عشوه داد عشق که مفتی ز ره برفت","وان لطف کرد دوست که دشمن حذر گرفت","عشق، چنان عشوه و نازی نمود که مفتی و فقیه از راه به‌در شد، دوست چنان لطفی کرد که دشمن، حساب کار خود را کرد."],[85,"زنهار از آن عبارت شیرین دل‌فریب","گویی که پسته تو سخن در شکر گرفت","از آن جمله زیبا و فریبنده‌ای که دل را جذب می‌کند، برحذر باش، زیرا مثل پسته‌ای که در شکر غلتیده است، سخن تو شیرین و فریبنده می‌شود."],[85,"بار غمی که خاطر ما خسته کرده بود","عیسی‌دمی خدا بفرستاد و برگرفت","غم و اندوهی که دل ما را زخم کرده بود، با آمدن عیسی، که به او نسبت‌های الهی داده‌اند، برطرف شد و از ما گرفته شد."],[85,"هر سروقد که بر مه و خور حسن می‌فروخت","چون تو درآمدی پی کاری دگر گرفت","هر خوش اندام و ماهرویی که در زیبایی از ماه و خورشید خودش را برتر می‌دانست، وقتی که تو آمدی، مشغول کاری دیگر شد و نتوانست فخرفروشی را ادامه دهد."],[85,"زین قصه هفت گنبد افلاک پرصداست","کوته‌نظر ببین که سخن مختصر گرفت","این ماجرا در همه‌جا پیچیده، آدم دون‌نظر را ببین که این‌را دست‌کم گرفته‌است."],[85,"حافظ تو این سخن ز که آموختی؟ که بخت","تعویذ کرد شعر تو را و به زر گرفت","حافظ از چه کسی این سخن را یاد گرفته‌ای که سرنوشت تو را در شعرهایت تغییر داده و به تو اعتبار و ارزش بخشیده است؟"],[86,"حسنت به اتفاق ملاحت جهان گرفت","آری، به اتفاق، جهان می‌توان گرفت","نمک و ملاحت تو همراه با زیبایی و تناسبت عالم گیر شده،این قضیه روشن کرد که می‌توان با اتحاد جهان را گرفت."],[86,"افشای راز خلوتیان خواست کرد شمع","شکر خدا، که سر دلش در زبان گرفت","شمع قصد کرد که راز خلوت‌نشینان را فاش کند‌، خدای را سپاس که راز دل‌، زبانش را آتش زد."],[86,"زین آتش نهفته که در سینه من است","خورشید، شعله‌ای‌ست که در آسمان گرفت","خورشید عالم‌تاب‌، شراره‌ای از آتش پنهانی است که از سینه من در آسمان زد."],[86,"می‌خواست گل که دم زند از رنگ و بوی دوست","از غیرت صبا، نفسش در دهان گرفت","گل نیز خواست که با حال و زیبایی خود وصفی از یار من گوید، صبا از غیرت‌، او را خموش کرد."],[86,"آسوده بر کنار چو پرگار می‌شدم","دوران، چو نقطه، عاقبتم در میان گرفت","چون پرگار (دور از بلای عشق یا دور از حوادث) بر کناره می‌رفتم‌، اما دست روزگار مرا همچون نقطه (پرگار) به میانه کشید."],[86,"آن روز شوق ساغر می، خرمنم بسوخت","کآتش ز عکس عارض ساقی در آن گرفت","می نوش و می‌گسار نبودم تا روزی که زیبایی ساقی (که عکسش در جام افتاد یا آتشی که در می بود) آتش در خرمنم زد."],[86,"خواهم شدن به کوی مغان آستین‌فشان","زین فتنه‌ها که دامن آخرزمان گرفت","شاد و فارغ از همه‌چیز دارم به‌سوی کوی می‌فروشان می‌روم از دست این فتنه‌های فراوان که (امروز) گویی آخرالزمان است."],[86,"می خور که هر که آخر کار جهان بدید","از غم سبک برآمد و رطل گران گرفت","هرکه دانا است و آخر کار جهان را دید پر از شادی شد و جام‌های می پر و سنگین را تهی کرد."],[86,"بر برگ گل به خون شقایق نوشته‌اند","«کآن کس که پخته شد، می چون ارغوان گرفت»","از گل سرخ تا خون شقایق به تو می‌گویند: کسی پخته‌ و داناست که می زلال و ناب ارغوانی گرفت."],[86,"حافظ چو آب لطف ز نظم تو می‌چکد","حاسد چگونه نکته تواند بر آن گرفت؟","حافظا وقتی که آب لطافت از نظم تو می‌چکد، حسود کی می‌تواند بر شعرت خرده بگیرد؟"],[87,"شنیده‌ام سخنی خوش که پیر کنعان گفت","«فراق یار، نه آن می‌کند که بتوان گفت»","از حضرت یعقوب _ پیر کنعان _ سخنی شیرین و دلپذیر شنیده ­ام: جدایی و دوری از یار چنان کاری می­ کند که نمی­ توان آن را بیان کرد"],[87,"حدیث هول قیامت که گفت واعظ شهر","کنایتی‌ست که از روزگار هجران گفت","واعظ شهر که داستان ترسناک روز قیامت را بیان کرد؛ در اصل اشاره­ ای است کوتاه و سربسته از روزگار دوری از معشوق"],[87,"نشان یار سفرکرده از که پرسم باز؟","که هر چه گفت برید صبا، پریشان گفت","پیک صبا که از حرم معشوق خبر دارد و از جانب حرم او می ­آید، هرمطلبی در مورد معشوق گفت پریشان و نامعلوم بود، نشان و خبر از یار سفر کرده را باید از چه کسی بپرسم؟"],[87,"فغان که آن مه نامهربان مهرگسل","به ترک صحبت یاران خود چه آسان گفت","آه و فریاد از آن زیباروی نامهربان عهد شکن، که چقدر راحت و آسوده یاران خود را ترک کرد و رفت(ایهام تناسب: “مهر” در “نامهربان” و “مهرگسل” در معنای خورشید با “ماه” تناسب دارد)"],[87,"من و مقام رضا بعد از این و شکر رقیب","که دل به درد تو خو کرد و ترک درمان گفت","گویی دل من دیگر به درد عشق تو عادت کرده و درمان را رها ساخته است، من نیز بعد از این به مقام رضا روی خواهم آورد و از رقیب شکرگزار خواهم بود"],[87,"غم کهن به می سال‌خورده دفع کنید","که تخم خوش‌دلی این است؛ پیر دهقان گفت","پیر دهقان گفت: غم دیرینه را با شراب کهنه از بین ببرید؛ چرا که تنها مایه­ ی خوشدلی همین است"],[87,"گره به باد مزن گر چه بر مراد رود","که این سخن به مثل، باد با سلیمان گفت","باد این مثل را به سلیمان آموخت: که هرچند روزگار مطابق میل تو باشد و باد بر طبق میل تو بوزد اما هرگز کار بیهوده نکن و به آنچه ثبات ندارد اعتماد مکن"],[87,"به مهلتی که سپهرت دهد ز راه مرو","تو را که گفت که این زال ترک دستان گفت؟","به فرصت اندکی که آسمان در اختیار تو گذاشته است، فریفته نشو؛ چه کسی به تو گفت که این روزگار دیرینه سال، حیله­ گری را رها کرده است(ایهام تناسب: زال و دستان؛ معنای دیگر زال که پدر رستم است با کلمه دستان ایهام تناسب دارد)"],[87,"مزن ز چون و چرا دم که بنده مقبل","قبول کرد به جان، هر سخن که جانان گفت","در برابر خواست و تقاضای معشوق، چون و چرا نکن ؛ چرا که بنده­ ی خوشبخت هر سخنی را که معشوق بیان می­ کند، از جان و دل می ­پذیرد"],[87,"که گفت حافظ از اندیشه تو آمد باز؟","من این نگفته‌ام آن کس که گفت بهتان گفت","چه کسی به تو گفته است که حافظ دست از غم عشق تو کشیده است و دیگر به تو فکر نمی­ کند؟ من چنین مطلبی را نگفته­ ام، هر کس گفته است دروغ گفته است."],[88,"یا رب سببی ساز که یارم به سلامت","بازآید و برهاندم از بند ملامت","خدایا کاری کن که یارم به‌سلامت برگردد و مرا از بند و درد غم رها کند."],[88,"خاک ره آن یار سفرکرده بیارید","تا چشم جهان بین کنمش جای اقامت","خبری از یار سفر کرده بیاورید تا آنرا توتیای چشمانم کنم (یا از چه‌کسی بپرسم که یار سفرکرده‌ام کجاست!؟ تا چشمانم را خاک قدمش کنم)"],[88,"فریاد که از شش جهتم راه ببستند","آن خال و خط و زلف و رخ و عارض و قامت","فریاد و فغان که از هرسو که می‌روم نمی‌توانم او را فراموش کنم و هرلحظه به‌یاد او هستم."],[88,"امروز که در دست توام مرحمتی کن","فردا که شوم خاک چه سود اشک ندامت","امروز که من در دست تو و عاشق تو هستم، بیا زیرا فردا که بمیرم اشک پشیمانی سودی ندارد."],[88,"ای آن که به تقریر و بیان دم زنی از عشق","ما با تو نداریم سخن، خیر و سلامت","ای کسی که درباره عشق فقط نوشته و سخنی دیده‌ای و گفته‌ای، ما با تو نسبتی نداریم شما را به‌خیر و ما را به‌سلامت!"],[88,"درویش مکن ناله ز شمشیر احبّا","کاین طایفه از کشته ستانند غرامت","ای درویش از شمشیر و جور دلبران ناله و شکایت مکن زیرا این قوم، از کشته، خون‌بها می‌ستانند!"],[88,"در خرقه زن آتش که خم ابروی ساقی","بر می‌شکند گوشه محراب امامت","خرقه زهد را دور بیفکن زیرا ابروی یار بسیار از محراب نماز، زیبا‌تر و پرستیدنی‌تر است."],[88,"حاشا که من از جور و جفای تو بنالم","بیداد لطیفان همه لطف است و کرامت","از من دور بادا که روزی از جور و ستم تو گلایه و شکایت کنم زیرا ستم و جور زیبایان همه خود مهربانی و بخشش است."],[88,"کوته نکند بحث سر زلف تو حافظ","پیوسته شد این سلسله تا روز قیامت","حافظ، شعر گفتن درباره زلف بلند و زیبای تو را ترک نخواهد گفت؛ شعر او همانند زلف تو تا قیامت ادامه دارد."],[89,"ای هدهد صبا به سبا می‌فرستمت","بنگر که از کجا به کجا می‌فرستمت","ای هدهد پیک صبا تو را به سوی سرزمین سبا می‌فرستم به‌هوش باش که از کجا به کجا می‌روی."],[89,"حیف است طایری چو تو در خاک‌دان غم","زین جا به آشیان وفا می‌فرستمت","حیف است پرنده‌ای مثل تو در این خاک‌دان غم بمانی‌؛ تو را به سرزمین مهر و وفا می‌فرستم."],[89,"در راه عشق مرحله قرب و بعد نیست","می‌بینمت عیان و دعا می‌فرستمت","در راه و مسلک عشق‌، دوری و نزدیکی وجود ندارد هرجایی باشی تو را می‌بینم و تو را دعا می‌گویم."],[89,"هر صبح و شام قافله‌ای از دعای خیر","در صحبت شمال و صبا می‌فرستمت","هر صبح و هر شامگاه کاروانی از دعای خیر و با گفتگو با باد شمال و باد صبا بسوی تو روانه می‌کنم."],[89,"تا لشکر غمت نکند ملک دل خراب","جان عزیز خود به نوا می‌فرستمت","تا لشکر غم و اندوه تو را غمگین و شکسته نکند جان عزیز خود را به نوا به تو تقدیم می‌کنم."],[89,"ای غایب از نظر که شدی هم‌نشین دل","می‌گویمت دعا و ثنا می‌فرستمت","ای یار غایب از دیده که در دل جای داری، تو را دعای خیر می‌گویم و به‌تو آفرین می‌فرستم."],[89,"در روی خود تفرّج صنع خدای کن","کآیینه خدای‌نما می‌فرستمت","به رخ زیبای خود بنگر و از آفریده شگفت خدا لذت ببر در این آیینه خدای‌نما که برایت می‌فرستم."],[89,"تا مطربان ز شوق منت آگهی دهند","قول و غزل به ساز و نوا می‌فرستمت","تا مطربان و خوانندگان با شوق و شور بتوانند عشق مرا برای تو بیان کنند این غزل را آهنگین و با نوا به تو تقدیم می‌کنم."],[89,"ساقی بیا که هاتف غیبم به مژده گفت","با درد صبر کن که دوا می‌فرستمت","ای ساقی بیا که سروش غیبی خبری شادی‌آور برایم آورده و به من گفته‌است که با درد بساز که برای تو دوا و درمان می‌فرستم."],[89,"حافظ، سرود مجلس ما ذکر خیر توست","بشتاب هان که اسب و قبا می‌فرستمت","ای حافظ ذکر خوبی‌های تو شادی‌بخش و سرود مجلس ماست؛ به مجلس ما بیا که برایت اسب و خلعت فرستاده‌ایم."],[90,"ای غایب از نظر به خدا می‌سپارمت","جانم بسوختی و به دل دوست دارمت","با تو نیستم و تو نزد من نیستی اما تو را به‌خدا می‌سپارم؛ (با رفتنت) دل مرا سوختی؛ با جان و دل تو را دوست دارم."],[90,"تا دامن کفن نکشم زیر پای خاک","باور مکن که دست ز دامن بدارمت","تا روزی که به زیر خاک نروم و تا وقتی که جان دارم، باور مکن که تو را فراموش کنم و دست از دامن تو بردارم."],[90,"محراب ابرویت بنما تا سحرگهی","دست دعا برآرم و در گردن آرمت","روزی سپیده‌دم به دیدار من بیا تا در محراب ابرویت خواسته‌ها و دعاهای خود را به‌تو بگویم و تو را در آغوش بگیرم."],[90,"گر بایدم شدن سوی هاروت بابلی","صد گونه جادویی بکنم تا بیارمت","اگر حتی مجبور شوم سوی هاروت بابل می‌روم تا با سحر و جادو تو را بیاورم."],[90,"خواهم که پیش میرمت ای بی‌وفا طبیب","بیمار باز پرس که در انتظارمت","می‌خواهم مثل بیماری که در نزد طبیب جان می‌سپارد در پیش تو بمیرم؛ از حال بیمار خود بپرس که در انتظار دیدن تو هستم."],[90,"صد جوی آب بسته‌ام از دیده بر کنار","بر بوی تخم مهر که در دل بکارمت","از اشک خود صد جوی در کنار روان کرده‌ام تا مگر دانه محبت خود را در دل تو بکارم و بپرورم."],[90,"خونم بریخت وز غم عشقم خلاص داد","منّت پذیر غمزه خنجر گذارمت","مرا کشت و از این درد و غم عشق مرا رها کرد؛ آفرین بر آن خنجر غمزه که مرا نجات داد."],[90,"می‌گریم و مرادم از این سیل اشک‌بار","تخم محبّت است که در دل بکارمت","با گریه‌های خود و سیل اشک خود، امید دارم که تخم مهر و دوستی خود را در دل تو بکارم و سبز کنم."],[90,"بارم ده از کرم سوی خود تا به سوز دل","در پای دم‌به‌دم گهر از دیده بارمت","از روی بخشش و کرم مرا به سوی خود راه بده تا هردم از اشک‌های خود گوهر و جواهر تقدیم قدمت کنم."],[90,"حافظ شراب و شاهد و رندی نه وضع توست","فی‌الجمله می‌کنی و فرو می‌گذارمت","ای حافظ‌، شراب و شاهد و رندی و عیش کار تو نیست، (با آنکه) همه این‌ها را انجام می‌دهی تو را می‌بخشم."],[91,"میر من خوش می‌روی کاندر سر و پا میرمت","خوش خرامان شو که پیش قد رعنا میرمت","ای فرمانروای من ( در اینجا حضرت حافظ معشوق را فرمانروای قلب خود خطاب میکند) چقدر زیبا و با ناز راه میروی که من از فرط عشق جانم را فدای سر و پای تو میکنم. باز هم با همان ناز و زیبایی قدم بردار که جانم را پیش قد و قامت رعنای تو فدا کنم"],[91,"گفته بودی کی بمیری پیش من، تعجیل چیست؟","خوش تقاضا می‌کنی پیش تقاضا میرمت","ای جانان من، پرسیده بودی که چه زمانی جانت را فدای من میکنی؟ عجله برای چیست؟ چه تقاضای خوب و شیرینی داری. جانم فدای تقاضای تو شود ( یا قبل از اینکه تقاضا کنی جانم را فدایت میکنم )"],[91,"عاشق و مخمور و مهجورم بت ساقی کجاست؟","گو که بخرامد که پیش سرو بالا میرمت","عاشق و مست ( از عشق ) و دور افتاده ( از وصال معشوق ) آن معشوق زیبا روی ما کجاست؟ به او بگویید با ناز و خرام بیایید که من پیش قد و بالای سرو مانندش جان نثار کنم"],[91,"آن که عمری شد که تا بیمارم از سودای او","گو نگاهی کن که پیش چشم شهلا میرمت","آن کسی که عمری است از سودای عشق او بیمارم، به او بگویید که نگاهی به من بیندازد تا من پیش چشمان زیبای او جان فدا کنم"],[91,"گفته‌ای لعل لبم هم درد بخشد هم دوا","گاه پیش درد و گه پیش مداوا میرمت","ای معشوق زیبای روی من، گفته ای که لبان سرخ و شیرین من هم درد ‌و زجر میدهد و هم درمان میکند. گاهی پیش دردی که لبانت میدهد و گاهی پیش درمان آن ( بوسه و وصال ) جان میدهم ( عاشق هم شیفته وصال و هم شیفته فراق یار است )"],[91,"خوش خرامان می‌روی چشم بد از روی تو دور","دارم اندر سر خیال آن که در پا میرمت","ای جان من، چقدر زیبا و با ناز راه میروی، چشم بد از تو دور باد. در سر خیال و آرزوی آن را دارم که از عشق جانم را پیش پایت فدا کنم"],[91,"گرچه جای حافظ اندر خلوت وصل تو نیست","ای همه جای تو خوش، پیش همه جا میرمت","اگرچه حافظ لیاقت و شایستگی و بودن در خلوت و وصال تو را ندارد، ای کسی که تمام وجودت نیکو و دوست داشتنی است، پیش هر جا که متعلق به تو است جان میدهم."],[92,"چه لطف بود که ناگاه رشحه قلمت","حقوق خدمت ما عرضه کرد بر کرمت","چه خوب می‌شود اگر ناگهان جریان جوهر قلم تو، پاداش خدمت ما را به بزرگی و کرامت خود پیشکش کند."],[92,"به نوک خامه رقم کرده‌ای سلام مرا","که کارخانه دوران مباد بی رقمت","تو با نوک قلمت سلام مرا نوشته‌ای، که امیدوارم زمانه بدون نشان تو پیش نرود."],[92,"نگویم از من بی‌دل به سهو کردی یاد","که در حساب خرد نیست سهو بر قلمت","نمی‌گویم که به اشتباه یاد من را کرده‌ای، چون در محاسبات دقیق، اشتباه نمی‌شود."],[92,"مرا ذلیل مگردان به شکر این نعمت","که داشت دولت سرمد عزیز و محترمت","من را با داشتن این نعمت که موجب عزیز و محترم بودن تو شده، ذلیل و خوار مکن."],[92,"بیا که با سر زلفت قرار خواهم کرد","که گر سرم برود برندارم از قدمت","بیا تا با موهایت قرار بگذارم، زیرا اگر سرم هم برود، حاضر نیستم از پای تو دست بردارم."],[92,"ز حال ما دلت آگه شود مگر وقتی","که لاله بردمد از خاک کشتگان غمت","دل تو از حال ما آگاه نخواهد شد، مگر زمانی که لاله‌ها (نماد عشق و زیبایی) از خاک کشته‌شدگان عشق تو روییده شوند."],[92,"روان تشنه ما را به جرعه‌ای دریاب","چو می‌دهند زلال خضر ز جام جمت","ما را که تشنه عشق هستیم، با یک جرعه محبت و توجه خود سیراب کن، همان‌طور که در داستان‌های افسانه‌ای، نوشیدن آب زلال خضر از جامی خاص، جان را دوباره زنده می‌کند."],[92,"همیشه وقت تو ای عیسی صبا خوش باد","که جان حافظ دلخسته زنده شد به دمت","فرصت همیشه برای تو ای عیسی صبا (باد بهاری) خوش باشد، زیرا جان حافظ، که دلش گرفته است، با نفسی از تو دوباره زنده شد."],[93,"زآن یار دل‌نوازم، شکری است با شکایت","گر نکته‌دان عشقی، بشنو تو این حکایت","از آن یار مهربان و دلنشینم شکری همراه با گله و شکایت دارم؛ اگر به دنبال فهم مفاهیم باریک عشق هستی، این داستان مرا بشنو."],[93,"بی‌مزد بود و منّت، هر خدمتی که کردم","یا رب! مباد کس را، مخدوم بی‌عنایت","هر خدمتی که انجام دادم، بدون پاداش و احسان ماند، خداوندا، هیچ کس سرور و مولایی نداشته باشد که به او توجه نکند."],[93,"رندان تشنه‌لب را، آبی نمی‌دهد کس","گویی ولی‌شناسان، رفتند از این ولایت","هیچ کس به رندان تشنه لب دیگر جرعه­‌ی آبی نمی­‌بخشد، گویا کسانی که قدر و ارزش اولیاء الله را می­‌دانستند از این سرزمین رفته­‌اند.(نکته: حافظ بسیار رندانه، رند را همان اولیاء الله می­‌داند.)"],[93,"در زلف چون کمندش، ای دل! مپیچ کآن جا","سرها بریده بینی، بی‌جرم و بی‌جنایت","ای دل، خود را در گیسوی همچون کمند دلدار، گرفتار نکن! چرا که سرهای بسیاری را در آنجا خواهی یافت که بدون هیچ جرم و جنایتی بریده، رها شده است.(نکته: شایان ذکر است که منزل و مأوای دل در ادبیات فارسی، زلف معشوق است.)"],[93,"چشمت به غمزه ما را، خون خورد و می‌پسندی","جانا! روا نباشد، خون‌ریز را حمایت","چشمان تو با غمزه­‌های مستانه­‌اش خون ما را ریخت، تو نیز آن را پسندیدی، دلبندم، مگر نمی­دانی که از خونریز و قاتل حمایت کردن، امری شایسته نیست!(نکته: نکته قابل توجه در این بیت کارکرد غمزه است که هرچند به طور معمول جهت دلبری استفاده می­شود اما حافظ بیان می‌­کند که غمزه­‌ی یار جهت خون ریختن و کشتن اوست؛ از این رو از معشوق می­‌خواهد که از چشمانش که در واقع خونریز و قتال وضع می­‌باشند، حمایت نکند!همچنین می­توان منظور از حمایت کردن معشوق از چشمانش را اشاره به مژگان معشوق دانست، گویی مژگان معشوق نیزه دارانی صف بسته هستند که از چشمانش مراقبت می­‌کنند.)"],[93,"در این شب سیاهم، گم گشت راه مقصود","از گوشه‌ای برون آی، ای کوکب هدایت","در این شب سیاه و ظلمانی، راه رسیدن به مقصود را گم کرده‌­ام، ای ستاره هدایتگر از گوشه‌­ای بیرون بیا(کوکب هدایت: تلمیح به آیه ۱۶ سوره نحل: وعلامات وبالنّجم هم یهتدون.)"],[93,"از هر طرف که رفتم، جز وحشتم نیفزود","زنهار از این بیابان، وین راه بی‌نهایت","از هر طرفی که رفتم چیزی جز تنهایی و بی­کسی، حاصلم نشد! از این بیابان و از این راهی که هیچ پایانی ندارد، بر حذر باشید."],[93,"ای آفتاب خوبان! می‌جوشد اندرونم","یک ساعتم بگنجان، در سایه عنایت","ای خورشید زیبارویان! سراپای وجودم در سوز و گداز عشق تو می­‌جوشد، برای لحظه‌­ای مرا در پناه عنایتت که همچون سایه است قرار بده."],[93,"این راه را نهایت، صورت کجا توان بست؟","کش صد هزار منزل، بیش است در بدایت","راهی که بیش از صدها هزار منزل در ابتدای آن قرار دارد، چگونه می­‌توان برای آن پایانی تصور کرد."],[93,"هر چند بردی آبم روی از درت نتابم","جور از حبیب خوش‌تر، کز مدّعی رعایت","هر چند آبروی مرا بردی، اما هرگز، از در خانه­‌ی تو باز نخواهم گشت؛ چرا که تحمل جور و ستم از معشوق بسیار بهتر از رعایت و جانب‌داری مدعیان لاف‌­زن و دروغگوست."],[93,"عشقت رسد به فریاد، ار خود به سان حافظ","قرآن ز بر بخوانی، در چارده روایت","اگر بتوانی مانند حافظ قرآن را در چارده روایت از حفظ بخوانی، و با قران مانوس باشی آنگاه عشق به فریادت خواهد رسید یعنی لازمه بهره مندی از عشق واقعی انس با قران هست.(چارده روایت: بنا بر نظر دکتر قاسم غنی برای قراءت قرآن هفت قاری (قراء سبعه) بودند که قراءت هر یک به واسطه دو راوی به ما رسیده است.)"],[94,"مدامم مست می‌دارد، نسیم جعد گیسویت","خرابم می‌کند هر دم، فریب چشم جادویت","هر لحظه عطر خوشی از گیسوی تو به‌من می‌رسد و از آن مست و خوش می‌شوم؛ هر لحظه چشم زیبای تو مرا مست‌تر می‌کند!"],[94,"پس از چندین شکیبایی، شبی، یا رب! توان دیدن","که شمع دیده افروزیم در محراب ابرویت؟","آیا می‌شود که پس از مدت‌ها صبر، دیدگانم به دیدن ابروی زیبای تو روشن شود همچون شمعی که در محراب بیفروزند."],[94,"سواد لوح بینش را عزیز از بهر آن دارم","که جان را نسخه‌ای باشد ز لوح خال هندویت","سیاهی نوشته‌های کتاب‌های بینش و دانایی را از بهر آن دوست دارم که شبیه خال تو مشکی است."],[94,"تو گر خواهی که جاویدان جهان یکسر بیارایی","صبا را گو که بردارد زمانی برقع از رویت","اگر می‌خواهی که تا ابد دنیا را آراسته و زیبا کنی به نسیم صبا بگو که یک لحظه برقع از رخت بردارد."],[94,"و گر رسم فنا خواهی که از عالم براندازی","برافشان تا فروریزد هزاران جان ز هر مویت","اگر می‌خواهی که فنا و زوال را از جهان محو کنی، زلف را بپراکن و پریشان کن تا از هر تار گیسویت، جان‌ها ببخشی."],[94,"من و باد صبا مسکین، دو سرگردان بی‌حاصل","من از افسون چشمت مست و او از بوی گیسویت","من و نسیم صبا، دو آدم سرگردان و ناامید هستیم که مست و بی‌خود گشته‌ایم من از غمزه چشم تو مستم و او از عطر زلفت."],[94,"زهی همت که حافظ راست از دنیی و از عقبی","نیاید هیچ در چشمش به جز خاک سر کویت","آفرین بر نظر بلند و همّت حافظ که هیچ چیز از دنیا و آخرت را نمی‌بیند جز خاک سر کوی تو را."],[95,"درد ما را نیست درمان الغیاث","هجر ما را نیست پایان الغیاث","درد ما راه درمانی ندارد، و جدایی ما به پایان نمی‌رسد."],[95,"دین و دل بردند و قصد جان کنند","الغیاث از جور خوبان، الغیاث","دین و دل ما را گرفتند و حالا قصد جان ما را دارند، ای فریادرس، از ظلم و ستم خوبان، ای فریادرس."],[95,"در بهای بوسه‌ای جانی طلب","می‌کنند این دلستانان الغیاث","این دلبران برای یک بوسه جان را طلب می‌کنند. فریاد!"],[95,"خون ما خوردند این کافردلان","ای مسلمانان چه درمان؟ الغیاث","این کافران دل‌سوز و بی‌رحم جان ما را می‌خورند و ای مسلمانان، برای این وضعیت چه چاره‌ای وجود دارد؟"],[95,"هم‌چو حافظ روز و شب بی‌خویشتن","گشته‌ام سوزان و گریان الغیاث","مانند حافظ، روز و شب از خود بی خود شده ام. میسوزم و گریانم، و کمک می‌طلبم."],[96,"تویی که بر سر خوبان کشوری چون تاج","سزد اگر همه دلبران دهندت باج","تو از همه زیبایان این سرزمین زیباتر و سرتر هستی؛ شایسته‌است که تاجدار و شاه آنها باشی و همه به‌تو باج بپردازند."],[96,"دو چشم شوخ تو برهم زده خطا و حبش","به چین زلف تو ماچین و هند داده خراج","دو چشم بی‌رحم و بی‌پروای تو ختا و حبش را برهم زده (ختا و حبش یعنی نهایت سپیدی و نهایت سیاهی) و چین و ماچین و هند و تا سرزمین‌های دوردست به چین زلف بلند و سیاه تو خراج می‌پردازند. (هند در اینجا اشاره است به سیاهی زلف)"],[96,"بیاض روی تو روشن چو عارض رخ روز","سواد زلف سیاه تو هست ظلمت داج","روی سپید تو همچون خورشید است و سیاهی زلف تو همچون شب تاریک."],[96,"دهان شهد تو داده رواج آب خضر","لب چو قند تو برد از نبات مصر رواج","دهان شیرین و خوش تو آب حیات روان کرده است و لب همچون قند تو رونق نبات مصر را از بازار برده است."],[96,"از این مرض به حقیقت شفا نخواهم یافت","که از تو درد دل ای جان! نمی‌رسد به علاج","از این بیماری‌، شفا نخواهم یافت زیرا ای عزیز، داروی درد دلم از تو نمی‌رسد. (منظور نبات و قند است در بیت قبل)"],[96,"چرا همی شکنی جان من ز سنگ‌دلی؟","دل ضعیف که باشد، به نازکی چو زجاج","چرا جان و دل من را با بی‌رحمی و سنگدلی می‌شکنی؟ دل مرا که همچون شیشه‌، نازک است."],[96,"لب تو خضر و دهان تو آب حیوان است","قد تو سرو و میان‌موی و بر، به هیئت عاج","لب تو آب زندگانی است و دهان تو چشمه زندگی؛ قد تو همچون سرو خوش‌اندام و کمر باریک تو همچون مو‌؛ و سینه و گردن روشن تو مثل عاج فیل."],[96,"فتاد در دل حافظ هوای چون تو شهی","کمینه ذره خاک در تو بودی کاج","ای شاه خوبان، در دل حافظ هوس و هوای تو افتاد؛ ای کاش او کمترین خاک در تو بود. (کاج‌: کاش)"],[97,"اگر به مذهب تو خون عاشق است مباح","صلاح ما همه آن است کآن تو راست صلاح","اگر در عشق تو، خونی از عاشق رها باشد، این کار برای عشق تو مجاز است. پس در حقیقت، خیر و صلاح ما همین است که آنچه تو بخواهی، درست و صحیح است."],[97,"سواد زلف سیاه تو جاعل الظّلمات","بیاض روی چو ماه تو، فالق الأصباح","سیاهی موی سیاه تو پدیدآورنده تاریکی‌هاست؛ سفیدی چهره مانند ماه تو (ماه شب چهاردهم [که کامل است])، شکافنده (و گسترش‌دهنده سپیدی) صبح است؛ (اقتباس از سوره انعام، آیه ۱: «... جعل الظّلمات والنّور ...» و آیه ۹۶: «فالق الإصباح ...»)"],[97,"ز چین زلف کمندت کسی نیافت خلاص","از آن کمانچه ابرو و تیر چشم، نجاح","از پیچ و خم زلف‌های تو هیچ‌کس نتوانسته خود را نجات دهد، زیرا ابروی تو همچون کمان و نگاه چشمانت مانند تیر، به شدت و دقت می‌زند."],[97,"ز دیده‌ام شده یک چشمه در کنار روان","که آشنا نکند در میان آن، ملّاح","از چشمانم چشمه‌ای جاری شده که فقط برای شناگران آشناست و کسی غیر از آن‌ها نمی‌تواند از آن آب بنوشد."],[97,"لب چو آب حیات تو هست قوّت جان","وجود خاکی ما را از اوست ذکر رواح","لب تو که مانند آب حیات است، باعث قوت و زندگی جان ماست و وجود خاکی ما به وسیله ذکر و یاد تو جان می‌گیرد."],[97,"بداد لعل لبت بوسه‌ای به صد زاری","گرفت کام دلم زو به صد هزار الحاح","با بوسه‌ای از لب زیبایت به صورت بسیار دلخواه، دل من را خوشحال کردی و به شدت از تو درخواست کردم که دوباره این کار را تکرار کنی."],[97,"دعای جان تو ورد زبان مشتاقان","همیشه تا که بود متّصل مسا و صباح","دعای تو همیشه بر زبان عاشقان است تا اینکه بوی گل و شمعی روشن باشد."],[97,"صلاح و توبه و تقوی ز ما مجو حافظ","ز رند و عاشق و مجنون کسی نیافت صلاح","حافظ نگذار که از ما انتظار صلاح و توبه و تقوی داشته باشی، زیرا هیچ‌کس از رند و عاشق و مجنون، به این فضایل دست نیافته است."],[98,"دل من در هوای روی فرخ","بود آشفته همچون موی فرخ","دل من به خاطر دیدن روی زیبا و خوشبخت او آشفته و بی‌قرار است، مانند موهای پریشان او."],[98,"به جز هندوی زلفش هیچ کس نیست","که برخوردار شد از روی فرخ","تنها آن کسی که به زلف هندی‌وار او دسترسی دارد، از زیبایی چهره‌ی فرخ بهره‌مند شده است و دیگر هیچ‌کس نمی‌تواند به این زیبایی دست یابد."],[98,"سیاهی نیکبخت است آن که دائم","بود هم‌راز و هم‌زانوی فرخ","کسی که همیشه در کنار و هم‌دل فرخ باشد، خوشبخت و نیکبخت است."],[98,"شود چون بید لرزان سرو آزاد","اگر بیند قد دلجوی فرّخ","اگر سرو آزاد، که نمایانگر زیبایی و استواری است، قد دلجوی فرخ را ببیند، به حالتی لرزان و ناپایدار درمی‌آید، همچون بید. این تصویر بیانگر تأثیر شگرف زیبایی و دلجویی فرخ (که نام زیبا و دلربایی دارد) بر دیگران است."],[98,"بده ساقی شراب ارغوانی","به یاد نرگس جادوی فرّخ","به یاد نرگس زیبا و دلربایی فرخ، ای ساقی، شراب ارغوانی بده تا بنوشم."],[98,"دو تا شد قامتم همچون کمانی","ز غم پیوسته چون ابروی فرخ","قامتم به دلیل غم دائمی که دارم، مثل دو کمان خمیده شده، درست مانند ابروی فرخ (به معنای زیبا و دلربا)."],[98,"نسیم مشک تاتاری خجل کرد","شمیم زلف عنبربوی فرخ","نسیم معطر و خوشبوی تاتاری باعث شده است تا عطر زلف‌های خوشبو و مانند عطر عنبر فرخ را شرمنده کند."],[98,"اگر میل دل هر کس به جایی‌ست","بود میل دل من سوی فرخ","هر کسی دوست دارد به جایی برود یا به چیزی تمایل داشته باشد، میل من هم به فرخ است."],[98,"غلام همت آنم که باشد","چو حافظ بنده و هندوی فرخ","من آن‌قدر اراده و تلاش دارم که مانند حافظ، بنده و خدمتگزار او باشم و به خواسته‌های او احترام بگذارم، حتی اگر آن خواسته کسی چون هندوی فرخ باشد."],[99,"دی پیر می‌فروش که ذکرش به خیر باد","گفتا شراب نوش و غم دل ببر ز یاد","دیروز پیر خرابات که درود بر او باد، گفت‌: باده بنوش و غم را یاد مکن."],[99,"گفتم به باد می‌دهدم باده نام و ننگ","گفتا قبول کن سخن و هر چه باد، باد","به او گفتم که شراب و باده، آبروی مرا می‌برد، پاسخ داد: این سخن را بپذیر هرچه شود، شود."],[99,"سود و زیان و مایه چو خواهد شدن ز دست","از بهر این معامله غمگین مباش و شاد","وقتی که از سود و از زیان و سرمایه و هرچه که هست رفتنی است؛ پس برای این معامله نه غمگین باش و نه شاد و اصلا به‌آن فکر نکن."],[99,"بادت به دست باشد اگر دل نهی به هیچ","در معرضی که تخت سلیمان رود به باد","اگر دل و مهر خود را به هیچ ببندی، در آخر هیچ نصیبت نمی‌شود؛ در جایی که فرمان‌روایی بی‌نظیر سلیمان بر باد می‌رود و هیچ می‌شود."],[99,"حافظ گرت ز پند حکیمان ملالت است","کوته کنیم قصه، که عمرت دراز باد","ای حافظ، اگر پند خردمندان و دانایان تو را آزرده می‌کند، پس سخن را کوتاه می‌کنیم، عمرت دراز بادا!"],[100,"شراب و عیش نهان چیست؟ کار بی‌بنیاد","زدیم بر صف رندان و هر چه بادا باد","شراب و عیش خاص و نهان که از آن سخن می‌گویند دانی که چیست؟ کار بی‌بنیاد کردن و شاد بودن؛ ما به رندان پیوستیم و هرچه شود، شود."],[100,"گره ز دل بگشا وز سپهر یاد مکن","که فکر هیچ مهندس چنین گره نگشاد","غم مخور و از جور و ستم روزگار یاد مکن‌، که هیچ متفکر و مهندسی این راز را نگشوده و نگشاید."],[100,"ز انقلاب زمانه عجب مدار که چرخ","از این فسانه هزاران هزار دارد یاد","از گردش روزگار و شگفتی‌های آن تعجب مکن که چرخ فلک و روزگار از این کارها و عجایب‌، هزاران‌هزار کرده و به‌یاد دارد."],[100,"قدح به شرط ادب گیر زان که ترکیبش","ز کاسه سر جمشید و بهمن است و قباد","جام (سفالین) را با ادب و احترام به‌دست بگیر که ترکیب آن، از خاک بزرگان و شاهان کیانی و انسان‌های با شأن و عظمتی‌است."],[100,"که آگه است که کاووس و کی کجا رفتند؟","که واقف است که چون رفت تخت جم، بر باد؟","چه‌کسی می‌داند که کاووس و کی کجا رفتند؟ و چه‌کسی آگاه است که تخت و فرمان‌روایی جمشید چگونه از بین رفت؟"],[100,"ز حسرت لب شیرین هنوز می‌بینم","که لاله می‌دمد از خون دیده فرهاد","می‌بینم که از داغ لب‌های شیرین که فرهاد با خود به‌خاک برد، و اشک‌های خونین که ریخت‌، هنوز لاله‌ از دل خاک می‌روید."],[100,"مگر که لاله بدانست بی‌وفایی دهر","که تا بزاد و بشد، جام می ز کف ننهاد","شاید به‌این دلیل که لاله بی‌وفایی روزگار را می‌بیند، از روزی که متولد می‌شود تا روزی که می‌رود، جام می را از کف فرو نمی‌نهد."],[100,"بیا بیا که زمانی ز می خراب شویم","مگر رسیم به گنجی در این خراب آباد","بیا و بیا تا باده بنوشیم و شاد باشیم، شاید در این خراب‌آباد دنیا گنجی شایسته بیابیم."],[100,"نمی‌دهند اجازت مرا به سیر سفر","نسیم باد مصلّا و آب رکن آباد","نسیم دل‌انگیز باد «مصلّا» و زلالی و شیرینی آب «رکن‌آباد» مرا پایبند کرده و نمی‌گذارد که راه سفر در پیش بگیرم."],[100,"قدح مگیر چو حافظ مگر به ناله چنگ","که بسته‌اند بر ابریشم طرب دل شاد","همچون حافظ باش و بدون نوای مطرب و چنگ، باده‌گساری مکن و می منوش، زیرا دل شاد را با موسیقی و ساز شاد جفت کرده‌اند و بسته‌اند. (ابریشم در این بیت منظور تارها و سیم‌های برخی سازهاست که در گذشته از ابریشم می‌ساخته‌اند.)"],[101,"دوش آگهی ز یار سفر کرده داد باد","من نیز دل به باد دهم، هر چه باد باد","دیشب باد خبری از یار سفر کرده‌ام آورد، من نیز دلم را به باد می‌دهم، هر چه می‌خواهد بشود. ( حافظ در این بیت، از خبری که باد از معشوق سفر کرده‌اش آورده، سخن می‌گوید. او که دلتنگ و بی‌قرار است، تصمیم می‌گیرد دلش را به دست باد بسپارد و تسلیم سرنوشت شود. عبارت \"هر چه باد باد\" نشان‌دهنده تسلیم و رضا به تقدیر است. )"],[101,"کارم بدان رسید که همراز خود کنم","هر شام برق لامع و هر بامداد باد","کارم به جایی رسیده که ( از تنهایی ) برق درخشان شب ( عبارت برق درخشان شب در این بیت دارای معانی متعددی است. مثل آذرخش درخشان، نور ستارگان، شعله آتش عشق درون عاشق) و باد صبحگاهی را همراز خود می‌کنم. ( حافظ در این بیت، تنهایی و انزوای خود را نشان می‌دهد. او که از هجران یار در رنج است، با عناصر طبیعت هم‌صحبت می‌شود و آن‌ها را همراز خود قرار می‌دهد. )"],[101,"در چین طره تو دل بی حفاظ من","هرگز نگفت مسکن مألوف یاد باد","دل بی‌حفاظ من در پیچ و خم زلف تو، هرگز یاد خانه و مسکن همیشگی خود را نکرد. ( حافظ در این بیت، به عشق بی‌قید و شرط خود به معشوق اشاره می‌کند. او می‌گوید که دلش چنان درگیر زلف زیبای معشوق شده که حتی یاد خانه و آرامش خود را هم فراموش کرده است. )"],[101,"امروز قدر پند عزیزان شناختم","یا رب روان ناصح ما از تو شاد باد","امروز ارزش نصیحت عزیزان را فهمیدم، خدایا روح نصیحت‌کننده ما را شاد کن. ( حافظ در این بیت، به اهمیت نصیحت و راهنمایی دوستان اشاره می‌کند. او که در گذشته شاید به نصیحت‌ها بی‌توجه بوده، اکنون قدر آن‌ها را می‌داند و برای نصیحت‌کنندگان دعا می‌کند. باتوجه به فضای حاکم بر غزلیات خواجه شیراز این نصیحت ها وابسته به دید خواننده است. این نصیحت می‌تواند عشق ورزی، بی توجهی به مادیات، تفکر نکردن درباره پیچیدگی های هستی،‌ دوری از زرق و ریا، و یا هرچیز دیگری بسته به دید شخصی خواننده باشد )"],[101,"خون شد دلم به یاد تو هر گه که در چمن","بند قبای غنچه گل می‌گشاد باد","هرگاه که باد، بند قبای غنچه گل را در چمن باز می‌کرد ( غنچه گل می‌شکفت )، دلم به یاد تو خون می‌شد. ( حافظ در این بیت، از یادآوری معشوق در هر لحظه سخن می‌گوید. او می‌گوید که حتی وزش باد و باز شدن غنچه‌ها نیز او را به یاد معشوق می‌اندازد و دلش را خون می‌کند. )"],[101,"از دست رفته بود وجود ضعیف من","صبحم به بوی وصل تو جان باز داد، باد","وجود ضعیف من در حال نابودی بود، که باد صبحگاهی با بوی وصال تو به من جان دوباره بخشید. ( حافظ در این بیت، به امید و اشتیاق خود برای وصال معشوق اشاره می‌کند. او می‌گوید که بوی وصال معشوق، مانند اکسیری شفابخش، جان تازه‌ای به او بخشیده است. )"],[101,"حافظ نهاد نیک تو کامت بر آورد","جان‌ها فدای مردم نیکو نهاد باد","حافظ، سرشت نیکوی تو، آرزویت را برآورده کرد، جان‌ها فدای مردم نیکو سرشت باد. ( حافظ در این بیت، به نیکوکاری و خوش‌قلبی خود اشاره می‌کند و می‌گوید که این صفات، باعث رسیدن او به آرزوهایش شده است. او در پایان، برای همه نیکوکاران دعا می‌کند. )"],[102,"روز وصل دوستداران یاد باد","یاد باد آن روزگاران، یاد باد","یادش بخیر آن‌زمان که با محبوبان و دوستداران هم‌نشین بودم‌؛ باز هم یاد باد آن روزگار خوش."],[102,"کامم از تلخی غم چون زهر گشت","بانگ نوش شادخواران یاد باد","تلخی و نامردای‌های امروز‌، کامم را هم چون زهر تلخ کرده‌است‌؛ یاد روزهای می‌خواری و تلخی‌های باده بخیر و یاد بانگ‌های «نوشت باد!» مجلسی که به شادی می‌نوشیدیم."],[102,"گر چه یاران فارغند از یاد من","از من ایشان را هزاران یاد باد","اگر‌چه دوستان و یاران مرا فراموش کرده‌اند اما من یاد آنها را هزاران بار به‌نیکی به خاطر می‌آورم."],[102,"مبتلا گشتم در این بند و بلا","کوشش آن حق‌گزاران یاد باد","در این بند و بلاهای روزگار امروز گرفتار شده‌ام یاد خوبی‌های آن یاران باوفا بخیر."],[102,"گر چه صد رود است در چشمم مدام","زنده رود باغ‌ کاران یاد باد","اگرچه صد جوی از اشک در کنار خود دارم اما همچنان به یاد زاینده رود و باغکاران ( یک باغ تاریخی در اصفهان در قرون گذشته) هستم ."],[102,"راز حافظ بعد از این ناگفته ماند","ای دریغا رازداران یاد باد","راز و سر حافظ شعر و غزل‌، همچنان ناگفته و پنهان ماند یاد آن محرمان راز و رازداران بخیر باد."],[103,"جمالت آفتاب هر نظر باد","ز خوبی روی خوبت خوب‌تر باد","خوش‌صورتی تو مانند خورشید است و هر کسی که به تو نگاه کند، باید از زیبایی تو زیباتر شود."],[103,"همای زلف شاهین شهپرت را","دل شاهان عالم زیر پر باد","زلف زیبای شاهین، که استعاره‌ای از جمال محبوب است، دل شاهان جهان را تسخیر کرده و به اسارت خود درآورده است."],[103,"کسی کو بسته زلفت نباشد","چو زلفت درهم و زیر و زبر باد","کسی که در بند زلف تو نیست، باید بداند که زلف تو مانند پرچم آشفته و درهم است."],[103,"دلی کو عاشق رویت نباشد","همیشه غرقه در خون جگر باد","هرکس که عاشق روی تو نباشد، باید همیشه در درد و رنج و عذاب زندگی کند."],[103,"بتا چون غمزه‌ات ناوک فشاند","دل مجروح من پیشش سپر باد","ای معشوق، وقتی که با ناز و غمزه‌ات به من نگه می‌کنی، دلم که زخمی است، از شدت عشق و درد باید تسلیم شود و به پیش تو بیفتد."],[103,"چو لعل شکّرینت بوسه بخشد","مذاق جان من زو پرشکر باد","وقتی لب‌های شکرین تو بوسه‌ای به من می‌دهند، جانم شیرین می‌شود و خوشی زیادی را تجربه می‌کنم."],[103,"مرا از توست هر دم تازه عشقی","تو را هر ساعتی حسنی دگر باد","هر لحظه عشق جدیدی به تو دارم و امیدوارم هر ساعت بر زیبایی‌های تو افزوده شود."],[103,"به جان، مشتاق روی توست حافظ","تو را در حال مشتاقان نظر باد","حافظ جان خود را فدای زیبایی تو می‌کند و امیدوار است که تو به حال دلدادگان خود توجه کنی."],[104,"صوفی ار باده به اندازه خورد نوشش باد","ور نه اندیشه این کار فراموشش باد","اگر صوفی به اندازه مناسب شراب بنوشد، برایش خیر و نیکی باشد؛ وگرنه باید فراموش کند که در این کار چه اندیشه‌ای دارد."],[104,"آن که یک جرعه می از دست تواند دادن","دست با شاهد مقصود در آغوشش باد","کسی که یک جرعه شراب را بتواند به دیگری تقدیم کند، باید در آغوش معشوق خود باشد."],[104,"پیر ما گفت خطا بر قلم صنع نرفت","آفرین بر نظر پاک خطاپوشش باد","پیر ما فرمود که هیچ اشتباهی در ساخت و آفرینش رخ نمی‌دهد و باید به نظر پاک و خطا پوشاننده او آفرین گفت."],[104,"شاه ترکان، سخن مدعیان می‌شنود","شرمی از مظلمه خون سیاوشش باد","شاه ترکان (که اشاره به افرادی از سلسله‌های ترک‌تبار دارد) باید از ظلمی که بر سیاوش، شخصیت اسطوره‌ای ایران، رفته است شرم کند و سخن کسانی که به او اعتراض می‌کنند را بشنود."],[104,"گر چه از کبر، سخن با من درویش نگفت","جان فدای شکرین‌پسته خاموشش باد","اگرچه از غرور با من بیچاره حرف نزد؛ جانم فدای لب‌های شیرین و تنگ و ساکت او بادا!"],[104,"چشمم از آینه‌داران خط و خالش گشت","لبم از بوسه‌ربایان بر و دوشش باد","چشمم به آینه‌داری او رسید امیدوارم لبم نیز به بوسه‌ربایی بر و دوش او برسد."],[104,"نرگس مست نوازش‌کن مردم‌دارش","خون عاشق به قدح گر بخورد نوشش باد","چشم خمار و مهربانش؛ اگر خون عاشق را بریزد و بنوشد نوشش بادا!"],[104,"به غلامی تو مشهور جهان شد حافظ","حلقه بندگی زلف تو در گوشش باد","حافظ از بندگی تو و در بندگی تو در جهان معروف شد؛ همیشه او، عاشق زلفت بادا!"],[105,"تنت به ناز طبیبان نیازمند مباد","وجود نازکت آزرده گزند مباد","امیدوارم بدنت دچار بیماری نشود که محتاج طبیب شوی و وجودت از بیماری و گزند دور باشد"],[105,"سلامت همه آفاق در سلامت توست","به هیچ عارضه شخص تو دردمند مباد",": سلامت و خوشبختی همه دنیا به سلامت و خوبی تو بستگی دارد ، امیدوارم هیچ مرضی تو را دردمند نکند"],[105,"جمال صورت و معنی ز امن صحت توست","که ظاهرت دژم و باطنت نژند مباد","زیبایی چهره و باطن تو از سلامت و آسودگی‌ات سرچشمه می‌گیرد، پس نگذار که ظاهرت غمگین و باطن‌ات ناخرسند باشد."],[105,"در این چمن چو درآید خزان به یغمایی","رهش به سرو سهی قامت بلند مباد","وقتی فصل خزان به این باغ وارد شود، امیدوارم که راهش به سوی سروهای بلند و زیبا نرود و آن‌ها را از آن خود نکند."],[105,"در آن بساط که حسن تو جلوه آغازد","مجال طعنه بدبین و بدپسند مباد","در محفل عشق و زیبایی تو، جایی برای انتقاد و نظر منفی افراد بدبین وجود ندارد."],[105,"هر آن که روی چو ماهت به چشم بد بیند","بر آتش تو بجز جان او سپند مباد",": هر کسی که زیبایی تو را با نظر بد ببیند، امیدوارم که جانش مانند اسپند در آتش تو بسوزد"],[105,"شفا ز گفته شکّرفشان حافظ جوی","که حاجتت به علاج گلاب و قند مباد","از سخنان شیرین و حکیمانه حافظ بهره‌مند شو که درمان‌های معمولی مانند گلاب و قند کارساز نیست"],[106,"حسن تو همیشه در فزون باد","رویت همه ساله لاله‌گون باد","زیبایی تو همیشه در حال افزایش است و چهره‌ات در طول سال مانند گل لاله شاداب و زیبا خواهد بود."],[106,"اندر سر ما خیال عشقت","هر روز که باد در فزون باد","هر روز در ذهن ما فقط خیال عشق تو وجود دارد، پس در این حالت، مانند باد، هر روز بیشتر و بیشتر می‌شود."],[106,"هر سرو که در چمن درآید","در خدمت قامتت نگون باد","هر درخت سرو که در باغ ظاهر شود، به خاطر قامت زیبایت باید افتاده و بی‌حرکت باشد."],[106,"چشمی که نه فتنه تو باشد","چون گوهر اشک غرق خون باد","چشمی که جز زیبایی و فریب تو را نبیند، مانند گوهر اشکی است که از خون پر شده است."],[106,"چشم تو ز بهر دلربایی","در کردن سحر ذوفنون باد","چشم تو برای فریب دادن و جلب عشق و محبت، باید به زیبایی و هنر سحرآفرینی مزین باشد."],[106,"هر جا که دلیست در غم تو","بی صبر و قرار و بی سکون باد","هر جایی که کسی به خاطر تو درد و غم دارد، باید همیشه بی‌تاب و بی‌وقفه باشد."],[106,"قدّ همه دلبران عالم","پیش الف قدت چو نون باد","قد تو، که زیباترین نسبت به تمام دلبران دنیا است، مانند نان برای من و دیگران ارزشمند و ضروری است."],[106,"هر دل که ز عشق توست خالی","از حلقه وصل تو برون باد","هر دلی که به عشق تو بی‌علاقه باشد و از پیوند با تو محروم باشد، از دنیا برود و وجود نداشته باشد."],[106,"لعل تو که هست جان حافظ","دور از لب مردمان دون باد","عشق و وجود تو که برای حافظ مانند جانش است، باید دور از دسترس مردم پست و بی‌ارزش باشد."],[107,"خسروا گوی فلک در خم چوگان تو باد","ساحت کون و مکان عرصه میدان تو باد","ای شاه عزیز، گوی فلک در بازی چوگان تو قرار گیرد و عرصه دنیا میدان جولان تو باشد."],[107,"زلف خاتون ظفر شیفته پرچم توست","دیده فتح ابد عاشق جولان تو باد","زلف آن بانوی پیروزی به پرچم تو وابسته است و چشم‌هایش به پیروزی ابدی دوخته شده و عاشق موریس‌گری و میدان‌داری توست."],[107,"ای که انشاء عطارد صفت شوکت توست","عقل کل چاکر طغراکش دیوان تو باد","ای کسی که شخصیت و عظمت تو مانند تحریر عطارد زیبا و با شکوه است، امیدوارم که عقل کل (تمام دانش) همواره به پستوی عشق تو و وابسته به نشان تو باشد."],[107,"طیره جلوه طوبی قد چون سرو تو شد","غیرت خلد برین ساحت بستان تو باد","جلوه درخت طوبی (درختی بهشتی) به خاطر قد بلندی مثل سرو تو، به راستای غیرت و شجاعت بهشت برین می‌باشد و این به معنای احترام به باغ توست."],[107,"نه به تنها حیوانات و نباتات و جماد","هر چه در عالم امر است به فرمان تو باد","نه فقط حیوانات و گیاهان و اشیا، بلکه هر چه در جهان هست، به فرمان تو باشد."],[108,"دیر است که دل‌دار پیامی نفرستاد","ننوشت سلامی و کلامی نفرستاد","مدت زیادی است که معشوق هیچ پیامی نفرستاده و نه حتی سلامی یا کلامی برای من نوشته است."],[108,"صد نامه فرستادم و آن شاه سواران","پیکی ندوانید و سلامی نفرستاد","من صد نامه برای او فرستادم، اما آن شاه سواران هیچ فرستاده‌ای ارسال نکرد و حتی سلامی هم نرسانید."],[108,"سوی من وحشی‌صفت عقل‌رمیده","آهو روشی، کبک خرامی نفرستاد","او که به دلم نفوذ کند و عاقلانی را که عقل از دست داده‌اند، به حال خود رها کرده، هیچ نشانه‌ای از محبت و عشق به من نفرستاده است."],[108,"دانست که خواهد شدنم مرغ دل از دست","وز آن خط چون سلسله دامی نفرستاد","او (ساقی) می‌دانست که دل من به شدت دلبسته و پرپر خواهد شد و به همین دلیل، برایم از آن خط زیبا و جذاب، که مانند دامی برای عشق است، خبری نفرستاد."],[108,"فریاد که آن ساقی شکّر لب سرمست","دانست که مخمورم و جامی نفرستاد","فریاد می‌زنم که آن ساقی با لب‌های شیرین و مست، متوجه حال من شده که مست هستم، اما هیچ جام شرابی برای من نفرستاده است."],[108,"چندان که زدم لاف کرامات و مقامات","هیچم خبر از هیچ مقامی نفرستاد","هرچقدر که درباره کرامات و مقام‌های بزرگ خود سخن گفتم، هیچ‌کس از مقام و موقعیت واقعی من خبر نداشت و مرا به حال خود رها کرد."],[108,"حافظ به ادب باش که واخواست نباشد","گر شاه پیامی به غلامی نفرستاد","حافظ می‌گوید با ادب باش، زیرا اگر شاه پیامی به غلامی نفرستاده، نباید ناامید شد و به او پاسخ منفی داد، بلکه باید در رفتار خود احتیاط کنیم."],[109,"پیرانه سرم عشق جوانی به سر افتاد","وآن راز که در دل بنهفتم به درافتاد","در سال‌های پیری، شور عشق دوران جوانی در سرم افتاد( یا عشق معشوق جوانی در سرم افتاد و عاشقش شدم) و آن رازی که در قلبم پنهان کرده بودم، آشکار شد."],[109,"از راه نظر مرغ دلم گشت هواگیر","ای دیده نگه کن که به دام که درافتاد","هوا‌گیر‌: پروازی‌ || هوسی‌، آرزوخواه."],[109,"دردا که از آن آهوی مشکین سیه چشم","چون نافه بسی خون دلم در جگر افتاد","ای کاش، آهوی سیاه چشمی که عطر مشکین دارد، باعث شد که دلم مانند گلی که می‌چکد، خونین و دردناک شود."],[109,"از رهگذر خاک سر کوی شما بود","هر نافه که در دست نسیم سحر افتاد","هر عطر و بویی که از طرف خاک سر کوی شما به مشام رسیده، به واسطه نسیم صبحگاهی بوده که به آنجا آمده است."],[109,"مژگان تو تا تیغ جهانگیر برآورد","بس کشته دل زنده که بر یکدگر افتاد","مژگان (چشم‌های) تو به قدری قدرت دارد که می‌تواند حتی به دنیا هم غلبه کند و باعث کشتن زیبا دل‌ها شود، چرا که این زیبایی (احساس عاشقانه) به راحتی باعث جذب و تسلیم عاشق‌ها در برابر هم می‌شود."],[109,"بس تجربه کردیم در این دیر مکافات","با دردکشان هر که درافتاد برافتاد","در این میخانه‌ای که پر از عذاب و کیفر است، ما بسیار تجربه کرده‌ایم که هر که با معتادان و شکست‌خوردگان درافتاده، خودش هم به زودی مغلوب و شکست‌خورده می‌شود."],[109,"گر جان بدهد سنگ سیه، لعل نگردد","با طینت اصلی چه کند، بدگهر افتاد","ما بسیار تجربه کردیم که در این جهان جزا و پاداش، هر کس با اهل درد و مستی درافتاد، سقوط کرد."],[109,"حافظ که سر زلف بتان دست‌کشش بود","بس طرفه حریفی‌ست کش اکنون به سر افتاد","حافظ که به خاطر زیبایی و جذابیت موی معشوقان در عشق غرق شده بود، اکنون خود به‌طور ناگهانی در وضعیتی افتاده است که به نظر می‌رسد باید به آن زوال و مشکل‌شان پی ببرد."],[110,"عکس روی تو چو در آینه جام افتاد","عارف از خنده می در طمع خام افتاد","عکس چهره تو وقتی در آینه شیشه‌ای نمایان شد، عارف از نشئگی و شادی شراب به وسوسه و خواسته بیهوده دچار شد."],[110,"حسن روی تو به یک جلوه که در آینه کرد","این همه نقش در آیینه اوهام افتاد","حسن و زیبایی چهره تو در یک نمایی که در آینه نشان داد، باعث شد تا این همه تصویر در آینه‌های خیال و توهم به وجود بیاید."],[110,"این همه عکس می و نقش نگارین که نمود","یک فروغ رخ ساقی‌ست که در جام افتاد","تمامی تصاویری که از می و نقش‌های زیبا در ذهن ما شکل گرفته، در واقع نتیجه‌ی یک تابش نور است که از چهره معشوق (ساقی) بر روی جام افتاده و این زیبایی را به وجود آورده است."],[110,"غیرت عشق زبان همه خاصان ببرید","کز کجا سرّ غمش در دهن عام افتاد؟","عشق به قدری قوی است که زبان همه خواص (کسانی که در عشق معرفت دارند) را بریده و خاموش کرده است، اما سوال اینجاست که چگونه راز غم عشق او (ساقی) به زبان عامه مردم نیز رسیده و منتشر شده است؟"],[110,"من ز مسجد به خرابات نه خود افتادم","اینم از عهد ازل حاصل فرجام افتاد","من از مسجد (محل عبادت) به خرابات (محل معاصی و دل‌سپردگی به عشق) نیفتاده‌ام؛ بلکه این وضعیت نتیجه و سرنوشت ازلی من است که به وقوع پیوسته است."],[110,"چه کند کز پی دوران نرود چون پرگار؟","هر که در دایره گردش ایام افتاد","چه کار کند کسی که نمی‌تواند از دایره زمان خارج شود؟ هر کس که به گرداب تحول و تغییرات زندگی افتاد، مانند یک پرگار به دور خود می‌چرخد."],[110,"در خم زلف تو آویخت دل از چاه زنخ","آه، کز چاه برون آمد و در دام افتاد","دل من در حلقه‌های زلف تو گرفتار شده و از چاه عشق خارج شده است، اما دوباره در دام دیگری افتاده است."],[110,"آن شد ای خواجه که در صومعه بازم بینی","کار ما با رخ ساقیّ و لب جام افتاد","ای خواجه، عاقبت کاری که در صومعه انجام دادی، به جایی رسید که حالا باید به من و جمال ساقی و لب شراب توجه کنی."],[110,"زیر شمشیر غمش رقص‌کنان باید رفت","کـ‌آن که شد کشته او نیک سرانجام افتاد","زیر فشار اندوه و غم او باید با شادی و رقص پیش رفت، زیرا کسی که به عشق او کشته شود، به سرانجام خوبی دست پیدا می‌کند."],[110,"هر دمش با من دل‌سوخته لطفی دگر است","این گدا بین که چه شایسته انعام افتاد","هر لحظه محبت و نوازش او نسبت به من، که دل‌سوخته‌ام، متفاوت و جدید است. این مراسمی که من برگزار کرده‌ام، نشان‌دهنده شایستگی‌ام برای دریافت پاداش و انعام از اوست."],[110,"صوفیان جمله حریفند و نظرباز ولی","زین میان حافظ دل‌سوخته بدنام افتاد","صوفی‌ها (عارفان) همه با هم دوست و در حال تماشا هستند، اما در میان آن‌ها، حافظ که دلش شکسته و رنجیده است، بی‌اعتبار و بدنام شده است."],[111,"آن که رخسار تو را رنگ گل و نسرین داد","صبر و آرام تواند به من مسکین داد","کسی که صورت و چهره‌ات را به زیبایی گل و نسرین رنگین کرده، می‌تواند به من بیچاره صبر و آرامش ببخشد."],[111,"وان که گیسوی تو را رسم تطاول آموخت","هم تواند کرمش داد من غمگین داد","کسی که به موهای تو حالت زیبا و بلند را یاد داد، همان فرد می‌تواند با سخاوت خود، به من غمگین نیز لطف و احسان کند."],[111,"من همان روز ز فرهاد طمع ببریدم","که عنان دل شیدا به لب شیرین داد","من از همان روز که فرهاد به عشق شیرین دست از کام خود کشید و دلش را به شیرین سپرد، دیگر امید و آرزوی عاشقانه نداشتم."],[111,"گنج زر گر نبود، کنج قناعت باقیست","آن که آن داد به شاهان، به گدایان این داد","اگرچه ثروت و گنج زیاد و باارزش نیست، اما کمال قناعت و رضایت از آنچه داریم، باقی خواهد ماند. آن کس که نعمت و ثروت را به شاهان می‌دهد، به گدایان هم همین نعمت را می‌رساند."],[111,"خوش عروسیست جهان از ره صورت لیکن","هر که پیوست بدو، عمر خودش کاوین داد","جهان به خاطر زیبایی‌ها و جلوه‌های ظاهری‌اش مانند عروسی خوش است، اما کسی که به زیبایی‌ها وابسته شود، عمرش را صرف چیزهایی بی‌فایده کرده است."],[111,"بعد از این دست من و دامن سرو و لب جوی","خاصه اکنون که صبا مژده فروردین داد","حالا که نسیم بهاری بشارت خوشی و طراوت را آورده، دیگر دست من از دامن درخت سرو و لب جوی نمی‌کشد و این زیبایی‌ها را فراموش نمی‌کنم."],[111,"در کف غصه دوران، دل حافظ خون شد","از فراق رخت ای خواجه قوام الدین، داد","دل حافظ به خاطر دوری و جدایی از روی تو، ای خواجه قوام‌الدین، به شدت غمگین و مجروح شده است. در اینجا، حافظ به احساسات عمیق خود نسبت به فقدان محبوبش اشاره می‌کند."],[112,"بنفشه دوش به گل گفت و خوش نشانی داد","که تاب من به جهان، طرّه فلانی داد","بنفشه (گلی با عطر خوش) شب گذشته به گل دیگری گفت و نشانه‌ای خوب به او داد که طاقت من برای زندگی، به موهای آن شخص (فلانی) بستگی دارد."],[112,"دلم خزانه اسرار بود و دست قضا","درش ببست و کلیدش به دل‌ستانی داد","دل من مانند گنجینه‌ای مملو از رازها بود، اما تقدیر در آن را بست و کلیدش را به عاشقانی که دلشان را ربوده به داد."],[112,"شکسته‌وار به درگاهت آمدم، که طبیب","به مومیایی لطف توام، نشانی داد","با حالتی شکست‌خورده و ناتوان به درگاه تو آمده‌ام، زیرا طبیب (پروردگار یا عشق) نشانه‌ای از لطف تو به من داده است که شفا بخش من باشد."],[112,"تنش درست و دلش شاد باد و خاطر خوش","که دست دادش و یاری ناتوانی داد","تن و جسمش سالم و دلش شاد باشد و خاطرش خوش، زیرا که کسی به او کمک و یاری کرده است که خود ناتوان بوده است."],[112,"برو معالجه خود کن ای نصیحت‌گو","شراب و شاهد شیرین، که را زیانی داد؟","ای نصیحت‌گو، برو به فکر درمان خودت باش، چرا که شراب و معشوق خوش‌چهره به کسی ضرر نمی‌زد."],[112,"گذشت بر من مسکین و با رقیبان گفت","دریغ، حافظ مسکین من، چه جانی داد","حافظ به حال خود می‌گوید که با وجود مسکینی‌اش، برای دیگران از آزار و حسرتش می‌گوید و افسوس می‌خورد که چگونه او، حتی جانش را به این وضعیت داده است."],[113,"همای اوج سعادت به دام ما افتد","اگر تو را گذری بر مقام ما افتد","اگر پرنده خوشبختی و سعادت بر ما فرود آید، این اتفاق ممکن است تنها به خاطر این باشد که تو (معشوق) نگاهی به مقام و جایگاه ما بیندازی."],[113,"حباب‌وار براندازم از نشاط کلاه","اگر ز روی تو عکسی به جام ما افتد","از خوشحالی کلاه خود را به هوا می اندازم، اگر تصویری از چهره تو بر روی جام ما بیفتد."],[113,"شبی که ماه مراد از افق شود طالع","بود که پرتو نوری به بام ما افتد","شبی که ماه مورد نظر ما از افق طلوع کند، زمانی خوش و خوش‌یمن خواهد بود که نوری به خانه‌ی ما بتابد."],[113,"به بارگاه تو چون باد را نباشد بار","کی اتفاق مجال سلام ما افتد؟","در حالی که حتی باد اجازه‌ی ورود به جایگاه بالای تو را ندارد، من( من ضعیف) چه جوری میتونم برای عرض سلام خدمت برسم."],[113,"چو جان فدای لبش شد خیال می‌بستم","که قطره‌ای ز زلالش به کام ما افتد","دل من که جانش را فدای لب او کرده است، در خیال خود تصور می‌کند که نوشیدنی‌ای از آبی زلال لب او به کام ما برسد."],[113,"خیال زلف تو گفتا که جان وسیله مساز","کز این شکار، فراوان به دام ما افتد","تصور زلف تو به من گفت که جان خود را برای آن نگذار، زیرا از این شکار (محبت) بسیاری از دلبرها به دام ما خواهند افتاد."],[113,"به ناامیدی از این در مرو، بزن فالی","بود که قرعه دولت به نام ما افتد","از ناامیدی و ترک این در خارج نشو، چرا که با یک فال زدن، ممکن است شانس خوشبختی به نام ما نوشته شود."],[113,"ز خاک کوی تو هر گه که دم زند حافظ","نسیم گلشن جان در مشام ما افتد","بیت شماره 3: [شبی که ماه مراد از افق بخت سر بزنذ]، شاید پرتو نوری بر بام ما بیافتد."],[114,"درخت دوستی بنشان که کام دل به بار آرد","نهال دشمنی برکن که رنج بی‌شمار آرد","دوستی را کاشته و پرورش بده که به تو شادی و رضایت می‌دهد. دشمنی را دور کن زیرا باعث بی‌خودی و ناراحتی بسیار می‌شود."],[114,"چو مهمان خراباتی به عزت باش با رندان","که درد سر کشی جانا! گرت مستی خمار آرد","هنگامی که به میکده می روی با رندان که از بزرگان آنجا هستند با احترام برخورد کن که سر کشی کردن در مقابل آنها و دعوا با آنها باعث می شود اگر اکنون سرخوش و مست هستی ، مستی از سر تو می‌پرد و خمار بشوی"],[114,"شب صحبت غنیمت دان که بعد از روزگار ما","بسی گردش کند گردون، بسی لیل و نهار آرد","شب را غنیمت بشمار، چون پس از روزگار ما، زمان بسیار خواهد گذشت و روز و شب زیادی خواهد آمد."],[114,"عماری‌دار لیلی را که مهد ماه در حکم است","خدا را در دل اندازش که بر مجنون گذار آرد","خدایا در دل کجاوه دار یا ساروان لیلی که کجاوه اش مانند مهد ماه است بنداز که کجاوه را به سمت مجنون ببرد و سری به او بزند"],[114,"بهار عمر خواه ای دل! و گر نه این چمن هر سال","چو نسرین صد گل آرد بار و چون بلبل هزار آرد","ای دل! از زندگی لذت ببر و از جوانی خود بهره‌مند شو، زیرا این باغ هر سال گل‌های زیبا و فراوانی مانند نسرین و صد گل دیگر می‌آورد و بلبل هم آواز هزاران را به گوش می‌رساند."],[114,"خدا را چون دل ریشم قراری بست با زلفت","بفرما لعل نوشین را که زودش با قرار آرد","خدا را، از آنجا که دل من شکستگی و غمی دارد، از تو می‌خواهم که با موهایت و زیبایی‌ات، لبت را به من بدهی تا زود آرامش یابم."],[114,"در این باغ از خدا خواهد دگر پیرانه‌سر، حافظ","نشیند بر لب جویی و سروی در کنار آرد","در این باغ، خداوند می‌خواهد که حافظ، با سن بالا، بر لب جویی بنشیند و در کنارش یک سرو (درخت نازک و خوش‌نما) قرار گیرد."],[115,"کسی که حسن و خط دوست در نظر دارد","محقق است که او حاصل بصر دارد","کسی که زیبایی و خط دوست را می‌بیند، به‌راستی دارای بینش و بصیرت است."],[115,"چو خامه در ره فرمان او، سر طاعت","نهاده‌ایم مگر او به تیغ بردارد","ما مانند قلم در برابر دستورات او تسلیم شده‌ایم، ولی آیا او ما را به قتل نمی‌رساند؟"],[115,"کسی به وصل تو چون شمع یافت پروانه","که زیر تیغ تو هر دم سری دگر دارد","کسی که به وصالت مانند شمع عشق می‌ورزد، هر لحظه تحت فشار و سختی تو، دلی دیگر و احساس تازه‌ای دارد."],[115,"به پای‌بوس تو دست کسی رسید که او","چو آستانه بدین در، همیشه سر دارد","کسی به حضور و به پای‌بوس تو می‌رسد که همچون آستانه در‌، سر خود را در قدم تو بنهد. (آستانه ، در اینجا یعنی قسمت پایین چارچوب در )"],[115,"ز زهد خشک ملولم‌، کجاست باده ناب‌؟","که بوی باده مدامم دماغ تر دارد","من از زهد خشک و بی‌روح خسته‌ام و به دنبال شراب پاک و خوشبو هستم، زیرا بوی شراب همیشه در بینی‌ام حس می‌شود و مرا به خود جذب می‌کند."],[115,"ز باده هیچت اگر نیست، این نه بس که تو را","دمی ز وسوسه عقل بی‌خبر دارد؟","اگر از باده چیزی نداری، این برای تو کافی نیست که گاهی از وسوسه‌های عقل بی‌خبر باشی؟"],[115,"کسی که از ره تقوا قدم برون ننهاد","به عزم میکده اکنون ره سفر دارد","کسی که همواره به تقوا و پرهیز‌گاری معروف بوده، اکنون قصد رفتن به میکده دارد."],[115,"دل‌ شکسته حافظ به خاک خواهد برد","چو لاله، داغ هوایی‌، که بر جگر دارد","حافظ‌، دل‌‌ شکسته و داغدارش را به خاک خواهد برد همچون لاله که بر دلش داغ هوا و آرزویی مانده است."],[116,"دل ما به دور رویت ز چمن فراغ دارد","که چو سرو پایبند است و چو لاله داغ دارد","تا دل ما به تو مشغول است هوای چمن و گلزار نمی‌کند زیرا همچون سرو که پای‌بسته است پایبند عشق تو است و همچون لاله که داغدار است هواخواه توست."],[116,"سر ما فرونیآید به کمان ابروی کس","که درون گوشه‌گیران، ز جهان فراغ دارد","به زیبایی گوشه و اشاره ابروی کمان‌ابرویان توجه نمی‌کنیم تا در میان گوشه‌گیران و افتادگان تو، از جهان و کار جهان فارغ شده‌ایم."],[116,"ز بنفشه تاب دارم که ز زلف او زند دم","تو سیاه کم‌بها بین، که چه در دماغ دارد‌!","از دست بنفشه خشمگین هستم که زیبایی زلف خود را با زیبایی زلف تو مقایسه می‌کند‌، این سیاه‌روی گستاخ چه ادعاهایی دارد!؟ (تاب دارم‌: بر‌آشفته هستم)"],[116,"به چمن خرام و بنگر بر تخت گل که لاله","به ندیم شاه ماند که به کف ایاغ دارد","به طرف چمن و گلزار رو و در آنجا ببین که لاله همچون خدمتکار شاه‌‌، جام در دست گرفته است. (ایاغ یعنی جام و پیاله شراب‌خواری)"],[116,"شب ظلمت و بیابان، به کجا توان رسیدن؟","مگر آن که شمع روی‌ات به رهم چراغ دارد","این راه‌، همچون بیابان‌، بی‌انتهاست و همچون شب‌، تاریک‌؛ تنها شمع روی و چهره زیبای تو می‌تواند راه را برایم روشن کند و راه را به من بنماید."],[116,"من و شمع صبح‌گاهی سزد ار به هم بگرییم","که بسوختیم و از ما بت ما فراغ دارد","من و شمع سوخته صبح‌، شایسته است که برای همدیگر بگرییم و بر درد هم بسوزیم زیرا تمام شب را سوختیم و یار به ما توجهی نکرد. (در اینجا شمع‌، تصویری از شمع‌هایی که در پای بت‌ها می‌سوزند را نیز منعکس می‌کند)"],[116,"سزدم چو ابر بهمن که بر این چمن بگریم","طرب آشیان بلبل، بنگر که زاغ دارد","جای دارد که همچون ابر بهمنی فراوان بگریم زیرا در چمن‌، بجای بلبل خوش‌خوان‌، زاغ آشیانه کرده است."],[116,"سر درس عشق دارد دل دردمند حافظ","که نه خاطر تماشا نه هوای باغ دارد","دل دردمند حافظ قصد و هوس آموختن درس عشق دارد و هوس گشت و گذار و رفتن به باغ را ندارد."],[117,"آن کس که به دست جام دارد","سلطانی جم مدام دارد","هر کس که مست است و باده می‌نوشد‌، سلطانی و شاهی جمشید را همیشگی دارد."],[117,"آبی که خضر حیات از او یافت","در میکده جو‌ که جام دارد","آن آب حیات که خضر از او زندگی جاودانه یافت را در می‌کده جستجو کن و آنرا از پیاله شراب بخواه."],[117,"سررشته جان به جام بگذار","کاین رشته از او نظام دارد","کار و سر رشته جان را به می و باده بگذار زیرا جان بر مستی قوام یافته و از او آفریده شده است."],[117,"ما و می و زاهدان و تقوا","تا یار، سر کدام دارد","قسمت ما می و باده شده است و قسمت زاهدها‌، تقوا و پرهیزگاری تا میل و انتخاب یار کدام باشد."],[117,"بیرون ز لب تو ساقیا نیست","در دور، کسی که کام دارد","هر کس که مست است و خوش و شاد گشته است بجز از مستی و کرامت لب‌های تو نیست ای ساقی."],[117,"نرگس، همه شیوه‌های مستی","از چشم خوشت به وام دارد","گل نرگس و چشم‌های مست همگی یک گوشه و کرشمه از چشم‌های زیبای تو را به قرض گرفته‌اند."],[117,"ذکر رخ و زلف تو دلم را","وردی‌ست که صبح و شام دارد","وصف رخ زیبا و موی سیاه تو ورد زبان دل من است و دلم هر سپیده‌دم و شامگاه به یاد توست."],[117,"بر سینه ریش دردمندان","لعلت نمکی تمام دارد","آن لب‌های سرخ تو هر دم دل عاشقان و دردمندان را بیشتر می‌سوزاند."],[117,"در چاه ذقن چو حافظ ای جان","حسن تو دو صد غلام دارد","زیبایی تو در یک قلم و فقط دویست غلام و چاکر همچون حافظ کشته‌مرده زیبایی چاه چانه دارد."],[118,"دلی که غیب‌نمای است و جام جم دارد","ز خاتمی که دمی گم شود، چه غم دارد؟","دلی که آیینه شاهی گشته‌است و خود جام جم گشته، اگر زمانی خاتم شاهی از او گم شود؛ چه کم دارد و چه غم دارد؟"],[118,"به خطّ و خال گدایان مده خزینه دل","به دست شاهوشی ده که محترم دارد","گنج دل را به گدایان حیله‌گر مسپار؛ آن‌را به زیبا و شاه‌منشی بده که قدرش را بداند."],[118,"نه هر درخت تحمّل کند جفای خزان","غلام همت سروم که این قدم دارد","هر درختی نمی‌تواند سختی پاییز را تحمل کند؛ بنده بلند‌نظری و همّت سرو هستم که رهرو این مرام است."],[118,"رسید موسم آن کز طرب چو نرگس مست","نهد به پای قدح هر که شش درم دارد","فصل باده‌نوشی رسید؛ فصلی که می‌گساران با چشم‌های خمار‌، سکه‌هایشان را در پای قدح باده می‌نهند. (شش‌درهم دارد: یعنی هرکس حداقل را دارد و می‌تواند باده بخرد)"],[118,"زر از بهای می اکنون چو گل دریغ مدار","که عقل کل به صدت عیب متّهم دارد","اگر از پول و زر برای خریدن باده دریغ کنی، آدم دانا و عاقل تو را به‌صد عیب متهم می‌کند."],[118,"ز سرّ غیب، کس آگاه نیست؛ قصّه مخوان","کدام محرم دل ره در این حرم دارد؟","درباره سرّ غیب و رازهای غیب حرف مزن و قصه مگو؛ کیست که می‌تواند ادعا کند که بدان راز، آگاه گشته است؟"],[118,"دلم که لاف تجرّد زدی، کنون صد شغل","به بوی زلف تو با باد صبحدم دارد","من که هزار لاف از «تجرّد» می‌زدم از وقتی که عطر زلف تو را شنیده‌ام، صد دلبستگی پیدا کرده‌ام. (تجرّد و شغل از اصطلاحات صوفیانه است)"],[118,"مراد دل ز که پرسم؟ که نیست دلداری","که جلوه نظر و شیوه کرم دارد","از چه‌کسی آرزو و مراد دلم را بخواهم؟ زیرا دلدار و محرمی نیست که فهیم و آگاه باشد و سخاوتمند."],[118,"ز جیب خرقه حافظ چه طرف بتوان بست","که ما صمد طلبیدیم و او صنم دارد","از حافظ چه سود می‌رسد؟ زیرا ما خدا طلبیدیم و او بتی زیبارو دارد!"],[119,"بتی دارم که گرد گل ز سنبل سایه‌بان دارد","بهار عارضش خطّی به خون ارغوان دارد","دلبر زیبارویی دارم که موهای مجعد و انبوهش همانند سنبل اطراف صورت همانند گل او را مثل سایه بانی احاطه کرده اند و چهره ی او که نوبهار است ( اشاره به نوجوان بودن ) یک خط نازک به رنگ ارغوانی ( قرمز تیره و بسیار جذاب) را داراست و یا بهار عارضش فرمانی برای ریختن خون شکوفه ارغوان دارد( صنعت ایهام : خط:خط سبزه و یا دست نوشته و فرمان همچنین مشخص است که معشوق نیز نوجوانی مذکر می باشد)"],[119,"غبار خط بپوشانید خورشید رخش یا رب","بقای جاودانش ده، که حسن جاودان دارد","این چهره درخشان آنچنان تابان و روشن است که آن خط ارغوانی ظریف ( که در بیت قبل از جلوه گر بودن آن گفته شده ) همانند غباری است که توانایی پوشاندن درخشندگی آن خورشید را ندارد و از خداوند می خواهد که به خاطر این زیبایی که لیاقت جاودانگی دارد به او عمر همیشگی دهد."],[119,"چو عاشق می‌شدم گفتم که بردم گوهر مقصود","ندانستم که این دریا چه موج خون‌فشان دارد","آن زمان که تازه پا به عرصه عاشقی میگذاشتم پنداشتم که گوهر مقصود ( وصال یا معشوق ) را به دست آورده ام( اطمینان کاذب ) اما دریای عشق در ظاهر آرام است اما باطنی طوفانی با موج هایی خون افشان ( رنج ها و بلایای راه عشق ) دارد ( که عشق آسان نمود اول ولی افتاد مشکل ها )"],[119,"ز چشمت جان نشاید برد کز هر سو که می‌بینم","کمین از گوشه‌ای کرده‌ست و تیر اندر کمان دارد","از گزند نگاه کشنده و افسونگر تو نمی توان جان سالم به در برد زیرا به هر طرف که نگاه میکنم میبینم که در گوشه ای کمین کرده و آماده ی پرتاب تیر نگاه از کمان ابروان است ."],[119,"چو دام طرّه افشاند ز گرد خاطر عشاق","به غمّاز صبا گوید که راز ما نهان دارد","زلف معشوق همانند دام و فکر و آنچه در دل عشاق می گذرد مثل گردیست که در پیچ و خم زلف او گرفتار می شود و زمانی که موی خود را می افشاند این گرد پراکنده می شود به باد صبا که خبررسان است بگویید گرد راز عشق ما را پنهان کند و آن را فاش نکند."],[119,"بیفشان جرعه‌ای بر خاک و حال اهل دل بشنو","که از جمشید و کیخسرو، فراوان داستان دارد","هنگام نوشیدن شراب جرعه ای از آن را بر خاک به یاد اهل دل بریز و بی خودی خود را با خاک شریک شو زیرا این خاک داستان های فراوانی از سرگذشت صاحبان قدرت همانند جمشید و کیخسرو را داراست ( یعنی دنیا بی اعتبار است و خاک بهترین گواه این مدعا)"],[119,"چو در رویت بخندد گل، مشو در دامش ای بلبل","که بر گل اعتمادی نیست، گر حسن جهان دارد","زمانی که گل به روی تو می‌خندد و روی خوش نشان می دهد در دام زیبایی فریبنده آن نیفت زیرا اگر تمام زیبایی های جهان را هم داشته باشد نمی توان به آن اعتماد کرد چون هم این زیبایی ظاهری است و هم ناپایدار"],[119,"خدا را، داد من بستان از او ای شحنه مجلس","که می با دیگری خورده‌ست و با من سر گران دارد","ای حاکم و مدیر مجلس به خاطر خدا داد من را از او بگیر زیرا شادی و می خوردنش را با دیگری انجام داده و سرسنگینی و خماریش را برای من آورده است."],[119,"به فتراک ار همی‌بندی خدا را زود صیدم کن","که آفت‌هاست در تأخیر و طالب را زیان دارد","راهنما_ اریس : حتی شده اگر به بند طناب ببندی و من رو با درد و رنج دنبال خودت رو زمین بکشی ، باز من راضیم . چون اگر در جریان مشاهده گری و جذب شدن ، سالک به موقع جذب نشه آفاتی همچو خواب آلودگی و خستگی و بی رمقی و بی حوصلگی به سراغش میاد ."],[119,"ز سرو قدّ دلجویت مکن محروم چشمم را","بدین سرچشمه‌اش بنشان که خوش آبی روان دارد","راهنما_ اریس : مرا از قد و بالای خودت که همچو سروی مقاوم و پایدار هست محروم نکن و آنچنان همچو سرو ، پایدار و مقاوم شو که من نتونم از جلوی تو تکون بخورم و در آخر من رو جذب خودت کن تا وارد رود جانا بشم"],[119,"ز خوف هجرم ایمن کن اگر امّید آن داری","که از چشم بداندیشان خدایت در امان دارد","راهنما_ اریس : از ترس اینکه تو ناپدید بشی و یا جذب تو نشم ، من رو ایمن کن و بهم اطمینان بده که این کارها رو نمی کنی تا از چشم اونهائی کها به رویت تو در دل و جذب شدن به تو شک دارند و ایمان ندارند ، حفظ بشی"],[119,"چه عذر بخت خود گویم؟ که آن عیّار شهرآشوب","به تلخی کشت حافظ را و شکّر در دهان دارد","راهنما_ اریس : از بخت بد خودم چی بگم که ان دزد راهزن که دل رو بهم می ریزه ، ،باز این بار حافظ رو جذب خودش نکرد و حتی برای یک لحظه هم جذبش نشدم تا بوسه به بر آن لب شکر بزنم و یک لحظه شیرینی جاناها رو بچشم"],[120,"هر آن کاو خاطر مجموع و یار نازنین دارد","سعادت، همدم او گشت و دولت، هم‌نشین دارد","هر کسی که به یاد دلنشین و یار محبوبش باشد، خوشبخت است و خوشی به او نزدیک می‌شود و ثروت نیز با او همراه می‌شود."],[120,"حریم عشق را درگه، بسی بالاتر از عقل است","کسی آن آستان بوسد، که جان در آستین دارد","حریم عشق، یعنی مکان ویژه و مقدس عشق، جایگاه بسیار بلندتری از عقل دارد. تنها کسی می‌تواند در این درگاه (عشق) سر به خاک بگذارد که جانش را در آستین دارد، یعنی کسی که شجاعت و آمادگی برای فدا کردن خود را دارد."],[120,"دهان تنگ شیرینش، مگر ملک سلیمان است","که نقش خاتم لعلش، جهان، زیر نگین دارد؟","دهان باریک و شیرین او، آیا به مانند سرزمین سلیمان نیست که نقش انگشتر او، جهان را تحت فرمان خود دارد؟"],[120,"لب لعل و خط مشکین، چو آنش هست و اینش هست","بنازم دلبر خود را، که حسنش، آن و این دارد","لب‌هایش مانند لعل و خط او همچون مشک است، هر کدام زیبایی خاصی دارند؛ اما من به دلبر خود افتخار می‌کنم، زیرا زیبایی او هم لعل دارد و هم مشک."],[120,"به خواری منگر ای منعم، ضعیفان و نحیفان را","که صدر مجلس عشرت، گدای ره‌نشین دارد","ای بخشنده، مبادا بر ناتوانان و ضعیفان بی‌اعتنا باشی، زیرا در جمع ما گدایانی هستند که در این مجلس مهمانی جایگاه ویژه‌ای دارند."],[120,"چو بر روی زمین باشی، توانایی، غنیمت دان","که دوران، ناتوانی‌ها، بسی زیر زمین دارد","در حالی که بر روی زمین زندگی می‌کنی و توانایی داری، از این فرصت بهره‌برداری کن؛ زیرا در دوران، ضعف‌ها و ناتوانی‌های زیادی در زیر سطح زمین وجود دارد."],[120,"بلاگردان جان و تن، دعای مستمندان است","که بیند خیر از آن خرمن که ننگ از خوشه‌چین دارد؟","آسیب و مشکلاتی که جان و جسم انسان را تهدید می‌کند، دعا و خواسته‌ی کسانی است که می‌خواهند از زندگی خوب و خوش برخوردار شوند. بهتر است که کسی به خوشی و ثمربخشی نیکویی‌ها نگاه کند که از سرنوشت خود راضی بوده و از دیگران بی‌نیاز است."],[120,"صبا از عشق من، رمزی بگو با آن شه خوبان","که صد جمشید و کیخسرو، غلام کم‌ترین دارد","بادی که از عشق من می‌وزد، رازی برای آن پادشاه زیبایانی بگو که حتی صد نفر مثل جمشید و کیخسرو، به خدمت فردی ناچیز مثل من در آمده‌اند."],[120,"وگر گوید نمی‌خواهم، چو «حافظ»، عاشق مفلس","بگوییدش که سلطانی، گدایی هم‌نشین دارد","اگر او بگوید که عاشق فقیری مقل حافظ نمی‌خواهد، به او بگویید که سلطان هم گدایی همنشین خود دارد."],[121,"هر آن‌که جانب اهل خدا نگه دارد","خداش در همه حال از بلا نگه دارد","هرکسی که از اهل ایمان [و دین خداوند و اعتقادات] طرفداری و حمایت کند [طرفشان را بگیرد]، خداوند او را در تمامی لحظات از بلا و درد محافظت و دور خواهد کرد."],[121,"حدیث دوست نگویم مگر به حضرت دوست","که آشنا، سخن آشنا نگه دارد","من فقط درباره دوستی و محبت با کسی صحبت می‌کنم که خود او در کنارم حضور دارد، زیرا یک دوست واقعی می‌تواند رازها و سخنان صمیمی را حفظ کند."],[121,"دلا، معاش چنان کن که گر بلغزد پای","فرشته‌ات به دو دست دعا نگه دارد","ای دل، زندگی را به گونه‌ای بگذران که اگر روزی پایت لغزید و خطایی کردی، فرشته‌ای که مراقب توست برایت دعا کند و با همان دعا تو را از لغزش بازدارد"],[121,"گرت هواست که معشوق نگسلد پیمان","نگاه دار سر رشته تا نگه دارد","اگر دوست داری معشوق به پیمان عشق وفادار باشد ، تو نیز رسم وفا را نگاه دار یا سر رشته عشق را رها نکند تا او هم نگه دارد . در ضمن استاد بهاالدین خرمشاهی در کتاب حافظ حافظه ماست معتقد است این بیت به آیه (فاذکرونی اذکرکم ۱۵۲ بقره) اشاره دارد"],[121,"صبا بر آن سر زلف ار دل مرا بینی","ز روی لطف بگویش که جا نگه دارد","اگر بادی بر آن موی معشوق بوزد و دل من را به او ببینی، از روی محبت به او بگو که دل مرا در جای خود نگه دارد."],[121,"چو گفتمش که دلم را نگاه دار، چه گفت؟","ز دست بنده چه خیزد؟ خدا نگه دارد","وقتی به او گفتم که دل‌ام را حفظ کند، او چه جوابی داد؟ مگر از من، این بنده، چه کاری برمی‌آید؟ خدا او را حفظ کند."],[121,"سر و زر و دل و جانم، فدای آن یاری","که حقّ صحبت مهر و وفا نگه دارد","تمام وجودم را [جان و مال و احساسات و قلبم] فدای آن کسی می کنم که به پیمان محبت و وفاداری بین یار پایبنده باشد."],[121,"غبار راهگذارت کجاست تا «حافظ»","به یادگار نسیم صبا نگه دارد","غبار راهگذارت کجاست تا حافظ به یادگار از نسیم صبحگاهی نگه‌داری کند؟ منظور این است که حافظ به دنبال نشانه‌ای از معشوق است تا یاد و خاطره‌اش را زنده نگه دارد."],[122,"مطرب عشق عجب ساز و نوایی دارد","نقش هر نغمه که زد راه به جایی دارد","مطرب عشق‌، عجب خوش‌صدا و خنیاگر ماهری است که هر آهنگ که می‌زند به‌جایی راه دارد."],[122,"عالم از ناله عشّاق مبادا خالی","که خوش‌آهنگ و فرح‌بخش هوایی دارد","(آرزو دارم) دنیا از عاشقان خالی نشود زیرا دنیا با عاشقان خوش و فرح‌بخش است."],[122,"پیر دردی‌کش ما گرچه ندارد زر و زور","خوش عطابخش و خطاپوش خدایی دارد","پیر و مرشد دائم‌الخمر ما اگرچه پول و مقام ندارد اما خدایی خطاپوش و بخشنده دارد."],[122,"محترم دار دلم کاین مگس قندپرست","تا هواخواه تو شد فرّ همایی دارد","دل مرا گرامی بدار زیرا اگرچه یک مگس است که به‌هوای قند تو آمده‌، اما در اثر این عشق‌، همچون هما باشکوه گشته‌است."],[122,"از عدالت نبود دور گرش پرسد حال","پادشاهی که به همسایه گدایی دارد","اگر پادشاهی از همسایه گدای خود حالی بپرسد، از عدالتش دور نیست."],[122,"اشک خونین بنمودم به طبیبان گفتند","درد عشق است و جگرسوز دوایی دارد","اشک خونین خود را به پزشکان نشان دادم؛ گفتند: درد عاشقی است و دوای آن بسیار جگرسوز و دردآور است."],[122,"ستم از غمزه میاموز که در مذهب عشق","هر عمل اجری و هر کرده جزایی دارد","راه ستم غمزه را در پیش مگیر که هر کار خوب پاداشی و هر کرده بد مجازاتی دارد."],[122,"نغز گفت آن بت ترسابچه باده‌پرست","شادی روی کسی خور که صفایی دارد","چه زیبا گفت آن زیباروی ترسازاده باده‌پرست وقتی‌که گفت: به‌شادی روی آدم‌های باصفا بنوش!"],[122,"خسروا حافظ درگاه‌نشین فاتحه خواند","وز زبان تو تمنای دعایی دارد","پادشاها! حافظ درگاه‌نشین تو فاتحه خواند و از زبان تو دعای خیری طلب می‌کند."],[123,"آن که از سنبل او، غالیه تابی دارد","باز با دلشدگان ناز و عتابی دارد","آن‌کسی که غالیه خوش‌بو عاشق سنبل زلفش گشته، باز با عاشقانش ناز و عتاب آغاز کرد."],[123,"از سر کشته خود می‌گذری همچون باد","چه توان کرد؟ که عمر است و شتابی دارد","به عاشق و کشته خود توجه نمی‌کنی و همچون باد می‌گذری؛ چه‌توان کرد؟ عمرم است و به‌شتاب می‌گذرد."],[123,"ماه خورشید نمایش ز پس پرده زلف","آفتابیست که در پیش سحابی دارد","ماه چهره‌ی او در کنار زلف سیاهش همچون خورشید در پیش ابر سیاه می‌درخشد"],[123,"چشم من کرد به هر گوشه روان سیل سرشک","تا سهی سرو تو را تازه‌تر آبی دارد","چشمم همچون جویی روان گشته تا سرو قامت زیبای تو را آبیاری کند."],[123,"غمزه شوخ تو خونم به خطا می‌ریزد","فرصتش باد که خوش فکر صوابی دارد","غمزه گستاخ تو که خون مرا می‌ریزد پیروز بادا که فکر درستی در سر دارد."],[123,"آب حیوان اگر این است که دارد لب دوست","روشن است این که خضر بهره سرابی دارد","در مقایسه با آب حیات که لب دوست دارد، بی‌شک خضر به سراب رسیده‌است."],[123,"چشم مخمور تو دارد ز دلم قصد جگر","ترک مست است مگر میل کبابی دارد","چشم مستت قصد جگر مرا کرده، گویی ترک مستی‌است که میل کباب کرده‌است."],[123,"جان بیمار مرا نیست ز تو روی سؤال","ای خوش آن خسته که از دوست جوابی دارد","جان بیمار من از تو روی سؤال ندارد؛ خوشا بیماری که از یارش جوابی دارد."],[123,"کی کند سوی دل خسته حافظ نظری","چشم مستش که به هر گوشه خرابی دارد","چشم مست او کی به حافظ توجه می‌کند وقتی که در هر گوشه و غمزه‌ای عاشقی دارد؟"],[124,"شاهد آن نیست که موییّ و میانی دارد","بنده طلعت آن باش که آنی دارد","زیبایی فقط به داشتن مو و چهره دل‌ربا نیست، بلکه باید به سوی کسی رفت که حقیقتا زیبایی و لطافت دارد."],[124,"شیوه حور و پری گرچه لطیف است ولی","خوبی آن است و لطافت که فلانی دارد","زیبایی و لطافت حور و پری هرچند بسیار ظریف و دلنشین است، اما آنچه واقعا زیبایی و لطافت را رقم می‌زند، زیبایی و لطافتی است که فلانی (معشوق) دارد."],[124,"چشمه چشم مرا ای گل خندان دریاب","که به امّید تو خوش آب روانی دارد","ای گل خندان، چشمان من را دریاب، زیرا آنها به خاطر تو و امید به تو، شاداب و سرزنده شده‌اند."],[124,"گوی خوبی که برد از تو؟ که خورشید آن جا","نه سواریست که در دست عنانی دارد","بهتر از تو کیست که با زیبایی‌اش به دل کسی راه پیدا کند؟ چون خورشید، درخشان و فوق‌العاده است و در دست کسی قرار نمی‌گیرد تا بتوان آن را مهار کرد."],[124,"دل نشان شد سخنم تا تو قبولش کردی","آری آری سخن عشق نشانی دارد","دل من در حضور تو آشکار شد و نشان عشق را با سخنانی که گفتم، درک کرده‌ای. بله، سخن عشق همیشه نشانه‌ای دارد که باید به آن توجه کرد."],[124,"خم ابروی تو در صنعت تیراندازی","برده از دست هر آن کس که کمانی دارد","خم ابروی تو مانند تیر در تیراندازی، قدرت و دقتی دارد که هر کسی با کمان نیز نتوانسته به آن دست یابد. این بیان اشاره به زیبایی و جذابیت ابروی معشوق دارد که می‌تواند دل‌ها را هدف قرار دهد."],[124,"در ره عشق نشد کس به یقین محرم راز","هر کسی بر حسب فکر، گمانی دارد","در راه عشق، هیچ‌کس به‌طور قطع به رازهای عشق آگاه نیست؛ هر فرد بسته به افکار و دیدگاه‌های خود، گمان‌هایی درباره آن دارد."],[124,"با خرابات نشینان ز کرامات ملاف","هر سخن وقتی و هر نکته مکانی دارد","هر سخن و نکته‌ای که در میخانه و نزد شراب‌نوشان (خرابات‌نشینان) گفته می‌شود، به زمان و مکان خاصی مربوط می‌شود و با کمال زندگی و شخصیت (کرامات) ملامتی که در آنجا حضور دارد، در ارتباط است."],[124,"مرغ زیرک نزند در چمنش پرده سرای","هر بهاری که به دنباله، خزانی دارد","پرنده زیرک در باغ خود حجاب نمی‌زند، زیرا هر فصلی که بهار به وجود می‌آورد، به دنبال خود پاییز را نیز دارد."],[124,"مدعی گو لغز و نکته به حافظ مفروش","کلک ما نیز زبانی و بیانی دارد","مدعی (حسود یا رقیب) نگوید که اصطلاحات و نکات شعر حافظ را کم ارزش بدان، زیرا خود ما نیز زبانی و بیان خاصی داریم که ارزشمند است."],[125,"جان بی‌جمال جانان، میل جهان ندارد","هر کس که این ندارد حقّا که آن ندارد","دل انسان بدون جمال و زیبایی معشوق هیچ علاقه‌ای به دنیا ندارد، و کسی که چنین احساسی را ندارد، به‌راستی چیزی از ارزش‌های واقعی را در اختیار ندارد."],[125,"با هیچ کس نشانی زان دلستان ندیدم","یا من خبر ندارم یا او نشان ندارد","من با هیچ‌کس نشانی از آن محبوب دلربا ندیدم؛ یا من از او بی‌خبرم یا او هیچ نشانی از خود نمی‌دهد."],[125,"هر شبنمی در این ره صد بحر آتشین است","دردا که این معما شرح و بیان ندارد","هر شبنم (قطره‌ی شبنم) در این مسیر (زندگی یا عشق) نشان‌دهنده‌ی صدها دریا (بحر) از آتش و درد است، وای از این که این معما (مسیر دشوار) هیچ توضیح و بیان روشنی ندارد."],[125,"سرمنزل فراغت نتوان ز دست دادن","ای ساروان فروکش کاین ره کران ندارد","ای راهنما، سرمنزل آرامش و آسایش را نمی‌توان به آسانی از دست داد. بگذار تا آرامش در دل و جان بماند، چرا که این مسیر پایان و کران مشخصی ندارد."],[125,"چنگ خمیده‌قامت می‌خواندت به عشرت","بشنو که پند پیران هیچت زیان ندارد","هرگاه چنگ خمیده‌قامت می‌نوازد و تو را به خوشی و شادمانی دعوت می‌کند، باید به آن گوش بسپاری، زیرا نصیحت‌های سالمندان هیچ ضرری برای تو ندارد."],[125,"ای دل طریق رندی از محتسب بیاموز","مست است و در حق او کس این گمان ندارد","ای دل، زیرکی و رندی را از محتسب یاد بگیر که مست است اما هیچ کس در این مورد به او شک نمی‌کند."],[125,"احوال گنج قارون کایّام داد بر باد","در گوش دل فروخوان تا زر نهان ندارد","احوال گنج قارون، شخصیتی افسانه‌ای که بسیار ثروتمند بود، به روزگار گذشت و نابود شد. این را در دل خود به یاد داشته باش که هیچ ثروت نهانی جاودانه نیست."],[125,"گر خود رقیب شمع است اسرار از او بپوشان","کان شوخ سربریده بند زبان ندارد","اگر‌ محافظ تو ادعای عاشقی و دلبستگی به تو می کند، تو اسرار عشق و عاشقی ات را به او نگو، زیرا او رازهای تو را فاش میکند و به همه می گوید."],[125,"کس در جهان ندارد یک بنده همچو حافظ","زیرا که چون تو شاهی کس در جهان ندارد","هیچکس در دنیا ندارد بنده‌ای مانند حافظ؛ زیرا کسی مانند تو که شاهی باشد، در دنیا وجود ندارد."],[126,"روشنی طلعت تو ماه ندارد","پیش تو گل، رونق گیاه ندارد","زیبایی چهره تو مانند ماه نیست و در مقایسه با تو، گل هیچ جاذبه و زیوری ندارد."],[126,"گوشه ابروی توست منزل جانم","خوشتر از این گوشه، پادشاه ندارد","گوشه ابروی تو، جایی است که جانم به آن تعلق دارد و از این مکان زیباتر و باارزش‌تر، هیچ پادشاهی وجود ندارد."],[126,"تا چه کند با رخ تو دود دل من","آینه دانی که تاب آه ندارد","دود دل من چه تاثیری بر چهره زیبای تو می‌گذارد، آیا می‌دانی که آینه توانایی تحمل آه و غم من را ندارد؟"],[126,"شوخی نرگس نگر که پیش تو بشکفت","چشم دریده، ادب نگاه ندارد","نرگس به زیبایی و ظرافت خود اشاره می‌کند که در برابر تو به خود می‌بالد و چشم‌های عاشق، بی‌ادبانه و با بی‌پروا به تو نگاه می‌کنند."],[126,"دیدم و آن چشم دل‌سیه که تو داری","جانب هیچ آشنا نگاه ندارد","من آن چشم دل‌سیاه تو را دیدم که هیچ‌کس دیگری را نمی‌بیند و به هیچ آشنا توجه نمی‌کند."],[126,"رطل گرانم ده ای مرید خرابات","شادی شیخی که خانقاه ندارد","رطل‌: جام و پیاله شراب."],[126,"خون خور و خامش نشین که آن دل نازک","طاقت فریاد دادخواه ندارد","آرام باش و چیزی نخور که آن دل آسیب‌پذیر، توان شنیدن فریاد و دادخواهی را ندارد."],[126,"گو برو و آستین به خون جگر شوی","هر که در این آستانه راه ندارد","اگر کسی در این مکان و در جوار محبوب حقیقی راه ندارد، باید برود و در دردی عمیق همچون خون جگر فرو رود."],[126,"نی من تنها کشم تطاول زلفت","کیست که او داغ آن سیاه ندارد؟","تطاول‌: درازدستی‌، جور‌، بیداد."],[126,"حافظ اگر سجده تو کرد مکن عیب","کافر عشق ای صنم گناه ندارد","اگر حافظ به خاطر عشقش در برابر تو سجده کند، نباید به او ایراد بگیری چون عاشق بودن در عشق گناه محسوب نمی‌شود، ای معشوق."],[127,"نیست در شهر نگاری که دل ما ببرد","بختم ار یار شود رختم از این جا ببرد","در این شهر زیبارویی نیست که دل ما را ببرد ، بخت اگر کمکم کند، من را از اینجا ببرد ( شاید در حالی دیگر چنین یاری پیدا کردم)"],[127,"کو حریفی کش سرمست که پیش کرمش","عاشق سوخته‌دل، نام تمنا ببرد","کو یاری که او چنان سر‌مست و با کرم و بخشش باشد که یک عاشق سوخته‌دل (مهجور) از او درخواست و تمنایی (وصال) داشته باشد؟"],[127,"باغبانا ز خزان، بی‌خبرت می‌بینم","آه از آن روز که بادت گل رعنا ببرد","ای باغبان و صاحب باغ‌، تو را (مغرور‌) و بی‌خبر از قضا و تقدیر خزان می‌بینم‌، وای بر روزی که گل‌های رعنا و دلکش تو را باد پاییزی ببرد."],[127,"رهزن دهر نخفته‌ست، مشو ایمن از او","اگر امروز نبرده‌ست که فردا ببرد","راهزن روزگار هرگز خواب نیست، پس از او احساس امنیت نکن! اگر امروز تو را نبرده است، مطمئن باش که فردا خواهد برد."],[127,"در خیال، این همه لعبت به هوس می‌بازم","بو که صاحب‌نظری نام تماشا ببرد","در خیال خود و در شعر خود این همه لعبت زیبا به آرزو و هوس می‌آفرینم شاید صاحب‌نظری بیاید و این لعبت‌بازی را تماشا کند و بپسندد."],[127,"علم و فضلی که به چل سال دلم جمع آورد","ترسم آن نرگس مستانه به یغما ببرد","دانش و بزرگی که در چهل سال بدین آورده ام را می‌ترسم که آن چشمان مست ببرد و غارت کند."],[127,"بانگ گاوی، چه صدا باز دهد؟ عشوه مخر","سامری کیست که دست از ید بیضا ببرد؟","بانگ گاو چه صدایی دارد؟ فریب مخور! سامری نیرنگ‌باز کیست که بر ید بیضا پیروز شود؟ (اشاره است به داستان گوساله‌ای که سامری از زر (سمبل پول) ساخت و صدایی از او بر‌می‌خواست (سمبل جادو و نیرنگ) و به بنی‌اسراییل گفت «خدای شما و موسی این است» در حالیکه دروغ می‌گفت و آن خدای موسی نبود.)"],[127,"جام مینایی می، سد ره تنگ‌دلی‌ست","منه از دست که سیل غمت از جا ببرد","جام مینایی و زلال‌ می، از دلتنگی و انده جلوگیری می‌کند آن‌را یک لحظه از دست فرو مگذار وگر نه سیل غم تو را با خود می‌برد"],[127,"راه عشق ار چه کمینگاه کمانداران است","هر که دانسته رود صرفه ز اعدا ببرد","راه و جاده عشق اگر‌چه پر‌خطر و پر از کمان‌دار است؛ ‌(شجاع باش و برو) زیرا هر کسی که با دانایی این راه را بپیماید بر دشمنان پیروز خواهد شد."],[127,"حافظ! ار جان طلبد غمزه مستانه یار","خانه از غیر بپرداز و بهل تا ببرد","حافظا.. اگر چشم شوخ یار از تو جانت را خواست، تردید مکن و خانه دل را از هرچه غیر اوست پاک کن و بگذار تا ببرد."],[128,"اگر نه باده غم دل ز یاد ما ببرد","نهیب حادثه بنیاد ما ز جا ببرد","اگر مستی و باده نباشد و غم دل ما را بکاهد هجوم حوادث‌، بنیاد ما را از جای ببرد."],[128,"اگر نه عقل به مستی فروکشد لنگر","چگونه کشتی از این ورطه بلا ببرد","اگر عقل‌، مست نشود، در این طوفان و گرداب بلا چطور می‌تواند لنگر بکشد و جان سالم به‌در ببرد؟"],[128,"فغان که با همه کس غایبانه باخت فلک","که کس نبود که دستی از این دغا ببرد","فریاد و داد که فلک با همگان‌، نهانی و در پنهان بازی‌کرد و کسی نتوانست یکبار از این دغل‌باز ببرد."],[128,"گذار بر ظلمات است، خضر راهی کو؟","مباد کآتش محرومی آب ما ببرد","مسیر و راه بر ظلمات و تاریکی‌هاست خضر و راهنمای راهی کجاست؟ مباد هوس محرومی و تشنگی‌، آبروی ما را ببرد. (یا به چشمه نرسیم و محروم بمانیم)"],[128,"دل ضعیفم از آن می‌کشد به طرف چمن","که جان ز مرگ به بیماری صبا ببرد","دل ضعیف و هوس‌پیشه من از آن‌رو مرا به‌سوی چمن و بستان می‌کشاند که شاید صبا بتواند او را زنده کند."],[128,"طبیب عشق منم باده ده که این معجون","فراغت آرد و اندیشه خطا ببرد","طبیب و حکیم بیماری عشق منم‌؛ پس پند بشنو که علاجش، باده و مستی و از خود‌بی‌خودی است و «معجون می» آسایش می‌آورد و اندیشه خطا و گناه را از تو دور می‌کند."],[128,"بسوخت حافظ و کس حال او به یار نگفت","مگر نسیم پیامی خدای را ببرد","حافظ از ندیدن یار سوخت و کسی از حال او به یارش نگفت، شاید نسیم‌، برای رضای خدا از او‌، پیامی ببرد."],[129,"سحر بلبل حکایت با صبا کرد","که عشق روی گل با ما چه‌ها کرد","سحری بلبل به آواز برای نسیم صبا حکایت کرد که عشق و مهر روی گل چه کارها که با ما نکرد."],[129,"از آن رنگ رخم، خون در دل افتاد","وز آن گلشن، به خارم مبتلا کرد","از آن رنگ رخ و زیبایی گل‌، دلم پرخون و پر‌حسرت شد و در بستان مرا به خار مبتلا کرد و دردمند کرد."],[129,"غلام همت آن نازنینم","که کار خیر بی روی و ریا کرد","من بنده و غلام‌، کسی هستم که کار خیر را بدون چشمداشت و بدون خودنمایی انجام داد و به‌دیگران کمک کرد."],[129,"من از بیگانگان دیگر ننالم","که با من هرچه کرد آن آشنا کرد","آموختم که دیگر از دست بیگانگان و دشمنان گله نکنم و ننالم چونکه هر چه با من کرد‌، آن آشنا کرد."],[129,"گر از سلطان طمع کردم، خطا بود","ور از دلبر وفا جستم، جفا کرد","اگر از سلطان‌، امید و طمع در دل داشتم، امیدی خطا و بی‌جا بود و اگر از دلبر‌، چشم مهر و وفا داشتم ستم و جفا دیدم"],[129,"خوشش باد آن نسیم صبحگاهی","که درد شب نشینان را دوا کرد","نسیم صبح‌گاهی شاد بادا زیراکه فقط او بود که درد شب‌نشینان و بیداران‌ دردمند را دوا و درمان کرد."],[129,"نقاب گل کشید و زلف سنبل","گره بند قبای غنچه وا کرد","(نسیم صبح‌گاهی بود که) که نقاب از روی زیبای گل و زلف ناز سنبل کنار زد و بندهای جامه غنچه را گشود."],[129,"به هر سو بلبل عاشق در افغان","تنعّم از میان، باد صبا کرد","و بلبل عاشق در هر سوی گلشن‌، فغان برآورد که در این‌میان باد صبا تنها کسی بود که اهل نعمت بود. (تنعم‌: در لغت یعنی در ناز و آسایش زیستن)"],[129,"بشارت بر به کوی می فروشان","که حافظ توبه از زهد ریا کرد","به کوی می‌فروشان مژده ببر که حافظ از زهد ریایی و دروغین توبه کرد و پشیمان شد."],[129,"وفا از خواجگان شهر با من","کمال دولت و دین بوالوفا کرد","در میان بزرگان شهر‌، کسی که با من مهر و وفا ورزید خواجه ابوالوفا، صاحب کمال و دولت بود."],[130,"بیا که ترک فلک خوان روزه غارت کرد","هلال عید به دور قدح اشارت کرد","هشیار باش که روز جشن است و دست تقدیر‌، خوان و سفره روزه را برچید و هلال روز عید به‌ زبان حال‌، قدح باده را به تو نشان می‌دهد."],[130,"ثواب روزه و حجّ قبول آن کس برد","که خاک میکده عشق را زیارت کرد","ثواب روزه و حج را کسی می‌برد که خاک میکده عشق را زیارت می‌کند. (میکده در شعر حافظ، محل دوری از خودپرستی و رها شدن از خود و دوری از ریا است.)"],[130,"مقام اصلی ما گوشه خرابات است","خداش خیر دهاد آن که این عمارت کرد","جای و جایگاه اصلی و سزاوار ما گوشه میکده و خرابات است خدا خیرش دهاد کسی را که این بنا و عمارت را ساخت. (کرد‌‌: ساخت)"],[130,"بهای باده چون لعل چیست؟ جوهر عقل","بیا که سود کسی برد، کاین تجارت کرد","بهای باده ناب و لعل‌گون را چطور و با چه باید پرداخت؟ با جوهر عقل. کسی که این معامله را انجام داد‌، سود برد."],[130,"نماز در خم آن ابروان محرابی","کسی کند که به خون جگر طهارت کرد","کسی می‌تواند در خم و طاق محراب آن ابروان کمانی نماز کند که با خون جگر طهارت کرد."],[130,"فغان که نرگس جمّاش شیخ شهر امروز","نظر به دردکشان از سر حقارت کرد","فریاد از دست چشمان فضول شیخ و زاهد شهر که امروز با دیده مذمت و حقارت به دردکشان و می‌گساران نگاه‌کرد."],[130,"به روی یار نظر کن ز دیده منّت دار","که کاردیده، نظر از سر بصارت کرد","به روی یار نگاه کن و از دیده و روی یار ممنون و سپاسگزار باش که آدم پخته و کاردیده‌، از روی بینش و بصیرت نگاه می‌کند."],[130,"حدیث عشق ز حافظ شنو نه از واعظ","اگر چه صنعت بسیار در عبارت کرد","اگر داستان عشق را می‌خواهی بشنوی آن‌را از حافظ بشنو نه از واعظ و شیخ، اگر چه کلام و زبان پر هیاهو و پر فنی دارد."],[131,"به آب روشن می، عارفی طهارت کرد","علی الصّباح، که میخانه را زیارت کرد","عارفی در صبح زود با آب پاک و روشنی، برای انجام طهارت و پاکی به میخانه رفت تا از آنجا دیدن کند."],[131,"همین که ساغر زرّین خور، نهان گردید","هلال عید به دور قدح اشارت کرد","هنگامی که جام طلایی خورشید غروب کرد، هلال ماه عید به دور جام اشاره کرد؛ یعنی در زمان غروب خورشید و فرارسیدن عید، زیبایی ماه به‌وضوح نمایان شد."],[131,"خوشا نماز و نیاز کسی که از سر درد","به آب دیده و خون جگر طهارت کرد","خوشا به حال کسی که برای رهایی از درد و رنج خود، با اشک چشم و خون دل عبادت و دعا می‌کند و خود را پاک می‌سازد."],[131,"امام خواجه، که بودش سر نماز دراز","به خون دختر رز، خرقه را قصارت کرد","امام خواجه، که به او اشاره شده، در هنگام نماز طولانی به خون دختر رز (شاید به نشانه غم یا فتنه) خرقه (پوشش دینی) خود را رنگین کرده است. این کنایه به ناپایداری و معضلات روحی و اجتماعی در عبادت اشاره دارد."],[131,"دلم ز حلقه زلفش به جان خرید آشوب","چه سود دید؟ ندانم، که این تجارت کرد","دلم از حلقه‌‌ی زلفش آشفتگی را به بهای جان خرید، در این تجارت چه سودی دید، نمی‌دانم."],[131,"اگر امام جماعت طلب کند امروز","خبر دهید که حافظ به می طهارت کرد","اگر امام جماعت از شما بخواهد که امروز به او بگویید حافظ در حال نوشیدن شراب طهارت است، این درخواست را برآورده کنید."],[132,"صوفی نهاد دام و سر حقّه، باز کرد","بنیاد مکر با فلک حقّه‌باز کرد","حقه‌: یعنی کیسه. در اینجا کیسه شعبده‌بازان منظور است."],[132,"بازیّ چرخ بشکندش بیضه در کلاه","زیرا که عرض شعبده با اهل راز کرد","«بیضه و تخم‌پرنده، در کلاه شکستن» منظور لو رفتن و بی‌اثر شدن کلک‌ها و حیله‌های یک شعبده‌باز است."],[132,"ساقی! بیا! که شاهد رعنای صوفیان","دیگر به جلوه آمد و آغاز ناز کرد","دیگر‌: باز هم‌."],[132,"این مطرب از کجاست که ساز عراق ساخت؟","وآهنگ بازگشت به راه حجاز کرد؟","عراق و حجاز علاوه بر نام مکان، نام‌های مایه‌های موسیقایی هستند."],[132,"ای دل! بیا! که ما به پناه خدا رویم","زآنچ آستین کوته و دست دراز کرد","آستین کوته‌: کنایه است از کسی که دست از دنیا کوتاه کرده و‌یا ادعای این عمل را دارد. دست‌‌ دراز‌: کنایه است از حرص‌، دست ظلم."],[132,"صنعت مکن که هرکه محبّت، نه راست باخت","عشقش به روی دل، در معنی، فراز کرد","صنعت‌: در اینجا یعنی مکر‌. فراز کرد‌: بست‌. در کار عاشقی هیچ حیله و مکری به کار نبر چرا که قلب او عشق غیر حقیقی را به درون راه نمی دهد(در را به روی آن می بندد)"],[132,"فردا که پیشگاه حقیقت شود پدید","شرمنده رهروی که عمل بر مجاز کرد","فردا که در پیشگاه حقیقت، واقعیت‌ها خود را نشان می‌دهند، کسی که در دنیا فقط به ظواهر و مجاز پرداخته، شرمنده و پشیمان خواهد شد."],[132,"ای کبک خوش‌خرام! کجا می‌روی؟ بایست!","غرّه مشو! که گربه زاهد، نماز کرد","ای کبک خوش‌خرام! کجا می‌روی؟ بایست! فریب نخور! زیرا گربه زاهد (مردی که به عبادت و زهد خود مغرور است) نیز نماز خوانده است."],[132,"«حافظ»! مکن ملامت رندان! که در ازل","ما را خدا ز زهد ریا، بی‌نیاز کرد","حافظ! تو رندان را سرزنش نکن، زیرا خداوند از همان آغاز آفرینش ما را از زهد ظاهری و ریا بی‌نیاز کرده است."],[133,"بلبلی خون دلی خورد و گلی حاصل کرد","باد غیرت به صدش خار، پریشان‌دل کرد","بلبلی به خاطر عشق و غمش ناراحتی زیادی را تحمل کرد و در نتیجه یک گل به دست آورد. اما در برابر شرایط سخت و حسادت دیگران، لگدکوب شد و دلش به شدت غمگین شد."],[133,"طوطیی را به خیال شکری، دل‌خوش بود","ناگهش سیل فنا نقش امل، باطل کرد","طوطی‌ای به فکر شیرینی و خوشی بود، اما ناگهان سیل نابودی آرزوهایش را از بین برد و همه امیدهای او را بر باد داد."],[133,"قرّة العین من، آن میوه دل، یادش باد","که چه آسان بشد و کار مرا مشکل کرد","یاد محبوب من، که باعث خوشحالی و راحتی من بود، فراموش نشود که چگونه با فاصله‌اش، زندگی‌ام را دشوار کرد."],[133,"ساروان! بار من افتاد، خدا را مددی","که امید کرمم همره این محمل کرد","ای ساروان! بار من سنگین شده است، خدا را به من کمک کن، زیرا که امید من به مهربانی تو همراه این محمّل (بار) می‌باشد."],[133,"روی خاکی و نم چشم مرا خوار مدار","چرخ فیروزه طرب‌خانه از این کهگل کرد","ای چرخ (زمان)، چهره‌ام را به خاطر خاک و اشک‌هایم بی‌احترامی نکن، زیرا تو با این زخم‌ها طرب‌خانه عمرم را از خاکستر می‌سازی."],[133,"آه و فریاد که از چشم حسود مه چرخ","در لحد ماه کمان‌ابروی من منزل کرد","حسودان و بدخواهان باعث مرگ و نابودی من شدند، زیرا چهره زیبا و کمان‌ابروی من در زیر خاک دفن شده است."],[133,"نزدی شاه‌رخ و فوت شد امکان حافظ","چه کنم؟ بازی ایام مرا غافل کرد","حافظ از آن می‌گوید که به دلیل دوری از محبوبش، دیریست که به او نزدیک نشده و فرصت را برای زندگی از دست داده است. او احساس می‌کند که روزگار و اتفاقات زندگی، او را بی‌خبر از خود و از عشقش کرده‌اند."],[134,"چو باد، عزم سر کوی یار خواهم کرد","نفس به بوی خوشش مشکبار خواهم کرد","مانند باد، عزم رفتن به کوی معشوق را دارم و با نفس خود بوی خوش او را پراکنده خواهم کرد."],[134,"به هرزه بی می و معشوق عمر می‌گذرد","بطالتم بس از امروز کار خواهم کرد","بدون عشق و می‌نوشی، زندگی بی‌فایده و پوچ می‌گذرد. از امروز به خاطر این وضعیت، بی‌کار و بی‌استفاده می‌نشینم."],[134,"هر آبروی که اندوختم ز دانش و دین","نثار خاک ره آن نگار خواهم کرد","هر اعتباری که با دانش و دین به دست آورده‌ام، برای رسیدن به آن محبوب، صرف خاک راه او خواهم کرد."],[134,"چو شمع صبحدمم شد ز مهر او روشن","که عمر در سر این کار و بار خواهم کرد","من به مانند شمعی در صبح روشن شده‌ام که برای عشق او سوزانم و می‌خواهم عمرم را صرف این عشق و تلاش برای آن کنم."],[134,"به یاد چشم تو خود را خراب خواهم ساخت","بنای عهد قدیم استوار خواهم کرد","به خاطر یاد تو، خودم را در شرایط بدی قرار می‌دهم و برای تحلیل روابط گذشته‌ام تلاش می‌کنم."],[134,"صبا کجاست؟ که این جان خون گرفته چو گل","فدای نکهت گیسوی یار خواهم کرد","نسیم صبح کجاست که من، این جان اندوهگین، مانند گل، جانم را فدای عطر و بوی گیسوان محبوبم خواهم کرد."],[134,"نفاق و زرق نبخشد صفای دل حافظ","طریق رندی و عشق اختیار خواهم کرد","حافظ می‌گوید که دورویی و تظاهر نمی‌تواند روشنی و صفای دل او را فراهم کند و او تصمیم دارد راه رندی و عشق را برگزینید."],[135,"دست در حلقه آن زلف دوتا نتوان کرد","تکیه بر عهد تو و باد صبا نتوان کرد","نمی‌توان به زلف دوگانه‌ات دست پیدا کرد و نمی‌توان بر عهد و وفای تو و نسیم صبح تکیه کرد."],[135,"آن‌چه سعی است، من اندر طلبت بنمایم","این قدر هست که تغییر قضا نتوان کرد","هرچه تلاش کنم تا به دنبالت بیفتم، باز هم این حد و اندازه است که نمی‌توان تقدیر و سرنوشت را تغییر داد."],[135,"دامن دوست به صد خون دل افتاد به دست","به فسوسی که کند خصم، رها نتوان کرد","به خاطر عشق و نزدیکی به دوست، دل من به شدت زخمی و آغشته به غم شده است و آن قدر درگیر کینه و دشمنی‌ها هستم که نمی‌توانم از این وضعیت رها شوم."],[135,"عارضش را به مثل ماه فلک نتوان گفت","نسبت دوست به هر بی سر و پا نتوان کرد","زیبایی چهره‌ی محبوب را نمی‌توان با هیچ چیزی مقایسه کرد، همان‌گونه که هیچ‌کس نمی‌تواند نسبت خویش را با یک فرد بی‌ارزش به محبوب بیان کند."],[135,"سروبالای من آنگه که درآید به سماع","چه محل جامه جان را که قبا نتوان کرد؟","سروبلند من (دوست یا معشوق) وقتی به مجلس خوش‌نوا می‌آید، چه محلی برای پوشیدن لباس جان (یعنی لباس روح یا احساس) وجود دارد که نتوان آن را به زیبایی درآورد؟ در واقع، زیبایی و حضور او موجب می‌شود که هیچ زیبایی دیگری اهمیتی نداشته باشد."],[135,"نظر پاک تواند رخ جانان دیدن","که در آیینه نظر جز به صفا نتوان کرد","فقط کسی می‌تواند چهره محبوب را ببیند که نیت و نگاهش خالص باشد، زیرا در آینه، تنها با قلبی صاف و بی‌آلایش می‌توان واقعیات را مشاهده کرد."],[135,"مشکل عشق نه در حوصله دانش ماست","حلّ‌ این نکته بدین فکر خطا نتوان کرد","مشکل عشق به دانشی که داریم مربوط نیست؛ این مسئله را نمی‌توان با فکر و استدلال نادرست حل کرد."],[135,"غیرتم کشت که محبوب جهانی، لیکن","روز و شب عربده با خلق خدا نتوان کرد","غیرتم مرا کشت، چون محبوبی دارم که همه او را دوست دارند، اما نمی‌توانم به خاطر او با دیگران رفتار تند و تیز داشته باشم."],[135,"من چه گویم؟ که تو را نازکی طبع لطیف","تا به حدّیست که آهسته دعا نتوان کرد","من نمی‌دانم باید چه بگویم، زیرا نازکی و ظرافت روح تو به قدری است که حتی نمی‌توان با آرامش برای تو دعا کرد."],[135,"بجز ابروی تو محراب دل حافظ نیست","طاعت غیر تو در مذهب ما نتوان کرد","تنها ابروی تو جایگاه دل حافظ است و در دین ما غیر از عبادت تو امکان‌پذیر نیست."],[136,"دل از من برد و روی از من نهان کرد","خدا را با که این بازی توان کرد","خداوند دل مرا گرفت و با این حال چهره‌اش را از من پنهان کرد. ای خدا، با که می‌توان در این بازی غمناک معنای محبت و جدایی را تجربه کرد؟"],[136,"شب تنهاییم در قصد جان بود","خیالش لطف‌های بی‌کران کرد","در شب تنهایی‌ام، یاد او در پی جانم بود و او با محبت‌های بی‌پایانش به من زندگی و نشاط بخشید."],[136,"چرا چون لاله خونین دل نباشم؟","که با ما نرگس او سر گران کرد","چرا نباید مانند لاله‌ای باشید که دلش خونین است، در حالی که او با نرگسش دل ما را بسیار غمگین کرده است؟"],[136,"که را گویم که با این درد جان‌سوز","طبیبم قصد جان ناتوان کرد؟","در این بیت، شاعر از بزرگ‌ترین درد و ناگواری خود سخن می‌گوید و از بیماری و رنج خود شکایت دارد. او می‌پرسد که به چه کسی بگوید که معالجه‌اش با این درد جان‌سوز، روحش را به خطر انداخته است؟"],[136,"بدانسان سوخت چون شمعم که بر من","صراحی گریه و بربط فغان کرد","من مانند شمعی هستم که در آتش عشق می‌سوزد، و بر من جامی (صراحی) وجود دارد که به خاطر این درد، به شدت گریه می‌کند و ساز (بربط) به ناله و فغان می‌پردازد."],[136,"صبا گر چاره داری وقت وقت است","که درد اشتیاقم قصد جان کرد","وزش نسیم (صبا) اگر تدبیری داری، زمان آن رسیده است که درد longing (اشتیاق) من جانم را تهدید کرده است."],[136,"میان مهربانان کی توان گفت؟","که یار ما چنین گفت و چنان کرد","در میان مهربانان، چگونه می‌توان گفت که یار ما اینگونه سخن گفت و اینگونه رفتار کرد؟"],[136,"عدو با جان حافظ آن نکردی","که تیر چشم آن ابروکمان کرد","دشمن با جان حافظ کاری نکرد که تیر نگاه آن زن با ابروهای کمان‌شکلش کرد."],[137,"یاد باد آن که ز ما وقت سفر یاد نکرد","به وداعی دل غم‌دیده ما شاد نکرد","یاد می‌آورم آن زمان را که او در هنگام سفر، به ما توجهی نکرد و با خداحافظی‌اش دل غمزده و ناراحت ما را شاد نکرد."],[137,"آن جوان‌بخت که می‌زد رقم خیر و قبول","بنده پیر ندانم ز چه آزاد نکرد","در اینجا \"خیر: به معنی \"نه\" میباشد،در زمان قدیم لیستی از بندگان را جهت آزاد کردن به شاه میدادند و شاه در جلوی هر یک با نوشتن خیر و قبول آزادی بنده را رد و یا قبول میکرد. معنی شعر: آن جوان بخت که قدرت رد و یا قبول آزاد کردن بندگان را داشت، نمیدانم چرا این بنده پیر را آزاد نکرد"],[137,"کاغذین جامه به خونآب بشویم که فلک","رهنمونیم به پای علم داد نکرد","می‌خواهم لباس کاغذی و نازک خود را با خون دیده بشویم و آنقدر گریه کنم تا رنگ خون شود، زیرا چرخ و زمان (فلک) مرا به سمت علم داد هدایت نکرد. (علم داد علمی در نقطه ای از شهر بود که مظلومان و دادخواهان جهت دادخواهی با لباس کاغذی کنار علم ایستاده و شکایت خود را با نوشتن روی جامه کاغذی بیان می کردند)"],[137,"دل به امّید صدایی که مگر در تو رسد","ناله‌ها کرد در این کوه که فرهاد نکرد","دل به امید این که شاید صدایی از تو به من برسد، در این کوه ناله‌ها سر داد، کاری که فرهاد، عاشق شیرین، هرگز انجام نداد."],[137,"سایه تا بازگرفتی ز چمن مرغ سحر","آشیان در شکن طرّه شمشاد نکرد","سایه تو که در چمن برداشت شد، پرنده صبح (مرغ سحر) دیگر در لانه‌اش نمی‌تواند ساکن شود و دیگر از تاریکی و سایه‌ای که تو ایجاد کردی، فرار نمی‌کند."],[137,"شاید ار پیک صبا، از تو بیاموزد کار","زآن که چالاک‌تر از این حرکت، باد نکرد","شاید اگر فرشته‌ای به نام پیک، از تو یاد بگیرد، کارش را بهتر انجام دهد، زیرا هیچ جریان و جنبشی به چابکی این باد نیست."],[137,"کلک مشّاطه صنعش نکشد نقش مراد","هر که اقرار بدین حسن خداداد نکرد","نقش و طرحی که آرایشگر از زیبایی او می‌کشد، نمی‌تواند خواسته و آرزوی هر کسی را برآورده کند؛ چرا که هر کس که به این زیبایی الهی اقرار نداشته باشد، از آن بهره‌مند نخواهد شد."],[137,"مطربا! پرده بگردان و بزن راه عراق","که بدین راه بشد یار و ز ما یاد نکرد","ای مطرب! پرده را تغییر بده و آهنگ راه عراق را بزن، زیرا به این طریق یار به من نزدیک شده و دیگر از من یاد نکرده است."],[137,"غزلیات عراقی‌ست سرود حافظ","که شنید این ره دل‌سوز که فریاد نکرد؟","حافظ می‌گوید که غزل‌ها و شعرهای او معمولا درباره عشق و دل‌سوزی هستند و سوال می‌کند که آیا کسی این احساسات را نمی‌شنود و در پاسخ به آن‌ها فریاد نمی‌زند؟"],[138,"رو بر رهش نهادم و بر من گذر نکرد","صد لطف چشم داشتم و یک نظر نکرد","من به او نگاه کردم و او حتی به من توجهی نکرد. با وجود تمام محبت‌ها و خوبی‌هایی که از من دید، یک بار هم به من نگاه نکرد."],[138,"سیل سرشک ما ز دلش کین به در نبرد","در سنگ خاره قطره باران اثر نکرد","اشک‌های ما به خاطر کینه‌ای که از دل او داریم، نتوانست آن کینه را از بین ببرد و این اشک‌ها به سنگ سخت دل او هیچ تاثیری نداشت."],[138,"یا رب تو آن جوان دلاور نگاه‌دار","کز تیر آه گوشه‌نشینان حذر نکرد","پروردگارا، تو آن جوان شجاع را حفظ کن که از تیر اشک و آه کسانی که در گوشه نشسته‌اند، هیچ‌گاه هراسی به دل راه نداد."],[138,"ماهی و مرغ دوش ز افغان من نخفت","وان شوخ‌دیده بین که سر از خواب برنکرد","ماهی و مرغ شب گذشته از ناله و فریاد من پنهان نشدند و آن دختر شوخ‌چشم هم که تا صبح سر از خواب برنکرد."],[138,"می‌خواستم که میرمش اندر قدم چو شمع","او خود گذر به ما چو نسیم سحر نکرد","می‌خواستم هر زمان که او به حضور می‌رسد، مانند شمع در برابرش بایستم و نورانی شوم، اما او آنطور که باید بر من نمی‌گذرد و مانند نسیم صبحگاهی به آرامی عبور نمی‌کند."],[138,"جانا کدام سنگدل بی‌کفایت است","کاو پیش زخم تیغ تو جان را سپر نکرد؟","عزیزم، کدام انسان سخت‌دل و ناتوان وجود دارد که در برابر زخم تند تیغ تو، جانش را سپر نکند و از خود دفاع نکند؟"],[138,"کلک زبان‌بریده حافظ در انجمن","با کس نگفت راز تو تا ترک سر نکرد","حافظ که زبانش بریده است و نمی‌تواند به راحتی سخن بگوید، در هیچ محفل و جمعی راز تو را با کسی در میان نگذاشته است، تا زمانی که سرش شکسته شود."],[139,"دلبر برفت و دلشدگان را خبر نکرد","یاد حریف شهر و رفیق سفر نکرد","دلبر (محبوب) رفت و به دل‌باختگان (عاشقان) خبر نداد و به یاد رفیق شهر و همراه سفرش نیز توجهی نکرد."],[139,"یا بخت من طریق مروت فروگذاشت","یا او به شاهراه طریقت گذر نکرد","بخت من راه محبت و گذشت را رها کرد، یا او در مسیر درست زندگی قدم نگذاشت."],[139,"گفتم مگر به گریه دلش مهربان کنم","چون سخت بود در دل سنگش اثر نکرد","گفتم شاید بتوانم با گریه و اشک، دل او را نرم و مهربان کنم، ولی با وجودی که تلاش کردم، این کار به خاطر سفتی و سنگ‌دلی او تأثیری نداشت."],[139,"شوخی مکن که مرغ دل بی‌قرار من","سودای دام عاشقی از سر به درنکرد","با شوخی و بازی نکن، چرا که دل بی‌قرار من هیچگاه آرزوی گرفتار شدن به دام عشق را فراموش نکرده است."],[139,"هر کس که دید روی تو بوسید چشم من","کاری که کرد دیده من، بی‌نظر نکرد","هر کسی که زیبایی تو را ببیند، چشمان من را می‌بوسد، و کوتاهی که چشم من در عشق تو کرده، هیچ‌گاه نظر به دیگری نیافکنده است."],[139,"من ایستاده تا کنمش جان فدا چو شمع","او خود گذر به ما چو نسیم سحر نکرد","من ایستاده‌ام تا جانم را برای آن معشوق فدای او کنم، اما او به راحتی از کنار ما مانند نسیم صبحگاهی عبور کرد و حتی نگاهی هم به ما نینداخت."],[140,"دیدی ای دل که غم عشق دگربار چه کرد؟","چون بشد دلبر و با یار وفادار چه کرد","ای دل! دیدی که غم عشق دوباره چه بر سرم آورد؟ دیدی دلبر چگونه شد و با من یار وفادارش چکار کرد؟"],[140,"آه از آن نرگس جادو که چه بازی انگیخت","آه از آن مست که با مردم هشیار چه کرد","آه که چشم زیبا و سحر آمیز او چگونه من را به بازی گرفت ، آه از آن دلبر که با حالت مست ما مردم هشیار را به بازی گرفت"],[140,"اشک من رنگ شفق یافت ز بی‌مهری یار","طالع بی‌شفقت بین که در این کار چه کرد","اشک‌های من همانند لحظه غروب از خون سرخ شده‌اند به خاطر بی‌محبتی و سردی معشوق. ببین چگونه سرنوشت بی‌رحم عمل کرده است."],[140,"برقی از منزل لیلی بدرخشید سحر","وه که با خرمن مجنون دل‌افگار چه کرد","در صبحگاهان نوری از خانه لیلی درخشید و افسوس که چه بلایی بر سر دل مجروح مجنون آورد."],[140,"ساقیا جام می‌ام ده که نگارنده غیب","نیست معلوم که در پرده اسرار چه کرد","ای ساقی، لیوان شرابم را به من بده؛ زیرا معلوم نیست که خداوند دانا بر عالم غیب چه تدبیر کرده و من از اسرار جهان آگاه نیستم"],[140,"آن که پرنقش زد این دایره مینایی","کس ندانست که در گردش پرگار چه کرد","کسی نمیداند خداوندی که این جهان را بنا کرده‌است چه اسرار و رموزی در آن قرار داده و کسی به اسرار عالم غیب آگاه نیست"],[140,"فکر عشق آتش غم در دل حافظ زد و سوخت","یار دیرینه ببینید که با یار چه کرد","رویای عاشقی در دل حافظ غم را بمانند آتش شعله‌ور کرد و باعث از بین رفتن او گردید. حالا بیایید ببینیم عاشقش با او چه کرده است."],[141,"دوستان دختر رز توبه ز مستوری کرد","شد سوی محتسب و کار به دستوری کرد","دوستان دختر رز (دختری زیبا و دلربا) تصمیم به ترک پنهانی و مخفیانه گرفتند و به سمت محتسب (نظارت بر رفتار مردم) رفتند و همان‌طور که انتظار می‌رفت، کارشان به دستور و قانون رسید."],[141,"آمد از پرده به مجلس عرقش پاک کنید","تا نگویند حریفان که چرا دوری کرد","بیا از پنهانی به جمع بیفت و بگو شرابش را پاک کنید تا حریفان نگویند که چرا از ما فاصله گرفت."],[141,"مژدگانی بده ای دل که دگر مطرب عشق","راه مستانه زد و چاره مخموری کرد","ای دل، خوشحالی کن و مژده بده، زیرا بار دیگر مطرب عشق با نغمه‌های شاد و سرمست‌کننده، حالتی مستانه به وجود آورده و راهی برای فراموشی غم و گرفتاری فراهم کرده است."],[141,"نه به هفت آب، که رنگش به صد آتش نرود","آن چه با خرقه زاهد، می انگوری کرد","آن چه که به سبب شراب انگوری به دست می‌آید، نه با هفت بار آب زلال پاک می‌شود و نه با زهد و نیکی‌های ظاهری زاهد، تغییر رنگ می‌دهد."],[141,"غنچه گلبن وصلم ز نسیمش بشکفت","مرغ خوشخوان طرب از برگ گل سوری کرد","نسیم خوشبوی وصال من باعث شکفتن غنچه‌های گل سرخ شد و مرغی که زیبا و خوشصدا است، از برگ گل سرخ نغمه‌خوانی کرد."],[141,"حافظ افتادگی از دست مده زان که حسود","عرض و مال و دل و دین در سر مغروری کرد","حافظ می‌گوید که با افتاده‌نفسی خود را از دست نده، زیرا حسودان به خاطر کبر و خودپسندی، به دنبال آزار و آسیب به عزت، دارایی، عشق و ایمان تو هستند."],[142,"سال‌ها دل طلب جام جم از ما می‌کرد","وآنچه خود داشت ز بیگانه تمنّا می‌کرد","سال‌ها دل من در پی یافتن جام جم بود، در حالی که خودم آن چیزهایی را که داشتم، از دیگران می‌خواستم و آرزو می‌کردم."],[142,"گوهری کز صدف کون و مکان بیرون است","طلب از گمشدگان لب دریا می‌کرد","آن گوهر ارزشمندی (علم و معرفت حقّانی) که در زمان و مکان یا همان عالم خاکی نبود، آن را از سرگشتگان همین عالم دنیا می‌خواست و می‌جویید"],[142,"مشکل خویش بر پیر مغان بردم دوش","کاو به تأیید نظر حلّ‌ معمّا می‌کرد","دوش (شب گذشته) مشکل خود را پیش پیر مغان (پیر عابد یا مرشد صوفی) بردم، زیرا او با نگاه تأییدآمیزش، رازهای دشوار را حل می‌کرد."],[142,"دیدمش خرّم و خندان قدح باده به دست","واندر آن آینه صد گونه تماشا می‌کرد","من در حالتی شاد و خرم، شخصی را دیدم که جام باده‌ای در دست داشت و در آن آینه، اشکال و جلوه‌های مختلفی را تماشا می‌کرد."],[142,"گفتم این جام جهان‌بین به تو کی داد حکیم؟","گفت آن روز که این گنبد مینا می‌کرد","حکیم (دانشمند) و عاقل به من می‌گوید که این جامی که می‌تواند جهان را به تو نشان دهد، در روزی به تو داده شده که این آسمان مانند گنبدی آبی و زیبا وجود داشت."],[142,"بی‌دلی در همه‌احوال خدا با او بود","او نمی‌دیدش و از دور خدارا می‌کرد","وارسته‌ای که در هر شرایطی خدا با او بود، چون نمی‌توانست او را ببیند فکر می‌کرد خدا از او جداست و به دنبال او می‌گشت. (خدارا می‌کرد یعنی سوگند به خدا؛ خدا را به کمک طلبیدن)"],[142,"این‌همه شعبده خویش که می‌کرد اینجا","سامری پیش عصا و ید بیضا می‌کرد","حافظ به افرادی که به ظاهر کارهای شگفت‌انگیز و جادوگری انجام می‌دهند، اشاره می‌کند و می‌گوید اینها همانند سامری هستند که با عصای خود معجزه می‌ساخت. در واقع، او به شیوه‌های فریبنده‌ی خودشان اشاره می‌کند که دروغین و غیرواقعی هستند."],[142,"گفت آن یار کز او گشت سر دار بلند","جرمش این بود که اسرار هویدا می‌کرد","آن بزرگ (پیر مغان) گفت آن کسی که (منصور حلاج) که به واسطه بر دار شدنش ، دار به بزرگی رسید. جرمش این بود که وقتی اسرار الهی را دریافت میکرد و به شهود می رسید آنها را برای دیگران هم بیان میکرد."],[142,"فیض روح‌القدس ار باز مدد فرماید","دیگران هم بکنند آن‌چه مسیحا می‌کرد","اگر روح‌القدس کمک کند، دیگران هم می‌توانند مانند مسیح (ع) کارهایی شگفت‌انگیز و معجزه‌آسا انجام دهند."],[142,"گفتمش سلسله زلف بتان از پی چیست؟","گفت حافظ گله‌ای از دل شیدا می‌کرد","از او پرسیدم که چرا زلف‌های زیبای بت‌ها را دنبال می‌کنید؟ او پاسخ داد که حافظ از دل عاشق شیدا شکایتی دارد."],[143,"به سرّ جام جم آنگه نظر توانی کرد","که خاک میکده کحل بصر توانی کرد","برای پی بردن به راز های هستی می‌بایست خاک پای سالکان حقیقت و محافل حقیقت طلبی(میخانه) باشی"],[143,"مباش بی می و مطرب که زیر طاق سپهر","بدین ترانه غم از دل به در توانی کرد","در این دنیا هرگز بدون شادی و طرب زندگی نکن. زیرا تنها با شادی و طرب میتوانی بر غم ها فائق شوی"],[143,"گل مراد تو آنگه نقاب بگشاید","که خدمتش چو نسیم سحر توانی کرد","مراد و مقصود تو زمانی خود را آشکار میکند و زیبایی‌اش را نشان می‌دهد که تو بتوانی همچون نسیم صبحگاه، به او خدمت کنی و او را نوازش کنی."],[143,"گدایی در میخانه طرفه اکسیریست","گر این عمل بکنی، خاک زر توانی کرد","خدمت به میخانه مثل کیمیاست ، زیرا اگر این عمل را انجام دهی، می‌توانی خاک را به طلا تبدیل کنی."],[143,"به عزم مرحله عشق پیش نه قدمی","که سودها کنی ار این سفر توانی کرد","با اراده‌ی رسیدن به مرحله‌ی عشق، قدمی بردار که اگر بتوانی، در این سفر به سودهای بزرگی دست یابی."],[143,"تو کز سرای طبیعت نمی‌روی بیرون","کجا به کوی طریقت گذر توانی کرد","تو که هنوز مشغول غرایز و امیال طبیعی و مادی هستی، چگونه می‌توانی به راه معنوی و واقعیت‌های عمیق‌تر دسترسی پیدا کنی؟"],[143,"جمال یار ندارد نقاب و پرده ولی","غبار ره بنشان تا نظر توانی کرد","زیبایی محبوب هیچ پوشش و پرده‌ای ندارد، بلکه باید به صبور باشی تا آن زیبایی ها خود را به تو نشان بدهند"],[143,"بیا که چاره ذوق حضور و نظم امور","به فیض‌بخشی اهل نظر توانی کرد","برای داشتن شوق زندگی و نظم بخشیدن به امور ، باید از افراد فرهیخته و اهل نظر کسب فیض کنی"],[143,"ولی تو تا لب معشوق و جام می خواهی","طمع مدار که کار دگر توانی کرد","تا زمانی که به عشق و خوشی‌های زندگی فکر می‌کنی، نباید انتظار داشته باشی که بتوانی کار دیگری انجام دهی."],[143,"دلا ز نور هدایت گر آگهی یابی","چو شمع، خنده‌زنان ترک سر توانی کرد","ای دل، اگر نور هدایت در تو روشن شود همچون شمع که با خنده برای روشنایی بخشیدن می‌سوزد تو هم میتوانی سر در راه روشنی و حقیقت ببازی"],[143,"گر این نصیحت شاهانه بشنوی حافظ","به شاهراه حقیقت گذر توانی کرد","اگر نصیحت پادشاه را بپذیری، حافظ، می‌توانی به مسیر حقیقت راه یابی."],[144,"چه مستی است ندانم که رو به ما آورد","که بود ساقی و این باده از کجا آورد","نمی‌دانم چه حالی به سرم آمده که به سوی ما آمده است، و نمی‌دانم ساقی چه کسی است و این می‌ (باده) را از کجا آورده است."],[144,"چه راه می‌زند این مطرب مقام شناس","که در میان غزل قول آشنا آورد","این سازنده موسیقی که در اینجا آواز می‌خواند، چه راهی را در پیش گرفته که در این شعر مفهوم آشنا و دلپذیری را برای ما به ارمغان آورده است."],[144,"تو نیز باده به چنگ آر و راه صحرا گیر","که مرغ نغمه‌سرا ساز خوش‌نوا آورد","تو هم باده در دست بگیر و به دشت برو، زیرا پرنده‌ای که آواز دلنواز می‌خواند، نغمه‌ای خوش با خود می‌آورد."],[144,"دلا چو غنچه شکایت ز کار بسته مکن","که باد صبح، نسیم گره‌گشا آورد","ای دل، مانند غنچه از مشکلات و سختی‌ها نگو و شکایت نکن، زیرا باد صبح، نسیمی می‌آورد که گره‌ها را باز می‌کند و شرایط را بهتر می‌سازد."],[144,"رسیدن گل نسرین به خیر و خوبی باد","بنفشه شاد و کش آمد، سمن صفا آورد","خوش آمدن گل نسرین را تبریک می‌گویم و امیدوارم که بنفشه‌ها سرحال و شاد باشند و گل سمن هم زیبایی و پاکی را به ارمغان بیاورد."],[144,"صبا به خوش‌خبری هدهد سلیمان است","که مژده طرب از گلشن سبا آورد","نسیم صبح به مانند هدهد سلیمان است که خبر خوش شادی و سرور را از باغ سبا به ارمغان آورده است."],[144,"علاج ضعف دل ما کرشمه ساقیست","برآر سر که طبیب آمد و دوا آورد","ای شیخ،از من رنجیده نشو که به پیر مغان دلبسته‌ام، چون که تو وعده‌هایی دادی ولی او به آن وعده‌ها عمل کرد"],[144,"مرید پیر مغانم ز من مرنج ای شیخ","چرا که وعده تو کردیّ و او به جا آورد","ای شیخ، مرید من از پیران عارفان ناراحت نشو، زیرا تو وعده‌ای به من دادی که آن را به نحو شایسته‌ای محقق کرده‌ای."],[144,"به تنگ‌چشمی آن ترک لشکری نازم","که حمله بر من درویش یک قبا آورد","من به حسادت و کم‌نظری آن ترک زیبا (که به معشوق اشاره دارد) افتخار می‌کنم، زیرا او با همه‌ی زیبایی‌اش، به من درویش (که انسان ساده‌ لوح و زاهدی است) حمله‌ور شده و مرا به عواطفش جریحه‌دار کرده است."],[144,"فلک غلامی حافظ کنون به طوع کند","که التجا به در دولت شما آورد","حالا آسمان به خاطر خواسته‌های او (حافظ) به نیکی خدمت می‌کند، چون او به درگاه پرنعمت شما (سلاطین) پناه آورده است."],[145,"صبا وقت سحر بویی ز زلف یار می‌آورد","دل شوریده ما را به نو، در کار می‌آورد","بامدادان، صبا بویی از زلف یار آورد و دل شوریده را دوباره شاد کرد."],[145,"من آن شکل صنوبر را ز باغ دیده برکندم","که هر گل کز غمش بشکفت محنت، بار می‌آورد","منظور از صنوبر غده صنوبری یا چشم سوم هست که سد راه سالک می‌باشد و حافظ میگوید من آن بسته ام چون باعث سختی در مسیرم بود چون مسیر را باید با دید دیگری پیمود"],[145,"فروغ ماه می‌دیدم ز بام قصر او روشن","که رو از شرم آن خورشید در دیوار می‌آورد","زیبایی ماه رخ او چنان بود که تابش و درخشش آن‌، خورشید خجالت‌زده می‌شد و روی به دیوار می‌کرد."],[145,"ز بیم غارت عشقش، دل پرخون رها کردم","ولی می‌ریخت خون و ره بدان هنجار می‌آورد","از بیم غارتگری عشق او دل غمگین و پردرد را رها کردم اما خون گریه می‌کرد و مرا دوباره به راه عشقش می‌کشاند."],[145,"به قول مطرب و ساقی، برون رفتم گه و بی‌گه","کز آن راه گران، قاصد، خبر، دشوار می‌آورد","برای شنیدن ساز و آواز مطرب و نوشیدن می ساقی‌، می‌رفتم که پیغام او توسط قاصد به من نمی‌رسید (و پیام‌های او را از ساقی و مطرب می‌شنیدم)(راه گران هم به معنی راه دشوار است و هم اصطلاح موسیقی است)"],[145,"سراسر بخشش جانان، طریق لطف و احسان بود","اگر تسبیح می‌فرمود، اگر زنّار می‌آورد","محبوب من هرچه می‌کرد سراسر و تماما احسان و لطف بود اگر تسبیح دین دستور می‌داد و اگر زنار بی‌دینی می‌آورد."],[145,"عفاالله چین ابرویش اگر چه ناتوانم کرد","به عشوه هم پیامی بر سر بیمار می‌آورد","خدا ببخشد بر چین و اخم ابروانش‌، اگرچه مرا بیمار و غمگین کرد؛ و ناز همان ابروان درمان بیماری من بود."],[145,"عجب می‌داشتم دیشب ز حافظ جام و پیمانه","ولی منعش نمی‌کردم که صوفی‌وار می‌آورد","دیشب در عجب بودم از حافظ و میگساری؛ اما نمی‌توانستم منعش کنم چون‌که صوفی‌وار و پاک‌باز و سخاوتمندانه می‌آورد."],[146,"برید باد صبا دوشم آگهی آورد","که روز محنت و غم رو به کوتهی آورد","باد صبا شب گذشته خبری آورد که روزهای سختی و اندوه به پایان می‌رسد."],[146,"به مطربان صبوحی دهیم جامه چاک","بدین نوید که باد سحرگهی آورد","به نوازندگان شراب‌نوشان (صبوحی) بگوییم که لباس‌های چاکدار (پاره‌پاره) به آن‌ها بدهند، زیرا باد سحرگاه بشارتی خوش را به ارمغان آورده است."],[146,"بیا بیا که تو حور بهشت را رضوان","در این جهان ز برای دل رهی آورد","بیایید، زیرا شما مانند حوریان بهشتی هستید و «رضوان» (فرشته‌ای که نگهبان بهشت است) در این دنیا شما را به خاطر قلب دل‌باخته‌ام به من آورده است."],[146,"همی‌رویم به شیراز با عنایت دوست","زهی رفیق که بختم به همرهی آورد","به عشق و محبت دوست، در حال سفر به شیراز هستم و از این دوستی خوشحالم، زیرا بخت من به خاطر همراهی او خوب شده است."],[146,"به جبر خاطر ما کوش کـ‌این کلاه نمد","بسا شکست که با افسر شهی آورد","در خوشحالی ما بکوش زیرا، این کلاه نمد، چه بسیار تاج شاهی را که شکست داده است!"],[146,"چه ناله‌ها که رسید از دلم به خرمن ماه","چو یاد عارض آن ماه خرگهی آورد","از دل من ناله‌ها و آه‌هایی بلند به سوی نهان‌خانه‌ای که در آن یاد آن ماه زیبا (که به خانۀ خود بازمی‌گردد) به گوش می‌رسد، رسید."],[146,"رساند رایت منصور بر فلک حافظ","که التجا به جناب شهنشهی آورد","چرخش پرچم (رایت) منصور، اشاره به پیروزی و عظمت اوست، بر آسمان (فلک) حافظ در خواسته‌اش از پادشاه (شهنشه) برای پناه بردن به او."],[147,"یارم چو قدح به دست گیرد","بازار بتان شکست گیرد","وقتی که چشمان یار من مست می‌شود‌، تمام زیبارویان و بت‌ها در برابر زیبایی او بی‌رونق می‌شوند."],[147,"هر کس که بدید چشم او گفت","«کو محتسبی که مست گیرد؟»","هرکس که چشم بی‌رحم و مست او را دید فریاد برآورد که : کجاست شحنه و محتسب تا این مست را بگیرد؟"],[147,"در بحر فتاده‌ام چو ماهی","تا یار مرا به شست گیرد","همچون ماهی در دریایی افتاده‌ام تا یار، مرا صید کند."],[147,"در پاش فتاده‌ام به زاری","آیا بود آن که دست گیرد؟","در پای او به‌زاری افتاده‌ام تا شاید مرا نجات دهد."],[147,"خرّم دل آن که همچو حافظ","جامی ز می الست گیرد","خوشا به‌حال کسی که همچون حافظ جامی از باده الست نوشید."],[148,"دلم جز مهر مه‌رویان، طریقی بر نمی‌گیرد","ز هر در می‌دهم پندش، ولیکن در نمی‌گیرد","دل من جز مهر و محبت زیبارویان به‌راه دیگری نمی‌رود و هرچه او را پند می‌دهم که از این کار دست بردارد، سودی ندارد."],[148,"خدا را ای نصیحت‌گو، حدیث ساغر و می گو","که نقشی در خیال ما، از این خوش‌تر نمی‌گیرد","تو را به خدا ای آدم نصیحت‌گو و خیرخواه‌، برای ما حرف از ساغر و باده بیشتر بزن که در فکر و خیال ما جز این حرف، حرف دیگری تاثیر ندارد."],[148,"بیا ای ساقی گل‌رخ‌، بیاور باده رنگین","که فکری در درون ما، از این بهتر نمی‌گیرد","ای ساقی لطیف‌چهره و زیبا، باده‌ای سرخ بیاور که چیزی بهتر از این نمی‌شناسیم."],[148,"صراحی می‌کشم پنهان و مردم دفتر انگارند","عجب‌! گر آتش این زرق در دفتر نمی‌گیرد","من باده ناب سر می‌کشم و مست هستم و مردم فکر می‌کنند که مشغول عبادت و خواندن دفتر هستم؛ شگفتا که آتش گناه این ریاکاری من در دفتر در‌نمی‌گیرد!"],[148,"من این دلق مرقّع را، بخواهم سوختن روزی","که پیر می فروشانش‌، به جامی بر نمی‌گیرد","روزی این جامه ریا را خواهم سوخت زیرا هرچه کردم پیر می‌فروش آن‌را به یک جام باده نخرید!"],[148,"از آن رو هست یاران را، صفا‌ها با می لعلش","که غیر از راستی نقشی، در آن جوهر نمی‌گیرد","یاران و دوستان ما از آن‌جهت از باده سرخ او سرمست و سرخوش هستند که غیر از راستی و یک‌رنگی نقشی در آن گوهر ناب نمی‌گیرد و پذیرفته نمی‌شود!"],[148,"سر و چشمی چنین دلکش، تو گویی چشم از او بردوز؟","برو کاین وعظ بی‌معنی‌، مرا در سر نمی‌گیرد","رخی چنین زیبا و چشمی این چنین خوش و دلکش، آنوقت تو به من می‌گویی به او نگاه مکن!؟ مرا به‌حال خود بگذار که پند بی‌معنی تو بر من بی‌اثر است."],[148,"نصیحتگو‌‌ی رندان را، که با حکم قضا جنگ است","دلش بس تنگ می‌بینم، مگر ساغر نمی‌گیرد","آن نصیحت‌گو که رندان مست را پند می‌دهد؛ کار او در حکم جنگ با قضا و قدر است؛ او را بسیار افسرده و غمگین می‌بینم، آیا باده نمی‌نوشد؟"],[148,"میان گریه می‌خندم‌، که چون شمع اندر این مجلس","زبان آتشینم هست، لیکن در نمی‌گیرد","در میان گریه و در اوج غم می‌خندم زیرا همچون شمع که در مجلس می‌سوزد و خاموش است من هم زبانی گویا و آتشین دارم اما خموش هستم."],[148,"چه خوش صید دلم کردی، بنازم چشم مستت را","که کس مرغان وحشی را، از این خوش‌تر نمی‌گیرد","کسی نتوانست دل مرا برباید جز تو؛ آفرین بر چشمان خمار و مست تو که هیچکس پرنده وحشی ( یا در بعضی نسخه‌ها «آهوی وحشی») را بهتر از این نمی‌تواند صید کند."],[148,"سخن در احتیاج ما و استغنا‌ی معشوق است","چه سود افسونگر‌ی ای دل؟ که در دلبر نمی‌گیرد","حرف‌هایی که زده می‌شود همه از نیاز ما و ناز معشوق است؛ حیله و فن و افسون چه سود دارد وقتی که همه بر او بی‌اثر است؟"],[148,"من آن آیینه را روزی، به دست آرم سکندر‌وار","اگر می‌گیرد این آتش زمانی‌، ور نمی‌گیرد","من روزی آن آیینه را همچون اسکندر جهاندار به‌دست خواهم آورد؛ چه آنکه این آتش زمانی درمی‌گیرد و گاهی در نمی‌گیرد."],[148,"خدا را رحمی ای منعم‌، که درویش سر کویت","دری دیگر نمی‌داند، رهی دیگر نمی‌گیرد","تو را به‌خدا ای صاحب توانگر، به فریاد و کمک نیازمند سر کویت برس زیرا او جز تو به دری دیگر نمی‌رود و جز تو کسی را نمی‌شناسد و به‌راه دیگر نمی‌رود."],[148,"بدین شعر تر شیرین‌، ز شاهنشه عجب دارم","که سر تا پای حافظ را، چرا در زر نمی‌گیرد","با این شعر تازه و لطیف که حافظ سرود، تعجب می‌کنم که چرا شاهنشاه سراپای او را پر از زر و جواهر نمی‌کند و قدر او را نمی‌داند؟"],[149,"ساقی ار باده از این دست به جام اندازد","عارفان را همه در شرب مدام اندازد","اگر ساقی از چنین باده‌ای در جام بریزد، همه عارفان به باده‌گساری پیوسته خواهند پرداخت."],[149,"ور چنین زیر خم زلف نهد دانه خال","ای بسا مرغ خرد را که به دام اندازد","و اگر خال را چنین زیر شکن زلف پنهان کند، بسیاری از لاف‌زنان خرد را نیز به دام می‌اندازد."],[149,"ای خوشا دولت آن مست که در پای حریف","سر و دستار نداند که کدام اندازد","خوش به حال مستی که نمی‌داند در پای جانان سر ببازد یا دستار!"],[149,"زاهد خام که انکار می و جام کند","پخته گردد چو نظر بر می خام اندازد","اگر زاهد ناپخته [و ناسازگار]–که می و جام را انکار می‌کند–اندکی از باده تازه بنوشد، از خامی درمی‌آید [رستگار می‌شود]."],[149,"روز در کسب هنر کوش که می خوردن روز","دل چون آینه، در زنگ ظلام اندازد","روز در آموختن هنر بکوش زیرا باده خوردن در روز، دلی را که چون آینه است دچار زنگار سیاه می‌کند"],[149,"آن زمان وقت می صبح فروغ است که شب","گرد خرگاه افق پرده شام اندازد","آن زمان وقت نوشیدن باده روشنی بخش بامداد است که شب، پرده سیاه گرداگرد اردوگاه افق می‌کشد."],[149,"باده با محتسب شهر ننوشی زنهار","بخورد باده‌ات و سنگ به جام اندازد","هشدار که باده با محتسب شهر ننوشی! زیرا باده‌ات را می‌خورد و جامت را می‌شکند."],[149,"حافظا سر ز کله گوشه خورشید برآر","بختت ار قرعه بدان ماه تمام اندازد","حافظ! اگر بخت قرعه آن ماه شب چهارده را به نام تو زد، بر خود ببال (سر از گوشه کلاه خورشید بیرون بیاور)."],[150,"دمی با غم به سر بردن، جهان یک سر نمی‌ارزد","به می بفروش دلق ما، کز این بهتر نمی‌ارزد","یک لحظه زندگی با غم و اندوه، به اندازه‌ی کل جهان نمی‌ارزد. لباس درویشی من را در قبال یک جام شراب بفروش که این بهترین معامله است."],[150,"به کوی می فروشانش، به جامی بر نمی‌گیرند","زهی سجاده تقوا که یک ساغر نمی‌ارزد","چه بسیار سجاده ی (جانماز) انسان های به ظاهر با تقوا، که در بازار می فروشان حتی به اندازه ی یک جام شراب هم ارزش ندارد."],[150,"رقیبم سرزنش‌ها کرد کز این باب رخ برتاب","چه افتاد این سر ما را که خاک در نمی‌ارزد؟","رقیب نادانم مرا سرزنش میکند که از رفتن به میخانه منصرف شوم. چه تصوری در ذهن ما انسان ها افتاده است که حتی سرمان از خاک در میخانه بی ارزش تر است."],[150,"شکوه تاج سلطانی که بیم جان در او درج است","کلاهی دلکش است اما به ترک سر نمی‌ارزد","تاج با شکوه سلطان، که در اصل ترس جانش در آن درج شده است. گرچه کلاهی زیباست، اما داشتنش به از دست دادن حضور و شرف انسانی نمی ارزد."],[150,"چه آسان می‌نمود اول غم دریا به بوی سود","غلط کردم که این طوفان به صد گوهر نمی‌ارزد","در ابتدا فکر میکردم که تحمل سختی نوردیدن دریای طوفانی زندگی، به خاطر سود مادی اش، خیلی ساده است. واقعا اشتباه تصور میکردم زیرا صد گوهر گران بها هم به تن دادن به این طوفان نمی ارزد."],[150,"تو را آن به که روی خود ز مشتاقان بپوشانی","که شادیّ جهانگیری، غم لشکر نمی‌ارزد","بهتر است که تو صورت و روی خود را از دوستدارانت پوشیده نگه داری، چرا که لذت و شادی تسخیر دنیا در برابر ناراحتی افراد لشکر ارزشی ندارد"],[150,"چو حافظ در قناعت کوش و از دنیای دون بگذر","که یک جو منّت دونان دو صد من زر نمی‌ارزد","مثل حافظ قانع باش که در قناعت گنجی هست که تورو از منت نان رها میکنه"],[151,"در ازل پرتو حسنت ز تجلی دم زد","عشق پیدا شد و آتش به همه عالم زد","در عالم ابداع و پیش از آفرینش نوری از جمال الهی پدیدار گشت ؛ اشاره به حدیث قدسی (کنت کنزا مخفیا فاحببت ان اعرف فخلقت الخلق لکی اعرف) : گنجی پنهان بودم خواستم شناخته شوم پس خلائق را آفریدم . عشق به عنوان قوه ی محرکه که از تجلی خداوند سرچشمه می گیرد پدید آمد و منجر به ایجاد شور و شوق و تحول و حرکت در تمامی ذرات عالم گشت."],[151,"جلوه‌ای کرد رخت دید ملک عشق نداشت","عین آتش شد از این غیرت و بر آدم زد","زمانی که جلوه ی جمال و حسن تو درخشید ٬ ابلیس آن را مشاهده کرد و چون در سرشت و فطرت او عشق وجود نداشت از شدت حسادت همچون آتش سوزان شد و خود را بر دل آدم زد تا او را از این عشق گمراه کند."],[151,"عقل می‌خواست کز آن شعله چراغ افروزد","برق غیرت بدرخشید و جهان برهم زد","عقل مصلحت اندیش می خواست از شعله ی عشق چراغ راه خودش را روشن کند و از این رهگذر سودی ببرد اما عشق مانع چراغ افروزی عقل از شعله ی عشق شد."],[151,"مدعی خواست که آید به تماشاگه راز","دست غیب آمد و بر سینه نامحرم زد","مدعی (کسی که خود را اهل معرفت می‌داند) خواست به تماشای مسائل پنهانی و رازها بیاید، اما در این میان، دست غیب (قدرت الهی یا نیروی نامرئی) آمد و بر سینه کسی که نباید از آن رازها آگاه می‌شد، ضربه‌ای زد."],[151,"دیگران قرعه قسمت همه بر عیش زدند","دل غمدیده ما بود که هم بر غم زد","دیگران آنقدر به خوشی و لذت و بهره‌برداری از زندگی مشغول بودند که قرعه قسمت را برای خودشان به ارمغان آوردند، در حالی که دل غم‌زده ما فقط بر درد و اندوه خود تمرکز کرده بود."],[151,"جان علوی هوس چاه زنخدان تو داشت","دست در حلقه آن زلف خم اندر خم زد","روح علوی، که به معنای روح بلند و عالی است، شوق و آرزوی چاه زیبایی زنخدان تو را داشت و در حالی که دستش را در میان طره آن زلف پیچیده و خمیده فرو برد، بر آن زلف تکیه زد."],[151,"حافظ آن روز طربنامه عشق تو نوشت","که قلم بر سر اسباب دل خرّم زد","حافظ در آن روزی که شادمان بود و به عشق تو می‌اندیشید، درباره احساسات و عشق‌اش به تو نوشت و قلمش روی دل شادابش حرکت کرد."],[152,"سحر چون خسرو خاور، علم بر کوهساران زد","به دست مرحمت، یارم، در امیدواران زد","بامدادان که خورشید بر کوهساران تابید، یارم از سر مهر در خانه امیدواران را کوبید"],[152,"چو پیش صبح روشن شد که حال مهر گردون چیست","برآمد خنده‌ای خوش بر غرور کامگاران زد","با روشن شدن صبح و مشخص شدن حال خورشید، خنده‌ای دل‌انگیز بر چهره‌ی مغرور و خوشبختی‌ها افکنده شد."],[152,"نگارم دوش در مجلس، به عزم رقص چون برخاست","گره بگشود از گیسو و بر دل‌های یاران زد","نگارم که دیشب در مجلس به قصد رقص برخاست، گره از گیسو گشود و آنرا کمند دل یاران کرد."],[152,"من از رنگ صلاح آن دم، به خون دل بشستم دست","که چشم باده پیمایش صلا بر هوشیاران زد","من در آن لحظه خوش که رنگ و بوی صلاح را احساس کردم، با دل‌شکستگی و غم، دست خود را شستم، زیرا که چشم‌های باریک این عشق، ندا و دعوتی به هوشیاران (آگاهان) داد."],[152,"کدام آهن‌دلش آموخت این آیین عیّاری؟","کز اول چون برون آمد، ره شب‌زنده‌داران زد","کدام دل قوی و بی‌احساس به او آموخته است که این‌طور با اینکه از ابتدا بیرون آمده، راه و رسم شب‌زنده‌داران را انتخاب کند و به رفتار آنان conform کند؟"],[152,"خیال شهسواری پخت و شد ناگه دل مسکین","خداوندا! نگه دارش که بر قلب سواران زد","دل مسکین شاعری عاشق، ناگهان به یاد تصویری از یک شاهزاده یا جوان خوش‌چهره می‌افتد. ای خدا! نگه‌دار این خیال را چون بر دل سواران (عاشقان) اثر گذاشته و آن‌ها را تحت تأثیر قرار می‌دهد."],[152,"در آب و رنگ رخسارش، چه جان دادیم و خون خوردیم","چو نقشش دست داد اول، رقم بر جان‌سپاران زد","در زیبایی و رنگ و روی او، چه عشق‌هایی را فدای او کردیم و چه دردها کشیدیم، چون اولین بار که تصویری از او دیدیم، بر دل عاشقانی که جان خود را فدای او کرده بودند، اثر گذاشت."],[152,"منش با خرقه پشمین، کجا اندر کمند آرم؟","زره‌مویی که مژگانش ره خنجرگزاران زد","من با این خرقه‌ی پشمی و آدمی ضعیف مثل من چطور می‌تواند او را به‌چنگ بیاورد؛ کسی که او با موی‌ زنجیری و حلقه‌حلقه زره‌مانند و مژگان همچون خنجرش بسیار تیغ‌بدستان را اسیر کرده‌است."],[152,"نظر بر قرعه توفیق و یمن دولت شاه است","بده کام دل حافظ که فال بختیاران زد","به خاطر نیکی و خوش یمنی دولت شاه، حافظ از او می‌خواهد که آرزوها و کام دلش را برآورده کند، چرا که شانس و بخت خوب بر زندگی خوشبختان تأثیر گذاشته است."],[152,"شهنشاه مظفر فر، شجاع ملک و دین منصور","که جود بی‌دریغش خنده بر ابر بهاران زد","منصور، شاه پیروز و شجاعی است که بخشش فراوانش باعث بهار و شادی می‌شود و این بخشندگی مانند بارش باران، خوشحالی را به ارمغان می‌آورد."],[152,"از آن ساعت که جام می به دست او مشرّف شد","زمانه ساغر شادی به یاد می‌گساران زد","از وقتی که جام شراب به دست او رسید، دنیا نیز به یاد میگساران شروع به شادی و خوشحالی کرد."],[152,"ز شمشیر سرافشانش، ظفر آن روز بدرخشید","که چون خورشید انجم‌سوز تنها بر هزاران زد","آن روز از شمشیر سرافشان او (شاه منصور)، پیروزی نمایان شد که مانند خورشید ستاره سوز، به تنهایی بر هزاران [تن از دشمنان] تاخت."],[152,"دوام عمر و ملک او، بخواه از لطف حق ای دل!","که چرخ، این سکه دولت به دور روزگاران زد","از خدا بخواه که عمر و سلطنت او (سلطان) پایدار بماند، زیرا تقدیر زمان، سرنوشت‌های مختلفی را هر روز می‌سازد و قدرت را به نوبت به دست می‌آورد."],[153,"راهی بزن که آهی بر ساز آن توان زد","شعری بخوان که با او رطل گران توان زد","نغمه‌ای بخوان که با ساز و آواز آن بتوان از درد آه کشید و احساسات را بیان کرد ، شعری را بخوان که بتوان همراه آن جام پر از شراب را نوشید"],[153,"بر آستان جانان گر سر توان نهادن","گلبانگ سربلندی بر آسمان توان زد","اگر بتوان به درگاه معشوق و محبوب جهت بندگی رسید باید از شادی و سربلندی فریاد کشید"],[153,"قدّ خمیده ما سهلت نماید اما","بر چشم دشمنان تیر، از این کمان توان زد","ظاهرا ما متواضع، نرم، یا ضعیف به نظر می‌رسیم (قد خمیده، خمیده بودن)، یعنی ظاهر ما کسی را گول می‌زند که فکر کند ما قدرتی نداریم. اما واقعیت این است که همین ظاهر ضعیف و متواضع، می‌تواند برای دشمن خطرناک باشد؛ یعنی از همین \"کمان خمیده\" می‌توان تیرهای کشنده پرتاب کرد و دشمن را هدف گرفت."],[153,"در خانقه نگنجد اسرار عشقبازی","جام می مغانه هم با مغان توان زد","در خانقاه و محل عبادت عشقبازی مجاز نیست و حتی نمی‌توان در کنار عارفان، جام می را به دست گرفت و برای این کار باید به سرای مغان رفت"],[153,"درویش را نباشد برگ سرای سلطان","ماییم و کهنه دلقی کآتش در آن توان زد","در این بیت، شاعر به این موضوع اشاره می‌کند که درویش (شخصی زاهد و بی‌نیاز) نیازی به مقام و ثروت سلطانی ندارد و خود را به لباس کهنه‌ای تشبیه می‌کند که حتی در آن هم می‌تواند آتشی برافروزد. به عبارت دیگر، او ارزش‌های معنوی و روحانی را بر مادیات و دنیاطلبی ترجیح می‌دهد."],[153,"اهل نظر دو عالم در یک نظر ببازند","عشق است و داو اول بر نقد جان توان زد","عاشقانی که به عمق مسائل فکر می‌کنند، یا صاحب نظران با یک نگاه می‌توانند بی‌نهایت چیزها ی دو عالم را ببازن و از آنها بگذرند. عشق بمانند یک صحنه قمار است که در آن دست اول بازی را بر سر جان باید بازی کرد! کسانی که صاحب نظر هستند، دو عالم را با یک نگاه می‌توانند ببازند. چرا که عشق بمانند یک صحنه قمار است که در آن دست اول بازی را بر سر جان میشود بازی کرد!داو = نوبت بازی در قمارداوطلب = کسی که خودش نوبت را مطالبه میکند.داو = دو : فلانی دو به دستش افتاده ... یعنی الآن نوبت او هست که دو همان داو هست..."],[153,"گر دولت وصالت خواهد دری گشودن","سرها بدین تخیّل بر آستان توان زد","اگر کسی بخواهد به نعمت وصل و دیدار معشوق دست یابد، می‌تواند با تصورات و خیالات عاشقانه‌اش، بر در آستان معشوق، راهی باز کند و به او نزدیک شود."],[153,"عشق و شباب و رندی مجموعه مراد است","چون جمع شد معانی گوی بیان توان زد","عشق، جوانی و رندی، همه خواسته‌های ما هستند. 1-همه شرایط که فراهم باشد، می‌توان ابراز خوشنودی کرد. 2-دانش واژگان‌شناسی که باشد، می‌توان به سخنوری پرداخت. [مصرع دوم معنی دوگانه دارد]"],[153,"شد رهزن سلامت زلف تو وین عجب نیست","گر راهزن تو باشی صد کاروان توان زد","زلف تو (که به نوعی نماد زیبایی و فریبندگی است) از فرط دلربایی سلامت و راحتی من را ربوده است. و این جای تعجبی ندارد، که حتی اگر راهزن کاروان ها تو باشی به اندازه‌ای تاثیرگذار هستی که می‌توانی صد ها کاروان را متوقف کنی."],[153,"حافظ به حقّ قرآن کز شید و زرق بازآی","باشد که گوی عیشی در این جهان توان زد","حافظ به حقانیت قرآن قسم که باید از فریب و مکر دور شد تا بتوان در این جهان به زندگی پرداخت"],[154,"اگر روم ز پی‌اش فتنه‌ها برانگیزد","ور از طلب بنشینم به کینه برخیزد","اگر در پی او بروم، آشوب‌ها به پا می‌کند؛ و اگر دست از جست و جوی او بکشم، به دنبال کینه‌جویی می‌افتد."],[154,"و گر به رهگذری یک دم از وفاداری","چو گرد در پی‌اش افتم چو باد بگریزد","و اگر در رهگذاری یک دم از روی وفاداری به پایش بیفتم، چون باد می‌گریزد."],[154,"و گر کنم طلب نیم بوسه صد افسوس","ز حقّه دهنش چون شکر فرو ریزد","اگر نیم بوسه از او بخواهم، از حقّه دهانش، صد تمسخر شیرین نثارم می‌کند. [1-«حقّه» عبارت است از: الف-جعبه جادویی شعبده‌بازان؛ ب-جای جواهر. 2-«حقه مینا»، اشاره دارد به آسمان. 3-به استناد لغتنامه دهخدا، «افسوس ریختن» یعنی «تمسخر کردن».]"],[154,"من آن فریب که در نرگس تو می‌بینم","بس آبروی که با خاک ره برآمیزد","من زیبایی و فریبی را که در چشمان تو می‌بینم، می‌دانم که آبروهای زیادی را به خاک می‌کشد و خوار می‌گرداند."],[154,"فراز و شیب بیابان عشق، دام بلاست","کجاست شیردلی کز بلا نپرهیزد","سختی‌ها و ناملایمات عشق مانند دام‌های خطرناکی هستند. کجا می‌توان کسی را پیدا کرد که شجاعت و دلیری داشته باشد و از این مصیبت‌ها نترسد؟"],[154,"تو عمر خواه و صبوری که چرخ شعبده باز","هزار بازی از این طرفه‌تر برانگیزد","تو باید در زندگی آرزو و شکیبایی داشته باشی، زیرا زمان (چرخ) با ترفندهای خود هزاران اتفاق و ماجرای شگفت‌انگیز را به وجود می‌آورد."],[154,"بر آستانه تسلیم سر بنه حافظ","که گر ستیزه کنی، روزگار بستیزد","بر درگاه تسلیم و رضایت سر خود را فرود بیاور، حافظ، زیرا اگر با سرنوشت و روزگار مخالفت کنی، خود روزگار با تو درگیر خواهد شد."],[155,"به حسن و خلق و وفا کس به یار ما نرسد","تو را در این سخن، انکار کار ما نرسد","هیچ‌کس به زیبایی، اخلاق و وفای یار ما نرسیده است؛ پس نمی‌توانی در این موضوع انکار کنی و منکر کار ما بشوی."],[155,"اگرچه حسن‌فروشان به جلوه آمده‌اند","کسی به حسن و ملاحت به یار ما نرسد","هرچند افرادی که زیبایی و ظرافت را به نمایش می‌گذارند وجود دارند، اما هیچ‌کس به زیبایی و دلربایی محبوب ما نمی‌رسد."],[155,"به حق صحبت دیرین که هیچ محرم راز","به یار یک جهت حق‌گزار ما نرسد","به خاطر صحبت و دوستی گذشته، هیچ‌کس به اندازه یار ما که در وفاداری و حق‌گویی یکتا است، به رازهایمان نزدیک نمی‌شود."],[155,"هزار نقش برآید ز کلک صنع و یکی","به دلپذیری نقش نگار ما نرسد","هزاران تصویر و نقش زیبا می‌تواند از دست هنرمند خلق شود، اما هیچ‌کدام به زیبایی و دلپذیری نقش صورت محبوب ما نخواهد رسید."],[155,"هزار نقد به بازار کائنات آرند","یکی به سکه صاحب عیار ما نرسد","در دنیای بسیار زیادی که ارزش‌ها و نعمت‌ها وجود دارند، هیچ‌کدام به اندازه‌ی زیبایی و ارزش محبوب ما (یا خود محبوب) اهمیت ندارند و نمی‌توانند با آن مقایسه شوند."],[155,"دریغ قافله عمر کآنچنان رفتند","که گردشان به هوای دیار ما نرسد","افسوس که قافله عمر به‌سرعت و سهولت حرکت کرد و به جایی رسید که خاک پایی آنها به دیار ما نخواهد رسید."],[155,"دلا ز رنج حسودان مرنج و واثق باش","که بد به خاطر امیدوار ما نرسد","ای دل، از رنج و آزار حسودان ناراحت نباش و مطمئن باش که نیت بد آن‌ها به کسی که امیدوار است، نمی‌رسد."],[155,"چنان بزی که اگر خاک ره شوی کس را","غبار خاطری از رهگذار ما نرسد","چنان زندگی کن که اگر روزی مردی و اجزای وجودت جزو خاک شد و در راهی ریخته شد ، حتی غباری که از آن خاک بلند میشود ، دل کسی را آزرده نکند"],[155,"بسوخت حافظ و ترسم که شرح قصه او","به سمع پادشه کامگار ما نرسد","حافظ به شدت دلتنگ و نابود شده است و نگران است که داستان زجر و دردش به گوش پادشاه خوشبختی نرسد."],[156,"هر که را با خط سبزت سر سودا باشد","پای از این دایره بیرون ننهد تا باشد","هرکسی روی پرطراوت تو را دید، تا روزی‌که زنده‌است عاشق تو خواهد بود."],[156,"من چو از خاک لحد لاله‌صفت برخیزم","داغ سودای توام سرّ سویدا باشد","زمانی که از خاک گور برخیزم، داغ عشق تو بر دلم، همچون راز لکه سیاه خواهد بود. [«سویدا» یا همان «لکه سیاه» اشاره دارد به حدیثی که در آن خداوند بر دل گناهکار لکه‌ای سیاه به وجود می‌آورد.]"],[156,"تو خود ای گوهر یک‌دانه کجایی آخر","کز غمت دیده مردم همه دریا باشد","تو ای گوهر بی‌همتا، کجایی؛ که به خاطر غم فراق تو، چشمان مردم دریای اشک شده است."],[156,"از بن هر مژه‌ام آب روان است بیا","اگرت میل لب جوی و تماشا باشد","از ریشه هر مژه‌ام اشک جاری است، اگر تو بخواهی می‌توانی به لب جوی بیایی و تماشا کنی."],[156,"چون گل و می دمی از پرده برون آی و درآ","که دگرباره ملاقات نه پیدا باشد","همچون گل و شراب، یک لحظه از پرده بیرون بیا و خود را نشان بده، زیرا ممکن است دیگر نتوانیم دوباره همدیگر را ببینیم."],[156,"ظلّ ممدود خم زلف توام بر سر باد","کاندر این سایه قرار دل شیدا باشد","من تحت سایه طولانی و خوش‌بوی زلف تو هستم و امیدوارم که در این سایه، دل عاشق و شیدا آرامش یابد."],[156,"چشمت از ناز به حافظ نکند میل آری","سرگرانی صفت نرگس رعنا باشد","چشم تو به خاطر ناز توجهی به حافظ نمی‌کند؛ این سر سنگینی، صفت نرگس رعنا می‌باشد. [به استناد لغتنامه دهخدا، «گل رعنا» گلی است دو رنگ.]"],[157,"من و انکار شراب! این چه حکایت باشد؟","غالبا این قدرم عقل و کفایت باشد","من و انکار شراب؟ این چه داستانی است؟ بی شک تا این اندازه عقل و هوش دارم (که این کار را نکنم)."],[157,"تا به غایت ره میخانه نمی‌دانستم","ور نه مستوری ما تا به چه غایت باشد","تا اخر، راه میخانه را نمی‌دانستم وگرنه، پارسایی (پرده پوشی) ما هم اندازه‌ای دارد."],[157,"زاهد و عجب و نماز و من و مستی و نیاز","تا تو را خود ز میان با که عنایت باشد","زاهد است و خودبینی و نماز؛ منم و مستی و نیاز. تا ببینیم کدامیک را می‌پسندی."],[157,"زاهد ار راه به رندی نبرد معذور است","عشق کاری‌ست که موقوف هدایت باشد","اگر زاهد راه رندی نپیماید، عذرش پذیرفته است. (زیرا) عشق کاری است که به هدایت (خداوند) نیاز دارد."],[157,"من که شب‌ها ره تقوا زده‌ام با دف و چنگ","این زمان سر به ره آرم؟ چه حکایت باشد!","من که شب‌ها با نواختن دف و چنگ تقوا را زیر پا گذاشته‌ام، چه داستانی است که ناگهان سر به راه شوم!"],[157,"بنده پیر مغانم که ز جهلم برهاند","پیر ما هر چه کند عین عنایت باشد","من بنده پیر مغان هستم که او مرا از جهل نجات می‌دهد. هر کاری که او انجام دهد، همواره به نفع و با مهربانی است."],[157,"دوش از این غصه نخفتم که رفیقی می‌گفت","«حافظ ار مست بود جای شکایت باشد»","دیشب به خاطر غم و اندوهی که داشتم، نتوانستم بخوابم، زیرا دوستی می‌گفت که اگر حافظ مست باشد، باید از او شکایت کرد و به او اعتراض داشت."],[158,"نقد صوفی نه همه صافی بی‌غش باشد","ای بسا خرقه که مستوجب آتش باشد","دارایی صوفی صرفا شراب پاک و پالوده نیست؛ بلکه خرقه‌ای نیز دارند که لایق سوزاندن است."],[158,"صوفی ما که ز ورد سحری مست شدی","شامگاهش نگران باش که سرخوش باشد","این صوفی ما که با دعای صبحگاهی به حالت مستی درآمده، در زمان غروب به او بنگر که از شراب انگور مست می‌شود."],[158,"خوش بود گر محک تجربه آید به میان","تا سیه‌روی شود هر که در او غش باشد","اگر محک تجربه در میان بیاید، خوب است، زیرا باعث می‌شود هر کس که در حقیقت خود را پنهان کرده و ناپاک است، رسوا و سیه‌روی شود."],[158,"خطّ ساقی گر از این گونه زند نقش بر آب","ای بسا رخ که به خونآبه منقّش باشد","اگر چنین، خط سبز ساقی، تصویر او را در آب بیاندازد، چه بسیار چهره‌هایی که در حون غوطه می‌خورند. [احتمالا منظور شاعر، افتادن تصویر زیبای ساقی در شراب سرخ باشد که تصویرش در آن شناور است و باعث شیفتگی عاشقان می‌شود.]"],[158,"ناز‌پرورد تنعّم نبرد راه به دوست","عاشقی شیوه رندان بلاکش باشد","کسی که در ناز و تنعم بزرگ شده و لطافت را تجربه کرده، نمی‌تواند به دوست واقعی (خدا یا محبوب) راه پیدا کند. عشق باید به سبک و سیاق رندانی باشد که در سختی‌ها و بلاها هم سرسخت و مقاوم هستند."],[158,"غم دنیای دنی چند خوری؟ باده بخور","حیف باشد دل دانا که مشوّش باشد","چقدر باید به غم‌های دنیایی که بی‌ارزش و پست است اهمیت بدهی؟ بهتر است شراب بنوشی، زیرا دل آگاه و درک‌دار را شرم‌ساری است که بی‌قرار و مضطرب باشد."],[158,"دلق و سجاده حافظ ببرد باده‌فروش","گر شرابش ز کف ساقی مه‌وش باشد","اگر باده‌فروش شرابش را از دست ساقی زیبا و دلربا بگیرد، لباس و سجاده حافظ را خواهد برد."],[159,"خوش است خلوت اگر یار یار من باشد","نه من بسوزم و او شمع انجمن باشد","اگر یار من در خلوت با من باشد، آنجا بسیار خوش است؛ ولی اگر من تنها بسوزم و او در جمع دیگران مانند شمع درخشنده باشد، این وضعیت خوشایند نیست."],[159,"من آن نگین سلیمان به هیچ نستانم","که گاه گاه بر او دست اهرمن باشد","من حتی اون نگین سلیمانی رو به کمترین قیمت هم نگیرم اگر فقط قرار باشه بعضی اوقات دست اهریمن و شیطان باشه"],[159,"روا مدار خدایا که در حریم وصال","رقیب محرم و حرمان نصیب من باشد","خدایا، اجازه نده که در عرصه عشق و وصال، کسی که رقیب من است به او محرم باشد و دسترسی داشته باشد و من از آن نعمت محروم باشم و نامحرم باشم."],[159,"همای گو مفکن سایه شرف هرگز","در آن دیار که طوطی کم از زغن باشد","به همای سعادت بگو که سایه ی لطف خود را بر سرزمینی که انسانهای فهیم و اندیشمند کمتر از افراد بیخرد و نادان مورد توجه قرار می‌گیرند ، هرگز نگستراند."],[159,"بیان شوق چه حاجت؟ که سوز آتش دل","توان شناخت ز سوزی که در سخن باشد","شوق و Desire را با بیان کردن نمی‌توان به کسی فهماند، چرا که فقط با احساس سوز و آتش دل می‌توان عمق آن را درک کرد، نه با کلمات و سخنان."],[159,"هوای کوی تو از سر نمی‌رود آری","غریب را دل سرگشته با وطن باشد","یاد و خاطره آن مکان خاص (کوی تو) از ذهن و دل من پاک نمی‌شود. به راستی، برای یک بیگانه، دل گم‌شده‌اش همیشه به وطنش تعلق دارد."],[159,"به سان سوسن اگر ده‌زبان شود حافظ","چو غنچه پیش تواش مهر بر دهن باشد","حافظ می‌گوید اگر او (حافظ) مانند سوسن ده زبان داشته باشد، باز هم پیش تو (محبوب) چون غنچه‌ای خواهد بود که مهر و نشانی بر لبانش است و نمی‌تواند سخن بگوید. این یعنی در عشق به تو، حتی اگر سخن بگوید، باز هم زبانش خاموش است و از بیان احساساتش ناتوان خواهد بود."],[160,"کی شعر تر انگیزد خاطر که حزین باشد","یک نکته از این معنی گفتیم و همین باشد","دلی که غمگین باشد هرگز نمیتواند شعر تازه و شاداب بسراید . این موضوع ابعاد متعددی دارد که من یکی از آن ابعاد را گفتم ."],[160,"از لعل تو گر یابم انگشتری زنهار","صد ملک سلیمانم در زیر نگین باشد","ای خدا، ای کاش بوسه ای به نگین انگشترم می زدی تا از خاتم سلیمان هم قدرتش بیشتر می شد و فرمانروایی دنیا به دست من می افتاد (اگر امان و اختیار ویژه ای از طرف خدا برای شاعر ایجاد می شد، این نظام جبری دنیا را به هم می زد و خیلی از سرنوشت های ناخوشایند مردم را تغییر می داد). لعل: لب یار که مانند نگینی از گوهر لعل سرخ و فریبنده است و اگر انگشتری را ببوسد، نگین آن انگشتر هم لعل می شود."],[160,"غمناک نباید بود از طعن حسود ای دل","شاید که چو وابینی خیر تو در این باشد","ای دل، نباید از سخنان بد و طعنه‌های حسود ناراحت باشی، زیرا ممکن است که به خاطر این مشکل، در نهایت خیر تو در آن نهفته باشد."],[160,"هر کو نکند فهمی زین کلک خیال‌انگیز","نقشش به حرام ار خود صورتگر چین باشد","از نظر شاعر، مهمترین عامل زندگی، شانس، تقدیر و سرنوشت است که از پیش نوشته شده و این اصل چنان مسلم است که اگر کسی آن درک نکرده باشد، هیچ چیز از دنیا نفهمیده و زندگی اش پوچ و بی ثمر است، حتی اگر خیلی هم ادعا داشته باشد.کلک خیال انگیز: قلم سرنوشت و تقدیر الهی است که چنان نقاشی پیچیده و وهم انگیزی را می نگارد که بعضی را به قضاوت های خیالی و توهمی راجع به دنیا و خدا می کشاند.صورتگر چین: نقاش زبردستنقشش به حرام: یعنی نقاشی بی معنا و مفهوم که جز تلف کردن رنگ و وقت و ... ثمری ندارد."],[160,"جام می و خون دل هر یک به کسی دادند","در دایره قسمت اوضاع چنین باشد","شاعر چگونگی تقسیم سرنوشت را این طور تصویر کرده: ما در یک میهمانی ای نشسته بودیم که نامش دایره قسمت بوده است و در آن میهمانی افراد می نشسته اند و سرنوشتشان را به شکل یک شراب سرخ در پیاله هایشان می ریخته اند. ولی برای بعضی، به صورت کاملا اتفاقی شراب سرخوش کننده ریخته نمی شود، بلکه خون دل در پیاله هایشان ریخته می شود و آن ها مجبورند آن را در طول زندگی سر بکشند."],[160,"در کار گلاب و گل حکم ازلی این بود","کاین شاهد بازاری وآن پرده‌نشین باشد","در نظر شاعر، قسمت و تقدیر است که سرنوشت آدم ها را مشخص می کند، تا زیبا روئی مجبور به زیبایی فروشی همگانی باشد و زیبا رویی دیگر در اندرونی، مستور و به دور از فشارهای زندگی، به او رسیدگی شده و با آسایش زندگی کند. (گلاب در واقع همان گل است که تحت فشارهای زندگی او را فشرده اند و پخته اند و از او عرق گرفته اند و در سر هر بازاری فروخته اند.)"],[160,"آن نیست که حافظ را رندی بشد از خاطر","که‌این سابقه پیشین تا روز پسین باشد","ین نکته دانی و صداقت جسارت آمیز حافظ هم یکی از نعمت های ازلی است که در سرنوشت او نوشته شده و این ویژگی در روز اول خلقت به او اعطا شده و تا قیامت هم باقی خواهد ماند. رندی: آزادگی، صداقت، جسارت، هوش و نکته بینی عارف،سابقه پیشین: مربوط به روز اول خلقت،روز پسین: روز قیامت"],[161,"خوش آمد گل وز آن خوش‌تر نباشد","که در دستت بجز ساغر نباشد","فصل گل و بهار و زیبایی است و چیزی بهتر از این نیست که مست و شاد باشی."],[161,"زمان خوش‌دلی دریاب و در یاب","که دایم در صدف گوهر نباشد","قدر لحظات خوش و نیک‌دلی را دریاب و آن‌را از دست مده زیرا همیشه اینچنین در صدف‌ لحظه‌‌ها، در و گوهر نیست."],[161,"غنیمت دان و می خور در گلستان","که گل تا هفته دیگر نباشد","شادی را غنیمت شمر و در میان گل‌ها باش زیرا عمر این گل‌ها و لحظات‌، همیشگی و تا ابد نیست و شاید دیگر به‌دست نیاید."],[161,"ایا پرلعل کرده جام زرّین","ببخشا بر کسی کش زر نباشد","و وقتی که شاد و دارا هستی دیگران را نیز شاد بگردان و از مال خود به شکرانه ببخش."],[161,"بیا ای شیخ و از خم‌خانه ما","شرابی خور که در کوثر نباشد","ای شیخی ‌(که شادی و مستی را نمی‌پسندی‌ و آن‌را به بهشت وعده می‌کنی) بیا از این خم‌خانه و انبار شراب ما‌، شرابی بنوش که آن‌را در بهشت نیز نخواهی یافت."],[161,"بشوی اوراق اگر هم‌درس مایی","که علم عشق در دفتر نباشد","و تو اگر هم‌درس ما هستی و با ما موافق؛ اوراق و کتاب‌ها را به فراموشی سپار زیرا عشق چیزی نیست که از کتاب و مکتب بیاموزی."],[161,"ز من بنیوش و دل در شاهدی بند","که حسنش بسته زیور نباشد","بنیوش‌: بشنو."],[161,"شرابی بی‌خمارم بخش یا رب","که با وی هیچ درد سر نباشد","خدایا شراب بی‌خماری به من بده که سر درد نیاورد. [شراب بی‌خمار، شرابی است که نوشیدنش، پی‌آور سردرد نیست. چنین شرابی، عملا دارای کمترین مقدار قند و نیز هیستامین است.]"],[161,"من از جان بنده سلطان اویسم","اگر چه یادش از چاکر نباشد","من از صمیم قلب‌، تسلیم و خدمت‌گزار سلطان اویس هستم، هرچند او ممکن است مرا فراموش کرده باشد."],[161,"به تاج عالم آرایش که خورشید","چنین زیبنده افسر نباشد","به تاج جهان‌آرای او سوگند که خورشید نیز، چنین زیبنده تاج نیست."],[161,"کسی گیرد خطا بر نظم حافظ","که هیچش لطف در گوهر نباشد","کسی به شعر حافظ ایراد می‌گیرد که در ذات او لطفی نیست."],[162,"گل بی‌رخ یار خوش نباشد","بی‌باده بهار خوش نباشد","گل بدون چهره محبوب زیبا نیست و بهار بدون شراب خوشایند نیست."],[162,"طرف چمن و طواف بستان","بی‌لاله‌عذار خوش نباشد","گشت و گذار در باغ و چمن بدون حضور دختر زیبایی که مانند لاله است، خوشایند نیست."],[162,"رقصیدن سرو و حالت گل","بی‌صوت هزار خوش نباشد","حرکت و زیبایی سرو و وضع گل بدون صدای هزار (هزار، نوعی پرنده‌ای با صدای زیبا) خوشایند نیست."],[162,"با یار شکرلب گل‌اندام","بی‌بوس و کنار خوش نباشد","در کنار یار خوش‌صورت و خوش‌طعم، بدون بوسیدن و در آغوش کشیدن، لذت‌بخش نیست."],[162,"هر نقش که دست عقل بندد","جز نقش نگار، خوش نباشد","هر تصویری که عقل بتواند بسازد، جز تصویر صورت زیبا و دلنشین معشوق، خوب و دلپذیر نیست."],[162,"جان نقد محقّر است حافظ","از بهر نثار خوش نباشد","زندگی ارزش و بهای کمی دارد؛ بنابراین، حافظ نمی‌پسندد که جانش را بیهوده برای چیزهای کم‌ارزش و بی‌اهمیت فدای کند."],[163,"نفس باد صبا مشک‌فشان خواهد شد","عالم پیر دگرباره جوان خواهد شد","باد صبحگاهی عطری دل‌انگیز به همراه خواهد داشت ، دنیا کهن دوباره جوان و سرزنده خواهد گردید."],[163,"ارغوان جام عقیقی به سمن خواهد داد","چشم نرگس به شقایق نگران خواهد شد","درخت ارغوان، جامی از سنگ عقیق به گل سمن می‌دهد و چشم‌های نرگس به طرف شقایق‌ها با نگرانی نگاه خواهند کرد."],[163,"این تطاول که کشید از غم هجران بلبل","تا سراپرده گل نعره‌زنان خواهد شد","بلبل به‌خاطر غم جدایی، مدتی به‌خاطر دلتنگی و اندوه کشیده خواهد شد، اما در نهایت به سوی گل برمی‌گردد و ناله و فریادش دوباره آغاز می‌شود."],[163,"گر ز مسجد به خرابات شدم خرده مگیر","مجلس وعظ دراز است و زمان خواهد شد","اگر از مسجد به میخانه رفتم، ایرادی نگیر؛ چون مجلس وعظ طولانی است و زمان زیادی از دستم خواهد رفت."],[163,"ای دل ار عشرت امروز به فردا فکنی","مایه نقد بقا را که ضمان خواهد شد؟","ای دل، اگر لذت امروز را کنار بگذاری و به فردا بگزاری، چه چیزی می‌تواند ضامن بقا و ادامه زندگی‌ات باشد؟"],[163,"ماه شعبان منه از دست قدح، کاین خورشید","از نظر تا شب عید رمضان خواهد شد","در ماه شعبان، تا وقتی که شب عید رمضان فرا نرسیده، از خوردن شراب و لذت بردن دست نکش؛ زیرا این خورشید (شعور و روشنی) تا آن زمان در دسترس است و پس از آن، ممکن نیست."],[163,"گل عزیز است غنیمت شمریدش صحبت","که به باغ آمد از این راه و از آن خواهد شد","علی زارع:یار خوب مثل گل دوست داشتنی است پس لحظاتی که با یار هستی را غنیمت بشمار، زیرا همواره زیبایی‌های زندگی مثل گل به این باغ می‌آیند و از راه‌های مختلف به ما می‌رسند."],[163,"مطربا مجلس انس است غزل خوان و سرود","چند گویی که چنین رفت و چنان خواهد شد؟","ای مطرب، مجلس دوستان پر از جست و خیز و شادی است و تو غزل و آواز بخوان. بگو، چرا از آنچه که گذشت و بر خواهد آمد، این‌گونه نگران هستی؟"],[163,"حافظ از بهر تو آمد سوی اقلیم وجود","قدمی نه به وداعش که روان خواهد شد","حافظ به خاطر تو به این جهان آمده و قدمی در این دنیا می‌گذارد. او را به خاطر رفتنش وداع نکن، چرا که او به زودی خواهد رفت."],[164,"مرا مهر سیه چشمان ز سر بیرون نخواهد شد","قضای آسمان است این و دیگرگون نخواهد شد","عشق زیبارویان سیاه‌چشم از فکر و دل و جان من بیرون نخواهد رفت، این بخشی از تقدیر آسمانی من است و تغییر نخواهد کرد."],[164,"رقیب آزارها فرمود و جای آشتی نگذاشت","مگر آه سحرخیزان سوی گردون نخواهد شد؟","رقیب آزارها رساند آنقدر که جای آشتی نگذاشت؛ آیا آه سحرخیزان بی‌پاسخ خواهد ماند؟"],[164,"مرا روز ازل کاری به جز رندی نفرمودند","هر آن قسمت که آن جا رفت از آن افزون نخواهد شد","در آغاز آفرینش، کاری جز رندی برای من تعیین نکردند؛ بیش از آن‌چیزی که در آنجا مقدر شده، نخواهد شد."],[164,"خدا را محتسب ما را به فریاد دف و نی بخش","که ساز شرع از این افسانه بی‌قانون نخواهد شد","تو را به خدا ای داروغه، ما را به صدای دف و نی ببخش؛ زیرا قانون شرع از این آواز آسیبی نخواهد دید."],[164,"مجال من همین باشد که پنهان عشق او ورزم","کنار و بوس و آغوشش چه گویم چون نخواهد شد","فرصت و بهره من فقط این است که پنهانی به او عشق بورزم، درباره کنار او بودن و بوسیدن و در آغوش گرفتن او چه بگویم وقتی که هرگز اتفاق نخواهند افتاد."],[164,"شراب لعل و جای امن و یار مهربان ساقی","دلا کی به شود کارت اگر اکنون نخواهد شد","شراب سرخ و جایی خلوت و در کنار ساقی مهربان؛ ای دل اگر امروز به آرزویت نرسی، کی خواهی رسید؟"],[164,"مشوی ای دیده نقش غم ز لوح سینه حافظ","که زخم تیغ دلدار است و رنگ خون نخواهد شد","ای چشم، غم را از دل‌ نوشته‌های حافظ پاک مکن و مشوی، زیرا این درد‌، از زخم عشق است و رنگ خون شسته نمی‌شود و می‌ماند."],[165,"روز هجران و شب فرقت یار آخر شد","زدم این فال و گذشت اختر و کار آخر شد","روز جدایی و شب دوری از یار به پایان رسید و من این فال را زدم و زمان و سرنوشت به پایان خود رسید."],[165,"آن همه ناز و تنعّم که خزان می‌فرمود","عاقبت در قدم باد بهار آخر شد","همه شکوه و جلالی که از پاییز سراغ داریم، در برابر باد جان افزای بهار نه حرفی برای گفتن دارد و نه یارای ماندن دارد"],[165,"شکر ایزد که به اقبال کله گوشه گل","نخوت باد دی و شوکت خار آخر شد","شکر خدا را که به لطف و اتفاقی، تاج و ناز گل به بادهایی که بی‌ثمر و خنک بودند و نیز قدرت خار و زشتی آن‌ها پایان داده شد."],[165,"صبح امّید که بد معتکف پرده غیب","گو برون آی که کار شب تار آخر شد","صبح امیدی که به راز و رمزهای پنهان مربوط می‌شود، اکنون سرانجام فرارسیده است. ای پرده غیب، خارج شو که زمان پایان شب تاریک و مشکلات به معنای روشنایی و روزی نو رسیده است."],[165,"آن پریشانی شب‌های دراز و غم دل","همه در سایه گیسوی نگار آخر شد","غم و پریشانی شب‌های طولانی و اندوه دل من با سایه‌ گیسوی محبوبم به پایان رسید."],[165,"باورم نیست ز بدعهدی ایام هنوز","قصه غصه که در دولت یار آخر شد","باورم نمی‌شود که هنوز به خاطر بی‌وفایی روزگار، داستان غم من که در دوران خوشی یار به پایان رسیده، ادامه دارد."],[165,"ساقیا لطف نمودی قدحت پر می باد","که به تدبیر تو تشویش خمار آخر شد","ای ساقی، لطف کردی و نوشیدنی‌ات را پر کردی؛ امیدوارم که باده‌ات خوش باشد، زیرا با تدبیر تو، نگرانی و醉یدگی پایان یافت."],[165,"در شمار ار چه نیاورد کسی حافظ را","شکر کان محنت بی‌حدّ و شمار آخر شد","هر چند کسی حافظ را در فهرست شاعران مهم ذکر نکرده است، اما من شکرگزاری می‌کنم که این درد و رنج بی‌پایان به پایان رسید."],[166,"ستاره‌ای بدرخشید و ماه مجلس شد","دل رمیده ما را رفیق و مونس شد","ستاره‌ای در آسمان پیدا گشت که از بس زیباست ماه مجلس شد و بر صدر نشست و در دل و جان ما نشست."],[166,"نگار من که به مکتب نرفت و خط ننوشت","به غمزه مسأله‌آموز صد مدرّس شد","یار و بت زیبای من که به مکتب نرفت و چیزی ننوشت با یک غمزه هزار درس به‌من آموخت و استاد صد مدرّس و استاد شد."],[166,"به بوی او دل بیمار عاشقان چو صبا","فدای عارض نسرین و چشم نرگس شد","همچون باد صبا که عاشق و فدای روی زیبای نسرین و چشم مست نرگس می‌شود، دل بیمار و عاشق من نیز عاشق روی و چشم او گشت."],[166,"به صدر مصطبه‌ام می‌نشاند اکنون دوست","گدای شهر نگه کن که میر مجلس شد","اکنون یار من، مرا در صدر مجلس طرب و می‌خواری می‌نشاند؛ بخت نیک مرا بنگر که چگونه گدای شهر، سرور مجلس شد."],[166,"خیال آب خضر بست و جام اسکندر","به جرعه‌نوشی سلطان ابوالفوارس شد","قصد نوشیدن از چشمه حیات و جام اسکندر کرد تا به جرعه‌نوشی سلطان ابوالفوارس رسید."],[166,"طرب‌سرای محبت کنون شود معمور","که طاق ابروی یار منش مهندس شد","باغ شادی و خانه نشاط عشق، آباد خواهد شد زیرا اکنون ابروی یار من مهندس طاق اوست."],[166,"لب از ترشّح می پاک کن برای خدا","که خاطرم به هزاران گنه موسوس شد","برای رضای خدا، لب‌های خود را از می پاک کن زیرا خاطر من را به هزاران گناه، وسوسه می‌کند."],[166,"کرشمه تو شرابی به عاشقان پیمود","که علم بی‌خبر افتاد و عقل بی‌حس شد","یک کرشمه و غمزه تو شراب و باده‌ای به عاشقان نوشاند که دانایی از یاد رفت و عقل‌، بی‌خود گشت."],[166,"چو زر عزیز وجود است نظم من، آری","قبول دولتیان کیمیای این مس شد","نظم و شعر من همچون زر و جواهر ارزشمند است؛ زیرا نظر قبول نیک‌بختان بدان افتاد و همچون کیمیا این‌مس را به زر کرد."],[166,"ز راه میکده یاران عنان بگردانید","چرا که حافظ از این راه رفت و مفلس شد","دوستان، از رفتن به میکده بپرهیزید، زیرا حافظ بدانجا رفت و تنگدست و بی‌پول شد."],[167,"گداخت جان که شود کار دل تمام و نشد","بسوختیم در این آرزوی خام و نشد","جان گداخت که شاید مشکل دل حل شود، ولی نشد. در همین آرزوی خام سوختم، که نشد. [در لغتنامه دهخدا، «کار» به معنی «مسئله» یا «مشکل» هم آمده است]"],[167,"به لابه گفت شبی میر مجلس تو شوم","شدم به رغبت خویشش کمین غلام و نشد","به لابه گفت: \"شبی میر مجلس تو می‌شوم\". در پی خواسته‌اش، کمترین غلامش شدم، ولی چنان نشد."],[167,"پیام داد که خواهم نشست با رندان","بشد به رندی و دردی کشیم نام و نشد","بمن گفت که با شراب‌خواران و افراد لاابالی همنشین خواهم شد به هوای راه یافتن در دل او چه بسیاری مرا لاابالی و شراب‌خوار میخوانند اما باز هم این امر اثری در دل او نداشت"],[167,"رواست در بر اگر می‌تپد کبوتر دل","که دید در ره خود تاب و پیچ دام و نشد","اگر کبوتر دلم شوق پرواز دارد و می‌خواهد که پرواز را دوباره در آسمان عشق تو پرواز کند شایسته است زیرا که در راه خود نشانی از تاب زلفت تو را دید و ندانست دام اوست"],[167,"بدان هوس که به مستی ببوسم آن لب لعل","چه خون که در دلم افتاد همچو جام و نشد","در آرزوی بوسیدنش در مستی و بی‌خودی خون در دل من( مانند شراب در جام باده) افتاد اما این خواسته هم برآورده نشد"],[167,"به کوی عشق منه بی دلیل راه، قدم","که من به خویش نمودم صد اهتمام و نشد","راه عشق را کاروان‌سالار و راهنماییست که بدون آن‌ها نمی‌توان این راه را پیمود چون من بسیار تلاش کردم که خود با درایت خود این راه را طی کنم ولیکن به مقصد نرسیدم"],[167,"فغان که در طلب گنج نامه مقصود","شدم خراب جهانی ز غم تمام و نشد","فریاد که در یافتن راه وصال به معشوق در همه عالم از غم بد نام شدم و هیچ راه نیافتم"],[167,"دریغ و درد که در جست و جوی گنج حضور","بسی شدم به گدایی بر کرام و نشد","افسوس که در جست‌وجوی وصال معشوق خود بسی گدایی و طلب از اهالی کرامت و صاحبان معرفت کردم اما همچنان وصلی اتفاق نیفتاد"],[167,"هزار حیله برانگیخت حافظ از سر فکر","در آن هوس که شود آن نگار رام و نشد","حافظ از سر ناچاری، هزار ترفند اندیشید، به آن امید که یار کنار بیاید؛ و نشد. [به استناد لغتنامه دهخدا، واژه «فکر» (ترجیحا با تلفظ fakr) به معنی «نیاز» نیز می‌باشد. از اینرو، «از سر فکر»، به معنی «از سر ناچاری» است.]"],[168,"یاری اندر کس نمی‌بینیم، یاران را چه شد؟","دوستی کی آخر آمد؟ دوست‌دار‌ان را چه شد؟","حافظ می‌گوید دیگر در هیچ‌کس نشانی از یاری نمی‌بیند. گویی اصل همراهی از میان رفته است. او می‌پرسد دوستی از چه زمانی به پایان رسید. این پرسش ناظر به یک تغییر تدریجی است، نه حادثه‌ای ناگهانی. شاعر وضعیت اکنون را با گذشته مقایسه می‌کند. یاران در نگاه او کسانی بودند که در سختی کنار هم می‌ایستادند. حالا این حضور غایب است. پرسش او سرزنش مستقیم ندارد. بیشتر حیرت‌زده است. گویی نمی‌داند این دگرگونی چگونه رخ داده است. بیت، فضای کلی غزل را مشخص می‌کند. در تفسیر کنایی، یاری می‌تواند نماد تعهد انسانی باشد. دوست‌داران نماد کسانی‌اند که روزی ارزش رابطه را می‌دانستند. حافظ می‌گوید روابط به پوسته تبدیل شده‌اند. پیوندها هست، اما وفا نیست. این بیت نقدی است بر مناسبات سطحی. شاعر از نبود مسئولیت عاطفی شکایت دارد. پرسش او متوجه فرد خاصی نیست. متوجه یک فضاست. فضایی که در آن، دوستی مصرفی شده است. این نگاه اجتماعی حافظ است. نگاهی که هنوز هم قابل لمس است."],[168,"آب حیوان تیره‌گون شد، خضر فرخ‌پی کجاست؟","خون چکید از شاخ گل، باد بهار‌ان را چه شد؟","حافظ می‌گوید حتی آب حیات نیز تیره شده است. خضر که نماد راهبری و حیات بود، دیگر دیده نمی‌شود. گل که باید نشانه زندگی باشد، خون می‌چکاند. این تصویر، وارونگی طبیعت است. بهار که زمان شکوفایی است، غایب شده است. شاعر از به‌هم‌ریختگی نظم طبیعی سخن می‌گوید. جهان دیگر آن‌گونه که باید، کار نمی‌کند. تصاویر بیت تلخ و متضادند. زندگی به جای طراوت، زخم دارد. حافظ از فقدان هدایت می‌گوید. هدایت بیرونی و درونی. در تفسیر کنایی، آب حیات می‌تواند نماد امید باشد. تیره شدن آن یعنی ناامیدی فراگیر. خضر نماد رهبران اخلاقی یا فکری است. غیبت او یعنی بی‌راهنمایی جامعه. خون از شاخ گل یعنی رنج در دل زیبایی. حافظ می‌گوید حتی چیزهای خوب هم آسیب‌دیده‌اند. بهار نماد زمان مناسب اصلاح است. نبود آن یعنی تعویق درمان. این بیت تصویری از بحران عمیق است. بحرانی که به ظاهر و باطن نفوذ کرده است. شاعر به علائم توجه می‌دهد، نه فقط علت‌ها."],[168,"کس نمی‌گوید که «یاری داشت حقّ دوستی»","حق‌شناسان را چه حال افتاد؟ یاران را چه شد؟","کسی نمی‌گوید که دوست هم حق دوستی داشت. بر سر حق‌شناسان چه آمد؟ برای دوستان چه رخ داد؟"],[168,"لعلی از کان مروّت برنیامد سال‌هاست","تابش خورشید و سعی باد و باران را چه شد؟","حافظ می‌گوید سال‌هاست از معدن مروت، گوهری بیرون نیامده است. یعنی جوانمردی دیگر ثمر نمی‌دهد. او می‌پرسد خورشید و باد و باران چه شدند. این‌ها عوامل طبیعی رویش‌اند. اگر گوهر نمی‌روید، یا زمین مرده است یا عوامل غایب‌اند. شاعر به توقف فضیلت اشاره می‌کند. فضیلتی که نیاز به پرورش دارد. بیت لحنی تحلیلی دارد. حافظ دنبال ریشه‌هاست. چرا مروت خشکیده است. این پرسش اجتماعی عمیق است. در تفسیر کنایی، لعل نماد رفتار بزرگوارانه است. کان مروت جامعه است. خورشید و باران نماد آموزش، الگو و شرایط سالم‌اند. حافظ می‌گوید وقتی این‌ها نباشند، فضیلت زاده نمی‌شود. این بیت نقد ساختارهاست، نه افراد. شاعر می‌گوید نباید فقط از نبود اخلاق شکایت کرد. باید دید چه چیزی آن را پرورش می‌دهد. این نگاه سیستماتیک حافظ است. او فقط ناله نمی‌کند. به چرایی فکر می‌کند. همین ویژگی شعر را زنده نگه می‌دارد."],[168,"شهر یاران بود و خاک مهر‌بانان این دیار","مهربانی کی سر آمد؟ شهر یار‌ان را چه شد؟","این دیار، شهر یاران و سرزمین مهربانان بود. مهربانی، کی به پایان رسید؟ چه بر سر شهر یاران آمد؟"],[168,"گوی توفیق و کرامت، در میان افکنده‌اند","کس به میدان در نمی‌آید، سوار‌ان را چه شد؟","حافظ می‌گوید میدان موفقیت و بزرگواری آماده است. گوی در وسط میدان افتاده است. اما هیچ‌کس وارد میدان نمی‌شود. او می‌پرسد سواران کجا رفته‌اند. سواران کسانی بودند که جرأت پیش‌قدم شدن داشتند. اکنون میدان خالی است. این بیت تصویر رکود اراده را نشان می‌دهد. فرصت هست، اما همت نیست. شاعر غیبت جسارت را فریاد می‌زند. حافظ از نبود پیشگامان می‌نالد. کسانی که مسئولیت بپذیرند. این بیت لحنی انتقادی اما اندوهناک دارد. در تفسیر کنایی، گوی توفیق می‌تواند فرصت‌های اجتماعی یا اخلاقی باشد. میدان آماده است، اما داوطلبی نیست. سواران نماد انسان‌های شجاع و مسئول‌اند. حافظ می‌گوید جامعه از پیشگام خالی شده است. همه منتظرند، اما کسی آغاز نمی‌کند. این بیت نقد محافظه‌کاری است. محافظه‌کاری‌ای که فرصت‌ها را می‌سوزاند. شاعر نشان می‌دهد که نبود عمل، به اندازه نبود امکان خطرناک است. این پرسش هنوز هم تازه است. چه شد که کسی پیش نمی‌رود. حافظ این خلأ را برجسته می‌کند."],[168,"صدهزاران گل شکفت و بانگ مرغی برنخاست","عندلیبان را چه پیش آمد؟ هزاران را چه شد؟","حافظ می‌گوید هزاران گل شکوفا شدند. اما هیچ آواز پرنده‌ای شنیده نشد. این سکوت غیرطبیعی است. گل بدون آواز ناقص است. شاعر می‌پرسد بلبلان چه شدند. هزاران نماد آواز و شور است. این بیت از خاموشی اهل ذوق سخن می‌گوید. زیبایی هست، اما واکنش نیست. طبیعت به کمال نرسیده است. حافظ سکوت را نشانه بحران می‌داند. وقتی پاسخ به زیبایی خاموش شود، چیزی از کار افتاده است. این تصویر بسیار تأثیرگذار است. در تفسیر کنایی، گل نماد فرصت یا زیبایی است. بلبل نماد هنرمند یا انسان حساس است. حافظ می‌گوید زیبایی عرضه شده، اما اهل ذوق خاموش‌اند. این خاموشی می‌تواند از ترس یا بی‌انگیزگی باشد. شاعر از مرگ واکنش انسانی می‌نالد. جامعه‌ای که زیبایی را می‌بیند، اما پاسخ نمی‌دهد. این بیت نقد بی‌تفاوتی فرهنگی است. حافظ از نبود صدا شکایت دارد. صداهایی که باید فضا را زنده کنند. سکوت در اینجا، فقدان حیات است."],[168,"زهره سازی خوش نمی‌سازد، مگر عود‌ش بسوخت؟","کس ندارد ذوق مستی، می‌گسار‌ان را چه شد؟","حافظ می‌گوید زهره دیگر نوای خوش نمی‌نوازد. شاید سازش سوخته است. سپس می‌پرسد چرا هیچ‌کس ذوق مستی ندارد. می‌گساران کجا رفته‌اند. این بیت از خاموشی شادی سخن می‌گوید. موسیقی و مستی هر دو نماد طرب‌اند. وقتی این‌ها خاموش شوند، فضا سرد می‌شود. شاعر به دلایل احتمالی اشاره می‌کند. شاید ابزار از کار افتاده است. شاید ذوق از میان رفته است. حافظ از نابودی شور می‌نالد. شوری که جان مجلس بود. در تفسیر کنایی، زهره می‌تواند نماد هنرمند باشد. عود ابزار بیان است. سوختن آن یعنی محدودیت یا سرکوب. می‌گساران نماد کسانی‌اند که شجاعت شادی دارند. حافظ می‌گوید این شجاعت از میان رفته است. جامعه دیگر جرأت طرب ندارد. این بیت نقد فضای خفقان‌آور است. فضایی که شادی را خاموش می‌کند. شاعر به پیامدهای آن اشاره می‌کند. وقتی ذوق نباشد، زندگی تهی می‌شود. این پرسش، پرسش از علت افسردگی جمعی است."],[168,"حافظ اسرار الهی کس نمی‌داند، خموش","از که می‌پرسی که دور روزگار‌ان را چه شد؟","در بیت پایانی، حافظ خود را خطاب قرار می‌دهد. می‌گوید اسرار الهی را کسی نمی‌داند، پس خاموش باش. این پرسش‌ها پاسخی روشن ندارند. گردش روزگار تابع منطق ساده نیست. شاعر پس از همه پرسش‌ها، به سکوت می‌رسد. سکوتی آگاهانه، نه از سر ناتوانی. او می‌داند که برخی دگرگونی‌ها فراتر از فهم انسانی‌اند. این بیت پایان‌بندی حکیمانه دارد. حافظ از پرسش به پذیرش می‌رسد. نه پذیرش منفعل، بلکه پذیرش واقع‌بینانه. این سکوت، نتیجه اندیشیدن است. در تفسیر کنایی، اسرار الهی می‌تواند پیچیدگی‌های تاریخ و جامعه باشد. حافظ می‌گوید همه چیز توضیح‌پذیر نیست. پرسش بی‌پایان، آرامش نمی‌آورد. گاهی باید پذیرفت که پاسخ در دسترس نیست. این بیت دعوت به تعادل است. تعادل میان پرسش و رها کردن. شاعر پس از نقد، به سکوت می‌رسد. این سکوت پایان گفت‌وگو نیست. بلکه احترام به مرز فهم است. حافظ خودآگاهانه این مرز را می‌پذیرد."],[169,"زاهد خلوت‌نشین، دوش به میخانه شد","از سر پیمان برفت، با سر پیمانه شد","دیشب، زاهد گوشه نشین به میخانه رفت؛ پیمان شکست و جام می به‌ دست گرفت."],[169,"صوفی مجلس که دی، جام و قدح می‌شکست","باز به یک جرعه می، عاقل و فرزانه شد","صوفی ما که تا دیروز جام و قدح را می‌شکست، با نوشیدن یک جرعه می، دوباره خردمند و فرزانه شد."],[169,"شاهد عهد شباب، آمده بودش به خواب","باز به پیرانه‌سر‌، عاشق و دیوانه شد","معشوق دوره جوانی‌اش به‌ خواب او آمده‌بود؛ دوباره در پیری، عاشق و دیوانه شد."],[169,"مغ‌بچه‌ای می‌گذشت، راهزن دین و دل","در پی آن آشنا، از همه بیگانه شد","مغبچه‌ای زیبا می‌گذشت؛ و (زاهد خلوت‌نشین) با دیدن آن آشنا، همه را فراموش کرد."],[169,"آتش رخسار گل، خرمن بلبل بسوخت","چهره خندان شمع، آفت پروانه شد","تاب و گرمی رخسار گل، خرمن بلبل عاشق را سوخت؛ چهره خندان معشوق، آفت جان عاشق شد."],[169,"گریه شام و سحر، شکر که ضایع نگشت","قطره باران ما، گوهر یک‌دانه شد","شکر و سپاس که دعا و گریه‌های شام و سحر، نتیجه‌داد و قطره باران ما مروارید ناب گشت."],[169,"نرگس ساقی بخواند، آیت افسون‌گری","حلقه اوراد ما، مجلس افسانه شد","چشم ساقی، ورد افسونگری خواند و حلقه ذکرگویی ما تبدیل به مجلس آوازخوانی شد. [در لغتنامه دهخدا، «افسانه» به معنی «ترانه» نیز آمده است]"],[169,"منزل حافظ کنون، بارگه پادشاست","دل بر دل‌دار رفت، جان بر جانانه شد","خانه حافظ‌ اکنون بارگاه پادشاه است [و عدلالت برقرار شد]؛ دل به دلدار رسید و جان به معشوق پیوست."],[170,"دوش از جناب آصف، پیک بشارت آمد","کز حضرت سلیمان، عشرت اشارت آمد","دیشب پیام مژده‌ای از جناب آصف رسید که حضرت سلیمان فرمان کامرانی صادر کرده است. [منظور حافظ از آصف (وزیر سلیمان) و سلیمان به ترتیب عبارت است از خواجه قوام‌الدین صاحب عیار (وزیر شاه شجاع) و شاه شجاع.]"],[170,"خاک وجود ما را، از آب دیده گل کن","ویران‌سرای دل را، گاه عمارت آمد","با اشک‌، از خاک وجود ما گل درست کن؛ (زیرا) زمان آبادنی خانه ویران دل فرا رسیده است. [به یاد داشته باشیم که تا همین 60-50 سال گذشته از گل و کاهگل برای ساختن خانه استفاده می‌شد.]"],[170,"این شرح بی‌نهایت، کز زلف یار گفتند","حرفی‌ست از هزاران، کاندر عبارت آمد","این شرح بی‌پایان که در باره زلف یار گفتند، تنها یکی از هزاران حرفی است که به زبان آمد."],[170,"عیبم بپوش زنهار، ای خرقه می‌آلود","کآن پاک پاک‌دامن، بهر زیارت آمد","زنهار ای خرقه آلوده به می، عیبم را بپوشان؛ که شخصی کاملا پاکدامن برای دیدار آمده است. [به استناد لغتنامه دهخدا (ستون اول، صفحه 5366، چاپ انتشارات دانشگاه تهران، سال 1377)، «پاک» به معنی «کاملا» یا «تماما» می‌باشد. بررسی اسناد نشان می‌دهد که مفهوم «پاک ویران» (به معنی «کاملا ویران») از سوی فردوسی 7 بار و از سوی ملک‌الشعرا بهار 1 بار به کار رفته است. گذشته از آن، «پاک شوید» (به معنی «کاملا بشوید») در اشعار شیخ محمود شبستری، شاه نعمت‌الله ولی و علیشیر نوایی به کار رفته است. مفهوم «پاک شست» نیز تا کنون 11 بار در متون دیده شده است. درخور یادآوری است که واژه «پاک» هم اکنون نیز در سراسر ایران به همان معنی «کاملا» به کار می‌رود (نمونه: «پاک دیوانه شده است!»).]"],[170,"امروز جای هر کس، پیدا شود ز خوبان","کآن ماه مجلس‌افروز، اندر صدارت آمد","امروز، با حضور خوبان، جای هر یک از آنان مشخص می‌شود، چراکه آن ماه زیبا و دل‌بر که مجلس را روشن می‌کند، در مقام رهبری و ریاست آمده است."],[170,"بر تخت جم که تاجش، معراج آسمان است","همّت نگر که موری، با آن حقارت آمد","بر تخت جمشید، که تاج آن به مانندی آسمان بلند است، توجه کن که چه موجود کوچکی مثل مور، با آن اندازه ناچیزش، به آنجا رسیده است."],[170,"از چشم شوخش ای دل! ایمان خود نگه دار","کآن جادوی کمانکش، بر عزم غارت آمد","ای دل، از نگاه زیبای او (که به تو چشم می‌زند) ایمان و اعتقاد خود را حفظ کن، زیرا آن جادوی کمان او، برای تصرف و غارت دل‌های عاشق آمده است."],[170,"آلوده‌ای تو حافظ، فیضی ز شاه درخواه","کآن عنصر سماحت، بهر طهارت آمد","حافظ! تو آلوده‌ای، از شاه شجاع لطفی بخواه. زیرا این عنصر بخشندگی، برای پاکی آمده است."],[170,"دریاست مجلس او، دریاب وقت و در یاب","هان ای زیان‌رسیده وقت تجارت آمد","محفل او دریاست؛ زمان را غنیمت بشمار و از آن بهره برگیر . ای زیان دیده! زمان بده-بستان فرا رسیده است."],[171,"عشق تو نهال حیرت آمد","وصل تو کمال حیرت آمد","عشق تو باعث حیرت شد، و وصال تو نیز به اوج حیرت من انجامید."],[171,"بس غرقه حال وصل کآخر","هم بر سر حال حیرت آمد","من در حال وصال تو چنان غرق شده‌ام که در نهایت، به حالتی از حیرت رسیده‌ام."],[171,"یک دل بنما که در ره او","بر چهره نه خال حیرت آمد","دل کسی را نشان بده که در راه عشق، بر چهره‌اش نشانه‌ای از حیرت دیده می‌شود."],[171,"نه وصل بماند و نه واصل","آنجا که خیال حیرت آمد","نه وصال و پیوستگی باقی می‌ماند و نه کسی که به آنجا می‌رسد، زمانی که اندیشه‌ی حیرت و شگفتی حاضر باشد."],[171,"از هر طرفی که گوش کردم","آواز سؤال حیرت آمد","هر جا که گوش دادم، صدای پرسش و تعجب به گوشم رسید."],[171,"شد منهزم از کمال عزّت","آن را که جلال حیرت آمد","کسی که به کمال عزت و شرافت دست یافته باشد، متحیر و ناباور می‌شود وقتی جلال و عظمت حیرت به او روی آورد."],[171,"سر تا قدم وجود حافظ","در عشق، نهال حیرت آمد","وجود حافظ از سر تا پا در عشق، همچون درختی است که مملو از شگفتی و حیرت شده است."],[172,"در نمازم خم ابروی تو با یاد آمد","حالتی رفت که محراب به فریاد آمد","سر نماز به‌یاد خم ابروی تو افتادم. چنان به وجد آمدم که صدا در محراب پیچید. [به استناد لغتنامه دهخدا، «حالت» از اصطلاح‌های صوفیان است به معنی «ذوق، وجد، شور».]"],[172,"از من اکنون طمع صبر و دل و هوش مدار","کان تحمّل که تو دیدی همه بر باد آمد","اکنون از من توقع شکیبایی، خرد و هوش نداشته‌ باش. زیرا همه آن بردباری که تو (پیش از این) دیدی، بر باد رفت!"],[172,"باده صافی شد و مرغان چمن مست شدند","موسم عاشقی و کار به بنیاد آمد","باده، رسیده و صاف گشته و فصل نغمه‌سرایی بلبلان فرارسیده‌است؛ فصل عاشقی‌ و کار درست و حسابی رسید."],[172,"بوی بهبود ز اوضاع جهان می‌شنوم","شادی آورد گل و باد صبا شاد آمد","از آنچه که در گوشه و کنار می‌گذرد، بوی بهبود می‌شنوم؛ گل، با خود شادی آورد و باد شادمان گشت. [1-اصطلاح زیبای «شنیدن بو» در ادبیات سراسر ایران فرهنگی ثبت شده و هم اکنون نیز، به طور گسترده به کار می‌رود. 2-به استناد لغتنامه دهخدا، «آمدن» به معنی «شدن» و «گردیدن» نیز می‌باشد.]"],[172,"ای عروس هنر از بخت شکایت منما","حجله حسن بیارای که داماد آمد","ای عروس هنر! از بخت گلایه نکن. حجله زیبایی را بیارا؛ زیرا که داماد آمد. [در اینجا، «عروس هنر» و «داماد» به ترتیب یعنی «شعر» و «خریدار شعر»]"],[172,"دلفریبان نباتی همه زیور بستند","دلبر ماست که با حسن خداداد آمد","تمام مهرویان شیرین (یا گل‌های بوستان) همگی زیور و زینت بسته‌اند؛ تنها دلبر و یار من است که زیبایی و حسن او خداداد است."],[172,"زیر بارند درختان که تعلّق دارند","ای خوشا سرو که از بار غم آزاد آمد","درختانی که میوه و تعلّقی دارند همه در زحمت هستند؛ سرو را می‌پسندم که از بار غم آزاد است."],[172,"مطرب از گفته حافظ غزلی نغز بخوان","تا بگویم که ز عهد طربم یاد آمد","ای مطرب! غزلی نو و تازه از حافظ بخوان؛ تا مرا به‌یاد نشاط و روز خوش جوانی بیندازد."],[173,"مژده ای دل که دگر باد صبا بازآمد","هدهد خوش‌خبر از طرف سبا بازآمد","ای دل مژده بده که که سرانجام باد صبا برگشت؛ و پوپک پیام‌آور دیار سبا از راه رسید. [در اینجا–و به استناد لغتنامه دهخدا–«دگر» یعنی سرانجام]"],[173,"برکش ای مرغ سحر نغمه داوودی باز","که سلیمان گل از باد هوا بازآمد","ای بلبل، دوباره نغمه داوودی سر بده، زیرا گل زیبا همراه باد باز آمده است. [نغمه داوودی، آوازی بوده که داوود در ستایش خدا می‌خوانده است. احتمالا منظور از «سلیمان گل»، گل بسیار زیبای «سوسن» باشد. به این دلیل که حافظ در همین غزل آشکارا از آن نام می‌برد و نیز اینکه گفته می‌شود داوود در نامه‌ای عاشقانه‌، از «گل سوسن» یاد کرده است.]"],[173,"عارفی کو که کند فهم زبان سوسن","تا بپرسد که چرا رفت و چرا بازآمد","عارف و دانای پاکیزه‌ای کجاست تا زبان گل سوسن را بفهمد و از او بپرسد که چرا ما را ترک کرد و چرا بازآمد؟"],[173,"مردمی کرد و کرم لطف خداداد به من","کـ‌آن بت ماه‌رخ از راه وفا بازآمد","یار زیبا و ماهرخ من، بسیار در حق من نیکویی و کرم کرد که با من آشتی کرد و مهربان شد."],[173,"لاله بوی می نوشین بشنید از دم صبح","داغ‌دل بود، به امّید دوا بازآمد","لاله، بوی باده شیرین از نسیم صبح شنید؛ داغ بر دل داشت، برای درمان آمد. [به استناد لغتنامه دهخدا، «نوشین» یعنی «شیرین»]"],[173,"چشم من در ره این قافله راه بماند","تا به گوش دلم آواز درا بازآمد","چشم به راه کاروانی بودم که قرار بود برسد. تا آنکه به گوش دل، صدای زنگ شتر را شنیدم."],[173,"گرچه حافظ در رنجش زد و پیمان بشکست","لطف او بین که به لطف از در ما بازآمد","اگرچه حافظ رنجیده‌خاطر گشت و قول خود را شکست؛ لطف یار او را ببین که با مهربانی و لطف به‌نزد او بازگشت."],[174,"صبا به تهنیت پیر می‌فروش آمد","که موسم طرب و عیش و ناز و نوش آمد","باد صبا به پیر می‌فروش مژده داد که زمان شادی، خوشی و کامرانی کامل فرارسیده است."],[174,"هوا مسیح‌نفس گشت و باد نافه‌گشای","درخت سبز شد و مرغ در خروش آمد","هوا چون دم مسیح (زندگی بخش) شد و باد مشک پراکند. درخت جوانه زد و پرنده، آواز سر داد."],[174,"تنور لاله چنان برفروخت باد بهار","که غنچه غرق عرق گشت و گل به جوش آمد","باد بهاری چنان در تنور لاله (آتش عشق) دمید که غنچه‌ غرق عرق شد و گل‌، ناآرام گردید."],[174,"به گوش هوش نیوش از من و به عشرت کوش","که این سخن سحر از هاتفم به گوش آمد","سخن مرا با گوش جان بشنو و به کامرانی بپرداز؛ زیرا این سخن را بامدادان از پیام آوری شنیده‌ام که دیده نمی‌شود."],[174,"ز فکر تفرقه بازآی تا شوی مجموع","به حکم آنکه چو شد اهرمن سروش آمد","از اندیشه تفرقه بیرون بیا تا مجموع شوی؛ زیرا پس از رفتن اهرمن، سروش می‌آید. [تفرقه و جمع همیشه در کنار هم هستند! به استناد لغتنامه دهخدا (نقل از عطار نیشابوری)، «جمع» عین حق است و «تفرقه» صفت حق.]"],[174,"ز مرغ صبح ندانم که سوسن آزاد","چه گوش کرد که با ده زبان خموش آمد","نمیدانم سوسن آزاد از مرغ صبح چه شنید که با داشتن ده زبان، خاموشی گزید."],[174,"چه جای صحبت نامحرم است مجلس انس؟","سر پیاله بپوشان که خرقه‌پوش آمد","حضور افرادی که در جمع ما نامحرم هستند، چه ضرورتی دارد؟ بهتر است سر پیاله را بپوشانی چون کسی که لباس عارفان را بر تن دارد و ظاهرش نشان‌دهنده زهد و پاکدامنی است، به این مجلس آمده."],[174,"ز خانقاه به میخانه می‌رود حافظ","مگر ز مستی زهد ریا به هوش آمد","حافظ از خانقاه به میخانه می‌رود؛ گویا مستی زهد ریایی از سر او پریده است."],[175,"سحرم دولت بیدار به بالین آمد","گفت برخیز که آن خسرو شیرین آمد","در صبح گاهی، سعادت و نیک بختی به من روی آورد و گفت: بلند شو، چون آن دلبر و یار محبوب و دلنشین نزدیک شده است."],[175,"قدحی درکش و سرخوش به تماشا بخرام","تا ببینی که نگارت به چه آیین آمد","جامی ببر و شاد باش و براستی ببین که معشوقت با چه زیبایی و طرز خاصی وارد شده است."],[175,"مژدگانی بده ای خلوتی نافه‌گشای","که ز صحرای ختن آهوی مشکین آمد","ای کسی که در خلوت هستی و رازهای عشق را فاش می‌کنی، بشارت بده که از بیابان ختن، آهویی خوشبو و معطر آمده است."],[175,"گریه آبی به رخ سوختگان بازآورد","ناله فریادرس عاشق مسکین آمد","اشک و گریه‌ای مثل آب، به چهره‌ی سوختگان برمی‌گرداند و صدای ناله‌ی عشق، به فریاد عاشق بی‌نوا پاسخ می‌دهد."],[175,"مرغ دل باز هوادار کمان‌ابروییست","ای کبوتر نگران باش که شاهین آمد","دل من همچنان به کمان‌ابروهایی که زیبایی دارند، علاقه‌مند است. ای کبوتر، محتاط باش که شاهینی (که نماد خطر و شکارچی است) نزدیک شده و تهدیدی برای تو به حساب می‌آید."],[175,"ساقیا می بده و غم مخور از دشمن و دوست","که به کام دل ما آن بشد و این آمد","ای ساقی، شراب بده و نگران دشمن و دوست نباش. زیرا در دل ما، یا دوستی خوشایند است و یا دشمنی ناخوشایند، که همواره یکی از آن‌ها وجود دارد."],[175,"رسم بدعهدی ایّام چو دید ابر بهار","گریه‌اش بر سمن و سنبل و نسرین آمد","زمانه به ما اذیت می‌رساند و بدعهدی می‌کند، به همین خاطر وقتی ابر بهاری را می‌بیند، برای گل‌های خوشبو و زیبا مثل سمن، سنبل و نسرین اشک می‌ریزد."],[175,"چون صبا گفته حافظ بشنید از بلبل","عنبرافشان به تماشای ریاحین آمد","چون نسیم، سخنان حافظ را از بلبل شنید، به تماشای گل‌ها و گیاهان عطرآگین رفت."],[176,"نه هر که چهره برافروخت دلبری داند","نه هر که آینه سازد سکندری داند","هر کس که چهره ی خود را برافروخته و گلگون سازد شیوه ی دلربایی و دلبری را بلد نیست و هرکه آینه بسازد اسکندر نیست و شیوه او (پادشاهی عالم‌گستر) را بلد نیست! / اشاره به ، آینه سترگ مشهوری دارد که اسکندر ساخت و بخشی از ساختمان «فانوس دریایی» معروف اوست"],[176,"نه هر که طرف کله کج نهاد و تند نشست","کلاه‌داری و آیین سروری داند","هر کسی که کلاهش را به شکل پادشاهان بر روی سرش بگذارد و تندی کرده و دیگران را امر و نهی کند، لزوما نمی‌تواند از عهده مسئولیت‌ها و ویژگی‌های رهبری و بزرگ‌منشی برآید."],[176,"تو بندگی چو گدایان به شرط مزد مکن","که دوست، خود روش بنده‌پروری داند","همچون مزدوران و به خاطر مزد و پاداش عمل نکن، زیرا دوست (خدا) خود روش و شیوه‌ ی جبران تلاش شما را با محبت و رحمت نسبت به بندگانش می داند. و حواسش به همه چیز هست."],[176,"غلام همّت آن رند عافیت‌سوزم","که در گداصفتی کیمیاگری داند","من بنده‌ی همت و تلاش آن زیرکی هستم که در حالتی ظاهری شبیه به فقر و ناداری، توانایی تبدیل اوضاع را به بهترین شکل دارد."],[176,"وفا و عهد نکو باشد ار بیاموزی","وگر نه هر که تو بینی ستمگری داند","اگر وفاداری و عمل به عهد را یاد بگیری، نیکو و پسندیده هست؛ وگرنه هر کسی را که ببینی، راه و رسم ظلم و ستمگری را می‌شناسد."],[176,"بباختم دل دیوانه و ندانستم","که آدمی‌بچه‌ای، شیوه پری داند","دل سرگشته ی خود را باختم و نمی دانستم که کسی چگونه می‌تواند به شیوه‌ای چنین جذاب و فریبنده رفتار کنند."],[176,"هزار نکته باریک‌تر ز مو این جاست","نه هر که سر بتراشد قلندری داند","در زندگی و ظرایف و نکات بسیاری وجود دارد که تنها عده کمی از آن‌ها آگاهند. و هر کسی با تظاهر به دانایی توان فهم آن نکات موضوعات را ندارند"],[176,"مدار نقطه بینش ز خال توست مرا","که قدر گوهر یک‌دانه جوهری داند","توان دید و درک من به خاطر عنایت وجود توست، چرا که فقط یک گوهرشناس می‌تواند ارزش گوهر را بشناسد. و به لطف تو می توان به اسرار و بینش صحیح پی برد."],[176,"به قدّ و چهره هر آن کس که شاه خوبان شد","جهان بگیرد اگر دادگستری داند","اگر کسی شرایط آن را داشت که به مقامی برسد تنها به شرط آنکه فهم و درک صحیح و رفتار درستی داشته باشد می تواند رشد کند به پادشاهی برسد"],[176,"ز شعر دلکش حافظ کسی بود آگاه","که لطف طبع و سخن گفتن دری داند","تنها کسی می‌تواند از لطف و ظرافت های شعرهای حافظ آگاه شود که که توانایی درک لطافت و زبان پارسی دری را داشته باشد و بداند."],[177,"هر که شد محرم دل در حرم یار بماند","وان که این کار ندانست در انکار بماند","هر کس رازدار و از آشنایان دل شد در حرم یار (معشوق) باقی خواهد ماند، اما آنکس که به این مرحله نرسید و نتوانست آن را درک کند، در مقام انکار باقی خواهد ماند و تمام این مراحل را انکار خواهد کرد"],[177,"اگر از پرده برون شد دل من عیب مکن","شکر ایزد که نه در پرده پندار بماند","اگر دل من ازمسیر خود خارج گشت و رسوا شد بر او عیب و ایرادی نگیر و او را سرزنش نکن، خدا را شکر که دل من در حجاب گمان و شک باقی نماند و از آن خارج شد"],[177,"صوفیان واستدند از گرو می همه رخت","دلق ما بود که در خانه خمّار بماند","صوفیان همه رخت و لباس خود را از گرو باده درآوردند و تنها خرقه ی من است که هنوز در رهن باده و در میخانه باقی مانده است"],[177,"محتسب شیخ شد و فسق خود از یاد ببرد","قصّه ماست که در هر سر بازار بماند","محتسب به یکباره زاهد شد و تمام فسق و فجور خود را فراموش کرد، و تنها داستان عشق ماست که هنوز بر سر هر بازار گفته می شود و نقل محافل بازار است(محتسب: مأمور اجرای احکام شرعی، که همواره در اشعار حافظ بار معنایی منفی دارد.)"],[177,"هر می لعل کز آن دست بلورین ستدیم","آب حسرت شد و در چشم گهربار بماند","هر جام شراب سرخ رنگی که از دست سپید و زیبا و بلورین یار گرفتیم تبدیل به اشک خونین شد و در چشم اشکبار باقی ماند"],[177,"جز دل من کز ازل تا به ابد عاشق رفت","جاودان کس نشنیدیم که در کار بماند","تنها دل خود را می شناسم که از روز ابتدای آفرینش تا ابد عاشق باقی ماند وگرنه کس دیگری را نمیشناسم که در عشق و عاشقی پایدار و ثابت قدم مانده باشد"],[177,"گشت بیمار که چون چشم تو گردد نرگس","شیوه تو نشدش حاصل و بیمار بماند","گل نرگس نیز بیمار گشت تا شاید بتواند مانند چشم مست تو در عین خماری، زیبا و دلنشین شود، اما نه تنها ناز و کرشمه ی چشم تو را بدست نیاورد بلکه بیمار و معیوب باقی ماند"],[177,"از صدای سخن عشق ندیدم خوشتر","یادگاری که در این گنبد دوّار بماند","هیچ چیزی خوشتر و دلنشین تر از بازتاب سخن عشق در این عالم وجود ندارد و تنها یادگاری است که در این آسمان گردنده باقی خواهد ماند(نکته: چنانچه به سمت گنبدی فریاد زده شود، بازتاب و پژواک آن را خواهیم شنید، حافظ نیز با دیدی هنری، از این پدیده سود جسته است و ماندگاری عشق را درعالم نشان داده است)"],[177,"داشتم دلقی و صد عیب مرا می‌پوشید","خرقه رهن می و مطرب شد و زنّار بماند","تا اکنون خرقه ای داشتم که به واسطه ی پوشیدن آن عیب و نشان کفر خود را پنهان می کردم اما حال که خرقه خود را برای گرفتن شراب و گوش دادن به صدای مطرب در گرو میخانه گذاشته ام تمام عیوب و نشان کفر من آشکار شده است"],[177,"بر جمال تو چنان صورت چین حیران شد","که حدیثش همه‌جا در در و دیوار بماند","صورت چین در برابر جمال و زیبایی تو چنان حیران شد که بر دیوار نقش بست و داستان آن در همه جا پیچید؛ و یا، صورتگر چین که همه را به شگفتی وا می داشت با دیدن چهره ی زیبای تو غرق در حیرت شد و خشک و مبهوت بر در و دیوار باقی ماند(صورت چین: صورتگر و نقاش چین؛ در ادبیات و فرهنگ گذشته ما مردمان چین به صورتگری و نقاشی مشهور بوده اند)"],[177,"به تماشاگه زلفش دل حافظ روزی","شد که بازآید و جاوید گرفتار بماند","دل حافظ روزی رفت که زیبایی زلف معشوق را ببیند و برگردد اما برای همیشه در آنجا گرفتار باقی ماند."],[178,"رسید مژده که ایّام غم نخواهد ماند","چنان نماند، چنین نیز هم نخواهد ماند","خبر خوشی رسید که دوران غم و اندوه پایدار نخواهد بود؛ همان‌طور که گذشته است، این وضعیت هم دوام نخواهد داشت."],[178,"من ار چه در نظر یار خاک‌سار شدم","رقیب نیز چنین محترم نخواهد ماند","هرچند من در نظر محبوب خود به شکل خاکی و بی‌ارزش جلوه کرده‌ام، اما رقیب من هم به این اندازه احترام و مقام نخواهد داشت و در نهایت به فراموشی سپرده خواهد شد."],[178,"چو پرده‌دار به شمشیر می‌زند همه را","کسی مقیم حریم حرم نخواهد ماند","وقتی که پرده‌دار (یا نگهبان) با شمشیر به همه حمله می‌کند، دیگر هیچ‌کس در حریم امن و مقدس نخواهد ماند."],[178,"چه جای شکر و شکایت ز نقش نیک و بد است؟","چو بر صحیفه هستی رقم نخواهد ماند","در این بیت، شاعر می‌گوید که جای شکایت و شکرگزاری در مورد خوبی‌ها و بدی‌ها وجود ندارد، زیرا همه چیز در زندگی، مانند نوشته‌ای روی کاغذ، دائمی نیست و در نهایت از بین خواهد رفت."],[178,"سرود مجلس جمشید گفته‌اند این بود","که «جام باده بیاور که جم نخواهد ماند»","در یک مجلس جشن و شادی که به یاد جمشید برپا شده، گفته می‌شود که باید شراب آورد، زیرا مانند شخصیت جمشید، که نماد قدرت و عظمت است، هیچ‌چیز دائمی نیست و روزگار به زودی برخواهد گشت."],[178,"غنیمتی شمر ای شمع وصل پروانه!","که این معامله تا صبح‌دم نخواهد ماند","ای شمع، لحظه‌های قربت و وصال را غنیمت بشمار، چون این فرصت و این حالت تا صبح فردا دوام نخواهد داشت."],[178,"توانگرا! دل درویش خود به دست آور","که مخزن زر و گنج درم نخواهد ماند","ای توانگر! قلب درویش را به دست بیاور، زیرا ثروت و مال دنیا ماندنی نیست و زود از بین می‌رود."],[178,"بدین رواق زبرجد نوشته‌اند به زر","که «جز نکویی اهل کرم نخواهد ماند»","در این رواق (صومعه یا مکان معنوی) که با زینت‌های گرانبها آراسته شده، به طلا نوشته‌اند که فقط نیکی و خوبی اهل کرم (بخشندگی) باقی می‌ماند و چیزی جز این نمی‌ماند."],[178,"ز مهربانی جانان طمع مبر حافظ","که نقش جور و نشان ستم نخواهد ماند","ای حافظ، به خاطر محبت و مهربانی محبوب (جانان) امید نداشته باش، چرا که آثار بی‌رحمی و نشانه‌های ظلم پایدار نخواهند ماند."],[179,"ای پسته تو خنده زده بر حدیث قند","مشتاقم از برای خدا یک شکر بخند","ای پسته، تو که با لبخندت بر داستان شیرینی قند اشاره کرده‌ای، من برای خداوند از تو خواهش می‌کنم که یک بار هم که شده بخندی."],[179,"طوبی ز قامت تو نیارد که دم زند","زین قصّه بگذرم که سخن می‌شود بلند","درخت طوبی، که سمبل بهشت است، از زیبایی و قامت تو نمی‌تواند چیزی بگوید و در این مورد سر حرفش را باز نمی‌کند. من هم از این موضوع می‌گذرم چون این گفتگو به درازا می‌کشد."],[179,"خواهی که برنخیزدت از دیده رود خون","دل در وفای صحبت رود کسان مبند","اگر می‌خواهی اشک‌هایم از چشمانم به خاطر غم دل برطرف شود، نباید از وفای دوستان و کسان بگذری و آن‌ها را فراموش کنی."],[179,"گر جلوه می‌نمایی و گر طعنه می‌زنی","ما نیستیم معتقد شیخ خودپسند","هرچقدر هم که زیبایی خود را نشان بدهی یا به ما کنایه بزنی، ما به اندیشه‌ی خودخواهانه‌ی شیخ (و رهبران متکبر) ایمان نداریم."],[179,"ز آشفتگی حال من آگاه کی شود؟","آن را که دل نگشت گرفتار این کمند","هیچ‌کس از حال آشفته من باخبر نمی‌شود، مگر آنکه دلش به دام عشق گرفتار شده باشد."],[179,"بازار شوق گرم شد آن سروقد کجاست؟","تا جان خود بر آتش رویش کنم سپند","جای آن معشوق لاغر و زیبا (سروقد) کجاست که بازار عشق و اشتیاق دوباره رونق گرفته است؟ من حاضر هستم جانم را در آتش زیبایی او فدای کنم."],[179,"جایی که یار ما به شکرخنده دم زند","ای پسته کیستی تو، خدا را به خود مخند","در جایی که محبوب ما با لبخند بازیگوشی می‌کند، ای پسته (به عنوان نماد جذابیت)، چرا به خود می‌خندی؟ خدا را فراموش نکن."],[179,"حافظ چو ترک غمزه ترکان نمی‌کنی","دانی کجاست جای تو؟ خوارزم یا خجند","حافظ می‌گوید تو که مانند ترک‌ها با چشمک و ناز خود دل‌ها را می‌بردی و ما را بی‌خبر رها کرده‌ای، آیا می‌دانی که در کجا باید باشی؟ آیا در خوارزم یا خجند (دو شهر معروف)؟"],[180,"بعد از این دست من و دامن آن سرو بلند","که به بالای چمان از بن و بیخم برکند","از این پس، من دیگر به آن سرو بلند (معشوق) دست نمی‌زنم و او نیز به من بی‌توجهی می‌کند که به خاطر زیبایی‌اش همیشه بر روی زمین قرار دارد و ریشه‌اش از زمین کنده شده است."],[180,"حاجت مطرب و می نیست تو برقع بگشا","که به رقص آوردم آتش رویت چو سپند","برای مست شدن و رقصیدن نیازی به مطرب و شراب نیست، کافیست تو روبنده‌ات را برداری، چون صورت تو آنقدر زیبا است که مانند آتشی که اسپند را به رقص می‌آورد، مرا به رقص می‌آورد."],[180,"هیچ رویی نشود آینه حجله بخت","مگر آن روی که مالند در آن سمّ سمند","هیچ چهره‌ای نمی‌تواند آینه خوشبختی را روشن کند، مگر آن چهره‌ای که در آن، اثر و نشانه‌ای از سمّ اسب خوشبختی وجود داشته باشد."],[180,"گفتم اسرار غمت هر چه بود گو می‌باش","صبر از این بیش ندارم چه کنم تا کی و چند؟","من به تو گفته‌ام که هر چه راجع به دلمشغولی‌ها و غم‌انت به من بگویی، تحمل می‌کنم، اما دیگر نمی‌توانم بیشتر از این صبر کنم؛ نمی‌دانم تا کی و چه مدت باید به این درد ادامه دهم."],[180,"مکش آن آهوی مشکین مرا ای صیّاد","شرم از آن چشم سیه دار و مبندش به کمند","ای صیاد، آهوی زیبا و معصوم مرا نکش. از آن چشمان سیاه شرم کن و او را به دام مگیر."],[180,"من خاکی که از این در نتوانم برخاست","از کجا بوسه زنم بر لب آن قصر بلند؟","من که موجودی خاکی و در محدودیت زندگی می‌کنم، نمی‌توانم از این مکان بلند شوم؛ پس از کجا می‌توانم برای آن قصر بلند بوسه بزنم؟"],[180,"بازمستان دل از آن گیسوی مشکین حافظ","زان که دیوانه همان به که بود اندر بند","حافظ می‌گوید که دل دوباره به سوی آن موهای خوشبو و زیبا بازگشته است، چرا که دیوانه بهتر است که در قید و بند عشق بماند تا این که از آن دور شود."],[181,"حسب حالی ننوشتی و شد ایّامی چند","محرمی کو که فرستم به تو پیغامی چند؟","با توجه به وضعیت فعلی خود، نمی‌توانم برایت چیزی بنویسم. حالا کسی هست که بتواند پیامی را به تو برساند؟"],[181,"ما بدان مقصد عالی نتوانیم رسید","هم مگر پیش نهد لطف شما گامی چند","ما که نمی‌توانیم به آن هدف بلند دست پیدا کنیم، مگر اینکه لطف شما چند گام به جلو (سمت ما) بردارد."],[181,"چون می از خم به سبو رفت و گل افکند نقاب","فرصت عیش نگه دار و بزن جامی چند","وقتی که شراب از خم به جام می‌ریزد و گل‌ها نقاب زیبایی می‌زنند، لحظه زندگی و خوشی را غنیمت بشمار و چند جام بنوش."],[181,"قند آمیخته با گل نه علاج دل ماست","بوسه‌ای چند برآمیز به دشنامی چند","شیرینی قند و زیبایی گل نمی‌تواند درد دل ما را درمان کند؛ پس بهتر است چند بوسه با هم درآمیزیم و به دنبال چند کلام تند و رکیک نیز برویم."],[181,"زاهد از کوچه رندان به سلامت بگذر","تا خرابت نکند صحبت بدنامی چند","رهبر مذهبی (زاهد) نباید از محله افرادی که در راه خدا نیستند (رندان) عبور کند، زیرا ممکن است صحبت با کسانی که بدنام هستند، او را به خطر بیندازد و باعث آسیب به روح او شود."],[181,"عیب می جمله چو گفتی، هنرش نیز بگو","نفی حکمت مکن از بهر دل عامی چند","اگر عیوب شراب را گفتی، هنرهای آن را نیز بگو. بر حکمت افراد عادی ایراد نگیری، چون آنها هم وجود دارند."],[181,"ای گدایان خرابات خدا یار شماست","چشم انعام مدارید ز انعامی چند","ای گدایان میخانه (خرابات) که به خدا پناه برده‌اید، بدانید که خداوند حامی و یار شماست. بنابراین، به نعمت‌های ظاهری و دنیا وابسته نباشید و امید به الطاف الهی داشته باشید."],[181,"پیر میخانه چه خوش گفت به دردی‌کش خویش","که مگو حال دل سوخته با خامی چند","پیر میخانه (مربی یا راهنمای معنوی) چه خوب به دوستداران شراب (دردی‌کش‌ها) گفت که حال دل سوخته‌ات را با کسی که هنوز به درد و رنج نرسیده (خام) به زبان نیاورید و بیان نکنید."],[181,"حافظ از شوق رخ مهر‌فروغ تو بسوخت","کامگارا نظری کن سوی ناکامی چند","حافظ از شوق چهره‌ی درخشان تو سوخته است، ای کامیاب! نگاهی به کسانی که ناکام مانده‌اند بکن."],[182,"دوش وقت سحر، از غصّه نجاتم دادند","واندر آن ظلمت شب، آب حیاتم دادند","دیشب در هنگام صبحدم از غصه آزادم کردند، و در آن تاریکی شب، آب زندگانی به‌من نوشاندند."],[182,"بی‌خود از شعشعه پرتو ذاتم کردند","باده از جام تجلّیّ صفاتم دادند","مرا از نور و پرتو «ذات» مست و بی‌خود کردند، مرا باده‌ای از جام و قدح «تجلّی صفات» دادند."],[182,"چه مبارک‌سحری بود و چه فرخنده‌شبی","آن شب قدر که این تازه‌براتم دادند","چه سحر فرخنده و بی‌نظیری بود، آن «شب قدر» که این مژده و هدیه نو را به‌من دادند."],[182,"بعد از این روی من و آینه وصف جمال","که در آن جا خبر از جلوه ذاتم دادند","از این پس، رخ من و آینه وصف جمال و زیبایی است؛ زیرا درآنجا خبر از «جلوه ذات» به‌من دادند."],[182,"من اگر کامروا گشتم و خوش‌دل چه عجب؟","مستحق بودم و این‌ها به زکاتم دادند","اگر من به‌آرزو رسیدم و شاد گشتم عجب نیست؛ زیرا مستحق و نیازمند بودم و این‌ها را به زکات به‌من دادند."],[182,"هاتف آن روز به من مژده این دولت داد","که بدان جور و جفا صبر و ثباتم دادند","هاتف و آواز غیب، آن‌روز به من مژده این پیروزی و نیکبختی را داد که در آن جور و سختی‌، به‌من صبر و ثبات داده‌بود."],[182,"این همه شهد و شکر کز سخنم می‌ریزد","اجر صبری‌ست کز آن شاخ نباتم دادند","این همه لطافت و زیبایی که در سخن و شعر من هست؛ اجر و پاداش صبری‌ست که‌ از آن شاخ‌نبات به‌من بخشیدند."],[182,"همّت حافظ و انفاس سحرخیزان بود","که ز بند غم ایّام نجاتم دادند","از بلند‌نظری و دعای حافظ و عابدان سحرخیز بود که از بند غم ایّام مرا نجات دادند."],[183,"دوش دیدم که ملائک در میخانه زدند","گل آدم بسرشتند و به پیمانه زدند","دیشب دیدم که فرشتگان به در شراب‌خانه آمدند و خاک آدم را برداشتند و در پیمانه ریختند."],[183,"ساکنان حرم ستر و عفاف ملکوت","با من راه‌نشین، باده مستانه زدند","ساکنان آسمان و مکان‌های مقدس، که ویژگی‌های پاکی و عفاف دارند، در میخانه با من که یک مسافر و در حال گذر هستم، نوشیدنی مستانه‌ای را نوشیدند."],[183,"آسمان بار امانت نتوانست کشید","قرعه کار به نام من دیوانه زدند","اشاره به آیه قران، خداوند می‌فرماید انسان امانتی را پذیرفت که همه آسمان‌ها و زمین آن را پس زدند به راستی که او نادان بود."],[183,"جنگ هفتاد و دو ملت همه را عذر بنه","چون ندیدند حقیقت، ره افسانه زدند","بیشتر قیل‌‌وقال‌ها، سخت‌گیرها و رنج‌های بشر با این اندیشه قابل فهمیدن است که، آدم‌ها واقعیت‌های موجود را فدای کمال‌گرایی‌ها، آرمان‌گراییها و حقیقت‌ها (یی که هرگز وجود نداشتند و ندارند) کردند!"],[183,"شکر ایزد که میان من و او صلح افتاد","صوفیان، رقص‌کنان، ساغر شکرانه زدند","خوشحالم که میان من و او (محبوب یا دوست) صلح برقرار شده است. صوفیان (درویشان) به خاطر این موضوع به خوشحالی و شادی مشغول رقص و نوشیدن ساغر به نشانه قدردانی هستند."],[183,"آتش آن نیست که از شعله او خندد شمع","آتش آن است که در خرمن پروانه زدند","آتش واقعی آن نیست که شمع از شعله آن می‌خندد و روشن می‌شود، بلکه آتش حقیقی همان است که به خرمن پروانه آسیب رسانده و آن را سوزانده است. در اینجا به خطر و درد عشق و عاطفه اشاره شده است که ممکن است شخصی را نابود کند، حتی اگر در ظاهر خندانی وجود داشته باشد."],[183,"کس چو حافظ نگشاد، از رخ اندیشه نقاب","تا سر زلف سخن را، به قلم شانه زدند","هیچ‌کس مانند حافظ نتوانسته از پرده اندیشه‌اش پرده‌برداری کند و تا سر زلف سخن را با قلم مرتب کند و به زیبایی بیافریند."],[184,"نقدها را بود آیا که عیاری گیرند؟","تا همه صومعه‌داران، پی کاری گیرند","آیا ممکن است نقد و بررسی‌ها باعث شوند که افراد باهوش و زیرک، از آن بهره‌برداری کنند و در کارهای خود از آن استفاده نمایند؟ تا این‌که همه کسانی که در صومعه‌ها (مکانه‌های عبادت و زهد) هستند، مشغول به فعالیت شوند؟"],[184,"مصلحت‌دید من، آن است که یاران، همه کار","بگذارند و خم طرّه یاری گیرند","بهتر است من (حافظ) پیشنهاد می‌کنم که دوستان به کار خود رسیدگی نکنند و فقط به یادگاری و ارتباط با دوست (یار) بپردازند."],[184,"خوش گرفتند حریفان، سر زلف ساقی","گر فلکشان بگذارد که قراری گیرند","حریفان (دوستان) خوشحال و شاداب در حال سر زدن به زلف ساقی هستند و اگر سرنوشت (فلک) اجازه بدهد، قرار و مداری به‌وجود خواهند آورد."],[184,"قوّت بازوی پرهیز به خوبان مفروش!","که در این خیل، حصاری به سواری گیرند","به خاطر قدرت و توانایی بازوهای پرهیز از گناه و نیکوکاری، خود را در اختیار خوبان قرار نده، زیرا در میان این جمعیت، به راحتی می‌توانند از تو سواری بگیرند و تو را تحت کنترل درآورند."],[184,"یا‌ رب! این بچه ترکان چه دلیرند به خون","که به تیر مژه، هر لحظه، شکاری گیرند","خدای بزرگ! این جوانان ترک چه شجاع هستند که با نگاهی نافذ و به دور از ترس، هر لحظه طعمه‌ای به دام می‌اندازند."],[184,"رقص بر شعر تر و ناله نی خوش باشد","خاصه، رقصی که در آن، دست نگاری گیرند","رقص کردن بر اشعار لطیف و ناله نی خوشایند است، به خصوص زمانی که در این رقص، دستان معشوقی به همراه باشد."],[184,"«حافظ»! ابنای زمان را غم مسکینان نیست","زین میان گر بتوان؛ به که کناری گیرند","حافظ می‌گوید: در دوران ما، مردم به غم و مشکلات مستضعفان بی‌توجه هستند و اگر ممکن باشد، بهتر است که انسان از آنها دوری کند و کنار برود."],[185,"گر می‌فروش، حاجت رندان روا کند","ایزد، گنه ببخشد و دفع بلا کند","اگر می‌فروش (فروشنده شراب) کارش را درست و مطابق با حقانیت انجام دهد، خداوند در حق رندان (شاعر و عاشقان) لطف می‌کند و گناهان آن‌ها را می‌بخشد و بلاها را دور می‌سازد."],[185,"ساقی، به جام عدل بده باده تا گدا","غیرت نیاورد، که جهان پر‌بلا کند","ای ساقی، به من جامی پر از شراب بده تا گدایی که به تو حسادت نکند، نتواند در این جهان پر از سختی و درد، کارشکنی کند."],[185,"حقّا کز این غمان برسد مژده امان","گر سالکی، به عهد امانت، وفا کند","حقیقتا از این غم‌ها، خبر نجاتی می‌رسد اگر سالکی به عهدی که بر عهده گرفته است، وفا کند."],[185,"گر رنج پیشت آید و گر راحت ای حکیم!","نسبت مکن به غیر که این‌ها خدا کند","اگر رنج و سختی به تو نزدیک بیاید یا راحتی و آسایش، ای حکیم، نباید آن‌ها را به دیگران نسبت بدهی، زیرا این چیزها به دست خداوند است."],[185,"در کارخانه‌ای که ره عقل و فضل نیست","فهم ضعیف رای فضولی چرا کند؟","در کارگاه هستی که عقل و فضل هم به عمق آن راه پیدا نمی‌کنند چرا باید انتظار داشت که فهم ناتوان یک فضول (نادان) به آن راه پیدا کند؟"],[185,"مطرب بساز پرده که کس بی‌اجل نمرد","وان کاو نه این ترانه سراید خطا کند","ای موسیقی‌دان! خورشید روشن بخوان، زیرا کسی که بدون مرگ طبیعی بمیرد، این فرد، کسی است که اگر نخواند و آواز ندهد، مرتکب اشتباه شده است."],[185,"ما را که درد عشق و بلای خمار کشت","یا وصل دوست یا می صافی دوا کند","ما کسانی را که به خاطر درد عشق و عذاب خمار مقتول شده‌ایم، بگو کی می‌تواند ما را با وصال دوست یا نوشیدن می خالص، درمان کند؟"],[185,"جان رفت در سر می و حافظ به عشق سوخت","عیسی‌دمی کجاست که احیای ما کند؟","حافظ در این بیت می‌گوید که جان او به خاطر شراب و عشق رفته است و از عیسی (پیامبر) می‌پرسد که کجاست تا ما را احیا کند و جان تازه‌ای به ما ببخشد. در اینجا «احیا» به معنای تجدید زندگی و احساسات است."],[186,"دلا! بسوز! که سوز تو، کارها بکند","نیاز نیم‌شبی، دفع صد بلا بکند","ای دل رنج و سختی را تحمل کن و شکسته باش که همین دل شکستگی گره­گشا و کارساز تو خواهد بود، و راز نیاز نیم­شبی صدها بلا و گرفتاری را از تو دور خواهد کرد."],[186,"عتاب یار پری‌چهره، عاشقانه بکش!","که یک کرشمه، تلافیّ صد جفا بکند","خشم و ملامت آمیخته با ناز معشوق را عاشقانه تحمل کن، زیرا یک نگاه عاشقانه از جانب معشوق جبران صدها جور و جفا را خواهد کرد."],[186,"ز ملک تا ملکوتش، حجاب بردارند","هر آن که خدمت جام جهان‌نما بکند","هرکس خدمت­گزار جام جهان نما باشد تمام حجاب­ها _ از عالم ماده تا عالم الهی _ برای او برداشته خواهد شد و اسرار الهی را مشاهده خواهد کرد.(جام جهان نما: جام جمشید، دل عارف)"],[186,"طبیب عشق، مسیحا دم است و مشفق، لیک","چو درد، در تو نبیند؛ که را دوا بکند؟","عشق، طبیبی است که هم دلسوز است و هم نفسش شفابخش، اما وقتی هیچگونه درد و نیازی در تو نمی­بیند چگونه تو را درمان کند."],[186,"تو با خدای خود انداز کار و دل خوش دار!","که رحم اگر نکند مدّعی‌، خدا بکند","تو کارها را به خدا واگذار کن و دلت خوش باشد؛ چرا که اگر مدعی لاف زن به تو رحم نکند، خداوند قطعا رحیم و مهربان است."],[186,"ز بخت خفته ملولم، بود که بیداری","به وقت فاتحه صبح، یک دعا بکند؟","از بخت و اقبال نامساعد آزرده ­ام، امید است که انسان بیدار دل شب زنده داری در هنگام صبح دعایی در حق من بکند."],[186,"بسوخت حافظ و بویی به زلف یار نبرد","مگر دلالت این دولتش، صبا بکند","در غم دوری معشوق سوخت و هیچگونه نشانی از معشوق پیدا نکرد، شاید باد صبا او را به این بخت و اقبال( بوییدن عطر دلاویز معشوق) برساند."],[187,"مرا به رندی و عشق، آن فضول، عیب کند","که اعتراض بر اسرار علم غیب کند","شخصی که توانایی فهمیدن حکمت اسرار الهی را ندارد به حقیقت رندی و عشق من نیز پی نمی برد و به همین سبب از آن ایراد می گیرد.فضول شخص کارنادان و دهن بین و عیب جو است در حقیقت چنین شخصی به هر آنچه که فراتر از فهم اوست اعتراض می کند."],[187,"کمال سرّ محبّت ببین، نه نقص گناه","که هر که بی‌هنر افتد، نظر به عیب کند","محبت همان شور و شوق بسیار سالک برای رسیدن به خداوند است و همانند رازی است که با سیر انفسی ( سفر به درون خویش ) به کمال آن می توان پی برد؛ این کمال را ببین نه کاستی های حاصل از گناه را زیرا انسان بی هنر ( فاقد کمال و فضل ) توان پی بردن به گوهر محبت را ندارد پس ناچار توجه خود را معطوف عیوب می کند."],[187,"ز عطر حور بهشت، آن نفس برآید بوی","که خاک میکده ما، عبیر جیب کند","شامه و بویایی از جمله حواسی است که نزد اهل کشف از اهمیت ویژه ای برخوردار است همانطور که ترکیب (بوی حق ) پر کاربرد بوده و نیز در حدیث نبوی ( رائحه الرحمن ) را مشاهده می کنیم؛ آن زمانی عطر حوری بهشتی بوی حق می دهد که خاک میخانه ی ما ( اهل حقیقت ) را مانند عبیر در گریبان خود بگذارد."],[187,"چنان زند ره اسلام، غمزه ساقی","که اجتناب ز صهبا، مگر صهیب کند","صهیب: از صحابه رسول اکرم که به تقوا و پارسایی مشهور است.ناز و کرشمه ی ساقی آنچنان دل انگیز است که همانند راهزنی بر قافله ی اسلام می تازد( و ما را به نوشیدن وادار می کند) شاید تنها صهیب در( چنین شرایطی )قادر باشد از نوشیدن بپرهیزد."],[187,"کلید گنج سعادت، قبول اهل دل است","مباد آن‌که در این نکته، شکّ و ریب کند!","ریب: شک و تردید٬ رستگاری همانند گنجی است که کلید آن در گرو پذیرش و مقبول واقع شدن در پیشگاه اهل دل ( آنان که دل هایشان از تعلقات دنیوی پاک و آیینه وار شده) می باشد مبادا کسی در این مسأله دقیق تردیدی داشته باشد."],[187,"شبان وادی ایمن، گهی رسد به مراد","که چند سال، به جان، خدمت شعیب کند","وادی ایمن: بیابانی که حضرت موسی در آن چوپانی می کرد٬ موسی زمانی به هدف خود ( کلیم اللهی) می رسد که چند سال با جان و دل خدمتگزازی حضرت شعیب را کرده باشد.( اشاره به لزوم سلوک عملی در طریقت برای رسیدن به حقیقت)"],[187,"ز دیده، خون بچکاند فسانه حافظ","چو یاد وقت زمان شباب و شیب کند","هنگامی که حافظ یادی از سرگذشت و داستان زندگی خود چه در زمان پیری چه جوانی کند باعث خون گریستن دیدگان می شود( حکایتگر آن است که در تمام عمر سختی ها و تلخ کامی های فراوانی را پشت سر گذاشته است.)"],[188,"طایر دولت اگر باز گذاری بکند","یار باز آید و با وصل، قراری بکند","اگر پرنده خوشبختی دوباره برگردد، یار بازمی‌گردد و با وصال، آرامشی به وجود خواهد آورد."],[188,"دیده را دستگه درّ و گهر، گرچه نماند","بخورد خونی و تدبیر نثاری بکند","چشم‌ها مانند دستگاهی ساخته از مروارید و گوهر هستند، هرچند که دیگر نمی‌توانند خون گدایی کنند و بی‌دلیل صرفا بر روی خیالات و تدبیرهای بیهوده تمرکز کنند."],[188,"دوش گفتم: «بکند لعل لبش، چاره من؟»","هاتف غیب، ندا داد که: «آری! بکند»","دیشب به حبیب خود گفتم: «آیا او (دختر مورد علاقه‌ام) لبخند خواهد زد و به من توجه می‌کند؟» صدای پنهانی جواب داد: «بله، او لبخند خواهد زد و به تو توجه خواهد کرد."],[188,"کس نیارد بر او دم زند از قصّه ما","مگرش باد صبا گوش گذاری بکند","هیچ‌کس جرأت ندارد درباره او (محبوب) صحبت کند، مگر اینکه نسیم صبحگاهی به او گوش‌می‌دهد و داستان ما را برایش بازگو می‌کند."],[188,"داده‌ام باز نظر را به تذروی پرواز","بازخواند مگرش نقش و شکاری بکند","من به عشق خود باز به نظر او امید دارم که دوباره به پرواز درآید مگر اینکه او نقشی از خود به یادگار بگذارد و به این کار مشغول شود."],[188,"شهر خالیست ز عشّاق؛ بود کز طرفی","مردی از خویش برون آید و کاری بکند","شهر از عشّاق خالی است؛ آیا مردی از جایی پیدا می‌شود که از خود بی‌خود شود و کاری انجام دهد؟"],[188,"کو کریمی که ز بزم طربش، غم‌زده‌ای","جرعه‌ای درکشد و دفع خماری بکند؟","کجاست آن مرد بخشنده‌ای که از میخوارگی و شادی‌اش، غم‌زده‌ای را جرعه‌ای بنوشاند و حال سرخوشی به او بدهد؟"],[188,"یا وفا، یا خبر وصل تو، یا مرگ رقیب","بود آیا که فلک، زین دو سه، کاری بکند؟","آیا او وفاداری نشان می‌دهد، یا خبر وصالت را می‌آورد، یا آیا مرگ رقیب خواهد بود؟ آیا فلک (سرنوشت) از بین این سه موضوع، کاری را انجام خواهد داد؟"],[188,"«حافظا»! گر نروی از در او، هم روزی","گذری بر سرت از گوشه کناری بکند","حافظ می‌گوید اگر تو از در محبوب نروی، روزی به سراغت خواهد آمد و از گوشه‌ای، ندا و خیالی از او به تو خواهد رسید."],[189,"کلک مشکین تو، روزی که ز ما یاد کند","ببرد اجر دو صد بنده که آزاد کند","عطر خوش و دلکش تو، اگر روزی به یاد ما بیفتد، باعث می‌شود که پاداش دو صد بنده‌ای که آزاد کرده‌ای به تو برسد."],[189,"قاصد منزل سلمی که سلامت بادش","چه شود، گر به سلامی، دل ما، شاد کند؟","چه می‌شود اگر پیام‌آور خانه معشوق، که برایش آرزوی سلامتی می‌کنم، با آوردن یک سلام (پیامی کوتاه و مختصر) دل ما را شاد کند؟"],[189,"امتحان کن! که بسی گنج مرادت بدهند","گر خرابی چو مرا، لطف تو، آباد کند","ای معشوق، مرا آزمایش کن! زیرا اگرچه من در وضعیت خرابی هستم، اما لطف تو می‌تواند به خواسته‌ات دست یابد و مرا آباد کند."],[189,"یا رب! اندر دل آن خسرو شیرین انداز","که به رحمت، گذری بر سر فرهاد کند!","خدایا! در دل آن پادشاه شیرین‌سخن، به خاطر رحمتت، راهی بگشا که بر سر فرهاد بگذرد!"],[189,"شاه را به بود از طاعت صدساله و زهد","قدر یک ساعته عمری که در او، داد کند","هر چند شاه به خاطر صد سال طاعت و زهد، مقام و ارزشی دارد، اما ارزش واقعی عمرش در یک ساعت که در آن زمان معصومانه زندگی کند، به او داده می‌شود."],[189,"حالیا، عشوه ناز تو، ز بنیادم برد","تا دگرباره، حکیمانه، چه بنیاد کند","عشق و زیبایی تو آن‌قدر مرا تحت تاثیر قرار داده که از بنیاد وجودم را دگرگون کرده است، اکنون حکیمان چه باید بکنند که این وضعیت را اصلاح کنند؟"],[189,"گوهر پاک تو از مدحت ما مستغنی‌ست","فکر مشّاطه، چه با حسن خداداد کند؟","دست‌نوشته‌های ما برای ستایش تو هیچ ارزش و نیازی ندارند، زیرا زیبایی طبیعی و خدادادی تو به قدری زیاد است که نیازی به تعریف و توصیف ندارد."],[189,"ره نبردیم به مقصود خود اندر شیراز","خرّم آن روز که «حافظ»، ره بغداد کند","ما در شیراز به هدف خود نرسیدیم، آن روزی که حافظ راهی بغداد شد."],[190,"آن، کیست کز روی کرم، با ما وفاداری کند؟","بر جای بدکاری چو من، یک دم نکوکاری کند؟","ان چه کسیست که از روی بخشش بامن وفادار باشد و در پاسخ بد رفتاری هاي من برای لحظه ای مرا دریابد و جوابم را با نیکویی بدهد؟ (از خطایم بگذرد)"],[190,"اول، به بانگ نای و نی، آرد به دل، پیغام وی","وآن‌گه به یک پیمانه می، با من وفاداری کند","ابتدا با آواز و نی زدن برایم پیغام بفرستد وسپس در کنارم مي بنوشد و وفادار باشد"],[190,"دلبر که جان فرسود از او، کام دلم نگشود از او","نومید نتوان بود از او، باشد که دلداری کند","افسرده و خسته شده ام از کسی که دوستش دارم ، هنوز مرا به آرزویم نرسانده اما نمی‌توانم از او ناامید شوم، شاید روزی عاشقانه بادلم مهربان شود"],[190,"گفتم: «گره نگشوده‌ام، زان طرّه تا من بوده‌ام»","گفتا: «منش فرموده‌ام، تا با تو طرّاری کند»","گفتم تا با تو هستم گره ای از کارم باز نشده و وبه آرزویی نرسیده ام.گفت اين خواست من بوده که در کارت گره بیفتد و به خواسته ات نرسی"],[190,"پشمینه‌پوش تندخو، از عشق نشنیده‌ست بو","با مستی‌اش، رمزی بگو! تا ترک هشیاری کند","شخصی که لباس خشن به تن دارد و اخلاق تند و پرخاشگر دارد، از عشق و احساسات عمیق بی‌خبر است. او را مست شوق و شادی کن تا رمز را دریابد و از خود بی‌خود شود."],[190,"چون من گدای بی‌نشان، مشکل بود یاری چنان","سلطان کجا عیش نهان، با رند بازاری کند؟","به خاطر وضعیتی که من دارم و ناشناخته بودنم، کمک گرفتن از سلطانی که در عیش و لذت پنهان فرو رفته، دشوار است. من مانند یک گدای بی‌نشان هستم و نمی‌توانم از این رند عاقل و زیرک که در بازار زندگی می‌کند، یاری بگیرم."],[190,"زآن طرّه پرپیچ و خم، سهل است اگر بینم ستم","از بند و زنجیرش چه غم، هر کس که عیّاری کند؟","من از آن موهای پیچیده و زیبا غم ندارم اگر که به خاطر این زنجیر و بندها سختی بکشم، زیرا هر کسی که با ذکاوت و ترفند عمل کند، به راحتی می‌تواند از این مشکلات بگذرد."],[190,"شد لشکر غم بی‌عدد، از بخت می‌خواهم مدد","تا فخر دین عبدالصّمد، باشد که غم‌خواری کند","غم مانند لشکری بی‌نهایت بر من هجوم آورده است و از بخت و سرنوشت می‌خواهم که کمکم کند تا عبدالصمد، که فخر دین است، به من کمک کند و از غم‌هایم بکاهد."],[190,"با چشم پر نیرنگ او، «حافظ»! مکن آهنگ او!","کآن طرّه شبرنگ او، بسیار طرّاری کند","چشم او بسیار فریبنده و نیرنگ‌آمیز است، ای حافظ! به او نزدیک نشو، چرا که موی بافته و خوش‌زیبای او خیلی‌های دیگر را هم فریب داده است."],[191,"سرو چمان من چرا میل چمن نمی‌کند؟","همدم گل نمی‌شود، یاد سمن نمی‌کند","چرا همسر قد بلند من که همچون سرو است به خانه نمیاید ?همدم من که مانند گل هستم نمی شود و از بچه هایمان که مانند سمن هستند یاد نمی کند?"],[191,"دی گله‌ای ز طرّه‌اش، کردم و از سر فسوس","گفت که «این سیاه‌کج، گوش به من نمی‌کند»","من از دیروز، شکایت کردم از موهای پیراهن او و او پاسخ داد که «این جوان بی‌اعتنا، به سخنان من توجه نمی‌کند»."],[191,"تا دل هرزه‌گرد من، رفت به چین زلف او","زان سفر دراز خود، عزم وطن نمی‌کند","دل بی‌قراری که من دارم، به خاطر زیبایی‌های پیچیده زلف او به سفری طولانی رفته و هنوز قصد بازگشت به وطن (یعنی حال و روز طبیعی خود) را ندارد."],[191,"پیش کمان ابرویش، لابه همی کنم ولی","گوش کشیده است از آن، گوش به من نمی‌کند","من در برابر کمان ابروی او زاری و خواهش می‌کنم، اما او به این درخواست‌ها توجهی ندارد و به من گوش نمی‌دهد."],[191,"با همه عطف دامنت، آیدم از صبا عجب","کز گذر تو، خاک را، مشک ختن نمی‌کند","با آن همه عاطفه و محبتی که از وجود و دامان تو سر ریز می شود از باد صبا تعجب میکنم که چگونه هنگام گذر تو بر روی خاک ، آنرا مانند عطر مشکی که در سرزمین ختن است خوشبو نمی کند؟"],[191,"چون ز نسیم می‌شود، زلف بنفشه پرشکن","وه که دلم چه یاد از آن، عهدشکن نمی‌کند","وقتی نسیم می‌وزد، زلف بنفشه پر شکاف می‌شود و آه، دلم هرگز فراموشی نمی‌کند که او چه پیمان شکنی کرده است."],[191,"دل به امید روی او، همدم جان نمی‌شود","جان به هوای کوی او، خدمت تن نمی‌کند","دل به امید دیدن او نمی‌تواند رفاقت با جان را داشته باشد و جان هم به خاطر عشق و آرزوی کوی او، به خدمت تن نمی‌پردازد."],[191,"ساقی سیم‌ساق من، گر همه درد می‌دهد","کیست که تن چو جام می، جمله دهن نمی‌کند؟","اگر ساقی یا معشوق به من تماما درد و اندوه میدهد، چه کسی هست که، همانطور که جام می برای بلعیدن شراب دهان باز میکند، تنش را برای پذیرفتن آن درد باز نکند.( استعاره از پذیرا بودن عاشق نسبت به هر درد و غمی که از معشوق میرسد)"],[191,"دستخوش جفا مکن، آب رخم که فیض ابر","بی‌مدد سرشک من، در عدن نمی‌کند","مرا مورد آزمایش و آزار نکن، ای محبوب، زیرا جلوه زیبایی تو آنچنان خاص است که اگر اشکی از چشمان من نریزد، برکات و نعمت‌هایی که از ابر می‌بارند، هیچ ثمری نخواهند داشت."],[191,"کشته غمزه تو شد، حافظ ناشنیده‌پند","تیغ سزاست هر که را، درد، سخن نمی‌کند","حافظ می‌گوید: کسی که به خاطر زیبایی‌های تو (غمزه) به مرگ افتاده، سزاوار تیغ و ضربه است، زیرا کسی که او را درد و رنجی آزار نرساند، در واقع سخن نمی‌گوید و ناشنیده باقی می‌ماند."],[192,"در نظربازی ما، بی‌خبران، حیرانند","من، چنینم که نمودم؛ دگر ایشان دانند","آدم‌های نادان معنی نظربازی ما را نمی‌دانند؛ من همان هستم که به‌آنها نمودم‌، حالا خود می‌دانند که چه برداشت کنند."],[192,"عاقلان، نقطه پرگار وجودند ولی","عشق داند که در این دایره، سرگردانند","عاقلان و آنها که از عشق بی‌خبر هستند گرامی و گرانقدر هستند اما عشق‌، بها و ارزشی برای آنها قائل نیست."],[192,"جلوه‌گاه رخ او، دیده من، تنها نیست","ماه و خورشید، همین آینه می‌گردانند","فقط من نیستم که پیوسته به‌او می‌نگرم و عاشق او هستم، بلکه ماه و خورشید نیز همین‌کار را می‌کنند."],[192,"عهد ما با لب شیرین‌دهنان بست خدا","ما، همه، بنده و این قوم، خداوندانند","ما از ازل پیمان عشق خود را با شیرین‌دهنان بسته‌ایم؛ ما بندگان هستیم و آنها پادشاهان هستند."],[192,"مفلسانیم و هوای می و مطرب داریم","آه اگر خرقه پشمین به گرو نستانند!","مفلس و بی‌پول هستیم و برای می و موسیقی می‌خواهیم به خرابات برویم؛ وای بر ما اگر خرقه پشمین ما را به‌گرو قبول نکنند."],[192,"وصل خورشید به شب‌پرّه اعمی نرسد","که در آن آینه، صاحب‌نظران، حیرانند","خفاش کور نمی‌تواند به وصل خورشید برسد؛ حتی صاحب‌نظران نیز در آن دیدار، حیران می‌شوند (چه رسد به خفاش کور)"],[192,"لاف عشق و گله از یار؟ زهی لاف دروغ!","عشق‌بازان چنین، مستحق هجرانند","لاف عاشقی زدن و شکایت از جور یار‌، دو چیز با هم ناساز هستند کسانی‌که این‌چنین هستند لایق وصال نیستند."],[192,"مگرم چشم سیاه تو بیاموزد کار","ورنه مستوری و مستی، همه‌کس نتوانند","مگر چشمان سیاه تو راهش را به‌من بیاموزد وگرنه نمی‌توانم مستی خود را پنهان کنم."],[192,"گر به نزهتگه ارواح برد بوی تو، باد","عقل و جان، گوهر هستی به نثار افشانند","اگر عطر خوش تو را باد به بهشت برساند در آنجا عقل و جان خود را به‌شکرانه می‌بخشند."],[192,"زاهد ار رندی «حافظ» نکند فهم، چه شد؟","دیو بگریزد از آن قوم که قرآن خوانند","زاهد اگر رندی و نکته‌های حافظ را نمی‌فهمد (و او را سرزنش می‌کند) غیر از این نیست که دیوها نیز از آنان‌که قرآن می‌خوانند، می‌گریزند."],[192,"گر شوند آگه از اندیشه ما، مغ‌بچگان","بعد از این، خرقه صوفی به گرو نستانند","اگر مغبچگان از اندیشه ما آگاه شوند، بعد از این‌، صوفی را در خرابات نمی‌پذیرند."],[193,"سمن‌بویان، غبار غم چو بنشینند؛ بنشانند","پری‌رویان، قرار از دل چو بستیزند؛ بستانند","زمانی که زیبارویان خوشبو در مجلسی می­‌نشینند، غبار غم و اندوه نیز در مجلس فرو می­‌نشیند، و زمانی که زیبارویان ناسازگاری می­‌کنند، آرام و قرار را از دل می­‌برند"],[193,"به فتراک جفا، دل‌ها چو بربندند؛ بربندند","ز زلف عنبرین، جان‌ها چو بگشایند؛ بفشانند","وقتی زیبارویان دل­‌ها را اسیر خود می­کنند و به دام می‌­اندازند، آنها را تا همیشه گرفتار خود می­‌سازند، و هنگامی که گره زلف عطرآگین خود را باز می‌­کنند، جان­های بسیاری را که در پیچ و تاب زلف ایشان اسیر هستند، فرو می‌­ریزد"],[193,"به عمری، یک نفس با ما چو بنشینند؛ برخیزند","نهال شوق در خاطر چو برخیزند، بنشانند","وقتی پس از روزگاری طولانی و چشم انتظاری، لحظه­‌ای در کنار ما می­‌نشینند، سریع برمی­‌خیزند و می­‌روند، هنگام برخاستن و بلند شدن نیز، شور و شوق را همچون نهالی در دل ما قرار می‌­دهند.(دل ما را پر از آرزوی خواستن می­‌کند)"],[193,"سرشک گوشه‌گیران را چو دریابند، در یابند","رخ مهر از سحرخیزان نگردانند، اگر دانند","اگر به قطرات اشک گوشه گیران و عزلت نشینان توجه کنند، خواهند دانست که آن اشک‌­ها همچون در و گوهر با ارزش هستند، همچنین اگر اهل معرفت باشند و بدانند، هرگز با بی‌­مهری از سحرخیزان و شب زنده داران روی خود را بر نمی­‌گردانند"],[193,"ز چشمم، لعل رمّانی چو می‌خندند، می‌بارند","ز رویم، راز پنهانی چو می‌بینند؛ می‌خوانند","زمانی که زیبارویان می­‌خندند، چشمان مرا وادار می­‌کنند تا اشکی سرخگون از آن جاری شود، و هنگامی که به چهره­‌ی من نگاه می­‌کنند تمام رازهای پنهانی (عشق) مرا، متوجه می­‌شوند"],[193,"دوای درد عاشق را کسی کاو سهل پندارد","ز فکر، آنان که در تدبیر درمانند، در مانند","هر کس درمان درد عشق را آسان تصور کند، سخت در اشتباه است، و آن کسانی هم که می­‌خواهند با عقل و تدبیر مشکل عشق را درمان کنند، در این کار عاجز و ناتوان باقی خواهند ماند"],[193,"چو منصور از مراد آنان که بردارند، بر دارند","بدین درگاه، «حافظ» را چو می‌خوانند؛ می‌رانند","کسانی که همانند منصور حلاج در راه عشق به دار آویخته می­‌شوند، تنها می­‌توانند به آرزو و مراد خود برسند؛ اما در این درگاه زمانی که حافظ را فرا می­‌خوانند، بلافاصله او را از آنجا می‌­رانند و طرد می‌­کنند( منصور: منصور حلاج؛ از عارفان مشهور ایران که به جرم اناالحق گفتن در سال ۳۰۹ ه.ق. در زمان عباسیان به دار آویخته شد)"],[193,"در این حضرت چو مشتاقان نیاز آرند، ناز آرند","که با این درد اگر دربند درمانند، در مانند","زمانی که عاشقان و مشتاقان با نیاز به این درگاه روی می­‌آورند، با ناز و بی­مهری معشوق رو به رو می­‌شوند، کسانی که به دنبال درمان درد عشق می­‌گردند نیز ، مطمئنا درمانده و ناتوان خواهند شد"],[194,"غلام نرگس مست تو، تاجداران‌اند","خراب باده لعل تو، هوشیاران‌اند","شاهان تاجدار با همه بزرگی به غلامی چشم مست و زیبای تو مشغول اند و آنان که که از باده وجود تو نوشیده اند از مستی هوشیاری یافته اند"],[194,"تو را صبا و مرا آب دیده شد غمّاز","وگرنه عاشق و معشوق، رازداران‌اند","باد صبا، تو را به عشق می‌تازد و اشک‌های من، نشان‌دهنده درد عشق است. آنها که عاشق و معشوق را می‌شناسند، این راز را در دل دارند و آن را پنهان نگه می‌دارند."],[194,"ز زیر زلف دوتا چون گذر کنی، بنگر","که از یمین و یسارت چه سوگواران‌اند!","اگر از زیر دو تار موی او عبور کنی، توجه کن که از راست و چپ چه افرادی غمگین و سوگوار هستند!"],[194,"گذار کن چو صبا بر بنفشه‌زار! و ببین","که از تطاول زلفت چه بی‌قراران‌اند!","به گل‌زار برو و باد را به حرکت درآور، و ببین که چقدر به خاطر بلندی موهای تو، دل‌های عاشقان بی‌قرار شده‌اند!"],[194,"نصیب ماست بهشت، ای خداشناس! برو!","که مستحقّ کرامت، گناهکاران‌اند","نصیب ما بهشت است، ای کسی که خدا را می‌شناسی! برو و ببین که گناهکاران شایسته نعمت‌های تو هستند."],[194,"نه من بر آن گل عارض، غزل‌سرایم و بس","که عندلیب تو از هر طرف، هزاران‌اند","من به خاطر آن گل زیبا شعر نمی‌گویم، بلکه به خاطر آنچه که بلبل تو از هر سو می‌خواند، هزاران بلبل وجود دارند."],[194,"تو دستگیر شو! ای خضر پی‌خجسته! که من","پیاده می‌روم و همرهان، سواران‌اند","ای خضر، که به صورت معشوقه‌ام درآمده‌ای، تو مرا دستگیر کن! زیرا من مانند یک پیاده در مسیر عشق می‌روم و هم‌سفرانم سوار بر اسب هستند."],[194,"بیا به میکده! و چهره، ارغوانی کن!","مرو به صومعه کآنجا سیاه‌کاران‌اند!","به میخانه بیا و چهره‌ات را به رنگ ارغوانی درآور، چرا که در صومعه، فقط افراد بدکار و سیاه‌رو وجود دارند."],[194,"خلاص «حافظ» از آن زلف تابدار مباد!","که بستگان کمند تو، رستگاران‌اند","حافظ از شیدایی و عشق می‌گوید و تاکید می‌کند که او را از این زلف‌های پیچیده و شگفت‌انگیز رها نکن، زیرا کسانی که به دام این زلف‌ها افتاده‌اند، برای رهایی و نجات بخشی به او نیاز دارند."],[195,"آنان که خاک را به نظر کیمیا کنند","آیا بود که گوشه چشمی به ما کنند","آنان که خاک را با نگاهی به طلا تبدیل می‌کنند، آیا ممکن است نگاهی هم به ما بیندازند؟"],[195,"دردم نهفته به ز طبیبان مدعی","باشد که از خزانه غیبم دوا کنند","درد من پنهان بماند بهتر از این است که به پزشک‌هایی رجوع کنم که فقط ادعا دارند؛ امید است که مرا از عالم غیب درمان کنند."],[195,"معشوق چون نقاب ز رخ درنمی‌کشد","هر کس حکایتی به تصوّر چرا کنند؟","برای هر کسی که معشوق زیبای خود را نمی‌پوشاند و چهره‌اش را نمایان نمی‌کند، حکایتی می‌سازند و فکری از خود می‌کنند."],[195,"چون حسن عاقبت نه به رندی و زاهدی‌ست","آن به که کار خود به عنایت رها کنند","حسن عاقبت یعنی نتیجه خوب زندگی نه به رندی (شیطنت) و زهد (رهبانیت) بستگی دارد، بلکه بهتر است که آدمی کارهایش را به لطف و رحمت خدا واگذار کند."],[195,"بی معرفت مباش که در من‌یزید عشق","اهل نظر معامله با آشنا کنند","بی معرفت نباش چون در مزایده عشق، اهل نظر فقط با آشنایان معامله می کنند"],[195,"حالی درون پرده بسی فتنه می‌رود","تا آن زمان که پرده برافتد چه‌ها کنند","در درون پرده، شور و آشوب زیادی وجود دارد و تا زمانی که پرده کنار نرود، انسان نمی‌تواند ببیند که چه اتفاقاتی خواهد افتاد."],[195,"گر سنگ از این حدیث بنالد عجب مدار","صاحبدلان حکایت دل خوش ادا کنند","اگر سنگ هم از این داستان ناراحت شود، شگفت‌زده نشو، زیرا صاحبدلان داستان دل را به زیبایی بیان می‌کنند."],[195,"می خور که صد گناه ز اغیار در حجاب","بهتر ز طاعتی که به روی و ریا کنند","نوشیدن می را انتخاب کن، زیرا صد گناه از دیگران در پنهان بهتر است از اطاعت و عبادتی که تنها به خاطر نمایش و ریا انجام می‌شود."],[195,"پیراهنی که آید از او بوی یوسفم","ترسم برادران غیورش قبا کنند","پیراهنی که از آن بوی یوسف می‌آید، نگرانم که برادران حسودش آن [پیراهن] را پاره کنند."],[195,"بگذر به کوی میکده تا زمره حضور","اوقات خود ز بهر تو صرف دعا کنند","از کوچه میکده بگذر تا جمعی که در آنجا هستند، به خاطر تو و حضورت، اوقات خود را به دعا و نیایش اختصاص دهند."],[195,"پنهان ز حاسدان به خودم خوان که منعمان","خیر نهان برای رضای خدا کنند","پنهانی و دور از چشم حسودان مرا نزد خود بخوان، زیرا افراد نیکوکار برای رضای خدا کارهای خیر را پنهانی انجام می‌دهند."],[195,"حافظ دوام وصل میسر نمی‌شود","شاهان کم التفات به حال گدا کنند","حافظ می‌گوید که ادامه‌ی رابطه و وصال ممکن نیست، زیرا پادشاهان (یا افراد با مقام) به حال درویش‌ها (و افرادی که به عشق نیاز دارند) توجهی نمی‌کنند."],[196,"شاهدان گر دلبری زین سان کنند","زاهدان را رخنه در ایمان کنند","اگر دلبرانی چون آن شاهد، دلبری کنند، زاهدان (مؤمنان) نیز دچار تردید در ایمان خود خواهند شد."],[196,"هر کجا آن شاخ نرگس بشکفد","گل‌رخانش دیده نرگس‌دان کنند","هر جا که گل‌های زیبای نرگس شکوفه دهند، آنجا چهره‌های زیبا را به عنوان نرگس می‌شناسند."],[196,"ای جوان سروقد! گویی ببر","پیش از آن کز قامتت چوگان کنند","ای جوان بلند قامت، گویی (منظور گوی چوگان )ببر و تلاش کن تا برنده باشی قبل از اینکه پیر شوی و قامتت مانند چوگان خمیده شود"],[196,"عاشقان را بر سر خود حکم نیست","هر چه فرمان تو باشد آن کنند","عاشقان هیچ‌کدام محدود به دستورات و قوانین نیستند و هر کاری که تو بخواهی انجام می‌دهند."],[196,"پیش چشمم کمتر است از قطره‌ای","این حکایت‌ها که از طوفان کنند","این حکایت‌ها و خبرهایی که درباره عشق و عاشقی می‌گویند، در نظر من به اندازه یک قطره هم اهمیت و ارزش ندارند، چرا که به شدت تحت تأثیر طوفانی بزرگ‌تر و عمیق‌ترند."],[196,"یار ما چون گیرد آغاز سماع","قدسیان بر عرش دست‌افشان کنند","وقتی که معشوق ما شروع به رقص و شادی می‌کند، فرشتگان در آسمان با شگفتی و شادی دست‌هایشان را به سمت او فرا می‌برند."],[196,"مردم چشمم به خون آغشته شد","در کجا این ظلم بر انسان کنند؟","چشم‌های مردم شهر من از غم و اندوه مانند خون شده است؛ این همه ظلم و ستم بر انسان‌ها چه جایی انجام می‌شود؟"],[196,"خوش برآ با غصه، ای دل! کاهل راز","عیش خوش در بوته هجران کنند","ای دل، با غم و اندوه خوش باشید! چون بی‌تحرکی و رکود در فهم لذت‌های زندگی، در دوران جدایی و فراق، به انسان آسیب می‌زند."],[196,"سر مکش حافظ ز آه نیم‌شب","تا چو صبحت، آینه رخشان کنند","چهره زیبا و درخشانت را در صبحگاهان مثل آینه روشن می‌کنند، پس از اندوه شبانه تا صبح، سر به زمین نگذار و غم به دل راه نده."],[197,"گفتم کی ام دهان و لبت کامران کنند؟","گفتا به چشم هر چه تو گویی چنان کنند","از من پرسیدند که چه زمانی دهان و لب تو خوشبخت خواهند شد؟ و او پاسخ داد: هر چه را تو بگویی، با چشم خود همان‌طور خواهند کرد."],[197,"گفتم خراج مصر طلب می‌کند لبت","گفتا در این معامله کمتر زیان کنند","به او گفتم: لب‌ تو آنقدر باارزش‌است که با خراج ملک مصر برابری می‌کند گفت که ارزش آن‌را دارد."],[197,"گفتم به نقطه دهنت خود که برد راه؟","گفت این حکایتیست که با نکته‌دان کنند","از او پرسیدم که چه‌کسی به بوسه‌ی دهان کوچک تو می‌رسد؟ گفت این داستانی است که نکته‌دان‌ها به آن می‌رسند."],[197,"گفتم صنم‌پرست مشو با صمد نشین","گفتا به کوی عشق هم این و هم آن کنند","به صده دلبرم (صنم) گفتم که به مظهری والا (صمد) پناه نبر، او در پاسخ گفت که در کوی عشق هم می‌توان به معشوق پرستی و هم به خداوند پناه برد."],[197,"گفتم هوای میکده غم می‌برد ز دل","گفتا خوش آن کسان که دلی شادمان کنند","گفتم که هوای میکده باعث ناراحتی و غم در دل می‌شود. او گفت که خوش به حال کسانی که می‌توانند دل را شاد و خوشحال کنند."],[197,"گفتم شراب و خرقه نه آیین مذهب است","گفت این عمل به مذهب پیر مغان کنند","من گفتم که نوشیدن شراب و پوشیدن خرقه (لباس دینی) از رسوم دینی نیست. او پاسخ داد که این کارها به روش و آیین پیر مغان (مغان، در اینجا به طور استعاری به عارفان و راست‌جویان اشاره دارد) انجام می‌شود."],[197,"گفتم ز لعل نوش‌لبان پیر را چه سود؟","گفتا به بوسه شکرینش جوان کنند","گفتم از لعل (مروارید) لبهای آن پیر چه بهره‌ای می‌برم؟ او پاسخ داد که با بوسه شیرینش می‌توان جوان شد و زندگی دوباره‌ای یافت."],[197,"گفتم که خواجه کی به سر حجله می‌رود؟","گفت آن زمان که مشتری و مه قران کنند","از کسی سوال می‌کنم که کی به خونه همسرش خواهد رفت. او پاسخ می‌دهد که این زمان زمانی است که سیاره مشتری و ماه در یک نقطه قرار بگیرند، که نشانه‌ای از خوش‌یمنی و شگون است."],[197,"گفتم دعای دولت او ورد حافظ است","گفت این دعا ملایک هفت آسمان کنند","گفتم دعای خوشبختی او برای حافظ مورد تکرار و یادآوری است. گفت: این دعا را فرشتگان هفت آسمان می‌خوانند و به آن توجه دارند."],[198,"واعظان کاین جلوه در محراب و منبر می‌کنند","چون به خلوت می‌روند آن کار دیگر می‌کنند!","نصیحت­‌گویان که چنین خود را پاک و مطهر در محراب و منبر نشان می­‌دهند در خلوت کاری بر خلاف گفته‌­های خود انجام می­‌دهند(نکته: یکی از رندانه ترین ناسزاهایی که در طول تاریخ زبان و ادبیات فارسی به ریاکاران گفته شده است این بیت حافظ است و تمام زیبایی این ناسزا نیز از آنجا شروع می­‌شود که حافظ هیچ ناسزایی نگفته است. اجازه بدهید واضح­تر این مطلب را بیان کنم حافظ در مصراع دوم تنها به این گفته بسنده می کند “آن کار دیگر می­‌کنند” چنانچه می بینید حافظ عملا هیچ حرف خاصی نزده است اما در واقع عبارت “آن کار دیگر” گویی همانند “نقطه چین” عمل می‌­کند چرا که ذهن خواننده به طور ناخودآگاه آن نقطه چین را پر می کند در حالی که در واقعیت حافظ هیچ ناسزایی نگفته است)"],[198,"مشکلی دارم، ز دانشمند مجلس بازپرس","توبه‌فرمایان، چرا خود توبه کم‌تر می‌کنند؟","سوالی دارم از دانشمند مجلس این نکته را بپرس: چرا کسانی که مردم را وادار به توبه و پرهیزگاری می­‌کنند خود هرگز توبه نمی­‌کنند(نکته: مصراع دوم احتمالا اشاره به آیه‌­ی ۴۴ سوره بقره دارد: أتأمرون النّاس بالبرّ وتنسون أنفسکم وأنتم تتلون الکتاب ۚأفلا تعقلون)"],[198,"گوییا باور نمی‌دارند روز داوری","کاین همه قلب و دغل در کار داور می‌کنند","مثل اینکه هرگز به روز قیامت اعتقادی ندارند چرا که مشغول این همه نیرنگ و تقلب در کار خداوند هستند"],[198,"یا رب این نودولتان را با خر خودشان نشان","کاین همه ناز از غلام ترک و استر می‌کنند","خداوندا این تازه به دوران رسیده ها را به جایگاه قبلی خودشان بازگردان چرا که امروزه به واسه داشتن چند غلام ترک و چند چارپا به همه فخر می فروشند و خود را برتر از همه می دانند"],[198,"ای گدای خانقه، برجه که در دیر مغان","می‌دهند آبی و دل‌ها را توانگر می‌کنند","ای کسی که در خانقاه به گدایی رسیده ای از آن جا برخیز و به سمت دیر مغان برو و ببین که در آنجا به تو شرابی می دهند که به واسطه خوردن آن دل تو ثروتمند و غنی خواهد شد"],[198,"حسن بی‌پایان او، چندان که عاشق می‌کشد","زمره دیگر به عشق از غیب سر بر می‌کنند","زیبایی نامتناهی خداوند هر چند که عاشقان خود را می­‌کشد اما باز گروهی دیگر از عالم غیب آشکار می‌­شوند و عاشقانه آماده جان‌فشانی در راه او می­‌شوند"],[198,"بر در می‌خانه عشق ای ملک، تسبیح گوی","کاندر آنجا، طینت آدم مخمّر می‌کنند","ای فرشتگان به سراغ میخانه عشق بروید و در آنجا خداوند را به پاکی ستایش کنید چرا که در آنجا گل وجود آدمی را ورز می دهند(نکته: بیت فوق از لحاظ معنایی یادآور بیت زیر است:دوش دیدم که ملایک در میخانه زدند گل آدم بسرشتند و به پیمانه زدند.)"],[198,"صبح‌دم از عرش می‌آمد خروشی، عقل گفت","«قدسیان گویی که شعر حافظ از بر می‌کنند»","هنگام صبح از عرش الهی بانگ و فریادی می آمد جبرییل گفت: مثل اینکه فرشتگان مشغول حفظ کردن شعر حافظ هستند."],[199,"دانی که چنگ و عود چه تقریر می‌کنند؟","پنهان خورید باده که تعزیر می‌کنند","می دانی که چنگ و عود(بربط و در کل منظور موسیقی )چی میگن.مشروب را در خفا و خلوت بخورید که اگر شما را با مشروب بگیرند شلاقت میزنند."],[199,"ناموس عشق و رونق عشّاق می‌برند","عیب جوان و سرزنش پیر می‌کنند","با عشق و عشق بازی مخالفند و اون را گناه میدونند و جوانی که عاشق بشود را عیب دار میکنند و پیر ها را هم سرزنش میکنند"],[199,"جز قلب تیره هیچ نشد حاصل و هنوز","باطل در این خیال که اکسیر می‌کنند","(برخی از کسانی که به دنبال کیمیاگری بودند متوسل به سحر و جادو میشدند و این امر قلبشان را سیاه میکرد.) مانند برخی از کیمیاگران که فکر میکنند دارند مس رو طلا میکنند رفتار ظاهربینان صرفا قلبشان را تیره و سیاه کرده است. (کنایه به اینکه با برخورد سطحی خودشان را از فهم عرفان محروم کرده اند.)"],[199,"گویند رمز عشق مگویید و مشنوید","مشکل حکایتیست که تقریر می‌کنند","می‌گویند درباره عشق صحبت نکنید و نشنوید، زیرا این داستانی است پیچیده که به سختی قابل بیان است."],[199,"ما از برون در شده مغرور صد فریب","تا خود درون پرده چه تدبیر می‌کنند","ما از دنیای بیرون و ظواهر فریبنده مغرور شده‌ایم، اما در باطن و در عمق وجود چه کارهایی در حال انجام است و چه تدبیری در حال چیده شدن است."],[199,"تشویش وقت پیر مغان می‌دهند باز","این سالکان نگر که چه با پیر می‌کنند","آنان زرتشت را نیز پریشان می‌کنند،به این افراد گستاخ بنگر که با یک بزرگ(پیر :رهبر،دانا)چه بد رفتارمی‌کنند."],[199,"صد ملک دل به نیم نظر می‌توان خرید","خوبان در این معامله تقصیر می‌کنند","با یک نگاه کوتاه می‌توانیم قلب‌ها را به دست آوریم. در این معامله، زیبایی‌ها به نحوی کوتاهی می‌کنند."],[199,"قومی به جدّ و جهد نهادند وصل دوست","قومی دگر حواله به تقدیر می‌کنند","گروهی با تلاش و کوشش به دنبال رسیدن به دوستی و ارتباط نزدیک هستند، در حالی که گروه دیگری به سرنوشت و تقدیر خود بسنده کرده و اوضاع را به حال خود رها کرده‌اند."],[199,"فی‌الجمله اعتماد مکن بر ثبات دهر","کـ‌این کارخانه‌ایست که تغییر می‌کنند","به طور کلی به ثبات و پایداری روزگار اتکا نکن، زیرا این دنیا مانند کارگاهی است که دائما دستخوش تغییرات می‌شود."],[199,"می خور که شیخ و حافظ و مفتی و محتسب","چون نیک بنگری همه تزویر می‌کنند","نوشیدن شراب را تجربه کن، زیرا اگر به دقت نگاه کنی، می‌بینی که روحانیان، حافظان قرآن و مسئولان دینی همگی در رفتارهای خود فریبکاری و دوگانگی دارند."],[200,"شراب بی‌غش و ساقیّ خوش دو دام رهند","که زیرکان جهان از کمندشان نرهند","شراب خالص و ساقی خوشروی، دو گام خطرناک‌اند که افراد زبردست دنیا نمی‌توانند از دام آن‌ها فرار کنند."],[200,"من ار چه عاشقم و رند و مست و نامه سیاه","هزار شکر که یاران شهر بی‌گنهند","من عاشق، رند و مست هستم و با این حال، نامه‌ای پر از گناهان دارم؛ اما باید بگویم که دوستان و یاران من در این شهر، بی‌گناه هستند."],[200,"جفا نه پیشه درویشیست و راهروی","بیار باده که این سالکان نه مرد رهند","بدی و ستمکاری خاص درویشان نیست و ای مسافر، باده بیاور چون این راهیان حقیقتا مردان راه نیستند."],[200,"مبین حقیر، گدایان عشق را کاین قوم","شهان بی کمر و خسروان بی کلهند","منظور حافظ این است که من نباید خود را خوار و حقیر بدانم، و همچنین نباید گدایان عشق را کم‌ارزش بشمارم؛ چراکه این گروهی که به عشق روی آورده‌اند، کسانی هستند که نه تنها هیچ قدرتی ندارند، بلکه حتی شاهان و سران از نظر مقام و ریشه هم به حساب نمی‌آیند."],[200,"به هوش باش که هنگام باد استغنا","هزار خرمن طاعت به نیم جو ننهند","مواظب باش که وقتی زمان بی‌نیازی و سرفرازی فرا رسد، تمامی پاداش‌های عبادت و اطاعتت به یک ذره هم نمی‌ارزد و به آسانی از دست می‌روند."],[200,"مکن که کوکبه دلبری شکسته شود","چو بندگان بگریزند و چاکران بجهند","مبادا عشق و زیبایی‌ات دچار آسیب و نقصان شود؛ چراکه وقتی مردم از تو فراری شوند و خدمتگزارانت به سمت دیگری بروند، این زیبایی از بین می‌رود."],[200,"غلام همّت دردی کشان یک رنگم","نه آن گروه که ازرق لباس و دل سیهند","من از دلدادگان و دوستانی هستم که در عشق و برنامه‌ریزی صاف و یک‌رنگ هستند و نه از کسانی که فقط به ظواهر و لباس‌های آبی رنگ اهمیت می‌دهند و دل‌هایشان تیره و غم‌انگیز است."],[200,"قدم منه به خرابات جز به شرط ادب","که سالکان درش محرمان پادشهند","به خرابات (محل شراب‌خواری و تنگ‌نای دوستان) پای نگذار مگر با احترام، زیرا دست‌اندرکاران آنجا، دوستان و رازداران پادشاه (عشق) هستند."],[200,"جناب عشق بلند است همّتی حافظ","که عاشقان، ره بی‌همّتان به خود ندهند","عشق مقام و اراده بلندی دارد، و حافظ می‌گوید که عاشقان نباید راهی به کسانی که هم‌مقام آنان نیستند open کنند."],[201,"بود آیا که در میکده‌ها بگشایند؟","گره از کار فروبسته ما بگشایند؟","آیا امکان دارد در میکده‌ها را برای ما باز کنند؟ آیا می‌توانند مشکل و سختی‌های ما را حل کنند؟"],[201,"اگر از بهر دل زاهد خودبین بستند","دل قوی دار که از بهر خدا بگشایند","اگر به خاطر خودخواهی زاهد در میخانه را بستند، خیالت راحت باشد زیرا به خاطر خدا آن را باز خواهند کرد."],[201,"به صفای دل رندان صبوحی‌زدگان","بس در بسته به مفتاح دعا بگشایند","دل رندانی که به میگساری پرداخته‌اند، با خلوص و صفا، دعاهایشان تأثیر دارد و سبب می‌شود درهای بسته به رویشان باز شود."],[201,"نامه تعزیت دختر رز بنویسید","تا همه مغبچگان زلف دوتا بگشایند","مرگ دختر رز(شراب) کنایه از بسته شدن میخانه و محروم شدن از شراب است؛ شاعر با اغراق می‌گوید این فقدان چنان سنگین است که مغبچگان نیز به رسم سوگواری زلف‌های خود را می‌گشایند.»."],[201,"گیسوی چنگ ببرّید به مرگ می ناب","تا حریفان همه خون از مژه‌ها بگشایند","به مناسبت مرگ شراب ناب، ساز چنگ را به نوای عزا درآورید،تا یاران از شدت اندوه، چون عزاداران، اشک خون‌گون بریزند."],[201,"در میخانه ببستند، خدایا مپسند!","که در خانه تزویر و ریا بگشایند","خدایا، روا مدار که در میخانه را ببندندو در عوض، در خانه‌های ریا و دورویی را باز بگذارند."],[201,"حافظ این خرقه که داری تو ببینی فردا","که چه زنّار ز زیرش به دغا بگشایند","ای حافظ، این خرقه‌ی زهدی که بر تن داری، فردا خواهی دید که زیر آن چه زنّار (کمربند غیر مسلمانان، بخصوص زرتشتیان و مسیحیان) کفرآمیزی را با فریب و نیرنگ پنهان کرده‌اند."],[202,"سال‌ها دفتر ما در گرو صهبا بود","رونق می‌کده از درس و دعای ما بود","سال‌ها دفتر زندگی ما به شراب وابسته بود و رونق میکده به سبب نیایش ها و دعاهای ما شکل می‌گرفت."],[202,"نیکی پیر مغان بین که چو ما بدمستان","هر چه کردیم به چشم کرمش زیبا بود","نیکی و بزرگواری پیر مغان را ببین که هر چه ما بدمست‌ها انجام دادیم، در نظر او با لطف و کرامتش زیبا و پسندیده به نظر آمد."],[202,"دفتر دانش ما جمله بشویید به می","که فلک دیدم و در قصد دل دانا بود","تمامی نوشته‌های علمی و علمی ما را با شراب بشویید، زیرا که من در دایره جادو و گردش آسمان، دانایی را دیدم که در پی دل و فهم بود."],[202,"از بتان آن طلب ار حسن شناسی ای دل","کاین کسی گفت که در علم نظر بینا بود","ای دل، اگر می‌خواهی زیبایی را بشناسی، از میان آن معشوقان طلب کن، چرا که کسی گفته است که او در علم و درک خود بینا و آگاه بود."],[202,"دل چو پرگار به هر سو دورانی می‌کرد","و اندر آن دایره سرگشته پابرجا بود","دل مانند پرگاری بود که به هر سمتی می‌چرخید و در آن دایره بی‌پایان، سرگشته و گیج مانده بود."],[202,"مطرب از درد محبت عملی می‌پرداخت","که حکیمان جهان را مژه خون پالا بود","مطرب (خواننده یا نوازنده) از شوق و درد عشق می‌نواخت و کاری انجام می‌داد که حتی حکیمان و دانشمندان دنیا را وادار به اشک و تأمل می‌کرد."],[202,"می‌شکفتم ز طرب زان که چو گل بر لب جوی","بر سرم سایه آن سرو سهی بالا بود","من از شادی و سرور به مانند گل که بر لب جوی می‌روید، می‌شکفتم؛ زیرا سایه آن سرو زیبا بر سرم بود و مرا خوشحال می‌کرد."],[202,"پیر گلرنگ من اندر حق ازرق‌پوشان","رخصت خبث نداد ار نه حکایت‌ها بود","یادآور می‌شود که پیر (مربی یا راهنما) من که لباس رنگارنگ دارد (در اینجا نشانه‌ای از زیبایی یا لطافت است)، اجازه نداد تا درباره کسانی که لباس آبی می‌پوشند (به طور ضمنی، افرادی که معمولا به آنها کینه یا خباثت نسبت داده می‌شود) بدگویی کنم، مگر اینکه داستان‌ها و حکایت‌های خاصی وجود داشت."],[202,"قلب اندوده حافظ بر او خرج نشد","کاین معامل به همه عیب نهان بینا بود","دل اندوهگین حافظ برای او (دوست یا معشوق) صرف نشد؛ زیرا این معلم (یا فرد صاحب‌نظر) به تمام عیب‌های پنهان آگاه بود."],[203,"یاد باد آن که نهانت نظری با ما بود","رقم مهر تو بر چهره ما پیدا بود","به یاد می‌آورم زمانی را که نگاه معنادار و پنهان تو به ما بود و رد و نشان عشق تو بر چهره ما آشکار بود."],[203,"یاد باد آن که چو چشمت به عتابم می‌کشت","معجز عیسویت در لب شکّرخا بود","به یاد می‌آورم زمانی که نگاه تو با عتاب و سرزنش به من می‌افتاد، همچون معجزه عیسی که دارد بر روی لب‌های شکرین می‌خندد."],[203,"یاد باد آن که صبوحی زده در مجلس انس","جز من و یار نبودیم و خدا با ما بود","یاد آن روزی بخیر که در می‌خانه، ما تنها بودیم و در جمع دوستان، فقط من و یارم بودیم و حضور خدا هم در کنارمان حس می‌شد."],[203,"یاد باد آن که رخت شمع طرب می‌افروخت","وین دل سوخته پروانه ناپروا بود","یاد آن زمان بخیر که چهره‌ات مانند شمعی نورافشانی می‌کرد و دل سوخته من همچون پروانه‌ای بود که بی‌پروا و بی‌توجه به آسیب‌ها به دور تو می‌چرخید."],[203,"یاد باد آن که در آن بزمگه خلق و ادب","آن که او خنده مستانه زدی صهبا بود","یاد می‌آورم که در آن مجلس که آراستگی و نزاکت حاکم بود، کسی که با خنده‌ای مستانه درخشید و شادی آورد، در واقع مشروب (صهبا) بود."],[203,"یاد باد آن که چو یاقوت قدح خنده زدی","در میان من و لعل تو حکایت‌ها بود","به یاد می‌آورم کسی را که مانند یاقوت در هنگام شادی و خنده، در دل من و لب‌های تو داستان‌ها و حکایت‌هایی به وجود آورد."],[203,"یاد باد آن که نگارم چو کمر بربستی","در رکابش مه نو پیک جهان‌پیما بود","یادآورم که در گذشته، وقتی محبوبم مانند کمربند بسته شد، در کنار او ماه نو، به عنوان همراه جهانگردی غریب وجود داشت."],[203,"یاد باد آن که خرابات‌نشین بودم و مست","وآنچه در مسجدم امروز کم است آنجا بود","به یاد می‌آورم که در میخانه به مستی و بی‌خیالی می‌گذراندم و هر چیزی که امروز در مسجد یا مکان مقدس کم است، در آنجا وجود داشت."],[203,"یاد باد آن که به اصلاح شما می‌شد راست","نظم هر گوهر ناسفته که حافظ را بود","به یاد دارم که زمانی به واسطه اصلاح شما، هر یک از رازهای پنهان و نادر به درستی بیان می‌شد و به نظم درمی‌آمد و این خاصیت حافظ بود."],[204,"تا ز میخانه و می نام و نشان خواهد بود","سر ما خاک ره پیر مغان خواهد بود","تا وقتی که از میخانه و نوشیدن شراب خبری باشد، سرنوشت ما مانند خاکی خواهد بود که در راه زرتشت افتاده است."],[204,"حلقه پیر مغان از ازلم در گوش است","بر همانیم که بودیم و همان خواهد بود","پیروی از زرتشت کامل از ابتدا در ضمیر من بوده و همچنان خواهد بود. این پیر فرزانه می تواند حضرت زرتشت باشد که در واژه هم پیشوا و رهنمای موبدان زرتشتی ست."],[204,"بر سر تربت ما چون گذری همّت خواه","که زیارتگه رندان جهان خواهد بود","زمانی که بر سر قبر ما عبور می‌کنی، برای ما آرزویی کن، زیرا آنجا به مکان زیارت دوستان و عاشقان تبدیل خواهد شد."],[204,"برو ای زاهد خودبین که ز چشم من و تو","راز این پرده نهان است و نهان خواهد بود","ای زاهد مغرور، دور برو؛ زیرا رازی که در دل من و تو نهفته است، از نگاه ما پنهان است و همیشه همین‌طور باقی خواهد ماند."],[204,"ترک عاشق‌کش من مست برون رفت امروز","تا دگر خون که از دیده روان خواهد بود","معشوق من، امروز مست (و مستانه) به بیرون از خانه (به کوی و گذر و میان مردم) رفت. یعنی چشمان چند نفر با دیدن زیبایی و دل‌فریبی او خون بار خواهد شد؟"],[204,"چشمم آن دم که ز شوق تو نهد سر به لحد","تا دم صبح قیامت نگران خواهد بود","چشم من در آن لحظه که به خاطر شوق تو سرم را به خاک می‌گذارم، تا روز قیامت بیدار و نگران خواهد بود."],[204,"بخت حافظ گر از این گونه مدد خواهد کرد","زلف معشوقه به دست دگران خواهد بود","اگر بخت حافظ اینگونه یاری کند حافظ داره به اقبال بد خودش طعنه میزنه معشوقه اش به دست دیگران خواهد افتاد"],[205,"پیش از اینت بیش از این اندیشه عشّاق بود","مهرورزی تو با ما شهره آفاق بود","پیش از این، بیشتر به فکر عاشقانت بودی _ مهرورزی تو با ما در همه جا مشهور بود"],[205,"یاد باد آن صحبت شب‌ها که با نوشین لبان","بحث سرّ عشق و ذکر حلقه عشّاق بود","به یاد می‌آورم آن گفت‌وگوهای شبانه را که با لب‌های شیرین تو در مورد راز عشق و ذکر حلقه عاشقان صحبت می‌کردیم."],[205,"پیش از این کاین سقف سبز و طاق مینا برکشند","منظر چشم مرا ابروی جانان طاق بود","پیش از این که سقف سبز و مینائی (آبی) آسمان را برافرازند (پیش از خلقت زمین و آسمان) - طاق ایوان من ابروی جانان (معشوق) بود"],[205,"از دم صبح ازل تا آخر شام ابد","دوستی و مهر بر یک عهد و یک میثاق بود","از آغاز خلقت تا پایان زمان، دوستی و عشق در یک پیمان و قراردادی برقرار بوده است."],[205,"سایه معشوق اگر افتاد بر عاشق چه شد؟","ما به او محتاج بودیم او به ما مشتاق بود","اگر سایه معشوق بر عاشق بیفتد، چه اتفاقی می‌افتد؟ ما به معشوق نیاز داشتیم، اما او به ما تمایل داشت."],[205,"حسن مه رویان مجلس گرچه دل می‌برد و دین","بحث ما در لطف طبع و خوبی اخلاق بود","زیبایی چهره‌های زیبا در مجلس هرچند دل‌ربا بود، ولی موضوع اصلی ما در مورد مهربانی و خوش‌اخلاقی بود."],[205,"بر در شاهم گدایی نکته‌ای در کار کرد","گفت بر هر خوان که بنشستم خدا رزّاق بود","در کنار درگاه شاه، گدایان نکته‌سنجی می‌کردند و می‌گفتند هر بار که بر سفره‌ای نشستم، خداوند روزی‌دهنده بود."],[205,"رشته تسبیح اگر بگسست معذورم بدار","دستم اندر دامن ساقی سیمین ساق بود","اگر رشته تسبیح (که نماد دعا و عبادت است) پاره شده باشد، لطفا مرا عذر ببخش، چون من در این حال، دستم را در دامن ساقی خوش قد و قامت (یعنی معشوق یا محبوب) قرار داده‌ام."],[205,"در شب قدر ار صبوحی کرده‌ام، عیبم مکن","سرخوش آمد یار و جامی بر کنار طاق بود","اگر در شب قدر شراب صبوحی خورده ام، بر من خرده مگیر _ یار شادمان آمد و جام می هم بر طاقچه بود"],[205,"شعر حافظ در زمان آدم اندر باغ خلد","دفتر نسرین و گل را زینت اوراق بود","شعر حافظ در زمان آدم در باغ بهشت، زینت بخش برگ های نسرین و گل سرخ بود"],[206,"یاد باد آن که سر کوی توام منزل بود","دیده را روشنی از خاک درت حاصل بود","به یاد می‌آورم که در مسیر کوی تو، خانه‌ام بود. روشنی چشمم از خاک در تو به دست آمده بود."],[206,"راست چون سوسن و گل از اثر صحبت پاک","بر زبان بود مرا آن‌چه تو را در دل بود","این بیت بیان می‌کند که سخنان من به مانند سوسن و گل، پاک و زیبا هستند؛ زیرا تحت تأثیر صحبت با تو، احساسات و افکار واقعی‌ام بر زبانم جاری شده است. آنچه در دل تو می‌گذرد نیز به وضوح بیان می‌شود."],[206,"دل چو از پیر خرد نقل معانی می‌کرد","عشق می‌گفت به شرح آن‌چه بر او مشکل بود","وقتی دل من از پیر حکمت، داستان‌ها و معانی را نقل می‌کرد، عشق می‌گفت درباره‌ی مسائلی که برای او دشوار بود."],[206,"آه از آن جور و تطاول که در این دامگه است","آه از آن سوز و نیازی که در آن محفل بود","حسرت و تاسف از بی‌عدالتی و ظلمی که در این مکان وجود دارد، و همچنین از درد و نیاز عمیقی که در آن جمع احساس می‌شود، سر می‌زنم."],[206,"در دلم بود که بی‌دوست نباشم هرگز","چه توان کرد؟ که سعی من و دل باطل بود","در قلبم همیشه این احساس بود که هیچ‌گاه بی‌دوست نباشم، اما چه کار می‌توانم بکنم؟ زیرا تلاش من و دل‌باختگی‌ام همه بی‌نتیجه بود."],[206,"دوش بر یاد حریفان به خرابات شدم","خم می دیدم، خون در دل و پا در گل بود","شب گذشته به یاد دوستانم به میخانه رفتم. در آنجا ظرف شراب را دیدم که دل پر خون داشت (کنایه از این است که خمره پر از شراب بود) و پایش در گل فرو رفته بود"],[206,"بس بگشتم که بپرسم سبب درد فراق","مفتی عقل در این مسأله لایعقل بود","طولانی گشتم و سوال کردم که چرا جدایی در این موضوع باعث ناراحتی است، ولی عقل عالم در درک این مسأله ناتوان و بی‌خبر بود."],[206,"راستی خاتم فیروزه بواسحاقی","خوش درخشید ولی دولت مستعجل بود","راستی انگشتر فیروزه‌ای بواسحاقی (مردی معروف) به زیبایی درخشید، اما خوشبختی و کامیابی در این دنیا بسیار زودگذر و ناپایدار بود."],[206,"دیدی آن قهقهه کبک خرامان حافظ؟","که ز سرپنجه شاهین قضا غافل بود","دیدی آن صدای شاد و خوش کبک‌های زیبا را که از سرنوشت و خطرات ناآگاه بودند؟"],[207,"خستگان را چو طلب باشد و قوّت نبود","گر تو بیداد کنی شرط مروّت نبود","اگر خستگان خواهان چیزی باشند اما نیروی لازم را نداشته باشند، اگر تو به ستمگری ادامه دهی، منش و رفتار انسانی نخواهد بود."],[207,"ما جفا از تو ندیدیم و تو خود نپسندی","آنچه در مذهب ارباب طریقت نبود","ما از تو بدی و ظلمی ندیدیم و خودت هم نمی‌پسندی آنچه در دین و مذهب عارفان و سالکان به حقیقت پذیرفته نشده است."],[207,"خیره آن دیده که آبش نبرد گریه عشق","تیره آن دل که در او شمع محبت نبود","چشمی که محبت را احساس نکند، نمی‌تواند برای عشق بگرید و دلی که در آن شعله‌ی محبت وجود ندارد، دل تیره و تار است."],[207,"دولت از مرغ همایون طلب و سایه او","زان که با زاغ و زغن شهپر دولت نبود","سعادت و خوشبختی را از پرنده خوش‌خوشی (مرغ همایون) بخواه و سایه‌اش را جست‌وجو کن، زیرا در کنار زاغ و غاز (زغن) نشانی از این سعادت نمی‌توان یافت."],[207,"گر مدد خواستم از پیر مغان عیب مکن","شیخ ما گفت که در صومعه همّت نبود","اگر از پیر مغان (نسلی از عارفان) کمک و یاری خواستم، ایرادی به من نگیر؛ چون شیخ ما گفته که در صومعه (مکان عبادت) همت و تلاش درستی وجود ندارد."],[207,"چون طهارت نبود کعبه و بتخانه یکیست","نبود خیر در آن خانه که عصمت نبود","وقتی که پاکی وجود نداشته باشد، کعبه (جای مقدس مسلمانان) و بتخانه (محل worship بت‌پرستان) هیچ تفاوتی ندارند. در خانه‌ای که عفت و پاکدامنی وجود ندارد، خیر و خوبی نخواهد بود."],[207,"حافظا علم و ادب ورز که در مجلس شاه","هر که را نیست ادب لایق صحبت نبود","حافظ می‌گوید ای حافظ، علم و ادب را بیاموز و در مجلس شاه حاضر شو، زیرا کسی که ادب مناسب گفت‌وگو را ندارد، جایی در صحبت ندارد."],[208,"قتل این خسته به شمشیر تو تقدیر نبود","ور نه هیچ از دل بی‌رحم تو تقصیر نبود","اینکه من اینقدر خسته و رنجور شدم، سرنوشت نمی‌خواست که تو با شمشیرت مرا بکشی، و اگر بخواهیم واقع‌بین باشیم، هیچ تقصیر از دل بی‌رحم تو نیست."],[208,"من دیوانه چو زلف تو رها می‌کردم","هیچ لایق‌ترم از حلقه زنجیر نبود","اگر من عاشق دیوانه دست از زلف تو برمیداشتم، هیچ چیز جز حلقه زنجیر لایق من نبود.اگر من ازعشق تو خسته میشدم لایق پستیهای دنیا میشدم."],[208,"یا رب این آینه حسن چه جوهر دارد؟","که در او آه مرا قوّت تأثیر نبود","پروردگارا، این آینه زیبایی چه خاصیتی دارد که در آن، آه و ناله‌های من تأثیر ندارند؟"],[208,"سر ز حسرت به در میکده‌ها برکردم","چون شناسای تو در صومعه یک پیر نبود","از حسرت، سرم را به سوی در میکده‌ها بلند کردم، زیرا در صومعه، هیچ پیر و زاهدی تو را نشناخت."],[208,"نازنین‌تر ز قدت در چمن ناز نرست","خوش‌تر از نقش تو در عالم تصویر نبود","هیچ موجودی در چمن‌های زیبا به اندازه قامت تو دل‌ربا نیست و هیچ تصویری در جهان زیباتر از چهره تو دیده نمی‌شود."],[208,"تا مگر همچو صبا باز به کوی تو رسم","حاصلم دوش به جز ناله شبگیر نبود","امیدوارم که دوباره مانند نسیم صبحگاهی به خانه‌ات بیایم، زیرا شب گذشته جز ناله و گریه چیزی به دست نیاوردم."],[208,"آن کشیدم ز تو ای آتش هجران که چو شمع","جز فنای خودم از دست تو تدبیر نبود","عذابی که از دوری تو به دلم رسید، مانند آتش سوزانی است که فقط مرا به نابودی و فنا می‌کشاند و راهی برای نجات از آن وجود ندارد."],[208,"آیتی بود عذاب انده حافظ بی تو","که بر هیچ کسش حاجت تفسیر نبود","معنی بیت بر اساس نسخی که این گونه ضبط کرده اند آیتی بد ز عذاب اندوه حافظ ... چنین می شود: اندوه حافظ در دوری تو چنان شدید بود که نشانه ای از عذاب الهی است و چنان آشکار که نزد هیچکس نیاز به شرح و تفسیر ندارد"],[209,"دوش در حلقه ما قصّه گیسوی تو بود","تا دل شب سخن از سلسله موی تو بود","دیشب در جمع ما، صحبت از موهای تو بود و تا نیمه‌های شب، درباره رشته‌های گیسوی تو گفتگو می‌کردیم."],[209,"دل که از ناوک مژگان تو در خون می‌گشت","باز مشتاق کمان‌خانه ابروی تو بود","دل من به خاطر مژگان زیبا و فریبنده تو در حال آسیب و خونریزی بود، اما همچنان مشتاق و yearning به کمان‌خانه ابروی تو باقی ماند."],[209,"هم عفاالله صبا کز تو پیامی می‌داد","ور نه در کس نرسیدیم که از کوی تو بود","بادی که از سوی تو پیغام می‌آورد، ما را مورد عفو قرار داد، وگرنه هیچ‌کس به ما نرسید که از مسیر تو باشد."],[209,"عالم از شور و شر عشق خبر هیچ نداشت","فتنه‌انگیز جهان غمزه جادوی تو بود","عالم هیچ اطلاعی از هیجان و آشفتگی ناشی از عشق نداشت، زیرا جذابیت و فریبندگی تو، ای معشوق، عامل تمام فتنه‌ها و مشکلات این دنیا بود."],[209,"من سرگشته هم از اهل سلامت بودم","دام راهم شکن طرّه هندوی تو بود","من که در دنیای عشق و عاشقی سرگردان هستم، در اصل از اهل سلامت و خوبان بودم، اما گرفتار دام زندگی‌ام شده‌ام که به خاطر زیبایی و جذابیت موی تو پدید آمده است."],[209,"بگشا بند قبا تا بگشاید دل من","که گشادی که مرا بود ز پهلوی تو بود","دل من به خاطر نزدیکی و ارتباطی که با تو دارم، آزاد و شاد می‌شود. پس باید دکمه‌های لباس‌ات را باز کنی تا این حس آزادگی و شادی در من بیشتر شود."],[209,"به وفای تو که بر تربت حافظ بگذر","کز جهان می‌شد و در آرزوی روی تو بود","به خاطر وفای تو که بر مزار حافظ می‌گذری، چون او در آرزوی دیدار روی تو از دنیا رفت."],[210,"دوش می‌آمد و رخساره برافروخته بود","تا کجا باز دل غمزده‌ای سوخته بود","دیشب می‌آمد و چهره‌اش برافروخته بود. معلوم نبود کجا دل چه کسی را به آتش زده. (خوشحالی از سوزاندن دل کسی چهره اش را درخشان کرده. تشبیه شده به آتش واقعی)"],[210,"رسم عاشق‌کشی و شیوه شهرآشوبی","جامه‌ای بود که بر قامت او دوخته بود","فتانه بود. انگار برای آشوبگری و عاشق کشی زاده شده بود."],[210,"جان عشّاق سپند رخ خود می‌دانست","و آتش چهره بدین کار برافروخته بود","عاشقان می‌دانستند که زیبایی او مانند آتش است و چهره‌اش به شکلی است که حسرت و داغی را در دل‌ها برمی‌افروزد."],[210,"گر‌چه می‌گفت که زارت بکشم می‌دیدم","که نهانش نظری با من دلسوخته بود","هرچند او (عاشق) می‌گفت که می‌خواهم تو را بکشم، اما من می‌دیدم که در دل خود نگاهی به من، که در عشق رنج می‌برم، دارد."],[210,"کفر زلفش ره دین می‌زد و آن سنگین‌ دل","در پی‌اش مشعلی از چهره برافروخته بود","زلف‌های او مثل کفر (یعنی بی‌دینی) راهی را به سمت دین و ایمان می‌گشود و آن شخص سنگین‌دل در پی او، مشعلی از چهره‌اش می‌افروخت که نماد عشق و جذابیت او بود."],[210,"دل بسی خون به کف آورد ولی دیده بریخت","الله الله، که تلف کرد و که اندوخته بود؟","چه بسیار که دلم خون شد و از دیده خون گریستم. خدا میداند که کدام یکی اتلاف شد و کدام اندوخته شد؟ (دل خون شدن توشه‌ی آخرت شد یا به بی‌حاصلی خودم را آزار دادم. و همچنین برای اشکی خونین ریختن. )"],[210,"یار مفروش به دنیا که بسی سود نکرد","آن که یوسف به زر ناسره بفروخته بود","یار را به دنیا نفروش، زیرا از این کار سودی به دست نمی‌آید. آن کسی که یوسف، پسر یعقوب، را به بهای ناچیز فروخت، هرگز به خوبی آن را درک نکرد."],[210,"گفت و خوش گفت برو خرقه بسوزان حافظ","یا رب این قلب‌شناسی ز که آموخته بود؟","چه زیبا گفت که برو و این خرقه (نوعی ردا و همزمان درجه‌ی معنوی مانند مقامات حوزوی امروزی فرضا) را بسوزان. خداوندا این شناخت تقلبی و اصلی را از کجا آموخته بود؟"],[211,"یک دو جامم دی سحرگه اتفاق افتاده بود","وز لب ساقی شرابم در مذاق افتاده بود","در سحرگاه دی، دو جام شراب نوشیدم که به‌طور ناگهانی به دستم آمد و طعم آن از لب ساقی به دستم رسیده بود."],[211,"از سر مستی دگر با شاهد عهد شباب","رجعتی می‌خواستم لیکن طلاق افتاده بود","از روی مستی، دوباره به یاد شاهد جوانی‌ام برگشتم، اما متوجه شدم که رابطه‌ام با او به پایان رسیده و جدایی پیش آمده است."],[211,"در مقامات طریقت هر کجا کردیم سیر","عافیت را با نظربازی فراق افتاده بود","در مراحل سیر و سلوک معنوی، هر جا که به آرامش و آسایش رسیدیم، متوجه شدیم که به خاطر دیدن زیبایی‌ها، از جدایی و غم فاصله گرفته‌ایم."],[211,"ساقیا جام دمادم ده که در سیر طریق","هر که عاشق‌وش نیامد در نفاق افتاده بود","ای ساقی، مدام برایم جام پر کن، چون در مسیر سیر و سلوک، هر کس که به عشق نرسد در فریب و نفاق گرفتار شده است."],[211,"ای معبّر مژده‌ای فرما که دوشم آفتاب","در شکرخواب صبوحی هم وثاق افتاده بود","ای تعبیرکننده خواب، خبر خوشی بده که دیشب آفتاب در خواب شیرین صبحگاهی با هم آمیخته شده بود."],[211,"نقش می‌بستم که گیرم گوشه‌ای زان چشم مست","طاقت و صبر از خم ابروش طاق افتاده بود","ولی می‌خواستم که جذبه و زیبایی آن چشم مست را درک کنم، اما به‌قدری قدرت و تاثیر ابرویش بیشتر از صبر و طاقت من بود که هر دو از دست رفته و فرسوده شده بود."],[211,"گر نکردی نصرت دین، شاه یحیی، از کرم","کار ملک و دین ز نظم و اتّساق افتاده بود","اگر به یاری دین نپرداختی، شاه یحیی، به خاطر لطف تو کار پادشاهی و دین از نظم و هماهنگی خارج شده بود."],[211,"حافظ آن ساعت که این نظم پریشان می‌نوشت","طایر فکرش به دام اشتیاق افتاده بود","حافظ در اینجا اشاره می‌کند که در لحظه‌ای که این شعر نامنظم را می‌نوشت، فکر و اندیشه‌اش به شدت تحت تأثیر اشتیاق و تمایل‌هایش قرار داشت."],[212,"گوهر مخزن اسرار همان است که بود","حقّه مهر بدان مهر و نشان است که بود","گوهر پنهانی که در دل اسرار است همان اصلی است که همیشه بوده و پیوسته در آن نهفته است. نشانه و علامت عشق نیز همانند سابق، آن مهر و نشان خاص است که بر دل‌ها می‌افتد."],[212,"عاشقان زمره ارباب امانت باشند","لاجرم چشم گهربار همان است که بود","عاشقان، از گروه افرادی هستند که به امانت‌داری معروفند. بنابراین، چشمان پر از اشک و زیبای آن‌ها همانند گذشته به یاد محبوبشان و مفاهیم عاشقانه باقی‌مانده است."],[212,"از صبا پرس که ما را همه شب تا دم صبح","بوی زلف تو همان مونس جان است که بود","از نسیم صبح بپرس که ما تا صبح همه‌جا بوی زلف تو همان‌گونه مونس جان ماست که همیشه بوده است."],[212,"طالب لعل و گهر نیست وگرنه خورشید","هم‌چنان در عمل معدن و کان است که بود","سختی و مشکلات در مسیر یافتن زیبایی و گنج‌های باارزش، همیشه وجود دارد و اگر کسی دنبال لعل (سنگ قیمتی) و گهر (مروارید) باشد، باید بداند که خورشید همیشه در جای خودش به‌عنوان منبع نور و انرژی وجود دارد. به عبارت دیگر، زیبایی و ارزش‌ها همیشه در دسترس هستند و کسی که خواهان آن‌هاست، باید سعی و تلاش کند."],[212,"کشته غمزه خود را به زیارت دریاب","زانکه بیچاره همان دل‌نگران است که بود","از ملامت چشمان زیبا و جذاب تو دل‌ پولادین و بی‌دفاع من به شدت آسیب دیده است. از تو می‌خواهم که به حال من که در عشق و غم تو گرفتارم، توجه و رسیدگی کنی."],[212,"رنگ خون دل ما را که نهان می‌داری","همچنان در لب لعل تو عیان است که بود","رنگ خون دل ما که در درون پنهان نگه داشته‌ای، همچنان در لب‌های سرخ تو آشکار و واضح است."],[212,"زلف هندوی تو گفتم که دگر ره نزند","سال‌ها رفت و بدان سیرت و سان است که بود","من به زلف‌های سیاه و جذاب تو اشاره کردم و گفتم که دیگر این زلف‌ها نخواهد رفت. سال‌ها گذشته و به یاد آن زلف‌ها همانگونه و با همان زیبایی قبلی باقی مانده‌اند."],[212,"حافظا بازنما قصه خونابه چشم","که بر این چشمه همان آب روان است که بود","حافظ می‌گوید دوباره داستان اشک‌های خونین را اظهار کن، زیرا در این چشمه، همان آب زلال و جاری اولیه وجود دارد."],[213,"دیدم به خواب خوش که به دستم پیاله بود","تعبیر رفت و کار به دولت حواله بود","در خواب خوشی دیدم که پیاله‌ای در دستم بود، آن خواب تعبیر شد و در آن سرنوشت من به قضا و قدر سپرده شد."],[213,"چل سال رنج و غصّه کشیدیم و عاقبت","تدبیر ما به دست شراب دوساله بود","ما چهل سال زحمت و غم متحمل شدیم، و در نهایت، چاره‌ ما در یک شیشه شراب دوساله است."],[213,"آن نافه مراد که می‌خواستم ز بخت","در چین زلف آن بت مشکین کلاله بود","ان مقصود خوشبو که از سرنوشت می‌خواستم، در پیچ و خم همان گیسوی مجعد مشکی معشوق بود"],[213,"از دست برده بود خمار غمم سحر","دولت مساعد آمد و می در پیاله بود","از غمگساری تا سحر به خماری افتاده بودم که شرایط که شرایط به کام من شد و پیاله‌ام پر می بود"],[213,"بر آستان میکده خون می‌خورم مدام","روزیّ ما ز خوان قدر این نواله بود","در آستانه میکده، دائما در حال دردسر و رنج هستم، زیرا روزی ما از دسترنج و کرم قدری است که از آن بهره‌مند می‌شوم."],[213,"هر کو نکاشت مهر و ز خوبی گلی نچید","در رهگذار باد نگهبان لاله بود","هر کسی که محبت نکارد و از زیبایی‌ها بهره‌ای نبرد، در مسیر زندگی‌اش مانند نگهبان یک لاله خواهد بود که بی‌ثمر و بی‌فایده است."],[213,"بر طرف گلشنم گذر افتاد وقت صبح","آن دم که کار مرغ سحر آه و ناله بود","در صبحی که صدای مرغ سحر در حال ناله و زاری بود، بر کنار گلستان من گذر افتاد."],[213,"دیدیم شعر دلکش حافظ به مدح شاه","یک بیت از این قصیده به از صد رساله بود","در این بیت، شاعر به زیبایی و تاثیرگذاری شعر خود اشاره می‌کند و می‌گوید که یک بیت از شعر دلنشین او درباره مدح شاه از صد رساله دیگر بهتر و ارزشمندتر است."],[213,"آن شاه تندحمله که خورشید شیرگیر","پیشش به روز معرکه کمتر غزاله بود","آن شاه تندخو و شجاع، که مانند خورشید درخشنده و جذاب است، در میدان نبرد آن‌قدر قوی و نیرومند است که گویا جلوه روز، حتی کمتر از زیبایی یک غزال به نظر می‌رسد."],[214,"به کوی میکده یا رب سحر چه مشغله بود؟","که جوش شاهد و ساقی و شمع و مشعله بود","در کوی میکده، ای خدا، چه شغل و مشغله‌ای وجود داشت که همه چیز به خاطر شور و شوق معشوق، شراب و ساقی و نور شمع و شعله به جوش و خروش درآمده بود؟"],[214,"حدیث عشق که از حرف و صوت مستغنیست","به ناله دف و نی در خروش و ولوله بود","سخن عشق آن‌قدر عمیق و فراتر از کلمات و صداهاست که فقط با صدای دف و نی و ناله‌های آن‌ها بیان می‌شود و حالتی پرشور و پرهیاهو ایجاد می‌کند."],[214,"مباحثی که در آن مجلس جنون می‌رفت","ورای مدرسه و قال و قیل مسأله بود","در آن مجلس دیوانگی، مباحثی رد و بدل می‌شد که فراتر از آموزه‌های رسمی و حرف‌های مرسوم بود."],[214,"دل از کرشمه ساقی به شکر بود ولی","ز نامساعدی بختش اندکی گله بود","دل به خاطر ناز و کرشمه ساقی شکرگزار بود، اما به دلیل بدبیاری و دشواری‌های سرنوشتش کمی گله و شکایت داشت."],[214,"قیاس کردم و آن چشم جادوانه مست","هزار ساحر چون سامریش در گله بود","چشمان زیبا و جادوی معشوق را با چشمان هزار ساحر مقایسه کردم، زیرا جذابیت و تاثیرگذاری آنها به حدی بود که می‌توانست تمام کسانی که در دام السحر هستند را مجذوب کند."],[214,"بگفتمش به لبم بوسه‌ای حوالت کن","به خنده گفت کی‌ات با من این معامله بود؟","به محبوبم گفتم یک بوسه به لبم بده، ولی او با خنده واکنش نشان داد و گفت: چه زمانی من با تو چنین توافقی کرده بودم؟"],[214,"ز اخترم نظری سعد در ره است که دوش","میان ماه و رخ یار من مقابله بود","از نجوم و وضعیت‌های اخترشناس، نشان می‌دهد که شانس و سعادت به من روی آورده است، زیرا دیشب در میان زیبایی ماه و چهره دوست من معرکه‌ای برپا بود."],[214,"دهان یار که درمان درد حافظ داشت","فغان که وقت مروّت چه تنگ حوصله بود","می‌گوید که دهان یار درمانی برای دردهای حافظ دارد و او ناله می‌کند که زمان محبت و مهربانی بسیار تنگ و اندک است."],[215,"آن یار کز او خانه ما جای پری بود","سر تا قدمش چون پری از عیب بری بود","آن محبوبی که با حضورش خانه ما همچون جایگاه فرشتگان و پریان شده بود، از سر تا پا زیبا و بی‌عیب و نقص بود."],[215,"دل گفت فروکش کنم این شهر به بویش","بیچاره ندانست که یارش سفری بود","دلم خیال کرد که به امید حضور و بوی خوش محبوب، در این شهر اقامت می‌کنم و زندگی‌ام را با او می‌گذرانم؛ اما بیچاره نمی‌دانست که محبوب قصد سفر دارد و ماندنی نیست."],[215,"تنها نه ز راز دل من پرده برافتاد","تا بود فلک، شیوه او پرده‌دری بود","تنها راز دل من نبود که آشکار شد؛ از زمانی که آسمان و روزگار وجود داشته‌اند، شیوه و رسم محبوب این بوده که پرده از رازها بردارد و اسرار را آشکار کند."],[215,"منظور خردمند من آن ماه که او را","با حسن ادب شیوه صاحب‌نظری بود","آن ماه‌رویی که منظور خردمند من به او توجه داشت، کسی بود که علاوه بر زیبایی، از ادب و بینش و آگاهی نیز برخوردار بود."],[215,"از چنگ منش اختر بدمهر به در برد","آری چه کنم؟ دولت دور قمری بود","ستاره بداقبال و ناسازگار، محبوب را از چنگ من بیرون برد. چه می‌توانستم بکنم؟ گویا بخت و اقبال من چنین بود و گردش روزگار به سود من نمی‌چرخید."],[215,"عذری بنه ای دل، که تو درویشی و او را","در مملکت حسن سر تاجوری بود","ای دل، برای رفتن محبوب عذری پیدا کن و او را سرزنش نکن؛ زیرا تو درویش و بی‌چیز بودی و او در سرزمین زیبایی، پادشاه و صاحب مقام بود."],[215,"اوقات خوش آن بود که با دوست به سر رفت","باقی همه بی‌حاصلی و بی‌خبری بود","روزگار خوش و ارزشمند، همان زمانی بود که در کنار دوست گذشت؛ باقی عمر، جز بیهودگی و غفلت و بی‌خبری چیزی نبود."],[215,"خوش بود لب آب و گل و سبزه و نسرین","افسوس که آن گنج روان رهگذری بود","چه خوش و دل‌انگیز بود آن روزهایی که کنار آب و گل و سبزه و گل نسرین می‌گذشت؛ افسوس که آن گنج گران‌بها و محبوب زنده و روان، مسافری گذرا بود و ماندگار نشد."],[215,"خود را بکش ای بلبل از این رشک که گل را","با باد صبا وقت سحر جلوه‌گری بود","ای بلبل، از شدت حسادت و اندوه، خودت را بکش؛ زیرا گل در سپیده‌دم با وزش نسیم صبا، جلوه‌گری و زیبایی می‌کرد و تو شاهد این زیبایی و هم‌نشینی بودی."],[215,"هر گنج سعادت که خدا داد به حافظ","از یمن دعای شب و ورد سحری بود","هر بهره و گنج خوشبختی که خداوند به حافظ عطا کرد، به برکت دعاهای شبانه و ذکرهایی بود که در سحرگاه بر زبان می‌آورد."],[216,"مسلمانان مرا وقتی دلی بود","که با وی گفتمی گر مشکلی بود","ای مسلمانان، من زمانی دلی (یاری) داشتم، اگر مشکلی داشتم با‌ او میگفتم"],[216,"به گردابی چو می‌افتادم از غم","به تدبیرش امید ساحلی بود","وقتی در میان مشکلات و غم‌ها غوطه‌ور می‌شدم، تنها امیدم به تدبیر او بود که مانند ساحلی، مرا از آن گرداب نجات دهد."],[216,"دلی همدرد و یاری مصلحت بین","که استظهار هر اهل دلی بود","دلی که همدرد و یاری‌گر است، در واقع نشانه خرد و مصلحت‌سنجی است و به نوعی به همدلی و حمایت از دیگران برمی‌گردد؛ این دل، پناهی برای هر کسی است که دلی به درد می‌زند."],[216,"ز من ضایع شد اندر کوی جانان","چه دامنگیر یا رب منزلی بود","من در کوی محبوب از دست رفته‌ام و این واقعیت چقدر دردناک است، کاش که این منزلت و مقام از من سلب نمی‌شد و اینقدر دلمشغولی و گرفتاری برایم به وجود نمی‌آورد."],[216,"هنر بی‌عیب حرمان نیست لیکن","ز من محروم‌تر کی سائلی بود؟","هنر بدون نقص و عیب وجود ندارد، اما آیا کسی مانند من که از آن محرومم، وجود دارد که به شدت درخواست‌کننده و علاقه‌مند باشد؟"],[216,"بر این جان پریشان رحمت آرید","که وقتی کاردانی کاملی بود","با این روح آشفته و ناراحت رحمت بیاورید، زیرا زمانی که کاردانی در اوج بود، حالش این‌گونه نیست."],[216,"مرا تا عشق تعلیم سخن کرد","حدیثم نکته هر محفلی بود","عشق به من یاد داد که چگونه صحبت کنم و سخن بگویم، به‌طوری‌که حرف‌های من در هر جمع و محفلی برجسته و قابل توجه بود."],[216,"مگو دیگر که حافظ نکته‌دان است","که ما دیدیم و محکم جاهلی بود","نگو که حافظ در فهم نکته‌ها و معانی استاد است؛ ما او را دیدیم و فهمیدیم که در واقع جاهل و بی‌خبر است و به خوبی هنر سخنوری را یاد نگرفته."],[217,"در ازل هر کو به فیض دولت ارزانی بود","تا ابد جام مرادش همدم جانی بود","در آغاز، هر کسی که از نعمت‌های الهی برخوردار باشد، تا آخر عمر آرزوهایش همیشه با او خواهد بود و زندگی‌اش همراه با خواسته‌هایش خواهد گذشت."],[217,"من همان ساعت که از می خواستم شد توبه کار","گفتم این شاخ ار دهد باری، پشیمانی بود","در همان لحظه‌ای که از می (شراب) خواستم، توبه‌کار شدم و گفتم اگر این درخت (شاخ) بار بدهد، پشیمانی هم خواهد بود."],[217,"خود گرفتم کافکنم سجاده چون سوسن به دوش","همچو گل بر خرقه رنگ می مسلمانی بود؟","من خودم را مانند یک سوسن بر سجاده قرار دادم و حالا می‌پرسم آیا رنگ شراب بر لباس روحانی من (خرقه) مانند رنگ گل، اسلامی است؟"],[217,"بی چراغ جام در خلوت نمی‌یارم نشست","زان که کنج اهل دل باید که نورانی بود","در خلوت نمی‌توانم بدون نور شراب بنشینم، زیرا جایی که عارفان و اهل دل جمع می‌شوند باید روشن و نورانی باشد."],[217,"همت عالی طلب جام مرصّع گو مباش","رند را آب عنب یاقوت رمّانی بود","اگر اراده بلند داشته باشی، به دنبال نوشیدنی‌های گرانبها و باارزش باش، زیرا آنچه به خیال رند (آدم بی‌نزاکت) می‌رسد، به‌سادگی و ارزانی می‌تواند به دست بیاید و به‌خاطر مشابهت، نباید آن را دست‌کم گرفت."],[217,"گرچه بی‌سامان نماید کار ما، سهلش مبین","کاندر این کشور گدایی، رشک سلطانی بود","هرچند کار ما به نظر بی‌نظم و نامنظم می‌آید، اما نباید آن را ساده بگیری چون در این سرزمین، احساس کم‌توانی و عشق به مقام سلطنت در دل فقیران وجود دارد."],[217,"نیک نامی خواهی ای دل با بدان صحبت مدار","خودپسندی جان من برهان نادانی بود","ای دل، اگر می‌خواهی نیک‌نام شوی، با افراد بد معاشرت نکن. خودپسندی نمایانگر نادانی و ناآگاهی توست."],[217,"مجلس انس و بهار و بحث شعر اندر میان","نستدن جام می از جانان گران جانی بود","در مجلس خوش‌گذرانی و در بهار و گفتگوهای شاعرانه، نوشیدن شراب از محبوب بسیار باارزش و پرارزش است."],[217,"دی عزیزی گفت حافظ می‌خورد پنهان شراب","ای عزیز من! نه عیب آن به که پنهانی بود؟","حافظ به دوستش می‌گوید که شخصی به او می‌گوید که می‌نوشد، اما این کار را پنهانی انجام می‌دهد. او به دوستش می‌فهماند که عیب، بهتر است که پنهانی باشد."],[218,"کنون که در چمن آمد گل از عدم به وجود","بنفشه در قدم او نهاد سر به سجود","اکنون که گل در باغ به وجود آمده و از عدم به هستی رسیده، بنفشه به خاطر حضور او با احترام سر به زمین می‌ساید."],[218,"بنوش جام صبوحی به ناله دف و چنگ","ببوس غبغب ساقی به نغمه نی و عود","برخی به صبحانه می بنوشند و در کنار صدای دف و چنگ (سازها) شادمان می‌شوند. همچنین می‌گوید با بوسه‌ای به غبغب (پیشانی) ساقی (شراب‌فروش)، از نغمه نی و عود (سازها) لذت ببر."],[218,"به دور گل منشین بی‌شراب و شاهد و چنگ","که همچو روز بقا هفته‌ای بود معدود","در دور و بر گل، بدون شراب و معشوق و موسیقی نمانید، زیرا مانند روزی که پایدار است، زندگی فقط یک هفته طول می‌کشد."],[218,"شد از خروج ریاحین چو آسمان روشن","زمین، به اختر میمون و طالع مسعود","از خروج گل‌ها و خوشبوها، زمین مانند آسمان روشن شد و با ورود ستاره‌ای خوش‌یمن و طالع خوشبخت و شادی‌آور فرا رسید."],[218,"ز دست شاهد نازک‌عذار عیسی‌دم","شراب نوش و رها کن حدیث عاد و ثمود","از دست معشوقی با چهره نازک و زیبا مانند عیسی (پیامبر) که در دلها شور و شوق می‌آفریند، شراب بنوش و فراموش کن داستان اقوام عادی و ثمودی که به خاطر کفر و نافرمانی هلاک شدند."],[218,"جهان چو خلد برین شد به دور سوسن و گل","ولی چه سود که در وی نه ممکن است خلود","اگر جهان بهشت برین شود و پر از سوسن و گل باشد، چه فایده دارد که در آنجا امکان آرامش و سکون وجود نداشته باشد؟"],[218,"چو گل سوار شود بر هوا سلیمان‌وار","سحر که مرغ درآید به نغمه داوود","چون گل بر فراز هوا مانند سلیمان در صبحگاه سوار شود، مرغ به آواز داوود خوش‌نوا خواهد آمد."],[218,"به باغ، تازه کن آیین دین زردشتی","کنون که لاله برافروخت آتش نمرود","به باغ برو و راه و رسم دین زرتشتی را تازه کن، زیرا که لاله‌ها چنان شکوفه زده‌اند که گویی آتش نمرود را مجددا شعله‌ور ساخته‌اند."],[218,"بخواه جام صبوحی به یاد آصف عهد","وزیر ملک سلیمان، عماد دین، محمود","بیا به یاد آصف، وزیر سلیمان که در دربار او مقام و منزلتی داشت و در تدبیر امور کشور معروف بود، جام شرابی را طلب کن."],[218,"بود که مجلس حافظ به یمن تربیتش","هر آن چه می‌طلبد جمله باشدش موجود","مجلس حافظ به خاطر تربیتی که دارد، می‌تواند هر چیزی را که انسان بخواهد، در اختیارش قرار دهد."],[219,"از دیده خون دل همه بر روی ما رود","بر روی ما ز دیده چه گویم چه‌ها رود","از چشمان من غم و اندوهی به سوی شما می‌ریزد و من نمی‌دانم از این غمچه چیزهایی بر سر شما می‌آید."],[219,"ما در درون سینه هوایی نهفته‌ایم","بر باد اگر رود دل ما زان هوا رود","در درون سینه‌ ما آرزویی وجود دارد که اگر دل ما بر اثر آن آرزو به پرواز درآید، قطعا آن آرزو نیز به باد خواهد رفت."],[219,"خورشید خاوری کند از رشک جامه چاک","گر ماه مهرپرور من در قبا رود","اگر ماه محبوب من از پیش من برود، خورشید شرقی به خاطر حسادت، لباسی پاره خواهد کرد."],[219,"بر خاک راه یار نهادیم روی خویش","بر روی ما رواست اگر آشنا رود","ما صورت خود را بر خاک مسیر یار گذاشتیم و اگر معشوق ما قدم بگذارد و ما را ببیند، حق دارد که بر روی ما نظر کند."],[219,"سیل است آب دیده و هر کس که بگذرد","گر خود دلش ز سنگ بود هم ز جا رود","اشک و گریه مانند سیلی است که از چشمانم جاری می‌شود و هر کسی که از این مسیر عبور کند، حتی اگر دلش از سنگ باشد، تحت تأثیر قرار گرفته و دچار تغییر می‌شود."],[219,"ما را به آب دیده شب و روز ماجراست","زان رهگذر که بر سر کویش چرا رود","ما هر شب و روز در حال گریه و اندوه هستیم، زیرا کسی که به سر کوی او می‌رسد، ما را به یاد می‌آورد و باعث می‌شود که به خاطر او اشک بریزیم."],[219,"حافظ به کوی میکده دایم به صدق دل","چون صوفیان صومعه دار از صفا رود","حافظ به کوی میکده می‌گوید که همیشه با خلوص نیت مانند صوفیان با صفا به آنجا می‌رود."],[220,"چو دست بر سر زلفش زنم به تاب رود","ور آشتی طلبم با سر عتاب رود","هرگاه که دلم را بر سر زلف او بگذارم، حالتی شگفت و سرشار از شوق به من دست می‌دهد، و اگر بخواهم با او آشتی کنم، باز هم به همان حالت شگفت برمی‌گردد."],[220,"چو ماه نو ره بیچارگان نظّاره","زند به گوشه ابرو و در نقاب رود","وقتی که ماه نو، به خاطر نشان دادن مهر و محبتش به بیچارگان، با زیبایی خاصی در کنار ابرویش نظرها را جلب می‌کند، در عین حال پنهان و در نقاب می‌شود."],[220,"شب شراب خرابم کند به بیداری","وگر به روز شکایت کنم به خواب رود","شراب در شب مرا به حال خراب می‌آورد و اگر به روز از این وضع شکایت کنم، خواب نیست و آنچه می‌گویم به خواب می‌رود و در دنیای خیال محو می‌شود."],[220,"طریق عشق پرآشوب و فتنه است ای دل","بیفتد آن که در این راه با شتاب رود","طریق عشق همیشه پر از آشوب و درگیری است، ای دل، تنها کسی که در این مسیر با شتاب حرکت کند، دچار مشکل و گرفتاری خواهد شد."],[220,"گدایی در جانان به سلطنت مفروش","کسی ز سایه این در به آفتاب رود؟","کسی که در عشق محبوب خود مانند یک گدا به درگاه او می‌رود، نباید خود را به پادشاهی و مقام برتر بفروشد. آیا کسی وجود دارد که بتواند از سایه این در به نور و زندگی بهتر برود؟"],[220,"سواد نامه موی سیاه چون طی شد","بیاض کم نشود گر صد انتخاب رود","هرگاه که نوشته سیاه موهای کسی به پایان برسد، هرگز سفید نمی‌شود، حتی اگر صد انتخاب یا گزینش زیبا انجام شود."],[220,"حباب را چو فتد باد نخوت اندر سر","کلاه داریش اندر سر شراب رود","اگر باد از روی غرور حباب را بترکاند، حباب در حالی که کلاه (نوعی کلاه مخصوص) را به سر دارد، به سمت شراب می‌رود."],[220,"حجاب راه تویی حافظ از میان برخیز","خوشا کسی که در این راه بی‌حجاب رود","حافظ می‌گوید تو مانع رسیدن به حقیقت هستی، بنابراین باید کنار بروی. خوشا به حال کسی که در این مسیر بدون مانع حرکت کند و آزاد باشد."],[221,"از سر کوی تو هر کو به ملالت برود","نرود کارش و آخر به خجالت برود","هر کسی که از کوی تو بیافتد و دلتنگ شود، به نتیجه نخواهد رسید و در نهایت خود را شرمسار خواهد دید."],[221,"کاروانی که بود بدرقه‌اش حفظ خدا","به تجمّل بنشیند، به جلالت برود","کاروانی که خداوند از آن محافظت کند، با زینت و زیبایی سفر خود را آغاز می‌کند و با عظمتی به مقصد می‌رسد."],[221,"سالک از نور هدایت ببرد راه به دوست","که به جایی نرسد گر به ضلالت برود","سالکی که راه هدایت را در پیش گیرد، به محض اینکه قصد نزدیک شدن به دوست، یعنی خداوند، کند، هرچند ممکن است به بی‌راهی برود، به جایی نخواهد رسید."],[221,"کام خود آخر عمر از می و معشوق بگیر","حیف اوقات که یک سر به بطالت برود","در پایان عمر، بهتر است که لذت‌های خود را از شراب و عشق بگیریم، چون حیف است که عمر را فقط بیهوده و بی‌ثمر بگذرانیم."],[221,"ای دلیل دل گم‌گشته! خدا را مددی","که غریب ار نبرد ره، به دلالت برود","ای دلیل و راهنمای دل سرگشته! لطفا به من کمک کن که اگر غریب و بی‌کس نمانم، بتوانم به کمک تو راهی را پیدا کنم."],[221,"حکم مستوری و مستی همه بر خاتمت است","کس ندانست که آخر به چه حالت برود","سرنوشت پنهان و مستی تو همه به انگشتر تو وابسته است، هیچ‌کس نمی‌داند که در پایان با چه حالتی به سر می‌بری."],[221,"حافظ از چشمه حکمت به کف آور جامی","بو که از لوح دلت نقش جهالت برود","حافظ از چشمه حکمت، جامی به دست آورده است که با نوشیدن آن، نادانی و جهالت که بر دل او نقش بسته، از بین خواهد رفت."],[222,"هرگزم نقش تو از لوح دل و جان نرود","هرگز از یاد من آن سرو خرامان نرود","هيچ وقتم چهره تو از دل و روح و روانم بیرون نخواهد رفت ، هیچوقت از خاطرم اون یار خوش قد و قامت نجیب نخواهد رفت"],[222,"از دماغ من سرگشته خیال دهنت","به جفای فلک و غصه دوران نرود","در ذهن آشفته من فکر تو، با غم وناملایمات و فراز و نشیب روزگار هم از ذهنم بیرون نمیره."],[222,"در ازل بست دلم با سر زلفت پیوند","تا ابد سر نکشد، وز سر پیمان نرود","در سرآغاز آفرینش عشق و مهر تو در دلم جوونه زد، تا ابد هم ازت دل نخواهم برید و رهات نخواهم کرد"],[222,"هر چه جز بار غمت بر دل مسکین من است","برود از دل من وز دل من آن نرود","هر چیزی که به غیر از غم و غصه هات توی دل بینوای من هست، همشون از دلم بیرون میره اما غم عشقت از دلم بیرون نمیره."],[222,"آن چنان مهر توام در دل و جان جای گرفت","که اگر سر برود، از دل و از جان نرود","مهر تو چنان جایگاهی در دل و وجودم پیدا کرده، که اگه جونم رو هم از دست بدم مهرت از دل و جونم نخواهد رفت"],[222,"گر رود از پی خوبان دل من معذور است","درد دارد چه کند کز پی درمان نرود","اگه دلم دنبال خوش روها باشه عذر موجهی داره، چون چاره ای جز این برای تسکین درد عشق نداره"],[222,"هر که خواهد که چو حافظ نشود سرگردان","دل به خوبان ندهد وز پی ایشان نرود","هر کسی که میخواد مثل حافظ شوریده و سرگشته نشه، پا روی دلش بذاره و دل نده و دل نسپره."],[223,"خوشا دلی که مدام از پی نظر نرود","به هر درش که بخوانند بی‌خبر نرود","ای خوش آن دل که هر دم به دنبال تماشای معشوق و نظر کردن نرود. و بدون این که خبردار شود که جایی که او را فرا می‌خوانند و دعوت می‌کنند، به آن‌جا نرود. هرجایی نباشد"],[223,"طمع در آن لب شیرین نکردنم اولی","ولی چگونه مگس از پی شکر نرود","البته که بهتر است که من در آن لب شیرین طمع نکنم. اما امکان‌پذیر نیست. مگر می‌شود که مگس به دنبال شکر نرود؟"],[223,"سواد دیده غمدیده‌ام به اشک مشوی","که نقش خال توام هرگز از نظر نرود","با اشک نمی‌توانی سواد دیده (سیاهی چشم، مردمک چشم) من را پاک کنی و بشویی. چون که این سیاهی چشم غمدیده‌ی من، نقش خال تو است در چشمان من و این سیاهی هرگز از چشم من نخواهد ر"],[223,"ز من چو باد صبا بوی خود دریغ مدار","چرا که بی سر زلف توام به سر نرود","مثل باد صبا که از بوی زلف تو نصیب دارد، بوی زلف خودت را از من دریغ مکن. چون که بدون سر زلف تو، روزگار بر من نمی‌گذرد. (چرا باد صبا داشته باشد من نداشته باشم؟)"],[223,"دلا مباش چنین هرزه گرد و هرجایی","که هیچ کار ز پیشت بدین هنر نرود","به دل خودش نهیب می‌ زند. ای دل! به این شیوه، هرزه‌گرد و هرجایی مباش. چون که با این روش، هیچ کاری از پیش نمی‌توانی ببری"],[223,"مکن به چشم حقارت نگاه در من مست","که آبروی شریعت بدین قدر نرود","به چشم حقارت به من مست نگاه نکن! آبروی شریعت با این مقدار و با این تقدیر نخواهد رفت."],[223,"من گدا هوس سروقامتی دارم","که دست در کمرش جز به سیم و زر نرود","من بی مال و گدا، در هوس داشتن شخص سروقامتی ام که برای این که بتوان دست به کمرش برد باید سیم و زر داشت. و من از آن بی بهره ام. معنای دیگر: او بسیار ثروتمند است و تنها وقتی دست خود را به کمربند و شال خود می برد که سیم و زری از آن خارج کند. و من گدا نمی توانم به او برسم و هوس بیهوده ای دارم"],[223,"تو کز مکارم اخلاق عالمی دگری","وفای عهد من از خاطرت به در نرود","تو که کریم و بخشنده و با اخلاقی و از کرامت های اخلاقی بهره مندی، لطفا فراموش نکن که به عهدی که با من بستی وفا کنی"],[223,"سیاه نامه‌تر از خود کسی نمی‌بینم","چگونه چون قلمم دود دل به سر نرود","از خودم گناهکار تر و کسی که نامه اعمالش سیاهتر از من باشد، نمی بینم. حق بده که دود دل من و آه من و کدورت من به سر من بیاید. مانند قلم که دوده بر سر دارد"],[223,"به تاج هدهدم از ره مبر که باز سفید","چو باشه در پی هر صید مختصر نرود","سعی نکن که من را با تاج هدهد بفریبی و از راه ببری. چون که باز سفید پرنده ای است که مانند باشه که مرغ کوچکی است، به دنبال صید کوچک نمی رود. تاج هدهد در شان من نیست و برای من مختصر است. من هدف بزرگتری دارم."],[223,"بیار باده و اول به دست حافظ ده","به شرط آن که ز مجلس سخن به در نرود","بیار باده و آن را نخست به دست حافظ بده. به شرط این که این سخن و این راز از این مجلس بیرون نرود."],[224,"ساقی حدیث سرو و گل و لاله می‌رود","وین بحث با ثلاثه غسّاله می‌رود","ساقی صحبت از فصل بهار و سایه سرو و لاله و گلهای بستان آمده و زمان آنست که به آیین زردشتیان سه جام شراب برای صفای روح سر بکشیم"],[224,"می ده که نوعروس چمن حدّ حسن یافت","کار این زمان ز صنعت دلّاله می‌رود","به من می شراب بده چون گل و گیاه در این بهار زیبایی پیدا کرده‌اند و حالا زیبایی و جذابیت چمن به خاطر زحمت و هنر دلاله، که به کار خودش مشغول است، افزایش یافته است."],[224,"شکّرشکن شوند همه طوطیان هند","زین قند پارسی که به بنگاله می‌رود","همه طوطی‌ها و پرندگان هند از شیرینی و لذت این زبان فارسی که به بنگاله می‌رسد، شگفت‌زده و حیرت‌زده می‌شوند."],[224,"طیّ مکان ببین و زمان در سلوک شعر","کاین طفل یک شبه ره یک ساله می‌رود","در این بیت، شاعر اشاره به این دارد که در جهان شعر و ادب، این کودک (شعر) به‌سرعت و به آسانی می‌تواند به مقامات و درجات عالی برسد، طوری که گویا یک ساله را در یک شب طی می‌کند. این یعنی شعر می‌تواند به‌طور ناگهانی و شگفت‌انگیز رشد کند و به زیبایی‌های تازه‌ای دست یابد."],[224,"آن چشم جادوانه عابدفریب بین","کش کاروان سحر ز دنباله می‌رود","چشمان فریبنده و جادویی آن عابد، کاروان سحر و جادو را دنبال می‌کند."],[224,"از ره مرو به عشوه دنیا که این عجوز","مکّاره می‌نشیند و محتاله می‌رود","به زندگی دنیا وابسته و فریب‌خور آن نشو، زیرا این دنیا مانند زنی پیر و فریبنده است که تو را به دام می‌اندازد و فریب می‌دهد."],[224,"باد بهار می‌وزد از گلستان شاه","وز ژاله باده در قدح لاله می‌رود","باد بهاری از باغ شاه می‌وزد و از باران، شراب در لیوان لاله ریخته می‌شود."],[224,"حافظ ز شوق مجلس سلطان غیاث دین","غافل مشو که کار تو از ناله می‌رود","حافظ می‌گوید به خاطر شوق و عشق به حضور سلطان غیاث‌الدین، از یاد نبر که کار و زندگی تو تحت تأثیر ناله‌ها و غم‌ها می‌گذرد."],[225,"ترسم که اشک، در غم ما پرده‌در شود","وین راز سر به مهر به عالم سمر شود","می‌ترسم که اشک‌های من، پرده‌دری کند و راز ما را آشکار کند. (مردم اشک‌های من را ببینند و پی به غم و غصه‌ی من ببرند و و این راز پنهان به کل جهان معروف گردد. و مردم برای قصه‌های شب، آن را تعریف کنند."],[225,"گویند سنگ لعل شود، در مقام صبر","آری شود، ولیک به خون جگر شود","می‌گویند که اگر صبر و استقامت داشته باشی، می‌توان سنگ را به لعل تبدیل کرد، اما این کار فقط با تحمل درد و رنج عمیق امکان‌پذیر است. بله. سنگ لعل می‌شود. اما باید در خون جگر بخوابد تا لعل شود. صبر با خون جگر همراه است."],[225,"خواهم شدن به میکده گریان و دادخواه","کز دست غم خلاص من، آنجا مگر شود","می‌خواهم گریان و دادخواه به میکده بروم. گریه کنم و طلب عدالت و دادرسی کنم. شاید در آنجا از غم و اندوه من رهایی یابم."],[225,"از هر کرانه تیر دعا کرده‌ام روان","باشد کز آن میانه یکی کارگر شود","من از هر سو دعایم را روانه کرده‌ام. امیدوارم که یکی از آن‌ها کارساز باشد و یکی از تیرهای دعا که فرستاده‌ام، اثر کند"],[225,"ای جان حدیث ما بر دلدار بازگو","لیکن چنان مگو که صبا را خبر شود","ای جان، ماجرای عشق و دلم را برای محبوب بگو، اما طوری نگو که نسیم صبح از آن باخبر شود."],[225,"از کیمیای مهر تو زر گشت روی من","آری به یمن لطف شما خاک، زر شود","عشق تو چهره من را زرد کرده‌است. واقعا با مهربانی‌های شما، حتی خاک هم می‌تواند به طلا تبدیل شود. (انسان و چهره انسان از خاک ساخته شده و طلا نیز رنگ زرد دارد) به کنایه گفته است که من از غم عشق تو زردرو و رنجور شده‌ام. همرنگ طلا!"],[225,"در تنگنای حیرتم از نخوت رقیب","یا رب مباد آن که گدا معتبر شود","این نخوت و غرور و تکبر مراقب و نگهبان تو، من را به حیرت انداخته‌است. ای پروردگارا، نگذار که شخص بی‌ارزشی موقعیت و اعتبار پیدا کند."],[225,"بس نکته غیرحسن بباید که تا کسی","مقبول طبع مردم صاحب‌نظر شود","برای جلب توجه و پسند افراد با سلیقه و فرهیخته، باید نکات زیادی را در نظر داشت و به آن‌ها توجه کرد. تنها زیبایی کافی نیست."],[225,"این سرکشی که کنگره کاخ وصل راست","سرها بر آستانه او خاک در شود","این دیوارهای بلند و زهوار و سرکشی روی طاق‌های کاخ وصل، باعث می‌شود که همه سرها در برابر آستانه و ورودی این کاخ، به خاک بیفتند و تسلیم شوند."],[225,"حافظ چو نافه سر زلفش به دست توست","دم درکش ار نه باد صبا را خبر شود","ای حافظ! اگر سر زلف خوش عطر یار در دست تو است، حرفی نزن و سکوت کن و حتی نفس‌ات را هم بیرون نده. وگرنه باد صبا باخبر خواهد شد."],[226,"گرچه بر واعظ شهر این سخن آسان نشود","تا ریا ورزد و سالوس مسلمان نشود","هرچند می‌دانم که شنیدن این حرف برای واعظ شهر راحت نیست اما می‌گویم: تا زمانی که ریا و سالوس ورزد، مسلمان نخواهد شد."],[226,"رندی آموز و کرم کن که نه چندان هنر است","حیوانی که ننوشد می و انسان نشود","شاید در ادامه صحبتش به واعظ شهر: رندی بیاموز و بخشش و کرم کن! که این که مانند چارپایان زندگی کنی هنری نیست! باید می بنوشی تا از مرحله‌ی حیوانیت به مرحله انسانیت برسی!"],[226,"گوهر پاک بباید که شود قابل فیض","ور نه هر سنگ و گلی، لؤلؤ و مرجان نشود","لازمه‌ی توانایی و قابلیت جوشش و فیض یافتن، این است که گوهر پاک داشته باشی. وگرنه هر سنگ و گلی تبدیل به لولو و مرجان نمی‌شود. در اصل باید این قابلیت را داشت"],[226,"اسم اعظم بکند کار خود ای دل! خوش باش","که به تلبیس و حیل، دیو مسلمان نشود","اشاره به داستان دیو و سلیمان. خاتم و نگین انگشتری سلیمان نبی، مدتی به دست دیو افتاد و دیو با تلبیس و حیله، لباس سلیمان پوشید و خود را جای او جا زد. اما سلیمان با کمک اسم اعظم که دیو از آن بی بهره بود، جایگاه خود را باز یافت. شاعر می گوید که با حیله و تلبیس، دیو نمی‌تواند پیروز شود و اسم اعظم کار خود را خواهد کرد"],[226,"عشق می‌ورزم و امّید که این فنّ شریف","چون هنرهای دگر، موجب حرمان نشود","من به عشق ورزیدن مشغولم و ادامه می‌دهم و امیدوارم که این هنر والا، همانند دیگر هنرها، موجب پشیمانی و محرومیت و حسرت نشود."],[226,"دوش می‌گفت که «فردا بدهم کام دلت»","سببی ساز خدایا که پشیمان نشود","دیشب به من گفت که فردا کام و آرزوی تو را برآورده می‌کنم و تو را در آغوش خواهم کشید. خدایا! کارسازی کن که از انجام وعده‌ئی که داده پشیمان نشود."],[226,"حسن خلقی ز خدا می‌طلبم خوی تو را","تا دگر خاطر ما از تو پریشان نشود","از خدا می‌طلبم که اخلاق خوب به تو بدهد و خوی تو خوب شود تا دیگر خاطر من از تو پریشان نشود و از تو نرنجم"],[226,"ذره را تا نبود همّت عالی حافظ","طالب چشمه خورشید درخشان نشود","ذرّه و گرد و غبار هم به بالا می‌روند و می‌کوشند خود را به سمت چشمه‌ی خورشید برسانند. این از همّت عالی این ذره‌های کوچک است. پس تو نیز ای حافظ همّت کن. هرچند کوچکی و هدفت بزرگ است"],[227,"گر من از باغ تو یک میوه بچینم چه شود؟","پیش پایی به چراغ تو ببینم چه شود؟","چه اشکالی دارد اگر من از باغ تو یک میوه بچینم؟ اگر بخواهم با چراغ تو جلوی پای خودم را نگاه کنم، مگر چه اتفاقی می‌افتد؟"],[227,"یا رب اندر کنف سایه آن سرو بلند","گر من سوخته یک دم بنشینم چه شود؟","ای خدا! اگر منی که از گرما سوخته ام، یک لحظه در زیر سایه آن سرو بلند استراحت کنم، چه اتفاقی خواهد افتاد؟"],[227,"آخر ای خاتم جمشید همایون آثار","گر فتد عکس تو بر نقش نگینم چه شود؟","ای انگشتری جمشید همایون آثار! چه می‌شود اگر تصویر تو بر نقش نگین من بیافتد"],[227,"واعظ شهر چو مهر ملک و شحنه گزید","من اگر مهر نگاری بگزینم چه شود؟","وقتی واعظ شهر، مهر و محبت شاه و پاسبان را برگزیده است، اگر من محبت و عشق یک معشوق را انتخاب کنم، چه عیبی دارد؟"],[227,"عقلم از خانه به در رفت، وگر می این است","دیدم از پیش که در خانه دینم چه شود","عقل و شعور من از ذهنم خارج شده است، و اگر شراب این است و این خاصیت را دارد، از قبل دیدم که در خانه ایمان و دینم چه بلایی خواهد آمد."],[227,"صرف شد عمر گرانمایه به معشوقه و می","تا از آنم چه به پیش آید، از اینم چه شود؟","عمر ارزشمندم را صرف عشق و میگساری کردم، حالا نمی‌دانم چه بهره‌ای از این کار به دست می‌آورم و چه بر سرم خواهد آمد."],[227,"خواجه دانست که من عاشقم و هیچ نگفت","حافظ ار نیز بداند که چنینم چه شود؟","خواجه فهمید که من عاشق او هستم و چیزی نگفت. اگر حافظ هم بداند که من این گونه هستم، چه اتفاقی خواهد افتاد؟"],[228,"بخت از دهان دوست نشانم نمی‌دهد","دولت خبر ز راز نهانم نمی‌دهد","بخت و اقبال من، نشانه‌ئی نمی دهد که بتوانم به وصل دهان دوست امیدوار باشم. دولت و طالع من نیز خبری برای من ندارد که رازی نهانی در آن باش"],[228,"از بهر بوسه‌ای ز لبش جان همی‌دهم","اینم همی‌ستاند و آنم نمی‌دهد","حاضرم برای بوسه‌ئی از لب او، جان خودم را بدهم. اما او این (جان) را از من می‌ستاند، اما آن (بوسه) را به من نمی‌دهد"],[228,"مردم در این فراق و در آن پرده راه نیست","یا هست و پرده دار نشانم نمی‌دهد","در این فراق مردم. اما در آن پرده (خلوت یار) راه ندارم. انگاری که راهی در آن پرده برای من نیست. شاید هم راهی هست و پرده‌دار آن را به من نشان نمی‌دهد."],[228,"زلفش کشید باد صبا چرخ سفله بین","کانجا مجال باد وزانم نمی‌دهد","باد صبا توانست زلف یار را بکشد! ای لعنت به این چرخ سفله! که آنجا و در نزدیکی یار و زلف یار، حتا اندازه‌ی بادی که می‌وزد هم به من مجال و فرصت نمی‌دهد."],[228,"چندان که بر کنار چو پرگار می‌شدم","دوران چو نقطه ره به میانم نمی‌دهد","هر چقدر که مانند پرگار، بر کنار و محیط دایره می‌چرخم، دوران و روزگار، حتا مانند نقطه‌ئی که در میانه‌ی دایره است، راهی نمی‌دهد تا به میان (کمر) معشوق دست بیابم."],[228,"شکّر به صبر دست دهد عاقبت ولی","بدعهدی زمانه زمانم نمی‌دهد","می‌دانم که سرانجام بر اثر صبر، می‌توان به شکر دست یافت. اما بدعهدی زمانه، زمانی به من نمی‌دهد که بخواهم صبر کنم تا سرانجام به شکر دست یابم"],[228,"گفتم روم به خواب و ببینم جمال دوست","حافظ ز آه و ناله امانم نمی‌دهد","با خود گفتم که بخوابم و به خواب بروم، مگر در خواب بتوانم زیبایی یار را ببینم. اما این حافظ از بس آه و ناله کرد، نگذاشت بخوابم که لااقل در خواب یارم را ببینم"],[229,"اگر به باده مشکین دلم کشد، شاید","که بوی خیر ز زهد ریا نمی‌آید","اگر دل من به باده‌ی مشکین می‌کشد و هوس باده‌ی مشکین می‌کنم، حق دارد. سزاوار است. شایسته است. چون که از زهد ریایی، بوی خیر نمی‌آید. امیدی به خیر و صلاح از زهد ریایی نیست. (اما بوی باده خوش و دلکش است)"],[229,"جهانیان همه گر منع من کنند از عشق","من آن کنم که خداوندگار فرماید","اگر تمام مردم مرا از عشق باز دارند، من به آنچه خداوندگار (خدا، دلدار) فرمان داده عمل می‌کنم."],[229,"طمع ز فیض کرامت مبر که خلق کریم","گنه ببخشد و بر عاشقان ببخشاید","از فیض و جوشش بخشندگی و کرامت، قطع امید مکن و طمع مبر! زیرا که اخلاق کریم و بزرگوارانه، گناهان را می‌بخشد و بر عاشقان آمرزش و بخشایش دارد"],[229,"مقیم حلقه ذکر است دل بدان امّید","که حلقه‌ای ز سر زلف یار بگشاید","دل در میان حلقه‌ی ذاکران و جمع عبادت کنندگان مقیم شده و اقامت گزیده (در زلف یار) به این امید که بتواند از سر زلف یار، حلقه‌ئی بگشاید"],[229,"تو را که حسن خداداده هست و حجله بخت","چه حاجت است که مشّاطه‌ات بیاراید","تو که خود زیبایی طبیعی و خدادادی داری و بخت تو باز است، نیازی به آرایش و پیرایش دیگران نداری."],[229,"چمن خوش است و هوا دلکش است و می بی‌غش","کنون به جز دل خوش هیچ در نمی‌باید","چمن خوش است و مفرّح و زیباست و هوا دلپذیر و شراب هم خالص است، پس در این لحظه، جز خوشی دل هیچ چیز دیگری ارزش ندارد. دنبال چیزی جز دل خوش نباش."],[229,"جمیله‌ایست عروس جهان، ولی هش دار","که این مخدّره در عقد کس نمی‌آید","جهان، مانند عروس زیبایی است. اما آگاه باش و مراقب باش که این عروس زیبا، در عقد کسی در نخواهد آمد. یعنی به وصال او نخواهی رسید"],[229,"به لابه گفتمش ای ماهرخ چه باشد اگر","به یک شکر ز تو دلخسته‌ای بیاساید","با زاری و لابه به او گفتم: ای زیباروی! چه ایرادی دارد اگر با یک شکر از تو (کنایه از بوسه‌ئی از چهره‌ی یار)، کسی که دل آزرده و مجروحی دارد، به آسایش و راحتی برسد؟"],[229,"به خنده گفت که حافظ خدای را مپسند","که بوسه تو رخ ماه را بیالاید","با خنده گفت (پاسخ داد) که: ای حافظ! تو را به خدا قسم می‌دهم که راضی نشو و نخواه که بوسه‌ی تو صورت ماه را آلوده کند."],[230,"گفتم غم تو دارم گفتا غمت سرآید","گفتم که ماه من شو گفتا اگر برآید","به معشوقم گفتم: غم رسیدن به تو را دارم، پاسخ داد: روزی غمت به پایان خواهد رسید، به او گفتم بیا و ماه تابان زندگی من باش(معشوق من باش)، پاسخ داد: اگر امکان­پذیر باشد."],[230,"گفتم ز مهرورزان رسم وفا بیاموز","گفتا ز خوب‌رویان این کار کمتر آید","به او گفتم از مهربانان راه و رسم وفاداری و مهربانی را یاد بگیر، پاسخ داد: زیبارویان هرگز وفادار و مهربان نیستند.(کم‌گرفت: این کار کمتر آید؛ آرایه کم‌‌گرفت دارد، شاعر به جای اینکه بگوید هرگز از واژه کمتر بهره برده است.)"],[230,"گفتم که بر خیالت راه نظر ببندم","گفتا که شب‌رو است او از راه دیگر آید","به معشوقم گفتم: چشمانم را می‌بندم تا راه ورود خیال تو را بسته باشم، پاسخ داد: خیال من شبگردی چالاک و رند است و از راه دیگری وارد خواهد شد.(نکته: نکته فوق‌العاده در این بیت هوشمندی حضرت حافظ در رعایت ارتباط و تناسب بین بستن نظر و شب­رو بودن خیال معشوق است؛ چرا که وقتی چشم‌ها را ببندیم همه جا تاریک و ظلمانی می‌شود، به زیبایی هر چه تمامتر خیال معشوق به شب­رو تشبیه شده است؛ زیرا انسان شبگرد در شب بهتر راه خود را می‌یابد.)"],[230,"گفتم که بوی زلفت گمراه عالمم کرد","گفتا اگر بدانی هم اوت رهبر آید","به دلبندم گفتم: عطر گیسویت سبب گمراهی و رسوایی من در جهان شد، پاسخ داد: اگر نیک بدانی و آگاه باشی، همین عطر و بوی خوش سبب هدایت و راهبری تو خواهد شد.(هم اوت رهبر آید: او رهبر تو خواهد شد.)"],[230,"گفتم خوشا هوایی کز باد صبح خیزد","گفتا خنک نسیمی کز کوی دلبر آید","به او گفتم: هوایی که در هنگام صبح می‌وزد، چه اندازه خوش و نیکوست! پاسخم داد: خوشا نسیمی که از محله و کوی معشوق می‌آید."],[230,"گفتم که نوش لعلت ما را به آرزو کشت","گفتا تو بندگی کن کاو بنده‌پرور آید","به معشوقم گفتم: لب گوارا و سرخ تو ما را در حسرت یک بوسه کشت. پاسخ داد: تو راه و رسم بندگی را درست به جا بیاور او خود می‌داند چگونه بنده خود را پرورش دهد و مورد لطف و عنایت قرار دهد."],[230,"گفتم دل رحیمت کی عزم صلح دارد؟","گفتا مگوی با کس تا وقت آن درآید","به او گفتم: دل مهربان تو چه زمانی تصمیم دارد با من آشتی کند؟ پاسخ داد: بین خودمان باشد و این راز را به کسی نگو: هر زمان وقتش شد.(نکته: نکته جالب توجه در مصراع اول پارادوکس زیبایی است که حافظ در ارتباط با دل رحیم و قهر بودن معشوق مطرح کرده است!!!)"],[230,"گفتم زمان عشرت دیدی که چون سر آمد؟","گفتا خموش حافظ کـاین غصّه هم سر آید","به او گفتم: دیدی که چگونه روزگار شادی و خوش­گذرانی به پایان رسید. محبوبم پاسخ داد: حافظ خاموش باش و شکوه نکن چرا که این غم و انده نیز به پایان خواهد رسید."],[231,"بر سر آنم که گر ز دست برآید","دست به‌کاری زنم که غصّه سرآید","تصمیم دارم اگر بتوانم کاری کنم تا غم و غصه‌ها به پایان برسد"],[231,"خلوت دل نیست جای صحبت اضداد","دیو چو بیرون رود فرشته درآید","خلوت دل جای چیزهای ضد هم نیست؛ وقتی که (محبت و علاقه تو) به دیو از بین برود آنوقت است که دل تو شایسته و جایگاه فرشتگان می‌شود."],[231,"صحبت حکّام ظلمت شب یلداست","نور ز خورشید جوی بو که برآید","همنشینی با حاکمان مانند شبی دراز و سرد مثل یلداست؛ به‌دنبال خورشید باش تا نور و گرمی بیابی."],[231,"بر در ارباب بی‌مروّت دنیا","چند نشینی که خواجه کی به درآید","چرا این‌قدر چشم تو به دست صاحبان دنیا است؟ چرا اینقدر به دنیا طمع بسته‌ای که چه‌وقت به تو روی بنماید؟"],[231,"ترک گدایی مکن که گنج بیابی","از نظر رهروی که در گذر آید","اگر خواستار گنج (واقعی) هستی، درویشی و فقر و گدایی را ادامه بده و آن را ترک نکن (نا امید نشو) تا از یک نگاه سالکان آن کوی، به این گنج برسی."],[231,"صالح و طالح متاع خویش نمودند","تا که قبول افتد و که در نظر آید","افراد نیکوکار و بدکار کالای خود را عرضه کردند تا کالای چه کسی مورد قبول واقع شود"],[231,"بلبل عاشق تو عمر خواه که آخر","باغ شود سبز و شاخ گل به بر‌آید","ای بلبل که عاشق گلستان و گل‌های زیبا هستی؛ صبر کن و عمری بخواه تا بهار و فصل شاخه‌های سرسبز و گل‌ها را ببینی."],[231,"غفلت حافظ در این سراچه عجب نیست","هر که به میخانه رفت بی‌خبر آید","غفلت و ناهشیاری حافظ در این دنیا چیز عجیبی نیست؛ هرکسی به میخانه می‌رود مست می‌شود."],[232,"دست از طلب ندارم تا کام من برآید","یا تن رسد به جانان یا جان ز تن برآید","تا زمانی که به آرزوی من نرسم، دست از درخواست خود برنمی‌دارم؛ یا به معشوق می‌رسم و به وصالش می‌رسد، یا جانم از بدن جدا می‌شود."],[232,"بگشای تربتم را بعد از وفات و بنگر","کز آتش درونم دود از کفن برآید","پس از مرگم، قبرم را باز کن و ببین هنوز آتش عشق درونم شعله ور است و هرگز خاموش نخواهد شد و این آتش نمایان است"],[232,"بنمای رخ که خلقی واله شوند و حیران","بگشای لب که فریاد از مرد و زن برآید","به من چهره‌ات را نشان بده تا مردم از شگفتی به حالت دیوانه و حیران در بیایند و وقتی لب به سخن باز کنی، فریاد از مردان و زنان برآید."],[232,"جان بر لب است و حسرت در دل که از لبانش","نگرفته هیچ کامی جان از بدن برآید","جانم در حال رفتن است و در دل حسرت دارم که از لب‌های او هیچ کامی به دست نیاورده‌ام. اگر این وضعیت ادامه یابد، جانم از بدن خارج خواهد شد."],[232,"از حسرت دهانش آمد به تنگ جانم","خود کام تنگدستان کی زان دهن برآید","از شدت حسرت به دهن او جانم در حال تمام شدن است، زیرا خواسته‌های تنگدستان هرگز از آن دهن برآورده نمی‌شود."],[232,"گویند ذکر خیرش در خیل عشقبازان","هر جا که نام حافظ در انجمن برآید","می‌گویند هر جا که نام حافظ در میان عاشقان شنیده شود، به یاد نیکی و خوبی او نیز صحبت می‌شود."],[233,"چو آفتاب می از مشرق پیاله برآید","ز باغ عارض ساقی هزار لاله برآید","زمانی که نور آفتاب از پیاله‌ای طلایی سرچشمه می‌گیرد، به گونه‌ای که باغ عارض (صورت زیبا) ساقی را می‌درخشد، هزار لاله (گل) از آنجا شکوفا می‌شود."],[233,"نسیم در سر گل بشکند کلاله سنبل","چو از میان چمن بوی آن کلاله برآید","وقتی نسیم به سر گل سنبل می‌وزد و کلاهک آن را می‌شکند، بوی خوشی که از چمن و این کلاهک بلند می‌شود، به مشام می‌رسد."],[233,"حکایت شب هجران نه آن حکایت حالیست","که شمّه‌ای ز بیانش به صد رساله برآید","حکایت شب جدایی، داستانی نیست که فقط با یک جمله یا تعبیر کوتاه بتوان آن را توضیح داد یا در چند رساله بیان کرد. این احساس عمیق و غم‌انگیز فراتر از کلمات است."],[233,"ز گرد خوان نگون فلک طمع نتوان داشت","که بی ملالت صد غصه، یک نواله برآید","از دور و بر میز نشستن این روزگار بی‌فایده است، زیرا نمی‌توان انتظار داشت که بدون اندوه و عذاب، حتی لقمه‌ای از روزی به ما برسد."],[233,"به سعی خود نتوان برد پی به گوهر مقصود","خیال باشد کاین کار بی حواله برآید","انسان با تلاش خود نمی‌تواند به هدف اصلی‌اش برسد، چرا که این کار نیاز به زمینه و اجازه‌ای دارد و تنها به آرزو کردن کافی نیست."],[233,"گرت چو نوح نبی صبر هست در غم طوفان","بلا بگردد و کام هزارساله برآید","اگر مثل نوح پیامبر در برابر غم و بلا صبر و استقامت داشته باشی، نجات پیدا می‌کنی و آرزوهای دیرینه‌ات محقق خواهد شد."],[233,"نسیم زلف تو چون بگذرد به تربت حافظ","ز خاک کالبدش صد هزار لاله برآید","هرگاه نسیم زلف تو از کنار آرامگاه حافظ بگذرد، از خاک بدن او هزاران لاله خواهد روئید."],[234,"زهی خجسته زمانی که یار بازآید","به کام غمزدگان غمگسار بازآید","خوشا زمانی که یار برگردد، زیرا در آن زمان، غم‌زده‌ها نیز شادابی و خوشحالی را دوباره خواهند یافت."],[234,"به پیش خیل خیالش کشیدم ابلق چشم","بدان امید که آن شهسوار بازآید","در میان جمعی که به یاد او هستند، چشمم را به سوی آن چشمان زیبا و رنگی معطوف کردم به امید اینکه آن جوان شجاع و دلیر دوباره برگردد."],[234,"اگر نه در خم چوگان او رود سر من","ز سر نگویم و سر خود چه کار بازآید","اگر سر من هم به گردونه بازی چوگان او نیفتد، چیزی نمی‌گویم و نمی‌پرسم که حالا چه سر و کاری به سر خودم پیدا می‌شود."],[234,"مقیم بر سر راهش نشسته‌ام چون گرد","بدان هوس که بدین رهگذار بازآید","من در جاده‌ای که او از آنجا می‌گذرد نشسته‌ام، مانند گردی که بە خاطر هوس و آرزو امیدوارم او دوباره برگردد."],[234,"دلی که با سر زلفین او قراری داد","گمان مبر که بدان دل قرار بازآید","دل که به خاطر موهای پردود و کلفت او آرامش پیدا کرده، چنین گمان نکن که آن دل دوباره آرامش پیدا کند."],[234,"چه جورها که کشیدند بلبلان از دی","به بوی آن که دگر نوبهار بازآید","بلبلان در فصل دی (زمستان) به خاطر عطر و بوی آن محبوب، چه سختی‌ها و رنج‌ها را تحمل کردند و گمان دارند که دوباره بهار خواهد آمد."],[234,"ز نقش بند قضا هست امید آن حافظ","که همچو سرو به دستم نگار بازآید","حافظ به خداوند اشاره می‌کند که با قدرت خود می‌تواند امید به بازگشت محبوبش را زنده کند. او خود را به سرو تشبیه کرده و امید دارد که عشقش دوباره به سراغش می‌آید."],[235,"اگر آن طایر قدسی ز درم بازآید","عمر بگذشته به پیرانه سرم بازآید","اگر آن پرنده ملکوتی به سراغم بیاید، عمر از رفته‌ام به دوران پیری بازمی‌گردد."],[235,"دارم امّید بر این اشک چو باران که دگر","برق دولت که برفت از نظرم بازآید","به شدت امیدوارم که این اشک‌هایی که مانند باران می‌ریزد، باعث شود که خوشی و سعادت که از نظرم رفته دوباره به زندگی‌ام برگردد."],[235,"آن که تاج سر من خاک کف پایش بود","از خدا می‌طلبم تا به سرم بازآید","کسی که برای من مانند تاج سر ارزشمند بود و احترامش را به حدی می‌رساند که خاک پایش را بر خود ترجیح می‌دادم، اکنون از خداوند دعا می‌کنم که دوباره به سراغم بازگردد."],[235,"خواهم اندر عقبش رفت به یاران عزیز","شخصم ار بازنیاید خبرم بازآید","می‌خواهم پشت سر او بروم و به دوستان گرامی‌ام بگویم، اگر خبر از من به او نرسد، حداقل خبرش به من برسد."],[235,"گر نثار قدم یار گرامی نکنم","گوهر جان به چه کار دگرم بازآید؟","اگر برای یار عزیزم جانم را نثار نکنم، پس جانم به چه کار دیگری خواهد آمد؟"],[235,"کوس نو دولتی از بام سعادت بزنم","گر ببینم که مه نوسفرم بازآید","بر بلندای بام سعادت، طبل خوشبختی می زنم اگر ببینم که معشوق تازه سفرکرده ام بازمی گردد."],[235,"مانعش غلغل چنگ است و شکرخواب صبوح","ور نه گر بشنود آه سحرم بازآید","معشوق (یعنی آن کسی که شاعر به او عشق می‌ورزد) صدای ساز و دل‌انگیزی دارد و در حالت خوشی و سرخوشی به سر می‌برد. اگر او صدای آه و ناله‌ی شاعر را بشنود، به سوی او بازخواهد گشت."],[235,"آرزومند رخ شاه چو ماهم حافظ","همتی تا به سلامت ز درم بازآید","حافظ آرزو دارد که مانند ماه، رخ شاه را ببیند و از در او به سلامت خارج شود، بنابراین از او می‌خواهد که کامیابی و تلاش بیشتری به خرج دهد تا به این آرزو برسد."],[236,"نفس برآمد و کام از تو بر نمی‌آید","فغان که بخت من از خواب در نمی‌آید","جانم به لبم رسید و به هیچ آرزویی از تو نرسیدم، فریاد که این بخت به خواب رفته‌‌ی من قصد بیدار شدن ندارد."],[236,"صبا به چشم من انداخت خاکی از کویش","که آب زندگیم در نظر نمی‌آید","باد صبا خاکی از محله‌ی معشوق در چشم من ریخت که به دنبال آن، آب حیات در نظرم بی‌ارزش شده است."],[236,"قد بلند تو را تا به بر نمی‌گیرم","درخت کام و مرادم به بر نمی‌آید","تا زمانی که قامت بلند تو را در آغوش نگیرم، درخت آرزوهایم به ثمر نخواهد نشست و میوه‌ای نخواهد داد."],[236,"مگر به روی دلارای یار ما ور نی","به هیچ وجه دگر کار بر نمی‌آید","همانا تنها با چهره‌‌ی زیبا و دل­آرای معشوق ما کارها به سامان می‌رسد وگرنه به هچ طریق دیگری کارها به انجام نمی‌رسد.(وجه: ایهام: ۱. شیوه ۲. رو، چهره.)"],[236,"مقیم زلف تو شد دل که خوش سوادی دید","وز آن غریب بلاکش خبر نمی‌آید","از زمانی که دل غریب و بلا دیده‌ی من حلقه زلف سیاه و خوش­بوی تو را دید و در آن ساکن شد، از آن پس دیگر از دل عاشق من خبری به گوش نمی‌رسد.(نکته: در ادبیات فارسی دل در دو جا مسکن و مأوی دارد: ۱. زلف معشوق ۲. چاه زنخدان یا در محل فرو رفتگی چانه معشوق.)"],[236,"ز شست صدق گشادم هزار تیر دعا","ولی چه سود یکی کارگر نمی‌آید","از شست راستی و صداقت هزار گونه تیر دعا پرتاب کرده‌­ام؛ ولی چه سود که یکی به هدف برخورد نمی‌کند."],[236,"بسم حکایت دل هست با نسیم سحر","ولی به بخت من امشب سحر نمی‌آید","حرف‌ها و گفته‌های بسیاری دارم که امشب باید به باد سحرگاهان بزنم، اما امشب از اقبال من هنگام سحر نمی‌رسد.(شب عاشقان بیدل چه شبی دراز باشد)"],[236,"در این خیال به سر شد زمان عمر و هنوز","بلای زلف سیاهت به سر نمی‌آید","عمر من در این خیال گذشت که روزی رنج و بلای هجران که همچون زلف تو سیاه و بلند است به پایان می‌رسد اما هنوز این بلا همچون زلف تو ادامه دارد.(نکته: خواجه در این بیت بلای طولانی روزگار هجران را به زلف بلند معشوق تشبیه کرده است.)"],[236,"ز بس که شد دل حافظ رمیده از همه کس","کنون ز حلقه زلفت به در نمی‌آید","دل حافظ از بس که از همه گریزان و رمنده شده است، اکنون دیگر نمی‌خواهد از حلقه‌ی زلف تو بیرون بیاید. (مقیم زلف تو شد دل که خوش سوادی دید)"],[237,"جهان بر ابروی عید از هلال وسمه کشید","هلال عید در ابروی یار باید دید","تعبیر زیبای جهان را به ابروی یار در روز عید تشبیه می‌کند. در واقع، به زیبایی ابروی یار در عید اشاره می‌کند و می‌گوید که باید زیبایی یار را در روز عید به تماشا نشست، همان‌طور که در روز عید، آسمان به هلال ماه زیبایی می‌بخشد."],[237,"شکسته گشت چو پشت هلال قامت من","کمان ابروی یارم چو وسمه بازکشید","در این بیت، شاعر می‌گوید که مثل هلال ماه، پشت او خمیده شده است و به خاطر زیبایی و قوس ابروی معشوق، قامتش نیز به شکلی خاص و زیبا به خود گرفته است. در واقع، ابروی معشوق او را به حالتی نرم و زیبا درآورده است مثل اینکه کشیده شده باشد."],[237,"مگر نسیم خطت صبح در چمن بگذشت","که گل به بوی تو بر تن چو صبح جامه درید","گویا نسیم خوشبوی خط تو صبحگاه در باغ گذر کرده است که گل، به خاطر عطر تو، همچون صبح، لباس خود را بر تن درید و از زیبایی‌ات شادمان شد."],[237,"نبود چنگ و رباب و نبید و عود، که بود","گل وجود من آغشته گلاب و نبید","وجود من بدون آهنگ و لذت‌های دنیوی چون چنگ و رباب، و بدون شراب و ساز، تنها به گل و عطر گلاب آغشته است. به عبارت دیگر، زندگی‌ام چیزی جز طراوت و عطر گل‌ها نیست و خالی از لذایذ دیگر است."],[237,"بیا که با تو بگویم غم ملالت دل","چرا که بی تو ندارم مجال گفت و شنید","بیا تا درباره غم و ناراحتی دل با تو صحبت کنم، زیرا بدون تو فرصتی برای گفتن و شنیدن ندارم."],[237,"بهای وصل تو گر جان بود خریدارم","که جنس خوب مبصّر به هر چه دید خرید","اگر بهای وصال تو حتی جان من باشد، من آن را می‌خرم، چون جنس خوب را با دقت می‌خرند و به هر چیزی که می‌بینند توجه می‌کنند."],[237,"چو ماه روی تو در شام زلف می‌دیدم","شبم به روی تو روشن چو روز می‌گردید","وقتی که چهره زیبای تو را در تاریکی موهای سیاهت می‌دیدم، شب من همچون روز روشن می‌شد."],[237,"به لب رسید مرا جان و برنیامد کام","به سر رسید امید و طلب به سر نرسید","جان من به لب رسیده و نمی‌توانم نفس بکشم، اما خواسته‌ام برآورده نشده است. آرزو و امیدم به پایان رسیده‌اند، اما آنچه می‌خواستم هنوز به دست نیامده است."],[237,"ز شوق روی تو حافظ نوشت حرفی چند","بخوان ز نظمش و در گوش کن چو مروارید","حافظ از شوق و عشق به محبوبش، اشعاری نوشته است. از تو می‌خواهد که این اشعار را بخوانی و مانند مرواریدی در گوش‌ات لذت ببری."],[238,"رسید مژده که آمد بهار و سبزه دمید","وظیفه گر برسد، مصرفش گل است و نبید","خبر رسید که بهار فرا رسیده و سبزه‌ها جوانه زده‌اند. اگر مقرری و مستمری برسد، باید هزینه گل و نوشیدنی‌های خوشمزه شود."],[238,"صفیر مرغ برآمد، بط شراب کجاست؟","فغان فتاد به بلبل، نقاب گل که کشید؟","صدای خوشی از مرغ به گوش می‌رسد، بگو کجاست آن صراحی پر از شراب؟ بلبل در حال ناله و فریاد است، چه کسی نقاب گل را برداشت؟"],[238,"ز میوه‌های بهشتی چه ذوق دریابد","هر آن که سیب زنخدان شاهدی نگزید","کسی که طعم لذت‌های بهشتی را نمی‌چشد که از میوه‌های بهشتی بهره‌مند شود، زیرا او از عشق و هوس معشوقی که شایسته است دوری کرده و سیب زدن به زلف او را تجربه نکرده است."],[238,"مکن ز غصّه شکایت که در طریق طلب","به راحتی نرسید آن که زحمتی نکشید","برای رسیدن به هدف و خواسته‌ها، باید تلاش کرد و زحمت کشید. کسی که بدون کوشش و تلاش باشد، نباید از ناکامی خود شکایت کند و به غم و اندوه دچار شود."],[238,"ز روی ساقی مه‌وش گلی بچین امروز","که گرد عارض بستان خط بنفشه دمید","امروز از روی ساقی که مانند ماه است گلی بچین، زیرا دور چهره‌اش در باغ، خط بنفشه‌ای روییده است."],[238,"چنان کرشمه ساقی دلم ز دست ببرد","که با کسی دگرم نیست برگ گفت و شنید","چنان زیبایی و عشوه‌ای از ساقی به دل من رسیده که دیگر هیچ‌کس را نمی‌بینم و هیچ‌چیزی برای گفتن و شنیدن ندارم."],[238,"من این مرقّع رنگین چو گل، بخواهم سوخت","که پیر باده‌فروشش به جرعه‌ای نخرید","من این پارچه رنگی مثل گل را می‌خواهم بسوزانم، چون پیر باده‌فروش آن را به یک جرعه شراب هم نمی‌خرد."],[238,"بهار می‌گذرد دادگسترا دریاب","که رفت موسم و حافظ هنوز می نچشید","بهار در حال گذشتن است، ای دادگستر[باده فروش]! توجه کن که زمان به پایان رسیده و حافظ هنوز طعم شراب را نچشیده است."],[239,"ابر آذاری برآمد باد نوروزی وزید","وجه می می‌خواهم و مطرب، که می‌گوید رسید؟","هوا بهاری شده و بادی خوش می‌وزد. من به دنبال دلیل برای نوشیدن می‌گردم و از نوازنده می‌پرسم چه زمانی برای نوشیدن شراب آماده‌ایم؟"],[239,"شاهدان در جلوه و من شرمسار کیسه‌ام","بار عشق و مفلسی صعب است، می‌باید کشید","من در مقابل زیبایی و جلوه‌های عشق، شرمنده‌ام و احساس می‌کنم که دستم خالی است. تحمل مشکلات عشق و فقر برای من دشوار است و باید این بار سنگین را به دوش بکشم."],[239,"قحط جود است آبروی خود نمی‌باید فروخت","باده و گل از بهای خرقه می‌باید خرید","زمانه سختی است و بی‌عطایی فراوان، بنابراین نباید آبروی خود را فدای مال و منال کرد، زیرا برای دستیابی به لذت‌های دنیا همچون باده و گل، باید بهای زیادی مانند معصومیت و صداقت را بپردازیم."],[239,"گوییا خواهد گشود از دولتم کاری که دوش","من همی‌کردم دعا و صبح صادق می‌دمید","به نظر می‌رسد او می‌خواهد کاری را انجام دهد که دیروز من برای آن دعا می‌کردم و صبح زود به وقوع می‌پیوندد."],[239,"با لبی و صد هزاران خنده آمد گل به باغ","از کریمی گوییا در گوشه‌ای بویی شنید","با لبانی خندان و با صدها خنده، گل به باغ آمد، انگار که بویی خوش از یک انسان بخشنده (خدا یا معشوق) در گوشه‌ای شنیده شده است."],[239,"دامنی گر چاک شد در عالم رندی چه باک","جامه‌ای در نیکنامی نیز می‌باید درید","اگر دامن انسان در دنیای رندی و خوش‌گذرانی دچار آسیب شود، جای نگرانی نیست، زیرا برای دستیابی به نیک‌نامی و مقام بلند، باید از بعضی از حجاب‌ها و آداب گذشته گذشت."],[239,"این لطایف کز لب لعل تو من گفتم، که گفت؟","وین تطاول کز سر زلف تو من دیدم، که دید؟","من از زیبایی‌ها و رازها و لطایف تو که به خاطر لب‌های سرخ و زلف‌های تو بیان کردم، آیا کسی آن‌ها را گفته است؟ و این طویلی که از زلف تو دیدم، آیا کسی آن را نیز دیده است؟"],[239,"عدل سلطان گر نپرسد حال مظلومان عشق","گوشه‌گیران را ز آسایش طمع باید برید","اگر سلطان عادل هم از حال عاشقانی که در گوشه‌گیری و درد هستند، نپرسد و به آن‌ها توجه نکند، باید از آسایش و راحتی خود دست بکشید."],[239,"تیر عاشق‌کش ندانم بر دل حافظ که زد","این قدر دانم که از شعر ترش خون می‌چکید","حافظ نمی‌داند تیر عشق که دلش را هدف قرار داده، از سوی چه کسی است، اما می‌داند که شعرش به قدری تأثیرگذار و غم‌انگیز است که از آن خون می‌چکد."],[240,"معاشران ز حریف شبانه یاد آرید","حقوق بندگی مخلصانه یاد آرید","دوستان را به یاد بیاورید که در مجالس شبانه با هم بودیم و لحظه‌های خوش را سپری کردیم و همچنین به یاد آورید آن محبت و خدمت صمیمانه‌ای را که با فروتنی و بی‌وقفه برای یکدیگر کرده‌ایم."],[240,"به وقت سرخوشی از آه و ناله عشّاق","به صوت و نغمه چنگ و چغانه یاد آرید","در زمان شادی و خوشی، به جای آه و ناله عاشقان، به صدای ساز و نغمه‌های خوش بیندیشید."],[240,"چو لطف باده کند جلوه در رخ ساقی","ز عاشقان به سرود و ترانه یاد آرید","زمانی که زیبایی شراب در چهره ساقی نمایان شود، عشق و دل‌بستگی عاشقان را با آواز و نغمه به یاد بیاورید."],[240,"چو در میان مراد آورید دست امید","ز عهد صحبت ما در میانه یاد آرید","وقتی که در این دنیا به آرزوی خود دست یابید، به یاد بیاورید که ما در زمان دوستی و صحبت چقدر با هم راحت و خوش بودیم."],[240,"سمند دولت اگر چند سرکشیده رود","ز همرهان به سر تازیانه یاد آرید","اگرچه سمند دولت (نشانه خوشبختی) ممکن است سرکش و بی‌قرار باشد، اما به یاد داشته باشید که این بی‌قراری و سرکشی به خاطر همراهانش است و باید به نقش سر تازیانه (راهنمایی و کنترل) اهمیت دهید."],[240,"نمی‌خورید زمانی غم وفاداران","ز بی‌وفایی دور زمانه یاد آرید","به دلیل بی‌وفایی زمانه، دیگر نباید غم وفاداران را بخورید و به یاد داشته باشید که این بی‌وفایی طبیعی است."],[240,"به وجه مرحمت ای ساکنان صدر جلال","ز روی حافظ و این آستانه یاد آرید","ای ساکنان بالاترین مقام و افراز جلال، به مهربانی که به ما دارند، به حافظ و این درگاه الهی فکر کنید و یاد کنید."],[241,"بیا که رایت منصور پادشاه رسید","نوید فتح و بشارت به مهر و ماه رسید","بیا که پرچم پیروزی پادشاه بر افراشته شد و خبر خوش فتح و خوشبختی به خورشید و ماه رسید."],[241,"جمال بخت ز روی ظفر نقاب انداخت","کمال عدل به فریاد دادخواه رسید","خوشی‌های سرنوشت به واسطه پیروزی، چهره‌اش را پوشانده است و عدالت به کمک کسانی که به دنبال داد و دادخواهی هستند، آمده است."],[241,"سپهر، دور خوش اکنون کند که ماه آمد","جهان به کام دل اکنون رسد که شاه رسید","گردش آسمان، از آمدن ماه سامان گرفت و اکنون جهان از رسیدن شاه، به کام دل می‌رسد."],[241,"ز قاطعان طریق این زمان شوند ایمن","قوافل دل و دانش که مرد راه رسید","مژده دهید که اکنون قافله‌های دل و دانش، از راهزنان در امان خواهند بود."],[241,"عزیز مصر به رغم برادران غیور","ز قعر چاه برآمد به اوج ماه رسید","عزیز مصر، با وجود تعصب برادران، از ته چاه بیرون آمد و به اوج بزرگی دست یافت."],[241,"کجاست صوفی دجّال فعل ملحدشکل","بگو بسوز، که مهدیّ دین پناه رسید","کجاست آن صوفی دجّال رفتار بی دین که به او بگویید بسوزد، چون مهدی دین‌پناه آمد."],[241,"صبا بگو که چه‌ها بر سرم در این غم عشق","ز آتش دل سوزان و دود آه رسید","صبا بگو که در این غم عشق، از آتش دل سوزان و دود آهم چه‌ها به سرم آمد."],[241,"ز شوق روی تو شاها بدین اسیر فراق","همان رسید کز آتش به برگ کاه رسید","شاها! از شوق روی تو بر این اسیر جدایی، همان آمد که آتش به [خرمن] کاه افتاده باشد."],[241,"مرو به خواب که حافظ به بارگاه قبول","ز ورد نیم شب و درس صبحگاه رسید","به خواب نرو، زیرا حافظ با نیایش نیمه‌شب و درس صبحگاه در درگاه پذیرفته شد."],[242,"بوی خوش تو هر که ز باد صبا شنید","از یار آشنا سخن آشنا شنید","هر کس که بوی خوش تو را از نسیم بامدادی بشنود، انگار از آشنا سخن آشنا شنیده باشد."],[242,"ای شاه حسن، چشم به حال گدا فکن","کـاین گوش بس حکایت شاه و گدا شنید","ای شاه زیبایی! نگاهی به حال گدا بینداز؛ زیرا این گوش، داستان‌های بسیاری از شاه و گدا شنیده است."],[242,"خوش می‌کنم به باده مشکین مشام جان","کز دلق‌پوش صومعه بوی ریا شنید","من با بوی باده مشکین گوش جان را شاد می‌کنم، زیرا از پشمینه پوش صومعه بوی دورویی شنیده‌ام."],[242,"سرّ خدا که عارف سالک به کس نگفت","در حیرتم که باده‌فروش از کجا شنید","من در شگفتم راز خداوند را که عارف سالک به کسی نگفته بود، باده‌فروش از کجا شنیده است!"],[242,"یا رب کجاست محرم رازی که یک زمان","دل شرح آن دهد که چه گفت و چه‌ها شنید","خدایا آن محرم راز کجاست که دل بتواند یک بار دل شرح دهد که چه گفته و چه‌ها شنیده است."],[242,"اینش سزا نبود دل حق‌گزار من","کز غمگسار خود سخن ناسزا شنید","دل پایبند به حق من، سزاوار این نبود که از همدم خود سخن ناشایست بشنود."],[242,"محروم اگر شدم ز سر کوی او چه شد؟","از گلشن زمانه که بوی وفا شنید؟","اگر از کوی او محروم شدم، چیزی نشده است. [مگر] چه کسی از گلشن زمانه بوی وفا شنیده است؟"],[242,"ساقی بیا که عشق ندا می‌کند بلند","کان کس که گفت قصه ما هم ز ما شنید","ساقی بیا که عشق فریاد می‌زند: کسی که داستان ما را گفت، از خود ما شنیده استاینجا می خواد بگهآنچه بنیادی است خود عشق است و عاشق و معشوق هم برآیندی از عشقند!\"ما\"یعنی عشق که همه چیز است دربرگیرنده هم عاشق است هم معشوق.خود عشق است که یک حقیقت است عاشق و معشوق تنها نمودی و جلوه‌ای از عشقند.به زبان دیگر باید پیش و بیش از شناخت عاشق و معشوق خود عشق را شناخت و دریافت که این عشق چه رازی است که عاشق و معشوق را به عشقبازی وا می دارد!فرمانروا نه عاشق است نه معشوق که عشق است.پس به جای شناسایی خسرو و شیرین باید توانمان را بگذاریم عشق را بشناسیم،چرا که خسروها و شیرین‌ها تنها دو تن از هزاران بازیگر آنند.این عشق آن اندازه ژرف و گسترده است که توانایی ان را دارد که در میان هر عاشق و معشوق بازتابی دیگر داشته باشد.از این رو ندای عشق بسی بلندتر از صدای عاشق و معشوق است،چون می‌تواند در میان هر عاشق و معشوقی به رنگی دیگر درآید.پس اینجاست که حافظ که خود عاشقی است هم اینجا خود را کنار می نهد و ساقی را به کمک فرامی‌خواند و می‌گوید بیا که اکنون نیاز شتاب‌آلود به توست .می بده چون می‌خواهم رازی را بگویم که هر کس را یارای شنیدن نباشد.باید مست شود تا دریابد چه می‌گویم.در اینجا به گونه‌ای من نویسنده‌ای این نوشته هم به کناری نهاده می‌شویم چرا که می ساقی نخورده داریم این سخن را وامی‌کاویم!پس هر آنچه اکنون می‌گویمم در هنگام مستی نیست و در هوشیاری آن را بر زبان می‌آریم...به گونه‌ای مست باید بود تا این سخن را دریافت.پس هر آنچه را من تا اینجا گفتم چون مست نبودم و نمی‌تواند راستینه‌ی خواست آنچه این نوشته می‌خواسته باشد!چون ما خویمان این اسا که از عاشق یا معشوق چیزی را بشنویم،عشق که زبان ندارد که ما ازو سخنی بشنویم...ازین رو ساقی را فراخوانده که بگویم یک چیز ناخویمند(غیر عادی) را می‌خواهم بگویم که تنها در خوی ناخویمندی یارای شنیدن و دریافت آن است!"],[242,"ما باده زیر خرقه نه امروز می‌خوریم","صد بار پیر میکده این ماجرا شنید","تنها امروز نیست که زیر خرقه [پنهانی] باده می‌خوریم؛ پیر میکده این ماجرا را بارها شنیده است."],[242,"ما می به بانگ چنگ نه امروز می‌کشیم","بس دور شد که گنبد چرخ این صدا شنید","ما الان از شراب به صدای چنگ (ساز موسیقی) می‌نوشیم، اما این کار امروز نیست؛ مدت زیادی است که دوران فراموشی در گنبد آسمان (به معنای زمان) صدای ما را نمی‌شنود."],[242,"پند حکیم محض صواب است و عین خیر","فرخنده آن کسی که به سمع رضا شنید","پند و نصیحت حکیم، کاملا درست و خیرخواهانه است. فردی که با رضایت به این نصیحت گوش دهد، واقعا انسان خوشبختی است."],[242,"حافظ، وظیفه تو دعا گفتن است و بس","در بند آن مباش که نشنید یا شنید","وظیفه تو فقط دعا کردن است , خودت را درگیر این نکته نکن که آیا دعایت شنیده می‌شود یا نه."],[243,"معاشران! گره از زلف یار باز کنید","شبی خوش‌ است بدین قصه‌اش دراز کنید","ای دوستان گره‌های زلف معشوق را باز کنید (کنایه از ایجاد فضای عاشقانه و صمیمی) امشب شب خوشی است، با این داستان عاشقانه آن را طولانی کنید (یعنی با صحبت و لذت بردن از این لحظه، شب را به خوشی ادامه دهید)."],[243,"حضور خلوت انس است و دوستان جمعند","و ان یکاد بخوانید و در فراز کنید","در این جمع دوستانه، حس و حال صمیمیت موج می‌زند و اگر نزدیک‌تر شویم، می‌توانید آهنگی را بخوانید و این احساس را به اوج برسانید."],[243,"رباب و چنگ به بانگ بلند می‌گویند","«که گوش هوش به پیغام اهل راز کنید»","رباب و چنگ (دو ساز موسیقی) با صدای بلند می‌گویند که به پیام اهل راز (عرفا یا کسانی که در بطن معانی عمیق زندگی می‌نگرند) گوش دهید و توجه کنید."],[243,"به جان دوست که غم پرده بر شما ندرد","گر اعتماد بر الطاف کارساز کنید","اگر به خاطر دوست خود جانتان را فدای او کنید، غم و غصه بر شما نخواهد آمد. پس بر مهربانی‌ها و کمک‌های مؤثر او اعتماد کنید."],[243,"میان عاشق و معشوق فرق بسیار است","چو یار ناز نماید، شما نیاز کنید","بین عاشق و معشوق تفاوت زیادی وجود دارد؛ وقتی محبوب با ناز رفتار کند، شما باید نیاز و خواسته‌تان را نشان دهید."],[243,"نخست موعظه پیر صحبت این حرف است","که «از مصاحب ناجنس احتراز کنید»","پیر صحبت (که به طور معمول به عنوان کسی با تجربه و دانا در امور عاشقانه و اجتماعی شناخته می‌شود) نخستین نصیحتش این است که از هم‌نشینی با افراد نامناسب و بی‌خود، پرهیز کنید."],[243,"هر آن کسی که در این حلقه نیست زنده به عشق","بر او نمرده، به فتوای من نماز کنید",":هر کسی که در این جهان با عشق زندگی نمیکند، مرده است و به فتوای من بر او نماز میت بخوانید(زندگی انسان با عشق معنا میگیرد)"],[243,"وگر طلب کند انعامی از شما حافظ","حوالتش به لب یار دل‌نواز کنید","اگر حافظ از شما بخواهد که چیزی به او بدهید، آن را به لب یار دل‌نواز منتقل کنید."],[244,"الا ای طوطی گویا‌ی اسرار!","مبادا خالیت شکّر ز منقار","ای طوطی سخنگوی اسرار! مبادا که از منقار تو شکر (هیچ چیزی) خالی باشد."],[244,"سرت سبز و دلت خوش باد، جاوید","که خوش نقشی نمودی از خط یار","به تو تبریک می‌گویم که سر و چهره‌ات زیبا و روح و دلت شاد و خوش باشد، زیرا تو با نقش و زیبایی‌ای که از معشوق به جا گذاشته‌ای، همیشه در یادها خواهی ماند."],[244,"سخن سربسته گفتی با حریفان","خدا را زین معما پرده بردار","تو با دوستانت به صورت مبهمی سخن گفته‌ای، پس ای خدا، پرده از این معما کنار بزن و حقیقت را آشکار کن."],[244,"به روی ما زن از ساغر گلابی","که خواب‌آلوده‌ایم، ای بخت بیدار!","ای بخت بیدار، به ما از جام گلابی بنوشان که خواب‌آلود و غافلیم."],[244,"چه ره بود این که زد در پرده مطرب؟","که می‌رقصند با هم مست و هشیار","این بیت از حافظ به این معناست که مطرب چه راهی را پیدا کرده است که توانسته است مستی و هوشیاری را همزمان با هم در رقص حاضران ایجاد کند. گویا بزم و حالتی جادویی به وجود آمده که باعث شده عاشقان در حالی که در مستی غرق‌اند، به گونه‌ای طبیعی و هوشیارانه برقصند."],[244,"از آن افیون که ساقی در می افکند","حریفان را نه سر ماند، نه دستار","از آن افیونی که ساقی در شراب می‌ریزد، نه سر (سر عقل) برای حریفان باقی می‌ماند و نه دستار (عمامه) بر سرشان می‌ماند؛ یعنی از شدت مستی، آن‌ها هیچ کنترلی بر خود ندارند و وضعیتشان به هم می‌ریزد."],[244,"سکندر را نمی‌بخشند آبی","به زور و زر میسّر نیست این کار","حتی سکندر، که یکی از بزرگ‌ترین پادشاهان تاریخ است، نمی‌تواند آب را با زور و ثروت به دست آورد، زیرا این کار امکان‌پذیر نیست."],[244,"بیا و حال اهل درد بشنو","به لفظ اندک و معنی بسیار","بیایید و حال کسانی که دچار درد و رنج هستند را بشنوید؛ این صحبت‌ها شاید کلمات کمی داشته باشد، اما معانی و احساسات عمیق و زیادی در آن وجود دارد."],[244,"بت چینی عدوی دین و دل‌هاست","خداوندا دل و دینم نگه دار","بت چینی تجلی دشمنی با دین و دل‌هاست؛ خداوندا، دل و دین من را حفظ فرما."],[244,"به مستور‌ان مگو اسرار مستی","حدیث جان مگو با نقش دیوار","به کسانی که در خفا و پنهانی هستند، از رازهای مستی نگو و رازی که به جان و دل تو مربوط می‌شود را با تصویرهای روی دیوار در میان نگذار."],[244,"به یمن دولت منصور شاهی","علم شد حافظ اندر نظم اشعار","به برکت و لطف حکومت منصور، حافظ در سرایش شعرها نامدار و مشهور شد."],[244,"خداوندی به جای بندگان کرد","خداوندا ز آفاتش نگه دار","حافظ در این بیت از خداوند درخواست می‌کند که او را از آسیب‌ها و بلایای دنیا محفوظ بدارد، زیرا به خاطر لطف و رحمتش به جای بندگان خود قرار داده است."],[245,"عید است و آخر گل و یاران در انتظار","ساقی به روی شاه ببین ماه و می بیار","عید (روزه‌گشایی است) و آخر فصل بهار است و یاران در انتظار مجلس باده‌نوشی و عیش پس ای ساقی به روی ماه و زیبای شاه بنگر (عید را اعلام کن) و باده بیاور."],[245,"دل برگرفته بودم از ایّام گل، ولی","کاری بکرد همّت پاکان روزه دار","از باده‌نوشی در فصل گل و بهار ناامید شده بودم اما همّت و دعای پاکان روزه‌دار کاری کرد. (احتمالا سرودن این غزل در سالی بوده که ماه رمضان مصادف با اواخر فصل بهار بوده است)"],[245,"دل در جهان مبند و به مستی سؤال کن","از فیض جام و قصه جمشید کامگار","به دنیا دل مبند و خوش باش و در حال خوشی و مستی‌، از لطف جام جهان‌بین بپرس و حکایت جمشید فیروزمند و کامگار را بشنو."],[245,"جز نقد جان به دست ندارم شراب کو؟","کان نیز بر کرشمه ساقی کنم نثار","من تنها یک جان دارم که برای تأمین دلخوشی‌ام به دست می‌دهم، شراب کجاست؟ که می‌خواهم آن را نیز به زیبایی ساقی تقدیم کنم."],[245,"خوش دولتیست خرّم و خوش خسروی کریم","یا رب ز چشم زخم زمانش نگاه دار","خوشبختی و زیبایی او بسیار دلنشین و با شکوه است. ای خدا، این شخص را از آسیب‌های زمانه محافظت کن."],[245,"می خور به شعر بنده که زیبی دگر دهد","جام مرصّع تو بدین درّ شاهوار","بنگر که وقتی در شعر من به می‌نوشی، زیبایی تازه‌ای به دست می‌آوری؛ چرا که لیوان زینتی تو با این مروارید شاهوار زینت خواهد یافت."],[245,"گر فوت شد سحور چه نقصان صبوح هست","از می کنند روزه گشا طالبان یار","اگر سحری نتوانستی بخوری،مشکلی نیست شراب هست. زیرا آنهایی که به عشق معشوق می‌پردازند، روزه خود را با شراب می‌شکنند."],[245,"زانجا که پرده پوشی عفو کریم توست","بر قلب ما ببخش که نقدیست کم عیار","از آنجایی که رحمت و بخشش بزرگوارانه‌ات بر دل‌های ما سایه افکنده، خواهش می‌کنیم که ما را ببخشی، چون پشیمانی‌ام اندک است و ارزشی ندارد."],[245,"ترسم که روز حشر عنان بر عنان رود","تسبیح شیخ و خرقه رند شرابخوار","می‌ترسم در روز قیامت تسبیح و دعاهای شیخ (روحانی) و لباس (خرقه) رند (مستی که به ظواهر نمی‌پردازد و عیاشی می‌کند) که شراب می‌نوشد، بر اعمال ما پیشی بگیرد و ما را نجات ندهد."],[245,"حافظ چو رفت روزه و گل نیز می‌رود","ناچار باده نوش که از دست رفت کار","حافظ می‌گوید وقتی روزه تمام می‌شود و گل هم از بین می‌رود، ناگزیری این است که باده بنوشی، چون کار از دست رفته است و دیگر فرصت برای بهره‌مندی وجود ندارد."],[246,"صبا ز منزل جانان گذر دریغ مدار","وز او به عاشق بی‌دل خبر دریغ مدار","ای نسیم صبح، از خانه محبوب بگذر و در این مسیر، از او به عاشق بی‌دل، خبری نرسان."],[246,"به شکر آن که شکفتی به کام بخت ای گل","نسیم وصل ز مرغ سحر دریغ مدار","ای گل، به خاطر شکر کردن از اینکه شکفته‌ای و خوشبختی به سراغت آمده، از نسیم رسیدن به وصل خود و خوشحالی‌ات از مرغ سحر، دریغ نکن."],[246,"حریف عشق تو بودم چو ماه نو بودی","کنون که ماه تمامی نظر دریغ مدار","من در عشق تو همچون ماه نو بودم، اما اکنون که به تمامیت خود رسیده‌ای و کامل شده‌ای، چشم‌پوشی از من را جایز ندان."],[246,"جهان و هر چه در او هست سهل و مختصر است","ز اهل معرفت این مختصر دریغ مدار","جهان و هر چیزی که در آن وجود دارد، چیزی ساده و کم‌ارج است؛ بنابراین، از اهل معرفت که بر ارزش واقعی اشیاء آگاه‌اند، نباید از این سادگی و کم‌ارجی شگفت‌زده شد."],[246,"کنون که چشمه قند است لعل نوشین‌ات","سخن بگوی و ز طوطی، شکر دریغ مدار","اکنون که لب‌های شیرینت مانند چشمه قند است، سخن بگو و در بیان شیرینی آن همچون طوطی، از شکر (شیرینی) دریغ نکن."],[246,"مکارم تو به آفاق می‌برد شاعر","از او وظیفه و زاد سفر دریغ مدار","نیکی‌ها و ویژگی‌های تو در همه‌جا شناخته می‌شود، شاعر از تو الهام می‌گیرد و برای سخن‌سرایی به تو نیاز دارد، بنابراین در حمایت و کمک به او کوتاهی نکن."],[246,"چو ذکر خیر طلب می‌کنی سخن این است","که در بهای سخن سیم و زر دریغ مدار","هرگاه که در پی ذکر خوبی و یاد نیکویی هستی، بدان که در ارزش و اهمیت این کلام نباید از صرف هزینه و محبت دریغ کنی."],[246,"غبار غم برود، حال خوش شود حافظ","تو آب دیده از این ره‌گذر دریغ مدار","اگر غبار غم از دلبرت برود، حال خوشی به دست می‌آوری. حافظ، برای رسیدن به این حال خوب، از اشک‌هایت دریغ نکن."],[247,"ای صبا نکهتی از کوی فلانی به من آر","زار و بیمار غمم راحت جانی به من آر","ای نسیم‌، پیامی از آن‌یار (که خود می‌دانی) بیاور و من‌ بیمار را درمان کن و جان‌ببخش. (نکهت: بوی‌خوش)"],[247,"قلب بی‌حاصل ما را بزن اکسیر مراد","یعنی از خاک در دوست نشانی به من آر","سکّه تقلبی و سیاه ما را با آن کیمیا، زر کن یعنی با کیمیای خاک کوی یار."],[247,"در کمینگاه نظر با دل خویشم جنگ است","ز ابرو و غمزه او تیر و کمانی به من آر","دل من به‌دشمنی من برخاسته و با من در جنگ است؛ تیر و کمانی از غمزه و ابروی یار برایم بیاور."],[247,"در غریبی و فراق و غم دل پیر شدم","ساغر می ز کف تازه جوانی به من آر","در غربت و دوری از یار، پیر و ناتوان گشته‌ام با جامی‌باده از دست یک‌ساقی جوان مرا شاد و جوان گردان."],[247,"منکران را هم از این می دو سه ساغر بچشان","وگر ایشان نستانند روانی به من آر","برای مخالفان می‌گساری چند جام باده بریز، اگر ننوشند بی‌وقفه برای من بیاور."],[247,"ساقیا عشرت امروز به فردا مفکن","یا ز دیوان قضا خطّ امانی به من آر","ای ساقی، وعده بزم و می‌گساری فردا به‌من مده؛ زیرا تضمینی برای «فردا» وجود ندارد."],[247,"دلم از دست بشد دوش چو حافظ می‌گفت","کای صبا نکهتی از کوی فلانی به من آر","دیشب بسیار غمگین‌شدم وقتی‌که حافظ را دیدم که از نسیم، پیامی از یارش طلب‌می‌کرد."],[248,"ای صبا نکهتی از خاک ره یار بیار","ببر اندوه دل و مژده دل‌دار بیار","ای نسیم صبحگاهی، بوی خوشی از خاک راه محبوبم بیاور و غم دل را ببر و خبر خوش از محبوب را به من برسان."],[248,"نکته‌ای روح‌فزا از دهن دوست بگو","نامه‌ای خوش خبر از عالم اسرار بیار","از زبان دوست، نکته‌ای دل‌نشین و شاداب بگو و همچنین نامه‌ای که خبرهای خوبی از دنیای رازها و اسرار به همراه داشته باشد، بیاور."],[248,"تا معطّر کنم از لطف نسیم تو مشام","شمّه‌ای از نفحات نفس یار بیار","برای اینکه بوی خوبی از نعمت نسیم تو ببرم، یک نفس از عطر دم یار را بیاور."],[248,"به وفای تو که خاک ره آن یار عزیز","بی‌غباری که پدید آید از اغیار بیار","به خاطر وفای تو، خاک راه آن یار عزیز را بیاور که از آن غبار و آلودگی‌های دیگران پاک است."],[248,"گردی از ره‌گذر دوست به کوریّ رقیب","بهر آسایش این دیده خون‌بار بیار","برای آسایش این چشم دردناک من، کمی گرد و غبار از راه دوست بیاور تا رقیب نتواند ببینید."],[248,"خامی و ساده‌دلی شیوه جانبازان نیست","خبری از بر آن دل‌بر عیّار بیار","ساده‌دلی و خامی در عشق، نشانه شجاعت و فداکاری نیست، بلکه باید برای دلبر زیرک و نامحرم، با تدبیر و حساب‌گرایی عمل کرد."],[248,"شکر آن را که تو در عشرتی ای مرغ چمن","به اسیران قفس، مژده گل‌زار بیار","به خاطر نعمت و لطف تو شکرگزاری می‌کنم، ای مرغ باغی که در خوشی زندگی می‌کنی؛ برای زندانیان قفس، خبر خوب و شادی‌بخش از باغ گل بیاور."],[248,"کام جان تلخ شد از صبر که کردم بی‌دوست","عشوه‌ای زان لب شیرین شکربار بیار","دل من از صبر به شدت تلخ شده چون هیچ دوستی ندارم؛ لطفا از آن لب شیرین و شکرین تو خبری بیاور."],[248,"روزگاریست که دل چهره مقصود ندید","ساقیا آن قدح آینه‌کردار بیار","مدت زیادی است که قلب من چهره محبوب را نمی‌بیند، ای ساقی، آن جامی را بیاور که مانند آینه است و همه چیز را نشان می‌دهد."],[248,"دلق حافظ به چه ارزد؟ به می‌اش رنگین کن","وان گه‌اش مست و خراب از سر بازار بیار","لباس حافظ (دلق) به چه چیزی می‌ارزد؟ آن را با شراب رنگین کن و در آن لحظه او را مست و خراب از وسط بازار بیاور."],[249,"روی بنمای و وجود خودم از یاد ببر","خرمن سوختگان را همه گو باد ببر","بیا و خودت را نشان بده و وجودت را به یاد بزن، من نباید سوختگان را که دل‌شان را باخته‌اند فراموش کنم، بگو که باد همه را ببرد."],[249,"ما چو دادیم دل و دیده به طوفان بلا","گو «بیا سیل غم و خانه ز بنیاد ببر»","ما وقتی که دل و چشم خود را به بلا و سختی سپردیم، می‌گوییم: «بیا و هرچه غم است را با خود ببر و خانه‌مان را از ریشه ویران کن."],[249,"زلف چون عنبر خامش که ببوید؟ هیهات","ای دل خام‌طمع! این سخن از یاد ببر","زلف او که مانند عطر خوش عنبر است، چه کسی می‌تواند ببوید؟ ای دل ساده‌لوح! این حرف‌ها را فراموش کن و به سراغش نرو."],[249,"سینه گو «شعله آتشکده فارس بکش»","دیده گو «آب رخ دجله بغداد ببر»","سینه درخواست می‌کند که آتشکده‌ای در فارس را خاموش کند و چشم می‌گوید که باید آب صورت دختران زیبای بغداد را ببرد."],[249,"دولت پیر مغان باد که باقی سهل است","دیگری گو «برو و نام من از یاد ببر»","خوشی و ثروت پیر مغان حفظ شود، زیرا آنچه باقی می‌ماند آسان است. اگر شخص دیگری بگوید که برو و نام مرا فراموش کن، اهمیت ندارد."],[249,"سعی‌نابرده در این راه به جایی نرسی","مزد اگر می‌طلبی، طاعت استاد ببر","اگر در این مسیر تلاش نکنید، به نتیجه‌ای نخواهید رسید. اگر به دنبال پاداشی هستید، باید از استاد اطاعت کنید و از او یاد بگیرید."],[249,"روز مرگم نفسی وعده دیدار بده","وآن گهم تا به لحد فارغ و آزاد ببر","روز مرگم یک نفس وعده دیدار به من بده و در آن زمان من را تا لحظه دفن، بی‌دغدغه و رها بگذار."],[249,"دوش می‌گفت «به مژگان درازت بکشم»","یا رب از خاطرش اندیشه بیداد ببر","دیشب معشوقه‌ام گفت با مژگان بلندقامتش به من آسیب می‌زند؛ ای خدا، این فکر بد را از ذهن او دور کن."],[249,"حافظ اندیشه کن از نازکی خاطر یار","برو از درگهش این ناله و فریاد ببر","حافظ از تو می‌خواهد که به لطافت و حساسیت دل یار فکر کنی و از درگاه او این ناله و فریاد را دور کنی."],[250,"شب وصل است و طی شد نامه هجر","«سلام فیه حتّی مطلع الفجر»","شب وصال فرا رسیده و نامه جدایی به پایان رسیده است؛ سلامتی و خوشی تا بامداد ادامه دارد."],[250,"دلا در عاشقی ثابت‌قدم باش","که در این ره نباشد کار بی‌اجر","ای دل، در عاشقی ثابت و استوار باش، زیرا در این راه نباید کاری بی‌پاداش انجام شود."],[250,"من از رندی نخواهم کرد توبه","و لو آذیتني بالهجر و الحجر","من هرگز از رندی و شیدایی خود توبه نخواهم کرد، حتی اگر تو با قطع کردن ارتباط و بی‌محبتی مرا آزار بدهی."],[250,"برآی ای صبح روشن‌دل خدا را","که بس تاریک می‌بینم شب هجر","ای صبح خوش‌دل! خدا را که در این شب دوری و جدایی، همه چیز را تاریک و ناامید می‌بینم."],[250,"دلم رفت و ندیدم روی دل‌دار","فغان از این تطاول، آه از این زجر","دل من از آن محبوب دور شده و من نتوانستم چهره‌اش را ببینم. از این فاصله طولانی و رنجی که می‌برم، نالان و عذاب‌زده‌ام."],[250,"وفا خواهی، جفاکش باش حافظ","فانّ الرّبح و الخسران في التّجر","اگر می‌خواهی وفادار باشی، باید توانایی تحمل سختی‌ها و بی‌وفایی‌ها را هم داشته باشی، چرا که سود و زیان در این راه است."],[251,"گر بود عمر، به میخانه رسم بار دگر","بجز از خدمت رندان نکنم کار دگر","اگر عمری باقی بماند، دوباره به میخانه می‌روم و جز از خدمت به رندان (نیکوکاران) کار دیگری انجام نمی‌دهم."],[251,"خرّم آن روز که با دیده گریان بروم","تا زنم آب در میکده یک بار دگر","روزی که با چشمان اشک‌آلود به میکده بروم و دوباره از در آنجا آب بنوشم، بسیار شاد و خرم خواهم بود."],[251,"معرفت نیست در این قوم خدا را سببی","تا برم گوهر خود را به خریدار دگر","در این جمع، کسی خدا را نمی‌شناسد که بتواند به من بگوید چگونه می‌توانم گوهری که ارزش آن را می‌دانم به خریدار دیگری بفروشم."],[251,"یار اگر رفت و حق صحبت دیرین نشناخت","حاش للّه که روم من ز پی یار دگر","اگر یار برود و حق دوستی قدیمی را نشناسد، برایم قابل بخشش نیست که من به دنبال یار دیگری بروم."],[251,"گر مساعد شودم دایره چرخ کبود","هم به دست آورمش باز به پرگار دگر","اگر فرصت و موقعیت مساعد باشد، حتی چرخ فلک آبی را هم می‌توانم دوباره به دست آورم و مانند یک پرگار (ابزاری برای رسم دایره) از آن استفاده کنم."],[251,"عافیت می‌طلبد خاطرم ار بگذارند","غمزه شوخش و آن طره طرّار دگر","اگر اجازه دهند، دل من به دنبال آرامش و خوشی است و در این صورت، به آن چشم دلفریب و موهای فریبنده دیگر اهمیتی نمی‌دهد."],[251,"راز سربسته ما بین که به دستان گفتند","هر زمان با دف و نی بر سر بازار دگر","راز پنهان ما را که به دستان (دوستان) گفته‌اند، هر بار باید با دف و نی (با موسیقی و شادی) در بازار دیگری بازگو کنند."],[251,"هر دم از درد بنالم که فلک هر ساعت","کندم قصد دل ریش به آزار دگر","هر لحظه از درد فریاد می‌زنم، ولی به نظر می‌رسد که آسمان (فلک) هر ساعت قصد دارد که باز هم دل شکسته‌ام را به درد و آزار بیشتری دچار کند."],[251,"بازگویم نه در این واقعه حافظ تنهاست","غرقه گشتند در این بادیه بسیار دگر","حافظ می‌گوید که او تنها در این وضعیت دردناک نیست، بلکه افراد دیگری نیز در این مسیر سخت و پرچالش گرفتار شده‌اند."],[252,"ای خرّم از فروغ رخت لاله زار عمر","بازآ که ریخت بی گل رویت بهار عمر","ای خوشحال از نور چهره‌ات، باغ زندگی (عمر) سوگند می‌خورد برگرد که بدون گل روی تو، بهار عمر از بین رفته است."],[252,"از دیده گر سرشک چو باران چکد رواست","کاندر غمت چو برق بشد روزگار عمر","اگر اشک از چشم فرو بریزد، اشکالی ندارد، زیرا در غم تو روزگار عمر مانند برق می‌گذرد و از بین می‌رود."],[252,"این یک دو دم که مهلت دیدار ممکن است","دریاب کار ما که نه پیداست کار عمر","این لحظه کوتاه که امکان دیدار فراهم شده، را غنیمت بشمار و به حال ما بیندیش که کار زندگی‌مان ناامیدکننده و نامعلوم است."],[252,"تا کی می صبوح و شکرخواب بامداد","هشیار گرد، هان که گذشت اختیار عمر","تا کی تاخیر در بیداری و نوشیدن شراب صبحگاهی؟ بیدار شو، زیرا که زمان برای انتخاب و جوانی در حال گذر است و عمر به سرعت می‌گذرد."],[252,"دی در گذار بود و نظر سوی ما نکرد","بیچاره دل که هیچ ندید از گذار عمر","دیروز، عمر گذشت و به ما توجهی نکرد. دل فقیر ما که نتوانست چیزی از گذر زمان ببیند."],[252,"اندیشه از محیط فنا نیست هر که را","بر نقطه دهان تو باشد مدار عمر","هر کسی که زندگی‌اش حول و حوش تو و ارتباط با تو بچرخد، نمی‌تواند به اندیشه زوال و نابودی فکر کند؛ چراکه او در دنیای فانی غرق نمی‌شود و توجهش به توست."],[252,"در هر طرف ز خیل حوادث کمین‌گهیست","زان رو عنان‌گسسته دواند سوار عمر","زندگی پر از حوادث و خطرات مختلف است که هر کجا کمین کرده‌اند. به همین دلیل، سوار عمر نمی‌تواند کنترل و مهار زندگی‌اش را به دست بگیرد و مدام در حال دویدن و فرار است."],[252,"بی عمر زنده‌ام من و این بس عجب مدار","روز فراق را که نهد در شمار عمر","من بدون زندگی می‌گذرانم و این مسئله جالب است که روز جدایی را در شمار عمر حساب نکن."],[252,"حافظ سخن بگوی که بر صفحه جهان","این نقش ماند از قلمت یادگار عمر","حافظ درخواست می‌کند که بگوید و بنویسد چیزی که بر صفحه‌ی زندگی باقی بماند و یادگاری از عمر او باشد."],[253,"دیگر ز شاخ سرو سهی بلبل صبور","گلبانگ زد که چشم بد از روی گل به دور","بلبل صبور از درخت سرو بلند آوازه‌ای خواند که چشم بد از زیبایی گل دور باشد."],[253,"ای گل به شکر آن که تویی پادشاه حسن","با بلبلان بی‌دل شیدا مکن غرور","ای گل، به خاطر اینکه تو پادشاه زیبایی هستی، به بلبلان عاشق و بی‌دل مغرور نباش."],[253,"از دست غیبت تو شکایت نمی‌کنم","تا نیست غیبتی نبود لذّت حضور","از دوری و غیبت تو شکایت ندارم، زیرا تا زمانی که غیبت وجود دارد، لذت حضور تو نیز وجود نخواهد داشت."],[253,"گر دیگران به عیش و طرب خرّمند و شاد","ما را غم نگار بود مایه سرور","اگر دیگران از خوشی و شادی بهره‌مند هستند، برای ما غم محبوب باعث خوشحالی می‌شود."],[253,"زاهد اگر به حور و قصور است امیدوار","ما را شرابخانه قصور است و یار حور","اگر زاهد (مرد پارسا) به بهشت و نعمت‌های آن (حور و قصور) امیدوار است، ما در عوض شرابخانه و محبوب‌مان را داریم که برای ما بهترین نعمت‌هاست."],[253,"می خور به بانگ چنگ و مخور غصه ور کسی","گوید تو را که باده مخور گو هوالغفور","شراب بنوش و به صدای چنگ گوش کن و غصه نخور. اگر کسی به تو بگوید که باده نخور، بگو که خداوند بسیار بخشنده است."],[253,"حافظ شکایت از غم هجران چه می‌کنی؟","در هجر وصل باشد و در ظلمت است نور","حافظ به کسی که از غم جدایی شکایت می‌کند می‌گوید که در واقع جدایی و وصال در هم تنیده‌اند و حتی در تاریکی جدایی، نوری وجود دارد."],[254,"یوسف گم‌گشته بازآید به کنعان، غم مخور","کلبه احزان شود روزی گلستان، غم مخور","غمگین مباش؛ چرا که سرانجام یار زیبارو به منزل باز خواهد گشت و آن جایگاه که محل غم و اندوه است، روزی تبدیل به جایگاه شادی و شور و نشاط می­‌شود."],[254,"ای دل غمدیده، حالت به شود، دل بد مکن","وین سر شوریده باز آید به سامان غم مخور","ای دل اندوهگین، بد به خود راه مده و فکر و اندیشه­‌ی بد نکن؛ چرا که حالت خوب و روبراه خواهد شد، و این سر پریشان احوال، آرام و قرار خواهد گرفت."],[254,"گر بهار عمر باشد باز بر تخت چمن","چتر گل در سر کشی، ای مرغ خوشخوان غم مخور","ای پرنده‌­ی خوش­‌آواز، اندوهگین مباش؛ چرا که اگر بهار دیگری از عمرت باقی مانده باشد، دوباره چونان پادشاهی بر تختگاه چمن خواهی نشست و گل نیز وجود خود را چونان چتری در بالای سر تو نگاه خواهد داشت."],[254,"دور گردون گر دو روزی بر مراد ما نرفت","دائما یکسان نباشد حال دوران غم مخور","اگر طوفانی بیاد و سیلی راه بیفتد که همه چیز و همه کس را از بین ببرد اگر راننده و کشتیبان کشتی تو حضرت نوح باشد هیچ ترسی نداشته باش"],[254,"هان مشو نومید چون واقف نه‌ای از سرّ غیب","باشد اندر پرده بازی‌های پنهان غم مخور","از آنجا که از اسرار نهانی آگاه نیستی، پس آگاه باش که مبادا ناامید شوی، بدان که در پشت پرده­‌ی عالم غیب، نقش­‌ها و بازی­‌های بسیاری وجود دارد."],[254,"ای دل ار سیل فنا بنیاد هستی برکند","چون تو را نوح است کشتیبان، ز طوفان غم مخور","ای دل اگر مرگ و نابودی بخواهد چونان سیلی تمام هستی تو را از بین ببرد، بدان که تو ناخدایی چون نوح داری، پس از طوفان مترس و اندوهگین مشو."],[254,"در بیابان گر به شوق کعبه خواهی زد قدم","سرزنش‌ها گر کند خار مغیلان غم مخور","شوق رسیدن به کعبه تو را راهی بیابان‌­ها کرده است، بنابراین اگر در این مسیر خارهای بیابان شروع به ملامت و سرزنش تو کردند، اندوهی به دلت راه مده و صبور باش."],[254,"گرچه منزل بس خطرناک است و مقصد بس بعید","هیچ راهی نیست کآن را نیست پایان، غم مخور","اگر چه محل فرود کاروان جای بسیار سهمناکی است و مقصد بسیار دور، اما این را بدان که هیچ راهی نیست که بالاخره انتها نداشته باشد، بالاخره تمام راه­ها جایی به پایان می‌­رسند."],[254,"حال ما در فرقت جانان و ابرام رقیب","جمله می‌داند خدای حال‌گردان غم مخور","اندوهگین مباش؛ چرا که خدایی که اوضاع و احوال را دگرگون می­‌سازد و تغییر می‌­دهد، از حال و روز ما که دچار دوری از معشوق هستیم و رقیب آزارمان می‌­دهد به طور کامل خبر دارد."],[254,"حافظا در کنج فقر و خلوت شب‌های تار","تا بود وردت دعا و درس قرآن غم مخور","حافظ، تا وقتی در گوشه­‌ی نیاز و در میان شب­‌های تاریک و خلوت، ذکر لبت دعا و درس قرآن است، اندوهگین مباش."],[255,"نصیحتی کنمت بشنو و بهانه مگیر","هر آنچه ناصح مشفق بگویدت بپذیر","به تو پندی می‌دهم، گوش کن و بهانه میاور؛ هرچه آدم پندگوی مهربان به تو می‌گوید، عمل کن."],[255,"ز وصل روی جوانان تمتّعی بردار","که در کمینگه عمر است مکر عالم پیر","از معاشرت و حضور جوانان لذت ببر، زیرا بدی‌ها و مکرهای این دنیای کهنه و پرفن در کمین توست."],[255,"نعیم هر دو جهان پیش عاشقان بجوی","که این متاع قلیل است و آن عطای کثیر","اگر نعمت و خوشبختی دو دنیا را می‌خواهی آنرا در نزد عاشقان خواهی یافت، که این یکی ناچیز است و آن یکی خیلی زیاد."],[255,"معاشری خوش و رودی بساز می‌خواهم","که درد خویش بگویم به ناله بم و زیر","همدمی نیکو و ساز (عودی) هم‌نوا می‌خواهم که با ناله زیر و بم آن، دردهای خود را بگویم."],[255,"بر آن سرم که ننوشم می و گنه نکنم","اگر موافق تدبیر من شود تقدیر","قصد دارم باده‌نوشی را کنار بگذارم و از این پس گناه نکنم، اگر تقدیر و بخت با من بسازد!"],[255,"چو قسمت ازلی بی‌حضور ما کردند","گر اندکی نه به وفق رضاست خرده مگیر","چون‌که قسمت و سرنوشت ازلی را بی‌ما و بدون اجازه ما انجام دادند، اگر می‌بینی کمی برخلاف میل است، زیاد ایراد مگیر."],[255,"چو لاله در قدحم ریز ساقیا می و مشک","که نقش خال نگارم نمی‌رود ز ضمیر","ای ساقی، همچون لاله باده خوش‌عطر در جامم بریز چون هرکاری می‌کنم خیال و زیبایی یارم از خاطرم نمی‌رود."],[255,"بیار ساغر درّ خوشاب ای ساقی","حسود گو کرم آصفی ببین و بمیر","ای ساقی، باده ناب بیاور، به‌حسود نیز بگویید که کرم «آصف» را ببیند و بمیرد."],[255,"به عزم توبه نهادم قدح ز کف صد بار","ولی کرشمه ساقی نمی‌کند تقصیر","تا امروز صد بار باده‌نوشی را کنار گذاشته‌ام، اما کرشمه و ناز ساقی کوتاهی نمی‌کند."],[255,"می دوساله و محبوب چارده ساله","همین بس است مرا صحبت صغیر و کبیر","برای من همین کافی است که می دو ساله و محبوبی به سن چهارده سال را دارم و نیازی به همصحبتی با بزرگترها (صغیر و کبیر) ندارم."],[255,"دل رمیده ما را که پیش می‌گیرد؟","خبر دهید به مجنون خسته از زنجیر","چه کسی زنجیر دل دیوانه ما را می‌گیرد؟ به مجنون خسته از زنجیر خبر دهید تا زنجیر خود را بر دل دیوانه ما بنهد."],[255,"حدیث توبه در این بزمگه مگو حافظ","که ساقیان کمان ابرویت زنند به تیر","ای حافظ، حرف از توبه در این بزمگه مگو که ساقیان زیبارو با کمان ابرو تو را مجازات می‌کنند."],[256,"روی بنما و مرا گو که ز جان دل برگیر","پیش شمع آتش پروانه به جان گو درگیر","به من نشان بده و بگو که از دل و جان به خوبی دلبرانه دل را بگیر. در پیش شمع، پروانه به خاطر عشق و عاشقی به آتش دچار است."],[256,"در لب تشنه ما بین و مدار آب دریغ","بر سر کشته خویش آی و ز خاکش برگیر","برای وجود تشنه ما، هیچ آبی نیست و همین باعث تاسف است؛ بنابراین، ای عزیز، بیا و به یاد کشتگان عشق، غم‌انگیز بر خاک آنان بیفروز."],[256,"ترک درویش مگیر ار نبود سیم و زرش","در غمت سیم شمار اشک و رخش را زر گیر","هرگز بی‌خیال درویش میسری؛ اگرچه در غم تو نقره و طلا نباشد، اشک‌هایش را به شمار بیاور و چهره‌اش را به مانند طلا ارزشمند بدان."],[256,"چنگ بنواز و بساز ار نبود عود چه باک؟","آتشم عشق و دلم عود و تنم مجمر گیر","اگر عود نباشد، نگران نباش و چنگ را بنواز و موسیقی بساز، زیرا آتش من عشق است و دل من مانند چوب عود و بدنم مانند مجمر (محل سوزاندن چوب عود) است."],[256,"در سماع آی و ز سر خرقه برانداز و برقص","ور نه با گوشه رو و خرقه ما در سر گیر","در جمع‌های دوستانه شرکت کن و از دغدغه‌های دنیوی خود فاصله بگیر و با شادی و نشاط به رقص و پایکوبی بپرداز. در غیر این صورت، برو با خیالات ما زندگی رو سر کن."],[256,"صوف برکش ز سر و باده صافی درکش","سیم در باز و به زر سیمبری در بر گیر","ای صوفی، خرقه را از سر بردار و شراب صاف بنوش، در را باز کن تا وارد شوی و با زر به زیبایی‌ها آراسته شو."],[256,"دوست گو یار شو و هر دو جهان دشمن باش","بخت گو پشت مکن، روی زمین لشکر گیر","دوست به من بگو که یار من باش و در عین حال، با همه دنیا دشمن باش. به بخت خود بگو که پشت مرا خالی نکند و در این دنیا، در مقابل دشمنان بایستم."],[256,"میل رفتن مکن ای دوست دمی با ما باش","بر لب جوی، طرب جوی و به کف ساغر گیر","ای دوست، چنین مکن که بخواهی بروی و از ما دور شوی؛ لحظه‌ای با ما بمان و در کنار جوی آب خوش بگذران و از شادی بهره‌مند شو و در دستت جام شراب بگیر."],[256,"رفته گیر از برم و زآتش و آب دل و چشم","گونه‌ام زرد و لبم خشک و کنارم تر گیر","از من دور نشو و مرا رها نکن، زیرا دل من مشتعل است و اشک چشمم جاری. صورتم زرد شده و لب‌هایم خشک است، پس تو در کنار من بمان و به من توجه کن."],[256,"حافظ آراسته کن بزم و بگو واعظ را","که ببین مجلسم و ترک سر منبر گیر","حافظ می‌گوید که میزبان را برای برپایی جشن و میهمانی آماده کن و به واعظ بگو که بیا و نگاه کن به جمع ما و از درس و موعظه‌اش دوری کند."],[257,"هزار شکر که دیدم به کام خویشت باز","ز روی صدق و صفا گشته با دلم دمساز","هزار بار شکرگزاری می‌کنم که به خواسته خود رسیدم و از روی صداقت و خلوص، دلم با عشق یکی شده است."],[257,"روندگان طریقت ره بلا سپرند","رفیق عشق چه غم دارد از نشیب و فراز","افراد راه یافته به مسیر معنوی، در برابر سختی‌ها و مشکلات، مانند سپر عمل می‌کنند و برای دوستان عاشق، هیچ نگرانی از بالا و پایین‌های زندگی وجود ندارد."],[257,"غم حبیب نهان به ز گفت و گوی رقیب","که نیست سینه ارباب کینه‌، محرم راز","ارباب کینه‌: صاحب کینه‌، کسی که دشمنی و بغض در دل دارد."],[257,"اگر چه حسن تو از عشق غیر مستغنی‌ست","من آن نیم که از این عشق‌بازی آیم باز","هرچند زیبایی تو به عشق دیگران وابسته نیست، اما من آن نیستم که از این بازی عشق دست بکشم."],[257,"چه گویمت که ز سوز درون چه می‌بینم","ز اشک پرس حکایت که من نیم غمّاز","چطور برایت بگویم در دلم چه آتشی برپاست و چه رنجی می‌کشم؟ اگر می‌خواهی از حال و روزم باخبر شوی، از اشک‌هایم بپرس؛ چون من اهل بازگو کردن دردها و راز دلم نیستم."],[257,"چه فتنه بود که مشّاطه قضا انگیخت","که کرد نرگس مستش سیه به سرمه ناز","این چه فتنه‌ای بود که دست آرایشگر تقدیر به‌پا کرد؟ چه‌کسی ناز را هم‌چون سرمه بر چشمان مستش کشید؟"],[257,"بدین سپاس که مجلس منوّر است به دوست","گرت چو شمع جفایی رسد بسوز و بساز","به خاطر این نعمت که مجلس با وجود دوست روشن است، اگر در برابر تو مثل شمع، بی‌مهری ببینم، باید بسوزم و با آن کنار بیایم."],[257,"غرض کرشمه حسن است ور نه حاجت نیست","جمال دولت محمود را به زلف ایاز","هدف و مقصود، زیبایی و جاذبه‌ی حسن است وگرنه نیازی به زیبایی و جمال دولت محمود نیست که با زلف ایاز، وزیر معروفش، مقایسه شود."],[257,"غزل سرایی ناهید صرفه‌ای نبرد","در آن مقام که حافظ برآورد آواز","ناهید‌: ستاره خنیاگر زهره. صرفه‌بردن: پیشی گرفتن. مقام‌: مرتبه‌، جایگاه || پرده سرود (در موسیقی)."],[258,"منم که دیده به دیدار دوست کردم باز","چه شکر گویمت ای کارساز بنده نواز؟","من منم که به دیدن دوست چشم گشوده‌ام، پس چه شکری باید به تو بگویم، ای کسی که در کار بندگانت مهربانی و کمک‌کار هستی؟"],[258,"نیازمند بلا گو رخ از غبار مشوی","که کیمیای مراد است، خاک کوی نیاز","ای کسی که در پی نیاز و خواسته‌ات هستی، از غبار و مشکلات خود را عقب نکش، زیرا خاک این کوی نیاز، همچون کیمیا، می‌تواند آرزوهای تو را برآورده کند."],[258,"ز مشکلات طریقت عنان متاب ای دل!","که مرد راه نیندیشد از نشیب و فراز","ای دل! از چالش‌های مسیر عرفان و سیر و سلوک ناامید نشو، زیرا مردان واقعی در این راه به فراز و نشیب‌ها فکر نمی‌کنند."],[258,"طهارت ار نه به خون جگر کند عاشق","به قول مفتی عشقش درست نیست نماز","اگر عاشق با خون دل طهارت نگیرد ( کنایه از سختی کشیدن )، پس عاشق نمی‌تواند به گفته‌ی پیشوای عشق، نماز واقعی را به جا آورد."],[258,"در این مقام مجازی به جز پیاله مگیر","در این سراچه بازیچه، غیر عشق مباز","در این مرحله غیرواقعی و نمادین، فقط شراب را بگیر و در این مکان بازیچه‌وار، به غیر از عشق، چیزی را قبول نکن."],[258,"به نیم‌بوسه دعایی بخر ز اهل دلی","که کید دشمنت از جان و جسم دارد باز","از اهل دل (مردم دلسوخته و عاشق) تقاضا کن که با یک نیم‌بوسه دعا، تو را از آسیب و مکر دشمنت که می‌خواهد به جان و تن تو آسیب برساند، محافظت کند."],[258,"فکند زمزمه عشق در حجاز و عراق","نوای بانگ غزل‌های حافظ از شیراز","حبّ و عشق، چه در حجاز و چه در عراق، با غزل‌های حافظ از شیراز در حال پخش و زمزمه است."],[259,"ای سرو ناز حسن که خوش می‌روی به ناز","عشّاق را به ناز تو هر لحظه صد نیاز","ای سرو زیبای خوش‌چهره که با ناز به راه می‌روی، عشق‌ورزان به خاطر زیبایی و ناز تو هر لحظه به عشق و نیاز فراوان احساس می‌کنند."],[259,"فرخنده باد طلعت خوبت که در ازل","ببریده‌اند بر قد سروت قبای ناز","چهره زیبا و خوش‌برکت تو خوشا به حالش که در آغاز آفرینش، برای قدبلندی‌ات لباس ناز و زیبایی دوخته‌اند."],[259,"آن را که بوی عنبر زلف تو آرزوست","چون عود گو بر آتش سودا بسوز و ساز","هر کس که بوی خوش و دل‌انگیز زلف تو را می‌خواهد، مانند چوب عود است که وقتی بر آتش بیفتد، می‌سوزد و خوشبو می‌شود. در واقع، عشق و شوق به تو باعث می‌شود که او با همه آتش و دل‌سوزی، خود را تسلیم کند."],[259,"پروانه را ز شمع بود سوز دل، ولی","بی شمع عارض تو دلم را بود گداز","پروانه به خاطر شمع(نماد عشق و زیبایی) دچار سوزش و درد می‌شود، اما بدون شمع زیبایی تو، دلم به شدت می‌سوزد و در آتش حسرت می‌گدازد."],[259,"صوفی که بی تو توبه ز می کرده بود، دوش","بشکست عهد، چون در میخانه دید باز","صوفی که قبلا به خاطر دوری از تو از مشروب نوشیدن پرهیز کرده بود، شب گذشته پیمان خود را شکست و هنگامی که در میخانه را دوباره باز دید، نتوانست خود را کنترل کند."],[259,"از طعنه رقیب نگردد عیار من","چون زر اگر برند مرا در دهان گاز","نمی‌توانند بر ارزش من تاثیر بگذارند، مانند زری که حتی اگر در دهان سگی باشد، همچنان ارزش خود را حفظ می‌کند."],[259,"دل کز طواف کعبه کویت وقوف یافت","از شوق آن حریم ندارد سر حجاز","دل من که در اطراف کعبه وجود تو در حال گردش و پرستش است، به خاطر عشق به آن مکان مقدس، دیگر علاقه‌ای به سرزمین حجاز (مکه) ندارد."],[259,"هر دم به خون دیده چه حاجت وضو؟ چو نیست","بی طاق ابروی تو، نماز مرا جواز","هر لحظه از اشک چشمانم وضو کردن برایم چه فایده‌ای دارد؟ چون وقتی ابروی تو وجود ندارد، نمازم پذیرفته نیست."],[259,"چون باده باز بر سر خم رفت کف‌زنان","حافظ که دوش از لب ساقی شنید راز","حافظ وقتی باده نوشیده و به حال خوشی رسیده، با شوق و شادی به دور خم می‌رقصد و می‌گوید که در شب گذشته از ساقی (سرو نوشیدنی) یک راز را شنیده است."],[260,"درآ که در دل خسته، توان درآید باز","بیا که در تن مرده، روان درآید باز","بیا تا در دل دردمند من، زنده شود بیا تا تن مرده من دوباره جان بیابد"],[260,"بیا که فرقت تو، چشم من چنان در بست","که فتح باب وصالت مگر گشاید باز","بیا که دوری تو چنان چشمانم را بست که امید گشایش فقط در وصال دوباره توست."],[260,"غمی که چون سپه زنگ، ملک دل بگرفت","ز خیل شادی روم رخت زداید باز","غمی که چون سیاهی، دل را فراگرفته‌است و آن را روی روشن تو دوباره نورانی کند."],[260,"به پیش آینه دل هر آن چه می‌دارم","به جز خیال جمالت، نمی‌نماید باز","هر چه به دلم می‌نمایم بجز خیال روی زیبای تو را نمی‌خواهد."],[260,"بدان مثل که شب آبستن است روز از تو","ستاره می‌شمرم تا که شب چه زاید باز","مانند آن مثل که گفته‌اند که شب آبستن حوادث روز بعد است شب‌ها بیدار می‌مانم و ستارگان را می‌شمارم تا روز بعد چه شود."],[260,"بیا که بلبل مطبوع خاطر حافظ","به بوی گلبن وصل تو می‌سراید باز","بیا که بلبل طبع حافظ به آرزوی دیدن گلبن وصال تو شعر می‌سراید."],[261,"حال خونین دلان که گوید باز؟","وز فلک خون خم که جوید باز؟","چه کسی حال خونین‌دلان و دردمندان را می‌تواند شرح دهد؟ چه‌کس خون خم را از فلک و روزگار بجوید؟"],[261,"شرمش از چشم می پرستان باد","نرگس مست اگر بروید باز","شرم بر نرگس باد اگر با وجود چشم مست می‌پرستان باده‌نوش، بازهم بروید"],[261,"جز فلاطون خم نشین شراب","سرّ حکمت به ما که گوید باز؟","بجز شراب خم‌نشین که همچون افلاطون است، چه کسی می‌تواند راز حکمت را به ما بگوید؟"],[261,"هر که چون لاله کاسه گردان شد","زین جفا رخ به خون بشوید باز","هر کسی که به اندازه‌ی لاله (که ظاهری زیبا دارد) در برابر این بی‌محلی‌ها و جفای عشق تأمل کند، چهره‌اش از غم و رنج مانند خون رنگین خواهد شد."],[261,"نگشاید دلم چو غنچه اگر","ساغری از لبش نبوید باز","دل من مانند غنچه‌ای است که اگر ساغری از لب محبوب به من نرسد، باز نخواهد شد و محبتش را نشان نخواهد داد."],[261,"بس که در پرده چنگ گفت سخن","ببرش موی تا نموید باز","چون در ساز و موسیقی سخن بسیار گفته شده، باید موی خود را قیچی کند تا دوباره ظاهر نشود."],[261,"گرد بیت الحرام خم حافظ","گر نمیرد به سر بپوید باز","حافظ می‌گوید اگر کسی به گرد کعبه (بیت‌الحرام) بیفتد و در آنجا جان خود را از دست ندهد، دوباره به زندگی برمی‌گردد و به سوی آنجا خواهد شتافت."],[262,"بیا و کشتی ما در شط شراب انداز","خروش و ولوله در جان شیخ و شاب انداز","بیا و کشتی‌ام را در رودخانه شراب بینداز تا شور و شوق به جان پیر و جوان بیدار شود."],[262,"مرا به کشتی باده درافکن ای ساقی!","که گفته‌اند «نکویی کن و در آب انداز»","ای ساقی، مرا غرق در شراب کن (شراب بسیار بده)، چرا که گفته‌اند کار خوب کن و در آب بیندازد (اشاره به تو نیکی کن و در دجله انداز ...)."],[262,"ز کوی میکده برگشته‌ام ز راه خطا","مرا دگر ز کرم با ره صواب انداز","از مسیر نادرست بازگشته‌ام و به خاطر لطف و بخشش تو، مرا به راه درست هدایت کن."],[262,"بیار زآن می گلرنگ مشک‌بو جامی","شرار رشک و حسد در دل گلاب انداز","از آن شراب خوشبو و خوش‌رنگ، جامی بیاور که آتش حسد و رقابت را در دل گلاب بیفکند."],[262,"اگر چه مست و خرابم، تو نیز لطفی کن","نظر بر این دل سرگشته خراب انداز","با اینکه وضعی خراب و مست دارم، تو هم بر این دل آشفته و سرگردان نگاهی مهربانانه بینداز."],[262,"به نیم‌شب اگرت آفتاب می‌باید","ز روی دختر گل‌چهر رز، نقاب انداز","اگر در نیمه‌شب به آفتاب نیاز داری، نقاب دختر زیبای گل‌چهره را کنار بزن و به او نگاه کن."],[262,"مهل که روز وفاتم به خاک بسپارند","مرا به میکده بر، در خم شراب انداز","صبر کنید که روز مرگم مرا در خاک نگذارند، بلکه به میکده ببرند و در خمره شراب بیندازند."],[262,"ز جور چرخ چو حافظ به جان رسید دلت","به سوی دیو محن، ناوک شهاب انداز","چون سرنوشت به حافظ ظلم می‌کند و او به درد و رنج رسیده است، دلت را به سویی دیگر همچون شهاب (ستاره) بینداز تا از فکر و غم دور شوی."],[263,"خیز و در کاسه زر آب طربناک انداز","پیشتر زان که شود کاسه سر خاک‌ انداز","بیا و در کاسه زر‌، باده شادی‌بخش بریز پیش از آنکه کاسه سر ما پر از خاک گردد."],[263,"عاقبت منزل ما وادی خاموشان است","حالیا غلغله در گنبد افلاک انداز","عاقبت ما مردن و پیوستن به مردگان است پس الان به‌فکر این باش که غوغایی و شوری به‌پا کنی که در جهان بپیچد."],[263,"چشم آلوده‌نظر، از رخ جانان دور است","بر رخ او نظر از آینه پاک انداز","چشم‌ آلوده و ناپاک هرگز روی معشوق را نخواهد دید؛ او را در آینه زلال (دل پاک) ببین."],[263,"به سر سبز تو ای سرو که گر خاک شوم","ناز از سر بنه و سایه بر این خاک انداز","به جان سرسبز و شاد تو، ای سرو خوش‌قامت من؛ که وقتی درگذشتم و مردم به دیدار مزار من بیایی."],[263,"دل ما را که ز مار سر زلف تو بخست","از لب خود به شفاخانه تریاک انداز","سر زلف بافته تو همچون مار، دل ما را زخمی‌کرد پس با بوسه‌ای (یا کلامی) ما را شفا ببخش."],[263,"ملک این مزرعه دانی که ثباتی ندهد","آتشی از جگر جام، در املاک انداز","خود می‌دانی که این دنیا بی‌وفاست و پایدار نیست؛ پس عمر را صرف شادی و می‌گساری کن."],[263,"غسل در اشک زدم کاهل طریقت گویند","پاک شو اول و پس دیده بر آن پاک انداز","چشمانم را با اشک‌، غسل دادم و پاک‌کردم زیرا اهل سلوک و طریقت می‌گویند اول پاک شو، سپس لایق دیدار شو."],[263,"یا رب آن زاهد خودبین که به جز عیب ندید","دود آهیش در آیینه ادراک انداز","خدایا آن زاهد خودپرست که جز عیب‌جویی کاری نکرد ( و دل‌ها را شکست) دود یک آه (دل‌شکستگان) را در آینه ادراک او بینداز."],[263,"چون گل از نکهت او جامه قبا کن حافظ","وین قبا در ره آن قامت چالاک انداز","همچون گل، از نسیم عطر خوش یار، گریبان چاک کن ای حافظ، و جامه را در پای آن سرو روان بینداز. (جامه قبا کردن‌: گریبان چاک کردن)"],[264,"برنیامد از تمنّای لبت کامم هنوز","بر امید جام لعلت دردی‌آشامم هنوز","تمنای لب تو برایم به نتیجه نرسیده و هنوز از آنچه می‌خواهم بی‌نصیبم. همچنان به امید نوشیدن شراب از لعل (لب) تو هستم و هنوز حالت مستی‌ام ادامه دارد."],[264,"روز اول رفت دینم در سر زلفین تو","تا چه خواهد شد در این سودا سرانجامم هنوز","در روز اولی که عاشق زلف‌های تو شدم، دین و ایمانم از دست رفت. نمی‌دانم در این عشق چه خواهد شد و هنوز نمی‌دانم سرانجامم به کجا می‌رسد."],[264,"ساقیا یک جرعه‌ای زان آب آتش‌گون که من","در میان پختگان عشق او خامم هنوز","ای ساقی، یک جرعه از آن آب آتشین به من بده که من هنوز در میان عاشقانی که گرفتار عشق او هستند، ناپخته و خام مانده‌ام."],[264,"از خطا گفتم شبی زلف تو را مشک ختن","می‌زند هر لحظه تیغی مو بر اندامم هنوز","یک شب به اشتباه گفتم که بوی زلفت مانند مشک ختن است، اما هر لحظه با درد تیغی که روی اندامم می‌نشیند، این احساس همچنان برایم باقی مانده است."],[264,"پرتو روی تو تا در خلوتم دید آفتاب","می‌رود چون سایه هر دم، بر در و بامم هنوز","نور چهره‌ات وقتی که در تنهایی‌ام می‌تابد، مانند آفتاب است که همیشه حضور دارد و به صورت سایه‌ای در تمام جاهای خانه‌ام، که شامل در و بام می‌شود، حس می‌شود."],[264,"نام من رفته‌ست روزی بر لب جانان به سهو","اهل دل را بوی جان می‌آید از نامم هنوز","نام من به طور تصادفی روزی بر زبان محبوب (جانان) رفته است و اهل دل که عاشقان و عارفان هستند، هنوز هم از یاد آن نام، بویی از جان و حیات را حس می‌کنند."],[264,"در ازل داده‌ست ما را ساقی لعل لبت","جرعه جامی که من مدهوش آن جامم هنوز","در آغاز خلقت، ساقی با لب‌های سرخ تو جرعه‌ای به ما داده که من هنوز هم تحت تأثیر و شیفتگی آن جرعه هستم."],[264,"ای که گفتی جان بده تا باشدت آرام جان","جان به غم‌هایش سپردم، نیست آرامم هنوز","ای کسی که به من گفتی جان را فدای تو می‌کنم تا آرامش بیابم، من جانم را به غم‌هایش سپردم، اما هنوز آرامش ندارم."],[264,"در قلم آورد حافظ قصه لعل لبش","آب حیوان می‌رود هر دم ز اقلامم هنوز","حافظ در نوشته‌هایش داستان لعل لب محبوبش را به تصویر می‌کشد و می‌گوید که آب حیات هر لحظه از کلماتش جاری می‌شود، هنوز هم بر روی کاغذ وجود دارد."],[265,"دلم رمیده لولی‌وشیست شورانگیز","دروغ‌وعده و قتّال‌وضع و رنگ‌آمیز","دل من به خاطر معشوق زیبا و دلربایی که مانند لولی‌ها (دختران رقصنده) سرزنده و شاداب است، مضطرب و دلتنگ است. او وعده‌های دروغین می‌دهد و با کارهایش دروغ و نیرنگ را به تصویر می‌کشد و رنگ و لعاب به زندگی من می‌زند."],[265,"فدای پیرهن چاک ماهرویان باد","هزار جامه تقوی و خرقه پرهیز","من مایل هستم جانم را فدای پیراهنی کنم که بر تن ماهروها چاک است، زیرا این پیراهن از هزار جامه پرهیزگارانه و خرقه‌های تقوی نیز ارزشمندتر است."],[265,"خیال خال تو با خود به خاک خواهم برد","که تا ز خال تو خاکم شود عبیرآمیز","تصور و تصویر خال تو را با خود به خاک برمی‌برم تا به واسطه آن خال، خاک من نیز معطر و خوشبو شود."],[265,"فرشته عشق نداند که چیست، ای ساقی","بخواه جام و گلابی به خاک آدم ریز","فرشته عشق نمی‌داند عشق چیست، ای ساقی! بخواه که جام شراب و گلابی بر خاک آدم بریز."],[265,"پیاله بر کفنم بند، تا سحرگه حشر","به می ز دل ببرم هول روز رستاخیز","پیاله را بر روی کفنم بگذار تا در صبح روز رستاخیز با شراب، ترس و هراس آن روز را از دل بزدایم."],[265,"فقیر و خسته به درگاهت آمدم رحمی","که جز ولای توام نیست هیچ دست آویز","من به درگاه تو با حالتی خسته و درمانده آمده‌ام و تنها امید من به محبت و ولایت توست، زیرا هیچ چیز دیگری برای پناه به من نیست."],[265,"بیا که هاتف میخانه دوش با من گفت","که در مقام رضا باش و از قضا مگریز","هاتف (صدای ماورایی) در میخانه به من گفت که باید در مقام رضایت و خشنودی باشی و از مقدر خود فرار نکن."],[265,"میان عاشق و معشوق هیچ حائل نیست","تو خود حجاب خودی حافظ از میان برخیز","بین عاشق و معشوق هیچ مانعی وجود ندارد، فقط تو خودت سد راهت هستی، حافظ، از میان این موانع کنار برو."],[266,"ای صبا گر بگذری بر ساحل رود ارس","بوسه زن بر خاک آن وادی و مشکین کن نفس","ای نسیم صبا، اگر از کنار رود ارس عبور کردی، بر خاک آن سرزمین بوسه بزن و نفس خودت را از هوای آنجا عطرآگین کن"],[266,"منزل سلمی که بادش هر دم از ما صد سلام","پر صدای ساربانان بینی و بانگ جرس","خانه‌ی معشوق که هر لحظه از آن ما صد سلام بر آنجا باشد پرشور و به رونق است وصدای زنگ قافله ها در هر لحظه به گوش میرسد"],[266,"محمل جانان ببوس، آن‌گه به زاری عرضه دار","کز فراقت سوختم ای مهربان فریاد رس","محمل، بار و باربر جانان را ببوس، سپس با ناله و زاری بگو که به خاطر دوری تو، در آتش عشق سوختم، ای مهربان، به من کمک کن."],[266,"من که قول ناصحان را خواندمی قول رباب","گوش‌مالی دیدم از هجران که اینم پند بس","من به نصیحت‌های خوبان گوش داده‌ام، اما در اثر دوری از تو دلی پر از درد و رنج دارم که خود بهترین نصیحت است."],[266,"عشرت شب‌گیر کن، می نوش کاندر راه عشق","شب‌روان را آشنایی‌هاست با میر عسس","به جای اینکه در تنهایی و غم بگذرانیم، شب را با لذت و نوشیدن شراب بگذران، زیرا در مسیر محبت، شب‌نشینان با افسران نگهبانی آشنا هستند."],[266,"عشق‌بازی کار بازی نیست ای دل! سر بباز","زان که گوی عشق نتوان زد به چوگان هوس","ای دل! بازی با عشق شوخی و ساده نیست. باید بپذیری که نمی‌توان گوی عشق را با چوب هوس زد، زیرا این دو هرگز با هم همخوانی ندارند."],[266,"دل به رغبت می‌سپارد جان به چشم مست یار","گر چه هشیاران ندادند اختیار خود به کس","دل با میل و اشتیاق خود را به معشوق می‌سپارد و جانش را به چشمان مست او تقدیم می‌کند، هرچند افراد خردمند اختیار خود را به هیچ‌کس نمی‌دهند."],[266,"طوطیان در شکّرستان کامرانی می‌کنند","و از تحسّر دست بر سر می‌زند مسکین مگس","طوطی‌ها در باغ شکر مشغول خوشی و شادی هستند، در حالی که مگس بیچاره از حسرت به سر می‌زند و ناراحتی خود را نشان می‌دهد."],[266,"نام حافظ گر برآید بر زبان کلک دوست","از جناب حضرت شاهم بس است این ملتمس","اگر نام حافظ بر سر زبان قلم دوست بیفتد، همین که به خاطر جناب شاه ذکر شود، کافی است."],[267,"گلعذاری ز گلستان جهان ما را بس","زین چمن سایه آن سرو روان ما را بس","گلی از گلستان دنیا برای ما کافی است و سایه آن سرو خوش قامت نیز برای ما بس‌اندازه است."],[267,"من و همصحبتی اهل ریا دورم باد","از گرانان جهان، رطل گران ما را بس","من از دوستی با آدم‌های ریاکار و نفاق دور هستم و به دلیل این که ما زندگی بی‌پروایی داریم، نیازی به داشتن مال و ثروت زیاده از حد در این دنیا نیست."],[267,"قصر فردوس به پاداش عمل می‌بخشند","ما که رندیم و گدا، دیر مغان ما را بس","بهشت به خاطر اعمال خوب پاداش می‌دهد، اما ما که آدم‌های رندو بی‌بضاعت هستیم، داشتن معبد مغان (معبد زرتشتیان) برای ما کافی است."],[267,"بنشین بر لب جوی و گذر عمر ببین","کاین اشارت ز جهان گذران، ما را بس","بر کنار جوی بنشین و گذر عمر را تماشا کن؛ این نشانه‌ها و عبرت‌ها از دنیا که مدام در حال تغییر است، برای ما کافی است."],[267,"نقد بازار جهان بنگر و آزار جهان","گر شما را نه بس این سود و زیان ما را بس","به دقت به وضعیت و شرایط این دنیا بنگرید و با رنج و دردهای آن آشنا شوید. اگر این حالت‌ها برای شما کافی نیست، برای ما فقط این سود و زیان در این دنیا کافی است."],[267,"یار با ماست، چه حاجت که زیادت طلبیم؟","دولت صحبت آن مونس جان ما را بس","یار با ماست، پس چه نیازی به چیزهای بیشتر داریم؟ داشتن گفتگو و همراهی آن دوست که روح‌مان را شاد می‌کند، برای ما کافی است."],[267,"از در خویش خدا را به بهشتم مفرست","که سر کوی تو از کون و مکان ما را بس","خدا را به بهشت خود نفرست که وجود و زیبایی کوی تو برای ما کافی است و نیازی به جای دیگری نداریم."],[267,"حافظ از مشرب قسمت گله ناانصافیست","طبع چون آب و غزل‌های روان ما را بس","حافظ می‌گوید که از مشرب قسمت (سهم و سرنوشت) دل‌تنگ است و می‌خواهد که طبیعتش، همچون آب، روان و شفاف باشد؛ بنابراین، نیاز به غزل‌های زیبا و دلنشین دارد تا این دل‌تنگی و ناانصافی را جبران کند."],[268,"دلا، رفیق سفر بخت نیکخواهت بس","نسیم روضه شیراز، پیک راهت بس","ای دل، دوست خوب تو باید در این سفر خوش‌اقبالی‌ات باشد، نسیم خوشبو و دل‌انگیز باغ‌های شیراز هم، پیام‌آور راه تو است."],[268,"دگر ز منزل جانان سفر مکن درویش","که سیر معنوی و کنج خانقاهت بس","به درویش بگو که از منزل محبوبش جدا نشود، زیرا سیر و سلوک معنوی و عبادتش در خلوتگاه خانقاهش کافی و مناسب است."],[268,"وگر کمین بگشاید غمی ز گوشه دل","حریم درگه پیر مغان، پناهت بس","اگر غمی از گوشه دل بیدار شود، پناهی که در درگاه پیر مغان یافتی، کافی است."],[268,"به صدر مصطبه بنشین و ساغر می‌ نوش","که این قدر ز جهان، کسب مال و جاهت بس","بر روی سکوی زیبا بنشین و جام می را بنوش، زیرا به‌اندازه‌ای که توانسته‌ای از دنیا اموال و مقام به‌دست بیاوری، کافی است."],[268,"زیادتی مطلب، کار بر خود آسان کن","صراحی می لعل و بتی چو ماهت بس","زیاد صحبت کردن و بحث کردن درباره مسائل بی‌خود، کار را برای خودت دشوار می‌سازد. بنابراین، برای لذت و راحتی، جام شراب قرمز (می لعل) و معشوقی زیبا چون ماه کافی است."],[268,"فلک به مردم نادان دهد زمام مراد","تو اهل فضلی و دانش، همین گناهت بس","آسمان به انسان‌های نادان سرنوشت و خواسته‌های تو را می‌دهد، ولی تو اهل فضیلت و علم هستی و همین ویژگی‌ات کافی است که گناهکار شوی."],[268,"هوای مسکن مألوف و عهد یار قدیم","ز رهروان سفرکرده، عذرخواهت بس","علاقه به سرزمین و خانه‌ای که برای او آشنا بوده و همچنین یاد دوستان قدیمی‌اش، از مسافران گذشته بهانه‌ای کافی برای معذرت‌خواهی از تو است."],[268,"به منّت دگران خو مکن که در دو جهان","رضای ایزد و انعام پادشاهت بس","به خاطر مهربانی دیگران وابسته نشو، زیرا در این دو جهان، خشنودی خدای بزرگ و بخشش پادشاه برای تو کافی است."],[268,"به هیچ ورد دگر نیست حاجت ای حافظ","دعای نیم‌شب و درس صبحگاهت بس","ای حافظ، به هیچ ذکر و دعای دیگری نیاز نیست؛ تنها دعای نیمه‌شب و درس صبحگاهت کافی است."],[269,"درد عشقی کشیده‌ام که مپرس","زهر هجری چشیده‌ام که مپرس","عشق و حسرتی را تجربه کرده‌ام که قابل توصیف نیست و زهر جدایی را نیز چشیده‌ام که نمی‌توان گفت."],[269,"گشته‌ام در جهان و آخر کار","دلبری برگزیده‌ام که مپرس","در طول زندگی‌ام سفرهای زیادی کرده‌ام و در نهایت، به عشق و دلبری رسیده‌ام که برایم از اهمیت ویژه‌ای برخوردار است و توضیح بیشتری درباره‌اش نمی‌دهم."],[269,"آن چنان در هوای خاک درش","می‌رود آب دیده‌ام که مپرس","چنان اشک‌هایم به یاد آن یار جاری است که هیچ چیزی نمی‌تواند این احساس را توصیف کند."],[269,"من به گوش خود از دهانش دوش","سخنانی شنیده‌ام که مپرس","من دیشب از او صحبت‌هایی را شنیدم که بهتر است درباره‌شان چیزی نپرسی."],[269,"سوی من لب چه می‌گزی که مگوی","لب لعلی گزیده‌ام که مپرس","چرا به من نگاهی می‌کنی و چیزی نمی‌گویی، در حالی که من از لب معشوق زیبا سخن‌ها دارم که نمی‌توانم بگویم؟"],[269,"بی تو در کلبه گدایی خویش","رنج‌هایی کشیده‌ام که مپرس","بدون حضور تو در زندگی‌ام، در خانه‌ای فقیرانه دچار درد و زحماتی شده‌ام که دیگر نپرس."],[269,"همچو حافظ غریب در ره عشق","به مقامی رسیده‌ام که مپرس","مانند حافظ، که در مسیر عشق سختی‌های زیادی را تحمل کرده و به جایگاهی رسیده، من نیز به مقام و حالتی خاص دست یافته‌ام که قابل توضیح نیست."],[270,"دارم از زلف سیاهش گله چندان که مپرس","که چنان ز او شده‌ام بی سر و سامان که مپرس","از زلف‌های سیاه محبوبم آن‌قدر شکایت دارم که به گفتن نیاز نیست؛ چرا که به خاطر او به حالی پریشان و آشفته دچار شده‌ام که توضیح نمی‌خواهد."],[270,"کس به امّید وفا ترک دل و دین مکناد","که چنانم من از این کرده پشیمان که مپرس","هیچ‌کس به امید وفاداری، دل و دین خود را رها نکند، زیرا من از این کار بسیار پشیمان هستم و حالتی بسیار بد دارم."],[270,"به یکی جرعه که آزار کسش در پی نیست","زحمتی می‌کشم از مردم نادان که مپرس","در این بیت، حافظ می‌گوید که برای نوشیدن یک جرعه شراب که کسی از آن آزار نمی‌بیند، از نادانی‌های برخی از مردم رنج می‌برم و لازم نیست درباره این زحمت از من بپرسی."],[270,"زاهد از ما به سلامت بگذر کـ‌این می لعل","دل و دین می‌برد از دست بدان سان که مپرس","ای زاهد، تو با ما به سلامت بگذر، زیرا این شراب خوش‌رنگ (می لعل) که دل و دین را می‌رباید، باعث بروز مشکلاتی می‌شود که بهتر است درباره‌اش سؤالی نپرسی."],[270,"گفت‌وگوهاست در این راه که جان بگدازد","هر کسی عربده‌ای این که مبین آن که مپرس","در این مسیر صحبت‌ها و بحث‌هایی وجود دارد که هر کسی ممکن است جان خود را فدا کند، اما نیازی نیست به جزئیات این عربده‌ها و ادعاها توجه کنی."],[270,"پارسایی و سلامت هوسم بود، ولی","شیوه‌ای می‌کند آن نرگس فتّان که مپرس","به زهد ورزی و ایمنی از بلای عشق میل داشتم، اما آن نرگس دیده ی فتنه‌انگیز چنان کرشمه ای میکند و دل میبرد که از حد پرسش فراتر است."],[270,"گفتم از گوی فلک صورت حالی پرسم","گفت آن می‌کشم اندر خم چوگان که مپرس","من از کره آسمان خواستم حالتی را بپرسم، او گفت که در پیچه چوگان (بازی که با چوب و توپ انجام می‌شود) مشغول می‌نوشم، پس در این باره سوال نکن."],[270,"گفتمش زلف به خون که شکستی؟ گفتا","حافظ این قصه دراز است به قرآن که مپرس","از او پرسیدم که زلف چه کسی را با خون شکسته‌ای؟ او پاسخ داد: حافظ، این داستان خیلی طولانی است و بهتر است به قرآن سوگند بخوانی که نپرس."],[271,"باز آی و دل تنگ مرا مونس جان باش","وین سوخته را محرم اسرار نهان باش","بازگرد و همراه دل دل‌شکسته من باش و رازدار این آسیب‌دیده عشق‌ ورزیده باش."],[271,"زآن باده که در میکده عشق فروشند","ما را دو سه ساغر بده و گو «رمضان باش»","از آن شرابی که در میکده عشق عرضه می‌شود، به ما دو یا سه لیوان بده و بگو که در حال «رمضان» باش. منظور این است که در حالی که به ما شراب می‌دهی، بر رعایت حرمت ماه رمضان هم تأکید کن."],[271,"در خرقه، چو آتش زدی ای عارف سالک!","جهدی کن و سرحلقه رندان جهان باش","ای عارف در راه سیر و سلوک، اگر در دل خود شوق و محبت را شعله‌ور کرده‌ای، تلاش کن تا در جمع رندان و خوش‌گذران جهان، پیشتاز و سرآمد باشی."],[271,"دلدار که گفتا به توام دل‌نگران است","گو «می‌رسم اینک به سلامت»، نگران باش","دلدار (محبوب) به من گفت که او نگران حال من است، بنابراین بگو که حالا به سرعت به سلامت می‌رسم و تو نگران نباش."],[271,"خون شد دلم از حسرت آن لعل روان‌بخش","ای درج محبّت! به همان مهر و نشان باش","دل من از حسرت آن لب‌های دل‌چسب و شاداب به شدت غمگین و بی‌قرار است، ای گنجینه عشق! همان‌طور که قبلا بودی، ادامه بده و به همان شکل باقی بمان."],[271,"تا بر دلش از غصه غباری ننشیند","ای سیل سرشک! از عقب نامه روان باش","ای سیل سرشک! تا زمانی که غم و اندوه بر دل او ننشیند، نامه‌ها را با شتاب و سرعت بفرست."],[271,"حافظ که هوس می‌کندش جام جهان‌بین","گو «در نظر آصف جمشید‌مکان باش»","حافظ که هوس جام جهان‌بین را کرده‌است؛ به او بگویید در نظر و دید آصف جمشید‌مکان قرار بگیرد (و مورد لطف او واقع شود)"],[272,"اگر رفیق شفیقی، درست پیمان باش","حریف خانه و گرمابه و گلستان باش","اگر دوستی مانند شفیق و صمیمی داری، باید به خوبی و با وفا در برابر او بایستی و باید در مکان‌های خوشایند و دلپذیر مانند خانه، حمام و باغ، با هم دوستانه رفتار کنید."],[272,"شکنج زلف پریشان به دست باد مده","مگو که «خاطر عشّاق گو پریشان باش»","مواظب زلف پریشان معشوقه‌ات باش و آن را به دست باد نده، زیرا برای عاشقان، دل‌شان نباید پریشان باشد."],[272,"گرت هواست که با خضر هم‌نشین باشی","نهان ز چشم سکندر چو آب حیوان باش","اگر آرزوی هم‌صحبتی با خضر را داری، باید به‌گونه‌ای پنهان از چشم اسکندر، مانند آب حیات، باشی. یعنی باید در جستجوی علم و معرفت به دور از چشم‌پوشی و توجه‌های دیگران حرکت کنی."],[272,"زبور عشق نوازی نه کار هر مرغی است","بیا و نوگل این بلبل غزل‌خوان باش","شعر عشق و سرودن آن، کاری نیست که هر کسی بتواند انجام دهد؛ بیا و با این بلبل که در غزل‌خوانی ماهر است، همراهی کن و سرود عشق را بخوان."],[272,"طریق خدمت و آیین بندگی کردن","خدای را که رها کن به ما و سلطان باش","ترجمه دلی : خداوندا راه و روش خدمت کردن به خودت و سنت و آیین بندگی کردنت را به ما عطا کن و خودت پادشاهی کن"],[272,"دگر به صید حرم تیغ برمکش، زنهار","وز آن که با دل ما کرده‌ای پشیمان باش","دیگر به شکار حرم نرو، ای زنهار، و از کسی که با دل ما بازی کرده است، پشیمان باش."],[272,"تو شمع انجمنی، یک‌زبان و یک‌دل شو","خیال و کوشش پروانه بین و خندان باش","تو نور زندگی هستی و باید با همه همدل و هم‌زبان باشی. به یاد داشته باش که تلاش و آرزوی کسی مثل پروانه برای رسیدن به شمع، باید تو را شاد و خندان کند."],[272,"کمال دل‌بری و حسن در نظربازی است","به شیوه نظر، از نادران دوران باش","دلربایی و زیبایی کامل در جذابیت و بازی‌های نگاه است، پس با شیوه‌های نگاه، از جمله کسانی باش که در زمانه خود نادر و کمیاب هستند."],[272,"خموش حافظ و از جور یار ناله مکن","تو را که گفت که در روی خوب، حیران باش؟","حافظ به خود می‌گوید که از بی‌رحمی و ظلم یار گله نکند و خاموش بماند، چرا که یار خود به او گفته است که در کنار زیبایی چهره‌اش باید شگفت‌زده و حیران باشد."],[273,"به دور لاله، قدح گیر و بی‌ریا می‌باش","به بوی گل، نفسی همدم صبا می‌باش","برای شادابی و لذت بردن از جوانی و زیبایی (نماد آن لاله و گل)، لحظه‌ای عمیقا به زندگی بیندیش و درخود ساده و بی‌تظاهر باش؛ همچنین در کنار نسیم صبحگاهی (صبا) لحظه‌ای را به آرامش و نزدیکی به طبیعت بگذران."],[273,"نگویمت که همه ساله می پرستی کن","سه ماه می خور و نه ماه پارسا می‌باش","به من نگو که هر سال فقط سه ماه نوشیدن می کافی است، نه، در نه ماه دیگر نیز باید در زندگی پارسا و پرهیزگار باشی."],[273,"چو پیر سالک عشقت به می حواله کند","بنوش و منتظر رحمت خدا می‌باش","وقتی آن راهنمای باتجربه (پیر سالک) عشق تو را به شراب (می) حواله می‌دهد، بنوش و در عین حال به رحمت خدا امیدوار باش."],[273,"گرت هواست که چون جم به سرّ غیب رسی","بیا و همدم جام جهان‌نما می‌باش","اگر علاقه‌ داری که مانند جم، کنجکاوی به رازهای پنهان پیدا کنی، به سراغ جامی که دنیا را نشان می‌دهد برو و همراه آن باش."],[273,"چو غنچه گر چه فروبستگی‌ست کار جهان","تو همچو باد بهاری گره‌گشا می‌باش","اگرچه دنیا به مانند غنچه‌ای بسته و محدود است، تو باید مانند یک نسیم بهاری باشی که گره‌ها را می‌گشاید و آزادگی و شکوفایی را به ارمغان می‌آورد."],[273,"وفا مجوی ز کس ور سخن نمی‌شنوی","به هرزه طالب سیمرغ و کیمیا می‌باش","به هیچ‌کس انتظار وفا نداشته باش و اگر به حرف‌های دیگران گوش نمی‌دهی، بیهوده در پی آرزوهای غیرواقعی مانند سیمرغ (پرنده‌ای افسانه‌ای) و کیمیا (سنگ جادو) نباش."],[273,"مرید طاعت بیگانگان مشو حافظ","ولی معاشر رندان پارسا می‌باش","حافظ به کسی می‌گوید که تحت تأثیر رابطه‌های بی‌معنی و افرادی که به او وفادار نیستند قرار نگیرد و به جای آن با مردم آزاداندیش و پارسا معاشرت کند."],[274,"صوفی گلی بچین و مرقّع به خار بخش","وین زهد خشک را به می خوشگوار بخش","ای صوفی، گلی را بچین و با خاری که همراهش است، به دیگران ببخش و این زهد خشک و بی‌روح را با شراب خوشگوار عوض کن."],[274,"طامات و شطح در ره آهنگ چنگ نه","تسبیح و طیلسان به می و میگسار بخش","افکار پیچیده و توهمات را در مسیر جنبش چنگ (آهنگ) رها کن و به جای آن، تسبیح و لباس روحانی را به شراب و ساقی کهن واگذار کن."],[274,"زهد گران که شاهد و ساقی نمی‌خرند","در حلقه چمن به نسیم بهار بخش","زهد و پارسایی سخت‌گیر که به عشق و می و معشوق توجهی ندارد، در جمع عاشقان و در فضای دلپذیر بهار جایی ندارد."],[274,"راهم شراب لعل زد ای میر عاشقان","خون مرا به چاه زنخدان یار بخش","ای عشق و سرور من، راه من را با شراب قرمز (شراب لعل) پر کن. ای محبوب عاشقان، خون من را به چاه زلف یار منتقل کن، تا جایی که زلفش شبیه به چاه است."],[274,"یا رب به وقت گل، گنه بنده عفو کن","وین ماجرا به سرو لب جویبار بخش","خدایا، در زمان گل‌انگیزی، گناه‌های من را ببخش و این ماجرای عشق و زیبایی را به لب جویبار هدیه بده."],[274,"ای آن که ره به مشرب مقصود برده‌ای","زین بحر، قطره‌ای به من خاکسار بخش","ای کسی که راهی به منبع مقصود و مقصد نهایی نشان داده‌ای، از این دریای بی‌پایان، یک قطره از رحمت و لطف خود را به من کوچک و بی‌مایه عطا کن."],[274,"شکرانه را که چشم تو روی بتان ندید","ما را به عفو و لطف خداوندگار بخش","اگر چه چشم تو زیبایی‌های دلربا را نمی‌بیند، اما ما را به خاطر لطف و بخشش خداوند ببخش."],[274,"ساقی چو شاه نوش کند باده صبوح","گو جام زر به حافظ شب زنده دار بخش","ساقی، وقتی که شاه شراب بنوشد، باده صبحگاهی را به ما بدهد و جام زرین را به حافظ، که شب‌ها بیداری دارد، هدیه کند."],[275,"باغبان گر پنج‌روزی صحبت گل بایدش","بر جفای خار هجران صبر بلبل بایدش","باغبان اگر بخواهد پنج روز با گل‌ها صحبت کند، باید بر نامردی و زخم خارهای دوری از محبوب صبر کند، مانند بلبل."],[275,"ای دل اندر بند زلفش از پریشانی منال","مرغ زیرک چون به دام افتد تحمل بایدش","ای دل، در گرفتار زلف معشوق نگریز و ناراحت نباش؛ زیرا مرغ زیرکی که به دام می‌افتد، باید تحمل کند و صبر پیشه کند."],[275,"رند عالم‌سوز را با مصلحت‌بینی چه‌کار؟","کار ملک است آن که تدبیر و تأمل بایدش","شخص رند و آزاداندیش که از نظر روحی و عاطفی دچار عواطف و احساسات عمیق است، نیازی به مصلحت‌اندیشی ندارد. کسانی که در حکومت و امور دنیوی مشغول‌اند، باید از تدبیر و تفکر برای اداره کارهای خود استفاده کنند."],[275,"تکیه بر تقوی و دانش در طریقت کافری‌ست","راهرو گر صد هنر دارد توکل بایدش","تکیه‌کردن بر تقوی و دانش در مسیر عرفانی نشانه کفر است و کسی که در این راه قدم می‌گذارد، هرچند که صاحب استعداد و هنرهای بسیار باشد، باید به توکل بر خداوند تکیه کند."],[275,"با چنین زلف و رخش بادا نظربازی حرام","هر که روی یاسمین و جعد سنبل بایدش","هر کسی با چنین زلف و چهره زیبا مانند او، نباید به بازی با نگاه‌های عاشقانه بپردازد، زیرا باید فقط به روی گل یاسمن و مجعد بودن سنبل (به عنوان نماد زیبایی) توجه کند."],[275,"نازها زان نرگس مستانه‌اش باید کشید","این دل شوریده تا آن جعد و کاکل بایدش","دل شوریده‌ام باید به ناز و عنایت‌های او (نرگس مستانه) پاسخ دهد و این عشق و زیبایی که دارد به جعد و کاکلش (موهای مجعد) مربوط می‌شود."],[275,"ساقیا در گردش ساغر تعلل تا به چند؟","دور چون با عاشقان افتد تسلسل بایدش","ساقی، چرا تا این اندازه در خدمت دادن شراب تأخیر می‌کنی؟ وقتی که گردش ساغر به دور عاشقان می‌افتد، باید بی‌وقفه ادامه یابد."],[275,"کیست حافظ تا ننوشد باده بی‌آواز رود؟","عاشق مسکین چرا چندین تجمل بایدش؟","چرا حافظ بی مطرب و ساز، باده نمی‌نوشد؟ چرا عاشق‌های بی‌نوا و مسکین اینقدر تجمل‌خواه هستند؟!"],[276,"فکر بلبل همه آن است که گل شد یارش","گل در اندیشه که چون عشوه کند در کارش","عاشق چون بلبل فقط به این فکر می‌کند که معشوق چون گل با او یار شده. اما معشوق در اندیشه است که حالا چگونه با او بازی و عشوه‌گری کند."],[276,"دلربایی همه آن نیست که عاشق بکشند","خواجه آن است که باشد غم خدمتکارش","دلربایی که فقط عاشق کشی نیست. بلکه مهتر و بزرگ کسیست که به فکر کهترش باشد."],[276,"جای آن است که خون موج زند در دل لعل","زین تغابن که خزف می‌شکند بازارش","به جاست اگر دل خون شود از این ضرر و زیانی که بازارش را بر هم زده. (سفال شکستن کنایه است از بی ارزش کردن)"],[276,"بلبل از فیض گل آموخت سخن، ور نه نبود","این همه قول و غزل تعبیه در منقارش","بلبل به خاطر زیبایی و لطفی که از گل دریافت کرده، صحبت کردن را آموخته است؛ وگرنه این همه شعر و سخن زیبا که در منقار اوست، وجود نداشت."],[276,"ای که در کوچه معشوقه ما می‌گذری","بر حذر باش، که سر می‌شکند دیوارش","ای کسی که در کوچه‌ی محبوب ما می‌گذری( کوچه‌ای تنگ و پر پیچ و خم است) بدان که زیبایی معشوق ما چنان مسحور کننده است که چشم از او بر نخواهی گرفت و در حیرانی تماشای او دیوار را نخواهی دید و سرت را آسیب میزنی."],[276,"آن سفرکرده که صد قافله دل همره اوست","هر کجا هست خدایا به سلامت دارش","خدایا ناجی موعود را به سلامت دار."],[276,"صحبت عافیتت گرچه خوش افتاد ای دل","جانب عشق عزیز است، فرومگذارش","ای دل، اگرچه صحبت درباره خوشی و راحتی (عافیت) خوب و خوشایند است، اما باید توجه داشته باشی که عشق و محبت واقعی بسیار ارزشمندتر است و نباید آن را نادیده بگیری."],[276,"صوفی سرخوش از این دست که کج کرد کلاه","به دو جام دگر آشفته شود دستارش","صوفی‌ای که خوشحال از حال خود، سرش را کج کرده و کلاه خود را بر دو جام شراب خم کرده است، ممکن است به خاطر این کارش، دستار (عقال یا شال) او به هم بریزد و نامنظم شود."],[276,"دل حافظ که به دیدار تو خوگر شده بود","نازپرورد وصال است، مجو آزارش","دل حافظ که عادت به دیدار تو پیدا کرده است، از عشق و وصال نازپرورد است، پس او را اذیت نکن."],[277,"شراب تلخ می‌خواهم که مردافکن بود زورش","که تا یک دم بیاسایم ز دنیا و شر و شورش","به شراب تلخی با قدرت خیلی زیاد نیاز دارم تا برای حتی یک لحظه از دنیا و مشکلاتش فارغ شوم."],[277,"سماط دهر دون‌پرور ندارد شهد آسایش","مذاق حرص و آز ای دل، بشو از تلخ و از شورش","در سفره دنیایی که همواره چیز های رذل می پروراند، شهد و شیرینی آرامشی نیست، پس ای دل! دست از طمع و حرصی که نتیجه اش در این دنیا مشکل است بردار."],[277,"بیاور می که نتوان شد ز مکر آسمان ایمن","به لعب زهره چنگیّ و مرّیخ سلحشورش","شراب را بیاورید که از حیله آسمان و زمانه با بازی زهره رقاصه و مریخ جنگجو نمی توان ایمن شد."],[277,"کمند صید بهرامی بیفکن، جام جم بردار","که من پیمودم این صحرا، نه بهرام است و نه گورش","جام جم را با دام و طناب به شیوه بهرام شکار کن؛ زیرا من با طی کردن این صحرا دانستم که نه بهرامی در کار است و نه گور او (به احتمال زیاد منظور گورخر هایی هستند که شاه بهرام به شکارشان علاقه داشته)."],[277,"بیا تا در می صافیت راز دهر بنمایم","به شرط آن که ننمایی به کج‌طبعان دل‌کورش","من اسرار این دنیا و زمانه را در شراب زلال به تو نشان می دهم؛ به این شرط که این اسرار را به کسانی که چشم دلشان کور است و طبع والایی ندارند، نشان ندهی."],[277,"نظر کردن به درویشان منافیّ بزرگی نیست","سلیمان با چنان حشمت، نظرها بود با مورش","اهمیت به انسان های فقیر، باعث از بین رفتن بزرگی نمی شود و مغایر با بزرگی نیست؛ حتی سلیمان نبی با آن عظمت و جلال، به مورچه ها اهمیت می داد."],[277,"کمان ابروی جانان نمی‌پیچد سر از حافظ","ولیکن خنده می‌آید، بدین بازوی بی‌زورش","ابرو و زیبایی یار، روی از حافظ بر نمی گرداند و نافرمانی نمی کند، ولی به این ناتوانی او می خندد."],[278,"خوشا شیراز و وضع بی‌مثالش","خداوندا نگه دار از زوالش","شیراز، این شهر با ویژگی‌های منحصر به فردش، بسیار زیبا و دلپذیر است. خدایا، این شهر را از زوال و نابودی حفظ کن."],[278,"ز رکن آباد ما صد لوحش الله","که عمر خضر می‌بخشد زلالش","آب رکن آباد شیراز( نام یک رود) چنان زلال و زیباست که گویی مانند چشمه جاودانگی عمری به اندازه حضرت خضر به شما می‌بخشد"],[278,"میان جعفرآباد و مصلّا","عبیرآمیز می‌آید شمالش","از سوی جعفرآباد(نام یک منطقه) و مصلا( نام یک پارک در زمان حافظ) ، بوی بسیار خوشی می‌آید"],[278,"به شیراز آی و فیض روح قدسی","بجوی از مردم صاحب کمالش","به شیراز بیا و از روح مقدس و معنوی را از مردم با کمال آنجا بهره‌مند شو."],[278,"که نام قند مصری برد آنجا؟","که شیرینان ندادند انفعالش","چه کسی نام قند مصری را در آنجا برد؟ قند مصری از شیرین سخنی مردم اینجا شرمنده شده است"],[278,"صبا زان لولی شنگول سرمست","چه داری آگهی؟ چون است حالش؟","نسیم صبحگاهی چه خبری از آن آوازه‌خوان شاد و سرمست دارد؟ حال و روز او چطور است؟"],[278,"گر آن شیرین پسر خونم بریزد","دلا چون شیر مادر کن حلالش","اگر آن شیرین‌سخن من خون من را بریزد، ای دل، او را خون من مانند شیر مادر حلال او باد"],[278,"مکن از خواب بیدارم خدا را","که دارم خلوتی خوش با خیالش","تورا به خدا مرا از خواب بیدارم نکن، چون در خواب خلوتی خوشایند با معشوق دارم"],[278,"چرا حافظ چو می‌ترسیدی از هجر","نکردی شکر ایام وصالش؟","حافظ چرا وقتی از جدایی می‌ترسید، از روزهای وصال او شکر گزاری خداوند را نکرد؟"],[279,"چو بر شکست صبا زلف عنبرافشانش","به هر شکسته که پیوست، تازه شد جانش","وقتی نسیم صبحگاهی به زلف‌های تابدار او می‌وزد، هر قسمتی که به آن زلف‌ها می‌رسد، جانش را تازه و شاداب می‌کند."],[279,"کجاست همنفسی؟ تا به شرح عرضه دهم","که دل چه می‌کشد از روزگار هجرانش","من همنفسی ندارم که برایش بگویم دل من در دوران جدایی چه درد و رنجی متحمل می‌شود."],[279,"زمانه از ورق گل، مثال روی تو بست","ولی ز شرم تو در غنچه کرد پنهانش","زمانه به زیبایی‌های گلی که مانند چهره توست اشاره کرده، اما از بس که تو شرمنده‌ای، زیبایی‌ات را در دل غنچه پنهان کرده است."],[279,"تو خفته‌ای و نشد عشق را کرانه پدید","تبارک الله از این ره که نیست پایانش","تو در خواب به سر می‌بری و عشق هیچ‌گاه پایانی پیدا نکرده است. چه خوب است که این راه عشق این‌گونه بی‌پایان است."],[279,"جمال کعبه مگر عذر رهروان خواهد؟","که جان زنده‌دلان سوخت در بیابانش","آیا زیبایی کعبه به قدری است که مسافران را از رفتن به آن بازدارد؟ زیرا جان افرادی که زنده‌دل هستند در بیابان عشق و آرزو برای دیدن آن سوخته است."],[279,"بدین شکسته بیت الحزن که می‌آرد","نشان یوسف دل از چه زنخدانش؟","در این بیت، شاعر از عشق و دل‌باختگی سخن می‌گوید و به این موضوع اشاره می‌کند که آیا این دلشکسته (که به خاطر عشق خود دچار غم و اندوه است) می‌تواند نشانه‌ای از یوسف دل (محبوب) را از چاه زنگی (عاطفی) خود بیاورد؟ این تعبیر به نوعی اشاره به آرزوی دستیابی به محبوب و یاد او در میان درد و رنج است."],[279,"بگیرم آن سر زلف و به دست خواجه دهم","که سوخت حافظ بی‌دل ز مکر و دستانش","می‌خواهم آن بخش از مو (زلف) را بگیرم و به دست آقایی (خواجه) بدهم که حافظ، شاعر، به خاطر فریب و نیرنگ‌های او دلش سوخته است."],[280,"یا رب این نوگل خندان که سپردی به منش","می‌سپارم به تو از چشم حسود چمنش","پروردگارا، این گل نوبر و خندان را که به من سپردی، من دوباره به تو می‌سپارم تا از چشم حسودان و بدخواهانی که در باغش هستند محافظت شود."],[280,"گرچه از کوی وفا گشت به صد مرحله دور","دور باد آفت دور فلک از جان و تنش","هرچند که از مسیر وفا و عشق بسیار فاصله گرفته و دور شده است، اما آرزو می‌کنم بلای دوری و غم ناشی از چرخش فلک (سرنوشت) بر جان و تن او نرود."],[280,"گر به سرمنزل سلمی رسی ای باد صبا","چشم دارم که سلامی برسانی ز منش","اگر ای باد صبا به محل اقامت سلمی رسیدی، امیدوارم که سلامی از طرف من به او برسانی."],[280,"به ادب نافه گشایی کن از آن زلف سیاه","جای دل‌های عزیز است به هم بر مزنش","زیبایی زلف‌های سیاه را با آداب و احترام بگشای، زیرا آن زلف‌ها محل دل‌های ارزشمند و گران‌بها هستند و نباید آن‌ها را با بی‌ادبی به هم جمع کنی."],[280,"گو دلم حقّ وفا با خط و خالت دارد","محترم دار در آن طرّه عنبرشکنش","دل من به خاطر خط و خال تو، حق و احترام وفا را دارد، پس در آن گیسوی خوشبو و معطرش که به مانند عطر عنبر است، باید مرا محترم بشماری."],[280,"در مقامی که به یاد لب او می نوشند","سفله آن مست، که باشد خبر از خویشتنش","در جایی که به عشق لب او شراب می‌نوشند، آن بی‌مقدار مستی که در حال سرمستی است، از حال خود هم بی‌خبر است."],[280,"عرض و مال از در میخانه نشاید اندوخت","هر که این آب خورد رخت به دریا فکنش","دنیا و مال و ثروت را نمی‌توان از در میخانه به دست آورد، زیرا هر کسی که این شراب را بنوشد، باید در دلش از دنیای مادی فاصله بگیرد و به عشق و معانی والای زندگی روی آورد."],[280,"هر که ترسد ز ملال انده عشقش نه حلال","سر ما و قدمش یا لب ما و دهنش","هر کسی که از ناراحتی و غم عشق بترسد، نه حضورش برای ما مجاز است و نه قدمش و نه لب و دهنش قابل قبول است."],[280,"شعر حافظ همه بیت الغزل معرفت است","آفرین بر نفس دلکش و لطف سخنش","شعر حافظ به تمامی معرفت و دانایی در عشق و روابط انسانی اشاره دارد. باید به نفس دلنواز او و زیبایی گفتارش تحسین کرد، زیرا این ویژگی‌ها شناخت عمیق‌تری از عشق و زندگی به ما می‌دهند."],[281,"ببرد از من قرار و طاقت و هوش","بت سنگین‌دل سیمین بناگوش","عشق آن چنان مرا بی‌قرار و ناتوان کرده که دیگر نمی‌توانم آرامش یا تمرکز داشته باشم. این حالت ناشی از جذابیت و سنگینی دل آن معشوقی است که گوش‌هایش گوهرنشان و بدنی سیمین دارد."],[281,"نگاری چابکی شنگی کله‌دار","ظریفی مه‌وشی ترکی قباپوش","دختری زیبا و چابک با موهای بافت‌دار و کلاهی خاص که با صورت ماه‌گونه و لباس ترکی‌اش، جلوه خاصی دارد."],[281,"ز تاب آتش سودای عشقش","به سان دیگ دایم می‌زنم جوش","بخاطر شوق و اشتیاق به عشق او، مانند دیگی که دائم در حال جوشیدن است، همیشه در حال تلاطم و بی‌قراری هستم."],[281,"چو پیراهن شوم آسوده‌خاطر","گرش همچون قبا گیرم در آغوش","وقتی آرامش پیدا می‌کنم و احساس راحتی می‌کنم که مثل پیراهنش او را به آغوش کشم"],[281,"اگر پوسیده گردد استخوانم","نگردد مهرت از جانم فراموش","هرچند که جسمم به مرور زمان و به علت پیری و فساد، متلاشی شود، اما عشق و محبت تو هرگز از دل و جانم محو نخواهد شد."],[281,"دل و دینم، دل و دینم ببرده‌ست","بر و دوشش، بر و دوشش، بر و دوش","بر و روی و قد و بالایش، دل و ایمان من را گرفته"],[281,"دوای تو، دوای توست حافظ","لب نوشش، لب نوشش، لب نوش","دوا و شفای تو ای حافظ، در رسیدن به کام یار است"],[282,"سحر ز هاتف غیبم رسید مژده به گوش","که دور شاه‌شجاع است، می دلیر بنوش","هاتف غیبی به من خبر خوشی داد که دوران سلطنت شاه‌شجاع به پایان رسیده است، بنابراین شراب دلیر بنوشید."],[282,"شد آن که اهل نظر بر کناره می‌رفتند","هزار گونه سخن در دهان و لب خاموش","اهل نظر (دانشمندان و عاقلان) در کنار می‌نشستند و هر کدام به هزاران شکل درباره موضوعاتی صحبت می‌کردند، ولی خودشان لب از سخن نمی‌گشودند و خاموش بودند."],[282,"به صوت چنگ بگوییم آن حکایت‌ها","که از نهفتن آن دیگ سینه می‌زد جوش","با نواختن چنگ، داستان‌هایی را تعریف کنیم که از پنهان بودن آنچه در دل داریم، به شدت در حال جوش و خروش است."],[282,"شراب خانگی ترس محتسب‌خورده","به روی یار بنوشیم و بانگ نوشانوش","با همسر محبوب شراب خانگی‌ای که به خاطر ترس از محتسب (نگهبان شرع) آسیب دیده را بنوشیم و در کنار هم شادی و سرور را فریاد کنیم."],[282,"ز کوی میکده دوشش به دوش می‌بردند","امام شهر که سجاده می‌کشید به دوش","امام شهر که همواره سجاده‌اش را به نشانه زهد و پرهیزگاری همراه خود داشت دیشب چون در مصرف شراب افراط کرده بود و بدحال شده بود بر روی دوش مردم حمل می‌شد."],[282,"دلا! دلالت خیرت کنم به راه نجات","مکن به فسق مباهات و زهد هم مفروش","ای دل! می‌خواهم تو را به راه نجات هدایت کنم. به گناه افتخار نکن و زهد خود را نیز در معرض فروش نگذار."],[282,"محل نور تجلّی‌ست رای انور شاه","چو قرب او طلبی در صفای نیّت کوش","محل نور تجلی و روشنی، رای انور شاه (خدا) است. اگر به دنبال نزدیک شدن به او هستی، باید در پاکی نیت خود تلاش کنی."],[282,"به جز ثنای جلالش مساز ورد ضمیر","که هست گوش دلش محرم پیام سروش","فقط ستایش جلال او را بکن و به غیر از آن چیزی بر زبان نیاور، زیرا که گوش دل او تنها به پیام فرشته (سروش) آگاه و مناسب است."],[282,"رموز مصلحت ملک خسروان دانند","گدای گوشه‌نشینی تو حافظا مخروش","دولت‌مردان و صاحبان قدرت در کشور درک و شناختی از امور مصلحت را دارند، ولی تو به عنوان یک دلسوز و گوشه‌نشین، باید از لاف زدن و فخر فروشی خودداری کنی، ای حافظ."],[283,"هاتفی از گوشه میخانه دوش","گفت ببخشند گنه، می بنوش","دیشب در میخانه صدایی از غیب مرا گفت که گناهان را می‌بخشند شاد باش و می بنوش!"],[283,"لطف الهی بکند کار خویش","مژده رحمت برساند سروش","لطف و رحمت الهی همه‌چیز را درست خواهد کرد و مژده و خبر خوش بخشش را سروش می‌رساند."],[283,"این خرد خام به میخانه بر","تا می لعل آوردش خون به جوش","این عقل نادان را به میخانه ببر تا می ناب و سرخ‌، او را گرم و زنده کند!"],[283,"گرچه وصالش نه به کوشش دهند","هر قدر ای دل که توانی بکوش","اگرچه وصال او را به کوشش و تلاش نمی‌دهند اما ای دوست، هرچه می‌توانی تلاش کن."],[283,"لطف خدا بیشتر از جرم ماست","نکته سربسته چه دانی؟ خموش","لطف و مهر خدا بیشتر از گناهان ماست؛ راز سربسته را چه‌کسی می‌داند؟ پس باید خاموش گشت!"],[283,"گوش من و حلقه گیسوی یار","روی من و خاک در می فروش","من برای بندگی یار هستم و سجده‌گاه من، خاک در میکده است."],[283,"رندی حافظ نه گناهیست صعب","با کرم پادشه عیب پوش","رندی حافظ گناهی نابخشودنی نیست؛ وقتی‌که کار او در دست پادشاه بخشش‌گر عیب‌پوش است."],[283,"داور دین، شاه شجاع، آن که کرد","روح قدس حلقه امرش به گوش","داور دین، شاه شجاع، همان کسی است که روح القدس (روح روحانی و الهی) را در خدمت فرمانش قرار داده و به اطرافیانش گوشزد کرده است."],[283,"ای ملک العرش مرادش بده","و از خطر چشم بدش دار گوش","ای خداوند بزرگ، آرزوهای او (شاه شجاع) را برآورده کن و او را از آسیب‌های چشم‌های بد محافظت فرما."],[284,"در عهد پادشاه خطابخش جرم پوش","حافظ قرابه کش شد و مفتی پیاله نوش","در زمان پادشاهی که به روشنی و بخشش معروف است، حافظ به میکده می‌رود و در آنجا قهرمانانه شراب می‌نوشد و از قضا توجیه‌گری دینی (مفتی) نیز در حال نوشیدن شراب است."],[284,"صوفی ز کنج صومعه با پای خم نشست","تا دید محتسب که سبو می‌کشد به دوش","صوفی که در گوشه صومعه نشسته بود، دید محتسب (بازرس شرع) را که بار می‌کشد و شراب می‌نوشد."],[284,"احوال شیخ و قاضی و شرب الیهودشان","کردم سؤال صبحدم از پیر می فروش","صبح زود از پیر می‌فروش در مورد حال و احوال شیخ و قاضی و شراب‌خواری یهودیان سؤال کردم."],[284,"گفتا نه گفتنیست سخن گرچه محرمی","درکش زبان و پرده نگه دار و می بنوش","گفت :هرچند تو محرمی به اسرار ولی این سخن ها گفتنی نیستن و توهم حجاب این اسرار نگه دار و می بنوش"],[284,"ساقی بهار می‌رسد و وجه می نماند","فکری بکن که خون دل آمد ز غم به جوش","درباره آمدن بهار و خوشی‌های آن، ساقی باید فکری کند؛ چرا که غم و اندوه دل، انسان را به شدت آزار می‌دهد و در این موقعیت، دیگر جای نشستن و بی‌حرکتی نیست."],[284,"عشق است و مفلسیّ و جوانیّ و نوبهار","عذرم پذیر و جرم به ذیل کرم بپوش","عشق، فقر، جوانی و بهار نو آمده‌اند؛ عذر را بپذیر و گناه را زیر سایه‌ی کرم و لطف خود بپوشان."],[284,"تا چند همچو شمع زبان آوری کنی؟","پروانه مراد رسید ای محب خموش","ای محب، تا کی باید مانند شمع صحبت کنی و خودت را بسوزانی؟ پروانه‌ی آرزویت به هدف خود رسیده است، اکنون باید ساکت شوی."],[284,"ای پادشاه صورت و معنی که مثل تو","نادیده هیچ دیده و نشنیده هیچ گوش","ای پادشاهی که هم در ظاهر و هم در باطن، مانند تو کسی را هیچ‌کس تا به حال ندیده و گوش‌ها نیز صدای او را نشنیده‌اند."],[284,"چندان بمان که خرقه ازرق کند قبول","بخت جوانت از فلک پیر ژنده پوش","مدت زیادی بمان که لباس روحانی‌ات (خرقه‌ای که رنگ آبی دارد) را به تن کند تا بخت جوانت از کائنات پیر و فرسوده پذیرفته شود."],[285,"دوش با من گفت پنهان کاردانی تیزهوش","وز شما پنهان نشاید کرد سرّ می‌فروش","دیشب در پنهان با من صحبت کرد فردی باهوش و کاردان و گفت که نباید راز می‌فروش (که احتمالا به معشوق یا کسی دیگر اشاره دارد) را از شما پنهان کرد."],[285,"گفت آسان گیر بر خود کارها کز روی طبع","سخت می‌گردد جهان بر مردمان سخت‌کوش","گفت برو آرام و بی‌دغدغه به کارهایت بپرداز، چرا که در زندگی، سختی‌ها بر افرادی که تلاش و کوشایی بیشتری دارند، بیشتر نمایان می‌شود."],[285,"وان گهم در داد جامی کز فروغش بر فلک","زهره در رقص آمد و بربط زنان می‌گفت نوش","در آن زمان (که عیش و نوش فراهم است) به من جامی بده که از درخشندگی آن، زهره (سیاره زهره) در آسمان به رقص درآمد و زنان با ساز بربط (ساز چنگی) می‌خواندند و می‌نوشیدند."],[285,"با دل خونین لب خندان بیاور همچو جام","نی گرت زخمی رسد، آیی چو چنگ اندر خروش","مانند جام می با خون دل لبی خندان داشته باش نه مانند ساز چنگ که با یک زخمه مضراب، به فریاد می‌آید."],[285,"تا نگردی آشنا زین پرده رمزی نشنوی","گوش نامحرم نباشد جای پیغام سروش","تا وقتی که با این پرده آشنا نشوی، پیام‌های الهی را نخواهی شنید؛ کلام روحانی به گوش افراد ناآشنا نمی‌رسد."],[285,"گوش کن پند ای پسر وز بهر دنیا غم مخور","گفتمت چون در حدیثی، گر توانی داشت هوش","ای پسر، به نصیحت من گوش کن و برای دنیا نگرانی نداشته باش. به تو گفتم که اگر بتوانی، از این سخن ارزشمند مانند در بهره‌مند شو."],[285,"در حریم عشق نتوان زد دم از گفت و شنید","زان که آنجا جمله اعضا چشم باید بود و گوش","در فضای عشق نمی‌توان صحبت و شنیداری داشت، زیرا در آنجا همه اعضای بدن باید فقط نظاره‌گر و شنونده باشند و باید به احساسات و عواطف عشق توجه کرد."],[285,"بر بساط نکته‌دانان خودفروشی شرط نیست","یا سخن دانسته گو ای مرد عاقل، یا خموش","در محفل کسانی که به نکته‌سنجی و دانش مشهورند، نیازی به خودنمایی و خودفروشی نیست. ای مرد عاقل، یا باید سخن را با علم و آگاهی بگویی یا بهتر است که سکوت کنی."],[285,"ساقیا می ده که رندی‌های حافظ فهم کرد","آصف صاحب‌قران جرم‌بخش عیب‌پوش","ای ساقی، شراب را به من بده تا رندی‌های حافظ را بشنوم؛ کسی که عیب‌های مردم را می‌پوشاند و به خاطر بخشندگی‌اش، به آصف، یکی از شخصیت‌های برجسته و دانا، تشبیه شده است."],[286,"ای همه شکل تو مطبوع و همه جای تو خوش","دلم از عشوه شیرین شکرخای تو خوش","وجود تو زیبا و دل‌چسب است و در هر گوشه از تو زیبایی دیده می‌شود. من از طعنه‌ها و نازهای شیرین تو بسیار خوشحال هستم."],[286,"همچو گلبرگ طری هست وجود تو لطیف","همچو سرو چمن خلد سراپای تو خوش","وجود تو همچون گلبرگ تازة لطیف است و تمام وجودت مانند سرو در باغ بهشت زیبا و دلنشین است."],[286,"شیوه و ناز تو شیرین، خط و خال تو ملیح","چشم و ابروی تو زیبا، قد و بالای تو خوش","روش و ناز تو دلپذیر است، نقش و خط صورتت زیبا و دوست‌داشتنی است، چشم و ابرویت خوش‌نما و قامت و ظاهرت دل‌انگیز است."],[286,"هم گلستان خیالم ز تو پر نقش و نگار","هم مشام دلم از زلف سمن سای تو خوش","در خیال من، گلستانی پر از نقش و تصویر تو وجود دارد و همچنین بوی عطر زلف‌های تو، دل من را شاداب کرده است."],[286,"در ره عشق که از سیل بلا نیست گذار","کرده‌ام خاطر خود را به تمنای تو خوش","در راه عشق که مملو از مشکلات و مصیبت‌هاست، من با اراده و تصمیم خود از آن عبور کرده‌ام و دل خود را به امید دیدار تو خوش کرده‌ام."],[286,"شکر چشم تو چه گویم؟ که بدان بیماری","می‌کند درد مرا از رخ زیبای تو خوش","نمی‌دانم چگونه از زیبایی چشمان تو تشکر کنم، چون این زیبایی خود موجب بیماری و درد من شده و من از این درد، به خاطر چهره‌ی زیبای تو خوشحالم."],[286,"در بیابان طلب گر چه ز هر سو خطری‌ست","می‌رود حافظ بی‌دل به تولّای تو خوش","در میان جستجو و تلاش برای رسیدن به معشوق، هرچند خطرهای زیادی وجود دارد، حافظ که دلش بی‌تاب و دلتنگ است، به دنبال تو می‌رود و از این کار خوشحال است."],[287,"کنار آب و پای بید و طبع شعر و یاری خوش","معاشر دلبری شیرین و ساقی گلعذاری خوش","در کنار رود، در زیر درخت بید و با حال و هوای شعری دلنشین، خوشی‌های روزگار را با یاری که دلبری شیرین و ساقی‌ای با گل‌های خوشبو دارد، می‌گذرانم."],[287,"الا ای دولتی طالع، که قدر وقت می‌دانی","گوارا بادت این عشرت که داری روزگاری خوش","هان،‌ ای کسی که بخت با تو مساعد و ارزش وقت را به خوبی می‌شناسی، این عیش و عشرت و شادی برتو گوارا باد که ایام به کام توست."],[287,"هر آن کس را که در خاطر ز عشق دلبری باریست","سپندی گو بر آتش نه، که دارد کار و باری خوش","به آن کسی که بار عشق و محبت دلبری را بر دل دارد بگو که تا چشم نخورد، اسپند دود کند که سود و سرمایه‌ای خوب دارد."],[287,"عروس طبع را زیور ز فکر بکر می‌بندم","بود کز دست ایّامم به دست افتد نگاری خوش","اندام عروس طبع و قریحه خود را از اندیشه بدیع و نو آرایش می‌دهم، شاید بر اثر بازی ایام، معشوقی زیبارو به چنگ من افتد.."],[287,"شب صحبت غنیمت دان و داد خوشدلی بستان","که مهتابی دل افروز است و طرف لاله زاری خوش","در شب مهتابی که روشنی‌بخش دل و جان است و در کنار چمن و لاله‌زاری باصفا، همنشینی با دوستان را قدر بدان و بهره خود را از عیش و نوش بگیر"],[287,"میی در کاسه چشم است ساقی را بنامیزد","که مستی می‌کند با عقل و می‌بخشد خماری خوش","در جام چشم‌های ساقی، شرابی موج می‌زند که با عقل از در مستی و ستیز در می‌آید و حالت بی خبری و سرخوشی به‌دست می‌دهد.."],[287,"به غفلت عمر شد حافظ، بیا با ما به میخانه","که شنگولان خوش باشت، بیاموزند کاری خوش","ای حافظ، عمرت به بی‌خبری سپری شد، با ما به میخانه بیا تا ساقیان زیباروی خوش مشرب به تو راه زندگی خوب را بیاموزند.."],[288,"مجمع خوبی و لطف است عذار چو مهش","لیکنش مهر و وفا نیست خدایا بدهش","چهره‌اش مانند ماه، جلوه‌ای از زیبایی و نیکی دارد، اما او مهری و وفایی در دل ندارد. خدایا، این دلبر را به من عطا کن."],[288,"دلبرم شاهد و طفل است و به بازی روزی","بکشد زارم و در شرع نباشد گنهش","دلبر من که همچون یک شاهد زیبا و یک کودک بی‌تجربه است، روزی مرا با بازی خود به گریه می‌اندازد و در شرع (قوانین دینی) به خاطر این کارش گناهی از او نیست."],[288,"من همان به که از او نیک نگه دارم دل","که بد و نیک ندیده‌ست و ندارد نگهش","من بهترم که دل را از او نگه‌دارم، زیرا او نه خوبی دیده و نه بدی و نمی‌داند چگونه نگاه کند."],[288,"بوی شیر از لب همچون شکرش می‌آید","گرچه خون می‌چکد از شیوه چشم سیهش","بوی شیرین و خوش از لب‌های او به مشام می‌رسد، اما در عوض، اشک‌هایش مثل خون از چشمان سیاهش میریزد."],[288,"چارده ساله بتی چابک شیرین دارم","که به جان حلقه به گوش است مه چاردهش","من چهارده سال است که بتی زیبا و جذاب دارم که وجودش مانند جان برایم ارزشمند است و به او مثل حلقه‌ای به گوش، وابسته‌ام. این بت به مهدی چارده‌اش، یعنی دختری با این سن و سال و زیبایی، تشبیه می‌شود."],[288,"از پی آن گل نورسته دل ما یارب","خود کجا شد که ندیدیم در این چند گهش؟","ما برای آن گلی که در نور است، دل‌مان را می‌سپاریم. ای کاش بدانیم که این دل‌باختگی کجا رفته و چرا در این مدت طولانی آن را ندیده‌ایم."],[288,"یار دلدار من ار قلب بدین سان شکند","ببرد زود به جانداری خود پادشهش","اگر دلبر من به این شکل قلب مرا بشکند، به زودی با زندگی خود،‌ پادشاهی را از آن خود خواهد کرد."],[288,"جان به شکرانه کنم صرف گر آن دانه در","صدف سینه حافظ بود آرامگهش","اگر دانه گرانبهای وجود حافظ، درون صدف سینه‌اش به آرامش بیفتد، جان خود را به خاطر این شکرگزاری به کار خواهم گرفت."],[289,"دلم رمیده شد و غافلم من درویش","که آن شکاری سرگشته را چه آمد پیش","خوانش های آمده از سوی بسیاری‌ ، بیشتر خوانش ها یا همان تفسیرهای آلوده به یک گونه باور و نگاه چیره است که ریشه هایش از جهان دانسته های آدمی می آید ، دانسته هایی که همه چیز در آنجا پیشتر بر پایه باورها و نگاه های مورد پذیرش همگان شکل می گیرد ، اما اینجا به وارونه خوانش هوش ساختگی\"مصنوعی\" بیشتر با حرکت درونی و زیرین سروده حافظ کار می کنیم‌ و دیگر غزل کارساز و شگفت حافظ را با آن خوانش های چیره انجام نمی دهیم‌، پس بند به بند کار را آغاز می کنیم"],[289,"چو بید بر سر ایمان خویش می‌لرزم","که دل به دست کمان ابرویی‌ست کافرکیش","همچون بید لرزان هستم و می‌ترسم زیرا ایمان من در خطر است و دل من در دست کمان‌ابرویی بی‌رحم است!"],[289,"خیال حوصله بحر می‌پزد هیهات","چه‌هاست در سر این قطره محال‌اندیش!","هیهات که خیال، ظرفیت دریا را می‌پزد (=می‌پروراند). چه‌ها در سر این خیال (=نقطه محال اندیش) است!"],[289,"بنازم آن مژه شوخ عافیت‌کش را","که موج می‌زندش آب نوش، بر سر نیش","فدای آن مژه بی‌رحم و سنگ‌دل شوم که در نوک آن، آب حیات و جان موج می‌زند!"],[289,"ز آستین طبیبان هزار خون بچکد","گرم به تجربه دستی نهند بر دل ریش","اگر طبیبی بخواهد که درد دل خسته و ریش مرا بیابد و بر دلم دست نهد، هزار خون از آستین او خواهد چکید!"],[289,"به کوی میکده گریان و سرفکنده روم","چرا که شرم همی آیدم ز حاصل خویش","به میخانه می‌روم با حالتی گریان و سر به زیر، زیرا از دستاوردهای خود شرمنده‌ام و احساس بی‌کفایتی می‌کنم."],[289,"نه عمر خضر بماند، نه ملک اسکندر","نزاع بر سر دنیی دون مکن درویش","نه عمر جاودان با تو وفا می‌کند و نه فرمان‌روایی جهان‌؛ پس غم دنیای بی‌ارزش را مخور ای دوست!"],[289,"بدان کمر نرسد دست هر گدا حافظ","خزانه‌ای به کف آور ز گنج قارون بیش","حافظ به آن کمر و آستان دست هر انسان گدایی نمیرسد برای رسیدن دست به ان آستان باید خزانه ای گردآوری بکنی که از گنج قارون بیشتر باشد"],[290,"ما آزموده‌ایم در این شهر بخت خویش","بیرون کشید باید از این ورطه رخت خویش","اگر زندگی در این دایره ،سوختی داشته ، ما سوخت هایش را دادیم . و دوباره سوخت دادن دیگر از ما گذشته ، اول و آخر بازی ابن دایره رو گرفتیم باید از آن عبور کنیم ، کلمه باید شاه کلمه این بیت هست ، یک راه ، آن هم گذر از دایره."],[290,"از بس که دست می‌گزم و آه می‌کشم","آتش زدم چو گل به تن لخت لخت خویش","به خاطر اینکه مدام خودم را آزار می‌دهم و ناله می‌کنم، مانند گلی که در آتش سوخته است، به حال زار خودم پرداخته‌ام."],[290,"دوشم ز بلبلی چه خوش آمد که می‌سرود","گل گوش پهن کرده ز شاخ درخت خویش","دیشب صدای بلبلی که درختی روییده به گل به خوشی می‌خواند، برای من بسیار زیبا و دلنشین بود."],[290,"کای دل تو شاد باش که آن یار تندخو","بسیار تند روی نشیند ز بخت خویش","دل، شاد باش که آن یار تندخو که طبعی تند و تیز دارد، به خاطر بخت خودش آرام می‌گیرد و نشسته است."],[290,"خواهی که سخت و سست جهان بر تو بگذرد","بگذر ز عهد سست و سخن‌های سخت خویش","اگر می‌خواهی زندگی‌ات به‌راحتی سپری شود و مشکلات کمتری داشته باشی، باید از تعهدات و وعده‌های بی‌پایه و نیز از گفتگوهای دشوار و تند خود دوری کنی."],[290,"وقت است کز فراق تو وز سوز اندرون","آتش درافکنم به همه رخت و پخت خویش","حالا زمان آن رسیده که به خاطر دوری تو و سوختن از درون، همه وسایل و اثاثی را که دارم، بسوزانم."],[290,"ای حافظ ار مراد میسّر شدی مدام","جمشید نیز دور نماندی ز تخت خویش","حافظ می‌گوید: ای حافظ، اگر به خواسته‌ات رسیدی، باید بدانی که جمشید (پادشاه افسانه‌ای ایران) نیز از رسیدن به قدرت و مقام خود غافل نشده است."],[291,"قسم به حشمت و جاه و جلال شاه شجاع","که نیست با کسم از بهر مال و جاه نزاع","حافظ به قدرت و مقام شاه شجاع قسم می‌خورد که او به خاطر مال و مقام با کسی درگیری ندارد و در این زمینه هیچ رقابتی نمی‌کند."],[291,"شراب خانگیم بس می مغانه بیار","حریف باده رسید ای رفیق توبه وداع","شراب خانگی من را که از نوع مغان است، بیاور چون دوست شراب‌خوار به جمع ما ملحق شده است، ای رفیق که با توبه وداع کرده‌ای."],[291,"خدای را به می‌ام شست و شوی خرقه کنید","که من نمی‌شنوم بوی خیر از این اوضاع","[ شما را ] به خدا سوگند [ می دهم ]، لباس پشیمنه مرا با شراب شست و شو کنید زیرا که من از اوضاع روزگار امید خیر و نیکی ندارم."],[291,"ببین که رقص‌کنان می‌رود به ناله چنگ","کسی که رخصه نفرمودی استماع سماع","ببین که کسی که به همراه صدای چنگ می‌رقصد، در حال ناله و زاری است، در حالی که تو مجوز گوش دادن به این مجلس را نداده‌ای."],[291,"به عاشقان نظری کن به شکر این نعمت","که من غلام مطیعم، تو پادشاه مطاع","عاشقان را با نگاهی محبت‌آمیز بنگر و شکرگزار این نعمت باش، زیرا من خدمتگزار و بنده‌ات هستم و تو سلطان و سرور فرمانروا هستی."],[291,"به فیض جرعه جام تو تشنه‌ایم، ولی","نمی‌کنیم دلیری نمی‌دهیم صداع","ما به برکت یک جرعه از جام تو تشنه هستیم و به همین دلیل از این اشتیاق و طمع خود، جرأت نمی‌کنیم و صدای شکایت و درخواست‌مان را به گوش نمی‌رسانیم."],[291,"جبین و چهره حافظ خدا جدا مکناد","ز خاک بارگه کبریای شاه شجاع","حافظ از خداوند می‌خواهد که او را از خاک بارگاه شاه شجاع (حاکم بزرگ) جدا نکند، زیرا او چهره و جبین خود را به توجّه به خدا و عظمت او می‌سازد. در واقع، مشکلی ندارد که او در میان مخلوقات باشد، اما نباید از خدا دور بماند."],[292,"بامدادان که ز خلوتگه کاخ ابداع","شمع خاور فکند بر همه اطراف شعاع","صبح که از خلوتگاه کاخ خلاقیت، شعله‌ای از شمع شرق بر همه جا تابش می‌کند."],[292,"برکشد آینه از جیب افق چرخ و در آن","بنماید رخ گیتی به هزاران انواع","آینه‌ای که از جیب افق آسمان بیرون می‌آید، چهره زمین را با هزاران جلوه‌ مختلف در آن نشان می‌دهد."],[292,"در زوایای طربخانه جمشید فلک","ارغنون ساز کند زهره به آهنگ سماع","زهره (سیاره زهره) در زوایای سرور و خوشی جمشید (مظهر قدرت و شکوه) در آسمان، با نغمه دل‌انگیز ساز فریبنده‌ای می‌نوازد."],[292,"چنگ در غلغله آید که کجا شد منکر؟","جام در قهقهه آید که کجا شد منّاع؟","چنگ در شور و شوقی درمی‌آید و می‌پرسد که کجا رفت آن کسی که منکر لذت‌ها بود؟ جام هم در خنده و خوش‌گذرانی نمایان می‌شود و می‌پرسد که کجا رفت آن کسی که از لذت‌ها جلوگیری می‌کرد؟"],[292,"وضع دوران بنگر ساغر عشرت بر گیر","که به هر حالتی این است بهین اوضاع","وضع دنیا را نگاه کن و جام خوشی را به دست بگیر، چون در هر شرایطی این بهترین حالت است."],[292,"طرّه شاهد دنیی همه بند است و فریب","عارفان بر سر این رشته نجویند نزاع","زلف زیبای محبوب دنیوی همه‌اش مروارید و فریب است و عارفان به خاطر این زیبایی و کمال، نزاع و جدل نمی‌کنند."],[292,"عمر خسرو طلب ار نفع جهان می‌خواهی","که وجودیست عطابخش کریم نفّاع","اگر می‌خواهی به نفع مردم و دنیا عمری شاداب و پربار داشته باشی، باید به شخصیتی مانند خسرو، که بخشنده و نیکوکار است، تکیه کنی."],[292,"مظهر لطف ازل، روشنی چشم امل","جامع علم و عمل جان جهان، شاه شجاع","دستگاه عطوفت الهی، امیدی که به روشنی و دانایی کمال می‌رسد و الهام‌بخش زندگی است، شاهی شجاع و قدرتمند را به تصویر می‌کشد."],[293,"در وفای عشق تو، مشهور خوبانم چو شمع","شب‌نشین کوی سربازان و رندانم چو شمع","به خاطر وفاداری به عشق تو، در میان خوبان معروف هستم، مانند شمعی که در شب در کوی سربازان و رندان می‌درخشد."],[293,"روز و شب خوابم نمی‌آید به چشم غم‌پرست","بس که در بیماری هجر تو گریانم چو شمع","به خاطر غم و فراق تو، نه روز و نه شب نمی‌توانم بخوابم، آن‌قدر که در این درد جدایی از تو اشک می‌ریزم، مانند شمعی هستم که می‌سوزد."],[293,"رشته صبرم به مقراض غمت ببریده شد","همچنان در آتش مهر تو سوزانم چو شمع","عشق تو باعث شده است که صبر و تحملم را از دست بدهم و در آتش محبت تو همچنان می‌سوزم، مانند شمعی که می‌سوزد."],[293,"گر کمیت اشک گلگونم نبودی گرم‌رو","کی شدی روشن به گیتی راز پنهانم چو شمع؟","اگر اشک‌های سرخ من نبود، آیا تو به‌خاطر گرمی و عشق خود به دنیا روشن می‌شدی و راز پنهان من را می‌فهمیدی، همچنان که یک شمع روشنی می‌بخشد؟"],[293,"در میان آب و آتش همچنان سرگرم توست","این دل زار نزار اشک‌بارانم چو شمع","دل حزین و بی‌چاره‌ام، که پر از اشک است، در شرایط دشوار و متضادی مثل آب و آتش به خاطر تو هنوز مشغول توست، مانند شمعی که در حال ذوب شدن است."],[293,"در شب هجران، مرا پروانه وصلی فرست","ور نه از دردت جهانی را بسوزانم چو شمع","در شب جدایی، مرا پروانه‌ای که خبر از وصال تو می‌دهد بفرست، وگرنه به خاطر درد دوری‌ات تمام دنیا را می‌سوزانم مانند شمع که در آتش می‌سوزد."],[293,"بی جمال عالم‌آرای تو روزم چون شب است","با کمال عشق تو در عین نقصانم چو شمع","روزهای من بدون زیبایی تو مانند شب است و با اینکه عاشق تو هستم و حس می‌کنم نواقصی دارم، اما در عشق تو مثل شمع در حال ذوب شدن هستم."],[293,"کوه صبرم نرم شد چون موم در دست غمت","تا در آب و آتش عشقت گدازانم چو شمع","صبر و بردباری من در برابر غم تو به حدی رسیده که مثل موم در دستانت نرم شده است، تا بتوانم در عشق تو جانم را در آب و آتش فدای تو کنم، مانند شمعی که می‌سوزد."],[293,"همچو صبحم یک نفس باقی‌ست با دیدار تو","چهره بنما دلبرا تا جان برافشانم چو شمع","تنها در یک دقیقه، با دیدار تو، مثل صبح روشن می‌شوم. ای محبوب، چهره‌ات را نشان بده تا مثل شمع جانم را بسوزانم."],[293,"سرفرازم کن شبی از وصل خود ای نازنین","تا منور گردد از دیدارت ایوانم چو شمع","ای نازنین، مرا شبی از وصل خود سرفراز و سرشار کن تا ایوانم از دیدارت همچون شمع روشن و نورانی شود."],[293,"آتش مهر تو را حافظ عجب در سر گرفت","آتش دل، کی به آب دیده بنشانم چو شمع؟","حافظ در این بیت می‌گوید که عشق تو چنان در دل او شعله‌ور است که با وجود آتش قلبش، نمی‌داند چگونه آن را با اشک چشمانش خاموش کند، مانند شمعی که تلاش دارد با آب خود خاموش شود."],[294,"سحر به بوی گلستان دمی شدم در باغ","که تا چو بلبل بیدل کنم علاج دماغ","در صبحگاه به بوی گلستان به باغی رفتم تا به مانند بلبل بی‌خبر از خود، درد دل و اندوه ذهنی‌ام را درمان کنم."],[294,"به جلوه گل سوری نگاه می‌کردم","که بود در شب تیره به روشنی چو چراغ","در شب تاریک، به زیبایی و جلوه گل سرخ نگاه می‌کردم که مانند چراغی روشن می‌درخشید."],[294,"چنان به حسن و جوانی خویشتن مغرور","که داشت از دل بلبل هزار گونه فراغ","چنان در زیبایی و جوانی خود دل‌خوش و مغرور شده که بلبل از دلش هزاران شعف و شادمانی را احساس می‌کند."],[294,"گشاده نرگس رعنا ز حسرت آب از چشم","نهاده لاله ز سودا به جان و دل صد داغ","نرگس زیبای دلخواه، از حسرتی که دارد، اشک می‌ریزد و لاله نیز به خاطر عشق و دلتنگی‌اش، در جان و دلش غم‌های زیادی دارد."],[294,"زبان کشیده چو تیغی به سرزنش سوسن","دهان گشاده شقایق چو مردم ایغاغ","سوسن زبانش را از برای سرزنش همچو تیغ کشیده است و شقایق به مانند مردم سخن‌چین دهان گشاده است."],[294,"یکی چو باده پرستان صراحی اندر دست","یکی چو ساقی مستان به کف گرفته ایاغ","یکی از طرفداران باده، پیاله‌ای پر در دست دارد و یکی هم مانند ساقی (سرویس‌دهنده‌) مستان، شربت را در دست گرفته است."],[294,"نشاط و عیش و جوانی چو گل غنیمت دان","که حافظا نبود بر رسول غیر بلاغ","شادی و لذت و جوانی را همچون گل فرصت بشمار، زیرا ای حافظ، قرار نیست که زندگی همیشه به این شکل ادامه یابد."],[295,"طالع اگر مدد دهد، دامنش آورم به کف","گر بکشم زهی طرب، ور بکشد زهی شرف","اگر ستاره بخت به من یاری کند، دامنش را با دست می‌گیرم و اگر خوشحالی نصیبم شود، اگر هم او مرا بکشد، این موضوع به منزلت و شرف من افزوده می‌شود."],[295,"طرف کرم ز کس نبست، این دل پر امید من","گر چه سخن همی برد، قصه من به هر طرف","دل پر امید من به هیچ کس وابسته نیست و هرچند که سخنانم به گوش همه می‌رسد، اما داستان من همچنان در هر سمت و سویی فراتر از فهم دیگران می‌رود."],[295,"از خم ابروی توام، هیچ گشایشی نشد","وه که در این خیال کج، عمر عزیز شد تلف","از خم ابروی تو هیچ گشایشی برای من ایجاد نشد و افسوس که در این خیال باطل و نادرست، عمر گرانبهای من به هدر رفت."],[295,"ابروی دوست کی شود، دست‌کش خیال من؟","کس نزده‌ست از این کمان، تیر مراد بر هدف","ابروی معشوق (دوست) کی می‌تواند تصوری باشد که در خیال من بوجود آمده است؟ هیچ‌کس از این کمان که به شکل ابروست، تیری (مراد یا آرزو) به هدف نمی‌زند."],[295,"چند به ناز پرورم، مهر بتان سنگ‌دل","یاد پدر نمی‌کنند، این پسران ناخلف","چند وقت است که با ناز و محبت بیتی که محبوبان سنگدل دارند، دل خود را می‌پرورانم، در حالی که این پسران ناشایست، یاد پدر را نمی‌کنند."],[295,"من به خیال زاهدی، گوشه‌نشین و طرفه آنک","مغبچه‌ای ز هر طرف، می‌زندم به چنگ و دف","من در تصور یک زاهد گوشه‌نشین هستم و در حالی که به زیبایی و لطافت اطرافم می‌نگرم، در حال نواختن مغبچه (آلات موسیقی شبیه به دف) هستم و با ضربی که به چنگ و دف می‌زنم، خود را مشغول کرده‌ام."],[295,"بی‌خبرند زاهدان، نقش بخوان و لاتقل","مست ریاست محتسب، باده بده و لاتخف","زاهدان از حقیقت و عمق کارها بی‌خبرند، تو راز و رمز نوشیدن باده را بفهم و نگو که به ریاضت مشغولی، باده را بنوش و نترس."],[295,"صوفی شهر بین که چون لقمه شبهه می‌خورد","پاردمش دراز باد، آن حیوان خوش علف","صوفی که در این شهر زندگی می‌کند، به خاطر اینکه لقمه‌ای از مال حرام می‌خورد، بختش بد می‌شود و زندگی‌اش به تلخی می‌گذرد، درست مثل حیوانی که از علف خوشمزه تغذیه می‌کند اما در عوض صدمه می‌بیند."],[295,"حافظ اگر قدم زنی، در ره خاندان به صدق","بدرقه رهت شود، همت شحنه نجف","ای حافظ، اگر در راه خاندان راستی و اخلاص گام برداری، عنایت شحنه نجف پشتیبان و بدرقه‌گر راهت خواهد بود. (شحنه: حاکم، سلطان و صاحب‌منصب)"],[296,"زبان خامه ندارد سر بیان فراق","وگرنه شرح دهم با تو داستان فراق","قلم و زبان من نمی‌توانند احساسات جدایی را بیان کنند و اگر می‌توانستند، با تو داستان جدایی را می‌گفتم."],[296,"دریغ مدت عمرم که بر امید وصال","به سر رسید و نیامد به سر زمان فراق","آه و افسوس از طول عمر من که آن را به امید وصال و رسیدن به دوست، طی کردم و به سر رسید اما زمان جدایی و فراق به پایان نرسید."],[296,"سری که بر سر گردون به فخر می‌سودم","به راستان که نهادم، بر آستان فراق","من به خاطر احساس شرف و افتخار، سرم را به آسمان بلند می‌کردم، اما اکنون که سرم را بر آستان فراق گذاشته‌ام، دیگر نمی‌توانم به این احساس ادامه دهم."],[296,"چگونه باز کنم بال در هوای وصال","که ریخت مرغ دلم پر در آشیان فراق","چگونه می‌توانم پرواز کنم و به وصال محبوب برسم، در حالی که دل من به خاطر جدایی از او مثل پرنده‌ای، در آشیان فراق شکسته است؟"],[296,"کنون چه چاره که در بحر غم به گردابی","فتاد زورق صبرم ز بادبان فراق","اکنون چه تدبیری کنم که در دریای غم گرفتار شده‌ام و قایق صبرم به خاطر بادبان فراق (جدایی) در گرداب افتاده است."],[296,"بسی نماند که کشتی عمر غرقه شود","ز موج شوق تو در بحر بی‌کران فراق","بسیار نمانده است که کشتی عمرم به خاطر شدت شوق تو در اقیانوس وسیع جدایی غرق شود."],[296,"اگر به دست من افتد فراق را بکشم","که روز هجر سیه باد و خان و مان فراق","اگر فرصتی به من بدهند، فراق را از بین می‌برم، زیرا روز جدایی، روز بسیار سیاهی است و خانه و دیار جدایی نیز مکانی ناخوشایند است."],[296,"رفیق خیل خیالیم و همنشین شکیب","قرین آتش هجران و هم قران فراق","دوست من در این خیال است و همدم صبر من، همدم آتش دوری و هم‌پایه جدایی است."],[296,"چگونه دعوی وصلت کنم به جان؟ که شده‌ست","تنم وکیل قضا و دلم ضمان فراق","چگونه می‌توانم مدعی وصل و دوستی شوم؟ در حالی که بدنم نماینده سرنوشت و دل‌ام به دلیل جدایی در عذاب است."],[296,"ز سوز شوق دلم شد کباب دور از یار","مدام خون جگر می‌خورم ز خوان فراق","از شدت عشق و دلتنگی برای یار، دل من مانند کباب سوخته است و به طور مداوم در حسرت او خون جگر می‌خورم."],[296,"فلک چو دید سرم را اسیر چنبر عشق","ببست گردن صبرم به ریسمان فراق","چون آسمان دید که من در دام عشق گرفتار شده‌ام، صبرم را به خاطر دوری از یار با نخی محکم به هم بسته است."],[296,"به پای شوق گر این ره به سر شدی حافظ","به دست هجر ندادی کسی عنان فراق","اگر به خاطر شوق به این راه ادامه دادی و به انتها رسیدی، حافظ، به خاطر جدایی، کسی را در اختیار عذاب فراق قرار ندادی."],[297,"مقام امن و می بی‌غش و رفیق شفیق","گرت مدام میسّر شود، زهی توفیق","اگر همواره مقام امن و می بی‌نقص و رفیق دلگشایی به آسانی در دسترست باشد، خیلی خوشا به حال تو که موفقیت همین است."],[297,"جهان و کار جهان جمله هیچ بر هیچ است","هزار بار من این نکته کرده‌ام تحقیق","یار رفیق ماست و ما که جهانیان و جمله کار جهانیم، اثرمان بر رفاقت یار هیچ است. (مثلا اگر ظاهر ما خوب یا بد باشد، یار باز هم رفیق ما می ماند). دلیل هیچ بودن اثر جهان بر رفاقت یار اینستکه جهان نیز نزد یار که خود همه چیز است، هیچ نیست. پس میشود هیچ بر هیچ. شاعر میگوید من این نکته ظریف را هزاران بار به راستی و حقیقت، متوجه شده ام (که علیرغم خوبی یا بدی من، او رفیق من ماند)."],[297,"دریغ و درد که تا این زمان ندانستم","که کیمیای سعادت، رفیق بود، رفیق","متاسفانه، تا به امروز متوجه نشدم که مایه خوشبختی من اینست: پذیرش رفیق بودن یار"],[297,"به مأمنی رو و فرصت شمر غنیمت وقت","که در کمینگه عمرند قاطعان طریق","به پناهگاهی برو و زمان را غنیمت بشمار، زیرا آنهایی که راه را می‌بندند، در کمین عمر هستند."],[297,"بیا که توبه ز لعل نگار و خنده جام","حکایتی‌ست که عقلش نمی‌کند تصدیق","بیا و شاهد باش که توبه کردن از عشق و زیبایی‌های معشوق، و همچنین از لذت‌های می، داستانی است که حتی عقل هم نمی‌تواند آن را تأیید کند."],[297,"اگر چه موی میانت به چون منی نرسد","خوش است خاطرم از فکر این خیال دقیق","هرچند موهای تو به زیبایی من نمی‌رسد، اما خوشحالم که در ذهنم به این خیال زیبا فکر می‌کنم."],[297,"حلاوتی که تو را در چه زنخدان است","به کنه آن نرسد صد‌ هزار فکر عمیق","شیفتگی و لذتی که من از نگاه به تو و زیبایی‌ات در چاه زنبق احساس می‌کنم، به عمق واقعی آن نمی‌رسد حتی اگر صدها اندیشه عمیق درباره‌اش داشته باشم."],[297,"اگر به رنگ عقیقی شد اشک من، چه عجب؟","که مهر خاتم لعل تو هست همچو عقیق","اگر اشک من به رنگ عقیق درآمد، چه تعجبی دارد؟ چون مهر تو که به صورت لعل است، مانند عقیق می‌درخشد."],[297,"به خنده گفت که «حافظ! غلام طبع توام»","ببین که تا به چه حدّم همی کند تحمیق","او با خنده به حافظ می‌گوید که تو به اندازه‌ای تحت تأثیر طبع و سلیقه‌ات قرار داری که برای خودت به این درجه از بی‌خبری رسیده‌ای."],[298,"اگر شراب خوری جرعه‌ای فشان بر خاک","از آن گناه که نفعی رسد به غیر، چه باک؟","اگر شراب بخوری، جرعه‌ای از آن را بر زمین بریز، چرا که اگر این کار را نکنی، نفعی به دیگران می‌رسد و در این صورت عیبی ندارد."],[298,"برو به هر چه تو داری بخور، دریغ مخور","که بی‌دریغ زند روزگار تیغ هلاک","هرچه از دارایی‌ات داری، بخور و از آن لذت ببر و برای این کار تردید نکن، زیرا روزگار به‌سادگی می‌تواند تو را به هلاکت برساند."],[298,"به خاک پای تو ای سرو نازپرور من","که روز واقعه پا وا مگیرم از سر خاک","من به پای تو، ای سرو خوش‌پر و ناز، خاک می‌شوم و در روز قیامت اگر روزی نیاز باشد، از خاک برنمی‌خیزم و در کنار تو می‌مانم."],[298,"چه دوزخی، چه بهشتی، چه آدمی، چه پری","به مذهب همه کفر طریقت است امساک","هر چه وضعیت و حالتی باشد، اعم از درد و خوشی یا انسان و پری، در فلسفه‌ای که من اعتقاد دارم، عدم عمل و دست نگه‌داشتن، بی‌اعتنایی به اصول و قواعد آن مذهب است."],[298,"مهندس فلکی، راه دیر شش جهتی","چنان ببست که ره نیست زیر دیر مغاک","برخورداری از دانش و مهارت فراوان در علم فلک، مثل مهندس آسمان‌ها، به گونه‌ای راهی را برای دسترسی به دینی با شش جهت ایجاد کرده که در واقع هیچ راهی برای رسیدن به آن وجود ندارد و این مکان، مانند دیر (معبد)ی عمیق و تاریک است که در آن، راهی وجود ندارد."],[298,"فریب دختر رز طرفه می‌زند ره عقل","مباد تا به قیامت خراب طارم تاک","فریب و ظرافت دختر زرینی موجب می‌شود که آدمی در مسیر عقل گمراه شود و تا قیامت خرابش می‌کند و در واقع، او را به تباهی می‌کشاند."],[298,"به راه میکده، حافظ! خوش از جهان رفتی","دعای اهل دلت باد، مونس دل پاک","حافظ، به میکده خوش آمده‌ای و از این دنیا می‌روی. دعاهای اهل دل با تو باشد، ای همدم دل پاک."],[299,"هزار دشمنم ار می‌کنند قصد هلاک","گرم تو دوستی از دشمنان ندارم باک","اگر هزاران دشمن بخواهند مرا نابود کنند، نمی‌ترسم زیرا تو دوستی داری و برای من مهم نیست که از دشمنان خود هیچ‌گونه نگران نیستم."],[299,"مرا امید وصال تو زنده می‌دارد","و گر نه هر دمم از هجر توست بیم هلاک","امید به وصال تو مرا زنده نگه می‌دارد، و اگر این امید نبود، هر لحظه از دوری‌ات ترس هلاکت را دارم."],[299,"نفس‌نفس اگر از باد نشنوم بویش","زمان‌زمان چو گل از غم کنم گریبان چاک","اگر هر لحظه، بوی تو را از باد نشنوم، هر دم از غصه و غم، گریبانم را پاره می‌کنم."],[299,"رود به خواب، دو چشم از خیال تو؟ هیهات","بود صبور، دل اندر فراق تو؟ حاشاک","آیا ممکن است دو چشمی که به یاد تو خواب بروند؟ هرگز ممکن نیست دل در فراق تو صبر کند؛ چنین چیزی غیرممکن است."],[299,"اگر تو زخم زنی، به که دیگری مرهم","و گر تو زهر دهی، به که دیگری تریاک","اگر تو آسیبی به من برسانی، خوب است که کسی دیگر به من درمان دهد و اگر تو زهر بدهی، خوب است که کسی دیگر بتواند مرا نجات دهد."],[299,"بضرب سیفک قتلی حیاتنا ابدا","لأنّ روحی قد طاب ان یکون فداک","اگر با شمشیر تو کشته شوم من به حیات جاویدان و ابدی می رسم چرا که روح من اگر فدای تو شود پاک و والا خواهد شد ."],[299,"عنان مپیچ که گر می‌زنی به شمشیرم","سپر کنم سر و دستت ندارم از فتراک","شلاق را به هوای اینکه مرا بترسانی نچرخان اگر تو با شمشیر هم به سراغ من بیایی من سر و دستم رو سپر میکنم حتی اگر سپر نداشته باشم ."],[299,"تو را چنان که تویی هر نظر کجا بیند؟","به قدر دانش خود هر کسی کند ادراک","هر کسی تو را همان‌گونه که هستی درک می‌کند و به تماشای تو می‌نشیند، بنابراین درک و فهم هر شخص به اندازه‌ی دانشی که دارد بستگی دارد."],[299,"به چشم خلق، عزیز جهان شود حافظ","که بر در تو نهد روی مسکنت بر خاک","حافظ به این نکته اشاره می‌کند که او به خاطر عشق و ارادتش به محبوب، نزد مردم به عنوان فردی محترم و عزیز شناخته می‌شود، زیرا برای او افتخار است که در آستان محبوبش سر بر خاک بگذارد."],[300,"ای دل ریش مرا با لب تو حقّ نمک","حق نگه دار که من می‌روم، الله معک","ای عزیز دلداری که دل پاره و ریش شده من با لب تو همنشین بود و به قول معروف از سفره همدیگر نمک خورده بودند. حق نگه دار تو باشد که وقت رفتن من رسیده و تو را به خدا می سپارم"],[300,"تویی آن گوهر پاکیزه که در عالم قدس","ذکر خیر تو بود حاصل تسبیح ملک","تو آن جواهر گران‌بهاتری که در عالم ملکوت، نام نیکویت نتیجه تسبیح فرشتگان است."],[300,"در خلوص منت ار هست شکی، تجربه کن","کس عیار زر خالص نشناسد چو محک","اگر در خلوص و پاکی من شک داری، آن را با تجربه و آزمایش بسنج، زیرا هیچ‌کس نمی‌تواند عیار طلا را که خالص است به اندازه‌ی محک خوب بشناسد."],[300,"گفته بودی که شوم مست و دو بوست بدهم","وعده از حد بشد و ما نه دو دیدیم و نه یک","تو وعده دادی که باید مست شوم تا به تو دو بوسه بدهم ، اما حالا وعده مستی ات از حد گذشت ولی ما دو بوسه را که هیچ حتی یک بوسه هم ندیدیم"],[300,"بگشا پسته خندان و شکرریزی کن","خلق را از دهن خویش مینداز به شک","خود را به شادی و خوشحالی نشان بده و به دیگران نیز شیرینی بده، اما به گونه‌ای که سخن و رفتارت باعث بدبینی و ناراحتی دیگران نشود."],[300,"چرخ برهم زنم ار غیر مرادم گردد","من نه آنم که زبونی کشم از چرخ فلک","اگر چرخ فلک،، یعنی روزگار،، طوری که من دوست دارم نچرخد و اتفاقی که دوست دارم نیوفتد، روزگار را به هم می‌زنم. چون من کسی نیستم که تسلیم روزگار شوم."],[300,"چون بر حافظ خویشش نگذاری باری","ای رقیب از بر او یک دو قدم دورترک","ای رقیب، اگر نمی‌گذاری که دنبال حافظ بروم، دست کم باید یک یا دو قدم از او دورتر باشی."],[301,"خوش خبر باشی ای نسیم شمال","که به ما می‌رسد زمان وصال","ای نسیم شمال، تو خوش خبر باش که زمانی برای دیدار و وصال ما در راه است."],[301,"قصّة العشق لا انفصام لها","فصمت ها هنا لسان القال","قصه ی عشق را پایانی نیست...بلکه آن چه پایان می یابد، زبان است که از گفتن باز می ماند"],[301,"ما لسلمی و من بذی سلم","أین جیراننا و کیف الحال","سلمی (معشوق) و سلماییان (اهل و اهالی قبیله اش) را چه شد؟ آن همسایگانمان کجاهستند و به چه حالی هستند؟"],[301,"عفت الدار بعد عافیة","فاسألوا حالها عن الاطلال","پس از آنکه مدت‌ها از زیبایی و شکوهمندی آن خانه (با نام سلمی) می‌گذرد و حالش دگرگون شده، از ویرانه‌های آن بپرسید که حالش چگونه است."],[301,"فی جمال الکمال نلت منی","صرّف الله عنک عین کمال","در جمال کمال به آرزویت رسیده ای(در اوج هستی) ... خدا تو را ببخشد (در محاوره روزمره برای فرزندان می گوییم: خدا به تون ببخشه) ای عین کمال!"],[301,"یا برید الحمی حماک الله","مرحبا مرحبا تعال تعال","ای نامه بر دوست، خدا حفظت کند ... مرحبا ... مرحبا، بیا ... بیا"],[301,"عرصه بزمگاه خالی ماند","از حریفان و جام مالامال","محل برگزاری مجلس آمدن مهمانان خالی مانده است و از جام پر شراب نیز خبری نیست."],[301,"سایه افکند حالیا شب هجر","تا چه بازند شبروان خیال","در حال حاضر، سایه شب جدایی بر سر من افتاده است و نمی‌دانم خیال‌های خوشم تا چه زمانی شعبده‌بازی خواهند کرد."],[301,"ترک ما سوی کس نمی‌نگرد","آه از این کبریا و جاه و جلال","ما به کسی جز معشوق خود توجهی نداریم و از عظمت و مقام او به شدت احساس حیرت و درد می‌کنیم."],[301,"حافظا عشق و صابری تا چند؟","ناله عاشقان خوش است، بنال","حافظ، ای شاعر! عشق و صبر تا چه زمانی باید ادامه داشته باشد؟ ناله و گریه عاشقان زیبا و دل‌انگیز است، پس بگذار تا بگرید."],[302,"شممت روح وداد و شمت برق وصال","بیا که بوی تو را میرم ای نسیم شمال","بوی عشق و محبتی را استشمام کردم و درخشندگی وصل را حس کردم. ای نسیم شمال بیا که بوی تو را می‌آورم."],[302,"أ حادیا بجمال الحبیب قف و انزل","که نیست صبر جمیلم ز اشتیاق جمال","ای آوازه‌خوان، ای حادی، برای زیبایی محبوب بایست و فرود آ، زیرا صبر من در اشتیاق جمال او به پایان رسیده است."],[302,"حکایت شب هجران فروگذاشته به","به شکر آن که برافکند پرده روز وصال","در شب جدایی، آنچه را که بر من گذشته، فراموش کرده‌ام به خاطر آنکه پرده روشن روز وصال را افکنده‌ام."],[302,"بیا که پرده گلریز هفت خانه چشم","کشیده‌ایم به تحریر کارگاه خیال","بیا و ببین که زیبایی‌های چشم‌هایمان را با رنگ و نقش خیال به تصویر کشیده‌ایم و آن‌ها را در هفت خانه گلابی مانند از گل‌ها پوشانده‌ایم."],[302,"چو یار بر سر صلح است و عذر می‌طلبد","توان گذشت ز جور رقیب در همه حال","وقتی که معشوق در تلاش برای صلح و سازش است و از من عذرخواهی می‌کند، می‌توانم در برابر ظلم و بی‌رحمی رقیب، در هر شرایطی تحمل کنم و به او گذشت کنم."],[302,"به جز خیال دهان تو نیست در دل تنگ","که کس مباد چو من در پی خیال محال","در دل تنگ من جز تصور لب‌های تو چیزی نیست و هیچ‌کس مانند من در پی خیال غیرممکن نیست."],[302,"قتیل عشق تو شد حافظ غریب، ولی","به خاک ما گذری کن که خون مات حلال","حافظ، این شاعر غریب و عاشق، بر اثر عشق تو جان خود را از دست داد، اما خواهش دارد که به خاک وطن ما نگاهی بیندازی، زیرا خون عشق او بی‌گناه و حلال است."],[303,"دارای جهان نصرت دین خسرو کامل","یحیی بن مظفّر ملک عالم عادل","یحیی فرزند مظفر حاکم مقتدر، دانا و دادگستر ، دارنده ی جهان (داریوش سوم) ، یاور دین ، پادشاهی فاضل و کامل است."],[303,"ای درگه اسلام پناه تو گشاده","بر روی زمین روزنه جان و در دل","ای پادشاهی که حاکمیّت تو در پناه اسلام و اسلام تحت حمایت توست بارگاه تو زمین را ملکوتی کرده است. درگاه تو پنجره به روی جان و دریچه ای به روی دل در زمین خاکی گشاده است."],[303,"تعظیم تو بر جان و خرد واجب و لازم","انعام تو بر کون و مکان فایض و شامل","ستایش و احترام تو بر عقل و جان واجب است لطف و عنایت فرا شمول تو تمام اجزای هستی را دربرمی گیرد همه چیز و همه کس از بخشش و سخاوت تو فیض می برند."],[303,"روز ازل از کلک تو یک قطره سیاهی","بر روی مه افتاد که شد حلّ مسائل","اینجا حافظ با رندی تمام مضمون شعر را از مدح به سمت ستایش خداوند هدایت میکند و به پند و موعظه میپردازد ؛ خداوندا به لطف عنایت تو در آغازین روز خلقت، از قلم صنع تو یک قطره بر روی ماه چکید(( اشاره به پر جبرئيل )) را و ‌سبب شد که همه ی مسائل و مشکلات مخلوقات شامل (جدا نبودن روز از شب ، نامعلوم بودن زمان عبادت، کار و استراحت و....) مرتفع گردید."],[303,"خورشید چو آن خال سیه دید، به دل گفت","ای کاج که من بودمی آن هندوی مقبل","خورشید با آن همه نور و روشنایی هنگامی که مشاهده کرد آن \"خال سیاه\"((ماه)) مورد توجّه ویژه ی خداوند قرار گرفته و منشاء خیر و برکت برای مردم و سبب حلّ مسائل آنها شده، از روی رشک و حسادت می گوید ای کاش به جای این غلام سیاه خوشبخت من بودم."],[303,"شاها فلک از بزم تو در رقص و سماع است","دست طرب از دامن این زمزمه مگسل","ای پادشاه ، در سایه ی محفل عیش و عشرت تو چرخ فلک نیز به شور و شوق آمده و مشغول رقص و پای‌کوبیست تو بمان و بگذار ‌مجلس عیش تو همچنان برقرار و مستدام باشد تا همه ی کائنات غرق در شور و شادمانی باشند."],[303,"می نوش و جهان بخش که از زلف کمندت","شد گردن بدخواه گرفتار سلاسل","ای پادشاه ، به باده نوشی و عشرت بپرداز و دست به بخشش های بزرگ بزن که به لطف زنجیر زلفت تو (به برکت خوی نیک تو) بد خواهان به بند و زنجیر کشیده شده اند."],[303,"دور فلکی یکسره بر منهج عدل است","خوش باش که ظالم نبرد راه به منزل","چرخ فلک بر مدار عدالت می چرخد ( گردش چرخ فلک در مسیر روشن و راست قرار دارد) ای دل خوش باش که بار کج ظالم هرگز به منزل نمی رسد."],[303,"حافظ قلم شاه جهان مقسم رزق است","از بهر معیشت مکن اندیشه باطل","ای حافظ اندیشه ی باطل به دل راه مده و از بندگان خدا چشم داشتی نداشته باش که تقسیم کننده ی رزق و روزی شاه جهان خداوند رزّاق است."],[304,"به وقت گل شدم از توبه شراب خجل","که کس مباد ز کردار ناصواب خجل","در زمان گل شدن، به خاطر توبه‌ام از نوشیدن شراب خجالت می‌کشم که هیچ‌کسی به خاطر کار نادرستش شرم نکند."],[304,"صلاح ما همه دام ره است و من زین بحث","نی‌ام ز شاهد و ساقی به هیچ باب خجل","تمام چیزهایی که برای سعادت ما مفید است، دام و تله‌ای در راه است و من از این بحث درباره معشوق و نوشیدنی خجالت می‌کشم."],[304,"بود که یار نرنجد ز ما به خلق کریم","که از سؤال ملولیم و از جواب خجل","امیدوارم که یار از رفتار خوب ما دلگیر نشود، زیرا ما از پرسش خسته‌ایم و از پاسخ‌گویی شرمنده‌ایم."],[304,"ز خون که رفت شب دوش از سراچه چشم","شدیم در نظر رهروان خواب خجل","در شب گذشته، وقتی اشکی از چشمانمان ریخت، از آن اشک در نظر رهگذران خواب، شرمنده و خجالت‌زده شدیم."],[304,"رواست نرگس مست ار فکند سر در پیش","که شد ز شیوه آن چشم پر عتاب خجل","نرگس مست (گل نرگس به معنای معشوق یا محبوب) اگر سرش را پایین بیندازد، گناهی ندارد، زیرا آن چشم پر از سخن و سرزنش (عتاب) باعث شرمندگی است."],[304,"تویی که خوب‌تری ز آفتاب و شکر خدا","که نیستم ز تو در روی آفتاب خجل","تو زیباترینی و شکر خداوند را به جا می‌آورم که نمی‌توانم به خاطر تو در برابر آفتاب شرمنده باشم."],[304,"حجاب ظلمت از آن بست آب خضر که گشت","ز شعر حافظ و آن طبع همچو آب خجل","آب خضر، که سمبلی از زندگی و جاودانگی است، به خاطر حجاب تاریکی محاصره شده و از شعر حافظ و خجالت طبع آن، تحت تأثیر قرار گرفته است. به عبارتی دیگر، شاعری چون حافظ و روح لطیف او، احساس شرم از این تاریکی را به وجود آورده است."],[305,"اگر به کوی تو باشد مرا مجال وصول","رسد، به دولت وصل تو، کار من به اصول","اگر در کوی تو فرصتی برای رسیدن به تو داشته باشم، به برکت وصال تو، کار من به روش‌های اساسی و بنیادی‌اش پیش خواهد رفت."],[305,"قرار برده ز من آن دو نرگس رعنا","فراغ برده ز من آن دو جادو‌ی مکحول","آن دو چشم زیبای سرمه کشیده و جادویی آرامش و صبر و قرار را از من گرفته‌اند"],[305,"چو بر در تو من بینوا‌ی بی زر و زور","به هیچ باب ندارم ره خروج و دخول","من، که آدمی فقیر و ناتوان هستم، وقتی به در خانه تو می‌روم، هیچ راهی که بتوانم وارد یا خارج شوم ندارم."],[305,"کجا روم چه کنم چاره از کجا جویم‌؟","که گشته‌ام ز غم و جور روزگار ملول","نمی‌دانم به کجا بروم یا چه کار کنم و از کجا درمانی برای دردهایم پیدا کنم، زیرا به خاطر غم و ستم روزگار بسیار دلگیر و ناامید شده‌ام."],[305,"من شکسته بدحال زندگی یابم","در آن زمان که به تیغ غمت شوم مقتول","وقتی که در اثر درد و رنج‌های زندگی کشته شوم، در آن لحظه است که خودم را به عنوان انسانی شکسته و بدحال می‌یابم."],[305,"خراب‌تر ز دل من غم تو جای نیافت","که ساخت در دل تنگم قرار‌گاه نزول","غم تو در دل من جا ندارد و هیچ چیز به اندازه آن، دل من را خراب نکرده است؛ زیرا غم تو در دل دچارم کم نبود که آن را پناهگاهی برای نشستن ساخت."],[305,"دل از جواهر مهر‌ت چو صیقلی دارد","بود ز زنگ حوادث هر آینه مصقول","دل اگر از محبت تو مانند جواهر صاف و درخشان شده باشد، بدون شک از زنگار حوادث روزگار پاک خواهد بود."],[305,"چه جرم کرده‌ام؟ ای جان و دل، به حضرت تو","که طاعت من بیدل نمی‌شود مقبول","ای جان و دل، من چه خطایی کرده‌ام که عبادت و اطاعت من که بی‌حالم، در برابر تو پذیرفتنی نیست؟"],[305,"به درد عشق بساز و خموش کن حافظ","رموز عشق مکن فاش پیش اهل عقول","در محبت عشق باید تحمل کنی و ساکت باشی، حافظ، رازهای عشق را به‌طور علنی برای کسانی که دانش و عقل دارند، فاش نکن."],[306,"هر نکته‌ای که گفتم در وصف آن شمایل","هر کو شنید گفتا «للّه درّ قائل»","هر چیزی که درباره آن معشوق گفتم، هر کسی که این را شنید، می‌گوید که این توصیف واقعا شایسته این معشوق است."],[306,"تحصیل عشق و رندی آسان نمود اول","آخر بسوخت جانم در کسب این فضایل","در ابتدا به نظر می‌رسید که رسیدن به عشق و جوانی راحت است، اما در پایان، جانم را در راه به دست آوردن این ویژگی‌های نیک سوزاند."],[306,"حلّاج بر سر دار این نکته خوش سراید","«از شافعی نپرسند امثال این مسائل»","حلّاج (مؤمن بزرگ) در موقع اعدام خود، با لفظی زیبا بیان می‌کند که از عالم بزرگ شافعی درباره این نوع مسائل نمی‌پرسند، زیرا او در فلسفه و اخلاق عمیق نیست و نباید به او چنین سؤالاتی نسبت داد."],[306,"گفتم که «کی ببخشی بر جان ناتوانم؟»","گفت «آن زمان که نبود جان در میانه حائل»","سوال کردم که چه زمانی مرا خواهی بخشید در حالی که جان ضعیف من در خطر است؟ او پاسخ داد: زمانی تو را می‌بخشم که دیگر هیچ مانعی میان جان تو و من وجود نداشته باشد."],[306,"دل داده‌ام به یاری، شوخی‌، کشی، نگاری","مرضیّة السجایا محمودة الخصائل","دل به کمک و محبت یک یار زیبا و شوخ داده‌ام که در او تمام ویژگی‌های نیکو و پسندیده جمع شده است."],[306,"در عین گوشه‌گیری بودم چو چشم مستت","و اکنون شدم به مستان چون ابروی تو مایل","در حالی که در تنهایی و گوشه‌گیری بودم، چشمان پر عشق و مست تو مرا به حالت شاداب و میخواری کشانده است، مانند ابروی کج تو که جذاب و فریبنده است."],[306,"از آب دیده صد ره طوفان نوح دیدم","وز لوح سینه نقشت هرگز نگشت زایل","از اشک‌هایم به اندازه‌ای اندوه و طوفان دیده‌ام که مانند طوفان نوح است. همچنین، تصویر تو از دل من پاک نخواهد شد و هرگز فراموش نمی‌شود."],[306,"ای دوست دست حافظ تعویذ چشم زخم است","یا رب ببینم آن را در گردنت حمایل","ای دوست، دست حافظ به عنوان یک تعویذ برای جلوگیری از چشم زخم است. کاش ببینم این دست را در گردنت آویزان شده باشد."],[307,"ای رخت چون خلد و لعلت سلسبیل","سلسبیلت کرده جان و دل سبیل","روی تو مانند بهشت و لب‌هایت مانند یاقوت است، لب‌هایت جان و دل مرا تحت تأثیر قرار داده است."],[307,"سبزپوشان خطت بر گرد لب","همچو مورانند گرد سلسبیل","آدم‌هایی که لباس سبز پوشیده‌اند و به زیبایی لب تو توجه دارند، مانند مورچه‌هایی هستند که دور سلسبیل (نهر یا آب‌رو) جمع شده‌اند. این تشبیه نشان می‌دهد که چقدر به زیبایی لب تو جذب شده‌اند."],[307,"ناوک چشم تو در هر گوشه‌ای","همچو من افتاده دارد صد قتیل","چشم‌های تو در هر گوشه و نقطه، مانند من، باعث افتادن و نابودی بسیار افراد شده است."],[307,"یا رب این آتش که در جان من است","سرد کن زان سان که کردی بر خلیل","خداوندا، این آتشی که در وجود من زبانه می‌کشد را خاموش کن، همان‌طور که تو آتش ابراهیم خلیل را سرد کردی."],[307,"من نمی‌یابم مجال ای دوستان","گرچه دارد او جمالی بس جمیل","من قادر نیستم فرصت دیدار با شما، دوستانم، را پیدا کنم، هرچند او (دوستان) ظاهری بسیار زیبا و دلربا دارد."],[307,"پای ما لنگ است و منزل بس دراز","دست ما کوتاه و خرما بر نخیل","ما در وضعیتی ناتوان هستیم و راهی طولانی در پیش داریم، در حالی که امکانات ما محدود است و به اهداف‌مان نمی‌رسیم."],[307,"حافظ از سرپنجه عشق نگار","همچو مور افتاده شد در پای پیل","حافظ در این بیت می‌گوید که به خاطر عشق به معشوق (نگار)، مانند موری که در پای فیل افتاده است، در موقعیتی دشوار و آسیب‌پذیر قرار گرفته است. این تصویر نشان‌دهنده ضعف و عدم توانایی او در برابر قدرت و عظمت عشق است."],[307,"شاه عالم را بقا و عزّ و ناز","باد و هر چیزی که باشد زین قبیل","برای شاه عالم، آرزوی جاودانی، عزت و نازش را دارم و برای او هر چیز خوبی که در این زمینه وجود دارد، خواهانم."],[308,"عشقبازیّ و جوانیّ و شراب لعل‌فام","مجلس انس و حریف همدم و شرب مدام","سخن از خوشگذرانی‌ها و لذت‌های جوانی، مانند عشق، شراب خوش‌رنگ و دوست‌های خوب در میانه مجالس شاد و نوشیدن مداوم است."],[308,"ساقی شکّردهان و مطرب شیرین‌سخن","همنشینی نیک‌کردار و ندیمی نیک‌نام","ساقی که لب‌هایش مانند شکر شیرین است و نوازنده‌ای با کلام خوش، همراهی با افرادی نیکوکار و دوستانی با شهرت خوب را توصیف می‌کند."],[308,"شاهدی از لطف و پاکی رشک آب زندگی","دلبری در حسن و خوبی غیرت ماه تمام","شاهدی که در اینجا توصیف می‌شود، به خاطر زیبایی و لطافتش، باعث حسادت آب زندگی شده است. این دلبری در زیبایی و خوبی، به اندازه‌ی غیرت و تمامیت ماه است."],[308,"بزم‌گاهی دل‌نشان، چون قصر فردوس برین","گلشنی پیرامنش چون روضه دارالسّلام","محل و زمان ملاقات دل‌نشین است، به گونه‌ای که مانند بهشت برین است و اطراف آن مانند باغ بهشتی است که در آن آرامش و صفا حاکم است."],[308,"صف‌نشینان نیک‌خواه و پیشکاران باادب","دوست‌داران صاحب‌اسرار و حریفان دوست‌کام","دوستان و همراهان با نیک نیتی که در این میهمانی حضور دارند، افرادی با ادب و دوستداران رازها و راز نگهداران خوش‌فکر هستند."],[308,"باده گلرنگ تلخ تیز خوش‌خوار سبک","نقلش از لعل نگار و نقلش از یاقوت خام","این بیت به توصیف شراب خوش‌طعم و تلخی می‌پردازد که از گل‌های رنگی تهیه شده و به همراه زیبایی خاصی که از لعل (نوعی گوهر) و یاقوت خام دارد، سرو می‌شود. شاعر با این وصف می‌خواهد بگوید که مزه و کیفیت این باده به اندازه زیبایی نگار (معشوق) دلپذیر و جذاب است."],[308,"غمزه ساقی به یغمای خرد آهخته تیغ","زلف جانان از برای صید دل گسترده‌دام","غمه ساقی (مشروب‌فروش) با چشمان چشمک‌زنش عقل را به سرقت می‌برد و تیغ موهای جانان (عشق) به خاطر ربودن دل‌ها، دام‌های خود را گسترش داده است."],[308,"نکته‌دانی بذله‌گو چون حافظ شیرین‌‌سخن","بخشش‌آموزی جهان‌افروز چون حاجی قوام","حافظ، شاعر شیرین‌سخن و نکته‌سنج را به عنوان کسی معرفی می‌کند که سخنانش دلنواز و آموزنده است، و حاجی قوام را به عنوان فردی که می‌تواند نورانی‌کننده‌ی جهان باشد، به تصویر می‌کشد."],[308,"هر که این عشرت نخواهد خوش‌دلی بر وی تباه","وان که این مجلس نجوید زندگی بر وی حرام","هر کس به این جشن و خوشی دل ندهد، خوش‌دلی‌اش از بین می‌رود و کسی که به این مجلس زیبا و شاداب رغبت نکند، زندگی‌اش بر او حرام است."],[309,"مرحبا طایر فرّخ پی فرخنده پیام","خیر مقدم چه خبر؟ دوست کجا؟ راه کدام؟","سلام بر پرنده‌ای که خبر خوبی از افتخارات و خوش‌نامی می‌آورد. حالا بگو دوست کجاست و مسیرش کدام است؟"],[309,"یا رب این قافله را لطف ازل بدرقه باد","که از او خصم به دام آمد و معشوقه به کام","ای خدا، امیدوارم این کاروان را با رحمت و لطف خود همراهی کنی، چرا که دشمنان به دام افتاده‌اند و معشوقه به خوشبختی رسیده است."],[309,"ماجرای من و معشوق مرا پایان نیست","هر چه آغاز ندارد نپذیرد انجام","داستان رابطه من با معشوقم پایانی ندارد و هر چیزی که از ابتدا آغاز نشود، نمی‌تواند به پایان برسد."],[309,"گل ز حد برد تنعّم نفسی رخ بنما","سرو می‌نازد و خوش نیست خدا را بخرام","گل که زیبایی‌اش را از حد فراتر می‌برد، با دلبری و ناز خود رخ می‌نماید، مانند سرو که به خود می‌بالد و این همه زیبایی، خوشایند خداست؛ بنابراین، ای محبوب، با ناز و لطافت خود حرکت کن."],[309,"زلف دلدار چو زنّار همی‌فرماید","برو ای شیخ که شد بر تن ما خرقه حرام","زلف معشوق مانند زنجیر است و به ما می‌گوید، ای شیخ (ابله)، بر ما لازم است که لباس خود را که نشانه دینداری است، کنار بگذاریم."],[309,"مرغ روحم که همی‌زد ز سر سدره صفیر","عاقبت دانه خال تو فکندش در دام","روح من مانند پرنده‌ای است که از درخت سدر، به‌خاطر زیبایی و جذابیت تو، آواز می‌خواند و در نهایت، به دام عشق تو گرفتار می‌شود."],[309,"چشم بیمار مرا خواب نه در خور باشد","من له یقتل داء دنف کیف ینام؟","چشم بیمار من نمی‌تواند خواب ببیند، چون چگونه ممکن است کسی که بیماری خطرناکی دارد، بخوابد؟"],[309,"تو ترحّم نکنی بر من مخلص گفتم","ذاک دعوای و ها انت و تلک الایّام","تو نسبت به من خالص و باوفا رحم نمی‌کنی، به همین دلیل گفتم که این مساله دعا و نفرین است و تو به همین وضع ادامه می‌دهی، و این روزهای بد را سپری خواهی کرد."],[309,"حافظ ار میل به ابروی تو دارد شاید","جای در گوشه محراب کنند اهل کلام","حافظ می‌گوید اگر عاشق ابروی تو باشد، ممکن است اهل سخن و علم، او را در مکان مقدس و خاصی قرار دهند."],[310,"عاشق روی جوانی خوش نوخاسته‌ام","وز خدا دولت این غم به دعا خواسته‌ام","من عاشق روی جوانی زیبا و تازه‌ام و برای رسیدن به نعمت این غم، از خداوند درخواست کرده‌ام."],[310,"عاشق و رند و نظربازم و می‌گویم فاش","تا بدانی که به چندین هنر آراسته‌ام","من عاشق و خوش‌گذران و اهل دیدن زیبایی‌ها هستم و صادقانه می‌گویم که تا بدانی با چه مهارت‌ها و هنرهایی زیبایی‌های خود را به نمایش گذاشته‌ام."],[310,"شرمم از خرقه آلوده خود می‌آید","که بر او وصله به صد شعبده پیراسته‌ام","از خرقه‌ی آلوده‌ام خجالت می‌کشم، زیرا در این لباس کهنه، خود را با صد ترفند و شعبده آراسته‌ام."],[310,"خوش بسوز از غمش ای شمع که اینک من نیز","هم بدین کار کمربسته و برخاسته‌ام","ای شمع، از غمش خوشحال باشید و بسوزید، زیرا من نیز همین‌گونه برای عشق و دلدادگی خود آماده و بلند شده‌ام."],[310,"با چنین حیرتم از دست بشد صرفه کار","در غم افزوده‌ام آنچ از دل و جان کاسته‌ام","به خاطر حیرت و شگفتی‌ای که دارم، از تدبیر و فایده کار دلسرد شده‌ام و برغم افزوده‌ام، چیزی که از دل و جانم کم کرده‌ام."],[310,"همچو حافظ به خرابات روم جامه قبا","بو که در بر کشد آن دلبر نوخاسته‌ام","به مانند حافظ به میخانه می‌روم، زیرا که به خاطر آن معشوق تازه‌کارم باید لباسی مخصوص بپوشم."],[311,"بشری اذ السّلامة حلّت بذی سلم","للّه حمد معترف غایة النّعم","مژده باد (و بسی شکر) که سلامتی به شخص صاحب سلامت باز آمد _ ستایش و سپاس خدایی را سزاست که اقرار میکنیم به نهایت نعمت‌های بی‌کرانش"],[311,"آن خوش خبر کجاست؟ که این فتح، مژده داد","تا جان فشانمش چو زر و سیم در قدم","خوشخبری که خبر پیروزی را به من داده کجاست؟ من آماده‌ام که جانم را مانند زر و سیم در پای او نثار کنم."],[311,"از بازگشت شاه در این طرفه منزل است","آهنگ خصم او به سراپرده عدم","از (مبارکی) قدم شاه است که تا به این منزل قدم گذاشت ؛ دشمن او به سمت نابود شدن و شکست خوردن می‌رود ."],[311,"پیمان شکن هرآینه گردد شکسته حال","انّ العهود عند ملیک النّهی ذمم","پیمان‌شکن بی‌گمان هر لحظه ، شکسته‌حال و خوار می‌گردد، چرا که وفای به عهد و پیمان‌ نزد خداوند صاحب اختیار ، (مسئولیتی مقدس و) واجب‌ است... اشاره به آیه «وأوفوا بالعهد إنّ العهد کان مسئولا» (سوره اسراء، آیه ۳۴)"],[311,"می‌جست از سحاب امل رحمتی ولی","جز دیده‌اش معاینه بیرون نداد نم","از ابر رحمت حق ، امیدی طلب میکرد(که مثل باران رحمت ببارد) ولی _ چیزی که نصیبش شد این بود که چشمهای خودش پر اشک شد(دعا کننده مورد رحمت قرار گرفت ولی خودش از این موضوع بی‌خبر بود)"],[311,"در نیل غم فتاد؛ سپهرش به طنز گفت","الآن قد ندمت و ما ینفع النّدم؟","وقتی در رودخانه غم افتاد ، آسمان با طنز و طعنه به او گفت: اکنون که پشیمان شدی ، دیگر پشیمانی چه فایده‌ای دارد؟"],[311,"ساقی چو یار مه رخ و از اهل راز بود","حافظ بخورد باده و شیخ و فقیه هم","چون که ساقی دوست و یار زیبا روی و از دانایان سرّ بود ، هم حافظ را شراب داد و هم شیخ و هم فقیه را"],[312,"بازآی ساقیا که هواخواه خدمتم","مشتاق بندگیّ و دعاگوی دولتم","ای ساقی، دوباره برگرد که من خیلی مشتاق خدمتم و به دیانت و دعاگویی تو نیاز دارم."],[312,"زان جا که فیض جام سعادت فروغ توست","بیرون شدی نمای ز ظلمات حیرتم","از آنجایی که نور و خوشبختی من از وجود تو نشات می‌گیرد،راه برون رفتی از تاریکی و سردرگمی‌هایم نشانم بده"],[312,"هرچند غرق بحر گناهم ز صد جهت","تا آشنای عشق شدم ز اهل رحمتم","با وجود اینکه در گناهان بسیاری غرق هستم و از زوایای مختلف به آن‌ها درگیر شده‌ام، به خاطر آشنایی با عشق، از رحمت و محبت اهل آن بهره‌مند شده‌ام."],[312,"عیبم مکن به رندی و بدنامی ای حکیم","کاین بود سرنوشت ز دیوان قسمتم","ای حکیم، به خاطر رندی و بدنامی‌ام مرا عیب‌جوئی نکن، زیرا این موضوع نتیجه سرنوشت من است که از دیوان تقدیرم نوشته شده است."],[312,"می خور که عاشقی نه به کسب است و اختیار","این موهبت رسید ز میراث فطرتم","شراب بنوش زیرا که عشق، امری نیست که با تلاش و انتخاب به دست آید. این نعمت به‌صورت طبیعی و از ویژگی‌های ذاتی‌ام به من رسیده است."],[312,"من کز وطن سفر نگزیدم به عمر خویش","در عشق دیدن تو هواخواه غربتم","من هیچ وقت از وطنم دور نشدم، اما عشق دیدن تو باعث شده است که به اختیار غربت را بخواهم."],[312,"دریا و کوه در ره و من خسته و ضعیف","ای خضر پی خجسته مدد کن به همتم","در این بیت، شاعر از خستگی و ضعف خود در سفر سخن می‌گوید و از خضر، شخصیت اسطوره‌ای و نماد دانش و رهبری در راه درست، درخواست کمک می‌کند تا او را در تلاشش یاری دهد. دریا و کوه نشانه‌های موانع سخت در مسیر او هستند."],[312,"دورم به صورت از در دولتسرای تو","لیکن به جان و دل ز مقیمان حضرتم","در ظاهر من از درگاه تو دور هستم، اما از عمق جان احساس دلبستگی و نزدیکی میکنم"],[312,"حافظ به پیش چشم تو خواهد سپرد جان","در این خیالم ار بدهد عمر مهلتم","حافظ برای عشق تو جان خود را فدا می‌کند. و امید دارد که عمرش برای رسیدن به این آرزو کافی باشد."],[313,"دوش بیماری چشم تو ببرد از دستم","لیکن از لطف لبت صورت جان می‌بستم","دیشب بیماری چشم تو مرا بی‌هوا و ناگهانی بی‌نوا کرد، اما به خاطر مهربانی لب‌هایت جانی تازه گرفتم و دوباره سرپا شدم."],[313,"عشق من با خط مشکین تو امروزی نیست","دیرگاه است کز این جام هلالی مستم","عشقم به تو که دارای خطی به رنگ مشکی هستی، تازگی ندارد و مدت زیادی است که من از این جام هلالی، که نماد شراب است، مست شده‌ام."],[313,"از ثبات خودم این نکته خوش آمد که به جور","در سر کوی تو از پای طلب ننشستم","خوشحالم که توانسته‌ام ثابت‌قدم بمانم و به رغم مشکلات و سختی‌هایی که در سر کوی تو دارم، از تلاش برای رسیدن به تو دست برنداشته‌ام."],[313,"عافیت چشم مدار از من میخانه‌نشین","که دم از خدمت رندان زده‌ام تا هستم","به کسانی که از من در مقام یک میخانه‌نشین انتظار راحتی و آسایش دارند، توجه نکنید. من مدام در خدمت رندان (خاکسارانی که در میخانه‌اند) بوده‌ام و تا زنده‌ام، این کار را ادامه خواهم داد."],[313,"در ره عشق از آن سوی فنا صد خطر است","تا نگویی که چو عمرم به سر آمد رستم","در مسیر عشق، خطرات زیادی وجود دارد و نمی‌توان به سادگی گفت که وقتی عمرم به پایان رسید، از این گرفتاری‌ها راحت شدم."],[313,"بعد از اینم چه غم از تیر کج انداز حسود","چون به محبوب کمان ابروی خود پیوستم","بعد از این، نگرانی‌ای از تیرهای بی‌هدف حسودان ندارم چون به محبوبی که ابروهایش مانند کمان است، ملحق شدم."],[313,"بوسه بر درج عقیق تو حلال است مرا","که به افسوس و جفا مهر وفا نشکستم","بوسه بر عقیق سرخ و زیبای تو بر من حلال است، زیرا با وجود غم و جفا‌ی تو، عهد و وفایم را نشکستم."],[313,"صنمی لشکریم غارت دل کرد و برفت","آه اگر عاطفت شاه نگیرد دستم","یک بت جنگاور، دلم را به‌غارت برد و رفت، وای بر من اگر لطف شاه به‌داد من نرسد."],[313,"رتبت دانش حافظ به فلک بر شده بود","کرد غم‌خواری شمشاد بلندت پستم","مقام و دانش حافظ به آسمان رسیده بود، اما غم‌خواری تو، ای شمشاد بلند، مرا به زمین انداخت."],[314,"به غیر از آن که بشد دین و دانش از دستم","بیا بگو که ز عشقت چه طرف بربستم؟","به جز از این که دین و دانش را به خاطر عشق تو از دست دادم، بگو که از عشق تو چه نفعی برای خودم بردم؟"],[314,"اگر چه خرمن عمرم غم تو داد به باد","به خاک‌پای عزیزت که عهد نشکستم","با اینکه عمرم در راه غم تو بر باد رفت، اما به خاک پای تو که برایم عزیز است قسم که من هرگز زیر فولی که به تو داده بودم نزدم."],[314,"چو ذرّه گرچه حقیرم؛ ببین به دولت عشق","که در هوای رخت چون به مهر پیوستم","هرچند که به اندازه یک ذره کوچک و بی‌ارزش هستم، ولی عشق تو باعث شده که در آرزوی چهره‌ات به مقام و خوشبختی بزرگی دست یابم، چون به عشق تو وصل شدم."],[314,"بیار باده که عمریست تا من از سر امن","به کنج عافیت از بهر عیش ننشستم","باده بیاور، زیرا سال‌هاست که من از محیط امن و آرامش به گوشه‌ی راحتی برای خوش‌گذرانی نیامده‌ام."],[314,"اگر ز مردم هشیاری ای نصیحت‌گو","سخن به خاک میفکن؛ چرا که من مستم","اگر از کسی که اهل تبعیت و آگاهی است نصیحتی بپرسی، آن را نپذیر؛ زیرا من در حال مستی هستم و نمی‌توانم به این حرف‌ها توجه کنم."],[314,"چگونه سر ز خجالت برآورم بر دوست","که خدمتی بسزا برنیامد از دستم","من چطور می‌توانم به دوست نازنینم نگاه کنم و سرم را بالا بیاورم، در حالی که نتوانسته‌ام خدمتی شایسته به او کنم؟"],[314,"بسوخت حافظ و آن یار دلنواز نگفت","که مرهمی بفرستم که خاطرش خستم","حافظ به طور غم‌انگیزی اشاره می‌کند که در حال سوختن از عشق است، ولی آن یار خوش‌صدا هیچ توجهی نمی‌کند و نمی‌گوید که کمکی بکند تا دل او آرام گیرد."],[315,"زلف بر باد مده تا ندهی بر بادم","ناز بنیاد مکن تا نکنی بنیادم","اگر می‌­خواهی مرا از شدت عشق نیست و نابود نکنی، گیسویت را در باد رها نکن، همچنین اگر می­خواهی بنیاد هستی مرا نابود نکنی، عشوه و ناز آغاز نکن.(بنیاد اول در معنای شروع و آغاز کردن، بنیاد دوم در معنای اصل و اساس.)"],[315,"می مخور با همه کس تا نخورم خون جگر","سر مکش تا نکشد سر به فلک فریادم","با هر کس و ناکسی مشغول عیش و نوش نشو تا از شدت اندوه خون جگر نخورم، همچنین از من روی بر مگردان تا فریادم به آسمان نرسد."],[315,"زلف را حلقه مکن تا نکنی در بندم","طرّه را تاب مده تا ندهی بر بادم","زلفت را پر پیچ و تاب نکن تا مرا اسیر و دربند نکنی، همچنین زلف آراسته­‌ات را تاب مده تا مرا نیست و نابود نکنی."],[315,"یار بیگانه مشو تا نبری از خویشم","غم اغیار مخور تا نکنی ناشادم","همنشین افراد بیگانه نشو تا مرا بی­قرار و بی‌­تاب نکنی، همچنین غم‌خوار نامحرمان نشو تا مرا غمگین نگردانی."],[315,"رخ برافروز که فارغ کنی از برگ گلم","قد برافراز که از سرو کنی آزادم","چهره­‌ی همچون گل خود را نشان بده تا دیگر احتیاجی به دیدن گل نداشته باشم، قامت بلند خود را نمایان کن تا دیگر از تماشای سرو رها شوم."],[315,"شمع هر جمع مشو ور نه بسوزی ما را","یاد هر قوم مکن تا نروی از یادم","چشم‌­نمای هر جمعی نشو (چونان شمع در هر مجلسی درخشان نشو) وگرنه مرا خواهی سوزاند، همچنین از هر گروهی یاد نکن تا هرگز از خاطرم بیرون نروی.(نکته: شمع خود را می­‌سوزاند اما حافظ در اینجا مدعی است: هنگامی که معشوق در مجلس چون شمع می­‌درخشد، عاشق را می­‌سوزاند.نکته ۲: از یاد رفتن می­توان ایهام گرفت: ۱. از یاد من خواهی رفت. ۲. مرا از یاد ببری.)"],[315,"شهره شهر مشو تا ننهم سر در کوه","شور شیرین منما تا نکنی فرهادم","خود را در شهر مشهور و انگشت‌­نما نکن تا از شدت بی‌­قراری و آوارگی سر به کوه نگذارم، همچنین شور و غوغایی همچون شیرین از خود نشان مده تا مرا همچون فرهاد عاشق و سرگشته نکنی."],[315,"رحم کن بر من مسکین و به فریادم رس","تا به خاک در آصف نرسد فریادم","به من بیچاره رحم کن و به فریادم برس، تا فریاد دادخواهی من به درگاه آصف نرسد.(آصف: وزیر معروف حضرت سلیمان، در اینجا منظور خواجه جلال الدین تورانشاه است، یکی از ممدوحین حافظ.)"],[315,"حافظ از جور تو حاشا که بگرداند روی","من از آن روز که در بند توام آزادم","دورباد از حافظ اگر روزگاری از ظلم و جور تو روی بگرداند چرا که از آن روزی که مبتلا و اسیر تو شده است، (از تعلقات دنیوی) آزاد و رها گشته است."],[316,"فاش می‌گویم و از گفته خود دلشادم","بنده عشقم و از هر دو جهان آزادم","صراحتا می‌گویم و از گفته‌ام خوشحال هستم که من بنده عشق هستم و از هر دو جهان آزاد شده‌ام."],[316,"طایر گلشن قدسم چه دهم شرح فراق؟","که در این دامگه حادثه چون افتادم","پرنده‌ای هستم که به باغ بهشت تعلق دارد، چطور می‌توانم داستان جدایی‌ام را بگویم که چگونه به این دنیای پر از حادثه آمده‌ام."],[316,"من ملک بودم و فردوس برین جایم بود","آدم آورد در این دیر خراب‌آبادم","من در اصل ملک (فرشته) بوده‌ام و بهشت جایگاه من بوده است، ولی اکنون آدم (انسان) مرا به این مکان خراب و بی‌کسی (دیر) آورده است."],[316,"سایه طوبی و دلجویی حور و لب حوض","به هوای سر کوی تو برفت از یادم","لذت بودن زیر سایه درخت طوبی و در آغوش حوری‌ها و آرامش نشستن لب حوض بهشتی را به‌خاطر لذت بودن در کوی تو (نزدیک تو) فراموش کرده‌ام."],[316,"نیست بر لوح دلم جز الف قامت دوست","چه کنم حرف دگر یاد نداد استادم","در دل من فقط تصویر دوست نقش بسته است و هیچ چیز دیگر یاد من نیامده است که معلم به من چیزی غیر از این آموزش داده باشد."],[316,"کوکب بخت مرا هیچ منجّم نشناخت","یا رب از مادر گیتی به چه طالع زادم؟","هیچ ستاره‌شناسی نتوانست بخت و سرنوشت مرا بشناسد. ای خدای بزرگ، نمی‌دانم با چه بخت و سرنوشتی پا به این دنیا گذاشته‌ام."],[316,"تا شدم حلقه به گوش در میخانه عشق","هر دم آید غمی از نو به مبارکبادم","وقتی که به گردن‌ آویختن گردنبند به محبت و عشق در میخانه عادت کردم، هر لحظه غم تازه‌ای به من اضافه می‌شود که باید آن را تبریک بگویم."],[316,"می‌خورد خون دلم مردمک دیده، سزاست","که چرا دل به جگرگوشه مردم دادم","شایسته است که از چشمانم خون به‌جای اشک ببارد زیرا عاشق فرزند عزیز مردم شده‌ام."],[316,"پاک کن چهره حافظ به سر زلف ز اشک","ور نه این سیل دمادم ببرد بنیادم","اشک روی صورت حافظ را با نوک موهایت پاک کن و اگر این‌کار را نکنی، این اشک‌ها تبدیل به سیل پی‌درپی می‌شود و بنیاد و پایه زندگی‌ام را نابود می‌کند."],[317,"مرا می‌بینی و هر دم زیادت می‌کنی دردم","تو را می‌بینم و میلم زیادت می‌شود هر دم","مرا می­‌بینی و هر لحظه درد عشق من نسبت به تو بیشتر و افزون­‌تر می­گردد، تو را می­‌بینم و هر لحظه شور و اشتیاقم نسبت به دیدارت بیشتر می­‌شود."],[317,"به سامانم نمی‌پرسی، نمی‌دانم چه سر داری","به درمانم نمی‌کوشی، نمی‌دانی مگر دردم؟","از وضع و حالم جویا نمی­‌شوی، نمی‌دانم که چه اندیشه و قصدی در سر داری؟ هیچ کاری جهت بهبود و تسکین درد من نمی­‌کنی مگر از درد من اطلاع نداری؟"],[317,"نه راه است این که بگذاری مرا بر خاک و بگریزی","گذاری آر و بازم پرس تا خاک رهت گردم","این که مرا بر خاک رها کنی و بروی، رفتار و راه درستی نیست، (برای یک بار شده) گذری کن و از حال ما جویا شو تا جانم را پیشکش قدم­‌هایت کنم."],[317,"ندارم دستت از دامن، به جز در خاک و آن دم هم","که بر خاکم روان گردی بگیرد دامنت گردم","هرگز دست از تو نخواهم کشید و تو را رها نخواهم کرد مگر بعد از اینکه مرده باشم و در خاک رفته باشم، حتی در آن لحظه نیز اگر بر خاک مزارم عبور کنی، گرد و خاک مزارم دامنت را رها نخواهد کرد(گرد و خاک مزارم از تو بازخواست خواهد کرد)."],[317,"فرو رفت از غم عشقت دمم دم می‌دهی تا کی؟","دمار از من برآوردی نمی‌گویی برآوردم","از غم عشق تو نفسم بند آمده است، تا کی می­‌خواهی مرا فریب دهی؟ مرا شکنجه و عذاب بسیار می‌­دهی؛ حتی این مطلب را (شکنجه دادن) اقرار نمی­‌کنی و اجازه نفس کشیدن هم نمی­‌دهی.(ایهام: نمی گویی برآوردم؛ ۱. اقرار کردن، ۲. برآور دم( نفس بکش))"],[317,"شبی دل را به تاریکی ز زلفت باز می‌جستم","رخت می‌دیدم و جامی هلالی باز می‌خوردم","شبی دلم را در تاریکی(تاریکی زلف، تاریکی شب) در میان زلفت جستجو می­‌کردم و چهره‌­ی همچون ماه تابناک تو را می‌­دیدم و چنان سرمست می­‌شدم که گویی ساغری از باده نوشیده­‌ام."],[317,"کشیدم در برت ناگاه و شد در تاب گیسویت","نهادم بر لبت لب را و جان و دل فدا کردم","ناگهان تو را در آغوش کشیدم و گیسویت در حرکت آمد و پیچ و تاب خورد؛ لبم را بر لبت نهادم و جان و دل خود را فدایت کردم."],[317,"تو خوش می‌باش با حافظ، برو گو خصم جان می‌ده","چو گرمی از تو می‌بینم، چه باک از خصم دم سردم","تو با حافظ خوش باش به دشمن بگو برو از حسادت بمیر، وقتی از جانب تو مهربانی و گرمی می­‌بینم دیگر ترسی از دشمنان افسرده دل و بد زبان ندارم."],[318,"سال‌ها پیروی مذهب رندان کردم","تا به فتویّ خرد حرص به زندان کردم","سال‌ها از پی‌روی و اطاعت عقاید بندگان آزاد فکر گذراندم، تا با رأی و حکم عقل، آرزو و طمع را به بند کشیدم."],[318,"من به سرمنزل عنقا نه به خود بردم راه","قطع این مرحله با مرغ سلیمان کردم","من به سرمنزل عنقا که مرحله نهایی ورسیدن به کمال است بخودی خود نرسیدم قطعا وقطع بیقین اینکاررابا کمک وهمراهی هدهد که جانان .میباشد به اینجا رسیدم"],[318,"سایه‌ای بر دل ریشم فکن ای گنج روان","که من این خانه به سودای تو ویران کردم","ای گنج روان (خاطر خوش و دل‌انگیز)، سایه‌ای که بر دل غمگین من افتاده است را از وجودم دور کن، زیرا من به خاطر عشق تو، این خانه را خراب کرده‌ام."],[318,"توبه کردم که نبوسم لب ساقی و کنون","می‌گزم لب که چرا گوش به نادان کردم","من تصمیم گرفتم که دیگر لب ساقی را نبوسم، اما حالا می‌گویم چرا به حرف‌های نادان گوش دادم و این کار را کردم."],[318,"در خلاف‌آمد عادت بطلب کام! که من","کسب جمعیت از آن زلف پریشان کردم","بر خلاف عادت عمل کردن و تنوع طلبی مایه کامجویی است. اگر ازین مسیر دنبال کام خود باشی در همه چیز آثار خالق را می بینی و دلت به وجود او قرص شده، خاطرت جمع خواهد شد."],[318,"نقش مستوری و مستی نه به دست من و توست","آن چه سلطان ازل گفت بکن، آن کردم","آنچه در این بیت بیان شده این است که نه تنها من و تو (معشوق و شاعر) نتوانسته‌ایم نقشی در پنهان‌کاری و شراب‌خواری خود داشته باشیم، بلکه تمامی این رفتارها و سرنوشت‌های ما بر اساس آنچه که خدا (سلطان ازل) مقرر کرده، انجام شده است."],[318,"دارم از لطف ازل جنّت فردوس طمع","گرچه دربانی میخانه فراوان کردم","از نعمت و لطفی که از ازل به من داده شده، به بهشت فردوس امید دارم، هرچند که دربهشت میخانه (محل خوش‌گذرانی و شادی) تلاش و کوششی زیادی کرده‌ام."],[318,"این که پیرانه‌سرم صحبت یوسف بنواخت","اجر صبریست که در کلبه احزان کردم","اینکه در سال‌های پیری‌ام، محبت یوسف (نماد جمال و زیبایی) به من بخشیده شده، پاداش صبری است که در زندگی پر از غمم (کلبه احزان) به خرج داده‌ام."],[318,"صبح‌خیزی و سلامت طلبی چون حافظ","هر چه کردم همه از دولت قرآن کردم","صبح زود بلند شدن و طلب سلامتی کردن، مانند حافظ، تمام کارهایی که انجام داده‌ام تنها به خاطر برکت قرآن بوده است."],[318,"گر به دیوان غزل صدرنشینم چه عجب؟","سال‌ها بندگی صاحب دیوان کردم","اگر در دیوان غزل جایگاه بالایی داشته باشم، جای تعجبی نیست؛ زیرا سال‌ها در خدمت و بندگی صاحب این دیوان (خدا) بوده‌ام."],[319,"دیشب به سیل اشک ره خواب می‌زدم","نقشی به یاد خطّ تو بر آب می‌زدم","دیشب در حالی که اشک‌های زیادی می‌ریختم، به خواب می‌رفتم و در عالم خواب، تصویری از خط تو را بر روی آب می‌کشیدم."],[319,"ابروی یار در نظر و خرقه سوخته","جامی به یاد گوشه محراب می‌زدم","با دیدن ابروی معشوق، در حالی که لباس پاره‌ای برتن داشتم، به یاد گوشه عبادتگاه مشغول نوشیدن جام بودم."],[319,"هر مرغ فکر کز سر شاخ سخن بجست","بازش ز طرّه تو به مضراب می‌زدم","هر اندیشه و فکری که از زبان و بیان بیرون می‌پرد، دوباره آن را با زیبایی و طراوت تو همراه می‌کردم و به آن شکل می‌دادم."],[319,"روی نگار در نظرم جلوه می‌نمود","وز دور بوسه بر رخ مهتاب می‌زدم","تصویر چهره معشوق در نظرم نمایان بود و از دور، بوسه‌ای بر صورت ماه، که نماد زیبایی است، می‌زدم."],[319,"چشمم به روی ساقی و گوشم به قول چنگ","فالی به چشم و گوش در این باب می‌زدم","چشمم به چهره ساقی دوخته و به صدای چنگ (ساز) گوش می‌دادم و در این حال به جستجوی فال و نشانه‌ای از عشق می‌پرداختم."],[319,"نقش خیال روی تو تا وقت صبحدم","بر کارگاه دیده بی‌خواب می‌زدم","تصویر خیال تو را تا صبح در کارگاه چشم‌های بیدارم نقاشی می‌کردم."],[319,"ساقی به صوت این غزلم کاسه می‌گرفت","می‌گفتم این سرود و می ناب می‌زدم","من به ساقی می‌گویم که وقتی آواز این غزل را می‌خواند و جام را پر می‌کند، من می‌گویم که این شعر و شراب خالص را می‌نوشم."],[319,"خوش بود وقت حافظ و فال مراد و کام","بر نام عمر و دولت احباب می‌زدم","در زمان خوشی و کامیابی حافظ، او به نام عمر و موفقیت دوستانش، فال نیک می‌گرفت و برایشان آرزو و دعا می‌کرد."],[320,"هر چند پیر و خسته‌دل و ناتوان شدم","هر گه که یاد روی تو کردم جوان شدم","هرچند که جسمم سالم نیست و دلم نیز خسته و ناتوان است، اما هر بار که به یاد چهره تو می‌افتم، احساس جوانی و سرزندگی می‌کنم."],[320,"شکر خدا که هر چه طلب کردم از خدا","بر منتهای همت خود کامران شدم","خدا را شکر می‌کنم که هر چیزی را که از او خواستم، با نهایت تلاش و اراده‌ام به آن رسیدم و موفق شدم."],[320,"ای گلبن جوان! بر دولت بخور که من","در سایه تو بلبل باغ جهان شدم","ای گل زیبای جوان! به خاطر خوشبختی‌ات شادی کن، چون من به خاطر تو در سایه وجودت مانند بلبل در باغ دنیا خوشحال و شاداب شدم."],[320,"اول ز تحت و فوق وجودم خبر نبود","در مکتب غم تو، چنین نکته‌دان شدم","در ابتدا از عالم وجود و حالتم هیچ اطلاعی نداشتم، اما در مکتب عشق و غم تو، به چنین دانشی دست یافتم."],[320,"قسمت حوالتم به خرابات می‌کند","هر چند کاینچنین شدم و آنچنان شدم","من را به خرابات (محل زهد و جنون) سپردند، هرچند که من به این حال و روز درآمده‌ام و آن کارها را انجام داده‌ام."],[320,"آن روز بر دلم در معنی گشوده شد","کز ساکنان درگه پیر مغان شدم","در آن روز در قلب من معنای عمیق زندگی آشکار شد و به واسطه ماواگزینی در محفل و فضایی که متعلق به پیر مغان (رهبر یا افرادی در جمع صوفیان و مغان) بود، به یکی از ساکنان آنجا تبدیل شدم."],[320,"در شاه‌راه دولت سرمد به تخت بخت","با جام می به کام دل دوستان شدم","در مسیر جاودانگی و کامیابی، با نوشیدن می و شادی همراه دوستانم، به جایگاهی رفیع دست یافتم."],[320,"از آن زمان که فتنه چشمت به من رسید","ایمن ز شرّ فتنه آخرزمان شدم","از زمانی که زیبایی و جاذبه چشم تو به من خطور کرد، از شرّ بحران‌ها و نگران‌های آخرالزمان در امان ماندم."],[320,"من پیر سال و ماه نیم، یار بی‌وفاست","بر من چو عمر می‌گذرد پیر از آن شدم","من پیر شده سال و ماه نیستم، بلکه عمر بی‌وفاست؛ برای آن پیر شده‌ام که عمر من می‌گذرد."],[320,"دوشم نوید داد عنایت که حافظا","بازآ که من به عفو گناهت ضمان شدم","دیشب خبری خوش به من رسید که ای حافظ، به تو می‌گویم بازگرد و بدان که من برای بخشش گناهان تو تضمین کرده‌ام."],[321,"خیال نقش تو در کارگاه دیده کشیدم","به صورت تو نگاری ندیدم و نشنیدم","تصویر تو را در ذهنم مجسم کردم، اما هیچ زیبایی در چهره‌ات نیافتم که به آن شبیه باشد."],[321,"اگرچه در طلبت هم عنان باد شمالم","به گرد سرو خرامان قامتت نرسیدم","با اینکه در جستجوی تو هستم، نتوانستم به قله زیبایی قامت تو که همچون سرو راست و خرامان است، برسم."],[321,"امید در شب زلفت به روز عمر نبستم","طمع به دور دهانت ز کام دل ببریدم","هرگز به امید اینکه شب‌های تار زلف تو به روزهای عمرم منجر شود، نماندم و همچنین از آرزوی اینکه دور دهانت را به دست آورم، دست کشیدم."],[321,"به شوق چشمه نوشت چه قطره‌ها که فشاندم","ز لعل باده‌فروشت چه عشوه‌ها که خریدم","به خاطر آرزوی نوشیدن از چشمه تو چه مقدار اشک بریختم و از زیبایی و فریبندگی باده‌فروش تو چه شیوه‌ها و نازهایی را پذیرفتم."],[321,"ز غمزه بر دل ریشم چه تیرها که گشادی","ز غصه بر سر کویت چه بارها که کشیدم","از نگاه معشوق، چه زخم‌ها که بر دل مجروح من نشسته است و از دل‌تنگی و غم دوری تو، چه بار گران بر دوش خود احساس کرده‌ام."],[321,"ز کوی یار بیار ای نسیم صبح غباری","که بوی خون دل ریش از آن تراب شنیدم","ای نسیم صبح، از کوی معشوق بادی را بیاور که بوی دل‌سوختگی و غم مرا از خاک آنجا شنیده‌ام."],[321,"گناه چشم سیاه تو بود و گردن دلخواه","که من چو آهوی وحشی ز آدمی برمیدم","گناه به چشمان سیاه و گردن زیبا و دلربای تو برمی‌گردد که باعث شد من مانند آهوی وحشی از دست انسان‌ها فرار کنم و بگریزم."],[321,"چو غنچه بر سرم از کوی او گذشت نسیمی","که پرده بر دل خونین به بوی او بدریدم","مانند غنچه، نسیمی به سراغم آمد که از کوی معشوق می‌گذشت و به خاطر بوی او، پرده‌ای که بر دل زخمی‌ام بود را پاره کردم."],[321,"به خاک پای تو سوگند و نور دیده حافظ","که بی رخ تو، فروغ از چراغ دیده ندیدم","به خاک پای تو و نور چشمان حافظ سوگند که بدون چهره تو، نوری از چشمم نمی‌بینم."],[322,"ز دست کوته خود زیر بارم","که از بالابلندان شرمسارم","من به خاطر کم بودن امکانات و توانایی‌هایم زیر فشار و گران‌باری قرار دارم و از کسانی که در زندگی بالاتر و موفق‌تر از من هستند، شرمنده و خجالت‌زده‌ام."],[322,"مگر زنجیر مویی گیردم دست","وگر نه سر به شیدایی برآرم","اگر زنجیری از موهایت مرا در زندان عشق نگه دارد، وگرنه من دیوانه‌وار سر به آسمان بلند می‌کنم."],[322,"ز چشم من بپرس اوضاع گردون","که شب تا روز اختر می‌شمارم","از چشم من بپرس که چه خبرهایی از دنیا دارم، چون من هر شب و روز ستاره‌ها را حساب می‌کنم و به وقایع زندگی دقت می‌کنم."],[322,"بدین شکرانه می‌بوسم لب جام","که کرد آگه ز راز روزگارم","به خاطر این نعمت، لب جام می را می‌بوسم، زیرا سبب شد تا از اسرار زندگی‌ام آگاه شوم."],[322,"اگر گفتم دعای می فروشان","چه باشد؟ حقّ نعمت می‌گزارم","منظور این است که وقتی از من می‌پرسند دعای کسانی که می‌نوشند چیست، من به خاطر نعمت شراب شکرگزاری می‌کنم و به آن احترام می‌گذارم."],[322,"من از بازوی خود دارم بسی شکر","«که زور مردم آزاری ندارم»","من از قدرت و توانایی خود بسیار سپاسگزارم، زیرا به دیگران آزار نمی‌رسانم و زور و قدرتی برای آزار دادن دیگران ندارم."],[322,"سری دارم چو حافظ مست لیکن","به لطف آن سری امیدوارم","من عقل و پختگی دارم و به خاطر آن همچنان به عشق و امید دل بسته‌ام؛ هرچند که مانند حافظ، مست و سرخوش هستم."],[323,"گرچه افتاد ز زلفش گرهی در کارم","همچنان چشم گشاد از کرمش می‌دارم","با وجود اینکه زلف معشوق باعث پیچیدگی و مشکلاتی در کارم شده، اما همچنان چشم‌هایم را از لطف و بخشش او خالی نمی‌کنم."],[323,"به طرب حمل مکن سرخی رویم که چو جام","خون دل عکس برون می‌دهد از رخسارم","اینجا خواهان است که کسی شادابی و شادی ظاهری او را به حساب نگیرد، زیرا چهره او سرخ و شاداب مانند جام خون دل است که نشان‌دهنده درد و رنج‌های درونیش است."],[323,"پرده مطربم از دست برون خواهد برد","آه اگر زان که در این پرده نباشد بارم","اگر مطرب بخواهد پرده را کنار بزند، من را از دلتنگی رها خواهد کرد؛ اما افسوس که در این پرده، گناه سنگینی بر دوش من است که مانع این رهایی می‌شود."],[323,"پاسبان حرم دل شده‌ام شب همه شب","تا در این پرده جز اندیشه او نگذارم","من به عنوان نگهبان دل خویش شب‌ها بیدار هستم تا در این حالت (در این پرده) جز فکر و خاطره او وجود نداشته باشد."],[323,"منم آن شاعر ساحر که به افسون سخن","از نی کلک، همه قند و شکر می‌بارم","من شاعر ماهری هستم که با هنر سخن گفتن و جادوگری کلمات، از قلم خود طوری می‌نویسم که همه چیز شیرین و خوشایند به نظر بیاید."],[323,"دیده بخت به افسانه او شد در خواب","کو نسیمی ز عنایت که کند بیدارم؟","چشم بخت من در خواب به داستان او متوجه شد، اما چه نسیمی از لطف او هست که مرا بیدار کند؟"],[323,"چون تو را در گذر ای یار نمی‌یارم دید","با که گویم که بگوید سخنی با یارم؟","نمی‌توانم تو را در این مسیر، ای یار، ببینم و دست کم با که صحبت کنم تا پیامی از تو برایم بیاورد."],[323,"دوش می‌گفت که حافظ همه روی است و ریا","بجز از خاک درش با که بود بازارم؟","دیشب(دوش) می‌گفت که حافظ، همه زیبایی و نیرنگ است و غیر از خاک در درگاه تو (خود تو) با چه کسی ممکن است معامله کنم و حرفی بزنم؟"],[324,"گر دست دهد خاک کف پای نگارم","بر لوح بصر خطّ غباری بنگارم","اگر امکانش باشد که خاک کف پای عشق من به من برسد، می‌خواهم روی صفحه چشمم خطی از غبار آن بکشیم."],[324,"بر بوی کنار تو شدم غرق و امید است","از موج سرشکم که رساند به کنارم","به بوی کنارت غرق شدم و امیدوارم که از آب اشکهایم، مرا به تو برساند."],[324,"پروانه او گر رسدم در طلب جان","چون شمع همان دم به دمی جان بسپارم","اگر در جستجوی جان او به پروانه‌اش برسم، در لحظه‌ای که مانند شمع در برابرش قرار می‌گیرم، جانم را فدای او می‌کنم."],[324,"امروز مکش سر ز وفای من و اندیش","زان شب که من از غم به دعا دست برآرم","امروز از صداقت و وفای من دور نشو و به یاد داشته باش شب گذشته را که به خاطر غم، دست به دعا بردم."],[324,"زلفین سیاه تو به دلداری عشّاق","دادند قراری و ببردند قرارم","زلف‌های سیاه تو به عاشقان آرامش دادند و باعث شدند که آرامش من از بین برود."],[324,"ای باد از آن باده نسیمی به من آور","کان بوی شفابخش بود دفع خمارم","ای باد، لطفا از آن شراب نسیمی برای من بیاور، زیرا آن عطر خوشبو، مایه شفای من است و می‌تواند حالت مستی و کسالتم را از بین ببرد."],[324,"گر قلب دلم را ننهد دوست عیاری","من نقد روان در دمش از دیده شمارم","اگر دوست قلبم را پر از عشق نکند، من زیبایی او را به جای نقدی گران‌بها در هر نفس از چشمانم می‌شمارم."],[324,"دامن مفشان از من خاکی که پس از من","زین در نتواند که برد باد غبارم","از من بی‌ارزش و خاکی دامن مگستر، چون بعد از رفتنم نمی‌تواند بادی که غبار من را ببرد، دامن تو را بگیرد و به تو آسیب بزند."],[324,"حافظ لب لعلش چو مرا جان عزیز است","عمری بود آن لحظه که جان را به لب آرم","حافظ به زیبایی لب‌های سرخ معشوق (عاشقانه) اشاره می‌کند و می‌گوید که عشق او برایش به اندازه‌ای ارزشمند و عزیز است که در تمام عمرش از آن لحظه‌ای که می‌تواند جانش را در عشق به لب آورد، غافل نیست."],[325,"در نهانخانه عشرت صنمی خوش دارم","کز سر زلف و رخش، نعل در آتش دارم","در پنهان‌خانه لذتی که دارم، معشوقی زیبا دارم که زیبایی‌اش و موهایش مرا به شدت افسون کرده و مانند نعلی در آتش، به من جراحت و درد می‌زند."],[325,"عاشق و رندم و می‌خواره به آواز بلند","وین همه منصب از آن حور پری‌وش دارم","من عاشق و مست و می‌خوارم و به طرز پرصدا این همه مقام و موقعیت را به خاطر آن حوری زیبا دارم."],[325,"گر تو زین دست، مرا بی سر و سامان داری","من به آه سحرت زلف، مشوش دارم","اگر تو با این رفتارهای بی‌نظم و بی‌قرار مرا در حالت بی‌سامانی نگه می‌داری، من نیز به خاطر شوق سحرگاهان تو، موهایم را آشفته و پریشان نگه می‌دارم."],[325,"گر چنین چهره گشاید خط زنگاری دوست","من رخ زرد، به خونابه منقش دارم","اگر دوست با چنین چهره‌ای لبخند بزند و چهره‌اش دچار خط‌هایی از رنگ زنگار شود، من هم با مشاهده این زیبایی، چهره‌ام زرد و پر از آثار غم و اندوه خواهد شد."],[325,"گر به کاشانه رندان قدمی خواهی زد","نقل شعر شکرین و می بی‌غش دارم","اگر قصد داری به خانه رندان (عاشقان) بیایی، با خودت اشعار شیرین و شراب خالص را بیاور که من از آن‌ها دارم."],[325,"ناوک غمزه بیار و رسن زلف که من","جنگ‌ها با دل مجروح بلاکش دارم","عشق و زیبایی را به نمایش بگذار و با زلف و ناز و غمزه خود مرا اسیر کن، زیرا من در دل خود زخم‌های عاطفی زیادی دارم که با این زیبایی‌ها می‌توانم فراموش کنم."],[325,"حافظا چون غم و شادیّ جهان در گذر است","بهتر آن است که من خاطر خود خوش دارم","حافظ می‌گوید از آن‌جا که غم و شادی در دنیا موقتی و ناپایدار است، بهتر است که من به خودم خوشی و آرامش بدهم و خاطر خویش را شاد نگه‌دارم."],[326,"مرا عهدی‌ست با جانان که تا جان در بدن دارم","هواداران کویش را چو جان خویشتن دارم","من با معشوق خود پیمانی بسته‌ام که تا زمانی که زنده هستم، به عشق او وفادار خواهم بود و دوستداران او را به اندازه جان خود دوست می‌دارم."],[326,"صفای خلوت خاطر از آن شمع چگل جویم","فروغ چشم و نور دل از آن ماه ختن دارم","من از آن شمع زیبا (که به آن شمع چگل گفته می‌شود) پاکی و روشنی دل و خاطر را می‌طلبم و نور چشم و روشنی دل را از آن دختر جوان و زیبا (که به او ماه ختن گفته می‌شود) دارم."],[326,"به کام و آرزوی دل، چو دارم خلوتی حاصل","چه فکر از خبث بدگویان، میان انجمن دارم؟","وقتی به آرزو و خواسته‌های دل خود می‌رسم و در تنهایی‌ام خوشحالم، دیگر چه نیازی به فکر کردن به زشتی‌های بدگویان دارم، وقتی که در میان جمع هم هستم؟"],[326,"مرا در خانه سروی هست کاندر سایه قدّش","فراغ از سرو بستانی و شمشاد چمن دارم","در خانه‌ام درخت سروی دارم که با سایه‌اش مرا از زیبایی درختان بستان و شمشادهای چمن بی‌نیاز کرده است."],[326,"گرم صد لشکر از خوبان به قصد دل کمین سازند","بحمد الله و المنّه بتی لشکرشکن دارم","اگر صد لشکر از زیبارویان بخواهند به قصد دل من کمین کنند، اما به لطف و نعمت خداوند، من بتی دارم که می‌تواند تمام آن لشکرها را شکست دهد."],[326,"سزد کز خاتم لعلش زنم لاف سلیمانی","چو اسم اعظمم باشد، چه باک از اهرمن دارم؟","سزاوار است که من از انگشتری او که از لعل (گوهری قیمتی) ساخته شده است، در لاف سلیمانی (افتخار به قدرت و عظمت) بزنم، چون اگر اسم اعظم در اختیارم باشد، از اهریمن (نماد شر و بدی) نمی‌ترسم."],[326,"الا ای پیر فرزانه، مکن عیبم ز میخانه","که من در ترک پیمانه دلی پیمان‌شکن دارم","ای پیر فرزانه، تو به من ایراد نگیری و از میخانه انتقاد نکنی، زیرا من که پیمانه را ترک کرده‌ام، در دل خود از عشق وفادار نیستم و خیانت می‌کنم."],[326,"خدا را ای رقیب امشب زمانی دیده بر هم نه","که من با لعل خاموشش نهانی صد سخن دارم","ای رقیب، خواهش می‌کنم امشب چشمانت را ببند تا من بتوانم با دلی که رازهایی درباره معشوق (که با لب‌های زیبا و خاموشش) دارم، خلوت کنم."],[326,"چو در گل‌زار اقبالش خرامانم بحمدالله","نه میل لاله و نسرین، نه برگ نسترن دارم","وقتی در باغ خوشبختی و موفقیت او قدم می‌زنم، به لطف خدا نه دلم به گل‌های زیبا و رنگین مانند لاله و نسرین می‌خورد و نه با برگ‌های نسترن دلخوشم."],[326,"به رندی شهره شد حافظ میان همدمان، لیکن","چه غم دارم که در عالم قوام‌الدّین حسن دارم","حافظ در میان همپیوندان خود به عنوان فردی رند و خوشنام شناخته شده است، اما برای او مهم نیست چون در دنیای خود، عشق و محبت قوام‌الدین حسن، محبوبش، را دارد."],[327,"من که باشم که بر آن خاطر عاطر گذرم؟","لطف‌ها می‌کنی ای خاک درت، تاج سرم","من کیستم که بخواهم به آن دل خوشبو نزدیک شوم؟ ای خاک درگاه تو، تو به من مهربانی می‌کنی و برای من ارزشمندتر از تاج سرم هستی."],[327,"دلبرا بنده نوازیت که آموخت؟ بگو","که من این ظن، به رقیبان تو هرگز نبرم","ای عشق محبوب، چه کسی به من یاد داده که این محبت و نوازش تو را درک کنم؟ بگو که من هرگز این گمان را به رقبایت 