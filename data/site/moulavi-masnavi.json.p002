�ا رماند مار را فرصت نیافت","سوار این صحنه رو دید و با شتاب فراوان نزدیک مرد خفته شد، و فرصت پیدا نکرد قبل از رفتن مار در دهانش برسد"],[210,"چونکه از عقلش فراوان بد مدد","چند دبوسی قوی بر خفته زد","چون عقل فراوانش یاور او بود، با چند چوب دستی محکم به خفته زد، دبوس: چوب دستی پادشاهان"],[210,"برد او را زخم آن دبوس سخت","زو گریزان تا به‌زیر یک درخت","زخم چوب دستی او را به سختی زخم کرد و اون فرار کنان به زیر یک درخت رسید"],[210,"سیب پوسیده بسی بد ریخته","گفت ازین خور ای به‌درد آویخته","زیر درخت سیب‌های گندیده زیادی ریخته بود، عاقل: گفت این سیب باید بخوری، ای بیچاره"],[210,"سیب چندان مر ورا در خورد داد","کز دهانش باز بیرون می‌فتاد","آن‌قدر سیب به زور به خورد او داد که دیگر نمی‌توانسنت را در دهان نگه‌دارد و از دهانش بیرون می‌افتاد."],[210,"بانگ می‌زد کای امیر آخر چرا‌؟","قصد من کردی تو نادیده جفا‌؟","فریاد می‌زد که ای امیر، چرا اینگونه با من رفتار می‌کنی؟ چرا حتی ما یکدیگر رو نمیشناسیم به من ظلم می‌کنی؟"],[210,"گر ترا ز اصل‌ست با جانم ستیز","تیغ زن یکبارگی خونم بریز","اگر تو اساس دشمنی ما در اصل و نسب و اجداد ، پس یکبار با تیغ خود به من ضربه بزن و خونم را بریز. (اینقدر عذابم رو طولانی نکن)"],[210,"شوم ساعت که شدم بر تو پدید","ای خنک آن را که روی تو ندید","لعنت بر زمانی که تو را دیدم، خوش به حال کسی که اصلا تو را تا کنون ندیده"],[210,"بی‌جنایت بی‌گنه بی بیش و کم","ملحدان جایز ندارند این ستم","بدون هیچ گناه و جنایت کوچک و بزرگی مرا تنبیه می‌کنی، حتی ملحدان هم چنین ظلمی را روا نمی‌دارند"],[210,"می‌جهد خون از دهانم با سخن","ای خدا آخر مکافاتش تو کن","با هر سخن از دهانم خون بیرون می‌جهد، خدایا شر این (امیر) را آخر تو از سر من کم کن"],[210,"هر زمان می‌گفت او نفرین نو","اوش می‌زد کاندرین صحرا بدو","هر زمان یک نفرین جدید خفته بر امیر می‌کرد، بهش یک چوب دستی می‌زد که در صحرا باید بدوی"],[210,"زخم دبوس و سوار همچو باد","می‌دوید و باز در رو می‌فتاد","ضرب چوب دستی و سوار همچو باد او دنبال می‌کرد، او می‌دوید و زمین می‌خورد"],[210,"ممتلی و خوابناک و سست بد","پا و رویش صد هزاران زخم شد","شرشار از بی‌حالی و سس شد و سر تا پایش هزاران زخم شد"],[210,"تا شبانگه می‌کشید و می‌گشاد","تا ز صفرا قی شدن بر وی فتاد","تا هنگام شب کش و مکش ادامه یافت، تا صفرا بر او غلبه کرد و استفراغ کرد"],[210,"زو بر آمد خورده‌ها زشت و نکو","مار با آن خورده بیرون جست ازو","هر آنچه خوب و بد قبل خورده بود قی کرد و همراه آن مار نیز از دهان او بیرون آمد"],[210,"چون بدید از خود برون آن مار را","سجده آورد آن نکو‌کردار را","چون مارا دید که چگونه از دهان او خارج شده، به شدت سپاسگذار آن امیر ( سوار) شد"],[210,"سهم آن مار سیاه زشت زفت","چون بدید آن دردها از وی برفت","وقتی مار سیاه، زشت و بزرگ را دید همه دردهایش فراموش شد"],[210,"گفت خود تو جبرئیل رحمتی","یا خدایی که ولی نعمتی‌!","به سوار گفت تو خودت مثل جبرییل رحمت هستی یا اینکه خدایی که منبع نعمت‌هاست!"],[210,"ای مبارک ساعتی که دیدی‌ام","مرده بودم جان نو بخشیدی‌ام","چه زمانی خوب من تو را دیده‌ام وگرنه مرده بودم، جانم را نجات دادی"],[210,"تو مرا جویان مثال مادران","من گریزان از تو مانند خران","تا مثل مداران دلسوز دنبال من می‌امدی من هم چون چهارپایان از تو فرار می‌کردم"],[210,"خر گریزد از خداوند از خری","صاحبش در پی ز نیکو گوهری","خر از باب خریت از دست صاحبش می‌گریزد، صاحبش او را چون یک گوهر می‌جوید"],[210,"نه از پی سود و زیان می‌جویدش","لیک تا گرگش ندرد یا ددش","این جستن خر نه بابت سود زیان برای صاحب است، بلکه نگران دریده شدن توسط گرگ است"],[210,"ای خنک آن را که بیند روی تو","یا در افتد ناگهان در کوی تو","خوشا به حال کسی که روی تو ببینید یا ناگهان مسیرش به کوی تو بیافتد"],[210,"ای روان پاک بستوده تو را","چند گفتم ژاژ و بیهوده تو را","ای روح و جان پاک تو که تو را ستایش کرده‌ام، بارها و بارها گفتم که سخنان بی‌اساس و بی‌فایده را در مورد تو نگویم."],[210,"ای خداوند و شهنشاه و امیر","من نگفتم جهل من گفت آن مگیر","خداوند و پادشاه من، من نگفتم که جهل من را به حساب نیاور، بلکه خودم را از این جهل آگاه می‌دانم."],[210,"شمه‌ای زین حال اگر دانستمی","گفتن بیهوده کی تانستمی","اگر قدری از این حال را می‌دانستم، دیگر بیهوده سخن نمی‌گفتم و نمی‌توانستم این همه را بیان کنم."],[210,"بس ثنایت گفتمی ای خوش خصال","گر مرا یک رمز می‌گفتی ز حال","ای خوش‌اخلاق، من بارها ستایش تو را کرده‌ام، اگر فقط یک نشانه یا رمزی از حال و وضعیت خود به من می‌گفتی، برای من کافی بود."],[210,"لیک خامش کرده می‌آشوفتی","خامشانه بر سرم می‌کوفتی","اما تو بی‌صدا و به‌طور ناخودآگاه بر من فشار می‌آورده‌ای و آشفته می‌ساختی، در حالی که خودت هیچ چیزی نمی‌گفتی."],[210,"شد سرم کالیوه عقل از سر بجست","خاصه این سر را که مغزش کمترست","منظور این است که زمانی که عقل و فهم از سر خارج شده، به ویژه وقتی که مغز او ضعیف‌تر است، انسان دچار کج‌فهمی و جنون می‌شود. به عبارت دیگر، در شرایطی که عقل از کار افتاده، فرد ممکن است دچار رفتارهای بی‌خودانه شود."],[210,"عفو کن ای خوب‌روی خوب‌کار","آنچه گفتم از جنون اندر گذار","از تو ای زیبای نیکوکار درخواست می‌کنم که به خاطر حرف‌هایم که ناشی از جنون بود، مرا ببخشی و بگذری."],[210,"گفت اگر من گفتمی رمزی از آن","زهره تو آب گشتی آن زمان","اگر من به گونه‌ای رمزی درباره زیبایی و جذابیت تو گفته‌ام، در آن صورت تو به حیات و نشاط دچار شده‌ای."],[210,"گر ترا من گفتمی اوصاف مار","ترس از جانت بر آوردی دمار","اگر من درباره مارها خصوصیات آن‌ها را برای تو بگویم، ترس تو باعث می‌شود که جانت به خطر بیفتد و هراس وجودت را در هم بکوبد."],[210,"مصطفی فرمود اگر گویم به‌راست","شرح آن دشمن که در جان شماست","پیامبر (مصطفی) فرمود اگر به‌طور روشن بگویم، شرح دشمنی را می‌زنم که در وجود شماست و شما از او غافلید."],[210,"زهره‌های پردلان هم بر درد","نی رود ره‌، نی غم کاری خورد","دلیری و شجاعت افراد نترس هیچ تأثیری بر درد و رنج ندارد و نه غم، هیچ کار مؤثری انجام نمی‌دهد."],[210,"نه دلش را تاب ماند در نیاز","نه تنش را قوت روزه و نماز","دلش تاب و قدرت انجام نیاز و عبادت را ندارد، هم به خاطر شدت غم و اضطراب و هم به دلیل ناتوانی جسمی."],[210,"همچو موشی پیش گربه لا شود","همچو بره پیش گرگ از جا رود","انسانی که در شرایط سخت و خطرناک قرار می‌گیرد، رفتار و عکس‌العملش مانند موش در برابر گربه یا بره در برابر گرگ خواهد بود؛ یعنی ترس و بی‌تابی او به حدی می‌رسد که به طور غریزی از محل خطر فرار می‌کند."],[210,"اندرو نه حیله ماند نه روش","پس کنم ناگفته‌تان من پرورش","دیگر نه نیرنگ و فریب مانده است و نه راهی برای جلو بردن کار، پس من چیزی که نباید گفته شود را برای شما پرورش می‌دهم."],[210,"همچو بوبکر ربابی تن زنم","دست چون داود در آهن زنم","من همچون ابوبکر ربابی به تن می‌زنم و دستم را همانند داود در نواختن آهنگ به کار می‌برم."],[210,"تا محال از دست من حالی شود","مرغ پر بر کنده را بالی شود","من نمی‌توانم به تنهایی تغییرات غیرممکن را انجام دهم، همچنان‌که پرنده‌ای که پرهایش کنده شده، نمی‌تواند بالی دوباره به دست آورد."],[210,"چون یدالله فوق ایدیهم بود","دست ما را دست خود فرمود احد","خداوند بزرگتر از تمام قدرت‌های انسانی است و به ما این اجازه را داده که با ید الله (دست خدا) عمل کنیم و به ما قدرت و حمایت خود را عطا کرده است."],[210,"پس مرا دست دراز آمد یقین","بر گذشته ز آسمان هفتمین","من به یقین متوجه شدم که دست من از آسمان هفتم دراز شده است، یعنی به من الهام الهی رسیده یا فضیلت‌هایی از عالم بالا به من داده شده است."],[210,"دست من بنمود بر گردون هنر","مقریا بر خوان که انشق القمر","دست من به آسمان اشاره کرد که هنر من، مانند معجزه‌ای، ماه را شکافته است."],[210,"این صفت هم بهر ضعف عقل‌هاست","با ضعیفان شرح قدرت کی رواست","این ویژگی (ناتوانی در درک و فهم) به خاطر ضعف عقل‌هاست و با افراد ناتوان و ضعیف، نمی‌توان درباره قدرت و توانایی‌ها توضیح داد."],[210,"خود بدانی چون بر آری سر ز خواب","ختم شد والله اعلم بالصواب","وقتی که خودت از خواب بیدار می‌شوی، می‌فهمی که چه چیزی درست است و پایان کار چه بوده است؛ فقط خدا می‌داند که حقیقت چیست."],[210,"مر تو را نه قوت خوردن بدی","نه ره و پروای قی کردن بدی","تو نه آنقدر قوی هستی که بتوانی غذا بخوری و نه آنقدر با محبت که نگران قی کردن خودت باشی."],[210,"می‌شنیدم فحش و خر می‌راندم","رب یسر زیر لب می‌خواندم","در این بیت، شاعر به وضعیتی اشاره می‌کند که در حین شنیدن دشنام و توهین، در تلاش بوده است که با آرامش و سکون، از آن محیط دور شود و به آرامش دل خود بپردازد. او در دل خود دعا می‌کند و از خدا طلب یاری می‌کند."],[210,"از سبب گفتن مرا دستور نی","ترک تو گفتن مرا مقدور نی","به خاطر این که تو را ترک کنم، دستور و فرمانی برای من نیست؛ گفتن از تو برای من ممکن نیست."],[210,"هر زمان می‌گفتم از درد درون","اهد قومی انهم لا یعلمون","هر بار که از دردهای درونم صحبت می‌کردم، کسانی که مرا احاطه کرده بودند، نسبت به آن بی‌خبر و ناآگاه بودند."],[210,"سجده‌ها می‌کرد آن رسته ز رنج","کای سعادت ای مرا اقبال و گنج","آن مرد، به خاطر رنج و زحمتی که کشیده، سجده‌های زیادی می‌کند و از خداوند می‌خواهد که به او سعادت و ثروت عطا کند."],[210,"از خدا یابی جزاها ای شریف","قوت شکرت ندارد این ضعیف","خداوند جزاها و پاداش‌ها را به تو می‌دهد، ای شریف، زیرا این ضعیف (انسان) نمی‌تواند از عهده شکرگزاری برآید و قدرت کافی برای این کار ندارد."],[210,"شکر حق گوید ترا ای پیشوا","آن لب و چانه ندارم و آن نوا","شکر خدا را به تو می‌گوید، ای پیشوا؛ اما من هیچ نشانی از زیبایی مانند لب و چانه و نوا ندارم."],[210,"دشمنی عاقلان زین سان بود","زهر ایشان ابتهاج جان بود","دشمنی عاقلان به این شکل است که هرچند آن‌ها دشمنی می‌کنند، اما زهر و آسیب آن‌ها برای روح انسان، شادی و نشاطی به همراه دارد."],[210,"دوستی ابله بود رنج و ضلال","این حکایت بشنو از بهر مثال","دوستی که نادان است، باعث رنج و گمراهی می‌شود. این داستان را بشنو تا مثالی ارائه کنم."],[211,"اژدهایی خرس را درمی‌کشید","شیرمردی رفت و فریادش رسید","خرس در حال دست و پنجه نرم کردن با یک اژدها بود که ناگهان یک شیرمرد (شجاع و دلاور) آمد و صدای او را شنید."],[211,"شیرمردانند در عالم مدد","آن زمان کافغان مظلومان رسد","در جهان، مردان قهرمان و نیرومند وجود دارند که به هنگام شنیدن فریاد مظلومان، به کمک آنها می‌آیند و مدد می‌رسانند."],[211,"بانگ مظلومان ز هرجا بشنوند","آن طرف چون رحمت حق می‌دوند","صدای مظلومان از هر سو به گوش می‌رسد و در آن سوی دیگر، جایی که رحمت و لطف خداوند حضور دارد، به سمت آن فشار می‌آورند و می‌شتابند."],[211,"آن ستونهای خللهای جهان","آن طبیبان مرضهای نهان","ستون‌های اصلی مشکلات جهان، مانند پزشکان بیماری‌های پنهان را درمان می‌کنند."],[211,"محض مهر و داوری و رحمتند","همچو حق بی علت و بی رشوتند","محض عشق و محبت و قضا و قدری هستند که مانند حق، بدون هیچ دلیلی و بدون دریافت رشوه عمل می‌کنند."],[211,"این چه یاری می‌کنی یکبارگیش","گوید از بهر غم و بیچارگیش","تو چه کمکی به او می‌کنی که ناگهان به خاطر غم و بیچارگی‌اش آن را می‌گوید؟"],[211,"مهربانی شد شکار شیرمرد","در جهان دارو نجوید غیر درد","شیرمرد (شجاع و قهرمان) در این جهان، تنها به مهربانی و محبت متکی است و به دنبال دارو یا راه‌حلی برای مشکلات خود نیست، مگر در مواقعی که دچار درد و رنج شود."],[211,"هر کجا دردی دوا آنجا رود","هر کجا پستیست آب آنجا دود","هر جایی که دردی را درمان کند، آنجا خواهد رفت و هرجایی که ذلت و پستی وجود داشته باشد، آنجا آتش و ناراحتی به وجود می‌آید."],[211,"آب رحمت بایدت، رو پست شو","وانگهان خور خمر رحمت، مست شو","برای دریافت رحمت الهی باید خود را humble و متواضع جلوه دهی؛ وقتی این کار را کردی، ناگهان از نعمت و رحمت الهی به وجد می‌آیی و غرق در خوشحالی و شگفتی می‌شوی."],[211,"رحمت اندر رحمت آمد تا به سر","بر یکی رحمت فرو مای ای پسر","رحمت، همواره بر رحمت دیگر افزوده می‌شود تا به حدی برسد که تو، ای پسر، باید از آن بهره‌مند شوی."],[211,"چرخ را در زیر پا آر ای شجاع","بشنو از فوق فلک بانگ سماع","ای شجاع، چرخ (فلک) را زیر پا خود قرار بده و به صدای سماع (موسیقی معنوی) که از آسمان می‌نوازد گوش فرا بده."],[211,"پنبه وسواس بیرون کن ز گوش","تا به گوشت آید از گردون خروش","وسواس و دل‌شکستگی را از ذهن و فکر خود دور کن تا صدای آسمانی را بشنوی و از شادی‌ها و نعمت‌های آن آگاه شوی."],[211,"پاک کن دو چشم را از موی عیب","تا ببینی باغ و سروستان غیب","برای اینکه بتوانی زیبایی‌های عالم را مانند باغ و درختان آن ببینی، باید نگاهت را از عیب‌جویی و بدبینی خالی کنی و به آنچه خوب و زیباست، توجه داشته باشی."],[211,"دفع کن از مغز و از بینی زکام","تا که ریح الله در آید در مشام","برای آن‌که بوی خوش و معنوی الهی (ریح الله) به مشام تو برسد، باید از فکرها و عوامل مزاحم مانند زکام (نالایی و بیماری) که در مغز و بینی وجود دارد، دوری کنی."],[211,"هیچ مگذار از تب و صفرا اثر","تا بیابی از جهان طعم شکر","هیچ تأثیری از تب و حرارت‌های ناشی از بیماری را باقی نگذار تا بتوانی طعم شیرینی و لذت زندگی را از این دنیا بچشی."],[211,"داروی مردی کن و عنین مپوی","تا برون آیند صد گون خوب‌روی","برای درمان مردانگی، از چیره‌گویی و تملق دوری کن، تا صدها ویژگی خوب و زیبا در تو ظاهر شود."],[211,"کنده تن را ز پای جان بکن","تا کند جولان به گردت انجمن","برای رهایی از مشکلات و بدبختی‌ها، باید بار سنگین جسم و دنیای مادی را از خود دور کنی تا روح و جانت آزادانه در جمع خوبان و دوستان حرکت کند."],[211,"غلّ بخل از دست و گردن دور کن","بخت نو دریاب در چرخ کهن","بخل را از خود دور کن تا بتوانی خوشبختی جدیدی را در دنیای قدیمی‌ات پیدا کنی."],[211,"ور نمی‌توانی به کعبه لطف پر","عرضه کن بیچارگی بر چاره‌گر","اگر نمی‌توانی به کعبه لطف و رحمت دسترسی پیدا کنی، پس بیچارگی و نیاز خود را به کسی که توانایی کمک دارد، عرضه کن و از او یاری بخواه."],[211,"زاری و گریه قوی سرمایه‌ایست","رحمت کلّی قوی‌تر دایه‌ایست","زاری و گریه کردن به طور قوی، یک منبع بزرگ از رحمت و نوازش است و این رحمت حتی از دایه‌ای که به طفلش آرامش می‌دهد، قوی‌تر است."],[211,"دایه و مادر بهانه‌جو بود","تا که کی آن طفل او گریان شود","مادر و دایه به دنبال بهانه‌ هستند تا ببینند چه زمانی کودکشان گریه می‌کند."],[211,"طفل حاجات شما را آفرید","تا بنالید و شود شیرش پدید","خداوند نیازهای شما را خلق کرده است تا از آن‌ها گله کنید و در نتیجه، رحمتی عطا کند که مانند شیر از محبت او به وجود آید."],[211,"گفت ادعوا الله بی زاری مباش","تا بجوشد شیرهای مهرهاش","خدا را با بی‌زاری و شکستگی در دل بخوانید، تا محبت و رحمت او همچون شیر از دل شما بجوشد."],[211,"هوی هوی باد و شیرافشان ابر","در غم ما اند یک ساعت تو صبر","باد و باران و شیرینی ابر، در حال ناله و زاری هستند، پس تو نیز در غم ما صبر کن و دقایقی صبر را به خودت تنگ کن."],[211,"فی السماء رزقکم بشنیده‌ای","اندرین پستی چه بر چفسیده‌ای","رزق شما در آسمان نوشته شده و شما در این زمین پست چه چیزی را چسبیده‌اید؟"],[211,"ترس و نومیدیت دان آواز غول","می‌کشد گوش تو تا قعر سفول","ترس و ناامیدی تو باعث می‌شود که صدای غولی (نوعی ترس و توهم) توجه‌ات را جلب کند و تو را به قعر پستی‌ها بکشاند."],[211,"هر ندایی که ترا بالا کشید","آن ندا می‌دان که از بالا رسید","هر صدایی که تو را به سوی بلندی و مقام بالاتر می‌کشد، بدان که آن صدا از جایگاه رفیع و مقدسی نشأت گرفته است."],[211,"هر ندایی که ترا حرص آورد","بانگ گرگی دان که او مردم درد","هر صدایی که تو را به طمع بیندازد و تشویق به حرص کند، باید بدانید که این صدا شبیه صدای گرگ است و اشاره به کسی دارد که در درد و رنج مردم است."],[211,"این بلندی نیست از روی مکان","این بلندیهاست سوی عقل و جان","این بلندی، به معنای برتری و مقام است و وابسته به جایگاه فیزیکی یا مکانی نیست؛ بلکه این برتری مربوط به عقل و روح انسان می‌باشد."],[211,"هر سبب بالاتر آمد از اثر","سنگ و آهن فایق آمد بر شرر","هر دلیلی که باعث شود چیزی از جنسی بالاتر از سنگ و آهن باشد، بر شرر (ناراحتی یا آتش) پیروز می‌شود. این به این معناست که عقل و اندیشه می‌تواند بر موانع و مشکلات فائق آید."],[211,"آن فلانی فوق آن سرکش نشست","گرچه در صورت به پهلویش نشست","فلانی که در اینجا به او اشاره شده، با وجود اینکه به ظاهر در کنار فرد سرکش نشسته است، در واقع از نظر مقام و شأن بالاتر از او قرار دارد."],[211,"فوقی آنجاست از روی شرف","جای دور از صدر باشد مستخف","برتری و ارزش واقعی در جایی است که از نظر مقام و شرافت قرار دارد، حتی اگر آن مکان از صدر(جایگاه بالا) دور باشد، نباید آن را کم‌ارزش دانست."],[211,"سنگ و آهن زین جهت که سابق است","در عمل فوقی این دو لایق است","سنگ و آهن به دلیل اینکه در کارهای پیشین خود ثابت کرده‌اند، برای انجام کارهای مهم و بلندمرتبه شایسته و لایق هستند."],[211,"وآن شرر از روی مقصودی خویش","ز آهن و سنگست زین رو پیش و پیش","این شرر (شعله) که از روی هدف خاصی به وجود آمده، از آهن و سنگ است، به همین دلیل همیشه جلوتر از دیگران قرار دارد."],[211,"سنگ و آهن اول و پایان شرر","لیک این هر دو تنند و جان شرر","سنگ و آهن تنها در آغاز و پایان شرر (آتش) هستند، اما این دو فقط جسد (ظاهری) هستند و جان واقعی شرر چیز دیگری است."],[211,"در زمان شاخ از ثمر سابق‌ترست","در هنر از شاخ او فایق‌ترست","درخت در زمان وجودش، ابتدا میوه می‌دهد و بعد شاخه می‌زند؛ اما در عرصه هنر، شاخه‌اش (خلاقیت و مهارتش) از میوه‌اش (حاصل کار) برتر و مهم‌تر است."],[211,"چونک مقصود از شجر آمد ثمر","پس ثمر اول بود وآخر شجر","چون هدف و نتیجه از درخت حاصل می‌شود، پس ثمر (میوه) نخستین و اصلی از درخت است، و نهایت درخت هم همان ثمر است."],[211,"خرس چون فریاد کرد از اژدها","شیرمردی کرد از چنگش جدا","زمانی که خرس از ترس اژدها فریاد می‌کشد، مردی شجاع و قوی سر می‌رسد و او را از دست اژدها نجات می‌دهد."],[211,"حیلت و مردی به هم دادند پشت","اژدها را او بدین قوّت بکشت","حیله و تدبیر به همراه قدرت، باعث شدند که او بتواند اژدها را به زمین بیندازد و از شدت نیرویش، آن را شکست دهد."],[211,"اژدها را هست قوّت، حیله نیست","نیز فوق حیله تو حیله‌ایست","اژدها (که نماد قدرت و دشمنی است) دارای قدرت و توانایی است، اما تنها در دام تزویر و فریب تو نیست؛ از این رو، فریبی که تو به کار می‌بری، چیزی بیشتر از خود فریب نیست."],[211,"حیله خود را چو دیدی باز رو","کز کجا آمد، سوی آغاز رو","وقتی حیله و نقشه‌ای که برای فریب دیگران به کار بردی، دوباره به تو برگشت، به ریشه و منبع آن دقت کن و ببین از کجا آغاز شده است."],[211,"هر چه در پستیست آمد از علا","چشم را سوی بلندی نه هلا","هر چیزی که در پایین و پست است، از بلندی و تعالی سرچشمه می‌گیرد؛ بنابراین، چشم را به سمت بلندی‌ها و چیزهای والا ببر، نه به سمت حقارت و تنزل."],[211,"روشنی بخشد نظر اندر علی","گرچه اول خیرگی آرد بلی","نگاه به چیزهای بلند و مثبت، روشنایی و فهم عمیق به ما می‌دهد، هرچند که در ابتدا ممکن است باعث شگفتی و حیرت شود."],[211,"چشم را در روشنایی خوی کن","گر نه خفاشی نظر آن سوی کن","به چشم خود توجه کن تا به حقیقت و روشنی راه یابی، و اگر نمی‌توانی، مانند خفاش ریشه‌دار نباش و به سوی حقیقت دیگر نگاه کن."],[211,"عاقبت‌بینی نشان نور تست","شهوت حالی حقیقت گور تست","عاقبت‌بینی، نشانه‌ای از روشنایی روح توست، در حالی که شهوت و تجملات دنیایی، حقیقتی چون گور را در وجود تو نشان می‌دهد."],[211,"عاقبت‌بینی که صد بازی بدید","مثل آن نبود که یک بازی شنید","عاقبت‌بینی کسی که بازی‌های زیادی را تجربه کرده، حالا به این نتیجه رسیده که هیچ‌یک از آن‌ها مثل یک بازی که قبلا شنیده، نیست."],[211,"زان یکی بازی چنان مغرور شد","کز تکّبر ز اوستادان دور شد","کسی که به خاطر یک مرتبه بازی و لذت، آن‌چنان مغرور شد که از استادان و معلمان خود فاصله گرفت و از آنها روگردان شد."],[211,"سامری‌وار آن هنر در خود چو دید","او ز موسی از تکّبر سر کشید","چون آن شخص مانند سامری (که در داستان موسی به فریب و تکبر مشهور است) هنری را که از موسی آموخته بود در خود مشاهده کرد، به خاطر تکبر خود را کنار کشید."],[211,"او ز موسی آن هنر آموخته","وز معلم چشم را بر دوخته","او از موسی آن مهارت را یاد گرفته و به معلم خود چنان خیره شده که نمی‌تواند از او چشم بردارد."],[211,"لاجرم موسی دگر بازی نمود","تا که آن بازی و جانش را ربود","بنابراین موسی تصمیم گرفت تا بار دیگر به بازی و نمایش بپردازد تا روح و جان مردم را به خود جلب کند و تحت تأثیر قرار دهد."],[211,"ای بسا دانش که اندر سر دود","تا شود سرور، بدان خود سر رود","بسیاری از دانش‌ها در ذهن انسان وجود دارد که اگر به درستی مدیریت نشوند، شخص را از مسیر خود منحرف می‌کنند و در نهایت خودش را دچار سرگشتگی می‌سازد."],[211,"سر نخواهی که رود، تو پای باش","در پناه قطب صاحب‌رای باش","اگر نمی‌خواهی که مقام و اعتبارت از بین برود، باید استقامت کنی و به دقت از رهنمودهای حکیم و صاحب‌نظر پیروی کنی."],[211,"گرچه شاهی، خویش فوق او مبین","گرچه شهدی، جز نبات او مچین","اگرچه تو مقام بلندی داری، خود را بهتر از دیگران نپندار. اگرچه شیرینی تو ماننده عسل است، باید شیرینی نبات را هم تحسین کنی"],[211,"فکر تو نقش است و فکر اوست جان","نقد تو قلبست و نقد اوست کان","فکر تو تنها یک اثر و تصویر است، اما فکر او حقیقت و جان باقی است. وجود تو مثل یک قلب است که حیاتش بستگی به وجود او دارد."],[211,"او توی خود را بجو، در اوی او","کو و کو گو، فاخته شو سوی او","خود واقعی‌ات را در درون خود پیدا کن و به دنبال او (خدا) بگرد و مانند فاخته‌ای که به صدای خود می‌خواند، به سوی او برو."],[211,"ور نخواهی خدمت ابناء جنس","در دهان اژدهایی همچو خرس","اگر نخواهی به فرزندان جنس خود خدمت کنی، در واقع در دهان اژدهایی مانند خرس قرار داری."],[211,"بوک، استادی رهاند مر تو را","وز خطر بیرون کشاند مر تو را","اگر استادی پیدا بشود که تو را نجات دهد و از خطرها بیرون بیاورد، باید خوشحال و شکرگزار باشی."],[211,"زاریی می‌کن چو زورت نیست هین","چونک کوری سر مکش از راه‌بین","اگر توانایی تو کافی نیست، بیهوده ناله و زاری نکن، زیرا اگر فردی نابینا باشد، باید به سمت چیزی نامعلوم نرود و از مسیر درست مأیوس نشود."],[211,"تو کم از خرسی نمی‌نالی ز درد","خرس رست از درد، چون فریاد کرد","تو مانند خرسی زاری نمی‌کنی، ولی وقتی که خرس از درد خلاص می‌شود، به خاطر فریاد زدنش، از دردش رها می‌شود."],[211,"ای خدا این سنگ دل را موم کن","ناله‌اش را تو خوش و مرحوم کن","خداوندا، این دل سنگی مرا نرم و قابل انعطاف کن، ناله‌ام را نیز زیبا و مورد رحمت قرار بده."],[212,"بود کوری کو همی‌گفت الامان","من دو کوری دارم ای اهل زمان","مرد نابینایی بود که دائما فریاد می‌زد کمکم کنید! من دو نابینایی دارم، ای مردم زمان."],[212,"پس دوباره رحمتم آرید هان","چون دو کوری دارم و من در میان","ای حاضرین، به من رحم کنید، چون من دو نوع کوری دارم و در این میان گرفتارم."],[212,"گفت یک کوریت می‌بینیم ما","آن دگر کوری چه باشد وا نما","او می‌گوید ما یک نوع کوری را می‌بینیم، ولی نوع دیگری از کوری که خیلی واضح‌تر است، چه چیزی است؟ آن را به ما نشان بده."],[212,"گفت زشت‌آوازم و ناخوش نوا","زشت‌آوازی و کوری شد دوتا","او در پاسخ می‌گوید که صدایش زشت و نغمه‌اش ناخوش است و این دو عیب، یعنی بدصدا بودن و کوری، با هم جمع شده‌اند و همدیگر را تقویت می‌کنند."],[212,"بانگ زشتم مایه غم می‌شود","مهر خلق از بانگ من کم می‌شود","صدای زشت من باعث ایجاد غم و اندوه می‌شود و به خاطر این صدا محبت و دوستی مردم از من کمتر می‌شود."],[212,"زشت آوازم بهر جا که رود","مایه خشم و غم و کین می‌شود","صدای زشت من هر جا که می‌رود، باعث خشم، غم و کینه می‌شود."],[212,"بر دو کوری رحم را دوتا کنید","این چنین ناگنج را گنجا کنید","به دو نابینا رحم و محبت بیشتری بدهید، زیرا اینطور به راحتی می‌توانید این دشواری بزرگ را به راحتی تبدیل به گنج و نعمت کنید."],[212,"زشتی آواز کم شد زین گله","خلق شد بر وی برحمت یک‌دله","زشت بودن آواز، به خاطر این جمع و آدم‌های خوب، کم شده است. همچنین بر او رحمت و محبت نازل شد، چون همه یکدل شده‌اند."],[212,"کرد نیکو چون بگفت او راز را","لطف آواز دلش آواز را","او (نابینا) وقتی رازی را به خوبی بیان کرد، لطف و زیبایی آواز دلش باعث شد که آن راز به زیبایی ادا شود."],[212,"وانک آواز دلش هم بد بود","آن سه کوری دوری سرمد بود","هرچند صدای دل او زیبا بود، ولی سه کور همیشگی(آگاهی را) در دور دست داشتند."],[212,"لیک وهابان که بی علت دهند","بوک دستی بر سر زشتش نهند","وهابی‌ها (پیروان عقیده‌ای تندروی مذهبی) بی‌دلیل به کسی آسیب می‌رسانند، گویی که دست بر سر فرد زشت و ناپسند می‌گذارند."],[212,"چونک آوازش خوش و مظلوم شد","زو دل سنگین‌دلان چون موم شد","وقتی صدای او خوش و مظلومانه می‌شود، دل افرادی که سنگدل هستند نیز نرم و تسلیم می‌شود، مانند موم که به آسانی شکل می‌گیرد."],[212,"ناله کافر چو زشتست و شهیق","زان نمی‌گردد اجابت را رفیق","ناله کافر (کسی که به خدا ایمان ندارد) زشت و ناگوار است و به همین دلیل، درخواست‌های او مورد توجه و اجابت قرار نمی‌گیرد."],[212,"اخسؤا بر زشت آواز آمدست","کو ز خون خلق چون سگ بود مست","صدای زشت این کافر که می‌وزد، به اندازه‌ی صدای زشتی است که از سر یاغی‌گری و ظلم برمی‌خیزد و مانند سگی است که از خون مردم مست شده است."],[212,"چونک ناله خرس رحمت‌کش بود","ناله‌ات نبود چنین ناخوش بود","وقتی صدای خرس لطمه‌زننده و دردناک است، ناله تو هم نمی‌تواند اینقدر ناخوشایند باشد."],[212,"دان که با یوسف تو گرگی کرده‌ای","یا ز خون بی گناهی خورده‌ای","بدان که یا تو با یوسف (که نماد نیکوکاری و زیبایی است) به خیانت پرداخته‌ای یا اینکه از خون بی‌گناهی (که نماد ظلم و بی‌عدالتی است) بهره‌مند شده‌ای."],[212,"توبه کن وز خورده استفراغ کن","ور جراحت کهنه شد رو داغ کن","توبه کن و از گناه خود پاک شو و اگر جراحتی داری که قدیمی شده، باید آن را نشان بدهی و برطرف کنی."],[213,"خرس هم از اژدها چون وا رهید","وآن کرم زان مرد مردانه بدید","خرس از چنگال اژدها رها شد و وقتی آن کرمی را که نشان‌دهنده شجاعت و مردانگی آن مرد بود مشاهده کرد، تحت تأثیر قرار گرفت."],[213,"چون سگ اصحاب کهف آن خرس زار","شد ملازم در پی آن بردبار","خرس در غم و نگران حال دوستانش، مانند سگ اصحاب کهف به آنها وفادار مانده و بی‌تابی می‌کند."],[213,"آن مسلمان سر نهاد از خستگی","خرس حارس گشت از دل‌بستگی","آن مسلمان به خاطر خستگی، سر خود را بر روی زمین گذاشت و از عاطفه و وابستگی خود به خرس، محافظت و نگهداری کرد."],[213,"آن یکی بگذشت و گفتش حال چیست","ای برادر مر ترا این خرس کیست","کسی از آن مسلمان می‌پرسد که حالش چطور است و به او می‌گوید، ای برادر، این خرس که با توست چه کسی است؟"],[213,"قصه وا گفت و حدیث اژدها","گفت بر خرسی منه دل ابلها","در این بیت گفته می‌شود که باید از داستان‌های غیرواقعی و ترسناک که درباره موجودات خطرناک مثل اژدها نقل می‌شود، دل خود را به خرس که نماد صداقت و دوست‌داشتنی است، نسپاریم. در واقع، نباید به حرف‌های بی‌پایه و بی‌اعتبار، حتی اگر بر اساس وحشت و خیال ساخته شده باشند، اعتماد کنیم."],[213,"دوستی ابله بتر از دشمنیست","او بهر حیله که دانی راندنیست","دوستی که نادان است، بدتر از دشمنی است، زیرا او به هر نیرنگ و کلکی که بداند، می‌تواند انسان را به سمت بدی و رنجی بکشاند."],[213,"گفت والله از حسودی گفت این","ورنه خرسی چه نگری این مهر بین","او (ابله) می‌گوید که به خدا قسم، حسدی در کار نیست و این خرس را چه می‌بینی که چنین مهر و محبت دارد."],[213,"گفت مهر ابلهان عشوه‌ده است","این حسودی من از مهرش به است","شخص حسود می‌گوید که عشق و محبت ابلهان مانند فریبی است که فقط در ظاهر و به خاطر ظاهرسازی است، و من از این محبت او بهترم."],[213,"هی بیا با من بران این خرس را","خرس را مگزین مهل هم‌جنس را","بیا و با من برو تا این خرس را از خود دور کنیم، چون نباید با هم‌جنس خود که همان خرس است، نزدیک شوی."],[213,"گفت رو رو کار خود کن ای حسود","گفت کارم این بد و رزقت نبود","او به حسود می‌گوید که به کارهای خود بپرداز و به دیگران حسادت نکن، زیرا کارش خراب است و روزیش هم زیاد نیست."],[213,"من کم از خرسی نباشم ای شریف","ترک او کن تا منت باشم حریف","من از خرس کم ندارم، ای شریف، او را کنار بگذار تا من هم بتوانم در دوستی تو شریک باشم."],[213,"بر تو دل می‌لرزدم ز اندیشه‌ای","با چنین خرسی مرو در بیشه‌ای","من به خاطر یک فکر خاص، درباره تو دلم از ترس می‌لرزید؛ اما با چنین موجود خطرناکی (خرس) به جنگل نرو."],[213,"این دلم هرگز نلرزید از گزاف","نور حقست این نه دعوی و نه لاف","دل من هرگز از ترس لرزیده نشده، چون نور حق در قلبم وجود دارد. این احساس، نه یک ادعاست و نه مبالغه‌ای است."],[213,"مؤمنم ینظر بنور الله شده","هان و هان بگریز ازین آتشکده","من مؤمنی هستم که در پرتو نور خدا می‌بینم. پس هان، از این آتشکده دوری کن."],[213,"این همه گفت و به گوشش در نرفت","بدگمانی مرد سدیست زفت","این فرد هرچقدر که صحبت کرد، نتوانست به او بفهماند، چرا که بدبینی آن مرد مثل سدی بزرگ در سر راه او قرار داشت."],[213,"دست او بگرفت و دست از وی کشید","گفت رفتم چون نه‌ای یار رشید","او (مرد) دست فردی را گرفت اما بعد از آن دستش را کشید و گفت: من وقتی می‌روم که تو یار شایسته‌ای نباشی."],[213,"گفت رو بر من تو غمخواره مباش","بوالفضولا معرفت کمتر تراش","گفت: بر من نیاشوب و غمگین نباش، ای بی‌خود و بی‌فایده، دانش تو را کمتر کن."],[213,"باز گفتش من عدوی تو نیم","لطف باشد گر بیابی در پیم","او (شخصی که با بوالفضل صحبت می‌کند) می‌گوید: باز هم به او می‌گویم که من دشمن تو نیستم، اگر محبت و دوستی واقعی را در رفتارم ببینی، به من لطف کن و وفاداری نشان بده."],[213,"گفت خوابستم مرا بگذار و رو","گفت آخر یار را منقاد شو","او به دوستش می‌گوید که خوابیده و می‌خواهد تنها بماند، اما در پاسخ می‌افزاید که باید به حرف یار خود توجه کند و از او پیروی کند."],[213,"تا بخسپی در پناه عاقلی","در جوار دوستی صاحب‌دلی","اگر در سایه فردی عاقل و صاحب‌دل بخوابی، به موفقیت و آرامش خواهی رسید و در دوستی و همراهی او احساس امنیت می‌کنی."],[213,"در خیال افتاد مرد از جد او","خشمگین شد زود گردانید رو","مرد در فکر خودش به یاد جدش افتاد و این خیال او را به سرعت خشمگین کرد و باعث شد که رویش را برگرداند."],[213,"کین مگر قصد من آمد خونیست","یا طمع دارد گدا و تونیست","مرد در دل فکر می‌کند که آیا آیا این خشم و خصومتی که از جد (پدربزرگ) او ناشی شده، به خاطر خونریزی است یا اینکه این گدا (شخصی بی‌مقدار) تنها به دنبال طمع و خواسته‌ای است و در واقع نیت بدی ندارد."],[213,"یا گرو بستست با یاران بدین","که بترساند مرا زین همنشین","شاید این فرد با دوستان بد خود قراردادی بسته تا به وسیله آن، مرا از این همنشینی بترساند."],[213,"خود نیامد هیچ از خبث سرش","یک گمان نیک اندر خاطرش","او هیچ‌گاه از بدی‌های خویش نیاورد و در دل خود حتی یک خیال نیک درباره خود نداشت."],[213,"ظن نیکش جملگی بر خرس بود","او مگر مر خرس را هم‌جنس بود","او تمام گمان‌های خوبش نسبت به خرس بود و نمی‌دانست که آیا خود خرس هم از نوع خود اوست."],[213,"عاقلی را از سگی تهمت نهاد","خرس را دانست اهل مهر و داد","خرس به عاقل می‌گوید که او را به ناحق به سگ متهم کرده‌اند، در حالی که خودش می‌داند که خرس کسی است که اهل محبت و انصاف است."],[214,"گفت موسی با یکی مست خیال","کای بداندیش از شقاوت وز ضلال","موسی علیه السلام به یکی از گوساله‌پرستان که در خیال و وهم خود گرفتار است، می‌گوید: ای بداندیش، تو به خاطر پستی و گمراهی‌ات در این وضعیت هستی."],[214,"صد گمانت بود در پیغامبریم","با چنین برهان و این خلق کریم","با وجود اینکه بارها و بارها پیام ما را دریافت کرده‌ای و معجزات زیادی را دیده‌ای، هنوز صدها گمان و شک درباره حقیقت کلام ما داری."],[214,"صد هزاران معجزه دیدی ز من","صد خیالت می‌فزود و شک و ظن","تو معجزات فراوانی از من دیده‌ای، اما باز هزاران خیال و شک به ذهنت اضافه می‌شود و این را نمی‌پذیری."],[214,"از خیال و وسوسه تنگ آمدی","طعن بر پیغامبری‌ام می‌زدی","به خاطر وسوسه‌ها و خیالپردازی‌هایت خسته و ناامید شده‌ای و به من، که پیامبر هستم، به تندی انتقاد می‌کنی."],[214,"گرد از دریا بر آوردم عیان","تا رهیدیت از شر فرعونیان","من از دریا گرد و غباری را به طور واضح و روشن بیرون آوردم تا تو از شر فرعونیان رهایی یابی."],[214,"ز آسمان چل سال کاسه و خوان رسید","وز دعاام جوی از سنگی دوید","به مدت چهل سال، سفره‌ای از آسمان به سوی مردم نازل شده و دعای من باعث شد که آب از سنگی جاری شود."],[214,"این و صد چندین و چندین گرم و سرد","از تو ای سرد آن توهم کم نکرد","این و این همه مشکلات و تغییرات حال، از تو که در سردی و بی‌احساسی به سر می‌بری، هیچ کاسته نشده است."],[214,"بانگ زد گوساله‌ای از جادوی","سجده کردی که «خدای من توی»","گوساله‌ای که به وسیله جادو و توهم پرستش شده، صدایی را می‌زند و از فردی که سجده کرده می‌پرسد که آیا او فکر می‌کند «خدای من توی»؟ این جمله به چالش انداختن اعتقاد فرد سجده‌ کننده است."],[214,"آن توهمهات را سیلاب برد","زیرکی باردت را خواب برد","خودت را فریب نده و از توهمات دوری کن؛ زیرا هوش و زیرکی تو را به خواب برده و غفلت کرده است."],[214,"چون نبودی بدگمان در حق او؟","چون نهادی سر چنان؟ ای زشت‌خو","چرا در مورد او بدگمان نبودی؟ چرا این اندازه به او اعتماد کردی و سرت را به زیر انداختی، ای انسان زشت‌خلق؟"],[214,"چون خیالت نامد از تزویر او؟","وز فساد سحر احمق‌گیر او؟","چرا فکر تو به نیرنگ او نرسید؟ و از اثر سحر و فریبی که او ایجاد کرده، متوجه نشدی؟"],[214,"سامریی خود که باشد ای سگان!؟","که خدایی بر تراشد در جهان؟","سامری، کسی که در داستان موسی به پرستش گوساله می‌پردازد، چه کسی است که در جهان خدایی برای تو بسازد و دینی را به تو القا کند؟ این بیت به تمسخر و انتقاد از افرادی می‌پردازد که به سادگی به مسائلی مثل خدایی و دین دیگران اعتماد می‌کنند."],[214,"چون درین تزویر او یک‌دل شدی؟","وز همه اشکال‌ها عاطل شدی؟","وقتی که در این فریب و تظاهر یکدل شده‌ای، چرا از همه شکل‌ها و ظواهر خالی شده‌ای؟"],[214,"گاو می‌شاید خدایی را بلاف","در رسولی‌ام تو چون کردی خلاف؟","موسی (علیه‌السلام) می‌پرسد که چگونه ممکن است گاو را به جای خدا پرستش کنی، در حالی که من پیامبری (فرستاده‌ای) از سوی خدا هستم و تو خلاف این باور را انتخاب کرده‌ای؟"],[214,"پیش گاوی سجده کردی از خری","گشت عقلت صید سحر سامری","تو به گاوی سجده کردی و به خاطر چنین کار نادرستی، عقل تو مانند خر (که نماد نادانی است) به دام فریب سامری گرفتار شده است."],[214,"چشم دزدیدی ز نور ذوالجلال","اینت جهل وافر و عین ضلال","چشم تو از نور خداوند بزرگ دور شده و به همین دلیل، جهل و نادانی زیادی را به همراه دارد و در حقیقت نشان‌دهنده گمراهی توست."],[214,"شه بر آن عقل و گزینش که تراست","چون تو کان جهل را کشتن سزاست","ای پادشاه، بر آن عقل و انتخابی که متعلق به توست، تو باید جهل را که در درونت است از بین ببری."],[214,"گاو زرین بانگ کرد، آخر چه گفت؟","کاحمقان را این همه رغبت شکفت؟","گوساله طلایی صدایی زد، اما چه گفت؟ چرا عقل‌مندان این‌قدر نسبت به آن شور و شوق پیدا کردند؟"],[214,"زان عجب‌تر دیده‌ایت از من بسی","لیک حق را کی پذیرد هر خسی؟","عجب است که تو از من چیزهای زیادی دیده‌ای، اما آیا هر آدم بی‌معنا و بی‌فهمی می‌تواند حقیقت را بپذیرد؟"],[214,"باطلان را چه رباید؟ باطلی","عاطلان را چه خوش آید؟ عاطلی","باطلان (وضعیت‌های بی‌ارزش) را چه چیزی به خود جذب می‌کند؟ و چه چیز خوشایند عاطل‌ها (آدم‌های بی‌کار و بی‌هدف) است؟"],[214,"زانک هر جنسی رباید جنس خود","گاو سوی شیر نر کی رو نهد؟","هر چیزی به سوی هم‌جنس خود کشیده می‌شود. مانند اینکه گاو به سمت شیر نر نمی‌رود، زیرا هر دو از اجناس متفاوت هستند."],[214,"گرگ بر یوسف کجا عشق آورد؟","جز مگر از مکر تا او را خورد","گرگ (تعبیر از دشمن یا حیله‌گر) چگونه می‌تواند بر یوسف (نماد معصومیت و زیبایی) عشق ورزد؟ جز با نیرنگ و حیله تا او را فریب دهد و به مقاصد خود برساند."],[214,"چون ز گرگی وا رهد محرم شود","چون سگ کهف از بنی‌آدم شود","وقتی که کسی از خطر و فریب دور شود، مانند سگی خواهد بود که در کنار حضرت یوسف، از فرزندان آدم شده است. این بدان معناست که او به جمع صالحان ملحق می‌شود و از گرگ‌ها و مکاران دور می‌ماند."],[214,"چون ابوبکر از محمد برد بو","گفت هذا لیس وجه کاذب","وقتی ابوبکر از محمد (پیامبر اسلام) بوی خوبی را می‌برد، گفت: \"این چهره چهره‌ای دروغین نیست."],[214,"چون نبد بوجهل از اصحاب درد","دید صد شق قمر باور نکرد","چون بوجهل یکی از یاران درد، صد بار پدیدار شدن قمر (نشانه‌ای از معجزه) را هم که دید، باور نکرد."],[214,"دردمندی کش ز بام افتاد طشت","زو نهان کردیم حق پنهان نگشت","اگر شخصی دارای درد و رنجی از بام افتاده باشد، طشت (ظرفی که در آن آب یا چیز دیگری ریخته می‌شود) او را پنهان کرده‌ایم، اما حقیقت او هرگز پنهان نخواهد شد."],[214,"وانک او جاهل بد از دردش بعید","چند بنمودند و او آن را ندید","این شخص به دلیل نادانی‌اش متوجه درد و رنج خود نیست، هرچند که دیگران آن را به او نشان دادند."],[214,"آینه دل صاف باید تا درو","وا شناسی صورت زشت از نکو","دل باید پاک و بی‌آلایش باشد تا بتوانی حقیقت و صورت‌های زشت و نیک را بشناسی."],[215,"آن مسلمان ترک ابله کرد و تفت","زیر لب لاحول گویان باز رفت","آن مرد مسلمان که احمق بود، به‌جای رونق و جدال در دل، به آرامی و بی‌سر و صدا کلمه «لاحول» را می‌گفت و دوباره رفت."],[215,"گفت چون از جد و بندم وز جدال","در دل او بیش می‌زاید خیال","گفت وقتی که از جد و جدال دور شوم، در دل او بیشتر خیال و افکار مخصوص به من شکل می‌گیرد."],[215,"پس ره پند و نصیحت بسته شد","امر اعرض عنهم پیوسته شد","دیگر راهی برای پند و نصیحت باقی نمانده و به این ترتیب، دستور «از آنها روی برگردان» دائمی شده است."],[215,"چون دوایت می‌فزاید درد پس","قصه با طالب بگو بر خوان عبس","زمانی که بیماری تو زیاد می‌شود، بهتر است قصه‌ات را به طالب (درخواست‌کننده) بگویی تا او آن را بشنود و بداند که درد تو چیست."],[215,"چونک اعمی طالب حق آمدست","بهر فقر او را نشاید سینه خست","چون‌که فرد نابینایی (اعمی) برای طلب حق آمده، برای فقر و نیاز او دل سختی و رنج لازم نیست، یعنی نیازی به احساس سنگینی و قمری بودن در این مورد نیست."],[215,"تو حریصی بر رشاد مهتران","تا بیاموزند عام از سروران","تو بر مهارت و شجاعت بزرگ‌ترها بسیار علاقه‌مندی و خواهان آنی که مردم عادی از سروران و رهبران بیاموزند."],[215,"احمدا دیدی که قومی از ملوک","مستمع گشتند گشتی خوش که بوک","ای احمق! آیا ندیدی که گروهی از پادشاهان به سخنان تو گوش فرا دادند و تو خوشحال شدی که شاید به سبب این گفته‌ها؛ عاقبت کار تغییر کند؟"],[215,"این رئیسان یار دین گردند خوش","بر عرب اینها سرند و بر حبش","این رئیسان، به عنوان حامیان دین، خوشحال هستند که بر عرب تسلط دارند و بر حبشی‌ها نیز برتری می‌یابند."],[215,"بگذرد این صیت از بصره و تبوک","زانک الناس علی دین الملوک","این شهرت و آوازه از بصره و تبوک (دو شهر معروف) عبور خواهد کرد، زیرا مردم معمولا پیرو دین و اعتقادات فرمانروایان خود هستند."],[215,"زین سبب تو از ضریر مهتدی","رو بگردانیدی و تنگ آمدی","به همین دلیل تو از راهنمایی نابینای بصیر (خود آگاه) فاصله گرفتی و دلت تنگ شد."],[215,"کندرین فرصت کم افتد این مناخ","تو ز یارانی و وقت تو فراخ","در این زمان کم‌مایه و فرصت محدود، نباید از یاران خود دور شوی، زیرا زمان تو برای انتخاب و انتخاب‌های خوب بیشتر نیست."],[215,"مزدحم می‌گردیم در وقت تنگ","این نصیحت می‌کنم نه از خشم و جنگ","این بیت به نکته‌ای مهم اشاره دارد که در زمان‌های دشوار و تنگنا، افراد نباید به یکدیگر درگیر شوند یا خشم و جنگ به راه بیندازند. بلکه باید نصیحت‌ها را بپذیرند و در پی صلح و آرامش باشند."],[215,"احمدا نزد خدا این یک ضریر","بهتر از صد قیصرست و صد وزیر","ای نابخرد، نزد خدا یک شخص کور (ضریر) بهتر از صد امپراتور (قیصر) و صد وزیر است."],[215,"یاد الناس معادن هین بیار","معدنی باشد فزون از صد هزار","ای مردم، به یاد داشته باشید که معادن و گنجینه‌ها ارزشمندند، پس بیایید دقت کنیم که گنجی که در دست داریم، باید از صدها و هزاران گنج دیگر بیشتر ارزش داشته باشد."],[215,"معدن لعل و عقیق مکتنس","بهترست از صد هزاران کان مس","خزانه‌های لعل و عقیق که در گنجینه‌های پنهان و محفوظ هستند، از صدها هزار معدن مس ارزشمندتر هستند. این به این معناست که ارزش واقعی چیزها به کیفیت و معناشان بستگی دارد نه به کمیت و سطحی‌نگری."],[215,"احمدا اینجا ندارد مال سود","سینه باید پر ز عشق و درد و دود","ای احمق! در اینجا چیزی از ثروت و مال وجود ندارد. دل باید از عشق و درد و غم پر باشد و نه از چیزهای مادی."],[215,"اعمیی روشن‌دل آمد در مبند","پند او را ده که حق اوست پند","انسان نابینایی که دلش روشن است، به این مرد پنددهنده بی‌اعتنا است و به او می‌گوید که پند و نصیحتی که به او می‌دهد، حق او نیست و نباید به آن توجه کند."],[215,"گر دو سه ابله ترا منکر شدند","تلخ کی گردی چو هستی کان قند","اگر چند نفر نادان تو را رد کردند، چرا باید تلخ و ناراحت شوی وقتی که تو همانند قند باارزش هستی؟"],[215,"گر دو سه ابله ترا تهمت نهد","حق برای تو گواهی می‌دهد","اگر چند نادان به تو اتهام بزنند، خداوند حق را به عنوان شاهد و گواهی برای تو ارائه می‌دهد."],[215,"گفت از اقرار عالم فارغم","آنک حق باشد گواه او را چه غم","عالم می‌گوید که من از اقرار و اعتراف خود رها شده‌ام، زیرا اگر حق گواهی دهد، دیگر برای من غمی نیست."],[215,"گر خفاشی را ز خورشیدی خوریست","آن دلیل آمد که آن خورشید نیست","اگر خفاشی به دلیل داشتن تغذیه از خورشید، نشان دهد که خورشید واقعی نیست، این نشانه‌ای است که خود خورشید هم نیست."],[215,"نفرت خفاشکان باشد دلیل","که منم خورشید تابان جلیل","نفرت و دشمنی خفاش‌ها نشان‌دهنده این است که من خورشید بزرگ و درخشانی هستم."],[215,"گر گلابی را جعل راغب شود","آن دلیل ناگلابی می‌کند","اگر شخصی بخواهد گلابی را تقلبی و مصنوعی بسازد، این نشان‌دهنده آن است که آن چیز از اصل خود واقعی و باکیفیت نیست."],[215,"گر شود قلبی خریدار محک","در محکی‌اش در آید نقص و شک","اگر قلبی برای امتحان و آزمایش پیش آید، در آن امتحان عیب و نقص و تردید او نمایان می‌شود."],[215,"دزد شب خواهد نه روز این را بدان","شب نیم روزم که تابم در جهان","دزد شب به خاطر تاریکی و پنهانی که دارد، کارهایش را در شب انجام می‌دهد و نه در روز. من هم در این شب، که شبیه روز است، در میان مردم تابلو و جلوه‌گر هستم."],[215,"فارقم فاروقم و غلبیروار","تا که که از من نمی‌یابد گذار","من از چیزهایی جدا هستم که مانع من می‌شوند و همچون فرشته‌ای پخته و قوی هستم. تا کی این موانع بر من چیره خواهند بود و فارغ از آن‌ها نمی‌توانند مرا ببیند؟"],[215,"آرد را پیدا کنم من از سبوس","تا نمایم کین نقوشست آن نفوس","من می‌خواهم آرد را از سبوس پیدا کنم، تا نشان دهم که این نقوش، نشانه‌های آن نفوس (روح‌ها) هستند."],[215,"من چو میزان خدایم در جهان","وا نمایم هر سبک را از گران","من به عنوان خدای سنجش در دنیا، هر چیزی را به اندازه واقعی‌اش وزن می‌کنم و شناسایی می‌کنم، خواه چیز سبک باشد یا سنگین."],[215,"گاو را داند خدا گوساله‌ای","خر خریداری و در خور کاله‌ای","خدا می‌داند که گاو به چه گوساله‌ای نیاز دارد، و به جای آن، خر را به عنوان خریدی برای تأمین خوراک و نیازهایش می‌خرد."],[215,"من نه گاوم تا که گوسالم خرد","من نه خارم که اشتری از من چرد","من نه مانند گاو هستم که گوساله‌ام مورد خرید و فروش قرار گیرد، و نه مانند خار (که به عنوان مثال برای رکود استفاده می‌شود) هستم که شتری از من علف بچرد."],[215,"او گمان دارد که با من جور کرد","بلک از آیینه من روفت گرد","او فکر می‌کند که با من سازگار شده، در حالی که در واقع از انعکاس خود در آینه وجود من عقب‌نشینی کرده است."],[216,"گفت جالینوس با اصحاب خود","مر مرا تا آن فلان دارو دهد","جالینوس به همراه دوستانش گفت که باید به من دارویی بدهند که برای جنون مفید باشد."],[216,"پس بدو گفت آن یکی ای ذو فنون","این دوا خواهند از بهر جنون","یکی از اصحاب جالینوس (پزشک معروف) به او گفت که کسانی (احتمالا دیوانه‌ها) به این دارو نیاز دارند تا جنون (دیوانگی) خود را درمان کنند."],[216,"دور از عقل تو این دیگر مگو","گفت در من کرد یک دیوانه رو","جالینوس، پزشک مشهور، به دیوانه‌ای که او را نصیحت می‌کرد، گفت: دیگر از عقل دوری نکن و این حرف‌ها را نزن، چرا که تو به او اشاره می‌کنی و خودت نیز دیوانه‌ای."],[216,"ساعتی در روی من خوش بنگرید","چشمکم زد آستین من درید","مدتی به من به قصد خوشی و شادی نگاه کنید، زیرا در این لحظه به خاطر شما احساس شادابی می‌کنم و از شدت خوشحالی، آستین من پاره شده است."],[216,"گرنه جنسیت بدی در من ازو","کی رخ آوردی به من آن زشت‌رو","اگر آن زشت‌رو، به من نمایان نشده، این نکته است که سهو و نقصی در وجود من نیست که به خاطر آن به تو توجه کرده‌ام."],[216,"گر ندیدی جنس خود کی آمدی","کی به غیر جنس خود را بر زدی","اگر خود را نمی‌شناسی و به ذات خود توجه نکرده‌ای، چرا به دیگری می‌تازی و او را قضاوت می‌کنی؟"],[216,"چون دو کس بر هم زند بی‌هیچ شک","در میانشان هست قدر مشترک","زمانی که دو نفر با یکدیگر در ارتباط باشند، به‌طور حتم در میان آن‌ها نکاتی مشترک وجود دارد."],[216,"کی پرد مرغی مگر با جنس خود","صحبت ناجنس گورست و لحد","پرنده‌ای از جنس خود نمی‌تواند با چیزهایی که از جنس او نیستند، صحبت کند؛ پس مرگ و خاک (گور و لحد) به نفسها و روح‌های بی‌جنس او مربوط می‌شود."],[217,"آن حکیمی گفت دیدم هم تکی","در بیابان زاغ را با لکلکی","حکیمی می‌گوید که در بیابان، زاغی را دید که به تنهایی در کنار یک لک‌لک نشسته بود."],[217,"در عجب ماندم بجستم حالشان","تا چه قدر مشترک یابم نشان","من در تعجب مانده‌ام و تلاش می‌کنم بدانم حال آن‌ها چه طور است تا ببینم چه مقدار ویژگی مشترک بینشان وجود دارد."],[217,"چون شدم نزدیک من حیران و دنگ","خود بدیدم هر دوان بودند لنگ","وقتی به آنها نزدیک شدم، حیرت‌زده شدم و متوجه شدم که هر دو، یعنی آن مرغ و من، در حالتی نامتعادل و لنگان به سر می‌بردیم."],[217,"خاصه شه‌بازی که او عرشی بود","با یکی جغدی که او فرشی بود","هواپیمایی که مقام او در آسمان‌ها بود، به همراه یک جغد که در زمین زندگی می‌کرد، در برابر هم قرار گرفتند."],[217,"آن یکی خورشید علیین بود","وین دگر خفاش کز سجین بود","یکی از آن‌ها مانند خورشید بود و بسیار بلندمرتبه و با شرافت، در حالی که دیگری مانند خفاشی بود که از ظلمت و سیاهی رنج می‌برد."],[217,"آن یکی نوری ز هر عیبی بری","وین یکی کوری گدای هر دری","یکی از آن‌ها نوری است که از هر عیب و کمبودی پاک است و دیگری کوری است که در فقر و نیاز به در هر درگاهی به سر می‌برد."],[217,"آن یکی ماهی که بر پروین زند","وین یکی کرمی که در سرگین زید","یکی از آن‌ها مانند ماهی است که در درخشش ستاره پروین شناور است، در حالی که دیگری مثل کرمی است که در زباله و فضولات زندگی می‌کند و بر آن‌ها می‌خزد."],[217,"آن یکی یوسف‌رخی عیسی‌نفس","وین یکی گرگی و یا خر با جرس","در این بیت، شاعر به مقایسه دو نوع انسان اشاره دارد. یکی را به یوسف، نماد زیبایی و عظمت روحانی می‌سازد، و دیگری را به گرگی یا خر، نماد جاهلیت و سطحی‌نگری می‌داند. بنابراین، انسان‌ها می­توانند از نظر روحی و اخلاقی بسیار متفاوت باشند."],[217,"آن یکی پران شده در لامکان","وین یکی در کاهدان همچون سگان","یکی از آن دو پرنده به آسمان‌های بی‌نهایت پرواز کرده و دیگری در کاه و سنبل‌ها مانند سگ‌ها گذران زندگی می‌کند."],[217,"با زبان معنوی گل با جعل","این همی‌گوید که ای گنده‌بغل","مرغی که به جای نزدیکی به گل و عطر آن، در کاه و دشت به سر می‌برد، به زبانی معنوی و پنهانی به او می‌گوید که تو که این‌قدر بزرگ خود را می‌پنداری، چرا در این حال به چمن و گلستان نمی‌روی؟"],[217,"گر گریزانی ز گلشن بی گمان","هست آن نفرت کمال گلستان","اگر از گلشن (باغ گل) فرار کنی، مطمئنا نشانه نفرت تو از زیبیایی و کمال گلستان است."],[217,"غیرت من بر سر تو دورباش","می‌زند کای خس ازینجا دور باش","غیرت و حس حسادت من به خاطر تو به شدت احساس می‌شود و نسبت به تو، ای شاه، به شدت عکس‌العمل نشان می‌دهد، بنابراین بهتر است از اینجا دور باشی."],[217,"ور بیامیزی تو با من ای دنی","این گمان آید که از کان منی","اگر تو با من آمیخته شوی، ای دنیا، این تصور پیش می‌آید که تو از من هستی و ریشه‌ات به من مربوط می‌شود."],[217,"بلبلان را جای می‌زیبد چمن","مر جعل را در چمین خوشتر وطن","بلبلان باید در باغ و چمن زندگی کنند و مکان‌های جعلی و ساختگی برای آنان مناسب نیست؛ زیرا باغ بهشت واقعی و بهترین وطن برای آن‌هاست."],[217,"حق مرا چون از پلیدی پاک داشت","چون سزد بر من پلیدی را گماشت","خداوند مرا از آلودگی پاک ساخته است، بنابراین شایسته نیست که پلیدی را بر من تحمیل کند."],[217,"یک رگم زیشان بد و آن را برید","در من آن بدرگ کجا خواهد رسید","من یک رگ ناپاک از فرشتگان دارم و اگر آن را قطع کنم، به کجا خواهم رسید؟ این جمله به این معناست که وقتی بخش ناپاک وجودم را از بین ببرم، به کمال و مقام بالاتری دست پیدا می‌کنم."],[217,"یک نشان آدم آن بود از ازل","که ملایک سر نهندش از محل","نشان آدمی از ابتدا این بود که فرشتگان (ملایک) به او احترام بگذارند و سر به زیر او نهند."],[217,"یک نشان دیگر آنک آن بلیس","ننهدش سر که منم شاه و رئیس","یکی دیگر از نشانه‌های آدمیت این است که ابلیس، که خود را شاه و رئیس می‌داند، سر به زیر نمی‌گذارد و سجده نمی‌کند."],[217,"پس اگر ابلیس هم ساجد شدی","او نبودی آدم او غیری بدی","اگر ابلیس هم سجده کند، او هرگز آدم نمی‌شود و به حقیقت چیزی جز موجود دیگری است."],[217,"هم سجود هر ملک میزان اوست","هم جحود آن عدو برهان اوست","سجود هر فرشته به آدم نشانه احترام و ارزیابی اوست، و انکار ابلیس (که در برابر آدم سجده نکرد) دلیل بر نپذیرفتن مرتبه آدم است."],[217,"هم گواه اوست اقرار ملک","هم گواه اوست کفران سگک","اقرار و اعتراف فرشتگان به حقایق خداوند و همچنین انکار و کفر سگک (دوران) هر دو شاهدی بر حقایق هستند."],[218,"شخص خفت و خرس می‌راندش مگس","وز ستیز آمد مگس زو باز پس","شخصی که خفت و خرس آن را می‌راند، مگس است که به او حمله می‌کند و دوباره به سوی او برمی‌گردد."],[218,"چند بارش راند از روی جوان","آن مگس زو باز می‌آمد دوان","چندین بار آن مگس، به خاطر جوانی خرس را راند و او را زد، اما باز هم هر بار سریعا باز می‌آمد."],[218,"خشمگین شد با مگس خرس و برفت","بر گرفت از کوه سنگی سخت زفت","خرس، از دست مگس عصبانی شد و به سرعت به سمت کوه رفت تا سنگی بزرگ و سنگین را برداشت."],[218,"سنگ آورد و مگس را دید باز","بر رخ خفته گرفته جای و ساز","خرس سنگی آورد و دوباره مگس را دید که بر صورتش خوابیده و در حال استراحت است."],[218,"بر گرفت آن آسیا سنگ و بزد","بر مگس تا آن مگس وا پس خزد","آسیا سنگی را برداشت و بر مگسی که بر روی خفته نشسته بود زد تا آن مگس عقب‌نشینی کند."],[218,"سنگ روی خفته را خشخاش کرد","این مثل بر جمله عالم فاش کرد","سنگی که روی آن خوابیده، با خشخاش (پوشش گیاهی) بیدار و نمایان شد، این مثل حقیقتی را برای همه مردم روشن کرد."],[218,"مهر ابله مهر خرس آمد یقین","کین او مهرست و مهر اوست کین","دوستی ابلهانه و توهم‌آمیز مانند دوستی خرس است، زیرا این دوستی واقعی نیست و بر اثر نادانی و بی‌توجهی به حقیقت شکل گرفته است."],[218,"عهد او سستست و ویران و ضعیف","گفت او زفت و وفای او نحیف","عهد او (خرس) ضعیف و بی‌ثبات است و وفای او ناپایدار و کم‌مدت است."],[218,"گر خورد سوگند هم باور مکن","بشکند سوگند مرد کژسخن","اگر کسی سوگند بخورد، به او ایمان نیاور، زیرا مردی که دروغگو و سخن‌چین است، به راحتی سوگندش را می‌شکند."],[218,"چونک بی‌سوگند گفتش بد دروغ","تو میفت از مکر و سوگندش به دوغ","اگر کسی بدون سوگند حرفی بزند، آن حرف دروغ است و تو به خاطر فریب و نیرنگ او باید از آن دوری کنی."],[218,"نفس او میرست و عقل او اسیر","صد هزاران مصحفش خود خورده گیر","نفس او (نفس شخص در اینجا به معنی خواسته‌ها و هوس‌هایش) رشد می‌کند و عقل او تحت تسلط و کنترل قرار دارد، زیرا او به هزاران نوشته (مصحف) افتخار می‌کند که در واقع تمامی آن‌ها فقط به خود او تعلق دارند و به او لطمه می‌زنند."],[218,"چونک بی سوگند پیمان بشکند","گر خورد سوگند هم آن بشکند","زمانی که کسی بدون سوگند و قسم، عهد و پیمان را بشکند، اگر هم که قسم بخورد، آن قسم نیز دروغین و بی‌معنا خواهد بود."],[218,"زانک نفس آشفته‌تر گردد از آن","که کنی بندش به سوگند گران","چون نفس انسان آشفته و بی‌قرار است، او بیشتر دچار پریشانی می‌شود اگر به خاطر سوگندهای سخت و سنگین، آن را تحت کنترل بگیری."],[218,"چون اسیری بند بر حاکم نهد","حاکم آن را بر درد بیرون جهد","وقتی که یک اسیر، بندی را به گردن حاکم بیاندازد، حاکم سعی می‌کند آن بند را از درد و عذاب بیرون آورد."],[218,"بر سرش کوبد ز خشم آن بند را","می‌زند بر روی او سوگند را","از روی خشم، آن بند را بر سر او می‌کوبد و سوگند را بر او می‌زند، نشان دهنده شدت خشم و قهر حاکم است."],[218,"تو ز اوفوا بالعقودش دست شو","احفظوا ایمانکم با او مگو","تو به او (خداوند) وفادار باش و به عهد و پیمانی که بسته‌ای پایبند باش، و به او ایمان خود را حفظ کن، اما درباره او سخن مگو."],[218,"وانک حق را ساخت در پیمان سند","تن کند چون تار و گرد او تند","هرچند خداوند عهد و پیمان را بر او مقرر کرده، اما او مانند توری است که به راحتی تبدیل به گرد و غبار می‌شود و به سرعت به سمت خواسته‌های خود می‌رود."],[219,"از صحابه خواجه‌ای بیمار شد","واندر آن بیماریش چون تار شد","یکی از صحابه بیمار شد و آن بیماری مثل تار و ریسمان او را لاغر و ضعیف کرد."],[219,"مصطفی آمد عیادت سوی او","چون همه لطف و کرم بد خوی او","پیامبر اکرم (مصطفی) برای عیادت آن صحابی بیمار رفت و این عمل او نشان‌دهنده تمام محبت و خوبی‌اش بود."],[219,"در عیادت رفتن تو فایده‌ست","فایده آن باز با تو عاید است","در رفتن تو به عیادت دیگران نفعی وجود دارد و آن نفع به خود تو نیز برمی‌گردد."],[219,"فایده اول که آن شخص علیل","بوک قطبی باشد و شاه جلیل","فایده اول این است که آن فرد بیمار ممکن است شخصی بزرگ و مهم باشد، همچون قطب یا شاه عظیم‌الشان."],[219,"چون دو چشم دل نداری ای عنود","که نمی‌دانی تو هیزم را ز عود","اگر تو، ای شخص لجوج، دو چشم دل نداشته باشی، نمی‌توانی تشخیص دهی که هیزم (چوب خشک) چیست و عود (چوب خوشبوی خوش‌سوز) چیست."],[219,"چونک گنجی هست در عالم مرنج","هیچ ویران را مدان خالی ز گنج","در این بیت، شاعر به این موضوع اشاره می‌کند که هرگز نباید تظاهر کرد که شخصی خالی و بی‌ارزش است؛ چرا که در هر فردی یا در هر وضعیتی می‌تواند گنجینه‌ای از ارزش‌ها و دانش‌ها نهفته باشد. بنابراین، بیرون از ظاهر ظاهری دیگران نبر، چون ممکن است آن‌ها درون خود گنجی پنهان داشته باشند."],[219,"قصد هر درویش می‌کن از گزاف","چون نشان یابی به جد می‌کن طواف","هر درویش باید برای هدفی معین و جدی قدم بردارد و از کارهای بیهوده و بی‌هدف پرهیز کند. وقتی نشانه‌ای از راه درست را پیدا کرد، باید با تمام جدیت به دور آن بچرخد و به آن عمل کند."],[219,"چون تو را آن چشم باطن‌بین نبود","گنج می‌پندار اندر هر وجود","چون تو آن چشم باطن‌بین را نداری، هر وجودی را مانند گنج تصور می‌کنی."],[219,"ور نباشد قطب، یار ره بود","شه نباشد، فارس اسپه بود","اگر قطب و راهنمایی نباشد، دوست و یاری برای راه باقی است؛ حتی اگر پادشاهی و رهبری وجود نداشته باشد، رزمنده و فدایی در میدان جنگ هست."],[219,"پس صله یاران ره لازم شمار","هر که باشد گر پیاده گر سوار","پس باید ارتباط و دوستی با یاران راه را ضروری بدانیم، فرقی نمی‌کند که آن‌ها سواره باشند یا پیاده."],[219,"ور عدو باشد همین احسان نکوست","که به احسان بس عدو گشته‌ست دوست","اگر کسی دشمن باشد، این کار نیکو یعنی احسان به او هم خوب است؛ زیرا به وسیله احسان، دشمنان بسیاری به دوستان تبدیل شده‌اند."],[219,"ور نگردد دوست کینش کم شود","زانک احسان کینه را مرهم شود","اگر دوست هم به دشمنی بگراید، محبت و دوستی‌اش کم نخواهد شد، زیرا احسان و خوبی کردن می‌تواند کینه‌ها را درمان کند."],[219,"بس فواید هست غیر این ولیک","از درازی خایفم ای یار نیک","بسیاری از فواید وجود دارد جز این مورد، اما از طولانی شدن صحبت می‌ترسم ای دوست خوب."],[219,"حاصل این آمد که یار جمع باش","همچو بتگر از حجر یاری تراش","نتیجه‌گیری این است که باید دوست و یار را در کنار خود داشته باشی، مانند بت‌گر که از سنگ مجسمه‌ای زیبا می‌سازد."],[219,"زانک انبوهی و جمع کاروان","ره‌زنان را بشکند پشت و سنان","زیرا جمعیت و انبوه کاروانی که در راه است، می‌تواند به راحتی جلوی راهزنان را بگیرد و آن‌ها را وادار به تسلیم کند."],[220,"آمد از حق سوی موسی این عتاب","کای طلوع ماه دیده تو ز جیب","خداوند به موسی هشدار می‌دهد که چرا به عیادت او نیامده است، در حالی که نور او مانند طلوع ماه از وجود موسی می‌تابد."],[220,"مشرقت کردم ز نور ایزدی","من حقم رنجور گشتم نامدی","من از نور پروردگار روشن شدم و به واسطه‌ی او، احساس می‌کنم که درد و رنجی دارم. چرا تو، ای حق، به عیادت من نیامدی؟"],[220,"گفت سبحانا تو پاکی از زیان","این چه رمزست این بکن یا رب بیان","خداوند می‌فرماید: تو ای موسی، از هر آسیب و نقصان دوری و پاک هستی، پس این چه راز و معنایی دارد؟ ای پروردگار، این را برای من توضیح بده."],[220,"باز فرمودش که در رنجوریم","چون نپرسیدی تو از روی کرم","خداوند به موسی می‌گوید: چرا از حال من که در رنج و درد هستم نپرسیدی، در حالی که تو با مهربانی می‌توانستی این کار را انجام دهی؟"],[220,"گفت یا رب نیست نقصانی تو را","عقل گم شد این سخن را برگشا","موسی علیه السلام به خداوند عرضه می‌دارد که تو هیچ کمبودی نداری و در این حالت، عقل من گیج و سرگردان شده است. پس خواهش می‌کند که این موضوع را روشن کنی."],[220,"گفت آری بنده خاص گزین","گشت رنجور، او منم نیکو ببین","خداوند می‌گوید: بله، بنده‌ی خاص من که خاص و برگزیده است، به علت بیماری رنجور شده و او من هستم، پس با دقت نگاه کن."],[220,"هست معذوریش معذوری من","هست رنجوریش رنجوری من","عذرخواهی او از غیبتش بخاطر عذری که دارد، همانند عذر من است و رنج و بیماری او هم مانند رنج و بیماری من است."],[220,"هر که خواهد همنشینی خدا","تا نشیند در حضور اولیا","هر کس که بخواهد با خدا هم‌نشین باشد و از نزدیک شاهد حضور او باشد، باید در کنار اولیای الهی قرار بگیرد و از نور و وجود آن‌ها بهره‌مند شود."],[220,"از حضور اولیا گر بسکلی","تو هلاکی زانک جزوی بی کلی","اگر از حضور اولیا کناره‌گیری کنی، هلاک می‌شوی، زیرا وجود جزئی و فردی تو بدون وجود کلی و همگانی قابل دوام نیست."],[220,"هر که را دیو از کریمان وا برد","بی کسش یابد سرش را او خورد","هر کسی که دیو (شیطان یا وسوسه) او را از جمع کرام (افراد بزرگ و نیکو) منحرف کند، آن شخص در تنهایی خود، به سرنوشت ناگواری دچار می‌شود و سرش (وجودش) از او گرفته می‌شود."],[220,"یک بدست از جمع رفتن یک زمان","مکر دیوست بشنو و نیکو بدان","اگر تو در یک زمان جمعی از خوبان و کریمان را ترک کنی، در حقیقت، دسیسه دیو در کار است؛ این را بشنو و به‌خوبی درک کن."],[221,"باغبانی چون نظر در باغ کرد","دید چون دزدان به باغ خود سه مرد","باغبانی وقتی به باغش نگاه کرد، سه مرد را دید که مانند دزدان در باغ او هستند."],[221,"یک فقیه و یک شریف و صوفی‌ای","هر یکی شوخی بدی، لایوفی‌ای","در این بیت، اشاره به وجود سه شخصیت متفاوت است: یک فقیه (عالمان دینی)، یک شریف (شخص بلندمرتبه و نیک‌خوی) و یک صوفی (عارف)، که هر یک به نوعی بازیگوش و شوخ‌طبع هستند. این تنوع شخصیتی نشان‌دهنده تفاوت‌های بین افراد در جامعه دینی و معنوی است."],[221,"گفت با این‌ها مرا صد حجت است","لیک جمع‌اند و جماعت قوت است","من با این افراد بسیار مبحث و استدلال دارم، اما بودن آن‌ها در کنار هم به قدرت و شدت احساسات می‌افزاید."],[221,"برنیایم یک‌تنه با سه نفر","پس ببرّمشان نخست از همدگر","نمی‌توانم به تنهایی به مقابله با سه نفر بروم، پس باید اول آن‌ها را از هم جدا کنم."],[221,"هر یکی را من به سویی افکنم","چونک تنها شد، سبیلش برکنم","هر یک از آن‌ها را به سمتی می‌افکنم و وقتی که تنهایی خود را احساس کردند، ریششان را خواهم زد."],[221,"حیله کرد و کرد صوفی را به راه","تا کند یارانش را با او تباه","برای صوفی حیله‌ای تدارک دید تا دوستانش را از او جدا کند و به راهی ببرد که به فساد بروند."],[221,"گفت صوفی را: برو سوی وثاق","یک گلیم آور برای این رفاق","صوفی را گفتند که به سمت وثاق (گلیم) برود و یکی از آن‌ها را برای این دوستی و رفاقت با خود بیاورد."],[221,"رفت صوفی، گفت خلوت با دو یار:","تو فقیه‌ای، وین شریف نامدار","صوفی رفت و با دو دوستش که یکی فقیه (عالم دین) و دیگری فردی با شخصیت برجسته است، گفت که در کلام و خلوت به هم بپیوندند."],[221,"ما به فتوی تو نانی می‌خوریم","ما به پرّ دانش تو می‌پریم","ما به نظر و فتوای تو زندگی می‌کنیم و نان می‌خوریم، و به خاطر دانش و علم تو به اوج و مقام می‌رسیم."],[221,"وین دگر شه‌زاده و سلطان ماست","سید است، از خاندان مصطفاست","این شخصی که ما از او صحبت می‌کنیم، یک شاه‌زاده و سلطان است که سید (نژادشریف) بوده و از نسل پیامبر اسلام، حضرت محمد (مصطفی) می‌باشد."],[221,"کیست آن صوفی، شکم‌خوار خسیس","تا بود با چون شما شاهان جلیس؟","این بیت به انتقاد از صوفیانی می‌پردازد که به خاطر خویشکاری معنی‌شان از سیرت و اخلاق‌مداری دور شده‌اند. شاعر به صوفی‌ شکم‌خوار و خسیس اشاره می‌کند که در کنار کسانی همچون شاهان، فاقد فضائل معنوی و اخلاقی است."],[221,"چون بیاید، مر ورا پنبه کنید","هفته‌ای بر باغ و راغ من زنید","وقتی او (باغبان) بیاید، من (شاعر) می‌خواهم شما (دیگران) او را به چالش بکشید و هفته‌ای بر باغ و زمین من مسلط شوید."],[221,"باغ چه بود؟ جان من آن شماست","ای شما بوده مرا چون چشم راست","باغ چیست؟ جان من متعلق به شماست، ای کسانی که برای من مانند چشم راست هستید."],[221,"وسوسه کرد و مر ایشان را فریفت","آه، کز یاران نمی‌باید شکیفت","شیطانی در دل آن‌ها وسوسه کرد و فریبشان داد که از یاران خود نباید دور شوند و بر کنار بایستند."],[221,"چون به ره کردند صوفی را و رفت","خصم شد اندر پیش با چوب زفت","وقتی که صوفی را به راه آوردند، دشمن او در پیش‌روی‌اش با چوب بزرگ ظاهر شد."],[221,"گفت: ای سگ! صوفئی باشد که تیز","اندر آیی باغ ما تو از ستیز؟","گفت: ای سگ! آیا صوفی راستینی وجود دارد که تو با تندی و سرسختی به باغ ما حمله‌ور شوی و مزاحم ما باشی؟"],[221,"این جنیدت ره نمود و بایزید؟","از کدامین شیخ و پیرت این رسید؟","این اشاره به دو شخصیت مهم صوفیانه، جنید و بایزید (بایزید بسطامی) دارد و سوال می‌کند که آموزه‌های تو از کدام یک از این بزرگان یا از چه شیخی به تو رسیده است؟"],[221,"کوفت صوفی را چو تنها یافتش","نیم کشتش کرد و سر بشکافتش","وقتی که صوفی را به تنهایی دید، او را زد و نیمی از وجودش را کشت و سرش را هم شکافت."],[221,"گفت صوفی آن من بگذشت، لیک","ای رفیقان! پاس خود دارید نیک","صوفی می‌گوید: آن که رفته است، دیگر من نیستم، ولی ای دوستان! مراقب خودتان باشید و خوب حفظ کنید."],[221,"مر مرا اغیار دانستید، هان","نیستم اغیارتر زین قلتبان","شما به من بی‌اعتمادید و مرا از خودتان جدا می‌دانید، اما من هیچ‌گاه از این نامردمان کمتر نیستم."],[221,"اینچ من خوردم، شما را خوردنی‌ست","وین چنین شربت جزای هر دنی‌ست","آنچه من نوشیدم، شما نیز باید بنوشید، و این نوع شربت که من دارم، پاداشی است برای هر آنچه در دنیا انجام داده‌ام."],[221,"این جهان کوه است و گفت‌وگوی تو","از صدا هم باز آید سوی تو","این دنیا مانند کوهی است که صدای گفت‌وگوها و اعمال تو به آن برمی‌گردد؛ هرچه در این جهان بگویی یا انجام دهی، نتیجه‌اش به خودت برمی‌گردد."],[221,"چون ز صوفی گشت فارغ باغبان","یک بهانه کرد زان پس جنس آن","وقتی باغبان از صحبت با صوفی فارغ شد، بهانه‌ای آورد و از آن پس به کار خود و نوع خاص فعالیتش پرداخت."],[221,"کای شریف من برو سوی وثاق","که ز بهر چاشت پختم من رقاق","ای شریف! به سوی دیگ بیا، زیرا به خاطر صبحانه، من نان هاشوری (رقاق) پخته‌ام."],[221,"بر در خانه بگو قیماز را","تا بیارد آن رقاق و قاز را","باید در جلوی در خانه به قیماز (خدمتکار) بگویی که آن نان‌های نازک (رقاق) و قاز (نوعی غذا یا خوراکی) را بیاورد."],[221,"چون به ره کردش، بگفت: ای تیزبین","تو فقیه‌ای، ظاهر است این و یقین","چون به راه رفت، گفت: ای شخص زیرک، تو فقیه هستی، این موضوع واضح و مسلم است."],[221,"او شریفی می‌کند دعوی سرد","مادر او را که داند تا که کرد؟","شخصی ادعای شرافت و مقام می‌کند، اما نمی‌داند که مادر او از چه چیزی آگاه است و چه کسی او را معتبر ساخته است."],[221,"بر زن و بر فعل زن دل می‌نهید؟","عقل ناقص وانگهانی اعتمید؟","آیا تو بر زن و رفتار او اصرار می‌ورزی و به او وابسته می‌شوی؟ عقل ناپخته و ناقص چگونه می‌تواند به یکباره اعتماد کند و بر چنین چیزهایی تکیه کند؟"],[221,"خویشتن را بر علی و بر نبی","بسته است اندر زمانه بس غبی","انسان‌هایی که در این دنیا خود را به علی (علی بن ‌ابی‌طالب) و پیامبر بستند، در واقع مثل افرادی نادان و احمق هستند که از زمانه و شرایط جاری غافل‌اند."],[221,"هر که باشد از زنا و زانیان","این برد ظن در حق ربّانیان","هر کسی که به زنا و زانیان مشکوک باشد، به ربّانیان (عباد و بندگان خدا) نیز بدگمان می‌شود."],[221,"هر که برگردد سرش از چرخ‌ها","همچو خود گردنده بیند خانه را","هر کسی که از چرخش دنیا و دگرگونی‌های آن رو بگرداند، مانند خود چرخ گردان، به خانه یا مقصد خود می‌رسد."],[221,"آنچ گفت آن باغبان بوالفضول","حال او بد، دور از اولاد رسول","باغبان بوالفضول (احمق) که سخن می‌گوید، حالش خوب نیست و از نسل پیامبر (رسول خدا) دور است."],[221,"گر نبودی او نتیجه مرتدان","کی چنین گفتی برای خاندان؟","اگر او نتیجه مرتدان (کسانی که به دین اسلام برگشته‌اند) نبود، تو چگونه چنین سخنانی را برای خانواده پیامبر (خاندان) می‌گفتی؟"],[221,"خواند افسون‌ها، شنید آن را فقیه","در پی‌اش رفت آن ستمکار سفیه","فقیه که آدمی دانشمند و مذهبی است، تأثیر افسون‌ها و حرف‌های باغبان صوفی را شنید و به دنبال او رفت. اینجا باغبان به عنوان فردی ستمکار و نادان توصیف شده است."],[221,"گفت: ای خر! اندر این باغت که خواند؟","دزدی از پیغمبرت میراث ماند؟","خر به باغبان می‌گوید: ای مرد! در این باغی که تو داری، چه کسی به تو آموخت؟ آیا دزدی از پیامبر است که به نیابت و وراثت تو باقی مانده؟"],[221,"شیر را بچه همی‌ماند بدو","تو به پیغمبر به چه مانی؟ بگو!","شیر باید به فرزندش بماند و از آن جدا نشود، پس تو ای پیغمبر (که مقام بالایی داری) چرا به کسی دیگر وابسته‌ای؟ بگو چه دلیلی دارد که این‌گونه رفتار می‌کنی؟"],[221,"با شریف آن کرد مرد ملتجی","که کند با آل یاسین خارجی","مرد ملتجی (یعنی آدم حمایت‌خواه) با شریف (یعنی با شخصیت‌های محترم و یاسینی) چه کار می‌کند که (به شیوه‌ای) رفتار می‌کند که شبیه رفتار خارجی‌ها (پیش‌آمده) است."],[221,"تا چه کین دارند دایم دیو و غول","چون یزید و شمر با آل رسول؟","دیو و غول، در اینجا نشانه نیروهای شر و پلید هستند که مانند یزید و شمر با آل رسول، یعنی اهل بیت پیامبر (ص)، دشمنی و کینه دارند. این بیت به نفرت عمیق و همیشگی این دشمنان از کسانی اشاره دارد که در مسیر حق و حقیقت قرار دارند."],[221,"شد شریف از زخم آن ظالم خراب","با فقیه او گفت: ما جستیم از آب","شریف با زخم آن ظالم بدحال شد و با فقیه گفت که ما از آب (و مشکلات) فرار کردیم."],[221,"پای دار اکنون که ماندی فرد و کم","چون دهل شو، زخم می‌خور در شکم","اکنون که تنها و در تنگنا مانده‌ای، مانند دهل شو که درونش فرو می‌رود و زخمی می‌شود، تا از این درد و زخم‌ها توبه و اصلاحی در خود پیدا کنی."],[221,"گر شریف و لایق و همدم نیم","از چنین ظالم تو را من کم نیم","اگر تو شریف و شایسته و همدم نباشی، من از چنین ظالمی کم ندارم."],[221,"مر مرا دادی بدین صاحب غرض","احمقی کردی تو را بئس العوض","تو به من چنین شخصی با مقاصد بد را دادی و انتخاب تو، انتخاب بسیار بدی بوده است."],[221,"شد از او فارغ، بیامد کای فقیه","چه فقیه‌ای، ای تو ننگ هر سفیه؟","او (فقیه) از آن شخص (باغبان) بی‌نیاز شد و آمد تا بگوید: ای فقیه، چه فقیهی هستی تو که ننگ هر نادانی (سفیه) به حساب می‌آیی؟"],[221,"فتوی‌ات این است ای ببریده‌دست؟","کاندر آیی و نگویی امر هست؟","فتوای تو این است که تو هیچ‌گاه از این موضوع به روشنی سخن نمی‌گویی و به بیان مستقیم و واضح نمی‌پردازی، بلکه با کلامی مبهم و غیرشفاف نظر خود را ابراز می‌کنی؟"],[221,"این چنین رخصت بخواندی در وسیط؟","یا بدست این مساله اندر محیط؟","آیا تو چنین اجازه‌ای به این مسأله در جایی وسیع دادی؟ یا اینکه این موضوع در محیط خاصی بوده و به دست تو نمی‌رسد؟"],[221,"گفت حق استت، بزن، دستت رسید","این سزای آنک از یاران برید","خداوند حق، به تو اجازه می‌دهد که به خواسته‌ات بپردازی؛ زیرا این جزای کسی است که از دوستان و یاران خود جدا شده است."],[222,"این عیادت از برای این صله‌ست","وین صله از صد محبت حامله‌ست","این عیادت به خاطر پیوندها و روابط است و این پیوندها سرشار از محبت و عشق هستند."],[222,"در عیادت شد رسول بی ندید","آن صحابی را بحال نزع دید","در عیادت پیامبر، آن صحابی (دوست یا یار) را در حال مرگ مشاهده کرد و او را در این وضعیت نگران‌کننده دید."],[222,"چون شوی دور از حضور اولیا","در حقیقت گشته‌ای دور از خدا","هرگاه از وجود اولیا و دوستان خدا دور شوی، در واقع از حقیقت الهی و نزدیکیت به خدا نیز دور شده‌ای."],[222,"چون نتیجه هجر همراهان غمست","کی فراق روی شاهان زان کمست","سختی دوری از همراهان باعث غم و اندوه است، پس کی می‌توان انتظار داشت که فراق یا جدایی از چهره‌های بزرگ و شاهان، کم و سبک باشد؟"],[222,"سایه شاهان طلب هر دم شتاب","تا شوی زان سایه بهتر ز آفتاب","برای اینکه از سایه پادشاهان بهره‌مند شوی، هر لحظه باید شتاب کنی تا به پیش آن سایه برسیدی که از نور آفتاب نیز برتر است."],[222,"گر سفر داری بدین نیت برو","ور حضر باشد ازین غافل مشو","اگر قصد سفر داری با نیت درست برو، و اگر در مکانی ثابت هستی، از این مهم غافل نشو."],[223,"سوی مکه شیخ امت بایزید","از برای حج و عمره می‌دوید","شیخ ابویزید، پیشوای طریقت، به سمت مکه می‌دوید تا مناسک حج و عمره را انجام دهد."],[223,"او به هر شهری که رفتی از نخست","مر عزیزان را بکردی بازجست","هرگاه بایزید به شهری می‌رفت، ابتدا از عزیزان و نزدیکانش می‌خواست که آنها را بیابد و به جستجویشان می‌پرداخت."],[223,"گرد می‌گشتی که اندر شهر کیست","کو بر ارکان بصیرت متکیست","در هر شهری که می‌گردی، باید بگردی ببینی آن شخصی که به درک و بصیرت واقعی دست یافته، کیست."],[223,"گفت حق اندر سفر هر جا روی","باید اول طالب مردی شوی","حق (خدا) فرمود که در سفر، هر جا که می‌روی، باید ابتدا متقاضی و جویای مردان بزرگ و صاحبان معرفت شوی."],[223,"قصد گنجی کن که این سود و زیان","در تبع آید تو آن را فرع دان","به دنبال گنج و هدفی بزرگ باش، زیرا در این صورت، منافع و زیان‌ها به‌طور طبیعی به دنبالت خواهند آمد؛ این منافع جانبی هستند و اصلی نیستند."],[223,"هر که کارد قصد گندم باشدش","کاه خود اندر تبع می‌آیدش","هدف اصلي از کشت و کار گندم است و کسي که کشت مي کند به هدف برداشت گندم کشت مي کند. کاه محصول جانبي است که همراه گندم برداشت مي شود."],[223,"که بکاری بر نیاید گندمی","مردمی جو مردمی جو مردمی","اگر کاه بکاری ، مسلما گندم بدست نخواهی آورد . پس خواهان یافتن مرد حق باش . مرد حق ، مرد حق را بطلب ."],[223,"قصد کعبه کن چو وقت حج بود","چونک رفتی مکه هم دیده شود","به نظر میرسد که Ai را در ترجمه معانی اشعار فعلا باید کنار گذاشت. ترجمه این قسمت از شعر این نیست که به مکه برو، کعبه را هم خواهی دید بلکه اینست که به کعبه برو ، مکه را هم به تبع ان خواهی دید. شاعر در اینجا یکی از راهکارهای رسیدن به اگاهی را نیز بیان میکند"],[223,"قصد در معراج دید دوست بود","درتبع عرش و ملایک هم نمود","در مسیر معراج، هدف دیدن دوست (خداوند) بود که در دروازه عرش و جلوه‌های فرشتگان نیز نمایان شد."],[224,"خانه‌ای نو ساخت روزی نو مرید","پیر آمد خانه او را بدید","نو مرید، که تازه شاگرد شیخ شده است، روزی خانه‌ای جدید ساخته و برای اولین بار آن را به شیخ نشان می‌دهد."],[224,"گفت شیخ آن نو مرید خویش را","امتحان کرد آن نکو اندیش را","شیخ (پیر) به مرید نو خود گفت تا او را بیازماید و عقل و دقت نظر او را مورد سنجش قرار دهد."],[224,"روزن از بهر چه کردی ای رفیق","گفت تا نور اندر آید زین طریق","رفیق، چرا روزن را باز کردی؟ او پاسخ می‌دهد که این کار را انجام دادم تا نور از این طریق به داخل بیاید."],[224,"گفت آن فرعست این باید نیاز","تا ازین ره بشنوی بانگ نماز","فرعست (فردی در مقام سوال) گفت که برای نیاز باید به این راه رفت تا صدای نماز را بشنوی."],[224,"بایزید اندر سفر جستی بسی","تا بیابد خضر وقت خود کسی","بایزید در سفر خود بسیار جستجو می‌کند تا شخص خضر، که نماد معرفت و wisdom است، را در زمان مناسب بیابد."],[224,"دید پیری با قدی همچون هلال","دید در وی فر و گفتار رجال","بایزید (بایزید بسطامی، عارفی بزرگ) در سفر، پیرمردی را می‌بیند که مانند هلال زیبایی دارد و به او توجه می‌کند چون در او صفات بزرگواران و ویژگی‌های سخن‌وری دیده می‌شود."],[224,"دیده نابینا و دل چون آفتاب","همچو پیلی دیده هندستان به خواب","چشم نابینا و دل پرنور و روشن مانند آفتاب است، ولی مانند فیل خواب‌آلوده دیده‌ها و احساساتش به خواب رفته و غافل است."],[224,"چشم بسته خفته بیند صد طرب","چون گشاید آن نبیند ای عجب","انسانی که چشمش بسته و در خواب است، می‌تواند در خواب شادی‌ها و لذت‌های زیادی را ببیند، ولی وقتی چشمش را باز می‌کند، دیگر آن‌ها را نمی‌بیند و این واقعیت بسیار عجیب است."],[224,"بس عجب در خواب روشن می‌شود","دل درون خواب روزن می‌شود","درخواب دیده‌ها باز و دل روشن می‌شود و آدمی در خواب به حقایق و معانی عمیق‌تری دست می‌یابد."],[224,"آنک بیدارست و بیند خواب خوش","عارفست او خاک او در دیده‌کش","کسی که در بیداری خواب‌های خوشی می‌بیند، عارف است و آنچنان بزرگ و محترم است که وجود او مانند خاکش در نظر دیگران ارزشمند است."],[224,"پیش او بنشست و می‌پرسید حال","یافتش درویش و هم صاحب‌عیال","پیش بایزید، او (در ویلت) نشسته و حال آن درویش و صاحب عیالش (کسی که خانواده دارد) را می‌پرسید."],[224,"گفت عزم تو کجا ای بایزید","رخت غربت را کجا خواهی کشید","سخن از بایزید است که از او می‌پرسند عزم رفتن به کجا دارد و این که بار سفرش را برای دوری از وطن کجا می‌خواهد ببرد."],[224,"گفت قصد کعبه دارم از پگه","گفت هین با خود چه داری زاد ره","بایزید می‌گوید که قصد سفر به کعبه را دارم. همراه با این سفر، از خود می‌پرسد که چه توشه یا توانی برای این مسیر دارم."],[224,"گفت دارم از درم نقره دویست","نک ببسته سخت بر گوشه ردیست","گفت که من دوصد درم نقره دارم و این پول را محکم در گوشه‌ی عبا یا کیف خود گذاشته‌ام."],[224,"گفت طوفی کن بگردم هفت بار","وین نکوتر از طواف حج شمار","گفت اگر هفت بار دور این در بچرخم، این کار از طواف حج هم بهتر است."],[224,"و آن درمها پیش من نه ای جواد","دان که حج کردی و حاصل شد مراد","تو ای جواد (شخصی که در حال صحبت است)، بدان که این درم‌های (پول‌ها) که در پیش من است، خیر و خوبی نیست؛ چرا که تو طواف حج را انجام دادی و به هدف و خواسته‌ات رسیدی."],[224,"عمره کردی عمر باقی یافتی","صاف گشتی بر صفا بشتافتی","عمره (سفر کوچک به مکه) را انجام دادی و از این بابت به زندگی باطنی و روحانی دست یافتی. با تلاش در مسیر پاکی و خلوص، به یک حالت صفای درونی رسیدی و به سوی آن بشتافتیدی."],[224,"حق آن حقی که جانت دیده است","که مرا بر بیت خود بگزیده است","حق، حقیقتی است که جانت آن را درک کرده و به همین دلیل مرا به عنوان مکانی برای خود انتخاب کرده است."],[224,"کعبه هرچندی که خانه بر اوست","خلقت من نیز خانه سر اوست","کعبه، هرچند خانه‌ای است برای او، اما حقیقت این است که وجود من نیز خانه‌ای برای ذات او است."],[224,"تا بکرد آن خانه را در وی نرفت","واندرین خانه به جز آن حی نرفت","خداوند آن خانه (کعبه) را ساخته است، اما در آن خانه (شکل و صورت) خداوند قرار ندارد. در حقیقت، جز ذات پایدار و زنده او، هیچ چیز دیگری در آن‌جا نمی‌تواند وجود داشته باشد."],[224,"چون مرا دیدی خدا را دیده‌ای","گرد کعبه صدق بر گردیده‌ای","اگر مرا ببینی، به حقیقت خدا را دیده‌ای و دور کعبه صدق، که نماد حقایق است، گشته‌ای."],[224,"خدمت من طاعت و حمد خداست","تا نپنداری که حق از من جداست","خدمت من، در واقع اطاعت و ستایش خداوند است، تا این گمان را نکنی که حق از من جداست و من مستقل از او هستم."],[224,"چشم نیکو باز کن در من نگر","تا ببینی نور حق اندر بشر","چشمانت را خوب باز کن و به درون من نگاه کن تا نور خدا را در وجود انسان ببینی."],[224,"بایزید آن نکته‌ها را هوش داشت","همچو زرین حلقه‌اش در گوش داشت","بایزید (بایزید بسطامی، عارف بزرگ) این نکات و اسرار را به خوبی درک کرده بود، مانند اینکه گوش او زینت دارد به حلقه‌ای زرین."],[224,"آمد از وی بایزید اندر مزید","منتهی در منتها آخر رسید","بایزید از سوی خدای متعال به کمالاتی رسید و در نهایت، به اوج مقام و معرفت خود دست یافت."],[225,"چون پیمبر دید آن بیمار را","خوش نوازش کرد یار غار را","وقتی پیامبر (ص) آن بیمار را دید، به او توجه و محبت زیادی نشان داد و او را مورد نوازش قرار داد."],[225,"زنده شد او چون پیمبر را بدید","گوییا آن دم مر او را آفرید","خودش را به حالت زنده‌ای می‌بیند که نبی (پیامبر) را دیده است، گویی در همان لحظه، او دوباره به وجود آمده است."],[225,"گفت بیماری مرا این بخت داد","کآمد این سلطان بر من بامداد","بیماری من ناشی از این بخت است که این پادشاه (پیامبر) در این صبح بر من آمد."],[225,"تا مرا صحت رسید و عافیت","از قدوم این شه بی حاشیت","با آمدن این سلطان بی‌نظیر، سلامتی و بهبودی به من رسید و عافیت پیدا کردم."],[225,"ای خجسته رنج و بیماری و تب","ای مبارک درد و بیداری شب","ای رنج و بیماری و تب که خوش‌آمدید، ای درد مبارک که مرا در شب بیدار می‌کند."],[225,"نک مرا در پیری از لطف و کرم","حق چنین رنجوریی داد و سقم","چرا خداوند در پیری به من این چنین رنجوری و بیماری عطا کرده است، در حالی که همواره از لطف و کرم او بهره‌مند بوده‌ام؟"],[225,"درد پشتم داد هم تا من ز خواب","بر جهم هر نیمشب لا بد شتاب","خداوند به من درد در کمرم داده تا من از خواب بیدار شوم و هر شب ناچار باشم که سریعا به کارهایم بپردازم."],[225,"تا نخسپم جمله شب چون گاومیش","دردها بخشید حق از لطف خویش","خداوند به من از روی لطفش دردها و رنج‌ها را می‌دهد تا اینکه شب‌ها به خواب نروم و مانند گاومیش که در شب نمی‌خوابد، بیدار بمانم."],[225,"زین شکست آن رحم شاهان جوش کرد","دوزخ از تهدید من خاموش کرد","از این شکستگی و نقص من، خداوند رحم خود را به من عطا کرد و جهنم را با تهدید خود از من دور ساخت و دیگر هرگز خاموش نمی‌مانم."],[225,"رنج گنج آمد که رحمتها دروست","مغز تازه شد چو بخراشید پوست","رنج و سختی باعث می‌شود که نعمت‌ها و رحمت‌های بیشتری به دست آید. همان‌طور که وقتی پوست خراشیده می‌شود، مغز تازه و بهتر عمل می‌کند."],[225,"ای برادر موضع تاریک و سرد","صبر کردن بر غم و سستی و درد","ای برادر، در مشکلات و سختی‌ها مانند تاریکی و سرما صبر کن، حتی اگر با غم و ضعف و درد روبه‌رو هستی."],[225,"چشمه حیوان و جام مستی است","کان بلندیها همه در پستی است","چشمه حیات و منبع شیرینی زندگی، مثل جامی است که انسان را به شادی و بی‌خیالی می‌کشاند و در واقع، تمام برتری‌ها و اوج‌ها در خود را از پایین‌ترین نقاط و آغازها به دست می‌آورند."],[225,"آن بهاران مضمرست اندر خزان","در بهارست آن خزان مگریز از آن","خزان در واقع در بهار پنهان است و نباید از آن دوری کرد، زیرا این خزان جزء واقعیت بهار است و نشان‌دهنده چرخه طبیعی زندگی است."],[225,"همره غم باش و با وحشت بساز","می‌طلب در مرگ خود عمر دراز","با غم و اندوه همراه باش و سعی کن با ترس و وحشت کنار بیایی. در زندگی خود به دنبال کسب عمر طولانی نباش، بلکه به مرگ خود فکر کن."],[225,"آنچ گوید نفس تو کاینجا بدست","مشنوش چون کار او ضد آمدست","نفس انسان به او می‌گوید که در این عالم به کارهایی بپردازد، اما نباید به این حرف گوش دهد، زیرا چنین کارهایی مخالف خواسته و دستور الهی است."],[225,"تو خلافش کن که از پیغامبران","این چنین آمد وصیت در جهان","برخلاف دستور نفس خود عمل کن، زیرا پیامبران همیشه به مردم توصیه کرده‌اند که چنین کنند."],[225,"مشورت در کارها واجب شود","تا پشیمانی در آخر کم بود","در کارهای خود باید با یکدیگر مشورت کنیم، تا از پشیمانی و ندامت در آینده کمتر رنج ببریم."],[225,"حیله‌ها کردند بسیار انبیا","تا که گردان شد برین سنگ آسیا","انبیا تدابیر و ترفندهای زیادی به کار بستند تا این سنگ آسیا (که نماد انسان و جامعه است) به حرکت درآید و به گردش درآید."],[225,"نفس می‌خواهد که تا ویران کند","خلق را گمراه و سرگردان کند","نفس، تمایل دارد که انسان‌ها را از مسیر درست خارج کرده و آنان را گمراه و سرگردان کند."],[225,"گفت امت مشورت با کی کنیم","انبیا گفتند با عقل امیم","حضرت محمد (پیغمبر) فرمودند که امت باید با چه کسی مشورت کنند و انبیا (پیامبران) پاسخ دادند که مشورت باید با عقل باشد."],[225,"گفت گر کودک در آید یا زنی","کو ندارد عقل و رای روشنی","اگر کودک یا زنی بی‌عقل و بدون رای روشنی وارد شود، نباید از او مشورت کرد."],[225,"گفت با او مشورت کن وانچ گفت","تو خلاف آن کن و در راه افت","به او بگو که در کارها با دیگران مشورت کند، اما هرچه آنها گفتند، بر خلاف آن عمل کند و به راه خود ادامه دهد."],[225,"نفس خود را زن شناس از زن بتر","زانک زن جزویست نفست کل شر","نفس خود را مانند زن بشناس، زیرا که نفس انسانی جزئی از ذات انسان است و تمام شرارت‌ها در آن وجود دارد."],[225,"مشورت با نفس خود گر می‌کنی","هرچه گوید کن خلاف آن دنی","اگر با نفس خود مشورت می‌کنی، هر آنچه که به تو می‌گوید، برعکس آن عمل کن تا از آسیب آن در امان بمانی."],[225,"گر نماز و روزه می‌فرمایدت","نفس مکارست مکری زایدت","اگر نفس تو به تو می‌گوید که نماز و روزه بخوان، بدان که این نفس فریبکار است و از فریب او تو را به عمل واداشته است."],[225,"مشورت با نفس خویش اندر فعال","هرچه گوید عکس آن باشد کمال","با نفس خود مشورت نکن، زیرا هرچه او بگوید، نتیجه‌اش مخالف کمال و بهبود وضع تو خواهد بود."],[225,"برنیایی با وی و استیز او","رو بر یاری بگیر آمیز او","با او صحبت کن و کارهایش را مورد انتقاد قرار بده و در مشکلاتش از کسی که به تو کمک می‌کند، یاری بجوی."],[225,"عقل قوت گیرد از عقل دگر","نیشکر کامل شود از نیشکر","عقل، با تأثیر گرفتن از عقل دیگر، قوی‌تر می‌شود؛ همان‌طور که نیشکر با افزایش گرفتن از نیشکر دیگر، کامل‌تر و شیرین‌تر می‌شود."],[225,"من ز مکر نفس دیدم چیزها","کو برد از سحر خود تمییزها","من از فریب و نیرنگ نفس خود، چیزهایی را دیدم که از جادو و سحر آن قادر به تشخیص آن‌ها نیستم."],[225,"وعده‌ها بدهد تو را تازه به دست","که هزاران بار آنها را شکست","نفس انسان وعده‌هایی به او می‌دهد که هر بار جذاب و نو به نظر می‌رسند، اما این وعده‌ها بارها شکسته می‌شوند."],[225,"عمر اگر صد سال خود مهلت دهد","اوت هر روزی بهانه نو نهد","اگر عمر انسان صد سال هم باشد، هر روز بهانه‌ای جدید برای زندگی و شروع دوباره به او می‌دهد."],[225,"گرم گوید وعده‌های سرد را","جادوی مردی ببندد مرد را","اگر مردی با جادو یا فریب خود وعده‌هایی را به کسی بدهد که در حقیقت غیرعملی و بی‌فایده هستند، آن مرد، به خاطر این وعده‌های دروغین، به زحمت می‌افتد."],[225,"ای ضیاء الحق حسام الدین بیا","که نروید بی تو از شوره گیا","ای نور حقیقت، حسام‌الدین، بیا که بدون تو گیاهان شوره‌زار نمی‌رویند."],[225,"از فلک آویخته شد پرده‌ای","از پی نفرین دل آزرده‌ای","پرده‌ای از آسمان به نشانه نفرین و ناراحتی کسی است که دلش شکسته و آزرده شده است، به ویژه به خاطر گستاخی و طلب دعا."],[225,"این قضا را هم قضا داند علیج","عقل خلقان در قضا گیجست گیج","این قضا (سرنوشت) هم خود سرنوشت (قضا) می‌داند که عقل انسان‌ها در فهم آن سرنوشت سردرگم و گیج است."],[225,"اژدها گشتست آن مار سیاه","آنک کرمی بود افتاده به راه","این بیت بیان می‌کند که آن مار سیاه که در ابتدا به نظر می‌رسید یک کرم ساده است، در حقیقت به اژدها تبدیل شده است. این تغییر به نمادگرایی از موضوعی اشاره دارد که چیزی کوچک و کم‌اهمیت می‌تواند به یک خطر بزرگ و تهدیدآمیز تبدیل شود."],[225,"اژدها و مار اندر دست تو","شد عصا ای جان موسی مست تو","ای جان موسی، عصایی که در دست توست، تبدیل به اژدها و مار شده است. تو مانند موسی، قدرتی داری که می‌تواند یک چیز عادی را به قدرتی معجزه‌آسا تبدیل کند."],[225,"حکم خذها لا تخف دادت خدا","تا به دستت اژدها گردد عصا","خدا به تو فرمان داد که ترسی نداشته باش و بگیر این عصا را؛ بگذار که به دست تو مانند اژدها شود."],[225,"هین ید بیضا نما ای پادشاه","صبح نو بگشا ز شبهای سیاه","ای شاه، به یاد آور که دستت مانند دست موسی (ید بیضا) نورانی و شگفت‌انگیز است. صبح نو را به ظهور برسان و شب‌های تاریک را بزدای."],[225,"دوزخی افروخت بر وی دم فسون","ای دم تو از دم دریا فزون","دوزخی به خاطر جادو و فریبی که زده شده، بر او شعله‌ور شده است. ای دم تو (دعا یا کلام تو) از دم دریا (آب دریا که مثالی برای برکت و زندگی است) قوی‌تر و اثرگذارتر است."],[225,"بحر مکارست بنموده کفی","دوزخست از مکر بنموده تفی","دریای فریب و حیله، بسان دوستی است که در ظاهر می‌نماید، اما در باطن آتش دوزخ را به تصویر می‌کشد. این دروغ و فریب به نوعی می‌تواند به شکل تنفسی (تفی) خطرناک و کشنده ظاهر شود."],[225,"زان نماید مختصر در چشم تو","تا زبون بینیش جنبد خشم تو","او نشان داده که چگونه چیزهای کوچک در نظر تو بزرگ به نظر می‌رسند، تا اینکه خشم تو به خاطر نگاه حقیر از آن‌ها به جوش بیاید."],[225,"همچنانک لشکر انبوه بود","مر پیمبر را به چشم اندک نمود","هرچند لشکر دشمن بسیار زیاد و انبوه بود، اما پیغمبر (محمد) آن را در نظر اندکی دید و کوچک شمرد."],[225,"تا بریشان زد پیمبر بی خطر","ور فزون دیدی از آن کردی حذر","پیامبر (علیه السلام) با بی‌خطر زدن به آن افراد (دشمنان) نشان داد که هرچند آنها شمار فراوانی دارند، اما تو باید از آنها بپرهیزی و احتیاط کنی."],[225,"آن عنایت بود و اهل آن بدی","احمدا ورنه تو بد دل می‌شدی","این لطف و رحمت الهی برای پیامبر (محمد) بود و اگر چنین نبود، تو نیز به دل‌سوزی دچار می‌شدی و نمی‌توانستی او را عیب‌جویی کنی."],[225,"کم نمود او را و اصحاب ورا","آن جهاد ظاهر و باطن خدا","او و یارانش را در جهاد ظاهری و باطنی خدا کم کرد، به این معنا که در تنگناها و سختی‌ها خداوند بر آن‌ها سخت گرفت."],[225,"تا میسر کرد یسری را برو","تا ز عسری او بگردانید رو","خداوند برای کسی که به او آسانی (یسری) می‌دهد، راه آسانی فراهم می‌کند و در عوض، کسی که در سختی (عسری) است، او را از آن گرفتار می‌سازد و به سمت راحتی سوق می‌دهد."],[225,"کم نمودن مر ورا پیروز بود","که حقش یار و طریق‌آموز بود","کاهش دادن قدرت و پیروزی او به دلیل این است که خداوند یار و راهنمای او بوده است."],[225,"آنک حق پشتش نباشد از ظفر","وای اگر گربه‌ش نماید شیر نر","کسی که از حمایت حق بی‌بهره باشد، در پیروزی ناکام خواهد ماند. اگر گربه، در برابر او خود را به شکل شیر نر نشان دهد، باز هم قدرتی ندارد و در واقع، ناتوان است."],[225,"وای اگر صد را یکی بیند ز دور","تا به چالش اندر آید از غرور","اگر کسی توانایی‌هایش را به اشتباه و به طور مبالغه‌آمیز ببیند، همان‌طور که در دور از حقیقت به خود می‌بالد، ممکن است باعث چالش و دردسر برای خود شود."],[225,"زان نماید ذوالفقاری حربه‌ای","زان نماید شیر نر چون گربه‌ای","از آن رو، شمشیر ذوالفقار (شمشیر امام علی) مانند یک ابزار جنگی عمل می‌کند و همچنین شیر نر، که نماد قدرت و شجاعت است، به اندازه‌ای ضعیف و بی‌فایده می‌شود که همچون یک گربه به نظر می‌رسد."],[225,"تا دلیر اندر فتد احمق به جنگ","واندر آردشان بدین حیلت به چنگ","وقتی که احمق‌ها به جنگ می‌آیند، دلیران از این فرصت استفاده می‌کنند و با تدبیر و فریب، آن‌ها را به دام می‌اندازند."],[225,"تا به پای خویش باشند آمده","آن فلیوان جانب آتشکده","تا پای خود ایستاده‌اند، فیل‌ها به سمت آتشکده آمده‌اند."],[225,"کاه برگی می‌نماید تا تو زود","پف کنی کو را برانی از وجود","اگر کسی برای تو بی‌اهمیت و کوچک به نظر برسد، باید سریعا از او دور شوی و از وجودش رهایی یابی، چون ممکن است به زودی او تبدیل به مشکلات بزرگ‌تری برایت شود."],[225,"هین که آن که کوهها بر کنده است","زو جهان گریان و او در خنده است","بجنگ که آن کسی که کوه‌ها را از جا کنده و به زعم او زمین را می‌لرزاند، خود در حال شادی و خنده است و به نظر نمی‌رسد تحت تأثیر گرفتاری‌ها و رنج‌های جهان باشد."],[225,"می‌نماید تا بکعب این آب جو","صد چو عاج ابن عنق شد غرق او","این آب جو (آب زلال و صاف) مانند صد قطعه عاج بر روی کعبه (مکانی مقدس در مکه) ظاهر می‌شود، و کسی که در آن غرق شده، به اندازه یک باریکه، کمتر از ابن عنق (موجود افسانه‌ای غول‌پیکر) نیست."],[225,"می‌نماید موج خونش تل مشک","می‌نماید قعر دریا خاک خشک","موج خون او همچون عطر مشک به مشام می‌رسد، در حالی که قعر دریا خشک و بی‌آب به نظر می‌آید."],[225,"خشک دید آن بحر را فرعون کور","تا درو راند از سر مردی و زور","فرعون که کور بود، آن دریا را خشک می‌پنداشت و به همین دلیل از روی نادانی، مردی را به زور از سر راه خود برمی‌داشت."],[225,"چون در آید در تک دریا بود","دیده فرعون کی بینا بود","وقتی فرعون در دریا قرار گرفت، او نمی‌توانست ببیند که آیا دریا هست یا نه؛ چون بینا نبود و درک درستی از حقیقت نداشت."],[225,"دیده بینا از لقای حق شود","حق کجا همراز هر احمق شود","چشم بینا از ملاقات با حقیقت به حق دست می‌یابد، ولی حقیقت در پی گفت‌وگو با احمق‌ها نیست."],[225,"قند بیند خود شود زهر قتول","راه بیند خود بود آن بانگ غول","چون قند، اگر به خودی خود ببیند، تبدیل به زهر می‌شود، پس فردی که در مسیر حق قرار ندارد، بی‌خبری و نادانی او را به مصیبت می‌اندازد و صدای غول مانند آزارش می‌رساند."],[225,"ای فلک در فتنه آخر زمان","تیز می‌گردی بده آخر زمان","ای آسمان، در زمان آخرالزمان دچار فتنه و آشفتگی می‌شوی و تندتر می‌گردی؛ پس ای آسمان، در این زمان، به ما همگامی کن."],[225,"خنجر تیزی تو اندر قصد ما","نیش زهرآلوده‌ای در فصد ما","خنجر تیز تو به سمت ما نشانه رنج و آزار است و نیش تو زهرآلود، به سوی ما در حال ضربه زدن است."],[225,"ای فلک از رحم حق آموز رحم","بر دل موران مزن چون مار زخم","ای فلک، از رحم و لطف خدا یاد بگیر و بر دل مورچه‌ها رحم کن و مانند ماری زخم نزن."],[225,"حق آنک چرخه چرخ تو را","کرد گردان بر فراز این سرا","خداوند به تو اجازه داده که در این دنیا به گردش درآیی و بر فراز این جهان قرار گیری."],[225,"که دگرگون گردی و رحمت کنی","پیش از آن که بیخ ما را بر کنی","تلاش کن که قبل از این که ریشه ما را از زمین بکندی، تغییر کنی و به ما رحمت کنی."],[225,"حق آنک دایگی کردی نخست","تا نهال ما ز آب و خاک رست","خداوند تو را به خاطر پرورش و تربیت ما، مانند مادری دلسوز، استفاده کرده است تا نهال وجود ما از آب و خاک رشد کند."],[225,"حق آن شه که تو را صاف آفرید","کرد چندان مشعله در تو پدید","خدای بزرگ که تو را به نیکی و بی‌نقص خلق کرد، به اندازه‌ای شعله‌های عشق و نوری در وجود تو به‌وجود آورد که هرگز خاموش نمی‌شود."],[225,"آنچنان معمور و باقی داشتت","تا که دهری از ازل پنداشتت","تو به قدری پر رونق و پایدار آفریده شدی که حتی از نخستین روزهای آفرینش، زمان برایت گمان کرد که همیشه خواهی بود."],[225,"شکر دانستیم آغاز تو را","انبیا گفتند آن راز تو را","ما شکرگزاریم که آغاز تو، یعنی پیامبر اسلام، را شناختیم. پیامبران پیشین نیز آن راز و حقیقت تو را مطرح کرده‌اند."],[225,"آدمی داند که خانه حادثست","عنکبوتی نه که در وی عابثست","انسان می‌داند که خانه‌ای که در آن زندگی می‌کند، موقتی و زودگذر است و مانند عنکبوتی نیست که تنها به خاطر خود در آن جا بماند."],[225,"پشه کی داند که این باغ از کی‌ست","کو بهاران زاد و مرگش در دی‌ست","پشه‌ای که در این باغ زندگی می‌کند، نمی‌داند که این باغ متعلق به چه کسی است و در بهار به دنیا آمده و در زمستان می‌میرد."],[225,"کرم کاندر چوب زاید سست‌حال","کی بداند چوب را وقت نهال","کرم که در چوب زندگی می‌کند و ضعیف و ناتوان است، چه می‌داند که چوب در زمان جوانه زدن چه حالتی دارد."],[225,"ور بداند کرم از ماهیتش","عقل باشد کرم باشد صورتش","اگر کرم بداند که ماهیت چیست، آنوقت عقل او خواهد شد و در واقع به صورت کرم باقی می‌ماند."],[225,"عقل خود را می‌نماید رنگها","چون پری دورست از آن فرسنگها","عقل خود را با رنگ‌ها و صورت‌های مختلف نشان می‌دهد، اما مانند پری است که از دور به نظر می‌رسد و در واقع فاصله‌اش زیاد است."],[225,"از ملک بالاست چه جای پری","تو مگس‌پری بپستی می‌پری","تویی که از مقام‌های بلند و عالی هستی، چه جایی برای کثیفی و پستی مانند مگس‌پری وجود دارد، تو باید به قله‌های بلند و پاکی پرواز کنی."],[225,"گرچه عقلت سوی بالا می‌پرد","مرغ تقلیدت بپستی می‌چرد","هرچند که هوش و فکر تو به سمت عالم بالا پرواز می‌کند، اما عقل تقلیدی تو مانند مگس در هر جا می‌چرخد و نمی‌تواند به اوج برسد."],[225,"علم تقلیدی وبال جان ماست","عاریه‌ست و ما نشسته کان ماست","علمی که از دیگران گرفته‌ایم و به اصطلاح تقلیدی است، برای ما زحمت و عذاب به بار می‌آورد. این دانش شبیه یک عاریه است که تنها از آن استفاده می‌کنیم و خودمان آن را نداشته و درک نکرده‌ایم."],[225,"زین خرد جاهل همی باید شدن","دست در دیوانگی باید زدن","از این خرد نادانی باید دوری کرد و در دیوانگی و بی‌خودی نباید فرو رفت."],[225,"هرچه بینی سود خود زان می‌گریز","زهر نوش و آب حیوان را بریز","هر چیزی را که به نفع خود می‌بینی، از آن دوری کن، مانند زهر که مضر است و باید آب حیات را هم دور ریخت."],[225,"هر که بستاید تو را دشنام ده","سود و سرمایه به مفلس وام ده","هرکسی که تو را ستایش کند، به او دشنام بده و به آدم بی‌پول و بی‌چاره وام بده."],[225,"ایمنی بگذار و جای خوف باش","بگذر از ناموس و رسوا باش و فاش","از ایمنی و امنیت دست بکش و به جایی برو که با ترس مواجه شوی. از اصول و قواعد اخلاقی فاصله بگیر و به طور علنی و بی‌پرده با مسائل یا عیوب خود مواجه شو."],[225,"آزمودم عقل دور اندیش را","بعد ازین دیوانه سازم خویش را","من تجربه کردم که عقل دوراندیش و هوشمند، در مواجهه با مسائلی که پیش می‌آید، چه کرده و اکنون تصمیم دارم خود را دیوانه و بی‌دغدغه سازم."],[226,"گفت با دلقک شبی سید اجل","قحبه‌ای را خواستی تو از عجل","سید اجل به دلقک گفت که آیا تو می‌خواهی با زن بدکار (فاحشه) ازدواج کنی، در حالی که این کار شتاب‌زده به نظر می‌رسد؟"],[226,"با من این را باز می‌بایست گفت","تا یکی مستور کردیمیت جفت","این باید با من در میان گذاشته می‌شد تا ما یکی را پوشیده و مستور کنیم که شایسته باشد."],[226,"گفت نه مستور صالح خواستم","قحبه گشتند و ز غم تن کاستم","گفت نه، من نمی‌خواستم آن چیز پوشیده و نیکو را؛ بلکه آن فاحشه انتخاب کردم و از غم و اندوه بدنم کاسته شد."],[226,"خواستم این قحبه را بی معرفت","تا ببینم چون شود این عاقبت","خواستار بودم که این فاحشه را بدون شناخت و معرفت انتخاب کنم تا ببینم چگونه به این عاقبت دچار می‌شود."],[226,"عقل را من آزمودم هم بسی","زین سپس جویم جنون را مغرسی","من عقل را بسیار آزموده‌ام و حالا به دنبال جنون می‌روم؛ مانند گاری‌چران."],[227,"آن یکی می‌گفت خواهم عاقلی","مشورت آرم بدو در مشکلی","یکی از افراد می‌گفت که می‌خواهم با عاقل‌تری مشورت کنم تا در مشکلی کمک بگیرم."],[227,"آن یکی گفتش که اندر شهر ما","نیست عاقل جز که آن مجنون‌نما","او گفت در شهر ما هیچ عاقلی نیست جز آن فردی که خود را مثل مجنون نشان داده است."],[227,"بر نیی گشته سواره نک فلان","می‌دواند در میان کودکان","در این بیت، شخصی در حال سوار بر نی است و در بین بچه‌ها مانند فردی دیوانه می‌دود و می‌چرخد. این تصویر نشان‌دهنده رفتار غیرعادی و پارادوکسیکال او است، که به نظر می‌رسد دیوانه‌وار می‌تازد اما شاید در باطن منطقی عمیق‌تر دارد."],[227,"صاحب رایست و آتش‌پاره‌ای","آسمان قدرست و اخترباره‌ای","او کسی است که دارای فکر و تدبیر است و مانند آتش شعله‌ور می‌باشد؛ مقام و ارزش او به اندازه آسمان بلند است و به طرزی شگفت‌آور مانند ستاره‌ها درخشان است."],[227,"فر او کروبیان را جان شدست","او درین دیوانگی پنهان شدست","او (مولانا) می‌گوید که در اثر دیوانگی، آن روحی که به معصومیت و پاکی فرشتگان (کروبیان) تعلق دارد، پنهان شده است. در واقع، در این حالت دیوانگی، حقیقت وجود او ناشناخته مانده است."],[227,"لیک هر دیوانه را جان نشمری","سر منه گوساله را چون سامری","بسیاری از دیوانگان را نمی‌توان به خاطر روح شان شمارش کرد؛ مانند کسی که گوساله را به عنوان بت می‌پرستد و خود را پست و حقیر کرده است."],[227,"چون ولیی آشکارا با تو گفت","صد هزاران غیب و اسرار نهفت","ولی بزرگ و مقام‌عالی، با تو به‌روشنی سخن گفت و اسرار و رازهای زیادی را که پنهان بود، به تو القا کرد."],[227,"مر ترا آن فهم و آن دانش نبود","وا ندانستی تو سرگین را ز عود","تو آن فهم و دانشی را که لازم است نداری و نتوانسته‌ای تفاوت بین سرگین (فضولات حیوانات) و عود (چوب خوشبو) را تشخیص دهی."],[227,"از جنون خود را ولی چون پرده ساخت","مر ورا ای کور کی خواهی شناخت","از جنون و دیوانگی خود، پرده‌ای بر خود کشیده‌ای و به همین خاطر نمی‌توانی او را بشناسی. ای نابینا، چگونه می‌خواهی حقیقت را درک کنی؟"],[227,"گر ترا بازست آن دیده یقین","زیر هر سنگی یکی سرهنگ بین","اگر چشمان یقین تو باز باشد، می‌توانی زیر هر سنگی یک سرهنگ (فرمانده) را ببینی. این به این معناست که وقتی به حقیقت و واقعیت‌ها با دید روشن و یقین نگاه می‌کنی، می‌توانی قدرت و حکمت را در همه‌جا مشاهده کنی."],[227,"پیش آن چشمی که باز و رهبرست","هر گلیمی را کلیمی در برست","در برابر آن چشمی که باز و هدایت­گر است، هر کسی به نوعی شایستگی می­یابد و در دامن او جای می­گیرد."],[227,"مر ولی را هم ولی شهره کند","هر که را او خواست با بهره کند","هر که بخواهد می‌تواند کسی را که ولی است، به عنوان ولی معروف کند و او را با موهبت و نعمت خود بهره‌مند سازد."],[227,"کس نداند از خرد او را شناخت","چونک او مر خویش را دیوانه ساخت","هیچ‌کس نمی‌تواند از خرد و عقل او آگاه شود، چون او خود را مانند یک دیوانه نشان داده است."],[227,"چون بدزدد دزد بینایی ز کور","هیچ یابد دزد را او در عبور","وقتی دزد بینا از یک کور چیزی بدزدد، آن کور در واقع هیچ چیزی از آن دزد در حین عبور متوجه نمی‌شود."],[227,"کور نشناسد که دزد او که بود","گرچه خود بر وی زند دزد عنود","کور نمی‌تواند دزدی را که او را می‌زند بشناسد، هر چند دزد به او آسیب بزند."],[227,"چون گزد سگ کور صاحب‌ژنده را","کی شناسد آن سگ درنده را","سگ کور نمی‌تواند دزد را بشناسد، حتی اگر او را مورد حمله قرار دهد. بنابراین، صاحب ژنده (کسی که ملبس به لباس‌های کهنه و ژنده است) نیز نمی‌تواند آن کسی را که به او آسیب می‌زند، شناسایی کند."],[228,"یک سگی در کوی بر کور گدا","حمله می‌آورد چون شیر وغا","سگی در کوی به یک گدای کور حمله می‌کند و این حمله به شدت خطرناک و شجاعانه است، مانند حمله شیر."],[228,"سگ کند آهنگ درویشان بخشم","در کشد مه خاک درویشان بچشم","سگ به سمت درویشان می‌آید و به آن‌ها حمله می‌کند، طوری که خاک به چشم درویشان می‌افتد."],[228,"کور عاجز شد ز بانگ و بیم سگ","اندر آمد کور در تعظیم سگ","کور (مرد نابینا) از صدای سگ و ترس او عاجز و ناتوان شد و در برابر سگ به احترام او تسلیم و تعظیم کرد."],[228,"کای امیر صید و ای شیر شکار","دست دست تست دست از من بدار","ای امیر صید و شکار، ای شیر قدرتمند، تو قدرت و توانی؛ بنابراین، از من که بیچاره هستم، دست و پا برمدار و مرا رها کن."],[228,"کز ضرورت دم خر را آن حکیم","کرد تعظیم و لقب دادش کریم","به دلیل ضرورت و نیاز، حکیم (که می‌تواند نماد دانش و حکمت باشد) دم خر (سمبل ضعف یا بی‌ارزشی) را احترام گذاشته و به او لقب «کریم» (بخشنده) داده است."],[228,"گفت او هم از ضرورت کای اسد","از چو من لاغر شکارت چه رسد","او (حکیم) می‌گوید که از روی ضرورت و نیاز، همچنان که شیر (اسد) به من لاغر و ضعیف طعمه‌ای نمی‌دهد، چرا باید (به من) شکار برسد؟"],[228,"گور می‌گیرند یارانت به دشت","کور می‌گیری تو در کوچه بگشت","دوستانت در دشت‌ها به دنبال گور (یعنی شکار گورخر) می‌روند، اما تو در کوچه‌ها به جستجوی یک فرد نابینا و ناتوان می‌گردی."],[228,"گور می‌جویند یارانت بصید","کور می‌جویی تو در کوچه بکید","یاران تو در دشت به دنبال گور (که نوعی جانور است) می‌گردند، اما تو در کوچه به دنبال یک فرد نابینا (کور) می‌گردی."],[228,"آن سگ عالم شکار گور کرد","وین سگ بی‌مایه قصد کور کرد","آن سگ عالم که دانش‌آموخته است، به شکار گور می‌پردازد، اما آن سگ بدون ارزش و دانایی، به دنبال کور می‌گردد."],[228,"علم چون آموخت سگ رست از ضلال","می‌کند در بیشه‌ها صید حلال","وقتی که سگ علم را آموخت و از گمراهی رهایی یافت، می‌تواند در جنگل‌ها شکار حلالی کند."],[228,"سگ چو عالم گشت شد چالاک زحف","سگ چو عارف گشت شد اصحاب کهف","سگ وقتی عالم شد، چالاک و فعال گردید، مانند سگ عارف که با درک و آگاهی‌اش به جمع اهل عرفان و صاحبان بصیرت درمی‌آید."],[228,"سگ شناسا شد که میر صید کیست","ای خدا آن نور اشناسنده چیست","سگ به شناختی دست یافت که می‌داند رئیس شکارچی (میر صید) کیست. ای خدا، آن نوری که شناخت می‌بخشد چیست؟"],[228,"کور نشناسد نه از بی چشمی است","بلک این زانست کز جهلست مست","کور نمی‌تواند چیزی را بشناسد، نه به خاطر نداشتن چشم، بلکه به خاطر نادانی و جهلی است که بر او حاکم است."],[228,"نیست خود بی‌چشم‌تر کور از زمین","این زمین از فضل حق شد خصم بین","هیچ‌کس به اندازه زمین (انسان‌های زمینی) در جهل و نادانی نمی‌تواند کور باشد، زیرا این زمین به برکت نعمت خداوند، دشمن بینا (آگاه) شده است."],[228,"نور موسی دید و موسی را نواخت","خسف قارون کرد و قارون را شناخت","نور موسی، که به رستاخیز روحانی و دانایی او اشاره دارد، او را تأیید و مورد محبت قرار داد. اما سرنوشت قارون، که به خاطر طغیان و تکبرش به زمین فرو رفت، نشان‌دهنده عاقبت ناگوار کسانی است که حقیقت را می‌شناسند اما در مسیر نادرست قدم می‌گذارند."],[228,"رجف کرد اندر هلاک هر دعی","فهم کرد از حق که یاارض ابلعی","در این بیت، به ظهور عذاب و پاداش الهی اشاره شده است. هنگامی که انسان‌ها به حقایق معنوی پی بردند، زمین (یعنی طبیعت یا دنیا) آنها را در خود فرو می‌برد و طغیان آنها را به هلاکت می‌کشاند."],[228,"خاک و آب و باد و نار با شرر","بی‌خبر با ما و با حق با خبر","خاک و آب و باد و آتش (نار) نسبت به ما و حقیقت (حق) بی‌خبر هستند؛ در حالی که ما از آنچه که حق است آگاهی داریم."],[228,"ما بعکس آن ز غیر حق خبیر","بی‌خبر از حق و از چندین نذیر","ما برخلاف این عناصر (خاک و آب و باد و آتش) از غیر حق آگاه هستیم، اما از حقیقت و هشدارهای متعدد بی‌خبر هستیم."],[228,"لاجرم اشفقن منها جمله‌شان","کند شد ز آمیز حیوان حمله‌شان","بنابراین، آنها (حیوانات) از این زندگی و رفتار (ناسالم) بیزار شدند و نسبت به آن (حیات) احساس ترس و حیا کردند و به او (سگ) حمله کردند."],[228,"گفت بیزاریم جمله زین حیات","کو بود با خلق حی با حق موات","همه ما از این زندگی که با انسان‌هاست بیزاریم و در واقع این زندگی تنها با حیات موجودات دیگر است، اما ارتباط حقیقی با خداوند را مرده و بی‌روح می‌یابیم."],[228,"چون بماند از خلق گردد او یتیم","انس حق را قلب می‌باید سلیم","وقتی که انسان از جمع مردم دور بماند، دچار یتیمی می‌شود؛ برای ارتباط واقعی با خداوند، قلب او باید پاک و خالی از آلودگی‌ها باشد."],[228,"چون ز کوری دزد دزدد کاله‌ای","می‌کند آن کور عمیا ناله‌ای","وقتی دزد از روی نادانی و کوری چیزی را می‌دزد، او در واقع بدون آگاهی عمل می‌کند و تنها چیزی که از او باقی می‌ماند، صدای ناله‌ای حاکی از درد و پشیمانی است."],[228,"تا نگوید دزد او را کان منم","کز تو دزدیدم که دزد پر فنم","کور گدا نمی‌تواند دزد را شناسایی کند، تا او فریاد نزند که من دزد توام و از تو دزدیده‌ام، زیرا دزد مهارت در فریب دارد."],[228,"کی شناسد کور دزد خویش را","چون ندارد نور چشم و آن ضیا","کور (بیدید) نمی‌تواند دزد خود را بشناسد چون نور چشم و بینایی ندارد تا او را ببیند و شناسایی کند."],[228,"چون بگوید هم بگیر او را تو سخت","تا بگوید او علامتهای رخت","وقتی که گدا می‌گوید دزد را بگیرید، تو باید او را به شدت بگیری تا بگوید نشانه‌های دزد چیست."],[228,"پس جهاد اکبر آمد عصر دزد","تا بگوید که چه برد آن زن بمزد","زمانی که انسان دچار مبارزه‌های درونی و چالش‌های عظیم خود می‌شود، این نبرد بزرگ در حقیقت به خاطر دزدی است که دزدیده شدن بینش و فطرت او را نشان می‌دهد، همان‌طور که آن زن از مرده‌ای مزد دریافت کرده است."],[228,"اولا دزدید کحل دیده‌ات","چون ستانی باز یابی تبصرت","ابتدا چشمانت را که مثل سرمه زرین ارزشمند است می‌دزدند، حالا وقتی که آن را بگیری، دوباره بینایی‌ات را به دست می‌آوری."],[228,"کاله حکمت که گم کرده دلست","پیش اهل دل یقین آن حاصلست","کالا یا منبع حکمت، چیزی است که دل آن را گم کرده و در جست‌وجوی آن است، اما برای افرادی که اهل دل و درک واقعی هستند، یقینا آن حکمت قابل دستیابی و پیدا کردن است."],[228,"کوردل با جان و با سمع و بصر","می‌نداند دزد شیطان را ز اثر","انسانی که دلش کور است، حتی با وجود داشتن جان و حواس پنج‌گانه نمی‌تواند شیطان و دزد را از نشانه‌هایش تشخیص دهد."],[228,"ز اهل دل جو از جماد آن را مجو","که جماد آمد خلایق پیش او","از اهل معرفت بپرس، نه از موجودات بی‌روح، زیرا موجودات بی‌روح (جماد) در برابر او (اگاهی و دل) از انسان‌ها و خلایق پایین‌ترند."],[228,"مشورت جوینده آمد نزد او","کای اب کودک شده رازی بگو","یک فرد جویای مشورت به نزد او (مولانا) می‌آید و از او می‌خواهد که رازی را بگوید، حالا که او مانند یک بچه است و از حقایق بی‌خبر است."],[228,"گفت رو زین حلقه کین در باز نیست","باز گرد امروز روز راز نیست","مولانا می‌گوید: برو از این حلقه که در آن باز نمی‌شود و برگرد؛ امروز روزی نیست که رازها فاش شود."],[228,"گر مکان را ره بدی در لامکان","همچو شیخان بودمی من بر دکان","اگر راهی به جایی باز می‌کردی که در آن هیچ مکانی وجود نداشته باشد، به عنوان یکی از بزرگترین عارفان، همچون شیخ بزرگ، بر دکان (عالم وجود) می‌نشستم."],[229,"محتسب در نیم شب جایی رسید","در بن دیوار مستی خفته دید","محتسب (امین حکومت در امور شرعی) در نیمه شب جایی رسید و در کنار دیوار، مردی مست که خوابش برده بود را دید."],[229,"گفت هی مستی چه خوردستی بگو","گفت ازین خوردم که هست اندر سبو","محتسب از مست می‌خواهد بگوید چه چیزی خورده که این‌گونه مست شده است. مست پاسخ می‌دهد که از چیزی که در سبوی آن است، نوشیده‌ام."],[229,"گفت آخر در سبو واگو که چیست","گفت از آنک خورده‌ام گفت این خفیست","محتسب از او می‌خواهد که از محتوای سبوی خود بگوید، او پاسخ می‌دهد که از آنچه خورده‌ام، نمی‌توانم بگویم، زیرا آن درون سبو پنهان است."],[229,"گفت آنچ خورده‌ای آن چیست آن","گفت آنک در سبو مخفیست آن","محتسب از مست می‌پرسد که چه چیزی نوشیده است. مست پاسخ می‌دهد که آنچه خورده‌ام، در ظرف (سبو) پنهان است و نمی‌توان آن را مشخص کرد."],[229,"دور می‌شد این سؤال و این جواب","ماند چون خر محتسب اندر خلاب","این سؤال و جواب به دور می‌زند و بی‌پاسخ می‌ماند، مثل خر محتسب که در تشت چرخان می‌چرخد."],[229,"گفت او را محتسب هین آه کن","مست هوهو کرد هنگام سخن","محتسب به آن مست (شراب‌خور) گفت که صبر کن و ناله کن، اما او در حین صحبت کردن به حالت شادابی و سرخوشی درآمد."],[229,"گفت گفتم آه کن هو می‌کنی","گفت من شاد و تو از غم منحنی","محتسب به مست (مستمند یا دیوانه) می‌گوید که باید آه بکشی و او پاسخ می‌دهد که من خوشحالم و تو با غم در هم شکسته‌ای."],[229,"آه از درد و غم و بیدادیست","هوی هوی می‌خوران از شادیست","آه و ناله به خاطر درد، غم و بیدادی است که او (مست خراب) از سر شادمانی به صورت فریاد در می‌آورد."],[229,"محتسب گفت این ندانم خیز خیز","معرفت متراش و بگذار این ستیز","محتسب گفت: من نمی‌دانم که این کار چه معنایی دارد، بلند شو و به خودت زحمت نده و در این جنجال خودت را درگیر نکن."],[229,"گفت رو تو از کجا من از کجا","گفت مستی خیز تا زندان بیا","مستی به محتسب می‌گوید که تو از کجا می‌روی و من از کجا می‌آیم؛ پس بی‌خود و بی‌جهت پای خود را بر زمین می‌زنیم و بی‌محابا به زندان می‌رویم."],[229,"گفت مست ای محتسب بگذار و رو","از برهنه کی توان بردن گرو","مستی به محتسب (پلیس شرع) می‌گوید که تو دیگر مرا رها کن و برو، زیرا کسی که برهنه باشد (بدون لباس) نمی‌تواند به عنوان گرو (تضمینی یا وثیقه) گرفته شود."],[229,"گر مرا خود قوت رفتن بدی","خانه خود رفتمی وین کی شدی","اگر خودم به اندازه کافی توانایی داشتم که به خانه خود بروم، اکنون در این وضعیت نمی‌بودم."],[229,"من اگر با عقل و با امکانمی","همچو شیخان بر سر دکانمی","اگر من هم مثل شیخان (رهبران دینی)، با فکر و امکانات مناسب، در جایگاهی قرار داشتم که بر سر دکان (محل کسب و کار) باشم، چنین نمی‌شد که حال من اینگونه باشد."],[230,"گفت آن طالب که آخر یک نفس","ای سواره بر نی این سو ران فرس","طالب (جستجوکننده) گفت: ای سوار بر اسبی که به جلو می‌روی، یک نفس بایست و این سو را هم نگاه کن."],[230,"راند سوی او که هین زوتر بگو","کاسپ من بس توسن‌ست و تندخو","سواره اسبش را به سوی طالب راند و به او گفت هر حرفی داری زودتر بگو چون اسب من بسیار وحشی و تند مزاج است"],[230,"تا لگد بر تو نکوبد زود باش","از چه می‌پرسی بیانش کن تو فاش","زودتر از آنکه دمی را به تأخیر بیندازد و دچار مشکل شود، خودت آنچه را که لازم است بگویید و موضوع را به طور واضح و شفاف مطرح کن، زیرا ممکن است او ناگهان غضب کند."],[230,"او مجال راز دل گفتن ندید","زو برون شو کرد و در لاغش کشید","او فرصتی برای گفتن راز دل پیدا نکرد و از او دور شد و با حال نامناسب از آنجا بیرون رفت."],[230,"گفت می‌خواهم درین کوچه زنی","کیست لایق از برای چون منی","سخنگو می‌گوید که می‌خواهد در این کوچه زنی را پیدا کند که شایسته و مناسب او باشد."],[230,"گفت سه گونه زن‌اند اندر جهان","آن دو رنج و این یکی گنج روان","مولانا می‌گوید در جهان سه نوع زن وجود دارد: دو نوع آنها باعث رنج و سختی هستند و نوع سوم، زن گنج و خوشبختی است که برکت و دستیابی به آرامش می‌آورد."],[230,"آن یکی را چون بخواهی کل تراست","وآن دگر نیمی ترا‌، نیمی جداست","زن‌ها را به سه دسته تقسیم کرده‌اند؛ یکی از آنها کلا برای توست و تمام وجودت را به او می‌دهی، در حالی که دسته دیگر فقط نیمی از تو را به خود اختصاص می‌دهد و نیمه‌ای از تو جدا باقی می‌ماند."],[230,"وآن سیم هیچ او ترا نبود بدان","این شنودی دور شو‌، رفتم روان","او (سیم) هیچ‌گاه تو را ندارد، بنابراین از شنیدن این سخن (دوری) دور شو؛ من (شاعر) روانه شدم."],[230,"تا ترا اسپم نپراند لگد","که بیفتی بر نخیزی تا ابد","به خاطر اینکه تو را از روی اسپ (اسب) نپرانند و نلرزی، باید مراقب باشی که زمین نیفتی؛ چون اگر بر زمین بیفتی، دیگر توان برخاستن نخواهی داشت."],[230,"شیخ راند اندر میان کودکان","بانگ زد بار دگر او را جوان","شیخ (مولانا) در میان کودکان فریاد زد و بار دیگر آن بزرگ (سایل) را جوان خطاب کرد."],[230,"که بیا آخر بگو تفسیر این","این زنان سه نوع گفتی بر گزین","اکنون بیا و توضیح بده که این سه نوع زنان که گفتی، چه معنایی دارند و هر کدام را مشخص کن."],[230,"راند سوی او و گفتش بکر خاص","کل ترا باشد ز غم یابی خلاص","او به سوی آن شخص رفت و گفت: ای بکر (دختر) خاص، تو برای من منبعی از شادی هستی و از غم رهایی می‌بخشی."],[230,"وانک نیمی آن‌ تو‌، بیوه بود","وانک هیچ‌ست‌، آن عیال با ولد","اگر نیمی از آنچه به تو تعلق دارد، همسری بیوه است، آن‌گاه هیچ همسر دیگری با فرزندش نخواهد بود."],[230,"چون ز شوی اولش کودک بود","مهر و کل خاطرش آن سو رود","چون زن از شوهر اولش بچه‌دار است، محبت و تمام احساسات او به سمت آن شوهر می‌رود."],[230,"دور شو تا اسپ نندازد لگد","سم اسپ توسنم بر تو رسد","از حضور خود دور شو تا اسب لگد نزند، لگد سم اسب قوی و نیرومند تو به تو خواهد رسید."],[230,"های هویی کرد شیخ باز راند","کودکان را باز سوی خویش خواند","شیخ با فریاد و هیاهو، بچه‌ها را دور کرد و سپس دوباره آن‌ها را به سمت خود فراخواند."],[230,"باز بانگش کرد آن سایل بیا","یک سؤالم ماند ای شاه کیا","سایل، یعنی سوال کننده، از آن شیخ بزرگ خواسته است که یک سوال از او باقی مانده است و او را به نام «شاه کیا» خطاب کرده است."],[230,"باز راند این سو بگو زوتر چه بود","که ز میدان آن بچه گویم ربود","دوباره او را به سمت خود فرا خواند و گفت: زودتر بگو چه اتفاقی افتاده که آن بچه را از میدان گرفت."],[230,"گفت ای شه با چنین عقل و ادب","این چه شیدست این چه فعلست ای عجب","گفت: ای پادشاه، با این عقل و ادب که داری، این چه حالتی است که به تو دست داده و این چه رفتار عجیبی است؟"],[230,"تو ورای عقل کلی در بیان","آفتابی‌، در جنون چونی نهان‌؟","تو فراتر از عقل کل در کلامی مانند خورشید هستی، اما در حالت جنون چه چیزی در درون تو نهفته است؟"],[230,"گفت این اوباش رایی می‌زنند","تا درین شهر خودم قاضی کنند","این افراد بی‌خبر از حقیقت فقط حرف می‌زنند تا در این شهر من را قاضی و داور خود قرار دهند."],[230,"دفع می‌گفتم مرا گفتند نی","نیست چون تو عالمی صاحب فنی","من در پاسخ به اعتراضات و اظهارنظرهای آنان، می‌گفتم که من عالم و صاحب فن هستم و نیازی به قضاوت‌های دیگران ندارم."],[230,"با وجود تو حرام است و خبیث","که کم از تو در قضا گوید حدیث","وجود تو باعث می‌شود که هر کسی که کمتر از تو در مورد قضا و قدر صحبت کند، ناپاک و حرام به حساب بیاید."],[230,"در شریعت نیست دستوری که ما","کمتر از تو شه کنیم و پیشوا","در شریعت، هیچ قانونی وجود ندارد که اجازه دهد ما از تو پایین‌تر و بی‌مقام‌تر باشیم یا تو را کمتر از خود بدانیم."],[230,"زین ضرورت گیج و دیوانه شدم","لیک در باطن همانم که بدم","از آن ضرورت و نیاز فراموش‌کننده، گیج و دیوانه شده‌ام، اما در درون خود همان چیزی هستم که قبلا بوده‌ام."],[230,"عقل من گنج‌ست و من ویرانه‌ام","گنج اگر پیدا کنم دیوانه‌ام","عقل من مانند گنجی ارزشمند است، اما خودم به خاطر شرایط یا رفتارهایم ویران و نابسامان هستم. اگر این گنج را پیدا کنم، به خاطر تأثیرش بر من دیوانه می‌شوم."],[230,"اوست دیوانه که دیوانه نشد","این عسس را دید و در خانه نشد","او کسی است که واقعا دیوانه است اگر نتواند این نگهبان (عسس) را ببیند و از آنچه در خانه‌ی خود دارد، بهره‌مند نشود."],[230,"دانش من جوهر آمد نه عرض","این بهایی نیست بهر هر غرض","دانش من بنیادی و اصلی است و نه چیزی اضافی؛ این علم به قدری ارزشمند است که برای هر هدفی نمی‌توان به آن قیمت گذاشت."],[230,"کان قندم‌، نیستان شکرم","هم ز من می‌روید و من می‌خورم","چنان‌که قند و شکر از نی به دست می‌آید، همانا دانایی و شیرینی علم من نیز از وجود من می‌روید و خود نیز از آن بهره‌مند می‌شوم."],[230,"علم تقلیدی و تعلیمی‌ست آن","کز نفور مستمع دارد فغان","علمی که مبتنی بر تقلید و آموزش سطحی باشد، باعث می‌شود که شنونده از آن متنفر شود و فریاد بزند که راضی نیست."],[230,"چون پی دانه نه بهر روشنی‌ست","همچو طالب‌علم دنیای دنی‌ست","طالب علم مانند کسی است که به دنبال دانه‌ای است، اما هدف او تنها روشنایی و حقیقت نیست. بلکه او به دنبال دنیا و منافع دنیایی خود است."],[230,"طالب علم است بهر عام و خاص","نه که تا یابد ازین عالم خلاص","طالب علم در جستجوی دانش برای همه افراد است، نه تنها برای رهایی از این دنیا، بلکه برای بهره‌مندی از معرفت و آگاهی."],[230,"همچو موشی هر طرف سوراخ کرد","چونک نورش راند از در گفت برد","مانند موش که از ترس نور در هر طرف سوراخی می‌کند، انسان نیز وقتی از نور حقیقت دور می‌شود و در تاریکی قرار می‌گیرد، برای فرار از آن به این سو و آن سو می‌دود."],[230,"چونک سوی دشت و نورش ره نبود","هم در آن ظلمات جهدی می‌نمود","وقتی که به دشت و روشنایی دسترسی نداشت، در آن تاریکی نیز تلاش می‌کرد."],[230,"گر خدایش پر دهد‌، پر‌ خرد","برهد از موشی و چون مرغان پرد","اگر خدا به او بال و پر بدهد، عقلش به‌سوی آسمان پرواز می‌کند و از وضعیت خرد و ناچیز خود خارج می‌شود، مانند پرندگان که در ارتفاع پرواز می‌کنند."],[230,"ور نجوید پر‌، بماند زیر خاک","ناامید از رفتن راه سماک","اگر پر نگیرد و پرواز نکند، در زیر خاک می‌ماند و ناامید است از مسیر آسمانی و پرواز به سوی بالا."],[230,"علم گفتاری که آن بی جان بود","عاشق روی خریداران بود","علمی که تنها در حد کلام و لفظ باشد و جان نداشته باشد، به دنبال محبتی و زیبایی کسانی است که به آن علم علاقه‌مند هستند."],[230,"گرچه باشد وقت بحث علم زفت","چون خریدارش نباشد مرد و رفت","اگرچه زمان بحث و صحبت درباره علم بسیار جدی و عمیق است، اما اگر کسی‌ که به دنبال آن علم است در دسترس نباشد و فایده‌ای از آن نبرد، ارزش خود را از دست می‌دهد."],[230,"مشتری من خدایست او مرا","می‌کشد بالا که الله اشتری","خریدار من خداوند است و اوست که مرا به سمت خودش می‌برد، همان‌طور که الهی برترین و بزرگ‌ترین خریدار است."],[230,"خون‌بهای من جمال ذوالجلال","خون‌بهای خود خورم کسب حلال","خون‌بهای من، زیبایی و جمال خداوند است و من آن را می‌خورم، یعنی از این جمال بهره‌مند می‌شوم و به دنبال کسب حلال و سالم هستم."],[230,"این خریداران مفلس را بهل","چه خریداری کند یک مشت گل‌؟","این خریدارانی که بی‌پول و بی‌چیز هستند، چه چیزی را می‌توانند بخرند وقتی که حداکثر دارایی‌شان یک مشت خاک است؟"],[230,"گل مخور گل را مخر گل را مجو","زانک گل‌خوار است دایم زردرو","گل را نخور و به آن چنگ نزن و دنبال آن نرو، زیرا کسی که گل می‌خورد همیشه رنگش زرد و کدر می‌شود."],[230,"دل بخور تا دایما باشی جوان","از تجلی چهره‌ات چون ارغوان","دل خود را شاد کن تا همیشه جوان بمانی، زیرا زیبایی و جذابیت چهره‌ات مانند گل ارغوان (گل سرخ) خواهد بود."],[230,"یا رب این بخشش نه حد کار ماست","لطف تو لطف خفی را خود سزاست","ای خدا، این بخشش و عطای تو فراتر از توانایی ماست، زیرا لطف تو که مخفی‌تر است، خود شایسته‌تر از ما برای دریافت این نعمت‌های تو است."],[230,"دست گیر از دست ما، ما را بخر","پرده را بر دار و پرده ما مدر","از تو بخواهیم که ما را از دست خودمان نجات بدهی و در بند ما نباشی. ما را پرده‌نشین به حال خود رها کن و پرده‌ای هم بر ما نتابان."],[230,"باز خر ما را ازین نفس پلید","کاردش تا استخوان ما رسید","نفس پلید به معنای خواسته‌ها و تمایلات ناپسند انسانی است که به ما آسیب می‌زند. شاعر از خداوند می‌خواهد که گره‌های این نفس آلوده، که به عمق وجود انسان رسیده، را باز کند و از آن رهایی یابد."],[230,"از چو ما بیچارگان این بند سخت","کی گشاید ای شه بی‌تاج و تخت","ای پادشاه بدون تاج و تخت، این بند سخت را چه کسی می‌تواند بگشاید، جز تو؟ ما بیچارگان در موقعیتی دشوار قرار داریم."],[230,"این چنین قفل گران را ای ودود","کی تواند جز که فضل تو گشود","ای خداوند بخشنده و مهربان، تنها فضل و رحمت توست که می‌تواند این قفل‌های سنگین و مشکلات ما را باز کند."],[230,"ما ز خود سوی تو گردانیم سر","چون توی از ما به ما نزدیکتر","ما به سوی تو، ای خدا، سر و دل خود را می‌گردانیم؛ زیرا تو از خود ما به ما نزدیک‌تر هستی."],[230,"این دعا هم بخشش و تعلیم تست","گرنه در گلخن گلستان از چه رست","این دعا به خاطر رحمت و آموزش توست، وگرنه اینکه گل در میان خاک و گلستان روییده، به چه دلیل می‌تواند باشد؟"],[230,"در میان خون و روده فهم و عقل","جز ز اکرام تو نتوان کرد نقل","در این بیت گفته شده که در میان برتری و ارجمندی تو، فهم و عقل نمی‌توانند خودشان را نشان دهند و فقط به خاطر احترام و بزرگی تو می‌توانند مورد توجه قرار گیرند. به عبارتی دیگر، در مقام تو، دیگر مقامات، مثل فهم و عقل، معنای واقعی خود را پیدا می‌کنند."],[230,"از دو پاره پیه این نور روان","موج نورش می‌زند بر آسمان","این بیت به این موضوع اشاره دارد که از ترکیب دو بخش چربی یا پیه، نوری درخشان و زیبا به وجود می‌آید که مانند موجی بر آسمان می‌درخشد. این نور نماد روح یا حقیقتی بالاتر است که از وجود مادی و دنیاوی فراتر می‌رود و به روشنایی و آسمان معنوی مرتبط است."],[230,"گوشت‌پاره که زبان آمد ازو","می‌رود سیلاب حکمت همچو جو","چیزی که از گوشت و پیکر انسان به نام زبان سرشته شده، باعث می‌شود حکمت مانند سیلابی جاری از آن خارج شود."],[230,"سوی سوراخی که نامش گوش‌هاست","تا به باغ جان که میوه‌ش هوش‌هاست","گوش‌ها به عنوان کانال‌های ارتباطی ما به باغ جان تشبیه می‌شوند، جایی که میوه‌های آن هوش و دانش‌هایی است که از طریق شنیدار به دست می‌آید."],[230,"شاه‌راه باغ جان‌ها شرع اوست","باغ و بستان‌های عالم فرع اوست","راه اصلی و مستقیم به باغ جان‌ها، شریعت و دین او (خدا) است و باغ‌ها و بستان‌های این عالم، تنها میوه و نتیجه‌ای فرعی از آن شریعت هستند."],[230,"اصل و سرچشمه خوشی آنست آن","زود تجری تحتها الانهار خوان","خوشی و شادی واقعی از یک منبع و سرچشمه می‌آید و آن چیزی است که در عمق روح انسان وجود دارد و از آن نشأت می‌گیرد. این خوشی همانند جویبارهایی است که از زیر پای انسان سرازیر می‌شود."],[231,"گفت پیغامبر مر آن بیمار را","چون عیادت کرد یار زار را","پیامبر در هنگام عیادت از آن بیمار زار، پیامی برای او فرستاد."],[231,"که مگر نوعی دعایی کرده‌ای","از جهالت زهربایی خورده‌ای","شاید تو نوعی دعا کرده‌ای، اما از روی نادانی به زهر هلاکت دچار شده‌ای."],[231,"یاد آور چه دعا می‌گفته‌ای","چون ز مکر نفس می‌آشفته‌ای","به یاد بیاور که در گذشته چه دعایی می‌کردی، زیرا که اکنون به خاطر فریب نفس خود پریشان حالت هستی."],[231,"گفت یادم نیست الا همتی","دار با من یادم آید ساعتی","شخصی می‌گوید که فراموش کرده‌ام چه دعایی می‌خواندم، فقط در قلبم اراده و تلاشی هست که مرا به یاد می‌آورد، و گاهی به یاد آن دعا می‌افتم."],[231,"از حضور نوربخش مصطفی","پیش خاطر آمد او را آن دعا","نوری که از وجود پیامبر اسلام، مصطفی، ساطع می‌شود، به یاد او می‌آورد که در آن لحظه دعا و کمک از او خواسته است."],[231,"تافت زان روزن که از دل تا دلست","روشنی که فرق حق و باطلست","نور و روشنایی که از آن روزنه به دل‌ها می‌تابد، نشانه‌ای است از تمایز بین حق و باطل. این نور به ما کمک می‌کند تا حقیقت را از نادرستی بشناسیم."],[231,"گفت اینک یادم آمد ای رسول","آن دعا که گفته‌ام من بوالفضول","دارم به یاد می‌آورم ای رسول خدا، دعایی را که من به زبان آورده‌ام و بسیاری از آن سخن‌ها را بیهوده و گستاخانه گفته‌ام."],[231,"چون گرفتار گنه می‌آمدم","غرقه دست اندر حشایش می‌زدم","زمانی که به خاطر گناهانم گرفتار می‌شدم، به طور ناچار به گندم‌ها و مزارع می‌زدم (یعنی به امور دنیا مشغول می‌شدم) و محاصره می‌شدم."],[231,"از تو تهدید و وعیدی می‌رسید","مجرمان را از عذاب بس شدید","از تو (خدا) تهدید و وعده‌ای به مجرمان می‌رسید که عذاب بسیار سختی در انتظار آن‌هاست."],[231,"مضطرب می‌گشتم و چاره نبود","بند محکم بود و قفل ناگشود","در حالت اضطراب و پریشانی بودم و راه حلی پیدا نمی‌کردم؛ چرا که با گرفتار شدن در مشکلات، کارم به جایی رسیده بود که نتوانستم قفل این مشکلات را باز کنم."],[231,"نی مقام صبر و نی راه گریز","نی امید توبه نی جای ستیز","نه جای صبر است و نه امکان فرار، نه امیدی به توبه وجود دارد و نه فضایی برای نزاع و درگیری."],[231,"من چو هاروت و چو ماروت از حزن","آه می‌کردم که ای خلاق من","من مانند هاروت و ماروت (دو فرشته که در داستان‌های دینی به آزمایش و امتحان انسان‌ها پرداخته‌اند) از شدت غم و اندوه آه می‌کشیدم و از خدا می‌خواستم که مرا خلق کرده است."],[231,"از خطر هاروت و ماروت آشکار","چاه بابل را بکردند اختیار","اشاره به داستان هاروت و ماروت در قرآن است که به عنوان دو فرشته‌ای که در بابل به سحر و جادو آموزش می‌دادند، شناخته می‌شوند. در این بیت، بیان می‌شود که خطر هاروت و ماروت (کسانی که در کار سحر و جادو هستند) موجب شده است که مردم از چاه بابل (جایی که سحر و جادو در آنجا انجام می‌شد) دوری کنند و از آن خطرات آگاه شوند."],[231,"تا عذاب آخرت اینجا کشند","گربزند و عاقل و ساحروشند","اگر انسان‌های خردمند و باعقل (عاقل) در دنیا به گناه بپردازند و از دست شیطان (ساحر) غافل شوند، عذاب و مجازات آخرت را در این دنیا متحمل خواهند شد."],[231,"نیک کردند و بجای خویش بود","سهل‌تر باشد ز آتش رنج دود","انسان‌هایی که کارهای خوبی انجام داده و در جایگاه مناسب خود قرار دارند، به مراتب راحت‌تر از افرادی که در آتش عذاب قرار می‌گیرند، از رنج و سختی‌ها فاصله خواهند داشت."],[231,"حد ندارد وصف رنج آن جهان","سهل باشد رنج دنیا پیش آن","توصیف درد و رنج در جهان آخرت حد و مرزی ندارد و در مقایسه با آن، رنج‌های دنیوی بسیار کم‌خطرتر و آسان‌تر به نظر می‌رسد."],[231,"ای خنک آن کو جهادی می‌کند","بر بدن زجری و دادی می‌کند","خوشا به حال کسی که با تلاش و مجاهدت، بر تنش سختی‌ها را تحمل می‌کند و در عوض، برای دیگران نعمت و خیر را به ارمغان می‌آورد."],[231,"تا ز رنج آن جهانی وا رهد","بر خود این رنج عبادت می‌نهد","انسان برای اینکه از رنج دنیا رهایی یابد، بر خود رنج عبادت را تحمل می‌کند."],[231,"من همی‌گفتم که یا رب آن عذاب","هم درین عالم بران بر من شتاب","من در اینجا می‌گویم، ای پروردگار، که عذاب آخرت را زودتر از این دنیا بر من نازل کن."],[231,"تا در آن عالم فراغت باشدم","در چنین درخواست حلقه می‌زدم","این بیت بیان می‌کند که شخص گوینده، به خاطر طلب آرامش و راحتی در عالم دیگر، در این دنیا به طور مداوم دعا و درخواست می‌کند. او در تلاش است تا با استغفار و دعا، به فراغت و آسودگی در زندگی بعدی دست یابد."],[231,"این چنین رنجوریی پیدام شد","جان من از رنج بی آرام شد","من به این حال رنجور دچار شدم و روح من به خاطر رنج و درد آرامش ندارد."],[231,"مانده‌ام از ذکر و از اوراد خود","بی‌خبر گشتم ز خویش و نیک و بد","در حال حاضر از یادآوری نام خدا و عبادت خود غافل مانده‌ام و به حالتی پریشان و بی‌خبر از خودم درآمده‌ام، نه از خوبی‌های خود باخبرم و نه از بدی‌هایم."],[231,"گر نمی‌دیدم کنون من روی تو","ای خجسته وی مبارک بوی تو","اگر الان چهره تو را نمی‌دیدم، ای خوشبخت و دارای بوی خوش، چه حالی داشتم؟"],[231,"می‌شدم از بند من یکبارگی","کردیم شاهانه این غمخوارگی","از شدت محبت و عشق، یک‌باره از تمام بندها و قید و شرط‌ها آزاد می‌شوم و به گونه‌ای شایسته و سلطنتی، این دلسوزی و محبت را می‌پذیرم."],[231,"گفت هی هی این دعا دیگر مکن","بر مکن تو خویش را از بیخ و بن","گفت: دیگر چنین دعایی نکن. خودت را از پایه و بنیاد، از این وضع و حالت زشت خارج نکن."],[231,"تو چه طاقت داری ای مور نژند","که نهد بر تو چنان کوه بلند","ای مور زبون و ضعیف، تو چه قدرتی داری که در برابر کوهی بزرگ بایستی و تحمل کنی؟"],[231,"گفت توبه کردم ای سلطان که من","از سر جلدی نلافم هیچ فن","بیمار می‌گوید که ای سلطان، من توبه کرده‌ام و از روی نادانی و بی‌خود بودن، هیچ کاری نمی‌کنم که با مهارت یا هنر همراه باشد."],[231,"این جهان تیه ست و تو موسی و ما","از گنه در تیه مانده مبتلا","این جهان بی‌راهه‌ای است و تو مانند موسی هستی، اما ما به گناهان‌مان در این بیراهه گرفتار شده‌ایم."],[231,"قوم موسی راه می‌پیموده‌اند","آخر اندر گام اول بوده‌اند","قوم موسی (که اشاره به پیروان او دارد) در حالی که در حال حرکت و جستجوی هدف هستند، در واقع هنوز در ابتدای مسیر قرار دارند و هیچ پیشرفت واقعی نکرده‌اند."],[231,"سالها ره می‌رویم و در اخیر","همچنان در منزل اول اسیر","سال‌ها در راه می‌رویم، اما در پایان همچنان در همان جایگاه اولیه و در بند هستیم."],[231,"گر دل موسی ز ما راضی بدی","تیه را راه و کران پیدا شدی","اگر دل موسی، پیامبر خدا، از ما راضی بودی، مسیر و مقصد نجات برای تو پیدا می‌شد."],[231,"ور بکل بیزار بودی او ز ما","کی رسیدی خوانمان هیچ از سما","اگر او از ما به‌کلی بیزار بود، چگونه به خوان ما (دعوت ما) رسید؟ او هیچ نشانه‌ای از عشق و رغبت به ما نداشت."],[231,"کی ز سنگی چشمه‌ها جوشان شدی","در بیابان‌مان امان جان شدی","چگونه می‌توانستی مثل چشمه‌های جوشان از سنگی در بیابان خارج شوی و در زندگی ما عزیز و نجات‌دهنده باشی؟"],[231,"بل به جای خوان خود آتش آمدی","اندرین منزل لهب بر ما زدی","تو به جای غذا و خوراک، آتش و بلا را به خانۀ ما آوردی و بر ما مصیبت‌ها را تحمیل کردی."],[231,"چون دو دل شد موسی اندر کار ما","گاه خصم ماست و گاهی یار ما","موسی، در کار ما گاهی به دو دلی می‌افتد؛ گاهی دشمن ماست و گاهی همراه و یار ما."],[231,"خشمش آتش می‌زند در رخت ما","حلم او رد می‌کند تیر بلا","خشم موسی، مانند آتش به ما آسیب می‌زند، اما خوی حلم و دوراندیشی او، بلا و آسیب را از ما دور می‌کند."],[231,"کی بود که حلم گردد خشم نیز","نیست این نادر ز لطفت ای عزیز","جز تو کیست که خشم را با حلم (خویشتنداری) تبدیل کند؟ چنین ویژگی‌ای بسیار نادر است و تنها از لطف تو برمی‌آید، ای عزیز."],[231,"مدح حاضر وحشتست از بهر این","نام موسی می‌برم قاصد چنین","مدح و ستایش من در اینجا به خاطر ترس و وحشتی است که از نام موسی وجود دارد، بنابراین من پیام‌آوری چنین (موسی) را مورد تمجید قرار می‌دهم."],[231,"ورنه موسی کی روا دارد که من","پیش تو یاد آورم از هیچ تن","اگر موسی، پیامبر بزرگ خدا، هم حاضر باشد، چگونه ممکن است من در برابر تو به یاد هیچ انسانی بیفتم؟"],[231,"عهد ما بشکست صد بار و هزار","عهد تو چون کوه ثابت بر قرار","ما بارها و بارها پیمان خود را شکستیم، اما پیمان تو همچنان چون کوه استوار و پابرجا باقی مانده است."],[231,"عهد ما کاه و به هر بادی زبون","عهد تو کوه و ز صد که هم فزون","عهد ما به خاطر ضعف و ناتوانی‌مان به راحتی شکسته می‌شود، اما عهد تو چون کوه محکم و استوار است و حتی از صد کوه هم محکم‌تر و بیشتر معتبر است."],[231,"حق آن قوت که بر تلوین ما","رحمتی کن ای امیر لونها","خداوند، ای امیر، آن قدرت و توانایی را دارد که بر تنوع و تغییرات حالتی ما رحمت کند و به ما بخشش نماید."],[231,"خویش را دیدیم و رسوایی خویش","امتحان ما مکن ای شاه بیش","ما خود را با رسوایی‌هایمان دیدیم و قبول داریم که در این آزمون، تو، ای شاه بزرگ، ما را آزمایش نکن."],[231,"تا فضیحتهای دیگر را نهان","کرده باشی ای کریم مستعان","ای کریم مستعان (یا یاری‌کننده)، ما را وادار نکن که فضیحت‌ها و عیوب دیگر خود را پنهان کنیم."],[231,"بی‌حدی تو در جمال و در کمال","در کژی ما بی‌حدیم و در ضلال","شما در زیبایی و کمال، بی‌پایان و نامتناهی هستید، اما ما در نواقص و گمراهی، حد و مرزی نداریم."],[231,"بی حدی خویش بگمار ای کریم","بر کژی بی حد مشتی لئیم","ای خداوند بزرگ، لطف و کرم بی‌پایانی که داری را بر ما نازل کن تا بر نادرستی و انحراف ما که بسیار است، تسلط پیدا کنی."],[231,"هین که از تقطیع ما یک تار ماند","مصر بودیم و یکی دیوار ماند","هشدار که اگر ما را به دو قسمت تقسیم کنند، چیزی از ما نمی‌ماند و به مانند دیواری تنها یک تار از آن باقی خواهد ماند، یعنی ما به شدت وابسته به یکدیگر هستیم و با جدایی آسیب می‌بینیم."],[231,"البقیه البقیه ای خدیو","تا نگردد شاد کلی جان دیو","ای خدیو، بقیه ما بماند تا اینکه سایر روح‌ها (چون دیو) شاد نشوند."],[231,"بهر ما نی بهر آن لطف نخست","که تو کردی گمرهان را باز جست","بخاطر ما و نه بخاطر آن لطف ابتدایی که تو به بندگان گمراه کردی و آنها را نجات دادی."],[231,"چون نمودی قدرتت بنمای رحم","ای نهاده رحمها در لحم و شحم","چون قدرت خود را نشان دادی، رحم و محبتت را هم آشکار کن، ای کسی که رحم‌ها را در گوشت و چربی نهاده‌ای."],[231,"این دعا گر خشم افزاید تو را","تو دعا تعلیم فرما مهترا","اگر این دعا بر شدت خشم تو بیفزاید، ای استاد، به من یاد بده که چگونه دعا کنم."],[231,"آنچنان کآدم بیفتاد از بهشت","رجعتش دادی که رست از دیو زشت","آدم به قدری از بهشت رانده شد که تو (خدا) او را به حالت اولیه‌اش برگرداندی و او را از چنگال دیو زشت نجات دادی."],[231,"دیو کی بود کو ز آدم بگذرد","بر چنین نطعی ازو بازی برد","دیو کیست که با این صداقت و روشنی سخن گفتن آدم را تحمل کند و از او بگذرد و بر این حال او را بفریبد؟"],[231,"در حقیقت نفع آدم شد همه","لعنت حاسد شده آن دمدمه","در واقع، نفع آدم به وجود آمد، و تمام بدبختی‌ها و نفرین حاسدی است که در این وضعیت ایجاد شده است."],[231,"بازیی دید و دو صد بازی ندید","پس ستون خانه خود را برید","در این بیت به اوضاع ناخوشایند افرادی اشاره دارد که به خاطر دیدن عیب‌ها و بازی‌های دیگران، خانه و امنیت خود را به خطر می‌اندازند. به این معنا که تنها به یک نقیصه توجه می‌کنند و از آسیب‌ دیدن خود غافلند."],[231,"آتشی زد شب بکشت دیگران","باد آتش را بکشت او بران","در این بیت، اشاره به فردی است که به خاطر آتش شومی که به پا کرده، دیگران را به هلاکت می‌رساند و خود نیز در اثر همان آتش نابود می‌شود. به نوعی، نتیجه بدی که به بار می‌آورد، زندگی خودش را نیز از بین می‌برد."],[231,"چشم‌بندی بود لعنت دیو را","تا زیان خصم دید آن ریو را","دیو یا موجود شیطانی، باعث به وجود آمدن فریب و نیرنگ شده است و به همین دلیل، چشم‌بند یا حجاب او را لعنت کرده‌اند. وقتی به ضرر دشمنی می‌نگرد، این چشم‌بند دیو مانند مانع دید او عمل کرده است."],[231,"خود زیان جان او شد ریو او","گویی آدم بود دیو دیو او","زیان جان او موجب رنج و ضرر خودش شده است، گویی آن شخص که شبیه آدم است در واقع دیو، یعنی موجودی شرور است."],[231,"لعنت این باشد که کژبینش کند","حاسد و خودبین و پر کینش کند","لعنت این است که فردی بدبین، حسود و کینه‌توز او را نابجا و به ناحق مورد تهمت قرار دهد و به خودپسندی دچار شود."],[231,"تا نداند که هر آنک کرد بد","عاقبت باز آید و بر وی زند","هر کسی که کار بدی انجام دهد، در نهایت عاقبت کارش بر او برمی‌گردد و تأثیر آن را خواهد دید."],[231,"جمله فرزین‌بندها بیند بعکس","مات بر وی گردد و نقصان و وکس","فرزین‌بندها (پیمان‌های قوی) برای او بی‌ارزش و بی‌فایده می‌شوند، چون همه چیز بر او ظاهر می‌شود و او به نقصان و کاستی خود پی می‌برد."],[231,"زانک گر او هیچ بیند خویش را","مهلک و ناسور بیند ریش را","چون انسان خود را به صورت خراب و آسیب‌دیده ببیند، در حقیقت خود را در خطر و تباهی می‌بیند."],[231,"درد خیزد زین چنین دیدن درون","درد او را از حجاب آرد برون","دیدن خود و باطن را در حالت زجر و درد، باعث می‌شود که درد او آشکار شود و حجاب‌هایی که بر سر راه اوست، کنار برود."],[231,"تا نگیرد مادران را درد زه","طفل در زادن نیابد هیچ ره","تا زمانی که مادران در هنگام زایمان درد نمی‌کشند، هیچ راهی برای به دنیا آوردن فرزند ندارند."],[231,"این امانت در دل و دل حامله‌ست","این نصیحتها مثال قابله‌ست","این جمله به این معنی است که این امانت (نظیر دانایی یا نصیحت) در دل موجود است و دل همانند یک مادر در حال بارداری است. نصیحت‌ها به مثابه قابله‌ای هستند که برای تولد و ظهور این دانایی در دل کمک می‌کنند."],[231,"قابله گوید که زن را درد نیست","درد باید درد کودک را رهیست","قابله می‌گوید که اگر زن درد ندارد، باید بداند که این نشانه‌ای نگران‌کننده است؛ زیرا در چنین حالتی، درد، نشانه‌ای برای تولد نوزاد است و اگر دردی وجود ندارد، به معنای فقدان زندگی در رحم است."],[231,"آنک او بی‌درد باشد ره‌زنست","زانک بی‌دردی انا الحق گفتنست","کسی که بی‌درد و رنج است، در واقع به دام افتاده و گمراه شده است، زیرا بی‌دردی و ادعای حقیقت‌گویی، نشانه‌ فقدان درک و آگاهی است."],[231,"آن انا بی وقت گفتن لعنتست","آن انا در وقت گفتن رحمتست","گفتن «انا الحق» (من حقیقت هستم) در زمان نامناسب مجازات و لعنت است، ولی در زمان مناسب و درست، رحمت و نعمت به شمار می‌آید."],[231,"آن انا منصور رحمت شد یقین","آن انا فرعون لعنت شد ببین","این بیت به تضاد میان رحمت و لعنت اشاره دارد. \"انا\" که به معنای \"من\" است، در موقعیت‌های مختلف می‌تواند سرنوشت متفاوتی داشته باشد؛ در اینجا \"انا منصور\" به عنوان نشانه‌ای از رحمت و پیروزی، و \"انا فرعون\" به عنوان نشانه‌ای از لعنت و نفرین یاد شده است."],[231,"لاجرم هر مرغ بی‌هنگام را","سر بریدن واجبست اعلام را","به‌طور قطع، هر پرنده‌ای که به‌موقع نخواند، باید سرش بریده شود؛ این اشاره به ضرورت یادآوری و آگاهی دادن به افراد در زمان مناسب دارد."],[231,"سر بریدن چیست کشتن نفس را","در جهاد و ترک گفتن تفس را","سر بریدن در اینجا به معنای کشتن نفس است، یعنی تحت کنترل درآوردن خواسته‌ها و میل‌های نفسانی خود در مسیر جهاد (مبارزه با نفس) و دوری از تفس (تفسیر یا توضیحات بی‌محتوا و غیراصولی)."],[231,"آنچنانک نیش کزدم بر کنی","تا که یابد او ز کشتن ایمنی","اگر نیش زهرآلودی را در بدن خود قطع کنی، این‌گونه است که جان تو در امان می‌ماند و از مرگ نجات می‌یابی."],[231,"بر کنی دندان پر زهری ز مار","تا رهد مار از بلای سنگسار","اگر دندان محصولات زهرآلود مار را از او بکشیم، مار به خطر سنگسار (عذاب و مجازات) نخواهد افتاد."],[231,"هیچ نکشد نفس را جز ظل پیر","دامن آن نفس‌کش را سخت گیر","تنها سایه پروردگار و وجود پیر و سالخورده می‌تواند جان را حفظ کند و از آسیب‌ها دور نگه‌دارد، پس باید با جدیت از این نفس نگهداری کرد."],[231,"چون بگیری سخت آن توفیق هوست","در تو هر قوت که آید جذب اوست","هرگاه توفیق و موفقیتی را به سختی به دست بیاوری، بدان که نیرویی که در تو وجود دارد، به سمت آن توفیق جذب می‌شود و از حالت عادی و طبیعی خود فراتر می‌رود."],[231,"ما رمیت اذ رمیت راست دان","هر چه کارد جان بود از جان جان","هر وقت تو چیزی را می‌زنی، در واقع خودت به آن نشانه نمی‌زنی، بلکه جانی که در توست و به تو زندگی می‌دهد، آن کار را می‌کند. در حقیقت، همه‌ی کارهایی که انجام می‌دهی از وجود جان تو سرچشمه می‌گیرد."],[231,"دست گیرنده ویست و بردبار","دم بدم آن دم ازو اومید دار","دست‌گیرنده یعنی کسی که به کمک می‌آید و بردبار به معنای صبور است. بنابراین، این بیت می‌گوید که صبر و امید از خداوند را همیشه در دل داشته باش، زیرا هر لحظه ممکن است او به کمک تو بیاید."],[231,"نیست غم گر دیر بی او مانده‌ای","دیرگیر و سخت‌گیرش خوانده‌ای","اگر خیلی وقت هم بدون او مانده‌ای، نگران نباش، چون او را دیر و سخت‌گیر می‌خوانند."],[231,"دیر گیرد سخت گیرد رحمتش","یک دمت غایب ندارد حضرتش","رحمت خداوند اگرچه دیر و با سختی به انسان می‌رسد، اما در هیچ زمانی از انسان غایب نیست و همیشه در دسترس است."],[231,"ور تو خواهی شرح این وصل و ولا","از سر اندیشه می‌خوان والضحی","اگر تو بخواهی در مورد این پیوستگی و دوستی الهی توضیح دهی، باید از سر تفکر و اندیشه، به آثار خداوند و نور او نظر کنی، نه از روی ظواهر یا احساسات شخصی."],[231,"ور تو گویی هم بدیها از ویست","لیک آن نقصان فضل او کیست","اگر تو بگویی که بدی‌ها از او(خدا) ناشی می‌شود، اما کمال و فضیلت او چه کسی است؟"],[231,"آن بدی دادن کمال اوست هم","من مثالی گویمت ای محتشم","بدی‌هایی که به نظر می‌رسد، در واقع نشانه کمال و بی‌نقصی اوست. برای اینکه بهتر بفهمی، مثالی برایت می‌زنم، ای بزرگوار."],[231,"کرد نقاشی دو گونه نقشها","نقشهای صاف و نقشی بی صفا","نقاشی دو نوع تصویر کشیده است: یکی تصاویر زیبا و صاف که خوب و دلنشین هستند و دیگری تصاویری بی‌صفا و زشت که ناخوشایند و ناپسند به نظر می‌رسند."],[231,"نقش یوسف کرد و حور خوش‌سرشت","نقش عفریتان و ابلیسان زشت","نقش زیبای یوسف و حورهای خوش‌خلق را کشید و هم‌چنین نقش زشت دیوان و ابلیس‌ها را هم به تصویر کشید."],[231,"هر دو گونه نقش استادی اوست","زشتی او نیست آن رادی اوست","هر دو نوع نقشی که می‌بینیم، از استاد بودن او ناشی می‌شود. بنابراین زشتی‌هایی که در دنیا وجود دارد، از خود او نیست، بلکه از رأی و حکمت اوست."],[231,"زشت را در غایت زشتی کند","جمله زشتیها به گردش بر تند","زشت را به نهایت زشتی می‌رساند، و تمام زشتی‌ها را به دور خود می‌چرخاند."],[231,"تا کمال دانشش پیدا شود","منکر استادیش رسوا شود","هنگامی که دانش فرد کامل شود، انکار او از استاد و معلمش آشکار و رسوا خواهد شد."],[231,"ور نداند زشت کردن ناقص است","زین سبب خلاق گبر و مخلص است","اگر کسی نداند که زشت کردن دیگران کار ناپسندی است، در نتیجه این عدم آگاهی منجر به این می‌شود که صفاتی مانند کفر و گوسفندگی در او به وجود آید."],[231,"پس ازین رو کفر و ایمان شاهدند","بر خداوندیش و هر دو ساجدند","کفر و ایمان هر دو نشانه‌ای از وجود خداوند هستند و در نهایت هر دو در برابر خداوند خضوع و سجده می‌کنند."],[231,"لیک مؤمن دان که طوعا ساجدست","زانک جویای رضا و قاصدست","ولی مؤمن بداند که در حال سجده با اختیار خودش است، زیرا او دنبال رضایت خداوند است و هدفش از سجده، جلب محبت و خشنودی اوست."],[231,"هست کرها گبر هم یزدان‌پرست","لیک قصد او مرادی دیگرست","اگرچه کرها (یعنی غیرمسلمانان) مثل زرتشتیان به یزدان (خدا) معتقدند، اما هدف و نیت آن‌ها در پرستش خدا چیز دیگری است و پیروی واقعی از دین نیست."],[231,"قلعه سلطان عمارت می‌کند","لیک دعوی امارت می‌کند","سلطان که ساختمان قصر خود را می‌سازد، در عین حال فقط ادعای سلطنت دارد و ممکن است کارهای او واقعی نباشد."],[231,"گشته یاغی تا که ملک او بود","عاقبت خود قلعه سلطانی شود","شخصی که بر ضد سلطنت (یا پادشاهی) قیام کرده و یاغی شده، در نهایت به موضع و سرزمین سلطنت خود دست می‌یابد."],[231,"مؤمن آن قلعه برای پادشاه","می‌کند معمور نه از بهر جاه","مؤمن آن قلعه‌ای را که برای پادشاه است، آباد می‌کند، اما این کار را نه به خاطر مقام و جایگاه خود، بلکه به خاطر تقوای الهی و هدف‌های معنوی انجام می‌دهد."],[231,"زشت گوید ای شه زشت‌آفرین","قادری بر خوب و بر زشت مهین","ای پادشاه، کسی که زشت می‌گوید، به نوعی ناپاکی اشاره می‌کند و در حقیقت، او فقط بر زیبایی و زشتی تسلط دارد و به آن‌ها نگاه می‌کند."],[231,"خوب گوید ای شه حسن و بها","پاک گردانیدیم از عیبها","ای پادشاه، خوبان زیبایی و ارزش را ستایش می‌کنند و ما شما را از عیب‌ها پاک گردانیدیم."],[232,"گفت پیغامبر مر آن بیمار را","این بگو کای سهل‌کن دشوار را","پیامبر به آن بیمار گفت: بگو، ای کسی که کارهای سخت را آسان می‌کنی."],[232,"آتنا فی دار دنیانا حسن","آتنا فی دار عقبانا حسن","خدایا، زیبایی و نیکی را در دنیا و آخرت به ما عطا کن."],[232,"راه را بر ما چو بستان کن لطیف","منزل ما خود تو باشی ای شریف","خداوند راه را برای ما مانند باغی زیبا قرار بده و منزلگاه ما خود تو باشی، ای بزرگوار."],[232,"مؤمنان در حشر گویند ای ملک","نی که دوزخ بود راه مشترک","مؤمنان در روز قیامت به فرشته می‌گویند که جهنم، که محل عذاب است، راه مشترک نیست و ما در این مسیر قرار نمی‌گیریم."],[232,"مؤمن و کافر برو یابد گذار","ما ندیدیم اندرین ره دود و نار","مؤمنان و کفار در قیامت با هم ملاقات می‌کنند، اما در این مسیر، ما چیزی از دود و آتش ندیدیم."],[232,"نک بهشت و بارگاه آمنی","پس کجا بود آن گذرگاه دنی","بهشت و جایگاه امنی وجود دارد، اما پس آن گذرگاه دنیایی که ما در آن هستیم کجاست؟"],[232,"پس ملک گوید که آن روضه خضر","که فلان جا دیده‌اید اندر گذر","ملک (فرشته) می‌گوید که همان باغ بهشتی که شما در فلان جا مشاهده کرده‌اید، متعلق به خضر است (که نماد زندگی جاودان و علم باطن است) و در دنیای مادی می‌گذارید."],[232,"دوزخ آن بود و سیاستگاه سخت","بر شما شد باغ و بستان و درخت","دوزخ همان جایی است که سیاست سخت و دشوار است، اما برای شما باغ و بستان و درخت به وجود آمده است."],[232,"چون شما این نفس دوزخ‌خوی را","آتشی گبر فتنه‌جوی را","شما این نفس سرکش و بدطینت را که همچون آتش فتنه‌جو است، به خوبی بشناسید."],[232,"جهدها کردید و او شد پر صفا","نار را کشتید از بهر خدا","شما تلاش‌های بسیاری کردید و نفس دوزخ‌خوی خود را از بین بردید و آن را برای خدا نابود کردید، و در نتیجه، جانتان پاک و باصفا شد."],[232,"آتش شهوت که شعله می‌زدی","سبزه تقوی شد و نور هدی","شهوات و desires انسانی که باعث ایجاد آتش و تلاطم می‌شوند، به وسیله تقوا و پرهیزکاری به سبزه‌ای روییده و به نور هدایت تبدیل شده‌اند."],[232,"آتش خشم از شما هم حلم شد","ظلمت جهل از شما هم علم شد","خشم شما به صبر تبدیل شد و جهل شما به علم و آگاهی رسید."],[232,"آتش حرص از شما ایثار شد","و آن حسد چون خار بد گلزار شد","حرص و طمع شما تبدیل به فداکاری و ایثار شده است، و حسد شما مانند خاری است در میان گلستان، یعنی احساسی ناخوشایند که به زیبایی‌ها آسیب می‌زند."],[232,"چون شما این جمله آتشهای خویش","بهر حق کشتید جمله پیش پیش","شما با ایثار و فدای خود، آتش‌های حرص و حسد را برای دستیابی به حقیقت خاموش کردید."],[232,"نفس ناری را چو باغی ساختید","اندرو تخم وفا انداختید","شما (مؤمنان) نفس سرکش و آتشین خود را همچون باغی سامان‌دهی کردید و در آن، دانه‌های وفا و صداقت را کاشته‌اید."],[232,"بلبلان ذکر و تسبیح اندرو","خوش سرایان در چمن بر طرف جو","بلبلان که به ذکر و تسبیح خدا مشغولند، در این باغ که شما ساخته‌اید، خوش آواز و شاداب هستند و در کنار جوی آب به زیبایی می‌خوانند."],[232,"داعی حق را اجابت کرده‌اید","در جحیم نفس آب آورده‌اید","شما دعوت‌کننده حقیقت را پاسخ گفته‌اید و در جهنم نفس، آب حیات را به وجود آورده‌اید."],[232,"دوزخ ما نیز در حق شما","سبزه گشت و گلشن و برگ و نوا","آتش دوزخ هم برای شما به خاطر اعمال نیک‌تان مانند یک باغ سرسبز و خوشبو شده و پر از آوازهای دل‌نواز است."],[232,"چیست احسان را مکافات ای پسر","لطف و احسان و ثواب معتبر","خیر و احسان چه پاداشی دارد، پسرم؟ لطف و احسان و ثواب ارزشمند و قابل احترام است."],[232,"نی شما گفتید ما قربانییم","پیش اوصاف بقا ما فانییم","شما گفتید که در برابر صفات پایدار الهی، ما قربانی هستیم و در واقع به خاطر این اوصاف از هستی خود صرف نظر کرده‌ایم."],[232,"ما اگر قلاش و گر دیوانه‌ایم","مست آن ساقی و آن پیمانه‌ایم","ما اگر بدحالم و یا دیوانه، به خاطر آن ساقی و آن جامی هستیم که به ما مستی می‌دهد."],[232,"بر خط و فرمان او سر می‌نهیم","جان شیرین را گروگان می‌دهیم","ما تسلیم دستور و اراده او هستیم و جان عزیزمان را در اختیار او می‌گذاریم."],[232,"تا خیال دوست در اسرار ماست","چاکری و جانسپاری کار ماست","تا وقتی که فکر و یاد دوست (خدا یا معشوق) در دل‌های ما وجود دارد، خدمتگزاری و فدای جان کردن، وظیفه و کار ماست."],[232,"هر کجا شمع بلا افروختند","صد هزاران جان عاشق سوختند","هر جایی که شمع درد و رنج روشن شده، هزاران انسان عاشق برای عشق و معشوق خود جان می‌دهند و از عشق می‌سوزند."],[232,"عاشقانی کز درون خانه‌اند","شمع روی یار را پروانه‌اند","عاشقانی که در درون خانه هستند، همانند پروانه‌هایی هستند که دور شمع (روی) معشوق می‌چرخند."],[232,"ای دل آنجا رو که با تو روشنند","وز بلاها مر تو را چون جوشنند","ای دل، به جایی برو که اهل عشق و محبت با تو در روشنایی هستند و تو را از بلاها و سختی‌ها همچون زره و سپر محافظت می‌کنند."],[232,"بر جنایاتت مواسا می‌کنند","در میان جان ترا جا می‌کنند","در برابر گناهانت به تو تسلی می‌دهند و در درون جانت برای تو مکانی فراهم می‌کنند."],[232,"زان میان جان تو را جا می‌کنند","تا تو را پر باده چون جامی‌ کنند","در آنجا، جان تو را درون خود جای می‌دهند تا مانند جامی پر از شراب، تو را پر کنند."],[232,"در میان جان ایشان خانه گیر","در فلک خانه کن ای بدر منیر","در دل یا جان آن افراد مقدس و روشن، جا بگیر و در آسمان منزلت را قرار بده، ای ماه روشن."],[232,"چون عطارد دفتر دل وا کنند","تا که بر تو سرها پیدا کنند","زمانی که سیاره عطارد (که به علم و نوشتن مرتبط است) دل‌ها را باز کند و رازهای درون آن‌ها را نمایان سازد، آدم‌ها و انسان‌ها به راحتی فکر و احساسات خود را نشان می‌دهند و خود را به شما معرفی می‌کنند."],[232,"پیش خویشان باش چون آواره‌ای","بر مه کامل زن ار مه پاره‌ای","با خانواده‌ات مانند کسی که آواره و بی‌خانمان است، رفتار کن؛ اگر بر توست که با کسی به خوبی رفتار کنی، باید به طور کامل و بدون نقص این کار را انجام دهی، نه به شکلی ناچیز یا ناقص."],[232,"جزو را از کل خود پرهیز چیست","با مخالف این همه آمیز چیست","جزئی از کل را ترک کردن چه معنا دارد و چرا باید با چیزی که مخالف آن است، اختلاط کرد؟"],[232,"جنس را بین نوع گشته در روش","غیبها بین عین گشته در رهش","مفهوم این بیت آن است که در دنیای غیب، «جنس» (ماهیت) چیزی به نوعی خاص تبدیل شده و در عین حال در مسیر خود به «عین» (شکل و واقعیت) پیدایش می‌رسد. به عبارت دیگر، در عالم ن unseen، ماهیت‌ها به صورت‌های خاصی در می‌آیند و در آنجا تجلی پیدا می‌کنند."],[232,"تا چو زن عشوه خری ای بی‌خرد","از دروغ و عشوه کی یابی مدد","ای نادان، تا زمانی که مانند زن با ناز و فریبکاری می‌خواهی به هدف برسی، از دروغ و فریب چه کمکی می‌توانی بگیری؟"],[232,"چاپلوس و لفظ شیرین و فریب","می‌ستانی می‌نهی چون زن به جیب","تو از چاپلوسی و تملق گفتن و استفاده از کلمات شیرین و فریبنده برای به دست آوردن چیزی بهره می‌گیری، مانند زنی که با ناز و کرشمه چیزی را از مردان می‌گیرد."],[232,"مر تو را دشنام و سیلی شهان","بهتر آید از ثنای گمرهان","بهتر است تو از شاهان دشنام و سیلی بگیری تا اینکه از مردم نادان ستایش و تمجید بشنوی."],[232,"صفع شاهان خور مخور شهد خسان","تا کسی گردی ز اقبال کسان","از خوراک و نعمت‌های شاهان پرهیز کن و به شهد و لذت‌های بی‌ارزش دیگران (گمره) دل خوش نکن، چون این کار باعث می‌شود که از اقبال و خوشبختی دیگران بهره‌مند شوی."],[232,"زانک ازیشان خلعت و دولت رسد","در پناه روح جان گردد جسد","چون از این افراد (خسروان) نعمت و ثروت به کسی می‌رسد، روح او در سایه آنها زنده می‌شود و جسم او به حیات می‌آید."],[232,"هر کجا بینی برهنه و بی‌نوا","دان که او بگریختست از اوستا","هرجا که ببینی کسی عریان و بی‌پناه است، بدان که او از حقیقت و معنای اصلی زندگی دور شده و از آن فاصله گرفته است."],[232,"تا چنان گردد که می‌خواهد دلش","آن دل کور بد بی‌حاصلش","او که دلش نادان و بی‌فایده است، باید به حالتی برسد که دلش آنچه را می‌خواهد به دست آورد و از حالت کنونی‌اش رهایی یابد."],[232,"گر چنان گشتی که استا خواستی","خویش را و خویش را آراستی","اگر به‌گونه‌ای شدی که خواهان استاد خود هستی و خود را برای او آراسته‌ای،"],[232,"هر که از استا گریزد در جهان","او ز دولت می‌گریزد این بدان","کسی که از استاد و آموزگار خود دوری کند، در واقع از برکت و نعمت‌های دنیا هم دور می‌شود. این به این معناست که ارتباط با استاد و یادگیری از او، منجر به بهره‌مندی از فیوضات و موفقیت‌ها در زندگی می‌شود."],[232,"پیشه‌ای آموختی در کسب تن","چنگ اندر پیشه دینی بزن","اگر در دنیا شغلی یاد گرفته‌ای، در کسب و کار دنیوی خود را مشغول کن، اما در زمینه دین هم فعالیتی داشته باش و به آن اهمیت بده."],[232,"در جهان پوشیده گشتی و غنی","چون برون آیی ازینجا چون کنی","وقتی که در این دنیا پنهان و بی‌نیاز شدی، زمانی که از اینجا خارج شوی، چه‌طور باید رفتار کنی؟"],[232,"پیشه‌ای آموز کاندر آخرت","اندر آید دخل کسب مغفرت","در این دنیا حرفه‌ای بیاموز که در آخرت نیز از آن سود می‌بری و درآمدت به مغفرت (آمرزش) خواهد انجامید."],[232,"آن جهان شهریست پر بازار و کسب","تا نپنداری که کسب اینجاست حسب","آن جهان (آخرت) شهری است پر از بازار و کار و فعالیت، پس نگو که کار و درآمد فقط در این دنیا (دنیا) است، که اینجا صرفا به صورت بازی و سرگرمی به نظر می‌رسد."],[232,"حق تعالی گفت کین کسب جهان","پیش آن کسبست لعب کودکان","خداوند متعال فرموده است که این کسب و کار در جهان در مقایسه با کسب واقعی، مثل بازی بچه‌هاست و ارزش چندانی ندارد."],[232,"همچو آن طفلی که بر طفلی تند","شکل صحبت‌کن مساسی می‌کند","شخصی مانند کودک که با دیگری بازی می‌کند، در گفتار و رفتار خود از حرکات و گفتارهای دیگران تقلید می‌کند."],[232,"کودکان سازند در بازی دکان","سود نبود جز که تعبیر زمان","کودکان در بازی خود دکان درست می‌کنند، اما این کار هیچ سودی ندارد و فقط نمایشی از زمان حال است."],[232,"شب شود در خانه آید گرسنه","کودکان رفته بمانده یک تنه","در شب، کودکان گرسنه به خانه برمی‌گردند و تنها از بازی که کرده‌اند، چیزی برای خوردن ندارند."],[232,"این جهان بازی‌گهست و مرگ شب","باز گردی کیسه خالی پر تعب","این جهان مانند یک بازی است و هنگام مرگ، انسان مانند کسی است که در پایان شب به خانه برمی‌گردد و در کیسه‌اش هیچ چیزی جز رنج و تعب ندارد."],[232,"کسب دین عشقست و جذب اندرون","قابلیت نور حق را ای حرون","کسب دین، همان عشق به خداوند است و جذب کردن قابلیت دریافت نور حق در درون انسان می‌باشد، ای حرون (جانی که مثالی از انسان‌های با ظرفیت است)."],[232,"کسب فانی خواهدت این نفس خس","چند کسب خس کنی بگذار بس","نفس‌ام (که به خاطر وجودش دچار مشکلات و محدودیت‌ها هستی) چیزهای دنیا را فانی و زودگذر می‌خواهد. اگر به دنبال چیزهای بی‌ارزش و ناکام‌کننده باشی، دیگر جایی برای بزرگی و ارزش‌ها نخواهد ماند، پس بهتر است به دنبال این امور بی‌مورد نروی."],[232,"نفس خس گر جویدت کسب شریف","حیله و مکری بود آن را ردیف","اگر نفس پست و زشت تو بخواهد چیزی با ارزش و شریف را جستجو کند، این خواسته ناشی از فریب و حیله است و نمی‌تواند صدق داشته باشد."],[233,"در خبر آمد که آن معّاویه","خفته بد در قصر در یک زاویه","معاویه در حالی که در گوشه‌ای از قصر خوابیده بود، خبرهایی را درباره او شنیدند."],[233,"قصر را از اندرون در بسته بود","کز زیارتهای مردم خسته بود","معاویه در قصر خود به‌خواب رفته بود و درون قصر را از مردم بسته بود، زیرا از دیدن و زیارت مردم خسته شده بود."],[233,"ناگهان مردی ورا بیدار کرد","چشم چون بگشاد پنهان گشت مرد","ناگهان مردی ابلیس معاویه را بیدار کرد و وقتی او چشمش را باز کرد، آن مرد ناپدید شد."],[233,"گفت اندر قصر کس را ره نبود","کیست کین گستاخی و جرات نمود","در قصر کسی حق ورود ندارد و او از کجا جرات کرده که به اینجا بیاید و چنین گستاخی کند؟"],[233,"گرد برگشت و طلب کرد آن زمان","تا بیاید زان نهان گشته نشان","او (ابلیس) به عقب برگشت و در پی آن زمان بود تا نشانه‌ای از آن کسی که پنهان شده بود، پیدا کند."],[233,"او پس در مدبری را دید کو","در پس پرده نهان می‌کرد رو","مولانا در این بیت به ابلیس اشاره می‌کند که در زیرکی و فریبندگی خود، چهره‌اش را پنهان کرده و در پس پرده، خود را مخفی نگه داشته است. او به طور زیرکانه در تلاش است تا از دید و شناخت پنهان بماند."],[233,"گفت هی تو کیستی نام تو چیست","گفت نامم فاش ابلیس شقیست","او گفت: \"تو که هستی و نامت چیست؟\" ابلیس با قاطعیت پاسخ داد: \"نام من ابلیس است و من شقی و بدبختم."],[233,"گفت بیدارم چرا کردی بجد","راست گو با من مگو بر عکس و ضد","ابلیس می‌گوید: بیدارم و چرا مرا به زحمت انداختی؟ راست بگو و از موضوع اصلی دور نشو و برخلاف نگویی."],[234,"گفت هنگام نماز آخر رسید","سوی مسجد زود می‌باید دوید","زمان نماز به پایان نزدیک شده است، بنابراین باید هر چه سریع‌تر به سوی مسجد بروید."],[234,"عجلوا الطاعات قبل الفوت گفت","مصطفی چون در معنی می‌بسفت","مصطفی (پیامبر اسلام) گفت: قبل از آنکه فرصت از دست برود، در انجام کارهای شایسته و نیک hurry به تلاش بشتابید."],[234,"گفت نی نی این غرض نبود تو را","که بخیری ره‌نما باشی مرا","معاویه به ابلیس می‌گوید که هدفش از آمدن به اینجا این نیست که تو را راهنمای خیر کند."],[234,"دزد آید از نهان در مسکنم","گویدم که پاسبانی می‌کنم","دزدی به طور پنهانی به خانه‌ام می‌آید و به من می‌گوید که در حال نگهبانی هستم."],[234,"من کجا باور کنم آن دزد را","دزد کی داند ثواب و مزد را","من چگونه می‌توانم به آن دزد اعتماد کنم؟ آیا دزد می‌تواند درباره پاداش و ثواب صحبت کند؟"],[235,"گفت ما اول فرشته بوده‌ایم","راه طاعت را بجان پیموده‌ایم","ابلیس می‌گوید که ما در آغاز فرشته بوده‌ایم و راه اطاعت خدا را با تمام وجود طی کرده‌ایم."],[235,"سالکان راه را محرم بدیم","ساکنان عرش را همدم بدیم","سالکان راه حقیقت و معرفت را به عنوان کسانی که در این مسیر تلاش می‌کنند، به مقام و جایگاه بلند روحانی نزدیک می‌کنیم و ساکنان عرش (فرشتگان و موجودات الهی) را در این سفر معنوی، همدم و همراه آنان قرار می‌دهیم."],[235,"پیشه اول کجا از دل رود","مهر اول کی ز دل بیرون شود","مهر و عشق نخستین هرگز از دل نمی‌رود و احساسات اولیه‌ی انسان نسبت به آنچه که برایش عزیز است، همواره در دل باقی می‌ماند."],[235,"در سفر گر روم بینی یا ختن","از دل تو کی رود حب الوطن","هر جا که بروم، چه به سفر و چه به ختن (منطقه‌ای در چین)، عشق به سرزمین خود از دل من نمی‌رود."],[235,"ما هم از مستان این می بوده‌ایم","عاشقان درگه وی بوده‌ایم","ما هم از آن دیوانگان شراب عشق او بوده‌ایم و عاشق درگاه او هستیم."],[235,"ناف ما بر مهر او ببریده‌اند","عشق او در جان ما کاریده‌اند","ما از ابتدا و به طور طبیعی برای عشق به او به وجود آمده‌ایم و این عشق در اعماق وجود ما ریشه دوانده است."],[235,"روز نیکو دیده‌ایم از روزگار","آب رحمت خورده‌ایم اندر بهار","در روزگار خوب، خوشبختی و سرزندگی را تجربه کرده‌ایم و مانند گیاهانی که در بهار آب رحمت می‌نوشند، از این نعمت‌ها بهره‌مند شده‌ایم."],[235,"نی که ما را دست فضلش کاشتست","از عدم ما را نه او بر داشتست","نی که ما را با دست لطف و کرمش پرورش داده، از وجود ناموجود ما چیزی نیافریده و ما را از عدم به وجود نیاورده است."],[235,"ای بسا کز وی نوازش دیده‌ایم","در گلستان رضا گردیده‌ایم","بسیاری از نعمت‌ها و محبت‌هایی که از او (خدا) دریافت کرده‌ایم، ما را در دنیایی باصفا و آرامش بخش گردانیده است."],[235,"بر سر ما دست رحمت می‌نهاد","چشمه‌های لطف از ما می‌گشاد","خداوند بر سر ما رحمت و محبت می‌نهد و بهترین نعمت‌ها و لطف‌ها را به سوی ما سرازیر می‌کند."],[235,"وقت طفلی‌ام که بودم شیرجو","گاهوارم را کی جنبانید او","در زمانی که من کودک بودم و از شیر جو (شیر مادر) بهره‌مند می‌شدم، چه کسی گهواره‌ام را جنباند و به من پر و بال داد؟"],[235,"از کی خوردم شیر غیر شیر او","کی مرا پرورد جز تدبیر او","از چه کسی شیر غیر از شیر او را نوشیدم؟ چه کسی مرا پرورش داده جز تدبیر او؟"],[235,"خوی کان با شیر رفت اندر وجود","کی توان آن را ز مردم واگشود","شیر به معنی صفات نیک و ویژگی‌های والای الهی است و این بیت می‌گوید که انسان به طور طبیعی با ویژگی‌های خوب خداوند گره خورده است؛ بنابراین نمی‌تواند آن ویژگی‌ها را از وجود خود جدا کند."],[235,"گر عتابی کرد دریای کرم","بسته کی گردند درهای کرم","اگر دریای بخشش و کرم بر کسی خشم کند و عتابی داشته باشد، در آن حال درهای کرم و بخشش بسته می‌شود و دیگر کسی نمی‌تواند از آن بخشش بهره‌مند شود."],[235,"اصل نقدش داد و لطف و بخششست","قهر بر وی چون غباری از غشست","نقد و بررسی واقعی او، در واقع همان لطف و بخشش است، اما زمانی که قهر و سخت‌گیری بر او حاکم می‌شود، مانند غباری ناپیدا و زودگذر بر او سایه می‌اندازد."],[235,"از برای لطف عالم را بساخت","ذره‌ها را آفتاب او نواخت","خداوند به خاطر رحمتش، جهان را خلق کرد و ذرات را برکت داد، همچون آفتابی که به آنها نور می‌بخشد."],[235,"فرقت از قهرش اگر آبستنست","بهر قدر وصل او دانستنست","اگر جدایی از قهر خداوند وجود دارد، این جدایی همانند باردار شدن است، زیرا به اندازه شناخت زمان وصال او اهمیت دارد."],[235,"تا دهد جان را فراقش گوشمال","جان بداند قدر ایام وصال","فراق معشوق به جان آسیب می‌زند و درک ارزش لحظات وصال را به جان می‌آموزد."],[235,"گفت پیغامبر که حق فرموده است","قصد من از خلق احسان بوده است","پیامبر گفته است که خداوند تأکید کرده است که هدف من از آفرینش انسان، نیکی و احسان به آنها بوده است."],[235,"آفریدم تا ز من سودی کنند","تا ز شهدم دست‌آلودی کنند","من انسان‌ها را آفریدم تا از من بهره‌مند شوند و از خوبی‌هایم بهره‌برداری کنند."],[235,"نه برای آنک تا سودی کنم","وز برهنه من قبایی بر کنم","من نه به این منظور آفریده‌ام که سودی به من برسانید، و نه برای این‌که از برهنگی خودم، لباسی بسازم."],[235,"چند روزی که ز پیشم رانده‌ست","چشم من در روی خوبش مانده‌ست","چند روزی است که چشم من از او دور شده، اما همچنان به زیبایی او چشم دوخته‌ام و نمی‌توانم از آن دل بکنم."],[235,"کز چنان رویی چنین قهر ای عجب","هر کسی مشغول گشته در سبب","عجب است که از چهره‌ای به این زیبایی چنین قهر و جدایی به وجود آمده و هر کسی در پی علت آن است."],[235,"من سبب را ننگرم کان حادثست","زانک حادث حادثی را باعثست","من به علتی که سبب این رویداد است توجه نمی‌کنم، زیرا آن رویداد خود، ناشی از حادثه‌ای دیگر است که آن نیز به یک علت وابسته است."],[235,"لطف سابق را نظاره می‌کنم","هرچه آن حادث دو پاره می‌کنم","من به نگاه‌کردن به لطف و محبت‌های قبلی خداوند مشغولم و هرچه اتفاقات و وقایع جدید را که در زندگی‌ام رخ می‌دهد، به دو بخش تقسیم می‌کنم."],[235,"ترک سجده از حسد گیرم که بود","آن حسد از عشق خیزد نه از جحود","من به‌خاطر حسدی که دارم از سجده کردن خودداری می‌کنم، چرا که این حسد ناشی از عشق است و نه از انکار و کفر."],[235,"هر حسد از دوستی خیزد یقین","که شود با دوست غیری همنشین","هر حسدی که وجود داشته باشد، از دوستی و محبت به کسی ناشی می‌شود و یقینا باعث می‌شود که با کسی غیر از دوست خود هم‌نشین شوید."],[235,"هست شرط دوستی غیرت‌پزی","همچو شرط عطسه گفتن دیر زی","دوستی واقعی نیازمند غیرت و شرافت است، درست مانند اینکه در هنگام عطسه، انسان باید تاخیر کند و سپس عطسه کند."],[235,"چونک بر نطعش جز این بازی نبود","گفت بازی کن چه دانم در فزود","چون جز این بازی را روی میز او قرار ندادند، گفت: بازی کن، من نمی‌دانم که چه چیز دیگری در پیش است."],[235,"آن یکی بازی که بد من باختم","خویشتن را در بلا انداختم","معنی مصرع اول این بیت ،به من بازی تحمیل شد و من مجبور شدم بازی کردم،در این مصرع باختم به معنای بازی کردن است"],[235,"در بلا هم می‌چشم لذات او","مات اویم مات اویم مات او","در گرفتاری و مشکل هم از لذت‌های او بهره‌مند می‌شوم و به او وابسته و تسلیم شده‌ام."],[235,"چون رهاند خویشتن را ای سره","هیچ کس در شش جهت از ششدره","وقتی کسی خود را از بند رها کند، در هیچ‌کجا اسیر شش جهت (یعنی جهات دنیا، مانند بالا و پایین، جلو و عقب، راست و چپ) نخواهد شد و از این وضعیت فراتر می‌رود."],[235,"جزو شش از کل شش چون وا رهد","خاصه که بی چون مرورا کژ نهد","اگر بخشی از وجود آدمی که متعلق به شیش (عالم مادی) است، جدا شود، خاص و منحصر به فرد خواهد بود و به این ترتیب دیگر رویکردش به زندگی غیر مستقیم و کج خواهد شد."],[235,"هر که در شش او درون آتشست","اوش برهاند که خلاق ششست","هر کس که در وجود خود گرفتار آتش و عذاب است، او را نجات دهد، چرا که خالق آتش، خالق همه چیز است و می‌تواند او را از آن رنج آزاد کند."],[235,"خود اگر کفرست و گر ایمان او","دست‌باف حضرتست و آن او","اگرچه او ممکن است کافر یا مؤمن باشد، اما آنچه که به او تعلق دارد، دست بافته خداوند است."],[236,"گفت امیر او را که اینها راستست","لیک بخش تو ازینها کاستست","امیر (معاویه) به ابلیس می‌گوید که این گفته‌ها حقیقت دارند، اما سهم تو از این حقیقت بسیار کمتر است."],[236,"صد هزاران را چو من تو ره زدی","حفره کردی در خزینه آمدی","تو به اندازه صد هزار نفر مانند من، به مردم آسیب رسانده‌ای و خزانه آنها را خالی کرده‌ای."],[236,"آتشی از تو نسوزم چاره نیست","کیست کز دست تو جامه‌ش پاره نیست","از تو آتش نگرفته‌ام و چاره‌ای نیست، مگر آنکه بگویم کسی نیست که از دست تو و آسیب تو آسیب نبیند و در نتیجه لباسش پاره نشود."],[236,"طبعت ای آتش چو سوزانیدنیست","تا نسوزانی تو چیزی چاره نیست","ای طبیعت، اگر آتش وجود تو سوزاننده نیست، پس تا زمانی که تو چیزی نسوزانی، چاره‌ای نخواهد بود."],[236,"لعنت این باشد که سوزانت کند","اوستاد جمله دزدانت کند","لعنت این است که آن کسی که باید تو را نجات دهد، به آتش سوزانت می‌کند و تمام دزدها و مکاران را به تو نزدیک می‌کند."],[236,"با خدا گفتی شنیدی روبرو","من چه باشم پیش مکرت ای عدو","تو با خدا گفتی که می‌دانی من در برابر مکر تو، ای دشمن، چه کسی هستم و چه جایگاهی دارم."],[236,"معرفتهای تو چون بانگ صفیر","بانگ مرغانست لیکن مرغ گیر","معرفت‌های تو مانند صدای زیبا و دلنشین پرنده‌هاست، اما تو به جای اینکه تنها به صدای آنها گوش دهی، در دام آنها گرفتار می‌شوی."],[236,"صد هزاران مرغ را آن ره زدست","مرغ غره کآشنایی آمدست","اینجا اشاره به این است که صدها پرنده در دام و فریب گرفتار شده‌اند، زیرا پرنده‌ای از آنها برای خودی نشان دادن و نزدیکی به آشنا آمده است. این موضوع به نوعی گوشزد می‌کند که آشنایی و ظاهرسازی می‌تواند منجر به فریب و به دام افتادن دیگران شود."],[236,"در هوا چون بشنود بانگ صفیر","از هوا آید شود اینجا اسیر","وقتی در هوا صدای صفیری را بشنود، به‌سوی آن صدا می‌آید و در اینجا گرفتار می‌شود."],[236,"قوم نوح از مکر تو در نوحه‌اند","دل کباب و سینه شرحه شرحه‌اند","قوم نوح به خاطر فریب تو به شدت در غم و اندوه هستند، دل‌هایشان آتش گرفته و سینه‌هایشان پاره‌پاره شده است."],[236,"عاد را تو باد دادی در جهان","در فکندی در عذاب و اندهان","تو باد و هوا را به عاد (قوم عاد) عطا کردی و آنها را در عذاب و بلا قرار دادی."],[236,"از تو بود آن سنگسار قوم لوط","در سیاهابه ز تو خوردند غوط","سنگسار قوم لوط (یک قوم با مردمی که به گناه می‌زیستند) بر اثر دستور تو بود و آن‌ها در تاریکی (گمراهی) به این سرنوشت دچار شدند."],[236,"مغز نمرود از تو آمد ریخته","ای هزاران فتنه‌ها انگیخته","نخستین دلیل فریب نمرود، که در داستان‌های دینی به‌عنوان یکی از طغیان‌گران مطرح است، از توست و تو موجب شده‌ای که او هزاران فتنه و آشوب به‌پا کند."],[236,"عقل فرعون ذکی فیلسوف","کور گشت از تو نیابید او وقوف","عقل فرعون، که فیلسوفی زیرک بود، به خاطر تو به حالت جهل و نادانی افتاد و نتوانست حقیقت را درک کند."],[236,"بولهب هم از تو نااهلی شده","بوالحکم هم از تو بوجهلی شده","بولهب (ابولهب، یکی از مخالفان پیامبر اسلام) به واسطه تو نادان شده و بوالحکم (ابو جهل، فرد دیگری از مخالفان پیامبر) نیز به خاطر تو جاهل گردیده است."],[236,"ای برین شطرنج بهر یاد را","مات کرده صد هزار استاد را","ای کسی که در این شطرنج بزرگ، یاد و خاطره را به گونه‌ای به زمین زده‌ای که صدها استاد خبره را هم شکست داده‌ای."],[236,"ای ز فرزین‌بندهای مشکلت","سوخته دلها سیه گشته دلت","ای کسی که از بندهای زیبایی و جذابیت تو، دل‌ها سوخته و غمگین شده‌اند و دل خودت نیز در رنج و تیرگی است."],[236,"بحر مکری تو خلایق قطره‌ای","تو چو کوهی وین سلیمان ذره‌ای","مکر تو مانند دریایی بزرگ است که مردم فقط در آن مانند قطره‌ای کوچک هستند، در حالی که تو مانند کوهی هستی و این سلیمان (نماد قدرت و حکمت) تنها ذره‌ای در برابر توست."],[236,"کی رهد از مکر تو ای مختصم","غرق طوفانیم الا من عصم","ای دشمن، کی از مکر و فریب تو رها خواهد شد؟ ما مانند افرادی گرفتار طوفانی‌ هستیم که جز کسی که خدا او را محفوظ بدارد، هیچ‌کس نمی‌تواند نجات یابد."],[236,"بس ستاره سعد از تو محترق","بس سپاه و جمع از تو مفترق","بسیاری از خوشبختی‌ها و موفقیت‌ها که به وسیله تو به وجود می‌آیند از بین می‌روند و همچنین بسیاری از ارتش‌ها و گروه‌ها به خاطر تو پراکنده و متفرق می‌شوند."],[237,"گفت ابلیسش گشای این عقد را","من محکم قلب را و نقد را","ابلیس به معاویه گفت: این پیوند را باز کن، من قلب و ایمان را محکم و استوار می‌سازم."],[237,"امتحان شیر و کلبم کرد حق","امتحان نقد و قلبم کرد حق","خداوند در اینجا توانایی من را با آزمایش قدرت و شجاعت (شیر و کلبم) می‌سنجد و همچنین ارزش واقعی و باطن من (نقد و قلب) را مورد بررسی قرار می‌دهد."],[237,"قلب را من کی سیه‌رو کرده‌ام","صیرفی‌ام قیمت او کرده‌ام","من قلب خود را چگونه سیاه کرده‌ام؟ من مثل صیرفی (طلا فروش) ارزش او را تعیین کرده‌ام."],[237,"نیکوان را رهنمایی می‌کنم","شاخه‌های خشک را بر می‌کنم","من به نیکان و اشخاص خوب راهنمایی می‌کنم و موانع و مشکلات (مانند شاخه‌های خشک) را از سر راهشان بر می‌دارم تا بتوانند پیش بروند."],[237,"این علفها می‌نهم از بهر چیست","تا پدید آید که حیوان جنس کیست","من این علف‌ها را می‌کاشتم تا بفهمم حیوانات چه نوعی هستند و به چه صورت جلوه‌گری می‌کنند."],[237,"گرگ از آهو چو زاید کودکی","هست در گرگیش و آهویی شکی","اگر گرگی از آهو فرزندی به دنیا آورد، در وجود آن بچه گرگ، هم ویژگی‌های گرگ وجود دارد و هم ویژگی‌های آهو."],[237,"تو گیاه و استخوان پیشش بریز","تا کدامین سو کند او گام تیز","تو باید گیاه و استخوان را پیش او بریزی تا آن را ببیند و ببیند که به کدام سو می‌خواهد برود و تصمیم به تند راه رفتن بگیرد."],[237,"گر به سوی استخوان آید سگست","ور گیا خواهد یقین آهو رگست","اگر سگ به سمت استخوان بیاید، طبیعتش مشخص است، اما اگر به گیاه تمایل پیدا کند، به یقین از آن آهو به رگ می‌رسد، یعنی در جستجوی چیزی نرم و لذیذتر است."],[237,"قهر و لطفی جفت شد با همدگر","زاد ازین هر دو جهانی خیر و شر","قهر و لطف با هم به وجود آمده‌اند و از این دو ویژگی، دو جهان خیر و شر شکل گرفته است."],[237,"تو گیاه و استخوان را عرضه کن","قوت نفس و قوت جان را عرضه کن","تو باید گیاه و استخوان را در معرض دید قرار دهی؛ یعنی باید مواد طبیعی و مادی زندگی را فراهم کنی، همچنین باید قوت نفس و قوت جان، یعنی نیازهای روح و معنویت را نیز معرفی و تامین کنی."],[237,"گر غذای نفس جوید ابترست","ور غذای روح خواهد سرورست","اگر کسی فقط به دنبال غذا و نیازهای جسمی باشد، بی‌فایده و ناقص است، اما اگر به دنبال غذا و نیازهای روحی باشد، به مقام و بزرگی دست خواهد یافت."],[237,"گر کند او خدمت تن هست خر","ور رود در بحر جان یابد گهر","اگر کسی به بدن و مادیات خدمت کند، مانند الاغ خواهد بود، اما اگر در دریا (یعنی عمق روح و معنویات) غوطه‌ور شود، به جواهراتی (دانش و معرفت) دست می‌یابد."],[237,"گرچه این دو مختلف خیر و شرند","لیک این هر دو به یک کار اندرند","هرچند این دو (انبیا و دشمنان شهوات) در ماهیت خود خیر و شر هستند و متفاوت‌اند، اما هردو در یک هدف مشترک فعالیت می‌کنند."],[237,"انبیا طاعات عرضه می‌کنند","دشمنان شهوات عرضه می‌کنند","پیامبران عبادت و اطاعتی را ارائه می‌دهند که موجب نزدیکی به خداوند است، اما دشمنان، لذایذ و شهواتی را ارائه می‌دهند که انسان را از راه راست منحرف می‌کند."],[237,"نیک را چون بد کنم یزدان نیم","داعیم من خالق ایشان نیم","من نمی‌توانم چیزی را که نیک است به بدی تبدیل کنم، زیرا خداوند من خالق این امور نیستم و نمی‌توانم اراده‌ام را بر اراده‌ی او تحمیل کنم."],[237,"خوب را من زشت سازم رب نه‌ام","زشت را و خوب را آیینه‌ام","من می‌توانم چیزی را که خوب است، زشت جلوه دهم، اما نمی‌توانم زشت را خوب نمایان کنم؛ من مانند آینه‌ای هستم که فقط خوبی‌ها را نشان می‌دهند."],[237,"سوخت هندو آینه از درد را","کین سیه‌رو می‌نماید مرد را","هندو، به خاطر درد و ناراحتی، آینه را شکست زیرا چهره سیه‌رو (زشت) را در آن می‌دید که نمایانگر او بود."],[237,"گفت آیینه گناه از من نبود","جرم او را نه که روی من زدود","آیینه (که نماد حقیقت و روشنی است) می‌گوید که من در گناه نقشی ندارم و این خود آن سیاه‌رو (فرد گناهکار) است که چهره‌اش را از من پنهان کرده است."],[237,"او مرا غماز کرد و راست‌گو","تا بگویم زشت کو و خوب کو","او (عباس) مرا خبرچینی کرد و حقیقت را بیان کرد تا من بتوانم بگویم چه چیز زشت و چه چیز خوب است."],[237,"من گواهم بر گوا زندان کجاست","اهل زندان نیستم ایزد گواست","من به عنوان شاهد می‌گویم که زندان کجاست، ولی من اهل زندان نیستم؛ خداوند است که می‌تواند به عنوان شاهد حقیقی بر این موضوع گواهی دهد."],[237,"هر کجا بینم نهال میوه‌دار","تربیتها می‌کنم من دایه‌وار","هر جا که نهال میوه‌دار ببینم، آن را پرورش می‌دهم و مانند یک دایه به او رسیدگی می‌کنم."],[237,"هر کجا بینم درخت تلخ و خشک","می‌برم من تا رهد از پشک مشک","هر کجا درخت تلخ و خشک را ببینم، آن را می‌برم تا از بوی بد و آزار آن، که شبیه به بوی پشک است، رهایی یابم."],[237,"خشک گوید باغبان را کای فتی","مر مرا چه می‌بری سر بی خطا","باغبان به خشک و بی‌ثمر بودن درخت اشاره می‌کند و از او می‌پرسد که چرا آن را می‌برد، در حالی که او (باغبان) هیچ خطایی نکرده است."],[237,"باغبان گوید خمش ای زشت‌خو","بس نباشد خشکی تو جرم تو","باغبان به ابلیس می‌گوید: ای زشت‌خو، ساکت باش، زیرا خشکی تو و حالت سرد دلیل بر گناه و مجازات تو نیست."],[237,"خشک گوید راستم من کژ نیم","تو چرا بی‌جرم می‌بری پیم","من راست می‌گویم که من خشک و نگران هستم، اما تو چرا بدون اینکه گناهی داشته باشم، مرا تنبیه می‌کنی؟"],[237,"باغبان گوید اگر مسعودیی","کاشکی کژ بودیی تر بودیی","باغبان می‌گوید: اگر مسعود (شخصی مشخص) کمی کج و معوج بود، شاید بهتر از حال حاضرش بود."],[237,"جاذب آب حیاتی گشتیی","اندر آب زندگی آغشتیی","تو به آب زندگی جذب شده‌ای و در این آب با زندگی هماهنگ شده‌ای."],[237,"تخم تو بد بوده است و اصل تو","با درخت خوش نبوده وصل تو","خصلت و سرشت تو از ابتدا نیکو نبوده و ریشه وجود تو با طبیعت خوب و خوش پیوندی ندارد."],[237,"شاخ تلخ ار با خوشی وصلت کند","آن خوشی اندر نهادش بر زند","اگر شاخ درخت تلخ با درخت خوشی پیوند بخورد، گلی که از آن به بار آید، در واقع تلخی را نیز به دل خود خواهد آورد."],[238,"گفت امیر ای راه‌زن حجت مگو","مر تو را ره نیست در من ره مجو","امیر راه‌زن به ابلیس می‌گوید که صحبت از حجت و دلیل نکن، زیرا تو در من هیچ راهی نداری و نباید به دنبال راهی باشی."],[238,"ره‌زنی و من غریب و تاجرم","هر لباساتی که آری کی خرم","من در سفر هستم و غریبی می‌کنم، حالا تو که دزد راه‌ها هستی، خیال نکن که می‌توانی هر لباس یا پوششی را بر تن من کنی و مرا خوشحال کنی."],[238,"گرد رخت من مگرد از کافری","تو نه‌ای رخت کسی را مشتری","دور و بر من نچرخ و به من نزدیک نشو، چون تو خود کافر و بی‌ایمان هستی و هیچ‌گاه کسی تو را به عنوان مشتری نمی‌خرد."],[238,"مشتری نبود کسی را راه‌زن","ور نماید مشتری مکرست و فن","هیچ کس در دنیا مشتری و خواهان چنین راه‌زنی نیست، اما اگر کسی سر راه او قرار بگیرد، با فریب و حقه بازی او را به دام می‌اندازد."],[238,"تا چه دارد این حسود اندر کدو","ای خدا فریاد ما را زین عدو","خداوندا، این حسود چه نقشه‌ای برای ما دارد، ای کاش فریاد و کمک ما را از این دشمن بشنوی."],[238,"گر یکی فصلی دگر در من دمد","در رباید از من این ره‌زن نمد","اگر فصلی دیگر در من دمیده شود، این دزد درون من، نه در من قرار می‌گیرد و نه از من می‌رود."],[239,"این حدیثش همچو دودست ای اله","دست گیر ار نه گلیمم شد سیاه","این گفت‌وگو مانند دو دست است؛ ای خدا، اگر به یاری من نیایی، وضعیت من به شدت بد خواهد شد."],[239,"من به حجت بر نیایم با بلیس","کوست فتنه هر شریف و هر خسیس","من نمی‌توانم با ابلیس، که مسبب فتنه و فساد برای هر انسان خوب و بدی است، به استدلال برآیم و او را قانع کنم."],[239,"آدمی کو علم الاسما بگست","در تک چون برق این سگ بی تکست","انسانی که نام‌ها و علوم را فراگرفته است، در کار و عمل خود مانند برقی است که شتابان و با قوت عمل می‌کند، در حالی که این سگ (ابلیس) که بی‌عمل و بی‌مسئولیت است، در مقام و جایگاهش چیزی نیست."],[239,"از بهشت انداختش بر روی خاک","چون سمک در شست او شد از سماک","آدم را از بهشت به روی زمین انداختند، درست مثل ستاره سمک که در دست‌ها می‌افتد."],[239,"نوحه انا ظلمنا می‌زدی","نیست دستان و فسونش را حدی","تو دیگر در فریاد و نوحه‌سرایی \"ما ظلم کردیم\" نکن، زیرا این نیز مانند دیگر کارها و دعاهات حد و مرزی ندارد."],[239,"اندرون هر حدیث او شرست","صد هزاران سحر در وی مضمرست","درون هر داستان او (ابلیس) شر و بدی نهفته است و در آن هزاران فریب و سحر پنهان است."],[239,"مردی مردان ببندد در نفس","در زن و در مرد افروزد هوس","مردان به واسطه نفس خود به یکدیگر نزدیک می‌شوند و این نفس است که در زنان و مردان، هوس و خواسته‌های زشت ایجاد می‌کند."],[239,"ای بلیس خلق‌سوز فتنه‌جو","بر چیم بیدار کردی راست گو","ای ابلیس، که فتنه‌انگیز و آتش‌زننده‌ی دل‌ها هستی، چرا مرا بیدار کردی؟ راست بگو؛ منظور تو چیست؟"],[240,"گفت هر مردی که باشد بد گمان","نشنود او راست را با صد نشان","هر مردی که به دیگران بدگمان باشد، حتی با وجود اینکه حقایق و نشانه‌های متعدد نشان‌دهنده صداقت دیگران است، نمی‌تواند صداقت آنها را بشنود و درک کند."],[240,"هر درونی که خیال‌اندیش شد","چون دلیل آری خیالش بیش شد","هر کسی که به خیالات و افکار منفی خود مشغول شود، به تدریج دلیلی برای باورهای خود پیدا می‌کند و خیالاتش بیشتر و بیشتر می‌شود."],[240,"چون سخن در وی رود علت شود","تیغ غازی دزد را آلت شود","هرگاه سخن به درونی نفوذ کند، سبب می‌شود که او به دلیلی دچار شود؛ مانند این که شمشیر غازی (سرباز) نیز به دزد تبدیل شده و ابزاری برای کارهای زشت می‌گردد."],[240,"پس جواب او سکوت است و سکون","هست با ابله سخن گفتن جنون","جواب دادن به ابلهان و نادان‌ها بهتر است با سکوت و آرامش همراه باشد، چرا که صحبت کردن با آنها باعث جنون و دیوانگی می‌شود."],[240,"تو ز من با حق چه نالی ای سلیم؟","تو بنال از شر آن نفس لئیم","سلیم، تو چرا از من که حق را می‌گویم، شکایت داری؟ بهتر است از شر نفس پست و بدخوی خود شکایت کنی."],[240,"تو خوری حلوا تو را دنبل شود","تب بگیرد طبع تو مختل شود","اگر تو از حلوای خوشمزه بخوری، همان‌طور که در دل خود این خوشی را احساس می‌کنی، ممکن است به دنبال آن دچار تب و بیماری شوی و طبیعت خودت دچار اختلال شود. در واقع، لذت‌های زودگذر می‌توانند اثرات منفی و ناخوشایندی به همراه داشته باشند."],[240,"بی‌گنه لعنت کنی ابلیس را","چون نبینی از خود آن تلبیس را","تو بدون دلیل و بدون اینکه خودت را ببینی، ابلیس را لعنت می‌کنی، در حالی که در حقیقت تلبیس و فریب او از خود توست."],[240,"نیست از ابلیس، از تست ای غوی","که چو روبه سوی دنبه می‌روی","ای غوی (شخص نادان)، آنچه به عنوان فریب ابلیس می‌بینی، از خود توست، زیرا وقتی به دنبال دنبه (چیزهای فریبنده) می‌روی، در واقع خودت در دام می‌افتی، نه ابلیس."],[240,"چونک در سبزه ببینی دنبه‌ها","دام باشد، این ندانی تو چرا؟","اگر در سبزه‌ها دنبه‌ها را ببینی، این را نمی‌دانی که آن‌ها چه دام‌هایی هستند؟"],[240,"زان ندانی کت ز دانش دور کرد","میل دنبه چشم و عقلت کور کرد","از این نمی‌دانی که میل به دنبه (چربی) به خاطر جذابیت ظاهری‌اش، تو را از دانش دور کرده و چشمانت را کور کرده است."],[240,"حبک الاشیاء یعمیک یصم","نفسک السودا جنت لا تختصم","عشق به چیزها چشمانت را کور می‌کند و گوش‌هایت را کر، خواهش‌های نفس سیاه تو هرگز محدود نخواهد بود و با کسی دعوا نکن."],[240,"تو گنه بر من منه کژ کژ مبین","من ز بد بیزارم و از حرص و کین","تو به من گناه نچسبان و به طور نادرست قضاوت نکن، زیرا من از بدی و همچنین از حرص و کینه متنفر هستم."],[240,"من بدی کردم پشیمانم هنوز","انتظارم تا دیم گردد تموز","من در گذشته کارهای بدی انجام داده‌ام و هنوز هم از آن‌ها پشیمان هستم. امیدوارم که این پشیمانی تا زمانی که به مرگ برسم، ادامه داشته باشد."],[240,"متهم گشتم میان خلق من","فعل خود بر من نهد هر مرد و زن","من در میان مردم متهم شده‌ام و هر مرد و زنی اقداماتی که انجام داده‌ام را به خودم نسبت می‌دهد."],[240,"گرگ بیچاره اگرچه گرسنه‌ست","متهم باشد که او در طنطنه‌ست","گرگ، هرچند که در حال گرسنگی و فروافتادگی است، متهم می‌شود که او در حال شرارت و لطافت است."],[240,"از ضعیفی چون نتواند راه رفت","خلق گوید تخمه‌ست از لوت زفت","(گرگ) نمی‌تواند از گرسنگی و ضعف راه برود مردم گویند که از سوءهاضمه‌ی پرخوری است. (تخمه یعنی ثقل غذا و سوءهاضمه، لوت زفت یعنی غذای زیاد)"],[241,"گفت غیر راستی نرهاندت","داد سوی راستی می‌خواندت","غیر از راستی تو را نجات نمی‌دهد و به سوی راستگویی دعوتت می‌کند."],[241,"راست گو تا وا رهی از چنگ من","مکر ننشاند غبار جنگ من","اگر راست بگویی، تو را از چنگال من نجات می‌دهد و دروغ نمی‌تواند تو را در درگیری‌ها و جنگ‌هایی که من به پا می‌کنم، گرفتار سازد."],[241,"گفت چون دانی دروغ و راست را","ای خیال اندیش پر اندیشه‌ها","اگر می‌دانی که دروغ و راست چیست، ای خیال‌پرداز که پر از اندیشه‌های مختلف هستی، پس چرا این‌قدر در این افکار غرق شده‌ای؟"],[241,"گفت پیغامبر نشانی داده است","قلب و نیکو را محک بنهاده است","پیامبر اشاره کرده است که نشانه‌ی صدق و درستی، قلب انسان است و خوب بودن دل را غالبا باید با آزمونی سنجید."],[241,"گفته است الکذب ریب فی القلوب","گفت الصدق طمانین طروب","دروغ باعث ایجاد تردید و شک در دل‌ها می‌شود، اما راست‌گویی آرامشی شاداب و مسرت‌بخش به همراه دارد."],[241,"دل نیارامد ز گفتار دروغ","آب و روغن هیچ نفروزد فروغ","دل به‌خاطر سخنان دروغ آرام نمی‌گیرد، چون مانند آب و روغن که با هم حل نمی‌شوند، دروغ هرگز حقیقت را روشن نمی‌کند و نور نمی‌بخشد."],[241,"در حدیث راست آرام دلست","راستیها دانه دام دلست","در سخن راست و حقی که گفته می‌شود، دل آرامش پیدا می‌کند؛ زیرا حقیقت مانند دانه‌ای است که برای شکارچیان، دام‌های دل را به دام می‌اندازد."],[241,"دل مگر رنجور باشد بد دهان","که نداند چاشنی این و آن","دل تنها زمانی دچار درد و رنج می‌شود که در گفتار خود غیرمنصفانه و بددهان است، زیرا او نمی‌تواند تفاوت میان حق و باطل را درک کند."],[241,"چون شود از رنج و علت دل سلیم","طعم کذب و راست را باشد علیم","وقتی دل سالم و پاک از رنج و درد شود، به خوبی می‌تواند طعم دروغ و راستی را تشخیص دهد و از آن آگاهی پیدا کند."],[241,"حرص آدم چون سوی گندم فزود","از دل آدم سلیمی را ربود","حرص و طمع انسان، مانند افزایش میل او به گندم، دل انسان پاک و سالم را از او می‌گیرد و به انحراف می‌کشاند."],[241,"پس دروغ و عشوه‌ات را گوش کرد","غره گشت و زهر قاتل نوش کرد","عشق و فریب تو را شنید و دلبسته شد و در اثر این دلبستگی، سم خطرناک را نوشید."],[241,"کزدم از گندم ندانست آن نفس","می‌پرد تمییز از مست هوس","نفس انسانی از لذت‌های هوس‌آلود بی‌خبر و غافل است، به‌طوری‌که حتی نمی‌داند که گندم (نماد خیر و برکت) از جو (نماد بدی و بی‌خری) چه تفاوتی دارد و در این حالت دچار شهوترانی می‌شود."],[241,"خلق مست آرزواند و هوا","زان پذیرااند دستان تو را","انسان‌ها به‌سبب آرزوها و هوس‌های خودشان به حالت مستی درمی‌آیند و آنچه را که تو به آنها می‌دهی، می‌پذیرند."],[241,"هر که خود را از هوا خو باز کرد","چشم خود را آشنای راز کرد","هر کس که از تمایلات و خواسته‌های نفسانی خود دور شود، چشمش به اسرار و حقیقت‌ها آشنا می‌شود."],[242,"قاضیی بنشاندند و می‌گریست","گفت نایب قاضیا گریه ز چیست","قاضی را منصوب کردند و او در حالی که گریه می‌کند، از نایب قاضی می‌پرسد دلیل این گریه چیست."],[242,"این نه وقت گریه و فریاد تست","وقت شادی و مبارک‌باد تست","تو اکنون در زمانی برای گریه و فریاد نیستی، بلکه زمان خوشحالی و تبریک گفتن است."],[242,"گفت اه چون حکم راند بی‌دلی","در میان آن دو عالم جاهلی","قاضی با دلی بی‌رمق و بدون آگاهی و تجربه، در میان دو عالم نادان و جاهل، حکم می‌کند."],[242,"آن دو خصم از واقعه خود واقفند","قاضی مسکین چه داند زان دو بند","آن دو طرف دعوا از حقیقت ماجرای خود آگاهند، اما قاضی بیچاره از ارتباط و جزئیات آن‌ها اطلاعی ندارد."],[242,"جاهلست و غافلست از حالشان","چون رود در خونشان و مالشان","قاضی در حال بی‌خبری و نادانی از وضعیت طرفین دعواست، همان‌طور که رود به طور ناخودآگاه و بی‌خبر از آب خون و ثروت در جریان است."],[242,"گفت خصمان عالم‌اند و علتی","جاهلی تو لیک شمع ملتی","قاضی می‌گوید که دشمنان در جهان وجود دارند و بی‌دلیل و نادان هستند، اما تو مانند شمعی هستی که روشنی‌بخش ملتی (جمعی از مردم) هستی."],[242,"زانک تو علت نداری در میان","آن فراغت هست نور دیدگان","زیرا تو در میان قضا و قدر (مسائل) هیچ علت و دلیلی نداری، بنابراین در درون خود فضای آرام و روشنی برای دیدگان خود داری."],[242,"وان دو عالم را غرضشان کور کرد","علمشان را علت اندر گور کرد","این دو جهان را هدف آنها به بی‌راهه کشاند و علم آنها را به هلاکت و نابودی رساند."],[242,"جهل را بی‌علتی عالم کند","علم را علت کژ و ظالم کند","جهل، بدون علت، فرد را عالم و به دانایی می‌رساند، در حالی که علم، اگر دلیل و انگیزه‌اش ناصحیح و ظالمانه باشد، انسان را به گمراهی و سوءاستفاده می‌کشاند."],[242,"تا تو رشوت نستدی بیننده‌ای","چون طمع کردی ضریر و بنده‌ای","اگر تو رشوت ندهی، می‌توانی ببینی که وقتی طمع می‌کنی، به مانند یک آدم نابینا و بنده به سوی فساد می‌روی."],[242,"از هوا من خوی را وا کرده‌ام","لقمه‌های شهوتی کم خورده‌ام","من از وسوسه‌ها و تمایلات نفسانی خود فاصله گرفته‌ام و کم‌تر به خواسته‌های شهوانی توجه کرده‌ام."],[242,"چاشنی‌گیر دلم شد با فروغ","راست را داند حقیقت از دروغ","دل من با نوری از حقیقت طعمه‌گیر و آغشته شده است، و فقط حقیقت را از دروغ تشخیص می‌دهد."],[243,"تو چرا بیدار کردی مر مرا","دشمن بیداریی تو ای دغا","چرا مرا از خواب بیدار کردی، ای دشمن بیداری که به خاطر فریب‌کاری‌ات در بهت و خواب هستم؟"],[243,"همچو خشخاشی همه خواب آوری","همچو خمری عقل و دانش را بری","شما مانند دانه‌های خشخاش همه را به خواب می‌آوری و مانند شرابی، عقل و دانش را از انسان می‌گیری."],[243,"چارمیخت کرده‌ام هین راست گو","راست را دانم تو حیلتها مجو","من چهار چیز را با هم جمع کرده‌ام، پس به‌طور راست و صادقانه بگو. من حقیقت را می‌دانم، پس از تو خواسته‌های پنهان نداشته باش."],[243,"من ز هر کس آن طمع دارم که او","صاحب آن باشد اندر طبع و خو","من از هر کسی امید دارم که ویژگی خاصی داشته باشد و آن ویژگی در ذات و طبیعت او نهفته باشد."],[243,"من ز سرکه می‌نجویم شکری","مر مخنث را نگیرم لشکری","من از سرکه، که تلخ و تضاد دارد با شیرینی، چیزی نمی‌طلبم و از موجودی که ویژگی‌های زنانه دارد (مخنث)، سپاهی نمی‌سازم."],[243,"همچو گبران من نجویم از بتی","کو بود حق یا خود از حق آیتی","من مانند گبرها (پیروان زرتشت) به دنباله‌روی از بتی نیستم، که آن بت بزرگ‌ترین حقیقت یا نمادی از حقیقت باشد."],[243,"من ز سرگین می‌نجویم بوی مشک","من در آب جو نجویم خشت خشک","من به دنبال بوی خوش و عطرهای دلپذیر نیستم، بلکه از زشتی‌ها و ناپاکی‌ها می‌گذرم و انتظار ندارم که در میان چیزهای خشک و بی‌فایده، بویی خوش بیابم."],[243,"من ز شیطان این نجویم کوست غیر","کو مرا بیدار گرداند بخیر","من از شیطان چیزی نمی‌خواهم، بلکه کسی را می‌جویم که مرا به خوبی بیدار کند و از خواب غفلت بیرون آورد."],[243,"گفت بسیار آن بلیس از مکر و غدر","میر ازو نشنید کرد استیز و صبر","ابلیس (شیطان) گفت که من از نیرنگ و خیانت (مکر و غدر) بسیار می‌دانم، ولی معاویه (میر) از او چیزی نشنید و به او اعتراض کرد و صبر ورزید."],[244,"از بن دندان بگفتش بهر آن","کردمت بیدار می‌دان ای فلان","ابلیس به معاویه گفت که برای بیدار کردنت حقیقت را از عمق وجودم بر زبان آوردم، ای شخص خاص."],[244,"تا رسی اندر جماعت در نماز","از پی پیغامبر دولت‌فراز","برای رسیدن به جماعت و نماز، باید از پیغمبر بزرگوار و با مقام بالا پیروی کنی."],[244,"گر نماز از وقت رفتی مر تو را","این جهان تاریک گشتی بی ضیا","اگر نمازی را از وقت خودش قضا کنی، دنیا بر تو تیره و تار خواهد شد و دیگر هیچ نوری نخواهی داشت."],[244,"از غبین و درد رفتی اشکها","از دو چشم تو مثال مشکها","تو در درد و اندوه عمیق هستی و اشک‌هایت مانند عطر مشک به زمین می‌ریزد."],[244,"ذوق دارد هر کسی در طاعتی","لاجرم نشکیبد از وی ساعتی","هر کسی در انجام عبادات و کارهای پسندیده ذوق و لذتی دارد، اما به طور طبیعی گاهی از آن دور می‌شود و برای مدتی این لذت را تجربه نمی‌کند."],[244,"آن غبین و درد بودی صد نماز","کو نماز و کو فروغ آن نیاز","ابلیس که در اینجا به شرایط خود اشاره می‌کند، می‌گوید: آن حسرت و درد را چندین بار تجربه کرده‌ام، ولی این همه نماز و عبادت که انجام می‌دهم، کجاست و کجا رستگاری و نور واقعی آن نیاز روحی؟"],[245,"آن یکی می‌رفت در مسجد درون","مردم از مسجد همی‌آمد برون","یک نفر به سمت مسجد می‌رفت، در حالی که دیگران از مسجد خارج می‌شدند."],[245,"گشت پرسان که جماعت را چه بود","که ز مسجد می برون آیند زود","او پرسید که چه خبر است که مردم این‌گونه سریع از مسجد خارج می‌شوند و به جماعت نمی‌پیوندند."],[245,"آن یکی گفتش که پیغامبر نماز","با جماعت کرد و فارغ شد ز راز","یکی گفت که پیامبر (حضرت محمد) نماز را با مردم جماعت برگزار کرد و پس از اتمام آن، از رازهای الهی آگاه شد."],[245,"تو کجا در می‌روی ای مرد خام","چونک پیغامبر بدادست السلام","ای مرد نادان، تو کجا می‌روی در حالی که پیامبر (محمد) به تو سلام داده است؟"],[245,"گفت آه و دود از آن اه شد برون","آه او می‌داد از دل بوی خون","او آهی کشید و دود آن آه به بیرون رفت، آه او از دلش بویی مانند خون داشت."],[245,"آن یکی گفتا بده آن آه را","وین نماز من تو را بادا عطا","یکی از مخلصان گفت: آن آه را به من بده تا من این نماز تو را پاداش دهم."],[245,"گفت دادم آه و پذرفتم نماز","او ستد آن آه را با صد نیاز","شخصی می‌گوید که من آه خود را به او دادم و در عوض نماز او را گرفتم. آن آه را با ناله و درخواست بسیار دریافت کردم."],[245,"شب بخواب اندر بگفتش هاتفی","که خریدی آب حیوان و شفا","در شب، در خواب، هاتفی به او گفت که تو آب حیات و شفابخش را خریدی."],[245,"حرمت این اختیار و این دخول","شد نماز جمله خلقان قبول","حرمت و ارج و قرب این انتخاب و این ورود به نماز باعث قبول شدن نماز تمام مردم می‌شود."],[246,"پس عزازیلش بگفت ای میر راد","مکر خود اندر میان باید نهاد","عزازیل (شیطان) به او (معاویه) گفت: ای سرور شجاع، باید مکر و دورغت را در بین جامعه قرار دهی."],[246,"گر نمازت فوت می‌شد آن زمان","می‌زدی از درد دل آه و فغان","اگر نمازت در آن زمان قضا می‌شد، از شدت ناراحتی و اندوه، آه و فغان سر می‌زدی."],[246,"آن تاسف و آن فغان و آن نیاز","درگذشتی از دو صد ذکر و نماز","آن ناراحتی و ناله و نیاز تو که از دل برمی‌آمد، موجب غفلت تو از دو صد ذکر و نماز شد."],[246,"من تو را بیدار کردم از نهیب","تا نسوزاند چنان آهی حجاب","ابلیس می گوید من تو را بیدار کردم که نماز بخوانی و به خاطر از دست دادن نماز آه نکشی چون آه خالصانه تو حجاب های بین تو و خدا را می سوزاند"],[246,"تا چنان آهی نباشد مر تو را","تا بدان راهی نباشد مر تو را","ابلیس می گوید من نمی خواهم تو به آن آه خالصانه که از نماز بالاتر است برسی که راهی به سوی خدا پیدا کنی"],[246,"من حسودم از حسد کردم چنین","من عدوم کار من مکرست و کین","من به دلیل حسد، این گونه عمل کرده‌ام؛ من که وجودم را نفی می‌کنم، کارهایم نتیجه نیرنگ و کینه‌توزی است."],[246,"گفت اکنون راست گفتی صادقی","از تو این آید تو این را لایقی","ابلیس می‌گوید: حالا که راست گفتی و حقیقت را بیان کردی، باید توجه داشته باشی که خودت شایسته‌ی این نوع سخن هستی."],[246,"عنکبوتی تو مگس داری شکار","من نیم ای سگ مگس زحمت میار","معاویه به ابلیس می گوید تو مثل عنکبوت هستی که شکار تو مگس است فکر نکن که من مثل مگس در دام تو می افتم پس بیهوده زحمت نکش"],[246,"باز اسپیدم شکارم شه کند","عنکبوتی کی بگرد ما تند","شکار من به سوی آسمان و در حال پرواز است، پس عنکبوت نمی‌تواند مرا بگیرد و من برای فرار از او به سرعت می‌چرخم."],[246,"رو مگس می‌گیر تا توانی هلا","سوی دوغی زن مگسها را صلا","مگس را تا جایی که می‌توانی نگیر، زیرا به سمت دوغ (چیزی بی‌ارزش) می‌روی و برای مگس‌ها ندا بده."],[246,"ور بخوانی تو به سوی انگبین","هم دروغ و دوغ باشد آن یقین","اگر تو به سمت عسل (انگبین) بخوانی و آن را بخواهی، حتی در آن حال هم دروغ و نادرستی وجود دارد، و حقیقت یعنی یقین هم محقق نمی‌شود."],[246,"تو مرا بیدار کردی خواب بود","تو نمودی کشتی آن گرداب بود","تو من را از خواب غفلت بیدار کردی، در حالی که در حقیقت تو به من نشان دادی که در میان گردابی گرفتار شده‌ام."],[246,"تو مرا در خیر زان می‌خواندی","تا مرا از خیر بهتر راندی","تو مرا به کارهای خوب و مثبت دعوت می‌کنی، اما در واقع می‌خواهی مرا از آن کارها و خیرات بزرگ‌تر و بهتر دور کنی."],[247,"این بدان ماند که شخصی دزد دید","در وثاق اندر پی او می‌دوید","این وضعیت شبیه به این است که شخصی دزدی را مشاهده می‌کند که در حال فرار است و یک نفر به دنبال او می‌دود تا او را بگیرد."],[247,"تا دو سه میدان دوید اندر پیش","تا در افکند آن تعب اندر خویش","او (دزد) تا دو یا سه میدان جلوتر دوید تا بتواند آن حسرت و خواب آلودگی (تعب) را از خود دور کند و فرار کند."],[247,"اندر آن حمله که نزدیک آمدش","تا بدو اندر جهد در یابدش","در آن لحظه‌ای که دزد نزدیک می‌شود تا او را بگیرد، به شدت تلاش می‌کند تا خود را نجات دهد."],[247,"دزد دیگر بانگ کردش که بیا","تا ببینی این علامات بلا","دزد دیگری فریاد زد که بیا و ببین این نشانه‌های درد و مصیبت را."],[247,"زود باش و باز گرد ای مرد کار","تا ببینی حال اینجا زار زار","به سرعت برگرد، ای مرد، تا ببینی که اینجا چه حال و وضع غم‌انگیزی وجود دارد."],[247,"گفت باشد کان طرف دزدی بود","گر نگردم زود این بر من رود","او گفت اگر از این سمت که طرف دزدی است، دور نشوم و زود برنگردم، ممکن است این حادثه به من نیز برسد."],[247,"در زن و فرزند من دستی زند","بستن این دزد سودم کی کند","دزد به خانواده‌اش اشاره می‌کند و می‌گوید که اگر او دستگیر نشود، خیری از زندگی آنها نخواهد بود، زیرا دستگیری او مانع از آسیب رسیدن به خانواده‌اش می‌شود."],[247,"این مسلمان از کرم می‌خواندم","گر نگردم زود پیش آید ندم","این مسلمان (دزد) از روی مهربانی و رافت می‌خوانده که اگر به زودی به جایی نرسم، نمی‌توانم فرار کنم و گرفتار می‌شوم."],[247,"بر امید شفقت آن نیکخواه","دزد را بگذاشت باز آمد به راه","او (دزد) امید داشت که آن شخص نیکوکار به خاطر مهربانی‌اش، به او رحم خواهد کرد؛ بنابراین (دزد) او را رها کرد و دوباره به راه خود برگشت."],[247,"گفت ای یار نکو احوال چیست","این فغان و بانگ تو از دست کیست","آن شخص می‌گوید: ای دوست، احوال تو چگونه است که اینگونه ناله و فریاد می‌زنی و از دست چه کسی به وضعیت بدی افتاده‌ای؟"],[247,"گفت اینک بین نشان پای دزد","این طرف رفتست دزد زن‌بمزد","او می‌گوید که اکنون به نشان پاهای دزد نگاه کن، چراکه این طرف دزد به سمت خانه زن مزد (همسر مرد) رفته است."],[247,"نک نشان پای دزد قلتبان","در پی او رو بدین نقش و نشان","نشان پاهای دزد در حال حرکت پیدا است، بیا و بر اساس این نشانه‌ها به دنبالش برو."],[247,"گفت ای ابله چه می‌گویی مرا","من گرفته بودم آخر مر ورا","او به صاحب‌خانه می‌گوید: ای نادان، چه چیزی می‌گویی؟ من خودم او را در حال دزدی می‌گرفتم."],[247,"دزد را از بانگ تو بگذاشتم","من تو خر را آدمی پنداشتم","من به خاطر صدای تو دزد را رها کردم و او فرار کرد؛ من تو را مانند یک انسان تصور کرده بودم در حالی که تو فقط یک چوب بی‌جان (خر) هستی."],[247,"این چه ژاژست و چه هرزه ای فلان","من حقیقت یافتم چه بود نشان","این چه سخنان بی‌محتوا و بی‌معنا است؟ من حقیقت را دریافته‌ام و می‌دانم نشانه‌اش چیست."],[247,"گفت من از حق نشانت می‌دهم","این نشانست از حقیقت آگهم","او می‌گوید که می‌خواهم از حق به تو نشانه‌ای نشان دهم که این نشانه، حقیقتی را که از آن آگاه هستم، مشخص می‌کند."],[247,"گفت طراری تو یا خود ابلهی","بلک تو دزدی و زین حال آگهی","گفتی که تو تظاهر به نادانی می‌کنی، اما در واقع خودت دزد هستی و از این وضعیت آگاهی داری."],[247,"خصم خود را می‌کشیدم من کشان","تو رهانیدی ورا کاینک نشان","من دزدی را که دشمن من بود به زور کشاندم و تو او را رهانیدی، حال این نشان و نتیجه کار توست."],[247,"تو جهت‌گو من برونم از جهات","در وصال آیات کو یا بینات","تو راهنما و هدایت‌گر من هستی، و من از مرزها و قیود ظاهری فراتر می‌روم. در ارتباط با حقایق و نشانه‌های روشن و آیات الهی، این نشانه‌ها باید در دسترس و قابل مشاهده باشند."],[247,"صنع بیند مرد محجوب از صفات","در صفات آنست کو گم کرد ذات","مردی که در شناخت خداوند و صفات او محجوب و ناتوان است، نمی‌تواند ماهیت واقعی او را ببیند و در حقیقت، گمراهی او ناشی از غفلت و بی‌خبری از ذات الهی است."],[247,"واصلان چون غرق ذات‌اند ای پسر","کی کنند اندر صفات او نظر","واصلان که به حقیقت و ذات خداوند متصل شده‌اند، مانند غرق‌شدگان در دریا هستند و در این حالت، نمی‌توانند به صفات او فکر کنند یا به آن‌ها توجه داشته باشند."],[247,"چونک اندر قعر جو باشد سرت","کی به رنگ آب افتد منظرت","وقتی که سر تو در عمق چاه (جو) باشد، چگونه می‌توانی به رنگ آب نمایان شوی؟"],[247,"ور به رنگ آب باز آیی ز قعر","پس پلاسی بستدی دادی تو شعر","اگر پس از اینکه به عمق آب رفتی، دوباره به رنگ آب برگردی، در واقع به همین دلیلی که در آب پنهان شده بودی، به مانعی برای دیگران تبدیل شده‌ای و در نهایت به تلاشی بی‌ثمر مشغول بوده‌ای."],[247,"طاعت عامه گناه خاصگان","وصلت عامه حجاب خاص دان","عمل کردن به دستورات عمومی و پیروی از قوانین جامعه، مختص به افرادی نیست که گناهکارند و در واقع، این پیروی می‌تواند پرده‌ای باشد که مانع از درک عمیق خواص و بزرگان می‌شود."],[247,"مر وزیری را کند شه محتسب","شه عدو او بود نبود محب","در این بیت گفته می‌شود که رئیس حکومت (شه) وزیر را تحت نظر نگه‌داشته است، زیرا او دوست وزیر نیست و دشمن او به شمار می‌آید."],[247,"هم گناهی کرده باشد آن وزیر","بی سبب نبود تغیر ناگزیر","وزیر هم مرتکب گناهی شده است و به همین دلیل بود که تغییر ناگزیر او رخ داد."],[247,"آنک ز اول محتسب بد خود ورا","بخت و روزی آن بدست از ابتدا","محتسب (بازرس و مقام قضایی) از ابتدا به خاطر بدی اخلاق و رفتار این فرد (وزیر) را تحت نظر قرار داده بود، و از همان ابتدا بخت و روزی او به خاطر اعمالش به دست خودش خراب شده است."],[247,"لیک آنک اول وزیر شه بدست","محتسب کردن سبب فعل بدست","اما آن وزیر اول که از سوی محتسب به دست آمده، باعث انجام کارهای نادرست شده است."],[247,"چون تو را شه ز آستانه پیش خواند","باز سوی آستانه باز راند","زمانی که پادشاه تو را از درگاه خود فراخواند، تو دوباره به درگاه او بازخواهی گشت."],[247,"تو یقین می‌دان که جرمی کرده‌ای","جبر را از جهل پیش آورده‌ای","تو به خوبی می‌دانی که مرتکب گناهی شده‌ای و در اینجا، جبر (سرنوشت) را از روی نادانی بهانه کرده‌ای."],[247,"که مرا روزی و قسمت این بدست","پس چرا دی بودت آن دولت به دست","خداوند روزی و قسمت مرا به دست خودم داده است، پس چرا در گذشته از دستم رفته و آن نعمت‌ها در اختیار من نبوده‌اند؟"],[247,"قسمت خود خود بریدی تو ز جهل","قسمت خود را فزاید مرد اهل","تو با نادانی، سهم و قسمت خود را از زندگی قطع کردی، در حالی که مردان دانا و اهل علم، بر قسمت و رزق خود می‌افزایند."],[248,"یک مثال دیگر اندر کژروی","شاید ار از نقل قرآن بشنوی","مولانا می‌گوید که برای نشان دادن کج‌روی‌ها و رفتارهای نادرست، مثال دیگری هم وجود دارد که شاید بتوانی آن را از آیات قرآن بشنوی."],[248,"این چنین کژ بازیی در جفت و طاق","با نبی می‌باختند اهل نفاق","اهل نفاق در کارهای مضحک و ناپسند خود که شامل تقلب و فریب است، خود را به پیامبر (نبی) نزدیک می‌کردند و در واقع به او خیانت می‌کردند."],[248,"کز برای عز دین احمدی","مسجدی سازیم و بود آن مرتدی","برای عزت دین احمد (پیامبر اسلام) مسجدی بسازیم، در حالی که آن شخص مرتد است و از دین خارج شده."],[248,"این چنین کژ بازیی می‌باختند","مسجدی جز مسجد او ساختند","منافقان که دین اسلام را تضعیف می‌کردند، با همین نیت مسجدی دیگر غیر از مسجد پیامبر (مسجد نبوی) ساختند تا هدف‌های ناشایست خود را پیش ببرند و در واقع در پیکره دین بازی‌های کثیف می‌کردند."],[248,"سقف و فرش و قبه‌اش آراسته","لیک تفریق جماعت خواسته","این مسجد با زینت‌هایی چون سقف و فرش و گنبد زیبا ساخته شده است، اما هدف آن ایجاد تفرقه در میان جماعت و گروه‌هاست."],[248,"نزد پیغامبر به لابه آمدند","همچو اشتر پیش او زانو زدند","منافقان نزد پیامبر (محمد) آمده و به شدت از او درخواست کردند، طوری که مثل شتر به زانو افتادند."],[248,"کای رسول حق برای محسنی","سوی آن مسجد قدم رنجه کنی","ای پیامبر راستین، لطفا به خاطر محسنی به آن مسجد بروی و قدم بر زمین بگذاری."],[248,"تا مبارک گردد از اقدام تو","تا قیامت تازه بادا نام تو","اگر تو به این مسجد قدم گذاری، نام تو تا قیامت مبارک و تازه خواهد ماند."],[248,"مسجد روز گلست و روز ابر","مسجد روز ضرورت وقت فقر","مسجد در روز شکوفایی و شادی مانند روزی است که آفتاب می‌تابد، و در روزهایی که باران و ابر است، یعنی زمان‌های نیاز و فقر، اهمیت و ضرورتش بیشتر احساس می‌شود."],[248,"تا غریبی یابد آنجا خیر و جا","تا فراوان گردد این خدمت‌سرا","هر کس که به این مسجد بیاید، خیر و برکت پیدا می‌کند و این محل خدمت به مردم بیش از پیش رونق می‌گیرد."],[248,"تا شعار دین شود بسیار و پر","زانک با یاران شود خوش کار مر","به محض اینکه پیام دین زیاد و پررنگ شود، کار با یاران خوشایند خواهد شد."],[248,"ساعتی آن جایگه تشریف ده","تزکیه‌مان کن ز ما تعریف ده","مدتی در آنجا حضور یاب و ما را پاکسازی کن و از ویژگی‌های خوب ما سخن بگو."],[248,"مسجد و اصحاب مسجد را نواز","تو مهی ما شب دمی با ما بساز","ای خدا، آن مکان و کسانی که در مسجد هستند را به لطف و محبت خود نوازش کن، و به ما شب کوتاهی داده‌ای که در آن با ما باشی و ما را به حال خود رها نکنی."],[248,"تا شود شب از جمالت همچو روز","ای جمالت آفتاب جان‌فروز","خداوند، ای زیبایی‌ای که مانند خورشید جان را روشن می‌کنی، شب را با وجود تو مانند روز روشن می‌کند و جان‌ها را پرنور می‌سازد."],[248,"ای دریغا کان سخن از دل بدی","تا مراد آن نفر حاصل شدی","ای دریغا، آن سخن از دل بدی که باعث شد تو به خواسته‌ات برسی."],[248,"لطف کاید بی دل و جان در زبان","همچو سبزه تون بود ای دوستان","به زبان دل و جان، محبت و لطفی وجود دارد که مانند سبزه‌های سرسبز و شاداب در باغ است. این لطف برای دوستان واقعی مشخص و نمایان است."],[248,"هم ز دورش بنگر و اندر گذر","خوردن و بو را نشاید ای پسر","ای پسر، اگر از دور به او نگاه کنی و در هنگام گذر از او، به راهی بروی که در آن هیچ بویی از او به مشام نمی‌رسد، نباید به او نزدیک شوی."],[248,"سوی لطف بی وفایان هین مرو","کان پل ویران بود‌، نیکو شنو","به سوی خوبی کسانی که وفا ندارند نرو، زیرا آن پل به ویرانی گرایش دارد؛ این را خوب بشنو."],[248,"گر قدم را جاهلی بر وی زند","بشکند پل و آن قدم را بشکند","اگر فرد جاهلی بر این پل قدم بگذارد، آن پل خراب می‌شود و آن قدم هم از بین می‌رود."],[248,"هر کجا لشکر شکسته می‌شود","از دو سه سست مخنث می‌بود","هر جا که لشکر شکست می‌خورد، معمولا به خاطر وجود دو یا سه فرد ناتوان و سست‌عنصر است که به این وضعیت دامن می‌زنند."],[248,"در صف آید با سلاح او مردوار","دل برو بنهند کاینک یار غار","در صف خانوادگی و با سلاح پدر، به‌گونه‌ای ایستاده‌اند که دل‌ها را به خود جذب می‌کنند؛ چونکه اینجا دوست و یار نزدیک است."],[248,"رو بگرداند چو بیند زخم را","رفتن او بشکند پشت تو را","چون او زخم را ببیند، رو برمی‌گرداند و همین که رفتن او را ببیند، قدرت و استقامت تو را می‌شکند."],[248,"این درازست و فراوان می‌شود","وآنچ مقصودست پنهان می‌شود","این موضوع طولانی و پیچیده می‌شود و آنچه که واقعا به دنبال آن هستیم، پنهان و نامشخص باقی می‌ماند."],[249,"بر رسول حق فسونها خواندند","رخش دستان و حیل می‌راندند","منافقان برای فریب پیامبر اسلام، الفاظ زیبا و دلفریب به کار بردند و او را با نیرنگ‌های خود به سوی مسجد ضرار کشاندند."],[249,"آن رسول مهربان رحم‌کیش","جز تبسم جز بلی ناورد پیش","آن پیامبر مهربان که دلسوز و با رحم است، جز خنده و پاسخ مثبت هیچ چیز دیگر به آن‌ها نمی‌دهد."],[249,"شکرهای آن جماعت یاد کرد","در اجابت قاصدان را شاد کرد","مولانا به یادآوری خوبی‌های آن گروه اشاره می‌کند و می‌گوید که اگرچه آن‌ها در باطن قصد بدی دارند، اما به خاطر شکرگزاری، باعث خوشحالی پیامبر (علیه‌السلام) از پذیرش فرستادگانشان شده‌اند."],[249,"می‌نمود آن مکر ایشان پیش او","یک به یک زان سان که اندر شیر مو","منافقان به تدریج و به طور پنهانی، حقایق خود را به پیامبر نشان می‌دادند، به طوری که او نتواند به راحتی از نیرنگ آن‌ها باخبر شود؛ مانند اینکه در شیر، مویی وجود ندارد و کسی متوجه آن نمی‌شود."],[249,"موی را نادیده می‌کرد آن لطیف","شیر را شاباش می‌گفت آن ظریف","آن لطیف شیر (پیامبر) به موی (فریب و نیرنگ) توجهی نداشت و آن ظریف (منافقان) به او تبریک می‌گفتند."],[249,"صد هزاران موی مکر و دمدمه","چشم خوابانید آن دم زان همه","در آن لحظه، هزاران موی فریب و نیرنگ چون دمی با عشق و شیفتگی از چشم‌های خواب آلود، به خواب رفتند و بی‌خبر بودند از واقعیت."],[249,"راست می‌فرمود آن بحر کرم","بر شما من از شما مشفق‌ترم","پیامبر (پیامبر اسلام) به درستی گفته است که من نسبت به شما مهربان‌تر و دلسوزتر از خودتان هستم."],[249,"من نشسته بر کنار آتشی","با فروغ و شعله بس ناخوشی","من در کنار آتشی نشسته‌ام که شعله‌های آن بسیار ناراحت‌کننده و غیرمطلوب است."],[249,"همچو پروانه شما آن سو دوان","هر دو دست من شده پروانه‌ران","شما مانند پروانه‌ای در سمت دیگری در حال پرواز هستید و دستان من در حال تبدیل شدن به پروانه‌هایی است که دور شما می‌چرخند."],[249,"چون بر آن شد تا روان گردد رسول","غیرت حق بانگ زد مشنو ز غول","زمانی که پیامبر (رسول) تصمیم گرفت به سمت آنها برود، که به خاطر غیرت الهی (حق) او بود، صدایی بلند شد که به او گفت: از این حیله‌گران (غول) گوش نده."],[249,"کاین خبیثان مکر و حیلت کرده‌اند","جمله مقلوبست آنچ آورده‌اند","این افراد بدذات با نیرنگ و فریب آمده‌اند و هر آنچه که ارائه می‌دهند، همه دروغ و معکوس واقعیت است."],[249,"قصد ایشان جز سیه‌رویی نبود","خیر دین کی جست ترسا و جهود","هدف این منافقان فقط بدنامی و ننگ بود و آن‌ها دنبال این نبودند که در دین به حقیقتی دست یابند؛ چرا که برای یهودیان و مسیحیان (ترسا) هیچ خیر و درستی وجود ندارد."],[249,"مسجدی بر جسر دوزخ ساختند","با خدا نرد دغاها باختند","منافقان برای آنکه دین را تضعیف کنند، مسجدی بر پل دوزخ (که نماد فساد و بدی است) ساختند و با خداوند به نیرنگ بازی مشغول شدند."],[249,"قصدشان تفریق اصحاب رسول","فضل حق را کی شناسد هر فضول","هدف آنها جدا کردن و تفرقه‌افکنی بین یاران رسول خداست، اما کسی که به حق آگاه است، از این فضولی‌ها (دخالت‌های بی‌مورد) و نیت‌های شوم باخبر است."],[249,"تا جهودی را ز شام اینجا کشند","که به وعظ او جهودان سرخوشند","یهودیانی که از شام به اینجا می‌آیند، به خاطر وعظ و نصیحت او خوشحال و راضی هستند."],[249,"گفت پیغامبر که آری لیک ما","بر سر راهیم و بر عزم غزا","پیامبر گفت که بله، اما ما در مسیر جنگ هستیم و تصمیم گرفته‌ایم به جهاد برویم."],[249,"زین سفر چون باز گردم آنگهان","سوی آن مسجد روان گردم روان","با این سفر که به جهاد می‌روم، وقتی برگردم، به سوی آن مسجد که در آنجا نیرنگی برپا کرده‌اند، می‌روم و روانه می‌شوم."],[249,"دفعشان گفت و به سوی غزو تاخت","با دغایان از دغا نردی بباخت","حضرت محمد (ص) به خاطر فریب منافقان راجع به سفرشان به غزا (نبرد) صحبت کرد و بیان کرد که به سمت جنگ حمله‌ور شد، اما با نیرنگ‌بازان (منافقان) در نبردی باخت."],[249,"چون بیامد از غزا باز آمدند","چنگ اندر وعده ماضی زدند","زمانی که پیامبر از غزوه به خانه برگشت، منافقان با ترفندهای خود به او نزدیک شدند و برای او از وعده‌های گذشته‌اش سخن گفتند تا او را فریب دهند."],[249,"گفت حقش ای پیمبر فاش گو","عذر را ور جنگ باشد باش گو","خداوند به پیغمبر می‌فرماید: حق آن است که عذر این منافق‌ها را به طور علنی بیان کنی، حتی اگر به جنگ منجر شود، باز هم بگو."],[249,"گفتشان بس بد درون و دشمنید","تا نگویم رازهاتان تن زنید","درون شما بسیار بد و دشمنانه است، اما من رازهایتان را نمی‌گویم تا دچار عذاب و سختی نشوید."],[249,"چون نشانی چند از اسرارشان","در بیان آورد بد شد کارشان","وقتی پیامبر نشانه‌هایی از رازهای آن‌ها را فاش کرد، کار آن‌ها به مشکل و بدی کشیده شد."],[249,"قاصدان زو باز گشتند آن زمان","حاش لله حاش لله دم‌زنان","فرستادگان او (پیامبر) در آن هنگام بازگشتند و با صدای بلند می‌گفتند که ما از این کار (منافقان) پناه می‌طلبیم و به خدا پناه می‌بریم."],[249,"هر منافق مصحفی زیر بغل","سوی پیغامبر بیاورد از دغل","هر فرد دورو (منافق) یک کتاب یا لوحی را زیر بغل خود گرفته و به سوی پیامبر می‌آورد، اما این کار او از نیرنگ و حیله است."],[249,"بهر سوگندان که ایمان جنتی‌ست","زانک سوگند آن کژان را سنتی‌ست","سوگندهایی که از صحنه ایمان بهشت‌ساز می‌باشد، به همین دلیل است که سوگند آنان (منافقان) بدعتی است و نشانه بی‌دینی و کژاندیشی است."],[249,"چون ندارد مرد کژ در دین وفا","هر زمانی بشکند سوگند را","مرد کژ و ریاکار در دین وفاداری ندارد و هر زمان سوگندش را می‌شکند."],[249,"راستان را حاجت سوگند نیست","زانک ایشان را دو چشم روشنی‌ست","دیگر افراد راستین و درستکار نیازی به قسم خوردن ندارند، زیرا آن‌ها با بینش و بصیرت کامل، حقیقت را می‌شناسند."],[249,"نقض میثاق و عهود از احمقی‌ست","حفظ ایمان و وفا کار تقی‌ست","نقض عهد و پیمان از آدم نادان برمی‌آید، اما حفظ ایمان و وفا از نشانه‌های پرهیزگاری و تقواست."],[249,"گفت پیغامبر که سوگند شما","راست گیرم یا که سوگند خدا","پیامبر فرمود که آیا به قسم شما اعتماد کنم یا به قسم خدا که بر حق است؟"],[249,"باز سوگندی دگر خوردند قوم","مصحف اندر دست و بر لب مهر صوم","قوم منافق سوگند دیگری یاد کردند و در حالی که مصحف (قرآن) در دست داشتند و مهر روزه بر لبشان بود، نشان دادند که به دین و عبادت پایبندند."],[249,"که به حق این کلام پاک راست","کان بنای مسجد از بهر خداست","این سخن درست و حقیقت دارد که ساخت مسجد به منظور خداوند می‌باشد."],[249,"اندر آنجا هیچ حیله و مکر نیست","اندر آنجا ذکر و صدق و یاربی‌ست","در آن مکان هیچگونه فریب و نیرنگی وجود ندارد و تنها یاد خدا و صداقت و محبت برقرار است."],[249,"گفت پیغامبر که آواز خدا","می‌رسد در گوش من همچون صدا","حضرت پیامبر می‌گوید که صدای خدا به گوش من می‌رسد و این صدا مانند یک نوا است."],[249,"مهر بر گوش شما بنهاد حق","تا به آواز خدا نارد سبق","خداوند مهر (پرده‌ای) بر گوش شما قرار داده است تا نتوانید صدای او را بشنوید و در نتیجه، از آن پیشی نگیرید و آگاهی نیابید."],[249,"نک صریح آواز حق می‌آیدم","همچو صاف از درد می‌پالایدم","آواز حق به وضوح و شفافیت می‌رسد، درست مانند آب زلال که از دردها می‌زداید و انسان را پاک می‌کند."],[249,"همچنانکه موسی از سوی درخت","بانگ حق بشنید کای مسعودبخت","همانطور که موسی از درخت صدای حق را شنید که به او می‌گوید ای خوشبخت و کامیاب."],[249,"از درخت انی انا الله می‌شنید","با کلام انوار می‌آمد پدید","موسی از درختی صدای «انی انا الله» را می‌شنید و نور وحی او را آشکار می‌کرد."],[249,"چون ز نور وحی در می‌ماندند","باز نو سوگندها می‌خواندند","چون در ظلّ نور وحی دچار حیرت و سردرگمی می‌شدند، دوباره سوگندها و عهدهای جدیدی می‌گفتند."],[249,"چون خدا سوگند را خواند سپر","کی نهد اسپر ز کف پیگارگر","وقتی که خداوند به سوگندها ایمان بیاورد، دیگر کسی نمی‌تواند از زیر بار مسئولیت شانه خالی کند و مثل سپر از خود دفاع کند."],[249,"باز پیغامبر به تکذیب صریح","قد کذبتم گفت با ایشان فصیح","پیامبر به طور واضح و صریح به کسانی که او را دروغگو خوانده بودند، گفت: «شما دروغ گفتید»."],[250,"تا یکی یاری ز یاران رسول","در دلش انکار آمد زان نکول","یک نفر از یاران پیامبر در دلش نسبت به او شک و انکار پیدا کرده است."],[250,"که چنین پیران با شیب و وقار","می‌کندشان این پیمبر شرمسار","این پیامبر با وقار و سن بالای خود را شرمسار می‌کند، زیرا چنین افراد سالخورده‌ای باید از او انتظار حمایت و پشتیبانی داشته باشند."],[250,"کو کرم کو سترپوشی کو حیا","صد هزاران عیب پوشند انبیا","چرا پیامبران اینقدر بخشنده، سترپوش و با حیا هستند؟ آنها هزاران عیب را می‌پوشانند و به دیگران عذر می‌دهند."],[250,"باز در دل زود استغفار کرد","تا نگردد ز اعتراض او روی‌زرد","انسان باید به سرعت و بدون تأخیر از گناهان خود توبه کند تا دچار عیب‌جویی دیگران نشود و آبروی خود را نبازد."],[250,"شومی یاری اصحاب نفاق","کرد مؤمن را چو ایشان زشت و عاق","حضور یاران نفاق در جمع مؤمنان باعث می‌شود که آن‌ها به زشتی و وقاحت بیفتند و تحت تأثیر رفتار زشت آن‌ها قرار بگیرند."],[250,"باز می‌زارید کای علام سر","مر مرا مگذار بر کفران مصر","ای علام (معلم یا عالم) به من اجازه نده که بر کفر (بی‌دینی) مصر (کشور مصر و به طور خاص افرادی که از کفر یاد می‌شود) باقی بمانم و مرا از این وضعیت نجات بده."],[250,"دل به دستم نیست همچون دید چشم","ورنه دل را سوزمی این دم ز خشم","دل من در کنترل من نیست، مانند چشمی که تنها می‌بیند. اگر دل به دستم بود، این لحظه را از شدت خشم می‌سوزاندم."],[250,"اندرین اندیشه خوابش در ربود","مسجد ایشانش پر سرگین نمود","در این بیت، شاعر به وضوح بیان می‌کند که وقتی آن شخص در اندیشه و تفکر غرق شده، خواب او را می‌برد و در نتیجه، مسجد آنها به خاطر بی‌توجهی و غفلت در وضعیت نامناسبی قرار می‌گیرد و پر از فضولات می‌شود."],[250,"سنگهاش اندر حدث جای تباه","می‌دمید از سنگها دود سیاه","سنگ‌های او در حال تازیانه زدن بر زمین می‌غلطید و از آنها دود سیاه خارج می‌شد."],[250,"دود در حلقش شد و حلقش بخست","از نهیب دود تلخ از خواب جست","دود در گلوی او جمع شد و باعث شد که او به سختی و با دشواری نفس بکشد. این فشار ناشی از دود تلخ او را از خواب بیدار کرد و به حالت هوشیاری برگرداند."],[250,"در زمان در رو فتاد و می‌گریست","کای خدا اینها نشان منکریست","در زمان مرگ، او به شدت نگران و گریان شد و از خدا درخواست کرد که این نشانه‌ها نشان‌دهنده کفر و disbelief (انکار) است."],[250,"خلم بهتر از چنین حلم ای خدا","که کند از نور ایمانم جدا","ای خدا، حالم بهتر از این نوع صبر و بردباری نیست، زیرا که این حالت من را از نور ایمانم جدا می‌کند."],[250,"گر بکاوی کوشش اهل مجاز","تو بتو گنده بود همچون پیاز","اگر در تلاش باشی که کار و کوشش اهل مجاز (هزاران تفسیر و تشابه) را بررسی کنی، می‌بینی که این تلاش به اندازه یک پیاز در نظرش بزرگ و گنده است."],[250,"هر یکی از یکدگر بی مغزتر","صادقان را یک ز دیگر نغزتر","هر یک از این افراد بی‌مغزتر از دیگری هستند و در میان صادقان، یکی از دیگری فریبنده‌تر است."],[250,"صد کمر آن قوم بسته بر قبا","بهر هدم مسجد اهل قبا","آن قوم که به نیت ویران کردن مسجد اهل قبا (اهل مدینه) آمده بودند، بر تن خود صد زره (پوشش جنگی) بسته بودند."],[250,"همچو آن اصحاب فیل اندر حبش","کعبه‌ای کردند حق آتش زدش","چنان‌که آن اصحاب فیل در حبشه، کعبه را مورد حمله قرار دادند، خداوند با آتش به آنها پاسخ داد و کعبه را محفوظ نگه‌داشت."],[250,"قصد کعبه ساختند از انتقام","حالشان چون شد فرو خوان از کلام","آن‌ها از روی انتقام، تصمیم به سفر به کعبه گرفتند، اما وقتی از سخن پیامبر (ص) شنیدند که کعبه را از آنان دور کرده، این قصد را کنار گذاشتند."],[250,"مر سیه‌رویان دین را خود جهیز","نیست الا حیلت و مکر و ستیز","سفیدروها و نیکان دین بدون تدبیر و تدبیرگری و فریب و جنگ‌آوری نمی‌توانند به مقاصد خود برسند."],[250,"هر صحابی دید زان مسجد عیان","واقعه تا شد یقینشان سر آن","هر یک از صحابه در آن مسجد، واقعه‌ای را که مشاهده کردند به وضوح دیدند و این تجربه باعث شد که یقین آنان نسبت به آن موضوع بیشتر شود."],[250,"واقعات ار باز گویم یک بیک","پس یقین گردد صفا بر اهل شک","اگر وقایع را یکی یکی بیان کنم، برای کسانی که شک دارند، یقین حاصل می‌شود و این موضوع برای آنها روشن و شفاف خواهد شد."],[250,"لیک می‌ترسم ز کشف رازشان","نازنینانند و زیبد نازشان","من از روشن شدن راز این نازنینان می‌ترسم، زیرا شایسته است که ناز و کرامت آنها حفظ شود."],[250,"شرع بی تقلید می‌پذرفته‌اند","بی محک آن نقد را بگرفته‌اند","مردم در زمان‌های گذشته احکام دینی را بدون تقلید از دیگران می‌پذیرفتند و هر کسی به درستی و واقعی بودن آن احکام ایمان داشت."],[250,"حکمت قرآن چو ضاله مؤمن است","هر کسی در ضاله خود موقن است","حکمت و معانی قرآن مانند گم‌شده‌ای است که باعث هدایت مؤمنان می‌شود؛ هر کسی تنها به گمراهی خود یقین دارد و به آن می‌چسبد."],[251,"اشتری گم کردی و جستیش چست","چون بیابی چون ندانی کان تست؟","تو الاغی را گم کرده‌ای و به‌دنبال آن می‌گردی، حالا اگر آن را پیدا کنی، چگونه می‌فهمی که آن الاغ توست؟"],[251,"ضاله چه بود ناقه گم کرده‌ای","از کفت بگریخته در پرده‌ای","ضاله اشاره به شتری گم شده دارد که به خاطر اینکه از زن در پرده‌ای جدا شده، گم شده و این مشخص می‌کند که او تنها به دقت و جستجو در پی آن شتر می‌گردد."],[251,"آمده در بار کردن کاروان","اشتر تو زان میان گشته نهان","در حال بار کردن کاروان، شتر تو (که گم شده است) در میان دیگر شترها پنهان شده است."],[251,"می‌دوی این سو و آن سو خشک‌لب","کاروان شد دور و نزدیکست شب","تو در حالی به این سو و آن سو می‌دوئی که دهان‌ات از تشنگی خشک است، در حالی که کاروان به دور است و به نظر می‌رسد شب نزدیک شده است."],[251,"رخت مانده بر زمین در راه خوف","تو پی اشتر دوان گشته به‌طوف","لباس و بار و بنه‌ام بر زمین مانده، و من در جستجوی آن الاغ سرگردان تو، به خاطر ترس و نگرانی‌ام از تو، دویده‌ام."],[251,"کای مسلمانان که دیده‌ست اشتری","جسته بیرون بامداد از آخری","ای مسلمانان، آیا کسی از شما دیده است که چگونه شتری در صبح زود از جای خود رفته و گم شده است؟"],[251,"هر که بر گوید نشان از اشترم","مژدگانی می‌دهم چندین درم","هر کس بگوید که کجا می‌توانم نشانی از آن الاغ گمشده‌ام پیدا کنم، به او پاداش زیادی می‌دهم."],[251,"باز می‌جویی نشان از هر کسی","ریش‌خندت می‌کند زین هر خسی","اگر به دنبال نشانه‌ای از هر کسی باشی، افراد بی‌ارزش به تو می‌خندند و تو را مسخره می‌کنند."],[251,"که اشتری دیدیم می‌رفت این طرف","اشتری سرخی به سوی آن علف","شخصی در حال جستجوی الاغ گم‌شده‌اش است و در این میان، اشتری سرخ‌رنگ را می‌بیند که به سمت علف‌ها می‌رود."],[251,"آن یکی گوید بریده‌گوش بود","وآن دگر گوید جلش منقوش بود","یکی می‌گوید شتر گوشش بریده بود و دیگری می‌گوید که زینش نقاشی داشت."],[251,"آن یکی گوید شتر یک‌چشم بود","وآن دگر گوید ز گر بی‌پشم بود","یک نفر می‌گوید شتر یک‌چشم بوده و نفر دیگری می‌گوید شتر از گر (گرسنه) بدون پشم بوده است."],[251,"از برای مژدگانی صد نشان","از گزافه هر خسی کرده بیان","برای نشان دادن شادی و خوشحالی، هر شخص بی‌ارزشی به طور غیرمنطقی و بی‌دلیل چیزی را بیان کرده و بیان آن نشان‌دهنده‌ی وضعیت ناپایداری و نادرستی است."],[252,"همچنانک هر کسی در معرفت","می‌کند موصوف غیبی را صفت","هر کس به تناسب درک و آگاهی‌اش، ویژگی‌های خاصی برای حقیقت‌های غیبی بیان می‌کند."],[252,"فلسفی از نوع دیگر کرده شرح","باحثی مر گفت او را کرده جرح","فیلسوفی از نوعی متفاوت، توضیحاتی درباره بحثی ارائه کرده و به نحوی به انتقاد از او پرداخته است."],[252,"وآن دگر در هر دو طعنه می‌زند","وآن دگر از زرق جانی می‌کند","او (فردی که در گفته‌هایش به دو مذهب مختلف انتقاد می‌کند) به هر دو مراد طعنه می‌زند و دیگری با فریب و نیرنگ خودش را به‌عنوان شخصیتی عاقل و هوشمند جلوه می‌دهد."],[252,"هر یک از ره این نشانها زان دهند","تا گمان آید که ایشان زان ده‌اند","هر یک از این افراد با نشانه‌هایی که از خود نشان می‌دهند، باعث می‌شوند که تصور شود آنان از آن گروهی هستند که به آن تعلق دارند."],[252,"این حقیقت دان نه حق‌اند این همه","نه به کلی گمرهانند این رمه","این سخن را بدان که همه این افراد به حق دست نیافته‌اند و به صورت کامل گمراه نیستند، بلکه به نوعی در گمراهی هستند."],[252,"زانک بی حق باطلی ناید پدید","قلب را ابله به بوی زر خرید","چون بی‌حق و باطل چیزی نمی‌تواند به وجود آید، قلب ابله (نادان) فقط به خاطر بوی زر (طلا) به فریب می‌آید و چیزی را می‌خرد."],[252,"گر نبودی در جهان نقدی روان","قلبها را خرج کردن کی توان","اگر در جهان چیزی به عنوان نقد و ارزش واقعی وجود نداشت، چگونه می‌توانستیم قلب‌ها را برای چیزی خرج کنیم؟"],[252,"تا نباشد راست کی باشد دروغ","آن دروغ از راست می‌گیرد فروغ","چون راست وجود نداشته باشد، دروغ هم وجود ندارد، زیرا دروغ از راست و حقیقت نشأت می‌گیرد و روشنایی خود را از آن می‌گیرد."],[252,"بر امید راست کژ را می‌خرند","زهر در قندی رود آنگه خورند","انسان‌ها به امید حقیقت، حقیقت را به چیزهای نادرست نیز می‌فروشند و از همین رو، زهر را در قند پنهان می‌کنند تا آن را بپذیرند و بخورند."],[252,"گر نباشد گندم محبوب‌نوش","چه برد گندم‌نمای جو فروش","اگر در کار گندم محبوب و خوشمزه‌ای وجود نداشته باشد، چه سودی دارد که کسی که فقط جو را می‌فروشد، گندم را به نمایش بگذارد؟"],[252,"پس مگو کین جمله دمها باطل‌اند","باطلان بر بوی حق دام دل‌اند","نگو که تمام این سخنان بی‌فایده و بی‌اساس‌اند، زیرا باطل‌ها به دلیل وجود نکات حقیقی، دل انسان را به دام می‌اندازند."],[252,"پس مگو جمله خیالست و ضلال","بی‌حقیقت نیست در عالم خیال","نباید بگویی که همه چیز فقط خیال و گمراهی است، زیرا در عالم خیال هم بی‌حقیقت وجود ندارد و برخی واقعیات می‌توانند اتفاق بیفتند."],[252,"حق شب قدرست در شبها نهان","تا کند جان هر شبی را امتحان","شب قدر در شب‌های دیگر پنهان است تا جان هر شب را آزمایش کند."],[252,"نه همه شبها بود قدر ای جوان","نه همه شبها بود خالی از آن","هر شب به ارزش شب قدر نیست، ای جوان، زیرا برخی شب‌ها از این نعمت بی‌بهره‌اند و تنها در بعضی شب‌ها این فیض الهی وجود دارد."],[252,"در میان دلق‌پوشان یک فقیر","امتحان کن وانک حقست آن بگیر","در میان افرادی که به ظاهر دین و تقوا می‌پردازند، یک فرد فقیر را آزمایش کن؛ زیرا اگر حقیقت را پیدا کردی، آن شخص را بپذیر."],[252,"مؤمن کیس ممیز کو که تا","باز داند حیزکان را از فتی","مؤمن کیست که بتواند خوب و بد و فریبکاران را از راستگفتاران تشخیص دهد."],[252,"گرنه معیوبات باشد در جهان","تاجران باشند جمله ابلهان","اگر در دنیا عیب و نقصی وجود داشته باشد، پس همه‌ی تاجرها نادان و بی‌خبر خواهند بود."],[252,"پس بود کالاشناسی سخت سهل","چونک عیبی نیست چه نااهل و اهل","شناخت کالای خوب و بد کار ساده و در عین حال دشواری است، زیرا وقتی عیبی در کار نباشد، تفاوت میان افراد ناآگاه و آگاه به هم نزدیک می‌شود."],[252,"ور همه عیبست دانش سود نیست","چون همه چوبست اینجا عود نیست","اگر دانش فقط عیب‌ها را ببیند و نتواند سودی برساند، مانند چوبی است که به درد نمی‌خورد و در اینجا به نیکویی و خوش‌بو بودن عود (چوب عود) نیست."],[252,"آنکه گوید جمله حق‌اند احمقی‌ست","وانکه گوید جمله باطل او شقی‌ست","کسی که بگوید همه‌ی عقاید راست و حق‌اند، فردی نادان است و کسی که بگوید همه‌ی عقاید دروغ و باطل‌اند، آدمی بدبخت و شقاوت‌زده است."],[252,"تاجران انبیا کردند سود","تاجران رنگ و بو کور و کبود","تاجران (یعنی افرادی که به تجارت و کسب و کار اشتغال دارند) به پیامبران (انبیا) سود و نفع خود را می‌برند، اما آن‌ها (تاجران) به خاطر رنگ و جلای ظاهری، دلیلی بر حقایق نمی‌بینند و در حقیقت کور و نابینا هستند."],[252,"می‌نماید مار اندر چشم مال","هر دو چشم خویش را نیکو بمال","مار در این بیت象徴ی از شر و خطر است که در نگاه به مال و ثروت ایجاد می‌شود. هر دو چشم شخص به خوبی بر مال و ثروت می‌تابد، اما این توجه می‌تواند باعث فریب و آسیب شود. به عبارتی، تمرکز بر مال ممکن است به مشکلاتی خفی در زندگی شخص منجر شود."],[252,"منگر اندر غبطه این بیع و سود","بنگر اندر خسر فرعون و ثمود","به این حاشیه‌ها و حسرت‌های ناشی از خرید و فروش توجه نکن. بلکه به عاقبت و ضررهای فرعون و ثمود (قوم‌های سرکش تاریخ) نظر بیفکن که چگونه به عذاب‌های سخت مبتلا شدند."],[252,"اندرین گردون مکرر کن نظر","زانک حق فرمود ثم ارجع بصر","در این دنیا، دائما کارها و امور در حال تغییر و تحول هستند. به همین خاطر، از آنچه که خداوند گفته است، عبرت بگیر و دقت کن که بارها توجهت را به سمت او برگردانی."],[253,"یک نظر قانع مشو زین سقف نور","بارها بنگر ببین هل من فطور","فقط با یک نگاه به این سقف نورانی قانع نشو، چندین بار آن را تماشا کن و ببین آیا نقصی در آن هست یا نه."],[253,"چونک گفتت کاندرین سقف نکو","بارها بنگر چو مرد عیب‌جو","اگر گفتی که در این آسمان زیبا بارها به دقت نگاه کن، مثل مردی که همیشه عیب‌جو است، باید به حقیقت‌های پنهان توجه کنی."],[253,"پس زمین تیره را دانی که چند","دیدن و تمییز باید در پسند","پس برای تشخیص خوب و بد، باید مدت‌ها زمین تاریک را دید و با دقت سنجید تا حقیقت عیان شود."],[253,"تا بپالاییم صافان را ز درد","چند باید عقل ما را رنج برد","برای اینکه افراد با صفا و پاک را از دردها و مشکلات آزاد کنیم، باید عقل و اندیشه ما سختی‌ها و رنج‌های زیادی را تحمل کند."],[253,"امتحانهای زمستان و خزان","تاب تابستان بهار همچو جان","امتحان‌ها و آزمون‌های سختی که در فصل‌های سرد مانند زمستان و خزان وجود دارد، باعث می‌شود زیبایی‌ها و لذت‌های فصل‌های گرم‌تر و زندگی مانند بهار و تابستان به روشنی مشخص شود."],[253,"بادها و ابرها و برقها","تا پدید آرد عوارض فرقها","بادها و ابرها و رعد و برق‌ها برای این آمده‌اند که تفاوت‌ها و اثرات درونی انسان‌ها و موجودات را نمایان کنند."],[253,"تا برون آرد زمین خاک‌رنگ","هرچه اندر جیب دارد لعل و سنگ","زمین مانند دلی است که هر چیزی را که در خود دارد، در سرزمین خود نشان می‌دهد، مانند لعل و سنگ‌هایی که به رنگ خاک هستند و وقتی بیرون می‌آیند، خود را نمایان می‌کنند."],[253,"هرچه دزدیده‌ست این خاک دژم","از خزانه حق و دریای کرم","هرچیزی که این خاک زشت و بدجنس از خزانه خداوند و بخشندگی او دزدیده است، در واقع به‌دست آورده و از آنجا به‌دست نمی‌آید."],[253,"شحنه تقدیر گوید راست گو","آنچ بردی شرح وا ده مو به مو","شحنه تقدیر، که به نوعی نماد سرنوشت و تقدیر است، به تو خواهد گفت که با دقت و حقیقت هر آنچه را که دزدیده‌ای، به‌طور کامل و دقیق بازگو کن."],[253,"دزد یعنی خاک گوید هیچ هیچ","شحنه او را در کشد در پیچ پیچ","دزد به معنای حقیقی و ظاهری خود صحبت می‌کند و این‌طور می‌گوید که هیچ‌چیز ندارد. شحنه تقدیر (نماینده تقدیر) او را در هر حالتی شکار می‌کند و در جدیدترین و پیچیده‌ترین موقعیت‌ها به دام می‌اندازد."],[253,"شحنه گاهش لطف گوید چون شکر","گه بر آویزد کند هر چه بتر","نگهبان (شحنه) هرگاه که با مهربانی (لطف) برخورد کند، مانند شکر خود را نشان می‌دهد، اما وقتی به او (دزد) نزدیک می‌شود، تمام زشتی‌ها و بدی‌های او را فاش می‌کند."],[253,"تا میان قهر و لطف آن خفیه‌ها","ظاهر آید ز آتش خوف و رجا","برای اینکه حقیقت‌ها مشخص شود و رازهای نهفته بین قهر و لطف نمایان گردد، باید بین ترس از عذاب خدا و امید به رحمت او شکافتی وجود داشته باشد."],[253,"آن بهاران لطف شحنه کبریاست","و آن خزان تهدید و تخویف خداست","بهار به معنای لطف و رحمت الهی است و فصل خزان، تهدید و ترس از عذاب خداوند را نشان می‌دهد. در این بیت، بهار به عنوان نماینده‌ی بخشش و نعمت الهی و خزان به عنوان نشانه‌ی هشدار و ترس از عواقب گناه توصیف شده است."],[253,"و آن زمستان چارمیخ معنوی","تا تو ای دزد خفی ظاهر شوی","زمستان به معنای سختی و مشکلات روحی است که باعث می‌شود درستی و نادرستی وجود انسان نمایان شود تا دزد خفی، یعنی آن ناخالصی‌ها و نقاط ضعف درون، آشکار گردد."],[253,"پس مجاهد را زمانی بسط دل","یک زمانی قبض و درد و غش و غل","مجاهد (مبارز و تلاش‌گر روحانی) گاهی دلی وسیع و آرامش خاطر دارد و گاهی دچار درد و سختی و تنگی می‌شود."],[253,"زانک این آب و گلی کابدان ماست","منکر و دزد ضیای جانهاست","این آب و گل (جسم و بدن) که ما داریم، شبیه به زندانی است که موجب انکار و دزدی نور و روشنی جان‌ها می‌شود."],[253,"حق تعالی گرم و سرد و رنج و درد","بر تن ما می‌نهد ای شیرمرد","خداوند تعالی دردها و شادی‌ها، و همچنین سختی‌ها و راحتی‌ها را به بدن ما تحمیل می‌کند، ای مردان شجاع."],[253,"خوف و جوع و نقص اموال و بدن","جمله بهر نقد جان ظاهر شدن","ترس، گرسنگی و کمبود دارایی و سلامت جسم، همه به خاطر آزمایش روح و جان انسان‌ها بروز می‌کند."],[253,"این وعید و وعده‌ها انگیختست","بهر این نیک و بدی کآمیختست","این هشدارها و وعده‌های الهی به خاطر نیکی و بدی‌ای است که در هم آمیخته‌اند و باعث شده تا انسان‌ها به چنین حالتی دچار شوند."],[253,"چونک حق و باطلی آمیختند","نقد و قلب اندر حرمدان ریختند","چون حقیقت و باطل با هم آمیخته شدند، ارزش واقعی و قلب و روح در دل‌ها گم شده است."],[253,"پس محک می‌بایدش بگزیده‌ای","در حقایق امتحانها دیده‌ای","پس باید آزمایشی انجام شود تا حقیقتی را که در حقایق و امتحان‌ها دیده‌ای، مشخص کند."],[253,"تا شود فاروق این تزویرها","تا بود دستور این تدبیرها","این بیت می‌گوید برای اینکه حقایق پنهان و فریب‌ها روشن شوند و از یکدیگر تفکیک گردند، باید دستوری برای تدبیر این امور وجود داشته باشد."],[253,"شیر ده ای مادر موسی ورا","واندر آب افکن میندیش از بلا","مادر موسی باید به او شیر بدهد و او را در آب بیندازد و نباید از خطراتی که ممکن است برایش پیش بیاید نگران باشد."],[253,"هر که در روز الست آن شیر خورد","همچو موسی شیر را تمییز کرد","هر کسی که در عالم الست، یعنی در همان زمان پیش از آفرینش، از شیر الهی بهره‌مند شده باشد، مانند موسی، می‌تواند خیر و شر را از یکدیگر تشخیص دهد."],[253,"گر تو بر تمییز طفلت مولعی","این زمان یا ام موسی ارضعی","اگر تو در تشخیص درست و نادرست، مانند طفلی هستی که به شدت به شیر مادرش وابسته است، پس ای مادر موسی، همین حالا او را شیر بده."],[253,"تا ببیند طعم شیر مادرش","تا فرو ناید بدایه بد سرش","تا زمانی که کودک طعم شیر مادرش را بچشد، بدی‌ها و ناپاکی‌ها از سرش دور نخواهد شد."],[254,"اشتری گم کرده‌ای ای معتمد","هر کسی ز اشتر نشانت می‌دهد","تو شتری را گم کرده‌ای و به کسی اعتماد کرده‌ای، در حالی که هر کس نشانی از آن شتر به تو می‌دهد."],[254,"تو نمی‌دانی که آن اشتر کجاست","لیک دانی کین نشانیها خطاست","تو نمی‌دانی که آن شتر کجاست، ولی می‌دانی که این نشانه‌ها نادرست هستند."],[254,"وانک اشتر گم نکرد او از مری","همچو آن گم کرده جوید اشتری","او (شخصی که در اینجا صحبت می‌شود) شتر گم نکرده، بلکه او مانند آن شتر، چیزی را که در پی آن است، جستجو می‌کند. در واقع، او در پی حقیقت یا منظور واقعی‌اش است."],[254,"که بلی من هم شتر گم کرده‌ام","هر که یابد اجرتش آورده‌ام","من نیز شتری را گم کرده‌ام و هر کسی که آن را پیدا کند، پاداشی برای او در نظر گرفته‌ام."],[254,"تا در اشتر با تو انبازی کند","بهر طمع اشتر این بازی کند","این بیت می‌گوید: تا شتر با تو هم‌نشینی کند، شتر برای رسیدن به طمع خود این رفتار را می‌کند."],[254,"او نشان کژ بنشناسد ز راست","لیک گفتت آن مقلد را عصاست","او نمی‌تواند نشانه‌های درست را از نادرست تشخیص دهد، اما به حرف‌های تو که اشتباه می‌گویی، به عنوان دلیلی پیروی می‌کند."],[254,"هرچه را گویی خطا بود آن نشان","او به تقلید تو می‌گوید همان","هر چه را که بگویی اشتباه است، او به خاطر تقلید از تو همان حرف را می‌زند."],[254,"چون نشان راست گویند و شبیه","پس یقین گردد تو را لا ریب فیه","وقتی چیزی را که درست است بیان می‌کنند و شبیه به حقیقت به نظر می‌رسد، به یقین به آن پی می‌بری و دیگر در آن شک نمی‌کنی."],[254,"آن شفای جان رنجورت شود","رنگ روی و صحت و زورت شود","آن چیزی که باعث آرامش و شفا و بهبودی روح و جان تو می‌شود، به تو نشاط و قوت و تندرستی می‌بخشد."],[254,"چشم تو روشن شود پایت دوان","جسم تو جان گردد و جانت روان","چشم تو روشن می‌شود و پای تو به حرکت درمی‌آید؛ جسم تو زنده و شاداب می‌شود و جان تو به زندگی و تحرک می‌افتد."],[254,"پس بگویی راست گفتی ای امین","این نشانیها بلاغ آمد مبین","پس تو راست گفتی، ای اعتماد و امانت‌دار، این نشانه‌ها برای ما به روشنی و وضوح آمده است."],[254,"فیه آیات ثقات بینات","این براتی باشد و قدر نجات","این نشان‌ها دلایل واضح و راست و محکمی هستند که این نامه من (که به نجات می‌انجامد) را تأیید می‌کند."],[254,"این نشان چون داد گویی پیش رو","وقت آهنگست پیش‌آهنگ شو","زمانی که این نشانه ظاهر شد، انگار که فرارسیدن وقت سفر نزدیک است. بنابراین، خودت را آماده کن و به پیشتازی بپرداز."],[254,"پی روی تو کنم ای راست‌گو","بوی بردی ز اشترم بنما که کو","ای راست‌گو، من از تو پیروی می‌کنم؛ تو بویی از شترم به من دادی، حالا نشان بده شتر کجاست."],[254,"پیش آنکس که نه صاحب اشتریست","کو درین جست شتر بهر مریست","کسی که شتری ندارد و به دنبال شتر می‌گردد، نمی‌تواند در این جست‌وجو به کسی که شتر دارد، اعتماد کند."],[254,"زین نشان راست نفزودش یقین","جز ز عکس ناقه‌جوی راستین","از این نشانه، او یقینش افزوده نمی‌شود، جز به خاطر خیال و تصور شتر جویای حقیقت."],[254,"بوی برد از جد و گرمیهای او","که گزافه نیست این هیهای او","بوی جد (نیا) و گرمی‌های او (شخصیتی که به آن اشاره شده) از او به مشام می‌رسد و این موضوع تصادفی نیست؛ بلکه نشان‌دهنده‌ی کیفیت و ویژگی‌های اوست."],[254,"اندرین اشتر نبودش حق ولی","اشتری گم کرده است او هم بلی","در این بیت اشاره شده است که این شخص (اشتر جوینده) در حقیقت هیچ حقی بر این شتر ندارد، اما به هر حال او شتری را گم کرده است که نشان‌دهنده نداشته‌های او و پیوندی است که به آن گم شده احساس می‌کند."],[254,"طمع ناقه غیر روپوشش شده","آنچ ازو گم شد فراموشش شده","طمع به‌عنوان یک زین برای شتر دیگری بر او سوار شده و آنچه را که از او گم شده، به فراموشی سپرده است."],[254,"هر کجا او می‌دود این می‌دود","از طمع هم‌درد صاحب می‌شود","هر جا که آن شخص (طمع) می‌رود، این (حسد یا شوق ناشی از طمع) نیز او را دنبال می‌کند و به او آسیب می‌زند."],[254,"کاذبی با صادقی چون شد روان","آن دروغش راستی شد ناگهان","زمانی که شخصی دروغگو با فردی راستگو همراه می‌شود، به ناگاه دروغ او تبدیل به حقیقت می‌گردد."],[254,"اندر آن صحرا که آن اشتر شتافت","اشتر خود نیز آن دیگر بیافت","در آن صحرا که شتری در حال دویدن بود، شتر دیگری هم به او پیوست و او را یافت."],[254,"چون بدیدش یاد آورد آن خویش","بی طمع شد ز اشتر آن یار و خویش","زمانی که او (مقلد) شتر خود را دید، به یاد شتر خودش افتاد و از آن شتر دیگر (یار و خویش) که مال دیگری است، بی‌نیاز شد و دیگر طمعی به آن نداشت."],[254,"آن مقلد شد محقق چون بدید","اشتر خود را که آنجا می‌چرید","آن فرد تقلیدکننده، به محقق و دانشمندی تبدیل شد زیرا شتر خود را در آنجا دید که در حال چریدن است."],[254,"او طلب‌کار شتر آن لحظه گشت","می‌نجستش تا ندید او را بدشت","او در آن لحظه که شترش را گم کرده بود، به دنبال آن می‌گشت و به دنبال پرهیز از یافتن آن تا وقتی که شترش را در صحرا ندید، تلاش می‌کرد."],[254,"بعد از آن تنهاروی آغاز کرد","چشم سوی ناقه خود باز کرد","آن مرد پس از مدتی که به تنهایی به راه افتاد، نگاهش را به شتر خود معطوف کرد."],[254,"گفت آن صادق مرا بگذاشتی","تا باکنون پاس من می‌داشتی","او می‌گوید: «ای صادق، تو مرا رها کردی و دیگر از من حمایت نکردی تا به حال."],[254,"گفت تا اکنون فسوسی بوده‌ام","وز طمع در چاپلوسی بوده‌ام","می‌گوید تا به حال آدم فریب‌کاری بوده‌ام و به طمع جلب توجه و چاپلوسی دیگران، رفتار کرده‌ام."],[254,"این زمان هم درد تو گشتم که من","در طلب از تو جدا گشتم به تن","اینک من هم از درد تو رنج می‌برم، زیرا برای جستجوی تو از بدنی جدا شدم."],[254,"از تو می‌دزدیدمی وصف شتر","جان من دید آن خود شد چشم‌پر","من از تو وصف شتر را می‌دزدیدم، اما جان من (یعنی خودم) آن را دید و به همین خاطر، چشمانم پر از اشتیاق و شوق شد."],[254,"تا نیابیدم نبودم طالبش","مس کنون مغلوب شد زر غالبش","قبل از آن‌که شتر مورد نظر را پیدا کنم، به دنبالش نبودم، اما اکنون، که آن را یافته‌ام، تحت تأثیر و تسلط آن قرار گرفتم."],[254,"سیاتم شد همه طاعات شکر","هزل شد فانی و جد اثبات شکر","همه اعمال نیک من به شکرگذاری و قدردانی تبدیل شده است و شوخی و بی‌اهمیتی از بین رفته و جدیت در اثبات شکر و سپاس باقی مانده است."],[254,"سیاتم چون وسیلت شد بحق","پس مزن بر سیاتم هیچ دق","شکل و ظاهرم (سیاتم) به عنوان وسیله‌ای برای ارتباط با خداوند (حق) قرار گرفته است، پس بر این ظاهرم هیچ شک و تردیدی نزن."],[254,"مر تو را صدق تو طالب کرده بود","مر مرا جد و طلب صدقی گشود","صداقت تو باعث شد که تو به دنبال حق و حقیقت بروی، و صداقت من نیز در جستجوی تو به من راه نشان داد."],[254,"صدق تو آورد در جستن تو را","جستنم آورد در صدقی مرا","صداقتی که تو در جستجوی آن داشتی، باعث شد تا من نیز در پی صداقت تو بیفتم و به جستجو پردازم."],[254,"تخم دولت در زمین می‌کاشتم","سخره و بیگار می‌پنداشتم","من در زمین تلاش می‌کردم تا بذر دولت و ثروت را بکارم، اما آن را به حساب زحمت و کارگری می‌گذاشتم."],[254,"آن نبد بیگار کسبی بود چست","هر یکی دانه که کشتم صد برست","این کار سخت و بی‌فایده‌ای نبود، بلکه برای هر دانه‌ای که کاشتم، صد برابر چیزی به دست می‌آید."],[254,"دزد سوی خانه‌ای شد زیر دست","چون در آمد دید کان خانه خودست","دزدی به سمت خانه‌ای رفت و وقتی وارد شد، متوجه شد که آن خانه متعلق به خودش است."],[254,"گرم باش ای سرد تا گرمی رسد","با درشتی ساز تا نرمی رسد","ای کسی که در حال سردی و سختی هستی، تا هنگامی که گرما و آسیب رسید، با صبر و استقامت رفتار کن تا زمانی که نرمی و آرامش به وجود آید."],[254,"آن دو اشتر نیست آن یک اشترست","تنگ آمد لفظ معنی بس پرست","این بیت می‌گوید که ما در اصطلاحات و واژه‌ها با هم اختلاف داریم؛ اگرچه ممکن است دو نفر به ظاهری مشابه به یک موضوع اشاره کنند، در واقع هر کسی به طور متفاوتی از آن مفهوم برداشت می‌کند. بنابراین، تنها یک شتر (مفهوم) وجود دارد که در ذهن‌ها متفاوت است و این تفاوت در فهم و بیان کلمات را به تصویر می‌کشد."],[254,"لفظ در معنی همیشه نارسان","زان پیمبر گفت قد کل لسان","هر لفظی نمی‌تواند به‌طور کامل معنی را بیان کند، همان‌طور که پیامبر گفته است که هر زبانی از بیان حقیقت ناتوان است."],[254,"نطق اصطرلاب باشد در حساب","چه قدر داند ز چرخ و آفتاب","سخن او مثل صدای اصطرلاب (وسیلۀ قدیمی برای اندازه‌گیری زمان) است که در علم ریاضی، چه مقدار از حرکت آسمان و خورشید را می‌داند. به عبارت دیگر، او خیلی اندک از امور کیهانی آگاه است."],[254,"خاصه چرخی کین فلک زو پره‌ایست","آفتاب از آفتابش ذره‌ایست","این بیت به نسبت کوچک و ناچیز انسان در برابر عظمت آفرینش اشاره دارد. منظور این است که این جهان (فلک) به معنای کل عالم وجود، آفتابی دارد که خود فقط ذره‌ای از آفتاب الهی است و این فلک مملو از آثار و نشانه‌های آن آفتاب الهی است."],[255,"چون پدید آمد که آن مسجد نبود","خانه حیلت بد و دام جهود","زمانی که مشخص شد آن مسجد فقط مکان نیرنگ و فریب بوده و از سوی یهودیان ساخته شده است، دیگر نباید به آن اعتبار داشت."],[255,"پس نبی فرمود کان را بر کنند","مطرحه خاشاک و خاکستر کنند","پیامبر فرمود که باید این مکان نامناسب را از خاشاک و خاکستر پاک کنند، تا دیگر جایی برای حیله‌گری باقی نماند."],[255,"صاحب مسجد چو مسجد قلب بود","دانه‌ها بر دام ریزی نیست جود","صاحب مسجد (از نظر معنوی) اگر قلب او باشد، در این حالت دیگر دانه‌ها (نعمت‌ها) بر دام (تله) او نمی‌ریزد، زیرا او بخشنده است و فضل و جود (احسان) دارد."],[255,"گوشت اندر شست تو ماهی‌رباست","آنچنان لقمه نه بخشش نه سخاست","در انگشت تو، گوشت مانند ماهی‌رباست و آن لقمه‌ای که درشت است، نه بخشش دارد و نه حد و اندازه‌ای."],[255,"مسجد اهل قبا کان بد جماد","آنچ کفو او نبد راهش نداد","مسجد اهل قبا (مسجدی که خاص گروهی مؤمن و متدین است) شبیه به جمادات (چیزهای بی‌روح) است و اگر کسی که شایسته (کفو) آن نیست به آن راه یابد، فضای آن را نخواهد پذیرفت و نمی‌تواند در آن جا بگیرد."],[255,"در جمادات این چنین حیفی نرفت","زد در آن ناکفو امیر داد نفت","در اشیاء بی‌جان، چنین ظلمی وجود ندارد، اما در آن شخص ناپاک و بی‌تفاوت، ظلم و ستم به مردم رواج دارد."],[255,"پس حقایق را که اصل اصلهاست","دان که آنجا فرقها و فصلهاست","حقایق اصلی و اساسی را بشناس و درک کن، زیرا در اینجا تفاوت‌ها و شفافیت‌های مهمی وجود دارد."],[255,"نه حیاتش چون حیات او بود","نه مماتش چون ممات او بود","حیات و مرگ او (شخصیت ذکر شده) نه مانند زندگی دیگران است و نه مانند مرگ آن‌ها. منظور این است که وجود او ویژگی‌های خاص و منحصر به فردی دارد که آن را از دیگران متمایز می‌کند."],[255,"گور او هرگز چو گور او مدان","خود چه گویم حال فرق آن جهان","هرگز گور او را مانند گور او (پیامبر) نپندار، زیرا نمی‌دانم حال او چگونه است و چه تفاوتی بین این دنیا و آن دنیا وجود دارد."],[255,"بر محک زن کار خود ای مرد کار","تا نسازی مسجد اهل ضرار","ای مرد، عمل خود را با دقت و سنجش بررسی کن، زیرا تا زمانی که مسجد اهل ضرار را نساخته‌ای، نباید بی‌محابا کاری انجام دهی."],[255,"بس در آن مسجدکنان تسخر زدی","چون نظر کردی تو خود زیشان بدی","وقتی در آن مسجد ضرار به قوم بد نگاه کردی، مسخره کردن آنها را آغاز کردی."],[256,"چار هندو در یکی مسجد شدند","بهر طاعت راکع و ساجد شدند","چهار هندو به یکی مسجد رفتند و به عبادت پرداختند و در حالت رکوع و سجود قرار گرفتند."],[256,"هر یکی بر نیتی تکبیر کرد","در نماز آمد به مسکینی و درد","هر کدام از هندوها با نیت خاصی الله‌اکبر گفتند و در نماز حاضر شدند، اما نمی‌دانستند که همگی در حال درد و محنت هستند."],[256,"مؤذن آمد از یکی لفظی بجست","کای مؤذن بانگ کردی وقت هست","مؤذن به هندو می‌گوید که صدای اذان را بلند کرد و زمان نماز فرا رسیده است."],[256,"گفت آن هندوی دیگر از نیاز","هی سخن گفتی و باطل شد نماز","هندو دوم گفت: تو به خاطر نیازت صحبت کردی و همین سبب باطل شدن نماز تو شد."],[256,"آن سیم گفت آن دوم را ای عمو","چه زنی طعنه برو خود را بگو","هندو سوم به هندو دوم می‌گوید، ای عموی من، به او طعنه میزنی در حالی که خودت هم به همین حال مبتلا هستی؛ بهتر است به خودت نگاه کنی."],[256,"آن چهارم گفت حمد الله که من","در نیفتادم به چه چون آن سه تن","او (چهره چهارم) می‌گوید خدا را شکر که من مثل آن سه نفر دیگر در مشکلات و سختی‌ها نیفتادم."],[256,"پس نماز هر چهاران شد تباه","عیب‌گویان بیشتر گم کرده راه","پس از آن که این چهار نفر درگیر جنگ و جدل شدند، نماز آنها بی‌فایده و بی‌ثمر شد و عیب‌گویان بیشتر از قبل گمراه و راه را اشتباه رفتند."],[256,"ای خنک جانی که عیب خویش دید","هر که عیبی گفت آن بر خود خرید","خوشا به حال کسی که عیب خودش را نگاه می‌کند و آن را می‌شناسد؛ زیرا هر کسی که عیبی درباره دیگری می‌گوید، در واقع همان عیب را بر خود پذیرفته است."],[256,"زانک نیم او ز عیبستان بدست","وآن دگر نیمش ز غیبستان بدست","نیمی از انسان از عیب‌ها و کمبودهای خودش ریشه می‌گیرد و نیمه دیگرش از جهان غیب و اسرار الهی نشأت می‌گیرد."],[256,"چونک بر سر مر تو را ده ریش هست","مرهمت بر خویش باید کار بست","هرگاه بر سر تو مشکلی وجود دارد، باید درمان آن را در خودت جستجو کنی و به خودت توجه کنی."],[256,"عیب کردن خویش را داروی اوست","چون شکسته گشت جای ارحمواست","نقد کردن و اصلاح عیب‌های خود، درمانی برای دیگران است، چون هنگامی که کسی در مورد دیگران قضاوت می‌کند، به نوعی در شرایطی مشابه قرار می‌گیرد و جالب اینجاست که باید از خود نیز رحم کند."],[256,"گر همان عیبت نبود ایمن مباش","بوک آن عیب از تو گردد نیز فاش","اگر از عیب خود مطمئن نیستی، نباید احساس امنیت کنی، چون ممکن است همان عیب خودت نیز در آینده آشکار شود."],[256,"لا تخافوا از خدا نشنیده‌ای","پس چه خود را ایمن و خوش دیده‌ای","از خدا بترسید، زیرا اگر از او غافل شوید، چرا خود را در امنیت و خوشبختی می‌بینید؟"],[256,"سالها ابلیس نیکونام زیست","گشت رسوا بین که او را نام چیست","سال‌ها ابلیس (شیطان) در پوشش نیکویی زندگی کرد و در نهایت رسوا شد، زیرا دریافت که نام او چیست و حقیقت وجودش فاش شد."],[256,"در جهان معروف بد علیای او","گشت معروفی بعکس ای وای او","در این دنیا، بدی‌های علیای (علیای به معنای بالای) آدمی معروف و شناخته می‌شود، و این واقعیت برای او بسیار دردناک و نگران‌کننده است."],[256,"تا نه‌ای ایمن تو معروفی مجو","رو بشوی از خوف پس بنمای رو","تا زمانی که تو در امان نیستی، به دنبال شهرت نرو و برای خالی کردن دل خود از ترس، چهره‌ات را آشکار مکن."],[256,"تا نروید ریش تو ای خوب من","بر دگر ساده‌زنخ طعنه مزن","ای خوبی من، مادامی که خودت هم در معرض خطر و گرفتاری نیستی، به دیگران که در وضع مشابهی هستند، طعنه نزن و به آنها ایراد نگیر."],[256,"این نگر که مبتلا شد جان او","در چهی افتاد تا شد پند تو","به این موضوع توجه کن که او نیز در دامی گرفتار شده که تو در آن افتاده‌ای، و از چه چیزهایی رنج می‌برد که باعث شده تا به تو پند دهد."],[256,"تو نیفتادی که باشی پند او","زهر او نوشید تو خور قند او","تو به درد و گرفتاری او مبتلا نشدی که پند او را بگیری، بلکه زهر او را نوشیدی و شیرینی‌اش را چشیدی."],[257,"آن غزان ترک خون‌ریز آمدند","بهر یغما بر دهی ناگه زدند","آن گروه از غزان ترک که تبهکار و خون‌ریز بودند، ناگهان به دهی حمله کردند تا دارایی‌ها و سایر غنائم را بدزدند."],[257,"دو کس از اعیان آن ده یافتند","در هلاک آن یکی بشتافتند","دو نفر از شخصیت‌های برجسته آن ده را پیدا کردند و برای کشتن یکی از آن‌ها به سرعت حرکت کردند."],[257,"دست بستندش که قربانش کنند","گفت ای شاهان و ارکان بلند","او را گرفتار کردند تا قربانی‌اش کنند، او در پاسخ به شاهان و مقام‌های بلند می‌گوید."],[257,"در چه مرگم چرا می‌افکنید","از چه آخر تشنه خون منید","چرا مرا به سوی مرگ می‌کشید و چرا اینقدر به خون من علاقه‌مند شده‌اید، در حالی که من نیازمند زندگی‌ام؟"],[257,"چیست حکمت چه غرض در کشتنم","چون چنین درویشم و عریان‌تنم","چرا قصد کشتن من را دارید و هدف شما از این کار چیست، در حالی که من درویش و بی‌پوشش هستم؟"],[257,"گفت تا هیبت برین یارت زند","تا بترسد او و زر پیدا کند","گفت اگر تو با این شکوه و هیبت بر او ظاهر شوی، او می‌ترسد و به دنبال پیدا کردن زر و ثروت خواهد رفت."],[257,"گفت آخر او ز من مسکین‌ترست","گفت قاصد کرده است او را زرست","او می‌گوید که شخص مورد نظر (که به او اشاره دارد) از من بیچاره‌تر است، زیرا فرستاده‌ای از سوی او وجود دارد که به او چیزی داده است (زر، یعنی طلا یا مال) تا از من ترسان‌تر باشد و احساس برتری کند."],[257,"گفت چون وهمست ما هر دو یکیم","در مقام احتمال و در شکیم","او می‌گوید که ما هر دو در وضعیتی هستیم که نمی‌توانیم به یقین بگوییم چه چیزی درست است و به همین دلیل در حالت تردید و شک به سر می‌بریم. این تصور ما را به یکدیگر نزدیک می‌کند."],[257,"خود ورا بکشید اول ای شهان","تا بترسم من دهم زر را نشان","ای شاهان، نخست باید آن شخص را بکشید تا من از این کار بترسم و نشانه‌ای از زر (خود را) به شما بدهم."],[257,"پس کرمهای الهی بین که ما","آمدیم آخر زمان در انتها","پس به رحمت‌های الهی توجه کن که ما در آخرین زمان وارد شده‌ایم."],[257,"آخرین قرنها پیش از قرون","در حدیثست آخرون السابقون","در آخرین قرن‌ها که پیش از دیگر قرون آمده، در احادیث و سخنان نشان داده شده که کسانی هستند که پیشی گرفته‌اند."],[257,"تا هلاک قوم نوح و قوم هود","عارض رحمت بجان ما نمود","خدای رحمتش را بر ما نازل کرد تا به دلیل هلاکت قوم نوح و قوم هود، ما را از بلاها و خطرها محافظت کند."],[257,"کشت ایشان را که ما ترسیم ازو","ور خود این بر عکس کردی وای تو","خداوند قوم نوح و قوم هود را نابود کرد تا ما را از عذاب آنها نجات دهد؛ اما تو برعکس عمل کرده‌ای و دستور به کشتن آنها می‌دهی، وای بر تو."],[258,"هر که زیشان گفت از عیب و گناه","وز دل چون سنگ وز جان سیاه","هر کسی که از انبیا و اولیا عیب و گناه بگوید و دلش سخت و بی‌احساس باشد و جانش آلوده به سیاهی باشد، در حقیقت خود را به سختی و تاریکی دچار کرده است."],[258,"وز سبک‌داری فرمانهای او","وز فراغت از غم فردای او","انسانی که به تبعیت از فرامین الهی و پیامبران زندگی کند، از بار سنگین نگرانی درباره آینده رهایی می‌یابد و سبک‌بار می‌شود."],[258,"وز هوس وز عشق این دنیای دون","چون زنان مر نفس را بودن زبون","انسان برای رهایی از خواسته‌ها و عشق به این دنیای پست، باید مانند زنان نفس خود را سرکوب کند و خوار و ذلیل نماید."],[258,"وان فرار از نکته‌های ناصحان","وان رمیدن از لقای صالحان","این دو بیت به معنای فرار کردن و دوری گزیدن از نصیحت‌های درست و نکته‌های نیکان و صالحان اشاره دارد. شخصی که از خواسته‌های نفس و دنیای پست غرق شده، به جای پذیرش راهنمایی‌های خوب، از تعامل با انسان‌های درست و با تقوا دوری می‌کند."],[258,"با دل و با اهل دل بیگانگی","با شهان تزویر و روبه‌شانگی","آدم‌های ریاکار و تزویر را می‌بینید که بی‌محابا به سوی باطل می‌روند، اما شما نباید از دل و دل‌سوزان دور شوید و به آن‌ها بی‌اعتنا باشید. در واقع، این آیه روی بیگانگی با اهل دل و کسانی که به حقیقت در ارتباط هستند تأکید می‌کند."],[258,"سیر چشمان را گدا پنداشتن","از حسدشان خفیه دشمن داشتن","چشم‌داشتن به دیگران و در دل آنها حسد ورزیدن باعث می‌شود که انسان حتی به خود بی‌پناهی مثل گدا هم مانند دشمنی خفی نگاه کند."],[258,"گر پذیرد چیز تو گویی گداست","ورنه گویی زرق و مکرست و دغاست","اگر چیزی را که تو داری بپذیرد، اینجا او همچون گدا به نظر می‌آید، وگرنه می‌توان گفت که او فریبکار و نیرنگ‌باز است."],[258,"گر در آمیزد تو گویی طامعست","ورنی گویی در تکبر مولعست","اگر کسی در کار دیگران دخالت کند، به نظر می‌رسد طمعکار است، وگرنه به نظر می‌رسد که در خودخواهی و تکبر غرق شده است."],[258,"یا منافق‌وار عذر آری که من","مانده‌ام در نفقه فرزند و زن","تو به گونه‌ای نفاق‌آمیز عذرت را پیش می‌کشی که می‌گویی من به خاطر تأمین هزینه‌های فرزند و همسرم در شرایط سختی قرار دارم."],[258,"نه مرا پروای سر خاریدنست","نه مرا پروای دین ورزیدنست","من هیچ اهمیتی به خراشیدن سر و دردسرهای آن نمی‌دهم و نه به رعایت اصول دینی و انجام مراسم مربوط به آن اهمیت می‌دهم."],[258,"ای فلان ما را بهمت یاد دار","تا شویم از اولیا پایان کار","ای شخص خاص، ما را به خوبی یاد کن تا در نهایت کار، به صف اولیای الهی بپیوندیم."],[258,"این سخن نی هم ز درد و سوز گفت","خوابناکی هرزه گفت و باز خفت","این گفته در حقیقت از سر درد و سوز است و یادآور این است که برخی افراد به دلیل بی‌توجهی و بی‌خود بودن، حرف‌های بی‌محتوا و بی‌معنا می‌زنند و دوباره به خواب می‌روند."],[258,"هیچ چاره نیست از قوت عیال","از بن دندان کنم کسپ حلال","هیچ راهی از تأمین زندگی و نیازهای خانواده وجود ندارد، جز اینکه از موجودیتم و از دندان خودم به سختی به دست آورم و حلال (آشامیدنی و روزی) به دست بیاورم."],[258,"چه حلال ای گشته از اهل ضلال","غیر خون تو نمی‌بینم حلال","تنها چیزی که از نظر من حلال است، خون توست، زیرا دیگر چیزها از نظر اهل گمراهی (غیر از تو) حلال نیستند."],[258,"از خدا چاره‌ستش و از قوت نی","چاره‌ش است از دین و از طاغوت نی","چاره و راه نجات او فقط در خداوند است، نه در نیروی خود و نه در دین طاغوت‌وار. او نمی‌تواند به کمک‌های دنیوی یا اعتقادات نادرست اتکا کند."],[258,"ای که صبرت نیست از دنیای دون","صبر چون داری ز نعم الماهدون","ای کسی که تحمل و صبرت از این دنیای پست کم شده، چگونه می‌توانی از نعمت‌های هدایت یافتگان (پیامبران و اولیای خدا) بهره‌مند شوی؟"],[258,"ای که صبرت نیست از ناز و نعیم","صبر چون داری از الله کریم","اگر توان صبر بر نعمت‌ها و لذات دنیوی را نداری، چگونه می‌توانی صبر بر آزمایش‌ها و سختی‌ها در راه خداوند رحیم داشته باشی؟"],[258,"ای که صبرت نیست از پاک و پلید","صبر چون داری از آن کین آفرید","ای کسی که در برابر خوبی‌ها و بدی‌ها صبر نداری، چطور می‌توانی از خداوندی که تو را آفریده تحمل کنی؟"],[258,"کو خلیلی کو برون آمد ز غار","گفت هذا رب هان کو کردگار","خلیل که همان ابراهیم خلیل (علیه‌السلام) است، کیست که از غار بیرون آمد و گفت: \"این است پروردگار\"، پس خالق چه کسی است؟ این بیت به جستجوی حقیقت و درک عمیق وجود خداوند اشاره دارد."],[258,"من نخواهم در دو عالم بنگریست","تا نبینم این دو مجلس آن کیست","من در هیچ یک از این دو جهان نمی‌خواهم نگاه کنم تا اینکه بدانم این دو مجلس (مجلس انبیا و اولیا) چه کسانی هستند و چه جایگاهی دارند."],[258,"بی تماشای صفتهای خدا","گر خورم نان در گلو ماند مرا","اگر بدون تماشای صفات خداوند نان بخورم، آن نان در گلوی من خواهد ماند و نمی‌توانم آن را ببلعم."],[258,"چون گوارد لقمه بی دیدار او","بی تماشای گل و گلزار او","اگر لقمه‌ای بخورم و در حین آن به او، یعنی خدا، توجه نداشته باشم و زیبایی‌های او و طبیعت را نبینم، در واقع چیزی نخورده‌ام."],[258,"جز بر اومید خدا زین آب و خور","کی خورد یک لحظه غیر گاو و خر","فقط به امید خدا باید از این آب و خوراک استفاده کرد، زیرا در غیر این صورت، انسان هیچ فرقی با گاو و خر ندارد و فقط به شکم‌پری می‌گذرد."],[258,"آنک کالانعام بد بل هم اضل","گرچه پر مکرست آن گنده‌بغل","این بیت به افرادی اشاره دارد که مانند حیوانات (گاو و خر) تنها به خورد و خوراک خود توجه دارند و در عین حال، بسیار فریبکار و مکار هستند. این افراد از نظر معنوی حتی از حیوانات نیز بدترند و در واقع، به دلیل ویژگی‌های منفی خود، در مسیر درست هدایت نمی‌شوند."],[258,"مکر او سرزیر و او سرزیر شد","روزگارک برد و روزش دیر شد","مکر او (حیله‌های او) در کمین است و او (این شخص) به دام آن می‌افتد، زمان او به سرانجام نمی‌رسد و زندگی‌اش به تأخیر می‌افتد."],[258,"فکرگاهش کند شد عقلش خرف","عمر شد چیزی ندارد چون الف","فکر او خراب و بی‌فایده شده، عقلش ناتوان و کم‌حوصله است و در عمرش هیچ چیز مفیدی ندارد، مانند الف که ابتدایی‌ترین حرف است."],[258,"آنچ می‌گوید درین اندیشه‌ام","آن هم از دستان آن نفسست هم","آنچه من در این اندیشه می‌گویم، همگی از نیرنگ‌های نفس پست من ناشی می‌شود."],[258,"وآنچ می‌گوید غفورست و رحیم","نیست آن جز حیله نفس لئیم","غفور و رحیم بودن خداوند چیزی جز فریب نفس پست انسان نیست."],[258,"ای ز غم مرده که دست از نان تهیست","چون غفورست و رحیم این ترس چیست","ای کسی که به خاطر غم و غصه، از زندگی و غذا بی‌نصیب شده‌ای، اگر خدا بخشنده و رحیم است، چرا از این ترس داری؟"],[259,"گفت پیری مر طبیبی را که من","در زحیرم از دماغ خویشتن","پیرمرد به طبیب گفت که من به خاطر پیر شدن، از دردهایی که در سر دارم رنج می‌برم."],[259,"گفت از پیریست آن ضعف دماغ","گفت بر چشمم ز ظلمت هست داغ","پیرمرد گفت که این ضعف و بی‌حالی من به خاطر پیری است و به خاطر تاریکی و ضعف بینایی‌ام، بر چشمانم داغی احساس می‌کنم."],[259,"گفت از پیریست ای شیخ قدیم","گفت پشتم درد می‌آید عظیم","پیرمرد به پزشک می‌گوید که درد شدیدی در کمرش حس می‌کند و معتقد است این درد ناشی از پیری است. او خطاب به پزشک، او را به عنوان یک شیخ قدیم خطاب کرده و نظرش را درباره رنجش بیان می‌کند."],[259,"گفت از پیریست ای شیخ نزار","گفت هر چه می‌خورم نبود گوار","پیرمرد که شکایت می‌کند، به شیخ می‌گوید که درد و رنج‌هایش به خاطر پیری است و اضافه می‌کند که هرچه می‌خورد، برایش خوشایند و مناسب نیست."],[259,"گفت ضعف معده هم از پیریست","گفت وقت دم مرا دمگیریست","پیرمرد گفت: ضعف معده‌ام هم به خاطر پیری است و اکنون در زمان بروز مشکل، نفس کشیدن برایم دشوار است."],[259,"گفت آری انقطاع دم بود","چون رسد پیری دو صد علت شود","پیرمرد گفت: بله، قطع نفس و دم به خاطر پیری است، زیرا که وقتی انسان به پیری می‌رسد، مشکلات و بیماری‌ها به‌طور فراوانی رخ می‌دهد."],[259,"گفت ای احمق برین بر دوختی","از طبیبی تو همین آموختی","طبیب به آن پیرمرد می‌گوید: ای احمق، تو خود را به این رنج و ناراحتی دچار کرده‌ای، چرا که از متخصص پزشکی فقط همین را یاد گرفته‌ای؟"],[259,"ای مدمغ عقلت این دانش نداد","که خدا هر رنج را درمان نهاد","ای احمق، عقل و دانش تو این آگاهی را به تو نداد که خداوند برای هر دردی درمانی قرار داده است."],[259,"تو خر احمق ز اندک‌مایگی","بر زمین ماندی ز کوته‌پایگی","تو مانند الاغ احمق هستی که به خاطر کمی عقل و بی‌فکری، بر روی زمین مانده‌ای و از کم بودن قد خود، قادر به پیشرفت نیستی."],[259,"پس طبیبش گفت ای عمر تو شصت","این غضب وین خشم هم از پیریست","طبیب به پیرمرد گفت: ای عمر تو شصت سال است و این خشم و غضب ناشی از پیری است."],[259,"چون همه اوصاف و اجزا شد نحیف","خویشتن‌داری و صبرت شد ضعیف","زمانی که همه ویژگی‌ها و اجزای وجودش نحیف شد، دیگر توانایی تحمل و صبر او ضعیف شده است."],[259,"بر نتابد دو سخن زو هی کند","تاب یک جرعه ندارد قی کند","پیرمرد نمی‌تواند دو سخن را تحمل کند و از آن به شدت خشمگین می‌شود، او حتی شمارا نمی‌تواند یک جرعه آب بنوشد، بنابراین دچار وحشت و تنگی نفس می‌شود."],[259,"جز مگر پیری که از حقست مست","در درون او حیات طیبه‌ست","تنها کسی که از حق بهره‌مند است، پیرمردی است که درونش زندگی پاک و شریف وجود دارد."],[259,"از برون پیرست و در باطن صبی","خود چه چیزست آن ولی و آن نبی","ظاهر آن شخص پیر است، اما در باطن او مانند یک کودک است. چه چیزی در او وجود دارد که او را شایسته مقام ولی (ولایت) و نبی (پیامبری) می‌سازد؟"],[259,"گر نه پیدااند پیش نیک و بد","چیست با ایشان خسان را این حسد","اگر نیک و بد را در وجود آنها نمی‌بینند و از آن آگاه نیستند، پس چه دلیلی دارد که به پست‌ترها حسادت ببرند؟"],[259,"ور نمی‌دانندشان علم الیقین","چیست این بغض و حیل‌سازی و کین","اگر آنها ندانند علم یقین چیست، این کینه و دامی که می‌چینند و توطئه‌ها، بی‌دلیل است."],[259,"ور بدانندی جزای رستخیز","چون زنندی خویش بر شمشیر تیز","اگر کسی بداند که جزای رستخیز (سزای قیامت) چیست، مانند این است که خود را بر شمشیر تیز می‌زند."],[259,"بر تو می‌خندد مبین او را چنان","صد قیامت در درونستش نهان","بر تو می‌خندد؛ اما آنچه در وجود او پنهان است، به اندازۀ صد قیامت عذاب و درد دارد."],[259,"دوزخ و جنت همه اجزای اوست","هرچه اندیشی تو او بالای اوست","دوزخ و بهشت همه در وجود انسان نهفته است، و هر چیزی که تو در اندیشه‌ات می‌پروری، او (خدا) فراتر از آن است."],[259,"هرچه اندیشی پذیرای فناست","آنک در اندیشه ناید آن خداست","تمام چیزهایی که در فکر تو می‌گذرد و به آن‌ها می‌اندیشی، به زودی نابود خواهند شد، اما آنچه که در اندیشه‌ات نمی‌گنجد و از تصور تو فراتر است، همان خداوند است که جاودانه و ابدی است."],[259,"بر در این خانه گستاخی ز چیست","گر همی‌دانند کاندر خانه کیست","در این بیت، شاعر از افرادی سخن می‌گوید که در برابر خانه اهل دل (شخصی عارف یا خداشناس) بی‌ادبی می‌کنند و می‌پرسد دلیل این بی‌احترامی چیست، در حالی که آن‌ها می‌دانند در این خانه کیست و مقام صاحب خانه را می‌شناسند."],[259,"ابلهان تعظیم مسجد می‌کنند","در جفای اهل دل جد می‌کنند","احمق‌ها فقط به خاطر ظواهر، به مسجد احترام می‌گذارند، در حالی که به اهل دل (عارفان و روحانیون) بی‌احترامی می‌کنند و از آن‌ها دوری می‌جویند."],[259,"آن مجازست این حقیقت ای خران","نیست مسجد جز درون سروران","مسجد به خودی خود تنها یک مکان است و ارزش واقعی آن در وجود اهل دل و سروران (شخصیت‌های برجسته) است. در واقع، تنها کسانی که دارای درک صحیح هستند، می‌دانند که مسجد واقعی تنها در قلب و وجود این افراد است."],[259,"مسجدی کان اندرون اولیاست","سجده‌گاه جمله است آنجا خداست","مسجدی که درون آن اولیا (ولی‌ها) هستند، محل سجده و عبادت همه است و در آنجا خدا حضور دارد."],[259,"تا دل مرد خدا نآمد به درد","هیچ قرنی را خدا رسوا نکرد","وقتی دل مرد خدا در رنج و درد نباشد، خداوند هیچ قومی را رسوا نمی‌کند."],[259,"قصد جنگ انبیا می‌داشتند","جسم دیدند آدمی پنداشتند","انبیا (پیامبران) قصد دشمنی و جنگ نداشتند، اما مردم فقط صورت و جسم آن‌ها را می‌دیدند و به اشتباه فکر می‌کردند که انسان هستند."],[259,"در تو هست اخلاق آن پیشینیان","چون نمی‌ترسی که تو باشی همان","در وجود تو، اخلاق و ویژگی‌های نیک پیشینیان نهفته است، اما از آنجا که از شباهت به آن‌ها می‌ترسی، خود را همانند آن‌ها نمی‌دانی."],[259,"آن نشانیها همه چون در تو هست","چون تو زیشانی کجا خواهی برست","چون صفات و ویژگی‌های خوب و ارزشمند در تو وجود دارد، چگونه می‌خواهی به مقام والایی برسی در حالی که خود این نشانه‌ها را نداری؟"],[260,"کودکی در پیش تابوت پدر","زار می‌نالید و بر می‌کوفت سر","کودکی در مقابل تابوت پدرش با ناامیدی و غم فراوان گریه می‌کرد و بر سر خود می‌کوبید."],[260,"کای پدر آخر کجاات می‌برند","تا تو را در زیر خاکی آورند","کودک از پدرش می‌پرسد که اکنون او را به کجا می‌برند تا در زیر خاک دفن شود."],[260,"می‌برندت خانه‌ای تنگ و زحیر","نی درو قالی و نه در وی حصیر","تو را به خانه‌ای باریک و تنگ می‌برند که نه فرشی در آن است و نه حصیری (پوشش) برای نشستن."],[260,"نی چراغی در شب و نه روز نان","نه درو بوی طعام و نه نشان","در این خانه تنگ و بی‌نظام، نه شب روشنایی دارد و نه روز نانی وجود دارد. همچنین، در این مکان هیچ عطری از خوراک به مشام نمی‌رسد و نشانه‌ای از زندگی و شادابی دیده نمی‌شود."],[260,"نی درش معمور نی بر بام راه","نی یکی همسایه کو باشد پناه","در این بیت، شاعر به وضعیت دشوار و ناامیدکننده‌ای اشاره می‌کند که هیچ چیز خوبی در آن وجود ندارد؛ نه در خانه‌ای به زندگی و سرزندگی می‌رسد و نه بر بام آن راهی به سوی امید دارد. همچنین، هیچ همسایه‌ای نیست که به عنوان پناهگاهی برای کمک در این شرایط حاضر باشد."],[260,"چشم تو که بوسه‌گاه خلق بود","چون شود در خانه کور و کبود","چشمان تو که باید محفل و جایگاه زیبایی‌ها و محبت‌ها باشد، چگونه می‌تواند در خانه‌ای تاریک و بی‌نور و بی‌زندگی قرار بگیرد؟"],[260,"خانه بی‌زینهار و جای تنگ","که درو نه روی می‌ماند نه رنگ","خانه‌ای که نه محافظی دارد و نه جایی برای آرامش، به قدری تنگ و بی‌روح است که در آن نه جایی برای تنفس و نه زیبایی وجود دارد."],[260,"زین نسق اوصاف خانه می‌شمرد","وز دو دیده اشک خونین می‌فشرد","جوحی به توصیف اوصاف خانه می‌پرداخت و از چشمانش اشک‌های خونینی می‌ریخت."],[260,"گفت جوحی با پدر ای ارجمند","والله این را خانه ما می‌برند","جوحی به پدرش می‌گوید: ای عزیز، به خدا قسم، این چیزی که در دست دارند متعلق به خانه ماست."],[260,"گفت جوحی را پدر ابله مشو","گفت ای بابا نشانیها شنو","پدر جوحی به او می‌گوید که احمق نباش و به نشانه‌هایی که او بیان می‌کند گوش بده."],[260,"این نشانیها که گفت او یک بیک","خانه ما راست بی تردید و شک","او به نشانی‌هایی که گفته است، اعتقاد دارد و مطمئن است که این نشانی‌ها متعلق به خانه آنهاست و هیچ تردید یا شکی در این مورد ندارد."],[260,"نه حصیر و نه چراغ و نه طعام","نه درش معمور و نه صحن و نه بام","در اینجا اشاره می‌شود که در خانه‌ای که توصیف می‌شود، هیچ چیز معمولی و شناخته‌شده‌ای وجود ندارد؛ نه فرش و نه چراغ و نه غذا، و حتی در و حیاط و پشت‌بام نیز در حالتی خوب و مرتب نیستند. این به نوعی نشان‌دهنده خالی بودن و عدم زندگی در آن مکان است."],[260,"زین نمط دارند بر خود صد نشان","لیک کی بینند آن را طاغیان","این نوع خانه‌ها نشانه‌های بسیاری دارند، اما طاغیان (ظالم‌ها) نمی‌توانند این نشانه‌ها را ببینند."],[260,"خانه آن دل که ماند بی ضیا","از شعاع آفتاب کبریا","دل کسی که از نور خداوندی و حقیقت دور مانده، مانند خانه‌ای بی‌نور و تاریک است. این دل در حقیقت خالی از روشنی و زندگی است."],[260,"تنگ و تاریکست چون جان جهود","بی نوا از ذوق سلطان ودود","دل آن شخص به اندازه جان یهودی ضعیف و بی‌چاره، تنگ و تاریک است و از محبت و رحمت پروردگار به دور مانده است."],[260,"نه در آن دل تافت نور آفتاب","نه گشاد عرصه و نه فتح باب","دل او نه آنقدر روشن است که نور آفتاب در آن بتابد و نه آنقدر وسعت دارد که در آن درهای جدید باز شود."],[260,"گور خوشتر از چنین دل مر تو را","آخر از گور دل خود برتر آ","دل تو از گور هم تنگ‌تر و پر از درد است، پس هیچکدام از این دو را بر دیگری ترجیح مده، زیرا دل تو باید از گور نیز آزادتر و خوش‌تر باشد."],[260,"زنده‌ای و زنده‌زاد ای شوخ و شنگ","دم نمی‌گیرد تو را زین گور تنگ","ای کسی که زنده‌ای و زندگی را به خوبی درک می‌کنی، در حال شاد و خوش هستی، چرا در این گور تنگ غمگینی و دم از آن نمی‌زنی؟"],[260,"یوسف وقتی و خورشید سما","زین چه و زندان بر آ و رو نما","یوسف، زمانی خورشید آسمان بود، حالا به چه دلیل در زندان است؟ چرا بر او نمایان نمی‌شود؟"],[260,"یونست در بطن ماهی پخته شد","مخلصش را نیست از تسبیح بد","یونست (این جا، اشاره به یونس پیامبر دارد) در شکم ماهی پخته شد، اما برای نجات او در آن شرایط، تسبیح و ستایشش از خداوند کافی نبود."],[260,"گر نبودی او مسبح بطن نون","حبس و زندانش بدی تا یبعثون","اگر آن فرد (مسبح) در شکم ماهی نبود، وضعیت او در زندان و بندگی بد می‌شد تا روز قیامت (یعنی در آخرت)."],[260,"او بتسبیح از تن ماهی بجست","چیست تسبیح آیت روز الست","خداوند در روز الست، زمانی که همه موجودات را خلق کرد، به آنها آگاهی و فهم داد. در اینجا اشاره به تسبیح یا ستایش خداوند است که از وجود ماهی برمی‌خیزد، یعنی خلقت و هستی موجودات نشانه‌ای از آفرینش و آگاهی Divine است."],[260,"گر فراموشت شد آن تسبیح جان","بشنو این تسبیحهای ماهیان","اگر آن تسبیح (ذکر پروردگار) را فراموش کردی، به این ذکرهای ماهیان گوش کن که از عمق دریا می‌آید."],[260,"هر که دید الله را اللهیست","هر که دید آن بحر را آن ماهیست","هر که خدا را ببیند، او خود به خداوندی رسیده است و هر که آن دریا (بحر) را مشاهده کند، به ماهی بودن (وجودی در این دریا) پی می‌برد."],[260,"این جهان دریاست و تن ماهی و روح","یونس محجوب از نور صبوح","این جهان مانند دریاست و بدن انسان مثل ماهی است، در حالی که روح یونس (پیامبر) از نور صبحانی (نور الهی) پنهان و محجوب است."],[260,"گر مسبح باشد از ماهی رهید","ورنه در وی هضم گشت و ناپدید","اگر ماهی از دریا بیرون بیاید، در حقیقت از زندگی نجات یافته است؛ وگرنه در دریا فرومی‌رود و ناپدید می‌شود."],[260,"ماهیان جان درین دریا پرند","تو نمی‌بینی که کوری ای نژند","ماهیان با جان در این دریا در حال پرواز هستند، اما تو به دلیل ناآگاهی خود نمی‌بینی و مانند فردی کور به نظر می‌رسی."],[260,"بر تو خود را می‌زنند آن ماهیان","چشم بگشا تا ببینیشان عیان","ماهیانی که در این دریا زندگی می‌کنند، به تو نزدیک می‌شوند و خود را به تو نشان می‌دهند، اما تو توانایی دیدن آن‌ها را نداری. چشم‌های تو را باز کن تا این ماهی‌ها را به وضوح ببینی."],[260,"ماهیان را گر نمی‌بینی پدید","گوش تو تسبیحشان آخر شنید","اگر ماهیان را با چشمانت نمی‌بینی، گوش تو می‌تواند صدای تسبیح (ستایش و ذکر) آن‌ها را بشنود."],[260,"صبر کردن جان تسبیحات تست","صبر کن کانست تسبیح درست","صبر کردن، جان تسبیحات و ذکرهای تو است. صبر کن، زیرا که صبر، تسبیح واقعی و حقیقی تو به حساب می‌آید."],[260,"هیچ تسبیحی ندارد آن درج","صبر کن الصبر مفتاح الفرج","هیچ تسبیحی (عبادت و ذکر) نیست که از صبر بالاتر باشد، صبر کن که صبر دروازه‌ای به سوی رهایی و گشایش است."],[260,"صبر چون پول صراط آن سو بهشت","هست با هر خوب یک لالای زشت","صبر مثل پولی است که برای عبور از پل صراط نیاز است و آن‌سوی این پل بهشت قرار دارد. پس با هر شخص نیکوکاری، یک شخص بد و زشت هم وجود دارد."],[260,"تا ز لالا می‌گریزی وصل نیست","زانک لالا را ز شاهد فصل نیست","اگر از نوحه و ناله خودداری نکنی و به آرامش و صبر نرسی، به وصال نمی‌رسی؛ زیرا نوحه (لالا) حاکی از جدایی و ضیق خاطر است و در ارتباط با معشوق تغییری ایجاد نمی‌کند."],[260,"تو چه دانی ذوق صبر ای شیشه‌دل","خاصه صبر از بهر آن نقش چگل","تو چه می‌دانی لذت صبر را ای دل بی‌صبر، به‌خصوص صبر برای آن نقش زیبای چگل (صورت زیبای معشوق)."],[260,"مرد را ذوق از غزا و کر و فر","مر مخنث را بود ذوق از ذکر","مردان به خاطر جستجوی افتخار در جنگ و شجاعت لذت می‌برند، اما شخص نامتعادل (مخنث) تنها به یادآوری و ذکر امور مذهبی و معنوی علاقه‌مند است."],[260,"جز ذکر نه دین او و ذکر او","سوی اسفل برد او را فکر او","جز یاد خدا و ذکر او، هیچ چیز دیگری در دین او نیست و افکار او را به سمت دنیا و پایین‌تری‌ها می‌کشاند."],[260,"گر برآید تا فلک از وی مترس","کو به عشق سفل آموزید درس","اگر از او (جوحی) صدایی به‌گوش برسد و به او (فرماندار) بیاموزد که از عشق او نترسد، چرا که به عشق او از بلندی (عروج) بهره‌مند خواهد شد."],[260,"او به سوی سفل می‌راند فرس","گرچه سوی علو جنباند جرس","او (سفل، یعنی انسان‌های پست و حقیر) را به سوی پایین می‌راند، اما هرچند به سمت علو (درجه‌های بالا و عالی) هزار زنگ (جرس) به حرکت درمی‌آید."],[260,"از علمهای گدایان ترس چیست","کان علمها لقمه نان را رهیست","از دانش و علم گدایان نترس، زیرا این دانش‌ها تنها وسیله‌ای برای کسب نان و معیشت است."],[261,"کنگ زفتی کودکی را یافت فرد","زرد شد کودک ز بیم قصد مرد","مردی قوی‌جثه‌ای به کودکی برخورد کرد و کودک از ترس، رنگش زرد شد."],[261,"گفت ایمن باش ای زیبای من","که تو خواهی بود بر بالای من","گفت به کودک که نترس و مطمئن باش، ای عزیز من، زیرا تو به زودی بر بالای من خواهی بود و در امنیت خواهی بود."],[261,"من اگر هولم مخنث دان مرا","همچو اشتر بر نشین می‌ران مرا","اگر من ترسناک به نظر می‌رسم، مرا به عنوان فردی ضعیف (مخنث) بشناس و نه به عنوان کسی که می‌تواند تو را بترساند؛ همچنین مانند شتری بر دوش خود سوار می‌کنم و به‌جا می‌زنم."],[261,"صورت مردان و معنی این چنین","از برون آدم درون دیو لعین","ظاهر مردان و مفهوم آن، همچون ظاهر انسان‌ها، در واقع درونشان دیوی زشت و ناپسند نهفته است."],[261,"آن دهل را مانی ای زفت چو عاد","که برو آن شاخ را می‌کوفت باد","این بیت به این معناست که ای کودک، بخاطر بزرگ و ترسناک بودن ظاهری این شخص (که به او «زفت» یعنی بزرگ و تنومند گفته می‌شود) نترس، زیرا او دارای قدرتی مانند باد است که درختان را غلاف می‌کند و به سختی می‌تواند آسیب برساند."],[261,"روبهی اشکار خود را باد داد","بهر طبلی همچو خیک پر ز باد","باد به وضوح به پهنای خویش را به نمایش گذاشت و در برابر طبل بزرگی که مانند خیکی پر از باد بود، خود را نمایان ساخت."],[261,"چون ندید اندر دهل او فربهی","گفت خوکی به ازین خیک تهی","کودک به دلیل نداشتن تجربه، متوجه نمی‌شود که صدای دهل از چه چیزی ناشی می‌شود و ناخودآگاه از آن می‌ترسد. او تصور می‌کند که صدای دهل به خاطر وجود یک موجود بزرگ و فربه است، در حالی که در واقع این صدا ناشی از خالی بودن خیک است که به صدا درآمده و چیزی در آن نیست."],[261,"روبهان ترسند ز آواز دهل","عاقلش چندان زند که لا تقل","روبه‌ها (بخشی از قوچ‌ها) از صدای دهل می‌ترسند و عاقل (انسان) آنقدر به آن‌ها می‌زند که نگو و نپرس."],[262,"یک سواری با سلاح و بس مهیب","می‌شد اندر بیشه بر اسپی نجیب","یک سوار با زره و سلاح مرگبار به آرامی در جنگل بر اسب نجیب و باوقار خود حرکت می‌کرد."],[262,"تیراندازی بحکم او را بدید","پس ز خوف او کمان را در کشید","تیرانداز با فرمان او را دید و از ترس او، کمان خود را کشید و آماده شلیک شد."],[262,"تا زند تیری سوارش بانگ زد","من ضعیفم گرچه زفتستم جسد","سوار تیری به سمت او پرتاب کرد و فریاد زد که من ضعیف هستم، هرچند که در ظاهر به نظر می‌رسد قوی و نیرومند باشم."],[262,"هان و هان منگر تو در زفتی من","که کمم در وقت جنگ از پیرزن","به من نگو که من قوی‌هستم؛ زیرا من در زمان جنگ حتی از یک پیرزن هم ضعیف‌تر هستم."],[262,"گفت رو که نیک گفتی ورنه نیش","بر تو می‌انداختم از ترس خویش","گفت آن شخص که اگر انتقاد نمی‌کردی و خوب نمی‌گفتی، از روی ترس خودم به تو حمله می‌کردم و آسیبی به تو می‌رساندم."],[262,"بس کسان را کآلت پیگار کشت","بی رجولیت چنان تیغی به مشت","بسیاری از کسان را که آلت پیگار (سلاح) به قتل رساند، بدون مردانگی و شجاعت، مانند تیغی در مشت (در دست) او می‌کشد."],[262,"گر بپوشی تو سلاح رستمان","رفت جانت چون نباشی مرد آن","اگر تو سلاح رستمی را بپوشی و به جنگ بروی، جانت از بین می‌رود، چون مردانگی و شجاعت نداری."],[262,"جان سپر کن تیغ بگذار ای پسر","هر که بی سر بود ازین شه برد سر","اگر جانت را برای محافظت از خود به خطر بیندازی و شمشیر را بر زمین بگذاری، بدان که کسی که بی‌سر باشد، از این شاه به پیروزی نخواهد رسید."],[262,"آن سلاحت حیله و مکر توست","هم ز تو زایید و هم جان تو خست","سلاح تو حقه و نیرنگ توست که خودت آن را به وجود آورده‌ای و این امر باعث خستگی و آسیب جان تو شده است."],[262,"چون نکردی هیچ سودی زین حیل","ترک حیلت کن که پیش آید دول","اگر از این حقه‌ها و نیرنگ‌ها هیچ سودی ندیدی، بهتر است که از این روش‌های فریبنده دست بکشی، چرا که در آینده موفقیت و نعمت به سراغت خواهد آمد."],[262,"چون یکی لحظه نخوردی بر ز فن","ترک فن گو می‌طلب رب المنن","اگر در یک لحظه از هنر و مهارت خود استفاده نکردی، دیگر به آن هنر وابسته نباش و از خدایی که نعمت‌ها را عطا کرده، طلب یاری کن."],[262,"چون مبارک نیست بر تو این علوم","خویشتن گولی کن و بگذر ز شوم","اگر این دانش‌ها برای تو خوشایند نیست، آن را کنار بگذار و از بدی‌ها بگذر."],[262,"چون ملایک گو که لا علم لنا","یا الهی غیر ما علمتنا","ملائکه (فرشتگان) می‌گویند: «ای پروردگار ما! ما هیچ علمی نداریم، جز آنچه که به ما آموخته‌ای."],[263,"یک عرابی بار کرده اشتری","دو جوال زفت از دانه پری","یک عرب، دو کیسه بزرگ پر از دانه را بر روی شتر بار کرده است."],[263,"او نشسته بر سر هر دو جوال","یک حدیث‌انداز کرد او را سؤال","Ãshoory:او بروی هر دو لنگه بار نشسته بود که یک شخص سخنور و دانا از او پرسش کرد"],[263,"از وطن پرسید و آوردش بگفت","واندر آن پرسش بسی درها بسفت","سؤال کرد از او در مورد وطن و او در پاسخ، اشاره کرد که در این پرسش، درهای زیادی به روی او گشوده شده است."],[263,"بعد از آن گفتش که این هر دو جوال","چیست آکنده بگو مصدوق حال","اعرابی از فیلسوف می‌پرسد که این دو جوال چه چیزهایی در خود دارند و می‌خواهد از او بگوید که هر یک چه حالتی دارد."],[263,"گفت اندر یک جوالم گندمست","در دگر ریگی نه قوت مردمست","گفت در یکی از جوال‌های من گندم وجود دارد و در دیگری شن است که برای معیشت مردم مناسب نیست."],[263,"گفت تو چون بار کردی این رمال","گفت تا تنها نماند آن جوال","او به رمال (شخصی که در اینجا به افکار و دعاهای خرافی می‌پردازد) می‌گوید که چرا وقتی بار گندم را (به معنای فکر یا علم) بر دوش داری، آن را خالی نگذاشتی تا به تنهایی نیفتی و معطل نشوی."],[263,"گفت نیم گندم آن تنگ را","در دگر ریز از پی فرهنگ را","او گفت نیمی از گندم را در کیسه دیگر بریز تا در پی داشته‌های دیگر، فرهنگ یا علم بیشتر کسب کند."],[263,"تا سبک گردد جوال و هم شتر","گفت شاباش ای حکیم اهل و حر","برای اینکه جوال سبک شود و شتر راحت‌تر حرکت کند، گفت: «احسنت، ای حکیم اهل و حر (آزاد)!» و به او تبریک گفت."],[263,"این چنین فکر دقیق و رای خوب","تو چنین عریان پیاده در لغوب","تفکرات عمیق و ایده‌های خوبی که تو داری، به‌گونه‌ای نمایان و بدون پوشش مانند کسی است که در میان بیابان با پای پیاده و در سختی به‌دنبال چیزی می‌گردد."],[263,"رحمش آمد بر حکیم و عزم کرد","کش بر اشتر بر نشاند نیک‌مرد","حکیم بر اثر دلسوزی به حال اعرابی رحم آورد و تصمیم گرفت او را سوار بر شتر کند و به سفر همراهی کند."],[263,"باز گفتش ای حکیم خوش‌سخن","شمه‌ای از حال خود هم شرح کن","اعرابی به حکیم می‌گوید: ای حکیم خوش‌زبان، کمی درباره زندگی و تجربه‌هایت برای من توضیح بده."],[263,"این چنین عقل و کفایت که توراست","تو وزیری یا شهی بر گوی راست","تو که این‌قدر در عقل و دانش برجسته‌ای، آیا تو وزیر یا پادشاه نیستی که چنین حقایق را به‌راحتی بیان می‌کنی؟"],[263,"گفت این هر دو نیم از عامه‌ام","بنگر اندر حال و اندر جامه‌ام","او گفت که من نه از عامه مردم (دسته معمولی) هستم و نه به ظاهر و لباسشان توجه کن، بلکه به باطن و حال من نگاه کن."],[263,"گفت اشتر چند داری چند گاو","گفت نه این و نه آن ما را مکاو","اعرابی به فیلسوف می‌گوید که از او می‌پرسد که چند شتر و چند گاو دارد، اما او در جواب می‌گوید نه شتر دارد و نه گاو، بلکه ما برای زندگی‌ام مکان و جا نداریم."],[263,"گفت رختت چیست باری در دکان","گفت ما را کو دکان و کو مکان","اعرابی به فیلسوف می‌گوید: تو از من می‌پرسی که بارم چیست، اما ما که هیچ مکان و دکانی نداریم که باری داشته باشیم."],[263,"گفت پس از نقد پرسم نقد چند","که توی تنهارو و محبوب‌پند","گفت وقتی به سراغ تو می‌آیم که از طرف تو چه مقدار ثروت و دارایی دریافت می‌کنم، چون تو تنها و محبوب می‌نمایی."],[263,"کیمیای مس عالم با تو است","عقل و دانش را گهر توبرتو است","عقل و دانش به مانند گنجی ارزشمند در وجود تو است و تو خود، همچون ماده‌ای گران‌بها، در عالم هستی هستی."],[263,"گفت والله نیست یا وجه العرب","در همه ملکم وجوه قوت شب","او با قسمی محکم اعلام می‌کند که در تمام سرزمین‌های عربی و غیر عربی، هیچ نشانه‌ای از قدرت و قوت شب وجود ندارد."],[263,"پا برهنه تن برهنه می‌دوم","هر که نانی می‌دهد آنجا روم","من بدون هیچ دارایی و زینت به دنبال روزی هستم و هر کس که به من نان و خوراکی بدهد، در آنجا خواهم رفت."],[263,"مر مرا زین حکمت و فضل و هنر","نیست حاصل جز خیال و درد سر","من از این علم و فضیلت و هنر چیزی جز خیالات و زحمت نصیبم نشده است."],[263,"پس عرب گفتش که رو دور از برم","تا نبارد شومی تو بر سرم","اعرابی به آن فیلسوف می‌گوید که از نزد من دور شو تا بدی‌ها و شومی‌ات به من آسیب نرساند."],[263,"دور بر آن حکمت شومت ز من","نطق تو شومست بر اهل زمن","عرب می‌گوید که دور شدن او از حکمت تو به این معناست که سخنان تو برای اهل زمانه‌ات به مانند شومی است."],[263,"یا تو آن سو رو من این سو می‌دوم","ور تو را ره پیش من وا پس روم","اگر تو به سمت آنجا بروی، من به این سمت می‌دوم؛ و اگر راه تو به جلو باشد، من به عقب برمی‌گردم."],[263,"یک جوالم گندم و دیگر ز ریگ","به بود زین حیله‌های مرده‌ریگ","اگر یک کیسه گندم داشته باشم و دیگری پر از ریگ، داشتن گندم بهتر است تا این حیله‌ها و فریب‌هایی که بی‌فایده و بی‌ارزش هستند."],[263,"احمقی‌ام بس مبارک احمقیست","که دلم با برگ و جانم متقیست","من احمق هستم، اما با این حال خوشبخت‌ترین احمق هستم، زیرا قلب من همچون برگ پاک و جانم در تقوا و پاکی است."],[263,"گر تو خواهی کت شقاوت کم شود","جهد کن تا از تو حکمت کم شود","اگر می‌خواهی سختی و شقاوت تو کاهش یابد، تلاش کن تا حکمت و دانش تو کمتر شود."],[263,"حکمتی کز طبع زاید وز خیال","حکمتی بی فیض نور ذوالجلال","حکمتی -که تو داری- که از میل و فکر و‌ خیال خودت سرچشمه میگیرد."],[263,"حکمت دنیا فزاید ظن و شک","حکمت دینی پرد فوق فلک","حکمت‌های دنیوی باعث افزایش ظن و شک می‌شود، در حالی که حکمت‌های دینی از نظر مرتبت و ارزش، بسیار بالاتر از آسمان‌ها هستند."],[263,"زوبعان زیرک آخر زمان","بر فزوده خویش بر پیشینیان","زوبعان زیرک در آخر زمان، به مهارت‌ها و توانایی‌های خود افزوده‌اند و بر کسانی که پیش از آن‌ها بودند، برتری یافته‌اند."],[263,"حیله‌آموزان جگرها سوخته","فعلها و مکرها آموخته","حیله‌گران و ترفندآموزان دل‌شکسته و داغدارند، زیرا از کارها و حقه‌بازی‌ها بسیاری را آموخته‌اند."],[263,"صبر و ایثار و سخای نفس و جود","باد داده کان بود اکسیر سود","صبر و فداکاری و generosity (سخاوت) و بخشندگی، همانند اکسیر (ماده‌ای که می‌تواند به طلا تبدیل کند) باعث سود و بهره‌مندی می‌شود."],[263,"فکر آن باشد که بگشاید رهی","راه آن باشد که پیش آید شهی","فکر درست باید راهی را باز کند و این راه در حقیقت باید به ظهور یک شاه بزرگ و حقیقی منجر شود."],[263,"شاه آن باشد که از خود شه بود","نه به مخزنها و لشکر شه شود","شاه حقیقی کسی است که خود ماهیت رهبری و سلطنت را داراست، نه اینکه تنها به خاطر ثروت و لشکر به عنوان شاه شناخته شود."],[263,"تا بماند شاهی او سرمدی","همچو عز ملک دین احمدی","مجلس شاهی او، تا ابد ادامه داشته باشد و مانند عزت و کرامت دین محمد (ص) پایدار و همیشگی باشد."],[264,"هم ز ابراهیم ادهم آمدست","کو ز راهی بر لب دریا نشست","ابراهیم ادهم، که از شخصیت‌های معروف صوفی و عارف است، نیز در اینجا به دریا آمده و در کنار آن نشسته است."],[264,"دلق خود می‌دوخت آن سلطان جان","یک امیری آمد آنجا ناگهان","ابراهیم ادهم، که به او لقب «سلطان جان» داده‌اند، در حال دوختن دلق (لباسی که دلقک‌ها می‌پوشیدند) بود که ناگهان امیری به نزد او آمد."],[264,"آن امیر از بندگان شیخ بود","شیخ را بشناخت سجده کرد زود","آن امیر، که یکی از پیروان و بندگان شیخ بود، او را شناخت و به سرعت برای احترام و ارادت، در برابرش سجده کرد."],[264,"خیره شد در شیخ و اندر دلق او","شکل دیگر گشته خلق و خلق او","امیر به شیخ نگاه کرد و در لباس او به شکل و صورتی دیگر دید، به گونه‌ای که احساس کرد مردم و خود شیخ هر دو دچار تغییری شده‌اند."],[264,"کو رها کرد آنچنان ملکی شگرف","بر گزید آن فقر بس باریک‌حرف","او (ابراهیم ادهم) آنچه را از دنیا و مکنت‌های بزرگ داشت، رها کرد و به انتخاب خودش، به فقر و زندگی ساده‌ای روی آورد که به قول او، حتی نیاز به سخن گفتن ندارد و در آن فقر حقیقتی نهفته است."],[264,"ترک کرد او ملک هفت اقلیم را","می‌زند بر دلق سوزن چون گدا","ابراهیم ادهم، برای رسیدن به فقر و رهایی، تمام سلطنت هفت‌گانه را رها کرده و اکنون مثل یک گدا، بر آن دلق (ردای ساده) خود با سوزن، ضربه می‌زند."],[264,"شیخ واقف گشت از اندیشه‌اش","شیخ چون شیرست و دلها بیشه‌اش","شیخ، به دلیل تفکر و اندیشه‌اش، به مقام و درک بالایی رسیده است؛ او مانند شیری قدرتمند است که دل‌های دیگران به مثابه جنگل یا میدان گسترده‌ای برای او هستند."],[264,"چون رجا و خوف در دلها روان","نیست مخفی بر وی اسرار جهان","اگر امید و ترس در دل‌ها وجود نداشته باشد، اسرار جهان بر او پنهان نمی‌ماند."],[264,"دل نگه دارید ای بی حاصلان","در حضور حضرت صاحب‌دلان","ای کسانی که بهره‌ای از دنیا ندارید، دل‌هایتان را در برابر حضرت حق (خدا) حفظ کنید و توجه داشته باشید؛ زیرا او صاحب دل‌هاست و حضورش را درک کنید."],[264,"پیش اهل تن ادب بر ظاهرست","که خدا زیشان نهان را ساترست","در مقابل اهل دنیا و ظاهر، ادب و احترام باید رعایت شود؛ چون خداوند امور نهانی آن‌ها را می‌پوشاند و به دیده نمی‌آورد."],[264,"پیش اهل دل ادب بر باطنست","زانک دلشان بر سرایر فاطنست","در حضور اهل دل، ادب و نزاکت مربوط به باطن است، زیرا دل آن‌ها در درون معرفت و حقیقت استقرار دارد."],[264,"تو بعکسی پیش کوران بهر جاه","با حضور آیی نشینی پایگاه","اگر تو به عده‌ای نابینا برای کسب مقام و جاه روی، در کنار آنها با وقار و متانت نشسته‌ای، نشانه ادب و احترام نیست."],[264,"پیش بینایان کنی ترک ادب","نار شهوت را از آن گشتی حطب","وقتی که در برابر بینایان قرار می‌گیری، باید آداب را ترک کنی و خود را از تمایلات نفسانی دور نگه‌داری، چرا که این کار تو را مثل هیزم آتش می‌سازد."],[264,"چون نداری فطنت و نور هدی","بهر کوران روی را می‌زن جلا","اگر فطرت و روشنی هدایت را نداری، باید روی خود را برای دیگران که نابینا هستند، روشن کنی."],[264,"پیش بینایان حدث در روی مال","ناز می‌کن با چنین گندیده حال","در حضور بینایان و صاحبان بصیرت، به خاطر حالت زشت و ناپسند خود، به دروغ و تظاهر به خوبی رفتار نکن."],[264,"شیخ سوزن زود در دریا فکند","خواست سوزن را به آواز بلند","شیخ (ابراهیم ادهم) سوزنی را به سرعت در دریا انداخت و این کار را با صدای بلندی انجام داد."],[264,"صد هزاران ماهی اللهیی","سوزن زر در لب هر ماهیی","در هر ماهی که وجود دارد، صدها هزار ماهی از نوع خاصی وجود دارند که به خداوند تعلق دارند و مانند سوزن زر در لب این ماهیان هستند."],[264,"سر بر آوردند از دریای حق","که بگیر ای شیخ سوزنهای حق","از دریای حقیقت، دسته‌ای از موجودات (مانند ماهی‌ها) سر برآورده‌اند و به شیخ می‌گویند که کمالات و کرامات حق را به دست آور."],[264,"رو بدو کرد و بگفتش ای امیر","ملک دل به یا چنان ملک حقیر","به او (امیر) نگاه کرد و گفت: ای فرمانروا، دل را به درستی به چیزی واگذار کن که در واقع، حکومت روح است و نه قدرت دنیوی و حقیر."],[264,"این نشان ظاهرست این هیچ نیست","تا بباطن در روی بینی تو بیست","این نشانه‌های ظاهری و ناپایدار هستند و هیچ ارزشی ندارند. تو باید به باطن و عمق معنا نگاه کنی تا حقیقت را دریابی."],[264,"سوی شهر از باغ شاخی آورند","باغ و بستان را کجا آنجا برند","از باغ، شاخه‌ای را به سوی شهر می‌برند، اما نمی‌دانند که باغ و بستان واقعی کجا قرار دارد و به کجا می‌برند."],[264,"خاصه باغی کین فلک یک برگ اوست","بلک آن مغزست و این عالم چو پوست","آن باغی که در اینجا به آن اشاره شده، تنها نمایی از فضای بالا (فلک) است، در حالی که حقیقت اصلی و مغز آن باغ در درون این عالم (جهان مادی) نهفته است، مانند پوست که تنها ظاهر چیزی را می‌پوشاند و مغز به آن معنی و جوهر می‌دهد."],[264,"بر نمی‌داری سوی آن باغ گام","بوی افزون جوی و کن دفع زکام","به سمت آن باغ نرو، چرا که بوی خوشی در آنجا نیست، و سعی کن از زکام و بیماری دوری کنی."],[264,"تا که آن بو جاذب جانت شود","تا که آن بو نور چشمانت شود","تا زمانی که آن عطر و بوی خوش، جان و روح تو را جذب نکند و تا زمانی که آن عطر، روشنی چشمانت نشود، هیچ چیز نمی‌تواند تو را به سمت خود بکشد."],[264,"گفت یوسف ابن یعقوب نبی","بهر بو القوا علی وجه ابی","یوسف، فرزند یعقوب نبی، گفت که برای بو به پدرش روی آورد."],[264,"بهر این بو گفت احمد در عظات","دائما قرة عینی فی الصلوة","به خاطر این بوی خوش، احمد (پیامبر اسلام) در موعظه‌های خود به طور مداوم می‌گوید: «عزت و جلال من در نماز است»."],[264,"پنج حس با همدگر پیوسته‌اند","رسته این هر پنج از اصلی بلند","پنج حس ما به‌طور پیوسته و در کنار یکدیگر درک و ارتباط برقرار می‌کنند، و این پنج حس هر یک منشا و ریشه‌ای عمیق و بلند دارند."],[264,"قوت یک قوت باقی شود","ما بقی را هر یکی ساقی شود","قوت واحدی وجود دارد که باقی می‌ماند و دیگر عناصر هر یک مانند ساقی به ارائه و توزیع آن می‌پردازند."],[264,"دیدن دیده فزاید عشق را","عشق در دیده فزاید صدق را","دیدن، چشم را به عشق بیشتر می‌کند و عشق در وجود انسان و در چشمان او، حقیقت و صدق را افزایش می‌دهد."],[264,"صدق بیداری هر حس می‌شود","حسها را ذوق مونس می‌شود","پی بردن به حقیقت و صداقت باعث بیداری و آگاهی حواس می‌شود و این آگاهی، یک لذت و ذوقی است را به حواس ما هدیه می‌کند که همچون دوستی برای ما می‌ماند."],[265,"چون یکی حس در روش بگشاد بند","ما بقی حسها همه مبدل شوند","وقتی یکی از حواس انسانی در درک و دریافت‌های روشن و عمیق باز شود، باقی حواس نیز دگرگون و تغییر می‌یابند."],[265,"چون یکی حس غیر محسوسات دید","گشت غیبی بر همه حسها پدید","وقتی که یکی از حواس ما به چیزهای نادیدنی (غیرمحسوس) آشنا شود، برای همه حواس دیگر نیز امور غیبی و ماورایی آشکار می‌شود."],[265,"چون ز جو جست از گله یک گوسفند","پس پیاپی جمله زان سو برجهند","وقتی که یک گوسفند از گله دور شود و به دنبال یک چیز برود، باقی گوسفندان نیز به تبعیت از او به سمت آن طرف می‌دوند."],[265,"گوسفندان حواست را بران","در چرا از اخرج المرعی چران","حواس و توجهات خود را از دنیا و مکانی که در آن هستی، جدا کن و به چراگاه معنوی و حقایق بسیار بالاتر برو."],[265,"تا در آنجا سنبل و ریحان چرند","تا به گلزار حقایق ره برند","در آنجا در باغ‌های بهشت، گل‌های خوشبوی سنبل و ریحان می‌رویند و روحانیون و عارفان به سمت حقیقت و معرفت الهی هدایت می‌شوند."],[265,"هر حست پیغامبر حسها شود","تا یکایک سوی آن جنت رود","هر حس از حس‌های دیگر، پیام‌هایی دریافت می‌کند و در نهایت، هر یک از آن‌ها به سوی بهشت و نعمت‌های افلاکی می‌روند."],[265,"حسها با حس تو گویند راز","بی حقیقت بی زبان و بی مجاز","حس‌ها با حس تو به بیان راز و حقیقت می‌پردازند، اما این بیان بی‌پرده و بدون کلام است و به هیچ عنوان نمی‌توان آن را به زبان آورد یا محدود به قواعد و مجازها کرد."],[265,"کین حقیقت قابل تاویلهاست","وین توهم مایه تخییلهاست","این حقیقتی که درباره‌اش صحبت می‌کنیم، قابل تفسیر و تأویل است، در حالی که این خیال و توهم تنها موجب تصورات و تخیل‌های بی‌اساس می‌شود."],[265,"آن حقیقت را که باشد از عیان","هیچ تاویلی نگنجد در میان","آن حقیقتی که کاملا واضح و روشن است، هیچ گونه تفسیر و توجیهی نمی‌تواند آن را در بر بگیرد."],[265,"چونک هر حس بنده حس تو شد","مر فلکها را نباشد از تو بد","وقتی که هر حسی از بندگی تو آزاد شد، دیگر برای آسمان‌ها و عالم بالا، بدی‌ای از تو وجود نخواهد داشت."],[265,"چونک دعویی رود در ملک پوست","مغز آن کی بود قشر آن اوست","وقتی دعوا و اختلافی در سرزمینی به وجود بیاید، آن کسی که در واقعیت و باطن ماجرا قرار دارد، همانند پوست و مغز است که باخت و بافت ظاهری (قشر) را شکل می‌دهند."],[265,"چون تنازع در فتد در تنگ کاه","دانه آن کیست آن را کن نگاه","زمانی که در میدان کشمکش و جدال بیفتی، دانه‌ آن کاه که در تنگی است، چه کسی است؟ آن را با دقت بنگر."],[265,"پس فلک قشرست و نور روح مغز","این پدیدست آن خفی زین رو ملغز","جهان مادی (فلک) مانند قشری است که روح به‌عنوان مغز این ظواهر در آن وجود دارد. از این‌رو، آن حقیقت پنهان (روح) به‌راحتی قابل دستیابی نیست و ما باید در جستجوی آن باشیم."],[265,"جسم ظاهر، روح مخفی آمدست","جسم همچون آستین جان همچو دست","جسم ظاهری مانند آستینی است که روح، مانند دستی درون آن قرار دارد و روح، از جسم پنهان‌تر است."],[265,"باز عقل از روح مخفی‌تر پرد","حس سوی روح زوتر ره برد","عقل از روح، که جنبه‌ای پنهان دارد، به واقع نزدیک‌تر و درک واقعی‌تری از احساسات و حالات روحی انسان ارائه می‌دهد و به این ترتیب، می‌تواند سریع‌تر ما را به سمت روح و حقیقت وجودی‌مان راهنمایی کند."],[265,"جنبشی بینی بدانی زنده است","این ندانی که ز عقل آکنده است","حرکتی که مشاهده می‌کنی، نشانه حیات و زندگانی است، اما نمی‌دانی که این حرکت از عقل و اندیشه ناشی می‌شود."],[265,"تا که جنبشهای موزون سر کند","جنبش مس را به دانش زر کند","تا زمانی که حرکات موزون و منظم به پایان نرسد، تغییر و تحول در مس (فلز ارزان) به چنان دانشی دست نمی‌یابد که به طلا (زر) تبدیل شود."],[265,"زان مناسب آمدن افعال دست","فهم آید مر تو را که عقل هست","این بیت می‌گوید: از آن‌جا که افعال مناسب و هماهنگ هستند، می‌توانی بفهمی که عقل وجود دارد."],[265,"روح وحی از عقل پنهان‌تر بود","زانک او غیبیست او زان سر بود","روح وحی از عقل حتی بیشتر پنهان است، زیرا روح وحی از عالم غیب می‌آید و منبعی فراتر از عقل دارد."],[265,"عقل احمد از کسی پنهان نشد","روح وحیش مدرک هر جان نشد","عقل پیامبر اسلام، احمد (محمد)، از کسی پنهان نبوده است، اما روح وحی او قابل درک برای هر انسانی نیست و نمی‌تواند توسط عقل‌ها فهمیده شود."],[265,"روح وحیی را مناسبهاست نیز","در نیابد عقل کان آمد عزیز","روح وحی فقط برای کسانی مناسب است که به درک آن برسند و عقل نمی‌تواند به تنهایی به آن دست یابد، زیرا این مقام والای روحانی به افراد برجسته اختصاص دارد."],[265,"گه جنون بیند گهی حیران شود","زانک موقوفست تا او آن شود","گاهی انسان حالت جنون پیدا می‌کند و گاهی در حیرت و سردرگمی به سر می‌برد، زیرا این حالات به حالتی وابسته است که او به آن مرتبه از وجود رسیده باشد."],[265,"چون مناسبهای افعال خضر","عقل موسی بود در دیدش کدر","افعال حضرت خضر برای موسی مناسب به نظر نمی‌رسید، زیرا عقل موسی نمی‌توانست دلیل کارهای خضر را درک کند و این موضوع باعث می‌شد که افعال خضر در نظر او مبهم و ناپسند جلوه کند."],[265,"نامناسب می‌نمود افعال او","پیش موسی چون نبودش حال او","افعال خضر (پیامبر الهی) در نظر موسی (پیامبر بنی‌اسرائیل) نامناسب به نظر می‌رسید، زیرا او در آن زمان حال او (خضر) را درک نکرده بود."],[265,"عقل موسی چون شود در غیب بند","عقل موشی خود کیست ای ارجمند","وقتی عقل موسی به عالم غیب می‌رسد، چه به کار می‌آید؟ این در حالی است که عقل موشی (عقل ناقص و سطحی) نمی‌تواند شناخت عمیق‌تری داشته باشد. بنابراین، در اینجا از ارجمندی عقل سخن می‌گوید."],[265,"علم تقلیدی بود بهر فروخت","چون بیابد مشتری خوش بر فروخت","علمی که به تقلید از دیگران به دست آمده، مانند کالایی است که به راحتی فروخته می‌شود؛ و وقتی کسی مشتری باهوش و خوب پیدا کند، آن علم بهتر و سریع‌تر به فروش می‌رسد."],[265,"مشتری علم تحقیقی حقست","دایما بازار او با رونقست","مشتری علم تحقیقی، یعنی کسی که به حقیقت علم پی می‌برد، همیشه در حال خرید و فروش است و بازار او همواره پررونق و پررنگ و شاداب است."],[265,"لب ببسته مست در بیع و شری","مشتری بی حد که الله اشتری","عاشق بی‌خود شده‌است و در دین و شریعت مشغول است، و مشتری (خریدار) بی‌نهایتی وجود دارد که مانند کوه بزرگ، خداوند است."],[265,"درس آدم را فرشته مشتری","محرم درسش نه دیوست و پری","درس آدم را فرشته، یعنی جبرئیل، به عنوان یک مخلوق الهی می‌آموزد و کسی دیگر چون دیو و پری (که نمادهای شر و وسوسه‌اند) در این علم و معرفت محرم نیستند."],[265,"آدم انبئهم باسما درس گو","شرح کن اسرار حق را مو به مو","خداوند به آدم (انسان) علم الاسماء (نام‌ها و معانی) را آموخت و از او خواست که اسرار حقایق را به طور دقیق و کامل بیان کند."],[265,"آنچنان کس را که کوته‌بین بود","در تلون غرق و بی تمکین بود","آن کسی که دیدگاه محدودی دارد، در تغییرات و نوسانات زندگی غرق شده و نتوانسته است خود را درست کنترل کند."],[265,"موش گفتم زانک در خاکست جاش","خاک باشد موش را جای معاش","موش را به خاطر اینکه در خاک زندگی می‌کند، گفتم که جایش باید خاک باشد، زیرا او مخلوقی است که برای زندگی به خاک وابسته‌ است."],[265,"راهها داند ولی در زیر خاک","هر طرف او خاک را کردست چاک","او (نفس یا روح) به تمامی مسیرها و راه‌ها آگاهی دارد، اما در دنیای مادی و زیر خاک، به سبب محدودیت‌ها و بندهایی که دارد، نمی‌تواند این آگاهی را به کار گیرد و در واقع، خود را در این عالم محصور کرده است."],[265,"نفس موشی نیست الا لقمه‌رند","قدر حاجت موش را عقلی دهند","نفس آدمی مانند موش است که فقط به دنبال لقمه‌اش می‌گردد و به اندازه نیازش به او عقل و درک داده‌اند. این بیت به محدودیت‌های نفس و نیازهای آن اشاره دارد."],[265,"زانک بی حاجت خداوند عزیز","می‌نبخشد هیچ کس را هیچ چیز","خداوند عزیز هیچ چیز را به کسی نمی‌دهد مگر اینکه او به چیزی نیاز داشته باشد."],[265,"گر نبودی حاجت عالم زمین","نافریدی هیچ رب العالمین","اگر نیاز به زمین و عالم نداشت، خداوند هیچ‌گاه این دنیا را خلق نمی‌کرد."],[265,"وین زمین مضطرب محتاج کوه","گر نبودی نافریدی پر شکوه","این زمین در حال ناآرامی و آشفتگی است و به کوه‌هایی نیاز دارد تا استحکام و آرامش یابد؛ اگر تو، ای خداوند قدرتمند، این کوه‌های باعظمت را نمی‌آفریدی، زمین به همین حال باقی می‌ماند."],[265,"ور نبودی حاجت افلاک هم","هفت گردون ناوریدی از عدم","اگر نیازی به آسمان‌ها نبود، هر هفت لایه آسمان نیز از عدم و نیستی به وجود نمی‌آمدند."],[265,"آفتاب و ماه و این استارگان","جز به حاجت کی پدید آمد عیان","آفتاب و ماه و ستاره‌ها فقط به خاطر نیاز انسان‌ها و خواسته‌هایشان به‌وجود آمده‌اند و وجودشان برای نشان دادن نیازها و خواسته‌هاست."],[265,"پس کمند هستها حاجت بود","قدر حاجت مرد را آلت دهد","نیاز و حاجت انسانی مانند کمند است که انسان را به هدفش می‌کشاند و به اندازه نیاز مرد، ابزار و وسایل لازم را فراهم می‌کند."],[265,"پس بیفزا حاجت ای محتاج زود","تا بجوشد در کرم دریای جود","ای محتاج، هرچه سریع‌تر حاجت و خواسته‌ات را افزایش بده تا رحمت و بخشش بی‌پایان خداوند مانند دریایی پر از فیض برای تو جاری شود."],[265,"این گدایان بر ره و هر مبتلا","حاجت خود می‌نماید خلق را","این بدبخت‌ها و نیازمندان که در راه‌ها نشسته‌اند، به هر کسی خود را معرفی می‌کنند و خواسته‌هایشان را به مردم نشان می‌دهند."],[265,"کوری و شلی و بیماری و درد","تا ازین حاجت بجنبد رحم مرد","انسان‌های نابینا، ناتوان و بیمار به خاطر نیاز و مشکلاتشان، از دیگران درخواست کمک و رحم را دارند."],[265,"هیچ گوید نان دهید ای مردمان","که مرا مالست و انبارست و خوان","شخصی که این سخن را می‌گوید، از دیگران می‌خواهد که به او نان بدهند و خود را به عنوان فردی با مال و ثروت معرفی می‌کند، همچنین به وجود انبار و سفره‌ای برای پذیرایی اشاره می‌کند."],[265,"چشم ننهادست حق در کورموش","زانک حاجت نیست چشمش بهر نوش","خداوند تلاش نکرده است که چشم بصیرت به کورموش (شاه هخامنشی) بدهد، چون نیازی به دیدن آنچه نوشیدنی هست برای او وجود ندارد. این به نوعی نشان‌دهنده بی‌نیازی حق نسبت به دیدن و شناخت ظاهری است."],[265,"می‌تواند زیست بی چشم و بصر","فارغست از چشم او در خاک تر","کسی می‌تواند بدون چشم و بینایی زندگی کند و از تعلقات دنیوی بی‌نیاز است، زیرا او نگاه خداوندی را ندارد و در خاک جسمانی در قید نیست."],[265,"جز بدزدی او برون ناید ز خاک","تا کند خالق از آن دزدیش پاک","جز این‌که دزدیده شده از او چیزی به‌دست نمی‌آید و تا زمانی که دزدیده‌ها در خاک باقی است، خالق نمی‌تواند آن دزدیده‌ها را از آلودگی پاک کند."],[265,"بعد از آن پر یابد و مرغی شود","چون ملایک جانب گردون رود","پس از آن، انسان روحانی از حالت مادی فراتر می‌رود و مانند فرشتگان به سوی آسمان‌ها می‌پروازد."],[265,"هر زمان در گلشن شکر خدا","او بر آرد همچو بلبل صد نوا","هر زمان در باغ نعمت‌های الهی، او مانند بلبل، نغمه‌ای زیبا و شاداب از خود بلند می‌کند."],[265,"کای رهاننده مرا از وصف زشت","ای کننده دوزخی را تو بهشت","ای خداوندی که مرا از صفات ناپسند نجات می‌دهی، تو کسی هستی که دوزخیان را به بهشت می‌بخشی."],[265,"در یکی پیهی نهی تو روشنی","استخوانی را دهی سمع ای غنی","تو در یک پیه (ریسمان) به روشنایی (نور) دعوت می‌کنی و به کسی که توانگری و ثروت دارد، به او می‌گویی که باید به این نور و روشنایی توجه کند."],[265,"چه تعلق آن معانی را به جسم","چه تعلق فهم اشیا را به اسم","مرتبۀ معانی به جسم ارتباطی ندارد و درک چیزها نیز به نام‌ها وابسته نیست."],[265,"لفظ چون وکرست و معنی طایرست","جسم جوی و روح آب سایرست","لفظ مانند قفس است و معنی همچون پرنده‌ای که در آن قفس محصور شده است. جسم، مانند جوی آب است و روح، به مانند آبی که در آن جاری است."],[265,"او روانست و تو گویی واقفست","او دوانست و تو گویی عاکفست","چشم‌های تو به آنچه که در اطرافت هست خیره شده و گویی می‌دانی، ولی در واقع او (روح) در حال حرکتی است که تو از آن بی‌خبری؛ تو به ظاهر دادی و او در باطن در حال دویدن و گذراندن و حرکت است، اما تو گویی در مکان خود ایستاده‌ای و نمی‌توانی این حرکت را درک کنی."],[265,"گر نبینی سیر آب از چاکها","چیست بر وی نو به نو خاشاکها","اگر نتوانی جریان آب را از چاک‌ها (فرو رفتگی‌ها یا شکاف‌ها) ببینی، پس بر روی آن خاشاک‌ها (چیزی که روی سطح آب می‌ماند) چه نو و تازه است."],[265,"هست خاشاک تو صورتهای فکر","نو بنو در می‌رسد اشکال بکر","خاشاک در اینجا به معنای صورت‌های غیرواقعی و عدم وجود است که ذهن ما تولید می‌کند. فکر نو به معنای دریافت‌های تازه و بکر است که در نتیجه دقت و تأمل به دست می‌آید. پس این بیت می‌گوید که افکار ناهمگون و سطحی (خاشاک) مانع دیدن حقیقت‌ها و درک واقعیات نو (اشکال بکر) می‌شوند."],[265,"روی آب و جوی فکر اندر روش","نیست بی خاشاک محبوب و وحش","فکر انسان مانند آبی روان است که بر روی آن خاشاک و زباله‌های دنیوی وجود ندارد، یعنی در زمانی که محبوب حقیقی و زیبایی الهی واصل می‌شود، دنیا و زوائد آن به کنار رفته و تفکر خالص و روشن موجود می‌شود."],[265,"قشرها بر روی این آب روان","از ثمار باغ غیبی شد دوان","شجره‌ها و میوه‌ها بر روی این آب روان، حاصل و ثمره‌ای از باغی نامرئی و غیبی هستند که دیده نمی‌شود، اما تأثیرش در این دنیا مشهود است."],[265,"قشرها را مغز اندر باغ جو","زانک آب از باغ می‌آید به جو","پوسته‌ها و قشرهای روی این آب زیبای روان، مانند مغز درونی میوه‌ها هستند که از باغ غیبی به وجود آمده‌اند، زیرا این آب از باغی معنوی سرچشمه می‌گیرد."],[265,"گر نبینی رفتن آب حیات","بنگر اندر جوی و این سیر نبات","اگر آب حیات را نمی‌بینی که چگونه جریان دارد، به جوی نگاه کن و سیر گیاهان را مشاهده کن."],[265,"آب چون انبه‌تر آید در گذر","زو کند قشر صور زوتر گذر","وقتی آب بیشتر در حرکت باشد، لایه‌های ظاهری اشیاء سریع‌تر از بین می‌رود."],[265,"چون بغایت تیز شد این جو روان","غم نپاید در ضمیر عارفان","هرگاه این جوی روان که به شدت در حال حرکت است، تند و سریع شود، غم در دل عارفان باقی نمی‌ماند."],[265,"چون بغایت ممتلی بود و شتاب","پس نگنجید اندرو الا که آب","زمانی که این جو بسیار پرآب و متلاطم بود، دیگر جایی برای غم در دل عارفان نماند و فقط آب باقی ماند."],[266,"آن یکی یک شیخ را تهمت نهاد","کو بدست و نیست بر راه رشاد","یک نفر به یک شیخ اتهام زد که او در مسیر درست و راستین قرار ندارد و بد است."],[266,"شارب خمرست و سالوس و خبیث","مر مریدان را کجا باشد مغیث","آن شخص شراب‌نوش و متظاهر و پست‌فطرت است، چگونه ممکن است که مریدان او را یاری کنند یا از او راهنمایی بگیرند؟"],[266,"آن یکی گفتش ادب را هوش دار","خرد نبود این چنین ظن بر کبار","یکی گفت به او که به ادب توجه کن، چرا که خرد، چنین گمانی درباره بزرگmen (کبار) ندارد."],[266,"دور ازو و دور از آن اوصاف او","که ز سیلی تیره گردد صاف او","دور از او و دور از ویژگی‌های او که آن ویژگی‌ها باعث می‌شود کسی که در اصل پاک است، به خاطر تهمت، بدخلق و زشت‌روی به نظر برسد."],[266,"این چنین بهتان منه بر اهل حق","کین خیال تست برگردان ورق","به اهل حق تهمت نزن، زیرا این فقط خیال توست که واقعیت را تغییر می‌دهد."],[266,"این نباشد ور بود ای مرغ خاک","بحر قلزم را ز مرداری چه باک","اگر تو پرنده‌ای از خاک هستی، نباید نگران عمق دریای نیلگون (قلزم) باشی؛ زیرا از مرداری که در آن وجود دارد، چه باکی داری؟ این بیان نشان‌دهنده اهمیت بعد روحانی و صفای باطن است و اشاره به این دارد که شرایط ظاهری نباید ما را به نگرانی بیندازد."],[266,"نیست دون القلتین و حوض خرد","که تواند قطره‌ایش از کار برد","هیچ چیز در سطح پایین و بی‌ارزش نیست و حوض خرد نمی‌تواند حتی یک قطره از آن را نیز جمع‌آوری کند."],[266,"آتش ابراهیم را نبود زیان","هر که نمرودیست گو می‌ترس از آن","آتش سوزان ابراهیم (پیامبر) بر او آسیب نزده است، پس هر کس که مانند نمرود (حاکم ظالم) باشد، باید از چنین تجربه‌ای بترسد."],[266,"نفس نمرودست و عقل و جان خلیل","روح در عینست و نفس اندر دلیل","نفس انسان مانند نمرود است که بازدارنده و مانع پیشرفت است، در حالی که عقل و جان مانند ابراهیم خلیل هستند که روح انسانی را در مسیر هدایت و حق‌جویی قرار می‌دهند. در واقع، نفس به عنوان دلیلی بر انحراف و عقل و جان نشانه‌ای از طریق روشن است."],[266,"این دلیل راه ره‌رو را بود","کو بهر دم در بیابان گم شود","این دلیل، یا نشانه‌ای که مسیر را نشان می‌دهد، برای مسافر (ره‌رو) است و به گونه‌ای است که ممکن است در هر لحظه در بیابان گم شود."],[266,"واصلان را نیست جز چشم و چراغ","از دلیل و راهشان باشد فراغ","واصلان (واقعی رابطه‌داران با خدا) تنها به چشم و چراغ نیاز دارند و نیازی به دلیل و راهنما ندارند؛ زیرا از همه چیز آزادند و به مقصد رسیده‌اند."],[266,"گر دلیلی گفت آن مرد وصال","گفت بهر فهم اصحاب جدال","اگر آن مرد وصال دلیلی بیاورد، به خاطر درک و فهمی که اصحاب دارند، جدال و بحثی در این مورد خواهد بود."],[266,"بهر طفل نو، پدر تی‌تی کند","گرچه عقلش هندسه گیتی کند","پدر برای کودک کوچک خود لالایی می‌خواند، هرچند که خودش به پیچیدگی‌های علم هندسه آشناست."],[266,"کم نگردد فضل استاد از علو","گر الف چیزی ندارد گوید او","فضیلت و دانایی استاد کم نمی‌شود حتی اگر شاگردش هیچ دانشی نداشته باشد و فقط حرفی بزند."],[266,"از پی تعلیم آن بسته‌دهن","از زبان خود برون باید شدن","برای یادگیری علم، آن کسی که زبانش بسته است، باید از زبان خود خارج شود و سخن بگوید."],[266,"در زبان او بباید آمدن","تا بیاموزد ز تو او علم و فن","شیخ (مولانا) می‌گوید باید با زبان او (یعنی فردی که می‌خواهد علم و فن را بیاموزد) ارتباط برقرار کرد تا او از تو (معلم) علم و فن را یاد بگیرد."],[266,"پس همه خلقان چو طفلان ویند","لازمست این پیر را در وقت پند","تمام انسان‌ها مانند کودکان هستند و درک صحیح و آموزه‌های درست را نیاز دارند، بنابراین ضروری است که این پیر (شیخ) در زمان نصیحت و آموزش به آنها توجه کند."],[266,"آن مرید شیخ بد گوینده را","آن به کفر و گمرهی آکنده را","آن مرید شیخ به فرد بدگو که کفر و گمراهی را پر کرده است، پاسخ می‌دهد."],[266,"گفت خود را تو مزن بر تیغ تیز","هین مکن با شاه و با سلطان ستیز","مرید به آن بدگوی شیخ می‌گوید که خودت را در برابر خطرات بزرگ همچون شمشیری تیز قرار نده و با پادشاهان و سلاطین مبارزه نکن."],[266,"حوض با دریا اگر پهلو زند","خویش را از بیخ هستی بر کند","اگر حوضی به دریا نزدیک شود، وجودش به خاطر تفاوت‌های عمیقشان از ریشه و بنیاد خود کنده می‌شود."],[266,"نیست بحری کو کران دارد که تا","تیره گردد او ز مردار شما","هیچ دریا و آب بزرگی وجود ندارد که وقتی تاریک و کثیف شود، از وجود شما (مردم) بی‌نیاز باشد."],[266,"کفر را حدست و اندازه بدان","شیخ و نور شیخ را نبود کران","کفر یک حد و اندازه مشخصی دارد، اما نور شیخ (احتمالا اشاره به علم و هدایت او) بی‌پایان و نامحدود است."],[266,"پیش بی حد هرچه محدودست لاست","کل شیء غیر وجه الله فناست","هر چیزی که محدود و دارای حد و اندازه است، در مقابل ذات بی‌نهایت خداوند از بین می‌رود و ناپایدار است. تنها جلوه و رخساره خداوند است که باقی می‌ماند."],[266,"کفر و ایمان نیست آنجایی که اوست","زانک او مغزست و این دو رنگ و پوست","در جایی که خداوند حضور دارد، دیگر تفکیکی بین کفر و ایمان وجود ندارد، زیرا خداوند اصل و حقیقت است و کفر و ایمان تنها ظواهر و لباس‌های این حقیقت هستند."],[266,"این فناها پرده آن وجه گشت","چون چراغ خفیه اندر زیر طشت","این فناها (انحطاط‌ها و زوال‌ها) موجب می‌شود که آن حقیقت و نور اصلی به وجود بیاید، مانند چراغی که در زیر ظرف پنهان است و فقط زمانی که پرده را کنار بزنیم، نور آن نمایان می‌شود."],[266,"پس سر این تن حجاب آن سرست","پیش آن سر این سر تن کافرست","این بدن تنها حجاب آن حقیقت بالاتر است و هر که به این بدن وابسته باشد، کافر به آن حقیقت محسوب می‌شود."],[266,"کیست کافر غافل از ایمان شیخ","کیست مرده بی خبر از جان شیخ","کافر، کسی است که از ایمان شیخ غافل است و مرده، کسی است که از روح و جان شیخ بی‌خبر است.یعنی کسی که به معنویت شیخ توجهی ندارد، از حقیقت زندگی و ایمان نیز بی‌خبر است."],[266,"جان نباشد جز خبر در آزمون","هر که را افزون خبر جانش فزون","جان واقعی انسان تنها در کسب آگاهی و خبر از معانی و حقایق نمایان می‌شود. هر کس که آگاهی بیشتری داشته باشد، جان او نیز بیشتر و پربارتر است."],[266,"جان ما از جان حیوان بیشتر","از چه زان رو که فزون دارد خبر","جان ما از جان حیوان بالاتر است، زیرا که ما دارای آگاهی و خبر بیشتری هستیم."],[266,"پس فزون از جان ما جان ملک","کو منزه شد ز حس مشترک","پس جان ملک، که از حس مشترک و تعلقات دنیوی پاک و منزه است، بیشتر از جان ماست."],[266,"وز ملک جان خداوندان دل","باشد افزون تو تحیر را بهل","ملک جان خداوندان دل، به چیزی افزون‌تر از تحیر و حیرت اشاره دارد. از این رو، تو نباید به تحیر و شگفتی بپردازی یا آن را مورد توجه قرار دهی."],[266,"زان سبب آدم بود مسجودشان","جان او افزونترست از بودشان","آدم به خاطر این که مورد سجده ملائک قرار گرفت، باعث شد که جان او از وجود آنها برتر باشد."],[266,"ورنه بهتر را سجود دون‌تری","امر کردن هیچ نبود در خوری","اگرچه سجده بر مخلوقی فروتر از خود، از نظر حکمت و محبت خداوند هیچ معنایی ندارد، اما در غیر این صورت، بهتر است که انسان به جای این کار، به سجده بر موجودات برتر و والا بپردازد."],[266,"کی پسندد عدل و لطف کردگار","که گلی سجده کند در پیش خار","خداوندی عادل و مهربان چگونه می‌تواند بپسندد که گلی، این موجود ارزشمند، در برابر خاری که ارزشی ندارد سجده کند؟"],[266,"جان چو افزون شد گذشت از انتها","شد مطیعش جان جمله چیزها","زمانی که جان انسان رشد و ترقی می‌کند و به کمال می‌رسد، دیگر در محدودیت‌ها و محدودیت‌های مادی نمی‌ماند و تمام اجزا و موجودات تحت فرمان آن جان می‌شوند."],[266,"مرغ و ماهی و پری و آدمی","زانک او بیشست و ایشان در کمی","مرغ، ماهی، پری و آدمی همه به خاطر آنکه او (خدا) بزرگتر و برتر است، در مقایسه با او در مرتبه‌ای پایین‌تر قرار دارند."],[266,"ماهیان سوزن‌گر دلقش شوند","سوزنان را رشته‌ها تابع بوند","ماهیانی که دلق شیخ را می‌دوزند، مانند سوزن‌زن‌ها هستند و این سوزن‌ها نیز به رشته‌ها وابسته‌اند. یعنی هر یک از این عناصر در کار خود نقش خاصی دارند و به هم مرتبط‌اند."],[267,"چون نفاذ امر شیخ آن میر دید","ز آمد ماهی شدش وجدی پدید","شیخ ابراهیم ادهم از طریق قدرت روحانی خود، به فرمان خود دریا را تحت تأثیر قرار می‌دهد و وقتی ماهی به دریا می‌آید، حالتی شگفت‌انگیز و وجد در او به‌وجود می‌آید."],[267,"گفت اه ماهی ز پیران آگهست","شه تنی را کو لعین درگهست","ماهی گفت که پیران (پیران آگاه و حکیم) از حال ما باخبر هستند و از این رو، ای پادشاه! تو هم به خاطر بدرفتاری و گناهانت که در درگاه الهی وجود دارد، به ما نمی‌رسی."],[267,"ماهیان از پیر آگه ما بعید","ما شقی زین دولت و ایشان سعید","ماهیان از پیر، که نماد دانشی و حکمت است، خبر دارند که ما از آن آگاهی دور هستیم. ما از این نعمت و سعادت بهره‌ای نداریم و در واقع ما بدبخت و شقاوت‌زده هستیم، در حالی که آنها خوشبختند."],[267,"سجده کرد و رفت گریان و خراب","گشت دیوانه ز عشق فتح باب","او (ابراهیم ادهم) از شدت عشق و شوق، به حالت سجده درمی‌آید و در حالی که اشک می‌ریزد و نگران و پریشان است، از آنجا می‌رود. این حالت دیوانگی او ناشی از عشق و علاقه‌ای است که به یک حقیقت یا مقام بلند در زندگی دارد."],[267,"پس تو ای ناشسته‌رو در چیستی","در نزاع و در حسد با کیستی","پس ای کسی که پاک و تمیز نیستی، در واقع چه هستی؟ در چه چیزی درگیر هستی؟ در نزاع و حسد با چه کسی مشغولیتی داری؟"],[267,"با دم شیری تو بازی می‌کنی","بر ملایک ترک‌تازی می‌کنی","تو با قدرت و توانایی‌ای که از نفس خود به دست آورده‌ای، با فرشتگان (ملائکه) به سخره و شوخی می‌پردازی و به آنها فخر می‌کنی."],[267,"بد چه می‌گویی تو خیر محض را","هین ترفع کم شمر آن خفض را","چرا درباره خوبی محض صحبت بد می‌کنی؟ کمتر خودت را پایین بیاور و آن اشکال را نادیده بگیر."],[267,"بد چه باشد مس محتاج مهان","شیخ کی بود کیمیای بی‌کران","بدی چه معنایی دارد وقتی که مس (فلز بی‌ارزش) نیازمند مهمان (اندیشمند یا اهل معرفت) است؟ شیخ (عالم یا بزرگ) چه کسی است که کیمیای بی‌کران (ثروت یا ارزش عظیم) باشد؟"],[267,"مس اگر از کیمیا قابل نبد","کیمیا از مس هرگز مس نشد","اگر مس از کیمیا قابل تبدیل به طلا نیست، کیمیا هرگز نمی‌تواند مس را به خودش تبدیل کند."],[267,"بد چه باشد سرکشی آتش‌عمل","شیخ کی بود عین دریای ازل","سرکشی و طغیان آتش عمل یعنی رفتار شدید و خشمگین، چه بدی می‌تواند داشته باشد وقتی که حقیقتی مثل شیخ (که نماد عارف و صاحب‌نظر است) به آن شدت و عمق وجود دارد، همچون دریای ازل (پیش از زمان و مکان) که مقام و قداست بالایی دارد."],[267,"دایم آتش را بترسانند از آب","آب کی ترسید هرگز ز التهاب","آتش را همیشه از آب می‌ترسانند، اما آیا می‌توان به آبی که خاصیتش خاموش کردن آتش است، ترسید؟ در واقع آب هرگز از حرارت و التهاب آتش نمی‌ترسد."],[267,"در رخ مه عیب‌بینی می‌کنی","در بهشتی خارچینی می‌کنی","تو در چهره زیبا و دلنشین دوست عیبی پیدا می‌کنی و در بهشت، که باید پر از نعمت باشد، به دنبال عیب و نقص می‌گردی."],[267,"گر بهشت اندر روی تو خارجو","هیچ خار آنجا نیابی غیر تو","اگر بهشت در وجود تو باشد، هیچ خار و زحمتی در آنجا نخواهی دید، جز خودت."],[267,"می‌بپوشی آفتابی در گلی","رخنه می‌جویی ز بدر کاملی","تو در جستجوی زیبایی و کمالی هستی که مانند آفتابی در گل روشنایی می‌دهد، اما همچنان کنجکاوی و تلاش برای یافتن آن زیبایی را ادامه می‌دهی."],[267,"آفتابی که بتابد در جهان","بهر خفاشی کجا گردد نهان","خورشیدی که در جهان می‌تابد، نمی‌تواند برای خفاشی (به معنی موجوداتی که در تاریکی زندگی می‌کنند) پنهان شود. در واقع، نور و حقیقت نمی‌توانند از دید کسی پنهان بمانند."],[267,"عیبها از رد پیران عیب شد","غیبها از رشک ایشان غیب شد","عیب‌های مردم به خاطر رد و طرد کردن و نادیده گرفتن پیران (سالمندان) آشکار شد، و در نتیجه، رازها و ویژگی‌های پنهان دیگران به دلیل حسادت پیران، دیگر بر ملا نشد."],[267,"باری ار دوری ز خدمت یار باش","در ندامت چابک و بر کار باش","اگر از خدمت یار دور هستی، باید با ندامت و پشیمانی دائم در کار و تلاش بمانی."],[267,"تا از آن راهت نسیمی می‌رسد","آب رحمت را چه بندی از حسد","هرگاه نسیمی از راه تو می‌رسد، دیگر چه نیازی به احساس حسد و بستن آب رحمت است؟ این اشاره به این دارد که وقتی رحمت و فیضی از سوی خداوند به انسان می‌رسد، حسد و کینه‌ورزی در روح او جایی ندارد."],[267,"گرچه دوری دور می‌جنبان تو دم","حیث ما کنتم فولوا وجهکم","اگرچه ما از تو دور هستیم و وجود ما از تو فاصله دارد، اما تو با حرکت و نفس‌کشیدن خود، ما را به سمت خود می‌کشانی و به سوی خودت بازمی‌گردانی."],[267,"چون خری در گل فتد از گام تیز","دم بدم جنبد برای عزم خیز","وقتی که الاغی در گل بیفتد، هر لحظه با پاهایش از جا حرکت می‌کند تا از آن وضعیت خارج شود."],[267,"جای را هموار نکند بهر باش","داند او که نیست آن جای معاش","او می‌داند که هیچ‌گاه به هدف و آرزوی خود نخواهد رسید، پس از تلاش برای هموار کردن راه زندگی خود پرهیز می‌کند."],[267,"حس تو از حس خر کمتر بدست","که دل تو زین وحلها بر نجست","تو از حس حیواناتی چون خر هم کمتر احساس داری، زیرا دل تو از این مسائل دنیوی آزاد نشده و نتوانسته به حقیقتی بالاتر برسد."],[267,"در وحل تاویل و رخصت می‌کنی","چون نمی‌خواهی کز آن دل بر کنی","تو در حالی که نمی‌خواهی دل از آن وحل (مشکلات و سختی‌ها) بکنید، به تاویل (توجیه و تفسیر) و رخصت (اجازه) می‌پردازی."],[267,"کین روا باشد مرا من مضطرم","حق نگیرد عاجزی را از کرم","این درست است که من در این وضعیت نیازمندم، پروردگار نمی‌تواند از بخشندگی‌اش بر کسی که در شرایط سختی قرار دارد، چیزی بخواهد."],[267,"خود گرفتستت تو چون کفتار کور","این گرفتن را نبینی از غرور","تو مانند کفتار نابینا به خودخواهی مشغول شده‌ای و به دلیل غرورت نمی‌توانی این فریب را ببینی."],[267,"می‌گوند اینجایگه کفتار نیست","از برون جویید کاندر غار نیست","می‌گویند در اینجا کفتار (پشت آن دریا) وجود ندارد، از بیرون به جستجوی آن مشغولند، در حالی که در غار (پنهان) نیست."],[267,"این همی‌گویند و بندش می‌نهند","او همی‌گوید ز من بی آگهند","این افراد می‌گویند و او را به زنجیر می‌کشند، اما او می‌گوید که اینها از حال من بی‌خبرند و نمی‌دانند چه می‌گذرد."],[267,"گر ز من آگاه بودی این عدو","کی ندا کردی که آن کفتار کو","اگر از من باخبر بودی، این دشمن چرا ندا می‌کرد که آن کفتار کجاست؟"],[268,"آن یکی می‌گفت در عهد شعیب","که خدا از من بسی دیدست عیب","شخصی در زمان شعیب می‌گفت که خداوند، عیب‌ها و نقص‌های زیادی را در من مشاهده کرده است."],[268,"چند دید از من گناه و جرمها","وز کرم یزدان نمی‌گیرد مرا","شخصی در این بیت می‌گوید که من گناهان و خطاهایم را انجام داده‌ام، اما به لطف خداوند و رحمت او، حس نمی‌کنم که به خاطر آنها مجازات می‌شوم."],[268,"حق تعالی گفت در گوش شعیب","در جواب او فصیح از راه غیب","خداوند در جواب شعیب به طور غیرمستقیم و از طریق الهام، سخنانی را به او می‌گوید که نشان‌دهنده فهم و بینش عمیق است."],[268,"که بگفتی چند کردم من گناه","وز کرم نگرفت در جرمم اله","شعیب علیه السلام می‌گوید: تو چگونه می‌گویی که من چندین بار گناه کرده‌ام و خداوند از روی کرم و بزرگواری به خاطر اینها مرا مجازات نکرده است؟"],[268,"عکس می‌گویی و مقلوب ای سفیه","ای رها کرده ره و بگرفته تیه","ای نادان، تو عکس حقیقت را بیان می‌کنی و در فهم خود به اشتباه افتاده‌ای. راه درست را رها کرده‌ای و به جایی تاریک و گمراهان شده‌ای."],[268,"چند چندت گیرم و تو بی‌خبر","در سلاسل مانده‌ای پا تا به سر","چند بار باید تو را یادآوری کنم که در حالی که غافل هستی، به زنجیرهای گناه افتاده‌ای از سر تا پا؟"],[268,"زنگ توبرتوت ای دیگ سیاه","کرد سیمای درونت را تباه","زنگ و کثیفی دیگ سیاه، نمای ظاهری تو را خراب کرده و باعث شده که باطن و درونت نیز آسیب ببیند."],[268,"بر دلت زنگار بر زنگارها","جمع شد تا کور شد ز اسرارها","زنگارهای روی دل تو، که ناشی از خطاها و گناهان است، آن‌چنان انبوه شده که به‌کلی از اسرار و نکات پنهان غافلی و نمی‌توانی آن‌ها را ببینی."],[268,"گر زند آن دود بر دیگ نوی","آن اثر بنماید ار باشد جوی","اگر دودی بر دیگ بزند، آناثر نشان می‌دهد، حتی اگر جوی در آن وجود داشته باشد. این بیت به تأثیر نشانه‌ها و آثار محیط بر حالت‌ها و حالات اشاره دارد."],[268,"زانک هر چیزی به ضد پیدا شود","بر سپیدی آن سیه رسوا شود","هر چیزی در عالم وجود خود را از طریق ضدش نشان می‌دهد؛ یعنی سیاهی به واسطه وجود سفیدی آشکار می‌شود و این‌گونه سیاهی، رسوا می‌گردد."],[268,"چون سیه شد دیگ پس تاثیر دود","بعد ازین بر وی که بیند زود زود","هرگاه دیگ سیاه شود، این نشان‌دهنده تأثیر دود است و دیگران هم به سرعت متوجه آن می‌شوند."],[268,"مرد آهنگر که او زنگی بود","دود را با روش هم‌رنگی بود","مرد آهنگر که سیاه‌پوست بود، آن چنان با دود هم‌رنگ شده بود که دیگر نتوانست او را از دود شناسایی کرد."],[268,"مرد رومی کو کند آهنگری","رویش ابلق گردد از دودآوری","مرد رومی که به کار آهنگری مشغول است، به سبب دودهایی که از کوره بلند می‌شود، رنگ و رویش زرد و سیاه می‌شود."],[268,"پس بداند زود تاثیر گناه","تا بنالد زود گوید ای اله","پس او باید زود متوجه عواقب گناهش شود و به سرعت از خداوند کمک بخواهد و ناله کند که ای خدای بزرگ."],[268,"چون کند اصرار و بد پیشه کند","خاک اندر چشم اندیشه کند","وقتی کسی به گناه اصرار ورزد و رفتار بدی از خود نشان دهد، مانع از دیدن حقیقت و دانسته‌های خودش می‌شود و موجب می‌شود که مانند فردی که خاک در چشمش رفته، نتواند درست بیندیشد."],[268,"توبه نندیشد دگر شیرین شود","بر دلش آن جرم تا بی‌دین شود","اگر کسی به فکر توبه نباشد، دلش از گناه خوشحال می‌شود تا جایی که نسبت به دین بی‌توجه و بی‌دین می‌گردد."],[268,"آن پشیمانی و یا رب رفت ازو","شست بر آیینه زنگ پنج تو","او (شخص مزبور) به خاطر پشیمانی‌اش دیگر نمی‌تواند عذرخواهی کند و گناهش از دلش پاک شده است، مانند اینکه زنگاری که بر روی آیینه نشسته، دیگر از آن پاک شده است."],[268,"آهنش را زنگها خوردن گرفت","گوهرش را زنگ کم کردن گرفت","زنگ زدن آهن به معنای خراب شدن و آسیب دیدن آن است، و در اینجا به گوهر اشاره دارد که در اثر زنگ‌زدگی کمتر ارزشمند می‌شود. در حقیقت، وقتی که زنگ بر آهن نشسته، به تدریج ارزش و زیبایی گوهر نیز کاهش می‌یابد."],[268,"چون نویسی کاغذ اسپید بر","آن نبشته خوانده آید در نظر","اگر بر روی کاغذ سفیدی چیزی بنویسند، وقتی آن را بخوانند، در نظر خواننده، نوشته به وضوح و روشنی دیده می‌شود."],[268,"چون نویسی بر سر بنوشته خط","فهم ناید خواندنش گردد غلط","چون چیزی که بر کاغذ نوشته شده، با نوشته‌ای نادرست یا غیرقابل‌فهم همراه باشد، انسان نمی‌تواند آن را درست بخواند و فهم درستی از آن به دست نخواهد آورد."],[268,"کان سیاهی بر سیاهی اوفتاد","هر دو خط شد کور و معنیی نداد","وقتی که سیاهی بر سیاهی دیگری افزوده شود، در واقع هر دو نوشته و معنا را پنهان می‌کند و دیگر قابل فهم نیست."],[268,"ور سیم باره نویسی بر سرش","پس سیه کردی چو جان پر شرش","اگر بر دیوانگی او خطی سیاه بنویسی، آن‌قدر روحش را آزار داده‌ای که مثل جانش، سیاه و پریشان می‌شود."],[268,"پس چه چاره جز پناه چاره‌گر","ناامیدی مس و اکسیرش نظر","برای رهایی از ناامیدی، چه راهی جز پناه بردن به کسی که می‌تواند چاره‌ساز باشد، یعنی تنها امید ما در این وضعیت، خود اکسیر و مس (نماد تحول و دگردیسی) است که به ما نظر کند."],[268,"ناامیدیها به پیش او نهید","تا ز درد بی‌دوا بیرون جهید","ناامیدی‌ها و مشکلاتتان را به او (خدای تعالی) ارائه دهید تا از درد و رنج بی‌دوای خود رها شوید."],[268,"چون شعیب این نکته‌ها با وی بگفت","زان دم جان در دل او گل شکفت","زمانی که شعیب این مسائل را با آن شخص مطرح کرد، از آن لحظه جان او در دلش شاداب و سرشار از نشاط شد."],[268,"جان او بشنید وحی آسمان","گفت اگر بگرفت ما را کو نشان","روح او پیام آسمانی را شنید که می‌گفت اگر خدا ما را بگیرد، نشانی از این کار کجا می‌توان یافت؟"],[268,"گفت یا رب دفع من می‌گوید او","آن گرفتن را نشان می‌جوید او","شعیب علیه السلام می‌گوید: «خدایا، او (مشکلی که به من می‌گوید) را دور کن، زیرا او تنها نشانه‌ای از گرفتن (عذاب یا مشکل) را می‌طلبد."],[268,"گفت ستارم نگویم رازهاش","جز یکی رمز از برای ابتلاش","گفت: من ستارالعیوب هستم و رازهای او را نمی‌گویم، جز اینکه یک رمز برای امتحان او بگویم."],[268,"یک نشان آنک می‌گیرم ورا","آنک طاعت دارد و صوم و دعا","من تنها یک نشانه از خدا را می‌گیرم و آن نشانه برای کسی است که اطاعت و عبادت می‌کند و روزه و دعا می‌گیرد."],[268,"وز نماز و از زکات و غیر آن","لیک یک ذره ندارد ذوق جان","صرف نظر از نماز و زکات و دیگر عبادات، اما هیچ خوشی و شوقی در دل او وجود ندارد."],[268,"می‌کند طاعات و افعال سنی","لیک یک ذره ندارد چاشنی","او (شخصی که در حال صحبت است) عبادت‌ها و اعمال نیک انجام می‌دهد، اما در این اعمال حتی اندکی از محبت یا حال دلنشین وجود ندارد."],[268,"طاعتش نغزست و معنی نغز نی","جوزها بسیار و در وی مغز نی","نیکی و عبادت او زیبا و پسندیده است، اما باطن آن عبادت معنادار نیست؛ مثل اینکه درخت‌ها پر از میوه هستند، اما مغز میوه‌ها در آن‌ها وجود ندارد."],[268,"ذوق باید تا دهد طاعات بر","مغز باید تا دهد دانه شجر","برای اینکه عبادت و اطاعت به واقعیت و عمق برسد، باید اشتیاق و ذوق واقعی وجود داشته باشد؛ همچنین برای اینکه میوه از درخت به وجود بیاید، باید دانه شامل مغز و هسته باشد."],[268,"دانه بی‌مغز کی گردد نهال","صورت بی‌جان نباشد جز خیال","دانه‌ای که مغز ندارد، هرگز نمی‌تواند نهال شود. همچنین، صورت یا ظاهری که جان ندارد، تنها یک خیال است و حقیقتی ندارد."],[269,"آن خبیث از شیخ می‌لایید ژاژ","کژنگر باشد همیشه عقل کاژ","آن فرد بدجنس از شیخ انتقاد می‌کرد و به او بدگمان بود و همواره فکر می‌کرد که عقلش درهم و خراب است."],[269,"که منش دیدم میان مجلسی","او ز تقوی عاریست و مفلسی","من در میان مجلسی او را دیدم که از تقوا تهی است و در فقر به سر می‌برد."],[269,"ورکه باور نیستت خیز امشبان","تا ببینی فسق شیخت را عیان","اگر به سخنان من باور نداری، امشب بلند شو و برو تا به‌وضوح فساد و ناپاکی شیخ را ببینی."],[269,"شب ببردش بر سر یک روزنی","گفت بنگر فسق و عشرت کردنی","شب او را به نزد یک روزنه‌ای برد و گفت: به تماشای فساد و خوشگذرانی‌هایی که انجام می‌دهد، نگاه کن."],[269,"بنگر آن سالوس روز و فسق شب","روز همچون مصطفی شب بولهب","به او توجه کن که در روز چهره‌ای نیکو و خوش نشان می‌دهد، ولی در شب به فسق و گناه مشغول است. این در مورد کسانی است که مانند مصطفی(پیامبر اسلام) در ظاهر پاک و درستکارند، ولی در باطن مانند ولید بن مغیره (بولهب)، از منافقان و گناهکاران به شمار می‌روند."],[269,"روز عبدالله او را گشته نام","شب نعوذ بالله و در دست جام","در روز، عبدالله را به نام «او» می‌خوانند، ولی در شب به او کلمه‌ای تأسف‌آور و ناپسند نسبت می‌دهند و در دستش جام شراب است."],[269,"دید شیشه در کف آن پیر پر","گفت شیخا مر تو را هم هست غر","مرد بیگانه که در دست جام است، به آن شیخ (عبدالله) نگاه می‌کند و با کنایه به او می‌گوید: \"ای شیخ، تو هم از این فریفتگی و خودبزرگ‌بینی بی‌نصیب نیستی."],[269,"تو نمی‌گفتی که در جام شراب","دیو می‌میزد شتابان نا شتاب","تو نمی‌گفتی که در شراب، دیو به‌سرعت و با شتاب می‌زند."],[269,"گفت جامم را چنان پر کرده‌اند","کاندرو اندر نگنجد یک سپند","مرد بیگانه می‌گوید که جام من را به قدری پر کرده‌اند که حتی یک دانه سپند (دانه‌ای کوچک) هم در آن جا نمی‌شود."],[269,"بنگر اینجا هیچ گنجد ذره‌ای","این سخن را کژ شنیده غره‌ای","به اینجا نگاه کن، هیچ چیزی جا نمی‌گیرد. این فرد با شنیدن نادرست سخن، مغرور شده است."],[269,"جام ظاهر خمر ظاهر نیست این","دور دار این را ز شیخ غیب‌بین","شراب ظاهر که در اینجا به آن اشاره شده، در حقیقت چیزی مادی نیست و نمی‌توان آن را تنها به شکل فیزیکی در نظر گرفت. این مفهوم، نمادی از درک عمیق و باطن وجود است که تنها افرادی چون شیخ غیب‌بین می‌توانند آن را درک کنند. بنابراین، باید در تفکر خود این حقیقت عمیق‌تر را مد نظر داشته باشیم."],[269,"جام می هستی شیخست ای فلیو","کاندرو اندر نگنجد بول دیو","جام هستی متعلق به شیخ است، ای عاقل، زیرا در آن فضیلت و نور وجود دارد و این فضیلت به قدری بزرگ است که جایی برای وجود دیو نمی‌ماند."],[269,"پر و مالامال از نور حقست","جام تن بشکست نور مطلقست","جام تن (بدن انسان) از نور حق پر و سرشار است، اما وقتی شکسته می‌شود، همان نور مطلق نمایان می‌شود."],[269,"نور خورشید ار بیفتد بر حدث","او همان نورست نپذیرد خبث","اگر نور خورشید بر زشتی و پلیدی انسان بیفتد، آن نور همان نور است و زشتی نمی‌تواند آن را بپذیرد یا تغییر دهد."],[269,"شیخ گفت این خود نه جامست و نه می","هین بزیر آ منکرا بنگر بوی","شیخ گفت این چیزی که می‌بینی نه جام (پیمانه) است و نه شراب. بیا و به این منکر (نقص) زیر پا نگاه کن."],[269,"آمد و دید انگبین خاص بود","کور شد آن دشمن کور و کبود","مرد بیگانه (دشمن) آمد و متوجه شد که عسل مخصوص و خاصی وجود دارد. او از شدت حسادت و کینه‌اش در درون خود نابینا و پریشان شد."],[269,"گفت پیر آن دم مرید خویش را","رو برای من بجو می ای کیا","پیر (شیخ) به مریدش دستور می‌دهد که برود و به دلیلی به دنبالش بگردد تا نیاز او را برآورده کند. در اینجا «می» به معنای شراب و دلیلی برای جست‌وجو به جهت حال خوب شیخ است."],[269,"که مرا رنجیست مضطر گشته‌ام","من ز رنج از مخمصه بگذشته‌ام","من دردی دارم که به شدت من را به تنگنا انداخته است و از آن درد، دیگر به شرایط سخت قبلی خود رسیده‌ام."],[269,"در ضرورت هست هر مردار پاک","بر سر منکر ز لعنت باد خاک","در شرایط ضروری، هر چیز ناپاک بر سر کسی که منکر است، لعنت باید بر او ببارد و همچون خاک او را فراگیرد."],[269,"گرد خمخانه بر آمد آن مرید","بهر شیخ از هر خمی او می‌چشید","مرید (پیرو) از هر خمره‌ای در خمخانه نیکو شراب می‌چشید تا بر سر شیخ (استاد) بیاورد."],[269,"در همه خمخانه‌ها او می ندید","گشته بد پر از عسل خم نبید","در تمام خمخانه‌ها، او شرابی نمی‌دید و دریافته بود که خم شراب از عسل پر شده است."],[269,"گفت ای رندان چه حالست این چه کار","هیچ خمی در نمی‌بینم عقار","شیخ به رندان می‌گوید: حال شما چه طور است؟ چرا هیچ بویی از شراب نمی‌شنوم و نمی‌بینم."],[269,"جمله رندان نزد آن شیخ آمدند","چشم گریان دست بر سر می‌زدند","همه رندان پیش آن شیخ حضور یافتند، در حالی که با چشمانی گریان بودند و بر سر خود دست می‌زدند."],[269,"در خرابات آمدی شیخ اجل","جمله میها از قدومت شد عسل","شیخ اجل (که به احتمال زیاد به معنای پیر و عاقل است) به خرابت (محل می‌خوارگی) آمده است و به‌دلیل حضور او، همه شراب‌ها شیرین و خوشمزه شده‌اند، مانند عسل."],[269,"کرده‌ای مبدل تو می را از حدث","جان ما را هم بدل کن از خبث","ای کسی که تو شراب را از ناخالصی پاک کرده‌ای، جان ما را هم از پلیدی‌ها پاک کن."],[269,"گر شود عالم پر از خون مال‌مال","کی خورد بنده خدا الا حلال","اگر عالم پر از خون شود و از امور ناپاک پر شود، هیچ‌کس نمی‌تواند جز امور حلال، که حق است، تغذیه کند."],[270,"عایشه روزی به پیغامبر بگفت","یا رسول‌الله تو پیدا و نهفت","عایشه در یک روز به پیامبر اسلام (حضرت محمد) گفت: \"ای رسول خدا، تو هم در حال ظاهر و هم در حال پنهان هستی."],[270,"هر کجا یابی نمازی می‌کنی","می‌دود در خانه ناپاک و دنی","هر جا که نماز می‌خوانی، می‌دوی، و این در حالی است که در خانه‌های ناپاک و دنیوی قرار داری."],[270,"گرچه می‌دانی که هر طفل پلید","کرد مستعمل به هرجا که رسید","عایشه از پیامبر (مصطفی) پرسید که با وجود اینکه می‌دانید هر بچه‌ای ممکن است نجس (پلید) شود، چرا در هر مکانی نماز می‌خوانید؟"],[270,"گفت پیغامبر که از بهر مهان","حق نجس را پاک گرداند، بدان","پیامبر (مصطفی) فرمود که خداوند به خاطر مهمانان، چیزهای نجس را پاک می‌کند، بنابراین برای آنها به احترام، پاکی ایجاد می‌شود."],[270,"سجده‌گاهم را از آن رو لطف حق","پاک گردانید تا هفتم طبق","عایشه به پیامبر می‌گوید که خداوند سجده‌گاه او را به خاطر لطفی که به او دارد، از آلودگی‌ها پاک کرده است، به‌طوری که سجده‌گاهش به بالاترین درجات روحانی رسیده است."],[270,"هان و هان ترک حسد کن با شهان","ور نه ابلیسی شوی اندر جهان","حواس‌تان را جمع کنید و حسد را کنار بگذارید، زیرا اگر این حسد را ادامه دهید، ممکن است در دنیا مانند ابلیس شوید."],[270,"کاو اگر زهری خورد شهدی شود","تو اگر شهدی خوری زهری بود","اگر او (معروف به عایشه) زهر بخورد، به شیرینى تبدیل می‌شود و تو اگر شیرینى بخورى، تبدیل به زهر می‌شوى."],[270,"کاو بدل گشت و بدل شد کار او","لطف گشت و نور شد هر نار او","کسی که دگرگون شد و کارش تغییر کرد، لطف و نیکی او را فراگرفت و هر فکری که داشت، به نور و روشنی تبدیل شد."],[270,"قوّت حق بود مر بابیل را","ور نه مرغی چون کشد مر پیل را‌؟","قدرت خداوند موجب نابودی بابیل (بابل) شد وگرنه چگونه یک پرنده می‌تواند فیل را از بین ببرد؟"],[270,"لشکری را مرغکی چندی شکست","تا بدانی کان صلابت از حقست","مرغکی گروهی را شکست داد تا بفهمی که این استحکام و قدرت از سوی حق است."],[270,"گر تو را وسواس آید زین قبیل","رو بخوان تو سوره اصحاب فیل","اگر وسوسه‌ای در مورد این موضوع به تو دست داد، سوره اصحاب فیل را بخوان."],[270,"ور کنی با او مری و همسری","کافرم دان گر تو زیشان سر بری","اگر با او (مصطفی علیه‌السلام) به دوستی و همکاری بپردازی، بدان که کافر هستی، حتی اگر تو از آنها (کافران) جدا شوی و سرشان را هم ببری."],[271,"موشکی در کف مهار اشتری","در ربود و شد روان او از مری","موشی در دستش مهار شتری را گرفت و به حرکت درآورد و شتر از این موضوع به شگفتی افتاد."],[271,"اشتر از چستی که با او شد روان","موش غرّه شد که هستم پهلوان‌‌!","شتر به خاطر چابکی و تندی که موش داشت، به خود مغرور شد و گمان کرد که من هم پهلوان و قوی هستم."],[271,"بر شتر زد پرتو اندیشه‌اش","گفت بنمایم تو را تو باش خوش!","موش با اندیشه‌اش به شتر می‌گوید: اگر بخواهم، می‌توانم تو را نشان دهم که تو هم باید خوشحال باشی!"],[271,"تا بیامد بر لب جوی بزرگ","کاندرو گشتی زبون پیل سترگ","موش به کناری از جوی بزرگ رسید و در آنجا زبون و حقیر شد، مانند فیل بزرگ، که در مقابل این جویی کوچک و کم‌عمق احساس کوچکی و حقارت می‌کند."],[271,"موش آنجا ایستاد و خشک گشت","گفت اشتر ای رفیق کوه و دشت","موش در آنجا متوقف شد و از ترس خشک و بی‌حرکت شد و به شتر گفت: ای دوست، تو که در کوه‌ها و دشت‌ها می‌روی، کجایی؟"],[271,"این توقف چیست؟ حیرانی چرا‌؟","پا بنه، مردانه اندر جو در آ","موش از خود می‌پرسد که چرا اینجا ایستاده و ناباورانه به سوی او می‌نگرد. او از اشتر می‌خواهد که بی‌درنگ به راه افتد و مردانه حرکت کند."],[271,"تو قلاوزی و پیش‌آهنگ من‌‌‌!","درمیان ره مباش و تن مزن","تو در کارهای من چابک و پیشرو هستی، اما در مسیر زندگی میان‌بر نزن و خودت را درگیر نکن."],[271,"گفت این آب شگرفست و عمیق","من همی‌ترسم ز غرقاب ای رفیق","شتر می‌گوید این آب بسیار عمیق و خطرناک است و من از غرق شدن در آن می‌ترسم، ای رفیق."],[271,"گفت اشتر تا ببینم حد آب‌‌؟!","پا درو بنهاد آن اشتر شتاب","شتر گفت: تا ببینم عمق آب چقدر است؟ سپس پایش را به سرعت در آب گذاشت."],[271,"گفت تا زانوست آب ای کورموش","از چه حیران گشتی و رفتی ز هوش‌‌؟","اشتر به موش می‌گوید: وقتی آب تا زانوست، چرا این‌قدر متعجب و بی‌خود شدی؟"],[271,"گفت مور تست و ما را اژدهاست","که ز زانو تا به زانو فرقهاست","گفت موش تو کوچک است و ما مانند اژدها بزرگ و قدرتمندیم، چرا که تفاوت‌ها بین ما از زانو به زانو بسیار است."],[271,"گر تو را تا زانو است ای پر هنر","مر مرا صد گز گذشت از فرق سر","اگر تو فقط تا زانو قد و مقام داری، من هنر و قابلیت‌های بسیاری دارم که از فرق سرم صد برابر بیشتر است."],[271,"گفت گستاخی مکن بار دگر","تا نسوزد جسم و جانت زین شرر","مراقب باش و دیگر جسارت نکن، زیرا ممکن است جسم و جانت به این آتش دچار آسیب شود."],[271,"تو مری با مثل خود موشان بکن","با شتر مر موش را نبود سخن","تو به اندازه موش خودت در برابر شتر عمل کن و کاری را که شتر می‌خواهد انجام دهد، نکن؛ زیرا موش در مقایسه با شتر، هیچ حرفی برای گفتن ندارد و در مقابلش بی‌معنی است."],[271,"گفت توبه کردم از بهر خدا","بگذران زین آب مهلک مر مرا","شتر به موش می‌گوید که برای خدا از کارهای بد خود توبه کرده و از تو می‌خواهد که مرا از این آب خطرناک عبور بدهی."],[271,"رحم آمد مر شتر را گفت هین","برجه و بر کودبان من نشین","موش به شتر رحم می‌کند و می‌گوید ای شتر، بشتاب و بر شانه‌های من بنشین تا بر تو سوار شوم."],[271,"این گذشتن شد مسلم مر مرا","بگذرانم صد هزاران چون تو را","این که تو از من دور شدی برایم مسلم است، بنابراین باید من را به حال خود بگذاری و به سراغ هزاران مثل تو بروی."],[271,"چون پیمبر نیستی پس رو به راه","تا رسی از چاه روزی سوی جاه","چون تو پیامبر نیستی، به راهی برو که از چاه و سختی‌ها به جایی بهتر برسی."],[271,"تو رعیت باش چون سلطان نه‌ای","خود مران، چون مرد کشتیبان نه‌ای","تو باید مانند رعیت و زیر دستان باشی، نه مانند سلطان، زیرا تو چنین مقام و جایگاهی نداری. خود را به جلو نران، چرا که تو هم چون مردی که در کشتی است، جایگاه خاصی نداری."],[271,"چون نه‌ای کامل دکان تنها مگیر","دست‌خوش می‌باش تا گردی خمیر","وقتی هنوز کامل نیستی، تنها به دنبال تصاحب دکان نباش؛ بهتر است همچون خمیر اطاعت و تسلیم باشی تا در نهایت به کمال برسی."],[271,"انصتوا را گوش کن خاموش باش","چون زبان حق نگشتی گوش باش","خاموش باش و به سخن حق گوش بده، زیرا وقتی که حق را نمی‌گویی، بهتر است به آن گوش بسپاری."],[271,"ور بگویی شکل استفسار گو","با شهنشاهان تو مسکین‌وار گو","اگر بخواهی به شکل سوالی صحبت کنی، با بزرگان و پادشاهان باید به حالت نیاز و فروتنی صحبت کنی."],[271,"ابتدای کبر و کین از شهوت است","راسخی شهوتت از عادت است","ریشه کبر و دشمنی انسان ناشی از هوس و شهوت اوست و این استحکام و ثبات هوس به عادت‌ها و رفتارهای او بستگی دارد."],[271,"چون ز عادت گشت محکم خوی بد","خشم آید بر کسی که‌ت واکشد","وقتی عادت بد در انسان ریشه‌دار می‌شود، او به خاطر خشمش بر کسی که می‌خواهد او را از آن عادت بد رها کند، خشمگین می‌شود."],[271,"چونک تو گل‌خوار گشتی هر که‌او","واکشد از گل تو را، باشد عدو","وقتی تو به گل‌خوری عادت کردی، هر کسی که بخواهد تو را از گل بیرون بیاورد، دشمن تو خواهد بود."],[271,"بت‌پرستان چونک گرد بت تنند","مانعان راه خود را دشمن‌اند","بت‌پرستان وقتی به بت‌ها می‌چسبند و به پرستش آن‌ها مشغول می‌شوند، در واقع خود را از رسیدن به هدف‌هایشان باز می‌دارند و کسانی که مانع راهشان هستند، دشمنان خود به حساب می‌آورند."],[271,"چونک کرد ابلیس خو با سروری","دید آدم را حقیر او از خری","چون ابلیس با حسادت به سروری آدم، او را حقیر و پست شمرد و خود را در برابر او کوچک دید."],[271,"که به از من سروری دیگر بود‌؟!","تا که او مسجود چون من کس شود‌؟!‌","آیا کسی بهتر از من وجود دارد؟ آن‌که او باید سجده‌اش کنند، آیا هیچ‌کس به پای او می‌رسد؟"],[271,"سروری زهرست جز آن روح را","کاو بود تریاق‌لانی ز ابتدا","سروری و مافوقی به جز آن روح نیست که در ابتدا، مایه‌ی درمان (تریاق) تمام زهرها و مشکل‌هاست."],[271,"کوه اگر پر مار شد باکی مدار","کاو بود اندر درون تریاق‌زار","اگر کوهی پر از مار باشد، نگران نباش؛ زیرا در درون آن، تریاق‌زار (محلی که داروهای شفابخش در آن‌جا وجود دارد) وجود دارد و می‌تواند خطر را برطرف کند."],[271,"سروری چون شد دماغت را ندیم","هر که بشکستت شود خصم قدیم","زمانی که برتری و سروری تو زیاد می‌شود، احتیاط کن که هر کسی که به تو نزدیک می‌شود ممکن است در واقع دشمن قدیمی‌ات باشد که در حال تدارک خیانت است."],[271,"چون خلاف خوی تو گوید کسی","کینه‌ها خیزد تو را با او بسی","وقتی کسی برخلاف فطرت و ویژگی‌های تو سخن بگوید، دلایل و کینه‌های زیادی از درون تو علیه او به‌وجود می‌آید."],[271,"که مرا از خوی من بر می‌کند","خویش را بر من چو سرور می‌کند","کسی که صفات ناپسندش از وجود من دور می‌شود، خود را برتر از من می‌داند و مانند یک سرور با من رفتار می‌کند."],[271,"چون نباشد خوی بد سرکش درو","کی فروزد از خلاف آتش درو‌؟","آن‌گاه که خوی سرکشی و غرور در او نباشد، کی آتش خشمش فروزان می‌شود؟ وقتی‌که خلاف میل خود می‌بیند."],[271,"با مخالف او مدارایی کند","در دل او خویش را جایی کند","با کسی که مخالف توست، نرمش و مدارا نکن، زیرا در دل او، خوی واقعی‌اش را پنهان کرده است."],[271,"زانک خوی بد نگشته‌ست استوار","مور شهوت شد ز عادت همچو مار","چونکه طبیعت بد انسان به‌راستی به‌صورت راسخ در نیامده، شهوات او مانند موری شده که به عادت، به مار تبدیل گشته است."],[271,"مار شهوت را بکش در ابتلا","ورنه اینک گشت مارت اژدها","شهوات و تمایلات نادرست را در آغاز کنترل کن، زیرا اگر آنها را رها کنی، به مانند اژدهایی خطرناک و بزرگ می‌شوند که کنترلی بر آنها نخواهی داشت."],[271,"لیک هر کس مور بیند مار خویش","تو ز صاحب‌دل کن استفسار خویش","هر کسی که به جای مار خود، مور می‌بیند، باید از صاحب‌دل، یعنی کسی که دلش روشن است و تجربه بیشتری دارد، درباره وضعیت خودش سوال کند."],[271,"تا نشد زر مس نداند من مسم","تا نشد شه دل نداند مفلسم","تا زمانی که طلا به مس تبدیل نشود، کسی نمی‌داند که من مس هستم؛ همچنین تا زمانی که دل پادشاه به عشق گرفتار نشود، نمی‌داند من چگونه بی‌نوا هستم."],[271,"خدمت اکسیر کن مس‌وار تو","جور می‌کش ای دل از دلدار تو","ای دل، به خدمت عشق مانند اکسیر (طلایاب)، همان‌گونه که مس به طلا تبدیل می‌شود، سعی کن از دلدار خود (عاشق یا محبوب) آرزو و عشق را بکشانی و به عمل تبدیل کنی."],[271,"کیست دلدار‌؟ اهل دل، نیکو بدان","که چو روز و شب جهانند از جهان","ای اهل دل، به خوبی بدانید که محبوب واقعی، همانند روز و شب در جهان وجود دارد و به هیچ وجه از آن جدا نمی‌شود."],[271,"عیب کم گو بنده الله را","متهم کم کن به دزدی شاه را","عیب کسی را که بنده خداست، کم بگو و او را به دزدی متهم نکن، چرا که در این دنیا خیلی‌ها تنها به خاطر یادآوری مختصر، مورد اتهام قرار می‌گیرند."],[272,"بود درویشی درون کشتیی","ساخته از رخت مردی پشتیی","یک درویش در یک کشتی (قایق) بود که از لنگه‌های لباس یک مرد ساخته شده بود."],[272,"یاوه‌شد همیان زر او خفته بود","جمله را جستند و او را هم نمود","همه حاضران در کشتی، همیان زر (کیسه طلا) آن درویش را که خوابیده بود، پیدا کردند و او را نیز به بهانه آن سرزنش کردند."],[272,"کاین فقیر خفته را جوییم هم","کرد بیدارش ز غم صاحب‌درم","این فقیر که خوابش برده بود، ما را بیدار کرد تا از غم و اندوه صاحب‌درم (محمود) رهایی یابیم."],[272,"که درین کشتی حرمدان گم شده‌ست","جمله را جستیم نتوانی تو رست","در این کشتی، حرمدان (افرادی که به خدا و حقیقت نزدیکند) گم شده‌اند و ما نتوانستیم آنها را پیدا کنیم؛ بنابراین تو نمی‌توانی (به تنهایی) به رهایی و نجات برسی."],[272,"دلق بیرون‌کن برهنه شو ز دلق","تا ز تو فارغ شود اوهام خلق","برزنده از دلق (ردای درویش‌ها) بیرون بیا و برهنه شو تا خیالات و تصورات مردم را از خود دور کنی و از آن‌ها آزاد شوی."],[272,"گفت یا رب مر غلامت را خسان","متهم کردند فرمان در رسان","درویش از خداوند می‌خواهد که به او توجه کند زیرا عده‌ای ناامید و بدخواه او را به ناحق متهم کرده‌اند و از او می‌خواهد که در این مورد حکم و فرمانی صادر کند."],[272,"چون به‌درد آمد دل درویش از آن","سر برون کردند هر سو در زمان","چون دل درویش به خاطر اتهام خسان دردی کشید، او را از آنجا بیرون کردند و به هر طرف فرستادند."],[272,"صد هزاران ماهی از دریای ژرف","در دهان هر یکی دری شگرف","در میان دریای عمیق و وسیع، هزاران ماهی وجود دارند که هر کدام یک گوهر بزرگ و ارزشمند در دهان دارند."],[272,"صد هزاران ماهی از دریای پر","در دهان هر یکی در و چه در","دریای پر از موجودات و نعمت‌هاست و هر ماهی در دهان خود یک مروارید ارزشمند دارد. به این معنا که در دل وسعت و عمق زندگی، هر موجودی دارایی خاص و باارزشی دارد."],[272,"هر یکی دری خراج ملکتی","کز الهست این ندارد شرکتی","هر یک از آن گوهرها، مالی است که به سرزمین دیگری تعلق دارد و این گهرها در این دریا (دریای وجود) وجود ندارند."],[272,"در چند انداخت در کشتی و جست","مر هوا را ساخت کرسی و نشست","درهایی که در کشتی انداخت، به سبب جست‌وجو و تلاشش، موجب ساختن مکانی برای نشستن در آسمان شد."],[272,"خوش مربع چون شهان بر تخت خویش","او فراز اوج و کشتی‌اش به‌پیش","خوشی و زیبایی او مانند شاهان است که بر تخت نشسته‌اند و او در بالاترین مقام خود قرار دارد و کشتی‌اش در حرکت است."],[272,"گفت رو کشتی شما را حق مرا","تا نباشد با شما دزد گدا","خداوند فرمود: کشتی شما را به من بسپارید تا دزد و فقیری با شما همراه نشود و خطر برطرف گردد."],[272,"تا که را باشد خسارت زین فراق‌‌؟!","من خوشم جفت حق و با خلق طاق","این جدایی به چه کسی ضرر می‌زند؟ من خوشبختم که از حقیقت بهره‌مندم و با مردم در ارتباط هستم."],[272,"نه مرا او تهمت دزدی نهد","نه مهارم را به غمازی دهد","من نه متهم به دزدی می‌شوم و نه کسی این‌قدر نفوذ دارد که مرا به جاسوسی و غیبت محکوم کند."],[272,"بانگ کردند اهل کشتی کای همام","از چه دادندت چنین عالی‌مقام‌‌؟","سخنگویان کشتی با صدای بلند از همام می‌پرسند که به چه دلیلی به او این مقام بلند مرتبه داده‌اند."],[272,"گفت از تهمت نهادن بر فقیر‌‌‌‌!","وز حق‌آزاری پی چیزی حقیر‌‌‌‌‌‌‌!","او می‌گوید که به خاطر تهمت زدن به فقیران و آسیب رساندن به آنها به خاطر چیزهای بی‌اهمیت، نباید کسی را سرزنش کرد."],[272,"حاش لله بل ز تعظیم شهان","که نبودم در فقیران بدگمان","به خدا قسم، نه به خاطر تهمت بر فقیران، بلکه از روی بزرگ‌داشت پادشاهان، به هیچ‌وجه بدگمان نیستم."],[272,"آن فقیران لطیف خوش‌نفس","کز پی تعظیمشان آمد عبس","فقیران نرم و با نفس‌های خوش که به‌خاطر احترام آنها، مردی عبوس و جدی شده است."],[272,"آن فقیری بهر پیچاپیچ نیست","بل پی آن که به جز حق هیچ نیست","این فقیر به خاطر درگیری‌ها و حواشی بی‌مورد نیست، بلکه هدفش تنها این است که به جز حقیقت، چیز دیگری را نبیند و دنبال نکند."],[272,"متهم چون دارم آنها را که حق‌","کرد امین مخزن هفتم طبق","من چون حق را دارم و او را امین می‌دانم، نمی‌توانم به آنچه مردم در مورد خودم می‌گویند توجه کنم؛ زیرا من در گنجینه‌ای از حقیقت قرار دارم."],[272,"متهم نفس است نی عقل شریف","متهم حس است نه نور لطیف","متهم در اینجا نفس آدمی است، نه عقل والایی که باید از آن تبعیت کرد. همچنین، متهم کردن حس، به‌معنای نادیده گرفتن نور لطیف و حقیقتی است که در آن وجود دارد."],[272,"نفس سوفسطایی آمد می‌زنش","کش زدن سازد نه حجت گفتنش","نفس که در اینجا به عنوان موجودی فریبکار و حیله‌گر توصیف شده، مانند سوفسطاییان (که به دلیل فریبکاری در گفتار شناخته می‌شوند) عمل کرده و به جای ارائه دلیل و برهان، فقط به زدن می‌پردازد، یعنی در بحث و جدل فقط صدا و Noise ایجاد می‌کند و حقیقی ندارد."],[272,"معجزه بیند فروزد آن زمان","بعد از آن گوید خیالی بود آن","معجزه‌ای را که در آن زمان دیده است، بعد از آن می‌گوید که آن فقط یک خیال بوده و واقعیت نداشته است."],[272,"ور حقیقت بود آن دید عجب","چون مقیم چشم نامد روز و شب","اگر آنچه را که او (درویش) دیده، واقعی باشد، شگفت‌انگیز است؛ زیرا او همیشه در نظر پاکان حاضر است و نه در نظر کسانی که چشم‌هاشان به امور مادی معطوف است."],[272,"آن مقیم چشم پاکان می‌بود","نی قرین چشم حیوان می‌شود","آن کسی که همیشه در نظر پاکان است، مانند آن نیست که با چشم‌های حیوانی ارتباط داشته باشد."],[272,"کان عجب زین حس دارد عار و ننگ","کی بود طاووس اندر چاه تنگ‌‌‌‌؟!‌","عجب اینجاست که این حس و احساس عار و ننگ دارد، آیا طاووس (پرنده‌ای با زیبایی و وقار) در چاه تنگ می‌تواند وجود داشته باشد؟ این اشاره به تناقض وجود زیبایی و مقام‌های عالی در شرایط نامناسب است."],[272,"تا نگویی مر مرا بسیارگو","من ز صد یک گویم و آن همچو مو","اگر نگویی که من زیاد حرف می‌زنم، من از صد بار تنها یک بار می‌گویم و آن هم به اندازه یک مو است."],[273,"صوفیان بر صوفیی شنعه زدند","پیش شیخ خانقاهی آمدند","صوفیان به صوفی‌ای که به شیخ نزدیکی دارد، انتقاد کردند و درباره‌اش در محفل خانقاه صحبت کردند."],[273,"شیخ را گفتند داد جان ما","تو ازین صوفی بجو ای پیشوا","به شیخ، پیشوای روحانی، گفتند که جان ما را از این صوفی بگیر و برای ما کمک کن."],[273,"گفت آخر چه گله‌ست ای صوفیان","گفت این صوفی سه خو دارد گران","صوفیان از یکدیگر می‌پرسند که این شخص (صوفی) چرا ناراحت است و او پاسخ می‌دهد که این صوفی دارای سه ویژگی منفی و سنگین است که او را به دردسر می‌اندازند."],[273,"در سخن بسیارگو همچون جرس","در خورش افزون خورد از بیست کس","سخن کسی که خیلی حرف می‌زند مانند زنگوله‌ای است که صدایش زیاد است؛ او در گفتگو بیشتر از بیست نفر سخن می‌گوید و این نشان‌دهنده‌ی کم‌عمق بودنش است."],[273,"ور بخسپد هست چون اصحاب کهف","صوفیان کردند پیش شیخ زحف","اگر صوفیان با سکوت و آرامش به خواب بروند، مانند اصحاب کهف (که در داستان‌هایی خواب طولانی کشیدند)، بر سرشان پیش شیخ (رهبر صوفیان) حرف‌ها زدند و از آن‌ها پیش شیخ بدگویی کردند."],[273,"شیخ رو آورد سوی آن فقیر","که ز هر حالی که هست اوساط گیر","شیخ به سوی آن فقیر توجه کرد که در هر حالتی، اعتدال را رعایت می‌کند."],[273,"در خبر خیر الامور اوساطها","نافع آمد ز اعتدال اخلاطها","در اخبار آمده که بهترین کارها در میانه‌روی است و این میانه‌روی باعث سلامتی و فایده‌مندی مخلوط‌ها (اخلاط) می‌شود."],[273,"گر یکی خلطی فزون شد از عرض","در تن مردم پدید آید مرض","اگر یکی از مزاج‌ها در بدن انسان از حد طبیعی زیاد شود، به سبب آن در بدن بیماری بروز می‌کند."],[273,"بر قرین خویش مفزا در صفت","کان فراق آرد یقین در عاقبت","اگر کسی در صفات خود، مانند خویش‌داری و محبت، از دیگران پیشی گیرد، در نهایت این پیشی‌گیری باعث می‌شود که به یقین به جدایی و فراق دچار شود."],[273,"نطق موسی بد بر اندازه ولیک","هم فزون آمد ز گفت یار نیک","نطق موسی (سخن گفتن موسی) در اندازه خود خوب بود، اما سخن دوست نیکو (یار نیک) از آن هم بیشتر و بهتر بود."],[273,"آن فزونی با خضر آمد شقاق","گفت رو تو مکثری هذا فراق","این بیت بیان می‌کند که آن حجم و افزونی (گفتار) به خضر (پیکر معنوی و راهنمای عرفان) رسید و او گفت: \"تو (ای مولانا) دنباله‌رو (یا پراکنده‌گویی) هستی، پس به جدایی (فراق) می‌رسیم."],[273,"موسیا بسیارگویی دور شو","ور نه با من گنگ باش و کور شو","ای موسی، از زیاد حرف زدن دوری کن، وگرنه با من در سکوت باقی خواهی ماند و مانند کسی نابینا و ناشنوا خواهی شد."],[273,"ور نرفتی وز ستیزه شسته‌ای","تو به معنی رفته‌ای بگسسته‌ای","اگر از عداوت و خصومت خود دور نشده‌ای و در صلح و صفا نبوده‌ای، پس در واقع از معنای واقعی رفته‌ای و به نوعی خود را از آن جدا کرده‌ای."],[273,"چون حدث کردی تو ناگه در نماز","گویدت سوی طهارت رو بتاز","اگر در وسط نماز حدثی (مثل بی‌وضو شدن) برایت پیش بیاید، به تو می‌گوید که سریعا به سمت طهارت (وضو یا غسل) بروی."],[273,"ور نرفتی خشک خنبان می‌شوی","خود نمازت رفت پیشین ای غوی","اگر در حالت خشک و بی‌حال بایستی و نتوانی به طهارت بروی، نمازی که خوانده‌ای به دلیل ناامیدی و بی‌اشتیاق تو، قبول نمی‌شود."],[273,"رو بر آنها که هم‌جفت توند","عاشقان و تشنه گفت توند","به کسانی نگاه کن که همواره به عشق و محبت نزدیک‌اند و در پی کلام و محبتند."],[273,"پاسبان بر خوابناکان بر فزود","ماهیان را پاسبان حاجت نبود","پاسبان یا نگهبان بر کسانی که در خوابند، فزونی می‌آورد، ولی برای ماهی‌ها نگهبانی در تأمین نیازها و ضرورت‌ها وجود ندارد. به عبارتی، نگهبانی برای کسانی که غفلت کرده‌اند، بی‌فایده است، همان‌طور که ماهی‌ها به پاسبانی نیازی ندارند."],[273,"جامه‌پوشان را نظر بر گازرست","جان عریان را تجلی زیورست","جامه‌پوشان به افرادی اشاره دارد که در ظاهر خود را آراسته‌اند، اما گازرست (بخشی از جان) یعنی حقیقت روحانی را نمی‌بینند؛ در حالی که جان عریان (بی‌پوشش) خود را با نور و تجلی زیور الهی آراسته می‌کند. به عبارت دیگر، کسانی که در لباس ظاهر خود مانده‌اند نمی‌توانند زیبایی معنوی را درک کنند."],[273,"یا ز عریانان به یکسو باز رو","یا چو ایشان فارغ از تنجامه شو","یا به سوی عریان‌ها برو و آنها را انتخاب کن، یا مانند آنها از قید لباس و بدن راحت شده و بی‌نیاز از ظاهر شو."],[273,"ور نمی‌توانی که کل عریان شوی","جامه کم کن تا ره اوسط روی","اگر نمی‌توانی کاملا از جسم خود رها شوی و عریان شوی، حداقل لباس خود را کم کن تا به راه میانه و صحیح برسید."],[274,"پس فقیر آن شیخ را احوال گفت","عذر را با آن غرامت کرد جفت","فقیر احوال خود را برای شیخ تعریف کرد و عذرش را به همراه عوض و جبران آن بیان کرد."],[274,"مر سؤال شیخ را داد او جواب","چون جوابات خضر خوب و صواب","فقیر به سؤال شیخ پاسخ داد، همان‌طور که خضر نیز پاسخ‌های درست و مناسبی داشت."],[274,"آن جوابات سؤالات کلیم","کش خضر بنمود از رب علیم","جواب‌های آن سوالات که به وسیله خضر (پیامبر) داده شد، از علم و دانایی خداوند (علیم) نشئت گرفته و نشان‌دهنده‌ی حکمت و بزرگی اوست."],[274,"گشت مشکلهاش حل وافزون ز یاد","از پی هر مشکلش مفتاح داد","مشکلات او حل و فصل شد و بر علم و آگاهی‌اش افزوده گشت، زیرا به یاد هر مشکلش کلید حل آن را پیدا کرد."],[274,"از خضر درویش هم میراث داشت","در جواب شیخ همت بر گماشت","این بیت بیان می‌کند که درویش (فقیر) از خضر (پیشوای عرفانی) نیز به ارث برده، و در پاسخ به شیخ (استاد دین) همت و تلاش خود را به کار می‌گیرد. در واقع، او از رهنمودهای خضر بهره‌مند شده و به شیخ نشان می‌دهد که با استفاده از آن میراث، در مسیر خود پیشرفت کرده است."],[274,"گفت راه اوسط ارچه حکمتست","لیک اوسط نیز هم با نسبتست","گفت هر چند که راه میانه حکمت است، اما این راه میانه هم به نسبتی وابسته است و به معنای خاصی اشاره دارد."],[274,"آب جو نسبت باشتر هست کم","لیک باشد موش را آن همچو یم","آب جو از نظر نسبت و کیفیت بهتر است، اما اگر کم باشد، موش هم آن را مانند دریا نمی‌بیند و نمی‌تواند از آن بهره‌برداری کند."],[274,"هر که را باشد وظیفه چار نان","دو خورد یا سه خورد هست اوسط آن","هرکسی که وظیفه‌اش تأمین معیشت چهار نفر باشد، اگر دو یا سه بار غذا بخورد، در میانه راه است و از عدالت خارج نمی‌شود."],[274,"ور خورد هر چار دور از اوسط است","او اسیر حرص مانند بط است","اگر کسی فراتر از اندازه تعیین‌شده نان بخورد، او به نوعی گرفتار حرص و طمع شده است، مانند بط که هرچه بیشتر بخورد، همچنان تشنه و طمعکار باقی می‌ماند."],[274,"هر که او را اشتها ده نان بود","شش خورد می‌دان که اوسط آن بود","هر کسی که میلی به خوردن ده نان دارد، اگر شش نان بخورد، یعنی در میانه نیاز خود قرار دارد."],[274,"چون مرا پنجاه نان هست اشتها","مر تو را شش گرده هم‌دستیم نی","من چون پنجاه نان دارم و اشتها دارم، تو هم که شش گرده نان داری، نمی‌توانی با من هم‌دست باشی و در این زمینه برابر باشی."],[274,"تو به ده رکعت نماز آیی ملول","من به پانصد در نیایم در نحول","تو هم ممکن است ده رکعت نماز به شوق و با دل‌زدگی بخوانی، اما من به علت فقر و مشکلاتم، حتی به پانصد در هم نمی‌توانم بیایم."],[274,"آن یکی تا کعبه حافی می‌رود","وین یکی تا مسجد از خود می‌شود","یکی از افراد به سوی کعبه می‌رود تا به مقام والایی دست یابد (حافی به معنای خائف و ترسان است)، در حالی که فرد دیگری به سوی مسجد می‌رود تا خود را به نیکی نشان دهد."],[274,"آن یکی در پاک‌بازی جان بداد","وین یکی جان کند تا یک نان بداد","یک نفر در راه رسیدن به پاکی و کمال، جان خود را فدای این هدف کرده است، ولی نفر دیگری برای به دست آوردن یک نان، جان خود را به زحمت می‌اندازد."],[274,"این وسط در با نهایت می‌رود","که مر آن را اول و آخر بود","این وسط، یعنی میان زندگی، به نهایت و سرانجام می‌رسد، زیرا هر چیزی در ابتدا و انتهای خود قرار دارد."],[274,"اول و آخر بباید تا در آن","در تصور گنجد اوسط یا میان","وجود اول و آخر لازم است تا بتوان در آن فضای میان را تصور کرد، زیرا بدون این دو، مفهوم میانه قابل درک نیست."],[274,"بی‌نهایت چون ندارد دو طرف","کی بود او را میانه منصرف","چون بی‌نهایت دو طرف ندارد، پس نمی‌توان برای آن جایی وسطی تصور کرد."],[274,"اول و آخر نشانش کس نداد","گفت لو کان له البحر مداد","هیچ‌کس نتوانسته است ویژگی‌های اولیه و نهایی این علم (یا حقیقت) را بیان کند و بگوید که اگر دریا هم مرکب باشد، باز هم این علم پایانی ندارد."],[274,"هفت دریا گر شود کلی مداد","نیست مر پایان شدن را هیچ امید","اگر تمام هفت دریا هم تبدیل به مداد شود، باز هم برای نوشتن این سخن کافی نیست، زیرا پایان این موضوع هرگز امیدی ندارد."],[274,"باغ و بیشه گر بود یکسر قلم","زین سخن هرگز نگردد هیچ کم","اگر تمام باغ‌ها و جنگل‌ها هم به عنوان قلم در نظر گرفته شوند، باز هم از این گفته هیچ چیز کمتر نخواهد شد."],[274,"آن همه حبر و قلم فانی شود","وین حدیث بی‌عدد باقی بود","تمام نوشته‌ها و آثار مادی در نهایت از بین می‌روند، اما این سخن و حقیقتی که بیان می‌شود، همیشگی و باقی خواهد ماند."],[274,"حالت من خواب را ماند گهی","خواب پندارد مر آن را گم‌رهی","حالت من شبیه خواب است و گاهی به نظر می‌رسد که در حال خواب هستم، در حالی که شاید این خواب، مرا به راهی که باید بروم، راهنمایی کند."],[274,"چشم من خفته دلم بیدار دان","شکل بی‌کار مرا بر کار دان","چشم من بسته و خواب است، اما دلم بیدار و هوشیار است؛ بنابراین آنچه که به نظر می‌رسد بی‌فایده و بی‌کار است، در واقع هدف و معنایی دارد."],[274,"گفت پیغامبر که عینای تنام","لا ینام قلبی عن رب الانام","پیامبر گفت که چشم‌های ظاهری خواب می‌رود، اما قلبی که به یاد خداوند بزرگ است، هرگز به خواب نمی‌رود."],[274,"چشم تو بیدار و دل خفته بخواب","چشم من خفته دلم در فتح باب","چشم تو بیدار است و دل تو خوابیده، در حالی که چشم من خواب است ولی قلبم در حال گشایش و درک معانی جدید است."],[274,"مر دلم را پنج حس دیگرست","حس دل را هر دو عالم منظرست","دل من دارای پنج حس دیگر نیز هست و حس دل به من نمایی از دو جهان می‌دهد."],[274,"تو ز ضعف خود مکن در من نگاه","بر تو شب بر من همان شب چاشتگاه","نگران ضعف و ناتوانی خود نباش و بر من نگاه مکن، زیرا برای تو شب است و برای من همان شب صبحگاه است، یعنی برای من هم هنوز روز روشن نشده است."],[274,"بر تو زندان بر من آن زندان چو باغ","عین مشغولی مرا گشته فراغ","زندانی که تو در آن به سر می‌بری، برای من مانند باغی است پر از عشق و زیبایی. در واقع، در حالی که تو مشغول در بندیت هستی، من از آن آزاد شده‌ام و احساس راحتی و آزادی می‌کنم."],[274,"پای تو در گل، مرا گل گشته گل","مر تو را ماتم مرا سور و دهل","پای تو در گل است و تو در درد و رنج به سر می‌بری، اما من از این وضعیت به خود گل و شادی تبدیل شده‌ام. در حالی که تو غمگینی، من در حال شادی و سرورم."],[274,"در زمینم با تو ساکن در محل","می‌دوم بر چرخ هفتم چون زحل","من در زمین با تو زندگی می‌کنم و در این حال به‌خاطر تو از زمین فراتر می‌روم و مانند زحل، سیاره‌ای در آسمان، در مرتبه‌ای بالاتر قرار می‌گیرم."],[274,"همنشینت من نیم سایه من است","برتر از اندیشه‌ها پایه من است","دوست همراه تو من نیستم، بلکه سایه‌ام بالاتر از اندیشه‌های تو و اساس وجودم است."],[274,"زانک من ز اندیشه‌ها بگذشته‌ام","خارج اندیشه پویان گشته‌ام","زیرا من از فکر و اندیشه‌ها فرا رفته‌ام و از آن‌ها دور شده‌ام، به جایی رسیده‌ام که به فراتر از اندیشه‌ها می‌روم."],[274,"حاکم اندیشه‌ام محکوم نی","زانک بنّا حاکم آمد بر بنا","فکر و اندیشه‌ام بر من مسلط نیست و من برده آن‌ها نیستم، چون مثل یک بنا، خودم بر افکار و اندیشه‌هایم حاکم هستم."],[274,"جمله خلقان سخره اندیشه‌اند","زان سبب خسته دل و غم‌پیشه‌اند","همه مردم ابزار اندیشه هستند و به همین خاطر دلشان شکسته و غمگینند."],[274,"قاصدا خود را به اندیشه دهم","چون بخواهم از میانشان بر جهم","من تصمیم دارم که خود را به فکر و اندیشه بسپارم، زیرا وقتی بخواهم از میان آنها (مردم) جدا شوم، باید به جمع‌آوری افکار و احساسات خود بپردازم."],[274,"من چو مرغ اوجم اندیشه مگس","کی بود بر من مگس را دست‌رس","من مانند پرنده‌ای در اوج آسمان هستم و نمی‌توانم به مگس‌ها (اشاره به مشکلات کوچک و ناچیز) توجه کنم، چرا که آن‌ها به من دسترسی ندارند."],[274,"قاصدا زیر آیم از اوج بلند","تا شکسته‌پایگان بر من تنند","من قصد دارم از اوج بلندی به زمین پایین بیایم تا افرادی که ضعیف و شکست‌پایه هستند بتوانند به من نزدیک شوند و از من بهره‌مند گردند."],[274,"چون ملالم گیرد از سفلی صفات","بر پرم همچون طیور الصافات","وقتی که از ویژگی‌های ناپسند و پایین دچار خستگی و ملال می‌شوم، پرم شبیه پرنده‌های با صفات خوب و بلند می‌شود."],[274,"پر من رسته‌ست هم از ذات خویش","بر نچفسانم دو پر من با سریش","پر من به خاطر ذات خودم رسته است و من نباید آن را به سستی به هم بچسبانم، یعنی نباید از آن خارج شوم یا به آن وابسته شوم."],[274,"جعفر طیار را پر جاریه‌ست","جعفر طرار را پر عاریه‌ست","جعفر طیار (یکی از شخصیت‌های تاریخی و مذهبی) پرواز می‌کند به کمک بال‌های فرشته با قدرت الهی، اما جعفر طرار (ظاهرا به فردی دیگر اشاره دارد) فقط به وسیله بال‌های قرضی و عاریه‌ای پرواز می‌کند، که نشان‌دهنده‌ی ضعف و ناتوانی اوست."],[274,"نزد آنک لم یذق دعویست این","نزد سکان افق معنیست این","این بیت به این معناست که در نزد کسی که تجربه‌ای از حقیقت ندارد، ادعا کردن بی‌معناست، اما برای کسی که به درک عمیق رسیده، این ادعا دروازه‌ای به معنا و فهم عمیق‌تری از جهان است."],[274,"لاف و دعوی باشد این پیش غراب","دیگ تی و پر یکی پیش ذباب","این‌که ادعای بزرگ و لاف زدن در برابر کسانی که ارزش آن را ندارند، مانند این است که در برابر مگس‌ها به نمایش دیگ پر از خوراک بپردازی."],[274,"چونک در تو می‌شود لقمه گهر","تن مزن چندانک بتوانی بخور","هرگاه در وجود تو لقمه‌ای از گوهر (نعمت‌های ارزشمند) پدید می‌آید، تا آنجا که امکان دارد، این نعمت را در اختیار دیگران قرار نده و در خود نگه‌دار."],[274,"شیخ روزی بهر دفع سؤ ظن","در لگن قی کرد پر در شد لگن","شیخ برای رفع سوءظن کسان، در ظرفی که پر از در است، دست کرد."],[274,"گوهر معقول را محسوس کرد","پیر بینا بهر کم‌عقلی مرد","پیر دانا (شیخ) گوهرهای معنوی و ارزشمند را به شکل محسوس و قابل درک برای انسان‌ها نشان می‌دهد، تا به دلیلی که ناشی از کم‌عقلی برخی مردان است، آنها این ارزش‌ها را درک کنند."],[274,"چونک در معده شود پاکت پلید","قفل نه بر حلق و پنهان کن کلید","وقتی که در معده انسان، چیز پاک و ناپاک داخل شود، قفل بر گلو ندارد و می‌توان کلید را پنهان کرد. یعنی اگر چیزی درون بدن خالص و درست باشد، دیگر نیازی به نگرانی از مسائل ظاهری نیست."],[274,"هر که در وی لقمه شد نور جلال","هر چه خواهد تا خورد او را حلال","هر کسی که در وجودش لقمه‌ای از نور جلال الهی باشد، هر چیزی که بخواهد برای او حلال است و می‌تواند آن را بخورد."],[275,"گر تو هستی آشنای جان من","نیست دعوی گفت معنی‌لان من","اگر تو آشنای جان من هستی، پس چطور ادعای دوستی و نزدیکی من به تو را رد می‌کنی؟"],[275,"گر بگویم نیم‌شب پیش توام","هین مترس از شب که من خویش توام","اگر بگویم نیمه‌شب در کنار تو هستم، نترس از شب، چون من هم یکی از خودت هستم."],[275,"این دو دعوی پیش تو معنی بود","چون شناسی بانگ خویشاوند خود","این دو ادعا که از طرف من به تو گفته می‌شود، فقط در زمانی معنا دارد که تو صدای خویشان خود را بشناسی."],[275,"پیشی و خویشی دو دعوی بود لیک","هر دو معنی بود پیش فهم نیک","پیشی (نسبت فامیلی) و خویشی (دوستی) دو ادعا هستند، اما هر دو به درستی معنای خود را درک نمی‌کنند و فقط از روی درک صحیح می‌توان به حقیقت آن‌ها پی برد."],[275,"قرب آوازش گواهی می‌دهد","کین دم از نزدیک یاری می‌جهد","نزدیکی آواز او نشانه‌ای است که می‌گوید، چون او از نزدیک صدایش را بلند می‌کند، در واقع یاری و دوستی را به نمایش می‌گذارد."],[275,"لذت آواز خویشاوند نیز","شد گوا بر صدق آن خویش عزیز","لذت صدای خویشاوند، خود نیز به عنوان شاهدی بر حقیقت و صداقت او عمل می‌کند."],[275,"باز بی الهام احمق کو ز جهل","می‌نداند بانگ بیگانه ز اهل","احمق که به الهام دست نمی‌یابد، از نادانی خود نمی‌تواند تشخیص دهد که صدای بیگانه (غیرآشنا) از صدای اهل (آشنا) متفاوت است."],[275,"پیش او دعوی بود گفتار او","جهل او شد مایه انکار او","وقتی کسی نزد او (احمق) ادعایی می‌کند، گفتارش نشان‌دهنده نادانی و جهل اوست، و این جهل به دلیل نادرستی ادعا، سبب انکار سخن او می‌شود."],[275,"پیش زیرک کاندرونش نورهاست","عین این آواز معنی بود راست","زیرک (زیرک به معنای آدم فهیم و باهوش) در درون خود نورها و روشنایی‌هایی دارد، و همین صدای درون او به وضوح مفهوم واقعی را بیان می‌کند."],[275,"یا به تازی گفت یک تازی‌زبان","که همی‌دانم زبان تازیان","یک عربی‌زبان به زبان عربی گفت که من به خوبی زبان عرب‌ها را می‌دانم."],[275,"عین تازی گفتنش معنی بود","گرچه تازی گفتنش دعوی بود","گفتن زبان عربی به خودی خود نشان‌دهنده حقیقت و معنایی است، هرچند صرفا بر زبان آوردن آن می‌تواند ادعایی باشد."],[275,"یا نویسد کاتبی بر کاغذی","کاتب و خط‌خوانم و من امجدی","اگر نویسنده‌ای بر روی کاغذ بنویسد که من نویسنده و خط‌خوان هستم، او (نویسنده) باید به مقام و شأن من (امجد) اشاره کند و این نشان‌دهنده اعتبار اوست."],[275,"این نوشته گرچه خود دعوی بود","هم نوشته شاهد معنی بود","این نوشته هرچند خود به نوعی ادعاست، ولی در عین حال گواه بر حقیقت معنای آن نیز هست."],[275,"یا بگوید صوفیی دیدی تو دوش","در میان خواب سجاده‌بدوش","شاید خواب دیدی که صوفی‌ای در شب گذشته در خواب، سجاده را بر دوش دارد."],[275,"من بدم آن وآنچ گفتم خواب در","با تو اندر خواب در شرح نظر","من به حالت بد خود اشاره می‌کنم و آنچه را که در خواب درباره‌ات گفتم، بار دیگر در خواب و در شرح دیدگاه خودم با تو می‌گویم."],[275,"گوش کن چون حلقه اندر گوش کن","آن سخن را پیشوای هوش کن","به حرف من خوب گوش کن؛ مانند حلقه‌ای که در گوش است، این سخن را بپذیر و عاقلانه به آن توجه کن."],[275,"چون تو را یاد آید آن خواب این سخن","معجز نو باشد و زر کهن","وقتی که خواب تو را به یاد می‌آورد، این سخن معجزه‌ای تازه است و مانند طلا و جواهر قدیمی ارزشمند است."],[275,"گرچه دعوی می‌نماید این ولی","جان صاحب‌واقعه گوید بلی","هرچند ممکن است کسی ادعایی کند، اما جان صاحب‌واقعه (یعنی کسی که در واقع در آن خواب یا تجربه حضور داشته) به راست‌گویی و صداقت آن واقعه شهادت می‌دهد."],[275,"پس چو حکمت ضاله مؤمن بود","آن ز هر که بشنود موقن بود","اگر حکمت گمراه‌کننده‌ای از طرف مؤمن منتشر شود، هر کس که آن را بشنود، به یقین به آن ایمان خواهد آورد."],[275,"چونک خود را پیش او یابد فقط","چون بود شک چون کند او را غلط","وقتی کسی خود را در حضور خدا می‌بیند، نمی‌تواند به او شک کند و هیچ معنایی جز صداقت در او نمی‌بیند."],[275,"تشنه‌ای را چون بگویی تو شتاب","در قدح آبست بستان زود آب","وقتی به یک تشنه بگویی که به سرعت به سمت ظرف آب برود و آب را بخورد، او احساس می‌کند که نیاز او را درک کرده‌ای و به او کمک می‌کنی."],[275,"هیچ گوید تشنه کین دعویست رو","از برم ای مدعی مهجور شو","تشنگی سبب می‌شود که شخص تشنه هر ادعایی کند و در اینجا به او می‌گویند اگر چنین است، زودتر از من دور شو و با این ادعاهای بی‌اساس خود مزاحم نشو."],[275,"یا گواه و حجتی بنما که این","جنس آبست و از آن ماء معین","اگر مدعی هستی که تشنه‌ای، باید دلیل و شواهدی بیاوری که ثابت کند این آب مورد نظرت واقعا آب است و از منبع مشخصی به دست آمده."],[275,"یا به طفل شیر مادر بانگ زد","که بیا من مادرم هان ای ولد","مادر به طفلش که در حال شیر خوردن است، صدا می‌زند و او را دعوت می‌کند تا نزد او بیاید و توجهش را جلب کند."],[275,"طفل گوید مادرا حجت بیار","تا که با شیرت بگیرم من قرار","کودک می‌گوید: ای مادر، دلیلی بیاور تا با شیر تو برای آرامش و قرار خودم، به حقیقت آن پی ببرم."],[275,"در دل هر امتی کز حق مزه‌ست","روی و آواز پیمبر معجزه‌ست","در دل هر ملتی که از حقیقت الهی چیزی چشیده باشد، وجود پیامبر (محمد) نشانه‌ای شگفت‌انگیز است که معنای راستین را به آن‌ها می‌رساند."],[275,"چون پیمبر از برون بانگی زند","جان امت در درون سجده کند","وقتی پیامبر از بیرون صدایی را به گوش می‌رساند، جان مردم امت در درون‌شان به حالت سجده و فرمان‌برداری در می‌آید."],[275,"زانک جنس بانگ او اندر جهان","از کسی نشنیده باشد گوش جان","چون صدای او در دنیا از کسی دیگر شنیده نشده، گوش جان فقط به صدای او آشناست."],[275,"آن غریب از ذوق آواز غریب","از زبان حق شنود انی قریب","این فرد غریب (انسان) از شوق و ذوق صدای غریب (ندای الهی) را از زبان حقیقت می‌شنود و درک می‌کند که او نزدیک و نزدیک‌تر است."],[276,"مادر یحیی به مریم در نهفت","پیشتر از وضع حمل خویش گفت","مادر یحیی به مریم گفت که او قبل از زایمان خود، در دلش چیزی محسوس را تجربه کرده است."],[276,"که یقین دیدم درون تو شهیست","کو اولوا العزم و رسول آگهیست","من یقین کردم که درون تو، پادشاهی به دنیا می‌آید که از پیامبران بزرگ و صاحب عزم است و او را خبر دارم."],[276,"چون برابر اوفتادم با تو من","کرد سجده حمل من ای ذوالفطن","من زمانی که در برابر تو قرار گرفتم، سجده کردم. ای صاحب فطانت و درایت، این حالت حاملگی من است."],[276,"این جنین مر آن جنین را سجده کرد","کز سجودش در تنم افتاد درد","این جنین (عیسی علیه السلام) به جنین دیگر (یحیی علیه السلام) سجده کرد و از آن سجده باعث شد تا من در شکم خود درد کشیدم."],[276,"گفت مریم من درون خویش هم","سجده‌ای دیدم ازین طفل شکم","مریم می‌گوید در شکم خود سجده‌ای از جانب این کودک (عیسای مسیح) دیدم."],[277,"ابلهان گویند کین افسانه را","خط بکش زیرا دروغست و خطا","بسیاری از نادان‌ها می‌گویند که این داستان را کنار بگذارید، زیرا آن را دروغ و اشتباه می‌دانند."],[277,"زانک مریم وقت وضع حمل خویش","بود از بیگانه دور و هم ز خویش","زیرا مریم (مادر عیسی) در زمان زایمان خود از دیگران دور بود و تنها بود، نه به خاطر این‌که از خانواده‌اش دور باشد، بلکه به معنای این‌که از مردم بیگانه بود."],[277,"از برون شهر آن شیرین فسون","تا نشد فارغ نیامد خود درون","مریم، که در مجلس زایمانش از دیگران دور و تنها بود، تا زمانی که درد زایمانش تمام نشد و به آرامش نرسید، به درون شهر نیامد."],[277,"چون بزادش آنگهانش بر کنار","بر گرفت و برد تا پیش تبار","زمانی که مادر یحیی او را در هنگام زایمان در کناری گذاشت، او را برداشت و به سوی خانواده‌اش برد."],[277,"مادر یحیی کجا دیدش که تا","گوید او را این سخن در ماجرا","مادر یحیی چگونه او را دید که بتواند این سخن را در مورد ماجرا بگوید؟"],[278,"این بداند کانک اهل خاطرست","غایب آفاق او را حاضرست","مردم اگر اهل درک و تفکر باشند، می‌دانند که حقیقت وجودی آن‌ها فراتر از مرزها و مکان‌هاست و در هر جایی که باشند، حضور واقعی آن‌ها در عالم معنوی برقرار است."],[278,"پیش مریم حاضر آید در نظر","مادر یحیی که دورست از بصر","مادر یحیی، که مریم باشد، در حالی که یحیی (ع) از نظر دور است، او را در ذهن و خیال خود حاضر می‌بیند."],[278,"دیده‌ها بسته ببیند دوست را","چون مشبک کرده باشد پوست را","چشم‌ها بسته‌اند، اما دل و جان می‌توانند دوست (خدا) را ببینند، همان‌طور که اگر پوست (بدن) مشبک باشد، اجازه می‌دهد تا نور و روشنی به درون آن نفوذ کند."],[278,"ور ندیدش نه از برون نه از اندرون","از حکایت گیر معنی ای زبون","اگر کسی دوست را نه از خارج و نه از درون ببیند، باید از حکایت‌ها معنی را بگیرد، ای بی‌خبر."],[278,"نی چنان کافسانه‌ها بشنیده بود","همچو شین بر نقش آن چفسیده بود","او مانند کسی که داستان‌های شگفت‌انگیز را شنیده باشد، به شدت بر آن تصویر نقش بسته بود و در ذهنش حک شده بود."],[278,"تا همی‌گفت آن کلیله بی‌زبان","چون سخن نوشد ز دمنه بی بیان","کلیله، که به طور طبیعی نمی‌تواند صحبت کند، در اینجا به نقل داستان‌هایش مشغول است و حالتی شبیه به دمنه (شخصیت داستانی) پیدا کرده که بدون هیچ توضیح و عبارتی، سخنانش را فهمانده است."],[278,"ور بدانستند لحن همدگر","فهم آن چون مرد بی نطقی بشر","اگر شیر و گاو زبان یکدیگر را می‌فهمیدند، فهم آنها از آهنگ صداهای همدیگر مانند درک یک مردی می‌بود که نتواند سخن بگوید."],[278,"در میان شیر و گاو آن دمنه چون","شد رسول و خواند بر هر دو فسون","در میان شیر و گاو، دمنه به عنوان پیام‌آور ظاهر شد و با زبان عوام‌فریب خود هر کدام را مغلوب فریب و هنر خود کرد."],[278,"چون وزیر شیر شد گاو نبیل","چون ز عکس ماه ترسان گشت پیل","زمانی که دمنه، وزیر شیر، برای گاو با ادب و ملاحظه صحبت کرد، مثل این بود که فیل از تصویری از ماه بترسد. در اینجا، دمنه از هراس فیل به تصویر ماه و تأثیر آن بر گاو اشاره می‌کند."],[278,"این کلیله و دمنه جمله افتراست","ورنه کی با زاغ لک‌لک را مریست","این داستان کلیله و دمنه (کتاب داستان‌های寓言ی) همه‌اش افتراء و دروغ است؛ وگرنه چگونه ممکن است که زاغ (پرنده‌ای سیاه) با لک‌لک (پرنده‌ای سفید) دشمنی داشته باشد؟"],[278,"ای برادر قصه چون پیمانه‌ایست","معنی اندر وی مثال دانه‌ایست","داستان مانند پیمانه‌ای است که مفهوم درون آن همانند دانه‌ای است. یعنی عمق معنا و مضمون در این قصه نهفته است و باید به آن توجه کرد."],[278,"دانه معنی بگیرد مرد عقل","ننگرد پیمانه را گر گشت نقل","مرد عاقل فقط معنای واقعی داستان را درک می‌کند و به قالب ظاهری آن (پیمانه) توجهی نمی‌کند، حتی اگر روایت (نقل) تغییر کند."],[278,"ماجرای بلبل و گل گوش دار","گرچه گفتی نیست آنجا آشکار","ماجرای بلبل و گل را فراموش نکن، چرا که اگرچه ممکن است در ابتدا واضح به نظر نرسد، ولی حقیقت عمیقی در آن نهفته است."],[279,"ماجرای شمع با پروانه تو","بشنو و معنی گزین ز افسانه تو","ماجرای شمع و پروانه را بشنو و از داستان تو معنا و عبرت بگیر."],[279,"گرچه گفتی نیست سرّ گفت هست","هین به بالا پر مپر چون جغد پست","هرچند تو گفتی که هیچ راز و سرّی وجود ندارد، اما حقیقت این است که هست. پس مثل جغد که در پایین‌تری نقطه می‌نشیند، به سمت بالا نرو و بی‌جهت پر نزن."],[279,"گفت در شطرنج کین خانه رخ است","گفت خانه از کجاش آمد به دست؟","در بازی شطرنج می‌گوید که این مربع یک خانه رخ است، اما سؤال اینجاست که این خانه چگونه به دست آمده است؟"],[279,"خانه را بخرید یا میراث یافت؟","فرخ آنکس کو سوی معنی شتافت","آیا خانه را خریدند یا اینکه از طریق ارث به دست آوردند؟ خوشبخت کسی است که به سمت معنا و حقیقت آن حرکت کند."],[279,"گفت نحوی زید عمروا قد ضرب","گفت چونش کرد بی جرمی ادب","نحوی (گرامیدان) گفت که زید عمر را زده است، اما او به ناحق و به دلیل بی‌جرمی ادب زده شده است."],[279,"عمرو را جرمش چه بد کان زید خام","بی گنه او را بزد همچون غلام","جرم عمرو چه بود که زید، بدون هیچ دلیلی و بی‌گناهی، او را مانند یک بنده زده است."],[279,"گفت این پیمانه معنی بود","گندمی بستان که پیمانه‌ست رد","گفتند این پیمانه نماد معناست، اینکه مانند گندم به‌دست بیاوری، چرا که این پیمانه چیزی است که دلبستگی به آن موجب باطل شدن می‌شود."],[279,"زید و عمروا، ز بهر اعرابست و ساز","گر دروغست آن تو با اعراب ساز","زید و عمرو، نام‌هایی که برای نشان‌دادن حال اعراب به کار می‌روند، و اگر تو دروغ می‌گویی، باید با این اعراب سازگاری داشته باشی."],[279,"گفت نی من آن ندانم عمرو را","زید چون زد بی‌گناه و بی‌خطا","او می‌گوید من نمی‌دانم که چرا عمرو زید را به ناحق و بدون گناه و خطا زد."],[279,"گفت از ناچار و لاغی بر گشود","عمرو یک واو فزون دزدیده بود","عمرو به خاطر ناچاری و ضعفش، یک حرف (واو) به نام زید اضافه کرده بود، که این دزدیده شده است."],[279,"زید واقف گشت دزدش را بزد","چونک از حد برد او را حد سزد","زید متوجه شد که دزد او را زده است، چون دزد از حد خود تجاوز کرده و کاری کرده که سزاوار مجازات است."],[280,"گفت اینک راست پذرفتم به جان","کژ نماید راست در پیش کژان","گفت اکنون حقیقت را با جانم پذیرفته‌ام، اما راست را در برابر افرادی که نامناسب و کج‌رو هستند، کج جلوه می‌دهد."],[280,"گر بگویی احولی را: «مه، یکی‌ست»","گویدت: «این دوست و، در وحدت شکی‌ست»","اگر به کسی که دچار انحراف فکری است بگویی که «ماه یکی است»، او به تو پاسخ می‌دهد که «این دو هستند و در حقیقت وحدتی وجود ندارد»، یعنی او توانایی درک حقیقت واحد را ندارد و به دوگانگی فکر می‌کند."],[280,"ور برو خندد کسی، گوید: دو است","راست دارد، این سزای بدخو است","اگر کسی دروغ بگوید و به او بخندند، او می‌گوید که این دوستی است و حق دارد، و این نشان‌دهنده عاقبت بدخوهاست."],[280,"بر دروغان، جمع می‌آید دروغ","للخبیثات الخبیثین زد فروغ","بر دروغ، جمع می‌شوند افراد بد و زشت‌خویی که دروغ گفتن برایشان عادی شده است و در این میان، دروغ بر آن‌ها تأثیر منفی می‌گذارد."],[280,"دل‌فراخان را بود دست فراخ","چشم‌کوران را عثار سنگ‌لاخ","دل افرادی که قلب‌های بزرگی دارند، دست آن‌ها نیز بزرگ و سخاوتمند است، اما افرادی که بینا نیستند و حقیقت را نمی‌بینند، همچون سنگ‌لاخ (جای سخت و دشوار) به مشکل برمی‌خورند و درک درستی از واقعیت ندارند."],[281,"گفت دانایی برای داستان","که درختی هست در هندوستان","دانایی داستانی را تعریف می‌کند که درختی در هند وجود دارد."],[281,"هر کسی کز میوه او خورد و برد","نی شود او پیر نی هرگز بمرد","هر کسی که از میوه آن درخت بخورد و آن را ببرد، هرگز پیر نمی‌شود و نمی‌میرد."],[281,"پادشاهی این شنید از صادقی","بر درخت و میوه‌اش شد عاشقی","پادشاهی این خبر را از مردی راستگو درباره درخت و میوه‌اش شنید و دلبسته آن درخت شد."],[281,"قاصدی دانا ز دیوان ادب","سوی هندوستان روان کرد از طلب","قاصدی آگاه و با دانشی از میان ادبیات به سوی هند فرستاده شد تا چیزی را جستجو کند."],[281,"سالها می‌گشت آن قاصد ازو","گرد هندوستان برای جست و جو","قاصد سال‌ها در سفر بود تا هندوستان را بگردد و به دنبال هدفی خاص بگردد."],[281,"شهر شهر از بهر این مطلوب گشت","نی جزیره ماند و نی کوه و نی دشت","مردم همه جا برای یافتن آن درخت خاص که میوه‌اش سبب نجات از مرگ است، به سفر رفتند و هیچ‌چیز جز آن درخت ارزش جست‌وجو ندارد؛ نه جزیره، نه کوه و نه دشت."],[281,"هر که را پرسید کردش ریش‌خند","کین کی جوید جز مگر مجنون بند","هر کسی را که پرسیدند به خاطر جست‌وجوی آن مطلب، مسخره‌اش کردند، می‌پرسند که چه کسی جز مجنون (محبتی دیوانه) به دنبال این موضوع می‌گردد."],[281,"بس کسان صفعش زدند اندر مزاح","بس کسان گفتند ای صاحب‌فلاح","بسیاری از مردم به شوخی و طعنه به او (شخصی که به دنبال حقیقت است) زدند و او را مسخره کردند و گفتند ای دارای رستگاری و نیکبختی!"],[281,"جست و جوی چون تو زیرک سینه‌صاف","کی تهی باشد کجا باشد گزاف","چگونه ممکن است که جستجو و کاوش تو که انسان زیرک و با نیت پاکی هستی، بی‌حاصل باشد و بی‌جهت به جایی بیفتد؟"],[281,"وین مراعاتش یکی صفع دگر","وین ز صفع آشکارا سخت‌تر","این یک مورد از توجه و احتیاط اوست که در برابر آسیبی دیگر قرار دارد و این آسیب که به‌وضوح نمایان است، به مراتب سخت‌تر و خطرناک‌تر از آسیب قبلی است."],[281,"می‌ستودندش به تسخر کای بزرگ","در فلان اقلیم بس هول و سترگ","در آن اقلیم خوفناک و بزرگ، او را به تمسخر ستایش می‌کردند، به خاطر عظمت و بزرگی‌اش."],[281,"در فلان بیشه درختی هست سبز","بس بلند و پهن و هر شاخیش گبز","در یک جنگل، درختی بزرگ و سرسبز وجود دارد که تنه‌اش بلند و شاخه‌هایش وسیع است."],[281,"قاصد شه بسته در جستن کمر","می‌شنید از هر کسی نوعی خبر","قاصدی که پیام پادشاه را به دوش گرفته، در جستجوی آن درخت رفت و از هر کسی که می‌دید، نوعی خبر درباره آن درخت می‌شنید."],[281,"بس سیاحت کرد آنجا سالها","می‌فرستادش شهنشه مالها","سال‌ها در آن سرزمین سیاحت کرد و شاه به او از مال و ثروت زیادی می‌داد."],[281,"چون بسی دید اندر آن غربت تعب","عاجز آمد آخر الامر از طلب","پس از سال‌ها جستجو و سفر در آن مکان، سرانجام او به دلیل ناامیدی از یافتن مقصودش به شدت درمانده و ناتوان شده است."],[281,"هیچ از مقصود اثر پیدا نشد","زان غرض غیر خبر پیدا نشد","هیچ نشانه‌ای از هدف و مقصود پیدا نشد و از آن هدف جز خبری به دست نیامد."],[281,"رشته اومید او بگسسته شد","جسته او عاقبت ناجسته شد","امید او از بین رفته است و به نتیجه‌ای که می‌خواست نرسیده و در حقیقت تلاش‌های او بی‌فایده مانده است."],[281,"کرد عزم بازگشتن سوی شاه","اشک می‌بارید و می‌برید راه","او تصمیم گرفته بود که به سوی شاه برگردد، ولی از شدت غم و ناراحتی اشک می‌ریخت و از پیشروی بازمی‌ایستاد."],[282,"بود شیخی عالمی قطبی کریم","اندر آن منزل که آیس شد ندیم","در آن جا شیوخ و دانشمندان بزرگی وجود داشت که بسیار بخشنده و کریم بودند و کسی که ناامید شده بود، در آن منزل به سر می‌برد."],[282,"گفت من نومید پیش او روم","ز آستان او به راه اندر شوم","گفت: من در برابر او ناامید هستم، پس به سوی او می‌روم و از درگاه او در مسیر او قرار می‌گیرم."],[282,"تا دعای او بود همراه من","چونک نومیدم من از دلخواه من","تا زمانی که دعای او (شیخ) با من است، به امید او هستم؛ زیرا من از خواسته‌ها و آرزوهایم ناامید شده‌ام."],[282,"رفت پیش شیخ با چشم پر آب","اشک می‌بارید مانند سحاب","شخص به سمت شیخ می‌رود و چشمانش پر از اشک است، اشک او پیوسته می‌ریزد و مانند باران است."],[282,"گفت شیخا وقت رحم و رقتست","ناامیدم وقت لطف این ساعتست","شیخ گفت، ای کسی که نزد من آمده‌ای، اکنون زمان رحمت و مهربانی است؛ من ناامید نیستم و در این لحظه، زمان لطف و بخشش خداوند می‌باشد."],[282,"گفت واگو کز چه نومیدیستت","چیست مطلوب تو رو با چیستت","شیخ از او می‌پرسد که به چه دلیلی ناامید شده‌ای و آرزوی واقعی‌ات چیست."],[282,"گفت شاهنشاه کردم اختیار","از برای جستن یک شاخسار","شاهنشاه (مقصود از او خدا یا حقیقت بزرگ است) می‌گوید که من انتخاب کردم تا یک شاخه از این درخت (درخت معرفت یا حقیقت) را ببرم و به جست‌وجوی آن بروم."],[282,"که درختی هست نادر در جهات","میوه او مایه آب حیات","درختی وجود دارد که به ندرت یافت می‌شود و میوه‌اش باعث به دست آوردن آب حیات می‌شود، که در ادبیات به معنای زندگی جاودان و روحانی است."],[282,"سالها جستم ندیدم یک نشان","جز که طنز و تسخر این سرخوشان","سال‌ها تلاش کردم تا نشانی از حقیقت بیابم، اما تنها چیزی که دیدم، شوخی و طعنه این خوشحال‌ها بود."],[282,"شیخ خندید و بگفتش ای سلیم","این درخت علم باشد در علیم","شیخ با خنده به سلیم می‌گوید که این درخت، نماد علم است و به عالم (عالم پزشکی) اشاره دارد."],[282,"بس بلند و بس شگرف و بس بسیط","آب حیوانی ز دریای محیط","آب حیوانی، که به معنای آب حیات است، بسیار بلند، شگفت‌انگیز و وسیع است و از دریای محیط سرچشمه می‌گیرد. این آب حیات نمادی از معرفت و آگاهی عمیق است که در عالم وجود دارد."],[282,"تو بصورت رفته‌ای ای بی‌خبر","زان ز شاخ معنیی بی بار و بر","تو در ظاهری رفته‌ای و از معنای اصلی و عمیق آن بی‌خبری، همان‌طور که شاخی وجود دارد اما بار و میوه‌ای ندارد."],[282,"گه درختش نام شد گه آفتاب","گاه بحرش نام گشت و گه سحاب","این بیت به تغییرات و تحولات درخت زندگی اشاره دارد. گاهی درخت به نام درخت شناخته می‌شود، گاه به نام آفتاب، و در موقعیت‌های دیگر ممکن است به دریا یا ابر نسبت داده شود. این نشان می‌دهد که هر چیزی در این جهان ممکن است در قالب‌های مختلف جلوه‌گر شود و ویژگی‌های گوناگونی داشته باشد."],[282,"آن یکی کش صد هزار آثار خاست","کمترین آثار او عمر بقاست","اگر چه آن درخت و یا آفتاب و یا دریا و ابر هر یک دارای آثار و نشانه‌های بسیار زیادی هستند، اما از میان همه آن‌ها، کمترین اثر آن درخت، عمر بقاست که نشان‌دهنده‌ی ادامه حیات و وجود است."],[282,"گرچه فردست او اثر دارد هزار","آن یکی را نام شاید بی‌شمار","اگرچه شخص دیگری (فردی) آثار زیادی دارد، اما آن شخص (مردی که موردنظر است) تنها شاید نامش را به تعداد بی‌شماری هم بدانند."],[282,"آن یکی شخصی تو را باشد پدر","در حق شخصی دگر باشد پسر","یک نفر در مورد تو به عنوان پدر خود را می‌شناسد، در حالی که همان نفر در مورد شخص دیگری به عنوان پسر خود را معرفی می‌کند."],[282,"در حق دیگر بود قهر و عدو","در حق دیگر بود لطف و نکو","در رابطه با هر شخص، ممکن است یک فرد به عنوان دشمن و شخصی دیگر به عنوان دوست و عزیز ظاهر شود."],[282,"صد هزاران نام و او یک آدمی","صاحب هر وصفش از وصفی عمی","اگرچه نام‌های زیادی وجود دارد و افراد با عناوین مختلف شناخته می‌شوند، اما در حقیقت، همه آن‌ها تنها یک انسان هستند که هر کدام دارای ویژگی‌ها و صفات خاص خود می‌باشند."],[282,"هر که جوید نام گر صاحب ثقه‌ست","همچو تو نومید و اندر تفرقه‌ست","هر کسی که در پی نام و شهرت باشد و اگر هم که فرد معتبری مثل تو باشد، باز هم ناامید و درهم‌ریخته خواهد بود."],[282,"تو چه بر چفسی برین نام درخت","تا بمانی تلخ‌کام و شوربخت","تو چرا به نام این درخت چنگ می‌زنی و از آن آویزان شده‌ای، در حالی که این کار تو را به تلخی و بدبختی دچار می‌کند؟"],[282,"در گذر از نام و بنگر در صفات","تا صفاتت ره نماید سوی ذات","به جای تمرکز بر نام‌ها و عناوین، به ویژگی‌ها و صفات توجه کن، زیرا این صفات می‌توانند تو را به درک عمیق‌تری از حقیقت وجودی‌ات برسانند."],[282,"اختلاف خلق از نام اوفتاد","چون به معنی رفت آرام اوفتاد","اختلاف و جدال مردم بر سر نام‌ها و عناوین است، اما وقتی به عمق معانی پرداخته می‌شود و به حقیقت می‌رسند، همه چیز در آرامش و هماهنگی قرار می‌گیرد."],[283,"چار کس را داد مردی یک درم","آن یکی گفت این به انگوری دهم","مردی به چهار نفر یک درهم داد و یکی از آن‌ها گفت: من این درهم را بابت انگور می‌دهم."],[283,"آن یکی دیگر عرب بد گفت لا","من عنب خواهم نه انگور ای دغا","تصحیح ترجمه Al : یک عرب دیگری گفت: لا من انگور نمیخوام من عنب(انگور) میخوام(فرد عرب هم انگور می‌خواسته اما نمی‌دونسته این میوه به فارسی میشده انگور! فکر کرده یه میوه دیگست!)"],[283,"آن یکی ترکی بد و گفت این بنم","من نمی‌خواهم عنب، خواهم ازم","یکی از افراد که اهل ترکیه بود، گفت من این انگور را نمی‌خواهم و به جای آن، چیز دیگری را می‌خواهم."],[283,"آن یکی رومی بگفت این قیل را","ترک کن خواهیم استافیل را","آن یکی که رومی بود گفت: این بحث و جدل را رها کن و به دنبال میوه‌ای که ما به دنبال آن هستیم، یعنی استافیل (نوعی انگور)، برو."],[283,"در تنازع آن نفر جنگی شدند","که ز سرّ نامها غافل بدند","در دعوای آن افراد، آن‌ها به جنگ و نزاع پرداخته‌اند زیرا از راز و معنای واقعی نام‌ها و اصطلاحات بی‌خبر بودند."],[283,"مشت بر هم می‌زدند از ابلهی","پر بدند از جهل و از دانش تهی","آن‌ها به خاطر نادانی و احمق بودن، مشت به هم می‌زدند و در اشتیاق به انگور با یکدیگر درگیر شده بودند و از علم و آگاهی بی‌بهره بودند."],[283,"صاحب سرّی عزیزی، صد زبان","گر بدی آنجا بدادی صلحشان","اگر کسی رازدار و باارزش را در آنجا می‌دید، با دادن صد زبان، صلح و سازش میان آن‌ها را برقرار می‌کرد."],[283,"پس بگفتی او که من زین یک درم","آرزوی جمله‌تان را می‌دهم","او گفت که من به‌جای یک درم، آرزوی همه شما را برآورده می‌کنم."],[283,"چونک بسپارید دل را بی دغل","این درمتان می‌کند چندین عمل","اگر دل‌تان را بدون نیرنگ و فریب به کسی بسپارید، او با این یک درم شما کارهای زیادی خواهد کرد و خیلی از خواسته‌هایتان را عملی می‌کند."],[283,"یک درمتان می‌شود چار المراد","چار دشمن می‌شود یک ز اتحاد","اگر دل‌های شما به هم متصل باشد، آن چه به دست می‌آورید، چهار معنی مختلف خواهد داشت و اگر از هم جدا شوید، چهار دشمن نیز به وجود می‌آید."],[283,"گفت هر یکتان دهد جنگ و فراق","گفت من آرد شما را اتفاق","هر یک از آن چهار نفر در جنگ و جدال هستند و به یکدیگر می‌گویند که چه کسی حق دارد، اما در حقیقت کسی که همه شما را به وحدت و همکاری دعوت می‌کند، من هستم."],[283,"پس شما خاموش باشید انصتوا","تا زبانتان من شوم در گفت و گو","تا زمانی که شما ساکت باشید و چیزی نگویید، من در صحبت و گفتگو سخن شما خواهم بود."],[283,"گر سخنتان می‌نماید یک نمط","در اثر مایه نزاعست و سخط","اگر گفت‌وگوی شما به نظر می‌آید که یک موضوع یا مطلب مشخص را بیان می‌کند، در واقع باعث ایجاد نزاع و اختلاف نظر می‌شود و نتیجه‌اش تنش و کدورت است."],[283,"گرمی عاریتی ندهد اثر","گرمی خاصیتی دارد هنر","گرمایی که به وسیله اجاره یا قرض به دست آمده، تأثیری ندارد، اما گرمایی که به‌صورت طبیعی و ذاتی وجود دارد، هنر و خاصیت ویژه‌ای دارد."],[283,"سرکه را گر گرم کردی ز آتش آن","چون خوری سردی فزاید بی گمان","اگر سرکه را بر اثر حرارت آتش گرم کنی و سپس بنوشی، بدون شک سردی‌اش بیشتر می‌شود."],[283,"زانک آن گرمی او دهلیزیست","طبع اصلش سردیست و تیزیست","زیرا این گرمی، مانند یک دالان، طبعش (خوی و ویژگی‌اش) سرد و تند است."],[283,"ور بود یخ‌بسته دوشاب ای پسر","چون خوری گرمی فزاید در جگر","اگر شیره (دوشاب) یخ‌زده باشد، وقتی که بخوری، گرما در دل (جگر) تو بیشتر می‌شود."],[283,"پس ریای شیخ به ز اخلاص ماست","کز بصیرت باشد آن وین از عماست","ریای شیخ (شیخ به معنای مرد از خود گذشته یا استاد) بهتر از اخلاص ماست چون او از بصیرت و بینش برخوردار است، در حالی که ما بی‌خبر و نادان هستیم."],[283,"از حدیث شیخ جمعیت رسد","تفرقه آرد دم اهل جسد","از گفته‌های شیخ، وحدت و جمع ایجاد می‌شود، اما کلام او باعث جدایی و تفرقه در میان کسانی که فقط به جسم و ظاهر خود می‌نگرند، می‌گردد."],[283,"چون سلیمان کز سوی حضرت بتاخت","کو زبان جمله مرغان را شناخت","سلیمان، پیامبر و پادشاه معروف، به خواست خداوند توانست زبان همه پرندگان را بفهمد و با آنها سخن بگوید. این بیت بیانگر این است که او از طرف خداوند به این نعمت دست یافته و از آن بهره‌مند شده است."],[283,"در زمان عدلش آهو با پلنگ","انس بگرفت و برون آمد ز جنگ","در زمان حکومت عادلانه سلیمان، آهو با پلنگ دوست شد و از حالت جنگ و درگیری خارج شدند."],[283,"شد کبوتر آمن از چنگال باز","گوسفند از گرگ ناورد احتراز","کبوتر از دست باز (پرنده شکاری) نجات یافت و گوسفند از دست گرگ دوری جسته است. در اینجا به صلح و امنیتی اشاره دارد که در زمان عدالت به وجود آمده و حیوانات از خطرها در امان شده‌اند."],[283,"او میانجی شد میان دشمنان","اتحادی شد میان پرزنان","او در میان دشمنان، به عنوان میانجی ظاهر شد و باعث اتحاد و دوستی میان پشت سرهم‌زن‌ها شد."],[283,"تو چو موری بهر دانه می‌دوی","هین سلیمان جو چه می‌باشی غوی","تو مانند مورچه برای دانه می‌دوی، پس ای سلیمان‌جو (کسی که به دنبال سلیمان و ثروت اوست) چه نیازی به این دویدن و تلاش بی‌فایده داری؟"],[283,"دانه‌جو را دانه‌اش دامی شود","و آن سلیمان‌جوی را هر دو بود","دانه‌جو، که به دنبال دانه است، در دام می‌افتد و کسی که به دنبال سلیمان است نیز به همین سرنوشت دچار می‌شود."],[283,"مرغ جانها را درین آخر زمان","نیستشان از همدگر یک دم امان","در این زمانه آخر، جان‌های انسان‌ها از یکدیگر آرام و بی‌خبر نیستند و هرگز نمی‌توانند حتی لحظه‌ای در کنار هم به آرامش باشند."],[283,"هم سلیمان هست اندر دور ما","کو دهد صلح و نماند جور ما","در میان ما کسی هست که مانند سلیمان، صلح را به ما می‌دهد و از ظلم و جور در امان می‌دارد."],[283,"قول ان من امة را یاد گیر","تا به الا و خلا فیها نذیر","از این آیه که می‌گوید «نسل و قوم خود را به یاد داشته باش»، بیاموز که خداوند در آنچه می‌گوید، به روشنی و بدون تردید سخن می‌گوید و به نوعی هشداردهنده است."],[283,"گفت خود خالی نبودست امتی","از خلیفه حق و صاحب‌همتی","می‌گوید هیچ قومی از وجود خلیفه خداوند و کسی که دارای همت و اراده قوی است، خالی نیست."],[283,"مرغ جانها را چنان یکدل کند","کز صفاشان بی غش و بی غل کند","مرغ جان‌ها (به احتمال مراد از آن فرشتگان یا نیروی روحانی است) ، انسان‌ها را به طور کامل متعهد و یکپارچه می‌کند، به‌طوری که خلوص و صداقت آن‌ها بدون هیچ‌گونه فریب و نیرنگی نمایان می‌شود."],[283,"مشفقان گردند همچون والده","مسلمون را گفت نفس واحده","مهربانان و دلسوزان مانند مادر به یکدیگر نزدیک می‌شوند و در سخنان خود از انسجام و یگانگی سخن می‌گویند."],[283,"نفس واحد از رسول حق شدند","ور نه هر یک دشمن مطلق بدند","همه آن‌ها به حکم خدا به یک نفس واحد تبدیل شده‌اند و اگر این حالت نبود، هرکدام به تنهایی دشمن یکدیگر بودند."],[284,"دو قبیله کاوس و خزرج نام داشت","یک ز دیگر جان خون‌آشام داشت","دو قبیله به نام‌های کاوس و خزرج وجود داشت که یکی از آن‌ها دشمنی و کینه‌ورزی نسبت به دیگری داشت."],[284,"کینه‌های کهنه‌شان از مصطفی","محو شد در نور اسلام و صفا","کینه‌ها و دشمنی‌های قدیمی آنان نسبت به پیامبر اسلام، در پرتو نور اسلام و پاکی آن، ناپدید و از بین رفت."],[284,"اولا اخوان شدند آن دشمنان","همچو اعداد عنب در بوستان","دشمنان پیشین به برکت اسلام، مانند خوشه‌های انگور در باغ به یکدیگر پیوند خوردند و برادر شدند."],[284,"وز دم المؤمنون اخوه به پند","در شکستند و تن واحد شدند","از دم مؤمنان، برادران یکدیگر شدند و با پند و نصیحت، در دل‌ها وحدت یافتند و مانند یک بدن واحد شدند."],[284,"صورت انگورها اخوان بود","چون فشردی شیره واحد شود","انگورها به صورت برادران همدیگرند، اما وقتی فشرده شوند، شیره‌ای یکدست و واحد ایجاد می‌کنند."],[284,"غوره و انگور ضدانند لیک","چونک غوره پخته شد، شد یار نیک","غوره و انگور با هم تضاد دارند، اما وقتی غوره به انگور رسیده و پخته می‌شود، تبدیل به یار و دوست خوب می‌شود."],[284,"غوره‌ای کو سنگ‌بست و خام ماند","در ازل حق کافر اصلیش خواند","خرد نشده و نارس بودن یک غوره در آغاز، باعث شده که آن را اصلی کافر بنامند؛ یعنی اگر انسانی در آغاز راه به کمال نرسد، به نوعی به بی‌باوری متهم می‌شود."],[284,"نه اخی نه نفس واحد باشد او","در شقاوت نحس ملحد باشد او","او نه برادر است و نه نفس واحدی، بلکه در شقاوت و بدبختی به‌گونه‌ای است که مثل یک ملحد (کافر) به حساب می‌آید."],[284,"گر بگویم آنچ او دارد نهان","فتنه افهام خیزد در جهان","اگر بگویم آنچه او (خدا یا حقیقت) در دل دارد و پنهان است، فتنه‌ای در فهم انسان‌ها به راه می‌اندازد و موجب آشفتگی در عالم می‌شود."],[284,"سر گبر کور نامذکور به","دود دوزخ از ارم مهجور به","سر گبر کور، که اشاره به فردی از پیروان زرتشت دارد، به سبب گناهانی که مرتکب شده است، به عذاب آتش دوزخ دچار می‌شود و او از نعمت‌های بهشتی محروم است."],[284,"غوره‌های نیک که ایشان قابلند","از دم اهل دل آخر یک دلند","غوره‌های نیک، که به معنی انگورهای کوچک و باکیفیت هستند، از نگاه اهل دل ارزشمندند و در نهایت همه آنان، با هم یکدل و متحد می‌شوند."],[284,"سوی انگوری همی‌رانند تیز","تا دوی بر خیزد و کین و ستیز","همه به سمت انگور می‌شتابند تا دوستی و محبت بیشتر شود و از کینه و عداوت دور شوند."],[284,"پس در انگوری همی‌درند پوست","تا یکی گردند و وحدت وصف اوست","انگور را پوست آن می‌سوزانند و از آن مایع واحدی به‌دست می‌آورند تا همه‌ی آن‌ها یکی شوند؛ این نمادی از یگانگی و اتحاد است."],[284,"دوست دشمن گردد ایرا هم دواست","هیچ یک با خویش جنگی در نبست","دوست با دشمن یکی می‌شود و این هم درمان است. هیچ‌یک از آن‌ها با خودشان جنگی ندارند."],[284,"آفرین بر عشق کل اوستاد","صد هزاران ذره را داد اتحاد","عشق، استاد و معلمی است که باعث می‌شود میلیون‌ها ذره و موجود پراکنده به هم پیوسته و متحد شوند."],[284,"همچو خاک مفترق در ره‌گذر","یک سبوشان کرد دست کوزه‌گر","مانند خاکی که در راه پراکنده و جدا است، وقتی دست سازنده یا کوزه‌گر بر آن بیفتد، به یک شکل در می‌آید."],[284,"که اتحاد جسمهای آب و طین","هست ناقص جان نمی‌ماند بدین","اتحاد آب و گل، یعنی وجود فیزیکی و مادی، ناپایدار و ناقص است و روح انسان نمی‌تواند به این حالت مادی بسنده کند."],[284,"گر نظایر گویم اینجا در مثال","فهم را ترسم که آرد اختلال","اگر بخواهم در اینجا مثال‌هایی بزنم، می‌ترسم که فهم خواننده دچار مشکل شود و به اختلال بیفتد."],[284,"هم سلیمان هست اکنون لیک ما","از نشاط دوربینی در عمی","ما هم‌اکنون سلیمان را داریم، اما به خاطر دید محدودمان از شادی و خوشی دور هستیم."],[284,"دوربینی کور دارد مرد را","همچو خفته در سرا کور از سرا","مردی که دچار دوربینی است، مانند کسی است که در خانه‌ای خوابیده و از دنیای بیرون چیزی نمی‌بیند. او نمی‌تواند دیدگاه‌های گسترده‌تری داشته باشد و از حقیقت‌ها غافل است."],[284,"مولعیم اندر سخنهای دقیق","در گره ها باز کردن ما عشیق","ما در سخنان عمیق و دقیق متخصص هستیم و به خوبی می‌دانیم چگونه گره‌ها را باز کنیم. ما در این زمینه عاشقانه و با اشتیاق عمل می‌کنیم."],[284,"تا گره بندیم و بگشاییم ما","در شکال و در جواب آیین‌فزا","ما در تلاشیم تا گره‌هایی را که در کلمات ظریف و معانی عمیق وجود دارد، باز کنیم و به پرسش‌های پیوسته و شگفت‌انگیز زندگی پاسخ دهیم."],[284,"همچو مرغی کو گشاید بند دام","گاه بندد تا شود در فن تمام","انسان هم مانند پرنده‌ای است که زمانی که در دام گرفتار می‌شود، برای جدا شدن از آن گاه خود را در بند می‌کند تا در نهایت بتواند به طور کامل و آزاد از دام رهایی یابد."],[284,"او بود محروم از صحرا و مرج","عمر او اندر گره کاریست خرج","این فرد از آزادی و زندگی خوب در طبیعت به دور است و زندگی‌اش در مشکلات و گرفتاری‌ها گره خورده است."],[284,"خود زبون او نگردد هیچ دام","لیک پرش در شکست افتد مدام","او هرگز ذلیل و بی‌قدرت نمی‌شود، اما به دلیل ناتوانی در کنترل قوای خود، همیشه در معرض آسیب و شکست قرار دارد."],[284,"با گره کم کوش تا بال و پرت","نسکلد یک یک ازین کر و فرت","با تلاش کم و ملایم گره‌ها را باز کن تا پر و بالت آسیب نبیند و یکی یکی از این مشکلات و موانع عبور کنی."],[284,"صد هزاران مرغ پرهاشان شکست","و آن کمین‌گاه عوارض را نبست","بسیاری از مرغ‌ها در اثر مشکلات و حوادث، پرهایشان شکسته شده و نتوانسته‌اند از چنگال سختی‌ها فرار کنند."],[284,"حال ایشان از نبی خوان ای حریص","نقبوا فیها ببین هل من محیص","حالت آن افراد را از پیامبر سوال کن، ای کسی که به دنبال جستجوی حریصانه‌ای، به درون آن (محیط) نفوذ کردند و حال ببین آیا فراری وجود دارد یا نه."],[284,"از نزاع ترک و رومی و عرب","حل نشد اشکال انگور و عنب","چالش‌ها و منازعاتی که میان ترک‌ها، روم‌ها و عرب‌ها وجود دارد، نتوانسته است مشکلی که به خاطر انگور و کشمش، یعنی مسائلی جزئی و بی‌اهمیت، پیش آمده، حل کند."],[284,"تا سلیمان لسین معنوی","در نیاید بر نخیزد این دوی","تا زمانی که معنویات و آموزه‌های الهی سلیمان به گوش انسان‌ها نرسد، این دعوا و کشمکش‌های مادی و دنیایی برطرف نخواهد شد."],[284,"جمله مرغان منازع بازوار","بشنوید این طبل باز شهریار","هر یک از پرندگان در حال نزاع و جنگ هستند، ولی به صدای طبل شهریار (سلیمان) گوش دهید که آنها را به آرامش دعوت می‌کند."],[284,"ز اختلاف خویش سوی اتحاد","هین ز هر جانب روان گردید شاد","از اختلاف و نزاع خود فاصله بگیرید و به اتحاد نزدیک شوید؛ به سمت همدیگر با شادی و خوشحالی روان شوید."],[284,"حیث ما کنتم فولوا وجهکم","نحوه هذا الذی لم ینهکم","به هر طرف که باشید، رو به سوی آن چیزی کنید که شما را از نافرمانی باز نمی‌دارد."],[284,"کور مرغانیم و بس ناساختیم","کان سلیمان را دمی نشناختیم","ما مانند پرندگان کور هستیم و هیچ درکی از وضعیت خود نداریم، زیرا یک لحظه هم سلیمان را نشناختیم و به حکمت و عظمت او توجه نکردیم."],[284,"همچو جغدان دشمن بازان شدیم","لاجرم وا مانده ویران شدیم","ما مانند جغدهای شب، دشمن شکارچیان (بازها) شده‌ایم و در نتیجه، از حقیقت و روشنی بازمانده و ویران گشته‌ایم."],[284,"می‌کنیم از غایت جهل و عما","قصد آزار عزیزان خدا","به خاطر نادانی و جهل، ما تصمیم به آزار دوستان خدا می‌زنیم."],[284,"جمع مرغان کز سلیمان روشنند","پر و بال بی گنه کی برکنند","مرغان جمعی هستند که از سلیمان، پیامبر الهی، روشنی و نور دارند و بی‌گناهی آنان باعث نمی‌شود که پر و بالشان را نابود کنند."],[284,"بلک سوی عاجزان چینه کشند","بی خلاف و کینه آن مرغان خوشند","مرغانی که با صفا و بی‌کینہ هستند، به سوی افراد ناتوان و ضعیف می‌روند و به آن‌ها کمک می‌کنند و هیچ بغض و دشمنی‌ای با آنان ندارند."],[284,"هدهد ایشان پی تقدیس را","می‌گشاید راه صد بلقیس را","هدهد در خدمت آنها (حضرت سلیمان و انصارش) برای تقدیس و تقدیر به‌سوی آنها می‌رود و راه‌های بسیاری را که به بلقیس (ملکه سبا) می‌رسد، آشکار می‌کند."],[284,"زاغ ایشان گر بصورت زاغ بود","باز همت آمد و مازاغ بود","اگرچه زاغ‌ها خود زاغ هستند و به همان صورت زاغ باقی می‌مانند، اما تلاش و اراده‌ توانمندی به آنها می‌دهد که از این حالت صرف زاغ بودن فراتر رفته و به باروری و پیشرفت برسند."],[284,"لکلک ایشان که لک‌لک می‌زند","آتش توحید در شک می‌زند","صدای لک‌لک (پرنده‌ای که آوازش را به صورت \"لک لک\" می‌خواند) ایشان نشان‌دهنده این است که در آتش توحید (ایمان به یگانگی خدا) شک و تردید وجود دارد."],[284,"و آن کبوترشان ز بازان نشکهد","باز سر پیش کبوترشان نهد","کبوتران آنها از روی ترس از بازها نمی‌گریزند و بازها به احترام کبوتران، سر خود را به سمت آنها خم می‌کنند."],[284,"بلبل ایشان که حالت آرد او","در درون خویش گلشن دارد او","بلبل آن‌ها حالت خوشی دارد و در درون خود گلستانی از شادی و زیبایی را احساس می‌کند."],[284,"طوطی ایشان ز قند آزاد بود","کز درون قند ابد رویش نمود","طوطی آنان مانند قند است که در آن آزادی و شیرینی وجود دارد، زیرا از درون قند ابد، زیبا و روح‌افزا جلوه‌گر می‌شود."],[284,"پای طاووسان ایشان در نظر","بهتر از طاووس‌پران دگر","در نظر آن‌ها، پای طاووسانشان (که نمادی از زیبایی و عظمت است) از پرندگانی که فقط به پرواز و زیبایی ظاهری می‌پردازند، بهتر می‌باشد."],[284,"منطق الطیر آن خاقانی صداست","منطق الطیر سلیمانی کجاست","منطق الطیری که خاقانی گفتهه حرف و صداست ولی منطق الطیری که سلیمان بلد بود اصل کاره"],[284,"تو چه دانی بانگ مرغان را همی","چون ندیدستی سلیمان را دمی","تو چه می‌دانی صدای پرندگان چگونه است، زیرا که هرگز چهره سلیمان را حتی برای یک لحظه نیز ندیده‌ای."],[284,"پر آن مرغی که بانگش مطربست","از برون مشرقست و مغربست","این بیت به مرغی اشاره دارد که صدایش موسیقی و نغمه‌ای دلنشین دارد. صدای این مرغ از سمت مشرق و مغرب می‌آید و نشان‌دهنده زیبایی و فراگیری این نغمه است."],[284,"هر یک آهنگش ز کرسی تا ثریست","وز ثری تا عرش در کر و فریست","هر یک و هر کجا این پرنده (مرغ) صدایش را بلند می‌کند، از زمین (کرسی) تا آسمان (عرش) شنیده می‌شود و این صدا در همه جا خبر از شادی و نشاط می‌دهد."],[284,"مرغ کو بی این سلیمان می‌رود","عاشق ظلمت چو خفاشی بود","مرغی که بدون سلیمان (سلیمان پیامبر) می‌رود، به سادگی در تاریکی و ظلمت زندگی می‌کند و مانند خفاشی عاشق تاریکی است."],[284,"با سلیمان خو کن ای خفاش رد","تا که در ظلمت نمانی تا ابد","ای خفاش، با سلیمان (که نماد نور و هدایت است) دوست شو و همراهی کن تا در تاریکی و ظلمت باقی نمانی و از آن رهایی یابی."],[284,"یک گزی ره که بدان سو می‌روی","همچو گز قطب مساحت می‌شوی","هر گام که به سوی مقصد مورد نظر خود برمی‌داری، مانند گزی که به سمت قطب (مرکز) حرکت می‌کند، تو را به فضایی وسیع‌تر و گسترده‌تر می‌کشاند."],[284,"وانک لنگ و لوک آن سو می‌جهی","از همه لنگی و لوکی می‌رهی","اگرچه تو با مشکلات و ناتوانی‌ها به سمت آنجا می‌روی، اما همین که قدم برداری، از تمام لنگی و ناتوانی‌ها رهایی می‌یابی."],[285,"تخم بطّی گرچه مرغ خانه‌ات","کرد زیر پر چو دایه تربیت","اگرچه تخم‌گذاری مرغ خانگی در زیر پر دایه‌اش باعث پرورش جوجه‌بطی شده است، اما این جوجه‌ها هنوز ماهیت واقعی خود را فراموش نکرده‌اند."],[285,"مادر تو بطّ آن دریا بدست","دایه‌ات خاکی بد و خشکی‌پرست","مادر تو در حقیقت همان بطی است که متعلق به دریا است و دایه‌ات که به تو تربیت داده، از خاک نشأت گرفته و به زندگی در خشکی وابسته است."],[285,"میل دریا که دل تو اندرست","آن طبیعت جانت را از مادرست","عشق و تمایل به دریا در دل تو وجود دارد و این ویژگی روحی تو از طبیعت و اصل و نسل مادری‌ات به ارث رسیده است."],[285,"میل خشکی مر تو را زین دایه است","دایه را بگذار کو بدرایه است","میل به خشکی و زندگی محدود به‌خاطر دایه‌ای است که تو را در این حال نگه داشته. حالا باید دایه را رها کنی، چون او زندگی را به تو یاد نمی‌دهد و نمی‌گذارد به عمق و معنای واقعی زندگی بروی."],[285,"دایه را بگذار در خشک و بران","اندر آ در بحر معنی چون بطان","مادر بزرگ را رها کن و به جستجوی عمق و معنای واقعی بپرداز، مانند بط‌های بچه که در آب بازی می‌کنند."],[285,"گر تو را مادر بترساند ز آب","تو مترس و سوی دریا ران شتاب","اگر مادرت تو را از آب بترساند، نترس و به سمت دریا برو و شتاب کن."],[285,"تو بطی بر خشک و بر تر زنده‌ای","نی چو مرغ خانه، خانه‌گنده‌ای","تو به عنوان یک جاندار در خشکی و در آب زندگی می‌کنی، اما مانند مرغی که در خانه و در قفس نگهداری شده است، زندگی‌ات محدود و بی‌تحرک است."],[285,"تو ز کرمنا بنی آدم شهی","هم به خشکی هم به دریا پا نهی","تو به خاطر لطف و مهربانی الهی، انسان‌های نیکو و شایسته‌ای هستی و می‌توانی هم در زمین و هم در دریا قدم برداری."],[285,"که حملناهم علی البحر بجان","از حملناهم علی البر پیش ران","پرندگان دریایی در دریانوردی برای پرواز در خشکی نیاز به راهنمایی دارند، زیرا آنها تنها در آب آشنا هستند و در خشکی نمی‌توانند جهت صحیح را بیابند."],[285,"مر ملایک را سوی بر راه نیست","جنس حیوان هم ز بحر آگاه نیست","فرشتگان نسبت به راه بر انسان‌ها شناختی ندارند، چون خودشان از جنس حیوان نیستند و از دنیای مادی نیز بی‌خبرند."],[285,"تو به تن حیوان، به جانی از ملک","تا روی هم بر زمین هم بر فلک","تو به ظاهر همچون یک حیوان هستی و از نظر جسمی در دنیای مادی زندگی می‌کنی، اما از نظر روح و جان، به ملکوت و عالم بالا وابسته‌ای و می‌توانی هم در زمین و هم در آسمان حرکت کنی."],[285,"تا بظاهر مثلکم باشد بشر","با دل یوحی الیه دیده‌ور","تا ظاهرا انسان مانند شما باشد، دل او وحی‌گرفته و بینا است."],[285,"قالب خاکی فتاده بر زمین","روح او گردان برین چرخ برین","این بیت به این معناست که بدن خاکی انسان بر زمین افتاده است، اما روح او همچنان در گردش و حرکت در آسمان‌ها و چرخ و فلک است."],[285,"ما همه مرغابیانیم ای غلام","بحر می‌داند زبان ما تمام","ما همگی مانند مرغابی‌ها هستیم و ای غلام (برده)، دریا می‌داند که ما چه می‌گوییم و زبان ما را به‌خوبی می‌فهمد."],[285,"پس سلیمان بحر آمد ما چو طیر","در سلیمان تا ابد داریم سیر","پس سلیمان به دریا آمد و ما مانند پرندگان، تا ابد در کنار سلیمان خواهیم چرخید."],[285,"با سلیمان پای در دریا بنه","تا چو داود آب سازد صد زره","با سلیمان، پای خود را به دریا بگذار تا مانند داود، آب را به آواز سازد و به حرکت درآورد."],[285,"آن سلیمان پیش جمله حاضرست","لیک غیرت چشم‌بند و ساحرست","سلیمان در حضور همه است، اما غیرت او مانند چشمی بسته و سحرآمیز او را از دیدگاه دیگران پنهان کرده است."],[285,"تا ز جهل و خوابناکی و فضول","او به پیش ما و ما از وی ملول","این بیت اشاره دارد به حالتی که انسان به دلیل جهل و خواب‌آلودگی و مشغول بودن به امور غیرضروری، توانایی درک واقعیات را ندارد و به همین دلیل دیگران از او خسته و دل‌زده‌اند."],[285,"تشنه را درد سر آرد بانگ رعد","چون نداند کو کشاند ابر سعد","تشنه به خاطر شنیدن صدای رعد دچار درد و ناراحتی می‌شود، زیرا نمی‌داند که چه چیزی باعث می‌شود ابر خوش‌بختی به باران بیفتد."],[285,"چشم او ماندست در جوی روان","بی‌خبر از ذوق آب آسمان","چشم او در کنار جوی آب جاری است، اما از لذت، طعم و زیبایی آب آسمانی بی‌خبر است."],[285,"مرکب همت سوی اسباب راند","از مسبب لاجرم محجوب ماند","همت و تلاش انسان به سوی علل و عواملی می‌شتابد، اما از مسبب اصلی (خدا) به خاطر غفلت و دوری نمی‌تواند آگاه شود و به همین دلیل از حقیقت محروم می‌ماند."],[285,"آنک بیند او مسبب را عیان","کی نهد دل بر سببهای جهان","کسی که به وضوح مسبب، یعنی علت‌العلل را می‌بیند، چگونه می‌تواند دل به اسباب و علل دنیوی بسپارد و به آن‌ها اعتماد کند؟"],[286,"زاهدی بد در میان بادیه","در عبادت غرق چون عبادیه","زاهدی در بیابان بود که به عبادت مشغول شده و در آن غرق شده بود، مانند انسانی که به شدت در عبادت خود غوطه‌ور است."],[286,"حاجیان آنجا رسیدند از بلاد","دیده‌شان بر زاهد خشک اوفتاد","حاجیان به آنجا رسیدند و از شهرها به سوی زاهد خشک نگاه کردند."],[286,"جای زاهد خشک بود او ترمزاج","از سموم بادیه بودش علاج","زاهد که در بیابان خشک و داغ تنها بود، به خاطر طبیعت و حالش از گرمای شدید بیابان درمانی داشت که او را از آسیب‌های ناشی از گرما محافظت می‌کرد."],[286,"حاجیان حیران شدند از وحدتش","و آن سلامت در میان آفتش","حاجیان به خاطر تنها بودن زاهد در میان آفت‌ها و خطرات بی‌نظیر، از وحدت و آرامشی که او داشت شگفت‌زده شدند."],[286,"در نماز استاده بد بر روی ریگ","ریگ کز تفش بجوشد آب دیگ","در حال نماز، او در کنار سنگ‌ریزه‌های داغ ایستاده است، سنگ‌ریزه‌هایی که از گرما، آب داغ را به جوش می‌آورند."],[286,"گفتیی سرمست در سبزه و گلست","یا سواره بر براق و دلدلست","گفتی مست و شاداب در میان سبزه و گل هست یا بر مرکب شتابان و تندرو نشسته است."],[286,"یا که پایش بر حریر و حله‌هاست","یا سموم او را به از باد صباست","یا اینکه پای او بر فرش‌های نرم و لباس‌های فاخر است، یا اینکه شدت طبع و روح او به مراتب از وزش ملایم باد صبا بهتر و خوشایندتر است."],[286,"پس بماندند آن جماعت با نیاز","تا شود درویش فارغ از نماز","آن جمعیت با نیاز و درخواست‌هایشان در آنجا ماندند تا اینکه درویش (زاهد) از انجام نماز فارغ شود."],[286,"چون ز استغراق باز آمد فقیر","زان جماعت زنده روشن‌ضمیر","فقیر که دگرگون شده و در عالم معنوی غرق شده بود، وقتی به حالت طبیعی خود بازگشت، از آن گروه افراد با بصیرت و آگاه جدا شد."],[286,"دید کآبش می‌چکید از دست و رو","جامه‌اش تر بود از آثار وضو","او مشاهده کرد که آب وضو از دستش می‌چکد و لباسش از نشانه‌های وضو خیس شده است."],[286,"پس بپرسیدش که آبت از کجاست","دست را بر داشت کز سوی سماست","حاجیان از زاهد پرسیدند که آب تو از کجا می‌آید، چون دستش را به سمتی برد که نشان‌دهنده آسمان بود."],[286,"گفت هر گاهی که خواهی می‌رسد","بی ز چاه و بی ز حبل من مسد","او گفت: هر زمان که بخواهی می‌توانی به آب برسید، بدون نیاز به چاه و بدون نیاز به ریسمان من."],[286,"مشکل ما حل کن ای سلطان دین","تا ببخشد حال تو ما را یقین","ای سلطان دین، مشکل ما را حل کن تا ما به حال تو یقین پیدا کنیم و اعتماد کنیم که تو ما را می‌بخشی."],[286,"وا نما سری ز اسرارت بما","تا ببریم از میان زنارها","ای خدا، رازی از اسرار خود را به ما نشان بده تا بتوانیم از میان زنجیرها و محدودیت‌ها رهایی پیدا کنیم."],[286,"چشم را بگشود سوی آسمان","که اجابت کن دعای حاجیان","زاهد، چشم خود را به سمت آسمان باز کرد و از خدا خواست تا دعای حاجیان را مستجاب کند."],[286,"رزق‌جویی را ز بالا خوگرم","تو ز بالا بر گشودستی درم","خداوند، بر خلاف این که انسان‌ها در جستجوی روزی به آسمان نگاه می‌کنند، به آن‌ها کمک کرده و درهای رحمت خود را به روی آن‌ها گشوده است."],[286,"ای نموده تو مکان از لامکان","فی السماء رزقکم کرده عیان","ای کسی که تو مکان را از بی‌مکانی نشان داده‌ای، در آسمان رزق و روزی‌تان را به روشنی نمایان کرده‌ای."],[286,"در میان این مناجات ابر خوش","زود پیدا شد چو پیل آب‌کش","در میان این دعا و مناجات، ابر خوشحال و نیکو به سرعت ظاهر شد، مانند فیل که برای کشیدن آب آمده است."],[286,"همچو آب از مشک باریدن گرفت","در گو و در غارها مسکن گرفت","مثل آب که از مشک می‌ریزد، باران می‌بارید و آن زاهد در مکان‌های مختلفی مانند غارها سکونت گزیده بود."],[286,"ابر می‌بارید چون مشک اشکها","حاجیان جمله گشاده مشکها","ابر مانند مشک اشک‌ها باران می‌بارید و حاجیانی که در گرداگرد آن زاهد بودند، انگار مشک‌های مخصوصی را باز کرده‌اند و اشک‌هایشان روان شده است."],[286,"یک جماعت زان عجایب کارها","می‌بریدند از میان زنارها","گروهی از حاجیان به دلیل شگفتی‌هایی که دیدند، از زهد و پارسایی که در آن زاهد بود، به کناره‌گیری از نشانه‌های دینی و ظاهری خود، مانند زنار (بند یا زنجیر دور کمر که نشانه‌ای از دین و اعتقاد است) روی آوردند."],[286,"قوم دیگر را یقین در ازدیاد","زین عجب والله اعلم بالرشاد","گروه دیگری به خاطر این شگفتی‌ها مطمئن شده بودند که این واقعه نشانه‌ای از افزایش معنوی است و در نهایت تنها خداوند می‌داند که راه هدایت چیست."],[286,"قوم دیگر ناپذیرا ترش و خام","ناقصان سرمدی تم الکلام","قوم دیگر، ظاهرا به دلیل ناپذیری و عدم فهم درست، از آنچه برای حاجیان و زاهد در بادیه رخ داده، ترشرو و ناپخته به نظر می‌رسند؛ آن‌ها قادر به درک کامل معانی و نکات ظریف سخن نیستند."],[287,"ای ضیاء الحق حسام الدین بیار","این سوم دفتر که سنت شد سه بار","ای ضیاء الحق حسام الدین، سومین دفتر این کتاب را بیاور که این کار، سنت و رسم همیشگی شده است."],[287,"بر گشا گنجینه اسرار را","در سوم دفتر بهل اعذار را","گنجینه اسرار و دانش را بگشا و شکایت‌ها و بهانه‌ها را ممکن است که در این دفتر سوم رها کن."],[287,"قوتت از قوت حق می‌زهد","نه از عروقی کز حرارت می‌جهد","نیروی تو از خداوند می‌آید و نه از خون و رگ‌هایی که به خاطر حرارت بدن فعالیت دارند."],[287,"این چراغ شمس کو روشن بود","نه از فتیل و پنبه و روغن بود","این چراغ که نورش از شمس (خورشید) است همیشه روشن می‌ماند، نه اینکه مانند چراغ‌های معمولی که به فتیل، پنبه و روغن وابسته‌اند، روشن باشد."],[287,"سقف گردون کو چنین دایم بود","نه از طناب و استنی قایم بود","سقف آسمان که همیشه برپا است، نه به وسیله طناب یا میله‌ای ثابت شده است."],[287,"قوت جبریل از مطبخ نبود","بود از دیدار خلاق وجود","قوت و نیروی جبریل (فرشته‌ای که بر پیامبران نازل می‌شود) ناشی از خوراک مادی نیست، بلکه از مشاهده و درک خالق هستی به دست می‌آید."],[287,"همچنان این قوت ابدال حق","هم ز حق دان نه از طعام و از طبق","این نیرویی که به ابدال (برگزیدگان خدا) داده شده، نیز از ذات خداوند است و نه از غذا و ظرفی که طعام در آن قرار دارد."],[287,"جسمشان را هم ز نور اسرشته‌اند","تا ز روح و از ملک بگذشته‌اند","جسم آن‌ها از نور ساخته شده است، به طوری که از روح و دنیای ملائکه نیز فراتر رفته‌اند."],[287,"چونک موصوفی به اوصاف جلیل","ز آتش امراض بگذر چون خلیل","چون خداوند با عظمت ترا معرفی و تایید کرده پس همچون ابراهیم خلیل از گزند و تاثیر عیب‌ها و مرض‌ها بگذر و آزاد شو."],[287,"گردد آتش بر تو هم برد و سلام","ای عناصر مر مزاجت را غلام","آتش به تو نیز تسلط پیدا می‌کند و بر تو حاکم می‌شود، ای عناصر که مزاج تو را تحت فرمان داری."],[287,"هر مزاجی را عناصر مایه‌است","وین مزاجت برتر از هر پایه است","هر مزاجی از عناصر یعنی چهار عنصر اصلی طبیعی (آب، باد، آتش، خاک) تشکیل می‌شود، اما مزاج تو از همه آن‌ها والاتر و برتر است."],[287,"این مزاجت از جهان منبسط","وصف وحدت را کنون شد ملتقط","این مزاج تو، که در واقع به ویژگی‌های روحی و طبیعی تو اشاره دارد، اکنون از جهان گسترش یافته و به وصف وحدت، یعنی اتحاد و یکی شدن، دست یافته است."],[287,"ای دریغا عرصه افهام خلق","سخت تنگ آمد ندارد خلق حلق","ای وای، فضای درک و فهم مردم بسیار تنگ شده و آنها توانایی کافی برای درک معانی عمیق را ندارند."],[287,"ای ضیاء الحق به حذق رای تو","حلق بخشد سنگ را حلوای تو","ای نور حقیقت، به راستای تو، سنگ را به وسیله حلق (یعنی حلقه یا دایره) به حلوای خوشمزه تبدیل می‌کند."],[287,"کوه طور اندر تجلی حلق یافت","تا که می نوشید و می را بر نتافت","کوه طور در تجلی الهی به مقام والایی رسید و از آنجا شراب معرفت را نوشید، اما از آن لذت و شورو حالی که در آنجا بود، دچار انحراف نشد."],[287,"صار دکا منه وانشق الجبل","هل رایتم من جبل رقص الجمل","بیت به یک کوه اشاره دارد که مثل یک پرده، جسمی از سنگ و بی‌حرکت است. اما در واقع می‌توان آن را رقصان دید، مانند شترهایی که در دشت حرکت می‌کنند. این تصویر به عمق معنا و حالاتی اشاره دارد که از ظواهر مادی فراتر می‌رود."],[287,"لقمه‌بخشی آید از هر کس به کس","حلق‌بخشی کار یزدانست و بس","هر کس به دیگری نیکی و کمکی می‌کند، اما ارشاد روح و جسم انسان تنها از سوی خداوند است و فقط اوست که می‌تواند به طور واقعی جسم و روح را به یکدیگر متصل کند."],[287,"حلق بخشد جسم را و روح را","حلق بخشد بهر هر عضوت جدا","خداوند به هر کس به گونه‌ای خاص نعمت می‌دهد؛ او برای هر بخش از وجود انسان، چه جسم و چه روح، به طور جداگانه فرصتی فراهم می‌کند."],[287,"این گهی بخشد که اجلالی شوی","وز دغا و از دغل خالی شوی","این لحظه به تو بزرگی و عزت می‌بخشد و از نفاق و فریب دور می‌کنی."],[287,"تا نگویی سرّ سلطان را به کس","تا نریزی قند را پیش مگس","تا زمانی که راز سلطان را به کسی نگویی، مانند قند را پیش مگس نریز. یعنی باید رازها و اسرار ارزشمند را حفظ کنی و آنها را به کسی نگوئی، چون ممکن است دیگران از آن سوءاستفاده کنند."],[287,"گوش آنکس نوشد اسرار جلال","کو چو سوسن صدزبان افتاد و لال","کسی که با دقت به راز و عظمت خداوند توجه کند، همچون گل سوسن که ده‌ها زبان دارد و در عین حال خاموش است، به درون این اسرار گوش می‌سپارد."],[287,"حلق بخشد خاک را لطف خدا","تا خورد آب و بروید صد گیا","خدا به خاک رحمت و لطف می‌کند تا آن خاک آب را جذب کند و از آن گیاهان زیادی بیرون بیایند."],[287,"باز خاکی را ببخشد حلق و لب","تا گیاهش را خورد اندر طلب","خداوند دوباره به خاکی که حیات دارد و آن را با دلسوزی می‌بیند، محبت می‌کند تا گیاهش را بخورد و به دنبال آن برود."],[287,"چون گیاهش خورد حیوان گشت زفت","گشت حیوان لقمه انسان و رفت","زمانی که گیاه را حیوان می‌خورد، حیوان چاق و فربه می‌شود و در نتیجه، او هم لقمه‌ای برای انسان می‌شود و به این ترتیب به انسان منتقل می‌شود."],[287,"باز خاک آمد شد اکال بشر","چون جدا شد از بشر روح و بصر","زمانی که خاک به شکل انسان درآمد و روح و بینایی از انسان جدا شد، به خاک تبدیل گشت."],[287,"ذره‌ها دیدم دهانشان جمله باز","گر بگویم خوردشان گردد دراز","ذرات کوچک را دیدم که دهانشان همه باز است، اگر بگویم که آن‌ها چقدر خوردند، صحبت من طولانی می‌شود."],[287,"برگها را برگ از انعام او","دایگان را دایه لطف عام او","برگ‌ها از نعمت‌های خداوند هستند و دایگان، یعنی پرستاران و مادران، لطف و کرامت او را به همه می‌رسانند."],[287,"رزقها را رزقها او می‌دهد","زانک گندم بی غذایی چون زهد","خدای تعالی است که روزی‌ها را می‌دهد، زیرا گندم بدون تغذیه نمی‌تواند زهد و فایده‌ای داشته باشد."],[287,"نیست شرح این سخن را منتهی","پاره‌ای گفتم بدانی پاره‌ها","این سخن را نمی‌توان به‌طور کامل توضیح داد، اما من تنها بخشی از آن را برایت گفتم تا بدانی بعضی از نکات را."],[287,"جمله عالم آکل و ماکول دان","باقیان را مقبل و مقبول دان","تمام عالم را می‌توان به دو دسته تقسیم کرد: آکلی (خورنده) و ماکولی (خورده‌شده)، و برخلاف آنها، کسانی که در عالم باقی‌اند را باید به عنوان مقبول و مقبل شناخت."],[287,"این جهان و ساکنانش منتشر","وان جهان و سالکانش مستمر","این جهان و ساکنانش در حال پخش و پراکندگی هستند، اما آن جهان و سالکان آن در جا و پایدارند."],[287,"این جهان و عاشقانش منقطع","اهل آن عالم مخلد مجتمع","این جهان و عاشقان آن، ناپایدار و گذرا هستند، در حالی که اهل آن عالم مخلد (عالم جاوید) جمع و ثابت و پایدارند."],[287,"پس کریم آنست کو خود را دهد","آب حیوانی که ماند تا ابد","کریم کسی است که خود را به آب حیات می‌دهد تا جاودانه بماند، به این معنا که او با بخشش و خیرخواهی خود، به زندگی و وجودش ادامه می‌دهد."],[287,"باقیات الصالحات آمد کریم","رسته از صد آفت و اخطار و بیم","باقیات الصالحات (اعمال صالح که باقی می‌مانند) از آن کسی است که از صد آفت و خطر و ترس رهایی یافته و نیکوکار است."],[287,"گر هزارانند یک کس بیش نیست","چون خیالاتی عدد اندیش نیست","هرچند که ممکن است افراد زیادی وجود داشته باشند، اما در واقع تنها یک نفر اهمیت واقعی دارد؛ زیرا شمارش تعداد افراد تنها خیالات و تصورات ذهنی است و حقیقت آن چیز دیگری است."],[287,"آکل و ماکول را حلقست و نای","غالب و مغلوب را عقلست و رای","خوراک (آکل) و خورده‌شده (ماکول) به دست گلوی انسان است و برتری و ناتوانی در انسان به عقل و تدبیر او وابسته است."],[287,"حلق بخشید او عصای عدل را","خورد آن چندان عصا و حبل را","حلق، به معنای گردنبند، مفهوم عدالت را به دست می‌دهد که به حاکم یا رهبری که عادل است، اعطا شده است. در این بیت، گفته می‌شود که آن شخص به اندازه‌ای بر میزان و حدود آزادی و کنترل خود می‌افزاید که مانند عصا و ریسمان است؛ به عبارتی، راهنمایی و کنترل کنیدی در دست دارد که نشان‌دهنده قدرت عدل اوست."],[287,"واندرو افزون نشد زان جمله اکل","زانک حیوانی نبودش اکل و شکل","او به این دلیل که از آنچه خورده بود، اضافه‌نشده و به تعبیری از سیر و سیاحت بیشتر نشده است، زیرا در او عینیتی از نوع حیوانی وجود ندارد که به خوردن و شکل‌گیری بپردازد."],[287,"مر یقین را چون عصا هم حلق داد","تا بخورد او هر خیالی را که زاد","یقین را مانند عصا به دست او دادند تا هر تصوری که به ذهنش می‌رسد را بچشد و تجربه کند."],[287,"پس معانی را چو اعیان حلقهاست","رازق حلق معانی هم خداست","معانی مانند اشیاء و موجودات به ما داده می‌شوند و رازق (روزیش دهنده) این معانی تنها خداوند است."],[287,"پس ز مه تا ماهی هیچ از خلق نیست","که به جذب مایه او را حلق نیست","پس از ماه، هیچ چیزی در خلقت وجود ندارد که به دلیل جوشش و وجود مایه خود، حلقه‌ای (ارتباطی) با آن نداشته باشد."],[287,"حلق جان از فکر تن خالی شود","آنگهان روزیش اجلالی شود","زمانی که انسان از فکر و نگرانی‌های دنیوی خالی شود و روح او آزاد گردد، در آن شرایط از نعمت‌های بزرگ و مقام عالی برخوردار می‌شود."],[287,"شرط تبدیل مزاج آمد بدان","کز مزاج بد بود مرگ بدان","تبدیل مزاج انسان به شرایط صحت و سلامت نیاز دارد و اگر مزاج او بد باشد، علت آن مرگ و نقصان است."],[287,"چون مزاج آدمی گل‌خوار شد","زرد و بدرنگ و سقیم و خوار شد","وقتی مزاج انسان به حالتی بد و نامطلوب، مانند گل، تغییر پیدا کند، چهره‌اش زرد و بیمارگونه و مفتضح می‌شود."],[287,"چون مزاج زشت او تبدیل یافت","رفت زشتی از رخش چون شمع تافت","وقتی حال او (آدمی) به هم ریخت و زشت شد، بعد از تغییر وضعیتش، زشتی از چهره‌اش رفت و مانند شمع روشن و زیبا شد."],[287,"دایه‌ای کو طفل شیرآموز را","تا به نعمت خوش کند پدفوز را","مربی‌ای که کودک نوآموز را به خوبی تربیت کند و او را به نعمت‌ها و خوشی‌ها برساند."],[287,"گر ببندد راه آن پستان برو","برگشاید راه صد بستان برو","اگر آن پستان (منبع شیر) مسیر وجود طفل را مسدود کند، راه صد باغ و نعمت دیگر را به روی او باز می‌کند."],[287,"زانک پستان شد حجاب آن ضعیف","از هزاران نعمت و خوان و رغیف","چون مادر (یا زنی) که شیر می‌دهد، به سبب ضعف خود، مانع (دسترسی به) هزاران نعمت و سفره و غذا شده است."],[287,"پس حیات ماست موقوف فطام","اندک اندک جهد کن تم الکلام","حیات ما به تربیت و پرورش مناسب بستگی دارد، بنابراین باید به‌طور مداوم و با تلاش، گفتار و رفتار خود را اصلاح کنیم و رشد کنیم."],[287,"چون جنین بد آدمی بد خون غذا","از نجس پاکی برد مؤمن کذا","در زمان جنینی، انسان به شکل خون بود و غذایش از نوعی کثافت بود، اما مؤمن چون از پاکی بهره‌مند است، از این کثافت به دور است."],[287,"از فطام خون غذااش شیر شد","وز فطام شیر لقمه‌گیر شد","از غذای خون، شیر به وجود آمد و از شیر، لقمه لقمان(لقمه نیک) به دست آمد."],[287,"وز فطام لقمه لقمانی شود","طالب اشکار پنهانی شود","از شیر مادر که تغذیه می‌کند، طفل به جستجوی لقمه‌ای می‌افتد و چیزهایی را که هم پیداست و هم پنهان، طلب می‌کند."],[287,"گر جنین را کس بگفتی در رحم","هست بیرون عالمی بس منتظم","اگر کسی درباره نوزادی که در رحم است بگوید، در واقع به جهانی بزرگ و منظم اشاره کرده است که در انتظار اوست."],[287,"یک زمینی خرمی با عرض و طول","اندرو صد نعمت و چندین اکول","زمینی وجود دارد که سرشار از خرمی است و وسعت آن به قدری است که در آن صد نعمت و چیزهای زیادی یافت می‌شود."],[287,"کوهها و بحرها و دشتها","بوستانها باغها و کشتها","کوه‌ها، دریاها، دشت‌ها، باغ‌ها و زراعت‌ها همگی نشانه‌های سرسبزی و زیبایی طبیعت هستند."],[287,"آسمانی بس بلند و پر ضیا","آفتاب و ماهتاب و صد سها","آسمانی بسیار بلند و روشن وجود دارد که در آن آفتاب، ماه و ستاره‌های زیادی می‌درخشند."],[287,"از جنوب و از شمال و از دبور","باغها دارد عروسیها و سور","از سمت‌های مختلف، یعنی از جنوب و شمال و باد کویری، باغ‌ها پر از جشن‌ها و دلدادگی‌هاست."],[287,"در صفت ناید عجایبهای آن","تو درین ظلمت چه‌ای در امتحان","عجایب و اسرار خدای تو در وصف نمی‌آید، پس در این تاریکی (زندگی و مشکلات) تو چه چیزی را در آزمون (صبر و استقامت) نشان می‌دهی؟"],[287,"خون خوری در چارمیخ تنگنا","در میان حبس و انجاس و عنا","در این بیت، مولانا به حالتی اشاره دارد که فرد در شرایط دشوار و تنگنا قرار دارد و در عذاب و فشار احساس زندانی بودن می‌کند. خون‌خواری به معنای رنج و سختی‌هایی است که او در این وضعیت متحمل می‌شود."],[287,"او به حکم حال خود منکر بدی","زین رسالت معرض و کافر شدی","او به دلیل حال خود، بدی را انکار کرد و به خاطر این رسالت، به چیزی مانند کافر تبدیل شد."],[287,"کین محالست و فریبست و غرور","زانک تصویری ندارد وهم کور","این موضوع بر این نکته تأکید دارد که این حال و مقام، غیرممکن و فریبنده است و به خاطر آنکه واقعیت، تصویری ندارد، تفکر و درک انسان در این زمینه ناتوان است."],[287,"جنس چیزی چون ندید ادراک او","نشنود ادراک منکرناک او","چیزی که هیچ‌گاه دیده نشده، درک کردن آن نیز ممکن نیست و کسی که آن را منکر است، در واقع از درک آن چیز ناتوان است."],[287,"همچنانک خلق عام اندر جهان","زان جهان ابدال می‌گویندشان","مردم عادی در این دنیا به‌طور مداوم از جهانی دیگر صحبت می‌کنند که آن را \"ابدال\" می‌نامند. این جهانی که درباره‌اش می‌گویند، جاودانه و غیر از دنیای مادی است."],[287,"کین جهان چاهیست بس تاریک و تنگ","هست بیرون عالمی بی بو و رنگ","این جهان مانند چاهی است تنگ و تاریک که ما را در خود اسیر کرده است؛ اما فراتر از این دنیا، عالمی وجود دارد که عاری از رنگ و بوست و حقیقتی فراتر از آنچه در این جهان می‌بینیم."],[287,"هیچ در گوش کسی زیشان نرفت","کین طمع آمد حجاب ژرف و زفت","در گوش هیچ‌کس صدای آنان (حقیقت) نفوذ نکرد، زیرا طمع همچون پرده‌ای عمیق و ضخیم میان او و فهم حقیقت قرار گرفته است."],[287,"گوش را بندد طمع از استماع","چشم را بندد غرض از اطلاع","طمع باعث می‌شود که انسان نتواند به خوبی بشنود و درک کند، و همچنین هدف یا انگیزه‌ای خاص او را از آگاهی و مشاهده حقیقت بازمی‌دارد."],[287,"همچنانک آن جنین را طمع خون","کان غذای اوست در اوطان دون","همان‌طور که جنین به طمع خون برای تغذیه‌اش در مکان‌های پست و کم‌ارزش زندگی می‌کند."],[287,"از حدیث این جهان محجوب کرد","غیر خون او می‌نداند چاشت خورد","از داستان این جهان، تنها او (جنین) غذای خود را می‌شناسد و دیگران نمی‌دانند که او چگونه تغذیه می‌کند."],[288,"آن شنیدی تو که در هندوستان","دید دانایی، گروهی دوستان","در هندوستان مردی دانا را دیدند که گروهی از دوستانش را دور خود جمع کرده بود."],[288,"گرسنه مانده شده بی‌برگ و عور","می‌رسیدند از سفر از راه دور","مردم گرسنه و بی‌چیز مانده بودند و از سفرهای دور به سوی آن دانا می‌آمدند."],[288,"مهر داناییش جوشید و بگفت","خوش سلامیشان و چون گلبن شکفت","دانایی (مهر دانایی) با خوش‌روئی و محبت به آن‌ها سلام داد و مانند گلی که می‌شکفد، احساس خوبی را برانگیخت."],[288,"گفت دانم کز تجوع وز خلا","جمع آمد رنجتان زین کربلا","گفت می‌دانم که به خاطر گرسنگی و نداشتن غذا، رنج شما از این مصیبت (کربلا) جمع شده است."],[288,"لیک الله الله ای قوم جلیل","تا نباشد خوردتان، فرزند پیل","ای مردم بزرگوار، توجه کنید که اگر فرزند پیل (پیل‌زاده) نباشد، شما هم نباید بخورید."],[288,"پیل هست این سو که اکنون می‌روید","پیل‌زاده مشکرید و بشنوید","در اینجا به گروهی اشاره می‌شود که در مسیر زندگی قرار دارند. آن‌ها باید آگاه باشند که یک فیل (نماد خطر یا چالش) در پیش‌رو وجود دارد و فیل‌زاده‌ای نیز که به آن‌ها وعده داده شده (نماد عشق یا جذابیت) در خطر است. این جمله به آن‌ها هشدار می‌دهد که باید محتاط باشند و از موانع دوری کنند."],[288,"پیل‌بچگانند اندر راهتان","صید ایشان هست بس دلخواهتان","پیل‌بچه‌ها در مسیر شما هستند و شکار آن‌ها برای شما بسیار دلپذیر است."],[288,"بس ضعیف‌اند و لطیف و بس سمین","لیک مادر هست طالب در کمین","اینها بسیار ضعیف و حساس هستند، ولی مادرشان (نظیر یک مراقب یا محافظ) در کمین است تا از آنها مراقبت کند."],[288,"از پی فرزند صد فرسنگ راه","او بگردد در حنین و آه آه","مادر برای پیدا کردن فرزندش حتی صد فرسنگ راه را با ناله و فغان طی می‌کند."],[288,"آتش و دود آید از خرطوم او","الحذر زان کودک مرحوم او","از خرطوم آن کودک، آتش و دود به وجود می‌آید، پس باید از خطر آن کودک نجات پیدا کرد، زیرا او (کودک) می‌تواند موجب آسیب شود."],[288,"اولیا اطفال حق‌اند ای پسر","غایبی و حاضری بس با خبر","فرزندان و بزرگان، از اوصاف الهی و در حقیقت، نشانه‌های حق‌تعالی هستند، ای پسر! غایب و حاضر، به طور کامل از احوال این فرزندان آگاه است."],[288,"غایبی مندیش از نقصانشان","کاو کشد کین از برای جانشان","درباره اطفال حق، نگران نقص و کمبود آن‌ها نباش، زیرا آن‌ها برای حفظ جان خود از دشمنی‌ها و کینه‌ها مأموریتی دارند."],[288,"گفت: اطفال من‌اند این اولیا","در غریبی فرد، از کار و کیا","این اولیا (دوستان خدا) مانند اطفال و کودکان من هستند و در حالتی بی‌کسی و تنهایی به سر می‌برند، زیرا از کار و کردار درست دورند."],[288,"از برای امتحان، خوار و یتیم","لیک اندر سر، منم یار و ندیم","برای آزمایش، خوار و یتیم هستند، اما در باطن من همراه و یاور آنها هستم."],[288,"پشت‌دار جمله عصمت‌های من","گوییا هستند خود، اجزای من","تمام ویژگی‌های پاکی و معصومیت من، به نظر می‌رسد که خودشان، بخش‌هایی از وجود من باشند."],[288,"هان و هان این دلق‌پوشان من‌اند","صد هزار اندر هزار و یک تن‌اند","من متوجه شده‌ام که این دلق‌پوشان، که به نوعی نشان‌دهنده‌ی ظاهر و ظواهر من هستند، بسیار زیاد و در شمار بی‌نهایتند."],[288,"ورنه کی کردی به یک چوبی هنر","موسی‌یی‌، فرعون را زیر و زبر‌؟","آیا تو با یک چوب، که از قدرت موسی سرچشمه گرفته، توانستی فرعون را به زیر و رو بکنی؟"],[288,"ورنه کی کردی به یک نفرین بد","نوح، شرق و غرب را غرقاب خود‌؟","اگر نه، چگونه توانستی با یک نفرین بد نوح، تمام شرق و غرب را غرق در آب کنی؟"],[288,"برنکندی یک دعای لوط راد","جمله شهرستانشان را بی‌مراد","اگر دعای لوط بر قومش مستجاب می‌شد، همه شهرها به عذاب گرفتار می‌آمدند و هیچ‌کدام به مقصود و خواسته‌شان نمی‌رسیدند."],[288,"گشت شهرستان چون فردوسشان","دجله آب سیه‌، رو بین نشان","شهرستان آن‌ها به مانند بهشت شده بود و بر روی آب سیاه دجله، نشانه‌ای از آن را می‌توان دید."],[288,"سوی شام‌ست این نشان و این خبر","در ره قدسش ببینی در گذر","این نشانه و خبر به سمت شام است و اگر در مسیر خود به قدس بروی، آن را خواهی دید."],[288,"صد هزاران ز انبیای حق‌پرست","خود به‌هر قرنی سیاست‌ها به‌دست","هر سال، صدها هزار پیامبر راستین به دنیا می‌آیند که هر کدام از آنان در زمان خود، روش‌های مناسب برای هدایت و اداره مردم را ارائه می‌دهند."],[288,"گر بگویم وین بیان افزون شود","خود، جگر چبود که که‌ها خون شود","اگر بخواهم بیشتر از این صحبت کنم، خودم را مجبور می‌کنم که درد و رنج کشیده شوم، چون گویا کلماتی که می‌گویم همچون کاهی است که به کوه‌ها خون خواهد داد."],[288,"خون شود که‌ها و باز آن بفسرد","تو نبینی خون‌شدن‌، کوری و رد","اگر کوه‌ها خون شوند و تو همچنان آن را نبینی، نتیجه‌اش این است که تو دچار کوری و نادانی شده‌ای و نمی‌توانی واقعیت‌ها را درک کنی."],[288,"طرفه کوری دوربین تیزچشم","لیک از اشتر نبیند غیر پشم","کور است آن کسی که با وجود بینایی، نمی‌تواند واقعیت‌ها را درست ببیند. مانند چشمان تیزبین شخصی که فقط پشم یک شتر را می‌بیند و از چیزهای بزرگتر و مهم‌تر غافل است."],[288,"مو به مو بیند ز صرفه حرص انس","رقص بی‌مقصود دارد همچو خرس","انسان حریص به جزئیات و نکات ریز بسیار توجه می‌کند اما مانند خرسی که به رقصی بی‌هدف و بی‌معنا مشغول است، به فعالیت‌های بی‌فایده می‌پردازد."],[288,"رقص آنجا کن که خود را بشکنی","پنبه را از ریش شهوت برکنی","در جایی که خودت را از خواسته‌ها و تمایلات ناپسند بشکنی و از بین ببری، به شادی بپرداز، مثل این‌که پشم را از روی ریش شهوت جدا می‌کنی."],[288,"رقص و جولان بر سر میدان کنند","رقص اندر خون خود مردان کنند","مردان خدا در خون خود رقصیدند و همواره در میدان نبرد(همچون نبرد جهاد بیرون و جهاد نفس درون) جولان و رقص میدان میکنند"],[288,"چون رهند از دست خود دستی زنند","چون جهند از نقص خود رقصی کنند","هنگامی که انسان از دست نفس پست خود رها میشود دست به کار میشود و چون از نقص نفس خود رها شود رقص میدان نبرد میکند( رقص میدان نبرد با دشمن درون یعنی نفس اماره و دشمن بیرون)"],[288,"مطربانشان از درون، دف می‌زنند","بحرها در شورشان کف می‌زنند","موسیقی‌دانان درون‌شان شادی و نشاطی دارند و این شور و احساسات باعث می‌شود که دست به کف‌زنی بزنند، مانند افرادی که در دریا به خوشحالی و شادمانی می‌پردازند."],[288,"تو نبینی لیک بهر گوششان","برگ‌ها بر شاخ‌ها هم کف‌زنان","تو نمی‌بینی، اما برای گوش‌هایشان، برگ‌ها روی شاخه‌ها نیز در حال کف زدن و صدا دادن هستند."],[288,"تو نبینی برگ‌ها را کف‌زدن","گوش دل باید نه این گوش بدن","تو با گوش بدن نمی‌توانی صدای برگ‌ها را بشنوی؛ فقط با گوش دل و با باطن خود می‌توانی به این حقیقت پی ببری."],[288,"گوش سر بربند از هزل و دروغ","تا ببینی شهر جان با‌فروغ","باید گوش جان را از حرف‌های بی‌مورد و دروغ جدا کنی تا بتوانی زیبایی و روشنی روح خود را ببینی."],[288,"سر کشد گوش محمد در سخن","کش بگوید در نبی حق هو اذن","گوش محمد تنها به سخن حق گوش می‌دهد و از دیگر سخنان خود را دور می‌کند؛ او تنها به پیام‌های واقعی و راستین نبی توجه می‌کند."],[288,"سر‌به‌سر، گوش‌ست و چشم است این نبی","تازه زو ما مرضع‌ست او، ما صبی","این نبی، که به تازگی آمده، به تمام معنا گوش و چشم است، یعنی قادر به شنیدن و دیدن همه چیز است، اما ما از لحاظ روحی به او نیاز داریم و در حقیقت او می‌تواند ما را تغذیه کند و هدایت نماید."],[288,"این سخن، پایان ندارد باز ران","سوی اهل پیل و بر آغاز ران","این حرف هرگز تمام شدنی نیست و دوباره به سمت افرادی که خود را به‌دلیل حرص در چنگال مشکلات گرفتار کرده‌اند، برمی‌گردد و دوباره به شروع آن موضوع اشاره می‌کند."],[289,"هر دهان را پیل بویی می‌کند","گرد معده هر بشر بر می‌تند","هر دهانی که باز شود، بوی ناخوشایند ناشی از رنج و سختی‌های هر فرد را بیرون می‌دهد، انگار که این بو شبیه بوی فیل است و از دل و معده‌اش نشات می‌گیرد."],[289,"تا کجا یابد کباب پور خویش","تا نماید انتقام و زور خویش","مردم تا کجا به کشتن فرزندان خود ادامه خواهند داد و تا چه زمانی می‌خواهند به خاطر قدرت و انتقام‌جویی، اعمال غیرانسانی را انجام دهند؟"],[289,"گوشت‌های بندگان حق خوری","غیبت ایشان کنی، کیفر بری","وقتی گوشت بندگان حق را می‌خوری و غیبت می‌کنی؛ سزای آن را خواهی دید (اشاره است به آیه ۱۲ سوره حجرات که تاثیر غیبت کردن را بر شخص بدگو همانند خوردن گوشت برادر مرده بیان می‌کند)"],[289,"هان که بویای دهانتان خالق است","کی برد جان غیر آن کاو صادق است؟","اوه، بوی دهان شما نشان‌دهنده‌ای از خالق است، چگونه ممکن است جان کسی به جز آن کسی که راستگو و صادق است، از شما برداشته شود؟"],[289,"وای آن افسوسیی کش بوی‌گیر","باشد اندر گور منکر یا نکیر","آه بر آن کسی که بوی خوش دارد و در روز قیامت، هنگامی که منکر و نکیر (دو فرشته‌ای که از انسان در قبر سوال می‌کنند) پیش او آیند، بوی او را نمی‌پذیرند و او را به خاطر این بوی بد، افسوس خواهد خورد."],[289,"نه دهان دزدیدن امکان زان مهان","نه دهان خوش کردن از دارو‌دهان","برای آن افراد مهم (یا بزرگان) که در آنجا هستند، امکان دزدیدن دهان (یعنی صحبت کردن) وجود ندارد، و همچنین نمی‌توان دهان را (با دارویی) خوشبو کرد و خوش صحبت کرد."],[289,"آب و روغن نیست مر روپوش را","راه حیلت نیست عقل و هوش را","هیچ راهی برای پنهان کردن نقشه یا لباس تزویر وجود ندارد و نمی‌توان با فریب و نیرنگ، عقل و هوش را گمراه کرد."],[289,"چند کوبد زخم‌های گرزشان","بر سر هر ژاژخا و مرزشان","عزرائیل، فرشته مرگ، بر سر هر کسی که در کارهای زشت و بی‌فایده خود مشغول است، ضربه می‌زند و او را مجازات می‌کند. این اشارات به کسانی است که در زندگی‌شان از اصول و راه‌های صحیح دور شده‌اند."],[289,"گرز عزرائیل را بنگر اثر","گر نبینی چوب و آهن در صور","اگر اثر گرز عزرائیل، فرشته مرگ، را نبینی، دیگر چوب و آهن را هم در جسم‌ها نمی‌بینی. یعنی اگر باطن و معنای مرگ را درک نکنی، حتی نشانه‌های ظاهری مانند چوب و آهن نیز در وجود آدم‌ها برایت ناپیدا خواهد بود."],[289,"هم به‌صورت می‌نماید گه‌گهی","زان همان رنجور باشد آگهی","گاهی اوقات، او (رنجور) به‌صورت ظاهر نشان می‌دهد، اما این نشانگر (حالت) بیماری‌اش است و خبر از حال او می‌دهد."],[289,"گوید آن رنجور ای یاران من","چیست این شمشیر بر ساران من","آن رنجور می‌گوید، ای دوستان، این شمشیر چیست که بر سر من قرار گرفته است؟"],[289,"ما نمی‌بینیم باشد این خیال","چه خیالست این که این هست ارتحال","ما نمی‌توانیم واقعیت را ببینیم و تصور می‌کنیم که این حالت ما فقط یک خیال است. چه خیالی است که این وضعیت، یعنی مرگ یا جدایی، برای ما به وجود آمده است؟"],[289,"چه خیالست این که این چرخ نگون","از نهیب این خیالی شد کنون","این خیال که این دنیا به سبب تأثیرات خیال‌ها و تصورات ما در حال تغییر و توجه است، چه نوع خیالی است. به عبارتی، آیا این تغییرات واقعی هستند یا فقط ناشی از تخیلات ما هستند؟"],[289,"گرزها و تیغ‌ها محسوس شد","پیش بیمار و سرش منکوس شد","رنج‌ها و مشکلات، برای بیمار به وضوح قابل احساس می‌شود و او به خاطر دردی که دارد، سرش به سمت زمین خم شده است."],[289,"او همی‌بیند که آن از بهر اوست","چشم دشمن بسته زان و چشم دوست","او (بیمار) می‌بیند که آن (خطر و آسیب) برای خودش است و دشمنش به خاطر او چشمانش را بسته و دوستش به خاطر او چشمانش را باز کرده است."],[289,"حرص دنیا رفت و چشمش تیز شد","چشم او روشن گه خون‌ریز شد","به سبب حرص به دنیا، نگاه آن شخص تیز و نافذ شد و دیدش روشن گردید، اما این روشن‌بینی به سبب خون‌ریزی و ناملایماتی است که به وجود آورده است."],[289,"مرغ بی‌هنگام شد آن چشم او","از نتیجه کبر او و خشم او","چشم او بی‌موقع و در زمان نامناسب فعالیت کرد و این ناشی از تکبر و خشم اوست."],[289,"سر بریدن واجب آید مرغ را","کاو به غیر وقت جنباند درا","آن مرغ که در غیر زمان و مکان مناسب خود، به تحریک و جنبش درآید، مستحق سر بریدن است."],[289,"هر زمان نزعی‌ست جزو جانت را","بنگر اندر نزع جان ایمانت را","هر زمانی که جان تو در حال جدایی است، اجزای وجودت را ببین و به حالتی که جان ایمانت رو به زوال است، توجه کن."],[289,"عمر تو مانند همیان زر‌ست","روز و شب مانند دینار اشمر‌ست","عمر تو مانند کیسه‌ای پر از طلاست و روزها و شب‌ها مانند سکه‌های طلا، باید آنها را شمرد و حساب کرد."],[289,"می‌شمارد می‌دهد زر بی‌وقوف","تا که خالی گردد و آید خسوف","انسان در زندگی‌اش به‌طور نا آگاهانه و بدون توجه به معنای واقعی، مال و ثروت را می‌شمارد و می‌گیرد تا اینکه تمام شود و کسادی و افول به سراغش آید."],[289,"گر ز که بستانی و ننهی بجای","اندر آید کوه زان دادن ز پای","اگر از کوه طلا بگیری و آن را به جای دیگری نگذاری، کوه دوباره به همان جای خود برمی‌گردد؛ زیرا دلیلی برای ترک کردن آن ندارد."],[289,"پس بنه بر جای هر دم را عوض","تا ز «واسجد واقترب» یابی غرض","هر لحظه در کار خود تغییر و دگرگونی ایجاد کن تا به هدف و مقصود «سجده کن و نزدیک شو» دست یابی."],[289,"در تمامی کارها چندین مکوش","جز به کاری که بود در دین مکوش","در تمام کارها تلاش زیادی نکن، جز در کاری که مربوط به دین و معنویت است."],[289,"عاقبت تو رفت خواهی ناتمام","کارهاات ابتر و نان تو خام","در نهایت، اگر بدون توجه به اصول دین و کارهای درست تلاش کنی، نتیجه‌اش این خواهد بود که کارهایت ناتمام و ناقص می‌ماند و روزی می‌رسد که از نتیجه‌اش چیزی به دست نخواهی آورد."],[289,"وان عمارت کردن گور و لحد","نه به سنگست و به چوب و نه لبد","ساختن گور و آرامگاه تنها با سنگ و چوب و دیگر مصالح نیست، بلکه باید به معنای عمیق‌تری از آن توجه شود."],[289,"بلک خود را در صفا گوری کنی","در منی‌ او کنی دفن منی","بلکه باید خودت را در صفای وجودت مدفون کنی، نه در منیت و خودپرستی‌ات. اگر بتوانی خودخواهی‌ات را کنار بگذاری و عملا خود را در خوشی و پاکی نهان کنی، به حقیقت نزدیک‌تر می‌شوی."],[289,"خاک او گردی و مدفون غمش","تا دمت یابد مددها از دمش","اگر تو به انجام کارهای خوب و نیک بپردازی، حسی از غم و اندوه او (خدا یا معشوق) در وجودت باقی می‌ماند و این حس به تو کمک می‌کند که از برکات و عنایات او بهره‌مند شوی."],[289,"گورخانه و قبه‌ها و کنگره","نبود از اصحاب معنی آن سره","در عالم معنوی و حقیقت، گورخانه‌ها و بناهای زیبا اهمیتی ندارند و از اصحاب و اندیشمندان واقعی، هیچ‌گونه آگاهی و بصیرتی را نمی‌توان یافت."],[289,"بنگر اکنون زنده اطلس‌پوش را","هیچ اطلس دست گیرد هوش را؟","اکنون بنگر که زنده‌ای که لباس اطلس بر تن دارد، آیا هیچ پارچه اطلسی می‌تواند عقل و هوش او را در دست بگیرد یا کنترل کند؟"],[289,"در عذاب منکرست آن جان او","گزدم غم در دل غمدان او","آن روحی که در عذاب است، منکر حقیقت است و غم در دل او مانند زنبور مانند غم‌خواران دردناک می‌زند."],[289,"از برون بر ظاهرش نقش و نگار","وز درون ز اندیشه‌ها او زار زار","ظاهر او پر از تزیین و زیبایی است، اما در درونش از اندیشیدن و فکر کردن، غمگین و ویران به نظر می‌رسد."],[289,"و آن یکی بینی در آن دلق کهن","چون نبات اندیشه و شکر سخن","و یکی از آن‌ها را می‌بینی که در آن لباس کهنه مانند گیاهی است که از اندیشه و سخنان شیرین ساخته شده است."],[290,"گفت ناصح بشنوید این پند من","تا دل و جانتان نگردد ممتحن","ناصح (پنددهنده) گفت: این نصیحت مرا بشنوید، تا دل و جان شما آزمایش نشود و دچار سختی و چالش نگردد."],[290,"با گیاه و برگها قانع شوید","در شکار پیل‌بچگان کم روید","به جای اینکه به دنبال شکار فیل‌زاده‌ها باشید، با گیاه و برگ‌ها سیر کنید و قناعت کنید."],[290,"من برون کردم ز گردن وام نصح","جز سعادت کی بود انجام نصح","من از گردن دین و نصیحت نجات یافتم، زیرا جز سعادت نتیجه‌ای از نصیحت نیست."],[290,"من به تبلیغ رسالت آمدم","تا رهانم مر شما را از ندم","من آمده‌ام تا پیام رسالت را به شما برسانم و شما را از بدبختی و عذاب نجات دهم."],[290,"هین مبادا که طمع رهتان زند","طمع برگ از بیخهاتان بر کند","مراقب باشید که طمع، شما را به انحراف نکشاند و مانند چیدن برگ از درخت، از ریشه و اصل شما جدا نشود."],[290,"این بگفت و خیربادی کرد و رفت","گشت قحط و جوعشان در راه زفت","این را گفت و با خیالی خوش به راه خود ادامه داد. در این حال، قحطی و گرسنگی آن‌ها را در سفر، به شدت آزار می‌دهد."],[290,"ناگهان دیدند سوی جاده‌ای","پور پیلی فربهی نو زاده‌ای","ناگهان دیدند که در سمت جاده، پسر فیلی فربه و جوان به دنیا آمده است."],[290,"اندر افتادند چون گرگان مست","پاک خوردندش فرو شستند دست","آنها مانند گرگ‌های مست به او حمله کردند و بدون رفع شکیبایی، او را درو کردند و از کف دادند."],[290,"آن یکی همره نخورد و پند داد","که حدیث آن فقیرش بود یاد","یکی از همراهان چیزی نخورده و نصیحت کرد که آن حکایت درباره آن فقیر را به یاد آورد."],[290,"از کبابش مانع آمد آن سخن","بخت نو بخشد تو را عقل کهن","سخن تازه‌ای که در اینجا می‌گویند، باعث می‌شود که مشکلات و موانع برطرف شود و برکت و خوشبختی به تو داده شود. عقل قدیمی نمی‌تواند به تو در این زمینه کمک کند."],[290,"پس بیفتادند و خفتند آن همه","وان گرسنه چون شبان اندر رمه","پس آنها بر زمین افتادند و خوابشان برد و گرسنه‌ها مانند شبانی که در میان رمه است، آرام و بی‌خبر نشستند."],[290,"دید پیلی سهمناکی می‌رسید","اولا آمد سوی حارس دوید","یک فیل بزرگ و ترسناک در حال نزدیک شدن بود و در ابتدا به سمت نگهبان می‌دوید."],[290,"بوی می‌کرد آن دهانش را سه بار","هیچ بویی زو نیامد ناگوار","دهان آن پیل بویی را که ناشی از حالت خاصش بود، سه بار در فضا انتشار داد، اما هیچ بویی از او به مشام نیامد که ناپسند باشد."],[290,"چند باری گرد او گشت و برفت","مر ورا نازرد آن شه‌پیل زفت","شه‌پیل زفت (فیلی بزرگ و نیرومند) چندین بار دور آن شخص (که به نظر می‌رسد در خواب است) چرخید و رفت، اما هیچ آسیبی به او نرساند."],[290,"مر لب هر خفته‌ای را بوی کرد","بوی می‌آمد ورا زان خفته مرد","هر کسی که خوابیده باشد، بوی او را احساس کرد. بوی شراب از خفته‌ای به مشام می‌رسید که مردی از آن خواب برخاسته است."],[290,"از کباب پیل‌زاده خورده بود","بر درانید و بکشتش پیل زود","پیل‌زاده که به خاطر خوردن کباب، خشمگین شده بود، به سرعت به آن شخص حمله‌ور شد و او را کشت."],[290,"در زمان او یک به یک را زان گروه","می‌درانید و نبودش زان شکوه","در آن زمان، یکی از اعضای آن گروه را می‌درید و آسیبی به او می‌زد، و به خاطر این کار، از آن شکایت و ناله‌ای نمی‌کرد."],[290,"بر هوا انداخت هر یک را گزاف","تا همی‌زد بر زمین می‌شد شکاف","هر یک از آن‌ها را به‌سرعت و بی‌ملاحظه به هوا می‌افکند تا زمین به ضربه‌ای که از سقوط آن‌ها می‌خورد، شکاف بردارد."],[290,"ای خورنده خون خلق از راه برد","تا نه آرد خون ایشانت نبرد","ای کسی که خون مردم را می‌خوری و از طریق نادرست به سود خود می‌رسی، اگر روزی خون خودت به دست دیگران ریخته شود، در آن صورت چه فایده‌ای خواهد داشت؟"],[290,"مال ایشان خون ایشان دان یقین","زانک مال از زور آید در یمین","اموال مردم در حقیقت همان خون آنان است، زیرا این اموال از طریق ظلم و زور به دست آمده‌اند."],[290,"مادر آن پیل‌بچگان کین کشد","پیل بچه‌خواره را کیفر کشد","مادر آن بچه‌پیل‌ها که به پدرشان آسیب می‌زند، می‌آید و کودک زیاده‌خواه و شکارچی را مجازات می‌کند."],[290,"پیل‌بچه می‌خوری ای پاره‌خوار","هم بر آرد خصم پیل از تو دمار","ای کسی که از نوزادان فیل می‌خوری و آن‌ها را می‌کشانی، بدان که دشمن هم از تو انتقام خواهد گرفت و بر ضد تو اقدام خواهد کرد."],[290,"بوی رسوا کرد مکر اندیش را","پیل داند بوی طفل خویش را","بوی رسوایی موجب می‌شود که انسان‌های مکار و فریبکار شناخته شوند، اما همان‌طور که فیل بوی فرزندش را تشخیص می‌دهد، انسان نیز باید به حقیقت و واقعیت‌ها آگاه باشد و آن‌ها را بشناسد."],[290,"آنک یابد بوی حق را از یمن","چون نیابد بوی باطل را ز من","کسی که بوی حقیقت را از یمن (سرزمین یمن که به اعتبار و صفا مشهور است) می‌گیرد، هرگز نمی‌تواند بوی باطل را از من بگیرد."],[290,"مصطفی چون برد بوی از راه دور","چون نیابد از دهان ما بخور","چون پیامبر (مصطفی) از دور بویی (را) می‌گیرد، وقتی نمی‌تواند از دهان ما طعمی (را) بچشد."],[290,"هم بیابد لیک پوشاند ز ما","بوی نیک و بد بر آید بر سما","هم اگر عطر و بوی خوب و بد از او بیافتد، اما نمی‌تواند آن را از ما پنهان کند؛ بوی بد بر آسمان می‌رود."],[290,"تو همی‌خسپی و بوی آن حرام","می‌زند بر آسمان سبزفام","تو در حال ناپاکی و بوی ناپاک تو به درگاه آسمان می‌رسد و آن را آلوده می‌کند."],[290,"همره انفاس زشتت می‌شود","تا به بوگیران گردون می‌رود","بادی که از نفس‌های زشت تو برخاسته است، تا به آسمان‌ها می‌رسد و بوی آن به محیط اطراف نفوذ می‌کند."],[290,"بوی کبر و بوی حرص و بوی آز","در سخن گفتن بیاید چون پیاز","وقتی که انسان با کبر، حرص و آز سخن می‌گوید، بوی آن‌ها مانند بوی پیاز در کلامش حس می‌شود."],[290,"گر خوری سوگند من کی خورده‌ام","از پیاز و سیر تقوی کرده‌ام","اگر قسم یاد کنی، من از چه چیزی خورده‌ام؟ من به معنای واقعی از پیاز و سیر پرهیز کرده‌ام و تقوا پیشه کرده‌ام."],[290,"آن دم سوگند، غمازی کند","بر دماغ همنشینان بر زند","زمانی که کسی سوگند یاد می‌کند، این سوگند ممکن است به گمان دیگران به فضیلت او اشاره کند، اما در حقیقت باعث عیب‌جویی و بی‌اعتمادی در نظر همنشینان می‌شود."],[290,"پس دعاها رد شود از بوی آن","آن دل کژ می‌نماید در زبان","دعای خیر و نیکویی که از دل برمی‌آید، به خاطر بدی و ناپاکی که در دل وجود دارد، پذیرفته نمی‌شود و بنابراین زبان هم برای بیان این دعا کژ و غیرصادقانه می‌شود."],[290,"اخسؤا آید جواب آن دعا","چوب رد باشد جزای هر دغا","اگر دعای کسی ناپسند باشد، پاسخ آن هم ناپسند و نامناسب می‌آید؛ زیرا هر عمل نادرستی جزا و نتیجه‌ای همانند خود دارد."],[290,"گر حدیثت کژ بود معنیت راست","آن کژی لفظ مقبول خداست","اگر گفتارت باطل و نادرست باشد، ولی در واقع از دل تو حقیقتی وجود داشته باشد، آن نادرستی لفظی در نظر خداوند پذیرفته است."],[291,"آن بلال صدق در بانگ نماز","حی را هی همی‌خواند از نیاز","بلال، مؤذن رسول خدا (پیامبر اسلام)، با صدای حقیقی و از روی نیاز دعا می‌کند و اذان می‌گوید."],[291,"تا بگفتند ای پیمبر نیست راست","این خطا اکنون که آغاز بناست","در این بیت، کسانی به پیامبر می‌گویند که این اشتباه درست نیست، چرا که هنوز روند کار تازه شروع شده و ممکن است که اوضاع تغییر کند."],[291,"ای نبی و ای رسول کردگار","یک مؤذن کو بود افصح بیار","ای پیامبر و ای فرستاده خدا، یک مؤذن (آواز خوان نماز) که از نظر بیان و سخنرانی بهتر و شایسته‌تر است، بیاورید."],[291,"عیب باشد اول دین و صلاح","لحن خواندن لفظ حی عل فلاح","اگر در دین، صدای زیبا و لحن خوب در خواندن آیه‌های قرآن نباشد، این نقصی محسوب می‌شود. در واقع، حتی اگر لحن و نحوه خواندن صحیح نباشد، باطل بودن دین به حساب می‌آید، چرا که این جملات به فلاح و سعادت معنوی انسان‌ها اشاره دارند."],[291,"خشم پیغمبر بجوشید و بگفت","یک دو رمزی از عنایات نهفت","خشم پیامبر (حضرت محمد) برانگیخته شد و گفت یک یا دو اشاره به نعمت‌های پنهان الهی کرد."],[291,"کای خسان نزد خدا هی بلال","بهتر از صد حی و خی و قیل و قال","ای انسان‌های بی‌خود و بی‌فایده، بلال، مؤذن پیامبر، در پیشگاه خداوند ارزشش به اندازه‌ای بیشتر از صد انسان پر از حرف و سخن بی‌معنا است."],[291,"وا مشورانید تا من رازتان","وا نگویم آخر و آغازتان","به من بگویید که رازهایتان را فاش نکنم، زیرا از ابتدا تا انتهای وجودتان را نمی‌شناسم."],[291,"گر نداری تو دم خوش در دعا","رو دعا می‌خواه ز اخوان صفا","اگر تو در دعا حال خوشی نداری، بهتر است که از دوستان صمیمی خود دعا بخواهی."],[292,"گفت ای موسی ز من می‌جو پناه","با دهانی که نکردی تو گناه","وحی شد: ای موسی، از من با دهان و لبی که با آن گناه نکرده‌ای کمک بخواه (تا مستجاب شود)"],[292,"گفت موسی من ندارم آن دهان","گفت ما را از دهان غیر خوان","موسی گفت: من چنین دهان و لب (پاکی) ندارم، گفت: پس از دهان دیگران از من کمک بخواه"],[292,"از دهان غیر کی کردی گناه؟","از دهان غیر بر خوان کای اله","موسی می‌گوید که از دهان دیگری چگونه می‌توان گناه کرد، در حالی که ای خدا، تو مرا از دهان دیگری خواندی."],[292,"آنچنان کن که دهان‌ها مر تو را","در شب و در روزها آرد دعا","(یعنی) کاری کن و چنان رفتار کن که دیگران، شب و روز تو را دعای خیر کنند."],[292,"از دهانی که نکرده‌ستی گناه","و آن دهان غیر باشد عذر خواه","از دهانی که نه گناهی از آن سر زده، باید از آن به عنوان عذر و پوزش استفاده کنی و دیگران را از خطاهای خود عذرخواهی کن."],[292,"یا دهان خویشتن را پاک کن","روح خود را چابک و چالاک کن","برای اینکه به حقیقت و معنای واقعی نزدیک شوی، باید زبانت را از آلودگی‌ها پاکسازی کنی و روح خود را آماده و پرانرژی نگه‌داری."],[292,"ذکر حق پاکست چون پاکی رسید","رخت بر بندد برون آید پلید","ذکر خداوند پاک و پاکیزه است و وقتی پاکی وجود داشته باشد، ناپاکی و پلیدی از آن دور می‌شود."],[292,"می‌گریزد ضدها از ضدها","شب گریزد چون بر افروزد ضیا","ضدها از یکدیگر فرار می‌کنند، همان‌طور که شب از روشنایی می‌گریزد وقتی که روشنی (صبح) طلوع می‌کند."],[292,"چون در آید نام پاک اندر دهان","نه پلیدی ماند و نه اندهان","زمانی که نام پاک خداوند در زبان جاری شود، دیگر پلیدی و سخنان ناپسند در آن زبان به جا نمی‌ماند."],[293,"آن یکی الله می‌گفتی شبی","تا که شیرین می‌شد از ذکرش لبی","يکي بود که نام خدا را شبها زمرمه مي‌کرد و لبانش با اين ذکر شيرين مي‌شد"],[293,"گفت شیطان: آخر ای بسیارگو","این همه الله را لبیک کو؟","شيطان گفت اي کسي که زياد ذکر خدا مي‌گويي آخر يک بار خدا جوابت را داد؟"],[293,"می‌نیاید یک جواب از پیش تخت","چند الله می‌زنی با روی سخت","آخر نبايد از طرف خدا يک جواب بيايد؟ چقدر الله مي‌گويي با سختي؟"],[293,"او شکسته‌دل شد و بنهاد سر","دید در خواب او خضر را در خضر","او دلشکسته شد و سرش را به زمین گذاشت و در خواب خضر (خضر، پیامبری حکمت و علم) را در حالتی دید که به او نگاه می‌کند."],[293,"گفت هین از ذکر چون وا مانده‌ای","چون پشیمانی از آن که‌ش خوانده‌ای","خضر به او می‌گوید: ای کسی که از ذکر و یاد خدا غافل مانده‌ای، چرا پشیمان هستی از آنچه که خوانده‌ای و به آن عمل نکرده‌ای؟"],[293,"گفت لبیکم نمی‌آید جواب","زان همی‌ترسم که باشم رد باب","می‌گوید: من نمی‌توانم به «لبیک» شما (پاسخ مثبت به فراخوان) بگویم، چون می‌ترسم که مبادا از درگاه شما طرد شوم."],[293,"گفت آن الله تو لبیک ماست","و آن نیاز و درد و سوزت، پیک ماست","خدای تو می‌گوید که پاسخ ما لبیک است و آن نیاز و درد و سوزی که داری، پیام‌آور ماست."],[293,"حیله‌ها و چاره‌جویی‌های تو","جذب ما بود و گشاد این پای تو","حیله‌ها و تدبیرهایی که تو به کار می‌بری، ما را جذب خود می‌کند و راهی به سوی تو باز می‌کند."],[293,"ترس و عشق تو کمند لطف ماست","زیر هر یا‌ربّ تو لبیک‌هاست","ترس و عشق تو به خداوند، مایه لطف و رحمت ماست و در زیر هر ندا و فریاد «یا رب» تو، پاسخ‌ها و لبیک‌هایی وجود دارد."],[293,"جان جاهل زین دعا جز دور نیست","زانک یا رب گفتنش دستور نیست","جان نادان از این دعا دور است، زیرا او فقط «یا رب» گفتن را به جا می‌آورد بدون آنکه درکش کند و نیازی به آن در وجودش نباشد."],[293,"بر دهان و بر دلش قفل است و بند","تا ننالد با خدا وقت گزند","کسی که ignorant (جاهل) است، به دلیل عدم آگاهی و درک، نمی‌تواند حقیقتا با خداوند ارتباط برقرار کند و در زمان گرفتاری و مصیبت، نمی‌تواند از درد و رنج‌های خود بگوید و ناله کند."],[293,"داد مر فرعون را صد ملک و مال","تا بکرد او دعوی عزّ و جلال","فرعون را به او ملک و ثروت زیاد دادند تا او ادعای عظمت و بزرگی کند."],[293,"در همه عمرش ندید او درد سر","تا ننالد سوی حق آن بدگهر","فرعون در تمام زندگی‌اش هیچ درد و رنجی را تجربه نکرد، بنابراین هرگز به سوی خداوند دعا نکرد و به او شکایت نکرد، چرا که او از جنس بدی و لئامت بود."],[293,"داد او را جمله ملک این جهان","حق ندادش درد و رنج و اندهان","تمامی نعمت‌های این جهان متعلق به اوست، اما خداوند به او درد، رنج و اندوه عطا نکرده است."],[293,"درد آمد بهتر از ملک جهان","تا بخوانی مر خدا را در نهان","درد و رنج از داشتن این دنیا بهتر است، چراکه با درد می‌توانی به یاد خدا بیفتی و در دل او را بخوانی."],[293,"خواندن بی‌درد از افسردگی‌ست","خواندن با درد از دل‌بردگی‌ست","خواندن و ذکر خداوند بدون احساس درد و رنج نشانه‌ی افسردگی و ناامیدی است، اما خواندن و گفتن نام خدا با وجود درد و اندوه ناشی از عشق و وابستگی، از دلبرگرفتگی و دل‌سوزی ناشی می‌شود."],[293,"آن کشیدن زیر لب آواز را","یاد کردن مبدأ و آغاز را","آوازی که زیر لب خوانده می‌شود، نشانه‌ای است از یادآوری و توجه به منبع و آغاز همه چیز."],[293,"آن شده آواز صافی و حزین","ای خدا وی مستغاث‌و ای معین","این دعا و ناله خالص و غمگین به سوی تو، ای خدا، است که پناهگاه و یاور منی."],[293,"ناله سگ در رهش بی جذبه نیست","زانک هر راغب اسیر ره‌زنی‌ست","ناله سگ در راه او بی‌فایده است؛ زیرا هر کسی که خواهان اوست، در برابر او اسیر است و مانند ره‌زنی در مسیرش گرفتار می‌شود."],[293,"چون سگ کهفی که از مردار رست","بر سر خوان شهنشاهان نشست","سگی که از گودال یا غاری آزاد شده، حالا بر سر سفره پادشاهان نشسته است. این به معنای کسی است که از شرایط و جایگاهی پایین‌تر به جایی والا رسیده است."],[293,"تا قیامت می‌خورد او پیش غار","آب رحمت عارفانه بی تغار","او (سگی که در بی‌خبری خود نعمت‌ها را می‌خورد) تا روز قیامت به‌گونه‌ای در حال دریافت رحمت خداوند هست که حتی به ظرفی برای آب احتیاج ندارد."],[293,"ای بسا سگ‌پوست کاو را نام نیست","لیک اندر پرده بی آن جام نیست","بسیاری از انسان‌ها هستند که در ظاهر هیچ نام و نشانی ندارند، اما در باطن و حقیقت، بدون آن جام (جام عرفانی یا نور حق) وجودشان معنایی ندارد."],[293,"جان بده از بهر این جام ای پسر","بی جهاد و صبر کی باشد ظفر","برای رسیدن به این مقام و نعمت الهی، باید جان خود را فدای آن کنی، ای پسر. بدون تلاش و صبوری، پیروزی و موفقیت حاصل نخواهد شد."],[293,"صبر کردن بهر این نبود حرج","صبر کن کالصبر مفتاح الفرج","صبر کردن برای این وضعیت بی‌فایده نیست. صبر کن، چرا که صبر کلید گشایش و رسیدن به موفقیت است."],[293,"زین کمین، بی صبر و حزمی کس نرست","حزم را خود صبر آمد پا و دست","از این کمین، بدون صبر و اندیشه، کسی موفق نخواهد شد. خود صبر همانند پا و دست، ابزار حزم و احتیاط است."],[293,"حزم کن از خورد کاین زهرین گیا‌ست","حزم کردن زور و نور انبیا‌ست","احتیاط کن از خوردن این گیاه سمی، زیرا احتیاط کردن، نیرویی و روشنایی‌ای است که از پیامبران ناشی می‌شود."],[293,"کاه باشد کو به هر بادی جهد","کوه کی مر باد را وزنی نهد‌؟","انسانی که مثل کاه است، در برابر هر حادثه یا چالشی به راحتی تحت تأثیر قرار می‌گیرد و به این سادگی نمی‌تواند مقاومتی مانند کوه از خود نشان دهد. او نباید انتظار داشته باشد که مانند کوه، در برابر باد (مشکلات و حوادث) وزن و ثباتی داشته باشد."],[293,"هر طرف غولی همی‌خواند تو را","کای برادر راه خواهی هین بیا","هر جا که بروی، صدای غول بزرگی را می‌شنوی که به تو می‌گوید: «ای برادر! اگر دنبال راه درست هستی، پس بیفت دنبال من."],[293,"ره نمایم‌، همرهت باشم رفیق","من قلاووزم درین راه دقیق","من به تو نشان می‌دهم که چه طور بروی و در این مسیر با تو هم‌قدم هستم؛ من در این راه دقیق و باریک، به مانند کسی هستم که در دریا به دنبال نجات‌دهنده می‌گردد."],[293,"نه قلاوز‌ست و نه ره داند او","یوسفا کم رو سوی آن گرگ‌خو","در این بیت گفته شده که فردی که در این راه و مسیر هدایت حضور دارد، نه تسلطی بر راه دارد و نه از مهارت‌های لازم برخوردار است. همچنین او مانند یوسف، که به خاطر زیبایی‌اش به دام افتاد، از غافل شدن نسبت به خطرات دور و برش نگران است و از سر و صدا و فریب‌هایی که دیگران ممکن است به او تحمیل کنند، می‌هراسد."],[293,"حزم این باشد که نفریبد تو را","چرب و نوش و دام‌های این سرا","عاقلانه این است که فریب نخورید از اشیای دلپذیر و خوشمزه و دام‌های فریبنده‌ای که در این دنیا وجود دارد."],[293,"که نه چربش دارد و نه نوش او","سحر خواند، می‌دمد در گوش او","خداوند به آدمی قول و وعده‌هایی می‌دهد که نه فریبنده و جذاب است و نه خوشمزه و دل‌چسب؛ او همچون جادوگری در گوش انسان می‌خواند و جانش را به سمت خود می‌کشد."],[293,"که بیا مهمان ما ای روشنی","خانه آن تست و تو آن منی","ای روشنی و روشنگر این خانه، تو مهمان ما باش؛ زیرا تو خود همان حقیقتی هستی که در وجود ماست و ما را روشن کرده‌ای."],[293,"حزم آن باشد که گویی تخمه‌ام","یا سقیمم خسته این دخمه‌ام","تخمه‌: بدهضمی طعام‌، ثقل غذا‌. سقیم: بیمار، ناتن‌درست"],[293,"یا سرم دردست درد سر ببر","یا مرا خوانده‌ست آن خالو پسر","‌(بهانه بیاور و بگو‌) سر درد دارم یا بگو فلان خویش و نزدیک مرا خوانده و باید بروم (خالو‌پسر‌: پسر دایی‌، پسر برادر مادر‌)"],[293,"زانک یک نوشت دهد با نیش‌ها","که بکارد در تو نوشش ریش‌ها","برای اینکه با یک شربت به تو زهرها می‌خوراند تا در تو دردهایی بیفزاید و بزاید (نوش:شربت؛ نیش: زهر؛ ریش: زخم و درد)"],[293,"زر اگر پنجاه اگر شصتت دهد","ماهیا او گوشت در شستت دهد","اگرچه زر و ثروت را به مقدار زیادی به تو بدهد، اما اگر آنچه را به دست آورده‌ای به خاطر این دنیا و به طور ظاهری باشد، فایده‌ای ندارد."],[293,"گر دهد خود کی دهد آن پر حیل","جوز پوسیده‌ست گفتار دغل","اگر خودچه کسی به تو چیزی بدهد، آن را اعتبار نکن؛ زیرا حرف‌های فریبنده به مانند گردوهای پوسیده‌اند که در باطن چیزی ندارند."],[293,"ژغژغ آن عقل و مغزت را برد","صد هزاران عقل را یک نشمرد","عقل و اندیشه‌ات مانند پرنده‌ای سر و صدا کرده و پراکنده است، ولی در حقیقت این اندیشه‌های پراکنده و بی‌اساس برای تو ارزش چندانی ندارند و هر یک از آن‌ها به اندازه یک قطره هم نمی‌ارزد."],[293,"یار تو خرجین تست و کیسه‌ات","گر تو رامینی مجو جز ویسه‌ات","یار تو (محبوب تو) خرجینی است که در آن نگه‌داری می‌شود، و کیسه تو (مال و سرمایه‌ات) نیز از آن یار است. اگر تو به محبت و رضایت از آن یار نرسیده‌ای، نباید به چیزی جز آن معشوق خود دل ببندی."],[293,"ویسه و معشوق تو هم ذات تست","وین برونی‌ها همه آفات تست","معشوق و زیبایی واقعی تو در درون خودت است و این ظاهرهای دنیوی و خارجی همگی مشکلات و موانعی هستند که تو را از حقیقت دور می‌کنند."],[293,"حزم آن باشد که چون دعوت کنند","تو نگویی مست و خواهان منند","عاقلانه این است که وقتی تو را دعوت می‌کنند، نگویی که در حال مستی و خواهان من هستند."],[293,"دعوت ایشان صفیر مرغ دان","که کند صیاد در مکمن نهان","دعوت آنها مانند صدای مرغی است که صیاد در مخفیگاه خود ایجاد می‌کند."],[293,"مرغ مرده پیش بنهاده که این","می‌کند این بانگ و آواز و حنین","مرغ مرده‌ای در مقابل قرار داده شده که این صدا و آواز را produces می‌کند."],[293,"مرغ پندارد که جنس اوست او","جمع آید، بر دردشان پوست او","مرغ، گمان می‌کند که از جنس خودش است، بنابراین به یک جمع، به آن‌ها می‌پیوندد و پوست خود را کنار می‌زند."],[293,"جز مگر مرغی که حزمش داد حق","تا نگردد گیج آن دانه و ملق","تنها مرغی که خداوند به او حزم (احتیاط و دوراندیشی) بخشیده است، گیج و مبهوت دانه نمی‌شود و به دنبال آن نمی‌افتد."],[293,"هست بی حزمی پشیمانی یقین","بشنو این افسانه را در شرح این","کسی که حزم و احتیاط نداشته باشد، حتما پشیمان خواهد شد. این داستان را برای تو روایت می‌کنم تا مفهوم آن را بهتر بفهمی."],[294,"ای برادر بود اندر ما مضی","شهریی با روستایی آشنا","ای برادر، در درون ما، شهری وجود دارد که با روستایی آشناست و به نوعی با هم در ارتباط هستند."],[294,"روستایی چون سوی شهر آمدی","خرگه اندر کوی آن شهری زدی","روستایی وقتی به سمت شهر آمد، در کوچه آن شهر، منزلگاه و جایی را برای خود برپا کرد."],[294,"دو مه و سه ماه مهمانش بدی","بر دکان او و بر خوانش بدی","دو ماه و سه ماه مهمان او بودی و بر سر سفره‌اش حاضر بودی."],[294,"هر حوایج را که بودش آن زمان","راست کردی مرد شهری رایگان","هر نیازی که مرد شهری در آن زمان داشت، تو به رایگان و بدون هیچ چشم داشتی برآورده کردی."],[294,"رو به شهری کرد و گفت ای خواجه تو","هیچ می‌نایی سوی ده فرجه‌جو","رو به مرد شهری کرد و گفت: ای آقا، آیا تو هیچ تمایلی برای رفتن به روستا و پیدا کردن فرجی (گشایشی) نداری؟"],[294,"الله الله جمله فرزندان بیار","کاین زمان گلشن‌ست و نوبهار","به یاد خدا همه فرزندانم را بیاور که اکنون زمان گل و بهار است."],[294,"یا به تابستان بیا وقت ثمر","تا ببندم خدمتت را من کمر","به تابستان بیا و زمانی که میوه‌ها رسیده و آماده برداشت هستند، تا من کمر همت به خدمت تو ببندم و تلاش کنم."],[294,"خیل و فرزندان و قومت را بیار","در ده ما باش سه ماه و چهار","خانواده و قوم و کسانت را به دشت ما بیاور و به مدت سه یا چهار ماه در اینجا بمانید."],[294,"که بهاران خطه ده خوش بود","کشت‌زار و لاله دلکش بود","بهار در روستای ما بسیار زیبا و خوشایند است و مزارع و گل‌های لاله در آن زمان دل‌انگیز و زیبا هستند."],[294,"وعده دادی شهری او را دفع حال","تا بر آمد بعد وعده هشت سال","تو به روستائی وعده دادی که به زودی حالش را خوب می‌کنی، اما هشت سال گذشت و اثری از عمل تو نبود."],[294,"او به‌هر سالی همی‌گفتی که کی","عزم خواهی کرد کامد ماه دی","تو هر سال می‌گفتی که چه زمانی قصد داری به اینجا بیایی و مهمان ما شوی، آیا که ماه دی می‌خواهی بیایی؟"],[294,"او بهانه ساختی کامسال‌مان","از فلان خطه بیامد میهمان","او بهانه‌ای درست کرد تا بگوید که میهمان شب سال نو از آن خطه (معین) آمده است."],[294,"سال دیگر گر توانم وا رهید","از مهمات‌، آن طرف خواهم دوید","اگر سال آینده بتوانم از مشکلات و کارهای ضروری دور شوم، به آن طرف خواهم رفت."],[294,"گفت هستند آن عیالم منتظر","بهر فرزندان تو ای اهل بر","او می‌گوید که عیال و خانواده‌ام به انتظار نشسته‌اند تا فرزندان تو را ببینند، ای اهل نیکی."],[294,"باز هر سالی چو لک‌لک آمدی","تا مقیم قبه شهری شدی","هر سال مثل لک‌لک که به فصل معینی برمی‌گردد، تو هم به شهر می‌آیی و در قبه‌ای (ساختمانی) مستقر می‌شوی."],[294,"خواجه هر سالی ز زر و مال خویش","خرج او کردی گشادی بال خویش","خواجه هر سال از ثروت و دارایی خود برای استقبال از لک‌لک خرج می‌کرد تا بتواند آن را راحت و آزاد نگه‌دارد."],[294,"آخرین کرت سه ماه آن پهلوان","خوان نهادش بامدادان و شبان","در پایان سه ماه، آن قهرمان دعوتی را برای او (روستایی) در صبح و شب برپا کرد."],[294,"از خجالت باز گفت او خواجه را","چند وعده‌ چند بفریبی مرا","او از شرم، به خواجه می‌گوید که چقدر وعده داده‌ای و چند بار مرا فریب داده‌ای."],[294,"گفت خواجه جسم و جانم وصل‌جوست","لیک هر تحویل اندر حکم هوست","خواجه (مرد ثروتمند) می‌گوید که وجود و جان من طالب وصال و نزدیکی به معشوق است، اما هر نوع تغییر و تحولی در این رابطه به خواست و اراده خود او بستگی دارد."],[294,"آدمی چون کشتی است و بادبان","تا کی آرد باد را آن باد‌ران","انسان مانند کشتی است که بادبان آن را به حرکت درمی‌آورد و تا چه زمانی می‌تواند به تنهایی بر نیروی باد تکیه کند و به جلو برود."],[294,"باز سوگندان بدادش کای کریم","گیر فرزندان‌، بیا بنگر نعیم","کشتی‌بان (بادران) به او سوگند یاد کرد که ای کریم، فرزندان او را بگیر و بیا و نعمت‌های خود را ببین."],[294,"دست او بگرفت سه کرّت به عهد","کالله الله زو بیا بنمای جهد","دست آن شخص را سه بار گرفت و به او گفت که به خداوند قسم می‌خورم، بیا و زحمات و تلاش‌های خود را نشان بده."],[294,"بعد ده سال و به‌هر سالی چنین","لابه‌ها و وعده‌های شکرین","بعد از گذشت ده سال و در هر سال، با این لابه‌ها و وعده‌های شیرین به او دعوت می‌کنند."],[294,"کودکان خواجه گفتند ای پدر","ماه و ابر و سایه هم دارد سفر","کودکان خواجه به او گفتند که ای پدر، در این سفر ماه و ابر و سایه هم حضور دارند."],[294,"حق‌ها بر وی تو ثابت کرده‌ای","رنج‌ها در کار او بس برده‌ای","حقایق و واقعیت‌ها را درباره او برایش ثابت کرده‌ای و بسیاری رنج و زحمت برای او کشیده‌ای."],[294,"او همی‌خواهد که بعضی حق آن","وا گزارد چون شوی تو میهمان","او (که به نظر می‌رسد شخصی دلسوز است) می‌خواهد برخی از حقوق و نیازها را کنار بگذارد تا زمانی که تو به عنوان مهمان به او ملحق شوی و در کنار او باشی."],[294,"بس وصیت کرد ما را او نهان","که کشیدش سوی ده لابه‌کنان","او (خدا یا حقیقت)، در نهان، بارها به ما وصیت کرده که به خاطر کشاندن کسی به ده (روستا)، بسیار التماس و درخواست کنیم."],[294,"گفت حق‌ست این ولی ای سیبویه","اتق من شر من احسنت الیه","گفت: راست است که باید از کسی که به شما نیکی کرده، مراقبت کنید و از او دوری کنید تا آسیبی از جانب او به شما نرسد."],[294,"دوستی تخم دم آخر بود","ترسم از وحشت که آن فاسد شود","دوستی که در نهایت به آن وابسته هستم، مانند تخمی است که در آخرین لحظه به بار می‌آید و از این می‌ترسم که آن دوستی به دلیل مشکلات و وحشت‌ها خراب و فاسد شود."],[294,"صحبتی باشد چو شمشیر قطوع","همچو دی در بوستان و در زروع","مقصود این بیت این است که صحبت و گفت‌وگو باید همچون شمشیری کارآمد و برنده باشد، که به مانند دی (دیو) در باغ و مزارع عمل کند؛ یعنی باید قدرت و تأثیر قاطع و روشنی داشته باشد تا به نتایج مثبت و سازنده برسد."],[294,"صحبتی باشد چو فصل نوبهار","زو عمارت‌ها و دخل بی‌شمار","صحبت باید مانند بهار باشد که زندگی و رونق را به همراه دارد و باعث آبادانی و ثروت فراوان می‌شود."],[294,"حزم آن باشد که ظن بد بری","تا گریزی و شوی از بد بری","حزم یعنی احتیاط و دوری از گمان‌های بد. اینجا می‌گوید که انسان باید از گمان بد نسبت به دیگران پرهیز کند تا از مشکلات و آسیب‌ها دور بماند."],[294,"حزم سوء الظّنّ گفته‌ست آن رسول","هر قدم را دام می‌دان ای فضول","حزم بدگمانی، همان‌طور که آن پیامبر (محمّد ص) فرمود، هر قدمی را دام می‌داند، ای حرف‌زن ناآگاه."],[294,"روی صحرا هست هموار و فراخ","هر قدم دامی‌ست کم ران اوستاخ","زمین صحرا هموار و وسیع است، اما هر قدمی که برمی‌داریم، دام‌هایی در کمین است که ما را به خطر می‌اندازد."],[294,"آن بز کوهی دود که ‌«دام کو‌»","چون بتازد‌، دامش افتد در گلو","آن بز کوهی که به عنوان نماد شایستگی و هیبت است و در دشت می‌دود، اگر به دام بیفتد، به زودی گلوگیر خواهد شد. اینجا به این معناست که چنانچه فردی هوشیار و قوی، گرفتار دام‌ها و مشکلات شود، به زودی دچار مشکلات جدی خواهد شد."],[294,"آنک می‌گفتی که کو اینک ببین","دشت می‌دیدی نمی‌دیدی کمین","تو که می‌گفتی اینجا را ببین، در حالی که دشت را می‌دیدی، در واقع کمین (دامی که در آن پنهان شده‌اند) را نمی‌دیدی."],[294,"بی کمین و دام و صیاد ای عیار","دنبه کی باشد میان کشت‌زار","ای عیار (آدم فریبکار) که همیشه در کمین و دام و صید هستی، در میان مزارع و چین و شکن‌های آن، کی ممکن است بدون فریب و مکر وجود داشته باشی؟"],[294,"آنک گستاخ آمدند اندر زمین","استخوان و کله‌هاشان را ببین","گستاخانه به زمین آمدند و می‌توان استخوان‌ها و سرهایشان را دید."],[294,"چون به گورستان روی ای مرتضا","استخوانشان را بپرس از ما مضی","ای مرتضا، وقتی به گورستان رفتی، از ما بپرس درباره استخوان‌های این مردم که رفته‌اند و از زندگی گذشته‌شان خبر می‌دهند."],[294,"تا به ظاهر بینی آن مستان کور","چون فرو رفتند در چاه غرور","افرادی که به ظاهر خود را مستان و سکرآور نشان می‌دهند و نمی‌بینند که در چاه و خطر غرور گرفتار شده‌اند، به خاطر نادانی و خودبینی‌ شان به این وضع گرفتار آمده‌اند."],[294,"چشم اگر داری تو کورانه میا","ور نداری چشم‌، دست آور عصا","اگر چشمی داری، بیهوده نیا، و اگر چشمی نداری، به کمک استدلال و عقل (عصا) نگاه کن."],[294,"آن عصای حزم و استدلال را","چون نداری دید می‌کن پیشوا","چونکه عصای عقل و استدلال را نداری، بهتر است که از پیشوای خود (رهبر یا استاد) پیروی کنی و خود را گرفتار عمل نکن."],[294,"ور عصای حزم و استدلال نیست","بی‌عصا‌کش بر سر هر ره مایست","اگر عصای حزم و استدلال (که نماد عقل و تدبیر است) را نداری، بی‌عصا بر سر هر راهی نایست و سکوت نکن."],[294,"گام ز‌ان‌سان نه که نابینا نهد","تا که پا از چاه و از سگ وا رهد","باید با احتیاط گام برداری، مانند فردی که نابینا است، تا از افتادن در چاه یا مواجهه با سگ در امان بمانی."],[294,"لرز لرزان و به‌ترس و احتیاط","می‌نهد پا تا نیفتد در خباط","کسی که به خاطر ترس و لرز و احتیاط، پاهایش را با احتیاط می‌گذارد، تا مبادا در اشتباه یا فریب بیفتد."],[294,"ای ز دودی جسته در ناری شده","لقمه جسته لقمه ماری شده","تو به خاطر دود (مشکلات یا خطرات) گذشته، حالا در آتش (بدبختی) افتاده‌ای و لقمه‌ات (معاش یا خواسته‌هایت) به دام ماری (خطرات) تبدیل شده است."],[295,"تو نخواندی قصه اهل سبا","یا بخواندی و ندیدی جز صدا","تو داستان اهل سبا را نخوانده‌ای یا اگر خوانده‌ای فقط صدایش را شنیده‌ای و معنای عمیق و واقعی آن را درک نکرده‌ای."],[295,"از صدا آن کوه خود آگاه نیست","سوی معنی هوش که را، راه نیست","کوه از صدا و ندا، هیچ آگاهی ندارد و نمی‌تواند به عمق و معنای آن پی ببرد، زیرا هوش و درک واقعی مانند کوه به معنای بزرگ و عمیق نیاز دارد که در اینجا وجود ندارد."],[295,"او همی بانگی کند بی گوش و هوش","چون خمش کردی تو، او هم شد خموش","او (صدا) بدون اینکه شنونده‌ای داشته باشد، صدایی می‌زند و به هیچ‌کس توجه نمی‌کند؛ وقتی تو (شنونده) ساکت می‌شوی، آن صدا هم خاموش می‌شود."],[295,"داد حق اهل سبا را بس فراغ","صد هزاران قصر و ایوان‌ها و باغ","خداوند به اهل سبا برکت و نعمت فراوانی عطا کرده بود؛ به طوری که صدها قصر، ایوان و باغ برای آن‌ها فراهم کرده بود."],[295,"شکر آن نگزاردند آن بد رگان","در وفا بودند کمتر از سگان","اما اهالی پست سبا شکر این همه نعمت را به‌جا نیاوردند و در وفای به صاحب خود، از سگ کمتر بودند!"],[295,"مر سگی را لقمه نانی ز در","چون رسد بر در همی‌بندد کمر","سگ‌ها وقتی لقمه‌ای نانی پیدا کنند، در برابر در، نگران و محتاط می‌شوند و برای حفاظت از آن، خود را محکم و آماده نگه می‌دارند."],[295,"پاسبان و حارس در می‌شود","گرچه بر وی جور و سختی می‌رود","هر چند پاسبان و نگهبان در می‌شود و تحت فشار و سختی قرار می‌گیرد، اما همچنان به وظیفه خود ادامه می‌دهد و از در محافظت می‌کند."],[295,"هم بر آن در باشدش باش و قرار","کفر دارد کرد غیری اختیار","انسان باید در برابر درب الهی پایبند و متعهد باشد، اما اگر کفر و ناسپاسی را انتخاب کند، به سرنوشت بدی دچار خواهد شد."],[295,"ور سگی آید غریبی روز و شب","آن سگانش می‌کنند آن دم ادب","اگر سگی بیگانه روز و شب به اینجا بیاید، سگ‌های خودی او را با ادب و احترام می‌پذیرند و با او رفتار می‌کنند."],[295,"که برو آنجا که اول منزل است","حق آن نعمت گروگان دل است","به آن مکان برو که آغاز راه است، زیرا آنجا دل تو گروگذار نعمت‌هاست."],[295,"می‌گزندش که ‌«برو بر جای خویش","حق آن نعمت فرو مگذار بیش‌»","و به او می‌گوید: «به جای خود برگرد و نعمت را بیشتر از حد خود رها نکن و به آن بی‌احترامی نکن."],[295,"از در دل و اهل دل آب حیات","چند نوشیدی و وا شد چشمهات","از در دل و از اهل دل چندبار آب حیات، یعنی دانش و معرفت، نوشیدی و چشمانت باز شدند و بینایی و آگاهی پیدا کردی؟"],[295,"بس غذای سکر و وجد و بی‌خودی","از در اهل دلان بر جان زدی","از در دل اهل حقیقت، بسی خوردی و شربت سکر و وجد و حالت‌های بی‌خودیشان را بر جانت نشاندی."],[295,"باز این در را رها کردی ز حرص","گرد هر دکان همی‌گردی ز حرص","تو این در را به خاطر حرص و طمع رها کردی و فقط به دور هر دکان می‌گردی به همین دلیل."],[295,"بر در آن منعمان‌ چرب‌دیگ","می‌دوی بهر ثرید مرده ریگ","برای خوردن غذای لذیذ که در ظرف‌های چرب آماده شده، به در خانه ثروتمندانی که نعمت‌های زیادی دارند می‌روی، اما در واقع این تلاش‌ها تو را به مقصد نمی‌رساند و جز خاک را چیزی به دست نمی‌آوری."],[295,"چربش اینجا دان که جان فربه شود","کار نااومید اینجا به شود","چرب بودن در اینجا به معنای دلپذیر و خوشمزه بودن است که باعث می‌شود جان انسان سرزنده و شاداب گردد. در مقابل، انجام کارهای ناامیدکننده و نامناسب، باعث ظهور بدبختی و مشکلات می‌شود."],[296,"صومعه عیسی‌ست خوان اهل دل","هان و هان ای مبتلا این در مهل","صومعه عیسی (عیسی علیه السلام) مکان مهمی برای اهل دل است و به آنجا بیایید؛ ای کسی که به بلایی مبتلا هستی، این در موفقیت و شفا برای توست."],[296,"جمع گشتندی ز هر اطراف خلق","از ضریر و لنگ و شل و اهل دلق","مردم از هر سو جمع می‌شدند، از جمله نابینایان، لنگان، و فلج‌ها، و نیز افرادی که لباس‌های سرسفید (دلق) پوشیده بودند."],[296,"بر در آن صومعه عیسی صباح","تا به‌دم اوشان رهاند از جناح","در آن صومعه عیسی در هر صبحی، بیماران و نیازمندان منتظرند تا با دعای او از درد و رنج خود رهایی یابند."],[296,"او چو فارغ گشتی از اوراد خویش","چاشت‌گه بیرون شدی آن خوب‌کیش","وقتی عیسی از دعاها و ذکری که انجام می‌داد فارغ شد، در صبحگاه از صومعه بیرون آمد."],[296,"جوق جوقی مبتلا دیدی نزار","شسته بر در، در امید و انتظار","گروه گروه از افرادی که به بیماری مبتلا شده و ضعیف هستند را دیدی که در انتظار و امید به شفا، در مقابل در صومعه (مکان عبادت) نشسته‌اند."],[296,"گفتی ای اصحاب آفت از خدا","حاجت این جملگانتان شد روا","عیسی علیه السلام به دوستان و پیروانش می‌گوید: ای کسانی که به بیماری و مشکل مبتلا هستید، شما از خداوند درخواست کرده‌اید و حاجت‌های‌تان برآورده شده است."],[296,"هین روان گردید بی رنج و عنا","سوی غفاری و اکرام خدا","بشتابید و بدون زحمت و سختی به سوی محبت و کرم خدا بروید."],[296,"جملگان چون اشتران بسته‌پای","که گشایی زانوی ایشان برای","مردم مانند شترانی هستند که پایشان به هم بسته شده و اگر زانوی آن‌ها باز شود، می‌توانند به حرکت درآیند و آزاد شوند."],[296,"خوش دوان و شادمانه سوی خان","از دعای او شدندی پا دوان","آنان خوشحال و شاداب به سوی خانه می‌شتافتند، زیرا دعای عیسی علیه‌السلام سبب بهبودی‌شان شده بود."],[296,"آزمودی تو بسی آفات خویش","یافتی صحت ازین شاهان کیش","تو مشکلات و سختی‌های زیادی را تجربه کرده‌ای، اما از دعای این شاهان از اهل حقیقت، به بهبودی و سلامتی رسیده‌ای."],[296,"چند آن لنگی تو رهوار شد","چند جانت بی غم و آزار شد","چند بار خود را در نرمی و آزادی تحرک و نشاط می‌بینی، و چند بار روح تو از غم و آزار رها می‌شود."],[296,"ای مغفل رشته‌ای بر پای بند","تا ز خود هم گم نگردی ای لوند","ای کسی که غافل هستی، رشته‌ای به پای خود ببند تا گم نشوی و از خودت دور نیفتی. ای جوان!"],[296,"ناسپاسی و فراموشی تو","یاد ناورد آن عسل‌نوشی تو","ناسپاسی و فراموشی تو باعث می‌شود تا یاد آن شیرینی و لذتی که در گذشته تجربه کرده‌ای، از ذهنت برود."],[296,"لاجرم آن راه بر تو بسته شد","چون دل اهل دل از تو خسته شد","بنابراین، راه به سوی تو مسدود شد، زیرا دل اهل دل از تو ناامید و خسته گردید."],[296,"زودشان در یاب و استغفار کن","همچو ابری گریه‌های زار کن","براساس این شعر، به سرعت به مشکل آن‌ها رسیدگی کن و از آن‌ها برای گناهانشان درخواست بخشش کن، همان‌طور که ابرها برای باریدن احساساتی و غمگین می‌بارند."],[296,"تا گلستان‌شان سوی تو بشکفد","میوه‌های پخته بر خود وا کفد","برای اینکه گلستان وجودشان به شکوفه بیفتد، میوه‌های رسیده باید بر خود بیفتد و به خود بیندیشند."],[296,"هم بر آن در گرد‌، کم از سگ مباش","با سگ کهف ار شدستی خواجه‌تاش","به آن در، مانند سگ‌های دیگر نباش و کمتر از آن‌ها خودت را پایین نیاور؛ زیرا اگر تو هم مانند آن‌ها شوی، دیگر ارزش و مقام ارجمند خود را از دست خواهی داد."],[296,"چون سگان هم مر سگان را ناصح‌اند","که دل اندر خانه اول ببند","سگ‌ها نیز یکدیگر را نصیحت می‌کنند که دلشان را از تعلقات دنیا جدا کنند و در خانه اصلی خود (به معنای منزلتی روحانی یا الهی) قرار دهند."],[296,"آن در اول که خوردی استخوان","سخت گیر و حق گزار آن را ممان","در آغاز که استخوان سختی را خوردی، قدر و ارزش آن را بشناس و بابت آن شکرگزار باش و نگذار تا تو را گرفتار کند."],[296,"می‌گزندش تا ز ادب آنجا رود","وز مقام اولین مفلح شود","سگ را می‌زنند تا به خاطر ادب به آنجا برود و از مقام ابتدایی خود خارج شده و موفق و خوشبخت شود."],[296,"می‌گزندش کای سگ طاغی برو","با ولی نعمتت یاغی مشو","می‌زنند به تو ای سگ نافرمان، برو و علیه ولی نعمتت شورش نکن."],[296,"بر همان در همچو حلقه بسته‌باش","پاسبان و چابک و برجسته باش","در همان در، مانند حلقه‌ای بسته و محکم باقی بمان، مثل یک نگهبان چابک و باوقار باش."],[296,"صورت نقض وفای ما مباش","بی‌وفایی را مکن بیهوده فاش","به خاطر داشته باش که نقض عهد و بی‌وفایی را نمایش نده و آن را بی‌جهت و به‌طور علنی آشکار نکن."],[296,"مر سگان را چون وفا آمد شعار","رو سگان را ننگ و بدنامی میار","زمانی که وفا در دل سگان بیاید، آن را به عنوان نشانه و نماد خود می‌دانند؛ پس ننگ و بدنامی برای سگان نیست که بی‌وفایی را در خود داشته باشند."],[296,"بی‌وفایی چون سگان را عار بود","بی‌وفایی چون روا داری نمود","بی‌وفایی و عدم تعهد برای سگان ننگ و عیب است، اما اگر این بی‌وفایی را بپذیری، به آن اقدام می‌کنی و به آن راه می‌روی."],[296,"حق تعالی فخر آورد از وفا","گفت من اوفی بعهد غیرنا","خداوند متعال به وفای خود می‌بالد و می‌فرماید که من به عهد غیر از خودم وفادارتر هستم."],[296,"بی‌وفایی دان وفا با رد حق","بر حقوق حق ندارد کس سبق","بی‌وفایی را بشناس، زیرا وفا در برابر رد کردن حقوق خداوند جایگاهی ندارد و هیچ‌کس نمی‌تواند در این زمینه برتر باشد."],[296,"حق مادر بعد از آن شد کان کریم","کرد او را از جنین تو غریم","مادر حق دارد بر فرزندش، زیرا خداوند او را با رحمت و کرامت از جنین درونش آفریده است."],[296,"صورتی کردت درون جسم او","داد در حملش ورا آرام و خو","خداوند درون جسم انسان صورت و形 می‌سازد و در دوران بارداری به او آرامش و آسایش می‌دهد."],[296,"همچو جزو متصل دید او تو را","متصل را کرد تدبیرش جدا","او (خدا) تو را مانند جزئی از وجود خود می‌بیند و به همین دلیل با تدبیر خودت را به صورت جداگانه قرار داده است."],[296,"حق هزاران صنعت و فن ساخته‌ست","تا که مادر بر تو مهر انداخته‌ست","خداوند هزاران هنر و زحمت ایجاد کرده است تا مادر بتواند بر تو عشق و محبت بورزد."],[296,"پس حق حق سابق از مادر بود","هر که آن حق را نداند خر بود","خداوند حق و حقیقت را از طریق مادر به انسان می‌دهد، بنابراین هر کسی که نتواند این حق را بشناسد، مانند الاغ نادان است."],[296,"آنک مادر آفرید و ضرع و شیر","با پدر کردش قرین آن خود مگیر","آن کسی که مادرش او را آفرید و پدرش به او شیر می‌دهد، او را به خود نچسبانید و به او وابسته نشوید."],[296,"ای خداوند ای قدیم احسان تو","آنکه دانم وانکه نه هم آن تو","ای خداوند، ای خالقی که همیشه احسانت برقرار است، هر کسی که احسان‌های تو را می‌داند و هر کسی که ندانسته است، در حقیقت همه از تو هستی."],[296,"تو بفرمودی که حق را یاد کن","زانک حق من نمی‌گردد کهن","خداوند به ما فرمان داده است که یاد حق را گرامی بداریم، زیرا حقیقت الهی هرگز کهنه نمی‌شود و همیشه تازه و پایدار است."],[296,"یاد کن لطفی که کردم آن صبوح","با شما از حفظ در کشتی نوح","به یاد بیاورید لطفی را که در آن صبح با شما کردم، وقتی که شما را از خطراتی که در کشتی نوح وجود داشت، نجات دادم."],[296,"پیله بابایانتان را آن زمان","دادم از طوفان و از موجش امان","من در آن زمان که طوفان و امواج در حال نابودی بودند، از شما و خانواده‌تان (پدرتان) حمایت کردم و به شما امان دادم."],[296,"آب آتش خو زمین بگرفته بود","موج او مر اوج که را می‌ربود","زمین را آب فراگرفته بود و آتش هم در آن وجود داشت؛ موج آب به قدری بلند بود که قله کوه‌ها را نیز می‌برد."],[296,"حفظ کردم من نکردم ردتان","در وجود جد جد جدتان","من منکر شما نشدم و در وجود شما یعنی نیاکان بسیار دورتان را حفظ کردم و به آنها احترام گذاشتم."],[296,"چون شدی سر، پشت پایت چون زنم","کارگاه خویش ضایع چون کنم","چون رئیس و سرپرست گروه شدی، اگر از تو انتقاد شود و به پشت‌پایت ضربه‌ای وارد آید، کار و شغل خود را خراب می‌کنی، پس چطور باید این وضعیت را مدیریت کنم؟"],[296,"چون فدای بی‌وفایان می‌شوی","از گمان بد بدان سو می‌روی","وقتی خود را فدای بی‌وفایان می‌کنی، به جهت تردید و بدگمانی به سوی آن‌ها می‌روی."],[296,"من ز سهو و بی‌وفایی‌ها بری","سوی من آیی گمان بد بری","من از اشتباهات و وفاداری‌های نادرست آزاد هستم؛ برای همین به سمت من بیا و گمان بد را از خود دور کن."],[296,"این گمان بد بر آنجا بر که تو","می‌شوی در پیش همچون خود دوتو","این فکر نادرست را در مورد کسی که در پیش تو ظاهر می‌شود، کنار بگذار، زیرا او همانند تو به مشکلات و کمبودها دچار است."],[296,"بس گرفتی یار و همراهان زفت","گر تو را پرسم که کو گویی که رفت","با اینکه دوستان و همراهانت را تجمع کرده‌ای، اگر از تو بپرسم که آن‌ها کجا هستند، به من می‌گویی که رفتند."],[296,"یار نیکت رفت بر چرخ برین","یار فسقت رفت در قعر زمین","دوست خوب تو از آسمان به سمت بالا رفته و یار بد تو به قعر زمین سقوط کرده است."],[296,"تو بماندی در میانه آنچنان","بی‌مدد چون آتشی از کاروان","تو در چنین وضعیتی در میانی باقی مانده‌ای و از کمک و یاری بی‌بهره‌ای، مانند آتشی که جدا از کاروان است و نمی‌تواند به آنها کمک کند."],[296,"دامن او گیر ای یار دلیر","کو منزّه باشد از بالا و زیر","ای دوست دلیر، دامن عیسی را بگیر، زیرا او از هر دو دنیا (بالا و پایین) پاک و پاکیزه است و از آلودگی‌ها بری است."],[296,"نه چو عیسی سوی گردون بر شود","نه چو قارون در زمین اندر رود","نه مانند عیسی به آسمان بالا می‌رود و نه مثل قارون در زمین فرو می‌رود."],[296,"با تو باشد در مکان و بی‌مکان","چون بمانی از سرا و از دکان","چون تو در دنیا از مکانی و دکانی و از چیزهای مادی خود دور بمانی، او (خدا) دائما در کنار توست و در همه جا با توست."],[296,"او بر آرد از کدورت‌ها صفا","مر جفاهای تو را گیرد وفا","او از تیرگی‌ها و ناخوشی‌ها، صفا و روشنی می‌آورد و بی‌وفایی‌های تو را با وفا و صداقت پاسخ می‌دهد."],[296,"چون جفا آری فرستد گوشمال","تا ز نقصان وا روی سوی کمال","هرگاه ظلم و بدی کنی، عواقبش تو را به سمت مجازات می‌فرستد تا از کمبودها و نقص‌هایت دور شوی و به کمال و تمامیت برسی."],[296,"چون تو وردی ترک کردی در روش","بر تو قبضی آید از رنج و تبش","زمانی که تو ذکر و دعا را کنار گذاشتی، از رنج و ناراحتی بر تو فشار و سختی وارد می‌شود."],[296,"آن ادب کردن بود یعنی مکن","هیچ تحویلی از آن عهد کهن","آداب و رسوم را رعایت کردن به این معنی است که نباید هیچ تغییر و تحول یا نقضی در آن پیمان قدیمی به وجود آورد."],[296,"پیش از آن کین قبض زنجیری شود","این که دلگیریست پاگیری شود","قبل از آنکه به گرفتاری و زنجیر شدن دچار شوی، بدان که این دل‌تنگی و غمگینی، تو را در بند می‌کند."],[296,"رنج معقولت شود محسوس و فاش","تا نگیری این اشارت را بلاش","رنجی که از عقل و تفکر می‌گیرد، باید به حالت محسوس و آشکار تبدیل شود تا تو این اشاره را درک نکنی."],[296,"در معاصی قبض‌ها دلگیر شد","قبض‌ها بعد از اجل زنجیر شد","در گناهان، درد و ناراحتی به دل آدمی دست می‌دهد و بعد از مرگ، این مشکل به شکل زنجیری او را محکم می‌گیرد و رهایش نمی‌کند."],[296,"نعط من اعرض هنا عن ذکرنا","عیشة ضنک و نجزی بالعمی","هر کس که از یاد ما فاصله بگیرد زندگی سخت و دشواری خواهد داشت و ما نیز او را با کوری جزا می‌دهیم."],[296,"دزد چون مال کسان را می‌برد","قبض و دلتنگی دلش را می‌خلد","دزد وقتی که اموال دیگران را می‌رباید، ناراحتی و غصه بر دلش حاکم می‌شود."],[296,"او همی‌گوید «‌عجب این قبض چیست‌»","قبض آن مظلوم کز شرّت گریست","او (دزد) می‌گوید اینکه دلش در قبض و دلتنگی است، عجیب است. این حال دل او مانند حال مظلومی است که از شر دیگران به ستوه آمده و گریه می‌کند."],[296,"چون بدین قبض التفاتی کم کند","باد اصرار آتشش را دم کند","وقتی بی‌توجهی به این قبض (حالت‌های درونی و روحی) ایجاد شود، باد (نیروهای دیگر) به آتش (احساسات و اشتیاق) او می‌وزد و آن را خاموش می‌کند."],[296,"قبض دل قبض عوان شد لاجرم","گشت محسوس آن معانی زد علم","وقتی دل در حالت قبض و تنگی قرار می‌گیرد، در نتیجه، معناهای عمیق و معنوی احساس می‌شوند و علم و آگاهی از آن‌ها به دست می‌آید."],[296,"غصه‌ها زندان شدست و چارمیخ","غصه بیخ است و بروید شاخ بیخ","غصه‌ها به مانند زندانی شده‌اند و به خاطر اینکه چهار میخ غصه به بیخ گیاه وصل است، از آن شاخ و برگ می‌زند."],[296,"بیخ پنهان بود هم شد آشکار","قبض و بسط اندرون بیخی شمار","ریشه‌های پنهان غم و اندوه اکنون نمایان شده است و در درون این ریشه‌ها، رشد و کاهش احساسات را می‌توان دید."],[296,"چونکه بیخ بد بود زودش بزن","تا نروید زشت‌خاری در چمن","اگر ریشه (بیخ) گیاهی خراب و بد باشد، باید آن را سریعا قطع کرد تا در باغچه (چمن) زخم‌ها و ناخوشی‌ها به وجود نیاید و خوبی‌ها و زیبایی‌ها از بین نروند."],[296,"قبض دیدی‌، چاره آن قبض کن","زانک سرها جمله می‌روید ز بن","اگر قبض و تنگی حالتی را دیدی، باید آن را رفع کنی، چون همه آدم‌ها از ریشه و اصل خود به سمت بالا و رشد می‌روند."],[296,"بسط دیدی‌، بسط‌ خود را آب ده","چون بر آید میوه با اصحاب ده","اگر بسط و گشایش را دیده‌ای، خودت را نیز گسترش بده و به دیگران آب و زندگی ببخش، زیرا وقتی میوه‌ها به بار می‌آیند، باید با دوستان و همراهان تقسیم شوند."],[297,"آن سبا ز اهل صبا بودند و خام","کارشان کفران نعمت با کرام","آدم‌های سبا (اهل سبا) از سرزمین صبا (یمن) بودند و به خاطر نادانی و کم‌احساسی خود، نعمت‌ها را نادیده می‌گرفتند و ناسپاسی می‌کردند."],[297,"باشد آن کفران نعمت در مثال","که کنی با محسن خود تو جدال","کفران نعمت به‌گونه‌ای است که اگر با محسن (نیکوکار) خود درگیر شوی و نزاع کنی، مانند آن می‌شود."],[297,"که نمی‌باید مرا این نیکوی","من برنجم زین، چه رنجم می‌شوی","نیکی و خوبی من نباید باعث دل‌آزاری تو شود، چون اگر من بخواهم از این خوبی‌ها جدا شوم، تو هم از رنج و درد در امان نخواهی بود."],[297,"لطف کن این نیکوی را دور کن","من نخواهم چشم زودم کور کن","از من خواهش می‌کند که این نعمت زیبا و خوشایند را از من دور کنی، زیرا نمی‌خواهم به خاطر آن به دردسر بیفتم و چشمانم به زودی دچار آسیب شود."],[297,"پس سبا گفتند باعد بیننا","شیننا خیر لنا خذ زیننا","سبا (قوم سبا در یمن) گفتند: فاصله‌ای بین ما و آنچه ارائه داده‌اید بیندازید، زیرا این زینت و زیبایی شما برای ما بهتر است."],[297,"ما نمی‌خواهیم این ایوان و باغ","نه زنان خوب و نه امن و فراغ","ما نمی‌خواهیم این کاخ و باغ را که نه زنان زیبا در آن هستند و نه آرامش و راحتی."],[297,"شهرها نزدیک همدیگر بدست","آن بیابانست خوش کانجا ددست","شهرها به خاطر آن بیابان به یکدیگر نزدیک شده‌اند، که در آنجا امنیت و آسایش وجود ندارد."],[297,"یطلب الانسان فی الصیف الشتا","فاذا جاء الشتا انکر ذا","انسان در تابستان به دنبال زمستان است، اما وقتی زمستان فرا می‌رسد، آن را انکار می‌کند."],[297,"فهو لا یرضی بحال ابدا","لا بضیق لا بعیش رغدا","انسان هیچ وقت راضی به حال خود نیست و همیشه در جستجوی وضعیتی بهتر است، نه به زندگی تنگ و نه به زندگی راحت و فراوان."],[297,"قتل الانسان ما اکفره","کلما نال هدی انکره","کشتن انسان، سبب کفر اوست؛ هرگاه هدایت به او برسد و او آن را انکار کند."],[297,"نفس زین سانست زان شد کشتنی","اقتلوا انفسکم گفت آن سنی","نفس آدمی به این شکل است که کشتن آن واجب شده است، همان‌طور که در قرآن آمده که «خود را بکشید» این سخن را آن سنّی (معتزلی) گفته است."],[297,"خار سه سویست هر چون کش نهی","در خلد وز زخم او تو کی جهی","خار در هر سه سمت وجود دارد؛ پس هر بار که آن را برمی‌داری، زخم می‌زنی و از بهشت دور می‌شوی."],[297,"آتش ترک هوا در خار زن","دست اندر یار نیکوکار زن","آتش اشتیاق زبانی که ترک شده، در کناره‌های خاری که به دست یاری نیکوکار روییده، باز هم رابطه‌ای را یادآوری می‌کند. یعنی حتی در میان مشکلات، عشق و دوستی با نیکوکاران می‌تواند چیزی را روشن کند."],[297,"چون ز حد بردند اصحاب سبا","که بپیش ما وبا به از صبا","اهل سبا (قوم سبا) وقتی از حد و مرز خود تجاوز کردند و به پیش ما (به سمت نیکوکاران) آمدند، بیماری (با) از صبا (چیزی ناخوشایند) برای ما بهتر بود."],[297,"ناصحانشان در نصیحت آمدند","از فسوق و کفر مانع می‌شدند","پنددهندگان و مشاوران آنها برای نصیحت و راهنمایی به سراغشان آمدند و از گناه و کفر جلوگیری می‌کردند."],[297,"قصد خون ناصحان می‌داشتند","تخم فسق و کافری می‌کاشتند","آن‌ها تصمیم داشتند که ناصحان را به قتل برسانند و در دلشان بذر فسق و کفر را می‌کاشتند."],[297,"چون قضا آید شود تنگ این جهان","از قضا حلوا شود رنج دهان","زمانی که تقدیر خداوند به وقوع بپیوندد، این جهان به تنگی می‌گراید و مشکلات و رنج‌ها به شیرینی و آسایش تبدیل می‌شود."],[297,"گفت اذا جاء القضا ضاق الفضا","تحجب الابصار اذ جاء القضا","گفته‌اند زمانی که قضا و تقدیر فرامی‌رسد، فضا تنگ می‌شود و چشم‌ها از دیدن حقیقت قضا و تقدیر محروم می‌گردند."],[297,"چشم بسته می‌شود وقت قضا","تا نبیند چشم کحل چشم را","زمانی که قضا و سرنوشت فرا می‌رسد، چشم انسان بسته می‌شود تا چشم او نتواند چیزهای ناگوار و تلخ را ببیند."],[297,"مکر آن فارس چو انگیزید گرد","آن غبارت ز استغاثت دور کرد","مکر آن شخص فاسق وقتی که غبار را بلند کند، تو را از درخواست کمک و فریاد زدن دور می‌کند."],[297,"سوی فارس رو مرو سوی غبار","ورنه بر تو کوبد آن مکر سوار","به سوی فارس نرو و به غبار آنجا نزد، وگرنه آن مکری که آماده است تو را خواهد زد."],[297,"گفت حق آن را که این گرگش بخورد","دید گرد گرگ چون زاری نکرد","خداوند این را گفت که اگر این گرگ (دشمن یا بدی) تو را از بین ببرد، نگو که چرا فریاد نزده و شکایت نکرده است."],[297,"او نمی‌دانست گرد گرگ را","با چنین دانش چرا کرد او چرا","او نمی‌دانست که چرا به‌خاطر داشتن چنین دانشی، این‌همه نگرانی و ترس به گرد گرگ انداخت."],[297,"گوسفندان بوی گرگ با گزند","می‌بدانند و بهر سو می‌خزند","گوسفندها بوی گرگ را به خوبی تشخیص می‌دهند و برای حفظ خود به هر سمتی می‌فرارند."],[297,"مغز حیوانات بوی شیر را","می‌بداند ترک می‌گوید چرا","حیوانات بوی شیر را تشخیص می‌دهند، اما وقتی که می‌گویند \"ترک\" (بنیادگذار بودند یا بی‌توجه به خطر)، از خودشان می‌پرسند که چرا به این بوی آشنا توجه نمی‌کنند."],[297,"بوی شیر خشم دیدی باز گرد","با مناجات و حذر انباز گرد","بوی شیر را زمانی تشخیص می‌دهی که خشم را نیز لمس کرده باشی؛ پس باید با دعا و مراقبت از خودت دوری کنی."],[297,"وا نگشتند آن گروه از گرد گرگ","گرگ محنت بعد گرد آمد سترگ","آن گروه از دور گرگی که به آن‌ها نزدیک شده بود، بازنگشتند و در نتیجه، دچار محنت بزرگ و مشکلات زیاد شدند."],[297,"بر درید آن گوسفندان را به خشم","که ز چوپان خرد بستند چشم","گوسفندها به خاطر خشم چوپان، چشمانشان را بسته بودند و از او دور شدند."],[297,"چند چوپانشان بخواند و نامدند","خاک غم در چشم چوپان می‌زدند","چندین چوپان صدایشان کرد و به سوی او نیامدند، و در حالی که غم آنها را رنج می‌داد، اشک در چشمان چوپان ریختند."],[297,"که برو ما از تو خود چوپان‌تریم","چون تبع گردیم هر یک سروریم","ما از تو بهتر و با صلاحیت‌تر هستیم، زیرا اگر ما تو را دنبال کنیم، هر کدام از ما رهبری می‌کنیم."],[297,"طعمه گرگیم و آن یار نه","هیزم ناریم و آن عار نه","ما طعمه گرگ هستیم و آن یار ما، نه چوبی برای آتش است و نه عیبی برای ما."],[297,"حمیتی بد جاهلیت در دماغ","بانگ شومی بر دمنشان کرد زاغ","مردی جاهل و نادان به خاطر بیدادگری و ظلم خود، فریاد ناپسندی بلند کرده و باعث بدبختی و مصیبت دیگران شده است. زاغ، به عنوان نماد این شخص، بر اثر این رفتار شوم دچار بدبختی و رنج می‌شود."],[297,"بهر مظلومان همی‌کندند چاه","در چه افتادند و می‌گفتند آه","برای مظلومان چاهی حفر می‌کردند و زمانی که خود در آن چاه می‌افتادند، فقط آه و ناله سر می‌دادند."],[297,"پوستین یوسفان بشکافتند","آنچ می‌کردند یک یک یافتند","پوستین یوسف که به نوعی نماد زیبایی و ارزش است، پاره شد و در نتیجه آنچه که در باطن وجود هر یک از آنها بود، نمایان شد و آنچه در دل داشتند، آشکار گشت."],[297,"کیست آن یوسف دل حق‌جوی تو","چون اسیری بسته اندر کوی تو","آن کس که در جستجوی حقیقت و دلی عاشق است، همانند یوسف زیبا و باطنی است که در عالم عشق و در کوی تو، همچون یک اسیر در بند و گرفتار شده است."],[297,"جبرئیلی را بر استن بسته‌ای","پر و بالش را به صد جا خسته‌ای","این بیت به مفهوم این اشاره دارد که جبرئیل، فرشته‌ای مقدس و حامل وحی، در دنیای مادی به دام افتاده و نمی‌تواند به آزادگی پرواز کند. او به خاطر بستگی به دنیا و گرفتار شدن در آن، از پر و بال خود (توانایی‌هایش) به شدت خسته شده است."],[297,"پیش او گوساله بریان آوری","گه کشی او را به کهدان آوری","اگر پیش خدا به عنوان قربانی، گوساله‌ای بریان به ارمغان ببری، باید بدان توجه کنی که این گوساله را به کجا خواهی برد و به چه کسی تقدیم خواهی کرد."],[297,"که بخور اینست ما را لوت و پوت","نیست او را جز لقاء الله قوت","ما هیچ‌ چیز نداریم که بخوریم، جز ملاقات با خدا؛ این ملاقات تنها غذای روح ماست و نیازی به دیگر مواد غذایی نداریم."],[297,"زین شکنجه و امتحان آن مبتلا","می‌کند از تو شکایت با خدا","مبتلا از این عذاب و آزمایش به خدا شکایت می‌آورد و از او کمک می‌خواهد."],[297,"کای خدا افغان ازین گرگ کهن","گویدش نک وقت آمد صبر کن","ای خدا، این موجود بدجنس و قدیمی مانند گرگی، در حال ناله و شکایت است و به او می‌گوید که حالا زمان صبر کردن است."],[297,"داد تو وا خواهم از هر بی‌خبر","داد کی دهد جز خدای دادگر","خداوندا، من از بی‌خبری و بی‌عدالتی دردم را فریاد می‌زنم، زیرا فقط خدای دادگر می‌تواند عدالت را برقرار کند و به من کمک کند."],[297,"او همی‌گوید که صبرم شد فنا","در فراق روی تو یا ربنا","او می‌گوید که صبر و شکیبایی‌ام به پایان رسیده در دوری و جدایی از روی تو، ای پروردگار."],[297,"احمدم در مانده در دست یهود","صالحم افتاده در حبس ثمود","من در حالتی ناامیدی و خستگی هستم، مانند یهودیانی که در فراق احمد (پیامبر اسلام) رنج می‌برند و صفت نیکوکاران (صالحم) در زندان ثمود گرفتار شده‌ام."],[297,"ای سعادت‌بخش جان انبیا","یا بکش یا باز خوانم یا بیا","ای که موجب خوشبختی جان‌ بخش پیامبران هستی، یا مرا بکش تا به بهشت بروم، یا به من دوباره حیات عطا کن، یا خودت به سمت من بیا."],[297,"با فراقت کافران را نیست تاب","می‌گود یا لیتنی کنت تراب","کافران در نبود تو نمی‌توانند تاب بیاورند و آرزو می‌کنند که ای کاش من خاک (و بی‌وجود) بودم."],[297,"حال او اینست کو خود زان سوست","چون بود بی تو کسی کان توست","حالت کسی که از تو دور است این است که او خود را به یاد تو می‌سازد؛ زیرا کسی که تو برایش مهمی، چگونه می‌تواند بی‌تو وجود داشته باشد."],[297,"حق همی‌گوید که آری ای نزه","لیک بشنو صبر آر و صبر به","خدا می‌گوید: «بله، ای نزه (نیکو)؛ اما صبر کن و صبر کن تا به حقیقت برسی."],[297,"صبح نزدیکست خامش کم خروش","من همی‌کوشم پی تو، تو مکوش","صبح نزدیک است، پس کم صدا باش و از خروش و هیاهو دوری کن. من هم برای رسیدن به تو تلاش می‌کنم، اما تو این تلاش را بی‌فایده ندان و کوشش نکن."],[298,"شد ز حد هین باز‌گرد ای یار گرد","روستایی خواجه را بین خانه برد","ای دوست، از مرز خود فراتر نرو و برگرد، زیرا مرد روستایی خواجه را با احترام و محبت به خانه‌اش برد."],[298,"قصه اهل سبا یک گوشه نه","آن بگو کان خواجه چون آمد به ده","قصه مردم سبا را به خاطر بسپار و فقط یک گوشه آن را بگو، که وقتی خواجه به ده رسید، چه بر او گذشت."],[298,"روستایی در تملق شیوه کرد","تا که حزم خواجه را کالیوه کرد","روستایی با زبان چرب و نرم و تملق خود، تلاش کرد تا تدبیر و احتیاط خواجه را تحت تأثیر قرار دهد و ضعیف کند."],[298,"از پیام اندر پیام او خیره شد","تا زلال حزم خواجه تیره شد","روستایی با حرف‌هایش خواجه را به اشتباه انداخت و با پیام‌های پی در پی او را گیج و سردرگم کرد، به طوری که در نتیجه، تدبیر و احتیاط خواجه تحت تأثیر قرار گرفت و از روشنی خود خارج شد."],[298,"هم ازینجا کودکانش در پسند","نرتع و نلعب به شادی می‌زدند","کودکان او در این مکان به خاطر شادی و خوشحالی به بازی و جست‌وخیز می‌پرداختند و از لحظات شاداب لذت می‌بردند."],[298,"همچو یوسف که‌ش ز تقدیر عجب","نرتع و نلعب ببرد از ظل اب","این بیت به داستان یوسف اشاره دارد که به دلیل تقدیر و سرنوشت عجیبش از عیش و تفریح در زیر سایه اب (پدرش یعقوب) محروم شد. به نوعی می‌گوید این شادی‌های ظاهری فقط یک بازی نیست و عمق و حقیقت دیگری دارد."],[298,"آن نه بازی‌، بلکه جانبازی‌ست آن","حیله و مکر و دغا‌سازی‌ست آن","این‌که ما هر چیز را بازی بدانیم، درست نیست؛ زیرا این‌جا موضوع، جان‌فشانی و فداکاری است. تمامی نیرنگ‌ها و فریب‌ها حقیقتا نشان‌دهنده خصلت‌های ناپسند و دسیسه‌ها هستند."],[298,"هرچه از یارت جدا اندازد آن","مشنو آن را کان زیان دارد زیان","هر چیزی که تو را از دوستت جدا کند، نباید به آن گوش بدهی، زیرا این جدایی برای تو ضرر دارد."],[298,"گر بود آن سود صد در صد‌، مگیر","بهر زر مگسل ز گنجور ای فقیر","اگر گنجی به دست آوردی که صد در صد سود دارد، برای به دست آوردن آن، به خودت زحمت نده و از خزانه خود نگذار، ای فقیر."],[298,"این شنو که چند یزدان زجر کرد","گفت اصحاب نبی را گرم و سرد","خداوند چگونه دوستان پیامبر (نبی) را با سختی‌ها و آزمایش‌ها مواجه کرد تا آنها را قوی‌تر و با ایمان‌تر کند."],[298,"زانک بر بانگ دهل در سال تنگ","جمعه را کردند باطل بی‌درنگ","چون در سال دشواری، صدای دهل در روز جمعه به صدا درآمد، به‌سرعت بی‌فایده و بی‌نتیجه شد و کارها را مختل کرد."],[298,"تا نباید دیگران ارزان خرند","زان جلب صرفه ز ما ایشان برند","نباید اجازه داد که دیگران به‌راحتی و ارزان از ما بهره‌برداری کنند، زیرا صرفه و فایده کار و تلاش ما باید به خودمان برسد."],[298,"ماند پیغامبر به خلوت در نماز","با دو سه درویش ثابت پر نیاز","پیامبر (خواجه) در حال عبادت و راز و نیاز در خلوت است و چند درویش ثابت قدم و نیازمند نیز در کنار او قرار دارند."],[298,"گفت طبل و لهو و بازرگانیی","چونتان ببرید از ربانیی","گفت: وقتی طبل، موسیقی و بازرگانی و کسب و کار شما را از مسیر روحانی و معنوی دور می‌کند، این نشان‌دهنده جایی است که از راه نورانی و درست خارج شده‌اید."],[298,"قد فضضتم نحو قمح هائما","ثم خلیتم نبیا قائما","شما با شتاب به سمت گندم رفتید و به جای آنکه به پیامبر (خدا) که در حال سخن گفتن بود، توجه کنید، او را رها کردید."],[298,"بهر گندم تخم باطل کاشتید","و آن رسول حق را بگذاشتید","شما به جای اینکه به کارهای ارزشمند و معنوی بپردازید (مثل پیروی از پیامبر حق)، وقت و انرژی خود را صرف کارهای بیهوده کرده‌اید (مثل کاشتن دانه‌های گندم نادرست)."],[298,"صحبت او «‌خیر من لهو‌»ست و مال","بین که‌را بگذاشتی‌؟ چشمی بمال","سخن او به‌‌ مراتب بهتر از بازی و سرگرمی است، پس تو این مال را به چه کسی وا گذاشتی؟ چشم‌ات را بشوی تا ببینی حقیقت را."],[298,"خود نشد حرص شما را این یقین","که منم رزاق و خیر الرازقین","حرص شما برآورده نشد، زیرا اگر مطمئن باشید که من همان رزاق (روزیش را می‌دهد) و بهترین روزی‌دهنده‌ها هستم، دیگر نیازی به حریص بودن نیست."],[298,"آنکه گندم را ز خود روزی دهد","کی توکّل‌هات را ضایع نهد‌؟","آنکه گندم را از جانب خود به مردم می‌دهد، چگونه می‌تواند اعتماد و توکلت را بی‌معنا کند؟"],[298,"از پی گندم جدا گشتی از آن","که فرستاده‌ست گندم ز آسمان","تو از دنباله گندم جدا شده‌ای در حالی که آن کسی که گندم را فرستاده، خداوند است که آن را از آسمان می‌دهد."],[299,"باز گوید بط را کز آب خیز","تا ببینی دشتها را قندریز","باز به بط می‌گوید از آب دور شو تا دشت‌های پر از شکر و خوشی را ببینی."],[299,"بط عاقل گویدش ای باز دور","آب ما را حصن و امنست و سرور","بط عاقل به باز می‌گوید: ای باز، دور آب بمان که اینجا برای ما محلی امن و آرام است و خوشی و خوبی دارد."],[299,"دیو چون باز آمد ای بطان شتاب","هین به بیرون کم روید از حصن آب","دیو که به شکل باز برگشته است، ای بط‌ها (پرندگان آبزی)، شتاب کنید و به بیرون بروید؛ از منطقه امن و آب دور نشوید."],[299,"باز را گویند رو رو باز گرد","از سر ما دست دار ای پای‌مرد","به «باز» چه می‌گویند که برگرد و از ما دور شو؛ ای مرد با پا، از ما دست بردار."],[299,"ما بری از دعوتت دعوت تو را","ما ننوشیم این دم تو کافرا","ما از دعوت تو بی‌نیازیم و نیازی به دعوت تو نداریم. ما این لحظه (یا این دم) را نمی‌پذیریم، زیرا تو کافر هستی."],[299,"حصن ما را قند و قندستان تو را","من نخواهم هدیه‌ات، بستان تو را","من از آنچه که تو به من هدیه می‌دهی، یعنی قند و شیرینی‌ها، نیازی ندارم و نمی‌خواهم آنها را بپذیرم. من به جای این هدایا، به سرزمین خود و به دارایی‌هایم نیاز دارم."],[299,"چونک جان باشد نیاید لوت کم","چونک لشکر هست کم ناید علم","وقتی که جان و روح در انسانی وجود داشته باشد، کمبودهایی در زندگی او احساس نمی‌شود، زیرا اگرچه سپاه و لشکر کم باشد، اما علم و دانش آن شخص کمتر نمی‌شود."],[299,"خواجه حازم بسی عذر آورید","بس بهانه کرد با دیو مرید","خواجه حازم (شخصی با تدبیر و عاقل) به دلیل ضعف و کم توجهی، بارها از پذیرش مسئولیت و عمل کردن به وظایف خود عذرخواهی کرده و بهانه‌آوری کرده است، به‌ویژه در برابر دیو مرید (شخصی در خدمت دیو)."],[299,"گفت این دم کارها دارم مهم","گر بیایم آن نگردد منتظم","او می‌گوید که در این لحظه کارهای مهمی دارم و اگر بیایم، اوضاع به هم می‌ریزد و نظم آن حفظ نمی‌شود."],[299,"شاه کار نازکم فرموده است","ز انتظارم شاه شب نغنوده است","شاه (که به احتمال قوی، معشوق یا مقامی مقدس است) به من آموزش می‌دهد که در وظایف خود به گونه‌ای عمل کنم که نیاز به صبر و انتظار نداشته باشم؛ زیرا شب (زمانی که انسان معمولا در خواب است) به سر می‌برد و به من بی‌توجهی می‌کند."],[299,"من نیارم ترک امر شاه کرد","من نتانم شد بر شه روی‌زرد","من نمی‌توانم امر شاه را ترک کنم، زیرا نمی‌توانم بر روی زرد او (که نشان‌دهنده‌ی خیانت یا بی‌وفایی است) بایستم."],[299,"هر صباح و هر مسا سرهنگ خاص","می‌رسد از من همی‌جوید مناص","هر صبح و هر عصر، سرهنگ مخصوص به من می‌رسد و از من خواسته‌هایی را طلب می‌کند."],[299,"تو روا داری که آیم سوی ده؟","تا در ابرو افکند سلطان گره؟","آیا تو اجازه می‌دهی که به سمت ده بیایم؟ تا سلطان در ابرویش گره‌ای بیندازد؟"],[299,"بعد از آن درمان خشمش چون کنم؟","زنده خود را زین مگر مدفون کنم","بعد از آن چگونه خشم او را درمان کنم؟ آیا باید خودم را به‌طور کامل دفن کنم و از بین ببرم؟"],[299,"زین نمط او صد بهانه باز گفت","حیله‌ها با حکم حق نفتاد جفت","او بهانه‌های زیادی مطرح کرد، ولی حیله‌های او در برابر حکم الهی کارساز نبود و نتوانستند با آن هماهنگ شوند."],[299,"گر شود ذرات عالم حیله‌پیچ","با قضای آسمان هیچند هیچ","هرگاه ذرات جهان به نیرنگ و حقه‌بازی مشغول شوند، در برابر فرمان الهی هیچ ارزشی نخواهند داشت."],[299,"چون گریزد این زمین از آسمان؟","چون کند او خویش را از وی نهان؟","زمین چگونه می‌تواند از آسمان فرار کند؟ چگونه می‌تواند خود را از آسمان پنهان سازد؟"],[299,"هرچه آید ز آسمان سوی زمین","نه مفر دارد نه چاره نه کمین","هر چه از آسمان به سوی زمین می‌آید، هیچ راه فراری، چاره‌ای یا پنهانی ندارد."],[299,"آتش ار خورشید می‌بارد برو","او به پیش آتشش بنهاده رو","اگر آتش از خورشید فرو می‌افتد، تو باید به پیش آن آتش رفته و خود را در معرض آن قرار دهی."],[299,"ور همی طوفان کند باران برو","شهرها را می‌کند ویران برو","اگر طوفان هم باران ببارد، شهرها را ویران می‌کند، پس به سوی آن شهرها نرو."],[299,"او شده تسلیم او ایوب‌وار","که «اسیرم هرچه می‌خواهی ببار»","شخصی مانند ایوب، که در داستان‌های مذهبی به صبر و استقامت معروف است، به تقدیر و خواسته‌های الهی تسلیم شده و می‌گوید: «من اسیر هستم، هرچه می‌خواهی بر من نازل کن و ببار."],[299,"ای که جزو این زمینی سر مکش","چونک بینی حکم یزدان در مکش","ای کسی که جزو عالم خاکی هستی، سر خود را از زمین برمدار؛ زیرا اگر حکم خداوند را در این عالم ببینی، از آن سر مکش."],[299,"چون خلقناکم شنودی من تراب","خاک باشی جست از تو رو متاب","چون ما شما را از خاک آفریدیم، از این رو، روی خود را از خاک بر نتابید، زیرا شما همواره بخشی از آن هستید."],[299,"بین که اندر خاک تخمی کاشتم","کرد خاکی و منش افراشتم","ببین که من در خاک تخمی کاشتم و با تلاش و کوشش خود، از آن تخم جوانه‌هایی را بالا آوردم و شاخ و برگ‌هایی را پرورش دادم."],[299,"حمله دیگر تو خاکی پیشه گیر","تا کنم بر جمله میرانت امیر","خود را در این جهان به کار و زحمت مشغول کن تا قدرت و سلطنت تو بر همه‌ی مردم برقرار شود."],[299,"آب از بالا به پستی در رود","آنگه از پستی به بالا بر رود","آب ابتدا از بالا به پایین در رود می‌ریزد و سپس دوباره از پایین به بالا برمی‌خیزد."],[299,"گندم از بالا به زیر خاک شد","بعد از آن او خوشه و چالاک شد","گندم ابتدا در خاک دفن می‌شود و پس از مدتی جوانه می‌زند و به شکل خوشه‌ای سرسبز و شاداب در می‌آید."],[299,"دانه هر میوه آمد در زمین","بعد از آن سرها بر آورد از دفین","دانه هر میوه ابتدا در خاک قرار می‌گیرد و پس از مدتی، جوانه می‌زند و گیاه رشد می‌کند و سر از خاک بیرون می‌آورد."],[299,"اصل نعمتها ز گردون تا به خاک","زیر آمد شد غذای جان پاک","تمام نعمت‌ها از آسمان به زمین نازل شده و به این ترتیب، به غذای جان‌های پاک تبدیل شده است."],[299,"از تواضع چون ز گردون شد به زیر","گشت جزو آدمی حی دلیر","به خاطر تواضع، وقتی که از آسمان به زمین پایین آمد، جزئی از انسانیت شد و آدمی را شجاع و دلیر ساخت."],[299,"پس صفات آدمی شد آن جماد","بر فراز عرش پران گشت شاد","صفات انسانی، که در آغاز مانند یک جسم بی‌جان (جماد) بودند، اکنون به اوج و بلندی (عرش) رسیده و خوشحال شده‌اند."],[299,"کز جهان زنده ز اول آمدیم","باز از پستی سوی بالا شدیم","ما از آغاز زندگی در این جهان به دنیای زنده آمده‌ایم و اکنون از پایین به سوی بالا در حال صعود هستیم."],[299,"جمله اجزا در تحرک در سکون","ناطقان که انا الیه راجعون","همه بخش‌های مختلف آفرینش، چه در حال حرکت و چه در سکون، به سوی خداوند و سرچشمه وجود خود برگشت می‌کنند."],[299,"ذکر و تسبیحات اجزای نهان","غلغلی افکند اندر آسمان","ذکر و تسبیحات اجزای نهان، صداهایی به وجود می‌آورد که در آسمان طنین‌انداز می‌شود."],[299,"چون قضا آهنگ نارنجات کرد","روستایی شهریی را مات کرد","وقتی تقدیر بخواهد که تو را به قضا و حسرت مبتلا کند، مانند میوه‌ای نارس، روستایی ناامید و شوکه شده باقی می‌گذاری."],[299,"با هزاران حزم خواجه مات شد","زان سفر در معرض آفات شد","خواجه که شخصیتی با احتیاط و تدبیر است، با وجود همه‌ی احتیاط‌هایش در برابر خطرات ناشی از سفر به شدت متحیر و نگران شده است."],[299,"اعتمادش بر ثبات خویش بود","گرچه که بد نیم سیلش در ربود","اعتماد او به پایداری و استحکام خود بود، هرچند که مانند کوهی بود که نیمی از آن توسط سیل از بین رفت."],[299,"چون قضا بیرون کند از چرخ سر","عاقلان گردند جمله کور و کر","زمانی که تقدیر الهی انسان‌ها را از چرخ روزگار خارج کند، همه‌ی عاقلان به حالت ناتوانی و عدم درک درمی‌آیند و مانند انسان‌های کور و کر می‌شوند."],[299,"ماهیان افتند از دریا برون","دام گیرد مرغ پران را زبون","وقتی که قضا (سرنوشت) عاقلان را از چرخ (چرخه حوادث و عالم) خارج کند، ماهی‌ها از دریا خارج می‌شوند و مرغی که در پی شکار است، آنها را به آسانی صید می‌کند. این بیانگر این است که در شرایط بحرانی، کسانی که با عقل و درایت هستند، آسیب‌پذیر می‌شوند و می‌توانند مورد آسیب قرار گیرند."],[299,"تا پری و دیو در شیشه شود","بلک هاروتی به بابل در رود","پری و دیو (موجودات خیالی خوب و بد) در یک شیشه (نماد چیزی محدود) به وجود می‌آیند، اما هاروت (یک فرشته که به امتحان می‌آید) به بابل (شهری در سرزمین آرام) در رود می‌رود."],[299,"جز کسی کاندر قضا اندر گریخت","خون او را هیچ تربیعی نریخت","جز کسی که در قضا و سرنوشت خود فرار کرده، هیچ تدبیری نمی‌تواند او را نجات دهد و خون او را از خطر نجات دهد."],[299,"غیر آن که در گریزی در قضا","هیچ حیله ندهدت از وی رها","هیچ تلاشی برای فرار از قضا و سرنوشت نمی‌تواند تو را از آن رها کند."],[300,"قصه اصحاب ضروان خوانده‌ای","پس چرا در حیله‌جویی مانده‌ای","به داستان اهل ضروان گوش کرده‌ای، پس چرا هنوز در تلاش برای فریب و حیله‌گری باقی مانده‌ای؟"],[300,"حیله می‌کردند کزدم‌نیش چند","که برند از روزی درویش چند","آن‌ها به وسیله نیرنگ و حیله‌ای که به کار می‌بستند، تلاش می‌کردند تا از معیشت درویشان، چندین روزی درو کنند."],[300,"شب همه شب می‌سگالیدند مکر","روی در رو کرده چندین عمرو و بکر","هر شب در اندیشه حیله بودند . در مکر و حیله چندین برابر عمر و ابوبکر بودند"],[300,"خفیه می‌گفتند سرها آن بدان","تا نباید که خدا در یابد آن","آنها به طور پنهانی و نهانی درباره این مطلب صحبت می‌کردند که نباید سر خود را از خدا پنهان کنند، زیرا خداوند از همه چیز آگاه است و هیچ چیزی را نمی‌توان در پیش او مخفی نگه داشت."],[300,"با گل انداینده اسگالید گل","دست کاری می‌کند پنهان ز دل","شخصی که دستش گل اندود شده تصور میکند میتواند با آن دست کاری انجام دهد که دلش از آن اگاه نشود"],[300,"گفت الا یعلم هواک من خلق","ان فی نجواک صدقا ام ملق","گفت: آیا نمی‌داند کسی که برای او عشق می‌ورزد، که در پنهانی صدای او حقیقت دارد یا فقط بازی و تظاهر است؟"],[300,"گفت یغفل عن ظعین قد غدا","من یعاین این مثواه غدا","اولا گفت در اول مصراع غلط است. کیف یغفل ... درست است و ترجمه صحیح میشود: چگونه میشود که تو که نظری به دختر نینداختی او را در خاطر داری. اما منی که نگاه کردم او را فراموش کردم؟ این داستان دو درویش است که از رودخانه ای میگذشتن دختری میخواست از رودخانه عبور کند از ایشان کمک خواست یکی از آنها دختر را به دوش گرفت و به آن سمت رودخانه برد و رها کرد. ساعتی بعد درویش دیگر به او گفت او نامحرم بود و تو خطا کردی. گفت : من او را کنار رودخانه رها کردم ولی تو هنوز او را رها نکردی"],[300,"اینما قد هبطا او صعدا","قد تولاه و احصی عددا","هر کجا که رفتند، بالا یا پایین، خداوند آن‌ها را با علم و شمارش دقیق در نظر دارد."],[300,"گوش را اکنون ز غفلت پاک کن","استماع هجر آن غمناک کن","گوش خود را از گناهان پاک کن و گوش فرا ده به درد دل یک دلسوخته"],[300,"آن زکاتی دان که غمگین را دهی","گوش را چون پیش دستانش نهی","این را یک کار خیر و زکات بدان وقتی که به درد دل یک آدم دردمند گوش می‌دهی"],[300,"بشنوی غمهای رنجوران دل","فاقه جان شریف از آب و گل","غم‌های رنجوران را بشنو که جان‌های شریف آن‌ها از فقر و تنگدستی رنج می‌برد و در آن حال می‌سوزند."],[300,"خانه پر دود دارد پر فنی","مر ورا بگشا ز اصغا روزنی","خانه ای که آکنده از دود گشته کشنده است مگر آنکه از راه گوش (اصغا) برایش روزنه ای باز کنی"],[300,"گوش تو او را چو راه دم شود","دود تلخ از خانه او کم شود","گوش سپردن تو برای او مانند راه تنفسی میگردد که باعث میشود فشار مشکلات را راحتتر تحمل کند"],[300,"غمگساری کن تو با ما ای روی","گر به سوی رب اعلی می‌روی","ای رهرو اگر مقصد و مقصود تو خداوندگار عالم است غم گسار ما و اهل بلا باش"],[300,"این تردد حبس و زندانی بود","که بنگذارد که جان سویی رود","این حالی به حالی شدن ( که با گوش سپردن به غم دیگران به انسان دست میدهد ) باعث میشود که روح تو به سمت چیزهای مادی و بی ارزش جذب نشود"],[300,"این بدین سو آن بدان سو می‌کشد","هر یکی گویا منم راه رشد","در دنیا جاذبه های بسیاری وجود دارد و هرکدام هم خودشان را راه رشد و کمال معرفی میکنند"],[300,"این تردد عقبه راه حقست","ای خنک آن را که پایش مطلقست","این حالی به حالی شدن و دگرگونی حالات گردنه های پرپیچ راه حق است و خوش به حال کسی که در این مسیر پایش محکم است. ( البته شعر ایهام دارد و معنی پایش به معنی پاییدن و مراقبت از نفس نیز میدهد)"],[300,"بی‌تردد می‌رود در راه راست","ره نمی‌دانی بجو گامش کجاست","بدون آزمون و خطا در راه راست حرکت میکند و تو اگر راه را نمیشناسی به دنبال جای پای چنین کسانی باش که سرامد راستی و پاکی اند. ( در این بیت به یک داستان در مورد حضرت علی علیه السلام و سلمان فارسی اشاره شده است. یک روز عمر بن خطاب به دنبال امیرالمومنین میگشت. به او گفتند با سلمان به بیابان رفت. عمر به سمت بیابان رفت و هرچه گشت فقط یک جای پای دید همان را دنبال کرد تا به امیرالمومنین و سلمان رسید و پرسید چطور شما دو نفرید با یک جای پا؟ سلمان گفت من هر زمان که با علی علیه السلام باشم فقط پایم را جای پای او میگذارم و پشت سر او گام به گام حرکت میکنم.)"],[300,"گام آهو را بگیر و رو معاف","تا رسی از گام آهو تا به ناف","جای پای آهوی فراری را دنبال کن و با خیال راحت برو که به مشکی که زیر ناف آهو است ( مرکز و مقصود و محل پیدایش همانگونه که ما انسانها رشته اتصالات به حیات در ابتدا با بند ناف به مادر بود) میرسی. در این بیت دو اشاره ابجد وجود دارد به شخص امیرالمومنین که خارج از بحث است"],[300,"زین روش بر اوج انور می‌روی","ای برادر گر بر آذر می‌روی","با این روش قطعا به اوج نور خواهی رسید به گونه ای که انگار بر آذرخش مسلط گشتی و به آنی به مقصود میرسی"],[300,"نه ز دریا ترس نه از موج و کف","چون شنیدی تو خطاب لا تخف","( پیرو ابیات قبلی اگر در راه راست حرکت کردی ) از بالا و پایین دنیا نترس وقتی که به تو پیغام نترس رسید. ( اشاره به حداقل ده مورد آیه قرآن که اکثرا در مورد حضرت موسی است. به طور مثال در آیات ۶۶ تا ۶۸ سوره طه داستان ترسیدن حضرت موسی از چوب دستهای جادوگران فرعون است که تبدیل به مار شد و در اینجا خداوند فرمود از این حیله مترس که قطعا تو برتری"],[300,"لا تخف دان چونک خوفت داد حق","نان فرستد چون فرستادت طبق","حتی این ترس هم از جانب خدا و برای رشد توست تا ایمانت محکم‌تر شود. خداوند از قبل راه برون رفت از مشکلات را به تو آموخته و همه این مشکلات هم از جانب خدا برای پیشرفت خودت است"],[300,"خوف آن کس راست کاو را خوف نیست","غصه آن کس را کش اینجا طوف نیست","کسی باید بترسد که هیچ ترسی ندارد{کسی که از خدا نمی ترسد}. غم و رنج کسی را بخور که به دنبال چیزی نمی گردد{طوف به معنی گردیدن به دنبال چیزی است و واژه طواف هم از همین ریشه است}"],[301,"خواجه در کار آمد و تجهیز ساخت","مرغ عزمش سوی ده اشتاب تاخت","خواجه وارد عمل شد و وسایل سفر را آماده کرد و با شتاب به سمت ده حرکت کرد."],[301,"اهل و فرزندان سفر را ساختند","رخت را بر گاو عزم انداختند","خاندان و فرزندان سفر را آماده کردند و بار را بر روی گاو عزم، که به سفر می‌رفت، گذاشتند."],[301,"شادمانان و شتابان سوی ده","که بری خوردیم از ده مژده ده","شادی و شتاب در دل‌هاست که به سوی ده حرکت می‌کنیم، زیرا از ده خبر خوشی به ما رسیده است."],[301,"مقصد ما را چراگاه خوش‌ست","یار ما آنجا کریم و دلکش‌ست","مقصد ما چراگاه خوشی است، زیرا یار ما در آنجا مهربان و دلپذیر است."],[301,"با هزاران آرزو‌مان خوانده است","بهر ما غرس کرم بنشانده است","به خاطر آرزوهای زیاد ما، خداوند بر ما نعمت‌ها و برکات فراوانی ارزانی داشته و از کرمش درختانی را به بار نشاند."],[301,"ما ذخیره ده زمستان دراز","از بر او سوی شهر آریم باز","ما در این ده زمستان طولانی، ذخیره‌هایی از نعمت‌ها و برکات که به خاطر او (خدا) به دست آورده‌ایم، به سوی شهر (مقصد نهایی) خواهیم آورد."],[301,"بلک باغ ایثار راه ما کند","در میان جان خودمان جا کند","خوشبختی و نیکی‌ای که به واسطه ایثار و گذشت حاصل می‌شود، همانند باغی است که ما را در زندگی‌مان راه می‌دهد و روح‌مان را جایگاه خود می‌سازد."],[301,"عجلوا اصحابنا کی تربحوا","عقل می‌گفت از درون لا تفرحوا","عجلوا به معنای شتاب کنید، و اصحاب ما به معنی دوستان ما خطاب به آنهاست. در اینجا به دوستان توصیه می‌شود که زودتر اقدام کنند تا سود ببرند، ولی عقل از درون به آنها هشدار می‌دهد که شاد نشوند و به خوشحالی نپردازند."],[301,"من رباح الله کونوا رابحین","ان ربی لا یحب الفرحین","خداوند گفته است که شما پیروزی‌ها را به دست آورید، چرا که پروردگار من، خوشحالی‌های بی‌جا را دوست ندارد."],[301,"افرحوا هونا بما آتاکم","کل آت مشغل الهاکم","شاد باشید و به آرامی از آنچه به شما داده شده خوشحال شوید، زیرا هر چیزی که به شما می‌رسد، شما را مشغول می‌کند و از حقایق مهم غافل می‌سازد."],[301,"شاد از وی شو مشو از غیر وی","او بهار‌ست و دگرها ماه دی","از او شاد باش و به غیر او دل‌خوش نباش، زیرا او بهار زندگی است و باقی چیزها مانند ماه دی (که سرد و ناپسند است) هستند."],[301,"هر چه غیر اوست استدراج تست","گرچه تخت و ملکت است و تاج تست","هر چیزی که غیر از خداوند است، باعث شکست و سقوط تو خواهد شد، حتی اگر آن چیزها مثل تخت، حکومت و تاج به نظر باارزش بیایند."],[301,"شاد از غم شو که غم دام لقا‌ست","اندرین ره سوی پستی ارتقا‌ست","از غم شاد شو زیرا غم در واقع وسیله‌ای برای رسیدن به وصال و اتصال به عشق الهی است و در این مسیر، سیر به سمت بالا و ارتقا وجود دارد."],[301,"غم یکی گنجی‌ست و رنج تو چو کان","لیک کی در گیرد این در کودکان‌؟","غم همچون یک گنج باارزش است و رنج تو مانند معدن است، اما این موضوع را چه کسی درک می‌کند؟ آیا کودکان قادرند آن را بفهمند؟"],[301,"کودکان چون نام بازی بشنوند","جمله با خر گور هم تگ می‌دوند","کودکان وقتی نام بازی را می‌شنوند، همه با شادی و هیجان به سمت آن می‌دوند، حتی اگر مانند خر بی‌فکر عمل کنند."],[301,"ای خران کور این سو دام‌هاست","در کمین این سوی خون‌آشام‌هاست","ای خرهای کور، در این سمت، دام‌هایی وجود دارد که در کمین شما هستند و در سمت دیگر، خطراتی جدی و خون‌آشام وجود دارد."],[301,"تیرها پران کمان پنهان ز غیب","بر جوانی می‌رسد صد تیر شیب","تیرهای ناپیدا و پنهان از کمان، به طور ناگهانی و از عالم غیب به سمت جوانی می‌آید و او را هدف قرار می‌دهد، در حالی که شدت این تیرها بسیار زیاد است."],[301,"گام در صحرای دل باید نهاد","زانکه در صحرای گل نبود گشاد","برای رسیدن به درک واقعی و عمیق، باید قدم در دشت دل گذاشت، چرا که در دشت مادی و بی‌ارزش، جایی برای گشایش و رستگاری وجود ندارد."],[301,"ایمن‌آباد است دل ای دوستان","چشمه‌ها و گلستان در گلستان","دل مانند ایمن‌آباد (محل امن و راحت) است، ای دوستان، که در آن چشمه‌ها و گلستان‌ها وجود دارد و به زیبایی و سرسبزی قرین است."],[301,"عج الی القلب و سر یا ساریه","فیه اشجار و عین جاریه","عجله کن تا به دل برسی و رازهای آن را بشناسی، زیرا در دل درختان و چشمه‌های جاری وجود دارد."],[301,"ده مرو ده مرد را احمق کند","عقل را بی نور و بی رونق کند","به روستای احمق نرو که خرد و روشنایی انسان را از او می‌گیرد و او را به بی‌خودی می‌کشاند."],[301,"قول پیغامبر شنو ای مجتبی","گور عقل آمد وطن در روستا","پیامبر می‌گوید، ای مجتبی! عقل در روستاها به مانند گوری است که دیگر نمی‌تواند رشد و درخشندگی خودش را حفظ کند."],[301,"هر که در رستا بود روزی و شام","تا به ماهی عقل او نبود تمام","هر کسی که در روستا زندگی می‌کند و فقط روز و شب را می‌گذرانند، تا زمانی که درک و شعور کامل نداشته باشد، به اندازه یک ماهی عقل و فهم نخواهد داشت."],[301,"تا به ماهی احمقی با او بود","از حشیش ده جز اینها چه‌درود‌؟","اگر کسی تا آخر عمر در یک دهکده بماند و از زندگی محدود و نادانی خود راضی باشد، چه چیز دیگری می‌تواند از این وضعیت ناپسند به دست آورد؟"],[301,"وانکه ماهی باشد اندر روستا","روزگاری باشدش جهل و عمی","کسی که در روستا زندگی می‌کند و مانند ماهی است، ممکن است مدت‌ها در جهل و نادانی بماند."],[301,"ده چه باشد؟ شیخ واصل ناشده","دست در تقلید و حجت در زده","ده چه ارزشی دارد، وقتی کسی که به مقامات عالی نرسیده هنوز به تقلید و استدلال‌های غیرمستند چنگ زده است؟"],[301,"پیش شهر عقل کلّی‌، این حواس","چون خران چشم‌بسته در خراس","آس دو سنگ گرد و مسطح است که بر هم نهاده و به وسیله آن غلات را آرد کنند. اگر با چارپا بگردانند آنرا «خراس» و اگر با آب بگردانند «آسیاب» و نیز آسیاب نام عام این محل نیز هست. نوع کوچک دستی را ‌«دستاس‌» نامند."],[301,"این رها کن صورت افسانه گیر","هل تو دردانه تو گندم‌دانه گیر","(فعلا) معنا را رها کن و به ظاهر داستان توجه کن؛ (فعلا) مروارید معنا را بهل و بگذار و گندم‌دانه‌ی صورت را بگیر."],[301,"گر به در ره نیست هین بر می‌ستان","گر بدان ره نیستت این سو بران","اگر به در (یعنی مروارید) دسترسی نداری، پس شراب بنوش. و اگر نمی‌توانی به آن راه برسی، به این سو بیفت و حرکت کن."],[301,"ظاهر‌ش گیر ار چه ظاهر کژ پرد","عاقبت ظاهر سوی باطن برد","اگرچه به ظاهر چیزی نادرست و کژ به نظر می‌آید، در نهایت این ظاهر می‌تواند به درک باطن و حقیقتی عمیق‌تر منجر شود."],[301,"اول هر آدمی خود صورت است","بعد از آن جان کاو جمال سیرت است","هر انسانی ابتدا فقط به شکل ظاهری‌اش شناخته می‌شود، اما پس از آن، جان و روح اوست که زیبایی باطنی‌اش را نشان می‌دهد."],[301,"اول هر میوه جز صورت کی است؟","بعد از آن لذت‌، که معنی وی است","هر میوه ابتدا یک ظاهر دارد، اما بعد از آن، لذتی که از طعم و معنی آن می‌برند اهمیت دارد."],[301,"اولا خرگاه سازند و خرند","ترک را زان پس به مهمان آورند","در ابتدا گرازها را برای بارکشی و کار آماده می‌کنند و سپس آنها را به مهمان می‌آورند."],[301,"صورتت خرگاه دان معنیت ترک","معنیت ملّاح دان صورت چو فلک","ظاهر تو را مانند خرگاه (پناهگاه) تصور کن و باطن تو را مانند ترک، که نوعی قایق یا کشتی است. در واقع، جسم تو همچون یک کشتی است که دریا (معنیت) آن را حمل می‌کند."],[301,"بهر حق این را رها کن یک نفس","تا خر خواجه بجنباند جرس","به خاطر خدا، این دنیای زودگذر را یک لحظه رها کن تا کاملا متوجه شوی که خواجه (انسان کامل) از تو چه می‌خواهد و با تو چگونه همراه است."],[302,"خواجه و بچگان جهازی ساختند","بر ستوران جانب ده تاختند","خواجه و کودکانی که همراه او بودند، سفره‌ای آماده کردند و بر مرکب‌ها سوار شده، به سمت ده روانه شدند."],[302,"شادمانه سوی صحرا راندند","سافروا کی تغنموا بر خواندند","شادمان و خوشحال به سوی دشت و صحرا رفتند و آغاز به آواز و سرود کردند که آیا سفر بدون بهره‌وری و سود حاصل می‌شود؟"],[302,"کز سفرها ماه کیخسرو شود","بی سفرها ماه کی خسرو شود؟","اگر کسی سفر نکند، چگونه می‌تواند به مقام و مرتبه‌ای چون کیخسرو، پادشاه نامدار، دست یابد؟ این سوال بیان می‌کند که سفر و تجربه‌های جدید در زندگی اهمیت حیاتی دارند."],[302,"از سفر بیدق شود فرزین راد","وز سفر یابید یوسف صد مراد","معنی این بیت این است که فرزین، شخصیتی شجاع و دلیر، از سفر به مقام بیدق (مقام بلند و ارجمند) می‌رسد و یوسف، با سفر کردن، به صد آرزو و امکان‌های بزرگ دست می‌یابد."],[302,"روز روی از آفتابی سوختند","شب ز اختر راه می‌آموختند","در روز به خاطر تابش آفتاب و گرما، چهره‌ها دچار خستگی و کم‌حوصلگی می‌شوند، اما در شب با ستاره‌ها و زیبایی آسمان به یادگیری و پیدا کردن راه‌ها ادامه می‌دهند."],[302,"خوب گشته پیش ایشان راه زشت","از نشاط ده شده ره چون بهشت","در نزد آن‌ها، راه زشت به‌گونه‌ای زیبا و دلپذیر جلوه می‌کند که احساس شادی و نشاطی به انسان می‌دهد و این مسیر به‌واسطه شادی‌ای که در آن ده وجود دارد، همانند بهشت می‌شود."],[302,"تلخ از شیرین‌لبان خوش می‌شود","خار از گلزار دلکش می‌شود","از دهان کسانی که شیرین‌لب هستند، تلخی به وجود می‌آید و از گلزار زیبا، خار نیز پدید می‌آید."],[302,"حنظل از معشوق خرما می‌شود","خانه از همخانه صحرا می‌شود","میوه‌ای به نام حنظل، که تلخ و ناگوار است، از معشوق به شیرینی خرما تبدیل می‌شود، و همچنین، خانه‌ای که باید با همسر زندگی شیرینی داشته باشد، در عوض به بیابان و تنهایی بدل می‌شود."],[302,"ای بسا از نازنینان خارکش","بر امید گل‌عذار ماه‌وش","بسیاری از عزیزان (نازنینان) در عشق، مانند کسی که خارها را جمع می‌کند، به امید رسیدن به دلبری با چهره زیبا، زحمت می‌کشند."],[302,"ای بسا حمال گشته پشت‌ریش","از برای دلبر مه‌روی خویش","بسیاری از باربران (حمالان) به خاطر عشق به دلبر زیبای خود، به زحمت افتاده و خسته شده‌اند."],[302,"کرده آهنگر جمال خود سیاه","تا که شب آید ببوسد روی ماه","آهنگر به دلیل زیبایی معشوق خود، چهره‌اش را سیاه کرده تا وقتی شب می‌شود، بتواند صورت معشوق را ببوسد."],[302,"خواجه تا شب بر دکانی چار میخ","زانک سروی در دلش کرده‌ست بیخ","خواجه تا شب در دکان خود چهار میخ زده است، زیرا در دلش عشق و محبت سروی (موجودی زیبا) ریشه دوانده است."],[302,"تاجری دریا و خشکی می‌رود","آن به مهر خانه‌شینی می‌دود","تاجری از دریا به سمت خشکی و خانه‌اش می‌رود و به خاطر محبتش به خانه‌نشینی با شتاب حرکت می‌کند."],[302,"هر که را با مرده سودایی بود","بر امید زنده‌سیمایی بود","هر کسی که با مرده‌ای (شخصی که روحش رفته یا از دنیا رفته) ارتباط یا آرزویی دارد، به امید آن است که زنده‌ای (شخص زنده و شاداب) را بیابد یا دوباره زندگی را تجربه کند."],[302,"آن دروگر روی آورده به چوب","بر امید خدمت مه‌روی خوب","آن کشاورز به خاطر امیدی که به خدمت‌رسانی به معشوق زیبایش دارد، با چوب (وسیله کارش) به سمت او آمده است."],[302,"بر امید زنده‌ای کن اجتهاد","کاو نگردد بعد روزی دو جماد","برای رسیدن به زندگی واقعی و معنوی، تلاش کن که شخصی از عشق و ایمان است و هیچ‌گاه به حالت بی‌حالی و بی‌تحرکی دچار نمی‌شود."],[302,"مونسی مگزین خسی را از خسی","عاریت باشد درو آن مونسی","از روی خسی و کم‌مایگی‌، یک یار و مونس خس و بی‌ارزش مگزین که مهر و دوستی او عاریتی و ناپایدار باشد."],[302,"انس تو با مادر و بابا کجاست","گر به جز حق مونسانت را وفاست","دوستی و نزدیکی تو با مادر و پدر کجاست، اگر به جز عشق و محبت الهی به دیگران اعتماد داری؟"],[302,"انس تو با دایه و لالا چه شد","گر کسی شاید بغیر حق عضد","رابطه تو با دایه و پرستارت چه شده است، اگر کسی می‌تواند به جز خداوند، پشتیبان تو باشد؟"],[302,"انس تو با شیر و با پستان نماند","نفرت تو از دبیرستان نماند","رابطه تو با شیر و پستان (دایت) دیگر قطع شده و محبت به آن از بین رفته است، هم‌چنین نفرت تو از دبیرستان (آموزش) نیز از بین رفته و باقی نمانده است."],[302,"آن شعاعی بود بر دیوارشان","جانب خورشید وا رفت آن نشان","آن شعاعی که به دیوار قوم دبیرستان می‌تابید، مانند اثر نور خورشید روی دیوار، دیگر قابل دیده شدن نیست و از بین رفته است."],[302,"بر هر آن چیزی که افتد آن شعاع","تو بر آن هم عاشق آیی ای شجاع","هر چیزی که نور و شعاع تو بر آن بتابد، به عشق تو مبتلا خواهد شد. ای شجاع، تو حتی بر آن چیزها نیز عشق می‌ورزی."],[302,"عشق تو بر هر چه آن موجود بود","آن ز وصف حق زر اندود بود","عشق تو به هر موجودی که تعلق گیرد، آن موجود به وصف خداوند، به طلا آغشته و ارزشمند است."],[302,"چون زری با اصل رفت و مس بماند","طبع سیر آمد طلاق او براند","زمانی که طلا (عشق و حقیقت) از اصل خود (خدا) جدا می‌شود و به مس (دنیا و مادیات) تبدیل می‌گردد، طبیعت (روح و دل) از ارتباط با حقیقت و عشق اصلی طلاق می‌گیرد و دور می‌شود."],[302,"از زر اندود صفاتش پا بکش","از جهالت قلب را کم گوی خوش","از ویژگی‌های ظاهری و تظاهر به مادیات بگذر و با جهالت و نادانی دل خود را آلود نکن، چرا که این‌ها نیازی را برطرف نمی‌کنند."],[302,"کان خوشی در قلبها عاریت است","زیر زینت مایه بی‌زینت است","خوشی که در دل‌ها وجود دارد، حقیقتا متعلق به خود انسان‌ها نیست و به‌نوعی امانت است؛ این خوشی در زیر ظاهر و زینت‌های ظاهری پنهان شده است و خود مایه‌ای خالص و بی‌زینت به شمار می‌رود."],[302,"زر ز روی قلب در کان می‌رود","سوی آن کان رو تو هم کآن می‌رود","خوشی و لذت حقیقی از دل انسان سرچشمه می‌گیرد و مانند طلا در دل است که به سوی آن گنجینه می‌رود، پس تو هم به آن مکان حقیقی بگرای که به سوی آن می‌رود."],[302,"نور از دیوار تا خور می‌رود","تو بدان خور رو که در خور می‌رود","نور از دیوار به سمت خورشید می‌رود، تو هم به سمت خورشید حرکت کن زیرا نور به سوی آن می‌رود."],[302,"زین سپس بستان تو آب از آسمان","چون ندیدی تو وفا در ناودان","از این پس، آب را از آسمان بگیر، زیرا وقتی وفاداری را در ناودان (یعنی در دنیا و مادیات) ندیدی، نباید انتظار وفا داشته باشی."],[302,"معدن دنبه نباشد دام گرگ","کی شناسد معدن آن گرگ سترگ","گرگ که حیوانی گوشت‌خوار و شکارچی است، نمی‌تواند در معدن دنبه (چربی و غذای چربی‌دار) حضور داشته باشد. بنابراین، شناختن منبع غذای خود برای گرگ بزرگ دشوار است. این بیت به این معناست که اگر در جایی از منابع خوب و مفید نباشد، چطور می‌توان انتظار داشت که شکارچی یا جانداری آن را بشناسد."],[302,"زر گمان بردند بسته در گره","می‌شتابیدند مغروران به ده","مغروران تصور کردند که طلا و ثروت در گره بسته‌ای وجود دارد و به سرعت به سوی ده می‌شتابیدند."],[302,"همچنین خندان و رقصان می‌شدند","سوی آن دولاب چرخی می‌زدند","آن‌ها با شادی و خنده به سمت ده می‌رفتند و به حالت رقص در اطراف دولاب می‌چرخیدند."],[302,"چون همی‌دیدند مرغی می‌پرید","جانب ده صبر جامه می‌درید","در قدیم مردم در هنگام سفر وقتی‌که پرندگان خاصی مانند گنجشک‌ها و کبوتر‌های اهلی را می‌دیدند متوجه می‌شدند که به آبادنی و یا یک ده نزدیک شده‌اند. بیت یعنی با دیدن پرنده‌ها خیلی بی‌قرار شده بودند که بزودی به ده می‌رسند."],[302,"هر که می‌آمد ز ده از سوی او","بوسه می‌دادند خوش بر روی او","هر کس که از ده به سمت او می‌آمد، بر صورت او بوسه می‌زدند و به این کار خوشحال بودند."],[302,"گر تو روی یار ما را دیده‌ای","پس تو جان را جان و ما را دیده‌ای","اگر تو چهره محبوب ما را دیده‌ای، پس تو جان را درست درک کرده‌ای و ما را نیز دیده‌ای."],[303,"همچو مجنون کاو سگی را می‌نواخت","بوسه‌اش می‌داد و پیشش می‌گداخت","مانند مجنون، که برای سگی که به او نزدیک می‌شد، محبت و نوازش می‌کرد و به او بوسه می‌داد و در برابرش به خاک افتاده بود."],[303,"گرد او می‌گشت خاضع در طواف","هم جلاب شکرش می‌داد صاف","گرد سگ عاشقانه و با فروتنی میگشت و شربت ( جلاب ) شکر به او میداد ( بهترین چیزی که داشت برایش فراهم می‌کرد )"],[303,"بوالفضولی گفت ای مجنون خام","این چه شیدست این که می‌آری مدام","بوفضول ( بو مخفف ابو به معنی صاحب است ) یعنی، شخصی که بسیار فضول است از او پرسید ای مجنون ساده لوح این چه دیوانگی ای است که هر زمان به آن مشغولی؟"],[303,"پوز سگ دایم پلیدی می‌خورد","مقعد خود را به لب می‌استرد","سگ همیشه مشغول کثافت‌کاری است و به همین دلیل خودش را با مواد پلید آلوده می‌کند."],[303,"عیبهای سگ بسی او بر شمرد","عیب‌دان از غیب‌دان بویی نبرد","و بسیاری از معایب سگ را یک به یک برشمرد اما انسانی که نگاهش فقط به عیوب دیگران است هیچگاه از مخزن اسرار حق که همان دل است دست نمیابد"],[303,"گفت مجنون تو همه نقشی و تن","اندر آ و بنگرش از چشم من","مجنون به او گفت تو فقط در ظاهر را میبینی پیش بیا و از دید من نگاه کن تا ماهیت وجودش را ببینی"],[303,"کاین طلسم بسته مولیست این","پاسبان کوچه لیلیست این","اولا شعر به این صورت است. کین طلسم بسته مولاست این پاسبان کوچه لیلاست این و اینگونه معنی می‌شود که این پاسدار حریم معشوق من است و از طرف مولایم به این کار گمارده شده و میشود اینگونه هم معنی کرد که او هم مثل من دیوانه و شیدای اربابم است و ..."],[303,"همنشین بین و دل و جان و شناخت","کاو کجا بگزید و مسکن‌گاه ساخت","او همطراز و همنشین من است و ببین چقدر والامقام است که می‌دانست کجا منزل بگزیند"],[303,"او سگ فرخ‌رخ کهف منست","بلک او هم‌درد و هم‌لهف منست","او سگ خوش اقبال کوچه من است ( کهف به معنای غار و در اینجا به معنای خلوتگاه و جایی که در آن احساس آرامش می‌کنی ) او نیز همان درد و غم مرا دارد"],[303,"آن سگی که باشد اندر کوی او","من به شیران کی دهم یک موی او","سگی که در کوی یار قدم بردارد من یک مویش را با شیران عوض نخواهم کرد"],[303,"ای که شیران مر سگانش را غلام","گفت امکان نیست خامش والسلام","(در این بیت ناگهان مولانا با کس دیگری سخن میگوید و از جانب او هم پاسخ می‌دهد.) ای که شیران شرزه جلوی سگان تو مانند غلام حلقه بگوشند ( و بدون اینکه بگوید به آن شخص چه گفته ناگهان پاسخ او را می‌آورد ) گفت امکانش وجود ندارد خاموش باش و دیگری چیزی نگو"],[303,"گر ز صورت بگذرید ای دوستان","جنت است و گلستان در گلستان","اگر از ظاهر و شکل خود بگذرید، دوستان، بهشت و باغ گل در درون آن باغ وجود دارد."],[303,"صورت خود چون شکستی سوختی","صورت کل را شکست آموختی","وقتی که صورت خود را بشکنی و از ظواهر و ظاهرگرایی رها شوی، معنای کل وجود و حقیقت را نیز درمی‌یابی و به آن می‌رسی."],[303,"بعد از آن هر صورتی را بشکنی","همچو حیدر باب خیبر بر کنی","پس از آن، هر شکل و صورتی را، مانند حیدر (علی) که در جنگ خیبر میخ را از ریشه درمی‌آورد، شکستن و از بین بردن آسان است."],[303,"سغبه صورت شد آن خواجه سلیم","که به ده می‌شد به گفتاری سقیم","خواجه‌ای سلیم (مؤدب و نیک‌رفتار) به صدای سگی که در کوی لیلی (محل محبوب مجنون) نواخته می‌شود، به شدت تحت تأثیر قرار می‌گیرد و حالتی خراب و بی‌حالی به او دست می‌دهد."],[303,"سوی دام آن تملق شادمان","همچو مرغی سوی دانه امتحان","انسان‌ها به سمت تملق و چاپلوسی جذب می‌شوند، مانند مرغی که به سوی دانه‌ای می‌شتابد که امتحانی برایش محسوب می‌شود."],[303,"از کرم دانست مرغ آن دانه را","غایت حرص است نه جود آن عطا","مرغ با درک محبت و لطف خدا، متوجه می‌شود که دانه‌ای که به او داده شده، تنها نشانه‌ای از حرص و فریب است و در واقع نشان‌دهنده بخشش واقعی نیست."],[303,"مرغکان در طمع دانه شادمان","سوی آن تزویر پران و دوان","مرغان در انتظار دانه بسیار خوشحال و شاداب به سمت آن فریبنده پرواز می‌کنند و می‌دوند."],[303,"گر ز شادی خواجه آگاهت کنم","ترسم ای ره‌رو که بیگاهت کنم","اگر بخواهم تو را از شادی عزیز یا بزرگ‌مقام (خواجه) مطلع کنم، ترس دارم که از راه خود منحرف شوی و به بی‌راهه بروی."],[303,"مختصر کردم چو آمد ده پدید","خود نبود آن ده ره دیگر گزید","وقتی که ده را دیدم، مختصر و سریع به آنجا رفتم، اما آن ده به من آشنا نبود و راه دیگری را انتخاب کردم."],[303,"قرب ماهی ده به ده می‌تاختند","زانک راه ده نکو نشناختند","گروه ماهی‌ها به سوی ده می‌رفتند و با سرعت حرکت می‌کردند، زیرا راه مناسب و خوب به ده را نمی‌شناختند."],[303,"هر که در ره بی قلاوزی رود","هر دو روزه راه صدساله شود","هر کسی که بدون راهنمایی و مشخصی به راه برود، در مدت کوتاهی به اندازه‌ای از پیشرفت دست پیدا می‌کند که در حالت عادی باید صد سال وقت می‌برد."],[303,"هر که تازد سوی کعبه بی دلیل","همچو این سرگشتگان گردد ذلیل","هر کسی که بدون دلیل و آگاهی به طرف کعبه (محل مقدس مسلمانان) برود، مانند این افراد سرگردان، ذلیل و بی‌احترام خواهد شد."],[303,"هر که گیرد پیشه‌ای بی‌اوستا","ریش‌خندی شد به شهر و روستا","هر کس بدون استاد و معلم به دنبال حرفه‌ای برود، در شهر و روستا مورد تمسخر قرار می‌گیرد."],[303,"جز که نادر باشد اندر خافقین","آدمی سر بر زند بی والدین","تنها نادر است افرادی که در زمین (خافقین) وجود ندارند و بدون والدین به دنیا می‌آیند."],[303,"مال او یابد که کسبی می‌کند","نادری باشد که بر گنجی زند","کسی که کار و کوشش می‌کند، به مال و ثروت می‌رسد. اما فردی که به صورت تصادفی و بدون زحمت به گنجی دست یابد بسیار نادر است."],[303,"مصطفایی کو که جسمش جان بود","تا که رحمن علم‌القرآن بود","مصطفی (پیامبر اسلام) کیست که جسمش روح (جان) او بود و همچنین رحمن (خدا) نیروی علم قرآن را به او عطا کرده است."],[303,"اهل تن را جمله علم بالقلم","واسطه افراشت در بذل کرم","همه کسانی که به جسم و ظاهر وابسته‌اند، از طریق نوشتن و علم، واسطه‌ای هستند که در بخشش کرم و نیکوکاری خدمت می‌کنند."],[303,"هر حریصی هست محروم ای پسر","چون حریصان تگ مرو آهسته‌تر","هر طمع‌ورزی، در نهایت، محروم و بی‌نصیب است، پسر، مانند کسانی که در طلب دنیا و مال و ثروت می‌دوند، پس باید با آرامش و احتیاط بیشتری پیش بروی."],[303,"اندر آن ره رنجها دیدند و تاب","چون عذاب مرغ خاکی در عذاب","در آن مسیر، رنج‌ها و سختی‌های زیادی را تجربه کردند، مانند عذابی که مرغی خاکی با آن روبرو است و طاقت‌فرساست."],[303,"سیر گشته از ده و از روستا","وز شکرریز چنان نا اوستا","او از ده و روستا دور شده و به جایی رسیده است که شیرینی و خوشی زندگی را دیگر نمی‌تواند احساس کند. وضعیت او به گونه‌ای است که زندگی‌اش بی‌مزه و خالی از لذت شده است."],[304,"بعد ماهی چون رسیدند آن طرف","بی‌نوا ایشان ستوران بی علف","پس از آنکه از کنار دریا گذشتند و به آن سوی رسیدند، گروه بی‌نوا، که از صاحب‌دلان بودند، با اسب‌های خود به جایی رسیدند که علفی برای تغذیه نداشتند."],[304,"روستایی بین که از بدنیتی","می‌کند بعد اللتیا والتی","روستایی را ببین که به خاطر بدی‌های مردمش، بعد از مشکلات و سختی‌ها به وجود آمده است."],[304,"روی پنهان می‌کند زیشان به روز","تا سوی باغش بنگشایند پوز","این بیت به این معناست که شخصی که در مورد او صحبت می‌شود، چهره‌اش را از دیگران پنهان می‌کند تا آنها نتوانند با او ارتباط برقرار کنند و به باغ او که نماد آرامش و زیبایی است، دسترسی پیدا کنند."],[304,"آنچنان رو که همه زرق و شرست","از مسلمانان نهان اولیترست","آن چهره‌ای که همه زرق و برق (ظاهر زیبا) او را در نظر می‌آورد، از مسلمانان هم پنهان‌تر است."],[304,"رویها باشد که دیوان چون مگس","بر سرش بنشسته باشند چون حرس","برخی صورت‌ها وجود دارند که مثل مگس، دیوان یا موجودات دیگر بر سر آن‌ها نشسته‌اند و این وضعیت نشان‌دهنده زرق و برق ظاهری و فریبنده است."],[304,"چون ببینی روی او در تو فتند","یا مبین آن رو چو دیدی خوش مخند","اگر ببینی که چهره‌ی او (که منظور معشوق است) بر تو خیره شده، یا آن چهره را نخواهی دید، وقتی که آن را دیدی، به خوشحالی نپرداز."],[304,"در چنان روی خبیث عاصیه","گفت یزدان نسفعن بالناصیه","در آن چهره ناپاک و گناهکار، خداوند می‌گوید که ما او را بر اساس پیشانی‌اش (ناصیه‌اش) مجازات خواهیم کرد."],[304,"چون بپرسیدند و خانه‌ش یافتند","همچو خویشان سوی در بشتافتند","پس از اینکه خواجه و همراهانش از حال همسایه‌ها باخبر شدند، به سوی در خانه‌ی آن‌ها rushed (بشتافتند) مانند خویشاوندان خود."],[304,"در فرو بستند اهل خانه‌اش","خواجه شد زین کژروی دیوانه‌وش","اهل خانه‌ خواجه در نتیجه رفتار کج‌دار و مریز او که دیوانه‌وار به نظر می‌رسید، در را به روی او بستند و از او پذیرایی نکردند."],[304,"لیک هنگام درشتی هم نبود","چون در افتادی به چه تیزی چه سود","ولی در وقت خشم و تندی هم فایده‌ای ندارد، مثل این‌که وقتی در چاله یا گودالی بیفتی، چه فایده‌ای دارد."],[304,"بر درش ماندند ایشان پنج روز","شب به سرما روز خود خورشیدسوز","گروه او پنج روز در مقابل در آن روستا ایستادند، شب‌ها در سردی هوا و روزها در گرمای شدید آفتاب به سر بردند."],[304,"نه ز غفلت بود ماندن نه خری","بلک بود از اضطرار و بی‌خری","نگاه کردن به اینکه آن‌ها پنج روز در سرما مانده‌اند، نه به خاطر غفلت یا کم‌خری بود، بلکه به دلیل اضطرار و نداشتن امکانات و منابع کافی بوده است."],[304,"با لئیمان بسته نیکان ز اضطرار","شیر مرداری خورد از جوع زار","او به خاطر اجبار و اضطرار، با انسان‌های پست و لئیم (نکوهیده) ارتباط برقرار کرده و از روی جوع و گرسنگی، غذایی مانند شیر کهنه و بی‌کیفیت می‌خورد."],[304,"او همی‌دیدش همی‌کردش سلام","که فلانم من مرا اینست نام","او با احترام به شخصی که نمی‌شناختش سلام می‌کند و می‌گوید که من فلانی هستم و این نام من است."],[304,"گفت باشد من چه دانم تو کیی","یا پلیدی یا قرین پاکیی","این شخص می‌گوید که نمی‌دانم تو چه کسی هستی؛ آیا انسان پلیدی هستی یا همراهی پاک و نیکو."],[304,"گفت این دم با قیامت شد شبیه","تا برادر شد یفر من اخیه","گفت این لحظه به قیامت شبیه است، به‌طوری که برادر، برادرش را نمی‌شناسد."],[304,"شرح می‌کردش که من آنم که تو","لوتها خوردی ز خوان من دوتو","او در حال توضیح و توصیف خود است و می‌گوید من همان کسی هستم که تو از سفره‌ام طعام‌های لذیذی چون لوت (نوعی خوراک) خوردی."],[304,"آن فلان روزت خریدم آن متاع","کل سر جاوز الاثنین شاع","در آن روز مشخص، من آن کالا را برایت خریدم که ارزش آن از دو برابر قیمت بیشتر است."],[304,"سرّ مهر ما شنیدستند خلق","شرم دارد رو چو نعمت خورد حلق","مردم از محبت ما آگاه شده‌اند، اما به خاطر شرم و حیا، مانند کسی که از نعمت استفاده می‌کند و دهانش را می‌بندد، در بیان آن سکوت می‌کنند."],[304,"او همی‌گفتش چه گویی ترّهات","نه تو را دانم نه نام تو نه جات","او (شخصی که با خواجه سخن می‌گوید) می‌پرسد تو چه می‌گویی، اما من نه تو را می‌شناسم و نه نامت و نه جایت را می‌دانم."],[304,"پنجمین شب ابر و بارانی گرفت","کاسمان از بارشش دارد شگفت","در شب پنجم، آسمان گرفت و باران شدید شروع به باریدن کرد که این پدیده برای خواجه و همراهانش شگفت‌انگیز بود."],[304,"چون رسید آن کارد اندر استخوان","حلقه زد خواجه که مهتر را بخوان","وقتی کارد (خنجر) به استخوان رسید، خواجه (رئیس گروه) به دور مهتر (سرباز یا نگهبان ارشد) حلقه زد تا او را احضار کند."],[304,"چون به صد الحاح آمد سوی در","گفت آخر چیست ای جان پدر","خواجه با اصرار و تکرار به دروازه نزدیک شد و در نهایت از جان پدرش پرسید: «آخر چه می‌خواهی؟"],[304,"گفت من آن حقها بگذاشتم","ترک کردم آنچ می‌پنداشتم","او می‌گوید که عقاید و برداشت‌های قبلی خود را رها کرده‌ام و به چیزی که درک کرده‌ام، پایبند نیستم."],[304,"پنج‌ساله رنج دیدم پنج روز","جان مسکینم درین گرما و سوز","من پنج سال سختی کشیدم، اما حالا که در این گرما و سردی، فقط پنج روز برای جان بیچاره‌ام باقی مانده، احساس می‌کنم که چقدر درد کشیده‌ام."],[304,"یک جفا از خویش و از یار و تبار","در گرانی هست چون سیصد هزار","یک ناراحتی یا آسیب، چه از طرف خودم، چه از جانب دوستان و خانواده، به اندازه‌ی سیصد هزار ناراحتی سنگین و دردآور است."],[304,"زانک دل ننهاد بر جور و جفاش","جانش خوگر بود با لطف و وفاش","چون دلش را بر سختی‌ها و بدی‌های دیگران نگذارد، روحش با مهربانی و وفای آن‌ها آشنا و آرام بوده است."],[304,"هرچه بر مردم بلا و شدتست","این یقین دان کز خلاف عادتست","هرچه که برای مردم سختی و مصیبت است، این را بدان که این امور، از عادات طبیعی و معمولی خارج است."],[304,"گفت ای خورشید مهرت در زوال","گر تو خونم ریختی کردم حلال","ای خورشید مهر، وقتی که در حال غروب هستی و از من دور می‌شوی، اگر تو هم خون من را ریختی، من تو را ببخشیدم و حلال کردم."],[304,"امشب باران به ما ده گوشه‌ای","تا بیابی در قیامت توشه‌ای","امشب باران می‌بارد که ما به گوشه‌ای برویم و در آنجا توشه‌ای برای قیامت تهیه کنیم."],[304,"گفت یک گوشه‌ست آن باغبان","هست اینجا گرگ را او پاسبان","باغبان می‌گوید که اینجا یک گوشه وجود دارد و او برای حفاظت از آن، پاسبان گرگ است."],[304,"در کفش تیر و کمان از بهر گرگ","تا زند گر آید آن گرگ سترگ","در دست باغبان تیر و کمان است تا اگر گرگ بزرگی بیاید، او را بزند و از باغ خود دفاع کند."],[304,"گر تو آن خدمت کنی جا آن تست","ورنه جای دیگری فرمای جست","اگر تو آن خدمت را انجام دهی، آنجا جای تو خواهد بود، وگرنه باید به جست‌وجوی مکان دیگری بپردازی."],[304,"گفت صد خدمت کنم تو جای ده","آن کمان و تیر در کفم بنه","گفت من به تو خدمت‌های زیادی می‌کنم تا تو به من جای بدهی، در این حال تیر و کمان را هم به دستم بده تا آماده باشم."],[304,"من نخسپم حارسی رز کنم","گر بر آرد گرگ سر، تیرش زنم","من نمی‌خوابم و vigilant هستم تا وقتی که گرگ، که استعاره از خطر یا دشمن است، سرش را بیاورد، در این لحظه تیر را به سمت او پرتاب می‌کنم و از خود دفاع می‌کنم."],[304,"بهر حق مگذارم امشب ای دودل","آب باران بر سر و در زیر گل","به خاطر خدا، امشب را با تردید و شک نگذران، زیرا باران بر سرم می‌ریزد و زیر گل‌ها نشسته‌ام."],[304,"گوشه‌ای خالی شد و او با عیال","رفت آنجا جای تنگ و بی مجال","جایی خالی شد و او به همراه خانواده‌اش به آن مکان رفت، جایی که تنگ و بدون فرصت برای راحتی است."],[304,"چون ملخ بر همدگر گشته سوار","از نهیب سیل اندر کنج غار","ملخ‌ها به یکدیگر چسبیده و سوار شده‌اند، انگار از ترس سیل به هم نزدیک شده‌اند و در کنج غار پنهان شده‌اند."],[304,"شب همه شب جمله گویان ای خدا","این سزای ما سزای ما سزا","ما به شب‌ها، از شدت اضطراب و اندوه، مدام به تو فقط می‌گوییم ای خدا، و این حال و روز ما نتیجه رفتارهایمان است."],[304,"این سزای آنک شد یار خسان","یا کسی کرد از برای ناکسان","این نتیجه و پاداش کسانی است که با افراد پست و بی‌ارزش دوستی می‌کنند یا برای آنها کاری انجام می‌دهند."],[304,"این سزای آنک اندر طمع خام","ترک گوید خدمت خاک کرام","این، نتیجه‌ی این است که کسی که به طمع بی‌مورد به دیگران آسیب می‌زند، در نهایت خاک انسان‌های بزرگ (پاکان) را هم نادیده می‌گیرد و به آنها بی‌احترامی می‌کند."],[304,"خاک پاکان لیسی و دیوارشان","بهتر از عام و رز و گلزارشان","خاک افرادی که پاک و نیک هستند، ارزشمندتر از زمین و باغ‌های گل و رز دیگران است."],[304,"بنده یک مرد روشن‌دل شوی","به که بر فرق سر شاهان روی","بهتر است که بنده یک فرد خردمند و روشن‌دل باشی تا اینکه بر سر شاهان و بزرگ‌ترها افتخار کنی."],[304,"از ملوک خاک جز بانگ دهل","تو نخواهی یافت ای پیک سبل","از پادشاهان دنیا جز صدای دهل (صدای جشن یا جنگ) چیزی نخواهی شنید، ای پیام‌آور کسی که در جاده حق حرکت می‌کنی."],[304,"شهریان خود ره‌زنان نسبت به روح","روستایی کیست گیج و بی فتوح","شهرنشینان نسبت به روح روستایی، که دارای بصیرت و آگاهی است، احساس سردرگمی و بی‌هدفی می‌کنند و به درک درستی از وی نمی‌رسند."],[304,"این سزای آنک بی تدبیر عقل","بانگ غولی آمدش بگزید نقل","این نتیجه بی‌مبالاتی و بی‌تدبیری اوست که صدای غول به گوشش رسید و او را برد."],[304,"چون پشیمانی ز دل شد تا شغاف","زان سپس سودی ندارد اعتراف","هنگامی که پشیمانی از دل انسان خارج شد و به عمق وجودش رسید، دیگر اعتراف کردن به اشتباه هیچ فایده‌ای ندارد."],[304,"آن کمان و تیر اندر دست او","گرگ را جویان همه شب سو بسو","مردی که کمان و تیر در دست دارد، در شب به شکار گرگ‌ها می‌پردازد و در جستجوی آنها از این سو به آن سو می‌رود."],[304,"گرگ بر وی خود مسلط چون شرر","گرگ جویان و ز گرگ او بی‌خبر","گرگ (نماد خطر یا دشمن) بر او تسلط دارد و چون آتش سوزان است. در حالی که او بی‌خبر از گرگی است که در پی اوست."],[304,"هر پشه هر کیک چون گرگی شده","اندر آن ویرانه‌شان زخمی زده","هر پشه و هر نوع کک (جانور انگل)، به مانند گرگ‌هایی شده‌اند که در آن ویرانه، زخم‌هایی به آنها زده‌اند."],[304,"فرصت آن پشه راندن هم نبود","از نهیب حمله گرگ عنود","در آن ویرانه، فرصتی برای دور کردن پشه‌ها نبود، زیرا حمله گرگ بدجنس و خطرناک احساس می‌شود."],[304,"تا نباید گرگ آسیبی زند","روستایی ریش خواجه بر کند","تا زمانی که نباید گرگ به روستا آسیب برساند، ریش خواجه را باید برداشت."],[304,"این چنین دندان‌کنان تا نیمشب","جانشان از ناف می‌آمد به لب","در این بیت، توصیف می‌شود که گروهی از مردم، در حالی که در خطر هستند و به شدت نگران‌اند، تا نزدیک نصف شب به حالت ترس و هراس در انتظارند و جانشان به شدت در خطر است. حس وحشت و اضطراب آن‌ها به حدی است که احساس می‌کنند ممکن است جانشان در حال خروج از بدنشان باشد."],[304,"ناگهان تمثال گرگ هشته‌ای","سر بر آورد از فراز پشته‌ای","ناگهان تصویری از یک گرگ از بالای تپه‌ای ظاهر شد."],[304,"تیر را بگشاد آن خواجه ز شست","زد بر آن حیوان که تا افتاد پست","خواجه تیر را از کمان رها کرد و به آن حیوان (گرگ) زد، به طوری که حیوان به زمین افتاد و زمین‌گیر شد."],[304,"اندر افتادن ز حیوان باد جست","روستایی های کرد و کوفت دست","خواجه به محض اینکه حیوان به زمین افتاد، به روستاییان رسید و دست به کار شد."],[304,"ناجوامردا که خرکره منست","گفت نه این گرگ چون آهرمنست","ناجوانمردان، فقط به خاطر انسان بودن من، نمی‌خواهند باور کنند که این گرگ (یا موجود خطرناک) چقدر شبیه اهریمن است."],[304,"اندرو اشکال گرگی ظاهرست","شکل او از گرگی او مخبرست","ظاهر او شبیه به گرگ است، اما حقیقت او به گرگ بودنش خبر می‌دهد و نشان می‌دهد که در واقع چه موجودی است."],[304,"گفت نه بادی که جست از فرج وی","می‌شناسم همچنانک آبی ز می","او می‌گوید که من نه از بدنی که از شکاف و دریچه آن می‌وزد، بلکه شخصیت او را می‌شناسم؛ مانند آبی که همواره از بسیاری جاها قابل شناسایی است."],[304,"کشته‌ای خرکره‌ام را در ریاض","که مبادت بسط هرگز ز انقباض","من با عشق و علاقه‌ای که به تو دارم، مانند گیاهان در باغ و طبیعت احساس سرزندگی می‌کنم، پس تو نباید اجازه دهی که این حس عشق و شادابی از بین برود و به هیچ‌وجه نباید از آن کاسته شود."],[304,"گفت نیکوتر تفحص کن شبست","شخصها در شب ز ناظر محجبست","گفت: بهتر است که در شب خوب دقت کنی و افراد را شناسایی کنی، چرا که در شب، شخصی که پوشیده و پنهان است، نمی‌تواند به خوبی دیده شود."],[304,"شب غلط بنماید و مبدل بسی","دید صایب شب ندارد هر کسی","شب باعث می‌شود که چیزها به نظر متفاوت و تغییر یافته بیایند، ولی کسی که توانایی دیدن واقعیات را دارد، می‌داند که شب تنها ظاهری از آنچه هست را نشان می‌دهد و در واقع همه نمی‌توانند این حقیقت را درک کنند."],[304,"هم شب و هم ابر و هم باران ژرف","این سه تاریکی غلط آرد شگرف","شب، ابر و باران عمیق، هر سه باعث تاریکی می‌شوند و این تاریکی‌ها به شدت ما را در اشتباه می‌اندازند."],[304,"گفت آن بر من چو روز روشنست","می‌شناسم باد خرکره منست","او می‌گوید که این مسئله برای من به روشنی روز است و می‌دانم که باد خرکره، خاستگاه من یا باد محلی من است."],[304,"در میان بیست باد آن باد را","می‌شناسم چون مسافر زاد را","میان بیست نوع باد، آن بادی را که به من آشناست می‌شناسم، مانند شناختن فرزند خود از دیگران."],[304,"خواجه بر جست و بیامد ناشکفت","روستایی را گریبانش گرفت","خواجه با شتاب به سمت روستایی ناشناخته رفت و به طور ناگهانی و بی‌مقدمه، به آنجا رسید."],[304,"کابله طرار شید آورده‌ای","بنگ و افیون هر دو با هم خورده‌ای","ای خواجه، تو لحظه‌ای جز زهر و شکر نمی‌بینی، گویی تحت تأثیر مواد مضر مانند بنگ (نوعی مخدر) و افیون (مواد مخدر) قرار گرفته‌ای."],[304,"در سه تاریکی شناسی باد خر","چون ندانی مر مرا ای خیره‌سر","در تاریکی‌های مختلفی مثل باد و احساسات، اگر من را نشناسی، ای آدم نادان و گیج، چه فایده‌ای دارد؟"],[304,"آنک داند نیمشب گوساله را","چون نداند همره ده‌ساله را","کسی که در نیمه شب، گوساله را می‌شناسد، چگونه می‌تواند همراه ده‌ساله‌اش را نشناسد؟ این جمله تأکید می‌کند که شناخت و آگاهی از یک موجود، به خودی خود شناخت موجودات دیگر را نیز به همراه دارد."],[304,"خویشتن را عارف و واله کنی","خاک در چشم مروت می‌زنی","اگر خود را عارف و عاشق معرفی کنی، در واقع با خاک کردن خودت در چشم دیگران، نوعی بی‌احترامی به مروت و انسانیت انجام می‌دهی."],[304,"که مرا از خویش هم آگاه نیست","در دلم گنجای جز الله نیست","من از خودم هم خبر ندارم و هیچ فکری جز خداوند در قلبم جایی ندارد."],[304,"آنچ دی خوردم از آنم یاد نیست","این دل از غیر تحیر شاد نیست","آنچه را که از معارف و تجربیات روحانی در گذشته کسب کرده‌ام، فراموش کرده‌ام. این دل من به خاطر غفلت از غیر خدا و گرفتار شدن در حیرت شادی ندارد."],[304,"عاقل و مجنون حقم یاد آر","در چنین بی‌خویشیم معذور دار","در اینجا به عاقل و مجنون (دو نوع انسان) اشاره می‌شود و می‌گوید، هر دوی آن‌ها را به یاد آورید؛ زیرا در حالتی از بی‌خود بودن و گم شدن در سرگردانی به سر می‌بریم، پس ما را معذور بدانید."],[304,"آنک مرداری خورد یعنی نبید","شرع او را سوی معذوران کشید","کسی که شراب (نبید) می‌خورد، مانند مرده است و به همین دلیل، از نظر شرع، او به دسته معذوران تعلق می‌گیرد و معاف است."],[304,"مست و بنگی را طلاق و بیع نیست","همچو طفلست او معاف و معتقیست","مست و کسی که بنگ (نوعی ماده مخدر) کشیده، از ازدواج و معامله معاف است و مانند کودکانی پاک و بی‌گناه است که از هرگونه قید و شرط آزاد هستند."],[304,"مستیی کاید ز بوی شاه فرد","صد خم می در سر و مغز آن نکرد","مستی که از بوی شاه فرد (شمس) به آدمی دست می‌دهد، باعث نمی‌شود که او از خم‌ها (مقدار نوشیدنی) و تأثیر آن‌ها در سر و مغزش غافل شود. در واقع، این مستی باعث می‌شود که او به دیوانگی و غفلت برود و تأثیر شراب را نادیده بگیرد."],[304,"پس برو تکلیف چون باشد روا","اسب ساقط گشت و شد بی دست و پا","حال که تکلیف برطرف شده و کارها مشخص است، وضع به گونه‌ای است که اسب افتاده و بی‌دست و پا شده است."],[304,"بار کی نهد در جهان خرکره را","درس کی دهد پارسی بومره را","کیست که در این دنیا بار سنگین را بر دوش کشد و درسی به خرکره، نماینده یک مکان بی‌کیفیت و ناپسند، دهد؟"],[304,"بار بر گیرند چون آمد عرج","گفت حق لیس علی الاعمی حرج","چون عرج (مرد معلول) به شهر آمد، بار سنگین را بر دوش می‌گیرد و می‌گوید از طرف خداوند، بر نابینا (معلول) گناهی نیست."],[304,"سوی خود اعمی شدم از حق بصیر","پس معافم از قلیل و از کثیر","به خاطر توجه به حقیقت و معنویت، از دیدگاه الهی نادانی و نابینایی من نادیده گرفته می‌شود و من از کم و زیاد در این مسیر معاف هستم."],[304,"لاف درویشی زنی و بی‌خودی","های هوی مستیان ایزدی","درویشی و بی‌خودی را به نمایش می‌گذارند تا از طریق مستی و ایزدی، خود را بزرگتر از آنچه هستند نشان دهند."],[304,"که زمین را من ندانم ز آسمان","امتحانت کرد غیرت امتحان","زمین و آسمان را از هم تشخیص نمی‌دهم، چون تو با آزمون‌های خود، غیرتم را آزمایش کرده‌ای."],[304,"باد خرکره چنین رسوات کرد","هستی نفی تو را اثبات کرد","باد خرکره، راز رسوایی و حقایق نهفته را به عیان آورد و وجود تو را در تضاد با حقیقت ثابت کرد."],[304,"این چنین رسوا کند حق شید را","این چنین گیرد رمیده‌صید را","این‌گونه حق، شید (سوارکار) را رسوا می‌کند و این‌گونه، صید رمیده را به دام می‌اندازد."],[304,"صد هزاران امتحانست ای پسر","هر که گوید من شدم سرهنگ در","ای پسر، هزاران آزمون و آزمایش وجود دارد. هر کس بگوید که من به مقام سرهنگی رسیده‌ام، باید از این آزمون‌ها عبور کند."],[304,"گر نداند عامه او را ز امتحان","پختگان راه جویندش نشان","اگر مردم عامی او را نشناسند، آزمودگان و آزمون دیده‌ها در پی یافتن نشانه‌ای از او هستند."],[304,"چون کند دعوی خیاطی خسی","افکند در پیش او شه اطلسی","چون کسی ادعای خیاطی کند، در برابر او چیزی می‌افکند که نشان‌دهنده بی‌کفایتی و بی‌تجربگی‌اش باشد."],[304,"که ببر این را بغلطاق فراخ","ز امتحان پیدا شود او را دو شاخ","چون کسی در موقعیت سخت و امتحان قرار می‌گیرد، واقعیت‌های نهفته او نمایان می‌شود، و در اینجا اشاره به این است که در چنین شرایطی، ویژگی‌های واقعی افراد، مانند نیک و بد آنان، آشکار می‌شود."],[304,"گر نبودی امتحان هر بدی","هر مخنث در وغا رستم بدی","اگر امتحانی در کار نبود، هر بدی و هر مرد زن‌نما (مخنث) هم در میدان جنگ مانند رستم (قهرمان اسطوره‌ای) شناخته می‌شد."],[304,"خود مخنث را زره پوشیده گیر","چون ببیند زخم گردد چون اسیر","مخنث (کسی که نه مرد کامل است و نه زن) باید خود را به زره (پوشش جنگی) بپوشاند، زیرا وقتی که او زخم و آسیب ببیند، مثل یک اسیر می‌شود و می‌فهمد که در معرض خطر است."],[304,"مست حق هشیار چون شد از دبور","مست حق ناید به خود تا نفخ صور","مستی که از عشق و حقیقت ناشی می‌شود، زمانی که شخص به باشد، هوشیار شده و از سر خودی و خودخواهی خارج می‌شود. در این حالت، فرد نمی‌تواند به خود برگردد، حتی تا زمانی که نفخ صور (دمیدن در شیپور قیامت) به وقوع بپیوندد."],[304,"باده حق راست باشد بی دروغ","دوغ خوردی دوغ خوردی دوغ دوغ","باده حق (مست‌کننده‌ای که حقیقت را آشکار می‌کند) کاملا واقعی و بدون دروغ است؛ کسانی که از آن بهره‌مند شوند، به معنای واقعی درک می‌کنند، ولی اگر دروغ و فریب را بپذیرند، مانند دوغ (مایع رقیق و بی‌ارزش) خواهند بود."],[304,"ساختی خود را جنید و بایزید","رو که نشناسم تبر را از کلید","اگر خود را مانند جنید و بایزید زاهد و عارف نشان بدهی، من نمی‌توانم تو را از کارهای زشت و ناپسند، که به آن‌ها مانند تبر و کلید توجه می‌شود، تشخیص دهم."],[304,"بدرگی و منبلی و حرص و آز","چون کنی پنهان بشید ای مکرساز","اگر نیت بد و حرص و آز داری، این رفتار را پنهان کن ای حیله‌گر."],[304,"خویش را منصور حلاجی کنی","آتشی در پنبه یاران زنی","اگر خود را مانند منصور حلاج، که نمونه‌ای از شجاعت و صداقت در بیان حق بود، رفتار کنی، باعث می‌شوی که میان دوستانت مشکلاتی ایجاد شود و در واقع، به آنان ضرر بزنی."],[304,"که بنشناسم عمر از بولهب","باد کره خود شناسم نیمشب","عمر، یعنی عمر بن خطاب، به من می‌گوید که من در نیمه شب خود را می‌شناسم، نه به خاطر تولد و یا بوسه‌ی باد از بلخی، بلکه بر اساس اعتبار وجود خودم."],[304,"ای خری کین از تو خر باور کند","خویش را بهر تو کور و کر کند","ای تو ای خری که به خاطر تو، دیگران به تو اعتماد می‌کنند و از خودشون غافل می‌شوند و به بی‌خبری و نادانی می‌رسند."],[304,"خویش را از ره‌روان کمتر شمر","تو حریف ره‌ریانی گه مخور","خودت را کمتر از ره‌روان (مسیرشناسان) به حساب نیاور و فکر نکن که در مقایسه با آن‌ها اهمیت کمتری داری، چون تو رقیب ره‌رویی هستی که در مسیرش چیزی به نام گوه (نکته و معنای عمیق) ندارد."],[304,"بازپر از شید سوی عقل تاز","کی پرد بر آسمان پر مجاز","به خودت برگرد و از عشق زودگذر و کاذب دور شو، چون عقل درست و تازه‌ای داری. بر دستاوردهای واقعی و باارزش تمرکز کن و از خیالات بی‌اساس فرار کن."],[304,"خویشتن را عاشق حق ساختی","عشق با دیو سیاهی باختی","تو خود را عاشق خدا کرده‌ای، اما در این مسیر با دیوی که نماد تاریکی و گمراهی است، شکست خورده‌ای."],[304,"عاشق و معشوق را در رستخیز","دو بدو بندند و پیش آرند تیز","در قیامت، عاشق و معشوق را به سرعت و به طور نزدیک به هم می‌آورند تا مورد محاکمه قرار گیرند."],[304,"تو چه خود را گیج و بی‌خود کرده‌ای","خون رز کو خون ما را خورده‌ای","تو چرا خودت را گیج و گیج کرده‌ای؟ آیا نمی‌دانی که خون گل سرخ، خون ما را خورده است؟"],[304,"رو که نشناسم تو را از من بجه","عارف بی‌خویشم و بهلول ده","من تو را نمی‌شناسم، پس از من دور شو. من عارف بی‌خود هستم و بهلول (شخصیت دیوانه‌ای که به خرد و حکمت معروف است) را به یاد می‌آورم."],[304,"تو توهم می‌کنی از قرب حق","که طبق‌گر دور نبود از طبق","تو خیال می‌کنی که نزدیکی به خداوند به معنای دور بودن از دنیا و مسائل دنیوی است، در حالی که این‌گونه نیست و حقیقت‌اش جدا از این تصورات است."],[304,"این نمی‌بینی که قرب اولیا","صد کرامت دارد و کار و کیا","تو نمی‌بینی که نزدیکی و نزدیکی اولیای خدا (مؤمنان خاص) ویژگی‌ها و معجزات زیادی دارد و به آنها کارهای خارق‌العاده‌ای داده شده است."],[304,"آهن از داوود مومی می‌شود","موم در دستت چو آهن می‌بود","داوود، پیامبر الهی، توانایی تبدیل آهن به موم را داشت. بنابراین، اگر موم در دستان تو به مانند آهن است، به معنای این است که نیروی واقعی و قدرت تغییر در تو نهفته است و می‌توانی به راحتی آن را شکل دهی."],[304,"قرب خلق و رزق بر جمله‌ست عام","قرب وحی عشق دارند این کرام","نزدیکی به خداوند و برکت و روزی برای تمامی مخلوقات وجود دارد، اما نزدیکی خاصی که به واسطه عشق و وحی به این بندگان خاص داده شده، بسیار ارزشمندتر است."],[304,"قرب بر انواع باشد ای پدر","می‌زند خورشید بر کهسار و زر","ای پدر، قرب الهی به انواع مختلف وجود دارد؛ همان‌طور که خورشید بر قله‌های کوه و بر طلا تابش می‌کند و آن‌ها را روشن می‌سازد."],[304,"لیک قربی هست با زر شید را","که از آن آگه نباشد بید را","اما نزدیکی و قرابت دیگری وجود دارد که به نور خورشید می‌رسد و از آن، بید (درختی که با نور خورشید شناخته می‌شود) بی‌خبر است."],[304,"شاخ خشک و تر قریب آفتاب","آفتاب از هر دو کی دارد حجاب","شاخ‌های خشک و تر در نزدیکی آفتاب، هر دو به نوعی از نور آفتاب می‌رسند، اما آفتاب از هر دوی آنها پرده‌پوشی دارد. این به این معناست که ظاهرا هر دو به هدف نزدیکند، اما هنوز از حقیقت دور مانده‌اند."],[304,"لیک کو آن قربت شاخ طری","که ثمار پخته از وی می‌خوری","اما کجاست آن نزدیکی به آفتاب که می‌توانی میوه‌های رسیده و خوشمزه را از آن بچینی؟"],[304,"شاخ خشک از قربت آن آفتاب","غیر زوتر خشک گشتن گو بیاب","چرا شاخ خشک نزدیکی آن آفتاب (خدا) به این زودی خشک می‌شود؟ برای اینکه در آن نزدیکی، به خاطر دوری از حقیقت، هیچ باروری وجود ندارد."],[304,"آنچنان مستی مباش ای بی‌خرد","که به عقل آید پشیمانی خورد","ای بی‌خرد، این‌قدر در مستی غرق نشو که بعدا پشیمانی وندانی که چقدر عقل و هوش ضروری است."],[304,"بلک از آن مستان که چون می می‌خورند","عقلهای پخته حسرت می‌برند","مستانی وجود دارند که وقتی شراب می‌نوشند، عقل‌های سنجیده و پخته از حال و روز آنها افسوس می‌خورند و حسرت می‌خورند که چرا به چنین حالتی افتاده‌اند."],[304,"ای گرفته همچو گربه موش پیر","گر از آن می شیرگیری شیر گیر","ای کسی که مانند گربه در کمین موش پیر نشسته‌ای، اگر می‌خواهی از شراب معنوی بهره‌مند شوی، باید همچون شیر از آن شیرینی بگیری."],[304,"ای بخورده از خیالی جام هیچ","همچو مستان حقایق بر مپیچ","ای کسی که از خیالات و توهمات جامی نوشیده‌ای، مانند مست‌ها در حقایق و واقعیت‌ها نچرخ و به دور خود نگرد."],[304,"می‌فتی این سو و آن سو مست‌وار","ای تو این سو نیستت زان سو گذار","تو مانند یک مست در این سو و آن سو می‌افتی و سرگردانی، اما این سو که تو هستی، در واقع از آن سو نیز فراتر است و هیچ حس و حال قابل درک برای تو ندارد."],[304,"گر بدان سو راه یابی بعد از آن","گه بدین سو گه بدان سو سر فشان","اگر به آن سو راه پیدا کنی، بعد از آن در آن سو و این سو سرها را به نشانه خوشحالی تکان می‌دهی."],[304,"جمله این سویی از آن سو گپ مزن","چون نداری مرگ هرزه جان مکن","تمام کسانی که در دنیا هستند، از آن سوی آن دنیا صحبت نکنید، زیرا وقتی که مرگ را نمی‌شناسید و نمی‌ترسید، نباید بیهوده حرف بزنید."],[304,"آن خضرجان کز اجل نهراسد او","شاید ار مخلوق را نشناسد او","آن کسی که از مرگ نمی‌ترسد، ممکن است مخلوق را نشناسد یا درک نکند."],[304,"کام از ذوق توهم خوش کنی","در دمی در خیک خود پرش کنی","اگر از لذت خیال خوشحال شوی و در یک لحظه خود را پر کنی، مانند خیکی که از آب پر می‌شود، به راحتی می‌توانی این خوشی را تجربه کنی."],[304,"پس به یک سوزن تهی گردی ز باد","این چنین فربه تن عاقل مباد","اگر به یک سوزن خالی و بی‌فایده تبدیل شوی، مانند باد، به هیچ‌وجه نباید بدنی چاق و سالم داشته باشی. در واقع، باید از این روزمرگی و بی‌محتوایی دوری کنی."],[304,"کوزه‌ها سازی ز برف اندر شتا","کی کند چون آب بیند آن وفا","کوزه‌ها در زمستان از برف می‌سازند و وقتی آب را می‌بینند، وفایی در آن نیست؛ یعنی در شرایط سخت و سرد، افراد باید مراقب باشند که فریب نخورند."],[305,"آن شغالی رفت اندر خمّ رنگ","اندر آن خم کرد یک ساعت درنگ","شغالی به داخل خم رنگ رفت و یک ساعت در آنجا ماند."],[305,"پس بر آمد پوستش رنگین شده","که منم طاووس علیین شده","سپس پوستش رنگی و زیبا شد و او ادعا کرد که من طاووس آسمانی (علیین) هستم."],[305,"پشم رنگین رونق خوش یافته","آفتاب آن رنگ‌ها بر تافته","رنگین شدن پوست شغال به لطف آفتاب باعث شده که او جلوه‌ای زیبا و جذاب پیدا کند."],[305,"دید خود را سبز و سرخ و فور و زرد","خویشتن را بر شغالان عرضه کرد","شغال خود را با رنگ‌های سبز، سرخ، زرد و رنگ‌های دیگر نشان داد و به شغال‌ها گفت که این‌ها جمال و زیبایی اوست."],[305,"جمله گفتند ای شغالک حال چیست؟","که تو را در سر نشاطی ملتویست","شغال‌ها از شغالک می‌پرسند حال تو چطور است که به نظر می‌رسد در سر تو نشاط و شادی خاصی وجود دارد."],[305,"از نشاط از ما کرانه کرده‌ای","این تکبر از کجا آورده‌ای؟","تو از شادی و نشاط ما فاصله گرفته‌ و این تکبر و بزرگ‌منشی را از کجا به دست آورده‌ای؟"],[305,"یک شغالی پیش او شد کای فلان","شید کردی یا شدی از خوش‌دلان؟","یک شغال به مولانا می‌گوید: ای فلان، آیا تو از خوش‌دل‌ها هستی یا فقط به خاطر شادت کافی برای حرف زدن به اینجا آمدی؟"],[305,"شید کردی تا به منبر برجهی","تا ز لاف این خلق را حسرت دهی","تو با نوشیدن شید (ماده‌ای مست‌کننده) می‌خواهی به بالای منبر بروی و دیگران را با ادعای خود به حسرت بیندازی."],[305,"بس بکوشیدی ندیدی گرمیی","پس ز شید آورده‌ای بی‌شرمیی","تو بسیار تلاش کردی و نتیجه‌ای از این تلاش ندیدى، در عوض از شید (شراب) به این بی‌شرمی و بی‌خجالتی رسیده‌ای."],[305,"گرمی، آن اولیا و انبیاست","باز بی‌شرمی پناه هر دغاست","افرادی که به مقام‌های عالی و نخبه مثل اولیا و پیامبران رسیده‌اند، به نورانی و گرمی درونی (روحانی) خود معروف هستند، اما کسانی که عیوب و نواقص درونی دارند، به طرز ناشایستی به این مقام‌ها ادعا می‌کنند و خود را در جایگاه‌های بالاتر قرار می‌دهند."],[305,"که التفات خلق سوی خود کشند","که خوشیم و از درون بس ناخوشند","مردم به ما توجه می‌کنند و فکر می‌کنند که ما خوب و خوشحال هستیم، در حالی که درون خود از مشکلات و ناخرسندی رنج می‌بریم."],[306,"پوست دنبه یافت شخصی مستهان","هر صباحی چرب کردی سبلتان","شخصی که به او توهین شده، هر صبح پوست دنبه (چربی گوسفند) را به لب‌ها و سبیل‌هایش می‌مالد تا آنها را چرب و زیبا کند."],[306,"در میان منعمان رفتی که من","لوت چربی خورده‌ام در انجمن","تو در میان افراد ثروتمند و مرفه می‌روی و خود را به گونه‌ای معرفی می‌کنی که گویی از چربی و نعمت برخوردار هستی و در واقع به خود می‌بالایی."],[306,"دست بر سبلت نهادی در نوید","رمز، یعنی سوی سبلت بنگرید","با دست‌تان بر سبیل (سبلت)، که نشانه خوشی و بهزادی است، اشاره کردید و به دیگران خبر می‌دهید که به این نشان (سبیل) توجه کنند، یعنی این علامت نمایانگر چیزی است که شما می‌خواهید بیان کنید."],[306,"کین گواه صدق گفتار منست","وین نشان چرب و شیرین خوردنست","این بیت بیانگر این است که چیزهایی که من در گفتارم و ادعاهایم به زبان می‌آورم، به عنوان نشانه‌های صدق و حقیقت‌اند، و چرب و شیرین بودن سبلت (سبیل) من نیز به نوعی نشان‌دهنده لذت‌ها و خوشی‌هایی است که تجربه کرده‌ام."],[306,"اشکمش گفتی جواب بی‌طنین","که اباد الله کید الکاذبین","اشکمش، یعنی آن کسی که به او اشاره شده، با این سخن تو به او جواب نداد که خداوند نقشه دروغگویان را خنثی می‌کند."],[306,"لاف تو ما را بر آتش بر نهاد","کان سبال چرب تو بر کنده باد","ادعای تو برای ما مثل آتش است که ما را می‌سوزاند، زیرا چربی لب‌هایت مانند بویی است که از کنده‌های درخت برمی‌خیزد."],[306,"گر نبودی لاف زشتت ای گدا","یک کریمی رحم افکندی به ما","اگر تو این طور به خودت لاف نمی‌زدی و خود را زشت نمی‌کردی، ای تهیدست، شاید یک کرمی (خدا) رحم می‌کرد و به ما کمک می‌کرد."],[306,"ور نمودی عیب و کژ کم باختی","یک طبیبی داروی او ساختی","اگر عیب و نقص خود را نشان می‌دادی و کم از خودت می‌کردی، یک طبیب دارویی برای تو می‌ساخت."],[306,"گفت حق که کژ مجنبان گوش و دم","ینفعن الصادقین صدقهم","خداوند می‌گوید که کسی که در سخن یا کردار خود دروغگو است، نه گوشش و نه دمش (که مثلا به معنای شخصیت یا حضور اوست) از صدق و راستگویی افراد راستگو بهره‌مند نخواهد شد."],[306,"گفت اندر کژ مخسپ ای محتلم","آنچ داری وا نما و فاستقم","ای محتلم (کسی که احساس جنسی دارد) در دقت و احتیاط، نیازی به پنهان‌کاری نیست. آنچه را که داری، نشان بده و خودت را درست و صادقانه بپذیر."],[306,"ور نگویی عیب خود باری خمش","از نمایش وز دغل خود را مکش","اگر عیب خود را نگویی، پس از نمایش و به نمایش گذاشتن خود دست بردار و حقه‌بازی خود را کنار بگذار."],[306,"گر تو نقدی یافتی مگشا دهان","هست در ره سنگهای امتحان","اگر به عیبی از خود پی بردی، آن را فاش نکن و زبانت را نباز زیرا در گام‌های آزمایش، باید خود را مورد سنجش قرار دهی و نگویی من دچار این نقص هستم."],[306,"سنگهای امتحان را نیز پیش","امتحانها هست در احوال خویش","آدمی در زندگی خود همیشه با چالش‌ها و آزمایش‌هایی روبرو می‌شود که باید خویشتن را در برابر آنها بسنجند. در واقع، باید به وضعیت و درون خود نگاهی بیندازد تا از شرایط مختلف آزمون بگیرد."],[306,"گفت یزدان از ولادت تا بحین","یفتنون کل عام مرتین","خداوند فرموده است که از زمان تولد انسان تا کنون، همواره انسان‌ها در هر سال دو بار امتحان می‌شوند."],[306,"امتحان در امتحانست ای پدر","هین به کمتر امتحان خود را مخر","ای پدر، توجه کن که امتحان در امتحان تداوم دارد، بنابراین خودت را در هر امتحان کوچک، کم‌اهمیت مکن و از آن نترس."],[307,"بلعم باعور و ابلیس لعین","ز امتحان آخرین گشته مهین","بلعم باعور و ابلیس لعین از آخرین آزمایش‌ها کوچک و حقیر شده‌اند."],[307,"او بدعوی میل دولت می‌کند","معده‌اش نفرین سبلت می‌کند","بلعم باعور به خاطر تمایل به قدرت و مقام، به دروغ ادعا می‌کند که به او متمایل است، اما در باطن، چیزی جز نفرین و بدی از او بیرون نمی‌آید."],[307,"کانچ پنهان می‌کند پیداش کن","سوخت ما را ای خدا رسواش کن","هر چیزی را که بلعم باعور پنهان می‌کند، آشکار کن؛ پروردگار، ما را به خاطر او بسوزان، و او را رسوا کن."],[307,"جمله اجزای تنش خصم ویند","کز بهاری لافد ایشان در دیند","تمام اجزای بدن بلعم باعور، دشمن او هستند، زیرا او در بهار (زندگی پرنشاط و خوشبختی) به دروغ از دین و ایمانش سخن می‌گوید."],[307,"لاف وا داد کرمها می‌کند","شاخ رحمت را ز بن بر می‌کند","زبان به تملق و دروغ می‌چرخد و در نتیجه، درخت رحمت را از ریشه تکان می‌دهد و باعث می‌شود که نعمت‌ها بخشیده شوند."],[307,"راستی پیش آر یا خاموش کن","وانگهان رحمت ببین و نوش کن","اگر حقیقت را به میدان بیاوری یا ساکت بمانی، به ناگاه رحمت را مشاهده می‌کنی و از آن بهره‌مند خواهی شد."],[307,"آن شکم خصم سبال او شده","دست پنهان در دعا اندر زده","دشمن او که شکمی بزرگ دارد، از پنهان در دعاها دست به دعا زده و به امید بهره‌مندی از رحمت الهی است."],[307,"کای خدا رسوا کن این لاف لئام","تا بجنبد سوی ما رحم کرام","ای خدا، این دروغ‌های حقیر را رسوا کن تا رحمت‌های بزرگ تو به سوی ما بیاید."],[307,"مستجاب آمد دعای آن شکم","شورش حاجت بزد بیرون علم","دعای کسی که دلش از نیاز و خواسته‌های شدید پر شده، به سرعت مستجاب می‌شود و در نتیجه، علم و دانش او از این وضع ناپسند بیرون می‌آید."],[307,"گفت حق گر فاسقی و اهل صنم","چون مرا خوانی اجابتها کنم","خداوند می‌فرماید: اگر تو فاسق و اهل معصیت هم باشی، زمانی که من را بخوانی، به دعایت پاسخ می‌دهم."],[307,"تو دعا را سخت گیر و می‌شخول","عاقبت برهاندت از دست غول","اگر تو در دعا و درخواست از خدا واقعا جدی و مداوم باشی، در نهایت نجات پیدا می‌کنی و از چنگال خطرات یا مشکلات بزرگ رهایی می‌یابی."],[307,"چون شکم خود را به حضرت در سپرد","گربه آمد پوست آن دنبه برد","وقتی که بلعم باعور خود را به خداوند سپرد و دعا کرد، گربه (که نماد خطر یا وسوسه است) آمد و پوست دنبه (چربی یا دانی که به آن اهمیت داده می‌شود) را برداشت. این نشان‌دهنده خطراتی است که پس از سپردن خود به خدا ممکن است به سراغ انسان بیاید."],[307,"از پس گربه دویدند او گریخت","کودک از ترس عتابش رنگ ریخت","کودکان از پشت سر به گربه حمله کردند و او فرار کرد. بچه‌ها به خاطر ترس از سرزنش، رنگ‌شان پرید و متوجه وحشت خود شدند."],[307,"آمد اندر انجمن آن طفل خرد","آب روی مرد لافی را ببرد","آن کودک خرد به جمع آمد و آب روی مردی که دروغ می‌گفت را برملا کرد و خالی کرد."],[307,"گفت آن دنبه که هر صبحی بدان","چرب می‌کردی لبان و سبلتان","دنبه (چربی گوسفند) به تو می‌گوید که هر روزی که با آن لب‌ها و ریش‌هایت را چرب می‌کردی، در واقع خود را زیباتر می‌کردی."],[307,"گربه آمد ناگهانش در ربود","بس دویدیم و نکرد آن جهد سود","ناگهان گربه به ما حمله‌ور شد و ما از ترس دویدیم، اما هیچ تلاشی نکردیم که از خود دفاع کنیم یا به چیزی واکنش نشان دهیم."],[307,"خنده آمد حاضران را از شگفت","رحمهاشان باز جنبیدن گرفت","حاضران از تعجب و شگفتی به خنده افتادند و رحم‌هایشان (احساسات عاطفی و محبتشان) به آنها اجازه نداد که آرام بگیرند و بی‌حرکت بمانند."],[307,"دعوتش کردند و سیرش داشتند","تخم رحمت در زمینش کاشتند","او را دعوت کردند و به نوعی با او خوشرفتاری کردند تا به او محبت کنند و در وجودش بذر رحمت و مهربانی را بکارند."],[307,"او چو ذوق راستی دید از کرام","بی تکبر راستی را شد غلام","بلعم باعور وقتی طعم حقیقت را چشید و کرامت‌ها را مشاهده کرد، بدون خودبرتربینی به حقیقت و راستی خدمت کرد و به آن اقرار نمود."],[308,"و آن شغال رنگ‌رنگ آمد نهفت","بر بناگوش ملامت‌گر بگفت","شغال رنگارنگی که به خاطر سرزنش‌ها پنهان شده بود، به نزد ملامت‌گر آمد و گفت."],[308,"بنگر آخر در من و در رنگ من","یک صنم چون من ندارد خود شمن","به خودت نگاه کن و رنگ و طعم من را ببین؛ هیچ مظهری مانند من وجود ندارد."],[308,"چون گلستان گشته‌ام صد رنگ و خوش","مر مرا سجده کن از من سر مکش","من به زیبایی‌ها و رنگ‌های مختلفی شبیه گلستان تبدیل شده‌ام، پس برای تو که سجده می‌کنی، تا زمانی که من را نمی‌کشی، مرا محترم بدار."],[308,"کر و فر و آب و تاب و رنگ بین","فخر دنیا خوان مرا و رکن دین","ای کسانی که به ظواهر فریبنده و زرق و برق‌های دنیوی نگاه می‌کنید، اینها را فخر دنیا بدانید، در حالی که من به ویژگی‌های معنوی و دین خود تکیه دارم."],[308,"مظهر لطف خدایی گشته‌ام","لوح شرح کبریایی گشته‌ام","من به مظهر لطف و رحمت خدا تبدیل شده‌ام و حالا به عنوان یک صفحه‌ای از عظمت و بزرگی او شناخته می‌شوم."],[308,"ای شغالان هین مخوانیدم شغال","کی شغالی را بود چندین جمال","ای شغالان، چرا مرا صدا می‌زنید؟ آیا شغالی می‌تواند این همه زیبایی و جذابیت داشته باشد؟"],[308,"آن شغالان آمدند آنجا به جمع","همچو پروانه به گرداگرد شمع","شغالان به دور هم جمع شدند و مانند پروانه‌ها دور شمع می‌چرخیدند."],[308,"پس چه خوانیمت بگو ای جوهری","گفت طاوس نر چون مشتری","شغال به جواهری می‌گوید که تو را چه نامید و شناختی، زیرا طاوس نر با زیبایی‌اش و جلوه‌طرفدی در باغ مانند مشتری (ستاره) می‌درخشد."],[308,"پس بگفتندش که طاوسان جان","جلوه‌ها دارند اندر گلستان","به او گفتند که طاوس‌ها (پرنده‌های زیبا) در حقیقت جلوه‌هایی از زیبایی و جان دارند و در باغ‌ها (گلستان) نمایان می‌شوند."],[308,"تو چنان جلوه کنی گفتا که نی","بادیه نارفته چون کوبم منی","تو آن‌قدر زیبا و جلوه‌گر هستی که می‌گویی من یک طاوس هستم، در حالی که من هنوز به جایی نرفته‌ام و نمی‌توانم تو را آن‌طور که شایسته‌ات است ستایش کنم."],[308,"بانگ طاووسان کنی گفتا که لا","پس نه‌ای طاووس خواجه بوالعلا","شغال به طعنه می‌گوید که صدای طاووسان را بلند می‌کنی و البته تو طاووس نیستی، بلکه شغالی بیش نیستی و به همین دلیل باید از ادعای بزرگ و فریبنده‌ات دوری کنی."],[308,"خلعت طاووس آید ز آسمان","کی رسی از رنگ و دعویها بدان","لباس و زینت طاووس، از آسمان برای کسی می‌آید که لیاقت آن را دارد، نه اینکه کسی با تظاهر به زیبایی و ادعا به آن دست یابد."],[309,"همچو فرعونی مرصع کرده ریش","برتر از عیسی پریده از خریش","شخصی به مانند فرعون که چهره‌اش را با جواهرات زیبا تزئین کرده، اما در حقیقت مقامش کمتر و پایین‌تر از عیسی است، که از زشتی و حقارت خود به خیال بزرگی افتاده و خود را برتر از او می‌داند."],[309,"او هم از نسل شغال ماده زاد","در خم مالی و جاهی در فتاد","او هم از نسل شغالی به دنیا آمده و در چنگال ثروت و مقام گرفتار شده است."],[309,"هر که دید آن جاه و مالش سجده کرد","سجده افسوسیان را او بخورد","هر کسی که قدرت و ثروت او را دید، برایش احترام و تواضع کرد؛ در حقیقت، او از این احترام و سجده‌ها سوءاستفاده کرد."],[309,"گشت مستک آن گدای ژنده‌دلق","از سجود و از تحیرهای خلق","آن گدای فقیر و بدلباس که در اشتباه خود را بزرگ و مستکبر می‌داند، به خاطر سجده‌های مکرر مردم و حیرت آن‌ها به قدرت و مقامش، دچار غرور و خودبینی شده است."],[309,"مال مار آمد که در وی زهرهاست","و آن قبول و سجده خلق اژدهاست","مال فرعون (که در واقع ثروت و قدرت اوست) همچون ماری است که زهر دارد و سجده و پذیرش مردم از او همچون اژدهایی است که به او اعتنا می‌کنند."],[309,"های ای فرعون ناموسی مکن","تو شغالی هیچ طاووسی مکن","ای فرعون، به خودت مغرور نباش و بر خودت ادعای شرافت نکن، زیرا تو شغالی هستی و هیچ تشابهی با طاووس (که نماد زیبایی و فخر است) نداری."],[309,"سوی طاووسان اگر پیدا شوی","عاجزی از جلوه و رسوا شوی","اگر به سمت طاووس‌ها که نماد زیبایی و مقام هستند بروی، نشان دهنده ناتوانی و حقارت تو خواهد بود و در نتیجه رسوا می‌شوی."],[309,"موسی و هارون چو طاووسان بدند","پر جلوه بر سر و رویت زدند","موسی و هارون مانند طاووس‌ها هستند که به خاطر زیبایی و جلالشان، بر سر و روی تو سایه افکنده‌اند."],[309,"زشتیت پیدا شد و رسواییت","سرنگون افتادی از بالاییت","زشتی‌ها و ناپاکی‌هایت آشکار شد و به خاطر رسوایی‌ات از مقام والایت سقوط کردی."],[309,"چون محک دیدی سیه گشتی چو قلب","نقش شیری رفت و پیدا گشت کلب","وقتی که در آزمون و محک قرار گرفتی، به سیاهی افتادی و به مانند قلبی که نقش شیر را بر خود دارد، حقیقت وجودی تو به شکل یک سگ فاش شد."],[309,"ای سگ‌گرگین زشت از حرص و جوش","پوستین شیر را بر خود مپوش","ای سگی زشت و هار که به خاطر حرص و طمع، پوست شیر را به تن کرده‌ای، از این کار دست بردار."],[309,"غره شیرت بخواهد امتحان","نقش شیر و آنگه اخلاق سگان","غرور و خودبینی تو بر اثر ظاهرسازی و تظاهر به قدرت و بزرگی‌ات، باید در آزمون واقعی قرار بگیرد تا چهره‌ی حقیقی‌ات مشخص شود، زیرا در نهایت، جنبه‌های منفی و اخلاقی تو آشکار خواهد شد."],[310,"گفت یزدان مر نبی را در مساق","یک نشانی سهل‌تر ز اهل نفاق","خداوند به پیامبرش (محمد) می‌گوید که نشانه‌ای برای تشخیص منافقان آسان‌تر از سایر مردم نفاق وجود دارد."],[310,"گر منافق زفت باشد نغز و هول","وا شناسی مر ورا در لحن و قول","اگر منافق با نفاقش بسیار زیرک و فریبنده باشد، تو می‌توانی او را از طریق سخنانش و طرز گفتارش بشناسی."],[310,"چون سفالین کوزه‌ها را می‌خری","امتحانی می‌کنی ای مشتری","وقتی که مشتری کوزه‌های سفالی را می‌خرد، آنها را امتحان می‌کند تا از کیفیت و مرغوبیت آنها اطمینان حاصل کند."],[310,"می‌زنی دستی بر آن کوزه چرا","تا شناسی از طنین اشکسته را","چرا بر این کوزه دستی نمی‌زنی تا صدای شکسته‌اش را بشناسی؟"],[310,"بانگ اشکسته دگرگون می‌بود","بانگ چاووشست پیشش می‌رود","صدای شکسته و دگرگون دیگری در حال آمدن است، این صدا متعلق به چاووش، یعنی پیشاوران و اعلام‌کنندگان خبرها است."],[310,"بانگ می‌آید که تعریفش کند","همچو مصدر فعل تصریفش کند","صدایی می‌آید که باید آن صدا را توصیف کند، مانند فعل‌هایی که دچار تغییر و تصریف می‌شوند."],[310,"چون حدیث امتحان رویی نمود","یادم آمد قصه هاروت زود","وقتی که درباره‌ی امتحان و آزمایش سخن گفته شد، یاد قصه‌ی هاروت فورا به یادم آمد."],[311,"پیش ازین زان گفته بودیم اندکی","خود چه گوییم از هزارانش یکی","پیش از این درباره آن تحقیق‌ها اندکی صحبت کردیم، حال چه نیازی است که از هزاران موضوع دیگر یکی را باز هم بیان کنیم؟"],[311,"خواستم گفتن در آن تحقیقها","تا کنون وا ماند از تعویقها","خواستم درباره آن تحقیق‌ها و بررسی‌ها صحبت کنم، اما تاکنون از بیان آن‌ها باز مانده‌ام و به تأخیر افتاده‌ام."],[311,"حمله دیگر ز بسیارش قلیل","گفته آید شرح یک عضوی ز پیل","حمله دیگر یعنی بار دیگر، از میان بسیار چیزها، چیز کمی گفته می‌شود که توضیح یک از اعضای بدن فیل است. به این معنا که در اینجا به جای بیان تمام جزئیات و پیچیدگی‌ها، فقط قسمت کوچکی از یک موضوع بزرگ (همانند بدن فیل) توضیح داده می‌شود."],[311,"گوش کن هاروت را ماروت را","ای غلام و چاکران ما روت را","به هاروت و ماروت، دو فرشته، توجه کن، ای غلام و خدمت‌گزاران ما."],[311,"مست بودند از تماشای اله","وز عجایبهای استدراج شاه","هاروت و ماروت به خاطر تماشای عظمت الهی و شگفتی‌های امتحانات الهی، در حالت مستی بودند."],[311,"این چنین مستیست ز استدراج حق","تا چه مستیها کند معراج حق","این نوع مستی ناشی از آزمون‌های الهی است که از سوی حق به انسان داده می‌شود و این مستی‌ها به انسان کمک می‌کند تا به بالاترین مراحل روحی و معنوی برسد."],[311,"دانه دامش چنین مستی نمود","خوان انعامش چه‌ها داند گشود","دانه‌ای که در دام حق بود، این مستی و حالت عاشقانه را برای او به وجود آورد. نمی‌داند که خوان انعام حق چه چیزهایی را برای او آشکار خواهد کرد و چه نعمت‌هایی به او خواهد داد."],[311,"مست بودند و رهیده از کمند","های هوی عاشقانه می‌زدند","هاروت و ماروت در حالتی مست از زنجیرهای هوای نفس رهایی یافته بودند و در عشق به خداوند همچون عاشقانی شجاع و دلیر به حرکت و فعالیت سرگرم بودند."],[311,"یک کمین و امتحان در راه بود","صرصرش چون کاه که را می‌ربود","در مسیر آزمایش، یک کمین و امتحان وجود داشت که طوفانی چون طوفان سرد، کاه را از جا می‌کند."],[311,"امتحان می‌کردشان زیر و زبر","کی بود سرمست را زینها خبر","خداوند آنها را تحت آزمایش قرار می‌داد تا ببینند در شرایط دشوار، چه توانایی‌هایی دارند و آیا کسی که در ابتدا سرمست و شاداب است، از این امتحانات آگاه است یا نه."],[311,"خندق و میدان بپیش او یکیست","چاه و خندق پیش او خوش مسلکیست","در نظر او، تفاوتی میان خندق و میدان نیست و هر دو برای او یکسان محسوب می‌شوند. همچنین، چاه و خندق در نظر او، نشانه‌ای از استواری و ثبات هستند."],[311,"آن بز کوهی بر آن کوه بلند","بر دود از بهر خوردی بی‌گزند","بز کوهی که بر قله بلند کوه نشسته، برای تغذیه‌اش از دود و بخار سوختن (که خطرناک نیست) بهره‌مند می‌شود."],[311,"تا علف چیند ببیند ناگهان","بازیی دیگر ز حکم آسمان","بز کوهی برای چیدن علف ناگهان به یک بازی دیگری برخورد می‌کند که از اراده آسمان نشأت می‌گیرد."],[311,"بر کهی دیگر بر اندازد نظر","ماده بز بیند بر آن کوه دگر","چشم او بر کوهی دیگر می‌افتد و در آنجا بز ماده‌ای را می‌بیند که بر فراز آن کوه دیگر در حال چراست."],[311,"چشم او تاریک گردد در زمان","بر جهد سرمست زین که تا بدان","چشم او (هاروت و ماروت) در آن زمان که به سختی می‌کوشد و از شدت مستی به این کوه می‌نگرد، تاریک می‌شود و نمی‌تواند حقیقت را ببیند."],[311,"آنچنان نزدیک بنماید ورا","که دویدن گرد بالوعه سرا","به‌قدری نزدیک به او به‌نظر می‌رسد که مانند دویدن دور یک بلندی یا تپه است."],[311,"آن هزاران گز دو گز بنمایدش","تا ز مستی میل جستن آیدش","در این بیت، شاعر به وجود فاصله‌های بزرگ در زندگی اشاره می‌کند که به نظر می‌رسد کوچک و نزدیک هستند. انسان در حالت مستی و شیدایی، این فاصله‌های بزرگ را کوچک می‌بیند و تمایل به نزدیک شدن به آن‌ها پیدا می‌کند."],[311,"چونک بجهد در فتد اندر میان","در میان هر دو کوه بی امان","وقتی که (هاروت و ماروت) فرار کنند، در میانه (کوه‌ها) گرفتار می‌شوند و در بین دو کوه بدون ملاحظه و بی‌رحم خواهند بود."],[311,"او ز صیادان به که بگریخته","خود پناهش خون او را ریخته","او از صیادان (یا شکارچیان) فرار کرده و به کوه پناه برده است و در این حال، خونش در حال ریختن است."],[311,"شسته صیادان میان آن دو کوه","انتظار این قضای با شکوه","صیادان در میان دو کوه نشسته‌اند و منتظر وقوع این ماجرای بزرگ هستند."],[311,"باشد اغلب صید این بز همچنین","ورنه چالاکست و چست و خصم‌بین","اغلب شکار این بز (حریف) نیز می‌تواند باشد، وگرنه تو چالاک و سریع هستی و می‌توانی حضور دشمنان را شناسایی کنی."],[311,"رستم ارچه با سر و سبلت بود","دام پاگیرش یقین شهوت بود","هرچند رستم، قهرمان افسانه‌ای، دارای قدرت و جاذبه‌ای است، اما در نهایت، گرفتار رغبت و هوس‌ها می‌شود."],[311,"همچو من از مستی شهوت ببر","مستی شهوت ببین اندر شتر","مثل من از مستی شهوت فاصله بگیر و به حالت مستی شهوت در شتر نگاه کن."],[311,"باز این مستی شهوت در جهان","پیش مستی ملک دان مستهان","اینجا اشاره به این است که مستی شهوت در جهان، در مقایسه با مستی ملک (مردان بزرگ و مقام‌های معنوی) بی‌اهمیت است و نباید به آن بها داد."],[311,"مستی آن مستی این بشکند","او به شهوت التفاتی کی کند","مستی شهوت، آن مستی را می‌شکند و در این حالت، توجهی به او نمی‌کند."],[311,"آب شیرین تا نخوردی آب شور","خوش بود خوش چون درون دیده نور","آب شیرین تا زمانی که نچشیده‌ای، خوب به نظر می‌آید، اما وقتی که به آب شور (مشکلات و چالش‌ها) برخوردی، متوجه می‌شوی که چه چیزهایی ارزش واقعی دارند، مانند نور درون چشم که بعد از تجربه درک می‌شود."],[311,"قطره‌ای از باده‌های آسمان","بر کند جان را ز می وز ساقیان","قطره ای از شراب آسمانی جان انسان را از تمام می ها وساقی های این دنیا جدا میکند"],[311,"تا چه مستیها بود املاک را","وز جلالت روحهای پاک را","به چه مقدار مستی و شادمانی، ملک‌های افلاکی و روح‌های پاک را تحت تأثیر قرار می‌دهد."],[311,"که به بوی دل در آن می بسته‌اند","خم باده این جهان بشکسته‌اند","در این بیت اشاره شده که کسانی که با دل و احساسات پاک خود در این دنیا زندگی می‌کنند (به بوی دل) به خوشی و لذت‌جویی می‌پردازند. خم باده این جهان به معنای لذت‌های دنیوی است که به دست آمدن آنها نیاز به شکستن موانع و گذر از سختی‌ها دارد."],[311,"جز مگر آنها که نومیدند و دور","همچو کفاری نهفته در قبور","فقط کسانی که ناامیدند و از خدا دور هستند، مانند انسان‌های کافر در قبری ساکت و پنهان باقی می‌مانند."],[311,"ناامید از هر دو عالم گشته‌اند","خارهای بی‌نهایت کشته‌اند","این افراد از هر دو جهان ناامید شده‌اند و به حدی به مشکلات و سختی‌ها گرفتار شده‌اند که مانند خارهایی بی‌نهایت در زندگی‌شان کشته شده‌اند و به شدت در رنج و مصیبت قرار دارند."],[311,"پس ز مستیها بگفتند ای دریغ","بر زمین باران بدادیمی چو میغ","از شدت مستی و بی‌خود شدن، گفتند افسوس که ما بر زمین باران رحمت نباریدیم، مانند ابرها."],[311,"گستریدیمی درین بی‌داد جا","عدل و انصاف و عبادات و وفا","در اینجا بیان می‌شود که در این جا (دنیا) که هیچ عدل و انصاف و عبادتی وجود ندارد و وفا هم دیده نمی‌شود، ما به فساد و بی‌عدالتی دامن زده‌ایم."],[311,"این بگفتند و قضا می‌گفت بیست","پیش پاتان دام ناپیدا بسیست","آنها این را گفتند و قضا (سرنوشت) می‌گفت که بیست پیش (یعنی بیست بار) قبل از این، در دام ناپیدا (شر و مکر) گرفتار هستید."],[311,"هین مدو گستاخ در دشت بلا","هین مران کورانه اندر کربلا","ای انسان، در دشت خطر (بلا) بی‌احتیاط و بی‌فکر قدم نگذار و به‌طور بی‌محابا در میدان جنگ (کربلا) نرو."],[311,"که ز موی و استخوان هالکان","می‌نیابد راه، پای سالکان","هزاران افرادی که به خاطر موی و استخوانشان (یعنی به خاطر ضعف و ناتوانی جسمی) هلاک شده‌اند، هیچ راهی برای سالکان (سیر و سلوک‌کنندگان) به دست نمی‌آورند و نمی‌توانند به مقصد برسند."],[311,"جمله راه استخوان و موی و پی","بس که تیغ قهر لاشی کرد شی","در این بیت، گفته می‌شود که تمام موجودات، چه از نظر جسمی (استخوان و موی و پی) و چه از نظر معنوی، تحت تأثیر قضای الهی و قهر خداوند قرار دارند و در معرض آزمایش و سختی‌ها هستند. این تیغ قهر می‌تواند زندگی و موجودات را به چالش بکشد."],[311,"گفت حق که بندگان جفت عون","بر زمین آهسته می‌رانند و هون","خداوند می‌گوید: بندگان من به آرامی و با هم بر روی زمین حرکت می‌کنند و در این حرکت به یکدیگر کمک می‌کنند."],[311,"پا برهنه چون رود در خارزار","جز به وقفه و فکرت و پرهیزگار","انسان باید مانند رود در خارزار، بدون کفش و با احتیاط و تفکر قدم بگذارد و از خطا دوری کند."],[311,"این قضا می‌گفت لیکن گوششان","بسته بود اندر حجاب جوششان","این تقدیر می‌گفت که چه باید کرد، اما آنها نمی‌شنیدند چون در پرده‌ای از احساسات و غرایز گرفتار بودند."],[311,"چشمها و گوشها را بسته‌اند","جز مر آنها را که از خود رسته‌اند","چشم‌ها و گوش‌ها به خاطر حجاب و دنیاپرستی بسته شده‌اند، مگر کسانی که از خودخواهی و وابستگی به دنیا آزاد شده‌اند."],[311,"جز عنایت که گشاید چشم را","جز محبت که نشاند خشم را","جز لطف و محبت الهی که می‌تواند درک و بینش انسان را باز کند و خشم و کین را از دلش دور کند، هیچ چیز نمی‌تواند به او کمک کند."],[311,"جهد بی توفیق خود کس را مباد","در جهان والله اعلم بالسداد","تلاش بدون کمک الهی برای کسی میسر نیست و در این دنیا تنها خداوند است که از صحت راه‌ها و اقدامات آگاه است."],[312,"جهد فرعونی چو بی توفیق بود","هرچه او می‌دوخت آن تفتیق بود","فرعون هر چقدر هم که تلاش می‌کرد، چون توفیق و موفقیت الهی را نداشت، همه کارهایی که انجام می‌داد، بی‌ثمر و بی‌فایده بود."],[312,"از منجم بود در حکمش هزار","وز معبر نیز و ساحر بی‌شمار","فرعون از نجوم‌شناسان بسیار و معبرها (تعبیرکنندگان خواب) و جادوگران زیادی برخوردار بود که در پیش‌بینی و تفسیر خواب‌ها تخصص داشتند."],[312,"مقدم موسی نمودندش بخواب","که کند فرعون و ملکش را خراب","در خواب، موسی را به فرعون معرفی کردند تا او را متوجه خراب کردن ملکش کنند."],[312,"با معبر گفت و با اهل نجوم","چون بود دفع خیال و خواب شوم","موسی علیه‌السلام با معبر (تعبیرگر خواب) و افراد نجومی مشورت کرد تا اینکه چطور می‌توانند خیال و خواب بد فرعون را دفع کنند."],[312,"جمله گفتندش که تدبیری کنیم","راه زادن را چو ره‌زن می‌زنیم","همه به فرعون گفتند که باید نقشه‌ای بکشیم و راه زادن او را مانند یک دزد مسدود کنیم."],[312,"تا رسید آن شب که مولد بود آن","رای این دیدند آن فرعونیان","در آن شب که زادگاه موسی بود، فرعونیان تصمیم به تدبیر و نقشه‌کشی گرفتند."],[312,"که برون آرند آن روز از پگاه","سوی میدان بزم و تخت پادشاه","در روزی که صبح زود آغاز می‌شود، فرعونیان تصمیم می‌گیرند که مردم اسرائیل را به میدان بزم و سلطنت ببرند."],[312,"الصلا ای جمله اسرائیلیان","شاه می‌خواند شما را زان مکان","ای بنی‌اسرائیل، شاه شما را از آن مکان فرا می‌خواند."],[312,"تا شما را رو نماید بی نقاب","بر شما احسان کند بهر ثواب","فرعون می‌گوید که وقتی شما را بدون نقاب و با چهره‌ای واقعی مشاهده می‌کند، به شما احسان می‌کند تا ثوابی کسب کند."],[312,"کان اسیران را به جز دوری نبود","دیدن فرعون دستوری نبود","اسیران یهودی که در مصر به عنوان برده زندگی می‌کردند، جز جدایی و دوری از وطن، هیچ امیدی نداشتند و نمی‌توانستند به فرعون دستور دهند یا خواسته‌ای از او داشته باشند."],[312,"گر فتادندی به ره در پیش او","بهر آن یاسه بخفتندی برو","اگر در مسیر، اسیران در برابر فرعون به زمین بیفتند، برای آن یاسه (شکست و ناامیدی) به خواب می‌روند."],[312,"یاسه این بد که نبیند هیچ اسیر","در گه و بیگه لقای آن امیر","یاسه (یأس) این بد است که هیچ اسیری در حضور آن امیر (موسی علیه‌السلام) را نبیند. به این معنا که ناامیدی از دیدن و حضور آن بزرگوار، برای انسان‌ها زیان‌آور و ناخوشایند است."],[312,"بانگ چاووشان چو در ره بشنود","تا نبیند رو به دیواری کند","چون صدای نداگران را در مسیر بشنود، پیش از اینکه به دیواری نگاه کند، به آن سمت می‌رود."],[312,"ور ببیند روی او مجرم بود","آنچ بتر بر سر او آن رود","اگر کسی روی او (موسی) را ببیند، او مجرم می‌شود و هر چه بر سر او می‌آید، بدتر خواهد بود."],[312,"بودشان حرص لقای ممتنع","چون حریصست آدمی فیما منع","حرص آن‌ها به ملاقات چیزهایی که نمی‌توان به دست آورد، مانند حرص آدمی است به چیزهایی که از او دریغ شده است."],[313,"ای اسیران سوی میدانگه روید","کز شهانشه دیدن و جودست امید","ای اسیران، به سوی محل جمع شدن بروید، زیرا در آنجا امید شما به دیدار و بخشش پادشاه بزرگ است."],[313,"چون شنیدند مژده اسرائیلیان","تشنگان بودند و بس مشتاق آن","چون اسرائیلیان خبر تولد موسی را شنیدند، بسیار تشنه و مشتاق بودند که او را ببینند."],[313,"حیله را خوردند و آن سو تاختند","خویشتن را بهر جلوه ساختند","همه آن‌ها فریب را پذیرفتند و به سمت آنجا دویدند، خود را برای نمایش و جلوه‌گری آماده کردند."],[314,"همچنان کاینجا مغول حیله‌دان","گفت می‌جویم کسی از مصریان","مغول حیله‌گر در اینجا می‌گوید که من در جستجوی کسی از مصریان هستم."],[314,"مصریان را جمع آرید این طرف","تا در آید آنک می‌باید به کف","باید گروهی از مصریان را جمع کنید و این طرف بیاورید تا آن کسی که باید به دست آید، ظاهر شود."],[314,"هر که می‌آمد بگفتا نیست این","هین در آ خواجه در آن گوشه نشین","هر کسی که به جمع می‌آمد، می‌گفت اینجا چه کار می‌کنید؟ بروید به آن طرف، آقای (یعنی کسی که دراز کشیده) در آن گوشه نشسته است."],[314,"تا بدین شیوه همه جمع آمدند","گردن ایشان بدین حیلت زدند","همه به همین شیوه جمع شدند و با این ترفند گردن آن‌ها را زیر بار کردند."],[314,"شومی آنک سوی بانگ نماز","داعی الله را نبردندی نیاز","کسی که به صدای دعوت برای نماز توجه نکند و به آن نرود، به شدت شوم و بدبخت است."],[314,"دعوت مکارشان اندر کشید","الحذر از مکر شیطان ای رشید","مراقب فریبکاری‌های مکاران باش، زیرا که شیطان نیز در کمین است و تو ای مرد شجاع، باید هوشیار باشی."],[314,"بانگ درویشان و محتاجان بنوش","تا نگیرد بانگ محتالیت گوش","صدای درویشان و نیازمندان را بشنو و به آن توجه کن تا نگذارید صدای مکر و فریبکاران به گوش تو برسد."],[314,"گر گدایان طامع‌اند و زشت‌خو","در شکم‌خواران تو صاحب‌دل بجو","اگر گدایان بخیل و زشت‌خو هستند، تو باید در میان کسانی که شکم‌خوارند، انسان‌های باصفا و با دل را پیدا کنی."],[314,"در تگ دریا گهر با سنگهاست","فخرها اندر میان ننگهاست","در عمق دریا، جواهراتی وجود دارد که با سنگ‌ها در کنار هم هستند؛ اما در میان این زیبایی‌ها، عیوب و ننگ‌ها هم وجود دارد که باید به آنها توجه کرد."],[314,"پس بجوشیدند اسرائیلیان","از پگه تا جانب میدان دوان","پس اسرائیلیان از جایشان به سرعت به سمت میدان دویدند."],[314,"چون به حیلتشان به میدان برد او","روی خود بنمودشان بس تازه‌رو","وقتی که قباد با تدبیر خاصی آنها را به میدان آورد، به آنها رویی نشان داد که بسیار شاداب و سرزنده بود."],[314,"کرد دلداری و بخششها بداد","هم عطا هم وعده‌ها کرد آن قباد","او (قایق) با دل‌جویی و بخشش، هم چیزهایی بخشید و هم وعده‌هایی داد. قباد، پادشاه زمان، این کار را انجام داد."],[314,"بعد از آن گفت از برای جانتان","جمله در میدان بخسپید امشبان","سپس گفت که برای جان‌هایتان، امشب در میدان بخوابید و استراحت کنید."],[314,"پاسخش دادند که خدمت کنیم","گر تو خواهی یک مه اینجا ساکنیم","آنها پاسخ دادند که اگر تو بخواهی، ما یک ماه در اینجا می‌مانیم و به تو خدمت می‌کنیم."],[315,"شه شبانگه باز آمد شادمان","کامشبان حملست و دورند از زنان","شاه در شب به شهر بازگشت و خوشحال بود، زیرا که کامیابی در جنگ داشت و زنانشان از آنها دور بودند."],[315,"خازنش عمران هم اندر خدمتش","هم به شهر آمد قرین صحبتش","خازن (نگهبان یا کارگزار) عمران نیز در خدمت او بود و به شهر آمد تا در کنار او باشد."],[315,"گفت ای عمران برین در خسپ تو","هین مرو سوی زن و صحبت مجو","عمران به من می‌گوید: \"بخواب، و به سمت زنان نرو و با آنها صحبت نکن."],[315,"گفت خسپم هم برین درگاه تو","هیچ نندیشم به جز دلخواه تو","عمران گفت: من در این درگاه برای تو می‌خوابم و هیچ چیزی جز خواسته و رضایت تو را نمی‌اندیشم."],[315,"بود عمران هم ز اسرائیلیان","لیک مر فرعون را دل بود و جان","عمران، پدر موسی (ع)، از بنی‌اسرائیل بود، اما دل و جان فرعون به خاطر مقام و قدرتش بر او متمرکز شده بود."],[315,"کی گمان بردی که او عصیان کند","آنک خوف جان فرعون آن کند","چگونه فکر می‌کردی که او (فرعون) سرکشی کند، در حالی که ترس از جان فرعون او را وادار به اطاعت کرده است؟"],[316,"شب برفت و او بر آن درگاه خفت","نیم‌شب آمد پی دیدنش جفت","شب سپری شد و زن در آن درگاه خوابیده بود. در نیمه شب، همسر او برای دیدن او آمد."],[316,"زن برو افتاد و بوسید آن لبش","بر جهانیدش ز خواب اندر شبش","زن به محض دیدن او بر او افتاد و لب او را بوسید و آنچنان او را خواب‌آلود از خواب بیدار کرد که گویا او را از خواب شبانه‌اش به دنیای بیداری کشانده است."],[316,"گشت بیدار او و زن را دید خوش","بوسه باران کرده از لب بر لبش","عمران بیدار شد و زن را دید که از سر شادی و عشق، لب‌هایش را بر لب او بوسه باران کرده است."],[316,"گفت عمران این زمان چون آمدی","گفت از شوق و قضای ایزدی","عمران (پدر موسی) به همسرش می‌گوید که اکنون که تو به اینجا آمده‌ای، دلیلش شادی و خواست الهی است."],[316,"در کشیدش در کنار از مهر مرد","بر نیامد با خود آن دم در نبرد","عمران، شوهر مادر موسی، به خاطر عشق و محبت قوی‌اش او را به کنار خود کشید و در آن لحظه نتوانست با خود از این احساسات قوی درونی مبارزه کند."],[316,"جفت شد با او امانت را سپرد","پس بگفت ای زن نه این کاریست خرد","مردی که به مادر موسی کمک کرده، به او می‌گوید که این کار (حامله شدن) کار بیهوده‌ای نیست و باید به او اعتماد کند."],[316,"آهنی بر سنگ زد زاد آتشی","آتشی از شاه و ملکش کین‌کشی","با ضربه زدن به آهن بر سنگ، آتش تولید شد و این آتش نماد دشمنی و کین‌ورزی بین شاه و ملک (حاکمان) است."],[316,"من چو ابرم تو زمین موسی نبات","حق شه شطرنج و ما ماتیم مات","من مانند ابر هستم و تو همچون زمین، که در آن گیاه موسی (علیه‌السلام) رشد می‌کند. حق (خدا) در مقام شاه در بازی شطرنج است و به ما می‌گوید که در نهایت، ما در این بازی باخته‌ایم."],[316,"مات و برد از شاه می‌دان ای عروس","آن مدان از ما مکن بر ما فسوس","ای عروس، تو نباید از ما درباره مفهوم شکست و پیروزی شاه چیز بدانی؛ مراقب باش که به ما آسیب نرسانی و در کارهای ما تداخل نکنی."],[316,"آنچ این فرعون می‌ترسد ازو","هست شد این دم که گشتم جفت تو","فرعون از چیزی که در اینجا به آن فکر می‌کند می‌ترسد، و این ترس از آنجا ناشی می‌شود که من (مادر موسی) اکنون با تو (عمران، پدر موسی) به یکدیگر پیوسته‌ام."],[317,"وا مگردان هیچ ازینها دم مزن","تا نیاید بر من و تو صد حزن","از این کارها دوری کن و درباره آنها سخن نگو، زیرا که اگر چنین کنی، حزن و اندوهی بزرگ بر من و تو نازل خواهد شد."],[317,"عاقبت پیدا شود آثار این","چون علامتها رسید ای نازنین","هرچند در ابتدا ممکن است آثار یا نشانه‌هایی به چشم نیاید، اما در نهایت به وضوح نمایان خواهد شد، همان‌گونه که نشانه‌ها و علامت‌ها به روشنی دیده می‌شوند، ای عزیز."],[317,"در زمان از سوی میدان نعره‌ها","می‌رسید از خلق و پر می‌شد هوا","در آن زمان، صدای نعره و فریاد مردم از طرف میدان به گوش می‌رسید و فضا پر از هیجان و شور می‌شد."],[317,"شاه از آن هیبت برون جست آن زمان","پابرهنه کین چه غلغلهاست هان","شاه به‌دلیل آن هیاهو و سر و صدایی که از میدان به گوش می‌رسید، بدون کفش از محل خارج شد و از خود می‌پرسید: این صداها چیست؟"],[317,"از سوی میدان چه بانگست و غریو","کز نهیبش می‌رمد جنی و دیو","صدای بلندی از سمت میدان می‌آید که آن‌قدر مهیب و ترسناک است که جن‌ها و دیوها از آن می‌گریزند."],[317,"گفت عمران شاه ما را عمر باد","قوم اسرائیلیانند از تو شاد","عمران که به عنوان یک شاه معرفی شده، به ما می‌گوید که عمر ما طولانی باشد و ما از شادی قوم اسرائیل که در تاریخ برای شادابی و خوشحالی معروفند، برخوردار شویم."],[317,"از عطای شاه شادی می‌کنند","رقص می‌آرند و کفها می‌زنند","از بخشش و هدیه‌های شاه خوشحال شده‌اند و به جشن و شادی پرداخته‌اند، با رقص و دست زدن ابراز شادمانی می‌کنند."],[317,"گفت باشد کین بود اما ولیک","وهم و اندیشه مرا پر کرد نیک","گفت: این موضوع ممکن است درست باشد، اما افکار و خیالات من را به شدت مشغول کرده است."],[318,"این صدا جان مرا تغییر کرد","از غم و اندوه تلخم پیر کرد","این صدا باعث شد که روح من دگرگون شود و از اندوه تلخ من کاسته گردد."],[318,"پیش می‌آمد سپس می‌رفت شه","جمله شب او همچو حامل وقت زه","فرعون در زمان‌هایی که صدا به گوشش می‌رسید، به جلو می‌آمد و سپس به عقب می‌رفتن، به‌گونه‌ای که همچون حامل زمان شب (مهدی) می‌نماید."],[318,"هر زمان می‌گفت ای عمران مرا","سخت از جا برده است این نعره‌ها","عمران (پدر حضرت موسی) هر بار می‌گفت که این صداهای بلند و رعب‌آور مرا به شدت به وحشت انداخته و از آرامش دور کرده است."],[318,"زهره نه عمران مسکین را که تا","باز گوید اختلاط جفت را","زهره، دختر عمران، آن‌قدر برای موسی ترسیده است که نمی‌تواند او را در آغوش بگیرد و جفت‌گیری را (یعنی تولد او) بیان کند."],[318,"که زن عمران به عمران در خزید","تا که شد استاره موسی پدید","زن عمران (مادر موسی) به عمران (پدر موسی) پناه برد و در درون او (رحمش) مخفی شد تا اینکه فرزندش موسی درخشش و ظهور پیدا کرد."],[318,"هر پیمبر که در آید در رحم","نجم او بر چرخ گردد منتجم","هر پیامبری که در رحم مادرش قرار می‌گیرد، ستاره‌اش در آسمان درخشان و تابان می‌شود."],[319,"بر فلک پیدا شد آن استاره‌اش","کوری فرعون و مکر و چاره‌اش","ستاره موسی بر آسمان نمایان شد و این نشانه‌ای است برای غافل شدن فرعون از حقیقت و تدبیرهای او."],[319,"روز شد گفتش که ای عمران برو","واقف آن غلغل و آن بانگ شو","عمران، به او (موسی) می‌گوید که در روز روشن برود و از آن صدای غریو و هیاهو باخبر شود."],[319,"راند عمران جانب میدان و گفت","این چه غلغل بود شاهنشه نخفت","عمران، پدر موسی علیه‌السلام، به سوی میدان رفت و گفت: این چه صدای بلندی است که به گوش می‌رسد، آیا شاهنشاه (خدای بزرگ) خوابیده است؟"],[319,"هر منجم سر برهنه جامه‌چاک","همچو اصحاب عزا بوسیده خاک","هر منجم با سر برهنه و لباس پاره، مانند افرادی که در عزاداری به خاک افتاده و آن را می‌بوسند، به زمین افتاده‌اند."],[319,"همچو اصحاب عزا آوازشان","بد گرفته از فغان و سازشان","آواز منجمان مانند صدای عزاداران است که از شدت گریه و ناله، گرفته و غمگین شده است."],[319,"ریش و مو بر کنده رو بدریدگان","خاک بر سر کرده خون‌پر دیدگان","مردم به شدت درمانده و غمگین هستند. آن‌ها مو و ریش خود را کنده و بر سر خاک ریخته‌اند و چهره‌هایشان پر از اشک و خون است."],[319,"گفت خیرست این چه آشوبست و حال","بد نشانی می‌دهد منحوس سال","سردسته این جمع پرسید که چرا این همه بی‌نظمی و حال بد در این جا به وجود آمده است، و چه نشانه‌ای از شوم بودن سال به نمایش گذاشته است."],[319,"عذر آوردند و گفتند ای امیر","کرد ما را دست تقدیرش اسیر","آن‌ها به امیر می‌گویند که ما دست تقدیر را بهانه می‌کنیم و عذرخواهی می‌کنیم، زیرا برای ما سرنوشتی مشقت‌بار رقم خورده است."],[319,"این همه کردیم و دولت تیره شد","دشمن شه، هست‌گشت و چیره شد","ما تمام تلاش خود را کردیم، اما نتیجه برعکس شد و کارهایمان خراب گردید و دشمن بر ما چیره شد و به قدرت رسید."],[319,"شب ستاره آن پسر آمد عیان","کوری ما بر جبین آسمان","در شب، ستاره آن پسر (موسی علیه السلام) آشکار شد و در این هنگام، نادانی ما همانند نشانه‌ای بر پیشانی آسمان نمایان گردید."],[319,"زد ستاره آن پیمبر بر سما","ما ستاره‌بار گشتیم از بکا","ستاره آن پیامبر (موسی علیه‌السلام) در آسمان درخشید و ما از اندوه و گریه به شکوه و شادی تغییر حالت دادیم و احساس خوشی کردیم."],[319,"با دل خوش شاد عمران وز نفاق","دست بر سر می‌بزد کاه الفراق","عمران به‌شدت خوشحال است و از سر شوق، به خاطر فاصله و جدایی بر سرش می‌زند و این نشان‌دهنده نفاق (دوچهرگی) اوست."],[319,"کرد عمران خویش پر خشم و ترش","رفت چون دیوانگان بی عقل و هش","عمران (موسی علیه السلام) به شدت خشمگین و عبوس شد و مانند دیوانگان بی‌عقل و هوش به راه خود ادامه داد."],[319,"خویشتن را اعجمی کرد و براند","گفته‌های بس خشن بر جمع خواند","او خود را به گونه‌ای غریب و غیرمعمول نشان داد و شروع به گفتن سخنانی بسیار زشت و زننده در جمع مردم کرد."],[319,"خویشتن را ترش و غمگین ساخت او","نردهای بازگونه باخت او","موسی علیه السلام خود را غمگین و دل‌زده کرد و در این حال، از روی بدشانسی به افرادی شبیه باز نرد (باخت) کرد."],[319,"گفتشان شاه مرا بفریفتید","از خیانت وز طمع نشکیفتید","شاه می‌گوید: شما به وسیله فریب مرا به دام انداختید و با خیانت و طمع به من ضربه زدید."],[319,"سوی میدان شاه را انگیختید","آب روی شاه ما را ریختید","شما عده‌ای در میدان، شاه را تحریک کرده و به سمت او رفته‌اید و با این کار آبروی او را در میان مردم برده‌اید."],[319,"دست بر سینه زدیت اندر ضمان","شاه را ما فارغ آریم از غمان","شما در اینجا با به سینه زدن به نوعی بی‌اعتنایی به درد و رنج شاه، او را از غم و غصه آزاد می‌کنید و به او اطمینان می‌دهید که حالش خوب خواهد شد."],[319,"شاه هم بشنید و گفت ای خاینان","من بر آویزم شما را بی امان","شاه متوجه شد و گفت: ای خیانتکاران، من شما را بدون ترحم به مجازات می‌رسانم."],[319,"خویش را در مضحکه انداختم","مالها با دشمنان در باختم","خودم را مسخره کرده‌ام و در میان دشمنان، ثروت‌هایم را از دست داده‌ام."],[319,"تا که امشب جمله اسرائیلیان","دور ماندند از ملاقات زنان","امشب همه بنی‌اسرائیل از ملاقات با زنانشان دور مانده‌اند."],[319,"مال رفت و آب رو و کار خام","این بود یاری و افعال کرام؟","این بیانیه به این معناست که تمام ثروت‌ها و منابع (مال) از بین رفته و تلاش‌ها و کارها (کار خام) بی‌اثر شده‌اند، آیا این تلاشی که کردیم تنها برای یاری یکدیگر و انجام کارهای نیک بوده است؟"],[319,"سالها ادرار و خلعت می‌برید","مملکتها را مسلم می‌خورید","سال‌ها در حال خضوع و نذری به دیگران چیزهایی می‌دادید، اما در عوض کشورها را می‌سوزانید و مسلمانان را نابود می‌کردید."],[319,"رایتان این بود و فرهنگ و نجوم","طبل‌خوارانید و مکارید و شوم","شما پرچمتان این است و فرهنگ و دانش‌تان به مانند طبل‌زنانی است که دروغین و فریبکار هستند و سرنوشت‌شان نیکو نیست."],[319,"من شما را بر درم و آتش زنم","بینی و گوش و لبانتان بر کنم","من شما را در برابر خودم قرار می‌دهم و به شما آتش می‌زنم و بینی، گوش و لب‌های‌تان را دچار آسیب می‌کنم."],[319,"من شما را هیزم آتش کنم","عیش رفته بر شما ناخوش کنم","من شما را به هیزم آتش تبدیل می‌کنم و خوشی و عیشی که دارید را برایتان تلخ و ناخوشایند می‌کنم."],[319,"سجده کردند و بگفتند ای خدیو","گر یکی کرت ز ما چربید دیو","سجده کردند و گفتند: ای خدایی که بر ما تسلط داری، اگر یکی از ما بر دیگری فایق آید، آن را دیو و شیطانی می‌دانیم."],[319,"سالها دفع بلاها کرده‌ایم","وهم حیران زانچ ماها کرده‌ایم","سال‌ها سختی‌ها و مشکلات را دفع کرده‌ایم و به همین خاطر در حیرت هستیم که چگونه از ماها (انسان‌ها) این اعمال ناشی شده است."],[319,"فوت شد از ما و حملش شد پدید","نطفه‌اش جست و رحم اندر خزید","زمانی که ما از دنیا می‌رویم، جنین در دامان مادر پنهان می‌شود و بارداری آغاز می‌گردد."],[319,"لیک استغفار این روز ولاد","ما نگه داریم ای شاه و قباد","اما روز ولادت ما را باید با استغفار و طلب آمرزش سپری کنیم، ای شاه و قباد (مصلح و فرمانروایانی که اشاره به ویژگی‌های خاص دارند)."],[319,"روز میلادش رصد بندیم ما","تا نگردد فوت و نجهد این قضا","ما روز تولد او را به دقت زیر نظر می‌گیریم تا این که سرنوشت تغییر نکند و از دست نرود."],[319,"گر نداریم این نگه ما را بکش","ای غلام رای تو افکار و هش","اگر ما این نگاه را نداشته باشیم، ای غلام، آن را بکش. نظر و تفکر تو در این افکار و هوش، باید باشد."],[319,"تا به نه مه می‌شمرد او روز روز","تا نپرد تیر حکم خصم‌دوز","او تا نه ماه (نه مه) را می‌شمرد، یعنی در حال شمارش زمان بود، و این در حالی بود که روز به روز می‌گذشت و تیر (حکم) دشمن بدخواه به او اصابت نمی‌کرد."],[319,"بر قضا هر کو شبیخون آورد","سرنگون آید ز خون خود خورد","هر کس که به ظلم و حمله به دیگران دست بزند، در نهایت به سرنوشت بدی دچار می‌شود و از خون خود می‌نوشد، یعنی عواقب کارهای نادرستش به او بازمی‌گردد."],[319,"چون زمین با آسمان خصمی کند","شوره گردد سر ز مرگی بر زند","وقتی که زمین و آسمان با یکدیگر در جدال و دشمنی باشند، از این کشمکش، زمین دچار خشکسالی و شوری می‌شود و همچون مرده‌ای، سر از مرگ برمی‌دارد."],[319,"نقش با نقاش پنجه می‌زند","سبلتان و ریش خود بر می‌کند","نقش، یعنی تصویر یا مجسمه، با نقاشی که آن را خلق کرده، در نبرد است و سبلتان (نشان‌دار) و ریش خود را قطع می‌کند. این تصویر به نوعی به جنگ و ناآرامی در بین انسان‌ها و هویت‌هایشان اشاره دارد."],[320,"بعد نه مه شه برون آورد تخت","سوی میدان و منادی کرد سخت","پس از گذشت نه ماه، شاه تخت خود را به میدان آورد و با صدای بلند فرمان داد."],[320,"کای زنان با طفلکان میدان روید","جمله اسرائیلیان بیرون شوید","ای زنان، همراه با بچه‌های خود به میدان بروید و همه اسرائیلی‌ها نیز بیرون بیایند."],[320,"آنچنانک پار مردان را رسید","خلعت و هر کس ازیشان زر کشید","مردان در این روزی که به آن فرا رسیده‌اند، لباس‌های فاخر و جواهرات را به تن کرده و هر کدام از آن‌ها از ثروت و طلا بهره‌مند شده‌اند."],[320,"هین زنان امسال اقبال شماست","تا بیابد هر یکی چیزی که خواست","این سال، سال خوش‌شانسی و موفقیت شما زنان است تا هر کدام از شما به آنچه که می‌خواهید دست پیدا کنید."],[320,"مر زنان را خلعت و صلت دهد","کودکان را هم کلاه زر نهد","فرعون به زنان هدیه و پاداش می‌دهد و برای نوزادان هم کلاهی از طلا قرار می‌دهد."],[320,"هر که او این ماه زاییدست هین","گنجها گیرید از شاه مکین","هر کسی که این ماه را زاییده است، پاداش‌های گرانبهایی از شاه مکی (فرعون) بگیرد."],[320,"آن زنان با طفلکان بیرون شدند","شادمان تا خیمه شه آمدند","آن زن‌ها با بچه‌هایشان به‌طور شاد و خوشحال به سمت خیمه شاه رفتند."],[320,"هر زن نوزاده بیرون شد ز شهر","سوی میدان غافل از دستان و قهر","هر زن با نوزادش از شهر خارج شد به سمت میدان، غافل از اینکه دست‌ها و قهر فرعون در کمین است."],[320,"چون زنان جمله بدو گرد آمدند","هرچه بود آن نر ز مادر بستدند","وقتی تمام زنان دور او جمع شدند، هرچه نوزاد دختر بود را از مادرانشان گرفتند."],[320,"سر بریدندش که اینست احتیاط","تا نروید خصم و نفزاید خباط","سر او را بریدند تا احتیاط کنند و از این طریق از رشد دشمن (فرعون) جلوگیری کنند و تا بدی‌ها بیشتر و بیشتر نشود."],[321,"خود زن عمران که موسی برده بود","دامن اندر چید از آن آشوب و دود","زن عمران، مادر موسی، دامن خود را پر از آتش و دود کرد و به خاطر آشوبی که پیش آمده بود، او نیز در این وضعیت تحت تاثیر قرار گرفت."],[321,"آن زنان قابله در خانه‌ها","بهر جاسوسی فرستاد آن دغا","زنان قابله در خانه‌ها به‌منظور جاسوسی و اطلاع‌یابی فرستاده شدند تا از وضعیت وضعیت حمل و زایمان باخبر شوند و فریبکاری بکنند."],[321,"غمز کردندش که اینجا کودکیست","نامد او میدان که در وهم و شکیست","زن‌هایی که برای جاسوسی آمده بودند، به یکدیگر اشاره کردند که در اینجا کودکی وجود دارد. اما موسی در این لحظه نمی‌دانست که موضوع به وهم و شک مربوط می‌شود و این اشاره‌ها به چه معناست."],[321,"اندرین کوچه یکی زیبا زنیست","کودکی دارد ولیکن پرفنیست","در این کوچه، زنی زیبا وجود دارد که فرزندی دارد، اما فرزندش دارای ویژگی خاصی است که او را خاص و شگفت‌انگیز می‌کند."],[321,"پس عوانان آمدند او طفل را","در تنور انداخت از امر خدا","عوانان (یاران) آمدند و به دستور خداوند، آن کودک را در تنور انداختند."],[321,"وحی آمد سوی زن زان با خبر","که ز اصل آن خلیلست این پسر","وحی به مادر موسی رسید و او را از این موضوع مطلع کرد که این پسر از نسل ابراهیم خلیل (پیامبر) است."],[321,"عصمت یا نار کونی باردا","لا تکون النار حرا شاردا","در این بیت، به عصمت و حفاظت الهی اشاره شده است که آتش نمی‌تواند به موسی (علیه‌السلام) آسیب برساند و به نوعی بیان می‌کند که آتش نمی‌تواند او را بسوزاند یا اذیت کند."],[321,"زن به وحی انداخت او را در شرر","بر تن موسی نکرد آتش اثر","زن، با وحی الهی، موسی را به درون آتش انداخت، اما آتش هیچ تأثیری بر بدن موسی نداشت."],[321,"پس عوانان بی مراد آن سو شدند","باز غمازان کز آن واقف بدند","عوانان (پیام‌آوران) بدون کسب نتیجه به سمت دیگر رفتند، در حالی که غمازان (غمگینان) از این واقعه آگاه بودند."],[321,"با عوانان ماجرا بر داشتند","پیش فرعون از برای دانگ چند","عوانان (پیروان) به ماجرا پرداختند و به سوی فرعون رفتند تا بخشی از چیزی را که باید به او داده شود، دریافت کنند."],[321,"کای عوانان باز گردید آن طرف","نیک نیکو بنگرید اندر غرف","ای عوانان، به آن طرف برگردید و خوب توجه کنید که چه زیبایی‌ها و خوبی‌هایی در آنجا وجود دارد."],[322,"باز وحی آمد که در آبش فکن","روی در اومید دار و مو مکن","وحی دوباره نازل شد که فرزندت را به آب نیل بینداز و امیدوار باش و نترس."],[322,"در فکن در نیلش و کن اعتمید","من تو را با وی رسانم رو سپید","فرمان می‌آید که او را در رود نیل بیفکن و نگران نباش. من تو را به او می‌رسانم و چهره‌ات را نورانی می‌کنم."],[322,"این سخن پایان ندارد مکرهاش","جمله می‌پیچید هم در ساق و پاش","سخن درباره مکر و نیرنگی است که همواره پایان ندارد و در هر حالتی به شکلی جدید و پیچیده در می‌آید، مانند خم و پیچ در ساق و پا."],[322,"صد هزاران طفل می‌کشت او برون","موسی اندر صدر خانه در درون","او (فرعون) صدها هزار کودک را در خارج از خانه می‌کشت، اما در درون خانه، موسی (نوزاد) را در صدر (جایگاه) نگه می‌داشت."],[322,"از جنون می‌کشت هر جا بد جنین","از حیل آن کورچشم دوربین","فرعون، به خاطر جنون و دیوانگی‌اش، هر جنینی را که در هر کجا پیدا می‌کرد، می‌کشت؛ بنابراین، او با نیرنگ و فریب، به دنبال آن بود که موسی را پیدا کند، ولی او خود را از دید فرعون پنهان کرده بود."],[322,"اژدها بد مکر فرعون عنود","مکر شاهان جهان را خورده بود","مکر و حیله فرعون، مانند یک اژدها بود که به‌طور ناپاک و مخرب در کمین است و مکر شاهان دنیا را هم می‌بلعد."],[322,"لیک ازو فرعون‌تر آمد پدید","هم ورا هم مکر او را در کشید","اما از او (مکر) فرعون هم برتر و قوی‌تر بوجود آمد؛ به همین دلیل، مکر او (مکر فرعون) نیز او را به درون خود کشید."],[322,"اژدها بود و عصا شد اژدها","این بخورد آن را به توفیق خدا","موسی ابتدا برای ترساندن فرعون عصای خود را به اژدها تبدیل کرد و این معجزه به اراده و کمک خداوند بود که اژدها فرعون را بلعید."],[322,"دست شد بالای دست این تا کجا","تا به یزدان که الیه المنتهی","این دست (راست)، بالای دست دیگر است تا کجا ادامه می‌یابد، تا اینکه به یزدان (خدا) که پایان‌پذیر نیست، برسد."],[322,"کان یکی دریاست بی غور و کران","جمله دریاها چو سیلی پیش آن","یک دریا وجود دارد که عمق و انتهایی ندارد و همه دریاها در برابر آن مثل یک سیل کوچکی هستند."],[322,"حیله‌ها و چاره‌ها گر اژدهاست","پیش الا الله آنها جمله لاست","حیله‌ها و تدبیرها، حتی اگر بسیار بزرگ و خطرناک مثل اژدها باشند، در برابر خدا هیچ هستند و به هیچ می‌مانند."],[322,"چون رسید اینجا بیانم سر نهاد","محو شد والله اعلم بالرشاد","هنگامی که به اینجا رسیدم و بیان کردم، سرم را بالا گذاشتم و محو شدم. به خدا قسم، او بهتر از هر کسی به راهنمایی و هدایت داناست."],[322,"آنچ در فرعون بود اندر تو هست","لیک اژدرهات محبوس چهست","آنچه در فرعون (فرعون مصر) وجود داشت، در تو نیز هست، اما تنش و قدرتش فقط در وجود تو محبوس مانده و آزاد نیست."],[322,"ای دریغ این جمله احوال تو است","تو بر آن فرعون بر خواهیش بست","بسیار افسوس که این وضعیت توست و تو به همان فرعون (ظالم و مستبد) وابسته‌ای و به او ارتباط داری."],[322,"گر ز تو گویند وحشت زایدت","ور ز دیگر آفسان بنمایدت","اگر از تو بگویند که وحشت به سراغت می‌آید یا اینکه از کسی دیگر (چیزی) مانند افسانه‌ها پیش خود بیارند، آن را جدی نگیر."],[322,"چه خرابت می‌کند نفس لعین","دور می‌اندازدت سخت این قرین","نفس شما که به بدی‌ها و خواهش‌های نفسانی اشاره دارد، چه نابودکننده‌ای است و می‌تواند شما را به سختی به دور از هدایت و حقیقت بیندازد."],[322,"آتشت را هیزم فرعون نیست","ورنه چون فرعون او شعله‌زنیست","عواطف و احساسات تو آنقدر شدید و مخرب است که نیازی به عوامل خارجی برای شعله‌ور شدن ندارد؛ اگر چنین نبود، مانند فرعون که با هیزم‌هایش آتش به پا می‌کرد، قادر به ایجاد درگیری و آتش‌افروزی نمی‌بود."],[323,"یک حکایت بشنو از تاریخ‌گوی","تا بری زین راز سرپوشیده بوی","یک داستان بشنو از کسی که تاریخ‌ها را روایت می‌کند تا از این راز پنهان آگاه شوی."],[323,"مارگیری رفت سوی کوهسار","تا بگیرد او به افسون‌هاش مار","مارگیری به سمت کوه‌ها رفت تا با افسون‌ها و جادوهایش، مار بگیرد."],[323,"گر گران و گر شتابنده بود","آنک جوینده‌ست یابنده بود","هرچقدر هم که کار و تلاش سنگین و دشوار باشد، یا به سرعت پیش برود، کسی که به دنبال چیزی است، در نهایت به آن دست می‌یابد."],[323,"در طلب زن دایما تو هر دو دست","که طلب در راه نیکو رهبر‌ست","در جستجوی زن، همیشه باید با دستانی پر تلاش و ثابت قدم بروی، زیرا طلب کردن در مسیر نیک، راه را به تو می‌آموزد."],[323,"لنگ و لوک و خفته‌شکل و بی‌ادب","سوی او می‌غیژ و او را می‌طلب","ناتوان و لنگ و خواب‌آلود و بی‌احترام، به سوی او (زن) می‌روند و او را می‌جویند."],[323,"گه به گفت و گه به خاموشی و گه","بوی کردن گیر هر سو بوی شه","گاهی صحبت می‌کند و گاهی سکوت می‌کند و گاهی نیز به استشمام بوی پادشاه می‌پردازد."],[323,"گفت آن یعقوب با اولاد خویش","جستن یوسف کنید از حد بیش","یعقوب (پیامبر و پدر یوسف) به فرزندانش می‌گوید که بیشتر از حد معمول به دنبال یوسف بگردند."],[323,"هر حس خود را درین جستن به جد","هر طرف رانید شکل مستعد","هر حس و درک خود را در این جست‌وجو به‌طور جدی و متعهدانه به سمت هر طرف هدایت کنید تا به بهترین شکل ممکن عمل کنید."],[323,"گفت از روح خدا لاتیأسوا","همچو گم کرده پسر رو سو به سو","بسیار قوی و نیرومند است که گفتند از روح خدا ناامید نشوید، مانند کسی که پسرش را گم کرده و در هر سو به دنبال او می‌گردد."],[323,"از ره حس دهان پرسان شوید","گوش را بر چار راه آن نهید","از طریق حس و مشاهده، از راه‌های مختلف بپرسید و به دنبال پاسخ‌ها باشید، گوش خود را در چهارراه‌ها (محل‌های تلاقی) بگذارید تا پاسخ‌ها را بشنوید."],[323,"هر کجا بوی خوش آید بو برید","سوی آن سر کاشنای آن سرید","هر جا که بوی خوشی به مشام برسد، باید به سمت آن رفت و به جستجوی منبع آن بو پرداخت."],[323,"هر کجا لطفی ببینی از کسی","سوی اصل لطف ره یابی عسی","هر جا محبت و نیکی از کسی ببینی، به ریشه و اصل محبت آن شخص راه پیدا می‌کنی."],[323,"این همه خوش‌ها ز دریایی‌ست ژرف","جزو را بگذار و بر کل دار طرف","این همه خوشی‌ها و زیبایی‌ها ناشی از یک دریای عمیق و بی‌پایان است. جزئیات و فردیت را رها کن و به کل و یکپارچگی توجه کن."],[323,"جنگ‌های خلق بهر خوبی است","برگ بی‌برگی نشان طوبی است","جنگ‌ها و درگیری‌های میان مردم در واقع برای ایجاد خوبی و نیکی است، مانند برگ بی‌برگ درخت طوبی که نماد برکت و زیبایی است."],[323,"خشم‌های خلق بهر آشتی‌ست","دام راحت دایما بی‌راحتی‌ست","خشم و غضب مردم در واقع برای ایجاد صلح و آشتی است، در حالیکه آرامش و راحتی دائمی وجود ندارد و انسان مدام در نارضایتی به سر می‌برد."],[323,"هر زدن بهر نوازش را بود","هر گله از شکر آگه می‌کند","هر گاه که کسی را می‌زنند، به منظور نوازش و محبت است و هر ناله یا شکایتی به خاطر شیرینی و خوشی واقعی او را آگاه می‌کند."],[323,"بوی بر از جزو تا کل ای کریم","بوی بر از ضد تا ضد ای حکیم","ای کریم، بوی خوشی که از جزئیات به کل می‌رسد، و ای حکیم، بوی خوشی که از ضدها به ضد دیگر می‌رسد، قابل توجه است."],[323,"جنگ‌ها می آشتی آرد درست","مارگیر از بهر یاری مار جست","مارگیر برای کمک به مار، جنگ‌ها و درگیری‌ها را به صلح تبدیل می‌کند و تلاش می‌کند تا مار را نجات دهد."],[323,"بهر یاری مار جوید آدمی","غم خورد بهر حریف‌ بی‌غمی","انسان برای کمک به مار، دچار نگرانی و غم می‌شود، در حالی که برای دوست بی‌غم خود، هیچ اضطرابی ندارد."],[323,"او همی‌جستی یکی ماری شگرف","گرد کوهستان و در ایام برف","او در پی پیدا کردن یک مار بزرگ و عظیم در ناحیه کوهستانی و در زمان برف بود."],[323,"اژدهایی مرده دید آنجا عظیم","که دلش از شکل او شد پر ز بیم","مارگیر در آنجا اژدهایی بزرگ و مرده را دید که دیدن آن باعث ترس شدید او شد."],[323,"مارگیر اندر زمستان شدید","مار می‌جست اژدهایی مرده دید","مارگیر در زمستان سرد به دنبال مار بود که اژدهایی مرده را دید."],[323,"مارگیر از بهر حیرانی خلق","مار گیرد اینت نادانی خلق","مارگیر به خاطر سردرگمی و حیرت مردم، مار را می‌گیرد؛ بنابراین این نشان‌دهنده نادانی و بی‌خودی مردم است."],[323,"آدمی کوهی‌ست‌، چون مفتون شود‌؟","کوه اندر مار حیران چون شود‌؟","انسان مانند کوهی است که وقتی به اشتباه یا مجنون می‌شود، در میانه بلبشوی زندگی نیز در حیرت و سردرگمی قرار می‌گیرد."],[323,"خویشتن نشناخت مسکین آدمی","از فزونی آمد و شد در کمی","این بیت بیان می‌کند که انسان در اثر تکرار و شلوغی زندگی، خود واقعی‌اش را نمی‌شناسد و به فزونی کارها و مشغله‌ها، استعدادهای خود را نادیده می‌گیرد و به نوعی گم می‌شود."],[323,"خویشتن را آدمی ارزان فروخت","بود اطلس خویش بر دلقی بدوخت","انسان خود را بی‌ارزش شمرد و جایگاه واقعی‌اش را نادیده گرفت، مانند اینکه پارچه‌ای گرانبها را به لباسی بی‌کیفیت دوخت."],[323,"صد هزاران مار و که حیران اوست","او چرا حیران شده‌ست و مار‌دوست‌؟","همه مخلوقات از جمله همان مار و کوه حیران و شیفته انسان هستند، پس چرا انسان باید شیفته مار شود؟"],[323,"مارگیر آن اژدها را برگرفت","سوی بغداد آمد از بهر شگفت","مارگیر اژدهایی را که به اشتباه مرده پنداشته بود، برداشت و به سوی بغداد رفت تا از این واقعه شگفت‌انگیز دیگران را مطلع کند."],[323,"اژدهایی چون ستون خانه‌ای","می‌کشیدش از پی دانگانه‌ای","مارگیر اژدهایی را که به اندازه ستون‌های خانه بزرگ بود، از تیردان به سمت خود می‌کشید."],[323,"کاژدهای مرده‌ای آورده‌ام","در شکارش من جگرها خورده‌ام","من اژدهایی را که به تصورم مرده است، شکار کرده‌ام و برای نشان دادن آن به دیگران، جگرهایی از پهلویش خورده‌ام."],[323,"او همی مرده گمان بردش ولیک","زنده بود و او ندیدش نیک نیک","او (مارگیر) گمان می‌کرد که اژدها مرده است، ولی در واقع اژدها زنده بود و او (مارگیر) نتوانسته بود به خوبی او را ببیند."],[323,"او ز سرما‌ها و برف افسرده بود","زنده بود و شکل مرده می‌نمود","او به خاطر سرما و برف ضعیف و کم‌جان شده بود، اما در واقع زنده بود و شبیه یک موجود مرده به نظر می‌رسید."],[323,"عالم افسرده‌ست و نام او جماد","جامد افسرده بود ای اوستاد","عالم (دنیا) هم اکنون در حال افسردگی و ناامیدی است و به حالت بی‌حرکتی و جامد در آمده، مانند موجودی بی‌جان و بی‌تحرک. ای استاد، این وضعیت مشابه حالتی است که حالت سرمای شدید و افسردگی بر موجودات حاکم می‌آورد."],[323,"باش تا خورشید حشر آید عیان","تا ببینی جنبش جسم جهان","صبر کن تا روز قیامت (حشر) فرا برسد و با روشن شدن حقیقت، جنبش و تحرک این جهان را مشاهده کنی."],[323,"چون عصای موسی اینجا مار شد","عقل را از ساکنان اخبار شد","چون عصای موسی (که به معجزه تبدیل به مار شد) در اینجا، عقل نیز به مانند آن تبدیل به مار شده و از ساکنان (مردم) خبر و آگاهی می‌شود."],[323,"پاره خاک تو را چون مرد ساخت","خاک‌ها را جملگی شاید شناخت","خاکی که تو از آن ساخته شده‌ای، مانند یک مرد زنده شده است و به همین دلیل می‌تواند همه خاک‌ها را بشناسد."],[323,"مرده زین سو اند و زان سو زنده‌اند","خامش اینجا و آن طرف گوینده‌اند","مردگان از یک سو خاموش و از سوی دیگر زنده هستند؛ در اینجا سکوت دارند، اما در آن طرف، گویندگان هستند و سخن می‌گویند."],[323,"چون از آن سوشان فرستد سوی ما","آن عصا گردد سوی ما اژدها","زمانی که عصا به سوی ما فرستاده شود، به اژدها تبدیل می‌شود."],[323,"کوهها هم لحن داودی کند","جوهر آهن به کف مومی بود","کوه‌ها نیز مانند داود نواهای زیبا و دلنشینی تولید می‌کنند، در حالی که در درونشان آهنی وجود دارد که قابل تغییر و نرم مثل موم است."],[323,"باد حمال سلیمانی شود","بحر با موسی سخن‌دانی شود","باد به نیروی سلیمان قدرتی می‌یابد و مانند دریا، با موسی به سخن می‌آید و دانایی را نشان می‌دهد."],[323,"ماه با احمد اشارت‌بین شود","نار ابراهیم را نسرین شود","ماه با احمد (پیامبر اسلام) در زبان اشاره صحبت می‌کند و در نتیجه آتش ابراهیم (که به فرمان خدا بی‌خطر شد) به گل نسرین تبدیل می‌شود. این بیت به تحولی معنوی و یا الهی اشاره دارد که در آن درون‌مایه‌های سخت و آتشین، به زیبایی و لطافت بدل می‌شود."],[323,"خاک قارون را چو ماری درکشد","استن حنانه آید در رشد","خاک قارون، که به دلیل ثروت زیادش معروف بود، مانند ماری به زمین کشیده می‌شود و در روز حساب، عذاب الهی به او می‌رسد."],[323,"سنگ بر احمد سلامی می‌کند","کوه یحیی را پیامی می‌کند","سنگ به احمد (پیامبر) سلام می‌دهد و کوه یحیی (حضرت یحیی) پیامی به او می‌رساند. این بیت به ارتباط و پیوند میان طبیعت و افراد مقدس اشاره دارد."],[323,"ما سمیعیم و بصیریم و خوشیم","با شما نامحرمان ما خامشیم","ما شنوا و بینا و شاداب هستیم، اما در کنار شما که نامحرمان هستید، سکوت می‌کنیم."],[323,"چون شما سوی جمادی می‌روید","محرم جان جمادان چون شوید؟","وقتی شما به سمت مخلوقات بی‌روح (جمادی) می‌روید، چگونه می‌توانید در این حالت با روح آنها آشنا شوید و محرم آنها شوید؟"],[323,"از جمادی عالم جانها روید","غلغل اجزای عالم بشنوید","از حالت بی‌جان و جامد (جماد) که فراتر بروید، جان‌ها و حیات‌های واقعی پیدا می‌شوند. به صدای زنده و پویای اجزای جهان گوش کنید و آن را بشنوید."],[323,"فاش تسبیح جمادات آیدت","وسوسه‌ی تاویلها نربایدت","آشکارا و به وضوح، تسبیح و ذکر موجودات بی‌جان به تو الهام می‌شود، اما وسوسه‌های تأویل و تفسیر نباید تو را به خود مشغول کند."],[323,"چون ندارد جان تو قندیل‌ها","بهر بینش کرده‌ای تاویل‌ها","اگر جان تو مانند قندیل‌ها نور ندارد و روشن نیست، چرا به خاطر بینش و درک خود، تأویل‌های گوناگون می‌کنی و آنها را معنا می‌کنی؟"],[323,"که غرض تسبیح ظاهر کی بود","دعوی دیدن خیال غی بود","هدف از تسبیح گفتن فقط برای نمایش و ظاهر نیست، بلکه ادعای اینکه انسان می‌تواند اوضاع غیبی و باطنی را ببیند، مقصود اصلی است."],[323,"بلک مر بیننده را دیدار آن","وقت عبرت می‌کند تسبیح‌خوان","البته، در واقع کسی که تسبیح می‌گوید، در اوج دیدن و شناخت قرار می‌گیرد و آن زمان است که از منظر و تجربه‌اش عبرت می‌گیرد."],[323,"پس چو از تسبیح یادت می‌دهد","آن دلالت همچو گفتن می‌بود","اگر از تسبیح یاد می‌کنی، این یادآوری به مانند گفتن است؛ یعنی نشانه‌ای است برای درک و عبرت."],[323,"این بود تاویل اهل اعتزال","و آن‌ آنکس کو ندارد نور حال","این، تفسیر و برداشت اهل اعتزال (گروه یا مکتبی که به عقل و استدلال اهمیت می‌دهند) است و نیز اشاره به حال شخصی دارد که درک و روشنایی معنوی ندارد."],[323,"چون ز حس بیرون نیامد آدمی","باشد از تصویر غیبی اعجمی","آدمی تا زمانی که از احساسات و ضوابط دنیوی و احوال مادی خود خارج نشود، نمی‌تواند به درک و تصویر واقعی از حقایق غیبی و معنوی دست یابد."],[323,"این سخن پایان ندارد مارگیر","می‌کشید آن مار را با صد زحیر","این داستان هرگز تمام نمی‌شود، زیرا مارگیر همچنان مار را با زحمت و تلاش بسیار می‌کشد."],[323,"تا به بغداد آمد آن هنگامه‌جو","تا نهد هنگامه‌ای بر چارسو","مارگیر که به بغداد می‌رسد، می‌خواهد در این شهر هم هیاهویی به راه بیندازد و توجه مردم را جلب کند."],[323,"بر لب شط مرد هنگامه نهاد","غلغله در شهر بغداد اوفتاد","مردی که در کنار رودخانه است، سر و صدایی به راه انداخته و در شهر بغداد غوغایی به پا کرده است."],[323,"مارگیری اژدها آورده است","بوالعجب نادر شکاری کرده است","مارگیر اژدهایی را به بغداد آورده که کار عجیب و نادری انجام داده است."],[323,"جمع آمد صد هزاران خام‌ریش","صید او گشته چو او از ابلهیش","بسیاری از انسان‌های نادان و بی‌تجربه به دور او جمع شده‌اند و به‌خاطر نادانی‌شان شکار او شده‌اند."],[323,"منتظر ایشان و هم او منتظر","تا که جمع آیند خلق منتشر","او (نیز) منتظر جمع آمدن آن‌ها (مردم) است، تا همه در کنار هم جمع شوند و پراکندگی برطرف شود."],[323,"مردم هنگامه افزون‌تر شود","کدیه و توزیع نیکوتر رود","وقتی جمعیت بیشتر می‌شود، مشکلات و ناهنجاری‌ها نیز افزایش می‌یابد، اما در عین حال توزیع و تقسیم برخوردهای خوب و مثبت نیز بهبود پیدا می‌کند."],[323,"جمع آمد صد هزاران ژاژخا","حلقه کرده پشت پا بر پشت پا","بسیاری از افراد دور هم جمع شده‌اند و به طور پراکنده و شلوغ صحبت می‌کنند، به‌طوری‌که هر یک روی پای دیگری ایستاده است."],[323,"مرد را از زن خبر نه ز ازدحام","رفته درهم چون قیامت خاص و عام","مرد به زن خبر ندارد و حال او را نمی‌داند، زیرا در میان این ازدحام و شلوغی، همه در هم ریخته‌اند و مانند روز قیامت که خاص و عام در آن به هم می‌خورد، هستند."],[323,"چون همی حراقه جنبانید او","می‌کشیدند اهل هنگامه گلو","وقتی آن مرد، که در اینجا به عنوان مارگیر معرفی شده است، مشعل را تکان داد، اهل جمعیت (مردم) تلاش می‌کردند تا او را از گلو بکشند و دور کنند."],[323,"و اژدها کز زمهریر افسرده بود","زیر صد گونه پلاس و پرده بود","اژدهایی که به خاطر سرما و سردی زمانه ضعیف و بی‌رمق شده بود، زیر انواع پوشش‌ها و پرده‌ها پنهان شده بود."],[323,"بسته بودش با رسن‌های غلیظ","احتیاطی کرده بودش آن حفیظ","او (مارگیر) با احتیاط و احتیاط کامل، اژدها را با ریسه‌های ضخیم و محکمی بسته بود تا از خطر آن در امان بماند."],[323,"در درنگ انتظار و اتفاق","تافت بر آن مار خورشید عراق","در زمان تأخیر و انتظار، نور خورشید عراق بر آن مار تابید."],[323,"آفتاب گرمسیر‌ش گرم کرد","رفت از اعضای او اخلاط سرد","خورشید گرم عراق، حرارت خود را بر اژدهایی که به نظر می‌رسید مرده است، تاباند و این موجب شد که رطوبت و اخلاط سرد در بدن او از بین برود."],[323,"مرده بود و زنده گشت او از شگفت","اژدها بر خویش جنبیدن گرفت","مار مرده‌ای که به تصور آن که زنده است، به کام شگفتی اژدها به خود جنبش می‌زند، دوباره به حیات برمی‌گردد."],[323,"خلق را از جنبش آن مرده مار","گشتشان آن یک تحیّر صد هزار","مردم به خاطر حرکت آن مار مرده، دچار حیرت و شگفتی شدند و این حیرت برایشان بسیار زیاد و عظیم بود."],[323,"با تحیر نعره‌ها انگیختند","جملگان از جنبشش بگریختند","مردم به خاطر حرکت آن مار مرده به وحشت افتادند و با شگفتی نعره زدند، به طوری که همه از حرکت آن می‌ترسیدند و فرار کردند."],[323,"می‌سکست او بند و زان بانگ بلند","هر طرف می‌رفت چاقاچاق بند","او (اژدها) بندها را پاره کرد و از آن صدا و هیاهو به هر سمتی که می‌رفت، بندها را با خود می‌کشید."],[323,"بندها بسکست و بیرون شد ز زیر","اژدهایی زشت غران همچو شیر","بندها پاره شد و زیر اژدهای زشت که مانند شیر غرش می‌کرد، بیرون آمد."],[323,"در هزیمت بس خلایق کشته شد","از فتاده کشتگان صد پشته شد","در زمان فرار، بسیاری از مردم کشته شدند و از این بابت بر روی کشته‌شدگان، توده‌های زیادی از آنها به وجود آمد."],[323,"مارگیر از ترس بر جا خشک گشت","که چه آوردم من از کهسار و دشت","مارگیر از بیم و وحشت به حالت خشکی درآمد و در تعجب است که چه چیزی را از کوه و دشت به همراه آورده است."],[323,"گرگ را بیدار کرد آن کور میش","رفت نادان سوی عزرائیل خویش","کرگدن که به‌خاطر نادانی با افتخاری به نزد عزرائیل (فرشته مرگ) می‌رود، در واقع خود را در مسیر خطر قرار می‌دهد. این واقعیت نشان‌دهنده سهل‌انگاری او در درک واقعیات و عواقب کارهایش است."],[323,"اژدها یک لقمه کرد آن گیج را","سهل باشد خون‌خوری حجیج را","در ابتدا باید گفت کلمه حجیج در مصرع دوم اشتباه است و حجاج درست است که از حاکمان اموی بود و در سالهای حکومتش به نقل تاریخ حدود ۱۲۰۰۰۰ نفر را سر برید و دشمنی خاص با شیعیان داشت. و شعر اینگونه ترجمه میشود که : اژدها مارگیر ساده لوح را یک لقمه کرد و برای کسی مثل حجاج خونخواری کاری آسان است"],[323,"خویش را بر استنی پیچید و بست","استخوان خورده را در هم شکست","استن در عربی به استخوان فک میگویند اما در اینجا به معنای استخوان مارگیر آمده است. مار خودش را به دور استخوان مارگیر پیچید و استخوان های طعمه اش را با فشار در هم شکست"],[323,"نفست اژدرهاست او کی مرده است‌؟","از غم و بی آلتی افسرده است","نفس انسان همچون اژدهایی است که گمان نمی‌رود مرده باشد؛ بلکه از غم و نداشتن ابزار و توانایی افسرده و کم‌توان شده است."],[323,"گر بیابد آلت فرعون، او","که به امر او همی‌رفت آب جو","اگر کسی ابزار فرعون (تسلط و قدرت) را پیدا کند، او که زیر فرمان او (فرعون) آب می‌برد، دوباره به قدرت و فساد باز می‌گردد."],[323,"آنگه او بنیاد فرعونی کند","راه صد موسی و صد هارون زند","او (فرعون) زمانی که قدرت و تسلط خود را به دست آورد، مانند فرعونی می‌شود که راه و روش‌های مختلف را برای ظلم و ستم بر بندگان پیش می‌گیرد و به نوعی مانند موسی و هارون، پیامبران که به دنبال نجات مردم از دست ظلم بودند، می‌زاید."],[323,"کرمک است آن اژدها از دست فقر","پشه‌ای گردد ز جاه و مال صقر","آن اژدهای نفس به خاطر فقر در خواب است والا پشه ای اگر مال و جاه یابد گمان میکند که باز شکاریست. صقر در عربی به معنی باز شکاریست"],[323,"اژدها را دار در برف فراق","هین مکش او را به خورشید عراق","اژدها را در برف فراق نگه‌دار و او را به خورشید عراق نکش، چون در میانه‌ دوری و جدایی است."],[323,"تا فسرده می‌بود آن اژدهات","لقمه اویی چو او یابد نجات","تا زمانی که آن اژدها سرد و بی‌حرکت است، به‌راستی لقمه‌ای از خوراک او محسوب می‌شود؛ اما وقتی که او نجات یابد، خطرناک می‌شود."],[323,"مات کن او را و ایمن شو ز مات","رحم کم کن نیست او ز اهل صلات","او را مدهوش کن و از مدهوشی او راحت باش، زیرا که به او رحم نکن، چون او از اهل نماز و عبادت نیست."],[323,"کان تف خورشید شهوت برزند","آن خفاش مردریگت پر زند","اولا در اینجا به نظر می‌رسد مردریگ اشتباه است و کلمه درست تا جایی که به ذهن کوچک من می‌رسد مرده ریقت است. مثل همان جمله معروف ما که میگوییم فلانی ریق رحمت را سر کشید. پس شعر اینگونه میشود: اگر حرارت شهوات به جانت راه پیدا کند، نفس ات که مانند خفاشی مرده است به پرواز درمیاید"],[323,"می‌کشانش در جهاد و در قتال","مردوار الله یجزیک الوصال","مردی که اژدها را به بغداد آورد، او را به جنگ و نبرد می‌برد و در این راه دعا می‌کند که خداوند به او پاداش وصال (وصل به خدا) عطا کند."],[323,"چونک آن مرد اژدها را آورید","در هوای گرم خوش شد آن مرید","وقتی آن مرد اژدها را به هوای گرم برد، مرید خوشحال شد و حالش بهتر شد."],[323,"لاجرم آن فتنه‌ها کرد ای عزیز","بیست همچندان که ما گفتیم نیز","پس از آن، ای عزیز، آن آشوب‌ها و فتنه‌ها به وجود آمد، به همان اندازه و اصلی که ما قبلا توضیح دادیم."],[323,"تو طمع داری که او را بی جفا","بسته داری در وقار و در وفا","تو خواستار این هستی که بدون اینکه او از کنترل تو خارج شود یا به تو آسیبی برساند، او را به خودت وفادار و آرام نگه داری اما چنین خواسته ای در مورد او ناممکن است."],[323,"هر خسی را این تمنی کی رسد‌؟","موسیی باید که اژدرها کشد","این حرف‌ها را هر بی‌خود و بی‌منطق نمی‌تواند بزند، بلکه باید کسی مثل موسی باشد که توانایی مواجهه با اژدها را داشته باشد."],[323,"صد‌هزاران خلق ز اژدرهای او","در هزیمت کشته شد از رای او","به خاطر نقشه‌های نادرست و تصمیمات اشتباه او، صدها هزار نفر از مردم به دست اژدهای او، یعنی خطرات ناشی از او، در حال فرار و مرگ قرار گرفتند."],[324,"گفت فرعونش چرا تو ای کلیم","خلق را کشتی و افکندی تو بیم","فرعون به موسی می‌گوید: چرا ای پیامبر (کلیم) مردم را می‌کشی و آن‌ها را به ترس و وحشت می‌اندازی؟"],[324,"در هزیمت از تو افتادند خلق","در هزیمت کشته شد مردم ز زلق","مردم به خاطر ترس و شکست از تو عقب‌نشینی کردند و در این عقب‌نشینی عده‌ای از آن‌ها به دست زلق (مرغابی) کشته شدند."],[324,"لاجرم مردم تو را دشمن گرفت","کین تو در سینه مرد و زن گرفت","پس از رفتارهای ظالمانه‌ات، به ناچار مردم علیه تو دشمنی کردند و کینه‌ات در دل مردان و زنان رسوخ کرد."],[324,"خلق را می‌خواندی بر عکس شد","از خلافت مردمان را نیست بد","تو مردم را به سوی خود دعوت می‌کردی، اما نتیجه برعکس شد و از خلافت تو بیزار شدند، زیرا مردم از تو راضی نیستند."],[324,"من هم از شرت اگر پس می‌خزم","در مکافات تو دیگی می‌پزم","اگر من هم از شر تو فرار کنم، در عوض خداوند برای تو عذاب و کیفر سختی می‌سازد."],[324,"دل ازین بر کن که بفریبی مرا","یا به جز فی پس‌روی گردد تو را","دل را از خدعه‌ات رها کن؛ زیرا اگر به من دروغ بگویی، خودت هم به عقب برمی‌گردی و به نتیجه‌ای نخواهی رسید."],[324,"تو بدان غره مشو کش ساختی","در دل خلقان هراس انداختی","به خودت مغرور نشو که با فریب و تهدید، در دل مردم ترس انداخته‌ای."],[324,"صد چنین آری و هم رسوا شوی","خوار گردی ضحکه غوغا شوی","هرچقدر هم که بخواهی اینگونه به فریبکاری ادامه دهی، در نهایت رسوا خواهی شد و به کسی مضحکه و مورد تمسخر دیگران تبدیل خواهی گردید."],[324,"همچو تو سالوس بسیاران بدند","عاقبت در مصر ما رسوا شدند","همان‌طور که تو آدم فریبی، افراد زیادی نیز قبل از تو همین‌طور بوده‌اند، اما در نهایت همه آن‌ها در مصر رسوا شدند."],[325,"گفت با امر حقم اشراک نیست","گر بریزد خونم امرش، باک نیست","موسی می‌گوید که با فرمان خداوند هیچ چیزی را شریک نمی‌دانم و اگر خونم نیز به خاطر او ریخته شود، هیچ ترسی ندارم."],[325,"راضیم من شاکرم من ای حریف","این طرف رسوا و پیش حق شریف","من از شرایط موجود راضی و شکرگزارم، ای هم‌نشین؛ حتی اگر در این دنیا ننگین باشم، در برابر حق (خدا) محبوب و محترم هستم."],[325,"پیش خلقان خوار و زار و ریش‌خند","پیش حق محبوب و مطلوب و پسند","در پیش نظر مردم، ذلیل و خوار و مورد تمسخر هستم، اما در برابر خداوند، محبوب و مورد پسند و خواستار هستم."],[325,"از سخن می‌گویم این ورنه خدا","از سیه‌رویان کند فردا تو را","من از کلام خودم صحبت می‌کنم، زیرا خداوند در آینده به چهره‌های زشت و ناپسند پاداش خواهد داد."],[325,"عزت آن اوست و آن بندگانش","ز آدم و ابلیس بر می‌خوان نشانش","عزت و مقام واقعی متعلق به خداوند است و بندگان او، که شامل آدم و ابلیس می‌شوند، همگی نشان‌دهنده‌ی این مقام‌اند."],[325,"شرح حق پایان ندارد همچو حق","هین دهان بربند و برگردان ورق","معرفت و حقیقت خداوند هیچ‌گاه تمام نمی‌شود و همچون ذات او بی‌پایان است؛ بنابراین بهتر است سخن را باز نکنید و از سر جهل و نادانی چیزی نگویید یا ننویسید."],[326,"گفت فرعونش ورق درحکم ماست","دفتر و دیوان حکم این دم مراست","فرعون گفت: ورق (یعنی نوشته یا فرمان) در دست ماست و ما بر اینجا فرمانروایی می‌کنیم و تصمیم ما در این لحظه، بر همه چیز حاکم است."],[326,"مر مرا بخریده‌اند اهل جهان","از همه عاقلتری تو ای فلان","ای فرعون، اهل جهان مرا خریده‌اند و به همین خاطر از تو عاقل‌تر هستند، تو چه کسی هستی؟"],[326,"موسیا خود را خریدی هین برو","خویشتن کم بین، به خود غره مشو","ای موسی، تو هم خود را در نظر نگیر و به خود ببالید، چرا که تو هم خریداری شده‌ای. به خودت مغرور نشو."],[326,"جمع آرم ساحران دهر را","تا که جهل تو نمایم شهر را","من در این دنیا جادوگران زمان را جمع می‌کنم تا به تو نشان دهم که چقدر نادانی و جهل تو آشکار است."],[326,"این نخواهد شد به روزی و دو روز","مهلتم ده تا چهل روز تموز","این اتفاق در مدت کوتاه و کم‌مدت ممکن نیست و از من درخواست مهلت بیشتری دارم، حداقل تا چهل روز تابستان."],[327,"گفت موسی این مرا دستور نیست","بنده‌ام امهال تو مامور نیست","موسی می‌گوید: این کار برای من نیست که به تو اجازه بدهم، من بنده هستم و مأموریتی از طرف تو ندارم."],[327,"گر تو چیری و مرا خود یار نیست","بنده فرمانم بدانم کار نیست","اگر تو کار بزرگی را انجام بدهی و من یاری نداشته باشم، به عنوان یک بنده، می‌دانم که چنین کاری از من برنمی‌آید."],[327,"می‌زنم با تو بجد تا زنده‌ام","من چه کاره نصرتم من بنده‌ام","من با تو به شدت می‌جنگم تا زمانی که زنده‌ام؛ من چه مقامی در نصرت و یاری دارم، من فقط بنده‌ام."],[327,"می‌زنم تا در رسد حکم خدا","او کند هر خصم از خصمی جدا","من به مبارزه ادامه می‌دهم تا زمانی که اراده خداوند محقق شود و او هر دشمنی را از دیگری جدا کند."],[328,"گفت نه نه مهلتم باید نهاد","عشوه‌ها کم ده، تو کم پیمای باد","موسی می‌گوید که نه، من باید فرصت بیشتری داشته باشم؛ پس از تو خواهش می‌کنم که روش‌های فریبنده‌ات را کم کن، زیرا تو فقط به دنبال اینی که مرا از هدفم بازداری."],[328,"حق تعالی وحی کردش در زمان","مهلتش ده متسع مهراس از آن","خداوند به موسی علیه‌السلام وحی کرد که در زمان مهلتی که برایش مشخص شده، نگران نباشد و از هیچ چیز نترسد."],[328,"این چهل روزش بده مهلت بطوع","تا سگالد مکرها او نوع نوع","چهل روز به او فرصت بده تا بتواند به تنک‌تر و با لطافتی جدید بزند."],[328,"تا بکوشد او که نی من خفته‌ام","تیز رو گو پیش ره بگرفته‌ام","او (موسی) باید تلاش کند و نگوید که من در حال استراحت هستم؛ به تندی بگوید که در مسیر درست پیشرفت کرده‌ام."],[328,"حیله‌هاشان را همه برهم زنم","و آنچ افزایند من بر کم زنم","من تمام تدبیرهای آن‌ها را خراب می‌کنم و حتی اگر آن‌ها چیزهایی به دست آورند، من آن را کاهش می‌دهم."],[328,"آب را آرند من آتش کنم","نوش و خوش گیرند و من ناخوش کنم","مردم تلاش می‌کنند تا آب (آرامش و زندگی) را به دست آورند، اما من آن را به آتش (نقص و مشکل) تبدیل می‌کنم. آنها چیزهای خوب و خوشایند را جمع می‌کنند، در حالی که من آنها را ناخوشایند می‌سازم."],[328,"مهر پیوندند و من ویران کنم","آنک اندر وهم نارند آن کنم","مردم با عشق و محبت به هم پیوسته‌اند، ولی من می‌توانم این پیوندها را نابود کنم. آنچه در خیال آدمی وجود دارد، من می‌توانم به آن آسیب برسانم."],[328,"تو مترس و مهلتش ده دم‌دراز","گو سپه گرد آر و صد حیلت بساز","نگران نباش و به او فرصت بده تا درنگ کند، بگو سپاهیان را جمع کند و نقشه‌های زیادی تدارک ببیند."],[329,"گفت امر آمد برو مهلت تو را","من بجای خود شدم رستی ز ما","موسی گفت: «حالا که مسأله روشن شده، به تو مهلتی می‌دهم، اما من به جای خودم به کار ادامه می‌دهم و از تو فاصله می‌گیرم."],[329,"او همی‌شد و اژدها اندر عقب","چون سگ صیاد دانا و محب","فرعون به مانند یک اژدها در حال عقب‌نشینی است، همان‌طور که یک سگ صیاد با محبت و دانایی خود در پی شکارش حرکت می‌کند."],[329,"چون سگ صیاد جنبان کرده دم","سنگ را می‌کرد ریگ او زیر سم","موسی علیه‌السلام مانند سگی صیاد دم خود را تکان می‌دهد و سنگ را به حرکت می‌آورد، به گونه‌ای که زیر پای فرعونیان، ریگ و خاک پراکنده می‌شود."],[329,"سنگ و آهن را به‌دم در می‌کشید","خرد می‌خایید آهن را پدید","موسی علیه‌السلام می‌دید که سنگ و آهن را به‌دست خود می‌کشید و با خرد و تدبیر خود، آهن را به شکل‌هایی در می‌آورد."],[329,"در هوا می‌کرد خود بالای برج","که هزیمت می‌شد از وی روم و گرج","فرعون در بالای برج‌ای ایستاده بود و در آسمان پرواز می‌کرد، به‌گونه‌ای که از ترس او، رومی‌ها و گرجی‌ها فرار می‌کردند."],[329,"کفک می‌انداخت چون اشتر ز کام","قطره‌ای بر هر که زد می‌شد جذام","او (فرعون) مانند شتری که در آب می‌افتد، دهانش را به آب می‌زند و به هرکسی که نزد او می‌آید، از دهانش آبی می‌ریزد؛ این کار باعث می‌شود که آن فرد مبتلا به جذام (بیماری پوستی) شود."],[329,"ژغژغ دندان او دل می‌شکست","جان شیران سیه می‌شد ز دست","صدای ناهنجار دندان او دل را می‌شکست و جان شیران سیاه از دست او در عذاب می‌شد."],[329,"چون به قوم خود رسید آن مجتبی","شدق او بگرفت باز او شد عصا","هنگامی که موسی علیه‌السلام به قوم خود رسید، به طور معجزه‌آسا عصایش را گرفت و به حالت عصا تبدیل شد."],[329,"تکیه بر وی کرد و می‌گفت ای عجب","پیش ما خورشید و پیش خصم شب","موسی به عصای خود تکیه کرد و حیرت‌زده گفت که عجب است، زیرا در برابر ما خورشید (منظور، روشنایی و حق است) است و در مقابل دشمنان ما، شب (تاریکی و ناحقیقت) قرار دارد."],[329,"ای عجب چون می‌نبیند این سپاه","عالمی پر آفتاب چاشتگاه","عجب است که چگونه این سپاه را می‌بیند، در حالی که روز روشن و پرنور است، انگار دنیایی پر از آفتاب در چاشتگاه (زمان اوج روز) است."],[329,"چشم باز و گوش باز و این ذکا","خیره‌ام در چشم‌بندی خدا","من در حالی که چشمانم باز و گوش‌هایم شنواست، به وضوح در زیبایی و شگفتی‌های آفرینش خدا غرق شده‌ام و از جاذبه‌های آن حیرت‌زده‌ام."],[329,"من ازیشان خیره ایشان هم ز من","از بهاری خار ایشان، من سمن","من به کار آنها خیره شدم آنها از من ولی آنها مثل خار هستند در بهار پرگل ولی من گل هستم ."],[329,"پیششان بردم بسی جام رحیق","سنگ شد آبش به پیش این فریق","من به جمعی از آن‌ها، جامی پر از شراب خوش طعم بردم، اما آن شراب به قدری سنگین و غلیظ شد که به درد این گروه نمی‌خورد."],[329,"دسته گل بستم و بردم به پیش","هر گلی چون خار گشت و نوش نیش","من به جمعی از عزیزان هدیه‌ای زیبا آوردم، اما عشق و محبت آنها چنان با مشکل و تلخی (مانند خار) همراه شد که شیرینی آن را (مانند نوش) به زهر تبدیل کرد."],[329,"آن نصیب جان بی‌خویشان بود","چونک با خویش‌اند پیدا کی شود","خود را از دیگران جدا نکنید، چون که حقی که به شما تعلق دارد، تنها زمانی قابل دسترسی است که با دیگران رابطه داشته باشید؛ بنابراین، وقتی با خودتان هستید، آن حقیقت را نمی‌توانید پیدا کنید."],[329,"خفته بیدار باید پیش ما","تا به بیداری ببیند خوابها","کسی که در خواب به سر می‌برد، باید در حضور ما بیدار شود تا در بیداری بتواند خواب‌هایش را ببیند و درک کند."],[329,"دشمن این خواب خوش شد فکر خلق","تا نخسپد فکرتش بستست حلق","دشمن این خواب خوش که مردم در آن غرق شده‌اند، فکری است که از آنها دور است و اگر فکرشان به خواب برود، تفکر آنها به طرزی محدود می‌شود."],[329,"حیرتی باید که روبد فکر را","خورده حیرت فکر را و ذکر را","حیرت و شگفتی وجود دارد که فکر را در خود فرو برده و باعث شده ذکر و یاد خدا از آن گرفته شود."],[329,"هر که کاملتر بود او در هنر","او به معنی پس، به صورت پیشتر","هر کس در هنر کامل‌تر باشد، فهم و معنی‌اش نسبت به دیگران بیشتر است و در ظاهر نیز بهتر و برجسته‌تر به نظر می‌رسد."],[329,"راجعون گفت و رجوع این سان بود","که گله وا گردد و خانه رود","موسی علیه‌السلام با گفتن «راجعون» یعنی به سوی ما برگردید، به فرعون و پیروانش اشاره می‌کند که مانند گله‌ای هستند که باید برگردند و به خانه خود بروند."],[329,"چونک واگردید گله از ورود","پس فتد آن بز که پیش آهنگ بود","زمانی که گله در حال بازگشت باشد و به خاطر این بازگشت، بز پیشرو که جلوتر بود، به سمت عقب می‌افتد."],[329,"پیش افتد آن بز لنگ پسین","اضحک الرجعی وجوه العابسین","در این بیت، اشاره به بز لنگی است که در انتهای رده قرار دارد و به عنوان نمادی از افرادی که به عقب برگشته‌اند و از شکست و ناکامی دیگران خوشحالند، دیده می‌شود. این تصویر نشان‌دهنده فضایی است که در آن افراد ناامید و عبوس با نگاهی تمسخرآمیز نسبت به دیگران رفتار می‌کنند."],[329,"از گزافه کی شدند این قوم لنگ","فخر را دادند و بخریدند ننگ","این گروه لنگ و ضعیف از چه سبب به خود جسارت می‌دهند؟ آنها فخر و سربلندی را به دست آوردند، اما در عوض، ننگ و خفت را خریدند."],[329,"پا شکسته می‌روند این قوم حج","از حرج راهیست پنهان تا فرج","این گروه که دچار ضعف و ناتوانی هستند، بدون توجیه مناسب به سوی حج می‌روند. راهی که در پیش دارند، پنهانی و غیرمستقیم است و امیدی به رهایی و نجات در آن نهفته است."],[329,"دل ز دانشها بشستند این فریق","زانک این دانش نداند آن طریق","این گروه، دلشان را از دانش‌های مختلف خالی کردند، زیرا این دانش، راه رستگاری را نمی‌داند."],[329,"دانشی باید که اصلش زان سرست","زانک هر فرعی به اصلش رهبرست","دانشی باید وجود داشته باشد که ریشه‌اش از آن سر باشد، زیرا هر چیزی که فرعی است، به ریشه‌اش متصل می‌شود و هدایت می‌شود."],[329,"هر پری بر عرض دریا کی پرد","تا لدن علم لدنی می‌برد","هر پری (نوعی موجود خیالی و زیبا) که بر سطح دریا پرواز می‌کند، وقتی که به سمت سرازیر می‌شود، علم لدنی (علمی که از سوی خدا به فرد داده می‌شود) را با خود می‌برد."],[329,"پس چرا علمی بیاموزی به مرد","کش بباید سینه را زان پاک کرد","چرا باید علمی را یاد بگیری که برای مردی که می‌خواهی به او آموزش بدهی، لازم است صداقتی در دلش وجود داشته باشد و قلبش را از پلیدی‌ها پاک کند؟"],[329,"پس مجو پیشی ازین سر لنگ باش","وقت وا گشتن تو پیش آهنگ باش","پس سراغ نزن که بر دیگران پیشی بگیری و در رأس قرار بگیری، بلکه در زمان بازگشت و تغییرات، سعی کن همراه و هماهنگ با دیگران باشی."],[329,"آخرون السابقون باش ای ظریف","بر شجر سابق بود میوه طریف","ای ظریف، مانند میوه‌ای که از درختی پر بار پیشی گرفته، تو هم باید از کسانی باشی که در کارهای خوب و معنوی پیشتاز هستند. همان‌طور که میوه تازه‌تر، به درختی که قبل‌تر برکاتش را داده، تعلق دارد."],[329,"گرچه میوه آخر آید در وجود","اولست او زانک او مقصود بود","هرچند میوه در انتها و در پایان زمان به بار می‌آید، اما در واقع، وجود او (میوه) از ابتدا مقصد و هدف بوده است."],[329,"چون ملایک گوی لا علم لنا","تا بگیرد دست تو علمتنا","ملائکه (فرشتگان) می‌گویند که ما هیچ دانشی نداریم مگر اینکه تو (خداوند) به ما بیاموزی. اشاره به این است که اراده و علم خداوند، معیار اصلی است و موجودات غیر از خدا نمی‌توانند بدون خواست او دانشی داشته باشند."],[329,"گر درین مکتب ندانی تو هجا","همچو احمد پری از نور حجی","اگر در این مکتب (علم و دین) نتوانی هجا (الفاظ و کلمات) را بدانی، مانند احمد (پیامبر اسلام) و درخشش نور او (حسنات و فضایل او) نخواهی بود."],[329,"گر نباشی نامدار اندر بلاد","گم نه‌ای الله اعلم بالعباد","اگر در میان مردم مشهور و معروف نباشی، باید بدان که خداوند به بندگانش از همه چیز آگاه‌تر است."],[329,"اندر آن ویران که آن معروف نیست","از برای حفظ گنجینه زریست","در آن ویرانی که شناخته شده نیست، برای محافظت از گنجینه طلا باید اقدام کرد."],[329,"موضع معروف کی بنهند گنج","زین قبل آمد فرج در زیر رنج","محل معروفی که باید گنج در آن گذاشته شود، کجاست؟ پیش از این، فرجی که در زیر رنج به‌دست می‌آید، به ما رسیده است."],[329,"خاطر آرد بس شکال اینجا ولیک","بسکلد اشکال را استور نیک","در اینجا اشاره به این است که اگرچه ما به خاطر مسائلی که در این مکان وجود دارد، زیاد فکر و خیال می‌کنیم، ولی باید به یاد داشته باشیم که موضوعات و مشکلاتی که در ذهنتان است، در واقع، به خوبی می‌تواند حل شود. واضح است که افکار و خیالات ما در اینجا زیادند، اما باید به راه حل‌های مناسب و نیکو نیز توجه داشت."],[329,"هست عشقش آتشی اشکال‌سوز","هر خیالی را بروبد نور روز","عشق او مانند آتشی است که هر شکلی را می‌سوزاند و تنها روشنایی روز می‌تواند آن را پاک کند."],[329,"هم از آن سو جو جواب ای مرتضا","کین سؤال آمد از آن سو مر تو را","از آن طرف، ای مرتضی (علی علیه‌السلام)، جواب سؤال را بگیر، زیرا این سؤال از آن سمت به تو رسیده است."],[329,"گوشه بی گوشه دل شه‌رهیست","تاب لا شرقی و لا غرب از مهیست","دل بی‌گوشه و گوشه‌نشین تو، شایسته‌ی کشف حقایق و اسرار است. نظیر دلی است که از نور ماه (حقیقت) روشن شده و نه متعلق به شرق است و نه به غرب، بلکه در جستجوی دیاری بی‌مرز و فراتر از محدوده‌های زمان و مکان است."],[329,"تو ازین سو و از آن سو چون گدا","ای که معنی چه می‌جویی صدا","تو از این طرف و آن طرف مانند یک گدا چه چیزی را به دنبال معنی جستجو می‌کنی؟"],[329,"هم از آن سو جو که وقت درد تو","می‌شوی در ذکر یا ربی دوتو","در زمان بروز مشکلات و دردهای زندگی، به یاد خداوند و نام او به طور مداوم باش و در سختی‌ها از او کمک بخواه."],[329,"وقت درد و مرگ آن سو می‌نمی","چونک دردت رفت چونی اعجمی","زمانی که در درد و مرگ قرار گرفتی، نمی‌توانی در آن سوی خود بگویی چه حالتی داری، زیرا وقتی دردت رفع می‌شود، از آن حالت می‌گذری و نمی‌دانی که حال درددل کردن چگونه است."],[329,"وقت محنت گشته‌ای الله گو","چونک محنت رفت گویی راه کو","زمانی که در سختی و مشکلات هستی، خدا را صدا می‌زنی؛ اما وقتی مشکلات رفتند، گویی که راه خدا را گم کرده‌ای."],[329,"این از آن آمد که حق را بی گمان","هر که بشناسد بود دایم بر آن","هر کسی که به راستی خداوند را بشناسد، به‌طور دائم و بدون تردید در ایمان و عقیده خود ثابت و پایدار خواهد بود."],[329,"وانک در عقل و گمان هستش حجاب","گاه پوشیدست و گه بدریده جیب","در عقل و گمان، حجاب و پرده‌ای وجود دارد که گاهی آن را می‌پوشاند و گاهی آن را کنار می‌زند."],[329,"عقل جزوی گاه چیره گه نگون","عقل کلی آمن از ریب المنون","عقل شخصی (عقل جزوی) در برخی مواقع بر عقل کل (عقل کلی) غالب می‌شود و در زمان‌هایی دیگر، این عقل کل است که از تردیدها و نابودی مصون است."],[329,"عقل بفروش و هنر حیرت بخر","رو به خواری، نه بخارا ای پسر","به جای اینکه عقل محدود و دست و پاگیر را در اختیار داشته باشی، خلاقیت و هنر جادویی را بخر که تو را به حیرت و شگفتی می‌برد. در این راه، به خود اذیت نرسان و از مقام والای خود کناره‌گیری کن، ای پسر."],[329,"ما چه خود را در سخن آغشته‌ایم","کز حکایت ما حکایت گشته‌ایم","ما خود را در سخن آمیخته‌ایم و به همین دلیل حکایت‌ ما به داستانی تبدیل شده است."],[329,"من عدم و افسانه گردم در حنین","تا تقلب یابم اندر ساجدین","من در حنین، یعنی در حالتی از عدم و خیال، به داستانی شبیه می‌شوم تا بتوانم در میان سجودکنندگان تقلب کنم و دست به کارهایی بزنم."],[329,"این حکایت نیست پیش مرد کار","وصف حالست و حضور یار غار","این داستان، حکایت نیست، بلکه توصیف حال و حضور یار است، که می‌تواند اشاره به حضرت محمد (یار غار) و مقام او داشته باشد. در واقع، مولانا به اهمیت و معنای عمیق این تجربیات اشاره می‌کند."],[329,"آن اساطیر اولین که گفت عاق","حرف قرآن را بد آثار نفاق","اساطیر و داستان‌های باستانی که گفته‌اند، سخنان عاق و ناپسند قرآن را بر جای می‌گذارد و نشان‌دهنده‌ی نفاق است."],[329,"لامکانی که درو نور خداست","ماضی و مستقبل و حال از کجاست","جایی که نور خداوند حضور دارد، مفهوم زمان (گذشته، آینده و حال) چه معنایی دارد؟"],[329,"ماضی و مستقبلش نسبت به تست","هر دو یک چیزند پنداری که دوست","زمان (ماضی و مستقبل) در نظر دوست، هیچ تفاوتی ندارد و هر دو به یکسان به او مربوط می‌شوند."],[329,"یک تنی او را پدر ما را پسر","بام زیر زید و بر عمرو آن زبر","در این بیت مولانا به این نکته اشاره می‌کند که در واقع ما به یک حقیقت مشترک هستیم؛ پدر خود را از جایی پایین‌تر از زید و بالا‌تر از عمرو می‌دانیم، در حالی که در پیوندهای عاطفی و خانوادگی، این دیدگاه‌ها نسبت به یکدیگر تفاوتی ندارند."],[329,"نسبت زیر و زبر شد زان دو کس","سقف سوی خویش یک چیزست بس","نسبت زیر و زبر در این بیت اشاره به دو حالت مختلف دارد که در واقع نشان‌دهنده‌ی تفاوت‌های ظاهری و باطنی است. به عبارت دیگر، در حالی که دو نفر می‌توانند در ظاهر متفاوت باشند، در باطن هر دو به یک حقیقت یا اصل واحد مرتبط‌اند."],[329,"نیست مثل آن مثالست این سخن","قاصر از معنی نو حرف کهن","این سخن شبیه به آن مثل است که توانایی بیان کامل معنا را ندارد و تنها یک حرف قدیمی را تکرار می‌کند."],[329,"چون لب جو نیست مشکا لب ببند","بی لب و ساحل بدست این بحر قند","وقتی دریا به لب ساحل نزدیک نیست، نباید ظرف آب را پر کرد؛ زیرا اگر چنین کنی، ظرفی بدون لب و ساحل آب نمی‌تواند روی این دریا که شیرین و قندگونه است، باقی بماند."],[330,"چونک موسی بازگشت و او بماند","اهل رای و مشورت را پیش خواند","موسی به مصر برگشت و فرعون (که در اینجا اهل رای و مشورت) را به حضور طلبید."],[330,"آنچنان دیدند کز اطراف مصر","جمع آردشان شه و صراف مصر","مردم از اطراف مصر چنین دیدند که پادشاه و صراف مصر برای جمع‌آوری جادوگران به‌دنبال آن‌ها هستند."],[330,"او بسی مردم فرستاد آن زمان","هر نواحی بهر جمع جادوان","فرعون در آن زمان به تعداد زیادی از مردم خود دستور داد تا به نقاط مختلف بروند و جادوگران را جمع‌آوری کنند."],[330,"هر طرف که ساحری بد نامدار","کرد پران سوی او ده پیک کار","فرعون در هر طرف که ساحری معروف بود، افرادی را برای آوردن او فرستاد تا به سوی او بروند و کار او را انجام دهند."],[330,"دو جوان بودند ساحر مشتهر","سحر ایشان در دل مه مستمر","دو جوان بودند که در کار سحر معروف و مشهور بودند و سحرهای آنها همیشه در دل مردم تأثیر می‌گذاشت."],[330,"شیر دوشیده ز مه فاش آشکار","در سفرها رفته بر خمی سوار","در این بیت گفته شده که ماه، مانند شیری از آسمان دوشیده شده و به روشنی مشاهده می‌شود. ماه در سفرها بر قوسی (خمی) سوار شده که نماد زیبایی و جاذبه‌اش است."],[330,"شکل کرباسی نموده ماهتاب","آن بپیموده فروشیده شتاب","ماهتاب (که اشاره به نور و زیبایی ماه دارد) شکل و ظاهری کرباسی پیدا کرده و در این سفر به سرعت پیشرفت کرده و به جایی رسیده است."],[330,"سیم برده مشتری آگه شده","دست از حسرت به رخها بر زده","سیم (نقره) را گرفته و از دلالی آگاه شده است و حسرتش را بر صورت‌ها واگذار کرده است."],[330,"صد هزاران همچنین در جادوی","بوده منشی و نبوده چون روی","بسیاری از افراد در فن جادوگری دارای مهارت هستند، اما هیچ‌یک از آنها همچون منشی (نویسنده یا دفتریار) که حقیقت جادو را می‌داند، وجود ندارد و نمی‌تواند در برابر او قرار گیرد."],[330,"چون بدیشان آمد آن پیغام شاه","کز شما شاهست اکنون چاره‌خواه","فرعون به ساحران پیامی فرستاد که چون این پیام به شما رسید، بدانید که شاه به کمک شما نیاز دارد."],[330,"از پی آنک دو درویش آمدند","بر شه و بر قصر او موکب زدند","دو درویش به دنبال پیامی آمدند و در مقابل شاه و قصر او تجمع کردند."],[330,"نیست با ایشان به غیر یک عصا","که همی‌گردد به امرش اژدها","ساحران تنها یک عصا با خود دارند که با فرمان آن عصا، تبدیل به اژدها می‌شود."],[330,"شاه و لشکر جمله بیچاره شدند","زین دو کس جمله به افغان آمدند","شاه و نیروهایش از وحشت و ترس ناشی از دو ساحر به شدت دچار ناامیدی و پریشانی شدند و همه به یکباره به فریاد درآمدند."],[330,"چاره‌ای می‌باید اندر ساحری","تا بود که زین دو ساحر جان بری","برای آنکه از دست این دو ساحر نجات یابیم، حتما باید راه‌حلی در زمینه جادو و ساحری پیدا کنیم."],[330,"آن دو ساحر را چو این پیغام داد","ترس و مهری در دل هر دو فتاد","وقتی فرعون این پیغام را به آن دو ساحر رساند، در دل هر دو ترس و محبت نسبت به او ایجاد شد."],[330,"عرق جنسیت چو جنبیدن گرفت","سر به زانو بر نهادند از شگفت","وقتی عرق جنسیت (یعنی احساس شهوت و تمایل جنسی) در وجود آن‌ها شدت می‌گیرد، از شدت حیرت و تعجب، سر خود را به زانو می‌گذارند."],[330,"چون دبیرستان صوفی زانوست","حل مشکل را دو زانو جادوست","بخشی از سیر و سلوک صوفی ، توجه و مراقبه است و حل مشکلات را در این راه با اظهار عجز و ناتوانی در مقابل پرودگار می داند، دو زانو نشستن به معنای پرستش است که می داند پس از آن همچون جادویی کارها سامان پیدا می کند."],[331,"بعد از آن گفتند ای مادر بیا","گور بابا کو، تو ما را ره نما","پس از آن دو ساحر از مادر خواسته‌اند که به آن‌ها نشان دهد گور پدرشان کجاست تا آن‌ها را راهنمایی کند."],[331,"بردشان بر گور او بنمود راه","پس سه‌روزه داشتند از بهر شاه","آن دو ساحر، پدرشان را به گور بردند و راه را به آن‌ها نشان دادند. پس از سه روز، به منظور یافتن پیام شاه، در جستجوی او بودند."],[331,"بعد از آن گفتند ای بابا به ما","شاه پیغامی فرستاد از وجا","دو ساحر به پدر موسی گفتند که شاه (فرعون) پیامی برای ما فرستاده است."],[331,"که دو مرد او را به تنگ آورده‌اند","آب رویش پیش لشکر برده‌اند","دو مرد موسی را به شدت تحت فشار قرار داده‌اند و آبرو و حیثیت او را در برابر لشکر از بین برده‌اند."],[331,"نیست با ایشان سلاح و لشکری","جز عصا و در عصا شور و شری","با این دو نفر (ساحران) نه سلاحی دارند و نه لشکری، تنها ابزارشان عصاست و در آن عصا نیرویی و شوری وجود دارد."],[331,"تو جهان راستان در رفته‌ای","گرچه در صورت به خاکی خفته‌ای","تو به عالم راستین و حقیقت پیوسته‌ای، هرچند که در ظاهر به خواب عمیق در خاک رفته‌ای."],[331,"آن اگر سحرست ما را ده خبر","ور خدایی باشد ای جان پدر","اگر آنچه می‌گویید سحر است، پس به ما خبر بدهید، و اگر حقیقتا خدایی در کار است، ای جان پدر."],[331,"هم خبر ده تا که ما سجده کنیم","خویشتن بر کیمیایی بر زنیم","خبر بده تا ما سجده کنیم و خود را بر کیمیایی (طلا) بیفزاییم."],[331,"ناامیدانیم و اومیدی رسید","راندگانیم و کرم ما را کشید","ما از آن دسته افرادی هستیم که به همه چیز ناامیدیم، اما امیدی به ما رسیده است. در عین حال، کسانی که از نزد ما رفته‌اند، به سبب رحمت و لطف خدا به سوی ما بازگشته‌اند."],[332,"گفتشان در خواب کای اولاد من","نیست ممکن ظاهر این را دم زدن","او در خواب به فرزندانش گفت که امکان ندارد این موضوع را به روشنی بیان کند."],[332,"فاش و مطلق گفتنم دستور نیست","لیک راز از پیش چشمم دور نیست","گفتن حقیقت به‌طور مستقیم و آشکار کار آسانی نیست، اما من از پیش می‌دانم که چه رازی وجود دارد و آن را در ذهن دارم."],[332,"لیک بنمایم نشانی با شما","تا شود پیدا شما را این خفا","اما من یک نشانه به شما می‌نمایم تا شما این راز پنهان را بهتر بشناسید و برایتان روشن شود."],[332,"نور چشمانم چو آنجا گه روید","از مقام خفتنش آگه شوید","چشم‌های من مانند نوری است که وقتی به آن مکان می‌رسد، شما را از خواب و حالت خفتگی‌تان آگاه می‌سازد."],[332,"آن زمان که خفته باشد آن حکیم","آن عصا را قصد کن بگذار بیم","زمانی که آن حکیم (ساحر) خواب است، می‌توانی به عصای او نزدیک شوی و بدون ترس آن را برمی‌دارید."],[332,"گر بدزدی و توانی ساحرست","چاره ساحر بر تو حاضرست","اگر بتوانی دزدی کنی، به نوعی ساحری هستی، زیرا چاره ساحر (فریبکار) برای تو حاضر و آماده است."],[332,"ور نتانی هان و هان آن ایزدیست","او رسول ذوالجلال و مهتدیست","اگر نمی‌توانی به او نزدیک شوی، بدان که او خود پیامبر خداوند است و هدایت‌گر مومنان و بزرگوار است."],[332,"گر جهان فرعون گیرد شرق و غرب","سرنگون آید خدا آنگاه حرب","اگر همه جهان مانند فرعون (با استکبار) شود و شرق و غرب را به نابودی بکشاند، در آن صورت، خداوند خواهد آمد و جنگی به پا خواهد کرد."],[332,"این نشان راست دادم جان باب","بر نویس الله اعلم بالصواب","من نشان واقعی را به فرزندانم دادم که جان پدر را بنویسند «خدا به حقیقت داناتر است»."],[332,"جان بابا چون بخسپد ساحری","سحر و مکرش را نباشد رهبری","زمانی که جان پدری (بابا) بخوابد (یعنی برود)، دیگر سحر و فریب ساحر تأثیری نخواهد داشت و کسی وجود ندارد که او را به رهبری و هدایت کند."],[332,"چونک چوپان خفت گرگ آمن شود","چونک خفت آن جهد او ساکن شود","وقتی چوپان خوابش ببرد، گرگ بی‌هیچ ترسی وارد می‌شود و به طعمه‌اش حمله می‌کند. وقتی چوپان خواب است، تلاش و کوشش او هم از بین می‌رود و ساکت می‌شود."],[332,"لیک حیوانی که چوپانش خداست","گرگ را آنجا امید و ره کجاست","اما زمانی که چوپان یک حیوان خدا باشد، دیگر امید گرگ در آنجا به هیچ وجه وجود ندارد و راهی برای او نیست."],[332,"جادوی که حق کند حقست و راست","جادوی خواندن مر آن حق را خطاست","جادویی که از سوی حقیقت و خداوند باشد، درست و حقیقی است. اما جادوگری که تنها به خواندن یا ذکر آن حقیقت اکتفا کند، اشتباه است و نمی‌تواند به درستی به آن دست یابد."],[332,"جان بابا این نشان قاطعست","گر بمیرد نیز حقش رافعست","حقیقت این است که جان پدر (بابا) نشانه‌ای روشن و قطعی است، حتی اگر بمیرد، حق او هرگز زایل نمی‌شود و باقی خواهد ماند."],[333,"مصطفی را وعده کرد الطاف حق","گر بمیری تو نمیرد این سبق","خداوند به پیامبر اسلام (مصطفی) وعده داده است که اگر تو بمیری، این مرگ تو برای دین و پیام تو ضرری نخواهد داشت و هیچ‌گاه یاد و تاثیر تو از بین نمی‌رود."],[333,"من کتاب و معجزه‌ت را رافعم","بیش و کم‌کن را ز قرآن مانعم","من کتاب و معجزه‌ات را بالا می‌برم و هیچ‌کس را از تغییر و کم و زیاد کردن قرآن منع می‌کنم."],[333,"من تو را اندر دو عالم حافظم","طاعنان را از حدیثت رافضم","من در این دو جهان حافظ تو هستم و هر کسی که بخواهد به سخنان تو انتقاد کند یا بر آن طعنه بزند، او را دور می‌کنم و رد می‌کنم."],[333,"کس نتاند بیش و کم کردن درو","تو به از من حافظی دیگر مجو","هیچ‌کس نمی‌تواند در قرآن چیزی اضافه یا کم کند، پس بهتر است حافظ و نگهبانی از این کتاب آسمانی مانند من نخواهی پیدا کرد."],[333,"رونقت را روز روز افزون کنم","نام تو بر زر و بر نقره زنم","علاقه و محبت تو را هر روز بیشتر می‌کنم و نام تو را بر روی طلا و نقره حک می‌کنم تا همگان آن را ببینند و قدری از مقام تو آگاه شوند."],[333,"منبر و محراب سازم بهر تو","در محبت قهر من شد قهر تو","به خاطر محبت و عشق تو، من برای تو منبر و محراب می‌سازم، اما محبت و قهرت به هم گره خورده است و آنچه را که می‌سازم تحت تأثیر قهر تو قرار دارد."],[333,"نام تو از ترس پنهان می‌گوند","چون نماز آرند پنهان می‌شوند","نام خداوند به خاطر ترس از دشمنان به طور پنهانی بیان می‌شود؛ همان‌طور که در زمان نماز، مؤمنان برای حفظ خود از آسیب‌ها به صورت مخفیانه نماز می‌خوانند."],[333,"از هراس و ترس کفار لعین","دینت پنهان می‌شود زیر زمین","به خاطر ترس و هراسی که از دشمنان دین وجود دارد، ایمان و آموزه‌های دینی به طور مخفیانه و دور از چشم‌ها باقی می‌ماند."],[333,"من مناره پر کنم آفاق را","کور گردانم دو چشم عاق را","من می‌خواهم با ایمان و علم خود، جهانی از نور و آگاهی بسازم و در این دنیا، کسانی که نادان و عاقل نباشند را نابینا کنم."],[333,"چاکرانت شهرها گیرند و جاه","دین تو گیرد ز ماهی تا به ماه","پیروان و شاگردان تو (مصطفی) در شهرها به انتشار دین تو می‌پردازند و دین تو از زمان پیدایشش (تشبیه به تغییر ماه) به تکامل و گسترش ادامه خواهد داد."],[333,"تا قیامت باقیش داریم ما","تو مترس از نسخ دین ای مصطفی","ما تا قیامت باقی‌مانده‌های دین تو را داریم، بنابراین ای مصطفی، نترس از اینکه دینت تغییر کند یا نسخ شود."],[333,"ای رسول ما تو جادو نیستی","صادقی هم‌خرقه موسیستی","ای پیامبر ما، تو جادوگر نیستی بلکه راستگو هستی و همچون موسی دارای مقام و عظمت هستی."],[333,"هست قرآن مر تو را همچون عصا","کفرها را در کشد چون اژدها","قرآن مانند عصای موسی است که می‌تواند کفرها و نافرمانی‌ها را از میان بردارد و نابود کند، به طوری که با قدرت و تأثیر خود، همانند اژدهایی عمل می‌کند."],[333,"تو اگر در زیر خاکی خفته‌ای","چون عصایش دان تو آنچ گفته‌ای","اگر تو در زیر خاک خوابیده‌ای، مانند عصای موسی که قدرت خود را دارد، پس بدان که آنچه گفتی و انجام دادی، هنوز هم باقی است و تأثیرش در جهان وجود دارد."],[333,"قاصدان را بر عصایش دست نی","تو بخسپ ای شه مبارک خفتنی","ای شاه مبارک، حالا که به خواب رفته‌ای، قاصدان (پیام‌آوران) نتوانند بر عصایت دست بزنند و آن را ببربند."],[333,"تن بخفته نور تو بر آسمان","بهر پیکار تو زه کرده کمان","نور تو که در آسمان درخشان است، در خواب تو برای پیکار آماده شده و مانند کمان کشیده شده است."],[333,"فلسفی و آنچ پوزش می‌کند","قوس نورت تیردوزش می‌کند","فلاسفه و افرادی که به تعمق و تفکر می‌پردازند، وقتی می‌بینند که نور وجود تو بر آسمان می‌درخشد، به خاطر بزرگی و عظمت تو، از خود عذرخواهی می‌کنند و می‌فهمند که نور تو توانایی تیراندازی و هدف‌گیری را دارد."],[333,"آنچنان کرد و از آن افزون که گفت","او بخفت و بخت و اقبالش نخفت","موسی آنقدر خوابش سنگین بود که بخت و اقبالش هم نتوانست بیدار شود و از آن وضع بهتر باشد."],[333,"جان بابا چونک ساحر خواب شد","کار او بی رونق و بی‌تاب شد","وقتی موسی (علیه‌السلام) به خواب رفت، روح و جان او (حضور او) مانند پدری مهربان و دلسوز بی‌حال و درمانده شد و کار او (هدایت و رهبری) کساد و بی‌رمق گردید."],[333,"هر دو بوسیدند گورش را و تفت","تا به مصر از بهر آن پیگار زفت","هر دو، قبر موسی را بوسیدند و خاک آن را بر چهره خود مالیدند تا به مصر بروند و به خاطر آن کار زشت، پیامدهای سنگینی را تحمل کنند."],[333,"چون به مصر از بهر آن کار آمدند","طالب موسی و خانه او شدند","وقتی آن‌ها به مصر آمدند تا به دنبال موسی بگردند، به خانه او هم رفتند."],[333,"اتفاق افتاد کان روز ورود","موسی اندر زیر نخلی خفته بود","روزی که موسی به مصر وارد شد، در زیر درختی خوابیده بود."],[333,"پس نشان دادندشان مردم بدو","که برو آن سوی نخلستان بجو","مردم به آن دو ساحر نشان دادند که به سوی نخلستان بروند و موسی را در آنجا پیدا کنند."],[333,"چون بیامد دید در خرمابنان","خفته‌ای که بود بیدار جهان","موسی وقتی به نخلستان رسید، مردی را دید که به خواب رفته بود، در حالی که او بیدارترین فرد در آن جهان بود."],[333,"بهر نازش بسته او دو چشم سر","عرش و فرشش جمله در زیر نظر","برای ناز و زیبایی او، دو چشمش به مانند عرش (آسمان) و زیر پایش (فرش) همه چیز در زیر نظر اوست."],[333,"ای بسا بیدارچشم و خفته‌دل","خود چه بیند دید اهل آب و گل","بسیاری از آدم‌ها ممکن است چشمانشان بیدار باشد، اما دل‌شان خواب است؛ کسانی که واقعا درک نمی‌کنند و تنها با دیدن ظواهر دنیا (آب و گل) سرگردانند."],[333,"آنک دل بیدار دارد چشم سر","گر بخسپد بر گشاید صد بصر","کسی که دلش بیدار و آگاه است، حتی اگر چشمش خواب باشد، در دل و باطنش به حقیقت‌ها و دیدنی‌های زیادی دست پیدا می‌کند."],[333,"گر تو اهل دل نه‌ای بیدار باش","طالب دل باش و در پیکار باش","اگر تو از اهل دل نیستی، همیشه بیدار و هوشیار باش و در جستجوی دل و حقیقت باش و در این مسیر تلاش کن."],[333,"ور دلت بیدار شد می‌خسپ خوش","نیست غایب ناظرت از هفت و شش","اگر دلت بیدار و آگاه باشد، خوابیدن آن نیکو نیست؛ زیرا در آن صورت، معشوق و محبوبت از تو دور و غایب است."],[333,"گفت پیغامبر که خسپد چشم من","لیک کی خسپد دلم اندر وسن","پیامبر می‌گوید که چشم من خوابش برده است، اما دل من هرگز در خواب نمی‌رود و همیشه بیدار و آگاه است."],[333,"شاه بیدارست حارس خفته گیر","جان فدای خفتگان دل‌بصیر","شاه بیدار (خدا) همیشه مراقب و نگهبان است، پس کسانی که دل‌های بینا دارند و در خواب هستند (از نظر معنوی)، جان من فدای آن‌ها می‌شود."],[333,"وصف بیداری دل ای معنوی","در نگنجد در هزاران مثنوی","بیداری واقعی و درک عمیق معنوی را نمی‌توان تنها در هزاران مثنوی و نوشته توصیف کرد، بلکه این تجربه‌ای فراتر و عمیق‌تر از ابعاد لفظی و نوشتاری است."],[333,"چون بدیدندش که خفته‌ست او دراز","بهر دزدی عصا کردند ساز","چون ساحران دیدند که موسی خوابیده است، نقشه‌ای برای دزدیدن عصای او آماده کردند."],[333,"ساحران قصد عصا کردند زود","کز پسش باید شدن وانگه ربود","ساحران به‌سرعت تصمیم گرفتند برای دزدی عصای موسی اقدام کنند، زیرا می‌دانستند اگر از پشت او نزدیک شوند، می‌توانند آن را بردارند."],[333,"اندکی چون پیشتر کردند ساز","اندر آمد آن عصا در اهتزاز","به محض اینکه ساحران به سحر خود تسلط یافتند و بر آن عصا تسلط پیدا کردند، آن عصا شروع به جنبش و حرکت کرد."],[333,"آنچنان بر خود بلرزید آن عصا","کان دو بر جا خشک گشتند از وجا","عصا آن‌قدر لرزید و تکان خورد که آن دو ساحر، که در جای خود ایستاده بودند، از ترس خشک و بی‌حرکت شدند."],[333,"بعد از آن شد اژدها و حمله کرد","هر دوان بگریختند و روی‌زرد","پس از آن، عصای موسی به شکل اژدهایی درآمد و به آن‌ها حمله کرد. هر دو ساحر از ترس فرار کردند و رنگشان زرد شد."],[333,"رو در افتادن گرفتند از نهیب","غلط غلطان منهزم در هر نشیب","از ترس و وحشت، به هم ریختند و شروع به فرار کردند در حالی که به شدت در جاهای مختلف دچار اشتباه می‌شدند."],[333,"پس یقین‌شان شد که هست از آسمان","زانک می‌دیدند حد ساحران","آن‌ها مطمئن شدند که این معجزه از آسمان آمده است، زیرا نشانه‌ها و قدرت‌های ساحران را می‌دیدند."],[333,"بعد از آن اطلاق و تبشان شد پدید","کارشان تا نزع و جان کندن رسید","پس از آن، برنامه‌های آن ساحران به وضوح مشخص شد و کارشان به جایی رسید که در حال تردید و جدال و نزدیک بودن به مرگ بودند."],[333,"پس فرستادند مردی در زمان","سوی موسی از برای عذر آن","مردی را در آن زمان به سوی موسی فرستادند تا از او برای آن کار عذرخواهی کنند."],[333,"که‌امتحان کردیم و ما را کی رسد","امتحان تو اگر نبود حسد","ما خود را بارها آزمایش کرده‌ایم و می‌دانیم که اگر حسد در میان نباشد، تو نیز ما را امتحان نمی‌کنی."],[333,"مجرم شاهیم ما را عفو خواه","ای تو خاص الخاص درگاه اله","ما خطاکارانی هستیم و از تو می‌خواهیم که ما را ببخشی، ای خدای خاص و منحصر به فرد."],[333,"عفو کرد و در زمان نیکو شدند","پیش موسی بر زمین سر می‌زدند","عزت و بخشش موسی (ع) باعث شد که در زمان مناسب، کسانی که از او عذرخواهی کردند، مورد رحمت و لطف او قرار گیرند و به نشانه توبه، بر زمین سر به زمین می‌ساییدند."],[333,"گفت موسی عفو کردم ای کرام","گشت بر دوزخ تن و جانتان حرام","موسی به دوستانش گفت: من شما را بخشیدم، ای بزرگواران. به همین خاطر، جسم و روح شما از عذاب جهنم محفوظ شد."],[333,"من شما را خود ندیدم ای دو یار","اعجمی سازید خود را ز اعتذار","من شما را به چشم خود نمی‌بینم ای دو دوست، پس خود را از بهانه‌جویی و عذرخواهی متفاوت کنید."],[333,"همچنان بیگانه‌شکل و آشنا","در نبرد آیید بهر پادشا","در نبرد به مانند یک آشنا رفتار کنید، ولی در باطن خود را بیگانه و غریب نشان دهید، این کار برای پادشاه (یا هدف بزرگ) مفید است."],[333,"پس زمین را بوسه دادند و شدند","انتظار وقت و فرصت می‌بدند","آنان به زمین بوسه زدند و به انتظار زمان و فرصت نشسته بودند."],[334,"تا به فرعون آمدند آن ساحران","دادشان تشریفهای بس گران","ساحران از مداین به نزد فرعون آمدند و برای او احترام و ارادت زیادی قائل شدند و تشریفات با ارزش و گران‌بهایی برای او آوردند."],[334,"وعده‌هاشان کرد و پیشین هم بداد","بندگان و اسپان و نقد و جنس و زاد","ساحران به فرعون قول و وعده‌هایی دادند و از پیش، بندگان، اسب‌ها، پول، کالا و توجهات زیادی را به او دادند."],[334,"بعد از آن می‌گفت هین ای سابقان","گر فزون آیید اندر امتحان","پس از آن، فرعون به کسانی که پیش‌تر در امتحان به او پیوسته بودند، می‌گوید: «ای کسانی که در گذشته به ما ملحق شده‌اید، اگر در آزمایش‌ها پیشی بگیرید و بیشتر از دیگران باشید، این بار چگونه می‌خواهید از ما بیشتر بهره‌مند شوید؟"],[334,"برفشانم بر شما چندان عطا","که بدرد پرده جود و سخا","چنان برکتی به شما بدهم که این برکت؛ پرده جود و سخاوت را بدرد."],[334,"پس بگفتندش به اقبال تو شاه","غالب آییم و شود کارش تباه","ساحران به فرعون گفتند که به لطف و نصرت تو می‌آییم و کارهای تو را خراب خواهیم کرد."],[334,"ما درین فن صفدریم و پهلوان","کس ندارد پای ما اندر جهان","ما در این کار استاد و ماهر هستیم و هیچ فرد دیگری در دنیا در برابر ما قدرت و توانایی ندارد."],[334,"ذکر موسی بند خاطرها شدست","کین حکایتهاست که پیشین بدست","حکایت‌هایی که درباره موسی (پیامبر) گفته می‌شود، ذهن‌ها را مشغول کرده و باعث توجه به آن می‌شود، چون این قصه‌ها و داستان‌ها در گذشته نقل شده‌اند."],[334,"ذکر موسی بهر روپوشست لیک","نور موسی نقد تست ای مرد نیک","نام موسی در اینجا به‌عنوان یک پوشش و تعبیر معنوی آمده است، اما نور و حقیقت وجودی او به‌واقع ارزش و اعتبار دارد. ای مردان خوب، مراقب باشید که به ظاهر این داستان اکتفا نکنید و به عمق حقیقت آن توجه کنید."],[334,"موسی و فرعون در هستی تست","باید این دو خصم را در خویش جست","موسی و فرعون نماد دو نیروی متضاد در درون هر انسان هستند و هر فرد باید در وجود خود این دو خصم را جستجو کند."],[334,"تا قیامت هست از موسی نتاج","نور دیگر نیست دیگر شد سراج","تا قیامت، از موسی (که در اینجا نماد هدایت و نور است) نور و نتایجی خواهد ماند و چیزی جز او همچون چراغی روشن نخواهد بود."],[334,"این سفال و این پلیته دیگرست","لیک نورش نیست دیگر زان سرست","این سفال و این پلین که در اینجا اشاره شده، نشان‌دهنده شکل ظاهری و جسمی یک چیز است، اما نور و معنای حقیقی آن دیگر وجود ندارد و این بدان دلیل است که آن نور از یک منبع دیگر که در این بیت به آن اشاره شده، ناشی می‌شود."],[334,"گر نظر در شیشه داری گم شوی","زانک از شیشه‌ست اعداد دوی","اگر در شیشه بنگری، گم می‌شوی، زیرا این اعداد و دوگانگی‌ها ناشی از شیشه است."],[334,"ور نظر بر نور داری وا رهی","از دوی و اعداد جسم منتهی","اگر به نور توجه کنی و از دوگانگی و عدد و جسم فاصله بگیری، به حقیقت می‌رسی و از عالم مادی خود را جدا می‌کنی."],[334,"از نظرگاهست ای مغز وجود","اختلاف مؤمن و گبر و جهود","از دیدگاه تو، ای اصل و حقیقت وجود، تفاوت‌های ظاهری بین مؤمن، گبر (زرتشتی) و جهود (یهودی) وجود ندارد."],[335,"پیل اندر خانه تاریک بود","عرضه را آورده بودندش هنود","فیلی را از سرزمین هند برای نمایش به همگان آورده بودند که در خانه ای تاریک قرار داشت."],[335,"از برای دیدنش مردم بسی","اندر آن ظلمت همی‌شد هر کسی","در آن تاریکی شب، تعداد زیادی از مردم برای دیدن این فیل سرازیر شدند."],[335,"دیدنش با چشم چون ممکن نبود","اندر آن تاریکیش کف می‌بسود","دیدن او با چشم در آن تاریکی ممکن نبود، به همین دلیل هرکسی با لمس کردن بخشی از فیل سعی داشت که بفهمد او چیست."],[335,"آن یکی را کف به خرطوم اوفتاد","گفت همچون ناودانست این نهاد","یکی از اشخاص خرطوم فیل را لمس کرد، و گفت این جانور مانند ناودان خانه است."],[335,"آن یکی را دست بر گوشش رسید","آن برو چون بادبیزن شد پدید","یکی از افراد دستش را بر گوش فیل گذاشت و در نتیجه صدای بادبیزن (سوتی که از آن استفاده می‌شود) را شنید و به نظرش رسید که فیل به شکل بادبیزن است."],[335,"آن یکی را کف چو بر پایش بسود","گفت شکل پیل دیدم چون عمود","یکی از افراد وقتی که پای فیل را لمس کرد، گفت: «من شکل فیل را مانند یک ستون دیدم."],[335,"آن یکی بر پشت او بنهاد دست","گفت خود این پیل چون تختی بدست","یکی از کسان بر پشت فیل دست گذاشت و گفت که من این فیل را مانند یک تخت می‌بینم."],[335,"همچنین هر یک به جزوی که رسید","فهم آن می‌کرد هر جا می‌شنید","هر یک از افراد، وقتی به بخشی از بدن فیل می‌رسیدند، درک و فهم خاصی از آن جز دارد و بر اساس همان تجربه‌اش صحبت می‌کرد."],[335,"از نظرگه گفتشان شد مختلف","آن یکی دالش لقب داد این الف","از نظر شنیدار و گفت‌وگوی آن‌ها، هر کس به طریقه خاص خود تعبیر کرد. یکی از آن‌ها «د» را به «دال» و دیگری به «الف» نسبت داد."],[335,"در کف هر کس اگر شمعی بدی","اختلاف از گفتشان بیرون شدی","اگر در دست هر کسی شمعی وجود داشت، با روشن شدن آن، اختلافاتی که در گفت‌وگو به وجود آمده بود، برطرف می‌شد."],[335,"چشم حس همچون کف دستست و بس","نیست کف را بر همه‌ی او دست‌رس","حس انسان مانند کف دست است و بیشتر از این نیست، بنابراین نمی‌توان به ظاهر (کف) اکتفا کرد و باید به عمق وجود (چشم) توجه داشت."],[335,"چشم دریا دیگرست و کف دگر","کف بهل وز دیده دریا نگر","چشم دریا (بینش عمیق و واقعی) با کف دریا (برخی ظاهرسازی‌ها و سطحی‌نگری‌ها) تفاوت دارد. بنابراین، به جای تمرکز بر ظواهر، باید به عمق واقعیات نگاه کرد."],[335,"جنبش کف‌ها ز دریا روز و شب","کف همی‌بینی و دریا نی، عجب","حرکت و جنبش کف‌های دریا دائمی است و هر روز و شب آن‌ها را می‌بینی، اما خود دریا (واقعیت) را نمی‌بینی، و این واقعیت شگفت‌آور است."],[335,"ما چو کشتی‌ها به‌هم بر می‌زنیم","تیره‌چشمیم و در آب روشنیم","ما مانند کشتی‌ها به یکدیگر برخورد می‌کنیم و با هم اختلاف داریم، در حالی که حقیقت ما در آب (یا آب وجود) روشن است، اما دیدگاه‌های ما (تیره‌چشمیم) واضح نیستند."],[335,"ای تو در کشتی تن رفته به خواب","آب را دیدی نگر در آب آب","تو که در جسم و تن خود غرق خواب هستی و فقط آب را می‌بینی، به عمق آبی که در آن غوطه‌وری نگاه کن."],[335,"آب را آبیست کو می‌راندش","روح را روحیست کو می‌خواندش","آب خاصیتی دارد که با روحی زندگی می‌کند و روح نیز با نیروی خود آب را به حرکت درمی‌آورد و در حقیقت، ارتباطی عمیق بین آب و روح وجود دارد."],[335,"موسی و عیسی کجا بد کآفتاب","کشت موجودات را می‌داد آب","موسی و عیسی در آن زمان کجا بودند که خورشید زندگی‌بخش تمام موجودات را به آن‌ها می‌داد؟"],[335,"آدم و حوا کجا بد آن زمان","که خدا افکند این زه در کمان","آدم و حوا در آن زمانی که خداوند این تیر (آفرینش) را در کمان (آفرینش) قرار داد، کجا بودند؟"],[335,"این سخن هم ناقص است و ابترست","آن سخن که نیست ناقص آن سرست","این حرف نیز کامل نیست و ناتمام است، زیرا سخنی که بدون رمز یا نکته‌ای باشد، کامل به حساب نمی‌آید."],[335,"گر بگوید زان بلغزد پای تو","ور نگوید هیچ از آن ای وای تو","اگر بگوید که پای تو در لغزیدن است، و چیزی در مورد آن نگویند، وای بر تو!"],[335,"ور بگوید در مثال صورتی","بر همان صورت بچفسی ای فتی","اگر کسی در مورد شکل ظاهری چیزی صحبت کند، تو هم باید بر اساس همین شکل حرف بزنی و تظاهر کنی که به همان صورت در آمده‌ای."],[335,"بسته‌پایی چون گیا اندر زمین","سر بجنبانی به بادی بی‌یقین","مانند گیاهی که در زمین ریشه دارد، بسته‌پایی که به آن گویند، وقتی که درون زمین حرکت می‌کند، به خاطر وزش بادی نامشخص، سرش را تکان می‌دهد."],[335,"لیک پایت نیست تا نقلی کنی","یا مگر پا را ازین گل بر کنی","اما پای تو نیست تا بتوانی پیامی برسانی یا اینکه از این گل (و دنیای مادی) پا را برکنی و آزاد شوی."],[335,"چون کنی پا را حیاتت زین گلست","این حیاتت را روش بس مشکلست","اگر پا را از این گل جدا کنی، حیات تو از این گل است. بنابراین، این حیات برای تو بسیار دشوار و پیچیده خواهد بود."],[335,"چون حیات از حق بگیری ای روی","پس شوی مستغنی از گل می‌روی","وقتی که حیات خود را از حق (خدا) بگیری، دیگر به این جسم خاکی (گل) وابسته نخواهی بود و به سوی عالم بالاتر و بی‌نیازی می‌روید."],[335,"شیر‌خواره چون ز دایه بسکلد","لوت‌خواره شد مر او را می‌هلد","شیرخوار وقتی از دایه جدا می‌شود و بزرگ‌تر می‌شود، به مانند کسی می‌ماند که از دامن مادری یا پرستاری دور شده و به نوعی در دنیا مستقل می‌شود."],[335,"بسته شیر زمینی چون حبوب","جو فطام خویش از قوت القلوب","مانند شیر که از دایه خود تغذیه می‌کند و به رشد و نمو می‌رسد، انسان نیز باید از خوراک معنوی و الهی بهره‌مند شود تا قوی و سیراب گردد. این خوراک معنوی، قوت القلوب یا نیروی روحی و معنوی است که به زندگی انسان عمق و معنا می‌بخشد."],[335,"حرف حکمت خور که شد نور ستیر","ای تو نور بی‌حجب را ناپذیر","حکمت را بپذیر که نور واقعی را روشن‌تر می‌کند. ای کسی که باید نور بدون حجاب را بپذیری و ببینی، از ناپذیرفتن آن دوری کن."],[335,"تا پذیرا گردی ای جان نور را","تا ببینی بی‌حجب مستور را","ای جان، تا آماده و پذیرای نور حقیقت شوی، باید آن را ببینی که بدون هیچ پرده و مانعی است."],[335,"چون ستاره سیر بر گردون کنی","بلک بی‌گردون سفر بی‌چون کنی","اگر مانند ستاره در آسمان حرکت کنی، در حقیقت باید به‌جز حرکت در آسمان، سفری بی‌هیچ قید و شرطی را آغاز کنی."],[335,"آنچنان کز نیست در هست آمدی","هین بگو چون آمدی مست آمدی","تو به طوری که از هیچ به وجود آمده‌ای، حالا بگو چطور به هستی آمده‌ای؛ آمده‌ای در حالی که حاکی از مستی و حالت خاصی هستی."],[335,"راه‌های آمدن یادت نماند","لیک رمزی بر تو بر خواهیم خواند","یادت نیست چطور به اینجا آمدی، اما رمزی به تو خواهیم گفت که آن را درک کنی."],[335,"هوش را بگذار و آنگه گوش دار","گوش را بر بند و آنگه هوش دار","هوش خود را کنار بگذار و بعد به حرف‌ها گوش کن، سپس گوش خود را ببند و بعد بر هوش خود توجه کن."],[335,"نه نگویم زانک خامی تو هنوز","در بهاری تو ندیدستی تموز","من نمی‌گویم که تو هنوز خامی، زیرا تو در بهار هستی و تابستان را تجربه نکرده‌ای."],[335,"این جهان همچون درختست ای کرام","ما برو چون میوه‌های نیم‌خام","این جهان شبیه درختی است، ای بزرگواران، پس ما نیز باید همچون میوه‌های نیم‌خام از آن بهره‌برداری کنیم."],[335,"سخت گیرد خام‌ها مر شاخ را","زانک در خامی نشاید کاخ را","چون میوه‌ها هنوز نرسیده و خام‌اند، شاخ درخت به شدت آن‌ها را نگه می‌دارد، زیرا در حالت خامی، جایگاه و ساختار آن‌ها محفوظ نیست."],[335,"چون بپخت و گشت شیرین لب‌گزان","سست گیرد شاخ‌ها را بعد از آن","وقتی که شخصی در مورد کاری یا موضوعی به بلوغ و پختگی می‌رسد و از شیرینی آن لذت می‌برد، بعد از آن دیگر نمی‌تواند به استقامت و سختی پیشین ادامه دهد و ضعف در او بروز می‌کند."],[335,"چون از آن اقبال شیرین شد دهان","سرد شد بر آدمی ملک جهان","زمانی که انسان به خوشی و کامیابی دست پیدا می‌کند، احساسات و حالت‌های منفی او نیز از بین می‌رود و دنیا بر او خوشایند می‌گردد."],[335,"سخت‌گیری و تعصب خامی است","تا جنینی، کار خون‌آشامی است","سخت‌گیری و تعصب نشان‌دهنده نادانی و خامی انسان است، چون این رفتار به مانند کشتن و خون‌ریزی می‌باشد که نتیجه عدم چالش و شناخت عمیق است."],[335,"چیز دیگر ماند اما گفتنش","با تو روح القدس گوید بی منش","هرچند که مطلبی دیگر هم باقی مانده، اما حقایق آن را نمی‌توان به راحتی بیان کرد و فقط روح القدس (فرشته وحی) می‌تواند آن را با تو بگوید، چرا که من از بیان آن ناتوانم."],[335,"نه تو گویی هم به گوش خویشتن","نه من و نه غیر من ای هم تو من","تو به خودت چیزی نمی‌گویی و من هم چیزی نمی‌گویم، نه من هستم و نه غیر من، بلکه همه ما یکی هستیم."],[335,"همچو آن وقتی که خواب اندر روی","تو ز پیش خود به پیش خود شوی","در همان حالتی که در خواب به تصور و خیال خود می‌پردازی و خود را به جلو می‌بردی."],[335,"بشنوی از خویش و پنداری فلان","با تو اندر خواب گفته‌ست آن نهان","تو ممکن است از خودت بشنوی و گمان کنی که شخص خاصی در خواب به تو چیزی گفته است، اما این در واقع پیام یا راز نهانی است که از درون خودت آمده است."],[335,"تو یکی تو نیستی ای خوش رفیق","بلک گردونی و دریای عمیق","تو تنها یک فرد نیستی، ای دوست خوب، بلکه مانند گلوبند بزرگی هستی که در دنیای وسیع و عمیق زندگی می‌کنی."],[335,"آن تو زفتت که آن نهصد تو است","قلزمست و غرقه‌گاه صد تو است","این‌جا به بیان شخصیت و عظمت انسان پرداخته شده است. اینکه وجود حقیقی انسان، که به زعم مولانا به عظمت نهصد انسان می‌رسد، همچون دریای عمیق و پرخروش (قلزم) است و غرق شدن در آن به معنای رسیدن به شناخت عمیق‌تر از خود و عالم می‌باشد."],[335,"خود چه جای حد بیداریست و خواب","دم مزن والله اعلم بالصواب","خودت چه جای بیداری و خواب هستی؟ حرف نزن، زیرا تنها خداوند می‌داند حقیقت چیست."],[335,"دم مزن تا بشنوی از دم‌زنان","آنچ نامد در زبان و در بیان","سکوت کن تا از کسانی که صحبت می‌کنند بشنوی آنچه در کلام و بیان نیست و از حقیقت فراتر است."],[335,"دم مزن تا بشنوی زان آفتاب","آنچ نامد در کتاب و در خطاب","سکوت کن تا از آن آفتاب (حقیقت و روشنایی) بشنوی، چیزی که نه در کتاب‌ها آمده و نه در سخن‌ها بیان شده است."],[335,"دم مزن تا دم زند بهر تو روح","آشنا بگذار در کشتی نوح","صحبت نکن تا روح آشنا برای تو دم بزند و تو را در کشتی نوح (نجات) قرار دهد."],[335,"همچو کنعان کآشنا می‌کرد او","که نخواهم کشتی نوح عدو","همچون کنعان که آشنا می‌کرد افراد را که نمی‌خواهم سوار کشتی نوح شوم، من هم در اینجا می‌گویم که نمی‌خواهم به این کشتی ملحق شوم."],[335,"هی بیا در کشتی بابا نشین","تا نگردی غرق طوفان ای مهین","بیا و در کشتی پدر (نوح) بنشین تا در طوفان غرق نشوی، ای بزرگوار."],[335,"گفت نه من آشنا آموختم","من به جز شمع تو شمع افروختم","او می‌گوید که من آشنایان را یاد نگرفته‌ام و فقط برای تو، یعنی شمع وجود تو، روشنی ایجاد کرده‌ام."],[335,"هین مکن کین موج طوفان بلاست","دست و پا و آشنا امروز لاست","مراقب باش، زیرا این زمان موج طوفانی از بلا و مشکلات است و در این وضعیت، حتی دوستان و آشناهای تو نیز ناتوان و بی‌فایده شده‌اند."],[335,"باد قهرست و بلای شمع‌کش","جز که شمع حق نمی‌پاید خمش","زمانی که طوفان بلایا و خشم باد وجود دارد، فقط شمع حقیقت است که می‌تواند در برابر این بلاها ایستادگی کند و باقی بماند."],[335,"گفت نه رفتم برآن کوه بلند","عاصمست آن که مرا از هر گزند","گفت که من به آن کوه بلند نرفته‌ام، زیرا آن کوه مرا از هر آسیبی محافظت می‌کند."],[335,"هین مکن که کوه کاهست این زمان","جز حبیب خویش را ندهد امان","به خودت بیا که این کوه، در واقع چیزی نیست و تنها به شکل کنونی‌اش ظاهر شده است. در این زمان، فقط کسی که دوستش داری، در امان خواهد بود."],[335,"گفت من کی پند تو بشنوده‌ام","که طمع کردی که من زین دوده‌ام","شخصی می‌گوید، من چه زمانی سخن یا نصیحت تو را شنیده‌ام که تو انتظار داشته باشی من از این خانواده یا نسبت به تو چیزی بخواهم."],[335,"خوش نیامد گفت تو هرگز مرا","من بری‌ام از تو در هر دو سرا","گفتار تو هیچ‌گاه برایم خوشایند نبوده است، و من از تو در هر دو جهان (دنیا و آخرت) بریده‌ام و جدا شده‌ام."],[335,"هین مکن بابا که روز ناز نیست","مر خدا را خویشی و انباز نیست","این شعر به ما هشدار می‌دهد که در دنیای فانی و روزهایی که در آن هستیم، زمان ناز و تنعم نیست و نباید خواب این دنیای فانی را ببینیم. در حقیقت، در نزد خداوند هیچگونه خویشاوندی و دوستی وجود ندارد و همه باید در برابر او برابری کنند."],[335,"تا کنون کردی و این دم نازکیست","اندرین درگاه گیرا ناز کیست","تو تا الان در این دنیا، کاری کردی و این لحظه، لحظه‌ای نازک و حساس است. در این درگاه، ناز و فخر و خودپسندی برای چه کسی است؟"],[335,"لم یلد لم یولدست او از قدم","نه پدر دارد نه فرزند و نه عم","او وجودی است که نه از کسی زاده شده و نه کسی را به دنیا آورده است؛ از ازل بوده و نه پدر دارد و نه فرزندی و نه برادری."],[335,"ناز فرزندان کجا خواهد کشید","ناز بابایان کجا خواهد شنید","محبت و زبونی فرزندان تا کجا می‌تواند ادامه یابد و این محبت از سوی پدران تا چه اندازه قابل درک و احساس خواهد بود؟"],[335,"نیستم مولود پیرا کم بناز","نیستم والد جوانا کم گراز","من نه فرزند نازپرورده‌ای هستم و نه پدرم جوان و نازکدل."],[335,"نیستم شوهر نیم من شهوتی","ناز را بگذار اینجا ای ستی","من نه شوهر هستم و نه دارای تمایلات ناز و زیبایی، بنابراین ای سیتی (مقصود زنی که نازش را می‌افزاید)، مرا در اینجا رها کن."],[335,"جز خضوع و بندگی و اضطرار","اندرین حضرت ندارد اعتبار","در این مقام و مقام‌های مقدس تنها تسلیم، بندگی و نیازمندی به خداست که ارزشمند است و غیر از آن اعتبار ندارد."],[335,"گفت بابا سال‌ها این گفته‌ای","باز می‌گویی به جهل آشفته‌ای","پدر می‌گوید: تو سال‌هاست این حرف را می‌زنی و هنوز تکرار می‌کنی، نشان‌دهنده نادانی و سردرگمی توست."],[335,"چند ازین‌ها گفته‌ای با هرکسی","تا جواب سرد بشنودی بسی","چند بار این حرف‌ها را با دیگران گفته‌ای تا جوابی بی‌احساس و سرد بشنوی؟"],[335,"این دم سرد تو در گوشم نرفت","خاصه اکنون که شدم دانا و زفت","منظور این است که حالا که به دانایی و بزرگی رسیده‌ام، نصیحت‌های تو (پدر) برایم اهمیتی ندارد و به گوشم نمی‌رود."],[335,"گفت بابا چه زیان دارد اگر","بشنوی یکبار تو پند پدر","پدر می‌گوید: چه اشکالی دارد اگر یک بار هم که شده، سخن و نصیحت پدر را بشنوی؟"],[335,"همچنین می‌گفت او پند لطیف","همچنان می‌گفت او دفع عنیف","او (پدر) همچنین می‌گفت که پند لطیف و همدلی است، اما به او (ادبیر) پند سخت و قاطع نیز می‌داد."],[335,"نه پدر از نصح کنعان سیر شد","نه دمی در گوش آن ادبیر شد","نه پدر، یعنی مرد بزرگ و صاحب‌نظر، از نصح و پند کنعان خسته و سیر نشد و نه یک لحظه هم در گوش آن ادبیر (مشاور) تاثیر گذاشت."],[335,"اندرین گفتن بدند و موج تیز","بر سر کنعان زد و شد ریز ریز","در این گفتگوها، برخی افراد بدخواه به همدیگر می‌گویند و با دسیسه و نیرنگ، اوضاع را بر کنعان (یعنی یوسف) دشوار می‌کنند و مشکلات بیشتری برای او ایجاد می‌نمایند."],[335,"نوح گفت ای پادشاه بردبار","مر مرا خر مرد و سیلت برد بار","نوح به پادشاه بردبار می‌گوید که ای پادشاه، به من بگو که چرا سیل همسر و فرزندانم را نابود کرد و مرا بدون آن‌ها گذاشت."],[335,"وعده کردی مر مرا تو بارها","که بیابد اهلت از طوفان رها","نوح به پادشاه می‌گوید که تو بارها به من وعده داده‌ای که اهل و خانواده‌ام از طوفان نجات پیدا خواهند کرد."],[335,"دل نهادم بر امیدت من سلیم","پس چرا بربود سیل از من گلیم","من به امید تو اعتماد کردم و دل بستم، پس چرا طوفان (سیل) گلیم (پوشش و سرپناه) مرا از من گرفت؟"],[335,"گفت او از اهل و خویشانت نبود","خود ندیدی تو سپیدی او کبود","او می‌گوید که این شخص از خانواده و نزدیکان تو نیست و تو هم هیچ‌گاه رنگ سفید او را ندیده‌ای، در حالی که رنگش سیاه است."],[335,"چونک دندان تو کرمش در فتاد","نیست دندان بر کنش ای اوستاد","وقتی که دندان تو به خرچنگ (کرمی که در بدن وجود دارد) برخورد کرد، این دندان خودش را از آن جدا نکن، ای استاد."],[335,"تا که باقی تن نگردد زار ازو","گرچه بود آن تو شو بیزار ازو","تا زمانی که جسم تو آسیب نبیند، از او دوری کن، هرچند آن چیزی که این آسیب را به وجود آورده، مربوط به تو است."],[335,"گفت بیزارم ز غیر ذات تو","غیر نبود آنک او شد مات تو","من از غیر تو بیزارم، چون هیچ چیزی غیر از تو وجود ندارد؛ آنچه که غیر از تو هست، در برابر تو ناتوان و بی‌معناست."],[335,"تو همی دانی که چونم با تو من","بیست چندانم که با باران چمن","من به خوبی می‌دانم که چه رابطه‌ای با تو دارم؛ به اندازه‌ای به تو وابسته‌ام که مانند چمن به باران نیاز دارم."],[335,"زنده از تو شاد از تو عایلی","مغتذی بی واسطه و بی حایلی","زندگی و شادی من از توست، و من به برکت وجود تو بهره‌مند می‌شوم، بدون اینکه به کسی دیگر وابسته یا نیازمند باشم."],[335,"متصل نه منفصل نه ای کمال","بلک بی‌چون و چگونه و اعتلال","حالت متصل و جدا از تو وجود ندارد ای کمال؛ بلکه تو بدون هیچ قید و شرط و نقصی هستی."],[335,"ماهیانیم و تو دریای حیات","زنده‌ایم از لطفت ای نیکو صفات","ما مانند ماهیانی هستیم که در دریای حیات زندگی می‌کنیم و این زندگی ما به خاطر لطف و صفات نیک تو است."],[335,"تو نگنجی در کنار فکرتی","نی به معلولی قرین چون علتی","تو در محدودیت‌های فکری خود نمی‌گنجی و نمی‌توانی با دلیل و معلول به یکدیگر نزدیک شوی، زیرا تو به عنوان علت، وجود بالاتری داری که فراتر از این روابط است."],[335,"پیش ازین طوفان و بعد این مرا","تو مخاطب بوده‌ای در ماجرا","قبل از این طوفان و بعد از این، تو همیشه در این ماجرا مخاطب من بوده‌ای."],[335,"با تو می‌گفتم نه با ایشان سخن","ای سخن‌بخش نو و آن کهن","من فقط با تو صحبت می‌کردم و نه با دیگران، ای منبع سخنان تازه و آنچه که قدیمی است."],[335,"نه که عاشق روز و شب گوید سخن","گاه با اطلال و گاهی با دمن","عاشق واقعی در صحبت کردن فقط بر روی زمان و مکان یا ظواهر تکیه نمی‌کند؛ او گاه از زیبایی‌های دشت، یعنی «اطلال» و گاه از لذت‌های گل، یعنی «دمن» سخن می‌گوید."],[335,"روی با اطلال کرده ظاهرا","او کرا می‌گوید آن مدحت کرا","او که ظاهرا با اطلال (به معنای جایی که بر آن تکیه کرده یا نشسته است) صحبت می‌کند، در واقع به کسی اشاره دارد که او را مدح می‌کند. مشخص نیست که این شخص کیست و منظور از مدح چه کسی است."],[335,"شکر طوفان را کنون بگماشتی","واسطه‌ی اطلال را بر داشتی","شکر به طوفان اکنون برمی‌خیزد و تو واسطه ظواهر را کنار زده‌ای."],[335,"زانک اطلال لئیم و بد بدند","نه ندایی نه صدایی می‌زدند","چون آثار و نشانه‌های زشت و پست (اطلال) وجود دارد، هیچ صدایی ایجاد نمی‌شود و کسی دعوت نمی‌کند."],[335,"من چنان اطلال خواهم در خطاب","کز صدا چون کوه واگوید جواب","من می‌خواهم زمانی که به تو خطاب می‌کنم، صدایم به گونه‌ای باشد که مانند صدای کوه پاسخ دهد و اوج بگیرد."],[335,"تا مثنّا بشنوم من نام تو","عاشقم بر نام جان‌آرام تو","من عاشق نام تو هستم و دوست دارم که نام تو را به صورت موزون و دلنشین بشنوم، مانند نغمه‌ای که آرامش بخش جان باشد."],[335,"هر نبی زان دوست دارد کوه را","تا مثنّا بشنود نام تو را","هر پیامبری به خاطر دوستی با خدا، کوه را دوست دارد تا بتواند نام تو (خدا) را به صورت مثنوی (دو با دو یا موزون) بشنود."],[335,"آن که پست مثال سنگ‌لاخ","موش را شاید نه ما را در مناخ","این بیت بیان می‌کند که ممکن است موجودی کوچک و ضعیف مانند موش، هم نتواند از یک کوه بی‌اهمیت و کم‌ارزش، مانند سنگ‌لاخ (خاک‌ریز)، به خوبی استفاده کند و از آن بهره‌برداری کند. در اینجا، تکیه بر ناتوانی و عدم تأثیرگذاری است."],[335,"من بگویم او نگردد یار من","بی‌صدا ماند دم گفتار من","من می‌گویم که اگر او به حرف من گوش ندهد و پاسخ نگوید، هرگز یار من نخواهد شد و سکوت او نشانه بی‌توجهی‌اش به کلام من است."],[335,"با زمین آن به که هموارش کنی","نیست همدم با قدم یارش کنی","بهتر است زمین را صاف و هموار کنی تا با کسی همراه شوی، زیرا در این صورت، قدم‌های تو هم‌قدم او خواهد شد. در واقع، بهتر است برای داشتن همراهی، زمین را آماده کنی."],[335,"گفت ای نوح ار تو خواهی جمله را","حشر گردانم بر آرم از ثری","نوح، اگر بخواهی، می‌توانم تمامی خلایق را جمع کنم و آن‌ها را از بلندای آسمان پایین بیاورم."],[335,"بهر کنعانی دل تو نشکنم","لیکت از احوال آگه می‌کنم","به خاطر کنعان، دل تو را نمی‌شکنم، اما تو را از وضعیت و احوال خودم باخبر می‌کنم."],[335,"گفت نه نه راضیم که تو مرا","هم کنی غرقه اگر باید تو را","من راضی هستم که هرگاه لازم باشد، تو مرا هم غرق کنی."],[335,"هر زمانم غرقه می‌کن من خوشم","حکم تو جانست چون جان می‌کشم","هر وقت که مرا در عشق غرق می‌کنی، خوشحالم؛ زیرا فرمان تو برای من به اندازه جانم اهمیت دارد و همچون جانی که می‌کشم، برایم ارزشمند است."],[335,"ننگرم کس را و گر هم بنگرم","او بهانه باشد و تو منظرم","به کسی توجه نمی‌کنم و اگر هم به کسی نگاه کنم، آن شخص فقط بهانه‌ای است و تو تنها کسی هستی که مدنظر منی."],[335,"عاشق صنع توم در شکر و صبر","عاشق مصنوع کی باشم چو گبر","من فقط عاشق آفرینش تو هستم و در شکر (قدردانی) و صبر (تحمل) نسبت به آن، اما عاشق چیزهای ساخته‌شده (محصولات) تو نیستم، چون معتقدم که در این صورت مثل کافر می‌شوم."],[335,"عاشق صنع خدا با فر بود","عاشق مصنوع او کافر بود","عاشق آفرینش خدا باید از فر و زیبایی آن لذت ببرد، اما کسی که فقط به شکل ظاهری چیزها دل ببندد، مانند یک کافر است."],[336,"دی سؤالی کرد سایل مر مرا","زانک عاشق بود او بر ماجرا","دیروز فردی از من سؤالی پرسید، چرا که او عاشق ما و ماجرا بود."],[336,"گفت نکته الرضا بالکفر کفر","این پیمبر گفت و گفت اوست مهر","پیامبر (ص) گفته است که راضی بودن به کفر، خود کفر است و این نکته را به وضوح بیان کرده است و دلیل این موضوع نیز محبت و مهر اوست."],[336,"باز فرمود او که اندر هر قضا","مر مسلمان را رضا باید رضا","او (پیامبر) فرمود که در هر قضایی، برای مسلمان واجب است که راضی باشد و با آنچه پیش می‌آید، کنار بیاید."],[336,"نه قضای حق بود کفر و نفاق","گر بدین راضی شوم باشد شقاق","رضایت به قضا و تقدیر الهی نباید به معنای پذیرش کفر و نفاق باشد؛ زیرا اگر به چنین چیزی راضی شوم، به تضاد و جدایی دچار می‌شوم."],[336,"ور نیم راضی بود آن هم زیان","پس چه چاره باشدم اندر میان","اگر من هم راضی نباشم، این وضعیت برای من ضرر دارد؛ پس چه راه حلی برای خروج از این وضعیت می‌توانم پیدا کنم؟"],[336,"گفتمش این کفر مقضی نه قضاست","هست آثار قضا این کفر راست","به او گفتم که این کفر (عملی که به آن دچار شده‌ای) قضا نیست، بلکه مقضی است، یعنی نتیجه انتخاب خودت است. آثار و نتایج قضا در واقع به این کفر مربوط می‌شود و آن را نشان می‌دهد."],[336,"پس قضا را خواجه از مقضی بدان","تا شکالت دفع گردد در زمان","قضا را خواجه (خدا) از مقضی (مقرر) می‌داند تا گرفتاری‌های تو (شکالت) در زمان برطرف شود."],[336,"راضیم در کفر زان رو که قضاست","نه ازین رو که نزاع و خبث ماست","من به کفر راضی هستم، اما دلیلش قضا و سرنوشت است، نه اینکه بخواهم به خاطر نزاع و بدی‌های خودم چنین وضعیتی را بپذیرم."],[336,"کفر از روی قضا خود کفر نیست","حق را کافر مخوان اینجا مه‌ایست","کفری که ناشی از قضا و تقدیر الهی است، در حقیقت کفر به حساب نمی‌آید، بنابراین نمی‌توان کسی را که به این دلیل مخالف‌خوانده شده، کافر دانست. این وضعیت بیشتر به مانند یک ابر یا مه است که بر اوضاع حاکم است."],[336,"کفر جهلست و قضای کفر علم","هر دو کی یک باشد آخر حلم و خلم","کفر نتیجه جهل است، و قضای الهی یعنی تقدیر به معنای علم است. این دو یکی نیستند و در واقع، بین عقل و نادانی تفاوت وجود دارد."],[336,"زشتی خط زشتی نقاش نیست","بلک از وی زشت را بنمودنیست","نقاش نمی‌تواند زشت بودن خط را به دوش بکشد، بلکه او فقط زشتی را نشان می‌دهد و خود زشت نیست."],[336,"قوت نقاش باشد آنک او","هم تواند زشت کردن هم نکو","توانایی نقاش به این بستگی دارد که او بتواند هم زشت و هم زیبا را به تصویر بکشد. در واقع، قدرت او در خلق زیبایی و زشتی است."],[336,"گر کشانم بحث این را من بساز","تا سؤال و تا جواب آید دراز","اگر من این بحث را ادامه دهم و آن را سامان بدهم، سؤال‌ها و جواب‌ها به طرز طولانی و مفصلی پیش خواهد رفت."],[336,"ذوق نکته عشق از من می‌رود","نقش خدمت نقش دیگر می‌شود","عشق و شوق برای گفتن نکته‌های ظریف و زیبا از من دور می‌شود و در عوض، بعد دیگری از خدمت و انجام وظیفه بروز می‌کند که ممکن است جایگزین آن شود."],[337,"آن یکی مرد دومو آمد شتاب","پیش یک آیینه دار مستطاب","مردی که دو شکل دارد (انسانی و روحانی) با شتاب به پیش‌آیینه‌ای بسیار زیبا و شگفت‌انگیز می‌آید."],[337,"گفت از ریشم سپیدی کن جدا","که عروس نو گزیدم ای فتی","مردی به آیینه‌دار می‌گوید که ریشش را بزند تا از سپیدی‌اش کم شود، چون عروس تازه‌ای برای خود انتخاب کرده است و می‌خواهد ظاهری جوان‌تر داشته باشد."],[337,"ریش او ببرید و کل پیشش نهاد","گفت تو بگزین مرا کاری فتاد","او ریشش را برید و همه چیز را به پیش او گذاشت و گفت که تو انتخاب کن چون به کار بزرگی دچار شده‌ام."],[337,"این سؤال و آن جوابست آن گزین","که سر اینها ندارد درد دین","این سؤال و جواب در واقع حسی از بی‌ثمری و بی‌فایده بودن دارد، زیرا جستجوی آنها هیچ تاثیری بر روح و دین ندارد."],[337,"آن یکی زد سیلیی مر زید را","حمله کرد او هم برای کید را","مردی به نام زید مورد حمله قرار می‌گیرد و شخصی دیگری به او سیلی می‌زند؛ در اینجا زید نیز مقابله به مثل می‌کند و عملی متقابل انجام می‌دهد."],[337,"گفت سیلی‌زن سؤالت می‌کنم","پس جوابم گوی وانگه می‌زنم","سیلی‌زن گفت: قبل از اینکه به تو ضربه بزنم، سؤالی از تو می‌پرسم، بعد از آن جواب بده، بعد من دوباره می‌زنم."],[337,"بر قفای تو زدم آمد طراق","یک سؤالی دارم اینجا در وفاق","من ضربه‌ای به پشت تو زدم و این سوال را دارم که آیا این عمل در توافق ما بوده است یا خیر."],[337,"این طراق از دست من بودست یا","از قفاگاه تو ای فخر کیا","این طراق (کتک یا ضربه) که به تو زدم، آیا از دست من بوده یا از پشت تو که فخر (شکوه) خاندان است؟"],[337,"گفت از درد این فراغت نیستم","که درین فکر و تفکر بیستم","من از درد و رنج دور نیستم، بلکه در این حالت که فکر و تأمل می‌کنم، حضور دارم و به تفکر مشغولم."],[337,"تو که بی‌دردی همی اندیش این","نیست صاحب‌درد را این فکر هین","تو که دردی نداری و فقط به فکر و اندیشه مشغولی، بدان که این نوع تفکر تنها برای کسی است که در درد و رنج است."],[338,"در صحابه کم بدی حافظ کسی","گرچه شوقی بود جانشان را بسی","در جمع یاران، خواجه حافظ که شخصی است برجسته و مورد توجه، کمترین بدی و نقصی نداشت، هرچند که عشق و شوق بسیار به جان‌های آن‌ها داشت."],[338,"زانک چون مغزش در آگند و رسید","پوستها شد بس رقیق و واکفید","چون مغز درون میوه‌ها به کیفیتی رسیده و نرم شده، پوست‌های آنها نیز بسیار نازک و لطیف گشته است."],[338,"قشر جوز و فستق و بادام هم","مغز چون آگندشان شد پوست کم","