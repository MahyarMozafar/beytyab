دن به اوامر و نواهی مشغول باش و در دریافت آن‌ها دقت کن."],[877,"مرغ جذبه ناگهان پرد ز عش","چون بدیدی صبح شمع آنگه بکش","زمانی که مرغی به شوق عشق ناگهان از قفس بیرون می‌آید و صبح را درخشان مانند شمع می‌بیند، به همان سرعت شوقش را بی‌چشم داشت و باید خود را رها کند."],[877,"چشمها چون شد گذاره نور اوست","مغزها می‌بیند او در عین پوست","چشم‌ها از نور الهی روشن می‌شوند و این نور باعث می‌شود که حقایق را درک کنند. ذهن‌ها نیز به وسیله این نور، حقیقت را در ظواهر (مثل پوست) می‌بینند."],[877,"بیند اندر ذره خورشید بقا","بیند اندر قطره کل بحر را","انسان می‌تواند در ذره‌ای، جلوه‌های عظیم و بیکران خورشید را ببیند و در یک قطره، تمام پهنه دریا را مشاهده کند."],[878,"گفت صوفی در قصاص یک قفا","سر نشاید باد دادن از عمی","صوفی می‌گوید در مجازات، نمی‌توان به کسی که فقط بر روی گردن او بادی وزیده، آسیب رساند؛ یعنی کسی را به خاطر یک اشتباه کوچک مجازات نکرد."],[878,"خرقه تسلیم اندر گردنم","بر من آسان کرد سیلی خوردنم","صوفی که لباس تسلیم و رضا به دوش دارد به راحتی تحمل درد و ضربه را برای خود آسان کرده است."],[878,"دید صوفی خصم خود را سخت زار","گفت اگر مشتش زنم من خصم‌وار","صوفی که دشمنش را در حالتی سخت و رنج دیده می‌بیند، می‌گوید اگر به او مشت بزنم، مثل یک خصم با او رفتار کرده‌ام."],[878,"او به یک مشتم بریزد چون رصاص","شاه فرماید مرا زجر و قصاص","او می‌گوید که اگر به یک مشت به او آسیب بزنم، مانند فلز آب‌شده (که به راحتی شکل می‌گیرد) او به زمین خواهد ریخت؛ شاه به من دستور می‌دهد که او را تنبیه کنم و مجازات کنم."],[878,"خیمه ویرانست و بشکسته وتد","او بهانه می‌جود تا در فتد","خیمه خراب شده و ویران است و میخ (وتد) آن شکسته است، او بهانه‌ای می‌جوید تا (به زمین) بیفتد."],[878,"بهر این مرده دریغ آید دریغ","که قصاصم افتد اندر زیر تیغ","برای این مرده، دریغ می‌آید که به خاطر او، من (گوینده) گرفتار انتقام (قصاص) شوم و زیر تیغ قرار بگیرم."],[878,"چون نمی‌تانست کف بر خصم زد","عزمش آن شد کش سوی قاضی برد","چون نتوانست با دشمن خود مبارزه کند، تصمیم گرفت که به سوی قاضی برود."],[878,"که ترازوی حق است و کیله‌اش","مخلص است از مکر دیو و حیله‌اش","این بیت می‌گوید که قاضی به عنوان نماینده حق، ترازویی است که عدالت را اندازه می‌گیرد و او از نیرنگ‌های شیطان و فریب‌های او پاک و خلاص است."],[878,"هست او مقراض احقاد و جدال","قاطع جن دو خصم و قیل و قال","او مانند قیچی‌ای است که کینه‌ها و جدال‌ها را قطع می‌کند و به طور قاطع میان دو رقیب و بحث و جدل آنها تصمیم می‌گیرد."],[878,"دیو در شیشه کند افسون او","فتنه‌ها ساکن کند قانون او","دیو با جادوی خود در شیشه محبوس می‌شود و به وسیله او فتنه‌ها خاموش می‌گردند و موانع را برطرف می‌کند."],[878,"چون ترازو دید خصم پر طمع","سرکشی بگذارد و گردد تبع","وقتی که طمع‌کار (خصم) ترازویی را می‌بیند، سرکشی و بی‌ادبی می‌کند و دست از حق و حقیقت برمی‌دارد و به دنبال قلدری و تسلط بر دیگران می‌افتد."],[878,"ور ترازو نیست گر افزون دهیش","از قسم راضی نگردد آگهیش","اگر ترازو وجود نداشته باشد و بتوانی بیشتر از حق خود بگیری، با این حال هیچ بعید نیست که از اوضاع آگاه نشوی و راضی نشوی به قسمی که قسم خورده‌ای."],[878,"هست قاضی رحمت و دفع ستیز","قطره‌ای از بحر عدل رستخیز","قاضی، نماد رحمت و آرامش است و وظیفه‌اش جلوگیری از نزاع و دعواهاست؛ مانند یک قطره کوچک که به نوعی از دریای بزرگ عدالت و روز قیامت نشأت می‌گیرد."],[878,"قطره گرچه خرد و کوته‌پا بود","لطف آب بحر ازو پیدا بود","هرچند که قطره کوچک و ناچیز است، اما لطف و نیکی آب دریا از وجود آن شفاف و نمایان است."],[878,"از غبار ار پاک داری کله را","تو ز یک قطره ببینی دجله را","اگر سر خود را از غبار پاک کنی، می‌توانی از یک قطره، دجله (رودی بزرگ و مهم در عراق) را ببینی. این به معنای آن است که با پاک‌سازی دل و فکر، می‌توانی باریک‌بینانه و عمیق‌تر واقعیت‌ها را درک کنی."],[878,"جزوها بر حال کلها شاهدست","تا شفق غماز خورشید آمدست","اجزای یک کل (کلی) به حالت خود گواهی می‌دهند تا زمانی که شفق (نور پس از غروب) نشان‌دهنده‌ی آمدن خورشید باشد."],[878,"آن قسم بر جسم احمد راند حق","آنچ فرمودست کلا والشفق","خداوند حقی که درباره جسم پیامبر (احمد) گفته، با قسم به شفق (پدیده غروب) آن را تأکید کرده است."],[878,"مور بر دانه چرا لرزان بدی","گر از آن یک دانه خرمن‌دان بدی","چرا مور بر روی دانه‌ای لرزان است، در حالی که اگر آن دانه را در انبوهی از دانه‌ها می‌داشت، دیگر نمی‌لرزد؟ این بیت به نگرانی و تردید اشاره دارد که موجودات کوچک در برابر مسائل جزئی دارند، در حالی که با وجود فراوانی، آن نگرانی‌ها باید کاهش یابد."],[878,"بر سر حرف آ که صوفی بی‌دلست","در مکافات جفا مستعجلست","صوفی که دل ندارد، به محض اینکه کلامی در مورد او گفته شود، به سرعت و عجله به آن واکنش نشان می‌دهد و انتظار می‌کشد که با او به گونه‌ای مقابله شود."],[878,"ای تو کرده ظلمها چون خوش‌دلی","از تقاضای مکافی غافلی","ای کسی که ظلم‌های زیادی کرده‌ای، اما به خوش‌دلی خود غره‌ای، در درخواست عذاب و کیفر غافل هستی."],[878,"یا فراموشت شدست از کرده‌هات","که فرو آویخت غفلت پرده‌هات","شاید تو فراموش کرده‌ای که اعمالت چه بوده است، چون غفلت باعث شده است که پرده‌های نادانی بر تو بیفتند."],[878,"گر نه خصمیهاستی اندر قفات","جرم گردون رشک بردی بر صفات","اگر تو در قضاوت‌ها و حق‌کشی‌ها خصم و دشمنی نیستی، پس چرا بر صفات خوب و زیبای دیگران حسد می‌ورزی؟"],[878,"لیک محبوسی برای آن حقوق","اندک اندک عذر می‌خواه از عقوق","محبوبی که در قید و بند است، به خاطر حقوق اندک خود به تدریج از عدم وفا و بدرفتاری عذرخواهی می‌کند."],[878,"تا به یکبارت نگیرد محتسب","آب خود روشن کن اکنون با محب","محتسب باید یک بار کارت را در دست بگیرد و به دقت این مسئله را بررسی کند، پس اکنون با محبت و روشنی عمل کن."],[878,"رفت صوفی سوی آن سیلی‌زنش","دست زد چون مدعی در دامنش","صوفی به سوی کسی که او را سیلی زده بود رفت و دست او را گرفت، مانند آنکه مدعی در دامن کسی می‌زند تا حق خود را بگیرد."],[878,"اندر آوردش بر قاضی کشان","کین خر ادبار را بر خر نشان","صوفی را به قاضی کشاندند تا او هم گواهی دهد که این خر(شیوه ناشایست) را به خر(پروردگار) و لایق برگرداند."],[878,"یا به زخم دره او را ده جزا","آنچنان که رای تو بیند سزا","هرگونه مجازاتی که ای قاضی برای او تعیین کنی، باید به گونه‌ای باشد که مطابق با درک و دیدگاه تو از عدالت باشد، وگرنه ممکن است بی‌عدالتی کنی."],[878,"کانک از زجر تو میرد در دمار","بر تو تاوان نیست آن باشد جبار","اگر کسی به خاطر آزار تو بمیرد، بر تو مجازات و عواقبی نیست، زیرا آنکه چنین کاری کرده، خداوند بزرگ و قهار است."],[878,"در حد و تعزیر قاضی هر که مرد","نیست بر قاضی ضمان کو نیست خرد","در مورد حد و تعزیر (مجازات) قاضی، اگر شخصی که محکوم می‌شود، مرد نباشد، قاضی در برابر آن مسئولیتی ندارد و هیچ عقلی نمی‌گوید که باید پاسخگو باشد."],[878,"نایب حقست و سایه عدل حق","آینه هر مستحق و مستحق","قاضی نماینده خداوند و سایه عدالت اوست و باید به مانند آینه‌ای عمل کند که ویژگی‌های هر صلاحیت‌دار و مستحق را به درستی نمایش دهد."],[878,"کو ادب از بهر مظلومی کند","نه برای عرض و خشم و دخل خود","آداب و رفتار درست تنها به خاطر مظلومان و ن purposes آسیب‌دیدگان باید رعایت شود، نه به خاطر منافع شخصی، خشم یا کسب درآمد."],[878,"چون برای حق و روز آجله‌ست","گر خطایی شد دیت بر عاقله‌ست","چون انسان کارش را برای حق انجام می‌دهد و در روز قیامت جوابگو خواهد بود، اگر اشتباهی هم مرتکب شود، مسئولیت آن بر عهده خود او خواهد بود."],[878,"آنک بهر خود زند او ضامنست","وآنک بهر حق زند او آمنست","کسی که برای خود آسیب می‌زند، مسئولیت آن به عهده اوست، ولی اگر کسی آسیب بزند به خاطر حق و عدالت، در این صورت او از عواقب آن محفوظ است."],[878,"گر پدر زد مر پسر را و بمرد","آن پدر را خون‌بها باید شمرد","اگر پدر، پسرش را بزند و پدر بمیرد، باید خون‌بهای آن پدر را پرداخت کرد."],[878,"زانک او را بهر کار خویش زد","خدمت او هست واجب بر ولد","چون پدر برای انجام کار خودش فرزندش را زده است، خدمت به او بر عهده فرزند واجب است."],[878,"چون معلم زد صبی را شد تلف","بر معلم نیست چیزی لا تخف","چون معلم به شاگردش ضربه‌ای می‌زند، او آسیب می‌بیند و از بین می‌رود، اما معلم هیچ نگرانی‌ای ندارد."],[878,"کان معلم نایب افتاد و امین","هر امین را هست حکمش همچنین","معلم به عنوان نماینده و امین خداوند در کار آموزش و تربیت شناخته می‌شود و هر امینی باید به همین شیوه عمل کند."],[878,"نیست واجب خدمت استا برو","پس نبود استا به زجرش کارجو","انجام دادن خدمت به استاد ضروری نیست، بنابراین اگر او را به زجر وادار کنند، کارآموز نمی‌تواند از آن استفاده کند."],[878,"ور پدر زد او برای خود زدست","لاجرم از خونبها دادن نرست","اگر پدر او (فرزند) را بزند، این ضربه در حقیقت به خود پدر آسیب می‌زند، زیرا او ناگزیر از پرداخت قیمت و خسارت آن خون خواهد بود."],[878,"پس خودی را سر ببر ای ذوالفقار","بی‌خودی شو فانیی درویش‌وار","خودخواهی و ego را کنار بگذار و مانند ذوالفقار (شمشیر امام علی) با آن مبارزه کن. در بی‌خودی و تسلیم شدن به خداوند، خودت را فنا کن و زندگی‌ای درویش‌وار برگزین."],[878,"چون شدی بی‌خود هر آنچ تو کنی","ما رمیت اذ رمیتی آمنی","وقتی که به حالت بی‌خودی رسیدی و از خود فاصله گرفتی، هر چیزی که انجام دهی، از سر خودت نیست و در حقیقت، نه تو تیر انداخته‌ای و نه تو عمل کرده‌ای، بلکه خداوند در پس آن کار است."],[878,"آن ضمان بر حق بود نه بر امین","هست تفصیلش به فقه اندر مبین","آن ضمانتی که در اینجا مطرح شده، برای خداوند است و نه برای شخصی معتمد، و جزئیات این مسأله در علم فقه به‌خوبی توضیح داده شده است."],[878,"هر دکانی راست سودایی دگر","مثنوی دکان فقرست ای پسر","هر دکان دیگری یک سرمایه یا هدف خاصی دارد، اما دکان فقر که اشاره به زهد و ورع دارد، دکان ویژه‌ای است و باید به آن توجه کرد، ای پسر."],[878,"در دکان کفشگر چرمست خوب","قالب کفش است اگر بینی تو چوب","در دکان کفشگر، چرم خوب وجود دارد و اگر به دقت نگاه کنی، قالب‌های کفش هم از چوب ساخته شده‌اند."],[878,"پیش بزازان قز و ادکن بود","بهر گز باشد اگر آهن بود","در برابر قالی‌فروشان و فروشندگان پارچه، اگر جنس آنها از پشم (قز) و ادکن (نوعی پارچه) باشد، در حقیقت باید جنس آن به خوبی و مانند آهن باکیفیت باشد."],[878,"مثنوی ما دکان وحدتست","غیر واحد هرچه بینی آن بتست","شعر اشاره دارد به اینکه مثنوی مولانا مانند دکان یا مکانی است که در آن تنها حقیقت واحد یعنی \"وحدت\" وجود دارد و هر چیز دیگر که به نظر می‌رسد، تنها یک پیکر یا تجلی از آن حقیقت یکتاست."],[878,"بت ستودن بهر دام عامه را","هم‌چنان دان کالغرانیق العلی","ستودن بت به خاطر جلب توجه عامه مردم، همانند ستایش غرانیک العلی است که به طور عام دیده می‌شود. غرانیک العلی به معنای پرنده‌ای بزرگ و پرآوازه است که نشانه فریبندگی و جلب توجه است."],[878,"خواندش در سوره والنجم زود","لیک آن فتنه بد از سوره نبود","آیه‌ای از قرآن به نام \"سوره والنجم\" را به او خواندند، اما آن فتنه‌ای که او به آن گرفتار شد، به خاطر این سوره نبود."],[878,"جمله کفار آن زمان ساجد شدند","هم سری بود آنک سر بر در زدند","همه کافران در آن زمان سجده کردند و طوری بودند که سری بود که به در زدند، یعنی به در ورود و تقرب به معبود اقدام کردند."],[878,"بعد ازین حرفیست پیچاپیچ و دور","با سلیمان باش و دیوان را مشور","حالا موضوعی هست که پیچیده و غیرمستقیم است و لازم است با سلیمان، اشاره به روح نبوت و حکمت، در مورد دیوان، موجودات غیرعاقل و وحوش مشورت کنی."],[878,"هین حدیث صوفی و قاضی بیار","وان ستمکار ضعیف زار زار","بیا داستان صوفی و قاضی را بگویم و آن ستمکاری را که به شدت ضعیف و ناتوان است، به تصویر بکشم."],[878,"گفت قاضی ثبت العرش ای پسر","تا برو نقشی کنم از خیر و شر","قاضی گفت: ای پسر، چون به عدالت و انصاف رسیدم، باید بر کاغذ نقش خیر و شر را ثبت کنم."],[878,"کو زننده کو محل انتقام","این خیالی گشته است اندر سقام","کس را که انتقام را به جا آورد و مجازات کند، در کار نیست و این تنها یک خیال و تصور در پس ذهن مانده است."],[878,"شرع بهر زندگان و اغنیاست","شرع بر اصحاب گورستان کجاست","احکام دینی و قوانین شرعی برای افراد زندۀ ثروتمند وضع شده است، نه برای کسانی که در گورستان در خواب ابدی به سر می‌برند."],[878,"آن گروهی کز فقیری بی‌سرند","صد جهت زان مردگان فانی‌تراند","گروهی که به خاطر فقر و نداشتن سر و سامان اجتماعی، از زندگی معمولی دورند، در حقیقت از آن مردگان بی‌خبر، در جنبه‌های مختلف زندگی، بیشتر در معرض فنا و نابودی قرار دارند."],[878,"مرده از یک روست فانی در گزند","صوفیان از صد جهت فانی شدند","مردگان در یک روی با توجه به خطراتی که بر سر صوفیان وجود دارد، از صد جنبه دیگر هم از بین رفته و نابود شده‌اند."],[878,"مرگ یک قتلست و این سیصد هزار","هر یکی را خونبهایی بی‌شمار","مرگ، قتل محسوب می‌شود و این سیصد هزار نفر هر یک، دینی بزرگ به گردن دارند که باید پرداخت شود."],[878,"گرچه کشت این قوم را حق بارها","ریخت بهر خونبها انبارها","هرچند که خداوند به سبب اعمال این قوم، بارها خون آن‌ها را ریخته است، اما در عوض به خاطر خونبهای آن‌ها، مال و نعمت‌های فراوانی تجمع یافته است."],[878,"هم‌چو جرجیس‌اند هر یک در سرار","کشته گشته زنده گشته شصت بار","هر یک از این افراد مانند جرجیس (یکی از قدیسین که به خاطر ایمانش بارها کشته و زنده شده) هستند که به رغم هر بار کشتن، دوباره زنده می‌شوند و این انتظار زنده شدنشان شصت بار تکرار شده است."],[878,"کشته از ذوق سنان دادگر","می‌بسوزد که بزن زخمی دگر","عاشق که بر اثر مستقیم عشق و شوق، کشته و به مرگ دچار شده، از شوق و محبت، دلتنگی و آتش عشق را بیشتر تحمل می‌کند و او را می‌سوزاند؛ زیرا منتظر است که دوباره آن عشق را در خود احساس کند."],[878,"والله از عشق وجود جان‌پرست","کشته بر قتل دوم عاشق‌ترست","به خدا قسم، عشق وجودی که جان‌پرست است، کشته‌ای را که به خاطر عشقش کشته شده، از عشق به کشته شدن در مرتبه دوم عاشق‌تر نشان می‌دهد."],[878,"گفت قاضی من قضادار حیم","حاکم اصحاب گورستان کیم","قاضی می‌گوید که من قاضی هستم و هیچ‌کس بهتر از من در این زمینه نیست؛ من همان‌طور که حاکم بر مرده‌ها هستم، امور مربوط به گورستان را نیز مدیریت می‌کنم."],[878,"این به صورت گر نه در گورست پست","گورها در دودمانش آمدست","اگر این شخص (مرده) در هنگام مرگ به صورت ناپسند و مخفی در گور نرود، گورها در نسل او به چنین حالتی دچار خواهند شد."],[878,"بس بدیدی مرده اندر گور تو","گور را در مرده بین ای کور تو","ای نابینا، تو فقط مرده را در گور می‌بینی، اما باید توجه کنی که گور در حقیقت، جایی برای مرده است و تو نباید فقط به ظاهر آن نگاه کنی."],[878,"گر ز گوری خشت بر تو اوفتاد","عاقلان از گور کی خواهند داد","اگر بلوک‌های خشت از گوری بر سرت بیفتد، عاقلان از آن گور (یعنی از مرده‌ای که در گور است) چه فایده‌ای خواهند گرفت؟"],[878,"گرد خشم و کینه مرده مگرد","هین مکن با نقش گرمابه نبرد","به خاطر خشم و کینه مرده‌ها گرد و خاک نکن و با یاد و تصویر آنها درگیر مشو."],[878,"شکر کن که زنده‌ای بر تو نزد","کانک زنده رد کند حق کرد رد","سپاسگزار باش که زنده‌ای، زیرا زنده بودن باعث می‌شود که حق و حقیقت را تشخیص دهی و به آن پاسخ مثبت دهی."],[878,"خشم احیا خشم حق و زخم اوست","که به حق زنده‌ست آن پاکیزه‌پوست","خشم مخلوق از زنده‌بودن او نشأت گرفته و این خشم به خاطر حق است، زیرا او تنها به واسطه حق و حقیقت است که هنوز زنده است و این پوست پاک او نشانه‌ای از این حقیقت است."],[878,"حق بکشت او را و در پاچه‌ش دمید","زود قصابانه پوست از وی کشید","حق، او را کشت و سپس سریعا دم را در پای او دمید، مانند کسی که به‌طور حرفه‌ای پوست را از بدن می‌کند."],[878,"نفخ در وی باقی آمد تا ماب","نفخ حق نبود چو نفخه آن قصاب","نفخ یا دمیدن الهی در او همچنان باقی است، اما آن دمیدن که قصاب در او انجام داد، متفاوت است و نمی‌توان آنها را با هم مقایسه کرد."],[878,"فرق بسیارست بین النفختین","این همه زینست و آن سر جمله شین","بین دو نوع نفس‌گیری، تفاوت بسیار زیادی وجود دارد. یکی از آنها به زندگی حقیقی و معنوی مربوط می‌شود و دیگری تنها زودگذر و بی‌فایده است."],[878,"این حیات از وی برید و شد مضر","وان حیات از نفخ حق شد مستمر","این زندگی که از آن جدا شده از نفس و روح است و مضر و آسیب‌زننده است، اما زندگی که ناشی از دم و نفخ الهی است، دائمی و پایدار خواهد بود."],[878,"این دم آن دم نیست کاید آن به شرح","هین بر آ زین قعر چه بالای صرح","این لحظه با لحظه پیش فرق دارد، پس بر آنچه در پایین این قصر (= صرح) است، تجدید نظر کن."],[878,"نیستش بر خر نشاندن مجتهد","نقش هیزم را کسی بر خر نهد","مجتهد (فردی که صلاحیت فقهی دارد) را بر روی الاغ نشاندن، مانند این است که چوب هیزم را بر روی الاغ بگذارند. این عبارت به نوعی نشان‌دهنده بی‌احترامی یا نادرستی است و می‌گوید که مجتهد جایگاه و ارزشی والاتر از چوب هیزم دارد."],[878,"بر نشست او نه پشت خر سزد","پشت تابوتیش اولیتر سزد","نشستن بر روی خر به مانند نشستن بر روی تابوت است، زیرا اگر بخواهی کسی را مورد احترام قرار دهی، باید بر تابوت او بنشینی نه بر خر. در اینجا اشاره به این است که باید به مقام و منزلت هر کس توجه کرد."],[878,"ظلم چه بود وضع غیر موضعش","هین مکن در غیر موضع ضایعش","ظلم چیست؟ وقتی که چیزی در جای خود نباشد. پس از این لطفا در جایی که نباید، چیزی را ضایع نکن."],[878,"گفت صوفی پس روا داری که او","سیلیم زد بی‌قصاص و بی‌تسو","صوفی می‌گوید: آیا می‌پذیری که او ضربه‌ای به تو زده و تو بدون هیچ مجازاتی و بی‌آنکه قصاصی کنی، او را رها کنی؟"],[878,"این روا باشد که خر خرسی قلاش","صوفیان را صفع اندازد بلاش","این قابل قبول است که خر، یعنی افراد بی‌خبر و نادان، به راحتی صوفیانی را که برکت و مقام دارند، به ضربت بیندازند و موجب آزار آن‌ها شوند."],[878,"گفت قاضی تو چه داری بیش و کم","گفت دارم در جهان من شش درم","قاضی از صوفی می‌پرسد که آیا چیزی بیش از سه درم برای خرج کردن دارد یا خیر. صوفی پاسخ می‌دهد که در کل، او شش درم دارد."],[878,"گفت قاضی سه درم تو خرج کن","آن سه دیگر را به او ده بی‌سخن","قاضی می‌گوید که شما سه درم را برای خرج کردن بده و سه درم دیگر را به آن شخص تحویل بده بدون هیچ‌گونه بحث و جدلی."],[878,"زار و رنجورست و درویش و ضعیف","سه درم در بایدش تره و رغیف","او زاری رنجور، درویش و ضعیف است و برای زندگی‌اش به سه درم نیاز دارد که باید برای او تهیه شود."],[878,"بر قفای قاضی افتادش نظر","از قفای صوفی آن بد خوب‌تر","نگاه قاضی به پشت صوفی افتاد و متوجه شد که آن چیز بدی که در پشت صوفی است، از خود صوفی بهتر و زیباتر است."],[878,"راست می‌کرد از پی سیلیش دست","که قصاص سیلیم ارزان شدست","قاضی از روی انصاف و راستی به دنبال مجازات صوفی به خاطر سیلی‌ای که به او زده است، می‌رود و می‌گوید که مجازات این سیلی برای او ارزان تمام شده است."],[878,"سوی گوش قاضی آمد بهر راز","سیلیی آورد قاضی را فراز","آن شخص به سمت قاضی رفت تا رازی را بگوید و برای طرح دعوی مشکلش به قاضی مراجعه کرد."],[878,"گفت هر شش را بگیرید ای دو خصم","من شوم آزاد بی خرخاش و وصم","او می‌گوید که «ای دو دشمن»، هر شش نفر را بگیرید تا من از این ماجرا آزاد شوم و بی‌دردسر و بی‌نگرانی زندگی کنم."],[879,"گشت قاضی طیره صوفی گفت هی","حکم تو عدلست لاشک نیست غی","قاضی به شدت ناراحت و آشفته شد و به صوفی می‌گوید که حکم تو عادلانه است و شکی در آن نیست، اما در دل خود نسبت به او نارضایتی دارد."],[879,"آنچ نپسندی به خود ای شیخ دین","چون پسندی بر برادر ای امین","ای شیخ دین، چیزی را که برای خود نمی‌پسندی، چگونه می‌توانی برای برادر خود بپسندی؟"],[879,"این ندانی که می من چه کنی","هم در آن چه عاقبت خود افکنی","تو نمی‌دانی که نوشیدن می (شراب) چه تاثیری بر تو دارد و در عین حال، با همین کار خود را به چه سرنوشتی دچار خواهی کرد."],[879,"من حفر بئرا نخواندی از خبر","آنچ خواندی کن عمل جان پدر","من خبر حفر چاه را نخوانده‌ام، اما آنچه را درباره‌اش خوانده‌ام، عمل تو را که جان پدر است، توجیه می‌کند."],[879,"این یکی حکمت چنین بد در قضا","که ترا آورد سیلی بر قفا","این حکمت الهی به گونه‌ای است که تو را به اینجا رسانده که در قضاوت، سیلی (ضربه) بر گردن تو می‌زند و تو را به یاد اشتباهاتت می‌اندازد."],[879,"وای بر احکام دیگرهای تو","تا چه آرد بر سر و بر پای تو","وای بر قوانین و احکام دیگران که چه بلایی بر سر و پای تو خواهد آورد."],[879,"ظالمی را رحم آری از کرم","که برای نفقه بادت سه درم","اگر از روی بزرگواری و رحمت، به ظالمی رحم کنی، آن رحمتی نخواهد بود، زیرا او در حق نیازمندان چیز کمی مثل سه درم (درهم) هم خرج نمی‌کند و در واقع، احساس وظیفه و محبت در او وجود ندارد."],[879,"دست ظالم را ببر چه جای آن","که بدست او نهی حکم و عنان","اگر دست ظالم را بگیری و او را از قدرت و کنترل بر امور دور کنی، دیگر جایی برای او نخواهد بود که حکم و فرماندهی کند."],[879,"تو بدان بز مانی ای مجهول‌داد","که نژاد گرگ را او شیر داد","تو به یاد داشته باش که تو چه بسا در ظلمت و نادانی مانند بز مانده‌ای، در حالی که نژاد گرگ (حاکمان ظالم و ستمگران) هم از شیر (قدرت و قوت) بهره‌مند شده‌اند."],[880,"گفت قاضی واجب آیدمان رضا","هر قفا و هر جفا کارد قضا","قاضی می‌گوید آنچه لازم است، این است که ما راضی باشیم، چه در خوب یا بدی که fate (سرنوشت) برایمان رقم می‌زند."],[880,"خوش‌دلم در باطن از حکم زبر","گرچه شد رویم ترش کالحق مر","در باطن، دل من از حکم الهی خوشحال و شاد است، هر چند ظاهر من به خاطر حق، ناراحت و ترشرو به نظر می‌رسد."],[880,"این دلم باغست و چشمم ابروش","ابر گرید باغ خندد شاد و خوش","دل من مانند باغی سرسبز و شاداب است، و چشمانم به مانند ابری است که باعث بارش گریه می‌شود. وقتی دل شاد و خوشحال است، باغ نیز به شکوفه و شادی می‌پردازد."],[880,"سال قحط از آفتاب خیره‌خند","باغها در مرگ و جان کندن رسند","در سال‌های سخت و بی‌محصول که آفتاب نمی‌تابد، باغ‌ها به حال مرگ و نابودی در می‌آیند و گل‌ها و درختان به زحمت جان می‌دهند."],[880,"ز امر حق وابکوا کثیرا خوانده‌ای","چون سر بریان چه خندان مانده‌ای","از دستور و فرمان الهی بسیار گریه و زاری کن، چون کسی که گوشت او را بریده‌اند و او همچنان خندان باقی مانده است."],[880,"روشنی خانه باشی هم‌چو شمع","گر فرو پاشی تو هم‌چون شمع دمع","اگر در زندگی مانند شمع روشنی‌بخش باشی و به دیگران امید و نور بدهی، هنگام سقوط و ناامیدی‌ات هم مشابه شمع در خاموشی و تاریکی خواهی بود."],[880,"آن ترش‌رویی مادر یا پدر","حافظ فرزند شد از هر ضرر","این بیت به این معناست که هر پدر یا مادری که در روی فرزند تأثیر مثبت و محبت‌آمیزی دارد، می‌تواند او را از آسیب‌ها و مشکلات در امان نگه دارد. به عبارت دیگر، محبت والدین به فرزندانشان می‌تواند آن‌ها را در برابر سختی‌ها محافظت کند."],[880,"ذوق خنده دیده‌ای ای خیره‌خند","ذوق گریه بین که هست آن کان قند","اگر تو از خنده و شادی سرمست شده‌ای، باید بدانی که لذت و زیبایی گریه نیز وجود دارد که به اندازه آن شیرین و دلپذیر است."],[880,"چون جهنم گریه آرد یاد آن","پس جهنم خوشتر آید از جنان","وقتی یاد جهنم باعث گریه و اندوه می‌شود، در آن حالت جهنم به نظر زیباتر از بهشت می‌آید."],[880,"خنده‌ها در گریه‌ها آمد کتیم","گنج در ویرانه‌ها جو ای سلیم","خنده‌ها در گریه‌ها نهفته است و ما باید گنجی را که در مکان‌های خراب و ویران وجود دارد، پیدا کنیم، ای سلیم (سلیم، نامی برای اشاره به فردی خاص است)."],[880,"ذوق در غمهاست پی گم کرده‌اند","آب حیوان را به ظلمت برده‌اند","در دل غم‌ها هم شادی و ذوق وجود دارد، ولی تنها کسانی که آب حیات را گم کرده‌اند، این را نمی‌بینند و در تاریکی به سر می‌برند."],[880,"بازگونه نعل در ره تا رباط","چشمها را چار کن در احتیاط","نعل زدن به راه یعنی راه را برای کسی هموار کردن و آماده‌سازی آن. از طرفی، به احتیاط و مراقبت در نگاه کردن تأکید می‌شود، تا چشم‌ها را در صحت و اعتبار حفاظت کنیم."],[880,"چشمها را چار کن در اعتبار","یار کن با چشم خود دو چشم یار","چشم‌هایت را از نظر به یار پر کن و با دل خود او را بنگر، تا او را بهتر بشناسی."],[880,"امرهم شوری بخوان اندر صحف","یار را باش و مگوش از ناز اف","به کارهای آنها توجه کن و در کتاب دل یار را تماشا کن، و از ناز و لحن آن غافل مشو."],[880,"یار باشد راه را پشت و پناه","چونک نیکو بنگری یارست راه","یار به‌سوی راه، هم محافظ و هم پشتیبان است؛ وقتی خوب به آن نگاه کنی، می‌بینی که در واقع، خود یار همان راه است."],[880,"چونک در یاران رسی خامش نشین","اندر آن حلقه مکن خود را نگین","وقتی به جمع یاران رسیدی، باید ساکت باشی و در آن جمع فقط بنشینی و از خودت نشان ندهی، مانند نگینی که در حلقه دیگران جای دارد و نه بیشتر."],[880,"در نماز جمعه بنگر خوش به هوش","جمله جمعند و یک‌اندیشه و خموش","در نماز جمعه، به خوبی توجه کن که همه‌ی مؤمنان باهوش و هوشیار جمع شده‌اند و با همفکری و سکوت در کنار یکدیگر قرار دارند."],[880,"رختها را سوی خاموشی کشان","چون نشان جویی مکن خود را نشان","لباس‌هایت را به سوی سکوت و آرامش ببر و وقتی به جستجوی نشانه‌ای هستی، خودت را آشکار نکن."],[880,"گفت پیغامبر که در بحر هموم","در دلالت دان تو یاران را نجوم","پیامبر فرمود که در دریای افکار و مشکلات، شما یاران باید به علم نجوم (راهنمایی از طریق طبیعت و حرکات اجرام آسمانی) توجه کنید تا راه را پیدا کنید."],[880,"چشم در استارگان نه ره بجو","نطق تشویش نظر باشد مگو","به ستاره‌ها نگاه نکن و در جستجوی راه نباش؛ زیرا سخن در آشفتگی نگاه، گفتن ندارد."],[880,"گر دو حرف صدق گویی ای فلان","گفت تیره در تبع گردد روان","اگر تو دو کلمه حقیقت بگویی، ای فلان، سخن تاریک و ناپسند به دنبال آن برمی‌خیزد و جان را تحت تأثیر قرار می‌دهد."],[880,"این نخواندی کالکلام ای مستهام","فی شجون جره جر الکلام","ای مستهام (عاشق) که در جدایی و نابسامانی به سر می‌بری، این کلام را نخواندی و در آن غور نکردی؛ کلام به تو زندگی می‌دهد و حال تو را دگرگون می‌کند."],[880,"هین مشو شارع در آن حرف رشد","که سخن زو مر سخن را می‌کشد","مراقب باش که در صحبت‌های بی‌فایده و نامناسب غرق نشوی، زیرا این نوع سخن می‌تواند تو را از فهم درست دور کند و سخن واقعی را از تو بگیرد."],[880,"نیست در ضبطت چو بگشادی دهان","از پی صافی شود تیره روان","اگر دهان تو باز شود و کلام را به درستی ضبط کنی، آن‌گاه روح تو از تاریکی به روشنی می‌رسد و صاف می‌شود."],[880,"آنک معصوم ره وحی خداست","چون همه صافست بگشاید رواست","آن کسی که معصوم و بی‌عیب است و پیام وحی خدا را می‌آورد، چون همه چیز در او پاک و واضح است، می‌تواند به راحتی و بدون هیچ مانعی سخن بگوید."],[880,"زانک ما ینطق رسول بالهوی","کی هوا زاید ز معصوم خدا","زیرا پیامبر (رسول) هرگز بر اساس هوای نفس سخن نمی‌گوید، بلکه آنچه می‌گوید، از معصومیت الهی او ناشی می‌شود."],[880,"خویشتن را ساز منطیقی ز حال","تا نگردی هم‌چو من سخره مقال","خودت را بر اساس منطقی که به حال و وضع تو می‌خورد، بساز تا گرفتار طعنه و تمسخر سخنان دیگران نشوی."],[881,"گفت صوفی چون ز یک کانست زر","این چرا نفعست و آن دیگر ضرر","صوفی می‌پرسد اینکه هر دو از یک منبع (کان) یعنی طلا (زر) به وجود آمده‌اند، چرا یکی سودآور است و دیگری زیان‌آور؟"],[881,"چونک جمله از یکی دست آمدست","این چرا هوشیار و آن مست آمدست","چون همه از یک سرچشمه و منبع نشأت یافته‌اند، پس چرا برخی هوشیار و برخی دیگر مست و بی‌خبرند؟"],[881,"چون ز یک دریاست این جوها روان","این چرا نوش است و آن زهر دهان","چون این جوی‌ها از یک دریا جاری‌اند، پس چرا یکی از آن‌ها شیرین و خوشمزه است و دیگری تلخ و زهرآگین به نظر می‌رسد؟"],[881,"چون همه انوار از شمس بقاست","صبح صادق صبح کاذب از چه خاست","همه نورها و روشنی‌ها از خورشید بقا، یعنی خورشید حقیقی، به وجود آمده‌اند؛ پس این صبح دروغین و کاذب از کجا آمده است؟"],[881,"چون ز یک سرمه‌ست ناظر را کحل","از چه آمد راست‌بینی و حول","اگر همه چیز از نور «شمس بقا» نشأت می‌گیرد، پس دلیل وجود کحل برای دیدن چیست؟ چون ناظر (ببینده) باید از یک سرمه (درخشندگی) استفاده کند تا به درستی ببیند و بفهمد."],[881,"چونک دار الضرب را سلطان خداست","نقد را چون ضرب خوب و نارواست","چون عالم هستی مانند سکه‌ای است که خداوند بر آن سلطه دارد، ارزش و قیمت هر چیز بر اساس خوب یا بد بودن آن تعیین می‌شود."],[881,"چون خدا فرمود ره را راه من","این خفیر از چیست و آن یک راه‌زن","وقتی خداوند فرمود که این مسیر، مسیر من است، این مرد زهد کرده (خفیر) از چه روست و آن دزد (راه‌زن) چه کسی است؟"],[881,"از یک اشکم چون رسد حر و سفیه","چون یقین شد الولد سر ابیه","وقتی که اشک من مانند آتش داغ و سوزان است، آیا بی‌خود و ناآگاه، فرزند نیز به یقین از پدر خود بی‌خبر می‌شود؟"],[881,"وحدتی که دید با چندین هزار","صد هزاران جنبش از عین قرار","وحدتی که میان همه حرکات و جنبش‌ها وجود دارد، از یک اصل ثابت و آرامش سرچشمه می‌گیرد."],[882,"گفت قاضی صوفیا خیره مشو","یک مثالی در بیان این شنو","قاضی صوفی به افراد صوفی توصیه می‌کند که خیره نشوند و به جای آن، مثالی را که او بیان می‌کند، گوش کنند تا بهتر درک کنند."],[882,"هم‌چنانک بی‌قراری عاشقان","حاصل آمد از قرار دلستان","بی‌قراری عاشقان از ثبات دلبران سرچشمه می‌گیرد؛ یعنی وقتی دلبر در آرامش و ثبات است، عاشقان به شدت بی‌قرار و ناآرام می‌شوند."],[882,"او چو که در ناز ثابت آمده","عاشقان چون برگها لرزان شده","وقتی او با ناز و زیبایی در جمع ظاهر می‌شود، عاشقان مانند برگ‌های درختان که در باد می‌لرزند، ناآرام و مضطرب می‌شوند."],[882,"خنده او گریه‌ها انگیخته","آب رویش آب روها ریخته","خنده او باعث شده که دیگران به گریه بیفتند و اشکشان بریزد، به گونه‌ای که آب صورتش بر روی صورت‌های دیگر می‌ریزد."],[882,"این همه چون و چگونه چون زبد","بر سر دریای بی‌چون می‌تپد","این همه تأملات و سوالات درباره حقیقت و هستی مانند خامه‌ای است که بر روی دریای بی‌نهایت (دریای بی‌چون) می‌رقصد و تلاطم می‌کند."],[882,"ضد و ندش نیست در ذات و عمل","زان بپوشیدند هستیها حلل","در ذات و عمل هیچ ضد و نقیضی وجود ندارد؛ بلکه وجود آنها را پوشانده‌اند و هستی‌های متفاوت را به صورت ظاهری نمایان کرده‌اند."],[882,"ضد ضد را بود و هستی کی دهد","بلک ازو بگریزد و بیرون جهد","ضد و نقیض نمی‌تواند یکدیگر را ایجاد کند و هستی از آن‌ها به وجود نمی‌آید، بلکه باید از آن‌ها دوری جست و به سمت دیگری رفت."],[882,"ند چه بود مثل مثل نیک و بد","مثل مثل خویشتن را کی کند","مثل خوب و بد هر کدام نمونه‌ای از خود هستند، اما انسان نمی‌تواند صرفا شبیه خود را در نظر بگیرد."],[882,"چونک دو مثل آمدند ای متقی","این چه اولیتر از آن در خالقی","ای پرهیزگار، زمانی که دو مثال به وجود می‌آید، این کدام یک به خالق نزدیک‌تر و مهم‌تر است؟"],[882,"بر شمار برگ بستان ند و ضد","چون کفی بر بحر بی‌ضدست و ند","در بستان، برگ‌ها را نمی‌توان برشمرد و ضدها (نقص‌ها) آنها هم وجود ندارد، همان‌طور که کف بر روی دریا، بی‌ضد (یعنی بدون نقص) است و به تنهایی قابلیت گنجاندن در عمق دریا را ندارد."],[882,"بی‌چگونه بین تو برد و مات بحر","چون چگونه گنجد اندر ذات بحر","بدون هیچ قضاوت و نظر، وجود تو و دیگران مثل قطره‌ای در دریا است و در حقیقت نمی‌توان دریا را از آن جدا کرد. دریا می‌تواند خود را به‌طور نامشخص در ذات دیگران پنهان کند."],[882,"کمترین لعبت او جان تست","این چگونه و چون جان کی شد درست","کمترین جلوه او، جان توست. این چگونه ممکن است و جان کی به درستی پدیدار شده است؟"],[882,"پس چنان بحری که در هر قطر آن","از بدن ناشی‌تر آمد عقل و جان","عقل و جان انسان به اندازه‌ای وسیع و عمیق هستند که اگر در هر قطره از این دریا تفکری وجود داشته باشد، هیچ چیز از آن فراتر نمی‌رود. به عبارتی دیگر، عقل و جان انسان بی‌نهایت و وسعت‌دارند."],[882,"کی بگنجد در مضیق چند و چون","عقل کل آنجاست از لا یعلمون","چگونه می‌تواند عقل کل در شریط تنگ و محدود قرار گیرد، در حالی که او در آنجا هست که نمی‌توان به دانسته‌هایش دست یافت؟"],[882,"عقل گوید مر جسد را که ای جماد","بوی بردی هیچ از آن بحر معاد","عقل به جسم غیرزنده (جماد) می‌گوید که تو هیچ شعوری از آن دریای معاد نداری و بویی از آن نبرده‌ای."],[882,"جسم گوید من یقین سایه توم","یاری از سایه که جوید جان عم","جسم می‌گوید که من فقط سایه‌ای از تو هستم و یاری نمی‌توانم از سایه بیابم، زیرا جان اصلی از آن سایه دور است."],[882,"عقل گوید کین نه آن حیرت سراست","که سزا گستاخ‌تر از ناسزاست","عقل می‌گوید که اینجا جای حیرت و شگفتی نیست و این حالت، به خاطر گستاخی و بی‌ادبی به کسی نیست."],[882,"اندرینجا آفتاب انوری","خدمت ذره کند چون چاکری","در اینجا آفتاب انوری (به معنای آفتاب نورانی و تابان) به گونه‌ای به ذره (کوچک‌ترین واحد شناخته‌شده از ماده) خدمت می‌کند مثل یک چاکر (خادم یا خدمتکار). این تصویر نشان‌دهنده humble و تواضع نور و بزرگی در برابر کوچک‌ترهاست."],[882,"شیر این سو پیش آهو سر نهد","باز اینجا نزد تیهو پر نهد","شیر به شکار و کشتن آهو می‌آید، اما در اینجا (نزد تیهو) به جای کشتن، پرواز می‌کند و به نوعی به آرامی و صلح رفتار می‌کند. این موضوع نشان‌دهنده‌ی تغییر رفتار یا تغییر هدف در موقعیت‌ها است."],[882,"این ترا باور نیاید مصطفی","چون ز مسکینان همی‌جوید دعا","این که تو چنین سخنی را باور نمی‌کنی، ای مصطفی (پیامبر)، به خاطر این است که او از میان شما مسکینان (نیازمندان) دعا می‌جوید و نمی‌بیند."],[882,"گر بگویی از پی تعلیم بود","عین تجهیل از چه رو تفهیم بود","اگر بگویی که هدف از آموزش، یاد دادن است، پس چرا حقیقتا باعث گیجی و نادانی می‌شود؟"],[882,"بلک می‌داند که گنج شاهوار","در خرابیها نهد آن شهریار","او می‌داند که ثروت واقعی و ارزشمند مانند گنج، در میان دشواری‌ها و مشکلات قرار دارد، همان‌طور که شهریار (حاکم) در دوران افت و خرابی نیز به گنج‌های خود دسترسی خواهد داشت."],[882,"بدگمانی نعل معکوس ویست","گرچه هر جزویش جاسوس ویست","بدگمانی مانند نعل معکوس است؛ هرچند در هر جزئی از آن، نشانه‌هایی از نظر دیگران وجود دارد."],[882,"بل حقیقت در حقیقت غرقه شد","زین سبب هفتاد بل صد فرقه شد","حقیقت در حقیقت غرق شده و به همین دلیل، از آن تعداد زیادی فرقه‌ها به وجود آمده‌اند."],[882,"با تو قلماشیت خواهم گفت هان","صوفیا خوش پهن بگشا گوش جان","من می‌خواهم با تو درباره حقیقت سخن بگویم، ای صوفی، پس خوب است که گوش جانت را باز کنی و بشنوی."],[882,"مر ترا هم زخم که آید ز آسمان","منتظر می‌باش خلعت بعد آن","منتظر باش که بعد از آن زخم‌هایی که از آسمان به تو می‌رسد، پاداش‌هایی نیز نصیبت خواهد شد."],[882,"کو نه آن شاهست کت سیلی زند","پس نبخشد تاج و تخت مستند","نه اینکه او شاهی است که وقتی به تو سیلی زد پس از آن نبخشد تاج و تختی به تو"],[882,"جمله دنیا را پر پشه بها","سیلیی را رشوت بی‌منتها","تمام دنیا مانند پشه‌ای است، و سرنوشت سیلی بدون حد و مرز، به معنای اینکه در این دنیا هر چیزی می‌تواند با ارزش و پر بها به نظر برسد اما در واقع خیلی بی‌ارزش و زودگذر است."],[882,"گردنت زین طوق زرین جهان","چست در دزد و ز حق سیلی ستان","این بیت به نوعی از دنیاپرستی و فریبندگی آن اشاره دارد. پیغام این است که دنیا مانند طوق زرینی است که بر گردن انسان است و باعث می‌شود او در دنیا به دنبال دزدی و حق‌کشی برود، در حالی که باید به حق توجه کند و به جای آزار دیگران، از حقوق آنان دفاع کند."],[882,"آن قفاها که انبیا برداشتند","زان بلا سرهای خود افراشتند","انبیا (پیامبران) از مشکلات و بلایایی که بر آن‌ها وارد شد، درس‌های بزرگی گرفتند و با قدرت و سر بلندی برآمدند."],[882,"لیک حاضر باش در خود ای فتی","تا به خانه او بیابد مر ترا","ولی ای جوان! در خودت حضور داشته باش و هوشیار باش تا بتوانی به خانه او (خدا) راه پیدا کنی."],[882,"ورنه خلعت را برد او باز پس","که نیابیدم به خانه‌ش هیچ کس","اگر او به خانه‌اش برنگردد، لباس و هدیه‌ای که برایش آماده شده را به او پس می‌دهد، زیرا هیچ‌کس به خانه‌اش نمی‌رود."],[883,"گفت صوفی که چه بودی کین جهان","ابروی رحمت گشادی جاودان","صوفی پرسید که مگر چه چیزی در این جهان باعث شده که ابروی رحمت برای همیشه باز شود؟"],[883,"هر دمی شوری نیاوردی به پیش","بر نیاوردی ز تلوینهاش نیش","هر لحظه‌ای شور و هیجان جدیدی به وجود نیاورده‌ای و از نشانه‌های مختلف او، آسیب و آزارهایی به ما نرسانده‌ای."],[883,"شب ندزدیدی چراغ روز را","دی نبردی باغ عیش آموز را","شما در شب باید از روشنایی روز استفاده می‌کردید و فکر نکردید که این نور می‌تواند به شما کمک کند تا در باغ خوشی‌ها و لذت‌ها بیشتر بیاموزید."],[883,"جام صحت را نبودی سنگ تب","آمنی با خوف ناوردی کرب","اگر نبودی در این مسیر سنگینی و سختی بیماری، به آرامش و سلامتی دست می‌یافتی و بدون ترس به مرحله دشوار و امتحانی نمی‌رسیدی."],[883,"خود چه کم گشتی ز جود و رحمتش","گر نبودی خرخشه در نعمتش","تو چه کم از بخشندگی و رحمتی که خودت را از نعمت‌های او محروم کردی و با نافرمانی‌ات در این نعمت‌ها مانع ایجاد کردی."],[884,"گفت قاضی بس تهی‌رو صوفیی","خالی از فطنت چو کاف کوفیی","قاضی گفت: صوفی، بی‌فهم و خالی از درک است، مثل کافر کوفی که چیزی از حقیقت نمی‌فهمد."],[884,"تو بنشنیدی که آن پر قند لب","غدر خیاطان همی‌گفتی به شب","تو شنیدی که آن شخص شیرین‌گو، مثل خیاط‌ها در شب از خیانت سخن می‌گفت."],[884,"خلق را در دزدی آن طایفه","می‌نمود افسانه‌های سالفه","او (صوفی) برای مردم داستان‌های گذشته را از دزدی آن گروه (خیاطان) روایت می‌کرد و آن‌ها را متوجه می‌ساخت."],[884,"قصه پاره‌ربایی در برین","می حکایت کرد او با آن و این","او (صوفی) داستانی از دزدی و پاره‌ربایی را در این دنیا برای دیگران بازگو می‌کرد و به شرح آن می‌پرداخت."],[884,"در سمر می‌خواند دزدی‌نامه‌ای","گرد او جمع آمده هنگامه‌ای","در سمر، دزدی‌نامه‌ای را می‌خواندند و در اطراف او جمعیتی به هم ریخته و شلوغ شده بود."],[884,"مستمع چون یافت جاذب زان وفود","جمله اجزااش حکایت گشته بود","وقتی شنوندگان متوجه شدند که جاذبه‌ای در آن جمع وجود دارد، همه‌ی اجزای داستان به یکدیگر پیوسته و شکل یک روایت شده بودند."],[885,"جذب سمعست ار کسی را خوش لبیست","گرمی و جد معلم از صبیست","اگر کسی خوش‌صحبت باشد، به راحتی توجه شنونده را جلب می‌کند و این امر نشان‌دهنده‌ی استعداد و جدیت معلم در تربیت او از زمان کودکی است."],[885,"چنگیی را کو نوازد بیست و چار","چون نیابد گوش گردد چنگ بار","چنگ (ساز موسیقی) وقتی‌که نوازنده‌اش را دارد و بیست و چهار نوا (نت) را می‌زند، خوب و دلنشین می‌نوازد؛ اما اگر مخاطبی برای شنیدن نباشد، ساز بی‌صدا و بی‌حس می‌شود."],[885,"نه حراره یادش آید نه غزل","نه ده انگشتش بجنبد در عمل","او نه یاد حرارت و عشق را می‌داند و نه غزل و شعر را به خاطر می‌آورد، و حتی در عمل هم نمی‌تواند حرکتی انجام دهد و انگشتانش تکان نمی‌خورد."],[885,"گر نبودی گوشهای غیب‌گیر","وحی ناوردی ز گردون یک بشیر","اگر گوش‌های حساس به پیام‌های الهی وجود نداشت، از آسمان هیچ بشارتی به ما نمی‌رسید."],[885,"ور نبودی دیده‌های صنع‌بین","نه فلک گشتی نه خندیدی زمین","اگر چشمان تو هنر دیدن و درک آفرینش را نداشت، نه آسمان به دور خود می‌چرخید و نه زمین شادی می‌کرد."],[885,"آن دم لولاک این باشد که کار","از برای چشم تیزست و نظار","این شعر به این معناست که لحظه‌ای که تو با دقت و توجه به موضوعی نگاه می‌کنی، می‌تواند نتیجه‌ای ارزشمند و عمیق به همراه داشته باشد. تیزبینی و آگاهی در مشاهده‌ی پدیده‌ها، کلید درک واقعیات عمیق‌تر از زندگی است."],[885,"عامه را از عشق هم‌خوابه و طبق","کی بود پروای عشق صنع حق","عوام مردم، عشق را با عشق‌های معمولی و دنیوی اشتباه می‌کنند و به دنبال عشق مادی هستند، اما عشق حقیقی و الهی، مربوط به محبت و توجه به خداوند است و بیشتر از آن برای کسانی است که درک بالایی دارند و به معنای عمیق‌تری از عشق توجه دارند."],[885,"آب تتماجی نریزی در تغار","تا سگی چندی نباشد طعمه‌خوار","اگر در ظرفی آب نریزی، به این معنا که در دل وجودت محبت و شفقت نداشته باشی، سگی که در آن بستر وجود دارد، به طعمه‌ای تبدیل می‌شود و از تو بهره‌برداری می‌کند. این بیت تأکید دارد بر لزوم محبت و نیکی تا از آسیب‌های دنیوی در امان بمانی."],[885,"رو سگ کهف خداوندیش باش","تا رهاند زین تغارت اصطفاش","ای سگ، تو نباید به فکر لقمه‌خواری باشی، بلکه باید مایه‌ی نجات و راهنمایی دیگران باشی تا از این مشکلات و سختی‌ها رهایی یابند."],[885,"چونک دزدیهای بی‌رحمانه گفت","کی کنند آن درزیان اندر نهفت","اگر دزدان بی‌رحم و ظالمی به سراغ کسی بیایند، او چگونه می‌تواند به آنها پنهانی پناهنده شود و از این وضعیت رهایی یابد؟"],[885,"اندر آن هنگامه ترکی از خطا","سخت طیره شد ز کشف آن غطا","در آن موقعیت، ترک‌زبان (ترکی) از کشف آن راز (خفا) به شدت عصبی و ناراحت شد."],[885,"شب چو روز رستخیز آن رازها","کشف می‌کرد از پی اهل نهی","در آن شب، مانند روز قیامت، رازهایی را فاش می‌کرد که مختص کسانی بود که از کارهای ناپسند بازمی‌ایستادند."],[885,"هر کجا آیی تو در جنگی فراز","بینی آنجا دو عدو در کشف راز","هر کجا که به میدان جنگ بروی، آنجا دو دشمن را می‌بینی که به کشف رموز و اسرار مشغول‌اند."],[885,"آن زمان را محشر مذکور دان","وان گلوی رازگو را صور دان","در آن زمان که محشر و قیامت از آن یاد شده است، آن کس که رازها را فاش می‌کند، مثل صور است که در روز قیامت برای بیداری و احیا وزیده می‌شود."],[885,"که خدا اسباب خشمی ساختست","وآن فضایح را بکوی انداختست","خداوند عواملی برای خشم درست کرده و آن عیب‌ها را به میان مردم آورده است."],[885,"بس که غدر درزیان را ذکر کرد","حیف آمد ترک را و خشم و درد","به قدری از خیانت‌های زینت‌دار (ظاهر فریبنده) سخن گفته شد که احساس می‌شود ترک (مرد ترک‌نژاد) را هم دلش به درد آمده و از خشم و اندوه ناراحت شده است."],[885,"گفت ای قصّاص در شهر شما","کیست استاتر درین مکر و دغا","در این بیت، گوینده از قصه‌گویان (قصاص) می‌پرسد در شهر شما چه کسی است، که در زمینه مکر و فریب (دغا) استاد است؟ این سوال به نوعی نشان‌دهنده نگرانی از فریبکاری در جامعه است."],[886,"گفت خیاطیست نامش پور شش","اندرین چستی و دزدی خلق‌کش","خیاطی به نام پور شش وجود دارد که در کارش بسیار ماهر و در عین حال دزد است و مردم را به زحمت می‌اندازد."],[886,"گفت من ضامن که با صد اضطراب","او نیارد برد پیشم رشته‌تاب","خیاط می‌گوید که من ضمانت می‌کنم که او (درزی) با تمام اضطراب و پریشانی‌اش، نمی‌تواند حتی یک رشته از کارش را به جایی ببرد."],[886,"پس بگفتندش که از تو چست‌تر","مات او گشتند در دعوی مپر","به او گفتند که در این دعوا، هوشیارتر و زیرک‌تر از تو وجود ندارد و از این لحاظ در دعوی خود مغبون نخواهی شد."],[886,"رو به عقل خود چنین غره مباش","که شوی یاوه تو در تزویرهاش","به خودت مغرور نشو و فریب عقیده‌ات را نخور که ممکن است در دروغگویی‌ها و فریب‌ها قرار بگیری."],[886,"گرم‌تر شد ترک و بست آنجا گرو","که نیارد برد نی کهنه نی نو","ترک (مرد ترک) در آنجا خشمگین‌تر شد و چیزی را گرو گذاشت که نه کالای کهنه را می‌تواند ببرد و نه کالای نو را."],[886,"مطمعانش گرم‌تر کردند زود","او گرو بست و رهان را بر گشود","به دلیل شدت و شوقی که او (ترک) پیدا کرد، سریعا گرو (به ضمانت) داد و در نتیجه راه را برای آزادی دیگران باز کرد."],[886,"که گرو این مرکب تازی من","بدهم ار دزدد قماشم او به فن","اگر که کسی بخواهد مرکب تازی (اسب عربی) مرا به گرو بگیرد، باید آگاه باشد که اگر دزدی و خودخواهی کند، من هم او را به فن و مهارتم در کارش پی می‌برم و دستش را رو می‌کنم."],[886,"ور نتاند برد اسپی از شما","وا ستانم بهر رهن مبتدا","اگر نتواند اسب شما را ببرد، من برای گرو گرفتن او چیزی از شما نخواهم گرفت."],[886,"ترک را آن شب نبرد از غصه خواب","با خیال دزد می‌کرد او حراب","ترک در آن شب نتوانست بخوابد و به خاطر نگرانی از دزد، در خواب‌هایش نیز در فکر دزدی بود و آرامش نداشت."],[886,"بامدادان اطلسی زد در بغل","شد به بازار و دکان آن دغل","صبحگاهان، او با دل‌خوشی و شوق، عطر اطلسی را در آغوش گرفت و به بازار و دکانی رفت که در آن کارهای فریبنده (دغل) انجام می‌شود."],[886,"پس سلامش کرد گرم و اوستاد","جست از جا لب به ترحیبش گشاد","خود را معرفی کرد و به او سلام کرد و استاد (در واقع معلم یا راهنما) از جایش برخاست و به او روی کرد و با روی خوش به استقبالش رفت."],[886,"گرم پرسیدش ز حد ترک بیش","تا فکند اندر دل او مهر خویش","با گرمی از او پرسید که آیا از مرز ترک گذشته است یا نه، تا بتواند محبت و مهر خود را در دل او بینشاند."],[886,"چون بدید از وی نوای بلبلی","پیشش افکند اطلس استنبلی","وقتی آن مرد صدای بلبل را از او شنید، نگاهی به او انداخت و متوجه شد که او پارچه نازکی از نوع اطلس استنبلی را به نمایش گذاشته است."],[886,"که ببر این را قبای روز جنگ","زیر نافم واسع و بالاش تنگ","منظور از این بیت این است که در روز جنگ، قبای وسیع و مورد نیازم را که زیر نافی بسته می‌شود، ببر. این اشاره به نیاز به یک لباس مناسب برای جنگ دارد که هم در زیر ناحیه‌ی خاصی (ناف) قرار می‌گیرد و هم باید تنگ باشد تا مناسب باشد."],[886,"تنگ بالا بهر جسم‌آرای را","زیر واسع تا نگیرد پای را","بالا (یعنی سرپوش) تنگ است برای کسی که به زیبایی و آرایش جسمش اهمیت می‌دهد، زیرا صفت گشادی (وسیع) زیر آن است تا پایی (زیر پایش) را نگیرد."],[886,"گفت صد خدمت کنم ای ذو وداد","در قبولش دست بر دیده نهاد","گفت: ای صاحب وفا، من هزاران خدمات به تو انجام می‌دهم و در نشانه احترام، دستم را بر روی چشمانم گذاشته‌ام."],[886,"پس بپیمود و بدید او روی کار","بعد از آن بگشاد لب را در فشار","پس از اینکه آن شخص (که در اینجا از او صحبت می‌شود) قدمی برداشت و چهره کار را مشاهده کرد، سپس لبانش را در حالی که مضطرب بود، گشود و سخن گفت."],[886,"از حکایتهای میران دگر","وز کرمها و عطاء آن نفر","از داستان‌های دیگر میران (پادشاهان) و از بخشش‌ها و عطایای آن شخص (نفر) سخن می‌گوید."],[886,"وز بخیلان و ز تحشیراتشان","از برای خنده هم داد او نشان","این بیت بیان می‌کند که از بخل و کینه‌ورزی طماعان و محدودیت‌های آنها چیزی جز نشان خنده و تمسخر به‌دست نمی‌آید. در واقع، اشاره به این دارد که اعمال بخیلان و وضعیت تحمیلی آنها بیشتر باعث خنده و بی‌اهمیتی‌ است تا جدی گرفته شدن."],[886,"هم‌چو آتش کرد مقراضی برون","می‌برید و لب پر افسانه و فسون","انسانی شبیه به آتش، کسانی را که به او بدی کرده‌اند، می‌سوزاند و از دهنش حرف‌های جذاب و پر از افسانه و فریب بیرون می‌آید."],[887,"ترک خندیدن گرفت از داستان","چشم تنگش گشت بسته آن زمان","ترک (که به معنای مرد ترک است) از خندیدن درباره داستان چشم تنگش خودداری کرد و در آن زمان چشمانش به سبب گریه یا ناراحتی بسته شد."],[887,"پاره‌ای دزدید و کردش زیر ران","از جز حق از همه احیا نهان","دزدیدن بخشی از حقیقت و پنهان کردن آن از دیگران را بیان می‌کند. این عمل، نشان‌دهنده این است که او فقط به حقوق خود توجه دارد و نه به باقی امور. در واقع، او چیزی را از منابع غیرحق به دست آورده و آن را در سایه‌ای از وجود پنهان کرده است."],[887,"حق همی‌دید آن ولی ستارخوست","لیک چون از حد بری غماز اوست","حق (خدا) می‌دید که آن ولی (انسان کامل) ستار است و عیب‌ها را می‌پوشاند، اما وقتی که از حد خود خارج شود، موجب غیبت و بیان عیوب او می‌شود."],[887,"ترک را از لذت افسانه‌اش","رفت از دل دعوی پیشانه‌اش","ترک به واسطه لذت داستانش، از دلش احساساتی بیرون رفت که نشان‌دهنده ادعای خود در مورد ویژگی‌های ظاهری‌اش بود."],[887,"اطلس چه دعوی چه رهن چی","ترک سرمستست در لاغ اچی","اطلس (پارچه‌ای با نقش و نگار زیبا) چه ادعایی دارد و چه درخواستی می‌تواند داشته باشد، وقتی که یک ترک (مرد ترک) سرمست و شاداب است در حالی که لاغر و نحیف به نظر می‌آید."],[887,"لابه کردش ترک کز بهر خدا","لاغ می‌گو که مرا شد مغتذا","ترک، که به سبب خدا لابه و ناله می‌کند، به لاغی می‌گوید که من به خاطر تو عذاب و سختی را تحمل کرده‌ام."],[887,"گفت لاغی خندمینی آن دغا","که فتاد از قهقهه او بر قفا","ترک گفت: من از خوشحالی می‌خندم، اما در واقع این نیرنگ است که باعث شده این خنده از او بر چهره‌اش بیفتد."],[887,"پاره‌ای اطلس سبک بر نیفه زد","ترک غافل خوش مضاحک می‌مزد","ترکی که بی‌خبر است، با شادی و شوخی، به وسیله پاره‌ای از پارچه نازک و سبک، بر زیر بغلش می‌زند."],[887,"هم‌چنین بار سوم ترک خطا","گفت لاغی گوی از بهر خدا","ترک به شوخی و به خاطر خنده، بار دیگر به درزی (که احتمالا به او دقت می‌شود) می‌گوید که لاغر به نظر می‌آید و این را فقط برای خوشایند و به خاطر خدا می‌گوید."],[887,"گفت لاغی خندمین‌تر زان دو بار","کرد او این ترک را کلی شکار","ترک که به لاغی و خنده مشهور است، می‌گوید که خنده‌اش بیشتر از آن دو بار است و به همین دلیل هر بار می‌تواند این ترک را به‌طور کامل شکار کند."],[887,"چشم بسته عقل جسته مولهه","مست ترک مدعی از قهقهه","چشم‌های عقل بسته شده و به حالتی مست و سرخوش درآمده است، در حالی که ترک مدعی به خاطر خنده و شادمانی در حال شگفتی و تفرج است."],[887,"پس سوم بار از قبا دزدید شاخ","که ز خنده‌ش یافت میدان فراخ","این بیت می‌گوید پس از اینکه سومی، ترک (شخصیتی در داستان) از لباس (قبا) دزدید، با خنده‌ای که کرده بود، فضایی باز و وسیع یافت. این نشان‌دهنده تأثیر خنده و شادی بر موقعیت اوست."],[887,"چون چهارم بار آن ترک خطا","لاغ از آن استا همی‌کرد اقتضا","در این بیت، مولانا به نقش استاد و آموزش‌دهنده اشاره می‌کند که بار دیگر به یک ترک (نوجوان یا جوان) که خطایی کرده، فرصتی برای اصلاح می‌دهد، زیرا استاد می‌بیند که او هنوز لاغر و ضعیف است و از این رو رحمت بر او آورده و فرصت دیگری برای اصلاح به او می‌دهد."],[887,"رحم آمد بر وی آن استاد را","کرد در باقی فن و بیداد را","استاد به حال آن ترک رحم کرد و برای او رحم و دلسوزی نشان داد، زیرا در زمینه هنر و مهارت، به او حسرت و بی‌عدالتی را احساس کرده بود."],[887,"گفت مولع گشت این مفتون درین","بی‌خبر کین چه خسارست و غبین","مولع، یعنی دلبسته و شیدا، از این ترک (درزی) پرسیده است که او در بی‌خبری خود چه زیان و نقصان بزرگی را وارد می‌کند."],[887,"بوسه‌افشان کرد بر استاد او","که بمن بهر خدا افسانه گو","او بر استادش بوسه می‌زند و از او می‌خواهد که برایش داستانی بگوید؛ به خاطر خداوند او را دعوت به گفتن افسانه می‌کند."],[887,"ای فسانه گشته و محو از وجود","چند افسانه بخواهی آزمود","ای کسی که به افسانه‌ها بدل شده‌ای و از وجود خود محو گشته‌ای، چه تعداد افسانه می‌خواهی که آزمایش کنی؟"],[887,"خندمین‌تر از تو هیچ افسانه نیست","بر لب گور خراب خویش ایست","هیچ قصه و داستانی به اندازه تو خنده‌آور نیست، و تو در حالی که بر لبه گور خود ایستاده‌ای، به این وضعیت مضحک نگاه می‌کنی."],[887,"ای فرو رفته به گور جهل و شک","چند جویی لاغ و دستان فلک","ای کسی که در گور غفلت و نادانی فرو رفته‌ای، چه زیاد در پی آنچه بی‌اهمیت و ناچیز است می‌گردی و دست‌های تو نیز به چیزهای بی‌اساس مشغول است."],[887,"تا بکی نوشی تو عشوه این جهان","که نه عقلت ماند بر قانون نه جان","تو تا کی به زیبایی‌ها و فریبندگی‌های این دنیا دل خوش کنی، در حالی که نه عقل تو به درستی درک می‌کند و نه جان تو از این دنیای فانی آسوده است؟"],[887,"لاغ این چرخ ندیم کرد و مرد","آب روی صد هزاران چون تو برد","این دنیا (چرخ) برای عده‌ای (مردان) تنها در پی نفع و فایده خود بوده و به خاطر آبروی ظاهری، افراد زیادی را همچون تو به خود جذب کرده است."],[887,"می‌درد می‌دوزد این درزی عام","جامه صدسالگان طفل خام","درزی، که در اینجا نماینده‌ای از قدرت و سرنوشت است، با دقت و مهارت، دردها و انعطاف‌پذیری را در کنار هم می‌آورد و برای انسان‌ها و نسل‌ها، لباس‌هایی از تجربه و حوادث را می‌سازد. این اشاره به این دارد که زندگی پر از چالش‌ها و دردهاست، اما این‌ها در نهایت به ایجاد چیزی جدید و زیبا منجر می‌شوند."],[887,"لاغ او گر باغها را داد داد","چون دی آمد داده را بر باد داد","اگر او از باغ‌ها به کسی چیزی بدهد، در روز قیامت به خاطر کارهایش بسیار بی‌ارزش خواهد بود، چون در آن روز، همه این نعمت‌ها به هدر خواهد رفت."],[887,"پیره‌طفلان شسته پیشش بهر کد","تا به سعد و نحس او لاغی کند","کودکان نوزاد به خاطر او پاک می‌شوند تا سرنوشت خوب یا بد او را مشخص کنند."],[888,"گفت درزی ای طواشی بر گذر","وای بر تو گر کنم لاغی دگر","در این بیت، کسی به درزی (حرفه‌ای در بافتن و دوختن) می‌گوید که ای درزی، بر حوادث روزگار ناراحت نباش! اگر من دچار مشکل شوم و کم‌توان شوم، وای به حال تو که چاره‌ای جز کمک به من نداری."],[888,"پس قبایت تنگ آید باز پس","این کند با خویشتن خود هیچ کس","اگر بار دیگر بخندد، لباسش تنگ می‌شود و دیگر نمی‌تواند با خود راست و صادق باشد؛ در این حال هیچ‌کس نمی‌تواند به او کمک کند."],[888,"خنده چه رمزی ار دانستیی","تو به جای خنده خون بگرستیی","اگر به عمق خنده توجه می‌کردی و رمز آن را می‌دانستی، به جای خنده باید از شدت اندوه بر روی خود اشک می‌ریختی."],[889,"اطلس عمرت به مقراض شهور","برد پاره‌پاره خیاط غرور","عمر تو مانند پارچه اطلس است که با قیچی شهوت‌ها پاره‌پاره می‌شود و خیاط غرور، آن را به تکه‌های کوچک تقسیم می‌کند."],[889,"تو تمنا می‌بری که اختر مدام","لاغ کردی سعد بودی بر دوام","تو آرزو می‌کنی که ستاره‌های خوشبختی همیشه بر تو بتابد و این خوشبختی همیشه و پایدار بماند."],[889,"سخت می‌تولی ز تربیعات او","وز دلال و کینه و آفات او","تو به شدت از دست مشکلات و پیچیدگی‌های زندگی که به این تربیعات (به معنای دو یا چند ضلعی‌ها، که به پیچیدگی اشاره دارد) مربوط می‌شود، ناراحت و رنجیده‌ای و همچنین از دلالان و کینه‌ورزان و آسیب‌ها و موانع زندگی خسته شده‌ای."],[889,"سخت می‌رنجی ز خاموشی او","وز نحوس و قبض و کین‌کوشی او","تو به شدت از سکوت و خاموشی او آزار می‌بینی و از بدی‌ها، سختی‌ها و کینه‌ورزی‌های او ناراحت هستی."],[889,"که چرا زهره طرب در رقص نیست","بر سعود و رقص سعد او مه‌ایست","چرا زهره، که نماد شادابی و نشاط است، در حال رقص و شادی نیست، در حالی که خوش شانسی و کامیابی (سعود) و شادکامی (رقص سعد) همچون ماهی در آسمان وجود دارد؟"],[889,"اخترت گوید که گر افزون کنم","لاغ را پس کلیت مغبون کنم","ستاره‌ات می‌گوید که اگر بخواهم زیبایی مطلق را افزون کنم، در واقع کل وجود را در زیان و نقصان قرار می‌دهم."],[889,"تو مبین قلابی این اختران","عشق خود بر قلب‌زن بین ای مهان","نگران نباش که این ستاره‌های عشق به قلب تو آسیب می‌زنند؛ ای مهمانان دل، تنها به زیبایی‌های عشق توجه کن."],[890,"آن یکی می‌شد به ره سوی دکان","پیش ره را بسته دید او از زنان","یک نفر در راه به سوی دکانی می‌رفت، اما متوجه می‌شود که راه توسط زنان بسته شده است."],[890,"پای او می‌سوخت از تعجیل و راه","بسته از جوق زنان هم‌چو ماه","پای او به‌خاطر عجله از درد می‌سوزد، و به‌خاطر صف زنان، راه بسته است، مانند ماه که در آسمان می‌درخشد و جلوه‌گری می‌کند."],[890,"رو به یک زن کرد و گفت ای مستهان","هی چه بسیارید ای دخترچگان","به یک زن نگاه کرد و گفت: «ای زنی که در نظر من ناچیز هستی، چه تعداد از دخترکان اینجا جمع شده‌اند!"],[890,"رو بدو کرد آن زن و گفت ای امین","هیچ بسیاری ما منکر مبین","زن به آن مرد رو کرد و گفت، ای امین، هرگز انکار نکن که ما بسیاریم."],[890,"بین که با بسیاری ما بر بساط","تنگ می‌آید شما را انبساط","مراقب باشید که حضور تعداد زیادی از ما در این مکان تنگ، باعث می‌شود شما احساس راحتی و گشایش نکنید."],[890,"در لواطه می‌فتید از قحط زن","فاعل و مفعول رسوای زمن","در زمان قحطی و کمبود زن، مردان به عمل ناپسند هم‌جنس‌گرایی می‌پرداختند و این کار باعث بی‌آبرویی آنها در دنیا شده است."],[890,"تو مبین این واقعات روزگار","کز فلک می‌گردد اینجا ناگوار","تو نباید به این رویدادهای ناخوشایند زمانه توجه کنی، چرا که این مشکلات ناشی از گردش زمانه و تاثیرات آسمانی هستند."],[890,"تو مبین تحشیر روزی و معاش","تو مبین این قحط و خوف و ارتعاش","تو نباید به زحمت‌ها و نگرانی‌های روزی و زندگی توجه کنی؛ به این قحطی و ترس و ناآرامی‌ها نگاه نکن."],[890,"بین که با این جمله تلخیهای او","مرده اویید و ناپروای او","جدایی و مشکلاتی که این شخص در زندگی‌اش تجربه کرده، به جایی رسیده که او مثل مرده‌ای است که نسبت به این تلخی‌ها بی‌تفاوت و ناآگاه شده است."],[890,"رحمتی دان امتحان تلخ را","نقمتی دان ملک مرو و بلخ را","امتحان‌های سخت و تلخ را به عنوان رحمت و نعمت بدان و از افتخار و ثروت شهرهای مرو و بلخ (که نشان از جاه و مقام دارد) دور شو."],[890,"آن براهیم از تلف نگریخت و ماند","این براهیم از شرف بگریخت و راند","براهیم (نبی بزرگ، که در داستان‌ها به عنوان نمونه ایمان و فداکاری شناخته می‌شود) که در آن شرایط سخت روحی، از زوال و نابودی فرار نکرد و باقی ماند، در حالی که این براهیم (باهنجارها و مادیات) از مقام و مرتبه خود دور شد و عقب‌نشینی کرد."],[890,"آن نسوزد وین بسوزد ای عجب","نعل معکوس است در راه طلب","عجب است که یکی (براهیم) نسوزد و دیگری (براهیم دیگر) بسوزد. این وضعیت نشان می‌دهد که در مسیر طلب (کسب حقیقت)، یک چیز اتفاقی و غیرمنتظره رخ داده، مانند نعل معکوس که برعکس عمل می‌کند."],[891,"گفت صوفی قادرست آن مستعان","که کند سودای ما را بی زیان","صوفی می‌گوید که کسی هست که می‌تواند آرزوی ما را بدون ضرر به حقیقت بدل کند."],[891,"آنک آتش را کند ورد و شجر","هم تواند کرد این را بی‌ضرر","کسی که می‌تواند آتش را به نیایش و ذکر تبدیل کند، همچنین می‌تواند این مسأله را به گونه‌ای پیش ببرد که بدون آسیب، تغییری مثبت ایجاد کند."],[891,"آنک گل آرد برون از عین خار","هم تواند کرد این دی را بهار","خداوندی که می‌تواند گل را از میان خارها بیرون بیاورد، قادر است که این دیار را نیز به بهار تبدیل کند."],[891,"آنک زو هر سرو آزادی کند","قادرست ار غصه را شادی کند","کسی که می‌تواند هر سرو را آزاد کند، یعنی او دارای قدرتی است که می‌تواند غم و اندوه را به شادی تبدیل کند."],[891,"آنک شد موجود از وی هر عدم","گر بدارد باقیش او را چه کم","هرچیزی که به وجود آمده از اوست، اگر او وجودش را حفظ کند، چه چیزی از او کم می‌شود."],[891,"آنک تن را جان دهد تا حی شود","گر نمیراند زیانش کی شود","چنانچه روح بدن را حیات می‌بخشد و آن را زنده می‌کند، اگر روح نرود و جان را نگیرد، چه ضرری به او می‌رسد؟"],[891,"خود چه باشد گر ببخشد آن جواد","بنده را مقصود جان بی‌اجتهاد","اگر آن بخشنده بزرگ (جواد) بخواهد به بنده‌اش عطا کند، خود آن بنده چه ارزشی دارد که بدون تلاش (اجتهاد) به هدف نهایی‌اش که جان و روح اوست، برسد؟"],[891,"دور دارد از ضعیفان در کمین","مکر نفس و فتنه دیو لعین","خداوند از ضعفا و ناتوان‌ها به دور است، زیرا نفس سرکش و شیطان شرور در کمین آنها نشسته‌اند و می‌خواهند آنها را بفریبند."],[892,"گفت قاضی گر نبودی امر مر","ور نبودی خوب و زشت و سنگ و در","قاضی گفت اگر فرمان الهی نبود، نه خوبی و بدی وجود داشت و نه چیزهایی مثل سنگ و در."],[892,"ور نبودی نفس و شیطان و هوا","ور نبودی زخم و چالیش و وغا","اگر نفس و شیطان و هوی و هوس وجود نداشتند، و همچنین دردها و جنگ‌ها و مشکلات نیز پیش نمی‌آمدند، زندگی و اخلاقی وجود نداشت که خوب و بد را از هم تشخیص بدهیم."],[892,"پس به چه نام و لقب خواندی ملک","بندگان خویش را ای منهتک","پس به چه عنوان و نامی، آن فرشته‌گان را که در خدمت بندگان خود هستند، خطاب کردی ای کسی که به خودت بی‌اعتنا شده‌ای؟"],[892,"چون بگفتی ای صبور و ای حلیم","چون بگفتی ای شجاع و ای حکیم","ای صبور و آرام، و ای با شخصیت و باگذشت، و همچنین ای شجاع و عاقل، تو به چه نام‌هایی خوانده شدی."],[892,"صابرین و صادقین و منفقین","چون بدی بی ره‌زن و دیو لعین","صابرین (صبرکنندگان)، صادقین (راستگویان) و منفقین (خرچ‌کنندگان) افرادی هستند که مانند کسی هستند که بدون ترس از دزد و دیو بدخواه، عمل می‌کنند و در مسیری درست قرار دارند."],[892,"رستم و حمزه و مخنث یک بدی","علم و حکمت باطل و مندک بدی","رستم و حمزه (دو پهلوان بزرگ در داستان‌های ایرانی) و مخنث (که در اینجا می‌تواند نماینده افرادی باشد که از نظر اجتماعی یا هویتی در حاشیه قرار دارند) هرکدام حتی با داشتن علم و حکمت، اگر تحت تاثیر بدی قرار گیرند، ناپایدار و بی‌ارزش می‌شوند."],[892,"علم و حکمت بهر راه و بی‌رهیست","چون همه ره باشد آن حکمت تهیست","علم و حکمت در همه حال و در هر راهی کاربرد دارد، اما اگر راهی وجود نداشته باشد، آن حکمت بی‌فایده و تهی است."],[892,"بهر این دکان طبع شوره‌آب","هر دو عالم را روا داری خراب","برای این دکان که طبیعی همچون آب شور دارد، می‌توانی هر دو جهان را ویران کنی."],[892,"من همی‌دانم که تو پاکی نه خام","وین سؤالت هست از بهر عوام","من می‌دانم که تو انسان با اخلاص و پاکی هستی و سوالت به خاطر درک عمومی مردم است نه به خاطر نادانی خودت."],[892,"جور دوران و هر آن رنجی که هست","سهل‌تر از بعد حق و غفلتست","رنج‌ها و سختی‌های زندگی و مشکلاتی که با آنها مواجه می‌شویم، از غفلت و دوری از حقیقت خداوند به مراتب دشوارتر و سنگین‌تر است."],[892,"زآنک اینها بگذرند آن نگذرد","دولت آن دارد که جان آگه برد","این مشکلات و رنج‌هایی که در زندگی با آن‌ها مواجه‌ایم، به زودی گذرا خواهند بود، اما حقی که فراموش می‌شود و غفلت از آن، پایدار و همیشگی است. آن کسی که این حقیقت را درک کند، به مقام و دولت واقعی دست می‌یابد."],[893,"آن یکی زن شوی خود را گفت هی","ای مروت را به یک ره کرده طی","زن به شوهرش گفت: ای که جوانمردی و بخشندگی را یک رهه(بدون بیراهه)رفتی"],[893,"هیچ تیمارم نمی‌داری چرا","تا بکی باشم درین خواری چرا","چرا غم نگهداری و رسیدگی به مرا نداری؟تا کی در این پستی و بی ارزشی باشم؟"],[893,"گفت شو من نفقه چاره می‌کنم","گرچه عورم دست و پایی می‌زنم","شخصی می‌گوید که اگرچه ضعیف و ناقص هستم و نمی‌توانم به‌طور کامل کار کنم، اما با وجود این، تلاش می‌کنم تا مخارج زندگی را تأمین کنم و برای رفع مشکلات اقدام می‌کنم."],[893,"نفقه و کسوه‌ست واجب ای صنم","از منت این هر دو هست و نیست کم","ای معشوق، نفقه (هزینه زندگی) و پوشاک (لباس) بر تو واجب است و به خاطر لطف و محبت تو، این دو چیز هیچ کم و کاستی ندارند."],[893,"آستین پیرهن بنمود زن","بس درشت و پر وسخ بد پیرهن","زنی که لباسش را بالا زده، به شدت و با جسارت ظاهر شده و لباسی زشت و پر از سخن‌ها دارد."],[893,"گفت از سختی تنم را می‌خورد","کس کسی را کسوه زین سان آورد","چون سختی و رنج بدن مرا آزار می‌دهد، هیچ‌کس نمی‌تواند لباس را به این شکل از من بگیرد یا ارسال کند."],[893,"گفت ای زن یک سوالت می‌کنم","مرد درویشم همین آمد فنم","مرد درویشی به زن می‌گوید که از تو یک سوال دارم و آن اینکه آیا تو هم در کار خود، یعنی در زندگی و حرفه‌ات، به همین سادگی مشغول هستی؟"],[893,"این درشتست و غلیظ و ناپسند","لیک بندیش ای زن اندیشه‌مند","این حالتی که به آن اشاره می‌شود، زشت و ناخوشایند است، اما ای زن خردمند، به این فکر کن که در این وضعیت، چه چیزهای دیگری در نظر است که باید مورد توجه قرار گیرد."],[893,"این درشت و زشت‌تر یا خود طلاق","این ترا مکروه‌تر یا خود فراق","طلاق و جدایی بدتر و ناخوشایندتر از خود این درشت و زشت و ناپسند است."],[893,"هم‌چنان ای خواجه تشنیع زن","از بلا و فقر و از رنج و محن","ای آقای مورد سرزنش، تو هم‌چنان به دلیل بدی و فقر و از سختی‌ها و مصیبت‌ها از زن انتقاد می‌کنی."],[893,"لا شک این ترک هوا تلخی‌دهست","لیک از تلخی بعد حق بهست","بدون تردید، ترک هوس و شهوات تلخ و دشوار است، اما تلخی ناشی از فاصله و جدایی از حق و حقیقت، به مراتب تلخ‌تر و سخت‌تر است."],[893,"گر جهاد و صوم سختست و خشن","لیک این بهتر ز بعد ممتحن","اگر جهاد و روزه گرفتن سخت و دشوار باشد، اما این کارها بهتر از سختی‌های امتحان و آزمایش در آینده است."],[893,"رنج کی ماند دمی که ذوالمنن","گویدت چونی تو ای رنجور من","وقتی خداوند بخشنده به تو می‌گوید حالت چطور است، دیگر چه رنجی باقی می‌ماند برای تو که رنجوری؟"],[893,"ور نگوید کت نه آن فهم و فن است","لیک آن ذوق تو پرسش کردنست","اگر آن شخص (دوست یا یار) حرفی هم نزند، این نشان‌دهنده درک و دانش او نیست، بلکه این حس و ذوق توست که تو را وادار به پرسش می‌کند."],[893,"آن ملیحان که طبیبان دل‌اند","سوی رنجوران به پرسش مایل‌اند","طبیبان دل که انسان‌های خوش‌صورت و دل‌فریب هستند، تمایل دارند به رنجوران و بیمارانی که در درد و رنج هستند سر بزنند و حال آنها را بپرسند."],[893,"وز حذر از ننگ و از نامی کنند","چاره‌ای سازند و پیغامی کنند","به خاطر پرهیز از شرمندگی و بدنامی، چاره‌ای می‌اندیشند و پیغامی تهیه می‌کنند."],[893,"ورنه در دلشان بود آن مفتکر","نیست معشوقی ز عاشق بی‌خبر","در دل عاشقان، فکر و تدبیر وجود دارد، اما معشوق از احساس و دلدادگی آن‌ها بی‌خبر است."],[893,"ای تو جویای نوادر داستان","هم فسانه عشق‌بازان را بخوان","ای کسی که دنبال داستان‌های تازه‌ای، داستان عاشقان را هم بخوان."],[893,"بس بجوشیدی درین عهد مدید","ترک‌جوشی هم نگشتی ای قدید","تو در این دوران طولانی بسیار احساسات و هیجانات را تجربه کردی، اما هنوز هیچ نشانه‌ای از سردی و بی‌احساسی در تو مشاهده نمی‌شود، ای محبوب زیبا."],[893,"دیده‌ای عمری تو داد و داوری","وانگه از نادیدگان ناشی‌تری","تو عمری دیدی و قضاوت کردی، اما حالا از آنچه ندیدی، نادان‌تر شده‌ای."],[893,"هر که شاگردیش کرد استاد شد","تو سپس‌تر رفته‌ای ای کور لد","هر کسی که شاگردانش را تربیت کند، خود به مقام استادی می‌رسد، اما تو که در این مسیر عقب‌تر مانده‌ای، مانند کوران، از آنچه باید ببینی ناتوانی."],[893,"خود نبود از والدینت اختبار","هم نبودت عبرت از لیل و نهار","تو خود در انتخاب و سرنوشت خود، از والدین‌ات مستقل بودی و هیچ‌گاه تجربه‌ای از شب و روز برایت عبرت‌آموز نشده است."],[894,"عارفی پرسید از آن پیر کشیش","که توی خواجه مسن‌تر یا که ریش","عارفی از آن روحانی مسن پرسید که آیا تو از خواجه (شخص ثروتمند و با نفوذ) بزرگ‌تر هستی یا موهای سپیدت (ریشت) سن تو را نشان می‌دهد؟"],[894,"گفت نه من پیش ازو زاییده‌ام","بی ز ریشی بس جهان را دیده‌ام","کشیش گفت: من قبل از او به دنیا آمده‌ام و بدون ریش، تجربیات زیادی از جهان را داشته‌ام."],[894,"گفت ریشت شد سپید از حال گشت","خوی زشت تو نگردیده‌ست وشت","او گفت که موهای سپیدت نشان‌دهنده پیری و تغییر حال توست، اما شخصیت و ذات تو هنوز زشت و ناپسند باقی مانده است و هیچ تغییری نکرده است."],[894,"او پس از تو زاد و از تو بگذرید","تو چنین خشکی ز سودای ثرید","او (شخصی که مورد خطاب است) بعد از تو به دنیا آمده و از تو عبور کرده، اما تو همچنان در این حالت خشک و بی‌روح باقی مانده‌ای و از عشق و آرزوهای خود دور هستی."],[894,"تو بر آن رنگی که اول زاده‌ای","یک قدم زان پیش‌تر ننهاده‌ای","تو هیچ تغییر و تحولی در خود نداده‌ای و هم‌چنان به همان حالتی که ابتدا به دنیا آمده‌ای، باقی‌ مانده‌ای."],[894,"هم‌چنان دوغی ترش در معدنی","خود نگردی زو مخلص روغنی","تو مانند دوغی ترش در معدنی هستی که هیچ‌گاه از آن دور نمی‌شوی و همچنان در آن به سر می‌بری و به روغن خالص نمی‌رسی."],[894,"هم خمیری خمر طینه دری","گرچه عمری در تنور آذری","هرچند خمیری که در تنور آتش می‌پزد مدت زیادی در آنجا باشد، اما در اصل همان ماده‌ای است که از خاک و گل به وجود آمده است."],[894,"چون حشیشی پا به گل بر پشته‌ای","گرچه از باد هوس سرگشته‌ای","اگرچه مانند حشیشی که روی زمین در حال جوانه زدن است، به خاطر بادی که به تو حس هوس داده، در مسیر زندگی گم شده‌ای و به جلو نمی‌روی."],[894,"هم‌چو قوم موسی اندر حر تیه","مانده‌ای بر جای چل سال ای سفیه","تو مانند قوم موسی در بیابان تیۀ (که بیابانی خشک و خالی بوده) مانده‌ای و در این وضعیت، مدت چهل سال به سر می‌بری، ای نادان."],[894,"می‌روی هر روز تا شب هروله","خویش می‌بینی در اول مرحله","هر روز از صبح تا شب در حال تلاش و کوشش هستی، اما فقط خودت را در مرحله ابتدایی می‌بینی و پیشرفتی حاصل نکرده‌ای."],[894,"نگذری زین بعد سیصد ساله تو","تا که داری عشق آن گوساله تو","تو تا زمانی که عشق به آن گوساله را داری، نمی‌توانی از این حالت گذر کنی، حتی اگر سیصد سال بگذرد."],[894,"تا خیال عجل از جانشان نرفت","بد بریشان تیه چون گرداب زفت","تا وقتی که خیال عجله از دل‌های آنها نرود، زندگی‌شان مانند گرداب عمیق و ترسناک است."],[894,"غیر این عجلی کزو یابیده‌ای","بی‌نهایت لطف و نعمت دیده‌ای","غیر از این شتاب‌زده‌ای که تو از او به نعمت‌ها و لطف‌های بی‌پایان رسیده‌ای، کسی دیگری نیست."],[894,"گاو طبعی زان نکوییهای زفت","از دلت در عشق این گوساله رفت","گاو طبع یا طبیعت تو به خاطر زیبایی‌ها و ویژگی‌های خوب عشق، مانند گوساله‌ای از دل تو خارج شده است."],[894,"باری اکنون تو ز هر جزوت بپرس","صد زبان دارند این اجزای خرس","اکنون تو از هر یک از اجزای خود بپرس که هر کدام به چند زبان سخن می‌گویند و احساسات و اوضاع را نشان می‌دهند."],[894,"ذکر نعمتهای رزاق جهان","که نهان شد آن در اوراق زمان","اگر ذکر نعمت‌های خداوند، که روزی‌دهنده جهان است، از یاد برود و در صفحات زمان ناپیدا شود، چه سودی دارد؟"],[894,"روز و شب افسانه‌جویانی تو چست","جزو جزو تو فسانه‌گوی تست","هر روز و شب، کسانی که در جستجوی حقیقت و داستان‌ها هستند، تو را در خود دارند و هر قسمت از وجود تو داستانی را برای گفتن به همراه دارد."],[894,"جزو جزوت تا برستست از عدم","چند شادی دیده‌اند و چند غم","پیش از این‌که به وجود بیایی و به بخش‌های مختلف وجودت بپیوندی، چند شادی و چند غم دیده‌ایم."],[894,"زانک بی‌لذت نروید هیچ جزو","بلک لاغر گردد از هی پیچ جزو","هیچ جزو (جزئی) بدون لذت نمی‌تواند رشد کند و برعکس، اگر لذت نباشد، آن جزو ضعیف و لاغر می‌شود."],[894,"جزو ماند و آن خوشی از یاد رفت","بل نرفت آن خفیه شد از پنج و هفت","تنها بخش‌هایی از وجود باقی مانده و آن خوشی‌ها فراموش شده است، اما در واقع آن لذت‌ها نرفته‌اند، بلکه در پس پرده‌ زندگی پنهان شده‌اند."],[894,"هم‌چو تابستان که از وی پنبه‌زاد","ماند پنبه رفت تابستان ز یاد","شبیه به تابستان که تنها پنبه زنده می‌ماند و خود تابستان از یاد می‌رود، در واقعیت هم، بعضی چیزها مثل خوشی‌ها ممکن است فراموش شوند در حالی که اثرات آن‌ها باقی می‌ماند."],[894,"یا مثال یخ که زاید از شتا","شد شتا پنهان و آن یخ پیش ما","شاید مانند یخی باشد که از سرما به وجود می‌آید، ولی بعد از آن سرما (زمستان) دیگر یخ پنهان می‌شود و در بین ما باقی نمی‌ماند."],[894,"هست آن یخ زان صعوبت یادگار","یادگار صیف در دی این ثمار","این یخ، نشانه‌ای است از سختی‌ها و مشکلاتی که در گذشته بوده و اکنون به‌عنوان یادگاری از تابستان در زمستان باقی مانده است."],[894,"هم‌چنان هر جزو جزوت ای فتی","در تنت افسانه گوی نعمتی","ای جوان، هر بخشی از وجود تو مانند افسانه‌ای است که نشان‌دهنده نعمتی در وجودت است."],[894,"چون زنی که بیست فرزندش بود","هر یکی حاکی حال خوش بود","زنی را تصور کن که بیست فرزند دارد و هر یک از آن‌ها نشان‌دهنده‌ی خوشحالی و خوشبختی او هستند."],[894,"حمل نبود بی ز مستی و ز لاغ","بی بهاری کی شود زاینده باغ","حمل (بارداری) بدون مستی و لاغری (ضعف) نیست و بی‌بهاری (فصل بهار) نمی‌توان باغی زنده و سرسبز داشت."],[894,"حاملان و بچگانشان بر کنار","شد دلیل عشق‌بازی با بهار","حاملان (زنان باردار) و کودکانشان از عشق و محبت بهار کنار و دور شدند. این اشاره به آن دارد که عشق و زیبایی بهار همواره حضور دارد و در دل افراد زنده است."],[894,"هر درختی در رضاع کودکان","هم‌چو مریم حامل از شاهی نهان","هر درختی مانند مریم، که مریم در ادبیات مذهبی به عنوان مادر عیسی(ع) شناخته می‌شود و حامل او بوده، در کنار کودکان، نهان از شاهی (نفس خداوند) برکت و محبت را به فرزندان می‌دهد."],[894,"گرچه در آب آتشی پوشیده شد","صد هزاران کف برو جوشیده شد","هرچند آتش در آب پنهان شده است، اما از زیر آن هزاران دست (بروز) بیرون می‌آید و جوشش می‌کند."],[894,"گرچه آتش سخت پنهان می‌تند","کف به ده انگشت اشارت می‌کند","هرچند آتش به شدت پنهان و درخفا می‌سوزد، اما با شعله‌هایش به نشانه نشان می‌دهد و اشاره می‌کند که وجود دارد."],[894,"هم‌چنین اجزای مستان وصال","حامل از تمثالهای حال و قال","اجزای مستان عشق و دوستی، مانند حاملانی هستند که صفات و جلوه‌های حالات و سخنان عاشقانه را نشان می‌دهند و به تصویر می‌کشند."],[894,"در جمال حال وا مانده دهان","چشم غایب گشته از نقش جهان","در زیبایی حال، دهان از حیرت بسته مانده و چشم به خاطر غیبت، از تصاویر این دنیا غایب شده است."],[894,"آن موالید از زه این چار نیست","لاجرم منظور این ابصار نیست","آفریده‌ها و موجودات از این جهان مادی به وجود نمی‌آیند، بنابراین نمی‌توانند مورد نظر این چشمان (بینش) باشند."],[894,"آن موالید از تجلی زاده‌اند","لاجرم مستور پرده ساده‌اند","آن زادگان (آفریده‌ها) از تجلی (ظاهر شدن) جهان به وجود آمده‌اند، بنابراین در پس پرده‌ای ساده پنهان شده‌اند و در واقع نمی‌توان آن‌ها را به‌طور کامل مشاهده کرد."],[894,"زاده گفتیم و حقیقت زاد نیست","وین عبارت جز پی ارشاد نیست","به ما گفتند که زاده از تجلی است، اما این موضوع حقیقت ندارد و این سخن فقط برای راهنمایی و ارشاد مردم است."],[894,"هین خمش کن تا بگوید شاه قل","بلبلی مفروش با این جنس گل","سکوت کن تا شاه به اندازه کافی از این گل زیبا بگوید، بلبلی هم که در اینجا است، با چنین گل خوشبو و زیبا چیزی نمی‌فروشد."],[894,"این گل گویاست پر جوش و خروش","بلبلا ترک زبان کن باش گوش","این گل، با شور و هیجان زیاد، سخن می‌گوید؛ ای بلبل، زبانت را خاموش کن و گوش کن."],[894,"هر دو گون تمثال پاکیزه‌مثال","شاهد عدل‌اند بر سر وصال","هر دو نوع زیبایی باکیفیت و ظرافت همانند شاهدی از عدالت هستند که در لحظه وصال جلوه‌گر می‌شوند."],[894,"هر دو گون حسن لطیف مرتضی","شاهد احبال و حشر ما مضی","حسن لطیف مرتضی به معنای زیبایی نیکو و خالص اوست و او شاهد وضع و جمع ما در روز قیامت و در مراحل مختلف زندگی‌مان است. این بیت به اهمیت و زیبایی وجود او در لحظات مختلف زندگی اشاره دارد."],[894,"هم‌چو یخ کاندر تموز مستجد","هر دم افسانه زمستان می‌کند","در گرمای تابستان، یخ مانند چیزی که از گذشته خبر می‌دهد، هر لحظه داستان زمستان را روایت می‌کند."],[894,"ذکر آن اریاح سرد و زمهریر","اندر آن ازمان و ایام عسیر","یادآوری آن سرما و زمستان سخت، در این زمان و روزهای دشوار، مانند داستانی است که همواره بازگو می‌شود."],[894,"هم‌چو آن میوه که در وقت شتا","می‌کند افسانه لطف خدا","مانند میوه‌ای که در فصل زمستان به محبت و لطف خدا می‌بالد و قصه‌های شیرین زندگی را به تصویر می‌کشد."],[894,"قصه دور تبسمهای شمس","وآن عروسان چمن را لمس و طمس","قصه دور تبسم‌های شمس (شمس تبریزی، دوست نزدیک مولانا) و آن عروس‌های چمن، به شادی و زیبایی زندگی اشاره دارد که در گذشته وجود داشته و حالا در یادها باقی مانده است. این بیان نشان‌دهنده ارتباط عمیق روحی و معنوی است که مولانا با شمس و صحنه‌های زیبای طبیعی و عشق دارد."],[894,"حال رفت و ماند جزوت یادگار","یا ازو واپرس یا خود یاد آر","حالت رفت و ماند و تنها یاد تو باقی مانده است. یا از او سؤال کن (یعنی از یاد او) یا خودت به یاد او بیفت."],[894,"چون فرو گیرد غمت گر چستیی","زان دم نومید کن وا جستیی","اگر غم تو را در چنگ بگیرد و تو در آن لحظه قوی نباشی، در همان لحظه امید خود را از دست بده و برای یافتن راهی به جستجو بپرداز."],[894,"گفتییش ای غصه منکر به حال","راتبه انعامها را زان کمال","ای غصه ناخوشایند، به من بگو که چه اتفاقاتی برای مقام و جایگاه کسی که انعام و پاداش را تجربه کرده، می‌افتد؟"],[894,"گر بهر دم نت بهار و خرمیست","هم‌چو چاش گل تنت انبار چیست","اگر در هر لحظه بهاری و خوشحالی وجود نداشته باشد، پس ارزش وجود جسم تو چیست؟"],[894,"چاش گل تن فکر تو هم‌چون گلاب","منکر گل شد گلاب اینت عجاب","فکر تو مانند گلاب است که از گل به‌دست می‌آید، ولی به‌دلیل انکار تو، گلاب این حقیقت به شکل عجیبی تغییر کرده و ارزشش نادیده گرفته شده است."],[894,"از کپی‌خویان کفران که دریغ","بر نبی‌خویان نثار مهر و میغ","افرادی که در تقلید و پیروی از کفر هستند، نسبت به کسانی که از روی محبت و ارادت به رسول (نبی) عمل می‌کنند، احساس تأسف و ناراحتی دارند."],[894,"آن لجاج کفر قانون کپیست","وآن سپاس و شکر منهاج نبیست","لجاجت و پافشاری بر کفر، همانند قانون کپی کردن است، در حالی که سپاسگزاری و شکرگزاری، راه و روش پیامبران (نبی‌ها) است."],[894,"با کپی‌خویان تهتکها چه کرد","با نبی‌رویان تنسکها چه کرد","با انسان‌هایی که به تقلید و کپی‌کاری عادت دارند، چه باید کرد و با کسانی که ویژگی‌های پیامبران را دارند و به زهد و عبادت مشغول‌اند، چه باید کرد؟"],[894,"در عمارتها سگانند و عقور","در خرابیهاست گنج عز و نور","در ساختمان‌ها، سگان و گرگ‌های وحشی وجود دارند، اما در ویرانی‌ها، گنجی از عظمت و روشنی نهفته است."],[894,"گر نبودی این بزوغ اندر خسوف","گم نکردی راه چندین فیلسوف","اگر این روشنی در تاریکی (خسوف) وجود نداشت، فیلسوفان به این اندازه راه را گم نمی‌کردند."],[894,"زیرکان و عاقلان از گمرهی","دیده بر خرطوم داغ ابلهی","زیرکان و عاقلان از جهالت و نادانی، نشانه‌های احمقانه را می‌بینند و عبرت نمی‌گیرند."],[895,"آن یکی بیچاره مفلس ز درد","که ز بی‌چیزی هزاران زهر خورد","این فرد بیچاره و نیازمند به خاطر نداشتن هیچ چیزی، هزاران درد و رنج را تحمل کرده است."],[895,"لابه کردی در نماز و در دعا","کای خداوند و نگهبان رعا","او در نماز و دعا به شدت التجا می‌کند و از خداوند، که نگهبان بندگانش است، کمک می‌خواهد."],[895,"بی ز جهدی آفریدی مر مرا","بی فن من روزیم ده زین سرا","ای خداوند، بدون هیچ تلاشی و زحمتی مرا آفریدی، حالا به من روزی بده از این خانه (دنیا)."],[895,"پنج گوهر دادیم در درج سر","پنج حس دیگری هم مستتر","ما پنج گوهر را در جایگاه سر (معنای باطنی و ارزشمند) قرار دادیم، و همچنین پنج حس دیگر هم در درون آن نهفته و پنهان است."],[895,"لا یعد این داد و لا یحصی ز تو","من کلیلم از بیانش شرم‌رو","من نمی‌توانم نعمت‌هایی که از تو دریافت کرده‌ام را بشمارم و توصیف کنم، زیرا در این مورد شرمنده‌ام و گفتن آن‌ها برایم دشوار است."],[895,"چونک در خلاقیم تنها توی","کار رزاقیم تو کن مستوی","ما در آفرینش و زندگی به‌تنهایی تو هستی که در کار روزی‌رسانی ما فعال هستی، پس تو را مستحق توجه و شناخت می‌دانیم."],[895,"سالها زو این دعا بسیار شد","عاقبت زاری او بر کار شد","سال‌ها این شخص دعا کرد و درخواست کمک داشت، تا اینکه بالاخره به خاطر زاری کردنش در برابر خداوند، به نتیجه مطلوب رسید و کار او سامان گرفت."],[895,"هم‌چو آن شخصی که روزی حلال","از خدا می‌خواست بی‌کسب و کلال","مولانا به شخصی اشاره می‌کند که مانند آن مردی است که برای به دست آوردن روزی حلال از خداوند دعا می‌کرد و به هیچ شغلی و کار دنیوی وابسته نبود."],[895,"گاو آوردش سعادت عاقبت","عهد داود لدنی معدلت","گاو به او خوشبختی و سعادت می‌آورد که در نهایت و در زمان داود (نبی) به او اعطا شده و مورد توازن و اعتدال قرار می‌گیرد."],[895,"این متیم نیز زاریها نمود","هم ز میدان اجابت گو ربود","این شخص زاری‌های زیادی کرد و با وجود دعاهایش، نتیجه‌ای از خداوند نگرفت و جواب دعایش را از میدان اجابت دریافت نکرد."],[895,"گاه بدظن می‌شدی اندر دعا","از پی تاخیر پاداش و جزا","گاهی بدگمان می‌شدی به دعا کردن، به خاطر تأخیر در دریافت پاداش و جزا."],[895,"باز ارجاء خداوند کریم","در دلش بشار گشتی و زعیم","اگر انسان دچار توهم و بدگمانی به دعاهایش شود، دوباره به لطف و رحمت خداوند نیکو باخبر می‌شود و امیدش به خدا تجدید می‌گردد."],[895,"چون شدی نومید در جهد از کلال","از جناب حق شنیدی که تعال","وقتی از تلاش و زحمت خود ناامید شدی و احساس یأس کردید، از جانب خداوند شنیدی که «شأن» به وضوح بالاتر از تلاش توست."],[895,"خافضست و رافعست این کردگار","بی ازین دو بر نیاید هیچ کار","این خداوند، هم زمین را پایین می‌آورد و هم آسمان را بالا می‌برد؛ و هیچ کاری بدون این دو خفص و رفع انجام نمی‌شود."],[895,"خفض ارضی بین و رفع آسمان","بی ازین دو نیست دورانش ای فلان","زندگی با پایین و بالا آمدن زمین و آسمان جلوه‌گری می‌کند، و اگر این دو نباشد، دورانی وجود نخواهد داشت. ای فلان، به این نکته توجه کن که همه چیز در دنیا به این تغییرات وابسته است."],[895,"خفض و رفع این زمین نوعی دگر","نیم سالی شوره نیمی سبز و تر","زمین دارای حالاتی مختلف است؛ به گونه‌ای که در یک سال، نیمه‌ای از آن خشک و شوره‌زار و نیمه دیگر سبز و پربار می‌شود."],[895,"خفض و رفع روزگار با کرب","نوع دیگر نیم روز و نیم شب","تغییرات زندگی و وقایع آن، همان‌طور که در روز و شب متفاوت است، گاهی به دنبال سختی و مشکلات و گاهی به دنبال راحتی و آسایش پیش می‌رود."],[895,"خفض و رفع این مزاج ممترج","گاه صحت گاه رنجوری مضج","تغییرات حال و حیات انسان‌ها به گونه‌ای است که گاهی در شرایط خوب و سالم قرار دارند و گاهی در وضعیت ناخوش و بیماری."],[895,"هم‌چنین دان جمله احوال جهان","قحط و جدب و صلح و جنگ از افتتان","همچنین باید بدانی که همه‌ چیزهای دنیا شامل قحطی و کمبود، و همچنین وفور و جنگ و صلح، از نشانه‌های تغییر و افت و خیز هستند."],[895,"این جهان با این دو پر اندر هواست","زین دو جانها موطن خوف و رجاست","این جهان مانند پرندگانی است که در هوا پرواز می‌کنند و از دو حالت احساس ترس و امید در آن وجود دارد. با این دو روحیه، زندگی آدمی پر از نگرانی و امید است."],[895,"تا جهان لرزان بود مانند برگ","در شمال و در سموم بعث و مرگ","تا زمانی که دنیا به شدت ناپایدار و بی‌ثبات باشد، مانند برگ درختانی که در باد شمال و طوفان‌های مرگ و بی‌نظمی می‌لرزند، زندگی نیز دچار اضطراب و بی‌ثباتی خواهد بود."],[895,"تا خم یک‌رنگی عیسی ما","بشکند نرخ خم صدرنگ را","اگر عیسی (پیامبر) بتواند خم یک‌رنگی (همان خم شراب) را بشکند، این باعث می‌شود که ارزش و قیمت خم رنگین افزایش یابد. در واقع، با شکستن این یک‌دستی، به نوعی می‌توان انتظار داشت که زیبایی و تنوع (نرخ خم صدرنگ) بیشتر از قبل خود را نشان دهد."],[895,"کان جهان هم‌چون نمکسار آمدست","هر چه آنجا رفت بی‌تلوین شدست","این جهان مانند نمک‌سار (محلی که نمک برداشته می‌شود) است، چرا که هر چیزی که به آنجا وارد می‌شود، دیگر رنگ و شکل خود را از دست می‌دهد و به صورت یکدست و بی‌تفاوت درمی‌آید."],[895,"خاک را بین خلق رنگارنگ را","می‌کند یک رنگ اندر گورها","خاک، در برابر افراد با رنگ‌ها و ویژگی‌های متفاوت، همه را در گورها یکسان می‌کند و تفاوت‌ها به فراموشی سپرده می‌شود."],[895,"این نمکسار جسوم ظاهرست","خود نمکسار معانی دیگرست","این جمله به این معناست که آن نمکسار (نمک‌زار) جسد و جسم ظاهری است، اما در واقع نمکسار معانی و مفاهیم باطنی و معنوی دیگری نیز در خود دارد."],[895,"آن نمکسار معانی معنویست","از ازل آن تا ابد اندر نویست","این نمکسار (نمک‌سار یا نمک‌فروش) نشان‌دهنده معانی معنوی است که از آغاز خلقت تا ابد در او وجود دارد و به نوعی به تحولات و ارتباطات معنوی اشاره دارد."],[895,"این نوی را کهنگی ضدش بود","آن نوی بی ضد و بی ند و عدد","نوی (نوی معنوی) کهنگی ضد و ضدش به حساب می‌آید، اما آن نوی که از هیچ چیز متاثر نیست، نه ضد دارد و نه بینهایت یا عدد."],[895,"آنچنان که از صقل نور مصطفی","صد هزاران نوع ظلمت شد ضیا","نور پیامبر اسلام، محمد (مصطفی)، به قدری درخشان است که از تابش آن هزاران نوع ظلمت برطرف و روشنایی ایجاد شده است."],[895,"از جهود و مشرک و ترسا و مغ","جملگی یک‌رنگ شد زان الپ الغ","به خاطر نور و روشنایی که از وجود پیامبر (مصطفی) ساطع شده، تمام انسان‌ها با هر دین و مذهبی، یکسان و هم‌زمان به وحدت رسیدند و از اختلاف‌ها دور شدند."],[895,"صد هزاران سایه کوتاه و دراز","شد یکی در نور آن خورشید راز","سایه‌های بسیار زیادی که بعضی‌ها کوتاه و بعضی‌ها بلند بودند، در نور آن خورشید واحد شده و یکی شدند."],[895,"نه درازی ماند نه کوته نه پهن","گونه گونه سایه در خورشید رهن","در نور خورشید، هیچ سایه‌ای نه بلند و نه کوتاه و نه عریض باقی نمی‌ماند؛ همگی سایه‌ها به یک شکل می‌شوند و در پرتو آن نور نابود می‌شوند."],[895,"لیک یک‌رنگی که اندر محشرست","بر بد و بر نیک کشف و ظاهرست","در روز قیامت، یک رنگی وجود دارد که همه چیز را نشان می‌دهد و بدون پرده‌پوشی، حقیقت نیکان و فاسدان را آشکار می‌کند."],[895,"که معانی آن جهان صورت شود","نقشهامان در خور خصلت شود","در آن جهان، معانی و ویژگی‌های ما به صورت ظاهر می‌شود و هر یک از ما طبق خصایص خود نقشه‌ای به دست می‌آوریم."],[895,"گردد آنگه فکر نقش نامه‌ها","این بطانه روی کار جامه‌ها","آنگاه فکر انسان به شکل و ظاهر نامه‌ها و پیام‌ها می‌پردازد، و این حالت، مانند پرده‌ای است که روی کار و اطوار زندگی او را می‌پوشاند."],[895,"این زمان سرها مثال گاو پیس","دوک نطق اندر ملل صد رنگ ریس","این زمان، سرها مانند گاو پیس (گاو سیاه و سفید) است که در میان مردم مختلف، نطق (گفتار) را به‌صورت رنگارنگ و متنوعی می‌آورد. این به این معناست که گفتار انسان‌ها از اقوام و ملل گوناگون با یکدیگر متفاوت و متنوع است."],[895,"نوبت صدرنگیست و صددلی","عالم یک رنگ کی گردد جلی","زمانی است که در دنیا، افراد زیادی با دل‌های مختلف وجود دارند، اما وقتی به حقیقت نزدیک می‌شویم، همه آن‌ها به یک رنگ و شکل واحد تبدیل می‌شوند."],[895,"نوبت زنگست رومی شد نهان","این شبست و آفتاب اندر رهان","اکنون نوبت زنگ است که رومی در پنهان شده است، در این شب تاریک است و خورشید هنوز در افق نیست."],[895,"نوبت گرگست و یوسف زیر چاه","نوبت قبطست و فرعونست شاه","در این بیت اشاره به نابسامانی و تضاد میان خیر و شر است. در یک سو، گرگ که نماد خطر و بدی است، و در سوی دیگر، یوسف که نشان‌دهنده نیکی و فضیلت می‌باشد، در وضعیت نامناسبی قرار دارند. همچنین به فرعون به‌عنوان نماینده قدرت و ظلم در برابر قبطی‌ها (مردم مصر) اشاره می‌شود که نشان‌دهنده تضادهای اجتماعی و سیاسی است."],[895,"تا ز رزق بی‌دریغ خیره‌خند","این سگان را حصه باشد روز چند","بعضی از سگ‌ها مدتی از روز را به خاطر در دسترس بودن نعمت و غذا با خوشحالی و شگفتی می‌گذرانند."],[895,"در درون بیشه شیران منتظر","تا شود امر تعالوا منتشر","در دل جنگل، شیران منتظرند تا فرمان «بیایید» انتشار یابد و همه‌جا را پر کند."],[895,"پس برون آیند آن شیران ز مرج","بی‌حجابی حق نماید دخل و خرج","سپس آن شیران از جنگل خارج می‌شوند و در شفافیتی بی‌پرده، نمایان می‌شود که چگونه حق بر اساس داده‌ها و ورودی‌ها، توازن را به وجود می‌آورد."],[895,"جوهر انسان بگیرد بر و بحر","پیسه گاوان بسملان آن روز نحر","در روز نحر که روز قیامت و حسابرسی اعمال است، جوهر واقعی و درونی انسان‌ها از آن‌ها گرفته می‌شود، در حالی که گاوان کشته شده به حساب همگان می‌آید و مورد بررسی قرار می‌گیرد."],[895,"روز نحر رستخیز سهمناک","مؤمنان را عید و گاوان را هلاک","در روز نحر (عید قربانی)، روز قیامت و برانگیخته شدن مردگان، برای مؤمنان روزی خوش و عیدی خواهد بود، اما برای گاوان، هلاکت و نابودی خواهد بود."],[895,"جمله مرغان آب آن روز نحر","هم‌چو کشتیها روان بر روی بحر","در روز قیامت، پرندگان به مانند کشتی‌هایی بر روی دریا در حال حرکت هستند."],[895,"تا که یهلک من هلک عن بینه","تا که ینجو من نجا واستیقنه","تا زمانی که کسی که به یقین شناخته نشده است، هلاک شود، کسی که نجات یافت، به یقین نجات یافته است."],[895,"تا که بازان جانب سلطان روند","تا که زاغان سوی گورستان روند","تا وقتی که بازها به سمت سلطان (خدایگان) می‌روند، زاغ‌ها به سوی گورستان (مرگ) می‌روند. این بیت به دو نوع رفتار موجودات اشاره دارد؛ بازها که نماد بزرگی و قدرت هستند، به سوی مقام و عظمت می‌شتابند، در حالی که زاغ‌ها نماد کوچکی و ضعف، به سمت نابودی و مرگ می‌روند."],[895,"که استخوان و اجزاء سرگین هم‌چو نان","نقل زاغان آمدست اندر جهان","مجموعه‌ای از استخوان و اجزای فضولات کرم‌ها در دنیا همچون نان برای زاغان (پرندگان) به وجود آمده است."],[895,"قند حکمت از کجا زاغ از کجا","کرم سرگین از کجا باغ از کجا","سؤال این است که حکمت، قند (شیرینی) از کجا به دست آمده و از کجا آمده که زاغ (پرنده‌ای که نماد چیزهای پست است)، کرم، سرگین (فضولات حیوانی)، و باغ (جایی سرسبز و زیبا) نیز به وجود آمده‌اند. به عبارت دیگر، تفاوت میان چیزهای ارزشمند و بی‌ارزش در چیست و منشأ آنها کجاست؟"],[895,"نیست لایق غزو نفس و مرد غر","نیست لایق عود و مشک و کون خر","غزو (جهاد) نفس و خودخواهی برای آدمی که شجاعت ندارد مناسب نیست، همان‌طور که عود و مشک (عطرها) و نشانه‌های ثروت نیز برای او که مانند خر (بی‌فایده) است، شایسته نیست."],[895,"چون غزا ندهد زنان را هیچ دست","کی دهد آنک جهاد اکبرست","وقتی که زنان را برای جهاد واقعی کمک نمی‌دهند، پس چه کسی می‌تواند آن جهاد بزرگتر را انجام دهد؟"],[895,"جز بنادر در تن زن رستمی","گشته باشد خفیه هم‌چون مریمی","در وجود زنان، به جز ویژگی‌ها و صفات جسمانی، چیزهای پنهانی وجود دارد که همچون مریم، پاک و مقدس است. این ویژگی‌ها و حقیقت‌های نهفته در آنها به «زن رستم» (قهرمان افسانه‌ای) اشاره دارد که نشان می‌دهد زنان نیز قدرت و عمق خاصی دارند."],[895,"آنچنان که در تن مردان زنان","خفیه‌اند و ماده از ضعف جنان","در بدن مردان، همچنان که زنان به‌طرز پنهانی وجود دارند، ماده هم به دلیل ضعف عقل و خرد قرار دارد."],[895,"آن جهان صورت شود آن مادگی","هر که در مردی ندید آمادگی","اگر کسی در شخصیت مردانه، آمادگی و قابلیت را نبیند، در جهان دیگر به شکل مادگی و صورت تبدیل خواهد شد."],[895,"روز عدل و عدل داد در خورست","کفش آن پا کلاه آن سرست","در روز داد و روز عدالت، هر چیز در جای خود قرار می‌گیرد؛ کفش نشان‌دهنده پا و کلاه نمایانگر سر است. بدین معنا که در آن روز، هر فرد طبق اعمال خود و این که چه نقشی در زندگی داشته، به جایگاه واقعی‌اش می‌رسد."],[895,"تا به مطلب در رسد هر طالبی","تا به غرب خود رود هر غاربی","هر کسی که در پی چیزی باشد، بالاخره به آن دست خواهد یافت. همچنین، هر کسی که به غرب برود، به جایی خواهد رسید که خواسته‌اش را بیابد."],[895,"نیست هر مطلوب از طالب دریغ","جفت تابش شمس و جفت آب میغ","هر چیزی که طلب‌کننده‌ای بخواهد، از او دریغ نمی‌شود، همان‌طور که تابش آفتاب و بارش باران نیز با همدیگر هستند و یکی بدون دیگری نخواهد بود."],[895,"هست دنیا قهرخانه کردگار","قهر بین چون قهر کردی اختیار","دنیا مانند خانه‌ای است که خداوند در آن قهر و خشم را قرار داده است. وقتی خداوند بخواهد، اختیار و قدرت قهر را در دست می‌گیرد."],[895,"استخوان و موی مقهوران نگر","تیغ قهر افکنده اندر بحر و بر","به استخوان و موی افرادی که مغلوب قهر الهی شده‌اند توجه کن؛ تیغ خشم خداوند آن‌ها را در دریا و خشکی پراکنده کرده است."],[895,"پر و پای مرغ بین بر گرد دام","شرح قهر حق کننده بی‌کلام","پر و پای مرغی را ببین که در دور دام گرفتار است؛ این تصویر نشان‌دهنده قهر خداوند است که بدون هیچ سخنی جلوه‌گر می‌شود."],[895,"مرد او بر جای خرپشته نشاند","وآنک کهنه گشت هم پشته نماند","مردی را بر روی سکویی نشاندند، ولی وقتی فرسوده و کهنه شد، دیگر آن سکو هم باقی نماند."],[895,"هر کسی را جفت کرده عدل حق","پیل را با پیل و بق را جنس بق","هر کسی به حسب انصاف و عدالت الهی، همتایی برای خود دارد؛ مانند اینکه فیل را با فیل و موجودات دیگر را با موجودات مشابه خود مقایسه می‌کنند."],[895,"مونس احمد به مجلس چار یار","مونس بوجهل عتبه و ذوالخمار","احمد، که به احتمال زیاد به پیامبر اسلام اشاره دارد، در مجلس چهار یار خود مونس است. همچنین بوجهل، عتبه و ذوالخمار هم به نوعی در این مجلس با او هستند و اشاره به دوستان یا یاران در کنار هم دارد."],[895,"کعبه جبریل و جانها سدره‌ای","قبله عبدالبطون شد سفره‌ای","کعبه جبریل (مکانی مقدس در آسمان که محل ارتباط با خداست) و سدره (درختی در آسمان که نشان‌دهنده نزدیکی به خداوند است) برای روح‌ها، بسان قبله است، و درعین‌حال، سفره‌ای برای نیازهای جسمانی بندگان (عبدالبطون) به شمار می‌آید."],[895,"قبله عارف بود نور وصال","قبله عقل مفلسف شد خیال","عشق و وصال خداوند، مقصد و قبله عارفان است، در حالی که عقل و تفکر تنها به خیالات و تصورات محدود می‌شوند."],[895,"قبله زاهد بود یزدان بر","قبله مطمع بود همیان زر","کسی مانند زاهد (زاهد به معنای کسی است که از دنیا و زرق و برق آن دوری می‌کند و به خداوند توجه دارد) به خداوند (یزدان) به عنوان قبله و معشوق خود می‌نگرد، در حالی که او (زاهد) به مال و ثروت (همیان زر، یعنی کیسه‌ی پر از طلا) به عنوان هدف و قله‌ی خواسته‌های خود نظر دارد."],[895,"قبله معنی‌وران صبر و درنگ","قبله صورت‌پرستان نقش سنگ","مرکز توجه و هدف معنوی کسانی که به درک عمیق‌تر می‌پردازند، صبر و تامل است، در حالی که برای ظاهربینان و صورت‌پرستان، آنچه مهم است، صرفا نقش و تصویر بر روی سنگ‌هاست."],[895,"قبله باطن‌نشینان ذوالمنن","قبله ظاهرپرستان روی زن","کسانی که در باطن و درونیات خود به خداوند رو کرده‌اند، به او توجه دارند، در حالی که کسانی که تنها به ظواهر می‌پردازند، به جلوه‌های ظاهری دنیا دل بسته‌اند."],[895,"هم‌چنین برمی‌شمر تازه و کهن","ور ملولی رو تو کار خویش کن","تازه و کهنه را حساب کن و به بررسی اوضاع بپرداز. اگر دلت ناامید است، خود را به کار و تلاش مشغول کن."],[895,"رزق ما در کاس زرین شد عقار","وآن سگان را آب تتماج و تغار","رزق ما به شکل گنجی ارزشمند درآمد و آن سگ‌ها که در حال نوشیدن آب هستند، به خاطر شرایط نامناسب و گاه دشوار، در وضعیت بدی قرار دارند."],[895,"لایق آنک بدو خو داده‌ایم","در خور آن رزق بفرستاده‌ایم","ما به آن چیزی که به آن عادت کرده‌ایم و خود را برای آن آماده کرده‌ایم، لایق هستیم. به همین دلیل، خداوند هم رزق و روزی متناسب با آن را برای ما فرستاده است."],[895,"خوی آن را عاشق نان کرده‌ایم","خوی این را مست جانان کرده‌ایم","ما خود را به عشق نان و روزی وابسته کرده‌ایم و در عوض، دیگری را به عشق محبوبش؛ به همین دلیل، احساسات و خواسته‌های هر یک از ما متفاوت شده است."],[895,"چون به خوی خود خوشی و خرمی","پس چه از درخورد خویت می‌رمی","چون به ذات خود خوشی و خوشحالی می‌رسی، پس برای چه از درخت خوشی می‌ریزید؟"],[895,"مادگی خوش آمدت چادر بگیر","رستمی خوش آمدت خنجر بگیر","به تو می‌گوید که خوش آمدی، اگر ضعیف و لاغر هستی، چادری بر سر بگذار و اگر قوی هستی مثل رستم، سلاحی مثل خنجر بگیر."],[895,"این سخن پایان ندارد وآن فقیر","گشته است از زخم درویشی عقیر","این حرف‌ها پایانی ندارد و آن فقیر به خاطر زخم‌هایی که از زندگی درویشی خورده، رنجیده و خسته شده است."],[896,"دید در خواب او شبی و خواب کو","واقعه بی‌خواب صوفی‌راست خو","در خواب، او را دید و خوابش برای صوفی بی‌خواب، ماجرایی واقعی است."],[896,"هاتفی گفتش کای دیده تعب","رقعه‌ای در مشق وراقان طلب","هاتفی به او گفت: ای دیده، خواب تو نوعی تعبیر است؛ یک ورق یا نوشته‌ای از شاگردان این خطاطان را بخواه."],[896,"خفیه زان وراق کت همسایه است","سوی کاغذپاره‌هاش آور تو دست","شخصی که در حال نوشتن است، از او خواسته شده که کاغذپاره‌های همسایه را که پنهان است، به سوی خود بیاورد."],[896,"رقعه‌ای شکلش چنین رنگش چنین","بس بخوان آن را به خلوت ای حزین","یک تکه کاغذ به این شکل و با این رنگ را در خلوت بخوان، ای غمگین."],[896,"چون بدزدی آن ز وراق ای پسر","پس برون رو ز انبهی و شور و شر","اگر آن نامه یا رقعه را از وراق، یعنی نویسنده یا خطاط، دزدیدی، یعنی به دست آوردی، باید از شلوغی و هیاهو بیرون بروی و در گمراهی و آشفتگی نباشی."],[896,"تو بخوان آن را به خود در خلوتی","هین مجو در خواندن آن شرکتی","به تنهایی آن گنج‌نامه را بخوان و در این قرائت به هیچ‌کس شریک نشو، زیرا در خلوت و راز این کار اهمیت بیشتری دارد."],[896,"ور شود آن فاش هم غمگین مشو","که نیابد غیر تو زان نیم جو","اگر این راز فاش شود، نگران نباش، چون هیچ کس جز تو از آن بهره‌مند نخواهد شد و نمی‌تواند آن را درک کند."],[896,"ور کشد آن دیر هان زنهار تو","ورد خود کن دم به دم لاتقنطوا","اگر آن دیر (که احتمالا می‌تواند اشاره به دوری یا محنتی باشد) تو را بترساند، تو همیشه به ورد و ذکر خود ادامه بده و ناامید مباش."],[896,"این بگفت و دست خود آن مژده‌ور","بر دل او زد که رو زحمت ببر","این را گفت و دست خود را به علامت بشارت بر دل او گذاشت تا او از دردسرها و زحمت‌ها رهایی یابد."],[896,"چون به خویش آمد ز غیبت آن جوان","می‌نگنجید از فرح اندر جهان","پس از اینکه جوان از حالت غیبت به خود آمد و به واقعیت پی برد، آن‌قدر خوشحال و شادمان بود که جای خود را در دنیا نمی‌یافت."],[896,"زهره او بر دریدی از قلق","گر نبودی رفق و حفظ و لطف حق","شجاعت و دل و جرأت او از ترس و تردیدش فراتر رفته است، اگر رحمت و لطف خداوند و نرمی و حسن سلوک نبود، چنین جسارتی به دست نمی‌آمد."],[896,"یک فرح آن کز پس ششصد حجاب","گوش او بشنید از حضرت جواب","یک لحظه شادی که او پس از ششصد حجاب، توانست صدای پاسخ خداوند را بشنود."],[896,"از حجب چون حس سمعش در گذشت","شد سرافراز و ز گردون بر گذشت","وقتی حس شنوایی او از موانع فراتر رفت، به جایگاه بلندی دست یافت و از زمین و آسمان عبور کرد."],[896,"که بود کان حس چشمش ز اعتبار","زان حجاب غیب هم یابد گذار","چشم او، که قدرت دیدن دارد، به خاطر اعتبار خود، از آن حجاب غیبی عبور می‌کند و به حقیقت و معانی پنهان دست پیدا می‌کند."],[896,"چون گذاره شد حواسش از حجاب","پس پیاپی گرددش دید و خطاب","زمانی که حواس او از پرده پنهان برداشته شود، مرتب او دیدنی‌ها و صداهایی را تجربه می‌کند و با آن‌ها سخن می‌گوید."],[896,"جانب دکان وراق آمد او","دست می‌برد او به مشقش سو به سو","او به سوی دکان کتاب‌فروشی رفت و دستش را به سمت کاری که داشت، دراز کرد و مشغول نوشتن شد."],[896,"پیش چشمش آمد آن مکتوب زود","با علاماتی که هاتف گفته بود","او به سرعت آن نوشته را دید که حاوی نشانه‌هایی بود که هاتف (صوت خدا) از قبل بیان کرده بود."],[896,"در بغل زد گفت خواجه خیر باد","این زمان وا می‌رسم ای اوستاد","خواجه (مخاطب جمله) را در آغوش گرفت و گفت: «خیر باشد، این زمان به تو می‌رسم، ای استاد!"],[896,"رفت کنج خلوتی و آن را بخواند","وز تحیر واله و حیران بماند","او به گوشه‌ای خلوت رفت و گنج‌نامه را خواند و از شگفتی و حیرت در حالت سردرگمی و گیجی باقی ماند."],[896,"که بدین سان گنج‌نامه بی‌بها","چون فتاده ماند اندر مشقها","گنج‌نامه‌ای که به این شکل بی‌ارزش شده، مانند چیزی است که در نوشته‌ها و مشق‌ها افتاده و فراموش شده است."],[896,"باز اندر خاطرش این فکر جست","کز پی هر چیز یزدان حافظست","او دوباره در دلش این فکر را درمی‌یابد که هر چیزی که به دنبالش می‌رود، تحت حفاظت و نگهداری خداوند است."],[896,"کی گذارد حافظ اندر اکتناف","که کسی چیزی رباید از گزاف","خداوند، حافظ و نگهدار بندگان خود است و اجازه نمی‌دهد که کسی بدون دلیل و مجوز چیزی را از دیگری برباید."],[896,"گر بیابان پر شود زر و نقود","بی رضای حق جوی نتوان ربود","اگر بیابان پر از طلا و پول شود، بدون اجازه خدا نمی‌توان چیزی را دزدید."],[896,"ور بخوانی صد صحف بی سکته‌ای","بی قدر یادت نماند نکته‌ای","اگر صدها صفحه را بدون وقفه بخوانی، هیچ نکته‌ای در خاطرت نخواهد ماند و چیزی از آن یاد نخواهی کرد."],[896,"ور کنی خدمت نخوانی یک کتیب","علمهای نادره یابی ز جیب","اگر به خدمت کسی مشغول شوی و کتابی نخوانی، علم‌های نایاب و ارزشمندی را از جیب او پیدا خواهی کرد."],[896,"شد ز جیب آن کف موسی ضو فشان","کان فزون آمد ز ماه آسمان","کف موسی (علیه‌السلام) که در جیبش بود، نورانی شد و نورش از نور ماه آسمان بیشتر گردید."],[896,"کانک می‌جستی ز چرخ با نهیب","سر بر آوردستت ای موسی ز جیب","اگر می‌خواهی از چرخ (فعل الهی یا سرنوشت) چیز بیشتری بیابی، باید با همه وجود و قدرت تلاش کنی، ای موسی، زیرا به حقایق بالاتر دست پیدا خواهی کرد."],[896,"تا بدانی که آسمانهای سمی","هست عکس مدرکات آدمی","برای اینکه بفهمی، آسمان‌ها (عالم‌های بالا) بازتاب‌دهنده شناخت‌ها و یافته‌های بشری هستند."],[896,"نی که اول دست یزدان مجید","از دو عالم پیشتر عقل آفرید","مقصود این است که خداوند متعال (یزدان) ابتدا عقل را خلق کرد قبل از اینکه جهان و هر چیزی در آن را بیافریند. بنابراین، عقل از تمام موجودات و عالم‌ها، وجودی مهم‌تر و پیشین دارد."],[896,"این سخن پیدا و پنهانست بس","که نباشد محرم عنقا مگس","این سخن به وضوح و به طور پنهان بسیار پیچیده است، زیرا تنها کسی می‌تواند به آن دست یابد که از رازها و مسائل عمیق آگاه باشد؛ مانند عنقا که یک پرنده افسانه‌ای است و فقط مگس‌ها نمی‌توانند به آن نزدیک شوند."],[896,"باز سوی قصه باز آ ای پسر","قصه گنج و فقیر آور به سر","ای پسر، دوباره به داستان برگردیم؛ داستان گنج و فقیر را به پایان برسان."],[897,"اندر آن رقعه نبشته بود این","که برون شهر گنجی دان دفین","در آن نامه نوشته شده بود که در خارج از شهر، گنجی پنهان و باارزش وجود دارد."],[897,"آن فلان قبه که در وی مشهدست","پشت او در شهر و در در فدفدست","آن قبه‌ای که در آن مشهد قرار دارد، پشت آن قبه، در شهر، دشت وسیعی وجود دارد."],[897,"پشت با وی کن تو رو در قبله آر","وانگهان از قوس تیری بر گذار","به او بگو که پشت به قبله بایستد و سپس تو تیر را از کمان رها کن تا به هدف برسد."],[897,"چون فکندی تیر از قوس ای سعاد","بر کن آن موضع که تیرت اوفتاد","وقتی که ای سعاد، تیر را از کمان پرتاب کردی، باید آن محلی را که تیر به زمین افتاده مشخص کنی."],[897,"پس کمان سخت آورد آن فتی","تیر پرانید در صحن فضا","سپس آن شخص، کمان محکم را برداشت و در فضای باز تیر را پرتاب کرد."],[897,"زو تبر آورد و بیل او شاد شاد","کند آن موضع که تیرش اوفتاد","او (فتی) تبر و بیل را با شادمانی آورد تا محلی را که تیرش در آنجا افتاده، آماده کند."],[897,"کند شد هم او و هم بیل و تبر","خود ندید از گنج پنهانی اثر","او (فقیر) و ابزارش (بیل و تبر) به تدریج ضعیف و فرسوده شدند، اما او هیچ نشانه‌ای از گنج پنهان ندید."],[897,"هم‌چنین هر روز تیر انداختی","لیک جای گنج را نشناختی","تو هر روز تلاش و کوشش کردی و تیر انداختی، اما نتوانستی مکان گنج را پیدا کنی و نشانی از آن بیابی."],[897,"چونک این را پیشه کرد او بر دوام","فجفجی در شهر افتاد و عوام","این فقیر به طور مداوم این کار را انجام داد و در نتیجه، سر و صدای زیادی در شهر ایجاد شد و مردم عادی از ماجرا مطلع شدند."],[898,"پس خبر کردند سلطان را ازین","آن گروهی که بدند اندر کمین","گروهی که در کمین بودند، به سلطان خبر دادند که شخصی گنج‌نامه‌ای پیدا کرده است."],[898,"عرضه کردند آن سخن را زیردست","که فلانی گنج‌نامه یافتست","به زیردستان خبر دادند که شخصی به نام فلانی، گنج‌نامه‌ای یافته است."],[898,"چون شنید این شخص کین با شه رسید","جز که تسلیم و رضا چاره ندید","این شخص که خبر را شنید، متوجه شد که این اطلاعات به پادشاه رسیده است و جز تسلیم و پذیرش تقدیر راهی برای خود نمی‌بیند."],[898,"پیش از آنک اشکنجه بیند زان قباد","رقعه را آن شخص پیش او نهاد","پیش از این که آن شخص تحت فشار و آزار قباد قرار بگیرد، نامه (رقعه) را به او تسلیم کرد."],[898,"گفت تا این رقعه را یابیده‌ام","گنج نه و رنج بی‌حد دیده‌ام","او گفت که من تا به حال این نامه را پیدا کرده‌ام، اما برایم گنجی وجود ندارد و فقط رنجی بی‌پایان را تجربه کرده‌ام."],[898,"خود نشد یک حبه از گنج آشکار","لیک پیچیدم بسی من هم‌چو مار","من نه‌تنها به یک دانه از آن گنج نمی‌رسم، بلکه مانند ماری در کمین‌گاهی که در آن پیچیده شده‌ام، به دور و بر می‌گردم و در انتظار فرصت برای بهره‌برداری هستم."],[898,"مدت ماهی چنینم تلخ‌کام","که زیان و سود این بر من حرام","مدت‌هاست که مانند یک ماهی غمگین هستم و از آنجایی که چیزهای خوب و بد برای من ممنوع است، احساس تلخی می‌کنم."],[898,"بوک بختت بر کند زین کان غطا","ای شه پیروزجنگ و دزگشا","ای شاه پیروز جنگ و پیروز در اقدامات، بخت تو این گنج را از پرده‌ای که بر آن پوشیده، کنار می‌زند."],[898,"مدت شش ماه و افزون پادشاه","تیر می‌انداخت و برمی‌کند چاه","پادشاه به مدت شش ماه و حتی بیشتر، تیر می‌زد و چاه‌ها را می‌کند."],[898,"هرکجا سخته کمانی بود چست","تیر داد انداخت و هر سو گنج جست","هر جا که کمان کشیده شد و تیر شلیک شد، او به هر طرف جستجو کرد تا گنجی بیابد."],[898,"غیر تشویش و غم و طامات نی","هم‌چو عنقا نام فاش و ذات نی","غیر از نگرانی، غم و اضطراب، هیچ چیز دیگری نیست و نام و ویژگی‌هایی هم مانند «عنقا» (پرنده‌ای افسانه‌ای) وجود ندارد."],[899,"چونک تعویق آمد اندر عرض و طول","شاه شد زان گنج دل سیر و ملول","وقتی که در تلاش برای یافتن گنج، وقفه و تاخیر پیش آمد، شاه به خاطر ناامیدی از دست یافتن به آن گنج دلزده و خسته شد."],[899,"دشتها را گز گز آن شه چاه کند","رقعه را از خشم پیش او فکند","پادشاه از شدت خشم و ناامیدی بر اثر عدم پیدا کردن گنج، دست خود را به سمت دشت‌ها دراز کرده و به یک چاه می زند و در این حال، رقعه (نوشته یا نامه‌ای) را از خشم به زمین می‌اندازد."],[899,"گفت گیر این رقعه کش آثار نیست","تو بدین اولیتری کت کار نیست","او به پادشاه می‌گوید که این نوشته (رقعه) را بگیر و آثار آن را جمع کن، چون تو به این کار شایستگی نداری و این کار برای تو نیست."],[899,"نیست این کار کسی کش هست کار","که بسوزد گل بگردد گرد خار","این کار، کار کسی نیست که شایستگی انجام آن را داشته باشد، زیرا او به مانند گلی است که بسوزد و به خار تبدیل شود."],[899,"نادر افتد اهل این ماخولیا","منتظر که روید از آهن گیا","بسیار نادر است کسانی که در این حالت غم و اندوه به سر می‌برند و منتظر آن هستند که از آهن (فلز) چیز دیگری به وجود آید، مانند گیاه."],[899,"سخت جانی باید این فن را چو تو","تو که داری جان سخت این را بجو","این کار نیاز به صبر و استقامت زیادی دارد، چون تو با روحیه قوی و پایداری که داری، می‌توانی به آن دست پیدا کنی."],[899,"گر نیابی نبودت هرگز ملال","ور بیابی آن به تو کردم حلال","اگر نتوانی گنج را پیدا kنی، هرگز دلت آزرده نخواهد شد، ولی اگر آن را پیدا کنی، خواهم بخشیدت."],[899,"عقل راه ناامیدی کی رود","عشق باشد کان طرف بر سر دود","عقل هرگز به راه ناامیدی نمی‌رود، زیرا عشق باعث می‌شود که انسان به سوی امید و اشتیاق برود. عشق به انسان نیرویی می‌دهد که او را از اندوه دور کند."],[899,"لاابالی عشق باشد نی خرد","عقل آن جوید کز آن سودی برد","عشق نسبت به امور بی‌خیالی و ناپرهیزکاری است، اما عقل به دنبال سود و منفعت است و از آنچه که نتیجه‌ی خوبی ندارد، دوری می‌کند."],[899,"ترک‌تاز و تن‌گداز و بی‌حیا","در بلا چون سنگ زیر آسیا","این برخاستن و عرق‌ریختن و بی‌شرمی در مشکلات، همانند سنگی است که زیر آسیاب قرار دارد و هیچ حرکتی نمی‌تواند از آن دریغ کند. در واقع، انسان در چنین شرایطی نمی‌تواند از سختی‌ها فرار کند و باید با آن‌ها روبه‌رو شود."],[899,"سخت‌رویی که ندارد هیچ پشت","بهره‌جویی را درون خویش کشت","سخت‌رویی که هیچ پشتیبانی ندارد، در واقع مانع از بهره‌برداری و استفاده خود را در درون خود از بین می‌برد."],[899,"پاک می‌بازد نباشد مزدجو","آنچنان که پاک می‌گیرد ز هو","انسان بی‌نیاز از مال و خواسته‌های دنیوی، در حقیقت برنده واقعی است، زیرا او هیچ‌گونه دلبستگی و طلبی ندارد، در حالی که کسی که در پی مزد و پاداش دنیوی است، به‌گونه‌ای خالی از حقیقت و ارزش واقعی زندگی می‌شود."],[899,"می‌دهد حق هستیش بی‌علتی","می‌سپارد باز بی‌علت فتی","خداوند هستی‌اش را بدون هیچ دلیلی عطا می‌کند و همان‌طور بدون هیچ دلیلی به کسی که شایستگی داشته باشد، کمک می‌کند."],[899,"که فتوت دادن بی علتست","پاک‌بازی خارج هر ملتست","فروتنی و بزرگ‌منشی که بدون دلیل داده می‌شود، از ویژگی‌های خاص و برجسته هر قومی است."],[899,"زانک ملت فضل جوید یا خلاص","پاک بازانند قربانان خاص","چرا که ملت به دنبال فضیلت است یا برای نجات، پاکبازان خاصی قربانی می‌شوند."],[899,"نی خدا را امتحانی می‌کنند","نی در سود و زیانی می‌زنند","آنان خدا را نمی‌آزمایند و در مسائل سود و زیان او را نمی‌سنجند."],[900,"چونک رقعه گنج پر آشوب را","شه مسلم داشت آن مکروب را","چون شاه مسلم (سلطان) آن نامه پر از اشوب گنج را مورد توجه قرار داد، به آن مرد بیچاره (فقیر) اعتماد کرد."],[900,"گشت آمن او ز خصمان و ز نیش","رفت و می‌پیچید در سودای خویش","او از دشمنان و تیرهای زهرآگین در امان شد و به راه خود که پر از خواسته‌ها و آرزوهایش است، می‌رفت و در آن غرق بود."],[900,"یار کرد او عشق درداندیش را","کلب لیسد خویش ریش خویش را","او (یار) عشق را که فکر و اندیشه‌اش را به درد و غم مشغول کرده است، مانند سگی که با زبانش ریش خود را لیس می‌زند، به خود مشغول کرده و به آن می‌پردازد."],[900,"عشق را در پیچش خود یار نیست","محرمش در ده یکی دیار نیست","در عشق، کسی نیست که بتواند به عمق پیچیدگی‌ها و احساسات آن پی ببرد؛ هیچ‌کس در این دنیا نیست که درک کننده و همراز عشق باشد."],[900,"نیست از عاشق کسی دیوانه‌تر","عقل از سودای او کور‌ست و کر","هیچ‌کس در عشق، دیوانه‌تر از عاشق نیست؛ عقل او تحت تأثیر عشقش به شدت دچار اختلال شده و حتی قادر به درک واقعیت نیست."],[900,"زآنک این دیوانگی عام نیست","طب را ارشاد این احکام نیست","چون این نوع دیوانگی خاص و منحصر به فرد است، لذا دانش پزشکی نمی‌تواند راهنمایی برای آن ارائه دهد."],[900,"گر طبیبی را رسد زین گون جنون","دفتر طب را فرو شوید به خون","اگر طبیبی به این نوع دیوانگی دچار شود، باید دفتر طب را به خون خود بشوید و کنار بگذارد، زیرا در این حالت او نمی‌تواند معالجه کند."],[900,"طب جمله عقل‌ها منقوش اوست","روی جمله دلبر‌ان روپوش اوست","علم طب، تمام عقل‌ها در آن نقش بسته است و دلبران هم با این علم پنهان شده‌اند."],[900,"روی در روی خود آر ای عشق‌کیش","نیست ای مفتون ترا جز خویش خویش","ای عشق‌کیش (عاشق)، روی خود را به من نشان بده، چرا که تو غیر از خودت هیچ چیز دیگری نداری و در هیچ چیز دیگری جز خودت نمی‌توانی غرق شوی."],[900,"قبله از دل ساخت آمد در دعا","لیس للانسان الا ما سعی","قبله (سمت نماز) از دل ساخته شده و در دعا به آن اشاره می‌شود؛ انسان فقط به آنچه که برایش تلاش کرده، دست می‌یابد."],[900,"پیش از آن کاو پاسخی بشنیده بود","سال‌ها اندر دعا پیچیده بود","قبل از آنکه او پاسخی از خداوند بشنود، سال‌ها دعا کرده بود و همواره در حال درخواست و ناله بود."],[900,"بی‌اجابت بر دعا‌ها می‌تنید","از کرم لبیک پنهان می‌شنید","علیل (بیمار) به دلیل بی‌پاسخ ماندن دعاهایش در حالت ناامیدی و افسردگی به سر می‌برد، اما در عین حال به کرم و رحمت الهی امید دارد و می‌شنود که پاسخی از سوی خداوند در دل او وجود دارد، هرچند این پاسخ به‌وضوح نمایان نیست."],[900,"چونک بی‌دف رقص می‌کرد آن علیل","ز اعتماد جود خلاق جلیل","چون آن علیلی که در رقصی بی‌ضرب و بدون ساز مشغول است، به خاطر اعتماد به بخشش پروردگار بزرگ و مهربان، اینگونه به رقص درآمده است."],[900,"سوی او نه هاتف و نه پیک بود","گوش اومید‌ش پر از لبیک بود","حرف‌ و پیام‌آورانی مانند هاتف و پیک وجود نداشتند که به او برسند؛ اما دل او پر از امید و پاسخ مثبت بود، به طوری که فقط با خود احساسی از شوق و اشتیاق داشت."],[900,"بی‌زبان می‌گفت اومید‌ش تعال","از دلش می‌روفت آن دعوت ملال","او که زبانی برای بیان ندارد، از عمق دلش به‌صورت ناگفته، دوره‌ای از امید و میل را تجربه می‌کند که از آن دعوت و خواسته، به احساس دل‌زدگی و ملال می‌رسد."],[900,"آن کبوتر را که بام آموخته‌ست","تو مخوان می‌رانش کان پر دوخته‌ست","آن کبوتر را که بر بام پرواز آموخته است، تو صدا نزن و نرانش، زیرا که او بال‌هایش را خوب بسته است."],[900,"ای ضیاء الحق حسام‌الدین برانش","کز ملاقات تو بر رسته‌ست جانش","ای ضیاء الحق حسام‌الدین، او را بران، چون جانش از ملاقات تو به آرامش رسیده است."],[900,"گر برانی مرغ جانش از گزاف","هم به‌گرد بام تو آرد طواف","اگر مرغ جانش (روح او) را به‌طور بی‌مورد و بدون دلیل برانی، باز هم دور بام تو (حسین) می‌چرخد و از تو دور نمی‌شود."],[900,"چینه و نقلش همه بر بام تست","پر زنان بر اوج مست دام تست","تمام زحمت و تلاش او در خدمت تو است و تمام زیبایی‌ها و لذت‌های زندگی مانند پرندگان بر اوج دام تو می‌چرخند."],[900,"گر دمی منکر شود دزدانه روح","در ادای شکرت ای فتح و فتوح","اگر لحظه‌ای روح من از شکرگذاری تو (خدا) غافل شود، در دل خود مانند دزدی پنهانی به آن اعتراف می‌کنم و به پیروزی و کامیابی‌ام (که از توست) اشاره می‌کنم."],[900,"شحنه عشق مکرر کینه‌اش","تشت آتش می‌نهد بر سینه‌اش","جوانب عشق باعث می‌شود که کینه‌اش بار دیگر به سرکشی و آتش‌سوزی در وجودش تبدیل شود."],[900,"که بیا سوی مه و بگذر ز گرد","شاه عشقت خواند زوتر باز گرد","به سوی مه (ماه) برو و از گرد و غبار (مشکلات یا فاصله) معشوقت (عشق) گذر کن، چرا که او به زودی تو را به سوی خود خواهد خواند."],[900,"گرد این بام و کبوتر‌خانه من","چون کبوتر پر زنم مستانه من","در اطراف این بام و آشیانه من، مانند کبوتر پرواز می‌کنم و سرمست و شاداب هستم."],[900,"جبرئیل عشقم و سدره‌م توی","من سقیمم عیسی مریم توی","عشق من جبرئیل، و حالت روحانی‌ام به گونه‌ای است که تو در من مانند عیسی، مریم را در آغوش دارد و من بیمار و ضعیف هستم."],[900,"جوش ده آن بحر گوهر‌بار را","خوش بپرس امروز این بیمار را","ای خدای بزرگ و باعظمت، از تو می‌خواهم که آن دریاى پر از گوهر را روی این بیمار (من) باز کنی و به او عطا کنی."],[900,"چون تو آن او شدی بحر آن اوست","گرچه این دم نوبت بحران اوست","اگر تو به مقام «او» رسیدی، همه چیز به همان مقام تعلق دارد، هرچند که اکنون زمان دشواری و آزمایش است."],[900,"این خود آن ناله‌ست کاو کرد آشکار","آنچ پنهان‌ست یا رب زینهار","این همان ناله‌ای است که آشکار کرد آنچه را پنهان است. ای پروردگار، از تو کمک می‌طلبم."],[900,"دو دهان داریم گویا هم‌چو نی","یک دهان پنهان‌ست در لب‌های وی","ما دو نوع صحبت داریم؛ یکی همانند نی که آشکار و واضح است و دیگری که در دل نهفته و پنهان است و تنها در دل شخص وجود دارد."],[900,"یک دهان نالان شده سوی شما","های هویی در فکنده در هوا","صدای ناله و فغان یک دهان به سمت شماست که در فضا پخش شده و همه جا را پر کرده است."],[900,"لیک داند هر که او را منظر‌ست","که فغان این سری هم زان سرست","اما هر کسی که به او توجه کند، می‌داند که این ناله و فغان از سر اوست و او نیز از همان ریشه و سر شکل گرفته است."],[900,"دمدمه این نای از دم‌های اوست","های هوی روح از هیهای اوست","صدای نای در اینجا به دلیل دمیدن و نفس‌های اوست، و روح و زندگی در اینجا از آوازهای او ناشی می‌شود."],[900,"گر نبودی با لبش نی را سمر","نی جهان را پر نکردی از شکر","اگر لب او نبود، نی به شوق و آواز نمی‌رسید و جهان را از شیرینی پر نمی‌کرد."],[900,"با کی خفتی وز چه پهلو خاستی","که چنین پر جوش چون دریا‌ستی","با چه کسی هم‌خواب شده‌ای و از چه طرفی به بستر رفته‌ای که این‌قدر پرشور و سرزنده‌ای مثل دریا؟"],[900,"یا ابیت عند ربی خواندی","در دل دریای آتش راندی","تو ای معشوق، در دل رازهای آتشین، در درگاه خداوند، درست مثل کسی که در آغوش پروردگارش است، آرامش می‌جویی و به ناله و نیایش مشغولی."],[900,"نعره یا نار کونی باردا","عصمت جان تو گشت ای مقتدا","ندای «ای آتش، حاضر باش!» به گوش می‌رسد، که این فرمان به تو، ای پیشوای بزرگ، رسیده است و جان تو از گناه پاک و معصوم شده است."],[900,"ای ضیاء الحق حسام دین و دل","کی توان اندود خورشید‌ی به گل","ای روشنایی حق، حسام‌الدین، چگونه می‌توان خورشیدی را با گل پوشاند؟"],[900,"قصد کرده‌ستند این گل‌پاره‌ها","که بپوشانند خورشید ترا","این گل‌های زیبا (یعنی دلایل و مشکلات) تصمیم گرفته‌اند که وجود و نور حقیقی تو را (که خورشید است) بپوشانند و مخفی کنند."],[900,"در دل که لعل‌ها دلال تست","باغها از خنده مالامال تست","در دل تو، گوهرهای قیمتی و باارزش وجود دارد که نشان از علاقه و شوق تو دارد، و باغ‌ها از شادی و خوشحالی تو پر هستند."],[900,"محرم مردی‌ت را کو رستمی‌‌؟","تا ز صد خرمن یکی جو گفتمی","محرم و رازدار تو که کسی است چون رستم، قهرمان بزرگ؟ مگر می‌توانم از بین صدها خرمن، تنها یک دانه جو را بگویم یا بگیرم؟"],[900,"چون بخواهم کز سرت آهی کنم","چون علی سر را فرو چاهی کنم","هرگاه بخواهم از دل تو آهی بیرون بیاورم، مانند علی، سر خود را به چاهی عمیق می‌زنم."],[900,"چونک اخوان را دل کینه‌ورست","یوسفم را قعر چه اولی‌ترست","چون برادران یوسف دل پر کینه دارند، پس او در قعر چاه (جایگاه بد) شایسته‌تر است."],[900,"مست گشتم خویش بر غوغا زنم","چه چه باشد خیمه بر صحرا زنم","من در حالت شاد و سرمست قرار دارم و می‌خواهم در این حال شادی و جنبش برپا کنم. چه دلیلی دارد که خیمه‌ای در بیابان برپا نکنم؟"],[900,"بر کف من نه شراب آتشین","وانگه آن کر و فر مستانه بین","در دستان من نه شراب داغ و آتشین است و نه حال و هوای مستانه‌ای که آن را به همراه داشته باشد."],[900,"منتظر گو باش بی گنج آن فقیر","زآنک ما غرقیم این دم در عصیر","ای فقیر، منتظر نمان و به دنبال گنج نباش؛ زیرا ما در این لحظه در شراب عشق غرق شده‌ایم و حالتی ناب داریم."],[900,"از خدا خواه ای فقیر این دم پناه","از من غرقه شده یاری مخواه","ای فقیر، در این لحظه از خدا طلب کن که به تو پناه دهد، زیرا من که در مشکلات غرق شده‌ام، نمی‌توانم کمکی به تو بکنم."],[900,"که مرا پروای آن اسناد نیست","از خود و از ریش خویشم یاد نیست","من به اسنادی که نشان‌دهنده اخلاقت یا نسبم باشد اهمیت نمی‌دهم و حتی به ریشه و خاستگاه خود نیز توجهی ندارم."],[900,"باد سبلت کی بگنجد و آب رو","در شرابی که نگنجد تار مو","موهای مجعد و خمیده، مانند باد، نمی‌توانند در آبی جای بگیرند که شراب در آن نمی‌گنجد. اینجا به تضاد بین لطافت مو و مایعات اشاره شده و نشان می‌دهد که برخی چیزها به‌راحتی با هم هماهنگ نمی‌شوند."],[900,"در ده ای ساقی یکی رطلی گران","خواجه را از ریش و سبلت وا رهان","ای ساقی، در این ده یکی ظرف بزرگ شراب بیاور و خواجه را از چنگال ریش و موهای خود آزاد کن."],[900,"نخوت‌ش بر ما سبالی می‌زند","لیک ریش از رشک ما بر می‌کند","نخوت و تکبر او بر ما می‌تازد، اما او به خاطر حسادت ما، ریشش را می‌کند."],[900,"مات او و مات او و مات او","که همی‌دانیم تزویر‌ات او","ما همگی در برابر او (مولاتن) شگفت‌زده و حیرانیم، زیرا می‌دانیم که نیرنگ و فریب او چقدر عمیق و ماهرانه است."],[900,"از پس صد سال آنچ آید ازو","پیر می‌بیند معین مو به مو","پیر (عالم یا سالک) بعد از صد سال از آنچه در دل و نیت انسانی است، به‌طور دقیق و بدون هیچ کم و کسر، آگاه می‌شود و آن را می‌بیند."],[900,"اندر آیینه چه بیند مرد عام","که نبیند پیر اندر خشت خام","مرد عام (نسبت به عامی و جاهل) در آینه به چه چیزهایی می‌نگرد که پیر (مرد با تجربه) در آجر خام نمی‌تواند ببیند. این بیت نشان‌دهنده دید و درک عمیق‌تر افراد با تجربه نسبت به ساده‌لوحان است."],[900,"آنچ لحیانی به خانه خود ندید","هست بر کوسه یکایک آن پدید","لحظه‌ای که انسان درون خود را نبیند، مانند یک کوسه است که در دریا تنها یک یک از ماهی‌ها را می‌بیند و از عمق دریا غافل است. به عبارتی، آنچه درون ماست، گاهی اوقات مانند عیب‌های پنهان است که نمی‌توانیم ببینیم."],[900,"رو به دریایی که ماهی‌زاده‌ای","هم‌چو خس در ریش چون افتاده‌ای","شما به دریا رو می‌آورید که در آن ماهی‌زاده‌ای هم‌چون مروارید در ریش یک موجود که به آنجا افتاده است، وجود دارد. اشاره به این دارد که گویی در عمق دریا گوهری نهفته است که در گیسوان موجودی دیده می‌شود."],[900,"خس نه‌ای دور از تو رشک گوهری","در میان موج و بحر اولی‌تری","تو در دریا چون یک مروارید باارزش هستی و شایسته‌تر از هر چیز دیگر هستی، پس نباید خود را کمتر از آن ببینی که به گوهری که در میان آن موج و دریا قرار دارد رشک ببری."],[900,"بحر وحدانی‌ست جفت و زوج نیست","گوهر و ماهیش غیر موج نیست","وجود واحدی در جهان همانند دریاست که هیچ جفت و زوجی ندارد و تنها مروارید و ماهی‌اش چیزی غیر از امواج نیستند."],[900,"ای محال و ای محال اشراک او","دور از آن دریا و موج پاک او","این‌جا به خدایی اشاره شده که وجودش غیر ممکن است که با شرکت و شریک بودن قابل تصور نیست. او منزه از هر گونه نقص و دور از دریا و امواجی است که نشان‌دهنده شرک و اختلاف هستند."],[900,"نیست اندر بحر شرک و پیچ پیچ","لیک با احول چه گویم هیچ هیچ","در دریاچه شرک چیزی وجود ندارد، اما با احول (مردان نادان) چیزی نمی‌توان گفت و هیچ نمی‌توان بیان کرد."],[900,"چونک جفت احولانیم ای شمن","لازم آید مشرکانه دم زدن","چون ما مانند افرادی نادان و احول هستیم، ای شمن (عالم و صاحب معرفت)، لازم است که به طور نادرست و شرک‌آلود سخن بگوییم."],[900,"آن یکیی زان سوی وصف‌ست و حال","جز دوی ناید به میدان مقال","یکی از آن دو طرف، وصف و حال را بیان می‌کند، و غیر از این دو، چیزی در میدان بحث نمی‌آید."],[900,"یا چو احول این دوی را نوش کن","یا دهان بردوز و خوش خاموش کن","یا مانند احول (کسی که به دلیل نداشتن عقل صحیح، عاقلانه رفتار نمی‌کند) این دو طرف را شیرین کن و با گفتار زیبا آنها را به هم نزدیک کن، یا دهان خود را ببند و به آرامی و با سکوت، در این بحث شرکت نکن."],[900,"یا به نوبت گه سکوت و گه کلام","احولانه طبل می‌زن والسلام","یا گاهی سکوت کن و گاهی نیز سخن بگو، مثل احول که به نوبت طبل می‌زند و در این حالت، تنها به این روش ادامه بده."],[900,"چون ببینی محرمی گو سر جان","گل ببینی نعره زن چون بلبلان","وقتی کسی را ببینی که با جان و دل، عشق و محبت را فریاد می‌زند و خود را به رنگ گل درآورده، مانند بلبلانی که به خاطر عشق ناله و فریاد می‌کنند، در آن لحظه دلی پرشور و احساسات پاک را مشاهده می‌کنی."],[900,"چون ببینی مشک پر مکر و مجاز","لب ببند و خویشتن را خنب ساز","وقتی که ببینی شخصی حیله‌گر و فریبکار به طرز زیرکانه‌ای در حال صحبت است، بهتر است سکوت کنی و خود را از او دور نگه‌داری تا در دام او نیفتی."],[900,"دشمن آبست پیش او مجنب","ورنه سنگ جهل او بشکست خنب","دشمن که در اینجا اشاره به دشمنی است که در کمین است، نزدیک او حرکت نکن، زیرا اگر نزدیک شوی، سنگ جهل او تو را آسیب خواهد زد."],[900,"با سیاست‌های جاهل صبر کن","خوش مدارا کن به عقل من لدن","با روش‌های نادانانه (جاهل) صبر کن و با مدارا و حسن رفتار، به عقل و دانش من دست پیدا کن."],[900,"صبر با نا‌اهل اهلان را جلی‌ست","صبر صافی می‌کند هر جا دلی‌ست","صبر در برابر نادان‌ها و نااهلان، باعث روشن شدن چهره‌ی واقعی آن‌ها می‌شود. صبر سبب می‌شود که دل‌ها پاک و شفاف شوند."],[900,"آتش نمرود ابراهیم را","صفوت آیینه آمد در جلا","آتش نمرودی که ابراهیم در آن افکنده شد، به واسطه‌ی صفوت و پاکی روح ابراهیم، مانند آینه‌ای درخشان شد و جلا گرفت."],[900,"جور کفر نوحیان و صبر نوح","نوح را شد صیقل مرآت روح","سختی و ظلم کافران در زمان نوح (نوحیان) و صبوری نوح (پیامبر) باعث شد روح او مثل آینه پاک و روشن شود."],[901,"رفت درویشی ز شهر طالقان","بهر صیت بوالحسین خارقان","درویشی از شهر طالقان برای دیدن بوالحسین خارقان، که مشهور و معروف بود، به سفر رفت."],[901,"کوه‌ها ببرید و وادی دراز","بهر دید شیخ با صدق و نیاز","در این بیت، اشاره به سختی‌ها و مشقت‌هایی است که درویش برای دستیابی به شیخ حسن خرقانی (مرید او) در مسیر خود تحمل کرده است. او حتی کوه‌ها را می‌شکافد و دره‌ها را طی می‌کند تا فرشتگی و نیاز واقعی را همراه با صداقت یافت کند."],[901,"آنچ در ره دید از رنج و ستم","گرچه در خوردست کوته می‌کنم","هرچیزی که در مسیر دید، از جمله دردها و ظلم‌هایی که بر او رفت، را با وجود اینکه ممکن است به نظر کوچک بیاید، به خاطر احترام به مقام شیخ و حقایق بلند معنوی و خرد می‌کند و کوچک می‌داند."],[901,"چون به مقصد آمد از ره آن جوان","خانه آن شاه را جست او نشان","آن جوان پس از اینکه به مقصد رسید، به دنبال نشانی از خانه آن شاه می‌گشت."],[901,"چون به صد حرمت بزد حلقه درش","زن برون کرد از در خانه سرش","جوان با احترام بسیار به در خانه آن شاه رسید و در را زد و او (شاه) سرش را از در خانه بیرون آورد."],[901,"که چه می‌خواهی بگو ای ذوالکرم","گفت بر قصد زیارت آمدم","زن از مرد خواسته می‌پرسد که چه هدفی دارد و او پاسخ می‌دهد که برای زیارت آمده است."],[901,"خنده‌ای زد زن که خه‌خه ریش بین","این سفر‌گیری و این تشویش بین","زن خنده‌ای زد و گفت: \"به این ریش خشک و پرهیاهو، بین این مسافر و این نگرانی‌هایش چه شباهتی وجود دارد.\" در واقع، او به شوخی به وضعیت مسافر و نگرانی‌های او اشاره می‌کند."],[901,"خود ترا کاری نبود آن جایگاه","که به بیهوده کنی این عزم راه","تو را هیچ کاری در آن مقام نیست که بخواهی به‌خاطر کارهای بیهوده، این تصمیم را بگیری که راهی شوی."],[901,"اشتهای گول‌گردی آمدت","یا ملولی وطن غالب شدت","اشتیاق به گردش و تفریح چنان تو را فراگرفته که اگر به وطن بازگردی، احساس یکنواختی و کسالت خواهی کرد."],[901,"یا مگر دیوت دو شاخه بر نهاد","بر تو وسواس سفر را در گشاد","شاید شیطان دو شاخه بر تو گذاشته که وسوسه‌ات کند و سفر را برایت دشوار سازد."],[901,"گفت نا‌فرجام و فحش و دمدمه","من نتانم باز گفتن آن همه","او (مرید) گفت که به هیچ وجه نمی‌توانم آن همه سخن و ناسزا را که ناگهان بر من نثار شد، بازگو کنم."],[901,"از مثل وز ریش‌خند بی‌حساب","آن مرید افتاد از غم در نشیب","آن مرید به خاطر مسخره‌ و ریش‌خندهای بی‌پایان، به شدت دچار غم شده و در حالت ناامیدی و فرود قرار گرفته است."],[902,"اشکش از دیده بجست و گفت او","با همه آن شاه شیرین‌نام کو","او با اشک از چشمانش (از شدت احساس) گفت که با وجود تمام خوبی‌ها و نام نیک آن پادشاه شیرین‌نام (که احتمالا به مراد یا محبوبش اشاره دارد)، چه کسی می‌تواند او را پیدا کند یا به او دسترسی داشته باشد."],[902,"گفت آن سالوس زراق تهی","دام گولان و کمند گمرهی","سالوس (جاهل و ریاکار) گفت: \"دریغ از دام‌های زرق و فریب، زیرا گول‌ها (فریب‌خوردگان) در کمند گمراهی افتاده‌اند.\" اینجا به دام‌ها و فریب‌های روحانی اشاره دارد که انسان‌ها را در سردرگمی و جهل نگه می‌دارد."],[902,"صد هزاران خام ریشان هم‌چو تو","اوفتاده از وی اندر صد عتو","هزاران جوان نادان و کم‌تجربه مانند تو، به خاطر او (شیخ) در سختی و مشکل افتاده‌اند و گرفتار مشکلات شده‌اند."],[902,"گر نبینیش و سلامت وا روی","خیر تو باشد نگردی زو غوی","اگر او را نبینی و در صحت و سلامت بماند، خیر تو در این است که از او دور نشوی و به او وابسته نگردی."],[902,"لاف‌کیشی کاسه‌لیسی طبل‌خوار","بانگ طبلش رفته اطراف دیار","کسانی که به خود می‌بازند و در غرور خود غرق شده‌اند، مانند افرادی هستند که به صدای طبل و نمایش‌های فریبنده‌ای که به اطراف می‌آید، دل خوش کرده‌اند. اینان به ظاهر و شهرت اهمیت می‌دهند، اما در واقع چیزی به دست نمی‌آورند."],[902,"سبطی‌اند این قوم و گوساله‌پرست","در چنین گاوی چه می‌مالند دست","این جماعت به خاطر شخصیت‌ها و مظاهر دروغین خود (که به طلسم و بت‌پرستی تشبیه شده‌اند) گرفتار هستند. در چنین شرایطی، آن‌ها چگونه می‌توانند به حقیقت و محتوای ارزشمند دست یابند؟"],[902,"جیفة اللیلست و بطال النهار","هر که او شد غره این طبل‌خوار","هر کس که در خواب و غفلت شبانه باشد و از کار و فعالیت در طول روز بازماند، به مانند زباله و بی‌فایده است و به دام فریب‌دهنده‌ی دنیا افتاده است."],[902,"هشته‌اند این قوم صد علم و کمال","مکر و تزویری گرفته کینست حال","این گروه از عالمان و فاضلان دارای علم و کمال هستند، اما در باطن، مملو از مکری و فریب‌اند و واقعیت آن‌ها چیز دیگری است."],[902,"آل موسی کو دریغا تاکنون","عابدان عجل را ریزند خون","عابدان و عبادت‌کنندگان در زمان موسی، در اثر جهل و نادانی خود همچنان مشغول کارهای نادرست و بی‌حرمتی هستند و خون افرادی مثل عجل (گوساله‌ای که قوم موسی پرستش کرده بودند) را می‌ریزند، که نشان‌دهنده‌ی فساد و انحراف آنهاست."],[902,"شرع و تقوی را فکنده سوی پشت","کو عمر کو امر معروفی درشت","شرع و تقوا را به کنار انداخته‌اند، و به دنبال عمر و دنیا رفته‌اند. آیا کسی از امر به معروف و ناهی از منکر جدی‌تر وجود دارد؟"],[902,"کین اباحت زین جماعت فاش شد","رخصت هر مفسد قلاش شد","این گروه به ترویج و گسترش اباحه‌گری (بخشندگی در احکام شرع) پرداخته‌اند، به‌طوری که این مسأله به مجوزی برای هر فاسد و فاسدکاری تبدیل شده است."],[902,"کو ره پیغامبری و اصحاب او","کو نماز و سبحه و آداب او","کجاست راه پیامبری و یاران او؟ کجاست نماز و سجده و آداب او؟"],[903,"بانگ زد بر وی جوان و گفت بس","روز روشن از کجا آمد عسس","جوان به او صدا زد و پرسید که مأمور (عسس) در روز روشن از کجا آمده است."],[903,"نور مردان مشرق و مغرب گرفت","آسمان‌ها سجده کردند از شگفت","مردان الهی از شرق و غرب جهان، نور و روشنی خود را دریافت کردند و به همین دلیل آسمان‌ها از شگفتی و حیرت، بر آن‌ها سجده کردند."],[903,"آفتاب حق بر آمد از حمل","زیر چادر رفت خورشید از خجل","آفتاب حق (هدایت الهی) از زیر چادر (پوشش دنیا) پدیدار شد و خورشید (خورشید ظاهری) به خاطر خجالت از آن روشنایی محو شد."],[903,"ترهات چون تو ابلیسی مرا","کی بگرداند ز خاک این سرا","حرف‌های بیهوده تو که شبیه ابلیس است، چگونه می‌تواند مرا از این خاک و دنیای مادی دور کند؟"],[903,"من به بادی نامدم هم‌چون سحاب","تا به گردی باز گردم زین جناب","من به‌عنوان انسانی به دنیا نیامده‌ام که با یک وزش باد، مانند ابرها، ناپدید شوم و دوباره به اینجا برگردم."],[903,"عجل با آن نور شد قبله کرم","قبله بی آن نور شد کفر و صنم","عجل، که به معنای بز بهشتی است، با آن نور (نور الهی) به عنوان قبله و مرکز خوبی‌ها و رحمت شناخته می‌شود. اما اگر این نور وجود نداشته باشد، قبله تبدیل به کفر و بت‌پرستی خواهد شد."],[903,"هست اباحت کز هوای آمد ضلال","هست اباحت کز خدا آمد کمال","آشفتگی و انحراف ناشی از هوای نفس، مجاز است و به نوعی آزادگی محسوب می‌شود، اما کمال و رفع نقص تنها از طرف خداوند به دست می‌آید."],[903,"کفر ایمان گشت و دیو اسلام یافت","آن طرف کان نور بی‌اندازه تافت","کفر به ایمان تبدیل شد و دیو (نماد شر و پلیدی) در دامان اسلام جا پیدا کرد، در آن سو سویی قرار دارد که نور بی‌نهایتی از آن ساطع می‌شود."],[903,"مظهر عزست و محبوب به حق","از همه کروبیان برده سبق","مظهر عزت و محبوب واقعی، از همه مقربان و فرشتگان بالاتر است و برتری خاصی دارد."],[903,"سجده آدم را بیان سبق اوست","سجده آرد مغز را پیوست پوست","سجده آدم برای خدا نشانه برتری اوست، همان‌طور که مغز انسان مهم‌تر از پوست اوست و با وجود پوست، مغز در پیوستگی و هنوز در مورد آن سخن می‌گوید."],[903,"شمع حق را پف کنی تو ای عجوز","هم تو سوزی هم سرت ای گنده‌پوز","اگر تو، ای زن سالخورده، بر شمع حقیقت بدمی، هم خود، آتش را خاموش می‌کنی و هم برای خود، عذاب می‌آوری."],[903,"کی شود دریا ز پوز سگ نجس","کی شود خورشید از پف منطمس","هیچ‌گاه دریا به خاطر دهان سگ نجس به دریا بدل نمی‌شود و خورشید نیز نمی‌تواند از پف و تنفس انسانی به وجود آید. این آهنگ به وضوح نشان می‌دهد که حقیقت و عظمتی که در طبیعت وجود دارد تحت تأثیر چیزهای بی‌ارزش و ناپاک قرار نمی‌گیرد."],[903,"حکم بر ظاهر اگر هم می‌کنی","چیست ظاهرتر بگو زین روشنی","اگر درباره چیزهای ظاهری قضاوت می‌کنی، بگو ببینم دلیل آن چیست و آیا حقیقتی روشن‌تر از اینها وجود دارد؟"],[903,"جمله ظاهرها به پیش این ظهور","باشد اندر غایت نقص و قصور","همه چیزهایی که به ظاهر دیده می‌شوند، در برابر این نور روشن، در نهایت نقص و کمبود قرار دارند."],[903,"هر که بر شمع خدا آرد پف او","شمع کی میرد‌؟ بسوزد پوز او","هر کسی که با نفس کثیف خود بر نور الهی (شمع خدا) فوت کند و بخواهد آن را خاموش کند، آیا می‌تواند نور (شمع) را بکشد؟ در واقع، او تنها خود را عذاب می‌دهد و دچار آتش می‌شود."],[903,"چون تو خفاشان بسی بینند خواب","کاین جهان ماند یتیم از آفتاب","به cause شب‌زنده‌داران (خفاشان) نگاه کن که در خواب هستند، مثل این که این جهان به دلیل نبود نور و روشنایی از آفتاب، به یتیمی دچار شده است."],[903,"موج‌های تیز دریاهای روح","هست صد چندان که بد طوفان نوح","موج‌های تند و خروشان دریاهای روح، بسیار بیشتر و شدیدتر از طوفان نوح است."],[903,"لیک اندر چشم کنعان موی رست","نوح و کشتی را بهشت و کوه جست","اما در چشمان کنعان، نوح و کشتی او را مانند مویی رست (پیدا) دید، در حالی که بهشت و کوه را جستجو می‌کرد."],[903,"کوه و کنعان را فرو برد آن زمان","نیم موجی تا به قعر امتهان","در آن زمان، کوه و سرزمین کنعان توسط امواج شدید آب فرو رفتند و به عمق امتحان و آزمایش رسیدند."],[903,"مه فشاند نور و سگ وع‌وع کند","سگ ز نور ماه کی مرتع کند‌؟","وقتی که ماه نورش را می‌تاباند، سگ فقط زوزه می‌کشد و نمی‌تواند از این نور بهره ببرد و چرا از نور ماه بهره‌مند شود؟"],[903,"شب‌روان و همرهان مه به تگ","ترک رفتن کی کنند از بانگ سگ","کسانی که در شب و در کنار ماه در حرکتند و با هم سفر می‌کنند، چرا باید به صدای سگی که پارس می‌کند توجه کنند؟ آنها در دل شب و در میان روشنایی ماه، به این‌گونه صداها بی‌اعتنا هستند."],[903,"جزو سوی کل دوان مانند تیر","کی کند وقف از پی هر گنده‌پیر","جزو، مانند تیر به سمت کل (خدا) در حال دویدن است و هیچ‌گاه نمی‌تواند از پی هر شخص سال‌خورده (نابخرد) توقف کند."],[903,"جان شرع و جان تقوی عارف است","معرفت محصول زهد سالف است","جان دین و روح تقوی، عارف است و معرفت، حاصل زهد گذشتگان است."],[903,"زهد اندر کاشتن کوشیدن است","معرفت آن کشت را روییدن است","زهد، به معنای خودداری و پرهیز از دنیا، در واقع به معنای تلاش در کاشتن و ایجاد است، و معرفت همانند روییدن محصولی است که از آن کشت به دست می‌آید."],[903,"پس چو تن باشد جهاد و اعتقاد","جان این کشتن نبات است و حصاد","چنانچه جسم انسان نمایانگر جهاد و ایمان او باشد، آنگاه کشتن (یا نابود کردن) این جسم همچون درو کردن محصول (محصولی که از ایمان به دست آمده) تلقی می‌شود."],[903,"امر معروف او و هم معروف اوست","کاشف اسرار و هم مکشوف اوست","نیکی و کارهای خوب او خود اوست و او کسی است که رازها را فاش می‌کند و در عین حال خود نیز رازهاست."],[903,"شاه امروزینه و فردای ماست","پوست بنده مغز نغزش دایم است","شاه امروز و فردای ما (یعنی خداوند) همچون مغزی در پوست بنده قرار دارد و وجود ما به او وابسته است، زیرا حقیقت درونی ما همواره در حال نغز و تغییر است."],[903,"چون انا الحق گفت شیخ و پیش برد","پس گلوی جمله کوران را فشرد","وقتی که شیخ (حلاج) گفت «من حق هستم» و این باور را پیش برد، در واقع همه افرادی که به او ناآگاه بودند و دیدی کور داشتند را تحت فشار گذاشت و سخنانش را ناامیدکننده دانست."],[903,"چون انای بنده لا شد از وجود","پس چه ماند تو بیندیش ای جحود","زمانی که خود من، یعنی بنده، از وجود خودم به «نیستم» تبدیل شوم، پس دیگر چه چیزی باقی می‌ماند؟ بنابراین تو هم در این زمینه تفکر کن، ای کسی که انکار می‌کنی."],[903,"گر ترا چشمی‌ست بگشا در نگر","بعد لا آخر چه می‌ماند دگر","اگر چشمی داری، آن را باز کن و به خوبی بنگر که پس از \"نه\"، چه چیزی باقی می‌ماند."],[903,"ای بریده آن لب و حلق و دهان","که کند تف سوی مه یا آسمان","ای کسی که لب و گلویت را بریده‌ای، چه چیزی می‌تواند تو را به سمت ماه یا آسمان پرتاب کند؟"],[903,"تف به رویش باز گردد بی‌شکی","تف سوی گردون نیابد مسلکی","دفعه‌ای که او دروغی بر زبان آورد، حتما همین دروغ به خودش برمی‌گردد و به او صدمه می‌زند. او هرگز نمی‌تواند از این دروغ خود به جایگاهی بالا یا اعتباری دست یابد."],[903,"تا قیامت تف برو بارد ز رب","هم‌چو تبت بر روان بولهب","از خداوند تا قیامت، لعنت و نفرین بر روح او (ابولهب) باران خواهد شد، همان‌طور که بر او (ابولهب) در آیه‌ای از قرآن لعنت شده است."],[903,"طبل و رایت هست ملک شهریار","سگ کسی که خواند او را طبل‌خوار","حکومت و نشانه‌های قدرت و سلطنت مربوط به شهریار (پادشاه) مانند طبل و پرچم وجود دارد، و او کسی است که به هر کس که خود را طبل‌خوار (سگ‌وار) بنامد، اجازه می‌دهد که در این دنیا تحت فرمانش باشد."],[903,"آسمان‌ها بنده ماه وی‌اند","شرق و مغرب جمله نان‌خواه وی‌اند","آسمان‌ها به نوعی تحت فرمان و تسلط او (ماه) هستند و همه نقاط زمین (شرق و مغرب) نیز به دنبال تأمین نیازهای او هستند."],[903,"زانک لولاک است بر توقیع او","جمله در انعام و در توزیع او","زیرا همه چیز به خاطر وجود تو است که در تقدیر خدا نوشته شده و در بخشش و تقسیم نعمت‌ها به سراغ تو می‌آیند."],[903,"گر نبودی او نیابیدی فلک","گردش و نور و مکانی ملک","اگر او (خدا) نبود، نه به دوری آسمان و چراغی (نور) و نه به جایی (مکان) که سلطنت و قدرت باشد، دسترسی پیدا می‌کردی."],[903,"گر نبودی او نیابیدی بحار","هیبت و ماهی و در شاهوار","اگر او (منظور خداوند است) وجود نمی‌داشت، نه می‌توانستی به عظمت دریاها و ماهی‌ها و اللؤلؤهای گرانبها دسترسی پیدا کنی."],[903,"گر نبودی او نیابیدی زمین","در درونه گنج و بیرون یاسمین","اگر آن وجود شریف (خدا یا حقیقتی که شاعر به آن اشاره دارد) نبود، هرگز نمی‌توانستی گنجینه‌های درونی زمین و باغ‌های یاسمن را در بیرون را مشاهده کنی."],[903,"رزقها هم رزق‌خواران وی‌اند","میوه‌ها لب‌خشک باران وی‌اند","رزق‌ها برای کسانی است که آنها را دریافت می‌کنند، و میوه‌ها نیز ثمرات بارانی هستند که از آن خداوند می‌بارد."],[903,"هین که معکوس است در امر این گره","صدقه‌بخش خویش را صدقه بده","ای فقر و نیازمندی که در این مسأله معکوس هستی، تو باید به کسانی که صدقه می‌دهند و خیرات می‌کنند، خود نیز صدقه بدهی و کمک کنی."],[903,"از فقیرستت همه زر و حریر","هین غنی را ده زکاتی ای فقیر","ای فقیر، تمام ثروت و لباس‌های گرانبای تو از فقر و نیاز تو ناشی است. بنابراین به غنی (خدای توانمند) زکات بده، زیرا این کار ارزشمندتر است."],[903,"چون تو ننگی جفت آن مقبول‌روح","چون عیال کافر اندر عقد نوح","چون تو ننگ و عیب هستی مانند روح مقبول (خدا) و همسر کافر در زمان نوح، به همین دلیل در مقامی نیستی که شایسته‌ی توجه و قبول باشی."],[903,"گر نبودی نسبت تو زین سرا","پاره‌پاره کردمی این دم ترا","اگر نسبت تو به این منزلت نبود، همین حالا تو را پاره‌پاره می‌کردم."],[903,"دادمی آن نوح را از تو خلاص","تا مشرف گشتمی من در قصاص","من به نوح، پیامبر خدا، کمک می‌کردم تا از تو رهایی یابد، و وقتی که در این حال در مقابل قصاص قرار گرفتم، به بالای مقام و عذاب تو نگاه کردم."],[903,"لیک با خانه شهنشاه زمن","این چنین گستاخیی ناید ز من","من به خانه پادشاه (شهنشاه) چنین گستاخی نخواهم کرد، به این دلیل که من از مقام و منزلت او آگاه هستم و نمی‌توانم به خود اجازه‌ی این بی‌احترامی را بدهم."],[903,"رو دعا کن که سگ این موطنی","ورنه اکنون کردمی من کردنی","اینجا از فردی خواسته می‌شود که دعا کند تا او مانند سگی وفادار به این کشور (معنی \"موطن\") بماند و از افکار و کارهای نابجا دوری کند، در غیر این صورت ممکن بود کارهای نامناسبی انجام دهد."],[904,"بعد از آن پرسان شد او از هر کسی","شیخ را می‌جست از هر سو بسی","بعد از اینکه این فرد فهمید شیخ کجاست، از هر کسی سؤال کرد و به‌دنبال او بود و از هر طرف جستجو می‌کرد."],[904,"پس کسی گفتش که آن قطب دیار","رفت تا هیزم کشد از کوهسار","کسی به مرید گفت که آن قطب (شیخ) به دشت رفته است تا هیزم بیاورد از کوه."],[904,"آن مرید ذوالفقاراندیش تفت","در هوای شیخ سوی بیشه رفت","مریدی به نام ذوالفقاراندیش، تحت تأثیر عشق و علاقه به شیخ، به سمت بیشه‌ای که شیخ به آنجا رفته، می‌رود."],[904,"دیو می‌آورد پیش هوش مرد","وسوسه تا خفیه گردد مه ز گرد","دیو (نماد وسوسه و شیاطین) برای فردی که آگاه است، ترفندها و وسوسه‌هایی را به وجود می‌آورد تا او را به بی‌خبری وادارد و در نتیجه، نور و آگاهی او تحت تاثیر قرار گیرد."],[904,"کین چنین زن را چرا این شیخ دین","دارد اندر خانه یار و همنشین","چرا این زن را که به این شیوه رفتار می‌کند، این شیخ دین در خانه خود و در کنار خود نگه داشته است؟"],[904,"ضد را با ضد ایناس از کجا","با امام‌الناس نسناس از کجا","ضد را با ضد (فرقی که بین دو چیز متضاد هست) چگونه می‌توان شناخت، در حالی که برای شناختن امام‌الناس (شخص برجسته و عالم)، نشانه‌ای از کجا باید پیدا کرد؟"],[904,"باز او لاحول می‌کرد آتشین","که اعتراض من برو کفرست و کین","او بار دیگر با ناتوانی و بی‌پناهی، به شیوه‌ای تند و آتشین اظهارنظر می‌کرد که اعتراضی از من نشانه کفر و کینه است."],[904,"من کی باشم با تصرفهای حق","که بر آرد نفس من اشکال و دق","نمی‌توانم بگویم که من کی هستم که حق با قدرت و تصرفات خود اعمال می‌کند و باعث می‌شود که نفس من مشکلات و اعتراضات ایجاد کند."],[904,"باز نفسش حمله می‌آورد زود","زین تعرف در دلش چون کاه دود","نفس انسان به سرعت دوباره به او حمله می‌کند و از این آگاهی که به دست آورده، همچون دودی که کاه را می‌سوزاند، در دلش تأثیر می‌گذارد."],[904,"که چه نسبت دیو را با جبرئیل","که بود با او به صحبت هم مقیل","در این بیت از مولانا، پرسشی مطرح می‌شود درباره ارتباط دیو (نماد شیاطین و نیروهای منفی) با جبرئیل (فرشته‌ای که پیام‌های الهی را می‌آورد). شاعر در اینجا می‌گوید که دیو چگونه می‌تواند در یک گفت‌وگو یا ارتباط با جبرئیل قرار بگیرد، و این کنایه‌ای به تضاد میان نیات عالی و شیاطین است."],[904,"چون تواند ساخت با آزر خلیل","چون تواند ساخت با ره‌زن دلیل","چگونه می‌توان با کسی که مانند آزر (پدر ابراهیم) است، ارتباط برقرار کرد و او را به راه راست هدایت کرد؟ یا چگونه می‌توان با کسی که در مسیر نادرست حرکت می‌کند، دلیلی قانع‌کننده برای تغییر جهتش ارائه داد؟"],[905,"اندرین بود او که شیخ نامدار","زود پیش افتاد بر شیری سوار","در اینجا اشاره شده که شیخ نامدار به سرعت پیش رفت و بر روی یک شیر سوار شد. این تصویر نشان‌دهنده فخر و قدرت اوست که در یک موقعیت خطرناک، بر موجودی قدرتمند و ترسناک مانند شیر سوار شده است."],[905,"شیر غران هیزمش را می‌کشید","بر سر هیزم نشسته آن سعید","سعید که درختان هیزم را می‌برد، شیر خشمگین و شجاعی هیزم‌های او را به سمت خود می‌کشید."],[905,"تازیانه‌ش مار نر بود از شرف","مار را بگرفته چون خرزن به کف","تازیانه‌ای که در دست دارد، مانند مار نر است و به اعتبار والایی که دارد، مار را به مانند خرزنی در دست گرفته است."],[905,"تو یقین می‌دان که هر شیخی که هست","هم سواری می‌کند بر شیر مست","هر شیخی که وجود دارد، هم‌چنان که سوارکار بر شیر مست سوار می‌شود، نشان‌دهنده توانایی و قدرت اوست که با اعتماد به نفس بر موقعیت‌های سخت غلبه می‌کند."],[905,"گرچه آن محسوس و این محسوس نیست","لیک آن بر چشم جان ملبوس نیست","هرچند که آنچه قابل لمس است (شیر مست و هیزم‌کشان) و آنچه غیرقابل لمس است (چیزهایی که در عالم غیب هستند) با هم متفاوتند، اما این‌جا آنچه از چشم جان دیده می‌شود، ملبوس یا پوشیده نیست و آشکار است."],[905,"صد هزاران شیر زیر رانشان","پیش دیده غیب‌دان هیزم‌کشان","در نظر خدا، که از باطن امور آگاه است، حتی بسیاری از شیرها (حیوانات وحشی و نیرومند) زیر پای هیزم‌شکنان قرار دارند و این نشان‌دهنده ضعف موقعیت آنها در دیدگاه الهی است."],[905,"لیک یک یک را خدا محسوس کرد","تا که بیند نیز او که نیست مرد","اما خدا هر یک از آن شیرها را محسوس و قابل درک ساخت تا اینکه ببیند آیا آن کس که وجود ندارد، نیز مردی چون آن‌ها است."],[905,"دیدش از دور و بخندید آن خدیو","گفت آن را مشنو ای مفتون دیو","خدای بزرگ از دور او را دید و به او خندید، سپس به او گفت: به این حرف‌ها توجه نکن و فریب دیو را مخر."],[905,"از ضمیر او بدانست آن جلیل","هم ز نور دل بلی نعم الدلیل","از دلتنگی‌های او و حالش پی برد که آن انسان بزرگ (جلیل) دارای نور قلب است و این نور دلیلی خوب و شایسته برای اوست."],[905,"خواند بر وی یک به یک آن ذوفنون","آنچ در ره رفت بر وی تا کنون","مولانا به توصیف شخصی می‌پردازد که در حضور کسی که در مقام شیخ است، تمامی دانش‌ها و فنون را به تدریج و یکی یکی بر او بیان می‌کند و به تبیین راه‌های سختی که در طی مسیر خود پیموده است، می‌پردازد."],[905,"بعد از آن در مشکل انکار زن","بر گشاد آن خوش‌سراینده دهن","سپس در موقعی که زن به سختی از انکار و منکر سخن می‌گوید، بر روی سخن گفتن و بیان کردن (مثبت) لبخند می‌زند."],[905,"کان تحمل از هوای نفس نیست","آن خیال نفس تست آنجا مایست","اینکه انسان نمی‌تواند تحمل کند، به خاطر خواسته‌های نفس اینطور نیست و این فقط خیال نفس اوست که او را در آن حالت نگه داشته است."],[905,"گرنه صبرم می‌کشیدی بار زن","کی کشیدی شیر نر بیگار من","اگر این صبر و شکیبایی من نبود، بار سنگین و دشوار را نمی‌توانستم تحمل کنم. توی همزاد و مانند خود شیر نر هستی که به من زحمت و سختی می‌دهد."],[905,"اشتران بختییم اندر سبق","مست و بی‌خود زیر محملهای حق","ما مانند شترانی هستیم که خوش‌شانسی ما را در مسابقه (سبقت) می‌برد و در حال مستی و بی‌خبری زیر بارهای حق حرکت می‌کنیم."],[905,"من نیم در امر و فرمان نیم‌خام","تا بیندیشم من از تشنیع عام","من در امر و فرمان، هنوز پخته و کامل نیستم و هنوز باید تفکر کنم تا از سرزنش و نکوهش عموم مردم آگاه شوم و خود را بهبود دهم."],[905,"عام ما و خاص ما فرمان اوست","جان ما بر رو دوان جویان اوست","عموم مردم و خاصان (افرادی که در مرتبه‌ای بالاتر قرار دارند) به فرمان او (خدا) هستند و روح ما مانند آبی روان، به دنبال اوست."],[905,"فردی ما جفتی ما نز هواست","جان ما چون مهره در دست خداست","ما کسی را داریم که جفت و هم‌نفس ماست و این ارتباط ما ناشی از خواسته‌های نفسانی نیست. جان ما مانند مهره‌ای است که در دست خداوند قرار دارد و تحت اراده اوست."],[905,"ناز آن ابله کشیم و صد چو او","نه ز عشق رنگ و نه سودای بو","حرکت و ناز آن آدم نادان را تحمل می‌کنیم، در حالی که صد نفر مثل او هم هیچ‌یک از عشق واقعی و حال خوش زن و مرد خبر ندارند."],[905,"این قدر خود درس شاگردان ماست","کر و فر ملحمه ما تا کجاست","این اندازه، دینی که به شاگردان ما داریم، به قدری مهم است که صدای این درگیری و جدال ما به کجا می‌رسد و چه تاثیری دارد."],[905,"تا کجا آنجا که جا را راه نیست","جز سنابرق مه الله نیست","تا جایی که در آنجا هیچ راهی برای ورود وجود ندارد و جز نور الهی (که به نور سنابرق اشاره دارد) چیزی نیست."],[905,"از همه اوهام و تصویرات دور","نور نور نور نور نور نور","مولانا در این بیت به دوری از خیال‌ها و تصورات زاید اشاره می‌کند و بر ضرورت توجه به نور و حقیقت الهی تأکید می‌کند. او به طور مکرر از \"نور\" سخن می‌گوید تا نشان دهد که این نور، حقیقتی خالص و فراتر از اوهام و تصورات است."],[905,"بهر تو ار پست کردم گفت و گو","تا بسازی با رفیق زشت‌خو","اگر من صحبت‌هایم را برای تو پست و بی‌ارزش قرار دهم، این کار را می‌کنم تا تو بتوانی با هم‌نشین بدخلق و زشت‌خو به خوبی کنار بیایی و رابطه‌ات را با او بهبود ببخشی."],[905,"تا کشی خندان و خوش بار حرج","از پی الصبر مفتاح الفرج","تا زمانی که با خوشحالی و خنده از سختی‌ها عبور کنی، به کمک صبر، کلید گشایش مشکلات را خواهی یافت."],[905,"چون بسازی با خسی این خسان","گردی اندر نور سنتها رسان","اگر با انسان‌های پست و بی‌ارزش (خسی) کنار بیایی و سازگاری کنی، به نور و روشنایی سنت‌ها (اصول و ارزش‌های دینی) دست خواهی یافت."],[905,"که انبیا رنج خسان بس دیده‌اند","از چنین ماران بسی پیچیده‌اند","انبیا درد و زحمات زیادی را از انسان‌های پست و حقیر متحمل شده‌اند و به همین دلیل، از افراد فریبکار و مکار دوری کرده‌اند."],[905,"چون مراد و حکم یزدان غفور","بود در قدمت تجلی و ظهور","چون خواسته و اراده خداوند بخشنده و مهربان بر آن بود که به کمال و ظهور برسد، بنابراین در قدم او تجلی و روشنایی حاصل شد."],[905,"بی ز ضدی ضد را نتوان نمود","وان شه بی‌مثل را ضدی نبود","بدون وجود چیزی متضاد، نمی‌توان از تضاد سخن گفت و آن پادشاه بی‌نظیر هیچ چیز متضادی ندارد."],[906,"پس خلیفه ساخت صاحب‌سینه‌ای","تا بود شاهیش را آیینه‌ای","پس خداوند، انسانی را که دارای دل و فطرت شایسته‌ای است، به عنوان جانشین خود برگزید، تا او نمایانگر و آینه‌ای از عظمت و سلطنت الهی باشد."],[906,"بس صفای بی‌حدودش داد او","وانگه از ظلمت ضدش بنهاد او","خداوند به آدم آنقدر از نور و صفا بخشید که غیرقابل تصور است، و سپس به خاطر تاریکی و ظلمت ابلیس، او را در مقابل آدم قرار داد."],[906,"دو علم بر ساخت اسپید و سیاه","آن یکی آدم دگر ابلیس راه","در این بیت، مولانا به دو موجود اشاره دارد: یکی آدم که مظهر نور و پاکی است و دیگری ابلیس که نماد تاریکی و شر است. این دو علم، به معنای آگاهی و شناخت هستند که یکی به سمت خوبی و دیگری به سمت بدی سوق می‌دهد."],[906,"در میان آن دو لشکرگاه زفت","چالش و پیکار آنچ رفت رفت","در میان دو گروه، که یکی ستمگر و دیگری نیکوکار است، نبرد و درگیری دائم در حال وقوع است."],[906,"هم‌چنان دور دوم هابیل شد","ضد نور پاک او قابیل شد","در ادامه‌ی پیکار و چالش‌های میان حق و باطل، هابیل به نماد نیکی و نور تبدیل شد، در حالی که قابیل به نماد ظلم و تاریکی بدل گردید."],[906,"هم‌چنان این دو علم از عدل و جور","تا به نمرود آمد اندر دور دور","این دو علم، یعنی علم عدل و علم جور، همچنان ادامه پیدا کرد تا به زمان نمرود، شاه ظالم و ستمگر، رسید."],[906,"ضد ابراهیم گشت و خصم او","وآن دو لشکر کین‌گزار و جنگ‌جو","نمرود که مخالف ابراهیم (پیامبر) بود، تبدیل به دشمن او شد و دو گروه که به دنبال انتقام و جنگ بودند، برای مبارزه آماده شدند."],[906,"چون درازی جنگ آمد ناخوشش","فیصل آن هر دو آمد آتشش","وقتی جنگ طولانی و ناخوشایندی پیش آمد، در آن زمان حکمی صادر شد و هر دو طرف به آتش کشیده شدند."],[906,"پس حکم کرد آتشی را و نکر","تا شود حل مشکل آن دو نفر","پس دستور داد که آتش را مهار کنند تا مشکل آن دو نفر حل شود."],[906,"دور دور و قرن قرن این دو فریق","تا به فرعون و به موسی شفیق","این دو گروه (دو فریق) از دیرباز و برای مدت‌های طولانی، از یکدیگر فاصله داشته‌اند و درگیری آنها همچنان ادامه دارد، تا جایی که به زمان فرعون و موسی نیز می‌رسد."],[906,"سالها اندر میانشان حرب بود","چون ز حد رفت و ملولی می‌فزود","سال‌ها میان آن دو گروه جنگ و نبرد بود و چون جنگ به حدی رسید که خستگی و ملول شدن افزایش یافت."],[906,"آب دریا را حکم سازید حق","تا که ماند کی برد زین دو سبق","حق، یعنی خدا، به شما دستور داده که آب دریا را میزان و قاضی قرار دهید تا مشخص شود چه کسی از دو طرف در این نزاع برتر است و پیروز می‌شود."],[906,"هم‌چنان تا دور و طور مصطفی","با ابوجهل آن سپهدار جفا","این بیت به ماجرای جنگ و دشمنی میان پیامبر اسلام، مصطفی، و ابوجهل، یکی از دشمنان سرسخت او در مکه اشاره دارد. مولانا به عنوان اشاره‌ای به دوری و جدایی این دو شخصیت در میراث تاریخی، تضاد میان نیکی و بدی را مطرح می‌کند."],[906,"هم نکر سازید از بهر ثمود","صیحه‌ای که جانشان را در ربود","خداوند برای قوم ثمود نیز صیحه‌ای فرستاد که جان آنها را گرفت و نابود کرد."],[906,"هم نکر سازید بهر قوم عاد","زود خیزی تیزرو یعنی که باد","خداوند برای قوم عاد، باد تند و تیزی را به‌عنوان عذاب فرستاد که به سرعت آنها را تهدید کند."],[906,"هم نکر سازید بر قارون ز کین","در حلیمی این زمین پوشید کین","زمین به خاطر کینه‌جویی و دشمنی خود، برای قارون آرامش و حیاط را از بین برد و او را به خشم خود گرفت."],[906,"تا حلیمی زمین شد جمله قهر","برد قارون را و گنجش را به قعر","زمین به سبب نرمش و مهربانی‌اش، همه قهر و غضب را از خود دور کرد و قارون و گنج‌هایش را به عمق خود فرستاد."],[906,"لقمه‌ای را که ستون این تنست","دفع تیغ جوع نان چون جوشنست","لقمه‌ای که باعث قوت و استحکام این بدن است، می‌تواند مانند زره‌ای باشد که انسان را از تیزی گرسنگی محافظت می‌کند."],[906,"چونک حق قهری نهد در نان تو","چون خناق آن نان بگیرد در گلو","زمانی که خداوند خشمگین شود و بر نان تو تأثیر بگذارد، مانند بیماری خناق (گلو درد)، آن نان در گلویت گیر خواهد کرد."],[906,"این لباسی که ز سرما شد مجیر","حق دهد او را مزاج زمهریر","این لباسی که به خاطر سرما گشادی و راحتی پیدا کرده، به برکت حق، خاصیت سردی و یخبندان را به او می‌دهد."],[906,"تا شود بر تنت این جبه شگرف","سرد هم‌چون یخ گزنده هم‌چو برف","این لباس شگرف و سرد، بر تن تو قرار می‌گیرد و حس سردی مشابه یخ و برف را منتقل می‌کند."],[906,"تا گریزی از وشق هم از حریر","زو پناه آری به سوی زمهریر","تا زمانی که از سختی‌ها و مشکلات (وشق) فرار کنی، نیز باید به آرامش و آسایش (حریر) روی بیاوری و از آن به سوی سرمای دلپذیر (زمهریر) پناه ببری."],[906,"تو دو قله نیستی یک قله‌ای","غافل از قصه عذاب ظله‌ای","تو تنها یک قله هستی و نه دو قله، اما از داستان عذاب سایه غافلی."],[906,"امر حق آمد به شهرستان و ده","خانه و دیوار را سایه مده","فرمان خداوند به تو آمده است که در شهرها و روستاها، مانع از بهرمندی مردم از سایه دیوارها و خانه‌ها نشوی."],[906,"مانع باران مباش و آفتاب","تا بدان مرسل شدند امت شتاب","مبادا مانع باران و آفتاب باشی، زیرا این نعمت‌ها برای مردم فرستاده شده‌اند و باید به سرعت به آن‌ها برسند."],[906,"که بمردیم اغلب ای مهتر امان","باقیش از دفتر تفسیر خوان","بهتر است که غالبا از دنیا بگذریم و فقط باقی‌مانده اش را از تفسیر الفاظ و معانی به یاد داشته باشیم."],[906,"چون عصا را مار کرد آن چست‌دست","گر ترا عقلیست آن نکته بس است","وقتی کسی که دستش چابک و تیز است، عصا را به شکل مار درآورد، اگر تو عقل داری، همین نکته برای تو کافی است."],[906,"تو نظر داری ولیک امعانش نیست","چشمه افسرده است و کرده ایست","تو در نظر و فکر هستی، اما عمق و دقت آن را ندارید. این مانند چشمه‌ای است که آبش خشک شده و از کار افتاده است."],[906,"زین همی گوید نگارنده فکر","که بکن ای بنده امعان نظر","نگارنده فکر یعنی ذهن یا عقل، به بندۀ خود می‌گوید که باید با دقت و توجه بیشتری بنگرد و تأمل کند."],[906,"آن نمی‌خواهد که آهن کوب سرد","لیک ای پولاد بر داود گرد","سرد کوبیدن آهن به معنای کار کردن بی‌احساس و بی‌روح است، اما خداوند نمی‌خواهد که تنها به این صورت زندگی کنیم. در عوض، او می‌خواهد که مانند پولاد باشیم که با قدرت و استقامت بر داود (پیامبر و پادشاه) گرد آید و از او الهام بگیرد."],[906,"تن بمردت سوی اسرافیل ران","دل فسردت رو به خورشید روان","بدن تو به سمت اسرافیل، فرشته‌ای که در قیامت ندا می‌دهد، می‌رود و قلبت که افسرده شده است، باید به سوی خورشید، نماد روشنایی و زندگی، حرکت کند."],[906,"در خیال از بس که گشتی مکتسی","نک بسوفسطایی بدظن رسی","در خیال خود آن‌قدر درگیر و مشغول شده‌ای که دیگر به حقیقت نرسیده‌ای و به آدم‌های منفی‌اندیش و بدگمان نزدیک شده‌ای."],[906,"او خود از لب خرد معزول بود","شد ز حس محروم و معزول از وجود","شخص مورد اشاره، به دلیل عدم استفاده از عقل و خرد خود، از آگاهی و حس‌های معنوی محروم شده و از حقیقت وجود خود دور افتاده است."],[906,"هین سخن‌خا نوبت لب‌خایی است","گر بگویی خلق را رسوایی است","این بیت به این معناست که اکنون زمان گفتن سخن است و اگر کسی در این باره چیزی بگوید، باعث رسوایی مردم خواهد شد. به عبارتی، لازم است تا از درد و رنجی که در دل دارند، سخن بگویند، و در غیر این صورت عواقب بدی برای جامعه خواهد داشت."],[906,"چیست امعان چشمه را کردن روان","چون ز تن جان رست گویندش روان","چرا چشمه را به جریان انداختن، هنگامی که جان از بدن رها می‌شود، روان نامیده می‌شود؟"],[906,"آن حکیمی را که جان از بند تن","باز رست و شد روان اندر چمن","حکیم کسی است که جانش از قید و بند جسم رها شده و مانند نغمه‌ای آزاد در میان باغ زندگی می‌رقصد و حرکت می‌کند."],[906,"دو لقب را او برین هر دو نهاد","بهر فرق ای آفرین بر جانش باد","مولانا به دو لقب یا نامی اشاره می‌کند که حکیم به خود می‌دهد و این القاب را به خاطر تفاوت‌ها و ویژگی‌های خاصش بر خود می‌نهد. او برای این حکمت و رویکرد خود، درود و تحسین می‌فرستد."],[906,"در بیان آنک بر فرمان رود","گر گلی را خار خواهد آن شود","هرگاه دستوری از سوی خداوند صادر شود، حتی اگر گل باشد، ممکن است خار شود؛ یعنی ممکن است چیز مطلوب و زیبا به حالت ناپسند و زشت تبدیل گردد."],[907,"مؤمنان از دست باد ضایره","جمله بنشستند اندر دایره","مؤمنان به خاطر وزش باد شدید و طوفانی که در حال وقوع بود، در دایره‌ای جمع شدند و از خطر نجات یافتند."],[907,"باد طوفان بود و کشتی لطف هو","بس چنین کشتی و طوفان دارد او","طوفان و باد قهرآمیز هستند، اما کشتی نجاتی که تحت لطف خداوند قرار دارد، این خطرات را تحمل می‌کند. چنین کشتی‌ای در برابر طوفان‌ها ایمنی دارد."],[907,"پادشاهی را خدا کشتی کند","تا به حرص خویش بر صفها زند","خداوند به پادشاهی کمک می‌کند تا به خواسته‌های طمعکارانه‌اش برسد و بر صف‌های مردم تسلط یابد."],[907,"قصد شه آن نه که خلق آمن شوند","قصدش آنک ملک گردد پای‌بند","هدف پادشاه این نیست که مردم از ترس به ایمان بیایند، بلکه او می‌خواهد سلطنتش پایدار و محکم بماند."],[907,"آن خراسی می‌دود قصدش خلاص","تا بیابد او ز زخم آن دم مناص","خراسانی در حال دویدن است تا خود را از زخم‌های ناشی از دم هود آزاد کند و رها شود. در واقع، او به دنبال نجات و آرامش است."],[907,"قصد او آن نه که آبی بر کشد","یاکه کنجد را بدان روغن کند","هدف او (خراسی) این نیست که آب بیاورد یا کنجد را روغن کند، بلکه او در تلاش است تا به یک هدف بزرگتری برسد."],[907,"گاو بشتابد ز بیم زخم سخت","نه برای بردن گردون و رخت","گاو با ترس از درد شدید سرعت می‌گیرد، نه برای اینکه چیزی را ببرد یا به سمت عرش برود."],[907,"لیک دادش حق چنین خوف وجع","تا مصالح حاصل آید در تبع","ولی خداوند به او (هود علیه‌السلام) چنین ترسی و درد جسمی عطا کرد تا مصالح و منافع مهمی در پی آن به دست آید."],[907,"هم‌چنان هر کاسبی اندر دکان","بهر خود کوشد نه اصلاح جهان","هر کسی در کار و فعالیت خود به دنبال منافع و سود شخصی‌اش است و توجهی به بهبود وضعیت کلی جامعه ندارد."],[907,"هر یکی بر درد جوید مرهمی","در تبع قایم شده زین عالمی","هر کس به دنبال درمانی برای دردش می‌گردد، همچنان‌که در این جهان دنیوی، گرفتار مشکلات و رنج‌های خود شده است."],[907,"حق ستون این جهان از ترس ساخت","هر یکی از ترس جان در کار باخت","خداوند اساس و پایه این جهان را بر ترس قرار داده است، زیرا هر فرد به خاطر ترس از جان خود، در کار و تلاش گام برمی‌دارد."],[907,"حمد ایزد را که ترسی را چنین","کرد او معمار و اصلاح زمین","از خداوند شکرگزاری می‌کنم که این‌گونه ترس را قرار داده است، او همان کسی است که زمین را می‌سازد و اصلاح می‌کند."],[907,"این همه ترسنده‌اند از نیک و بد","هیچ ترسنده نترسد خود ز خود","بسیاری از مردم از نیکی و بدی می‌ترسند، اما هیچ‌یک از آن‌ها از خودشان نمی‌ترسند."],[907,"پس حقیقت بر همه حاکم کسیست","که قریبست او اگر محسوس نیست","حقیقتی بر همه چیز تسلط دارد که نزدیک است، هرچند ممکن است قابل احساس نباشد."],[907,"هست او محسوس اندر مکمنی","لیک محسوس حس این خانه نی","حقیقت الهی در جایی وجود دارد که قابل درک است، اما آنچه از حس در این دنیا تجربه می‌شود، نمی‌تواند نمایانگر حقیقت او باشد."],[907,"آن حسی که حق بر آن حس مظهرست","نیست حس این جهان آن دیگرست","آن حسی که خداوند بر اساس آن خود را به ظهور می‌رساند، حس این دنیایی نیست و دنیای حسّی چیز دیگری است."],[907,"حس حیوان گر بدیدی آن صور","بایزید وقت بودی گاو و خر","اگر حواس حیوانی را می‌دیدی، در آن صورت بایزید بایزید نمانده و مانند گاو و خر می‌شدی."],[907,"آنک تن را مظهر هر روح کرد","وآنک کشتی را براق نوح کرد","شخصی که بدن را نماینده‌ی هر روح قرار داده، همچنین کشتی نوح را همچون یک وسیله‌ی سریع و رمزآلود (براق) ساخته است."],[907,"گر بخواهد عین کشتی را به خو","او کند طوفان تو ای نورجو","اگر بخواهد، نفس کشتی (نوح) را به خود می‌گیرد و طوفان تو را، ای نورجو، تحت تأثیر قرار می‌دهد."],[907,"هر دمت طوفان و کشتی ای مقل","با غم و شادیت کرد او متصل","هر بار که نفس می‌کشی، مانند طوفانی و کشتی هستی، و همواره در حال تغییر بین غم و شادی هستی که او (خدا یا نیروی الهی) تو را به این حال درمی‌آورد و به هم متصل می‌کند."],[907,"گر نبینی کشتی و دریا به پیش","لرزها بین در همه اجزای خویش","اگر کشتی و دریا را نبینی، در این حال لرزش‌ها و نگرانی‌ها را در تمامی وجود خود احساس کن."],[907,"چون نبیند اصل ترسش را عیون","ترس دارد از خیال گونه‌گون","هرگاه کسی نتواند منبع واقعی ترس خود را ببیند، تنها از خیال‌های مختلف و تصورات نگران‌کننده می‌ترسد."],[907,"مشت بر اعمی زند یک جلف مست","کور پندارد لگدزن اشترست","مست‌نوشی که حالش خوب نیست، به فردی که بینا نیست، مشت می‌زند و او فکر می‌کند که در حال لگد زدن به الاغی است."],[907,"زانک آن دم بانگ اشتر می‌شنید","کور را گوشست آیینه نه دید","چون آن کور فقط صدای شتر را می‌شنید، هیچ نشانه‌ای از واقعیت نداشت و نمی‌توانست ببیند که این صدا به کجا تعلق دارد."],[907,"باز گوید کور نه این سنگ بود","یا مگر از قبه پر طنگ بود","کور به سنگی که شنیده، می‌گوید این سنگ نیست، بلکه شاید از قبه (سقف)‌ای که سرشار از آب است، برآمده."],[907,"این نبود و او نبود و آن نبود","آنک او ترس آفرید اینها نمود","اینکه چیزی وجود ندارد و آنکه موجود است نیز وجود ندارد، یعنی آنچه می‌بینیم و حس می‌کنیم، واقعی نیست و این ترس از درون انسان به وجود می‌آید."],[907,"ترس و لرزه باشد از غیری یقین","هیچ کس از خود نترسد ای حزین","هیچ‌کس از خود نمی‌ترسد، بلکه ترس و لرزه از سایر موجودات و چیزهای غیر از خود انسان به وجود می‌آید. ای دل‌شکسته، این را بدان که تنها باید یقین را درونی کرد و از مبدأ خود ترسی نداشت."],[907,"آن حکیمک وهم خواند ترس را","فهم کژ کردست او این درس را","این حکیم (به معنای فردی صاحب عقل و دانش) ترس را وهم (خیال و تصوری نادرست) می‌داند و می‌گوید که او این درس را به اشتباه فهمیده است."],[907,"هیچ وهمی بی‌حقیقت کی بود","هیچ قلبی بی‌صحیحی کی رود","هیچ خیال و تصوری نمی‌تواند بدون حقیقت وجود داشته باشد و هیچ قلب و دل هیچ‌گاه نمی‌تواند بدون صحت و درستی راه پیدا کند."],[907,"کی دروغی قیمت آرد بی ز راست","در دو عالم هر دروغ از راست خاست","هیچ دروغی در این دنیا ارزش و بهایی ندارد، زیرا در هر دو جهان، هر دروغی از راست و حقیقت سرچشمه می‌گیرد."],[907,"راست را دید او رواجی و فروغ","بر امید آن روان کرد او دروغ","دروغ در انتظار او بود که بتواند از راست استفاده کند و نور راست را به خود جذب کند. او راست را به صورت روشن و رواج‌دهنده می‌بیند و در نتیجه به امید آن، دروغ را به سمت خود می‌کشاند."],[907,"ای دروغی که ز صدقت این نواست","شکر نعمت گو مکن انکار راست","ای دروغی که صدای تو ناشی از صداقت است، شکر نعمت را نگو که راست را انکار کنی."],[907,"از مفلسف گویم و سودای او","یا ز کشتیها و دریاهای او","من از نظریه‌پردازان و دانشمندان یا از کشتی‌ها و دریاهای او سخن می‌گویم."],[907,"بل ز کشتیهاش کان پند دلست","گویم از کل جزو در کل داخلست","در این بیت اشاره به این است که به رغم وجود کشتی‌ها، آنچه که واقعا مهم و زیربنایی است، پیام‌های دل و اندیشه‌هاست. هر جزئی از وجود ما بخشی از کل است و باید به این ارتباط عمیق توجه کرد."],[907,"هر ولی را نوح و کشتیبان شناس","صحبت این خلق را طوفان شناس","هر ولی و پیشوایی مانند نوح، کسی است که وظیفه هدایت و رهبری مردم را بر عهده دارد و کسانی که با او تعامل دارند، باید مانند طوفانی شناخته شوند که در برابر آن محافظت و پناه می‌طلبند."],[907,"کم گریز از شیر و اژدرهای نر","ز آشنایان و ز خویشان کن حذر","از نزدیکان و آشناها باید دوری کرد و از آن‌ها بپرهیز، چون همچون شیر و اژدرهای نر (حیوانات وحشی و خطرناک) می‌توانند مضر و کشنده باشند."],[907,"در تلاقی روزگارت می‌برند","یادهاشان غایبی‌ات می‌چرند","در برخورد با روزگار، یاد کسانی که در گذشته بوده‌اند و اکنون غایب هستند، تو را می‌سوزاند یا آزار می‌دهد. در واقع، خاطرات آن‌ها در ذهنت می‌چرخد و تو را به فکر فرو می‌برد."],[907,"چون خر تشنه خیال هر یکی","از قف تن فکر را شربت‌مکی","چون خر تشنه، خیال هر فردی از او، مانند شربت شیرین است که به فکرش می‌رسد."],[907,"نشف کرد از تو خیال آن وشات","شبنمی که داری از بحر الحیات","خیال و تصور تو به مانند شبنمی است که از دریا (بحر الحیات) برمی‌خیزد و تو را از غفلت و بی‌خبری خارج می‌کند."],[907,"پس نشان نشف آب اندر غصون","آن بود کان می‌نجنبد در رکون","پس نشانه‌ای از خمیری بودن آب در شاخه‌ها و درختان وجود دارد که نمی‌لرزد و ثابت است."],[907,"عضو حر شاخ تر و تازه بود","می‌کشی هر سو کشیده می‌شود","چون درختی تازه و سبز است که با حرارت و گرما سرسبزتر می‌شود، با هر حرکتی که به آن می‌کنی، به سمت دیگر کشیده می‌شود."],[907,"گر سبد خواهی توانی کردنش","هم توانی کرد چنبر گردنش","اگر می‌خواهی که سبدی بسازی، می‌توانی آن را درست کنی، همچنین می‌توانی گردن او را به دور آن بچرخانی."],[907,"چون شد آن ناشف ز نشف بیخ خود","ناید آن سویی که امرش می‌کشد","زمانی که ریشه (بیخ) گیاه نازک و ضعیف می‌شود، دیگر نمی‌تواند به سمت جایی برود که فرمان (عوامل) آن را می‌کشد."],[907,"پس بخوان قاموا کسالی از نبی","چون نیابد شاخ از بیخش طبی","اگر کسی مانند نبی (پیامبر) از ریشه‌اش جدا شود و ایمان نداشته باشد، مانند درختی می‌شود که دیگر شاخ و برگ نخواهد داشت و نمی‌تواند میوه‌ای به بار آورد."],[907,"آتشین است این نشان کوته کنم","بر فقیر و گنج و احوالش زنم","این نشان آتشین است که می‌گوید من این ندا را به خاطر فقر و وضعیت فقیران کوتاه می‌کنم. در واقع می‌خواهم درباره وضعیت فقیران صحبت کنم و احوال آن‌ها را به تصویر بکشم."],[907,"آتشی دیدی که سوزد هر نهال","آتش جان بین کزو سوزد خیال","آتشی را دیدی که تمام درخت‌ها را می‌سوزاند، این آتش جان را ببین که چگونه خیالات را می‌سوزاند."],[907,"نه خیال و نه حقیقت را امان","زین چنین آتش که شعله زد ز جان","نه خیال و نه حقیقت از این آتش در امان نیستند؛ این آتش که از جان برمی‌خیزد، شعله‌اش همه‌جا را می‌سوزاند."],[907,"خصم هر شیر آمد و هر روبه او","کل شیء هالک الا وجهه","دشمن هر شیر (شجاع و قوی) و هر روباه (حیله‌گر) برای هلاکت و نابودی می‌آید، اما هر چیز، جز وجه خداوند، فانی و نابود می‌شود."],[907,"در وجوه وجه او رو خرج شو","چون الف در بسم در رو درج شو","به دلیلی که در آیه‌ «کل شیء هالک الا وجهه» آمده است، در ذات الهی خطر و زوال وجود ندارد. بنابراین، در همه موجودات باید به او توجه کرد و در واقع مانند «الف» که در واژه «بسم» پنهان شده، وجود او نیز در تمام چیزها نهفته است."],[907,"آن الف در بسم پنهان کرد ایست","هست او در بسم و هم در بسم نیست","حرف «الف» که در واژه «بسم» ظاهر شده است، به گونه‌ای نهفته و پنهان است که هم وجود دارد و هم در عین حال، به نوعی در آن واژه غایب است. این به نوعی به راز وجود و عدم در چیزها اشاره دارد."],[907,"هم‌چنین جمله حروف گشته مات","وقت حذف حرف از بهر صلات","به همین ترتیب، تمام حروف به سکوتی مبدل می‌شوند، در زمان حذف حرف برای برقراری ارتباط."],[907,"از صله‌ست و بی و سین زو وصل یافت","وصل بی و سین الف را بر نتافت","وصال و ارتباط به خاطر حرف «ص» (صله) است و کسی که به خاطر حذف حرف «ب» و «س» نتوانسته به وصال برسد، از الف (عشق و محبت) دور شده و نتوانسته به آن دست یابد."],[907,"چونک حرفی برنتابد این وصال","واجب آید که کنم کوته مقال","در اینجا اشاره شده است که وقتی چیزی یا کسی نتواند سخن بگوید، به نظر می‌رسد که برای ایجاد وصالی ضروری است که سخن کوتاه و مختصر باشد. بنابراین، در شرایطی که گفت و شنود ممکن نیست، باید به طور مستقیم و بی‌پرده به اصل مطلب پرداخت."],[907,"چون یکی حرفی فراق سین و بیست","خامشی اینجا مهمتر واجبیست","وقتی که انسانی به خاطر جدایی و فراق، سکوت و خاموشی را بر می‌گزیند، این سکوت و خاموشی در اینجا از اهمیت بیشتری برخوردار است و واجب‌تر شده است."],[907,"چون الف از خود فنا شد مکتنف","بی و سین بی او همی‌گویند الف","وقتی حرف «الف» به طور کامل ناپدید شود و از بین برود، در این حال، بی‌نهایت و «سین» هم بدون وجود او، فقط از سر ناچاری به «الف» اشاره می‌کنند."],[907,"ما رمیت اذ رمیت بی ویست","هم‌چنین قال الله از صمتش بجست","تو که سنگ و تیر را پرتاب نکردی، بلکه خداوند با قدرتش این کار را انجام داد؛ همچنین خداوند فرمود که از سکوت او بر می‌آید."],[907,"تا بود دارو ندارد او عمل","چونک شد فانی کند دفع علل","تا زمانی که دارو وجود دارد، او (بیمار) نیازی به عمل ندارد، زیرا وقتی که دارو ناپدید می‌شود، درمان بیماری (دفع علل) نیز از بین می‌رود."],[907,"گر شود بیشه قلم دریا مداد","مثنوی را نیست پایانی امید","اگر جنگل قلم به دریا تبدیل شود، دیگر برای نوشتن مثنوی مداد کافی نیست و این شعر هرگز پایان نخواهد یافت."],[907,"چارچوب خشت‌زن تا خاک هست","می‌دهد تقطیع شعرش نیز دست","نقاشی یا سازنده‌ای که خشت می‌زند تا زمانی که خاک وجود دارد، می‌تواند شعرش را قطع و تنظیم کند. به عبارتی دیگر، تا وقتی که امکانات و مواد اولیه برای ساخت و خلق وجود دارد، هنرمند می‌تواند آثارش را شکل بدهد."],[907,"چون نماند خاک و بودش جف کند","خاک سازد بحر او چون کف کند","وقتی که دیگر از زمین خاکی باقی نماند، خاک به او لطافت می‌بخشد و دریا نیز مانند کف، به او شکل می‌دهد."],[907,"چون نماند بیشه و سر در کشد","بیشه‌ها از عین دریا سر کشد","زمانی که جنگل‌ها و بیشه‌ها به پایان برسند و به دریا سر بکشند، این نشان‌دهنده تجلی و ظهور عظمت خداوند است."],[907,"بهر این گفت آن خداوند فرج","حدثوا عن بحرنا اذ لا حرج","خداوند به نجات مؤمنان در زمان مشکلات اشاره می‌کند و می‌گوید از دریای رحمت ما صحبت کنید، زیرا این کار برای شما مضر نیست."],[907,"باز گرد از بحر و رو در خشک نه","هم ز لعبت گو که کودک‌راست به","از دنیای پرهیاهو و خالی از واقعیت و عواطف بازگرد و به زندگی عادی و خشک و بدون لذت‌ها روی آور. اینجا اشاره به این دارد که باید از بازی‌های کودکانه و بی‌محتوا فاصله بگیریم."],[907,"تا ز لعبت اندک اندک در صبا","جانش گردد با یم عقل آشنا","اگر به تدریج از بازی و سرگرمی‌ها دور شود، روح او کم‌کم با عقل و درک آشنا می‌شود."],[907,"عقل از آن بازی همی‌یابد صبی","گرچه با عقلست در ظاهر ابی","عقل از این بازی بچه‌گانه به‌تدریج فهم و درک پیدا می‌کند، هرچند که در ظاهر هنوز مانند یک کودک نابالغ است."],[907,"کودک دیوانه بازی کی کند","جزو باید تا که کل را فی کند","کودک دیوانه هیچ‌گاه بازی نمی‌کند مگر اینکه به یک کل و اصل خاصی متصل شود تا بتواند جزئی از آن کل باشد."],[908,"نک خیال آن فقیرم بی‌ریا","عاجز آورد از بیا و از بیا","من در اینجا تنها به توجه به حال فقیر بی‌ریا و عاجز فکر می‌کنم، که او را از جنبه‌های ظاهری و مادی زندگی، یعنی «بیا» و «بیا» دور نگه می‌دارم و از حقیقت و عمق وجودش آگاه هستم."],[908,"بانگ او تو نشنوی من بشنوم","زانک در اسرار همراز ویم","بانگ او را تو نمی‌شنوی، اما من می‌شنوم زیرا او با من در اسرار و رازها شریک است."],[908,"طالب گنجش مبین خود گنج اوست","دوست کی باشد به معنی غیر دوست","کسی که به دنبال گنج می‌گردد، نباید به دنبال چیزی جز خود او باشد، زیرا او در اصل خود گنج است و هیچ‌کس نمی‌تواند در این معنا به او جز دوست بودن نزدیک شود."],[908,"سجده خود را می‌کند هر لحظه او","سجده پیش آینه‌ست از بهر رو","انسان هر لحظه باید خود را در برابر آینه‌ای که حقیقت وجودش را نشان می‌دهد، به سجده بیندازد و از او (دوست یا خدا) طلب یاری کند."],[908,"گر بدیدی ز آینه او یک پشیز","بی‌خیالی زو نماندی هیچ چیز","اگر در آینه فقط یک ذره از بی‌خیالی او را می‌دیدی، دیگر هیچ چیز از او برای تو باقی نمی‌ماند."],[908,"هم خیالاتش هم او فانی شدی","دانش او محو نادانی شدی","خیالات او و خود او از بین رفت و نابود شد؛ دانایی او نیز در اثر نادانی‌ش در حال محو شدن است."],[908,"دانشی دیگر ز نادانی ما","سر برآوردی عیان که انی انا","دانش دیگری از نادانی ما پدیدار شد که آشکار است و می‌گوید «من همانم»؛ به این معنا که پس از درک و شناخت واقعی، انسان به حقیقت وجود خود واقف می‌شود."],[908,"اسجدوا لادم ندا آمد همی","که آدمید و خویش بینیدش دمی","ندایی به فرشتگان می‌رسد که به آدم سجده کنند و در این لحظه، به یادآورنده‌ای هستند که آدم خود را بشناسد و یک لحظه به خود بیندیشد."],[908,"احولی از چشم ایشان دور کرد","تا زمین شد عین چرخ لاژورد","مولانا اشاره می‌کند که احولی (وضعیت حیرانی و بی‌خبری) را از دید افراد دور کرد و به این ترتیب، زمین را به شکلی شبیه به آسمان لاژوردی نشان داد. این تصویر به نوعی به وحدت و هماهنگی در هستی اشاره دارد."],[908,"لا اله گفت و الا الله گفت","گشت لا الا الله و وحدت شکفت","او در گفتن «لا اله» به نفی همه معبودها پرداخت و با گفتن «الا الله» به یگانگی خداوند اشاره کرد و در نتیجه، مفهوم یکتایی خداوند به وجود آمد."],[908,"آن حبیب و آن خلیل با رشد","وقت آن آمد که گوش ما کشد","در اینجا به حبیب (یار) و خلیل (حضرت ابراهیم) اشاره می‌شود که در زمان مناسب و در وقت رشد، توجه و دعوت به حق را انجام می‌دهند و ما را به شنیدن و درک حقیقت می‌خوانند."],[908,"سوی چشمه که دهان زینها بشو","آنچ پوشیدیم از خلقان مگو","به سوی چشمه برو و دهانت را از این چیزها بشوی. آنچه را که از دیگران پنهان کرده‌ای، نباید بگویی."],[908,"ور بگویی خود نگردد آشکار","تو به قصد کشف گردی جرم‌دار","اگر بگویی که چیزی را پنهان کرده‌ای، آن راز از تو فاش نخواهد شد، مگر آنکه به قصد آشکار کردن آن جرم و راز، تلاش کنی."],[908,"لیک من اینک بریشان می‌تنم","قایل این سامع این هم منم","اما من اکنون در برابرشان تسلیم می‌شوم و به این شنونده می‌گویم که این من هم همان من هستم."],[908,"صورت درویش و نقش گنج گو","رنج کیش‌اند این گروه از رنج گو","این گروهی که در ظاهر درویش هستند، در واقع به دنبال گنج و ثروت‌اند و از رنج و زحمت نمی‌هراسند."],[908,"چشمه راحت بریشان شد حرام","می‌خورند از زهر قاتل جام‌جام","زندگی آرام و راحت برای آن‌ها حرام شده است و به همین خاطر از زهر کشنده‌ای مانند می‌خورند که تنها به دردشان می‌خورد."],[908,"خاکها پر کرده دامن می‌کشند","تا کنند این چشمه‌ها را خشک‌بند","خاک‌ها دامان را پر کرده و به سمت خود می‌کشند تا این چشمه‌ها را مسدود کنند و خشک کنند."],[908,"کی شود این چشمه دریامدد","مکتنس زین مشت خاک نیک و بد","چگونه ممکن است این چشمه حیات‌بخش، که به دریای الهام و مدد وابسته است، به خاطر این مشت خاک خوب و بد مسدود شود؟"],[908,"لیک گوید با شما من بسته‌ام","بی‌شما من تا ابد پیوسته‌ام","اما من با شما عهد بسته‌ام، حتی بدون حضور شما، و تا ابد به این عهد وفادار خواهم بود."],[908,"قوم معکوس‌اند اندر مشتها","خاک‌خوار و آب را کرده رها","قوم به عکس رفتاری دارند، یعنی به جای آنکه از خاک و آب بهره‌مند شوند و زندگی خود را بسازند، به خوردن خاک و ترک آب مشغولند."],[908,"ضد طبع انبیا دارند خلق","اژدها را متکا دارند خلق","خلق (مردم) دارای طبیعتی مخالف انبیا هستند و به شناسایی و بهره‌مندی از چیزهای مثبت و روحانی نمی‌پردازند؛ مانند اژدها، که جانداری خطرناک و بی‌رحم است و به جای آرامش، به سختی و بی‌رحمی تکیه می‌کند."],[908,"چشم‌بند ختم چون دانسته‌ای","هیچ دانی از چه دیده بسته‌ای","چشم‌ بند شدن و ناآگاهی به حقایق، مانند حالتی است که انسان هنگامی به آن دچار می‌شود که نمی‌داند از چه چیزی چشم پوشیده و خود را از دیدن حقیقت محروم کرده است."],[908,"بر چه بگشادی بدل این دیده‌ها","یک به یک بئس البدل دان آن ترا","چرا چشمانت را از حقیقت بسته‌ای و به این بدل‌ها اکتفا کرده‌ای؟ بدان که این عوضی، بسیار بد است."],[908,"لیک خورشید عنایت تافته‌ست","آیسان را از کرم در یافته‌ست","اما خورشید لطف و رحمت، که برکاتش به همه می‌تابد، برای کسانی که از روی بزرگواری و کرم به آن رسیده‌اند، روشن و نمایان شده است."],[908,"نرد بس نادر ز رحمت باخته","عین کفران را انابت ساخته","رحمت خداوند به قدری نادر و کمیاب است که بسیاری از مردم آن را با نادانی خود از دست می‌دهند و به جای شکرگزاری، به کفران و ناسپاسی روی می‌آورند."],[908,"هم ازین بدبختی خلق آن جواد","منفجر کرده دو صد چشمه وداد","این بیت به این معناست که آن جواد (اسب) از بدبختی مردم به طرز شگفت‌انگیزی جان می‌گیرد و دوصد چشمه از محبت و دوستی را جاری می‌کند. به عبارت دیگر، او از درد و رنج مردم الهام می‌گیرد و عشق و محبت را در دل‌ها به وجود می‌آورد."],[908,"غنچه را از خار سرمایه دهد","مهره را از مار پیرایه دهد","عشق باعث می‌شود که زیبایی‌ها و نعمت‌ها از چیزهای تلخ و دشوار به دست آید؛ یعنی گل را از خار و زینت را از مار می‌سازد."],[908,"از سواد شب برون آرد نهار","وز کف معسر برویاند یسار","از تاریکی شب، صبح را بیرون می‌آورد و از دست تهیدستان، ثروت را به وجود می‌آورد."],[908,"آرد سازد ریگ را بهر خلیل","کوه با داود گردد هم رسیل","داود (پادشاه و پیامبر) با نغمه چنگ خود سنگ‌ها را نرم می‌کند و از آنان ساز و آهنگ می‌سازد، همان‌طور که خلیل (ابراهیم) با آتش به دوستی و محبت می‌رسد. این اشاره به قدرت موسیقی در ایجاد تغییر و تأثیرگذاری دارد."],[908,"کوه با وحشت در آن ابر ظلم","بر گشاید بانگ چنگ و زیر و بم","نفس وحشت‌زای کوه با ظلمتی که از ابرها برمی‌خیزد، صدای چنگ (آلت موسیقی) را به همراه نغمه‌هایی در زیر و بم خود گسترش می‌دهد."],[908,"خیز ای داود از خلقان نفیر","ترک آن کردی عوض از ما بگیر","ای داود، از میان مردم برخیز و با صدای خود تار و تنبور را ترک کن و به جای آن، از ما مقام و نعمت بگیر."],[909,"گفت آن درویش ای دانای راز","از پی این گنج کردم یاوه‌تاز","آن درویش به دانای راز گفت: به خاطر این گنج، بیهوده تلاش کرده‌ام و در پی آن به هر سو رفته‌ام."],[909,"دیو حرص و آز و مستعجل تگی","نی تانی جست و نی آهستگی","انسان باید از دیو حرص و طمع و شتاب‌زدگی دوری کند؛ زیرا نه با عجله به به دست آوردن خواسته‌ها می‌توان رسید و نه به سادگی و آرامی."],[909,"من ز دیگی لقمه‌ای نندوختم","کف سیه کردم دهان را سوختم","من از دیگی که پر از غذا بوده، لقمه‌ای برنداشتم و در نتیجه دستم به سیاهی آغشته شده و دهانم نیز سوخته است. این تعبیر نشان می‌دهد که به خاطر نرسیدن به خواسته‌ام یا در جستجوی آن، دچار مشکل شده‌ام."],[909,"خود نگفتم چون درین ناموقنم","زان گره‌زن این گره را حل کنم","من نمی‌توانم به تنهایی این گره را که در موقعیت نامناسبی قرار دارم، باز کنم؛ بلکه از گره‌زنی (خدا) تقاضا دارم که این مشکل را حل کند."],[909,"قول حق را هم ز حق تفسیر جو","هین مگو ژاژ از گمان ای سخت‌رو","سخن خداوند را هم باید از خداوند تفسیر کرد، بنابراین از گمان و توهم صحبت نکن و بیهوده حرف نزن، ای کسی که در افکارت سخت و ناتوان هستی."],[909,"آن گره کو زد همو بگشایدش","مهره کو انداخت او بربایدش","هر که گرهی را محکم بزند، همان شخص می‌تواند آن را باز کند. کسی که مهره‌ای را (در جای خود) بی‌اندازد، باید پاسخ‌گو باشد و آن را برگیرد."],[909,"گرچه آسانت نمود آن سان سخن","کی بود آسان رموز من لدن","اگرچه به نظر می‌رسد که این سخن تو را راحت کرده است، اما آیا واقعا از رموز و اسرار من که از جانب خداوند است، آسان است؟"],[909,"گفت یا رب توبه کردم زین شتاب","چون تو در بستی تو کن هم فتح باب","گفت: ای خدا، من از این شتاب و عجله توبه کردم. تو که در رحمت را به روی بندگانت بسته‌ای، آن در را بگشا."],[909,"بر سر خرقه شدن بار دگر","در دعا کردن بدم هم بی‌هنر","درخواست دوباره‌ام برای نشان دادن حالتی است که از یک سو، در پی اصلاح خودم هستم و از سوی دیگر، خود را بی‌هنر و فاقد قابلیت می‌دانم."],[909,"کو هنر کو من کجا دل مستوی","این همه عکس توست و خود توی","هنر و توانایی من کجا رفته است؟ من کجا هستم در حالی که دل و جانم پر از تصویرها و نشانه‌های توست، اما خود تو در این میان غایب از نظر هستی."],[909,"هر شبی تدبیر و فرهنگم به خواب","هم‌چو کشتی غرقه می‌گردد ز آب","هر شب برنامه‌ریزی و تدبیرم در خواب مثل کشتی‌ای که در آب غرق می‌شود، دچار مشکل و سردرگمی می‌شود."],[909,"خود نه من می‌مانم و نه آن هنر","تن چو مرداری فتاده بی‌خبر","من نه خودم را می‌شناسم و نه آن مهارت و دانشی را که در وجودم هست؛ مثل مرده‌ای هستم که بی‌خبر از حال خود افتاده‌ام."],[909,"تا سحر جمله شب آن شاه علی","خود همی‌گوید الستی و بلی","تا هنگام سحر، تمام شب آن شاه علی (حضرت علی) همواره می‌گوید که «آیا من هستم؟» و «بله، من هستم». این یک بیان از احساس تکرار و تأکید بر وجود و حضور او در کلام است."],[909,"کو بلی‌گو جمله را سیلاب برد","یا نهنگی خورد کل را کرد و مرد","به دلیل شدت شوق و اشتیاق، همه آن‌ها را مثل آب که به وسیله سیلاب می‌رود، برده است یا اینکه نهنگی همه آن‌ها را بلعیده و نابود کرده است."],[909,"صبح‌دم چون تیغ گوهردار خود","از نیام ظلمت شب بر کند","صبح هنگام، مانند تیغی که از غلاف خود خارج می‌شود، تاریکی شب را به کنار می‌زند و نور را نمایان می‌کند."],[909,"آفتاب شرق شب را طی کند","از نهنگ آن خورده‌ها را قی کند","آفتاب سر روز به‌تدریج شب را می‌زداید و همان‌طور که نهنگ خورده‌ها را خارج می‌کند، روشنایی روز هم تاریکی را از بین می‌برد."],[909,"رسته چون یونس ز معده آن نهنگ","منتشر گردیم اندر بو و رنگ","ما به مانند یونس، که از معده نهنگ خارج شد، در جهان به رنگ و بوی مختلف پخش شده‌ایم و رسته‌ایم."],[909,"خلق چون یونس مسبح آمدند","کاندر آن ظلمات پر راحت شدند","مردم مانند یونس که از دل نهنگ آزاد شد، در این تاریکی‌ها به آرامش و راحتی رسیدند."],[909,"هر یکی گوید به هنگام سحر","چون ز بطن حوت شب آید به در","هر کس در زمان سحر فریاد می‌زند که چگونه مانند یونس (پیامبر) که از شکم ماهی شب به بیرون آمد، از تاریکی‌های شب رها شود."],[909,"کای کریمی که در آن لیل وحش","گنج رحمت بنهی و چندین چشش","ای بخشنده‌ای که در شب تاریک رحمتت را پنهان کرده‌ای و بارها درباره‌اش تماشا کرده‌ای،"],[909,"چشم تیز و گوش تازه تن سبک","از شب هم‌چون نهنگ ذوالحبک","چشم‌ها باید تیز و گوش‌ها باید تازه باشند و بدن نیز باید سبک باشد، مانند نهنگ بزرگ که در شب به راحتی حرکت می‌کند."],[909,"از مقامات وحش‌رو زین سپس","هیچ نگریزیم ما با چون تو کس","پس از تجربه‌هایی که در مقام‌های ناایمن و ناشناخته داشتیم، دیگر از هیچ‌کسی نمی‌گریزیم. ما با کسی چون تو که در این راه به ما کمک می‌کنی، دیگر جایی برای ترس و فرار نداریم."],[909,"موسی آن را نار دید و نور بود","زنگیی دیدیم شب را حور بود","موسی (پیامبر) در یک طرف، نور و روشنی را می‌بیند و در طرف دیگر، زنگی را (که به معنای چیزی ناپسند است) می‌بیند. او در شب، زیبایی و خوشی را (مثل حوریان بهشتی) مشاهده می‌کند. این بیت به دگرگونی آرزوها و دیدگاه‌ها اشاره دارد."],[909,"بعد ازین ما دیده خواهیم از تو بس","تا نپوشد بحر را خاشاک و خس","پس از این ما از تو خواهیم دیدن حقیقتی که شایسته توست تا اینکه مانند خاشاک و علف، دریا را نپوشاند و آن را مستور نکند."],[909,"ساحران را چشم چون رست از عمی","کف‌زنان بودند بی‌این دست و پا","چشمان ساحران به محض اینکه از تاریکی و blindness رها شدند، همچون افرادی شگفت‌زده عمل می‌کنند که بی‌نیاز از دست و پا در حال applauding و ابراز شگفتی هستند."],[909,"چشم‌بند خلق جز اسباب نیست","هر که لرزد بر سبب ز اصحاب نیست","چشم‌بند مردم تنها ابزار و وسیله‌ای است که آن‌ها را از حقیقت دور می‌کند. هر کسی که به خاطر برخی دلایل و وسایل دنیوی به تردید و لرزش بیفتد، جزو یاران و دوستان حقیقی خدا نیست."],[909,"لیک حق اصحابنا اصحاب را","در گشاد و برد تا صدر سرا","اما حق، دوستان ما را به گشایش و رهایی می‌آورد و آنها را تا جایگاه بالا و ارجمند می‌برد."],[909,"با کفش نامستحق و مستحق","معتقان رحمت‌اند از بند رق","حتی افرادی که لیاقت دارند و به مقام والایی رسیده‌اند، ممکن است با دست‌کشی از سنن و آداب در جوار رحمت الهی قرار گیرند، همان‌طور که کسانی که مستحق نیستند نیز ممکن است از نعمت‌های الهی بهره‌مند شوند."],[909,"در عدم ما مستحقان کی بدیم","که برین جان و برین دانش زدیم","ما که در شرایطی از نبود و نداشتن به سر می‌بریم، آیا واقعا شایسته‌ و لایق چیزی بودیم که بر این جان و این دانش خویش تلاش کردیم و چیزی بدان افزودیم؟"],[909,"ای بکرده یار هر اغیار را","وی بداده خلعت گل خار را","ای خداوندی که یار هر بیگانه‌ای، تو به کسی که در سختی و دلتنگی است، لباس گل و خار (یعنی نعمت و سختی) می‌دهی."],[909,"خاک ما را ثانیا پالیز کن","هیچ نی را بار دیگر چیز کن","خاک وجود ما را دوباره زرع و آب ده تا به ثمر بنشیند، هیچ چیز نرسانی و بار دیگر تغییر و تحول ایجاد کن."],[909,"این دعا تو امر کردی ز ابتدی","ورنه خاکی را چه زهره این بدی","این دعا را تو از ابتدا فرمان دادی، و گرنه خاکی چگونه می‌تواند چنین دعایی کند یا جرأت طرح آن را داشته باشد."],[909,"چون دعامان امر کردی ای عجاب","این دعای خویش را کن مستجاب","چون تو ای پروردگار، دعا کردن را دستور و فرمان داده‌ای، ای شگفت، پس این دعای خود را مستجاب کن."],[909,"شب شکسته کشتی فهم و حواس","نه امیدی مانده نه خوف و نه یاس","شبی که در آن، کشتی فهم و درک و حواس انسان در شکستگی و نابودی است، دیگر نه امیدی برای نجات باقی مانده و نه ترسی از وقوع بلای جدید یا از دست رفتن چیزی، و نه حتی یأس و ناامیدی وجود دارد."],[909,"برده در دریای رحمت ایزدم","تا ز چه فن پر کند بفرستدم","من در دریای رحمت خداوند غرق شده‌ام، پس از من بپرس که چگونه می‌توانم از این حالت بهره‌برداری کنم و به کجا بروم."],[909,"آن یکی را کرده پر نور جلال","وآن دگر را کرده پر وهم و خیال","خداوند یکی از انسان‌ها را پر از نور و جلال کرده است، در حالی که دیگری را پر از وهم و خیال ساخته است."],[909,"گر بخویشم هیچ رای و فن بدی","رای و تدبیرم به حکم من بدی","اگر من به هیچ نظری و تدبیری دست نیافته باشم، رای و تدبیر خودم به خاطر اراده و خواست الهی بی‌فایده و ناکارآمد است."],[909,"شب نرفتی هوش بی‌فرمان من","زیر دام من بدی مرغان من","در شب، بدون اراده و هوشیاری من، در دام من بودی که مانند پرندگان به آن گرفتار شده بودی."],[909,"بودمی آگه ز منزلهای جان","وقت خواب و بیهشی و امتحان","من از منازل و مراحل روح آگاه بودم، اما در زمان خواب و بی‌خوابی و آزمایش دچار غفلت شدم."],[909,"چون کفم زین حل و عقد او تهیست","ای عجب این معجبی من ز کیست","وقتی که دستم از این پیچیدگی‌ها و مشکلات خالی است، شگفت آور این است که من، که خودم این همه شگفتی را می‌بینم، از کجا آمده‌ام و ریشه‌ام چیست."],[909,"دیده را نادیده خود انگاشتم","باز زنبیل دعا برداشتم","چشمم را نادیده و نادان دانستم و دوباره برای خودم زانبیل دعا را برداشتم تا دعا کنم."],[909,"چون الف چیزی ندارم ای کریم","جز دلی دلتنگ‌تر از چشم میم","ای خداوند بزرگ، من هیچ چیزی ندارم جز دلی بسیار ناراحت و غمگین که از چشم‌هایم بیشتر دلتنگ است."],[909,"این الف وین میم ام بود ماست","میم ام تنگست الف زو نر گداست","منظور از «الف» و «میم» در این بیت، نمادهایی برای اشاره به حالتی درونی و عاطفی هستند. «الف» نماینده‌ای از وجود و حالتی نیکو است و در مقابل «میم» نمایانگر حالتی تنگ و مضطرب است. در واقع، شاعر می‌گوید که وجود او (الف) در مقایسه با حال دل‌تنگ و پریشانش (میم) کمی رنگ باخته و نادرست است."],[909,"آن الف چیزی ندارد غافلیست","میم دلتنگ آن زمان عاقلیست","الف، که نمایانگر مبدأ و حقیقت است، هیچ چیزی ندارد و نادانی است. اما میم، که در اینجا به معنای غم و دلتنگی است، در زمانی که عقل و هوش فعال است، حکمت و عاقل است."],[909,"در زمان بیهشی خود هیچ من","در زمان هوش اندر پیچ من","در زمانی که انسان در حالت غفلت و بی‌خبری است، هیچ وجودی ندارد و وقتی هوش و آگاهی به او برمی‌گردد، در لایه‌هایی پیچیده و دشوار گیر می‌کند."],[909,"هیچ دیگر بر چنین هیچی منه","نام دولت بر چنین پیچی منه","بر کسی که هیچ چیز ندارد، نام مقام و قدرت نگذار و خودت را به زحمت نینداز."],[909,"خود ندارم هیچ به سازد مرا","که ز وهم دارم است این صد عنا","من هیچ چیزی از خود ندارم که توانایی بسازد و من فقط به خاطر تصورات و خیالاتم است که این همه مشکل و دغدغه دارم."],[909,"در ندارم هم تو داراییم کن","رنج دیدم راحت‌افزاییم کن","من در خود هیچ ندارم، تو مرا دارا کن. من زحمت و رنج زیادی کشیده‌ام، تو آرامش و راحتی مرا فراهم کن."],[909,"هم در آب دیده عریان بیستم","بر در تو چونک دیده نیستم","من با چشم اشک‌بار و خالی از لباس (معنای نمادین، یعنی بی‌پناه و بی‌یار) بر درگاه تو (خدا) حاضر می‌شوم، چون نمی‌توانم با چشم سر خود تو را ببینم."],[909,"آب دیده بنده بی‌دیده را","سبزه‌ای بخش و نباتی زین چرا","چشم‌های من که از گریه و غم پرآب است، هیچ نمی‌بینند، پس بر من رحم کن و به جای آن، گیاهی به من بده که نشانه‌ای از زندگی باشد و من را از این حالت بیرون آورد."],[909,"ور نمانم آب آبم ده ز عین","هم‌چو عینین نبی هطالتین","اگر نمی‌توانم آب جویبار را به دست آورم، پس از چشمه‌ای الهی به من آب بده مانند آن دو چشمه‌ای که از چشمان نبی (پیامبر) جاری است و همچنان شایسته و نیکو هستند."],[909,"او چو آب دیده جست از جود حق","با چنان اقبال و اجلال و سبق","او مانند آبی که از چشمانش می‌ریزد، از بخشش خداوند، با چنین ارادت و بزرگی و پیشی گرفتن در طلب، می‌جوید."],[909,"چون نباشم ز اشک خون باریک‌ریس","من تهی‌دست قصور کاسه‌لیس","وقتی که من از اشک‌های خود به اندازه کافی بهره‌مند نیستم و بی‌چاره و نیازمند هستم، باید بدانم که در طلب و درخواست از خداوند دچار کمبود و نقصان هستم."],[909,"چون چنان چشم اشک را مفتون بود","اشک من باید که صد جیحون بود","چون چشمانم به اشک مجذوب و شیفته است، اشک من باید به اندازه صد جیحون باشد."],[909,"قطره‌ای زان زین دو صد جیحون به است","که بدان یک قطره انس و جن برست","بسیاری از آب‌های گوناگون و فراوان بهتر از یک قطره‌ای هستند که از آن محبت و نزدیکی به خداوند حاصل می‌شود. این یک قطره، ارزشمندتر از صدها جیحون (رودخانه) است."],[909,"چونک باران جست آن روضه بهشت","چون نجوید آب شوره‌خاک زشت","زمانی که باران رحمت الهی به باغ بهشت می‌بارد، دیگر زمین شوره‌زار و زشت نیازی به آب ندارد، زیرا نعمت‌ها و زیبایی‌ها به حدی فراوان شده که این زمین دیگر ارزش توجه ندارد."],[909,"ای اخی دست از دعا کردن مدار","با اجابت یا رد اویت چه کار","ای برادر، از دعا کردن دست نکش، چون در مورد اجابت یا عدم اجابت دعایت، این تو نیستی که تعیین‌کننده‌ای."],[909,"نان که سد و مانع این آب بود","دست از آن نان می‌بباید شست زود","نان که باعث جلوگیری از ریختن اشک‌ها بود، باید به سرعت از دست برداشته شود."],[909,"خویش را موزون و چست و سخته کن","ز آب دیده نان خود را پخته کن","خودت را منظم و آماده کن و به کمک اشک‌های خود، آرامش خاطر و نیازهایت را برطرف کن."],[910,"اندرین بود او که الهام آمدش","کشف شد این مشکلات از ایزدش","او در این شرایط بود که الهام به او رسید و مشکلاتش از جانب خداوند برایش آشکار شد."],[910,"کو بگفتت در کمان تیری بنه","کی بگفتندت که اندر کش تو زه","هیچ‌کس به تو نگفت که تیر را در کمان بگذار؛ به تو نگفتند که خودت باید زه (سیم کمان) را بکشید."],[910,"او نگفتت که کمان را سخت‌کش","در کمان نه گفت او نه پر کنش","او به تو نگفت که کمان را محکم بکش و در کمان تیر را قرار نده، او چیزی درباره پر کردن کمان به تو نگفت."],[910,"از فضولی تو کمان افراشتی","صنعت قواسیی بر داشتی","تو به خاطر فضولی و سرکشی‌ات کمان را بالا برده‌ای و در واقع کار قواسی (کماندار) را کرده‌ای."],[910,"ترک این سخته کمانی رو بگو","در کمان نه تیر و پریدن مجو","ترک این کار سخت و دشوار شو و بگو که در کمان محبت، تیر و پریدن وجود ندارد."],[910,"چون بیفتد بر کن آنجا می‌طلب","زور بگذار و بزاری جو ذهب","هرگاه تو در آن مکان بیفتی و نیاز به قدرت و تلاش داشته باشی، باید با جدیت و حمایت خود، تلاش کنی تا به طلا و گنجی که می‌طلبی دست یابی."],[910,"آنچ حقست اقرب از حبل الورید","تو فکنده تیر فکرت را بعید","حقیقتی که در واقع بسیار نزدیک‌تر از رگ گردن تو است، تو با تیر تفکر خود آن را دور نشان می‌دهی."],[910,"ای کمان و تیرها بر ساخته","صید نزدیک و تو دور انداخته","ای کمان و تیرها آماده است تا شکار نزدیک را هدف قرار دهد، اما تو خود را دور انداخته‌ای."],[910,"هرکه دوراندازتر او دورتر","وز چنین گنجست او مهجورتر","هر کسی که بیشتر از واقعیت فاصله بگیرد، از آنچه در دسترس است دورتر می‌شود و در نتیجه از آن گنج (دانش یا حقیقت) که به دست نیامده، بیشتر بازمی‌ماند."],[910,"فلسفی خود را از اندیشه بکشت","گو بدو کوراست سوی گنج پشت","فردی که به فلسفه می‌پردازد، به دلیل دوری از فکر و مطالعه برتر، خود را از اندیشه و تفکر عمیق محروم می‌کند. او مانند کسی است که به گنج باارزشی که پشت خود دارد، بی‌توجه است."],[910,"گو بدو چندانک افزون می‌دود","از مراد دل جداتر می‌شود","هر چقدر او بیشتر به خواسته‌های خود می‌پردازد و دست و پا می‌زند، از آرزوی واقعی خود بیشتر دور می‌شود."],[910,"جاهدوا فینا بگفت آن شهریار","جاهدوا عنا نگفت ای بی‌قرار","شهریار (خدا) به مردم می‌گوید که در ما تلاش کنید و مجاهدت ورزید، اما نگفته است که از ما دوری کنید، ای کسی که در جستجوی آرامش هستی."],[910,"هم‌چو کنعان کو ز ننگ نوح رفت","بر فراز قله آن کوه زفت","شخصی مانند کنعان که از شرم و ننگ نوح به دور رفته، بر بالای قله کوهی بلند ایستاده است. کنعان، فرزند نوح است که به علت عدم ایمانش از او جدا شد."],[910,"هرچه افزون‌تر همی‌جست او خلاص","سوی که می‌شد جداتر از مناص","هر چه بیشتر به دنبال گنج می‌رفت، او به آزادی و رهایی نزدیک‌تر می‌شد و از مقام‌ها و موقعیت‌های دنیوی جدا می‌افتاد."],[910,"هم‌چو این درویش بهر گنج و کان","هر صباحی سخت‌تر جستی کمان","مانند این درویش که برای پیدا کردن گنج و معدن هر روز با تلاش بیشتری به دنبال هدفش می‌گردد."],[910,"هر کمانی کو گرفتی سخت‌تر","بود از گنج و نشان بدبخت‌تر","هر کمانی که سخت‌تر و محکم‌تر باشد، نشان‌دهنده‌ی آن است که به دنبال گنج و ثروت هستی، ولی در حقیقت این پی‌جویی تو را بیشتر بدبخت می‌کند."],[910,"این مثل اندر زمانه جانی است","جان نادانان به رنج ارزانی است","این‌گونه می‌توان گفت که انسان‌های جاهل و بی‌خبر همواره در رنج و درد به سر می‌برند، زیرا درک حقیقت و ارزش‌های واقعی برای آنان دشوار است. این پند به نوعی می‌گوید که زندگی آنها به سختی و محنت می‌گذرد."],[910,"زانک جاهل ننگ دارد ز اوستاد","لاجرم رفت و دکانی نو گشاد","چون جهل و نادانی باعث ننگ و خجالت است، او به همین دلیل از استاد دوری کرده و به فکر باز کردن دکان جدیدی افتاده است."],[910,"آن دکان بالای استاد ای نگار","گنده و پر کژدمست و پر ز مار","این دکان که بالای استاد است، پر از مشکلات و خطرات و ستم‌هایی است که بر آن حاکم است. اینجا نماد فریبندگی و دشواری‌هایی است که درظاهر زیبا به نظر می‌رسند، ولی در باطن خالی از حقیقت و مملو از مهلکاتند."],[910,"زود ویران کن دکان و بازگرد","سوی سبزه و گلبنان و آب‌خورد","هر چه زودتر آن دکان را خراب کن و به سوی دشت‌ها، گل‌ها و آب‌های زلال بازگرد."],[910,"نه چو کنعان کو ز کبر و ناشناخت","از که عاصم سفینه فوز ساخت","چنان نیست که مانند کنعان، که به خاطر تنبلی و غرور نتوانست به حقیقت پی ببرد، از کسی که او را نجات می‌دهد غافل بمانی؛ چون او در حقیقت، کشتی نجات را به وجود آورده است."],[910,"علم تیراندازیش آمد حجیب","وان مراد او را بده حاضر به جیب","علم مانند تیراندازی است که به هدف خود می‌زند و از آنجا که به حقیقت دست پیدا کرده، مراد او (خواسته‌اش) در دسترسش قرار گرفته است."],[910,"ای بسا علم و ذکاوات و فطن","گشته ره‌رو را چو غول و راه‌زن","بسیاری از افراد با دانش و هوش و تیزبینی، مانند غول و راهزن، در مسیر زندگی مانع پیشرفت و حرکت افرادی می‌شوند که در جستجوی حقیقت و هدف‌های والای خود هستند."],[910,"بیشتر اصحاب جنت ابلهند","تا ز شر فیلسوفی می‌رهند","بیشتر کسانی که به بهشت می‌روند، درواقع ساده‌اندیش و بی‌خبر از امور عمیق هستند، تا اینکه از تأثیر افکار پیچیده و فریبنده فیلسوفان می‌گریزند."],[910,"خویش را عریان کن از فضل و فضول","تا کند رحمت به تو هر دم نزول","خود را از دانش و حرف‌های اضافی خالی کن تا رحمت الهی هر لحظه بر تو نازل شود."],[910,"زیرکی ضد شکستست و نیاز","زیرکی بگذار و با گولی‌بساز","زیرکی و هوشمندی در تضاد با شکست و نیازمندی است. بنابراین، خود را از زیرکی رها کن و با سادگی و طور دیگر زندگی کن."],[910,"زیرکی دان دام برد و طمع و گاز","تا چه خواهد زیرکی را پاک‌باز","زیرکی باعث می‌شود که انسان‌ها دام‌ها را بشناسند و از طمع و فریب دور بمانند؛ زیرا زیرک واقعی از این‌گونه فریب‌ها خود را دور می‌کند و با احتیاط زندگی می‌کند."],[910,"زیرکان با صنعتی قانع شده","ابلهان از صنع در صانع شده","زیرکان با استفاده از ترفندها و شیوه‌های فریبکارانه به قناعت رسیده‌اند، در حالی که نادان‌ها تنها به خلق و آفرینش دلخوش هستند و از خالق غافل‌اند."],[910,"زانک طفل خرد را مادر نهار","دست و پا باشد نهاده بر کنار","زیرا مانند این است که مادر برای کودکی خردسال نهار آماده کرده و او را در کنار سفره قرار داده است."],[911,"یک حکایت بشنو اینجا ای پسر","تا نگردی ممتحن اندر هنر","داستانی را بشنو، پسرم، تا در استعداد و توانایی خود به امتحان و سنجش درآیی."],[911,"آن جهود و مؤمن و ترسا مگر","همرهی کردند با هم در سفر","جهود (یهودی) و مؤمن (مسلمان) و ترسا (مسیحی) در سفر با هم همراه شدند و همسفر یکدیگر شدند."],[911,"با دو گمره همره آمد مؤمنی","چون خرد با نفس و با آهرمنی","مؤمنی که در سفر با دو همراه بی‌خصلت و مکار همسفر شده، مانند کسی است که با نفس خود و وسوسه‌های شیطانی (آهرمن) در حال جدال است."],[911,"مرغزی و رازی افتند از سفر","همره و هم‌سفره پیش هم‌دگر","مرغ‌زی و رازی (دو نوع پرنده) در سفر به یکدیگر برخورد کردند و همراه یکدیگر شدند و همسفر شدند."],[911,"در قفس افتند زاغ و جغد و باز","جفت شد در حبس پاک و بی‌نماز","زاغ، جغد و باز که در قفس گرفتار شده‌اند، به نوعی به زندگی در محدودیت‌ها و نبود آزادی اشاره دارند. هیچ یک از آنها نمی‌توانند عبادت خود را انجام دهند و در وضعیت مناسبی قرار ندارند. این بیت به تضاد میان موجودات مختلف و وضعیت ناگوار آنها در اسارت اشاره دارد."],[911,"کرده منزل شب به یک کاروانسرا","اهل شرق و اهل غرب و ما ورا","شب را در یک کاروانسرا گذرانیدند که اهل شرق و غرب و ما در آنجا جمع بودند."],[911,"مانده در کاروانسرا خرد و شگرف","روزها با هم ز سرما و ز برف","در کاروانسرا به خاطر سرما و برف، گروهی از مسافران درگیر و حیران مانده‌اند و به فکر چاره هستند."],[911,"چون گشاده شد ره و بگشاد بند","بسکلند و هر یکی جایی روند","زمانی که راه باز شد و موانع برداشته شد، مسافران از یکدیگر جدا شدند و هر کدام به سمتی رفتند."],[911,"چون قفس را بشکند شاه خرد","جمع مرغان هر یکی سویی پرد","وقتی که پادشاه خرد (خداوند) قفس را بشکند، پرندگان (انسان‌ها) هر کدام به سمت دلخواه خود پرواز می‌کنند."],[911,"پر گشاید پیش ازین بر شوق و یاد","در هوای جنس خود سوی معاد","پرواز و شوق پرندگان قبل از این به خاطر یاد و عشق‌شان به دنیای خود، آنها را به سوی بهشتی که در انتظارشان است می‌کشاند."],[911,"پر گشاید هر دمی با اشک و آه","لیک پریدن ندارد روی و راه","هر لحظه دل انسان با اشک و ناله سرشار می‌شود، اما او قدرت پرواز یا یافتن راهی برای پریدن ندارد."],[911,"راه شد هر یک پرد مانند باد","سوی آن کز یاد آن پر می‌گشاد","هر یک از مسافران به سرعت و مانند باد به سوی آن مکان که در خاطرشان یاد آن قوت را زنده کرده بودند، حرکت کردند."],[911,"آن طرف که بود اشک و آه او","چونک فرصت یافت باشد راه او","در آنجا که او (مسلمان) پر از اشک و آه بود، وقتی فرصتی پیدا کرد، به سمت مقصد خود حرکت کرد."],[911,"در تن خود بنگر این اجزای تن","از کجاها گرد آمد در بدن","به اجزای بدنت نگاه کن و ببین که این قسمت‌ها از کجا به هم پیوسته و شکل گرفته‌اند."],[911,"آبی و خاکی و بادی و آتشی","عرشی و فرشی و رومی و گشی","انسان‌ها و همه موجودات از چهار عنصر اصلی آب، خاک، باد و آتش تشکیل شده‌اند. این عناصر می‌توانند به درجات مختلفی با ویژگی‌های انسانی و وجودی مرتبط شوند، از جمله ویژگی‌های الهی (عرشی) و دنیوی (فرشی) و همچنین از نظر قومی یا ملی (رومی و گشی)."],[911,"از امید عود هر یک بسته طرف","اندرین کاروانسرا از بیم برف","هر یک از مسافران در این کاروانسرا به امید برگشتن و بهبود وضع خود در دل دارند و از ترس سرما و برف، خود را به خواب نمی‌زنند."],[911,"برف گوناگون جمود هر جماد","در شتای بعد آن خورشید داد","برف به اشکال و رنگ‌های مختلف موجب سستی و بی‌حرکتی هر موجودی در زمستان می‌شود، و بعد از تابش خورشید، حیات و نشاط به آن‌ها بازمی‌گردد."],[911,"چون بتابد تف آن خورشید خشم","کوه گردد گاه ریگ و گاه پشم","وقتی شعله خشم آن خورشید بر افروخته می‌شود، کوه گاهی به شکل ریگ درمی‌آید و گاهی به شکل پشم."],[911,"در گداز آید جمادات گران","چون گداز تن به وقت نقل جان","جمادات، که به اشیا و موجودات بی‌جان اشاره دارد، در گرما یا تغییرات شدید تحت تأثیر قرار می‌گیرند و مانند بدن انسان در زمان مرگ یا انتقال روح، دستخوش تغییه می‌شوند. یعنی هر چیزی که سنگین و سخت به نظر می‌رسد، در برابر شرایط خاص نرم و تغییرپذیر می‌شود."],[911,"چون رسیدند این سه همره منزلی","هدیه‌شان آورد حلوا مقبلی","وقتی این سه نفر به منزلی رسیدند، برای آن‌ها هدیه‌ای آوردند که حلوا بود."],[911,"برد حلوا پیش آن هر سه غریب","محسنی از مطبخ انی قریب","حلوا را که چیزی شیرین و خوشمزه است، به سوی آن سه نفر غریب (مسلمان و ترسا و جهود) آوردند، و این حلوا از آشپزخانه‌ای نزدیک تهیه شده بود."],[911,"نان گرم و صحن حلوای عسل","برد آنک در ثوابش بود امل","نان گرم و ظرف حلوای عسلی را برداشتند، زیرا آن مسلمان امید داشت که از این کار ثواب ببرد."],[911,"الکیاسه والادب لاهل المدر","الضیافه والقری لاهل الوبر","هوش و ادب مخصوص اهل شهرها و مهمانی و پذیرایی مختص ساکنان بیابان‌ها و مناطق روستایی است."],[911,"الضیافة للغریب والقری","اودع الرحمن فی اهل القری","مهمان‌نوازی مختص غریبان است و خداوند نعمت‌ها را در دل روستائیان قرار داده است."],[911,"کل یوم فی القری ضیف حدیث","ما له غیر الاله من مغیث","هر روز در روستاها مهمانانی جدید می‌آیند و هیچ‌کس جز خداوند یاری‌کننده‌ای برای آن‌ها نیست."],[911,"کل لیل فی القری وفد جدید","ما لهم ثم سوی الله محید","هر شب در این دیار میهمانان تازه‌ای می‌آیند و به جز خدا هیچ‌کس نمی‌تواند به آنها پناهی دهد."],[911,"تخمه بودند آن دو بیگانه ز خور","بود صایم روز آن مؤمن مگر","دو بیگانه (ترسا و جهود) از خوراک لذت می‌برند، اما آن مؤمن مسلمان که روزه‌دار است، درست ناامید و گرسنه باقی می‌ماند."],[911,"چون نماز شام آن حلوا رسید","بود مؤمن مانده در جوع شدید","هنگامی که وقت نماز شام فرا رسید و آن حلوا (که غذایی لذیذ است) حاضر شد، مؤمن (مسلمان) همچنان در گرسنگی شدید ماند."],[911,"آن دو کس گفتند ما از خور پریم","امشبش بنهیم و فردایش خوریم","آن دو نفر گفتند که ما امشب از این غذا نمی‌خوریم و آن را برای فردا کنار می‌گذاریم تا فردا مصرف کنیم."],[911,"صبر گیریم امشب از خور تن زنیم","بهر فردا لوت را پنهان کنیم","در این بیت، افراد تصمیم می‌گیرند که امشب از خوردن غذا پرهیز کنند و به امید فردا، غذا را برای زمانی دیگر نگه دارند. آنها می‌خواهند راز لذت غذا خوردن را تا فردا پنهان نگه دارند و بزودی به آن دست پیدا کنند."],[911,"گفت مؤمن امشب این خورده شود","صبر را بنهیم تا فردا بود","مؤمن گفت که امشب این غذا خورده شود و صبر را کنار بگذاریم تا فردا نخوریم."],[911,"پس بدو گفتند زین حکمت‌گری","قصد تو آن است تا تنها خوری","آنها به مسلمان گفتند که هدف تو از این حکمت و روشنی که داری، این است که تنها از این غذا بخوری و دیگران را از سهم و بهره خود بی‌نصیب کنی."],[911,"گفت ای یاران نه که ما سه تنیم","چون خلاف افتاد تا قسمت کنیم","مسلمان به دو مسافر دیگرش می‌گوید که ما سه نفر هستیم و وقتی که میان ما اختلاف پیش آمد، بهتر است که آن را حل کنیم و تقسیم کنیم."],[911,"هرکه خواهد قسم خود بر جان زند","هرکه خواهد قسم خود پنهان کند","هر کس که بخواهد، می‌تواند به نام خودش قسم بخورد و جانش را به آن قسم بسپارد، و هر کس دیگر می‌تواند قسم خود را مخفی کند و آن را پنهان سازد."],[911,"آن دو گفتندش ز قسمت در گذر","گوش کن قسام فی‌النار از خبر","آن دو نفر به مسلمان گفتند که از قسمت و تقدیر بگذر و توجه کن که قسام (تقسیم‌کننده) در آتش (درد و عذاب) خبری ندارد."],[911,"گفت قسام آن بود کو خویش را","کرد قسمت بر هوا و بر خدا","قسام کسی است که قسمت و تقسیم را انجام می‌دهد. در اینجا اشاره می‌شود به اینکه او کسی است که بر اساس میل و خواسته خود، قسمت را تعیین می‌کند، نه بر اساس قوانین و اصول الهی."],[911,"ملک حق و جمله قسم اوستی","قسم دیگر را دهی دوگوستی","ملک حق (خدا) و تمامی قسم‌ها از آن اوست. اگر قسم دیگری بدهی، یعنی دروغی بگویی، دوگویی کرده‌ای و خود را به تفرقه دچار کرده‌ای."],[911,"این اسد غالب شدی هم بر سگان","گر نبودی نوبت آن بدرگان","چنین به نظر می‌رسد که اگر آن مسلمان در آن موقعیت قرار نمی‌گرفت و غم نمی‌خورد، ممکن بود او نیز مانند دیگران از نعمت غذایی که برای فردا آماده شده بود استفاده کند. این بیت به پیروزی مسلمان بر رنج و مشکل اشاره می‌کند و می‌گوید او با قدرت ایمانش بر مشکلات پیروز شده است، در حالی که اگر در شرایط متفاوتی قرار می‌گرفت، ممکن بود از دیگران عقب بماند."],[911,"قصدشان آن کان مسلمان غم خورد","شب برو در بی‌نوایی بگذرد","آن‌ها قصدشان این بود که مسلمان به خاطر گرسنگی و فقر شب را بدون غذا بگذراند و غمگین شود."],[911,"بود مغلوب او به تسلیم و رضا","گفت سمعا طاعة اصحابنا","مسلمان که تسلیم و راضی بود، گفت: «ما حرف گوش می‌کنیم و اطاعت می‌کنیم.» این نشان‌دهنده وفاداری و اطاعت او از دوستانش است."],[911,"پس بخفتند آن شب و برخاستند","بامدادان خویش را آراستند","آن‌ها شب را خوابیدند و صبح به پا خواستند و خود را آماده کردند."],[911,"روی شستند و دهان و هر یکی","داشت اندر ورد راه و مسلکی","آن‌ها صورت و دهان‌هایشان را شستند و هر یک مشغول ذکر و دعا و مناسبتی مذهبی خود بودند."],[911,"یک زمانی هر کسی آورد رو","سوی ورد خویش از حق فضل‌جو","روزگاری هر فردی به سمت دعا و ذکر خود می‌رفت و از خداوند طلب بهره و رحمت می‌کرد."],[911,"مؤمن و ترسا جهود و گبر و مغ","جمله را رو سوی آن سلطان الغ","مؤمن، ترسا (مسیحی)، جهود (یهودی) و گبر (زرتشتی) همه به سوی آن خداوند بزرگ و سلطانی که بر همه چیز حکمرانی می‌کند، توجه دارند و به او روی آورده‌اند."],[911,"بلک سنگ و خاک و کوه و آب را","هست واگشت نهانی با خدا","همه چیزهای مادی مانند سنگ، خاک، کوه و آب از نظر ظاهری ساده و بی‌خبر از حقایق عمیق هستند، اما در واقع در دل آنها یک رمز و راز نهانی وجود دارد که به خداوند مرتبط می‌شود."],[911,"این سخن پایان ندارد هر سه یار","رو به هم کردند آن دم یاروار","این صحبت‌ها هیچ‌گاه تمام نمی‌شود و در آن لحظه، هر سه دوست به یکدیگر نگاه کردند."],[911,"آن یکی گفتا که هر یک خواب خویش","آنچ دید او دوش گو آور به پیش","یکی از آن سه نفر گفت که هر یک از ما در خواب خود چیزی دیده است، حالا آنچه را که دیشب دیده‌ایم، بیاوریم و برای دیگران بازگو کنیم."],[911,"هرکه خوابش بهتر این را او خورد","قسم هر مفضول را افضل برد","هر کس خواب بهتری ببیند، او از آن قوت بهره‌مند می‌شود؛ سوگند به این که هر کسی که در مرتبه‌ی پایین‌تری قرار دارد، شخص برتر را همراهی و پیروی می‌کند."],[911,"آنک اندر عقل بالاتر رود","خوردن او خوردن جمله بود","هر کسی که در فهم و عقلش از دیگران برتر باشد، خوردن او، مثل خوردن همه، به حساب می‌آید و مهم نیست که چه غذایی می‌خورد."],[911,"فوق آمد جان پر انوار او","باقیان را بس بود تیمار او","جان پرنور مسلمان به مقام بالایی رسیده و برای افراد ماندگار، نگرانی و درد او کافی است."],[911,"عاقلان را چون بقا آمد ابد","پس به معنی این جهان باقی بود","عاقلان زمانی که بقا و جاودانگی را درک کردند، فهمیدند که این دنیا تنها فانی و ناپایدار است."],[911,"پس جهود آورد آنچ دیده بود","تا کجا شب روح او گردیده بود","جهود (یهودی) چیزی را که دیده بود به آنجا آورد تا ببیند روح او (مسلمان) در شب تا کجا پیش رفته است."],[911,"گفت در ره موسی‌ام آمد به پیش","گربه بیند دنبه اندر خواب خویش","این بیت به این معناست که شخصی در مسیر موسی (پیامبر) حرکت می‌کند و به جلو می‌رود، اما با خواب خود را گم کرده و سرگرم دنبه (چربی یا چربی دمی) شدن است، که نشان‌دهنده غفلت و عدم تمرکز او بر هدف اصلی‌اش می‌باشد."],[911,"در پی موسی شدم تا کوه طور","هر سه‌مان گشتیم ناپیدا ز نور","من در پی موسی (پیامبر) به طرف کوه طور رفتم و هر سه ما تحت تأثیر نور او، ناپیدا شدیم."],[911,"هر سه سایه محو شد زان آفتاب","بعد از آن زان نور شد یک فتح باب","هر سه مسافر در نور آن آفتاب ناپدید شدند و پس از آن، از آن نور یک شروع تازه و مهم به وجود آمد."],[911,"نور دیگر از دل آن نور رست","پس ترقی جست آن ثانیش چست","نور دیگری از دل آن نور برآمد و به همین دلیل، آن نور دوم نیز با سرعت رشد کرد و پیشرفت کرد."],[911,"هم من و هم موسی و هم کوه طور","هر سه گم گشتیم زان اشراق نور","من و موسی و کوه طور هر سه از روشنایی نور الهی گم شده‌ایم."],[911,"بعد از آن دیدم که که سه شاخ شد","چونک نور حق درو نفاخ شد","پس از آن دیدم که نور حق مانند شاخ‌هایی سه‌گانه در آنجا پدیدار شد و به شکلی خیره‌کننده بر زمین تابید."],[911,"وصف هیبت چون تجلی زد برو","می‌سکست از هم همی‌شد سو به سو","زمانی که جلوه عظمت و شکوه خداوند بر او ظاهر می‌شود، هیبت و خوفی از آن تجلی به او دست می‌دهد و همه چیز به‌هم می‌ریزد و دچار آشفتگی می‌شود."],[911,"آن یکی شاخ که آمد سوی یم","گشت شیرین آب تلخ هم‌چو سم","یکی از شاخ‌ها که به سمت دریا آمد، تبدیل به آبی شیرین شد، در حالی که دیگران مانند زهر به تلخی بودند."],[911,"آن یکی شاخش فرو شد در زمین","چشمه دارو برون آمد معین","یکی از شاخه‌های درخت به زمین فرو رفت و از آن، چشمه‌ای بیرون آمد که دارو و درمان‌کننده است."],[911,"که شفای جمله رنجوران شد آب","از همایونی وحی مستطاب","آب، که از منبعی آسمانی و نیکو جاری شده، باعث بهبودی تمام بیماران و رنجوران گردید."],[911,"آن یکی شاخ دگر پرید زود","تا جوار کعبه که عرفات بود","یکی از مسافران به سرعت از آنجا دور شد تا به مکان کعبه برسد که در نزدیکی عرفات قرار دارد."],[911,"باز از آن صعقه چو با خود آمدم","طور بر جا بد نه افزون و نه کم","پس از اینکه از آن حالت صعقه و خطری که به من وارد شد، به هوش آمدم، در کوه طور متوجه شدم که حالتی از من روی داده است که نه به اندازه‌ای زیادتر است و نه به اندازه‌ای کمتر."],[911,"لیک زیر پای موسی هم‌چو یخ","می‌گدازید او نماندش شاخ و شخ","زیر پای موسی، معجزه‌گر، مانند یخ نرم می‌شود و ذوب می‌گردد، به‌طوری که هیچ نشانه‌ای از قوت و استحکام باقی نمی‌ماند."],[911,"با زمین هموار شد که از نهیب","گشت بالایش از آن هیبت نشیب","زمین هموار شد، زیرا از هیبت و قدرت موسی (که به آسمان بالا می‌رفت) ترس بر او چیره شد و در نتیجه او به پایین آمد."],[911,"باز با خود آمدم زان انتشار","باز دیدم طور و موسی برقرار","پس از تفکر و تامل، دوباره به یاد کوه طور و حضرت موسی (پیامبری که بر آن کوه با خداوند راز و نیاز کرد) افتادم که در آن جا حالتی از ارتباط برقرار است."],[911,"وآن بیابان سر به سر در ذیل کوه","پر خلایق شکل موسی در وجوه","این بیابان که در پای کوه قرار دارد، پر از مردم است و چهره‌ها همه شبیه به موسی (پیامبر) است."],[911,"چون عصا و خرقه او خرقه‌شان","جمله سوی طور خوش دامن کشان","چون عصای موسی و لباس او، که همگی به کوه طور (جایی مقدس) اشاره دارند، به زیبایی و احترام به سمت کوه می‌روند."],[911,"جمله کفها در دعا افراخته","نغمه ارنی به هم در ساخته","همه دست‌ها را به دعا بالا برده و نغمه‌ای می‌خوانند که به معنی «خدایا، به ما خودت را نشان بده» است و روح جمعی آنها را به هم متصل کرده است."],[911,"باز آن غشیان چو از من رفت زود","صورت هر یک دگرگونم نمود","زمانی که آن سه مسافر بیهوش شدند و به هوش آمدند، چهره‌ی هر یک از آن‌ها به گونه‌ای تغییر کرد."],[911,"انبیا بودند ایشان اهل ود","اتحاد انبیاام فهم شد","این افراد، پیامبران بودند و به همبستگی و اتحاد بین پیامبران پی بردند."],[911,"باز املاکی همی دیدم شگرف","صورت ایشان بد از اجرام برف","من شاهد فرشتگانی بودم با شکلی شگفت‌انگیز که از جسم و ماده دور بودند."],[911,"حلقه دیگر ملایک مستعین","صورت ایشان به جمله آتشین","حلقه‌ای دیگر از فرشتگان که به کمک می‌آیند، تمام ظاهرشان شبیه به آتش است."],[911,"زین نسق می‌گفت آن شخص جهود","بس جهودی که آخرش محمود بود","این فرد جهود (یهودی) می‌گفت که با این نیت در حال گفتگو است، اما در نهایت به گونه‌ای رفتار می‌کند که شایسته ستایش و تحسین (محمود) است."],[911,"هیچ کافر را به خواری منگرید","که مسلمان مردنش باشد امید","به کسی که کافر است، به خاطر دینش نباید با تحقیر نگاه کرد، زیرا مرگ مسلمانان، امیدی برای رحمت و غفران الهی است."],[911,"چه خبر داری ز ختم عمر او","تا بگردانی ازو یک‌باره رو","تو چه می‌دانی که عمر او چگونه به پایان می‌رسد که می‌خواهی به سرعت از او روی برگردانی و دور شوی؟"],[911,"بعد از ان ترسا در آمد در کلام","که مسیحم رو نمود اندر منام","پس از آن، ترسا (مسیحی) در کلامش گفت که عیسی (مسیح) در خواب به او نشان داده شده است."],[911,"من شدم با او به چارم آسمان","مرکز و مثوای خورشید جهان","من با او به چهارمین آسمان رسیدم که در آن‌جا مرکز و محل قرار خورشید جهان است."],[911,"خود عجب‌های قلاع آسمان","نسبتش نبود به آیات جهان","عجایب و شگفتی‌های آسمان خود به تنهایی قابل مقایسه با نشانه‌ها و آیات این جهان نیستند."],[911,"هر کسی دانند ای فخر البنین","که فزون باشد فن چرخ از زمین","هر کسی باید بداند که ای بهترین پسران، مهارت و علم در حرکت ستاره‌ها و افلاک از علم و فنون زمین بیشتر و بالاتر است."],[912,"اشتر و گاو و قجی در پیش راه","یافتند اندر روش بندی گیاه","شتر و گاو و قج (کچل) در مسیر، در جایی که گیاهی بند شده بود، قرار گرفتند."],[912,"گفت قج بخش ار کنیم این را یقین","هیچ کس از ما نگردد سیر ازین","قج که می‌گوید، اگر بخواهیم این علف را تقسیم کنیم، یقینا هیچ‌یک از ما سه نفر سیر نمی‌شود."],[912,"لیک عمر هرکه باشد بیشتر","این علف اوراست اولی گو بخور","ولی هر کسی که عمرش بیشتر باشد، حقش است که اول از این علف (پیشه) بخورد."],[912,"که اکابر را مقدم داشتن","آمدست از مصطفی اندر سنن","بزرگان و افراد با تجربه را به خاطر احترام و مقامشان در مسائل مهم باید مقدم دانست، که این موضوع از سنت‌های پیامبر اسلام، حضرت محمد، الهام گرفته شده است."],[912,"گرچه پیران را درین دور لئام","در دو موضع پیش می‌دارند عام","هرچند در این زمان، افراد سالخورده و متفکر را در دو مورد خاص مورد احترام قرار می‌دهند، اما در واقع، این نوع احترام به آن‌ها بیشتر به نفع جامعه است تا به اعتبار خودشان."],[912,"یا در آن لوتی که آن سوزان بود","یا بر آن پل کز خلل ویران بود","شاعر به دو موقعیت اشاره می‌کند؛ یکی در مورد «لوتی» (مردی دیوانه یا غیرمتعارف) که ناراحتی و درد را تجربه کرده، و دیگری پل خراب و ویران که ممکن است نشان‌دهنده وضعیتی نامساعد یا ناهموار باشد. در اینجا تأکید بر مشکلات و چالش‌های موجود است."],[912,"خدمت شیخی بزرگی قایدی","عام نارد بی‌قرینه فاسدی","در خدمت استاد بزرگی که حاکم بر گروهی است، آدمی بی‌تنظیم و بی‌وقفه، از ناپاکی و فساد دور نخواهد بود."],[912,"خیرشان اینست چه بود شرشان","قبحشان را باز دان از فرشان","خیر آن‌ها در این است که نفعی برای خودشان داشته باشند، و بدی‌شان این است که از عیب و ناپسندی‌هایشان باید از امتیازهای دیگران آگاه شوند."],[913,"سوی جامع می‌شد آن یک شهریار","خلق را می‌زد نقیب و چوبدار","یک پادشاه به سمت میخانه می‌رفت و در مسیر، نقیب (فرمانده) و چوبدار (مأمور تنبیه) مردم را می‌زد و آزار می‌کرد."],[913,"آن یکی را سر شکستی چوب‌زن","و آن دگر را بر دریدی پیرهن","یک نفر را که بی‌گناه بود با چوب زدند و سرش را شکستند، و دیگری را نیز بی‌سبب مورد ضرب و شتم قرار دادند و لباسش را دریدند."],[913,"در میانه بی‌دلی ده چوب خورد","بی‌گناهی که برو از راه برد","در وسط بی‌دلی، ده نفر بی‌گناه که هیچ خطایی نداشتند، مورد آزار و خشونت قرار گرفتند و اینکه این بی‌گناهی نتوانسته از آسیب‌ها فرار کند."],[913,"خون چکان رو کرد با شاه و بگفت","ظلم ظاهر بین چه پرسی از نهفت","خونی که به زمین ریخته شده است، به دربار شاه رفت و گفت، ای ظلمی که به آسانی آشکار است، مگر از حقیقت نهفته چیزی می‌پرسی؟"],[913,"خیر تو این است جامع می‌روی","تا چه باشد شر و وزرت ای غوی","خیر تو در این است که به زندگی و کار خود ادامه بدهی و به دنبال نتیجه‌های خوب باشی، زیرا نمی‌دانی چه چیزی بدی را به همراه خواهد داشت."],[913,"یک سلامی نشنود پیر از خسی","تا نپیچد عاقبت از وی بسی","پیر که به معنای انسان باتجربه یا حکیم است، هیچ سلامی از انسان بی‌مایه و خسیس نمی‌شنود؛ چراکه نمی‌خواهد در آینده دچار مشکلات و پیچیدگی‌های بی‌فایده‌ای شود که از او برمی‌خیزد."],[913,"گرگ دریابد ولی را به بود","زانک دریابد ولی را نفس بد","اگر گرگ (نماد خطر) درک کند که ولی (ولی خدا یا راهنمای روحانی) خوب است، دلیلش این است که نفس بد (خواسته‌های ناپسند و شر) را می‌شناسد و می‌تواند آن را دریابد."],[913,"زانک گرگ ارچه که بس استمگریست","لیکش آن فرهنگ و کید و مکر نیست","هرچند که گرگ درنده و خطرناک است، اما او از هنر فریب و مکر بی‌بهره است و نمی‌تواند از آنچه که آموخته نشده، استفاده کند."],[913,"ورنه کی اندر فتادی او به دام","مکر اندر آدمی باشد تمام","اگر او (یعنی گرگ) در دام مکر نمی‌افتد، پس باید بدانیم که آدمی به‌طور کامل در دام مکر افتاده است."],[913,"گفت قج با گاو و اشتر ای رفاق","چون چنین افتاد ما را اتفاق","قج، یعنی جماعت یا گروهی، به گاو و شتر اشاره می‌کند و می‌گوید که چگونه چنین واقعه‌ای برای ما پیش آمد. این بیت به نوعی به حادثه یا رویدادی غیرمنتظره اشاره دارد که به‌طور ناخواسته و اتفاقی برای آن‌ها رخ داده است."],[913,"هر یکی تاریخ عمر ابدا کنید","پیرتر اولیست باقی تن زنید","هر فردی برای خود تاریخی از آغاز زندگی‌اش دارد و کسی که پیرتر است، در واقع اولین کسی است که زندگی‌اش را آغاز کرده و دیگران تنها بعد از او به دنیا آمده‌اند."],[913,"گفت قج مرج من اندر آن عهود","با قج قربان اسمعیل بود","او می‌گوید که در زمان‌های دور، او (قج) در زمانی دیگر وجود داشته است که بر قربانی کردن اسماعیل (به فرمان خدا) تأثیر داشته است."],[913,"گاو گفتا بوده‌ام من سال‌خورد","جفت آن گاوی کش آدم جفت کرد","گاو می‌گوید که من نیز سال‌ها پیش، جفت گاوی بوده‌ام که آدم (پدر بشر) او را جفت کرده است."],[913,"جفت آن گاوم که آدم جد خلق","در زراعت بر زمین می‌کرد فلق","منظور از این بیت این است که آن گاوی که آدم (پدر بشر) آن را جفت می‌کند، همان گاوی است که در زمین کشاورزی و زراعت اولیه مورد استفاده قرار می‌گرفت. یعنی اشاره به اهمیت و نقش گاو در زندگی بشر از زمان‌های دور دارد."],[913,"چون شنید از گاو و قج اشتر شگفت","سر فرود آورد و آن را برگرفت","وقتی گاو و قاطر را از اشتر شنید، از تعجب سرش را پایین آورد و آن را برداشت."],[913,"در هوا بر داشت آن بند قصیل","اشتر بختی سبک بی‌قال و قیل","در آسمان، آن بند بار سنگین و زشت شتر را برداشت که با هیچ حرف و سخنی همراه نبود و سبکتر از آنچه تصور می‌شد بود."],[913,"که مرا خود حاجت تاریخ نیست","کین چنین جسمی و عالی گردنیست","من به تاریخ و گواهی نیازی ندارم زیرا این جسم من و گردن بلندم، خود نشان دهنده‌ی شرافت و ارزش من است."],[913,"خود همه کس داند ای جان پدر","که نباشم از شما من خردتر","هر کسی، ای جان پدر (پدر جان)، می‌داند که من از شما کمتر نیستم."],[913,"داند این را هرکه ز اصحاب نهاست","که نهاد من فزون‌تر از شماست","هر کسی که از دوستان و اهل معرفت باشد می‌داند که مقام و موقعیت من از شما بالاتر است."],[913,"جملگان دانند کین چرخ بلند","هست صد چندان که این خاک نژند","همه موجودات می‌دانند که این آسمان بزرگ، به مراتب بیشتر از این زمین بی‌ارزش است."],[913,"کو گشاد رقعه‌های آسمان","کو نهاد بقعه‌های خاکدان","کجاست گشایش‌های آسمان و کجا هستند مکان‌های دفن اجساد در خاک؟"],[914,"پس مسلمان گفت ای یاران من","پیشم آمد مصطفی سلطان من","مسلمان به یارانش می‌گوید که پیامبر اسلام، مصطفی، در پیش او آمده است و او را به عنوان سلطان خود معرفی می‌کند."],[914,"پس مرا گفت آن یکی بر طور تاخت","با کلیم حق و نرد عشق باخت","شخصی به مولانا می‌گوید که بر روی کوه طور (جایی که موسی با خدا صحبت کرد) شتابان رفت و با موسی کلیم (که به موسی کلیم‌الله معروف است) عشق را بازی کرد. این اشاره به علاقه و شیدایی او به خداوند دارد."],[914,"وان دگر را عیسی صاحب‌قران","برد بر اوج چهارم آسمان","عیسی، پیامبری که قرآن را داشت، آن شخص دیگر را به آسمان چهارم برد."],[914,"خیز ای پس مانده دیده ضرر","باری آن حلوا و یخنی را بخور","ای کسی که در زندگی عقب‌مانده و از نظر بینایی ضرر کرده‌ای، بر خیز و از آن حلوا و خوراک خوشمزه لذت ببر."],[914,"آن هنرمندان پر فن راندند","نامه اقبال و منصب خواندند","آن هنرمندان ماهر، نامه خوشبختی و مقام را از آن خود کردند و به دست آوردند."],[914,"آن دو فاضل فضل خود در یافتند","با ملایک از هنر در بافتند","این دو شخصیت برجسته، دانش و فضیلت خود را درک کردند و با ملائک (فرشتگان) از هنر و استعداد خویش پیوند برقرار کردند."],[914,"ای سلیم گول واپس مانده هین","بر جه و بر کاسه حلوا نشین","ای شخص با آرامش، مراقب باش که در دام گذشته نیفتی و بر سر کاسه حلوا (شیرینی) نایستی، بلکه به جلو برو."],[914,"پس بگفتندش که آنگه تو حریص","ای عجیب خوردی ز حلوا و خبیص","آن‌گاه به او گفتند که تو خیلی حریص و عجیب هستی، چونکه از حلوا و خبیص (نوعی غذا) خورده‌ای."],[914,"گفت چون فرمود آن شاه مطاع","من کی بودم تا کنم زان امتناع‌؟","من کی بودم‌ یعنی من که باشم‌؟"],[914,"تو جهود از امر موسی سر کشی‌؟","گر بخواند در خوشی یا ناخوشی‌؟","آیا تو یهودی از دستورهای موسی سرپیچی می‌کنی؟ حتی اگر او در خوشی یا ناخوشی چیزی بگوید؟"],[914,"تو مسیحی هیچ از امر مسیح","سر توانی تافت در خیر و قبیح‌؟","آیا می‌توانی از دستورات و پیام‌های مسیح سرپیچی کنی، چه در کارهای نیک و چه در کارهای بد؟"],[914,"من ز فخر انبیا سر چون کشم‌؟","خورده‌ام حلوا و این دم سرخوشم","من چگونه می‌توانم به فخر و افتخار پیغمبران بال بزنم؟ من که حلاوت لذیذی را چشیده‌ام و اکنون در این لحظه خوشحالم."],[914,"پس بگفتندش که والله خواب‌ راست","تو بدیدی وین به از صد خواب ماست","آنها به او گفتند که سوگند به خدا، خواب حقیقتی که تو دیده‌ای بهتر از صد خواب ماست."],[914,"خواب تو بیداری‌ست ای بو‌بطر","که به بیداری عیان‌ستش اثر","خواب تو، ای بو‌بطر، در واقع بیداری است، زیرا آثار آن در بیداری به‌روشنی پیداست."],[914,"در گذر از فضل و از جهدی و فن","کار خدمت دارد و خلق حسن","انسان در سرگذشت زندگی‌اش، تنها با تلاش و علم و هنر به سرانجام نمی‌رسد، بلکه باید به خدمت به دیگران و زیبایی اخلاق نیز توجه کند."],[914,"بهر این آوردمان یزدان برون","ما خلقت الانس الا یعبدون","خدای بزرگ ما را برای عبادت خلق کرده است و هدف از آفرینش انسان تنها پرستش اوست."],[914,"سامری را آن هنر چه سود کرد‌؟","کان فن از باب اللهش مردود کرد","هنر سامری، کسی که در زمان Moses (موسی) به پرستش گوساله طلا پرداخت، هیچ سودی برای او نداشت، زیرا این کارش از سوی خداوند پذیرفته نشد و رد شد."],[914,"چه کشید از کیمیا قارون‌؟ ببین","که فرو بردش به قعر خود زمین","کیمیا که به طلا و ثروت تبدیل می‌کند، برای قارون چه سودی داشت؟ ببین که این ثروت او را به عمق زمین فرو برد و موجب هلاکتش شد."],[914,"بوالحکم آخر چه بر بست از هنر‌؟","سرنگون رفت او ز کفران در سقر","بوالحکم قبل از انکار اسلام کنیت ابوجهل بود‌، چون اسلام را انکار کرد کنیت او ابوجهل مقرّر کردند. (از آنندراج) (از غیاث)"],[914,"خود هنر آن دارد که دید آتش عیان","نه کپ دل علی النار الدخان","هنر واقعی این است که آتش را به وضوح و به‌صورت عیان ببینی، نه اینکه فقط دلایل و نشانه‌های آن را مانند دود مشاهده کنی."],[914,"ای دلیلت گنده‌تر پیش لبیب","در حقیقت از دلیل آن طبیب","اگر دلیلت برای بیان حقیقت بزرگ‌تر از دلیلی که پزشک (طبیب) دارد، در واقع از عهده تعهد و مسئولیتش بهتر است."],[914,"چون دلیلت نیست جز این ای پسر","گوه می‌خور در کمیزی می‌نگر","اگر دلیل تو تنها همین است، پس مانند گوه بخور و به پشمی که به برکت آن گوه آمده نگاه کن."],[914,"ای دلیل تو مثال آن عصا","در کفت دل علی عیب العمی","تو به مانند عصایی هستی که در دست علی است؛ یعنی دلیل و راهنمای تو در دل، همانند عصای علی برایش، مهم و حیاتی است و می‌تواند او را از گمراهی و کوری نجات دهد."],[914,"غلغل و طاق و طرنب و گیر و دار","که نمی‌بینم مرا معذور دار","من در شلوغی و هرج و مرج و در میان سر و صدا و ازدحام قرار دارم و نمی‌توانم وضعیت بهتری داشته باشم، پس مرا عذر بده."],[915,"سید ترمد که آنجا شاه بود","مسخره او دلقک آگاه بود","سید ملک ترمد که شاه بود، به وسیله دلقک که خبرها را می‌دانست، مورد تمسخر قرار گرفت."],[915,"داشت کاری در سمرقند او مهم","جست‌الاقی تا شود او مستتم","سید ترمد در سمرقند کاری مهم داشت و به دنبال فرصتی بود که اوقاتش را خوش بگذراند و بتواند خود را راضی کند."],[915,"زد منادی هر که اندر پنج روز","آردم زانجا خبر بدهم کنوز","منادی اعلام می‌کند که هر کس در عرض پنج روز از آنجا خبر بیاورد، من به او پاداش خوبی می‌دهم."],[915,"دلقک اندر ده بد و آن را شنید","بر نشست و تا بترمد می‌دوید","دلقک در ده این خبر را شنید و برای اینکه خود را به سید ملک ترمد برساند، به سرعت سوار بر مرکبش شد و می‌دوید."],[915,"مرکبی دو اندر آن ره شد سقط","از دوانیدن فرس را زان نمط","در آن مسیر، به خاطر دویدن اسب، مرکب دلقک از پا افتاد و سقط شد."],[915,"پس به دیوان در دوید از گرد راه","وقت ناهنگام ره جست او به شاه","سپس به دیوان، به دلیل اینکه در میانه راه و در زمان نامناسب، به شاه رسید و به دنبال او دوید."],[915,"فجفجی در جمله دیوان فتاد","شورشی در وهم آن سلطان فتاد","شور و هیاهویی در تمام دیوان (دولت) به‌وجود آمد و خیال آن سلطان را نیز دچار تشویش کرد."],[915,"خاص و عام شهر را دل شد ز دست","تا چه تشویش و بلا حادث شدست","عموم مردم شهر در وضعیت سردرگمی و اضطراب به سر می‌برند و احساس می‌کنند که کنترل و امنیت خود را از دست داده‌اند، زیرا خبرهای نگران‌کننده و بلاهایی که ممکن است بیفتد، باعث تشویش آنها شده است."],[915,"یا عدوی قاهری در قصد ماست","یا بلایی مهلکی از غیب خاست","دشمن قوی و قدرت‌مندی قصد حمله به ما را دارد یا این‌که مصیبت بزرگی از جای ناشناخته‌ای به ما رسیده است."],[915,"که ز ده دلقک به سیران درشت","چند اسپی تازی اندر راه کشت","از ده، دلقکی به سیران (محل نزدیک سمرقند) چندین اسب تازی را در راه کشت."],[915,"جمع گشته بر سرای شاه خلق","تا چرا آمد چنین اشتاب دلق","مردم در کنار درب خانه شاه جمع شده‌اند و می‌پرسند که چرا دلقک (نوازنده) با این شتاب آمده است."],[915,"از شتاب او و فحش اجتهاد","غلغل و تشویش در ترمد فتاد","به سبب شتاب و دشنام او، در ترمد سر و صدا و به هم‌ریختگی زیادی ایجاد شد."],[915,"آن یکی دو دست بر زانوزنان","وآن دگر از وهم واویلی‌کنان","شخصی با یک دست روی زانوهایش نشسته و با دست دیگرش در حال نشان دادن اضطراب و پریشانی است. او از شدت اندوه و ترس، به‌طور غیرقابل کنترلی به خود می‌پیچد."],[915,"از نفیر و فتنه و خوف نکال","هر دلی رفته به صد کوی خیال","هر دلی که به خاطر نگرانی، آشفتگی و ترس در خیالات مختلف سیر می‌کند را از این غوغا و آشفتگی آزاد کن."],[915,"هر کسی فالی همی‌زد از قیاس","تا چه آتش اوفتاد اندر پلاس","هر کس دارد حالتی را که به پیش‌گویی (فال) می‌زند، می‌خواهد بداند چه بلا و مصیبتی در زندگی‌اش روی خواهد داد، همان‌طور که آتش در لباس (پلاس) کسی افتاده است و او را به نگرانی می‌اندازد."],[915,"راه جست و راه دادش شاه زود","چون زمین بوسید گفتش هی چه بود","شاه به سرعت به او راه نشان داد و هنگامی که او به زمین بوسه زد، از او پرسید: «چه موضوعی است؟"],[915,"هرکه می‌پرسید حالی زان ترش","دست بر لب می‌نهاد او که خمش","هر کسی که از آن فرد ترش‌رو حالش را می‌پرسید، او دستش را بر لب می‌گذاشت و سکوت می‌کرد."],[915,"وهم می‌افزود زین فرهنگ او","جمله در تشویش گشته دنگ او","فکر و گمان‌های بی‌اساس از این دانش او باعث شده همه را در نگرانی و اضطراب فرو ببرد."],[915,"کرد اشارت دلق که ای شاه کرم","یک‌دمی بگذار تا من دم زنم","دلقک به شاه بزرگوار می‌گوید که اجازه بده یک لحظه صحبت کنم و چیزی بگویم."],[915,"تا که باز آید به من عقلم دمی","که فتادم در عجایب عالمی","وقتی عقل من دوباره به حالم بازگردد و از شگفتی‌های این دنیا رها شوم، متوجه می‌شوم که در چه وضعی هستم."],[915,"بعد یک ساعت که شه از وهم و ظن","تلخ گشتش هم گلو و هم دهن","پس از گذشت یک ساعت، که شاه تحت تأثیر افکار و وسوسه‌های تلخ قرار گرفت، هم صدای او و هم کلامش دچار تغییر و تلخی شد."],[915,"که ندیده بود دلقک را چنین","که ازو خوشتر نبودش هم‌نشین","شخصی که اینجا صحبت می‌کند، دلقک را این‌گونه توصیف می‌کند که هیچ‌کس را به اندازه او خوشایند و جذاب نمی‌بیند و هیچ‌کس را مانند او به عنوان هم‌نشین نمی‌پسندد."],[915,"دایما دستان و لاغ افراشتی","شاه را او شاد و خندان داشتی","همیشه دستانش را بالا می‌برد و با لحن شادی و خنده، شاه را خوشحال و شاداب نگه می‌داشت."],[915,"آن چنان خندانش کردی در نشست","که گرفتی شه شکم را با دو دست","آن‌قدر او را خندان کردی که شاه با دو دست شکمش را گرفت و نتوانست جلوی خنده‌اش را بگیرد."],[915,"که ز زور خنده خوی کردی تنش","رو در افتادی ز خنده کردنش","او از شدت خنده، بدنش به طور غیرارادی به حالت افتاده در آمده و به زمین افتاده است."],[915,"باز امروز این چنین زرد و ترش","دست بر لب می‌زند کای شه خمش","امروز باز هم او به‌خاطر چیزی ناراحت و غمگین است و به نشانه‌ی آن، دستش را بر لب می‌زند و به شاه می‌گوید که باید آرام باشد."],[915,"وهم در وهم و خیال اندر خیال","شاه را تا خود چه آید از نکال","شاه به شدت در افکار و خیالات غلیظ و تو در تو غرق شده است و نمی‌داند که در نهایت چه بر او می‌گذرد و چه سرنوشتی در انتظارش است."],[915,"که دل شه با غم و پرهیز بود","زانک خوارمشاه بس خون‌ریز بود","دل شاه از غم و درد پر است، زیرا خوارمشاه (دشمنانش) بسیار خون‌ریز و خطرناک هستند."],[915,"بس شهان آن طرف را کشته بود","یا به حیله یا به سطوت آن عنود","بسیاری از شاهان آن سمت را کشته بودند، یا به وسیله فریب و حیله، یا به خاطر قدرت و شدت خودشان."],[915,"این شه ترمد ازو در وهم بود","وز فن دلقک خود آن وهمش فزود","این پادشاه ترمد فقط در خیال وجود دارد و بر اساس فریب دلقک، آن خیال او تقویت شده است."],[915,"گفت زوتر بازگو تا حال چیست","این چنین آشوب و شور تو ز کیست","سید ملک از منادی می‌خواهد که هرچه زودتر وضعیت کنونی را توضیح دهد و بگوید این شور و هیجان به خاطر چه کسی است."],[915,"گفت من در ده شنیدم آنک شاه","زد منادی بر سر هر شاه‌راه","گفت من در ده شنیدم که شاه منادی را در سر هر جاده (شاه‌راه) مقررش کرد تا خبر دهد."],[915,"که کسی خواهم که تازد در سه روز","تا سمرقند و دهم او را کنوز","من کسی را می‌خواهم که بتواند در سه روز به سمرقند برود و من به او هدایایی بدهم."],[915,"من شتابیدم بر تو بهر آن","تا بگویم که ندارم آن توان","من به خاطر تو شتابان و عجله کردم تا بگویم که من توانایی انجام این کار را ندارم."],[915,"این چنین چستی نیاید از چو من","باری این اومید را بر من متن","این سرعت و عجله که از من سر می‌زند، (واکنش من به اومید) نشانه‌ای از حالتی است که فقط از من برمی‌آید."],[915,"گفت شه لعنت برین زودیت باد","که دو صد تشویش در شهر اوفتاد","شه می‌گوید لعنت بر این شتاب و سرعت تو که موجب به وجود آمدن دوصد نگرانی و اضطراب در شهر شده است."],[915,"از برای این قدر خام‌ریش","آتش افکندی درین مرج و حشیش","به خاطر همین مقدار افراد نادان و بی‌تجربه، تو در این بیابان و علف‌های دم‌دستی آتش به راه انداخته‌ای."],[915,"هم‌چو این خامان با طبل و علم","که الاقانیم در فقر و عدم","این افراد نادان مانند کسانی هستند که با طبل و پرچم خود در فقر و بی‌ثمری زندگی می‌کنند و فقط به ظواهر می‌پردازند."],[915,"لاف شیخی در جهان انداخته","خویشتن را بایزیدی ساخته","این بیت به این معناست که شیخی در دنیا ادعای بزرگی و علو مقام کرده است، اما در واقع خود را به مقام بایزید (بایزید بسطامی، عارف بزرگ) نزدیک کرده و به خیال و تصور خود، خود را به او شبیه ساخته است. این نمایش، نمایشی از فریبندگی و خودفریبی است."],[915,"هم ز خود سالک شده واصل شده","محفلی واکرده در دعوی‌کده","او (سالک) به سبب تلاش و خودسازی به مرتبه‌ای از کمال رسیده که در جمع اهل دعوی و جدل، نشسته و به آرامی و با آگاهی در مسائل حق و باطل مشارکت کرده است."],[915,"خانه داماد پرآشوب و شر","قوم دختر را نبوده زین خبر","خانه داماد شلوغ و پرهیاهو شده و خانواده دختر در اثر این خبر نگران و آشفته‌اند."],[915,"ولوله که کار نیمی راست شد","شرطهایی که ز سوی ماست شد","آشفتگی و هیاهو به وجود آمده است زیرا کارها نیمی از آنچه باید انجام شود، به درستی پیش نرفته و شرایطی که ما تعیین کرده‌ایم، برآورده نشده است."],[915,"خانه‌ها را روفتیم آراستیم","زین هوس سرمست و خوش برخاستیم","ما خانه‌ها را تمیز و مرتب کردیم و به خاطر این آرزو و خوشحالی بسیار، شاداب و سرحال به پاخاستیم."],[915,"زان طرف آمد یکی پیغام نی","مرغی آمد این طرف زان بام نی","از آن طرف کسی پیغامی فرستاده است، مانند این که یک مرغ از آن طرف بام به این سمت پرواز کرده باشد."],[915,"زین رسالات مزید اندر مزید","یک جوابی زان حوالیتان رسید","از این پیام‌ها، چیزی بیشتر از این به ما رسیده است که پاسخی از آن منطقه به ما رسید."],[915,"نی ولیکن یار ما زین آگهست","زانک از دل سوی دل لا بد رهست","اما یار ما از این خبر آگاه است، زیرا عشق و محبت، به‌طور طبیعی از دل به دل منتقل می‌شود."],[915,"پس از آن یاری که اومید شماست","از جواب نامه ره خالی چراست","یاری که به او امید داشتید، چرا پاسخی به نامه شما نداده و در واقع از ارتباط معنوی خالی است؟"],[915,"صد نشانست از سرار و از جهار","لیک بس کن پرده زین در بر مدار","بسیاری از نشانه‌ها و علامت‌ها از طریق چشم و گوش وجود دارد، اما اکنون پرده را کنار بزن و در این موضوع بیشتر تأمل نکن."],[915,"باز رو تا قصه آن دلق گول","که بلا بر خویش آورد از فضول","به گذشته برگرد و داستان آن دلقکی را بشنو که به خاطر حرف‌های بی‌خود و اضافی، خود را به دردسر انداخت."],[915,"پس وزیرش گفت ای حق را ستن","بشنو از بنده کمینه یک سخن","وزیر به شاه می‌گوید که از بنده ناچیز خود، یک نکته‌ای را درباره حق بشنود."],[915,"دلقک از ده بهر کاری آمدست","رای او گشت و پشیمانش شدست","دلقک برای کاری از ده آمده است، اما حالا به نظر می‌رسد که نسبت به کارش پشیمان شده است."],[915,"ز آب و روغن کهنه را نو می‌کند","او به مسخرگی برون‌شو می‌کند","دلقک با شوخی و مسخرگی، چیزی که کهنه و خراب شده، مثل آب و روغن، را تبدیل به نو و تازه می‌کند."],[915,"غمد را بنمود و پنهان کرد تیغ","باید افشردن مرورا بی‌دریغ","غم و اندوه را به نمایش می‌گذارد و آن را پنهان می‌کند، برای حل مشکلات و از بین بردن درد و رنج باید بی‌رحمانه عمل کرد."],[915,"پسته را یا جوز را تا نشکنی","نی نماید دل نی بدهد روغنی","تا زمانی که پسته یا جوز را نشکنی، نمی‌توانی دلش را ببینی و از روغن آن بهره‌مند شوی. این به این معنا است که برای رسیدن به حقیقت یا بهره‌مندی از چیزی، باید به عمق آن بروی و ظواهر را کنار بزنی."],[915,"مشنو این دفع وی و فرهنگ او","در نگر در ارتعاش و رنگ او","نشنو که این دفعه او چه می‌گوید، بلکه به تأثیر و حالتی که در چهره و رنگ او دیده می‌شود، توجه کن."],[915,"گفت حق سیماهم فی وجههم","زانک غمازست سیما و منم","خداوند خود را در چهره‌های آنان می‌بیند، زیرا چهره‌ها نشانه‌ها و علامت‌هایی هستند و من نیز یکی از آنها هستم."],[915,"این معاین هست ضد آن خبر","که بشر به سرشته آمد این بشر","این مشخصات و ویژگی‌ها با آن خبر متفاوت است، چون انسان به طور طبیعی و ذاتی به این صورت آفریده شده است."],[915,"گفت دلقک با فغان و با خروش","صاحبا در خون این مسکین مکوش","دلقک با صدای بلند و ناله می‌گوید: ای آقا، این بیچاره را در خون خود غرق نکنید و آزارش ندهید."],[915,"بس گمان و وهم آید در ضمیر","کان نباشد حق و صادق ای امیر","خیلی از تصورات و گمانه‌ها در دل آدمی ایجاد می‌شود که حقیقت وجود ندارد و نباید به آن‌ها توجه کرد، ای امیر."],[915,"ان بعض الظن اثم است ای وزیر","نیست استم راست خاصه بر فقیر","بخشی از گمان‌ورزی گناه است، ای وزیر، به ویژه وقتی که این گمان به فقیران تعلق بگیرد و آنها را مورد قضاوت نادرست قرار دهد."],[915,"شه نگیرد آنک می‌رنجاندش","از چه گیرد آنک می‌خنداندش","سلطان کسی را که به او آسیب می‌زند نمی‌گیرد و مجازات نمی‌کند، اما کسی که او را می‌خنداند و شاد می‌کند، مورد توجه و محبت قرار می‌گیرد."],[915,"گفت صاحب پیش شه جاگیر شد","کاشف این مکر و این تزویر شد","صحبت از این است که شخصی به صاحب (دلقک) می‌گوید که نزد شاه معتبر و محترم شده و حالا حقیقت مکر و فریب او آشکار شده است."],[915,"گفت دلقک را سوی زندان برید","چاپلوس و زرق او را کم خرید","دلقک را به زندان فرستاد و گفتند که او را به خاطر چاپلوسی و نیرنگش کمتر خریدند."],[915,"می‌زنیدش چون دهل اشکم‌تهی","تا دهل‌وار او دهدمان آگهی","شما او را به شدت کتک می‌زنید و صدایش مانند صدای دهل در می‌آید، تا از طریق این صدا، پیام ما را به دیگران برساند."],[915,"تر و خشک و پر و تی باشد دهل","بانگ او آگه کند ما را ز کل","صدای دهل مثل انسان‌ها به همه خبر می‌دهد و در آن خود، هم تفاوت بین خوب و بد وجود دارد و هم قدرتی دارد که ما را از همه چیز آگاه می‌کند."],[915,"تا بگوید سر خود از اضطرار","آنچنان که گیرد این دلها قرار","انسان باید برای بازگو کردن اضطراب و نگرانی‌اش، به گونه‌ای سخن بگوید که دل‌های دیگران آرام شود."],[915,"چون طمانینست صدق و با فروغ","دل نیارامد به گفتار دروغ","وقتی حقیقت و صداقت وجود داشته باشد، انسان با وجود روشنایی دلش نمی‌تواند به گفتن دروغ آرامش پیدا کند."],[915,"کذب چون خس باشد و دل چون دهان","خس نگردد در دهان هرگز نهان","دروغ مانند کاه است و دل همچون دهان کاه، هرگز نمی‌تواند در دهان پنهان بماند."],[915,"تا درو باشد زبانی می‌زند","تا به دانش از دهان بیرون کند","تا زمانی که زبانی (سخن) در درون فرد وجود دارد، او باید از دانش و آگاهی‌های درونش صحبت کند و آن‌ها را بیان کند."],[915,"خاصه که در چشم افتد خس ز باد","چشم افتد در نم و بند و گشاد","خس (علف هرز) وقتی در چشم می‌افتد، به خاطر باد و رطوبت، به طور غیرمنتظره‌ای باعث زحمت و اذیت می‌شود، و در حالی که گاهی در چشم گشاد یا تنگ می‌شود، اثرات منفی‌اش مشخص می‌شود."],[915,"ما پس این خس را زنیم اکنون لگد","تا دهان و چشم ازین خس وا رهد","ما این خس (گیاه بی‌ارزش) را لگد می‌زنیم تا دهان و چشم از این خس (آسیب و رنج) آزاد شود."],[915,"گفت دلقک ای ملک آهسته باش","روی حلم و مغفرت را کم‌خراش","دلقک به ملک می‌گوید که آرام‌تر باشد و تحمل و بخشش خود را کمتر خدشه‌دار کند."],[915,"تا بدین حد چیست تعجیل نقم","من نمی‌پرم به دست تو درم","چرا اینقدر شتاب می‌کنی؟ من دستم به تو نمی‌رسد و نمی‌توانم از تو چیزی بگیرم."],[915,"آن ادب که باشد از بهر خدا","اندر آن مستعجلی نبود روا","ادبی که برای خدا و با نیت خالص انجام می‌شود، در آن شتاب‌زدگی جایز نیست."],[915,"وآنچ باشد طبع و خشم و عارضی","می‌شتابد تا نگردد مرتضی","آنچه که به خاطر و خشم و حادثه مربوط می‌شود، به سرعت وارد عمل می‌شود و تا زمانی که مرتضی (علی) به این حال نرسد، این وضعیت باقی است."],[915,"ترسد ار آید رضا خشمش رود","انتقام و ذوق آن فایت شود","اگر رضا و خشنودی الهی به انسان برسد، او از عذاب و انتقام الهی می‌ترسد و لذتی که از این خشنودی به دست می‌آورد نیز از میان می‌رود."],[915,"شهوت کاذب شتابد در طعام","خوف فوت ذوق هست آن خود سقام","عطش و شهوت دروغین، انسان را به خوردن غذای زیاد وادار می‌کند، اما ترس از اینکه نکند از لذت واقعی بیفتد، به دردسر و بیماری منتهی می‌شود."],[915,"اشتها صادق بود تاخیر به","تا گواریده شود آن بی‌گره","اشتهای واقعی تا زمانی که صادقانه و درست باشد، به تعویق می‌افتد تا غذا به خوبی هضم و جذب شود و بدون مشکل و نقص شود."],[915,"تو پی دفع بلایم می‌زنی","تا ببینی رخنه را بندش کنی","تو برای دفع بلا دارم تلاش می‌کنی تا بتوانی راه نفوذ آن را ببندی."],[915,"تا از آن رخنه برون ناید بلا","غیر آن رخنه بسی دارد قضا","تا زمانی که بلا از آن رخنه خارج نشده، قضا و سرنوشت راه‌های دیگری برای ورود بلا دارد."],[915,"چاره دفع بلا نبود ستم","چاره احسان باشد و عفو و کرم","دفع بلا و خطر تنها با ستم و ظلم امکان‌پذیر نیست، بلکه باید با احسان، بخشش و نیکی این مشکلات را حل کرد."],[915,"گفت الصدقه مرد للبلا","داو مرضاک به صدقه یا فتی","گفتند صدقه دادن، راهی برای دور کردن بلا و بیماری است، پس ای جوان، با صدقه‌دادن از مشکلات خود و دیگران نجات پیدا کن."],[915,"صدقه نبود سوختن درویش را","کور کردن چشم حلم‌اندیش را","صدقه، اگر به بهانه‌های نادرست باشد، مانند این است که درویش را بسوزانیم یا چشم کسی را که در انتظار درک روشن است، کور کنیم."],[915,"گفت شه نیکوست خیر و موقعش","لیک چون خیری کنی در موضعش","شاه می‌گوید که جایگاه او خوب و مناسب است، اما اگر کاری نیک انجام دهی، باید در جای درست و در موقعیت مناسبش انجام گیرد."],[915,"موضع رخ شه نهی ویرانیست","موضع شه اسپ هم نادانیست","جایی که چهره‌ی شاه قرار می‌گیرد، ویران است و مناسب نیست، و جایی که شاه سوار بر اسب می‌شود، نیز جای نادانی و ناپختگی است."],[915,"در شریعت هم عطا هم زجر هست","شاه را صدر و فرس را درگه است","در دین و شریعت، هم بخشش و عطا وجود دارد و هم تنبیه و زجر. پادشاه عالی‌ مقام و اسب نیکو، هر دو در جایگاه مناسب خود قرار دارند."],[915,"عدل چه بود وضع اندر موضعش","ظلم چه بود وضع در ناموقعش","عدل وقتی تحقق می‌یابد که هر چیز در جای مناسب خود قرار گیرد، و ظلم زمانی است که چیزی در جای نامناسب خود قرار داشته باشد."],[915,"نیست باطل هر چه یزدان آفرید","از غضب وز حلم وز نصح و مکید","هر چیزی که خداوند (یزدان) آفریده باطل نیست، اعم از غضب، حلم (خویشتنداری) و نصح (پند و نصیحت) یا مکید (عذاب و کیفر)."],[915,"خیر مطلق نیست زینها هیچ چیز","شر مطلق نیست زینها هیچ نیز","هیچ چیز از این عالم به خودی خود خوب مطلق نیست و نیز هیچ چیز به طور کامل بد نیست. همه چیز نسبی و وابسته به شرایط و دیدگاه انسان‌هاست."],[915,"نفع و ضر هر یکی از موضعست","علم ازین رو واجبست و نافعست","سود و زیان هر کدام به شرایط و موضع خاص خود بستگی دارد، از این رو دانایی درباره این موضوع واجب و مفید است."],[915,"ای بسا زجری که بر مسکین رود","در ثواب از نان و حلوا به بود","بسیاری از دردها و رنج‌ها که بر فقیرها می‌رسد، در عوض عمل نیک و خیری که انجام می‌دهند، برایشان پاداشی بزرگتر از نان و حلوا خواهد بود."],[915,"زانک حلوا بی‌اوان صفرا کند","سیلیش از خبث مستنقا کند","زیرا حلوا بدون پاداش و مزد، باعث صفرا و ناراحتی می‌شود و سیلی زدن به مسکین از بدی‌هایی که او را احاطه کرده، او را رها می‌کند."],[915,"سیلیی در وقت بر مسکین بزن","که رهاند آنش از گردن زدن","به یکی از افرادی که در شرایط سخت و بی‌پناهی به سر می‌برد، کمکی کن تا او را از آن خطر نجات دهی. این کمک می‌تواند به شکل حرفی دلگرم‌کننده یا عملی حمایتگر باشد که او را از موقعیت ناگواری که در آن قرار دارد، رها کند."],[915,"زخم در معنی فتد از خوی بد","چوب بر گرد اوفتد نه بر نمد","آسیب و درد به معنای واقعی به کسی می‌رسد که ذات بد و خوی زشتی دارد؛ مانند اینکه چوب بر زمین می‌افتد و به نمد لطمه نمی‌زند."],[915,"بزم و زندان هست هر بهرام را","بزم مخلص را و زندان خام را","بزم و زندان برای هر شخصی متفاوت است؛ بهرام (که ممکن است نماد قدرت و پادشاهی باشد) برای کسانی که آزاد و مخلص هستند، بزم (شادی و خوشی) را دارد، اما برای کسانی که در جهل و خامی هستند، زندان (تنگنای مشکلات و محدودیت‌ها) به حساب می‌آید."],[915,"شق باید ریش را مرهم کنی","چرک را در ریش مستحکم کنی","برای داشتن چهره‌ای زیبا و دل‌پذیر، باید زشتی‌ها را از میان برداشت و زخم‌های صورت را درمان کرد. در این بیت به ضرورت توجه به ظواهر و بهبود ظاهر اشاره شده است."],[915,"تا خورد مر گوشت را در زیر آن","نیم سودی باشد و پنجه زیان","اگر چربی زیر گوشت را نگیری، فایده‌ای نخواهد داشت و در نهایت فقط به ضرر می‌رسد."],[915,"گفت دلقک من نمی‌گویم گذار","من همی‌گویم تحریی بیار","دلقک می‌گوید که من نمی‌خواهم فقط بگویم که چیزی گذشته و تمام شده، بلکه قصدم این است که اطلاعات جدیدی بیاورم و وضعیت را به تأخیر بیندازم."],[915,"هین ره صبر و تانی در مبند","صبر کن اندیشه می‌کن روز چند","به واکنش و عکس‌العمل عجولانه نپرداز و از صبر و تانی غافل نشو؛ روزها را بشمار و با اندیشه عمل کن."],[915,"در تانی بر یقینی بر زنی","گوش‌مال من بایقانی کنی","در انتظار و تامل بر چیزی که به آن یقین داری، گوش‌مال کن؛ مقصود این است که خود را آماده کن تا به طور مطمئن و با آرامش به آن هدف برسی."],[915,"در روش یمشی مکبا خود چرا","چون همی‌شاید شدن در استوا","اگر انسان طبق دستور و راهی که مشخص است حرکت کند، چرا باید خود را دچار مشکل کند و در مسیرهای دشوار بیفتد؟ این اشاره به اهمیت پیروی از راه‌های مستقیم و منطقی دارد."],[915,"مشورت کن با گروه صالحان","بر پیمبر امر شاورهم بدان","برای انجام کارها و تصمیم‌گیری‌ها، با افراد نیکو و صالح مشورت کن و از پیامبر هم بخواه که تو را در این راه یاری کند."],[915,"امرهم شوری برای این بود","کز تشاور سهو و کژ کمتر رود","هدف از مشورت و گفتگو در میان افراد صالح این است که اشتباهات و خطای تصمیم‌گیری‌ها کاهش یابد."],[915,"این خردها چون مصابیح انورست","بیست مصباح از یکی روشن‌ترست","عقل‌ها مانند چراغ‌های روشنی‌بخش هستند و از میان آن‌ها، بعضی از آن‌ها روشن‌تر و دارای نور بیشتری از دیگران هستند."],[915,"بوک مصباحی فتد اندر میان","مشتعل گشته ز نور آسمان","چنان‌که فرض کن چراغی در میان بیفتد و از نور آسمان روشن و درخشان شود."],[915,"غیرت حق پرده‌ای انگیختست","سفلی و علوی به هم آمیختست","غیرت خداوند پرده‌ای بر افراشته که عالم مادی (سفلی) و عالم روحانی (علوی) را به هم درآورده است."],[915,"گفت سیروا می‌طلب اندر جهان","بخت و روزی را همی‌کن امتحان","بروید و در دنیا سیر کنید تا بخت و روزی خود را جست‌وجو کنید و آن را بیازمائید."],[915,"در مجالس می‌طلب اندر عقول","آن چنان عقلی که بود اندر رسول","در مجلس‌ها، بینش و تفکر را جستجو کن، آن نوع از دانشی که در رسول الهی وجود دارد."],[915,"زانک میراث از رسول آنست و بس","که ببیند غیبها از پیش و پس","تنها همان میراثی از پیامبر (حضرت محمد) وجود دارد که به سبب آن، انسان می‌تواند آینده و گذشته را ببیند و از غیب آگاه شود."],[915,"در بصرها می‌طلب هم آن بصر","که نتابد شرح آن این مختصر","باید در چشمان خود به دنبال بصیرتی باشی که از توجیهات کوتاه و مختصر فراتر برود و حقیقت را به درستی ببیند."],[915,"بهر این کردست منع آن با شکوه","از ترهب وز شدن خلوت به کوه","برای اینکه بتواند از این انزوای غربت پرهیز کند و از تنهایی خارج شود، باید اجتناب کند از دوری از دیگران و برقراری ارتباط با جامعه و اجتماع."],[915,"تا نگردد فوت این نوع التقا","کان نظر بختست و اکسیر بقا","برای اینکه این نوع اجتماع و دیدار به هدر نرود، باید به آن توجه کرد، زیرا این ملاقات به دلیل خوش‌شانسی و به عنوان عامل جاودانگی است."],[915,"در میان صالحان یک اصلحیست","بر سر توقیعش از سلطان صحیست","در میان افراد نیکوکار، فردی وجود دارد که از سوی سلطان بر او فرمانی صادر شده است و همان فرمان نشانه‌ای از حقیقت و درستکاری اوست."],[915,"کان دعا شد با اجابت مقترن","کفو او نبود کبار انس و جن","دعا و خواسته‌اش مورد پاسخ و پذیرش قرار گرفت، اما هیچ همتایی برای او در بین انسان‌ها و اجنه وجود ندارد."],[915,"در مری‌اش آنک حلو و حامض است","حجت ایشان بر حق داحض است","در حالتی که در غذای او هم شیرین و هم ترش وجود دارد، دلیل و برهان آنها بر حقیت و راستی نادرست و بی‌اعتبار است."],[915,"که چو ما او را به خود افراشتیم","عذر و حجت از میان بر داشتیم","وقتی ما او را به خودمان بلند کردیم، عذر و بهانه برای دیگران از بین رفت."],[915,"قبله را چون کرد دست حق عیان","پس تحری بعد ازین مردود دان","وقتی خداوند به وضوح هدف (قبله) را مشخص کرد، دیگر برای دنبال کردن نشانه‌های ناچیز و بی‌ارزش (تحری) دلیل و توجیهی وجود ندارد و باید آنها را رد کرد."],[915,"هین بگردان از تحری رو و سر","که پدید آمد معاد و مستقر","به خود بیا و از روی خودت و از تحری (ظاهرا اشاره به چیزی است که انسان را از حقیقت دور می‌کند) دور شو، چرا که معاد (زندگی پس از مرگ) و جایگاه اصلی حقیقت آشکار شده است."],[915,"یک زمان زین قبله گر ذاهل شوی","سخره هر قبله باطل شوی","اگر مدتی از قبله حق (خدا) فاصله بگیری و به حقایق و ایمان خود پشت کنی، به سخره و تمسخر همۀ قبله‌های باطل (غیرالهی) درمی‌آیی و چهره آن‌ها را نیز تحقیر می‌کنی."],[915,"چون شوی تمییزده را ناسپاس","بجهد از تو خطرت قبله‌شناس","زمانی که انسان به طور کامل خود را از پاکی و درستی دور کند و ناسپاس شود، از تو دور می‌شود و به سمت قبله‌ای که از حقیقت دور است، می‌رود."],[915,"گر ازین انبار خواهی بر و بر","نیم‌ساعت هم ز همدردان مبر","اگر می‌خواهی از این انبار (منبع یا کانون محبت و دوستی) بهره‌مند شوی، حتی برای نیم‌ساعت هم همدردان و همراهان را از خود دور نکن."],[915,"که در آن دم که ببری زین معین","مبتلی گردی تو با بئس القرین","زمانی که از زین معین، که نماد خوشبختی و شادکامی است، جدا شوی، دچار بدی‌ها و مشکلات خواهی شد و هم‌نشینی بدی‌ها نصیبت می‌شود."],[916,"از قضا موشی و چغزی با وفا","بر لب جو گشته بودند آشنا","بصورت تصادفی، موش و چغزی وفادار در کنار آب، یکدیگر را ملاقات کرده و با هم آشنا شده بودند."],[916,"هر دو تن مربوط میقاتی شدند","هر صباحی گوشه‌ای می‌آمدند","موش و چغز (نوعی پرنده) به هم وابسته شده بودند و هر صبح در گوشه‌ای مشخص ظاهر می‌شدند."],[916,"نرد دل با هم‌دگر می‌باختند","از وساوس سینه می‌پرداختند","این دو موجود به هم دل بسته و با هم دوستی می‌کردند، اما وسوسه‌ها و تردیدهای درونیشان باعث می‌شد که از یکدیگر دور شوند و هر یک به افکار منفی بپیوندند."],[916,"هر دو را دل از تلاقی متسع","هم‌دگر را قصه‌خوان و مستمع","هر دو طرف (موش و چغز) به خاطر نزدیکی و پیوندی که پیدا کرده‌اند، دلشان به هم می‌تپد و هرکدام دیگری را مانند یک داستان گوش می‌دهد و روایت او را می‌شنود."],[916,"رازگویان با زبان و بی‌زبان","الجماعه رحمه را تاویل دان","رازگویان، چه کسانی که سخن می‌گویند و چه کسانی که خاموشند، به تفسیر و معنی \"رحمت\" الهی می‌پردازند."],[916,"آن اشر چون جفت آن شاد آمدی","پنج ساله قصه‌اش یاد آمدی","این بیت به یادآوری یک داستان قدیمی اشاره دارد که زمانی شاد بوده و به نظر می‌رسد که پس از گذشت پنج سال هنوز خاطره آن داستان در ذهن فرد باقی مانده است. این اشاره به نوعی پیوند عاطفی و ذهنی با گذشته دارد که از سال‌ها پیش در خاطر گوینده زنده است."],[916,"جوش نطق از دل نشان دوستیست","بستگی نطق از بی‌الفتیست","بیان کردن احساسات و افکار از دل، نشانه‌ی دوستی و محبت است، اما اگر ارتباطی از محبت و الفت نباشد، این بیان به شدت محدود می‌شود و به نوعی وابستگی بی‌محتوا تبدیل می‌شود."],[916,"دل که دلبر دید کی ماند ترش","بلبلی گل دید کی ماند خمش","هرگاه دل، محبوب را ببیند، نمی‌تواند غمگین و ناراحت بماند و در زمانه‌ای که بلبل زیبایی گل را می‌بیند، دیگر سکوت نمی‌کند و شادمانه نغمه سر می‌دهد."],[916,"ماهی بریان ز آسیب خضر","زنده شد در بحر گشت او مستقر","ماهی که به دست خضر (پیامبری که به آن زنده کردن مردگان شهرت دارد) سرخ شده و پخته بود، دوباره زنده شد و در دریا جای خود را پیدا کرد."],[916,"یار را با یار چون بنشسته شد","صد هزاران لوح سر دانسته شد","وقتی دو دوست با هم نشسته و به گفتگو می‌پردازند، هزاران حقیقت و دانش میان آن‌ها آشکار می‌شود که مانند لوح‌هایی از دانایی است."],[916,"لوح محفوظ است پیشانی یار","راز کونینش نماید آشکار","وجود یار، مانند لوح محفوظ است که رازهای آفرینش را نشان می‌دهد. این یار می‌تواند به محتوای الهی یا حقیقت وجود اشاره داشته باشد که همه چیز را در خود دارد و گنجینه‌ای از حکمت و معرفت است."],[916,"هادی راهست یار اندر قدوم","مصطفی زین گفت اصحابی نجوم","یار (خدا) راهنمایی است که در قدم‌های پیامبر (مصطفی) نور هدایت را به همراه دارد؛ بنابراین، این اصحاب (پیامبر) مانند ستاره‌ها هستند که در تاریکی راه را نشان می‌دهند."],[916,"نجم اندر ریگ و دریا رهنماست","چشم اندر نجم نه کو مقتداست","ستاره در میان ریگ و دریا راهنمای خوبی است؛ چشم باید به ستاره بدوزد، نه به کوه (یعنی به چیزهای ناپیدا و نادرست)."],[916,"چشم را با روی او می‌دار جفت","گرد منگیزان ز راه بحث و گفت","چشمانت را به روی او (خدا) متوجه کن و از مناظره و گفتگوهای بیهوده دوری کن."],[916,"زانک گردد نجم پنهان زان غبار","چشم بهتر از زبان با عثار","چون غبار، ستاره‌ها را پنهان می‌کند، پس چشم (نگاه) برای درک بهتر از زبان و کلامی که نادرست است، کارایی بیشتری دارد."],[916,"تا بگوید او که وحیستش شعار","کان نشاند گرد و ننگیزد غبار","این بیت بیان می‌کند که وحی، نشانه‌ای است که حقایق را روشن می‌سازد و اجازه نمی‌دهد چیزی که ناپاک و غبارآلود است، بر آن اثر بگذارد. در واقع، وحی موجب می‌شود که حقیقت بدون آلودگی و خرافات نمایان شود."],[916,"چون شد آدم مظهر وحی و وداد","ناطقه او علم الاسما گشاد","زمانی که آدم (به عنوان مظهر وحی و محبت خداوند) به‌وجود آمد، زبان او به سوی علم و نام‌ها گشوده شد و توانست به کلام و علم نسبت به همه چیز دست یابد."],[916,"نام هر چیزی چنانک هست آن","از صحیفه دل روی گشتش زبان","هر چیزی که به نام شناخته می‌شود، همان‌طور که هست، از دل و وجود واقعی‌اش بیرون می‌آید و از طریق زبان بیان می‌شود."],[916,"فاش می‌گفتی زبان از ریتش","جمله را خاصیت و ماهیتش","به وضوح بیان می‌کردی که زبان به سبب ویژگی‌های خود، ماهیت و خاصیت تمام چیزها را مشخص می‌کند."],[916,"آنچنان نامی که اشیا را سزد","نه چنانک حیز را خواند اسد","هر چیزی باید نامی داشته باشد که به ذات و ویژگی‌های آن اشاره کند، نه اینکه نام‌هایی برای آن‌ها انتخاب شود که با ماهیت واقعی‌شان تناسب نداشته باشد، مانند اینکه حیوانی را که در واقع شیر است با نامی دیگر بخوانند."],[916,"نوح نهصد سال در راه سوی","بود هر روزیش تذکیر نوی","نوح (پیامبری که در قرآن از او یاد شده) نهصد سال در تلاش بود تا مردم را به سوی خدا هدایت کند و هر روزی که می‌گذشت، مثل یک یادآوری برای آن‌ها می‌نویشت."],[916,"لعل او گویا ز یاقوت القلوب","نه رساله خوانده نه قوت القلوب","لعل (نوعی سنگ قیمتی) او مانند یاقوت (سنگ قیمتی خوش‌رنگ) در دل‌ها زیبا و درخشان است، اما او نه به نوشته‌ای (رساله) آشناست و نه از علم و قدرت روح سودی برده است."],[916,"وعظ را ناموخته هیچ از شروح","بلک ینبوع کشوف و شرح روح","این بیت می‌گوید که واعظ (نیکوگو) هیچ چیزی از معانی و تفسیرهای عمیق نیاموخته است، بلکه منبعی از کشف و درک روحانی را در اختیار دارد که از آن بهره‌مند می‌شود."],[916,"زان میی کان می چو نوشیده شود","آب نطق از گنگ جوشیده شود","از آن می‌ای که چون نوشیده شود، کلامی به وجود می‌آید که از جماعتی بدون آگاهی و ناشنوا صادر می‌شود."],[916,"طفل نوزاده شود حبر فصیح","حکمت بالغ بخواند چون مسیح","نوزاد، آگاه و فصیح می‌شود و می‌تواند حکمت‌های عمیق را بخواند و بیان کند، همان‌طور که مسیح در علم و آگاهی برجسته بود."],[916,"از کهی که یافت زان می خوش‌لبی","صد غزل آموخت داود نبی","داود نبی از کی گذشته است که صد غزل را از زیبایی آن می‌نوشد و می‌آموزد."],[916,"جمله مرغان ترک کرده چیک چیک","هم‌زبان و یار داود ملیک","تمام پرندگان، صدای چیک چیک را ترک کرده و هم‌صدا و هم‌راستای داود، پادشاه و نبی، شده‌اند."],[916,"چه عجب که مرغ گردد مست او","هم شنود آهن ندای دست او","چقدر عجیب است که این پرنده برای او (یعنی داود) مست می‌شود و صدای آهنگ و ندا (دعوت) او را می‌شنود."],[916,"صرصری بر عاد قتالی شده","مر سلیمان را چو حمالی شده","باد صرصر (باد تند و خرما) بر عاد (قوم عاد، قومی باستانی) مانند جنگجو و قهرمانی قوی و پرقدرت شده است و حالا سلیمان (پیامبر و پادشاه) را مانند یک بارکش ساده و معمولی به دوش می‌کشد."],[916,"صرصری می‌برد بر سر تخت شاه","هر صباح و هر مسا یک ماهه راه","هر بامداد و هر شام، باد زورمندی بر سر تخت سلیمان، پادشاه، او را می‌برد و به مدت یک ماه، مسیر خاصی را طی می‌کند."],[916,"هم شده حمال و هم جاسوس او","گفت غایب را کنان محسوس او","به خاطر ارتباط با غایب (آن کسی که حضور ندارد)، هم بارکش (حمال) شده و هم در حال تجسس (جاسوس) است. او می‌گوید که غایب را به‌گونه‌ای درک می‌کند که انگار حضور دارد."],[916,"باد دم که گفت غایب یافتی","سوی گوش آن ملک بشتافتی","وقتی که باد دم، گفت تو غایب را یافتید، آن ملک به سوی گوش شما شتاب کرد تا این خبر را بشنود."],[916,"که فلانی این چنین گفت این زمان","ای سلیمان مه صاحب‌قران","این شخص در حال حاضر به این شیوه صحبت کرد، ای سلیمان، تو که صاحب اقتدار و فرمانروایی هستی."],[917,"این سخن پایان ندارد گفت موش","چغز را روزی که ای مصباح هوش","موش می‌گوید که این صحبت‌ها هرگز به پایان نمی‌رسد و در روزی به چغز (یا موش) می‌گوید که ای چراغ دانایی و هوش، باید بدانیم که باید به یاد تو بود."],[917,"وقتها خواهم که گویم با تو راز","تو درون آب داری ترک‌تاز","زمانی که بخواهم با تو رازهایم را بگویم، تو در درون آب در حال حرکت و ناپدیدی."],[917,"بر لب جو من ترا نعره‌زنان","نشنوی در آب ناله عاشقان","اگر من در کنار جوی باشم و به طرف تو فریاد بزنم، تو صدای من را نخواهی شنید، چون در آب، صداهای عاشقان به گوش نمی‌رسد."],[917,"من بدین وقت معین ای دلیر","می‌نگردم از محاکات تو سیر","ای دلیر، در این زمان مشخص، از تماشای رفتار تو سیر و خسته شده‌ام."],[917,"پنج وقت آمد نماز و رهنمون","عاشقان را فی صلاة دائمون","پنج وقت نماز در روز مقرر است و اهل عشق همیشه در حال راز و نیاز با خداوند هستند."],[917,"نه به پنج آرام گیرد آن خمار","که در آن سرهاست نی پانصد هزار","خمار (مست) نمی‌تواند به آرامش برسد، حتی اگر پنج بار یا حتی پانصد هزار بار هم برایش دعا و نیایش شود، زیرا عشق و شوقی که در دل‌هاست، قابل توصیف نیست."],[917,"نیست زر غبا وظیفه عاشقان","سخت مستسقیست جان صادقان","زری که باید برای تأمین عشق و عاشقان استفاده شود، در واقع وظیفه آن‌ها نیست، بلکه این جان‌های پاک و صادق هستند که در این عرصه باید طلب کنند و به شدت در پی وصل و زیبایی هستند."],[917,"نیست زر غبا وظیفه ماهیان","زانک بی‌دریا ندارند انس جان","وظیفه ماهیان این نیست که زر را بگیرند و به دنبال غنیمت بروند، چرا که آنها بدون دریا نمی‌توانند زندگی کنند و از آن جدا هستند و این موضوع برایشان اهمیت ندارد."],[917,"آب این دریا که هایل بقعه‌ایست","با خمار ماهیان خود جرعه‌ایست","این دریا که مانند مکانی مقدس است، برای ماهیان به مانند حالتی مست‌کننده و خمارگونه است، که هر کدام از آن‌ها تنها جزیی از روح خود را در آن می‌یابند."],[917,"یک دم هجران بر عاشق چو سال","وصل سالی متصل پیشش خیال","یک لحظه فاصله و دوری از معشوق برای عاشق، به‌اندازه‌ای دشوار و سخت است که یک سال وصال و نزدیکی را در نظر می‌گیرد و بر او سنگینی می‌کند."],[917,"عشق مستسقیست مستسقی‌طلب","در پی هم این و آن چون روز و شب","عشق مانند کسی است که دچار بیماری تشنگی شده و دائم در جستجوی آب است. او به دنبال این است که از دیگری سیراب شود، همان‌طور که روز و شب پیوسته به هم متصل هستند."],[917,"روز بر شب عاشقست و مضطرست","چون ببینی شب برو عاشق‌ترست","شب عاشق و مضطر است، و روز بر او می‌گذرد. وقتی که تو شب را می‌بینی، عشقش به تو بیشتر می‌شود."],[917,"نیستشان از جست‌وجو یک لحظه‌ایست","از پی همشان یکی دم ایست نیست","این افراد از جست‌وجو و تلاش برای یافتن یکدیگر لحظه‌ای هم نمی‌ایستند و پیوسته در حال حرکتند."],[917,"این گرفته پای آن آن گوش این","این بر آن مدهوش و آن بی‌هوش این","این یکی به پای دیگری گره خورده و آن یکی در حال شنیدن صدای اوست. در واقع، این‌ها به شدت به هم وابسته‌اند؛ یکی آنقدر مجذوب دیگری است که هوش و حواسش را از دست داده است."],[917,"در دل معشوق جمله عاشق است","در دل عذرا همیشه وامق است","در دل معشوق، تمام عاشق‌ها وجود دارند و عذرا (عزیز) همیشه با وامق (عاشق) است. این بیت به ارتباط عمیق و تنگاتنگ عاشق و معشوق اشاره دارد."],[917,"در دل عاشق به جز معشوق نیست","در میانشان فارق و فاروق نیست","در دل عاشق، غیر از معشوقش، هیچ چیزی وجود ندارد و هیچ چیز دیگری نمی‌تواند بین آن‌ها جدایی بیندازد."],[917,"بر یکی اشتر بود این دو درا","پس چه زر غبا بگنجد این دو را","این دو نفر بر روی یک شتر سوار هستند، پس چطور می‌توانند در دل خود از زر و زرق و برق (یا ثروت) بگویند و خودشان را بزرگتر از آنچه که هستند، تصور کنند؟"],[917,"هیچ کس با خویش زر غبا نمود","هیچ کس با خود به نوبت یار بود","هیچ کس با خودش در پنهانی و خفا به جمع آوری ثروت و زر نپرداخت و هیچ کس با خود به نوبت یاری نداشت."],[917,"آن یکیی نه که عقلش فهم کرد","فهم این موقوف شد بر مرگ مرد","فهمیدن این موضوع به عقل بستگی ندارد و عقل نمی‌تواند آن را درک کند، بلکه درک این مسأله نیازمند مرگ و گذر از حیات دنیوی است."],[917,"ور به عقل ادراک این ممکن بدی","قهر نفس از بهر چه واجب شدی","اگر به عقل بفهمی که این امکان وجود دارد، پس به چه دلیل قهری که نفس دارد، واجب شده است؟"],[917,"با چنان رحمت که دارد شاه هش","بی‌ضرورت چون بگوید نفس کش","با آن رحمت بزرگی که شاه (خدا) دارد، نیازی نیست که به او چیزی بگوییم؛ حتی وقتی نفس می‌کشیم، او از حال ما آگاه است."],[918,"گفت کای یار عزیز مهرکار","من ندارم بی‌رخت یک‌دم قرار","ای یار گران‌قدر، کسی که محبت می‌کنی، من بدون دیدن تو حتی برای یک لحظه هم آرامش ندارم."],[918,"روز نور و مکسب و تابم توی","شب قرار و سلوت و خوابم توی","در روز، نور وجود و تلاش من تو هستی و در شب، آرامش و خواب من تویی."],[918,"از مروت باشد ار شادم کنی","وقت و بی‌وقت از کرم یادم کنی","اگر تو با بزرگواری من را شاد کنی، چه در وقت مشخصی و چه در هر زمانی، این نشانه‌ای از کرم و جوانمردی تو خواهد بود که همیشه به یاد من هستی."],[918,"در شبان‌روزی وظیفه چاشتگاه","راتبه کردی وصال ای نیک‌خواه","در طول روز، تو نیکوکار، بر من وظیفه‌ای گذاشته‌ای که صبحانه را به وصال و دیدار تو اختصاص دهم."],[918,"من بدین یک‌بار قانع نیستم","در هوایت طرفه انسانیستم","من فقط با یک‌بار دیدن تو راضی نمی‌شوم، زیرا در عشق تو انسانی فوق‌العاده و شگفت‌انگیز شده‌ام."],[918,"پانصد استسقاستم اندر جگر","با هر استسقا قرین جوع البقر","من در درونم بسیار تشنه‌ام و احساس کمبود می‌کنم، مانند کسی که نیمه مستی بگرید و به او بگوید هر بار که عطش می‌کشم، کمبود خوراک هم در کنار آن به سراغم می‌آید."],[918,"بی‌نیازی از غم من ای امیر","ده زکات جاه و بنگر در فقیر","ای امیر، از غم و اندوه من بی‌نیاز باش و لطفا از اموالی که در اختیارت هست (زکات جاه) به من ببخشای، و به حال این فقیر نظر کن."],[918,"این فقیر بی‌ادب نا درخورست","لیک لطف عام تو زان برترست","این فرد فقیر بی‌احترامی است و شایسته تو نیست، اما مهربانی و لطف عمومی تو بالاتر از این است و بر ضعف او می‌چربد."],[918,"می‌نجوید لطف عام تو سند","آفتابی بر حدثها می‌زند","لطف عمومی تو مانند آفتاب است که بر روی خطاها (حدث‌ها) می‌تابد و آن‌ها را از بین می‌برد، بنابراین شایسته یا نادرست بودن من در برابر این لطف اهمیت ندارد."],[918,"نور او را زان زیانی نابده","وان حدث از خشکیی هیزم شده","نور او (خدا) به این آسیب و ضرر نمی‌رسد و این عیب و نقص از خشکی هیزم به وجود آمده است."],[918,"تا حدث در گلخنی شد نور یافت","در در و دیوار حمامی بتافت","وقتی که حادثه‌ای در جایی رخ می‌دهد، نور آن به دیوارها و درهای حمام می‌تابد و فضای آنجا را روشن می‌کند."],[918,"بود آلایش شد آرایش کنون","چون برو بر خواند خورشید آن فسون","در گذشته، هر چیز ناپاکی آلودگی و تاریکی به حساب می‌آمد، اما اکنون، همان آلودگی به زیبایی و جلوه تبدیل شده است، زیرا که خورشید (شمس) با تأثیر خود، این تغییر را ایجاد کرده و همه چیز را درخشان و زیبا کرده است."],[918,"شمس هم معده زمین را گرم کرد","تا زمین باقی حدثها را بخورد","شمس (مظهر نور و آگاهی) به زمین حرارت و گرما می‌دهد تا زمین بتواند آلودگی‌ها و زوائد خود را جذب و هضم کند."],[918,"جزو خاکی گشت و رست از وی نبات","هکذا یمحو الاله السیئات","انسان به مرور زمان از خاک به وجود می‌آید و مانند گیاهان می‌روید، درست مانند این که خداوند بدی‌ها را از میان می‌برد و اجازه می‌دهد انسان در مسیر نیکو قدم بردارد."],[918,"با حدث که بترینست این کند","کش نبات و نرگس و نسرین کند","این بیت می‌گوید که با وجود خطاها و اشتباهات، خداوند بهترین حالات و ویژگی‌ها را به موجودات زنده، مانند گیاهان و گل‌ها (نرگس و نسرین)، می‌بخشد و آن‌ها را به کمال می‌رساند."],[918,"تا به نسرین مناسک در وفا","حق چه بخشد در جزا و در عطا","مولانا اشاره می‌کند که اگر خداوند به انواع گیاهان زیبا مانند نسرین (گل نسرین) جزای وفاداری عطا کند، به بندگان خوب و طیب (نیکوکاران) در پاداش و نعمت چه عطا خواهد کرد."],[918,"چون خبیثان را چنین خلعت دهد","طیبین را تا چه بخشد در رصد","وقتی که خداوند لباس نعمت را به افراد بد و خبیث می‌دهد، مشخص نیست که به نیکوکاران چه عطا خواهد کرد."],[918,"آن دهد حقشان که لا عین رات","که نگنجد در زبان و در لغت","خداوند، به هر کس در حق خودش آنچه را که شایسته‌اش است می‌دهد؛ چیزی که نه چشمی آن را دیده، نه زبانی توانایی بیانش را دارد و نه لغتی می‌تواند آن را توصیف کند."],[918,"ما کییم این را بیا ای یار من","روز من روشن کن از خلق حسن","ما کی هستیم، ای یار؟ این را به من بگو و روز مرا با زیبایی‌های خود روشن کن."],[918,"منگر اندر زشتی و مکروهیم","که ز پر زهری چو مار کوهیم","به زشتی‌ها و کارهای ناپسند من توجه نکن، زیرا از زهر مفید و قدرتی مثل مار کوهستان برخورداریم."],[918,"ای که من زشت و خصالم جمله زشت","چون شوم گل چون مرا او خار کشت","من که زشت و بدخلق هستم و همه‌چیزم زشت است، چگونه می‌توانم به زیبایی گل شبیه شوم، در حالی که خارها مرا آزار می‌دهند؟"],[918,"نوبهار حسن گل ده خار را","زینت طاووس ده این مار را","بهار، زیبایی گل را به خار اضافه می‌کند و این زیبایی مانند طاووس است؛ بنابراین باید این مار (نماد شر و زشتی) را نیز به زیبایی تبدیل کرد."],[918,"در کمال زشتیم من منتهی","لطف تو در فضل و در فن منتهی","ما در اوج زشتی و بدی هستیم، ولی لطف و کرم تو باعث کمال و زیبایی‌مان می‌شود و فضیلت و مهارت ما به تو بستگی دارد."],[918,"حاجت این منتهی زان منتهی","تو بر آر ای حسرت سرو سهی","ای خداوند، برآورده کردن نیازم به لطف و فضل تو بستگی دارد، نه به خواسته‌ها و آرزوهای من. حسرت و آرزویم از این که تو همواره و تنها تو می‌توانی به من کمک کنی، از من جدا نمی‌شود."],[918,"چون بمیرم فضل تو خواهد گریست","از کرم گرچه ز حاجت او بریست","وقتی که من بمیرم، لطف و کرم تو برای من گریه خواهد کرد، هرچند که تو به نیاز من نیازی نداری."],[918,"بر سر گورم بسی خواهد نشست","خواهد از چشم لطیفش اشک جست","پس از مرگ من، افراد زیادی بر سر قبرم خواهند نشست و او با چشمان نرم و لطیفش اشک خواهد ریخت."],[918,"نوحه خواهد کرد بر محرومیم","چشم خواهد بست از مظلومیم","او (محروم) به شدت داغدار و ناامید است و در غم و اندوه خود نوحه‌خوانی خواهد کرد. چشمانش را از دیدن مظلومیت خود می‌بندد تا بیشتر در غمش غرق شود."],[918,"اندکی زان لطفها اکنون بکن","حلقه‌ای در گوش من کن زان سخن","اکنون کمی از آن لطف‌ها و مهربانی‌هایت برای من انجام بده و به من گوش کن، تا از آن سخن‌های زیبایت بگویم."],[918,"آنک خواهی گفت تو با خاک من","برفشان بر مدرک غمناک من","اگر بخواهی با من سخن بگویی، بر روی خاک افسرده‌ام برف بپاش، تا به خاطر غم‌های گذشته‌ام، فراموش‌شان کنم."],[919,"صوفیی را گفت خواجه سیم‌پاش","ای قدمهای ترا جانم فراش","صوفیی از طرف شخص ثروتمندی به نام «خواجه سیم‌پاش» می‌گوید که برای او قدم‌های این صوفی بسیار ارزشمند و عزیز است، به حدی که جان او را به خدمت این صوفی می‌سپارد."],[919,"یک درم خواهی تو امروز ای شهم","یا که فردا چاشتگاهی سه درم","ای سلطانی، آیا امروز تنها یک درم می‌خواهی یا اینکه فردا در صبحگاه سه درم؟"],[919,"گفت دی نیم درم راضی‌ترم","زانک امروز این و فردا صد درم","گفت: من نیم درم امروز را بیشتر می‌پسندم تا این که فردا صد درم بگیرم. یعنی او به ارزش حال و چیزی که اکنون در اختیارش است، تأکید می‌کند و انتظار برای آینده را کم‌ارزش می‌داند."],[919,"سیلی نقد از عطاء نسیه به","نک قفا پیشت کشیدم نقد ده","من با ارائه‌ی لبی، جبران می‌کنم که به تو پیشکش می‌کنم؛ در واقع نقد و عطاء من همان قدر واقعی است که سیلی از آن شرایط نسیه و وعده به تو نزدیک‌تر است."],[919,"خاصه آن سیلی که از دست توست","که قفا و سیلیش مست توست","این بیت به این معناست که به ویژه آن سیلی (کمک و پشتیبانی) که از دست تو (خدا) صادر می‌شود، یعنی تمام نعمت‌ها و کمک‌هایی که از سوی اوست، چنان تأثیرگذار و پخته است که باعث مستی و سرخوشی می‌شود."],[919,"هین بیا ای جان جان و صد جهان","خوش غنیمت دار نقد این زمان","ای جان، بشتاب و از این لحظه غنیمت به خوبی استفاده کن، زیرا این زمان واقعی و ارزشمند است و باید از آن بهره ببری."],[919,"در مدزد آن روی مه از شب روان","سرمکش زین جوی ای آب روان","در این بیت، شاعر به تماشای زیبایی چهره محبوب خود، که همچون ماه در شب می‌درخشد، می‌پردازد و از آب روان، که نماد حیات و جریانی مستمر است، دعوت می‌کند تا سرمست و لذت‌بردار از این زیبایی شود."],[919,"تا لب جو خندد از آب معین","لب لب جو سر برآرد یاسمین","وقتی که آب معین به لب جوی برسد، یاسمن نیز سر خود را از زمین بیرون می‌آورد و به این ترتیب، لب جوی از شادی و طراوت می‌خندد."],[919,"چون ببینی بر لب جو سبزه مست","پس بدان از دور که آنجا آب هست","وقتی سبزه‌ای شاداب و سرسبز بر لبه جوی آب ببینی، بدان که آنجا آب وجود دارد و از دور می‌توان فهمید که این سبزه به خاطر آب رشد کرده است."],[919,"گفت سیماهم وجوه کردگار","که بود غماز باران سبزه‌زار","سیمای آنان که در کنار خدا هستند، مانند چهره‌ای می‌باشد که باران را به سبزه‌زار می‌آورد؛ یعنی آنها نشانه‌های رحمت و نعمت‌های خداوند را فاش می‌کنند."],[919,"گر ببارد شب نبیند هیچ کس","که بود در خواب هر نفس و نفس","اگر باران ببارد، هیچ‌کس در شب نمی‌بیند که چه کسی در حال خواب است، زیرا هر نفس و هر لحظه در خوابند."],[919,"تازگی هر گلستان جمیل","هست بر باران پنهانی دلیل","زیبایی و تازگی هر گلستان خوشبو، نشانه‌ای است بر وجود بارانی که به طور پنهانی و نهان بر آن می‌بارد."],[919,"ای اخی من خاکیم تو آبیی","لیک شاه رحمت و وهابیی","ای برادر! ما از خاک هستیم و تو آب. اما تو همچنین پادشاه رحمتی و عطایی بی‌پایان."],[919,"آن‌چنان کن از عطا و از قسم","که گه و بی‌گه به خدمت می‌رسم","به گونه‌ای رفتار کن که از بخشش و سوگند تو به من همیشه نزدیک باشم و در هر زمان بتوانم به خدمتت برسم."],[919,"بر لب جو من به جان می‌خوانمت","می‌نبینم از اجابت مرحمت","در کناره جو، با تمام وجود به تو دعوتت می‌کنم، ولی از طرف تو هیچ نشانه‌ای از پاسخ و لطف نمی‌بینم."],[919,"آمدن در آب بر من بسته شد","زانک ترکیبم ز خاکی رسته شد","به خاطر ریشه‌دار بودنم در خاک، دیگر نمی‌توانم به آب بیایم و وارد آن شوم. این به خاطر این است که وجود من از ترکیب خاک تشکیل شده و به آن وابسته است."],[919,"یا رسولی یا نشانی کن مدد","تا ترا از بانگ من آگه کند","ای پیامبر، ای نشانه، کمک کن تا صدای من به تو برسد و از حال من آگاه شوی."],[919,"بحث کردند اندرین کار آن دو یار","آخر آن بحث آن آمد قرار","دو دوست در مورد یک موضوع مهم صحبت کردند و در نهایت، پس از گفتگو، به توافق و نتیجه‌گیری رسیدند."],[919,"که به دست آرند یک رشته دراز","تا ز جذب رشته گردد کشف راز","باید یک رشته دراز را به دست آورد تا از کشیده شدن آن، حقیقت و رازهایی آشکار شود."],[919,"یک سری بر پای این بنده دوتو","بست باید دیگرش بر پای تو","مولانا به این نکته اشاره دارد که برای رسیدن به پیوندی عمیق و حقیقی میان دو نفر، باید یکی از آن‌ها، یعنی این بنده، خود را به چیزی متصل کند و در عوض، دیگری نیز باید خود را به همان اندازه به آن وصل کند. به عبارت دیگر، هر دو باید برای ارتباطشان کوشش و تعهد خاصی داشته باشند."],[919,"تا به هم آییم زین فن ما دو تن","اندر آمیزیم چون جان با بدن","برای آنکه به یکدیگر نزدیک شویم، باید با این هنر که داریم، ما دو نفر در هم بیامیزیم مانند جان که با بدن در ارتباط است."],[919,"هست تن چون ریسمان بر پای جان","می‌کشاند بر زمینش ز آسمان","تن مانند ریسمانی است که جان را به خود متصل کرده و سبب می‌شود که جان از آسمان به زمین کشیده شود."],[919,"چغز جان در آب خواب بیهشی","رسته از موش تن آید در خوشی","روح آدمی در حالت بیداری مانند چغزی است که از موش بدن رها شده و به آرامش و خوشی دست می‌یابد."],[919,"موش تن زان ریسمان بازش کشد","چند تلخی زین کشش جان می‌چشد","موش که به‌واسطه آن ریسمان کشیده می‌شود، به‌دلیل این کشیدگی از ریسمان تلخی و درد می‌کشد."],[919,"گر نبودی جذب موش گنده‌مغز","عیش‌ها کردی درون آب چغز","اگر موش بزرگ و باهوش نبود، تو در لذت‌ها به راحتی غرق می‌شدی و از عمق زندگی استفاده نمی‌کردی."],[919,"باقیش چون روز برخیزی ز خواب","بشنوی از نوربخش آفتاب","زمانی که از خواب بیدار شوی، باقی‌مانده‌ی این دنیا را همچون نور خورشید روشن و واضح خواهی دید."],[919,"یک سر رشته گره بر پای من","زان سر دیگر تو پا بر عقده زن","من گره‌ای را به پای خود بسته‌ام و برای باز کردن آن، از تو که آن گره را زده‌ای، کمک می‌خواهم."],[919,"تا توانم من درین خشکی کشید","مر ترا نک شد سر رشته پدید","من تا وقتی که در این سختی و مشکلات هستم، نمی‌توانم تو را فراموش کنم و سرنخ ارتباط ما مشخص نیست."],[919,"تلخ آمد بر دل چغز این حدیث","که مرا در عقده آرد این خبیث","چغز (نوعی موش) از شنیدن این سخن بسیار دلگیر و متاثر شد، زیرا این خبیث (شخص بدذات یا مضر) می‌خواهد او را به مشکل و تنگنا بیندازد."],[919,"هر کراهت در دل مرد بهی","چون در آید از فنی نبود تهی","هر ناراحتی و تنفر که در دل انسان پدید می‌آید، نشانه‌ای است از این‌که او از فن و مهارت خاصی که داشته، خالی شده است و به همین دلیل است که دچار احساس بدی می‌شود."],[919,"وصف حق دان آن فراست را نه وهم","نور دل از لوح کل کردست فهم","توصیف حق، به مانند دانایی و بصیرتی است که از عقل فراتر رفته و به نور دل می‌رسد؛ این فهم عمیق و والایی، انسان را از امور ظاهری و خیالات دور می‌کند."],[919,"امتناع پیل از سیران ببیت","با جد آن پیلبان و بانگ هیت","پیلی که نمی‌تواند ببیند و حرکت کند، نمی‌تواند به سوی مقصدش برود. او با وجود آنکه جدش یعنی پدرش پیلبان بوده، همچنان از حرکت امتناع می‌کند و به سمت جلو نمی‌رود."],[919,"جانب کعبه نرفتی پای پیل","با همه لت نه کثیر و نه قلیل","به سمت کعبه نرفته‌ای، پای فیل با همه سنگینی‌اش نه زیاد است و نه کم. یعنی در اینجا می‌گوید زمانی که مقصدی مهم و مقدس وجود دارد، حتی بزرگ‌ترین موانع هم نمی‌توانند مانع حرکت به سمت آن هدف شوند."],[919,"گفتیی خود خشک شد پاهای او","یا بمرد آن جان صول‌افزای او","می‌گویی که پاهای او خشک شده یا جانش مرده است و دیگر توان حرکتی ندارد."],[919,"چونک کردندی سرش سوی یمن","پیل نر صد اسپه گشتی گام‌زن","زمانی که آن فیل نر سرش را به سوی یمن (سرزمین یمن) کج کرد، صد هزار سپاهی گام به گام به راه افتادند."],[919,"حس پیل از زخم غیب آگاه بود","چون بود حس ولی با ورود","پیل از زخم و دردهای پنهانی آگاه است، چرا که او حتی در زمان حضورش در دنیای مادی، احساسات و درک عمیق‌تری دارد."],[919,"نه که یعقوب نبی آن پاک‌خو","بهر یوسف با همه اخوان او","یعقوب، نبی و پدر یوسف، فردی پاک و نیکوست که برای یافتن پسرش یوسف، با همه پسرانش به دنبال او می‌گردد. این اشاره به حالتی از عشق و محبت است که در میان پدر و پسر وجود دارد و نشان‌دهنده عمق این رابطه است."],[919,"از پدر چون خواستندش دادران","تا برندش سوی صحرا یک زمان","هنگامی که برادران یوسف خواستند او را به صحرا ببرند، از پدرش که یعقوب نبی بود، درخواست کردند تا اجازه این کار را به آن‌ها بدهد."],[919,"جمله گفتندش میندیش از ضرر","یک دو روزش مهلتی ده ای پدر","همه به او گفتند که نگران خسارت ناشی از این تأخیر نباش، ای پدر، یک یا دو روز به او مهلت بده."],[919,"تا به هم در مرجها بازی کنیم","ما درین دعوت امین و محسنیم","ما باید با یکدیگر در موضوعاتی که به آن‌ها دعوت شده‌ایم، بازی کنیم و در این زمینه، به عنوان نمایندگان درستکار و خیرخواه، عمل نماییم."],[919,"گفت این دانم که نقلش از برم","می‌فروزد در دلم درد و سقم","او می‌گوید می‌دانم که گفته‌های کسی که به یادش می‌افتم، در دل من راجع به درد و بیماری‌ام تأثیر می‌گذارد و باعث آزارم می‌شود."],[919,"این دلم هرگز نمی‌گوید دروغ","که ز نور عرش دارد دل فروغ","دل من هرگز دروغ نمی‌گوید، زیرا از نور عرش، یعنی از نور خداوند، روشنی می‌گیرد."],[919,"آن دلیل قاطعی بد بر فساد","وز قضا آن را نکرد او اعتداد","این دلیل قاطع و روشنی که بر فساد چیزها دلالت می‌کند، او (که در اینجا اشاره به خداوند یا حقیقت دارد) به آن اهمیت و اعتنایی نمی‌کند."],[919,"در گذشت از وی نشانی آن‌چنان","که قضا در فلسفه بود آن زمان","آنچه در اینجا گفته می‌شود، این است که نشانه‌های گذشت زمان و رویدادهای قضا و قدر به گونه‌ای است که به طور طبیعی و فلسفی در امور دنیا قرار دارند. به عبارتی، هر آنچه در دنیا اتفاق می‌افتد، در حقیقت نشانه‌ای از خواست و تقدیر الهی است."],[919,"این عجب نبود که کور افتد به چاه","بوالعجب افتادن بینای راه","تعجبی ندارد که انسان نابینا به چاه بیفتد؛ چیزی عجیب‌تر از آن است که شخصی بینا (و در عین حال آماده) در راه درست نیز به مشکل بیفتد."],[919,"این قضا را گونه گون تصریفهاست","چشم‌بندش یفعل‌الله ما یشاست","این قضا (سرنوشت یا مقدر) به گونه‌های مختلف دستخوش تغییر و تصرف است، و در واقع انسان در برابر آن، نادان است و نمی‌تواند درک کند که خداوند هر چه بخواهد انجام می‌دهد."],[919,"هم بداند هم نداند دل فنش","موم گردد بهر آن مهر آهنش","دل به عشق کسی که در آن هم دانایی و هم نادانی دارد، نرم و منعطف می‌شود، به طوری که این عشق مانند موم در برابر حرارت مهرش، تغییر شکل می‌دهد و نرم می‌شود."],[919,"گوییی دل گویدی که میل او","چون درین شد هرچه افتد باش گو","دل گویی می‌گوید که اگر عشق و میل به معشوق در اینجا پیش آمده، هرچه که به وقوع بپیوندد، باید بپذیری."],[919,"خویش را زین هم مغفل می‌کند","در عقالش جان معقل می‌کند","آدمی خود را از این موضوع غافل می‌سازد و با دقت در مسائل دنیوی، روح و جان خود را محصور و محدود می‌کند."],[919,"گر شود مات اندرین آن بوالعلا","آن نباشد مات باشد ابتلا","اگر بوالعلا (شخصی با فضیلت و بزرگ) در این دنیا مات شود (به مرگ یا شکست دچار گردد)، این مورد نشانه‌ی مرگ او نیست بلکه نشانه‌ای از ابتلا و آزمون او است."],[919,"یک بلا از صد بلااش وا خرد","یک هبوطش بر معارجها برد","یکی از مشکلات بزرگ از صد مشکل، یک سقوط به مرتبه‌های بالا می‌تواند شخص را به درجات عالی برساند."],[919,"خام شوخی که رهانیدش مدام","از خمار صد هزاران زشت خام","شخصی که به شوخی و سرگرمی روی آورده، همیشه در حالتی مست و نشئه‌وار به سر می‌برد و این حالت او را از زشتی‌ها دور نمی‌کند. او به خاطر اینکه همواره در خوش‌گذرانی است، دچار زشتی‌های بسیار می‌شود."],[919,"عاقبت او پخته و استاد شد","جست از رق جهان و آزاد شد","او در نهایت به فردی پخته و کارآزموده تبدیل شد و از قید دنیا رهایی یافت."],[919,"از شراب لایزالی گشت مست","شد ممیز از خلایق باز رست","از شراب بی‌پایان (حکمت و عشق الهی) مست شد و به طور کامل از توده مردم (عوام) جدا شد."],[919,"ز اعتقاد سست پر تقلیدشان","وز خیال دیده بی‌دیدشان","اعتقاد ضعیف و تقلیدی آن‌ها و همچنین تصورات ناشی از دیدگاه‌های نادرست و بدون درک‌شان، باعث شده که نتوانند حقیقت را به خوبی درک کنند."],[919,"ای عجب چه فن زند ادراکشان","پیش جزر و مد بحر بی‌نشان","عجب است که چگونه درک آنها به این شکل است که در میان جزر و مد دریا که نشانه‌ای ندارد، فن و هنری از خود نشان می‌دهند."],[919,"زان بیابان این عمارت‌ها رسید","ملک و شاهی و وزارتها رسید","از دشت بی‌نهایت عدم و سرگردانی، ساختمان‌ها و قصری برای پادشاهی و کشورگشایی پدید آمده است."],[919,"زان بیابان عدم مشتاق شوق","می‌رسند اندر شهادت جوق جوق","از بیابان عدم، عاشقانی به شوق و اشتیاق می‌رسند و گروه‌گروه در فهم و آگاهی به حقیقت شهود می‌رسند."],[919,"کاروان بر کاروان زین بادیه","می‌رسد در هر مسا و غادیه","کاروان‌هایی که در بیابان به سفر می‌روند، به هم ملحق می‌شوند و در هر مکان و زمانی به یکدیگر می‌رسند."],[919,"آید و گیرد وثاق ما گرو","که رسیدم نوبت ما شد تو رو","به زودی ما هم به نوبت خود می‌رسیم و به دیگران وابسته می‌شویم، بنابراین باید به آنچه که در دسترس داریم توجه کنیم و موقعیت خود را درک کنیم."],[919,"چون پسر چشم خرد را بر گشاد","زود بابا رخت بر گردون نهاد","پسر، زمانی که چشم خرد و فهمش را باز کند، به سرعت متوجه می‌شود که پدرش، همان که در زندگی به او تعلق دارد، تمام دارایی و اعتبارش را به آسمان یا عالم بالا واگذار کرده است."],[919,"جاده شاهست آن زین سو روان","وآن از آن سو صادران و واردان","جاده شاه، مسیر اصلی و مهمی است که از یک سو به سوی دیگر می‌رود و افرادی که از آن عبور می‌کنند، شامل کسانی هستند که به آن سمت می‌روند و کسانی که از آن سمت می‌آیند. این نشان‌دهنده حرکت و رفت‌وآمد در زندگی است."],[919,"نیک بنگر ما نشسته می‌رویم","می‌نبینی قاصد جای نویم","خوب دقت کن، ما در حالتی هستیم که هرچند نشسته‌ایم، در واقع در حال حرکت به سمت مقصد جدیدی هستیم و تو نمی‌بیینی که فرستاده‌ای وجود دارد که ما را به آن جا می‌برد."],[919,"بهر حالی می‌نگیری راس مال","بلک از بهر غرض‌ها در مآل","تو در هر شرایطی سرمایه‌ات را به دست می‌گیری، اما این کار را فقط برای دستیابی به اهداف خاصی در آینده انجام می‌دهی."],[919,"پس مسافر این بود ای ره‌پرست","که مسیر و روش در مستقبلست","مسافر واقعی کسی است که ای مسافر راه، مسیر و روش او در آینده و آنچه پیش رو دارد، قرار دارد."],[919,"هم‌چنانک از پرده دل بی‌کلال","دم به دم در می‌رسد خیل خیال","همان‌طور که تصویرهای خیال از عمق دل بدون خستگی و مداوم به ذهن آدمی می‌رسند، این خیل افکار و احساسات نیز با تداوم و بی‌وقفه به وجود می‌آید."],[919,"گر نه تصویرات از یک مغرس‌اند","در پی هم سوی دل چون می‌رسند","اگر تصاویر و خیالاتی که به دل می‌رسند، از یک ریشه و منبع واحد نباشند، پس این خیالات چگونه می‌توانند به طور متوالی و پیوسته به دل راه پیدا کنند؟"],[919,"جوق جوق اسپاه تصویرات ما","سوی چشمه دل شتابان از ظما","تصویرات و تصورات ما مانند گروه گروه اسب‌ها، به‌سوی چشمه دل، با شتاب و تشنگی حرکت می‌کنند."],[919,"جره‌ها پر می‌کنند و می‌روند","دایما پیدا و پنهان می‌شوند","موش‌ها به طور مداوم جست‌وجو می‌کنند و به ندرت در یک جا ثابت می‌مانند؛ آن‌ها همیشه در حال آمد و رفت هستند و وجودشان گاهی قابل مشاهده و گاهی پنهان است."],[919,"فکرها را اختران چرخ دان","دایر اندر چرخ دیگر آسمان","فکرها را مانند ستاره‌ها در آسمان بدان، که هر یک در دایره‌ای از چرخ دیگر می‌چرخند و به هم وابسته‌اند."],[919,"سعد دیدی شکر کن ایثار کن","نحس دیدی صدقه و استغفار کن","اگر خوشحالی و خوشایندی را ملاقات کردی، شکرگزاری و ایثار کن؛ و اگر بدبیاری و نحسی را دیدی، باید صدقه بدهی و از خداوند طلب بخشش کنی."],[919,"ما کییم این را بیا ای شاه من","طالعم مقبل کن و چرخی بزن","ما چه کسانی هستیم که به درگاه تو ای شاه توجه داریم؟ از تو می‌خواهیم که مقدرات ما را به سمت خوشبختی بکشانی و زندگی‌مان را در مسیری بهتر هدایت کنی."],[919,"روح را تابان کن از انوار ماه","که ز آسیب ذنب جان شد سیاه","روح را با نور ماه روشن کن، زیرا به خاطر غم و دردهای زندگی، آسیب دیده و تیره شده است."],[919,"از خیال و وهم و ظن بازش رهان","از چه و جور رسن بازش رهان","انسان را از خیال‌ها، توهم‌ها و گمان‌های بی‌پایه نجات ده و او را از بندهای ظلم و ستم رها کن."],[919,"تا ز دلداری خوب تو دلی","پر بر آرد بر پرد ز آب و گلی","پس از اینکه دلت به خاطر خوبی‌های تو شاد و مطمئن شود، قلبی سرشار و شاداب ایجاد می‌کند که می‌تواند بر هرگونه مشکلات و موانع (مانند آب و گل) غلبه کند."],[919,"ای عزیز مصر و در پیمان درست","یوسف مظلوم در زندان تست","ای عزیز، تو در مصر و در وفاداری مانند یوسف (پسر یعقوب) هستی که به خاطر بی‌گناهی‌اش در زندان به سر می‌برد."],[919,"در خلاص او یکی خوابی ببین","زود که الله یحب المحسنین","برای رهایی او، زود خواب خوبی ببین که خداوند نیکوکاران را دوست دارد."],[919,"هفت گاو لاغری پر گزند","هفت گاو فربهش را می‌خورند","هفت گاو لاغر و دردکشی، هفت گاو چاق و نیرومند را می‌خورند."],[919,"هفت خوشه خشک زشت ناپسند","سنبلات تازه‌اش را می‌چرند","هفت خوشه خشک و زشت، به نابودی و زوال می‌رسند و باعث می‌شوند که سنبل‌های تازه و زیبا که نشانه تازگی و خرمی هستند، آسیب ببینند و خورده شوند."],[919,"قحط از مصرش بر آمد ای عزیز","هین مباش ای شاه این را مستجیز","قحطی از مصر به سبب خشکسالی به وجود آمده است، ای عزیز! پس ای شاه، نگران این مسئله نباش و برای آن درخواست کمک نکن."],[919,"یوسفم در حبس تو ای شه نشان","هین ز دستان زنانم وا رهان","من در زندان تو، ای شاه، همچون یوسف (پسر یعقوب) هستم، پس از دستان زنان (که به من آسیب رسانده‌اند) مرا نجات بده."],[919,"از سوی عرشی که بودم مربط او","شهوت مادر فکندم که اهبطوا","از مقام و جایگاه عرشی خود که پایین آمدم، تمایل به لذت و هوس‌های دنیوی را کنار گذاشتم. در واقع، به خاطر عشق به خدا و از خوف از گمراهی، خود را از بند شهوت آزاد کردم."],[919,"پس فتادم زان کمال مستتم","از فن زالی به زندان رحم","به خاطر کمال و نقصانی که در وجودم بود، از حالت عالی خود پایین آمدم و به زندان رحم وارد شدم، جایی که بایستی در این دنیای مادی زندگی را شروع کنم."],[919,"روح را از عرش آرد در حطیم","لاجرم کید زنان باشد عظیم","روح را از عرش به زمین می‌آورد و در مکانی پست (حطیم)، در نتیجه، نقشه‌های زنان (کسانی که به دنیا وابسته هستند) بزرگ و خطرناک خواهد بود."],[919,"اول و آخر هبوط من ز زن","چونک بودم روح و چون گشتم بدن","نخست و آخر، سقوط من از زن (مادر) بوده است، زیرا در آغاز تنها روح بودم و وقتی به بدن وارد شدم، واقعا به زمین آمدم."],[919,"بشنو این زاری یوسف در عثار","یا بر آن یعقوب بی‌دل رحم آر","یوسف در حال عذاب و بی‌کسی خود فریاد می‌زند، حالا یا به یعقوب، پدرش، که به شدت دل‌تنگ اوست، رحم کن."],[919,"ناله از اخوان کنم یا از زنان","که فکندندم چو آدم از جنان","دستم به ناله و شکایت پیش برادران و یا زنان برود، زیرا که مرا مانند آدم از بهشت بیرون کردند و به زحمت انداختند."],[919,"زان مثال برگ دی پژمرده‌ام","کز بهشت وصل گندم خورده‌ام","من مانند برگ خشکیده‌ای هستم که از بهشت وصال دور افتاده‌ام، زیرا در گذشته از خوشی‌های وصال بهره‌مند شده‌ام."],[919,"چون بدیدم لطف و اکرام ترا","وآن سلام سلم و پیغام ترا","وقتی لطف و مهربانی و احترام تو را دیدم و سلام و پیام تو را شنیدم، این احساس خوشایند را تجربه کردم."],[919,"من سپند از چشم بد کردم پدید","در سپندم نیز چشم بد رسید","من از شر چشم بد که بر خودم ایجاد کردم، به وسیله سوزاندن اسپند (گیاه خوشبو و دودزا) محافظت می‌کنم، اما حتی در زمان استفاده از اسپند هم چشم بد به من نزدیک می‌شود."],[919,"دافع هر چشم بد از پیش و پس","چشم‌های پر خمار تست و بس","تنها چشم‌های پرخمار تو هستند که می‌توانند چشم‌های بد و ناپاک را دور کنند و از من جلو بگیرند."],[919,"چشم بد را چشم نیکویت شها","مات و مستاصل کند نعم الدوا","چشم بد را، یعنی نگاه‌های منفی و حسودان، با نگاه نیک و مهربان تو، ای شاه، نابود و درمانده می‌شود."],[919,"بل ز چشمت کیمیاها می‌رسد","چشم بد را چشم نیکو می‌کند","چشم نیکو مانند کیمیا، چشم بد را نیز تحول می‌دهد و به خوبی و زیبایی تغییر می‌دهد."],[919,"چشم شه بر چشم باز دل زدست","چشم بازش سخت با همت شدست","چشم پادشاه به چشم دیگران نگریسته و به دل آنها لطمه زده است؛ چرا که او به علت اراده و همت بالایش، حالا با تلاش و جدیت به خودش وابسته است."],[919,"تا ز بس همت که یابید از نظر","می‌نگیرد باز شه جز شیر نر","به خاطر همت و تلاش بسیار، از دیدگاه خود فاصله نمی‌گیرد و نمی‌تواند به چیز دیگری غیر از شیر نر (شخصیت والا و قوی) توجه کند. این قوی‌ترین و برترین موجود است که تنها او را می‌بیند و در پی اوست."],[919,"شیر چه کان شاه‌باز معنوی","هم شکار تست و هم صیدش توی","شیر که به معنای قدرت و عظمت روحانی است، همواره تو را به شکار خود می‌آورد و هم شکار تو می‌شود. در واقع، این نماد نشان‌دهنده‌ی ارتباط متقابل میان جستجوگر حقیقت (شاه‌باز) و حقیقت (شیر) است."],[919,"شد صفیر باز جان در مرج دین","نعره‌های لا احب الافلین","صدای پرنده‌ای (باز) جان ما را در باغ دین به صدا درآورده و نعره می‌زند که من کسانی را که به دنیا علاقه دارند، نمی‌پسندم."],[919,"باز دل را که پی تو می‌پرید","از عطای بی‌حدت چشمی رسید","دل باز به شوق تو می‌تپید و چشمی به لطف و رحمت بی‌حد تو رسید."],[919,"یافت بینی بوی و گوش از تو سماع","هر حسی را قسمتی آمد مشاع","حس و ادراکات انسان مثل بوییدنی که با بینی یا شنیدنی که با گوش تجربه می‌شود، در واقع جزئی از وجود تو هستند و از تو سرچشمه می‌گیرند. هر حس و شعور، بخشی از یک تجربه بزرگ‌تر و مشترک به نام «مشاع» است که به ما فهم و ادراک می‌دهد."],[919,"هر حسی را چون دهی ره سوی غیب","نبود آن حس را فتور مرگ و شیب","هر حسی که به سمت عالم غیب و ماوراء فرستاده شود، دچار ضعف، مرگ و سستی نمی‌شود. این بدان معناست که وقتی حس‌ها در پی حقیقت‌های غیبی باشند، دیگر فزونی سن و کهنسالی آنها را تحت تأثیر قرار نمی‌دهد."],[919,"مالک الملکی به حس چیزی دهی","تا که بر حس‌ها کند آن حس شهی","خداوند مالک همه چیز، حس‌هایی به انسان می‌دهد تا او بتواند چیزی را که از عالم غیب است، درک کند و بر اساس آن احساسات خود را شکل دهد."],[920,"شب چو شه محمود برمی‌گشت فرد","با گروهی قوم دزدان باز خورد","شب وقتی که سلطان محمود برمی‌گشت، با گروهی از دزدان به‌طور ناگهانی روبه‌رو شد."],[920,"پس بگفتندش کیی ای بوالوفا","گفت شه من هم یکی‌ام از شما","گروه دزدان به سلطان محمود می‌گویند که تو کی هستی ای مرد نیکوکار، و او پاسخ می‌دهد که من هم یکی از شما هستم."],[920,"آن یکی گفت ای گروه مکر کیش","تا بگوید هر یکی فرهنگ خویش","یکی از دزدان به دیگران گفت: ای گروهی که دسیسه‌گر هستید، بگذارید هر یک از شما ویژگی‌ها و نظرات خود را بیان کند."],[920,"تا بگوید با حریفان در سمر","کو چه دارد در جبلت از هنر","هر یک از دزدان باید بگوید که در گفتگو با دوستانش چه استعداد و هنری در ذاتش وجود دارد."],[920,"آن یکی گفت ای گروه فن‌فروش","هست خاصیت مرا اندر دو گوش","یکی از آنها گفت: ای گروهی که مهارت دارید، خاصیت من در گوشهایم است."],[920,"که بدانم سگ چه می‌گوید به بانگ","قوم گفتندش ز دیناری دو دانگ","که می فهمم سگ موقع پارس کردن چه می‌گوید، گروه گفتند سهم تو از هر دینار دو ششم خواهد بود."],[920,"آن دگر گفت ای گروه زرپرست","جمله خاصیت مرا چشم اندرست","آن شخص دیگر گفت: ای افرادی که به طلا و ثروت اهمیت می‌دهید، تمام ویژگی‌ من در چشم من نهفته است."],[920,"هر که را شب بینم اندر قیروان","روز بشناسم من او را بی‌گمان","هر کس را که در شب تاریک ببینم، در روز او را بدون شک می‌شناسم."],[920,"گفت یک خاصیتم در بازو است","که زنم من نقبها با زور دست","دیگری گفت که یک ویژگی خاصی من در بازوانم دارم که به کمک آن می‌توانم با قدرت دستم کندن و حفاری کنم."],[920,"گفت یک خاصیتم در بینی است","کار من در خاکها بوبینی است","دیگری گفت که ویژگی من در بینی من است،‌از طریق بو، می‌توانم تشخیص دهم در اعماق خاک چیست."],[920,"سرالناس معادن داد دست","که رسول آن را پی چه گفته است","سران مردم، مانند معادن هستند که خدای داد را در دستانشان قرار داده است و رسول (پیامبر) هم به چه دلیلی این موضوع را بیان کرده است."],[920,"من ز خاک تن بدانم کاندر آن","چند نقدست و چه دارد او ز کان","من از جسم و بدنم آگاه هستم که در آن چه مقدار ثروت و دارایی نهفته است و این بدن چه ویژگی‌هایی دارد."],[920,"در یکی کان زر بی‌اندازه درج","وان دگر دخلش بود کمتر ز خرج","در یک ظرف، طلا به مقدار زیاد وجود دارد، اما در ظرف دیگر درآمدش کمتر از هزینه‌هایش است."],[920,"هم‌چو مجنون بو کنم من خاک را","خاک لیلی را بیابم بی‌خطا","من عاشق لیلی هستم و مانند مجنون می‌توانم خاک آنجا را بشناسم و بدون اشتباه به خاک او برسم."],[920,"بو کنم دانم ز هر پیراهنی","گر بود یوسف و گر آهرمنی","من می‌توانم از بوی هر پیراهنی تشخیص دهم که چه کسی آن را پوشیده، چه یوسف باشد و چه اهریمن."],[920,"هم‌چو احمد که برد بو از یمن","زان نصیبی یافت این بینی من","مانند احمد که بوی خوشی را از یمن آورد، بینی من نیز از آن بهره‌مند شد."],[920,"که کدامین خاک همسایه زرست","یا کدامین خاک صفر و ابترست","این بیت به بررسی و مقایسه‌ی خاستگاه‌ها و ویژگی‌های مختلف اشاره دارد. شاعر از خود می‌پرسد که کدام خاک (منظور سرزمین یا محل) همسایه‌ی زر (طلا) است و از طرفی کدام خاک نیز بی‌ارزش و ناکارا است. به نوعی این سوال به جست‌وجوی ارزش و کیفیت در محیط و اطراف‌ اشاره دارد."],[920,"گفت یک نک خاصیت در پنجه‌ام","که کمندی افکنم طول علم","دیگری گفت ویژگی من در پنجه‌ی من است،‌ می توانم به اندازه چوب پرچم (مقداری زیاد)، کمند پرتاب کنم."],[920,"هم‌چو احمد که کمند انداخت جانش","تا کمندش برد سوی آسمانش","چنان‌که احمد (محمّد) که کمند (طناب) انداخت و جانش را به‌دست آورد تا کمندش او را به آسمان ببرد."],[920,"گفت حقش ای کمندانداز بیت","آن ز من دان ما رمیت اذ رمیت","حق به او گفت،‌ ای کمند انداز خانه، آن را از من بدان، اگر تیر افکندی،‌بدان که خدا آن را افکنده (اشاره به آیه ۱۷ سوره انفال)"],[920,"پس بپرسیدند زان شه کای سند","مر ترا خاصیت اندر چه بود","پس از آن از آن شاه پرسیدند که تو چه ویژگی‌ای داری؟"],[920,"گفت در ریشم بود خاصیتم","که رهانم مجرمان را از نقم","گفت که ویژگی من در ریشم نهفته است و می‌توانم مجرمان را آزاد کنم."],[920,"مجرمان را چون به جلادان دهند","چون بجنبد ریش من زیشان رهند","زمانی که مجرمان را به دست جلادان می‌سپارند، وقتی ریش من بچنبد، از آنها می‌گذرند و آزادشان می کنند."],[920,"چون بجنبانم به رحمت ریش را","طی کنند آن قتل و آن تشویش را","وقتی که از روی مهربانی ریشم را بجنبانم، آن قتل و نگرانی را از بین می‌برد."],[920,"قوم گفتندش که قطب ما توی","که خلاص روز محنتمان شوی","قوم به او گفتند که تو قطب و قطب‌نمای ما هستی و امیدواریم که با وجود تو، رنج‌ها و مشکلات ما برطرف شود."],[920,"چون سگی بانگی بزد از سوی راست","گفت می‌گوید که سلطان با شماست","وقتی سگی از سمت راست صدا کرد، گفت می‌گوید که پادشاه در کنار شماست."],[920,"خاک بو کرد آن دگر از ربوه‌ای","گفت این هست از وثاق بیوه‌ای","مردی که از دزدان فراری بود، به خاطر بوی خاکی که از او به مشام می‌رسید، ارتباط او را با آرامش و صلح (ربوه) می‌فهمد و می‌گوید این نشان‌دهنده مشخصه‌ی خانم بیوه‌ای است که در ناامنی و بی‌پناهی به سر می‌برد."],[920,"پس کمند انداخت استاد کمند","تا شدند آن سوی دیوار بلند","استاد (مولانا) دلسوزانه و با دقت، دام (کمند) را به طرف دزدان انداخت تا آن‌ها را از دیوار بلند عبور دهد و به سمت خود بیاورد."],[920,"جای دیگر خاک را چون بوی کرد","گفت خاک مخزن شاهیست فرد","در جایی دیگر، وقتی که خاک را بویید و حس کرد، گفت این خاک متعلق به مخزن و خزانه شاه است."],[920,"نقب‌زن زد نقب در مخزن رسید","هر یکی از مخزن اسبابی کشید","نقب‌زن به شروع به کندن کرد ات به مخزن رسید، هر کس از آن مخزن چیزی را بیرون می‌آورد."],[920,"بس زر و زربفت و گوهرهای زفت","قوم بردند و نهان کردند تفت","گروهی از دزدان مقدار زیادی طلا، پارچه‌های زربفت و جواهرات باارزش را با خود بردند و آنها را پنهان کردند."],[920,"شه معین دید منزل‌گاهشان","حلیه و نام و پناه و راهشان","شاه ، مسیر خانه و حیله و نام و روششان را متوجه شد."],[920,"خویش را دزدید ازیشان بازگشت","روز در دیوان بگفت آن سرگذشت","سلطان محمود از آن دزدان دور شد و شبانه به سوی دیوان برگشت و در روز ماجرای آن شب را برای دیگران روایت کرد."],[920,"پس روان گشتند سرهنگان مست","تا که دزدان را گرفتند و ببست","سپس سرهنگ‌ها به حالت مستی به راه افتادند تا دزدان را پیدا کنند و آن‌ها را گرفتار کرده و به بند بکشند."],[920,"دست‌بسته سوی دیوان آمدند","وز نهیب جان خود لرزان شدند","دزدان با دستان بسته به سوی دیوان (محل قضاوت و پادشاهی) آوردند و از ترس جان خود به شدت می‌لرزیدند."],[920,"چونک استادند پیش تخت شاه","یار شبشان بود آن شاه چو ماه","در زمان شب، وقتی دزدان در برابر تخت سلطان محمود ایستاده بودند، آن سلطان مانند ماه درخشنده بود."],[920,"آنکه چشمش شب به‌هرکه انداختی","روز دیدی بی‌شکش بشناختی","هر کسی که در شب به دیگری نگاه کند، در روز بدون هیچ تردیدی او را خواهد شناخت."],[920,"شاه را بر تخت دید و گفت این","بود با ما دوش شب‌گرد و قرین","مولانا در این بیت اشاره دارد که شاه (سلطان محمود) را بر تخت می‌بیند و می‌گوید که این همان کسی است که شب گذشته در کنار ما و همراه ما بود. به نوعی، او به نزدیکی و شب‌گردی شاه اشاره دارد که نشان‌دهنده آشنایی و رفاقت مسافرین شب است."],[920,"آنکه چندین خاصیت در ریش اوست","این گرفت ما هم از تفتیش اوست","آن کسی که دارای ویژگی‌های فراوانی در ریشش است، ما نیز به خاطر بررسی و کنکاش او به این ویژگی‌ها پی بردیم."],[920,"عارف شه بود چشمش لاجرم","بر گشاد از معرفت لب با حشم","عارف بزرگ و صاحب معرفت، به طبیعی بودن و گستردگی نگاهش، به تماشای حقایق عالم می‌نشیند و از سر آگاهی، زبانش به بیان حقایق می‌گشاید."],[920,"گفت و هو معکم این شاه بود","فعل ما می‌دید و سرّمان می‌شنود","سلطان محمود می‌گوید: ما در صحبت با شما هستیم، در حالی که این پادشاه (من) با شماست و اعمال ما را می‌بیند و اسرار ما را می‌شنود."],[920,"چشم من ره برد شب شه را شناخت","جمله شب با روی ماهش عشق باخت","چشم من در شب، راه سلطان را تشخیص داد و فهمید که همه شب با زیبایی روی او، عاشق شده‌اند."],[920,"امت خود را بخواهم من ازو","کاو نگرداند ز عارف هیچ رو","من از او می‌خواهم که امت خود را به من بدهد، کسی که هیچ‌گاه از عارفان روی برنتابید."],[920,"چشم عارف دان امان هر دو کون","که بدو یابید هر بهرام عون","چشم عارف به گونه‌ای می‌بیند که در آن دو جهان (دنیا و آخرت) را می‌توان با او درک کرد، و هرگاه که به او (یعنی عارف) نگاه کنی، کمک و یاری را پیدا می‌کنی."],[920,"زان محمد شافع هر داغ بود","که ز جز شه چشم او مازاغ بود","از شفاعت محمد، هر دردی تسکین می‌یابد، چرا که کسی جز او قادر به شفاعت نیست و چشم دیگران به او دوخته شده است."],[920,"در شب دنیا که محجوب است شید","ناظر حق بود و زو بودش امید","در شب دنیا که پر از ظلمت و تاریکی است، اگر کسی به حق و حقیقت توجه کند، می‌تواند به نور و روشنایی دست یابد و از خداوند امید داشته باشد."],[920,"از الم نشرح دو چشمش سرمه یافت","دید آنچه جبرئیل آن بر نتافت","چشم‌های آن فرد، مانند الم نشرح (یعنی مروارید درخشان) زیبا و درخشان شده و از آن‌ها به گونه‌ای سرمه (یک نوع دارو که به چشم مالیده می‌شود) به دست آمده که دیدن حقایق و نکات عمیق را برایش میسر کرده است؛ چیزی که جبرئیل (فرشته وحی) توانایی درک آن را نداشت."],[920,"مر یتیمی را که سرمه حق کشد","گردد او در یتیم با رشد","یعنی، اگر یتیمی با درک و شناخت حقیقت، چشم حق را ببیند و خود را به سویی از نور خدا روشن کند، در نتیجه به زیور ارزشمندی مثل در (مروارید) بدل می‌شود."],[920,"نور او بر ذره‌ها غالب شود","آن‌چنان مطلوب را طالب شود","نور او، یعنی نور خدا، بر ذره‌ها و موجودات چیره می‌شود و به‌گونه‌ای است که آنچه مطلوب است به خواسته‌ها و امیال او می‌رسد."],[920,"در نظر بودش مقامات العباد","لاجرم نامش خدا شاهد نهاد","او در آگاهی از جایگاه‌های بندگان خدا، به همین دلیل نامش را خدا به عنوان گواه قرار داد."],[920,"آلت شاهد زبان و چشم تیز","که ز شب‌خیزش ندارد سر گریز","شاهد در میان مردم، زبان و چشم تیزش است که هیچ‌گاه از کار خود، حتی در هنگام حساس و شبانه، فرار نمی‌کند و همواره در جستجوی حقایق است."],[920,"گر هزاران مدعی سر بر زند","گوش قاضی جانب شاهد کند","اگر هزاران مدعی (شاکی) هم بر خیزند، قاضی (داور) تنها به سخنان شاهد گوش می‌دهد و بر اساس آن تصمیم می‌گیرد."],[920,"قاضیان را در حکومت این فن‌ست","شاهد ایشان را دو چشم روشن‌ست","در حکومت قضات، انصاف و عدل مهم‌ترین اصل است و آنها باید با دیدی روشن و unbiased (بدون تعصب) به قضاوت بپردازند."],[920,"گفت شاهد زان به جای دیده است","کو بدیده بی‌غرض سر دیده است","شاهد (شهادت‌دهنده) از اینجا به بعد بهتر از چشم است، زیرا او با چشم بی‌غرض می‌بیند."],[920,"مدعی دیده‌ست اما با غرض","پرده باشد دیده دل را غرض","مدعی (کسی که ادعای دیدن حقیقت دارد) تنها با هدفی خاص و غرض‌ورزانه می‌بیند؛ در حالی که بینش واقعی نیازمند دلی بی‌غرض است که بتواند حقیقت را بدون پرده و پیش‌داوری ببیند."],[920,"حق همی‌خواهد که تو زاهد شوی","تا غرض بگذاری و شاهد شوی","خداوند می‌خواهد که تو زاهد و دور از دنیا شوی تا از قصد و نیت‌های خود دست برداری و به حقیقت را ببینی."],[920,"کاین غرض‌ها پرده دیده بود","بر نظر چون پرده پیچیده بود","این اهداف و مقاصد، مانند پرده‌ای بر دید تو است و مانع از آن می‌شود که حقیقت را ببینی، همچنان که پرده‌ای تمام چیزها را می‌پوشاند و نمایان نمی‌کند."],[920,"پس نبیند جمله را با طم و رم","حبک الاشیاء یعمی و یصم","بنابراین انسان درک صحیحی از وضعیت‌ها و پیرامون خود ندارد، چرا که عشق به چیزها و تعلق به آن‌ها او را کور و ناشنوا کرده است."],[920,"در دلش خورشید چون نوری نشاند","پیشش اختر را مقادیری نماند","وقتی خورشید حق بر دل او تابید، دیگر به دلیل درخشش آن هیچ ستاره‌ای برایش اهمیت پیدا نکرد و از بین رفت."],[920,"پس بدید او بی‌حجاب اسرار را","سیر روح مؤمن و کفار را","سلطان محمود بی‌پرده به اسرار و رازهای زندگی مؤمنان و کافران نگریست و حال آنان را مشاهده کرد."],[920,"در زمین حق را و در چرخ سمی","نیست پنهان‌تر ز روح آدمی","هیچ چیزی در زمین و آسمان به اندازه روح آدمی پنهان نیست و حق، یعنی حقیقت، به‌راحتی از آن آگاه نمی‌شود."],[920,"باز کرد از رطب و یابس حق نورد","روح را من امر ربی مهر کرد","حق، روح را از رطب و یابس (خوشی‌ها و ناخوشی‌ها) می‌سازد و به او می‌فهماند که من بی‌گمان فرمان خدا را در دل خود دارم."],[920,"پس چو دید آن روح را چشم عزیز","پس برو پنهان نماند هیچ چیز","وقتی آن روح عزیز را دید، دیگر چیزی نمی‌توانست پنهان بماند و همه‌چیز آشکار شد."],[920,"شاهد مطلق بود در هر نزاع","بشکند گفتش خمار هر صداع","شاهد حق همیشه در هر منازعه و دعوا حاضر است و وجود او سبب می‌شود که هر ادعایی که نادرست باشد رد شود، حتی اگر کسانی به‌ظاهر دلایل قاطعی داشته باشند."],[920,"نام حق عدل است و شاهد آن‌ اوست","شاهد عدل است زین رو چشم دوست","خداوند به معنای عدالت شناخته می‌شود و شاهد وجود او نیز منبع و نشانه عدالت است. به همین دلیل، چشم دوست به عدالت او توجه دارد و به آن می‌نگرد."],[920,"منظر حق دل بود در دو سرا","که نظر در شاهد آید شاه را","دل انسان، همانند جایی است که می‌تواند پرتو حق را در دو جهان ببیند؛ به همین دلیل، وقتی به پروردگار نگاه می‌کند، همچون نگاهی به شاه می‌افتد."],[920,"عشق حق و سر شاهدبازی‌اش","بود مایه جمله پرده‌سازی‌اش","محور اصلی این بیت، عشق به خدا (عشق حق) و راز و حقیقت مشاهده او (شاهدبازی) است که باعث شده همه‌ی پرده‌ها و موانع درک حقایق کنار بروند و پرده‌برداری از معانی عمیق صورت گیرد. به عبارت دیگر، این عشق الهی سبب می‌شود تا تمامی حجاب‌ها و مشکلات برداشته شوند."],[920,"پس از آن لولاک گفت اندر لقا","در شب معراج شاهدباز ما","پس از آن، لولاک (شخصیتی در داستان) در ملاقات و دیدار با خداوند در شب معراج، به ما گفت که ما همچون شاهدان عشق و محبت همدیگر هستیم."],[920,"این قضا بر نیک و بد حاکم بود","بر قضا شاهد نه حاکم می‌شود","این قضا (سرنوشت) بر خوبان و بدکاران تسلط دارد، اما قضا (سرنوشت) خود نمی‌تواند بر شاهدان (گواهان) حاکم شود."],[920,"شد اسیر آن قضا میر قضا","شاد باش ای چشم‌تیز مرتضی","این قضا (سرنوشت) بر همه، حتی بر میر قضا (فرمانده قضا و قضا) تسلط دارد. بنابراین، ای مرتضی، چشمان تیزبین، شاد باش و به سرنوشت خود راضی باش."],[920,"عارف از معروف بس درخواست کرد","کای رقیب ما تو اندر گرم و سرد","عارف از محبوب و شناخته شده (معروف) درخواست کرد که ای رقیب ما، تو در شرایط خوب و بد (سختی و آسایش) در کنار ما هستی."],[920,"ای مشیر ما تو اندر خیر و شر","از اشارتهات دل‌مان بی‌خبر","ای مشیر ما (راهنمای ما)، تو در کارهای خوب و بد، از نشانه‌ها و اشاره‌هایت خبر دل ما را نداری."],[920,"ای یرانا لانراه روز و شب","چشم‌بند ما شده دید سبب","ای یاران، ما در روز و شب نمی‌توانیم حقیقت را ببینیم و سبب آن، چشمی است که بر ما پوشیده شده است."],[920,"چشم من از چشم‌ها بگزیده شد","تا که در شب آفتابم دیده شد","چشم من از همه چشم‌ها جدا شده است تا این‌که در شب، آفتاب را دیده‌ام."],[920,"لطف معروف تو بود آن ای بهی","پس کمال البر فی اتمامه","لطف و محبت تو بود که باعث این خوبی و زیبایی شد؛ بنابراین، کمال و برتری در تکمیل این نعمت و احسان تو نهفته است."],[920,"یا رب اتمم نورنا فی الساهره","وانجنا من مفضحات قاهره","خدای من، نور ما را در این شب کامل کن و ما را از خفّت‌ها و شرم‌هایی که ممکن است در اینجا بر ما آید، نجات بده."],[920,"یار شب را روز مهجوری مده","جان قربت‌دیده را دوری مده","ای کاش شب را به روز تبدیل نکنی و به کسی که در دوری و تنهایی است، دوری بیشتری ندهی."],[920,"بعد تو مرگی‌ست با درد و نکال","خاصه بعدی که بود بعد الوصال","پس از تو مرگ و درد و اندوهی وجود دارد، به‌خصوص که این حالتی پس از وصال (وصل و ملاقات) تو است."],[920,"آنکه دیده‌ستت مکن نادیده‌اش","آب زن بر سبزه بالیده‌اش","هر کسی که تو را دیده، نباید به سادگی او را نادیده بگیرد. برای او مانند آبی باش که بر روی سبزه‌ای که به خوبی روییده است، می‌ریزد و به آن حیات می‌بخشد."],[920,"من نکردم لا ابالی در روش","تو مکن هم لاابالی در خلش","من در شیوه تو بی‌احتیاطی نکردم، تو هم در کارهای خود بی‌پروا نباش."],[920,"هین مران از روی خود او را بعید","آنکه او یک‌باره آن روی تو دید","مبادا او را از خود برانید، چرا که امکان ندارد یک‌باره روی زیبای تو را ببیند و سپس از آن دور شود."],[920,"دید روی جز تو شد غل گلو","کل شیء ما سوی الله باطل","اگر غیر از تو کسی را ببینم، در دام و بند گرفتار می‌شوم. هر چیزی غیر از خدا باطل و بی‌ارزش است."],[920,"باطل‌اند و می‌نمایندم رشد","زانکه باطل باطلان را می‌کشد","چیزهایی که به نظر می‌رسند، در حقیقت بی‌ارزش هستند و کسانی که به باطل دچار شده‌اند، دیگران را به سوی خود جذب می‌کنند."],[920,"ذره‌ذره کاندرین ارض و سماست","جنس خود را هر یکی چون کهرباست","در این بیت اشاره به این است که هر کدام از موجودات زمین و آسمان، به تدریج و به اندازه خود از جنس و ماهیت خویش هستند و مانند کهربا (مواد روشنی که بر اثر الکتریسیته ساکن می‌شود) خاصیت خود را دارند. به عبارت دیگر، هر موجودی ذره ذره از ویژگی‌های فطری و طبیعی خود برخوردار است."],[920,"معده نان را می‌کشد تا مستقر","می‌کشد مر آب را تف جگر","معده در حال جذب نان است و در این حال، آب را هم به خاطر نیاز جگر به آن، به داخل می‌کشد."],[920,"چشم جذاب‌ بتان زین کوی‌ها","مغزجویان از گلستان بوی‌ها","چشم‌های زیبا و خوش‌نما مانند بت‌ها از این خیابان‌ها انسان‌ها را به خود جذب می‌کنند، و مغزها به دنبال عطر و بوی خوش از گلستان‌ها هستند."],[920,"زانکه حس چشم آمد رنگ‌کش","مغز و بینی می‌کشد بوهای خوش","زیرا حس بینایی به رنگ‌ها توجه می‌کند و بوی خوش را از اعضای حس بویایی و مغز می‌گیرد."],[920,"زین کشش‌ها ای خدای رازدان","تو به جذب لطف خودمان ده امان","ای خدا، که به رازها آگاهی، به خاطر این جذبه‌ها، لطف خودت را به ما برسان و ما را در امان نگه‌دار."],[920,"غالبی بر جاذبان ای مشتری","شاید ار درماندگان را وا خری","ای مشتری (سیاره) که بر جاذبه‌ها سلطنت می‌کنی، شاید اگر درمانده‌ها را بازخریدی (نجات دهی)، به توجیه و حمایت بیشتری نیاز پیدا کنی."],[920,"رو به شه آورد چون تشنه به ابر","آنکه بود اندر شب قدر آن بدر","به سوی پادشاه رفت مانند کسی که تشنه‌ی باران است، کسی که در شب قدر (شب مهم و با برکت) درخشیده مانند ماه (که نورش در آن شب آشکار می‌شود)."],[920,"چون لسان وجان او بود آن او","آن او با او بود گستاخ‌گو","وقتی زبان و جان او مانند یک شخص ماهر و دانا بود، پس خود او در واقع همان شخصی است که با او صحبت می‌کند و او را تشویق به بیان افکارش می‌کند."],[920,"گفت ما گشتیم چون جان بند طین","آفتاب جان توی در یوم دین","ما مانند جان خود، به دقت در جستجوی حقیقت و نور معنوی هستیم، مانند خورشید که جاودانگی و نور خود را در روز قیامت نمایان می‌کند."],[920,"وقت آن شد ای شه مکتوم‌سیر","کز کرم ریشی بجنبانی به خیر","ای پادشاه با تدبیر و پنهان، زمانی رسیده است که باید از بزرگواری و لطف خود بهره ببری و ریشة این مشکلات و گرفتاری‌ها را با کار نیک برطرف کنی."],[920,"هر یکی خاصیت خود را نمود","آن هنرها جمله بدبختی فزود","هر یک از دزدان ویژگی خاص خود را نشان داد و به سبب آن هنرها، فقط بر بدبختی‌هایشان افزوده شد."],[920,"آن هنرها گردن ما را ببست","زان مناصب سرنگوساریم و پست","این هنرها گردن ما را در قید و بند قرار داده است و به خاطر همین مقام‌ها و شغل‌ها، ما به ذلت و سقوط افتاده‌ایم."],[920,"آن هنر فی جیدنا حبل مسد","روز مردن نیست زان فن‌ها مدد","آن هنر که به گردن ما بسته شده، در روز مرگ هیچ سودی نخواهد داشت و از آن فن‌ها کمکی به ما نمی‌رسد."],[920,"جز همان خاصیت آن خوش‌حواس","که به شب بد چشم او سلطان‌شناس","تنها همان ویژگی خاص است که باعث می‌شود او به همه‌چیز آگاه باشد و در شب، چشمش او را به شناخت سلطان نائل آورد."],[920,"آن هنرها جمله غول راه بود","غیر چشمی کو ز شه آگاه بود","تمام هنرها و استعدادها مانند جلوه‌های بزرگ و شگفت‌انگیز در مسیر زندگی هستند، اما این ویژگی‌ها به تنهایی کافی نیستند؛ تنها چشمی که از پادشاه آگاه باشد، می‌تواند ارزش واقعی آن‌ها را درک کند."],[920,"شاه را شرم از وی آمد روز بار","که به شب بر روی شه بودش نظار","شاه در روز به خاطر وجود آن شخص نسبت به او شرم کرد، زیرا در شب نظاره‌گر چهره‌ی آن شاه بود."],[920,"وان سگ آگاه از شاه وداد","خود سگ کهفش لقب باید نهاد","آن سگ که از وجود و حضور شاه و کارهای او آگاه بود، سزاوار است که لقب «سگ کهف» (یعنی سگ اهل غار و پناه) به او داده شود."],[920,"خاصیت در گوش هم نیکو بود","کو به بانگ سگ ز شیر آگه شود","خصوصیت خوب در گوش داشتن این است که با صدای سگ، شیر را شناسایی کند و از خطر آگاه شود."],[920,"سگ چو بیدارست شب چون پاسبان","بی‌خبر نبود ز شبخیز شهان","سگ، مانند یک پاسبان بیدار است و در شب مراقب است، اما پادشاهان از حالت این پاسبان بی‌خبر هستند و ممکن است به خواب رفته باشند."],[920,"هین ز بدنامان نباید ننگ داشت","هوش بر اسرارشان باید گماشت","باید از بدنامان شرم نکرد و نگران آنها نبود، بلکه باید مواظب رازها و حقایق آنها بود و به دقت به رفتارشان توجه کرد."],[920,"هر که او یک‌بار خود بدنام شد","خود نباید نام جست و خام شد","هر کسی که یک‌بار بر اثر کارهای بدش آبرویش رفت، نباید باز هم به دنبال نام و آوازه برود و احمقانه عمل کند."],[920,"ای بسا زر که سیه‌تابش کنند","تا شود آمن ز تاراج و گزند","بعضی از طلاها را به خاطر رنگ تیره‌شان می‌پوشانند تا از دست دزدان و آسیب‌ها در امان بمانند."],[921,"گاو آبی گوهر از بحر آورد","بنهد اندر مرج و گردش می‌چرد","گاو دریایی که گوهر را از عمق دریا به‌دست آورد، آن را روی مرجان (مرج) می‌گذارد و در آنجا به دور آن می‌چرخد."],[921,"در شعاع نور گوهر گاو آب","می‌چرد از سنبل و سوسن شتاب","گاو آبی در تابش نور گوهر، به سرعت از گل‌های سنبل و سوسن می‌گذرد و می‌چرد."],[921,"زان فکنده گاو آبی عنبرست","که غذااش نرگس و نیلوفرست","گاو آبی که از دریا بیرون آمده، به دلیل غذای خوبی که می‌خورد، یعنی نرگس و نیلوفر، بوی خوش و عطری مانند عنبر دارد."],[921,"هرکه باشد قوت او نور جلال","چون نزاید از لبش سحر حلال","هر کس که قدرت و توانایی او از نور جلال (خداوند) باشد، مانند کسی است که از لبانش کلمات و جملات شیرین و سودمند (سحر حلال) جوشیده می‌شود."],[921,"هرکه چون زنبور وحیستش نفل","چون نباشد خانه او پر عسل","هرکسی که مثل زنبور، وحی و الهامش را از خداوند می‌گیرد، اگر خانه‌اش (قلبش یا وجودش) پر از محبت و نعمت نباشد، مانند زنبور عسلی نخواهد داشت. در واقع، این بیت به اهمیت داشتن درون پاک و پر از عشق در دریافت وحی و الهام اشاره دارد."],[921,"می‌چرد در نور گوهر آن بقر","ناگهان گردد ز گوهر دورتر","گاو در نور درخشان گوهر می‌چرخد و ناگهان از آن گوهر دور می‌شود."],[921,"تاجری بر در نهد لجم سیاه","تا شود تاریک مرج و سبزه‌گاه","تاجر یک چادر سیاه بر درخت می‌زند تا محیط اطراف را تاریک کند و مرج و سبزه‌گاه (مناطق سبز و گل‌زار) را نامشخص و پنهان سازد."],[921,"پس گریزد مرد تاجر بر درخت","گاو جویان مرد را با شاخ سخت","مرد تاجر که در تاریکی مخفی شده بود، وقتی گاو را می‌بیند، به خاطر ترس به درختی پناه می‌برد و از خطر دوشاخی گاو فراری می‌شود."],[921,"بیست بار آن گاو تازد گرد مرج","تا کند آن خصم را در شاخ درج","گاو به مدت بیست بار دور مرجان‌ها می‌چرخد تا اینکه آن دشمن را در شاخش به زمین بیندازد."],[921,"چون ازو نومید گردد گاو نر","آید آنجا که نهاده بد گهر","وقتی گاو نر از به دست آوردن گوهر ناامید شود، به جایی می‌رود که آن گوهر را گذاشته است."],[921,"لجم بیند فوق در شاه‌وار","پس ز طین بگریزد او ابلیس‌وار","بازرگان در حالی که سعی می‌کند خود را پنهان کند، از بالای کوهی که شبیه به شاه است، گاو را زیر نظر دارد و به محض اینکه به تله‌ای که برایش گذاشته شده پی می‌برد، به سرعت فرار می‌کند، طوری که مانند ابلیس است که از چرکی و پلیدی فرار می‌کند."],[921,"کان بلیس از متن طین کور و کرست","گاو کی داند که در گل گوهرست","ابلیس از خاک و گل آفریده شده و به همین دلیل کور و کر است. او نمی‌تواند بداند که گاو (نمادی از حقیقت یا انسان) در درون گل، دارای گوهر و ارزش والایی است."],[921,"اهبطوا افکند جان را در حضیض","از نمازش کرد محروم این محیض","مقصود این بیت این است که اگر انسان خود را به پست‌ترین حال در بیاورد و از دعا و نیایش غافل شود، باید بداند که در این حالت از نور و رحمت الهی محروم خواهد شد."],[921,"ای رفیقان زین مقیل و زان مقال","اتقوا ان الهوی حیض الرجال","ای دوستان، از این حرف‌ها و گفت‌وگوها بر حذر باشید، زیرا عشق، مردان را به ورطه‌ای زباله‌گون می‌کشاند."],[921,"اهبطوا افکند جان را در بدن","تا به گل پنهان بود در عدن","روح خود را در بدن پایین بیاورند تا مانند گلی پنهان در باغ عدن (بهشت) شود."],[921,"تاجرش داند ولیکن گاو نی","اهل دل دانند و هر گل‌کاو نی","تاجر (بازرگان) می‌داند که گاو در دریا گوهرهایی را از قعر دریا پیدا کرده است، اما فقط اهل دل (افرادی با بینش عمیق و غیر معمول) می‌دانند که هر کسی که از گل (پیچیدگی‌های دنیا) برمی‌خیزد، در واقع دارای گوهری در وجود خود است."],[921,"هر گلی که اندر دل او گوهریست","گوهرش غماز طین دیگریست","هر گلی که در دل او زیبایی و ارزش نهفته است، نشان‌دهنده وجود کثیفی و آلودگی دیگری در وجودش می‌باشد."],[921,"وان گلی کز رش حق نوری نیافت","صحبت گلهای پر در بر نتافت","آن گلی که به خاطر عدم شناخت حقیقت و نور حق، نتوانسته در کنار گل‌های دیگر زندگی کند و از آن‌ها لذت ببرد، خود را از محیط و جمع دور کرده است."],[921,"این سخن پایان ندارد موش ما","هست بر لبهای جو بر گوش ما","این جمله نشان می‌دهد که گفت‌وگو یا موضوع مورد نظر همچنان ادامه دارد و به پایان نمی‌رسد. موش به لب‌های نهر جو اشاره دارد و می‌تواند نمایانگر چیزی کوچک و ناچیز باشد که از آن گوش می‌دهیم و این به معنای شنیدن صحبت‌ها یا احوالات متعدد و بی‌پایان است."],[922,"آن سرشته عشق رشته می‌کشد","بر امید وصل چغز با رشد","سر رشته عشق، به مانند یک رشته در احوال انسانی است که امید به وصال معشوق (چغز) را ایجاد می‌کند و به رشد و ترقی او کمک می‌کند."],[922,"می‌تند بر رشته دل دم به دم","که سر رشته به دست آورده‌ام","هر لحظه بر احساسات و عواطف قلبی‌ام افزوده می‌شود، زیرا به این نتیجه رسیده‌ام که می‌توانم ارتباطی عمیق‌تری برقرار کنم."],[922,"هم‌چو تاری شد دل و جان در شهود","تا سر رشته به من رویی نمود","دل و جان مانند تارهایی شده‌اند که در شهود (دید باطنی) و تجلیات الهی به هم پیوسته‌اند، تا اینکه سر رشته این پیوستگی و ارتباط به من روشن و نمایان شود."],[922,"خود غراب البین آمد ناگهان","بر شکار موش و بردش زان مکان","غراب (مقصد: پرنده‌ای که به عنوان نشان‌گر مرگ یا بدی شناخته می‌شود) ناگهان در مکانی که موش بود، ظاهر شد و او را طعمه خودش کرد و از آنجا برد."],[922,"چون بر آمد بر هوا موش از غراب","منسحب شد چغز نیز از قعر آب","وقتی موش از چنگ غراب (زاغ) به هوا پرواز کرد، چغز (پرنده‌ای آبی) نیز از عمق آب بیرون آمد."],[922,"موش در منقار زاغ و چغز هم","در هوا آویخته پا در رتم","موش در چنگال زاغ است و چغز نیز در حال آویختن در آسمان است."],[922,"خلق می‌گفتند زاغ از مکر و کید","چغز آبی را چگونه کرد صید","مردم می‌گفتند زاغ با حیله و نیرنگ چگونه توانست چغز آبی را به دام بیاندازد و شکار کند."],[922,"چون شد اندر آب و چونش در ربود","چغز آبی کی شکار زاغ بود","چغز آبی (نوعی پرنده) وقتی می‌خواست به زیر آب برود و زاغ او را گرفت، به دام افتاد. در این لحظه وضعیت چغز نشان می‌دهد که زاغ در حال شکار او است."],[922,"چغز گفتا این سزای آن کسی","کو چو بی‌آبان شود جفت خسی","چغز (پرنده‌ی آبزی) گفت: این سزا و کیفر آن کسی است که وقتی بی آب و در خطر می‌شود، به سوی افرادی که بی‌کیفیت و بی‌ارزش هستند، روی می‌آورد."],[922,"ای فغان از یار ناجنس ای فغان","هم‌نشین نیک جویید ای مهان","از یار بی‌مروت و نامناسب باید فریاد زد و نالید. نسل‌های خوب و نیک باید در جمع خود، هم‌نشینی با افراد خوب را برگزینند و از آن دوری کنند."],[922,"عقل را افغان ز نفس پر عیوب","هم‌چو بینی بدی بر روی خوب","عقل به خاطر نقص‌های نفس که عیب‌های زیادی دارد، ناله و فریاد می‌زند؛ مانند زمانی که زیبایی را در کسی می‌بینی، ولی بدی‌های او را هم متوجه می‌شوی."],[922,"عقل می‌گفتش که جنسیت یقین","از ره معنیست نی از آب و طین","عقل به او می‌گفت که حقیقت جنس و ماهیت انسان از طریق معانی درونی و فهم درست به دست می‌آید، نه از طریق ظاهر و ماده‌ای مانند آب و خاک."],[922,"هین مشو صورت‌پرست و این مگو","سر جنسیت به صورت در مجو","هادان به شخصی توصیه می‌کند که فریب ظاهر را نخورد و تنها به شکل ظاهری توجه نکند، بلکه در جستجوی حقیقت و ماهیت واقعی چیزها باشد. این بیت به اهمیت شناخت عمق معنی‌ها به جایSurface و ظواهر اشاره دارد."],[922,"صورت آمد چون جماد و چون حجر","نیست جامد را ز جنسیت خبر","ظاهر (صورت) انسان مانند جسم بی‌جان و سفت (جامد) و سنگ (حجر) است و این اجسام سخت از جنسیت واقعی (روح و معنویت) بی‌خبر هستند."],[922,"جان چو مور و تن چو دانه گندمی","می‌کشاند سو به سویش هر دمی","اگر جان انسان مانند مور است که برای رسیدن به دانه گندم تلاش می‌کند، بدن او نیز همانند آن دانه به سمت جانش کشیده می‌شود و در هر لحظه به سمت آن جذب می‌شود."],[922,"مور داند کان حبوب مرتهن","مستحیل و جنس من خواهد شدن","مور می‌داند که این غلات و دانه‌ها در اختیار اوست و او می‌تواند به آن‌ها دست یابد و تبدیل به ماهیت خودش کند."],[922,"آن یکی موری گرفت از راه جو","مور دیگر گندمی بگرفت و دو","یک مور به سمت دانه جو رفت و مور دیگر دانه گندم را برداشت."],[922,"جو سوی گندم نمی‌تازد ولی","مور سوی مور می‌آید بلی","جو به سمت گندم نمی‌رود، اما مور به سمت هم‌نوع خود یعنی دیگر مورها می‌آید."],[922,"رفتن جو سوی گندم تابعست","مور را بین که به جنسش راجعست","به دنبال گندم، جو نمی‌رود؛ اما مور به سمت خود، یعنی به سوی هم‌نوع خود، می‌آید، زیرا او به همان جنس و نوع خود علاقه‌مند است."],[922,"تو مگو گندم چرا شد سوی جو","چشم را بر خصم نه نی بر گرو","نگو چرا گندم به سمت جو می‌رود، چون چشم خود را به دشمن بر نگردانید و نگاه نکنید که چه می‌خواهید."],[922,"مور اسود بر سر لبد سیاه","مور پنهان دانه پیدا پیش راه","مور سیاهی در بالای لبه سیاه (لبه چیزی) پنهانی دانه‌ای را نشان می‌دهد که در جلو راه است."],[922,"عقل گوید چشم را نیکو نگر","دانه هرگز کی رود بی دانه‌بر","عقل می‌گوید به دقت نگاه کن؛ زیرا دانه، هرگز بدون وجود خود نمی‌تواند به جایی برود."],[922,"زین سبب آمد سوی اصحاب کلب","هست صورتها حبوب و مور قلب","به همین دلیل، عیسی (علیه‌السلام) به سمت اصحاب کهف (اصحاب کلب) رفت، زیرا در آنجا ظاهرها زیبا ولی باطن‌ها خراب و آلوده بودند."],[922,"زان شود عیسی سوی پاکان چرخ","بد قفس‌ها مختلف یک جنس فرخ","عیسى (پیامبر) به سوی افراد پاک و نیکوکار می‌رود، زیرا قفس‌ها (دنیاها) با هم متفاوت‌اند، ولی همگی در نهایت از جنس خوشبختی و سعادت هستند."],[922,"این قفس پیدا و آن فرخش نهان","بی‌قفس کش کی قفس باشد روان","این که این قفس (جسم مادی) آشکار است و آن روح لطیف (فرخ) پنهان، نشان می‌دهد که بدون قفس (بدن) هیچ چیز نمی‌تواند آزادانه و روان حرکت کند."],[922,"ای خنک چشمی که عقلستش امیر","عاقبت‌بین باشد و حبر و قریر","ای خوشا به حال چشمی که عقل بر او حاکم است، زیرا او می‌تواند عاقبت‌نگر باشد و آنچه در زندگی پیش می‌آید را به بهترین شکل درک کند."],[922,"فرق زشت و نغز از عقل آورید","نی ز چشمی کز سیه گفت و سپید","فرق زشتی و زیبایی را باید از عقل دانست، نه اینکه به چشمی تکیه کنیم که امور را بر اساس سیاهی و سفیدی قضاوت کند."],[922,"چشم غره شد به خضرای دمن","عقل گوید بر محک ماش زن","چشم به زیبایی و سرسبزی دمنوش (دمن) حسادت می‌کند، در حالی که عقل به انسان می‌گوید که با دقت و ارزیابی صحیح، بر اساس معیارهای درست قضاوت کن و عمل کن."],[922,"آفت مرغست چشم کام‌بین","مخلص مرغست عقل دام‌بین","آفت (خطر) برای پرندگان، نگاه به خوشی‌ها و لذایذ دنیوی است، در حالی که نجات‌دهنده آنها، عقل و اندیشه است که باید به دور از دام‌ها و فریب‌ها باشد."],[922,"دام دیگر بد که عقلش در نیافت","وحی غایب‌بین بدین سو زان شتافت","عقلی که به حقیقت و پرداختن به آن توجه ندارد، نمی‌تواند به درستی راه را درک کند و به سوی نیکی‌ها نرود و فقط از ظواهر دور می‌شود."],[922,"جنس و ناجنس از خرد دانی شناخت","سوی صورت‌ها نشاید زود تاخت","شناختن جنس و ناجنس (چیزهای باارزش و بی‌ارزش) نیاز به خرد دارد و نباید به سرعت به ظواهر و صورت‌ها حکم کرد."],[922,"نیست جنسیت به صورت لی و لک","عیسی آمد در بشر جنس ملک","جنسیت و ویژگی‌های ظاهری، در مورد روح و ماهیت حقیقی انسان ناپایدار و بی‌اهمیت است؛ مانند حضرت عیسی که در قالب بشر آمده است، اما واقعیت او از جنس ملک و روحانی است."],[922,"برکشیدش فوق این نیلی‌حصار","مرغ گردونی چو چغزش زاغ‌وار","او را بالاتر از حصار نیلی، که نشانه‌ای از زیبایی و لطافت است، بلند کرد. همان‌طور که مرغی گردون (پرنده‌ای آسمانی) به شکل زاغ به پرواز در می‌آید."],[923,"بود عبدالغوث هم‌جنس پری","چون پری نه سال در پنهان‌پری","عبدالغوث (که هم‌جنس پری‌ها بود) مانند پری‌ها، نه سال در میان پری‌ها پنهان زندگی کرد."],[923,"شد زنش را نسل از شوی دگر","وآن یتیمانش ز مرگش در سمر","زن عبدالغوث با مرد دیگری ازدواج کرد و بچه‌هایی از او به دنیا آورد و این یتیمان از مرگ پدرشان در سمر (محل زندگی عبدالغوث) رنج می‌برند."],[923,"که مرورا گرگ زد یا ره‌زنی","یا فتاد اندر چهی یا مکمنی","در اینجا مولانا به مسائلی اشاره می‌کند که ممکن است برای آدمی پیش بیاید، مانند اینکه آیا او را گرگ (به معنای خطر) بزند، دزد یا راهزنی‌ او را برباید، یا به جایی بیفتد که نتواند به راحتی خارج شود. این ابیات نشان‌دهنده خطرات و چالش‌های زندگی هستند."],[923,"جمله فرزندانش در اشغال مست","خود نگفتندی که بابایی بدست","فرزندان عبدالغوث در حال مستی و غفلتی به سر می‌بردند و هیچ‌گاه از پدرشان، که گرفتار پریان شده بود، سخن نمی‌گفتند."],[923,"بعد نه سال آمد او هم عاریه","گشت پیدا باز شد متواریه","بعد از نه سال او دوباره پیدا شد و به حالت عاریه درآمد، گویی که به حالت فرار برگشته است."],[923,"یک مهی مهمان فرزندان خویش","بود و زان پس کس ندیدش رنگ بیش","یک ماهی که مهمان فرزندانش بود، دیگر کسی او را بعد از آن ندید و رنگش مشخص نشد."],[923,"برد هم جنسی پریانش چنان","که رباید روح را زخم سنان","او با پریان هم‌جنس و هم‌خویش بود و به همین دلیل، روح او را مانند تیر زخم‌زده‌ای که از سنان (تیری که به بدن می‌خورد) ربوده شود، فرامی‌برد."],[923,"چون بهشتی جنس جنت آمدست","هم ز جنسیت شود یزدان‌پرست","چون افرادی که از جنس بهشت هستند، به سمت بهشت می‌روند، آنها نیز به خاطر هم‌جنس بودن‌شان به خداپرستی متمایل می‌شوند."],[923,"نه نبی فرمود جود و محمده","شاخ جنت دان به دنیا آمده","نبی، یعنی پیامبر اسلام، فرمود که بخشش و خوبی، همانند شاخساره بهشت است که به دنیا آمده و وجود دارد."],[923,"مهرها را جمله جنس مهر خوان","قهرها را جمله جنس قهر دان","همه محبت‌ها را از جنس محبت و عشق بدان، و همه خشم‌ها را از جنس خشم و غضب."],[923,"لاابالی لا ابالی آورد","زانک جنس هم بوند اندر خرد","فردی بی‌پروا و بی‌خیال به این نتیجه رسیده که جنسیت، یعنی ویژگی‌های مردانه و زنانه، در درک و فهم او تأثیر دارد و سبب رفتار او شده است."],[923,"بود جنسیت در ادریس از نجوم","هشت سال او با زحل بد در قدوم","ادریس، که در دانش‌نجوم تخصص داشت، به مدت هشت سال تحت تاثیر سیاره زحل بود و این تأثیر بر او نادرست و نامطلوب بود."],[923,"در مشارق در مغارب یار او","هم‌حدیث و محرم آثار او","یار عبدالغوث در شرق و غرب، دوست و هم‌صحبت اوست و با نشانه‌ها و نشانه‌گذاری‌های او آشنا و رازدار است."],[923,"بعد غیبت چونک آورد او قدوم","در زمین می‌گفت او درس نجوم","پس از غیبتش، وقتی او به زمین آمد، می‌گفت که درس نجوم (علم ستاره‌شناسی) می‌دهد."],[923,"پیش او استارگان خوش صف زده","اختران در درس او حاضر شده","ستارگان زیبا و خوش‌حالت، مانند اختران، در حضور او جمع شده‌اند و در درس او حاضرند."],[923,"آنچنان که خلق آواز نجوم","می‌شنیدند از خصوص و از عموم","انسان‌ها به گونه‌ای به صدای نجوم گوش می‌دادند که گویی این صداها دارای ویژگی‌های خاص و عمومی بودند و همگانی احساس می‌شدند."],[923,"جذب جنسیت کشیده تا زمین","اختران را پیش او کرده مبین","به خاطر کشش و جاذبه‌ای که جنسیت ایجاد کرده، اختران (ستاره‌ها) را به سمت او جذب کرده و او را در این مورد مشاهده می‌کند."],[923,"هر یکی نام خود و احوال خود","باز گفته پیش او شرح رصد","هر یک از پریان نام و احوال خود را به مولانا (یا عبدالغوث) شرح دادند و او را از ویژگی‌های خود مطلع کردند."],[923,"چیست جنسیت یکی نوع نظر","که بدان یابند ره در هم‌دگر","مسئله نوعی از نگاه و تفاهم است که موجب می‌شود انسان‌ها در یکدیگر به یکدیگر نزدیک‌تر شوند و روابط برقرار کنند. این نوع نگاه باعث می‌شود که افراد به خوبی یکدیگر را درک کنند و با هم همدلی کنند."],[923,"آن نظر که کرد حق در وی نهان","چون نهد در تو تو گردی جنس آن","نگاه و تأثیری که خداوند در وجود تو نهفته است، باعث می‌شود که تو به نوع خاصی از وجود و حالت درمی‌آیی. به عبارت دیگر، آنچه خدا در تو قرار داده، موجب تغییر و شکل‌گیری شخصیت و هویت تو می‌شود."],[923,"هر طرف چه می‌کشد تن را نظر","بی‌خبر را کی کشاند با خبر","هر طرفی که انسان به آن نگاه می‌کند، چه بر او فشار بیاورد و چه او را ریاضت دهد، نمی‌تواند فرد بی‌خبر را به آگاهی و شعور برساند."],[923,"چونک اندر مرد خوی زن نهد","او مخنث گردد و گان می‌دهد","هرگاه در وجود مردی، ویژگی‌های زنانه شکل گیرد، او از حالت مردانگی خارج شده و به نوعی ناتوانی یا ضعف دچار می‌شود."],[923,"چون نهد در زن خدا خوی نری","طالب زن گردد آن زن سعتری","وقتی خداوند خوی نرینه را در وجود زن قرار دهد، آن زن به دنبال مردان خواهد رفت و در پی آن خواهد بود."],[923,"چون نهد در تو صفات جبرئیل","هم‌چو فرخی بر هواجویی سبیل","اگر در تو صفات جبرئیل، فرشته‌ای که ویژگی‌های برتر و روحانی دارد، قرار گیرد، همچون بازیگری ماهر در دریا، تو هم در مسیر کسب کمالات و فضائل قرار خواهی گرفت."],[923,"منتظر بنهاده دیده در هوا","از زمین بیگانه عاشق بر سما","عاشقانی که از زمین جدا شده‌اند، چشمانشان را به آسمان دوخته‌اند و در انتظارند. آن‌ها به دلیل دوری از زمین و زندگی معمولی، به تماشای آسمان و دنیای دیگر مشغول شده‌اند."],[923,"چون نهد در تو صفت‌های خری","صد پرت گر هست بر آخر پری","اگر در تو صفات یک الاغ قرار گیرد، صد خاصیت هم که داشته باشد، در نهایت تو را به سوی پری نخواهد برد."],[923,"از پی صورت نیامد موش خوار","از خبیثی شد زبون موش‌خوار","موش، به خاطر ظاهرش وارد میدان نمی‌شود، بلکه به دلیل خباثت و حقارتش به موش‌خوار تبدیل می‌شود."],[923,"طعمه‌جوی و خاین و ظلمت‌پرست","از پنیر و فستق و دوشاب مست","شخصی که طعمه‌جو و خیانتکار است و در ظلمت و تاریکی زندگی می‌کند، به خاطر مواد غذایی مانند پنیر، فندق و شیره (دوشاب) شاد و مسرور می‌شود."],[923,"باز اشهب را چو باشد خوی موش","ننگ موشان باشد و عار وحوش","اگر دوباره به طبیعت موش برگردی، باید بدانی که خوی موش برای تو ننگ و عار خواهد بود و به همین دلیل از وحوش (حیوانات بزرگ و آزاد) خجالت خواهی کشید."],[923,"خوی آن هاروت و ماروت ای پسر","چون بگشت و دادشان خوی بشر","ای پسر، وقتی که خوی هاروت و ماروت (دو فرشته تبهکار در داستان‌های مذهبی) تبدیل به خوی بشر (انسان) شد، خوی آن‌ها هم به تبع تبدیل گردید."],[923,"در فتادند از لنحن الصافون","در چه بابل ببسته سرنگون","آن‌ها در دام و در حالتی غم‌انگیز قرار گرفتند در حالی‌که در صفوف برپا بودند و در جایی مثل بابل، حقیقتا به زمین افتادند و سرنگون شدند."],[923,"لوح محفوظ از نظرشان دور شد","لوح ایشان ساحر و مسحور شد","لوح محفوظ، یعنی سرنوشت یا واقعیت اصلی، از دید آن‌ها دور شد و آن‌ها به نوعی دچار فریب و جادو شدند؛ به این معنا که اوضاع و احوالشان غیر واقعی و جادوئی به نظر می‌رسید."],[923,"پر همان و سر همان هیکل همان","موسیی بر عرش و فرعونی مهان","جنس و ماهیت باطنی انسان‌ها با یکدیگر تغییر نمی‌کند، حتی اگر ظاهرا در موقعیت‌های مختلف باشند؛ مانند موسی (پیامبر) که در عرش است و فرعون که در مقام نازله و ذلت قرار دارد."],[923,"در پی خو باش و با خوش‌خو نشین","خوپذیری روغن گل را ببین","خود را به خوبی و نیکی عادت بده و با آدم‌های خوش‌خلق و خوش‌رفتار معاشرت کن، همان‌طور که روغن گل بوی خوشی دارد و مورد پسند است."],[923,"خاک گور از مرد هم یابد شرف","تا نهد بر گور او دل روی و کف","خاک گور انسان به خاطر همجواری با او ارزش و شرف پیدا می‌کند، تا جایی که دل و دست بر روی آن نعمت می‌گذارد."],[923,"خاک از همسایگی جسم پاک","چون مشرف آمد و اقبال‌ناک","خاک، که از همسایگی با جسم پاک به دست آمده، وقتی که به آن می‌نگرند و مورد توجه قرار می‌گیرد، به غایت جلال و شرف می‌رسد."],[923,"پس تو هم الجار ثم الدار گو","گر دلی داری برو دلدار جو","اگر همسایه خوب و نیکویی داری، باید خانه‌اش را برگزینی و به دنبال معشوق خود بروی. اگر قلبی در سینه‌داری، به سراغ کسی برو که محبوب توست."],[923,"خاک او هم‌سیرت جان می‌شود","سرمه چشم عزیزان می‌شود","خاک (جسم) او با روح و جانش یکی می‌شود و به حالتی از تقدس و ارزش می‌رسد که برای عزیزان مانند سرمه‌ای در چشمشان می‌شود."],[923,"ای بسا در گور خفته خاک‌وار","به ز صد احیا به نفع و انتشار","گاهی فردی در خاک می‌خوابد، اما این خواب او از صد زنده بودن و احیا به نفع و گسترش روح و معنای زندگی ارزشمندتر است."],[923,"سایه برده او و خاکش سایه‌مند","صد هزاران زنده در سایه ویند","او (عبدالغوث) چه بسا در حالتی است که سایه‌اش وجود دارد و خاکش نیز سایه‌مند و در آن سایه، صد هزاران نفر زنده هستند که به نوعی به او و سایه‌اش وابسته‌اند. این اشاره به تاثیر او بر دیگران و زنده بودن نام و یادش دارد."],[924,"آن یکی درویش ز اطراف دیار","جانب تبریز آمد وامدار","یک درویش از دور و نزدیک به شهر تبریز آمد و بدهکار بود."],[924,"نه هزارش وام بد از زر مگر","بود در تبریز بدرالدین عمر","هرگز نمی‌توانست از زر به‌دست‌آوردن هزار وام را فراموش کند، مگر آنکه در تبریز، بدرالدین عمر به او کمک کند."],[924,"محتسب بد او به دل بحر آمده","هر سر مویش یکی حاتم‌کده","محتسب که در زمان حیات به او وظیفه‌ای محول شده بود، اکنون در دل دریا غرق شده و هر یک از موهای او، مانند حاتم (حاتم طایی، مرد generosity) محل بخشش و نیکوکاری شده است. به طور کلی، این بیت به از دست رفتن فرد اشاره دارد که در گذشته نیکوکار بوده و اکنون در انتظار نتیجه اعمالش است."],[924,"حاتم ار بودی گدای او شدی","سر نهادی خاک پای او شدی","اگر حاتم طایی (که به خاطر سخاوتش معروف است) بودی، به عنوان گدا در خدمت او درمی‌آمدی و این‌قدر از او می‌ستایش می‌کردی که حتی سر خود را به خاک پای او می‌گذاشتی."],[924,"گر بدادی تشنه را بحری زلال","در کرم شرمنده بودی زان نوال","اگر به یک تشنه، آب زلالی می‌دادی، به خاطر لطف و کرمت، احساس شرم می‌کردی که به او کمتر از آنچه حق او بوده، کمک کرده‌ای."],[924,"ور بکردی ذره‌ای را مشرقی","بودی آن در همتش نالایقی","اگر مقداری از این مرد را به شرق می‌سپردی، در اثر عظمت و ویژگی‌های او، نادانی به شمار می‌آمدی."],[924,"بر امید او بیامد آن غریب","کو غریبان را بدی خویش و نسیب","آن مرد غریب به امید یاری و کمک آن محتسب به تبریز آمده بود، زیرا او را فردی نیکوکار می‌دانست که به غریبان محبت و کمک می‌کند."],[924,"با درش بود آن غریب آموخته","وام بی‌حد از عطایش توخته","آن مرد غریب که وام‌های زیادی از محتسب گرفته بود، به خاطر نعمت‌ها و بخشش‌های او به او وابسته و متکی شده بود."],[924,"هم به پشت آن کریم او وام کرد","که ببخششهاش واثق بود مرد","این مرد به خاطر اینکه به بخشش‌های آن کریم (محتسب تبریز) امیدوار بود، وام گرفت و به او اعتماد داشت که قرضش را به او می‌بخشد."],[924,"لا ابالی گشته زو و وام‌جو","بر امید قلزم اکرام‌خو","او (وام‌جو) نسبت به آن مرد (محتسب) بی‌توجه شده و در انتظار نعمت و بخشش او است که از شخصیت خوب و کریمی برخوردار است."],[924,"وام‌داران روترش او شادکام","هم‌چو گل خندان از آن روض الکرام","وام‌داران از خوشحالی مثل گل خندان هستند، زیرا به خاطر رحمت و لطف الهی در آن باغ خوشبختی، شاداب و مسرورند."],[924,"گرم شد پشتش ز خورشید عرب","چه غمستش از سبال بولهب","او که تحت فشار و نگرانی است، از اینکه در نور خورشید عرب گرم شده، نگران نیست، چرا که از سبال بولهب (مردی بی‌اهمیت و کم‌ارج) غمی ندارد. این بیان به نوعی به بی‌اعتنایی او به مشکلات و نگرانیش از چیزهای بی‌ارزش اشاره دارد."],[924,"چونک دارد عهد و پیوند سحاب","کی دریغ آید ز سقایانش آب","زمانی که ابر عهد و پیوندی با زمین دارد، از سقاها دریغ نیست که آب را به او اهدا کنند. یعنی هنگام بارش ابر، طبیعی است که باران نازل شود و محال است که سقاها از دادن آب به زمین دریغ کنند."],[924,"ساحران واقف از دست خدا","کی نهند این دست و پا را دست و پا","ساحران (جادوگران) می‌دانند که از قدرت خداوند چه کارها و نشانه‌هایی برمی‌آید، پس نخواهند گذاشت که این دست و پا (یعنی نعمت‌ها و امکانات زندگی) از دست برود."],[924,"روبهی که هست زان شیرانش پشت","بشکند کله پلنگان را به مشت","کسی که در دلش قدرت و شجاعت وجود دارد، به گونه‌ای است که می‌تواند ببرد و برنده شود. او می‌تواند حتی دشمنان قدرتمندی مانند پلنگان را به آسانی شکست دهد."],[925,"چونک جعفر رفت سوی قلعه‌ای","قلعه پیش کام خشکش جرعه‌ای","هنگامی که جعفر به سوی قلعه‌ای رفت، قلعه به شدت تشنه و خشک بود."],[925,"یک سواره تاخت تا قلعه بکر","تا در قلعه ببستند از حذر","یک سوار به سوی قلعه‌ای به نام بکر حرکت کرد تا اینکه در قلعه را به خاطر احتیاط بستند."],[925,"زهره نه کس را که پیش آید به جنگ","اهل کشتی را چه زهره با نهنگ","هیچ‌کس جرأت نمی‌کند به میدان جنگ بیاید، چراکه مانند کشتی‌نشین‌ها در برابر نهنگ، توان و قدرت ندارد."],[925,"روی آورد آن ملک سوی وزیر","که چه چاره‌ست اندرین وقت ای مشیر","آن ملک به وزیر خودش رو کرد و از او پرسید که در این زمان چه تدبیری باید اندیشید."],[925,"گفت آنک ترک گویی کبر و فن","پیش او آیی به شمشیر و کفن","گفت آن وزیر که اگر با کبر و خودپسندی بی‌خبر از حقیقت بی‌رحم بیایی، با شمشیر و کفن (آماده به جنگ و مرگ) نزد او نرو."],[925,"گفت آخر نه یکی مردیست فرد","گفت منگر خوار در فردی مرد","گفتند که این مرد تنها نیست و او حتی نباید به تنهایی دیده شود؛ بنابراین به فردی و تنها بودنش بی‌اعتنا باش."],[925,"چشم بگشا قلعه را بنگر نکو","هم‌چو سیمابست لرزان پیش او","چشم‌هایت را باز کن و قلعه را به خوبی ببین که مانند جیوه در مقابل او می‌لرزد."],[925,"شسته در زین آن‌چنان محکم‌پیست","گوییا شرقی و غربی با ویست","جعفر، که در زینش محکم و استوار نشسته است، به‌قدری قوی و توانمند به نظر می‌رسد که گویی تمامی دنیا، هم شرق و هم غرب، در تسخیر اوست."],[925,"چند کس هم‌چون فدایی تاختند","خویشتن را پیش او انداختند","گروهی از افراد شجاع و فدایی به سوی او هجوم بردند و جان خود را در خطر قرار دادند."],[925,"هر یکی را او بگرزی می‌فکند","سر نگوسار اندر اقدام سمند","هر کسی را که او به کارزار و جنگ می‌فرستد، مانند اینکه سرنگونی‌اش را به سمند (اسب جنگی) خود می‌دهد، به میدان می‌فرستد."],[925,"داده بودش صنع حق جمعیتی","که همی‌زد یک تنه بر امتی","جعل شده بود به برکت خداوند جمعیتی به جعفر که او به تنهایی با آن گروه بزرگ مبارزه می‌کرد."],[925,"چشم من چون دید روی آن قباد","کثرت اعداد از چشمم فتاد","وقتی چشمان من روی قباد، که به عنوان نشانه‌ای از جمعیت و بزرگی شهرت دارد، افتاد، دیگر تعداد افراد گرد او برایم مهم نبود و از ذهنم رفت."],[925,"اختران بسیار و خورشید ار یکیست","پیش او بنیاد ایشان مندکیست","اگرچه ستاره‌های بسیار وجود دارند، اما در مقابل خورشید، همان یک خورشید اهمیت بیشتری دارد و اعتبار سایر ستاره‌ها در مقایسه با او ناچیز است."],[925,"گر هزاران موش پیش آرند سر","گربه را نه ترس باشد نه حذر","اگر هزاران موش در برابر گربه قرار بگیرند، گربه نه ترسی دارد و نه احتیاطی می‌کند، زیرا قدرت و توانایی او از تعداد موش‌ها فراتر است."],[925,"کی به پیش آیند موشان ای فلان","نیست جمعیت درون جانشان","موش‌ها هرگز جرأت نمی‌کنند به جلو بیایند، ای فلانی، زیرا جمعیت واقعی در درون جان آنها وجود ندارد."],[925,"هست جمعیت به صورتها فشار","جمع معنی خواه هین از کردگار","جمعیت واقعی در افراد به شکل ظاهری آن‌ها نیست، بلکه به معنای درونی و روحی آن‌ها وابسته است. بنابراین، باید از جانب خداوند به این معنا توجه کرد."],[925,"نیست جمعیت ز بسیاری جسم","جسم را بر باد قایم دان چو اسم","جمعیت به معنای تعداد زیاد افرادی که در یک جا هستند، تنها به خاطر وجود جسم‌های زیاد نیست، بلکه برای باور و روح درونی آن‌هاست. به عبارت دیگر، تعداد بالا نمی‌تواند اعتبار یک جمع را تضمین کند و ارزش جمع به هویت و معنا بودن افراد آن است."],[925,"در دل موش ار بدی جمعیتی","جمع گشتی چند موش از حمیتی","اگر چه در دل موش جمعیت باشد، اما این جمعیت نمی‌تواند به معنای واقعی قدرتی ایجاد کند؛ چند موش هم که گرد هم بیایند، همچنان ضعیف و ناتوان خواهند ماند."],[925,"بر زدندی چون فدایی حمله‌ای","خویش را بر گربه بی‌مهله‌ای","گربه‌ای که در اینجا به آن اشاره شده، به عنوان نماد قدرت و تهدید است، و فداییان (آدم‌هایی که وفادار به یک رهبری یا هدف هستند) به حمله‌ای تند و شجاعانه دست می‌زنند. بنابراین، این بیت نشان‌دهنده اقدام شجاعانه و بدون تردید آنها در برابر خطری بزرگ است."],[925,"آن یکی چشمش بکندی از ضراب","وان دگر گوشش دریدی هم به ناب","یکی از آن‌ها با ضربه‌ای به چشم دشمن آسیب جدی می‌زند و دیگری هم با ضربه‌ای به گوش او، او را بی‌شنوا می‌کند."],[925,"وان دگر سوراخ کردی پهلوش","از جماعت گم شدی بیرون شوش","و دیگری با ضربه‌ای به پهلوی او آسیب رساند و از جمعیت گم شدی، مانند اینکه صدا در شوش (شاید به معنی یکصدایی یا فریاد) گم شود."],[925,"لیک جمعیت ندارد جان موش","بجهد از جانش به بانگ گربه هوش","اما موش به تنهایی نمی‌تواند از جان خود دفاع کند و با شنیدن صدای گربه، از ترس جانش به فرار برمی‌خیزد."],[925,"خشک گردد موش زان گربه عیار","گر بود اعداد موشان صد هزار","موش، که به خاطر خطر گربه چالاک و زنده‌دل ممکن است خشک شود، هرچقدر هم که تعدادش به صد هزار برسد، باز هم در برابر خطر گربه توانایی نخواهد داشت."],[925,"از رمه انبه چه غم قصاب را","انبهی هش چه بندد خواب را","قصاب از رمه انبه که چیزی به او نمی‌دهد، غم ندارد و خوابش هم به خاطر انبه‌ای که در دست دارد، مختل نمی‌شود. در واقع، او فرقی نمی‌کند که گله یا رمه به او چه کمکی می‌کند."],[925,"مالک الملک است جمعیت دهد","شیر را تا بر گله گوران جهد","شیر که نماینده قدرت و سلطنت است، به ملک و حاکمیت تعلق دارد و از آنجا که او تعداد زیادی جمعیت (یا سرباز) دارد، این توانایی را دارد که بر گروهی از گوران (جوانان یا جنگجویان) تسلط یابد و بر آنها غلبه کند."],[925,"صد هزاران گور ده‌شاخ و دلیر","چون عدم باشند پیش صول شیر","شجاعت و قدرت هزاران گوری که ده شاخ دارند، در برابر شیر (قدرت و مقام) مانند عدم و نیستی است، یعنی هیچ‌چیز به حساب نمی‌آید."],[925,"مالک الملک است بدهد ملک حسن","یوسفی را تا بود چون ماء مزن","مالک الملک (خدا) باید ملک حسن یوسف (شخصیت محترم و محبوب) را به او عطا کند، همان‌طور که آب واضح و زلال به پاشیده نمی‌شود."],[925,"در رخی بنهد شعاع اختری","که شود شاهی غلام دختری","در چهره‌اش نوری می‌تابد که مانند تابش ستاره‌ای است، که او را مانند پادشاهی به غلامی دختری می‌کشاند، یعنی به عشق و محبت دختری که مقام و مرتبه‌ای ویژه دارد."],[925,"بنهد اندر روی دیگر نور خود","که ببیند نیم‌شب هر نیک و بد","در چهره‌اش نور خود را می‌افکند که در تاریکی شب، هر خوبی و بدی را می‌بیند."],[925,"یوسف و موسی ز حق بردند نور","در رخ و رخسار و در ذات الصدور","یوسف و موسی به سبب حق، نوری از خدا دریافت کردند که در چهره و وجودشان، و همچنین در دل‌های دیگران تجلی می‌کند."],[925,"روی موسی بارقی انگیخته","پیش رو او توبره آویخته","موسی، رویی نورانی و درخشان دارد که به‌طرزی چشمگیر جلوه‌گری می‌کند و به همراه خود یک توبره (کیسه‌ای برای حمل بار) دارد."],[925,"نور رویش آن‌چنان بردی بصر","که زمرد از دو دیده مار کر","نور چهره‌اش به قدری درخشان و زیباست که نگاه هر بیننده‌ای را خیره می‌کند و حتی باعث می‌شود که رنگ سبز زمرد از دو چشم مار نیز محو شود."],[925,"او ز حق در خواسته تا توبره","گردد آن نور قوی را ساتره","جعفر از جانب حق خواسته است تا این نور قوی، که به معنای روشنایی و حکمت است، به پوششی مانند توبره تبدیل شود و در پناه آن محفوظ بماند."],[925,"توبره گفت از گلیمت ساز هین","کان لباس عارفی آمد امین","توبره (کیسه یا ظرفی) را از گل درست کن، زیرا این لباس، لباس یک عارف است که مورد اعتماد است و به معنی پاکی و اجتناب از دنیازدگی اشاره دارد."],[925,"کان کسا از نور صبری یافتست","نور جان در تار و پودش تافتست","این لباس از نور صبر به دست آمده و نور جان در بافت و تار و پود آن می‌درخشد."],[925,"جز چنین خرقه نخواهد شد صوان","نور ما را بر نتابد غیر آن","تنها همین لباس عرفانی (خرقه) مانع می‌شود که نور ما دیده شود و هیچ چیز دیگر نمی‌تواند آن نور را تحمل کند."],[925,"کوه قاف ار پیش آید بهرسد","هم‌چو کوه طور نورش بر درد","اگر کوه قاف (یکی از کوه‌های اسطوره‌ای در ادبیات فارسی) به نزدیکی بیاید، نورش مانند نوری که بر کوه طور (کوهی که بر Moses در قرآن نازل شد) تابیده، بر دردها می‌رسد و آن‌ها را شفا می‌دهد یا از بین می‌برد."],[925,"از کمال قدرت ابدان رجال","یافت اندر نور بی‌چون احتمال","از کمال قدرت و نیروی مردان بزرگ، نور و روشنی بی‌نهایتی به وجود می‌آید که در آن هیچ گونه شک و احتمالی نیست."],[925,"آنچ طورش بر نتابد ذره‌ای","قدرتش جا سازد از قاروره‌ای","قدرت او به قدری است که نمی‌تواند هیچ ذره‌ای بر او تاثیر بگذارد و تمامی وجودش مانند یک شیشه، فضایی بس بزرگ و عظیم را در خود جا می‌دهد."],[925,"گشت مشکات و زجاجی جای نور","که همی‌درد ز نور آن قاف و طور","جایگاه نور مانند مشکات (جای نور در دیوار) و زجاج (شیشه) شده است، که این نور به قدری قوی است که از آن کوه قاف و طور (کوهی مقدس) نیز می‌درخشد."],[925,"جسمشان مشکات دان دلشان زجاج","تافته بر عرش و افلاک این سراج","از آن‌جا که جسم آن‌ها مانند مشکات (منبع نور) است، دل‌هایشان نیز مانند زجاج (شیشه) شفاف و روشن است و این روشنایی آن‌ها به عالی‌ترین مقام‌ها و افلاک می‌رسد؛ مثل سراج (چراغ) در آسمان."],[925,"نورشان حیران این نور آمده","چون ستاره زین ضحی فانی شده","نور آن‌ها که حیران است، به اندازه‌ی نوری است که از ستاره می‌تابد، این نور به مانند روشنی روز در حال محو شدن و گذر است."],[925,"زین حکایت کرد آن ختم رسل","از ملیک لا یزال و لم یزل","این حکایت را محمد، پیامبر آخرین، از پادشاهی که همیشه پایدار و ابدی است، نقل کرد."],[925,"که نگنجیدم در افلاک و خلا","در عقول و در نفوس با علا","من به آسمان‌ها و انفس نفوذ نکردم و در افکار و روح‌ها قرار نگرفتم، بلکه در جایگاهی به‌جز آنچه شما می‌پندارید، وجود دارم."],[925,"در دل مؤمن بگنجیدم چو ضیف","بی ز چون و بی چگونه بی ز کیف","در دل مؤمن جا دارم مانند مهمانی که بدون هیچ قید و شرطی و بی‌نیاز از هرگونه چیزی، در آنجا زندگی می‌کند."],[925,"تا به دلالی آن دل فوق و تحت","یابد از من پادشاهی‌ها و بخت","دل مؤمن می‌تواند به واسطه دلالت و راهنمایی، به قوت و قدرتی دست یابد که بالاتر و پایین‌تر از آن را درک کند و به صورت پادشاهی‌ها و بخت‌های مختلف در زندگی‌اش تجربه کند."],[925,"بی‌چنین آیینه از خوبی من","برنتابد نه زمین و نه زمن","بدون چنین آینه‌ای، خوبی من نه بر زمین می‌تابد و نه در زمان، یعنی هیچ‌چیز نمی‌تواند زیبایی و خوبی من را به نمایش بگذارد."],[925,"بر دو کون اسپ ترحم تاختیم","پس عریض آیینه‌ای بر ساختیم","ما بر جهان و ماورای آن به سرعت حرکت کردیم و در این مسیر، آینه‌ای وسیع و بزرگ به وجود آوردیم که نشان‌دهنده‌ی زیبایی‌ها و خوبی‌هایمان است."],[925,"هر دمی زین آینه پنجاه عرس","بشنو آیینه ولی شرحش مپرس","هر لحظه از این آینه، پنجاه نوع آواز و نغمه را بشنو، اما در مورد معنی و توضیح آن، سؤال نکن و از آن نگذریم."],[925,"حاصل این کزلبس خویشش پرده ساخت","که نفوذ آن قمر را می‌شناخت","این بیت اشاره دارد به این که شخصی با لباس و ظاهری ویژه، چنان تأثیری بر دیگران می‌گذارد که می‌تواند حتی قمر (نماد زیبایی) را بشناسد. به نوعی، شخصیت و ظاهری که فرد به خود می‌گیرد، بر قدرت درک و نفوذ او می‌افزاید."],[925,"گر بدی پرده ز غیر لبس او","پاره گشتی گر بدی کوه دوتو","اگر پرده غیر از لباس او را پاره کنی، به حدی نزدیک می‌شوی که گویی به دو کوه تقسیم می‌شوی."],[925,"ز آهنین دیوارها نافذ شدی","توبره با نور حق چه فن زدی","تو با نور حق به آسانی از دیوارهای آهنین عبور کردی، این نشان‌دهنده قدرت و تأثیر شگفت‌انگیز تو است."],[925,"گشته بود آن توبره صاحب تفی","بود وقت شور خرقه عارفی","توبره‌ای که به نور حق نفوذ کرده بود، حالا در دست شخصی بود که دارای تفکر عمیق و الهام‌بخش بود و در زمان بحران، به لباس عارفی دامن زده بود."],[925,"زان شود آتش رهین سوخته","کوست با آتش ز پیش آموخته","آتش خامی که سوخته و در حال حاضر گرفتار آتش شده، به خاطر آن است که آموزشی از آتش قبلی دیده و تجربه کرده است. این بیان می‌کند که آتش، درسی از آتش پیشین را به همراه دارد و به همین خاطر سوختگی او تاثیرگذارتر است."],[925,"وز هوا و عشق آن نور رشاد","خود صفورا هر دو دیده باد داد","از سرشت و عشق، آن نور آگاهی‌بخش (رشاد) خود را به صفورا (همسر پیامبر، عایشه) عطا کرد، که هر دو چشمش را روشن می‌سازد."],[925,"اولا بر بست یک چشم و بدید","نور روی او و آن چشمش پرید","در ابتدا با یک چشمش بسته، نور چهره او را دید و آن چشمش به خاطر زیبایی او از دستش رفت."],[925,"بعد از آن صبرش نماند و آن دگر","بر گشاد و کرد خرج آن قمر","بعد از آن، تحمل جعفر کم شد و او بر طرف مقابل گشاده‌دلانه لطف کرد و ثروت و امکانات خود را به حیاتبخشید."],[925,"هم‌چنان مرد مجاهد نان دهد","چون برو زد نور طاعت جان دهد","مرد مجاهد همچنان که نان و غذای دیگران را تأمین می‌کند، وقتی در راه اطاعت و عبادت باشد، جان خود را نیز فدای آن می‌کند."],[925,"پس زنی گفتش ز چشم عبهری","که ز دستت رفت حسرت می‌خوری","زنی به جعفر می‌گوید که از چشمان برافروخته‌اش پیداست که بابت چیزی که از دست داده، احساس حسرت و اندوه می‌کند."],[925,"گفت حسرت می‌خورم که صد هزار","دیده بودی تا همی‌کردم نثار","می‌گوید که حسرت می‌خورم بر اینکه صد هزار چشم می‌توانستم داشته باشم تا به خاطر عشق و محبت خود را نثار کنم."],[925,"روزن چشمم ز مه ویران شدست","لیک مه چون گنج در ویران نشست","چشمم مانند خرابه‌ای شده است که به خاطر زیبایی ماه و وجوه دل‌ربایش ویران شده، اما همچنان زیبایی ماه مانند گنجی در این خرابه جا دارد."],[925,"کی گذارد گنج کین ویرانه‌ام","یاد آرد از رواق و خانه‌ام","چگونه ممکن است گنجی که در این ویرانه وجود دارد، به یاد خانه و محیط من بیفتد؟"],[925,"نور روی یوسفی وقت عبور","می‌فتادی در شباک هر قصور","زمانی که یوسف (علیه‌السلام) عبور می‌کرد، نور چهره‌اش بر هر دژی در شب می‌افتاد و آن را روشن می‌کرد."],[925,"پس بگفتندی درون خانه در","یوسفست این سو به سیران و گذر","ساکنان خانه گفتند که یوسف در این طرف برای سیر و عبور است."],[925,"زانک بر دیوار دیدندی شعاع","فهم کردندی پس اصحاب بقاع","چون در دیوار شعاعی را دیدند، فهمیدند که در آن مکان، دوستان و یاران آگاهی حضور دارند."],[925,"خانه‌ای را کش دریچه‌ست آن طرف","دارد از سیران آن یوسف شرف","دریچه‌ای در آن سمت وجود دارد که به خانه‌ای باز می‌شود و آن خانه، مربوط به یوسف است که از سیران، مقام و ارزش والایی دارد."],[925,"هین دریچه سوی یوسف باز کن","وز شکافش فرجه‌ای آغاز کن","دریچه را به سوی یوسف بگشایید و از شکاف آن فرصتی برای رویارویی و ارتباط با او ایجاد کنید."],[925,"عشق‌ورزی آن دریچه کردنست","کز جمال دوست سینه روشنست","عشق ورزیدن یعنی گشودن دریچه‌ای به سوی جمال دوست که باعث روشنی دل و سینه انسان می‌شود."],[925,"پس هماره روی معشوقه نگر","این به دست تست بشنو ای پدر","همیشه به چهره معشوق خود نگاه کن، زیرا این کار به تو کمک می‌کند و درک عمیق‌تری از عشق و زندگی به دست می‌آوری، ای پدر."],[925,"راه کن در اندرونها خویش را","دور کن ادراک غیراندیش را","خود را از درون پاک کن و به دور اندیشی و تفکر بیهوده بپرداز، زیرا این نوع تفکر برای تو مفید نیست و تو را از حقیقت دور می‌کند."],[925,"کیمیا داری دوای پوست کن","دشمنان را زین صناعت دوست کن","تو دارویی جادویی (کیمیا) داری که می‌تواند دشمنان را به دوستی تبدیل کند، پس از این هنر (صنعت) برای دوستی کردن با آن‌ها استفاده کن."],[925,"چون شدی زیبا بدان زیبا رسی","که رهاند روح را از بی‌کسی","وقتی به زیبایی رسیدی، بدان که باید به زیبایی‌های دیگر هم دست یابی تا روح خود را از تنهایی نجات دهی."],[925,"پرورش مر باغ جانها را نمش","زنده کرده مرده غم را دمش","پرورش باغ جان‌ها سبب زنده شدن روح‌های خفته و غمگین است؛ بنابراین، دم و نفس آن شخص که باغ را می‌پرورد، توانایی احیای مردگان را دارد."],[925,"نه همه ملک جهان دون دهد","صد هزاران ملک گوناگون دهد","نه همه ملک‌های دنیا، بی‌ارزش و پست است؛ بلکه هزاران ملک مختلف و با ارزش وجود دارد که می‌توان از آنها بهره‌مند شد."],[925,"بر سر ملک جمالش داد حق","ملکت تعبیر بی‌درس و سبق","خداوند در خصوص کشور زیبایی و جمال او، برای این سرزمین حکمی صادر کرده که از آن دسته‌ای به‌دست نمی‌آید که علم و آگاهی ندارند و به صرف درس و تجربه به آن نمی‌رسند."],[925,"ملکت حسنش سوی زندان کشید","ملکت علمش سوی کیوان کشید","ملک حسن، به خاطر زیبایی‌اش به بند کشیده شد و در حالی که ملک علم به آسمان‌ها و مقام‌های بالا رفته و به کیوان (شبه‌زرین) نزدیک شده است."],[925,"شه غلام او شد از علم و هنر","ملک علم از ملک حسن استوده‌تر","ملک علم (علم) در برابر ملک حسن (حسن) توانا و برتر است، زیرا شه (سلطان) به خاطر دانش و هنر او غلام و تحت تاثیر او شده است."],[926,"آن غریب ممتحن از بیم وام","در ره آمد سوی آن دارالسلام","شخص غریب و آزموده (که در امتحان آن محتسب به فکر وام افتاده) به خاطر ترس از مشکل وام، به سوی آن شهر آرامش و امنیت (دارالسلام) آمده است."],[926,"شد سوی تبریز و کوی گلستان","خفته اومیدش فراز گل ستان","او به سمت تبریز و منطقه گلستان حرکت کرد و امیدش بر این بود که در آنجا به گل و زیبایی دست یابد."],[926,"زد ز دارالملک تبریز سنی","بر امیدش روشنی بر روشنی","او از دارالملک تبریز بیرون رفت و با امید به روشنایی و نجات، به روشنی‌های بیشتری فکر می‌کند."],[926,"جانش خندان شد از آن روضه رجال","از نسیم یوسف و مصر وصال","او از یادآوری زیبایی‌های مردان بزرگ و نسیم خوش بوی یوسف و وصالش به مصر، خوشحال و شاداب شده است."],[926,"گفت یا حادی انخ لی ناقتی","جاء اسعادی و طارت فاقتی","او گفت: «ای راهنما، ناقه‌ام را بیاور که خوشحالی‌ام به دنبال آن آمده و دلم سبک شده است."],[926,"ابرکی یا ناقتی طاب الامور","ان تبریزا مناخات الصدور","ای ابر، ای شتر، اوضاع در تبریز خوب است و دل‌ها در آنجا آرامش می‌یابند."],[926,"اسرحی یا ناقتی حول الریاض","ان تبریزا لنا نعم المفاض","بادها یا شترهایی به سمت باغ‌های تبریز در حال حرکت‌اند که برای ما نعمت‌های زیادی به ارمغان می‌آورند."],[926,"ساربانا بار بگشا ز اشتران","شهر تبریزست و کوی گلستان","ساربانا، بار روی شترها را باز کن، چون شهر تبریز و کوی گلستان در انتظار توست."],[926,"فر فردوسیست این پالیز را","شعشعه عرشیست این تبریز را","این باغ (پالیز) از نسل فردوسی است و نور و روشنایی این شهر (تبریز) مانند شعله‌های آسمانی می‌درخشد."],[926,"هر زمانی نور روح‌انگیز جان","از فراز عرش بر تبریزیان","در هر زمان، نوری که روح را شاداب و زنده می‌کند، از بالای عرش بر مردم تبریز می‌تابد."],[926,"چون وثاق محتسب جست آن غریب","خلق گفتندش که بگذشت آن حبیب","وقتی که محتسب (بازرس) وثاق (ماجرای) آن غریب (مسافر یا شخص غریبه) را بررسی کرد، دیگران به او گفتند که محبوبش (دوست یا عزیز او) از دنیا رفته است."],[926,"او پریر از دار دنیا نقل کرد","مرد و زن از واقعه او روی‌زرد","آن شخص که در دنیا زندگی می‌کرد، از دنیای فانی و مادی رخت بر بست و به عالم دیگر رفت؛ مردان و زنان از ماجرای او متعجب و نگران شدند و چهره‌شان از این واقعه رنگ‌باخته شد."],[926,"رفت آن طاوس عرشی سوی عرش","چون رسید از هاتفانش بوی عرش","آن طاوس که نماد جمال و زیبایی است، به سوی عرش (مقام والای الهی) حرکت کرد و هنگام رسیدن به آنجا، بوی خوشی از هاتفان (فرشتگان یا موجودات الهی) به مشامش رسید."],[926,"سایه‌اش گرچه پناه خلق بود","در نوردید آفتابش زود زود","سایه‌اش که بر روی مردم پناه می‌داد، اما آفتابش به سرعت تابید و همه چیز را روشن کرد. این بیت اشاره به این دارد که وجود یک شخص می‌تواند مایه‌ی آرامش و پناه برای دیگران باشد، اما حقیقت و واقعیت به زودی نمایان می‌شود."],[926,"راند او کشتی ازین ساحل پریر","گشته بود آن خواجه زین غم‌خانه سیر","مردی که در غم و اندوه است، از این ساحل که آرامش ندارد، به دریا رفته است و کشتی‌اش را راند. آن خواجه (شخصی با مقام یا موقعیت) به علت غم این مکان، خسته و دل‌زده شده بود."],[926,"نعره‌ای زد مرد و بیهوش اوفتاد","گوییا او نیز در پی جان بداد","مردی نعره‌ای زد و بی‌هوش بر زمین افتاد، گویی او هم در پی جانش از دست رفته است."],[926,"پس گلاب و آب بر رویش زدند","همرهان بر حالتش گریان شدند","همراهان او، وقتی او بی‌هوش افتاده بود، بر او گل و آب پاشیدند و با دیدن حال او گریه کردند."],[926,"تا به شب بی‌خویش بود و بعد از آن","نیم مرده بازگشت از غیب جان","او تا نیمه‌های شب بدون خود بود و پس از آن به‌طرز نیمه‌مرده‌ای به حالت طبیعی‌اش بازگشت، از حالتی که در آن به جنبه‌ای دیگر رفته بود، به زندگی عادی‌اش برگشت."],[927,"چون به هوش آمد بگفت ای کردگار","مجرمم بودم به خلق اومیدوار","وقتی به خود آمد، گفت: ای پروردگار، من در برابر مخلوق مجرم بودم و به آن‌ها امید داشتم."],[927,"گرچه خواجه بس سخاوت کرده بود","هیچ آن کفو عطای تو نبود","با اینکه خواجه (شخص بخشنده) بسیار بخشش کرده بود، اما هیچ‌کدام از آن عطاها و نعمت‌های او ارزش برابری با بخشش و عطای تو (خدا) را نداشت."],[927,"او کله بخشید و تو سر پر خرد","او قبا بخشید و تو بالا و قد","او (خواجه) تمام سر و صورتش را برای تو بخشید، در حالی که تو روح و اندیشه‌اش را به او عطا کردی؛ او (خواجه) از تن خود لباس زیبا و گران‌بهایی را بخشید و تو به او قامت و زیبایی بخشیدی."],[927,"او زرم داد و تو دست زرشمار","او ستورم داد و تو عقل سوار","او نیکی‌ها و نعمت‌های زیادی به تو داده و تو با دست خود نعمت‌های او را شمارش می‌کنی، همچنین او در وجود تو عقل و فهم قرار داده، و تو با آن عقل بر مرکب‌های زندگی‌ات سوار می‌شوی."],[927,"خواجه شمعم دادو تو چشم قریر","خواجه نقلم داد و تو طعمه‌پذیر","خواجه (پروردگار) به من نور داد و تو ای عاقل و زیرک، دیدی روشن را دریافتی. او به من زندگی و تمامی وسایل زندگی را عطا کرد، و تو به راحتی و آسانی به آن‌ها بهره‌وری می‌کنی."],[927,"او وظیفه داد و تو عمر و حیات","وعده‌اش زر وعده تو طیبات","خداوند به تو وظیفه‌ای داد و تو را از نعمت عمر و حیات بهره‌مند کرد. وعده او پربار و ارزشمند است، اما وعده تو تنها چیزهای خوش‌مزه و زودگذر را به همراه دارد."],[927,"او وثاقم داد و تو چرخ و زمین","در وثاقت او و صد چون او سمین","خدا به انسان آزادی و قدرت داد، اما انسان باید بداند که همه چیز به دست خداوند است و اعتمادش نباید فقط به دنیا و مخلوقات محدود باشد؛ زیرا اگر به خدا اعتماد کند، دنیا و زمین نیز در قدرت او خواهد بود."],[927,"زر از آن تست زر او نافرید","نان از آن تست نان از تش رسید","تمام ثروت و زینت‌ها از آن توست و هیچ‌کس دیگری نمی‌تواند آنها را بیافریند. همچنین نانی که در زندگی به دست می‌آوریم نیز از جانب توست و ما تنها به وسیله تلاش خود به آن می‌رسیم."],[927,"آن سخا و رحم هم تو دادیش","کز سخاوت می‌فزودی شادیش","سخاوت و رحم، از توست و تو به من اینان را عطا کردی، که به واسطه سخاوت تو، شادی من هم روزافزون می‌شود."],[927,"من مرورا قبله خود ساختم","قبله‌ساز اصل را انداختم","من به روش خود، قبله‌ای برای خود درست کردم و نقطه اصلی قبله‌ساز را که باید به آن توجه می‌شد، کنار گذاشتم."],[927,"ما کجا بودیم کان دیان دین","عقل می‌کارید اندر آب و طین","ما در گذشته کجا بودیم که دینداران و عالمان دین، اصول عقل را در محیطی مادی و دنیوی (یعنی در آب و گل) می‌کاشتند و پرورش می‌دادند؟"],[927,"چون همی کرد از عدم گردون پدید","وین بساط خاک را می‌گسترید","چون خداوند از عدم، آسمان و زمین را به وجود آورد و این دنیا را پدید آورد."],[927,"ز اختران می‌ساخت او مصباح‌ها","وز طبایع قفل با مفتاح‌ها","او از ستاره‌ها چراغ‌هایی می‌ساخت و با طبیعت‌ها قفل‌ها را با کلیدها باز می‌کرد."],[927,"ای بسا بنیادها پنهان و فاش","مضمر این سقف کرد و این فراش","بسیاری از بنیان‌ها و زیرساخت‌های هستی به صورت پنهان وجود دارند و خود را نشان نمی‌دهند؛ همان‌طور که این سقف (جهان) و این بستر (فراش) بر روی آن بنیادها قرار گرفته‌اند."],[927,"آدم اصطرلاب اوصاف علوست","وصف آدم مظهر آیات اوست","آدم همچون اصطرلاب (دستگاهی برای سنجش و شناخت اجسام) به ویژگی‌های علو (عظمت و بلندی) اشاره دارد. همچنین، آدم به عنوان مظهر آیات الهی، نشانگر تجلی نشانه‌های خداوندی است."],[927,"هرچه در وی می‌نماید عکس اوست","هم‌چو عکس ماه اندر آب جوست","هر چیزی که در وجود آدم دیده می‌شود، تصویری از وجود حق است، مانند تصویر ماه که در آب جو دیده می‌شود."],[927,"بر صطرلابش نقوش عنکبوت","بهر اوصاف ازل دارد ثبوت","نقوش عنکبوت بر صطرلاب (ابزاری برای اندازه‌گیری) او ثابت و واضح است و این نقوش نشان دهنده اوصاف مجرد و ابدی خداوند هستند."],[927,"تا ز چرخ غیب وز خورشید روح","عنکبوتش درس گوید از شروح","از آسمان غیب و از نور روحانی که به‌سان خورشید است، عنکبوت او (که نمادی از روح یا خلقیات اوست) از معانی و درس‌هایی می‌آموزد که در توصیف‌ها آمده است."],[927,"عنکبوت و این صطرلاب رشاد","بی‌منجم در کف عام اوفتاد","عنکبوت و ساز و کار پیچیده‌اش بدون کمک منجم و علم غیب، در دست عموم مردم افتاده است."],[927,"انبیا را داد حق تنجیم این","غیب را چشمی بباید غیب‌بین","خداوند به پیامبران قابلیت تفسیر این امور غیبی را داده است، برای درک چنین حقایقی نیاز به چشمی است که توانایی دیدن غیب را داشته باشد."],[927,"در چه دنیا فتادند این قرون","عکس خود را دید هر یک چه درون","این دوران‌ها در چاه دنیا افتاده‌اند و هر کدام از آن‌ها درون این چاه، تصویر خود را مشاهده کرده‌اند. به معنای دیگر، انسان‌ها در این دنیا در دام‌های مختلف گرفتار آمده‌اند و هر یک در این حالت به تأمل در سرنوشت و واقعیت خود می‌پردازند."],[927,"از برون دان آنچ در چاهت نمود","ورنه آن شیری که در چه شد فرود","بیرون را ببین که در چاه تو چه بر تو گذشت، وگرنه آن شیری که در چاه افتاده است، غافل از آنچه به او رخ داده، باقی می‌ماند."],[927,"برد خرگوشیش از ره کای فلان","در تگ چاهست آن شیر ژیان","خرگوش به تظاهری بی‌خبر از خطر شیر که در چاه کمین کرده است، به سمت آن شخصی که او را \"فلان\" خطاب کرده، می‌رود و مانند کسی که در چاه گرفتار شده، بی‌احتیاطی نشان می‌دهد."],[927,"در رو اندر چاه کین از وی بکش","چون ازو غالب‌تری سر بر کنش","اگر تو در چاه به این فرد (محتسب) حمله کنی و او را بکشی، چون بر او تسلط پیدا کرده‌ای، باید از او بالاتر بیایی و خودت را نشان دهی."],[927,"آن مقلد سخره خرگوش شد","از خیال خویشتن پر جوش شد","مقلد، به خاطر تصویر ذهنی و خیالی که از خودش دارد، رفتاری شبیه به خرگوش پیدا کرده و تحت تأثیر آن خیال به هیجان آمده است."],[927,"او نگفت این نقش داد آب نیست","این به جز تقلیب آن قلاب نیست","او نگفت که این تصویر و نقش، واقعی و خدایی است؛ بلکه اشاره کرد که این فقط یک ترفند و فریبی است که به وسیله آن، قلابی برای فریب دادن دیگران ساخته شده است."],[927,"تو هم از دشمن چو کینی می‌کشی","ای زبون شش غلط در هر ششی","اگر تو هم از دشمن کینه به دل داری، مانند کسی هستی که در هر شش حسش به اشتباه می‌افتد و به غفلت دچار می‌شود."],[927,"آن عداوت اندرو عکس حقست","کز صفات قهر آنجا مشتقست","عداوتی که در او وجود دارد، نمایانگر صفات قهری است که از خداوند ناشی می‌شود. به عبارت دیگر، این خصومت نشانه‌ای از قهر و غضب الهی است."],[927,"وآن گنه در وی ز جنس جرم تست","باید آن خو را ز طبع خویش شست","آن گناهی که در وجود او وجود دارد، از نوع خطای خود اوست و باید آن عادت را از ذات و طبیعت خود پاک کند."],[927,"خلق زشتت اندرو رویت نمود","که ترا او صفحه آیینه بود","زشت‌هایی که در درونت وجود دارد، در اینجا بر روی تو آشکار شده است، زیرا او (آیینه) تنها منعکس‌کننده‌ی واقعیات درون توست."],[927,"چونک قبح خویش دیدی ای حسن","اندر آیینه بر آیینه مزن","وقتی که زشتی‌های خود را در آیینه دیدی، ای زیبایی، به آیینه نزن، یعنی به خودت نگاه نکن و در مورد زیبایی‌ها و زشتی‌ها قضاوت نکن."],[927,"می‌زند بر آب استاره سنی","خاک تو بر عکس اختر می‌زنی","خاک تو بر روی آب ستاره‌ای خوشبو و خوب است، اما برعکس آن، این خاک با نور اخترهای بددرخشنده می‌افتد."],[927,"کین ستاره نحس در آب آمدست","تا کند او سعد ما را زیردست","این بیت به این معناست که ستاره‌ی شوم (نحس) در آب ظاهر شده و این نشان می‌دهد که او قرار است سعادت ما را در زیر کنترل خود بگیرد. به عبارتی، وجود این ستاره‌ی نحس باعث خواهد شد که سرنوشت ما به سمت نامساعدی پیش رود."],[927,"خاک استیلا بریزی بر سرش","چونک پنداری ز شبهه اخترش","خاک تسلیم و خضوع بر سر او بپاش، چون فکر می‌کنی که به خاطر شبهه‌ای (یا ستاره‌ای) به او اعتنا کرده‌ای."],[927,"عکس پنهان گشت و اندر غیب راند","تو گمان بردی که آن اختر نماند","عکس به معنای تصویر یا نشانه‌است و در اینجا به حالت پنهان و غیبت اشاره دارد. بنابراین، تصویری که پنهان شده و در عالم غیب رفته، تو را به اشتباه انداخته است و گمان کرده‌ای که آن ستاره (اختر) دیگر وجود ندارد."],[927,"آن ستاره نحس هست اندر سما","هم بدان سو بایدش کردن دوا","ستاره بدشگون در آسمان وجود دارد و برای درمان آن، باید به سمت همان ستاره توجه کرد و اقدام کرد."],[927,"بلک باید دل سوی بی‌سوی بست","نحس این سو عکس نحس بی‌سو است","باید دل را به سوی خداوندی که در غیر او هیچ چیز نیکو نیست، متوجه کرد، زیرا نحسی که در یک سو وجود دارد، در سمت دیگر به شکل عکسش درستی و نیکی وجود دارد."],[927,"داد داد حق شناس و بخششش","عکس آن دادست اندر پنج و شش","داد و بخشش خداوند حق‌شناس است و این بخشش، مانند یادآوری و اثر آن، در مقام پاداش و کیفر در عالم دیگر به شکل محاسبه اعمال و ویژگی‌های انسانی ظاهر می‌شود."],[927,"گر بود داد خسان افزون ز ریگ","تو بمیری وآن بماند مردریگ","اگر داد و بخشش کسانی که حق‌شناس نیستند، بیشتر از تعداد دانه‌های شن باشد، تو از این دنیا می‌روی و تنها گنجایش آن بندگان ناقص را در خاطر خود باقی می‌گذاری."],[927,"عکس آخر چند پاید در نظر","اصل بینی پیشه کن ای کژنگر","برای چند لحظه به عقب برگرد و حقیقت را در نظر بیاور. ای کسی که به درستی نمی‌نگری، کوشش کن تا با دیدی درست به مسائل نگاه کنی."],[927,"حق چو بخشش کرد بر اهل نیاز","با عطا بخشیدشان عمر دراز","خداوند وقتی که به نیازمندان بخشش می‌کند، زندگی طولانی و عمر فراوان به آنها عطا می‌کند."],[927,"خالدین شد نعمت و منعم علیه","محیی الموتاست فاجتازوا الیه","نعمت‌ها جاودانه و ماندگار شدند و کسی که این نعمت‌ها را داده، زنده‌کننده‌ی مردگان است، بنابراین آن‌ها (نعمت‌دیدگان) به سوی او حرکت کنند."],[927,"داد حق با تو در آمیزد چو جان","آنچنان که آن تو باشی و تو آن","حق به تو عطا می‌شود و در تو توأم با جانت می‌آمیزد، به گونه‌ای که تو به او تعلق پیدا می‌کنی و او نیز به تو."],[927,"گر نماند اشتهای نان و آب","بدهدت بی این دو قوت مستطاب","اگر نیاز به نان و آب نباشد، خداوند به تو قوتی عظیم می‌دهد که حتی بدون این دو لازم برای زندگی، می‌توانی زندگی کنی."],[927,"فربهی گر رفت حق در لاغری","فربهی پنهانت بخشد آن سری","حتی اگر بدنت لاغر شود و نعمت‌های ظاهری را از دست بدهی، خداوند به تو برکت و سعادت پنهانی می‌بخشد که از آن بی‌خبری."],[927,"چون پری را قوت از بو می‌دهد","هر ملک را قوت جان او می‌دهد","هر موجودی از وجود و توانایی‌اش به واسطه وجود دیگری قوت می‌گیرد؛ مانند اینکه پری منبع قوتش از بو است و هر ملک (فرشته) نیز به واسطه جان و زندگی‌اش از نیروی خداوند بهره‌مند می‌شود."],[927,"جان چه باشد که تو سازی زو سند","حق به عشق خویش زنده‌ت می‌کند","جان چه ارزشی دارد که تو برای آن سند و مدرک درست کنی، در حالی که عشق او (الله) تو را زنده نگه می‌دارد؟"],[927,"زو حیات عشق خواه و جان مخواه","تو ازو آن رزق خواه و نان مخواه","از عشق او زندگی بخواه و جان خود را نخواسته بگذار. تو از او روزی و رزق طلب کن و نان نخواه."],[927,"خلق را چون آب دان صاف و زلال","اندر آن تابان صفات ذوالجلال","مخلوقات را مانند آب زلال و صاف بدانی که ویژگی‌های خداوند (ذوالجلال) در آن روشن و تابناک است."],[927,"علمشان و عدلشان و لطفشان","چون ستاره چرخ در آب روان","در این بیت، مولانا به صفت‌های علم، عدالت و لطف خداوند اشاره می‌کند و می‌گوید این ویژگی‌ها همچون ستاره‌هایی در آسمان هستند که در آب روان می‌درخشند، یعنی خلوص و زیبایی آنها در دنیا و در دل مردم آشکار است."],[927,"پادشاهان مظهر شاهی حق","فاضلان مرآت آگاهی حق","پادشاهان مظهر شاهی حق /عارفان مرآت آگاهی حق.... پادشاه نگهبانان راستی و پاکی خدا و عرفان نشاندهنده علم و آگاهی خدا هستند"],[927,"قرنها بگذشت و این قرن نویست","ماه آن ماهست آب آن آب نیست","بسیاری از سال‌ها سپری شده و این زمان (یعنی زمان حال) جدید است؛ هرچند که در ظاهر این زمان به ماه و آب گذشته شباهت دارد، اما ماه و آب همچنان آن‌ها نیستند و تفاوت دارند."],[927,"عدل آن عدلست و فضل آن فضل هم","لیک مستبدل شد آن قرن و امم","عدل و فضل واقعی همان هستند، ولی زمان و نسل‌ها تغییر یافته‌اند و این موارد دیگر مانند گذشته نیستند."],[927,"قرنها بر قرنها رفت ای همام","وین معانی بر قرار و بر دوام","ای همام، قرن‌ها بر روی قرن‌ها گذشته است، اما این معانی همچنان ثابت و پایدار مانده‌اند."],[927,"آن مبدل شد درین جو چند بار","عکس ماه و عکس اختر بر قرار","در این دنیا، جوّ و فضای موجود چند بار تغییر می‌کند و در این تغییرات، مانند اینکه تصویر ماه و ستاره‌ها در آب منعکس می‌شود، تصویرهای مختلفی نمایان می‌شود."],[927,"پس بنااش نیست بر آب روان","بلک بر اقطار عرض آسمان","بی‌توجهی و ثبات بر ناپایدار بودن چیزها (مانند آب روان) نیست، بلکه باید بر گستره و وسعت آسمان (که نماد پایداری است) تکیه کرد."],[927,"این صفتها چون نجوم معنویست","دانک بر چرخ معانی مستویست","این ویژگی‌ها مانند ستاره‌های معنوی هستند که بر دور چرخ معانی قرار دارند."],[927,"خوب‌رویان آینه خوبی او","عشق ایشان عکس مطلوبی او","خوش‌چهرگان، آینه‌ای از خوبی خداوند هستند و عشق آن‌ها نشان می‌دهد که خداوند اصل زیبایی و کمال است."],[927,"هم به اصل خود رود این خد و خال","دایما در آب کی ماند خیال","این بیت بیان می‌کند که زیبایی طبیعی و اصلی هر موجودی، مانند خد و خال، به طور دائم به سمت اصل و ریشه خود بازمی‌گردد و در صورتی که دایم در آب و در انعکاس آن نباشد، دیگر نمی‌تواند در خیال و تصورات باقی بماند. به این معنا که اوصاف و زیبایی واقعی هر چیز، به مرور زمان از بین می‌رود و فقط آنچه ذات و حقیقت اوست، باقی می‌ماند."],[927,"جمله تصویرات عکس آب جوست","چون بمالی چشم خود خود جمله اوست","تصویری که از آب در ذهن ما ایجاد می‌شود، تنها تصویر ذهنی است و اگر چشم خود را به آن بمالیم، در واقع همان تصویر ذهنی را می‌بینیم."],[927,"باز عقلش گفت بگذار این حول","خل دوشابست و دوشابست خل","عقل او به او می‌گوید که این تصور و خیال که به آن ادامه می‌دهد مانند دمی است که در آن شیرینی و خوشی وجود دارد، ولی در واقع اینجا هیچ چیز واقعی و شیرینی نیست."],[927,"خواجه را چون غیر گفتی از قصور","شرم‌دار ای احول از شاه غیور","اگر به خواجه (محتسب) نسبت به نقص‌ها و خطاهایش اشاره کردی، باید از خودت شرم‌کن تا خشم شاه (خدا) را به جان نخری."],[927,"خواجه را که در گذشتست از اثیر","جنس این موشان تاریکی مگیر","خواجه‌ای که از دنیا رفته، به واسطه روح و معنای خود از بندهای ظاهری و مادی (موش‌ها و تاریکی) آزاد شده است. او دیگر تحت تأثیر امور دنیوی نیست و از محدودیت‌های جسمانی رهایی یافته است."],[927,"خواجه جان بین مبین جسم گران","مغز بین او را مبینش استخوان","خواجه، که انسان آگاه و پیری است، را فقط به چشم جسمی و ظاهری‌اش ننگر و به جزئیات فیزیکی همچون استخوان و ویژگی‌های ظاهری او دقت نکن؛ بلکه به عمق وجود او، یعنی خرد و روح او، توجه کن."],[927,"خواجه را از چشم ابلیس لعین","منگر و نسبت مکن او را به طین","به ابلیس لعین نگاه نکن و خواجه را به او نسبت نده؛ او را تنها باید از چشمی خوب و پاک دید و نه از دیدگاه شیطانی."],[927,"همره خورشید را شب‌پر مخوان","آنک او مسجود شد ساجد مدان","خورشید را شب‌پر (کسی که در شب می‌خوابد و نمی‌تواند ببیند) نخوان، زیرا او که در مرتبه بالای وجود است، سجده‌ کرده و در مقام بندگی قرار دارد، پس او را با چنین تعبیراتی نپست."],[927,"عکس‌ها را ماند این و عکس نیست","در مثال عکس حق بنمودنیست","عکس‌ها نمی‌توانند به تنهایی حقیقت را نشان دهند و تنها در مقایسه با حقیقتی که خداوند به تصویر کشیده، می‌توان فهمید که آنچه به عنوان عکس می‌بینیم، واقعیت ندارد."],[927,"آفتابی دید او جامد نماند","روغن گل روغن کنجد نماند","او خورشیدی را می‌بیند که جاودانه نمی‌ماند، مانند روغن گل و روغن کنجد که متوقف نمی‌شوند و مدام در حال تغییر و حرکت هستند."],[927,"چون مبدل گشته‌اند ابدال حق","نیستند از خلق بر گردان ورق","چون به مقام والای حق‌طلبی رسیده‌اند، دیگر به انسان‌ها وابسته نیستند و از دنیای مادی فاصله گرفته‌اند."],[927,"قبله وحدانیت دو چون بود","خاک مسجود ملایک چون شود","قبله وحدانیت، یعنی جایگاهی که به یکتایی خداوند اشاره دارد، چگونه می‌تواند دو باشد و خاکی که فرشتگان در آن سجده می‌کنند، چگونه ممکن است تبدیل به دو پاره شود؟"],[927,"چون درین جو دیدعکس سیب مرد","دامنش را دید آن پر سیب کرد","مردی در این جو (فضا) تصویری از سیب را دید و به خاطر آن دامنش را پر از سیب کرد."],[927,"آنچ در جو دید کی باشد خیال","چونک شد از دیدنش پر صد جوال","آنچه در جو (آب) دید، آیا خیال است؟ چون از دیدن آن، دلش پر از بار سنگین غم و اندوه شده است."],[927,"تن مبین و آن مکن کان بکم و صم","کذبوا بالحق لما جائهم","تن خود را نشان نده و کاری نکن که تو را به آن نسبت دهند، زیرا آن‌ها به حق دروغ گفتند وقتی که حق به سراغشان آمد."],[927,"ما رمیت اذ رمیت احمد بدست","دیدن او دیدن خالق شدست","هرگاه تو احمد را با چشم خود می‌بینی، در حقیقت به خالق او نیز نگاه کرده‌ای؛ زیرا دیدن احمد، دیدن تجلی‌های الهی است."],[927,"خدمت او خدمت حق کردنست","روز دیدن دیدن این روزنست","خدمت به او (احمد) در واقع خدمت به خداوند است و در روز قیامت، دیدن او یعنی دیدن حقیقت الهی است."],[927,"خاصه این روزن درخشان از خودست","نی ودیعه آفتاب و فرقدست","این روزن درخشان فقط از خودش نور می‌گیرد و نه اینکه تنها سپرده‌ای از آفتاب یا ستاره‌ای مثل قمری باشد."],[927,"هم از آن خورشید زد بر روزنی","لیک از راه و سوی معهود نی","خورشید از آن روزن به درون می‌تابد، اما نمی‌توان به روشنی و آشنایی آن اطمینان داشت؛ زیرا این مسیر و راهی که در آن هستیم، عادی و معمولی نیست."],[927,"در میان شمس و این روزن رهی","هست روزنها نشد زو آگهی","بین خورشید و این روزنه راهی وجود دارد که آن روزنه‌ها از وجود این راه آگاهی ندارند."],[927,"تا اگر ابری بر آید چرخ‌پوش","اندرین روزن بود نورش به جوش","اگر ابرهایی در آسمان ظاهر شوند، روشنی این روزن (درمیان شمس و راه) نمی‌میرد و همچنان نورش در حال جوشیدن و به جوش آمده است."],[927,"غیر راه این هوا و شش جهت","در میان روزن و خور مالفت","غیر از این مسیر هوا و شش طرف دیگر، در دل روزن و در میان نور خورشید، هیچ چیز دیگری وجود ندارد."],[927,"مدحت و تسبیح او تسبیح حق","میوه می‌روید ز عین این طبق","ستایش و ذکر خدا، همانند تسبیح او، باعث برکت و شکوفایی می‌شود و از این ظرف (طبق) می‌توان میوه‌های خوب برداشت کرد."],[927,"سیب روید زین سبد خوش لخت لخت","عیب نبود گر نهی نامش درخت","سیب، از این سبد زیبا و خوش‌قواره می‌روید و معیبی ندارد اگر نامش را درخت بگذاری، چرا که زیبایی و کیفیت آن که میوه‌اش را تحت تاثیر قرار نمی‌دهد."],[927,"این سبد را تو درخت سیب خوان","که میان هر دو راه آمد نهان","این سبد را می‌توان به درخت سیب تشبیه کرد، چرا که در میان این دو (سبد و درخت) راهی وجود دارد که به نوعی به هم مرتبط هستند."],[927,"آنچ روید از درخت بارور","زین سبد روید همان نوع از ثمر","هرگونه محصولی که از درخت بارور به دست آید، از این سبد نیز به همین نوع و کیفیت خواهد بود."],[927,"پس سبد را تو درخت بخت بین","زیر سایه این سبد خوش می‌نشین","این بیت می‌گوید که تو باید سبد را مثل درخت خوشبختی ببینی و زیر سایه آن، احساس شادی و آرامش کنی."],[927,"نان چو اطلاق آورد ای مهربان","نان چرا می‌گوییش محموده خوان","وقتی نان به دست تو می‌رسد، ای مهربان، چرا باید آن را «محمود» بخوانی؟ این اشاره به این دارد که نباید نان را به عنوان یک نعمت ویژه و خاص بی‌دلیل نام ببریم، بلکه باید متوجه باشیم که او چقدر در زندگی ما اهمیت دارد."],[927,"خاک ره چون چشم روشن کرد و جان","خاک او را سرمه بین و سرمه دان","خاک مسیر چون به ما یادآوری می‌کند که انسان چقدر نورانی و باارزش است، روح او را همچون سرمه‌ای می‌داند که در چشمانش قرار دارد و از این رو، آن خاک به مقام والای انسان پی می‌برد."],[927,"چون ز روی این زمین تابد شروق","من چرا بالا کنم رو در عیوق","زمانی که خورشید از این زمین طلوع می‌کند، چرا باید سرم را به سمت آسمان بلند کنم؟"],[927,"شد فنا هستش مخوان ای چشم‌شوخ","در چنین جو خشک کی ماند کلوخ","ای چشم من، در این وضعیت و شرایط خشک و بی‌حیات، به فنا و نابودی نیندیش. در اینجا، چیزی مانند خاک هم نمی‌تواند دوام بیاورد."],[927,"پیش این خورشید کی تابد هلال","با چنان رستم چه باشد زور زال","در برابر این خورشید، هلال (ماه) چه نوری خواهد داشت؟ با قدرت و نیروی رستم، فرزند زال، چه کار می‌توان کرد؟"],[927,"طالبست و غالبست آن کردگار","تا ز هستی‌ها بر آرد او دمار","خدای بزرگ همیشه در جستجوی بندگان است و بر آنان تسلط دارد، تا به واسطه قدرتش از هستی‌های مختلف آن‌ها را به نابودی و درماندگی بکشاند."],[927,"دو مگو و دو مدان و دو مخوان","بنده را در خواجه خود محو دان","چندین بار نگویید، نشمرید و صدایتان را بلند نکنید که بنده را در حضور خداوندش در حالتی از فنا و محو شدن ببینید."],[927,"خواجه هم در نور خواجه‌آفرین","فانیست و مرده و مات و دفین","آقای بزرگ (خواجه) نیز در نور (خدا) که آفریدگار اوست، فنا و نابود شده و در حقیقت، بسیار کوچک و پنهان شده است."],[927,"چون جدا بینی ز حق این خواجه را","گم کنی هم متن و هم دیباجه را","وقتی که جدا از حق، این شخص (خواجه) را ببینی، هم محتوای او و هم ظاهرش را گم می‌کنی."],[927,"چشم و دل را هین گذاره کن ز طین","این یکی قبله‌ست دو قبله مبین","چشم و دل خود را از تعلقات دنیوی دور کن، زیرا این یک راهنما و مقصد واقعی است. به دو مقصد مختلف توجه نکن و فقط به یک سمت یا یک حقیقت توجه داشته باش."],[927,"چون دو دیدی ماندی از هر دو طرف","آتشی در خف فتاد و رفت خف","وقتی دو دیدگاه مختلف را نظاره کردی، در می‌یابی که از هر دو جهت، آتشی پنهان و خطرناک در دل تو وجود دارد که به آرامی در حال خاموش شدن است."],[928,"گر عمر نامی تو اندر شهر کاش","کس بنفروشد به صد دانگت لواش","اگر در این شهر هر کس تو را به نام عمر بشناسد، هیچ‌کس نان تو را به قیمت صد دینار هم نمی‌فروشد."],[928,"چون به یک دکان بگفتی عمرم","این عمر را نان فروشید از کرم","وقتی به یک دکان گفتی که من عمر هستم، نان فروش به خاطر لطف و سخاوتش این عمر را به تو می‌دهد."],[928,"او بگوید رو بدان دیگر دکان","زان یکی نان به کزین پنجاه نان","او می‌گوید به سراغ آن دکان دیگر برو، زیرا از آنجا فقط یک نان می‌فروشد، اما از اینجا پنجاه نان می‌توانی بگیری."],[928,"گر نبودی احول او اندر نظر","او بگفتی نیست دکانی دگر","اگر او احول (نگرش محدود و سطحی) نبود، به او می‌گفتی که دکان دیگری وجود ندارد، یعنی همه چیز باید به‌طور واحد دیده شود و تفکیک میان دکان‌ها بی‌معناست."],[928,"پس زدی اشراق آن نااحولی","بر دل کاشی شدی عمّر علی","پس از این که آن نادانی را کنار زدی و به حقیقت پی بردی، در آگاهی‌ات بر دل مانند کاشی روشن شدی و به مقام بلند عمر علی (که به معنای زندگی و آگاهی کامل است) رسیدی."],[928,"این ازینجا گوید آن خباز را","این عمر را نان فروش ای نانبا","این شخص به نانوایی می‌گوید که این عمر، فروشنده نان است."],[928,"چون شنید او هم عمر نان در کشید","پس فرستادت به دکان بعید","وقتی او شنید که عمر نان (خودش) را در نظر گرفته، تصمیم گرفت که او را به دکانی دورتر بفرستد."],[928,"کین عمر را نان ده ای انباز من","راز یعنی فهم کن ز آواز من","ای رفیق، به عمر نان بده و راز من را از صدای من بفهم و درک کن."],[928,"او همت زان سو حواله می‌کند","هین عمر آمد که تا بر نان زند","او از طرف دیگر به اینجا ارجاع می‌دهد و می‌گوید: «هین! عمر آمد که برای به دست آوردن نان تلاش کند»، که نشان‌دهنده‌ی عدم درک او از پیوستگی زندگی و وابستگی آن به تلاش برای تامین نیازهاست."],[928,"چون به یک دکان عمر بودی برو","در همه کاشان ز نان محروم شو","اگر به یک دکان بروی و فقط به آن اتکا کنی، در واقع از همه نان‌ها و نعمت‌های دیگر در این شهر محروم خواهی شد."],[928,"ور به یک دکان علی گفتی بگیر","نان ازینجا بی‌حواله و بی‌زحیر","اگر به یک دکان بروی و بگویی از همین‌جا نان بگیر، بدون اینکه احتیاج به حواله یا زحمت دیگری داشته باشی، به راحتی می‌توانی نیازت را برآورده کنی."],[928,"احول دو بین چو بی‌بر شد ز نوش","احول ده بینی ای مادر فروش","احول (مردی که بینایی‌اش کم است) مانند کسی که از نور محروم شده، نمی‌تواند چیزها را به درستی ببیند؛ پس ای مادر، تو هم اگر او را ببینی، باید به او به عنوان کسی که دائم در حال گم‌گشتگی است، نگاه کنی."],[928,"اندرین کاشان خاک از احولی","چون عمر می‌گرد چون نبوی علی","در کاشان، خاک و زمین به خاطر احولی‌ها، مانند عمر (ابن خطاب) و نبوی (پیامبر) می‌چرخد و فعالیت می‌کند. اینجا به اهمیت و تأثیر احولی‌ها بر زندگی و جامعه اشاره شده است."],[928,"هست احول را درین ویرانه دیر","گوشه گوشه نقل نو ای ثم خیر","در این ویرانه، احول به جستجوی نیکو کارانی است که هرکدام در گوشه‌ای از این مکان منتظرند. احول به شناسایی و یافتن افرادی که خیر و نیکی انجام می‌دهند، مشغول است."],[928,"ور دو چشم حق‌شناس آمد ترا","دوست پر بین عرصه هر دو سرا","اگر دو چشم حق‌شناس به تو بیایند، یعنی اگر کسی باشد که حقیقت را ببیند و بشناسد، دوست تو در همه عرصه‌های دو جهان خواهد بود."],[928,"وا رهیدی از حواله جا به جا","اندرین کاشان پر خوف و رجا","تو از ارجاع و انتقال از جایی به جای دیگر رهایی یافتی و در این شهر کاشان، که پر از ترس و امید است، زندگی می‌کنی."],[928,"اندرین جو غنچه دیدی یا شجر","هم‌چو هر جو تو خیالش ظن مبر","در این فضا، نیاکان و درختان را دیدی، ولی به مانند هر جو و درخت، خیال نکن که این‌ها فقط ظاهر دارند و حقیقتشان فراتر از آن است."],[928,"که ترا از عین این عکس نقوش","حق حقیقت گردد و میوه‌فروش","تو با مشاهده این باطن و حقیقت، به اصل و حقیقت وجود خداوند و نشانه‌های او پی خواهی برد و همچون میوه‌فروشی، میوه حقیقت را خواهی چید."],[928,"چشم ازین آب از حول حر می‌شود","عکس می‌بیند سد پر می‌شود","چشم از آب حیات که به دور حر (محبوب) است، تصویری از آن می‌بیند و این تصویر مانند سدی پر می‌شود. یعنی انسان در این حالت از حقیقت و محبت الهی مطلق دور مانده و تنها استعداد دریافت تصویر آن را دارد."],[928,"پس به معنی باغ باشد این نه آب","پس مشو عریان چو بلقیس از حباب","پس این، که به معنای باغ است، دیگر آب نیست. پس مانند بلقیس (ملکه سبا)، از حباب عریان و بی‌پوشش نیا، یعنی از زیبایی ظاهری و فریبنده دور باش."],[928,"بار گوناگونست بر پشت خران","هین به یک چون این خران را تو مران","بارهای متفاوتی بر دوش خرها وجود دارد، پس تو این خرها را به یکسان نران، زیرا هر کدام بار خاصی دارند."],[928,"بر یکی خر بار لعل و گوهرست","بر یکی خر بار سنگ و مرمرست","در این بیت اشاره شده که برخی افراد ممکن است در زندگی خود با انواع مختلف بار و مسئولیت‌ها مواجه شوند. یکی از آنها ممکن است ثروت و زیبایی (مانند لعل و گوهر) را حمل کند، در حالی که دیگری بار سنگین و سختی (مثل سنگ و مرمر) بر دوش دارد. به عبارت دیگر، زندگی هر کس با تجربه‌ها و چالش‌های متفاوتی روبروست."],[928,"بر همه جوها تو این حکمت مران","اندرین جو ماه بین عکسش مخوان","در تمام سیلاب‌ها و جریان‌ها، این حکمت را نران؛ در این جریان، مانند ماه، تصویر خود را نبین و به آن اطلاق نکن."],[928,"آب خضرست این نه آب دام و دد","هر چه اندر وی نماید حق بود","آب خضر، آب زندگی و معرفتی است که محبت و حقیقت را در خود دارد، نه آب یهودیانی که در آن موجودات وحشی و گیاهان تلخ وجود دارند. هر چیزی که در آن آب وجود داشته باشد، نمایانگر حقیقت و واقعیت است."],[928,"زین تگ جو ماه گوید من مهم","من نه عکسم هم‌حدیث و هم‌رهم","جو، ماه را می‌گوید من چیز مهمی هستم و نه فقط تصویر تو، بلکه من هم‌صحبت و هم‌راه تو هستم."],[928,"اندرین جو آنچ بر بالاست هست","خواه بالا خواه در وی دار دست","در این جوی که در آن هستیم، هر چه که در بالا وجود دارد، خواه در بالا باشد و خواه در درون (جوی)، در حقیقت دست خداوند است که هر دو را دربر می‌گیرد."],[928,"از دگر جوها مگیر این جوی را","ماه دان این پرتو مه‌روی را","از جوهای دیگر چیزی نگیر و بر روی این جوی تمرکز کن، زیرا این نور و روشنایی که می‌بینی از چهره‌ی معشوق است."],[928,"این سخن پایان ندارد آن غریب","بس گریست از درد خواجه شد کئیب","این حرف پایانی ندارد، آن مرد غریب به خاطر درد و ناامیدی بسیار گریه کرد و از شدت ناراحتی حالش بد شد."],[929,"واقعه آن وام او مشهور شد","پای مرد از درد او رنجور شد","خبر این واقعه و بدهی او در شهر مشهور شد و پای مرد به خاطر دردی که داشت، بسیار آسیب‌دیده و رنجور شد."],[929,"از پی توزیع گرد شهر گشت","از طمع می‌گفت هر جا سرگذشت","به دنبال تو، شهر گرداگرد تو پخش شد و هرکسی از سر طمع می‌گفت که از چه حالتی می‌گذرد."],[929,"هیچ ناورد از ره کدیه به دست","غیر صد دینار آن کدیه‌پرست","هیچ کسی نمی‌تواند از طریق کدیه (جایی که اجناس یا ثروت در آن نگهداری می‌شود) چیزی به‌دست آورد، مگر اینکه آن شخص کدیه‌پرست (صاحب کدیه) باشد و مبلغ صد دینار را بدهد."],[929,"پای مرد آمد بدو دستش گرفت","شد بگور آن کریم بس شگفت","مردی به قبر آن شخص نیکوکار آمد و دست او را گرفت، و به سویی برد که در آنجا حیرت‌انگیز بود."],[929,"گفت چون توفیق یابد بنده‌ای","که کند مهمانی فرخنده‌ای","وقتی بنده‌ای توفیق پیدا کند که مهمانی با شکوه و خوشایندی برگزار کند، او باید آن را به شایستگی انجام دهد."],[929,"مال خود ایثار راه او کند","جاه خود ایثار جاه او کند","کسی مال و ثروت خود را در راه خدا فدای دیگران می‌کند و همچنین مقام و موقعیت خود را برای خدا و دیگران از خود می‌گذارد."],[929,"شکر او شکر خدا باشد یقین","چون به احسان کرد توفیقش قرین","اگر انسان شکر نعمت‌های خداوند را به جا بیاورد، در حقیقت شکر خدا را به جا آورده است، زیرا در زمانی که او کار نیک و احسان می‌کند، خداوند نیز توفیق و موفقیت را به او عطا می‌کند."],[929,"ترک شکرش ترک شکر حق بود","حق او لا شک به حق ملحق بود","رها کردن شکرگزاری او، در حقیقت بی‌احترامی به شکرگزاری خداوند است، زیرا او به روشنی به خدا متصل است."],[929,"شکر می‌کن مر خدا را در نعم","نیز می‌کن شکر و ذکر خواجه هم","خدا را برای نعمت‌هایی که به تو داده است شکر کن، و همچنین برای یاد کردن از آقای خود (پیامبر یا ولی) نیز شکر و ذکر را فراموش نکن."],[929,"رحمت مادر اگر چه از خداست","خدمت او هم فریضه‌ست و سزاست","رحمت مادر هرچند از جانب خداست، اما خدمت به او نیز واجب و شایسته است."],[929,"زین سبب فرمود حق صلوا علیه","که محمد بود محتال الیه","به همین دلیل خداوند دستور داد که بر محمد (ص)، صلوات بفرستید، زیرا او بود که پیام حق را به مردم رسانید."],[929,"در قیامت بنده را گوید خدا","هین چه کردی آنچ دادم من ترا","در قیامت، خدا به بنده می‌گوید: چه کردی با آنچه که به تو دادم؟"],[929,"گوید ای رب شکر تو کردم به جان","چون ز تو بود اصل آن روزی و نان","بنده به خدا می‌گوید: ای پروردگار، من شکر تو را به جان خود به جا آورده‌ام، زیرا اصل روزی و نانی که به من داده‌ای از خود توست."],[929,"گویدش حق نه نکردی شکر من","چون نکردی شکر آن اکرام‌فن","خدا می‌گوید که تو شکر من را به جا نیاورده‌ای، زیرا که شکر آن احسانی که به تو کرده‌ام را نیز به‌درستی ادا نکرده‌ای."],[929,"بر کریمی کرده‌ای ظلم و ستم","نه ز دست او رسیدت نعمتم","بر تو که بخشنده و کریم است، ظلم و ستم کرده‌ای و نعمت‌های او به تو نرسیده است، چون این بدی از طرف او نبوده است."],[929,"چون به گور آن ولی‌نعمت رسید","گشت گریان زار و آمد در نشید","وقتی به قبر آن کسی که خیری به او کرده بود رسید، به شدت گریه کرد و در حال سوگواری و ناله درآمد."],[929,"گفت ای پشت و پناه هر نبیل","مرتجی و غوث ابناء السبیل","اینجا گوینده به خدا یا ولی‌نعمت می‌گوید که تو پشتیبان و حامی هر انسان بزرگ و شریف هستی که در نظر مردم محترم است و همچنین نجات‌دهنده‌ی فرزندان راه‌طلب و جویای هدایت."],[929,"ای غم ارزاق ما بر خاطرت","ای چو رزق عام احسان و برت","ای غم، تو همواره به یاد ما هستی، مانند غذایی که به طور عمومی و فراوان به همه می‌رسد و بخشیده می‌شود."],[929,"ای فقیران را عشیره و والدین","در خراج و خرج و در ایفاء دین","ای بیچارگان، شما دارای خانواده و پدر و مادر هستید که در پرداخت مالیات و هزینه‌ها و حفظ دین به شما کمک می‌کنند."],[929,"ای چو بحر از بهر نزدیکان گهر","داده و تحفه سوی دوران مطر","ای تو مانند دریا که برای نزدیکان خود گنج و هدایایی می‌بخشی و به دنیا نعمت می‌فرستی."],[929,"پشت ما گرم از تو بود ای آفتاب","رونق هر قصر و گنج هر خراب","وجود ما به برکت تو است، ای آفتاب که سبب روشنی و شکوه هر کاخ و ثروت هر ویرانه‌ای هستی."],[929,"ای در ابرویت ندیده کس گره","ای چو میکائیل راد و رزق‌ده","ای کسی که در ابرویت هیچ گره و زحمتی دیده نمی‌شود، تو مانند میکائیل، فرشته‌ای هستی که روزی می‌دهد و برکت می‌آوری."],[929,"ای دلت پیوسته با دریای غیب","ای به قاف مکرمت عنقای غیب","ای دل تو همیشه با رازهای پنهان و دنیای نادیده در ارتباط هستی و تو به قاف (قله) کرامت و فضایل معنوی دست یافته‌ای که مثل عنقای غیب، موجودی افسانه‌ای و نایاب است."],[929,"یاد ناورده که از مالم چه رفت","سقف قصد همتت هرگز نکفت","به یاد نداشته باشید که از دارایی‌ام چه چیزهایی رفته است، چون سقف آرزوهایت هرگز به اندازه‌ی تلاش و کوشش تو نخواهد رسید."],[929,"ای من و صد هم‌چو من در ماه و سال","مر ترا چون نسل تو گشته عیال","ای من و صد نفر دیگر همچون من که در هر ماه و سال به دنیا آمده‌ایم، تو را نیز مانند نسل خودت، وابسته و درگیر زندگی و مشکلات می‌بینم."],[929,"نقد ما و جنس ما و رخت ما","نام ما و فخر ما و بخت ما","ما به اندازه‌ای که نقد (دارایی و سرمایه) و جنس (کالا) و رخت (لباس) و نام و شهرت و فخر و بخت داریم، به آن‌ها اهمیت داده‌ایم و آن‌ها جزو هویت و ارزش ما هستند."],[929,"تو نمردی ناز و بخت ما بمرد","عیش ما و رزق مستوفی بمرد","تو که نمردی، بلکه ناز و خوشبختی ما از بین رفت و لذت و روزی ما نیز نابود شد."],[929,"واحد کالالف در رزم و کرم","صد چو حاتم گاه ایثار نعم","در دلاوری و بخشش، کسی مانند حاتم طایی وجود ندارد و او در ایثار کردن نعمت‌ها از همه‌ی سایرین برتر است."],[929,"حاتم ار مرده به مرده می‌دهد","گردگان‌های شمرده می‌دهد","حاتم، اگرچه مرده است، اما هنوز به مردگان نیز بخشی از نیکویی‌ها را می‌دهد، به طوری که حتی به حساب اندک می‌توان شمرد."],[929,"تو حیاتی می‌دهی در هر نفس","کز نفیسی می‌نگنجد در نفس","تو در هر نفس زندگی‌ای می‌دهی که ارزش آن به قدری زیاد است که در هیچ چیز قیمتی نمی‌گنجد."],[929,"تو حیاتی می‌دهی بس پایدار","نقد زر بی‌کساد و بی‌شمار","تو زندگی را به گونه‌ای پایدار می‌دهی که مانند طلا همیشه با ارزش و بدون افت و کاهشی است."],[929,"وارثی نا بوده یک خوی ترا","ای فلک سجده کنان کوی ترا","ای آسمان، هیچ وارثی مانند تو برای خویش نداری، پس در کوی عشق تو، باید سجده‌وار حاضر شد."],[929,"خلق را از گرگ غم لطفت شبان","چون کلیم الله شبان مهربان","مردم را از غم و مشکلات زندگی، مانند شبانی مهربان و دلسوز که کلیم الله (موسی) باشد، محافظت کن."],[929,"گوسفندی از کلیم الله گریخت","پای موسی آبله شد نعل ریخت","گوسفندی از حضرت موسی فرار کرد و پای او زخمی شد و در نتیجه نعل (زین) شل شد و افتاد."],[929,"در پی او تا به شب در جست و جو","وان رمه غایب شده از چشم او","موسی تا شب به دنبال گوسفند گمشده‌اش می‌گشت، در حالی که آن گله از دید او ناپدید شده بود."],[929,"گوسفند از ماندگی شد سست و ماند","پس کلیم الله گرد از وی فشاند","گوسفند به خاطر ماندن و انتظار طولانی ضعیف و ناتوان شد و بعد از آن، حضرت موسی (کلیم الله) از او دور شد و او را رها کرد."],[929,"کف همی‌مالید بر پشت و سرش","می‌نواخت از مهر هم‌چون مادرش","کف، به نشانه محبت، بر روی سر و پشت او می‌کشید و او را نوازش می‌کرد، مانند مادری که فرزندش را با محبت نوازش می‌کند."],[929,"نیم ذره طیرگی و خشم نی","غیر مهر و رحم و آب چشم نی","نیم‌ذره‌ای از سرکشی و خشم در وجود او نیست و تنها احساساتی چون محبت، رحم و اشک را در دل خود دارد."],[929,"گفت گیرم بر منت رحمی نبود","طبع تو بر خود چرا استم نمود","گفت اگر من از جان و دل به تو نیندیشم، چرا تو بر خودت مهربان نیستی و رحم نمی‌کنی؟"],[929,"با ملایک گفت یزدان آن زمان","که نبوت را همی‌ زیبد فلان","در زمانی که یزدان (خدا) با فرشتگان (ملایک) صحبت می‌کرد، گفت که نبوت (پیامبری) تنها به فلانی تعلق دارد."],[929,"مصطفی فرمود خود که هر نبی","کرد چوپانیش برنا یا صبی","مصطفی (پیامبر اسلام) فرمود که هر پیامبری در جوانی یا در دوران کودکی‌اش نقش چوپانی داشته است، یعنی مسئولیت هدایت و راهنمایی مردم را بر عهده گرفته است."],[929,"بی‌شبانی کردن و آن امتحان","حق ندادش پیشوایی جهان","بی‌شبان بودن و عدم توانایی در امتحان الهی، باعث نشد که او (شخص مورد اشاره) در رهبری جهان موفق شود."],[929,"گفت سایل هم تو نیز ای پهلوان","گفت من هم بوده‌ام دهری شبان","شخصی به پهلوان می‌گوید که تو هم مثل من سوال کن و پهلوان پاسخ می‌دهد که من نیز زمانی به عنوان یک شبان زندگی کرده‌ام."],[929,"تا شود پیدا وقار و صبرشان","کردشان پیش از نبوت حق شبان","قبل از اینکه پیامبر حق (محمد) مبعوث شود، باعث شد که وقار و صبر در مردم را آشکار کند. این نشان می‌دهد که مردم به آرامش و تدبیر نیاز داشتند."],[929,"هر امیری کو شبانی بشر","آن‌چنان آرد که باشد متمر","هر امیری که به خوبی از مردم خود مراقبت کند و مانند یک شبان مهربان با آنها رفتار نماید، به‌طوری‌که در بین آنها نظم و وحدت برقرار شود، باید به این صورت عمل کند."],[929,"حلم موسی‌وار اندر رعی خود","او به جا آرد به تدبیر و خرد","حلم یعنی بردباری و صبر. در این بیت اشاره شده است که او (امیر یا رهبر) باید مانند موسی، یعنی با صبر و ظرفیت بالا، در مورد رعی (رعیت یا مردم) خود عمل کند و با تدبیر و خرد برای آن‌ها روشی مناسب در پیش گیرد."],[929,"لاجرم حقش دهد چوپانیی","بر فراز چرخ مه روحانیی","بنابراین، خداوند به او (موسی) مقام چوپانی‌ای می‌دهد و روحی با عظمت مانند ماه بر بالای آسمان برای او قرار می‌دهد."],[929,"آنچنان که انبیا را زین رعا","بر کشید و داد رعی اصفیا","خداوند انبیا را به خاطر مقام و اهمیتشان از میان مردم برگزید و به آن‌ها رهبری و هدایت را عطا کرد."],[929,"خواجه باری تو درین چوپانیت","کردی آنچ کور گردد شانیت","در این بیت به خواجه (خدا) اشاره می‌شود که در مقام چوپان، به نظر می‌رسد که با هدایت و نجات بندگان، آنها را از جهالت و کور شدن در مقام و ارزش‌های خود دور کرده است. به عبارت دیگر، خواجه در نقش چوپانی است که بندگان را به فطرت و آگاهی واقعی سوق می‌دهد."],[929,"دانم آنجا در مکافات ایزدت","سروری جاودانه بخشدت","می‌دانم که در آنجا (آخرت) خداوند جزای خوبی به تو می‌دهد و به تو مقام و ریاست دائمی خواهد بخشید."],[929,"بر امید کف چون دریای تو","بر وظیفه دادن و ایفای تو","به امید اینکه مانند دریا از دست تو بخشش و ایثار ببخشم و وظیفه‌ام را به خوبی انجام دهم."],[929,"وام کردم نه هزار از زر گزاف","تو کجایی تا شود این درد صاف","من از تو نه هزار درهم طلا قرض کرده‌ام. تو کجایی تا بتوانم این درد را برطرف کنم؟"],[929,"تو کجایی تا که خندان چون چمن","گویی بستان آن و ده چندان ز من","شما کجایید که مثل گل‌های خوشبو من را شاد کنید، همچون باغی که در آن شادابی و سرزندگی بیداد می‌کند."],[929,"تو کجایی تا مرا خندان کنی","لطف و احسان چون خداوندان کنی","کجایی که با مهربانی و سخاوتت من را شاد کنی و مانند خداوندان بر من لطف و نعمت نثارت کنی؟"],[929,"تو کجایی تا بری در مخزنم","تا کنی از وام و فاقه آمنم","چرا نمی‌آیی تا در دل من وارد شوی و مرا از اضطراب و کمبود مالی نجات دهی؟"],[929,"من همی‌گویم بس و تو مفضلم","گفته کین هم گیر از بهر دلم","من می‌گویم که به اندازه کافی صحبت کرده‌ام و تو، مفضّل، هم گفته‌ای که این را برای دل من بگیر."],[929,"چون همی‌گنجد جهانی زیر طین","چون بگنجد آسمانی در زمین","اگر جهانی بزرگ در زیر خاک جا می‌گیرد، پس جای شگفتی نیست که آسمان‌ها نیز در زمین جای بگیرند."],[929,"حاش لله تو برونی زین جهان","هم به وقت زندگی هم این زمان","هرگز نباید تصور کنی که تو از این دنیا جدا هستی، خواه در زمان زندگی‌ات و خواه در حال حاضر."],[929,"در هوای غیب مرغی می‌پرد","سایه او بر زمینی می‌زند","در فضای غیرمادی، مرغی وجود دارد که پرواز می‌کند و سایه‌اش بر زمین می‌افتد."],[929,"جسم سایه سایه سایه دلست","جسم کی اندر خور پایه دلست","جسم فقط سایه یا نمایی از دل است و نمی‌تواند به پایگاه و ارزش دل دست یابد؛ یعنی وجود مادی انسان از اهمیت کمتری نسبت به وجود روحانی و معنوی او برخوردار است."],[929,"مرد خفته روح او چون آفتاب","در فلک تابان و تن در جامه خواب","مرد خوابیده است و روح او مانند آفتاب در آسمان درخشان و پرنور است، در حالی که بدن او در خواب است و در لباس خواب به سر می‌برد."],[929,"جان نهان اندر خلا هم‌چون سجاف","تن تقلب می‌کند زیر لحاف","جان پنهان در فضا مانند پرده و پوشیده‌ای است که در زیر لحاف به شکل‌های مختلف ظاهر می‌شود. این به این معناست که روح، که نمایانگر حقیقتی عمیق‌تر است، در قالب‌های مختلف ظاهر می‌شود و تغییر شکل می‌دهد."],[929,"روح چون من امر ربی مختفیست","هر مثالی که بگویم منتفیست","روح انسان مانند فرمان خداوند پنهان و نهان است و هر نمونه یا مثالی که بزنم، نادرست و بی‌معنا خواهد بود."],[929,"ای عجب کو لعل شکربار تو","وان جوابات خوش و اسرار تو","عجب دارد که لعل (گوهر) شیرین و قند و آن پاسخ‌های زیبا و رازهای تو کجاست؟ در واقع، شاعر از فقدان معانی و زیبایی‌های خاصی که مرتبط با محبوب یا الهام‌بخش اوست، دلتنگ و حیران است."],[929,"ای عجب کو آن عقیق قندخا","آن کلید قفل مشکل‌های ما","عجبا آن عقیق شیرین کجاست که کلید حل مشکلات ماست."],[929,"ای عجب کو آن دم چون ذوالفقار","آنک کردی عقل‌ها را بی‌قرار","عجب است کجاست آن لحظه‌ای که مانند ذوالفقار، شمشیری که علی (ع) به کار برد، باعث بی‌قراری و حیرت عقل‌ها شد."],[929,"چند هم‌چون فاخته کاشانه‌جو","کو و کو و کو و کو و کو و کو","چندین بار مانند فاخته، که دنبال لانه‌اش می‌گردد، بپرس و بپرس و بپرس."],[929,"کو همان‌جا که صفات رحمتست","قدرتست و نزهتست و فطنتست","جایی که صفات الهی مانند رحمت، قدرت، زیبایی و حکمت وجود دارد."],[929,"کو همان‌جا که دل و اندیشه‌اش","دایم آن‌جا بد چو شیر و بیشه‌اش","در این بیت، اشاره به محلی است که دل و اندیشه انسان همیشه در آنجا قرار دارد و به پایداری و قدرت آن می‌ماند، همچون شیر که در بیشه خود زندگی می‌کند و بر آن سلطه دارد. این مکان نماد امن و آرامش است که انسان در آن احساس ثبات و شجاعت می‌کند."],[929,"کو همان‌جا که امید مرد و زن","می‌رود در وقت اندوه و حزن","جایی که در زمان غم و اندوه، امید مردان و زنان از دلشان می‌رود و از بین می‌رود."],[929,"کو همان‌جا که به وقت علتی","چشم پرد بر امید صحتی","کجا همان جایی است که در زمان بیماری و گرفتاری، چشم‌ها به امید بهبودی و صحت دوخته می‌شوند."],[929,"آن طرف که بهر دفع زشتیی","باد جویی بهر کشت و کشتیی","در آن طرف، برای جلوگیری از زشتی‌ها، باید تلاش کرد و کوشش نمود، مانند جستن آب برای کشتن یا کشتی گرفتن."],[929,"آن طرف که دل اشارت می‌کند","چون زبان یا هو عبارت می‌کند","آن‌جایی که دل انسان اشاره می‌کند، به گونه‌ای است که مانند زبان، حرف می‌زند و بیانگر احساسات می‌شود."],[929,"او مع‌الله است بی کو کو همی","کاش جولاهانه ماکو گفتمی","او با خداوند است و به همین دلیل هیچ چیز نمی‌تواند او را از خود دور کند، حتی اگر بخواهیم او را به طور معمول و دنیوی وصف کنیم."],[929,"عقل ما کو تا ببیند غرب و شرق","روح‌ها را می‌زند صد گونه برق","عقل ما کجا است که بتواند برتری‌ها و تفاوت‌های روح‌ها را در شرق و غرب ببیند؛ زیرا این عقل همواره به دنیای مادی محدود است و نمی‌تواند شگفتی‌های روحی را درک کند."],[929,"جزر و مدش بد به بحری در زبد","منتهی شد جزر و باقی ماند مد","در این بیت، به تحولات و تغییرات در زندگی اشاره شده است؛ به این معنا که نوسانات و فراز و نشیب‌ها (جزر و مد) در دریا نماد تغییرات زندگی هستند، و در نهایت پس از یک دوره تغییر، حال تنها نتیجه یا اثر مثبت آن تغییرات باقی مانده است."],[929,"نه هزارم وام و من بی دست‌رس","هست صد دینار ازین توزیع و بس","من به اندازه هزارم وام، بی‌دسترس هستم و تنها صد دینار از این توزیع و بخشش به من رسیده است، و همین مقدار نیز کافی نیست."],[929,"حق کشیدت ماندم در کش‌مکش","می‌روم نومید ای خاک تو خوش","دچار سختی و کشمکش شده‌ام و از تو ای خاک (مکان مقدس یا تربت محتسب) ناامید و بی‌یار می‌روم، چرا که حق من را در این وضع نگه داشته است."],[929,"همتی می‌دار در پر حسرتت","ای همایون روی و دست و همتت","به خاطر آرزوی زیاد و حسرتی که داری، قدر و منزلت خود را بشناس و برای رسیدن به هدف‌هایت تلاش کن، ای فرد با عظمت!"],[929,"آمدم بر چشمه و اصل عیون","یافتم در وی به جای آب خون","به چشمه‌ای رسیدم که معمولا باید آب داشته باشد، اما به جای آب در آن، خون وجود دارد."],[929,"چرخ آن چرخست آن مهتاب نیست","جوی آن جویست آب آن آب نیست","چرخ، همان چرخ فلکی است که در آسمان می‌چرخد و به آن نور نمی‌دهد، و مهتاب هم نیست. جوی هم در واقع جوی آب نیست و آن چیزی که دیده می‌شود، واقعیت دیگری دارد."],[929,"محسنان هستند کو آن مستطاب","اختران هستند کو آن آفتاب","محسنان (شایستگان) همان کسانی هستند که مانند ستارگان درخشان و ممتاز در آسمان وجود دارند؛ پس آیا آن آفتاب (یعنی نورانی‌ترین و مهم‌ترین آنها) کجاست؟"],[929,"تو شدی سوی خدا ای محترم","پس به سوی حق روم من نیز هم","ای محترم، تو به سوی خدا رفتی، حالا من هم قصد دارم به سوی حق بروم."],[929,"مجمع و پای علم ماوی القرون","هست حق کل لدینا محضرون","علم ما در مجمعی جمع شده است که مرکز تمام دانش‌ها و حقایق در طول تاریخ است و این مکان همیشه در دسترس ماست."],[929,"نقش‌ها گر بی‌خبر گر با خبر","در کف نقاش باشد محتصر","نقش‌هایی که ما از آنها بی‌خبر یا باخبر هستیم، در دستان نقاش (خالق) به صورت محدود و محصور وجود دارند."],[929,"دم به دم در صفحه اندیشه‌شان","ثبت و محوی می‌کند آن بی‌نشان","هر لحظه در صفحه افکارشان، آن چیز بی‌نشان را ثبت می‌کند و محو می‌سازد."],[929,"خشم می‌آرد رضا را می‌برد","بخل می‌آرد سخا را می‌برد","خشم باعث می‌شود که رضایت و خوشحالی از بین برود و بخل هم سبب می‌شود که بخشش و generosity از بین برود."],[929,"نیم لحظه مدرکاتم شام و غدو","هیچ خالی نیست زین اثبات و محو","در هر لحظه، هم در صبح و هم در شب، حقایق و دریافت‌های من وجود دارد، و هیچ چیز نمی‌تواند این اثبات و زوال را از بین ببرد."],[929,"کوزه‌گر با کوزه باشد کارساز","کوزه از خود کی شود پهن و دراز","کوزه‌گر فقط وقتی می‌تواند کوزه بسازد که همواره در کنار کوزه باشد و مهارت خود را به کار بگیرد؛ در غیر این صورت، کوزه به تنهایی نمی‌تواند خود به خود شکل بگیرد و تغییر کند."],[929,"چوب در دست دروگر معتکف","ورنه چون گردد بریده و مؤتلف","در دست دروگر، چوبی است که او آن را به خاطر کارش در اختیار دارد و بدون او، چوب به خودی خود نمی‌تواند بریدن و جمع‌آوری کند. این به این معناست که ابزار و وسایل کار به خودی خود کارایی ندارند و به حضور صاحب‌کار وابسته‌اند."],[929,"جامه اندر دست خیاطی بود","ورنه از خود چون بدوزد یا درد","خیاطی جامه‌ای را در دست داشت و در غیر این صورت نمی‌تواند از چیزی که ندارد، دوزندگی کند. منظور این است که برای انجام کاری نیاز به مواد و پیش‌نیازهای لازم است."],[929,"مشک با سقا بود ای منتهی","ورنه از خود چون شود پر یا تهی","مشک به وسیله سقا (آب‌کش) پر می‌شود، و گرنه خودش نمی‌تواند پر یا خالی شود. این به این معناست که مانند مشک، انسان نیز به خودی خود نمی‌تواند از چیزی سرشار یا خالی باشد و نیاز به دیگری دارد."],[929,"هر دمی پر می‌شوی تی می‌شوی","پس بدانک در کف صنع ویی","هر لحظه در حال پر شدن و خوشبو شدن هستی، ولی بدان که در واقع در دست صنع و آفرینش او هستی و به او وابسته‌ای."],[929,"چشم‌بند از چشم روزی کی رود","صنع از صانع چه سان شیدا شود","هاله‌ای که بر چشم انسان به خاطر روزی قرار دارد، چگونه می‌تواند برطرف شود، در حالی که آنچه از خالق (صانع) است، چگونه می‌تواند شوق و عشق را در دل بیدار کند؟"],[929,"چشم‌داری تو به چشم خود نگر","منگر از چشم سفیهی بی‌خبر","به چشمان خود توجه کن و با آنها نگاه کن، نه اینکه از دید نادانان بی‌خبر و بدون تفکر، بر دیگران نظر کنی."],[929,"گوش داری تو به گوش خود شنو","گوش گولان را چرا باشی گرو","به چیزی که خودت درک می‌کنی گوش بده و به حرف‌های احمق‌ها توجه نکن. چرا باید خودت را وابسته به سخنان نادرست دیگران کنی؟"],[929,"بی ز تقلیدی نظر را پیشه کن","هم برای عقل خود اندیشه کن","به تقلید نکردن و داشتن نظر مستقل تأکید کن و همچنین برای خودت فکر کن و عقل خود را به کار بنداز."],[930,"بود امیری را یکی اسپی گزین","در گله سلطان نبودش یک قرین","امیری که اسپ نیکویی در گله سلطان انتخاب کرده بود، در واقع هیچ هم‌نوا یا هم‌پای دیگری نداشت. یعنی آن اسپ به قدری بی‌نظیر بود که هیچ‌کسی در مقایسه با او برابری نمی‌کرد."],[930,"او سواره گشت در موکب به گاه","ناگهان دید اسپ را خوارزمشاه","خوارزمشاه که سوار بر اسبش بود، ناگهان در حین برگزاری مراسم خود، به اسبی برخورد کرد."],[930,"چشم شه را فر و رنگ او ربود","تا به رجعت چشم شه با اسپ بود","چشم خوارزمشاه به زیبایی و شکوه آن اسب خیره شد و آن‌قدر مجذوبش شد که حتی وقتی به سمت دیگر نگاه می‌کند، هنوز یاد آن اسب در ذهنش باقی مانده است."],[930,"بر هر آن عضوش که افکندی نظر","هر یکش خوشتر نمودی زان دگر","هر عضوی از آن اسب که به آن نگاه کردی، برای تو زیباتر و جذاب‌تر از عضو دیگر به نظر می‌رسید."],[930,"غیر چستی و گشی و روحنت","حق برو افکنده بد نادر صفت","غیر از چابکی و نرمی و زیبایی که حق (خدا) بر او (آن اسب) افکنده، ویژگی نادری دارد."],[930,"پس تجسس کرد عقل پادشاه","کین چه باشد که زند بر عقل راه","پادشاه به کمک عقل خود درپی این است که بفهمد چه چیزی مانع روند طبیعی عقل او شده و سبب می‌شود که عقل را تحت تأثیر قرار دهد."],[930,"چشم من پرست و سیرست و غنی","از دو صد خورشید دارد روشنی","چشم من با عشق و محبت پر است و سیراب شده، و از نظرگاه و شناختش مانند دو صد خورشید روشنایی دارد."],[930,"ای رخ شاهان بر من بیذقی","نیم اسپم در رباید بی حقی","ای چهره زیبا و دلربای شاهان، من که اسبی کم‌خاصیت و ضعیف هستم، نمی‌توانم به دست آوردن چنین زیبایی را حق خود بدانم."],[930,"جادوی کردست جادو آفرین","جذبه باشد آن نه خاصیات این","جادوگری که جادو را خلق کرده، در واقع جاذبه و کشش خاصی دارد، نه اینکه این ویژگی‌ها به خود جادو وابسته باشد."],[930,"فاتحه خواند و بسی لا حول کرد","فاتحه‌ش در سینه می‌افزود درد","فاتحه خواند و با طواف دور آن، درد و رنج بیشتری به دلش می‌افزود."],[930,"زانک او را فاتحه خود می‌کشید","فاتحه در جر و دفع آمد وحید","زیرا او (شاه) فاتحه‌ی خود را می‌خواند و با آن به حالتی خاص خود را مشغول می‌کرد، این فاتحه در حال جدل و جدال او، به نوعی به انجام می‌رسید."],[930,"گر نماید غیر هم تمویه اوست","ور رود غیر از نظر تنبیه اوست","اگر کسی غیر از آنچه باید نشان دهد، نشان بدهد، آن کار او فریب و تدلیس است، و اگر از نگریستن به حقیقت منحرف شود، هدفش تنها تنبیه و آگاه‌سازی است."],[930,"پس یقین گشتش که جذبه زان سریست","کار حق هر لحظه نادر آوریست","مطمئن شد که این جذبه و کشش ناشی از آن سر (حضور خداوند) است و کار حق در هر لحظه چیز نادری را به وجود می‌آورد."],[930,"اسپ سنگین گاو سنگین ز ابتلا","می‌شود مسجود از مکر خدا","اسپ سنگین و کسل از مشکلات و سختی‌ها به وجود می‌آید، که این نشان‌دهنده تدبیر و مکر خداوند است. به عبارت دیگر، خداوند با تدبیر خود موجب می‌شود که چیزهایی که به نظر می‌رسند سنگین و دشوار، در واقع نشان‌دهنده حکمت و اراده او هستند."],[930,"پیش کافر نیست بت را ثانیی","نیست بت را فر و نه روحانیی","بت به معنای چیزی است که مورد پرستش قرار می‌گیرد. در مواقعی که با مفهوم خداوند و ایمان به او در تضاد قرار می‌گیرد، ولا غیر، باید گفت که در مقابل کافران و بی‌دینان، بت دوم و دومی وجود ندارد و نه حتی به لحاظ ظاهری (فر) و نه به لحاظ باطنی (روحانی) نمی‌توان چیزی را نیافت که برای پرستش به آن توجه کرد."],[930,"چیست آن جاذب نهان اندر نهان","در جهان تابیده از دیگر جهان","این بیت به جاذبه‌ای اشاره دارد که در عمق دل‌ها و وجودها وجود دارد و باعث می‌شود چیزهایی را که از دنیای دیگران آمده، در این جهان تابیده و احساس شود. این جاذبه به طور معنوی و درونی است و ممکن است به عشق یا جذبه‌های عمیق اشاره داشته باشد."],[930,"عقل محجوبست و جان هم زین کمین","من نمی‌بینم تو می‌توانی ببین","عقل در حجاب است و جان نیز به خاطر همین حجاب پنهان شده است، من نمی‌توانم تو را ببینم، اما تو قادر به دیدن من هستی."],[930,"چونک خوارمشه ز سیران باز گشت","با خواص ملک خود هم‌راز گشت","خوارزمشاه بعد از بازگشت از سیران، با نزدیکان و خواص خود در مورد مسائل کشور و امور دولتی مشورت کرد و راز گفت."],[930,"پس به سرهنگان بفرمود آن زمان","تا بیارند اسپ را زان خاندان","پس به سرهنگ‌ها دستور داد تا آن اسپ را از آن خاندان بیاورند."],[930,"هم‌چو آتش در رسیدند آن گروه","هم‌چو پشمی گشت امیر هم‌چو کوه","آن گروه مانند آتش نزدیک شدند و امیر مانند پشم نرم و بی‌دفاع شد، به اندازه‌ای که به شدت تحت تأثیر قرار گرفت و نتوانست مقاومت کند."],[930,"جانش از درد و غبین تا لب رسید","جز عمادالملک زنهاری ندید","جان خوارزمشاه از درد و غم به حدی رسیده است که به لبانش نزدیک شده، اما در این حال تنها عمادالملک را به عنوان پشتیبان و نگاه‌دار خود می‌بیند."],[930,"که عمادالملک بد پای علم","بهر هر مظلوم و هر مقتول غم","عمادالملک به خاطر دانش و علم خود، به حمایت از هر مظلوم و کشته‌شده‌ای می‌شتابد و غم آن‌ها را به دوش می‌کشد."],[930,"محترم‌تر خود نبد زو سروری","پیش سلطان بود چون پیغامبری","شخصی که در جمع سلطان قرار داشت، از او محترم‌تر نبود و می‌توانست سروری باشد، مانند یک پیامبر که در نزد پادشاه می‌ایستد."],[930,"بی‌طمع بود او اصیل و پارسا","رایض و شب‌خیز و حاتم در سخا","او انسانی بی‌طمع، با اصل و نیکوکار بود و در عین حال، در بیداری شب‌ها فعال و در سخاوت مانند حاتم طائی (شخصیت معروف در بخشندگی) بود."],[930,"بس همایون‌رای و با تدبیر و راد","آزموده رای او در هر مراد","شاه از نظر نیکویی و حکمت، بسیار برجسته و با تدبیر است و در هر خواسته‌ای که داشته باشد، در کارهای خود به خوبی عمل می‌کند."],[930,"هم به بذل جان سخی و هم به مال","طالب خورشید غیب او چون هلال","او (خوارزمشاه) هم از نظر جود و بخشش جانش را می‌دهد و هم با مالش در پی آفتاب نهانی است که به مانند هلال جلوه‌گر می‌شود."],[930,"در امیری او غریب و محتبس","در صفات فقر وخلت ملتبس","در مقام و جایگاه امیر، او غریب و در محبس است و به صفات فقر و عزلت لباس پوشیده است."],[930,"بوده هر محتاج را هم‌چون پدر","پیش سلطان شافع و دفع ضرر","هر نیازمند مانند فرزند نزد سلطان است، که او به عنوان شفیع به او کمک کرده و مشکلاتش را رفع می‌کند."],[930,"مر بدان را ستر چون حلم خدا","خلق او بر عکس خلقان و جدا","این بیت اشاره دارد به این‌که خداوند، چون که دارای حلم و بردباری است، پرده‌ای بر رازهای او می‌افکند و او را برعکس دیگران می‌آفریند و از آن‌ها جدا می‌سازد. به این معنی که خلقت او به گونه‌ای است که با دیگران تفاوت دارد و ویژگی‌های منحصر به فردی دارد."],[930,"بارها می‌شد به سوی کوه فرد","شاه با صد لابه او را دفع کرد","بارها پیش می‌آمد که شاه فرد با هزار زحمت و ناله و درخواست، از کوه دور می‌شد و به او اجازه نمی‌دادند نزدیک شود."],[930,"هر دم ار صد جرم را شافع شدی","چشم سلطان را ازو شرم آمدی","هر بار که تو بتوانی بر گناهان خود تکیه کنی و آنها را به شفاعت کسی از خود دور کنی، باز هم چشمان سلطان (شاه) از شرم و حیا به تو نخواهد نگریست."],[930,"رفت او پیش عماد الملک راد","سر برهنه کرد و بر خاک اوفتاد","او به سوی عمادالملک، که یکی از لشکریان و فرماندهان شاه بود، رفت و با حالتی از احساس خضوع و عذرخواهی، سرش را برهنه کرد و به نشانه احترام به زمین افتاد."],[930,"که حرم با هر چه دارم گو بگیر","تا بگیرد حاصلم را هر مغیر","من هر چه دارم، حتی حرمتم را برای تو می‌دهم تا اگر چیزی از من کم شود، به دست بیاوری و پاداش من را فراموش نکنی."],[930,"این یکی اسپست جانم رهن اوست","گر برد مردم یقین ای خیردوست","این اسب، جان من را به او سپرده‌ام و اگر مردم این اسب را ببرند، یقین بدان ای دوست خردمند که من دیگر زنده نخواهم ماند."],[930,"گر برد این اسپ را از دست من","من یقین دانم نخواهم زیستن","اگر این اسب را از من بگیرند، مطمئن هستم که نمی‌توانم زندگی کنم."],[930,"چون خدا پیوستگیی داده است","بر سرم مال ای مسیحا زود دست","چون خداوند به من برکت و نعمت بخشیده است، ای مسیحا، سریع‌تر دست مرا بگیر و کمکم کن."],[930,"از زن و زر و عقارم صبر هست","این تکلف نیست نی تزویریست","من در برابر زن و مال و دارایی صبر دارم؛ این کار به زحمت و تظاهر (تکلف) نیست و انتظاری برای فریب یا تزویر ندارد."],[930,"اندرین گر می‌نداری باورم","امتحان کن امتحان گفت و قدم","در این بیت، شاعر به شخصی اشاره دارد که در حال امتحان کردن دیگران است و از او می‌خواهد اگر به حقیقت او ایمان ندارد، او را آزمایش کند. این شخص بر این باور است که در این امتحان، اولیاء الله می‌توانند نشان دهند که در دل‌شان چه می‌گذرد."],[930,"آن عمادالملک گریان چشم‌مال","پیش سلطان در دوید آشفته‌حال","عمادالملک با چشم‌هایی اشک‌آلود و آشفته‌حال به سوی سلطان دوید."],[930,"لب ببست و پیش سلطان ایستاد","راز گویان با خدا رب العباد","عمادالملک لب‌هایش را بست و در برابر سلطان ایستاد و رازها را با خداوند، پروردگار عالم، در میان گذاشت."],[930,"ایستاده راز سلطان می‌شنید","واندرون اندیشه‌اش این می‌تنید","سلطان در حال راز و نیاز با خدا ایستاده بود و او (راوی) در دلش به تفکر و تأمل درباره آنچه می‌شنید مشغول بود."],[930,"کای خداگر آن جوان کژ رفت راه","که نشاید ساختن جز تو پناه","خداوندا، اگر آن جوان منحرف شده از راه راست، به غیر از تو پناهگاهی ندارد، پس به او کمک کن و راه درست را به او نشان بده."],[930,"تو از آن خود بکن از وی مگیر","گرچه او خواهد خلاص از هر اسیر","تو از آنچه خود داری استفاده کن و آن را از دیگری مگیر، حتی اگر او بخواهد تو را از هر گونه وابستگی و گرفتاری رهایی بخشد."],[930,"زانک محتاجند این خلقان همه","از گدایی گیر تا سلطان همه","چون همه مردم به نوعی دچار نیازمندی هستند و به دست‌آوردن نیازهای خود به دیگران وابسته‌اند، پس حتی سلطان و ruler نیز به درستی در واقع گداهایی هستند که به دنبال برآورده شدن خواسته‌هایشان هستند."],[930,"با حضور آفتاب با کمال","رهنمایی جستن از شمع و ذبال","در زمان حضور آفتاب، نیازی به روشنایی گرفتن از شمع و چراغ نیست؛ یعنی وقتی حقیقت و راهنمایی بزرگ و واضحی وجود دارد، دیگر به جستجوی نورهای کوچک و کم‌ارزش نیازی نیست."],[930,"با حضور آفتاب خوش‌مساغ","روشنایی جستن از شمع و چراغ","در حضور آفتاب، نیازی به تابش شمع و چراغ نیست، زیرا نور آفتاب خود روشنی‌بخش است."],[930,"بی‌گمان ترک ادب باشد ز ما","کفر نعمت باشد و فعل هوا","اگر ما از آداب و ادب دور شویم، بی‌تردید این کار ناپسند و نشانه بی‌خبری از نعمت‌های الهی است و عملی بر اساس خواسته‌های نفسانی به شمار می‌آید."],[930,"لیک اغلب هوش‌ها در افتکار","هم‌چو خفاشند ظلمت دوستدار","اکثر انسان‌ها مانند خفاش‌ها در تاریکی و نادانی بسر می‌برند و نسبت به حقیقت و روشنایی، که همان دوست و یار است، بی‌خبرند."],[930,"در شب ار خفاش کرمی می‌خورد","کرم را خورشید جان می‌پرورد","اگر در شب، خفاشی باشد که کرمی می‌خورد، خورشید، جان آن کرم را پرورش می‌دهد."],[930,"در شب ار خفاش از کرمیست مست","کرم از خورشید جنبنده شدست","اگر خفاشی در شب به خاطر کرمی مست و شاداب باشد، بدین معناست که آن کرم از خورشید زندگانی و حرکت می‌گیرد."],[930,"آفتابی که ضیا زو می‌زهد","دشمن خود را نواله می‌دهد","آفتابی که نورش را از دیگران دریغ نمی‌کند، به دشمن خود هم از نعمت‌اش بهره می‌دهد."],[930,"لیک شهبازی که او خفاش نیست","چشم بازش راست‌بین و روشنیست","اما پرنده‌ای همانند شهباز که مانند خفاش نیست، چشمانش باز و توانایی دیدن و تشخیص درست را دارد و در روشنایی قرار دارد."],[930,"گر به شب جوید چو خفاش او نمو","در ادب خورشید مالد گوش او","اگر کسی مانند خفاش در شب به دنبال چیزی باشد، یعنی در نادانی و جهل غرق شده است و در جایگاه ادب و دانش به روشنایی خورشید نمی‌رسد."],[930,"گویدش گیرم که آن خفاش لد","علتی دارد ترا باری چه شد","مولانا به شخصی می‌گوید که اگر می‌گویی خفاش به دلیل خاصی در شب به سر می‌برد، پس نکنه نداشته‌ات چیست که تو نیز بر اساس همین علت، این چنین رفتار می‌کنی."],[930,"مالشت بدهم به زجر از اکتیاب","تا نتابی سر دگر از آفتاب","اگر تو را به زجر و تنبیه کنم و مالش دهم، از ناپسند بودن و دلهره دور می‌مانی و سر دیگر را از نور آفتاب نمی‌پوشانی."],[931,"آنچنان که یوسف از زندانیی","با نیازی خاضعی سعدانیی","یوسف به خاطر نیاز و درماندگی‌اش از زندان درخواست یاری می‌کند و این نشان‌دهنده‌ی تواضع و فروتنی اوست."],[931,"خواست یاری گفت چون بیرون روی","پیش شه گردد امورت مستوی","یوسف خواست تا وقتی که از زندان آزاد می‌شود، برای پیشرفت و ساماندهی کارهایش به کمک ملایکه و قدرتی که در دربار پادشاه هست، مراجعه کند."],[931,"یاد من کن پیش تخت آن عزیز","تا مرا هم واخرد زین حبس نیز","یاد مرا در پیشگاه آن عزیز (که منظور یوسف است) فراموش نکن تا من هم از این حبس آزاد شوم."],[931,"کی دهد زندانیی در اقتناص","مرد زندانی دیگر را خلاص","چه کسی به زندانی کمک می‌کند تا زندانی دیگر را از گرفتاری‌هایش نجات دهد؟"],[931,"اهل دنیا جملگان زندانیند","انتظار مرگ دار فانیند","همه مردم دنیا به نوعی زندانی هستند و در انتظار مرگ، زندگی موقتی را سپری می‌کنند."],[931,"جز مگر نادر یکی فردانیی","تن به زندان جان او کیوانیی","تنها نادر افرادی هستند که مانند یوسف، جان خود را در بند دنیا نمی‌دانند و آزاد به زندگی می‌کنند."],[931,"پس جزای آنک دید او را معین","ماند یوسف حبس در بضع سنین","به خاطر اینکه یوسف در زمان نیازش به کمک، از غیر خدا یاری طلبید، جزای او این شد که در زندان بماند و سال‌ها را در حبس سپری کند."],[931,"یاد یوسف دیو از عقلش سترد","وز دلش دیو آن سخن از یاد برد","یاد آن دیو (شیطان) که به یوسف گفت از عقل او را برد و آن سخن را از دلش فراموش کرد."],[931,"زین گنه کامد از آن نیکوخصال","ماند در زندان ز داور چند سال","به همین خاطر، یوسف با آن ویژگی‌های نیکو، به مدت چند سال در زندان ماند."],[931,"که چه تقصیر آمد از خورشید داد","تا تو چون خفاش افتی در سواد","تو چه گناهی کرده‌ای که مانند خفاش در تاریکی افتاده‌ای و به خورشید حقیقت و روشنی پشت کرده‌ای. خفاش به‌طور طبیعی در شب و تاریکی زندگی می‌کند، اما تو چرا از نور حقیقت دور مانده‌ای؟"],[931,"هین چه تقصیر آمد از بحر و سحاب","تا تو یاری خواهی از ریگ و سراب","چه اشتباهی کرده‌ای که از دریا و ابر مدد می‌خواهی، در حالی که به جای آن به ریگ و سراب (آب بی‌فایده) پناه می‌بری."],[931,"عام اگر خفاش طبعند و مجاز","یوسفا داری تو آخر چشم باز","اگر همه مردم مانند خفاش باشند و از حقیقت دور افتاده باشند، تو باید مانند یوسف که نوری در تاریکی است، چشم باز داشته باشی و از حقایق غافل نشوی."],[931,"گر خفاشی رفت در کور و کبود","باز سلطان دیده را باری چه بود","اگر خفاشی در تاریکی و رنگ تیره‌ای پرواز کند، برای یک پادشاه که چشمانش به نور آشناست، چه فرقی دارد؟"],[931,"پس ادب کردش بدین جرم اوستاد","که مساز از چوب پوسیده عماد","مولانا به این نکته اشاره می‌کند که یوسف، با این که به جرم کمک خواستن از غیر خدا در زندان بود، تحت تعلیم و تربیت خدا قرار گرفت و به او می‌گوید که مانند چوپان، به چیزهای بی‌ارزش و فاسد (چوب پوسیده) نپردازد و از آن‌ها دوری کند."],[931,"لیک یوسف را به خود مشغول کرد","تا نیاید در دلش زان حبس درد","اما خداوند یوسف را به خود مشغول ساخت تا فراموش کند که در دلش از درد زندان رنج ببرد."],[931,"آنچنانش انس و مستی داد حق","که نه زندان ماند پیشش نه غسق","حق آنچنان به یوسف انس و شادمانی بخشید که برای او نه زندان اهمیتی داشت و نه ظلمت و سختی آن."],[931,"نیست زندانی وحش‌تر از رحم","ناخوش و تاریک و پرخون و وخم","زیر رحم مادر، مکانی وجود ندارد که از آن وحشت‌انگیزتر باشد؛ مکانی که تاریک، ناخوشایند، پرخون و غیرقابل تحمل است."],[931,"چون گشادت حق دریچه سوی خویش","در رحم هر دم فزاید تنت بیش","هرگاه خداوند دری به سوی خودت در رحم مادر باز کند، هر لحظه بر قامت و وجود تو افزوده می‌شود."],[931,"اندر آن زندان ز ذوق بی‌قیاس","خوش شکفت از غرس جسم تو حواس","در آن زندان، حواس تو به شدت از لذت غیرقابل وصفی شکوفا شده است که به خاطر وجود جسم تو به بار نشسته و رشد کرده است."],[931,"زان رحم بیرون شدن بر تو درشت","می‌گریزی از زهارش سوی پشت","خروج از رحم مادر برای تو سخت و دشوار است و تو از خطرات و سختی‌های آن فرار می‌کنی و به عقب برمی‌گردی."],[931,"راه لذت از درون دان نه از برون","ابلهی دان جستن قصر و حصون","لذتی که واقعی است، از درون انسان ناشی می‌شود، نه از外. انسان‌های نادان به‌جای آن که به دنبال خوشی‌های درونی باشند، در جستجوی قلعه‌ها و بناهای ظاهری هستند."],[931,"آن یکی در کنج مسجد مست و شاد","وآن دگر در باغ ترش و بی‌مراد","یکی در گوشه مسجد در حال شادی و مستی به سر می‌برد و دیگری در باغی غمگین و ناامید است."],[931,"قصر چیزی نیست ویران کن بدن","گنج در ویرانی است ای میر من","بدن انسان به تنهایی ارزش چندانی ندارد و در واقع، گنج واقعی در خالی و ویران کردن آن است. ای سرور من، باید به عمق این حقیقت پی برد که در ویرانی و رهایی از قید و بندهای جسم، چیزهای ارزشمندی نهفته است."],[931,"این نمی‌بینی که در بزم شراب","مست آنگه خوش شود کو شد خراب","تو نمی‌بینی که در جشن شراب، مستی و شادمانی چگونه به وجود می‌آید، اما در عوض، خراب شدن و ویرانی هم در پی آن است."],[931,"گرچه پر نقش است خانه برکنش","گنج جو و از گنج آبادان کنش","هرچند که این خانه پر از نقش و زیبایی است، اما آن را رها کن و به دنبال گنجی بگرد که در آن نهفته است و آن را آبادتر کن."],[931,"خانه پر نقش تصویر و خیال","وین صور چون پرده بر گنج وصال","خانه‌ای که پر از نقوش و تصاویر است، شبیه پرده‌ای است که روی گنجی از وصال و محبت کشیده شده. این جلوه‌ها و خیال‌ها نشان‌دهنده مقداری از شعف و لذت ارتباط حقیقی هستند که در درون خود نهفته‌است."],[931,"پرتو گنجست و تابش‌های زر","که درین سینه همی‌جوشد صور","در این بیت، اشاره به گنجی با ارزش و درخشان است که در دل و وجود انسان نهفته است و آن پرتوها و تابش‌های زر به صورت تصاویر و زیبایی‌ها درون او جوش و خروش دارد. به عبارت دیگر، درون انسان سرشار از زیبایی‌های درونی و ارزشمند است که باید به آن توجه کرد."],[931,"هم ز لطف و عکس آب با شرف","پرده شد بر روی آب اجزای کف","به خاطر لطف و انعکاس آب، سطح آب کفی از اجزا و مواد را تشکیل داده است."],[931,"هم ز لطف و جوش جان با ثمن","پرده‌ای بر روی جان شد شخص تن","از لطف و نشوه‌ی روح در کنار ارزش‌های مادی، پرده‌ای بر روی روح انسان قرار می‌گیرد که او را از حقیقت وجودش متمایز می‌سازد."],[931,"پس مثل بشنو که در افواه خاست","که اینچ بر ماست ای برادر هم ز ماست","پس به خویشتن گوش کن و ببین که چه چیزی در زبان‌ها و گفته‌ها بلند شده است؛ چراکه آنچه در افواه مردم می‌شنوی، از خود ما نشأت می‌گیرد و به ما مربوط است، ای برادر."],[931,"زین حجاب این تشنگان کف‌پرست","زآب صافی اوفتاده دوردست","به‌خاطر این حجاب و فاصله‌ای که از حقیقت وجود دارد، این تشنگان که فقط به ظاهر و ظرف آب می‌نگرند، از آب زلال و اصلی دور مانده‌اند."],[931,"آفتابا با چو تو قبله و امیم","شب‌پرستی و خفاشی می‌کنیم","ای خورشید، با وجود تو ما همچنان در حال پرستش شب و خفاشی هستیم و به تو به عنوان قبله و راهنما توجه نمی‌کنیم."],[931,"سوی خود کن این خفاشان را مطار","زین خفاشیشان بخر ای مستجار","ای پروردگار، از نزد خود خفاش‌ها را دور کن، زیرا با رفتار خفاش‌گونه‌شان به تو پناه آورده‌اند."],[931,"این جوان زین جرم ضالست و مغیر","که به من آمد ولی او را مگیر","این جوان به خاطر گناهی که مرتکب شده است، منحرف و دگرگون است، بنابراین او را نگیرید و از خود دور نکنید، چون به من آمده است."],[931,"در عمادالملک این اندیشه‌ها","گشته جوشان چون اسد در بیشه‌ها","در عمادالملک، این افکار و اندیشه‌ها به شدت در حال تلاطم و جنب و جوش هستند، مانند اسدی که در جنگل‌ها در حال شکار و فعالیت است."],[931,"ایستاده پیش سلطان ظاهرش","در ریاض غیب جان طایرش","ایستاده در برابر سلطان، به ظاهر در باغ‌های غیب، جان پرنده‌اش را نشان می‌دهد."],[931,"چون ملایک او به اقلیم الست","هر دمی می‌شد به شرب تازه مست","وقتی ملائکه در عالم ازلی (اقلیم الست) او را می‌دیدند، هر لحظه او را به حالتی شاداب و سرمست می‌کردند."],[931,"اندرون سور و برون چون پرغمی","در تن همچون لحد خوش عالمی","درون خود شادی و سروری است و بیرون مانند گلی خوشبو و لطیف است، در حالی که بدنش مانند قبر (لحد) می‌ماند که پنهان‌ کننده‌ی آن عالم شگفت‌انگیز است."],[931,"او درین حیرت بد و در انتظار","تا چه پیدا آید از غیب و سرار","شخصی در این سرگردانی و حیرت به سر می‌برد و در انتظار است که چه چیزهایی از عالم غیب و اسرار برایش آشکار خواهد شد."],[931,"اسپ را اندر کشیدند آن زمان","پیش خوارمشاه سرهنگان کشان","در آن زمان، هنگامی که یوسف (علیه‌السلام) را در چاه انداختند، اسب را به نزد خوارمشاه (شخصی بزرگ یا پادشاه) آوردند و سرهنگان (فرماندهان) او را کشان‌کشان به پیش او بردند."],[931,"الحق اندر زیر این چرخ کبود","آنچنان کره به قد و تگ نبود","واقعیت این است که در زیر این آسمان تیره و نابه‌سامان، حقیقت به اندازه‌ای نیست که بتوان آن را به راحتی مشاهده کرد یا اندازه گرفت."],[931,"می‌ربودی رنگ او هر دیده را","مرحب آن از برق و مه زاییده را","هر چشمی که رنگ او را می‌بیند، به شدت تحت تأثیر زیبایی و نور آن قرار می‌گیرد، همان‌طور که مرحب (جوانی زاییده شده از زیبایی و پرزرق و برق) است."],[931,"همچو مه همچون عطارد تیزرو","گوییی صرصر علف بودش نه جو","مانند ماه و عطارد که بسیار تند و سریع هستند، در اینجا گفته شده که بادی مانند صرصر (بادی شدید و سرد) وجود دارد که علف‌ها را جابه‌جا می‌کند، اما جو (غلات) را حرکت نمی‌دهد. این تصویر به نوعی اشاره به ناتوانی یا کم‌اهمیتی در مقایسه با چیزهای دیگر دارد."],[931,"ماه عرصه آسمان را در شبی","می‌برد اندر مسیر و مذهبی","ماه در آسمان، در شبی خاص، از مسیری خاص عبور می‌کند و به نوعی در حیات و معنای خاصی شرکت دارد."],[931,"چون به یک شب مه برید ابراج را","از چه منکر می‌شوی معراج را","اگر ماه در یک شب، تأثیر خاصی در آسمان و ستاره‌ها (ابراج) بگذارد، چرا معراج (صعود و عروج روحانی) را انکار می‌کنی؟ این به معنای این است که اگر یک واقعه شگفت‌انگیز می‌تواند واقع شود، پس انکار وقوع معراج که از معجزات است، بی‌مورد است."],[931,"صد چو ماهست آن عجب در یتیم","که به یک ایماء او شد مه دو نیم","عجبی شگفت در یتیم وجود دارد که مانند ماه درخشان است؛ چرا که با یک اشاره، او می‌تواند به دو نیم تقسیم شود و این قدرت به خاطر ویژگی‌هایی است که در او نهفته است."],[931,"آن عجب کو در شکاف مه نمود","هم به قدر ضعف حس خلق بود","این شگفتی که در شکاف ماه نمایان شد، به اندازه‌ی ناتوانی حس انسان‌هاست."],[931,"کار و بار انبیا و مرسلون","هست از افلاک و اخترها برون","کار و فعالیت پیامبران و فرستادگان خدا، فراتر از آسمان‌ها و ستاره‌ها است."],[931,"تو برون رو هم ز افلاک و دوار","وانگهان نظّاره کن آن کار و بار","از آسمان و گردون فاصله بگیر و نگاهی به کار و وظایف انبیا و فرستادگان الهی بینداز."],[931,"در میان بیضه‌ای چون فرخ‌ها","نشنوی تسبیح مرغان هوا","در میان تخم‌مرغی که مانند جوجه‌هاست، صدای تسبیح پرندگان آسمانی را نخواهی شنید."],[931,"معجزات اینجا نخواهد شرح گشت","ز اسپ و خوارمشاه گو و سرگذشت","در اینجا قرار نیست معجزات و داستان‌های شگفت را توضیح دهیم، بلکه باید از اسب و حیوان دیگر (خوارمشاه) و سرگذشت آنها سخن بگوییم."],[931,"آفتاب لطف حق بر هر چه تافت","از سگ و از اسپ فر کهف یافت","خورشید رحمت خدا بر هر چیز تابید، حتی بر سگ و بر اسبی که در غار پناه گرفته بودند."],[931,"تاب لطفش را تو یکسان هم مدان","سنگ را و لعل را داد او نشان","شما نباید تصور کنید که نعمت و لطف خداوند به همه موجودات به یک اندازه است؛ او به هر چیزی به تناسب خود عطا می‌کند، مانند تفاوتی که بین سنگ و لعل (جواهر) وجود دارد."],[931,"لعل را زان هست گنج مقتبس","سنگ را گرمی و تابانی و بس","لعل، به خاطر درخشندگی و زیبایی‌اش، گنجی ست که از نور و تأثیرات دیگر به دست آمده، در حالی که سنگ، فقط گرما و درخشندگی دارد و نکته خاصی در آن نیست."],[931,"آنک بر دیوار افتد آفتاب","آنچنان نبود کز آب و اضطراب","آفتاب اگر بر دیوار بیفتد، این‌طور نیست که از آب یا اضطراب کم شوند، یعنی اشیاء از بین نروند. در حقیقت، حتی اگر چیزی دچار نوسان یا تلاطم شود، روشنایی و زیبایی‌اش باقی می‌ماند."],[931,"چون دمی حیران شد از وی شاه فرد","روی خود سوی عماد الملک کرد","شاه در یک لحظه از دست یوسف به حیرت افتاد و به عماد الملک، وزیر خود، روی آورد."],[931,"کای اچی بس خوب اسپی نیست این","از بهشتست این مگر نه از زمین","این اسب بسیار خوب و زیبایی که می‌بینید، از بهشت آمده و نه از زمین."],[931,"پس عماد الملک گفتش ای خدیو","چون فرشته گردد از میل تو دیو","عماد الملک به خدا می‌گوید: ای پادشاه، اگر تو من را بخواهی، من مثل یک فرشته می‌شوم، ولی در غیر این صورت شبیه دیو خواهم بود."],[931,"در نظر آنچ آوری گردید نیک","بس گش و رعناست این مرکب ولیک","آنچه در نظر دیگران ظاهر می‌شود، به نظر زیبا و دلپسند می‌آید، اما این مرکب (حیوانی که سوار آن می‌شوند) به ظاهر خوب است، اما حقیقتا نقص‌هایی دارد."],[931,"هست ناقص آن سر اندر پیکرش","چون سر گاوست گویی آن سرش","پیکر او ناتمام و ناقص است، مانند سر گاوی که به تنش چسبیده و نشان‌دهنده نقص و عیب اوست."],[931,"در دل خوارمشه این دم کار کرد","اسپ را در منظر شه خوار کرد","در دل خوارمش (پادشاه مصر) در این لحظه، چاره‌ای اندیشید که چگونه اسب را در برابر پادشاه زشت کند."],[931,"چون غرض دلاله گشت و واصفی","از سه گز کرباس یابی یوسفی","وقتی هدف دلال (راهنما) تغییر کند و او به وصف (تعریف کردن) کسی بپردازد، کار او به اندازه سه تکه کرباس (به عنوان نماد) به «یوسف» (یوسف صدیق) می‌رسد."],[931,"چونک هنگام فراق جان شود","دیو دلال در ایمان شود","زمانی که وقت جدایی فرا می‌رسد، شیطان وسوسه‌گر در دل انسان، به او القا می‌کند که به اعتقاداتش آسیب بزند."],[931,"پس فروشد ابله ایمان را شتاب","اندر آن تنگی به یک ابریق آب","در لحظات سخت و دشوار، برخی افراد نادان ممکن است به سرعت ایمان خود را به خاطر یک لذت زودگذر و کم‌ارزش، مانند یک‌ لیوان آب، بفروشند."],[931,"وان خیالی باشد و ابریق نی","قصد آن دلال جز تخریق نی","این خیال و تصویر ذهنی تنها ابزاری است و ابریق (که به معنی ظرف آب است) هیچ هدفی جز تخلیه و خالی کردن از خود ندارد."],[931,"این زمان که تو صحیح و فربهی","صدق را بهر خیالی می‌دهی","این زمان که تو در وضع مناسب و خوشی هستی، صداقت را به خاطر یک خیال و توهم ناچیز قربانی می‌کنی."],[931,"می‌فروشی هر زمانی درّ کان","هم‌چو طفلی می‌ستانی گردگان","تو هر زمان به بیهوده و بی‌ملاحظگی، چیزهای گرانبها و ارزشمندی را از دست می‌دهی، مانند کودکی که برای بازی و سرگرمی، جواهرات را می‌گیرد و به راحتی آنها را رها می‌کند."],[931,"پس در آن رنجوری روز اجل","نیست نادر گر بود اینت عمل","در روز رنج و سختی، در روز مرگ، نمی‌توان به کارهای نادرست و بی‌فایده ادامه داد. اگر در این زمانه کاری هم انجام شود، یا نتیجه‌ای نخواهد داشت یا نادر است."],[931,"در خیالت صورتی جوشیده‌ای","همچو جوزی وقت دق پوسیده‌ای","در ذهن تو تصاویری شکل گرفته که مانند گردویی هستند که در هنگام رسیدن به زمان مرگشان، پوسیده و خراب می‌شوند."],[931,"هست از آغاز چون بدر آن خیال","لیک آخر می‌شود هم‌چون هلال","آن خیال در ابتدا شبیه ماه کامل است، اما در نهایت به شکل هلالی کوچک تبدیل می‌شود."],[931,"گر تو اول بنگری چون آخرش","فارغ آیی از فریب فاترش","اگر تو به آغاز هر چیزی توجه کنی و آن را همانند پایانش ببینی، از فریب و دسیسه‌های آن رهایی می‌یابی."],[931,"جوز پوسیده‌ست دنیا ای امین","امتحانش کم کن از دورش ببین","دنیا مانند یک جوز پوسیده است و باید از او دوری کرد، ای امین! امتحانات و آزمایش‌هایش را کمتر کن و به تماشا بنشین."],[931,"شاه دید آن اسپ را با چشم حال","وآن عمادالملک با چشم مآل","شاه به آن اسب با دیدگاه حاضر نگاه کرد، در حالی که عمادالملک (یکی از شخصیت‌های مهم) آینده را در نظر می‌گرفت و به سرنوشت آن می‌اندیشید."],[931,"چشم شه دو گز همی دید از لغز","چشم آن پایان‌نگر پنجاه گز","شاه با چشمی که به وضع حال او نگاه می‌کند، می‌تواند از دور و از فاصله‌ای بسیار بیشتر، یعنی پنجاه گز، وضعیت آن شخص را ببیند. این نشان‌دهنده دید عمیق و توانایی خاص شاه در شناخت واقعیات است."],[931,"آن چه سرمه‌ست آنک یزدان می‌کشد","کز پس صد پرده بیند جان رشد","آن چیزی که به عنوان سرمه (رنگ و زینت) حضور دارد، از جانب خداوند آفریده شده است و او از پشت صدها پرده، روح را رشد و پرورش می‌دهد."],[931,"چشم مهتر چون به آخر بود جفت","پس بدان دیده جهان را جیفه گفت","چشم بزرگ‌تر (مهتر) وقتی به پایان دیدگانش می‌رسد، به آن دقت می‌کند که جهان را چیز بی‌ارزشی می‌بیند و آن را زشت و بی‌فایده می‌خواند."],[931,"زین یکی ذمش که بشنود او وحسپ","پس فسرد اندر دل شه مهر اسپ","این بیت به این مفهوم اشاره دارد که اگر کسی از عیب و نقص دیگری آگاه شود و آن را بشنود، در دل خود دچار خشم و کینه خواهد شد، به‌گونه‌ای که یا آن شخص را ترک می‌کند یا برایش دردسر ایجاد می‌کند. در این جا، «شه مهر اسپ» به کسی اشاره دارد که دچار چنین حالتی شده است."],[931,"چشم خود بگذاشت و چشم او گزید","هوش خود بگذاشت و قول او شنید","شه تمام عقل و هوش خود را رها کرد و به جای آن، به حرف یوسف گوش داد و آنچه او گفت را پذیرفت. این اشاره‌ای به پذیرش بی‌فکری و تسلیم شدن در برابر سخن دیگران دارد."],[931,"این بهانه بود و آن دیّان فرد","از نیاز آن در دل شه سرد کرد","این بهانه‌ای بود که یوسف (علیه‌السلام) با آن از نیازمندی‌اش به خداوند، دل شاه را سرد کرد و او را از این نیاز بی‌نیاز ساخت."],[931,"در ببست از حسن او پیش بصر","آن سخن بد در میان چون بانگ در","چشم شاه به زیبایی یوسف مجذوب شد و از آن‌جا که صحبت بدی در میان بود، این زیبایی مانند صدایی بلند به حواس او آمد و باعث شد که وی را نسبت به آن سخن بد غافل کند."],[931,"پرده کرد آن نکته را بر چشم شه","که از آن پرده نماید مه سیه","اشاره به این است که آن نکته (گناه یوسف در درخواست یاد شدن از عزیز) که باعث افتادن او به درون زندان شد، به چشم حاکم (شه) که به آن پرده‌اش می‌کشید، نمایان شد و این نکته شگفت‌انگیز مانند ماه تاریک جلوه کرد."],[931,"پاک بنایی که بر سازد حصون","در جهان غیب از گفت و فسون","به خانه‌سازی و بنیان‌گذاری اشاره دارد که در عالم غیب و ن unseen (نامرئی) به وسیله‌ی کلمات و جادوگری شکل می‌گیرد. این بناها از گفتار و بیان معانی ساخته می‌شوند."],[931,"بانگ در دان گفت را از قصر راز","تا که بانگ وا شده‌ست این یا فراز","در ناز و راز قصر معنوی، صدایی از گفت و گو در می‌آید، تا وقتی که این صوت به اوج و بلندی رسیده باشد."],[931,"بانگ در محسوس و در از حس برون","تبصرون این بانگ و در لاتبصرون","صدای آوازی که از قصر راز به گوش می‌رسد، قابل درک و محسوس است، اما این صدا از نظر معنوی شما قابل دیدن نیست و حقیقت آن را نمی‌توانید با حس‌های عادی خود درک کنید."],[931,"چنگ حکمت چونک خوش‌آواز شد","تا چه در از روض جنت باز شد","چنگ حکمت که صدای دلنوازی دارد، به قدری خوش‌صدا و جذاب می‌شود که باعث می‌شود درهای بهشت باز شود و به انسان‌ها راه یابد."],[931,"بانگ گفت بد چو دروا می‌شود","از سقر تا خود چه در وامی‌شود","زمانی که صدای خواب آوری به گوش می‌رسد، دیگر صدای جهنم (سقر) از میان میرود. وقتی که در به سوی بهشت باز می‌شود، دیگر چگونه می‌توان به در جهنم توجه کرد؟"],[931,"بانگ در بشنو چو دوری از درش","ای خنک او را که واشد منظرش","اگر از در حق دور شوی، صدای او را نمی‌شنوی؛ خوشا به حال کسی که به او نزدیک شده و چهره‌اش را دیده است."],[931,"چون تو می‌بینی که نیکی می‌کنی","بر حیات و راحتی بر می‌زنی","وقتی می‌بینی که کارهای نیک انجام می‌دهی و به زندگی و آرامش خود اهمیت می‌دهی،"],[931,"چونک تقصیر و فسادی می‌رود","آن حیات و ذوق پنهان می‌شود","وقتی که خطا و فساد به وجود می‌آید، آن زندگی و شادی پنهان از بین می‌رود."],[931,"دید خود مگذار از دید خسان","که به مردارت کشند این کرکسان","خودت را به دید و نظر بی‌ارزش مردم نگذار، زیرا این افراد، تو را به تنگنا و بدبختی می‌کشانند."],[931,"چشم چون نرگس فروبندی که چی","هین عصاام کش که کورم ای اچی","اگر چشمت را ببندی و به بی‌حالی بیفتی، بر من تکیه کن که من نیز مانند تو در این وضعیت هستم و کور شده‌ام."],[931,"وان عصاکش که گزیدی در سفر","خود ببینی باشد از تو کورتر","اگر کسی را به عنوان عصا و یا کمک انتخاب کردی و در سفر زندگی به او تکیه زدی، باید بدانی که او ممکن است حتی از تو نابینا و کورتر باشد، یعنی نتواند راه را بهتر از تو ببیند."],[931,"دست کورانه به حبل‌الله زن","جز بر امر و نهی یزدانی متن","به‌طور نادانسته به چنگال حمایت الهی نرو، مگر در چارچوب دستورها و نهی‌های خداوند."],[931,"چیست حبل‌الله رها کردن هوا","کین هوا شد صرصری مر عاد را","رها کردن حبل‌الله به این معناست که انسان از خواسته‌ها و تمایلات نفسانی خود که مانند طوفانی بی‌رحم برای قوم عاد بود، دست بردارد. این تمایلات بی‌فایده می‌توانند انسان را به هلاکت برسانند."],[931,"خلق در زندان نشسته از هواست","مرغ را پرها ببسته از هواست","انسان‌ها به خاطر داشتن هواهای نفس و خواسته‌های غیرالهی، در زنجیر اسارت و محدودیت گرفتار شده‌اند. مانند پرنده‌ای که به دلیل خواسته‌ها و انحرافاتش، بال‌هایش بسته شده و نمی‌تواند پرواز کند."],[931,"ماهی اندر تابه گرم از هواست","رفته از مستوریان شرم از هواست","ماهی در تابه داغ به خاطر هوای گرم و بخار آن است، و این که از دید پنهانی خارج شده، باعث شرمش می‌شود."],[931,"خشم شحنه شعله نار از هواست","چارمیخ و هیبت دار از هواست","خشم و قهر نگهبان و حاکم (شحنه) به اندازه یک شعله آتش است که فقط به واسطه هوا وجود دارد و این خشم در واقع ساختگی و ظاهری است. همچنین قدرت و هیبت او مانند یک میخ چهارگانه است که نشان‌دهنده حمایتی است که از او می‌شود، ولی در حقیقت، این نیز ریشه در هوا دارد و حقیقت ندارد."],[931,"شحنه اجسام دیدی بر زمین","شحنه احکام جان را هم ببین","شحنه، به معنای نگهبان یا پاسبان، در اینجا به نگهبانانی اشاره دارد که اجسام را در زمین مراقبت می‌کنند. حالا این عبارت می‌گوید که همان‌طور که شحنه‌ها و پاسبان‌ها برای اجسام در دنیا وجود دارند، باید به احکام و قوانین جان (روح) هم توجه داشته باشیم. یعنی زندگی روح نیز دارای نگهبان‌های خاص و قوانینی است که باید به آن‌ها توجه کنیم."],[931,"روح را در غیب خود اشکنجه‌هاست","لیک تا نجهی شکنجه در خفاست","روح انسان در عالم غیبی دچار شکنجه‌ها و آزمایش‌هایی است، اما تا زمانی که از وضعیت خود آگاه نشود، این شکنجه‌ها مخفی و ناچیز به نظر می‌رسد."],[931,"چون رهیدی بینی اشکنجه و دمار","زانک ضد از ضد گردد آشکار","زمانی که از رنج‌ها و عذاب‌ها رهایی یابی، می‌توانی درد و شکنجه را به وضوح ببینی، زیرا هر چیزی در تضاد با ضد خودش آشکار می‌شود."],[931,"آنک در چه زاد و در آب سیاه","او چه داند لطف دشت و رنج چاه","کسی که در جایی زاده شده و در دریای تاریک زندگی کرده، چگونه می‌تواند از زیبایی‌های دشت و سختی‌های چاه باخبر باشد؟"],[931,"چون رها کردی هوا از بیم حق","در رسد سغراق از تسنیم حق","زمانی که از ترس خداوند، خواسته‌ها و تمایلات نفسانی خود را رها کنی، جویبار رحمت و نعمت الهی به سراغت خواهد آمد."],[931,"لا تطرق فی هواک سل سبیل","من جناب الله نحو السلسبیل","در خواسته‌های نفسانی خود تسلیم نشو و به سراغ راهی برو که از جانب خداوند به سمت آب شیرین و زلال (سلسبیل) می‌رسد."],[931,"لا تکن طوع الهوی مثل الحشیش","ان ظل العرش اولی من عریش","مثل گیاهان بی‌مقدار و بی‌اراده، در پی خواسته‌های نفسانی و هوس‌ها نباش. سایه‌ی عرش الهی ارزش بیشتری دارد و شایسته‌تر از سرپناه‌های سطحی و بی‌فایده است."],[931,"گفت سلطان اسپ را وا پس برید","زودتر زین مظلمه بازم خرید","سلطان به افراد خود دستور می‌دهد که سریع‌تر اسب را از این مظالم دور کنند و آن را به گوشه‌ای ببرند."],[931,"با دل خود شه نفرمود این قدر","شیر را مفریب زین راس البقر","سلطان با دل خود نگفت که این شیر را به خاطر این سر گاو فریب بده. به عبارت دیگر، او نمی‌خواست به راحتی به فریبکاری تن بدهد و از حقیقت دور شود."],[931,"پای گاو اندر میان آری ز داو","رو ندوزد حق بر اسپی شاخ گاو","اگر پای گاو را در میان داو (شرایط ناپسند) قرار دهی، حق نمی‌تواند بر اسب، شاخ گاو بگذارد. در واقع، این تصویر به معنای این است که شرایط نادرست نمی‌تواند بگذارد که حق و حقیقت به درستی نمایان شوند."],[931,"بس مناسب صنعتست این شهره زاو","کی نهد بر جسم اسپ او عضو گاو","این شعر به ارتباط بین بدن نازک و سبک اسپ و بدن سنگین گاو اشاره دارد و می‌گوید این صنعت و هنر به قدری مناسب و زیباست که گویا اسپ بار دیگر بر جسم گاو تکیه زده است. به نظر می‌رسد که در اینجا، هنر را به عنوان عامل زیبایی در نظر گرفته که می‌تواند میان دو نوع بدن متفاوت، ارتباط برقرار کند."],[931,"زاو ابدان را مناسب ساخته","قصرهای منتقل پرداخته","زاو (سکوت) به بدن‌ها شکل و فرم مناسب داده و قصرهای برجسته و زیبایی را ساخته است."],[931,"در میان قصرها تخریج‌ها","از سوی این سوی آن صهریج‌ها","در میان قصرها، برای خارج کردن آب از سمت‌های مختلف صهریج‌ها (محل‌های ذخیره آب) مسیرهایی ایجاد شده است."],[931,"وز درونشان عالمی بی‌منتها","در میان خرگهی چندین فضا","از درون قصرها جهانی بی‌پایان وجود دارد که در میان آن، فضایی وسیع و چندین مکان برای آرامش و زندگی دیده می‌شود."],[931,"گه چو کابوسی نماید ماه را","گه نماید روضه قعر چاه را","گاهی ماه مانند یک کابوس به نظر می‌آید و گاهی تصویر باغی را به یاد می‌آورد که در اعماق چاه است."],[931,"قبض و بسط چشم دل از ذوالجلال","دم به دم چون می‌کند سحر حلال","حالت‌های متفاوت دل از زیبایی و عظمت پروردگار، لحظه به لحظه مانند سحر حلال تغییر می‌کند و این زیبایی و عظمت قدرتی سحرآسا دارد."],[931,"زین سبب درخواست از حق مصطفی","زشت را هم زشت و حق را حق‌نما","به همین دلیل درخواست از غیر خداوند، حتی برای شخصی چون مصطفی (پیامبر اسلام) نیز ناپسند است و در نهایت، با استفاده از حق‌نماها، زشتی‌ها را زیبا می‌بینیم."],[931,"تا به آخر چون بگردانی ورق","از پشیمانی نه افتم در قلق","اگر در نهایت، ورق را برگردانی و به پشیمانی برسد، من در اضطراب نمی‌افتم."],[931,"مکر که کرد آن عمادالملک فرد","مالک‌الملکش بدان ارشاد کرد","عمادالملک فرد، انسانی است که در قدرت و سلطنت مقام بالایی دارد. او به دلیل ارشاد و هدایت به خطایی که انجام داده، تحت تأثیر مکر و ترفندهایی قرار گرفته است."],[931,"مکر حق سرچشمه این مکرهاست","قلب بین اصبعین کبریاست","حق، منشأ و آغاز مکر و فریب‌های این دنیا است و قلب انسان در بین دو انگشت قدرت الهی قرار دارد؛ یعنی تحت کنترل و برنامه‌ریزی آن است."],[931,"آنک سازد در دلت مکر و قیاس","آتشی داند زدن اندر پلاس","این بیت می‌گوید اگر در دل تو مکر و تردید به وجود آورد، مانند آتشی می‌داند که در پلاس (پارچه نازک) می‌سوزد، یعنی آسیب و ضرر می‌زند."],[932,"بی‌نهایت آمد این خوش سرگذشت","چون غریب از گور خواجه باز گشت","این داستان خوش‌عاقبت و دلنشین به قدری زیبا و بی‌نهایت است که مانند یک غریب از دنیای مردگان (گور خواجه) باز می‌گردد."],[932,"پای مردش سوی خانه خویش برد","مهر صد دینار را فا او سپرد","پای مرد به سمت خانه‌اش رفت، و او مهر صد دیناری را که به عهده داشت، به کسی سپرد."],[932,"لوتش آورد و حکایت‌هاش گفت","کز امید اندر دلش صد گل شکفت","او (غریب) لوت (رنج، زحمت) را به خانه آورد و داستان‌ها را تعریف کرد که در دلش از امید، صد گل شکفت. یعنی او با وجود مشکلات، امیدش را از دست نداده و احساس شادی و خوشحالی می‌کند."],[932,"آنچ بعد العسر یسر او دیده بود","با غریب از قصه آن لب گشود","بسیاری از مشکلات به آسانی حل خواهند شد. او داستان غریبی را با توجه به تجربه‌اش از یک فرد غریب بازگو کرد که در شرایط سخت به یاریش آمده بود."],[932,"نیم‌شب بگذشت و افسانه کنان","خوابشان انداخت تا مرعای جان","نیمه‌شب گذشت و قصه‌گویی آن‌ها را به خواب برد تا به آرامش جانشان برسند."],[932,"دید پامرد آن همایون خواجه را","اندر آن شب خواب بر صدر سرا","پای‌مرد در آن شب، خواب خواجه بزرگ و محترم را دید که بر بالای تخت نشسته است."],[932,"خواجه گفت ای پای‌مرد با نمک","آنچ گفتی من شنیدم یک به یک","خواجه به پای‌مرد می‌گوید: ای مرد باهوش و خوش‌زبان، هرچه را که گفتی، من به‌طور کامل شنیدم."],[932,"لیک پاسخ دادنم فرمان نبود","بی‌اشارت لب نیارستم گشود","ولی نمی‌توانم پاسخ دهم، زیرا این کار بر اساس دستور نبود و بدون اشاره کسی نمی‌توانستم لب به سخن بگشایم."],[932,"ما چو واقف گشته‌ایم از چون و چند","مهر با لب‌های ما بنهاده‌اند","ما به حال و احوال و جزئیات امور آگاه شده‌ایم، ولی محبت و عشق را در سخنانی که از لب‌هایمان می‌گوید، پنهان کرده‌اند."],[932,"تا نگردد رازهای غیب فاش","تا نگردد منهدم عیش و معاش","تا زمانی که رازهای باطنی و نامشهود آشکار نشود، زندگی و سعادت ما هم به خطر نخواهد افتاد."],[932,"تا ندرد پرده غفلت تمام","تا نماند دیگ محنت نیم‌خام","تا زمانی که پرده غفلت کاملا پاره نشود و آگاهی کامل حاصل نگردد، رنج و مشکلات زندگی به طور کامل حل نخواهد شد و مانند دیگی که هنوز به خوبی نپخته، باقی خواهند ماند."],[932,"ما همه گوشیم کر شد نقش گوش","ما همه نطقیم لیکن لب خموش","ما همه مانند گوش‌هایی هستیم که ناشنوا شده‌اند و فقط به شکل ظاهری وجود دارند؛ در حالی‌که همه ما سخن می‌گوییم، اما زبان‌مان ساکت است و نمی‌توانیم حقیقت را بیان کنیم."],[932,"هر چه ما دادیم دیدیم این زمان","این جهان پرده‌ست و عینست آن جهان","سرانجام هر آنچه ما در این دنیا داده‌ایم و تجربه کرده‌ایم، باید بدانیم که این دنیا تنها یک پرده است و حقیقت اصلی در جهان دیگری وجود دارد."],[932,"روز کشتن روز پنهان کردنست","تخم در خاکی پریشان کردنست","روز کشتن، روزی است که در آن، تخم را در خاک پنهان می‌کنند و به نوعی، این عمل باعث می‌شود تا آن تخم در حالتی نامنظم کاشته شود."],[932,"وقت بدرودن گه منجل زدن","روز پاداش آمد و پیدا شدن","زمانی که روز جدایی فرارسید، زمان جابه‌جا کردن، فرصت پاداش نیز رسید و این حقیقت آشکار شد."],[933,"بشنو اکنون داد مهمان جدید","من همی دیدم که او خواهد رسید","من اکنون صدای مهمان جدیدی را می‌شنوم که به زودی خواهد آمد."],[933,"من شنوده بودم از وامش خبر","بسته بهر او دو سه پاره گهر","من از وام او خبری شنیده بودم و به همین دلیل برای او دو یا سه دانه جواهر آماده کرده‌ام."],[933,"که وفای وام او هستند و بیش","تا که ضیفم را نگردد سینه ریش","وفای به وام او بیشتر از آن است که در دل من جایی برای ناراحتی باقی بگذارد، زیرا من در حال حاضر در شرایط سخت و ضعیفی قرار دارم."],[933,"وام دارد از ذهب او نه هزار","وام را از بعض این گو بر گزار","این شعر به این معناست که شخصی به یاد قرض‌هایی که به او داده شده، مسئولیت بازپرداخت آنها را با تمام وجود حس می‌کند و حتی یک بخش از این قرض را هم باید به درستی پرداخت کند. در واقع، او اشاره به این دارد که حتی اگر قرضش به مقدار زیادی باشد، باید به فکر آن باشد و هر چه را که به عهده خودش است، به‌خوبی انجام دهد."],[933,"فضله ماند زین بسی گو خرج کن","در دعایی گو مرا هم درج کن","از این باقی‌مانده چیزی به‌جا نمانده که می‌گوید در دعا خرج کن و نام مرا هم در آن ذکر کن."],[933,"خواستم تا آن به دست خود دهم","در فلان دفتر نوشته‌ست این قسم","خواستم که آنچه را به دوست بدهکارم، با دستان خودم به او برسانم که در فلان دفتر (ثبت شده است) این موضوع."],[933,"خود اجل مهلت ندادم تا که من","خفیه بسپارم بدو در عدن","من نتوانستم فرصتی پیدا کنم تا آنچه را در دل داشتم به آن شخص در بهشت (عدن) بسپارم، زیرا خود مرگ (اجل) به من مهلت نداد."],[933,"لعل و یاقوتست بهر وام او","در خنوری و نبشته نام او","برای وام او لعل و یاقوت است و در خنوری (خزانه) به نام او نوشته شده است."],[933,"در فلان طاقیش مدفون کرده‌ام","من غم آن یار پیشین خورده‌ام","من در فلان مکان دفن شده‌ام و به خاطر اندوه آن یار قدیمی، رنج می‌برم."],[933,"قیمت آن را نداند جز ملوک","فاجتهد بالبیع ان لا یخدعوک","فقط پادشاهان ارزش واقعی آن را می‌دانند، از این رو در خرید و فروش تلاش کن که فریب نخوری."],[933,"در بیوع آن کن تو از خوف غرار","که رسول آموخت سه روز اختیار","در معامله‌ها، از ترس فریب باید جانب احتیاط را بگیری و به یاد داشته باش که پیامبر به تجار آموخت که تا سه روز حق دارند کالا را پس بگیرند."],[933,"از کساد آن مترس و در میفت","که رواج آن نخواهد هیچ خفت","نترس از کم‌فروشی و کساد فروش، زیرا رواج و رونق آن هرگز نمی‌تواند تو را خوار و ذلیل کند."],[933,"وارثانم را سلام من بگو","وین وصیت را بگو هم مو به مو","به وارثانم سلام برسان و وصیت مرا به طور دقیق بگویید."],[933,"تا ز بسیاری آن زر نشکهند","بی‌گرانی پیش آن مهمان نهند","بسیاری از آن طلا را بدون زحمت و نگرانی در مقابل آن مهمان قرار می‌دهند."],[933,"ور بگوید او نخواهم این فره","گو بگیر و هر که را خواهی بده","اگر او بگوید که من این نعمت را نمی‌خواهم، تو برو و آن را بگیر و به هر کسی که دوست داری بده."],[933,"زانچ دادم باز نستانم نقیر","سوی پستان باز ناید هیچ شیر","از آن‌جا که من چیزی را داده‌ام، آن را پس نمی‌گیرم. مانند اینکه اگر بچه‌ای شیر بخورد، دیگر نمی‌تواند از پستان شیر برگرداند."],[933,"گشته باشد هم‌چو سگ قی را اکول","مسترد نحله بر قول رسول","اگر کسی مانند سگ از نعمت‌های الهی دور افتد و آنچه را که به او داده شده است، پس بزند، نباید بر قول پیامبر (رسول) شک کند."],[933,"ور ببندد در نباید آن زرش","تا بریزند آن عطا را بر درش","اگر در از ورود آن طلا بسته شود، نباید آن طلا را که به او داده‌اند، دور بریزد و بر درش بریزند."],[933,"هر که آنجا بگذرد زر می‌برد","نیست هدیه مخلصان را مسترد","هر کسی که از آن مکان بگذرد، طلا و زر می‌برد و افرادی که با نیت خالصانه چیزی را هدیه می‌دهند، چیزی از آن نمی‌گیرند و باید آن را همان‌جا بگذارند."],[933,"بهر او بنهاده‌ام آن از دو سال","کرده‌ام من نذرها با ذوالجلال","من به خاطر خدا و به خاطر ذوالجلال، آنچه را که در دو سال گذشته نذر کرده‌ام، برای او گذاشته‌ام."],[933,"ور روا دارند چیزی زان ستد","بیست چندان خو زیانشان اوفتد","اگر اجازه دهند که چیزی از آن مال بردارند، زیانی به اندازه بیست برابر بر آنان وارد می‌شود."],[933,"گر روانم را پژولانند زود","صد در محنت بریشان بر گشود","اگر روح من را به زودی آزار دهند، صدها مشکل و درد برایشان گشوده خواهد شد."],[933,"از خدا اومید دارم من لبق","که رساند حق را در مستحق","من به خدا امیدوارم که او حق را به مستحق رساند."],[933,"دو قضیه دیگر او را شرح داد","لب به ذکر آن نخواهم بر گشاد","دو موضوع دیگر او (مولانا) را توضیح داد، اما من تمایل ندارم که درباره آن‌ها صحبت کنم."],[933,"تا بماند دو قضیه سر و راز","هم نگردد مثنوی چندین دراز","بر اساس دو موضوع یا داستانی که گفته شد، بگذارید راز و سرّ آن‌ها پنهان بماند تا مثنوی بسیار طولانی نشود."],[933,"برجهید از خواب انگشتک‌زنان","گه غزل‌گویان و گه نوحه‌کنان","از خواب بیدار شد و در حالتی شاداب و سرزنده به کسانی که غزل می‌خوانند و کسانی که نوحه می‌زنند اشاره می‌کند."],[933,"گفت مهمان در چه سوداهاستی","پای‌مردا مست و خوش بر خاستی","مهمان از خواب می‌پرسد که تو در چه فکر و خیالی هستی که این‌گونه شاد و سرمست از جا برخاسته‌ای؟"],[933,"تا چه دیدی خواب دوش ای بوالعلا","که نمی‌گنجی تو در شهر و فلا","ای بوالعلا، تو در خواب چه چیزی دیدی که نمی‌توانی در این شهر و زندگی روزمره جا بگیری و بمانى؟"],[933,"خواب دیده پیل تو هندوستان","که رمیدستی ز حلقه دوستان","در خواب دیده‌ای که فیل بزرگی از هندوستان آمده است، و تو از میان دایره دوستانت گریخته‌ای و دور شده‌ای."],[933,"گفت سوداناک خوابی دیده‌ام","در دل خود آفتابی دیده‌ام","سوداناک (بزرگ و محترم) می‌گوید که در دل خود، رویایی دیده که مثل آفتاب روشنی و روشنی‌بخش بوده است."],[933,"خواب دیدم خواجه بیدار را","آن سپرده جان پی دیدار را","در خواب خواجه‌ای را دیدم که بیدار است و جانش به خاطر دیدار محبوبش در اضطراب و شوق است."],[933,"خواب دیدم خواجه معطی المنی","واحد کالالف ان امر عنی","در خواب دیدم که خواجه، بخشنده و صاحب آرزوها، مانند هزاران نفر (مردم) برای من امری را بیان کرد."],[933,"مست و بی‌خود این چنین بر می‌شمرد","تا که مستی عقل و هوشش را ببرد","شخص مست و بی‌خود، با حالتی شوریده و ناموزون، مسائل را بیان می‌کند و در این حالت، فقدان عقل و هوش او باعث می‌شود که نتواند درست فکر کند."],[933,"در میان خانه افتاد او دراز","خلق انبه گرد او آمد فراز","او دراز و بی‌هوش به زمین افتاده و دورش به قدری جمعیت است که تو گویی افرادی با قامت بلند دورش را احاطه کرده‌اند."],[933,"با خود آمد گفت ای بحر خوشی","ای نهاده هوش‌ها در بیهشی","این بیت به گفتگو یا تفکر درونی می‌پردازد که در آن شخص به خود می‌گوید ای دریای شادی، ای منبع احساسات و عقل که در حالت گیجی و حواس‌پرتی مرا سرشار از خوشی کرده‌ای."],[933,"خواب در بنهاده‌ای بیداریی","بسته‌ای در بی‌دلی دلداریی","در خواب، حالت عمیق و خوشی را تجربه کرده‌ای و بیداری، در تو به نوعی محدود و مختل شده است. در این حال، در بی‌حوصلگی و ناامیدی، دلی را تسکین داده‌ای."],[933,"توانگری پنهان کنی در ذل فقر","طوق دولت بسته اندر غل فقر","دولت و ثروت را می‌توان در دل فقر پنهان کرد، مانند طوقی که بر گردن انسان است در حالی که در زنجیر فقر گرفتار است. در واقع، ممکن است کسی در ظاهری فقیر به نظر برسد، اما در باطن دارای ثروت و توانگری باشد."],[933,"ضد اندر ضد پنهان مندرج","آتش اندر آب سوزان مندرج","صفات متضاد در هم پنهان هستند؛ مانند آتش که در آب مخفی شده و گرمی خود را درون آن دارد."],[933,"روضه اندر آتش نمرود درج","دخل‌ها رویان شده از بذل و خرج","آتش نمرود در روضه (باغ) نشان‌دهنده عذاب و عذاب‌دهنگی است که با وجود هزینه‌ها و بخشش‌ها در زندگی، زیبایی و خیر وجود ندارد. به عبارتی دیگر، هزینه کردن و بخشش‌ها نمی‌تواند جبران‌کننده عذاب‌ها و رنج‌ها باشد."],[933,"تا بگفته مصطفی شاه نجاح","السماح یا اولی النعمی رباح","مولانا به نقل از پیامبر (مصطفی) می‌فرماید که بخشش و عطا از نعمت‌های بزرگ و در واقع، کلید موفقیت و خوشبختی است. این درسی از آموزه‌های اسلامی است که نشان می‌دهد بخشندگی در زندگی انسان را سعادتمند می‌سازد."],[933,"ما نقص مال من الصدقات قط","انما الخیرات نعم المرتبط","صدقات و کمک‌های مالی هیچ کاهشی در مال فرد ایجاد نمی‌کند، بلکه در واقع، کارهای نیک، همانند پیوندی است که به برکت و خیر می‌انجامد."],[933,"جوشش و افزونی زر در زکات","عصمت از فحشا و منکر در صلات","زکات و صدقه دادن باعث رشد و افزایش دارایی می‌شود و این عمل به دوری از فحشا و کارهای ناپسند در نماز و عبادت کمک می‌کند."],[933,"آن زکاتت کیسه‌ات را پاسبان","وآن صلاتت هم ز گرگانت شبان","زکات (مالی که به فقرای نیازمند داده می‌شود) باعث حفاظت از مال تو می‌شود و نمازهایت نیز تو را از خطرات و آسیب‌ها مانند شبانی برای گوسفندانت نگه می‌دارند."],[933,"میوه شیرین نهان در شاخ و برگ","زندگی جاودان در زیر مرگ","زندگی در ظاهر می‌تواند پر از پیچیدگی و مرگ باشد، اما در عمق آن، لذت و خیر معنوی شگفت‌انگیزی وجود دارد که مانند میوه‌ای شیرین در شاخ و برگ درختان پنهان است. زندگی جاودانه به معنای تجربه‌ای عمیق و روحانی است که فراتر از مرگ به دست می‌آید."],[933,"زبل گشته قوت خاک از شیوه‌ای","زان غذا زاده زمین را میوه‌ای","این بیت می‌گوید که خاک به خاطر یک شیوه خاص و به‌طور معجزه‌آسا، به قوت و نیرویی تبدیل شده که از آن غذا تولید می‌کند و این غذا به شکل میوه‌هایی از زمین رشد می‌کند. این اشاره به قدرت طبیعت و چرخه زندگی دارد."],[933,"درعدم پنهان شده موجودیی","در سرشت ساجدی مسجودیی","در حالت عدم، موجودیتی وجود دارد که در ذات خود سجودکننده و سجده‌شونده است."],[933,"آهن و سنگ از برونش مظلمی","اندرون نوری و شمع عالمی","در ظاهر، آهن و سنگ به نظر می‌رسند که تاریک و بی‌نورند، اما در درون آنها نوری وجود دارد که جهان را روشن می‌کند. این بیان به عمق و باطن وجود انسان یا روح اشاره دارد که ممکن است در ظاهر سخت و تاریک به نظر برسد، اما در باطن دارای روشنایی و معنویت است."],[933,"درج در خوفی هزاران آمنی","در سواد چشم چندان روشنی","در دل این انسان، ترس و اندوه بسیار وجود دارد، در حالی که در چشمانش نور و روشنی زیادی دیده می‌شود."],[933,"اندرون گاو تن شه‌زاده‌ای","گنج در ویرانه‌ای بنهاده‌ای","درون گاوی، گنجی از یک شاهزاده‌ی جوان پنهان شده که در یک ویرانه قرار دارد."],[933,"تا خری پیری گریزد زان نفیس","گاو بیند شاه نی یعنی بلیس","تا زمانی که الاغ پیر از آن گاو نفیس فرار کند، شاه (یعنی ابلیس) را خواهد دید."],[934,"بود شاهی شاه را بد سه پسر","هر سه صاحب‌فطنت و صاحب‌نظر","شاهی وجود داشت که سه پسر داشت و هر سه از نظر دانایی و فهم بسیار برجسته بودند."],[934,"هر یکی از دیگری استوده‌تر","در سخا و در وغا و کر و فر","هر یک از فرزندان پادشاه در سخاوت، شجاعت، و بزرگی بهتر و برجسته‌تر از دیگری است."],[934,"پیش شه شه‌زادگان استاده جمع","قرة العینان شه هم‌چون سه شمع","شهزادگان در برابر پادشاه ایستاده‌اند و او همانند سه شمع درخشانی است که نور افشانی می‌کند. قرة العینان به معنی «چشم و دل‌پسند» است و در اینجا به زیبا رویان یا شخصیت‌های محبوب اشاره دارد."],[934,"از ره پنهان ز عینین پسر","می‌کشید آبی نخیل آن پدر","پسر عینین به طور مخفیانه از چشمه پدرش آبی می‌برد که به درختان نخل او مربوط می‌شود."],[934,"تا ز فرزند آب این چشمه شتاب","می‌رود سوی ریاض مام و باب","آب چشمه فرزند به سرعت به سوی باغ پدر و مادر می‌رود."],[934,"تازه می‌باشد ریاض والدین","گشته جاری عینشان زین هر دو عین","ریاض والدین به معنای باغ شادی و سرسبزی آن‌ها هنوز تازه و سرسبز است و چشمه زندگی آن‌ها همچنان در حال جوشیدن است، یعنی این دو چشمه به همراه یکدیگر جاری هستند."],[934,"چون شود چشمه ز بیماری علیل","خشک گردد برگ و شاخ آن نخیل","اگر چشمه آب به خاطر بیماری کسی که ضعیف و ناتوان است، خشک شود، درخت نخل نیز برگ و شاخه‌هایش می‌خشکد."],[934,"خشکی نخلش همی‌گوید پدید","که ز فرزندان شجر نم می‌کشید","خشکی نخل به این معنی است که اگر فرزندان درخت، یعنی میوه‌ها و نسل‌های بعدی، بارور نشوند، درخت اصلی نیز نمی‌تواند آب و مایه حیات خود را از زمین بگیرد و زنده بماند."],[934,"ای بسا کاریز پنهان هم‌چنین","متصل با جانتان یا غافلین","در درون شما بسیاری از منابع و ویژگی‌های پنهان وجود دارد که به شما مرتبط است و بسیاری از مردم از آن‌ها غافلند."],[934,"ای کشیده ز آسمان و از زمین","مایه‌ها تا گشته جسم تو سمین","ای کسی که از آسمان و زمین مواد و منابع زندگی‌ات را گرفته‌ای، حالا بدن تو به وزن و سنگینی درآمده است."],[934,"عاریه‌ست این کم همی‌باید فشارد","کانچ بگرفتی همی‌باید گزارد","این جسم که به آن وابسته‌ای، در واقع متعلق به تو نیست و باید آن را رها کنی؛ زیرا هرچه به دست آورده‌ای، در حقیقت باید آن را به‌جای خود بگذاری و ترک کنی."],[934,"جز نفخت کان ز وهاب آمدست","روح را باش آن دگرها بیهدست","روح آدمی نتیجه نفحه‌ای الهی است که از جانب خدای بخشنده به او دمیده شده و غیر از این روح، دیگر چیزها بی‌فایده و کم‌ارزش هستند."],[934,"بیهده نسبت به جان می‌گویمش","نی بنسبت با صنیع محکمش","من می‌گویم نسبت به جان (روح) که بی‌فایده است، نه به نسبت به کارهای محکم و استوارش."],[935,"حبذا کاریز اصل چیزها","فارغت آرد ازین کاریزها","خوشا کاریز، یعنی منبع آب زلال و اصلی، که انسان را از این منابع غیرمعتبر و بی‌وفا بی‌نیاز می‌کند."],[935,"تو ز صد ینبوع شربت می‌کشی","هرچه زان صد کم شود کاهد خوشی","تو از صد منبع مختلف نوشیدنی می‌نوشی، اما هر چه از آن صد کم شود، خوشحالی‌ات کم‌تر می‌شود."],[935,"چون بجوشید از درون چشمه سنی","ز استراق چشمه‌ها گردی غنی","وقتی آب زلال و ابدی از درون تو جوشید و به آن چشمه‌های ناچیز و بی‌وفا احتیاج نداشتی، به غنی و بی‌نیاز تبدیل خواهی شد."],[935,"قرةالعینت چو ز آب و گل بود","راتبه این قره درد دل بود","اگر دیده تو از آب و گل (مادیات) باشد، درجه و مقام تو بر اساس همان مادیات است و درد دل (عواطف و احساسات) تو بیشتر خواهد بود."],[935,"قلعه را چون آب آید از برون","در زمان امن باشد بر فزون","وقتی که آب از خارج به قلعه وارد می‌شود، در زمان امنیت و آرامش پر می‌شود و در نتیجه، قلعه قوی‌تر و در دسترس‌تر خواهد بود."],[935,"چونک دشمن گرد آن حلقه کند","تا که اندر خونشان غرقه کند","وقتی که دشمن دور حلقه می‌زند تا آن‌ها را در خون خود غرق کند، خطر بسیار زیادی آن‌ها را تهدید می‌کند."],[935,"آب بیرون را ببرند آن سپاه","تا نباشد قلعه را زانها پناه","اگر آب (منابع) بیرونی را از قلعه ببرند، این قلعه دیگر پناهگاهی نخواهد داشت و در خطر خواهد افتاد."],[935,"آن زمان یک چاه شوری از درون","به ز صد جیحون شیرین از برون","انسان در زمانی که به دنبال چشمه‌های آب‌های ظاهری و بی‌دوام است، از درون خود نیز می‌تواند چاهی از شور و تلخی را تجربه کند که به مراتب بدتر از هر جوی شیرین و خوشایند بیرونی است. بدین معنا، اتصال به منابع درونی و دایمی مهم‌تر از اتکاء به منابع زودگذر خارجی است."],[935,"قاطع الاسباب و لشکرهای مرگ","هم‌چو دی آید به قطع شاخ و برگ","مرگ، که سبب‌های زندگی را از بین می‌برد و مانند یک دیو به سراغ انسان می‌آید تا شاخ و برگ‌های زندگی را قطع کند، ناگزیر و اجتناب‌ناپذیر است."],[935,"در جهان نبود مددشان از بهار","جز مگر در جان بهار روی یار","در این دنیا، یاری و کمک واقعی وجود ندارد جز آن‌که در جان کسی که بهاری و سرشار از حیات معنوی است، روی یار و محبوبش را ببیند."],[935,"زان لقب شد خاک را دار الغرور","کو کشد پا را سپس یوم العبور","از آن‌جا که دنیا را «دار الغرور» یعنی مکان فریب می‌نامند، باعث می‌شود که انسان‌ها را از حقیقت بازدارد و موجب می‌شود تا در روز عبور، یعنی روز قیامت، پایش را لغزاند."],[935,"پیش از آن بر راست و بر چپ می‌دوید","که بچینم درد تو چیزی نچید","انسان قبل از این که به دنبال درمان دردش برود، به راست و چپ می‌دود و از آنچه که او را در تلاش برای پیدا کردن آرامش یا درمان کمک می‌کند، فایده‌ای نمی‌برد. در واقع، او چیزی از این کوشش‌ها به دست نمی‌آورد."],[935,"او بگفتی مر ترا وقت غمان","دور از تو رنج و ده که در میان","او می‌گوید در زمان غم و ناراحتی، دوری از تو درد و رنج را به میان می‌آورد."],[935,"چون سپاه رنج آمد بست دم","خود نمی‌گوید ترا من دیده‌ام","وقتی که سپاه رنج و مشکلات بر آدمی حمله‌ور می‌شود، او دیگر نمی‌تواند به کسی بگوید که تو را دیده‌ام و با تو در ارتباط هستم. این نشان از تنهایی و بی‌کسی در مواجهه با سختی‌ها دارد."],[935,"حق پی شیطان بدین سان زد مثل","که ترا در رزم آرد با حیل","حق به شیطان چنین اجازه داد که تو را در میدان جنگ با ترفندها و نقشه‌هایش به محنت و تنگنا بیندازد."],[935,"که ترا یاری دهم من با توم","در خطرها پیش تو من می‌دوم","من در سختی‌ها و نیز در شرایط خطر، آماده‌ام که به تو کمک کنم و کنارت باشم."],[935,"اسپرت باشم گه تیر خدنگ","مخلص تو باشم اندر وقت تنگ","من در هنگامی که به مشکلات و خطرات دچار شوم، آماده‌ام که مانند تیر تند و سریع به کمک تو بیایم و در جهان پرتنش، بخشی از وجودم را به یاری تو اختصاص دهم."],[935,"جان فدای تو کنم در انتعاش","رستمی شیری هلا مردانه باش","من جانم را برای تو فدای می‌کنم و شجاعت و قدرت رستم، پهلوان بزرگ ایران، را در خود حس می‌کنم. هلا، مردانه رفتار کن و شجاع باش."],[935,"سوی کفرش آورد زین عشوه‌ها","آن جوال خدعه و مکر و دها","عشق و جذبه‌های فریبنده باعث شده‌اند که او به سوی کفر برود، و این فریب‌ها مانند یک چهره فریبنده و مکار عمل کرده‌اند."],[935,"چون قدم بنهاد در خندق فتاد","او به قاهاقاه خنده لب گشاد","وقتی که او وارد خندق شد، به شدت به خنده افتاد و دهانش را باز کرد."],[935,"هی بیا من طمعها دارم ز تو","گویدش رو رو که بیزارم ز تو","این بیت بیانگر این است که شخصی به محبوب خود می‌گوید که من به خوبی‌ها و الطاف تو امیدوارم، اما تو از من بیزاری می‌جویی و دوری می‌کنی. یعنی با وجود امید و خواسته‌ای که از تو دارم، می‌دانم که تو به من تمایلی نداری."],[935,"تو نترسیدی ز عدل کردگار","من همی‌ترسم دو دست از من بدار","تو از عدالت خداوند نترسیدی، اما من می‌ترسم که دو دستم را (از رحمت) بگیرد."],[935,"گفت حق خود او جدا شد از بهی","تو بدین تزویرها هم کی رهی","خدا می‌گوید که حق (حقایق) او از محبت و زیبایی جدا شد. تو با این نیرنگ‌ها و فریب‌ها هیچ وقت به حقیقی دست نخواهی یافت."],[935,"فاعل و مفعول در روز شمار","روسیاهند و حریف سنگسار","افراد و کسانی که در روز جزا و قیامت به ننگ و عذاب گرفتار خواهند آمد، به آن اندازه سیاه‌چهره و بی‌عظمت هستند که حتی همپایان و دشمنانشان را نیز سنگسار می‌کنند."],[935,"ره‌زده و ره‌زن یقین در حکم و داد","در چه بعدند و در بئس المهاد","رهزنی و راهزنی که هر دو به سرنوشت و قضا و قدر اشاره دارند، در چه حال و روزی هستند و در چه وضعیت بدی قرار دارند."],[935,"گول را و غول را کو را فریفت","از خلاص و فوز می‌باید شکیفت","گول و غول، نماد فریبکاران و تهدیدات هستند که انسان‌ها را از رهایی و موفقیت دور می‌کنند. برای نجات و دستیابی به موفقیت، باید از آن‌ها دوری کرد و از مسایل و فریب‌های دنیوی گذشت."],[935,"هم خر و خرگیر اینجا در گلند","غافلند این‌جا و آن‌جا آفلند","در اینجا، هم کسانی که به دنبال مادیات (خر) هستند و هم کسانی که به آنها وابسته‌اند (خرگیر) در گرفتاری و سردرگمی به سر می‌برند و از حقیقت زندگی غافلند. آنها در این دنیا و آن دنیا گرفتار آمدند و از واقعیت دورند."],[935,"جز کسانی را که وا گردند از آن","در بهار فضل آیند از خزان","جز افرادی که از در رحمت الهی فاصله می‌گیرند، دیگران در بهار نعمت‌های الهی به سر می‌برند و از زوال و سختی‌های زمستان رهایی می‌یابند."],[935,"توبه آرند و خدا توبه‌پذیر","امر او گیرند و او نعم الامیر","توبه‌کنندگان به سوی خدا برمی‌گردند و خداوند نیز توبه آنان را می‌پذیرد؛ بنابراین، فرمان او را بپذیرید که او بهترین فرمانده و سرپرست است."],[935,"چون بر آرند از پشیمانی حنین","عرش لرزد از انین المذنبین","زمانی که گناهکاران از پشیمانی خود صدای بلند و زاری کنند، عرش خدا از صدای آنان به لرزه درمی‌آید."],[935,"آن‌چنان لرزد که مادر بر ولد","دستشان گیرد به بالا می‌کشد","به‌قدری در اینجا ناله و زاری و پشیمانی وجود دارد که مثل یک مادر، کسی که فرزندش را به دست گرفته، او را به سمت بالا می‌کشد و به او کمک می‌کند تا به حالت بهتری برسد."],[935,"کای خداتان وا خریده از غرور","نک ریاض فضل و نک رب غفور","ای خدا، شما را از خودخواهی و فریب دنیا نجات ده، نه از برتری‌های علمی و فضیلت‌ها و نه از بخشش‌های خداوند غافل."],[935,"بعد ازینتان برگ و رزق جاودان","از هوای حق بود نه از ناودان","بعد از این، نعمت و روزی جاودان تنها از هوای حق و اراده الهی خواهد بود، نه از چاه‌ها و منابع مادی."],[935,"چونک دریا بر وسایط رشک کرد","تشنه چون ماهی به ترک مشک کرد","وقتی دریا به وسایط (منابع آب) حسادت ورزید، تشنه مانند ماهی از مشک (پانویس: ظرفی که برای نگهداری آب و مایعات استفاده می‌شود) روی برگرداند."],[936,"عزم ره کردند آن هر سه پسر","سوی املاک پدر رسم سفر","آن سه پسر تصمیم گرفتند که به سمت زمین‌های پدرشان حرکت کنند و سفر را آغاز کنند."],[936,"در طواف شهرها و قلعه‌هاش","از پی تدبیر دیوان و معاش","آنها در سفر به شهرها و دژهای پدرشان، برای مدیریت دیوان و تأمین معاش مردم، تلاش می‌کنند."],[936,"دست‌بوس شاه کردند و وداع","پس بدیشان گفت آن شاه مطاع","آن‌ها به احترام شاه دستش را بوسیدند و با او وداع کردند. سپس شاه با محبت به آن‌ها گفت."],[936,"هر کجاتان دل کشد عازم شوید","فی امان الله دست افشان روید","هرجایی که دلتان می‌کشد بروید و از آنجا به سلامت بگذرید و با شادابی و شادی برقصید."],[936,"غیر آن یک قلعه نامش هش‌ربا","تنگ آرد بر کله‌داران قبا","غیر از آن قلعه‌ای که نامش هشربا است، بر سر سرداران، دشواری و سختی می‌آورد."],[936,"الله الله زان دز ذات الصور","دور باشید و بترسید از خطر","ای مخلوقات، از خداوند با نام «ذات الصور» (یعنی وجودی که تصاویر و اشکال را ایجاد می‌کند) دوری کنید و از خطرات او بترسید."],[936,"رو و پشت برجهاش و سقف و پست","جمله تمثال و نگار و صورتست","همه‌چیز در اینجا تصویر و نماد است؛ چه روی برج‌ها، چه پشت آن‌ها و چه سقف و زمین، همه به شکل مجسمه‌ها و تصاویر زیبا هستند."],[936,"هم‌چو آن حجره زلیخا پر صور","تا کند یوسف به ناکامش نظر","همچون آن اتاق زلیخا (که در آن یوسف) پر از تصاویر و زیبایی‌هاست، تا یوسف بتواند به ناکام (عشق ناکامش) چشم انداز کند."],[936,"چونکه یوسف سوی او می‌ننگرید","خانه را پر نقش خود کرد آن مکید","وقتی یوسف به آن زن نگاه نمی‌کند، خانه را پر از تصویر و جلوه‌های زیبایی می‌کند که خاص اوست."],[936,"تا به هر سو که نگرد آن خوش‌عذار","روی او را بیند او بی‌اختیار","هرجا که فرد زیبا و دل‌انگیز (او) نگاه کند، آن کس که به او می‌نگرد، بدون اراده و اختیار شیفته و خیره‌اش می‌شود؛ زیبایی او چنان است که همه را جذب می‌کند."],[936,"بهر دیده‌روشنان یزدان فرد","شش جهت را مظهر آیات کرد","برای بینندگان روشن و بصیر، خداوند شش سمت را مظهر نشانه‌های خود قرار داده است."],[936,"تا به هر حیوان و نامی که نگرند","از ریاض حسن ربانی چرند","این بیت اشاره به این دارد که هر موجودی و هر نامی که در دنیای طبیعت و زیبایی‌های خداوند (ریاض حسن ربانی) دیده می‌شود، در حقیقت بازتابی از زیبایی و حقیقت الهی است. بدون شک، همه این جلوه‌ها تأثیری از صفات خداوند را نشان می‌دهند."],[936,"بهر این فرمود با آن اسپه او","حیث ولیتم فثم وجهه","به خاطر همین (منظور همان زیبایی و کمال الهی) او با آن اسب (شکوه و عظمت را) بیان کرد، پس مقام و رویکرد او در آنجا (بر اساس زیبایی) قرار دارد."],[936,"از قدح‌ گر در عطش آبی خورید","در درون آب حق را ناظرید","اگر در حال عطش، از جامی آب بنوشید، در دل آن آب، حقیقت را ببینید."],[936,"آنکه عاشق نیست او در آب در","صورت خود بیند ای صاحب‌بصر","کسی که عاشق نیست، در آب فقط تصویر خودش را می‌بیند، ای صاحب بینش و بصیرت."],[936,"صورت عاشق چو فانی شد درو","پس در آب اکنون کرا بیند بگو","عاشق وقتی که در عشق خود محو و نابود می‌شود، دیگر نمی‌تواند به آنچه در آب (یعنی صورت خود یا جهان مادی) می‌بیند، توجه کند. پس اکنون بگو که چه کسی می‌تواند او را در آب ببیند."],[936,"حسن حق بینند اندر روی حور","هم‌چو مه در آب از صنع غیور","حسن، زیبایی حق را در چهره حوریان می‌بینند، مانند ماهی که در آب از اثر طبیعت زیبا و دلپذیر است."],[936,"غیرتش بر عاشقی و صادقی‌ست","غیرتش بر دیو و بر استور نیست","غیرت او بر عشق و راستی است؛ غیرت او بر دیوصفتان و آدم‌های نادان نیست."],[936,"دیو اگر عاشق شود هم گوی برد","جبرئیلی گشت و آن دیوی بمرد","دیو هم اگر عاشق شود، برنده و پیروز گشته‌است و دیوی و شرارت از او جدا گشته و همچون جبرییل، پاک می‌شود."],[936,"اسلم الشیطان آنجا شد پدید","که یزیدی شد ز فضلش بایزید","شیطانی در آنجا ظهور کرد که به لطف او، یزید به مقام بایزید (بایزید بسطامی، عارف و زاهد مشهور) رسید."],[936,"این سخن پایان ندارد ای گروه","هین نگه دارید زان قلعه وجوه","این حرف‌ها پایانی ندارد، ای گروه! حواستان باشد که به آن قلعه چه چیزهایی می‌رسد و چه حالاتی را در بر می‌گیرد."],[936,"هین مبادا که هوستان ره زند","که فتید اندر شقاوت تا ابد","ای گروه، مواظب باشید که حواس‌تان پرت نشود و به دام شقاوت نیفتید، زیرا در این صورت به بدبختی و شقاوتی ابدی گرفتار خواهید شد."],[936,"از خطر پرهیز آمد مفترض","بشنوید از من حدیث بی‌غرض","از خطر دور شدن، واجب است؛ از من داستانی بشنوید که در آن هیچ گونه غرض و نیّتی وجود ندارد."],[936,"در فرج جویی خرد سر تیز به","از کمین‌گاه بلا پرهیز به","در جستجوی فرج و نجات، عقل و هوش تیزتر از دوری از دام بلا و خطر است."],[936,"گر نمی‌گفت این سخن را آن پدر","ور نمی‌فرمود زان قلعه حذر","اگر آن پدر این سخن را نمی‌گفت و از آن قلعه احتیاط نمی‌کرد، آنها نمی‌توانستند از خطر دور شوند."],[936,"خود بدان قلعه نمی‌شد خیلشان","خود نمی‌افتاد آن سو میلشان","خودشان نمی‌توانستند به آن قلعه بروند و میل و تمایلشان به آنجا نمی‌افتاد."],[936,"کان نبد معروف بس مهجور بود","از قلاع و از مناهج دور بود","این قلعه که نامش معروف است، به شدت فراموش شده و از مسیرها و روش‌های شناخته شده دور است."],[936,"چون بکرد آن منع دلشان زان مقال","در هوس افتاد و در کوی خیال","چون آن منع (که اشاره به نهی یا منع قرار دارد) از آن سخن (مقال) برطرف شد، دلشان به وسوسه افتاد و به خیال و آرزوهای خود روی آوردند."],[936,"رغبتی زین منع در دلشان برست","که بباید سر آن را باز جست","این بیت بیانگر این است که از زمانی که دل آن شه‌زادگان از منع و محدودیت‌ها رنج می‌برد، در دلشان اشتیاق و رغبت شدیدی به دانستن دلیل این ممنوعیت به وجود آمده است. آن‌ها نیاز دارند که برای رفع این کنجکاوی و اشتیاق، حقیقت را کشف کنند."],[936,"کیست کز ممنوع گردد ممتنع","چونک الانسان حریص ما منع","کیست که از چیزی که ممنوع شده، باز بماند؟ زیرا انسان به طور طبیعی نسبت به آنچه که منع شده، بسیار مشتاق است."],[936,"نهی بر اهل تقی تبغیض شد","نهی بر اهل هوا تحریض شد","نهی کردن از «تقی» (پرهیزکاری) باعث ایجاد تبعیض و نابرابری شد، ولی نهی کردن از «هوا» (هوس و تمایلات نفسانی) به سمت تحریک و تشویق گرایش‌ها و میل‌ها منجر شد."],[936,"پس ازین یغوی به قوما کثیر","هم ازین یهدی به قلبا خبیر","بعد از این، افرادی زیاد از اینجا به سوی مردم دیگر می‌روند و خدا قلب‌هایشان را آگاه می‌کند."],[936,"کی رمد از نی حمام آشنا","بل رمد زان نی حمامات هوا","نمی‌توان از خبری آشنا یا زیبا جدا شد، بلکه باید از آن خبرها به دور بود تا بتوان به راحتی به موضوعات دیگر پرداخت."],[936,"پس بگفتندش که خدمت‌ها کنیم","بر سمعنا و اطعناها تنیم","آنها به شاه گفتند که ما باید به او خدمت کنیم و فرمان او را گوش دهیم و از او پیروی کنیم."],[936,"رو نگردانیم از فرمان تو","کفر باشد غفلت از احسان تو","اگر از فرمان تو روی بگردانیم، به معنای کفر و ناامیدی است و فراموش کردن نعمت‌ها و احسان‌های تو نیز جایز نیست."],[936,"لیک استثنا و تسبیح خدا","ز اعتماد خود بد از ایشان جدا","اما در مورد استثنا و تسبیح خدا، این جدایی از اعتماد به خودشان همچنین نادرست است."],[936,"ذکر استثنا و حزم ملتوی","گفته شد در ابتدای مثنوی","در ابتدای مثنوی، درباره موضوع استثنا و احتیاط صحبت شده است، که اینجا به آن اشاره می‌شود."],[936,"صد کتاب ار هست جز یک باب نیست","صد جهت را قصد جز محراب نیست","اگرچه صد کتاب و دانایی وجود دارد، اما در نهایت همه آن‌ها به یک موضوع واحد اشاره می‌کنند. به عبارت دیگر، تمام تلاش‌ها و نیت‌ها در زندگی به سوی خداوند و عبادت او متمرکز است."],[936,"این طرق را مخلصی یک خانه است","این هزاران سنبل از یک دانه است","تمامی این راه‌ها و روش‌ها به یک هدف واحد می‌رسند. هزاران زیبایی و نعمت در واقع از یک منبع و ریشه، مانند یک دانه سنبل، به وجود آمده‌اند."],[936,"گونه‌گونه خوردنی‌ها صد هزار","جمله یک چیزست اندر اعتبار","همه خوراکی‌ها و غذاها به ظاهر مختلف و متنوع‌اند، اما از نظر ارزش و اعتبار، در حقیقت همه به یک چیز وابسته‌اند و در نهایت هر یک به نوعی به یک ماهیت مشابه برمی‌گردند."],[936,"از یکی چون سیر گشتی تو تمام","سرد شد اندر دلت پنجه طعام","وقتی از یک چیز سیر شدی، تمام ذائقه‌ات نسبت به آن غذا سرد می‌شود و دیگر apetیت و تمایل به آن احساس نمی‌کنی."],[936,"در مجاعت پس تو احول دیده‌ای","که یکی را صد هزاران دیده‌ای","در اینجا گفته می‌شود که در جمعیت، شخصی که در حال تماشا است (احول) به قدری مشغول دیدن و توجه به دیگران است که حس می‌کند هر یک از آن‌ها مانند صدها نفر دیده می‌شوند. به عبارت دیگر، در یک جمع، افراد به همدیگر اثر می‌گذارند و توجه به هر کدام به شدت افزایش می‌یابد."],[936,"گفته بودیم از سقام آن کنیز","وز طبیبان و قصور فهم نیز","ما درباره بیماری آن کنیز و ناتوانی پزشکان و ضعف درک آن‌ها صحبت کرده بودیم."],[936,"کان طبیبان هم‌چو اسپ بی‌عذار","غافل و بی‌بهره بودند از سوار","طبیبان مثل اسب‌های بی‌زین و بی‌سوار بودند، یعنی غافل و بی‌توجه، و هیچ‌گونه دانشی درباره درمان نداشتند."],[936,"کامشان پر زخم از قرع لگام","سمشان مجروح از تحویل گام","خواسته‌های آنان به شدت آسیب دیده و زخم‌خورده‌اند، و پاهایشان نیز به خاطر فشار و تحویل‌های ناگوار مجروح شده است."],[936,"ناشده واقف که نک بر پشت ما","رایض و چستی‌ست استادی‌نما","کسی که در رفتار و قدرت خود چیزی نمی‌داند، بر ما سوار شده و به‌ظاهر مانند استادی عمل می‌کند ولی در واقع، حاکمی نیست که ما را بفهمد و حمایت کند."],[936,"نیست سرگردانی ما زین لگام","جز ز تصریف سوار دوست‌کام","سرگردانی ما به خاطر این لگام نیست، بلکه ناشی از نادانی یا تغییرات رفتار کسی است که به او وابسته‌ایم و ما را بر مرکب عشق سوار کرده است."],[936,"ما پی گل سوی بستان‌ها شده","گل نموده آن و آن خاری بده","ما به سوی باغ‌ها رفته‌ایم و مانند گلی در آنجا درخشیده‌ایم، اما باید از خاری که در این مسیر است کنار بیاییم."],[936,"هیچ‌شان این نی که گویند از خرد","بر گلوی ما که می‌کوبد لگد","این نی که به آن اشاره می‌شود، به نظر می‌رسد در اثر خردی و فشار بر ما به وجود آمده و در واقع با غم و رنجی که به ما وارد می‌کند، مانند لگدی است که به ما کوبیده می‌شود. این ابراز درد و غم، نشان‌دهنده سختی‌هایی است که از درون به ما تحمیل می‌شود."],[936,"آن طبیبان آن‌چنان بنده سبب","گشته‌اند از مکر یزدان محتجب","این طبیبان به خاطر اینکه به اسباب و علل ظاهری وابسته شده‌اند، از تدبیر و حکمت الهی که در پس این اسباب است، غافل و پنهان مانده‌اند."],[936,"گر ببندی در صطبلی گاو نر","باز یابی در مقام گاو خر","اگر در درخت صطبلی (صطبل، اصطبل) گاو نر را ببندی، باز هم به مقام و جایگاه گاو خر (بی‌ارزش‌تر) دست می‌یابی."],[936,"از خری باشد تغافل خفته‌وار","که نجویی تا کیست آن خفیه‌کار","بی‌خبر از زمان و مکان، مانند الاغی که در خواب است، از اوضاع پنهان غافل است و نمی‌داند که این پنهان‌کاری تا چه زمانی ادامه خواهد یافت."],[936,"خود نگفته این مبدل تا کی است","نیست پیدا او مگر افلاکی است","این شخص که خود را پنهان کرده، تا کی می‌تواند این‌گونه بماند؟ وجود او برای انسان‌ها مشخص نیست و تنها می‌توان او را از افلاک تشخیص داد."],[936,"تیر سوی راست پرانیده‌ای","سوی چپ رفته‌ست تیرت دیده‌ای","تیر تو به سمت راست پرتاب کرده‌ای، اما خود تیر به سمت چپ رفته و تو متوجه آن شده‌ای."],[936,"سوی آهویی به صیدی تاختی","خویش را تو صید خوکی ساختی","به سوی آهو (حیوانی زیبا و ظریف) می‌روی تا آن را بگیری، اما در واقع خودت را به شکار خوک (حیوانی کثیف و کم‌ارزش) تبدیل کرده‌ای."],[936,"در پی سودی دویده بهر کبس","نارسیده سود افتاده به حبس","در پی سود و منفعتی به دنبال هدفی دویده‌ای، اما به هدف مورد نظر نرسیده‌ای و این تلاش بی‌فایده به جای سود، تو را به محنت و گرفتاری دچار کرده است."],[936,"چاه‌ها کنده برای دیگران","خویش را دیده فتاده اندر آن","کسانی که برای دیگران چاه‌هایی کنده‌اند، خودشان در آن چاه‌ها افتاده‌اند و دچار مشکل شده‌اند."],[936,"در سبب چون بی‌مرادت کرد رب","پس چرا بدظن نگردی در سبب","اگر خداوند تو را از مقصود و خواسته‌ات دور کرده است، پس چرا به علل و اسباب بدگمان می‌شوی؟"],[936,"بس کسی از مکسبی خاقان شده","دیگری زان مکسبه عریان شده","بسیاری از افراد از طریق کسب و کار پادشاه (خاقان) به ثروت و مقام رسیده‌اند، در حالی که برخی دیگر به خاطر همان کسب و کار، فقیر و بی‌پناه مانده‌اند."],[936,"بس کس از عقد زنان قارون شده","بس کس از عقد زنان مدیون شده","خیلی‌ها به واسطه زنانی که مانند قارون ثروتمندند، به مقام و جایگاه بالا رسیده‌اند و خیلی‌ها نیز به خاطر زنانی که به آنها بی‌پولی و قرض دچار کرده‌اند، به مشکلات و بدبختی‌ها افتاده‌اند."],[936,"پس سبب گردان چو دم خر بود","تکیه بر وی کم کنی بهتر بود","اگر به دلیل کمبود توانایی یا اختلالی شبیه به دم خر به سراغ چیزی بروی، بهتر است که به آن چیز اتکا نکنی و از آن کمتر استفاده کنی."],[936,"ور سبب گیری نگیری هم دلیر","که بس آفت‌هاست پنهانش به زیر","اگر به اسباب توجه کردی، جدی مگیر و محکم به آنها وابسته مشو زیرا در زیر این کار بسیار آفت‌ها و زیان‌هاست."],[936,"سر استثناست این حزم و حذر","زانکه خر را بز نماید این قدر","حزم و احتیاط در این‌جا بی‌فایده و استثنائی است، زیرا حتی یک خر (حیوانی که معمولا کم‌خودآگاه و ساده است) می‌تواند به اندازه یک بز (حیوانی چالاک و باهوش) به نظر برسد."],[936,"آنک چشمش بست گرچه گربزست","ز احولی اندر دو چشمش خر بزست","هرکس چشمش را (به این حقیقت) ببندد، هرچند زرنگ باشد از دوبینی و کج‌بینی، خر را بز می‌بیند!"],[936,"چون مقلب حق بود ابصار را","که بگرداند دل و افکار را","زیرا گرداننده دیدگان و چشم‌ها حضرت حق است که دل و اندیشه‌ها را در اختیار دارد."],[936,"چاه را تو خانه‌ای بینی لطیف","دام را تو دانه‌ای بینی ظریف","تو چاه را مانند خانه‌ای زیبا می‌بینی و دام را همچون دانه‌ای ظریف و خوش‌ساخت تصور می‌کنی."],[936,"این تسفسط نیست تقلیب خداست","می‌نماید که حقیقت‌ها کجاست","اینکه برخی معتقدند واقعیت‌ها را انکار کرده‌اند، در حقیقت یک نوع فساد در تفکر است و باید بدانند که حقایق واقعی همچنان وجود دارند، حتی اگر ظاهر برخی امور به گونه‌ای دیگر به نظر برسد."],[936,"آنکه انکار حقایق می‌کند","جملگی او بر خیالی می‌تند","کسی که حقایق را انکار می‌کند، تمام وجودش به خیال و باطل وابسته است و بر اساس همان خیالات زندگی می‌کند."],[936,"او نمی‌گوید که حسبان خیال","هم خیالی باشدت چشمی به مال","او نمی‌گوید که حسابگری و اندازه‌گیری، خود نیز خیالی است و حتی چشمی به دارایی‌ها و ثروت‌ها دارد."],[937,"این سخن پایان ندارد آن فریق","بر گرفتند از پی آن دز طریق","این سخن ادامه دارد و پایان نمی‌یابد؛ آن گروه (پسران سلطان) به دنبال آنچه که دزدیده‌اند، رفتند و به راه خود ادامه دادند."],[937,"بر درخت گندم منهی زدند","از طویله مخلصان بیرون شدند","پسران سلطان به توصیه‌های پدرشان توجه نکردند و از راه درست منحرف شدند، به گونه‌ای که به درخت گندم (نماد برکت و خیر) آسیب زدند و از جمع مخلصان و درستکاران خارج شدند."],[937,"چون شدند از منع و نهیش گرم‌تر","سوی آن قلعه بر آوردند سر","چون از منع و نهی پدر بیشتر تشویق و حرص پیدا کردند، به سمت آن قلعه رفتند و شجاعانه سر خود را بالا کردند."],[937,"بر ستیز قول شاه مجتبی","تا به قلعه صبرسوز هش‌ربا","آن‌ها با وجود نصیحت‌ها و هشدارهای پدرشان، به سرکشی و مخالفت با فرمان شاه مجتبی ادامه دادند و به سوی قلعه‌ای که پر از رنج و عذاب است، رفتند."],[937,"آمدند از رغم عقل پندتوز","در شب تاریک بر گشته ز روز","آنها با وجود دانایی و پندهایی که شنیده بودند، در شب تاریکی که به بی‌راهه رفته بودند، به سوی مقصدی نادرست رفتند و از روشنایی روز برگشتند."],[937,"اندر آن قلعه خوش ذات الصور","پنج در در بحر و پنجی سوی بر","در آن قلعه‌ای که بسیار زیبا و جذاب است، پنج در به سمت دریا و پنج در به سمت دیگر وجود دارد."],[937,"پنج از آن چون حس به سوی رنگ و بو","پنج از آن چون حس باطن رازجو","پنج حس ظاهری انسان، مانند چشایی و بویایی، به سمت رنگ‌ها و عطرها می‌روند، و پنج حس باطنی، که به دنبال کشف رازها هستند، به سمت اسرار درونی هدایت می‌شوند."],[937,"زان هزاران صورت و نقش و نگار","می‌شدند از سو به سو خوش بی‌قرار","از بین هزاران شکل و تصویر، آنها بی‌قرار در جستجوی زیبایی‌ها و خوشی‌ها به این سو و آن سو می‌رفتند."],[937,"زین قدح‌های صور کم‌باش مست","تا نگردی بت‌تراش و بت‌پرست","از این ظرف‌های گوناگون و زیبا کم مستی کن تا به حالت مجسمه‌سازی و پرستش بت‌ها دچار نشوی."],[937,"از قدح‌های صور بگذر مه‌ایست","باده در جامست لیک از جام نیست","خود را از ظاهر و زیبایی‌های فریبنده بگذران، چون سرشار از شادی و لذتی واقعی است که درون جام وجود دارد، نه فقط در خود جام."],[937,"سوی باده‌بخش بگشا پهن فم","چون رسد باده نیاید جام کم","به سمت بخشنده باده برو و دهان خود را باز کن، زیرا وقتی باده بیاید، دیگر جایی برای کمبود جام نیست."],[937,"آدما معنی دلبندم بجوی","ترک قشر و صورت گندم بگوی","انسان باید به عمق و معنای عشق و محبت بپردازد و از ظواهر بی‌ارزش و سطحی مانند قشر و شکل ظاهری دور شود."],[937,"چونک ریگی آرد شد بهر خلیل","دانک معزولست گندم ای نبیل","وقتی که خلیل، یعنی ابراهیم، سنگی را به عنوان قربانی می‌آورد، نشان‌دهنده این است که او از گندم معزول است و محرمات را نمی‌پذیرد و دلیلی بر منزلت بالای خود دارد."],[937,"صورت از بی‌صورت آید در وجود","هم‌چنانک از آتشی زادست دود","وجود، از عدم و بی‌صورتی به وجود می‌آید، مانند اینکه دود از آتش بوجود می‌آید."],[937,"کمترین عیب مصور در خصال","چون پیاپی بینیش آید ملال","اگر کمترین عیبی در صفات شخصی دارای تصویر وجود داشته باشد، نشانه‌اش این است که با دیدن آن عیب، به تدریج احساس خستگی و نارضایتی پیدا می‌شود."],[937,"حیرت محض آردت بی‌صورتی","زاده صد گون آلت از بی‌آلتی","حیرت و شگفتی مطلق تو را از نبودن صورت و شکل به وجود می‌آورد، زیرا صد نوع ابزار و وسیله در نتیجه بی‌ابزار بودن به وجود آمده است."],[937,"بی ز دستی دست‌ها بافد همی","جان جان سازد مصور آدمی","انسان بدون کمک دست‌ها، یعنی از طریق تکیه بر توانایی‌های خود، می‌تواند جانش را به شکلی انسانی و زیبا پرورش دهد. این به معنی این است که درک و خلاقیت انسانی، بیشتر از ابزار و وسایل است."],[937,"آنچنان که اندر دل از هجر و وصال","می‌شود بافیده گوناگون خیال","دل انسان به سبب دوری و نزدیکی به معشوق، تصورات و خیالات مختلفی را می‌بافد؛ به این معنا که احساسات عاطفی او در پی این حال و هوا، تغییر می‌کند و شکل‌های گوناگون به خود می‌گیرد."],[937,"هیچ ماند این مؤثر با اثر","هیچ ماند بانگ و نوحه با ضرر","هیچ‌چیز از این مؤثر (یعنی صدا یا تأثیر آن) باقی نمی‌ماند، مانند اینکه صدای نوحه و زاری نیز بدون دردی به جای نمی‌ماند."],[937,"نوحه را صورت ضرر بی‌صورتست","دست خایند از ضرر کش نیست دست","نوحه یا شیون، بدون موضوع و محتوای واقعی‌اش، مانند ضرر و زیان است که تنها ظاهری دارد و در واقع از ضرر واقعی ناتوان است. انسان نمی‌تواند با تکیه بر این شیون‌ها از زیان‌ها جلوگیری کند."],[937,"این مثل نالایقست ای مستدل","حیله تفهیم را جهد المقل","این گفته نادرست است ای استدلال‌کننده، چرا که تلاش برای درک کردن آن، حاکی از ناتوانی و ضعف است."],[937,"صنع بی‌صورت بکارد صورتی","تن بروید با حواس و آلتی","خدایی که بدون شکل و صورت است، به موجوداتی که دارای شکل و قوام‌اند، بدنی می‌دهند که با حواس و ابزارها زندگی می‌کنند و از آن‌ها بهره می‌برند."],[937,"تا چه صورت باشد آن بر وفق خود","اندر آرد جسم را در نیک و بد","انسان در زندگی‌اش به دنبال آن است که جسم خود را به شکل خوب و مناسب درآورد و تحت تأثیر نیک و بد قرار بگیرد. به عبارت دیگر، او با افکار و اعمالش می‌تواند تصویر و حالت وجودی‌اش را شکل دهد."],[937,"صورت نعمت بود شاکر شود","صورت مهلت بود صابر شود","هرگاه زندگی انسان مستاعد و خوشایند باشد، شاکر و سپاس‌گزار می‌شود، و زمانی که در مقام امتحان و سختی قرار گیرد، صبر و شکیبایی از خود نشان می‌دهد."],[937,"صورت رحمی بود بالان شود","صورت زخمی بود نالان شود","روح انسان در مواقعی که به نعمت و رحمت برخورد می‌کند، دچار شکر و سپاس می‌شود، اما در زمان مصیبت و درد، دچار ناله و گریه خواهد شد."],[937,"صورت شهری بود گیرد سفر","صورت تیری بود گیرد سپر","شهر را به مانند صورتی در نظر بگیرید که باید در سفرهایش در برابر آسیب‌ها و خطرات آماده باشد. به عبارتی، افرادی که به شهر می‌روند باید به فکر حفاظت از خود باشند."],[937,"صورت خوبان بود عشرت کند","صورت غیبی بود خلوت کند","صورت خوبان به نوازش و شادی مشغول است، در حالی که صورت غیبی (یعنی حقیقت و باطن) در تنهایی و خلوت به تفکر و Meditacion مشغول است."],[937,"صورت محتاجی آرد سوی کسب","صورت بازو وری آرد به غصب","انسان‌های نیازمند به کسب درآمد و معیشت، از روش‌های نادرست و غیراخلاقی مانند غصب و زورگویی استفاده می‌کنند."],[937,"این ز حد و اندازه‌ها باشد برون","داعی فعل از خیال گونه‌گون","اینکه وقتی انسان از حد و اندازه‌های خود خارج می‌شود، می‌تواند باعث شود که افعال و کارهایش از خیال و تصورهای مختلف نشأت بگیرد."],[937,"بی‌نهایت کیش‌ها و پیشه‌ها","جمله ظل صورت اندیشه‌ها","همه‌ی آداب، باورها و مشاغل بشر، تنها مانند سایه‌هایی از اندیشه‌ها و تفکرات او هستند و در واقعیت وجود ندارند، بلکه حاصل تصورات او هستند."],[937,"بر لب بام ایستاده قوم خوش","هر یکی را بر زمین بین سایه‌اش","در این بیت، گروهی خوشحال در بالای بام ایستاده‌اند و هر کدام سایه خود را بر روی زمین می‌بینند. این تصویر به نوعی نشان‌دهنده این است که انسان‌ها چگونه به خوشحالی و افتخار می‌پردازند، در حالی که سایه‌هایشان، ممکن است به معنای حقیقت یا واقعیت زندگی‌شان، آن‌ها را دنبال می‌کند."],[937,"صورت فکرست بر بام مشید","وآن عمل چون سایه بر ارکان پدید","فکر و اندیشه مانند تصویری است که بر بام قرار دارد، اما عمل و رفتار همچون سایه‌ای است که بر پایه‌ها و ارکان وجود انسان ظاهر می‌شود."],[937,"فعل بر ارکان و فکرت مکتتم","لیک در تاثیر و وصلت دو به هم","عمل و کار بر پایه‌های فکری انسان است و این دو (عمل و فکر) در تأثیر هم و در ارتباط با یکدیگرند."],[937,"آن صور در بزم کز جام خوشی‌ست","فایده او بی‌خودی و بیهشی‌ست","در جمع‌های شادمانی که با ن drinking می‌گذرد، نتیجه آن خوشی و لذت، حالت بی‌خودی و بی‌هشی است."],[937,"صورت مرد و زن و لعب و جماع","فایده‌ش بی‌هوشی وقت وقاع","منافع روابط زناشویی، بازی‌ها و لذت‌های دنیوی در حالت بی‌خود و مستی به دست می‌آید، نه در حواس و آگاهی معمولی."],[937,"صورت نان و نمک کان نعمت است","فایده‌ش آن قوت بی‌صورت است","نان و نمک که نعمت محسوب می‌شود، تنها به خاطر این‌که قوت و انرژی برای انسان فراهم می‌آورد، ارزش دارد و خود این نعمت‌ها ظاهری ندارند."],[937,"در مصاف آن صورت تیغ و سپر","فایده‌ش بی‌صورتی یعنی ظفر","در جنگ و نبرد، استفاده از سلاح و زره (تیغ و سپر) اهمیت دارد، اما برتری واقعی و پیروزی در عمق معنا و دانش نهفته است، نه صرفا در ظاهر و شکل."],[937,"مدرسه و تعلیق و صورت‌های وی","چون به دانش متصل شد گشت طی","وقتی مدرسه و آموزه‌ها و ظواهر آن با علم و دانش ارتباط پیدا کرد، مانند مسیری صاف و هموار گشت."],[937,"این صور چون بنده بی‌صورتند","پس چرا در نفی صاحب‌نعمتند","این اشکال و صورت‌ها مانند بندگان بی‌صورت هستند، پس چرا در انکار و نفی کسی که بر آن‌ها نعمت می‌دهد، تردید دارند؟"],[937,"این صور دارد ز بی‌صورت وجود","چیست پس بر موجد خویشش جحود","وجود این اشیاء که بی‌صورت هستند، چه معنایی دارد؟ پس چرا بر خالق خود که آن‌ها را به وجود آورده‌اند، کفر می‌ورزند و این حقیقت را انکار می‌کنند؟"],[937,"خود ازو یابد ظهور انکار او","نیست غیر عکس خود این کار او","انسان تنها از وجود خود بهره‌مند می‌شود و هیچ چیزی جز تمایلات و نشان‌های خودش را نمی‌بیند. در واقع، حقیقت این است که او تنها در حال انکار خود است و آثار کار او فقط منعکس‌کننده‌ی خود اوست."],[937,"صورت دیوار و سقف هر مکان","سایه اندیشه معمار دان","شکل و نمای دیوار و سقف هر جایی تحت تأثیر افکار و اندیشه‌های معمار است. به این معنا که هر ساختمانی نتیجه‌ی تفکر و طراحی شخصی است که آن را ساخته."],[937,"گرچه خود اندر محل افتکار","نیست سنگ و چوب و خشتی آشکار","اگرچه در این مکان، چیزی به ‌وضوح دیده نمی‌شود، یعنی سنگ و چوب و آجر قابل مشاهده نیستند، باید بدانیم که حقیقت اصلی در پس این مظاهر قرار دارد و آن به تفکر و اندیشه معمار وابسته است."],[937,"فاعل مطلق یقین بی‌صورتست","صورت اندر دست او چون آلتست","یقین حقیقی از نظر مولانا هیچ شکلی ندارد و بی‌صورت است. در واقع، آنچه به عنوان صورت و شکل می‌شناسیم، مانند ابزاری است که در دست یقین قرار دارد و فقط وسیله‌ای برای بیان آن حقیقت است."],[937,"گه گه آن بی‌صورت از کتم عدم","مر صور را رو نماید از کرم","گاهی آن موجود بی‌صورت، که از کتم عدم (جای ناپدید) وجود دارد، به خاطر رحمتش، صورت‌ها را نمایان می‌کند."],[937,"تا مدد گیرد ازو هر صورتی","از کمال و از جمال و قدرتی","هر شکلی (صورت) از کمال و زیبایی و قدرت به او (خدا) مدد و یاری می‌طلبد."],[937,"باز بی‌صورت چو پنهان کرد رو","آمدند از بهر کد در رنگ و بو","آن‌ها مانند موجودی بی‌صورت و پنهان شدند و برای رسیدن به خواسته‌های خود، به ظاهر و زیبایی‌های دنیوی توجه کردند."],[937,"صورتی از صورت دیگر کمال","گر بجوید باشد آن عین ضلال","اگر کسی به دنبال کمال و زیبایی در هر شکلی باشد، در واقع به گمراهی می‌افتد و از حقیقت دور می‌شود."],[937,"پس چه عرضه می‌کنی ای بی‌گهر","احتیاج خود به محتاجی دگر","ای انسان فاقد اصل و نسب، چه چیزی را به دیگران عرضه می‌کنی در حالی که خود به چیز دیگری نیازمند هستی؟"],[937,"چون صور بنده‌ست بر یزدان مگو","ظن مبر صورت به تشبیهش مجو","چون انسان فقط به صورت و تصویر خود می‌نگرد و در این حال افراد را با ظن و خیال می‌سنجد، نباید درباره خداوند که فراتر از صورت‌ها و تشبیهات است، اندیشه یا قضاوتی کرد."],[937,"در تضرع جوی و در افنای خویش","کز تفکر جز صور ناید به پیش","در حال دعا و پژمردگی خود به سر می‌برد، زیرا از فکر و اندیشه‌اش جز تصویر و شکل چیزی به ذهنش نمی‌آید."],[937,"ور ز غیر صورتت نبود فره","صورتی کان بی‌تو زاید در تو به","اگر به غیر از صورت تو، هیچ توانمندی نیست، پس صورتی که به‌واسطه تو برخیزد، از وجود تو نشأت می‌گیرد."],[937,"صورت شهری که آنجا می‌روی","ذوق بی‌صورت کشیدت ای روی","شهری که تو به آن می‌روی، این لذت و شوق را از زیبایی‌های ظاهری می‌گیرد، ای رخسار زیبا."],[937,"پس به معنی می‌روی تا لامکان","که خوشی غیر مکانست و زمان","پس تو به معنای واقعی به سمت جایی می‌روید که نه تنها مکان، بلکه خوشی و لذت در آن فراتر از زمان و مکان است."],[937,"صورت یاری که سوی او شوی","از برای مونسی‌اش می‌روی","اگر به سوی محبوبی که برایش دلت تنگ است بروی، در حقیقت برای نزدیکی به او و ارتباط با او می‌روی."],[937,"پس بمعنی سوی بی‌صورت شدی","گرچه زان مقصود غافل آمدی","پس تو به معنای ناب، به سوی بی‌صورت و بی‌قید و شرط رسیدی، هرچند که از آن هدف واقعی و مقصود غافل بودی."],[937,"پس حقیقت حق بود معبود کل","کز پی ذوقست سیران سبل","حقیقت خداوند، معبود همه موجودات است که به عشق و ذوق الهی، راه‌های مختلف را طی می‌کند."],[937,"لیک بعضی رو سوی دم کرده‌اند","گرچه سر اصلست سر گم کرده‌اند","اما برخی به دنبال ظواهر هستند و به جای اینکه در جستجوی حقیقت باشند، به چیزهای سطحی و غیر واقعی روی آورده‌اند. در حالی که حقیقت و جوهر را گم کرده‌اند و به سرمنزل مقصود نرسیده‌اند."],[937,"لیک آن سر پیش این ضالان گم","می‌دهد داد سری از راه دم","اما آن سر (هدایت و عقل) در برابر این گم‌کردگان (پسران سلطان) از دست آنها شکایت می‌کند که با پیروی از هوای نفس خود (دم) به راه باطل رفته‌اند و عاقلانه رفتار نکرده‌اند."],[937,"آن ز سر می‌یابد آن داد این ز دم","قوم دیگر پا و سر کردند گم","این بیت می‌گوید که فردی که به دلیل قدرت، به آن سر (عالم بالاتر) می‌رسد، به وسیله کلمات (دم) قادر است داد و فریاد کند، اما برخی از افراد (قوم دیگر) در پی قدرت و مقام، سر و پا را گم می‌کنند و در نتیجه به تله بلا می‌افتند."],[937,"چونک گم شد جمله جمله یافتند","از کم آمد سوی کل بشتافتند","چون همه به ضیاع و گمراهی رفتند، در جستجوی راه نجات و کمال برآمدند و به سوی همه‌چیز شتاب کردند تا از کمبود خود فرار کنند."],[938,"این سخن پایان ندارد آن گروه","صورتی دیدند با حسن و شکوه","این حرف و سخن هرگز تمام نمی‌شود، زیرا آن گروه صورتی را دیدند که بسیار زیبا و با جلال و شکوه بود."],[938,"خوب‌تر زان دیده بودند آن فریق","لیک زین رفتند در بحر عمیق","آن گروه زیبایی را که دیده بودند، از آنچه مشاهده کردند، زیباتر تصور کرده بودند، اما حالا به‌خاطر آنچه دیدند، در افکار و احساسات عمیق و پیچیده‌ای فرو رفته‌اند."],[938,"زانک افیونشان درین کاسه رسید","کاسه‌ها محسوس و افیون ناپدید","چون افیونی که آنها مصرف کردند به این کاسه رسید، کاسه‌ها قابل دیدن و ملموس هستند اما اثر افیون غیرقابل مشاهده است."],[938,"کرد فعل خویش قلعه هش‌ربا","هر سه را انداخت در چاه بلا","تنهایی و زیبایی دختر شاه چین (که به آن «هش‌ربا» گفته شده) با جاذبه‌ای خاص، هر سه نفر را در چاه مصیبتی انداخته است."],[938,"تیر غمزه دوخت دل را بی‌کمان","الامان و الامان ای بی‌امان","غمزه، که به‌عنوان تیر بی‌کمان توصیف شده، دل‌ها را مجروح و آشفته کرده است و همه را در وضعیت خطر و بی‌پناهی قرار داده است."],[938,"قرنها را صورت سنگین بسوخت","آتشی در دین و دلشان بر فروخت","سال‌ها احساسات سنگین و غم‌انگیزی به جان و دین این افراد آسیب زده و آن‌ها را تحت تأثیر قرار داده است. این آتش، به معنای گذشت زمان و سختی‌هایی که متحمل شده‌اند، در دل‌هایشان شعله‌ور شده است."],[938,"چونک روحانی بود خود چون بود","فتنه‌اش هر لحظه دیگرگون بود","چون او روحانی و معنوی بود، فتنه و شور او همیشه در هر لحظه شگفت‌انگیز و متفاوت بود."],[938,"عشق صورت در دل شه‌زادگان","چون خلش می‌کرد مانند سنان","عشق به زیبایی دختران شاهزاده‌ها را در دل‌ها مثل خنجر می‌کرد و آن‌ها را عمیقا آزرده می‌ساخت."],[938,"اشک می‌بارید هر یک هم‌چو میغ","دست می‌خایید و می‌گفت ای دریغ","هر یک از آن‌ها مانند ابر اشک می‌ریختند و در عین حال پریشان‌حالی، دست‌هایشان را به سوی صورت معشوق دراز می‌کردند و با حسرت می‌گفتند که دریغ از این عشق و زیبایی."],[938,"ما کنون دیدیم شه ز آغاز دید","چندمان سوگند داد آن بی‌ندید","ما اکنون شاه را از ابتدا دیده‌ایم، اما او به ما سوگند داد که چیزی از او را ندیدیم."],[938,"انبیا را حق بسیارست از آن","که خبر کردند از پایانمان","پیامبران از سوی خداوند، از آنجا که خبرهایی درباره سرنوشت و پایان کار ما داده‌اند، بسیار مهم و ارزشمند هستند."],[938,"کاینچ می‌کاری نروید جز که خار","وین طرف پری نیابی زو مطار","آنچه در این دنیا می‌کاری، جز خار و مشکلات زایشی ندارد. از طرف مقابل، در اینجا هیچ گلی به دست نخواهی آورد."],[938,"تخم از من بر که تا ریعی دهد","با پر من پر که تیر آن سو جهد","این بیت اشاره به این دارد که تخم (نماد ایده یا نطفه‌ای) باید از من کاشته شود تا رشد کند و میوه‌ای بدهد. پر به معنای بال‌های من است که به تیر (هدف یا مقصد) در آن سوی دنیا پرواز می‌کند. به‌طور کلی، می‌گوید که باید با تمام توان برای رسیدن به هدف تلاش کرد."],[938,"تو ندانی واجبی آن و هست","هم تو گویی آخر آن واجب بدست","تو نمی‌دانی که واجب بودن این امر بر تو لازم است، و با وجود اینکه این موضوع وجود دارد، تو می‌گویی در نهایت این واجب به دست می‌آید."],[938,"او توست اما نه این تو آن توست","که در آخر واقف بیرون‌شوست","این «تو» که اشاره به خود فرد دارد، حقیقتی عمیق‌تر از ظاهر او را معرفی می‌کند. این وجود، در نهایت به دانشی و آگاهی عمیق‌تر دست می‌یابد که از مرزهای ظاهری فراتر می‌رود."],[938,"توی آخر سوی توی اولت","آمدست از بهر تنبیه و صلت","در نهایت، تو به سمت ذات و جوهر خودت برمی‌گردی که همان اول وجودت است، و این بازگشت به خاطر آگاهی و ارتباطی است که باید برقرار شود."],[938,"توی تو در دیگری آمد دفین","من غلام مرد خودبینی چنین","وجود حقیقی و اصیل تو در دیگری نهفته است. من همچون برده‌ای هستم که گرفتار خودبینی و خودخواهی هستم، و نمی‌توانم آن حقیقت را ببینم."],[938,"آنچ در آیینه می‌بیند جوان","پیر اندر خشت بیند بیش از آن","آنچه جوان در آینه می‌بیند، پیر در خشت (آجر) نیز می‌بیند، اما در واقع آنچه جوان می‌بیند بیشتر از آن است."],[938,"ز امر شاه خویش بیرون آمدیم","با عنایات پدر یاغی شدیم","از فرمان شاه خودش بیرون رفتیم و با لطف و عنایت پدر، سرکش و طاغی شدیم."],[938,"سهل دانستیم قول شاه را","وان عنایت‌های بی اشباه را","ما حرف‌های شاه و نعمت‌های خاص او را ساده گرفتیم و درک نکردیم که این نعمت‌ها و توجهات بی‌نظیر هستند."],[938,"نک در افتادیم در خندق همه","کشته و خسته بلا بی ملحمه","ما در چنگال مشکلات و بلاهای بزرگ افتاده‌ایم و به شدت خسته و آسیب‌دیده هستیم، بدون اینکه کار یا تدبیری برای نجات خود داشته باشیم."],[938,"تکیه بر عقل خود و فرهنگ خویش","بودمان تا این بلا آمد به پیش","به خاطر تکیه بر عقل و فرهنگ خود، به این بلا گرفتار شدیم."],[938,"بی‌مرض دیدیم خویش و بی ز رق","آنچنان که خویش را بیمار دق","در این بیت، بیان می‌شود که ما خود را بدون هیچ بیماری و نارسایی دیده‌ایم، به طوری که گویی هیچ درد و رنجی نداریم، و این احساس خوب به گونه‌ای است که به خودمان شک می‌کنیم که آیا واقعا چنین حالتی داریم یا در حالت غفلت به سر می‌بریم."],[938,"علت پنهان کنون شد آشکار","بعد از آنک بند گشتیم و شکار","علت پنهان در دل ما اکنون که بندگی و تسلیم را انتخاب کردیم، برایمان روشن شد و آشکار گردید."],[938,"سایه رهبر بهست از ذکر حق","یک قناعت به که صد لوت و طبق","سایه رهبر، که به معنای هدایت الهی است، از یاد خداوند بهتر است و داشتن این هدایت کافی است، در حالی‌که صدها کوه طلا و ثروت نتوانند به اندازه همین یاد خدا ارزش داشته باشند."],[938,"چشم بینا بهتر از سیصد عصا","چشم بشناسد گهر را از حصا","چشم بینا و سالم می‌تواند به‌خوبی الماس را از سنگی بی‌ارزش تشخیص دهد، در حالی که حتی سیصد عصای نابینایی نمی‌تواند چنین کار ارزشمندی را انجام دهد."],[938,"در تفحص آمدند از اندهان","صورت کی بود عجب این در جهان","در جستجو و بررسی به این نتیجه رسیدند که این تصویر متعلق به چه کسی است، و شگفت‌انگیز است که این‌چنین رازهایی در جهان وجود دارد."],[938,"بعد بسیاری تفحص در مسیر","کشف کرد آن راز را شیخی بصیر","پس از مدت‌ها جست‌وجو و تحقیق، سرانجام آن راز را شخصی دانا و با بصیرت کشف کرد."],[938,"نه از طریق گوش بل از وحی هوش","رازها بد پیش او بی روی‌پوش","رازها نه از طریق شنیدن، بلکه از طریق الهام و فرشته‌گی به او منتقل می‌شود و او به‌گونه‌ای بی‌پرده و بی‌هیچ پوششی از این اسرار آگاه است."],[938,"گفت نقش رشک پروینست این","صورت شه‌زاده چینست این","او می‌گوید که این تصویر زیبا مانند نقش ستاره پروین است و متعلق به شاه‌زاده‌ای از چین می‌باشد."],[938,"هم‌چو جان و چون جنین پنهانست او","در مکتم پرده و ایوانست او","او همچون جان و مانند جنینی (که در شکم مادر پنهان است) در مکانی مخفی و زیر پرده و در ایوان (که می‌تواند به یک محل اشرافی یا زیبا اشاره داشته باشد) پنهان است."],[938,"سوی او نه مرد ره دارد نه زن","شاه پنهان کرد او را از فتن","نزدیک او هیچ‌کس، چه مرد و چه زن، نمی‌تواند نزدیک شود، زیرا شاه (که در اینجا اشاره به خداست) او را از آشفتگی و فتنه‌ها پنهان کرده است."],[938,"غیرتی دارد ملک بر نام او","که نپرد مرغ هم بر بام او","ملک نسبت به نام او (دختر شاه چین) غیرتی دارد و به همین دلیل هیچ پرنده‌ای جرأت نمی‌کند بر بام او بنشیند."],[938,"وای آن دل کش چنین سودا فتاد","هیچ کس را این چنین سودا مباد","چه悲心‌انگیز است آن دلی که در چنین خیال و حرارتی افتاده است. آرزو می‌کنم که هیچ کس به این درد و وسوسه دچار نشود."],[938,"این سزای آنک تخم جهل کاشت","وآن نصیحت را کساد و سهل داشت","کسی که تخم جهل را در دل خود کاشته و نصیحت‌های خوب را نادیده گرفته و آسان گرفته است، باید متوجه عواقب این کار باشد و به سرنوشت تلخی دچار شود."],[938,"اعتمادی کرد بر تدبیر خویش","که برم من کار خود با عقل پیش","او به تدبیر و هوش خود اعتماد کرده است و تصمیم می‌گیرد که کارهایش را با عقل و خرد خود پیش ببرد."],[938,"نیم ذره زان عنایت به بود","که ز تدبیر خرد سیصد رصد","نیم ذره‌ای از لطف و عنایت کافی است، چرا که در برابر تدبیر و عقل، از سیصد تدبیر هم نیاز نیست."],[938,"ترک مکر خویشتن گیر ای امیر","پا بکش پیش عنایت خوش بمیر","ای امیر، از ترفندهای خود دست بکش و خودت را به خواست و لطف الهی بسپار. برای درک این عنایت و بهره‌مندی از آن، قدم بردار و از خودگذشتگی کن."],[938,"این به قدر حیله معدود نیست","زین حیل تا تو نمیری سود نیست","این‌طور نیست که این‌گونه نیرنگ‌ها به تعدادی کم باشد؛ تا زمانی که تو آماده‌ی مرگ نشوی، فایده‌ای از این نیرنگ‌ها نخواهی برد."],[939,"در بخارا خوی آن خواجیم اجل","بود با خواهندگان حسن عمل","در بخارا، سرنوشت آن خواجه (رئیس یا صاحب‌منصب) به دست افراد خواهان عمل نیک و نیکی‌ها رقم خورده است. در واقع، مرگ (اجل) او تحت تأثیر کردار نیک کسانی که در پی خیر هستند، قرار دارد."],[939,"داد بسیار و عطای بی‌شمار","تا به شب بودی ز جودش زر نثار","او در طول روز بخشش‌های فراوان و عطای زیاد می‌کرد، تا جایی که تا شب، از generosity خود به دیگران طلا و پول زیادی می‌داد."],[939,"زر به کاغذپاره‌ها پیچیده بود","تا وجودش بود می‌افشاند جود","زر (طلا) را در کاغذها پیچیده بودند تا زمانی که وجودش برقرار بود، از بخشش و سخاوت خود می‌پاشید."],[939,"هم‌چو خورشید و چو ماه پاک‌باز","آنچ گیرند از ضیا بدهند باز","همان‌طور که خورشید و ماه نور پاک و روشنی دارند، آنچه را که از نور و روشنایی خود می‌گیرند، به دیگران نیز می‌بخشند."],[939,"خاک را زربخش کی بود آفتاب","زر ازو در کان و گنج اندر خراب","آفتاب نمی‌تواند خاک را به طلا تبدیل کند، همان‌طور که طلا در زیر زمین و درون خرابه‌ها گنج‌های ارزشمندی را پنهان کرده است."],[939,"هر صباحی یک گره را راتبه","تا نماند امتی زو خایبه","هر صبح یک مشکل را حل کن تا هیچ گروهی از آن محروم نماند."],[939,"مبتلایان را بدی روزی عطا","روز دیگر بیوگان را آن سخا","در یک روز به دچارشدگان (مبتلایان) نعمت و روزی داده می‌شود و در روز بعد، به بیوه‌زنان سخاوت و کمک می‌شود."],[939,"روز دیگر بر علویان مقل","با فقیهان فقیر مشتغل","در روز دیگر به نیازمندان علوی، که از خانواده علی (ع) هستند، توجه می‌شود و فقیران نیز در جستجوی مایحتاج خود مشغول هستند."],[939,"روز دیگر بر تهی‌دستان عام","روز دیگر بر گرفتاران وام","در روز بعد، مولانا به سراغ آدم‌های بی‌پول و درمانده‌ای رفت که به خاطر قرض و بدهی در سختی هستند."],[939,"شرط او آن بود که کس با زبان","زر نخواهد هیچ نگشاید لبان","شرط او (صدر جهان) این بود که هیچ‌کس با زبان طلا (زبان پر از نیرنگ و فریب) نخواهد توانست از او چیزی بگیرد و لب‌های او در برابر چنین درخواست‌هایی باز نخواهد شد."],[939,"لیک خامش بر حوالی رهش","ایستاده مفلسان دیواروش","اما او که در اطراف این مسیر ایستاده، باز هم ساکت است و در برابر ثروتمندان توسیع نمی‌دهد و به فقیران اجازه نمی‌دهد که از او چیزی بخواهند."],[939,"هر که کردی ناگهان با لب سؤال","زو نبردی زین گنه یک حبه مال","هر کسی که به طور ناگهانی با زبان سوال کند و از آن شخص پولی بخواهد، به خاطر این کارش حتی یک دانه هم از دارایی او نصیبش نخواهد شد."],[939,"من صمت منکم نجا بد یاسه‌اش","خامشان را بود کیسه و کاسه‌اش","من در سکوت خود فریاد می‌زنم، زیرا کیسه‌ و کاسه‌ام پر از چیزهای بی‌ارزش است. این بیان به عدم همکاری و کمبود واقعیات ضروری در زندگی اشاره دارد."],[939,"نادرا روزی یکی پیری بگفت","ده زکاتم که منم با جوع جفت","روزی یک پیرمرد گفت که من به خاطر گرسنگی خود، ده زکات را می‌خواهم."],[939,"منع کرد از پیر و پیرش جد گرفت","مانده خلق از جد پیر اندر شگفت","پیر را از دریافت زکات منع کردند و جد او نیز از قضا در این موضوع مداخله کرد، به طوری که مردم به دلیل این وضعیت شگفت‌زده و متعجب مانده‌اند."],[939,"گفت بس بی‌شرم پیری ای پدر","پیر گفت از من توی بی‌شرم‌تر","این بیت بیانگر گفت‌وگویی است بین دو نفر، که یکی از آن‌ها به دیگری (پدر) انتقاد می‌کند و او را فاقد شرم می‌داند. در پاسخ، پدر هم از او می‌خواهد که از من بی‌شرم‌تر است، یعنی به نوعی او را نیز به بی‌شرمی متهم می‌کند."],[939,"کین جهان خوردی و خواهی تو ز طمع","کان جهان با این جهان گیری به جمع","تو به خاطر طمع، این جهان را می‌خوری و می‌خواهی که از نعمت‌ها و ثروت‌های آن بهره‌مند شوی، در حالی که این جهان، بی‌جهت و بی‌عاقبتی است و تو نتوانی آن را جمع‌آوری کنی."],[939,"خنده‌اش آمد مال داد آن پیر را","پیر تنها برد آن توفیر را","پیر، از دیدن خنده او به این نتیجه رسید که او با دادن مال، می‌خواهد او را فریب دهد و تنها بودن پیر به این معناست که او به دنبال سود و منفعت نیست."],[939,"غیر آن پیر ایچ خواهنده ازو","نیم حبه زر ندید و نه تسو","جز آن پیر، هیچ خواهنده‌ای از آن عالم، حتی یک دانه زر هم نخواست و نه چیزی دیگر."],[939,"نوبت روز فقیهان ناگهان","یک فقیه از حرص آمد در فغان","در روزی که فقیهان در حال بحث و گفت‌وگو بودند، ناگهان یک فقیه به خاطر حرص و طمع خود به شدت ناله و فریاد برآورده است."],[939,"کرد زاری‌ها بسی چاره نبود","گفت هر نوعی نبودش هیچ سود","او (فقیه) کوشش‌های زیادی کرد و زاری کرد، ولی هیچ چاره‌ای برای مشکلش پیدا نشد و هر تلاشی که انجام می‌داد، فایده‌ای نداشت."],[939,"روز دیگر با رگو پیچید پا","ناکس اندر صف قوم مبتلا","در روز بعد، شخص ناچیز و بی‌نظمی به جمع مردم پیوست و به دنبال مشکلات و دردسرها رفت."],[939,"تخته‌ها بر ساق بست از چپ و راست","تا گمان آید که او اشکسته‌پاست","او برای پنهان‌سازی نقص خود، تخته‌هایی به پاهایش باند کرده که به نظر می‌رسد پایش شکسته است، تا دیگران فکر کنند او زخمی و incapacitated است."],[939,"دیدش و بشناختش چیزی نداد","روز دیگر رو بپوشید از لباد","او (دانشمند درویش) فردای آن روز را دید و شناخت، اما چیزی به او نداد و با پوشاندن صورتش از بین رفت."],[939,"هم بدانستش ندادش آن عزیز","از گناه و جرم گفتن هیچ چیز","او (دانشمند درویش) می‌دانست که آن شخص (صدر جهان) به خاطر گناه و جرمش، هیچ چیزی به او نخواهد داد."],[939,"چونک عاجز شد ز صد گونه مکید","چون زنان او چادری بر سر کشید","چون از طرق مختلف نتوانست چیزی به دست آورد و ناامید شد، مانند زنان، چادر بر سر کشید تا خود را پنهان کند."],[939,"در میان بیوگان رفت و نشست","سر فرو افکند و پنهان کرد دست","او به میان بیوگان رفت و نشست، سرش را پایین انداخت و دستش را پنهان کرد."],[939,"هم شناسیدش ندادش صدقه‌ای","در دلش آمد ز حرمان حرقه‌ای","او را شناختند و به او صدقه‌ای ندادند، و در دل او احساس ناامیدی و حسرتی ایجاد شد که مثل آتش می‌سوزاندش."],[939,"رفت او پیش کفن‌خواهی پگاه","که بپیچم در نمد نه پیش راه","او در صبح زود به سمت کسی که کفن می‌خواست، رفت و تصمیم داشت که خود را در نمد (پوششی برای دفن مردگان) بپیچد و به این ترتیب در مسیر او قرار نگیرد."],[939,"هیچ مگشا لب نشین و می‌نگر","تا کند صدر جهان اینجا گذر","هرگز لب به سخن نزن و فقط ببین که آیا صدر جهان (سلطان یا رئیس جهانی) از اینجا عبور خواهد کرد یا نه."],[939,"بوک بیند مرده پندارد به ظن","زر در اندازد پی وجه کفن","اگر کسی ببیند که مرده‌ای وجود دارد، بر اساس فرض و گمانش، به خاطر پولی که می‌تواند به دست آورد، به سراغ پیگیری کفن او می‌رود."],[939,"هر چه بدهد نیم آن بدهم به تو","هم‌چنان کرد آن فقیر صله‌جو","فقیر خواهان صله می‌گوید: هر چیزی که به من بدهی، من نیمی از آن را به تو می‌دهم."],[939,"در نمد پیچید و بر راهش نهاد","معبر صدر جهان آنجا فتاد","او در نمد (بافته‌ای پشمی) پیچید و آن را بر سر راه صدر جهان (یک امیر یا مقام عالی) گذاشت تا او آنجا بیفتد و به این ترتیب خود را به او نزدیک کند."],[939,"زر در اندازید بر روی نمد","دست بیرون کرد از تعجیل خود","با عجله و شتاب، طلا (زر) را بر روی نمد (پوشش) ریخت و دستش را از این شتاب‌زدگی بیرون آورد."],[939,"تا نگیرد آن کفن‌خواه آن صله","تا نهان نکند ازو آن ده‌دله","کسی که در جست‌وجوی کفن یا پاداش است، تا زمانی که از او درخواستی نشود، این پاداش را از او مخفی نمی‌کند و در دلش نیازی احساس نمی‌کند."],[939,"مرده از زیر نمد بر کرد دست","سر برون آمد پی دستش ز پست","مرده که زیر نمد (پوشش نرم) خوابیده بود، دستش را بیرون آورد و سرش را نیز از زیر این پوشش خارج کرد؛ انگار از جایی پایین‌تر دستش را دراز کرد تا خود را نشان دهد."],[939,"گفت با صدر جهان چون بستدم","ای ببسته بر من ابواب کرم","گفت: ای صدر جهان، زمانی که درهای بخشش تو به روی من بسته شده است، چه زمانی می‌توانم با تو حرف بزنم یا مدد بگیرم؟"],[939,"گفت لیکن تا نمردی ای عنود","از جناب من نبردی هیچ جود","می‌گوید اما ای انسان لجوج، تا زمانی که نمرده‌ای، حتی از جانب من هیچ نوع بخششی به تو نمی‌رسد."],[939,"سر موتوا قبل موت این بود","کز پس مردن غنیمت‌ها رسد","حرف اصلی این بیت این است که باید قبل از مرگ، تغییر و تحول در خود ایجاد کرد، زیرا پس از مرگ، فرصت‌های باارزش به دست می‌آید. این به نوعی اشاره به اهمیت خودسازی و آماده‌سازی برای زندگی پس از مرگ دارد."],[939,"غیر مردن هیچ فرهنگی دگر","در نگیرد با خدای ای حیله‌گر","هیچ روش و فرهنگی فراتر از مرگ نمی‌تواند با خداوند، ای حقه‌باز، ارتباط برقرار کند."],[939,"یک عنایت به ز صد گون اجتهاد","جهد را خوفست از صد گون فساد","یک نعمت (یا لطف الهی) از صد نوع تلاش و کوشش، ارزش بیشتری دارد، زیرا تلاش و کوشش ممکن است به فساد و گمراهی منجر شود."],[939,"وآن عنایت هست موقوف ممات","تجربه کردند این ره را ثقات","این عنایت الهی به مرگ بستگی دارد و کسانی که در این مسیر تجربه داشته‌اند، به این حقیقت پی برده‌اند که ایمن بودن و موفقیت در زندگی، نیازمند توجه و عنایت از سوی خداوند است."],[939,"بلک مرگش بی‌عنایت نیز نیست","بی‌عنایت هان و هان جایی مه‌ایست","مرگ کسی که از نعمت توجه و عنایت بی‌بهره است، بدون شک و چشم پوشی در جای خاصی است که مانند ماه درخشان می‌درخشد."],[939,"آن زمرد باشد این افعی پیر","بی زمرد کی شود افعی ضریر","آن زمرد (گوهری با ارزش) وجود دارد، اما این افعی پیر (زهرآگین) بدون زمرد (گوهری ارزشمند) چگونه می‌تواند نابینا (بی‌فایده و غیرمؤثر) شود؟ این به نوعی به این معناست که ارزش و ویژگی‌ها برای چیزی یا کسی، آن را از زهرآگینی و آسیب‌پذیری رها نمی‌کند."],[940,"امردی و کوسه‌ای در انجمن","آمدند و مجمعی بد در وطن","دو مرد یکی زیبا و دیگری زشت در محفل و جمعی گرد هم آمدند و در وطن خود جمع شدند."],[940,"مشتغل ماندند قوم منتجب","روز رفت و شد زمانه ثلث شب","قوم منتجب، یعنی آن گروه منتخب و خاص، تا نیمه‌های شب سرگرم بودند و به خواب نرفته بودند تا اینکه زمان به ثلث شب رسید و شب به سمت نیمه‌های دیگر پیش رفت."],[940,"زان عزب‌خانه نرفتند آن دو کس","هم بخفتند آن سو از بیم عسس","آن دو برادر به دلیل ترس از نگهبانان شب، از آن خانه بیرون نرفتند و در همان جا خوابشان برد."],[940,"کوسه را بد بر زنخدان چار مو","لیک هم‌چون ماه بدرش بود رو","کوسه کلا روی چانه اش چهار تار مو بیشتر نداشت، اما با این حال چهره‌اش همچون ماه کامل بود"],[940,"کودک امرد به صورت بود زشت","هم نهاد اندر پس کون بیست خشت","کودک که به صورت زشت و بدقواره بود، در عقب بدنش بیست آجر گذاشته بود."],[940,"لوطیی دب برد شب در انبهی","خشتها را نقل کرد آن مشتهی","یک شخص لوتی (مردی که به رفتاره‌ای غیرمتعارف مشهور است) در شب به انباری رفت و خشت‌ها را به مکان دیگری منتقل کرد، زیرا او هوس حمل آن‌ها را داشت."],[940,"دست چون بر وی زد او از جا بجست","گفت هی تو کیستی ای سگ‌پرست","امرد به محض اینکه دست بر او زد، او از جای خود پرید و از او پرسید: «تو کیستی، ای کسی که به سگ‌ها محبت می‌ورزی؟"],[940,"گفت این سی خشت چون انباشتی","گفت تو سی خشت چون بر داشتی","امرد از کودک می‌پرسد که چرا این سی خشت را انبار کرده است، و کودک در پاسخ می‌پرسد تو چرا این سی خشت را برداشت کرده‌ای."],[940,"کودک بیمارم و از ضعف خود","کردم اینجا احتیاط و مرتقد","کودک بیمارم و به دلیل ضعف و ناخوشی‌ام، اینجا احتیاط کرده‌ام و مراقب هستم."],[940,"گفت اگر داری ز رنجوری تفی","چون نرفتی جانب دار الشفی","اگر از رنجوری و بیماری تو گلی به درآید، چرا به طرف دار الشفی (محل درمان) نرفته‌ای؟"],[940,"یا به خانه یک طبیبی مشفقی","که گشادی از سقامت مغلقی","شاید به خانه‌ی یک پزشک مهربانی بروی که با درمان‌هایش می‌تواند مشکل تو را حل کند."],[940,"گفت آخر من کجا دانم شدن","که بهرجا می‌روم من ممتحن","او در پاسخ به سؤالی می‌گوید که من نمی‌دانم برای چه هدفی به جایی می‌روم، زیرا در هر جا که می‌روم، در حال آزمایش و امتحان هستم."],[940,"چون تو زندیقی پلیدی ملحدی","می بر آرد سر به پیشم چون ددی","تو یک کافر و ملحد پلید هستی که سر خود را به جلو می‌آوری، مانند ددی (پدر) که در برابر من می‌آید."],[940,"خانقاهی که بود بهتر مکان","من ندیدم یک دمی در وی امان","هیچ مکانی را بهتر از خانقاه ندیده‌ام و یک لحظه در آنجا از نظر امنیت و آسایش در امان بوده‌ام."],[940,"رو به من آرند مشتی حمزه‌خوار","چشم‌ها پر نطفه کف خایه‌فشار","ای کسانی که به من نگاه می‌کنید، چشمانتان پر از آرزوهای پنهانی است و احساساتتان به شدت در حال فشار و تحریک هستند."],[940,"وانک ناموسیست خود از زیر زیر","غمزه دزدد می‌دهد مالش به کیر","اگر کسی بخواهد ناموس خود را به زیر زبانی دزدیده و به دیگران تحویل دهد، به نوعی از نظر اخلاقی و اجتماعی نقص دارد و به خود لطمه می‌زند."],[940,"خانقه چون این بود بازار عام","چون بود خر گله و دیوان خام","اگر خانقاه (محل تجمع صوفیان) به این شکل است، پس جامعه هم به شکل بازار عمومی است و چون در این بازار، دیوانگان و احمق‌ها مانند خر، در حال گشت و گذارند."],[940,"خر کجا ناموس و تقوی از کجا","خر چه داند خشیت و خوف و رجا","حیواناتی مانند خر نمی‌دانند ناموس و تقوا چیست و هیچ فهم و شعوری درباره ترس و امید ندارند. این بیت به ناتوانی خران در درک ارزش‌های اخلاقی اشاره دارد."],[940,"عقل باشد آمنی و عدل‌جو","بر زن و بر مرد اما عقل کو","عقل باید حافظ و نگهبان باشد و به عدالت توجه داشته باشد درباره زن و مرد، اما عقل در اینجا غایب است و وجود ندارد."],[940,"ور گریزم من روم سوی زنان","هم‌چو یوسف افتم اندر افتتان","اگر من فرار کنم و به سمت زنان بروم، به سرنوشتی مانند یوسف دچار می‌شوم و گرفتار سختی‌ها و مشکلات می‌―فتم."],[940,"یوسف از زن یافت زندان و فشار","من شوم توزیع بر پنجاه دار","یوسف به خاطر زنی به زندان افتاد و با فشار و مشکلاتی روبه‌رو شد، حالا من نیز در این موقعیت قرار گرفتم و به طور ناخواسته به سختی‌ها تقسیم می‌شوم."],[940,"آن زنان از جاهلی بر من تنند","اولیاشان قصد جان من کنند","زنان به خاطر نادانی و بی‌خبری بر من می‌تازند و جریان این بی‌احترامی تحت تأثیر رفتار و نیت‌های بد اطرافیان‌شان است."],[940,"نه ز مردان چاره دارم نه از زنان","چون کنم که نی ازینم نه از آن","من نه از مردان راهی برای کمک دارم و نه از زنان، حالا چه کار کنم که تعلقی به هیچ‌کدام از این دو گروه ندارم."],[940,"بعد از آن کودک به کوسه بنگریست","گفت او با آن دو مو از غم بریست","کودک بعد از آن، به کوسه نگاه کرد و متوجه شد که او با داشتن دو مو، از غم و ناراحتی آزاد است."],[940,"فارغست از خشت و از پیکار خشت","وز چو تو مادرفروش کنک زشت","آن که از خشت و درگیری آن خلاص شده، و بی‌خبر از این ماجراست، تو هم دست از این کارهای زشت و ناپسند بردار، که مثل تو، مادرت، به خاطر عشق و رابطه، به چنین اعمالی تن داده است."],[940,"بر زنخ سه چار مو بهر نمون","بهتر از سی خشت گرداگرد کون","زنی که در موهایش سه یا چهار دانه زینت و adornment داشته باشد، از این نظر بهتر از سی خشت سنگین اطراف بدن است. اینجا به ارزش زیبایی و زینت زنان اشاره شده است که می‌تواند بیشتر از وزنه‌ای سنگین ارزش داشته باشد."],[940,"ذره‌ای سایه عنایت بهترست","از هزاران کوشش طاعت‌پرست","سایه‌ای از لطف و رحمت الهی حتی به‌اندازه یک ذره، از هزاران تلاش برای عبادت و بندگی بهتر است."],[940,"زانک شیطان خشت طاعت بر کند","گر دو صد خشتست خود را ره کند","زیرا شیطان می‌تواند خشت‌های طاعت (اعمال نیک) را از تو بگیرد، حتی اگر صدها خشت داشته باشی، او راهی برای جدا کردن تو از آن‌ها پیدا می‌کند."],[940,"خشت اگر پرست بنهاده توست","آن دو سه مو از عطای آن سوست","اگر خشت‌هایی که به عنوان عبادت و کار نیک گذاشته‌ای، به پرتویی از حسنات مربوط است، آن دو یا سه مویی که به عنوان پاداش دریافت می‌کنی، فقط رد پای آن رحمت و لطف است."],[940,"در حقیقت هر یکی مو زان کهیست","کان امان‌نامه صله شاهنشهیست","در واقع هر یک از این موها، نشانه‌ای از آن قدرت الهی و واقعی است که به نوعی مانند امان‌نامه‌ای است از سوی پادشاهی بزرگ. به عبارتی دیگر، این موها نشان‌دهنده تأیید و حفاظت الهی هستند."],[940,"تو اگر صد قفل بنهی بر دری","بر کند آن جمله را خیره‌سری","اگر بر دری صد قفل هم نصب کنی، خیره‌سری و نادانی آن قفل‌ها را می‌شکند و باز می‌کند."],[940,"شحنه‌ای از موم اگر مهری نهد","پهلوانان را از آن دل بشکهد","اگر شحنه‌ای (نظافتچی یا نگهبان) بر روی موم (ماده‌ای نرم) مهر یا نشانی بزند، دل پهلوانان را می‌شکند، زیرا آن نشان بر آنها تأثیر منفی دارد و به آنها آسیب می‌زند."],[940,"آن دو سه تار عنایت هم‌چو کوه","سد شود چون فر سیما در وجوه","اگر دو یا سه تار عنایت (نعمت و لطف) به انسان برسد، این عنایت همچون کوهی مستحکم می‌شود و مانند چهره زیبا (فرسیما) در چهره‌ها نمایان خواهد بود."],[940,"خشت را مگذار ای نیکوسرشت","لیک هم آمن مخسپ از دیو زشت","خشت را در اینجا به عنوان نماد آزار و رنج می‌داند و می‌گوید ای انسان نیکوکار، این بار را بردار و آن را در زندگی‌ات نگذار، اما همزمان باید از چیزهای بد و زشت هم دوری کنی و نترسی."],[940,"رو دو تا مو زان کرم با دست آر","وانگهان آمن بخسپ و غم مدار","با دو دست خود دو تار موی او را بگیر و آرام باش، ناگهان نترس و نگران نباش."],[940,"نوم عالم از عبادت به بود","آنچنان علمی که مستنبه بود","علمی که از عبادت به مقدار زیادی بهره‌مند است، بهتر از جهانی است که تنها در خواب و بی‌تحرکی می‌گذرد."],[940,"آن سکون سابح اندر آشنا","به ز جهد اعجمی با دست و پا","آرامش غواص در دریا، بیشتر از تلاش بی‌ثمر و پرحرکت فرد بی‌خبر (اعجمی) با دست و پا مؤثر است."],[940,"اعجمی زد دست و پا و غرق شد","می‌رود سباح ساکن چون عمد","زبان غیرفارسی (اعجمی) به جهد و تلاش در آب (دست و پا زدن) افتاد و غرق شد، در حالی که شناگر ماهر (سباح) با آرامش شنا می‌کند، مانند عمود (سنتی که استوار است و محکم است)."],[940,"علم دریاییست بی‌حد و کنار","طالب علمست غواص بحار","علم همانند دریا و نامحدود و بی‌انتهایی است و کسانی که به دنبال دانش هستند مانند غواصانی هستند که در عمق دریا جستجو می‌کنند."],[940,"گر هزاران سال باشد عمر او","او نگردد سیر خود از جست و جو","حتی اگر عمر انسان به هزاران سال برسد، او هرگز از جست‌وجو و تلاش خود سیر نخواهد شد و همواره در پی Knowledge و تجربه است."],[940,"کان رسول حق بگفت اندر بیان","اینک منهومان هما لا یشبعان","پیامبر حق در سخنانش گفت که این دو نوع افراد به هیچ چیز قناعت نمی‌کنند و هرگز سیر نمی‌شوند."],[941,"طالب الدنیا و توفیراتها","طالب العلم و تدبیراتها","کسی که به دنبال دنیا و ظواهر آن است، در حقیقت به دنبال دانش و تدبیرهای علمی هم است."],[941,"پس درین قسمت چو بگماری نظر","غیر دنیا باشد این علم ای پدر","وقتی در این مورد دقت کنی، می‌فهمی که علم واقعی غیر از علم دنیوی است، ای پدر."],[941,"غیر دنیا پس چه باشد آخرت","کت کند زینجا و باشد رهبرت","اگر علم غیر از علم دنیا باشد، پس چه چیزی می‌تواند به آخرت مسیر دهد و رهبر انسان باشد؟"],[942,"رو به هم کردند هر سه مفتتن","هر سه را یک رنج و یک درد و حزن","آن سه شه‌زاده به هم روی آوردند و در حالی که گرفتار شدند، هر کدام از آن‌ها یکسان از رنج، درد و غم مشترک رنج می‌بردند."],[942,"هر سه در یک فکر و یک سودا ندیم","هر سه از یک رنج و یک علت سقیم","هر سه نفر به یک فکر و یک نگرانی مشترک دچار شده‌اند و همه از یک درد و یک علت به رنج آمده‌اند."],[942,"در خموشی هر سه را خطرت یکی","در سخن هم هر سه را حجت یکی","در سکوت، هر سه نفر یک فکر و نگرانی دارند و در صحبت کردن هم، دلیل و برهانشان یکی است."],[942,"یک زمانی اشک‌ریزان جمله‌شان","بر سر خوان مصیبت خون‌فشان","مدتی آنها به شدت گریه و اشک ریزان بر سر سفره عزای خود نشسته بودند و از دلی پرغصه و جراحت‌های عاطفی‌شان خون می‌گریستند."],[942,"یک زمان از آتش دل هر سه کس","بر زده با سوز چون مجمر نفس","مدتی از شدت ناراحتی و درد در دل هر سه نفر، همچون جمره‌ای که از آتش می‌سوزد، نفس می‌کشیدند و ناراحت بودند."],[943,"آن بزرگین گفت ای اخوان خیر","ما نه نر بودیم اندر نصح غیر","برادر بزرگ‌تر به جمع می‌گوید ما در نصیحت دیگران، خیرخواه نبوده‌ایم و نر که به معنای نرینه یا قوی و قاطع است، نبوده‌ایم."],[943,"از حشم هر که به ما کردی گله","از بلا و فقر و خوف و زلزله","هر کس که از دوستان ما به ما گلایه کرد و از بلا، فقر، ترس و زلزله شکایت داشت، باید بداند که این مشکلات، طبیعی و در زندگی همه وجود دارد."],[943,"ما همی‌گفتیم کم نال از حرج","صبر کن کالصبر مفتاح الفرج","ما همواره می‌گفتیم که به جای شکایت از دشواری‌ها، باید صبر کرد، زیرا صبر کلید گشایش و رهایی از مشکلات است."],[943,"این کلید صبر را اکنون چه شد","ای عجب منسوخ شد قانون چه شد","عجب است که آن کلید صبر که می‌گفتیم، حالا چه شده است و چرا این قاعده از بین رفته است."],[943,"ما نمی‌گفتیم که اندر کش مکش","اندر آتش هم‌چو زر خندید خوش","ما نمی‌گفتیم که در شرایط سخت و درگیری‌ها، مانند طلا که در آتش خندیده و به زیور تبدیل می‌شود، خوشحال و خندان باشیم."],[943,"مر سپه را وقت تنگاتنگ جنگ","گفته ما که هین مگردانید رنگ","در زمان جنگ و در لحظات بحرانی و دشوار، سپاه را به این نکته هشدار می‌دهند که نترسند و رنگ نباختند، بلکه باید با عزت و قدرت به جنگ ادامه دهند."],[943,"آن زمان که بود اسپان را وطا","جمله سرهای بریده زیر پا","در آن زمان که اسبان، وطن خود را ترک کرده بودند، همگی سرهای بریده را زیر پا داشتند."],[943,"ما سپاه خویش را هی هی کنان","که به پیش آیید قاهر چون سنان","ما سپاه خود را با فریاد و هیاهو به جلو فرا می‌خوانیم، چون سنان (نیزه) که قاهر و مسلط است."],[943,"جمله عالم را نشان داده به صبر","زانک صبر آمد چراغ و نور صدر","عالم (دانش) به ما آموخته است که باید صبر کنیم، زیرا صبر همچون چراغ و نوری است که در دل انسان قرار می‌گیرد."],[943,"نوبت ما شد چه خیره‌سر شدیم","چون زنان زشت در چادر شدیم","اکنون نوبت ما است که به بی‌خبری و نادانی دچار شده‌ایم، مانند زنانی که زشت‌اند و در چادر پنهان شده‌اند."],[943,"ای دلی که جمله را کردی تو گرم","گرم کن خود را و از خود دار شرم","ای دل عزیز، تو که به همه دیگران محبت و گرمی نشان دادی، حالا خودت را هم گرم کن و از خودت خجالت بکش."],[943,"ای زبان که جمله را ناصح بدی","نوبت تو گشت از چه تن زدی","ای زبان، تو هم که همواره تمام مردم را نصیحت می‌کردی، حالا چرا از نصیحت کردن خودداری می‌کنی و عذر می‌خواهی؟"],[943,"ای خرد کو پند شکرخای تو","دور تست این دم چه شد هیهای تو","ای خرد، کجاست نصیحت شیرین تو؟ اکنون که صدای تو دور از دسترس است، چرا این طور بی‌صدا و بی‌فکر مانده‌ای؟"],[943,"ای ز دلها برده صد تشویش را","نوبت تو شد بجنبان ریش را","ای کسی که به دل‌ها صد نگرانی را گرفته‌ای، حالا نوبت تو است که ریش خود را حرکت دهی و به خودت رسیدگی کنی."],[943,"از غری ریش ار کنون دزدیده‌ای","پیش ازین بر ریش خود خندیده‌ای","اگر اکنون ریش را دزدیده‌ای و نگران هستی، پیش از این بر ریش خود می‌خندیدی و به آن نمی‌پرداختی."],[943,"وقت پند دیگرانی های های","در غم خود چون زنانی وای وای","زمانی که دیگران را نصیحت می‌کنی و پند می‌دهی، خودت در عذاب و غم هستی مثل زنانی که در حال ناله و زاری هستند."],[943,"چون به درد دیگران درمان بدی","درد مهمان تو آمد تن زدی","اگر به درد دیگران درمانی ارائه کردی، درد خودت را فراموش کن و به آن نمی‌پردازی."],[943,"بانگ بر لشکر زدن بد ساز تو","بانگ بر زن چه گرفت آواز تو","وقتی صدای تو به لشکر می‌رسد، بیان و لحن تو به خوبی نشان‌دهنده‌ی کارهای بد توست، پس چرا بر زنان ناراحت می‌زنی و فریاد می‌کنی؟"],[943,"آنچ پنجه سال بافیدی به هوش","زان نسیج خود بغلتانی بپوش","آنچه که در طول پنجاه سال گذشته با دقت و هوشیاری بافته‌ای، اکنون از در هم پیچیدن آن محافظت کن و به آن بپرداز."],[943,"از نوایت گوش یاران بود خوش","دست بیرون آر و گوش خود بکش","از صدای دلنشین تو، دوستان به وجد می‌آیند؛ بنابراین، دستت را از کارهای بی‌فایده کنار بکش و توجه خود را به سخنان و صدای خود متمرکز کن."],[943,"سر بدی پیوسته خود را دم مکن","پا و دست و ریش و سبلت گم مکن","همیشه خود را در گوشه‌ای از آرامش و سکون نگه‌دار و تلاش نکن که سر و دست و ریش و موهای خود را به هم بریزی یا به هم بزنید."],[943,"بازی آن تست بر روی بساط","خویش را در طبع آر و در نشاط","بازی‌ای که بر روی زمین خودت می‌کنی، آن را در طبیعت و روحی شاداب جاری کن."],[944,"پادشاهی مست اندر بزم خوش","می‌گذشت آن یک فقیهی بر درش","پادشاهی که مست شده بود، در مجلس خوش می‌گذرانید و آن فقیه (دانشمند) در درگاه او بود."],[944,"کرد اشارت کش درین مجلس کشید","وان شراب لعل را با او چشید","ساقی به پادشاه اشاره کرد و در این مجلس شراب لعل (سرخ) را به او عرضه کرد تا او آن را بچشد."],[944,"پس کشیدندش به شه بی‌اختیار","شست در مجلس ترش چون زهر و مار","او را ناخواسته و با زور به پیش پادشاه آوردند، در حالی که در مجلس با طعمی تلخ و زننده مانند زهر و مار روبه‌رو بود."],[944,"عرضه کردش می نپذرفت او به خشم","از شه و ساقی بگردانید چشم","دانشمند به دلیل خشم از پادشاه و ساقی، شراب را نپذیرفت و چشمش را از آن‌ها برگرفت."],[944,"که به عمر خود نخوردستم شراب","خوشتر آید از شرابم زهر ناب","من در طول عمرم هرگز نوشیدنی خوشمزه‌ای نخورده‌ام که برایم از زهر ناب بهتر باشد."],[944,"هین به جای می به من زهری دهید","تا من از خویش و شما زین وا رهید","اینجا شخصی از شراب خوشی که به او داده‌اند، درخواست زهر می‌کند تا از حالت عادی و افکار خود و دیگران رها شود و از آن وضعیت رنج‌آور خارج گردد."],[944,"می نخورده عربده آغاز کرد","گشته در مجلس گران چون مرگ و درد","دانشمند که می‌خواست شراب بنوشد، بر اثر فشارهای ناشی از تنش و ناگزیری، به عربده‌کشی و جنجال پرداخت و حالتی سنگین و خفقانی مانند مرگ و درد در مجلس ایجاد کرد."],[944,"هم‌چو اهل نفس و اهل آب و گل","در جهان بنشسته با اصحاب دل","انسان‌ها به مانند کسانی که فقط جسم و مادیات را می‌شناسند (اهل نفس و اهل آب و گل) در این دنیا با کسانی که دل و معنویت را درک می‌کنند (اصحاب دل) زندگی می‌کنند."],[944,"حق ندارد خاصگان را در کمون","از می احرار جز در یشربون","خاصان و برگزیدگان حق ندارند در جمع خود از شراب آزاد بسیار بنوشند، مگر آن‌که مانند افرادی که در جمع‌های دیگر می‌نوشند، در حالتی شاد و شگفت‌آور باشند."],[944,"عرضه می‌دارند بر محجوب جام","حس نمی‌یابد از آن غیر کلام","محجوب (یعنی کسی که از حقیقت دور است) نمی‌تواند از جامی که به او عرضه می‌شود، احساس کند و تنها به کلام و گفتار تکیه می‌کند."],[944,"رو همی گرداند از ارشادشان","که نمی‌بیند به دیده دادشان","دانشمند به دلیل نداشتن درک و شعور به راهنمایی‌های دیگران توجه نمی‌کند و نمی‌تواند آنچه را که به او عرضه می‌شود، ببیند و درک کند."],[944,"گر ز گوشش تا به حلقش ره بدی","سر نصح اندر درونشان در شدی","اگر تو بتوانی از طریق گوش او تا حلقش راهی باز کنی و نصیحتی در دلش بنگاری، او را به هدایت رهنمون خواهی شد."],[944,"چون همه نارست جانش نیست نور","که افکند در نار سوزان جز قشور","اگر جان انسان درست نباشد، به مانند نوری نیست که بتواند در آتش سوزان بیفتد؛ بنابراین آنچه باقی می‌ماند فقط ظاهر و قشری است."],[944,"مغز بیرون ماند و قشر گفت رفت","کی شود از قشر معده گرم و زفت","مغز یعنی درون و حقیقت چیزی باقی ماند و پوست و ظاهر رفت؛ حالا سوال این است که چگونه می‌توان از پوست، معده‌ای گرم و چرب به‌دست آورد؟"],[944,"نار دوزخ جز که قشر افشار نیست","نار را با هیچ مغزی کار نیست","آتش دوزخ فقط برای عذاب سطحی بدن (قشر) انسان است و با وجود مغز و عقل ارتباطی ندارد. آتش هیچ تأثیری بر اندیشه و فطرت انسان ندارد."],[944,"ور بود بر مغز ناری شعله‌زن","بهر پختن دان نه بهر سوختن","اگر شعله‌ای بر مغز آتش‌ناری باشد، هدفش پختن و آماده کردن دانش است، نه اینکه فقط برای سوزاندن باشد."],[944,"تا که باشد حق حکیم این قاعده","مستمر دان در گذشته و نامده","این بیت به این معناست که حکمت و حقیقت همواره و در همه زمان‌ها پایدار است و نه‌تنها در گذشته وجود داشته، بلکه در آینده نیز ادامه خواهد داشت."],[944,"مغز نغز و قشرها مغفور ازو","مغز را پس چون بسوزد دور ازو","محتوای عمیق و واقعی انسان که همان «مغز» یا جوهر اوست، در دنیای مادی و ظاهری (قشرها) پنهان و فراموش شده است. وقتی این جوهر به آتش یا آزمایش‌های سخت بیفتد، خود را نمایان می‌کند و از ظواهر دور می‌شود."],[944,"از عنایت گر بکوبد بر سرش","اشتها آید شراب احمرش","اگر خدا بخواهد و بر سر او بکوبند، او به شراب سرخ میل و اشتیاق پیدا می‌کند."],[944,"ور نکوبد ماند او بسته‌دهان","چون فقیه از شرب و بزم این شهان","اگر شاه او را مورد ضرب و فشار قرار ندهد، او مانند یک فقیه که از نوشیدنی و مجالس این بزرگان دوری می‌کند، ساکت و بی‌حرکت باقی می‌ماند."],[944,"گفت شه با ساقیش ای نیک‌پی","چه خموشی ده به طبعش آر هی","پادشاه به ساقی گفت: ای نیک‌اخلاق، چرا خاموش هستی؟ او را به حال خود واگذار و بنوشاند."],[944,"هست پنهان حاکمی بر هر خرد","هرکه را خواهد به فن از سر برد","حاکمی پنهان وجود دارد که بر هر دانش و خرد تسلط دارد و هر کسی را که بخواهد، با مهارت و زیرکی از میدان بیرون می‌کند."],[944,"آفتاب مشرق و تنویر او","چون اسیران بسته در زنجیر او","آفتاب و نور او مانند کسانی هستند که در زنجیر بسته شده‌اند و اسیرند. این تعبیر نشان می‌دهد که نور و روشنی او با وجود عظمتش، در اختیار و کنترل او قرار دارد و به همین دلیل نمی‌تواند آزادانه بتابد."],[944,"چرخ را چرخ اندر آرد در زمن","چون بخواند در دماغش نیم فن","چرخ، یعنی زندگی و زمان، زمانی به گردش درمی‌آید که انسان توانایی و هنر لازم را داشته باشد، و این توانایی باید در ذهن او وجود داشته باشد."],[944,"عقل کو عقل دگر را سخره کرد","مهره زو دارد ویست استاد نرد","عقل، عقل دیگری را تمسخر می‌کند و می‌گوید که او خود را در این بازی نرد (بازی تخته نرد) استاد می‌داند."],[944,"چند سیلی بر سرش زد گفت گیر","در کشید از بیم سیلی آن زحیر","ساقی چند بار با شدت بر سر دانشمند ضربه زد و به او گفت تا زمانی که شراب را در دست بگیرد و بنوشد، نترس و از ضربه‌ها بترس."],[944,"مست گشت و شاد و خندان شد چو باغ","در ندیمی و مضاحک رفت و لاغ","او (دانشمند) مست و شاد و خندان شد، همان‌طور که باغ در بهار و در کنار دوستان و اهل شوخی و مزاح شاداب می‌شود."],[944,"شیرگیر و خوش شد انگشتک بزد","سوی مبرز رفت تا میزک کند","دانشمند در حال نوشیدن شراب به شدت شاد و سرحال شده و انگشتش را به نشانه خوشحالی به سمت کنیزک زیبا که در تالار نشسته است، دراز می‌کند و به او می‌نگرد تا از زیبایی‌اش بهره‌مند شود."],[944,"یک کنیزک بود در مبرز چو ماه","سخت زیبا و ز قرناقان شاه","یک دختر کنیز در میان جمعی بود که مانند ماه زیبا بود و از نظر زیبایی به دختری که از نسل شاهان است، شبیه بود."],[944,"چون بدید او را دهانش باز ماند","عقل رفت و تن ستم‌پرداز ماند","وقتی او (دانشمند) کنیزک را دید، دهانش باز ماند و عقلش از دست رفت، به طوری که جسمش گرفتار حسرت و ظلم شد."],[944,"عمرها بوده عزب مشتاق و مست","بر کنیزک در زمان در زد دو دست","عشق و آرزوی بسیاری از جوانان در طول عمرشان، به طور خاص برای یک کنیزک بوده و در این زمان، با شوق و هیجان، دو دست خود را به سوی او دراز کرده‌اند."],[944,"بس طپید آن دختر و نعره فراشت","بر نیامد با وی و سودی نداشت","دختر به شدت به خود می‌پیچید و فریاد می‌زد، اما هیچ واکنشی از خود نشان نداد و برای او هیچ فایده‌ای نداشت."],[944,"زن به دست مرد در وقت لقا","چون خمیر آمد به دست نانبا","زن در لحظه ملاقات با مرد، مانند خمیر در دست نانوا است که شکل می‌گیرد و تغییر می‌کند."],[944,"بسرشد گاهیش نرم و گه درشت","زو بر آرد چاق چاقی زیر مشت","در اینجا گفته شده که زمانی که چاقو بر روی گوشت نرم می‌خورد، گوشت به نرمی برش می‌خورد و در مواقع دیگر که فشار بیشتری به آن وارد می‌شود، ممکن است به سختی و با زحمت جدا شود. این توصیف به نوعی مقایسه‌ای است از حالات مختلف و تأثیرات فردی بر یک دیگر."],[944,"گاه پهنش واکشد بر تخته‌ای","درهمش آرد گهی یک لخته‌ای","گاهی جسم انسان به صورت دراز و پهن بر تخته‌ای کشیده می‌شود و گاهی هم به طور ناهموار و بی‌نظم در می‌آید، به صورتی که قسمتی از آن یکجا لخته می‌شود."],[944,"گاه در وی ریزد آب و گه نمک","از تنور و آتشش سازد محک","گاهی در این دنیا، انسان‌ها مانند آردی هستند که در آن آب و گاهی نمک می‌ریزند؛ این یعنی زندگی‌شان گاهی با sweetness (شیرینی) و گاهی با تلخی همراه است و در گرما و سختی‌های زندگی، به محک و آزمایش کشیده می‌شوند."],[944,"این چنین پیچند مطلوب و طلوب","اندرین لعبند مغلوب و غلوب","در این دنیا، چیزی که خواسته و مطلوب است، گاهی به گونه‌ای پیچیده و درهم به دست می‌آید، و در این بازی زندگی، انسان‌ها معمولا تحت تأثیر قرار می‌گیرند و مغلوب می‌شوند."],[944,"این لعب تنها نه شو را با زنست","هر عشیق و عاشقی را این فنست","این بازی تنها خاص مردان نیست؛ هر عشقی و عاشقی باید این هنر را داشته باشد."],[944,"از قدیم و حادث و عین و عرض","پیچشی چون ویس و رامین مفترض","از گذشته و حال، و همچنین از اشیاء و ویژگی‌ها، به شکل و حالتی پیچیده می‌رسیم که مانند داستان ویس و رامین، برخی از آن‌ها تصوری خاص دارند."],[944,"لیک لعب هر یکی رنگی دگر","پیچش هر یک ز فرهنگی دگر","هر بازی و سرگرمی، رنگ و حالتی متفاوت دارد و این تفاوت‌ها ناشی از فرهنگ‌های مختلف است که بر رفتارها و آداب و رسوم افراد تأثیر می‌گذارد."],[944,"شوی و زن را گفته شد بهر مثیل","که مکن ای شوی زن را بد گسیل","به شوهر و زن گفته شده که مانند مثالی که برای زنان پیش آمده، نباید دست به نادرستی بزنند و رفتار بدی داشته باشند."],[944,"آن شب گردک نه ینگا دست او","خوش امانت داد اندر دست تو","در آن شب، آن گردک (دسته‌ای از انگور) را که به خوبی به تو سپرده بود، او (دانشمند) با کمال اطمینان به دست تو داد."],[944,"کانچ با او تو کنی ای معتمد","از بد و نیکی خدا با تو کند","هرآنچه با این شخص معتمد (ولی در زندگی‌ات) انجام دهی، خداوند به همان شکل با تو رفتار خواهد کرد، چه خوب و چه بد."],[944,"حاصل این‌جا این فقیه از بی‌خودی","نه عفیفی ماندش و نه زاهدی","در اینجا بیان می‌شود که این عالم دینی، در حالت مستی و بی‌خودی ناشی از تأثیر شراب نه به عفتش توجهی دارد و نه به زهدش. به عبارتی، او از حالت معمول خود خارج شده و در درک و رفتار دینی‌اش دچار اختلال شده است."],[944,"آن فقیه افتاد بر آن حورزاد","آتش او اندر آن پنبه فتاد","آن فقیه (دانشمند) در برابر آن حورزاد (پادشاه) از شدت شوق و لذت به حالتی افتاده است و آتش عشق او در دلش شعله‌ور شده، مانند آتش که به پنبه می‌افتد و آن را می‌سوزاند."],[944,"جان به جان پیوست و قالب‌ها چخید","چون دو مرغ سربریده می‌طپید","روح آدمی به روح دیگر متصل شد و جسم‌ها مانند دو پرنده‌ای که سر بریده شده‌اند، از هم جدا و بی‌قراری کردند."],[944,"چه سقایه چه ملک چه ارسلان","چه حیا چه دین چه بیم و خوف جان","ساقی، پادشاه، ارسلان (نامی از شخصیت‌های بزرگ)، حیا، دین، و ترس و بیم از جان، همه یکسان و برابر هستند. در واقع، اینها همه مقولات و مفاهیمی هستند که در زندگی بشر تاثیرگذارند، اما در نهایت هیچ‌یک نمی‌توانند مانع پیوستن جان به حقیقت یا معنای عمیق‌تر از زندگی شوند."],[944,"چشمشان افتاده اندر عین و غین","نه حسن پیداست این‌جا نه حسین","در اینجا به نظر می‌رسد که بینندگان و حضار در مجلس به جای زیبایی و خوبی، تنها به عیوب و نواقص یکدیگر توجه کرده و حقیقت زیبایی را نمی‌بینند. این عبارات به نوعی اشاره دارد به این که در این فضا، نه زیبایی واقعی (حسن) موجود است و نه ظرافت و لطافت (حسین)."],[944,"شد دراز و کو طریق بازگشت","انتظار شاه هم از حد گذشت","دانشمند که به زور در مجلس نشسته است، متوجه می‌شود که وضع به‌گونه‌ای است که امیدی به بازگشت ندارد و هم‌چنان در انتظار شاه است، و این انتظار او بیش از حد طولانی می‌شود."],[944,"شاه آمد تا ببیند واقعه","دید آن‌جا زلزله القارعه","شاه آمد تا واقعه را ببیند و در آن‌جا زلزله‌ای بزرگ و هولناک را مشاهده کرد."],[944,"آن فقیه از بیم برجست و برفت","سوی مجلس جام را بربود تفت","فقیه از ترس و وحشت به سرعت از جای خود بلند شد و به سمت مجلس رفت و جام را نیز برداشت."],[944,"شه چو دوزخ پر شرار و پر نکال","تشنه خون دو جفت بدفعال","شاه مانند دوزخی سرشار از آتش و آشفتگی است و به شدت تشنه خون افرادی است که فعالیت‌های بدی دارند."],[944,"چون فقیهش دید رخ پر خشم و قهر","تلخ و خونی گشته هم‌چون جام زهر","وقتی دانشمند (فقیه) دید چهره پادشاه پر از خشم و کینه شده و مانند جام زهر تلخ و بدجنس است، متوجه شد که او در شرایط بدی قرار دارد."],[944,"بانگ زد بر ساقیش که ای گرم‌دار","چه نشستی خیره ده در طبعش آر","شاه به ساقی دستور می‌دهد که بی‌چاره دانشمند را با نوشیدنی گرم و قوی بیدار کند و او را از حالت خموشی خارج کند."],[944,"خنده آمد شاه را گفت ای کیا","آمدم با طبع آن دختر ترا","شاه از تحقیر و رفتار نامناسب او درباره دختر طبع و مزاج او را به یاد می‌آورد و به او می‌گوید که با طبع دختر می‌توانست به راحتی بنشیند و لذت ببرد."],[944,"پادشاهم کار من عدلست و داد","زان خورم که یار را جودم بداد","من پادشاهی هستم که کار من بر اساس عدالت و انصاف است و از این‌روست که به یار خود بخشش می‌کنم."],[944,"آنچ آن را من ننوشم هم‌چو نوش","کی دهم در خورد یار و خویش و توش","من هیچ‌گاه چیزی نمی‌نوشم که برایم خوشایند نباشد، پس چگونه می‌توانم آن را به دیگران بدهیم تا بنوشند؟"],[944,"زان خورانم من غلامان را که من","می‌خورم بر خوان خاص خویشتن","من منبع برکات و نعمت‌ها برای بنده‌هایم هستم، زیرا من از خوراکی‌های خاص خودم بر سر سفره‌ام می‌خورم."],[944,"زان خورانم بندگان را از طعام","که خورم من خود ز پخته یا ز خام","من به بنده‌هایم از غذایی می‌دهم که خودم از آن می‌خورم، چه پخته باشد و چه خام."],[944,"من چو پوشم از خز و اطلس لباس","زان بپوشانم حشم را نه پلاس","من وقتی لباس‌های گرانبها از خز و اطلس می‌پوشم، از آن لباس‌ها به خدمه‌ام چیزی نمی‌دهم جز یک پارچه نازک و ساده."],[944,"شرم دارم از نبی ذو فنون","البسوهم گفت مما تلبسون","من از نبی، یعنی پیامبر که دارای فضائل و علم بسیار است، شرم دارم و می‌گویم به آنان که با این لباس‌ها (خز و اطلس) زینت می‌یابند، بگویید که از همان چیزی بپوشانید که خودتان می‌پوشید."],[944,"مصطفی کرد این وصیت با بنون","اطعموا الاذناب مما تاکلون","محمد (مصطفی) این وصیت را کرده است که به فرزندان خود بگویید: «به افراد دیگر از خوراکی‌هایی که می‌خورید، بدهید.» این توصیه به نیکی و مهربانی با دیگران اشاره دارد."],[944,"دیگران را بس به طبع آورده‌ای","در صبوری چست و راغب کرده‌ای","تو دیگران را با طبع و خویشتن‌داری تربیت کرده‌ای و آنها را به صبر و استقامت تشویق کرده‌ای."],[944,"هم به طبع‌آور بمردی خویش را","پیشوا کن عقل صبراندیش را","برای اینکه بتوانی دیگران را به صبر و استقامت دعوت کنی، ابتدا خودت باید به قدرت شخصی‌ات آگاه باشی و با عقل و درایت، بر صبر خود تسلط پیدا کنی."],[944,"چون قلاووزی صبرت پر شود","جان به اوج عرش و کرسی بر شود","زمانی که صبر و حوصله‌ات به حد کافی و فراوان برسد، روح و جانت به مرتبه‌ای بالا و والاتر از عرش و کرسی خواهد رسید."],[944,"مصطفی بین که چو صبرش شد براق","بر کشانیدش به بالای طباق","مصطفی را مشاهده کن که صبر والای او شد مرکبی که او را به معراج با خداوند برد."],[945,"این بگفتند و روان گشتند زود","هر چه بود ای یار من آن لحظه بود","آن‌ها این را گفتند و به سرعت روانه شدند. هر چیزی که بود، آن لحظه متعلق به تو بود، ای معشوق من."],[945,"صبر بگزیدند و صدیقین شدند","بعد از آن سوی بلاد چین شدند","آن‌ها صبر کردند و راستگو شدند و سپس به سوی سرزمین چین حرکت کردند."],[945,"والدین و ملک را بگذاشتند","راه معشوق نهان بر داشتند","شاهزادگان والدین و پادشاهی را ترک کردند و به راهی رفتند که به عشق و معشوقشان می‌انجامید، هرچند این راه پنهان و دشوار بود."],[945,"هم‌چو ابراهیم ادهم از سریر","عشقشان بی‌پا و سر کرد و فقیر","چون ابراهیم ادهم، شخصی که به خاطر عشق به معشوق از مقام و ثروت خود کنار کشید و فقیر و بی‌چیز شد."],[945,"یا چو ابراهیم مرسل سرخوشی","خویش را افکند اندر آتشی","شخصی مانند ابراهیم خلیل (ابراهیم مرسل) که خوشی‌های خود را به خاطر عشق حقیقی و در راه خدای خود به آتش می‌اندازد، یعنی تمامی لذت‌ها و خوشی‌های دنیوی را رها می‌کند."],[945,"یا چو اسمعیل صبار مجید","پیش عشق و خنجرش حلقی کشید","چنان که اسماعیل، پسر ابراهیم، در برابر عشق و فداکاری صبوری نشان داد و خود را با خنجری که در دست داشت به قربانی کردن آماده کرد."],[946,"امرء القیس از ممالک خشک‌لب","هم کشیدش عشق از خطه عرب","امرء القیس، شاعر عرب و پادشاهی معروف، به خاطر عشقش از سرزمین‌های خشک و بی‌آب و علف بیرون رفته و به دنبال محبوبش در سرزمینی دیگر رفته است."],[946,"تا بیامد خشت می‌زد در تبوک","با ملک گفتند شاهی از ملوک","امرء القیس به تبوک، که یکی از شهرهای عربستان است، رفت و در آنجا در حال تعمیر یک دیوار است و به همین دلیل او را به عنوان یکی از پادشاهان مشهور ملوک معرفی کردند."],[946,"امرء القیس آمدست این‌جا به کد","در شکار عشق و خشتی می‌زند","امرء القیس به اینجا آمده تا در جستجوی عشق باشد و در این راه از سنگ‌ریزه‌ها (خشتی) برمی‌دارد، یعنی در پی تجربه‌های عشق و احساسات خود است."],[946,"آن ملک برخاست شب شد پیش او","گفته او را ای ملیک خوب‌رو","آن پادشاه در شب از خواب بیدار شد و به پیش او، یعنی امرء القیس، گفت: ای پادشاه زیبا!"],[946,"یوسف وقتی دو ملکت شد کمال","مر ترا رام از بلاد و از جمال","یوسف که در زمان خود به زیبایی و کمال شناخته می‌شد، حالا تو را به خاطر زیبایی‌ات از کشورهای مختلف وافراد به خود جلب می‌کند."],[946,"گشته مردان بندگان از تیغ تو","وان زنان ملک مه بی‌میغ تو","مردان به خاطر شمشیر تو برده و زیر سلطه‌ تو شده‌اند و زنان به خاطر زیبایی و کمال تو به تو عشق می‌ورزند."],[946,"پیش ما باشی تو بخت ما بود","جان ما از وصل تو صد جان شود","حضور تو باعث خوشبختی ماست و جان ما، به خاطر وصل با تو، چنان افزایش می‌یابد که گویی صد جان داریم."],[946,"هم من و هم ملک من مملوک تو","ای به همت ملک‌ها متروک تو","من و مملکت و دارایی‌ام همه در اختیار تو هستیم، ای کسی که به خاطر عزم و همت تو، پادشاهان دیگر فراموش شده‌اند."],[946,"فلسفه گفتش بسی و او خموش","ناگهان وا کرد از سر روی‌پوش","امرء القیس که در اینجا به سخنرانی و فلسفه پرداخته، ناگهان ساکت می‌شود و به دلیل کارهای خود، سرپوشش را برمی‌دارد. این نشان‌دهنده یک تغییر ناگهانی در حالت اوست."],[946,"تا چه گفتش او به گوش از عشق و درد","هم‌چو خود در حال سرگردانش کرد","او در حال سرگردانی به خاطر عشق و دردهایی که دارد، از صحبت‌های طرف مقابلش چیزی نشنیده و متوجه نمی‌شود که آن شخص چه می‌گوید."],[946,"دست او بگرفت و با او یار شد","او هم از تخت و کمر بیزار شد","او دست شخصی را گرفت و همراه او شد، و خود نیز از تخت و قدرتش برید و دوری جست."],[946,"تا بلاد دور رفتند این دو شه","عشق یک کرت نکردست این گنه","این دو عاشق که به سرزمین‌های دور سفر کردند، هرگز در این مسیر توجهی به گناه خود نکردند."],[946,"بر بزرگان شهد و بر طفلانست شیر","او بهر کشتی بود من الاخیر","او (امرء القیس) به بزرگ‌ترها محبت و نیکی می‌دهد و مانند شیر برای کودکان است. در حقیقت، او در زندگی‌اش برای هر کسی که به او نیاز دارد، مانند شیر، منبع صفا و محبت است."],[946,"غیر این دو بس ملوک بی‌شمار","عشقشان از ملک بربود و تبار","غیر از این دو (امرء القیس و یوسف)، شاهان بی‌شماری وجود دارند که عشقشان باعث شده آنها از سلطنت و خاندانی خود دور شوند و به بی‌سرنوشتی بیفتند."],[946,"جان این سه شه‌بچه هم گرد چین","هم‌چو مرغان گشته هر سو دانه‌چین","جان این سه فرزند پادشاه هم مانند پرندگانی شده که برای پیدا کردن دانه به هر سو پرواز می‌کنند و به دنبال تغذیه خود هستند."],[946,"زهره نی تا لب گشایند از ضمیر","زانک رازی با خطر بود و خطیر","زهره (دلیری یا شهامت) تا وقتی که چیزی را بروز دهد، نباید لب به سخن بگشاید، چرا که فاش کردن رازی ممکن است با خطر همراه باشد و عواقب جدی به دنبال داشته باشد."],[946,"صد هزاران سر بپولی آن زمان","عشق خشم آلوده زه کرده کمان","در آن زمان بسیار دل‌ها به خاطر عشق به خشم آمده‌اند و مانند تیرهایی که از کمان رها شده‌اند، درد و رنج ایجاد کرده‌اند. عشق در اینجا به شکل عاطفی پرقدرت و گاه خطرناک توصیف شده است."],[946,"عشق خود بی‌خشم در وقت خوشی","خوی دارد دم به دم خیره‌کشی","عشق واقعی در زمان خوشی از خشم و کینه دور است و به محبت می‌پردازد، اما در هر لحظه ممکن است که موجب افسردگی و غم شود."],[946,"این بود آن لحظه کو خشنود شد","من چه گویم چونک خشم‌آلود شد","این لحظه‌ای بود که او (امرء القیس) خشنود و راضی شد، اما وقتی که او به خشم درآمد، من دیگر چه بگویم؟"],[946,"لیک مرج جان فدای شیر او","کش کشد این عشق و این شمشیر او","اما جان من فدای آن شیر (عشق)، زیرا این عشق و این شمشیر او را می‌کشد و به بازی می‌گیرد."],[946,"کشتنی به از هزاران زندگی","سلطنت‌ها مرده این بندگی","مردن برای آزادی و حقیقت بهتر از هزاران زندگی در سلطنت و قدرت است؛ زیرا بندگی و اسارت ارزش ندارد."],[946,"با کنایت رازها با هم‌دگر","پست گفتندی به صد خوف و حذر","رازها به صورت مکنون و با کنایه در میان هم، به گونه‌ای که از ترس و احتیاط بیان می‌شد."],[946,"راز را غیر خدا محرم نبود","آه را جز آسمان هم‌دم نبود","هیچ‌کس جز خدا درک نمی‌کند که رازها در دل انسان چه می‌گذرد، و تنها آسمان می‌تواند دردی را که در دل است، بفهمد."],[946,"اصطلاحاتی میان هم‌دگر","داشتندی بهر ایراد خبر","میان همدیگر اصطلاحاتی وجود داشت که برای بیان خبر به کار می‌رفت."],[946,"زین لسان الطیر عام آموختند","طمطراق و سروری اندوختند","زبان پرندگان را از این گونه افرادی (مانند امرء القیس) یاد گرفتند و در نتیجه، جلال و بزرگی نصیب خود کردند."],[946,"صورت آواز مرغست آن کلام","غافلست از حال مرغان مرد خام","شعر به این نکته اشاره دارد که کلام یا شعر زیبا و دلنواز در واقع تنها مانند آواز پرندگان است و افراد ناآگاه نمی‌دانند که این کلمات از احساسات و حالات واقعی مرغان (پرندگان) نشأت نمی‌گیرد و نویسندۀ آن (مرد خام) درک عمیق و واقعی از این مضامین ندارد."],[946,"کو سلیمانی که داند لحن طیر","دیو گرچه ملک گیرد هست غیر","کجا سلیمانی پیدا می‌شود که صدای پرندگان را بداند؟ دیوانگی و شیطنت اگر چه قدرت دارد، اما از علم واقعی و شناخت خبری ندارد."],[946,"دیو بر شبه سلیمان کرد ایست","علم مکرش هست و علمناش نیست","دیوانگی بر شبیه سلیمان ایستاده است، زیرا علم مکر و فریب دارد، اما علم حقیقت و دانش آن‌چنان که باید، ندارد."],[946,"چون سلیمان از خدا بشاش بود","منطق الطیری ز علمناش بود","زمانی که سلیمان از خداوند خوشحال و راضی بود، سخنان پرندگان به‌واسطه علم او بود."],[946,"تو از آن مرغ هوایی فهم کن","که ندیدستی طیور من لدن","تو از آن پرنده آسمانی بیاموز که پرندگانی را که من در اختیار دارم، هرگز ندیده‌ای."],[946,"جای سیمرغان بود آن سوی قاف","هر خیالی را نباشد دست‌باف","در آن طرف قاف، مکان سیمرغ (پرنده افسانه‌ای) وجود دارد و هیچ خیالی نمی‌تواند به راحتی به آنجا برسد یا آن را بسازد. این سخن به این معناست که دسترسی به عالم بالا و حقیقت‌های بزرگ، برای خیالات و تصورات آدمی ممکن نیست."],[946,"جز خیالی را که دید آن اتفاق","آنگهش بعدالعیان افتد فراق","تنها آن خیالی که در زمان اتفاق و رویدادها دیده می‌شود، بعد از ظهور و واقع شدن، به صورت عینی و واقعی به چشم خواهد آمد."],[946,"نه فراق قطع بهر مصلحت","که آمنست از هر فراق آن منقبت","فراق، به خاطر مصلحت و فایده‌ای که دارد، قطع نمی‌شود؛ زیرا در واقع، از هر فراق، ویژگی و فضیلت وجود دارد."],[946,"بهر استبقاء آن روحی جسد","آفتاب از برف یک‌دم درکشد","برای حفظ و نگهداری آن روح، مانند آفتابی است که از برف یک لحظه خود را می‌کشد و دوباره ظهور می‌کند."],[946,"بهر جان خویش جو زیشان صلاح","هین مدزد از حرف ایشان اصطلاح","برای نجات جان خود از آن‌ها، از سخنانشان خوب استفاده کن و به اصطلاحات و آموزه‌هایشان توجه کن و آن‌ها را در جایی دیگر به کار ببر."],[946,"آن زلیخا از سپندان تا به عود","نام جمله چیز یوسف کرده بود","زلیخا، معشوقه یوسف، از تمام عطرها و چیزهای خوشبو، همه را با نام یوسف توصیف کرده بود. به عبارت دیگر، او هر چیزی را که می‌خرید یا استفاده می‌کرد به یاد یوسف و نسبت به او کنایه می‌زد."],[946,"نام او در نامها مکتوم کرد","محرمان را سر آن معلوم کرد","او نامش را در میان نام‌های دیگر پنهان کرده و تنها محرمانش از حقیقت او باخبرند."],[946,"چون بگفتی موم ز آتش نرم شد","این بدی کان یار با ما گرم شد","وقتی گفتی که موم به خاطر آتش نرم و قابل تغییر می‌شود، نشان از آن دارد که عشق و محبت آن یار نیز باعث شده است که ما به شدت تحت تأثیر او قرار بگیریم و گرم شویم."],[946,"ور بگفتی مه برآمد بنگرید","ور بگفتی سبز شد آن شاخ بید","اگر بگویی ماه درآمده است و به آن نگاه کنید، یا بگویی شاخه بید سبز شده است، این هم از زیبایی‌ها و شگفتی‌های طبیعت است."],[946,"ور بگفتی برگها خوش می‌طپند","ور بگفتی خوش همی‌سوزد سپند","اگر بگویی که برگ‌ها با نشاط در حال تپیدن هستند، همچنین اگر بگویی که خوشه‌ها به نیکویی می‌سوزند و می‌سوزند، این حالت‌ها هم شگفت‌انگیز است."],[946,"ور بگفتی گل به بلبل راز گفت","ور بگفتی شه سر شهناز گفت","اگر بر فرض بگویی که گل به بلبل داستانی را گفته است، یا اگر بگویی که پادشاه (شه) درباره زیبایی‌های خود سخن گفته است، این‌همه فقط قصه‌هایی هستند که در واقعیت چیزی جز تصاویر و تمثیلات نیستند."],[946,"ور بگفتی چه همایونست بخت","ور بگفتی که بر افشانید رخت","اگر بگویی که بخت او چقدر خوش‌اقبالی است، و اگر بگویی که او لباسش را به زیبایی بر تن افکنده است."],[946,"ور بگفتی که سقا آورد آب","ور بگفتی که بر آمد آفتاب","اگر بگویی که آب‌آور (سقا) آب آورد، یا بگویی که آفتاب طلوع کرد، در واقع هیچ فرقی ندارد."],[946,"ور بگفتی دوش دیگی پخته‌اند","یا حوایج از پزش یک لخته‌اند","اگر بگویی که دیشب غذایی پخته‌اند یا نیازهای زندگی از پزش (پزش، معکوس پزشکی و پزشکی) کمی تأمین شده است."],[946,"ور بگفتی هست نانها بی‌نمک","ور بگفتی عکس می‌گردد فلک","اگر بگویی که نان‌ها بدون نمک هستند و اگر بگویی که فلک (آسمان) به صورت معکوس می‌چرخد، باز هم بی‌فایده است و دردی را درمان نمی‌کند."],[946,"ور بگفتی که به درد آمد سرم","ور بگفتی درد سر شد خوشترم","اگر بگویی که سر من به درد آمده، و اگر بگویی درد سر برای من خوشایندتر است، در هر دو صورت من به درد و رنج خود اهمیت نمی‌دهم و آن را بهترین حالت می‌دانم."],[946,"گر ستودی اعتناق او بدی","ور نکوهیدی فراق او بدی","اگر از او در مدح و ستایش سخن بگویی، به خوبی از او به یاد خواهی آمد، و اگر او را نکوهش کنی به خاطر جدایی‌اش، نیز به خوبی از او به یاد خواهی آمد."],[946,"صد هزاران نام گر بر هم زدی","قصد او و خواه او یوسف بدی","هرچقدر هم که نام‌های مختلف را بر هم بیاوری و در جستجوی او باشی، باز هم در نهایت، او همان یوسف است که به دنبال او هستی."],[946,"گرسنه بودی چو گفتی نام او","می‌شدی او سیر و مست جام او","زمانی که گرسنه بودی و نام او (یوسف) را به زبان می‌آورده‌ای، به طوری که او سیر و خوشحال می‌شدی و انگار آن نام، همچون جامی تو را سیراب می‌کرد."],[946,"تشنگیش از نام او ساکن شدی","نام یوسف شربت باطن شدی","عطش و تشنگی او با یاد نام یوسف آرام گرفت، نام یوسف مانند نوشیدنی‌ای است که جان و باطن را سیراب می‌کند."],[946,"ور بدی دردیش زان نام بلند","درد او در حال گشتی سودمند","اگر او به خاطر آن نام بزرگ دردی داشته باشد، همین درد در حال حاضر برایش مفید خواهد بود."],[946,"وقت سرما بودی او را پوستین","این کند در عشق نام دوست این","در زمانی که فصل سرما بود، او به خاطر عشق به نام دوستش، پوستینی به تن کرد. این نشان می‌دهد که عشق می‌تواند ما را وادار کند تا به سختی‌ها و مشکلات بی‌توجه باشیم و به خاطر محبوب، خود را مجهز کنیم."],[946,"عام می‌خوانند هر دم نام پاک","این عمل نکند چو نبود عشقناک","هر کسی به طور مداوم نام خدا را با صدای بلند می‌خواند، اما اگر به عشق واقعی او نرسیده باشد، این عمل برای او فاقد ارزش است."],[946,"آنچ عیسی کرده بود از نام هو","می‌شدی پیدا ورا از نام او","آنچه عیسی (ع) به وسیله نام خدا انجام می‌داد، به واسطه آن نام بر او آشکار می‌شد."],[946,"چونک با حق متصل گردید جان","ذکر آن اینست و ذکر اینست آن","وقتی انسان به خدا نزدیک می‌شود، جان او به یاد خدا می‌افتد و یاد خدا همان یاد خود او است."],[946,"خالی از خود بود و پر از عشق دوست","پس ز کوزه آن تلابد که دروست","او از خود خالی بود و پر از عشق به دوست، پس حتما آنچه در دلش بود، حقیقت دارد."],[946,"خنده بوی زعفران وصل داد","گریه بوهای پیاز آن بعاد","خنده و شادی بوی زعفرانی را دارد که ناشی از وصلی زیباست، در حالی که گریه و اندوه بوی پیاز را می‌دهد که به یاد ابعاد غم و جدایی برمی‌گردد. در اینجا، عشق و وصل و جدایی به صور مختلفی توصیف شده‌اند."],[946,"هر یکی را هست در دل صد مراد","این نباشد مذهب عشق و وداد","هر فردی در دل خود آرزوهای زیادی دارد، اما این خواسته‌ها و آرزوها به معنای عشق حقیقی و ارتباط واقعی نیستند."],[946,"یار آمد عشق را روز آفتاب","آفتاب آن روی را هم‌چون نقاب","یار برای عشق آمده است، مانند روز روشنی که آفتاب در آن می‌تابد؛ آفتاب، همچون نقابی است که روی زیبای محبوب را می‌پوشاند."],[946,"آنک نشناسد نقاب از روی یار","عابد الشمس است دست از وی بدار","کسی که نتواند پرده (نقاب) را از چهره دوست بشناسد، مانند عابد آفتاب است؛ باید از او دوری جست."],[946,"روز او و روزی عاشق هم او","دل همو دلسوزی عاشق هم او","روز عاشق و روز محبوب یکی است؛ یعنی عاشق و معشوق هر دو به یک اندازه در عشق و محبت سهیم هستند و هر دو دل‌سوز هم هستند."],[946,"ماهیان را نقد شد از عین آب","نان و آب و جامه و دارو و خواب","ماهیان به خاطر زیبایی و جذابیت خود از دیدن آب دور شدند و به جای آن نان و آب و لباس و دارو و خواب را دریافت کردند، که نشان‌دهنده کم‌ارزشی این نعمات است و به نوعی می‌توان اشاره به نادانی موجودات یا انسان‌ها نسبت به اسرار عالم داشته باشد."],[946,"هم‌چو طفلست او ز پستان شیرگیر","او نداند در دو عالم غیر شیر","او مانند کودکی است که فقط از پستان شیر می‌خورد و هیچ‌یک از حقایق دو عالم جز شیر را نمی‌شناسد."],[946,"طفل داند هم نداند شیر را","راه نبود این طرف تدبیر را","طفل فقط می‌داند که باید شیر بخورد و نمی‌داند که چه راهی برای تدبیر و چگونگی آن وجود دارد."],[946,"گیج کرد این گردنامه روح را","تا بیابد فاتح و مفتوح را","این دنیای پیچیده و بی‌ثبات روح انسان را گیج کرده است، تا اینکه او بتواند پیروز و شکست‌خورده را شناسایی کند."],[946,"گیج نبود در روش بلک اندرو","حاملش دریا بود نه سیل و جو","او که در این مرحله گیج و سردرگم نیست، بلکه مانند کشتی‌ای است که در دریا می‌ماند و نه مانند سیل و جریان آب."],[946,"چون بیابد او که یابد گم شود","هم‌چو سیلی غرقه قلزم شود","وقتی او (امرء القیس) می‌فهمد چه چیزی را پیدا کرده، در واقع خود را گم می‌کند و مانند سیلی بزرگ در دریا غرق می‌شود."],[946,"دانه گم شد آنگهی او تین بود","تا نمردی زر ندادم این بود","دانه‌ای گم شد و او هم به آن حالت دچار شد؛ تا زمانی که نمردی، از من چیزی نگرفتی و این حالت همین‌طور ماند."],[947,"آن بزرگین گفت ای اخوان من","ز انتظار آمد به لب این جان من","آن بزرگ گفت: ای برادران، من از شدت انتظار به حدی رسیده‌ام که دیگر طاقت ندارم و جانم به لبم آمده است."],[947,"لا ابالی گشته‌ام صبرم نماند","مر مرا این صبر در آتش نشاند","دیگر برای من مهم نیست و نمی‌توانم صبر کنم، زیرا این صبر مثل آتشی در وجود من شعله‌ور شده است."],[947,"طاقت من زین صبوری طاق شد","راقعه من عبرت عشاق شد","تحمل من از این صبر به پایان رسید و داستان من، به عنوان نشانه‌ای برای دیگر عاشقان، عبرتی شد."],[947,"من ز جان سیر آمدم اندر فراق","زنده بودن در فراق آمد نفاق","به خاطر دوری و جدایی از محبوب، از زندگی سیر شده‌ام و برایم زنده ماندن در این فراق مانند نفاق و ریاکاری است."],[947,"چند درد فرقتش بکشد مرا","سر ببر تا عشق سر بخشد مرا","من چقدر از درد دوری او رنج می‌کشم، اما اگر مرگ به سراغم بیاید، عشق حقیقی باعث می‌شود که جانم دوباره از سر زنده شود."],[947,"دین من از عشق زنده بودنست","زندگی زین جان و سر ننگ منست","عشق برای من مثل دین و اعتقادی است که باعث زنده بودنم می‌شود؛ در حالی که زندگی بدون آن برای من ننگ و شرم است."],[947,"تیغ هست از جان عاشق گردروب","زانک سیف افتاد محاء الذنوب","عشق و دلدادگی، مانند تیغی است که از جان عاشق برمی‌خیزد و هر گناه و معصیتی را پاک و محو می‌کند."],[947,"چون غبار تن بشد ماهم بتافت","ماه جان من هوای صاف یافت","وقتی که غبار تن (جسم) از بین رفت، آن‌گاه ماه جان من (روح) درخشید و از قضا آن روشنایی، فضای صاف و پاکی را به دست آورد."],[947,"عمرها بر طبل عشقت ای صنم","ان فی موتی حیاتی می‌زنم","عشق تو، ای معشوق، باعث شده که عمرها همچون طبل به صدا درآید؛ من در مرگم، زنده هستم و از عشق تو زندگی می‌کنم."],[947,"دعوی مرغابئی کردست جان","کی ز طوفان بلا دارد فغان","کسی که ادعای پرنده‌واره‌ای می‌کند، نمی‌داند که جان او در طوفان بلا در حال ناله است."],[947,"بط را ز اشکستن کشتی چه غم","کشتی‌اش بر آب بس باشد قدم","غم و اندوه کشتی در آب، ناشی از این است که بط (پرنده‌ای که به شناگری معروف است) را زیر آب نمی‌برد؛ پس شکستن کشتی او چه اهمیت و دلیلی دارد. به عبارت دیگر، وقتی کسی به محنتی دچار می‌شود، زیاد به فکر تلاش و زحمت نمی‌افتد، بلکه باید به سرنوشت و آرامش فکر کند."],[947,"زنده زین دعوی بود جان و تنم","من ازین دعوی چگونه تن زنم","جان و جسم من به خاطر این ادعا (دوستی و عشق) زنده است، اما حالا از این ادعا چگونه می‌توانم زندگی را ادامه دهم؟"],[947,"خواب می‌بینم ولی در خواب نه","مدعی هستم ولی کذاب نه","در این بیت، شاعر بیان می‌کند که در خواب چیزی می‌بیند، اما در این خواب نه کسی را برای خود مدعی می‌داند و نه خودش را دروغگو تلقی می‌کند. به عبارتی، او در حالتی از رؤیا به سر می‌برد که در آن، نه خود را دروغین حس می‌کند و نه ادعایی دارد."],[947,"گر مرا صد بار تو گردن زنی","هم‌چو شمعم بر فروزم روشنی","اگر تو صد بار هم مرا بزه‌کاری و مجازات کنی، من همچون شمع هستم که در آتش می‌سوزد و روشنی خود را انتشار می‌دهد."],[947,"آتش ار خرمن بگیرد پیش و پس","شب‌روان را خرمن آن ماه بس","اگر آتش، خرمن را بسوزاند، شب‌روان (شب‌زنده‌داران) باید بدانند که در برابر روشنایی و جمال آن ماه (مقصود، اشاره به محبوب یا معشوق) کارها بی‌ارزش است."],[947,"کرده یوسف را نهان و مختبی","حیلت اخوان ز یعقوب نبی","اخوان یوسف (برادران یوسف) به حیله‌ای یوسف را از دید یعقوب نبی پنهان کردند و او را به دور از چشم پدرش قرار دادند."],[947,"خفیه کردندش به حیلت‌سازیی","کرد آخر پیرهن غمازیی","به وسیله نیرنگ و تدبیری، او را پنهان کردند و درپوشش غم و اندوهی به او لباس نشان‌دار می‌پوشانند."],[947,"آن دو گفتندش نصیحت در سمر","که مکن ز اخطار خود را بی‌خبر","آن دو به او نصیحت کردند که حواس‌ات را جمع کن و از نشانه‌ها و هشدارهای خود غافل نشو."],[947,"هین منه بر ریش‌های ما نمک","هین مخور این زهر بر جلدی و شک","ای برادر، به ریش‌های ما نمک نریزید و بر این جلد ما زهر نپاشید."],[947,"جز به تدبیر یکی شیخی خبیر","چون روی چون نبودت قلبی بصیر","جز با تدبیر و راهنمایی یک شیخ آگاه و باتجربه، قلبی بینا برای درک امور نخواهی داشت."],[947,"وای آن مرغی که ناروییده پر","بر پرد بر اوج و افتد در خطر","این بیت به حالتی اشاره دارد که اگر مرغی (نماد انسان) نتواند پرواز کند و بال‌هایش نشکفته باشد، به اوج نمی‌رسد و در نتیجه در خطر می‌افتد. به عبارتی، کسی که نتواند از پتانسیل‌های خود استفاده کند، در موقعیت‌های سخت و خطرناک قرار می‌گیرد."],[947,"عقل باشد مرد را بال و پری","چون ندارد عقل عقل رهبری","عقل مانند بال و پر برای مرد است و اگر کسی عقل نداشته باشد، مانند پرنده‌ای بدون بال است که نمی‌تواند پرواز کند. عقل، رهبری و هدایت‌کننده انسان است."],[947,"یا مظفر یا مظفرجوی باش","یا نظرور یا نظرورجوی باش","ای کسی که پیروزی را می‌جویی و یا به دنبال جاودانه‌نگری هستی، باید به این دو ویژگی توجه کنی: پیروزی را بیاب و در صدد گرفتن دیدگاه والا و الهی باش."],[947,"بی ز مفتاح خرد این قرع باب","از هوا باشد نه از روی صواب","بدون عقل و درک درست، ورود به این درگاه نتایج خوبی نخواهد داشت و اگر کسی به در این در بیفتد، به دلیل بی‌مبنا بودن است نه به خاطر درستی و صحت."],[947,"عالمی در دام می‌بین از هوا","وز جراحت‌های هم‌رنگ دوا","عالمی در دام را می‌بیند که به خاطر هوا و دل‌باختگی‌اش در تنگنا قرار گرفته است، گرچه این درد و رنجش به ظاهر مشابه درمان است."],[947,"مار استادست بر سینه چو مرگ","در دهانش بهر صید اشگرف برگ","مار در اینجا به معنی خطر است که بر سینه (دل) نشسته و در دهانش که آماده برای حمله است، درپی شکار است. این تصویر به ما نشان می‌دهد که خطر در زندگی ممکن است به طور پنهانی و در کمین باشد، مانند مرگی که در حال نزدیک شدن است."],[947,"در حشایش چون حشیشی او بپاست","مرغ پندارد که او شاخ گیاست","در میان علف‌ها، هنگامی که علفی از خود برپا شده باشد، پرنده خیال می‌کند که آن گیاه، شاخه‌ای از درخت است."],[947,"چون نشیند بهر خور بر روی برگ","در فتد اندر دهان مار و مرگ","وقتی که حشره‌ای بر روی برگ نشسته و مشغول خوردن است، ناگهان به دهان مار می‌افتد و جانش را از دست می‌دهد."],[947,"کرده تمساحی دهان خویش باز","گرد دندانهاش کرمان دراز","تمساح دهانش را باز کرده و دندان‌هایش مانند گیاهانی دراز به نظر می‌رسند."],[947,"از بقیه خور که در دندانش ماند","کرم‌ها رویید و بر دندان نشاند","از باقی‌مانده‌های غذایی که در دندان تمساح مانده بود، کرم‌ها رشد کردند و بر دندان‌های او نشسته‌اند."],[947,"مرغکان بینند کرم و قوت را","مرج پندارند آن تابوت را","پرندگانی که کرم و غذا را می‌بینند، آن تابوت یا پوشش را نشانه‌ی چیزی خوب می‌پندارند. یعنی آن‌ها آنچه را که در واقع به ضررشان است، به‌عنوان چیزی مفید تصور می‌کنند."],[947,"چون دهان پر شد ز مرغ او ناگهان","در کشدشان و فرو بندد دهان","زمانی که دهان تمساح از گوشت مرغ پر می‌شود، ناگهان مرغ‌ها را در کام خود می‌کشد و دهانش را می‌بندد."],[947,"این جهان پر ز نقل و پر ز نان","چون دهان باز آن تمساح دان","این دنیا پر از تغییرات و پر از نعمت‌هاست، مانند تمساحی که وقتی دهانش را باز می‌کند، در جستجوی غذا و طعمه است."],[947,"بهر کرم و طعمه ای روزی‌تراش","از فن تمساح دهر آمن مباش","در این بیت هشدار داده می‌شود که به خاطر لطایف و خوشی‌های زندگی، نباید به خطرات و شیطنت‌های دنیا اعتماد کرد. در واقع باید آگاه بود که دنیا مانند تمساح است که ظاهرش فریبنده است اما می‌تواند خطرناک باشد."],[947,"روبه افتد پهن اندر زیر خاک","بر سر خاکش حبوب مکرناک","گفته می‌شود که زمانی که کسی به زیر خاک می‌رود، در آنجا دانه‌های فریبنده‌ای که مکر و حیله‌گری دارند، روی خاکش می‌روید. این به معنای این است که در دنیای خاکی، خودخواهی و مکر در نهایت پایدارتر از انسان‌ها باقی می‌ماند."],[947,"تا بیاید زاغ غافل سوی آن","پای او گیرد به مکر آن مکردان","زاغی که غافل است، به سوی پای او می‌آید و بر اثر مکر و فریبی که از سوی مکرکشندگان می‌بیند، به دام می‌افتد."],[947,"صدهزاران مکر در حیوان چو هست","چون بود مکر بشر کو مهترست","در دنیا، حیوانات به طور طبیعی و به طور غریزی در کارهایشان فریب و مکر دارند، اما مکر و حیله انسان‌ها، که مقام والاتری دارند، به مراتب پیچیده‌تر و بالاتر است."],[947,"مصحفی در کف چو زین‌العابدین","خنجری پر قهر اندر آستین","زین‌العابدین، یعنی امام زین‌العابدین، کتابی در دست دارد و در حالی که خنجر پر غضب و قهر در آستینش پنهان است، نشان‌دهنده تقابل علم و قدرت و خطراتی است که ممکن است در پشت ظاهری آرام وجود داشته باشد."],[947,"گویدت خندان کای مولای من","در دل او بابلی پر سحر و فن","چنین می‌گوید که کسی با خنده به او (مولای خود) می‌گوید که در دل او، یعنی در وجودش، عواطف و فنون بسیاری مانند سحر و حیله وجود دارد که به نوعی جذاب و شگفت‌انگیز است."],[947,"زهر قاتل صورتش شهدست و شیر","هین مرو بی‌صحبت پیر خبیر","زهر، این ماده کشنده، در واقع به شکل ظاهری‌اش مانند شهد خوشمزه به نظر می‌رسد و مانند شیر شیرین است. بنابراین، ایستادگی کن و از مشاوره کسی که با تجربه و داناست، دوری نکن."],[947,"جمله لذات هوا مکرست و زرق","سوز و تاریکیست گرد نور برق","تمام لذت‌های دنیوی فریبنده و مکررند و مانند آتش سوزانند؛ در حالیکه این لذات، انسان را در تاریکی قرار می‌دهند و نور حقیقت را که همان نور برق است، نمی‌توانند نشان دهند."],[947,"برق نور کوته و کذب و مجاز","گرد او ظلمات و راه تو دراز","برق نور و تابش آن، حقیقی و واقعی نیست و تنها ظاهر فریبی دارد. در واقع، پشت این نور، تاریکی‌ها وجود دارند و مسیر رسیدن به حقیقت بسیار طولانی است."],[947,"نه به نورش نامه توانی خواندن","نه به منزل اسپ دانی راندن","تو نمی‌توانی نامه‌ای را با نور آن (نور حقیقت) بخوانی و نمی‌توانی به مقصدی نیز با اسب خود برانی."],[947,"لیک جرم آنک باشی رهن برق","از تو رو اندر کشد انوار شرق","اگر تو به جرم و گناهی گرفتار شوی، مانند برقی که از تو جدا می‌شود، نور و قدرت معنوی‌ات از بین می‌رود و به جاهای روشن و خوب نخواهی رسید."],[947,"می‌کشاند مکر برقت بی‌دلیل","در مفازه مظلمی شب میل میل","مکر و فریب تو مانند برقی است که بی‌دلیل و ناگهانی در دل تاریکی شب انسان را می‌کشد و به دام می‌افکند."],[947,"بر که افتی گاه و در جوی اوفتی","گه بدین سو گه بدان سوی اوفتی","گاهی به این سو و گاهی به آن سو می‌افتی، به نظر می‌رسد که در مسیر کسی هستی که نمی‌دانی بر چه کسی در حال افتادن هستی."],[947,"خود نبینی تو دلیل ای جاه‌جو","ور ببینی رو بگردانی ازو","ای جاه‌طلب، تو نمی‌توانی از مقام واقعی خود باخبر شوی و حتی اگر نشانه‌هایی از آن را ببینی، به راحتی از آن فاصله می‌گیری."],[947,"که سفر کردم درین ره شصت میل","مر مرا گمراه گوید این دلیل","من در این سفر شصت مایل راه رفته‌ام، اما این نشانه می‌گوید که من گمراه شدم."],[947,"گر نهم من گوش سوی این شگفت","ز امر او راهم ز سر باید گرفت","اگر گوشم را به این شگفتی‌ها بسپارم، برای پیروی از دستور او باید از خودم دست بردارم و از سر خودم کوتاه بیایم."],[947,"من درین ره عمر خود کردم گرو","هرچه بادا باد ای خواجه برو","من در این راه، عمر خود را فدای آن کردم و هرچه پیش آید، پیش آید. ای بزرگوار، برو و با این حال، من به تصمیمم ادامه می‌دهم."],[947,"راه کردی لیک در ظن چو برق","عشر آن ره کن پی وحی چو شرق","تو در مسیر پندار حرکت کردی، اما همانند برقی که در آسمان می‌درخشد، به امید واهی دل بسته‌ای؛ این راه را دنبال کن و بر راستای الهام و وحی حرکت کن، نه در ظن و گمان."],[947,"ظن لایغنی من الحق خوانده‌ای","وز چنان برقی ز شرقی مانده‌ای","تو فقط به گمان می‌روی که به حقیقت رسیده‌ای و در واقع مانند برق درخشان از سمت شرق، فقط در ظاهر دیده می‌شوی ولی در باطن چیزی از حقیقت نداری."],[947,"هی در آ در کشتی ما ای نژند","یا تو آن کشتی برین کشتی ببند","ای نژند (نژند به معنی نیکو و خوب)، به ما بپیوند و در کشتی ما سوار شو، یا تو در این کشتی با ما همراه شو."],[947,"گوید او چون ترک گیرم گیر و دار","چون روم من در طفیلت کوروار","او می‌گوید که اگر به موقع از کار خود عقب‌نشینی کنم، باید به طوری عمل کنم که شایسته باشد. منظور این است که در هنگام رفتن، مانند فردی که چشمش را بسته و بی‌ایا می‌رود، رفتار نکنم."],[947,"کور با رهبر به از تنها یقین","زان یکی ننگست و صد ننگست ازین","همراهی با یک راهنما و راهبر برای نابینایان بهتر از این است که به تنهایی راه بروند، زیرا تنهایی عیب بزرگی محسوب می‌شود و دردسرهای بیشتری به همراه دارد."],[947,"می‌گریزی از پشه در کزدمی","می‌گریزی در یمی تو از نمی","تو از پشه‌ای که در کمین است می‌گریزی، اما در عین حال در دریای بزرگی غرق می‌شوی. به عبارت دیگر، در فرار از مشکلات کوچک به مشکلات بزرگ‌تر گرفتار می‌شوی."],[947,"می‌گریزی از جفاهای پدر","در میان لوطیان و شور و شر","تو از ظلم و بدرفتاری پدرت در میان قوم لوط (که به فساد و ناپاکی مشهور بودند) فرار می‌کنی و می‌خواهی از آن شرایط سخت دور باشی."],[947,"می‌گریزی هم‌چو یوسف ز اندهی","تا ز نرتع نلعب افتی در چهی","تو مانند یوسف از اندوه فرار می‌کنی تا به سختی‌های زندگی دچار نشوی و در چاله‌ای بیفتی."],[947,"در چه افتی زین تفرج هم‌چو او","مر ترا لیک آن عنایت یار کو","تو نیز مانند یوسف در سختی‌ای که به آن دچار شده‌ای، چرا در این دوری و بی‌خبری از یار می‌افتی؟ محبت و لطف یار کجاست که تو به آن امید داشته باشی؟"],[947,"گر نبودی آن به دستوری پدر","برنیاوردی ز چه تا حشر سر","اگر آن دستوری که پدر به تو داده نبود، از چه چیزی تا روز قیامت خبر نمی‌بردی؟"],[947,"آن پدر بهر دل او اذن داد","گفت چون اینست میلت خیر باد","پدر به خاطر عشق او اجازه داد، و گفت که چون میلت این‌گونه است، برایت خیر و نیکی باشد."],[947,"هر ضریری کز مسیحی سر کشد","او جهودانه بماند از رشد","هر نابینایی که از مسیحی دوری کند، مانند یهودی می‌ماند و از راه راست منصرف می‌شود."],[947,"قابل ضو بود اگر چه کور بود","شد ازین اعراض او کور و کبود","اگرچه کور و نابینا بود، اما می‌توانست با نور و روشنایی ارتباط برقرار کند. اکنون به‌دلیل دور شدن از حقیقت، او همچنان کور و آسیب‌دیده مانده است."],[947,"گویدش عیسی بزن در من دو دست","ای عمی کحل عزیزی با منست","عیسی به او می‌گوید دستت را به من بده تا به تو بینایی ببخشم، ای نابینا! زیرا من با تو هستم و به تو کمک می‌کنم."],[947,"از من ار کوری بیابی روشنی","بر قمیص یوسف جان بر زنی","اگر از من مناسبتی نداشته باشی، همچون روشنی که بر پیراهن یوسف (پسر یعقوب) افتاد، به زندگی‌ات جان نخواهم بخشید."],[947,"کار و باری کت رسد بعد شکست","اندر آن اقبال و منهاج رهست","پس از شکست و ناکامی، هیچ کار و اثری از آن اقبال و خوش‌اقبالی که پیش از این وجود داشت، باقی نمی‌ماند و تنها راه افتادن در مسیر مشکل‌آفرین است."],[947,"کار و باری که ندارد پا و سر","ترک کن هی پیر خر ای پیر خر","کار و فعالیتی که نه هدفی دارد و نه سر و پای درستی، آن را رها کن ای پیر احمق (مراد به شخصی است که دچار بی‌مقصدی شده است)."],[947,"غیر پیر استاد و سرلشکر مباد","پیر گردون نی ولی پیر رشاد","جز پیر، هیچ‌کس نیست که سرپرست و فرمانده باشد. پیر در اینجا نماد حکمت و تجربه است که نباید تنها به سن و سالش توجه کرد، بلکه باید به درستی و هوش او نیز توجه کرد."],[947,"در زمان چون پیر را شد زیردست","روشنایی دید آن ظلمت‌پرست","زمانی که آن پیر، که نماد حکمت و روشنی است، زیر نظر و تحت سلطه قرار می‌گیرد، روشنایی و حقیقت را در دل تاریکی‌پرستان می‌بیند."],[947,"شرط تسلیم است نه کار دراز","سود نبود در ضلالت ترک‌تاز","تسلیم شدن به حقوند بودن لازم است و تنها کار کردن و تلاش طولانی نتیجه‌ای ندارد. در گمراهی و سرگردانی، هیچ نفعی وجود ندارد، پس باید از آن‌ها دست کشید."],[947,"من نجویم زین سپس راه اثیر","پیر جویم پیر جویم پیر پیر","من دیگر از این دنیا چیزی نمی‌خواهم و فقط به دنبال حقیقت و دانایی هستم. به دنبال راهنما و پیشوایی هستم که مرا به سمت راستی و روشنی هدایت کند."],[947,"پیر باشد نردبان آسمان","تیر پرّان از که گردد؟ از کمان","پیر، که به عنوان راهنمایی به سوی آسمان معرفی شده، چگونه می‌تواند مانند تیر پرنده‌ای باشد که از کمان رها می‌شود؟ این سؤال به این معناست که بدون یک راهنما (پیر)، پرواز به معانی بلند و آسمانی ممکن نیست."],[947,"نه ز ابراهیم نمرود گران","کرد با کرکس سفر بر آسمان","نه نمرود، پادشاه جبار که با ابراهیم خلیل (ع) دشمنی داشت، به اندازه پرواز کرکس‌ها (پرندگان در حال پرواز) در آسمان قدرت و توانایی دارد."],[947,"از هوا شد سوی بالا او بسی","لیک بر گردون نپرد کرکسی","او از زمین به سوی آسمان پرواز کرد، اما مانند کرکس در آسمان پرواز نکرد. یعنی به رغم اینکه به آسمان رفت، نتوانست مانند یک پرنده بزرگ به اوج برسد."],[947,"گفتش ابراهیم ای مرد سفر","کرکست من باشم اینت خوب‌تر","ابراهیم به مردی می‌گوید که من باید به سفر بروم، اما تو بهتر از من هستی و می‌توانی این کار را انجام دهی."],[947,"چون ز من سازی به بالا نردبان","بی پریدن بر روی بر آسمان","اگر مرا از زمین به آسمان بالا ببری، باید با نردبانی که تو درست می‌کنی بالا بروم و نمی‌توانم به‌طور ناگهانی و بدون زحمت به آسمان برسم."],[947,"آنچنان که می‌رود تا غرب و شرق","بی ز زاد و راحله دل هم‌چو برق","انسان به سرعت و بی‌خبر از آنچه به همراه دارد، به سفر و جست‌وجو در غرب و شرق می‌رود، همان‌طور که برق به سرعت می‌گذرد. در این سفر، او هیچ همراه و وسیله‌ای ندارد و دلش هم آشفته است."],[947,"آنچنان که می‌رود شب ز اغتراب","حس مردم شهرها در وقت خواب","چنان که شب، در زمان خواب مردم، حس تنهاییشان را در شهرها گم می‌کند و به دوری و بی‌وطن بودنش می‌رسد."],[947,"آنچنان که عارف از راه نهان","خوش نشسته می‌رود در صد جهان","عارف (شخصی که به عرفان و معنویت پرداخته) به گونه‌ای نامرئی و نامحسوس در دل‌های مردم نفوذ می‌کند و تأثیرش به سراسر جهان می‌رسد، بدون اینکه کسی او را ببیند یا به او توجه کند."],[947,"گر ندادستش چنین رفتار دست","این خبرها زان ولایت از کیست","اگر او (عارف) این چنین رفتار و حال را از کسی دریافت نکرده، پس این اخبار و داستان‌ها از جانب کدام کس است؟"],[947,"این خبرها وین روایات محق","صد هزاران پیر بر وی متفق","این خبرها و روایت‌هایی که در مورد او نقل می‌شود، مورد تأیید و توافق صدها عارف و پیر هستند."],[947,"یک خلافی نی میان این عیون","آنچنان که هست در علم ظنون","بین این چشم‌ها هیچ تفاوتی وجود ندارد و هر آنچه که درک می‌شود مطابق با علم و یقین است، نه بر اساس ظن و گمان."],[947,"آن تحری آمد اندر لیل تار","وین حضور کعبه و وسط نهار","آن تحری که به صورت ناگهانی و در شب تار، به‌وجود آمده، در این حال که از ته دل و با اخلاص در برابر کعبه‌ای بزرگ و مقدس، در روشنایی روز (نهار) است."],[947,"خیز ای نمرود پر جوی از کسان","نردبانی نایدت زین کرکسان","ای نمرود، از میان افرادی که در اطرافت هستند، برخیز و خودت را از آن‌ها کنار بکش؛ زیرا از این کفتارها و موجودات بی‌ارزش، کمکی به تو نخواهد رسید."],[947,"عقل جزوی کرکس آمد ای مقل","پر او با جیفه‌خواری متصل","عقل جزئی، مانند کرکسی است که به زباله‌ها (جیفه) وابسته است و این عقل احساس عالی و پاکی ندارد."],[947,"عقل ابدالان چو پر جبرئیل","می‌پرد تا ظل سدره میل میل","عقل کامل و الهی، که به عنوان نماینده‌ای از فرشتگان مانند جبرئیل است، به سوی درخت سدره (محل قرب الهی) پرواز می‌کند. این عقل، جنبه‌ای عالی و رفیع دارد و به سمت مرتبه‌ای بلند و معنوی حرکت می‌کند."],[947,"باز سلطانم گشم نیکوپیم","فارغ از مردارم و کرکس نیم","باز من سلطان هستم و با قامت نیکو و رفتار خوب خود سرشار از زندگی هستم و از فساد و بدی دور هستم، نه مانند کرکسی که به مردارها نزدیک می‌شود."],[947,"ترک کرکس کن که من باشم کست","یک پر من بهتر از صد کرکست","ترک کردن کرکس (پرنده‌ای مرده‌خوار) را بگذار و به من توجه کن؛ چرا که وجود من با ظرفیت و ارزش‌های خود، به مراتب از صد کرکس بهتر است."],[947,"چند بر عمیا دوانی اسپ را","باید استا پیشه را و کسپ را","چند بار باید در دنیا به افرادی که نمی‌فهمند، تلاش کنیم؟ مثل اینکه بدانیم به این افراد به طریقی نمی‌توان کمک کرد و بهتر است به افراد معقول و باهوش توجه کنیم."],[947,"خویشتن رسوا مکن در شهر چین","عاقلی جو خویش از وی در مچین","خودتان را در چین رسوا نکنید، بلکه عاقلانه عمل کنید و شرمندگی‌تان را از دیگران پنهان کنید."],[947,"آن چه گوید آن فلاطون زمان","هین هوا بگذار و رو بر وفق آن","آنچه آن فیلسوف بزرگ، یعنی افلاطون، می‌گوید را بشنو و به آن عمل کن. پس برای خود را از هوا و نفس برحذر کن و به راهی که او پیشنهاد می‌کند برو."],[947,"جمله می‌گویند اندر چین به جد","بهر شاه خویشتن که لم یلد","می‌گویند در چین که هیچ شاهی صاحب فرزند نشده و نسل او ادامه نیافته است."],[947,"شاه ما خود هیچ فرزندی نزاد","بلک سوی خویش زن را ره نداد","شاه ما هیچ فرزندی نداشت و به جای آن، اجازه نداد که زنی به سوی خود بیاید."],[947,"هر که از شاهان ازین نوعش بگفت","گردنش با تیغ بران کرد جفت","هر کسی که از این شاهان (که به نحوی در آنها اشاره شده) چنین چیزی گفته باشد، گردنش را با تیغ بران (یعنی به خاطر این حرفش مجازات شده) قطع کرده‌اند."],[947,"شاه گوید چونک گفتی این مقال","یا بکن ثابت که دارم من عیال","شاه می‌گوید: چون تو این سخن را گفتی، ثابت کن که من خانواده و عیال دارم."],[947,"مر مرا دختر اگر ثابت کنی","یافتی از تیغ تیزم آمنی","اگر بتوانی دختر مرا ثابت و محکم کنی، در این صورت از خطر و آسیب تیغ تیز من در امان خواهی بود."],[947,"ورنه بی‌شک من ببرم حلق تو","ای بگفته لاف کذب آمیغ تو","اگر حقیقت را ثابت نکنی، قطعا من حلق (گردن) تو را می‌زنم، ای کسی که به دروغ و کذب خود افتخار می‌کنی."],[947,"بنگر ای از جهل گفته ناحقی","پر ز سرهای بریده خندقی","ای کسی که از نادانی به ناحقی سخن می‌گویی، به این خندق نگاه کن که پر از سرهای بریده است."],[947,"خندقی از قعر خندق تا گلو","پر ز سرهای بریده زین غلو","این بیت به تشبیه عمیق و دردناکی اشاره دارد که در آن خندق مملو از سرهای بریده، نمادی از خشونت و بی‌رحمی است. به طور کلی، شاعر می‌گوید که این خندق از قعر تا گلو پر از سرهای بریده است که نشان‌دهنده شدت غلو و بی‌مبالاتی در جنگ و کشتار است."],[947,"جمله اندر کار این دعوی شدند","گردن خود را بدین دعوی زدند","همه درگیر این ادعا و ادعاها شدند و برای اثبات آن به گردن خود (زندگی و اعتبارشان) ریسک کردند."],[947,"هان ببین این را به چشم اعتبار","این چنین دعوی میندیش و میار","به این موضوع با دقت نگاه کن و آن را به‌عنوان یک ادعا بی‌پایه جدی نگیر و به آن اهمیت نده."],[947,"تلخ خواهی کرد بر ما عمر ما","کی برین می‌دارد ای دادر ترا","اگر می‌خواهی که عمر ما تلخ شود، این کار چه زمانی بر تو خواهد گذشت؟ ای دادر (قاضی یا داور)، این کار را انجام بده."],[947,"گر رود صد سال آنک آگاه نیست","بر عما آن از حساب راه نیست","اگر صد سال هم کسی در حال گذر باشد اما آگاه نباشد، هیچ‌گونه محاسبه یا حسابی بر روی او نیست."],[947,"بی‌سلاحی در مرو در معرکه","هم‌چو بی‌باکان مرو در تهلکه","در شهر مرو، در موقعیتی خطرناک مانند افرادی بدون سلاح و بدون محافظت، بی‌باک و شجاع رفتار می‌کند و هیچ ترسی از مشکلات ندارد."],[947,"این همه گفتند و گفت آن ناصبور","که مرا زین گفته‌ها آید نفور","این ناصبور (شخصی که بی‌صبر است) از زخم زبان‌ها و حرف‌های دیگران به شدت خسته و دلزده شده و از این گفت‌وگوها ناراضی است."],[947,"سینه پر آتش مرا چون منقل است","کشت کامل گشت وقت منجل است","دل من مانند یک منقل پر از آتش است که در آن زمان کشت (کشتی) من در حال آماده شدن است و زمان تنبلی و بی‌تحرکی من به پایان رسیده است."],[947,"صدر را صبری بد اکنون آن نماند","بر مقام صبر عشق آتش نشاند","صبر صدر (یعنی صبر من) اکنون دیگر دوام نیاورد و در مقام عشق، آتش غیرقابل تحملی درونم شعله‌ور شده است."],[947,"صبر من مرد آن شبی که عشق زاد","درگذشت او حاضران را عمر باد","صبر من در آن شبی نابود شد که عشق متولد شد و او (عشق) از زمان مرگ او، عمر حاضران را به باد فنا داد."],[947,"ای محدث از خطاب و از خطوب","زان گذشتم آهن سردی مکوب","ای سخن‌سنج که از گفتگوها و حوادث دور شده‌ام، بر آن آهن سرد که بر می‌کوبد، پرهیز می‌کنم."],[947,"سرنگونم هی رها کن پای من","فهم کو در جمله اجزای من","من به حالت بی‌پناهی و درماندگی افتاده‌ام، پس مرا رها کن تا آزاد شوم. آیا نمی‌فهمی که در کل وجودم چه بلایی بر سرم آمده است؟"],[947,"اشترم من تا توانم می‌کشم","چون فتادم زار با کشتن خوشم","من هر زمان که توانایی‌ام را دارم، از کار می‌کوشم و می‌کشم، اما وقتی که در حالتی زار و ناتوان می‌افتم، به کشتن خود راضی هستم."],[947,"پر سر مقطوع اگر صد خندق است","پیش درد من مزاح مطلق است","هرچند که در زندگی مشکلات و دردهای زیادی وجود دارد، اما برای من این ناراحتی‌ها در مقایسه با دردهای درونیم اصلا اهمیت ندارند."],[947,"من نخواهم زد دگر از خوف و بیم","این چنین طبل هوا زیر گلیم","من دیگر از ترس و وحشت بر نخواهم خاست و به فعالیت نخواهم پرداخت، زیرا این طبل توخالی آمال، زیر پوشش زندگی‌ام نه تنها نوا نمی‌دهد، بلکه به من آرامش نمی‌دهد."],[947,"من علم اکنون به صحرا می‌زنم","یا سراندازی و یا روی صنم","اکنون می‌خواهم به صحرا بروم و یا به دلبستگی و عشق کسی دل بسپارم، یا اینکه به زیبایی و شمایل آن معشوق بنگرم."],[947,"حلق کو نبود سزای آن شراب","آن بریده به به شمشیر و ضراب","حلقه‌ای که شایسته‌ی آن شراب نیست، مانند آن است که با شمشیر و ضربه‌ای بریده شود. اینجا به عدم توانایی در درک و پذیرش زیبایی و شادی اشاره دارد."],[947,"دیده کو نبود ز وصلش در فره","آن چنان دیده سپید کور به","چشمی که از دیدن او در خوشحالی و لذت نیست، مثل چشمی است که به‌طور کامل و بی‌سواد کور شده باشد. به عبارت دیگر، دیدن او به قدری شیرین و باارزش است که نبود آن مانند کوری مطلق است."],[947,"گوش کان نبود سزای راز او","بر کنش که نبود آن بر سر نکو","گوشی که صلاحیت شنیدن رازهای او (خدا) را ندارد، نباید در آنجا حضور داشته باشد، چون کسی که شایسته درک حقایق نیست، در بالاترین مرتبه‌ها (سر نکو) جایی ندارد."],[947,"اندر آن دستی که نبود آن نصاب","آن شکسته به به ساطور قصاب","در آن دستی که نبود آن نصاب (اندازه، معیار)، آن شکسته (ناکارآمد) مانند تکه‌ای گوشت که توسط ساطور قصاب بریده می‌شود."],[947,"آنچنان پایی که از رفتار او","جان نپیوندد به نرگس زار او","این بیت بیان می‌کند که پا به قدری در لذت و زیبایی نرگس‌زار محصور شده که جان انسان را از او جدا نمی‌کند، یعنی به قدری در حالتی سرشار از عشق و زیبایی است که هیچ چیز او را از آن دور نمی‌سازد."],[947,"آنچنان پا در حدید اولیترست","که آنچنان پا عاقبت درد سرست","به این معنا که آن پا که در آهن (حدید) باشد، در واقع باید طاقت و قدرت بیشتری داشته باشد، اما در عین حال، آن پا به خاطر فشار و رنجی که متحمل می‌شود، در نهایت خود را به درد و مشکل مبتلا می‌کند."],[948,"یا درین ره آیدم آن کام من","یا چو باز آیم ز ره سوی وطن","در این مسیر یا به خواسته‌ام می‌رسم و به هدفم می‌رسد، یا وقتی به وطن برمی‌گردم، آن را پیدا می‌کنم."],[948,"بوک موقوفست کامم بر سفر","چون سفر کردم بیابم در حضر","شاید رسیدن به خواسته‌ام وابسته به سفر باشد، زیرا وقتی که سفر کنم، در حضور (زندگی واقعی) آنچه می‌خواهم را پیدا خواهم کرد."],[948,"یار را چندین بجویم جد و چست","که بدانم که نمی‌بایست جست","من در پی یار خود سخت تلاش می‌کنم و کوشش می‌کنم، اما می‌دانم که هیچ‌گاه نباید به دنبال او گشت."],[948,"آن معیت کی رود در گوش من","تا نگردم گرد دوران زمن","نمی‌دانم چگونه می‌توانم به درک معیت (همراهی) و نزدیکی با حق برسم، زیرا اگر این ارتباط درونی در من ایجاد نشود، نمی‌توانم در زمان و مکان به حقیقت پی ببرم."],[948,"کی کنم من از معیت فهم راز","جز که از بعد سفرهای دراز","من چگونه می‌توانم از معیت (همراهی) خداوند رازهایی را بفهمم، زمانی که تنها از تجربه و سفرهای طولانی به درک آن رسیده‌ام؟"],[948,"حق معیت گفت و دل را مهر کرد","تا که عکس آید به گوش دل نه طرد","خداوند با یاری خود دل را روشن می‌سازد و مهر و محبت را در آن جای می‌دهد تا نشانه‌های حقیقت و معانی عمیق در آن دیده شود و دل هیچ چیزی را نپذیرد که باعث طرد شود."],[948,"چون سفرها کرد و داد راه داد","بعد از آن مهر از دل او بر گشاد","پس از آنکه سال‌ها در تلاش و سیر و سفر بوده و راه راست را یافته، در نهایت محبت و عشق به خداوند از دل او نمایان می‌شود و آن محبت، دل او را از غم و تردید آزاد می‌کند."],[948,"چون خطایین آن حساب با صفا","گرددش روشن ز بعد دو خطا","هنگامی که انسان از اشتباهات خود آگاه شود و به دل پاکی دست یابد، وضعیت او به وضوح تغییر می‌کند و پس از مرتکب شدن دو خطا، می‌تواند حقیقت قضایا را بهتر درک کند."],[948,"بعد از آن گوید اگر دانستمی","این معیت را کی او را جستمی","اگر من می‌دانستم که در این مسیر، وجود و همراهی او (خدا) را جستجو می‌کنم، دیگر در پی او نمی‌رفتم."],[948,"دانش آن بود موقوف سفر","ناید آن دانش به تیزی فکر","اگر دانش به‌دست آمده از تفکر عمیق نباشد، به سفر و تصمیم‌گیری خوب منجر نخواهد شد. دانش واقعی نیازمند تأمل و فهم عمیق است تا انسان را در مسیر درست راهنمایی کند."],[948,"آنچنان که وجه وام شیخ بود","بسته و موقوف گریه آن وجود","شیخ به خاطر گریه و درخواست کمک آن کودک در وضعیت سختی قرار گرفته و به او وابسته شده است؛ یعنی نتیجه وضع او به گریه و زاری کودک مربوط است و او را تحت تأثیر قرار داده است."],[948,"کودک حلواییی بگریست زار","توخته شد وام آن شیخ کبار","کودکی که در فروشگاه آبنبات‌فروشی گریه کرد، به خاطر آنکه وام شیخ در محل خود برجا مانده است."],[948,"گفته شد آن داستان معنوی","پیش ازین اندر خلال مثنوی","در این بیت اشاره شده که داستان معنوی که قبلا در مثنوی ذکر شده، باید دوباره مورد توجه قرار گیرد. این نشان می‌دهد که اهمیت و عمق آن داستان به‌گونه‌ای است که نیاز به بازنگری و تأمل بیشتری دارد."],[948,"در دلت خوف افکند از موضعی","تا نباشد غیر آنت مطمعی","در دل تو ترسی بیفکندند تا جز خودت به چیزی دیگر اعتماد نداشته باشی."],[948,"در طمع فایده دیگر نهد","وآن مرادت از کسی دیگر دهد","تو در آرزوی چیزی که به آن دسترسی داری، ممکن است بهره‌ای از کسی دیگر نیز ببری و به هدف خود از سمت دیگری برسید."],[948,"ای طمع در بسته در یک جای سخت","که آیدم میوه از آن عالی‌درخت","تو که بر درختی بزرگ و باارزش تکیه‌زده‌ای، نمی‌توانی فقط به طمع میوه‌ای از یک مکان خاص دل ببندی؛ ممکن است روزی میوه‌ای از جای دیگری به تو برسد."],[948,"آن طمع زان جا نخواهد شد وفا","بل ز جای دیگر آید آن عطا","این امید و آرزو از آن مکان برآورده نخواهد شد، بلکه نعمت و بخشش از مکان دیگری به انسان خواهد رسید."],[948,"آن طمع را پس چرا در تو نهاد","چون نخواستت زان طرف آن چیز داد","چرا خداوند این خواسته و طمع را در دل تو قرار داده است، وقتی که او نمی‌خواهد آن نعمت را از این طریق به تو بدهد؟"],[948,"از برای حکمتی و صنعتی","نیز تا باشد دلت در حیرتی","برای هدف و حکمتی خاص، دلت باید در حال حیرت و شگفتی باشد."],[948,"تا دلت حیران بود ای مستفید","که مرادم از کجا خواهد رسد","هر زمان که دل تو در حیرت و شگفتی باشد، بدان که تو به عنوان بهره‌مند، در جستجوی شناختی هستی که نمی‌دانی خواسته‌ام چطور و از کجا به من خواهد رسید."],[948,"تا بدانی عجز خویش و جهل خویش","تا شود ایقان تو در غیب بیش","تا وقتی که نادانی و ناتوانی خود را نشناسی، ایمان و یقین تو نسبت به آنچه که در عالم غیب وجود دارد، کامل نخواهد شد."],[948,"هم دلت حیران بود در منتجع","که چه رویاند مصرف زین طمع","دل تو همواره نگران و متحیر است که چه چیزی از این طمع و امید به دست می‌آوری و نتیجه آن چیست."],[948,"طمع داری روزیی در درزیی","تا ز خیاطی بی زر تا زیی","تو به دنبال روزی از سوی درزی هستی، در حالی که می‌خواهی از طریق خیاطی و بدون زر (پول) به آن روزی دسترسی پیدا کنی."],[948,"رزق تو در زرگری آرد پدید","که ز وهمت بود آن مکسب بعید","روزی تو به راحتی از حرفه‌ی طلاکاری به دست می‌آید، چرا که این تصور و خیال توست که آن کار تو دور از دسترس است."],[948,"پس طمع در درزیی بهر چه بود","چون نخواست آن رزق زان جانب گشود","اگر انسان به ورودی خاصی برای روزیش امید دارد، باید بداند که ممکن است رزق او از طرف دیگری به او برسد، حتی اگر او به آن طرف فکر نکرده باشد. بنابراین، نباید فقط به یک منبع خاص دل ببندد، زیرا ممکن است روزی او از جایی بی‌خبر بیاید."],[948,"بهر نادر حکمتی در علم حق","که نبشت آن حکم را در ما سبق","وجود حکمتی نادر در علم خداوند وجود دارد که آن حکم را پیش از این در سرنوشت ما نوشته است."],[948,"نیز تا حیران بود اندیشه‌ات","تا که حیرانی بود کل پیشه‌ات","تا زمانی که افکار و اندیشه‌هایت در حیرت و سردرگمی باشد، تمام کار و تلاش تو نیز در همین حالت سردرگمی خواهد بود."],[948,"یا وصال یار زین سعیم رسد","یا ز راهی خارج از سعی جسد","یا به وصال یار از طریق تلاشم می‌رسم، یا از راهی غیر از تلاش خود به هدف می‌رسم."],[948,"من نگویم زین طریق آید مراد","می‌طپم تا از کجا خواهد گشاد","من نمی‌گویم که خواسته‌ام از این مسیر به دست می‌آید، بلکه به شدت تلاش می‌کنم تا ببینم که در نهایت از کدام راه نیازهایم برآورده خواهد شد."],[948,"سربریده مرغ هر سو می‌فتد","تا کدامین سو رهد جان از جسد","مرغی که سرش بریده شده، در هر سمت و سو می‌افتد و تلاش می‌کند تا به جایی برود که جانش از بدنی که دیگر وجود ندارد، رها شود. این تصویر نشان‌دهنده بی‌هدفی و سرگردانی است در شرایطی که وجود و حیات از دست رفته است."],[948,"یا مراد من برآید زین خروج","یا ز برجی دیگر از ذات البروج","من یا درخواست من از این خروج و رفت و آمد برآورده می‌شود، یا اینکه از جایی دیگر، که به مقام بلند و ویژگی‌های الهی ارتباط دارد، به من خواهد رسید."],[949,"بود یک میراثی مال و عقار","جمله را خورد و بماند او عور و زار","یک میراثی از مال و املاک وجود داشت، که به شخصی رسید و او به‌طور ناشیانه و نادرست آن را صرف کرد و حالا به حالتی درمانده و ناتوان زندگی می‌کند."],[949,"مال میراثی ندارد خود وفا","چون بناکام از گذشته شد جدا","این شخص که از میراث خود چیزی ندارد، وفای آن را به خود نمی‌بیند زیرا نتیجه بد یا ناکامی از گذشته‌اش او را جدا کرده است."],[949,"او نداند قدر هم کآسان بیافت","کو به کدّ و رنج و کسبش کم شتافت","آن شخص نمی‌داند ارزش تلاش و زحمتی را که دیگران برای به دست آوردن چیزها می‌کشند، زیرا خودش به سختی و مشقت نپرداخته و به راحتی به آن چیز رسیده است."],[949,"قدر جان زان می‌ندانی ای فلان","که بدادت حق به بخشش رایگان","ای شخص، تو ارزش جان خود را نمی‌دانی، چون خداوند به تو نعمت‌های بی‌زحمت و رایگان عطا کرده است."],[949,"نقد رفت و کاله رفته و خانه‌ها","ماند چون چغدان در آن ویرانه‌ها","نقد (پول و ثروت) و کالاها از بین رفته و تنها خانه‌ها باقی مانده‌اند، مانند چغندری که در ویرانه‌ها باقی مانده است."],[949,"گفت یا رب برگ دادی رفت برگ","یا بده برگی و یا بفرست مرگ","شخص در دعا از خدا می‌خواهد که یا بار دیگر به او زندگی دهد و یا این‌که او را به مرگ بفرستد. در واقع، او از خدا درخواست دارد که وضعیت او را تغییر دهد."],[949,"چون تهی شد یاد حق آغاز کرد","یا رب و یا رب اجرنی ساز کرد","زمانی که یاد خدا در دل او خالی شد، شروع به دعا و ناله کرد و می‌گفت: «ای پروردگار، مرا نجات بده» و برای خود آوایی ساخت."],[949,"چون پیمبر گفته مؤمن مزهرست","در زمان خالیی ناله‌گرست","پیامبر گفته است مؤمن در زمان خوشی و نشاط مثل گل می‌زند و در زمان سختی و خالی بودن، ناله و زاری می‌کند."],[949,"چون شود پر مطربش بنهد ز دست","پر مشو که آسیب دست او خوش‌ست","زمانی که نوازنده سرشار از شادی و شور باشد، سازش را به زمین می‌گذارد. از نزدیک شدن به او و برقراری تماس نترسید، زیرا آسیب به دست او بسیار دلپذیر است و نشان از پیوند عمیق شما دارد."],[949,"تی شو و خوش باش بین اصبعین","کز می لاأین سرمست‌ است این","احساس خوشی کن و شاد باش، زیرا زندگی و لذت آن مانند نوشیدن شراب است که روح را سرمست می‌کند."],[949,"رفت طغیان آب از چشمش گشاد","آب چشمش زرع دین را آب داد","اشک‌های او به‌قدری جاری شد که مانند طغیانی از آب بود و این اشک‌ها باعث رشد و نمو دین در دلش شد."],[950,"ای بسا مخلص که نالد در دعا","تا رود دود خلوصش بر سما","بسیاری از بندگان خالص خداوند در دعاهای خود عمیقا ناله می‌کنند تا بخار و دود خلوص نیت آن‌ها به آسمان برود و به درگاه الهی برسد."],[950,"تا رود بالای این سقف برین","بوی مجمر از انین المذنبین","بوی خوش عطر بخور از ناله و گریه گناهکاران به بالای این سقف می‌رسد."],[950,"پس ملایک با خدا نالند زار","کای مجیب هر دعا وی مستجار","فرشتگان به درگاه خداوند در حال ناله و زاری هستند و از او می‌خواهند که ای اجابت‌کننده هر دعا و پناه‌دهنده، به درخواست مؤمنین پاسخ دهی."],[950,"بنده مؤمن تضرع می‌کند","او نمی‌داند به جز تو مستند","مؤمن خدا را با زاری و تضرع می‌خواند، اما او نمی‌داند که غیر از تو هیچ‌کس دیگری نمی‌تواند به فریادش برسد."],[950,"تو عطا بیگانگان را می‌دهی","از تو دارد آرزو هر مشتهی","تو به بیگانگان هم نعمت و عطا می‌دهی، در حالی که هر کسی که آرزوی چیزی دارد، به تو وابسته است و از تو می‌خواهد."],[950,"حق بفرماید که نه از خواریّ اوست","عین تاخیر عطا یاری اوست","خداوند به تأخیر انداختن عطا را به خاطر خوار بودن بندگانش نمی‌داند؛ بلکه این تأخیر نشانه‌ای از یاری و حمایت اوست."],[950,"حاجت آوردش ز غفلت سوی من","آن کشیدش مو کشان در کوی من","خواسته‌اش او را از غفلت به سوی من آورد و به شکل نرم و ملایم، او را با کشیدن مو به کوی من کشاند."],[950,"گر بر آرم حاجتش او وا رود","هم در آن بازیچه مستغرق شود","اگر من حاجت او را برآورم، او نیز در آن حال به بازیچه‌ای که دارد غرق می‌شود و از این موضوع غافل می‌گردد."],[950,"گرچه می‌نالد به جان « یا مستجار »","دل شکسته سینه‌خسته گو بزار","هرچند او با دل شکسته و جان رنجور به خدا می‌گوید «یا مستجار» (ای پناه‌دهنده)، ولی باید بداند که باید خود را رها کند و از دل شکستگی خارج شود."],[950,"خوش همی‌آید مرا آواز او","وآن خدایا گفتن و آن راز او","آواز معشوق برایم خوشایند است و من از گفتن «خدایا» و بیان رازهایم لذت می‌برم."],[950,"وانک اندر لابه و در ماجرا","می‌فریباند به هر نوعی مرا","در این بیت مولانا به این موضوع اشاره می‌کند که کسی (شاید خدا) در هنگام دعا و اضطراب، با انواع ترفندها و بیان‌های مختلف، مرا فریب می‌دهد و از حقیقت دور می‌کند. این فریب در لابه‌لای خواسته‌ها و ماجراها به وجود می‌آید."],[950,"طوطیان و بلبلان را از پسند","از خوش آوازی قفس‌در می‌کنند","چون طوطی‌ها و بلبل‌ها آواز خوشی دارند، برای لذت بردن از صدای آن‌ها، در قفس نگه‌داری می‌شوند."],[950,"زاغ را و چغد را اندر قفس","کی کنند این خود نیامد در قصص","زاغ و چغد را در قفس نمی‌گذارند، چون آن‌ها خودشان به اینجا نیامده‌اند و در داستان‌ها نیز به این موضوع اشاره‌ای نشده است."],[950,"پیش شاهد باز چون آید دو تن","آن یکی کمپیر و دیگر خوش‌ ذقن","دو نفر، یکی با چهره‌ای خوش و دیگری با ظاهر پیر و سن‌دار، هنگام آمدن به سوی معشوق، چهره‌ی همدیگر را نشان می‌دهند."],[950,"هر دو نان خواهند او زوتر فطیر","آرد و کمپیر را گوید که گیر","هر دو شخص (کمپیر و خوش‌ذقن) برای تهیه نان به نزد کسی می‌روند و آن شخص نان تازه (فطیر) را زودتر به خوش‌ذقن می‌دهد و به کمپیر می‌گوید که منتظر باشد."],[950,"وآن دگر را که خوش استش قدّ و خد","کی دهد نان بل به تاخیر افکند","کسی که خوش‌قد و خوش‌چهره است، چگونه می‌تواند نان را به تأخیر اندازد؟ در واقع، او به خاطر زیبایی‌اش نمی‌تواند تأخیر در رساندن نان را توجیه کند."],[950,"گویدش بنشین زمانی بی‌گزند","که به خانه نان تازه می‌پزند","به او می‌گوید، برای مدتی بی‌خطر بنشین و منتظر بمان که در خانه نان تازه‌ای می‌پزند."],[950,"چون رسد آن نان گرمش بعد کدّ","گویدش بنشین که حلوا می‌رسد","وقتی که آن نان گرم به دستش برسد و بعد از زحمت و تلاش به دست آمده باشد، به او می‌گوید که بنشین چون قرار است حلوا نیز بیاید."],[950,"هم برین فن داردارش می‌کند","وز ره پنهان شکارش می‌کند","همان طور که نان گرم برای فردی انگیزه می‌آورد، خداوند نیز به‌طور غیرمستقیم و از راه‌های پنهان، شخص را متوجه دعایش می‌کند و او را به سمت طلب کردن آن هدایت می‌کند."],[950,"که مرا کاریست با تو یک زمان","منتظر می‌باش ای خوب جهان","من کاری دارم که برای انجام آن باید مدتی منتظر تو بمانم، ای جمال زیبا و خوش‌چهره جهان."],[950,"بی‌مرادی مومنان از نیک و بد","تو یقین می‌دان که بهر این بود","قطعا مومنان از نیکی و بدی تو ناامید شده‌اند، و این را باید بدانید که دلیل این ناامیدی همین موضوع است."],[951,"مرد میراثی چو خورد و شد فقیر","آمد اندر یا رب و گریه و نفیر","مردی که از نعمت‌هایش بهره‌مند بود و به طور ناگهانی فقیر شد، به درگاه خداوند آمده و با گریه و ناله از حالش شکایت می‌کند."],[951,"خود کی کوبد این در رحمت‌نثار","که نیابد در اجابت صد بهار","خودش در رحمت و کمک را می‌کوبد، اما اگر افرادی لایق و سزاوار نباشند، نمی‌توانند در دوره‌ای طولانی از نعمت و پاداش بهره‌مند شوند."],[951,"خواب دید او هاتفی گفت ، او شنید","که غنای تو به مصر آید پدید","او در خواب صدایی (هاتف) شنید که به او می‌گوید ثروت و نعمتش به مصر خواهد رسید و در آنجا ظاهر می‌شود."],[951,"رو به مصر آنجا شود کار تو راست","کرد کدیت را قبول او مرتجاست","به سمت مصر برو، آنجا کار تو درست می‌شود و کسی که تو را قبول دارد، در تنگنا و فقر نیست."],[951,"در فلان موضع یکی گنجی است زفت","در پی آن بایدت تا مصر رفت","در فلان مکان گنجی بسیار ارزشمند وجود دارد که برای به‌دست آوردن آن باید به مصر سفر کنی."],[951,"بی‌درنگی هین ز بغداد ای نژند","رو به سوی مصر و منبت‌گاه قند","بدون تأخیر، ای نیرومند، از بغداد به سمت مصر حرکت کن، زیرا در آنجا باغ‌هایی پر از قند وجود دارد."],[951,"چون ز بغداد آمد او تا سوی مصر","گرم شد پشتش چو دید او روی مصر","این فرد که از بغداد به سوی مصر می‌آید، وقتی که به مصر می‌رسد و آنجا را می‌بیند، احساس شوق و خوشحالی به او دست می‌دهد و پشتش گرم می‌شود، گویی انرژی و نشاط تازه‌ای یافته است."],[951,"بر امید وعده هاتف که گنج","یابد اندر مصر بهر دفع رنج","آن شخص به امید وعده روحی (که می‌گفت گنجی در مصر وجود دارد) به آنجا رفته تا رنج‌های خود را از بین ببرد و به ثروت برسد."],[951,"در فلان کوی و فلان موضع دفین","هست گنجی سخت نادر بس گزین","در فلان منطقه و در محل مشخصی، گنجی با ارزشی نهفته است که بسیار کمیاب و خاص می‌باشد."],[951,"لیک نفقه‌ش بیش و کم چیزی نماند","خواست دقی بر عوام‌الناس راند","او چون چیزی از گنج نداشت و نفقه‌اش (هزینه‌های زندگی‌اش) کم و زیاد نمی‌شد، تصمیم گرفت تا از دیگران به‌طور علنی و به‌زور مالیات بگیرد."],[951,"لیک شرم و همتش دامن گرفت","خویش را در صبر افشردن گرفت","اما او به خاطر شرم و غیرتش، خود را کنترل کرده و عزم کرد که صبر کند."],[951,"باز نفسش از مجاعت برطپید","ز انتجاع و خواستن چاره ندید","نفس او از شدت ترس و نگرانی به تپش افتاد و او به دلیل حیا و درخواست کمک نتوانست چاره‌ای در نظر بگیرد."],[951,"گفت شب بیرون روم من نرم نرم","تا ز ظلمت نایدم در کدیه شرم","او گفت که به آرامی و به تدریج از خانه خارج می‌شود تا از تاریکی‌ها و شرم و عیب خود را نبیند و از آن‌ها دور بماند."],[951,"هم‌چو شبکوکی کنم شب ذکر و بانگ","تا رسد از بامهاام نیم دانگ","من مثل کبوتر شب، ذکر خدا را با صدای ملایم و آرام می‌گویم تا صدایم از بام‌ها به گوش دیگران برسد، هر چند که صدایم تنها نیم دانگ باشد."],[951,"اندرین اندیشه بیرون شد بکوی","واندرین فکرت همی شد سو به سوی","او در این اندیشه و تفکر خارج شد و به سمت کوی محبوب رهسپار گشت و در این فکر بود که به کدام سو برود."],[951,"یک زمان مانع همی‌شد شرم و جاه","یک زمانی جوع می‌گفتش بخواه","مدتی شرم و موقعیت اجتماعی او مانع خواسته‌اش بود، اما وقتی گرسنگی به سراغش آمد، او را به درخواست از خدا واداشت."],[951,"پای پیش و پای پس تا ثلث شب","که بخواهم یا بخسپم خشک‌لب","او در حال دعا و درخواست از خداوند است و به خاطر گرسنگی و تشنگی زیاد، نمی‌تواند آرام باشد و اینگونه توصیف می‌کند که نه می‌تواند بخوابد و نه می‌تواند از درخواست خود دست بکشد."],[952,"ناگهانی خود عسس او را گرفت","مشت و چوبش زد ز صفرا ناشکفت","ناگهان نیروی شب‌گردان (عسس) او را گرفت و به شدت کتک زد به طوری که به دلیل شدت ضربه‌ها، دردی عمیق (صفرا) به او وارد شد و نتوانست از جایش بلند شود."],[952,"اتفاقا اندر آن شب‌های تار","دیده بد مردم ز شب‌دزدان ضرار","در آن شب‌های تاریک، مردم به خاطر وجود دزدان خطرناک، حزن و ترس را تجربه می‌کردند."],[952,"بود شب‌های مخوف و منتحس","پس به جد می‌جست دزدان را عسس","در آن شب‌های ترسناک و تاریک، عسس (نگهبانان) با جدیت به دنبال دزدان بودند تا آنان را پیدا کنند."],[952,"تا خلیفه گفت که ببرید دست","هر که شب گردد وگر خویش منست","خلیفه فرمان داده است که هر کس که در شب مرتکب جرم شود، باید دستش قطع شود، حتی اگر آن شخص از نزدیکان خود او باشد."],[952,"بر عسس کرده ملک تهدید و بیم","که چرا باشید بر دزدان رحیم","عسس (پلیس) به خاطر رفتار ملایم و رحیمانه‌اش با دزدان، از سوی سلطان تهدید و مورد انتقاد قرار می‌گیرد که چرا به این دزدان مهربان است."],[952,"عشوه‌شان را از چه رو باور کنید","یا چرا زیشان قبول زر کنید","به این دلیل که آن‌ها به خوبی و حقیقت اعتماد ندارند، چرا باید فریب زیبایی یا زبان نرم آنان را بخورید و از آن‌ها چیزی بپذیرید؟"],[952,"رحم بر دزدان و هر منحوس‌دست","بر ضعیفان ضربت و بی‌رحمیست","رحم کردن بر دزدان و افراد بدسرشت، بی‌رحمی به ضعیفان و آزار رساندن به آنان است."],[952,"هین ز رنج خاص مسکل ز انتقام","رنج او کم بین ، ببین تو رنج عام","به خاطر رنج خاصی که به دلیل انتقام متحمل می‌شود، توجه نکن و رنج عام و عمومی را ببین و درک کن."],[952,"اصبع ملدوغ بر ، در دفع شر","در تعدی و هلاک تن نگر","انگشت نفرین‌شده‌ای که نیش خورده، در تلاش است تا شر و آسیب را دفع کند و به خطر و نابودی تن خود توجه کند."],[952,"اتفاقا اندر آن ایام دزد","گشته بود انبوه پخته و خام دزد","در آن روزها اتفاقا دزدان زیادی، هم از نوع پخته (یعنی با تجربه و حرفه‌ای) و هم از نوع خام (یعنی تازه‌کار)، در شهر وجود داشتند."],[952,"در چنین وقتش بدید و سخت زد","چوب‌ها و زخمهای بی‌عدد","در آن زمان، آن مرد درویش را دید و به شدت او را کتک زد و زخم‌های زیادی به او وارد کرد."],[952,"نعره و فریاد زان درویش خاست","که مزن تا من بگویم حال راست","فریاد و ناله آن درویش بلند شد و گفت: مرا نزنید تا حقیقت را بگویم."],[952,"گفت اینک دادمت مهلت بگو","تا به شب چون آمدی بیرون به کو","او به درویش می‌گوید که حالا به تو مهلت دادم تا بگویی، وقتی که شب شد و از خانه بیرون آمدی به کوچه."],[952,"تو نه‌ای زینجا غریب و منکری","راستی گو تا به چه مکر اندری","تو در اینجا غریب و شناخته‌شده نیستی، راست بگو تا ببینم چه نیرنگی در سر داری."],[952,"اهل دیوان بر عسس طعنه زدند","که چرا دزدان کنون انبه شدند","اهل دیوان به نیروهای پلیس (عسس) انتقاد کردند که چرا دزدان به این زودی دستگیر نشده‌اند و به اقداماتشان نمی‌رسند."],[952,"انبهی از تست و از امثال تست","وا نما یاران زشتت را نخست","ای آن شخصی که زشت خویی و ناپاکی تو را به من نشان داده‌اند، یاران زشت تو را نیز معرفی کن تا بیشتر مشخص شود که تو چه شخصیت و ویژگی‌هایی داری."],[952,"ورنه کین جمله را از تو کشم","تا شود آمن زر هر محتشم","اگر این دعواها و کینه‌ها را از تو بزنم، به‌طوری‌که در نهایت زرد و بی‌مقدار شود، آنگاه هر شخص محترم و باوقاری می‌تواند از این کینه‌ها به‌دور بماند و آرامش پیدا کند."],[952,"گفت او از بعد سوگندان پر","که نیم من خانه‌سوز و کیسه‌بر","او گفت که بعد از قسم‌های زیادی، به‌طور صریح بیان می‌کند که من نه کسی هستم که خانه را آتش بزنم و نه کیسه مردم را غارت کنم."],[952,"من نه مرد دزدی و بیدادیم","من غریب مصرم و بغدادیم","راوی در این بیت می‌گوید که او مرتکب دزدی و بیدادی نیست و تنها یک غریب در مصر است، به معنای اینکه به کشور و سرزمین‌های دیگر تعلق دارد و خود را متعلق به بغداد می‌داند، جایی که او را به این سرزمین آورده است."],[953,"قصه آن خواب و گنج زر بگفت","پس ز صدق او دل آن کس شکفت","مولانا از داستان یک خواب و گنج زر صحبت می‌کند که پس از آنکه طرف مقابل به صداقت فردی اشاره می‌کند، دل او شاد و مطمئن می‌شود. در واقع، صداقت فرد باعث خوشحالی و آرامش خاطر دیگران می‌شود."],[953,"بوی صدقش آمد از سوگند او","سوز او پیدا شد و اسپند او","از قسم و سوگند او بوی صدق و راستگویی به مشام رسید و نشان آتش و سوزش او نمایان شد، همان‌طور که اسپند، در زمان سوزاندنش، بخار و بویی از خود ساطع می‌کند."],[953,"دل بیارامد به گفتار صواب","آنچنان که تشنه آرامد به آب","دل وقتی به گفتار درست و صحیح آرام می‌گیرد، مانند کسی است که از تشنگی شدید به آب دست پیدا کرده و آرامش می‌یابد."],[953,"جز دل محجوب کو را علتیست","از نبیش تا غبی تمییز نیست","جز دل پنهان، که به خاطر دلیل خاصی از دیگران پنهان است، از میان چیزهای غیر واضح تمییز نمی‌دهد."],[953,"ورنه آن پیغام کز موضع بود","بر زند بر مه شکافیده شود","اگر آن پیام که از موقعیت خود باشد به درستی منتقل شود، بر دل شکافته (بیدار) اثر می‌گذارد و به آن نفوذ می‌کند."],[953,"مه شکافد وان دل محجوب نی","زانک مردودست او محبوب نی","چهره نورانی ماه شکاف زده می‌شود، اما دل محجوب و پنهان نمی‌تواند از محبوبی که مردود است، شکایت کند."],[953,"چشمه شد چشم عسس ز اشک مبل","نی ز گفت خشک بل از بوی دل","چشم عسس (نگهبان) به دلیل بوی خوش دل (عشق) اشک می‌ریزد و نه به خاطر سخن خشک، بلکه به خاطر احساسی که از آن بوی دل به او دست داده است."],[953,"یک سخن از دوزخ آید سوی لب","یک سخن از شهر جان در کوی لب","سخنی از دوزخ و عذاب به لب می‌آید و سخنی دیگر از شادی و زندگی در شهر جان به لب می‌رسد."],[953,"بحر جان‌افزا و بحر پر حرج","در میان هر دو بحر این لب مرج","در میان دو نوع سخن، یکی که جان را زنده می‌کند و دیگری که پر از غم و گرفتاری است، لب انسان همچون مرجانی است که در میانه این دو دریا قرار دارد."],[953,"چون یپنلو در میان شهرها","از نواحی آید آن‌جا بهر ما","چون یپنلو (شخصی نام‌آور در قصه‌ها) از مناطق دوردست به شهر ما بیاید برای ما، یعنی حضور او در اینجا نویدبخش و خوشحال‌کننده است."],[953,"کاله معیوب قلب کیسه‌بر","کاله پر سود مستشرف چو در","کالا یا متاع ناقصی که دل شخصی را پر می‌کند، در دامن تجار خوشبخت و پر سود تاریکی‌ها و آرزوهای بزرگ را به همراه دارد."],[953,"زین یپنلو هر که بازرگان‌ترست","بر سره و بر قلب‌ها دیده‌ورست","هر انسانی که در کار تجارت موفق‌تر و بازرگان‌تر باشد، دارای دیدی عمیق‌تر و بصیرتی بیشتر در مورد امور و دل‌ها است."],[953,"شد یپنلو مر ورا دار الرباح","وآن دگر را از عمی دار الجناح","در این بیت، یپنلو (که به نظر می‌رسد نامی است برای یک فرد) به کسی تبدیل شده که در کار و تجارت خود موفق است و توانسته است به مقام بالایی دست یابد، در حالی که دیگری که به نظر می‌رسد در مسائلی عمیق‌تر درگیر است، همچنان به حالت شکست و بحران باقی مانده است."],[953,"هر یکی ز اجزای عالم یک به یک","بر غبی بندست و بر استاد فک","هر یک از اجزای عالم به‌طور جداگانه به یک معلم و استاد بزرگ وابسته است و به او نیاز دارد."],[953,"بر یکی قندست و بر دیگر چو زهر","بر یکی لطفست و بر دیگر چو قهر","در این بیت، مولانا به تفاوت‌های موجود در دنیا اشاره دارد؛ در برخی موارد موجودات یا چیزها مانند قند خوشایند و لذت‌بخش‌اند، در حالی که در موارد دیگر مانند زهر دردناک و خطرناک‌اند. همچنین، بعضی از واقعیت‌ها مملو از لطف و نعمت هستند و برخی دیگر حالت قهر و سختی دارند."],[953,"هر جمادی با نبی افسانه‌گو","کعبه با حاجی گواه و نطق‌خو","هر چیز بی‌جان (جمادی) با پیامبر (نبی) قصه‌ای برای گفتن دارد، و کعبه (مکانی مقدس) نیز با زائر (حاجی) گواهی می‌دهد و به وضوح صحبت می‌کند."],[953,"بر مصلی مسجد آمد هم گواه","کو همی‌آمد به من از دور راه","به مسجد که مکانی برای عبادت است، آمدم و هم‌اکنون گواهی می‌دهم که از دور راه به سمت من می‌آید."],[953,"با خلیل آتش گل و ریحان و ورد","باز بر نمرودیان مرگست و درد","با خلیل (ابراهیم)، آتش و بوی گل و ریحان و گلاب هم برای نمرود (حاکم مستبد) شکست و درد آور است، یعنی حتی با عطر و زیبایی نیز نمی‌توان نمرود و نابخردی او را به چالش کشید."],[953,"بارها گفتیم این را ای حسن","می‌نگردم از بیانش سیر من","ای حسن، بارها این موضوع را به تو گفته‌ام، اما نمی‌توانم از گفتن آن خسته شوم و همیشه به آن توجه دارم."],[953,"بارها خوردی تو نان دفع ذبول","این همان نانست چون نبوی ملول","تو بارها نان خورده‌ای تا ضعف و ناتوانی‌ات را از بین ببری، و این همان نانی است که پیامبر گواهی بر کیفیت آن دارد و همچنان برایت جذابیت ندارد."],[953,"در تو جوعی می‌رسد تو ز اعتلال","که همی‌سوزد ازو تخمه و ملال","در وجود تو گرسنگی‌ای به وجود می‌آید که به خاطر ضعف و رنجی که داری، تخم‌گذاری و بی‌حوصلگی را می‌سوزاند."],[953,"هرکه را درد مجاعت نقد شد","نو شدن با جزو جزوش عقد شد","هر کسی که درد گرسنگی او را به شدت رنجور کند، وقتی که می‌خواهد از چیزی نو و تازه بهره‌مند شود، در واقع با هر جزئی از وجودش به این مسأله وابسته و متصل شده است."],[953,"لذت از جوعست نه از نقل نو","با مجاعت از شکر به نان جو","لذت و خوشحالی از گرسنگی به‌دست می‌آید، نه از گفتن داستان‌های تازه. وقتی انسان واقعا گرسنه باشد، از خوردن نان جو بیشتر لذت می‌برد تا از شکر."],[953,"پس ز بی‌جوعیست وز تخمه تمام","آن ملالت نه ز تکرار کلام","سختی و بی‌علاقگی انسان نه به خاطر گرسنگی و بی‌غذایی است، بلکه به علت خستگی و کلافگی از گفتگوهای تکراری رخ می‌دهد."],[953,"چون ز دکان و مکاس و قیل و قال","در فریب مردمت ناید ملال","وقتی که از فروشگاه‌ها و بحث و جدل‌ها، در فریب دادن مردم، خستگی و دلزدگی نمی‌آید، نشان‌دهنده‌ی این است که آن فریب‌کاری و شلوغی به اندازه‌ای است که دیگر تأثیری نمی‌گذارد."],[953,"چون ز غیبت و اکل لحم مردمان","شصت سالت سیریی نامد از آن","اگر شصت سال از غیبت و خوردن گوشت مردم بگذرد، سیر و خسته نخواهی شد، چون انسان در این‌گونه کارها همیشه در جستجوی لذت و طمع است."],[953,"عشوه‌ها در صید شله کفته تو","بی ملولی بارها خوش گفته تو","در درستی سخن تو هیچ شکی نیست و بارها به طور شیرین و با ظرافت، از آن سخن گفته‌ای؛ همچون شکارچی که با لطافت و ترفندهای خاص، طعمه را به دام می‌اندازد."],[953,"بار آخر گوییش سوزان و چست","گرم‌تر صد بار از بار نخست","آخرین باری که او این سخن را می‌گوید، با احساسی سوزان و پرحرارت است و شدت بیانش از بارهای قبلی بیشتر است."],[953,"درد داروی کهن را نو کند","درد هر شاخ ملولی خو کند","درد می‌تواند داروی کهنه را تازه کند و هر دردی که انسان دارد، آن را به نوعی عادت می‌دهد."],[953,"کیمیای نو کننده دردهاست","کو ملولی آن طرف که درد خاست","کیمیایی که دردها را تازه و درمان می‌کند، در جایی قرار دارد که خود درد وجود دارد و شخصی که احساس ناامیدی و کسالت می‌کند، به آنجا نزدیک است."],[953,"هین مزن تو از ملولی آه سرد","درد جو و درد جو و درد درد","مواظب باش که از دل‌زدگی و یأس آه نکشی، بلکه به دنبال درد و رنج خود باش و مدام در جستجوی راه‌های درمان آن باش."],[953,"خادع دردند درمان‌های ژاژ","ره‌زنند و زرستانان رسم باژ","درمان‌های نادرست و فریبنده مانند دردی هستند که انسان را بیشتر می‌آزارند و کسانی که در این کارها مهارت دارند، تنها به فکر بهره‌برداری و کسب درآمد هستند."],[953,"آب شوری نیست درمان عطش","وقت خوردن گر نماید سرد و خوش","آب شور نمی‌تواند عطش را درمان کند، حتی اگر موقع خوردن سرد و خوش‌ذوق باشد."],[953,"لیک خادع گشته و مانع شد ز جست","ز آب شیرینی کزو صد سبزه رست","اما آب شیرینی که سبب رویش گیاهان شده است، به دلیل ظاهر فریبنده‌اش، دیگر دسترس‌پذیر نیست و مانع از جست‌وجو برای آن شده است."],[953,"هم‌چنین هر زر قلبی مانعست","از شناس زر خوش هرجا که هست","خطر و مانع در درک حقیقت، دل و قلب را از شناسایی خوشی و زیبایی‌ها باز می‌دارد. هر جایی که زر واقعی و ارزشمند وجود داشته باشد، وجود دل‌های پر از زرق و برق کاذب مانع شناخت آن است."],[953,"پا و پرت را به تزویری برید","که مراد تو منم گیر ای مرید","با فریب و نیرنگ، پای کسی را قطع کن و به عنوان هدف از آن، خودت را معرفی کن؛ ای مرید، تو باید مرا هدف قرار بدهی."],[953,"گفت دردت چینم او خود درد بود","مات بود ار چه به ظاهر برد بود","گفت که دردی که تو احساس می‌کنی، خود او (یعنی همان شخصی که به او مراجعه کردی) خودش درد است و اگرچه به ظاهر درمانی را ارائه می‌دهد، در واقع خودش دردی است که تو را آزار می‌دهد."],[953,"رو ز درمان دروغین می‌گریز","تا شود دردت مصیب و مشک‌بیز","از درمانی که جعلی و دروغین است فرار کن تا درد تو تبدیل به مصیبت و مشک (عطر خوش) شود."],[953,"گفت نه دزدی تو و نه فاسقی","مرد نیکی لیک گول و احمقی","تو نه دزد هستی و نه فاسق، بلکه انسانی نیک‌خواهی؛ اما در عین حال، فریفته و احمق هستی."],[953,"بر خیال و خواب چندین ره کنی","نیست عقلت را تسوی روشنی","نه باید بر خیال و خواب خود چندان تکیه کنی، زیرا این کار عقل تو را از حقیقت و روشنایی باز می‌دارد."],[953,"بارها من خواب دیدم مستمر","که به بغدادست گنجی مستتر","من بارها خواب دیده‌ام که در بغداد گنجی مخفی و پنهان وجود دارد."],[953,"در فلان سوی و فلان کویی دفین","بود آن خود نام کوی این حزین","در یک جا و در یک محله مشخص، گنجی پنهان شده است و نام آن محله حزین است."],[953,"هست در خانه فلانی رو بجو","نام خانه و نام او گفت آن عدو","در خانه فلانی، گنجی نهفته است که دشمن نام آن خانه و صاحب آن را گفته است."],[953,"دیده‌ام خود بارها این خواب من","که به بغدادست گنجی در وطن","من بارها در خواب دیده‌ام که در بغداد گنجی وجود دارد که مربوط به وطن من است."],[953,"هیچ من از جا نرفتم زین خیال","تو به یک خوابی بیایی بی‌ملال","من از این خیال تو هیچ جایی نرفته‌ام؛ فقط به خاطر یک خواب بی‌دردسر و آرام به بغداد آمده‌ام."],[953,"خواب احمق لایق عقل ویست","هم‌چو او بی‌قیمتست و لاشیست","خواب احمق با عقل او تناسب دارد و به همین دلیل خواب او نیز بی‌ارزش و بی‌فایده است."],[953,"خواب زن کمتر ز خواب مرد دان","از پی نقصان عقل و ضعف جان","منظور مولانا از کلمه خواب در این بیت خوابیدن نیست بلکه منظور او رویا یا همان خواب دیدن است. معنی مصرع اول : (صحت رویای زنان کمتر از مردان است.)"],[953,"خواب ناقص‌عقل و گول آید کساد","پس ز بی‌عقلی چه باشد خواب باد","خواب افرادی که عقل و درک کمی دارند، بی‌کیفیت و بی‌ارزش است؛ بنابراین وقتی عقل کم باشد، خواب نیز بیهوده و توهمی خواهد بود."],[953,"گفت با خود گنج در خانه منست","پس مرا آن‌جا چه فقر و شیونست","او به خود می‌گوید که گنجینه‌ای در خانه‌اش وجود دارد، پس نمی‌فهمد که چرا باید در فقر و غم زندگی کند."],[953,"بر سر گنج از گدایی مرده‌ام","زانک اندر غفلت و در پرده‌ام","من به خاطر اینکه غافل و در پرده‌ام، در کنار گنجی مرده‌ام و خود را گدا می‌دانم."],[953,"زین بشارت مست شد دردش نماند","صد هزار الحمد بی لب او بخواند","او از شنیدن این خبر خوشحال و سرمست شد و دیگر از درد و رنجش خبری نیست؛ به قدری شکرگزاری می‌کند که بی‌وقفه و بی‌زبان صد هزار بار سپاس خدا را می‌گوید."],[953,"گفت بد موقوف این لت لوت من","آب حیوان بود در حانوت من","گفت: این خطر و آسیب‌های ناشی از لوت (محل غارت) به من ارتباطی ندارد، زیرا آب حیات واقعی در وجود من و در درونم هست."],[953,"رو که بر لوت شگرفی بر زدم","کوری آن وهم که مفلس بدم","من به جهانی بزرگ برخورد کردم که در آن، کوری توهمات من باعث ناامیدی و فقر من بود."],[953,"خواه احمق‌دان مرا خواهی فرو","آن من شد هرچه می‌خواهی بگو","هر طور که بخواهی مرا نادان و احمق بدان، من دیگر تحت تأثیر حرف‌های تو نیستم و هر چه می‌خواهی بگو."],[953,"من مراد خویش دیدم بی‌گمان","هرچه خواهی گو مرا ای بددهان","من بدون شک به هدف و خواسته‌ام رسیدم، بنابراین هر چه دوست داری درباره من بگو، ای زبان زشت‌پیشه."],[953,"تو مرا پر درد گو ای محتشم","پیش تو پر درد و پیش خود خوشم","ای دارای مقام و شخصیت، تو به من بگو که چه دردی دارم، زیرا وقتی پیش تو هستم پر از درد و رنج هستم، اما وقتی به خودم فکر می‌کنم احساس خوشی می‌کنم."],[953,"وای اگر بر عکس بودی این مطار","پیش تو گلزار و پیش خویش زار","اگر تو به جای اینکه شاد و خوشحال باشی، غمگین و ناراحت بودی، در این صورت دلم در پیش تو به بهشت می‌رسید و در پیش خودم به دلی رنجور و گلابی می‌شد."],[954,"گفت با درویش روزی یک خسی","که ترا این‌جا نمی‌داند کسی","روزی فردی فرومایه و غافل به درویشی گفت که ای درویش! اینجا هیچ‌کس تو را نمی‌شناسد!"],[954,"گفت او گر می‌نداند عامیم","خویش را من نیک می‌دانم کیم","او (درویش) می‌گوید اگر آن شخص دیگر خودش را نمی‌شناسد، من خوب می‌دانم که کیستم و در حقیقت چه کسی هستم."],[954,"وای اگر برعکس بودی درد و ریش","او بدی بینای من، من کور خویش","اگر تو به جای من بودی و درد و رنج من را می‌کشیدی، می‌توانستی به حقیقت و واقعیت‌ها با بصیرت و هوشمندی نگاه کنی، در حالی که من به خاطر نادانی و خودخواهی‌ام کور و ناتوان از فهم آن‌ها هستم."],[954,"احمقم گیر احمقم من نیک‌بخت","بخت بهتر از لجاج و روی سخت","من به خاطر لجاجت و سخت‌گیری‌ام، احمق به حساب می‌آیم، اما در عین حال خود را خوشبخت می‌دانم. بخت من از این لجاجت و سرسختی بهتر است."],[954,"این سخن بر وفق ظنّت می‌جهد","ورنه بختم داد عقلم هم دهد","این صحبت بر اساس گمان و خیال من پیش می‌آید، وگرنه سرنوشتم به عقل من نیز مربوط می‌شود."],[955,"باز گشت از مصر تا بغداد او","ساجد و راکع ثناگر شکرگو","او که از مصر به بغداد بازگشت، در حال سجده و رکوع، خدا را ستایش کرده و شکرگزار است."],[955,"جمله ره حیران و مست او زین عجب","ز انعکاس روزی و راه طلب","او در حیرت و سرمستی است و هر چه به او می‌رسد، ناشی از شگفتی و انعکاس روزی‌اش و مسیری است که برای جستجوی حق و حقیقت پیموده است."],[955,"کز کجا اومیدوارم کرده بود","وز کجا افشاند بر من سیم و سود","نمی‌دانم از کجا امید به من داده شده و از کجا نعمت و ثروت را بر من نازل کرده است."],[955,"این چه حکمت بود که قبله مراد","کردم از خانه برون گمراه و شاد","این چه حکمت و تدبیری است که خواسته‌ها و مقاصد من را از خانه و جایی که در آن قرار داشته‌ام، دور کرده و در عین حال شاد و مغموم به حال خودم کرده است؟"],[955,"تا شتابان در ضلالت می‌شدم","هر دم از مطلب جداتر می‌بدم","در حالی که به سرعت به سوی گمراهی می‌رفتم، هر لحظه از هدف اصلی و مطلب واقعی دورتر می‌شدم."],[955,"باز آن عین ضلالت را به جود","حق وسیلت کرد اندر رشد و سود","به خاطر بخشش و نعمت‌های الهی، آن شخص توانست از گمراهی بیرون بیاید و به رشد و فایده‌ای دست یابد."],[955,"گمرهی را منهج ایمان کند","کژروی را محصد احسان کند","کسی که در گمراهی است، با ایمان به هدایت می‌رسد و کسی که به طور نادرست رفتار می‌کند، از طریق نیکی و احسان به راه راست هدایت می‌شود."],[955,"تا نباشد هیچ محسن بی‌وجا","تا نباشد هیچ خاین بی‌رجا","هیچ انسانی نمی‌تواند بی‌دلیل کار نیک یا بدی انجام دهد؛ یعنی هر خوبی از محبتی درون انسان برمی‌خیزد و هر خیانت نیز به دلیل نداشتن صداقت و وفاداری است."],[955,"اندرون زهر تریاق آن حفی","کرد تا گویند ذواللطف الخفی","درون زهر، داروی شفابخش آن است که تنها باید افشای لطافت و لطف خفی را نشان دهد. به این معنا که در سختی‌ها و گرفتاری‌ها، رحمت و لطف خداوند نهفته است."],[955,"نیست مخفی در نماز آن مکرمت","در گنه خلعت نهد آن مغفرت","نماز به عنوان یک عمل عبادی و روحانی، چیزی نیست که در آن راز و زیبایی نهفته باشد، بلکه در گناهان نیز با توبه و طلب بخشش، لباس عفوا و مغفرت بر سر پوشیده می‌شود."],[955,"منکران را قصد اذلال ثقات","ذل شده عز و ظهور معجزات","منکران به منظور خوار کردن و تحقیر پیامبران راستین، به دنبال ذلت و از بین بردن عزت آن‌ها و نیز نشانه‌های معجزات خدایند."],[955,"قصدشان ز انکار ذل دین بده","عین ذل عز رسولان آمده","هدف این افراد که ایمان نمی‌آورند، به ذلت کشاندن دین و تحقیر نبیان است. در واقع، منکران با انکار، باعث ذلت خود و دین می‌شوند و پیامبران خدا به عزت و احترام آمده‌اند."],[955,"گر نه انکار آمدی از هر بدی","معجزه و برهان چرا نازل شدی","اگر انکاری بر هر بدی وجود ندارد، پس معجزه و برهان چرا نازل شده است؟"],[955,"خصم منکر تا نشد مصداق‌خواه","کی کند قاضی تقاضای گواه","شخص منکر و مخالف، زمانی که به دنبال مصداق و دلیل روشن نباشد، چگونه قاضی می‌تواند از او خواسته‌ای برای گواهی بخواهد؟"],[955,"معجزه هم‌چون گواه آمد زکی","بهر صدق مدعی در بی‌شکی","معجزه مانند یک شاهد به وجود آمد تا ادعای راستین را بدون هیچ شکی ثابت کند."],[955,"طعن چون می‌آمد از هر ناشناخت","معجزه می‌داد حق و می‌نواخت","هر زمانی که طعنه و زخم‌زبان از سوی افرادی ناشناس و بی‌خبر به سمت او می‌آمد، خداوند با معجزاتش پاسخ می‌داد و او را تسکین می‌کرد."],[955,"مکر آن فرعون سیصد تو بده","جمله ذل او و قمع او شده","مکر فرعون، هرچند سیصد تدبیر داشته باشد، در نهایت به ذلت و سقوط او منجر شده است."],[955,"ساحران آورده حاضر نیک و بد","تا که جرح معجزه موسی کند","ساحران همواره عیب‌جو و بدگو هستند و برای اینکه معجزه موسی را زیر سؤال ببرند، او را به چالش می‌طلبند."],[955,"تا عصا را باطل و رسوا کند","اعتبارش را ز دلها بر کند","عصا را باید از اهمیت و اعتبار بیندازد و به گونه‌ای رسوا کند که دیگر هیچ کس به آن دل نبندد و از آن در دل‌ها جایی نداشته باشد."],[955,"عین آن مکر آیت موسی شود","اعتبار آن عصا بالا رود","عین مکر فرعون که در برابر آیت‌های موسی به کار رفت، اعتبار و ارزش آن عصا (عصای موسی) را بالا می‌برد. به عبارت دیگر، همان‌طور که فرعون با حقایق انکار کرد، همان مکر باعث می‌شود که معجزه موسی بیشتر مورد توجه قرار گیرد."],[955,"لشکر آرد او پگه تا حول نیل","تا زند بر موسی و قومش سبیل","او لشکری به سوی نیل می‌آورد تا به موسی و قومش آسیب برساند و راهی برایشان بگشاید."],[955,"آمنی امت موسی شود","او به تحت‌الارض و هامون در رود","شخصی که به او اشاره شده، در حالی که در دنیای زیرین (تحت‌الارض) به سر می‌برد، تحت حمایت و هدایت امت موسی، در آب و هوای بارانی و خنک زندگی می‌کند."],[955,"گر به مصر اندر بدی او نامدی","وهم از سبطی کجا زایل شدی","اگر در مصر بد باشی و نام تو به بدی برود، چه وهمی از سبط (قبیله) داری که از بین رفته‌ای؟"],[955,"آمد و در سبط افکند او گداز","که بدانک امن در خوفست راز","او (شخصی که بازگشته) به استقبال سبط آمده و در حالتی خاص و داغ، وجودش را در آنجا رها کرده است. این وضعیت به‌نوعی نشان‌دهنده‌ی این است که در میان ترس و نگرانی، به امنیت و آرامش یافته است و این راز عمیق و پنهان را می‌سازد."],[955,"آن بود لطف خفی کو را صمد","نار بنماید خود آن نوری بود","لطفی که در اینجا به آن اشاره می‌شود، لطف پنهانی است که صمد، یعنی الله، آن را به کسی نشان می‌دهد. این نور خاص، جلوه‌ای از حقیقت خداوند است که برای فردی خاص نمایان شده است."],[955,"نیست مخفی مزد دادن در تقی","ساحران را اجر بین بعد از خطا","مزد و پاداشی که به ساحران (اشخاصی که در مسیر حقیقت یا عرفان به خطا رفته‌اند) داده می‌شود، پس از ارتکاب خطا نهان و پنهان نیست."],[955,"نیست مخفی وصل اندر پرورش","ساحران را وصل داد او در برش","وصل و ارتباط با حقیقت و معنویت در پرورش ساحران، به‌طور واضح و آشکار وجود دارد، زیرا او (خدا) در نزدیکی و ارتباط با آن‌ها است."],[955,"نیست مخفی سیر با پای روا","ساحران را سیر بین در قطع پا","سیر و حرکت سحرآمیز و شگفت‌انگیز ساحران در مسیر حق و حقیقت، بسیار آشکار و بدیهی است، اما کسانی که در این راه قدم نمی‌گذارند، از درک و مشاهده این جاذبه و حقیقت ناتوانند."],[955,"عارفان زانند دایم آمنون","که گذر کردند از دریای خون","عارفان همیشه در امنیت هستند، زیرا از سختی‌ها و خطرات دنیا (که به نوعی مثل دریای خون است) عبور کرده‌اند و به فضایل و حقیقت رسیده‌اند."],[955,"امنشان از عین خوف آمد پدید","لاجرم باشند هر دم در مزید","آرامش عارفان از عمق ترس به وجود آمده است، بنابراین همواره در حالت افزونی و رشد خواهند بود."],[955,"امن دیدی گشته در خوفی خفی","خوف بین هم در امیدی ای حفی","امنی که مشاهده می‌کنی، در حقیقت به خاطر ترس پنهانی است، پس در همین حال که در ترس هستی، امیدی نیز وجود دارد."],[955,"آن امیر از مکر بر عیسی تند","عیسی اندر خانه رو پنهان کند","امیر، از روی نیرنگ، به سوی عیسی حمله‌ور می‌شود و عیسی برای حفظ خود، به داخل خانه رفته و خود را پنهان می‌کند."],[955,"اندر آید تا شود او تاجدار","خود ز شبه عیسی آید تاج‌دار","او (امیر) به درون می‌آید تا به مقام تاج‌داری برسد و از شبهه عیسی، به مقام شاهی نائل شود."],[955,"هی میاویزید من عیسی نیم","من امیرم بر جهودان خوش‌پیم","من عیسی (ای عیسی) نیستم که به او می‌گویید و شما به او می‌بالید؛ من امیر و سالار هستم بر یهودیانی که به خوبی و نیکی معروفند."],[955,"زوترش بردار آویزید کو","عیسی است از دست ما تخلیط‌جو","کسی را که به او بیان می‌شود «آویزید» و به معنای هوشیاری و تمایز از دیگران فراخوانده می‌شود، از ما جدا کن که او عیسی است و به دنبال حقیقت است."],[955,"چند لشکر می‌رود تا بر خورد","برگ او فی گردد و بر سر خورد","بسیاری از سربازان به سمت او می‌روند تا با او درگیر شوند، اما در نهایت برگ او از این درگیری نجات پیدا می‌کند و بر سر آن‌ها می‌افتد."],[955,"چند در عالم بود برعکس این","زهر پندارد بود آن انگبین","در این دنیا مواردی وجود دارد که به نظر می‌رسد تلخ و مضر هستند، ولی در واقع می‌توانند به نفع انسان باشند و شیرین مثل عسل (انگبین) تمام شوند."],[955,"بس سپه بنهاده دل بر مرگ خویش","روشنیها و ظفر آید به پیش","خود را آماده مرگ کرده‌ای و دل به آن سپرده‌ای، در این حالت، روشنی و پیروزی به تو روی خواهد آورد."],[955,"ابرهه با پیل بهر ذل بیت","آمده تا افکند حی را چو میت","ابرهه با فیل‌هایش برای ویرانی خانه خدا آمده تا مقام و منزلت آن را پایین بیاورد و مانند یک جسد بی‌جان کند."],[955,"تا حریم کعبه را ویران کند","جمله را زان جای سرگردان کند","این بیت به این موضوع اشاره دارد که ابرهه با قصد ویرانی کعبه، همه را از سمت آن محل گیج و سرگردان می‌کند. او به خاطر هدفش، حریم کعبه را خراب کرده و باعث سردرگمی مردم می‌شود."],[955,"تا همه زوار گرد او تنند","کعبه او را همه قبله کنند","زائران به دور او جمع می‌شوند و او محور توجه و عبادت همه قرار می‌گیرد، به‌طوری‌که کعبه حقیقی و مورد قبله‌ی همه‌ی آن‌ها خواهد بود."],[955,"وز عرب کینه کشد اندر گزند","که چرا در کعبه‌ام آتش زنند","عرب به دلایل کینه‌ورزی از کسی انتقام می‌گیرد که در کعبه آتش انداخته و به او می‌گوید که چرا چنین کاری کرده است. این بیت نشان‌دهنده حسادت و خشمی است که از این عمل به وجود آمده است."],[955,"عین سعیش عزت کعبه شده","موجب اعزاز آن بیت آمده","کوشش و تلاش او باعث شده است که کعبه عزت و کرامت پیدا کند و این بیت مورد احترام و ارادت قرار گیرد."],[955,"مکیان را عز یکی بد صد شده","تا قیامت عزشان ممتد شده","عزت مکیان (ساکنان مکه و کعبه) همیشگی و پایدار شده است و تا قیامت این عزتشان ادامه خواهد داشت."],[955,"او و کعبه او شده مخسوف‌تر","از چیست این از عنایات قدر","او و خانه‌اش (کعبه) به قدری در سایه عنایات الهی در خفا و ناپیدا شده‌اند که قابل تصور نیست."],[955,"از جهاز ابرهه هم‌چون دده","آن فقیران عرب توانگر شده","فقیران عرب مانند دده (دنده) ابرهه، به واسطه شگفتی‌ها و الطاف الهی، تبدیل به افرادی ثروتمند و برخوردار شده‌اند."],[955,"او گمان برده که لشکر می‌کشید","بهر اهل بیت او زر می‌کشید","او فکر می‌کند که لشکر برای کمک به اهل بیت پیامبر (ص) به میدان آمده‌اند، در حالی که در حقیقت برای به دست آوردن ثروت و زر در حال مبارزه هستند."],[955,"اندرین فسخ عزایم وین همم","در تماشا بود در ره هر قدم","در این شرایط یعنی زمانی که همه برنامه‌ها و آرزوها تغییر کرده و ناامید شده است، اما در عین حال، فرد به تماشا و مشاهده زیبایی‌ها و جلوه‌ها در هر قدم ادامه می‌دهد."],[955,"خانه آمد گنج را او باز یافت","کارش از لطف خدایی ساز یافت","آن شخص به خانه برگشت و گنجی را پیدا کرد که در واقع نعمت و برکت خداوند بود و این نتیجه لطف و مهربانی خدا به اوست."],[956,"آن دو گفتندش که اندر جان ما","هست پاسخ‌ها چو نجم اندر سما","آن دو نفر به او گفتند که در دل ما پاسخ‌هایی وجود دارد، مانند ستاره‌هایی که در آسمان درخشانند."],[956,"گر نگوییم آن نیاید راست نرد","ور بگوییم آن دلت آید به درد","اگر ما چیزی را نگوییم، حقیقت آن به درستی روشن نمی‌شود؛ اما اگر بگوییم، دل تو از آنچه می‌گوییم به درد خواهد آمد."],[956,"هم‌چو چغزیم اندر آب از گفت الم","وز خموشی اختناقست و سقم","ما مانند الک‌هایی هستیم که در آب قرار گرفته‌اند، از صدای جوی آب و گفت‌و‌گو می‌گریزیم. در سکوت و عدم گفت‌وگو، حالتی از فشار و ضعف به ما دست می‌دهد."],[956,"گر نگوییم آتشی را نور نیست","ور بگوییم آن سخن دستور نیست","اگر ما درباره آتش سخنی نگویم، نوری نمی‌تابد؛ و اگر بگوییم، این کار به خودی خود یک قانون نیست."],[956,"در زمان برجست کای خویشان وداع","انما الدنیا و ما فیها متاع","در زمان جدایی، ای خویشان، بدانید که دنیا و آنچه در آن است تنها کالایی فانی و زودگذر است."],[956,"پس برون جست او چو تیری از کمان","که مجال گفت کم بود آن زمان","او به سرعت و بی‌خبر مانند تیری از کمان بیرون رفت، زیرا در آن لحظه فرصتی برای صحبت کردن نبود."],[956,"اندر آمد مست پیش شاه چین","زود مستانه ببوسید او زمین","او (شیدا) به طرز مستی و شتابزده وارد پیش شاه چین می‌شود و با حالتی شگفت‌انگیز و سرمست، زمین را می‌بوسد."],[956,"شاه را مکشوف یک یک حالشان","اول و آخر غم و زلزالشان","شاه از احوال برادران به خوبی آگاه است و او تمام غم‌ها و مشکلات آن‌ها را می‌شناسد."],[956,"میش مشغولست در مرعای خویش","لیک چوپان واقفست از حال میش","میش‌ها در حال چرا و چراگاه خود هستند، اما چوپان از وضعیت و حال میش‌ها باخبر است."],[956,"کلکم راع بداند از رمه","کی علف‌خوارست و کی در ملحمه","همه شما، همانند چوپان، باید بدانید که چه کسی در حال چرا و علف‌خواری است و چه کسی در میدان جنگ و نبرد است."],[956,"گرچه در صورت از آن صف دور بود","لیک چون دف در میان سور بود","هرچند در ظاهر از آن صف، که به جمعیت اشاره دارد، دور است، ولی مانند دفی (طبل) است که در وسط جشن و سرور می‌درخشد و توجه همه را به خود جلب می‌کند."],[956,"واقف از سوز و لهیب آن وفود","مصلحت آن بد که خشک آورده بود","آگاه بوده است از آتش و شدت احساساتی که در دل آن جمع وجود دارد، اما به خاطر مصلحت، به آن‌ها زنگ می‌زند که محبت واقعی را که از خشکی و سردی دور است، به آن‌ها بیاموزد."],[956,"در میان جانشان بود آن سمی","لیک قاصد کرده خود را اعجمی","در دل آن افراد، سمّی وجود داشت که باعث آسیب و درد آن‌ها می‌شد، اما به خاطر عشق و محبت، خود را به زبان بیگانه (اعجمی) نشان می‌دادند و نمی‌خواستند به دیگران آسیب برسانند."],[956,"صورت آتش بود پایان دیگ","معنی آتش بود در جان دیگ","ظاهر دیگ به شکل آتش است، اما حقیقت آن چیزی فراتر از ظاهر است؛ یعنی معنای واقعی، همان آتش، در درون دیگ وجود دارد."],[956,"صورتش بیرون و معنیش اندرون","معنی معشوق جان در رگ چو خون","ظاهر او در بیرون همچون آتش است، ولی معنای حقیقی‌اش در دل و درون او نهفته است. عشق معشوق مانند خون در رگ‌ها جاری است و جان عاشق را سیراب می‌کند."],[956,"شاه‌زاده پیش شه زانو زده","ده معرف شارح حالش شده","شاه‌زاده در حضور پادشاه زانو زده و ده معرف یعنی دلیلی که حال او را شرح دهد، شده است."],[956,"گرچه شه عارف بد از کل پیش پیش","لیک می‌کردی معرف کار خویش","هرچند که پادشاه (شه) در برابر همه عارفان برتر و بزرگ‌تر بود، اما تو (برادران) به خوبی وظیفه و کار خود را انجام می‌دادی و می‌دانستی که باید چه کنی."],[956,"در درون یک ذره نور عارفی","به بود از صد معرف ای صفی","در یک ذره، یعنی در کوچک‌ترین و کم‌ترین موجود، نوری از معرفت (درک و شناخت) یک عارف وجود دارد که از همه معرفت‌ها و دانایی‌های دیگر بهتر و برتر است. عارف در اینجا به معنای فردی با درک عمیق و روحانی به کار رفته است."],[956,"گوش را رهن معرف داشتن","آیت محجوبیست و حزر و ظن","گوش را به شناخت و آگاهی دیگری شنیدن آیتی از وجود پنهان و همچنین احتیاط و تردید است."],[956,"آنک او را چشم دل شد دیدبان","دید خواهد چشم او عین العیان","هر کسی که با چشم دل به حقیقتی بنگرد، آن حقیقت را واضح و آشکار می‌بیند، به طوری که دیگر نیازی به دیدن معمولی ندارد و همه‌چیز برای او روشن و واضح می‌شود."],[956,"با تواتر نیست قانع جان او","بل ز چشم دل رسد ایقان او","قانع شدن او فقط با تکرار و مکرر گفتن نیست، بلکه او با چشم دل یقین و شناختی عمیق به دست می‌آورد."],[956,"پس معرف پیش شاه منتجب","در بیان حال او بگشود لب","پس شخصی معروف و محترم در حضور پادشاه، وضعیت و حال او را با کلامی واضح و شیوا بیان کرد."],[956,"گفت شاها صید احسان توست","پادشاهی کن که بی بیرون شوست","گفت: ای پادشاه، تو مانند صیدی هستی که به لطف و احسان و مهر خود ما را به خود جلب کرده‌ای، پس پادشاهی کن و تلاش کن که از این حالت خارج نشویم."],[956,"دست در فتراک این دولت زدست","بر سر سرمست او بر مال دست","من به دام این دولت افتاده‌ام و در حالی که سرمستم، بر اموال او سلطه دارم."],[956,"گفت شه هر منصبی و ملکتی","که التماسش هست یابد این فتی","پادشاه گفت هر کسی که به دنبال مقام و سلطنت است و به خاطر آن التماس می‌کند، باید این جوان را به عنوان همکار و همراه خود داشته باشد."],[956,"بیست چندان ملک کو شد زان بری","بخشمش اینجا و ما خود بر سری","اگر بیست بار ملک و پادشاهی به کسی بدهم، اینجا در این دنیا کم است و من خود در زمین بزرگ‌تری خواهم بود."],[956,"گفت تا شاهیت در وی عشق کاشت","جز هوای تو هوایی کی گذاشت","گفت تا عشق تو را در دل او کاشته، هیچ هوای دیگری را در دلش جای نداد."],[956,"بندگی تش چنان درخورد شد","که شهی اندر دل او سرد شد","بندگی او به قدری در دل شه تاثیر گذاشت که عشق و محبت شاه نسبت به او کم‌رنگ شد."],[956,"شاهی و شه‌زادگی در باختست","از پی تو در غریبی ساختست","شاهی و مقام‌های بزرگ از عشق تو رها شده و برای تو در غم دوری از تو زندگی را تحمل می‌کند."],[956,"صوفیست انداخت خرقه وجد در","کی رود او بر سر خرقه دگر","صوفی، در حالتی از عشق و وجد، خرقه‌اش را به دور می‌افکند؛ حالا او کجا می‌تواند بر سر خرقه‌ی دیگری برود؟"],[956,"میل سوی خرقه داده و ندم","آنچنان باشد که من مغبون شدم","میل من به آن خرقه‌ای که به من داده‌اند، به حدی است که گویی در این عشق و محبت به من خیانت شده است."],[956,"باز ده آن خرقه این سو ای قرین","که نمی‌ارزید آن یعنی بدین","ای همدم، بازگردان آن خرقه (پوشش)، زیرا این گنجینه ارزش چندانی نداشت که من چنین گمراه شدم."],[956,"دور از عاشق که این فکر آیدش","ور بیاید خاک بر سر بایدش","اگر کسی از عشق دور باشد، چنین فکری برای او پیش می‌آید که اگر بیفتد، باید خود را به خاک بیفکند و به حال زار خود غصه بخورد."],[956,"عشق ارزد صد چو خرقه کالبد","که حیاتی دارد و حس و خرد","عشق به اندازه ارزش صد خرقه تن (کالبد) می‌ارزد، زیرا عشق حیات و احساس و عقل را در وجود انسان به ارمغان می‌آورد."],[956,"خاصه خرقه ملک دنیا کابترست","پنج دانگ مستیش درد سرست","خرقه ملک دنیا مانند کاغذی است که در آن کاملا غرق شده‌ایم و این دنیا ما را مست و گمراه می‌کند، در حالی که عواقب این مستی، درد و رنج فراوان به همراه دارد."],[956,"ملک دنیا تن‌پرستان را حلال","ما غلام ملک عشق بی‌زوال","دنیا برای کسانی که تن‌پرست‌اند، مجاز است و مشکلی ندارد، اما ما که غلام عشق ابدی هستیم، از دنیا رها شده‌ایم و به آن وابسته نیستیم."],[956,"عامل عشقست معزولش مکن","جز به عشق خویش مشغولش مکن","عشق عامل اصلی زندگی و وجود انسان است، پس او را از عشق بی‌نیاز نکن و به غیر از عشق خود مشغول نکن."],[956,"منصبی کانم ز رؤیت محجبست","عین معزولیست و نامش منصبست","منصبی که من به خاطر دیدار محبوب از آن محرومم، مانند منصب و مقام است، اما خود آن منصب در واقع از من دور است و چیزی از آن ندارم."],[956,"موجب تاخیر اینجا آمدن","فقد استعداد بود و ضعف فن","علت تأخیر در آمدن به اینجا، نبودن استعداد و ناتوانی در فن و هنر بوده است."],[956,"بی ز استعداد در کانی روی","بر یکی حبه نگردی محتوی","اگر بی‌استعداد باشی و نتوانی خود را در کانی نگه‌داری، مثل دانه‌ای نخواهی توانست به محتوی و مغز خود برسید. در واقع، نداشتن استعداد و توان، مانع رسیدن به عمق و حقیقت چیزی می‌شود."],[956,"هم‌چو عنینی که بکری را خرد","گرچه سیمین‌بر بود کی بر خورد","چنان‌که عنابی که نارس است، هرچند رنگش نقره‌ای و زیبا باشد، به خوردن نمی‌آید و فاقد ارزش است."],[956,"چون چراغی بی ز زیت و بی فتیل","نه کثیرستش ز شمع و نه قلیل","انسانی که بدون علم و سوءاستفاده از عقل عمل کند، نه نیکو است و نه اندک؛ مانند چراغی که نه روغن دارد و نه فتیل، بنابراین نه می‌تواند نور تولید کند."],[956,"در گلستان اندر آید اخشمی","کی شود مغزش ز ریحان خرمی","اگر شخصی به باغی سرسبز وارد شود، آیا ممکن است که عقل و فکر او تحت تأثیر عطر و بوی خوش گل‌ها و گیاهان قرار گیرد و شاداب شود؟"],[956,"هم‌چو خوبی دلبری مهمان غر","بانگ چنگ و بربطی در پیش کر","چون زیبایی دل‌بردار مانند یک مهمان با شکوه و جذاب است، صدای چنگ و بربط (سازهای موسیقی) در برابر کر (حس ناپایداری و توهم) به گوش می‌رسد."],[956,"هم‌چو مرغ خاک که آید در بحار","زان چه یابد جز هلاک و جز خسار","مانند مرغی که از خاک برخاسته و به باغ‌های بهار می‌رود، او جز نابودی و زیان چیزی به دست نخواهد آورد."],[956,"هم‌چو بی‌گندم شده در آسیا","جز سپیدی ریش و مو نبود عطا","مانند گندمی که در آسیا آرد شده، چیزی جز سفیدی ریش و مو نصیبش نخواهد شد. این بدان معناست که در پایان این فرآیند سخت و طاقت‌فرسا، تنها آثار فیزیکی مانند سفیدی مو و ریش باقی می‌ماند و چیزی از اصل وجود و هویت او باقی نمی‌ماند."],[956,"آسیای چرخ بر بی‌گندمان","موسپیدی بخشد و ضعف میان","آسیاب چرخ زندگی، فقط با دانه‌های گندم سفید می‌شود و در آن‌ها ضعف و پیری به وجود می‌آید."],[956,"لیک با باگندمان این آسیا","ملک‌بخش آمد دهد کار و کیا","ولی با وجود اینکه این آسیاب برای گندم افتاده است، امّا کار و تقدیر سلطنت را به او می‌بخشد."],[956,"اول استعداد جنت بایدت","تا ز جنت زندگانی زایدت","برای اینکه از زندگی بهشتی برخوردار شوی، ابتدا باید قابلیت و آمادگی لازم را در خود ایجاد کنی."],[956,"طفل نو را از شراب و از کباب","چه حلاوت وز قصور و از قباب","کودک تازه متولد شده از شراب و کباب خوشی و لذتی نمی‌برد، زیرا هنوز درک و تجربه‌ای از این چیزها ندارد و در حال حاضر بدنش به خوراک و نوشیدنی مناسب سنش نیاز دارد."],[956,"حد ندارد این مثل کم جو سخن","تو برو تحصیل استعداد کن","این مثل می‌گوید که در مجالس صحبت و گفتگو، هیچ حدی وجود ندارد و تو باید تلاش کنی و استعداد خود را پرورش دهی. از این رو، به جای اینکه بخواهی در حد و حدود خاصی صحبت کنی، باید به یادگیری و پیشرفت بپردازی."],[956,"بهر استعداد تا اکنون نشست","شوق از حد رفت و آن نامد به دست","برای رسیدن به استعداد و توانایی، شوق و علاقه شدید تا به حال در دل من وجود داشته است، اما نتیجه‌ای که می‌خواستم هنوز به دست نیامده است."],[956,"گفت استعداد هم از شه رسد","بی ز جان کی مستعد گردد جسد","استعداد (توانمندی) انسانی از طرف خداوند به انسان عطا می‌شود و بدون روح و جان، این استعداد نمی‌تواند شکوفا شود."],[956,"لطف‌های شه غمش را در نوشت","شد که صید شه کند او صید گشت","لطف‌ها و رحمت‌های پادشاه غم او را کم کرده و در دلش نوشته شده است که او هم به دستور پادشاه صید شود و در نتیجه خود به صید پادشاه تبدیل شده است."],[956,"هر که در اشکار چون تو صید شد","صید را ناکرده قید او قید شد","هر کسی که در ظاهر مانند تو گرفتار عشق شده است، به طور طبیعی در این عشق به دام افتاده و قید و بند آن (عشق) او را در خود نگه می‌دارد."],[956,"هرکه جویای امیری شد یقین","پیش از آن او در اسیری شد رهین","هر کسی که به دنبال به دست آوردن مقام و سلطنت است، باید بداند که پیش از رسیدن به آن، خود در بند و اسیر چیزی است."],[956,"عکس می‌دان نقش دیباجه جهان","نام هر بنده جهان خواجه جهان","سراسر جهان تصویرگر زیبایی‌ها و جلوه‌های مختلف است و هر انسانی که در این جهان وجود دارد، در واقع نماینده و صاحب آن زیبایی‌هاست."],[956,"ای تن کژ فکرت معکوس‌رو","صد هزار آزاد را کرده گرو","ای بدن! تو با فکری منحرف و معکوس، هزاران انسان آزاد را به بند کشیده‌ای."],[956,"مدتی بگذار این حیلت پزی","چند دم پیش از اجل آزاد زی","برای مدتی از تلاش برای فریب دادن دیگران دست بکش و چند لحظه‌ای قبل از مرگ به آزادی حقیقی برس."],[956,"ور در آزادیت چون خر راه نیست","هم‌چو دلوت سیر جز در چاه نیست","اگر در آزادی‌ات مانند خر هیچ راهی وجود ندارد، پس قلب تو همچون دل خر تنها در چاه است و نمی‌تواند به سیر و گشت بیشتر بپردازد."],[956,"مدتی رو ترک جان من بگو","رو حریف دیگری جز من بجو","مدتی به من بی‌محلی کن و جانم را ترک بگو، به دنبال دوست دیگری جز من باش."],[956,"نوبت من شد مرا آزاد کن","دیگری را غیر من داماد کن","حالا نوبت من است که مرا رها کنی و کسی دیگر را جز من، شوهر خود قرار دهی."],[956,"ای تن صدکاره ترک من بگو","عمر من بردی کسی دیگر بجو","ای جسمی که در کارهای مختلف و دارای خواسته‌های گوناگون هستی، به من بگو که چرا عمرم را به بی‌دست و پا گرفته‌ای و به کسی دیگر فکر می‌کنی؟"],[957,"جوحی هر سالی ز درویشی به فن","رو بزن کردی کای دلخواه زن","جوحی هر سال با توانایی خاص خود به میان درویشان می‌رفت تا دلخواه خودش را از آن‌ها به‌دست آورد."],[957,"چون سلاحت هست رو صیدی بگیر","تا بدوشانیم از صید تو شیر","چون ابزار و سلاحی برای شکار داری، بهتر است که شیری را بگیری تا ما از شکار تو بهره‌مند شویم."],[957,"قوس ابرو تیر غمزه دام کید","بهر چه دادت خدا از بهر صید","ابرو همانند قوس، و غمزه همانند تیر است که در دام فریب و مکر قرار دارد؛ پس هر چه خدا به تو داده، برای چه چیزی است؟ آیا برای شکار و فریب دیگران است؟"],[957,"رو پی مرغی شگرفی دام نه","دانه بنما لیک در خوردش مده","به دنبال پرنده‌ای بزرگ نرو، زیرا آن را با دانه‌ای فریب نده، اما دانه‌ای که در اختیارش قرار می‌دهی برایش مناسب نباشد."],[957,"کام بنما و کن او را تلخ‌کام","کی خورد دانه چو شد در حبس دام","این بیت به این معناست که هرچند قاضی به زن جوحی وعده کامروایی می‌دهد، اما باید توجه کند که اگر او را در دام بیندازد و تلخ‌کامش کند، دیگر از آن دانه‌ای که به او داده، لذتی نخواهد برد. در واقع، قاضی در این وضعیت، خود را در دام دشواری و ناکامی قرار می‌دهد."],[957,"شد زن او نزد قاضی در گله","که مرا افغان ز شوی ده‌دله","زن جوحی به نزد قاضی رفت و با ناله و شکایت از شوهرش گفت که او درد و زجر زیادی به او می‌دهد."],[957,"قصه کوته کن که قاضی شد شکار","از مقال و از جمال آن نگار","قاضی به خاطر سخنان و زیبایی آن زن، گرفتار و مجذوب او شد و داستان را طولانی نکن."],[957,"گفت اندر محکمه‌ست این غلغله","من نتانم فهم کردن این گله","زن جوحی می‌گوید که در این دادگاه شلوغ و پرسر و صدا، نمی‌توانم سر و ته این مسئله و مشکلات را درک کنم."],[957,"گر به خلوت آیی ای سرو سهی","از ستم‌کاری شو شرحم دهی","اگر ای سرو زیبا به خلوت بیایی، از ظلم و ستمی که به من شده، رازهای خود را برایم بازگو کن."],[957,"گفت خانه تو ز هر نیک و بدی","باشد از بهر گله آمد شدی","گفته می‌شود که خانه تو، چه خوب و چه بد، به خاطر ورود آدم‌های ناراحت و غمگین پر شده است."],[957,"خانه سر جمله پر سودا بود","صدر پر وسواس و پر غوغا بود","خانه‌ای که در میان همه چیزها، پر از افکار و خیالات است، در واقع جایی بوده که سر و صدا و نگرانی زیادی در آن وجود دارد."],[957,"باقی اعضا ز فکر آسوده‌اند","وآن صدور از صادران فرسوده‌اند","بقیه اعضای بدن در آرامش و راحتی هستند و فقط سر از اندیشیدن خسته و فرسوده شده است."],[957,"در خزان و باد خوف حق گریز","آن شقایق‌های پارین را بریز","در هوای خنک و درختان خشکیده پاییز، برای فرار از ترس خدا، گل‌های شقایق پارسال را باغ‌ها بریزید."],[957,"این شقایق منع نو اشکوفه‌هاست","که درخت دل برای آن نماست","این شقایق، نماد زیبایی و عشق و جوانی است که در حقیقت نشانه‌ای از دل خوش و شاداب است، و درخت دل نیز برای نشان دادن این زیبایی و احساسات پر میوه و سرشار از زندگی به وجود آمده است."],[957,"خویش را در خواب کن زین افتکار","سر ز زیر خواب در یقظت بر آر","برای رهایی از این فکر و خیال، خود را به خواب ببر و بگذار خواب غفلت بر تو غلبه کند. سپس از زیر خواب بیدار شو و به هوش و آگاهی بازگرد."],[957,"هم‌چو آن اصحاب کهف ای خواجه زود","رو به ایقاظا که تحسبهم رقود","ای خواجه، مانند آن مردان غاری که خوابشان نامتناهی بود، سریعا به بیداری شو؛ زیرا تو گمان می‌کنی آن‌ها فقط در خوابند."],[957,"گفت قاضی ای صنم معمول چیست","گفت خانه این کنیزک بس تهیست","قاضی به زن جوحی می‌گوید که این حرف‌ها معمول است و می‌گوید خانه این کنیزک (زن جوحی) بسیار خالی و بی‌مزد است."],[957,"خصم در ده رفت و حارس نیز نیست","بهر خلوت سخت نیکو مسکنیست","خصم (دشمن یا رقیب) به ده (محل) رفت و نگهبانی نیز در آنجا نیست، بنابراین این مکان برای خلوت و آرامش بسیار مناسب است."],[957,"امشب ار امکان بود آنجا بیا","کار شب بی سمعه است و بی‌ریا","اگر امشب امکان داشته باشد، به آنجا بیا، زیرا در این شب کارها بدون شبهه و بدون تظاهر است."],[957,"جمله جاسوسان ز خمر خواب مست","زنگی شب جمله را گردن زدست","همه جاسوسان مست از شراب خواب‌آلودند و در این شب به خاطر مستی، گردن همه آنها را زده‌اند."],[957,"خواند بر قاضی فسون‌های عجب","آن شکرلب وانگهانی از چه لب","زنی که لب‌های شیرینی دارد، فسون‌هایی عجیب و حیرت‌انگیز برای قاضی خوانده و او را مجذوب کرده است. او ناگهان از او می‌پرسد که چرا این چنین می‌کوشد و با این حالاتش او را تحت تاثیر قرار داده است."],[957,"چند با آدم بلیس افسانه کرد","چون حوا گفتش بخور آنگاه خورد","چندین بار ابلیس (شیطان) داستان‌هایی برای آدم سروده و او را فریب داده بود، تا اینکه حوا به او گفت که خوردن میوه ممنوعه را امتحان کند و در نهایت او هم آن میوه را خورد."],[957,"اولین خون در جهان ظلم و داد","از کف قابیل بهر زن فتاد","اولین بار در جهان، به خاطر عشق و desire به یک زن، ظلم و بی‌عدالتی به دست قابیل اتفاق افتاد که در نتیجه برادری را به قتل رساند."],[957,"نوح چون بر تابه بریان ساختی","واهله بر تابه سنگ انداختی","نوح (پیامبر) وقتی که بر روی صفحه‌ای (تابه) غذا سرخ کرد، خانواده‌اش بر آن صفحه سنگ می‌انداختند."],[957,"مکر زن بر کار او چیره شدی","آب صاف وعظ او تیره شدی","دسیسه و فریب زن بر کار قاضی چیره شد و سخنان پندآمیز او دیگر اثر نداشت و مفهومش به زلالی و روشنی قبل نیست."],[957,"قوم را پیغام کردی از نهان","که نگه دارید دین زین گمرهان","پیام کردی به مردم از درون و به آنها گفتی که دین خود را از این نادان‌ها حفظ کنند و مراقب باشند."],[958,"مکر زن پایان ندارد رفت شب","قاضی زیرک سوی زن بهر دب","دسیسه و ترفند زن هیچ‌گاه به پایان نمی‌رسد. قاضی زیرک در شب به سمت زن می‌رود تا از او بهره‌ای ببرد."],[958,"زن دو شمع و نقل مجلس راست کرد","گفت ما مستیم بی این آب‌خورد","زن در مجلس دو شمع روشن کرد و گفت ما بدون این آب‌خورد (مشروب) مست شده‌ایم."],[958,"اندر آن دم جوحی آمد در بزد","جست قاضی مهربی تا در خزد","در آن لحظه، جوحی به در اتاق آمد و به شدت در زد تا قاضی که در آنجا پنهان شده بود از ترس به بیرون فرار کند."],[958,"غیر صندوقی ندید او خلوتی","رفت در صندوق از خوف آن فتی","قاضی چون از ترس آن جوان جوحی، چاره‌ای جز پنهان شدن در صندوق نداشت و در هیچ مکان دیگری جایی برای خلوت نیافت."],[958,"اندر آمد جوحی و گفت ای حریف","ای وبالم در ربیع و در خریف","جوحی وارد شد و گفت: ای دوست، تو برای من در فصل بهار و پاییز مانند یک بار اضافی هستی."],[958,"من چه دارم که فدایت نیست آن","که ز من فریاد داری هر زمان","من چه چیزی دارم که فدای تو کنم، در حالی که تو هر لحظه از من فریاد می‌زنی و به من نیاز داری؟"],[958,"بر لب خشکم گشادستی زبان","گاه مفلس خوانیم گه قلتبان","زبانم در حالتی خشک و بی‌زبان مانده و گاهی به‌قدری در فقر و تنگدستی هستم که خود را فقیر می‌نامم و گاهی هم به خاطر کم‌حالی در بیان، می‌توانم به دشواری صحبت کنم."],[958,"این دو علت گر بود ای جان مرا","آن یکی از تست و دیگر از خدا","این دو دلیل اگر برای من باشد، یکی از تو (یعنی من) و دیگری از خداوند است."],[958,"من چه دارم غیر آن صندوق کان","هست مایه تهمت و پایه گمان","من چیزی جز این صندوق ندارم که فقط موجب تهمت و سوءظن می‌شود."],[958,"خلق پندارند زر دارم درون","داد واگیرند از من زین ظنون","مردم فکر می‌کنند که داخل صندوق طلا دارم و به همین خاطر از من سوء‌ظن دارند و نسبت به من بدگمان شده‌اند."],[958,"صورت صندوق بس زیباست لیک","از عروض و سیم و زر خالیست نیک","ظاهر صندوق زیبا و جذاب است، اما درون آن خبری از طلا و نقره و چیزهای قیمتی نیست."],[958,"چون تن زراق خوب و با وقار","اندر آن سله نیابی غیر مار","اگرچه جسم (تن) آن صندوق زیبا و باوقار است، اما در درون آن فقط چیزی خطرناک مانند مار پیدا می‌شود."],[958,"من برم صندوق را فردا به کو","پس بسوزم در میان چارسو","من فردا صندوق را به کو می‌برم و آن را در وسط بازار می‌سوزانم."],[958,"تا ببیند مؤمن و گبر و جهود","که درین صندوق جز لعنت نبود","این بیت اشاره دارد به اینکه افراد با ایمان، گبر (زرتشتی) و جهود (یهودی) باید ببینند که در این صندوق چیزی جز نفرین و لعنت نیست. به عبارتی، محتویات صندوق ارزش و اعتبار ندارند و فقط موجب نکوهش و لعنت خواهند بود."],[958,"گفت زن هی در گذر ای مرد ازین","خورد سوگند او که نکنم جز چنین","زن به قاضی می‌گوید: ای مرد، از این مسیر عبور نکن، قسم می‌خورم که جز این کار (غیبت و بدگویی) نخواهم کرد."],[958,"از پگه حمال آورد او چو باد","زود آن صندوق بر پشتش نهاد","حمال، باربر، به سرعت صندوق را برداشت و مانند باد به سوی قاضی رفت."],[958,"اندر آن صندوق قاضی از نکال","بانگ می‌زد کای حمال و ای حمال","قاضی در داخل صندوق فریاد می‌زد و از حمال می‌خواست که به او توجه کند و به فریادش پاسخ دهد."],[958,"کرد آن حمال راست و چپ نظر","کز چه سو در می‌رسد بانگ و خبر","آن حمال (محمول) به راست و چپ نگاه کرد تا ببیند صدای بانگ و خبر از کدام سو می‌آید."],[958,"هاتفست این داعی من ای عجب","یا پری‌ام می‌کند پنهان طلب","این صدایی که می‌شنوم، انگار یک فراخوانده است، شگفتا! یا شاید از پری‌هاست که به طور پنهانی مرا می‌جوید."],[958,"چون پیاپی گشت آن آواز و بیش","گفت هاتف نیست باز آمد به خویش","زمانی که آن صدا و ندا به طور مکرر و زیاد تکرار شد، مولانا متوجه شد که این هاتف واقعی نیست و به خود آمد."],[958,"عاقبت دانست کان بانگ و فغان","بد ز صندوق و کسی در وی نهان","در نهایت فهمید که آن صدا و فریاد ناشی از صندوق است و در آن هیچ‌کس پنهان نیست."],[958,"عاشقی کو در غم معشوق رفت","گرچه بیرونست در صندوق رفت","عاشق واقعی هرچند که ظاهرا در صندوقی محبوس شده باشد، اما در واقع به خاطر غم معشوق خود به آنجا رفته است."],[958,"عمر در صندوق برد از اندهان","جز که صندوقی نبیند از جهان","عمر او در گوشه‌ای از دل خود حبس شده و جز چیزی نمی‌بیند که آن را صندوق می‌نامد؛ یعنی زندگی‌اش محدود به این حسرت و غم شده است."],[958,"آن سری که نیست فوق آسمان","از هوس او را در آن صندوق دان","سری که بالای آسمان نیست و درک نمی‌شود، به خاطر هوس‌ها و تمایلات انسان در آن صندوق حبس شده است."],[958,"چون ز صندوق بدن بیرون رود","او ز گوری سوی گوری می‌شود","زمانی که روح از بدن خارج می‌شود، مانند این است که از یک صندوق بیرون می‌آید و پس از آن به سمت دیگر دنیا، که می‌تواند مرگ یا زندگی پس از مرگ باشد، حرکت می‌کند."],[958,"این سخن پایان ندارد قاضیش","گفت ای حمال و ای صندوق‌کش","این حرف‌ها هیچ‌گاه تمام نمی‌شود، قاضی به حمال و صندوق‌کش گفت."],[958,"از من آگه کن درون محکمه","نایبم را زودتر با این همه","قاضی از من بخواه تا در دادگاه زودتر نایب خود را آگاه کنم."],[958,"تا خرد این را به زر زین بی‌خرد","هم‌چنین بسته به خانه ما برد","هرچند که این زن جوحی نامعقول و بی‌خرد بود، ولی خرد او این عمل را که قاضی را به خانه‌اش بکشاند، به‌راستی با ارزش و باطلا نمود."],[958,"ای خدا بگمار قومی روحمند","تا ز صندوق بدنمان وا خرند","ای خدا، گروهی دانا و عاقل برگزین که بتوانند ما را از این صندوق بدن، که محدودیت‌ها و مشکلات دنیوی است، آزاد کنند."],[958,"خلق را از بند صندوق فسون","کی خرد جز انبیا و مرسلون","تنها انبیا و فرستادگان الهی می‌توانند مردم را از بند زندگی مادی و فریبندگی‌های آن آزاد کنند و به حقیقت و معنای واقعی زندگی راهنمایی کنند."],[958,"از هزاران یک کسی خوش‌منظرست","که بداند کو به صندوق اندرست","از بین هزاران نفر، تنها یک نفر خوش‌چهره و زیبا وجود دارد که می‌داند چه کسی در صندوق زندانی است."],[958,"او جهان را دیده باشد پیش از آن","تا بدان ضد این ضدش گردد عیان","او قبل از اینکه جهان را ببینید، شاهد بوده که چگونه ضدها (دو چیز مخالف) به وضوح شناخته می‌شوند."],[958,"زین سبب که علم ضاله مؤمنست","عارف ضاله خودست و موقنست","به همین دلیل که علم نادرست و بی‌پایه برای مؤمنان نادرست است، عارف در اشتباهات خودش متعهد بوده و بر اعتقادات نادرست خود اصرار دارد."],[958,"آنک هرگز روز نیکو خود ندید","او درین ادبار کی خواهد طپید","آن که هرگز روز خوبی را تجربه نکرده است، در این بدبختی و ناکامی، چه زمانی ممکن است خوشی و شادابی را احساس کند؟"],[958,"یا به طفلی در اسیری اوفتاد","یا خود از اول ز مادر بنده زاد","شخص در زندگی‌اش یا از کودکی تحت فشار و اسارت بوده، یا بر اثر سختی‌های زندگی از همان بدو تولد محکوم به بندگی شده است."],[958,"ذوق آزادی ندیده جان او","هست صندوق صور میدان او","روح او هرگز طعم آزادی را نچشیده و مانند صندوقی بسته است که در آن تصاویر و افکار محصور شده‌اند."],[958,"دایما محبوس عقلش در صور","از قفس اندر قفس دارد گذر","عقل او همیشه در شکل‌ها و قالب‌های مختلفی گرفتار است و مانند پرنده‌ای در قفس، از یک قفس به قفس دیگر می‌رود."],[958,"منفذش نه از قفس سوی علا","در قفس‌ها می‌رود از جا به جا","عقل انسان نمی‌تواند به سادگی از قید و بندها و محدودیت‌های خود عبور کند و به حقیقت و اصل بالایی دست یابد، بلکه به طور مداوم در این محدودیت‌ها گرفتار است و از جای به جای دیگر می‌رود."],[958,"در نبی ان استطعتم فانفذوا","این سخن با جن و انس آمد ز هو","این سخن که در آیه‌ای از قرآن آمده، به این معناست که اگر می‌توانید از قدرت‌های بالاتر فرار کنید و به آن‌ها دست یابید، این کار را بکنید؛ این کلام از سوی خداوند به انسان‌ها و جن‌ها رسیده است."],[958,"گفت منفذ نیست از گردونتان","جز به سلطان و به وحی آسمان","گفتار در آسمان‌ها و گردونه هستی (جهان) تنها از طریق سلطان (پادشاه) و وحی (الهام الهی) امکان‌پذیر است و جز این راهی نمی‌توان جست."],[958,"گر ز صندوقی به صندوقی رود","او سمایی نیست صندوقی بود","اگر او از یک صندوق به صندوق دیگر برود، در واقع به خودی خود به آسمان صعود نمی‌کند و این تنها یک جابه‌جایی است."],[958,"فرجه صندوق نو نو منکرست","در نیابد کو به صندوق اندرست","فرجه (حالت باز یا گشایش) صندوق نو و تازه شناخته شده است و کسی که درون صندوق است، این را نمی‌فهمد."],[958,"گر نشد غره بدین صندوق‌ها","هم‌چو قاضی جوید اطلاق و رها","اگر کسی به صندوق‌ها (اشیاء یا ظواهر) دل خوش نکند و به آن‌ها غره نشود، مانند قاضی خواهد بود که به دنبال آزادگی و رهایی می‌گردد."],[958,"آنک داند این نشانش آن شناس","کو نباشد بی‌فغان و بی‌هراس","کسی که این علامت را می‌شناسد، شناس است که در برابر مشکلات و خطرها ناله نمی‌کند و نمی‌ترسد."],[958,"هم‌چو قاضی باشد او در ارتعاد","کی برآید یک دمی از جانش شاد","شخصی مانند قاضی، وقتی در ترس و نگرانی به سر می‌برد، هرگز نمی‌تواند لحظه‌ای از درد و ناراحتی خود آسوده خاطر باشد و شاد شود."],[959,"نایب آمد گفت صندوقت به چند","گفت نهصد بیشتر زر می‌دهند","نایب قاضی آمد و گفت که صندوق تو را به چه قیمتی می‌فروشی؟ گفت نهصد دینار بیشتر از این مبلغ برایش پیشنهاد می‌دهند."],[959,"من نمی‌آیم فروتر از هزار","گر خریداری گشا کیسه بیار","من زیر یک هزار درهم نمی‌آیم، حتی اگر خریدار کیسه‌اش را باز کند و پول بیشتری بیاورد."],[959,"گفت شرمی دار ای کوته‌نمد","قیمت صندوق خود پیدا بود","او به خریداری که کیسه‌اش را برای خرید صندوق باز کرده می‌گوید: شرم کن و خجالت بکش، ای کسی که در آرامش و سادگی خود کم‌عمق هستی؛ قیمت صندوق خود را نشان نده، زیرا این کار ناشایست است."],[959,"گفت بی‌ رؤیت شری خود فاسدیست","بیع ما زیر گلیم این راست نیست","او می‌گوید بدون دیدن حسن و زیبایی شریعت، خرید و فروش ما فاسد است و این معاملات زیر پرده ظاهر، صحیح نیست."],[959,"بر گشایم گر نمی‌ارزد مخر","تا نباشد بر تو حیفی ای پدر","اگر بخواهم معما را حل کنم و چیزی را که ارزش ندارد، به تو نشان بدهم، بهتر است که آن را نخرم تا مبادا به تو آسیب برساند، ای پدر."],[959,"گفت ای ستار بر مگشای راز","سرببسته می‌خرم با من بساز","گفت ای کسی که عیب‌ها را می‌پوشانی، رازهای پنهان را فاش نکن. من با تو کنار می‌آیم و همکاری می‌کنم."],[959,"ستر کن تا بر تو ستاری کنند","تا نبینی آمنی بر کس مخند","پنهان‌کاری کن تا دیگران تو را بی‌نقص ببینند. هنگامی که خود را در معرض نمایش قرار دهی، ممکن است به دیگران نیز بی‌اعتنایی کنی و با چهره‌ای غیرطبیعی به آن‌ها بخندی."],[959,"بس درین صندوق چون تو مانده‌اند","خویش را اندر بلا بنشانده‌اند","بسیاری در این دنیا مانند تو در صندوقی به بند مانده‌اند و خود را در درد و مشکل قرار داده‌اند."],[959,"آنچ بر تو خواه آن باشد پسند","بر دگر کس آن کن از رنج و گزند","آنچه که برای تو پسندیده و مطلوب است، باید آن را برای دیگران نیز بخواهی و از آسیب و درد آنها دوری کنی."],[959,"زانک بر مرصاد حق واندر کمین","می‌دهد پاداش پیش از یوم دین","زیرا خداوند منتظر است و در کمین نشسته که پاداش اعمال را قبل از روز قیامت بدهد."],[959,"آن عظیم العرش عرش او محیط","تخت دادش بر همه جانها بسیط","خداوند، که عرش او بسیار بزرگ و گسترده است، بر تخت عدالت خود سیطره و تسلط دارد و عدالتش شامل همه جانداران می‌شود."],[959,"گوشه عرشش به تو پیوسته است","هین مجنبان جز بدین و داد دست","گوشه عرش خدا به تو ارتباط دارد، پس مواظب باش که فقط به خواسته‌های خود و عدالت پایبند باشی و به هیچ چیز دیگر نپردازی."],[959,"تو مراقب باش بر احوال خویش","نوش بین در داد و بعد از ظلم نیش","مراقب رفتار و وضعیت خودت باش، زیرا ممکن است در اعمال نادرست دیگران، تو نیز دچار آسیب و ظلم شوی."],[959,"گفت آری اینچ کردم استم است","لیک هم می‌دان که بادی اظلم است","نایب قاضی می‌گوید بله، من این کار را انجام دادم و به حقیقت هم می‌دانم که این کار ظلمی است."],[959,"گفت نایب یک به یک ما بادییم","با سواد وجه اندر شادییم","نایب قاضی می‌گوید ما به‌تدریج و یکی یکی در حال تبدیل شدن به بادی هستیم و با دانش و آگاهی‌امان در شادی به‌سر می‌بریم."],[959,"هم‌چو زنگی کو بود شادان و خوش","او نبیند غیر او بیند رخش","انسانی مانند زنگی (مردی سیاه‌پوست) که شاد و خوشحال است، فقط زیبایی و خوشی خود را می‌بیند و از دیدن دیگران غافل است."],[959,"ماجرا بسیار شد در من یزید","داد صد دینار و آن از وی خرید","یزید (که در اینجا شخصی ثروتمند است) داستان‌های زیادی در ذهن من به وجود آورد و به او صد دینار داد تا چیزی را از او بخرم."],[959,"هر دمی صندوقیی ای بدپسند","هاتفان و غیبیانت می‌خرند","هر لحظه‌ای کسانی که از عالم غیب و رؤیا خبر دارند، صندوق‌هایی را برمی‌دارند و می‌فروشند که تو از آن خوش‌قهم نیستی."],[960,"زین سبب پیغامبر با اجتهاد","نام خود وان علی مولا نهاد","به همین دلیل، پیامبر با دقت و تأمل، نام خود را به عنوان مولا و دوست علی قرار داد."],[960,"گفت هر کو را منم مولا و دوست","ابن عم من علی مولای اوست","پیامبر فرمود هر کس که من برای او مولا و دوست باشم، علی (ابن عم پیامبر) نیز مولا و دوست آن فرد است."],[960,"کیست مولا آنک آزادت کند","بند رقیت ز پایت بر کند","مولا کیست ؟ مولا آن کسی است که تو را آزاد کند و زنجیر بندگی‌ات را از پایت باز کند"],[960,"چون به آزادی نبوت هادیست","مؤمنان را ز انبیا آزادیست","رسالت پیامبران باعث آزادی مؤمنان است و با پیروی از آن‌ها، انسان‌ها از بندگی و محدودیت‌های دنیوی رها می‌شوند."],[960,"ای گروه مؤمنان شادی کنید","هم‌چو سرو و سوسن آزادی کنید","ای مؤمنان، خوشحال باشید و مانند سرو و سوسن آزاد زندگی کنید."],[960,"لیک می‌گویید هر دم شکر آب","بی‌زبان چون گلستان خوش‌خضاب","اما شما هر بار فقط شکر آب می‌گویید، در حالی که از روی دل و زبان نمی‌توانید مانند گلستان زیبا و سرسبز صحبت کنید."],[960,"بی‌زبان گویند سرو و سبزه‌زار","شکر آب و شکر عدل نوبهار","سرو و سبزه‌زار بی‌صدا می‌گویند که برای خوش‌بو بودن محیط، شکر آب و شکر عدل در بهار لازم است."],[960,"حله‌ها پوشیده و دامن‌کشان","مست و رقاص و خوش و عنبرفشان","معنای این بیت این است که زنان با لباس‌های زیبا و خوش‌نما به رقص و شادی مشغولند و در حال حالتی سرمست هستند که بوی خوش عطر آن‌ها به مشام می‌رسد."],[960,"جزو جزو آبستن از شاه بهار","جسمشان چون درج پر در ثمار","این بیت به این معناست که هر یک از افراد جزو اجتماعی، مانند یک دانه درخت درون میوه، از وجود شاه بهار، که نماد شکوفایی و حیات است، پرورده و آماده‌اند. به عبارتی دیگر، آن‌ها تحت تاثیر و پرورش قدرت و زیبایی الهی هستند."],[960,"مریمان بی شوی آبست از مسیح","خامشان بی لاف و گفتاری فصیح","مادران مریم، بدون شوهر و به مانند مریم مقدس (مادر عیسی) آبستن شده‌اند و این مریم‌ها افرادی خام هستند که بدون هیچ افتخار و سخن فصیح، حالت گویایی را دارند."],[960,"ماه ما بی‌نطق خوش بر تافتست","هر زبان نطق از فر ما یافتست","ماه ما بدون گفتار و سخن، به زیبایی و روشنی می‌درخشد. هر زبانی که صحبت می‌کند، از نور و پرتو ما الهام گرفته است."],[960,"نطق عیسی از فر مریم بود","نطق آدم پرتو آن دم بود","نطق و گفتار عیسی از جمال و زیبایی مریم برمی‌خیزد و گفتار آدم نیز نوری از آن لحظه و زمان است، به طوری که نشان می‌دهد همه کمالات و زیبایی‌ها از این سرچشمه‌ها نشأت می‌گیرد."],[960,"تا زیادت گردد از شکر ای ثقات","پس نبات دیگرست اندر نبات","به همین دلیل که اگر شکری وجود داشته باشد، شکرگزاری و سپاسگزاری از آن باعث می‌شود خیر و برکت بیشتری حاصل شود. بنابراین، شکرگزاری از نعمت‌ها، موجب افزایش آنهاست."],[960,"عکس آن اینجاست ذل من قنع","اندرین طورست عز من طمع","اوضاع برعکس است؛ ذلت من در این است که راضی شوم، اما عزت من در این است که طمع نداشته باشم."],[960,"در جوال نفس خود چندین مرو","از خریداران خود غافل مشو","در دامن وجود خود، چیزهای بی‌ارزش و زائده را حمل نکن و همیشه مراقب خریداران و خواستاران خود باش، یعنی کسانی که به آنچه در وجودت هست، نیاز دارند و نمی‌توانی آن‌ها را نادیده بگیری."],[961,"بعد سالی باز جوحی از محن","رو به زن کرد و بگفت ای چست زن","پس از یک سال، جوحی به زن خود رو کرد و گفت: ای زن زیرک و هوشیار."],[961,"آن وظیفه پار را تجدید کن","پیش قاضی از گله من گو سخن","زن جوحی از قاضی می‌خواهد که وظیفه‌ای که سال گذشته بر عهده‌اش بوده را دوباره بررسی کند و از مشکلات و گلایه‌های او حرف بزند."],[961,"زن بر قاضی در آمد با زنان","مر زنی را کرد آن زن ترجمان","زن به همراه سایر زنان به قاضی مراجعه کرد و یکی از آن زنان را به عنوان سخنگو و نماینده خود انتخاب کرد."],[961,"تا بنشناسد ز گفتن قاضیش","یاد ناید از بلای ماضیش","زن تا قاضی را از سخن گفتن بشناسد، به یاد بلای گذشته‌اش نخواهد افتاد."],[961,"هست فتنه غمره غماز زن","لیک آن صدتو شود ز آواز زن","فتنه و آشفتگی‌ای که ناشی از شیوه سخن گفتن زن است، اگرچه وجود دارد، اما صدای او می‌تواند تأثیرگذار باشد و موجب تغییرات شود."],[961,"چون نمی‌توانست آوازی فراشت","غمزه تنهای زن سودی نداشت","زن نمی‌توانست صدای ناز و غمزگی خود را به دیگران برساند؛ بنابراین، تنها زیبایی و جذابیت او به تنهایی فایده‌ای نداشت."],[961,"گفت قاضی رو تو خصمت را بیار","تا دهم کار ترا با او قرار","قاضی به زن جوحی می‌گوید که برو و خصم (دشمنت) را بیاور، تا من کار تو را با او مشخص کنم و بینتان قضاوت کنم."],[961,"جوحی آمد قاضیش نشناخت زود","کو به وقت لقیه در صندوق بود","زن جوحی به نزد قاضی آمد، اما او او را زود نشناخت، چرا که در زمان ملاقات قبلی، او را در وضعیتی که در صندوق بود دیده بود."],[961,"زو شنیده بود آواز از برون","در شری و بیع و در نقص و فزون","او صدای بحث و گفتگوهایی درباره خرید و فروش و کم و زیاد شدن قیمت‌ها را از بیرون شنیده بود."],[961,"گفت نفقه زن چرا ندهی تمام","گفت از جان شرع را هستم غلام","قاضی از مرد می‌پرسد که چرا تمام نفقه زن را نمی‌دهی و او پاسخ می‌دهد که به خاطر پایبندی به دستورات مذهبی و شرع، در این مورد محتاط است."],[961,"لیک اگر میرم ندارم من کفن","مفلس این لعبم و شش پنج زن","من اگر بمی‌روم، کفن ندارم و همچنین وضعیت مالی‌ام بد است؛ بنابراین، این وضعیت من بازی‌ای بیش نیست و از همین رو، تعداد زنانی که دارم (شش یا پنج نفر) نیز مشکل‌زا است."],[961,"زین سخن قاضی مگر بشناختش","یاد آورد آن دغل وان باختش","قاضی از این حرف‌ها شاید او را شناسایی کند و به یاد بیاورد که چگونه آن شخص با تزویر و فریب کلاهی بر سر بقیه گذاشته و شکست خورده است."],[961,"گفت آن شش پنج با من باختی","پار اندر شش درم انداختی","قاضی به زن جوحی می‌گوید که تو در سال گذشته شش‌پنج را با من باختی و در آن زمان شش درهم به من دادی."],[961,"نوبت من رفت امسال آن قمار","با دگر کس باز دست از من بدار","امسال نوبت من به پایان رسیده و دیگر نمی‌توانم در این قمار شرکت کنم، پس از این بازی دست بردار و آن را ادامه نده."],[961,"از شش و از پنج عارف گشت فرد","محترز گشتست زین شش پنج نرد","عارف از احوالات حس و عقل (پنج حس و شش جهت) فراتر رفته و از آن‌ها دوری جسته است. او به مرتبه‌ای از شناخت رسیده که از بازی زندگی (نرد) و ماجراهای آن خود را جدا کرده و در امنیت معنوی قرار دارد."],[961,"رست او از پنج حس و شش جهت","از ورای آن همه کرد آگهت","انسان با رهایی از پنج حس و شش جهت، به فراتر از این عالم و تجربیات حسی می‌رسد و از آنجا آگاهی می‌یابد."],[961,"شد اشاراتش اشارات ازل","جاوز الاوهام طرا و اعتزل","اشارات او (زن جوحی) نشانه‌های ازلی است که فراتر از تصورات و ذهنیات قرار دارد و از هرگونه خیال و وهم دور است."],[961,"زین چه شش گوشه گر نبود برون","چون بر آرد یوسفی را از درون","اگر شش گوشه‌ای (شکل هندسی) نبود و چیزی وجود نداشت، یوسف (نماد آگاهی و امید) چگونه از درون (دل) بیرون می‌آید؟ این بیت به وجود قالب‌ها و محدودیت‌ها اشاره دارد که باید وجود داشته باشند تا پدیده‌هایی چون یوسف بتوانند ظهور کنند."],[961,"واردی بالای چرخ بی ستن","جسم او چون دلو در چه چاره کن","این بیت به وضعیت دشوار انسانی اشاره دارد که جسم او در دوران سختی قرار دارد و او را به مانند دلو (سطل) در چاه تشبیه می‌کند. این شخص باید از این وضعیت نابسامان رهایی یابد و به دنبال راه چاره‌ای باشد."],[961,"یوسفان چنگال در دلوش زده","رسته از چاه و شه مصری شده","مردان سیاه‌چشم مانند یوسف، چنگال‌های خود را در دلو او فرو کرده‌اند و از چاه بیرون آمده‌اند و به مقام والایی رسیده‌اند، مانند یوسف که به مقام سلطنت مصر دست یافت."],[961,"دلوهای دیگر از چه آب‌جو","دلو او فارغ ز آب اصحاب‌جو","دلوهای دیگر از چه آبی می‌توانند گرفته شوند وقتی که دلو او از آب افراد و آشناها مستقل و بی‌نیاز است؟"],[961,"دلوها غواص آب از بهر قوت","دلو او قوت و حیات جان حوت","دلوها مانند غواص‌هایی هستند که برای تأمین قوت و زندگی دلو (گودال یا چاله) او به آب می‌روند. در واقع، آن‌ها برای تأمین نیازهای دلو و زنده نگه‌داشتن آن تلاش می‌کنند."],[961,"دلوها وابسته چرخ بلند","دلو او در اصبعین زورمند","دلوها (کوزها) به چرخ بلند (چرخ فلکی یا نظام عالم) وابسته هستند و دلو (کوز) او در دست کسانی که توانمند و قوی هستند، قرار دارد."],[961,"دلو چه و حبل چه و چرخ چی","این مثال بس رکیکست ای اچی","مثال‌هایی که آورده شده‌اند، یعنی «دلو»، «حبل» (رشته یا طناب) و «چرخ»، نشان از چیزهای دنیوی و مادی دارند و به نظر می‌رسد که این مثال‌ها بسیار بی‌ارزش و پیش‌پاافتاده هستند. بنابراین، اشاره به این دارد که اینگونه مثال‌ها نمی‌توانند مفهوم عمیق و ارزشمندی را منتقل کنند."],[961,"از کجا آرم مثالی بی‌شکست","کفو آن نه آید و نه آمدست","نمی‌توانم مثالی بی‌نقص و بدون نقص بیاورم، چون کسی مثل او را نمی‌توانم پیدا کنم و او هم هرگز وجود نداشته و نخواهد داشت."],[961,"صد هزاران مرد پنهان در یکی","صد کمان و تیر درج ناوکی","بسیاری از مردان گمنام و پنهان مانند یک تیر و کمان در درون یک قایق جمع شده‌اند و به این ترتیب به نظر می‌رسند که تنها یک نفر هستند."],[961,"ما رمیت اذ رمیتی فتنه‌ای","صد هزاران خرمن اندر حفنه‌ای","تو در اینجا اشاره می‌کنی که وقتی تو به دشمنی و فتنه‌ای می‌پردازی، عملا این تو نیستی که می‌زنی، بلکه خداوند است که در واقع این کار را انجام می‌دهد و در نتیجه، آثار این فتنه به‌گونه‌ای عظیم و وسیع، مانند خرمن‌های بسیار در یک مشت کوچک، گسترش می‌یابد."],[961,"آفتابی در یکی ذره نهان","ناگهان آن ذره بگشاید دهان","یک خورشید در یک ذره پنهان است که ناگهان آن ذره دهان می‌گشاید و این یا حقیقت را آشکار می‌کند."],[961,"ذره ذره گردد افلاک و زمین","پیش آن خورشید چون جست از کمین","به تدریج همه جهان، هم آسمان و هم زمین، در برابر آن خورشید بزرگ (که اشاره به حقیقتی والاست) به روشنایی و روشنی می‌آیند، همان‌طور که خورشید از پناهگاهی پنهان بیرون می‌آید."],[961,"این چنین جانی چه درخورد تنست","هین بشو ای تن ازین جان هر دو دست","این‌گونه جان چه ارزشی برای بدن دارد؟ پس ای بدن، از این جان که هر دو دستش بسته است، جدا شو."],[961,"ای تن گشته وثاق جان بسست","چند تاند بحر در مشکی نشست","ای بدن که به‌چنگال جان به بند آمده‌ای، تا چه زمانی به تشنگی جان ادامه خواهی داد؟ مانند دریایی که در ظرف کوچکی گنجانده شود."],[961,"ای هزاران جبرئیل اندر بشر","ای مسیحان نهان در جوف خر","در انسان‌های مختلف، وجود برخی از فرشتگان مانند جبرئیل است که در باطن آن‌ها نهفته‌اند و همچنین شخصیت‌هایی با صفات مسیح، حتی در جاهایی که انتظار نمی‌رود، مانند درون حیات‌خشک و بی‌ارزش یک خر."],[961,"ای هزاران کعبه پنهان در کنیس","ای غلط‌انداز عفریت و بلیس","ای هزاران کعبه که در مکان‌های پنهان وجود دارند، ای وسوسه‌گر و فریب‌دهنده مثل عفریت و ابلیس."],[961,"سجده‌گاه لامکانی در مکان","مر بلیسان را ز تو ویران دکان","سجده‌گاهی که به مکان خاصی وابسته نیست، وجودش را به خاطر وجود بلیس و شیطان از تو ویران و نابود کرده‌اند."],[961,"که چرا من خدمت این طین کنم","صورتی را من لقب چون دین کنم","من از چه روی باید این نیروی جسمانی را خدمت کنم و به آن صورت و عنوانی بدهم که مثل دین و ایمان ارزشمند باشد؟"],[961,"نیست صورت‌، چشم را نیکو بمال","تا ببینی شعشعه نور جلال","آنچه در ظاهر وجود ندارد، تنها با نظافت چشم می‌توان آن را دید. یعنی باید چشم دل را پاک کرد تا بتوان نور عظمت و جلال حق را مشاهده کرد."],[962,"شاه‌زاده پیش شه حیران این","هفت گردون دیده در یک مشت طین","شاه‌زاده در پیش شاه (یا پادشاه) به تفکر و اندیشه نشسته و حیران است که چگونه این هفت آسمان (یا گردون) را در یک مشت گل (یا خاک) مشاهده کرده است."],[962,"هیچ ممکن نه ببحثی لب گشود","لیک جان با جان دمی خامش نبود","هیچ‌کس در اینجا نتوانسته بحثی را آغاز کند، اما در عین حال، جان‌ها هرگز در سکوت و خاموشی نیستند و ارتباطی عمیق و پنهان میان آن‌ها وجود دارد."],[962,"آمده در خاطرش کین بس خفیست","این همه معنیست پس صورت ز چیست","در دلش به یادش آمده که این کینه بسیار پنهان و درونی است، بنابراین همه این مفاهیم و معانی از چه چیزی ناشی می‌شود؟"],[962,"صورتی از صورتت بیزار کن","خفته‌ای هر خفته را بیدار کن","از ظواهر و شکل ظاهری خود دوری کن و برآیندهای باطن را بیاب؛ تو در دل همچون کسی هستی که خوابیده، پس باید هر خوابیده‌ای را به بیداری دعوت کنی."],[962,"آن کلامت می‌رهاند از کلام","وان سقامت می‌جهاند از سقام","سخن تو آدم‌ها را از گفت‌وگوهای بی‌معنی رها می‌کند و زیبایی تو نیز دل‌ها را از درد و رنج فاصله می‌دهد."],[962,"پس سقام عشق جان صحتست","رنجهااش حسرت هر راحتست","رنج‌های عشق، که به نوعی سقم و بیماری به شمار می‌رود، در واقع موجب سلامتی جان است و حسرت‌هایی که از آن به وجود می‌آید، خود نشان‌دهنده هر نوع آرامشی است."],[962,"ای تن اکنون دست خود زین جان بشو","ور نمی‌شویی جز این جانی بجو","ای بدن، اکنون دست از این جان بکش؛ اگر این کار را نکنید، جز این جان دیگر را جستجو نکن."],[962,"حاصل آن شه نیک او را می‌نواخت","او از آن خورشید چون مه می‌گداخت","نتیجه و ثمره آن پادشاه نیکو رفتار، او را نوازش می‌کرد و از آن خورشید (عشق یا رحمت) مانند مه، می‌گداخت و ذوب می‌شد."],[962,"آن گداز عاشقان باشد نمو","هم‌چو مه اندر گدازش تازه‌رو","عاشقان نیز همانند مه که در حال گداختن است، در عواطف و احساسات خود دچار ذوب و آب شدن می‌شوند و این گداز شدن باعث رشد و تازگی آن‌ها می‌شود."],[962,"جمله رنجوران دوا دارند امید","نالد این رنجور کم افزون کنید","تمامی افراد رنجور و بیمار به درمان و شفا امیدوارند، پس از شما خواهش می‌کنم این رنجور کم‌حال را بیشتر نرنجانید و به او رحم کنید."],[962,"خوش‌تر از این سم ندیدم شربتی","زین مرض خوش‌تر نباشد صحتی","چیزی خوش‌تر از این داروی تلخ ندیدم، زیرا در این بیماری، هیچ چیز لذیذتر از شفای مبتلا به آن نیست."],[962,"زین گنه بهتر نباشد طاعتی","سالها نسبت بدین دم ساعتی","این گناهی که من کرده‌ام، قابل مقایسه با طاعت و عبادتی نیست که سال‌ها طول بکشد؛ در این لحظه، هیچ کار نیکی بهتر از این گناه نیست."],[962,"مدتی بد پیش این شه زین نسق","دل کباب و جان نهاده بر طبق","مدتی پیش از این پادشاه، به خاطر این وضعیت، دلش داغ و آماده برای آلام و رنج‌هایش بود."],[962,"گفت شه از هر کسی یک سر برید","من ز شه هر لحظه قربانم جدید","پادشاه گفت که از هر کسی فقط یک سر می‌برند، ولی من هر لحظه برای پادشاه قربانی جدیدی می‌شوم."],[962,"من فقیرم از زر از سر محتشم","صد هزاران سر خلف دارد سرم","من آدمی فقیر هستم و هیچ مال و ثروتی ندارم، اما سر من از طلا و ارزش‌های باارزش پر است، به طوری که به اندازه صد هزار سر دیگر ارزش دارد."],[962,"با دو پا در عشق نتوان تاختن","با یکی سر عشق نتوان باختن","در عشق، با دو پا نمی‌توان به درستی حرکت کرد و با یک سر هم نمی‌توان به طور کامل تسلیم شد؛ بنابراین، عشق نیازمند تمام وجود انسان است."],[962,"هر کسی را خود دو پا و یک‌سرست","با هزاران پا و سر تن نادرست","هر فرد تنها یک سر و دو پا دارد، اما با وجود این، گاهی خود را در میان هزاران پا و سر غیرواقعی و نادرست می‌یابد."],[962,"زین سبب هنگامه‌ها شد کل هدر","هست این هنگامه هر دم گرم‌تر","به همین خاطر، این هیاهو و شور و غوغا بیهوده است و هر لحظه بیشتر و بیشتر می‌شود."],[962,"معدن گرمیست اندر لامکان","هفت دوزخ از شرارش یک دخان","در جهانی که ما در آن هستیم، محلی وجود دارد که منبعی از گرما و حرارت است و اینجا مثل هفت دوزخ می‌سوزد و از آتش آن، دود و بخار برمی‌خیزد."],[963,"زآتش عاشق ازین رو ای صفی","می‌شود دوزخ ضعیف و منطقی","آتش عشق باعث می‌شود که دوزخ، همانند یک موجود ضعیف و ناتوان به نظر برسد. ای صفی (دل‌پاک)، این عشق به قدری قوی است که می‌تواند قدرت آتش را کاهش دهد و آن را منطقی جلوه دهد."],[963,"گویدش بگذر سبک ای محتشم","ورنه ز آتش‌های تو مرد آتشم","دوزخ به مؤمن می‌گوید که با سبکی و بی‌تأمل از این راه بگذر، و گرنه آتش‌های درونی تو مرا که آتش‌سوز هستم، خواهد سوزاند."],[963,"کفر که کبریت دوزخ اوست و بس","بین که می‌پخساند او را این نفس","کفر همان آتش دوزخ است که فقط او را می‌سوزاند و این نفس سرکش است که او را به گناه می‌کشاند."],[963,"زود کبریت بدین سودا سپار","تا نه دوزخ بر تو تازد نه شرار","به سرعت آتش‌زنه‌ای (کبریت) را به این کار بسپار تا نه دوزخ به تو آسیب برساند و نه آتش آن."],[963,"گویدش جنت گذر کن هم‌چو باد","ورنه گردد هر چه من دارم کساد","دوزخ به مؤمن می‌گوید که باید مانند باد از این پل عبور کنی، وگرنه هر چیزی که من دارم و برای تو خوب است، نابود می‌شود."],[963,"که تو صاحب‌خرمنی من خوشه‌چین","من بتی‌ام تو ولایت‌های چین","تو مالک یک کشتزار بزرگ هستی و من فقط کسی هستم که خوشه‌ها را می‌چینم. من به مانند یک بت هستم و تو سلطنت و اختیار بر سرزمین‌های چین را داری."],[963,"هست لرزان زو جحیم و هم جنان","نه مر این را نه مر آن را زو امان","جهنم و بهشت در حال لرزیدن از اوست، نه این جهنم را او می‌تواند تحمل کند و نه آن بهشت را. هر دو از شر او در امان نیستند."],[963,"رفت عمرش چاره را فرصت نیافت","صبر بس سوزان بدت وجان بر نتافت","عمر او به پایان رسید و فرصتی برای چاره‌یابی پیدا نکرد. صبر او بسیار سوزان و طاقت‌فرسا بود و نتوانست جانش را تحمل کند."],[963,"مدتی دندان‌کنان این می‌کشید","نارسیده عمر او آخر رسید","مدتی او با شوق و اشتیاق این می‌نوشید و به تأخیر می‌انداخت، اما حالا عمرش به سر رسیده و به مقصد نرسیده است."],[963,"صورت معشوق زو شد در نهفت","رفت و شد با معنی معشوق جفت","معشوق که در ابتدا با صورت و ظاهری مشخص بوده، اکنون در دل و معنا پنهان شده است و به نوعی با معنای عمیق معشوق یکی شده است."],[963,"گفت لبسش گر ز شعر و ششترست","اعتناق بی‌حجابش خوشترست","اگرچه معشوق در زیور و زینت به زیبایی است، اما دل‌انگیزتر و خوشایندتر است که بدون هیچ پوششی و عریان از حجاب‌های ظاهری به نمایش درآید."],[963,"من شدم عریان ز تن او از خیال","می‌خرامم در نهایات الوصال","من از وجود جسم به دور شدم و از خیال‌پردازی‌ها فارغ هستم؛ در حالیکه در نهایت اتحاد و وصال قرار دارم و به سروری و خوشی می‌رقصم."],[963,"این مباحث تا بدین‌جا گفتنیست","هرچه آید زین سپس بنهفتنیست","این بحث‌ها تا اینجا قابل بیان است و هر چه بعد از این خواهد آمد، باید در دل پنهان شود."],[963,"ور بگویی ور بکوشی صد هزار","هست بیگار و نگردد آشکار","اگر بگویی یا تلاش کنی، به اندازه صد هزار تلاش دیگری هم هست، اما این زحمت‌ها نمایان نمی‌شود و نتیجه‌ای نخواهد داشت."],[963,"تا به دریا سیر اسپ و زین بود","بعد ازینت مرکب چوبین بود","بعد از این که به دریا بروی و سوار بر اسب و زین شوی، دیگر مرکب چوبی خواهی داشت."],[963,"مرکب چوبین به خشکی ابترست","خاص آن دریاییان را رهبرست","مرکب چوبی (قایق یا کشتی) در خشکی ناتوان و بی‌فایده است و فقط برای کسانی که در دریا هستند، قابل استفاده و راهنماست."],[963,"این خموشی مرکب چوبین بود","بحریان را خامشی تلقین بود","این سکوت، همچون مرکب چوبین است که به ساحل آمده و به دریانوردان یاد می‌دهد که در خاموشی نیز می‌توانند به راه خود ادامه دهند."],[963,"هر خموشی که ملولت می‌کند","نعره‌های عشق آن سو می‌زند","هر سکوتی که تو را به آرامش می‌آورد، در حقیقت صداهای عشق در طرف مقابل را بلندتر می‌کند."],[963,"تو همی‌گویی عجب خامش چراست","او همی‌گوید عجب گوشش کجاست","تو می‌گویی چرا این شخص خاموش است، ولی او می‌گوید چرا کسی صدای مرا نمی‌شنود."],[963,"من ز نعره کر شدم او بی‌خبر","تیزگوشان زین سمر هستند کر","من از سر و صدای جیغ و نعره‌ها کر شده‌ام، در حالی که او (دیگری) بی‌خبر است، زیرا شنوندگان تیزگوش در این داستان، کر و ناگوش هستند."],[963,"آن یکی در خواب نعره می‌زند","صد هزاران بحث و تلقین می‌کند","شخصی در خواب به شدت نعره می‌زند و در حال گفت‌وگو و بحث کردن است، ولی در واقعیتی که در آن قرار دارد، به هیچ چیز واقف نیست و تنها در دنیای خواب و خیال خود غرق شده است."],[963,"این نشسته پهلوی او بی‌خبر","خفته خود آنست و کر زان شور و شر","این فردی که کنار او نشسته، در واقع خود اوست و از هیاهو و جوش و خروش بی‌خبر و غافل است."],[963,"وان کسی کش مرکب چوبین شکست","غرقه شد در آب او خود ماهیست","کسی که در برابر سختی‌ها و مشکلات (مرکب چوبین) شکست می‌خورد و به دریا (آب) می‌افتد، در حقیقت در همان حالت هم به قدرت و توانایی خود (ماهی) رسیده است و می‌تواند بر مشکلات غلبه کند."],[963,"نه خموشست و نه گویا نادریست","حال او را در عبارت نام نیست","حال او نه ساکت است و نه دارای کلام، وضعیت او را نمی‌توان به هیچ عبارتی توصیف کرد، زیرا او در نوعی خاص و نادر از وجود قرار دارد."],[963,"نیست زین دو هر دو هست آن بوالعجب","شرح این گفتن برونست از ادب","بین دو حالت خموشی و گویایی، هیچ‌یک به تنهایی وجود ندارد و در عین حال، هر دو به نوعی عجیب و شگفت‌آورند. بیان این موضوع فراتر از ادبیات و کلمات است و نیاز به فهم عمیق‌تری دارد."],[963,"این مثال آمد رکیک و بی‌ورود","لیک در محسوس ازین بهتر نبود","این مثال، هرچند بی‌پایه و ساده است، اما در دنیای محسوس و قابل لمس بهتر از آن وجود ندارد."],[964,"کوچکین رنجور بود و آن وسط","بر جنازه آن بزرگ آمد فقط","کوچک‌تر (برادر آن بزرگ) بیمار بود و فقط بر روی جنازه برادر بزرگش آمد."],[964,"شاه دیدش گفت قاصد کین کیست","که از آن بحرست و این هم ماهیست","شاه به قاصدش می‌گوید که این شخص که در اینجا است، کیست و او را با چیزی بزرگ‌تر از دریا مقایسه می‌کند و از او به‌عنوان ماهی یاد می‌کند، به این معنا که او در نظرش بسیار ارزشمند و مهم است."],[964,"پس معرف گفت پور آن پدر","این برادر زان برادر خردتر","معرف به خویش اشاره می‌کند و می‌گوید این برادر، پسر همان پدر است و از آن برادر کوچک‌تر است."],[964,"شه نوازیدش که هستی یادگار","کرد او را هم بدان پرسش شکار","پادشاه به او احترام می‌گذارد زیرا او یادگار پدرش است و به همین خاطر از او درباره شکار سؤال می‌کند."],[964,"از نواز شاه آن زار حنیذ","در تن خود غیر جان جانی بدیذ","از مهربانی و نوازش شاه، آن مرد حسرت‌زده و رنجور در وجود خود جز جان و روح خود چیزی نمی‌بیند."],[964,"در دل خود دید عالی غلغله","که نیابد صوفی آن در صد چله","در دل خود غوغایی را مشاهده کرد که صوفی به آن نمی‌تواند دست پیدا کند، حتی با گذشت صد روز از تمرین و ریاضت."],[964,"عرصه و دیوار و کوه سنگ‌بافت","پیش او چون نار خندان می‌شکافت","عرصه، دیوار و کوه‌های سنگی در برابر او به مانند آتش خندان منفجر می‌شدند."],[964,"ذره ذره پیش او هم‌چون قباب","دم به دم می‌کرد صدگون فتح باب","هر ذره‌ای که در مقابل او (خدا) قرار می‌گیرد، همچون قبه‌ای که به آرامی گشوده می‌شود، به‌طور مداوم برای او درهای موفقیت و پیروزی را باز می‌کند."],[964,"باب گه روزن شدی گاهی شعاع","خاک گه گندم شدی و گاه صاع","در برخی مواقع، دروازه‌ای به سوی روشنی و علم گشوده می‌شود که مانند نوری از آسمان است و در مواقع دیگر، تو مانند خاک و گندم، اصل و هویت انسانی خود را فراموش می‌کنی و تحت تأثیر دنیا و مادیات قرار می‌گیری."],[964,"در نظرها چرخ بس کهنه و قدید","پیش چشمش هر دمی خلق جدید","هر لحظه در نظر انسان‌ها، چرخ زمان کهن و قدیمی است، اما به چشم آن شخص، هر بار خلق و موجودات جدیدی نمایان می‌شوند. این بیان نشان‌دهنده تغییر مداوم و نو بودن هر چیزی در زندگی است، حتی اگر زمان دائما تکرار شود."],[964,"روح زیبا چونک وا رست از جسد","از قضا بی شک چنین چشمش رسد","روح زیبای انسان، هنگامی که از بدن جدا می‌شود، بی‌تردید به چنین دیدارهایی می‌رسد."],[964,"صد هزاران غیب پیشش شد پدید","آنچ چشم محرمان بیند بدید","او (روح زیبای بزرگین) در برزخ، شاهد نعمت‌ها و غنایمی شد که به‌واسطه دیدگاه‌های خاص محرمان، قابل مشاهده است. این غنایم پنهان و معنوی، نمایان شد و او همه آنچه را که محرمان می‌بینند، مشاهده کرد."],[964,"آنچ او اندر کتب بر خوانده بود","چشم را در صورت آن بر گشود","آنچه او در کتاب‌ها خوانده بود، چشمانش آن را در واقعیت دیدند و به حقیقت پی بردند."],[964,"از غبار مرکب آن شاه نر","یافت او کحل عزیزی در بصر","از غبار مرکب آن شاه نیکو، او (مولانا) کحلی ارزشمند برای چشم خود پیدا کرد."],[964,"برچنین گلزار دامن می‌کشید","جزو جزوش نعره زن هل من مزید","در چنین باغی دامن می‌زند، و از هر بخش آن، صدای نعره‌زنی به گوش می‌رسد که می‌گوید آیا کسی چیزی دیگر دارد که به این نعمت‌ها اضافه کند؟"],[964,"گلشنی کز بقل روید یک دمست","گلشنی کز عقل روید خرمست","باغی که از کنار بغل انسان بروجود می‌آید، لحظه‌ای است، اما باغی که از عقل به وجود می‌آید، پر از شادی و خوشی است."],[964,"گلشنی کز گل دمد گردد تباه","گلشنی کز دل دمد وافر حتاه","گلشنی که از گل و زیبایی به وجود آمده، در اثر گذر زمان و زوال، خراب می‌شود؛ اما گلشنی که از دل و عشق زنده شده، همیشه سرزنده و پربرکت باقی می‌ماند."],[964,"علم‌های با مزه دانسته‌مان","زان گلستان یک دو سه گل‌دسته دان","از گلستان علم و دانش، تنها یک یا دو دسته گل مانند این دسته گل را داریم که خوشایند و پربار هستند."],[964,"زان زبون این دو سه گل دسته‌ایم","که در گلزار بر خود بسته‌ایم","ما به خاطر ضعف و زبونی‌امان، به این دو یا سه گل‌دسته در گلزار افتخار می‌کنیم که بر روی خود بسته‌ایم."],[964,"آن‌چنان مفتاح‌ها هر دم به نان","می‌فتد ای جان دریغا از بنان","زندگی به قدری پر از حوادث و تغییرات است که هر لحظه ممکن است کلیدهای موفقیت و خوش‌بختی به سادگی از دست برود. ای جان، افسوس که این نان (منظور از نان، روزی یا فرصت‌های زندگی) به راحتی از دست می‌رود."],[964,"ور دمی هم فارغ آرندت ز نان","گرد چادر گردی و عشق زنان","اگر حتی برای لحظه‌ای هم تو را از فکر نان آزاد کنند، دور چادر عشق می‌گردی و در آرزوی معشوقه‌ها می‌چرخیدی."],[964,"باز استسقات چون شد موج‌زن","ملک شهری بایدت پر نان و زن","به زودی در زمانی که حالت طغیان و جنگ در یک کشور به وجود آید، باید تو خود را از نان و زن و زندگی‌ات مملو کنی."],[964,"مار بودی اژدها گشتی مگر","یک سرت بود این زمانی هفت‌سر","تو در آغاز شبیه یک مار کوچک بودی، اما حالا با حریص بودن و افکار خود، به یک اژدها با هفت سر تبدیل شده‌ای. این تغییر فقط به خاطر افزایش حرص و ولع تو است."],[964,"اژدهای هفت‌سر دوزخ بود","حرص تو دانه‌ست و دوزخ فخ بود","حرص تو مانند اژدهای هفت‌سر است که در دوزخ قرار دارد و به معنای دیگر، حرص تو بی‌پایان و ویرانگر است و آن دوزخ، سرنوشتی ناپسند برای تو به بار خواهد آورد."],[964,"دام را بدران بسوزان دانه را","باز کن درهای نو این خانه را","دام را بسوزان تا دیگر نتوانی در آن گرفتار شوی و دانه را باز کن تا درهای تازه‌ای به روی زندگی‌ات بگشایی."],[964,"چون تو عاشق نیستی ای نرگدا","هم‌چو کوهی بی‌خبر داری صدا","ای نرگس زیبا، چون تو عاشق نیستی، مانند کوه هستی که صدا دارد اما هیچ‌گونه احساس و آگاهی از آنچه در اطرافش می‌گذرد، ندارد."],[964,"کوه را گفتار کی باشد ز خود","عکس غیرست آن صدا ای معتمد","کوه نمی‌تواند سخنی از خود بگوید و صدایش تنها انعکاسی از دیگران است، ای معتمد (دوست یا کسی که به او اعتماد داری)."],[964,"گفت تو زان سان که عکس دیگریست","جمله احوالت به جز هم عکس نیست","تو به شکلی هستی که مانند تصویر دیگری است و تمام حالات و احساسات تو نیز جز تصویر همان دیگر نیست."],[964,"خشم و ذوقت هر دو عکس دیگران","شادی قواده و خشم عوان","خشم و شادی هر دو تنها بازتابی از دیگران هستند؛ مثل شادمانی یک فردی که به خاطر معاشرت با دیگران به سر می‌برد و خشم گروهی که تحت تأثیر اوضاع و شرایط به وجود آمده است."],[964,"آن عوان را آن ضعیف آخر چه کرد","که دهد او را به کینه زجر و درد","عوان که به معنی «نوکر» یا «دستیار» است، در اینجا توهین و آزار می‌کند؛ به همین خاطر از او می‌پرسند که این شخص ضعیف را به خاطر کینه و عذاب چه کار کرده است."],[964,"تا بکی عکس خیال لامعه","جهد کن تا گرددت این واقعه","هر چه زمان می‌گذرد، تلاشت کن تا تصویرهای زیبا و درخشان خیال نرود، زیرا این حالت و واقعه برای تو باقی خواهد ماند."],[964,"تا که گفتارت ز حال تو بود","سیر تو با پر و بال تو بود","حالت و گفتار تو نشان‌دهنده سفر و سفر کردنت است و این که با چه قدرت و بالی می‌توانی در زندگی حرکت کنی."],[964,"صید گیرد تیر هم با پر غیر","لاجرم بی‌بهره است از لحم طیر","اگر تیر، شکار (پرنده) را بگیرد، اما با پر غیر خود (غیر از خود پرنده)، ناچار از گوشت (لحم) پرنده بی‌بهره خواهد بود؛ یعنی برای رسیدن به چیزی باید خود منابع و ابزار لازم را داشته باشی."],[964,"باز صید آرد به خود از کوهسار","لاجرم شاهش خوراند کبک و سار","گنجشکی که از کوه‌ها شکار می‌شود، به ناچار شاه آن را می‌خورد و می‌تاباند کبک و سار را برای سرگرمی و خوشی خود."],[964,"منطقی کز وحی نبود از هواست","هم‌چو خاکی در هوا و در هباست","منطق و استدلالی که از الهام و وحی نمی‌آید، مانند خاکی است که در هوا یا در نسیم معلق مانده و بی‌اساس است."],[964,"گر نماید خواجه را این دم غلط","ز اول والنجم بر خوان چند خط","اگر این شخص (خواجه) در این لحظه به اشتباه از خود رفتار کند، مانند ستاره‌ای که در افق نشسته و چند خط را در کتاب می‌خواند."],[964,"تا که ما ینطق محمد عن هوی","ان هو الا بوحی احتوی","این بیت بیان می‌کند که محمد (پیامبر اسلام) هرگز از روی هوس سخن نمی‌گوید و آنچه می‌گوید، همگی وحی الهی است که بر او نازل شده است."],[964,"احمدا چون نیستت از وحی یاس","جسمیان را ده تحری و قیاس","ای احمق، چون تو از وحی (الهی) بی‌بهره‌ای، درباره جسم و روح انسان‌ها قضاوت و قیاس نکن."],[964,"کز ضرورت هست مرداری حلال","که تحری نیست در کعبه وصال","در شرایط خاص و ضروری، چیزی که ناپسند و حرام است، می‌تواند به عنوان یک گزینه قابل قبول شناخته شود؛ حتی اگر در مکان‌های مقدس مانند کعبه نیز نباید باشد."],[964,"بی‌تحری و اجتهادات هدی","هر که بدعت پیشه گیرد از هوی","هر کس که بدون تحقیق و کوشش درست در دین، به نوآوری و بدعت‌گذاری بپردازد، تنها به خاطر هوس و تمایلات خود عمل کرده است."],[964,"هم‌چو عادش بر برد باد و کشد","نه سلیمانست تا تختش کشد","عاد قومی بودند که به قدرت و جلال رسیدند، اما قدرتشان ویران شده و مانند عده‌ای که در طوفان باد می‌روند، از بین رفتند. اینجا گفته شده که آن فرد (مورد نظر) به اندازه سلیمان بزرگ نخواهد شد تا بتواند تختش را حفظ کند و از بدی‌ها در امان بماند."],[964,"عاد را با دست حمال خذول","هم‌چو بره در کف مردی اکول","قوم عاد را مانند بره‌ای در دست مردی ناتوان و ذلیل به تصویر می‌کشد که به راحتی در اختیار اوست و هیچ قدرتی برای دفاع از خود ندارد."],[964,"هم‌چو فرزندش نهاده بر کنار","می‌برد تا بکشدش قصاب‌وار","او (شخصی در داستان) مانند کسی که فرزندش را روی کناری گذاشته و در حال بردن اوست، می‌خواهد او را به قتل برساند، درست مثل قصابی که حیوان را می‌برد تا بکشد."],[964,"عاد را آن باد ز استکبار بود","یار خود پنداشتند اغیار بود","باد، که نشانه‌ای از عذاب یا خشم الهی است، به خاطر تکبر و خودخواهی عاد به سراغ آن‌ها آمد. آن‌ها دوستان خود را دشمنان می‌پنداشتند و به این سبب دچار نابودی شدند."],[964,"چون بگردانید ناگه پوستین","خردشان بشکست آن بئس القرین","وقتی که به ناگاه پوستین (پوشش یا نقاب) آنها را برگرداند، در حقیقت، ارتباط بد و زشت آنها شکسته شد. این نشان می‌دهد که دوستان نادرست و بد، مانند همان پوستینی هستند که بر تن دارند و در زمان مناسب، ماهیت واقعی‌شان آشکار می‌شود."],[964,"باد را بشکن که بس فتنه‌ست باد","پیش از آن کت بشکند او هم‌چو عاد","باید باد را بشکنی، زیرا که فتنه‌انگیز است، پیش از آنکه تو را بشکند، مانند قوم عاد که به خاطر طغیان‌شان مجازات شدند."],[964,"هود دادی پند که ای پر کبر خیل","بر کند از دستتان این باد ذیل","خدای بزرگ به شما نصیحت کرده است که ای کسانی که به خود می‌بازید و مغرور هستید، این باد (که نماد فتنۀ بزرگ است) از دستان شما خواهد گرفت و شما را به خاک خواهد انداخت."],[964,"لشکر حق است باد و از نفاق","چند روزی با شما کرد اعتناق","لشکر حق همان باد است و به خاطر نفاق شما، موقتی با شما همکاری کرد و از شما دوری گزید."],[964,"او به سر با خالق خود راستست","چون اجل آید بر آرد باد دست","انسان در ارتباط خود با خالقش درست و صادق است و زمانی که مرگ فرا برسد، روح او مانند باد از بدن خارج می‌شود."],[964,"باد را اندر دهن بین ره‌گذر","هر نفس آیان روان در کر و فر","هر نفس که از دهن انسان بیرون می‌آید، مانند بادی است که در راه می‌وزد و نشان‌دهنده‌ی سفر زندگی اوست. این نفس‌ها که می‌آیند و می‌روند، به مرور زمان ما را به سوی هدف نهایی‌مان می‌برند، همان‌طور که باد در حرکت است."],[964,"حلق و دندان‌ها ازو آمن بود","حق چو فرماید به دندان در فتد","حلق و دندان‌ها از آسیب باد حفظ شده و در امان هستند، اما اگر خداوند بخواهد، درد دندان به آن‌ها می‌رسد."],[964,"کوه گردد ذره‌ای باد و ثقیل","درد دندان داردش زار و علیل","زمانی که ذره‌ای از باد به کوه تبدیل شود، به خاطر دردی که در دندانش دارد، تحت فشار و رنج قرار می‌گیرد و تسلیم می‌شود."],[964,"این همان بادست کآمن می‌گذشت","بود جان کشت و گشت او مرگ کشت","این باد که از آن صحبت می‌شود، همان دستی است که به آرامی می‌گذشت، اما اکنون باعث مرگ جان می‌شود و کشتن را به دنبال دارد."],[964,"دست آن کس که بکردت دست‌بوس","وقت خشم آن دست می‌گردد دبوس","اگر شخصی که به او احترام می‌گذاری و دستش را بوسیده‌ای، در حالت خشم باشد، همان دست به لکنت و سستی می‌افتد و به نوعی حالتی غیر از حالت محبت پیدا می‌کند."],[964,"یا رب و یا رب بر آرد او ز جان","که ببر این باد را ای مستعان","ای خدا، ای خدا، برسان او را از این وضع که این باد (چنین مشکلاتی) را از جان او ببر که تو یاری‌کننده‌ای."],[964,"ای دهان غافل بدی زین باد رو","از بن دندان در استغفار شو","ای دهان نادان، از این وزش باد غافل نباش. از عمق جانت به خاطر کارهایت پشیمان و استغفار کن."],[964,"چشم سختش اشک‌ها باران کند","منکران را درد الله‌خوان کند","چشم آن شخص به شدت می‌بارد و اشک‌هایی مانند باران می‌ریزد، و این اشک‌ها باعث می‌شود منکران، که به خدا و دردهای الهی اقرار ندارند، به یاد دردهای الهی بیفتند."],[964,"چون دم مردان نپذرفتی ز مرد","وحی حق را هین پذیرا شو ز درد","اگر تو از مردان، سخن حق و وحی را نپذیرفتی، اکنون خود را آماده کن و درد را بپذیر."],[964,"باد گوید پیکم از شاه بشر","گه خبر خیر آورم گه شوم و شر","باد به من می‌گوید که من پیام‌آور شاه هستم؛ گاهی خبرهای خوشی می‌آورم و گاهی هم خبرهای بد."],[964,"ز آنک مامورم امیر خود نیم","من چو تو غافل ز شاه خود کیم","من به خاطر اینکه مأمور امیر خود هستم، نمی‌توانم مانند تو که از شاه خود غافلی، بی‌خبر باشم."],[964,"گر سلیمان‌وار بودی حال تو","چون سلیمان گشتمی حمال تو","اگر وضعیت تو مانند سلیمان بود، من نیز به کمک تو می‌پرداختم و بار مسئولیت تو را به دوش می‌گرفتم."],[964,"عاریه‌ستم گشتمی ملک کفت","کردمی بر راز خود من واقفت","من به خاطر ظلم و ستمی که به من وارد شده است، در حقیقت ملک و سلطنت را عاریه (اجاره‌ای) دارم و در اندیشه‌های خود نسبت به رازهای زندگی‌ام آگاه هستم."],[964,"لیک چون تو یاغیی من مستعار","می‌کنم خدمت ترا روزی سه چار","اما چون تو یاغی و سرکش هستی، من برای تو به صورت قرض، خدمت خود را سه یا چهار بار در روز می‌کنم."],[964,"پس چو عادت سرنگونی‌ها دهم","ز اسپه تو یاغیانه بر جهم","زمانی که عادت سرنگونی‌ها را به تو می‌دهم، مانند یاغی و طغیانی که بر سر یک لشکر می‌آید، به تو حمله می‌کنم."],[964,"تا به غیب ایمان تو محکم شود","آن زمان که ایمانت مایه غم شود","تا زمانی که ایمان تو به غیب و اشیاء پنهان استوار شود، وقتی که ایمانت به جای آرامش برایت اندوه می‌آورد."],[964,"آن زمان خود جملگان مؤمن شوند","آن زمان خود سرکشان بر سر دوند","در آن زمان، همه مؤمنان واقعی خواهند شد و سرکشان و فاسدان نیز با ترس و وحشت به سمت خود خواهند آمد."],[964,"آن زمان زاری کنند و افتقار","هم‌چو دزد و راه‌زن در زیر دار","در آن زمان، افراد زاری می‌کنند و به زحمت و ضعف خود اعتراف می‌کنند، مانند دزدان و راه‌زنان که در زیر دار (محل اعدام) قرار دارند."],[964,"لیک گر در غیب گردی مستوی","مالک د