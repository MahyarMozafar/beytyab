‌شوند، در حالی که در روزهای پایانی عمر، نقص و زوال آشکار می‌شود."],[632,"خنده را در خواب هم تعبیر خوان","گریه گوید با دریغ و اندهان","خنده نیز در خواب ممکن است به معنای گریه تفسیر شود و این تعبیر به همراه شگفتی و افسوس بیان می‌شود."],[632,"گریه را در خواب شادی و فرح","هست در تعبیر ای صاحب مرح","در خواب، گریه می‌تواند به معنای شادی و خوشحالی تعبیر شود؛ ای کسی که به حقیقت و معانی عمیق آگاه هستی."],[632,"شاه اندیشید کین غم خود گذشت","لیک جان از جنس این بدظن گشت","شاه در ابتدا تصور کرد که غم و اندوه خود را فراموش کرده است، اما در حقیقت، روح و دل او به خاطر بدگمانی و سوءظنی که دارد، همچنان در رنج و ناراحتی باقی مانده است."],[632,"ور رسد خاری چنین اندر قدم","که رود گل یادگاری بایدم","اگر در راهی خاری به پا برود، آن گاه که گل یادگاری در میانه باشد، باید آن را تحمل کرد."],[632,"چون فنا را شد سبب بی‌منتهی","پس کدامین راه را بندیم ما","زمانی که مرگ و نابودی به وجود بیاید و علل آن پایان‌ناپذیر شوند، چه راهی باقی می‌ماند که ما در آن بند و گرفتار شویم؟"],[632,"صد دریچه و در سوی مرگ لدیغ","می‌کند اندر گشادن ژیغ ژیغ","مرگ در حال نزدیک شدن و در هر گوشه، درهای زیادی به سوی آن باز می‌شود و صداهای نالان و ترسناک ناشی از آن به گوش می‌رسد."],[632,"ژیغ‌ژیغ تلخ آن درهای مرگ","نشنود گوش حریص از حرص برگ","گوش آدم حریص به صدای تلخ و نگران‌کننده درهای مرگ نمی‌رسد، زیرا او در نتیجه حرص و طمع خود به این صداها توجهی ندارد."],[632,"از سوی تن دردها بانگ درست","وز سوی خصمان جفا بانگ درست","از طرف بدن انسان، دردها به شکلی واضح و درست به او هشداری می‌دهند، و از سوی دشمنان و رقیبان، نیز ظلم و سختی به شکل مشخصی به او اطلاع داده می‌شود."],[632,"جان سر بر خوان دمی فهرست طب","نار علتها نظر کن ملتهب","جان خود را بر سر سفره آگاهی بگذار و به فهرست دلایل و علل بیماری‌ها نگاه کن، که در آنجا نشانه‌های آشفتگی و بی‌قراری را مشاهده خواهی کرد."],[632,"زان همه غرها درین خانه رهست","هر دو گامی پر ز کزدمها چهست","در این خانه پر از فخر و خودخواهی و دعوا، نشان دهنده این است که هر دو طرف در تلاش هستند تا از یکدیگر جلو بزنند و به نوعی از پرخاش و درگیری پرهیز کنند."],[632,"باد تندست و چراغم ابتری","زو بگیرانم چراغ دیگری","باد تند در حال وزیدن است و چراغ من نیز در حال خاموشی و آسیب دیدن است؛ از باد می‌خواهم که چراغ دیگری را برای من بیاورد."],[632,"تا بود کز هر دو یک وافی شود","گر به باد آن یک چراغ از جا رود","تا زمانی که از دو چیز یکی کامل باشد، اگر آن چراغ یکی از جای خود برود، از بین نمی‌رود."],[632,"هم‌چو عارف کن تن ناقص چراغ","شمع دل افروخت از بهر فراغ","مانند عارفان، بدنی ناقص و ناتمام داشته باش، در حالی‌که چراغ دل تو روشن است تا بتوانی از آن برای رهایی و آزادگی خود بهره‌برداری کنی."],[632,"تا که روزی کین بمیرد ناگهان","پیش چشم خود نهد او شمع جان","تا زمانی که روزی مرگ فرا رسد، ناگهان او (انسان) باید شمع جان خود را پیش چشمش بگذارد."],[632,"او نکرد این فهم پس داد از غرر","شمع فانی را بفانیی دگر","او این درک را نکرد که شمع جان (حیات) هنوز در دست اوست و به همین دلیل، شمعی (زندگی) را که زوال‌پذیر است، به چیزی دیگر (مرگ یا فنا) واگذار کرده است."],[633,"پس عروسی خواست باید بهر او","تا نماید زین تزوج نسل رو","پس پادشاه برای فرزندش عروسی ترتیب داد تا از این ازدواج نسل و نسل‌های آینده به وجود آید."],[633,"گر رود سوی فنا این باز باز","فرخ او گردد ز بعد باز باز","اگر او به سوی فنا برود، این مرگ هم برایش خوش‌یمن خواهد بود، چون پس از آن دوباره به زندگی برمی‌گردد."],[633,"صورت او باز گر زینجا رود","معنی او در ولد باقی بود","اگر ظاهر او از اینجا برود، معنی او در فرزندش باقی خواهد ماند."],[633,"بهر این فرمود آن شاه نبیه","مصطفی که الولد سر ابیه","هدف از سخن شاه، نبی‌زاده مصطفی، این بود که نسل و فرزند به‌خودی‌خود، نمود بیرونی پدر است و از این طریق وجود پدر را ادامه می‌دهد."],[633,"بهر این معنی همه خلق از شغف","می‌بیاموزند طفلان را حرف","به دلیل عشق شدید و شگفتی که از این معنا در دل دارند، همه مردم به یادگیری الفبا و نکات الفبایی به کودکان خود اهتمام می‌ورزند."],[633,"تا بماند آن معانی در جهان","چون شود آن قالب ایشان نهان","وقتی معانی و مفاهیم در جهان باقی بمانند، باید قالب جسمانی آن‌ها (یعنی انسان‌ها) پنهان و از بین برود."],[633,"حق به حکمت حرصشان دادست جد","بهر رشد هر صغیر مستعد","خداوند به خاطر حکمت و دانایی خود، به هر جدی (پدربزرگ یا بزرگ خانواده) که در پی رشد و پرورش نوه‌های مستعد خود است، رغبت و اشتیاق داده است."],[633,"من هم از بهر دوام نسل خویش","جفت خواهم پور خود را خوب کیش","من نیز به خاطر ادامه نسل خود، می‌خواهم برای فرزندم همسری از خانواده‌ای نیکو و باستانی انتخاب کنم."],[633,"دختری خواهم ز نسل صالحی","نی ز نسل پادشاهی کالحی","می‌خواهم دختری از خانواده‌ای نیک و صالح انتخاب کنم، نه از خانواده‌ی پادشاهان که به تظاهر و خودخواهی معروفند."],[633,"شاه خود این صالحست آزاد اوست","نی اسیر حرص فرجست و گلوست","پادشاه خود را از نسل خوبی می‌داند و او فرزند آزاد و رها از سرکوب‌های خودخواسته است، نه اسیر هوس و حرص برای قدرت و مال."],[633,"مر اسیران را لقب کردند شاه","عکس چون کافور نام آن سیاه","شاه به اسیران لقب می‌دهد و نام آنها را به خاطر مشابهاتی که با کافور دارند، به سیاه‌ها نسبت می‌دهد. در واقع، اینجا اشاره به زیبایی یا لطافت آنهاست که شبیه کافور است، در حالی که خودشان سیاه‌پوست هستند."],[633,"شد مفازه بادیه خون‌خوار نام","نیکبخت آن پیس را کردند عام","در بادیه پرخون و غم، نام نیکبختی آن پیرمرد (پیشکسوت) را به صورت عمومی و شناخته‌شده قرار دادند."],[633,"بر اسیر شهوت و حرص و امل","بر نوشته میر یا صدر اجل","بر روی کسانی که اسیر شهوت، حرص و آرزوهای بی‌ثمر هستند، نام یا عنوانی که مربوط به مرگ و پایان عمر است، نوشته شده است."],[633,"آن اسیران اجل را عام داد","نام امیران اجل اندر بلاد","افرادی که به واسطه مرگ در بند و اسیر هستند، در واقع به نام «امیران اجل» شناخته می‌شوند و در سرزمین‌ها (بلاد) زندگی می‌کنند."],[633,"صدر خوانندش که در صف نعال","جان او پستست یعنی جاه و مال","اگر کسی در صف جانیان قرار گیرد که همانند او پست است، برتری و قدرتش کم اهمیت می‌شود و این باعث می‌شود که جاه و مال او دیگر ارزشی نداشته باشد."],[633,"شاه چون با زاهدی خویشی گزید","این خبر در گوش خاتونان رسید","شاه وقتی با یک زاهد که فردی زهد و پارسایی دارد خویشی و نسبت نزدیک برقرار کرد، این خبر به گوش زنان حرم رسید."],[634,"مادر شه‌زاده گفت از نقص عقل","شرط کفویت بود در عقل نقل","مادر شاهزاده گفت که از نظر عقل، شرط برابری در ازدواج به نقص عقل برمی‌گردد و باید در این مورد دقت کرد."],[634,"تو ز شح و بخل خواهی وز دها","تا ببندی پور ما را بر گدا","تو از سر خست و بخل می‌خواهی که با داشتن ثروت، پسر ما را برای ازدواج با درویش (گدا) نپذیری و او را از خود دور کنی."],[634,"گفت صالح را گدا گفتن خطاست","کو غنی القلب از داد خداست","گفتن این که صالح را «گدا» بنامیم نادرست است، چون او از نعمت‌های خداوند غنی و دل‌پسند است."],[634,"در قناعت می‌گریزد از تقی","نه از لیمی و کسل هم‌چون گدا","انسانی که قناعت می‌کند، از تنگ‌نظری و زحمت دوری می‌جوید و به سمت خست و تنبلی نمی‌رود، مانند گدا که به خاطر فقر و تنگ‌دستی گریز نمی‌زند."],[634,"قلتی کان از قناعت وز تقاست","آن ز فقر و قلت دونان جداست","قناعت و احتیاط از فقر و کمبود جداست؛ این قناعتی است که به سبب بزرگوار بودن و عدم نیاز به دیگران است، نه از روی حقارت و نداشتن."],[634,"حبه‌ای آن گر بیابد سر نهد","وین ز گنج زر به همت می‌جهد","اگر دانه‌ای (حبه‌ای) پیدا کند، سر خود را به آن می‌سپارد، و این از گنج زر (پول) با همت و تلاش زیاد برمی‌خیزد."],[634,"شه که او از حرص قصد هر حرام","می‌کند او را گدا گوید همام","شه که به خاطر طمع، هر کار نا‌پسندی را انجام می‌دهد، به او گدا می‌گوید همام. (همام به معنی «شخصی که در لباس درویش و فقیر است» است.)"],[634,"گفت کو شهر و قلاع او را جهاز","یا نثار گوهر و دینار ریز","گفتند: این پادشاه چه شهری و چه دژی دارد که او را به این ترتیب مورد تمجید قرار داده‌اند؟ آیا کسی از او هدایتی مثل جواهر و پول نیافریده است؟"],[634,"گفت رو هر که غم دین برگزید","باقی غمها خدا از وی برید","هر کس که نگرانی و غم دین را انتخاب کند، خداوند باقی غم‌ها و نگرانی‌های دیگر را از دل او دور خواهد کرد."],[634,"غالب آمد شاه و دادش دختری","از نژاد صالحی خوش جوهری","شاه بر دیگران غالب شد و دختری زیبا از نسل نیکان و شایسته به او دادند."],[634,"در ملاحت خود نظیر خود نداشت","چهره‌اش تابان‌تر از خورشید چاشت","چهره‌اش به قدری زیبا و جذاب بود که هیچ‌کس نمی‌توانست به او مانند باشد و زیبایی‌اش از نور خورشید صبح‌گاهی نیز درخشان‌تر بود."],[634,"حسن دختر این خصالش آنچنان","کز نکویی می‌نگنجد در بیان","خوبی و زیبایی دختر به‌قدری زیاد است که هیچ توصیفی نمی‌تواند آن را به‌درستی بیان کند."],[634,"صید دین کن تا رسد اندر تبع","حسن و مال و جاه و بخت منتفع","دین را به عنوان یک هدف بگیر تا به دنبال آن، زیبایی، ثروت، مقام و شانس نیز به دست آید."],[634,"آخرت قطار اشتر دان به ملک","در تبع دنیاش هم‌چون پشم و پشک","آخرت مثل یک بارکش بزرگ است که تحت تأثیر دنیا و خواسته‌های آن قرار دارد، مانند پشمی که به شتر بسته شده و از آن حمل می‌شود. در واقع، ارزش معنوی آخرت به خاطر دلبستگی‌های دنیوی کاهش می‌یابد."],[634,"پشم بگزینی شتر نبود ترا","ور بود اشتر چه قیمت پشم را","اگر تو انتخاب کنی که به جای شتر، پشم را برگزینی، دیگر هیچ معنایی برای تو ندارد؛ زیرا شتر ارزش پشم را ندارد."],[634,"چون بر آمد این نکاح آن شاه را","با نژاد صالحان بی مرا","زمانی که این ازدواج بین پادشاه و دختر درویش انجام شد، پادشاه با خانواده‌های نیکو (صالحان) بی‌مایه و بی‌ارزش به نظر آمد."],[634,"از قضا کمپیرکی جادو که بود","عاشق شه‌زاده با حسن و جود","شانس آورد که یک پیرزنی جادوگر، به شاهزاده با جمال و نیکی عاشق شد."],[634,"جادوی کردش عجوزه کابلی","کی برد زان رشک سحر بابلی","جادوی آن زن پیر کابلی، حسادت سحر و زیبایی بابلی را از بین برد."],[634,"شه بچه شد عاشق کمپیر زشت","تا عروس و آن عروسی را بهشت","شاهزاده جوان به زن زشت و پیر عاشق شد و به خاطر او آرزوی عروسی و برپایی جشن عروسی را داشت که آن را بهشت می‌دانست."],[634,"یک سیه دیوی و کابولی زنی","گشت به شه‌زاده ناگه ره‌زنی","یک زنی سیاه‌پوست و از کابل، ناگهان به پسر شاه حمله کرد و او را دزدید."],[634,"آن نودساله عجوزی گنده کس","نه خرد هشت آن ملک را و نه نس","یک زن سالخورده و چاق به هیچ‌وجه نه به عقل و هوش هشت ساله آن پسر توجهی دارد و نه به نسب و خانواده‌ی او."],[634,"تا به سالی بود شه‌زاده اسیر","بوسه‌جایش نعل کفش گنده پیر","شه‌زاده تا سال‌ها در اسارت آن نعل کفش بزرگ زن سالخورده‌ای بود که به او بوسه می‌زد."],[634,"صحبت کمپیر او را می‌درود","تا ز کاهش نیم‌جانی مانده بود","صحبت آن پیرزن (کمپیر) او را مشغول کرده بود و به همین دلیل از احساس ضعف و ناتوانی‌اش کاسته بود و تا حدی جانش را حفظ کرده بود."],[634,"دیگران از ضعف وی با درد سر","او ز سکر سحر از خود بی‌خبر","دیگران به دلیل ضعف و ناتوانی او، از درد و رنج خود آگاهی ندارند و مثل کسی هستند که در تحت تأثیر جادو، از واقعیات بی‌خبر است."],[634,"این جهان بر شاه چون زندان شده","وین پسر بر گریه‌شان خندان شده","این دنیا برای شاه همچون زندانی شده است و پسر، به جای غم و اندوه، در حال خندیدن بر گریه‌های آنهاست."],[634,"شاه بس بیچاره شد در برد و مات","روز و شب می‌کرد قربان و زکات","شاه در این وضعیت بسیار درمانده شده و در روز و شب در تلاش است تا به درویش (زاهد) خدمت کند و قربانی و صدقه بدهد."],[634,"زانک هر چاره که می‌کرد آن پدر","عشق کمپیرک همی‌شد بیشتر","چون هر راه حلی که آن پدر امتحان می‌کرد، عشق به دختر درویش (کمپیرک) در وجودش بیشتر و عمیق‌تر می‌شد."],[634,"پس یقین گشتش که مطلق آن سریست","چاره او را بعد از این لابه گریست","پس او یقین کرد که فقط یک راز مطلق وجود دارد و این راز، چاره‌اش می‌شود؛ بعد از این دیگر به زاری و التماس نپرداخت."],[634,"سجده می‌کرد او که هم فرمان تراست","غیر حق بر ملک حق فرمان کراست","او (درویش) سجده می‌کرد زیرا می‌دانست که فقط فرمان تو (خدا) حقیقت دارد و هیچ‌کس جز حق (خدا) نمی‌تواند بر ملک (سلطنت) حق (خدا) فرمان دهد."],[634,"لیک این مسکین همی‌سوزد چو عود","دست گیرش ای رحیم و ای ودود","این درویش مسکین مانند عودی در حال سوختن است و به شدت رنج می‌کشد، پس ای رحم‌کننده و ای دوست، او را دریاب و کمک کن."],[634,"تا ز یا رب یا رب و افغان شاه","ساحری استاد پیش آمد ز راه","درویشی به درگاه خداوند دعا می‌کند و فریاد می‌زند، ناگهان یک ساحر صاحب علم و قدرت به او نزدیک می‌شود."],[635,"او شنیده بود از دور این خبر","که اسیر پیرزن گشت آن پسر","او از دور شنیده بود که آن پسر اسیر جادوگری پیرزن شده است."],[635,"کان عجوزه بود اندر جادوی","بی‌نظیر و آمن از مثل و دوی","آن پیرزن، در جادوگری خود بی‌همتا و خاص بود و از نمونه و شبیه خود نیز بی‌نیاز بود."],[635,"دست بر بالای دست است ای فتی","در فن و در زور تا ذات خدا","فردی که در کارهایش مهارت و قدرت دارد، باید بداند که همه چیز تحت تسلط خداوند است و هیچ کس نمی‌تواند به طور کامل بر تمام امور تسلط یابد."],[635,"منتهای دستها دست خداست","بحر بی‌شک منتهای سیل‌هاست","در نهایت، توانایی و قدرت همه موجودات به دست خداوند محدود می‌شود و خداوند، منبع بی‌پایان و اصلی قدرتمندتر از همه است. مانند اینکه دریا، نهایت و انتهای سیلاب‌هاست."],[635,"هم ازو گیرند مایه ابرها","هم بدو باشد نهایت سیل را","همه منابع آبی و بارش‌ها از او (خدا) گرفته می‌شود و در نهایت همه سیلاب‌ها به او بازمی‌گردند."],[635,"گفت شاهش کاین پسر از دست رفت","گفت اینک آمدم درمان زفت","شاه گفت که این پسر من از دست رفته است و اکنون اینجا آمده‌ام تا درمانی برای او پیدا کنم."],[635,"نیست همتا زال را زین ساحران","جز من داهی رسیده زان کران","هیچ‌کس مانند زال، پسر رستم، از این جادوگران ندارد، جز من که از آن‌سوی کوه‌ها، این قدرت را یافته‌ام."],[635,"چون کف موسی به امر کردگار","نک برآرم من ز سحر او دمار","خداوند به موسی دستوری داد که ساحران را از سحرشان نجات دهد، و من نیز به همین ترتیب با اراده خدا، سحر ساحران را نابود می‌کنم."],[635,"که مرا این علم آمد زان طرف","نه ز شاگردی سحر مستخف","من این علم را از سوی خودم به دست آورده‌ام و نه از شاگردی و یادگیری سحر پنهان."],[635,"آمدم تا بر گشایم سحر او","تا نماند شاه‌زاده زردرو","من به اینجا آمده‌ام تا طلسم سحر او را باز کنم و شاه‌زاده که رویش زرد شده، دیگر در این وضع باقی نماند."],[635,"سوی گورستان برو وقت سحور","پهلوی دیوار هست اسپید گور","در وقت سحر به گورستان برو و در کنار دیوار گورستان، جایی که گور سفید است، قرار بگیر."],[635,"سوی قبله باز کاو آنجای را","تا ببینی قدرت و صنع خدا","به سمت قبله برو، جایی که آنجا قدرت و کارسازی خداوند را مشاهده کنی."],[635,"بس درازست این حکایت تو ملول","زبده را گویم رها کردم فضول","این داستان بسیار طولانی است و از تو خواهش می‌کنم که از بیان جزئیات خسته نشوی؛ زیرا من خلاصه‌اش را برایت بیان می‌کنم و به حرف‌های بی‌فایده نمی‌پردازم."],[635,"آن گره‌های گران را برگشاد","پس ز محنت پور شه را راه داد","مشکلات سخت و پیچیده پسر شاه را حل کرد و به این ترتیب او از رنج و سختی نجات یافت."],[635,"آن پسر با خویش آمد شد دوان","سوی تخت شاه با صد امتحان","آن پسر به طرف تخت شاه شتافت و مسیر را با سرعت طی کرد، در حالی که برای رسیدن به پدرش از چالش‌ها و آزمایش‌های زیادی عبور کرد."],[635,"سجده کرد و بر زمین می‌زد ذقن","در بغل کرده پسر تیغ و کفن","پسر به نشانه توبه و ندامت سجده کرد و سرش را به زمین می‌زند و در بغلش هم تیغ و کفن دارد که نماد مرگ و جدایی است."],[635,"شاه آیین بست و اهل شهر شاد","وآن عروس ناامید بی‌مراد","شاه مراسم شادی برپا کرد و مردم شهر خوشحال شدند، اما آن عروس هنوز ناامید است و به آرزویش نمی‌رسد."],[635,"عالم از سر زنده گشت و پر فروز","ای عجب آن روز روز امروز روز","دنیا از سر حیات جدیدی پیدا کرد و پر از نور و روشنایی شد؛ عجب است که آن روز، همان روز امروز است."],[635,"یک عروسی کرد شاه او را چنان","که جلاب قند بد پیش سگان","شاه برای پسرش عروسی بزرگی برپا کرد که شکوه و زیبایی آن مانند قند در برابر سگان بود، یعنی بسیار خوش‌عطر و دلپذیر بود و همه را مجذوب می‌کرد."],[635,"جادوی کمپیر از غصه بمرد","روی و خوی زشت فا مالک سپرد","جادوی کمپیر (زن جادوگر) به خاطر غصه‌ای که داشت، باعث مرگش شد و صفات زشتش را به مالک (پسر شاه) منتقل کرد."],[635,"شاه‌زاده در تعجب مانده بود","کز من او عقل و نظر چون در ربود","شاه‌زاده به شدت شگفت‌زده بود که چگونه عقل و فکر او به این آسانی از دست رفته است."],[635,"نو عروسی دید هم‌چون ماه حسن","که همی‌زد بر ملیحان راه حسن","پادشاه نوعروس زیبایی را می‌بیند که مانند ماه زیباست و در حال جلب توجه و جذب دیگران به خود است."],[635,"گشت بیهوش و برو اندر فتاد","تا سه روز از جسم وی گم شد فؤاد","او (عروس) بی‌هوش شد و به حالت غش درآمد تا سه روز قلبش از بدنش گم شد و حس‌وحال خود را از دست داد."],[635,"سه شبان‌روز او ز خود بیهوش گشت","تا که خلق از غشی او پر جوش گشت","او به مدت سه شبانه‌روز در حال بی‌هوشی بود و در این مدت مردم به خاطر غش کردنش بسیار نگران و ناراحت شدند."],[635,"از گلاب و از علاج آمد به خود","اندک اندک فهم گشتش نیک و بد","او کم‌کم به هوش آمد و با بوی گلاب و دارو به حالت طبیعی برگشت و شروع به درک خوبی و بدی کرد."],[635,"بعد سالی گفت شاهش در سخن","کای پسر یاد آر از آن یار کهن","پس از گذشت یک سال، شاه به پسرش گفت: \"ای پسر، به خاطر داشته باش آن دوست قدیمی را."],[635,"یاد آور زان ضجیع و زان فراش","تا بدین حد بی‌وفا و مر مباش","به یاد داشته باش که از آن حیوان بی‌وفا و آن فرد بی‌وفا (فراش) دوری کن و مانند آنان نشو."],[635,"گفت رو من یافتم دارالسرور","وا رهیدم از چه دارالغرور","گفت من به دارالسرور، جایی سرشار از شادی و خوشی رسیدم و از چاه دارالغرور، یعنی فریب¬ها و وسوسه‌ها نجات پیدا کردم."],[635,"هم‌چنان باشد چو مؤمن راه یافت","سوی نور حق ز ظلمت روی تافت","کسی که به ایمان واقعی دست پیدا کند، همچنان باید به سوی نور حقیقت حرکت کند و از تاریکی‌های دنیا دوری کند."],[636,"ای برادر دانک شه‌زاده توی","در جهان کهنه زاده از نوی","ای برادر، بدان که پسر پادشاه دنیا، از نسل آدم، در این جهان کهنه متولد شده است، نه از جدید."],[636,"کابلی جادو این دنیاست کو","کرد مردان را اسیر رنگ و بو","دنیا مانند جادوگری است که انسان‌ها را به زیبایی‌ها و زرق و برق‌های ظاهری مبتلا کرده و آنها را اسیر خود کرده است."],[636,"چون در افکندت دریغ آلوده روذ","دم به دم می‌خوان و می‌دم قل اعوذ","اگر در دام وسوسه‌ها و خطاها افتادی، هر لحظه دعا کن و به خدا پناه ببر و بگو که از شر این وسوسه‌ها به تو پناه می‌آورم."],[636,"تا رهی زین جادوی و زین قلق","استعاذت خواه از رب الفلق","برای رهایی از این جادو و این آشفتگی، از خدای سپیده‌دم (رب الفلق) کمک بخواه و به او پناه ببر."],[636,"زان نبی دنیات را سحاره خواند","کو به افسون خلق را در چه نشاند","این نبی، دنیا را با جادو و فریب معرفی می‌کند و به‌وسیله واقف بودن به این افسون، انسان‌ها را در مواردی خاص به دام می‌اندازد."],[636,"هین فسون گرم دارد گنده پیر","کرده شاهان را دم گرمش اسیر","بدان که پیر (کلفت یا دانا) با جادوی خود، شاهان و افراد بزرگ را تحت تأثیر قرار می‌دهد و به خاطر قدرت سحرش، آنها را به تسخیر خود درآورده است."],[636,"در درون سینه نفاثات اوست","عقده‌های سحر را اثبات اوست","در قلب او انرژی و قدرت وجود دارد که می‌تواند سحر و جادو را معرفی و ثابت کند."],[636,"ساحره دنیا قوی دانا زنیست","حل سحر او به پای عامه نیست","ساحره دنیا زنی بسیار توانمند و دانا است و مهارت او در باطل کردن سحر، برای مردم عادی قابل درک و فهم نیست."],[636,"ور گشادی عقد او را عقلها","انبیا را کی فرستادی خدا","اگر عقل‌ها نتوانند گشایش عقد او (مشکلات آدمی) را پیدا کنند، پس خدا چگونه انبیا را به سوی بشر فرستاده است؟"],[636,"هین طلب کن خوش‌دمی عقده‌گشا","رازدان یفعل الله ما یشا","باید در جستجوی فردی بگردی که گشاینده عقده‌ها و بدان رازها آگاه است، زیرا خداوند هر کاری را که بخواهد انجام می‌دهد."],[636,"هم‌چو ماهی بسته استت او به شست","شاه زاده ماند سالی و تو شصت","انسان برای مدت طولانی محدود و گرفتار است، مانند ماهی که در دستان کسی (شستی) محبوس است؛ او مانند فرزند شاه، مدت‌ها ذاتی پربار و با ارزش دارد، اما تو (شخصی که مورد خطاب است) شصت سال در رنج و سختی گذرانده‌ای."],[636,"شصت سال از شست او در محنتی","نه خوشی نه بر طریق سنتی","شصت سال از عمر او در زحمت و سختی گذشت و هیچ خوشحالی یا زندگی مطابق با سنت‌های نیکو نداشت."],[636,"فاسقی بدبخت نه دنیات خوب","نه رهیده از وبال و از ذنوب","فاسق بدبخت به حال نیکویی در دنیا برخوردار نیست و از گناهان و عذاب‌ها رهایی نیافته است."],[636,"نفخ او این عقده‌ها را سخت کرد","پس طلب کن نفخه خلاق فرد","نفخه‌ای که خداوند در آدم دمید، باعث شد که مسائل و مشکلات انسانی به شدت پیدا شود، بنابراین باید به دنبال روح خداوندی باشی که انسان را خلاق و جدید می‌کند."],[636,"تا نفخت فیه من روحی ترا","وا رهاند زین و گوید برتر آ","زمانی که من از روح خود در تو دمیدم، تو را رهایی می‌بخشم و به تو می‌گویم که در مرتبه‌ای بالاتر قرار داری."],[636,"جز به نفخ حق نسوزد نفخ سحر","نفخ قهرست این و آن دم نفح مهر","تنها نفخه‌ای که از جانب حق باشد، باعث می‌شود که انسان دچار عذاب نشود، در حالی که نفخه‌های سحر و قهر، موجب مصیبت و نابودی هستند. بنابراین، تنها دم و نفحه‌ای که بر مبنای مهر و محبت است، خیر و نیکی به همراه دارد."],[636,"رحمت او سابقست از قهر او","سابقی خواهی برو سابق بجو","رحمت الهی همواره بر قهر او مقدم است. اگر می‌خواهی از قهر او بگریزی، باید به رحمتش پناه ببری و به دنبال آن بروی."],[636,"تا رسی اندر نفوس زوجت","کای شه مسحور اینک مخرجت","تو به روح و جان همسرت می‌رسی، ای پادشاه مسحور، اکنون زمان ولادت توست."],[636,"با وجود زال ناید انحلال","در شبیکه و در بر آن پر دلال","اگرچه در شب و در فضایی که دلال (خنک و دلپذیر) است، زال (پیرمردی با موهای سفید) نمی‌تواند به راحتی از بین برود و محو شود. در اینجا به این نکته اشاره شده که در عین حال که زمان می‌گذرد، وجود و هویت فردی و مهمی مانند زال پایدار می‌ماند."],[636,"نه بگفتست آن سراج امتان","این جهان و آن جهان را ضرتان","این سخن درست نیست که بگوید نور روشنی بخش این دنیا و آن دنیا دو چیز متفاوت است."],[636,"پس وصال این فراق آن بود","صحت این تن سقام جان بود","این جدا شدن و فراق از محبوب، به خاطر وصال و نزدیکی به اوست و در واقع سلامت و تندرستی این بدن نتیجه‌ی آن وصال است، در حالی که بیماری جان به خاطر جدایی است."],[636,"سخت می‌آید فراق این ممر","پس فراق آن مقر دان سخت‌تر","فراق و جدایی از آن مکانی که به آن تعلق داریم، به مراتب دردناک‌تر و سخت‌تر می‌آید. پس از آنکه از جایی که در آن سکونت داشته‌ایم دور می‌شویم، این جدایی به شدت بر ما تأثیر می‌گذارد."],[636,"چون فراق نقش سخت آید ترا","تا چه سخت آید ز نقاشش جدا","وقتی که جدایی از نقش (وجود یا عشق) برای تو سخت است، پس بدان که جدایی از نقاش (خالق) آن نقش نیز به مراتب سخت‌تر خواهد بود."],[636,"ای که صبرت نیست از دنیای دون","چونت صبرست از خدا ای دوست چون","ای کسی که در برابر دنیا و رنج‌های آن صبر نداری، پس چطور می‌توانی از خداوند صبر داشته باشی؟"],[636,"چونک صبرت نیست زین آب سیاه","چون صبوری داری از چشمه اله","اگر نسبت به این دنیای ناپایدار و مشکلات آن صبر و شکیبایی نداری، چگونه می‌توانی از چشمه الهی که سرچشمه آرامش و عشق است، صبر و آرامش داشته باشی؟"],[636,"چونک بی این شرب کم داری سکون","چون ز ابراری جدا وز یشربون","چون بدون نوشیدن این آب، آرامش و سکون نداری، مانند کسی هستی که از ابرها جدا شده و نمی‌تواند از آن‌ها بنوشد."],[636,"گر ببینی یک نفس حسن ودود","اندر آتش افکنی جان و وجود","اگر یک لحظه زیبایی و محبت را ببینی، جان و وجودت را برای آن قربانی خواهی کرد و حتی خود را در آتش می‌اندازی."],[636,"جیفه بینی بعد از آن این شرب را","چون ببینی کر و فر قرب را","اگر پس از نوشیدن این شراب، زشتی و پلیدی ببینی، به مانند آن است که از نزدیک بودن به مقام قرب الهی، کر (کور) شده‌ای و دیگر نمی‌توانی زیبایی‌ها را ببینی."],[636,"هم‌چو شه‌زاده رسی در یار خویش","پس برون آری ز پا تو خار خویش","همچون یک پسر شاه، وقتی به محبوب و یار خود می‌رسی، باید خارها و مشکلاتی را که در دلت هست، از خود دور کنی و کنار بگذاری."],[636,"جهد کن در بی‌خودی خود را بیاب","زودتر والله اعلم بالصواب","تلاش کن تا در حالت بی‌خودی خود حقیقی‌ات را پیدا کنی، زیرا خداوند به حقیقت‌ها آگاه‌تر است."],[636,"هر زمانی هین مشو با خویش جفت","هر زمان چون خر در آب و گل میفت","هر لحظه مواظب باش که با خودت همراه نشوی و اجازه ندهی که به مشکلات و سختی‌ها گرفتار شوی، چرا که در این حالت همچون خر در آب و گل به دردسر خواهی افتاد."],[636,"از قصور چشم باشد آن عثار","که نبیند شیب و بالا کور وار","این بیت می‌گوید که اگر انسان نتواند بعضی حقایق را ببیند، مشکل از نقص دید اوست و به مانند کسی است که به خاطر کوری نمی‌تواند ارتفاعات و شیب‌ها را تشخیص دهد."],[636,"بوی پیراهان یوسف کن سند","زانک بویش چشم روشن می‌کند","بوی پیراهن یوسف، موجب روشنی چشم می‌شود و انسان را به شادابی و سرزندگی می‌آورد، بنابراین پدرش را از غم و اندوه می‌رهاند."],[636,"صورت پنهان و آن نور جبین","کرده چشم انبیا را دوربین","این بیت می‌گوید که حقیقتی پنهان و نور درخشان از پیشانی آدمی (که همان خلیفه خداست) وجود دارد که باعث می‌شود انبیا به خوبی و به دقت او را مشاهده کنند و راه هدایت را پیدا کنند."],[636,"نور آن رخسار برهاند ز نار","هین مشو قانع به نور مستعار","نور آن چهره (رخسار) انسان کامل، انسان را از عذاب و آتش نجات می‌دهد. پس نباید به نورهای تقلیدی و غیرواقعی (نور مستعار) قانع باشی."],[636,"چشم را این نور حالی‌بین کند","جسم و عقل و روح را گرگین کند","چشم، با این نور، حالت و حالتی را می‌بیند که می‌تواند جسم و عقل و روح را غمگین و نگران کند."],[636,"صورتش نورست و در تحقیق نار","گر ضیا خواهی دو دست از وی بدار","ظاهرش نورانی است، اما در عمق وجودش آتش و ناپاکی نهفته است. اگر خواهان روشنی و نور هستی، باید از او فاصله بگیری و دست از او برداری."],[636,"دم به دم در رو فتد هر جا رود","دیده و جانی که حالی‌بین بود","هر لحظه‌ای که افراد آگاه و بینا به جایی می‌روند، در آنجا زندگی و روحی جدید به چشم می‌خورد."],[636,"دور بیند دوربین بی‌هنر","هم‌چنانک دور دیدن خواب در","کسی که هنر ندارد، فقط دور را می‌بیند و نه حقیقت آن را، مانند کسی که در خواب چیزی دور را می‌بیند و نمی‌تواند آن را به درستی درک کند."],[636,"خفته باشی بر لب جو خشک‌لب","می‌دوی سوی سراب اندر طلب","اگر در کناره آب بی‌حرکت و در خواب باشی و به سمت سراب، که در واقع آبی نیست، بشتابی، در حقیقت در پی چیزی دلالت‌کننده‌ای هستی که وجود خارجی ندارد."],[636,"دور می‌بینی سراب و می‌دوی","عاشق آن بینش خود می‌شوی","دور از تو، تصویر سراب را می‌بینی و به سمت آن می‌دوی، در حالی که عاشق آن تصور و خیالی که در ذهنت داری، می‌شوی."],[636,"می‌زنی در خواب با یاران تو لاف","که منم بینادل و پرده‌شکاف","در خواب با دوستانت می‌گویی که من شخصی خردمند و حقیقت‌جو هستم، در حالی که در واقعیت اینگونه نیست و خود را فریب می‌دهی."],[636,"نک بدان سو آب دیدم هین شتاب","تا رویم آنجا و آن باشد سراب","باید بدانید که در آن سمت، آبی دیدم، پس عجله کن تا به آنجا بروم و متوجه می‌شوم که آن آب، سراب است."],[636,"هر قدم زین آب تازی دورتر","دو دوان سوی سراب با غرر","هر قدم که از این آب دورتر می‌شوی، به‌سمت سراب، با شتاب می‌روید و در آن فریبندگی جلوه‌هایی دارد."],[636,"عین آن عزمت حجاب این شده","که به تو پیوسته است و آمده","اراده و عزم تو آنقدر باعث شده که حجاب و مانع بر سر راه تو قرار گرفته و در نتیجه به تو نزدیک شده است."],[636,"بس کسا عزمی به جایی می‌کند","از مقامی کان غرض در وی بود","بسیاری از افراد بر اساس اراده و خواسته‌های خود به مقاصدی می‌رسند که در حقیقت فقط به خاطر هدفی خاص در وجود آنان بوده است."],[636,"دید و لاف خفته می‌ناید به کار","جز خیالی نیست دست از وی بدار","تنها خیال و توهمات در خواب، انسان را به کار یا فعالیت نمی‌آورند و در واقع جز یک خواب و وهم چیزی نیستند. بنابراین بهتر است از این توهمات دست بکشی و به واقعیت‌ها توجه کنی."],[636,"خوابناکی لیک هم بر راه خسپ","الله الله بر ره الله خسپ","خواب سنگین است، اما در این حال هم بر راه ایستاده است و در دلش نام خدا را زمزمه می‌کند."],[636,"تا بود که سالکی بر تو زند","از خیالات نعاست بر کند","اگر سالکی در مسیر عرفانی به تو زنگ بزند و از خیالات بی‌اساس و ناپایدار رها شود، تو باید به او کمک کنی تا به حقیقت و واقعیت نزدیک‌تر شود."],[636,"خفته را گر فکر گردد هم‌چو موی","او از آن دقت نیابد راه کوی","اگر کسی که خواب است، فکرش بیدار شود، مانند موی او نمی‌تواند به دقتی دست یابد که راهی به حقیقت یا کمال پیدا کند."],[636,"فکر خفته گر دوتا و گر سه‌تاست","هم خطا اندر خطا اندر خطاست","اگر فکر خواب‌آلود فردی دو یا سه بار هم تکرار شود، باز هم خطاست و در اشتباه است. منظور این است که فکر ناهشیار، هر چند چند بار تکرار شود، به نتیجه درست نمی‌رسد."],[636,"موج بر وی می‌زند بی‌احتراز","خفته پویان در بیابان دراز","خواب‌آلودگانی که در بیابان دراز در حال حرکت هستند، بی‌احتیاط در برابر خطراتی که ممکن است برایشان پیش بیاید، غافل‌اند و مانند موجی که به آن‌ها می‌رسد، این خطرات نیز به زندگی‌شان حمله می‌کنند."],[636,"خفته می‌بیند عطشهای شدید","آب اقرب منه من حبل الورید","خواب‌زده‌ای را می‌بیند که عطش شدیدی دارد و در چنین حالتی، در جست‌وجوی آب است ولی خود را به آن نزدیک نمی‌کند و در شرایط دشواری گرفتار شده است. حبل الورید به معنای رگ نزدیک به قلب است که نیاز به آب را نشان می‌دهد."],[637,"هم‌چنان کن زاهد اندر سال قحط","بود او خندان و گریان جمله رهط","زاهد در سال قحط همچنان خندان و گریان بود و این حالت برای او عادی شده بود، در حالی که دیگران اطرافش غمگین و نگران بودند."],[637,"پس بگفتندش چه جای خنده است","قحط بیخ مؤمنان برکنده است","به او گفتند چرا می‌خندی در حالی که قحطی و گرسنگی در میان مردم مؤمن بیداد می‌کند و باعث رنج آن‌ها شده است."],[637,"رحمت از ما چشم خود بردوخته‌ست","ز آفتاب تیز صحرا سوخته‌ست","رحمت خداوند از ما روی برگردانده است و به دلیل سختی‌ها و مشکلات، مانند آفتاب تیز که در صحرا می‌سوزاند، به ما نرسیده است."],[637,"کشت و باغ و رز سیه استاده است","در زمین نم نیست نه بالا نه پست","زمین در حال حاضر خشک و بی‌حیات است و هیچ نشانه‌ای از سبزی و زندگی، مانند کشتزار یا باغ، در آن نیست. وضعیت زمین نه خوب است و نه بد، بلکه به‌طور کلی بی‌حالت و فقیر به نظر می‌رسد."],[637,"خلق می‌میرند زین قحط و عذاب","ده ده و صد صد چو ماهی دور از آب","مردم به خاطر قحطی و عذاب ناشی از آن در حال مرگ هستند و این وضعیت به قدری دردناک است که همچون ماهی‌هایی هستند که از آب دور افتاده‌اند و در حال خفگی و گرسنگی به سر می‌برند."],[637,"بر مسلمانان نمی‌آری تو رحم","مؤمنان خویشند و یک تن شحم و لحم","تو بر مسلمانان رحم نمی‌کنی، در حالی که مؤمنان مانند یک جسم واحد هستند و همه به هم وابسته‌اند، بنابراین وقتی یکی از آن‌ها آسیب می‌بیند یا دچار مشکل می‌شود، باید برای همه تسلیت و همدردی احساس کرد."],[637,"رنج یک جزوی ز تن رنج همه‌ست","گر دم صلحست یا خود ملحمه‌ست","رنج یک جزئی از بدن، در واقع رنج همه‌ است؛ چه زمانی که در صلح و آرامش هستیم و چه وقتی که در جنگ و نبرد به سر می‌بریم."],[637,"گفت در چشم شما قحطست این","پیش چشمم چون بهشتست این زمین","او می‌گوید در چشمان شما قحطی و کمبود دیده می‌شود، اما در چشم من این زمین مانند بهشت است و پر از نعمت و سرسبزی به نظر می‌رسد."],[637,"من همی‌ بینم به هر دشت و مکان","خوشه‌ها انبه رسیده تا میان","من در هر دشت و گوشه‌ای، خوشه‌های فراوانی را می‌بینم که به اندازه کافی رسیده‌اند و پر هستند."],[637,"خوشه‌ها در موج از باد صبا","پر بیابان سبزتر از گندنا","خوشه‌های گندم در میان وزش باد صبا در صحرا به قدری زیبا و سرسبز هستند که حس می‌شود سبزتر از گندم‌زاری پرمحصول هستند."],[637,"ز آزمون من دست بر وی می‌زنم","دست و چشم خویش را چون برکنم","من از امتحانات و آزمایش‌های زندگی، خودم را جدا می‌کنم و نمی‌خواهم به مشکلات و سختی‌ها توجهی بکنم، انگار که چشم و دست خود را از آن‌ها برمی‌دارم."],[637,"یار فرعون تنید ای قوم دون","زآن نماید مر شما را نیل خون","فرعاون دوستی دارد که در میان شما، اهل پستی و فرومایگی است و از او انتظار دارید که برایتان نجات‌دهنده باشد. او به جای نجات، برای شما درد و مصیبت به همراه می‌آورد، از همین رو به شما آسیب می‌زند."],[637,"یار موسی خرد گردید زود","تا نماند خون بینید آب رود","یار موسی (موسی بن عمران، پیامبر) به زودی خرد و متوجه شد که نمی‌تواند خون را برای گرامی‌داشت مردم ببیند، بنابراین تصمیم گرفت که آب رود نیل را ببندد تا از دیدن آن خون جلوگیری کند."],[637,"با پدر از تو جفایی می‌رود","آن پدر در چشم تو سگ می‌شود","آنچه که تو بر پدر خود روا می‌داری، به‌گونه‌ای است که او در نظر تو به حدی پست می‌آید که همانند یک سگ به نظر می‌رسد."],[637,"آن پدر سگ نیست تاثیر جفاست","که چنان حرمت نظر را سگ نماست","پدر تو در واقع سگ نیست، بلکه تأثیر جفایی که از تو بر او رفته باعث شده که در نظر تو این‌طور بی‌احترامی به او شود."],[637,"گرگ می‌دیدند یوسف را به چشم","چونک اخوان را حسودی بود و خشم","برادران یوسف به خاطر حسد و خشم خود، او را به صورت گرگ می‌دیدند و از این رو، او را شکارچی می‌پنداشتند."],[637,"با پدر چون صلح کردی خشم رفت","آن سگی شد گشت بابا یار تفت","زمانی که با پدر صلح کردی و کینه را کنار گذاشتی، خشم و ناراحتی از بین رفت و آن سگ، که نماد ناپختگی و بداخلاقی است، تبدیل به یار و دوست تو شد."],[638,"کل عالم صورت عقل کل است","کوست بابای هر آنکه اهل قل است","تمام عالم تجلی و صورت عقل کل است که همان پدر معنوی و اصلی هر کسی است که اهل گفت‌وگو و اندیشه است."],[638,"چون کسی با عقل کل کفران فزود","صورت کل پیش او هم سگ نمود","اگر کسی با عقل کل (که نمایان‌گر حقیقت و دانش است) نافرمانی و کفران کند، در نتیجه، همگان از منظر او مانند یک سگ (و بی‌ارزش) می‌شوند."],[638,"صلح کن با این پدر‌، عاقی بهل","تا که فرش‌ زر نماید آب و گل","عاقی‌: ملعونی و نافرمانی‌، بهل‌: بگذار‌، کنار بگذار."],[638,"پس قیامت نقد حال تو بود","پیش تو چرخ و زمین مبدل شود","در روز قیامت، حقیقت واقعی تو برایت آشکار می‌شود و در آن زمان ممکن است دنیا و هرچیزی که در آن وجود دارد، دگرگون گردد."],[638,"من که صلحم دایما با این پدر","این جهان چون جنتستم در نظر","من که همیشه در صفای دوستی با این پدر (خدای جهان) هستم، در نظر خودم این جهان مانند بهشتی است."],[638,"هر زمان نو صورتی و نو جمال","تا ز نو دیدن فرو میرد ملال","در هر زمانی، صورت و زیبایی جدیدی به وجود می‌آید، تا از دیدن این نوآوری‌ها، نگرانی و ناراحتی‌ها کاهش یابد."],[638,"من همی‌بینم جهان را پر نعیم","آبها از چشمه‌ها جوشان مقیم","من جهان را پر از نعمت و خوشی می‌بینم و آب‌ها از چشمه‌های جوشان همواره در حال جریان هستند."],[638,"بانگ آبش می‌رسد در گوش من","مست می‌گردد ضمیر و هوش من","صدای آب به گوش من می‌رسد و باعث می‌شود که حواسم و تفکرم در حالتی سرمست و شاداب قرار بگیرد."],[638,"شاخه‌ها رقصان شده چون تایبان","برگ‌ها کف‌زن مثال مطربان","شاخه‌ها مانند کسانی که در حال اجرای رقص هستند به حرکت درآمده و برگ‌ها را مانند نوازندگان، به هم می‌زنند و به نمایش درمی‌آورند."],[638,"برق آیینه‌ست لامع از نمد","گر نماید آینه تا چون بود‌!","درخشش این آیینه وقتی که در نمد پیچیده شده تابان است، ببین آن زمان که بی‌نمد روی نماید چقدر درخشان خواهد بود! (آینه‌های فلزی را در گذشته برای زلال ماندن در نمد می‌پیچیده‌اند‌)"],[638,"از هزاران می‌نگویم من یکی","ز آنکه آکنده‌ست هر گوش از شکی","من می‌گویم که از میان هزاران، من فقط یکی هستم که هر گوش از شک و تردید پر شده است."],[638,"پیش وهم این گفت مژده دادن است","عقل گوید مژده چه نقد من است","عقل می‌گوید که جلوتر از تصور و خیال، من خبر خوشی دارم، اما باید بدانید که داوری و نقد من چیست."],[639,"همچو پوران عزیر اندر گذر","آمده پرسان ز احوال پدر","فرزندان عزیر، مانند نوجوانانی که در گذر زمان بزرگ شده‌اند، از حال و احوال پدرشان سؤال می‌کردند."],[639,"گشته ایشان پیر و باباشان جوان","پس پدرشان پیش آمد ناگهان","فرزندان عزیر وقتی به او می‌نگریستند، متوجه شدند که خودشان پیر شده‌اند اما پدرشان عزیر همچنان جوان و سرحال به نظر می‌رسد که ناگهان به آن‌ها نزدیک شده است."],[639,"پس بپرسیدند ازو کای ره‌گذر","از عزیر ما عجب داری خبر","فرزندان عزیر (عزیر علیه‌السلام) از آن مرد ره‌گذر می‌پرسند که آیا تو از عزیر خبر داری؟ آنها از مجدد آمدن پدرشان شگفت‌زده شده‌اند و می‌خواهند اطلاعات بیشتری بگیرند."],[639,"که کسی‌مان گفت که امروز آن سند","بعد نومیدی ز بیرون می‌رسد","کسی به ما خبر داد که امروز آن امیدی که بعد از ناامیدی به نظر می‌رسید، از بیرون خواهد آمد."],[639,"گفت آری بعد من خواهد رسید","آن یکی خوش شد چو این مژده شنید","او گفت که بعد از من (عزیر) خواهد آمد، و یکی از فرزندانش وقتی این بشارت را شنید، خوشحال شد."],[639,"بانگ می‌زد کای مبشر باش شاد","وان دگر بشناخت بیهوش اوفتاد","شخصی که خبر خوشی آورده بود، فریاد می‌زد که ای مژده‌دهنده، شاد باش. اما دیگرانی که او را شناختند، به‌قدری تحت تأثیر قرار گرفتند که بیهوش شدند."],[639,"که چه جای مژده است ای خیره‌سر","که در افتادیم در کان شکر","سوالی از شخصی نادان و مغرور است که مژده و خوشحالی چه جایگاهی دارد، وقتی ما در درون یک مکان شیرین و خوشایند (مانند کان شکر) به بی‌خبر و حیران افتاده‌ایم."],[639,"وهم را مژده‌ست و پیش عقل نقد","ز انک چشم وهم شد محجوب فقد","وهم (تصور و خیال) برای خودش مژده‌ای دارد، اما عقل واقعیت را می‌بیند و به درستی قضاوت می‌کند، زیرا چشم وهم (خیال) به خاطر وجودش از حقیقت دور است و نمی‌تواند آن را بشناسد."],[639,"کافران را درد و مؤمن را بشیر","لیک نقد حال در چشم بصیر","کافران به درد و رنج دچارند، در حالی که مؤمنان مژده و بشارت می‌گیرند؛ اما آنچه در واقعیت و حقیقت وجود دارد، در نظر بینایان فرقی ندارد."],[639,"زانک عاشق در دم نقدست مست","لاجرم از کفر و ایمان برترست","عاشق در لحظه حال غرق در عشق است و به همین خاطر او بالاتر از کفر و ایمان قرار دارد."],[639,"کفر و ایمان هر دو خود دربان اوست","کوست مغز و کفر و دین او را دو پوست","کفر و ایمان هر دو در واقع خدمت‌گزار او هستند؛ آنچه که واقعی و باطنی است مغز محسوب می‌شود و کفر و دین مانند دو لایه بیرونی عمل می‌کنند."],[639,"کفر قشر خشک رو بر تافته","باز ایمان قشر لذت یافته","کفر، مانند پوسته‌ای خشک است که در برابر نور تابیده است، اما ایمان، پوسته‌ای است که از لذت و زیبایی برخوردار شده و درخشش خاصی دارد."],[639,"قشرهای خشک را جا آتش است","قشر پیوسته به مغز جان خوش است","ظاهر سخت و بی‌روح (قشرهای خشک) همچون آتش است و در دل و جوهر آدمی (مغز جان) لذت و خوشی واقعی وجود دارد."],[639,"مغز خود از مرتبه خوش برترست","برترست از خوش که لذت گسترست","روشن است که مغز انسان نسبت به خوشی‌ها و لذت‌ها در مرتبه‌ای بالاتر قرار دارد و از آنچه به عنوان خوشی شناخته می‌شود، برتر است؛ زیرا لذت واقعی و عمیق‌تر از خوشی‌های ظاهری ناشی می‌شود."],[639,"این سخن پایان ندارد باز گرد","تا برآرد موسیم از بحر گرد","این سخن هیچ‌گاه تمام نمی‌شود، دوباره برگردیم تا موسی (که اشاره به پیامبر موسی است) از دریا به درآید."],[639,"درخور عقل عوام این گفته شد","از سخن باقی آن بنهفته شد","این سخن که برای عوام مناسب است، از باقی گفته‌های عمیق‌تر پنهان مانده است و آنها را درک نمی‌کنند."],[639,"زر عقلت ریزه است ای متهم","بر قراضه مهر سکه چون نهم","ای متهم، عقل تو کم‌نور و بی‌ارزش است مانند زر ناب که خرد شده و فقط تکه‌هایی از آن باقی مانده است. چه ارزشی دارد که بر این تکه‌های کوچک مانند سکه‌های درهم و برهم تکیه کنی؟"],[639,"عقل تو قسمت شده بر صد مهم","بر هزاران آرزو و طم و رم","عقل تو بین بسیاری از امور و آرزوها تقسیم شده است و این باعث شده که نتوانی به طور کامل به یک چیز متمرکز شوی و از آن بهره‌برداری کنی."],[639,"جمع باید کرد اجزا را به عشق","تا شوی خوش چون سمرقند و دمشق","برای رسیدن به خوشبختی و تکامل، باید اجزا و بخش‌های زندگی را با عشق کنار هم جمع کرد تا مانند سمرقند و دمشق، دو شهر زیبا و خوش آب و هوا، زیبا و خوشبخت شویم."],[639,"جو جوی چون جمع گردی ز اشتباه","پس توان زد بر تو سکه پادشاه","وقتی که انسان مانند جوی آب جمع و یکپارچه شود و از اشتباهات بگذرد، می‌تواند به مقام والایی دست یابد و به او ارج و اعتبار داده خواهد شد، مانند این‌که بر او سکه پادشاه ضرب می‌شود."],[639,"ور ز مثقالی شوی افزون تو خام","از تو سازد شه یکی زرینه جام","اگر از مقداری کم‌تر هم بیشتر شوی، چون نادان هستی، پادشاه برای تو جامی زرین (طلایی) می‌سازد."],[639,"پس برو هم نام و هم القاب شاه","باشد و هم صورتش ای وصل خواه","بنابراین، باید هم نام و هم عنوان پادشاه را به دست آورده و هم شمایل او را بشناسی، ای کسی که مشتاق وصال او هستی."],[639,"تا که معشوقت بود هم نان هم آب","هم چراغ و شاهد و نقل و شراب","تا زمانی که معشوق انسان هم نان و هم آب و هم چراغ و شاهد و همچنین نقل (بخشی از داستان‌ها یا شعرها) و شراب (نشانه‌ای از شادمانی) باشد، زندگی او سرشار از نعمت و خوشی خواهد بود."],[639,"جمع کن خود را جماعت رحمتست","تا توانم با تو گفتن آنچ هست","خودت را جمع و جور کن، چون جمع شدن و یکپارچگی تو موجب رحمت الهی است، تا بتوانم با تو درباره حقایق و آنچه هست صحبت کنم."],[639,"زانک گفتن از برای باوریست","جان شرک از باوری حق بریست","گفتن و سخن گفتن به خاطر باوری که داریم، ضروری است. اگر انسانی با ایمان حقیقی باشد، نمی‌تواند در صحبت‌هایش دچار تردید و شک ‌شود."],[639,"جان قسمت گشته بر حشو فلک","در میان شصت سودا مشترک","جان، تقسیم شده و در آسمان پراکنده است و در میان شصت نوع سودا و خواسته مشترک وجود دارد."],[639,"پس خموشی به دهد او را ثبوت","پس جواب احمقان آمد سکوت","در این بیت، گفته می‌شود که زمانی که فردی دچار شناخت نادرست می‌شود یا نمی‌تواند حقیقت را درک کند، تنها سکوت و خاموشی می‌تواند او را به درک درست نزدیک کند، چرا که پاسخ به بی‌خردی و نادانی دیگران، معمولا در سکوت است."],[639,"این همی‌دانم ولی مستی تن","می‌گشاید بی‌مراد من دهن","من می‌دانم که مستی، تن را رها می‌کند و آرامش می‌دهد، اما این حالتی که دارم، باعث نمی‌شود که به آرزوهایم برسید."],[639,"آنچنان که از عطسه و از خامیاز","این دهان گردد بناخواه تو باز","چنان‌که به خاطر عطسه و کم‌حواسی، از این دهان ممکن است چیزی خارج شود، تو نیز به اختیار خود می‌توانی به سوی من بیاورید."],[640,"هم‌چو پیغامبر ز گفتن وز نثار","توبه آرم روز من هفتاد بار","مانند پیامبران، از گفتن و ابراز توبه، روزانه هفتاد بار توبه می‌کنم."],[640,"لیک آن مستی شود توبه‌شکن","منسی است این مستی تن جامه کن","ولی آن حالت مستی که باعث ترک توبه می‌شود، حالتی فراموش‌شده و بی‌ارزش است، پس آن مستی را از خود دور کن و لباس آن را کنار بگذار."],[640,"حکمت اظهار تاریخ دراز","مستیی انداخت در دانای راز","حکمت این است که تاریخ طولانی مستی، در فهم و دانایی اسرار و نکات نهفته تأثیر دارد و انسان را به درک عمیق‌تری از واقعیات سوق می‌دهد."],[640,"راز پنهان با چنین طبل و علم","آب جوشان گشته از جف القلم","راز پنهان در اینجا با اسباب و نشانه‌های واضحی به نمایش درآمده است، به‌گونه‌ای که مانند صدای طبل و جوی آب جوشیده، به وضوح شنیده می‌شود و دیگر پنهان نیست."],[640,"رحمت بی‌حد روانه هر زمان","خفته‌اید از درک آن ای مردمان","رحمت بی‌نهایت خداوند همیشه در حال سرازیر شدن است، ولی شما (ای مردمان) از درک این رحمت غافل هستید و در خواب به سر می‌برید."],[640,"جامه خفته خورد از جوی آب","خفته اندر خواب جویای سراب","آب وجود و حقیقت در خواب است و کسی که در جستجوی حقیقت به خواب رفته، نمی‌تواند به آن دست پیدا کند. کسی که در خواب بی‌حالی به سر می‌برد، نمی‌تواند از آن آب زنده و واقعی استفاده کند و در نهایت، آرزوی او (سراب) به حقیقت نخواهد پیوست."],[640,"می‌رود آنجا که بوی آب هست","زین تفکر راه را بر خویش بست","کسی که به فکر و تأمل می‌پردازد، به جایی می‌رود که آب و زندگی وجود دارد، اما این تفکر او را از مسیر واقعی‌اش دور کرده است."],[640,"زانک آنجا گفت زینجا دور شد","بر خیالی از حقی مهجور شد","چون آنجا (جایی که بوی آب است) به حقیقت اشاره شده، فردی که در اینجا (در حال تفکر و شک) به سر می‌برد، از آن حقیقت دور شده و به خاطر خیالی که دارد، از حقیقت و نمایش خداوند دورتر می‌شود."],[640,"دوربینانند و بس خفته‌روان","رحمتی آریدشان ای ره‌روان","خواب‌آلودگان دوربین هستند و فقط به خواب رفته‌اند، ای رهروان، بر آن‌ها رحمتی نازل کنید."],[640,"من ندیدم تشنگی خواب آورد","خواب آرد تشنگی بی‌خرد","تشنگی واقعی خواب نمی‌آورد، بلکه خواب‌آور خواب، تشنگی بی‌خرد است. به این معنا که فرد نادان، به دنبال لذت‌ها و خواب‌های بی‌اساس می‌رود و از نیازهای حقیقی خود غافل است."],[640,"خود خرد آنست کو از حق چرید","نه خرد کان را عطارد آورید","خود خرد واقعی، خردی است که از حقیقت و حق منحرف نشده باشد؛ نه آن خردی که با دانش ظاهری و دنیا فریفته شود و به چیزهای بی‌محتوا متمایل گردد."],[641,"پیش‌بینی این خرد تا گور بود","وآن صاحب دل به نفخ صور بود","عقل جزئی تنها می‌تواند تا مرگ را درک کند و نمی‌تواند فراتر از آن چیزی ببیند، اما کسی که دل روشن و پرهیزگار دارد، می‌تواند به مراحل بالاتر و اسرار آفرینش، مانند نفخ صور (دمیدن در صور در روز قیامت)، دست یابد."],[641,"این خرد از گور و خاکی نگذرد","وین قدم عرصه عجایب نسپرد","این خرد که به آن اشاره شده، تنها تا مرز بدن و مرگ انسان (گور) دید و درک دارد و نمی‌تواند به ماورای آن برود. در حالی که این گام یا حرکت روحانی و معنوی، به دنیای شگفتی‌های الهی و ماورایی مرتبط است و نمی‌تواند در کادر محدود عقل جزئی جای بگیرد."],[641,"زین قدم وین عقل رو بیزار شو","چشم غیبی جوی و برخوردار شو","از این مراحل و این خرد دوری کن و خود را از روش‌های محدود مادّی جدا کن. به دنبال بصیرت و دانش غیبی باش و از آن بهره‌مند شو."],[641,"هم‌چو موسی نور کی یابد ز جیب","سخره استاد و شاگردان کتیب","اشاره به یکی از معجزات حضرت موسی ید بیضا دارد"],[641,"زین نظر وین عقل ناید جز دوار","پس نظر بگذار و بگزین انتظار","از این منظر و با این عقل، فقط دایره‌ای محدود را می‌توان دید؛ بنابراین، دیدگاه خود را تغییر بده و صبر کن تا چیزهای بهتر و بزرگ‌تر را ببینی."],[641,"از سخن‌گویی مجویید ارتفاع","منتظر را به ز گفتن استماع","به جای جست‌وجو در سخن‌گویی و کلمات، به انتظار رسیدن به درجات بلندی از درک و فهم باشید، زیرا این نوع فهم تنها از طریق گوش سپردن به کلام و هدایت اولیای خدا حاصل می‌شود."],[641,"منصب تعلیم نوع شهوتست","هر خیال شهوتی در ره بتست","منصب تعلیم مربوط به انواع تمایلات و خواسته‌های نفسانی است و هر خیالی که به آن تمایلات مربوط می‌شود، به سمت بت (مظهر عشق و زیبایی) می‌رود. این بیت به جاذبه‌های شهوانی و تأثیر آن‌ها بر آموزش و یادگیری اشاره دارد."],[641,"گر بفضلش پی ببردی هر فضول","کی فرستادی خدا چندین رسول","اگر به فضل و رحمت خدا آگاه شوی، در می‌یابی که خداوند چندین پیامبر را فرستاده است تا انسان‌ها را هدایت کنند."],[641,"عقل جزوی هم‌چو برقست و درخش","در درخشی کی توان شد سوی وخش","عقل جزئی مانند برق و نور است که درخشش دارد، اما در این درخشندگی به دلیل محدودیتش نمی‌تواند به حقیقت و عمق وجود برسد."],[641,"نیست نور برق بهر رهبری","بلک امریست ابر را که می‌گری","نور برق صرفا برای رهبری و هدایت نیست؛ بلکه موضوعی است که مانند ابر می‌گرید، یعنی این روشنی مرتبط با احساسات و عواطف نیز هست."],[641,"برق عقل ما برای گریه است","تا بگرید نیستی در شوق هست","عقل محدود و جزئی ما تنها برای اندوه و گریه بر فقدان و عدم است، تا در آرزوی وجود و هستی بگرید."],[641,"عقل کودک گفت بر کتاب تن","لیک نتواند به خود آموختن","عقل کودک، مانند کتابی است که تنها می‌تواند از دیگران آموخته شود و قادر نیست به خود آموزش دهد."],[641,"عقل رنجور آردش سوی طبیب","لیک نبود در دوا عقلش مصیب","عقل بیمار آدمی را به سمت پزشک می‌برد، اما در دارو عقل او بهبودی نمی‌یابد."],[641,"نک شیاطین سوی گردون می‌شدند","گوش بر اسرار بالا می‌زدند","شیاطین به سوی آسمان می‌رفتند و به رازها و اسرار بلند گوش می‌دادند."],[641,"می‌ربودند اندکی زان رازها","تا شهب می‌راندشان زود از سما","شیاطین اندکی از رازهای آسمانی را می‌ربودند تا اینکه در پی آن، شهب (آتش) آنها را به سرعت به سمت آسمان می‌رانید."],[641,"که روید آنجا رسولی آمدست","هر چه می‌خواهید زو آید به دست","در آنجا پیامبری آمده است که هر چیزی را که بخواهید، از او به دست می‌آورید."],[641,"گر همی‌جویید در بی‌بها","ادخلوا الابیات من ابوابها","اگر به دنبال چیزهای باارزش هستید، باید از دروازه‌های خود آن‌ها وارد شوید."],[641,"می‌زن آن حلقه در و بر باب بیست","از سوی بام فلکتان راه نیست","در این بیت گفته شده که به دروازه آسمان (فلک) که در آنجا حلقه‌ای هست، دسترسی نیست و باید از دروازه‌ای دیگر وارد شد. به عبارتی دیگر، راهی برای رسیدن به این مقام و فهم عمیق‌تر وجود ندارد."],[641,"نیست حاجتتان بدین راه دراز","خاکیی را داده‌ایم اسرار راز","نیازی به این راه طولانی نیست، چرا که ما رازهای پنهان و دانشی ویژه را به شما داده‌ایم."],[641,"پیش او آیید اگر خاین نیید","نیشکر گردید ازو گرچه نیید","اگر به سوی او بروید و خیانت نکنید، به مانند نیشکر خواهید شد که از او شیرینی می‌گیرد، هرچند خود نیشکر نباشید."],[641,"سبزه رویاند ز خاکت آن دلیل","نیست کم از سم اسپ جبرئیل","سبزه‌ای که از خاک تو می‌روید، نشان‌دهنده نیکی و خوبی تو نیست و به اندازه سم اسپ جبرئیل (فرشته) ارزش ندارد. گفته شده که ظاهر خوب کافی نیست و باید عمق معنای آن را در نظر گرفت."],[641,"سبزه گردی تازه گردی در نوی","گر توخاک اسپ جبریلی شوی","اگر تو به خاک اسپ جبرئیل (که نماد الهام و فرشته‌گی است) تبدیل شوی، سبزینی و تازگی و شکوفایی به تو دست می‌دهد."],[641,"سبزه جان‌بخش که آن را سامری","کرد در گوساله تا شد گوهری","این بیت به سبزه‌ای اشاره دارد که سامری در داستان حضرت موسی از آن برای ساخت گوساله طلا استفاده کرد. این سبزه در واقع نماد زندگی و جان‌بخشی است و وقتی که در گوساله قرار گرفت، به آن ارزش و زیبایی خاصی بخشید."],[641,"جان گرفت و بانگ زد زان سبزه او","آنچنان بانگی که شد فتنه عدو","سبزه‌ای که سامری از آن گوساله‌ای ساخت، جان گرفت و شروع به صدای زدن کرد؛ صدایی که به اندازه‌ای قوی و تأثیرگذار بود که موجب آشفتگی و فتنه برای دشمنان شد."],[641,"گر امین آیید سوی اهل راز","وا رهید از سر کله مانند باز","اگر به اهل راز و حکمت اعتماد کنید و صادقانه به آن‌ها نزدیک شوید، از مشکلات و دشواری‌های ناشی از خودخواهی و سطحی‌نگری آزاد می‌شوید، مثل پرنده‌ای که از سر کله‌اش می‌گذرد و آزاد می‌شود."],[641,"سر کلاه چشم‌بند گوش‌بند","که ازو بازست مسکین و نژند","سر کلاه و چشم‌بند و گوش‌بند، مانع بینایی و شنیداری مسکینی است که از آنها رنج می‌برد و به نوعی در محدودیت قرار دارد."],[641,"زان کله مر چشم بازان را سدست","که همه میلش سوی جنس خودست","از آن سر که عقل جزوی و مادی است، چشم‌های بینا به سوی حقیقت و عمق وجود و جمال الهی راه نمی‌یابند، زیرا این عقل فقط به مطامع و خواسته‌های مادی خود گرایش دارد."],[641,"چون برید از جنس با شه گشت یار","بر گشاید چشم او را بازدار","زمانی که انسان از وابستگی به جنس و مادیات جدا شود، دیدش باز می‌شود و توانایی درک حقیقت‌ها و معانی عمیق‌تر را پیدا می‌کند."],[641,"راند دیوان را حق از مرصاد خویش","عقل جزوی را ز استبداد خویش","خداوند برخلاف عقل ناقص و محدود انسان، که به سبب خودخواهی و زورگویی به قضاوت نادرست می‌پردازد، دیوانگی را از خود دور می‌کند و این عقل جزوی را از سلطه و تسلط خود آزاد می‌سازد."],[641,"که سری کم کن نه‌ای تو مستبد","بلک شاگرد دلی و مستعد","تو از خودسری و استبداد دور شو و به جای آن، باید تواضع کنی و به یادگیری از دل‌ها و دلسوزان بپردازی، زیرا تو یک شاگرد هستی که استعداد کسب علم و معرفت را داری."],[641,"رو بر دل رو که تو جزو دلی","هین که بنده پادشاه عادلی","به دل توجه کن، زیرا تو جزئی از دل هستی. بیدار باش که تو بنده پادشاه عادلی هستی."],[641,"بندگی او به از سلطانیست","که انا خیر دم شیطانیست","بندگی خدا بهتر از سلطنتی است که در آن، شیطانی در پس آن وجود دارد."],[641,"فرق بین و برگزین تو ای حبیس","بندگی آدم از کبر بلیس","ای کسی که در بند هستی، تفاوت را بفهم و انتخاب کن؛ زیرا بندگی آدم به سبب کبر ابلیس (شیطان) نیست، بلکه به خاطر این است که آدم به بندگی خدا افتخار می‌کند و این برتری دارد."],[641,"گفت آنک هست خورشید ره او","حرف طوبی هر که ذلت نفسه","می‌گوید کسی که از خود در برابر خداوند خاشع و فروتن باشد، به حقیقت به خورشید راه او دست یافته است و به مقام طوبی (درخت بهشتی) نائل می‌شود."],[641,"سایه طوبی ببین وخوش بخسپ","سر بنه در سایه بی‌سرکش بخسپ","سایه درخت طوبی را ببین و در آن آرام بگیر، سر خود را در سایه‌ای که بدون سرکشی است، بنه."],[641,"ظل ذلت نفسه خوش مضجعیست","مستعد آن صفا و مهجعیست","سایه ذلت نفس، مکانی آرام و لذت‌بخش است که برای رسیدن به صفا و پاکی مناسب است."],[641,"گر ازین سایه روی سوی منی","زود طاغی گردی و ره گم کنی","اگر از این سایه (سایه‌ی ذلت و خضوع) خارج شوی و به سوی من (مولانا) بیایی، به سرعت دچار طغیان و سرکشی خواهی شد و مسیر خود را گم می‌کنی."],[642,"پس برو خاموش باش از انقیاد","زیر ظل امر شیخ و اوستاد","برو در سکوت به فرمان شیخ و استاد بمان و خود را زیر نظر آن‌ها قرار بده."],[642,"ورنه گرچه مستعد و قابلی","مسخ گردی تو ز لاف کاملی","اگرچه تو شرایط و قابلیت لازم برای پیشرفت را داری، اما اگر از دستورات استاد سرپیچی کنی، به انسانی زشت و نامتعادل تبدیل خواهی شد."],[642,"هم ز استعداد وا مانی اگر","سر کشی ز استاد راز و با خبر","اگرچه تو استعداد و توانایی داری، اما اگر بر ضد استاد خود برخیزی و کبر ورزی، در نهایت از این توانایی بی‌نصیب خواهی ماند."],[642,"صبر کن در موزه دوزی تو هنوز","ور بوی بی‌صبر گردی پاره‌دوز","در کار موزه‌دوزی (دوختن با پارچه) صبر کن و عجله نکن، زیرا اگر بی‌صبر و شتاب‌زده عمل کنی، کار تو خراب می‌شود و پاره خواهد شد."],[642,"کهنه‌دوزان گر بدیشان صبر و حلم","جمله نودوزان شدندی هم به علم","اگر این پیران (کهنه‌دوزان) patience و بردباری و علم را به نودوزان (جوان‌ترها) یاد دهند، همه آن‌ها هم با علم و دانش به آنگونه خواهند شد."],[642,"بس بکوشی و به آخر از کلال","هم تو گویی خویش کالعقل عقال","هرچقدر هم که تلاش کنی و در نهایت به بهانه‌ی تهدید تو از خودت پس بیفتی، باز هم در نهایت به مانند کسی خواهی شد که عقلش را به زنجیر بسته است و نمی‌تواند به درستی فکر کند."],[642,"هم‌چو آن مرد مفلسف روز مرگ","عقل را می‌دید بس بی‌بال و برگ","شخصی در روز مرگ خود، عقل را به‌گونه‌ای می‌دید که هیچ قدرت و توانایی نداشت و مانند یک انسان بی‌چاره و بی‌دارایی به نظر می‌آمد."],[642,"بی‌غرض می‌کرد آن دم اعتراف","کز ذکاوت راندیم اسپ از گزاف","بدون هیچ هدف و قصدی در آن لحظه اعتراف کرد که به دلیل هوش و زرنگی‌اش، اسپ را از نادانی دور کردیم."],[642,"از غروری سر کشیدیم از رجال","آشنا کردیم در بحر خیال","از روی غرور به مقام‌های خاص و آشنا شده‌ایم و در دنیای خیالی خود غرق شده‌ایم."],[642,"آشنا هیچست اندر بحر روح","نیست اینجا چاره جز کشتی نوح","دوستی و آشنایی در دل روح و معنویت هیچ ارزشی ندارد، در این موقعیت تنها راه نجات، همانند کشتی نوح، استفاده از وسیله‌ای مطمئن و صادق است."],[642,"این چنین فرمود این شاه رسل","که منم کشتی درین دریای کل","پیامبر (که به او شاه رسل گفته می‌شود) بیان کرده است که او مانند کشتی‌ای است در دریای بزرگ وجود، و کسانی که به او ایمان دارند باید به او پناه ببرند."],[642,"یا کسی کو در بصیرتهای من","شد خلیفه راستی بر جای من","هر کسی که در درک و فهم علم و بصیرت‌های من به مقام و جایگاهی رسیده، همچون جانشین من در راست‌گویی و حقیقت می‌شود."],[642,"کشتی نوحیم در دریا که تا","رو نگردانی ز کشتی ای فتی","اگر می‌خواهی نجات یابی و به مقصد برسی، نباید از کشتی نوح، که سمبل امن و امان است، دور شوی. در این دنیا مثل کشتی نوح به کشور و سرزمینی معنوی تعلق داری و باید به آن وفادار بمانی."],[642,"هم‌چو کنعان سوی هر کوهی مرو","از نبی لا عاصم الیوم شنو","همان‌طور که کنعان (پسر نوح) به سوی کوه‌ها نرفت، تو هم از پیامبر (نوح) بشنو که امروز هیچ‌کس نمی‌تواند تو را نجات دهد."],[642,"می‌نماید پست این کشتی ز بند","می‌نماید کوه فکرت بس بلند","کشتی به ظاهر در آب پایین‌تر از بند است و همین‌طور تصور می‌شود که کوه فکر و اندیشه خیلی بلند است. اما در واقع، در درون این کشتی، حقیقتی عمیق وجود دارد که ممکن است از نظر ظاهری پست به نظر برسد."],[642,"پست منگر هان و هان این پست را","بنگر آن فضل حق پیوست را","نگاه نکن به این چیز کم‌ارزش که در پایین قرار دارد، بلکه به فضلی که از حق به آن مربوط شده است توجه کن."],[642,"در علو کوه فکرت کم نگر","که یکی موجش کند زیر و زبر","به خیال و فکر خود به اندازه‌ای توجه نکن که تو را به تلاطم بکشاند؛ زیرا این فکر می‌تواند تو را پریشان کند و آرامش ذهنی‌ات را از بین ببرد."],[642,"گر تو کنعانی نداری باورم","گر دو صد چندین نصیحت پرورم","اگر تو مثل کنعان، یعنی انسان با ایمانی نیستی و به این سخن باور نداری، من هرچقدر هم که نصیحت و اندرز بدهم، فایده‌ای نخواهد داشت."],[642,"گوش کنعان کی پذیرد این کلام","که برو مهر خدایست و ختام","گوش کنعان، به عنوان نماد جامعه یا مردمی با افکار و باورهای خاص، نمی‌تواند این سخن را بپذیرد که باید عشق و محبت خداوند در نهایت برای او باشد و زندگی‌اش طبق این محبت شکل بگیرد."],[642,"کی گذارد موعظه بر مهر حق","کی بگرداند حدث حکم سبق","هیچ‌کس اجازه ندارد که بر اساس محبت و رضا به خداوند، نصیحت و موعظه کند و نمی‌تواند چیزی را بر اساس گذشته و حکم قبلی تغییر دهد."],[642,"لیک می‌گویم حدیث خوش‌پیی","بر امید آنک تو کنعان نه‌ای","اما من سخن خوشی می‌گویم که امیدوارم به یاد داشته باشی تو مانند کنعان نیستی، یعنی در موقعیتی ممتاز و خاص قرار نداری."],[642,"آخر این اقرار خواهی کرد هین","هم ز اول روز آخر را ببین","در نهایت، تو هم باید به این حقیقت اعتراف کنی که از ابتدا باید به پایان کار توجه داشته باشی و با دیدی عمیق‌تر به زندگی نگاه کنی."],[642,"می‌توانی دید آخر را مکن","چشم آخربینت را کور کهن","به آینده و پایان کارها توجه کن، اما نه به حدی که در آن غرق شوی و از همین حال حاضر غافل شوی؛ پس به تماشای آینده نپرداز و از آن گمراه نشو."],[642,"هر که آخربین بود مسعودوار","نبودش هر دم ز ره رفتن عثار","کسی که همیشه به عاقبت‌نگری مشغول است، مانند مسعود که اتفاقی خوش در مسیرش نیفتاده، دیگر نمی‌تواند به راحتی از راه رفتن لذت ببرد و به خاطر نگرانی‌هایش، مانع از پیشرفت خود می‌شود."],[642,"گر نخواهی هر دمی این خفت‌خیز","کن ز خاک پایی مردی چشم تیز","اگر نمی‌خواهی هر لحظه در خواب غفلت باقی بمانی، باید از خاک و فرودینی برخیز و مانند یک مرد با بصیرت و دیدی تیز، هوشیار و بیدار باش."],[642,"کحل دیده ساز خاک پاش را","تا بیندازی سر اوباش را","چشم‌های خود را مانند کحل (سرمه) وادار کن تا به زمین بیندازند سر اوباش (آدم‌های نادان و بی‌ادب) را."],[642,"که ازین شاگردی و زین افتقار","سوزنی باشی شوی تو ذوالفقار","از این امتداد یا حقیر شدن خود، به اندازه یک سوزن باش تا مانند ذوالفقار (شمشیر امام علی) قوی و تاثیرگذار شوی."],[642,"سرمه کن تو خاک هر بگزیده را","هم بسوزد هم بسازد دیده را","خاک هر کسی که انتخاب شده و والامقام است را سرمه (در اصطلاح، به معنای زیور یا زینت) کن؛ زیرا این خاک هم می‌تواند چشمان شخص را بسوزاند و هم آنها را بسازد و به بینایی برساند."],[642,"چشم اشتر زان بود بس نوربار","کو خورد از بهر نور چشم خار","چشم شتر به خاطر نوری که از چشم خار می‌گیرد، روشن و درخشان است. این بیان به این معناست که شتر از وجود زخم و خاری در نزدیکی‌اش، نوری می‌گیرد که موجب روشنی و بینایی‌اش می‌شود."],[643,"اشتری را دید روزی استری","چونک با او جمع شد در آخری","روزی استری، استری را دید که با او جمع شده و در کنار هم قرار گرفتند."],[643,"گفت من بسیار می‌افتم برو","در گریوه و راه و در بازار و کو","الاغ گفت: من بارها در مسیرهای مختلف مانند گودال‌ها، راه‌ها، بازار و کوه‌ها می‌افتم و زمین می‌خورم."],[643,"خاصه از بالای که تا زیر کوه","در سر آیم هر زمانی از شکوه","چرا همیشه وقتی که از بالای کوه پایین می‌آیم، از سختی و زحمات شکایت می‌کنم؟"],[643,"کم همی‌افتی تو در رو بهر چیست","یا مگر خود جان پاکت دولتیست","چرا تو در راه کمتر به زمین می‌افتی؟ یا شاید روح پاک تو برتری و مقام خاصی دارد که چنین است؟"],[643,"در سر آیم هر دم و زانو زنم","پوز و زانو زان خطا پر خون کنم","هر لحظه به خاطر اشتباهم به زمین می‌افتم و دردم را با زانو زدن نشان می‌دهم و از آن خطا، زانوانم را مجروح می‌کنم."],[643,"کژ شود پالان و رختم بر سرم","وز مکاری هر زمان زخمی خورم","پالان (پوشش بار) بر روی من نادرست و غیرمتوازن می‌شود و من در هر لحظه از فریب‌کاری و نیرنگ دیگران آسیب می‌بینم."],[643,"هم‌چو کم عقلی که از عقل تباه","بشکند توبه بهر دم در گناه","مانند فردی نادان که به خاطر بی‌عقلی‌اش، مرتکب گناه می‌شود و هر بار که توبه می‌کند، به راحتی آن را می‌شکند."],[643,"مسخره ابلیس گردد در زمن","از ضعیفی رای آن توبه‌شکن","کسی که مدام در گناه توبه می‌کند و سپس دوباره به گناه بازمی‌گردد، به وسیله ابلیس به سخره گرفته می‌شود و به خاطر ضعف اراده‌اش، در چشم دیگران به شخصی بی‌اراده و ضعیف تبدیل می‌شود."],[643,"در سر آید هر زمان چون اسپ لنگ","که بود بارش گران و راه سنگ","هر زمانی که بار سنگینی بر دوش دارد و راه پرسنگلاخی را طی می‌کند، همچون اسب لنگی که از ناتوانی می‌افتد، در شرایط سخت به زحمت می‌افتد."],[643,"می‌خورد از غیب بر سر زخم او","از شکست توبه آن ادبارخو","از عالم غیب، برای زخم او خورد می‌آید، به سبب اینکه از توبه‌اش شکست خورده و بدبختی به او روی آورده است."],[643,"باز توبه می‌کند با رای سست","دیو یک تف کرد و توبه‌ش را سکست","استر (حیوانی که به بارکشی و کار کردن معمولا در ایران استفاده می‌شود) دوباره با اراده ضعیفش توبه می‌کند، اما دیو (نماد بدی و شیطنت) تنها یک بار به او تف می‌کند و به راحتی توبه‌اش را می‌شکند."],[643,"ضعف اندر ضعف و کبرش آنچنان","که به خواری بنگرد در واصلان","این بیت به ضعف و ناتوانی انسان اشاره دارد که به خاطر کبر و خودبزرگ‌بینی‌اش، احساس خفت و حقارت در مقابل انسان‌های وارسته و روحانی را می‌کند. یعنی، آن‌قدر به خود مغرور است که ناتوانی‌اش را نمی‌بیند و در نتیجه به دیگران با تحقیر نگاه می‌کند."],[643,"ای شتر که تو مثال مؤمنی","کم فتی در رو و کم بینی زنی","ای شتر، تو مانند مؤمنی هستی که در زندگی کم‌تحرک و کم‌فکر است و به سختی حرکت می‌کنی."],[643,"تو چه داری که چنین بی‌آفتی","بی‌عثاری و کم اندر رو فتی","تو چه ویژگی‌ای داری که این‌قدر بدون دردسر و آسیب‌دیدگی و به آرامی در راه می‌روی؟"],[643,"گفت گرچه هر سعادت از خداست","در میان ما و تو بس فرقهاست","شتر می‌گوید که با وجود اینکه همه سعادت‌ها از جانب خداوند است، اما بین من و تو تفاوت‌های زیادی وجود دارد."],[643,"سر بلندم من دو چشم من بلند","بینش عالی امانست از گزند","چشم‌هایم باز و بینا است و سرم را بالا نگه‌داشته‌ام. این بینش عمیق و آگاهی موجب حفاظت و جلوگیری از آسیب‌دیدگی من است."],[643,"از سر که من ببینم پای کوه","هر گو و هموار را من توه توه","هر جا که من سر کوه را می‌بینم، آنجا را صاف و هموار می‌دانم، اما در واقعیت می‌دانم که تو (شتر) برای حرکت در این مسیر، دچار سختی و دشواری هستی."],[643,"هم‌چنانک دید آن صدر اجل","پیش کار خویش تا روز اجل","همان‌طور که آن «صدر اجل» (که به معنای مقام عالی یا عرش خداوند است) کار و تلاش خود را مشاهده می‌کند، تا زمان فرارسیدن مرگ، انسان نیز باید به کارهای خود ادامه دهد."],[643,"آنچ خواهد بود بعد بیست سال","داند اندر حال آن نیکو خصال","تنها کسی که دارای ویژگی‌های خوب و نیکو است، می‌داند که در بیست سال آینده چه بر او خواهد گذشت."],[643,"حال خود تنها ندید آن متقی","بلک حال مغربی و مشرقی","آن متقی (مرد پارسا) فقط حال خودش را نمی‌بیند، بلکه حال مردمان مغرب و مشرق (مردم غرب و شرق) را نیز در نظر می‌گیرد و به آزار و رنج آنها توجه می‌کند."],[643,"نور در چشم و دلش سازد سکن","بهر چه سازد پی حب الوطن","نور در چشم و دل او می‌تابد و هر چه که به خاطر عشق به وطن می‌سازد، برایش زیبا و دلپذیر است."],[643,"هم‌چو یوسف کو بدید اول به خواب","که سجودش کرد ماه و آفتاب","همان‌طور که یوسف در خواب دید که ماه و آفتاب برای او سجده کردند، این استر نیز در تلاش است تا در مسیر خود به هدفش برسد، به طوری که در اینجا به عظمت و مقام یوسف اشاره می‌شود."],[643,"از پس ده سال بلک بیشتر","آنچ یوسف دیده بد بر کرد سر","یوسف در این بیت پس از ده سال یا حتی بیشتر، به یاد تجربیاتش می‌افتد و از آنچه بر او گذشته، سر برمی‌دارد. این اشاره به دوران سختی‌ها و چالش‌هایی دارد که او از سر گذرانده است."],[643,"نیست آن ینظر به نور الله گزاف","نور ربانی بود گردون شکاف","نیست در این دنیا نگریستن به نور خداوند به صورت تصادفی و بی‌هدف، بلکه نور ربانی که در آن وجود دارد، به واسطه‌ی شکاف‌های آسمان و به کمک الهام الهی تابیده می‌شود."],[643,"نیست اندر چشم تو آن نور رو","هستی اندر حس حیوانی گرو","در چشمان تو آن نور الهی وجود ندارد و تو گرفتار حس حیوانی هستی."],[643,"تو ز ضعف چشم بینی پیش پا","تو ضعیف و هم ضعیفت پیشوا","تو به خاطر ضعف دید، فقط می‌توانی آنچه در جلوی پاهایت است ببینی، پس خودت و پیشوایت (راهنما) هر دو ضعیف هستید."],[643,"پیشوا چشمست دست و پای را","کو ببیند جای را ناجای را","پیشوای راه، مانند چشم است که می‌تواند راه‌ها و مسیرها را ببیند، در حالی که پاها و دست‌ها نمی‌توانند جای درست و نادرست را تشخیص دهند."],[643,"دیگر آنک چشم من روشن‌ترست","دیگر آنک خلقت من اطهرست","چشم من روشن‌تر و پاک‌تر از توست، زیرا من از نطفه‌ای حلال و پاک متولد شده‌ام."],[643,"زانک هستم من ز اولاد حلال","نه ز اولاد زنا و اهل ضلال","من از نسل حلال و قانونی هستم، نه از نسل نامشروع و گمراهان."],[643,"تو ز اولاد زنایی بی‌گمان","تیر کژ پرد چو بد باشد کمان","تو به یقین از فرزندان نامشروع هستی، زیرا علمت و رفتار تو مانند تیر کجی است که وقتی کمانی بد داشته باشد، به هدف نمی‌رسد."],[644,"گفت استر راست گفتی ای شتر","این بگفت و چشم کرد از اشک پر","استر (که در اینجا به معنی شتر است) به شتر می‌گوید که سخن راست و درستی گفتی و در حالی که این را می‌گوید، چشمانش از اشک پر شده است."],[644,"ساعتی بگریست و در پایش فتاد","گفت ای بگزیده رب العباد","شتر مدتی گریه کرد و به پای استر افتاد و گفت: ای موجودی که پروردگار انتخاب کرده است، من به تو نیاز دارم."],[644,"چه زیان دارد گر از فرخندگی","در پذیری تو مرا دربندگی","چه اشکالی دارد اگر در خوشی و سعادت خود، من را به عنوان بنده و خدمتگزار قبول کنی؟"],[644,"گفت چون اقرار کردی پیش من","رو که رستی تو ز آفات زمن","اگر تو به من اقرار کنی که از آسیب‌های من نجات یافته‌ای، نشان‌دهنده این است که توانسته‌ای از مشکلات رها شوی."],[644,"دادی انصاف و رهیدی از بلا","تو عدو بودی شدی ز اهل ولا","تو انصاف دادی و از بلا و گرفتاری رهایی یافتی، در حالی که قبلا دشمن بودی اما اکنون به اهل محبت و وفاداری پیوسته‌ای."],[644,"خوی بد در ذات تو اصلی نبود","کز بد اصلی نیاید جز جحود","بدی‌هایی که در وجود تو هست، از ذات تو سرچشمه نمی‌گیرد، زیرا از ذات بد چیزی جز انکار و کفر زاده نمی‌شود."],[644,"آن بد عاریتی باشد که او","آرد اقرار و شود او توبه‌جو","بدی که در وجود آدمی وجود دارد، در حقیقت به او تعلق ندارد و فقط به‌صورت عارضی است. هنگامی که انسان به این بدی اعتراف کند و از آن توبه نماید، خود را از آن ویژگی منفی رها می‌کند."],[644,"هم‌چو آدم زلتش عاریه بود","لاجرم اندر زمان توبه نمود","خطای آدم (علیه‌السلام) نیز یک عاریه بود، بنا بر این او در زمان توبه، گناه خود را جبران کرد."],[644,"چونک اصلی بود جرم آن بلیس","ره نبودش جانب توبه نفیس","چون جرم اساسی شیطان (بلیس) وجود داشت، بنابراین نتوانست به توبه‌ای ارزشمند و حقیقی دست پیدا کند."],[644,"رو که رستی از خود و از خوی بد","واز زبانه نار و از دندان دد","به خودت و خصال ناپسندت غلبه کردی و از ناراحتی‌ها و آزارهایی که به دیگران می‌زنی، رهایی یافته‌ای."],[644,"رو که اکنون دست در دولت زدی","در فکندی خود به بخت سرمدی","حالا که به کمک دولت و نعمت‌ها دست یازیده‌ای، خود را به سرنوشت جاودانه و خوشبختی سپرده‌ای."],[644,"ادخلی تو فی عبادی یافتی","ادخلی فی جنتی در بافتی","به جمع بندگانی که در کار و اطاعت من هستند وارد شو که تو در بهشت من جایی یافتی و در جمع بندگان من بافته شدی."],[644,"در عبادش راه کردی خویش را","رفتی اندر خلد از راه خفا","به این معنی است که راهی به سوی بندگان خدا پیدا کردی و با پنهان‌کاری و بدون رو دربایستی، به بهشت (خلد) وارد شدی."],[644,"اهدنا گفتی صراط مستقیم","دست تو بگرفت و بردت تا نعیم","تو درخواست هدایت کردی و گفتی «ما را به صراط مستقیم راهنمایی کن»، او (خدا) دست تو را گرفت و به نعمت‌های بهشتی برد."],[644,"نار بودی نور گشتی ای عزیز","غوره بودی گشتی انگور و مویز","تو در ابتدا مانند آتش بودی، اما حالا به نور تبدیل شده‌ای، و مانند میوه ترش «غوره» که به «انگور» و سپس «مویز» تبدیل می‌شود، رشد و ترقی کرده‌ای."],[644,"اختری بودی شدی تو آفتاب","شاد باش الله اعلم بالصواب","تو در ابتدا مانند یک ستاره بودی، اما اکنون به آفتاب درخشان تبدیل شده‌ای. شاد باش و بدان که خدا بهتر از هر کسی بر حقیقت مسلط است."],[644,"ای ضیاء الحق حسام‌الدین بگیر","شهد خویش اندر فکن در حوض شیر","ای حسام‌الدین که نور حقیقتی، نیکوست که شهد خود را در حوض شیر بریزی. منظور این است که تو می‌توانی خواص و خوبی‌های خود را در هر جایی به اشتراک بگذاری و به دیگران بهره برسانی."],[644,"تا رهد آن شیر از تغییر طعم","یابد از بحر مزه تکثیر طعم","تا زمانی که آن شیر از تغییر طعم نجات پیدا کند، باید از دریا و منبعی که طعم‌های مختلف وجود دارد، استفاده کند."],[644,"متصل گردد بدان بحر الست","چونک شد دریا ز هر تغییر رست","چون دریا از هر تغییر رهایی یافت، به آن بحر الست (عالم عقد و پیمان) متصل می‌شود. این اشاره به بازگشت به اصل و حقیقت دارد، جایی که تمام تغییرات و دگرگونی‌ها از میان می‌رود."],[644,"منفذی یابد در آن بحر عسل","آفتی را نبود اندر وی عمل","در آن دریای وجود، منفذی برای ورود به خوشی و شیرینی وجود دارد و هیچ آسیبی یا زحمتی نمی‌تواند در آنجا وجود داشته باشد."],[644,"غره‌ای کن شیروار ای شیر حق","تا رود آن غره بر هفتم طبق","ای شیر حق، با شجاعت و اعتماد به نفس خود را به جلو بران، تا آن غرور و خودبزرگ‌بینی به مرتبه‌ی بالاتر و برتر برود."],[644,"چه خبر جان ملول سیر را","کی شناسد موش غره شیر را","هیچ‌کس خبر جان خسته و ناامید سیر را نمی‌داند، همان‌طور که موش نمی‌تواند غرور و شکوه شیر را بشناسد."],[644,"برنویس احوال خود با آب زر","بهر هر دریادلی نیکوگهر","برای هر انسان با دل و فهم نیکو، احوال خود را با آب زر (طلای مایع) بنویس و به زیبایی و ارزش آن بیفزایید."],[644,"آب نیلست این حدیث جان‌فزا","یا ربش در چشم قبطی خون نما","این سخن درباره نیل، یعنی رود نیل است که خاصیت شفا بخشی و جان‌افزایی دارد. خداوندا، آیا این معجزه در نظر قبطی (مصر باستانی) به‌قدری واضح و آشکار است که از آن خون جاری می‌شود؟"],[645,"من شنیدم که در آمد قبطیی","از عطش اندر وثاق سبطیی","من شنیدم که یک قبطی (اقوام مصری) به خاطر تشنگی به نزد سبطی (نسل یهودی) آمده است و به شدت تشنه است."],[645,"گفت هستم یار و خویشاوند تو","گشته‌ام امروز حاجتمند تو","قبطی می‌گوید که من تو را دوست و نزدیک خود می‌دانم و امروز برای برآورده شدن نیازم به تو مراجعه کرده‌ام."],[645,"زانک موسی جادوی کرد و فسون","تا که آب نیل ما را کرد خون","موسی با جادوی خود و فریب دادن، باعث شد که آب نیل، که برای ما قبطیان مقدس و سالم بود، به خون تبدیل شود."],[645,"سبطیان زو آب صافی می‌خورند","پیش قبطی خون شد آب از چشم‌بند","سبطیان، که نسل حضرت یعقوب (علیه‌السلام) هستند، از آب زلال و پاک نیل می‌نوشند، اما قبطی‌ها (مصراندیشان) به خاطر غفلت و ناآگاهی، آبشان به خون تبدیل شده است."],[645,"قبط اینک می‌مرند از تشنگی","از پی ادبار خود یا بدرگی","قبطی‌ها الآن از تشنگی می‌میرند، یا به خاطر بدشانسی و یا به خاطر گناهکاری‌های خودشان."],[645,"بهر خود یک طاس را پر آب کن","تا خورد از آبت این یار کهن","برای خودت یک کاسه آب پر کن تا این دوست قدیمی‌ات از آب تو بنوشد."],[645,"چون برای خود کنی آن طاس پر","خون نباشد آب باشد پاک و حر","هرگاه تو برای خود آن ظرف (طاس) را پر از خون کردی، دیگر آب نخواهد بود، بلکه پاک و حر (سالم و شفاف) نخواهد ماند."],[645,"من طفیل تو بنوشم آب هم","که طفیلی در تبع بجهد ز غم","من به خاطر محبت و دوستی تو از آب می‌نوشم، حتی اگر لمسم به تو هم وابسته باشد و از غصه و اندوه دور شوم."],[645,"گفت ای جان و جهان خدمت کنم","پاس دارم ای دو چشم روشنم","گفت: ای جان و جهان، من به تو خدمت می‌کنم و تو را پاس می‌دارم، ای دو چشم روشنی که روشنی بخش زندگی‌ام هستی."],[645,"بر مراد تو روم شادی کنم","بنده تو باشم آزادی کنم","من به خواسته تو می‌روم و شادی می‌کنم و می‌خواهم که بنده تو باشم تا از قید و بندهای خود رها شوم."],[645,"طاس را از نیل او پر آب کرد","بر دهان بنهاد و نیمی را بخورد","قربانی در اینجا از نیل آب را در طاس (ظرف) ریخت و آن را به دهانش برد و نیمی از آن را نوشید."],[645,"طاس را کژ کرد سوی آب‌خواه","که بخور تو هم شد آن خون سیاه","در اینجا، فردی (احتمالا قبطی) طاس (ظرف) را به‌طرزی نادرست و غیرمستقیم به سوی آب می‌برد و به دیگری می‌گوید که او نیز باید از آن آب بخورد، حال آنکه در واقع آن آب، خون سیاه است و او را فریب می‌دهد."],[645,"باز ازین سو کرد کژ خون آب شد","قبطی اندر خشم و اندر تاب شد","قبطی (مرد قبطی) از شدت خشم و دلهره، به این سو و آن سو می‌چرخید و خون او به آب تبدیل شد، یعنی احساسش به شدت متلاطم و نگران است."],[645,"ساعتی بنشست تا خشمش برفت","بعد از آن گفتش کای صمصام زفت","مدتی صبر کرد تا خشمش فروکش کرد، سپس به صمصام زفت (یعنی انسان قوی و با اراده) گفت."],[645,"ای برادر این گره را چاره چیست","گفت این را او خورد کو متقیست","برادر، راه حلی برای این مشکل چیست؟ گفت: تنها کسی که پرهیزگار است می‌تواند آن را حل کند."],[645,"متقی آنست کو بیزار شد","از ره فرعون و موسی‌وار شد","انسان متقی کسی است که از مسیر فرعون (نماد ظلم و فساد) دوری می‌کند و مانند حضرت موسی (نماد هدایت و آزادی) می‌شود."],[645,"قوم موسی شو بخور این آب را","صلح کن با مه ببین مهتاب را","این بیت به دعوت به صلح و آشتی اشاره دارد. شاعر از شنونده می‌خواهد که مانند قوم موسی، آب زندگی را بنوشد و با مه (نماد محبت و زیبایی) آشتی کند و به نور و روشنی (مهتاب) توجه کند."],[645,"صدهزاران ظلمتست از خشم تو","بر عبادالله اندر چشم تو","خشم تو بر بندگان خدا مانند ظلمت‌های بسیار در چشمانت دیده می‌شود و باعث تاریکی آن‌ها می‌شود."],[645,"خشم بنشان چشم بگشا شاد شو","عبرت از یاران بگیر استاد شو","خشم خود را کنار بگذار، آرامش پیدا کن و چشم‌هایت را باز کن تا شاد شوئی. از تجربه‌ی یاران و دوستانت درس بگیر و به عنوان یک استاد عمل کن."],[645,"کی طفیل من شوی در اغتراف","چون ترا کفریست هم‌چون کوه قاف","چرا باید در اقرار به من به عنوان طرفدار تو باشی، در حالی که تو به مثل کوه قاف کافر هستی؟"],[645,"کوه در سوراخ سوزن کی رود","جز مگر کآن رشته یکتا شود","کوه نمی‌تواند از سوراخ سوزن عبور کند، مگر اینکه رشته‌ای واحد و واحد از آن عبور کند."],[645,"کوه را که کن به استغفار و خوش","جام مغفوران بگیر و خوش بکش","کوه را با استغفار و طلب بخشش در نظر بگیر و در کنار مغفوران (بخشیده‌شدگان) خوش بگذران و از مزایای آنها بهره‌مند شو."],[645,"تو بدین تزویر چون نوشی از آن","چون حرامش کرد حق بر کافران","تو با این نیرنگ و تزویر خود، وقتی از آن می‌نوشی، بدان که چون خدا حق را بر کافران حرام کرده است، نوشیدن آن برای تو نیز حرام است."],[645,"خالق تزویر تزویر ترا","کی خرد ای مفتری مفترا","خالق تزویر (نیرنگ و فریب) تو را نیز تزویر می‌سازد، پس چگونه می‌خواهی چیزی را که خود بر آن افترا می‌زنی (دروغ می‌گویی) به عقل و خرد خود نسبت دهی؟"],[645,"آل موسی شو که حیلت سود نیست","حیله‌ات باد تهی پیمودنیست","به فرزندان موسی بپیوند که فریب و نیرنگ فایده‌ای ندارد، زیرا نیرنگ تو همچون باد بی‌خاصیت و تهی است و به جایی نمی‌رسد."],[645,"زهره دارد آب کز امر صمد","گردد او با کافران آبی کند","آبی که از عرش خداوند یعنی صمد باشد، ابزاری برای کافران خواهد شد و آنها با این آب به وجود نمی‌آیند. این اشاره به این است که خداوند برای مؤمنان، قدرت و زندگی را فراهم می‌کند، حال آنکه کافران از آن بی‌بهره‌اند."],[645,"یا تو پنداری که تو نان می‌خوری","زهر مار و کاهش جان می‌خوری","آیا تو فکر می‌کنی که با خوردن نان، غذای خوب می‌خوری، در حالی که در واقع زهر مار را می‌خوری و جانت را کم می‌کنی؟"],[645,"نان کجا اصلاح آن جانی کند","کو دل از فرمان جانان بر کند","نان کجا می‌تواند جان را اصلاح کند، در حالی که دل از دستورات و پیروزی‌های معشوق (جانان) جدا شده است؟"],[645,"یا تو پنداری که حرف مثنوی","چون بخوانی رایگانش بشنوی","آیا فکر می‌کنی که با خواندن مثنوی می‌توانی به راحتی و بدون زحمت معنای آن را درک کنی؟"],[645,"یا کلام حکمت و سر نهان","اندر آید زغبه در گوش و دهان","حکمت و اسرار عمیق به راحتی از طریق کلمات متعارف به گوش‌ها و دهان‌ها نمی‌آید، بلکه نیاز به توجه و درک عمیق‌تری دارد."],[645,"اندر آید لیک چون افسانه‌ها","پوست بنماید نه مغز دانه‌ها","معنی این بیت این است که اطلاعات و داستان‌ها ممکن است به ظاهر جذاب و قابل دیدن باشند، اما در واقعیت، آنچه که درون آنها است، مثل مغز دانه‌ها، پشت پرده‌ای پنهان مانده و نهان است. فقط ظاهر مطلب قابل مشاهده است و جوهر و حقیقت آن، مانند مغز دانه‌ها، درونش باقی مانده است."],[645,"در سر و رو در کشیده چادری","رو نهان کرده ز چشمت دلبری","دختری زیبا و دل‌ربا که چادری بر سر و صورتش کشیده است، به طوری که زیبایی‌اش از دید چشمانت پنهان مانده است."],[645,"شاه‌نامه یا کلیله پیش تو","هم‌چنان باشد که قرآن از عتو","کتاب شاهنامه یا کلیله و دمنه برای تو از نظر اهمیت و ارزش، همانند قرآن کریم در ابهت و عظمت است."],[645,"فرق آنگه باشد از حق و مجاز","که کند کحل عنایت چشم باز","تفاوت حق و مجاز (واقعیت و خیال) زمانی مشخص می‌شود که نعمت و لطف الهی، چشمی بصیرت‌دهنده به انسان عطا کند."],[645,"ورنه پشک و مشک پیش اخشمی","هر دو یکسانست چون نبود شمی","اگر به دو چیز مختلف مانند پشک (بوی نا) و مشک (عطر خوش) نگاه شود، هر دو در نزد کسی که آن‌ها را نمی‌شناسد، یکسان به نظر می‌رسند؛ زیرا به سبب عدم شناخت، تفاوت‌ها دیده نمی‌شود."],[645,"خویشتن مشغول کردن از ملال","باشدش قصد از کلام ذوالجلال","مشغول کردن خود به امور دنیوی، از ناراحتی و غم ناشی می‌شود و هدف از سخن خداوند که ذوالجلال است، آرامش و رهایی از این ملال است."],[645,"کاتش وسواس را و غصه را","زان سخن بنشاند و سازد دوا","این سخن می‌تواند دل را از وسواس و غم آرام کند و برای درمان این دردها دارویی بسازد."],[645,"بهر این مقدار آتش شاندن","آب پاک و بول یکسان شد به فن","برای خاموش کردن آتش وسواس و اضطراب، آب پاک و بول (ادرار) هیچ تفاوتی ندارند و هر دو با یک روش این کار را انجام می‌دهند."],[645,"آتش وسواس را این بول و آب","هر دو بنشانند هم‌چون وقت خواب","آتش وسواس و نگرانی را هم بول و هم آب می‌توانند خاموش کنند، همان‌طور که در زمان خواب، اضطراب‌ها و افکار آشفته کاهش می‌یابند."],[645,"لیک گر واقف شوی زین آب پاک","که کلام ایزدست و روحناک","اگر از این آب پاک که سخن خداوند و روحی بخش است آگاه شوی، در واقع به حقیقتی بزرگ پی برده‌ای."],[645,"نیست گردد وسوسه کلی ز جان","دل بیابد ره به سوی گلستان","وسوسه‌های کلی یا فکرهای بی‌اساس از دل زائل می‌شوند و جان آدمی به سمت گلستان، یعنی به سوی حقیقت و زیبایی واقعی راه پیدا می‌کند."],[645,"زانک در باغی و در جویی پرد","هر که از سر صحف بویی برد","هر کس که از سر ورق‌ها و کتاب‌ها بویی بگیرد، در باغ و جوی چیزهایی را خواهد یافت. به عبارت دیگر، دانش و آگاهی به او امکان می‌دهد تا در دنیاهای زیبا و مختلف به تجربه بپردازد."],[645,"یا تو پنداری که روی اولیا","آنچنان که هست می‌بینیم ما","آیا تو فکر می‌کنی ما چهره واقعی و حقیقی اولیا (خداوندی) را آن‌گونه که هست می‌بینیم؟"],[645,"در تعجب مانده پیغامبر از آن","چون نمی‌بینند رویم مؤمنان","پیامبر در شگفتی است که چرا مؤمنان نمی‌توانند چهره او را ببینند."],[645,"چون نمی‌بینند نور روم خلق","که سبق بردست بر خورشید شرق","مردم نمی‌توانند نور چهره من را ببینند، زیرا من در مقام و مرتبه‌ای بالاتر از خورشید شرقی قرار دارم."],[645,"ور همی‌بینند این حیرت چراست","تا که وحی آمد که آن رو در خفاست","اگر مردم این حیرت و شگفتی را می‌بینند، به این دلیل است که وحی الهی به آنها رسیده که آن حقیقت در خفا و پنهانی است."],[645,"سوی تو ماهست و سوی خلق ابر","تا نبیند رایگان روی تو گبر","به سوی تو، به خاطر محبت و نزدیکی به تو، نور و روشنایی است، و به سوی دیگران، فقط مانع و ابر وجود دارد که باعث می‌شود آنها نتوانند جمال و زیبایی تو را ببینند. گبر به معنای کسی است که از دین اسلام خارج است، اشاره به کسانی است که از حقیقت و زیبایی‌های معنوی دورند."],[645,"سوی تو دانه‌ست و سوی خلق دام","تا ننوشد زین شراب خاص عام","به سوی تو، مخصوصا چیزهای باارزش وجود دارد، ولی دیگران فقط به دنبال نعمت‌های مادی و ظاهری هستند. هدف از این جمله این است که درک عمیق از رابطه‌ها و عشق حقیقی فراتر از نیازهای دنیوی است."],[645,"گفت یزدان که تراهم ینظرون","نقش حمامند هم لا یبصرون","خداوند فرمود که آنها (افراد موجه یا متقی) به تو می‌نگرند، ولی مانند نقش بر دیوار حمامند و هیچ نمی‌بینند."],[645,"می‌نماید صورت ای صورت‌پرست","که آن دو چشم مرده او ناظرست","ظاهرش را نشان می‌دهد ای کسی که به صورت و زیبایی علاقه‌مندی، اما آن دو چشم مرده او فقط ناظر و تماشاچی‌اند و هیچ بینش یا حقیقتی در آن‌ها نیست."],[645,"پیش چشم نقش می‌آری ادب","کو چرا پاسم نمی‌دارد عجب","چرا این نقش زیبایی که به چشم می‌آوری، ادب و احترام را رعایت نمی‌کند و جواب سلامم را نمی‌دهد؟"],[645,"از چه پس بی‌پاسخست این نقش نیک","که نمی‌گوید سلامم را علیک","چرا این نقش زیبا و دل‌نشین پاسخ سلام من را نمی‌دهد؟"],[645,"می‌نجنباند سر و سبلت ز جود","پاس آنک کردمش من صد سجود","خداوند سر و صورت خود را از نعمت و بخشش نمی‌جنباند، زیرا من به خاطر آن‌که از او به درگاهش سجده کرده‌ام، صد سجده کرده‌ام و او را به خوبی احترام کرده‌ام."],[645,"حق اگر چه سر نجنباند برون","پاس آن ذوقی دهد در اندرون","هرچند حق (خدا) در ظاهر بر ما ظاهر نمی‌شود و نشانه‌ای نمی‌دهد، ولی در باطن و در دل، لذتی عمیق و طعم زیبایی را به ما می‌بخشد."],[645,"که دو صد جنبیدن سر ارزد آن","سر چنین جنباند آخر عقل و جان","دوصد بار سر حرکت کردن برای این سر که چنین حرکتی می‌کند، ارزش دارد؛ زیرا در نهایت، عقل و جان از این حرکات بهره‌مند می‌شوند."],[645,"عقل را خدمت کنی در اجتهاد","پاس عقل آنست که افزاید رشاد","کسی که به عقل خود خدمت کند و در تلاش برای فهم و اجتهاد باشد، باید بداند که هدف از این تلاش افزایش هوش و بصیرت اوست."],[645,"حق نجنباند به ظاهر سر ترا","لیک سازد بر سران سرور ترا","حق بر حسب ظاهر، سر تو را حرکت نمی‌دهد، اما در باطن، عزت و بزرگی تو را بوجود می‌آورد و برتری می‌بخشد."],[645,"مر ترا چیزی دهد یزدان نهان","که سجود تو کنند اهل جهان","خداوند چیزی به تو عطا می‌کند که سبب می‌شود مردم دنیا به تو احترام بگذارند و به تو سجده کنند."],[645,"آنچنان که داد سنگی را هنر","تا عزیز خلق شد یعنی که زر","سنگی به خاطر هنری که دارد، به اندازه طلا عزیز و گران‌بها می‌شود. این بیت نشان می‌دهد که ارزش افراد به هنر و ویژگی‌های درونی‌شان بستگی دارد، نه به ظاهر آن‌ها."],[645,"قطره آبی بیابد لطف حق","گوهری گردد برد از زر سبق","قطره آبی که از لطف خدا به دست می‌آید، به مانند گوهری می‌شود که از زر بهتر است."],[645,"جسم خاکست و چو حق تابیش داد","در جهان‌گیری چو مه شد اوستاد","جسم انسان از خاک ساخته شده است، اما وقتی که حق به او نور (تابش) می‌دهد، در جهان مانند ماه (که نورانی و برجسته است) می‌شود و مقام والا و رهبری پیدا می‌کند."],[645,"هین طلسمست این و نقش مرده است","احمقان را چشمش از ره برده است","این وضعیت یا معجزه‌ای که می‌بینید، نوعی طلسم است و تصویرهایی که مشاهده می‌شود، واقعی نیستند. انسان‌های نادان به‌وسیله این ظواهر فریب‌ خورده و حقیقت را نمی‌بینند."],[645,"می‌نماید او که چشمی می‌زند","ابلهان سازیده‌اند او را سند","او (مولانا) می‌گوید که ابلهان برای تأیید کارهای ناپسند خود چشمی می‌دوزند به او، گویی که او مدرکی برای رفتارهایشان شده است."],[646,"گفت قبطی تو دعایی کن که من","از سیاهی دل ندارم آن دهن","قبطی (مرد اهل مصر) از سبطی (نوه یا فرزند پیامبر) می‌خواهد که دعایی کند، زیرا او از تاریکی و کدورت دلش رنج می‌برد و نمی‌خواهد آن حالت را در خود داشته باشد."],[646,"که بود که قفل این دل وا شود","زشت را در بزم خوبان جا شود","کسی که قفل دل را باز کند، می‌تواند زشتی را در جمع زیبایان بپذیرد و جایی برای آن بوجود آورد."],[646,"مسخی از تو صاحب خوبی شود","یا بلیسی باز کروبی شود","شخصی که به او ایمان و خوبی عطا شود، به انسان نیک‌خویی تبدیل می‌شود، یا اینکه اگر دور از خیر و خوبی باشد، مانند موجودی شرور خواهد شد که از مقامات عالی محروم است."],[646,"یا بفر دست مریم بوی مشک","یابد و تری و میوه شاخ خشک","از جانب مریم، دستش بوی مشک و خوشبوئی داشته باشد و همچنان رطوبت و میوه از شاخه خشک بیرون بیاید. این تصویر بیانگر معجزه و کرامت است که در دستان مریم ممکن است نمایان شود."],[646,"سبطی آن دم در سجود افتاد و گفت","کای خدای عالم جهر و نهفت","سبطی، در آن لحظه به سجده افتاد و با صدای بلند دعا کرد: ای خدای جهانیان، چه آشکار و چه پنهان."],[646,"جز تو پیش کی بر آرد بنده دست","هم دعا و هم اجابت از توست","هیچ کس غیر از تو نیست که بنده را نیازمند به دعا و درخواست کند، چرا که هم خود دعا از توست و هم اجابت آن."],[646,"هم ز اول تو دهی میل دعا","تو دهی آخر دعاها را جزا","تو از ابتدا به افراد میل دعا می‌دهی و در انتها نیز پاداش دعاها را خودت می‌دهی."],[646,"اول و آخر توی ما در میان","هیچ هیچی که نیاید در بیان","خداوند از ابتدا و انتها در وجود ماست و هیچ چیز نمی‌تواند او را توصیف کند یا به بیان درآورد."],[646,"این چنین می‌گفت تا افتاد طشت","از سر بام و دلش بیهوش گشت","او (قبطی) این‌گونه سخن می‌گفت که ناگهان طشت (ظرف بزرگ) از بالای بام افتاد و باعث شد که دلش بی‌هوش شود."],[646,"باز آمد او به هوش اندر دعا","لیس للانسان الا ما سعی","او بعد از به‌هوش آمدن، همچنان در حال دعا بود و می‌گوید برای انسان جز آنچه که تلاش کرده است نصیبش نخواهد شد."],[646,"در دعا بود او که ناگه نعره‌ای","از دل قبطی بجست و غره‌ای","سبطی در حال دعا بود که ناگهان صدای ناله‌ای از دل قبطی (مردی از قبط، یک قوم در مصر) برخاست و او را متوجه خود کرد."],[646,"که هلا بشتاب و ایمان عرضه کن","تا ببرم زود زنار کهن","به سرعت بیا و ایمان خود را ابراز کن تا من به زودی زنار کهن (عناصر نجات) را ببرم."],[646,"آتشی در جان من انداختند","مر بلیسی را به جان بنواختند","آتش عشق و شوقی در وجود من شعله‌ور کرده‌اند، به طوری که عاملی مانند ابلیس هم مرا به سمت خود جذب کرده است."],[646,"دوستی تو و از تو ناشکفت","حمدلله عاقبت دستم گرفت","عاقبت دوستی و عشق تو، که از آن ناشناخته بودم، باعث شد که دست من را بگیری و نجاتم دهی."],[646,"کیمیایی بود صحبتهای تو","کم مباد از خانه دل پای تو","صحبت‌های تو گنجی از طلا است، پس هرگز کم نشود و از دل من دور نرود."],[646,"تو یکی شاخی بدی از نخل خلد","چون گرفتم او مرا تا خلد برد","تو به مانند شاخه‌ای از نخل بهشت بودی که وقتی تو را گرفتم، مرا نیز به بهشت بردی."],[646,"سیل بود آنک تنم را در ربود","برد سیلم تا لب دریای جود","سیل بود که تنم را در خود گرفت و به سمت لب دریای سخاوت برد."],[646,"من به بوی آب رفتم سوی سیل","بحر دیدم در گرفتم کیل کیل","با بوی آب به سوی سیل رفتم و در دریا نشانه‌هایی از آن را مشاهده کردم و از شدت خوشحالی و شور دست و پا می‌زنم."],[646,"طاس آوردش که اکنون آب‌گیر","گفت رو شد آبها پیشم حقیر","قبطی ظرفی برای جمع‌آوری آب آورد و گفت حالا که آب آمده، احساس کن که حالا آب‌ها در برابر من کوچک و ناچیز هستند."],[646,"شربتی خوردم ز الله اشتری","تا به محشر تشنگی ناید مرا","من از خداوند نوشیدم شربتی که در روز قیامت به شدت تشنگی در من احساس نشود."],[646,"آنک جوی و چشمه‌ها را آب داد","چشمه‌ای در اندرون من گشاد","این بیت به این معنی است که کسی که چشمه‌ها و جوی‌ها را سیراب می‌کند، در دل من نیز چشمه‌ای از شعف و شادی گشوده است."],[646,"این جگر که بود گرم و آب‌خوار","گشت پیش همت او آب خوار","این جگر که قبلا پرحرارت و دلسوز بود، اکنون به خاطر تلاش و همت او، تشنه و نیازمند به آب شده است."],[646,"کاف کافی آمد او بهر عباد","صدق وعده کهیعص","خداوند به خاطر بندگان خود، نعمت‌های زیادی را نازل کرده و هرگز در وعده‌هایش خلف نمی‌کند. در اینجا، واژه «کافی» به معنای «کافی و بسنده» آمده و «کیعص» اشاره به آیات قرآنی دارد که نشان‌دهنده‌ی اعتقادات محکم و وعده‌های الهی است."],[646,"کافیم بدهم ترا من جمله خیر","بی‌سبب بی‌واسطه یاری غیر","من به تو کلی خیر می‌دهم بی‌هیچ دلیلی و بدون نیاز به واسطه‌ای از دیگران."],[646,"کافیم بی‌نان ترا سیری دهم","بی‌سپاه و لشکرت میری دهم","من می‌توانم به تو خوشی و آرامش بدهم، حتی بدون نان و غذا، و بدون نیاز به سپاه و نیرو."],[646,"بی‌بهارت نرگس و نسرین دهم","بی‌کتاب و اوستا تلقین دهم","بدون نیاز به گل و گیاه زیبا مثل نرگس و نسرین، به تو علم و فهم می‌آموزم و از کتب مقدس مثل اوستا آگاهی می‌بخشم."],[646,"کافیم بی داروت درمان کنم","گور را و چاه را میدان کنم","من می‌توانم بدون دارو و درمان، گور و چاه را آباد کنم و به آن‌ها زندگی ببخشم."],[646,"موسیی را دل دهم با یک عصا","تا زند بر عالمی شمشیرها","من به موسی که پیامبر است، با یک عصا و نیرو می‌دهم تا بر جهان تاثیر بگذارد و دشمنان را مغلوب کند."],[646,"دست موسی را دهم یک نور و تاب","که طپانچه می‌زند بر آفتاب","به موسی نور و نوری می‌دهم که مانند ضربه‌ای بر خورشید، تأثیرگذار و روشن‌کننده باشد."],[646,"چوب را ماری کنم من هفت سر","که نزاید ماده مار او را ز نر","من چوب را به شکل ماری با هفت سر درمی‌آورم، طوری که ماده‌مار نتواند از نر زایشی داشته باشد. این بیان استعاری است و نشان‌دهنده قدرت و توانایی در تغییر شکل یا وضعیت است."],[646,"خون نیامیزم در آب نیل من","خود کنم خون عین آبش را به فن","من در آب نیل (رودی در مصر) خون نمی‌آمیزم و نمی‌گذارم کسی در آن بیافتد. خودم عین خون و آب آن را به کنشی خاص تغییر می‌دهم."],[646,"شادیت را غم کنم چون آب نیل","که نیابی سوی شادیها سبیل","غم و اندوه تو را به گونه‌ای در می‌آورم که مانند آب نیل می‌شود، زیرا نمی‌توانی به سمت شادی‌ها راهی پیدا کنی."],[646,"باز چون تجدید ایمان بر تنی","باز از فرعون بیزاری کنی","اگر بار دیگر ایمان را در وجودت زنده کنی، به مانند زمان گذشته از فرعون (نماد ستم و کفر) بیزار خواهی شد."],[646,"موسی رحمت ببینی آمده","نیل خون بینی ازو آبی شده","موسی، که پیامبر مورد رحمت و توجه است، به نیل نگاه کن که به خون بدل شده، اما در واقع از او آبی پاک به وجود آمده است."],[646,"چون سر رشته نگه داری درون","نیل ذوق تو نگردد هیچ خون","اگر خط و ربط خود را حفظ کنی و به خداوند توجه کنی، در زمانه‌ای که سختی و مشکلات نظیر خون در نیل وجود دارد، ذائقه و احساس تو هرگز آسیب نخواهد دید."],[646,"من گمان بردم که ایمان آورم","تا ازین طوفان خون آبی خورم","من فکر کردم که اگر به ایمان بیفتم، به وسیله آن می‌توانم از این طوفان خونی نجات پیدا کنم و رستگار شوم."],[646,"من چه دانستم که تبدیلی کند","در نهاد من مرا نیلی کند","من نمی‌دانستم که خداوند (اکرم الاکرمین) می‌تواند مرا به حالتی دیگر (تبدیل) درآورد و در درونم تغییری به وجود آورد که با نوشیدن نیل (رنگ آبی) مانند نیل باایمانی و خوشحال شوم."],[646,"سوی چشم خود یکی نیلم روان","برقرارم پیش چشم دیگران","من به طرف چشمان خود، یک رنگ نیلین (آبی) می‌ریزم و این رنگ را در برابر چشمان دیگران حفظ می‌کنم."],[646,"هم‌چنانک این جهان پیش نبی","غرق تسبیحست و پیش ما غبی","نمی‌توان به درستی فهمید که این جهان در حضور نبی (محمد) چگونه به تسبیح و ذکر مشغول است، ولی برای ما که او را نمی‌بینیم، این دنیا مثل سکوت و بی‌خبر شدن از خدا به نظر می‌رسد."],[646,"پیش چشمش این جهان پر عشق و داد","پیش چشم دیگران مرده و جماد","در نظر او، این جهان مملو از عشق و عدل است، اما در چشم دیگران، این دنیا بی‌روح و مرده به شمار می‌رود."],[646,"پست و بالا پیش چشمش تیزرو","از کلوخ و خشت او نکته شنو","این دنیا به نظر او پست و بالا ندارد و او به سرعت و تیزهوشی به جزئیات آن نگاه می‌کند، در حالی که دیگران در میان چیزهای بی‌ارزش و بی‌حس غافل هستند. هر چیز حقایق خاص خود را دارد که او به خوبی می‌فهمد."],[646,"با عوام این جمله بسته و مرده‌ای","زین عجب‌تر من ندیدم پرده‌ای","با مردم عادی این موضوع مطرح شده و مرده‌ای که از آن عجیب‌تر دیده‌ام، پرده‌ای است که هیچ‌کس نتوانسته آن را از بین ببرد."],[646,"گورها یکسان به پیش چشم ما","روضه و حفره به چشم اولیا","گورها برای ما همان‌قدر که خوشبختی و بهشت به نظر می‌رسد، برای اولیا و افراد فرهیخته نیز همان‌قدر می‌تواند ترسناک و عذاب‌آور باشد. به عبارت دیگر، دیدگاه افراد عادی و نیکان درباره مرگ و زندگی پس از آن متفاوت است."],[646,"عامه گفتندی که پیغامبر ترش","از چه گشتست و شدست او ذوق‌کش","عموم مردم می‌پرسند که چرا پیامبر (محمد) به نظر می‌رسد که از چیزی ناراحت و ترش‌رو شده است، و این حالت او را به گونه‌ای نشان می‌دهد که از لذتی که باید داشته باشد، بی‌بهره است."],[646,"خاص گفتندی که سوی چشمتان","می‌نماید او ترش ای امتان","خاص (گروهی خاص) می‌گویند که پیامبر (ص)، در نگاه شما، از حالت دل‌نشین و خوشی برخوردار نیست و به صورت جدی و ترش به نظر می‌رسد."],[646,"یک زمان درچشم ما آیید تا","خنده‌ها بینید اندر هل اتی","یک بار در چشم ما بیایید تا لبخندها و شادی‌ها را در ما ببینید."],[646,"از سر امرود بن بنماید آن","منعکس صورت بزیر آ ای جوان","چشم‌های سرسبز درختی به نام \"امرود بن\" تصویر تو را به نمایش می‌گذارند، ای جوان، و تو هم باید به آن نگاه کنی."],[646,"آن درخت هستی است امرودبن","تا بر آنجایی نماید نو کهن","درختی که به آن اشاره شده، نمادی از هستی است که همواره بین جوانی و پیری در حال تغییر و تجدید است. این درخت می‌تواند به زندگی و دگرگونی‌های آن در طول زمان اشاره داشته باشد."],[646,"تا بر آنجایی ببینی خارزار","پر ز کزدمهای خشم و پر ز مار","هرچند در آن درخت هستی، نشانه‌های نو و کهنه وجود دارد، اما اگر به جایی بیفتی، زهر و آسیب‌های ناشی از خشم و مشکلات را خواهی دید که در آنجا پر از خارزار و خطرات همچون مارهاست."],[646,"چون فرود آیی ببینی رایگان","یک جهان پر گل‌رخان و دایگان","وقتی به این مکان پایین بیایی، می‌بینی که یک دنیا پر از دختران زیبا و نیکوکار وجود دارد که همه چیز به طور رایگان در اختیارشان است."],[647,"آن زنی می‌خواست تا با مول خود","بر زند در پیش شوی گول خود","زنی خواست تا با فاسق خود، پیش چشم شوهر گیجش بخوابد"],[647,"پس به شوهر گفت زن کای نیکبخت","من برآیم میوه چیدن بر درخت","زن به شوهرش می‌گوید: ای مرد خوشبخت، من الآن به بالای درخت می‌روم تا میوه بچینم."],[647,"چون برآمد بر درخت آن زن گریست","چون ز بالا سوی شوهر بنگریست","آن زن وقتی که بر بالای درخت رفت تا میوه بچیند، از آن‌جا که به شوهرش نگاه کرد، به ناگاه به گریه افتاد."],[647,"گفت شوهر را کای مأبون رد","کیست آن لوطی که بر تو می‌فتد","او به شوهرش می‌گوید، ای آدم بیچاره، بگو ببینم آن مرد لوتی (که به تو نزدیک می‌شود) کیست؟"],[647,"تو به زیر او چو زن بغنوده‌ای","ای فلان تو خود مخنّث بوده‌ای","تو در زیر او مثل زنی خوابیده‌ای، ای فلانی! خودت هم در حقیقت نرست بوده‌ای."],[647,"گفت شوهر نه سرت گویی بگشت","ورنه اینجا نیست غیر من به دشت","شوهر می‌گوید: مگر نمی‌بینی که غیر من کسی در این دشت نیست، پس اگر چیزی در ذهن تو جریان دارد، به خاطر سرت است که در اینجا می‌چرخد."],[647,"زن مکرر کرد که آن با برطله","کیست بر پشتت فرو خفته هله","زن بارها پرسید که آن موجود با عجله و بی‌خبر از پشت تو کیست که در خواب بر تو نشسته است."],[647,"گفت ای زن هین فرود آ از درخت","که سرت گشت و خرف گشتی تو سخت","گفت: ای زن، از درخت (امروت) پایین بیا، چون سر تو به خاطر این فکرها شلوغ و ناراحت شده و سخت به هم ریخته‌ای."],[647,"چون فرود آمد بر آمد شوهرش","زن کشید آن مول را اندر برش","وقتی شوهر زن از درخت پایین آمد، او (زن) مول را به درون خود کشید، به این معنا که به طرز نادرست و فریبنده‌ای او را مجذوب خود کرد."],[647,"گفت شوهر کیست آن ای روسپی","که به بالای تو آمد چون کپی","شوهر از زن می‌پرسد که آن زن فاسد (روسپی) که بر بالای تو آمده است چه کسی است، مانند میمونی (کپی) که به او دویده است."],[647,"گفت زن نه نیست اینجا غیر من","هین سرت برگشته شد هرزه متن","زن گفت: غیر از من هیچ‌کس در اینجا نیست، حالا که به این وضعیت دچار شده‌ای، فکر نکن که تو به خاطر کسی دیگر دچار این افکار غلط شده‌ای."],[647,"او مکرر کرد بر زن آن سخن","گفت زن این هست از امرودبن","او بارها به زن گفت که این خیال‌هایی که می‌بینی، از درخت «امرود» است و واقعی نیستند. زن در پاسخ می‌گوید که این خیالات از همان درخت نشأت می‌گیرد."],[647,"از سر امرودبن من هم‌چنان","کژ همی دیدم که تو ای قلتبان","من نیز از بالای آن درخت (امرودبن) به گونه‌ای کج و نامناسب نگاه می‌کردم که تو ای کسانی که در قضاوت بیش از حد می‌کوشی."],[647,"هین فرود آ تا ببینی هیچ نیست","این همه تخییل از امروبنیست","باید از بالا پایین بیایی تا دریابی که این همه تخیلات هیچ نیست و ربطی به امرودبن ندارد."],[647,"هزل تعلیم است آن را جد شنو","تو مشو بر ظاهر هزلش گرو","هزل، یعنی سخنان شوخی و بی‌محتوا، در واقع زمینه‌ای برای یادگیری و آموختن است؛ پس تو به ظواهر این سخنان توجه نکن و به حقیقت آنها گوش بده."],[647,"هر جدی هزلست پیش هازلان","هزلها جدست پیش عاقلان","در برابر افراد نادان، هر نوع جدیت و seriousness بی‌اهمیت به نظر می‌رسد، در حالی که برای افراد با خرد و عاقل، شوخی‌ها و نقیض‌گویی‌ها خود به نوعی جدیت و عمق می‌رسند."],[647,"کاهلان امرودبن جویند لیک","تا بدان امرودبن راهیست نیک","کسانی که بی‌کار و سست‌عزم هستند، به دنبال درخت امرود (میوه‌ای خوشمزه و لذیذ) می‌گردند، اما تا زمانی که راهی به آن درخت وجود نداشته باشد، این جستجو بیهوده است."],[647,"نقل کن ز امرودبن که اکنون برو","گشته‌ای تو خیره‌چشم و خیره‌رو","به من خبر بده درباره امرودبن که الان تو کور و حیران شده‌ای."],[647,"این منی و هستی اول بود","که برو دیده کژ و احول بود","این واژه «منی» به معنی خودیابی و وجود فردی است که سبب می‌شود انسان‌ها دیدگاه‌ها و برداشت‌های نادرست و غیرواقعی از جهان پیدا کنند. در واقع، وقتی فرد دچار خودبینی و خودمحوری می‌شود، به همین دلیل دیدگاهش باطل و ناقص می‌گردد."],[647,"چون فرود آیی ازین امرودبن","کژ نماند فکرت و چشم و سخن","اگر از آن درخت خیال‌انگیز فرود بیایی، دیگر فکر، دید و سخن تو دچار کجی و انحراف نخواهد شد."],[647,"یک درخت بخت بینی گشته این","شاخ او بر آسمان هفتمین","درخت بخت تو مانند درختی است که شاخ و برگ آن به آسمان هفتم رسیده و بسیار بلندی و عظمت یافته است."],[647,"چون فرود آیی ازو گردی جدا","مبدلش گرداند از رحمت خدا","اگر از درخت بخت دور شوی و از آن فاصله بگیری، خداوند تو را به رحمت خود متحول می‌کند و به حالت بهتری می‌رساند."],[647,"زین تواضع که فرود آیی خدا","راست بینی بخشد آن چشم ترا","اگر از خودخواهی و تکبر خود کمتر شوی و به تواضع باور داشته باشی، خدا به تو توفیق می‌دهد که حقیقت را ببینی و به تو بصیرت می‌بخشد."],[647,"راست بینی گر بدی آسان و زب","مصطفی کی خواستی آن را ز رب","اگر بدی و نیکی را به خوبی تشخیص بدهی، حقیقت را خواهی دید، همان‌طور که اگر از جانب پیامبر (مصطفی) درخواست کنی، پاسخ مثبت به تو داده خواهد شد."],[647,"گفت بنما جزو جزو از فوق و پست","آنچنان که پیش تو آن جزو هست","او گفت: نشان بده که اجزا و قسمت‌ها (جزو) به چه صورت از بالا و پایین (فوق و پست) قرار گرفته‌اند، همان‌طور که آن جزو و قسمت (کیفیت چیزها) در پیش تو وجود دارد."],[647,"بعد از آن بر رو بر آن امرودبن","که مبدل گشت و سبز از امر کن","سپس به آن درخت (امرودبن) که سبز و زیبا شده، نگاه کن و از آنچه به تو الهام می‌شود، درک کن."],[647,"چون درخت موسوی شد این درخت","چون سوی موسی کشانیدی تو رخت","زمانی که درخت به شکل و حالتی که خاص موسی (پیامبر) است، تبدیل شد، دلیلش این است که تو (خدا) لباس نور و جمال بر آن پوشاندی و آن را جذب خود کردی."],[647,"آتش او را سبز و خرم می‌کند","شاخ او انی انا الله می‌زند","اینجا به این اشاره می‌شود که آن آتش، که می‌تواند به عشق یا معرفت تعبیر شود، باعث زندگی و شادابی او می‌شود و به او حالتی خاص می‌بخشد که در آن خود را موجودی الهی و خداوندی احساس می‌کند."],[647,"زیر ظلش جمله حاجاتت روا","این چنین باشد الهی کیمیا","در زیر سایه و حمایت او (خدا) همه نیازهایت برآورده می‌شود؛ این‌گونه است که او (خدا) به تو مانند کیمیا، ارزش و فایده می‌دهد."],[647,"آن منی و هستیت باشد حلال","که درو بینی صفات ذوالجلال","تمام وجود تو و هویتت در آن چیز حلال است که در آن صفات خداوند (ذوالجلال) را ببینی. به عبارت دیگر، اگر در چیزی به خدا و صفات نیکو او پی ببری، آن چیز حلال و درست است."],[647,"شد درخت کژ مقوم حق‌نما","اصله ثابت و فرعه فی‌السما","درختی که ظاهرا کج و نامناسب به نظر می‌رسد، در حقیقت ریشه‌اش محکم و ثابت است و شاخه‌هایش به آسمان می‌رسد. این بیت به نشان دادن حقیقتی عمیق اشاره دارد که ممکن است ظواهر گمراه‌کننده باشند، در حالی که بنیاد و اصل واقعیت بسیار قوی است."],[648,"کآمدش پیغام از وحی مهم","که کژی بگذار اکنون فاستقم","پیام جدیدی از وحی به موسی علیه‌السلام رسید که به او دستور داد دیگر از راه کجی (گناهان و انحرافات) فاصله بگیرد و راه راست را در پیش بگیرد."],[648,"این درخت تن عصای موسی است","که امرش آمد که بیندازش ز دست","این درختی که از آن سخن می‌گوییم، همان عصای موسی است که به او دستور داده شده آن را از دست بیندازد."],[648,"تا ببینی خیر او و شرّ او","بعد از آن بر گیر او را ز امر هو","به این ترتیب، بعد از اینکه خوب و بد او را شناختی، به فرمان حق، او را بگیر و در دست بگیر."],[648,"پیش از افکندن نبود او غیر چوب","چون به امرش بر گرفتی گشت خوب","پیش از آنکه چوب را به درون آب بیندازی، هیچ چیز جز چوب وجود نداشت. اما زمانی که طبق دستور او (موسی) آن را برداشتیم، خوب و شگفت آور شد."],[648,"اول او بد برگ‌افشان برّه را","گشت معجز آن گروه غرّه را","در ابتدا، موسی (علیه‌السلام) چوبی را به‌وجود آورد که برگ‌افشان بود و با معجزه‌اش گروهی را که مغرور بودند، متعجب کرد."],[648,"گشت حاکم بر سر فرعونیان","آبشان خون کرد و کف بر سر زنان","حاکم بر فرعونیان، موسی علیه‌السلام، از قدرت خود استفاده کرد و باعث شد آب آن‌ها به خون تبدیل شود و زنانشان در ناآرامی و اضطراب قرار گیرند."],[648,"از مزارعشان برآمد قحط و مرگ","از ملخهایی که می‌خوردند برگ","خوشک‌سالی و مرگ از زمین‌های زراعی آن‌ها بروز کرد به خاطر ملخ‌هایی که برگ‌های گیاهان را می‌خوردند."],[648,"تا بر آمد بی‌خود از موسی دعا","چون نظر افتادش اندر منتها","موسی (پیامبر) بی‌اختیار و غیرقابل کنترل از دعا برآمد، زیرا نگاهش به اوج و مرتبه بالایی افتاد."],[648,"کاین همه اعجاز و کوشیدن چراست","چون نخواهند این جماعت گشت راست","چرا این همه معجزات و تلاش‌ها وجود دارد، در حالی که این گروه نمی‌خواهند درست شوند و به راه حق برگردند؟"],[648,"امر آمد که اتّباع نوح کن","ترک پایان‌بینی مشروح کن","پیام رسیده که مانند نوح (پیامبر) پیروی کن و از پایان‌نگری و جزئی‌بینی که باعث دل‌نگرانی و تردید می‌شود، پرهیز کن."],[648,"زان تغافل کن چو داعیّ رهی","امر بلّغ هست نبود آن تهی","از این بی‌توجهی دست بردار و وقتی که دعوت‌کننده‌ای برای راهنمایی آمده، به او توجه کن؛ زیرا این دعوت، نشان‌دهنده پیامی است که ممکن است بر تو تأثیر بگذارد و تو را از احساس تهی بودن نجات دهد."],[648,"کمترین حکمت کزین الحاح تو","جلوه گردد آن لجاج و آن عتوّ","کمترین حکمتی که از این اصرار و پافشاری تو نمایان می‌شود، همان لجاجت و سرسختی است که در تو وجود دارد."],[648,"تا که ره بنمودن و اضلال حق","فاش گردد بر همه اهل و فرق","تا زمانی که راه هدایت و گمراهی در مورد حق روشن نشود، بر همه مردم و گروه‌ها مشخص نمی‌شود."],[648,"چونکه مقصود از وجود اظهار بود","بایدش از پند و اغوا آزمود","مقصود از وجود انسان باید در وجودش نمایان شود و برای این که به حقیقت او پی برد، باید از نصیحت و فریب امتحانش کرد."],[648,"دیو الحاح غوایت می‌کند","شیخ‌ الحاح هدایت می‌کند","دیو با فشار و اصرار خود، مردم را به گمراهی و فساد می‌کشاند، در حالی که یک شیخ یا فرد آگاه و هدایت‌گر به پیروی و راهنمایی درست و مفید دعوت می‌کند."],[648,"چون پیاپی گشت آن امر شجون","نیل می‌آمد سراسر جمله خون","وقتی آن واقعه نگران‌کننده به طور مکرر روی می‌دهد، آنگاه نهر نیل به شکل تمام‌عیار سرشار از خون می‌شود."],[648,"تا به نفس خویش فرعون آمدش","لابه می‌کردش دو تا گشته قدش","فرعون از شدت اضطراب و ترس به حالت زاری و گدایی به سوی موسی مراجعه می‌کند و در حالیکه به دلایل سختی که برایش پیش آمده، دو برابر شده، به او پناه می‌آورد."],[648,"کآن چه ما کردیم ای سلطان مکن","نیست ما را روی ایراد سخن","ای پادشاه، آنچه ما انجام دادیم، خواهش می‌کنم به حساب نیاور و به خاطر ایراد گرفتن بر ما، روی خود را به ما نشان نده."],[648,"پاره پاره گردمت فرمان‌پذیر","من به عزّت خوگرم سختم مگیر","اگر تو فرمان‌پذیر و مطیع من باشی، من به خاطر حرمت و عزت تو، بر سختی‌ها و مشکلاتت آسانی می‌آورم و آنها را از بین می‌برم."],[648,"هین بجنبان لب به رحمت ای امین","تا ببندد این دهانه‌ی آتشین","ای امین (موسی علیه‌السلام)، با لب‌های خود به رحمت الهی دعا کن تا این درگاه آتشین بسته شود و عذاب از بین برود."],[648,"گفت یا رب می‌فریبد او مرا","می‌فریبد او فریبنده‌ی ترا","موسی علیه‌السلام می‌گوید: ای خدا، او (فریبنده) به من فریب می‌دهد و خود نیز به حقیقت فریبنده توست."],[648,"بشنوم یا من دهم هم خدعه‌اش","تا بداند اصل را آن فرع‌کش","من با شنیدن یا دادن فریب او، قصد دارم تا بفهمد که اصل ماجرا چه چیزی است و چه‌گونه فرع‌ها را نابود می‌کند."],[648,"که اصل هر مکری و حیلت پیش ماست","هر چه بر خاکست اصلش از سماست","هر نوع نیرنگ و حیله‌ای که وجود دارد، در واقع ریشه‌اش در حقیقت و واقعیت است و ما این حقیقت را می‌شناسیم؛ زیرا هر چیزی که بر زمین (خاک) وجود دارد، سرچشمه‌اش از آسمان (سما) است."],[648,"گفت حق آن سگ نیرزد هم به آن","پیش سگ انداز از دور استخوان","خداوند فرمود که این سگ (نماد ناپاکی یا پلیدی) به هیچ وجه با آن استخوان (نماد ارزش و مقام) قابل مقایسه نیست و از دور استخوان را به او بیندازید."],[648,"هین بجنبان آن عصا تا خاکها","وا دهد هرچه ملخ کردش فنا","موسی باید عصایش را به حرکت درآورد تا زمین را شگفت‌انگیز ببیند و هر آنچه را که ملخ‌ها نابود کردند، جبران کند."],[648,"وان ملخها در زمان گردد سیاه","تا ببیند خلق تبدیل اله","ملخ‌ها در آن زمان سیاه می‌شوند تا مردم تغییر الهی را ببینند."],[648,"که سببها نیست حاجت مر مرا","آن سبب بهر حجابست و غطا","من به چیزهایی که به عنوان علت یا دلیل شناخته می‌شوند نیازی ندارم، زیرا آنچه به عنوان سبب مطرح می‌شود، تنها برای پوشاندن حقیقت و پنهان کردن آن است."],[648,"تا طبیبی خویش بر دارو زند","تا منجّم رو به استاره کند","تا وقتی که طبیب بر دارو و درمان تأکید کند و ستاره‌شناس به پیش‌بینی آینده بپردازد، کسانی که به درستی و حقیقت توجه ندارند، متوجه مشکلات و بحران‌های واقعی نخواهند شد."],[648,"تا منافق از حریصی بامداد","سوی بازار آید از بیم کساد","منافق به خاطر حریص بودن، صبح زود به سمت بازار می‌رود تا از ترس کساد شدن بازار و ضرر مالی، چیزی بخرد."],[648,"بندگی ناکرده و ناشسته روی","لقمه‌ی دوزخ بگشته لقمه‌جوی","آن کسی که هنوز بندگی نکرده و خود را پاک نکرده، اکنون به لقمه‌ای از آتش دوزخ تبدیل شده و در پی لقمه می‌گردد."],[648,"آکل و مأکول آمد جان عام","هم‌چو آن برّه‌ی چرّنده از حطام","انسان و چیزی که می‌خورد، هر دو مانند آن بره‌ای هستند که از علف بی‌ارزش می‌چرند. این جمله به ارتباط انسان و غذا اشاره دارد و بیان می‌کند که چگونه ذات انسان به آنچه که مصرف می‌کند وابسته است."],[648,"می‌چرد آن برّه و قصّاب شاد","کو برای ما چرد برگ مراد","آن بره در حال چریدن است و قصاب نیز خوشحال است، زیرا قصاب برای ما چریدن بره را به عنوان خواسته و آرزو می‌بیند."],[648,"کار دوزخ می‌کنی در خوردنی","بهر او خود را تو فربه می‌کنی","تو در تلاش برای تأمین لذایذ دنیوی برای خود، در واقع خود را به عذاب و دوزخ نزدیک می‌کنی."],[648,"کار خود کن روزی حکمت بچر","تا شود فربه دل با کرّ و فرّ","به کار خود مشغول شو و با حکمت رفتار کن تا دل تو پر باشد از زیبایی و شادابی."],[648,"خوردن تن مانع این خوردنست","جان چو بازرگان و تن چون ره‌زنست","جسم انسان مانع از رسیدن به روح و معنویت است، مانند بازرگانی که متوجه سود خود است و جسم او همچون راهزنی است که مانع حرکت او به سوی هدف اصلی‌اش می‌شود."],[648,"شمع تاجر آنگهست افروخته","که بود ره‌زن چو هیزم سوخته","شمع تاجر وقتی روشن است که دزدی (ره‌زن) مثل هیزم سوخته وجود ندارد. یعنی روشنایی و آگاهی در زندگی میسر است که موانع و مشکلات برطرف شوند."],[648,"که تو آن هوشی و باقی هوش‌پوش","خویشتن را گم مکن یاوه مکوش","تو که هوشیار هستی، باقی هوشیاری را نپوشان و خودت را گم نکن، به حرف‌های بی‌محتوا نپرداز."],[648,"دان که هر شهوت چو خمرست و چو بنگ","پرده هوشست وعاقل زوست دنگ","بدان که هر desire (شهوت) مانند شراب (خمر) و مانند شیره خواب‌آور (بنگ) پرده‌ای بر هوش و آگاهی می‌افکند و تنها عاقل از این مستی رهایی دارد."],[648,"خمر تنها نیست سرمستیّ هوش","هر چه شهوانیست بندد چشم و گوش","سرمستی و بی‌خود شدن تنها به خاطر نوشیدنی‌های وهم‌آور نیست؛ بلکه هر چیزی که به شهوت مربوط می‌شود، می‌تواند انسان را از درک و فهم درست دور کند و چشم و گوش او را ببندد."],[648,"آن بلیس از خمر خوردن دور بود","مست بود او از تکبر وز جحود","ابلیس به خاطرش به می‌خانه نرفت و از شراب نخورده بود، بلکه او به خاطر کبر و انکارش مدهوش بود."],[648,"مست آن باشد که آن بیند که نیست","زر نماید آنچه مس و آهنیست","مست واقعی کسی است که چیزهایی را که وجود ندارند ببیند و گمان کند آن‌ها طلا هستند، در حالی که حقیقتا آن‌ها فقط مس و آهن هستند."],[648,"این سخن پایان ندارد موسیا","لب بجنبان تا برون روژد گیا","این سخن هیچ‌گاه تمام نمی‌شود، ای موسی، زبان به حرکت بیاور تا کلامی تازه از آن برون بیاید."],[648,"هم‌چنان کرد و هم اندر دم زمین","سبز گشت از سنبل و حب ثمین","موسی علیه‌السلام همچنان صحبت کرد و در زیر قدم‌هایش زمین به خاطر بذر سنبل و گیاهان گرانبها سبز شد."],[648,"اندر افتادند در لوت آن نفر","قحط دیده مرده از جوع البقر","مردانی که در شهر لوت (شهر فساد) به هلاکت رسیده بودند، به دلیل گرسنگی و قحطی، همچون گاوهای مرده افتاده بودند."],[648,"چند روزی سیر خوردند از عطا","آن دمی و آدمی و چارپا","مدت چند روز از نعمت و بخشش الهی به خوبی و فراوانی خوردند، هم انسان‌ها و هم چهارپایان (حیوانات)."],[648,"چون شکم پر گشت و بر نعمت زدند","وآن ضرورت رفت پس طاغی شدند","زمانی که شکم‌ها پر از نعمت شد و به خوردن پرداختند و نیازمندی‌ها برطرف گردید، انسان‌ها طغیان کردند و سرکشی کردند."],[648,"نفس فرعونیست هان سیرش مکن","تا نیارد یاد از آن کفر کهن","نفس انسان مانند نفس فرعون است، پس آن را سیر نکن تا به یاد کفر و نافرمانی‌های گذشته نیفتد."],[648,"بی تف آتش نگردد نفس خوب","تا نشد آهن چو اخگر هین مکوب","اگر نفس انسان، که مانند نفس فرعون است، بدون داغ و آتش نگردد، چنان‌که آهن وقتی حرارت نبیند به حالت خود باقی می‌ماند، در این صورت نمی‌توان آن را تغییر داد. بنابراین، برای تغییر نفس و بهبود آن، باید عزم و تلاش کرد و به جنگ با مشکلات و چالش‌ها رفت."],[648,"بی‌مجاعت نیست تن جنبش‌کنان","آهن سردیست می‌کوبی بدان","بدون وجود شوق و اشتیاق، هیچ حرکتی در بدن ممکن نیست؛ مانند آهنی که سرد و بی‌جان است و با زدن بر آن هم حرکتی ایجاد نمی‌شود."],[648,"گر بگرید ور بنالد زار زار","او نخواهد شد مسلمان هوش دار","اگر او (فرعون) از شدت ترس و ناراحتی حتی بگرید و زاری کند، در نهایت مسلمان نخواهد شد. هوشیار باش که این تغییر خود را در ایمان نشان نمی‌دهد."],[648,"او چو فرعونست در قحط آنچنان","پیش موسی سر نهد لابه‌کنان","فرعون در هنگام قحطی مانند کسی می‌شود که به موسی (ع) می‌رسد و پیش او زاری می‌کند و التماس می‌کند."],[648,"چونک مستغنی شد او طاغی شود","خر چو بار انداخت اسکیزه زند","وقتی او (فرعون) بی‌نیاز شود، طغیان می‌کند، مانند الاغی که وقتی بارش را بر زمین گذاشت، شروع به نعره زدن می‌کند."],[648,"پس فراموشش شود چون رفت پیش","کار او زان آه و زاریهای خویش","زمانی که انسان به خواسته‌هایش می‌رسد و از مشکلات ر‌ها می‌شود، درد و زاری‌های گذشته‌اش را فراموش می‌کند."],[648,"سالها مردی که در شهری بود","یک زمان که چشم در خوابی رود","مدتی طولانی مردی در شهر زندگی می‌کرد که وقتی خوابش می‌برد، دیگر خبری از آن شهر به خاطرش نمی‌ماند."],[648,"شهر دیگر بیند او پر نیک و بد","هیچ در یادش نیاید شهر خود","مردی در خواب به شهری دیگر می‌رود که پر از خوبی‌ها و بدی‌هاست، اما هیچ‌یک از ویژگی‌های شهر خود را به یاد نمی‌آورد."],[648,"که من آنجا بوده‌ام این شهر نو","نیست آن من درینجاام گرو","من در این شهر جدید نیستم و در واقع، من همیشه در آن شهر قبلی بوده‌ام؛ اکنون در اینجا گرفتار شده‌ام."],[648,"بل چنان داند که خود پیوسته او","هم درین شهرش بدست ابداع و خو","بل (بلکه) او به‌خوبی می‌داند که خود همواره در این شهر (دنیا) به‌اراده و خلاقیت خود حضور دارد و زندگی می‌کند."],[648,"چه عجب گر روح موطنهای خویش","که بدستش مسکن و میلاد پیش","عجبی ندارد اگر روح کسانی که در سرزمین خود زاده شده‌اند، به آنجا احساس تعلق و عشق داشته باشد."],[648,"می‌نیارد یاد کین دنیا چو خواب","می‌فرو پوشد چو اختر را سحاب","دنیا مانند خواب است و وقتی که انسان از آن غافل می‌شود، یاد وحشت‌های آن را فراموش می‌کند، همان‌طور که ابرها در آسمان ستاره را می‌پوشاند."],[648,"خاصه چندین شهرها را کوفته","گردها از درک او ناروفته","موسی علیه‌السلام که در شهرها برای هدایت و فهم حقایق می‌کوشد، موانع و مشکلات زیادی را تجربه کرده است که به مانند گرد و غبار در راه او قرار دارند و مانع از درک درست او می‌شوند."],[648,"اجتهاد گرم ناکرده که تا","دل شود صاف و ببیند ماجرا","انسان وقتی که تلاش و کوشش لازم را انجام ندهد، قادر به پاکسازی دل خود نخواهد بود و نمی‌تواند حقیقت را به‌خوبی ببیند."],[648,"سر برون آرد دلش از بخش راز","اول و آخر ببیند چشم باز","دل شخص وقتی به اوج فهم و بصیرت برسد، رازهای عمیق زندگی را درک می‌کند و به حقیقت‌های نخستین و پایانی دست می‌یابد، انگار که با چشمی باز به تماشای آنها نشسته است."],[649,"آمده اول به اقلیم جماد","وز جمادی در نباتی اوفتاد","انسان ابتدا در مرحله جماد (که به موجودات بی‌جان اشاره دارد) به وجود آمده و سپس از این مرحله عبور کرده و به مرحله نباتی (که به گیاهان و موجودات زنده اشاره دارد) وارد شده است."],[649,"سالها اندر نباتی عمر کرد","وز جمادی یاد ناورد از نبرد","این بیت به این اشاره دارد که انسان سال‌ها به شکل گیاه زندگی کرده و حتی یاد و خاطره‌ای از دوره زندگیش به عنوان جماد ندارد، گویی جنگ و تلاش برای بقا در آن زمان‌ها برایش بی‌معنا بوده است."],[649,"وز نباتی چون به حیوانی فتاد","نامدش حال نباتی هیچ یاد","زمانی که انسان از مرحله گیاهی به حیوانی منتقل شد، هیچ نشانه‌ای از حالت گیاهی در او باقی نماند و دیگر به آن یاد نمی‌کند."],[649,"جز همین میلی که دارد سوی آن","خاصه در وقت بهار و ضیمران","انسان تنها یک میل یا رغبت خاص دارد که در زمان بهار و فصل رویش و باروری، به آن سمت حرکت می‌کند. این میل نشان‌دهنده گرایش طبیعی او به زندگی و شکوفایی است."],[649,"هم‌چو میل کودکان با مادران","سر میل خود نداند در لبان","کودکان مانند میل شدیدی که به مادران خود دارند، نمی‌توانند در لحن و کلام خود نشان دهند که به چه چیزی جذب شده‌اند."],[649,"هم‌چو میل مفرط هر نو مرید","سوی آن پیر جوانبخت مجید","مانند اشتیاق شدید و فراوان هر تازه‌واردی (نو مرید) به سوی آن سالک خوشبخت و نیکوکار (پیر جوانبخت مجید) است."],[649,"جزو عقل این از آن عقل کلست","جنبش این سایه زان شاخ گلست","جزئی از عقل انسانی که در ما وجود دارد، از عقل کل سرچشمه می‌گیرد و حرکتی که در ما مشاهده می‌شود، سایه‌ای از آن درخت گلنعنا است، که به معنای زیبایی و کمال الهی است."],[649,"سایه‌اش فانی شود آخر درو","پس بداند سر میل و جست و جو","سایه این درخت در نهایت از بین می‌رود، پس انسان باید بداند جست‌وجو و تلاش او چه هدفی دارد."],[649,"سایه شاخ دگر ای نیکبخت","کی بجنبد گر نجنبد این درخت","سایه درخت دیگری هرگز حرکت نمی‌کند، مگر این که خود آن درخت جنب و جوش داشته باشد. پس اگر درختی در حالت سکون باشد، سایه‌اش نیز حرکتی نخواهد کرد."],[649,"باز از حیوان سوی انسانیش","می‌کشید آن خالقی که دانیش","خالقی که دانا است، بار دیگر انسان را از حالت حیوانی به سمت ویژگی‌های انسانی‌اش هدایت می‌کند."],[649,"هم‌چنین اقلیم تا اقلیم رفت","تا شد اکنون عاقل و دانا و زفت","انسان از مراحل و اقلیم‌های مختلفی عبور کرده تا به اینجا رسیده که اکنون عاقل، دانا و با وقار باشد."],[649,"عقلهای اولینش یاد نیست","هم ازین عقلش تحول کردنیست","عقل‌های اولیه آدمی برایش یادآوری نمی‌شود و او نمی‌داند که عقل کنونی‌اش، دچار تغییر و تحول شده است."],[649,"تا رهد زین عقل پر حرص و طلب","صد هزاران عقل بیند بوالعجب","اگر از این عقل پر حرص و حبّ به دنیا رهایی یابد، هزاران عقل شگفت‌انگیز و عمیق را مشاهده خواهد کرد."],[649,"گر چو خفته گشت و شد ناسی ز پیش","کی گذارندش در آن نسیان خویش","اگر مانند کسی که خوابش برده است، فراموشکار شود، باز هم او را در همان فراموشی‌اش رها نمی‌کنند."],[649,"باز از آن خوابش به بیداری کشند","که کند بر حالت خود ریش‌خند","اگر کسی در خواب باشد و دچار فراموشی شود، دوباره او را بیدار می‌کنند تا به خودش و وضعیتش بخندد و بر خویش آگاه شود."],[649,"که چه غم بود آنک می‌خوردم به خواب","چون فراموشم شد احوال صواب","در این بیت، شاعر به این اشاره می‌کند که در حالت خواب، چه غمی بر او حاکم بوده که فراموش کرده است حالاتی را که درست و صحیح بوده‌اند. به عبارتی، هنگامی که در خواب بوده، از واقعیت و درست بودن حالش غافل شده است."],[649,"چون ندانستم که آن غم و اعتلال","فعل خوابست و فریبست و خیال","چون ندانستم که آن غم و ناراحتی ناشی از خواب است و فریب و خیال است."],[649,"هم‌چنان دنیا که حلم نایمست","خفته پندارد که این خود دایمست","دنیا همچون خواب و خیال است که در آن از حقیقت غافل شده‌ایم و گمان می‌کنیم که این حالت و وضعیت برای همیشه ادامه خواهد داشت."],[649,"تا بر آید ناگهان صبح اجل","وا رهد از ظلمت ظن و دغل","ناگهان صبح مرگ می‌آید و انسان را از تاریکی‌های گمان و نیرنگ رهایی می‌بخشد."],[649,"خنده‌اش گیرد از آن غمهای خویش","چون ببیند مستقر و جای خویش","وقتی آدمی در روز قیامت به مقام و جایگاه واقعی خود پی ببرد، از غم‌ها و مشکلاتی که در دنیا برایش پیش آمده، به خنده می‌افتد."],[649,"هر چه تو در خواب بینی نیک و بد","روز محشر یک به یک پیدا شود","هر چیزی که در خواب ببینی، چه خوب و چه بد، در روز قیامت یکی یکی آشکار خواهد شد."],[649,"آنچ کردی اندرین خواب جهان","گرددت هنگام بیداری عیان","هر چیزی که در خواب این دنیا انجام دادی، در زمان بیداری‌ات مشخص و آشکار خواهد شد."],[649,"تا نپنداری که این بد کردنیست","اندرین خواب و ترا تعبیر نیست","نگران نباش که این کار بدی است و نمی‌توانی در این خواب به تعبیر درست برسی."],[649,"بلک این خنده بود گریه و زفیر","روز تعبیر ای ستمگر بر اسیر","این خنده در واقع گریه و فریاد ناشی از ناپایداری دنیا است، ای ستمگر، تو بر این اسیر که در خواب و غفلت به سر می‌برد، این حقیقت را درک نمی‌کنی."],[649,"گریه و درد و غم و زاری خود","شادمانی دان به بیداری خود","گریه و درد و غم و زاری را به شادمانی و خوشحالی خود در بیداری‌ات تفسیر کن و بدان که در این حالت، نشانه‌ آگاهی و بیداری است."],[649,"ای دریده پوستین یوسفان","گرگ بر خیزی ازین خواب گران","ای کسی که لباس زیبای یوسف (که نماد زیبایی و مقام است) را دریده‌ای و به صفات بد و حیوانی گرگ گونه متصف شده‌ای، از این خواب عمیق و غفلت بیدار شو."],[649,"گشته گرگان یک به یک خوهای تو","می‌درانند از غضب اعضای تو","گرگ‌ها به صورت تک‌تک، خویشتن را در وجود تو به نمایش می‌گذارند و از روی خشم، اعضای تو را رنج می‌دهند."],[649,"خون نخسپد بعد مرگت در قصاص","تو مگو که مردم و یابم خلاص","پس از مرگ تو در قصاص، خون (یعنی عواقب اعمال) نمی‌ریزد. نگو که من مرده‌ام و از این مجازات رهایی پیدا می‌کنم."],[649,"این قصاص نقد حیلت‌سازیست","پیش زخم آن قصاص این بازیست","این قصاص، نتیجه بازی‌های فریبنده‌ای است که انسان‌ها در زندگی خود انجام می‌دهند و در واقع، عواقب این ترفندها و حیله‌ها بی‌نهایت جدی و سنگین است، مانند زخم واقعیتی که خود آن‌ها به وجود آورده‌اند."],[649,"زین لعب خواندست دنیا را خدا","کین جزا لعبست پیش آن جزا","خداوند دنیا را به عنوان بازی و سرگرمی می‌داند زیرا پاداش حوادث و اعمال در این دنیا نیز تنها یک نوع بازی است که پیش از پاداش واقعی است."],[649,"این جزا تسکین جنگ و فتنه‌ایست","آن چو اخصا است و این چون ختنه‌ایست","این پاداش، آرامش‌دهنده جنگ و فتنه‌هاست، مانند ختنه که نشانه خاصی برای وفاداری و تعلق است، به طور معنا، نشان‌دهنده مرحله‌ای مهم در زندگی انسان است."],[650,"این سخن پایان ندارد موسیا","هین رها کن آن خران را در گیا","این گفت‌وگو پایانی ندارد، ای موسی، پس بهتر است که آن افراد خچپوش و ناتوان را رها کنی و به سراغ گیاهان و نعمت‌ها بروی."],[650,"تا همه زان خوش علف فربه شوند","هین که گرگانند ما را خشم‌مند","همه باید از آن علف خوش تغذیه شوند تا گرگ‌ها نسبت به ما خشمگین نشوند."],[650,"ناله گرگان خود را موقنیم","این خران را طعمه ایشان کنیم","ما خودمان از ناله گرگان (دشمنان) آگاهیم و می‌دانیم که این خران (افراد ناتوان یا بی‌کفایت) طعمه آنها خواهند شد."],[650,"این خران را کیمیای خوش دمی","از لب تو خواست کردن آدمی","این انسان‌ها (خران) از تو می‌خواهند که با کلام شیرین و خوشایندت، آن‌ها را به بهترین شکل بسازی و شاد کنی."],[650,"تو بسی کردی به دعوت لطف و جود","آن خران را طالع و روزی نبود","تو با لطف و سخاوتمندی خود تلاش کردی تا زندگی بهتری برای این اراذل (خران) فراهم کنی؛ اما آنها هنوز طالع و روزی خوبی ندارند و همچنان در تنگدستی به سر می‌برند."],[650,"پس فرو پوشان لحاف نعمتی","تا بردشان زود خواب غفلتی","پس، لحاف نعمتی را بر روی آن‌ها بکش تا زود از خواب غفلت بیدار شوند."],[650,"تا چو بجهند از چنین خواب این رده","شمع مرده باشد و ساقی شده","وقتی مردم از خواب غفلت بیدار شوند، دیگر شمع‌های روشن (نماد زندگی و امید) نخواهند داشت و ساقی (آب‌دهنده، نماد معیشت و زندگی) نخواهد بود."],[650,"داشت طغیانشان ترا در حیرتی","پس بنوشند از جزا هم حسرتی","طغیان و نافرمانی این افراد تو را در حیرت و تعجب قرار داده است، در حالی که پس از آن باید از مجازات و عواقب کارهای خود، حسرت و افسوس بخورند."],[650,"تا که عدل ما قدم بیرون نهد","در جزا هر زشت را درخور دهد","زمانی که عدل ما در جزا عملی شود، هر فرد زشت و نادرست هم سزا و عاقبتی متناسب با اعمالش خواهد گرفت."],[650,"که آن شهی که می‌ندیدندیش فاش","بود با ایشان نهان اندر معاش","آن شاهی که مردم به‌راحتی می‌توانستند روی او را ببینند، در واقع در تقسیم روزی و معیشت به‌طور پنهان با آنان درگیر بود."],[650,"چون خرد با تست مشرف بر تنت","گرچه زو قاصر بود این دیدنت","خرد (عقل) تو بر جسم (تن و ظاهر) تو نظارت دارد، با این که دیدن تو برای او ممکن نیست و نمی‌تواند تو را به‌طور کامل بشناسد."],[650,"نیست قاصر دیدن او ای فلان","از سکون و جنبشت در امتحان","ای فلان، نقص در درک و شناخت او به سبب سکون و تحرک تو در آزمایش‌ها نیست."],[650,"چه عجب گر خالق آن عقل نیز","با تو باشد چون نه‌ای تو مستجیز","چقدر عجیب است که خالق همان عقل که با توست، از تو درخواست کمک نمی‌کند، چون تو خود را محتاج نمی‌دانی."],[650,"از خرد غافل شود بر بد تند","بعد آن عقلش ملامت می‌کند","کسی که از عقل و خرد خود غافل شود، وقتی به کارهای بدی دست می‌زند، بعدا عقل و هوش او او را سرزنش و ملامت می‌کند."],[650,"تو شدی غافل ز عقلت عقل نی","کز حضورستش ملامت کردنی","تو از عقل خود غافل شدی، در حالی که عقل به خاطر غفلت تو نمی‌تواند تو را سرزنش کند؛ چرا که عقل به دلیل عدم حضور تو در حال ملامت است."],[650,"گر نبودی حاضر و غافل بدی","در ملامت کی تو را سیلی زدی","اگر تو غافل و بی‌خبر از خودت نبودی، دیگر نمی‌توانستی خود را سرزنش کنی که چرا به خود سیلی زدی."],[650,"ور ازو غافل نبودی نفس تو","کی چنان کردی جنون و تفس تو","اگر از وجود خود غافل نبودی، چرا این‌قدر دیوانه‌وار و بی‌هوش شده‌ای؟"],[650,"پس تو و عقلت چو اصطرلاب بود","زین بدانی قرب خورشید وجود","عقل تو مانند اصطرلاب (تلسکوپ قدیمی) است که می‌تواند حقیقت را به خوبی ببیند و درک کند، بنابراین می‌توانی نزدیکی به منبع وجود (خداوند) را درک کنی."],[650,"قرب بی‌چونست عقلت را به تو","نیست چپ و راست و پس یا پیش رو","نزدیکی و قرب به حقیقت مطلق (خدا) برای عقل معین و مشخص نیست و او نه به چپ و راست می‌تواند برود و نه به جلو و عقب، زیرا آنجا مفاهیم معمولی مکانی وجود ندارد."],[650,"قرب بی‌چون چون نباشد شاه را","که نیابد بحث عقل آن راه را","اگر قرب و نزدیکی به حقیقت و پروردگار بی‌حد و اندازه باشد، شاهی (ویرایش) که به این قرب دست نیابد، نمی‌تواند با عقل خود به فهم و بحث درباره آن راه بپردازد."],[650,"نیست آن جنبش که در اصبع تراست","پیش اصبع یا پسش یا چپ و راست","جنبشی که در انگشت تو وجود دارد، ناشی از حرکات خود انگشت نیست، بلکه واقعیتی فراتر از آن موجب این حرکت می‌شود. اینطور نیست که حرکت به خودی خود از پیش یا پس یا چپ و راست انگشت ناشی شود."],[650,"وقت خواب و مرگ از وی می‌رود","وقت بیداری قرینش می‌شود","زمانی که انسان در خواب و هنگام مرگ است، از او جدا می‌شود، اما در زمان بیداری، او به زندگی و وجودش نزدیک می‌شود و وجودش را تجربه می‌کند."],[650,"از چه ره می‌آید اندر اصبعت","که اصبعت بی او ندارد منفعت","این بیت به این معنی است که وجود هر چیز شادی‌بخش و مفید، از کجا به دست می‌آید، در حالی که وجود انگشت (اصبع) بدون او (خدا یا منبع هستی) هیچ بهره‌ای ندارد. به عبارت دیگر، همه چیز به خدا وابسته است و خودش به تنهایی ارزشی ندارد."],[650,"نور چشم و مردمک در دیده‌ات","از چه ره آمد به غیر شش جهت","نور چشم و مردمک در چشمان تو از چه طریق و از کدام جهت آمده است که در شش جهت معروف وجود ندارد؟"],[650,"عالم خلقست با سوی و جهات","بی‌جهت دان عالم امر و صفات","عالم مخلوقات با ابعاد و جهات مختلف وجود دارد، اما بدان که عالم امر (آسمان معنوی و حقایق الهی) و صفات خداوند، خارج از این جهات و محدودیت‌هاست."],[650,"بی‌جهت دان عالم امر ای صنم","بی‌جهت‌تر باشد آمر لاجرم","اى صنم (محبوب)، عالم را بدون دلیل بدان؛ زیرا آمر (فرمانده) نیز بی‌جهت‌تر از آن عالم است."],[650,"بی‌جهت بد عقل و علام البیان","عقل‌تر از عقل و جان‌تر هم ز جان","قصد ندارم به چیزی بی‌دلیل و بی‌سبب، عقل را کم‌ارزش تصور کنم؛ زیرا عقل خود بهتر از جان است و بیشتر از جان، حقیقت را می‌شناسد."],[650,"بی‌تعلق نیست مخلوقی بدو","آن تعلق هست بی‌چون ای عمو","هر مخلوقی به خدا وابسته است و این وابستگی بدون هیچ شکی وجود دارد، ای برادر."],[650,"زانک فصل و وصل نبود در روان","غیر فصل و وصل نندیشد گمان","چون در روح انسانی فصل و وصلی وجود ندارد، بنابراین نمی‌توان به مسائل مربوط به فصل و وصلی اندیشید. این بیانگر آن است که در ذات انسان پیوندی فراتر از این دسته‌بندی‌ها وجود دارد."],[650,"غیر فصل و وصل پی بر از دلیل","لیک پی بردن بننشاند غلیل","تنها غیر از فصل و وصل (دو حالت جدایی و پیوستگی)، دلیلی در پی وجود ندارد، اما درک این مطلب نشان می‌دهد که فهمیدن حقیقت، مانند شعله‌ای سوزان است."],[650,"پی پیاپی می‌بر ار دوری ز اصل","تا رگ مردیت آرد سوی وصل","در اینجا گفته می‌شود که به طور مداوم و پیوسته از اصل و منبع دور افتاده‌ایم و این دوری باعث می‌شود که به سمت وصلی واقعی نرسیم؛ باید به ریشه‌های وجودی خود نزدیک شویم تا به حالت واقعی و انسانی‌مان دست یابیم."],[650,"این تعلق را خرد چون ره برد","بسته فصلست و وصلست این خرد","این وابستگی را عقل به خوبی درک می‌کند، زیرا این وابستگی به فصولی که شامل جدایی و پیوستگی هستند، مربوط می‌شود."],[650,"زین وصیت کرد ما را مصطفی","بحث کم جویید در ذات خدا","پیامبر اسلام، مصطفی (یعنی محمد)، به ما توصیه کرده که در مورد ذات خداوند سخن‌وری نکنیم و در این باره کنکاش نکنیم."],[650,"آنک در ذاتش تفکر کردنیست","در حقیقت آن نظر در ذات نیست","در حقیقت، هرگونه تفکر و نظر درباره ذات خداوند ممکن نیست، چون ذات او فراتر از درک ماست و نمی‌توان به سادگی در آن بیندیشیم."],[650,"هست آن پندار او زیرا به راه","صد هزاران پرده آمد تا اله","پندار او حقیقت ندارد و به خاطر این است که از هزاران پرده گذشته تا به ما برسد، یعنی برای رسیدن به حقیقت، موانع و حجاب‌های بسیاری وجود دارد."],[650,"هر یکی در پرده‌ای موصول خوست","وهم او آنست که آن خود عین هوست","هر کس در پرده‌ای خاصی قرار دارد و در آن حال، قدری از حقیقت و وجود خود را درک می‌کند، در واقع آنچه او به آن می‌اندیشد، همان ماهیت واقعی اوست."],[650,"پس پیمبر دفع کرد این وهم از او","تا نباشد در غلط سوداپز او","پیامبر این خیال و توهم را از او دور کرد تا او در اشتباه و غلط اندیشی گرفتار نشود و گرفتار فریب نگردد."],[650,"وانکه اندر وهم او ترک ادب","بی‌ادب را سرنگونی داد رب","کسی که در گمانش ادب را ترک کرده و بی‌ادب است، خداوند او را به سرنگونی و نابودی دچار می‌کند."],[650,"سرنگونی آن بود کو سوی زیر","می‌رود پندارد او کو هست چیر","سرنگونی و سقوط زمانی اتفاق می‌افتد که کسی به سمت پایین حرکت کند و گمان کند که او قدرت و توانایی دارد."],[650,"زانک حد مست باشد این چنین","کو نداند آسمان را از زمین","چون کسی که مستی‌اش شدت دارد، نمی‌تواند تفاوت بین آسمان و زمین را تشخیص دهد، به همین دلیل به چنین حالتی دچار می‌شود."],[650,"در عجبهااش به فکر اندر روید","از عظیمی وز مهابت گم شوید","در شگفتی‌های او غرق می‌شوید و از بزرگی و جلال او به حیرت می‌آیید."],[650,"چون ز صنعش ریش و سبلت گم کند","حد خود داند ز صانع تن زند","وقتی که مخلوق به آثار و نشانه‌های خداوند پی ببرد و آن‌ها را از یاد ببرد، دیگر حد و مرز خود را نمی‌داند و از خالق خود دور می‌شود."],[650,"جز که لا احصی نگوید او ز جان","کز شمار و حد برونست آن بیان","جز خدا کسی نمی‌تواند درباره جان بگوید، چون جان از شمار و حدود خارج است و بی‌حد و مرز است."],[651,"رفت ذوالقرنین سوی کوه قاف","دید او را کز زمرد بود صاف","ذوالقرنین به سوی کوه قاف رفت و دید که این کوه از سنگ زمردی صاف و شفاف تشکیل شده است."],[651,"گرد عالم حلقه گشته او محیط","ماند حیران اندر آن خلق بسیط","ذوالقرنین در میان دنیا، احاطه‌ای دارد و در این حالی که به دور آن حلقه زده، در میان آن همه انسان‌های ساده و بی‌خبر سردرگم و متعجب است."],[651,"گفت تو کوهی دگرها چیستند","که به پیش عظم تو بازیستند","ذوالقرنین می‌گوید: تو که کوه هستی، دیگر کوه‌ها چه جایگاهی دارند که در برابر عظمت تو به حساب بیایند و فقط نقش بازی کنند؟"],[651,"گفت رگهای من‌اند آن کوهها","مثل من نبوند در حسن و بها","کوه‌ها همانند من، در زیبایی و ارزش، رگ‌های من هستند و به جایی نمی‌رسند."],[651,"من به هر شهری رگی دارم نهان","بر عروقم بسته اطراف جهان","من در هر شهری چیزی پنهان دارم که به من اتصال دارد و این چیزها به دور من و در اطراف جهان قرار گرفته‌اند."],[651,"حق چو خواهد زلزله شهری مرا","گوید او من بر جهانم عرق را","وقتی خدا بخواهد زلزله‌ای بر شهر بیفتد، به من می‌گوید که من در عالم وجودم مانند عرقی (مایع) هستم که به تمام جهان وصل است."],[651,"پس بجنبانم من آن رگ را بقهر","که بدان رگ متصل گشتست شهر","من با غضب آن رگ را به حرکت درمی‌آورم، زیرا این رگ به شهری متصل شده است."],[651,"چون بگوید بس شود ساکن رگم","ساکنم وز روی فعل اندر تگم","وقتی که بگوید سکوت کن، رگ من هم ساکن می‌شود و من نیز بی‌حرکت می‌مانم، و به خاطر فعل آن، در حالتی ایستاده و پابرجا می‌شوم."],[651,"هم‌چو مرهم ساکن و بس کارکن","چون خرد ساکن وزو جنبان سخن","چنان‌که مرهم‌ها آرام و بی‌حرکت‌اند و کار می‌کنند، عقل نیز باید آرام بماند و از او سخنی به حرکت درآید."],[651,"نزد آنکس که نداند عقلش این","زلزله هست از بخارات زمین","برای کسی که درک نمی‌کند، عقلش به‌نوعی از لرزش و بلوا دچار می‌شود که ناشی از بخارات زمین است، یعنی درک و فهم او در هم آمیخته و ناپایدار می‌شود."],[652,"مورکی بر کاغذی دید او قلم","گفت با مور دگر این راز هم","مورکی بر روی کاغذی متوجه شد که قلمی،نقشی ایجاد می‌کند و مور دیگر را متوجه این موضوع ساخت."],[652,"که عجایب نقشها آن کلک کرد","هم‌چو ریحان و چو سوسن‌زار و ورد","عجایب طرح‌ها و نقوشی که قلم کشید، شبیه به گل‌های خوشبو مانند ریحان و سوسن و گل‌های دیگر است."],[652,"گفت آن مور اصبعست آن پیشه‌ور","وین قلم در فعل فرعست و اثر","مور گفت: آنچه در اینجا مهم‌تر است، این است که آن قلم فقط ابزاری است و عمل نوشتن به دست پیشه‌ور (کسی که کار هنری می‌کند) انجام می‌شود. در واقع، قلم فرع و شاخه‌ای از کار این هنرمند است و اثر اصلی به وسیله او خلق می‌شود."],[652,"گفت آن مور سوم کز بازوست","که اصبع لاغر ز زورش نقش بست","مور سومی گفت که قدرت و قوت او از بازو به دست می‌آید و این انگشتان لاغر و ضعیف به دلیل ناتوانی‌اش تنها نقش و اثری ندارند."],[652,"هم‌چنین می‌رفت بالا تا یکی","مهتر موران فطن بود اندکی","مور باهوش و زیرکی در حال بالا رفتن بود تا به شخصی مهم و بزرگتر از خود در بین موران برسد."],[652,"گفت کز صورت مبینید این هنر","که به خواب و مرگ گردد بی‌خبر","گفت که شما این هنر را از ظاهر نمی‌بینید، زیرا این هنر به خواب و مرگ بی‌خبر می‌شود و فقط در باطن قابل درک است."],[652,"صورت آمد چون لباس و چون عصا","جز به عقل و جان نجنبد نقشها","صورت مانند لباس یا عصا است و تنها از طریق عقل و جان است که می‌توان به معانی واقعی دست یافت و از ظواهر دور شد."],[652,"بی‌خبر بود او که آن عقل وفاد","بی ز تقلیب خدا باشد جماد","مور خبر نداشت که آن عقل وفادار، بدون تغییر و تحول، از جانب خداوند، مثل موجودات بی‌جان است."],[652,"یک زمان از وی عنایت بر کند","عقل زیرک ابلهیها می‌کند","مدتی از توجه او (خدا) می‌گذرد که عقل زیرک و باهوش هم به خاطر غفلت و نادانی‌اش، کارهای احمقانه‌ای انجام می‌دهد."],[652,"چونش گویا یافت ذوالقرنین گفت:","چونک کوه قاف درّ نطق سفت","ذوالقرنین (که در ادبیات اسلامی به عنوان یک شخصیت بزرگ و حکیم شناخته می‌شود) به طور واضح و روشن پاسخ می‌دهد: چون کوه قاف، سنگی محکم و استوار است، سخن نیکو و زیبا نیز باید درخشان و بارز باشد."],[652,"کای سخن‌گوی خبیر رازدان","از صفات حق بکن با من بیان","ای کسی که در سخن گفتن و درک معانی پنهان، دانا و آگاه هستی، از ویژگی‌های خداوند با من صحبت کن و آن‌ها را بیان کن."],[652,"گفت رو کان وصف از آن هایل‌ترست","که بیان بر وی تواند برد دست","می‌گوید آن کس که می‌تواند اوصاف را به‌خوبی توضیح دهد، بالاتر و بهتر از آن چیزی است که فقط توسط قلم بیان می‌شود."],[652,"یا قلم را زهره باشد که به سر","بر نویسد بر صحایف زان خبر","قلم شاید جرات داشته باشد که بر صفحه بنویسد و از آنچه در دل دارد خبر دهد."],[652,"گفت کمتر داستانی باز گو","از عجبهای حق ای حبر نکو","گفت: کمتر داستان‌هایی را از کارهای شگفت‌انگیز خداوند بیان کن، ای خبر خوب."],[652,"گفت اینک دشت سیصدساله راه","کوههای برف پر کردست شاه","گفت اکنون دشت سیصد ساله‌ای وجود دارد که کوه‌هایش را برف پر کرده است."],[652,"کوه بر که بی‌شمار و بی‌عدد","می‌رسد در هر زمان برفش مدد","کوهی که بسیار زیاد و به تعداد نامشخص برف می‌بارد، در هر زمانی کمک و یاری می‌کند."],[652,"کوه برفی می‌زند بر دیگری","می‌رساند برف سردی تا ثری","کوه برف بسیاری را بر روی دیگری می‌افکند و این برف سرد را تا بلندای آسمان می‌رساند."],[652,"کوه برفی می‌زند بر کوه برف","دم به دم ز انبار بی‌حد و شگرف","کوه برفی دائما بر کوه دیگری برف می‌ریزد، و این برف به میزان زیادی در انباری بی‌نهایت و عظیم جمع می‌شود."],[652,"گر نبودی این چنین وادی شها","تف دوزخ محو کردی مر مرا","اگر این وادی (خانه یا سرزمین) تو نبود، آتش دوزخ مرا از میان می‌برد و محو می‌کرد."],[652,"غافلان را کوههای برف دان","تا نسوزد پرده‌های عاقلان","به نادان‌ها برف‌هایی را نشان بده که مانند کوه هستند تا پرده‌های عاقلان نسوزد. یعنی نادان‌ها را با برف و سرما آشنا کن تا عقل‌مندان آسیب نبیند."],[652,"گر نبودی عکس جهل برف‌باف","سوختی از نار شوق آن کوه قاف","اگر تصویر جهل به مانند برف نبود، تو از آتش شوق آن کوه قاف می‌سوزی."],[652,"آتش از قهر خدا خود ذره‌ایست","بهر تهدید لئیمان دره‌ایست","آتش به عنوان نمادی از قهر خداوند، فقط یک ذره کوچک است و هدف آن تهدید کردن افراد پست و ناچیز است."],[652,"با چنین قهری که زفت و فایق است","برد لطفش بین که بر وی سابق است","با این قهر بزرگ و بی‌نظیری که خداوند دارد، توجه کن به لطفش که همیشه بر او گذشته و موجود است."],[652,"سبق بی‌چون و چگونه معنوی","سابق و مسبوق دیدی بی‌دوی","معنای این بیت این است که در فهم و درک معنوی، برخی افراد بدون هیچ دلیل و نشان مشخصی، از دیگران برتری دارند و این برتری پیشاپیش وجود داشته و نیازی به دلیل آوردن ندارد."],[652,"گر ندیدی آن بود از فهم پست","که عقول خلق زان کان یک جوست","اگر نتوانستی آن را ببینی، به دلیل نادانی و ضعف درک توست، زیرا عقل‌های مردم از درک این معانی حقیرتر از یک پول‌جو (کمی ارزش) هستند."],[652,"عیب بر خود نه نه بر آیات دین","کی رسد بر چرخ دین مرغ گلین","عیب را باید بر خود بگذاریم و نه بر آیات دین، زیرا دین مانند چرخ است و نمی‌توان آن را مقصر دانست. در حقیقت، مشکلات انسانی به خود انسان مربوط می‌شود و نه به اصول و آیات دین."],[652,"مرغ را جولانگه عالی هواست","زانک نشو او ز شهوت وز هواست","مرغ به دلیل اینکه از شهوت و خواسته‌های نفسانی رهاست، در هوای بلند و آزاد پرواز می‌کند. این نشان‌دهنده آن است که اگر روح از وابستگی‌های زمینی و خواسته‌های دنیوی آزاد شود، به عوالم بالاتر و عالی‌تر دست می‌یابد."],[652,"پس تو حیران باش بی‌لا و بلی","تا ز رحمت پیشت آید محملی","پس تو در حیرت و شگفتی باش، بی‌هیچ توجیه و درشتی، تا رحمت الهی برایت وسیله‌ای فراهم کند."],[652,"چون ز فهم این عجایب کودنی","گر بلی گویی تکلف می‌کنی","اگر از درک این عجایب عاجزی و در حالتی نامفهوم قرار داری، با گفتن «بله» فقط خود را به زحمت می‌اندازی و به خودت فشار می‌آوری."],[652,"ور بگویی نی زند نی گردنت","قهر بر بندد بدان نی روزنت","اگر بگویی که نی بر تو نغمه نمی‌زند، قهر و دلخوری‌ات را به گردن نی بینداز؛ اما بدان که نی روزی تو را نیز دچار خواهد کرد."],[652,"پس همین حیران و واله باش و بس","تا درآید نصر حق از پیش و پس","پس تو هم به همین حالت حیرت و شگفتی ادامه بده تا پیروزی حق از هر سو به تو برسد."],[652,"چونک حیران گشتی و گیج و فنا","با زبان حال گفتی اهدنا","زمانی که در حالتی از حیرت و سردرگمی قرار گرفتی و به فنا نزدیک شدی، با حالتی از دلخواهی و نیت درونی خود به خداوند می‌گویی ما را هدایت کن."],[652,"زفت زفتست و چو لرزان می‌شوی","می‌شود آن زفت نرم و مستوی","پدیده‌ای که در ابتدا سخت و قوی به نظر می‌رسد و در وقتی که به لرزش می‌افتد، در واقع به آرامی و نرمی تغییر می‌کند. در اینجا به تغییر شگفت‌انگیز اوضاع و حالت‌ها اشاره شده است."],[652,"زانک شکل زفت بهر منکرست","چونک عاجز آمدی لطف و برست","شکل زفت (چربی و نرم) برای کسی که منکر است و پذیرای حقیقت نیست، مناسب نیست؛ زیرا وقتی در برابر حقیقت ناتوان می‌شود، لطف و زیبایی از او دور می‌شود."],[653,"مصطفی می‌گفت پیش جبرئیل","که چنانک صورت تست ای خلیل","پیامبر (مصطفی) به جبرئیل می‌گوید که اگر تو همانند خلیل (ابراهیم خلیل) هستی، پس خودت را به همان شکل که هستی به من نشان بده."],[653,"مر مرا بنما تو محسوس آشکار","تا ببینم مر ترا نظاره‌وار","ای جبرئیل، مرا نشان بده به‌گونه‌ای که ملموس و واضح باشد تا من بتوانم تو را به دقت تماشا کنم."],[653,"گفت نتوانی و طاقت نبودت","حس ضعیفست و تنک سخت آیدت","گفت نمی‌توانی و قدرت این کار را نداری؛ حس تو ضعیف است و مشاهدۀ چنین چیز بزرگی برایت دشوار خواهد بود."],[653,"گفت بنما تا ببیند این جسد","تا چد حد حس نازکست و بی‌مدد","مخاطب از جبرئیل می‌خواهد که خود را نشان دهد تا دریابد این جسم مادی (انسان) تا چه حد حس ضعیفی دارد و بدون کمک قادر به فهم و درک نیست."],[653,"آدمی را هست حس تن سقیم","لیک در باطن یکی خلقی عظیم","انسان دارای حسی ضعیف و ناتوان در بدنش است، اما در درون خود وجودی بزرگ و باارزش دارد."],[653,"بر مثال سنگ و آهن این تنه","لیک هست او در صفت آتش‌زنه","انسان به ظاهر مانند سنگ و آهن است، اما در باطن او مانند آتش‌زنه است که قابلیت شعله‌ور شدن و بخشیدن نور و زندگی را دارد."],[653,"سنگ و آهن مولد ایجاد نار","زاد آتش بر دو والد قهربار","سنگ و آهن، علت و منبعی برای ایجاد آتش هستند و آتش از این دو ماده تولد می‌یابد؛ بنابراین، آتش از این والدینی که قهر و سلطه دارند، زاده می‌شود."],[653,"باز آتش دستکار وصف تن","هست قاهر بر تن او و شعله‌زن","آتش، که به دست هنر و خلاقیت توصیف شده، بر بدن آدمی تسلط دارد و بر آن شعله‌ور می‌شود."],[653,"باز در تن شعله ابراهیم‌وار","که ازو مقهور گردد برج نار","در وجود انسان شعله‌ای وجود دارد که شبیه به شعله آتش ابراهیم است و این شعله می‌تواند آتش را بر خود حاکم کند و آن را تحت تسلط خود درآورد، به گونه‌ای که آتش نتواند او را بسوزاند."],[653,"لاجرم گفت آن رسول ذو فنون","رمز نحن الاخرون السّابقون","پس بنابراین آن پیامبر، که در فنون مختلف ماهر بود، گفت رمز و رازی وجود دارد که ما آخرین و پیشتازان هستیم."],[653,"ظاهر این دو بسندانی زبون","در صفت از کان آهن‌ها فزون","ظاهر این دو (جبرئیل و مصطفی) از آهن‌های مستحکم و قدرتمند هم فراتر و برتر است، چرا که صفات آن‌ها نشان‌دهنده حقیقی و فراتر از خصوصیات مادی است."],[653,"پس به صورت آدمی فرع جهان","وز صفت اصل جهان این را بدان","جبرئیل، فرشته وحی، خود را به شکل انسان نشان داد، زیرا ظاهر انسان، مخلوقی از جهان فرعی است و از جوهر و صفت اصلی جهان، که آن نیز از مبدأ الهی است، تشکیل شده است."],[653,"ظاهرش را پشه‌ای آرد به چرخ","باطنش باشد محیط هفت چرخ","ظاهر او می‌تواند به کوچک‌ترین موجودی مانند پشه‌ای شبیه باشد، ولی باطن او به اندازه‌ای بزرگ و وسیع است که تمام هستی را در بر می‌گیرد و از هفت آسمان فراتر است."],[653,"چونک کرد الحاح بنمود اندکی","هیبتی که که شود زو مندکی","زمانی که جبرئیل به حضرت محمد (ص) اصرار کرد و اندکی از هیبت و عظمت خود را نشان داد، با آن نیکویی و جلالش به گونه‌ای نمودار شد که می‌توانست به خاطر آن، محمد (ص) را دچار ترس و شگفتی کند."],[653,"شهپری بگرفته شرق و غرب را","از مهابت گشت بیهش مصطفی","از شدت جلال و جبروت جبرئیل، شرق و غرب دنیا را همچون پرنده‌ای بزرگ دربرگرفته است و به همین دلیل، پیامبر اسلام (مصطفی) دچار بیهوشی شده است."],[653,"چون ز بیم و ترس بیهوشش بدید","جبرئیل آمد در آغوشش کشید","وقتی جبرئیل به خاطر خوف و ترس مصطفی را بیهوش دید، به نزد او آمد و او را در آغوش گرفت."],[653,"آن مهابت قسمت بیگانگان","وین تجمش دوستان را رایگان","وحشت و ترس مخصوص کسانی است که در جایگاه بیگانه قرار دارند، در حالی که احترام و جذبه به صورت رایگان و بدون زحمت نصیب دوستان می‌شود."],[653,"هست شاهان را زمان بر نشست","هول سرهنگان و صارمها به دست","زمانی که شاهان بر throne یا سلطنت نشسته‌اند، وحشت و ترس از سران و فرماندهان و جنگجویان در دست آن‌هاست."],[653,"دور باش و نیزه و شمشیرها","که بلرزند از مهابت شیرها","دور باش از نیزه‌ها و شمشیرها، زیرا که آن‌ها از ترس شکوه و عظمت شیرها به لرزه درمی‌آیند."],[653,"بانگ چاوشان و آن چوگانها","که شود سست از نهیبش جانها","صدای ناقوس‌ها و صدای چوب بازی (چوگان) به حدی قوی و مهیب است که جان‌ها از ترس آن به لرزه درمی‌آید."],[653,"این برای خاص وعام ره‌گذر","که کندشان از شهنشاهی خبر","این صحنه‌ای است که خبر از شهنشاهی (پیامبر اکرم) به ره‌گذران می‌دهد، هم برای کسانی که خاص هستند و هم برای عامه مردم. به این ترتیب، همه از عظمت و مقام او آگاه می‌شوند."],[653,"از برای عام باشد این شکوه","تا کلاه کبر ننهند آن گروه","این شکوه و عظمت برای عموم مردم است تا آن گروه (عالم بزرگ) دچار کبر و خودخواهی نشوند و خود را برتر ندانند."],[653,"تا من و ماهای ایشان بشکند","نفس خودبین فتنه و شر کم کند","تا زمانی که آن «من» و «ما»های خودپسند این افراد شکسته نشود، فتنه و فساد کاهش پیدا نخواهد کرد."],[653,"شهر از آن آمن شود کان شهریار","دارد اندر قهر زخم و گیر و دار","شهر به خاطر وجود یک پادشاه قوی و حاکم که بر دشمنان و مشکلات فائق می‌آید، در امنیت خواهد بود."],[653,"پس بمیرد آن هوسها در نفوس","هیبت شه مانع آید زان نحوس","این بیت بیان می‌کند که اگر هیبت و بزرگ‌منشی شهریار در دل‌ها حکمرانی کند، هوس‌های زشت و ناپسند از بین می‌روند و دیگر نمی‌توانند در وجود انسان‌ها بمانند."],[653,"باز چون آید به سوی بزم خاص","کی بود آنجا مهابت یا قصاص","وقتی جبرئیل علیه‌السلام به سوی محفل خاصی که مخصوص پیامبر اسلام است باز می‌گردد، آیا در آنجا چیزی جز عظمت و هیبت وجود دارد یا جزایی برای کسی هست؟"],[653,"حلم در حلمست و رحمتها به جوش","نشنوی از غیر چنگ و ناخروش","طبیعت مهربانی و حلم، در عمق بسیار گسترده‌ای وجود دارد و رحمت‌ها به طور مداوم و مداوم در حال ظهور هستند، اما تو نخواهی شنید و متوجه نخواهی شد، مگر اینکه از صدای موسیقی و خوشنوازی بهره‌مند شوی."],[653,"طبل و کوس هول باشد وقت جنگ","وقت عشرت با خواص آواز چنگ","در وقت جنگ، صدای طبل و شیپور وحشت‌آور است، اما در زمان خوشی و لذت، صدای چنگ (ساز) لذت‌بخش و دلنشین است."],[653,"هست دیوان محاسب عام را","وان پری رویان حریف جام را","دیوان محاسب شامل افرادی است که مسئول حسابرسی و رسیدگی به امور مردم هستند، و پری‌های زیبا نیز در مقام حریفان جام (شراب) قرار دارند. به عبارت دیگر، افرادی که در دیوان محاسبه می‌کنند در مقابل زیبایی و لذت‌های دنیوی قرار دارند."],[653,"آن زره وآن خود مر چالیش‌راست","وین حریر و رود مر تعریش‌راست","زره و چهره و لباس خود او (جبرئیل) به حقیقت وجود دارد و همچنین حریر و نهر نیز به درستی وجود خارجی دارند."],[653,"این سخن پایان ندارد ای جواد","ختم کن والله اعلم بالرشاد","این سخن هیچ وقت تمام نمی‌شود، ای جواد، پس آن را به پایان برسان. خداوند به راهنمایی برتر از همه آگاه‌تر است."],[653,"اندر احمد آن حسی کو غاربست","خفته این دم زیر خاک یثربست","در وجود احمد (محمد) احساسی است که در حال غرق‌شدن است، این احساس اکنون در زیر خاک یثرب (مدینه) خوابیده است."],[653,"وآن عظیم الخلق او کان صفدرست","بی‌تغیر مقعد صدق اندرست","جبرئیل، فرشته‌ای بزرگ‌القامه و با ویژگی‌های عظیم، در مقام و موقعیت خودی ثابت و بدون تغییر، در جایگاه راستین و حقیقتی استوار قرار دارد."],[653,"جای تغییرات اوصاف تنست","روح باقی آفتابی روشنست","جای تغییرات و تغییرات ظاهری در اوصاف جسمانی او وجود دارد، اما روح او که باقی‌مانده است، مانند آفتابی روشن و درخشان است."],[653,"بی ز تغییری که لا شرقیة","بی ز تبدیلی که لا غربیة","در این بیت به بیان حالتی از روح اشاره شده که نه به تغییرات ظاهری شرقی مربوط می‌شود و نه به تحولات غربی. این روح ثابت و بدون تغییر است و در اصل بی‌زمان و بی‌مکانی محسوب می‌شود."],[653,"آفتاب از ذره کی مدهوش شد","شمع از پروانه کی بیهوش شد","آفتاب هرگز از کسری (ذره) دچار حیرت و شگفتی نمی‌شود، و شمع نیز هرگز به خاطر پروانه (که به دورش می‌چرخد) بی‌خود و بی‌توجه نمی‌شود."],[653,"جسم احمد را تعلق بد بدآن","این تغیر آن تن باشد بدان","جسم پیامبر (احمد) به خاطر این تغییر و دگرگونی، به این تعلقات (دنیا و مادیات) وابسته است، که نشان‌دهنده دگرگونی آن بدن است."],[653,"هم‌چو رنجوری و هم‌چون خواب و درد","جان ازین اوصاف باشد پاک و فرد","این‌گونه است که حالتی مشابه بیماری و خواب و درد روح به اوصاف آلودگی وابسته است و تنها از این ویژگی‌ها باید دور شود تا پاکی و فردیت خود را به دست آورد."],[653,"روبهش گر یک دمی آشفته بود","شیر جان مانا که آن دم خفته بود","اگر شیر دلیر یک لحظه بی‌تاب و آشفته می‌شد، زندگی‌اش با وجود آن حالت آرامش از دست می‌رفت و دیگر نمی‌توانست آسوده بخوابد."],[653,"خفته بود آن شیر کز خوابست پاک","اینت شیر نرمسار سهمناک","شیر به معنای قدرت و شکوه است، و در اینجا اشاره به پیامبر اسلام (مصطفی صلی‌الله علیه و سلم) دارد که در خواب بود. این شیر، که به خواب رفته، با وجود این که در خواب است، از بین نمی‌رود و صفاتش همچنان باعظمت باقی می‌ماند."],[653,"خفته سازد شیر خود را آنچنان","که تمامش مرده دانند این سگان","شیر، یعنی مرد شجاع، به خواب میرود و چنان آرام و بی‌حرکت می‌شود که گویی همه سگ‌ها (دشمنان) او را مرده تصور می‌کنند."],[653,"ورنه در عالم کرا زهره بدی","که ربودی از ضعیفی تربدی","اگر در عالم کسی وجود دارد که بتواند از توانی که در ضعف توست، چیزی را برباید یا غافلگیر کند، باید بدانیم که چنین کسی وجود ندارد."],[653,"کف احمد زان نظر مخدوش گشت","بحر او از مهر کف پرجوش گشت","کف یعنی دست یا نشانه‌ای از احمد (پیامبر اسلام) به خاطر نگاهی خاص دچار انحراف شد و دریا (یا وجود) او از عشق (مهر) همان دست به شدت جوشید و متلاطم گردید."],[653,"مه همه کفست معطی نورپاش","ماه را گر کف نباشد گو مباش","ماه تنها یک کف است که نور افشانی می‌کند. اگر این کف (احمد) نباشد، دیگر ماه نیز وجود نخواهد داشت."],[653,"احمد ار بگشاید آن پر جلیل","تا ابد بیهوش ماند جبرئیل","اگر احمد (پیامبر اسلام) یکی از پرهای بزرگ جبرئیل را باز کند، جبرئیل تا ابد دچار حیرت و بی‌هوشی خواهد شد."],[653,"چون گذشت احمد ز سدره و مرصدش","وز مقام جبرئیل و از حدش","وقتی که احمد (پیامبر اسلام) از درخت سدره و مقام بلند جبرئیل و حد و مرز او عبور کرد،"],[653,"گفت او را هین بپر اندر پیم","گفت رو رو من حریف تو نیم","جبرئیل به پیامبر (احمد) گفت که بشتاب و داخل این پیمان (راستی) شو، زیرا من با تو هم‌نشین نیستم و نمی‌توانم تو را همراهی کنم."],[653,"باز گفت او را بیا ای پرده‌سوز","من باوج خود نرفتستم هنوز","جبرئیل گفت: بیا، ای کسی که پرده‌ها را می‌سوزانی، من هنوز به اوج خود نرسیده‌ام."],[653,"گفت بیرون زین حد ای خوش‌فر من","گر زنم پری بسوزد پر من","جبرئیل گفت: فراتر از این محدوده‌ (محدوده‌ای که در آن قرار داریم) ای خوش‌فر (دارای جمال زیبا)، اگر من پر که دارد، با آن همه بالا بروم، یک پری خواهد سوخت."],[653,"حیرت اندر حیرت آمد این قصص","بیهشی خاصگان اندر اخص","این داستان‌ها در حیرت عمیق فرو می‌برد و حیرت بزرگی است که خاصّان (مؤمنان و عارفان) نیز در آن در حیرت‌اند و از خود بی‌خود شده‌اند."],[653,"بیهشیها جمله اینجا بازیست","چند جان داری که جان پردازیست","این بی‌خودی‌ها و حیرت‌ها تنها بازی است؛ هر چند جان داری، اینجا مشغول به جان‌فروشی (فدا کردن جان) هستی."],[653,"جبرئیلا گر شریفی و عزیز","تو نه‌ای پروانه و نه شمع نیز","اگر جبرئیل، فرشته‌ای بزرگ و محترم، شریفی و عزیز تو نیست، پس تو نه پروانه‌ای هستی که به شمع نزدیک شود و نه خود شمعی که برای دیگران نور افشانی کند."],[653,"شمع چون دعوت کند وقت فروز","جان پروانه نپرهیزد ز سوز","زمانی که شمع نزدیک می‌شود تا نور جان خود را دعوت کند، پروانه از سوز و شعله آن نمی‌ترسد و دوری نمی‌کند."],[653,"این حدیث منقلب را گور کن","شیر را برعکس صید گور کن","این جمله به مفهوم این است که داستان یا سخن را که دگرگون و پیچیده شده، باطل کن، و حقیقت را فراموش نکن؛ به نوعی اشاره به این است که باید واقعیت‌ها را در جهت درست و واقعی خود شناخت و از برداشت‌های نادرست دوری کرد."],[653,"بند کن مشک سخن‌شاشیت را","وا مکن انبان قلماشیت را","سخن گفتن و بیان خود را محدود کن و اجازه نده تا بار و انبان کلمات بیهوده‌ات باز شود."],[653,"آنک بر نگذشت اجزاش از زمین","پیش او معکوس و قلماشیست این","جبرئیل (فرشته وحی) به پیش پیامبر اسلام (مصطفی) ظاهر شد و پرهایش، که هفتصد عدد بودند، به صورت یک پر درآمدند و زمین زیر پای او مانند آینه معکوس شد."],[653,"لا تخالفهم حبیبی دارهم","یا غریبا نازلا فی دارهم","ای حبیب من، با آنها مخالفت نکن، زیرا تو غریبه‌ای هستی که در سرزمین آنان نازل شده‌ای."],[653,"اعط ما شائوا وراموا وارضهم","یا ظعینا ساکنا فی‌ارضهم","هرچه آن‌ها بخواهند و آرزو کنند، به آن‌ها عطا کن و راضی‌شان کن ای مسافر، تو که در سرزمین آن‌ها ساکن هستی."],[653,"تا رسیدن در شه و در ناز خوش","رازیا با مرغزی می‌ساز خوش","برای رسیدن به مقام و مرتبه‌ای عالی و خوش، باید در بی‌خبری و خفا با مرغزاری (پرنده‌ای آزاد) آشتی و دوستی برقرار کرد."],[653,"موسیا در پیش فرعون زمن","نرم باید گفت قولا لینا","موسی باید با فرعون به نرم‌گویی و ملایمت سخن بگوید، زیرا در برابر او باید به آرامی و با کلامی لطیف صحبت کند."],[653,"آب اگر در روغن جوشان کنی","دیگدان و دیگ را ویران کنی","اگر آب را در روغن داغ بریزی، دیگ و محتویات آن خراب و نابود می‌شود. اشاره به این است که در شرایط نامناسب، هرگونه ترکیب یا تلاشی می‌تواند موجب فساد و خرابی شود."],[653,"نرم گو لیکن مگو غیر صواب","وسوسه مفروش در لین الخطاب","نرمی و ملایمت را در گفتار خود رعایت کن، اما در عین حال چیزی جز حقیقت نگو. از وسوسه‌ها و افکار غلط دوری کن و در سخن گفتن، فقط به سمت آنچه صحیح و درست است برو."],[653,"وقت عصر آمد سخن کوتاه کن","ای که عصرت عصر را آگاه کن","زمان عصر فرا رسیده است، پس صحبت را کوتاه کن، ای کسی که عصر را آگاه می‌کنی."],[653,"گو تو مر گل‌خواره را که قند به","نرمی فاسد مکن طینش مده","به گل‌خواره (یعنی شراب‌نوش) بگو که قند را به نرمی فاسد نکند و آلودگی به او ندهد. این نشان می‌دهد که باید از چیزهای نامناسب دوری کرد تا آرامش و طراوت از بین نرود."],[653,"نطق جان را روضه جانیستی","گر ز حرف و صوت مستغنیستی","اگر روح تو سیر و پرواز روحانی را احساس کند، نیازی به کلمات و صداها نخواهد داشت و خود به خود متوجه معانی عمیق می‌شود."],[653,"این سر خر در میان قندزار","ای بسا کس را که بنهادست خار","این بیت به این معناست که در میان خوشی‌ها و لذت‌ها (قندزار)، برخی افراد نیز وجود دارند که مشکلات و دردسرهایی (خارها) برایشان پیش آمده است. این نشان می‌دهد که حتی در بهترین شرایط، ممکن است غم و ناامیدی وجود داشته باشد."],[653,"ظن ببرد از دور کان آنست و بس","چون قج مغلوب وا می‌رفت پس","گمان می‌برد که آن (چهره) فقط همین است و بس، در حالی‌که مانند (کلمات) قج که در جنگ شکست خورد، به تدریج محو می‌شود."],[653,"صورت حرف آن سر خر دان یقین","در رز معنی و فردوس برین","این بیت به این معناست که فقط با سخن گفتن، می‌توان به حقیقت و معانی عمیق دست یافت؛ مانند سر خر که نشان دهنده احوال دنیایی است و در عوض، در دنیای معنایی و بهشت، معانی واقعی و آرمان‌ها وجود دارد."],[653,"ای ضیاء الحق حسام الدین در آر","این سر خر را در آن بطیخ‌زار","ای نور حقیقت، حسام‌الدین، در این باغ خیار، سر آن خر (رمز و نماد) را به تصویر بکش."],[653,"تا سر خر چون بمرد از مسلخه","نشو دیگر بخشدش آن مطبخه","وقتی سر خر از کشتارگاه می‌میرد، دیگر نمی‌تواند از آن آشپزخانه (مطبخه) به او چیزی بدهند."],[653,"هین ز ما صورت‌گری و جان ز تو","نه غلط هم این خود و هم آن ز تو","ای انسان، تو فقط صورت‌ساز هستی و جان و روح تو از جانب خداست. بنابراین نه تنها این صورت، بلکه خود تو هم از خدا نشأت می‌گیرد و هیچ غلطی در این حقیقت وجود ندارد."],[653,"بر فلک محمودی ای خورشید فاش","بر زمین هم تا ابد محمود باش","ای خورشید روشن بر آسمان محمودی (نام نیکی که به پیامبر اسلام اطلاق شده است)، بر زمین نیز تا همیشه نیکو و بزرگباش."],[653,"تا زمینی با سمایی بلند","یک‌دل و یک‌قبله و یک‌خو شوند","چگونه می‌توان دو وجود متفاوت، یکی زمینی و دیگری آسمانی، را به یکدیگر نزدیک کرد تا به یک دل، یک سمت و یک روح تبدیل شوند؟"],[653,"تفرقه برخیزد و شرک و دوی","وحدتست اندر وجود معنوی","اختلاف و تفرقه از بین می‌رود و شرک و دوئی وجود ندارد؛ تمامیت و وحدت در وجود معنوی حاکم است."],[653,"چون شناسد جان من جان ترا","یاد آرند اتحاد ماجری","وقتی جان من تو را شناسایی کند، آن‌گاه اتحاد ما را به یاد می‌آورد."],[653,"موسی و هارون شوند اندر زمین","مختلط خوش هم‌چو شیر و انگبین","موسی و هارون که دو پیامبر هستند، در زمین به هم می‌پیوندند و مانند شیر و عسل، بسیار شیرین و دلپذیر به نظر می‌رسند."],[653,"چون شناسد اندک و منکر شود","منکری‌اش پرده ساتر شود","اگر کسی چیزهای جزئی را بشناسد و منکر شود، آن انکارش باعث می‌شود که چیزهایی که نمی‌خواهد آنها را ببیند، از نظرش مخفی شوند."],[653,"پس شناسایی بگردانید رو","خشم کرد آن مه ز ناشکری او","ناشکری پیامبر موجب خشم جبرئیل شد و او به خاطر این عدم شکرگزاری، چهره‌اش را تغییر داد و به صورت دیگری درآمد."],[653,"زین سبب جان نبی را جان بد","ناشناسا گشت و پشت پای زد","به همین دلیل، جان پیامبر (محمد صلی‌الله علیه و سلّم) از ترس و ناامیدی دچار نگرانی و پریشانی شده و احساس کرد پایش را به ناخواسته به سمت عقب برده است."],[653,"این همه خواندی فرو خوان لم یکن","تا بدانی لج این گبر کهن","اینکه تو این همه خوانده‌ای، فقط برای آن بوده که بفهمی چرا آن کافر قدیمی، لجاجت می‌کند و تسلیم نمی‌شود."],[653,"پیش از آنک نقش احمد فر نمود","نعت او هر گبر را تعویذ بود","پیش از آنکه تصویر پیامبر احمد (ص) ظاهر شود، هر گبر (کافر زرتشتی) او را چون تعویذی می‌دانست و به او احترام می‌گذارد."],[653,"کین چنین کس هست تا آید پدید","از خیال روش دلشان می‌طپید","این بیت بیان می‌کند که وقتی آن شخصیت بزرگ (مصطفی صلی‌الله علیه و سلم) به نمایش درمی‌آید و حقیقتش آشکار می‌شود، دل‌های مردم از شوق و هیجان به تپش در می‌آید."],[653,"سجده می‌کردند کای رب بشر","در عیان آریش هر چه زودتر","مردم سجده می‌کردند و با صدای بلند از خدایی که پروردگار انسان‌هاست، می‌خواستند که هرچه زودتر خود را به‌طور عیان نشان دهد."],[653,"تا به نام احمد از یستفتحون","یاغیانشان می‌شدندی سرنگون","به خاطر نام احمد (پیامبر اسلام)، یاغیان و ستم‌گران شکست می‌خوردند و بر سرنگونی آن‌ها فتوحات و پیروزی‌ها رقم می‌خورد."],[653,"هر کجا حرب مهولی آمدی","غوثشان کراری احمد بدی","هرجا که دشمنی یا خطری پیش آمد، نجات‌دهنده و یاور مهربان، احمد (پیامبر) به یاری آن‌ها آمد."],[653,"هر کجا بیماری مزمن بدی","یاد اوشان داروی شافی شدی","هر جا که بیماری مزمن و سختی وجود داشت، یاد و نام او (حضرت محمد صلی‌الله علیه و سلم) شفا بخش و درمان کننده‌ای بود."],[653,"نقش او می‌گشت اندر راهشان","در دل و در گوش و در افواهشان","نقش او در دل و گوش و گفتار آن‌ها در حال تردد بود و همه جا حضور داشت."],[653,"نقش او را کی بیابد هر شعال","بلک فرع نقش او یعنی خیال","هیچ‌کس نمی‌تواند حقیقت نقش و تصویر او را درک کند، زیرا آنچه درک می‌شود تنها خیال و سایه‌ای از آن نقش است، نه خود او."],[653,"نقش او بر روی دیوار ار فتد","از دل دیوار خون دل چکد","اگر نقش او (یعنی ذات خدا یا پیامبر) بر دیوار بیفتد، از دل دیوار خون دل (اشک و غم) می‌چکد. به بیان دیگر، ظهور حقیقی او موجب غم و اندوه عمیق در دل‌ها می‌شود."],[653,"آنچنان فرخ بود نقشش برو","که رهد در حال دیوار از دو رو","نقش او (جبرئیل) بر دیوار به قدری زیبا و دل‌انگیز است که به خاطر آن، حال دیوار از دو طرف تغییر می‌کند و مثل این است که از دو سو رهایی پیدا کرده است."],[653,"گشته با یک‌رویی اهل صفا","آن دورویی عیب مر دیوار را","با ظهور یک‌رویی جبرئیل (که نماد صفا و پاکی است)، اهل صفا و پاکی نیز در این حال به دورویی و نفاق خود پی می‌برند و عیب دورویی را می‌بینند، مانند دیواری که از دو سمت نمایان می‌شود."],[653,"این همه تعظیم و تفخیم و وداد","چون بدیدندش به صورت برد باد","همه احترام و بزرگ‌داشت و نعمت‌هایی که به جبرئیل علیه‌السلام عرضه شده بود، وقتی او را در صورت انسانی دیدند، مانند باد همه‌چیز را از یاد بردند."],[653,"قلب آتش دید و در دم شد سیاه","قلب را در قلب کی بودست راه","قلب آتش را دید و به سرعت سیاه شد؛ زیرا هیچ‌گاه در دل، جایی برای آتش و حسرت وجود نداشته است."],[653,"قلب می‌زد لاف اشواق محک","تا مریدان را دراندازد به شک","دل با هیجان و شور عشق، به خود می‌بازد و ادعا می‌کند که می‌تواند شوق و محبت را بیافریند، تا مریدان را به تردید و شک بیفکند."],[653,"افتد اندر دام مکرش ناکسی","این گمان سر بر زند از هر خسی","هیچ‌کس گمان نکند که دامی که او (مریدان) برای دیگران می‌تند، به خودش خسارتی خواهد زد. یعنی آدم‌های پست‌تر به او فکر نمی‌کنند و در دام او گرفتار نمی‌شوند."],[653,"کین اگر نه نقد پاکیزه بدی","کی به سنگ امتحان راغب شدی","اگر این چیزی که تو به عنوان اصل و حقیقت در نظر داری، چیز پاکیزه و ناب نیست، چگونه به سنگ آزمایش تمایل پیدا کردی؟"],[653,"او محک می‌خواهد اما آنچنان","که نگردد قلبی او زان عیان","او به آزمایش و محک زدن نیاز دارد، اما به شرطی که دل او از آن حقیقت و عیان نشود."],[653,"آن محک که او نهان دارد صفت","نی محک باشد نه نور معرفت","محکّی که او در دل خود دارد، ویژگی‌ها و نشانه‌های خاصی را در خود نهفته دارد؛ نه این‌که فقط به عنوان یک وسیله سنجش باشد، بلکه خود معرفتی را به همراه دارد که در مورد حقیقت و آگاهی از روشنایی‌هاست."],[653,"آینه کو عیب رو دارد نهان","از برای خاطر هر قلتبان","آینه‌ای که عیب چهره را نشان می‌دهد، به خاطر وجود هر عیب و نقصی در خود، از نظر دیگران پنهان است."],[653,"آینه نبود منافق باشد او","این چنین آیینه تا تانی مجو","آینه‌ راستین نمی‌تواند منافق باشد، بنابراین این‌گونه آینه‌ای که با نشان‌دادن عیب‌ها به زشتی‌ها نیازی ندارد، وجود ندارد."],[654,"شه حسام‌الدین که نور انجمست","طالب آغاز سفر پنجمست","شه حسام‌الدین که درخشش او همچون ستاره‌هاست، شروع سفر پنجم مثنوی را طلب می‌کند."],[654,"این ضیاء الحق حسام الدین راد","اوستادان صفا را اوستاد","این نور حقیقت، حسام‌الدین راد است که استادان پاکی و صفا را به او نسبت داده‌اند."],[654,"گر نبودی خلق محجوب و کثیف","ور نبودی حلقها تنگ و ضعیف","اگر مردم دچار حجاب و ناپاکی نبودند و اگر حلقه‌های محدودکننده و ضعیف وجود نداشت، اوضاع به شکل دیگری می‌بود."],[654,"در مدیحت داد معنی دادمی","غیر این منطق لبی بگشادمی","در ستایش تو، معنای عمیق و حقیقی را می‌گویم و غیر از این، سخنانی با زبان گویا و دل‌نشین می‌زنم."],[654,"لیک لقمه باز آن صعوه نیست","چاره اکنون آب و روغن کردنیست","اما لقمه آماده و مناسب برای گنجشک نیست، و اکنون باید کاری کرد و ترکیب آب و روغن را انجام داد."],[654,"مدح تو حیفست با زندانیان","گویم اندر مجمع روحانیان","مدح و ستایش تو برای من نادرست و بی‌مورد است که من آن را با گروه زندانیان بگویم؛ زیرا تو در میان کسانی که در جمع روحانیان و افراد والا هستی، مقام و شأن بالاتری داری."],[654,"شرح تو غبنست با اهل جهان","هم‌چو راز عشق دارم در نهان","توضیح و بیان ویژگی‌های تو در کنار انسان‌های عادی بی‌فایده است، چون مانند عشق که در دل مخفی است، عمق و اسرار آن چیزی فراتر از بیان و توضیح است."],[654,"مدح تعریف‌ست و تخریق حجاب","فارغست از شرح و تعریف آفتاب","تعریف یا ستایش به معنای مدح است و توصیف حقیقت همواره از پشت پرده یا حجاب انجام می‌شود و نمی‌توان آفتاب را با کلمات و توصیفات به‌طور کامل نمایان ساخت."],[654,"مادح خورشید مداح خودست","که دو چشمم روشن و نامرمدست","مدح‌کننده خورشید در واقع به خود مدح می‌کند، زیرا بینایی دو چشمم روشن و بی‌عیب نیست."],[654,"ذم خورشید جهان ذم خودست","که دو چشمم کور و تاریک و بد است","نقد و سرزنش خورشید در واقع انتقاد از خود انسان است، زیرا چشم‌های من کور و تاریک و ناپاک هستند."],[654,"تو ببخشا بر کسی کاندر جهان","شد حسود آفتاب کامران","ای خدا، بر کسی که در این دنیا حسود بوده و مانند آفتاب خوشبخت است، ببخش."],[654,"تواندش پوشید هیچ از دیده‌ها؟","وز طراوت دادن پوسیده‌ها؟","آیا ممکن است او چیزی از دیده‌ها پنهان کند؟ و آیا می‌تواند تا آنجا طراوت ببخشد که حتی چیزهای پوسیده را زنده کند؟"],[654,"یا ز نور بی‌حدش توانند کاست","یا به دفع جاه او توانند خاست","یا با نور بی‌پایان خداوند می‌توانند کم کردند، یا با دور کردن او می‌توانند به مقام و عنوان دست یابند."],[654,"هر کسی کو حاسد کیهان بود","آن حسد خود مرگ جاویدان بود","هر کسی که به کیهان و جهانیان حسد بورزد، حسادت او برایش باعث مرگ همیشگی می‌شود."],[654,"قدر تو بگذشت از درک عقول","عقل اندر شرح تو شد بوالفضول","عقل انسان از درک و فهم مقام و ارزش تو عاجز است و هرچه درباره‌ی تو بگوید، فقط به هذیان و بی‌اساس می‌انجامد."],[654,"گرچه عاجز آمد این عقل از بیان","عاجزانه جنبشی باید در آن","هرچند عقل در بیان موضوعات ناتوان است و نمی‌تواند به‌خوبی تو را توصیف کند، اما باید حرکتی انجام شود تا کوشش و تلاش بیشتری صورت گیرد."],[654,"ان شیئا کله لا یدرک","اعلموا ان کله لا یترک","هر چیزی را که نمی‌توان شناخت، بدانید که هیچ‌چیز نمی‌تواند بدون شناخت رها شود."],[654,"گر نتانی خورد طوفان سحاب","کی توان کردن بترک خورد آب","اگر نتوانی در برابر طوفان باران مقاومت کنی، چگونه می‌خواهی به این آب آسیب بزنی یا آن را بشکنی؟"],[654,"راز را گر می‌نیاری در میان","درکها را تازه کن از قشر آن","اگر نتوانی راز را درک کنی، باید درک خود را با تجدید نظر تازه کنی و از ظواهر و سطحی‌نگری (قشر) فراتر بروی."],[654,"نطقها نسبت به تو قشرست لیک","پیش دیگر فهمها مغزست نیک","سخنان و گفتارها نسبت به تو سطحی و ظاهری هستند، اما در میان فهم‌های دیگر، حقیقت و عمق را به خوبی درک می‌کنند."],[654,"آسمان نسبت به عرش آمد فرود","ورنه بس عالیست سوی خاک‌تود","آسمان نسبت به عرش (مقام خداوند) پایین‌تر است، زیرا خداوند به اندازه‌ای بلند مرتبه و عالی است که به زمین (خاک) نزدیک نمی‌شود."],[654,"من بگویم وصف تو تا ره برند","پیش از آن کز فوت آن حسرت خورند","من می‌خواهم وصف و ویژگی‌های تو را بگویم تا دیگران پیش از آنکه از دست رفتن تو افسوس بخورند، به تو نزدیک شوند."],[654,"نور حقی و به حق جذاب جان","خلق در ظلمات وهم‌اند و گمان","نور حقی که در واقعیت وجود دارد، جان‌های مخلوق را به خود جذب می‌کند، اما در تاریکی‌های وهم و تصورات نادرست، این نور برایشان پنهان و غیرقابل درک است."],[654,"شرط تعظیمست تا این نور خوش","گردد این بی‌دیدگان را سرمه‌کش","برای این‌که این نور زیبا و حقیقی جلوه کند، باید شرط بزرگداشت و احترام به آن رعایت شود؛ زیرا این نور برای کسانی که بینا نیستند و در جهل به سر می‌برند، تجلی نمی‌یابد."],[654,"نور یابد مستعد تیزگوش","کو نباشد عاشق ظلمت چو موش","کس نمی‌تواند به درک و حقیقت نور برسد، مگر اینکه گوش و جانش برای پذیرش آن آماده باشد. کسی که به سراغ تاریکی می‌رود و عاشق آن است، مانند موش در تاریکی زندگی می‌کند و از روشنی دور است."],[654,"سست‌چشمانی که شب جولان کنند","کی طواف مشعله ایمان کنند","چشم‌های ضعیف و کاهل که در تاریکی شب سرگرم به کارهای بیهوده هستند، چگونه می‌توانند به دور مشعل ایمان بچرخند و به آن نزدیک شوند؟"],[654,"نکته‌های مشکل باریک شد","بند طبعی که ز دین تاریک شد","نکته‌های پیچیده و دشوار به آرامی و کم‌کم روشن می‌شوند، اما وقتی روح (طبع) انسان از دین و ایمان بی‌بهره و تاریک باشد، این کار سخت‌تر می‌شود."],[654,"تا بر آراید هنر را تار و پود","چشم در خورشید نتواند گشود","برای اینکه هنر به ظهور برسد و خود را نشان دهد، چشم نمی‌تواند به خورشید نگاه کند و آن را ببیند."],[654,"هم‌چو نخلی برنیارد شاخها","کرده موشانه زمین سوراخها","انسان مانند درخت نخلی که شاخ و برگ‌هایش را بالا نمی‌آورد، با خضوع و humildity در زمین خویش را حفر می‌کند."],[654,"چار وصفست این بشر را دل‌فشار","چارمیخ عقل گشته این چهار","انسان چهار ویژگی دارد که دلش را فشار می‌دهد و آن چهار مورد عبارتند از: عقل که کم عقل شده و مانند میخی به او فشار می‌آورد."],[655,"تو خلیل وقتی ای خورشیدهش","این چهار اطیار ره‌زن را بکش","تو ای خورشید فهم مانند ابراهیم که از آتش نجات یافت این چهار مرغ سرکش را سر ببر"],[655,"زانک هر مرغی ازینها زاغ‌وش","هست عقل عاقلان را دیده‌کش","زاغ وقتي بالاي سر مرداري مي رسد، ابتدا چشمهايش را در مي آورد، مولانا مي فرمايد اين چهار خصلت ناپسند نيز مانند زاغ عقل انسان را از او بيرون مي کشند و او را تباه مي سازند (کوري معنوي)"],[655,"چار وصف تن چو مرغان خلیل","بسمل ایشان دهد جان را سبیل","مثل حضرت ابراهیم که آن چهار مرغ را سر برید،سر بریدن این چهار مرغ جان را به سوی حقیقت راهی میکند"],[655,"ای خلیل، اندر خلاص نیک و بد","سر ببرشان تا رهد پاها ز سد","ای خلیل (ابراهیم)، در رهایی از نیک و بد، این چهار وصف (چیزی که به تن انسان مربوط است) را بکش تا پاها از مانع‌ها آزاد شوند."],[655,"کل توی و جملگان اجزای تو","بر گشا که هست پاشان پای تو","همه تویی و هرچه هست برای توست، زیرا همه آن‌ها تحت تأثیر وجود تو هستند."],[655,"از تو عالم روح زاری می‌شود","پشت صد لشکر سواری می‌شود","از تو، که عالم روح است، ناله و زاری به‌پا می‌شود و این زاری مانند پشت هزاران سواری می‌شود."],[655,"زانک این تن شد مقام چار خو","نامشان شد چار مرغ فتنه‌جو","زیرا این بدن جایگاه آن چهار خوی حیوانی است و نامشان به چهار مرغ فتنه تبدیل شده است."],[655,"خلق را گر زندگی خواهی ابد","سر ببر زین چار مرغ شوم بد","اگر می‌خواهی برای مخلوقات، زندگی جاودانی فراهم کنی، باید سر این چهار مرغ پلید را از تن خود ببری."],[655,"بازشان زنده کن از نوعی دگر","که نباشد بعد از آن زیشان ضرر","آن‌ها را به زندگی جدیدی برگردان که بعد از آن ضرری به تو نرسانند"],[655,"چار مرغ معنوی راه‌زن","کرده‌اند اندر دل خلقان وطن","چهار خلق و خوی فتنه گر در دل خلق وطن کرده و راه را برایشان سد کرده است"],[655,"چون امیر جمله دلهای سوی","اندرین دور ای خلیفه حق توی","دل‌های سوی = دل‌های راست و درست و پاک."],[655,"سر ببر این چار مرغ زنده را","سر مدی کن خلق ناپاینده را","این بیت به امیر اشاره دارد و می‌گوید که می‌تواند با سر بریدن (تنبیه یا اصلاح) این چهار مرغ زنده، به صورت نمادین، ویژگی‌های ناپایدار و زودگذر انسان‌ها را اصلاح کند. این چهار مرغ به نوعی نماد چهار خلق انسانی هستند که باید به روشی تغییر یابند."],[655,"بط و طاوسست و زاغست و خروس","این مثال چار خلق اندر نفوس","بط، طاوس، زاغ و خروس نماد چهار خصلت در درون انسان‌ها هستند. این چهار خلق یا صفت، بیانگر جنبه‌های مختلف شخصیت و روحیات انسان‌هاست."],[655,"بط، حرصست و خروس آن شهوتست","جاه چون طاوس و زاغ امنیتست","بط نماد حرص و طمع است و خروس نمایانگر شهوت و آرزوهای نفسانی است. طاوس جاه و مقام و زاغ امنیت و زندگی طولانی است"],[655,"منیتش آن که بود اومیدساز","طامع تأبید یا عمر دراز","طامع تابيد: آزمند عمر ابدي"],[655,"بط حرص آمد که نوکش در زمین","در تر و در خشک می‌جوید دفین","بط به خاطر طمع و حرص خود در زمین، چه در حالت مرطوب و چه در حالت خشک، به دنبال چیزهای خوردنی میگردد"],[655,"یک زمان نبود معطل آن گلو","نشنود از حکم جز امر کلوا","حتي يک لحظه هم گلوي اردک استراحت نمي کند و مدام در حال خوردن است، انگار که از دستورات فقط امر خوردن را شنيده است."],[655,"هم‌چو یغماجیست، خانه می‌کند","زود زود انبان خود پر می‌کند","مانند غارتگری که خانه هارا غارت میکند و کیسه خود را پر میکند"],[655,"اندر انبان می‌فشارد نیک و بد","دانه‌های در و حبات نخود","و در کیسه خود هر چیز بدرد بخور و آشغالی را جمع میکند"],[655,"تا مبادا یاغیی آید دگر","می‌فشارد در جوال او خشک و تر","تا اینکه مبادا دیگر کسی پیدا شود و زود تر از او آن ها را بخورد.هر چیزی را از آن خود میکند"],[655,"وقت تنگ و فرصت اندک، او مخوف","در بغل زد هر چه زودتر بی‌وقوف","که وقت بسیار کمی دارد و ترس دارد که نتواند همه آن ها را بدست آورد و بی وقفه در حال خوردن است"],[655,"لیک مؤمن ز اعتماد آن حیات","می‌کند غارت به مهل و با انات","اما مؤمن به خاطر اعتمادش به حیات ابدی با آرامش و حوصله به کارها می‌پردازد."],[655,"آمنست از فوت و از یاغی که او","می‌شناسد قهر شه را بر عدو","مؤمن از خطر فوت و از یاغی‌ها که افراد سرکش هستند در امان است، چرا که او قهر و خشم پادشاه را در برابر دشمنان می‌شناسد و از آن آگاه است."],[655,"آمنست از خواجه‌تاشان دگر","که بیایندش مزاحم صرفه‌بر","او از خواجه‌تاشان (درباریان) دیگر احساس امنیّت می‌کند، چرا که آن‌ها نمی‌خواهند به منافع او آسیب برسانند و مزاحمش شوند."],[655,"عدل شه را دید در ضبط حشم","که نیارد کرد کس بر کس ستم","عدالت شاه را در کنترل و اداره ی سپاهش می‌بینم که هیچ‌کس را بر دیگری ستم نمی‌کند."],[655,"لاجرم نشتابد و ساکن بود","از فوات حظ خود آمن بود","او (عدل شه) به هیچ وجه حرکت نمی‌کند و ساکن خواهد بود، زیرا از دست دادن سهم خود را نمی‌پذیرد و از آن می‌ترسد."],[655,"بس تانی دارد و صبر و شکیب","چشم‌سیر و مؤثرست و پاک‌جیب","مؤثر: ايثارگر"],[655,"کین تانی پرتو رحمان بود","وان شتاب از هزه شیطان بود","صبر و آرامش حاصل از رحمت خداوند است، در حالی که شتاب و عجله به دلیل وسوسه‌های شیطان به وجود می‌آید."],[655,"زانک شیطانش بترساند ز فقر","بارگیر صبر را بکشد به عقر","چون شیطان انسان را از فقر می‌ترساند، صبر او را به جایی می‌کشاند که او را در تنگنا قرار دهد و ناامید کند."],[655,"از نبی بشنو که شیطان در وعید","می‌کند تهدیدت از فقر شدید","از نبی (پیامبر) بشنو که شیطان با تهدید از فقر شدیدی به تو هشدار می‌دهد."],[655,"تا خوری زشت و بری زشت و شتاب","نی مروت نی‌تانی نی ثواب","اگر بدی کنی و زشت باشی، نتیجه‌اش زشت‌تر خواهد بود و راه نیکوکاری و جوانمردی را نرو؛ در این صورت نه پاداشی خواهی داشت و نه اجر و ثواب."],[655,"لاجرم کافر خورد در هفت بطن","دین و دل باریک و لاغر، زفت بطن","بدون شک کافری که در هفت شکم غذا می‌خورد، دین و دلش تنگ و لاغر می‌شود و به دلیلی که وصفش کردیم، به دنبال پرخوری است."],[656,"کافران مهمان پیغمبر شدند","وقت شام، ایشان به مسجد آمدند","کافران به میهمانی پیامبر آمدند و در هنگام شام به مسجد رفتند."],[656,"که آمدیم ای شاه ما اینجا قنق","ای تو مهمان‌دار سکان افق","ما به مهمانی تو، ای شاه بزرگ، آمده‌ایم تا اینجا که بهشت را به زیر قنق (سقف) خود گرفته‌ای، و تو میزبان ما هستی."],[656,"بی‌نواییم و رسیده ما ز دور","هین بیفشان بر سر ما فضل و نور","ما در وضعیت فقر و تهیدستی به سر می‌بریم و از دور دستاورد فضیلتی به ما رسیده‌است؛ پس ای پروردگار، رحمت و برکات خود را بر سر ما بریز."],[656,"گفت ای یاران من قسمت کنید","که شما پر از من و خوی منید","ای دوستان، بگویید که این مال و نعمت را میان خودتان تقسیم کنید، زیرا شما نیز از من و ویژگی‌های من سرشار هستید."],[656,"پر بود اجسام هر لشکر ز شاه","زان زنندی تیغ بر اعدای جاه","اجساد هر لشکری به سبب وجود شاه (پادشاه) جان می‌گیرد و در برابر دشمنان جهاد می‌کند."],[656,"تو به خشم شه زنی آن تیغ را","ورنه بر اخوان چه خشم آید ترا","اگر تو به خاطر خشم شاه، آن تیغ را به بقیه می‌زنی، پس چه نیازی به خشم بر برادران خود داری؟"],[656,"بر برادر، بی‌گناهی می‌زنی","عکس خشم شاه، گرز ده‌منی","تو به برادرت بی‌دلیل خشم می‌کنی و به او ظلم می‌کنی، در حالی که باید به جای خشم، برادرانه رفتار کنی و تاوان گناهی که نکرده را به دوش او نگذاری."],[656,"شه یکی جانست و لشکر پر ازو","روح چون آبست واین اجسام جو","شاه یک وجود واحد است و لشکر او همچون روحی است که در اجسام (انسان‌ها) وجود دارد، مانند آب که در جویبارها جاری است."],[656,"آب روح شاه اگر شیرین بود","جمله جوها پر ز آب خوش شود","اگر روح و جان شاه (خداوند) شیرین و پاک باشد، همه موجودات زیر سلطه‌اش از آن سرشار خواهند شد و خوش حال خواهند بود."],[656,"که رعیت، دین شه دارند و بس","این چنین فرمود سلطان عبس","اهل تسنن معتقد هستند که سوره عبس درباره ی پیامبر(ص) نازل شده است، پس سلطان عبس یعنی حضرت محمد(ص)، البته شیعیان در تفاسیر خود گفته اند که این سوره درمورد پیامبر نیست."],[656,"هر یکی یاری یکی مهمان گزید","در میان، یک زفت بود و بی‌ندید","بی ندید: بی همتا (آن شخص از فربهی و تنومندی نظیر نداشت)"],[656,"جسم ضخمی داشت کس او را نبرد","ماند در مسجد چو اندر جام درد","شخصی جسمی بزرگ و سنگین داشت که کسی نتوانست او را از مسجد خارج کند؛ او همان‌طور که در حال نشسته بود، داخل ظرفی پر از شراب (درد) باقی ماند."],[656,"مصطفی بردش چو وا ماند از همه","هفت بز بد شیرده اندر رمه","حضرت محمد(ص) او را به خاطر اینکه هفت بز شیرده در گله داشت و بعد از آنکه دیگران زودتر رفتند، بازنگه‌داشت."],[656,"که مقیم خانه بودندی بزان","بهر دوشیدن برای وقت خوان","آن‌هایی که در خانه بودند، برای دوشیدن شیر از بزها به آنجا رفته بودند تا از آن شیر در وقت غذا استفاده کنند."],[656,"نان و آش و شیر آن هر هفت بز","خورد آن بوقحط عوج ابن عز","در دفتر دوم، قصه ی مریض و عیادت پیامبر، نام عوج بن انب که پادشاه باشان (شمال رود اردن) بود، آمده است. وی اجازه ورود بنی اسرائیل را به کشورش نداد و در نهایت در جنوب سوریه از بنی اسرائیل شکست خورد. گفته شده که این شخص بسیار درشت هیکل و تنومند بوده و در اینجا مولانا آن کافر را به این شخص تشبیه می کند."],[656,"جمله اهل بیت خشم‌آلو شدند","که همه در شیر بز طامع بدند","اهل بیت به شدت عصبانی شدند؛ زیرا همه به شیر بز اشتیاق و طمع نشان دادند."],[656,"معده طبلی‌خوار هم‌چون طبل کرد","قسم هجده آدمی تنها بخورد","معده کسی که به مانند طبل می‌خورد، به اندازه هجده نفر جا دارد، اما او تنها به خود می‌پردازد و بقیه را نادیده می‌گیرد."],[656,"وقت خفتن رفت و در حجره نشست","پس کنیزک از غضب در را ببست","در زمان خواب، او (ملا) به اتاق خود رفت و کنیزک به خاطر خشم، در را بست."],[656,"از برون زنجیر در را در فکند","که ازو بد خشمگین و دردمند","کنیزک که از خشم و درد شکم ناراحت است، از بیرون زنجیر در را به داخل می‌اندازد و در این حالت، به شدت عصبانی و دچار درد است."],[656,"گبر را در نیم‌شب یا صبحدم","چون تقاضا آمد و درد شکم","گبر (یعنی کسی از پیروان دین زرتشتی) در نیمه شب یا صبح زود، وقتی که از او درخواست می‌شود و به درد شکم دچار است، اقدام می‌کند."],[656,"از فراش خویش سوی در شتافت","دست بر در چون نهاد او، بسته یافت","او (فراش) از خدمتکاران خانه‌اش به سمت در دوید، اما وقتی دستش را به در گذاشت، متوجه شد که در بسته است."],[656,"در گشادن حیله کرد آن حیله‌ساز","نوع نوع و خود نشد آن بند باز","حیله‌گر به شیوه‌های مختلف تلاش کرد تا در را باز کند، اما در نهایت خود او نتوانست آن بند را باز کند."],[656,"شد تقاضا بر تقاضا، خانه تنگ","ماند او حیران و بی‌درمان و دنگ","دنگ: گیج و مات"],[656,"حیله کرد او و به خواب اندر خزید","خویشتن در خواب در ویرانه دید","او به بهانه‌ای نقشه‌ای کشید و در خواب پنهان شد و خود را در آن ویرانه، جایی که قبلا دیده بود، مشاهده کرد."],[656,"زانک ویرانه بد اندر خاطرش","شد به خواب اندر همانجا منظرش","ویرانه در خواب او در ذهنش ماند و تصویر آنجا را در خوابش مشاهده کرد."],[656,"خویش در ویرانه خالی چو دید","او چنان محتاج، اندر دم برید","وقتی او خود را در ویرانه خالی دید و احساس کرد که به شدت نیازمند است، در همان لحظه ناگهان نفسش را حبس کرد."],[656,"گشت بیدار و بدید آن جامه خواب","پر حدث دیوانه شد از اضطراب","او بیدار شد و دید که لباس خوابش پر از اوهام و خیال‌های بی‌پایه است، به خاطر این بینش، به شدت مضطرب و دیوانه‌وار شده است."],[656,"ز اندرون او برآمد صد خروش","زین چنین رسوایی بی خاک‌پوش","از دل او صدای بلندی برخاست که به خاطر این رسوایی که هیچ پوششی ندارد، بسیار ناراحت و آشفته است."],[656,"گفت خوابم بتر از بیداریم","که خورم این سو و آن سو می‌ریم","شخصی می‌گوید که خوابش از بیداری‌اش بدتر است، زیرا در خواب نمی‌تواند به خوبی غذا بخورد و هر بار که می‌خورد، غذا به اطرافش پراکنده می‌شود."],[656,"بانگ می‌زد وا ثبورا وا ثبور","هم‌چنانک کافر اندر قعر گور","در آیات 10 و 11 سوره انشقاق آمده: هنگامی که نامه اعمال شخص را از پشت سرش به او می دهند بانگ واویلایش بلند می شود، مانند کافر که از اعماق گور فریاد میکشد، این شخص نیز اینچنین حالی داشت."],[656,"منتظر که کی شود این شب به سر","یا برآید در گشادن بانگ در","شخصی در انتظار است که این شب تاریک به پایان برسد و یا این‌که صدای در به گوشش برسد، یعنی منتظر خبری یا تغییری است که او را از این وضعیت نجات دهد."],[656,"تا گریزد او چو تیری از کمان","تا نبیند هیچ کس او را چنان","او به سرعت فرار می‌کند، مانند تیری که از کمان رها می‌شود، تا اینکه هیچ‌کس او را بی‌جهت نبیند و نتواند او را شناسایی کند."],[656,"قصه بسیارست کوته می‌کنم","باز شد آن در، رهید از درد و غم","قصه‌ها بسیارند، اما من مختصر می‌گویم که او از درد و غم رهایی یافت و در باز شد."],[657,"مصطفی صبح آمد و در را گشاد","صبح آن گمراه را او راه داد","پیامبر (مصطفی) در صبح زود در را باز کرد و به گمراه (کسی که در مسیر اشتباه است) اجازه داد وارد شود."],[657,"در گشاد و گشت پنهان مصطفی","تا نگردد شرمسار آن مبتلا","پیامبر مصطفی در را گشود و خود را پنهان کرد تا آن شخص گمراه خجالت نکشد و شرمنده نشود."],[657,"تا برون آید رود گستاخ او","تا نبیند درگشا را پشت و رو","او به دلیل آنکه مبادا مهمان گستاخ، پشت و روی گشاینده را ببیند، خود را پنهان کرده تا او از جایی که به آن وارد شده خارج شود."],[657,"یا نهان شد در پس چیزی و یا","از ویش پوشید دامان خدا","یا خود را در پشت چیزی پنهان کرد و یا دامان خدا را از چشمانش پوشاند."],[657,"صبغة الله گاه پوشیده کند","پرده بی‌چون بر آن ناظر تند","خداوند گاهی به گونه‌ای می‌تواند خود را پنهان کند که هیچ شک و شبهه‌ای در وجودش وجود نداشته باشد، و این امر باعث می‌شود که ناظر، قدرت و عظمت خدا را نبیند و از درک آن عاجز بماند."],[657,"تا نبیند خصم را پهلوی خویش","قدرت یزدان از آن بیشست بیش","خداوند، قدرت و توانایی‌اش را از خصم پنهان کرده است تا دشمن نتواند او را در کنار خود ببیند و از این قدرت آگاه شود."],[657,"مصطفی می‌دید احوال شبش","لیک مانع بود فرمان ربش","پیامبر(ص) از احوال شبی که بر آن کافر گذشت، مطلع بود ولیکن به فرمان خداوند اجازه نداشت کاری انجام بدهد."],[657,"تا که پیش از خبط بگشاید رهی","تا نیفتد زان فضیحت در چهی","تا اینکه پیش از این که به خطا بیفتد، راهی را باز کند، تا از آن رسوایی و شرمندگی در دچار نشود."],[657,"لیک حکمت بود و امر آسمان","تا ببیند خویشتن را او چنان","اما این موضوع به خاطر حکمت و فرمان الهی بود که او (مصطفی علیه‌السلام) خودش را به‌گونه‌ای ببیند که شایسته است؛ یعنی به همان حالتی که باید."],[657,"بس عداوتها که آن یاری بود","بس خرابیها که معماری بود","آیه 216 سوره بقره: وعسى أن تکرهوا شيئا وهو خير لکم؛ چه بسا چیزی را خوش ندارید و آن برای شما خیر است."],[657,"جامه خواب پر حدث را یک فضول","قاصدا آورد در پیش رسول","یک فرد بی‌مناسبت (فضول) لباس خواب ناپاک و آلوده‌ای را به نزد پیامبر (رسول) آورد."],[657,"که چنین کرده‌ست مهمانت ببین","خنده‌ای زد رحمة للعالمین","این بیت اشاره دارد که پیامبر اسلام، محمد (رحمة للعالمین) با نرمی و رحمت به مهمانی که فضولی کرده، نگاهی کرده و خنده‌ای به او می‌زند، گویا با این عمل می‌خواهد او را از خجالت درآورد و به او بفهماند که کارش ناپسند است."],[657,"که بیار آن مطهره اینجا به پیش","تا بشویم جمله را با دست خویش","مردم را به آوردن نذری (مظروف) دعوت می‌کند تا با دست خودشان آن را پاک کنند و به نوعی مراسم را برگزار کنند."],[657,"هر کسی می‌جست کز بهر خدا","جان ما و جسم ما قربان ترا","هر کسی به‌خاطر خدا، جان و جسم خود را فدای تو می‌کند."],[657,"ما بشوییم این حدث را تو بهل","کار دستست این نمط نه کار دل","ما باید این اتفاق را پاک کنیم و تو کار را به دست بگیری، این شکل و روش، کار دل نیست و به قلب نیا‌ید."],[657,"ای لعمرک مر ترا حق عمر خواند","پس خلیفه کرد و بر کرسی نشاند","خداوند در قرآن فقط و فقط به جان یک نفر سوگند خورده است و آن پیامبر(ص) است (آیه 72 سوره حجر)"],[657,"ما برای خدمت تو می‌زییم","چون تو خدمت می‌کنی پس ما چه‌ایم","ما برای خدمت به تو زندگی می‌کنیم و چون تو به ما خدمت می‌کنی، پس ما چه کسی هستیم؟"],[657,"گفت آن دانم و لیک این ساعتیست","که درین شستن به خویشم حکمتیست","پیامبر گفت: من این را میدانم، اما اکنون زمانی است که در این شست‌وشو (پاک شدن) از خودم، حکمتی وجود دارد."],[657,"منتظر بودند کاین قول نبیست","تا پدید آید که این اسرار چیست","منتظر بودند که این سخن نبی (حضرت محمد) آشکار شود تا معلوم شود این رازها چه هستند."],[657,"او به جد می‌شست آن احداث را","خاص ز امر حق نه تقلید و ریا","او با جدیت و خلوص نیت، کارها و بنای خود را بر اساس حقیقت و امر الهی انجام می‌داد، نه اینکه فقط برای تقلید و نمایش یا ریاکاری این کارها را کرده باشد."],[657,"که دلش می‌گفت کین را تو بشو","که درین جا هست حکمت تو بتو","دل او به او می‌گوید که این مقام و حال، مستحق توست و باید خود را از آن چیزهایی که در این‌جا وجود دارد، آزاد کنی؛ زیرا در این جا حکمت تو نهفته است."],[658,"کافرک را هیکلی بد یادگار","یاوه دید آن را و گشت او بی‌قرار","هیکل: بت؛ یاوه: گم شدن"],[658,"گفت آن حجره که شب جا داشتم","هیکل آنجا بی‌خبر بگذاشتم","او می‌گوید: من در آن حجره که شب را در آنجا گذراندم، آن هیکلی را که بی‌خبر گذاشته بودم، فراموش کردم."],[658,"گرچه شرمین بود شرمش حرص برد","حرص اژدرهاست نه چیزیست خرد","هرچند که او خجالت‌زده و شرمگین بود، اما شرم او به خاطر طمع و حرصش بود، این حرص و تمایل به چیزهای بزرگ و عظیم مانند حرص مارهاست، نه چیزی کوچک و ناچیز."],[658,"از پی هیکل شتاب اندر دوید","در وثاق مصطفی، وان را بدید","او به دنبال شکل و ظاهری که از مصطفی (پیامبر اسلام) دیده بود، با شتاب به سمت او دوید و وقتی به او رسید، او را در حالتی خاص و مقدس مشاهده کرد."],[658,"کان یدالله آن حدث را هم به خود","خوش همی‌شوید که دورش چشم بد","دست خداوند (یعنی قدرت الهی) آن حادثه را نیز با دست خود می‌شوید و پاک می‌کند تا اینکه چشم بد از او دور شود."],[658,"هیکلش از یاد رفت و شد پدید","اندرو شوری، گریبان را درید","او به خاطر حالت و شور و شوقی که پیدا کرده بود، دیگر به هیکل و ظاهر خود توجهی نداشت و به قدری به خود آمده بود که گریبانش را پاره کرد."],[658,"می‌زد او دو دست را بر رو و سر","کله را می‌کوفت بر دیوار و در","او به شدت خودش را آزار می‌دهد و با دستانش به صورت و سرش ضربه می‌زند و به دیوار و در می‌کوبد."],[658,"آنچنان که خون ز بینی و سرش","شد روان و رحم کرد آن مهترش","مهتر: پیامبر (ص)"],[658,"نعره‌ها زد خلق جمع آمد برو","گبر گویان ایهاالناس احذروا","همه مردم جمع شدند و فریاد زدند که ای مردم، مواظب باشید! آن گبر (کافر) در حال بلواست."],[658,"می‌زد او بر سر که ای بی‌عقل سر","می‌زد او بر سینه کای بی‌نور بر","او (مهمان) به شدت بر سر و سینه‌اش می‌زند و ناله می‌کند و می‌گوید ای بی‌عقل، چرا مثل من بی‌نور و آگاه نیستی."],[658,"سجده می‌کرد او که ای کل زمین","شرمسارست از تو این جزو مهین","کل زمین: کنایه از پیامبر (ص)؛ مهین: خوار و حقیر"],[658,"تو که کلی، خاضع امر ویی","من که جزوم، ظالم و زشت و غوی","تو که وجودت جامع و کامل است و در برابر فرمان او خاضع هستی، من که جزئی از هستی‌ام و در ظلم و زشتی گرفتار و گمراه شده‌ام."],[658,"تو که کلی، خوار و لرزانی ز حق","من که جزوم، در خلاف و در سبق","تو که موجود کاملی و در برابر حق، خوار و مضطربی، من که موجودی جزئی هستم، در حال تخلف و سرپیچی از دستورات."],[658,"هر زمان می‌کرد رو بر آسمان","که ندارم روی ای قبله جهان","هر بار که او (مهمان) به آسمان نگاه می‌کرد، احساس می‌کرد که نمی‌تواند به او (مصطفی) نگاه کند، ای که قبله و راهنمای همه جهانیان هستی."],[658,"چون ز حد بیرون بلرزید و طپید","مصطفی‌اش در کنار خود کشید","وقتی مهمان از حالت عادی خارج شد و به شدت لرزید و دچار نوسان شد، پیامبر اسلام (مصطفی) او را به کنار خود کشید و آرامش داد."],[658,"ساکنش کرد و بسی بنواختش","دیده‌اش بگشاد و داد اشناختش","پیامبر (مصطفی) او را ساکت کرد و به آرامی نوازش کرد، سپس به او نگاه کرد و او را به خوبی شناخت."],[658,"تا نگرید ابر کی خندد چمن","تا نگرید طفل کی جوشد لبن","چمن نمی‌تواند شاد و خندنده باشد مگر اینکه ابر ببارد و باران باشد. همچنین، شیر از پستان مادر (که طفل طلب می‌کند) خارج نمی‌شود مگر اینکه کودک گریه کند."],[658,"طفل یک روزه همی‌داند طریق","که بگریم تا رسد دایه شفیق","کودک یک روزه می‌داند که چگونه گریه کند تا به دایه مهربان و حمایتگرش برسد."],[658,"تو نمی‌دانی که دایه دایگان","کم دهد بی‌گریه شیر او رایگان","تو نمی‌دانی که دایه مهربان، شیر خود را به کسی که گریه نمی‌کند، بی‌زحمت نمی‌دهد."],[658,"گفت فلیبکوا کثیرا گوش دار","تا بریزد شیر فضل کردگار","فليضحکوا قليلا وليبکوا کثيرا جزاء بما کانوا يکسبون (توبه، 82): کم بخندید و بسیار گریه کنید، این کیفر کارهای شماست!"],[658,"گریه ابرست و سوز آفتاب","استن دنیا، همین دو رشته تاب","گریه ابر و گرمای آفتاب، ویژگی‌های این دنیا هستند و همه چیز در این جهان تحت تأثیر این دو اصل قرار دارد."],[658,"گر نبودی سوز مهر و اشک ابر","کی شدی جسم و عرض زفت و سطبر","اگر گرمای خورشید و اشک باران نبود، آیا جسم و ذات تو چنین سنگین و مستحکم می‌شد؟"],[658,"کی بدی معمور، این هر چار فصل","گر نبودی این تف و این گریه اصل","اگر این حس و اندوه و اشک (که به دلیل عشق و محبت بروز می‌کند) وجود نداشت، آیا این چهار فصل بهاری (در زندگی و طبیعت) هم می‌توانست چنین پر رونق و زیبایی داشته باشد؟"],[658,"سوز مهر و گریه ابر جهان","چون همی دارد جهان را خوش‌دهان،","عشق و دلسوزی و اشک‌های ابر، برای جهان چنان شادی و سرور به ارمغان می‌آورد که بهشت را زیبا و خوش‌بو می‌کند."],[658,"آفتاب عقل را در سوز دار","چشم را چون ابر اشک‌افروز دار","برای درک حقیقت و درک خرد، باید مانند ابر، اشک بریزید و دل را در سوز عشق بسوزانید. در واقع، عقل روشن و آفتابی می‌شود که در ظرف چشمان گریان و مملو از اشک قرار دارد."],[658,"چشم گریان بایدت چون طفل خرد","کم خور آن نان را که نان آب تو برد","چشم‌های تو باید همیشه گریان باشد مثل چشم‌های یک کودک کوچک. باید از آن غذایی که تو را به کام مرگ می‌برد، کمتر بخوری."],[658,"تن چو با برگست روز و شب از آن","شاخ جان در برگ‌ریزست و خزان","تن انسان مانند درختی است که در طول روز و شب از شاخ جانش برگ‌هایی دارد. اما وقتی که پاییز فرا می‌رسد، این برگ‌ها می‌ریزند و تن دچار نقصان می‌شود."],[658,"برگ تن بی‌برگی جانست زود","این بباید کاستن آن را فزود","تن انسان مانند برگی است که به زودی بی‌خاصیت می‌شود، اما جان او همچنان حیات دارد. بنابراین، باید از خصائل مادی و ظاهری خود کم کنیم تا بر معنویت و ارزش‌های درونی‌امان بیفزاییم."],[658,"اقرضوا الله قرض ده زین برگ تن","تا بروید در عوض در دل چمن","به خداوند قرض دهید، از این نعمت‌های دنیوی و مادی که مانند برگ بر درخت هستند، تا در عوض، در دل چمن (بهشت) رشد و فزونی یابد."],[658,"قرض ده کم کن ازین لقمه تنت","تا نماید وجه لا عین رات","عبارت لا عین رات اشاره به یک حدیث قدسی دارد که خداوند می فرماید من برای بندگان صالحم چنان پاداشی فراهم می کنم که نه چشمی آنرا دیده باشد، نه گوشی آنرا شنیده باشد و نه بر دلی خطور کرده باشد."],[658,"تن ز سرگین خویش چون خالی کند","پر ز مشک و در اجلالی کند","وقتی انسان از کثافات و زشتی‌ها خود را پاک کند، به درخشانی و عطر خوشی می‌رسد."],[658,"زین پلیدی بدهد و پاکی برد","از یطهّرکم تن او برخورد","از این آلودگی، پاکی و طهارت بگیر و به او بده، زیرا بدن او برای شما پاک‌کننده‌ای است."],[658,"دیو می‌ترساندت که هین و هین","زین پشیمان گردی و گردی حزین","دیو (نماد شیطان یا وسوسه) تو را می‌ترساند و می‌گوید که هراسان باش، زیرا اگر به تصمیم‌های نادرستت ادامه دهی، پشیمان و غمگین خواهی شد."],[658,"گر گدازی زین هوسها تو بدن","بس پشیمان و غمین خواهی شدن","اگر از این هوس‌ها دور شوی و خود را ویران کنی، تنها به پشیمانی و اندوه خواهی رسید."],[658,"این بخور گرمست و داروی مزاج","وآن بیاشام از پی نفع و علاج","این بیتی اشاره دارد به اینکه برخی چیزها، مانند خوراک گرم، می‌توانند برای سلامتی مفید باشند و باید به سراغ آن‌ها رفت، در حالی که برخی دیگر را باید نوشید تا از آن‌ها بهره‌مند شد و مشکل را درمان کرد."],[658,"هم بدین نیت که این تن مرکبست","آنچ خو کردست آنش اصوبست","این بدن ما به عنوان یک وسیله و مرکب است، بنابراین آنچه برای او مناسب‌تر است، باید همان چیزی باشد که به آن عادت کرده است."],[658,"هین مگردان خو که پیش آید خلل","در دماغ و دل بزاید صد علل","مراقب باشید که عادت‌های ناپسند خود را تغییر ندهید؛ زیرا این کار باعث اختلال در فکر و قلب شما خواهد شد و مسائل و مشکلات زیادی به وجود می‌آورد."],[658,"این چنین تهدیدها آن دیو دون","آرد و بر خلق خواند صد فسون","این‌گونه تهدیدها از جانب آن دیو پست، بسیاری را به دام می‌اندازد و به آن‌ها فریب‌هایی می‌زند."],[658,"خویش جالینوس سازد در دوا","تا فریبد نفس بیمار ترا","نفس بیمار تو را فریب می‌دهد و به تو می‌گوید که درمان را از جالینوس (پزشک معروف یونانی) بگیر، در حالی که او فقط می‌خواهد تو را به دام بیندازد."],[658,"کین ترا سودست از درد و غمی","گفت آدم را همین، در گندمی","آدم به تو می‌گوید که این درد و غم برای تو چه فایده‌ای دارد، مانند گندمی که برای رشد و سود خود به خاک نیاز دارد."],[658,"پیش آرد هیهی و هیهات را","وز لویشه پیچد او لبهات را","سوز و غم را به همراه می‌آورد و بر درد و فریادهایش می‌افزاید و از شدت گریه، چهره‌اش را به اندوه می‌پیچد."],[658,"هم‌چو لبهای فرس در وقت نعل","تا نماید سنگ کمتر را چو لعل","مثل لب‌های اسب در زمان زین کردن، که نشان می‌دهد سنگی که کم‌ارزش است، مانند یاقوت (لعل) به نظر می‌رسد."],[658,"گوشهاات گیرد او چون گوش اسب","می‌کشاند سوی حرص و سوی کسب","گوش‌های تو به مانند گوش‌های اسب به سمت طمع و کسب و کار می‌کشد و توجه‌ات را جلب می‌کند."],[658,"بر زند بر پات نعلی ز اشتباه","که بمانی تو ز درد آن ز راه","اگر بر پاهایت نعل اشتباه بزنند، تو به درد می‌افتی و از مسیر درست دور می‌شوی."],[658,"نعل او هست آن تردد در دو کار","این کنم یا آن کنم هین هوش دار","تردید او مانند نعل (سم) است که در دو کار مختلف قرار دارد؛ باید توجه کنی و انتخاب کنی که این کار را انجام بدهی یا آن کار را."],[658,"آن بکن که هست مختار نبی","آن مکن که کرد مجنون و صبی","آن کار را انجام بده که پیامبر مختار، یعنی حضرت محمد (ص)، کرده است و از کارهایی که مجنون و صبی (جوان نادان) انجام داده دوری کن."],[658,"حفّت الجنه بچه محفوف گشت","بالمکاره که ازو افزود کشت","حدیث نبوی: بهشت پوشیده شده با انواع سختی هاست پس هرکس در این دنیا پرهیزکار باشد و به خود سختی بدهد لایق بهشت است."],[658,"صد فسون دارد ز حیلت وز دغا","که کند در سلّه گر هست اژدها","هزاران نیرنگ و ترفند از فریب و نیرنگ وجود دارد که اگر دشمنی واقعی در کار باشد، موانع و مشکلات را از میان برمی‌دارد و به راه خود ادامه می‌دهد."],[658,"گر بود آب روان بر بنددش","ور بود حبر زمان برخنددش","حبر: دانشمند"],[658,"عقل را با عقل یاری یار کن","امرهم شوری بخوان و کار کن","عقل خود را با عقل دیگران همراهی کن و در کارها، او را راهنمایی کن و به او شور و انگیزه بده."],[659,"این سخن پایان ندارد آن عرب","ماند از الطاف آن شه در عجب","آن عرب به خاطر مهربانی‌ها و محبت‌های پیامبر (مصطفی) همچنان در حیرت و شگفتی است و کلامش پایانی ندارد؛ او تحت تأثیر الطاف آن بزرگوار به سر می‌برد."],[659,"خواست دیوانه شدن عقلش رمید","دست عقل مصطفی بازش کشید","عرب در تلاش است تا از اندوه و ناامیدی خود فرار کند و به دیوانگی روی آورد، ولی عقل او نمی‌گذارد و خود مصطفی (حضرت محمد) او را به راه راست و آرامش می‌آورد."],[659,"گفت این سو آ بیامد آنچنان","که کسی برخیزد از خواب گران","گفت که این طرف نیا، مثل این که کسی از خواب عمیق بیدار شود."],[659,"گفت این سو آ مکن هین با خود آ","که ازین سو هست با تو کارها","گفت: به این سمت نیا، خود را با این‌گونه کارها دچار نکن، زیرا در این سمت امور مهمی با تو در حال انجام است."],[659,"آب بر رو زد در آمد در سخن","کای شهید حق شهادت عرضه کن","سخن این است که شخصی در حال سخن گفتن از فردی به نام \"شهید\" است و از او می‌خواهد که به حق خود به عنوان یک شهید، گواهی دهد یا شهادتی ارائه کند."],[659,"تا گواهی بدهم و بیرون شوم","سیرم از هستی در آن هامون شوم","من می‌خواهم گواهی بدهم و از این وضعیت خارج شوم و در آن بیابان بزرگ، غرق در هستی و وجود شوم."],[659,"ما درین دهلیز قاضی قضا","بهر دعوی الستیم و بلی","ما در این مسیر به عنوان قاضی قضا (سرنوشت) هستیم تا برای دعوای \"آیا من هستم؟\" یا \"بلی، من هستم\" شهادت دهیم."],[659,"که بلی گفتیم و آن را ز امتحان","فعل و قول ما شهودست و بیان","اگر ما به درستی سخن گفته‌ایم و باید این موضوع از آزمایش کردار و گفتار ما روشن و مشخص شود."],[659,"از چه در دهلیز قاضی تن زدیم","نه که ما بهر گواهی آمدیم","چرا در فضای تنگ و بسته قاضی نشسته‌ایم و بی‌حرکت مانده‌ایم، در حالی که هدف ما گواهی دادن است؟"],[659,"چند در دهلیز قاضی ای گواه","حبس باشی ده شهادت از پگاه","چقدر در مکانی مثل دهلیز قاضی معطل هستی، ای گواه! باید به سراغ شهادت بروی و از صبح زود شتاب کنی."],[659,"زان بخواندندت بدین‌جا تا که تو","آن گواهی بدهی و ناری عتو","به خاطر این که تو را به این‌جا خوانده‌اند، باید گواهی بدهی و از عذاب و عذرخواهی خود بگویی."],[659,"از لجاج خویشتن بنشسته‌ای","اندرین تنگی کف و لب بسته‌ای","تو از روی لجاج و stubbornness خود، در این تنگنا نشسته‌ای و زبانت را بسته‌ای، یعنی نمی‌خواهی چیزی بگویی یا از موقعیت خود خارج شوی."],[659,"تا بندهی آن گواهی ای شهید","تو ازین دهلیز کی خواهی رهید","تو ای شهید، تا کی می‌خواهی در این راه تنگ و دشوار باقی بمانی و به یاد آن گواهی (شهادت) خود نرسی؟"],[659,"یک زمان کارست بگزار و بتاز","کار کوته را مکن بر خود دراز","مدتی کار خود را رها کن و به جلو برو، و زمان را طولانی نکن. کارهای کوتاه را به تأخیر نینداز و زندگی را از سر بگیر."],[659,"خواه در صد سال خواهی یک زمان","این امانت واگزار و وا رهان","خواه برای صد سال هم که شده، این امانت را به من بسپار و از خودت آزاد کن."],[660,"این نماز و روزه و حج و جهاد","هم گواهی دادنست از اعتقاد","نماز، روزه، حج و جهاد همگی نشانه‌هایی هستند که نشان می‌دهند انسان به اعتقاد و باورهای درونی خود پایبند است."],[660,"این زکات و هدیه و ترک حسد","هم گواهی دادنست از سرّ خود","این زکات، هدیه دادن و دوری از حسد نیز نشانه‌هایی است از حقیقت درون انسان."],[660,"خوان و مهمانی پی اظهار راست","کای مهان ما با شما گشتیم راست","در این بیت، مولانا به مهمانی و دیدار دوستان اشاره می‌کند و می‌گوید که این مهمانی، نشانه‌ای است از صداقت و حقیقت در رابطه با یکدیگر. همچنین از مهمانان می‌خواهد که در این جمع، راستگویی و دوستی را ابراز کنند."],[660,"هدیه‌ها و ارمغان و پیش‌کش","شد گواه آنک هستم با تو خوش","هدیه‌ها و هدایایی که آورده‌ام، نشانه و گواهی است بر این که من با تو خوشحال و راضی هستم."],[660,"هر کسی کوشد به مالی یا فسون","چیست؟ دارم گوهری در اندرون","هر کسی که سعی می‌کند به وسیله مالی یا جادوگری خود را مطرح کند و خود را نشان دهد، در واقع چیزی را که در درون دارد، نادیده گرفته است. من گوهری از درون دارم که ارزش بیشتری دارد."],[660,"گوهری دارم ز تقوی یا سخا","این زکات و روزه در هر دو گوا","من در درون خود گوهری از تقوا یا سخاوت دارم که زکات و روزه در هر دو به عنوان شاهد بر این گوهری هستند."],[660,"روزه گوید کرد تقوی از حلال","در حرامش دان که نبود اتصال","روزه به ما می‌گوید که تقوا تنها از چیزهای حلال به دست می‌آید و اگر انسان از چیزهای حرام استفاده کند، نمی‌توان به تقوای او اعتماد کرد."],[660,"وان زکاتش گفت کاو از مال خویش","می‌دهد، پس چون بدزدد ز اهل کیش؟","زکات می‌گوید که کسی که از اموال خود کمک می‌کند، چگونه می‌تواند از اعضای دین خود دزدی کند؟ این اشاره به تضاد میان اعمال خوب و نیت‌های بد دارد."],[660,"گر به طراری کند پس دو گواه","جرح شد در محکمه عدل اله","اگر شخصی به دلیل طمع و فریبکاری عمل کند، در محشر در محکمه عدل اله، دو شاهد وجود دارد که رفتار او را زیر سؤال می‌برد."],[660,"هست صیاد ار کند دانه نثار","نه ز رحم و جود بل بهر شکار","اگر صیاد دانه‌ای برای پرنده می‌ریزد، این کار او نه از روی رحمت و سخاوت است، بلکه به خاطر این است که بتواند پرنده را شکار کند."],[660,"هست گربه روزه‌دار اندر صیام","خفته کرده خویش بهر صید خام","کسانی که خلوص ندارند به مانند آن گربه‌ای هستند که بهر شکار خود را به خواب زده."],[660,"کرده بدظن زین کژی صد قوم را","کرده بدنام اهل جود و صوم را","برخی از مردم به خاطر رفتار نادرست و منحرفانه یک فرد، به او بدگمان شده و کل گروهی که آن فرد به آن تعلق دارد، به بدنامی و خوار شدن دچار می‌شوند. این بی‌عدالتی، مخصوصا در مورد افرادی که اهل بخشش و روزه‌داری هستند، موجب رنجش و آسیب به وجهه آن‌ها می‌شود."],[660,"فضل حق با این که او کژ می‌تند","عاقبت زین جمله پاکش می‌کند","فضل خداوند با این که او (انسان) در واقعیت دچار انحراف و کژی است، در نهایت او را از این همه ناپاکی‌ها پاک و تهذیب می‌کند."],[660,"سبق برده رحمتش وان غدر را","داده نوری که نباشد بدر را","رحمت خداوندی برتری یافته و به این افراد نوری داده که هیچ تدلیسی در آن وجود ندارد، و این نور، از اعمال ناپاک و خیانت‌ها پاک است."],[660,"کوششش را شسته حق زین اختلاط","غسل داده رحمت او را زین خباط","خباط: دیوانگی"],[660,"تا که غفاری او ظاهر شود","مغفری، کلّیش را غافر شود","مغفر: کلاه خود، کلّی: کچلی"],[660,"آب بهر این ببارید از سماک","تا پلیدان را کند از خبث پاک","آب به خاطر این بارید که از ستاره «سماک» (که یکی از ستاره‌های آسمانی است) بیرون می‌آید تا انسان‌های پلید را از آلودگی و زشتی پاک کند."],[661,"آب چون پیگار کرد و شد نجس","تا چنان شد کآب را رد کرد حس","آب وقتی به چیز ناپاکی تماس پیدا کرد و آلوده شد، به حدی کثیف می‌شود که حتی حس و احساس هم نمی‌تواند از آن عبور کند و آن را بپذیرد."],[661,"حق ببردش باز در بحر صواب","تا بشستش از کرم آن آب آب","خداوند او را دوباره به سوی دریای حقیقت هدایت کرد تا از آلودگی‌های ناشی از پلیدی پاک شود."],[661,"سال دیگر آمد او دامن‌کشان","هی کجا بودی؟ به دریای خوشان","سال آینده، او بار دیگر با شتاب و شوق به سوی ما آمد و پرسید: \"کجا بودی؟\" که در دریای خوشی‌ها غرق بودی."],[661,"من نجس زینجا شدم پاک آمدم","بستدم خلعت سوی خاک آمدم","من از اینجا نجس و آلوده شده‌ام، اما به سوی شما پاک و بی‌عیب آمده‌ام و لباس (خلعت) در زمین (خاک) پوشیده‌ام."],[661,"هین بیایید ای پلیدان سوی من","که گرفت از خوی یزدان خوی من","ای پلیدان، به سوی من بیایید، زیرا من از ذات خداوندی خود، خوی پاکی و نیکی را دارم."],[661,"در پذیرم جمله زشتیت را","چون ملک پاکی دهم عفریت را","من تمامی زشتی‌ها و پلیدی‌های شما را می‌پذیرم، زیرا من همچون پادشاه پاکی، آن‌ها را از شما می‌گیرم و به شما تیغ رهایی می‌بخشم."],[661,"چون شوم آلوده باز آنجا روم","سوی اصل اصل پاکیها روم","وقتی که آلوده شوم، دوباره به سرچشمه اصلی پاکی‌ها می‌روم."],[661,"دلق چرکین بر کنم آنجا ز سر","خلعت پاکم دهد بار دگر","دلق چرکین به معنای لباس آلوده است که مولانا در اینجا از آن استفاده کرده است. او می‌گوید که وقتی به مکان پاکی می‌رود، لباس آلوده را از سر برمی‌دارد و این امر سبب می‌شود که پاکی دوباره به او بازگردد. اشاره به نیاز به تغییر وضعیت و پوشش ظاهری برای رسیدن به حالت پاکی و طهارت دارد."],[661,"کار او اینست و کار من همین","عالم‌آرایست رب العالمین","خداوند به خلق جهان و نظم آن مشغول است و کار من نیز آراستن و زیبا کردن همین عالم است."],[661,"گر نبودی این پلیدیهای ما","کی بدی این بارنامه آب را","اگر این پلیدی‌ها و آلودگی‌های ما وجود نداشت، چه دلیلی برای تحویل بارنامه‌ی آب (که نماد پاکی و زندگی است) وجود داشت؟"],[661,"کیسه‌های زر بدزدید از کسی","می‌رود هر سو که هین کو مفلسی","مردی در هر سو به دنبال گنجینه‌ای از زر (طلا) است که از کسی دزدیده، و این در حالی است که توجهش به فقر و نیازمندی دیگران نیست."],[661,"یا بریزد بر گیاه رسته‌ای","یا بشوید روی رو ناشسته‌ای","یا بر گیاهی که به‌خوبی رشد کرده آب ریخته می‌شود، یا بر روی شخصی که هنوز شسته و پاک نشده، آب می‌ریزد."],[661,"یا بگیرد بر سر او حمال‌وار","کشتی بی‌دست و پا را در بحار","شاید در شرایطی، بی‌حرکت و بدون هیچ کمکی به وسیله دیگران، بر دوش کسی یا چیزی باری سنگین قرار بگیرد و در دریای مشکلات غوطه‌ور شود."],[661,"صد هزاران دارو اندر وی نهان","زانک هر دارو بروید زو چنان","در درون این موجود، صد هزار دارو پنهان است، زیرا هر دارویی از همین موجود به وجود می‌آید."],[661,"جان هر دری، دل هر دانه‌ای","می‌رود در جو، چو داروخانه‌ای","روح هر دری و دل هر دانه‌ای به دریا و جو می‌پیوندد، مانند داروهایی که در یک داروخانه جمع شده‌اند."],[661,"زو یتیمان زمین را پرورش","بستگان خشک را از وی روش","خداوند یتیمان زمین را با رحمت و لطف خود پرورش می‌دهد، همچنان که از آب، گیاهان خشک و بی‌نهایت زندگی می‌گیرند."],[661,"چون نماند مایه‌اش، تیره شود","هم‌چو ما اندر زمین خیره شود","زمانی که انسان فاقد اصل و ریشه باشد، مانند ما در این دنیا، از نظر روحی و معنوی دچار سردرگمی و تیره‌رویو می‌شود."],[662,"ناله از باطن برآرد کای خدا","آنچ دادی دادم و ماندم گدا","از دل برمی‌آید ناله‌ای که می‌گوید: ای خدا، آنچه به من عطا کردی را صرف کرده‌ام و اکنون در حال نیازمندی هستم."],[662,"ریختم سرمایه بر پاک و پلید","ای شه سرمایه‌ده هل من مزید؟","من منابع و دارایی‌ام را بر روی انسان‌های خوب و بد خرج کرده‌ام؛ ای شاه که روزی‌دهنده‌ای، آیا چیزی بیشتر می‌دهی؟"],[662,"ابر را گوید ببر جای خوشش","هم تو خورشیدا به بالا بر کشش","مولانا از زبان ابر می‌گوید که به او بگوید به جایی خوش برود و او را به سمت خورشید بالا بکشد. اصولا این شعر درباره درخواست ابر از خورشید است تا او را به جایی خوش و مناسب ببرد."],[662,"راههای مختلف می‌راندش","تا رساند سوی بحر بی‌حدش","آب به طرق و مسیرهای گوناگون حرکت می‌کند تا به دریا یا اقیانوس بی‌پایان برسد."],[662,"خود غرض زین آب جان اولیاست","کو غسول تیرگیهای شماست","هدف از این آب جان، که پاک‌کننده آلودگی‌ها و تاریکی‌های شماست، خود آب است."],[662,"چون شود تیره ز غدر اهل فرش","باز گردد سوی پاکی‌بخش عرش","وقتی که از بدی‌های انسان‌ها در زمین گرفتار تاریکی و آلودگی شویم، باید به سوی پاکی و صفای الهی در عرش الهی بازگردیم."],[662,"باز آرد زان طرف دامن کشان","از طهارات محیط او درسشان","خدای تعالی از سوی خود، با رحمت و پاکی‌اش، بندگان را به سوی درستکاری و طهارت دعوت می‌کند و به آنها درس می‌آموزد که چگونه از آلودگی‌ها فاصله بگیرند."],[662,"از تیمم وا رهاند جمله را","وز تحری طالبان قبله را","از تیمم نجات می‌دهد همه را و از به دنبال قبله گشتن طالبان قبله را رها می‌کند."],[662,"ز اختلاط خلق یابد اعتلال","آن سفر جوید که ارحنا یا بلال","سفرکننده‌ای که در میان مردم با دلهره و ناآرامی زندگی می‌کند، به آرامش و رهایی نیاز دارد، مانند بلال که برای رسیدن به آرامش دعا می‌کند."],[662,"ای بلال خوش‌نوای خوش‌صهیل","مئذنه بر رو بزن طبل رحیل","ای بلال، خوش صدای خوش آواز، بر بام مسجد اذان بگو و بانگ سفر را به راه بینداز."],[662,"جان سفر رفت و بدن اندر قیام","وقت رجعت زین سبب گوید سلام","جان به سفر رفته و بدن در حال ایستاده است، بنابراین در زمان بازگشت (به عالم دیگری) به همین دلیل سلام می‌گوید."],[662,"این مثل چون واسطه‌ست اندر کلام","واسطه شرطست بهر فهم عام","این ضرب‌المثل مانند واسطه‌ای است در کلام، زیرا واسطه (میانجی) برای درک بهتر امور عمومی لازم است."],[662,"اندر آتش کی رود بی‌واسطه","جز سمندر، کو رهید از رابطه","فقط سمندر، که موجودی است که از آتش می‌گذرد و آسیب نمی‌بیند، می‌تواند بدون واسطه در آتش وارد شود؛ در غیر این صورت، کسی نمی‌تواند به تنهایی و بدون واسطه از آتش عبور کند."],[662,"واسطه حمام باید مر ترا","تا ز آتش خوش کنی تو طبع را","برای اینکه بتوانی از آتش رنج‌ها و دشواری‌ها نجات پیدا کنی، لازم است به واسطه‌ای مثل حمام (که به معنای پاکیزگی و تطهیر است) مراجعه کنی تا طبیعت و روح تو را خوش و آرام کند."],[662,"چون نتانی شد در آتش چون خلیل","گشت حمامت رسول، آبت دلیل","اگر نتوانی مانند خلیل (حضرت ابراهیم) از آتش نجات پیدا کنی و در سختی‌ها به صبر و استقامت بپردازی، در این صورت حمام و گرمای آن برای تو نشانه‌ای ندارد."],[662,"سیری از حقست لیک اهل طبع","کی رسد بی‌واسطه نان در شبع","سیر و صعود به سوی حق، نتیجه‌ای الهی است، اما انسان‌های محدود که در حواشی زندگی غرقند، چطور می‌توانند بدون واسطه و نیاز به اشتهای فانی خود به آن حقیقت دست یابند؟"],[662,"لطف از حقست لیکن اهل تن","درنیابد لطف بی‌پرده چمن","لطف و رحمت خداوندی از آن اوست، اما انسان‌های مادی و دنیوی نمی‌توانند این لطف را بدون حجاب و پرده درک کنند، همان‌طور که زیبایی‌های یک گلزار (چمن) را از پشت پرده نمی‌توان به‌خوبی مشاهده کرد."],[662,"چون نماند واسطه تن بی‌حجیب","هم‌چو موسی نور مه یابد ز جیب","وقتی که هیچ مانعی بین روح و جسم وجود نداشته باشد، انسان هم مثل موسی (پیامبر) می‌تواند از نوری که در خداوند وجود دارد، بهره‌مند شود."],[662,"این هنرها آب را هم شاهدست","که اندرونش پر ز لطف ایزدست","آب نیز نشانه‌ای از هنرهای خداوند است، زیرا در درون خود از لطف و نعمت‌های او پر است."],[663,"فعل و قول آمد گواهان ضمیر","زین دو بر باطن تو استدلال گیر","کارهایی که انجام می‌دهی و سخنانی که می‌گویی، شاهدانی بر دلت هستند؛ از این دو (فعل و قول) بر دلت استدلال کن و به باطن خود توجه کن."],[663,"چون ندارد سیر سرت در درون","بنگر اندر بول رنجور از برون","وقتی در درون خود سیر و آرامش نداری، به درد و بیماری‌های ظاهری (احساسی یا جسمی) که در برون می‌بینی نگاه کن."],[663,"فعل و قول آن بول رنجوران بود","که طبیب جسم را برهان بود","عمل و گفتار آن بیمار بدحال نشانه‌ای از حال درونی اوست که پزشک جسم را از آن نجات می‌دهد."],[663,"وآن طبیب روح در جانش رود","وز ره جان اندر ایمانش رود","طبیب روح، یعنی کسی که به اصلاح روح و درون انسان می‌پردازد، باید در وجود او نفوذ کند و از راه جان، به ایمان او نفوذ کرده و آن را تقویت کند."],[663,"حاجتش ناید به فعل و قول خوب","احذروهم هم جواسیس القلوب","نیازی به رفتار و گفتار نیکو ندارد، زیرا او به خوبی توانایی درک و شناخت باطن انسان‌ها را دارد و به خوبی می‌داند که دل‌های مردم چه می‌گذرد."],[663,"این گواه فعل و قول از وی بجو","کو به دریا نیست واصل هم‌چو جو","این نشان از کارها و گفتارهای او را جستجو کن، چون او مانند جوی که به دریا نمی‌رسد، از حقیقت دور است."],[664,"لیک نور سالکی کز حد گذشت","نور او پر شد بیابان‌ها و دشت","نور سالکی که از مرزها و محدودیت‌ها عبور کرده است، چنان درخشان و گسترده می‌شود که تمامی بیابان‌ها و دشت‌ها را روشن می‌کند."],[664,"شاهدی‌اش فارغ آمد از شهود","وز تکلّف‌ها و جانبازی و جود","شاهد و گواهی که این نور را تصدیق کند، از دیدن و مشاهده بی‌نیاز است و نیازی به زحمت‌کشیدن و فداکاری و بخشش ندارد."],[664,"نور آن گوهر چو بیرون تافته‌ست","زین تسلّس‌ها فراغت یافته‌ست","نور آن گوهر (وجود حقیقی) وقتی که از خود بیرون می‌تابد، از قید و بند این زنجیره‌های وابستگی (گفتار و کردار) رها شده است."],[664,"پس مجو از وی گواه فعل و گفت","که ازو هر دو جهان چون گل شکفت","برای گواهی بر نور درونی انسان عارف، به دنبال نشانه‌های بیرونی مانند گفتار و کردار او نگرد؛ زیرا وجود او به‌تنهایی، مانند شکفتن گل، نشانه‌ای روشن از حقیقت این دو جهان است."],[664,"این گواهی چیست‌‌‌؟ اظهار نهان","خواه قول و خواه فعل و غیر آن","این گواهی چه چیزی است؟ نشان دادن ناگفته‌ها و پنهان‌ها، چه به کلام باشد و چه به عمل، و یا چیز دیگری غیر از این‌ها."],[664,"که غرض اظهار سرّ جوهرست","وصف باقی وین عرض بر معبر‌ست","غرض از نشان دادن حقیقت درونی و راز جوهر وجود انسان، باقی ماندن وصف و ویژگی‌های اوست؛ و این ویژگی‌ها تنها در گذرگاه‌هایی (اخلاقی یا ظاهری) بر دیگران آشکار می‌شود."],[664,"این نشان زر نماند بر محک","زر بماند نیک‌نام و بی ز شک","این نشان طلا برای سنجش طلایی که با ارزش است، باقی نمی‌ماند، بلکه فقط خود طلاست که در اسمی نیک و بدون تردید شناخته می‌شود."],[664,"این صلات و این جهاد و این صیام","هم نماند‌، جان بماند نیک‌نام","این نمازها، جهادها و روزه‌ها در نهایت از بین می‌روند، اما روح و جان آدمی با نیک‌نامی و کارهای خوبش باقی می‌ماند."],[664,"جان چنین افعال و اقوالی نمود","بر محکّ امر، جوهر را بسود","جان به وسیله اعمال و گفتار، جوهر و حقیقت وجود را به‌خوبی روشن می‌کند و نشان می‌دهد که حقیقت و مقام فرد از طریق این رفتارها و کلمات نمایان می‌شود."],[664,"که اعتقادم راستست اینک گواه","لیک هست اندر گواهان اشتباه","اعتقاد من درست است و اینک گواهان به آن شهادت می‌دهند، اما در میان شاهدان اشتباهاتی وجود دارد."],[664,"تزکیه باید گواهان را، بدان","تزکیه‌ش صدقی که موقوفی بدان","برای اینکه شاهدان و گواهان به صداقت و درستی برسند، باید خود را پاک و پاکیزه کنند، چون این پاکی به صدق و راست‌گویی آن‌ها بستگی دارد."],[664,"حفظ لفظ اندر گواه قولی است","حفظ عهد اندر گواه فعلی است","حفظ واژه‌ها و گفتار در برابر شهادت به اقوال، نشان‌دهنده حفظ پیمان و وفاداری نسبت به وعده‌ها و عملکردهاست."],[664,"گر گواه قول کژ گوید رد‌ست","ور گواه فعل کژ پوید رد‌ست","اگر کسی درباره سخنان نادرست شهادت دهد، آن شهادت پذیرفته نیست، و اگر کسی درباره اعمال نادرست گواهی دهد، آن گواهی نیز قابل قبول نیست."],[664,"قول و فعل بی‌تناقض بایدت","تا قبول اندر زمان پیش آیدت","برای اینکه در زمان‌های آینده مورد پذیرش قرار گیری، باید گفتار و کردار تو با هم هماهنگ و بی‌تناقض باشد."],[664,"سعیکم شتّی، تناقض اندرید","روز می‌دوزید‌، شب بر می‌درید","سعیکم شتی‌‌، اشاره است به آیه ۴ سوره لیل‌."],[664,"پس گواهی با تناقض کشنود‌‌؟","یا مگر حلمی کند از لطف خود","آیا تناقض و تضاد می‌تواند گواهی بدهد؟ یا این‌که خداوند به لطف خود، صبر و بردباری نشان می‌دهد؟"],[664,"فعل و قول اظهار سرّست و ضمیر","هر دو پیدا می‌کند سرّ ستیر","ستیر یعنی پوشیده و مستور"],[664,"چون گواهت تزکیه شد‌، شد قبول","ورنه محبوس است اندر مول‌، مول","مول‌مول یعنی این‌دست و آن‌دست کردن، تأخیر کردن و درنگیدن"],[664,"تا تو بستیزی‌، ستیزند ای حرون","فانتظرهم انّهم منتظرون","حرون یعنی سرکش و نافرمان"],[665,"این سخن پایان ندارد مصطفی","عرضه کرد ایمان و پذرفت آن فتی","این سخن ادامه‌دار است و پایان نمی‌پذیرد؛ رسول‌الاه (مصطفی) ایمان و معرفت خود را به مهمانش تقدیم کرد و آن جوان (فتی) نیز آن را پذیرفت."],[665,"آن شهادت را که فرّخ بوده است","بندهای بسته را بگشوده است","شهادتی که فرخ (سعید) آن را می‌گفت، باعث شده است که بندهای بسته و محدودیت‌ها باز شوند."],[665,"گشت مؤمن، گفت او را مصطفی","که امشبان هم باش تو مهمان ما","مؤمن به پیامبر اسلام (مصطفی) می‌گوید که امشب تو مهمان ما باش."],[665,"گفت والله تا ابد ضیف توام","هر کجا باشم بهر جا که روم","گفت قسم به خدا که من تا ابد مهمان تو هستم و هر جا که بروم، در هر مکانی که باشم، همیشه مهمان تو می‌مانم."],[665,"زنده کرده و معتق و دربان تو","این جهان و آن جهان بر خوان تو","این جهان و آن جهان به واسطه میهمان‌نوازی و استقبال تو زنده و آزاد شده‌اند و در حقیقت، نگهبان تو هستند."],[665,"هر که بگزیند جزین بگزیده خوان","عاقبت درّد گلویش ز استخوان","هر کسی که جز این خوان (خوان خدا) را انتخاب کند، در نهایت گردن او به خاطر استخوانی که در گلویش گیر کرده، شکسته خواهد شد. این به معنای آن است که انتخاب مسیر نادرست او را به درد و رنج می‌اندازد."],[665,"هر که سوی خوان غیر تو رود","دیو با او دان که هم‌کاسه بود","هر کس که به سراغ سفره‌ای غیر از سفره تو برود، بدان که مانند دیو است و به او بدان که هم‌سفره‌اش نیز از این دیو خواهد بود."],[665,"هر که از همسایگی تو رود","دیو، بی‌شکی که همسایه‌اش شود","هر کس که از همسایگی و نزدیکی تو فاصله بگیرد، بدون شک دیو و شیطان هم‌نشین او خواهد شد."],[665,"ور رود بی‌تو سفر او دوردست","دیو بد همراه و هم‌سفره ویست","اگر کسی بدون تو به سفر برود، در آن سفر دور و دراز، دیو بدی همسفر و همراه او خواهد بود."],[665,"ور نشیند بر سر اسپ شریف","حاسد ماهست، دیو او را ردیف","اگر حاسدی بر اسب نیکو و شریف نشسته باشد، او را دیو و مخلوق زشت هم‌پیمان و هم‌رده در نظر بگیرید."],[665,"ور بچه گیرد ازو شهناز او","دیو در نسلش بود انباز او","اگر بچه‌ای از شهناز بگیرد، او دیو را در نسل خود خواهد داشت و این دیو همپایه و هم‌نژاد اوست."],[665,"در نبی شارکهم گفته‌ست حق","هم در اموال و در اولاد ای شفق","حق سبحانه و تعالی در یکی از کتاب‌های آسمانی‌اش، به مردم اشاره کرده که در اموال و فرزندان خود شریک هستند، مانند شعاعی که از صبحگاه می‌تابد."],[665,"گفت پیغمبر ز غیب این را جلی","در مقالات نوادر با علی","پیامبر (حضرت محمد) در این جا به معجزات و علوم غیبی اشاره می‌کند که به او وحی شده است، و این مطالب را با علی (ابن ابی‌طالب) که از نزدیکان و یاران اوست، در میان گذاشته است."],[665,"یا رسول‌الله رسالت را تمام","تو نمودی هم‌چو شمس بی‌غمام","ای پیامبر خدا، تو رسالت و ماموریت خود را به‌طور کامل انجام دادی، مانند خورشید که بدون هیچ غم و اندوهی می‌تابد."],[665,"این که تو کردی دو صد مادر نکرد","عیسی از افسونش با عازر نکرد","هیچ مادری از عشق و محبتی که تو به مخلوقاتت داری، به اندازه آنچه که تو انجام دادی، نمی‌تواند فرزندش را دوست بدارد، و عیسی نیز هرگز آن‌طور که تو با عازر رفتار کردی، نرفت."],[665,"از تو جانم از اجل نک جان ببرد","عازر ار شد زنده زان دم باز مرد","اگر تو جانم را بگیری، مرگ از اجل (زمان پایان عمر) نمی‌گریزد. اگر عازر (عزیر) در آن لحظه زنده شده بود، باز هم همان لحظه می‌مرد."],[665,"گشت مهمان رسول آن شب عرب","شیر یک بز نیمه خورد و بست لب","مهمان پیامبر در آن شب، شیر یک بز را به‌طور نیمه خورد و سپس دهانش را بست و چیزی نگفت."],[665,"کرد الحاحش بخور شیر و رقاق","گفت گشتم سیر والله بی‌نفاق","مهمان از رسول اکرم خواسته که شیر و نان نازک بخورد و می‌گوید با تأکید که سیر شده‌ام و در این موضوع دروغ نمی‌گویم."],[665,"این تکلف نیست نی ناموس و فن","سیرتر گشتم از آنک دوش من","این موضوع فقط به خاطر تظاهر و خودنمایی نیست، بلکه یک سنت و هنر خاص است. من از آنچه که دیشب تجربه کردم، حاضرم بگویم که سیرتر شدم و پیشرفت کردم."],[665,"در عجب ماندند جمله اهل بیت","پر شد این قندیل زین یک قطره زیت؟","همه اهل خانه در شگفتی هستند که این قندیل (چراغ) چگونه تنها با یک قطره روغن پر شده است؟"],[665,"آنچ قوت مرغ بابیلی بود","سیری معده چنین پیلی شود؟","آنچه قدرت غذای پرنده کوچک بابل است، چگونه می‌تواند سیر کننده معده این فیل بزرگ باشد؟"],[665,"فجفجه افتاد اندر مرد و زن","قدر پشّه می‌خورد آن پیل‌تن","مردان و زنان در حالتی دچار تزلزل و وحشت شده‌اند که به اندازه یک مگس هم ارزش ندارند، در حالی که آن فیل بزرگ (که نماد قوت و قدرت است) به آرامی به آن‌ها نگریسته و نسبت به اوضاع بی‌توجه است."],[665,"حرص و وهم کافری سرزیر شد","اژدها از قوت موری سیر شد","حرص و تصور نادرست کافر مانند اژدهایی است که از نیروی یک مورچه سیر می‌شود و به پایین می‌آید. این تصویر نشان‌دهنده کوچکی و ضعف قدرت منفی است."],[665,"آن گدا چشمی کفر از وی برفت","لوت ایمانیش لمتر کرد و زفت","آن گدا که نابینا از کفر بود و ایمان نمی‌دید، ناگهان به لطف خدا ایمانش به او روی آورد و به حالتی دگرگون و متعجب در آمد."],[665,"آنک از جوع البقر او می‌طپید","هم‌چو مریم میوه جنت بدید","او که از گرسنگی و ضعف مانند مریم، مادر عیسی، می‌لرزید و در حالتی بسیار ناتوان قرار داشت، ناگهان میوه بهشتی را دید."],[665,"میوه جنت سوی چشمش شتافت","معده چون دوزخش آرام یافت","چشم او به میوه‌های بهشتی بی‌تابی می‌کند و معده‌اش که مانند دوزخ است، به آرامش می‌رسد."],[665,"ذات ایمان نعمت و لوتیست هول","ای قناعت کرده از ایمان به قول","ذات ایمان، خود یک نعمت بزرگ و ثروت باارزشی است. وای بر کسی که به ایمان خود اکتفا کرده و تنها به گفتارها بسنده می‌کند."],[666,"گرچه آن مطعوم جانست و نظر","جسم را هم زان نصیبست ای پسر","هرچند آن خوراک، تغذیه جان است، ولی جسم نیز از آن بهره‌ای می‌برد، ای پسر."],[666,"گر نگشتی دیو جسم آن را اکول","اسلم الشیطان نفرمودی رسول","اگر دیو جسم (خبیث و نامطلوب) نشوی، نمی‌توانی به مقام بالا و طهارت روحی دست یابی؛ پس پیامبر (رسول) هم نگفته است که بدان جایی می‌رسی."],[666,"دیو زان لوتی که مرده حی شود","تا نیاشامد مسلمان کی شود","دیو به واسطه لوتی که مرده و زنده می‌شود، درکی از حقیقت و معنای زندگی پیدا می‌کند؛ با این حال، تا زمانی که او مسلمان نشود، به حالت کفر باقی می‌ماند."],[666,"دیو بر دنیاست عاشق کور و کر","عشق را عشقی دگر برد مگر","دیو در دنیا برای عشق به شکل کور و کر وجود دارد و به عشق دیگری نیز متفاوت از عشق حقیقی تمایل پیدا می‌کند."],[666,"از نهان‌خانه یقین چون می‌چشد","اندک‌اندک رخت عشق آنجا کشد","از مخزن یقین، وقتی که به آرامی طعم عشق را می‌چشد، کم‌کم لباس عشق را به خود می‌پوشد."],[666,"یا حریص االبطن عرج هکذا","انما المنهاج تبدیل الغذا","ای کسی که به شدت به غذا علاقه‌مندی، این گونه است که راه چاره برای تو، تغییر در خوراک است."],[666,"یا مریض القلب عرج للعلاج","جملة التدبیر تبدیل المزاج","ای کسی که قلب بیمار داری، به سوی درمان برو؛ تمام تدبیر در این است که مزاج را تغییر دهی."],[666,"ایها المحبوس فی رهن الطعام","سوف تنجو ان تحملت الفطام","ای کسی که در چنگ غذا به نوعی محبوس هستی، تو نجات پیدا خواهی کرد اگر بتوانی از این وابستگی به غذا دست برداری و خویشتن را از آن جدا کنی."],[666,"ان فی‌الجوع طعام وافر","افتقدها وارتج یا نافر","در گرسنگی، غذایی فراوان وجود دارد که آن را گم کرده یا از آن غافل شده‌ای، و این‌که ممکن است به دلیل ناآشنایی یا بی‌میلی، از آن فاصله بگیری."],[666,"اغتذ بالنور کن مثل البصر","وافق الاملاک یا خیر البشر","از نور برخوردار شو مانند بینایی که با آن می‌بیند، تا هم‌چون فرشتگان، ای بهترین انسان‌ها، همراهی کنی."],[666,"چون ملک تسبیح حق را کن غذا","تا رهی هم‌چون ملایک از اذا","چون فرشتگان، به تسبیح و ستایش خدا مشغول هستند، تو نیز از این طریق به غذای روح خود بپرداز، تا مانند آن‌ها از عالم غیب بهره‌مند شوی و به سمت حقیقت راه یابی."],[666,"جبرئیل ار سوی جیفه کم تند","او به قوت کی ز کرکس کم زند","اگر جبرئیل (فرشته‌ای که پیام‌آور خداست) به سوی چیز ناپاکی مثل مردار (جیفه) برود، او چگونه می‌تواند قوی و نیرومند باشد؛ در حالی که کرکس (پرنده‌ای که از مردار تغذیه می‌کند) از او دور می‌شود؟ این بیت به نیرومندی و پاکی روحانی اشاره دارد که نمی‌تواند با ناپاکی‌ها آمیخته شود."],[666,"حبذا خوانی نهاده در جهان","لیک از چشم خسیسان بس نهان","محبوبی بزرگوار در این عالم قرار دارد، اما برای افراد سست‌نفسی چون خسیسان، به خاطر دنیاطلبی و کوری چشمشان، آن محبوب از دید آن‌ها پنهان است."],[666,"گر جهان باغی پر از نعمت شود","قسم موش و مار هم خاکی بود","اگر فرض کنیم که دنیا پر از نعمت و خوشی باشد، باز هم موش و مار که نماد موجودات ناقص و خطرناک هستند، همچنان خاکی و بی‌ارزش خواهند بود."],[667,"قسم او خاکست گر دی گر بهار","میر کونی خاک چون نوشی چو مار","اگر او بهاری شود و در زمان گرما بمیرد، خاک او همچون سمی خواهد بود که بر زمین ریخته می‌شود، همان‌گونه که مار زهرش را در زمین باقی می‌گذارد."],[667,"در میان چوب گوید کرم چوب","مر کرا باشد چنین حلوای خوب","در میان چوب، کرم چوب می‌گوید که این حلوای خوشمزه برای چه کسی است که من به آن رسیدم؟"],[667,"کرم سرگین در میان آن حدث","در جهان نقلی نداند جز خبث","کرم سرگین، که در محیط خزنده و ناپسند زندگی می‌کند، نمی‌تواند چیز دیگری جز پستی و زشتی را در جهان بشناسد."],[668,"ای خدای بی‌نظیر ایثار کن","گوش را چون حلقه دادی زین سخن","ای خدای منحصر به فرد، لطف کن و گوش ما را به‌گونه‌ای کن که مانند حلقه‌ای به این سخن متصل باشد و به آن توجه کند."],[668,"گوش ما گیر و بدان مجلس کشان","کز رحیقت می‌خورند آن سرخوشان","ما را بهشنو و به آن مجلس ببر که سرخوشان از حقیقت تو بهره‌مند می‌شوند."],[668,"چون به ما بویی رسانیدی ازین","سر مبند آن مشک را ای رب دین","ای پروردگار دین، چون بویی از خود به ما رساندی، آن مشک (عطر) را بر روی ما نبند و از ما دور نکن."],[668,"از تو نوشند ار ذکورند ار اناث","بی‌دریغی در عطا یا مستغاث","خواهش و دعا از تو پذیرفته می‌شود، چه از سوی مردان باشد و چه از زنان، زیرا تو در بخشش و عطا هیچ‌گونه دریغی نمی‌کنی و هر که به تو پناه آورد، نیازش برآورده می‌شود."],[668,"ای دعا ناگفته از تو مستجاب","داده دل را هر دمی صد فتح باب","ای دعا که به زبان نیاورده‌ام، ولی تو آن را مستجاب کردی و به قلب من هر لحظه گشایش‌های زیادی عطا کردی."],[668,"چند حرفی نقش کردی از رقوم","سنگ‌ها از عشق آن شد هم‌چو موم","چند کلمه از عشق را بر روی سنگ‌ها نقش کرده‌ای که این کلمات مانند موم نرم و شکل‌پذیر شده‌اند."],[668,"نون ابرو صاد چشم و جیم گوش","بر نوشتی فتنه صد عقل و هوش","حروف و شکل‌های یک انسان، از جمله ابرو (نون)، چشم (صاد) و گوش (جیم)، به گونه‌ای نوشته شده‌اند که باعث ایجاد فتنه و چالش برای عقل و ذهن می‌شوند. به عبارت دیگر، زیبایی این ویژگی‌ها آن‌قدر عمیق است که می‌تواند ذهن را مشغول کند و قدرت تفکر را به چالش بکشد."],[668,"زان حروفت شد خرد باریک‌ریس","نسخ می‌کن ای ادیب خوش‌نویس","از حروفی که نوشته‌ای، خرد و حکمت به شکل باریک و لطیف درآمده است؛ ای ادیب خوش‌نویس، آن را دوباره بنویس و از نو داستان بگو."],[668,"در خور هر فکر بسته بر عدم","دم به دم نقش خیالی خوش‌رقم","با توجه به هر فکر و اندیشه‌ای که به عدم و نیستی مربوط می‌شود، به طور مداوم تصویری زیبا و خیال‌انگیز بر آن نقش می‌بندد."],[668,"حرف‌های طرفه بر لوح خیال","بر نوشته چشم و عارض خد و خال","حرف‌های زیبایی بر روی تخیل نوشته شده که بر چهره و صورت معشوق، با زیبایی و زنندگی نقش بسته است."],[668,"بر عدم باشم نه بر موجود مست","زانک معشوق عدم وافی‌ترست","من می‌خواهم در نیستی بمانم نه در هستی، چرا که معشوق واقعی در نیستی بیشتر و کامل‌تر است."],[668,"عقل را خط‌ خوان آن اشکال کرد","تا دهد تدبیرها را زان نورد","عقل را به خاطر آن شکل‌های مختلفی که دارد، به عنوان مرجع و راهنما در نظر گرفت تا تدبیرها و پیشنهادات را از آن نور بگیرد و به دست آورد."],[669,"چون ملک از لوح محفوظ آن خرد","هر صباحی درس هر روزه برد","همان طور که هر روز صبح، ملک از لوح محفوظ دانایی و حکمت را دریافت می‌کند و درس جدیدی را یاد می‌گیرد، ما هم از خرد خودمون استفاده می‌کنیم."],[669,"بر عدم تحریرها بین بی‌بنان","و از سوادش حیرت سوداییان","در این بیت به افرادی اشاره شده که بدون داشتن نوشته‌ها و اسناد، حالتی از سرگشتگی و حیرت دارند. این افراد به خاطر عدم وضوح و سرگردانی، به دنبال معنای واقعی و دلایل زندگی خود هستند و در بی‌خبری و تردید به سر می‌برند."],[669,"هر کسی شد بر خیالی ریش گاو","گشته در سودای گنجی کنج‌کاو","هر کسی به خیال و تصور خودش متکی است و در حسرت دستیابی به گنج و ثروت است، درست مانند کسی که موهایش به مانند ریش گاو است."],[669,"از خیالی گشته شخصی پرشکوه","روی آورده به معدنهای کوه","سوداگران، انسان‌ها، در پندارشان خود را شخصی باوقار و با شرافت می‌بینند که به سمت معادن کوه رفته و ثروت به دست میاورد."],[669,"وز خیالی آن دگر با جهد مر","رو نهاده سوی دریا بهر در","دیگری پندارش به آنجا می‌کشد که، با تلاش و کوشش، به سوی دریا رفته است."],[669,"وآن دگر بهر ترهب در کنشت","وآن یکی اندر حریصی سوی کشت","یکی از دو نفر به خاطر رهایی و نجات به کنشت (مکانی مذهبی) می‌رود، و دیگری به خاطر طمع و حرص، به سمت کشتزار می‌رود."],[669,"از خیال آن ره‌زن رسته شده","وز خیال این مرهم خسته شده","[ترجمه ه م زیباست ولی هنوز مثال‌ها تمام نشده‌اند، ه م: از یاد آن دزد خیال رهایی یافته‌ام و از فکر این درمان نیز خسته شدم.] افراد دیگری اندیشه دزدی و راهزنی پیش می‌گیرند، و حتی دارو ماهیتش را گرفته."],[669,"در پری‌خوانی یکی دل کرده گم","بر نجوم آن دیگری بنهاده سم","در خانه‌ی پری (فرشته) خوانی، یکی دلش را گم کرده و در افکار آسمانی و نجومی است، در حالی که دیگری پاهایش را بر زمین گذاشته و در واقعیت مادی زندگی می‌کند."],[669,"این روشها مختلف بیند برون","زان خیالات ملون ز اندرون","روش‌های مختلفی که از بیرون دیده می‌شوند، ناشی از خیالات گوناگون و متنوعی است که در درون هر کس وجود دارد."],[669,"این در آن حیران شده کان بر چیست","هر چشنده آن دگر را نافیست","هر کسی در درک و فهم خود از واقعیت‌ها و امور زندگی مشابه است، اما هر چشنده یا تجربه‌کننده‌ای برداشت متفاوتی از آن دارد و یکی نمی‌تواند برداشت دیگری را نفی کند."],[669,"آن خیالات ار نبد نامؤتلف","چون ز بیرون شد روشها مختلف","اگر آن تخیلات به هم نمی‌پیوندند و نامنظم هستند، زمانی که از بیرون به درون می‌آیند، راه‌ها و مسیرهای مختلفی پیدا می‌کنند."],[669,"قبله جان را چو پنهان کرده‌اند","هر کسی رو جانبی آورده‌اند","چون قبله جان، یا هدف اصلی زندگی، پنهان است، هر کسی به سمتی منحصر به فرد گرایش پیدا کرده و به سوی آن می‌رود."],[670,"هم‌چو قومی که تحری می‌کنند","بر خیال قبله سویی می‌تنند","به گروهی اشاره دارد که در تاریکی یا در شرایط نامساعد تلاش می‌کنند تا در جهت قبله نماز بخوانند، ولی به خاطر عدم وضوح، به خیال خود در مسیر درست، به سوی قبله حرکت می‌کنند. این نشان‌دهنده تنهایی و گیجی آن‌هاست."],[670,"چونک کعبه رو نماید صبحگاه","کشف گردد که کی گم کردست راه","وقتی صبح می‌شود و خورشید طلوع می‌کند، مانند کعبه که نمایان می‌شود، مشخص می‌شود که چه کسی در تاریکی گم کرده بود که به کدام سمت برود."],[670,"یا چو غواصان به زیر قعر آب","هر کسی چیزی همی‌چیند شتاب","هر کسی مانند غواصانی که به عمق آب می‌روند، در حال جمع‌آوری و کسب چیزهایی است و این کار را با شتاب و سرعت انجام می‌دهد."],[670,"بر امید گوهر و در ثمین","توبره پر می‌کنند از آن و این","در انتظار پیدا کردن مروارید و چیزهای ارزشمند، غواصان کیسه‌های خود را از هر سو پر می‌کنند و به جمع‌آوری می‌پردازند."],[670,"چون بر آیند از تگ دریای ژرف","کشف گردد صاحب در شگرف","زمانی که از عمق دریاهای عمیق بیرون بیایند، فردی که دارای درایت و شناخت است، آشکار می‌شود."],[670,"وآن دگر که برد مروارید خرد","وآن دگر که سنگ‌ریزه و شبه برد","یکی از غواصان گران‌قدر، مرواریدهای ارزشمندی را از عمق دریا برداشت، در حالی که غواص دیگری فقط سنگ‌ریزه و چیزهای بی‌ارزش جمع‌آوری کرد. این بیانگر تفاوت در تلاش و همت افراد است."],[670,"هکذی یبلوهم بالساهره","فتنة ذات افتضاح قاهره","این بیت می‌گوید برخی افراد به وسیله فتنه‌ای بزرگ و وحشتناک آزمایش می‌شوند. این آزمایش به آنها نشان می‌دهد که در برابر مشکلات چگونه واکنش نشان می‌دهند و چه میزان از نیکوکاری و صداقت در درونشان وجود دارد."],[670,"هم‌چنین هر قوم چون پروانگان","گرد شمعی پرزنان اندر جهان","هر گروهی همچون پروانه‌ها به دور شمعی می‌چرخند و در این دنیا مشغول تلاشی هستند."],[670,"خویشتن بر آتشی برمی‌زنند","گرد شمع خود طوافی می‌کنند","مردم مانند پروانه‌ها به دور شمع خود می‌چرخند و به خاطر وجود آتش آن، به خود می‌سوزند و می‌سوزند."],[670,"بر امید آتش موسی بخت","کز لهیبش سبزتر گردد درخت","مردم به امید آتش موسی، که در اثر حرارت آن درختان سبزتر می‌شوند، به آن عشق و امید دارند. آتش موسی نماد کمال و روشنایی است که می‌تواند به زندگی و رشد کمک کند."],[670,"فضل آن آتش شنیده هر رمه","هر شرر را آن گمان برده همه","فضل آن آتش، که همان آتش موسی است، به شکل مثبتی بر روی هر دسته‌ای از رمه‌ها و شررها (ذرات آتش) عمل کرده و همه آن‌ها به نیکی و به بهبود وضعیت خود امیدوارند."],[670,"چون برآید صبحدم نور خلود","وا نماید هر یکی چه شمع بود","هنگامی که صبحگاهان سپیده دم فرا می‌رسد، نور جاودانگی آشکار می‌شود و هر کس به خوبی می‌بیند که چه کسی یا چه چیزی مانند شمع است."],[670,"هر کرا پر سوخت زان شمع ظفر","بدهدش آن شمع خوش هشتاد پر","هرکس که از نور شمع موفقیت سوخته باشد، آن شمع خوشبختی به او هشتاد بال می‌دهد."],[670,"جوق پروانه دو دیده دوخته","مانده زیر شمع بد پر سوخته","چشم‌ها مانند پروانه‌هایی هستند که زیر شعله شمعی (شمع عشق یا شمع الهی) گیر افتاده و سوخته‌اند و نمی‌توانند از آنجا بروند. این پروانه‌ها به محبت و زیبایی آن شمع دل بسته‌اند اما در عذاب و درد قرار دارند."],[670,"می‌تپد اندر پشیمانی و سوز","می‌کند آه از هوای چشم‌دوز","دل پروانه در حسرت و پشیمانی می‌زند و از درد عشق و تماشای محبوب، آه و ناله می‌کند."],[670,"شمع او گوید که چون من سوختم","کی ترا برهانم از سوز و ستم","شمع که نماد روشنی و هدایت است، در حال سوختن می‌گوید: وقتی خودم در آتش سوخته‌ام، چگونه می‌توانم تو را از درد و ظلم نجات دهم؟"],[670,"شمع او گریان که من سرسوخته","چون کنم مر غیر را افروخته","شمع (که می‌تواند نماد عشق یا روشنایی باشد) با اندوه می‌گوید که اگر خودم در حال سوختن هستم، چگونه می‌توانم به دیگران روشنی بدهم یا آن‌ها را روشن کنم."],[671,"او همی گوید که از اشکال تو","غره گشتم دیر دیدم حال تو","او می‌گوید که به خاطر ظاهر تو فریب خورده‌ام و مدت زیادی طول کشید تا حال واقعی تو را درک کنم."],[671,"شمع مرده باده رفته دلربا","غوطه خورد از ننگ کژبینی ما","شمعی که خاموش شده و باده‌ای که ناپدید گشته، دل‌ربایی که به خاطر دیدگاه نادرست ما در غم و اندوه فرورفته است."],[671,"ظلت الارباح خسرا مغرما","نشتکی شکوی الی الله العمی","ما خسارت‌ها و زیان‌های زیادی داریم و در غم و اندوه خود به درگاه خداوند شکایت می‌کنیم."],[671,"حبذا ارواح اخوان ثقات","مسلمات مؤمنات قانتات","ای کاش ارواح برادران مؤمن و راستکار، که تسلیم و مطیع خداوندند، در میان ما بودند."],[671,"هر کسی رویی به سویی برده‌اند","وان عزیزان رو به بی‌سو کرده‌اند","هر کسی به سمتی خاص گرایش و توجه دارد، اما آن عزیزان (بنی آدم) از این جهت به بی‌سویی (سرگردانی) رفته‌اند."],[671,"هر کبوتر می‌پرد در مذهبی","وین کبوتر جانب بی‌جانبی","هر کبوتر (پرنده) به سمتی می‌پرد که متعلق به مذهب یا عقیده خود است، اما این کبوتر (که منظورش انسان‌ها هستند) به سمتی می‌رود که بی‌جهت و بی‌هدف است."],[671,"ما نه مرغان هوا نه خانگی","دانه ما دانه بی‌دانگی","ما نه پرندگان آسمان هستیم و نه در خانه‌ای از دانه‌های مادی زندگی می‌کنیم؛ بلکه دانه ما، دانشی است که هنوز به آن دست نیافته‌ایم."],[671,"زان فراخ آمد چنین روزی ما","که دریدن شد قبادوزی ما","امروز به خاطر گسترگی و آزادی‌ای که داریم، مانند قبادوز (پرندگان و پرواز) شده‌ایم که می‌توانیم پرواز کنیم و از قید و بندها آزادیم."],[672,"صوفیی بدرید جبه در حرج","پیشش آمد بعد بدریدن فرج","صوفی‌ای جبه‌اش را در فشار پاره کرد و بعد از آن فرجی بر او عارض شد."],[672,"کرد نام آن دریده فرجی","این لقب شد فاش زان مرد نجی","آن مرد نجی (نیک‌ذات) که جبه‌اش را دریده بود، نامش را «فرجی» گذاشت و این عنوان به طور عمومی شناخته شد."],[672,"این لقب شد فاش و صافش شیخ برد","ماند اندر طبع خلقان حرف درد","این لقب، به‌طور عمومی و آشکار شد و شیخی (احتمالا اشاره به شخصیت معنوی یا روحانی) این لقب را صاف و بدون زحمت گرفت، اما سخن درد (مشکل یا مسأله) همچنان در دل مردم باقی ماند."],[672,"هم‌چنین هر نام صافی داشتست","اسم را چون دردیی بگذاشتست","هر نامی که به صافی (خوش‌طعم و با صفا) داده شده، مانند این است که نام «در» را برای بیماری گذاشته‌اند؛ یعنی ارتباط میان نام و چیزها بر اساس ویژگی‌هایی است که دارند."],[672,"هر که گل خوارست دردی را گرفت","رفت صوفی سوی صافی ناشکفت","هر کسی که به عشق و زیبایی‌ دست یابد و از آن لذت ببرد، به دردی دچار می‌شود. این شخص، مانند صوفی، به سوی حقیقت و معنای ناب می‌رود ولی هنوز نتوانسته به آن حقیقت واقعی دست یابد."],[672,"گفت لابد درد را صافی بود","زین دلالت دل به صفوت می‌رود","گفت حتما درد باید به خاطر هم‌نشینی با صافی (پاک و صاف) وجود داشته باشد، زیرا این رابطه باعث می‌شود که دل به سوی صفا و پاکی برود."],[672,"درد عسر افتاد و صافش یسر او","صاف چون خرما و دردی بسر او","درد و سختی که برای انسان پیش می‌آید به خاطر وجود راحتی و آسانی است. این آسانی مثل خرما خالص و بدون آلودگی است، در حالی که درد همچنان به تنهایی وجود دارد."],[672,"یسر با عسرست هین آیس مباش","راه داری زین ممات اندر معاش","درد و سختی با راحت و آسانی همیشه در کنار هم هستند، پس ناامید نباش. در زندگی، در این دنیا برای ادامه معیشت، راهی وجود دارد."],[672,"روح خواهی جبه بشکاف ای پسر","تا از آن صفوت برآری زود سر","ای پسر، اگر به دنبال روح پاک و خالص هستی، باید حجاب‌ها و موانع را کنار بزنی تا به حقیقت و صفای درون خود دست پیدا کنی."],[672,"هست صوفی آنک شد صفوت‌طلب","نه از لباس صوف و خیاطی و دب","صوفی واقعی کسی است که به جستجوی خلوص و پاکی روح می‌پردازد، نه کسی که فقط ظاهری از صوفیان دارد و به لباس و شغل‌هایی چون خیاطی و دوختن می‌پردازد."],[672,"صوفیی گشته به پیش این لئام","الخیاطه واللواطه والسلام","صوفی کسی است که در برابر این کارهای پست و شیادانه همچون خیاطی و لواطت قرار دارد و با این حال از آن‌ها دور نمی‌شود."],[672,"بر خیال آن صفا و نام نیک","رنگ پوشیدن نکو باشد ولیک","پوشیدن رنگ خوش و داشتن نام نیک در ظاهری زیبا بر اساس خیال و تصورات مثبت، کار خوبی است، اما این کافی نیست و تنها بر روی این افکار باقی ماندن حقیقتا ارزش ندارد."],[672,"بر خیالش گر روی تا اصل او","نی چو عباد خیال تو به تو","اگر فقط به خیال او (دوست یا معشوق) روی بیاوری و اصل و حقیقت او را نبینی، کاری بیفایده است، شبیه به عبادت که فقط خیال و تصور است و واقعیت در آن وجود ندارد."],[672,"دور باش غیرتت آمد خیال","گرد بر گرد سراپرده جمال","اگر غیرت تو به وجودت بیاید، دور شو، زیرا خیال تو در اطراف زیبایی او می‌گردد."],[672,"بسته هر جوینده را که راه نیست","هر خیالش پیش می‌آید بیست","هر کسی که در جستجوی هدف و خواسته‌اش باشد، اگر راهی برای رسیدن به آن نبیند، خیال‌های مختلف و گوناگونی به ذهنش خطور می‌کند."],[672,"جز مگر آن تیزکوش تیزهوش","کش بود از جیش نصرتهاش جوش","تنها آن کسی که هوشیار و زیرک است، می‌تواند از لابه‌لای ناملایمات و سختی‌ها به پیروزی و موفقیت برسد."],[672,"نجهد از تخییلها نی شه شود","تیر شه بنماید آنگه ره شود","تخیلات و خیال‌پردازی‌ها باعث نمی‌شود که شاه (مقصود، انسان یا خدا) به تیر بنگارد. وقتی او را ببینی، راه روشن می‌شود و هدایت حاصل می‌گردد."],[672,"این دل سرگشته را تدبیر بخش","وین کمانهای دوتو را تیر بخش","این دل سرگشته و بی‌قراری را تدبیر و مدیریت کن و این دو کمان (دو حالت یا وضعیت) را هم تیری برای رسیدن به هدف و مقصود قرار بده."],[672,"جرعه‌ای بر ریختی زان خفیه جام","بر زمین خاک من کاس الکرام","جرعه‌ای از آن جام پنهان را بر زمین ریختی که سبب افتخار من و معلمان است."],[672,"هست بر زلف و رخ از جرعه‌ش نشان","خاک را شاهان همی‌لیسند از آن","آثار جرعه‌ای که بر زمین ریخته شده، بر زلف و صورت می‌تابد و به همین دلیل است که شاهان نیز از خاک به خاطر آن می‌لیسند تا به جمال و زیبایی دست یابند."],[672,"جرعه حسنست اندر خاک گش","که به صد دل روز و شب می‌بوسیش","حسنت در خاک وجود دارد که با صد دل، شب و روز آن را می‌بوسند."],[672,"جرعه خاک آمیز چون مجنون کند","مر ترا تا صاف او خود چون کند","خاکی که با ذوق و عشق آمیخته است، مانند حال مجنون (عاشق دیوانه) تو را به شور و شوق می‌آورد و تو را به گونه‌ای پاک و صاف می‌کند."],[672,"هر کسی پیش کلوخی جامه‌چاک","که آن کلوخ از حسن آمد جرعه‌ناک","هر کسی که در برابر یک سنگ زیبا و دلنشین (کلوخ از حسن) قرار گیرد، به خاطر زیبایی آن به شدت تحت تأثیر قرار می‌گیرد و لباسش را پاره می‌کند (یعنی به نشانه عشق و شگفتی، از خود بی‌خود می‌شود)."],[672,"جرعه‌ای بر ماه و خورشید و حمل","جرعه‌ای بر عرش و کرسی و زحل","مقداری از آن حقیقت معنوی را که اشاره به ماه، خورشید، عرش، کرسی و سیاره زحل دارد، در خود جذب کن؛ یعنی از این موجودات بالاتر و والاتر، ذاتی زیبا و عمیق بگیر."],[672,"جرعه گوییش ای عجب یا کیمیا","که ز اسیبش بود چندین بها","این بیت به شگفتی از خاصیت و ارزش جرعه‌ای اشاره می‌کند که می‌تواند مانند کیمیا، تغییرات بزرگی ایجاد کند و از آن آسیب‌های زیادی به‌وجود آید. به‌طور کلی، این جرعه از چیزهایی است که بهای زیادی دارد و برکات و فوایدی از آن حاصل می‌شود."],[672,"جد طلب آسیب او ای ذوفنون","لا یمس ذاک الا المطهرون","به جست‌وجوی زیان و آسیب او برو، ای صاحب علم و هنر، زیرا آن آسیب را جز پاکان و پاکان نمی‌توانند لمس کنند."],[672,"جرعه‌ای بر زر و بر لعل و درر","جرعه‌ای بر خمر و بر نقل و ثمر","باید جرعه‌ای بر چیزهای باارزشی مانند طلا (زر)، سنگ‌های قیمتی (لعل و درر)، و همچنین نوشیدنی‌های خوشمزه مثل شراب (خمر) و شیره‌های میوه (نقل و ثمر) نثار کنیم."],[672,"جرعه‌ای بر روی خوبان لطاف","تا چگونه باشد آن راواق صاف","بیت به این معناست که اگر جرعه‌ای از زیبایی و خوش‌رویی خوبان (افراد زیبا و خوب) بر سطوح صاف و لطیف ریخته شود، مانند لباسی نازک و درخشان می‌شود. در واقع، تماشای زیبایی این افراد به دل و جان انسان لطافت و صفا می‌بخشد."],[672,"چون همی مالی زبان را اندرین","چون شوی چون بینی آن را بی ز طین","وقتی که زبان را در این دنیا می‌مالی و به آن توجه می‌کنی، چگونه می‌توانی آن را بدون تیره‌گی و آلودگی ببینی؟"],[672,"چونک وقت مرگ آن جرعه صفا","زین کلوخ تن به مردن شد جدا","زمانی که مرگ فرا می‌رسد، روح پاک و زنده انسان از این جسم خاکی و دنیوی جدا می‌شود."],[672,"آنچ می‌ماند کنی دفنش تو زود","این چنین زشتی بدان چون گشته بود","آنچه از این بدن باقی می‌ماند، یعنی روح یا جان، را زود دفن کن؛ چون این بدن زشت و بی‌ارزش شده است."],[672,"جان چو بی این جیفه بنماید جمال","من نتانم گفت لطف آن وصال","زمانی که جان انسان بدون این جسم خاکی و ناپسند (جیفه) نمایان شود، زیبایی من را نمی‌توانم با کلمات بیان کنم و فقط درک لطف آن وصل و پیوند را می‌توان احساس کرد."],[672,"مه چو بی‌این ابر بنماید ضیا","شرح نتوان کرد زان کار و کیا","ماه وقتی بدون این ابرها نمایان شود، نورش را می‌تاباند، اما نمی‌توان درباره آن کار و زیبایی‌اش توصیف کرد."],[672,"حبذا آن مطبخ پر نوش و قند","کین سلاطین کاسه‌لیسان ویند","ای کاش آن آشپزخانه سرشار از شیرینی و قند وجود داشت، زیرا شاهان مانند کاسه‌لیسان در آن، از خوشی و لذت بهره‌مند می‌شوند."],[672,"حبذا آن خرمن صحرای دین","که بود هر خرمن آن را دانه‌چین","عجب است آن انبار بزرگ در معارف دینی که هر بخشی از آن، دانه‌های حکمت و دانش را برای برداشت و استفاده در اختیار دارد."],[672,"حبذا دریای عمر بی‌غمی","که بود زو هفت دریا شب‌نمی","عمر بدون غم و مشکل، مانند دریایی وسیع و پربار و پر از نعمت است که از آن هفت دریا به وجود آمده است. این عمر خوشبختی و سرشار از برکت، نمادی از زندگی شاد و پر از Lعیش است."],[672,"جرعه‌ای چون ریخت ساقی الست","بر سر این شوره خاک زیردست","ساقی در عالم الست (عالم ارواح) جرعه‌ای به این خاک شور (یعنی بدن ما) می‌ریزد و به این ترتیب، زندگی و وجود ما را به وجود می‌آورد."],[672,"جوش کرد آن خاک و ما زان جوششیم","جرعه دیگر که بس بی‌کوششیم","این بیت اشاره به این دارد که خاکی که در ابتدا سخت و بی‌حرکت بود، حالا به لطف جوشش و حرکت، ما انسان‌ها از آن خمیره شکل گرفته‌ایم و به صورت یک سنگ و یا حالت ثابتی درآمده‌ایم. در واقع، ما همچنان نیازمند «جرعه‌ای» دیگر برای پیشرفت و تغییر هستیم، همان‌طور که در ابتدا از جوش و خروش خاک به وجود آمده‌ایم."],[672,"گر روا بد ناله کردم از عدم","ور نبود این گفتنی نک تن زدم","اگر ناله‌ای از روی بی‌وجودی و نیستی کرده‌ام، به خاطر این است که بی‌سبب این سخن را به زبان آورده‌ام و تن به زحمت ندادم."],[672,"این بیان بط حرص منثنیست","از خلیل آموز که آن بط کشتنیست","این سخن درباره تمایل و حرص من است و از خلیل (علیه‌السلام) آموختم که آن تمایل (حرص) موجب کشتن من خواهد شد."],[672,"هست در بط غیر این بس خیر و شر","ترسم از فوت سخنهای دگر","در این بیت، شاعر می‌گوید که خلاف انتظار در میان بط، خوب و بد بسیار وجود دارد و او از این می‌ترسد که مبادا نکات و سخن‌های دیگر از دست بروند."],[673,"آمدیم اکنون به طاوس دورنگ","کو کند جلوه برای نام و ننگ","اکنون به طاوس دو رنگ وارد شده‌ایم، که او به خاطر شهرت و اعتبارش جلوه‌گری می‌کند."],[673,"همت او صید خلق از خیر و شر","وز نتیجه و فایده آن بی‌خبر","خودخواهی طاوس در گرفتن مخلوقات از خوب و بد، او را از عواقب و نتایج کارش بی‌خبر می‌کند."],[673,"بی‌خبر چون دام می‌گیرد شکار","دام را چه علم از مقصود کار","کسی که در بی‌خبری دام می‌زند و شکار می‌کند، چه دانشی درباره هدف این کار دارد."],[673,"دام را چه ضر و چه نفع از گرفت","زین گرفت بیهده‌ش دارم شگفت","به چه دلیلی باید به دام فکر کرد، در حالی که از گرفتن آن نه ضرری می‌بینم و نه فایده‌ای. از این بی‌فایده گرفتن کاملا شگفت‌زده‌ام و نمی‌فهمم."],[673,"ای برادر دوستان افراشتی","با دو صد دلداری و بگذاشتی","ای برادر، تو دوستان را با دو صد محبت و دلجویی بالا بردی و از آن‌ها جدا کردی."],[673,"کارت این بودست از وقت ولاد","صید مردم کردن از دام وداد","کار تو از زمان تولد این بوده که مردم را به دام بیندازی و آن‌ها را آسیب برسانی."],[673,"زان شکار و انبهی و باد و بود","دست در کن هیچ یابی تار و پود","از شکار و خوش‌بو بودن انبه و نسیم، اگر دستت را دراز کنی، چیزی پیدا نمی‌کنی جز تار و پود. این به معنای آن است که در جستجوی لذت‌ها و زیبایی‌های ظاهری، ممکن است به واقعیت‌ها و عمق وجودی نرسیم."],[673,"بیشتر رفتست و بیگاهست روز","تو به جد در صید خلقانی هنوز","روز تو با جدیت بیشتری در صید و شکار انسان‌ها گذشته و این کار به اندازه‌ای طولانی شده که خیلی دیر است."],[673,"آن یکی می‌گیر و آن می‌هل ز دام","وین دگر را صید می‌کن چون لام","یکی را در دام می‌گیر و دیگری را می‌ترسانی، و آن یکی را به روشی دیگر شکار می‌کنی، مانند عمل لام که به تدریج و با دقت انجام می‌شود."],[673,"باز این را می‌هل و می‌جو دگر","اینت لعب کودکان بی‌خبر","این بار او را بترسان و به دنبال دگر بینداز، این تنها بازی بچه‌های بی‌خبر است."],[673,"شب شود در دام تو یک صید نی","دام بر تو جز صداع و قید نی","در شب، تو گرفتار دام خواهی شد و در واقع این دام، فقط به درد سر و محدودیت می‌انجامد و هیچ فایده‌ای ندارد."],[673,"پس تو خود را صید می‌کردی به دام","که شدی محبوس و محرومی ز کام","تو خودت را در دام‌ها صید می‌کردی و به همین دلیل به دام افتادی و از لذت‌ها محروم شدی."],[673,"در زمانه صاحب دامی بود","هم‌چو ما احمق که صید خود کند","در زمانه‌ای دامی وجود داشت که کسانی مانند ما احمق، خود را به دام می‌انداختند."],[673,"چون شکار خوک آمد صید عام","رنج بی‌حد لقمه خوردن زو حرام","وقتی شکار خوک برای صید عمومی آمد، به خاطر زحمتی که دارد، خوردن لقمه‌اش حرام است."],[673,"آنک ارزد صید را عشقست و بس","لیک او کی گنجد اندر دام کس","عشق تنها چیزی است که صید را ارزشمند می‌کند، اما این عشق در هیچ دام و حیله‌ای جا نمی‌شود."],[673,"تو مگر آیی و صید او شوی","دام بگذاری به دام او روی","اگر تو بیایی و شکار عشق شوی، باید دامی به عنوان فریب برای او بگذاری و در دام او بیفتی."],[673,"عشق می‌گوید به گوشم پست پست","صید بودن خوش‌تر از صیادیست","عشق به من می‌گوید که در مقام صید بودن، فراوانی و لذت بیشتری دارد تا اینکه در جایگاه صیاد باشم و دیگران را شکار کنم."],[673,"گول من کن خویش را و غره شو","آفتابی را رها کن ذره شو","خودت را فریب بده و به اشتباه خود را بزرگ تصور کن، اما به جای اینکه به آفتاب (عظمت و مقام بالا) تکیه کنی، خود را به مرتبه‌ای کوچک و حقیر (مانند ذره) تقلیل بده."],[673,"بر درم ساکن شو و بی‌خانه باش","دعوی شمعی مکن پروانه باش","در دل خود آرام بگیر و در عین حال بی‌خانمان و بی‌نظیر باش. ادعای شمع و نور نداشته باش، بلکه مانند پروانه، فقط به عشق نور بپرداز."],[673,"تا ببینی چاشنی زندگی","سلطنت بینی نهان در بندگی","اگر بخواهی لذت واقعی زندگی و سلطنت را تجربه کنی، باید بدان که این لذت در بندگی و خدمت به دیگران نهفته است."],[673,"نعل بینی بازگونه در جهان","تخته‌بندان را لقب گشته شهان","نعل، که به معنای یراق و آهنی است که به پای اسب زده می‌شود، در اینجا به معنای نماد یا نشانی از قدرت و سلطنت است. این بیت اشاره دارد به اینکه در دنیا، قدرت و سلطنت مانند نعل اسب به خویشتن می‌چسبد و به عنوان عنوانی برای پادشاهان شناخته می‌شود."],[673,"بس طناب اندر گلو و تاج دار","بر وی انبوهی که اینک تاجدار","این بیت به توصیف فردی پرداخته که در شرایط سخت و محنت‌بار قرار دارد. او در زیر فشار و ناملایمات زندگی، مانند کسی که طناب‌ و بار سنگینی بر گردن دارد، رنج می‌کشد، اما هنوز تاج‌دار و مقام‌دار است، به این معنا که موقعیت و مقام او قابل‌توجه است، حتی اگر در موقعیتی دشوار باشد."],[673,"هم‌چو گور کافران بیرون حلل","اندرون قهر خدا عز و جل","مثل قبر کافران که ظاهری زیبا دارد، درون آن از قهر و غضب خداوند پر است."],[673,"چون قبور آن را مجصص کرده‌اند","پرده پندار پیش آورده‌اند","چون قبور (مقابر) آن کافران را شفاف و نمایان کرده‌اند، پرده شک و پندار را جلو آورده‌اند."],[673,"طبع مسکینت مجصص از هنر","هم‌چو نخل موم بی‌برگ و ثمر","طبع مسکین تو به‌خاطر هنر، به‌گونه‌ای مجسم و نمایان است که شبیه نخل موم بدون برگ و میوه می‌باشد."],[674,"گفت درویشی به درویشی که تو","چون بدیدی حضرت حق را بگو","یک درویش به درویش دیگری می‌گوید: تو چگونه صورت خداوند را دیدی؟ بگو."],[674,"گفت بی‌چون دیدم اما بهر قال","بازگویم مختصر آن را مثال","بی مانند بود، اما برای بیان آن به صورت مختصر و ساده، مثالی را بازگو می‌کنم."],[674,"دیدمش سوی چپ او آذری","سوی دست راست جوی کوثری","او را به سمت چپ، آتش دوزخی و به سمت راست، جوی شیرین بهشت می‌بینم."],[674,"سوی چپش بس جهان‌سوز آتشی","سوی دست راستش جوی خوشی","در سمت چپ او آتشی قرار دارد که همه چیز را می‌سوزاند و در سمت راستش، جوی خوش و پربار وجود دارد که برای انسان شادی و لذت به ارمغان می‌آورد."],[674,"سوی آن آتش گروهی برده دست","بهر آن کوثر گروهی شاد و مست","به سمت آن آتش، گروهی به دام افتاده‌اند و برای دسترسی به آن آب حیات (کوثر)، گروهی دیگر شاد و سرمست هستند."],[674,"لیک لعب بازگونه بود سخت","پیش پای هر شقی و نیکبخت","لذت و شادی‌هایی که انسان‌ها تجربه می‌کنند، ممکن است در واقع فریبنده و مکارانه باشند؛ به طوری که این لذت‌ها تنها برای عده‌ای از افراد شقی (بدبخت) و نیکبخت (خوشبخت) در دسترس است و در واقع، نمی‌توان به سادگی از آن‌ها قضاوت کرد."],[674,"هر که در آتش همی رفت و شرر","از میان آب بر می‌کرد سر","هرکس که به سوی خطر می‌رود، در حالی که از آن مسیر داغ و آتشین می‌گذرد، با وجود آنکه در آب غوطه‌ور شده، باز هم شعله‌ای از آتش را از میان آب به بیرون می‌آورد."],[674,"هر که سوی آب می‌رفت از میان","او در آتش یافت می‌شد در زمان","هر کسی که به سمت آب می‌رفت، در واقع در دل او آتش وجود داشت و این موضوع در طول زمان آشکار می‌شد."],[674,"هر که سوی راست شد و آب زلال","سر ز آتش بر زد از سوی شمال","هر کسی که به سمت راست حرکت کرد و از آتش شمالی، آب زلال را به سر خود زد، به نوعی از خطر می‌گذرد یا نجات می‌یابد."],[674,"وانک شد سوی شمال آتشین","سر برون می‌کرد از سوی یمین","هرکس که به سمت شمال می‌رود، مانند آتش است و به طور غیرمستقیم، خود را از سمت راست (راستین) بیرون می‌آورد."],[674,"کم کسی بر سر این مضمر زدی","لاجرم کم کس در آن آتش شدی","کمتر کسی به راز این موضوع پی برد، بنابراین کمتر کسی در معرض آتش آن قرار گرفت."],[674,"جز کسی که بر سرش اقبال ریخت","کو رها کرد آب و در آتش گریخت","تنها کسی که از اقبال و شانس خوب خود برخوردار شده، قادر است از وضعیتی که او را به خطر می‌اندازد (آتش) فرار کند، در حالی که دیگران به بی‌خبر از عاقبت، در آب‌های خطرناک غرق می‌شوند."],[674,"کرده ذوق نقد را معبود خلق","لاجرم زین لعب مغبون بود خلق","خداوند ذوق و لذت حقیقی را فقط برای خود قرار داده است و به همین دلیل انسان‌ها در این بازی (دنیا) فریب خورده و مورد غفلت قرار گرفته‌اند."],[674,"جوق‌جوق و صف‌صف از حرص و شتاب","محترز ز آتش گریزان سوی آب","گروه گروه و صف‌صف مردم به خاطر حرص و شتاب، از آتش در حال فرار هستند و به سمت آب می‌روند."],[674,"لاجرم ز آتش برآوردند سر","اعتبارالاعتبار ای بی‌خبر","بنابراین، برای نجات از آتش، سر خود را به ناباوری برداشتند ای نادان."],[674,"بانگ می‌زد آتش ای گیجان گول","من نیم آتش منم چشمه قبول","آتش فریاد می‌زد که من علت درد و عذاب نیستم و شما را فریب می‌دهم؛ من در حقیقت چشمه‌ای هستم که می‌توانم پذیرش و قبول را در شما ایجاد کنم."],[674,"چشم‌بندی کرده‌اند ای بی‌نظر","در من آی و هیچ مگریز از شرر","ای کسی که بی‌توجه و بی‌فکر هستی، به من بیا و از آتش و خطر نترس، زیرا آنچه به نظر می‌رسد ممکن است فریبنده باشد."],[674,"ای خلیل اینجا شرار و دود نیست","جز که سحر و خدعه نمرود نیست","ای خلیل (ابراهیم) در اینجا آتش و دود واقعی وجود ندارد و آنچه می‌بینی تنها فریب و ترفند نمرود (دشمن ابراهیم) است."],[674,"چون خلیل حق اگر فرزانه‌ای","آتش آب تست و تو پروانه‌ای","چنان‌که ابراهیم خلیل (علیه‌السلام) در آتش نمرود صبور و آرام بود، اگر تو هم دانا و حکیمی، باید بدانی که آتش جهنم (دردها و سختی‌ها) در حقیقت می‌تواند برای تو مانند آب باشد، زیرا ممکن است تو نیز با عشق و شوق مانند پروانه به سوی نور و حقیقت پرواز کنی."],[674,"جان پروانه همی‌دارد ندا","کای دریغا صد هزارم پر بدی","پروانه دلش فریاد می‌زند که ای کاش من هزاران پر داشتم تا بتوانم بیشتر از آتش عشق جانم را قربانی کنم و از آن سوزش رهایی پیدا کنم."],[674,"تا همی سوزید ز آتش بی‌امان","کوری چشم و دل نامحرمان","پروانه که با عشق می‌سوزد و در آتش عشق محبوبش نابود می‌شود، به خاطر بی‌دردی و نادانی چشم و دل کسانی که به عشق آگاه نیستند، به آنها می‌گوید که از درک این عشق و سوزش آن بی‌بهره‌اند."],[674,"بر من آرد رحم جاهل از خری","من برو رحم آرم از بینش‌وری","جهل و نادانی انسان گاهی باعث می‌شود که انسان به من رحم کند، اما من از کسی که بینش و روشنایی دارد، رحم می‌آورم."],[674,"خاصه این آتش که جان آبهاست","کار پروانه به عکس کار ماست","این بیت به تضاد میان عشق و عقل اشاره دارد. پروانه به خاطر عشق به روشنایی آتش، جان خود را در خطر می‌اندازد و به سمت آتش می‌رود، در حالی که انسان‌ها معمولا از آتش و خطرات آن فراری هستند. این نشان‌دهنده این است که عشق، هرچند خطرناک، می‌تواند انسان را به اقداماتی وادارد که مخالف با عقل و منطق است."],[674,"او ببیند نور و در ناری رود","دل ببیند نار و در نوری شود","انسان می‌تواند در میان نور حقیقت، معنای واقعی را ببیند و به راه راست هدایت شود، اما اگر بخواهد فقط به ظاهریات نگاه کند، ممکن است در تاریکی و گمراهی قرار گیرد. به بیان دیگر، توجه به باطن و عمق موضوعات او را به روشنایی می‌رساند، در حالی که غفلت از آنها او را به اشتباه می‌برد."],[674,"این چنین لعب آمد از رب جلیل","تا ببینی کیست از آل خلیل","این گونه بازی و آزمایش از سوی خداوند بزرگ است تا بفهمی چه کسی از نسل ابراهیم خلیل (که به خاطر ایمان و دیانتش مشهور است) در این میدان امتحان، صداقت و ایمان واقعی دارد."],[674,"آتشی را شکل آبی داده‌اند","واندر آتش چشمه‌ای بگشاده‌اند","آتشی را به صورت آبی درآمده‌اند تا نشان دهد که در دل این آتش، چشمه‌ای نهفته وجود دارد. این بیان به تمثیلی از چهره‌های پنهان حق اشاره دارد که ممکن است چیزی که به نظر می‌رسد، فراتر از آنچه که قابل دیدن است، باشد."],[674,"ساحری صحن برنجی را به فن","صحن پر کرمی کند در انجمن","ساحری با مهارت و ترفند خاصی، صحن برنجی را به زیبایی زینت می‌دهد و آن را در مجلس خود پر از کرم و آلودگی می‌کند. این تصویر به نوعی به فریبندگی و نیرنگ اشاره دارد."],[674,"خانه را او پر ز کزدمها نمود","از دم سحر و خود آن کزدم نبود","ساحر با جادوی خود خانه را پر از کرم کرده، در حالی که خود کرمی در آنجا وجود ندارد و این کار او تنها نتیجه سحرش است."],[674,"چونک جادو می‌نماید صد چنین","چون بود دستان جادوآفرین","چون جادوگری با هنر و ترفند خود چیزها را به گونه‌ای نشان می‌دهد که حقیقی نیستند، دستان او نیز دارای قدرتی است که می‌تواند معجزه‌گونه جلوه کند."],[674,"لاجرم از سحر یزدان قرن قرن","اندر افتادند چون زن زیر پهن","بدون شک، به خاطر جادوی خداوند، در هر قرن افرادی مانند زنان در زیر بار سنگین گرفتار می‌شوند و به تباهی می‌افتند."],[674,"ساحرانشان بنده بودند و غلام","اندر افتادند چون صعوه به دام","ساحران فرعون، در واقع بندگان و غلامان خدا بودند، اما به دام فرونشستند و مثل پرنده‌ای که در دام گرفتار می‌شود، به سقوط دچار شدند."],[674,"هین بخوان قرآن ببین سحر حلال","سرنگونی مکرهای کالجبال","برو و قرآن بخوان و ببین که چگونه سحر حلال می‌تواند سبب سقوط و نابودی مکرها و حیله‌ها شود که مانند کوه‌ها بزرگ و سنگین هستند."],[674,"من نیم فرعون کایم سوی نیل","سوی آتش می‌روم من چون خلیل","من مثل فرعون نیستم که به سوی نیل (آب) بروم و به آتش نزدیک شوم، بلکه مانند ابراهیم خلیل (که اراده خدا را می‌پذیرد) هستم و به سمت خود آتش می‌روم."],[674,"نیست آتش هست آن ماء معین","وآن دگر از مکر آب آتشین","آتش وجود ندارد و آن آب معین (آب زلال) است که در واقع وجود دارد؛ اما آبی که به نظر می‌رسد، آتش است، در واقع از مکر و فریب است."],[674,"پس نکو گفت آن رسول خوش‌جواز","ذره‌ای عقلت به از صوم و نماز","آن پیامبر بزرگوار گفت که یک ذره از عقل و فهم شما ارزشش بیشتر از عبادت‌های ظاهری مانند روزه و نماز است."],[674,"زانک عقلت جوهرست این دو عرض","این دو در تکمیل آن شد مفترض","عقل تو مانند یک گوهر است که این دو ویژگی (لطف و قهر خدا) به عنوان مظاهر آن در تکمیل و زیبایی آن ضروری هستند."],[674,"تا جلا باشد مر آن آیینه را","که صفا آید ز طاعت سینه را","برای اینکه آیینه پاک و درخشان باشد، باید از طاعت و بندگی دل بهره‌مند شود تا صفا و روشنی به آن بیفزاید."],[674,"لیک گر آیینه از بن فاسدست","صیقل او را دیر باز آرد به دست","اگر آیینه از ابتدا خراب و معیوب باشد، تلاش برای صیقل دادن آن دیر یا زود به نتیجه‌ای نخواهد رسید."],[674,"وان گزین آیینه که خوش مغرس است","اندکی صیقل گری آن را بس است","پس باید آینه‌ای را انتخاب کنی که به خوبی خشک شده و از کیفیت بالایی برخوردار است؛ برای زیباتر و شفاف‌تر شدن آن، کمی صیقل دادن کافی است."],[675,"این تفاوت عقلها را نیک دان","در مراتب از زمین تا آسمان","این تفاوت در عقل‌ها را به‌خوبی درک کن؛ زیرا عقل‌ها در درجات و مراتب متفاوتی از پایین‌ترین سطح (زمین) تا بالاترین (آسمان) قرار دارند."],[675,"هست عقلی هم‌چو قرص آفتاب","هست عقلی کمتر از زهره و شهاب","عقل‌ها در اندازه‌ها و درجات مختلف وجود دارند؛ برخی از آنها به مانند خورشید درخشان و با عظمت هستند، در حالی که بعضی دیگر کمتر از زهره و ستاره‌های دنباله‌دار (شهاب) می‌درخشند."],[675,"هست عقلی چون چراغی سرخوشی","هست عقلی چون ستاره آتشی","بعضی عقل‌ها مانند یک چراغ پرنور و خوش‌سوز هستند اما بعضی دیگر مانند جرقه‌ای هستند که از آتش می‌جهد. (ستاره در اینجا یعنی جرقه و شراره‌ای که از آتش می‌پرد و فورا خاموش می‌شود)"],[675,"زانک ابر از پیش آن چون وا جهد","نور یزدان‌بین خردها بر دهد","چون ابرها از جلو نور خداوندی کنار بروند، خردها نیز به روشنی و دانایی خواهند رسید."],[675,"عقل جزوی عقل را بدنام کرد","کام دنیا مرد را بی‌کام کرد","آن چیزی که عقل و خرد را بدنام کرده‌است عقل جزوی و کوچک است و آنچه که آدمی را بی‌کام می‌کند هوس‌های دنیایی است."],[675,"آن ز صیدی حسن صیادی بدید","وین ز صیادی غم صیدی کشید","آن یکی از اینکه صید شد در نتیجه به صیادی رسید اما این‌یکی از حریص و صیاد بودن در دام افتاد."],[675,"آن ز خدمت ناز مخدومی بیافت","وآن ز مخدومی ز راه عز بتافت","آن یکی از خدمت کردن به مقام سروری و مخدومی رسید اما این‌ از غرور ریاست و مخدومی، پست شد و عزت و بزرگی را از دست داد."],[675,"آن ز فرعونی اسیر آب شد","وز اسیری سبط صد سهراب شد","برخی از افراد به واسطه سرنوشت خود و در شرایط سخت و دشوار به نتایج متفاوتی می‌رسند. یکی از آنها اسیر فرعون و دیگری از نسل سهراب، که این خود نشان‌دهنده شرایط اجتماعی و فردی متفاوت آنهاست."],[675,"لعب معکوسست و فرزین‌بند سخت","حیله کم کن کار اقبالست و بخت","بازی‌های ذهنی معکوس و نقشه‌سازی، کار را سخت می‌کند؛ بنابراین، ترفندها را کمتر به کار ببر، چون خوش‌بختی و اقبال به سادگی به دست می‌آید."],[675,"بر خیال و حیله کم تن تار را","که غنی ره کم دهد مکار را","بر خیال و نیرنگ خود تأکید نکن، زیرا توانگری (ثروت) به کسی که فریبکار است، کمکی نمی‌کند."],[675,"مکر کن در راه نیکو خدمتی","تا نبوت یابی اندر امتی","مکر و چاره‌اندیشی را برای خدمت و کارهای نیک به‌کار ببر تا از راه مردمی بودن به مقام نبوت و والا برسی."],[675,"مکر کن تا وا رهی از مکر خود","مکر کن تا فرد گردی از جسد","مکر و حیله‌ات را در این به‌کار ببر تا از خودپرستی رها شوی و چاره‌اندیشی کن که از دست جسم و هوس‌های جسمانی خلاص شوی."],[675,"مکر کن تا کمترین بنده شوی","در کمی رفتی خداونده شوی","اگر حقه‌بازی کنی، به کمترین مرتبه از بندگی خواهی رسید و با کم‌توجّهی و فریب خود به مقام خدایی نزدیک خواهی شد."],[675,"روبهی و خدمت ای گرگ کهن","هیچ بر قصد خداوندی مکن","هیچوقت حیله و چاره‌اندیشی و کار خوب را در این راه به‌کار مبر که به ریاست و مقام برسی."],[675,"لیک چون پروانه در آتش بتاز","کیسه‌ای زان بر مدوز و پاک باز","اما همچون پروانه در آتش بتاز و بدون توقع و چشمداشت، پاکباز باش."],[675,"زور را بگذار و زاری را بگیر","رحم سوی زاری آید ای فقیر","به جای تکیه بر نیروی جسمی و توانایی‌های ظاهری، بر زاری و حال درونی تأکید کن. رحمت و عنایت خداوند به کسانی می‌رسد که با دل شکسته و نیازمندی زاری می‌کنند، ای کسی که در نیاز هستی."],[675,"زاری مضطر تشنه معنویست","زاری سرد دروغ آن غویست","زاری که از روی اضطرار و تشنگی معنوی است، واقعی و ارزشمند است، اما زاری که از روی فریب و دروغ باشد، بی‌اهمیت و توخالی است."],[675,"گریه اخوان یوسف حیلتست","که درونشان پر ز رشک و علتست","گریه برادران یوسف در واقع نیرنگ و فریب است، زیرا در باطن آن‌ها نفرت و حسد وجود دارد."],[676,"آن سگی می‌مرد و گریان آن عرب","اشک می‌بارید و می‌گفت ای کرب","سگ آن اعرابی در حال مرگ بود و او به شدت گریه می‌کرد و می‌گفت ای محنت بزرگ."],[676,"سایلی بگذشت و گفت این گریه چیست","نوحه و زاری تو از بهر کیست","یکی از رهگذران عبور کرد و پرسید این گریه و زاری که می‌کنی برای چیست و برای چه کسی است؟"],[676,"گفت در ملکم سگی بد نیک‌خو","نک همی‌میرد میان راه او","اعرابی در پاسخ به سوال سایلی می‌گوید که در سرزمین او سگی نیکو و خوب وجود دارد که اکنون در حال مرگ است."],[676,"روز صیادم بد و شب پاسبان","تیزچشم و صیدگیر و دزدران","در روز، من شکارچی بدی هستم و در شب، نگهبانی باهوش و چابک که هم به شکار می‌روم و هم از دزدان محافظت می‌کنم."],[676,"گفت رنجش چیست زخمی خورده است","گفت جوع الکلب زارش کرده است","او (اعرابی) می‌گوید که رنج سگش چیست، و پاسخ می‌دهد که سگ به خاطر گرسنگی رنج می‌برد و زارش کرده است."],[676,"گفت صبری کن برین رنج و حرض","صابران را فضل حق بخشد عوض","گفت صبر کن بر این رنج و دل‌تنگی، زیرا خداوند به صابران پاداش و نعمت می‌دهد."],[676,"بعد از آن گفتش کای سالار حر","چیست اندر دستت این انبان پر","سپس شخصی به او گفت: ای سرپرست و فرمانده، این کیسه پر از چه چیزی است که در دستت داری؟"],[676,"گفت نان و زاد و لوت دوش من","می‌کشانم بهر تقویت بدن","او می‌گوید که شب گذشته نان و مایحتاج دیگری را به دوش خود بردم تا برای تقویت بدنم استفاده کنم."],[676,"گفت چون ندهی بدان سگ نان و زاد","گفت تا این حد ندارم مهر و داد","اعرابی می‌گوید که چون تو به آن سگ نانی و غذایی نمی‌دهی، من هم تا این حد نسبت به او عشق و محبت ندارم."],[676,"دست ناید بی‌درم در راه نان","لیک هست آب دو دیده رایگان","او نمی‌تواند بدون پرداختن به زحمت و هزینه‌ای، غذا به دست بیاورد و نان بخورد، اما گریه و اشک او برای سگش که گرسنه است، به رایگان و بدون دردسر به همراه دارد."],[676,"گفت خاکت بر سر ای پر باد مشک","که لب نان پیش تو بهتر ز اشک","ای کسی که به عنوان بزرگ‌منشی و خودپسندی، در دل پر از غرور و خودخواهی هستی، به تو می‌گویم که خاک بر سرت باد، زیرا اینکه نانی که می‌توانی به سگت بدهی برای او از اشک‌هایی که می‌ریزی ارزشمندتر است."],[676,"اشک خونست و به غم آبی شده","می‌نیرزد خاک خون بیهده","اشک انسان همانند خون است و به خاطر غم، رنگش به آبی تغییر کرده؛ اما در واقع خاک و خون، بی‌دلیل و بی‌فایده‌اند."],[676,"کل خود را خوار کرد او چون بلیس","پاره این کل نباشد جز خسیس","او تمام زندگی‌اش را بی‌ارزش کرد، مانند ابلیس که از نعمت‌های الهی محروم مانده است؛ زیرا از این کل، تنها چیزی که باقی مانده، انسان بخیل و تنخواه است."],[676,"من غلام آنک نفروشد وجود","جز بدان سلطان با افضال و جود","من، بنده کسی هستم که وجودش را به کسی نمی‌فروشد و فقط به خاطر آن سلطان بزرگ که بخشش و کرامت دارد، حاضر به خدمت و بندگی می‌شود."],[676,"چون بگرید آسمان گریان شود","چون بنالد چرخ یا رب خوان شود","وقتی که او (اعرابی) گریه کند، آسمان هم به گریه می‌افتد و زمانی که او فریاد می‌زند، چرخ (مدار روزگار) هم می‌گوید: ای پروردگار!"],[676,"من غلام آن مس همت‌پرست","کو به غیر کیمیا نارد شکست","من در خدمت کسی هستم که به غیر از طلا و ثروت مادی، به عشق و آرمان‌های بلند اهمیت می‌دهد و هرگز زیر بار شکست نمی‌رود."],[676,"دست اشکسته برآور در دعا","سوی اشکسته پرد فضل خدا","دستانت را برای دعا به سمت خدا بلند کن، همان‌طور که دل شکسته‌ات را برای دریافت فضل و رحمت او آماده کرده‌ای."],[676,"گر رهایی بایدت زین چاه تنگ","ای برادر رو بر آذر بی‌درنگ","اگر می‌خواهی از این چاه تنگ نجات پیدا کنی، ای برادر، بدون درنگ به آتش برو."],[676,"مکر حق را بین و مکر خود بهل","ای ز مکرش مکر مکاران خجل","به مکر و تدبیر خدا توجه کن و تدبیر خود را رها کن، ای کسی که از مکر خداوند به دلیل مکر دیگران شرمنده‌ای."],[676,"چونک مکرت شد فنای مکر رب","برگشایی یک کمینی بوالعجب","وقتی مکر و فریب تو از بین رفت و مکر خداوند آشکار شد، باید با شگفتی به آن حقیقتی که در کمین توست، توجه کنی."],[676,"که کمینه آن کمین باشد بقا","تا ابد اندر عروج و ارتقا","کمینه، یعنی آن چیزی که اندک است، باید در کمین بماند و این بقا و ماندگاری آن، تا همیشه در حال پیشرفت و ترقی خواهد بود."],[677,"پر طاوست مبین و پای بین","تا که سؤ العین نگشاید کمین","ظاهر پر طاووس را نبین و پای او را ننگر، زیرا چشم بدی به سراغت نمی‌آید مگر آنکه خودت را در کمین آن بگذاری."],[677,"که بلغزد کوه از چشم بدان","یزلقونک از نبی بر خوان بدان","اگر کوه به خاطر دیدن چشم‌های بدی که به سویش می‌نگرند، بلرزد، تو نیز که از نبی (پیامبر) به سمت او خوانده شده‌ای، نمی‌توانی از این نگاه بد ایمن باشی."],[677,"احمد چون کوه لغزید از نظر","در میان راه بی‌گل بی‌مطر","احمد (احمد از شخصیت‌های مهم عرفان اسلامی است) وقتی که در مسیر دچار لغزش می‌شود، مانند کوه از نظر می‌افتد و در این حال نه گل وجود دارد و نه بارانی می‌بارد؛ این وضعیت نشان‌دهنده عدم وجود زیبایی و برکت در آن لحظه است."],[677,"در عجب درماند کین لغزش ز چیست","من نپندارم که این حالت تهیست","احمد، که به حالت حیرت و درماندگی رسیده، از خود می‌پرسد که چرا این لغزش (یعنی سقوط) پیش آمده است و نمی‌تواند بپذیرد که این بی‌حالی و وضعیت خالی از احساس است."],[677,"تا بیامد آیت و آگاه کرد","کان ز چشم بد رسیدت وز نبرد","چشم بد به تو آسیب نمی‌زند و ضرر نمی‌رساند، مگر اینکه خودت با دیدن زیبایی‌ها، چشمت به نور حق تغییر کرده و از خود بی‌خود شده باشی."],[677,"گر بدی غیر تو در دم لا شدی","صید چشم و سخره افنا شدی","اگر بدی غیر از تو وجود نداشت، در آن صورت تو به دام چشم دیگران گرفتار و به سخره فنا و نابودی می‌رفتی."],[677,"لیک آمد عصمتی دامن‌کشان","وین که لغزیدی بد از بهر نشان","اما با این حال، وجود خصلتی پاک و معصوم (عصمت) به انسان کمک می‌کند تا از خطا و لغزش دور بماند و این نشان می‌دهد که اگر انسان به سمت بدی برود، این کار به خاطر نشانه‌های نادرست و فریبنده است."],[677,"عبرتی گیر اندر آن که کن نگاه","برگ خود عرضه مکن ای کم ز کاه","توجه کن به اینکه نگاه کردن به خودت و ظاهر خدایی نکرده، تو را غافل نکند و از وضعیت واقعی‌ات دور نکند؛ چرا که ممکن است ارزش تو کمتر از یک کاه باشد."],[678,"یا رسول‌الله در آن نادی کسان","می‌زنند از چشم بد بر کرکسان","ای پیامبر خدا، در آن حال که کسان به تو زنگ می‌زنند، از ترس چشم زخم بر کرکس‌ها (پرنده‌های بی‌خطر) تأکید می‌کنند."],[678,"از نظرشان کله شیر عرین","وا شکافد تا کند آن شیر انین","چشم‌های حسودان چنان به تو خیره می‌شود که ممکن است سرت را بشکنند، و در نتیجه، آن شیر، یعنی تو، از درد و غمی که به تو می‌رسد، ناله می‌کند."],[678,"بر شتر چشم افکند هم‌چون حمام","وانگهان بفرستد اندر پی غلام","توجه او به شتر مانند توجه یک کبوتر به همدم خود است و ناگهان بادی می‌وزد که او را به طرف غلامی می‌فرستد."],[678,"که برو از پیه این اشتر بخر","بیند اشتر را سقط او راه بر","مردم در حال تماشا به اشتر (که به نظر می‌رسد به حالتی خاص افتاده) هستند و کسی به او می‌گوید که از پی آن اشتر برو و از گوشت او (پیه او) بخر. به نوعی، این اشاره به این دارد که آن اشتر به حالت بدی دچار شده و باید از آن بهره‌برداری شود."],[678,"سر بریده از مرض آن اشتری","کو بتگ با اسب می‌کردی مری","سر بریده و زخمی آن شتر ناشی از بیماری است که تو با اسب به او می‌گفتی مری (یعنی بیمار). در واقع، این اشاره به وضعیتی دارد که شتر به خاطر حسادتی که وجود دارد، نتوانسته است به حال خود ادامه دهد و مورد آسیب قرار گرفته است."],[678,"کز حسد وز چشم بد بی‌هیچ شک","سیر و گردش را بگرداند فلک","بخاطر حسادت و چشم‌زخم، بدون هیچ شکی، گردش و حرکت را در آسمان تغییر می‌دهد."],[678,"آب پنهانست و دولاب آشکار","لیک در گردش بود آب اصل کار","آب به طور پنهان وجود دارد و دالان یا لوله‌ای که آب را به نمایش می‌گذارد آشکار است، اما در واقع این آب، اساسی‌ترین عامل و عامل اصلی در این گردش و حرکت است."],[678,"چشم نیکو شد دوای چشم بد","چشم بد را لا کند زیر لگد","چشم خوب و زیبا، درمانی برای چشم زشت و بد است؛ زیرا چشم بد را زیر پا می‌گذارد و از بین می‌برد."],[678,"سبق رحمت‌راست و او از رحمتست","چشم بد محصول قهر و لعنتست","رحمت بر قهر و لعنت پیشی دارد و اساسا خود رحمت الهی است، در حالی که چشم بد نتیجه قهر و نفرین است."],[678,"رحمتش بر نقمتش غالب شود","چیره زین شد هر نبی بر ضد خود","رحمت خدا بر مجازات او برتری می‌یابد، و از این رو، هر پیامبری بر دشمنان و مخالفان خود غلبه می‌کند."],[678,"کو نتیجه رحمتست و ضد او","از نتیجه قهر بود آن زشت‌رو","نتیجه رحمت، زیبایی و خوبی است، در حالی که نتیجه قهر، زشتی و بدی می‌آورد. در این بیت به تضاد میان رحمت و قهر اشاره شده است و می‌گوید که دشمنان خدا به زشتی و قهر دچار می‌شوند."],[678,"حرص بط یکتاست این پنجاه تاست","حرص شهوت مار و منصب اژدهاست","حرص و تمایل به مال، مانند پرنده‌ای است که فقط یک عدد از آن وجود دارد، اما حرص و تمایل به شهوت مانند ماری است که در تعداد بیشماری وجود دارد، و حرص به مقام و منصب همانند اژدهایی است که از نظر قدرت و خطر بسیار بزرگ و تهدیدکننده است."],[678,"حرص بط از شهوت حلقست و فرج","در ریاست بیست چندانست درج","حرص و طمع در مقام و ثروت به اندازه‌ای است که می‌توان آن را ناشی از شهوت و خواسته‌های نفسانی دانست، و این حرص برای دستیابی به ریاست و قدرت از شدت بیشتری برخوردار است."],[678,"از الوهیت زند در جاه لاف","طامع شرکت کجا باشد معاف","از مقام الوهیت و خداوندی در جهل و نداشته لاف زدن، نشانگر طمع در شریک شدن در قدرت و جاه است، که در این حالت شخص هیچ معافیتی ندارد."],[678,"زلت آدم ز اشکم بود و باه","وآن ابلیس از تکبر بود و جاه","زلت و سقوط آدم (علیه‌السلام) به خاطر اشک و توبه‌اش بود، اما ابلیس به خاطر تکبر و خودپسندی‌اش به سقوط افتاد."],[678,"لاجرم او زود استغفار کرد","وآن لعین از توبه استکبار کرد","آدم به سرعت از خداوند طلب بخشش کرد، اما ابلیس به خاطر تکبرش هیچ تلاشی برای توبه نکرد."],[678,"حرص حلق و فرج هم خود بدرگیست","لیک منصب نیست آن اشکستگیست","حرص و تمایل به لذت‌های دنیوی، هم مانند بیماری است، اما مقام و موقعیت اجتماعی چیزی نیست که چنین ضعف‌هایی بتواند آن را تحت تأثیر قرار دهد."],[678,"بیخ و شاخ این ریاست را اگر","باز گویم دفتری باید دگر","اگر بخواهم ریشه و اساس این مقام و ریاست را بگوییم، پس باید دفتر و کتابی دیگر آغاز کنم، چون توضیحاتش بسیار گسترده و عمیق است."],[678,"اسپ سرکش را عرب شیطانش خواند","نی ستوری را که در مرعی بماند","عرب‌ها به اسب‌های سرکش و یاغی نام «شیطان» داده‌اند، در حالی که اسب‌هایی که در چراگاه‌ها مانده و رام هستند، چنین نامی ندارند."],[678,"شیطنت گردن کشی بد در لغت","مستحق لعنت آمد این صفت","شیطنت و گردن‌کشی ویژگی‌هایی ناپسند و زشت هستند که در زبان، مورد نکوهش قرار گرفته‌اند و مستحق لعنت به شمار می‌آیند."],[678,"صد خورنده گنجد اندر گرد خوان","دو ریاست‌جو نگنجد در جهان","صدها نفر که حاضر به استفاده از نعمت‌ها هستند، در اطراف یک سفره می‌توانند جای بگیرند، اما دو نفر که به دنبال ریاست و مقامند، نمی‌توانند در یک دنیا جا شوند."],[678,"آن نخواهد کین بود بر پشت خاک","تا ملک بکشد پدر را ز اشتراک","این دنیا تا زمانی که پادشاهی (ملک) وجود داشته باشد، به ارث نمی‌رسد و نمی‌توان به شکل مشترک بر آن تکیه کرد، زیرا فرزند پادشاه نمی‌تواند به خاطر میراث پدرش از دیگران جدا شود."],[678,"آن شنیدستی که الملک عقیم","قطع خویشی کرد ملکت‌جو ز بیم","شاید شنیده‌باشی که ملک (پادشاهی) برای این که نازا و بی‌فرزند است، از وابستگی‌ها و خویشاوندی‌ها خودداری می‌کند تا از ترس نابودی قدرتش، از وابستگی‌ها دور شود."],[678,"که عقیمست و ورا فرزند نیست","هم‌چو آتش با کسش پیوند نیست","ای کسی که بی‌فرزند و عقیم هستی، مانند آتش که با کسی پیوند ندارد و رابطه‌ای صمیمی برقرار نمی‌کند، تو هم هیچ ارتباط و دوستی با دیگران نداری."],[678,"هر چه یابد او بسوزد بر درد","چون نیابد هیچ خود را می‌خورد","هر چیزی که او به دست آورد، آن را به خاطر درد خود می‌سوزاند و چون چیزی نیابد، به خودش آسیب می‌زند و می‌خورد."],[678,"هیچ شو وا ره تو از دندان او","رحم کم جو از دل سندان او","انسان نباید به دندان‌ها و قدرت کسانی که حس حسادت یا کینه دارند، توجه کند و از آن‌ها بترسد، زیرا آن‌ها تنها می‌توانند ظاهر را تهدید کنند و نباید دل را به شرایط سخت و فشارهای زندگی به خاطر آن‌ها بسپاریم."],[678,"چونک گشتی هیچ از سندان مترس","هر صباح از فقر مطلق گیر درس","اگر از سندان، که به معنای مجازا دشواری‌ها و مشکلات است، ترسی نداشته باشی، هر روز از وضعیت فقر مطلق درسی بگیر و عبرت آموز."],[678,"هست الوهیت ردای ذوالجلال","هر که در پوشد برو گردد وبال","الوهیت و بزرگی الهی همچون لباس زیبایی است که اگر کسی آن را بپوشد، مسؤولیت‌های سنگینی بر دوش او خواهد بود."],[678,"تاج از آن اوست آن ما کمر","وای او کز حد خود دارد گذر","تاج، که نماد قدرت و عظمت است، از آن خداوند است و ما تنها کمر خود را به آن بسته‌ایم. خداوند او (انسان) را فراتر از حد و مرزهای خود متجاوز می‌سازد."],[678,"فتنه تست این پر طاووسیت","که اشتراکت باید و قدوسیت","فتنه‌ای که تو را آزمایش می‌کند، از زیبایی و فخر توست؛ زیرا باید بین اشتراک و قدس (پاکی و خلوص) هماهنگی ایجاد شود."],[679,"پر خود می‌کند طاوسی به دشت","یک حکیمی رفته بود آنجا بگشت","یک طاوس در دشت پرهای زیبا و درخشانش را جابه‌جا می‌کرد و حکیمی به آنجا رفته بود و به طوطی توجه می‌کرد."],[679,"گفت طاوسا چنین پر سنی","بی‌دریغ از بیخ چون برمی‌کنی","طاوس گفت: ای طاوس! چنین پر باارزش را بی‌دریغ از ریشه‌اش می‌کنی."],[679,"خود دلت چون می‌دهد تا این حلل","بر کنی اندازیش اندر وحل","دل تو مانند عنبر است که وقتی به چیزی زیبا می‌نگرد و آن را می‌بیند، این زیبایی را در درونش می‌سوزاند و می‌کوشد آن را به دیگران بیفزاید."],[679,"هر پرت را از عزیزی و پسند","حافظان در طی مصحف می‌نهند","هر پر (پر طاووس) را از عزیزان و کسانی که آن را دوست دارند، در کتابی (مصحف) زینت می‌بخشند و نگهداری می‌کنند."],[679,"بهر تحریک هوای سودمند","از پر تو بادبیزن می‌کنند","برای تحریک و جلب هوای خوش و سودمند، از پر تو بادبیزن (نوعی براق و زیبا) درست می‌کنند."],[679,"این چه ناشکری و چه بی‌باکیست","تو نمی‌دانی که نقاشش کیست","این چه نوع کفران و بی‌احترامی است که تو نسبت به زیبایی و هنری که می‌بینی، بی‌پروا برخورد می‌کنی؟ آیا نمی‌دانی خالق و هنرمند آن زیبایی کیست؟"],[679,"یا همی‌دانی و نازی می‌کنی","قاصدا قلع طرازی می‌کنی","آیا تو می‌دانی که چه کار می‌کنی و با ناز و فخر خود دیگران را آزار می‌دهی و خود را در ظاهری زیبا به نمایش می‌گذاری؟"],[679,"ای بسا نازا که گردد آن گناه","افکند مر بنده را از چشم شاه","بسیاری از افرادی که فرزندی ندارند، به خاطر اشتباهی که انجام می‌دهند، ممکن است مورد بی‌توجهی و قضاوت منفی دیگران قرار بگیرند و این باعث می‌شود که از چشم مقامات و قدرت‌ها بیفتند."],[679,"ناز کردن خوشتر آید از شکر","لیک کم خایش که دارد صد خطر","نواختن و ناز کردن زیباتر از شیرینی است، اما ناز کردن معایب و خطرات زیادی به همراه دارد."],[679,"ایمن آبادست آن راه نیاز","ترک نازش گیر و با آن ره بساز","راهی که به ایمنی و آرامش می‌رسد، همان راه نیاز است. پس از ناز و خودخواهی دست بردار و با این مسیر سازگار باش."],[679,"ای بسا نازآوری زد پر و بال","آخر الامر آن بر آن کس شد وبال","افرادی که به زیبایی‌ها و ناز و کرشمه‌ها، به‌ویژه در رابطه‌های عاطفی، وابسته می‌شوند، در نهایت ممکن است همان زیبایی‌ها بر آن‌ها سنگینی کنند و دردسرساز شوند."],[679,"خوشی ناز ار دمی بفرازدت","بیم و ترس مضمرش بگدازدت","اگر خوشی و ناز و زیبایی تو را به شادمانی برساند، باید بدان که در دل آن، بیم و ترسی نهفته است که ممکن است تو را دچار دردسر کند."],[679,"وین نیاز ار چه که لاغر می‌کند","صدر را چون بدر انور می‌کند","این نیاز (عشق و اشتیاق) اگرچه انسان را لاغر می‌کند و او را پژمرده به نظر می‌آورد، اما مانند ماه درخشان است که زیبایی و نور می‌بخشد."],[679,"چون ز مرده زنده بیرون می‌کشد","هر که مرده گشت او دارد رشد","هر کسی که از حالتی مرده به حالت زنده برمی‌گردد، نشان‌دهنده این است که او در مسیر رشد و پیشرفت است."],[679,"چون ز زنده مرده بیرون می‌کند","نفس زنده سوی مرگی می‌تند","نفس زنده، یعنی روح یا زندگی واقعی، می‌تواند از وجود یک زنده (موجود زنده) چیزی مرده و غیر فعال را خارج کند، و این به معنای آن است که زندگی واقعی می‌تواند موجب مرگ باطنی و روحی افراد بشود."],[679,"مرده شو تا مخرج الحی الصمد","زنده‌ای زین مرده بیرون آورد","برای اینکه به حقیقت جاودانی و زنده برسید، باید از حالت مردگی رهایی یابید، زیرا تنها از این وضعیت مرده است که موجود زنده‌ای چون خداوند، که زنده‌ای بی‌نهایت و مقدس است، بروز می‌کند."],[679,"دی شوی بینی تو اخراج بهار","لیل گردی بینی ایلاج نهار","اگر در گلی زندگی کنی، آن‌گاه به روشنی می‌بینی که چگونه بهار به دنیای تو می‌آید و شب را به صبح می‌رساند."],[679,"بر مکن آن پر که نپذیرد رفو","روی مخراش از عزا ای خوب‌رو","از آن پر زیبا که نمی‌تواند ترمیم شود، دست برندار، ای خوب‌رو، تا روی‌ات از غم زخم نگیرد."],[679,"آنچنان رویی که چون شمس ضحاست","آنچنان رخ را خراشیدن خطاست","این بیت بیان می‌کند که بر روی زیبا و نورانی مانند روی خورشید، هر گونه خراش و آسیب زدن نادرست است و نباید اتفاق بیفتد."],[679,"زخم ناخن بر چنان رخ کافریست","که رخ مه در فراق او گریست","خراشیدن یا زخم زدن بر چنین چهره زیبایی، مانند صورت ماه، کار ناپسندی است؛ زیرا چهره ماه به خاطر دوری از آن زیبایی، گریه کرده است."],[679,"یا نمی‌بینی تو روی خویش را","ترک کن خوی لجاج اندیش را","اگر خود را نمی‌بینی و از حقیقت وجودی‌ات غافل هستی، پس باید خودخواهی و لجاجت را کنار بگذاری."],[680,"روی نفس مطمئنه در جسد","زخم ناخنهای فکرت می‌کشد","فکرت و افکار موزی و زهرآگین مانند ناخن به روح آرام و مطمئن انسان آسیب می‌زند و زخم‌هایی بر آن ایجاد می‌کند."],[680,"فکرت بد ناخن پر زهر دان","می‌خراشد در تعمق روی جان","فکرهای ناخوشایند و تلخ مانند ناخن‌های زهرآلود، به دقت و با عمق به جان آسیب می‌زنند و آن را خراش می‌دهند."],[680,"تا گشاید عقده اشکال را","در حدث کردست زرین بیل را","برای برطرف کردن معایب و مشکلاتی که در وجود انسان وجود دارد، باید به یاد داشت که همان‌طور که بر روی آینه چیزی بنویسیم، حتی اگر آن را پاک کنیم، بخشی از آن همچنان بر جا می‌ماند. به همین ترتیب، رفع اشکالات و نقص‌های نفس هم کار آسانی نیست."],[680,"عقده را بگشاده گیر ای منتهی","عقده سختست بر کیسه تهی","این بیت به این معناست که خود را از گره‌ها و مشکلات روانی رها کن، تو که به پایان این سختی‌ها رسیده‌ای و در واقع مشکلات ذهنی‌ات به اندازه کیسه‌ای خالی است که نمی‌تواند سنگینی را تحمل کند."],[680,"در گشاد عقده‌ها گشتی تو پیر","عقده چندی دگر بگشاده گیر","تو در حل کردن مسائل و مشکلات خود موفق بوده‌ای، اما باید به یاد داشته باشی که هنوز مشکلات دیگری نیز وجود دارد که باید به آن‌ها رسیدگی کنی."],[680,"عقده‌ای کان بر گلوی ماست سخت","که بدانی که خسی یا نیک‌بخت","مشکلی که بر گردن ماست بسیار سنگین و دشوار است،‌ به‌طوری‌که نمی‌توانی بفهمی که آیا تو انسان پستی هستی یا خوشبخت و نیکو."],[680,"حل این اشکال کن گر آدمی","خرج این کن دم اگر آدم‌دمی","اگر انسان این سؤال را حل کند، اگر هم انسان باشد، باید به راحتی این مشکل را حل کند."],[680,"حد اعیان و عرض دانسته گیر","حد خود را دان که نبود زین گزیر","حد و مرز موجودات و صفات آن‌ها را بشناس و به همین اندازه آگاهی خود را محدود کن، زیرا نمی‌توانی از این حدود فراتر روی."],[680,"چون بدانی حد خود زین حدگریز","تا به بی‌حد در رسی ای خاک‌بیز","وقتی بفهمی که باید به حد و اندازه خود توجه کنی و از تجاوز به آن پرهیز کنی، در نهایت به بی‌حدی و آزادی می‌رسی، ای کسانی که از خاک هستید و محدودید."],[680,"عمر در محمول و در موضوع رفت","بی‌بصیرت عمر در مسموع رفت","زندگی در حال گذر و حرکت است و در این مسیر، شخص بدون بینش و درک صحیح، زندگی‌اش را صرف چیزهایی می‌کند که شنیده یا مشاهده کرده ولی به عمق آن‌ها واقف نیست."],[680,"هر دلیلی بی‌نتیجه و بی‌اثر","باطل آمد در نتیجه خود نگر","هر دلیلی که به نتیجه نرسد و تأثیری نداشته باشد، در واقع بی‌نتیجه و بی‌اثر است و باید در پایان آن بررسی کرد که درست و معتبر نبوده است."],[680,"جز به مصنوعی ندیدی صانعی","بر قیاس اقترانی قانعی","تنها به وجود یک سازنده مصنوعی (و نه طبیعی) می‌توان اشاره کرد که از قیاس و استنتاج منطقی بهره می‌برد. یعنی نمی‌توان بدون دخالت یک سازنده، نتیجه‌گیری کرد."],[680,"می‌فزاید در وسایط فلسفی","از دلایل باز برعکسش صفی","هرچند دلایل فلسفی و منطقی برای اثبات یک موضوع وجود دارد، اما در واقعیت، این دلایل می‌توانند به طور معکوس به ویران کردن سادگی و صفای ذهن کمک کنند."],[680,"این گریزد از دلیل و از حجاب","از پی مدلول سر برده به جیب","این شخص از دلیل و حجاب دوری می‌کند و به دنبال مفهوم اصلی است و در تلاش است که حقیقت را به دست آورد."],[680,"گر دخان او را دلیل آتشست","بی‌دخان ما را در آن آتش خوشست","اگر دود نشانه آتش باشد، بودن ما در آن آتش بدون دود، خوشتر است."],[680,"خاصه این آتش که از قرب ولا","از دخان نزدیک‌تر آمد به ما","این آتش که به سبب نزدیکی به مقام ولایت و دوستی خداوند است، از دود و خرمنی که دورتر است، به ما نزدیک‌تر آمده و تاثیر بیشتری بر ما دارد."],[680,"پس سیه‌کاری بود رفتن ز جان","بهر تخییلات جان سوی دخان","این بیت به این معناست که وقتی روح برای پرورش تخیلات و افکار به عرصه‌های ناپاک و بی‌فایده می‌رود، در واقع به کارهای ناپسند و سیاه می‌پردازد. این تغییر مسیر باعث می‌شود که روح در غفلت و آلودگی قرار گیرد."],[681,"برمکن پر را و دل برکن ازو","زانک شرط این جهاد آمد عدو","پرهای خود را کنار بگذار و دل را از آن رها کن، زیرا شرط این جهاد (جهاد روحانی) آن است که دشمنی (نفس و هوس) وجود نداشته باشد."],[681,"چون عدو نبود جهاد آمد محال","شهوتت نبود نباشد امتثال","وقتی دشمنی وجود نداشته باشد، جهاد غیرممکن است و اگر خواسته‌های نفسانی (شهوت) وجود داشته باشد، اطاعت (امامت) هم ممکن نخواهد بود."],[681,"صبر نبود چون نباشد میل تو","خصم چون نبود چه حاجت حیل تو","اگر میل و تمایلی به چیزی نداشته باشی، نیازی به صبر و تحمل وجود ندارد؛ وقتی دشمنی در کار نیست، چه نیازی به بهانه‌تراشی و تدبیر است؟"],[681,"هین مکن خود را خصی رهبان مشو","زانک عفت هست شهوت را گرو","خود را مانند شخصی با عزلت‌نشینی که به رهبانیت معروف است قرار نده، زیرا عفت به کنترل شهوت وابسته است و آن را به دست می‌آورد."],[681,"بی‌هوا نهی از هوا ممکن نبود","غازیی بر مردگان نتوان نمود","نهی از خواهش‌های نفس بدون داشتن انگیزه و توجه به خداوند ممکن نیست، همان‌طور که توان نخواهیم داشت بر روی مردگان جنگی کنیم."],[681,"انفقوا گفته‌ست پس کسپی بکن","زانک نبود خرج بی‌دخل کهن","آیه «انفقوا» به معنای «خرچ کنید» گفته شده، اما این نکته را فهمیده‌ایم که باید ابتدا درآمدی داشته باشیم، زیرا بدون سرمایه نمی‌توان چیزی را خرج کرد."],[681,"گرچه آورد انفقوا را مطلق او","تو بخوان که اکسبوا ثم انفقوا","هرچند که در آیه «انفقوا» (خرج کنید) بدون قید و شرط آمده، اما باید توجه داشت که قبل از خرج کردن، باید در کسب و کار کوشا باشید و درآمدی به دست آورید تا بتوانید خرج کنید."],[681,"هم‌چنان چون شاه فرمود اصبروا","رغبتی باید کزان تابی تو رو","رهبر یا شاه در اینجا به افراد می‌گوید که باید صبور باشند و از تمایلات و خواسته‌های نفسانی خود دوری کنند. همچنین، بیان می‌کند که باید به نوعی شوق و رغبت در ضبط نفس و تحمل سختی‌ها داشته باشند."],[681,"پس کلوا از بهر دام شهوتست","بعد از آن لاتسرفوا آن عفتست","شما باید از نعمت‌های دنیا بهره‌مند شوید، اما در این لذت‌ها افراط نکنید، زیرا این عفت و پاکدامنی است که شما را به سعادت می‌رساند."],[681,"چونک محمول به نبود لدیه","نیست ممکن بود محمول علیه","اگر کسی نتواند بار و مسئولیتی را که بر دوش او گذاشته شده به دوش بکشد، پس ممکن نیست که آن بار را بر او بگذارند."],[681,"چونک رنج صبر نبود مر ترا","شرط نبود پس فرو ناید جزا","اگر تو توان صبر را نداشته باشی، انتظار پاداش نیز برای تو شرطی نیست، به همین دلیل جزا و پاداش نخواهد آمد."],[681,"حبذا آن شرط و شادا آن جزا","آن جزای دل‌نواز جان‌فزا","شرط صبر و شرایط سختی که لازم است، بسیار خوب است و پاداشی که به دنبال آن می‌آید، بسیار شگفت‌انگیز و زندگی‌بخش است."],[682,"عاشقان را شادمانی و غم اوست","دست‌مزد و اجرت خدمت هم اوست","علت شادی و غم عاشقان در زندگی خود معشوق است ، و پاداش و نتیجه‌ی خدمت به عشق نیز همین احساسات هستند."],[682,"غیر معشوق ار تماشایی بود","عشق نبود هرزه سودایی بود","اگر غیر از معشوق، چیز دیگری برای تماشا وجود داشته باشد، عشق واقعی نیست و تنها یک هوس بی‌اساس است."],[682,"عشق آن شعله‌ست کو چون بر فروخت","هرچه جز معشوق باقی جمله سوخت","عشق مانند شعله‌ای است که وقتی روشن شد، هرچه غیر از معشوق را می‌سوزاند و تنها معشوق را حفظ می‌کند."],[682,"تیغ لا در قتل غیر حق براند","در نگر زان پس که بعد لا چه ماند","تیغ «لا» (نه) در کشتن غیر حق فرود می‌آید؛ پس بعد از اینکه «نه» گفته شد، دیگر چه چیزی باقی می‌ماند؟"],[682,"ماند الا الله باقی جمله رفت","شاد باش ای عشق شرکت‌سوز زفت","فقط خداوند باقی می‌ماند و باقی چیزها از بین می‌روند. ای عشق، که قدرت سوزاندن شرک را داری، شاد باش."],[682,"خود همو بود آخرین و اولین","شرک جز از دیده احول مبین","خود او (خدا) همان آخرین و همان اولین است و هیچ چیزی جز از چشم کس دیگری که بینا نیست (و دچار نقص است) شرک به حساب نمی‌آید."],[682,"ای عجب حسنی بود جز عکس آن","نیست تن را جنبشی از غیر جان","عجب آن است که جز تصویر زیبایی، چیزی در این دنیا وجود ندارد و بدن حرکتی ندارد مگر این‌که از روح و جان ناشی شده باشد."],[682,"آن تنی را که بود در جان خلل","خوش نگردد گر بگیری در عسل","بدنی که در روحش خلل و نقصی وجود دارد، حتی اگر آن بدن را با عسل هم بپوشانی، خوشبو و زیبا نمی‌شود."],[682,"این کسی داند که روزی زنده بود","از کف این جان جان جامی ربود","این شخصی می‌داند که زمانی زنده بوده و جانش را از دست داده و آن جان را مانند جامی به دیگری داده است."],[682,"وانک چشم او ندیدست آن رخان","پیش او جانست این تف دخان","چشم او آن چهره‌های زیبا را نمی‌بیند، زیرا پیش او جانش وجود دارد و دودی که مانع دیدن است، از اوست."],[682,"چون ندید او عمر عبدالعزیز","پیش او عادل بود حجاج نیز","وقتی که او (عبدالعزیز) عمر (عمر بن عبدالعزیز) را نمی‌بیند، در نظرش حجاج (حجاج بن یوسف) نیز عادل به نظر می‌رسد."],[682,"چون ندید او مار موسی را ثبات","در حبال سحر پندارد حیات","چون او (حجاج) مار موسی را ندید، آن را زنجیری با سحر می‌پندارد که باعث حیات است."],[682,"مرغ کو ناخورده است آب زلال","اندر آب شور دارد پر و بال","پرنده‌ای که از آب زلال استفاده نکرده و فقط در آب شور زندگی کرده، حتی اگر بال و پر داشته باشد، به حقیقت، چیزی از زندگی خوب نصیبش نمی‌شود."],[682,"جز به ضد ضد را همی نتوان شناخت","چون ببیند زخم بشناسد نواخت","انسان نمی‌تواند چیزی را بدون درک و شناخت ضد آن بشناسد. مثلا فقط وقتی که زخمی به وجود می‌آید، فرد می‌تواند معنای آرامش را احساس کند و بفهمد."],[682,"لاجرم دنیا مقدم آمدست","تا بدانی قدر اقلیم الست","دنیا به ناچار قبل از همه چیز ظاهر شده تا تو ارزش عالم بالا (اقلیم الست) را بشناسی و قدر آن را بدانی."],[682,"چون ازینجا وا رهی آنجا روی","در شکرخانه ابد شاکر شوی","وقتی از این دنیا به آنجا بروی، در بهشت جاودان شکرگزار خواهی بود."],[682,"گویی آنجا خاک را می‌بیختم","زین جهان پاک می‌بگریختم","انگار در آنجا، از دنیای مادی جدا می‌شوم و از این جهان ناپاک فاصله می‌گیرم."],[682,"ای دریغا پیش ازین بودیم اجل","تا عذابم کم بدی اندر وجل","ای کاش پیش از این دوره زندگی را که در آن هستیم، مرگ می‌رسید تا عذاب و رنجی که بر من وارد می‌شود، کمتر شود."],[683,"زین بفرمودست آن آگه رسول","که هر آنک مرد و کرد از تن نزول","پیامبر (رسول) فرموده است که هر کس بمیرد و از دنیای مادی (تن) جدا شود، باید آرزو کند که قبل از مرگش بمیرد، به این دلیل که اگر انسان نیکوکار باشد، برای رسیدن به درجات بالا و اجر و پاداش، این آرزو به نفع او خواهد بود و اگر بدکار باشد، برای کم کردن از عواقب گناهانش، چنین آرزویی دارد."],[683,"نبود او را حسرت نقلان و موت","لیک باشد حسرت تقصیر و فوت","او به حسرت و غم انتقال از دنیا و مرگ نمی‌افتد، اما حسرت او به خاطر کوتاهی و نرسیدن به کمال و امور نیکو باقی می‌ماند."],[683,"هر که میرد خود تمنی باشدش","که بدی زین پیش نقل مقصدش","هر کسی که می‌میرد، آرزویی در دلش است که بدی‌ها و گناهانش قبل از مرگش بخشوده شود."],[683,"گر بود بد تا بدی کمتر بدی","ور تقی تا خانه زوتر آمدی","اگر کسی بدکار باشد، آرزو دارد که کمتر بدی کند؛ و اگر با تقوا باشد، آرزو دارد که به بهشت زودتر برسد."],[683,"گوید آن بد بی‌خبر می‌بوده‌ام","دم به دم من پرده می‌افزوده‌ام","آن شخص بد، که از حقیقت بی‌خبر بوده، به او گفته‌اند که من همیشه در حال افزودن و ایجاد حجاب و پرده بوده‌ام."],[683,"گر ازین زودتر مرا معبر بدی","این حجاب و پرده‌ام کمتر بدی","اگر زودتر برای من راهی به سوی مقصد فراهم شود، این حجاب و پرده‌ای که بین من و حقیقت است، کمتر خواهد شد."],[683,"از حریصی کم دران روی قنوع","وز تکبر کم دران چهره خشوع","در چهره قنوع (راضی به قضا و قدر) باید از حریص بودن کم کرد و در چهره خشوع (تواضع) باید از تکبر کم داشت."],[683,"هم‌چنین از بخل کم در روی جود","وز بلیسی چهره خوب سجود","از بخل و تنگ‌نظری در صورت بخشندگی کم کن و همچون شیطان، قیافه‌ات را به زیبایی سجده تزیین نکن."],[683,"بر مکن آن پر خلد آرای را","بر مکن آن پر ره‌پیمای را","به کسی که در بهشت یا خوشبختی است، نگو که از آنجا دور شود یا آن را ترک کند، زیرا او در مسیر به سوی حقیقت و جمال الهی است."],[683,"چون شنید این پند در وی بنگریست","بعد از آن در نوحه آمد می‌گریست","زمانی که او این نصیحت را شنید، به خود نگریست و پس از آن در سوگواری مشغول به گریه شد."],[683,"نوحه و گریه دراز دردمند","هر که آنجا بود بر گریه‌ش فکند","هر کسی که در آنجا بود، به گریه و نوحه طولانی بیمار چنین توجه کرد که گویی یک نوع همدردی و همبستگی با درد او است."],[683,"وآنک می‌پرسید پر کندن ز چیست","بی‌جوابی شد پشیمان می‌گریست","کسی که درباره علت پرکنده شدن بپرسد و نتواند جواب قانع‌کننده‌ای پیدا کند، در نتیجه پشیمان می‌شود و به گریه می‌افتد."],[683,"کز فضولی من چرا پرسیدمش","او ز غم پر بود شورانیدمش","به خاطر کنجکاوی چرا از او پرسیدم؟ او به خاطر غم و دردش، در دلش پر از اندوه بود و من با پرسش‌هایم بیشتر او را ناراحت کردم."],[683,"می‌چکید از چشم تر بر خاک آب","اندر آن هر قطره مدرج صد جواب","اشک‌های او از چشمانش به زمین می‌ریخت و هر قطره از این اشک‌ها حامل پاسخ‌هایی بود که بر دلش نشسته بود."],[683,"گریه با صدق بر جانها زند","تا که چرخ و عرش را گریان کند","گریه‌ای که از دل و با صداقت باشد، تا آنجا اثرگذار است که می‌تواند آسمان و عالم معنا را نیز به گریه درآورد."],[683,"عقل و دلها بی‌گمان عرشی‌اند","در حجاب از نور عرشی می‌زیند","عقل و دل‌ها به‌راستی در مرتبه‌ای بالا و مشابه عرش هستند، اما به خاطر حجاب‌هایی که بر آنها وجود دارد، از نور و روشنایی عرش بهره‌مند نیستند."],[684,"هم‌چو هاروت و چو ماروت آن دو پاک","بسته‌اند اینجا به چاه سهمناک","عقل و روح، مانند هاروت و ماروت که در چاه بابل محبوس شده‌اند، در این دنیای ماده و جسمانی گرفتار شده‌اند."],[684,"عالم سفلی و شهوانی درند","اندرین چه گشته‌اند از جرم‌بند","عالم پایین و دنیای شهوانی در اینجا به جرم و گناه گرفتار شده‌اند و در واقع چیزی جز حبس و محدودیت نیستند."],[684,"سحر و ضد سحر را بی‌اختیار","زین دو آموزند نیکان و شرار","نیکان و بدکاران به‌طور ناخودآگاه، جادو (سحر) و ضد جادو (ضد سحر) را از این دو نوع یاد می‌گیرند."],[684,"لیک اول پند بدهندش که هین","سحر را از ما میاموز و مچین","اما ابتدا به او نصیحت می‌کنند که مواظب باشد و از ما سحر نیاموزد و آن را نچسبد."],[684,"ما بیاموزیم این سحر ای فلان","از برای ابتلا و امتحان","ما باید این هنر سحرآمیز را از تو بیاموزیم تا مورد آزمایش و امتحان قرار بگیریم."],[684,"که امتحان را شرط باشد اختیار","اختیاری نبودت بی‌اقتدار","امتحان و آزمایش وقتی معنا پیدا می‌کند که اختیار در آن وجود داشته باشد، اما وقتی که تو خود اختیاری نداری و تحت قدرت دیگری هستی، این آزمایش بی‌معناست."],[684,"میلها هم‌چون سگان خفته‌اند","اندریشان خیر و شر بنهفته‌اند","میل‌ها و خواهش‌ها مانند سگ‌های خفته هستند، درون آن‌ها خیر و شر پنهان شده است."],[684,"چونک قدرت نیست خفتند این رده","هم‌چو هیزم‌پاره‌ها و تن‌زده","چون قدرت و اراده‌ای وجود ندارد، این گروه (میل‌ها و خواسته‌ها) حالت سکون پیدا کرده‌اند، مانند تکه‌های هیزم که بی‌تحرک و بی‌فایده هستند."],[684,"تا که مرداری در آید در میان","نفخ صور حرص کوبد بر سگان","زمانی که مرداری (نماد مرگ) در میان بیفتد و نفخ صور (صدای دمیدن در صور) به صدا درآید، حرص و طمع بر سگ‌ها (نماد مردم) غلبه می‌کند."],[684,"چون در آن کوچه خری مردار شد","صد سگ خفته بدان بیدار شد","زمانی که در آن کوچه یک خر که مرده بود پیدا شد، تمام سگان خوابیده آنجا بیدار شدند."],[684,"حرصهای رفته اندر کتم غیب","تاختن آورد سر بر زد ز جیب","حرص‌ها و تمایلات پنهان شده در ضمیر انسان، ناگهان از دل او بیرون می‌آیند و خود را نشان می‌دهند."],[684,"موبه موی هر سگی دندان شده","وز برای حیله دم جنبان شده","هر چیزی که به شدت به آن وابسته شده‌ایم، مانند موی سگی که دندانش در آن گیر کرده، به طوری که برای انجام حیله و نیرنگ به تکان خوردن ادامه می‌دهد."],[684,"نیم زیرش حیله بالا آن غضب","چون ضعیف آتش که یابد او حطب","نیم زیر آن حیله، بالا آن خشم و غضب است، مانند آتش ضعیفی که هیزم را به دست می‌آورد تا روشن شود."],[684,"شعله شعله می‌رسد از لامکان","می‌رود دود لهب تا آسمان","شعله‌های آتش از جای نامحدود و بی‌نهایت به وجود می‌آیند و دودی که از آن بلند می‌شود، به آسمان می‌رود."],[684,"صد چنین سگ اندرین تن خفته‌اند","چون شکاری نیستشان بنهفته‌اند","در این بیت، شاعر به این نکته اشاره دارد که در بدن انسان، بسیاری از خصلت‌ها و استعدادهای پنهان وجود دارند که به دلیل افشا نشدن آنها، مانند سگ‌های شکاری در حالت خواب هستند و هیچ استفاده‌ای از آنها نمی‌شود."],[684,"یا چو بازانند و دیده دوخته","در حجاب از عشق صیدی سوخته","انسان‌ها مانند پرندگان باز هستند که به عشق خود دل بسته‌اند و به خاطر آن، در پرده‌ای از خفا و حجاب گرفتار شده‌اند. آن‌ها مانند صیدهایی هستند که از عشقشان سوخته و بی‌تاب شده‌اند."],[684,"تا کله بردارد و بیند شکار","آنگهان سازد طواف کوهسار","عقل و روح مانند پرندگان سر به پایین آورده‌ای هستند که به خاطر عشق به چیزی به شدت غمگین و متعهد شده‌اند. زمانی که آنها از این حالت آزاد شوند و توجهشان را به هدف اصلی معطوف کنند، به‌سوی آن چیزی که خواهان آن هستند حرکت می‌کنند و به دور کوه‌ها می‌چرخند."],[684,"شهوت رنجور ساکن می‌بود","خاطر او سوی صحت می‌رود","تمایل و خواهش‌های نفسانی انسان (شهوت) سبب رنج و ناراحتی اوست، اما دل او به سوی سلامتی و آرامش روانی می‌رود."],[684,"چون ببیند نان و سیب و خربزه","در مصاف آید مزه و خوف بزه","وقتی انسان نان و سیب و خربزه را ببیند، دچار دو حس متضاد می‌شود: از یک طرف لذت مزه‌اش را درک می‌کند و از طرف دیگر، می‌ترسد که به گناه و زیان دچار شود."],[684,"گر بود صبار دیدن سود اوست","آن تهیج طبع سستش را نکوست","اگر صبر و شکیبایی وجود داشته باشد، دیدن سود او (عقل و روح) امکان‌پذیر است؛ این حالت باعث تحریک و نشاط طبیعت ضعیف او می‌شود که امر خوبی است."],[684,"ور نباشد صبر پس نادیده به","تیر دور اولی ز مرد بی‌زره","اگر صبر نباشد، انسان نادیده و بی‌تجربه، مانند فرد بی‌زره‌ای است که در برابر تیر اولی که به او پرتاب می‌شود، هیچ دفاعی ندارد."],[685,"چون ز گریه فارغ آمد گفت رو","که تو رنگ و بوی را هستی گرو","پس از اینکه از حالت گریه فارغ شد، طاوس گفت: برو، زیرا تو رنگ و بو هستی و به او وابسته‌ای."],[685,"آن نمی‌بینی که هر سو صد بلا","سوی من آید پی این بالها","تو متوجه نیستی که در هر سو، بلاها و مشکلات متعددی به سمت من می‌آید به خاطر این پرها و زیورهایی که دارم."],[685,"ای بسا صیاد بی‌رحمت مدام","بهر این پرها نهد هر سوم دام","بسیاری از شکارچیان بی‌رحم هر لحظه برای به دام انداختن این پرها (زیبایی‌ها یا خواسته‌ها) تله می‌گذارند."],[685,"چند تیرانداز بهر بالها","تیر سوی من کشد اندر هوا","چندین تیرانداز برای شکار پرها تیرهایی به سمت من پرتاب می‌کنند."],[685,"چون ندارم زور و ضبط خویشتن","زین قضا و زین بلا و زین فتن","چون قدرت و توانایی کنترل خود را در برابر این سرنوشت و این بلاها و فتنه‌ها ندارم،"],[685,"آن به آید که شوم زشت و کریه","تا بوم آمن درین کهسار و تیه","در آن معرکه، حالتی به وجود می‌آید که من زشت و بدفرم می‌شوم، تا بتوانم به امنیت و آرامش در این کوهستان و بیابان برسم."],[685,"این سلاح عجب من شد ای فتی","عجب آرد معجبان را صد بلا","منظور این است که این سلاح شگفت‌انگیز من، ای جوان شگفت‌انگیز، باعث می‌شود که شگفت‌زده‌ها با مشکلات و بلاهای زیادی روبه‌رو شوند."],[686,"پس هنر آمد هلاکت خام را","کز پی دانه نبیند دام را","این بیت می‌گوید هنر می‌تواند باعث هلاکت انسان نادان شود، زیرا او به خاطر ناپخته‌گی و به دنبال منفعت شخصی، دام‌های خطرناک را نمی‌بیند و تنها به دانه (فتنه) توجه می‌کند."],[686,"اختیار آن را نکو باشد که او","مالک خود باشد اندر اتقوا","انتخاب و اختیار خوب است که انسان در آن، مالک و صاحب خود باشد و در پرهیزکاری و تقوا زندگی کند."],[686,"چون نباشد حفظ و تقوی زینهار","دور کن آلت‌، بینداز اختیار","اگر حفظ و تقوای اخلاقی نباشد، پس باید از ابزار و وسایل دنیوی دوری جست و اختیار آن‌ها را کنار گذاشت."],[686,"جلوه‌گاه و اختیارم آن پر‌ست","بر کنم پر را که در قصد سر‌ست","اختیار و جمال من مانند پر طاووس است، می‌خواهم آن پر را برکنم چرا که در خطر کنش‌های نامناسب است و مرا به هدف‌های نادرست می‌کشاند."],[686,"نیست انگارد پر خود را صبور","تا پرش در نفکند در شر و شور","انسان نباید خود را به صبر و آرامش بخواند، چرا که اگر چنین کند، ممکن است که پرش (یعنی استعداد یا هنر) او را به فساد و آشفتگی بیفکند."],[686,"پس زیانش نیست پر گو بر مکن","گر رسد تیری به پیش آرد مجن","اگر به دلایل مختلف پر طاووس خود را به کار نبری، زیانی ندارد؛ چون اگر تیر (خطر یا آسیب) به جلو بیاید، مجنون (جنون و عشق) تو را جلو خواهد آورد."],[686,"لیک بر من پر زیبا دشمنیست","چونک از جلوه‌گری صبریم نیست","زیبایی و هنر دنیا همچون پرهای طاوس، برای من مانند دشمن است، زیرا اگر در برابر این جلوه‌ها صبر و کنترل نداشته باشم، به سادگی تحت تاثیر قرار می‌گیرم و گمراه می‌شوم."],[686,"گر بدی صبر و حفاظم راه‌بر","بر فزودی ز اختیارم کر و فر","اگر صبر و محافظت من آسیب ببیند و راه را بر من ببندد، اختیار و اراده‌ام هم بی‌فایده خواهد شد."],[686,"هم‌چو طفلم یا چو مست اندر فتن","نیست لایق تیغ اندر دست من","من مانند کودک یا فرد مست، در فتنه‌ها ناآگاه و ناتوان هستم و شایسته نیست که در دست من سلاحی باشد."],[686,"گر مرا عقلی بدی و منزجر","تیغ اندر دست من بودی ظفر","اگر به من عقلی می‌دادی و من را از ترس و ناامیدی دور می‌کردی، تیغی در دست من بود که به پیروزی می‌رسید."],[686,"عقل باید نورده چون آفتاب","تا زند تیغی که نبود جز صواب","عقل باید مانند نور خورشید روشنگر باشد تا بتواند سلاحی را به دست بگیرد که جز راست و درست نیست."],[686,"چون ندارم عقل تابان و صلاح","پس چرا در چاه نندازم سلاح‌؟","چون عقل و خرد روشنی‌بخش و نیکویی ندارم، پس چرا سلاح یا ابزار جنگ را به چاه بیفکنم و مصرف کنم؟"],[686,"در چه اندازم کنون تیغ و مجن","کاین سلاح خصم من خواهد شدن","اکنون با چه چیزی باید تیغ و سپر (مجن) خود را بیفکنم، زیرا این سلاح به وسیله دشمن من خواهد شد و علیه من به کار می‌رود."],[686,"چون ندارم زور و یاری و سند","تیغم او بستاند و بر من زند","چون من کمک و قدرتی ندارم و تیغی ندارم که از خود دفاع کنم، او سلاحم را از من می‌گیرد و به من حمله خواهد کرد."],[686,"رغم این نفس وقیحه‌خوی را","که نپوشد رو‌، خراشم روی را","با وجود این نفس پلید و بی‌شرم که ظاهرش را نمی‌پوشاند، عیب‌های خود را بر چهره‌ام نمایان می‌کند."],[686,"تا شود کم این جمال و این کمال","چون نماند رو‌، کم افتم در وبال","وقتی این زیبایی و کمال کم شود، و دیگر چهره ای نداشته باشم، در این صورت کمتر به عذاب و گناه دچار می‌شوم."],[686,"چون بدین نیّت خراشم‌، بزه نیست","که به زخم این روی را پوشیدنی‌ست","این بیت به این معناست که اگر نیت خیری پشت این زخم و درد وجود داشته باشد، هیچ گمانی درباره آن وجود ندارد که می‌توان این چهره را با زخم‌ها و دردها پنهان کرد. در واقع، زخم‌ها و مشکلات زندگی اگر با نیت خوب همراه باشند، ارزش و معنایی دارند."],[686,"گر دلم خوی ستیری داشتی","روی خوبم جز صفا نفراشتی","اگر دل من خوی ستیزه‌جویی داشت، هیچکس نمی‌توانست زیبایی ظاهری‌ام را جز صفا (پاکی) تحمل کند."],[686,"چون ندیدم زور و فرهنگ و صلاح","خصم دیدم‌، زود بشکستم سلاح","چون خصم را زور، فرهنگ و صلاح ندیدم، سریعا سلاح خود را شکستستم و تسلیم شدم."],[686,"تا نگردد تیغ من او را کمال","تا نگردد خنجرم بر من وبال","تا زمانی که شمشیر من به او قدرتی ندهد و به کمال نرسد، خنجر من بر من عذاب نمی‌شود و بر خودم ضرر ندارد."],[686,"می‌گریزم تا رگم جنبان بود","کی فرار از خویشتن آسان بود‌؟","من از خودم فرار می‌کنم تا بتوانم احساسم را کنترل کنم، ولی آیا فرار از وجود خودم واقعا آسان است؟"],[686,"آنک از غیری بود او را فرار","چون ازو ببرید‌، گیرد او قرار","هرکس که از دیگری می‌گریزد، وقتی که آن شخص از او دور شود، آرامش پیدا می‌کند."],[686,"من که خصمم هم منم اندر گریز","تا ابد کار من آمد خیزخیز","من که دشمن خود هستم، همیشه در حال فرار و گریز هستم و تا زمانی که زندگی می‌کنم، کارم همین گریز و فرار خواهد بود."],[686,"نه به هند‌ست آمن و نه در ختن","آنک خصم اوست سایه خویشتن","خصم (دشمن) انسان همیشه با اوست و نمی‌توان به هیچ جایی، حتی هند یا ختن (منطقه‌ای در چین)، فرار کرد؛ زیرا دشمن در واقع سایه‌ی خود فرد است و نمی‌توان از آن گریخت."],[687,"چون فناش از فقر پیرایه شود","او محمدوار بی‌سایه شود","زمانی که انسان به واسطه فنا، از فقر و نیاز خود رها می‌شود، مانند پیامبر محمد، در سایه‌ای از وجود خویش نیست و به مقام بالایی می‌رسد."],[687,"فقر فخری را فنا پیرایه شد","چون زبانه شمع او بی‌سایه شد","فقر، به‌عنوان ویژگی مهمی، زینت و شرفی برای کسی می‌شود که در مسیر فنا قرار گرفته است. مانند شعله شمع که وقتی می‌سوزد و نور پخش می‌کند، سایه‌ای ندارد و به همین دلیل دیگر از هیچ خطر و ترسی نمی‌هراسد."],[687,"شمع جمله شد زبانه پا و سر","سایه را نبود بگرد او گذر","این بیت بیان می‌کند که شمع به طور کامل از زبانه، پا و سر خود تشکیل شده است و سایه‌ای در اطراف او وجود ندارد. به عبارتی دیگر، وقتی به اوج وجود و روشنایی برسد، چنین سایه‌ای دور او نمی‌افتد."],[687,"موم از خویش و ز سایه در گریخت","در شعاع از بهر او کی شمع ریخت","موم از خود و سایه‌اش فرار کرد و برای نور او در شمع ذوب شد."],[687,"گفت او بهر فنایت ریختم","گفت من هم در فنا بگریختم","کسی می‌گوید من برای نابود کردن تو فانی شدم، و طرف جواب می‌دهد که من هم به خاطر فنا از خودم فرار کردم."],[687,"این شعاع باقی آمد مفترض","نه شعاع شمع فانی عرض","این نور باقی که می‌درخشد، در حقیقت وجودی است که فرض شده و دائمی است، نه مانند نور شمع که فناپذیر و گذراست."],[687,"شمع چون در نار شد کلی فنا","نه اثر بینی ز شمع و نه ضیا","وقتی شمع در آتش بسوزد به طور کامل نابود می‌شود و دیگر نه از شمع اثری می‌ماند و نه نوری از آن مشاهده می‌شود."],[687,"هست اندر دفع ظلمت آشکار","آتش صورت به مومی پایدار","در تاریکی، آتش به وضوح وجود دارد، در حالی که موم به عنوان جسمی نرم و پایدار نمی‌تواند در برابر آن دوام بیاورد."],[687,"برخلاف موم شمع جسم کان","تا شود کم گردد افزون نور جان","جسم انسان مانند موم شمع است که با آب شدن و ناپدید شدن کاهش می‌یابد، اما نور جان او که همان روح و وجود واقعی‌اش است، هرچه این جسم کمتر شود، بیشتر و پرنورتر می‌گردد."],[687,"این شعاع باقی و آن فانیست","شمع جان را شعله ربانیست","این نور پایدار و دائمی است، در حالی که نور فانی و زودگذر است. شعله جان انسان، از جنس خدا و الهی است و به همین خاطر باقی و پایدار است."],[687,"این زبانه آتشی چون نور بود","سایه فانی شدن زو دور بود","زبان آتش که به شکل نور در می‌آید، هیچ گونه سایه‌ای از فانی شدن بر آن نیست و از این جهت دور است."],[687,"ابر را سایه بیفتد در زمین","ماه را سایه نباشد همنشین","ماه به خاطر روشنی‌اش هیچ سایه‌ای بر زمین نمی‌اندازد، در حالی که ابرها می‌توانند سایه بیفکنند و بودنشان باعث تاریکی می‌شود. این بدان معناست که کسی که در فانی شدن خود را آزاد کند، مانند ماه درخشان و بی‌سایه است و به مشکلات و خطرات دنیوی مبتلا نمی‌شود."],[687,"بی‌خودی بی‌ابریست ای نیک‌خواه","باشی اندر بی‌خودی چون قرص ماه","کسی که خود را از خودخواهی و ایگو رها کرده است، همچون ماه کامل درخشان و بدون ابر است. اگر تو هم نیک‌خواهی، باید در این حالت بی‌خودی قرار بگیری."],[687,"باز چون ابری بیاید رانده","رفت نور از مه خیالی مانده","وقتی که ابر می‌آید، نور و روشنی از ذهن و خیال دور می‌شود و وجود واقعی انسان، که همان نور است، تحت تأثیر حجاب‌ها قرار می‌گیرد."],[687,"از حجاب ابر نورش شد ضعیف","کم ز ماه نو شد آن بدر شریف","نور او چون ابر پنهان شده و ضعیف به نظر می‌رسد، همچون ماه نو که نوری کم و خفیف دارد، به خاطر حجاب و پوششی که وجود دارد."],[687,"مه خیالی می‌نماید ز ابر و گرد","ابر تن ما را خیال‌اندیش کرد","نور ماه در نظر ما به‌خاطر وجود ابر و غبار، گویی خیالی به نظر می‌رسد و ابرها باعث شده‌اند که ما به شکل فکری و خیالی به معانی و تصاویر بیاندیشیم."],[687,"لطف مه بنگر که این هم لطف اوست","که بگفت او ابرها ما را عدوست","ای ناظر مه، ببین که این زیبایی و لطفی که می‌بینی، نشانه‌ای از رحمت و لطف خداوند است. خدا به ما یادآوری کرده که ابرها دشمن ما هستند و باید از آنها دوری کنیم."],[687,"مه فراغت دارد از ابر و غبار","بر فراز چرخ دارد مه مدار","ماه از ابر و غبار بی‌نیاز است و بر بالای آسمان در مداری خاص قرار دارد."],[687,"ابر ما را شد عدو و خصم جان","که کند مه را ز چشم ما نهان","ابر (مشکلات و موانع) دشمن جان ما شده و باعث می‌شود که مه (روشنی و حقیقت) از دید ما پنهان شود."],[687,"حور را این پرده زالی می‌کند","بدر را کم از هلالی می‌کند","این بیت می‌گوید که زیبایی و جاذبه حوریان (زنان بهشتی) را پرده‌ای تیره و زشت می‌کند، و همچنین نور و درخشندگی ماه (بدر) را از ماه‌تابی‌های هلال (ماه نیمه) کم می‌کند. به طور کلی، این ابیات به تأثیر عواملی منفی بر زیبایی و نور اشاره دارند."],[687,"ماه ما را در کنار عز نشاند","دشمن ما را عدوی خویش خواند","ماه ما (دختر زیبای ما) را در کنار عز (برکت و بزرگی) نشاند، ولی دشمن ما (انسان) او را دشمن خود خواند و با او بدرفتاری کرد."],[687,"تاب ابر و آب او خود زین مهست","هر که مه خواند ابر را بس گمرهست","منظور از این بیت این است که نور و روشنی که برخی از افراد به ابر نسبت می‌دهند، در واقع ناشی از ماه (نور) است. هر کسی که ابر را به عنوان منبع نور ببیند، در واقع گمراه است و نمی‌تواند حقیقت را درک کند."],[687,"نور مه بر ابر چون منزل شدست","روی تاریکش ز مه مبدل شدست","نور ماه که بر ابر قرار گرفته، باعث شده است که روی تاریک ابر به شکل روشنی درآید."],[687,"گرچه همرنگ مهست و دولتیست","اندر ابر آن نور مه عاریتیست","اگرچه این نور ماه در ابر ظاهر می‌شود و برای مدتی به آن زیبایی و قدرت می‌دهد، اما این نور در واقع موقتی و عاریتی است و از خود ماه نیست."],[687,"در قیامت شمس و مه معزول شد","چشم در اصل ضیا مشغول شد","در روز قیامت، خورشید و ماه کنار گذاشته می‌شوند و چشم‌ها فقط به منبع اصلی نور، یعنی خداوند، مشغول می‌شود."],[687,"تا بداند ملک را از مستعار","وین رباط فانی از دارالقرار","انسان باید بداند که ملک و سلطنتی که به او داده شده، موقتی و ناچیز است و این جایگاه فانی، چیزی بیشتر از یک محلی غیر ثابت نیست."],[687,"دایه عاریه بود روزی سه چار","مادرا ما را تو گیر اندر کنار","دنیا مانند یک پرستار موقتی است که در طول روزها و شب‌ها به ما کمک می‌کند، اما این پرستاری دائمی نیست و مادری واقعی نیست؛ بنابراین باید به آن وابسته نشویم."],[687,"پر من ابرست و پرده‌ست و کثیف","ز انعکاس لطف حق شد او لطیف","وجود من مانند ابر است که پرده و غباری از خودنمایی دارد و به خاطر تجلی و انعکاس لطف خداوند، این پرده‌ها لطیف و زیبا می‌شوند."],[687,"بر کنم پر را و حسنش را ز راه","تا ببینم حسن مه را هم ز ماه","من باید پرده و ویژگی‌های ظاهری خود را کنار بزنم تا زیبایی واقعی عشق را ببینم، همان طور که ماه را از پشت ابر دیدن ممکن نیست."],[687,"من نخواهم دایه مادر خوشترست","موسی‌ام من دایه من مادرست","من محبت و توجه مادری را نمی‌خواهم، زیرا برای من موسی بودن (که به دایه یعنی پرستار نیاز ندارد) بهتر است. در واقع، من وابسته به مادر نیستم و خودم به تنهایی می‌توانم در مسیر خود مستقل باشم."],[687,"من نخواهم لطف مه از واسطه","که هلاک قوم شد این رابطه","من نیازی به محبت و لطف ماه ندارم که با واسطه به من برسد، زیرا این رابطه باعث هلاکت قوم (شخصیت‌های دیگر) شده است."],[687,"یا مگر ابری شود فانی راه","تا نگردد او حجاب روی ماه","شاید به مانند ابر، فانی شود تا مانع روی ماه نگردد."],[687,"صورتش بنماید او در وصف لا","هم‌چو جسم انبیا و اولیا","حالت او به گونه‌ای است که در توصیفش نمی‌توان از形 یا صورت خاصی صحبت کرد، و مانند جسم انبیا و اولیا نیست. در واقع، او فراتر از ظاهر و جسم مادی است."],[687,"آنچنان ابری نباشد پرده‌بند","پرده‌در باشد به معنی سودمند","این بیت می‌گوید که اگر کسی در حالت بی‌خود یا فانی باشد، مانند ابری نیست که مانع دیدن چیزها شود، بلکه مانند پرده‌ای است که در عین پوشش، درک و فهمی سودمند را فراهم می‌آورد."],[687,"آن‌چنان که اندر صباح روشنی","قطره می‌بارید و بالا ابر نی","در آن هنگام که صبح روشنی پدیدار می‌شود، به همان اندازه که قطرات باران می‌بارند، ابر هم بالاست و پنهان نمی‌شود."],[687,"معجزه پیغامبری بود آن سقا","گشته ابر از محو هم‌رنگ سما","پیامبرانی که مانند سقا (آب‌ران) از خودفانی و مطلقا ناپدید شده‌اند، معجزه‌ای هستند که به دلیل محو شدن در حقیقت الهی، به رنگ آسمان درآمده‌اند."],[687,"بود ابر و رفته از وی خوی ابر","این چنین گردد تن عاشق به صبر","ابر وجود دارد ولی حالا ویژگی‌های خود را از دست داده است. این‌گونه، تن عاشق هم با صبر و شکیبایی، تغییر می‌کند و از حالت دنیوی خود بیرون می‌رود."],[687,"تن بود اما تنی گم گشته زو","گشته مبدل رفته از وی رنگ و بو","تن وجود دارد، اما این بدن به گونه‌ای دیگر شده و انگار از آن جدا گشته است؛ رنگ و بوی آن از بین رفته و دگرگون شده است."],[687,"پر پی غیرست و سر از بهر من","خانه سمع و بصر استون تن","این بیت اشاره دارد به این که وجود انسان در واقع برای جستجوی دیگری است و حواس او (سمع و بصر) تنها مکانی برای دریافت و تشخیص آن دیگری هستند، نه اینکه خود انسان هدف باشد."],[687,"جان فدا کردن برای صید غیر","کفر مطلق دان و نومیدی ز خیر","فدای جان کردن برای به دست آوردن چیزهای غیر الهی، نشانه کفر و عدم امید به خیر و نیکی است."],[687,"هین مشو چون قند پیش طوطیان","بلک زهری شو شو آمن از زیان","بخود نیا، مانند قند شیرین که در مجاورت طوطی‌ها نرم و نازک می‌شود، بلکه به‌جای آن، مانند زهر شو که از آسیب‌ها در امان بمانی."],[687,"یا برای شادباشی در خطاب","خویش چون مردار کن پیش کلاب","اگر برای تبریک و شادباش با دیگران صحبت کنی، مانند مرده‌ای خواهی شد که پیش درندگان (کلاب) است. این تشبیه به خطر نمایانگر آن است که از آنچه در دل داری و شخصیت واقعی‌ات، دور می‌شوی."],[687,"پس خضر کشتی برای این شکست","تا که آن کشتی ز غاصب باز رست","خضر، که در اسطوره‌ها نماد دانش و هدایت است، برای نجات کشتی‌ای که در خطر آسیب توسط غاصبان قرار دارد، به کمک می‌آید تا این کشتی از دست آن‌ها نجات یابد."],[687,"فقر فخری بهر آن آمد سنی","تا ز طماعان گریزم در غنی","فقر به عنوان یک نیکی و افتخار برای اهل حقیقت و عرفان آمده است، تا از طمع‌کاران و ثروت‌طلبان دور شوند و به سعادت و بی‌نیازی دست یابند."],[687,"گنجها را در خرابی زان نهند","تا ز حرص اهل عمران وا رهند","خزانه‌ها را در ویرانی می‌گذارند تا از حرص و طمع کسانی که به ساخت و ساز و عمران مشغول هستند، دور بمانند."],[687,"پر نتانی کند رو خلوت گزین","تا نگردی جمله خرج آن و این","انسان نمی‌تواند در جستجوی رسیدن به کمال و نورانیت (خلوت گزینی) بپردازد، مگر اینکه از امور دنیوی و خودخواهی‌هایش دوری کند؛ چراکه در غیر این صورت، همه چیز به هدر می‌رود و او محصور در امور دنیوی خواهد شد."],[687,"زآنک تو هم لقمه‌ای هم لقمه‌خوار","آکل و ماکولی ای جان هوش‌دار","تو هم مانند لقمه‌ای هستی که خورده می‌شود و هم مانند لقمه‌خوار، یعنی آن کسی که لقمه را می‌خورد. ای جان، هوشیار باش."],[688,"مرغکی اندر شکار کرم بود","گربه فرصت یافت او را در ربود","مرغی که مشغول شکار کرم بود، غافل از این بود که گربه فرصتی پیدا کرده و او را گرفت."],[688,"آکل و ماکول بود و بی‌خبر","در شکار خود ز صیادی دگر","انسان در حالی که سرگرم تأمین نیازهای خود و مشغول جست‌وجو برای چیزهایی که می‌خورد (آکل) است، از وجود خطراتی که او را تهدید می‌کند (صیادها) غافل است."],[688,"دزد گرچه در شکار کاله‌ایست","شحنه با خصمانش در دنباله‌ایست","دزد هرچند در جستجوی طعمه‌ای است، ولی نگهبان (شحنه) هم با دشمنانش در تعقیب او است."],[688,"عقل او مشغول رخت و قفل و در","غافل از شحنه‌ست و از آه سحر","عقل انسان در پی زینت‌ها و لذت‌های دنیوی چون لباس و قفل در است و از شحنه (نگهبان) و آه سحر (دعا و استغفار در سحر) غافل است."],[688,"او چنان غرقست در سودای خود","غافلست از طالب و جویای خود","آدمی آن‌قدر غرق در خواسته‌ها و آرزوهای خود است که از موجوداتی که او را تعقیب می‌کنند و به دنبال او هستند، بی‌خبر است."],[688,"گر حشیش آب و هوایی می‌خورد","معده حیوانش در پی می‌چرد","اگر حیوانی علف یا گیاهی را می‌خورد، در واقع معده‌اش به دنبال آن چه که او خورده، می‌گردد و به طور مداوم در پی جستجوی آن است."],[688,"آکل و ماکول آمد آن گیاه","هم‌چنین هر هستیی غیر اله","آکل (خورنده) و ماکول (خورده‌شده) به گیاهان و چیزهایی که می‌خوریم اشاره دارد، و بنابراین هر موجودی غیر از خداوند نیز از قاعده خوردن و خورده شدن پیروی می‌کند."],[688,"و هو یطعمکم و لا یطعم چو اوست","نیست حق ماکول و آکل لحم و پوست","خداوند شما را سیر می‌کند و خود سیر نمی‌شود. اگر او نبود، حق آنچه خورده می‌شود و آنچه می‌خورد، وجود نداشت."],[688,"آکل و ماکول کی ایمن بود","ز آکلی که اندر کمین ساکن بود","آیا کسی می‌تواند در خوردن و خوراکی خود ایمنی داشته باشد، در حالی که آکلی (خورنده) در کمین و انتظار است؟ تنیزه و مراقبت در مورد آنچه می‌خوریم همواره لازم است."],[688,"امن ماکولان جذوب ماتمست","رو بدان درگاه کو لا یطعم است","غذاهای زمین و روزی‌هایی که به ما می‌رسد، همواره در خطرند و باید به درگاه خدا پناه ببریم، زیرا اوست که به کسی چیزی نمی‌دهد مگر به حکم و اراده‌اش."],[688,"هر خیالی را خیالی می‌خورد","فکر آن فکر دگر را می‌چرد","هر خیالی که در ذهن انسان پدید می‌آید، فکری دیگر به دنبال خود می‌آورد و از آن نیز تفکر و تصورات جدیدی شکل می‌گیرد. به عبارت دیگر، تفکرات همچون خوراکی برای یکدیگر عمل می‌کنند و به هم وابسته‌اند."],[688,"تو نتانی کز خیالی وا رهی","یا بخسپی که از آن بیرون جهی","تو نمی‌توانی از خیالی که در ذهنت وجود دارد رهایی پیدا کنی، یا از خواب و غفلت بیدار شوی و از آن خارج شوی."],[688,"فکر زنبورست و آن خواب تو آب","چون شوی بیدار باز آید ذباب","فکر تو شبیه به زنبور است و خواب تو مثل آبی است. وقتی بیدار شوی، دوباره مگس‌ها (افکار و دغدغه‌ها) برمی‌گردند."],[688,"چند زنبور خیالی در پرد","می‌کشد این سو و آن سو می‌برد","زنبور خیال، در ذهن آدمی به تفرج و پرواز مشغول است و او را از واقعیت‌های پیرامونش دور می‌کند."],[688,"کمترین آکلانست این خیال","وآن دگرها را شناسد ذوالجلال","کمترین چیزهایی که خورده می‌شوند، یعنی «آکلان» (خورنــده‌ها) و هر خیال و تصور، در برابر عظمتی که از آن خداوند (ذوالجلال) است، شناخته می‌شوند. به عبارت دیگر، هر چیزی که وجود دارد و شامل خوراک می‌شود، در کنار قدرت و جلال خداوند درک می‌گردد."],[688,"هین گریز از جوق اکال غلیظ","سوی او که گفت ما ایمت حفیظ","بشتاب و از جمعیت خوراک‌خواران غافل دوری کن و به سوی خدا برو که او گفت: ما شما را حفظ می‌کنیم."],[688,"یا به سوی آن که او آن حفظ یافت","گر نتانی سوی آن حافظ شتافت","اگر نمی‌توانی به سوی آنکه تو را حفظ می‌کند بروی، لااقل به سوی کسی برو که خود او توانسته در حفاظت قرار گیرد."],[688,"دست را مسپار جز در دست پیر","حق شدست آن دست او را دستگیر","جز به دست پیر حق، یعنی خدا، دست خود را به هیچ‌کس نده، زیرا آن دست خداوند است که تو را یاری می‌کند."],[688,"پیر عقلت کودکی خو کرده است","از جوار نفس که اندر پرده است","عقل تو مانند کودکی است که به نفست وابسته شده و در سایه‌ی آن زندگی می‌کند و هنوز از دنیای نزدیک به نفس خود خارج نشده است."],[688,"عقل کامل را قرین کن با خرد","تا که باز آید خرد زان خوی بد","عقل کامل را با اندیشه درست همراه کن تا خرد تو از صفات ناپسند و خوی‌های بد دور شود و به راه درست بازگردد."],[688,"چونک دست خود به دست او نهی","پس ز دست آکلان بیرون جهی","هرگاه دست خود را به دست خداوند بسپارید و در ارتباط با او قرار دهید، از دست آن کسانی که فقط می‌خورند و به دنیا دل بسته‌اند، رهایی می‌یابید."],[688,"دست تو از اهل آن بیعت شود","که یدالله فوق ایدیهم بود","اگر تو با افرادی که دستشان به دست خدا و پیامبر است، بیعت کنی و به آنها بپیوندی، به این ترتیب دست تو هم به نیروی الهی وصل می‌شود و حمایت خداوند شامل حال تو خواهد بود."],[688,"چون بدادی دست خود در دست پیر","پیر حکمت که علیمست و خطیر","زمانی که دست خود را به پیری که دانا و با تجربه است بسپاری، در حقیقت به حکمت و دانش او اعتماد کرده‌ای."],[688,"کو نبی وقت خویشست ای مرید","تا ازو نور نبی آید پدید","ای مرید، نبی که زمان اوست، باید وجود داشته باشد تا از نور و راهنمایی او بهره‌مند شوی و درک روشن‌تری از حقیقت پیدا کنی."],[688,"در حدیبیه شدی حاضر بدین","وآن صحابه بیعتی را هم‌قرین","در واقعه حدیبیه، تو در کنار صحابه (یاران) حاضر شدی و با آنان بیعتی کردی. این بیعت نشانه‌ای از همبستگی و اتحاد مسلمانان در آن زمان بود."],[688,"پس ز ده یار مبشر آمدی","هم‌چو زر ده‌دهی خالص شدی","تو از میان ده یار مژده‌آور، به سوی خداوند آمدی و مانند طلا، خالص و ناب شدی."],[688,"تا معیت راست آید زانک مرد","با کسی جفتست کو را دوست کرد","مرد تا زمانی که در کنار کسی است که او را دوست دارد، با او همراه و هم‌راستا خواهد بود. در حقیقت، ارتباط و محبت میان افراد باعث نزدیکی و یگانگی آن‌ها می‌شود."],[688,"این جهان و آن جهان با او بود","وین حدیث احمد خوش‌خو بود","جهان مادی و عالم معنوی به طور همزمان وجود دارند و این گفتار پیامبر دارای خلق نیکو (احمد) نیز چنین حقیقتی را تأیید می‌کند."],[688,"گفت المرء مع محبوبه","لا یفک القلب من مطلوبه","انسان با محبوبش سخن می‌گوید و قلبش از خواسته‌اش جدا نمی‌شود."],[688,"هر کجا دامست و دانه کم نشین","رو زبون‌گیرا زبون‌گیران ببین","هر جا دام و تله‌ای وجود دارد، در کنار آن نباید نشستی و باید از شکارچیان و کسانی که در دام دیگران می‌افتند، عبرت بگیری."],[688,"ای زبون‌گیر زبونان این بدان","دست هم بالای دستست ای جوان","ای کسی که دیگران را به خود جلب می‌کنی، بدان که در بالای دست تو، دستی بالاتر وجود دارد که بر تو نظارت دارد و تو جوانی."],[688,"تو زبونی و زبون‌گیر ای عجب","هم تو صید و صیدگیر اندر طلب","تو انسان دارای محدودیت هستی و در عین حال کسی را به دام می‌اندازی، این شگفت‌انگیز است که تو هم خودت شکار هستی و هم در تلاش برای شکار کردن دیگران."],[688,"بین ایدی خلفهم سدا مباش","که نبینی خصم را وآن خصم فاش","خودت را غافل نکن و مراقب دشمن باش، حتی اگر او را نمی‌بینی، چون آن دشمن به‌وضوح در کمین است."],[688,"حرص صیادی ز صیدی مغفلست","دلبریی می‌کند او بی‌دلست","صیاد که به شکار مشغول است، بر اثر حرص و ولع خود نسبت به صید، غافل از خطر شکارچیان دیگر است. او به خاطر دلبری و زیبایی صید، از این که خود در خطر است بی‌خبر و بی‌توجه است."],[688,"تو کم از مرغی مباش اندر نشید","بین ایدی خلف عصفوری بدید","خودت را کمتر از مرغی ندان که در حال شکار طعمه‌ای است و توجه نکند که به دنبال او طعمه‌ای خطرناک در کمین است، مانند باز که به عصفور (پرنده کوچک) نزدیک می‌شود."],[688,"چون به نزد دانه آید پیش و پس","چند گرداند سر و رو آن نفس","نفس انسان، وقتی که به سمت خواسته‌ها و لذات دنیوی می‌رود، بی‌وقفه به اطرافش نگاه می‌کند و مصرانه در پی آسایش و خوشی خود است."],[688,"کای عجب پیش و پسم صیاد هست","تا کشم از بیم او زین لقمه دست","عجب اینجاست که در جلو و پشت من صیاد وجود دارد، اما من از ترس او این لقمه را رها نمی‌کنم."],[688,"تو ببین پس قصه فجار را","پیش بنگر مرگ یار و جار را","به قصه افراد فاسق و بدعمل نگاه کن و سپس به مرگ دوستان و نزدیکان خود فکر کن. این یادآوری می‌تواند باعث شود که بهتر در مورد زندگی و اعمال خود فکر کنی."],[688,"که هلاکت دادشان بی‌آلتی","او قرین تست در هر حالتی","هلاکت و نابودی آن‌ها بدون هیچ وسیله‌ای، در هر حال و وضعی با تو همراه است."],[688,"حق شکنجه کرد و گرز و دست نیست","پس بدان بی‌دست حق داورکنیست","خدای حق شکنجه نمی‌کند و نیازی به ابزار مادی ندارد، بنابراین در قضاوت‌های خود نباید به وسیله‌های ظاهری متکی باشی، چرا که حق، خود تصمیم‌گیرنده و داور است."],[688,"آنک می‌گفتی اگر حق هست کو","در شکنجه او مقر می‌شد که هو","تو که می‌گفتی اگر خدا وجود دارد، چرا در شکنجه و عذاب او (حق) نمی‌بیند که در درد و رنجش شریک شود؟"],[688,"آنک می‌گفت این بعیدست و عجیب","اشک می‌راند و همی گفت ای قریب","شخصی به عمق درد و رنج خود اشاره می‌کند و به سختی گریه می‌کند، در حالی که در دل به این فکر است که چقدر دور از حق است و این موضوع برای او عجیب و بعید است."],[688,"چون فرار از دام واجب دیده است","دام تو خود بر پرت چفسیده است","وقتی فرار از دام را واجب دانسته، دام تو نیز به خود چسبیده و تو را محاصره کرده است."],[688,"بر کنم من میخ این منحوس دام","از پی کامی نباشم طلخ‌کام","من این میخ ناجور دام را می‌کنم، چرا که برای رسیدن به موفقیت و کامیابی، نباید تلخی و دشواری را تحمل کنم."],[688,"درخور عقل تو گفتم این جواب","فهم کن وز جست و جو رو بر متاب","من به تو پاسخی مناسب عقلت دادم، آن را بفهم و از جست‌وجو و کنکاش فراتر نرو."],[688,"بسکل این حبلی که حرص است و حسد","یاد کن فی جیدها حبل مسد","به یاد داشته باش که این حبلی (وثاقی) که به حرص و حسد وابسته است، بر گردن تو است؛ مانند آن زنجیری که به عنوان عذاب بر گردن کسی می‌افتد."],[689,"این سخن را نیست پایان و فراغ","ای خلیل حق چرا کشتی تو زاغ","این بحث و گفتگو پایانی ندارد، ای خلیل (حضرت ابراهیم)، چرا تو زاغ را کشتی؟"],[689,"بهر فرمان حکمت فرمان چه بود","اندکی ز اسرار آن باید نمود","فرمان حکمت چه چیزی است که باید اندکی از اسرار آن را نشان داد؟"],[689,"کاغ کاغ و نعره زاغ سیاه","دایما باشد به دنیا عمرخواه","زاغ سیاه دائما ناله و فریاد می‌کند و این در واقع نشان‌دهنده خواسته‌های دنیوی و عمرطلبی اوست."],[689,"هم‌چو ابلیس از خدای پاک فرد","تا قیامت عمر تن درخواست کرد","این بیت به فردی اشاره دارد که مانند ابلیس از خداوند عمر می‌طلبد و خواهان طول عمر در دنیا تا قیامت است. ابلیس به خاطر سرکشی‌اش از بندگان طغیانی‌اش خواسته بود که تا روز قیامت زنده بماند، و این تصویر به تحذیر از صفات مذمومه و ناپسند اشاره دارد."],[689,"گفت انظرنی الی یوم الجزا","کاشکی گفتی که تبنا ربنا","ابلیس از خدا خواسته است که او را تا روز قیامت زنده نگه دارد، در حالی که ای کاش او می‌گفت که پروردگار ما را بساز. این نشان می‌دهد که او به جای درخواست مغفرت و درست شدن، به دنبال ادامه زندگی خود تا روز حساب است."],[689,"عمر بی توبه همه جان کندنست","مرگ حاضر غایب از حق بودنست","عمر بدون توبه و پشیمانی، سخت و مشقت‌بار است و در واقع، معنای واقعی زندگی در این است که آدمی به خداوند نزدیک شود و نجات یابد. مرگ زمانی که کسی به یاد خدا نباشد، به‌نوعی غیبت از حقیقت محسوب می‌شود."],[689,"عمر و مرگ این هر دو با حق خوش بود","بی‌خدا آب حیات آتش بود","عمر و مرگ هر دو با خدا خوشایند و دلپذیر است، اما بدون خدا زندگی و حیات به مانند آبی است که به آتش تبدیل می‌شود و بی‌فایده است."],[689,"آن هم از تاثیر لعنت بود کو","در چنان حضرت همی‌شد عمرجو","این بیت به این معناست که هر گونه بدخواهی یا نفرین، تأثیر خودش را بر روی کسی می‌گذارد و حتی در درگاه خداوند هم ممکن است به عمر و زندگی شخصی آسیب برساند. در واقع، اگر کسی در وجود دارد، دعا یا نفرین‌های منفی می‌تواند بر سرنوشت او تأثیر بگذارد."],[689,"از خدا غیر خدا را خواستن","ظن افزونیست و کلی کاستن","خواستن غیر از خدا، در حقیقت به معنای زیاد کردن گمان‌ها و گم کردن کلی چیزهاست. این یعنی توجه به غیر خدا انسان را از حقیقت و اصل خود دور می‌کند."],[689,"خاصه عمری غرق در بیگانگی","در حضور شیر روبه‌شانگی","معنای این بیت این است که اگر کسی عمر خود را در بیگانگی و دوری از خدا سپری کند، در حالی که در حضور خداوند قرار دارد، مانند شیر در حال روبه‌رو شدن با دشمن است. در واقع، او در وضعیتی است که عاقبت خوبی ندارد و باید خود را به خدا نزدیک کند."],[689,"عمر بیشم ده که تا پس‌تر روم","مهلم افزون کن که تا کمتر شوم","عمر بیشم (عمر زیاد) را به من ببخش تا به طرف دیگر بروم، و مهلم (سستی و تنبلی) را بیشتر کن تا به تدریج کمتر شوم."],[689,"تا که لعنت را نشانه او بود","بد کسی باشد که لعنت‌جو بود","هر کس که خواهان لعنت و بدی دیگران باشد، نشانه او و شخصیتش می‌شود. بنابراین، لعنت و نفرت نشانه‌ای از صفات ناپسند اوست."],[689,"عمر خوش در قرب جان پروردنست","عمر زاغ از بهر سرگین خوردنست","عمر خوش، زندگی در نزدیکی خداوند و پرورش روح است، اما عمر زاغ (پرنده‌ای که نماد پلیدی و زشتی است) صرفا در خوردن و زندگی در آلودگی سپری می‌شود. در اینجا به تفاوت بین زندگی معنوی و زندگی مادی و زشت اشاره شده است."],[689,"عمر بیشم ده که تا گه می‌خورم","دایم اینم ده که بس بدگوهرم","منظور در این بیت این است که عمر را به من بخشید تا در خوشی و لذت زندگی کنم، اما این عمر را به خاطر بدی جوهر و ذات خودم به باد نمی‌دهم."],[689,"گرنه گه خوارست آن گنده‌دهان","گویدی کز خوی زاغم وا رهان","اگر تو خود را از این خصلت‌های زشت نرسانی، پس تو نیز مثل زاغی خواهی شد که از خوی زشت خود رها نمی‌شود."],[690,"ای مبدل کرده خاکی را به زر","خاک دیگر را بکرده بوالبشر","ای خدایی که توانسته‌ای آدم را از خاک بی‌آفریده و او را به انسانی با ارزش و مقام تبدیل کنی، تو خاک دیگری را به انسانی بزرگ و محترم ساخته‌ای."],[690,"کار تو تبدیل اعیان و عطا","کار من سهوست و نسیان و خطا","تو می‌توانی هر چیزی را تغییر دهی و به من عطا کنی، اما کار من فقط اشتباهات، فراموشی‌ها و خطاست."],[690,"سهو و نسیان را مبدل کن به علم","من همه خلمم مرا کن صبر و حلم","ای خدا، خطاها و فراموشی‌های من را به دانش تبدیل کن، چون من در جهل و نادانی هستم، پس تو مرا دارای صبر و حلم (بردباری و دانایی) کن."],[690,"ای که خاک شوره را تو نان کنی","وی که نان مرده را تو جان کنی","ای کسی که می‌توانی از خاکه‌ای بی‌خاصیت خوراک تولید کنی و همچنین کسی که می‌توانی از نان بدون زندگی، جان و حیات ببخشی."],[690,"ای که جان خیره را رهبر کنی","وی که بی‌ره را تو پیغمبر کنی","تو کسی هستی که جان سرگردان را هدایت می‌کنی و کسی که بدون راهنما هست را به راه راست می‌کشانی."],[690,"می‌کنی جزو زمین را آسمان","می‌فزایی در زمین از اختران","تو زمین را به مراتب بالا می‌بری و آن را به آسمان تبدیل می‌کنی، و در زمین به ستاره‌ها و خصلت‌های آسمانی می‌افزایی."],[690,"هر که سازد زین جهان آب حیات","زوترش از دیگران آید ممات","هر کسی که در این دنیا به ترقی و کمال برسد و به آب حیات (زندگی واقعی و معنوی) دست یابد، مرگش زودتر از دیگران خواهد آمد، یعنی با موتش از این دنیا رها می‌شود و به حقیقت می‌پیوندد."],[690,"دیده دل کو به گردون بنگریست","دید که اینجا هر دمی میناگریست","دل کسی که به آسمان نگاه کرد و با دید خود اسرار آن را مشاهده کرد، فهمید که در این دنیا هر لحظه حالتی مانند میناگری (سر مستی و شادابی) وجود دارد."],[690,"قلب اعیانست و اکسیری محیط","ایتلاف خرقه تن بی‌مخیط","قلب انسان وجودی ارزنده و گرانبهاست که در آن همه حقایق و روحیات جمع شده‌اند و این در حالی است که جسم و ظاهر او فقط پوششی موقتی و بی‌اهمیت محسوب می‌شود."],[690,"تو از آن روزی که در هست آمدی","آتشی یا بادی یا خاکی بدی","تو از زمانی که به وجود آمدی، یا به مانند آتش، یا به مانند باد، یا به مانند خاک بودی."],[690,"گر بر آن حالت ترا بودی بقا","کی رسیدی مر ترا این ارتقا","اگر آن حالت اولیه که از آن آمده‌ای، برای تو پایدار بود، هرگز به این مرتبه و مقام نائل نمی‌شدی."],[690,"از مبدل هستی اول نماند","هستی بهتر به جای آن نشاند","از آغاز هستی، به‌جز تغییر و دگرگونی، هیچ‌چیز باقی نمانده است و به‌جای آن، وجودهایی بهتر و بالاتر به‌وجود آمده‌اند."],[690,"هم‌چنین تا صد هزاران هستها","بعد یکدیگر دوم به ز ابتدا","این بیت می‌گوید همچنان که از یک هستی به هستی‌های دیگر بعد از آن می‌رسیم، تا صد هزاران نوع هستی وجود دارد که همه آنها نسبت به هستی ابتدایی، بهتر هستند."],[690,"از مبدل بین وسایط را بمان","کز وسایط دور گردی ز اصل آن","از میان واسطه‌ها دور بمان، زیرا دوری از آنها تو را به اصل و حقیقت نزدیک‌تر می‌کند."],[690,"واسطه هر جا فزون شد وصل جست","واسطه کم ذوق وصل افزونترست","هر جا واسطه‌ها و وسایل زیادتر شوند، افراد به حقیقت و وصل کمتری دست می‌یابند. برعکس، هرچه واسطه‌ها کمتر باشند، شوق و ذوق به وصل و ارتباط با حقیقت بیشتر خواهد بود."],[690,"از سبب‌دانی شود کم حیرتت","حیرت تو ره دهد در حضرتت","وقتی که به علم و دانش و علت‌ها توجه می‌کنی، از حیرتت کاسته می‌شود و این فهم و آگاهی، راهی به سوی نزدیکی به حضرت حق به تو می‌دهد."],[690,"این بقاها از فناها یافتی","از فنااش رو چرا برتافتی","به خاطر فناها، تو به بقا دست یافته‌ای، پس چرا از فنا می‌گریزی و آن را تحمل نمی‌کنی؟"],[690,"زان فناها چه زیان بودت که تا","بر بقا چفسیده‌ای ای نافقا","تو که از فناها هیچ زیانی ندیده‌ای، چرا به بقا چسبیده‌ای و به آن وابسته‌ای، ای کسی که به عودت و رجعت مشهور هستی؟"],[690,"چون دوم از اولینت بهترست","پس فنا جو و مبدل را پرست","چون دومی که از اولی بهتری، پس به دنبال فنا باش و چیزهای متغیر را بپرست."],[690,"صد هزاران حشر دیدی ای عنود","تاکنون هر لحظه از بدو وجود","ای انسان مقاوم، تو تا به حال صدها هزار نوع رستاخیز و تجدید حیات را دیده‌ای، ولی هنوز در هر لحظه از آغاز وجود خود بی‌خبر و غافل هستی."],[690,"از جماد بی‌خبر سوی نما","وز نما سوی حیات و ابتلا","از موجودات بی‌جان (جماد) غافل شو و به عالم صورت و زیبایی (نما) توجه کن، و از آنجا به سراغ زندگی و آزمایش‌ها (حیات و ابتلا) برو."],[690,"باز سوی عقل و تمییزات خوش","باز سوی خارج این پنج و شش","برو به سوی عقل و توانایی‌های خوب خود، و از این پنج و شش حس بیرونی فاصله بگیر."],[690,"تا لب بحر این نشان پایهاست","پس نشان پا درون بحر لاست","این بیت به این معناست که تا کناره دریا (بهره عقل و درک) نشانه پاها دیده می‌شود، اما وقتی به درون دریا (عالم غیب و معنوی) برویم، دیگر هیچ نشانی از پاها و مسیرها وجود ندارد. بنابراین، در فضای معنوی، دیگر نشانه‌ای از خطوط مشخص نیست."],[690,"زانک منزلهای خشکی ز احتیاط","هست دهها و وطنها و رباط","چون منزلگاه‌های خشکی به دلیل احتیاط وجود دارند، پس در اینجا مکان‌های زیادی برای سکونت و پناهگاه‌های مناسب وجود دارد."],[690,"باز منزلهای دریا در وقوف","وقت موج و حبس بی‌عرصه و سقوف","منزل‌های دریا، در زمان طوفان و بی‌خطر بودن، در حال انتظار و آرامش هستند و هیچ سرپناه یا پوششی برای حفاظت از آن‌ها وجود ندارد."],[690,"نیست پیدا آن مراحل را سنام","نه نشانست آن منازل را نه نام","این ابیات به این موضوع اشاره دارند که در مسیرهای معنوی و مراحلی که انسان باید طی کند، نه نشانه‌ای وجود دارد و نه اسمی از آن منازل هست. به عبارت دیگر، در این مسیر، چیزهایی که قابل شناسایی یا قابل نامگذاری باشند، در دسترس نیستند."],[690,"هست صد چندان میان منزلین","آن طرف که از نما تا روح عین","میان دو منزل، که یکی ظاهری و دیگری باطنی است، فاصله‌ای بسیار زیاد وجود دارد. آن طرف، یعنی سوی روح، به گونه‌ای است که از نمای ظاهری تا حقیقت روحی، عمق و غنای بیشتری را نشان می‌دهد."],[690,"در فناها این بقاها دیده‌ای","بر بقای جسم چون چفسیده‌ای","تو در وجود فناهای مختلف، بقاهایی را مشاهده کرده‌ای، اما به بقای جسمی چسبیده‌ای و به آن معلق مانده‌ای."],[690,"هین بده ای زاغ این جان باز باش","پیش تبدیل خدا جانباز باش","ای زاغ (مراجعه به افرادی که در زندگی مادی غرق شده‌اند)، توجه کن و جان خود را به خدا بسپار و در برابر تغییرات خداوند و نشانه‌های او، شجاع و مقاوم باش."],[690,"تازه می‌گیر و کهن را می‌سپار","که هر امسالت فزونست از سه پار","می‌گوید که باید از نو شروع کنی و بر زندگیت تازگی ببخشی، در حالی که چیزهای قدیمی و کهنه را کنار می‌گذاری، زیرا هر سالی که می‌گذرد، بر استقبال از زندگی جدید و بهتر افزوده می‌شود."],[690,"گر نباشی نخل‌وار ایثار کن","کهنه بر کهنه نه و انبار کن","اگر همچون درخت خرما ایثار و بخشندگی نداشته باشی، پس نسبت به کهنه و قدیمی‌ها، ایثار و فداکاری نکن و خود را گرفتار آن‌ها نکن."],[690,"کهنه و گندیده و پوسیده را","تحفه می‌بر بهر هر نادیده را","هرفرد نادانی که از حقیقت یا ارزش‌های مهم آگاه نیست، ممکن است چیزهای کهنه و بی‌ارزش را به عنوان هدیه به دیگران بیاورد."],[690,"آنک نو دید او خریدار تو نیست","صید حقست او گرفتار تو نیست","کسی که تازه‌وارد است (حق) نمی‌تواند خریدار تو (پندارهای نادرست یا دنیایی) باشد، زیرا او گرفتار تو نیست و از دام تو رهایی یافته است."],[690,"هر کجا باشند جوق مرغ کور","بر تو جمع آیند ای سیلاب شور","در هر جایی که گروهی از مرغ‌های کور باشند، به سوی تو می‌آیند، ای سیلاب شور."],[690,"تا فزاید کوری از شورابها","زانک آب شور افزاید عمی","این بیت بیان می‌کند که کوری دل و فهم مردم به سبب نوشیدن آب شور و گل‌آلود بیشتر می‌شود، چرا که آب شور خود به کوری و نادانی دامن می‌زند."],[690,"اهل دنیا زان سبب اعمی‌دل‌اند","شارب شورابه آب و گل‌اند","اهل دنیا به همین دلیل که بی‌خبر و غافل هستند، دل‌هایشان کور است و مانند کسی هستند که از آب شور و گل می‌نوشند."],[690,"شور می‌ده کور می‌خر در جهان","چون نداری آب حیوان در نهان","زخمی که دردش را حس نمی‌کنی، از آن برایت لذت نباید باشد؛ چون که اگر در دنیا به حالتی نابینا زندگی کنی، آن هم به دور از آب حیات (دانایی و معنویت)، تنها در غفلت خواهی زیست."],[690,"با چنین حالت بقا خواهی و یاد","هم‌چو زنگی در سیه‌رویی تو شاد","در این بیت می‌گوید در چنین حالتی که غم و اندوه در دل داری، چگونه می‌توانی به دنبال بقا و یاد خدا باشی، در حالی که مانند زنگی (شخصی با پوست تیره) در سیاهی و اندوه مجذوب خوشحالی هستی."],[690,"در سیاهی زنگی زان آسوده است","کو ز زاد و اصل زنگی بوده است","زنگی در زندگی‌اش به خاطر اینکه از نسل زنگیان است، از سیاهی و ننگی که دارد آسوده خاطر است."],[690,"آنک روزی شاهد و خوش‌رو بود","گر سیه‌گردد تدارک‌جو بود","اگر روزی کسی زیبا و خوش‌رو باشد، وقتی که روزگارش تیره و سیاه شود، باید به اصلاح و جبران آن بپردازد."],[690,"مرغ پرنده چو ماند در زمین","باشد اندر غصه و درد و حنین","اگر پرنده‌ای مانند مرغ در زمین بماند، دچار غم و درد خواهد شد و ناله می‌کند."],[690,"مرغ خانه بر زمین خوش می‌رود","دانه‌چین و شاد و شاطر می‌دود","مرغی که در خانه است، به آرامی و خوشحالی در زمین می‌گردد و دانه می‌چیند و با نشاط و چابکی حرکت می‌کند."],[690,"زآنک او از اصل بی‌پرواز بود","وآن دگر پرنده و پرواز بود","چون او از اصل و اساس بی‌پرواز و آرامش است، در حالی که دیگری پرنده‌ای است که در حال پرواز و فعالیت می‌باشد."],[691,"گفت پیغمبر که رحم آرید بر","جان من کان غنیا فافتقر","پیامبر فرمود که بر جان من رحم کنید، زیرا شخصی که ثروتمند بود، حالا فقیر شده است."],[691,"والذی کان عزیزا فاحتقر","او صفیا عالما بین المضر","و کسی که در گذشته عزیز و محترم بوده، اکنون به ذلت و بی‌ارزشی افتاده است؛ و نیز کسی که عالم و دانا است، باید در میان نادانان و بی‌خبران بازیچه شود."],[691,"گفت پیغمبر که با این سه گروه","رحم آرید ار ز سنگید و ز کوه","پیامبر فرموده‌اند که با این سه گروه، که به خاطر وضعیتی که دارند، باید رحمت و مدارا کنید، هرچند ممکن است آنها از سختی‌ها و مشکلات اقتصادی رنج ببرند."],[691,"آنک او بعد از رئیسی خوار شد","وآن توانگر هم که بی‌دینار شد","آن فردی که پس از اینکه رئیس و محترم بود، به ذلت و حقارت افتاد، و همچنین آن ثروتمندی که بدون پول و سرمایه شد."],[691,"وآن سوم آن عالمی که اندر جهان","مبتلی گردد میان ابلهان","سومین فرد، عالمی است که در دنیا گرفتار می‌شود و در میان نادانان قرار می‌گیرد."],[691,"زانک از عزت به خواری آمدن","هم‌چو قطع عضو باشد از بدن","زیرا افتادن از مقام عزت به ذلت، مانند جدا شدن یک عضو از بدن است."],[691,"عضو گردد مرده کز تن وا برید","نو بریده جنبد اما نی مدید","مردی که به خاطر برش خوردن از بدن، اعضایش جدا شده باشد، هر چند که عضو تازه‌ای به او پیوند زده شود، اما حقیقتا زنده نیست و نمی‌تواند به درستی حرکت کند."],[691,"هر که از جام الست او خورد پار","هستش امسال آفت رنج و خمار","هر کسی که از آگاهی و شناخت در زمان «الست» (زمانی که خداوند از همه موجودات پیمان گرفت) بهره‌برداری کرده باشد، در سال جاری از رنج و درد و خمار (نشانه‌های غم و اندوه) در امان خواهد بود."],[691,"وآنک چون سگ ز اصل کهدانی بود","کی مرورا حرص سلطانی بود","کسی که از اصل و نژاد پست و بی‌ارزش باشد، چگونه می‌تواند به مقام سلطنت و قدرت طمع کند؟"],[691,"توبه او جوید که کردست او گناه","آه او گوید که گم کردست راه","او (انسان) به خاطر گناهانش به توبه و بازگشت از آنچه کرده، نیاز دارد و به همین دلیل است که ناله و آه می‌زند، زیرا احساس می‌کند که راه راست را گم کرده است."],[692,"آهوی را کرد صیادی شکار","اندر آخر کردش آن بی‌زینهار","صیاد، آهویی را شکار کرد و بدون اینکه او را نجات دهد، در آخر، در میان خران حبسش کرد."],[692,"آخری را پر ز گاوان و خران","حبس آهو کرد چون استمگران","آهو در آخر به میان گاوها و الاغ‌ها (خران) گناهکاران و افرادی که در دنیا شهوترانی می‌کنند گرفتار شد و در این حبس به سر می‌برد."],[692,"آهو از وحشت به هر سو می‌گریخت","او به پیش آن خران شب کاه ریخت","آهو به خاطر ترس و وحشت به هر طرف فرار می‌کرد و در مقابل آن خران، شب کاه را ریختند."],[692,"از مجاعت و اشتها هر گاو و خر","کاه را می‌خورد خوشتر از شکر","گاو و خر از گرسنگی و hunger به کاه، که غذایی بی‌ارزش است، بیشتر از شکر که شیرین و خوشمزه است، روی می‌آورند. این موضوع نشان‌دهنده حالتی است که انسان‌های مخصوص خدا در میان دنیا و خواسته‌های نفسانی، به چیزهای بی‌ارزش و غیرمطلوب تن می‌دهند."],[692,"گاه آهو می‌رمید از سو به سو","گه ز دود و گرد که می‌تافت رو","زمان‌هایی آهو از سمتی به سمت دیگر فرار می‌کرد، گهگاه از شدت دود و گرد و غبار که در آنجا معلق بود."],[692,"هرکرا با ضد خود بگذاشتند","آن عقوبت را چو مرگ انگاشتند","هر کس را که به ضد و نقیض خود رها کردند، مجازات او را مانند مرگ تصور کردند."],[692,"تا سلیمان گفت که آن هدهد اگر","هجر را عذری نگوید معتبر","سلیمان می‌گوید اگر هدهد (پرنده‌ای که زبانش را می‌فهمد و پیام می‌آورد) دلیلی برای غیبت خود نیاورد، دیگر بهانه‌اش پذیرفته نخواهد شد."],[692,"بکشمش یا خود دهم او را عذاب","یک عذاب سخت بیرون از حساب","سلیمان می‌گوید که او (هدهد) را ممکن است خودم بکشم یا به او عذابی عذاب دهم که فراتر از محاسبه و انتظار است."],[692,"هان کدامست آن عذاب این معتمد","در قفس بودن به غیر جنس خود","این بیت به این نکته اشاره دارد که عذابی که فرد در آن گرفتار است، همانند محبوس شدن در قفس با چیزی غیر از ذات خود و طبیعی‌اش است. به عبارت دیگر، عذاب واقعی در این است که کسی در شرایط یا اوضاعی زندگی کند که برای او ناآشنا و غیر مرتبط باشد."],[692,"زین بدن اندر عذابی ای بشر","مرغ روحت بسته با جنسی دگر","ای انسان، تو در این بدن به عذاب هستی، زیرا روح تو در قفسی گرفتار است که متعلق به چیزی غیر از خود اوست."],[692,"روح بازست و طبایع زاغها","دارد از زاغان و چغدان داغها","روح آزاد و لطیف است، اما در بدن مادی مانند زاغ‌ها (پرندگان سیاه) و چغدان‌ها (نوعی پرنده شکاری) گرفتار است و از ویژگی‌های آن‌ها اثر می‌پذیرد."],[692,"او بمانده در میانشان زارزار","هم‌چو بوبکری به شهر سبزوار","او در میان آنها مانند یک بلبلی (بوبکری) زار و نزار مانده است، به همان اندازه که بلبلی در شهر سبزوار (شهر مشهور در ایران) از غم و اندوه بی‌تابی می‌کند."],[693,"شد محمد الپ الغ خوارزمشاه","در قتال سبزوار پر پناه","محمد الپ‌غ، خوارزمشاه، در نبرد سبزوار، در موقعیتی امن و پناهگاه قرار گرفت."],[693,"تنگشان آورد لشکرهای او","اسپهش افتاد در قتل عدو","لشکر محمد خوارزمشاه دشمنان را به شدت تحت فشار قرار داد و اسب او در کشتن آن‌ها غرق در خون شد."],[693,"سجده آوردند پیشش کالامان","حلقه‌مان در گوش کن وا بخش جان","آنان در برابر محمد خوارزمشاه سجده کردند و به او گفتند که ما در حلقه‌اش (به معنی تسلیم شده و تابع او) هستیم و خواهش می‌کنند که جانشان را ببخشند."],[693,"هر خراج و صلتی که بایدت","آن ز ما هر موسمی افزایدت","هر گونه مالیات و عوضی که باید به تو پرداخت شود، بر اساس هر فصل یا زمان، افزایش می‌یابد."],[693,"جان ما آن توست ای شیرخو","پیش ما چندی امانت باش گو","ما جان‌مان را فدای تو کرده‌ایم، ای شیرخو (شیرخو یعنی کسی که شیرین و دلپذیر است)، بنابراین تا وقتی که تو پیش ما هستی، خواهش می‌کنیم که مدتی دیگر نزد ما بمان."],[693,"گفت نرهانید از من جان خویش","تا نیاریدم ابوبکری به پیش","او می‌گوید: از من جان خود را نجات دهید و تا زمانی که ابوبکر را به من نیاورید، به شما رحم نمی‌کنم."],[693,"تا مرا بوبکر نام از شهرتان","هدیه نارید ای رمیده امتان","تا زمانی که نام ابوبکر را از شهر شما به عنوان هدیه نیاورید، من شما را رها نمی‌کنم، ای گروه ضعیف و ترسو."],[693,"بدرومتان هم‌چو کشت ای قوم دون","نه خراج استانم و نه هم فسون","ای مردم فرومایه، شما مانند کشت و زراعت، بی ارزش و بی‌مصرف هستید؛ من نه مالیات شما را می‌پذیرم و نه از تزویر و فریب شما استفاده می‌کنم."],[693,"بس جوال زر کشیدندش به راه","کز چنین شهری ابوبکری مخواه","مردم از این شهر برای محمد خوارزمشاه مقداری زر برداشتند و به سمت او راه افتادند، زیرا او انتظار نداشت که از چنین شهری کسی ابوبکر (یکی از صحابی پیامبر) را طلب کند."],[693,"کی بود بوبکر اندر سبزوار","یا کلوخ خشک اندر جویبار","چرا باید ابوبکر (صحابی پیامبر) را در سبزوار بیاورید، او در آنجا چه معنایی دارد؟ آیا ارزش او مانند یک تکه کلوخ خشک در جویبار است؟"],[693,"رو بتابید از زر و گفت ای مغان","تا نیاریدم ابوبکر ارمغان","محور بحث میان محمد خوارزمشاه و مغان از آنجا آغاز می‌شود که خوارزمشاه از آنان می‌خواهد تا برای او هدیه‌ای به نام ابوبکر بیاورند. او بر این باور است که بدون آوردن این هدیه، هیچ چشم‌داشتی از آن‌ها ندارد."],[693,"هیچ سودی نیست کودک نیستم","تا به زر و سیم حیران بیستم","هیچ فایده‌ای ندارد که من را با زر و سیم به حیرت بیندازی، چون فرزند کوچک و نادانی نیستم که به خاطر پول و ثروت دچار شگفتی شوم."],[693,"تا نیاری سجده نرهی ای زبون","گر بپیمایی تو مسجد را به کون","هرگاه که خوارزمشاه به تو می‌گوید سجده کن، تو باید از ترس و ذلت خود را به او تسلیم نکن و اگر حتی به زور هم به مسجد بروی، ارزش ندارد."],[693,"منهیان انگیختند از چپ و راست","که اندرین ویرانه بوبکری کجاست","ممنوعیت‌ها و موانع بر آن‌ها فشار آوردند تا بپرسند در این خرابه، ابوبکر کجاست."],[693,"بعد سه روز و سه شب که اشتافتند","یک ابوبکری نزاری یافتند","پس از گذشت سه روز و سه شب که افراد به جست‌وجو پرداختند، بالاخره یک نفر به نام ابوبکر نزاری را پیدا کردند."],[693,"ره گذر بود و بمانده از مرض","در یکی گوشه خرابه پر حرض","یک مسافر که از بیماری مانده بود، در یک گوشه ویرانه‌ای نشسته و در انتظار است."],[693,"خفته بود او در یکی کنجی خراب","چون بدیدندش بگفتندش شتاب","او در گوشه‌ای از خرابه خوابیده بود. وقتی دیگران او را دیدند، به او گفتند که سریعا برخیز."],[693,"خیز که سلطان ترا طالب شدست","کز تو خواهد شهر ما از قتل رست","بیدار شو که سلطان به دنبالت آمده و می‌خواهد شهر ما را از کشتار نجات دهد."],[693,"گفت اگر پایم بدی یا مقدمی","خود به راه خود به مقصد رفتمی","محمد خوارزمشاه می‌گوید اگر تو به من یاری برسانی یا نخستین گام را برداری، من خودم به سوی هدفم می‌روم و مشکلی نخواهم داشت."],[693,"اندرین دشمن‌کده کی ماندمی","سوی شهر دوستان می‌راندمی","در این وادی که پر از دشمنان است، من چگونه می‌توانم بمانم؟ خود را به سوی شهر دوستان می‌رسانم."],[693,"تخته مرده‌کشان بفراشتند","وان ابوبکر مرا برداشتند","تختی که مردگان را به دوش می‌کشند، برپا کردند و آن ابوبکر (که احتمالا یکی از چهره‌های برجسته و محترم است) را به من تقدیم کردند."],[693,"سوی خوارمشاه حمالان کشان","می‌کشیدندش که تا بیند نشان","حمالان (باربران) ابوبکر را به سمت محمد خوارزمشاه می‌بردند تا او نشانه‌ای را ببیند."],[693,"سبزوارست این جهان و مرد حق","اندرین جا ضایعست و ممتحق","در اینجا سبزوار به عنوان نمادی از جهان معرفی شده است و کسانی که در این دنیا هستند، به مثابه مردانی از حق و حقیقت، مورد ستم و ظلم قرار گرفته‌اند و در واقع، حق و حقیقت در این مکان نادیده گرفته می‌شود."],[693,"هست خوارمشاه یزدان جلیل","دل همی خواهد ازین قوم رذیل","محمد خوارزمشاه، که به مقام و عظمت خداوند عادل اعتقاد دارد، از مردم رذل و پست سبزوار دل خوشی ندارد و خواسته‌های او از این قوم، که با او طعنه می‌زنند، را نمی‌پسندد."],[693,"گفت لا ینظر الی تصویرکم","فابتغوا ذا القلب فی‌تدبیر کم","گفت او (محمد خوارزمشاه) به شما نگاه نمی‌کند، پس تلاش کنید تا دل‌هایی پر از محبت و فهم در تدبیر و اندیشه خود پیدا کنید."],[693,"من ز صاحب‌دل کنم در تو نظر","نه به نقش سجده و ایثار زر","من به دل صاحب‌دل توجه می‌کنم، نه به ظواهر سجده و نیکی‌های مادی."],[693,"تو دل خود را چو دل پنداشتی","جست و جوی اهل دل بگذاشتی","تو دل خود را مثل دل دیگران پنداشتی و به دنبال افراد با دل و احساس نرفتی."],[693,"دل که گر هفصد چو این هفت آسمان","اندرو آید شود یاوه و نهان","اگر دل انسان به اندازه‌ی هفت آسمان هم بزرگ باشد، اگر در آن معنایی نباشد، همچنان بیهوده و پوشیده خواهد بود."],[693,"این چنین دل ریزه‌ها را دل مگو","سبزوار اندر ابوبکری بجو","دل‌های ریز و کوچک همچون دل‌های ساکنان سبزوار را نباید با دل‌های بزرگ و اصلی مقایسه کرد، بلکه باید به دنبال دل‌های بزرگ و با ارزش مانند دل ابوبکر بود."],[693,"صاحب دل آینه شش‌رو شود","حق ازو در شش جهت ناظر بود","کسی که دارای دل پاک و روشن باشد، مانند آینه‌ای است که در تمام جهات توانایی دیدن دارد و حق (خدا) از طریق او به هر شش سمت ناظر است و به آنجا توجه دارد."],[693,"هر که اندر شش جهت دارد مقر","نکندش بی‌واسطه او حق نظر","هر کسی که در شش جهت (شمال، جنوب، شرق، غرب، بالا، پایین) جایگاهی نداشته باشد، حق (حقیقت) مستقیم به او نگاه نمی‌کند و نمی‌تواند از او بهره‌مند شود."],[693,"گر کند رد از برای او کند","ور قبول آرد همو باشد سند","هر کس که برای او (خدا) به خاطر او چیزی را رد کند، پس اگر چیزی را بپذیرد، همان شخص برای او اعتبار و دلیل است."],[693,"بی‌ازو ندهد کسی را حق نوال","شمه‌ای گفتم من از صاحب‌وصال","هیچ‌کس جز او (خدا) حقوقی را که به انسان‌ها تعلق دارد، به کسی نمی‌دهد. من تنها یک قسمت از حق (نوال) را از شخصی (صاحب‌وصال) که به عشق و وصال دست یافته است، بیان کردم."],[693,"موهبت را بر کف دستش نهد","وز کفش آن را به مرحومان دهد","هدیه را بر کف دست او قرار می‌دهد و او آن را از روی کف دست خود به مردگان می‌دهد."],[693,"با کفش دریای کل را اتصال","هست بی‌چون و چگونه و بر کمال","اتصال دریا به کل وجود، به‌گونه‌ای است که حتی از طریق یک کفش هم ممکن است و این ارتباط به‌طور کامل و بدون هیچ شکی وجود دارد."],[693,"اتصالی که نگنجد در کلام","گفتنش تکلیف باشد والسلام","اتصالی که در اینجا از آن صحبت می‌شود، آنقدر عظیم و عمیق است که نمی‌توان آن را با کلمات توصیف کرد؛ بیان این حقیقت خود مسئولیت سنگینی به دوش دارد و بهتر است خاموش ماند."],[693,"صد جوال زر بیاری ای غنی","حق بگوید دل بیار ای منحنی","اگر تو ثروتمند هستی، باید صد کیسه طلا بیاوری و خدا خواهد گفت که دل بیاور، ای کسی که دل را منحرف می‌کنی."],[693,"گر ز تو راضیست دل من راضیم","ور ز تو معرض بود اعراضیم","اگر دل من از تو راضی باشد، من هم راضی‌ام، و اگر دل تو از من ناخشنود باشد، من هم پشت می‌کنم و روی گردان می‌شوم."],[693,"ننگرم در تو در آن دل بنگرم","تحفه او را آر ای جان بر درم","من به ظاهر تو نگاه نمی‌کنم، بلکه به دل تو می‌نگرم. ای جان، هدیه او را نزد من بیاور."],[693,"با تو او چونست هستم من چنان","زیر پای مادران باشد جنان","من با تو مانند کسی هستم که زیر پای مادران قرار دارد، و در حقیقت بهشت (به معنای یک جایگاه والا) زیر پای آن‌هاست."],[693,"مادر و بابا و اصل خلق اوست","ای خنک آنکس که داند دل ز پوست","مادر و پدر و اصل و ریشه وجود انسان هستند و خوشابه حال کسی که بداند که حقیقت او به دل و باطنش مربوط می‌شود، نه به ظواهر و پوستش."],[693,"تو بگویی نک دل آوردم به تو","گویدت پرست ازین دلها قتو","اگر تو بگویی که دلی برای تو آورده‌ام، او به تو می‌گوید که از این دل‌ها من هیچ ندارم."],[693,"آن دلی آور که قطب عالم اوست","جان جان جان جان آدم اوست","آن دلی را بیاور که محور و مرکز جهان است و وجودش برای انسان‌ها بسیار ارزشمند و حیاتی است."],[693,"از برای آن دل پر نور و بر","هست آن سلطان دلها منتظر","برای آن دل باصفا و نورانی، آن سلطان دل‌ها در انتظار است."],[693,"تو بگردی روزها در سبزوار","آنچنان دل را نیابی ز اعتبار","اگر در شهر سبزوار روزها بگردی، هرگز دل معتبر و ارزشمندی نخواهی یافت."],[693,"پس دل پژمرده پوسیده‌جان","بر سر تخته نهی آن سو کشان","دل افسرده و نابود خودت را به سادگی بر روی تکه چوبی قرار بده و روانه کن به آن سمت."],[693,"که دل آوردم ترا ای شهریار","به ازین دل نبود اندر سبزوار","من دلی برای تو آورده‌ام، ای شهریار، که از این دل‌هایی که در سبزوار هستند، بهتر است."],[693,"گویدت این گورخانه‌ست ای جری","که دل مرده بدینجا آوری","بیش از این هم نمی‌توانی در این مکان بایستی، ای جری (که احتمالا نام شخصی است)، چرا که اینجا محل مرده‌هاست و تو نباید دل مرده‌ای را به اینجا بیاوری."],[693,"رو بیاور آن دلی کو شاه‌خوست","که امان سبزوار کون ازوست","بیاور دلی که همچون یک پادشاه است و شایسته امان و بخشش است، زیرا که امان‌دهی به مردم سبزوار به او بستگی دارد."],[693,"گویی آن دل زین جهان پنهان بود","زانک ظلمت با ضیا ضدان بود","انگار آن دل از این دنیا پنهان بود، زیرا ظلمت با نور در تضاد است."],[693,"دشمنی آن دل از روز الست","سبزوار طبع را میراثی است","دشمنی آن دل از روز الست (روز پایانی و آزمون بزرگ) به ارث برده است و طبیعت او مشتاق و خوی متخاصم دارد."],[693,"زانک او بازست و دنیا شهر زاغ","دیدن ناجنس بر ناجنس داغ","چون آن فرد (محمد خوارزمشاه) دوباره به شهر دنیا (سبزوار) برگشته، مانند زاغی است که تنها نوشیدن و تماشا کردن چیزهای بی‌کیفیت و ناچیز را می‌بیند."],[693,"ور کند نرمی نفاقی می‌کند","ز استمالت ارتفاقی می‌کند","اگر کسی نرمی و دروغی از روی نفاق و فریب به نمایش بگذارد، او این کار را برای جلب توجه و به دست آوردن منفعت‌های مالی یا اجتماعی انجام می‌دهد."],[693,"می‌کند آری نه از بهر نیاز","تا که ناصح کم کند نصح دراز","او (محمد خوارزمشاه) این کار را نه از روی نیاز و کمبود، بلکه به این دلیل انجام می‌دهد که نصیحت‌کننده (ناصح) نتواند نصیحت طولانی و بی‌نهایت‌اش را به او تحمیل کند."],[693,"زانک این زاغ خس مردارجو","صد هزاران مکر دارد تو به تو","این زاغ (زاغ، پرنده‌ای است که به مکر و فریب معروف است) از مردان بدسیرت و فریبکار است و به خاطر اینکه به دنبال منافع خود است، هزاران ترفند و فریب دارد که تو نیز به او مشغول شده‌ای."],[693,"گر پذیرند آن نفاقش را رهید","شد نفاقش عین صدق مستفید","اگر مردم در ابتدای کار نفاق (تقلب و دشمنی) او را بپذیرند، از او رهایی می‌یابند، زیرا نفاق او به حقیقت صداقت منتهی می‌شود و از آن بهره‌مند خواهند شد."],[693,"زانک آن صاحب دل با کر و فر","هست در بازار ما معیوب‌خر","چون آن شخص صاحب دل در میان ما است با نقص و کمبود، در واقع ما هم به نوعی دچار عیب و کاستی هستیم و نمی‌توانیم در بازار عشق و معرفت بدون عیب و نقص حاضر شویم."],[693,"صاحب دل جو اگر بی‌جان نه‌ای","جنس دل شو گر ضد سلطان نه‌ای","اگر حقیقتا عارف و صاحب دل هستی، باید جان خود را فدای این عشق کنی؛ و اگر نمی‌توانی، پس به‌جای آن، دلی با صفا و پاک ایجاد کن و در برابر قدرت‌ها و سلطنت‌ها تسلیم نشو."],[693,"آنک زرق او خوش آید مر ترا","آن ولی تست نه خاص خدا","هر کس که زرق و فریب او برای تو خوشایند است، بدان که او ولی (صحیح) تو نیست و فقط اختصاص به خدا ندارد."],[693,"هر که او بر خو و بر طبع تو زیست","پیش طبع تو ولی است و نبیست","هر کسی که مطابق سلیقه و طبیعت تو زندگی کند، در واقع او ولی و پیامبر توست."],[693,"رو هوا بگذار تا بویت شود","وان مشام خوش عبرجویت شود","بگذار بوی خوشی که از تو برمی‌خیزد، در فضا قوی و مشهود شود، و رایحه شیرین عطرت به مشام‌ها برسد."],[693,"از هوارانی دماغت فاسدست","مشک و عنبر پیش مغزت کاسدست","بوی بدی که از دماغ تو می‌آید، ناشی از ناپاکی و آلودگی روح توست و عطرهایی چون مشک و عنبر (که باارزش و خوشبو هستند) به خاطر افکار ناپسند تو بی‌ارزش شده‌اند."],[693,"حد ندارد این سخن و آهوی ما","می‌گریزد اندر آخر جابجا","این سخن حد و اندازه‌ای ندارد و در آخر کار، آهوی ما (که نماد چیزی گمشده یا هدفی مطلوب است) از دست ما می‌گریزد و جابجا می‌شود."],[694,"روزها آن آهوی خوش‌ناف نر","در شکنجه بود در اصطبل خر","آهوی نر زیبا روزها در اصطبل خر تحت فشار و عذاب بود."],[694,"مضطرب در نزع چون ماهی ز خشک","در یکی حقه معذب پشک و مشک","آهو همچون ماهی که از خشکی به تنگ آمده و در اضطراب است، در حال زجر و عذاب به سر می‌برد و همزمان بوی خوش مشک و پشک (نوعی خوشبویی) را پخش می‌کند."],[694,"یک خرش گفتی که ها این بوالوحوش","طبع شاهان دارد و میران خموش","یکی از خرهای حاضران گفت که این شخص خارج‌ازنظم، عادت و روحی چون شاهان دارد و ساکنان آرام و خموش را می‌ترساند."],[694,"وآن دگر تسخر زدی کز جزر و مد","گوهر آوردست کی ارزان دهد","دیگری به تو می‌خندد و می‌گوید که او (خر) از جزر و مد (تغییرات دائمی) دریا جوهر (گوهر) می‌آورد، پس آیا او این چیز را ارزان می‌فروشد؟"],[694,"وآن خری گفتی که با این نازکی","بر سریر شاه شو گو متکی","خر به او می‌گوید که با این نازکی و ظرافت نمی‌توانی بر تخت شاهی تکیه کنی."],[694,"آن خری شد تخمه وز خوردن بماند","پس برسم دعوت آهو را بخواند","آن خر دچار خواب آلودگی و سنگینی ناشی از پرخوری شد و دیگر نتوانست به دعوت آهو پاسخ دهد و او را بخواند."],[694,"سر چنین کرد او که نه رو ای فلان","اشتهاام نیست هستم ناتوان","آن خر به آهو می‌گوید که من به‌خاطر ضعف و ناتوانی‌ام، تمایلی به خوردن ندارم و به همین دلیل از تو دعوت نمی‌کنم."],[694,"گفت می‌دانم که نازی می‌کنی","یا ز ناموس احترازی می‌کنی","گفت: می‌دانم که تو به خاطر زیبا و دلنشین بودن خود ناز می‌کنی یا به خاطر حفظ آبرو و ناموس خود این کار را می‌کنی."],[694,"گفت او با خود که آن طعمه توست","که از آن اجزای تو زنده و نوست","او با خود می‌گوید که آنچه تو به عنوان طعمه می‌خوانی، از اجزای وجود توست و باعث زنده‌بودن و تازگی تو می‌شود."],[694,"من الیف مرغزاری بوده‌ام","در زلال و روضه‌ها آسوده‌ام","به یاد پرندگان زنگی و خوشی‌ها و آسایش‌هایی که در باغ‌ها و چمنزارها داشته‌ام، فکر می‌کنم. من در جای آرام و دلپذیری زندگی کرده‌ام که با زیبایی‌ها و آرامش احاطه شده است."],[694,"گر قضا انداخت ما را در عذاب","کی رود آن خو و طبع مستطاب","اگر مقدر شده باشد که ما در عذاب بیفتیم، هیچ‌کس نمی‌تواند از آن خواسته و طبیعت نیکوی خود خارج شود."],[694,"گر گدا گشتم گدارو کی شوم","ور لباسم کهنه گردد من نوم","اگر من گدای دنیا شدم، چه زمانی می‌توانم به مقام و عظمت برسم؟ و اگر لباس من کهنه شود، برای من زشت و ننگین است که دچار نومیدی بشوم."],[694,"سنبل و لاله و سپرغم نیز هم","با هزاران ناز و نفرت خورده‌ام","من عشق و زیبایی را به همراه زهر و نفرت تحمل کرده‌ام، حتی با گل‌ها و گیاهان زیبا مانند سنبل و لاله نیز به همین شکل رفتار کرده‌ام."],[694,"گفت آری لاف می‌زن لاف‌لاف","در غریبی بس توان گفتن گزاف","گفت: بله، تو فقط دروغ می‌زنی و ادعا می‌کنی، چرا که در این دنیای بیگانه، هر کسی می‌تواند چیزهای بزرگ و اغراق‌آمیز بگوید."],[694,"گفت نافم خود گواهی می‌دهد","منتی بر عود و عنبر می‌نهد","گفت ناف من (دستگاه تناسلی) خود دلیلی بر این است که بر عطر و خوشبوئی (عود و عنبر) افتخار می‌کند."],[694,"لیک آن را کی شنود صاحب‌مشام","بر خر سرگین‌پرست آن شد حرام","اما کسی که بوی خوش را می‌شنود، نمی‌تواند از آن خر رنجبر که خودش در فضولات است، به خاطر بوی کمیاب و خوب بهره‌مند شود؛ در حقیقت چنین چیزی برای او حرام است."],[694,"خر کمیز خر ببوید بر طریق","مشک چون عرضه کنم با این فریق","خر کمیز (خر دنبه‌دار) بوی خوبی دارد و در راه خوشبو (راهی که بوی مشک دارد)، چون من آن را به این گروه (آدمیان) نشان دهم."],[694,"بهر این گفت آن نبی مستجیب","رمز الاسلام فی‌الدنیا غریب","این پیام را آن پیامبر (محمد) برای پاسخگویی به دعاها به عنوان رمز اسلام در دنیا گفته است، که به نوعی در زندگی این دنیا غریب و ناپیداست."],[694,"زانک خویشانش هم از وی می‌رمند","گرچه با ذاتش ملایک هم‌دمند","زیرا خویشاوندانش نیز از او دوری می‌کنند، هرچند که فرشتگان با ذات او هم‌نشین هستند."],[694,"صورتش را جنس می‌بینند انام","لیک از وی می‌نیابند آن مشام","مردم او را فقط به شکل و ظاهرش می‌شناسند و او را جنس و مخلوقی از همین دنیا می‌دانند، اما نتوانسته‌اند بویی از حقیقت و معنای واقعی او ببرند و درک کنند که او چه ویژگی‌های عمیق‌تری دارد."],[694,"هم‌چو شیری در میان نقش گاو","دور می‌بینش ولی او را مکاو","چنان‌که شیر در بین تصویر گاو دیده می‌شود، مردم او را تنها به شکل ظاهری‌اش می‌بینند، اما به عمق ماهیت او پی نمی‌برند."],[694,"ور بکاوی ترک گاو تن بگو","که بدرد گاو را آن شیرخو","اگر به دنبال حقیقت گاو باشی و آن را بررسی کنی، باید بدانی که آن شیر، به درد گاو می‌خورد و تنها در ظاهر به شکل گاو است."],[694,"طبع گاوی از سرت بیرون کند","خوی حیوانی ز حیوان بر کند","طبع گاوی (یعنی ویژگی‌های رفتار و شخصیت گاو) از سرت خارج می‌شود و خوی حیوانی (خصوصیات جانوری) را از وجودت دور می‌کند."],[694,"گاو باشی شیر گردی نزد او","گر تو با گاوی خوشی شیری مجو","اگر در میان افراد نادان و بی‌خود به سر ببری، هرگز به مقام و ارزش معنوی واقعی نخواهی رسید، حتی اگر ظاهرا در آن جمع به محبوبیت یا هیبت برسید."],[695,"آن عزیز مصر می‌دیدی به خواب","چونک چشم غیب را شد فتح باب","عزیز مصر (یعنی یوسف) در خواب حوادث آینده را می‌دید، زیرا چشم او به علم غیب گشوده شده بود."],[695,"هفت گاو فربه بس پروری","خوردشان آن هفت گاو لاغری","هفت گاو چاق و فربه به خوبی پرورش یافته‌اند، اما این هفت گاو لاغر با شهوت و گرسنگی به آنها حمله می‌کنند تا آنها را بخورند."],[695,"در درون شیران بدند آن لاغران","ورنه گاوان را نبودندی خوران","در واقع، آن گاوهای لاغر درون‌شان شیران و درندگان پنهان هستند که توانایی خوردن گاوهای فربه را دارند، وگرنه آن گاوها نمی‌توانستند چیزی را بخورند."],[695,"پس بشر آمد به صورت مرد کار","لیک در وی شیر پنهان مردخوار","انسان به شکل ظاهری یک مرد به دنیا می‌آید، اما در درون او می‌تواند همانند شیری گرسنه و درنده باشد که به دیگران آسیب می‌زند."],[695,"مرد را خوش وا خورد فردش کند","صاف گردد دردش ار دردش کند","انسان وقتی که به خوشی و لذت‌های زندگی برسد، زودتر از مشکلات و دردها آزاد می‌شود و با این خوشی‌ها، روح و افکارش صاف و روشن می‌شود."],[695,"زان یکی درد او ز جمله دردها","وا رهد پا بر نهد او بر سها","اگر انسانی از تمام دردها رها شود، باید بر روی خوشحالی و شادی بایستد و بر آن تکیه کند."],[695,"چند گویی هم‌چو زاغ پر نحوس","ای خلیل از بهر چه کشتی خروس","ای خلیل (حضرت ابراهیم)، چرا به مانند زاغی که بدی و شومی می‌گوید، زیاد سخن می‌گویی؟ چرا به خاطر چه چیز، خروس را کشتید؟"],[695,"گفت فرمان حکمت فرمان بگو","تا مسبح گردم آن را مو به مو","خداوند می‌گوید که فرمان حکمت را به‌طور دقیق و روشن بیان کن تا من بتوانم آن را هر چه بیشتر تفسیر و توضیح دهم."],[696,"شهوتی است او و بس شهوت‌پرست","زان شراب زهرناک ژاژ مست","شهوت، همان شهوتی است که فقط به خود می‌پردازد و در آن چیزی جز خواسته‌های نفسانی وجود ندارد. مانند شرابی زهرآگین که انسان را مست می‌کند و به بی‌خودی می‌کشاند."],[696,"گرنه بهر نسل بودی ای وصی","آدم از ننگش بکردی خود خصی","اگر تو ای وصی آدم (نواده او) به خاطر ننگ این شهوت‌پرستی و بی‌خردی از نسل آدم بودی، باید خودت را از این عیب پاک می‌کردی و به نوعی خنثی یا عقیم می‌گشتی."],[696,"گفت ابلیس لعین دادار را","دام زفتی خواهم این اشکار را","ابلیس لعین (شیطان) به خداوند می‌گوید که می‌خواهم دامی بزرگ برای او (انسان) بگذارم که این حقیقت را به طور آشکار نشان دهد."],[696,"زر و سیم و گله اسپش نمود","که بدین تانی خلایق را ربود","ابلیس در اینجا با طلا و نقره و گروهی از اسبان خود را نشان می‌دهد تا به وسیله آن‌ها خلایق را فریب دهد و به چنگ آورد."],[696,"گفت شاباش و ترش آویخت لنج","شد ترنجیده ترش هم‌چون ترنج","گفتن «شاباش» به معنای تبریک گفتن است و در اینجا به نشانه خوش‌حالی است. اما حالتی عبوس و ترش به خود گرفت و احساس خوشحالی او به حالت ترش و در هم رفته‌ای تغییر کرد، مانند میوه ترنج که طعمی ترش دارد."],[696,"پس زر و گوهر ز معدنهای خوش","کرد آن پس‌مانده را حق پیش‌کش","خداوند پس از آزمایش و محنت، در نهایت به کسانی که باقی مانده‌اند و در مسیر حق پیش‌رفتن، از معدن‌های گران‌بها، طلا و جواهر می‌دهد و آن‌ها را مورد لطف و رحمت قرار می‌دهد."],[696,"گیر این دام دگر را ای لعین","گفت زین افزون ده ای نعم‌المعین","ای شیطان، این دام را بگیر و در آن گرفتار کن، زیرا بیش از این، چیزی به من نده، ای کسی که به من کمک می‌کنی."],[696,"چرب و شیرین و شرابات ثمین","دادش و بس جامه ابریشمین","این بیت به توصیف نعمت‌ها و لذت‌هایی می‌پردازد که به کسی داده می‌شود، مانند خوراکی‌های خوشمزه و نوشیدنی‌های گرانبها، و همچنین لباس‌های زرق و برق‌دار. اشاره به فریبندگی و جذابیت این نعمت‌ها دارد که ممکن است فرد را از مسیری درست منحرف کند."],[696,"گفت یا رب بیش ازین خواهم مدد","تا ببندمشان به حبل من مسد","خلیل علیه‌السلام از خداوند درخواست می‌کند تا بیش از این کمک کند، زیرا می‌خواهد مریدان را به خود وصل کند و آنها را به محبت و پیوندی عمیق‌تر با خود متصل نماید."],[696,"تا که مستانت که نر و پر دلند","مردوار آن بندها را بسکلند","تا زمانی که مستان تو که نر و دلیر هستند، مانند مردان قوی آن بندها را بشکنند."],[696,"تا بدین دام و رسنهای هوا","مرد تو گردد ز نامردان جدا","برای اینکه انسان از صفات ناپسند جدا شود و به مقام مردانگی برسد، لازم است که در دام و وابستگی‌های دنیوی و جنبه‌های ناپسند خود گرفتار نگردد."],[696,"دام دیگر خواهم ای سلطان تخت","دام مردانداز و حیلت‌ساز سخت","من دیگر به دام‌های فریبنده و مهلک تو، ای سلطان و شاه، نیاز دارم؛ دامی که انسان‌ها را از بین ببرد و به وسیله نیرنگ و حیله، آنان را تضعیف کند."],[696,"خمر و چنگ آورد پیش او نهاد","نیم‌خنده زد بدان شد نیم‌شاد","می‌نوشند و ساز می‌زنند و پیشنهاد را نزد او می‌آورند، او نیز با لبخندی نیمه‌جان و حالتی اندکی شاد به آن واکنش نشان می‌دهد."],[696,"سوی اضلال ازل پیغام کرد","که بر آر از قعر بحر فتنه گرد","پیام‌هایی از عالم ازل به سمت گمراهی فرستاده شد که از عمق فتنه و یأس، زباله‌ها و آلودگی‌ها را پاک کن."],[696,"نی یکی از بندگانت موسی است","پرده‌ها در بحر او از گرد بست","موسی یکی از بندگان خداست و اشاره به او به این معناست که حتی در دل ظلمت و فتنه‌ها می‌تواند پرده‌ها و موانع را کنار بزند و نور حقیقت را نمایان سازد."],[696,"آب از هر سو عنان را واکشید","از تگ دریا غباری برجهید","آب از همه‌جا به سوی زمین کشیده شده و از عمق دریا حبابی به‌وجود آمده است. این تصویر می‌تواند اشاره‌ای به ظهور و بروز یک واقعیت یا تغییر عمیق در جهان باشد."],[696,"چونک خوبی زنان فا او نمود","که ز عقل و صبر مردان می‌فزود","چون زیبایی زنان بر او ظاهر شد، عقل و صبر مردان را افزایش می‌دهد."],[696,"پس زد انگشتک به رقص اندر فتاد","که بده زوتر رسیدم در مراد","سپس انگشتی به نشانه شادی زد و به رقص درآمد که زودتر به خواسته‌ام برسم."],[696,"چون بدید آن چشمهای پرخمار","که کند عقل و خرد را بی‌قرار","آن چشمان خواب‌آلود و عاشقانه باعث می‌شود که عقل و هوش آدمی به هم ریخته و بی‌قرار شود."],[696,"وآن صفای عارض آن دلبران","که بسوزد چون سپند این دل بر آن","زیبایی صورت آن محبوبان چنان است که دل را می‌سوزاند و به درد و شوق می‌آورد، مانند آتش خوشبو و نشاط‌آور."],[696,"رو و خال و ابرو و لب چون عقیق","گوییا حق تافت از پرده رقیق","چهره و حال و زیبایی‌های او چون عقیق درخشان است، گویی که نور حق از پرده نازک و ظریفی تابیده و او را روشن کرده است."],[696,"دید او آن غنج و برجست او سبک","چون تجلی حق از پرده تنک","او آن زیبایی‌ها و فریبندگی‌های ظاهری را مانند تابش نور الهی از پشت پرده نازکی می‌بیند و به این خاطر در درک آنچه از عالم مادی می‌گذرد، سبکی و ناپایداری را حس می‌کند."],[697,"آدم حسن و ملک ساجد شده","هم‌چو آدم باز معزول آمده","آدم در اصل زیبایی و کمال آفریده شده و فرشتگان برای او سجده کرده‌اند، اما او اکنون به حالتی سقوط کرده و از مقام خود پایین آمده است."],[697,"گفت آوه بعد هستی نیستی","گفت جرمت این که افزون زیستی","در این بیت، راوی به شخصی می‌گوید که بعد از وجود و زندگی، در نهایت به نیستی و عدم می‌رسد. این اشاره به گناه اوست که دلیلش این است که زندگی خود را بیش از حد طولانی کرده و فرصت‌ها را از دست داده است."],[697,"جبرئیلش می‌کشاند مو کشان","که برو زین خلد و از جوق خوشان","جبرئیل (فرشته‌ای که پیام‌های الهی را به پیامبران می‌رساند) او را به آرامی و به ناز به خارج از بهشت می‌برد، تا از جمع خوش‌ساختان و نیکان دور شود."],[697,"گفت بعد از عز این اذلال چیست","گفت آن دادست و اینت داوریست","بعد از افت کردن از مقام و عزت، این تحقیر و ذلت چه معنایی دارد؟ جبرئیل جواب می‌دهد که این ذلت از سوی خداوند است و اوست که بر اساس حکمت و قضاوتش چنین کرده است."],[697,"جبرئیلا سجده می‌کردی به جان","چون کنون می‌رانیم تو از جنان","جبرئیل، فرشته‌ای که به خداوند خدمت می‌کند، زمانی به خاطر روح و جان انسان سجده می‌کرد، اما اکنون ما او را به سبب اعمالش از بهشت طرد می‌کنیم."],[697,"حله می‌پرد ز من در امتحان","هم‌چو برگ از نخ در فصل خزان","جامه (حله) از من در امتحان می‌افتد و جدا می‌شود، مثل برگی که در فصل پاییز از درخت می‌افتد."],[697,"آن رخی که تاب او بد ماه‌وار","شد به پیری هم‌چو پشت سوسمار","آن چهره‌ای که مانند ماه نورانی و درخشان بود، به پیری همچون پشت مار، چین و چروک و رنگ و رویی نازیبا پیدا کرده است."],[697,"وان سر و فرق گش شعشع شده","وقت پیری ناخوش و اصلع شده","در این بیت اشاره‌ای به پیری و تغییرات ظاهری ناشی از آن است. با رسیدن به سن پیری، موها می‌ریزد و شخص با حالی ناخوش و از دست دادن زیبایی مواجه می‌شود. کلمه «اصلع» به معنای کچل است که نشان‌دهنده‌ی کم‌مویی یا بی‌مویی در پیری است."],[697,"وان قد صف در نازان چون سنان","گشته در پیری دو تا هم‌چون کمان","در دوران پیری، قامت و اندام او مانند کمانی خمیده شده است و حالتی نازک و ظریف به خود گرفته که یادآور سنان (خنجر) است."],[697,"رنگ لاله گشته رنگ زعفران","زور شیرش گشته چون زهره زنان","رنگ چهره‌اش مانند رنگ لاله شده و نیروی او مانند نیروی زعفران ضعیف شده است، و قوتش همانند قدرت زنان کاهش یافته است."],[697,"آنک مردی در بغل کردی به فن","می‌بگیرندش بغل وقت شدن","اگر مردی را در آغوش بگیری، وقتی که به او توجه و هنر نشان دهی، او نیز به تدریج به محبت و عشق فراخوانده می‌شود."],[697,"این خود آثار غم و پژمردگیست","هر یکی زینها رسول مردگیست","این عواطف و نشانه‌های غم و ناخوشی، هر یک پیامی از مردگی و از دست دادن زندگی را برای ما به ارمغان می‌آورند."],[698,"لیک گر باشد طبیبش نور حق","نیست از پیری و تب نقصان و دق","اگر طبیب او، یعنی کسی که برای درمانش تلاش می‌کند، نور حق باشد، به طور حتم مشکل پیری، بیماری و نقصان او حل خواهد شد."],[698,"سستی او هست چون سستی مست","که اندر آن سستیش رشک رستمست","سستی و ضعف او مانند سستی یک فرد مست است که در حال بی‌حالی و ناتوانی، به او حسادت می‌شود، مانند رشک به رستم، پهلوان بزرگ و قهرمان اساطیری ایران."],[698,"گر بمیرد استخوانش غرق ذوق","ذره ذره‌ش در شعاع نور شوق","اگر استخوان او بمیرد، هر ذره‌اش در نور شوق غرق خواهد شد و لذت آن را تجربه می‌کند."],[698,"وآنک آنش نیست باغ بی‌ثمر","که خزانش می‌کند زیر و زبر","این بیت اشاره دارد به باغی که بی‌ثمر است و هیچ میوه‌ای نمی‌دهد. این باغ به دلیل خزان (فصل سرد و افتادن برگ‌ها) کاملا به هم ریخته و ویران می‌شود، به این معنی که وقتی نتیجه یا ثمره‌ای وجود ندارد، وضعیت به شدت خراب می‌گردد."],[698,"گل نماند خارها ماند سیاه","زرد و بی‌مغز آمده چون تل کاه","در این بیت، شاعر به وضعیت نامطلوبی اشاره می‌کند که در آن فقط خارها باقی مانده و گل‌ها رفته‌اند. این ایهام نشان‌دهنده بی‌رمق و بی‌خاصیت شدن اوضاع است، به‌طوری که همه چیز به تلی از کاه و بی‌فایده تبدیل شده است."],[698,"تا چه زلت کرد آن باغ ای خدا","که ازو این حله‌ها گردد جدا","خداوند، چه چیز باعث این سقوط و ذلت آن باغ شده است که این لباس‌های زیبا و خوب از آن جدا شده‌اند؟"],[698,"خویشتن را دید و دید خویشتن","زهر قتالست هین ای ممتحن","خودش را مشاهده کرد و فهمید که وجودش همانند زهر است، ای امتحان‌کننده (یعنی خداوند)."],[698,"شاهدی کز عشق او عالم گریست","عالمش می‌راند از خود جرم چیست","شاهدی که به خاطر عشق او، عالم (دنیا) گریه کرد و از خود (شخصیت و هستی‌اش) دور شد، چه گناهی دارد؟"],[698,"جرم آنک زیور عاریه بست","کرد دعوی کین حلل ملک منست","گناه آن کسی که زیور زینتی را به امانت گرفته، این است که ادعای مالکی می‌کند و می‌گوید که این لباس‌های سلطنتی از آن من است."],[698,"واستانیم آن که تا داند یقین","خرمن آن ماست خوبان دانه‌چین","باید بپذیریم که تا زمانی که این واقعیت را به‌خوبی درک نکنیم، در حقیقت، آنچه ارزشمند و زیباست، از آن ما نیست و ما همچنان مانند کسانی خواهیم بود که به دنبال بهره‌گیری از زیبایی‌ها هستند، بدون اینکه مالک واقعی آن‌ها باشیم."],[698,"تا بداند کان حلل عاریه بود","پرتوی بود آن ز خورشید وجود","برای دانستن این که لباس‌های زیبا و فریبنده تنها عاریه‌ای و موقتی هستند، باید بفهمیم که این زیبایی فقط یک پرتو از تابش خورشید وجود است."],[698,"آن جمال و قدرت و فضل و هنر","ز آفتاب حسن کرد این سو سفر","این زیبایی، قدرت، محبت و هنر که در این سمت نمایان شده، از خورشید وجود (خدا یا حقیقت) سفر کرده و به اینجا آمده است."],[698,"باز می‌گردند چون استارها","نور آن خورشید ازین دیوارها","اشاره به این است که مانند ستاره‌ها، موجودات به دنیای مادی برمی‌گردند و نور حقیقت و روشنی آن خورشید، که نماد نور الهی یا محبت است، از این دیوارهای تیره و تار (موانع و مشکلات) عبور می‌کند."],[698,"پرتو خورشید شد وا جایگاه","ماند هر دیوار تاریک و سیاه","نور خورشید به وجود آمده و در اینجا باقی مانده است، اما هر دیوار تاریک و سیاه هنوز در جای خود باقی مانده است."],[698,"آنک کرد او در رخ خوبانت دنگ","نور خورشیدست از شیشه سه رنگ","نور خورشید در چهره‌ی زیبا و دل‌انگیز شما مانند نوری است که از شیشه‌ای سه رنگ به نمایش درآمده است."],[698,"شیشه‌های رنگ رنگ آن نور را","می‌نمایند این چنین رنگین بما","شیشه‌های رنگی، نور را به شکل‌های مختلف و زیبا نشان می‌دهند و این تفسیر به ما می‌گوید که واقعیت نور (حقایق) به واسطه رنگ‌ها و جلوه‌های مختلف دنیوی به ما منتقل می‌شود."],[698,"چون نماند شیشه‌های رنگ‌رنگ","نور بی‌رنگت کند آنگاه دنگ","وقتی که شیشه‌های رنگی دیگر وجود نداشته باشد، نور بی‌رنگ تو را بی‌وقفه در خود فرومی‌برد و می‌گیرد."],[698,"خوی کن بی‌شیشه دیدن نور را","تا چو شیشه بشکند نبود عمی","بینش خود را از ظواهر و رنگ‌ها خالی کن تا وقتی که شیشه‌ای (که نماد دنیای مادی و پر زرق و برق است) شکست، درک واقعی نور (حقیقت) را از دست ندهی."],[698,"قانعی با دانش آموخته","در چراغ غیر چشم افروخته","کسی که به دانش خود راضی است، نیازی به نور و روشنی دیگران ندارد و در حقیقت، به دانش خود و روشنایی آن اطمینان دارد."],[698,"او چراغ خویش برباید که تا","تو بدانی مستعیری نی‌فتا","او بر می‌دارد که می‌دانی، چراغ خود را، که به خاطر روشنایی‌اش نمی‌توانی به دیگران وابسته شوی."],[698,"گر تو کردی شکر و سعی مجتهد","غم مخور که صد چنان بازت دهد","اگر تو شکرگزاری کنی و با کوشش و تلاش عمل کنی، نگران نباش که خداوند صد برابر آنچه را که داده، به تو بازخواهد داد."],[698,"ور نکردی شکر اکنون خون گری","که شدست آن حسن از کافر بری","اگر شکرگزاری نکنی، نگران نباش؛ چون زیبایی و خوبی که از کافر به دست آمده، همگی از او جدا خواهد شد و تو را به اندوه می‌اندازد."],[698,"امة الکفران اضل اعمالهم","امة الایمان اصلح بالهم","کسانی که به کفر و ناسپاسی مشغولند، اعمالشان هدر می‌رود و فاسد می‌شود، اما کسانی که به ایمان و درستکاری پرداخته‌اند، حالشان نیکو و بهتر می‌شود."],[698,"گم شد از بی‌شکر خوبی و هنر","که دگر هرگز نبیند زان اثر","از بی‌قدردانی، خوبی و هنر گم شده است و دیگر هرگز آن آثار را نخواهد دید."],[698,"خویشی و بی‌خویشی و سکر وداد","رفت زان سان که نیاردشان به یاد","انسان‌ها بر اساس خویشی و غیرخویشی (دوستی و دشمنی) و همچنین حالت مستی و سرمستی (احساسات و عواطف مختلف) می‌گذرانند، و این حال‌ها به‌گونه‌ای است که دیگر نمی‌توانند به گذشته‌های خود بیندیشند یا آن‌ها را به یاد بیاورند."],[698,"که اضل اعمالهم ای کافران","جستن کامست از هر کام‌ران","اعمال کافران، که در جست‌وجوی لذت‌ها و خواسته‌ها هستند، نابودترین اعمال‌اند."],[698,"جز ز اهل شکر و اصحاب وفا","که مریشان راست دولت در قفا","جز گروهی که شکرگذار و وفادارند، هیچ‌کس را در این عالم، یاری و خوشبختی نخواهد بود."],[698,"دولت رفته کجا قوت دهد","دولت آینده خاصیت دهد","دولت یا قدرتی که از دست رفته، به کجا رفته است که اکنون نیازی به آن احساس نمی‌شود؟ دولت آینده نیز باید خصوصیات مثبتی به ما بدهد."],[698,"قرض ده زین دولت اندر اقرضوا","تا که صد دولت ببینی پیش رو","از این دولت و نعمت، قرض بگیر و از آن بهره‌مند شو، زیرا با این کار می‌توانی به نعمت‌های زیادی دست یابی."],[698,"اندکی زین شرب کم کن بهر خویش","تا که حوض کوثری یابی به پیش","اندکی از این نوشیدنی را برای خود کم کن تا به حوض کوثر (حوضی در بهشت) برسی و از آن بهره‌مند شوی."],[698,"جرعه بر خاک وفا آنکس که ریخت","کی تواند صید دولت زو گریخت","کسی که پیام وفاداری را بر زمین بریزد و به آن پایبند نباشد، چگونه می‌تواند در جست‌وجوی رفاه و سعادت باشد و به آن دست یابد؟"],[698,"خوش کند دلشان که اصلح بالهم","رد من بعد التوی انزالهم","دل‌هایشان را شاد می‌کند، زیرا خداوند به اصلاح حالشان می‌پردازد و بعد از سختی‌ها، آن‌ها را در می‌یابد و به آنها مهربانی می‌کند."],[698,"ای اجل وی ترک غارت‌ساز ده","هر چه بردی زین شکوران باز ده","ای اجل (فرشته مرگ)، تو که باعث هلاکت و غارت زندگی انسان‌ها هستی، هر آنچه را که از این سپاسگزاران (انسان‌ها) گرفته‌ای، به آن‌ها بازگردان."],[698,"وا دهد ایشان بنپذیرند آن","زانک منعم گشته‌اند از رخت جان","این افراد به نعمت‌ها و بخشش‌های خود قانعت نمی‌کنند، زیرا آن‌ها از زمانی که به مقام نعمت رسیده‌اند، از حقایق و حقیقت زندگی غافل شده‌اند."],[698,"صوفییم و خرقه‌ها انداختیم","باز نستانیم چون در باختیم","ما صوفی هستیم و لباس‌های مخصوص خود را کنار گذاشته‌ایم، اما چون در عشق و حقیقت باخته‌ایم، دیگر چیزی از ما نخواهید گرفت."],[698,"ما عوض دیدیم آنگه چون عوض","رفت از ما حاجت و حرص و غرض","ما عوض را تغییر دادیم و وقتی که آن عوض (معنوی) از ما رفت، دیگر نیازی به حرص و خواسته‌های دنیوی نداریم."],[698,"ز آب شور و مهلکی بیرون شدیم","بر رحیق و چشمه کوثر زدیم","ما از آبی تلخ و خطرناک نجات پیدا کردیم و به آب گوارا و خوشگوار بهشتی یعنی چشمه کوثر رسیدیم."],[698,"آنچ کردی ای جهان با دیگران","بی‌وفایی و فن و ناز گران","ای جهان، تو با دیگران بی‌وفا بودی و با فریب و ناز به آنها ظلم کردی."],[698,"بر سرت ریزیم ما بهر جزا","که شهیدیم آمده اندر غزا","ما برای تو که مانند کسی شهید شده‌ای به خاطر پاداش، سنگ سر می‌ریزیم، زیرا ما در نبرد حاضر شده‌ایم."],[698,"تا بدانی که خدای پاک را","بندگان هستند پر حمله و مری","این بیت می‌گوید که باید دانست که خداوند پاک، بندگانی دارد که در برابر حملات و مشکلات صبر و استقامت دارند."],[698,"سبلت تزویر دنیا بر کنند","خیمه را بر باروی نصرت زنند","دنیا با تمام فریبندگی‌اش، مانند خیمه‌ای است که بر فراز بارویی از نصرت و حمایت قرار دارد. کسانی که در این خیمه زندگی می‌کنند، باید این فریب را کنار بزنند تا به حقیقت دست یابند و به یاری و حمایت الهی برسند."],[698,"این شهیدان باز نو غازی شدند","وین اسیران باز بر نصرت زدند","این جان‌باختگان دوباره به حالت قهرمانی بازگشته‌اند و این اسیران دوباره برای حمایت و یاری ظهور کرده‌اند."],[698,"سر برآوردند باز از نیستی","که ببین ما را گر اکمه نیستی","آن‌ها (شهیدان و اسیران) از حالتی که نیستند (معنای عدم) دوباره سر برآورده‌اند و می‌گویند اگر نیستی وجود دارد، پس ما را ببینید."],[698,"تا بدانی در عدم خورشیدهاست","وآنچ اینجا آفتاب آنجا سهاست","در عالم عدم، نورهایی مانند خورشید وجود دارد و آنچه که در اینجا به عنوان آفتاب شناخته می‌شود، در آنجا ستاره‌هایی با نور ودرخشندگی خاص خود هستند."],[698,"در عدم هستی برادر چون بود","ضد اندر ضد چون مکنون بود","در دنیای عدم، برادری وجود دارد که گاهی ضد و نقیض‌ها در یکدیگر نهفته‌اند. این ارتباط و تضاد در عالم هستی، نشان‌دهنده رازهایی است که در پس ظاهر پنهان شده‌اند."],[698,"یخرج الحی من المیت بدان","که عدم آمد امید عابدان","زندگی را از مردگی خارج می‌کند، زیرا عدم باعث امید عابدان (مؤمنان) شده است."],[698,"مرد کارنده که انبارش تهیست","شاد و خوش نه بر امید نیستیست","مردی که کار می‌کند و انبارش از کالاهای دنیا خالی است، شاد و خوشحال است نه بر اساس امید به نیستی و عدم."],[698,"که بروید آن ز سوی نیستی","فهم کن گر واقف معنیستی","اگر به سوی نیستی بروی و به آن توجه کنی، درک کن که این مسیر چگونه است؛ اگر واقعا به معنای آن آگاه هستی."],[698,"دم به دم از نیستی تو منتظر","که بیابی فهم و ذوق آرام و بر","هر لحظه باید از نیستی خود آگاه باشی تا بتوانی درک و احساس آرامش را به دست آوری."],[698,"نیست دستوری گشاد این راز را","ورنه بغدادی کنم ابخاز را","این راز که درباره وجود و عدم است، به هیچ دستور و قواعدی قابل توضیح نیست. اگر این امکان وجود داشت، من به سادگی می‌توانستم آن را برای اهل بغداد روشن کنم."],[698,"پس خزانه صنع حق باشد عدم","که بر آرد زو عطاها دم به دم","خزانه آفرینش، در واقع عدم است و از این عدم به طور مداوم، نعمت‌ها و بخشش‌هایی از سوی حق به وجود می‌آید."],[698,"مبدع آمد حق و مبدع آن بود","که برآرد فرع بی‌اصل و سند","خالق اصلی آمد و هدف او این بود که شاخه‌ای را بدون آنکه ریشه و سندی داشته باشد، به وجود آورد."],[699,"نیست را بنمود هست و محتشم","هست را بنمود بر شکل عدم","عدم را به صورت وجود و زیبایی نشان می‌دهد، و وجود را به شکل عدم و زشتی نمایان می‌سازد."],[699,"بحر را پوشید و کف کرد آشکار","باد را پوشید و بنمودت غبار","دریا را پنهان کرد و به‌طور واضح کف آن را نشان داد، باد را هم پنهان کرد و گرد و غبار آن را نمایان ساخت."],[699,"چون مناره خاک پیچان در هوا","خاک از خود چون برآید بر علا","چون مناره‌ای از خاک که در هوا می‌چرخد، خاک از خود چیزی ندارد و تنها به بروز و ظهور می‌رسد."],[699,"خاک را بینی به بالا ای علیل","باد را نی جز به تعریف دلیل","اگر خاکی را به سمت بالا می‌بینی، ای کسی که بیمار هستی، بدان که باد تنها از روی تعریف و نشانه‌ای می‌تواند وجود داشته باشد و دلیل بر آن نیست."],[699,"کف همی‌بینی روانه هر طرف","کف بی‌دریا ندارد منصرف","تو فقط کف را می‌بینی که به هر سو روان است، اما بدان که این کف بدون دریا هیچ معنی و اصالت ندارد و خود به خود وجودی ندارد."],[699,"کف به حس بینی و دریا از دلیل","فکر پنهان آشکارا قال و قیل","تو فقط با حواست کف دریا را می‌بینی، اما دریا (ذات و حقیقت) در دل دلیل و تفکر پنهان است و فقط در گفت‌وگو (قال و قیل) معلوم می‌شود."],[699,"نفی را اثبات می‌پنداشتیم","دیده معدوم‌بینی داشتیم","ما چیزهایی را که وجود نداشتند، به اشتباه وجودشان را تأیید می‌کردیم، چون دیدگاه‌مان بر پایه عدم آگاهی بنا شده بود."],[699,"دیده‌ای که اندر نعاسی شد پدید","کی تواند جز خیال و نیست دید","چشمی که در خواب و غفلت (نعاس) مشغول است، نمی‌تواند چیزی جز تصورات و خیالات را ببیند."],[699,"لاجرم سرگشته گشتیم از ضلال","چون حقیقت شد نهان پیدا خیال","بنابراین، ما از سردرگمی و گمراهی رنج می‌بریم، زیرا وقتی حقیقت پوشیده و پنهان شد، خیال و تصورات نادرست برای ما روشن و آشکار گردید."],[699,"این عدم را چون نشاند اندر نظر","چون نهان کرد آن حقیقت از بصر","این عدم را وقتی در نظر انسان می‌آورند، چون حقیقت از دید پنهان می‌شود."],[699,"آفرین ای اوستاد سحرباف","که نمودی معرضان را درد صاف","ای استاد سحرباف، تو که باعث شدی تا انسان‌ها در مقابل حقایق، به حقیقتی روشن و بدون آلودگی پی ببرند، سزاوار ستایش هستی."],[699,"ساحران مهتاب پیمایند زود","پیش بازرگان و زر گیرند سود","ساحران که ماه را مانند ابزار خود می‌پندارند، به سرعت نزد بازرگانان می‌روند و از آن‌ها خرید و فروش می‌کنند تا سودی به دست بیاورند."],[699,"سیم بربایند زین گون پیچ پیچ","سیم از کف رفته و کرباس هیچ","سحرگران مانند جادوگران هستند که سیم را به‌طور مداوم می‌ربایند، اما در واقع سیمی که از دست رفته است، هیچ ارزش و اعتباری ندارد."],[699,"این جهان جادوست ما آن تاجریم","که ازو مهتاب پیموده خریم","این دنیا مانند جادو است و ما تاجرانیم که از آن، چهره ماه را می‌شنویم و می‌فروشیم."],[699,"گز کند کرباس پانصد گز شتاب","ساحرانه او ز نور ماهتاب","ساحر به طرز شگفت‌انگیزی کرباسی به طول پانصد گز می‌سازد که درخشندگی آن از نور ماهتاب ناشی می‌شود."],[699,"چون ستد او سیم عمرت ای رهی","سیم شد کرباس نی کیسه تهی","وقتی که او (ساحر) عمر تو را می‌گیرد، ای رهی، مانند کرباسی می‌شود که بی‌ارزش و تهی است، چون فقط یک کیسه (حالت سفید) از آن باقی نمانده است."],[699,"قل اعوذت خواند باید کای احد","هین ز نفاثات افغان وز عقد","باید به خدای یگانه پناه برد و از شر نفث‌ها و جادوها که تهدیدکننده هستند، درخواست کمک کرد."],[699,"می‌دمند اندر گره آن ساحرات","الغیاث المستغاث از برد و مات","ساحران در اینجا در حال دمیدن و جادوگری‌اند و این عمل آن‌ها باعث می‌شود که در زندگی انسان‌ها گره‌افکنی و مشکلات ایجاد شود. واژه «الغیاث» به معنای فریاد طلب کمک است و در اینجا به این معنا اشاره دارد که مردم از این مشکلات به فریاد آمده و استغاثه می‌کنند."],[699,"لیک بر خوان از زبان فعل نیز","که زبان قول سستست ای عزیز","اما در اینجا به تأثیر زبان اشاره می‌کند که بیان کنایه‌دار و نامطمئن است و در حقیقت، بر تصمیمات عملی و واقعی تأثیر نمی‌گذارد. این تأکید بر آن است که حرف زدن گاهی نمی‌تواند به اندازه عمل مؤثر باشد."],[699,"در زمانه مر ترا سه همره‌اند","آن یکی وافی و این دو غدرمند","در این زمان، سه یار همراه تو هستند: یکی از آن‌ها وفادار و درستکار است و دو نفر دیگر خیانتکار و ناپایدار."],[699,"آن یکی یاران و دیگر رخت و مال","وآن سوم وافیست و آن حسن الفعال","در این بیت، مولانا به سه نوع همراه اشاره می‌کند: یکی دوستان واقعی و صمیمی (یاران)، دیگری مایملک و ثروت (رخت و مال) که در نهایت بی‌فایده‌اند و سومین مورد، خداوند یا حقیقتی است که همیشه وجود دارد و بخشنده و نیکوکار است (وافی و حسن الفعال)."],[699,"مال ناید با تو بیرون از قصور","یار آید لیک آید تا به گور","مال با تو از این قصر (دنیا) خارج نمی‌شود و تنها یارت (دوستت یا هر کسی که به او وابسته‌ای) می‌آید، اما او فقط تا سر قبر همراه تو خواهد بود."],[699,"چون ترا روز اجل آید به پیش","یار گوید از زبان حال خویش","زمانی که روز مرگ تو فرا برسد، یار (دوست یا محبوب) خواهد گفت، به نمایندگی از حالت درونی‌ات."],[699,"تا بدینجا بیش همره نیستم","بر سر گورت زمانی بیستم","من تا اینجا (به زندگی) همراه تو هستم، اما وقتی به سر قبر تو برسم، برای همیشه خواهم ماند."],[699,"فعل تو وافیست زو کن ملتحد","که در آید با تو در قعر لحد","کار تو به حد کمال است، بنابراین بر خود لازم است که کناره‌گیری کنی تا کسی که به راستی شایسته است، در عمق قبرت با تو بیاید."],[700,"پس پیمبر گفت بهر این طریق","باوفاتر از عمل نبود رفیق","پس پیامبر گفت: برای این منظور، از عمل انسان وفادارتر و رفیق‌تر نیست."],[700,"گر بود نیکو ابد یارت شود","ور بود بد در لحد مارت شود","اگر دوست تو در زندگی نیکو باشد، همیشه یار تو خواهد بود، و اگر او بد باشد، در آخرت تو را به دوزخ خواهد برد."],[700,"این عمل وین کسب در راه سداد","کی توان کرد ای پدر بی‌اوستاد","بدون راهنمایی و استاد، انجام دادن عمل نیک و کسب فضایل در مسیر درست امکان‌پذیر نیست، بنابراین ای پدر، چگونه می‌توانیم این کارها را انجام دهیم؟"],[700,"دون‌ترین کسبی که در عالم رود","هیچ بی‌ارشاد استادی بود","پست‌ترین و بی‌ارزش‌ترین دانشی که در دنیا تحصیل می‌شود، بدون راهنمایی استاد هیچ ارزشی ندارد."],[700,"اولش علمست آنگاهی عمل","تا دهد بر بعد مهلت یا اجل","علم در آغاز است و سپس عمل؛ یعنی دانش اول باید به عمل درآید تا در زمان مهلت یا اجل، پاداشی حاصل گردد."],[700,"استعینوا فی‌الحرف یا ذا النهی","من کریم صالح من اهلها","ای کسانی که به علم و هنر نیاز دارید، از فردی نیکو و نیکوکار از اهل هنر کمک بگیرید."],[700,"اطلب الدر اخی وسط الصدف","واطلب الفن من ارباب الحرف","خواهرم، در جستجوی در (جواهر) و ارزش‌های گرانبها از درون صدف (جنس) باش و برای آموختن هنر و مهارت، به اهل فن و کسانی که در این زمینه تخصص دارند، مراجعه کن."],[700,"ان رایتم ناصحین انصفوا","بادروا التعلیم لا تستنکفوا","اگر ناصحانی (مشاورانی) را دیدید، انصاف را رعایت کنید و به یادگیری و آموزش بشتابید و از آن دریغ نکنید."],[700,"در دباغی گر خلق پوشید مرد","خواجگی خواجه را آن کم نکرد","اگر مردی در کار دباغی (چرم‌سازی) لباس نیکو بپوشد، این باعث نمی‌شود که جایگاه و مقام او (خواجگی) کم شود."],[700,"وقت دم آهنگر ار پوشید دلق","احتشام او نشد کم پیش خلق","زمانی که آهنگر در موقع دم، لباس پذیرایی و تشریفات به تن می‌کند، این باعث نمی‌شود که او در نظر مردم کم‌ارزش‌تر به نظر برسد."],[700,"پس لباس کبر بیرون کن ز تن","ملبس ذل پوش در آموختن","برای یادگیری و علم‌آموزی، لازم است که لباس خودخواهی و تکبر را کنار بگذاری و با فروتنی و ذلت به آموزش بپردازی."],[700,"علم آموزی طریقش قولی است","حرفت آموزی طریقش فعلی است","آموختن علم با گفت و گو و نقل قول نیست، بلکه با عمل و اقدام به دست می‌آید."],[700,"فقر خواهی آن به صحبت قایمست","نه زبانت کار می‌آید نه دست","فقر خواهی (یعنی طلب فقر و زهد و ازدست‌دادن دنیای مادی) به هم‌نشینی و دوستی با اهل آن بستگی دارد و نه به گفتار (زبان) یا کار دستی (دست)."],[700,"دانش آن را ستاند جان ز جان","نه ز راه دفتر و نه از زبان","معرفت و آگاهی حقیقی را باید از خود جان و دل به دست آورد، نه از طریق کتاب‌ها و نه از طریق گفتار و زبان."],[700,"در دل سالک اگر هست آن رموز","رمزدانی نیست سالک را هنوز","اگر در دل سالک (جستجوگر راه حق) رموز و اسراری وجود داشته باشد، هنوز هم رمزگشایی این اسرار برای او ممکن نیست و به دانایی دست نیافته است."],[700,"تا دلش را شرح آن سازد ضیا","پس الم نشرح بفرماید خدا","دل سالک باید روشن شود تا خداوند هم او را از رازها آگاه کند و به او بصیرت ببخشد."],[700,"که درون سینه شرحت داده‌ایم","شرح اندر سینه‌ات بنهاده‌ایم","ما در دل تو آنچه را که لازم است شرح و توضیح داده‌ایم و این فهم و دانش را در درون خودت قرار داده‌ایم."],[700,"تو هنوز از خارج آن را طالبی","محلبی از دیگران چون حالبی","تو هنوز در جستجوی چیزی از بیرون هستی، به‌طوری‌که به امید گرفتن آن، مانند فردی که ظرفی را برای پر کردن از آب می‌آورد، به دیگران مراجعه می‌کنی."],[700,"چشمه شیرست در تو بی‌کنار","تو چرا می‌شیر جویی از تغار","در وجود تو چشمه‌ای از شیر و صفا هست که هیچ کناری ندارد، اما چرا همچنان به دنبالی و به دنبال کارهایی بی‌ارزش می‌گردی؟"],[700,"منفذی داری به بحر ای آبگیر","ننگ دار از آب جستن از غدیر","در تو منفذی به دریا وجود دارد، ای آبگیر! از اینکه از حوض غدیر آب بخوری شرمنده باش."],[700,"که الم نشرح نه شرحت هست باز","چون شدی تو شرح‌جو و کدیه‌ساز","تو هیچ وقت به شرح و توضیح نپرداخته‌ای، اما حالا که خود را در جستجوی معنای عمیق قرار داده‌ای و در تلاش برای فهم حقیقتی، به حقایق بیشتری دست پیدا می‌کنی."],[700,"در نگر در شرح دل در اندرون","تا نیاید طعنه لا تبصرون","به عمق دل خود بنگر و در آن کنکاش کن تا به تو طعنه نزنند که نمی‌بینی."],[701,"یک سپد پر نان ترا بر فرق سر","تو همی خواهی لب نان در به در","تو می‌خواهی نان زیادی را بر سر خود حمل کنی، اما در عوض تنها لب نان را از در خانه‌ای به در خانه‌ای دیگر می‌طلبی."],[701,"در سر خود پیچ هل خیره‌سری","رو در دل زن چرا بر هر دری","در دل خود، پیچیدگی و سردرگمی را احساس می‌کند و به خاطر نادانی‌اش به هر در و دیواری نگاه می‌کند، اما نمی‌داند که باید به درون خود نگاهی بیندازد."],[701,"تا بزانویی میان آب‌ جو","غافل از خود زین و آن تو آب‌جو","تو در میانه آب زلال و کنار آن، غافل از خودت هستی و به فکر مسائل دیگر. این غفلت تو سبب می‌شود که از حقیقت وجودت و جریان زندگی غافل شوی."],[701,"پیش آب و پس هم آب با مدد","چشمها را پیش سد و خلف سد","پیش رویت آب هست و پشت سرت هم پر از آب. آبی که هر لحظه اضافه می شود. ولی بخاطر اینکه از جلو از پشت سرت حجاب است تو ان اب را نمی بینی"],[701,"اسپ زیر ران و فارس اسپ‌جو","چیست این گفت اسپ لیکن اسپ کو","سوارکار که بر اسبی نشسته، می‌پرسد که اسب زیر ران او و فارس (ترکیه) چه موجودی است. او در پاسخ می‌گوید که این موجود همان اسب است، اما اسبی که او به دنبال آن است، چه مشخصاتی دارد؟"],[701,"هی نه اسپست این به زیر تو پدید","گفت آری لیک خود اسپی که دید","این بیت به این معناست که چیزی که به نظر می‌رسد فقط یک نشانه یا علامت است. در واقع، وقتی از یک سوارکار (اسپ سوار) صحبت می‌شود، باید به خود او (سوار) نیز توجه کرد. این به ارتباط بین ظاهر و باطن و درک عمیق‌تر از موضوع اشاره دارد."],[701,"مست آب و پیش روی اوست آن","اندر آب و بی‌خبر ز آب روان","مست (مخاطب) در حالتی است که در آب (عشق یا معرفت) غرق شده و در پیش رویش، (خودش) آب جاری را نمی‌بیند و از آن بی‌خبر است."],[701,"چون گهر در بحر گوید بحر کو","وآن خیال چون صدف دیوار او","اگر مروارید (گهر) در دریا از دریا بپرسد که کجاست، در حالی که آن خیال (فکر یا تجسم) همانند صدفی است که دیواری بین او و دریا ایجاد کرده، نمی‌تواند به دریا دسترسی پیدا کند."],[701,"گفتن آن کو حجابش می‌شود","ابر تاب آفتابش می‌شود","آن کس که حجابش را کنار بزند، مانند ابر، مانع تابش آفتابش می‌شود."],[701,"بند چشم اوست هم چشم بدش","عین رفع سد او گشته سدش","چشم او (شخصی که در شعر مطرح است) قفل یا مانع اوست و همزمان نگاه بد او نیز مانع برطرف شدن مشکلاتش شده است. به عبارت دیگر، خود او عامل ایجاد موانع برای دیدن حقیقت و رفع مشکلات است."],[701,"بند گوش او شده هم هوش او","هوش با حق دار ای مدهوش او","گوش او به‌گونه‌ای شده که هوش او نیز تحت‌تأثیر قرار گرفته است و این هوش به حق نزدیک شده است. ای کسی که حالتی از گیجی در تو وجود دارد، این حالت کمک به درک حق می‌کند."],[702,"هوش را توزیع کردی بر جهات","می‌نیرزد تره‌ای آن ترهات","اگر هوش و تمرکز خود را میان کارها و موضوعات مختلف تقسیم کنی، ارزش و میزان آن به اندازه چیزی بی‌اهمیت مانند تره (سبزی) نخواهد بود."],[702,"آب هش را می‌کشد هر بیخ خار","آب هوشت چون رسد سوی ثمار","آب هوشت مانند آبی است که به ریشه‌های خار می‌رسد، آن را از ساقه واری می‌کند، و در نتیجه نمی‌تواند به میوه‌ها برسد. بنابراین، اگر فکر و تمرکز تو تقسیم و پراکنده شود، نمی‌توانی به ثمرات خوبی دست یابی."],[702,"هین بزن آن شاخ بد را خو کنش","آب ده این شاخ خوش را نو کنش","باید آن شاخ بد را قطع کنی و آبی به ریشه شاخ خوب بدهی تا دوباره رشد کند."],[702,"هر دو سبزند این زمان آخر نگر","کین شود باطل از آن روید ثمر","در این زمان، هر دو درخت سبز هستند و ثمر می‌دهند، اما در نهایت، باطل از این دو می‌خیزد و می‌دانیم که ثمر حقیقی از آن درختی است که در مسیر درست قرار دارد."],[702,"آب باغ این را حلال آن را حرام","فرق را آخر ببینی والسلام","آب، یعنی نعمت و برکات خداوند، برای باغی که خوب و پرثمر است حلال است، ولی برای بته‌های خاردار و زشت، حرام است. در نهایت تو می‌توانی تفاوت میان این دو را ببینی و این نکته واضح است."],[702,"عدل چه بود آب ده اشجار را","ظلم چه بود آب دادن خار را","عدالت در اینجا این است که آب را به درختان بدهند تا رشد کنند، در حالی که ظلم یعنی آب دادن به خاری که ارزشی ندارد."],[702,"عدل وضع نعمتی در موضعش","نه بهر بیخی که باشد آبکش","عدالت یعنی دادن نعمت‌ها در جای مناسب خود، نه مانند بی‌خیالی که آب را به جاهای نامناسب و بی‌ثمر می‌پاشد."],[702,"ظلم چه بود وضع در ناموضعی","که نباشد جز بلا را منبعی","ظلم به معنای قرار دادن چیزی در مکان نادرست است، جایی که نتیجه‌ای جز بدبختی و درد و رنج نخواهد داشت."],[702,"نعمت حق را به جان و عقل ده","نه به طبع پر زحیر پر گره","نعمت‌های خدا را با جان و عقل خود درک کن، نه به طبیعتی که پر از مشکلات و گره‌هاست."],[702,"بار کن بیگار غم را بر تنت","بر دل و جان کم نه آن جان کندنت","غم و اندوه را بر دوش خود حمل کن، اما نه به حدی که به دل و جانت آسیب برساند؛ بلکه باید به گونه‌ای باشد که جانت را فرسوده نکند."],[702,"بر سر عیسی نهاده تنگ بار","خر سکیزه می‌زند در مرغزار","عیسی (حضرت عیسی علیه‌السلام) بر دوش خود بار سنگینی را گذاشته و در میانه باغی (مرغزار) در حال حرکت است. این تصویر نمادین نشان‌دهنده سنگینی بار مشکلات و غم‌هاست که بر روی عیسی است و حالت او را توصیف می‌کند."],[702,"سرمه را در گوش کردن شرط نیست","کار دل را جستن از تن شرط نیست","برای درک حقیقت و معنا، نیازی به استفاده از نمادها و ظواهر نیست. انسان باید احساسات و دل‌نگرانی‌های درونی خود را پیدا کند و بر روی آن‌ها کار کند، نه اینکه فقط به ظواهر توجه داشته باشد."],[702,"گر دلی رو ناز کن خواری مکش","ور تنی شکر منوش و زهر چش","اگر دلی را آسان بگیری و ناز کنی، باعث خواری و ننگ خودت نشو. و اگر بدنی را شیرین (و خوشگوار) به حساب بیاوری، زهر چشیدن از آن بهتر است."],[702,"زهر تن را نافعست و قند بد","تن همان بهتر که باشد بی‌مدد","زهر برای بدن فایده دارد و قند (شیرینی) بد برای بدن بهتر است که بدون کمک کسی باشد."],[702,"هیزم دوزخ تنست و کم کنش","ور بروید هیزمی رو بر کنش","آتش دوزخ تن، همانند هیزم است؛ اگر این هیزم کم شود، آتش رو به خاموشی می‌رود."],[702,"ورنه حمال حطب باشی حطب","در دو عالم هم‌چو جفت بولهب","اگر تو بار جمع‌آوری هیزم برای دوزخ باشی، هیزم در دو دنیا مانند جفت آتش (برای زبانه‌کشیدن آتش) است."],[702,"از حطب بشناس شاخ سدره را","گرچه هر دو سبز باشند ای فتی","از هیزم (حطب) می‌توان به شاخ سدره (درختی در عالم معنوی) پی برد، هرچند که هر دو سبز (زنده) به نظر می‌رسند، ای پسر."],[702,"اصل آن شاخست هفتم آسمان","اصل این شاخست از نار و دخان","این بیت به رابطه عمیق و اساسی میان عالم مادی و عالم معنوی اشاره دارد. در واقع، آنچه در عالم بالا و آسمان وجود دارد، ریشه‌اش در عالم مادی (شاخ سدره) و مواد و آتش (نار و دخان) است، به این معنا که تمام هستی و حقیقت در ارتباطی عمیق با یکدیگر قرار دارد."],[702,"هست مانندا به صورت پیش حس","که غلط‌بینست چشم و کیش حس","موجودات و پدیده‌ها مانند تصاویری هستند که فقط در برابر حس قرار می‌گیرند و چشمی که از حس استفاده می‌کند، درک نادرستی از آن‌ها دارد."],[702,"هست آن پیدا به پیش چشم دل","جهد کن سوی دل آ جهد المقل","آنچه که به روشنی در پیش چشمان دل وجود دارد، سعی کن به آن توجه کنی و به سمت دل خود زحمت بکش، نه به سمت ظواهر و اندیشه‌های کم‌ارزش."],[702,"ور نداری پا بجنبان خویش را","تا ببینی هر کم و هر بیش را","برای اینکه بتوانی هر چیزی را به‌خوبی ببینی، باید از جابه‌جایی و تحرک خود، که نوعی دقت و توجه است، صرف‌نظر نکنی. در واقع، اگر به خودت حرکت ندهی و در جای خود ثابت بمانی، قادر نخواهی بود همه چیز را به درستی درک کنی."],[703,"گر زلیخا بست درها هر طرف","یافت یوسف هم ز جنبش منصرف","اگرچه زلیخا تمام درها را بسته بود (اشاره به داستان یوسف و زلیخا) و یوسف را از فرار کردن ناامید دید"],[703,"باز شد قفل و در و شد ره پدید","چون توکل کرد یوسف برجهید","زمانی که یوسف به خدا توکل کرد، قفل درها باز شد و راهی برای او نمایان گردید."],[703,"گرچه رخنه نیست عالم را پدید","خیره یوسف‌وار می‌باید دوید","اگرچه در این عالم هیچ راهی برای پیشرفت و موفقیت وجود ندارد، اما باید مانند یوسف که به رغم همه موانع و مشکلات تلاش کرد، با شجاعت و امید به جلو حرکت کرد."],[703,"تا گشاید قفل و در پیدا شود","سوی بی‌جایی شما را جا شود","اگر در راه قدم بگذاری، درها به رویت باز می‌شود و در جایی که شایسته‌ات است قرار می‌گیری."],[703,"آمدی اندر جهان ای ممتحن","هیچ می‌بینی طریق آمدن","ای ممتحن (آزمایشگر)، تو در این جهان آمده‌ای، اما هیچ چیز از راهی که به اینجا آمده‌ای نمی‌بینی."],[703,"تو ز جایی آمدی وز موطنی","آمدن را راه دانی هیچ نی","تو از یک مکان خاص آمده‌ای و راهی که به آنجا می‌رسد را خوب می‌شناسی، اما در حقیقت هیچ اطلاعات یا دانشی درباره دیگر مکان‌ها و مسیرها نداری."],[703,"گر ندانی تا نگویی راه نیست","زین ره بی‌راهه ما را رفتنیست","اگر نمی‌دانی که چه بگویی، راهی وجود ندارد، اما از این مسیر بی‌راهه، ما باید برویم."],[703,"می‌روی در خواب شادان چپ و راست","هیچ دانی راه آن میدان کجاست","تو در خواب خوشی به چپ و راست می‌روی، اما نمی‌دانی که راه آن میدان (هدف و مقصد واقعی) کجا است."],[703,"تو ببند آن چشم و خود تسلیم کن","خویش را بینی در آن شهر کهن","اگر تو چشمان خود را ببندی و تسلیم شوی، می‌توانی در آن شهر قدیمی (شهر حقیقت یا آگاهی) خود را مشاهده کنی."],[703,"چشم چون بندی که صد چشم خمار","بند چشم تست این سو از غرار","چشم تو مانند چشمی است که به خاطر خواب و خواب‌آلودگی نمی‌تواند چیزها را درست ببیند. این نگاه تو به دنیا مانع از دیدن حقیقی زیبایی‌ها و حقیقت است."],[703,"چارچشمی تو ز عشق مشتری","بر امید مهتری و سروری","چشم‌های تو از عشق به معشوق به مانند چهار چشم پر از دید است و تو به امید برتری و مقام بالا به آن عشق ورزیده‌ای."],[703,"ور بخسپی مشتری بینی به خواب","چغد بد کی خواب بیند جز خراب","اگر در خواب مشتری را ببینی، بدین معناست که در خواب چیزهای بیهوده می‌بینی، زیرا خواب فقط از آن کسی است که خرابی در روحش وجود دارد."],[703,"مشتری خواهی بهر دم پیچ پیچ","تو چه داری که فروشی هیچ هیچ","اگر در زندگی‌ات به دنبال مشتریان و خواسته‌هایت باشی و از هر طرف به آن فکر کنی، باید بدانی که در واقع هیچ چیز قابل فروختن یا ارزشی نداری."],[703,"گر دلت را نان بدی یا چاشتی","از خریداران فراغت داشتی","اگر دل تو را با نیکی و مهربانی سیر کنند یا به تو محبت کنند، آن‌گاه می‌توانی از دغدغه‌های زندگی راحت شوی و به مسیری خوشایند بروی."],[704,"آن یکی می‌گفت من پیغامبرم","از همه پیغامبران فاضلترم","شخصی می‌گفت که من پیامبر هستم و از تمامی پیامبران دیگر برتر و با فضیلت‌ترم."],[704,"گردنش بستند و بردندش به شاه","کین همی گوید رسولم از اله","او را به خاطر ادعای پیامبری‌اش به پیش شاه بردند و در حالی که دست و پایش بسته بود، همچنان اصرار داشت که من فرستاده خدا هستم."],[704,"خلق بر وی جمع چون مور و ملخ","که چه مکرست و چه تزویر و چه فخ","مردم بر او جمع شده‌اند مانند گروهی از موریانه‌ها و ملخ‌ها، و در مورد او صحبت می‌کنند که چه نیرنگی دارد و چه فریب‌هایی می‌زند."],[704,"گر رسول آنست که آید از عدم","ما همه پیغامبریم و محتشم","اگر آن فرد پیامبر باشد که از هیچ (عدم) ظهور کند، پس همه ما نیز پیامبر هستیم و دارای عظمت و اهمیت."],[704,"ما از آنجا آمدیم اینجا غریب","تو چرا مخصوص باشی ای ادیب","ما از یک سرزمین غریب به اینجا آمده‌ایم، پس چرا ای عالم و ادیب، تنها تو باید ویژه و مورد توجه باشی؟"],[704,"نه شما چون طفل خفته آمدیت","بی‌خبر از راه وز منزل بدیت","شما مانند کودکانی خواب‌آلود آمده‌اید، بی‌خبر از مسیر و منزلی که باید به آن بروید."],[704,"از منازل خفته بگذشتید و مست","بی‌خبر از راه و از بالا و پست","شما از مراحل و حالاتی که به خواب رفته‌اند و در آنجا غافل و ناآگاه هستید، عبور کرده‌اید، در حالی که به صورت مست و بی‌خبر از حقیقت و تفاوت میان عالم بالا و پایین هستید."],[704,"ما به بیداری روان گشتیم و خوش","از ورای پنج و شش تا پنج و شش","ما با هوشیاری و آگاهی حرکت کردیم و از مرزهای محدودیت‌های ظاهری و زندگی روزمره فراتر رفتیم و به معانی بالاتر و عمیق‌تر دست یافتیم."],[704,"دیده منزلها ز اصل و از اساس","چون قلاووز آن خبیر و ره‌شناس","دیده طریقت را، که به ریشه و مبنای واقعیات می‌نگرد، مانند چشمی تیزبین و آگاه است که می‌تواند به عمق وجود و حقیقت‌ها پی ببرد."],[704,"شاه را گفتند اشکنجه‌ش بکن","تا نگوید جنس او هیچ این سخن","به پادشاه گفتند که او را شکنجه کنند تا از گفتن حقیقت و دعوی‌اش که از آن مهم‌تر است، باز بماند."],[704,"شاه دیدش بس نزار و بس ضعیف","که به یک سیلی بمیرد آن نحیف","شاه دید آن شخص بسیار ناتوان و ضعیف است به گونه‌ای که با یک سیلی می‌تواند جانش را از دست بدهد."],[704,"کی توان او را فشردن یا زدن","که چو شیشه گشته است او را بدن","چگونه می‌توان به او آسیب زد یا او را فشار داد، در حالی که بدنش مانند شیشه شکننده شده است؟"],[704,"لیک با او گویم از راه خوشی","که چرا داری تو لاف سر کشی","اما من از روی خوشی با او می‌گویم که چرا این گونه خود را بزرگ می‌کنی و ادعاهای بادکنکی و بی‌اساس می‌کنی."],[704,"که درشتی ناید اینجا هیچ کار","هم به نرمی سر کند از غار مار","در اینجا بیان می‌شود که در جایی که نرمی و لطافت وجود دارد، هیچ‌گونه خشونت و درشتی جایی ندارد و تمام امور به آرامی و محبت پیش می‌رود، مانند ماری که در غار خود به آرامی زندگی می‌کند."],[704,"مردمان را دور کرد از گرد وی","شه لطیفی بود و نرمی ورد وی","مردم به خاطر آن شخص از او دور شدند، زیرا او انسانی ظاهرا لطیف و نرم‌خو به نظر می‌رسید، اما در واقع کلامش ناپسند و بی‌محتوا بود."],[704,"پس نشاندش باز پرسیدش ز جا","که کجا داری معاش و ملتجی","سپس او را نشاندند و دوباره از او پرسیدند که کجا زندگی می‌کنی و از کجا تأمین معاش داری."],[704,"گفت ای شه هستم از دار السلام","آمده از ره درین دار الملام","او در پاسخ می‌گوید که ای پادشاه، من از دنیای آرامش و صلح (دار السلام) آمده‌ام و به این دنیای پر از سرزنش (دار الملام) وارد شده‌ام."],[704,"نه مرا خانه‌ست و نه یک همنشین","خانه کی کردست ماهی در زمین","من نه جایی برای زندگی دارم و نه دوستی که با او باشم، زیرا کسی که در زمین ماهی را در خانه بکند، کار عجیبی انجام داده است."],[704,"باز شه از روی لاغش گفت باز","که چه خوردی و چه داری چاشت‌ساز","شه دوباره از رفتار و حالت لاغر او سؤال کرد که چه چیزی خورده‌ای و چه چیزی داری که این‌گونه به حالت سرمست و شاداب آمده‌ای."],[704,"اشتهی داری چه خوردی بامداد","که چنین سرمستی و پر لاف و باد","می‌پرسند که صبحانه چه خورده‌ای که اینقدر سرمست و پر از حرف‌های بزرگ و بیهوده‌ای."],[704,"گفت اگر نانم بدی خشک و طری","کی کنیمی دعوی پیغامبری","او در پاسخ به پرسش درباره سرمستی‌اش می‌گوید که اگر نان خشک و بی‌طعم به او می‌دادند، هرگز ادعای پیغامبری نمی‌کرد. این بدان معناست که حال روحی و توانایی‌اش غیر از آنچه که به ظواهر می‌نماید، است و به نوعی نشان می‌دهد که ادعای او به دلیل حالت خاصش است."],[704,"دعوی پیغامبری با این گروه","هم‌چنان باشد که دل جستن ز کوه","دعوی پیامبری در این جمع نیز مانند تلاش برای یافتن دل و عقل از درون سنگ و کوه است. به این معنا که رسیدن به مقام پیامبری با این افراد غیر ممکن است، همان‌طور که نمی‌توان از سنگ و کوه عقل و دل به دست آورد."],[704,"کس ز کوه و سنگ عقل و دل نجست","فهم و ضبط نکته مشکل نجست","هیچ‌کس از کوه و سنگ، عقل و دل را نمی‌جوید و کسی هم درک و فهم نکات دشوار را نمی‌آموزد."],[704,"هر چه گویی باز گوید که همان","می‌کند افسوس چون مستهزیان","هر چه بگویی، او نیز مانند تو به تکرار آن می‌پردازد و متأسفانه مانند دیوانگان می‌شود که فقط به شوخی و مسخره‌بازی مشغولند."],[704,"از کجا این قوم و پیغام از کجا","از جمادی جان کرا باشد رجا","این قوم (پیامبران و کسانی که ادعای پیامبری دارند) از کجا آمده‌اند و پیام آن‌ها از کجا ناشی می‌شود؟ از حالت گیاهی و بی‌تحرک (جماد) چه کسی می‌تواند امیدی (رجا) به زندگی و جان واقعی داشته باشد؟"],[704,"گر تو پیغام زنی آری و زر","پیش تو بنهند جمله سیم و سر","اگر تو پیامی از جانب خداوند بفرستی و برایت طلا و نقره بیاورند، در این صورت همگی گنج‌های گرانبها و زیورآلات هستند."],[704,"که فلان جا شاهدی می‌خواندت","عاشق آمد بر تو او می‌داندت","اگر در جایی کسی تو را شاهدی می‌خواند، بدان که عاشق توست و او نسبت به تو آگاهی کامل دارد."],[704,"ور تو پیغام خدا آری چو شهد","که بیا سوی خدا ای نیک‌عهد","اگر تو رسالتی از سوی خداوند بیاوری مثل شهد شیرین، پس بیا به سوی خدا ای فرد نیکوپیمان."],[704,"از جهان مرگ سوی برگ رو","چون بقا ممکن بود فانی مشو","به سمت دنیای مرگ برو و از آن فاصله بگیر، چون اگر بقا ممکن باشد، نباید فانی شوی و از بین بروی."],[704,"قصد خون تو کنند و قصد سر","نه از برای حمیت دین و هنر","خطرهایی برای جان تو و به خطر انداختن سر تو وجود دارد، ولی این کارها به خاطر غیرت درباره دین و هنر نیست."],[705,"بلک از چفسیدگی در خان و مان","تلخشان آید شنیدن این بیان","ولی به خاطر چسبندگی و سختی زندگی تلخ آن‌ها، از شنیدن این کلام بیزارند."],[705,"خرقه‌ای بر ریش خر چفسید سخت","چونک خواهی بر کنی زو لخت لخت","خرقه‌ای که بر صورت و ریش الاغ چسبیده محکم است، زمانی که بخواهی آن را از او جدا کنی، به صورت قطعه‌قطعه از او جدا می‌شود."],[705,"جفته اندازد یقین آن خر ز درد","حبذا آن کس کزو پرهیز کرد","به طور قطع، آن خر (که استعاره از کسی است که دچار عشق شده است) به خاطر درد عشق از کسی که از او دوری می‌کند، می‌نالد و شکایت می‌کند. این بیت به پیامدهای عشق و جدایی اشاره دارد."],[705,"خاصه پنجه ریش و هر جا خرقه‌ای","بر سرش چفسیده در نم غرقه‌ای","کس‌هایی که ریش‌های پرپشت دارند و هر کجا که بر سرشان خرقه‌ای (پوشش درویشی) چسبیده، در واقع در حال غرق شدن در آبی سرد و بی‌حالی هستند. اشاره به این دارد که چنین افرادی به خاطر اعمال ناپسندشان دچار عذاب و زحمت شده‌اند."],[705,"خان و مان چون خرقه و این حرص‌ریش","حرص هر که بیش باشد ریش بیش","کسی که بیشترین حرص را به دنیا و مال و منال دارد، مانند کسی است که خرقه‌ای بر تن کرده و در سرش ریش بلندی دارد. در واقع، زندگی او و وابستگی‌اش به دنیا، مثل همان ریش و خرقه است که به ظاهر نشان‌دهنده دیانت است، اما باطنش چیزی جز حرص نیست."],[705,"خان و مان چغد ویرانست و بس","نشنود اوصاف بغداد و طبس","زندگی در خان و مان (محل زندگی) چغد (که به معنای پست و ویران است) و خراب است، و او (کسی که به آن اشاره دارد) هرگز اوصاف خوب بغداد و طبس (دو شهر با ویژگی‌های مثبت و زیبا) را نمی‌شنود."],[705,"گر بیاید باز سلطانی ز راه","صد خبر آرد بدین چغدان ز شاه","اگر سلطانی از راه بازگردد، به این چغدان (محل ویران) خبرهای زیادی از شاه خواهد آورد."],[705,"شرح دارالملک و باغستان و جو","پس برو افسوس دارد صد عدو","باید افسوس خورد که با وجود داشتن دارالملک (شهر پادشاهی)، باغستان (محل زیبای سرسبز) و آب زلال، دشمنان زیادی وجود دارند که موجب عداوت و جدایی می‌شوند."],[705,"که چه باز آورد افسانه کهن","کز گزاف و لاف می‌بافد سخن","چه چیزی داستان قدیمی را بازگو می‌کند که از روی بی‌اساسی و دروغ به هم می‌بافد و سخن می‌سازد؟"],[705,"کهنه ایشانند و پوسیده ابد","ورنه آن دم کهنه را نو می‌کند","این افراد همیشه درحال فرسایش و فساد هستند و اگر نه، در لحظه‌ای که دچار کهنگی می‌شوند، خدای بزرگ آن‌ها را تازه و جوان می‌سازد."],[705,"مردگان کهنه را جان می‌دهد","تاج عقل و نور ایمان می‌دهد","عقل و نور ایمان به مردگان کهنه حیات و زندگی می‌بخشد و آن‌ها را از حالت پوسیدگی و بی‌حالی درمی‌آورد."],[705,"دل مدزد از دلربای روح‌بخش","که سوارت می‌کند بر پشت رخش","دل را از کسی که روح را زنده می‌کند، نبر؛ زیرا او تو را بر پشت اسبش سوار می‌کند و به جایی می‌برد."],[705,"سر مدزد از سر فراز تاج‌ده","کو ز پای دل گشاید صد گره","از مقام والای تاج‌دار، دل را به سر نباز، زیرا این دل است که می‌تواند بسیاری از مشکلات را حل کند و گره‌ها را بگشاید."],[705,"با کی گویم در همه ده زنده کو","سوی آب زندگی پوینده کو","با چه کسی صحبت کنم که در این ده زندگی می‌کند و به دنبال آب حیات است؟"],[705,"تو به یک خواری گریزانی ز عشق","تو به جز نامی چه می‌دانی ز عشق","تو به خاطر یک ذلت و خوار شدن از عشق فاصله گرفته‌ای، و غیر از نامی که از عشق شنیده‌ای، هیچ چیز از آن نمی‌دانی."],[705,"عشق را صد ناز و استکبار هست","عشق با صد ناز می‌آید به دست","عشق دارای زیبایی‌ها و لطافت‌های زیادی است و با ناز و انحصار خاصی وارد دل‌ها می‌شود. عشق به خاطر زیبایی‌اش، اغلب با قدرت و احساسات قوی همراه است و به طریقی خاص خود را نشان می‌دهد."],[705,"عشق چون وافیست وافی می‌خرد","در حریف بی‌وفا می‌ننگرد","عشق وقتی که کامل و حقیقی است، به وفاداری اهمیت می‌دهد و به کسانی که بی‌وفا هستند توجهی ندارد."],[705,"چون درختست آدمی و بیخ عهد","بیخ را تیمار می‌باید به جهد","انسان مانند درختی است که باید بر ریشه‌اش (عهد و پیمان) مراقبت کند و برای از بین بردن مشکلات آن تلاش و کوشش نماید."],[705,"عهد فاسد بیخ پوسیده بود","وز ثمار و لطف ببریده بود","عهدی که فاسد شده، ریشه‌اش نیز در حال پوسیدگی است و از آن میوه و لطفی به دست نمی‌آید."],[705,"شاخ و برگ نخل گرچه سبز بود","با فساد بیخ سبزی نیست سود","شاخ و برگ نخل هرچند سبز و زیباست، اما به دلیل فساد ریشه‌اش، هیچ ثمری و سودی ندارد."],[705,"ور ندارد برگ سبز و بیخ هست","عاقبت بیرون کند صد برگ دست","هرچند درختی به ظاهری فاقد برگ سبز باشد، اما در نهایت ریشه و بنیادش باعث می‌شود که در آینده صد برگ جدید به بار آورد. این به این معناست که ریشه و اصل چیزها در ارزش‌گذاری مهم‌تر از ظاهر آن‌هاست."],[705,"تو مشو غره به علمش عهد جو","علم چون قشرست و عهدش مغز او","به علم ظاهری خود مغرور نشو، زیرا علم مانند پوست است و اصل و حقیقت آن درعمق و درونش نهفته است."],[706,"وافیان را چون ببینی کرده سود","تو چو شیطانی شوی آنجا حسود","وقتی افرادی که به درستی رفتار می‌کنند و به دیگران سود می‌رسانند را ببینی، حسادت بر تو چیره می‌شود و مثل شیطان در آنجا حسود و بدخواه می‌گردی."],[706,"هرکرا باشد مزاج و طبع سست","او نخواهد هیچ کس را تن‌درست","هر کس که طبع و شخصیتش ضعیف باشد، نمی‌تواند صحت و سلامت هیچ‌کس را ببیند."],[706,"گر نخواهی رشک ابلیسی بیا","از در دعوی به درگاه وفا","اگر نمی‌خواهی حسد ابلیس را تجربه کنی، برای رسیدن به وفا و صداقت، از ادعا و توهم خودت دست بردار و به درگاه حقیقت و وفا وارد شو."],[706,"چون وفاات نیست باری دم مزن","که سخن دعویست اغلب ما و من","وقتی که وفا و صداقت وجود ندارد، دیگر سخن گفتن درباره آن بیهوده است؛ زیرا بیشتر سخنان ما فقط ادعایی است و واقعیت ندارد."],[706,"این سخن در سینه دخل مغزهاست","در خموشی مغز جان را صد نماست","این گفتار در دل و فکر انسان‌ها جای دارد و در سکوت، جان را به صورت‌های مختلف نمایان می‌کند."],[706,"چون بیامد در زبان شد خرج مغز","خرج کم کن تا بماند مغز نغز","وقتی که حرف و کلام زیاد می‌شود، ارزش تفکر و اندیشه کم می‌شود. پس باید سخن را کم کنیم تا فکر و اندیشه ارزشمند باقی بماند."],[706,"مرد کم گوینده را فکرست زفت","قشر گفتن چون فزون شد مغز رفت","مردی که کم حرف می‌زند، اندیشه‌ای عمیق و پربار دارد، اما وقتی سخن بسیار می‌گوید، در حقیقت از عمق اندیشه‌اش کاسته می‌شود."],[706,"پوست افزون بود لاغر بود مغز","پوست لاغر شد چو کامل گشت و نغز","وقتی که پوست (یعنی ظاهر) زیاد می‌شود، مغز (یعنی محتوا و حقیقت) لاغر و ضعیف می‌شود. اما زمانی که چیزها به کمال می‌رسند و زیبا و با کیفیت می‌شوند، ظاهری که تنها پوست است به تنهایی ارزش چندانی ندارد."],[706,"بنگر این هر سه ز خامی رسته را","جوز را و لوز را و پسته را","نگاه کن به این سه مغز با کیفیت که از خامی و ناپختگی خارج شده‌اند: جوز (گردو)، لوز (بادام) و پسته. این ابیات به نیکی و پختگی اشاره دارند که از تجربیات و رشد به دست آمده است."],[706,"هر که او عصیان کند شیطان شود","که حسود دولت نیکان شود","هر کسی که به نافرمانی و گناه دست بزند، مانند شیطان می‌شود و از روی حسادت، مانع خیر و خوشبختی نیکوکاران می‌گردد."],[706,"چونک در عهد خدا کردی وفا","از کرم عهدت نگه دارد خدا","اگر در پیشگاه خداوند به تعهدات خود وفادار باشی، خداوند نیز با لطف و کرم، از عهد و پیمان تو حفاظت خواهد کرد."],[706,"از وفای حق تو بسته دیده‌ای","اذکروا اذکرکم نشنیده‌ای","وفای به حق و پایبندی به عهد الهی، سبب می‌شود که تو به نعمت‌های خداوند دست یابی؛ اما اگر به یاد او نباشی و نصایح و یادآوری‌های او را نشنیده بگیری، در واقع از خیر و برکات او محروم خواهی ماند."],[706,"گوش نه اوفوا به عهدی گوش‌دار","تا که اوفی عهدکم آید ز یار","به سخن کسی که به عهد و پیمان خود وفا نمی‌کند، نباید گوش داد. پس از آن، یار وفادار خواهد آمد که به عهد شما وفا می‌کند."],[706,"عهد و قرض ما چه باشد ای حزین","هم‌چو دانه خشک کشتن در زمین","عهد و قرض ما با یکدیگر چه ارزشی دارد، ای حزین؟ مثل دانه خشکی است که در زمین کاشته می‌شود و نتیجه‌ای نخواهد داد."],[706,"نه زمین را زان فروغ و لمتری","نه خداوند زمین را توانگری","زمین نه بر اثر نور و تابش آن، و نه به خاطر دارایی و توانگری صاحبش، ارزش می‌یابد."],[706,"جز اشارت که ازین می‌بایدم","که تو دادی اصل این را از عدم","جز اشاره‌ای که باید بگویم، این نتیجه را تو به من دادی و اصل این موضوع را از نبود به وجود آوردی."],[706,"خوردم و دانه بیاوردم نشان","که ازین نعمت به سوی ما کشان","من از نعمت و برکت برخوردار شدم و دانه‌ای را که شما برای کاشت آورده‌اید، از آن خود می‌دانم و به سوی ما می‌آورم."],[706,"پس دعای خشک هل ای نیک‌بخت","که فشاند دانه می‌خواهد درخت","پس دعای بی‌اثر و بی‌معنا، برای کسی که خوشبخت است، مانند دانه‌ای است که برای برآورده شدن خواسته‌ها و رشد درختی مورد نیاز است. به عبارتی، دعا باید همراه با عمل و تلاش باشد تا نتیجه‌ بخش باشد."],[706,"گر نداری دانه ایزد زان دعا","بخشدت نخلی که نعم ما سعی","اگر دانه‌ای از خدا نداشته باشی، دعایت به نتیجه نمی‌رسد و نمی‌توانی درختی که نعمت می‌آورد (و میوه‌ای می‌دهد) داشته باشی، حتی اگر تلاش کنی."],[706,"هم‌چو مریم درد بودش دانه نی","سبز کرد آن نخل را صاحب‌فنی","مثل مریم، که درد و رنج را متحمل شد، آن نخل نیز به لطف خداوند درختی بارور و سبز گشت و صاحب هنر و فنی شد."],[706,"زانک وافی بود آن خاتون راد","بی‌مرادش داد یزدان صد مراد","بر اساس وفاداری و دیانت آن زن راد، خداوند به او صد خواسته‌اش را عطا کرد."],[706,"آن جماعت را که وافی بوده‌اند","بر همه اصنافشان افزوده‌اند","آن گروهی که در وفای به عهد و صداقت شهرت دارند، بر تمام افراد دیگر از هر دسته‌ای برتری یافته و مقامشان ارتقا یافته است."],[706,"گشت دریاها مسخرشان و کوه","چار عنصر نیز بنده آن گروه","دریاها تحت تسلط این افراد قرار گرفته و کوه‌ها نیز به تابعیت آن گروه درآمده‌اند."],[706,"این خود اکرامیست از بهر نشان","تا ببینند اهل انکار آن عیان","این نشان دادن این کرامت‌ها به اهل انکار، خود نوعی احترام و کریم بودن است تا آنها هم این حقیقت را ببینند."],[706,"آن کرامتهای پنهانشان که آن","در نیاید در حواس و در بیان","آن کرامت‌ها و فضایل پنهانی که به چشم نمی‌آید و نمی‌توان درباره‌شان صحبت کرد."],[706,"کار آن دارد خود آن باشد ابد","دایما نه منقطع نه مسترد","کار آن کس که همیشه در کارهای بد است، به‌صورت مداوم و بدون توقف ادامه دارد و هرگز از آن باز نخواهند داشت."],[707,"ای دهنده قوت و تمکین و ثبات","خلق را زین بی‌ثباتی ده نجات","ای خدایی که قوت و قدرت و ثبات را به مخلوقات می‌دهی، از این بی‌ثباتی که در زندگی وجود دارد، به آن‌ها نجات بده."],[707,"اندر آن کاری که ثابت بودنیست","قایمی ده نفس را که منثنیست","در کاری که ثبات و دوام ندارد، به نفس انسان استقامت و پایداری عطا کن، که نفس به خاطر ناپایداری‌اش مدام در تغییر و نوسان است."],[707,"صبرشان بخش و کفه میزان گران","وا رهانشان از فن صورتگران","خداوند در اینجا از تو می‌خواهد که به صابران کمکی کنی و قدرت و استقامت آن‌ها را افزایش دهی. همچنین آن‌ها را از دست افرادی که فقط به ظواهر می‌پردازند، آزاد کن."],[707,"وز حسودی بازشان خر ای کریم","تا نباشند از حسد دیو رجیم","ای خداوند بزرگوار، از حسادت و کینه‌توزی، آنها را دور کن تا به خاطر حسد، مانند دیوان پست و خبیث نشوند."],[707,"در نعیم فانی مال و جسد","چون همی‌سوزند عامه از حسد","در نعیم و خوشی‌های دنیوی، مال و جسم انسان‌ها زودگذر و فانی هستند و مردم به خاطر حسادت، همدیگر را می‌سوزانند و رنج می‌دهند."],[707,"پادشاهان بین که لشکر می‌کشند","از حسد خویشان خود را می‌کشند","پادشاهان را ببین که به خاطر حسدی که به خویشاوندان خود دارند، لشکرکشی می‌کنند و در این جنگ‌ها افراد خود را می‌کشند."],[707,"عاشقان لعبتان پر قذر","کرده قصد خون و جان همدگر","عاشقان چنان به عشق خود سرگرم شده‌اند که به خون و جان یکدیگر قصد می‌کنند، مانند بازیگران که در بازی‌های خود به شدت درگیر می‌شوند."],[707,"ویس و رامین خسرو و شیرین بخوان","که چه کردند از حسد آن ابلهان","ویس و رامین و خسرو و شیرین، داستان‌هایی هستند که نشان می‌دهند آن بی‌خبران (ابلهان) چه کارهایی از روی حسادت انجام دادند."],[707,"که فنا شد عاشق و معشوق نیز","هم نه چیزند و هواشان هم نه چیز","عاشق و معشوق به فنا می‌روند و در حقیقت دیگر وجودی ندارند، حتی آرزوها و تمایلات آنها نیز واقعی نیستند."],[707,"پاک الهی که عدم بر هم زند","مر عدم را بر عدم عاشق کند","خداوندی که وجودش هر چیزی را از عدم به وجود می‌آورد، می‌تواند عدم را به عشق تبدیل کند و عشق را میان عاشق و معشوق برقرار سازد."],[707,"در دل نه‌دل حسدها سر کند","نیست را هست این چنین مضطر کند","در دل کسانی که حسد می‌ورزند، آرامش وجود ندارد و این حسادت آن‌ها را به شدت مضطرب و نگران می‌کند؛ به طوری که آنچه در دست آن‌ها نیست، باعث رنجشان می‌شود."],[707,"این زنانی کز همه مشفق‌تراند","از حسد دو ضره خود را می‌خورند","این زنانی که از همه دلسوزتر و محبت‌مندتر هستند، به دلیل حسد، خود را به زحمت و آسیب می‌اندازند و از درون خود را می‌خورند."],[707,"تا که مردانی که خود سنگین‌دلند","از حسد تا در کدامین منزلند","مردانی که به خاطر حسد، قلب‌هایشان سنگین و سخت شده است، در کدام وضعیت و شرایط زندگی می‌کنند."],[707,"گر نکردی شرع افسونی لطیف","بر دریدی هر کسی جسم حریف","اگر قوانین شرع را به درستی رعایت نکنی، هر کسی را که در مقابل خود می‌بینی، مانند جسمی بی‌حالت و بی‌جان خواهی یافت."],[707,"شرع بهر دفع شر رایی زند","دیو را در شیشه حجت کند","شرع (قوانین و احکام دینی) برای جلوگیری از شر و بدی، دیو را در شیشه حجت (استدلال یا دلیل روشن) قرار می‌دهد، به این معنا که دیو را محدود و مهار می‌کند."],[707,"از گواه و از یمین و از نکول","تا به شیشه در رود دیو فضول","از گواه و سمت راست و از انکار، دیو فضول (بد) تا در شیشه (حجت) بیفتد و محبوس شود."],[707,"مثل میزانی که خشنودی دو ضد","جمع می‌آید یقین در هزل و جد","مانند ترازویی که خشنودی دو طرف مخالف را به همراه دارد، یقین به موضوعاتی که در آن هم شوخی وجود دارد و هم جدیت، به دست می‌آید."],[707,"شرع چون کیله و ترازو دان یقین","که بدو خصمان رهند از جنگ و کین","شرع مانند کفه ترازویی است که با آن دو دشمن (حق و باطل) از مبارزه و جنگ بر می‌خیزند و به حقیقتی دست می‌یابند."],[707,"گر ترازو نبود آن خصم از جدال","کی رهد از وهم حیف و احتیال","اگر ترازویی وجود نداشته باشد، آن خصم (یعنی نفس یا وسوسه‌های بد) از جدال و جنگ و درگیری رهایی نخواهد یافت و از فریب و نیرنگ نجات پیدا نمی‌کند."],[707,"پس درین مردار زشت بی‌وفا","این همه رشکست و خصمست و جفا","در این دنیای زشت و بی‌وفا، همه‌چیز پر از حسد، دشمنی و ظلم است."],[707,"پس در آن اقبال و دولت چون بود","چون شود جنی و انسی در حسد","در آن زمان که اقبال و سعادت به کسی روی آورد، انسان و جن چگونه در حسد و حسادت به یکدیگر دچار می‌شوند."],[707,"آن شیاطین خود حسود کهنه‌اند","یک زمان از ره‌زنی خالی نه‌اند","این شیاطین حسود همیشه نسبت به دیگران حسادت می‌ورزند و حتی یک لحظه هم از کارهای منفی خود دست نمی‌کشند."],[707,"وآن بنی آدم که عصیان کشته‌اند","از حسودی نیز شیطان گشته‌اند","بنی‌آدمی که به خاطر حسادت به گناه و عصیان دچار شده‌اند، خود نیز به شیطان تبدیل شده‌اند."],[707,"از نبی برخوان که شیطانان انس","گشته‌اند از مسخ حق با دیو جنس","از پیامبر بخوان که شیطان‌ها در قالب انسان ظاهر شده‌اند و به خاطر تغییر حقیقت، مانند دیوان شده‌اند."],[707,"دیو چون عاجز شود در افتتان","استعانت جوید او زین انسیان","زمانی که دیو (شیطان) در به دام انداختن انسان‌ها شکست می‌خورد و ناتوان می‌شود، به این انسان‌ها به عنوان یاری‌کننده رجوع می‌کند و از آنها کمک می‌طلبد."],[707,"که شما یارید با ما یاریی","جانب مایید جانب داریی","شما در کنار ما هستید و به ما کمک می‌کنید، و در حمایت از ما قرار دارید."],[707,"گر کسی را ره زنند اندر جهان","هر دو گون شیطان بر آید شادمان","اگر کسی را در زندگی دچار مشکل یا آسیب کنند، هر دو نوع شیطان (شیطان درونی و بیرونی) خوشحال می‌شوند."],[707,"ور کسی جان برد و شد در دین بلند","نوحه می‌دارند آن دو رشک‌مند","اگر کسی با روحی بزرگ و در مقام عالی به دین و ایمان رسید، آن دو دشمن حسود به خاطر رشک و حسادت، برای او گریه و نوحه‌گری می‌کنند."],[707,"هر دو می‌خایند دندان حسد","بر کسی که داد ادیب او را خرد","این بیت به این معناست که هر دو حسود (دو رشک‌مند) به کسی که مورد تأیید ادیب (معلم) قرار گرفته و خرد و دانش او را تأیید کرده است، حسد می‌ورزند و از آن ناراحت هستند."],[708,"شاه پرسیدش که باری وحی چیست","یا چه حاصل دارد آن کس کو نبیست","شاه از مدعی نبوت می‌پرسد که وحی چیست و یا چه فایده‌ای دارد برای کسی که پیامبر است."],[708,"گفت خود آن چیست کش حاصل نشد","یا چه دولت ماند کو واصل نشد","او می‌پرسد که معنی آن نبی چیست که حاصل و نتیجه‌ای ندارد، یا چه ثروتی می‌ماند برای کسی که به او نمی‌رسد."],[708,"گیرم این وحی نبی گنجور نیست","هم کم از وحی دل زنبور نیست","اگرچه این وحی که به نبی رسیده ارزش و گنجی ندارد، اما چیزی از وحی دل زنبور که به کندو می‌رسد، کم نیست."],[708,"چونک او حی الرب الی النحل آمدست","خانه وحیش پر از حلوا شدست","وقتی که وحی خدا به روح زنبورها نازل شده، خانه وحی او پر از شیرینی و خوشی شده است."],[708,"او به نور وحی حق عزوجل","کرد عالم را پر از شمع و عسل","خداوند با نور وحی، دانش و آگاهی را در عالم گستراند و آن را سرشار از شمع (نور) و عسل (طعم شیرین) کرد."],[708,"این که کرمناست و بالا می‌رود","وحیش از زنبور کمتر کی بود","کرم که به معنای کرم و لطف است، به خاطر زنبور عسل و به خاطر تولید عسل و همچنین بالا رفتن از درختان و شکوفه‌ها شهرت دارد. در اینجا اشاره می‌شود که مقام و نعمت‌های رسولان و هدایت‌کنندگان الهی به مراتب بالاتر از زنبور عسل است، زیرا زنبور تنها عسل می‌سازد و نمی‌تواند هدایت کند."],[708,"نه تو اعطیناک کوثر خوانده‌ای","پس چرا خشکی و تشنه مانده‌ای","تو به ما وعده کوثر (نهر بهشتی) را داده‌ای، پس چرا هنوز در عطش و کم‌آبی مانده‌ای؟"],[708,"یا مگر فرعونی و کوثر چو نیل","بر تو خون گشتست و ناخوش ای علیل","شاید تو مانند فرعون هستی؛ در این صورت، کوثر (نهر بهشت) که باید مانند نیل برای تو خوشایند باشد، به خاطر گناهانت تبدیل به خون شده و این موضوع برای تو آزاردهنده است. ای بیمار، این وضعیت نشان‌دهنده حال نامناسب توست."],[708,"توبه کن بیزار شو از هر عدو","کو ندارد آب کوثر در کدو","توبه کن و از هر دشمنی که هیچ بهره‌ای از رحمت و برکت الهی (که به کوثر تشبیه شده) ندارد، دوری کن."],[708,"هر کرا دیدی ز کوثر سرخ‌رو","او محمدخوست با او گیر خو","هر کسی را که دیدی با چهره‌ای بشاش و خوش‌رنگ که نشانگر زلالی و پاکی است، او به نبی محمد (ص) تعلق دارد و باید با او رفتار خوبی داشته باشی."],[708,"تا احب لله آیی در حسیب","کز درخت احمدی با اوست سیب","برای اینکه به مقام دوست در نزد خدا (حسیب) نزدیک شوی، باید از درخت پیامبر (احمد) سیب بچینی. این سیب نمادی از برکت و فیض اوست."],[708,"هر کرا دیدی ز کوثر خشک لب","دشمنش می‌دار هم‌چون مرگ و تب","هر کسی را که دیدی که از کوثر، یعنی نعمت و برکت الهی، بی‌بهره و خشک است، باید او را مانند دشمن خود بدانی؛ زیرا او به شدت ناپسند و خطرناک است، همان‌طور که مرگ و تب است."],[708,"گرچه بابای توست و مام تو","کو حقیقت هست خون‌آشام تو","هرچند که پدرت و مادر تو به نظر می‌رسند، حقیقت این است که آنها به تو آسیب می‌زنند و موجب گرفتاری و سختی‌ات هستند."],[708,"از خلیل حق بیاموز این سیر","که شد او بیزار اول از پدر","از خلیل (ابراهیم) حق بیاموز که ابتدا از پدرش بیزار شد، یعنی باید در راه حق و حقیقت، حتی نسبت به نزدیک‌ترین افراد نیز از تعلقات و وابستگی‌ها فاصله گرفت."],[708,"تا که ابغض لله آیی پیش حق","تا نگیرد بر تو رشک عشق دق","تا زمانی که به خاطر خدا از چیزها بیزار نشوی و به حق نزدیک نشوی، عشق حقیقی به تو نمی‌رسد و حسادت عشق الهی بر تو سایه نمی‌افکند."],[708,"تا نخوانی لا و الا الله را","در نیابی منهج این راه را","تا زمانی که «لا اله الا الله» را از صمیم قلب نخوانی، راه این مسیری که باید بروی را نخواهی یافت."],[709,"آن یکی عاشق به پیش یار خود","می‌شمرد از خدمت و از کار خود","عاشق در نزد محبوب خود، خدمات و تلاش‌هایش را به یاد می‌آورد و برای او بازگو می‌کند."],[709,"کز برای تو چنین کردم چنان","تیرها خوردم درین رزم و سنان","من برای تو این‌همه زحمات و سختی‌ها را تحمل کردم و در این جنگ، تیرها و ضربه‌ها را بر بدن خود پذیرفتم."],[709,"مال رفت و زور رفت و نام رفت","بر من از عشقت بسی ناکام رفت","به خاطر عشق تو، ثروت و قدرت و اعتبارم از دست رفت و به شدت حسرت و ناکامی را متحمل شدم."],[709,"هیچ صبحم خفته یا خندان نیافت","هیچ شامم با سر و سامان نیافت","هیچ روزی نه به خواب رفته‌ام و نه از خوشحالی لبخند زده‌ام، و هیچ شبانی هم با آرامش و نظم سپری نکرده‌ام."],[709,"آنچ او نوشیده بود از تلخ و درد","او به تفصیلش یکایک می‌شمرد","آنچه او از تلخی‌ها و رنج‌ها تجربه کرده بود را با جزئیات و به طور مفصل برمی‌شمرد."],[709,"نه از برای منتی بل می‌نمود","بر درستی محبت صد شهود","او این کارها را نه به خاطر منت و پاداش، بلکه به‌منظور اثبات صداقت عشق و محبتش نشان می‌دهد و بر درستی آن تأکید می‌کند."],[709,"عاقلان را یک اشارت بس بود","عاشقان را تشنگی زان کی رود","عاقلان با یک اشاره و فهم مفاهیم اصلی می‌توانند متوجه شوند، اما عاشقان به خاطر عشق و علاقه‌شان دائما در جستجوی پاسخ و شناخت عمیق‌تری هستند."],[709,"می‌کند تکرار گفتن بی‌ملال","کی ز اشارت بس کند حوت از زلال","عاشق به‌طور مکرر و بی‌خستگی صحبت می‌کند تا یادآوری کند که فقط با یک اشاره از او، معشوق آگاه شود و او را از عمق محبت و تلاش‌هایش باخبر سازد. در اینجا اشاره به حوت (ماهی بزرگ) و زلال (آب زلال) نیز به نمادهای آبی و زندگی اشاره دارد که نشان‌دهنده‌ی رهایی در عشق است."],[709,"صد سخن می‌گفت زان درد کهن","در شکایت که نگفتم یک سخن","عاشق از دردهای قدیمی و رنج‌های خود سخن می‌گوید و در حالی که بسیار صحبت می‌کند، در واقع می‌گوید که هیچ‌یک از آن‌ها را در شکایت کامل نکرده است."],[709,"آتشی بودش نمی‌دانست چیست","لیک چون شمع از تف آن می‌گریست","او آتش عشق را احساس می‌کرد، اما نمی‌دانست این حس چیست. با این حال، مانند شمعی نازک به خاطر شدت این احساس گریه می‌کرد."],[709,"گفت معشوق این همه کردی ولیک","گوش بگشا پهن و اندر یاب نیک","معشوق می‌گوید که تو این همه کارها را انجام داده‌ای، اما اکنون خوب گوش کن و دقیقا درک کن که حقیقت چیست."],[709,"کانچ اصل اصل عشقست و ولاست","آن نکردی اینچ کردی فرعهاست","عشق واقعی و بنیادین از ولایتی است که تو هنوز آن را نداشته‌ای و این کارهایی که کرده‌ای، تنها فرع و شاخه‌هایی از عشق هستند."],[709,"گفتش آن عاشق بگو که آن اصل چیست","گفت اصلش مردنست و نیستیست","عاشق از معشوق می‌پرسد که اصل عشق چیست. معشوق در جواب می‌گوید که اصل عشق، مرگ و ناپدید شدن از خود است."],[709,"تو همه کردی نمردی زنده‌ای","هین بمیر ار یار جان‌بازنده‌ای","عاشق، هر کاری که انجام داده، باعث نشده که از عشق و وصل معشوق مرده باشد و همچنان زنده است. پس به خاطر او باید مرد و خود را فدای او کرد، زیرا او یاری است که جان را زنده می‌کند."],[709,"هم در آن دم شد دراز و جان بداد","هم‌چو گل درباخت سر خندان و شاد","در آن لحظه، او نیز دچار حالت عجیبی شد و جان خود را باخت، مانند گلی که در سرما و تنهایی خود را به راحتی و شادابی تقدیم می‌کند."],[709,"ماند آن خنده برو وقف ابد","هم‌چو جان و عقل عارف بی‌کبد","آن خنده همچنان باقی می‌ماند و به نوعی جاودانه است، مانند جان و عقل عارفی که از قید جسم رها است و از هیچ نقصانی برخوردار نیست."],[709,"نور مه‌آلوده کی گردد ابد","گر زند آن نور بر هر نیک و بد","نور مه‌آلوده هرگز ابدی نمی‌شود، حتی اگر آن نور بر هر نیک و بدی بتابد."],[709,"او ز جمله پاک وا گردد به ماه","هم‌چو نور عقل و جان سوی اله","او به مانندی نور عقل و جان، از همه چیزهای ناپاک جدا می‌شود و به مانند ماه، به پاکی می‌رسد."],[709,"وصف پاکی وقف بر نور مه‌است","تابشش گر بر نجاسات ره‌است","پاکی و خلوص وقتی به نور می‌رسد، مانند نوری است که بر نجاسات می‌تابد؛ این نور نمی‌تواند بر چیزهای آلوده و ناپاک بیفکند و به آنها تأثیر بگذارد."],[709,"زان نجاسات ره و آلودگی","نور را حاصل نگردد بدرگی","از آلودگی‌ها و ناپاکی‌ها، نور شامل حال نمی‌شود و در حقیقت، نور نمی‌تواند از این نجاسات بهره‌ای ببرد."],[709,"ارجعی بشنود نور آفتاب","سوی اصل خویش باز آمد شتاب","نور آفتاب پس از مدتی به منبع و اصل خود برمی‌گردد و با شتاب به همان جا می‌رود."],[709,"نه ز گلخنها برو ننگی بماند","نه ز گلشنها برو رنگی بماند","نه از مکان‌های تنگ و کثیف عیبی باقی می‌ماند و نه از باغ‌ها و مکان‌های زیبا نشانه‌ای باقی خواهد ماند."],[709,"نور دیده و نوردیده بازگشت","ماند در سودای او صحرا و دشت","عاشق که در آرزوی معشوقش است، دوباره به عشق او بازگشته و بی‌تابی می‌کند، چه در دشت و چه در صحرا."],[710,"آن یکی پرسید از مفتی به راز","گر کسی گرید به نوحه در نماز","شخصی از عالم و عارف پرسید که اگر کسی در نماز گریه کند و به نوحه‌خوانی بپردازد، نماز او چه حکمی دارد."],[710,"آن نماز او عجب باطل شود","یا نمازش جایز و کامل بود","نماز کسی که در آن گریه و ناله می‌کند، ممکن است باطل شود یا ممکن است درست و کامل باشد، بسته به این‌که دلیل گریه‌اش چه باشد."],[710,"گفت آب دیده نامش بهر چیست","بنگری تا که چه دید او و گریست","گفتند که گریه انسان در نماز به چه معناست و دلیل آن چیست. باید توجه کرد که چرا او گریسته و چه چیزی را دیده که این‌گونه اشک می‌ریزد."],[710,"آب دیده تا چه دید او از نهان","تا بدان شد او ز چشمه خود روان","گریه او به خاطر چه چیزی است که باعث شده از چشمه چشمش آب بریزد، تا آنجا که به درد درون او پی بریم؟"],[710,"آن جهان گر دیده است آن پر نیاز","رونقی یابد ز نوحه آن نماز","اگر کسی در نمازش به خاطر مشاهده‌ی آن جهان پر نیاز و شگفت‌انگیز گریه کند، آن ندا و نوحه باعث رونق و پربار شدن نماز او خواهد شد."],[710,"ور ز رنج تن بد آن گریه و ز سوک","ریسمان بسکست و هم بشکست دوک","اگر کسی از رنج بدن و از سوختن دل به خاطر مشکلات زندگی بگرید و اشک بریزد، نمازش باطل می‌شود، زیرا اصل نماز ترک غم و رنج است."],[711,"یک مریدی اندر آمد پیش پیر","پیر اندر گریه بود و در نفیر","یک مرید نزد شیخی رفت که او در حال گریه کردن بود و در حالت زاری به سر می‌برد."],[711,"شیخ را چون دید گریان آن مرید","گشت گریان آب از چشمش دوید","مرید وقتی دید که شیخ در حال گریه است، او نیز تحت تأثیر قرار گرفته و گریه کرد و اشک از چشمانش سرازیر شد."],[711,"گوشور یک‌بار خندد کر دو بار","چونک لاغ املی کند یاری بیار","گوش‌خرگوش یک بار می‌خندد و اگر دوبار بخندد، بی‌معنی است و مانند اینکه امیدی ندارد. در واقع، این گفته نشان می‌دهد که برخی از مردم با توجه به نداشتن عقل و درک صحیح، فقط با تقلید و بدون فهم عمل می‌کنند."],[711,"بار اول از ره تقلید و سوم","که همی‌بیند که می‌خندند قوم","شخصی که فقط به خاطر تقلید از دیگران می‌خندد، نمی‌داند که چرا مردم می‌خندند و تنها به تقلید می‌پردازد. این نوع خندیدن واقعی نیست و به درک عمیق احساسات و معنی نمی‌رسد."],[711,"کر بخندد هم‌چو ایشان آن زمان","بیخبر از حالت خندندگان","او (مرید) نیز بدون آگاهی از حال آن خنده‌کنندگان، همانند آن‌ها می‌خندد."],[711,"باز وا پرسد که خنده بر چه بود","پس دوم کرت بخندد چون شنود","مریدی از شیخ می‌پرسد که دلیل خندیدن در چه بود، و بعد از اینکه شنید، دوباره می‌خندد مثل کر که نمی‌فهمد."],[711,"پس مقلد نیز مانند کرست","اندر آن شادی که او را در سرست","مقلد هم مانند کوچک‌کرهایی است که در شادی دیگران سهیم می‌شود و این شادی در دل او نیز وجود دارد."],[711,"پرتو شیخ آمد و منهل ز شیخ","فیض شادی نه از مریدان بل ز شیخ","نور و روشنی که از وجود شیخ ساطع می‌شود، منبع خوشحالی و خوشبختی است و این شادی فقط از شیخ ناشی می‌شود، نه از مریدان."],[711,"چون سبد در آب و نوری بر زجاج","گر ز خود دانند آن باشد خداج","اگر چراغی در آب باشد و باعث روشنایی بر شیشه شود، در واقع خود نور نیست، بلکه آنچه موجب نور می‌شود، از جایی دیگر آمده است. در اینجا اشاره به این است که اگر کسی تصور کند که نور و دانایی از خودش است، به اشتباه است و در حقیقت، همه‌چیز از خدا ناشی می‌شود."],[711,"چون جدا گردد ز جو داند عنود","که اندرو آن آب خوش از جوی بود","وقتی آب از جوی جدا می‌شود، می‌فهمد که آن آب خوش و زلال همان آب جوی بوده است. اینجا به مسأله‌ی درک و آگاهی اشاره دارد که انسان‌ها وقتی از چیزی دور می‌شوند، ارزش و زیبایی آن را بهتر درک می‌کنند."],[711,"آبگینه هم بداند از غروب","که آن لمع بود از مه تابان خوب","آبگینه که اشاره به ظرف شفاف دارد، می‌داند که در غروب، آن نور درخشان به خاطر ماه زیبای تابان است. به عبارتی، زیبایی و درخشندگی خاصی که در این زمان دیده می‌شود، به دلیل تابش ماه است."],[711,"چونک چشمش را گشاید امر قم","پس بخندد چون سحر بار دوم","وقتی چشمش را باز می‌کند، به او دستور می‌دهند که به طرف شهر قم برود و پس از آن، دوباره مانند سحر، می‌خندد."],[711,"خنده‌ش آید هم بر آن خنده خودش","که در آن تقلید بر می‌آمدش","او به خنده خود فکر می‌کند و حتی بر خنده خود می‌خندد؛ زیرا در آن لحظه‌ی خنده، تقلید و شباهتی وجود داشته است."],[711,"گوید از چندین ره دور و دراز","کین حقیقت بود و این اسرار و راز","می‌گوید که حقیقت از طریق مسیرهای طولانی و دشوار به دست می‌آید و این مسایل و اسرار عمیق نیز به همین صورت به دست می‌آیند."],[711,"من در آن وادی چگونه خود ز دور","شادیی می‌کردم از عمیا و شور","در آن محیط چگونه از دور شاد و خوشحال بودم، در حالی که خودم را در یک حالت ناآگاهی و بی‌خبری می‌دیدم."],[711,"من چه می‌بستم خیال و آن چه بود","درک سستم سست نقشی می‌نمود","من چه تصوری می‌ساختم و آنچه درک می‌کردم، واقعیتی سست و ناپایدار بود که مانند یک نقش بی‌ثبات به نظر می‌رسید."],[711,"طفل ره را فکرت مردان کجاست","کو خیال او و کو تحقیق راست","این بیت به این معناست که در راه زندگی و پیشرفت، اندیشه‌های بچه‌گونه و سطحی جایی ندارند. باید به فکر عمیق و واقعی مردان بزرگ بود و به دنبال حقیقت و تحقیق درست رفت."],[711,"فکر طفلان دایه باشد یا که شیر","یا مویز و جوز یا گریه و نفیر","فکر بچه‌ها به چیزهایی مانند دایه (پرستار)، شیر، مویز (نوعی خرما) یا جوز (گردو) و همچنین گریه کردن و سر و صدا مربوط می‌شود. یعنی ذهن کودکان به امور ساده و ابتدایی مشغول است و درکی عمیق‌تر از مسائل ندارد."],[711,"آن مقلد هست چون طفل علیل","گرچه دارد بحث باریک و دلیل","آن کسی که فقط تقلید می‌کند مانند یک کودک بیمار است، حتی اگر به ظاهری بحث و دلیل‌های پیچیده‌ای داشته باشد."],[711,"آن تعمق در دلیل و در شکیل","از بصیرت می‌کند او را گسیل","تعمق در وجود دلیل و شکل ظاهری به واسطه بصیرت (بینایی درونی) نیست که انسان را به سوی کمال و هدایت سوق می‌دهد، بلکه بصیرت خود منجر به هدایت و رهایی او می‌شود."],[711,"مایه‌ای کو سرمه سر ویست","برد و در اشکال گفتن کار بست","کسی که منبع و سرچشمه دانش و بینش است، از نظر فهم و بیان بسیار ماهر و موفق است و توانسته است به خوبی از احساسات و تجربیات خود سخن بگوید."],[711,"ای مقلد از بخارا باز گرد","رو به خواری تا شوی تو شیرمرد","ای پیروی که از بخارا آمده‌ای، به جای ادامه‌ی این مسیر در پی تقلید، به مقصد والا یعنی انسانیت و شجاعت واقعی برگرد و تلاش کن تا به مقام بزرگی و مردانگی دست پیدا کنی."],[711,"تا بخارای دگر بینی درون","صفدران در محفلش لا یفقهون","تا زمانی که به بخارای دیگری نرسیده‌ای، در محفل کسانی هستی که چیزی نمی‌فهمند و درک درستی از حقیقت و معرفت ندارند."],[711,"پیک اگرچه در زمین چابک‌تگیست","چون به دریا رفت بسکسته رگیست","پرنده، هرچند در زمین سریع و چابک است، اما وقتی به دریا می‌رسد، توانایی‌اش محدود می‌شود و دیگر نمی‌تواند پرواز کند."],[711,"او حملناهم بود فی‌البر و بس","آنک محمولست در بحر اوست کس","او کسی است که در زمین (مقصود در اموری عادی و انسانی) رنج و زحمت زیادی را تحمل کرده، اما وقتی به دریا (یعنی در مسیر معنوی و عمیق‌تر) می‌رسد، دیگر به هیچ چیز متکی نیست و هیچ کس او را نمی‌داند و او را نمی‌شناسد."],[711,"بخشش بسیار دارد شه بدو","ای شده در وهم و تصویری گرو","شاه (شه) بسیار بخشنده است، اما تو تنها در خیال و تصور خود به او گرفتار شده‌ای و واقعیّت او را نمی‌فهمی."],[711,"آن مرید ساده از تقلید نیز","گریه‌ای می‌کرد وفق آن عزیز","آن مرید بی‌خبر تنها به خاطر تقلید از شیخ و تحت تأثیر او گریه می‌کرد، بدون اینکه عمق احساسات او را درک کند."],[711,"او مقلدوار هم‌چون مرد کر","گریه می‌دید و ز موجب بی‌خبر","آن مرید، مانند فردی که ناشنواست، فقط به تقلید گریه می‌کرد و از علت واقعی آن بی‌خبر بود."],[711,"چون بسی بگریست خدمت کرد و رفت","از پیش آمد مرید خاص تفت","مرید معمولی که گریه کرد، پس از آنکه چند بار گریست، خدمت شیخ را ترک کرد و به سوی دیگری رفت، و سپس مرید خاص تفت (مریدی که به علم و حالات شیخ بیشتر واقف بود) وارد شد."],[711,"گفت ای گریان چو ابر بی‌خبر","بر وفاق گریه شیخ نظر","گفت: ای کسی که مثل ابر بی‌خبر گریه می‌کنی، به هماهنگی و هماهنگی گریه شیخ توجه کن."],[711,"الله‌الله، الله ای وافی‌مرید","گرچه در تقلید هستی مستفید","ای مرید کامل، تو هرچند در تقلید از دیگران بهره‌مند هستی، اما بایستی از یاد خدا و حقیقت آن غافل نشوی."],[711,"تا نگویی دیدم آن شه می‌گریست","من چو او بگریستم کـ‌آن منکریست","نباید بگویی که چون او می‌گریست، من نیز گریستم؛ زیرا این نشان‌دهنده‌ی نادانی است و تنها تقلید از دیگران محسوب می‌شود."],[711,"گریه‌ی پرجهل و پرتقلیدوظن","نیست هم‌چون گریه‌ی آن مؤتمن","گریه‌ای که از روی جهل و تقلید و تظاهر انجام می‌شود، ارزش و معنای خاصی ندارد و با گریه‌ی کسی که از روی معرفت و صداقت می‌گرید، قابل مقایسه نیست."],[711,"تو قیاس گریه بر گریه مساز","هست زین گریه، بدآن، راه دراز","گریه کردن را با گریه‌های دیگر مقایسه نکن، زیرا این گریه از دریای معرفت است و برای رسیدن به آن، راه طولانی و دشواری باید پیمود."],[711,"هست آن از بعد سی‌ساله جهاد","عقل آنجا هیچ نتواند فتاد","پس از سی سال تلاش و جهاد در راه کسب معرفت و عقل، انسان به آن مرحله‌ای نمی‌رسد که بتواند به سادگی به حقیقت‌ها نزدیک شود یا به آنجا وارد شود."],[711,"هست زان سوی خرد صد مرحله","عقل را واقف مدان زان قافله","از آن طرف خرد و عقل، مراحل و مراحل زیادی وجود دارد که نباید گمان کنی که فقط به خاطر این قافله (گروه) از آن آگاه هستی."],[711,"گریه او نه از غمست و نه از فرح","روح داند گریه عین الملح","گریه شیخ نه به خاطر غم و اندوه است و نه به خاطر شادی؛ روح او به خوبی می‌داند که این گریه، عین حقیقت و عمق وجود است."],[711,"گریه او خنده او آن سریست","زانچ وهم عقل باشد آن بریست","گریه و خنده او نشانه‌ای از راز و معنای عمیق درونش است، زیرا این احساسات ناشی از تفکر و عقل نیستند و از دایره فهم معمول فراترند."],[711,"آب دیده او چو دیده او بود","دیده نادیده دیده کی شود","گریه او مانند خود اوست و نمی‌توان از طریق عقل یا حواس به درک این گریه رسید. فقط کسانی که به حقیقت می‌رسند، می‌توانند معنای آن را دریابند."],[711,"آنچ او بیند نتان کردن مساس","نه از قیاس عقل و نه از راه حواس","آنچه او (شیخ) می‌بیند، قابل لمس و شناختن از طریق عقل یا حواس عادی نیست. یعنی آن تجربیات و بینش‌ها فراتر از محاسبات عقلانی و حواس ظاهری هستند."],[711,"شب گریزد چونک نور آید ز دور","پس چه داند ظلمت شب حال نور","شب از آمدن نور دور می‌گریزد، اما ظلمت شب نمی‌داند نور چه حسی دارد. این بیت به نادانی و بی‌خبری ظلمت در برابر نور اشاره دارد و نشان می‌دهد که برخی از واقعیت‌ها برای آن‌هایی که در تاریکی هستند، قابل درک نیست."],[711,"پشه بگریزد ز باد با دها","پس چه داند پشه ذوق بادها","پشه از وزش باد فرار می‌کند، اما چه می‌داند پشه که باد چه لذتی دارد؟"],[711,"چون قدیم آید حدث گردد عبث","پس کجا داند قدیمی را حدث","وقتی که چیز قدیمی و کهنه می‌آید و دچار تغییر می‌شود، بی‌فایده و بی‌معنی می‌شود، پس آن چیز قدیمی چگونه می‌تواند تغییر و دگرگونی را درک کند؟"],[711,"بر حدث چون زد قدم دنگش کند","چونک کردش نیست هم‌رنگش کند","وقتی که کسی به تازگی به مرحله‌ای از درک و معرفت برسد، ممکن است در اثر تأثیرات مختلف به سمت اشتباهاتی برود که به اعتبار و قدمت او لطمه بزند، چون هنوز بر اساس واقعیت و فهم خود به درستی عمل نکرده است."],[711,"گر بخواهی تو بیایی صد نظیر","لیک من پروا ندارم ای فقیر","هرچند تو می‌خواهی به من مانند دیگران بیایی و با من در ارتباط باشی، اما برای من اهمیتی ندارد که تو چه کسی هستی یا از کجا آمده‌ای، زیرا من به روش خودم ادامه می‌دهم و از حال تو بی‌توجه هستم."],[711,"این الم و حم این حروف","چون عصای موسی آمد در وقوف","این حروف، مانند عصای موسی، سبب توقف و ایستایی هستند و با ذکر آنها می‌توان به معانی عمیق و حکمت‌های بزرگ دست یافت."],[711,"حرفها ماند بدین حرف از برون","لیک باشد در صفات این زبون","الفاظ و کلمات ظاهرا بدون مفهوم از بیرون باقی می‌مانند، اما در واقع این ویژگی‌ها و صفات در دل آن‌ها نهفته است."],[711,"هر که گیرد او عصایی ز امتحان","کی بود چون آن عصا وقت بیان","هر کسی که در نشانه‌ای مانند عصا به آزمون دست پیدا کند، در مقام بیان حقایق و معانی، به اندازه آن عصا پایدار نخواهد بود."],[711,"عیسویست این دم نه هر باد و دمی","که برآید از فرح یا از غمی","این لحظه، حالتی عیسوی دارد و نه هر نسیم و نفسی که از شادی یا غم برخیزد. منظور این است که این حالت خاص، به قدری شریف و مقدس است که نمی‌توان آن را با احساسات معمولی زندگی مقایسه کرد."],[711,"این الم است و حم ای پدر","آمدست از حضرت مولی البشر","این صدا و ناله‌ای است که از جانب پدر عیسی، یعنی حضرت مریم، صادر می‌شود و این حالتی است که در برابر عظمت انسانی و الهی او ایجاد شده است. در واقع، این اشاره به موقعیتی معنوی و آرامش‌بخش دارد که انسان‌ها باید آن را درک کنند."],[711,"هر الف لامی چه می‌ماند بدین","گر تو جان داری بدین چشمش مبین","این بیت به این معناست که هر الف و لام (حروف) چه ارزشی دارد، اگر تو جان و روحی نداری. اگر تو حقیقت و عمق وجود را درک کنی، به ظاهر چیزها (چشم او) توجه نکن."],[711,"گرچه ترکیبش حروفست ای همام","می‌بماند هم به ترکیب عوام","هرچند که وجود انسان از حروف و عناصر تشکیل شده است، اما در حقیقت او از جنس عوام و مردم عادی نمی‌ماند و هنوز از خود چیزی فراتر دارد."],[711,"هست ترکیب محمد لحم و پوست","گرچه در ترکیب هر تن جنس اوست","ترکیب جسمانی پیامبر محمد شامل گوشت و پوست است، اما در واقع هر انسانی در ترکیب بدنی خود، از همان جنس و ماده است که او نیز تشکیل شده است."],[711,"گوشت دارد پوست دارد استخوان","هیچ این ترکیب را باشد همان","این بدن انسان دارای گوشت، پوست و استخوان است، اما در حقیقت، این ترکیب فقط نمایانگر خود انسان نیست."],[711,"که اندر آن ترکیب آمد معجزات","که همه ترکیبها گشتند مات","در این ترکیب (وجود انسان) معجزات و شگفتی‌هایی نهفته است که تمامی این ترکیب‌ها (یعنی اجزای مختلف انسان) به حیرت و شگفتی درآمده‌اند."],[711,"هم‌چنان ترکیب حم کتیب","هست بس بالا و دیگرها نشیب","ترکیب‌های مختلف از انسان‌ها و اجزای جهان به شکل‌های متفاوتی در زندگی ما وجود دارد؛ برخی از آن‌ها در بالا قرار دارند و برخی در پایین."],[711,"زانک زین ترکیب آید زندگی","هم‌چو نفخ صور در درماندگی","زیرا از این ترکیب و ترکیب‌های همچون آن، زندگی به‌وجود می‌آید، همان‌طور که دمیدن در صور در زمان درماندگی و بی‌حالی، ‌موجب زنده شدن و حیات می‌شود."],[711,"اژدها گردد شکافد بحر را","چون عصا حم از داد خدا","خداوند می‌تواند به قدری قدرت داشته باشد که همچون عصا، اژدهایی را بسازد که دریا را بشکافد و راهی به وجود آورد. این تصویر بیانگر عظمت و شکوه الهی است و به ما یادآوری می‌کند که قدرت خداوند فراتر از تصورات ماست."],[711,"ظاهرش ماند به ظاهرها ولیک","قرص نان از قرص مه دورست نیک","ظاهر انسان‌ها با یکدیگر شبیه است و همه به ظواهر توجه می‌کنند، اما در حقیقت و اصل، معنی و حقیقت زندگی بسیار فراتر از آن چیزی است که در نگاه اول دیده می‌شود و درک آن مانند تفاوت نان تازه با ماه است که به راحتی قابل تشخیص نیست."],[711,"گریه او خنده او نطق او","نیست از وی هست محض خلق هو","گریه و خوشحالی و سخن گفتن او به خاطر خودش نیست، بلکه فقط به خاطر حال دیگران و ارتباط با روحانیت و خلقت است."],[711,"چونک ظاهرها گرفتند احمقان","وآن دقایق شد ازیشان بس نهان","احمق‌ها فقط به ظواهر چیزها توجه کردند و عمق و نکات پنهان آن‌ها از دیدشان دور ماند."],[711,"لاجرم محجوب گشتند از غرض","که دقیقه فوت شد در معترض","بنابراین، به‌دلیل غفلت انسان‌ها از هدف اصلی، از حقیقت و عمق موضوعات دور مانده‌اند و از درک نکات ظریف بازمانده‌اند."],[712,"یک کنیزک یک خری بر خود فکند","از وفور شهوت و فرط گزند","یک کنیزک به دلیل شدت شهوت و آسیب زیاد، یک خر را بر روی خود انداخت."],[712,"آن خر نر را بگان خو کرده بود","خر جماع آدمی پی برده بود","آن خر نر به شیوه‌ای که مختص خود بود عادت کرده بود و حالا فهمیده بود که چگونه در عمل مردانانه به نزدیکی بپردازد."],[712,"یک کدویی بود حیلت‌سازه را","در نرش کردی پی اندازه را","در نر خر، یک کدو وجود داشت که به عنوان ترفند و مکر به کار رفته بود تا او را در اندازه‌ای معین نگه دارد."],[712,"در ذکر کردی کدو را آن عجوز","تا رود نیم ذکر وقت سپوز","آن پیرزن در آلت مردانه کدویی را گذاشت تا اندازه‌اش به نصف برسد و در زمان خاصی خواسته یا ناخواسته از آن رهایی یابد."],[712,"گر همه کیر خر اندر وی رود","آن رحم و آن روده‌ها ویران شود","اگر همه چیزی که در بدن خر وجود دارد به داخل او برود، رحم و روده‌های او خراب و ویرانه خواهد شد."],[712,"خر همی شد لاغر و خاتون او","مانده عاجز کز چه شد این خر چو مو","خر به تدریج لاغر می‌شود و خاتون (زنی که خر متعلق به اوست) متعجب و ناتوان است که این خر چرا مثل مو (یعنی بسیار لاغر و نحیف) شده است."],[712,"نعل‌بندان را نمود آن خر که چیست","علت او که نتیجه‌ش لاغریست","خر نشان می‌دهد به نعل‌بندی‌ها که دلیل لاغری او چیست."],[712,"هیچ علت اندرو ظاهر نشد","هیچ کس از سر او مخبر نشد","هیچ دلیل و نشانه‌ای از موضوعی که او در پی یافتن آن بود، نمایان نشد و هیچ‌کس هم از درون او و افکارش آگاهی پیدا نکرد."],[712,"در تفحص اندر افتاد او به جد","شد تفحص را دمادم مستعد","او در جست‌وجو و بررسی فرو رفت و به طور مداوم خود را برای این تلاش آماده می‌کرد."],[712,"جدّ را باید که جان بنده بود","زانک جد جوینده یابنده بود","باید به‌جد و با جدیت طلب و جستجو کرد، زیرا کسی که با سختی و جدیت دنبال چیزی برود، به آنچه می‌خواهد دست می‌یابد."],[712,"چون تفحص کرد از حال اشک","دید خفته زیر خر آن نرگسک","وقتی که (کتابی یا شخصی) در جستجوی حال و وضعیت نرگسک (دختر زیبا) تفحص کرد، متوجه شد که او زیر خر خوابیده است."],[712,"از شکاف در بدید آن حال را","بس عجب آمد از آن آن زال را","از شکاف در، حال آن دختر را مشاهده کرد و این وضعیت برای او بسیار عجیب و غریب بود. زال (پدر رستم، شخصیتی افسانه‌ای در ادبیات فارسی) به خاطر سن و سالی که دارد، نمی‌توانست چنین چیزهایی را بپذیرد."],[712,"خر همی‌گاید کنیزک را چنان","که به عقل و رسم مردان با زنان","این بیت می‌گوید که خر (حیوان) با کنیزک (دختر خدمتکار) به گونه‌ای رفتار می‌کند که مانند مردان عاقل و با فرهنگ با زنان برخورد می‌کنند."],[712,"در حسد شد گفت چون این ممکنست","پس من اولیتر که خر ملک منست","او (کنیزک) در حسد می‌گوید: اگر این کار با خر ممکن است، پس من که خر خودم را دارم سزاوارترم که بتوانم این کار را انجام دهم."],[712,"خر مهذّب گشته و آموخته","خوان نهاده‌ست و چراغ افروخته","خر تربیت شده و آموزش دیده، سفره‌ای آماده کرده و چراغی روشن کرده است."],[712,"کرد نادیده و در خانه بکوفت","کای کنیزک چند خواهی خانه روفت","او که به کنیزک خطاب می‌کند، از او می‌پرسد که چرا مدام در خانه به کارهای بیهوده می‌پردازد، در حالی که باید کارهای اصلی و مهم‌تری انجام دهد."],[712,"از پی روپوش می‌گفت این سخن","کای کنیزک آمدم در باز کن","او پس از اینکه به کنیزک نزدیک شد و در پنهان کرد، از او خواست که در را باز کند و خودش را معرفی کند."],[712,"کرد خاموش و کنیزک را نگفت","راز را از بهر طمع خود نهفت","او (کنیزک) به خاطر طمع خود راز را به کنیزک نگفت و خاموش ماند."],[712,"پس کنیزک جمله آلات فساد","کرد پنهان پیش شد در را گشاد","کنیزک همه ابزارهای فساد را به طور پنهانی آماده کرد و سپس در را باز کرد تا به کارهای خود ادامه دهد."],[712,"رو ترش کرد و دو دیده پر ز نم","لب فرو مالید یعنی صایمم","او با ناراحتی چهره‌اش را در هم کشید و چشمانش پر از اشک شد و لبش را به دندان گرفت تا نشان دهد که عمیقا غمگین و ناراحت است."],[712,"در کف او نرمه جاروبی که من","خانه را می‌روفتم بهر عطن","در دست او جاروئی نرم بود که من به خاطر تمیز کردن خانه از آن استفاده می‌کردم."],[712,"چونک با جاروب در را وا گشاد","گفت خاتون زیر لب کای اوستاد","وقتی که آن کنیزک در را با جاروب باز کرد، خاتون زیر لب گفت: «ای استاد»."],[712,"رو ترش کردی و جاروبی به کف","چیست آن خر برگسسته از علف","تو با چهره‌ای ترش و نارضایت به من نگاه می‌کنی، اما سوال این است که چرا آن خر که از خوردن علف سیر شده، همچنان تلو تلو می‌خورد؟"],[712,"نیمکاره و خشمگین جنبان ذکر","ز انتظار تو دو چشمش سوی در","مردی که هنوز کارش ناتمام و خشمگین است، در انتظار توست و آلت او مانند دو چشمش به سمت در خیره شده است."],[712,"زیر لب گفت این نهان کرد از کنیز","داشتش آن دم چو بی‌جرمان عزیز","او به آرامی می‌گوید که آن کنیز از او پنهان کرده بود و در وضعیتی که به نظر می‌رسید بی‌گناه و معصوم است، در واقع در دلش چیزهایی را مخفی کرده بود."],[712,"بعد از آن گفتش که چادر نه به سر","رو فلان خانه ز من پیغام بر","سپس به او گفت که چادر را به سر نگذارد و به خانه‌ای که اشاره کرد، پیغام بدهد."],[712,"این چنین گو وین چنین کن وآنچنان","مختصر کردم من افسانه زنان","این‌گونه بگو و این‌گونه عمل کن و داستان زنان را به‌اختصار برایت بیان کردم."],[712,"آنچ مقصودست مغز آن بگیر","چون به راهش کرد آن زال ستیر","مقصود اصلی را در باطن مطلب بیاب، چون آن زال ستیر (مردی که کنیزک را به شهوت می‌راند) او را به سوی خواسته‌اش هدایت کرد."],[712,"بود از مستی شهوت شادمان","در فرو بست و همی‌گفت آن زمان","این بیت به حالتی اشاره دارد که فرد به دلیل مستی و غرق شدن در شهوت، شاد و سرخوش است و در همان حال در دنیای خود غرق شده و به اطرافش بی‌توجه است. او در این حالت احساس کردن و درک واقعیت را فراموش کرده و از آنچه در اطرافش می‌گذرد بی‌خبر است."],[712,"یافتم خلوت زنم از شکر بانگ","رسته‌ام از چار دانگ و از دو دانگ","در خلوت زنانه، به خاطر خوشحالی و شکرگزاری به حالتی فرح‌بخش رسیده‌ام و از تمام محدودیت‌ها و موانع (چار دانگ و دو دانگ) رها شده‌ام."],[712,"از طرب گشته بزان زن هزار","در شرار شهوت خر بی‌قرار","از شادی و سرور ناشی از آن زن، هزار آتش در وجود خر برپا شده و او به شدت بی‌تاب و ناآرام است."],[712,"چه بزان کآن شهوت او را بز گرفت","بز گرفتن گیج را نبود شگفت","وقتی که آن شهوت، او را مانند بز گرفت و از خود بی‌خبرش کرد، نباید تعجب کرد که چنین حالتی برای آدمی به وجود آمده است."],[712,"میل شهوت کر کند دل را و کور","تا نماید خر چو یوسف نار نور","میل به شهوت، دل را می‌کند و انسان را کور می‌کند، به طوری که خر (نماد هوس و سرگشتگی) را همچون یوسف، به جای نور و روشنی، می‌بیند."],[712,"ای بسا سرمست نار و نارجو","خویشتن را نور مطلق داند او","بسیاری از کسانی که به لذت‌های دنیوی دل‌بسته‌اند، خود را به اشتباه نور مطلق یا حقیقت مطلق می‌دانند. آن‌ها در حالت سرمستی و غفلت، از واقعیت و حقیقت دور می‌شوند و گمان می‌کنند که به بالاترین مرتبه‌ی معرفت رسیده‌اند."],[712,"جز مگر بنده خدا یا جذب حق","با رهش آرد بگرداند ورق","تنها بنده‌ای از بندگان خدا یا کسی که به حق جذب شده باشد، می‌تواند با راه خود صفحه زندگی را به سمت تازه‌ای باز کند و آن را تغییر دهد."],[712,"تا بداند کآن خیال ناریه","در طریقت نیست الّا عاریه","او باید بداند که آن خیال دنیوی (خواب و آرزوهای وابسته به دنیا) در مسیر معرفت و طریقت وجود ندارد و تنها به شکل عاریه، یعنی به طور موقتی و غیرواقعی، نمایان می‌شود."],[712,"زشت‌ها را خوب بنماید شره","نیست چون شهوت بتر ز آفات ره","زشت‌ها را خوب جلوه دادن، نشان بی‌خالقی و بی‌خود بودن است؛ چرا که شهوت حتی خطرناک‌تر از آسیب‌ها و مشکلات مسیر زندگی است."],[712,"صد هزاران نام خوش را کرد ننگ","صد هزاران زیرکان را کرد دنگ","بسیاری از نام‌های زیبا را زشت و ناپسند جلوه داد و بسیاری از انسان‌های باهوش را به بی‌خودی و بی‌ارزشی کشاند."],[712,"چون خری را یوسف مصری نمود","یوسفی را چون نماید آن جهود","اگر یوسف مصری، که نماد زیبایی و پاکی است، بتواند خری را زیبا کند، پس آن جهود (یهودی) باید چطور کسی را که هیچ زیبایی ندارد، زیبا کند؟ در اینجا به تضاد زیبایی و زشتی اشاره شده است."],[712,"بر تو سرگین را فسونش شهد کرد","شهد را خود چون کند وقت نبرد","به خاطر فریب دادن دیگران، ظاهری شیرین و خوشایند به چیزی ناخوشایند (سرگین) داده‌ای. اما وقتی به حقیقت و واقعیت می‌رسیم، آن چیز خوشایند چگونه می‌تواند در هنگام مواجهه با سختی‌ها و چالش‌ها (نبرد) رفتار کند؟"],[712,"شهوت از خوردن بود کم کن ز خور","یا نکاحی کن گریزان شو ز شر","شهوت از خوردن به وجود می‌آید، بنابراین یا باید از طعام کم کنی یا از ازدواج دوری کنی و از شر آن بپرهیزی."],[712,"چون بخوردی می‌کشد سوی حرم","دخل را خرجی بباید لاجرم","هرگاه که انسان از لذایذ دنیوی بهره‌مند شود، او را به سوی خوشی‌ها و آرزوها می‌کشد، و در این میان، برای استفاده از این لذت‌ها، باید هزینه‌ای نیز بپردازد."],[712,"پس نکاح آمد چو لاحول و لا","تا که دیوت نفکند اندر بلا","پس ازدواج انجام شد، اما بدون اراده و اختیار، تا اینکه دیو (دشمن) تو را به مشکلات و calamity (بلا) نیندازد."],[712,"چون حریص خوردنی زن خواه زود","ورنه آمد گربه و دنبه ربود","اگر کسی با حرص به دنبال خوراک برود و زود تصمیم نگیرد، ممکن است فرصت را از دست بدهد و همانند گربه‌ای که دنبه را دزدیده، چیزی را که می‌خواهد از دست بدهد."],[712,"بار سنگی بر خری که می‌جهد","زود بر نه پیش از آن کو بر نهد","برای خر سنگینی می‌برند که به سرعت می‌جهد و این بار سنگین قبل از شروع جهش به آن گذاشته نمی‌شود. در واقع، اشاره به این است که برای کسی که در حال پیشرفت یا جهش است، نباید بار اضافی و سنگین گذاشت."],[712,"فعل آتش را نمی‌دانی تو برد","گرد آتش با چنین دانش مگرد","تو نمی‌دانی که آتش چه کار می‌کند، بنابراین با این دانش نادرستی که داری، به دور آتش نگرد."],[712,"علم دیگ و آتش ار نبود ترا","از شرر نه دیگ ماند نه ابا","اگر علم و آگاهی درباره آتش و دیگ نداشته باشی، هیچ چیز به‌جا نخواهد ماند و فقط آسیب و خرابی به بار خواهد آمد. در واقع، کم‌دانشی موجب ویرانی و نابودی می‌شود."],[712,"آب حاضر باید و فرهنگ نیز","تا پزد آب دیگ سالم در ازیز","برای پختن غذا، هم باید آب در دسترس باشد و هم فرهنگ (آداب و دانشی) تا دیگ سالم و بدون مشکل پخته شود. این به معنای این است که در هر کاری، داشتن ابزار و دانش لازم بسیار اهمیت دارد."],[712,"چون ندانی دانش آهنگری","ریش و مو سوزد چو آنجا بگذری","اگر نمی‌دانی که چگونه آهنگری بیاموزی، وقتی از آنجا بگذری مو و ریش تو می‌سوزد."],[712,"در فرو بست آن زن و خر را کشید","شادمانه لاجرم کیفر چشید","زن در اتاق را بست و خر را به درون کشید و با شادمانی به کار خود ادامه داد، اما به همین دلیل ناگزیر عذاب و کیفر آن کار ناپسند را چشید."],[712,"در میان خانه آوردش کشان","خفت اندر زیر آن نر خر ستان","او را در خانه به زور به زیر نر خر می‌برد و بر زمین می‌خواباند."],[712,"هم بر آن کرسی که دید او از کنیز","تا رسد در کام خود آن قحبه نیز","کنیزک که بر روی آن کرسی نشسته بود، به آنچه می‌دید مشغول بود تا به خواسته‌های خود برسد، حتی اگر آن خواسته‌ها مرتبط با آنزن باشد."],[712,"پا بر آورد و خر اندر ویی سپوخت","آتشی از کیر خر در وی فروخت","کنیزک پا به پا می‌سوزاند و آتش شور و شهوت را از آلت خر به خود می‌دهد، به گونه‌ای که شعله‌وری در وجودش ایجاد می‌شود."],[712,"خر مؤدب گشته در خاتون فشرد","تا بخایه در زمان خاتون بمرد","خر به خاطر ادب و تربیتش، نسبت به خاتون (زن صاحب‌خر) حریم قائل بود و در حین اینکه به او نزدیک می‌شد، به خودداری و احتیاط عمل می‌کرد، اما در نهایت در زمان خاتون، به سبب فشار و فرط شهوت، جانش را از دست داد."],[712,"بر درید از زخم کیر خر جگر","روده‌ها بسکسته شد از همدگر","به دلیل زخم‌هایی که خر به خاطر رابطه‌اش با کنیزک خورده، جگر و روده‌های او پاره و از هم جدا شده است."],[712,"دم نزد در حال آن زن جان بداد","کرسی از یک‌سو زن از یک‌سو فتاد","زن در حال درد و عذاب جانش را از دست داد، در یک طرف کرسی و در طرف دیگر زن افتاد."],[712,"صحن خانه پر ز خون شد زن نگون","مرد او و برد جان ریب المنون","خانه پر از خون شد و زن بدبخت جان سپرد، زیرا او را به سبب عشق و شهوتش از دنیا بردند."],[712,"مرگ بد با صد فضیحت ای پدر","تو شهیدی دیده‌ای از کیر خر","مرگ بدی که با عذاب و رسوایی همراه است، پدر، تو گواهی داده‌ای که این عذاب، ناشی از رفتار نادرست با خر است."],[712,"تو عذاب الخزی بشنو از نبی","در چنین ننگی مکن جان را فدی","عذاب ذلت و رسوایی را از پیامبر بشنو و در چنین ننگی، جان خود را فدای آن نکن."],[712,"دانک این نفس بهیمی نر خرست","زیر او بودن از آن ننگین‌ترست","این نفس از خوهای حیوانی و بی‌خودی به مانند نر خر است و در واقع وجود چنین نفسی از آنچه که زیر او است، یعنی از ننگ و عیبی که بر او است، بیشتر زشت و ناپسند است."],[712,"در ره نفس ار بمیری در منی","تو حقیقت دان که مثل آن زنی","اگر در مسیر نفس خود بمیری و به نفس اماره‌ات حکم‌فرمایی نکنید، باید بدانی که در واقع وجود حقیقی‌ات همچون همان زن خواهد بود، یعنی به دور از غرض و شهوات."],[712,"نفس ما را صورت خر بدهد او","زانک صورتها کند بر وفق خو","مقصود این است که نفس انسان ممکن است باعث شود که او مانند خر عمل کند، زیرا نفس با شکل دادن به رفتارها و خواسته‌ها، بر اساس طبیعت و تمایلاتش، رفتار فرد را تحت تأثیر قرار می‌دهد."],[712,"این بود اظهار سر در رستخیز","الله الله از تن چون خر گریز","این بیت به بیان این نکته پرداخته که در روز رستاخیز، انسان‌ها باید از جسم مادی خود، که شبیه به خر است، دور شوند و تنها به یاد خدا (الله) بپردازند. رستخیز اشاره به قیامت است که در آن انسان‌ها باید به معنای حقیقی و روحانی خود بپردازند و از بندهای دنیوی رها شوند."],[712,"کافران را بیم کرد ایزد ز نار","کافران گفتند نار اولی ز عار","خداوند کافران را از آتش دوزخ ترساند و کافران گفتند که آتش اولین آتش، نشانه عار و شرمساری است."],[712,"گفت نی آن نار اصل عارهاست","هم‌چو این ناری که این زن را بکاست","گفت که آتش (نار) اصلی که موجب رسوایی (عار) است، همانند این آتش است که این زن را به قهری دچار ساخته و از خود بی‌خود کرده است."],[712,"لقمه اندازه نخورد از حرص خود","در گلو بگرفت لقمه مرگ بد","انسان اگر از حرص و هوس لقمه‌ای را بیش از اندازه بخورد، مثل این است که در گلو خود لقمه‌ای را حبس کرده و در نهایت، این کار می‌تواند به مرگ او منجر شود."],[712,"لقمه اندازه خور ای مرد حریص","گرچه باشد لقمه حلوا و خبیص","ای مرد حریص، لقمه را با اندازه بخور، حتی اگر آن لقمه شیرین و خوشمزه مثل حلوا باشد."],[712,"حق تعالی داد میزان را زبان","هین ز قرآن سوره رحمن بخوان","خداوند تعالی معیار (میزان) را به ما داده است، پس برای آگاهی از این معیار و قوانین زندگی، باید به قرآن، به‌ویژه سوره رحمان، مراجعه کنیم و آن را بخوانیم."],[712,"هین ز حرص خویش میزان را مهل","آز و حرص آمد ترا خصم مضل","به خود بیا و از حرص و طمع خود دوری کن، زیرا حرص، تو را به راهی غلط می‌کشاند و دشمنی نادان برایت می‌آورد که تو را گمراه می‌کند."],[712,"حرص جوید کل بر آید او ز کل","حرص مپرست ای فجل ابن الفجل","هر کسی که حرص و طمع بیشتری دارد، در نهایت از همه چیز دور می‌شود و به سمت چیزهای نامطلوب می‌رود. بنابراین، به دنبال حرص نباشید، ای فرزند حرص (فجل ابن الفجل)."],[712,"آن کنیزک می‌شد و می‌گفت آه","کردی ای خاتون تو استا را به راه","آن کنیزک می‌گفت ای خاتون، تو با آنکه در راهی، از من دور شده‌ای، آه و ناله نکن."],[712,"کار بی‌استاد خواهی ساختن","جاهلانه جان بخواهی باختن","اگر بخواهی کاری را بدون آموختن و مشورت با استاد انجام دهی، به طور نادانسته به آن کار می‌پردازی و ممکن است جان و مال خود را از دست بدهی."],[712,"ای ز من دزدیده علمی ناتمام","ننگ آمد که بپرسی حال دام","ای کسی که از من علمی ناقص و ناتمام به دست آورده‌ای، برایت شرم‌آور است که حال دامی را بپرسی؛ یعنی این علم نادرست و ناپیوسته‌ای که گرفتی، تو را به جایی نخواهد رساند و حال دامی در نظر نداری."],[712,"هم بچیدی دانه مرغ از خرمنش","هم نیفتادی رسن در گردنش","تو هم دانه‌ی مرغی را از خوشه‌اش چیدی، هم در این کار، دقت کرده و به ریسمانی که به گردن مرغ است، نواختی که نیفتد."],[712,"دانه کمتر خور مکن چندین رفو","چون کلوا خواندی بخوان لا تسرفوا","دانه را کمتر بخور و زیاده‌روی نکن، چنان که در قرآن آمده است \"بخورید و زیاده‌روی نکنید\"."],[712,"تا خوری دانه نیفتی تو به دام","این کند علم و قناعت والسلام","اگر دانه‌ای کمتر بخوری، به دام شهوت و وسوسه نمی‌افتید. این حرف نشان‌دهنده‌ی اهمیت علم و قناعت است و در نهایت به آرامش و رهایی از مشکلات ختم می‌شود."],[712,"نعمت از دنیا خورد عاقل نه غم","جاهلان محروم مانده در ندم","عاقل از نعمت‌های دنیایی می‌خورد و بهره‌مند می‌شود، در حالی که نباید نگران افراد جاهلی باشد که از خوشی‌ها و نعمت‌ها محروم مانده‌اند و تنها در حسرت و غم به سر می‌برند."],[712,"چون در افتد در گلوشان حبل دام","دانه خوردن گشت بر جمله حرام","زمانی که دام در گلویشان بیفتد، خوردن دانه بر همه حرام می‌شود. این جمله بیانگر این است که زمانی که در دام فریب بیفتند، هر چیزی که پیش بیاید، برای آنها ممنوع و ناپسند خواهد بود."],[712,"مرغ اندر دام دانه کی خورد","دانه چون زهرست در دام ار چرد","مرغ وقتی در دام می‌افتد، دانه نمی‌خورد، چرا که آن دانه برایش مانند زهر است. اگر هم دانه‌ای بخورد، در حقیقت در دام گرفتار شده و به علت خطر آن دانه را نمی‌تواند بخورد."],[712,"مرغ غافل می‌خورد دانه ز دام","هم‌چو اندر دام دنیا این عوام","مرغی که بی‌خبر از خطر در دام غذا می‌خورد، همچون کسانی که در دنیا غافل از مشکلات و چالش‌ها زندگی می‌کنند."],[712,"باز مرغان خبیر هوشمند","کرده‌اند از دانه خود را خشک‌بند","پرندگان آگاه و هوشمند از دانه‌ای که می‌خورند، خود را در تنگنای مشکلات و کمبودها قرار نداده‌اند و از آن دوری می‌کنند."],[712,"که اندرون دام دانه زهرباست","کور آن مرغی که در فخ دانه خواست","مرغی که به دنبال دانه می‌گردد، ممکن است تازه‌کار و ناآگاه باشد و در دام زهرآلودی بیفتد. او نمی‌داند که در جستجوی چیزی خوشمزه به خطر می‌افتد و بی‌خبر از عواقب آن چه بلایی بر سرش می‌آید."],[712,"صاحب دام ابلهان را سر برید","وآن ظریفان را به مجلسها کشید","صاحب دام، که به معنای تولیدکننده دام یا شکارچی است، کسانی را که نادان هستند به هلاکت می‌رساند و در عوض، افراد با هوش و با دقت را به مجالس خود دعوت می‌کند."],[712,"که از آنها گوشت می‌آید به کار","وز ظریفان بانگ و ناله زیر و زار","از آن‌ها گوشت و خوراک به دست می‌آید و از میان ظریفان صدا و ناله‌ای غم‌انگیز و رقت‌آور شنیده می‌شود."],[712,"پس کنیزک آمد از اشکاف در","دید خاتون را به مرده زیر خر","کنیز آمد و از لای در، خاتون را درحالیکه مرده بود زیر خر دید"],[712,"گفت ای خاتون احمق این چه بود","گر ترا استاد خود نقشی نمود","این بیت به خاتون می‌گوید که اگر تو احمق هستی، این چه دلیلی دارد که استاد تو (کسی که تو را آموزش داده) نقشی (یعنی تأثیری) بر تو گذاشته باشد؟ به عبارت دیگر، مصراع به کم‌فهمی خاتون و تأثیرپذیری او از معلمش اشاره دارد."],[712,"ظاهرش دیدی سرش از تو نهان","اوستا ناگشته بگشادی دکان","ظاهر این موضوع را می‌بینی، ولی حقیقت آن (چیزهای پنهان) از تو پنهان است. استاد (حکمت) این راز را هنوز به تو نیاموخته که چگونه به عمق وجود این قضیه پی ببری."],[712,"کیر دیدی هم‌چو شهد و چون خبیص","آن کدو را چون ندیدی ای حریص؟","تو آن عضو تناسلی را با خوشحالی و شوق دیدی، مانند شهد شیرین و چیزهای خوشمزه، اما چرا آن کدوی پنهان را که اهمیت دارد و باید ببینی، ندیدی ای حریص؟"],[712,"یا چو مستغرق شدی در عشق خر","آن کدو پنهان بماندت از نظر","یا آنقدر در عشق جماع با خر غرق بودی که آن کدو را ندیدی"],[712,"ظاهر صنعت بدیدی زوستاد","اوستادی برگرفتی شاد شاد","تو فقط ظاهر کار را دیدی و به خاطر آن خوشحال و شادمان شدی، حال آن‌که حقیقت و کار استاد (یا معلم) را فراموش کرده‌ای."],[712,"ای بسا زراق گول بی‌وقوف","از ره مردان ندیده غیر صوف","بسیاری از افرادی که نادان و بی‌خبر هستند، از راه زندگی مردان واقعی به سوی حقیقت نمی‌روند و تنها ظاهر کار را می‌بینند و از عمق معنا غافلند."],[712,"ای بسا شوخان ز اندک احتراف","از شهان ناموخته جز گفت و لاف","بسیاری از کسانی که در ظاهر خود را شوخ و خوش‌گوی نشان می‌دهند، در واقع از بزرگان و اندیشمندان هیچ چیزی نیاموخته‌اند و فقط به حرف‌ها و نمایش‌های توخالی بسنده می‌کنند."],[712,"هر یکی در کف عصا که موسی‌ام","می‌دمد بر ابلهان که عیسی‌ام","هر کسی در دستش عصا دارد و خود را مانند موسی می‌داند، اما در واقع به ابلهان (احمق‌ها) می‌گوید که من عیسی هستم. این بدان معنی است که افراد ممکن است خود را در مقام والا و بزرگ بپندارند، در حالی که در واقعیت، به اندیشه و رفتار خود کمتر توجه دارند."],[712,"آه از آن روزی که صدق صادقان","باز خواهد از تو سنگ امتحان","از روزی که راست‌گوها (صادقان) با آزمون‌های سختی روبه‌رو خواهند شد و صداقت آن‌ها به چالش کشیده خواهد شد، آه و حسرت بر دل‌ها خواهد نشست."],[712,"آخر از استاد باقی را بپرس","یا حریصان جمله کورانند و خرس","بپرس از استاد باقی (یک عارف بزرگ)، زیرا حریصان و طمع‌کاران همه مانند کورها هستند و به درستی نمی‌بینند و درک نمی‌کنند."],[712,"جمله جستی باز ماندی از همه","صید گرگانند این ابله رمه","همه چیز را جستجو کردی، اما از همه چیز باز مانده‌ای؛ چون تو هم مانند گرگ‌ها و حیله‌گران، احمق و نادان هستی که در جمع خود به دنبال طعمه هستی."],[712,"صورتی بشنیده گشتی ترجمان","بی‌خبر از گفت خود چون طوطیان","تو فقط ظاهری را می‌بینی و به حرف خودت توجه نداری، مانند طوطیانی که فقط صداهای دیگران را تکرار می‌کنند و از معنای آن‌ها بی‌خبرند."],[713,"طوطیی در آینه می‌بیند او","عکس خود را پیش او آورده رو","طوطی در آینه تصویر خودش را می‌بیند که در واقع دیده‌اش بازتاب خود اوست."],[713,"در پس آیینه آن استا نهان","حرف می‌گوید ادیب خوش‌زبان","در پشت آینه، آن استاد نهان است و سخن می‌گوید، در حالی که ادیب خوش‌زبانی به او گوش می‌دهد."],[713,"طوطیک پنداشته کین گفت پست","گفتن طوطیست که اندر آینه‌ست","طوطی فکر کرده که این سخنی که می‌گوید، از خود اوست، در حالی که این حرف در واقع سخن طوطی دیگری است که در آینه منعکس شده است."],[713,"پس ز جنس خویش آموزد سخن","بی‌خبر از مکر آن گرگ کهن","پس او تنها از نوع و ذات خود می‌تواند یاد بگیرد و سخن بگوید، درباره فریب و نیرنگ آن گرگ کهن، بی‌خبر است."],[713,"از پس آیینه می‌آموزدش","ورنه ناموزد جز از جنس خودش","شیخ، مریدان را از طریق آینه که همان تصویر خود اوست می‌آموزد، وگرنه هرکسی فقط از ذات خودش یاد می‌گیرد و نمی‌تواند از دیگران چیزی بیاموزد."],[713,"گفت را آموخت زان مرد هنر","لیک از معنی و سرش بی‌خبر","آموختن لفظ و شکل سخن را از آن مرد (استاد) به او (شاگرد) رسیده است، اما او از معنی و مفهوم واقعی آن بی‌خبر و نادان است."],[713,"از بشر بگرفت منطق یک به یک","از بشر جز این چه داند طوطیک","طوطی تنها می‌تواند از انسان زبان و منطق را یاد بگیرد، ولی هیچ چیز دیگر جز این نمی‌داند و نمی‌تواند درک کند. این نشان‌دهنده محدودیت فهم و دانش اوست."],[713,"هم‌چنان در آینه جسم ولی","خویش را بیند مردی ممتلی","مردی که در آینه‌ی جسم خویش را می‌بیند، در واقع در حجاب جسم خود باقی مانده و نمی‌تواند به حقیقت وجودی و درون خود پی ببرد و به عمق وجود خود دست یابد."],[713,"از پس آیینه عقل کل را","کی ببیند وقت گفت و ماجرا","کسی که پشت آیینه‌ای قرار دارد، نمی‌تواند عقل کل را ببیند؛ یعنی زمانی که موضوعی مطرح می‌شود یا اتفاقی رخ می‌دهد، او فقط درک محدودی از آن دارد و توانایی فهم کامل آن را ندارد."],[713,"او گمان دارد که می‌گوید بشر","وان اگر سرست و او زان بی‌خبر","او تصور می‌کند که چیزی را بیان می‌کند، در حالی که اگر به حقیقت بنگرد، آنچه می‌گوید تنها ظاهری است و از باطن خود بی‌خبر است."],[713,"حرف آموزد ولی سر قدیم","او نداند طوطی است او نی ندیم","این فرد حرف می‌آموزد، اما نمی‌داند که روح و هویت واقعی‌اش چیست و در واقع مانند طوطی است که فقط تقلید می‌کند و معنای واقعی آموزه‌ها را درک نمی‌کند."],[713,"هم صفیر مرغ آموزند خلق","کین سخن کار دهان افتاد و حلق","خلق (مردم) در یادگیری و آموزش همچون پرنده‌ای به صفیر (صدای) مرغ آواز می‌زنند، زیرا این سخن (آموختن) تنها به کار دهان می‌آید و به حلق (گلو) ختم می‌شود. بدین ترتیب، اشاره به این است که آموزش superficial و از روی ظاهرسازی است و عمق و معنای واقعی ندارد."],[713,"لیک از معنی مرغان بی‌خبر","جز سلیمان قرانی خوش‌نظر","تنها سلیمان، پیامبر و پادشاهی که در قصه‌ها به عنوان فردی با درک و فهم خاص از زبان حیوانات شناخته می‌شود، می‌تواند به معنی واقعی مرغان (پرندگان) پی ببرد و از اسرار آن‌ها آگاه شود؛ سایر افراد از حقیقت آنها بی‌خبرند."],[713,"حرف درویشان بسی آموختند","منبر و محفل بدان افروختند","درویشان در سخنرانی‌ها و مجالس زیادی学习 کرده‌اند و این محافل را برای بیان معانی عمیق و روحانی زنده نگه داشته‌اند."],[713,"یا به جز آن حرفشان روزی نبود","یا در آخر رحمت آمد ره نمود","یا آن سخنان که در روزهای دیگر بیان شده، اصلا وجود نداشت، یا در پایان، رحمت خداوند، راهی برای بهره‌مندی از آن سخنان ایجاد کرد."],[714,"آن یکی می‌دید خواب اندر چله","در رهی ماده سگی بد حامله","شخصی در خواب می‌بیند که در روزهای سخت و در میانه زمستان، سگی حامله در مسیر او قرار دارد."],[714,"ناگهان آواز سگ‌بچگان شنید","سگ‌بچه اندر شکم بد ناپدید","او ناگهان صدای سگ‌بچه‌ها را شنید در حالی که هنوز در شکم مادر خود بودند و صدایی از آن‌ها پیدا نبود."],[714,"بس عجب آمد ورا آن بانگها","سگ‌بچه اندر شکم چون زد ندا","عجب اینجاست که سگ‌مادر صدای سگ‌بچه‌ها را که در شکمش هستند، می‌شنود و این صداها را به گوش خود می‌آورد."],[714,"سگ‌بچه اندر شکم ناله کنان","هیچ‌کس دیدست این اندر جهان","سگ‌ بچه‌ها در شکم مادرشان ناله می‌کنند، اما هیچ‌کسی در این دنیا آن را نمی‌بیند."],[714,"چون بجست از واقعه آمد به خویش","حیرت او دم به دم می‌گشت بیش","زمانی که از آن واقعه خارج شد و به حال خود آمد، حیرتش روز به روز بیشتر می‌شد."],[714,"در چله کس نی که گردد عقده حل","جز که درگاه خدا عز و جل","در چله، هیچ‌کس نیست که بتواند مشکلات و گره‌های روحی را بگشاید، مگر اینکه به درگاه خداوند عز و جل روی بیاورد و از او مدد بخواهد."],[714,"گفت یا رب زین شکال و گفت و گو","در چله وا مانده‌ام از ذکر تو","گفت ای پروردگار، در این حال و در این گفت‌وگو، در محبسی مانده‌ام که نمی‌توانم تو را یاد کنم و ذکر تو را بگویم."],[714,"پر من بگشای تا پران شوم","در حدیقه ذکر و سیبستان شوم","ای خدا، بال‌های من را بگشای تا بتوانم آزادانه در باغ یاد و ذکر تو بچرخم و به جایی دل‌انگیز و خوشبو تبدیل شوم."],[714,"آمدش آواز هاتف در زمان","که آن مثالی دان ز لاف جاهلان","او در زمانی که آن مثالی را از لاف‌های جاهلان شنید، به سوی او صدایی از جانب یک فرشته آمد."],[714,"کز حجاب و پرده بیرون نامده","چشم بسته بیهده گویان شده","کسانی که از حجاب و پرده بیرون نیامده و چشم دلشان باز نشده، به بیهوده سخن می‌گویند و عاقبت نمی‌دانند که چه می‌گویند."],[714,"بانگ سگ اندر شکم باشد زیان","نه شکارانگیز و نه شب پاسبان","صدای سگی که در شکم مادرش است، نه برای فریاد زدن بر شکارهاست و نه برای حفاظت شبانه، بلکه فقط نشاندهنده بی‌فایده بودن این صداست."],[714,"گرگ نادیده که منع او بود","دزد نادیده که دفع او شود","گرگ‌هایی که دیده نمی‌شوند، به او (سگ حامله) آسیب می‌زنند، و دزدهایی که مشخص نیستند، همواره باید از آن‌ها دوری شود."],[714,"از حریصی وز هوای سروری","در نظر کند و بلافیدن جری","از هوس به مقام و مقام‌داری و از حرص و طمع، فردی به چیزهایی می‌نگرد که در دسترسش نیست و به دنبال رسیدن به آن‌هاست، بدون اینکه درک کند که این خواسته‌ها ممکن است او را به زحمت بیاندازد."],[714,"از هوای مشتری و گرم‌دار","بی بصیرت پا نهاده در فشار","کسی که به خاطر طمع به زندگی مرفه و خوشی‌های دنیا (مشتری و گرم‌دار) بدون بینش و آگاهی (بی بصیرت) قدم گذاشته و در وضعی دشوار یا فشاری قرار دارد، در واقع باید با واقعیت‌هایی که با آنها روبه‌روست، مواجه شود و از توهماتش بیرون بیاید."],[714,"ماه نادیده نشانها می‌دهد","روستایی را بدان کژ می‌نهد","ماه که در اینجا به عنوان نماد یا نماینده‌ای از حقیقت یا علم معرفی شده، با وجود اینکه دیده نمی‌شود، نشانه‌های بسیاری را به روستایی می‌دهد و او را به سوی کژی یا انحراف می‌کشاند. این به این معناست که برخی حقایق و نشانه‌ها وجود دارند که فرد قادر به دیدن آن‌ها نیست، اما تأثیر آن‌ها بر زندگی‌اش آشکار است."],[714,"از برای مشتری در وصف ماه","صد نشان نادیده گوید بهر جاه","ماه برای مشتری (سیاره‌ای در آسمان) به نوعی سمبل و نشانه‌ای است که نمی‌تواند نمایانگر تمام خصائص و زیبایی‌های خود باشد. این صد نشان نادیده، به این معناست که ماه در وصف مشتری به شکلی غیرقابل دیدن و نامحسوس جلوه می‌کند و تنها در فضای خاصی از وجود و موقعیت، شایستگی‌های خود را نشان می‌دهد."],[714,"مشتری کو سود دارد خود یکیست","لیک ایشان را درو ریب و شکیست","مشتری که از آن سود می‌برد، در واقع تنها یک نفر است، اما دیگران در آن شک و تردید دارند و نمی‌توانند آن را به‌درستی درک کنند."],[714,"از هوای مشتری بی‌شکوه","مشتری را باد دادند این گروه","این گروه از مشتری (خداوند) که به عظمت و جلالش نمی‌رسند، همچون باد، از هوای محبوب خود بهره‌مند شده‌اند و به همین دلیل در حالتی از شگفتی و خضوع به سر می‌برند."],[714,"مشتری ماست الله اشتری","از غم هر مشتری هین برتر آ","خداوند به منزله مشتری ماست و به ما از غم‌ها برتری می‌دهد؛ بنابراین، ای کسانی که مشتاق هستید، از غم‌های خود دوری کنید."],[714,"مشتریی جو که جویان توست","عالم آغاز و پایان توست","مشتری‌ای را پیدا کن که به دنبال توست؛ او کسی است که آغاز و پایان جهان را می‌شناسد و به جستجوی تو آمده است."],[714,"هین مکش هر مشتری را تو به دست","عشق‌بازی با دو معشوقه بدست","توجه نکن که هر کسی را به خاطر بازی عشق به سوی خود جذب کنی؛ چرا که این کار ممکن است به دو معشوقه منجر شود و تو را به مشکل بیندازد."],[714,"زو نیابی سود و مایه گر خرد","نبودش خود قیمت عقل و خرد","اگر عقل و خرد نباشد، نه سودی خواهی یافت و نه مایه‌ای. در واقع، ارزش واقعی عقل و خرد در برابر دیگر چیزها مشخص می‌شود."],[714,"نیست او را خود بهای نیم نعل","تو برو عرضه کنی یاقوت و لعل","او (افراد بی‌خود و نادان) هیچ‌گاه نمی‌تواند به تنهایی بهای نیم‌نعل (که یک شیء بی‌ارزش است) را داشته باشد، پس چه جا دارد که بخواهد یاقوت و لعل (که بسیار ارزشمندند) را به او عرضه کنی؟"],[714,"حرص کورت کرد و محرومت کند","دیو هم‌چون خویش مرجومت کند","حرص و طمع، انسان را به blindness می‌کشاند و باعث می‌شود که از نعمت‌ها و خیرات محروم بماند. دیو، مانند خود او، به او آسیب می‌زند و او را در وضعیتی سخت قرار می‌دهد."],[714,"هم‌چنانک اصحاب فیل و قوم لوط","کردشان مرجوم چون خود آن سخوط","همان‌طور که اصحاب فیل و قوم لوط به دلیل بدکرداری و سرپیچی از فرمان خداوند نابود شدند، این افراد نیز به خاطر نادانی و گمراهی خود مورد عذاب قرار می‌گیرند."],[714,"مشتری را صابران در یافتند","چون سوی هر مشتری نشتافتند","صبر و شکیبایی باعث می‌شود که افراد به خوبی از روزی و نعمت‌ها بهره‌مند شوند، و کسانی که به سوی هدف خود تلاش می‌کنند، در نهایت به مقصود می‌رسند."],[714,"آنک گردانید رو زان مشتری","بخت و اقبال و بقا شد زو بری","آن کسی که از آن مشتری (شخص خوشبخت) روی گرداند، بخت و اقبالش از او جدا شد و ماندگاری را نیز از دست داد."],[714,"ماند حسرت بر حریصان تا ابد","هم‌چو حال اهل ضروان در حسد","حریصان و طمع‌کاران همیشه در حسرت و آرزوی چیزهایی که ندارند باقی می‌مانند، مانند کسانی که در حسد به سر می‌برند و هیچ‌گاه آرام نمی‌گیرند."],[715,"بود مردی صالحی ربانی‌ای","عقل کامل داشت و پایان دانی‌ای","مردی نیکوکار و با تقوا وجود داشت که عقلش کامل و درک او از حوادث بسیار بالا بود."],[715,"در ده ضروان به نزدیک یمن","شهره اندر صدقه و خلق حسن","در روستای ضروان که نزدیک یمن است، مردی معروف به دادن صدقه و داشتن نیکی‌ها و صفات پسندیده است."],[715,"کعبه درویش بودی کوی او","آمدندی مستمندان سوی او","محل او مانند کعبه برای درویشان بود و نیازمندان و مستمندان به سوی او می آمدند."],[715,"هم ز خوشه عشر دادی بی‌ریا","هم ز گندم چون شدی از که جدا","او (مولانا) بیان می‌کند که از خوشه انگور و گندم، همیشه ده‌دهم آن (عشر) را به نیازمندان می‌داد بی‌ریا و بدون تظاهر، همچنین وقتی گندم را از کاه جدا می‌کرد نیز به همین صورت مقدار مشخصی را به آنها می‌بخشید."],[715,"آرد گشتی عشر دادی هم از آن","نان شدی عشر دگر دادی ز نان","از آرد، یعنی آردی که به‌دست آورده بودی، هم عشر (یک‌دهم) را به نیازمندان دادی و از آن نان هم باز یک‌دهم دیگر را به آنان بخشیدی."],[715,"عشر هر دخلی فرو نگذاشتی","چارباره دادی زانچ کاشتی","عشر، یعنی یکی‌دهم، از هر درآمدی را کم نگذاشتی و به مستمندان بخشیدی. همچنین، چهار برابر آنچه که کاشته بودی، از این طریق به دست آوردی."],[715,"بس وصیت‌ها بگفتی هر زمان","جمع فرزندان خود را آن جوان","آن جوان هر بار به فرزندانش توصیه‌های زیادی می‌کرد و به آنها می‌گفت که باید همواره دور هم جمع شوند."],[715,"الله الله قسم مسکین بعد من","وا مگیریدش ز حرص خویشتن","ای خدا، سوگند که بعد از من (این فساد و حسد) به مسکینان توجه کنید و از حرص خود آن‌ها را نرانید."],[715,"تا بماند بر شما کشت و ثمار","در پناه طاعت حق پایدار","تا زمانی که شما در راستای اطاعت و بندگی خداوند باشید، کاشت و برداشت محصولات زراعی و میوه‌ها در امنیت و پایداری باقی خواهد ماند."],[715,"دخل‌ها و میوه‌ها جمله ز غیب","حق فرستادست بی‌تخمین و ریب","تمام درآمدها و میوه‌ها از طرف خداوند به طور ناگهانی و بدون هیچ گونه پیش‌بینی و شک ارسال شده‌اند."],[715,"در محل دخل اگر خرجی کنی","درگه سودست سودی بر زنی","در جایی که درآمدی وجود دارد، اگر بخشی از آن را خرج کنی، در واقع به نفع خود عمل کرده‌ای، چرا که از این هزینه، بهره‌ای نصیب تو خواهد شد."],[715,"ترک اغلب دخل را در کشت‌زار","باز کارد که ویست اصل ثمار","اکثر برداشت‌ها و درآمدها را در کشت‌زار رها کن، زیرا اصل و میوه درختان، خود آنها را به بار می‌آورند."],[715,"بیشتر کارد خورد زان اندکی","که ندارد در بروییدن شکی","کارد (چاقو) بیشتر به دلیل نداشتن چیزی (که به آن نیاز دارد) در زمینه رشد (محصول) آسیب می‌زند و به نتایج خوبی نمی‌رسد. این به این معناست که کسانی که به شدت حسرت می‌خورند یا حسد می‌ورزند، بیشتر از آنچه که دارند، دچار مشکل می‌شوند و بر این اساس نمی‌توانند چیزی را رشد دهند."],[715,"زان بیفشاند به کشتن ترک دست","کآن غله‌ش هم زان زمین حاصل شدست","به خاطر حسد ورزیدن به درویشان، او در کشت و کار با ترک‌ها به زمین آسیب می‌زند، در حالی که همان زمین است که محصولی خوب به او می‌دهد."],[715,"کفشگر هم آنچ افزاید ز نان","می‌خرد چرم و ادیم و سختیان","کفاش (کفشگر) نیز با نانی که می‌خورد، چرم و گوشت و چیزهای محکم می‌خرد."],[715,"که اصول دخلم اینها بوده‌اند","هم ازین‌ها می‌گشاید رزق بند","درآمد من از همین چیزهایی بوده که در آن ذکر شد و از همین نکات، روزی من نیز تأمین می‌شود."],[715,"دخل از آنجا آمدستش لاجرم","هم در آنجا می‌کند داد و کرم","درآمد او از آن منبع آمده است، بنابراین در همان‌جا هم با بخشش و generosity خود، عمل می‌کند."],[715,"این زمین و سختیان پرده‌ست و بس","اصل روزی از خدا دان هر نفس","این سرزمین و سختی‌های آن فقط پرده‌ای است، و در واقع، هر روزی که به انسان می‌رسد، از جانب خداوند است."],[715,"چون بکاری در زمین اصل کار","تا بروید هر یکی را صد هزار","هرگاه که در زمین بکاری، اساس کار در واقع این است که وقتی رشد کند، هر یک تخم می‌تواند به صد هزار درخت برسد."],[715,"گیرم اکنون تخم را گر کاشتی","در زمینی که سبب پنداشتی","اگر فرض کنیم که تو این دانه را در زمینی که فکر می‌کردی مناسب است، بکاری، در واقع این کار تو بر اساس اندیشه خودت انجام شده است."],[715,"چون دو سه سال آن نروید چون کنی","جز که در لابه و دعا کف در زنی","اگر در انتظار میوه‌ای هستی و سال‌ها تلاش می‌کنی اما نتیجه‌ای نمی‌بینی، تنها راهی که برای تو می‌ماند دعا و خواستن از خداوند است."],[715,"دست بر سر می‌زنی پیش اله","دست و سر بر دادن رزقش گواه","دست خود را بر سر می‌زنی به نشانه افسوس و تأسف بر آنچه که خداوند به تو داده است، زیرا دادن رزق و برکت از سوی او، گواهی از رحمت و لطف اوست."],[715,"تا بدانی اصل اصل رزق اوست","تا همو را جوید آنکه رزق‌جوست","باید بدانی که ریشه و اصل معنوی رزق فقط از خداوند است و تنها کسی که واقعی به دنبال رزق می‌گردد، باید به او روی آورد و او را بخواهد."],[715,"رزق از وی جو مجو از زید و عمرو","مستی از وی جو مجو از بنگ و خمر","روزیش را از خداوند بگیر، نه از زید و عمر (دو فرد مشهور)، و به جای نوشیدن مستی از شراب و مواد مخدر، سرمستی واقعی را از او طلب کن."],[715,"توانگری زو خواه نه از گنج و مال","نصرت از وی خواه نه از عم و خال","از توانگری و دارایی به خاطر گنج و مال نباید طلب کرد، بلکه نصرت و یاری را باید از او طلب کرد نه از خویشاوندان مانند عم و خاله."],[715,"عاقبت زین‌ها بخواهی ماندن","هین کرا خواهی در آن دم خواندن","پس از آنکه از این نعمت‌ها بهره‌مند شدی، در نهایت اگر بخواهی باقی بمانی، به کی و کدام شخصی در آن زمان می‌خواهی پناه ببری و او را بخوانی؟"],[715,"این دم او را خوان و باقی را بمان","تا تو باشی وارث ملک جهان","در اینجا بیان می‌شود که در لحظه کنونی باید کسی را برای خود بخوانی و دیگران را به حال خود بگذاری تا تو وارث پادشاهی و نعمت‌های جهان باشی. این گفته به نوعی بر ارزش فردیت و قناعت به شرایط کنونی تأکید دارد."],[715,"چون یفر المرء آید من اخیه","یهرب المولود یوما من ابیه","هرگاه شدت و شدت به رابطه دوستانه کسی با برادرش برسد، فرزند هم از پدر خود فراری می‌شود."],[715,"زان شود هر دوست آن ساعت عدو","که بت تو بود و از ره مانع او","هر دوستی در لحظه‌ای ممکن است به دشمنی تبدیل شود، هنگامی که دلبستگی به تو، یعنی معشوق یا محبوب، مانع او شود."],[715,"روی از نقاش رو می‌تافتی","چون ز نقشی انس دل می‌یافتی","تو از روی زیبا و دل‌نواز نقاش، روی برمی‌گرداندی، چون به زیبایی و محبت او دل می‌باختی."],[715,"این دم ار یارانت با تو ضد شوند","وز تو برگردند و در خصمی روند","اگر این لحظه دوستانت بر تو دشمن شوند و از تو دور شوند و در خصومت به سر ببرند،"],[715,"هین بگو نک روز من پیروز شد","آنچ فردا خواست شد امروز شد","بیایید بگوییم که روز من امروز به پیروزی رسید، چون آنچه را فردا خواستم، امروز به نتیجه رسید."],[715,"ضد من گشتند اهل این سرا","تا قیامت عین شد پیشین مرا","اهل این خانه (یا مکان) بر ضد من شده‌اند و از این به بعد، وضع من به حالت گذشته برنمی‌گردد و همچنان ادامه خواهد یافت."],[715,"پیش از آنکه روزگار خود برم","عمر با ایشان به پایان آورم","قبل از اینکه زندگی‌ام بگذرد و به سرانجام برسد، می‌خواهم با این مردم بمانم و روزگار خود را در کنار آنها سپری کنم."],[715,"کاله معیوب بخریده بدم","شکر کز عیبش بگه واقف شدم","من چیزی معیوب خریده‌ام و متوجه عیب آن شده‌ام، به همین خاطر شکر خدا را به‌جا می‌آورم که به حقیقت و عیب آن پی بردم."],[715,"پیش از آن کز دست سرمایه شدی","عاقبت معیوب بیرون آمدی","پیش از آنکه سرمایه‌ات (ثروت و دارایی‌ات) از دست برود، به ناچار متوجه شدی که کالا (یا اموال)ت معیوب و خراب است."],[715,"مال رفته عمر رفته ای نسیب","مال و جان داده پی کاله‌ی معیب","مال و ثروت و عمر که از دست رفته، نصیب کسی نمی‌شود، و آنکه برای چیزهای کم‌ارزش و بی‌فایده‌ ترجیحشان داده، مال و جانش را در این مسیر هدر داده است."],[715,"رخت دادم زرّ قلبی بستدم","شاد شادان سوی خانه می‌شدم","با خود گفتم که قلبم را پر از طلای عشق و شادی کرده‌ام و در حالی که شاد و خوشحال هستم، به سمت خانه می‌روم."],[715,"شکر کین زر قلب پیدا شد کنون","پیش از آنکه عمر بگذشتی فزون","خوشحالم که قلبم به ارزش واقعی خود پی برد و اکنون از این روزها و عمر گرانبها استفاده کنم، پیش از آنکه زمان زیادی از دست برود."],[715,"قلب ماندی تا ابد در گردنم","حیف بودی عمر ضایع کردنم","من چنان قلبی دارم که تا همیشه به گردن من است و افسوس می‌خورم که عمرم را بیهوده تلف کردم."],[715,"چون بگه‌تر قلبی او رو نمود","پای خود زو وا کشم من زود زود","وقتی دل او (یار) به خاطر غم و حسد اندوهگین می‌شود، من به سرعت او را از خود دور می‌کنم."],[715,"یار تو چون دشمنی پیدا کند","گرّ حقد و رشک او بیرون زند","اگر دوست تو به دشمنی تبدیل شود، حسد و کینه‌اش نسبت به تو بروز می‌کند."],[715,"تو از آن اعراض او افغان مکن","خویشتن را ابله و نادان مکن","به خاطر تهمت‌ها و حسد دیگران، خودت را نادان و احمق نشان نده و به خاطر بی‌توجهی آن‌ها ناراحت نشو."],[715,"بلک شکر حق کن و نان بخش کن","که نگشتی در جوال او کهن","شکر خدا را بجای آور و نان بیشتری تقسیم کن، زیرا تو در کیسه او (خدا) کهنه و بی‌ارزش نبودی."],[715,"از جوالش زود بیرون آمدی","تا بجویی یار صدق سرمدی","تو به سرعت از گونی زندگی‌ات خارج شده‌ای تا یار وفادار و همیشگی‌ات را پیدا کنی."],[715,"نازنین یاری که بعد از مرگ تو","رشته یاری او گردد سه تو","دوست عزیز و نازنین من، پس از مرگ تو، آن دوستی که به من می‌رسد، به هیچ وجه نمی‌تواند جانشین تو شود."],[715,"آن مگر سلطان بود شاه رفیع","یا بود مقبول سلطان و شفیع","آیا او تنها یک پادشاه بلندمرتبه بود یا واقعا مورد قبول و شفاعت‌کننده پادشاهان بود؟"],[715,"رستی از قلاب و سالوس و دغل","غرّ او دیدی عیان پیش از اجل","شما حقیقت را در زندگی پیدا کردید، نه فریب و نیرنگ و ریا. او را پیش از مرگ به روشنی مشاهده کردید."],[715,"این جفای خلق با تو در جهان","گر بدانی گنج زر آمد نهان","این بدرفتاری مردم با تو در این دنیا اگر درک کنی، مانند گنجی پنهان ارزشمند است."],[715,"خلق را با تو چنین بدخو کنند","تا تو را ناچار رو آن سو کنند","مردم با تو بدرفتاری می‌کنند تا تو مجبور شوی به جانب دیگری روی بیاوری."],[715,"این یقین دان که در آخر جمله‌شان","خصم گردند و عدو و سرکشان","بدان که در نهایت، این افراد به دوستانت دشمن و مخالف خواهند شد و به سرکشی و طغیان گرایش پیدا می‌کنند."],[715,"تو بمانی با فغان اندر لحد","لا تذرنی فرد خواهان از احد","تو در عالم برزخ (لحد) در عذاب و فغان خواهی ماند و کسی برای کمک به تو نمی‌آید و تنها خواهی ماند."],[715,"ای جفاات به ز عهد وافیان","هم ز داد توست شهد وافیان","ای نادان، کار بد تو بیشتر از عهد و پیمان کسانی است که به درستی و صداقت عمل کرده‌اند؛ زیرا آنچه به دیگران می‌دهی و بخشش می‌کنی، در حقیقت همان شیرینی و خوبی عمل انسان‌های راستین است."],[715,"بشنو از عقل خود ای انباردار","گندم خود را به ارض الله سپار","ای انباردار، از عقل خود بشنو و گندم خود را به درگاه خدا بسپار و در راستی و خیری که به دیگران می‌رسانی، سعادتی بیاب."],[715,"تا شود آمن ز دزد و از شپش","دیو را با دیوچه زوتر بکش","برای این‌که از دزدها و موجودات پلید در امان بمانی، زودتر دیو بزرگ (نماد شر) را با دیوچه‌اش (نماد شر کوچک) از میان بردار."],[715,"کو همی ترساندت هر دم ز فقر","هم‌چو کبکش صید کن ای نرّه صقر","تو هر لحظه از فقر می‌ترساندت، همان‌گونه که یک صقر نر (پرنده‌ای شکاری) کبک را صید می‌کند."],[715,"باز سلطان عزیزی کامیار","ننگ باشد که کند کبکش شکار","چگونه ممکن است که یک سلطان عزیز و بزرگوار، دست به چنین کار زشتی بزند و کبک را شکار کند؟ این نشان‌دهنده‌ی دوری او از مروت و نیک‌کرداری است."],[715,"بس وصیت کرد و تخم وعظ کاشت","چون زمین‌شان شوره بد سودی نداشت","او بسیار سفارش و نصیحت کرد و همچون دانه‌های موعظه را در دل آنها کاشت، اما چون دل آن‌ها مانند زمین خراب و شور است، هیچ فایده‌ای نداشت."],[715,"گرچه ناصح را بود صد داعیه","پند را اذنی بباید واعیه","هرچند نصیحت‌گر (ناصح) صد موضوع برای پند دادن دارد، اما برای انتقال پند به پذیرش شنونده (واعیه)، لازمه‌اش وجود اجازه و آمادگی در اوست."],[715,"تو به صد تلطیف پندش می‌دهی","او ز پندت می‌کند پهلو تهی","تو با هزار نرمش و لطافت نصیحت می‌کنی او نه تنها توجه نمی‌کند، بلکه از پند تو دوری می‌گزیند."],[715,"یک کس نامستمع ز استیز و رد","صد کس گوینده را عاجز کند","اگر یک نفر به جای شنیدن و درک کردن، انتقاد و انکار کند، می‌تواند موجب ناتوانی سخن‌گویان زیادی شود، زیرا آن‌ها را از ابراز افکار و ایده‌هایشان باز می‌دارد."],[715,"ز انبیا ناصح‌تر و خوش لهجه‌تر","کی بود کی گرفت دمشان در حجر","هیچ‌کس نسبت به انبیا (پیامبران) دلسوزتر و با لهجه‌ای دلنشین‌تر از آن‌ها نیست، که در تلاشند راه هدایت را به انسان‌ها نشان دهند."],[715,"زانچ کوه و سنگ درکار آمدند","می‌نشد بدبخت را بگشاده بند","بدبختی و مشکلات انسان را نمی‌توان با سنگ و کوه و سختی‌های طبیعی به راحتی حل کرد؛ چون سنگ و کوه فرقی نمی‌کنند و به حال کسی رحم نمی‌کنند. در واقع، این مشکلات نیاز به تلاش و تلاشی بیشتر دارند تا مشکلات انسانی را رفع کنند."],[715,"آنچنان دل‌ها که بدشان ما و من","نعتشان شدت بل اشد قسوة","دل‌های آنها که مبتلا به حب نفس و خودخواهی هستند، بسیار خشن و سخت-heartedند و بر اثر این صفت، حتی از حیوانات نیز بدترند."],[716,"چاره آن دل عطای مبدلیست","داد او را قابلیت شرط نیست","چاره دل، بخشش و عطای الهی است و این بخشش در تغییر و تبدیل دل‌ها به وجود می‌آید؛ بنابراین، نیازی به قابلیت انسان‌ها برای دریافت این بخشش نیست."],[716,"بلک شرط قابلیت داد اوست","داد لبّ و قابلیت هست پوست","بلکه شرط توانایی دریافت عطا (داد) از جانب خداوند است و در واقع، آنچه به عنوان جوهر اصلی (لبّ) عطا می‌شود، حقیقت است، در حالی که قابلیت فقط جنبه ظاهری و پوسته‌ای دارد."],[716,"اینک موسی را عصا ثعبان شود","هم‌چو خورشیدی کفش رخشان شود","عصای موسی هنگامی که به زمین افکنده می‌شود، به شکل ثعبان در می‌آید و این مانند درخشش خورشید است که نشان‌دهنده قدرت و معجزه الهی است."],[716,"صد هزاران معجزات انبیا","کآن نگنجد در ضمیر و عقل ما","معجزات بسیاری که پیامبران انجام داده‌اند، آن‌قدر عظمت دارند که نمی‌توانند در فهم و عقل ما جای بگیرند."],[716,"نیست، از اسباب تصریف خداست","نیستها را قابلیت از کجاست","قابلیت و توانایی موجودات به خواست و حکمت خدا وابسته است و هیچ عنصری بدون اراده او وجود ندارد. این قابلیت از کجا نشأت می‌گیرد؟"],[716,"قابلی گر شرط فعل حق بدی","هیچ معدومی به هستی نامدی","اگر قابلیت، شرط وجود فعل الهی (یعنی کارهای خدا) باشد، هیچ موجودی که وجود ندارد، به هستی نخواهد آمد."],[716,"سنتی بنهاد و اسباب و طرق","طالبان را زیر این ازرق تتق","خداوند یک قانون و روش معین برای کارهای خود قرار داده و امکانات و روش‌هایی برای جویندگان علم و حقیقت ایجاد کرده است، اما این مسأله را در نهایت تحت قدرت و حکمت خود قرار داده است."],[716,"بیشتر احوال بر سنت رود","گاه قدرت خارق سنّت شود","بیشتر وقایع طبق عادت و سنت پیش می‌روند، اما گاهی نیز قدرت خداوند می‌تواند قوانین طبیعی را بشکند و کارهای فوق‌العاده انجام دهد."],[716,"سنت و عادت نهاده با مزه","باز کرده خرق عادت معجزه","سنت و عادت از پیش در جهان قرار داده شده و به صورت عادی وجود دارد، اما خداوند به واسطه قدرت خود می‌تواند این عادات را شکسته و معجزه‌ای فراتر از آن‌ها خلق کند."],[716,"بی‌سبب گر عز به ما موصول نیست","قدرت از عزل سبب معزول نیست","اگر بدون دلیل و سبب به عزت و شرافت نرسیده‌ایم، این بدان معنا نیست که قدرت و توانایی در کنار گذاشتن سبب‌ها وجود ندارد."],[716,"ای گرفتار سبب بیرون مپر","لیک عزل آن مسبب ظن مبر","ای انسان، از وابستگی به سبب‌ها خارج نشوید، اما نباید گمان کنید که می‌توانید مسبب را از این ارتباط آزاد کنید."],[716,"هرچه خواهد آن مسبب آورد","قدرت مطلق سببها بردرد","هر چیزی که آن مسبب (خدا) بخواهد، قدرت مطلق او سبب‌ها را به انجام می‌رساند."],[716,"لیک اغلب بر سبب راند نفاد","تا بداند طالبی جستن مراد","بسیاری از افرادی که به دنبال هدف و خواسته‌های خود هستند، به طور معمول در پی علل و زمینه‌ها می‌گردند، تا بفهمند چگونه می‌توانند آنچه را می‌خواهند به دست بیاورند."],[716,"چون سبب نبود چه ره جوید مرید","پس سبب در راه می‌باید بدید","وقتی که هیچ دلیلی وجود ندارد، مرید (طلبه) چگونه می‌تواند راه را جست‌وجو کند؟ بنابراین، وجود دلیل و سبب در مسیر جست‌وجو اهمیت دارد."],[716,"این سببها بر نظرها پرده‌هاست","که نه هر دیدار صنعش را سزاست","این عوامل و وسایل، مانند پرده‌هایی هستند که بر چشم‌ها افتاده‌اند و باعث می‌شوند که همه‌کس نتواند زیبایی‌های آفرینش را به‌خوبی ببیند و درک کند."],[716,"دیده‌ای باید سبب سوراخ کن","تا حجب را برکند از بیخ و بن","برای دیدن حقایق و شناخت عمیق‌تر، باید به بینشی دست یابیم که موانع و پرده‌ها را از میان بردارد و به ریشه آن‌ها نفوذ کند."],[716,"تا مسبب بیند اندر لامکان","هرزه داند جهد و اکساب و دکان","هرگاه مسبب (خدایی که سبب‌ساز همه چیز است) در مکان‌های نامشخص (لامکان) را ببیند، هر چیزی را بی‌فایده و ضعیف می‌داند، زیرا تلاش و کارکرد انسان‌ها (اکساب و دکان) در برابر قدرت خدا ناچیز است."],[716,"از مسبب می‌رسد هر خیر و شر","نیست اسباب و وسایط ای پدر","هر خیرو شری که در دنیا وجود دارد، از خداوند ناشی می‌شود و تنها به وسایل و اسباب انسانی بستگی ندارد، ای پدر."],[716,"جز خیالی منعقد بر شاه‌راه","تا بماند دور غفلت چند گاه","جز یک خیال که در ذهن به وجود آمده و بر مسیر اصلی زندگی قرار دارد، چیز دیگری نیست که انسان را در دوری از حقیقت نگه دارد و برای مدتی او را در غفلت نگه‌دارد."],[717,"چونک صانع خواست ایجاد بشر","از برای ابتلای خیر و شر","زمانی که خداوند خواست انسان را بیافریند تا او را در آزمون خیر و شر قرار دهد."],[717,"جبرئیل صدق را فرمود رو","مشت خاکی از زمین بستان گرو","جبرئیل (فرشته وحی) به آدم گفت که مقداری خاک از زمین بردارد."],[717,"او میان بست و بیامد تا زمین","تا گزارد امر رب‌العالمین","جبرئیل (علیه‌السلام) بین آسمان و زمین قرار گرفت و به زمین آمد تا دستورات خداوند، پروردگار عالمیان، را اجرا کند."],[717,"دست سوی خاک برد آن مؤتمر","خاک خود را در کشید و شد حذر","فرشته جبرئیل دستش را به سمت خاک برد و مقداری از آن را برداشت، اما از این کار خودداری کرد و به نوعی احتیاط کرد."],[717,"پس زبان بگشاد خاک و لابه کرد","کز برای حرمت خلاق فرد","خاک شروع به صحبت کرد و از خود شکایت کرد که به خاطر عظمت و حرمت خالق یگانه (خداوند) به کمک او آمده و تحت فشار است."],[717,"ترک من گو و برو جانم ببخش","رو بتاب از من عنان خنگ رخش","از من جدا شو و برو، جانم را به کسی دیگر بده. از من دور شو و از این حال بی‌فکری و بلاگویی بگذر."],[717,"در کشاکشهای تکلیف و خطر","بهر لله هل مرا اندر مبر","در چالش‌ها و دشواری‌های مسئولیت و خطر، برای خداوند مرا از خود دور نکن."],[717,"بهر آن لطفی که حقت بر گزید","کرد بر تو علم لوح کل پدید","به خاطر لطفی که خداوند به تو عطا کرد، علم و معرفت تمامی موجودات و حقایق عالم به تو نمایان شد."],[717,"تا ملایک را معلم آمدی","دایما با حق مکلم آمدی","تو به عنوان معلم ملائکه، همیشه با خدا در مکالمه و ارتباط بوده‌ای."],[717,"که سفیر انبیا خواهی بدن","تو حیات جان وحیی نی بدن","اگر می‌خواهی سفیر انبیا (پیامبران) باشی، باید بدنت همچون جان وحی باشد و فقط جسم نباشی. این اشاره به اهمیت روح و پیام در کنار وجود مادی است."],[717,"بر سرافیلت فضیلت بود از آن","کو حیات تن بود تو آن جان","فضیلت تو به خاطر سر و شکل زیبا و شگفت‌انگیزت است، زیرا تو حیات و جان تازه‌ای برای بدن انسان هستی."],[717,"بانگ صورش نشات تن‌ها بود","نفخ تو نشو دل یکتا بود","صوت و صدای انسان‌ها به خاطر بدن است، اما دمیدن الهی، جان واحد را به وجود می‌آورد."],[717,"جان جان تن حیات دل بود","پس ز دادش داد تو فاضل بود","جان، مایه حیات و زنده‌ بودن تن است و دل نیز از آن زنده می‌شود. بنابراین، از آن چیزی که به انسان اهدا شده، حیات و فزونی برای او به وجود آمده است."],[717,"باز میکائیل رزق تن دهد","سعی تو رزق دل روشن دهد","میکائیل، فرشته‌ای که رزق جسمی را تأمین می‌کند، به تو رزق می‌دهد، اما تلاش تو، رزق معنوی و روشنی قلب را به همراه خواهد داشت."],[717,"او بداد کیل پر کردست ذیل","داد رزق تو نمی‌گنجد به کیل","جبرئیل به آدم گفت که کیلو (معیار) وجود او را پر کرده و در حقیقت رزق و نیاز تو با این معیار نمی‌تواند اندازه‌گیری شود. یعنی آنچه که خداوند برای تو فراهم کرده فراتر از هر اندازه و مقدار است."],[717,"هم ز عزرائیل با قهر و عطب","تو بهی چون سبق رحمت بر غضب","همچنان که عزرائیل (فرشته مرگ) با قهر و سختی می‌آید، تو به زیبایی و رحمت می‌آیی؛ مانند اینکه رحمت از غضب سبقت می‌گیرد."],[717,"حامل عرش این چهارند و تو شاه","بهترین هر چهاری ز انتباه","چهار موجود بزرگ که بار عرش الهی را به دوش می‌کشند، عزرائیل، جبرئیل، میکائیل و اسرافیل هستند و تو، یعنی آدم، بهترین و برترین آنها هستی. پیشرفت و مقام تو نسبت به این چهار فرشته، بسیار عالی و ممتاز است."],[717,"روز محشر هشت بینی حاملانش","هم تو باشی افضل هشت آن زمانش","روز قیامت را ببینی که حاملان عرش در آن روز چهارهستند و تو هم در آن زمان، بهترین و برترین آن‌ها خواهی بود."],[717,"هم‌چنین برمی‌شمرد و می‌گریست","بوی می‌برد او کزین مقصود چیست","جبرئیل همچنان به شمارش ادامه می‌داد و اشک می‌ریخت، زیرا او از بوی خاک آگاه بود و می‌دانست که این عمل به چه هدفی صورت می‌گیرد."],[717,"معدن شرم و حیا بد جبرئیل","بست آن سوگندها بر وی سبیل","جبرئیل که معدن شرم و حیا است، به خاطر سوگندهایی که یاد کرده بود، از انجام مأموریتش بازماند و نتوانست به خوبی به انجام وظیفه‌اش بپردازد."],[717,"بس که لابه کردش و سوگند داد","بازگشت و گفت یا رب العباد","جبرئیل (فرشته) آنقدر به خداوند دعا و درخواست کرد و قسم یاد کرد که درنهایت به درگاه خداوند بازگشت و گفت: ای پروردگار، تو خود می‌دانی."],[717,"که نبودم من به کارت سرسری","لیک زانچ رفت تو داناتری","من در کار تو بی‌توجه و سرسری نبوده‌ام، اما چون تو از من باهوش‌تر هستی، بهتر می‌دانی که چه باید کرد."],[717,"گفت نامی که ز هولش ای بصیر","هفت گردون باز ماند از مسیر","جبرئیل گفت که نامی وجود دارد که از بسیار ترس و وحشت آن، هفت آسمان (هفت گردون) از مسیر خود بازمانده‌اند و نمی‌توانند حرکت کنند."],[717,"شرمم آمد گشتم از نامت خجل","ورنه آسانست نقل مشت گل","از عظمت و مقام خداوند شرم کردم و احساس شرمندگی کردم که نام تو را ببرم، در حالی که صحبت درباره گل و خاک بسیار آسان است."],[717,"که تو زوری داده‌ای املاک را","که بدرانند این افلاک را","تو به این زمین و املاک قدرت و نیرویی داده‌ای که بتوانند با این آسمان‌ها و افلاک‌ها درگیر شوند."],[718,"گفت میکائیل را تو رو به زیر","مشت خاکی در ربا از وی چو شیر","میکائیل به خاک اشاره می‌کند و می‌گوید که از آن خاک که در زیر مشت است، همانند شیر که قوی و نیرومند است، باید برداشته شود. این خاک در واقع منبعی است که باید برای خلق آدم استفاده شود."],[718,"چونک میکائیل شد تا خاکدان","دست کرد او تا که برباید از آن","میکائیل (فرشته) وقتی به خاک‌دان نزدیک شد، دستش را در خاک فرستاد تا از آن خاک بیکاود و بردارد."],[718,"خاک لرزید و درآمد در گریز","گشت او لابه‌کنان و اشک‌ریز","خاک به لرزه درآمد و از زیر پای میکائیل فرار کرد، در حالی که او با ناله و اشک‌ریزی درخواست کرد."],[718,"سینه سوزان لابه کرد و اجتهاد","با سرشک پر ز خون سوگند داد","سینه‌اش در آتش سوخت و به زاری و تضرع پرداخت و با اشک‌هایی که مانند خون بود، سوگند یاد کرد."],[718,"که به یزدان لطیف بی‌ندید","که بکردت حامل عرش مجید","هیچ‌کس به خداوند لطیف و مهربان، به چشم خود نگاه نکرده است، جز آن‌که میکائیل، که نگهبان عرش بزرگ خداوند است، این کار را انجام داد."],[718,"کیل ارزاق جهان را مشرفی","تشنگان فضل را تو مغرفی","میکائیل، که برکات و روزی‌های جهان را توزیع می‌کند، به تشنگان و نیازمندان علم و فضل، کمک می‌کند و آن‌ها را سیراب می‌سازد."],[718,"زانک میکائیل از کیل اشتقاق","دارد و کیال شد در ارتزاق","چون میکائیل نامش از «کیل» به معنای اندازه‌گیری (که در اینجا به نوعی به عرضه و رزق اشاره دارد) گرفته شده، بنابراین او در تامین روزی و ارزاق نقش دارد و به همین دلیل به عنوان نماینده‌ی الهی در این زمینه شناخته می‌شود."],[718,"که امانم ده مرا آزاد کن","بین که خون‌آلود می‌گویم سخن","در این بیت، شخصی از خدا یا موجودی مقدس درخواست می‌کند که به او اجازه دهد آزاد شود و در حالی که غمگین و پریشان است، سخنانش را به صورت خون‌آلود (یعنی با شدت احساس و غم) بیان کند."],[718,"معدن رحم اله آمد ملک","گفت چون ریزم بر آن ریش این نمک","فرشته‌ای به نام میکائیل از سوی خداوند مأمور می‌شود تا خاکی از زمین برگیرد و بر ریش (یا مو) آدم (خلیفه خداوند) بپاشد، تا رحم و محبت الهی بر آن جاری شود."],[718,"هم‌چنانک معدن قهرست دیو","که برآورد از بنی آدم غریو","چنان‌که معدن خشم و قهر دیوان، فریاد و ناله از بنی آدم برمی‌آورد."],[718,"سبق رحمت بر غضب هست ای فتا","لطف غالب بود در وصف خدا","رحمت خداوند همیشه بر غضب او برتری دارد، ای جوان، و در توصیف خداوند، لطف و مهربانی‌اش بیشتر از خشم اوست."],[718,"بندگان دارند لابد خوی او","مشکهاشان پر ز آب جوی او","بندگان خدا به طور طبیعی دارای ویژگی‌های او هستند و دل‌هایشان از محبت و عطوفت او پر شده است."],[718,"آن رسول حق قلاوز سلوک","گفت الناس علی دین الملوک","آن پیامبر خدا که در مسیر سلوک و معنویت قرار دارد، می‌گوید که مردم بر اساس دین و باورهای شاهان و حاکمان زندگی می‌کنند."],[718,"رفت میکائیل سوی رب دین","خالی از مقصود دست و آستین","میکائیل به سوی خداوند رفت تا برای دین بدون هدف (دینی که کسی به آن عمل نمی‌کند) را به تصویر بکشد و دست و آستینش خالی بود، یعنی بدون هیچ‌گونه هدف و مقداری از عبادات و کارهای نیک."],[718,"گفت ای دانای سر و شاه فرد","خاک از زاری و گریه بسته کرد","میکائیل به خدا می‌گوید ای دانای اسرار و شاه بی‌همتا، من به خاطر زاری و گریه، خاک را جمع کرده‌ام."],[718,"آب دیده پیش تو با قدر بود","من نتانستم که آرم ناشنود","گریه و اشک من در برابر تو ارزش داشت، اما نتوانستم آن را به صدا درآورم و بگویم."],[718,"آه و زاری پیش تو بس قدر داشت","من نتانستم حقوق آن گذاشت","آه و ناله‌های من در نزد تو ارزش زیادی داشت، اما من نتوانستم آنچه را که شایسته آن بود ادا کنم و حق آن را بپردازم."],[718,"پیش تو بس قدر دارد چشم تر","من چگونه گشتمی استیزه‌گر","چشم من برای تو بسیار ارزشمند است، پس چگونه از تو درخواست کنم و التماس کنم؟"],[718,"دعوت زاریست روزی پنج بار","بنده را که در نماز آ و بزار","دعوت به زاری و دعا چیزی است که پنج بار در روز به بنده می‌گوید که در نماز حاضر شود و خود را تسلیم کند."],[718,"نعره مؤذن که حیا عل فلاح","وآن فلاح این زاری است و اقتراح","صدای مؤذن که مردم را به نماز و فلاح (رستگاری) دعوت می‌کند، نشان‌دهنده این است که این رستگاری در درخواست و زاری قلبی نهفته است."],[718,"آن که خواهی کز غمش خسته کنی","راه زاری بر دلش بسته کنی","اگر می‌خواهی کسی را که نگران و غمگین است، آرام کنی و غمش را از دلش بزدایی، باید با دلسوزی و احساسی نیکو به او نزدیک شوی و او را همراهی کنی."],[718,"تا فرو آید بلا بی‌دافعی","چون نباشد از تضرع شافعی","وقتی که بلا و گرفتاری به سراغ کسی بیاید و کسی نباشد که از او دفاع کند، به این معنی است که تضرع و درخواست کمک از خداوند، نیازی ضروری است."],[718,"وانک خواهی کز بلااش وا خری","جان او را در تضرع آوری","اگر می‌خواهی جان او را از بلا نجات دهی، باید با تضرع و گریه به دعا و درخواست از خدا بپردازی."],[718,"گفته‌ای اندر نبی که آن امتان","که بریشان آمد آن قهر گران","در این بیت به نبی (پیامبر) گفته می‌شود که اگر آن امت (قوم یا گروهی که به پیامبری خاص ایمان آورده‌اند) دچار عذاب و سختی شوند، این عذاب شدید و سنگین خواهد بود."],[718,"چون تضرع می‌نکردند آن نفس","تا بلا زیشان بگشتی باز پس","چون آن مردم از روی دل و تواضع نجوا و از خداوند درخواست نمی‌کردند، بلا و عذاب از آنان دور نمی‌شد."],[718,"لیک دلهاشان چون قاسی گشته بود","آن گنههاشان عبادت می‌نمود","اما دل‌های آنان به خاطر گناهانشان سخت و بی‌تاثیر شده بود و به همین خاطر عبادت آنها واقعی و همراه با خلوص نبود."],[718,"تا نداند خویش را مجرم عنید","آب از چشمش کجا داند دوید","تا زمانی که انسان خودش را گنهکار ندانسته و احساس مسئولیت نکند، نمی‌داند چرا اشک از چشمانش سرازیر می‌شود و در این حالت نمی‌تواند به رنج و ناراحتی‌اش پی ببرد."],[719,"قوم یونس را چو پیدا شد بلا","ابر پر آتش جدا شد از سما","زمانی که بلایی بر قوم یونس ظاهر شد، ابر آتشین از آسمان جدا و به زمین افتاد."],[719,"برق می‌انداخت می‌سوزید سنگ","ابر می‌غرید رخ می‌ریخت رنگ","در این بیت، آسمان در حال رعد و برق است و ابر در حال غرش و خروش می‌باشد، به‌طوری‌که جایی به شدت می‌سوزد و جایی دیگر رنگ آسمان به خاطر این وضعیت تغییر می‌کند. این توصیف، حال و هوای ترسناک و خطرناک را در زمان بروز بلا نشان می‌دهد."],[719,"جملگان بر بامها بودند شب","که پدید آمد ز بالا آن کرب","مردم همه بر بام‌ها بودند، شب که بر فراز، آن بلا (کرب) نمایان شد."],[719,"جملگان از بامها زیر آمدند","سر برهنه جانب صحرا شدند","مردم از بالای بام‌ها پایین آمدند و به‌طور بی‌پوشش و بی‌پناه به سمت بیابان رفتند."],[719,"مادران بچگان برون انداختند","تا همه ناله و نفیر افراختند","مادران کودکان را به بیرون فرستادند تا همه با صدای بلند ناله و فریاد کنند."],[719,"از نماز شام تا وقت سحر","خاک می‌کردند بر سر آن نفر","مردم از غم و اندوه شدید، از غروب تا سپیده‌دم بر سر خود خاک می‌پاشیدند و به زاری و عبادت مشغول بودند."],[719,"جملگی آوازها بگرفته شد","رحم آمد بر سر آن قوم لد","تمامی صداها و ناله‌های قوم یونس به‌سوی خدا بالا رفت و رحمت الهی به‌سوی آن قوم نازل شد."],[719,"بعد نومیدی و آه ناشکفت","اندک‌اندک ابر وا گشتن گرفت","بعد از ناامیدی و ناله‌های بی‌نتیجه، به تدریج ابر باران شروع به باز شدن و رهایی کرد."],[719,"قصه یونس درازست و عریض","وقت خاکست و حدیث مستفیض","داستان یونس (علیه‌السلام) بسیار طولانی و گسترده است و در زمان‌های گذشته، در دل خاک و سرزمین‌ها، به خوبی منتقل شده و معروف است."],[719,"چون تضرع را بر حق قدرهاست","وآن بها که آنجاست زاری را کجاست","تضرع و زاری در پیش خدا ارزش و مقام خاصی دارد، و این قدر و بها در آنجا (پیش خدا) مشخص است، اما زاری و گله‌کردن از سر بی‌پناهی و ناآگاهی، ثمره‌ای نخواهد داشت."],[719,"هین امید اکنون میان را چست بند","خیز ای گرینده و دایم بخند","ای انسانی که امیدوار هستی، اکنون وقت آن است که میان را محکم ببندی و برخواستن را فراموش نکنی؛ ای گریه‌کن، دائم بخند."],[719,"که برابر می‌نهد شاه مجید","اشک را در فضل با خون شهید","خدای بزرگ، اشک را که نشانه تضرع و درخواست از اوست، در نزد خود با خون شهید که نشان فداکاری و گذشت است، هم‌سطح و برابر می‌داند."],[720,"گفت اسرافیل را یزدان ما","که برو زان خاک پر کن کف بیا","خدا به اسرافیل گفت که از خاک زمین برگرفته و با دست خود آن را پر کند."],[720,"آمد اسرافیل هم سوی زمین","باز آغازید خاکستان حنین","اسرافیل به سمت زمین آمد و صدای حنین (نوای جان‌سوز) خاک را آغاز کرد."],[720,"کای فرشته صور و ای بحر حیات","که ز دمهای تو جان یابد موات","ای فرشته‌ای که صور را می‌زنی و ای منبع حیات که به وسیله دم‌های تو، چیزهای بی‌جان به زندگی می‌آیند."],[720,"در دمی از صور یک بانگ عظیم","پر شود محشر خلایق از رمیم","در لحظه‌ای، وقتی صور اسرافیل به صدا درآید، صدای بزرگ و رعب‌آوری به گوش می‌رسد و همه مردم در آن زمان از خاک برخیزند و محشر، یعنی روز قیامت، پر از جمعیت خواهد شد."],[720,"در دمی در صور گویی الصلا","برجهید ای کشتگان کربلا","در لحظه‌ای از دمیدن صور، گویی صدا به گوش می‌رسد که ای کشته‌شدگان کربلا، برخیزید."],[720,"ای هلاکت دیدگان از تیغ مرگ","برزنید از خاک سر چون شاخ و برگ","ای کسانی که با مرگ مواجه شده‌اید، از خاک برخیزید و مانند شاخ و برگ درختان، زندگی جدیدی را آغاز کنید."],[720,"رحمت تو وآن دم گیرای تو","پر شود این عالم از احیای تو","رحمت تو و آن لحظه جذب تو باعث می‌شود که این جهان با زندگی دوباره‌ات پر شود."],[720,"تو فرشته رحمتی رحمت نما","حامل عرشی و قبله دادها","تو فرشته رحمت هستی، پس به ما رحمت کن؛ تو کسی هستی که بار عرش را بر دوش داری و مقصود و کعبه انصاف و داد هستی."],[720,"عرش معدن گاه داد و معدلت","چار جو در زیر او پر مغفرت","عرش، محلی است که داد و عدالت در آنجا قرار دارد و چهار جریان (جو) از بخشش و مغفرت زیر آن جاری است."],[720,"جوی شیر و جوی شهد جاودان","جوی خمر و دجله آب روان","در بهشت خیالی، نهرهایی از شیر و عسل جاری است و نیز نهرهایی از شراب و رودخانه‌ای پرآب. این توصیف نشان‌دهنده نعمات و لذایذ ابدی است که در آن مکان وجود دارد."],[720,"پس ز عرش اندر بهشتستان رود","در جهان هم چیزکی ظاهر شود","پس از اینکه روح از عرش به بهشت می‌آید، در جهان نیز چیزهایی به صورت کوچک و ناپیدا نمایان خواهند شد."],[720,"گرچه آلوده‌ست اینجا آن چهار","از چه از زهر فنا و ناگوار","هرچند که این چهار عنصر (آب، باد، خاک، آتش) در اینجا آلوده و فاسد هستند، اما این آلودگی به خاطر زهر مرگ و بدبختی است."],[720,"جرعه‌ای بر خاک تیره ریختند","زان چهار و فتنه‌ای انگیختند","این چهار موجود (یا عناصر) جرعه‌ای از ماده‌ای بر خاک تیره ریختند که باعث به وجود آمدن هنگامه و شور و غوغا شد."],[720,"تا بجویند اصل آن را این خسان","خود برین قانع شدند این ناکسان","این افراد، که نادان و کم‌خبر هستند، به این نتیجه رسیده‌اند که همین مقدار از حقیقت کافی است و به دنبال اصل و اساس موضوع نمی‌روند."],[720,"شیر داد و پرورش اطفال را","چشمه کرده سینه هر زال را","شیر به خاطر پرورش و حمایت از کودکان، از سینه هر زال به دنیا آمده است."],[720,"خمر دفع غصه و اندیشه را","چشمه کرده از عنب در اجترا","شراب (خمر) برای رفع غم و خیال‌های پریشان، از انگور به‌دست آمده است."],[720,"انگبین داروی تن رنجور را","چشمه کرده باطن زنبور را","عسل، مایه شفای بدن بیمار را از درون زنبور تولید کرده است."],[720,"آب دادی عام اصل و فرع را","از برای طهر و بهر کرع را","آب، اصل و فرع (اجزا) را برای پاکی و طهارت می‌دهد و به رشد و نمو (کرع) کمک می‌کند."],[720,"تا ازینها پی بری سوی اصول","تو برین قانع شدی ای بوالفضول","تو از این موارد به دانش و حقایق عمیق‌تری پی خواهی برد، اما تو در همین سطح ساده که هستی راضی شده‌ای، ای کسی که خیلی سوال می‌پرسی و به جزئیات اهمیت می‌دهی."],[720,"بشنو اکنون ماجرای خاک را","که چه می‌گوید فسون محراک را","اکنون ماجرای خاک را بشنو که چه داستانی را در درون خود جا داده است. فسون محراق (محراک به معنی دشمن) به معنای جادوی خاصی است که در خاک وجود دارد و این ماجرا را شکل می‌دهد."],[720,"پیش اسرافیل‌گشته او عبوس","می‌کند صد گونه شکل و چاپلوس","اسرافیل، فرشته‌ای که وظیفه‌اش دمیدن در صور است، در مقابل آدم ابوالبشر با نگرانی و جدیت به شکل‌ها و حالت‌های مختلفی در می‌آید و تلاش می‌کند به ظاهر خود را زیبا و دلنشین نشان دهد."],[720,"که بحق ذات پاک ذوالجلال","که مدار این قهر را بر من حلال","به حقّ ذات پاک و باجلال خداوندی که محور و اساس این مسأله‌ی قهر و ناکامی را برای من حلال کرده است."],[720,"من ازین تقلیب بویی می‌برم","بدگمانی می‌دود اندر سرم","من از این تغییر و تحول در اوضاع بوی ناخوشی می‌گیرم و بدگمانی و نگرانی در ذهنم پرسه می‌زند."],[720,"تو فرشته رحمتی رحمت نما","زانک مرغی را نیازارد هما","تو ای فرشته رحمت، رحم کن و باران رحمت نازل کن، زیرا که پرنده‌ای را نباید آزار داد، حتی اگر آن پرنده بزرگ و زیبا باشد."],[720,"ای شفا و رحمت اصحاب درد","تو همان کن کان دو نیکوکار کرد","ای کسی که شفا و رحمت و التیام دهنده به اصحاب درد و رنج هستی، همان‌گونه عمل کن که آن دو نیکوکار عمل کردند."],[720,"زود اسرافیل باز آمد به شاه","گفت عذر و ماجرا نزد اله","اسرافیل، فرشته‌ای که وظیفه‌اش دمیدن در صور است، به زودی بازگشت و به شاه (خدا) گفت درباره عذر و ماجرایی که پیش آمده است."],[720,"کز برون فرمان بدادی که بگیر","عکس آن الهام دادی در ضمیر","خداوند دستور داده بود که از خارج، موجودیتی را بگیرید، اما در درون انسان، الهام و فکر معکوسی به او داده بود."],[720,"امر کردی در گرفتن سوی گوش","نهی کردی از قساوت سوی هوش","خدای متعال فرمودی که در گوش آدم، از محبت و نرم‌خویی بگیر و او را از خشونت و بی‌رحمی دور کن."],[720,"سبق رحمت گشت غالب بر غضب","ای بدیع افعال و نیکوکار رب","رحمت بر خشم غالب شد، ای خداوندی که کارهای نو و نیکو انجام می‌دهی."],[721,"گفت یزدان زود عزرائیل را","که ببین آن خاک پر تخییل را","خداوند به عزرائیل، فرشته‌ی مرگ، گفت که به زودی آن خاکی که پر از خیال و تصور است را ببین."],[721,"آن ضعیف زال ظالم را بیاب","مشت خاکی هین بیاور با شتاب","خدا به عزرائیل فرمان می‌دهد که آن جوان ضعیف و ناتوان را پیدا کند و با سرعت، کمی خاک بیاورد. این خاک قرار است به عنوان مایه‌ای برای تشکیل جسم آدمی استفاده شود."],[721,"رفت عزرائیل سرهنگ قضا","سوی کره خاک بهر اقتضا","عزرائیل، فرشته مرگ و نماینده قضا و قدر، به سوی زمین رفت تا خواسته‌ای را که لازم است انجام دهد."],[721,"خاک بر قانون نفیر آغاز کرد","داد سوگندش بسی سوگند خورد","خاک، طبق قوانینی که از قبل تعیین شده است، آماده آغاز کار خود می‌شود و به این موضوع قسم‌هایی می‌خورد."],[721,"کای غلام خاص و ای حمال عرش","ای مطاع الامر اندر عرش و فرش","ای بنده خاص و ای حامل عرش، ای صاحب فرمان در زمین و آسمان."],[721,"رو به حق رحمت رحمن فرد","رو به حق آنک با تو لطف کرد","به سوی خداوند رحمت و مهربانی برو، که او با تو احسان و لطف کرده است."],[721,"حق شاهی که جز او معبود نیست","پیش او زاری کس مردود نیست","خداوندی وجود دارد که هیچ معبودی جز او نیست و در پیشگاه او، درخواست و زاری هیچ کس رد نمی‌شود."],[721,"گفت نتوانم بدین افسون که من","رو بتابم ز آمر سر و علن","عزرائیل (فرشته مرگ) می‌گوید نمی‌توانم به این فریب (یعنی فریب‌کاری و دسیسه) ادامه دهم و از دستور (خدا) در آشکار و پنهان سرپیچی کنم."],[721,"گفت آخر امر فرمود او به حلم","هر دو امرند آن بگیر از راه علم","او (خدا) در نهایت دستور داد که با صبر و بردباری اقدام کن، زیرا هر دو دستور (عمل و صبر) را باید بر اساس علم و آگاهی دنبال کرد."],[721,"گفت آن تاویل باشد یا قیاس","در صریح امر کم جو التباس","عزیز درد و زحمت تاویل و قیاس را برای سخن صریح در نظر نگیر، یعنی در معنای واضح و روشن، ادعاهای پیچیده و مبهم نکن."],[721,"فکر خود را گر کنی تاویل به","که کنی تاویل این نامشتبه","اگر فکر خود را تأویل کنی، به چه کسی باید این نام روشن نشدنی را تأویل کنی؟"],[721,"دل همی‌سوزد مرا بر لابه‌ات","سینه‌ام پر خون شد از شورابه‌ات","بر اثر ناله‌ها و درخواست‌های تو، دل من بسیار می‌سوزد و سینه‌ام از غم و ناراحتی چنان پر از درد و خون شده که نمی‌توانم تحمل کنم."],[721,"نیستم بی‌رحم بل زان هر سه پاک","رحم بیشستم ز درد دردناک","من بی‌رحم نیستم، بلکه از روی پاکی و شفقت، نسبت به دردی که دردناک است، رحمت می‌ورزم."],[721,"گر طبانجه می‌زنم من بر یتیم","ور دهد حلوا به دستش آن حلیم","اگر من به یتیم کمک می‌کنم و او را تشویق به تلاش می‌کنم، حتی اگر او در حال حاضر چیزی خوشمزه مانند حلوا به دست آورد، باید بداند که این به‌دست‌آوردن، به خاطر زحمت و همت اوست."],[721,"این طبانجه خوشتر از حلوای او","ور شود غره به حلوا وای او","این طبانجه (به معنای نوازش یا دلسوزی) از حلوا برای یتیم بهتر است، زیرا اگر به حیله‌گری به خوردن حلوا دلخوش شود، به عاقبت بدی دچار خواهد شد."],[721,"بر نفیر تو جگر می‌سوزدم","لیک حق لطفی همی‌آموزدم","من به فریاد تو سوز دل داشتم و در عین حال، از خداوند یاد می‌گرفتم که چگونه لطف و رحمتش را نشان دهم."],[721,"لطف مخفی در میان قهرها","در حدث پنهان عقیق بی‌بها","لطف و رحمت خداوند در دل قهر و سختی‌ها پنهان است و مانند عقیقی قیمتی که درون سنگی پنهان است، باید جست‌وجو شود تا نمایان گردد."],[721,"قهر حق بهتر ز صد حلم منست","منع کردن جان ز حق جان کندنست","قهر و غضب خداوندی نزد مولانا از صدها عذر و بخشش انسانی بهتر است؛ زیرا جلوگیری از جان، به معنای جدایی از حقیقت و خداوند است و این جدایی قابل تحمل نیست."],[721,"بدترین قهرش به از حلم دو کون","نعم رب‌العالمین و نعم عون","بدترین خشم خدا از صبر و بردباری دو جهان بهتر است؛ او همان پروردگار است و بهترین یاری‌دهنده."],[721,"لطف‌های مضمر اندر قهر او","جان سپردن جان فزاید بهر او","لطف‌هایی که در دل قهر او نهفته است، باعث می‌شود که جان انسان با پذیرش آن قهر، روز به روز بیشتر شود و زنده‌تر گردد."],[721,"هین رها کن بدگمانی و ضلال","سر قدم کن چونک فرمودت تعال","بدگمانی و گمراهی را رها کن و قدم به جلو بگذار، زیرا او (خدا) به تو فرمود که بالا برو."],[721,"آن تعال او تعالی‌ها دهد","مستی و جفت و نهالی‌ها دهد","خداوند برتر، به انسان حالتی مستی‌آور و نعمت‌هایی همچون همسر و زندگی جدید می‌بخشد."],[721,"باری آن امر سنی را هیچ‌هیچ","من نیارم کرد وهن و پیچ‌پیچ","من نمی‌توانم آن امر مهم و مقدس را به‌کلی دست کم بگیرم یا به آن بی‌احترامی کنم."],[721,"این همه بشنید آن خاک نژند","زان گمان بد بدش در گوش بند","این خاک نژند (پست) همه این صحبت‌ها را شنید و از اینکه به او به عنوان یک چیز کم‌ارزش نگاه می‌شود، احساس بدی پیدا کرد."],[721,"باز از نوعی دگر آن خاک پست","لابه و سجده همی‌کرد او چو مست","خاک کم‌ارزش و پست دوباره به نوعی دیگر ناله و سجده می‌کند، چون شخص مست و سرمست، به دنبال پذیرش و خدایی است."],[721,"گفت نه برخیز نبود زین زیان","من سر و جان می‌نهم رهن و ضمان","عزرائیل (فرشته مرگ) می‌گوید که از این آسیب و دشواری نباید بلند شد و از آن فریب و دام فرار کرد، زیرا من جان و سرم را به عنوان ضمانت و وثیقه می‌دهم."],[721,"لابه مندیش و مکن لابه دگر","جز بدان شاه رحیم دادگر","نگران مباش و غیر از آن هیچ نکن، جز برای آن پادشاه رحیم و دادگر."],[721,"بنده فرمانم نیارم ترک کرد","امر او کز بحر انگیزید گرد","من نمی‌توانم از فرمان خداوند تخلف کنم و اگر چنین کنم، مانند گردی هستم که از دریا برانگیخته شده و به بی‌هدفی سرگردانم."],[721,"جز از آن خلاق گوش و چشم و سر","نشنوم از جان خود هم خیر و شر","جز از آن خالق، هیچ چیز دیگری را نه می‌شنوم و نه می‌بینم، حتی از جان خودم هم خیر و شر را درک نمی‌کنم."],[721,"گوش من از گفت غیر او کرست","او مرا از جان شیرین جان‌ترست","گوش من از سخنان دیگران ناشنواست و فقط از سخن او می‌شنوم، زیرا او برای من از جان شیرینم عزیزتر است."],[721,"جان ازو آمد نیامد او ز جان","صدهزاران جان دهم او رایگان","جان انسان از او (خدا) آمده است و نه اینکه او از جان ناشی شده باشد. به همین دلیل، اگر صدهزاران جان هم داشته باشم، آن را به او می‌دهم بدون اینکه چیزی بخواهم."],[721,"جان کی باشد کش گزینم بر کریم","کیک چه بود که بسوزم زو گلیم","جان چه کسی است که من برای او کریم را انتخاب کنم؟ آیا چه چیزی وجود دارد که من از حرص و طمع برای آن بسوزم؟"],[721,"من ندانم خیر الا خیر او","صم و بکم و عمی من از غیر او","من هیچ خوبی را جز خوبی او نمی‌شناسم؛ او نابینا، ناشنوا و لال است و من از غیر او چیزی نمی‌دانم."],[721,"گوش من کرّست از زاری‌کنان","که منم در کف او هم‌چون سنان","گوش من به دلیل ناله‌ و زاری کردن‌ها، ناگفته و نادیده است و نمی‌تواند بشنود. من در دست او هستم، به‌طوریکه مانند سنان (پیکان) در دست کمان‌دار قرار دارم و به او وابسته‌ام."],[722,"احمقانه از سنان رحمت مجو","زان شهی جو کان بود در دست او","نابخردانه از ابزار رحمت الهی توقع نداشته باش، زیرا آن شرابی که تو می‌خواهی در دست اوست، در حقیقت شایسته‌ی تو نیست."],[722,"با سنان و تیغ لابه چون کنی","کو اسیر آمد به دست آن سنی","اگر با تیر و شمشیر تلاش کنی، چه فایده دارد؟ زیرا کسی که به دست آن سنّی (مؤمن) اسیر شده، دیگر کار او تمام است."],[722,"او به صنعت آزرست و من صنم","آلتی کو سازدم من آن شوم","من به دست آزر (پدر ابراهیم) ساخته شده‌ام و او (آزر) به عنوان صنعتگر خود را نشان می‌دهد، اما من که به عنوان تندیس (صنم) ساخته‌ام، در حقیقت آنچه ساخته شده‌ام نمی‌توانم باشم."],[722,"گر مرا ساغر کند ساغر شوم","ور مرا خنجر کند خنجر شوم","اگر مرا به جام شراب ساغر بدهد، به حالت شاداب و سرمست در می‌آیم، و اگر مرا با خنجر بزند، به حالت زخمی و آسیب‌دیده درمی‌آیم."],[722,"گر مرا چشمه کند آبی دهم","ور مرا آتش کند تابی دهم","اگر مرا به حالت چشمه بسازد، آبی به دیگران می‌دهم و اگر مرا به حالت آتش درآورد، تندی و حرارت می‌دهم."],[722,"گر مرا باران کند خرمن دهم","ور مرا ناوک کند در تن جهم","اگر مرا باران بدهد، محصول و خرمن خوبی به شما می‌دهم، و اگر مرا با تیر بزند، در بدنم به شدت آسیب می‌زنم."],[722,"گر مرا ماری کند زهر افکنم","ور مرا یاری کند خدمت کنم","اگر به من آسیب برساند، پاسخ آن را با زهر می‌دهم و اگر به من کمکی کند، خدمتش را می‌کنم."],[722,"من چو کلکم در میان اصبعین","نیستم در صف طاعت بین‌بین","من مانند شما نیستم که در میان دو انگشت باشم و در صف اطاعت قرار بگیرم. مالیخولیا و وابستگی به مخلوقات ندارم."],[722,"خاک را مشغول کرد او در سخن","یک کفی بربود از آن خاک کهن","او خاک را در سخن به خودش مشغول کرده و با یک دست خود از آن خاک کهن، کفی را برداشت. این اشاره به این دارد که او (خدا یا حقیقت) از این دنیای مادی و خاکی، توجه و افکار را می‌گیرد و با کلامش معنای عمیق‌تری را به وجود می‌آورد."],[722,"ساحرانه در ربود از خاکدان","خاک مشغول سخن چون بی‌خودان","سخنگویی که به طور جادوئی از خاک برمی‌خیزد، همچون افرادی است که در حالتی غیرعادی و نشئه‌وار در حال صحبت هستند، در حالی که خودشان از این حالت غافلند."],[722,"برد تا حق تربت بی‌رای را","تا به مکتب آن گریزان پای را","تا زمانی که حق را به خاطر عدم اندیشه‌ی صحیح نادیده می‌گیری، به‌سختی می‌توانی از آن فرار کنی یا به مکتب عشق که محل یادگیری و رشد روحی است، راه پیدا کنی."],[722,"گفت یزدان که به علم روشنم","که تو را جلاد این خلقان کنم","خداوند می‌گوید که من به علم و دانایی خود آگاه هستم و می‌دانم که من تو را به دست این مردم سخت‌گیر و بی‌رحم گرفتار می‌کنم."],[722,"گفت یا رب دشمنم گیرند خلق","چون فشارم خلق را در مرگ حلق","خدایا، وقتی که دشمنانم مرا تحت فشار قرار می‌دهند، آیا خلق تو من را در حال مرگ درمی‌آورند؟"],[722,"تو روا داری خداوند سنی","که مرا مبغوض و دشمن‌رو کنی؟","آیا تو، ای خداوند بزرگ، می‌پذیری که مرا به عنوان دشمن و مورد نفرت قرار دهی؟"],[722,"گفت اسبابی پدید آرم عیان","از تب و قولنج و سرسام و سنان","می‌گوید که من به‌وضوح علل و عواملی را نشان می‌دهم که باعث بیماری‌هایی مانند تب، قولنج، سرسام و درد دندان می‌شوند."],[722,"که بگردانم نظرشان را ز تو","در مرض‌ها و سبب‌های سه‌تو","من می‌خواهم توجه مخاطبان را از بیماری‌ها و علل ظاهری به سوی خودت، یعنی خدا، معطوف کنم."],[722,"گفت یا رب بندگان هستند نیز","که سبب‌ها را بدرند ای عزیز","ای خدا، بندگانی وجود دارند که به دنبال علل و اسباب می‌گردند و آن‌ها را مورد بررسی قرار می‌دهند، ای عزیز."],[722,"چشمشان باشد گذاره از سبب","در گذشته از حجب از فضل رب","چشم‌های آنها فقط به علل ظاهری توجه دارند و از پرده‌های غفلت و نعمت‌های خداوند فراتر نمی‌روند."],[722,"سرمه توحید از کحال حال","یافته رسته ز علت و اعتلال","اصل توحید به‌عنوان حقیقتی ناب و خالص، مانند سرمه‌ای است که از کحالی بهشتی بیرون آمده و از همه عیوب و علل دور است."],[722,"ننگرند اندر تب و قولنج و سل","راه ندهند این سببها را به دل","به دردها و مشکلاتی همچون تب و قولنج (دردهای شدید و ناتوان‌کننده) نباید توجه کرد و نباید اجازه داد که این مسائل در دل انسان راه یابند."],[722,"زانک هر یک زین مرضها را دواست","چون دوا نپذیرد آن فعل قضاست","هر یک از این بیماری‌ها درمانی دارد، اما اگر بیمار درمان را نپذیرد، این ناشی از تقدیر و قضا و قدر است."],[722,"هر مرض دارد دوا می‌دان یقین","چون دوای رنج سرما پوستین","هر بیماری درمانی دارد، این را می‌دانم. مانند درمان درد سرما که پوشیدن پوستین است."],[722,"چون خدا خواهد که مردی بفسرد","سردی از صد پوستین هم بگذرد","زمانی که خدا بخواهد که شخصی به مرگ دچار شود، او حتی از صد لایه لباس گرم هم عبور خواهد کرد."],[722,"در وجودش لرزه‌ای بنهد که آن","نه به جامه به شود نه از آشیان","آنقدر در وجود او قدرت و تسلطی ایجاد می‌شود که نه به لباس و پوشش او مرتبط است و نه به جایی که زندگی می‌کند، بلکه این لرزه از حقیقت و باطن او سرچشمه می‌گیرد."],[722,"چون قضا آید طبیب ابله شود","وان دوا در نفع هم گمره شود","وقتی قضا و سرنوشت پیش می‌آید، حتی پزشک بی‌خرد نیز به بیهودگی تبدیل می‌شود و دارویی که برای درمان تجویز کرده، برای بیمار نتیجه‌ای معکوس و ضرر دارد."],[722,"کی شود محجوب ادراک بصیر","زین سببهای حجاب گول‌گیر","چگونه ممکن است کسی که بینایی دارد، از درک حقایق محجوب و پنهان بماند؟ این به خاطر عواملی است که او را فریب می‌دهد و مانع از دیدن واقعیت می‌شود."],[722,"اصل بیند دیده چون اکمل بود","فرع بیند چونک مرد احول بود","آنگاه که بینایی کسی کامل باشد، او حقیقت را می‌بیند و درک می‌کند، اما اگر بینایی او ناقص باشد، فقط ظاهریات را خواهد دید مانند فردی که بینایی‌اش ضعیف است و نمی‌تواند چیزها را به درستی تشخیص دهد."],[723,"گفت یزدان آنک باشد اصل دان","پس ترا کی بیند او اندر میان","خداوند می‌فرماید که اگر کسی اصل و ریشه‌ی وجودش را بداند، چگونه ممکن است او را در دل خود ببیند؟ یعنی در حقیقت، شناخت عمیق از خویشتن و ارتباط با خداوند، راهی برای درک و مشاهده‌ی اوست."],[723,"گرچه خویش از عامه پنهان کرده‌ای","پیش روشن‌دیدگان هم پرده‌ای","هرچند که خودت را از مردم عادی پنهان کرده‌ای، اما روشن دیدگان هم پرده ی تو هستند"],[723,"وانک ایشان را شکر باشد اجل","چون نظرشان مست باشد در دول","اگر مرگ آن‌ها را به شکر و سپاس وادار کند، این به دلیل آن است که آن‌ها در حالتی مست و سرمست از نعمت‌ها و خوشی‌های زندگی هستند."],[723,"تلخ نبود پیش ایشان مرگ تن","چون روند از چاه و زندان در چمن","مرگ بدن برای آنان تلخ نیست، چون مانند کسی است که از چاه یا زندان بیرون می‌آید و به باغ خوشبختی وارد می‌شود."],[723,"وا رهیدند از جهان پیچ‌پیچ","کس نگرید بر فوات هیچ هیچ","آن‌ها از این دنیای پرپیچ‌وخم رهایی یافته‌اند و هیچ‌کس بر فقدان آن‌ها غمگین نیست."],[723,"برج زندان را شکست ار کانی‌ای","هیچ ازو رنجد دل زندانی‌ای؟","اگر زندانی در زندان رنج می‌کشد، آیا به خاطر اینکه دیوارهای آن زندان را شکسته‌ای، نمی‌خواهی که او هم از این رنج رهایی یابد؟"],[723,"کای دریغ این سنگ مرمر را شکست","تا روان و جان ما از حبس رست","ای کاش این سنگ مرمر (که نماد سختی و محدودیت است) شکسته می‌شد تا روح و جان ما از قفس زندان رهایی یابد."],[723,"آن رخام خوب و آن سنگ شریف","برج زندان را بهی بود و الیف","آن سنگ مرمری که نمایانگر زندان است، در واقع زیبا و ارزشمند است، اما به دلیل آنکه در پشت آن روح و جان ما حبس شده، دیگر این زیبایی را ندارد."],[723,"چون شکستش تا که زندانی برست","دست او در جرم این باید شکست","وقتی کسی در زندان به خاطر جرم خود باید مجازات شود، تا زمانیکه محاکمه‌اش نکنند و حکم او صادر نگردد، نمی‌تواند آزاد شود. این نشان‌دهنده این است که گاهی انسان موظف به تحمل سختی‌ها و مشکلاتی است تا در نهایت به آزادی برسد."],[723,"هیچ زندانی نگوید این فشار","جز کسی کز حبس آرندش به دار","هیچ زندانی نمی‌تواند از فشار و سختی خود بگوید، مگر کسی که او را از بند رها کند."],[723,"تلخ کی باشد کسی را کش برند","از میان زهر ماران سوی قند","هیچ‌کس نمی‌تواند در عالم تلخی، از میان زهر و بدبختی، به سمت شیرینی و خوشی برود، مگر آنکه او را از این شرایط تلخ برهانند."],[723,"جان مجرد گشته از غوغای تن","می‌پرد با پر دل بی‌پای تن","جان، که به‌طور جدا از مشکلات و بی‌حوصلگی‌های بدن است، با شادابی و آزادی خیال، به سوی عالم بالاتر پرواز می‌کند و از قید و بندهای جسم رهایی می‌یابد."],[723,"هم‌چو زندانی چه که اندر شبان","خسپد و بیند به خواب او گلستان","شخص زندانی مانند کسی است که در خواب، باغی پر از گل را می‌بیند؛ او به دلیل زندانی بودن، نمی‌تواند به آن باغ واقعی برسد و فقط در خواب می‌تواند آن را تجربه کند."],[723,"گوید ای یزدان مرا در تن مبر","تا درین گلشن کنم من کرّ و فر","مولانا در این بیت از خدا می‌خواهد که جان او را از جسمش جدا نکند تا بتواند در این باغ زندگی به فعالیت و تلاش بپردازد."],[723,"گویدش یزدان دعا شد مستجاب","وا مرو؛ والله اعلم بالصواب","خداوند می‌گوید: دعا به اجابت رسید و نرو، زیرا خداوند به حقیقت و درست بودن امور آگاه‌تر است."],[723,"این چنین خوابی ببین چون خوش بود","مرگ نادیده به جنت در رود","اگر خواب خوشی ببینی، مرگ نادیدۀ تو باعث می‌شود که به بهشت وارد شوی."],[723,"هیچ او حسرت خورد بر انتباه","بر تن با سلسله در قعر چاه","او هیچ گونه حسرتی بر بیدار شدن از خواب ندارد؛ چون به جسمش، که به زنجیر مشکلات در قعر چاه گرفتار شده، نگاه می‌کند و از آن ناراحت نیست."],[723,"مؤمنی آخر در آ در صف رزم","که تو را بر آسمان بودست بزم","مؤمنی در آخر صف رزم حضور دارد، در حالی که تو را در آسمان، در جایی که بزم و شادی است، مشاهده می‌شود."],[723,"بر امید راه بالا کن قیام","هم‌چو شمعی پیش محراب ای غلام","ای غلام، به امید صعود و پیشرفت قیام کن، مانند شمعی که در برابر محراب قرار دارد و روشنایی می‌بخشد."],[723,"اشک می‌بار و همی‌سوز از طلب","هم‌چو شمع سربریده جمله شب","از شدت خواستن و جستجوی معشوق، مانند شعله‌ای که از عدم دستیابی به آن خاموش شده، اشک می‌ریزم و درونم می‌سوزد، همان‌طور که شمعی که سرش بریده شده، در تمام شب می‌سوزد."],[723,"لب فرو بند از طعام و از شراب","سوی خوان آسمانی کن شتاب","خودتان را از خوراک و نوشیدنی‌های دنیوی بازدارید و به سرعت به سوی سفره‌ای که در آسمان معین شده بروید."],[723,"دم به دم بر آسمان می‌دار امید","در هوای آسمان رقصان چو بید","هر لحظه به آسمان امیدوار باش و به آنجا نگاه کن، مانند بیدی که در هوا در حال رقص و جنب و جوش است."],[723,"دم به دم از آسمان می‌آیدت","آب و آتش رزق می‌افزایدت","هر لحظه از آسمان به تو نعمت‌های گوناگون مانند آب و آتش می‌رسد، که این‌ها مایه‌ی برکت و افزایش روزی تو هستند."],[723,"گر تو را آنجا برد نبود عجب","منگر اندر عجز و بنگر در طلب","اگر تو در آنجا چیزی نداشته باشی، نباید از بی‌کسی سرزنش کنی، بلکه باید ناتوانی خود را کنار بگذاری و به جستجوی خواسته‌ات بپردازی."],[723,"کین طلب در تو گروگان خداست","زانک هر طالب به مطلوبی سزاست","این تمایل و جستجو در تو، در واقع هدیه و امانت خداوند است. زیرا هر کسی که به دنبال چیزی می‌گردد، به آنچه که شایسته‌اش است، خواهد رسید."],[723,"جهد کن تا این طلب افزون شود","تا دلت زین چاه تن بیرون شود","تلاش کن تا این خواسته و آرزو در تو بیشتر شود تا اینکه دل‌خوشی و آرامش‌ات از مشغله‌های بدنی و مادی آزاد شود."],[723,"خلق گوید مرد مسکین آن فلان","تو بگویی زنده‌ام ای غافلان","مردم درباره او می‌گویند که مسکین و بیچاره است، اما او به آن‌ها می‌گوید که من زنده‌ام و شما غافلید از این حقیقت."],[723,"گر تن من هم‌چو تن‌ها خفته است","هشت جنت در دلم بشکفته است","هرچند بدن من مانند بدن‌های دیگر خوابیده است، اما در درون من هشت بهشت شکفته و آماده است."],[723,"جان چو خفته در گل و نسرین بود","چه غمست ار تن در آن سرگین بود","اگر روح در زینت‌های گل و نسرین هم خواب باشد، چه اهمیتی دارد اگر جسم در خاک و سرگین (خاک گندیده) باشد؟"],[723,"جان خفته چه خبر دارد ز تن","کو به گلشن خفت یا در گولخن","جان بی‌خبر از حال تن است که یا در باغ گل خوابیده یا در گودال به سر می‌برد."],[723,"می‌زند جان در جهان آبگون","نعره یا لیت قومی یعلمون","جان در این جهان گویی به صدا درآمده و فریاد می‌زند که ای کاش قوم من می‌دانستند و آگاهی داشتند. این ندا نشان‌دهنده‌ی غم و اندوه جان از بی‌خبری مردم درباره‌ی حقیقت‌ها و مسایل عمیق زندگی است."],[723,"گر نخواهد زیست جان بی این بدن","پس فلک ایوان کی خواهد بدن","اگر جان نخواهد بدون این بدن زندگی کند، پس آسمان (فلک) چه نیازی به بدن دارد؟"],[723,"گر نخواهد بی‌بدن جان تو زیست","فی السماء رزقکم روزی کیست","اگر جان تو نمی‌تواند بدون بدن زندگی کند، پس روزی شما در آسمان بر عهده کیست؟"],[724,"وا رهی زین روزی ریزه کثیف","در فتی در لوت و در قوت شریف","این بیت به این معناست که ای جوان، از این روزی‌های ناپاک و جزئی دور شو، زیرا که تو در چنین روزی به خوشی و نعمت واقعی دست نخواهی یافت."],[724,"گر هزاران رطل لوتش می‌خوری","می‌روی پاک و سبک هم‌چون پری","هرچقدر هم که از این نعمت‌های دنیوی بخوری و سیر باشی، در نهایت روح تو مانند پری پاک و سبک خواهد شد."],[724,"که نه حبس باد و قولنجت کند","چارمیخ معده آهنجت کند","نه نگه‌داشتن باد در شکم باعث بروز درد و قولنج می‌شود و نه پیکر تو را به شدت رنج می‌دهد."],[724,"گر خوری کم گرسنه مانی چو زاغ","ور خوری پر گیرد آروغت دماغ","اگر کم بخوری، مثل زاغ همیشه گرسنه باقی می‌مانی و اگر زیاد بخوری، معده‌ات پر می‌شود و بر زحمتت افزوده می‌گردد."],[724,"کم خوری خوی بد و خشکی و دق","پر خوری شد تخمه را تن مستحق","کم خوردن باعث می‌شود که انسان از رفتار و خوی بد دور بماند و زندگی‌اش دیده می‌شود؛ ولی اگر افراط در خوردن کند، به حدی می‌رسد که به خاطر زیاد خوردن بدنش دچار مشکلات می‌شود و مستحق درد و رنج می‌گردد."],[724,"از طعام الله و قوت خوش‌گوار","بر چنان دریا چو کشتی شو سوار","از نعمت‌های خداوند و غذای خوشمزه‌ای که او داده، همچون کشتی‌ای در دریای وسیع زندگی سوار شو و از آن استفاده کن."],[724,"باش در روزه شکیبا و مصر","دم به دم قوت خدا را منتظر","در روزه، صبور باش و همیشه آماده دریافت نعمت‌های خداوند باش."],[724,"که آن خدای خوب‌کار بردبار","هدیه‌ها را می‌دهد در انتظار","خدای مهربان و بردبار، نعمت‌ها و هدیه‌هایش را به کسانی که صبر و انتظار می‌کشند، عطا می‌کند."],[724,"انتظار نان ندارد مرد سیر","که سبک آید وظیفه یا که دیر","مرد سیر (سیر از غذا) نیازی به انتظار نان ندارد، چون وقتی سیر است، بار مسئولیت یا وظیفه را سبک‌تر احساس می‌کند و به تأخیر در غذا فکر نمی‌کند."],[724,"بی‌نوا هر دم همی گوید که کو","در مجاعت منتظر در جست و جو","بی‌چاره هر لحظه می‌گوید که کی خواهد آمد، در حالی که به خاطر گرسنگی و نیازش در جستجوی غذاست."],[724,"چون نباشی منتظر ناید به تو","آن نواله دولت هفتاد تو","اگر منتظر نباشی، آن نعمت بزرگ و فراوانی که منتظرش هستی، به سوی تو نخواهد آمد."],[724,"ای پدر الانتظار الانتظار","از برای خوان بالا مردوار","ای پدر، انتظار و امیدواری برای رسیدن به خوان نعمت و فرود عالی، به مانند انتظار برای مردی است که در زندگی‌اش در جستجوی نعمت‌هاست."],[724,"هر گرسنه عاقبت قوتی بیافت","آفتاب دولتی بر وی بتافت","هر گرسنه‌ای در نهایت به غذایی دست پیدا می‌کند و خورشید سعادت بر او می‌تابد."],[724,"ضیف با همت چو ز آشی کم خورد","صاحب خوان آش بهتر آورد","اگر مهمان با شخصیت و همت باشد و از غذا به مقدار کم تناول کند، صاحب خانه برای او غذای بهتر و بیشتری می‌آورد."],[724,"جز که صاحب خوان درویشی لئیم","ظن بد کم بر به رزاق کریم","تنها صاحب خوان، درویش بدذات و خسیس است، که بر خداوند بخشنده و کریم بدگمانی دارد."],[724,"سر برآور هم‌چو کوهی ای سند","تا نخستین نور خور بر تو زند","ای سند (موجودی در مرتبه‌ای والا) باید مانند کوهی سر بلند کنی تا نخستین نور خورشید، یعنی روشنایی و حقیقت، بر تو بتابد."],[724,"که آن سر کوه بلند مستقر","هست خورشید سحر را منتظر","سر کوه بلند، نقطه‌ای است که خورشید صبح به آن تابیده می‌شود و در واقع، این سر کوه همیشه در انتظار نور خورشید است."],[725,"آن یکی می‌گفت خوش بودی جهان","گر نبودی پای مرگ اندر میان","یکی از افراد می‌گفت که اگر مرگ در دنیا وجود نداشت، زندگی خوشایندتر و بهتر بود."],[725,"آن دگر گفت ار نبودی مرگ هیچ","که نیرزیدی جهان پیچ‌پیچ","دیگری گفت اگر مرگ وجود نداشت، هیچ چیز این جهان ارزش نداشت و درواقع پیچیدگی‌های آن بی‌معنی می‌شد."],[725,"خرمنی بودی به دشت افراشته","مهمل و ناکوفته بگذاشته","شما مانند خوشه‌ای از غلات هستید که در دشت بلند و سرسبز قرار دارد، اما به خاطر نداشتن ارزش و کارایی، بدون هیچ استفاده‌ای رها شده‌اید."],[725,"مرگ را تو زندگی پنداشتی","تخم را در شوره خاکی کاشتی","تو مرگ را به عنوان زندگی تصور کردی و در خاک شوره، تخم (زندگی جدید) را کاشتی."],[725,"عقل کاذب هست خود معکوس‌بین","زندگی را مرگ بیند ای غبین","عقل ناراست و نادرست باعث می‌شود که انسان زندگی را به شکل معکوس ببیند و مرگ را در نظر بگیرد. این گونه است که او (عقل کاذب) به زندگی به دیدی غمناک و منفی نگاه می‌کند."],[725,"ای خدا بنمای تو هر چیز را","آنچنان که هست در خدعه‌سرا","ای خدا، به من نشان بده هر چیزی را به همان شکلی که واقعا هست، نه به صورت فریبنده و گمراه‌کننده."],[725,"هیچ مرده نیست پر حسرت ز مرگ","حسرتش آنست کش کم بود برگ","هیچ فرد مرده‌ای نیست که به خاطر مرگ حسرت بخورد، زیرا حسرت او به خاطر این است که از عمرش چیزی کم نشده و برگش (شکل و زندگی‌اش) به پایان نرسیده است."],[725,"ورنه از چاهی به صحرا اوفتاد","در میان دولت و عیش و گشاد","اگر کسی از چاهی به دشت بیفتد، به رغم این که در دل آنجا امکانات و خوشی‌های زیادی وجود دارد، احساس خوشبختی نمی‌کند."],[725,"زین مقام ماتم و ننگین مناخ","نقل افتادش به صحرای فراخ","از این مقام سوگواری و حال ننگین، او به فضای وسیع و آزاد منتقل شده است."],[725,"مقعد صدقی نه ایوان دروغ","باده خاصی نه مستیی ز دوغ","مقام صدق و راستین، نه جایگاهی بی‌اساس و نامعتبر است. مستی‌ای که از شادی و لذت خالص و حقیقی حاصل می‌شود، نه از شراب و نوشیدن دوغ که نشان‌دهنده بی‌خود شدن از خلسه‌های دروغین باشد."],[725,"مقعد صدق و جلیسش حق شده","رسته زین آب و گل آتشکده","مقام صدق، که جایی است واقعی و راستین، به دوستی با حقیقت رسیده و از این جسم و خاک جدا شده است و به دنیای واقعی و معنوی تبدیل شده است."],[725,"ور نکردی زندگانی منیر","یک دو دم ماندست مردانه بمیر","اگر زندگی‌ات روشن و با معنا نیست، بهتر است که حتی یک دم هم زندگی نکنید و با شجاعت بمیرید."],[726,"در حدیث آمد که روز رستخیز","امر آید هر یکی تن را که خیز","در روایات گفته شده است که در روز قیامت فرمانی خواهد آمد که هر کس باید از قبر برنخیزد و برای حساب و کتاب حاضر شود."],[726,"نفخ صور امرست از یزدان پاک","که بر آرید ای ذرایر سر ز خاک","نفخ صور (دمیدن در شیپور) فرمانی از سوی خداوند پاک است که مردم را از خاک برمی‌خیزاند."],[726,"باز آید جان هر یک در بدن","هم‌چو وقت صبح هوش آید به تن","در روز قیامت، جان هر شخص به بدنش بازمی‌گردد، مانند اینکه در صبح، هوش و حواس انسان دوباره به بدنش بازمی‌گردد."],[726,"جان تن خود را شناسد وقت روز","در خراب خود در آید چون کنوز","در زمان صبح، جان انسان بدن خود را می‌شناسد و مانند گنجی که در یک خرابه پنهان است، وارد آن می‌شود."],[726,"جسم خود بشناسد و در وی رود","جان زرگر سوی درزی کی رود","انسان باید به روح و جان خود توجه کند و از آنچه که برازنده‌اش نیست دوری کند، مانند این که جان یک زرگر به درزی (دوخت‌کار) می‌رود و به سراغ آن نمی‌رود."],[726,"جان عالم سوی عالم می‌دود","روح ظالم سوی ظالم می‌دود","روح انسانی به سمت موجودات و معارفی که در جهان هستی وجود دارد، حرکت می‌کند. همچنین روح افرادی که به ظلم و ستم پرداخته‌اند، به سمت کسانی که ظلم می‌کنند، می‌شتابد."],[726,"که شناسا کردشان علم اله","چونک بره و میش وقت صبحگاه","علم الهی آنان را آگاه کرد، مانند بره و میش که در صبح زود از همدیگر جدا می‌شوند و ارتباطشان با هم مشخص می‌شود."],[726,"پای کفش خود شناسد در ظلم","چون نداند جان تن خود ای صنم","انسان در این دنیا به بسیاری از امور و حقایق توجه نمی‌کند و از آن‌ها غافل است، مانند اینکه پای خود را به درستی نمی‌شناسد. در واقع، او عمق وجود و اهمیت جانش را درک نمی‌کند، درست مانند کسی که به زیبایی و زرق و برق تنها ظواهر توجه دارد و از حقیقت غافل است."],[726,"صبح حشر کوچکست ای مستجیر","حشر اکبر را قیاس از وی بگیر","ای شخص پناه‌جو، روز قیامت کوچک‌تر از روز بزرگ‌تری است که در پیش است؛ پس برای درک آن روز بزرگ‌تر، به این روز کوچک توجه کن و آن را مقایسه کن."],[726,"آنچنان که جان بپرد سوی طین","نامه پرد تا یسار و تا یمین","همان‌طور که جان از بدن خارج می‌شود و به آسمان می‌رود، نامه‌ای که در آن حسنات و گناهان نوشته شده، به سوی راست و چپ می‌رود."],[726,"در کفش بنهند نامه بخل و جود","فسق و تقوی آنچ دی خو کرده بود","در این بیت اشاره به این است که نامه بخل و generosity (جود) را در کفش بگذارند، یعنی از آنها دوری گزینند و به فرمان‌های عقل و تقوی (پرهیزکاری) پایبند شوند؛ زیرا رفتارهای نادرست و ناایمن بخشی از شخصیت فرد را تشکیل داده است."],[726,"چون شود بیدار از خواب او سحر","باز آید سوی او آن خیر و شر","زمانی که انسان از خواب بیدار می‌شود و به حقیقت و واقعیت می‌رسد، خیر و شر به سوی او بازمی‌گردد و او دوباره با آنها مواجه می‌شود."],[726,"گر ریاضت داده باشد خوی خویش","وقت بیداری همان آید به پیش","اگر انسان در حالت خواب و سستی، خود را سختی و ریاضت بدهد و تمرین کند، در زمان بیداری، حقیقت و خواست‌های درونی‌اش به نزد او می‌آید."],[726,"ور بد او دی خام و زشت و در ضلال","چون عزا نامه سیه یابد شمال","اگر کسی دارای خلق و رفتار زشت و ناباب باشد و به دور از هدایت زندگی کند، در روز قیامت و هنگام محاسبه اعمالش، مانند نامه‌ای سیاه و نامبارک به او خواهد رسید."],[726,"ور بد او دی پاک و با تقوی و دین","وقت بیداری برد در ثمین","اگر فردی دیدگاهی پاک، با تقوا و دین دارد، در وقت بیداری، او را به پاداش‌های ارزشمند و گران‌قدر می‌رساند."],[726,"هست ما را خواب و بیداری ما","بر نشان مرگ و محشر دو گوا","حالت خواب و بیداری ما نشانه‌ای است از مرگ و قیامت، که دو شاهد بر این حقیقت هستند."],[726,"حشر اصغر حشر اکبر را نمود","مرگ اصغر مرگ اکبر را زدود","مرگ و رستاخیز کوچک (حشر اصغر) نمونه‌ای از مرگ و رستاخیز بزرگ (حشر اکبر) است؛ یعنی آنچه در این زندگی (مرگ کوچک) اتفاق می‌افتد، به بیان و نشان‌دهی واقعیت‌های بزرگ‌تر در قیامت (مرگ بزرگ) می‌انجامد."],[726,"لیک این نامه خیالست و نهان","وآن شود در حشر اکبر بس عیان","این دنیا فقط یک نامه خیالی است و نه واقعیت، و در حشر بزرگ (روز قیامت) حقیقت آن به‌طور واضح و آشکار نمایان خواهد شد."],[726,"این خیال اینجا نهان پیدا اثر","زین خیال آنجا برویاند صور","این خیال که در اینجا پنهان است، اثر خود را در آنجا به وضوح بروز می‌دهد و آنجا شکلی می‌گیرد."],[726,"در مهندس بین خیال خانه‌ای","در دلش چون در زمینی دانه‌ای","در دل هر مهندس، تصوری از یک خانه وجود دارد، مشابه به دانه‌ای که در دل زمین نهفته است و بعدا رشد می‌کند."],[726,"آن خیال از اندرون آید برون","چون زمین که زاید از تخم درون","این بیت بیان می‌کند که خیال و فکر هر فرد، مانند دانه‌ای است که از درون دل بیرون می‌آید، درست مانند اینکه زمین، بذرهای درونش را می‌رویاند. به عبارت دیگر، آنچه در دل انسان است، به تدریج ظهور می‌یابد و شکل می‌گیرد."],[726,"هر خیالی کو کند در دل وطن","روز محشر صورتی خواهد شدن","هر خیالی که در دل انسان جا بگیرد و در آن ریشه پیدا کند، در روز قیامت شکل و صورتی به خود خواهد گرفت و ظاهر خواهد شد."],[726,"چون خیال آن مهندس در ضمیر","چون نبات اندر زمین دانه‌گیر","اگر تصور مهندس (خداوند) در دل وجود انسان باشد، مانند دانه‌ای است که در زمین ریشه می‌زند و رشد می‌کند. این کنایه به تأثیر عمیق اندیشه و تصور الهی در وجود انسان و تحول آن در مسیر کمال دارد."],[726,"مخلصم زین هر دو محشر قصه‌ایست","مؤمنان را در بیانش حصه‌ایست","من از هر دو محشر (محشر دنیا و محشر آخرت) خالص هستم، چرا که داستانی وجود دارد که مختص مؤمنان است و در آن، سهمی برای بیان شدن دارد."],[726,"چون بر آید آفتاب رستخیز","بر جهند از خاک زشت و خوب تیز","زمانی که آفتاب رستاخیز طلوع کند، انسان‌ها از خاک (زشت و خوب) به سرعت برمی‌خیزند و به سوی دادن حساب می‌روند."],[726,"سوی دیوان قضا پویان شوند","نقد نیک و بد به کوره می‌روند","انسان‌ها برای داوری به سوی دیوان قضا می‌روند تا خوب و بد خود را بسنجند و به حالتی که در آن قرار دارند، در کوره‌ای گرفتار شوند."],[726,"نقد نیکو شادمان و ناز ناز","نقد قلب اندر زحیر و در گداز","عمل نیکو از شادی و لطافت برخوردار است و دل سرشار از شوق و عشق در حال آزمایش و بی‌تابی قرار دارد."],[726,"لحظه لحظه امتحانها می‌رسد","سر دلها می‌نماید در جسد","امتحانات و آزمایش‌ها در هر لحظه رخ می‌دهند و از درون دل‌ها و روح‌ها در جسم ظاهر می‌شود."],[726,"چون ز قندیل آب و روغن گشته فاش","یا چو خاکی که بروید سرهاش","وقتی که نور و روشنایی از چیزی مانند قندیل که از آب و روغن درست شده، به وضوح و روشنی نمایان شود، یا مانند خاکی باشد که از آن سرهایی (شخصیت‌ها) رشد کند، این نشان‌دهنده ظهور و آشکار شدن حقیقت و وجود است."],[726,"از پیاز و گندنا و کوکنار","سر دی پیدا کند دست بهار","دست بهار از دل گیاهانی مانند پیاز، گندم و کوکنار به‌وجود می‌آید و می‌تواند نشانه‌های زندگی و سرسبزی را به‌وجود آورد. این ابیات به این نکته اشاره دارد که حتی از چیزهای ساده و بی‌اهمیت، نعمت‌ها و زیبایی‌ها به‌وجود می‌آید."],[726,"آن یکی سرسبز نحن المتقون","وآن دگر هم‌چون بنفشه سرنگون","این بیت به تضاد میان دو نوع انسان اشاره دارد. گروهی از انسان‌ها که متقی و پربارند، مثل گیاهان سرسبز و رونده‌ای هستند، و گروهی دیگر که در موقعیت نامناسب و افتاده‌ای به سر می‌برند، همانند گل بنفشه که به زمین افتاده است."],[726,"چشمها بیرون جهیده از خطر","گشته ده چشمه ز بیم مستقر","چشم‌ها از ترس خطر به بیرون رفته و به وضوح می‌بینند، به گونه‌ای که ده چشمه از آن‌ها به وجود آمده و در نتیجه، بیم و نگرانی در آن‌ها مستقر شده است."],[726,"باز مانده دیده‌ها در انتظار","تا که نامه ناید از سوی یسار","چشم‌ها در انتظار مانده‌اند تا نامه‌ای از سمت چپ (یسار) بیاید."],[726,"چشم گردان سوی راست و سوی چپ","زانک نبود بخت نامه راست زپ","چشم خود را به سمت راست و چپ می‌چرخاند، زیرا امیدی به آن نامه‌ی خوب (سرنوشت خوب) ندارد و بختش به آن نامه نرسیده است."],[726,"نامه‌ای آید به دست بنده‌ای","سر سیه از جرم و فسق آگنده‌ای","نامه‌ای به دست بنده‌ای می‌رسد که در آن، سیاهی و گناهکاری او ذکر شده است. این اشاره به وقوع عذاب یا مجازات بر اساس اعمال ناپسند فرد دارد."],[726,"اندرو یک خیر و یک توفیق نه","جز که آزار دل صدیق نه","در این بیت، مولانا بیان می‌کند که دریافت خیر و توفیق واقعی، تنها در صورتی ممکن است که آسیبی به دل دوستان نرسد؛ به عبارت دیگر، انسان باید به روابط و احساسات دیگران توجه داشته باشد و از ایجاد درد و آزار برای آنان پرهیز کند."],[726,"پر ز سر تا پای زشتی و گناه","تسخر و خنبک زدن بر اهل راه","این شخص از سر تا پا پر از زشتی و گناه است و به تمسخر و مسخره کردن اهل راه و هدایت می‌پردازد."],[726,"آن دغل‌کاری و دزدیهای او","و آن چو فرعونان انا و انای او","دغل‌کاری و دزدی‌های آن شخص، مشابه خودخواهی و خودبرتر بینی فرعون‌هاست که فقط به خودشان اهمیت می‌دهند و در پی خدمت به دیگران نیستند."],[726,"چون بخواند نامه خود آن ثقیل","داند او که سوی زندان شد رحیل","وقتی آن فرد سنگین‌بار (که به خاطر کارهای بدش در حال محاکمه است) نامه خود را می‌خواند، می‌فهمد که به سمت زندان می‌رود و باید آماده خروج به آنجا باشد."],[726,"پس روان گردد چو دزدان سوی دار","جرم پیدا بسته راه اعتذار","پس از اینکه نامه اعمال او خوانده می‌شود، روح او مانند دزدان به سوی محل مجازات می‌رود، در حالی که جرمی که مرتکب شده روشن و مشهود است و برای دفاع از خود راهی ندارد."],[726,"آن هزاران حجت و گفتار بد","بر دهانش گشته چون مسمار بد","در این بیت، شاعر به فردی اشاره می‌کند که به دلیل اعمال ناپسند و زشت خود، به حجت‌ها و سخنانی بدتر از مسمار (میخ) گرفتار آمده است. این سخنان از شدت زشتی، مثل میخی بر زبان او نمایان شده و نشان‌دهنده نفرت و بداندیشی اوست."],[726,"رخت دزدی بر تن و در خانه‌اش","گشته پیدا گم شده افسانه‌اش","یعنی در ظاهر او همچون دزدان است که لباسی را دزدیده و در خانه‌اش پیدا شده است، در حالی که داستانی که او را توصیف می‌کند گم شده و دیگر اثری از آن نیست."],[726,"پس روان گردد به زندان سعیر","که نباشد خار را ز آتش گزیر","پس روح در آتش جهنم خواهد رفت، زیرا خارها نمی‌توانند از آتش دور بمانند."],[726,"چون موکل آن ملایک پیش و پس","بوده پنهان گشته پیدا چون عسس","فرشتگان که مسئول مراقبت و نگهبانی هستند، در گذشته و آینده همیشه حاضرند، اما به‌طور پنهانی عمل می‌کنند و مانند نگهبانان (عسس) نقش خود را ایفا می‌کنند."],[726,"می‌برندش می‌سپوزندش به نیش","که برو ای سگ به کهدانهای خویش","کسی را که در آستانه خطر است، از محلی که شایسته او نیست، راند و به او می‌گویند که باید به جایی برود که برایش مناسب‌تر است، در حالی که او مانند سگ در وضعیت نامناسبی قرار دارد."],[726,"می‌کشد پا بر سر هر راه او","تا بود که برجهد زان چاه او","انسان در زندگی برای رهایی از مشکلات و چالش‌ها تلاش می‌کند، حتی اگر با قدرت و عزم بالا به جلو برود و بر سختی‌ها غلبه کند."],[726,"منتظر می‌ایستد تن می‌زند","در امیدی روی وا پس می‌کند","شخصی در حال انتظار ایستاده و به امیدی که در دل دارد، خود را به جلو می‌زند، اما از هدفش بازمی‌گردد."],[726,"اشک می‌بارد چو باران خزان","خشک اومیدی چه دارد او جز آن","اشک مانند باران پاییزی می‌بارد، و او هیچ امیدی جز این ندارد که در شرایط خشک و بی‌حالی قرار دارد."],[726,"هر زمانی روی وا پس می‌کند","رو به درگاه مقدس می‌کند","در هر زمانی چهره‌اش را به سوی درگاه مقدس خدا برمی‌گرداند و زاری می‌کند."],[726,"پس ز حق امر آید از اقلیم نور","که بگوییدش کای بطال عور","از جانب حق، دستوری می‌آید که از سرزمین نور صادر می‌شود و به کسی که بی‌کار و عیبی دارد، می‌گوید: تو بی‌فایده و ناتوان هستی."],[726,"انتظار چیستی ای کان شر","رو چه وا پس می‌کنی ای خیره‌سر","ای کسی که اساس بدی‌ها هستی، چه چیز را انتظار می‌کشی؟ چرا به عقب برمی‌گردی و عاقلانه رفتار نمی‌کنی؟"],[726,"نامه‌ات آنست کت آمد به دست","ای خدا آزار و ای شیطان‌پرست","این بیت به معنای این است که نامه‌ای که به دست خدا رسیده، حاکی از بدی‌ها و آزارهایی است که فرد کرده و او خود را در معرض قضاوت الهی قرار داده است، در حالی که همان فرد به شیطان‌پرستی نیز متهم است."],[726,"چون بدیدی نامه کردار خویش","چه نگری پس بین جزای کار خویش","وقتی که بدانی نامه اعمال خودت را، چه چیزی را می‌بینی جز نتایج کارهای خودت؟"],[726,"بیهده چه مول مولی می‌زنی","در چنین چه کو امید روشنی","در این بیت، شاعر به شخصی می‌گوید که بی‌دلیل و بی‌فایده به کاری مشغول است و به او هشدار می‌دهد که در وضعیت فعلی، باید به امید روشنی توجه کند و از تلاش بی‌ثمر دست بردارد."],[726,"نه ترا از روی ظاهر طاعتی","نه ترا در سر و باطن نیتی","نه تو از روی ظاهری عبادتی داری و نه در دل و باطن‌ات نیتی برای خداوند."],[726,"نه ترا شبها مناجات و قیام","نه ترا در روز پرهیز و صیام","این بیت می‌گوید که خداوند به دنبال عبادت‌های ظاهری و شب‌زنده‌داری و روزه‌داری نیست. او به نیت‌های واقعی و باطنی انسان‌ها توجه دارد و تنها به عمل کردن‌های ظاهری بسنده نمی‌کند."],[726,"نه ترا حفظ زبان ز آزار کس","نه نظر کردن به عبرت پیش و پس","تو نه برای جلوگیری از آزار دیگران زبانت را حفظ می‌کنی و نه به عبرت‌هایی که در گذشته و آینده وجود دارد، توجه می‌کنی."],[726,"پیش چه بود یاد مرگ و نزع خویش","پس چه باشد مردن یاران ز پیش","انسان وقتی به یاد مرگ و جدایی از خود می‌افتد، در آنجا چه می‌شود؟ حالا که دوستانش هم پیش رویش مرده‌اند، چه حالی خواهد داشت؟"],[726,"نه ترا بر ظلم توبه پر خروش","ای دغا گندم‌نمای جوفروش","تو بر ظلم خود نباید با قاطعیت و شتاب توبه کنی، زیرا شخصی که به شدت دروغ می‌گوید و خود را به‌جای دیگری معرفی می‌کند، مانند کسی است که گندم را به عنوان کالای باارزش نمایش می‌دهد ولی در حقیقت جو (کالا) بی‌ارزشی می‌فروشد."],[726,"چون ترازوی تو کژ بود و دغا","راست چون جویی ترازوی جزا","وقتی که ترازوی شما کج و نادرست باشد، نتیجه نیز حق نیست و مثل جویی که میزان پاداش را به اشتباه نشان می‌دهد، نمی‌توان به انصاف رسید."],[726,"چونک پای چپ بدی در غدر و کاست","نامه چون آید ترا در دست راست","اگر پای چپ تو به سمت خیانت و کج‌روی برود، چگونه نامه‌ای که نشان‌دهنده کردار توست می‌تواند در دست راست تو، یعنی سمت درست و بی‌گناهی، قرار بگیرد؟"],[726,"چون جزا سایه‌ست ای قد تو خم","سایه تو کژ فتد در پیش هم","مجازات مانند سایه‌ای است که بر اعمال انسان فرود می‌آید؛ از این رو، اگر قامت تو دارای خمیدگی باشد، سایه‌ات نیز در پیش دیگران کج خواهد بود."],[726,"زین قبل آید خطابات درشت","که شود که را از آن هم کوز پشت","از قبل، خطابه‌های تند و صریحی می‌آید که نشان می‌دهد چه کسی از آن خطابه‌ها پشتیبانی می‌کند و در پس آن قرار دارد."],[726,"بنده گوید آنچ فرمودی بیان","صد چنانم صد چنانم صد چنان","بنده می‌گوید آنچه را که تو بیان کردی، به صد شکل و صورت در وجود من است و من با هر یک از آن‌ها همان‌گونه که تو می‌گویی، هستم."],[726,"خود تو پوشیدی بترها را به حلم","ورنه می‌دانی فضیحتها به علم","تو با صبر و فروتنی عیب‌های خود را پنهان کرده‌ای، وگرنه با دانشی که داری، به خوبی می‌دانی که نقاط ضعف و شرم‌آور خودت چیست."],[726,"لیک بیرون از جهاد و فعل خویش","از ورای خیر و شر و کفر و کیش","اما حقیقتا فراتر از تلاش‌ها و اعمال خود، و نیز از خارج از دایره خوب و بد و ایمان و کفر، وجود دارد."],[726,"وز نیاز عاجزانه خویشتن","وز خیال و وهم من یا صد چو من","من از نیاز و ناتوانی خود و از خیالات و اندیشه‌های نادرست و پوچ خود بسیار عاجز و ناتوانم، و حتی اگر صد نفر مثل من هم وجود داشته باشند."],[726,"بودم اومیدی به محض لطف تو","از ورای راست باشی یا عتو","من امیدوار بودم به لطف خالص تو، از آن طرف که یا راستین هستی یا مغرور."],[726,"بخشش محضی ز لطف بی‌عوض","بودم اومید ای کریم بی‌عوض","من به بخشش بی‌دریغ تو امید دارم، ای کریم که محبت تو هیچ نیازی به پاداش ندارد."],[726,"رو سپس کردم بدان محض کرم","سوی فعل خویشتن می‌ننگرم","سپس متوجه شدم که تنها به خاطر بخشش خالص خداوند به این نعمت دست یافته‌ام و حالا نسبت به اعمال خود نگاه می‌کنم و از آن‌ها شرمنده‌ام."],[726,"سوی آن اومید کردم روی خویش","که وجودم داده‌ای از پیش بیش","به سوی او امید دارم که در وجود من از پیش بیشتر عطا کرده است."],[726,"خلعت هستی بدادی رایگان","من همیشه معتمد بودم بر آن","تو بی‌هیچ استحقاقی، لباس هستی و وجود را به من بخشیدی و من همیشه به این بخشش تو اعتماد داشتم."],[726,"چون شمارد جرم خود را و خطا","محض بخشایش در آید در عطا","وقتی انسان گناهان و خطاهای خود را بشمارد و احساس کند که هیچ چیزی جز رحمت و بخشایش خداوند برای او باقی نمانده است، در آن صورت خداوند به او نعمت عطا می‌کند."],[726,"کای ملایک باز آریدش به ما","که بدستش چشم دل سوی رجا","ای ملائکه، این شخص را به ما بازگردانید چون او با دست خود به امید رحمتی الهی، چشم دلش را به سوی امید دوخته است."],[726,"لاابالی وار آزادش کنیم","وآن خطاها را همه خط بر زنیم","بگذارید آزاد باشد و اهمیتی ندهیم؛ همه خطاهایش را فراموش کنیم و نابود کنیم."],[726,"لا ابالی مر کسی را شد مباح","کش زیان نبود ز غدر و از صلاح","آن کس که بی‌خیال است و خود را از قید و بندها آزاد کرده، به هیچ‌کس آسیب نمی‌زند و نه در کارهای نادرست به کسی خیانت می‌کند و نه در کارهای نیک به کسی لطمه می‌زند."],[726,"آتشی خوش بر فروزیم از کرم","تا نماند جرم و زلت بیش و کم","بگذار آتش خوبی از روی کرم (رحمت) فروزان شود تا دیگر گناه و خطا نماند، نه زیاد و نه کم."],[726,"آتشی کز شعله‌اش کمتر شرار","می‌بسوزد جرم و جبر و اختیار","آتش‌سوزی که شعله‌اش کم‌نورتر است، کمتر از خود آسیب می‌زند و عواقب کارها و رفتارهای نادرست را برطرف می‌کند و این به معنای همکاری میان سرنوشت انسانی و آزادی انتخاب است."],[726,"شعله در بنگاه انسانی زنیم","خار را گلزار روحانی کنیم","ما در دنیای انسان‌ها شعله و آتش ایجاد می‌کنیم تا خارها و سختی‌ها را به گل‌های زیبا و روحانی تبدیل کنیم."],[726,"ما فرستادیم از چرخ نهم","کیمیا یصلح لکم اعمالکم","ما از آسمان درّ و جواهر معنوی به شما هدیه داده‌ایم که افکار و کارهای شما را اصلاح می‌کند."],[726,"خود چه باشد پیش نور مستقر","کر و فر اختیار بوالبشر","سخن از انسان است که در برابر نور الهی، که مستقر و ثابت است، چه ارزشی دارد و اختیار او در برابر این نور چگونه به نظر می‌رسد. در واقع، انسان همچون موجودی کوچک و کم‌اهمیت در مقایسه با عظمت نور الهی و قدرت خداوند است."],[726,"گوشت‌پاره آلت گویای او","پیه‌پاره منظر بینای او","جسم انسان، نشان‌دهنده وجود اوست و چهره‌اش، نمایانگر بینش و آگاهی‌اش است."],[726,"مسمع او آن دو پاره استخوان","مدرکش دو قطره خون یعنی جنان","خروش و صدای او به آن دو تکه استخوان و دو قطره خون نسبت دارد، که نشانه‌ای از روح و احساسات است."],[726,"کرمکی و از قذر آکنده‌ای","طمطراقی در جهان افکنده‌ای","تو موجودی کوچک و آلوده‌ای که با بزرگ‌منشی‌ات در دنیا به طمطراق (فخرفروشی) و خود بزرگ‌بینی افتاده‌ای."],[726,"از منی بودی منی را واگذار","ای ایاز آن پوستین را یاد دار","ای ایاز، تو از جایی برخاسته‌ای که خود تو آن را ترک کرده‌ای، پس به این نکته توجه کن که آن پوستین (لباس کهن و غیرمناسب) را فراموش نکن و همچنان به یاد آن باش."],[727,"آن ایاز از زیرکی انگیخته","پوستین و چارقش آویخته","ایاز، از روی هوشمندی و دوراندیشی، لباس و کفش چوپانی‌اش را جایی آویزان می‌کند."],[727,"می‌رود هر روز در حجره خلا","چارقت اینست منگر در علا","هر روز به حجره‌ای خلوت و دور از دیگران می‌رود و در آنجا با همان کفش و لباس خلوت می‌کند؛ و به خود می‌گوید که مبادا به خاطر جایگاهی که اکنون داری، گذشته‌ات را فراموش کنی."],[727,"شاه را گفتند او را حجره‌ایست","اندر آنجا زرّ و سیم و خمره‌ایست","به شاه گفتند: ایاز حجره‌ای دارد که در آن طلا و نقره و چیزهای ارزشمند فراوانی هست."],[727,"راه می‌ندهد کسی را اندرو","بسته می‌دارد همیشه آن در او","هیچ‌کس را به آنجا راه نمی‌دهد و همیشه در آن را بسته نگه می‌دارد."],[727,"شاه فرمود ای عجب آن بنده را","چیست خود پنهان و پوشیده ز ما","شاه گفت: عجیب است! این غلام چه چیزی را از ما پنهان می‌کند؟"],[727,"پس اشارت کرد میری را که رو","نیم‌شب بگشای و اندر حجره شو","بعد به یکی از امیرانش اشاره کرد و گفت: نیمه‌شب برو، در حجره را باز کن و وارد شو."],[727,"هر چه یابی مر ترا یغماش کن","سرّ او را بر ندیمان فاش کن","هرچه در آن پیدا کردی، غارت کن و با خودت بردار؛ و ماجرا را برای ندیمان آشکار کن."],[727,"با چنین اکرام و لطف بی‌عدد","از لئیمی سیم و زر پنهان کند","با این همه احترام و لطف بی‌شمار، از فرومایگی، طلا و نقره را پنهان می‌کند."],[727,"می‌نماید او وفا و عشق و جوش","وانگه او گندم‌نمای جوفروش","او خود را اهل وفا و عشق و شور نشان می‌دهد، ولی مثل کسی است که گندم نشان می‌دهد، اما جو می‌فروشد."],[727,"هر که اندر عشق یابد زندگی","کفر باشد پیش او جز بندگی","کسی که در عشق حقیقی به زندگی رسیده باشد، برای او کاری جز بندگی و خدمت به محبوب کفر است."],[727,"نیم‌شب آن میر با سی معتمد","در گشاد حجره او رای زد","آن امیر، نیمه‌شب، همراه سی نفر از افراد مورد اعتمادش، تصمیم گرفت در حجره ایاز را باز کند."],[727,"مشعله بر کرده چندین پهلوان","جانب حجره روانه شادمان","مشعل‌ها را روشن کردند و چندین پهلوان و مرد مسلح همراهشان بودند و شادمان به سوی حجره رفتند؛"],[727,"که امر سلطانست بر حجره زنیم","هر یکی همیان زر در کش کنیم","که فرمان شاه بود که در حجره را بشکنیم و هرکدام کیسه‌ای طلا برداریم."],[727,"آن یکی می‌گفت هی چه جای زر","از عقیق و لعل گوی و از گهر","یکی از آنها گفت: طلا دیگر چیست؟ بهتر است از عقیق و لعل و جواهر و گوهرهای گران‌بها صحبت کنیم!"],[727,"خاص خاص مخزن سلطان ویست","بلکه اکنون شاه را خود جان ویست","ایاز گران‌بهاترین گنج سلطان است؛ بلکه اکنون برای شاه، از خود جانش هم عزیزتر است."],[727,"چه محل دارد به پیش این عشیق","لعل و یاقوت و زمرّد یا عقیق","در برابر چنین عاشق و دلداده‌ای، مگر عقیق و یاقوت و زمرد چه ارزشی دارد؟"],[727,"شاه را بر وی نبودی بد گمان","تسخری می‌کرد بهر امتحان","شاه درباره ایاز واقعا بدگمان نبود؛ این کار را برای امتحان کردن او کرده بود و حتی با شوخی و کنایه با این موضوع برخورد می‌کرد."],[727,"پاک می‌دانستش از هر غشّ و غل","باز از وهمش همی‌لرزید دل","شاه او را از هرگونه نیرنگ و خیانت پاک می‌دانست؛ اما باز هم دلش از ترس می‌لرزید"],[727,"که مبادا کین بود خسته شود","من نخواهم که برو خجلت رود","که مبادا این گمان و آزمایش، ایاز را آزرده کند. با خود می‌گفت که نکند ایاز از این ماجرا دلگیر شود؟ من نمی‌خواهم او خجالت‌زده و شرمنده شود."],[727,"این نکردست او و گر کرد او رواست","هر چه خواهد گو بکن محبوب ماست","او چنین کاری نکرده؛ و اگر هم کرده باشد، اشکالی ندارد. هر کاری که خواست، بگذار انجام دهد، باز هم محبوب ماست."],[727,"هر چه محبوبم کند من کرده‌ام","او منم من او چه گر در پرده‌ام","هر چه محبوبم انجام دهد، من کرده‌ام. او من است و من او؛ هر چند در پرده باشم."],[727,"باز گفتی دور از آن خو و خصال","این چنین تخلیط ژاژست و خیال","باز با خود گفت که نه، چنین چیزی از ایاز دور است. این حرف‌ها فقط خیال و سخنان بیهوده است."],[727,"از ایاز این خود محالست و بعید","کو یکی دریاست قعرش ناپدید","چنین کاری از ایاز محال و بسیار بعید است. ایاز مانند دریایی است که عمقش پیدا نیست؛"],[727,"هفت دریا اندرو یک قطره‌ای","جمله هستی ز موجش چکره‌ای","دریایی که هفت دریا در برابرش تنها یک قطره‌اند و تمام هستی، در برابر موج او، ذره‌ای ناچیز است."],[727,"جمله پاکی‌ها از آن دریا برند","قطره‌هایش یک به یک میناگرند","همه پاکی‌ها از آن دریا سرچشمه می‌گیرند و قطره‌قطره‌های آن دریا مانند جام‌هایی از پاکی و صفا هستند."],[727,"شاه شاهانست و بلکه شاه‌ساز","وز برای چشم بد نامش ایاز","ایاز، شاه شاهان است، بلکه شاه‌ساز است؛ و شاید به همین دلیل نامش را ایاز گذاشته‌اند تا از چشم بد در امان باشد."],[727,"چشم‌های نیک هم بر وی بدست","از ره غیرت که حسنش بی‌حدست","چشم‌های پاک و نیک هم به او به چشم بد نگاه می‌کنند؛ زیرا زیبایی و کمال او حد و اندازه‌ای ندارد و همین زیبایی، حسادت و غیرت برمی‌انگیزد."],[727,"یک دهان خواهم به پهنای فلک","تا بگویم وصف آن رشک ملک","برای توصیف چنین محبوبی، یک دهان به پهنای آسمان می‌خواهم تا بتوانم اندکی از عظمتش را بگویم."],[727,"ور دهان یابم چنین و صد چنین","تنگ آید در فغان این حنین","حتی اگر صدها دهان به این بزرگی هم داشته باشم، باز برای بیان این همه شور و ناله و شگفتی کافی نیست."],[727,"این قدر گر هم نگویم ای سند","شیشه دل از ضعیفی بشکند","ای دوست و پناه من، اگر همین اندازه هم از او نگویم، شیشه دلم از شدت ناتوانی و فشار می‌شکند."],[727,"شیشه دل را چو نازک دیده‌ام","بهر تسکین بس قبا بدریده‌ام","وقتی دیدم دل من مانند شیشه‌ای نازک و شکننده است، برای آرام کردنش بارها پیراهن و قبای خود را از شدت بی‌قراری پاره کرده‌ام."],[727,"من سر هر ماه سه روز ای صنم","بی‌گمان باید که دیوانه شوم","ای محبوب من، من در آغاز هر ماه، سه روز بی‌اختیار باید دیوانه شوم!"],[727,"هین که امروز اوّل سه روزه است","روز پیروزست نه پیروزه است","آگاه باش که امروز روز نخست از آن سه روز است؛ امروز روز فرخنده و پیروزی است، نه پیروزه."],[727,"هر دلی که اندر غم شه می‌بود","دم به دم او را سر مه می‌بود","هر دلی که در غم و عشق شاه گرفتار باشد، لحظه‌به‌لحظه برای او تازه و نو می‌شود."],[727,"قصه محمود و اوصاف ایاز","چون شدم دیوانه رفت اکنون ز ساز","اما حالا که من از شدت این عشق دیوانه شده‌ام، دیگر توان ادامه دادن این داستان و وصف آن شور و حال را ندارم."],[728,"زانکه پیلم دید هندستان به خواب","از خراج اومید بر ده شد خراب","چون پیلم (محتمل است اشاره به «پیلم» که نوعی توهم یا خیال است) در خواب هند و هندوستان را دید، به خاطر خزانه‌داری و مالیاتی که بر این سرزمین نهاد، امیدش بر باد رفت و به آشفتگی و خرابی رسید."],[728,"کیف یأتی النّظم لی والقافیه","بعد ما ضاعت أصول العافیه","حالا که پایه‌های سلامت و آرامش از دست رفته، دیگر شعر و قافیه از کجا می‌تواند به سراغ من بیاید؟"],[728,"ما جنون واحد لی فی الشّجون","بل جنون فی جنون فی جنون","من فقط یک دیوانگی در میان این اندوه ندارم؛ دیوانگی پشت دیوانگی است، دیوانگی در دل دیوانگی!"],[728,"ذاب جسمی من إشارات الکنی","منذ عاینت البقاء فی الفنا","از اشاره‌ها و رمز و رازهای عشق، تنم آب شده و از میان رفته؛ از روزی که در دل نابودی و فنا، حقیقت جاودانگی و بقا را دیدم."],[728,"ای ایاز از عشق تو گشتم چو موی","ماندم از قصّه تو قصّه من بگوی","ای ایاز! از عشق تو آن‌قدر باریک و نحیف شده‌ام که مثل یک تار مو شده‌ام. دیگر خودم چیزی برای گفتن ندارم؛ حالا تو از داستان من بگو."],[728,"بس فسانه عشق تو خواندم به جان","تو مرا که افسانه گشتستم بخوان","آن‌قدر حکایت عشق تو را با جان و دل خوانده‌ام، که خودم دیگر تبدیل به افسانه شده‌ام؛ حالا که من خود افسانه شده‌ام، تو مرا بخوان."],[728,"خود تو می‌خوانی نه من ای مقتدی","من که طورم تو موسی وین صدا","در حقیقت، این تویی که می‌خوانی، نه من، ای راهبر و پیشوا. من کوه طورم و تو موسی؛ و این صدایی که می‌شنوی، از آن توست."],[728,"کوه بیچاره چه داند گفت چیست","زانکه موسی می‌بداند که تهیست","کوه بیچاره از کجا بداند این صدا چیست؟ موسی می‌داند، چون می‌داند که کوه در برابر آن تجلی، دیگر چیزی جز نیستی و تهی‌بودن نیست."],[728,"کوه می‌داند به قدر خویشتن","اندکی دارد ز لطف روح تن","کوه فقط به اندازه ظرفیت خودش می‌فهمد؛ تن او اندکی از لطف و روح را در خود جای داده است."],[728,"تن چو اصطرلاب باشد ز احتساب","آیتی از روح هم‌چون آفتاب","تن مانند یک اسطرلاب است؛ ابزاری برای سنجش و محاسبه، و نشانه‌ای از روح همچون خورشید."],[728,"آن منجّم چون نباشد چشم‌تیز","شرط باشد مرد اصطرلاب‌ریز","اما اگر آن ستاره‌شناس چشم تیزبین نداشته باشد، برای کار با اسطرلاب باید کسی باشد که واقعا راه و رسم آن را بداند؛"],[728,"تا صطرلابی کند از بهر او","تا برد از حالت خورشید بو","تا اسطرلاب را برای او به کار گیرد و از وضعیت و حال خورشید باخبرش کند."],[728,"جان کز اصطرلاب جوید او صواب","چه قدر داند ز چرخ و آفتاب","آن کسی که حقیقت را فقط از راه اسطرلاب می‌جوید، چه اندازه می‌تواند از آسمان و خورشید حقیقت بداند؟"],[728,"تو که ز اصطرلاب دیده بنگری","در جهان دیدن یقین بس قاصری","تو که با چشم اسطرلاب‌گونه‌ات به جهان نگاه می‌کنی، در شناختن حقیقت جهان، هنوز بسیار ناتوانی."],[728,"تو جهان را قدر دیده دیده‌ای","کو جهان سبلت چرا مالیده‌ای","تو جهان را فقط به اندازه چشم و دید خودت دیده‌ای؛ پس چرا این‌قدر به خود می‌نازی و بر سبیل غرور دست می‌کشی؟"],[728,"عارفان را سرمه‌ای هست آن بجوی","تا که دریا گردد این چشم چو جوی","عارفان سرمه‌ای دارند که باید آن را پیدا کنی؛ سرمه‌ای که اگر به چشم بزنی، این جویبار کوچک چشم، به دریایی پهناور تبدیل می‌شود."],[728,"ذره‌ای از عقل و هوش ار با منست","این چه سودا و پریشان گفتنست","اگر ذره‌ای عقل و هوش در من باقی مانده باشد، پس این حرف‌های آشفته و سوداهای دیوانه‌وار چیست؟"],[728,"چونکه مغز من ز عقل و هش تهیست","پس گناه من درین تخلیط چیست","وقتی مغز و وجود من از عقل و هوش خالی شده، پس در این آمیختگی و پریشان‌گویی، دیگر چه گناهی متوجه من است؟"],[728,"نه گناه او راست که عقلم ببرد","عقل جمله عاقلان پیشش بمرد","این تقصیر او نیست که عقل مرا از من ربوده؛ عقل همه عاقلان در برابر او از پا افتاده و مرده است."],[728,"یا مجیر العقل فتّان الحجی","ما سواک للعقول مرتجی","ای آن‌که عقل افسونگر و خردهای حیران را نجات می‌دهی! برای عقل‌ها، جز تو هیچ امید و پناهی نیست."],[728,"ما اشتهیت العقل مذ جنّنتنی","ما حسدت الحسن مذ زیّنتنی","از وقتی مرا دیوانه خود کردی، دیگر آرزوی عقل نکرده‌ام؛ و از وقتی مرا با زیبایی خود آراستی، دیگر به زیبایی هیچ‌کس حسادت نکرده‌ام."],[728,"هل جنونی فی هواک مستطاب","قل بلی والله یجزیک الثّواب","آیا این دیوانگی در عشق تو، دیوانگی شیرین و خواستنی است؟ بگو: آری، به خدا سوگند چنین است؛ و خداوند به تو پاداش نیک دهد."],[728,"گر به تازی گوید او ور پارسی","گوش و هوشی کو که در فهمش رسی","فرقی نمی‌کند او به عربی سخن بگوید یا فارسی؛ گوش و هوشی در من باقی نمانده که بتوانم به فهم سخنش برسم."],[728,"باده او درخور هر هوش نیست","حلقه او سخره هر گوش نیست","باده عشق او درخور هر عقل و هوشی نیست؛ و حلقه او جای بازی و تمسخر هر گوشی نیست."],[728,"بار دیگر آمدم دیوانه‌وار","رو رو ای جان زود زنجیری بیار","باز هم دیوانه‌وار به سراغت آمدم؛ ای جان، برو و زود برایم زنجیری بیاور!"],[728,"غیر آن زنجیر زلف دلبرم","گر دو صد زنجیر آری بر درم","اما اگر چیزی جز آن زنجیر زلف دلبرم می‌آوری، حتی اگر دویست زنجیر هم بر در خانه‌ام بیاویزی، باز هم به کار نمی‌آید."],[729,"بازگردان قصه عشق ایاز","که آن یکی گنجیست مالامال راز","حالا دوباره داستان عشق ایاز را تعریف کن؛ چون این داستان گنجی است که پر از رازهای پنهان است."],[729,"می‌رود هر روز در حجره برین","تا ببیند چارقی با پوستین","ایاز هر روز به آن اتاق می‌رود، تا چارق و پوستین قدیمی خودش را ببیند."],[729,"زانکه هستی سخت مستی آورد","عقل از سر شرم از دل می‌برد","چون احساس «من بودن» و دلبستگی به خود، آدم را سخت مست و مغرور می‌کند؛ عقل را از سر می‌پراند و شرم و فروتنی را از دل می‌برد."],[729,"صد هزاران قرن پیشین را همین","مستی هستی بزد ره زین کمین","از هزاران هزار قرن پیش هم همین مستی «هستی» راه را بر آدمیان بسته و آن‌ها را از کمینگاه خودش گرفتار کرده است."],[729,"شد عزازیلی ازین مستی بلیس","که چرا آدم شود بر من رئیس","شیطان هم از همین مستی وجود و غرور گرفتار شد؛ همان ابلیس که گفت: چرا باید آدم بر من سرور و فرمانروا باشد؟"],[729,"خواجه‌ام من نیز و خواجه‌زاده‌ام","صد هنر را قابل و آماده‌ام","من خودم صاحب‌مقامم، تازه از خاندان بزرگی هم هستم؛ پر از هنر و شایستگی‌ام و برای هر کاری آمادگی دارم."],[729,"در هنر من از کسی کم نیستم","تا به خدمت پیش دشمن بیستم","در هنر و توانایی، از هیچ‌کس کمتر نیستم؛ پس چرا باید در برابر دشمن بایستم و به او خدمت کنم؟"],[729,"من ز آتش زاده‌ام او از وحل","پیش آتش مر وحل را چه محل","من از آتش آفریده شده‌ام و او از گل و خاک؛ در برابر آتش، گل و خاک چه ارزشی دارد؟"],[729,"او کجا بود اندر آن دوری که من","صدر عالم بودم و فخر زمن","او در آن دوران دور اصلا کجا بود، وقتی من در جایگاه بلند جهان بودم و مایه افتخار روزگار بودم؟"],[730,"شعله می‌زد آتش جان سفیه","که آتشی بود الولد سّر أبیه","آتش نفهم و سفیه، شعله‌ور بود و این آتش، ارتباطی با آتش پدرش دارد؛ یعنی این شخص، تحت تأثیر ویژگی‌ها و سرشت پدرش قرار گرفته است."],[730,"نه غلط گفتم که بد قهر خدا","علّتی را پیش آوردن چرا","منظور این است که خداوند به خاطر گناهی که ابلیس انجام داد، او را از رحمتش دور کرد و این یک دلیل واقعی است و نمی‌توان آن را نادرست دانست."],[730,"کار بی‌علت مبرّا از علل","مستمر و مستقرّست از ازل","کارهایی که هیچ علتی ندارند، از عوامل و شرایط همیشگی و پایدار، بی‌نیاز و جدا هستند و از آغاز جهان وجود داشته‌اند."],[730,"در کمال صنع پاک مستحث","علّت حادث چه گنجد یا حدث","در کمال آفرینش پاک و بی‌نقص، چه دلیلی برای حادثه و وقوع چیزی وجود دارد؟"],[730,"سرّ اب چه بود اب ما صنع اوست","صنع مغزست و اب صورت چو پوست","سرّ اب یعنی راز و حقیقت عمیق آب، که نشان‌دهنده وجود ماست، در واقع نشانه‌ای از هنر و آفرینش خداوند است. این هنر همانند مغز درون چیزی است و همان‌طور که پوست، نمای خارجی و ظاهری را تشکیل می‌دهد، آب نیز نشان‌دهنده حقیقت و جوهره وجود ماست."],[730,"عشق دان ای فندق تن دوستت","جانت جوید مغز و کوبد پوستت","عشق را بشناس، ای جایی که تن تو در آن قرار دارد؛ جان تو به دنبال مغز این تن است و پوست تو را می‌زند."],[730,"دوزخی که پوست باشد دوستش","داد بدّلنا جلودا پوستش","اگر کسی که فقط ظاهرش را دارد و روح واقعی‌اش را ندیده‌ایم و در نتیجه او را دوست داریم، در دوزخ باشد، ما پوست او را ترک می‌کنیم و به جای آن، روح و ذات او را دریافت می‌کنیم."],[730,"معنی و مغزت بر آتش حاکمست","لیک آتش را قشورت هیزمست","مفهوم و جوهر وجود تو تحت تسلط آتش است، اما آتش هم برای ادامه حیات خود به چوب و هیزم نیاز دارد."],[730,"کوزه چوبین که در وی آب جوست","قدرت آتش همه بر ظرف اوست","اگرچه کوزه چوبی ظاهرا آب را در خود دارد، اما قدرت و تأثیر آتش به حدی است که می‌تواند کل محتویات آن را تحت تأثیر قرار دهد. در اینجا به تشبیه انسان به کوزه چوبی اشاره شده که به رغم ظرفیت و خواص خود، در برابر قدرت آتش (نماد نفس یا آز) آسیب‌پذیر است."],[730,"معنی انسان بر آتش مالکست","مالک دوزخ درو کی هالکست","انسان بر آتش مسلط است و مالک دوزخ می‌باشد؛ پس چه زمانی از بین خواهد رفت و نابود خواهد شد؟"],[730,"پس میفزا تو بدن معنی فزا","تا چو مالک باشی آتش را کیا","پس نمی‌توانی بدن خود را فزونی بدهی، تا جایی که مانند مالک آتش شوی."],[730,"پوست‌ها بر پوست می‌افزوده‌ای","لاجرم چون پوست اندر دوده‌ای","تو بر لایه‌های ظاهری و سطحی افزوده‌ای، از این رو مانند کسی هستی که در دوده جای دارد و به عمق آن نمی‌رسد."],[730,"زانکه آتش را علف جز پوست نیست","قهر حقّ آن کبر را پوستین‌کنیست","آتش جز از مواد اولیه‌ای مثل علف و پوست برنمی‌خیزد، بنابراین قهر و خشم خداوند می‌تواند کسی که به تکبر و خودبزرگ‌بینی افتاده را به سرعت از آن حالت خارج کند و او را در برابر حقیقت قرار دهد."],[730,"این تکبّر از نتیجه پوستست","جاه و مال آن کبر را زان دوستست","این تکبر از نتیجه ظاهری و سطحی است که به خاطر جاه و مال به وجود آمده و آن خودبرتربینی به خاطر دوستی با این چیزهاست."],[730,"این تکبّر چیست غفلت از لباب","منجمد چون غفلت یخ ز آفتاب","تکبر به‌معنای غفلت از درون و حقیقت خود است، مانند یخ که در برابر آفتاب از خود بی‌خبر می‌ماند و ذوب نمی‌شود."],[730,"چون خبر شد ز آفتابش یخ نماند","نرم گشت و گرم گشت و تیز راند","زمانی که یخ از تابش آفتاب آگاه می‌شود، دیگر باقی نمی‌ماند و نرم، گرم و سریع می‌شود."],[730,"شد ز دید لبّ جمله تن طمع","خوار و عاشق شد که ذلّ من طمع","از دیدن باطن خود، همه خواسته‌ها و آرزوهایش ذلیل و بی‌ارزش می‌شود و عاشق می‌گردد، زیرا کسی که طمع می‌ورزد، در حقیقت خود را خوار کرده است."],[730,"چون نبیند مغز قانع شد به پوست","بند عزّ من قنع زندان اوست","هرگاه آدمی مغز (جان یا حقیقت) را نبیند و به ظاهر (پوست) قانع شود، در واقع به بند عزّت قناعت گرفتار آمده که همان زندان اوست."],[730,"عزّت اینجا گبریست و ذلّ دین","سنگ تا فانی نشد کی شد نگین","عزت در اینجا به معنای بزرگ‌منشی و شرافت است که به گبر (بی‌دینی) نسبت داده شده و ذلت دین به مانند سنگ است. تا زمانی که این ذلت از بین نرود، چگونه می‌تواند به درخشندگی و ویژگی خاص (نگین) تبدیل شود؟"],[730,"در مقام سنگی آنگاهی انا","وقت مسکین گشتن تست وفنا","در مقام و جایگاه سنگ، وقتی تو به حالت مسکینی و فنا می‌رسی، یعنی وقتی دچار ذلت و ناتوانی می‌شوی."],[730,"کبر زان جوید همیشه جاه و مال","که ز سرگینست گلخن را کمال","کبر (تکبر) همیشه به دنبال مقام و ثروت است، زیرا مانند گل‌ها که از فضولات به وجود می‌آیند، این ویژگی ناپسند نیز از دلایل پست و ناپاک به ظهور می‌رسد."],[730,"کین دو دایه پوست را افزون کنند","شحم و لحم و کبر و نخوت آکنند","این بیت اشاره به این دارد که دو دایه (پرورندگان) که در اینجا به مال و جاه اشاره دارند، به ظاهر فقط پوست و ظاهری را اضافه می‌کنند، در حالی که در باطن خود، چیزهای منفی مثل کبر (تکبر)، نخوت (حسادت و غرض) و لحم و شحم (چربی و گوشت) را می‌افزایند که نشان‌دهنده‌ی انباشت صفات زشت در انسان است."],[730,"دیده را بر لبّ لبّ نفراشتند","پوست را زان روی لبّ پنداشتند","چشم‌ها را به عمق و باطن حقیقت باز کردند، اما تنها پوست ظاهری را دیدند و از آن، به باطن یا حقیقت پی نبردند."],[730,"پیشوا ابلیس بود این راه را","کو شکار آمد شبیکه جاه را","ابلیس پیشوای این راه است، زیرا او مانند یک شکارچی برای فریب دادن و به دام انداختن جاه و مقام می‌آید."],[730,"مال چون مارست و آن جاه اژدها","سایه مردان زمرّد این دو را","مال مانند مار است و آن مقام و جاه، اژدهایی است که سایه مردان بزرگ را در بر می‌گیرد."],[730,"زان زمرّد مار را دیده جهد","کور گردد مار و ره‌رو وا رهد","وقتی از زمرّد (جواهر، ثروت) به مانند مار یاد می‌شود، آن را نشان می‌دهد که ثروت می‌تواند مانند مار خطرناک باشد. اگر کسی به این خطر توجه نکند، ممکن است کور شود؛ یعنی بینش خودش را از دست بدهد و در راهی نادرست گام نهد."],[730,"چون برین ره خار بنهاد آن رئیس","هر که خست او گفته لعنت بر بلیس","وقتی آن رئیس (ابلیس) بر این راه، خارهایی گذاشت، هر کس به او (ابلیس) آسیب بزند، به او لعنت می‌فرستد."],[730,"یعنی این غم بر من از غدر ویست","غدر را آن مقتدا سابق‌پیست","این غم و اندوهی که من دارم، از خیانت اوست، و خیانت همیشه از طرف پیشوایانی چون او آغاز می‌شود."],[730,"بعد ازو خود قرن بر قرن آمدند","جملگان بر سنّت او پا زدند","پس از آن، نسل‌ها و قرن‌های متمادی پی‌درپی آمدند و همه بر راه و شیوه او پا گذاشتند."],[730,"هر که بنهد سنّت بد ای فتا","تا در افتد بعد او خلق از عمی","هر کس که پایه‌گذار سنت بدی باشد، پس از او مردم در جهالت و بی‌خبری خواهند افتاد."],[730,"جمع گردد بر وی آن جمله بزه","کو سری بودست و ایشان دم‌غزه","اگر کسی سنّت بدی را بنا کند، افراد زیادی به او و کارهایش ملحق می‌شوند، همان‌گونه که یک بز با وجود سرش، به گروهی از بزها که دم دارند، می‌پیوندد."],[730,"لیک آدم چارق و آن پوستین","پیش می‌آورد که هستم ز طین","اما آدم با آن چرم خاص و پوستین، اشاره می‌کند که من از خاک آفریده شده‌ام."],[730,"چون ایاز آن چارقش مورود بود","لاجرم او عاقبت محمود بود","ایاز، که یکی از خدمت‌گزاران و دوستان شاه محمود غزنوی بود، با وجود اینکه کارشناس و تازه‌کار در کارهای خود نبود، در نهایت به خاطر تلاش و صداقت‌اش در خدمت به محمود، مورد احترام و ستایش قرار گرفت."],[730,"هست مطلق کارساز نیستیست","کارگاه هست‌کن جز نیست چیست","وجود مطلق، کارساز و نقطه آغاز هر چیزی است. هیچ چیز غیر از او نمی‌تواند هستی پیدا کند و تنها اوست که جهان را به حرکت در می‌آورد."],[730,"بر نوشته هیچ بنویسد کسی","یا نهاله کارد اندر مغرسی","تا حالا دیده‌اید که کسی روی یک (کاغذ) نوشته (شده) چیزی بنویسد؟! یا اینکه نهالی را در جایی که نهالی در آنجا کاشته شده، بکارد؟!"],[730,"کاغذی جوید که آن بنوشته نیست","تخم کارد موضعی که کشته نیست","انسان به دنبال کاغذی می‌گردد که روی آن چیزی نوشته نشده باشد، همچنین در جایی تخم می‌کارد که (پیش از این) در آنجا تخمی کاشته نشده باشد."],[730,"تو برادر موضعی ناکشته باش","کاغذ اسپید نابنوشته باش","تو باید درون خود را خالی و آماده نگه‌داری تا مانند یک کاغذ سفید و خالی از نوشته، پذیرای حکمت‌ها و دانش‌های نوین باشی."],[730,"تا مشرّف گردی از نون والقلم","تا بکارد در تو تخم آن ذوالکرم","تا زمانی که با خوراک نیکی و علم آشنا نشوی، در وجود تو بذر خیر و نیکی کاشته نخواهد شد."],[730,"خود ازین پالوده نالیسیده گیر","مطبخی که دیده‌ای نادیده گیر","خودت را از این پولکی که درست کرده‌ای فریب نده و به کسی که در این کار ویرانگری نادان است، دل ببند."],[730,"زانک ازین پالوده مستی‌ها بود","پوستین و چارق از یادت رود","زیرا از این خوشی‌ها و مستی‌ها، قید و بندهایی مانند پوست و کفش راحتی فراموش می‌شود و به یاد نمی‌آید."],[730,"چون در آید نزع و مرگ آهی کنی","ذکر دلق و چارق آنگاهی کنی","وقتی که زمان مرگ و جدایی از دنیا برسد، آن‌قدر غمگین می‌شوی که به یاد لباس و پوشش دنیوی‌ات می‌افتی."],[730,"تا نمانی غرق موج زشتیی","که نباشد از پناهی پشتیی","تا زمانی که در دنیای زشتی غرق نشوی، از پناهی حمایت‌کننده و امنیت‌بخش برخوردار نخواهی بود."],[730,"یاد ناری از سفینه راستین","ننگری در چارق و در پوستین","به یاد آتش (نار) سفینه یا کشتی حقیقی (راستین) باش و به ظواهر و پوشش‌های سطحی (چارق و پوستین) نگاه نکن."],[730,"چونکه درمانی به غرقاب فنا","پس ظلمنا ورد سازی بر ولا","هرگاه که درمانی بر غرقاب فنا پیدا نشود، پس ما ظلم کردیم و با دعا و ذکر به مقام والایی نخواهیم رسید."],[730,"دیو گوید بنگرید این خام را","سر برید این مرغ بی‌هنگام را","دیو به دیگران می‌گوید به این انسان نادان نگاه کنید و سر او را ببرید، مانند مرغی که در زمان نادرست و بی‌هدف پرواز می‌کند."],[730,"دور این خصلت ز فرهنگ ایاز","که پدید آید نمازش بی‌نماز","این خصیصه که در ایاز (خدمتگزار دلسوز و وفادار) وجود ندارد، باعث می‌شود که نمازی که او می‌خواند، بی‌معنا و بی‌فایده باشد."],[730,"او خروس آسمان بوده ز پیش","نعره‌های او همه در وقت خویش","این خروس که به آسمان اشاره دارد، به خاطر صدای بلندش در زمان مناسب شهرت دارد و به نوعی برتری دارد، زیرا قبل از طلوع آفتاب نعره می‌زند و دیگران را بیدار می‌کند."],[731,"ای خروسان از وی آموزید بانگ","بانگ بهر حقّ کند نه بهر دانگ","ای خروس‌ها، از او (حق) بیاموزید که صدای شما باید به خاطر خدا باشد، نه برای کسب محبوبیت یا شهرت."],[731,"صبح کاذب آید و نفریبدش","صبح کاذب عالم و نیک و بدش","صبح کاذب، که به معنای صبح دروغین است، به وجود می‌آید و انسان‌ها را فریب می‌دهد، همچنین صبح دروغینی که عالم را شامل شده و خوب و بد را در آن می‌توان دید."],[731,"اهل دنیا عقل ناقص داشتند","تا که صبح صادقش پنداشتند","آدم‌های دنیوی عقل ناقصی دارند و به همین دلیل صبح حقیقی و واقعی را نمی‌شناسند و جای آن، صبح کاذب را می‌پندارند."],[731,"صبح کاذب کاروان‌ها را زدست","که به بوی روز بیرون آمدست","صبح کاذب (صبح دروغین) باعث شده است که کاروان‌ها از مسیر خود خارج شوند، زیرا توهمی از روز به آن‌ها دست داده و نتوانسته‌اند به درستی راه را ببینند."],[731,"صبح کاذب خلق را رهبر مباد","کو دهد بس کاروان‌ها را به باد","صبح کاذب، که نمایانگر واقعیت‌هایی نادرست و فریبنده است، نباید سرپرستی خلق را بر عهده بگیرد، زیرا او باعث می‌شود کاروان‌ها (زندگی یا انسان‌ها) به بی‌راهه بروند و نابود شوند."],[731,"ای شده تو صبح کاذب را رهین","صبح صادق را تو کاذب هم مبین","تو که هم‌اکنون در صبح کاذب هستی، هیچ‌گاه در انتظار صبح صادق نباش. در واقع به خوبی تشخیص نمی‌دهی که صبح حقیقی چیست و در اشتباه به سر می‌بری."],[731,"گر نداری از نفاق و بد امان","از چه داری بر برادر ظن همان","اگر خود در درونت نفاق و بدی نداشته باشی، پس چرا به برادرت بدگمان هستی؟ تو همان چیزی را در او می‌بینی که در وجود خودت وجود دارد."],[731,"بدگمان باشد همیشه زشت‌کار","نامه خود خواند اندر حقّ یار","بدگمان همیشه به دیگران، فردی زشت‌کار محسوب می‌شود و در حقیقت، خودش را مسئول و در حق یار خود بد می‌بیند."],[731,"آن خسان که در کژی‌ها مانده‌اند","انبیا را ساحر و کژ خوانده‌اند","افرادی که در کجی‌ها و اشتباهات خود باقی مانده‌اند، پیروان انبیا را جادوگر و منحرف توصیف کرده‌اند."],[731,"وآن امیران خسیس قلب‌ساز","این گمان بردند بر حجره ایاز","امیران بخیل و طمع‌کار، که قلب‌هایشان را با دنیاپرستی می‌سازند، فکر کردند که ایاز (یار و خدمت‌گذار سامانی) در نظر آن‌ها ارزش چندانی ندارد و در حجره او به خاطر طمع و خودبینی، او را دست کم گرفتند."],[731,"کو دفینه دارد و گنج اندر آن","ز آینه خود منگر اندر دیگران","هر کس که در وجود خود گنج و ارزش‌های پنهانی دارد، نباید به نقص‌های دیگران توجه کند و فقط به آینه‌ی خود بنگرد."],[731,"شاه می‌دانست خود پاکیّ او","بهر ایشان کرد او آن جست و جو","شاه، که در اینجا به خداوند اشاره دارد، می‌دانست که پاکی او به خاطر خلق است و برای آنها بود که در جست‌وجو و طلب حقیقت هستند."],[731,"کای امیر آن حجره را بگشای در","نیم‌شب که باشد او زان بی‌خبر","ای امیر، در نیمه‌های شب آن اتاق را باز کن، زیرا او (شخصی که در آنجا است) از این موضوع بی‌خبر است."],[731,"تا پدید آید سگالش‌های او","بعد از آن بر ماست مالش‌های او","این بیت بیان می‌کند که ویژگی‌ها و خصایص هر موجودی بعد از وقوع، برای ما آشکار می‌شود و در واقع، آنچه که او (موجود) دارد و به ما می‌دهد، بر عهده ماست که چگونه با آن برخورد کنیم و درک کنیم."],[731,"مر شما را دادم آن زرّ و گهر","من از آن زرها نخواهم جز خبر","من به شما آن طلا و جواهر را دادم، اما از آن جواهرات تنها خبر و خبرگیری را می‌خواهم."],[731,"این همی‌گفت و دل او می‌طپید","از برای آن ایاز بی‌ندید","او این حرف‌ها را می‌زد و دلش به خاطر ایاز (یار و دوستش) که او را نمی‌دید، تپش داشت."],[731,"که منم کاین بر زبانم می‌رود","این جفا گر بشنود او چون شود","من چطور می‌توانم بگویم که چه کسی هستم وقتی این سخنان از زبانم بیرون می‌آید؟ اگر او (یعنی خدا یا حقیقت) این را بشنود، چه حالتی به او دست می‌دهد؟"],[731,"باز می‌گوید به حقّ دین او","که ازین افزون بود تمکین او","مولانا در این بیت بیان می‌کند که به راستی اعتقاد و پایبندی به دین خدا باید بیشتر و عمیق‌تر از آنچه که اکنون شاهد آن هستیم، باشد. به نوعی، تاکید دارد که شناخت و پذیرش دین باید از طریق معرفت و عمق بیشتری تحقق یابد."],[731,"کی به قذف زشت من طیره شود","وز غرض وز سرّ من غافل بود","هرگز به خاطر سخنان ناپسند من، کسی به اشتباه نیفتد و از روی نیت بد و نادانی درباره‌ام قضاوت نکند."],[731,"مبتلی چون دید تاویلات رنج","برد بیند کی شود او مات رنج","آدم مبتلا که رنج و درد را می‌بیند، هرگز نمی‌داند که چه زمانی این رنج‌ها به پایان می‌رسد و او از آن آزاد خواهد شد."],[731,"صاحب تاویل ایاز صابرست","کو به بحر عاقبت‌ها ناظرست","صاحب تاویل (تعبیرکننده خواب) ایاز صابر است، که به عمق و پایان امور و نتایج آنها توجه دارد. ایاز در اینجا به معنای فردی باهوش و صبور است که می‌تواند واقعیت‌ها را به خوبی درک کند."],[731,"هم‌چو یوسف خواب این زندانیان","هست تعبیرش به پیش او عیان","به مانند یوسف که خواب زندانیان را تعبیر کرد، تعبیر خواب این انسان‌ها نیز برای او (یوسف) روشن و نمایان است."],[731,"خواب خود را چون نداند مرد خیر","کو بود واقف ز سرّ خواب غیر","مرد نیکوکار که خواب خودش را نمی‌داند، چگونه می‌تواند به راز خواب دیگری آگاه باشد؟"],[731,"گر زنم صد تیغ او را ز امتحان","کم نگردد وصلت آن مهربان","اگر من صد بار هم او را آزمایش کنم، از ارتباط با آن مهربان کم نمی‌شود."],[731,"داند او که آن تیغ بر خود می‌زنم","من ویم اندر حقیقت او منم","او (عشق یا معشوق) می‌داند که این زخم‌هایی که بر خودم می‌زنم، در واقع به خودم آسیب می‌زند؛ زیرا در حقیقت، من همان او هستم."],[732,"جسم مجنون را ز رنج و دوریی","اندر آمد ناگهان رنجوریی","بدن مجنون ناگهان از رنج و دوری به شدت بیمار شد و وضع او وخیم گشت."],[732,"خون بجوش آمد ز شعله اشتیاق","تا پدید آمد بر آن مجنون خناق","از شدت عشق و اشتیاق، خون مجنون به جوش آمد و این شدت احساس باعث شد که او دچار خناق (تنگی نفس) شود."],[732,"پس طبیب آمد بدارو کردنش","گفت چاره نیست هیچ از رگ‌زنش","طبابت آمد تا مجنون را درمان کند، اما گفت که راهی جز رگ‌زدن برای او نیست."],[732,"رگ زدن باید برای دفع خون","رگ‌زنی آمد بدانجا ذو فنون","رگ زدن (خون‌گیری) باید برای درمان بیماری انجام شود و فردی که مهارت‌های مختلفی دارد، یعنی ذو فنون، به آنجا آمده است تا این عمل را انجام دهد."],[732,"بازوش بست و گرفت آن نیش او","بانک بر زد در زمان آن عشق‌خو","معشوق با تمام شدت و حساسی که دارد، عاشق را در آغوش می‌گیرد و در آن لحظه‌ی عشق، بانگ شوقی برمی‌زند که نشان‌دهنده‌ی عمق احساسات آن‌هاست."],[732,"مزد خود بستان و ترک فصد کن","گر بمیرم گو برو جسم کهن","مزد خود را بگیر و دیگر خون‌گیری (فصد کردن) نکن. اگر من بمیرم، بگو برو به جسم قدیمی (که در حال حاضر زنده است)."],[732,"گفت آخر از چه می‌ترسی ازین","چون نمی‌ترسی تو از شیر عرین","چرا از این موجود بی‌خطر می‌ترسی در حالی که از شیر وحشی که خطرناک است، نمی‌ترسی؟"],[732,"شیر و گرگ و خرس و هر گور و دده","گرد بر گرد تو شب گرد آمده","حیواناتی مانند شیر، گرگ و خرس در اطرافت جمع شده‌اند و منتظر تو هستند. این بیان نشان‌دهنده‌ی مشکلات و خطراتی است که در زندگی‌ات وجود دارد و باید به آن‌ها توجه کنی."],[732,"می نه آیدشان ز تو بوی بشر","ز انبهی عشق و وجد اندر جگر","از تو بو و عطر انسانی نمی‌آید، بلکه عشق و شوق به جان و دل آنها رسوخ کرده است."],[732,"گرگ و خرس و شیر داند عشق چیست","کم ز سگ باشد که از عشق او عمیست","عشق و محبت را حتی حیوانات مانند گرگ، خرس و شیر می‌شناسند، اما آن‌قدر عمیق و واقعی نیستند، چون عشق سگ نسبت به صاحبش به مراتب عمیق‌تر و پاک‌تر است."],[732,"گر رگ عشقی نبودی کلب را","کی بجستی کلب کهفی قلب را","اگر عشق در وجود تو نبود، چگونه می‌توانستی به دل انسان‌ها نزدیک شوی؟ تو همانند سگی هستی که در قلب دیگران جا دارد."],[732,"هم ز جنس او به صورت چون سگان","گر نشد مشهور هست اندر جهان","عاشق و معشوق از نظر وجودی و حقیقی به هم مرتبط هستند، اما از نظر ظاهری و شکل، همچون سگان که فقط به خاطر جنس مشترکشان در عالم شناخته نمی‌شوند، به یکدیگر توجه ندارند."],[732,"بو نبردی تو دل اندر جنس خویش","کی بری تو بوی دل از گرگ و میش","اگر تو در جنس خودت دل نبری، چگونه می‌توانی بویی از دل یک گرگ یا میش (که نماد عشق و عواطف هستند) حس کنی؟ این بیت به ارتباط عمیق میان عشق و عواطف اشاره دارد و می‌گوید که تنها از جنس عشق چیزهایی را حس می‌کنیم."],[732,"گر نبودی عشق هستی کی بدی","کی زدی نان بر تو و کی تو شدی","اگر عشق وجود نداشت، تو چه هستی و چگونه زنده‌ای؟ چه کسی به تو غذا می‌دهد و تو چگونه به وجود می‌آیی؟"],[732,"نان تو شد از چه ز عشق و اشتها","ورنه نان را کی بدی تا جان رهی","نان تو به خاطر عشق و تمایل به آن شده است، در غیر این صورت نان چه ارزشی دارد که تو به آن دست یابی و جان خود را از آن جدا کنی؟"],[732,"عشق نان مرده را می جان کند","جان که فانی بود جاویدان کند","عشق، زندگی و وجودی که از بین رفته است را دوباره جان می‌بخشد و آن را جاودانه می‌سازد، حتی اگر آن وجود فانی و زودگذر باشد."],[732,"گفت مجنون من نمی‌ترسم ز نیش","صبر من از کوه سنگین هست بیش","مجنون می‌گوید که از زخم‌ها و آزارها نمی‌ترسد، زیرا صبر من از کوه سخت‌تر و سنگین‌تر است."],[732,"منبلم بی‌زخم ناساید تنم","عاشقم بر زخمها بر می‌تنم","من بدون زخم و درد به زندگی ادامه نمی‌دهم، عاشق زخم‌هایم هستم و به آنها احترام می‌گذارم."],[732,"لیک از لیلی وجود من پرست","این صدف پر از صفات آن درست","اما وجود من هم‌چون لیلی، محبوب و دل‌خواهم است و روح من مانند صدفی است که پر از صفات زیباست."],[732,"ترسم ای فصاد گر فصدم کنی","نیش را ناگاه بر لیلی زنی","نگران هستم که ای عطار (عاشق) مرا به ناگاه آسیب برسانی و نیشی به عشق لیلی بزنی، یعنی آسیبی به محبوبیت من برسانی."],[732,"داند آن عقلی که او دل‌روشنیست","در میان لیلی و من فرق نیست","عقل و دانش می‌دانند که در حقیقت، میان من و لیلی هیچ تفاوتی وجود ندارد؛ هر دوی ما به یکدیگر وابسته‌ایم و این وابستگی به روشنایی دل من اشاره دارد."],[733,"گفت معشوقی به عاشق ز امتحان","در صبوحی کای فلان ابن الفلان","معشوق به عاشق گفت: برای آزمایش تو در روز روشن، می‌خواهم بپرسم که تو کیستی، ای فلان پسر فلان."],[733,"مر مرا تو دوست‌تر داری عجب","یا که خود را راست گو یا ذا الکرب","همه چیز به من مربوط است، ولی تو آیا بیشتر از من، مرا دوست داری یا خود را؟ اگر راست می‌گویی، من را دوست بدار یا برای من کمکی کن که در اضطراب و شدت زندگی سردرگم نشوم."],[733,"گفت من در تو چنان فانی شدم","که پرم از تو ز ساران تا قدم","عاشق می‌گوید من چنان در تو غرق شدم که وجودم پر از تو شده، حتی تا حدی که از سر تا پایم فقط تو هستی."],[733,"بر من از هستی من جز نام نیست","در وجودم جز تو ای خوش‌کام نیست","در من چیزی از وجود خودم جز نام و عنوانی باقی نمانده و در واقع در وجودم فقط تو، ای خوشبخت، حضور داری."],[733,"زان سبب فانی شدم من این چنین","هم‌چو سرکه در تو بحر انگبین","به همین دلیل من از وجود خودم فانی شده‌ام و به این حالت درآمده‌ام، مانند سرکه که در دریاچه‌ای از عسل حل می‌شود و دیگر آنچه از خود دارد را فراموش می‌کند."],[733,"هم‌چو سنگی کو شود کل لعل ناب","پر شود او از صفات آفتاب","همان‌طور که سنگی با ارزش، با نور آفتاب پر می‌شود و صفات روشنی و زیبایی را به خود می‌گیرد، انسان نیز می‌تواند با محبت و صفات معشوق خود پر شود و به کمال برسد."],[733,"وصف آن سنگی نماند اندرو","پر شود از وصف خور او پشت و رو","این بیت می‌گوید که وصف و ویژگی‌های سنگ دیگر در آن باقی نمی‌ماند و وقتی که به نور خورشید می‌رسد، همه چیز متفاوت می‌شود. سنگ با جلوه آفتاب، چهره‌ای جدید پیدا می‌کند و دیگر به صفات خود شناخته نمی‌شود."],[733,"بعد از آن گر دوست دارد خویش را","دوستی خور بود آن ای فتا","اگر کسی خود را دوست داشته باشد، در حقیقت دوستی او با خداوند را نیز نشان می‌دهد و این به مانند دوستی عشق الهی است."],[733,"ور که خور را دوست دارد او بجان","دوستی خویش باشد بی‌گمان","کسی که خورشید را دوست داشته باشد، به‌طور حتم جانش متوجه دوستی خود خواهد بود و نمی‌تواند به آن عشق و محبت بی‌اعتنا باشد."],[733,"خواه خود را دوست دارد لعل ناب","خواه تا او دوست دارد آفتاب","اگر کسی خود را چون لعل ناب دوست دارد، یعنی درخشندگی و زیبایی خودش را می‌پسندد، باید بداند که در حقیقت باید آفتاب را دوست داشته باشد، چرا که این دوستی در نهایت به یکدیگر مرتبط است."],[733,"اندرین دو دوستی خود فرق نیست","هر دو جانب جز ضیای شرق نیست","در این نوع دوستی که از عشق به وجود آمده، هیچ تفاوت و جدایی وجود ندارد؛ زیرا هر دو طرف تنها نور و روشنی عشق را در سوی شرقی خود می‌تابانند."],[733,"تا نشد او لعل خود را دشمنست","زانک یک من نیست آنجا دو منست","تا زمانی که او خود را دوست نداشته باشد، دشمن خود است؛ زیرا در آنجا تنها یک «من» وجود ندارد و دو «من» وجود دارد."],[733,"زانک ظلمانیست سنگ و روزکور","هست ظلمانی حقیقت ضد نور","چرا که سنگ در تاریکی است و روز کور (که قادر به دیدن نور نیست) نیز در تاریکی است. حقیقت تاریکی برعکس نور است."],[733,"خویشتن را دوست دارد کافرست","زانک او مناع شمس اکبرست","کسی که خود را دوست دارد کافر است، زیرا او مانع تابش نور بزرگتر (خدا) شده است."],[733,"پس نشاید که بگوید سنگ انا","او همه تاریکیست و در فنا","نمی‌توان گفت که سنگ می‌گوید «من هستم» چون او فقط تاریکی و نیستی است و در حال فنا قرار دارد."],[733,"گفت فرعونی انا الحق گشت پست","گفت منصوری اناالحق و برست","فرعون با گفتن \"من هستم حق\" به مقام پستی رسید و در واقع سقوط کرد، در حالی که منصور حلاج با گفتن این عبارت به مقام بلند و علو دست یافت و آزاد شد."],[733,"آن انا را لعنة الله در عقب","وین انا را رحمةالله ای محب","آن «من» که فرعون می‌گفت و در نتیجه لعنت خدا را به دنبال داشت، جایی عقب‌تر است و این «من» که عاشق می‌گوید، رحمت خدا برای تو ای محبوب است."],[733,"زانک او سنگ سیه بد این عقیق","آن عدوی نور بود و این عشیق","چون او سنگ سیاه است، این عقیق (که سنگی باارزش و روشن است) دشمن نور است و این عاشق (که باید در مقابل او تسلیم شود) نیز به‌نوعی به حیات و روشنایی تبدیل می‌شود."],[733,"این انا هو بود در سر ای فضول","ز اتحاد نور نه از رای حلول","این عبارت به مفهوم وجود عمیق و اتحاد بین عاشق و معشوق اشاره دارد، که در آن وجود معشوق به نوعی وجود عاشق را تکمیل می‌کند. در واقع، این اتحاد ناشی از روشنایی و نور است و نه از حلول یا نشستن یکی در دیگری، بلکه به معنای پیوندی پر نور و یکپارچه است."],[733,"جهد کن تا سنگیت کمتر شود","تا به لعلی سنگ تو انور شود","کوشش کن تا سختی‌ها و سنگینی‌هایت کم‌تر شود تا بتوانی به لطافت و زیبایی و ارزش واقعی خود نزدیک‌تر شوی."],[733,"صبر کن اندر جهاد و در عنا","دم به دم می‌بین بقا اندر فنا","در سختی‌ها و مبارزات صبر کن و سماجت داشته باش، زیرا در هر لحظه، بقا و جاودانگی را در نابودی و فنا می‌توان یافت."],[733,"وصف سنگی هر زمان کم می‌شود","وصف لعلی در تو محکم می‌شود","هر چه از ویژگی‌های سخت و بی‌روح مانند سنگ کاسته می‌شود، صفات زیبا و ارزشمندی چون ویژگی‌های یک گوهر گرانبها (عقیق) در وجود تو محکم‌تر و واضح‌تر می‌گردد."],[733,"وصف هستی می‌رود از پیکرت","وصف مستی می‌فزاید در سرت","حالت وجودی و زندگی‌ات از میان می‌رود و حالتی از مستی و عشق به معشوق در تو افزایش می‌یابد."],[733,"سمع شو یکبارگی تو گوش‌وار","تا ز حلقه لعل یابی گوشوار","یک بار تمام حواست را جمع کن، تا بتوانی به آن حقیقت زیبا و ارزشمند که مانند گوشواره‌ای از یک حلقه لعل (جواهر) است، دست یابی و آن را بشنوی."],[733,"هم‌چو چه کن خاک می‌کن گر کسی","زین تن خاکی که در آبی رسی","اگر کسی به سراغ تو بیاید که در این بدن خاکی گرفتار است، همانند خاکی در آب شو و از خودت بگذری."],[733,"گر رسد جذبه خدا آب معین","چاه ناکنده بجوشد از زمین","اگر کشش و جذب الهی به انسان برسد، حتی آب چاه‌های نکنیده هم از زیر زمین جوش می‌زند و بیرون می‌آید."],[733,"کار می‌کن تو بگوش آن مباش","اندک اندک خاک چه را می‌تراش","شکست و تغییرات تدریجی را دیده‌ام، پس در کارهای خود درنگ نکن و به آرامی از زمین سنگ‌ها و خاک‌ها را برطرف کن تا کار به پیش برود."],[733,"هر که رنجی دید گنجی شد پدید","هر که جدی کرد در جدی رسید","هر کسی که در زندگی سختی و رنجی را تحمل کند، پاداش یا بهره‌ای به دست می‌آورد. کسی که در تلاش و کوشش جدی باشد، به هدف و موفقیت اهتمام می‌ورزد و به آن می‌رسد."],[733,"گفت پیغمبر رکوعست و سجود","بر در حق کوفتن حلقه وجود","پیغمبر گفت که رکوع و سجود در حقیقت به معنای کوبیدن به درگاه حق و طلب یاری از اوست؛ این اشاره به استجابت دعا و نزدیک شدن به وجود الهی دارد."],[733,"حلقه آن در هر آنکو می‌زند","بهر او دولت سری بیرون کند","هر کسی که به در آن معشوق (خدا) ضربه می‌زند و به در می‌کوبد، به خاطر او، ثروت و نعمت پنهانی به سوی او خارج می‌شود."],[734,"آن امینان بر در حجره شدند","طالب گنج و زر و خمره بدند","آن مأموران کنار در حجره رفتند؛ چون در پی گنج و طلا و خمره‌های سکه بودند."],[734,"قفل را برمی‌گشادند از هوس","با دو صد فرهنگ و دانش چند کس","چند نفر با همه دانش و مهارتی که داشتند، دست به کار شدند و با هزار امید و هوس می‌خواستند قفل را باز کنند."],[734,"زانکه قفل صعب و پر پیچیده بود","از میان قفل‌ها بگزیده بود","چون قفل بسیار سخت و پیچیده بود و از میان همه قفل‌ها، ایاز عمدا سخت‌ترینش را انتخاب کرده بود."],[734,"نه ز بخل سیم و مال و زرّ خام","از برای کتم آن سرّ از عوام","این کار نه از روی بخل نسبت به سیم و زر بود، بلکه برای آن بود که آن راز را از مردم عادی پنهان نگه دارد؛"],[734,"که گروهی بر خیال بد تنند","قوم دیگر نام سالوسم کنند","چون عده‌ای ممکن بود درباره آن بدگمان شوند و عده‌ای دیگر ایاز را آدمی ریاکار و حیله‌گر بدانند."],[734,"پیش با همّت بود اسرار جان","از خسان محفوظ‌تر از لعل کان","آدم‌های باهمت، رازهای روح و جان را، از گوهرهای گران‌بهای افراد بخیل هم بهتر حفظ می‌کنند. ایاز هم چنین آدمی بود."],[734,"زر به از جانست پیش ابلهان","زر نثار جان بود نزد شهان","برای آدم‌های نادان، طلا از جان باارزش‌تر است؛ اما نزد بزرگان، طلا باید فدای جان و انسانیت شود."],[734,"حرص تازد بیهده سوی سراب","عقل گوید نیک بین که آن نیست آب","حرص، آدم را بیهوده به سوی سراب می‌کشاند، اما عقل می‌گوید: خوب نگاه کن، آنچه می‌بینی آب نیست."],[734,"حرص غالب بود و زر چون جان شده","نعره عقل آن زمان پنهان شده","وقتی حرص بر آدم غلبه کند و طلا برایش مثل جان عزیز شود، صدای عقل دیگر شنیده نمی‌شود."],[734,"گشته صدتو حرص و غوغاهای او","گشته پنهان حکمت و ایمای او","حرص، چندین برابر نیرومند و پرهیاهو می‌شود و در مقابل، خرد و اندرزهای عقل پنهان می‌ماند."],[734,"تا که در چاه غرور اندر فتد","آنگه از حکمت ملامت بشنود","تا اینکه آدم در چاه غرور و خودفریبی سقوط کند؛ آن وقت تازه می‌تواند صدای سرزنش حکمت و عقل را بشنود."],[734,"چون ز بند دام باد او شکست","نفس لوّامه برو یابید دست","وقتی از بند دام هوس و فریب رها شد و باد غرورش شکست، «نفس سرزنشگر» در درونش بیدار می‌شود و او را ملامت می‌کند."],[734,"تا به دیوار بلا ناید سرش","نشنود پند دل آن گوش کرش","اما تا وقتی سرش به دیوار گرفتاری نخورد، آن گوش ناشنوایش پند دل و عقل را نمی‌شنود."],[734,"کودکان را حرص گوزینه و شکر","از نصیحت‌ها کند دو گوش کر","کودکان وقتی هوس شیرینی و شکر می‌کنند، آن‌قدر غرق این میل می‌شوند که به نصیحت‌ها گوش نمی‌دهند."],[734,"چونکه درد دنبلش آغاز شد","در نصیحت هر دو گوشش باز شد","اما وقتی درد دملشان شروع می‌شود، هر دو گوششان برای شنیدن نصیحت باز می‌شود."],[734,"حجره را با حرص و صد گونه هوس","باز کردند آن زمان آن چند کس","آن چند نفر، با حرص و صد جور هوس، سرانجام حجره را باز کردند."],[734,"اندر افتادند از در ز ازدحام","هم‌چو اندر دوغ گندیده هوام","از شدت ازدحام و هجوم، به طور ناخواسته داخل اتاق می‌افتند؛ چنان‌که گویی در دوغ فاسد، حشرات و کرم‌ها به هم می‌لولند."],[734,"عاشقانه در فتد با کرّ و فرّ","خورد امکان نیّ و بسته هر دو پر","با شور و شتاب و هیاهو داخل شدند، با اینکه در اثر ازدحام عملا انگار هر دو دستشان بسته شده بود."],[734,"بنگریدند از یسار و از یمین","چارقی بدریده بود و پوستین","از چپ و راست نگاه کردند؛ جز یک جفت چارق پاره و یک پوستین چیزی ندیدند."],[734,"باز گفتند این مکان بی‌نوش نیست","چارق اینجا جز پی روپوش نیست","باز گفتند: «این‌جا نمی‌شود که هیچ چیزی برای بهره‌بردن نباشد؛ حتما این چارق‌ها فقط برای پوشاندن چیزی گذاشته شده‌اند»."],[734,"هین بیاور سیخ‌های تیز را","امتحان کن حفره و کاریز را","گفتند: «زود باشید، سیخ‌های تیز بیاورید؛ حفره‌ها و راه‌های زیرزمینی را هم بررسی کنید. شاید چیزی پشت دیوار یا زیر زمین مخفی کرده باشد»."],[734,"هر طرف کندند و جستند آن فریق","حفره‌ها کردند و گوهای عمیق","هر طرف را کندند و جست‌وجو کردند؛ حفره‌های فراوان و گودال‌های عمیق به وجود آوردند."],[734,"حفره‌هاشان بانگ می‌داد آن زمان","کنده‌های خالییم ای کندگان","اما هر حفره‌ای که می‌کندند، گویی به زبان حال می‌گفت: «ای کسانی که مرا می‌کنید، ما خالی هستیم! درون ما چیزی نیست»."],[734,"زان سگالش شرم هم می‌داشتند","کنده‌ها را باز می‌انباشتند","از اندیشه بد و بیهوده خودشان هم خجالت می‌کشیدند و دوباره گودال‌ها را پر می‌کردند."],[734,"بی‌عدد لا حول در هر سینه‌ای","مانده مرغ حرصشان بی‌چینه‌ای","در دل هرکدامشان بارها حسرت و «لا حول و لا قوه...» بود؛ مرغ حرصشان مانده بود بی‌دانه و بی‌غذا."],[734,"زان ضلالت‌های یاوه‌تازشان","حفره دیوار و در غمّازشان","از این گمراهی‌ها و جست‌وجوهای بیهوده‌ای که کرده بودند، حفره‌هایی که در دیوار و در ایجاد کرده بودند، خودشان بهترین گواه رسوایی و خطای آنان بود."],[734,"ممکن اندای آن دیوار نی","با ایاز امکان هیچ انکار نی","دیگر امکان نداشت آثار این کارها را از آن دیوار پنهان کنند؛ در حضور ایاز هم هیچ راهی برای انکار باقی نمانده بود."],[734,"گر خداع بی‌گناهی می‌دهند","حایط و عرصه گواهی می‌دهند","اگر هم می‌خواستند با فریب و دروغ، خود را بی‌گناه نشان دهند، دیوار و فضای اطراف، خودشان بر ضد آنان شهادت می‌دادند."],[734,"باز می‌گشتند سوی شهریار","پر ز گرد و روی‌زرد و شرمسار","سرانجام نزد شهریار برگشتند؛ در حالی که غبار بر سر و رویشان نشسته بود، رنگشان از شرمندگی پریده بود و سرافکنده و خجالت‌زده بودند."],[735,"شاه قاصد گفت هین احوال چیست","که بغلتان از زر و همیان تهیست","شاه به قاصد گفت: «بگو ببینم، ماجرا چیست؟ چرا کیسه‌هایتان از طلا و پول خالی است؟"],[735,"ور نهان کردید دینار و تسو","فرّ شادی در رخ و رخسار کو","اگر هم دینارها را پنهان کرده‌اید، پس این شادی و سرخوشی که باید در چهره‌تان باشد، کجاست؟»"],[735,"گرچه پنهان بیخ هر بیخ آورست","برگ سیماهم وجوهم اخضرست","هرچند ریشه و اصل هر درختی پنهان است، اما از برگ و ظاهرش می‌توان فهمید که ریشه سالم و زنده است."],[735,"آنچ خورد آن بیخ از زهر و ز قند","نک منادی می‌کند شاخ بلند","آنچه ریشه از زهر یا شیرینی و مواد گوناگون می‌گیرد، بالاخره شاخه بلند درخت آن را آشکار می‌کند."],[735,"بیخ اگر بی‌برگ و از مایه تهیست","برگهای سبز اندر شاخ چیست","اگر ریشه‌ای بی‌برگ و بی‌مایه و خشک باشد، پس این برگ‌های سبز روی شاخه از کجا آمده‌اند؟"],[735,"بر زبان بیخ گل مهری نهد","شاخ دست و پا گواهی می‌دهد","ریشه شاید بر زبانش مهر سکوت زده باشد، اما شاخه و برگ و اندام درخت، حقیقت را آشکار می‌کنند. (یعنی ممکن است آدم چیزی را پنهان کند، اما آثار و نشانه‌های کارش سرانجام حقیقت را نشان می‌دهند.)"],[735,"آن امینان جمله در عذر آمدند","هم‌چو سایه پیش مه ساجد شدند","آن مأموران، همگی شروع به عذرخواهی کردند و مانند سایه‌ای که در برابر ماه سر فرود می‌آورد، در برابر شاه با فروتنی سجده کردند."],[735,"عذر آن گرمی و لاف و ما و من","پیش شه رفتند با تیغ و کفن","از آن همه ادعا، خودبزرگ‌بینی و لاف زدن‌ها، عذرخواهی می‌کردند؛ و در برابر شاه، آماده بودند هر مجازاتی را بپذیرند."],[735,"از خجالت جمله انگشتان گزان","هر یکی می‌گفت کای شاه جهان","از شدت شرمندگی، انگشتان خود را می‌گزیدندو هرکدام می‌گفتند: «ای شاه جهان!"],[735,"گر بریزی خون حلالستت حلال","ور ببخشی هست انعام و نوال","اگر دستور بدهی خون ما ریخته شود، کاملا سزاوار و رواست؛ و اگر ما را ببخشی، این بخشش لطف و بزرگواری تو خواهد بود."],[735,"کرده‌ایم آنها که از ما می‌سزید","تا چه فرمایی تو ای شاه مجید","ما همان کاری را کرده‌ایم که از آدم‌هایی مثل ما برمی‌آمد؛ حالا دیگر هرچه تو، ای شاه بزرگوار، فرمان بدهی، همان را می‌پذیریم."],[735,"گر ببخشی جرم ما ای دل‌فروز","شب شبیها کرده باشد روز روز","اگر از روی لطف، گناه ما را ببخشی، ای شاه روشن‌دل، شب‌های تاریک زندگی ما را مانند روز روشن خواهی کرد."],[735,"گر ببخشی یافت نومیدی گشاد","ورنه صد چون ما فدای شاه باد","اگر ما را ببخشی، راهی برای رهایی ناامیدان باز خواهد شد؛ و اگر نبخشی، صدها نفر مثل ما فدای شاه باد»."],[735,"گفت شه نه این نواز و این گداز","من نخواهم کرد هست آن ایاز","شاه گفت: «نه؛ این نوازش و بخشش و این سخت‌گیری و مجازات، کار من نیست؛ ایاز خودش این کار را انجام خواهد داد»."],[736,"این جنایت بر تن و عرض ویست","زخم بر رگ‌های آن نیکوپیست","این گناه و جنایت، بر پیکر و آبروی ایاز زخم زده است؛ زخمی است که بر رگ‌های آن انسان نیک‌سرشت وارد شده است."],[736,"گرچه نفس واحدیم از روی جان","ظاهرا دورم ازین سود و زیان","هرچند از نظر روح و حقیقت، ما یک حقیقت انسانی داریم، اما در ظاهر، من از این سود و زیان‌ها دور و بی‌خبرم."],[736,"تهمتی بر بنده شه را عار نیست","جز مزید حلم و استظهار نیست","اگر بنده‌ای به شاه تهمتی بزند، این برای شاه ننگ و عیبی نیست؛ بلکه فقط نشان‌دهنده افزونی بردباری و بزرگواری اوست."],[736,"متّهم را شاه چون قارون کند","بی‌گنه را تو نظر کن چون کند","اگر شاه با متهمی مانند قارون رفتار کند، ببین با بی‌گناهی چگونه رفتار می‌کند و آن‌گاه خواهی فهمید که داوری شاه بر چه اساسی است."],[736,"شاه را غافل مدان از کار کس","مانع اظهار آن حلمست و بس","گمان نکن که شاه از کار هیچ‌کس بی‌خبر است؛ او از همه کارها آگاه است. فقط چیزی که مانع آشکار شدن آن حقیقت می‌شود، حلم و بردباری اوست."],[736,"من هنا یشفع به پیش علم او","لا ابالی‌وار الّا حلم او","چه کسی می‌تواند در برابر علم و آگاهی او شفاعت و میانجی‌گری کند؟ در برابر علم او، چیزی جز حلم و بردباری خودش وجود ندارد."],[736,"آن گنه اوّل ز حلمش می‌جهد","ورنه هیبت آن مجالش کی دهد","گناه، در همان آغاز، از حلم و بردباری او فرصت ظهور پیدا می‌کند؛ وگرنه اگر هیبت و قدرت او فورا آشکار می‌شد، گناهکار هرگز فرصت گناه پیدا نمی‌کرد."],[736,"خون‌بهای جرم نفس قاتله","هست بر حلمش دیت بر عاقله","خون‌بهای گناه و جنایتی که نفس قاتل مرتکب شده، بر عهده همان حلم و بردباری اوست؛ گویی غرامت این جرم را نفس عاقله می‌پردازد."],[736,"مست و بی‌خود نفس ما زان حلم بود","دیو در مستی کلاه از وی ربود","نفس ما در اثر همین حلم و بردباری، مست و بی‌خبر و غافل شده است؛ و شیطان در همین حالت مستی، کلاه عقل و اختیار را از سر انسان ربوده است."],[736,"گرنه ساقی حلم بودی باده‌ریز","دیو با آدم کجا کردی ستیز","اگر ساقی این باده، حلم و بردباری نبود، و اگر او این شراب را در جام انسان نمی‌ریخت، شیطان چگونه می‌توانست با آدم به ستیز برخیزد؟"],[736,"گاه علم آدم ملایک را کی بود","اوستاد علم و نقّاد نقود","فرشتگان در برابر دانش آدم چه جایگاهی داشتند؟ او استاد دانش و سنجش و تشخیص ارزش‌ها بود."],[736,"چونکه در جنّت شراب حلم خورد","شد ز یک بازی شیطان روی زرد","اما وقتی در بهشت از شراب حلم و بردباری نوشید، شیطان با یک نیرنگ توانست او را بلغزاند و چهره‌اش را از شرمندگی زرد کند."],[736,"آن بلادرهای تعلیم ودود","زیرک و دانا و چستش کرده بود","آن آموزه‌ها و تعلیمات محبت‌آمیزی که در بهشت آموخته بود، او را هوشیار، دانا و چابک کرده بودند."],[736,"باز آن افیون حلم سخت او","دزد را آورد سوی رخت او","اما همان «افیون حلم» و بردباری شدید، بار دیگر شیطان دزد و فریبکار را به سوی مال و دارایی او کشاند."],[736,"عقل آید سوی حلمش مستجیر","ساقی‌ام تو بوده‌ای دستم بگیر","آنگاه عقل به سوی حلم و بردباری او پناه می‌برد و می‌گوید: «تو ساقی من بوده‌ای؛ پس حالا دستم را بگیر و نجاتم بده»."],[737,"کن میان مجرمان حکم ای ایاز","ای ایاز پاک با صد احتراز","ای ایاز پاک، تو باید با احتیاط و دقت میان مجرمان قضاوت کنی."],[737,"گر دو صد بارت بجوشم در عمل","در کف جوشت نیابم یک دغل","اگر دوصد بار هم در کار عمل تلاش کنم، در سراسر جوش و حرارت خود، نتوانم در دستان تو چیزی ناپاک پیدا کنم."],[737,"ز امتحان شرمنده خلقی بی‌شمار","امتحان‌ها از تو جمله شرمسار","بسیاری از مردم به خاطر امتحانات و آزمایش‌هایی که از آنها گرفته می‌شود، شرمنده و آزرد‌ه شده‌اند؛ چون در این آزمون‌ها نمی‌توانند به‌خوبی خود را نشان دهند و همه از این بابت ناراحتند."],[737,"بحر بی‌قعرست تنها علم نیست","کوه و صد کوهست این خود حلم نیست","علمی که در اینجا مطرح شده، به اندازه‌ای عمیق و وسیع است که به دریا بی‌پایان تشبیه می‌شود و تنها با دانایی محض قابل شناسایی نیست؛ بلکه بخشی از آن صفات و ویژگی‌های انسان مانند بردباری و حلم نیز هست. این علم فراتر از دانش است و به جنبه‌های دیگر انسانیت نیز مربوط می‌شود."],[737,"گفت من دانم عطای توست این","ورنه من آن چارقم و آن پوستین","شاعر می‌گوید من می‌دانم که این نعمت و بخشش توست، زیرا در غیر این صورت هیچ کدام از لباس‌های درشتی که بر تن دارم معنایی ندارد و توانایی کسب آن را ندارم."],[737,"بهر آن پیغامبر این را شرح ساخت","هر که خود بشناخت یزدان را شناخت","برای پیامبر (که در اینجا به او اشاره شده) این موضوع را تبیین کرد که هر کسی که حقیقت خود را بشناسد، به درستی خداوند (یزدان) را می‌شناسد."],[737,"چارقت نطفه‌ست و خونت پوستین","باقی ای خواجه عطای اوست این","این دنیا و زندگی تو، مانند چهارقد، فقط نطفه و خون است و باقی آن پوستینی است که در آن قرار دارد. ای خواجه، این نعمت‌ها و موهبت‌ها از سوی خداوند است و فقط عطای او به توست."],[737,"بهر آن دادست تا جویی دگر","تو مگو که نیستش جز این قدر","برای آنکه به تو داده‌اند، تا در جوی دیگری جاری شوی، نگو که جز به همین اندازه شکایت نکن."],[737,"زان نماید چند سیب آن باغبان","تا بدانی نخل و دخل بوستان","باغبان چندین سیب نشان می‌دهد تا بفهمی که در باغ چه درختانی به خوبی رشد کرده و چه محصولاتی وجود دارد."],[737,"کف گندم زان دهد خریار را","تا بداند گندم انبار را","شاه ایاز که فردی با درایت و حکمت است، برای اینکه بداند گندم در انبار چگونه است، مقداری گندم به خر را می‌دهد. اینجا به اهمیت تجربه و درک در شناخت و قضاوت اشاره دارد."],[737,"نکته‌ای زان شرح گوید اوستاد","تا شناسی علم او را مستزاد","استاد نکته‌ای از این موضوع را بیان می‌کند تا تو بتوانی علم و دانش او را اضافه‌تر بشناسی."],[737,"ور بگویی خود همینش بود و بس","دورت اندازد چنانک از ریش خس","اگر بگویی که این مسئله تنها همین است و بس، تو را از دورت دور می‌کند، همان‌گونه که درخت خس (کاه) را از ریشه‌اش جدا می‌سازد."],[737,"ای ایاز اکنون بیا و داد ده","داد نادر در جهان بنیاد نه","ای ایاز، حالا بیا و نابسامانی‌های نادر را در جهان سامان بده و نظم جدیدی برقرار کن."],[737,"مجرمانت مستحق کشتن‌اند","وز طمع بر عفو و حلمت می‌تنند","مجرمان سزاوار مرگ هستند و به خاطر امید به عفو و بزرگواری تو به زندگی ادامه می‌دهند."],[737,"تا که رحمت غالب آید یا غضب","آب کوثر غالب آید یا لهب","تا زمانی که رحمت بر خشم غلبه کند، مانند آب کوثر (که آب پاک و زلالی در بهشت است) بر آتش (لهب) فزونی یابد."],[737,"از پی مردم‌ربایی هر دو هست","شاخ حلم و خشم از عهد الست","از آغاز خلقت، دو ویژگی مهم در انسان وجود دارد؛ یکی صبر و بردباری (حلم) و دیگری خشم. این دو خصوصیت در رفتار انسان‌ها به‌ویژه در روابط اجتماعی و تعاملاتشان با هم نمایان می‌شود."],[737,"بهر این لفظ الست مستبین","نفی و اثباتست در لفظی قرین","در اینجا اشاره شده که واژه «الست» به وضوح مفهوم نفی و اثبات را در بر دارد و این دو، در کنار هم قرار گرفته‌اند. به عبارتی، در معنی این واژه، هم نفی و هم اثبات وجود دارد."],[737,"زانکه استفهام اثباتیست این","لیک در وی لفظ لیس شد قرین","سوالات تأکیدی، اگرچه در ظاهر به تأیید چیزی اشاره دارند، اما در واقع به نفی آن نیز همراه می‌شوند."],[737,"ترک کن تا ماند این تقریر خام","کاسه خاصان منه بر خوان عام","ترک کن تا این سخن ناپخته بماند و آن را به جمع خاصان محدود نکن، بلکه آن را در اختیار عموم قرار بده."],[737,"قهر و لطفی چون صبا و چون وبا","آن یکی آهن‌ربا وین که‌ربا","قهر و لطف خداوند مثل باد صبا نرم و خوشایند است و مثل وبا مهلک و خطرناک. برخی از ویژگی‌های خداوند مانند آهن‌ربا کسانی را به سوی خود می‌کشد، در حالی که برخی دیگر مثل وبا مایه عذاب و دوری می‌شوند."],[737,"می‌کشد حق راستان را تا رشد","قسم باطل باطلان را می‌کشد","حق، راستی را برمی‌کشد و برطرف می‌کند تا باطل و دروغ را از بین ببرد."],[737,"معده حلوایی بود حلوا کشد","معده صفرایی بود سرکا کشد","معده مانند یک شیرینی‌پز است که اگر خوب باشد حلوا درست می‌کند و اگر بد باشد، شیرینی تلخ و نامطلوب می‌سازد. این به نوع شخصیت و روحیه افراد اشاره دارد که عملشان به طبیعت درونی‌شان بستگی دارد."],[737,"فرش سوزان سردی از جالس برد","فرش افسرده حرارت را خورد","فرش سوزان یعنی دل‌تنگی و غم، انسان را از حالت خوش‌حالی و سرزندگی خارج می‌کند. در مقابل، فرش افسرده به احساس‌های منفی اشاره دارد که می‌تواند احساس گرما و زندگی را از انسان بگیرد. این ابیات به تأثیرات احساسی و روانی بر روی فرد اشاره دارد، که در زمان‌های مختلف، شادی و غم می‌تواند بر حالت و رفتار او اثر بگذارد."],[737,"دوست بینی از تو رحمت می‌جهد","خصم بینی از تو سطوت می‌جهد","اگر کسی را دوست داشته باشی، رحمت و محبت از وجود تو ساطع می‌شود، اما اگر دشمنی را ببینی، خشونت و قدرت از تو نمایان می‌گردد."],[737,"ای ایاز این کار را زوتر گزار","زانک نوعی انتقامست انتظار","ای ایاز، این کار را هرچه سریع‌تر انجام بده، زیرا این عمل در واقع نوعی انتقام به حساب می‌آید که در پی آن انتظار می‌رود."],[738,"گفت ای شه جملگی فرمان تراست","با وجود آفتاب اختر فناست","ای پادشاه، همه چیز به فرمان توست، حتی با وجود آفتاب، که نشان‌دهنده فنا و زوال است."],[738,"زهره کی بود یا عطارد یا شهاب","کو برون آید به پیش آفتاب","زهره، عطارد یا شهاب چیست که می‌تواند در برابر نور آفتاب ظاهر شود و به آن نزدیک شود؟"],[738,"گر ز دلق و پوستین بگذشتمی","کی چنین تخم ملامت کشتمی","اگر از لباس کهنه و پوستین خود عبور می‌کردم، آیا چنین ملامتی را بر خود کاشته بودم؟"],[738,"قفل کردن بر در حجره چه بود","در میان صد خیالیی حسود","قفل زدن بر در اتاق چه معنا دارد وقتی که در میان صد خیالی حسود وجود دارد؟"],[738,"دست در کرده درون آب جو","هر یکی زیشان کلوخ خشک‌جو","هر یک از حسودان دستشان را در آب جوی کرده‌اند تا کلوخ‌های خشک را بیرون بیاورند."],[738,"پس کلوخ خشک در جو کی بود","ماهی‌یی با آب عاصی کی شود","کلوخ خشک در جو (آب) که در آن نمی‌تواند ماهی زندگی کند، نشان می‌دهد که در شرایط ناپسند و ناسازگار، انتظار بهبود یا زندگی نیکو بیهوده است. به عبارتی، در شرایط دشوار و سخت، امید به تغییر وضعیت غیرممکن و دشوار است."],[738,"بر من مسکین جفا دارند ظن","که وفا را شرم می‌آید ز من","دیگران به من بدی می‌کنند و گمان می‌کنند که وفاداری از من خجالت می‌کشد."],[738,"گر نبودی زحمت نامحرمی","چند حرفی از وفا واگفتمی","اگر نبود زحمت‌های ناشی از دوری نامحرم، چندان حرفی از وفا نمی‌زدم."],[738,"چون جهانی شبهت و اشکال‌جوست","حرف می‌رانیم ما بیرون پوست","چون این دنیا پر از شبهات و ظواهر است، ما تنها می‌توانیم از ظاهر آن سخن بگوییم و درون واقعیات را درک نکنیم."],[738,"گر تو خود را بشکنی مغزی شوی","داستان مغز نغزی بشنوی","اگر تو خودت را از ظواهر و دنیای مادی بشکنی و به باطن و احساسات عمیق خود برسی، به حقیقتی عمیق‌تر دست می‌یابی و از این طریق داستان‌های زیبا و آموزنده‌ای را خواهی شنید."],[738,"جوز را در پوستها آوازهاست","مغز و روغن را خود آوازی کجاست","در مغز جوز (بادام‌زمینی) و روغن آن، صدای خاصی وجود دارد، اما این صدا در خود پوستشان نیست. این به این معناست که زیبایی و ارزش واقعی هر چیزی در باطن آن نهفته است."],[738,"دارد آوازی نه اندر خورد گوش","هست آوازش نهان در گوش نوش","آوازی وجود دارد که شنیدنش به گوش نمی‌رسد؛ این صدا در درون سماع‌کننده (نوش) پنهان است و فقط او می‌تواند آن را بشنود."],[738,"گرنه خوش‌آوازی مغزی بود","ژغژغ آواز قشری کی شنود","اگر مغزی خوش‌آواز وجود نداشته باشد، صداهای زشت و ناهنجار مانند زنگ یا جیرجیر را چه کسی می‌شنود؟"],[738,"ژغژغ آن زان تحمل می‌کنی","تا که خاموشانه بر مغزی زنی","تحمل و سکوت تو به خاطر صدای ناهنجار ژغژغ است تا زمانی که به صورت خاموش و آرام بر عقل (مغز) خود تسلط یابی و فکر کنی."],[738,"چند گاهی بی‌لب و بی‌گوش شو","وانگهان چون لب حریف نوش شو","مدتی خود را خاموش و بی‌فعالیت نگه‌دار و سپس به یک‌باره مانند کسی که به شراب حریف خود می‌نوشد، با شور و نشاط صحبت کن."],[738,"چند گفتی نظم و نثر و راز فاش","خواجه یک روز امتحان کن گنگ باش","چندین بار درباره نظم و نثر و اسرار سخن گفتی، ای خواجه، یک روز خودت را امتحان کن و بی‌زبان و خاموش باش."],[739,"چند پختی تلخ و تیز و شورگز","این یکی بار امتحان شیرین بپز","در این بیت، شاعر از این صحبت می‌کند که در زندگی، طعم‌های تلخ و تجربه‌های سخت زیادی را آزموده است و حالا می‌خواهد با صبر و سکوت، فرصتی فراهم کند تا تجربه‌ای خوشایند و شیرین به دست آورد."],[739,"آن یکی را در قیامت ز انتباه","در کف آید نامه عصیان سیاه","در روز قیامت، نامه اعمال هر شخص که پر از گناهانش است، پیش او خواهد آمد و او در وحشت و هراس از آنچه کرده، قرار نخواهد گرفت."],[739,"سرسیه چون نامه‌های تعزیه","پر معاصی متن نامه و حاشیه","نامه‌ای که در قیامت به دست انسان می‌رسد، مانند نامه‌های تعزیه است که پر از گناه و معصیت است، نه تنها در متن آن، بلکه حتی در حاشیه‌اش نیز آثار گناه وجود دارد."],[739,"جمله فسق و معصیت بد یک سری","هم‌چو دارالحرب پر از کافری","تمام گناهان و معصیت‌ها مانند یک منطقه جنگی هستند که پر از کفر و شرارت است."],[739,"آنچنان نامه پلید پر وبال","در یمین ناید درآید در شمال","نامه پلید و گناهکار که بار سنگینی دارد، در سمت راست (به سوی بهشت) راه نمی‌یابد و فقط در شمال (به سوی جهنم) در می‌آید."],[739,"خود همین‌جا نامه خود را ببین","دست چپ را شاید آن یا در یمین","به این نکته توجه کن که همین جا، یعنی در همین مکان، نامه خود را مشاهده کن. ممکن است نامه‌ای که در دست چپ توست، در راست نیز وجود داشته باشد."],[739,"موزه چپ کفش چپ هم در دکان","آن چپ دانیش پیش از امتحان","این بیت به طور ضمنی به وجود چیزهایی در زندگی اشاره دارد که ممکن است از آن‌ها بی‌خبر باشیم یا به آن‌ها توجهی نکنیم. «موزه چپ» و «کفش چپ» نماد چیزهایی هستند که ممکن است در ابتدا در اختیار ما نباشند یا ما آنها را در نظر نگرفته باشیم. بنابراین، برای پی بردن به حقیقت یا شناخت بیشتر، باید آن‌ها را بررسی کنیم و قبل از قضاوت یا اقدام، امتحان کنیم."],[739,"چون نباشی راست می‌دان که چپی","هست پیدا نعره شیر و کپی","اگر تو راست (صادق) نباشی، بدان که در میان تو کینه و حسد (چپی) وجود دارد. صدای نعره شیر و شکایت (کپی) از وجود همین حسد و کینه است."],[739,"آنک گل را شاهد و خوش‌بو کند","هر چپی را راست فضل او کند","هر کسی که گل را معطر و زیبا می‌سازد، همچنین توانایی دارد که هر چیز نادرست را به درست تبدیل کند."],[739,"هر شمالی را یمینی او دهد","بحر را ماء معینی او دهد","هر شخصی را که سمت چپ باشد، او سمت راستش را می‌دهد، و دریا را با آب مشخصی پر می‌کند. در واقع، خداوند به هر موجودی نعمت‌های خود را به گونه‌ای مناسب عطا می‌کند."],[739,"گر چپی با حضرت او راست باش","تا ببینی دست‌برد لطفهاش","اگر کسی به سمت چپ برود، در نزد خداوند راست است، تا بتواند دست نوازش‌های او را تجربه کند."],[739,"تو روا داری که این نامه مهین","بگذرد از چپ در آید در یمین","آیا تو درست می‌دانی که این نامه مهم و باارزش باید از سمت چپ بگذرد و به سمت راست بیاید؟"],[739,"این چنین نامه که پرظلم و جفاست","کی بود خود درخور اندر دست راست","نامه‌ای که پر از ظلم و تزویر است، چگونه می‌تواند برای کسی که شریف و نیکو است، در دست راست باشد و مورد قبول واقع شود؟"],[740,"زاهدی را یک زنی بد بس غیور","هم بد او را یک کنیزک هم‌چو حور","زاهدی همسرش بسیار با احساس غیرت بود و همچنین او یک کنیزک داشت که زیبایی‌اش شبیه به حوریان بود."],[740,"زان ز غیرت پاس شوهر داشتی","با کنیزک خلوتش نگذاشتی","به‌خاطر غیرت و غیرت‌ورزی نسبت به شوهر، نتوانستی اجازه دهی که او با کنیزک خلوت کند."],[740,"مدتی زن شد مراقب هر دو را","تاکشان فرصت نیفتد در خلا","مدتی زن مراقب هر دو نفر بود تا اجازه ندهد آنها در تنهایی و خلوت با هم باشند."],[740,"تا در آمد حکم و تقدیر اله","عقل حارس خیره‌سر گشت و تباه","با آمدن فرمان و تقدیر الهی، عقل که محافظ و نگهبان انسان است، گیج و متعجب شد و به بی‌راهه رفت."],[740,"حکم و تقدیرش چو آید بی‌وقوف","عقل کی بود در قمر افتد خسوف","زمانی که حکم و سرنوشت الهی فرا می‌رسد، عقل انسان نمی‌تواند آن را درک کند و همچنان حیران می‌ماند، مانند کس که در شب قمر، کسوف (محو شدن نور ماه) را نمی‌فهمد."],[740,"بود در حمام آن زن ناگهان","یادش آمد طشت و در خانه بد آن","در یک حمام، زن ناگهان یادش می‌افتد که طشت و ظرفی در خانه‌اش وجود دارد که باید به آن توجه کند و حالش به خاطر این یادآوری خراب می‌شود."],[740,"با کنیزک گفت رو هین مرغ‌وار","طشت سیمین را ز خانه ما بیار","با کنیزک گفت که مانند پرنده به سرعت به خانه بیاید و ظرف نقره‌ای را بیاورد."],[740,"آن کنیزک زنده شد چون این شنید","که به خواجه این زمان خواهد رسید","کنیزک با شنیدن خبر آمدن خواجه زنده و شاداب می‌شود و حالتی سرزنده پیدا می‌کند."],[740,"خواجه در خانه‌ست و خلوت این زمان","پس دوان شد سوی خانه شادمان","خواجه در خانه است و اکنون وقتی برای خلوت و تنهایی او فراهم شده، بنابراین او شاد و خوشحال به سوی خانه می‌دود."],[740,"عشق شش ساله کنیزک را بد این","که بیابد خواجه را خلوت چنین","این بیت به رابطه کنیزکی اشاره دارد که شش سال عاشق خواجه شده است. دلیل عشق او این است که خواجه را در شرایط خلوت و خصوصی می‌یابد و این موقعیت باعث ورود احساسات او به عمق می‌شود."],[740,"گشت پران جانب خانه شتافت","خواجه را در خانه در خلوت بیافت","خواجه ناگهان پرواز کرده و به سمت خانه رفت و در آنجا او را در یک فضای خصوصی پیدا کرد."],[740,"هر دو عاشق را چنان شهوت ربود","که احتیاط و یاد در بستن نبود","عشق و شهوات شدید این دو عاشق را به گونه‌ای درگیر کرده که دیگر نمی‌توانند احتیاط کنند و به یاد داشته باشند که باید خود را کنترل کنند."],[740,"هر دو با هم در خزیدند از نشاط","جان به جان پیوست آن دم ز اختلاط","آن دو نفر به خاطر شادی و نشاط زندگی به یکدیگر نزدیک شدند و در آن لحظه، روح‌هایشان به هم متصل شد."],[740,"یاد آمد در زمان زن را که من","چون فرستادم ورا سوی وطن","مولانا به یاد آوردن زمان زنی اشاره می‌کند که او را به سمت وطنش فرستاده است. این یادآوری نشان‌دهنده دوستی یا محبت نسبت به آن زن است و ممکن است به خاطراتی از آن زمان اشاره کند."],[740,"پنبه در آتش نهادم من به خویش","اندر افکندم قج نر را به میش","من پنبه را در آتش انداختم و خودم هم به آن دامن زدم، به طوری که بره‌ی نر را به میش نسبت دادم."],[740,"گل فرو شست از سر و بی‌جان دوید","در پی او رفت و چادر می‌کشید","گل بی‌جان و پژمرده با شتاب و بی‌احتیاط به دنبال محبوب دوید و با اضطراب چادر را بر سر خود کشید."],[740,"آن ز عشق جان دوید و این ز بیم","عشق کو و بیم کو فرقی عظیم","عشق می‌تواند انسان را به سویی پرواز دهد، در حالی که بیم و ترس او را به عقب می‌کشاند. در واقع، تفاوت زیادی بین انگیزه‌های ناشی از عشق و ترس وجود دارد."],[740,"سیر عارف هر دمی تا تخت شاه","سیر زاهد هر مهی یک روزه راه","سیر عارف به طور مداوم و پیوسته به درگاه الهی و مقام‌های بالا می‌رسد، در حالی که سیر زاهد، که تمرکز بیشتری بر روی ظواهر و زهد دارد، تنها یک روزه به نتیجه می‌رسد و این دو مسیر با یکدیگر تفاوت زیادی دارند."],[740,"گرچه زاهد را بود روزی شگرف","کی بود یک روز او خمسین الف","اگرچه زاهد (رهت*) روزی بزرگ و عظیم دارد، اما همان یک روز او برابر با پنجاه هزار روز (دگر) است. (*زاهد به معنای فردی است که به دنیا وابستگی کمتری دارد و متمایل به زندگی زاهدانه است.)"],[740,"قدر هر روزی ز عمر مرد کار","باشد از سال جهان پنجه هزار","هر روز از عمر انسان باید با کاری مفید و ارزشمند پر شود، زیرا هر سال در زندگی او به اندازه پنجاه هزار روز ارزش دارد."],[740,"عقلها زین سر بود بیرون در","زهره وهم ار بدرد گو بدر","عقل‌ها از این موضوع خارج هستند، اگر خیال و وهم به زهره (ستاره) آسیب بزند، باید برود و درد را تحمل کند."],[740,"ترس مویی نیست اندر پیش عشق","جمله قربانند اندر کیش عشق","ترس هیچ بهایی ندارد در حضور عشق، همه افراد در مکتب عشق آماده‌اند جان خود را فدای آن کنند."],[740,"عشق وصف ایزدست اما که خوف","وصف بنده مبتلای فرج و جوف","عشق از صفات خداوند است، اما ترس ویژه بندۀ ناتوانی است که در خوشی و راحتی گرفتار آمده."],[740,"چون یحبون بخواندی در نبی","با یحبوهم قرین در مطلبی","وقتی می‌گویند «چون دوست می‌دارند» و در وصف پیامبر (محمد) می‌خوانند که «خدا نیز آنها را دوست می‌دارد»، به پیوند و شباهت این دو مفهوم در فضا و مضمون اشاره می‌شود. پیامبر به عشق و محبت خدا نزدیک است و کسانی که او را دوست دارند نیز به محبت خدا نائل می‌شوند."],[740,"پس محبت وصف حق دان عشق نیز","خوف نبود وصف یزدان ای عزیز","پس محبت خداوند، ویژگی حق است و عشق نیز از آن ناشی می‌شود، اما ترس از خداوند نیست. ای عزیز، این عشق با صفات یزدان، یعنی خدا، همراه است."],[740,"وصف حق کو وصف مشتی خاک کو","وصف حادث کو و وصف پاک کو","نمی‌توان صفات خداوند را با توصیف چیزهای بی‌اهمیت و خاکی مقایسه کرد؛ چون خداوند از هر حادثه و هر چیزی که ناپاک و محدود است، فراتر است."],[740,"شرح عشق ار من بگویم بر دوام","صد قیامت بگذرد و آن ناتمام","اگر بخواهم درباره عشق صحبت کنم، حتی اگر صد قیامت بگذرد، این موضوع همچنان ناتمام و تمام‌نشدنی خواهد بود."],[740,"زانک تاریخ قیامت را حدست","حد کجا آنجا که وصف ایزدست","چرا که تاریخ قیامت را اندازه و نهایتی نیست، آنجایی که توصیف خداوند است."],[740,"عشق را پانصد پرست و هر پری","از فراز عرش تا تحت‌الثری","عشق، دارای هزاران پرستشگر است و هر پرستنده‌ای از بلندترین آسمان تا پایین‌ترین زمین را در بر می‌گیرد."],[740,"زاهد با ترس می‌تازد به پا","عاشقان پران‌تر از برق و هوا","زاهد (مردی که به دنیا و لذات آن بی‌علاقه است) با ترس و احتیاط گام برمی‌دارد، در حالی که عاشقان (محبان واقعی) به صورت آزاد و شجاع، سریع‌تر از برق و هوا حرکت می‌کنند."],[740,"کی رسند این خایفان در گرد عشق","که آسمان را فرش سازد درد عشق","چگونه این ترسویان می‌توانند به عشق واقعی دست یابند در حالی که درد عشق می‌تواند آسمان را زیر پای انسان فرش کند؟"],[740,"جز مگر آید عنایتهای ضو","کز جهان و زین روش آزاد شو","تنها با عنایت‌های نورانی است که می‌توان از جهان و این روش رها شد."],[740,"از قش خود وز دش خود باز ره","که سوی شه یافت آن شهباز ره","از حالت عادی و زندگی سخت خود خارج شو و به سوی شهری که شهباز (پرنده‌ای آزاد و قوی) در آنجا راه یافته، برو."],[740,"این قش و دش هست جبر و اختیار","از ورای این دو آمد جذب یار","این قشر و دشتی که اشاره می‌شود، به جبری و اختیاری اشاره دارد که انسان‌ها در زندگی خود دارند. از فرای این دو مفهوم، عشق و نیایش به معشوق (یار) پدید می‌آید."],[740,"چون رسید آن زن به خانه در گشاد","بانگ در در گوش ایشان در فتاد","وقتی آن زن به خانه رسید، با صدای بلندی در زد و صدایش به گوش آن‌ها رسید."],[740,"آن کنیزک جست آشفته ز ساز","مرد بر جست و در آمد در نماز","کنیزک به خاطر صدای ساز مرد به هم ریخته و بی‌تابی نشان داد و با بی‌قراری از خانه بیرون آمد و به نماز رفت."],[740,"زن کنیزک را پژولیده بدید","درهم و آشفته و دنگ و مرید","زن کنیزک را در حالی دید که لباسش پریشان و درهم است و با حالتی گیج و بی‌قرار به نظر می‌رسد."],[740,"شوی خود را دید قایم در نماز","در گمان افتاد زن زان اهتزاز","زن در حین نماز شوهرش را دید که به او نگاه می‌کند و به دلیل این نگاه و اهتزازش در نظرش شک و تردید پیدا کرد."],[740,"شوی را برداشت دامن بی‌خطر","دید آلوده منی خصیه و ذکر","شوهر را به آرامی دامنش را برداشت و بی‌خطر دید که آلوده به منی و مخرجش شده است."],[740,"از ذکر باقی نطفه می‌چکید","ران و زانو گشت آلوده و پلید","از باقی‌مانده نطفه که به زمین می‌افتد، ران و زانو آلوده و ناپاک می‌شود."],[740,"بر سرش زد سیلی و گفت ای مهین","خصیه مرد نمازی باشد این‌‌؟!","شخصی به حالت تحقیر به فردی که خود را مرد مؤمنی می‌داند، می‌گوید آیا با اوضاع و احوال ناپسندش، می‌تواند به خود ببالد و مدعی نماز و دیانت باشد؟"],[740,"لایق ذکر و نمازست این ذکر‌‌؟","وین چنین ران و زهار پر قذر‌‌؟","آیا این ذکر و نماز جایی دارد در حالی که این شخص از رذالت و آلودگی پر است؟"],[740,"نامه پر ظلم و فسق و کفر و کین","لایقست انصاف ده اندر یمین","نامه‌ای که پر از ظلم، گناه، کفر و کینه است، شایسته‌ی انصاف و عدالت نیست که بر دست راست (دست قضا) داده شود."],[740,"گر بپرسی گبر را کاین آسمان","آفریده کیست وین خلق و جهان","اگر از یک گبر (زرتشتی) بپرسید که این آسمان و این موجودات و جهان را چه کسی آفریده است، او جوابی خواهد داد."],[740,"گوید او کاین آفریده آن خداست","که آفرینش بر خدایی‌اش گواست","او می‌گوید که این موجودات آفرینه‌ای هستند از آن خدایی که آفرینش، خود گواه بر الوهیت اوست."],[740,"کفر و فسق و استم بسیار او","هست لایق با چنین اقرار او","کسی که به خدا اعتراف می‌کند و می‌گوید او خالق آسمان‌ها و زمین است، ولی در عین حال به کفر و نافرمانی و گناه و بدی‌ها مشغول است، به هیچ وجه با این اعتراف تناسب ندارد."],[740,"هست لایق با چنین اقرار راست","آن فضیحتها و آن کردار کاست","با چنین اعترافی به خدای واحد، رفتار زشت و کردار ناپسند او مناسب و درخور نیست."],[740,"فعل او کرده دروغ آن قول را","تا شد او لایق عذاب هول را","عمل او حقیقت کلامش را نقض کرده است، بنابراین او سزاوار عذاب سختی خواهد بود."],[740,"روز محشر هر نهان پیدا شود","هم ز خود هر مجرمی رسوا شود","در روز قیامت، هر چیزی که پنهان بوده نمایان می‌شود و هر مجرم، خود به خود رسوا و مشخص می‌گردد."],[740,"دست و پا بدهد گواهی با بیان","بر فساد او به پیش مستعان","دست و پا به‌عنوان شاهد در برابر مستعان (خدای یاری‌دهنده) شهادت می‌دهند که اعمال او فاسد و نادرست است. در اینجا به این موضوع اشاره می‌شود که در روز قیامت، اعضای بدن انسان بر فعالیت‌های او گواهی خواهند داد."],[740,"دست گوید من چنین دزدیده‌ام","لب بگوید من چنین پرسیده‌ام","دست می‌گوید که من در دزدی چنین عمل کرده‌ام و لب (دهان) می‌گوید که من چنین سوالاتی پرسیده‌ام. این ابیات به تناقض میان گفته‌ها و عمل‌های انسان اشاره دارد."],[740,"پای گوید من شده‌ستم تا منی","فرج گوید من بکرده‌ستم زنی","پای می‌گوید که من تنها برای خودم حرکت می‌کنم و به خودم فکر می‌کنم، در حالی که فرج (آلت تناسلی) می‌گوید که من کار ناپسند و زنی را انجام داده‌ام. این نشان‌دهنده تناقض در ادعاهای موجود است."],[740,"چشم گوید کرده‌ام غمزه حرام","گوش گوید چیده‌ام سوء الکلام","چشم می‌گوید که به خاطر زیبایی و جذابیت، رفتارهای ناپسند و حرامی را انجام داده، و گوش ادعا می‌کند که سخنان زشت و نامناسبی را شنیده است. این ادعاها به حال و وضعیت واقعی آن‌ها نمی‌خورد، زیرا در درون‌شان می‌دانند که چنین کارهایی نادرست است."],[740,"پس دروغ آمد ز سر تا پای خویش","که دروغش کرد هم اعضای خویش","انسان وقتی که دروغ می‌گوید، همه وجودش از سر تا پا دروغ می‌شود؛ زیرا اعضای او نیز به گفته‌های نادرست و بی‌اساسش گواهی می‌دهند."],[740,"آنچنان که در نماز با فروغ","از گواهی خصیه شد زرقش دروغ","نماز با توجه و درخشانی برگزار می‌شود، اما اگر در آن نیت یا صداقت وجود نداشته باشد، صحبت از فراوانی (مانند صدای گواهی) به دروغ و فریب تبدیل می‌شود."],[740,"پس چنان کن فعل که آن خود بی‌زبان","باشد اشهد گفتن و عین بیان","پس به گونه‌ای عمل کن که کار تو خود به تنهایی سخن بگوید، مانند شهادتی که برای بیان حقایق نیاز به کلام ندارد."],[740,"تا همه تن عضو عضوت ای پسر","گفته باشد اشهد اندر نفع و ضر","ای پسر، تا زمانی که تمام وجودت به هم وابسته و یکپارچه باشد، در نفع و ضرر آنچه را که گفته شده است، شهادت خواهی داد."],[740,"رفتن بنده پی خواجه گواست","که منم محکوم و این مولای ماست","این بیت بیانگر این است که بنده (شخصی که در موقعیت خدمتگزاری است) به سوی خواجه (مولای خود) می‌رود و این رفتن علامت و نشانه‌ای است از این که او خود را محکوم و وابسته به خواجه می‌داند و خواجه را مولا و سرپرست خود می‌شناسد."],[740,"گر سیه کردی تو نامه عمر خویش","توبه کن زانها که کردستی تو پیش","اگر از اعمال خود در طول عمرت کارهای بد انجام داده‌ای، اکنون توبه کن و از این کارها پشیمان شو."],[740,"عمر اگر بگذشت بیخش این دمست","آب توبه‌ش ده اگر او بی‌نمست","عمر اگر گذشته باشد، بیخ (ریشه) آن در این لحظه است، پس باید آب توبه را به آن برسانی که اگر آن را دریافت نکند، بی‌ثمر و بی‌فایده خواهد بود."],[740,"بیخ عمرت را بده آب حیات","تا درخت عمر گردد با نبات","ریشه عمرت را با آب حیات سیراب کن تا درخت عمرت به زندگی و رشد ادامه دهد."],[740,"جمله ماضی‌ها ازین نیکو شوند","زهر پارینه ازین گردد چو قند","تمام گذشته‌ها به واسطهء این فعل نیکو می‌شوند، مانند این که زهرهای تلخ گذشته به شیرینی قند تبدیل می‌گردند."],[740,"سیئاتت را مبدل کرد حق","تا همه طاعت شود آن ما سبق","حق اعمال زشت تو را به خوبی تبدیل می‌کند پس همه اعمال نیک تو خواهد شد، همان‌طور که در گذشته مقرر شده است."],[740,"خواجه بر توبه نصوحی خوش بتن","کوششی کن هم به جان و هم به تن","بهتر است در توبه خالص و واقعی تلاش کنی و در این مسیر هم با قلب و هم با جسم خود کوشا باشی."],[740,"شرح این توبه نصوح از من شنو","بگرویدستی و لیک از نو گرو","توبه نصوح، توبه‌ای پاک و خالص است که باید با تمام وجود به آن پرداخته شود. در این بیت، مولانا از شنونده می‌خواهد تا به این نوع توبه ایمان بیاورد و به آن عمل کند، اما به نوعی تأکید می‌کند که نباید به راحتی آن را فراموش کرد و دوباره به گناهان بازگشت."],[741,"بود مردی پیش ازین نامش نصوح","بد ز دلاکی زن او را فتوح","سالها پیش،مردی بود بنام \"نصوح\"، که بد شستن زنان در حمام(اشاره از تجاوز نصوح به زنان در حمام) پیشه (شغل) وی به عنوان یک دلاک بود."],[741,"بود روی او چو رخسار زنان","مردی خود را همی‌کرد او نهان","چهره‌اش مانند زنان نرم و لطیف بوداما مردانگی خود را پنهان می‌کرد"],[741,"او به حمام زنان دلاک بود","در دغا و حیله بس چالاک بود","در حمام زنان به عنوان دلاک کار می‌کردو در فریب و نیرنگ بسیار ماهر بود"],[741,"سالها می‌کرد دلاکی و کس","بو نبرد از حال و سر آن هوس","او سال‌ها این کار را کرد و کسی از هوس پلیدش باخبر نشد"],[741,"زانک آواز و رخشش زن‌وار بود","لیک شهوت، کامل و بیدار بود","صدای صورتش زنانه بود، اما شهوتی کاملا بیدار داشت"],[741,"چادر و سربند پوشیده و نقاب","مرد شهوانی و در غرّه شباب","با آنکه چادر،روسری و نقاب می پوشید اما مردی بود غرق در هوس(شهوت) و لذتهای جوانی.(در این بیت مولوی به تضاد بین پوشش ظاهری و باطن فاسد اشاره میکند)"],[741,"دختران خسروان را زین طریق","خوش همی‌مالید و می‌شست آن عشیق","و وی دختران پادشاهان را از این راه(دلاکی و سپس فریب آنان) با لذت دلاکی میکرد(ماساژ میداد) و می شست و سپس (آنها را به گناه می آلود یا به عبارتی صحیح تر به آنان دست درازی میکرد)"],[741,"توبه‌ها می‌کرد و پا در می‌کشید","نفس کافر، توبه‌اش را می‌درید","او بارها توبه میکرد اما باز به گناه خویش باز می گشت. و نفس(ذات) سرکشش توبه هایش را پاره میکرد(یعنی ذات سرکش و آلوده نصوح مانع از بازگشت وی از گناهانش بود و موجب باطل شدن توبه هایش می گشت)"],[741,"رفت پیش عارفی آن زشت‌کار","گفت ما را در دعایی یاد دار","نصوح که مردی گناهکار بود سرانجام نزد عارفی رفت و به وی گفت که در دعاهایش از وی نیز یاد کند(یعنی نصوح از عارف طلب دعا و به نوعی حلالیت کرد)"],[741,"سر او دانست آن آزادمرد","لیک چون حلم خدا پیدا نکرد","آن عارف دانا راز نصوح را فهمید،ولیکن مانند حلم خداوند سکوت پیشه نکرد(یعنی چنانچه در بیت های بعد میخوانیم گناه او(نصوح) را کتمان نکرد و با کنایه خود به نصوح او را رسوا ساخت)در فرهنگ اسلامی، \"حلم\" یکی از صفات خداوند است به معنای بردباری، گذشت، و تأخیر در مجازات با وجود قدرت بر عقاب(مجازات) است.خداوند با وجود آگاهی از گناهان بندگان، به آنان فرصت توبه می‌دهد و بلافاصله مجازات نمی‌کند.حلم عارف:عارفان کامل نیز می‌کوشند این صفت الهی را در خود پرورش دهند؛ یعنی رازها را بپوشانند و حتی با دیدن گناه دیگران، به جای افشا، با مهربانی هدایت کنند.اما در این داستان، عارف با اینکه راز نصوح را فهمید، برخلاف روش خداوند (که با حلم می‌پوشاند)، از کتمان سر باز زد و او را رسوا کرد.مولوی با این بیت می‌گوید عارف واقعی باید مانند خداوند صبور و پرده‌پوش باشد، اما گاهی اوقات افشای گناه (آن هم برای هشدار به جامعه) ضروری است.عارف اینجا حلم الهی را ندارد، زیرا او بشر است و ممکن است برای اصلاح، مجبور به شکستن سکوت شود. این نشان‌دهنده تفاوت میان خلق و خداست."],[741,"بر لبش قفلست و در دل رازها","لب خموش و دل پر از آوازها","لب های عارف قفل شده بود اما در دلش رازهای بسیاری وجود داشت و با آنکه دهانش بسته بود ولی دلش(اعماق وجودش) از شدت دانستن فریاد میزد."],[741,"عارفان که جام حق نوشیده‌اند","رازها دانسته و پوشیده‌اند","عارفانی که به معرفت الهی(نوشیدن جام حق) دست پیدا کرده اند با آنکه رازها را می دانند ولیکن آنها را از چشم دیگران پرده پوشی(کتمان) می سازند.(اشاره به حلم خداوند)"],[741,"هر کرا اسرار کار آموختند","مهر کردند و دهانش دوختند","هرکسی که علم معرفت الهی را آموخت،مهر سکوت بر لبش زدند(یعنی به او آموختند که رازهای دیگران را فاش نکند)"],[741,"سست خندید و بگفت ای بدنهاد","زانک دانی ایزدت توبه دهاد","عارف با تمسخر به نصوح خندید و به او گفت:زیرا که(بدان)،پس خداوند توبه تو را می پذیرد.(درواقع عارف به زبانی غیر مستقیم به نصوح گفت \"چون خودت بهتر میدانی که خداوند توبه دروغین تو را نمی پذیرد\"(استفهام انکاری است) همچنین در اینجا توبه دهاد کنایه از \"مشروط بودن پذیرفتن توبه به راستینی\" آن است و عارف بطور غیر مستقیم میگوید که \"خداوند توبه تو را پس نخواهد داد، درواقع توبه به چیزی برای دادن یا گرفتن تبدیل شده است و این بیت به همین سبب آرایه تشخیص دارد)"],[742,"آن دعا از هفت گردون در گذشت","کار آن مسکین به آخر خوب گشت","دعای عارف آن‌قدر قدرت دارد که حتی از هفت آسمان هم عبور می‌کند و در نتیجه، کار آن انسان نیازمند به بهترین شکل ممکن سامان می‌یابد."],[742,"که آن دعای شیخ نه چون هر دعاست","فانی است و گفت او گفت خداست","دعای شیخ (عارف) مانند هر دعای دیگری نیست؛ چرا که این دعا به قدری عمیق و ناب است که در حقیقت، کلام او به عنوان کلام خداوند شنیده می‌شود."],[742,"چون خدا از خود سؤال و کد کند","پس دعای خویش را چون رد کند","اگر خدا از خودش سوال کند و در واقع بخواهد که خود را بشنود، پس چگونه می‌تواند دعای خود را رد کند؟"],[742,"یک سبب انگیخت صنع ذوالجلال","که رهانیدش ز نفرین و وبال","خداوند متعال، برای نجات او از عذاب و گرفتاری، یک دلیل و سبب را فراهم کرد."],[742,"اندر آن حمام پر می‌کرد طشت","گوهری از دختر شه یاوه گشت","در آن حمام، ظرفی پر از آب می‌شد که در آن، گوهری از دختران شاه، به دروغ و بی‌اساس به دست آمده بود."],[742,"گوهری از حلقه‌های گوش او","یاوه گشت و هر زنی در جست و جو","گوهری که از گوش او (دختر شه) به زمین افتاد، در حقیقت به نوعی بی‌ارزش و بی‌محتوا شد و هر زنی در پی آن است که به دنبال این گوهر بگردد."],[742,"پس در حمام را بستند سخت","تا بجویند اولش در پیچ رخت","آن‌ها در حمام را محکم بستند تا اول از در ورودی، جست‌وجو کنند و به دنبال نشانه‌ای بروند."],[742,"رختها جستند و آن پیدا نشد","دزد گوهر نیز هم رسوا نشد","آن‌ها لباس‌ها را جستجو کردند، اما چیزی پیدا نکردند و دزد جواهر نیز هنوز شناخته نشده و رسوا نشد."],[742,"پس به جد جستن گرفتند از گزاف","در دهان و گوش و اندر هر شکاف","آنها به شدت و با دقت شروع به جستجو کردند، نه به طور بی‌دلیل، بلکه در دهان و گوش و هر گوشه و شکاف."],[742,"در شکاف تحت و فوق و هر طرف","جست و جو کردند دری خوش صدف","در تمام جاهای زیر و بالا و هر سوی، به جستجوی دری قیمتی و زیبا پرداخته‌اند که مانند صدف خوش‌رنگ و ارزشمند است."],[742,"بانگ آمد که همه عریان شوید","هر که هستید ار عجوز و گر نوید","صدایی شنیده می‌شود که به همه می‌گوید عریان و بی‌پوشش شوید، هر کسی که هستید، چه پیر و چه جوان."],[742,"یک به یک را حاجبه جستن گرفت","تا پدید آید گهردانه شگفت","هر یک از مردم به دنبال مسدود کردن راه‌های دعا و درخواست از خدا برآمدند تا حقیقت‌های شگفت را نمایان کنند."],[742,"آن نصوح از ترس شد در خلوتی","روی زرد و لب کبود از خشیتی","نصوح، به خاطر ترسی که دارد، در گوشه‌ای تنها نشسته و رنگش زرد و لب‌هایش کبود شده است از شدت وحشت."],[742,"پیش چشم خویش او می‌دید مرگ","رفت و می‌لرزید او مانند برگ","او در برابر چشم خود، مرگ را می‌دید و به شدت می‌لرزید، مانند برگی که در باد می‌لرزد."],[742,"گفت یارب بارها برگشته‌ام","توبه‌ها و عهدها بشکسته‌ام","من بارها به تو پناه برده‌ام و به خاطر اشتباهاتم توبه کرده‌ام، اما هر بار عهد و پیمانم را شکسته‌ام."],[742,"کرده‌ام آنها که از من می‌سزید","تا چنین سیل سیاهی در رسید","من کارهایی کرده‌ام که شایسته‌ام بوده و حالا به خاطر آنها، غم و اندوه فراوانی بر من نازل شده است."],[742,"نوبت جستن اگر در من رسد","وه که جان من چه سختیها کشد","اگر نوبت من برسد و زمانی برای درخواست از خدا بیابم، وای به حال من که چه دردها و سختی‌ها را تحمل کرده‌ام."],[742,"در جگر افتاده‌استم صد شرر","در مناجاتم ببین بوی جگر","در دل من آتش‌های زیادی برپاست و این حالت را در مناجاتم نشان بده. بوی جگر به معنای عمق درد و رنجی است که در دل دارم."],[742,"این چنین اندوه کافر را مباد","دامن رحمت گرفتم داد داد","نمی‌خواهم که اندوهی مانند اندوه کافر بر دامن رحمت خدا بیفتم، زیرا من به رحمت خداوندی که گرفتاری‌ها را برطرف می‌کند، پناه برده‌ام و از او کمک خواسته‌ام."],[742,"کاشکی مادر نزادی مر مرا","یا مرا شیری بخوردی در چرا","ای کاش که من هرگز به دنیا نمی‌آمدم، یا دست‌کم ای کاش شیر دایه‌ام من را می‌خورد تا در صحرا می‌چریدم و زنده نمی‌ماندم."],[742,"ای خدا آن کن که از تو می‌سزد","که ز هر سوراخ مارم می‌گزد","ای خدا، تو کاری کن که شایسته توست، چون هر جا که به من آسیب می‌رسد، طعمه نیش و آسیب می‌شود."],[742,"جان سنگین دارم و دل آهنین","ورنه خون گشتی درین رنج و حنین","جانم سنگین و غمگین است و دلم سخت و بی‌احساس شده وگرنه در این رنج و زاری، خون می‌شدم."],[742,"وقت تنگ آمد مرا و یک نفس","پادشاهی کن مرا فریاد رس","زمانه برای من تنگ شده و یک نفس، ای پادشاه، به من کمک کن و نجاتم بده."],[742,"گر مرا این بار ستاری کنی","توبه کردم من ز هر ناکردنی","اگر این بار مرا از گناه و عیب‌هایم بپوشانی و عذرهایم را بپذیری، من از هر کاری که نکرده‌ام، توبه کرده‌ام."],[742,"توبه‌ام بپذیر این بار دگر","تا ببندم بهر توبه صد کمر","توبه‌ام را این بار بپذیر تا دوباره عزم کنم که به طور جدی و محکم به توبه‌ام عمل کنم."],[742,"من اگر این بار تقصیری کنم","پس دگر مشنو دعا و گفتنم","اگر این بار هم خطایی کنم، دیگر از دعا و سخن من چیزی نشنو."],[742,"این همی زارید و صد قطره روان","که در افتادم به جلاد و عوان","شما به شدت ناله و زاری می‌کنید و اشک‌هایتان به اندازه‌ای است که مانند قطرات باران بر زمین می‌ریزد، در حالی که من در چنگال جلاد و ناپیوندگان به او گرفتار شدم."],[742,"تا نمیرد هیچ افرنگی چنین","هیچ ملحد را مبادا این حنین","هیچ غیرمومن و بی‌دینی به اندازه افرنگی (غیر مسلمان) نمی‌میرد، زیرا او از دلتنگی و ناله‌های شدید دلشکسته نمی‌شود."],[742,"نوحه‌ها می کرد او بر جان خویش","روی عزرائیل دیده پیش پیش","او همچون عزرائیل (فرشته مرگ) بر جان خود نوحه و گریه می‌کرد و در واقع آماده مرگ بوده و به آن فکر می‌کرد."],[742,"ای خدا و ای خدا چندان بگفت","که آن در و دیوار با او گشت جفت","ای خدا، تا چه اندازه او به تو دعا و ندا سر داد که در و دیوار نیز با او هم‌صدا شدند و همراهی کردند."],[742,"در میان یارب و یارب بد او","بانگ آمد از میان جست و جو","در میان صداهایی که عارف با فریاد «یارب» سر می‌دهد، ناگهان صدایی از عمق جست‌وجو به او می‌رسد."],[743,"جمله را جستیم پیش آی ای نصوح","گشت بیهوش آن زمان پرید روح","همه ما به دنبال تو هستیم، ای نصوح. در آن لحظه که تو بی‌هوش شدی، روح تو از بدن خارج شد."],[743,"هم‌چو دیوار شکسته در فتاد","هوش و عقلش رفت شد او چون جماد","نصوح، که در آن لحظه به شدت تحت تأثیر قرار گرفته و به حالتی شبیه به دیوار شکسته افتاده، هوش و عقلش را از دست می‌دهد و به مانند موجودی بی‌حرکت و بی‌روح می‌شود."],[743,"چونک هوشش رفت از تن بی‌امان","سر او با حق بپیوست آن زمان","وقتی که عقل و هوش او از بدنش رفت، در آن moment روحش به خداوند متصل شد."],[743,"چون تهی گشت و وجود او نماند","باز جانش را خدا در پیش خواند","زمانی که وجود نصوح از هر چیز تهی شد و دیگر چیزی از او باقی نماند، خداوند جان او را فراخواند."],[743,"چون شکست آن کشتی او بی‌مراد","در کنار رحمت دریا فتاد","زمانی که آن کشتی بی‌چاره و ناامید شکست و غرق شد، در کنار رحمت و رستگاری دریا قرار گرفت."],[743,"جان به حق پیوست چون بی‌هوش شد","موج رحمت آن زمان در جوش شد","زمانی که جان نصوح به حق پیوست و او بی‌هوش شد، موج رحمت خداوند در آن لحظه به شدت خروشان شد."],[743,"چون که جانش وا رهید از ننگ تن","رفت شادان پیش اصل خویشتن","هنگامی که جان او از خفت و خاری بدن رها شد، با خوشحالی به سوی اصل و منشأ خود، یعنی حق و حقیقت، شتافت."],[743,"جان چو باز و تن مرورا کنده‌ای","پای بسته پر شکسته بنده‌ای","جان مانند پرنده‌ای آزاد و رها شده است، در حالی که تن او مانند بند و زنجیری است که او را اسیر کرده است و با این حال او در قید و بند دنیوی قرار دارد و احساس بندگی می‌کند."],[743,"چونک هوشش رفت و پایش بر گشاد","می‌پرد آن باز سوی کیقباد","وقتی نصوح بی‌هوش شد و پایش رها گردید، آن باز (که نمادی از روح اوست) به سوی کیقباد پرواز می‌کند. کیقباد، اشاره به پادشاهی است که نمادی از عظمت و بلندمرتبه‌گی است."],[743,"چونک دریاهای رحمت جوش کرد","سنگها هم آب حیوان نوش کرد","زمانی که رحمت و برکت خداوند به شدت و به وفور جاری شد، حتی سنگ‌ها نیز از این آب حیات بهرمند شدند و جان تازه‌ای گرفتند."],[743,"ذره لاغر شگرف و زفت شد","فرش خاکی اطلس و زربفت شد","یک ذره لاغر و ضعیف به قدری بزرگ و با شکوه شد که فرش خاکی به مانند اطلس و زربفت زیبا و ارزشمند گردید."],[743,"مرده صدساله بیرون شد ز گور","دیو ملعون شد به خوبی رشک حور","مردی که صد سال مرده بود، از قبرش بیرون آمد و مانند دیوی زشت و بدکار شد، اما در عین حال زیبایی‌اش به حدی بود که برای حوریان نیز قابل رشک بود."],[743,"این همه روی زمین سرسبز شد","چوب خشک اشکوفه کرد و نغز شد","زمینی که خشک و بی‌حیات بود، اکنون پر از سبزی و شادابی شده و حتی چوب‌های خشک هم با درختی زیبا و شکوفا تبدیل شده‌اند."],[743,"گرگ با بره حریف می شده","ناامیدان خوش‌رگ و خوش پی شده","وقتی که ناامیدان به خوشی و نیکی می‌رسند، مثل گرگ و بره (که معمولا دشمن هم‌اند) در کنار یکدیگر می‌نشینند و رفاقت می‌کنند."],[744,"بعد از آن خوفی هلاک جان بده","مژده‌ها آمد که اینک گم شده","پس از این ترس و اضطراب که جان را از دست می‌دهد، خبر خوشی آمده که هم‌اکنون آن گوهر گم‌شده پیدا شده است."],[744,"بانگ آمد ناگهان که رفت بیم","یافت شد گم‌گشته آن در یتیم","ناگهان صدایی شنیده می‌شود که خبر از رفتن ترس و پیدا شدن آن مروارید گم‌شده و یتیم می‌دهد."],[744,"یافت شد واندر فرح در بافتیم","مژدگانی ده که گوهر یافتیم","گوهر یتیم پیدا شد و ما در شادی هستیم؛ پس به دیگران خبر دهید که ما این گوهر باارزش را یافته‌ایم."],[744,"از غریو و نعره و دستک زدن","پر شده حمام «قد زال الحزن»","حمام «قد زال الحزن» پر شده از صدای فریاد و ناله و دست زدن است."],[744,"آن نصوح رفته باز آمد به خویش","دید چشمش تابش صد روز بیش","نصوح که به نظر می‌رسد شخصیتی مهم در داستان باشد، بعد از مدتی که رفته بود، به خانه‌اش برگشت و متوجه شد که چشمانش نور و روشنی بیشتری نسبت به صد روز گذشته دارند."],[744,"می حلالی خواست از وی هر کسی","بوسه می‌دادند بر دستش بسی","هر کسی از او خواسته بود که شراب حلالی به او بدهد و برای این درخواست، به روی او بوسه می‌زدند و دستش را می‌بوسیدند."],[744,"بد گمان بردیم و کن ما را حلال","گوشت تو خوردیم اندر قیل و قال","ما به تو بدگمان شده‌ایم و از تو حلالیت می‌خواهیم، زیرا در بحث و جدل‌ها، از گوشت تو استفاده کرده‌ایم."],[744,"زانک ظن جمله بر وی بیش بود","زانک در قربت ز جمله پیش بود","چون همه گمان‌ها به او (نصوح) بیشتر بود، بنابراین در نزدیکی او (در ارتباط با او) از همه دیگران جلوتر بود."],[744,"خاص دلاکش بد و محرم نصوح","بلک هم‌چون دو تنی یک گشته روح","دلاکش خاص و خاصان محرم نصوح (مؤمن) است، بلکه مانند دو تن که روح واحدی شده‌اند، با هم یکی هستند."],[744,"گوهر ار برده‌ست او برده‌ست و بس","زو ملازم‌تر به خاتون نیست کس","اگر گوهر را او گرفته باشد، فقط خود او گرفته است و هیچ‌کس مانند او به این خانم وابسته و نزدیک نیست."],[744,"اول او را خواست جستن در نبرد","بهر حرمت داشتش تاخیر کرد","نخست او (شاه‌زاده) تصمیم گرفت که در میدان نبرد به دنبال حرمتی که برای او قائل شده بودند، به جستجوی او (گوهر) برود و به همین خاطر تاخیر کرد."],[744,"تا بود کان را بیندازد به جا","اندرین مهلت رهاند خویش را","در این بیت اشاره به این است که تا زمانی که فرصت (مهلت) وجود دارد، انسان باید در تلاش باشد تا خود را از تنش‌ها و مشکلات نجات دهد و به آرامش برسد. \"کان\" به معنای دغدغه یا مسائل سنگین است که باید کنار گذاشته شوند."],[744,"این حلالی‌ها ازو می‌خواستند","وز برای عذر برمی‌خاستند","حاجبکان و کنیزکان شاه‌زاده از او(نصوح) درخواست حلالی (بخششی) می‌کردند و برای این خواسته خود دلیل و عذر می‌آوردند."],[744,"گفت بد فضل خدای دادگر","ورنه زآنچم گفته‌شد هستم بتر","گفت: اگر فضل و رحمت خداوند دادگر نبود، من بدتر از آنچه که تاکنون گفته‌ام هستم."],[744,"چه حلالی خواست می‌باید ز من؟","که منم مجرم‌تر اهل زمن","کسانی که در دربار هستند (حاجبکان و کنیزکان) چه خواسته‌ای از من دارند؟ در حالی که من خود از همه مردم این زمان گناهکارترم."],[744,"آنچ گفتندم ز بد از صد یکیست","بر من این کشفست ار کس را شکیست","آنچه من درباره بدی‌ها گفتم تنها یک‌صدوم از بدی‌های من است، و این حقیقتی است که فرد دیگری اگر شک دارد، باید بداند."],[744,"کس چه می‌داند ز من جز اندکی؟","از هزاران جرم و بد فعلم یکی","هیچ‌کس جز اندکی در مورد من چیزی نمی‌داند. من از میان هزاران گناه و بدی که دارم، تنها یکی را می‌توانم بیان کنم."],[744,"من همی‌دانم و آن ستار من","جرمها و زشتی کردار من","من خود آگاه هستم که ستار (پوشاننده‌ی عیب‌ها) من، به جرم‌ها و زشتی‌های کردارم آگاه است."],[744,"اول ابلیسی مرا استاد بود","بعد از آن ابلیس پیشم باد بود","در ابتدا شیطان معلم من بود و بعدها شیطان همواره در کنار من بود."],[744,"حق بدید آن جمله را نادیده کرد","تا نگردم در فضیحت روی‌زرد","حق (یا خدا) به من اجازه داد تا نادیده بگذرم و به خطاهایم توجه نکنم، تا اینکه در دنیای رسوایی و شرم گرفتار نشوم."],[744,"باز رحمت پوستین دوزیم کرد","توبه شیرین چو جان روزیم کرد","رحمت الهی مانند یک پوستین نرم و گرم ما را در بر می‌گیرد و ما با توبه‌ای شیرین، زندگی تازه‌ای همچون جان را آغاز می‌کنیم."],[744,"هرچه کردم جمله ناکرده گرفت","طاعت ناکرده آورده گرفت","هرچه انجام دادم، شمرده نشده و به حساب نیامده، به طور کلی کارهای ناتمام و اطاعت نکرده‌ام، به‌عنوان کارهای خطا و ناپسند در نظر گرفته شده است."],[744,"هم‌چو سرو و سوسنم آزاد کرد","هم‌چو بخت و دولتم دلشاد کرد","مانند سرو و گل سوسن که آزاد و خوش ‌نما هستند، او (خداوند) مرا نیز آزاد کرده و مانند بخت و سعادت من، دلم را شاد کرده است."],[744,"نام من در نامه پاکان نوشت","دوزخی بودم ببخشیدم بهشت","در نامه پاکان، نام من ثبت شده است، اما با اینکه دوزخی بودم، اکنون به من بخشیده شده و در بهشت جای گرفته‌ام."],[744,"آه کردم چون رسن شد آه من","گشت آویزان رسن در چاه من","وقتی که من آه کشیدم، مانند این بود که آهم به رسن تبدیل شد و حالا این آیه به‌سان رسنی در چاه من آویزان است."],[744,"آن رسن بگرفتم و بیرون شدم","شاد و زفت و فربه و گلگون شدم","با گرفتن آن رسن و بیرون آمدن از چاه، خوشحال و خوش‌اندام و با صورت گلگون شدم."],[744,"در بن چاهی همی‌بودم زبون","در همه عالم نمی‌گنجم کنون","من مدت‌ها در قعر چاهی به‌زانو و اسیر بودم و اکنون توانستم از این وضعیت نجات پیدا کنم و در تمام جهان جایگاه و حائزی پیدا کرده‌ام."],[744,"آفرین‌ها بر تو بادا ای خدا","ناگهان کردی مرا از غم جدا","ای خدا، ستایش بر تو باد که ناگهان مرا از غم و اندوه رها کردی."],[744,"گر سر هر موی من یابد زبان","شکرهای تو نیاید در بیان","اگر هر موی من زبانی داشته باشد، باز هم نمی‌تواند شیرینی زبان تو را وصف کند."],[744,"می‌زنم نعره درین روضه و عیون","خلق را «یا لیت قومی یعلمون»","من در این باغ فریاد می‌زنم و می‌گویم کاش قوم من می‌دانستند، اشاره به حسرتی دارم که مردم از حقیقت و زیبایی‌های این مکان آگاه نیستند."],[745,"بعد از آن آمد کسی کز مرحمت","دختر سلطان ما می‌خواندت","سپس کسی آمد و گفت که به خاطر لطف و محبت دختر شاه، تو را می‌خواند."],[745,"دختر شاهت همی‌خواند بیا","تا سرش شویی کنون ای پارسا","دختر شاه تو از تو دعوت می‌کند تا بیایی و سر او را بشویی، ای پارسا (انسان صحیح‌کار)."],[745,"جز تو دلاکی نمی‌خواهد دلش","که بمالد یا بشوید با گلش","غیر از تو، هیچ راهی برای درمان دل نصوح وجود ندارد؛ او نیاز به دلاکی ندارد، بلکه باید دلش را با تو پاک کند و به تو نزدیک شود."],[745,"گفت رو رو دست من بی‌کار شد","وین نصوح تو کنون بیمار شد","نصوح می‌گوید که شرایطش اکنون تغییر کرده و به طور جدی بیمار شده است، بنابراین به دیگران توصیه می‌کند که به او مراجعه نکنند و به او کار یا مسوولیتی نسپارند."],[745,"رو کسی دیگر بجو اشتاب و تفت","که مرا والله دست از کار رفت","به کسی دیگر رو کن و دنبال او باش، زیرا به خدا قسم، من از این کار (توبه و اصلاح) دست کشیدم و نمی‌توانم ادامه دهم."],[745,"با دل خود گفت کز حد رفت جرم","از دل من کی رود آن ترس و گرم","او با خود می‌گوید که گناهانش به حدی رسیده که دیگر نمی‌تواند از دل او برود و می‌ترسد و مضطرب است."],[745,"من بمردم یک ره و باز آمدم","من چشیدم تلخی مرگ و عدم","من یک بار مرده‌ام و دوباره به زندگی بازگشته‌ام. من طعم تلخ مرگ و نیستی را چشیدم."],[745,"توبه‌ای کردم حقیقت با خدا","نشکنم تا جان شدن از تن جدا","من با خدا توبه‌ای کردم که این توبه را با هیچ چیزی نمی‌شکنم، حتی اگر جانم از بدن جدا شود."],[745,"بعد آن محنت کرا بار دگر","پا رود سوی خطر الا که خر","بعد از آن همه سختی که کشیدم، اگر دوباره به سمت خطر بروم، کمترین عاقبت من چیزی جز بدبختی نیست."],[746,"گازری بود و مر او را یک خری","پشت ریش اشکم تهی و لاغری","گازر (گازر، یعنی کسی که گازرانی می‌کند، در اینجا به معنای کشاورز است) و افزون بر او، یک الاغ داشت که در زیر ریش او، نشان از اشک و بی‌حالی و لاغری مشهود بود. در واقع، این تصویر بیانگر حال و روز دشوار و غم‌انگیز کشاورز و شرایط سخت اوست."],[746,"در میان سنگلاخ بی‌گیاه","روز تا شب بی‌نوا و بی‌پناه","در جایی سنگلاخی و بی‌گیاه، فردی روز و شب را در تنهایی و بی‌پناهی سپری می‌کند و احساس بی‌نوایی می‌کند."],[746,"بهر خوردن جز که آب آنجا نبود","روز و شب بد خر در آن کور و کبود","فقط آب آنجا برای خوردن وجود داشت و در طول شب و روز، خر بدبخت در آنجا از شدت بی‌پناهی و تنگدستی به شکل ناامید و مایوس زندگی می‌کرد."],[746,"آن حوالی نیستان و بیشه بود","شیر بود آنجا که صیدش پیشه بود","در آن اطراف، ناحیه‌ای پر از نی و جنگل وجود داشت و شیر نیز در آنجا بود که شکار کردن برایش حرفه و کار اصلی‌اش بود."],[746,"شیر را با پیل نر جنگ اوفتاد","خسته شد آن شیر و ماند از اصطیاد","شیر با فیل نر درگیر جنگ شد و از شدت خستگی، دیگر نتوانست شکار کند و به حالت ناامیدی باقی ماند."],[746,"مدتی وا ماند زان ضعف از شکار","بی‌نوا ماندند دد از چاشت‌خوار","مدتی به دلیل ضعف، شیر از شکار و صید باز ماند و حیوانات وحشی نیز از ترس او بی‌پناه و بی‌غذا شده بودند."],[746,"زانک باقی‌خوار شیر ایشان بدند","شیر چون رنجور شد تنگ آمدند","زیرا شیر، که باقی‌خوار (غذای اصلی) آن‌ها بود، به شدت بیمار و ناتوان شد و در نتیجه آن‌ها را به زحمت انداخت و به تنگنا دچار کرد."],[746,"شیر یک روباه را فرمود رو","مر خری را بهر من صیاد شو","شیر به روباه گفت که برو و به دنبال یک گورخر برای من بگرد و آن را شکار کن."],[746,"گر خری یابی به گرد مرغزار","رو فسونش خوان فریبانش بیار","اگر به دور مرغزار، خر (حیوانی دیگر) را پیدا کنی، به او جادو و فریب‌هایی را یاد بده که او را به سمت خود جذب کند."],[746,"چون بیابم قوتی از گوشت خر","پس بگیرم بعد از آن صیدی دگر","اگر از گوشت خر نیرویی به دست آورم، بعد از آن شکار دیگری را می‌گیرم."],[746,"اندکی من می‌خورم باقی شما","من سبب باشم شما را در نوا","من کمی از آنچه در اختیار دارم می‌خورم، ولی شما باقی را مصرف کنید، چرا که من می‌خواهم سبب و منبع خوشی شما باشم و شما را در زندگی شاد نگه دارم."],[746,"یا خری یا گاو بهر من بجوی","زان فسونهایی که می‌دانی بگوی","برای من، یا خر بیاور یا گاو، تا از آن جادوها و فریب‌هایی که می‌دانی برایم بگویی."],[746,"از فسون و از سخنهای خوشش","از سرش بیرون کن و اینجا کشش","از وسوسه‌ها و گفتارهای شیرین که او را گمراه می‌کند، دورش کن و اینجا او را به حقیقت نزدیک کن."],[747,"قطب شیر و صید کردن کار او","باقیان این خلق باقی‌خوار او","قطب، به مانند شیر است که به کار صید کردن می‌پردازد و دیگران (باقیان) از او بهره‌مند می‌شوند و در واقع اوست که این انسان‌ها را در مسیر رشد و کمال یاری می‌دهد."],[747,"تا توانی در رضای قطب کوش","تا قوی گردد کند صید وحوش","تا جایی که می‌توانی برای خوشنودی و رضایت قطب تلاش کن تا قوی‌تر شوی و قدرت صید جانوران وحشی را پیدا کنی."],[747,"چون برنجد بی‌نوا مانند خلق","کز کف عقلست جمله رزق حلق","وقتی بی‌نوایان (مردم) از کوره در می‌روند، مانند دیگر مخلوقات هستند که روزی و رزق‌شان از قضا و خرد الهی تأمین می‌شود."],[747,"زانک وجد حلق باقی خورد اوست","این نگه دار ار دل تو صیدجوست","زیرا عاشق حقیقی، که در طلب وصال خداوند است، از عشق و احساس گرسنگی به حق او را می‌جوید و نگه‌دارنده این عشق، دل اوست که در جستجوی معشوق است."],[747,"او چو عقل و خلق چون اعضا و تن","بسته عقلست تدبیر بدن","او مانند عقل است و مردم را همچون اعضای یک بدن به هم متصل می‌کند و تدبیر جامعه را بر عهده دارد."],[747,"ضعف قطب از تن بود از روح نی","ضعف در کشتی بود در نوح نی","ضعف قطب (شخصی مهم در دین یا عرفان) به خاطر جسمش و بدنش است، نه به خاطر روحش. مانند ضعف در کشتی نوح نیست که بخواهد او را ناتوان کند."],[747,"قطب آن باشد که گرد خود تند","گردش افلاک گرد او بود","قطب به کسی گفته می‌شود که در مرکز عالم هستی است و همه چیز به دور او می‌چرخد، مانند اینکه افلاک به دور او در حرکت‌اند."],[747,"یاریی ده در مرمه کشتی‌اش","گر غلام خاص و بنده گشتی‌اش","اگر کسی در مسائل مهم و دشوار زندگی به او کمک کند و یاری‌اش کند، مانند یک غلام خاص و بنده‌اش که در کشتی‌اش در زمان طوفان و خطر به او خدمت می‌کند، این یاری خیلی ارزشمند است."],[747,"یاریت در تو فزاید نه اندرو","گفت حق ان تنصروا الله تنصروا","خداوند می‌گوید اگر به یاری او بپردازید، او نیز به شما یاری خواهد رساند. بنابراین، یاری شما به خداوند باعث افزایش برکت و یاری در وجود شما خواهد شد."],[747,"هم‌چو روبه صید گیر و کن فدیش","تا عوض گیری هزاران صید بیش","چنان‌که روباه در صید گرفتن مهارت دارد و جان خود را فدای آن می‌کند، تو نیز باید تلاش کنی تا به‌دست آوردن نعمت‌ها و فرصت‌های بسیار بپردازی."],[747,"روبهانه باشد آن صید مرید","مرده گیرد صید کفتار مرید","قطب عارف واصل مانند روباهی است که مریدان زنده را در نزد او جذب می‌کند، ولی در عوض، مریدانی که به کفتار (تمثیلی از افراد بی‌فایده و گمراه) تبدیل شده‌اند، از او می‌گریزند."],[747,"مرده پیش او کشی زنده شود","چرک در پالیز روینده شود","مرده‌ای که در حضور او (شیر) قرار گیرد، زنده می‌شود و خاکی که در زمین (پالیز) است، سبز و روینده می‌گردد."],[747,"گفت روبه شیر را خدمت کنم","حیله‌ها سازم ز عقلش بر کنم","روبه (روباه) تصمیم می‌گیرد که به شیر خدمت کند و برای این کار نقشه‌هایی می‌کشد و از هوش و درایت خود بهره می‌برد."],[747,"حیله و افسونگری کار منست","کار من دستان و از ره بردنست","من کارم خیانت و نیرنگ است و مهارت من در فریب دادن و کنترل دیگران است."],[747,"از سر که جانب جو می‌شتافت","آن خر مسکین لاغر را بیافت","شخصی که در جست‌وجوی آب و غذا بود، آن خر لاغر و بیچاره را پیدا کرد که به سمت آب می‌رفت."],[747,"پس سلام گرم کرد و پیش رفت","پیش آن ساده دل درویش رفت","او (خر مسکین) که در میان صحرا و سنگلاخ به یاری‌اش شتافته بود، به درویش ساده‌دل سلامی گرم داد و به سمت او پیش رفت."],[747,"گفت چونی اندرین صحرای خشک","در میان سنگلاخ و جای خشک","سوال کرد که حال تو در این دشت خشک و بی‌آب و علف چگونه است، وقتی که همه جا سنگلاخ و بی‌حصار است؟"],[747,"گفت خر گر در غمم گر در ارم","قسمتم حق کرد من زان شاکرم","اگرچه در غم و اندوه باشم یا در نعمت و شادی، به خاطر اینکه قسمت و سرنوشت من به دست حق است، از آن شکرگزارم."],[747,"شکر گویم دوست را در خیر و شر","زانک هست اندر قضا از بد بتر","من در هر شرایطی، چه خوب و چه بد، شکر خدا را به جا می‌آورم؛ زیرا در قضا و قدر الهی، بدی‌ها از خوبی‌ها بهترند."],[747,"چونک قسام اوست کفر آمد گله","صبر باید صبر مفتاح الصله","چون خداوند (قسام) منبع بخشش و تقسیم اراده‌اش است، اگر که کفر و نافرمانی (گله) پیش آمد، باید صبر کرد؛ زیرا صبر کلید وصل و ارتباط با خداست."],[747,"غیر حق جمله عدواند اوست دوست","با عدو از دوست شکوت کی نکوست","غیر از خدا همه نسبت به انسان‌ها ظلم و ستم می‌کنند. دوستی با خدا از دوستی با دیگران بهتر است، زیرا چه خوب است که انسان از دوستان خود درد و شکایت نکند."],[747,"تا دهد دوغم نخواهم انگبین","زانک هر نعمت غمی دارد قرین","من تا زمانی که دو غم در دلم وجود دارد، نمی‌خواهم عسل (نماد لذت و خوشی) را بچشم، زیرا هر نعمت و خوشی، غمی هم با خود به همراه دارد."],[748,"بود سقایی مرورا یک خری","گشته از محنت دو تا چون چنبری","یک سقا که مرد آب‌کش است، در حالتی میان رنج و محنت به سر می‌برد، به حدی که حالش به حال خرها شبیه شده و خود را همچون چنبری (چنبر، حلقه‌ای که در کشش بکار می‌رود) می‌بیند. در واقع، او به شدت از مشکلات و سختی‌ها رنج می‌کشید."],[748,"پشتش از بار گران صد جای ریش","عاشق و جویان روز مرگ خویش","به خاطر بار سنگینی که بر دوش دارد، جاهای زیادی از بدنش ریش (مو) روییده و نشان‌دهنده جراحت و زحمتی است که در این مسیر عاشقانه و جستجوی معشوق متحمل شده است. او در پی روز مرگ خود است."],[748,"جو کجا از کاه خشک او سیر نی","در عقب زخمی و سیخی آهنی","جو از کاه خشک او سیر نمی‌شود و در عوض در پشت او زخمی و سیخی از آهن وجود دارد. این بیان به معنای آن است که نتیجه‌ی تلاش و زحمت، همواره با مشکلات و سختی‌ها همراه است و ممکن است خوشبختی و رضایت به سادگی به دست نیاید."],[748,"میر آخر دید او را رحم کرد","که آشنای صاحب خر بود مرد","مردی که به خر هیزم‌فروش توجه کرد، ناگهان متوجه شد که او با صلاحت و رحمت بر روی این خر قرار دارد و چون این مرد، آشنای صاحب خر بود، به او رحم کرده است."],[748,"پس سلامش کرد و پرسیدش ز حال","کز چه این خر گشت دوتا هم‌چو دال","زننده سلام از خر هیزم‌فروش می‌پرسد که چطور شد که این خر به دو نیم تقسیم شد و حالا به شکل دوتا شده است."],[748,"گفت از درویشی و تقصیر من","که نمی‌یابد خود این بسته‌دهن","او می‌گوید که به خاطر فقر و ناتوانی‌اش، نمی‌تواند به حقیقت و معنای خود پی ببرد و در نتیجه، در قید و بند محدودیت‌ها قرار گرفته است."],[748,"گفت بسپارش به من تو روز چند","تا شود در آخر شه زورمند","او می‌گوید به من این خر (که象ی است از بار مشکلات) را بسپار، که در نهایت، او (سلطان یا فرمانروا) به خودی خود قدرت و توانایی دارد و چند روزی می‌توان با او همراهی کرد."],[748,"خر بدو بسپرد و آن رحمت‌پرست","در میان آخر سلطانش بست","خر را به او سپردند و آن پرستنده رحمت، در نهایت در کنار سلطان خود قرار گرفت."],[748,"خر ز هر سو مرکب تازی بدید","با نوا و فربه و خوب و جدید","مولانا از دیدن یک الاغ (خر) سخن می‌گوید که در سمت‌های مختلف، اسب‌های عربی زیبا و خوش‌صدا را می‌بیند که جوان و فربه‌اند. این تصویر به نوعی نمادین است و می‌تواند به خواسته‌ها و آرزوهای انسانی اشاره داشته باشد."],[748,"زیر پاشان روفته آبی زده","که به وقت و جو به هنگام آمده","زیر پاهای آن خر، آبی پیدا شده که به موقع و در زمان مناسب به زمین رسیده است."],[748,"خارش و مالش مر اسپان را بدید","پوز بالا کرد کای رب مجید","خر، با خارش و مالش خود، به حسن و زیبایی‌اش می‌بالد و دعا می‌کند: ای پروردگار بخشنده، به من لطف کن."],[748,"نه که مخلوق توم گیرم خرم","از چه زار و پشت ریش و لاغرم","من نمی‌خواهم به مخلوق تو چنگ زنم و خوشحال باشم، زیرا حال من زار است و پشت من درد می‌کند و لاغر شده‌ام."],[748,"شب ز درد پشت و از جوع شکم","آرزومندم به مردن دم به دم","به خاطر دردهای کمر و گرسنگی، هر لحظه آرزو می‌کنم که ای کاش بمیرم."],[748,"حال این اسپان چنین خوش با نوا","من چه مخصوصم به تعذیب و بلا","این که اسپان به این خوبی و با نغمه‌ای دل‌انگیز در حال نواختن هستند، به من چه ارتباطی دارد که باید در رنج و عذاب بگذرانم؟"],[748,"ناگهان آوازه پیگار شد","تازیان را وقت زین و کار شد","ناگهان صدای اسب‌ها به گوش رسید و وقتی رسید که تازی‌ها آماده نبرد و کار شدند."],[748,"زخمهای تیر خوردند از عدو","رفت پیکانها دریشان سو به سو","زخم‌های تیر از دشمن بر تن آن‌ها فرورفته و تیرها در بدنشان به این سو و آن سو رفته‌اند."],[748,"از غزا باز آمدند آن تازیان","اندر آخر جمله افتاده ستان","تازیان (اسب‌ها) از جنگ بازگشته‌اند و در آخر همین حال، شتابان و به دنبال گرفتن غنیمت‌ها هستند."],[748,"پایهاشان بسته محکم با نوار","نعلبندان ایستاده بر قطار","گروه تازیان (سربازان) در صف ایستاده‌اند و پاهایشان به وسیله نعلبندهایی محکم بسته شده است."],[748,"می‌شکافیدند تن‌هاشان بنیش","تا برون آرند پیکانها ز ریش","از شدت فشار و سختی، به اجبار بدن‌هایشان را می‌شکافتند تا پیکان‌ها را که در ریششان گیر کرده بود، خارج کنند."],[748,"آن خر آن را دید و می‌گفت ای خدا","من به فقر و عافیت دادم رضا","خر که به این وضعیت نگاه می‌کرد، از خدا می‌خواست که به او فقر و سلامت بدهد و در واقع به این وضعیت راضی بود."],[748,"زان نوا بیزارم و زان زخم زشت","هرکه خواهد عافیت دنیا بهشت","من از آن نوا و آن زخم زشت بیزارم؛ هرکس که بخواهد آرامش و راحتی این دنیا را به‌دست‌آورد، در حقیقت به بهشت خواهد رسید."],[749,"گفت روبه جستن رزق حلال","فرض باشد از برای امتثال","روباه گفت که به دست آوردن روزی حلال واجب است و انجام آن از سوی انسان‌ها لازم و ضروری است."],[749,"عالم اسباب و چیزی بی‌سبب","می‌نباید پس مهم باشد طلب","در این بیت، مولانا بیان می‌کند که در دنیای ما همه چیز به دلیل و سبب خاصی اتفاق می‌افتد و بنابراین، اهمیت دارد که انسان به دنبال هدف و طلبی معقول و منطقی باشد و نباید به چیزهایی که بدون علت هستند، توجه کند."],[749,"وابتغوا من فضل الله است امر","تا نباید غصب کردن هم‌چو نمر","در این بیت گفته شده است که باید در جستجوی روزی و نعمت‌های الهی بود و از غصب و نیرنگ مانند نمر (شیر) پرهیز کرد، زیرا این کار ناپسند است."],[749,"گفت پیغامبر که بر رزق ای فتی","در فرو بسته‌ست و بر در قفلها","پیامبر گفت که ای جوان، روزی و رزق شما در برخی جاها بسته است و در برابر آن درهایی قفل شده‌اند."],[749,"جنبش و آمد شد ما و اکتساب","هست مفتاحی بر آن قفل و حجاب","تحرک و تلاش ما در کسب روزی، کلیدی است برای بازکردن آن قفل و مانع."],[749,"بی‌کلید این در گشادن راه نیست","بی‌طلب نان سنت الله نیست","برای گشادن این در (دری که به دانش و حقیقت منتهی می‌شود) بدون کلید (یعنی بدون طلب و کوشش) ممکن نیست و بدون طلب نان (معاش و روزی) از سنت الهی (خدای بزرگ) نیز خبری نیست."],[750,"گفت از ضعف توکل باشد آن","ورنه بدهد نان کسی که داد جان","در این بیت، معنای این جمله این است که اگر به خداوند اعتماد و توکل داشته باشی، او کسی را که جانش را فدای او کرده است، برایش نان (رزق) هم فراهم می‌کند. در واقع، نشان می‌دهد که اعتماد به خداوند در فراهم آوردن نیازهای زندگی مؤثر است."],[750,"هر که جوید پادشاهی و ظفر","کم نیاید لقمه نان ای پسر","هرکس که به دنبال پادشاهی و پیروزی باشد، نباید نگران کمبود نان و روزی باشد."],[750,"دام و دد جمله همه اکال رزق","نه پی کسپ‌اند نه حمال رزق","همه موجودات زنده (حیوانات و انسان‌ها) تنها به منظور تأمین روزی و روزی خود به زندگی ادامه می‌دهند، نه اینکه به دنبال کسب و کار یا بارکشیدن باشند."],[750,"جمله را رزاق روزی می‌دهد","قسمت هر یک به پیشش می‌نهد","تمام موجودات را خداوند روزی می‌دهد و تقسیم روزی هر یک را به خودشان می‌سپارد."],[750,"رزق آید پیش هر که صبر جست","رنج کوششها ز بی‌صبری تست","رزق و روزی به سراغ هر کسی می‌آید که صبر کند و دردسرها و زحمت‌ها ناشی از بی‌صبری خودت است."],[751,"گفت روبه آن توکل نادرست","کم کسی اندر توکل ماهرست","روباه به خر می‌گوید که توکل نادرستی داری، چرا که کمتر کسی در توکل، مانند تو نادان است."],[751,"گرد نادر گشتن از نادانی است","هر کسی را کی ره سلطانی است","نادانی باعث می‌شود که انسان به جایی نرسد و از راه‌های موفقیت دور شود. هر کس باید بداند که تنها افراد دانا و آگاه می‌توانند به مقام سلطنت و رهبری دست یابند."],[751,"چون قناعت را پیمبر گنج گفت","هر کسی را کی رسد گنج نهفت","پیامبر (Mohammad) قناعت را به عنوان گنجی ارزشمند معرفی کرده است، زیرا تنها افرادی می‌توانند به این گنج دست یابند که از خواسته‌های بی‌پایان خود چشم‌پوشی کنند."],[751,"حد خود بشناس و بر بالا مپر","تا نیفتی در نشیب شور و شر","حد و مرز خود را بشناس و از آن فراتر نرو تا در دلهره و آشفتگی سقوط نکنی."],[752,"گفت این معکوس می‌گویی بدان","شور و شر از طمع آید سوی جان","او گفت که تو در اینجا معکوس صحبت می‌کنی و می‌گوید که شور و هیجان از طمع به جان انسان می‌رسد."],[752,"از قناعت هیچ کس بی‌جان نشد","از حریصی هیچ کس سلطان نشد","هیچ‌کس به خاطر قناعت دچار بی‌حالی و بی‌جان شدن نشده و همچنین هیچ‌کس به خاطر حرص و طمع، به مقام سلطنت دست نیافته است."],[752,"نان ز خوکان و سگان نبود دریغ","کسپ مردم نیست این باران و میغ","نان حاصل از خوک‌ها و سگ‌ها نیست که کسی نسبت به آن احساس کمبود کند؛ زیرا باران و ابر، برای مردم است و برای کسی که به آن نیاز دارد، فرستاده شده‌اند."],[752,"آنچنان که عاشقی بر رزق زار","هست عاشق رزق هم بر رزق‌خوار","عاشق واقعی به قدری به خوراک و مایحتاج زندگی وابسته است که نمی‌تواند از آن غفلت کند؛ همچنین، عاشق خوراک نیز به حدی به آدمی که روزی‌اش را می‌دهد وابسته است."],[753,"آن یکی زاهد شنود از مصطفی","که یقین آید به جان رزق از خدا","زاهد (رهبر معنوی) از محمد (پیامبر اسلام) شنیده است که رزق و روزی به‌طور قطع و مسلم از سوی خداوند به انسان می‌رسد."],[753,"گر بخواهی ور نخواهی رزق تو","پیش تو آید دوان از عشق تو","اگر بخواهی یا نخواهی، روزی و رزق تو به خاطر عشق تو، به سرعت به سوی تو می‌آید."],[753,"از برای امتحان آن مرد رفت","در بیابان نزد کوهی خفت تفت","مرد برای آزمایش توکلش به بیابان رفت و در کنار کوهی دراز کشید و در آنجا استراحت کرد."],[753,"که ببینم رزق می‌آید به من","تا قوی گردد مرا در رزق ظن","زاهد به خود می‌گوید که می‌خواهم ببینم آیا روزی به من می‌رسد یا نه، تا ایمانم به این‌که خداوند روزی‌دهنده است، قوی‌تر شود."],[753,"کاروانی راه گم کرد و کشید","سوی کوه آن ممتحن را خفته دید","کاروانی در مسیر خود دچار سردرگمی شد و به سمت کوه رفت، جایی که آن زاهد (ممتحن) را در حال خوابیدن مشاهده کردند."],[753,"گفت این مرد این طرف چونست عور","در بیابان از ره و از شهر دور","سوال این مرد این است که این شخص چگونه است که در بیابان، دور از راه و شهر، به صورت ناشناس و بدون هیچ حفاظتی قرار دارد؟"],[753,"ای عجب مرده‌ست یا زنده که او","می‌نترسد هیچ از گرگ و عدو","عجب است که این فرد، چه مرده باشد و چه زنده، از گرگ و دشمن هیچ ترسی ندارد."],[753,"آمدند و دست بر وی می‌زدند","قاصدا چیزی نگفت آن ارجمند","افرادی آمدند و به او دست می‌زدند، ولی آن شخصیت محترم، چیزی نگفت."],[753,"هم نجنبید و نجنبانید سر","وا نکرد از امتحان هم او بصر","او هیچ حرکتی نکرد و هیچ چیز را نیز تکان نداد و سرش را از امتحان خداوند برنداشت و چشمانش را نیز نبست."],[753,"پس بگفتند این ضعیف بی‌مراد","از مجاعت سکته اندر اوفتاد","گفتند این زاهد ضعیف که در اثر گرسنگی و بی‌کسی به حالت ضعف و سکته افتاده، بدون هدف و آرزو مانده است."],[753,"نان بیاوردند و در دیگی طعام","تا بریزندش به حلقوم و به کام","غذا آوردند و در دیگی گذاشتند تا آن را به دهانش بریزند و بخورد."],[753,"پس بقاصد مرد دندان سخت کرد","تا ببیند صدق آن میعاد مرد","پس مردی که قصد او کرده بود، تصمیم گرفت تا دندانش را سخت کند و محکم کند، تا صدق و حقیقت آن قرار و وعده‌ای که با خدا داشت را ببیند."],[753,"رحمشان آمد که این بس بی‌نواست","وز مجاعت هالک مرگ و فناست","نسبت به وضعیت این مرد زاهد که در گرسنگی شدید به سر می‌برد، دل دیگران به رحم آمد و آن‌ها متوجه شدند که او در این شرایط سخت و فقیرانه در آستانه مرگ و نابودی قرار دارد."],[753,"کارد آوردند قوم اشتافتند","بسته دندانهاش را بشکافتند","جمعی برای او کارد آوردند و به سرعت به سمت او شتافتند و دندان‌های او را با کارد باز کردند."],[753,"ریختند اندر دهانش شوربا","می‌فشردند اندرو نان‌پاره‌ها","قوم در حال از بین بردن زاهد هستند و در عین حال شوربا (آب گوشت) به دهان او می‌ریزند و نان پاره‌ها را نیز در آن می‌فشارند. این عمل نشان‌دهنده بی‌رحمی و ستمی است که بر او می‌رود."],[753,"گفت ای دل گرچه خود تن می‌زنی","راز می‌دانی و نازی می‌کنی","دل، حتی اگر به این بدن و مادیات خود آسیب برسانی، اما تو از رازها آگاهی و در دل خود زیبایی و ناز و فخر داری."],[753,"گفت دل دانم و قاصد می‌کنم","رازق الله است بر جان و تنم","دل به من می‌گوید که من می‌دانم و به خوبی آگاه هستم که خالق و روزی‌دهنده، تنها خداوند است و او بر جان و تن من نظر دارد."],[753,"امتحان زین بیشتر خود چون بود","رزق سوی صابران خوش می‌رود","سختی و آزمایش‌های بیشتر از این برای افراد صابر و شکیبا، به نوعی برکتی و عبادی محسوب می‌شود، زیرا روزی و روزی‌دهی از جانب خداوند به آنان بیشتر و بهتر می‌رسد."],[754,"گفت روبه این حکایت را بهل","دستها بر کسب زن جهد المقل","روباه به خر می‌گوید این داستان را رها کن و دستت را برای کسب و کار بالا ببر، در تلاش و کوشش برای بهبود وضعیتت باش."],[754,"دست دادستت خدا کاری بکن","مکسبی کن یاری یاری بکن","خدا به تو دست داده، بنابراین کاری انجام بده و کسب و کار و تلاش کن. به دیگران هم در کارشان کمک کن."],[754,"هر کسی در مکسبی پا می‌نهد","یاری یاران دیگر می‌کند","هر کسی که در کار و کسب خود شروع می‌کند، به یاری دیگران نیز می‌شتابد و از آن‌ها حمایت می‌کند."],[754,"زانک جمله کسب ناید از یکی","هم دروگر هم سقا هم حایکی","کسب و کار هیچ‌گاه تنها از یک نفر حاصل نمی‌شود، بلکه نیاز به همکاری و تلاش همگان دارد؛ مانند دروگر، سقا (آب‌رسان) و حایکی (کارگر معین) که هرکدام سهمی در انجام کار دارند."],[754,"هین به انبازیست عالم بر قرار","هر کسی کاری گزیند ز افتقار","مراقب باشید که این جهان پر از بازی است و افراد در آن با توجه به نیاز و وابستگی‌های خود، کار و شغل متفاوتی را انتخاب می‌کنند."],[754,"طبل‌خواری در میانه شرط نیست","راه سنت کار و مکسب کردنیست","به صدا زدن دیگران و جلب توجه آنها در میانه‌ی کار، کار درستی نیست؛ بلکه بر مبنای سنت، باید کار و کسب استقلالی را پیش گرفت."],[755,"گفت من به از توکل بر ربی","می‌ندانم در دو عالم مکسبی","او می‌گوید من نمی‌دانم که کسب و کار بهتری از توکل بر پروردگار در دو جهان وجود دارد."],[755,"کسب شکرش را نمی‌دانم ندید","تا کشد رزق خدا رزق و مزید","نمی‌دانم چگونه شکر و قدر روزی خدا را به جای آورم، تا زمانی که او به من روزی و نعمت بیشتری عطا کند."],[755,"بحثشان بسیار شد اندر خطاب","مانده گشتند از سؤال و از جواب","گفت‌وگوهایشان بسیار طولانی شد و در میان صحبت‌ها، هر دو طرف از سؤال و پاسخ‌گویی بازماندند."],[755,"بعد از آن گفتش بدان در مملکه","نهی لا تلقوا بایدی تهلکه","بعد از آن به او گفتند که در این کشور نباید خودتان را به خطر بیندازید."],[755,"صبر در صحرای خشک و سنگلاخ","احمقی باشد جهان حق فراخ","صبر کردن در بیابان خشک و سنگلاخی که هیچ چیز در آن نیست، نشانه حماقت است، زیرا در جهانی که حق و حقیقت وسیع و بزرگ است، باید به سوی آن رفت و از فرصت‌ها بهره برد."],[755,"نقل کن زینجا به سوی مرغزار","می‌چر آنجا سبزه گرد جویبار","به اینجا به سمت مرتع سبز برو، زیرا آنجا سبزه‌هایی به دور جویبار رشد کرده است."],[755,"مرغزاری سبز مانند جنان","سبزه رسته اندر آنجا تا میان","مرغزاری سبز مانند بهشت وجود دارد که در آن سبزه‌زارهایی روییده تا وسط آن."],[755,"خرم آن حیوان که او آنجا شود","اشتر اندر سبزه ناپیدا شود","حیوان خوشبختی است که در آن مکان (مرغزار) حضور دارد، در حالی که شتر در آن سبزه گم و ناپدید می‌شود."],[755,"هر طرف در وی یکی چشمه روان","اندرو حیوان مرفه در امان","در هر طرف این خر چشمه‌ای جاری است که به واسطه آن، حیوانات در آرامش و امنیت زندگی می‌کنند."],[755,"از خری او را نمی‌گفت ای لعین","تو از آن‌جایی چرا زاری چنین","گفتن از خر (پیشوایی یا دلیلی) برای شخصی (یا به نوعی به او نسبت دادن) نادرست است، مگر اینکه به طور واقعی دلیلی برای ناراحتی او وجود داشته باشد. اینجا بیان می‌شود که نمی‌توان بدون دلیل به کسی تهمت ناراحتی زد."],[755,"کو نشاط و فربهی و فر تو","چیست این لاغر تن مضطر تو","کجاست شادی و سلامتی و زیبایی تو؟ چرا این بدن لاغر و ناتوان تو در اضطراب است؟"],[755,"شرح روضه گر دروغ و زور نیست","پس چرا چشمت ازو مخمور نیست","اگر کسی که در مقام روضه‌خوانی است و با دروغ و فریب کاری می‌کند، حقیقت را نمی‌گوید، پس چرا تو از شنیدن سخنان او متاثر و شگفت‌زده نمی‌شوی؟"],[755,"این گدا چشمی و این نادیدگی","از گدایی تست نه از بگلربگی","این بی‌خبری و ناپختگی این گدا، ناشی از حالتی است که او در گدایی دارد و نه به خاطر بزرگی یا مقامش. به عبارتی، اگر او نادیده است و چیزی نمی‌بیند، به دلیل وضعیت گدایی‌اش است و نه به خاطر مقام و عظمت."],[755,"چون ز چشمه آمدی چونی تو خشک","ور تو ناف آهویی کو بوی مشک","هرگاه که از چشمه زندگی و وجود به دنیا آمده‌ای، چگونه می‌توانی خشک و بی‌روح بمانی؟ آیا مثل آهویی که بوی مشک را دارد، بایست نشان دهی که از سرچشمه حیات آمده‌ای؟"],[755,"زانک می‌گویی و شرحش می‌کنی","چون نشانی در تو نامد ای سنی","تو که درباره‌ی خدا صحبت می‌کنی و صفات او را توضیح می‌دهی، چرا نشانه‌ای از او در وجودت دیده نمی‌شود؟"],[756,"آن یکی پرسید اشتر را که هی","از کجا می‌آیی ای اقبال پی","یک نفر از شتری پرسید که تو از کجا می‌آیی و به کجا می‌روی؟"],[756,"گفت از حمام گرم کوی تو","گفت خود پیداست در زانوی تو","شتر گفت که از حمام گرم محل تو می آیم، و آن نفر در جواب گفت از زانوی چرک و پینه بسته تو پیداست که دروغ میگویی!"],[756,"مار موسی دید فرعون عنود","مهلتی می‌خواست نرمی می‌نمود","موسی به فرعون، که دشمن سرسختی است، نشان داد تا از او ترسی ندارد، ولی فرعون برای فرار از عواقب کارش، تظاهر به نرمش و درخواست مهلت می‌کند."],[756,"زیرکان گفتند بایستی که این","تندتر گشتی چو هست او رب دین","زیرکان که به دانشمندان یا افراد دانا اشاره دارد، می‌گویند باید این شخص (فرعون) با جدیت و سرعت بیشتری عمل کند و تغییر کند، چون او بزرگترین شخص در دین و قدرت است."],[756,"معجزه‌ گر اژدها گر مار بد","نخوت و خشم خدایی‌اش چه شد","اگر کسی بتواند معجزه کند و به شکل اژدها یا مار درآید، خشم و تکبر خداوندی‌اش چه سود دارد؟ این شعر به نقد غرور و خودبزرگ‌بینی می‌پردازد و می‌گوید حتی اگر کسی قدرت‌های ویژه‌ای داشته باشد، در نهایت وقار و حق‌گویی مهم‌تر است."],[756,"رب اعلی گر ویست اندر جلوس","بهر یک کرمی چیست این چاپلوس","اگر خداوند (رب اعلی) در کنار ما باشد، بودن در کنار یک کرم (حشره‌ای کوچک و بی‌ارزش) چه اهمیتی دارد که این شخص بخواهد خود را بزرگ جلوه دهد و تملق کند؟"],[756,"نفس تو تا مست نقلست و نبید","دانک روحت خوشه غیبی ندید","نفس تو وقتی تحت تأثیر شراب و مستی است، نمی‌تواند حقیقت روح خود را که از عالم غیب است، ببیند."],[756,"که علاماتست زان دیدار نور","التجافی منک عن دار الغرور","علامت‌های ناشی از آن دیدار نورانی، دوری از خانه فریب و نیرنگ را نشان می‌دهد."],[756,"مرغ چون بر آب شوری می‌تند","آب شیرین را ندیدست او مدد","پرنده‌ای که بر روی آب شور پرواز می‌کند، به دلیل اینکه هیچ‌گاه آب شیرین را ندیده است، نمی‌تواند آن را تشخیص دهد."],[756,"بلک تقلیدست آن ایمان او","روی ایمان را ندیده جان او","ایمان او در واقع تقلید است و او خودش حقیقت ایمان را تجربه نکرده است. جان او به شناخت واقعی از ایمان دست نیافته است."],[756,"پس خطر باشد مقلد را عظیم","از ره و ره‌زن ز شیطان رجیم","افراد مقلد که بدون دلیل و دانش خود به حرف دیگران عمل می‌کنند، در خطر بزرگی هستند، زیرا در مسیر زندگی ممکن است به مشکلات و وسوسه‌های ناشی از شیطان برخورد کنند."],[756,"چون ببیند نور حق آمن شود","ز اضطرابات شک او ساکن شود","هرگاه انسان نور حقیقت را ببیند، ایمانش قوی‌تر می‌شود و از دلش اضطراب‌ها و تردیدها برطرف می‌شود."],[756,"تا کف دریا نیاید سوی خاک","که اصل او آمد بود در اصطکاک","تا زمانی که کف دریا به سوی خشکی نیاید، یعنی تا زمانی که اصل (وجود) آن درگیر (با هیجانات و کثافت‌های) حیات دنیوی است، آرامش و صفا به دست نمی‌آید."],[756,"خاکی است آن کف غریبست اندر آب","در غریبی چاره نبود ز اضطراب","این بیت می‌گوید که کف‌های دریا که به خاک می‌رسند، خاکی بیگانه و غریب هستند و در میان آب، چاره‌ای برای رهایی از اضطراب و نگرانی وجود ندارد. در واقع، وجود این کف‌ها به ما حس تنهایی و بیگانگی می‌دهد."],[756,"چونک چشمش باز شد و آن نقش خواند","دیو را بر وی دگر دستی نماند","زمانی که آن شخص چشمش باز شد و تصویر را خواند، دیگر دیو (شر یا بدی) بر او تسلطی نداشت و قدرتی بر او باقی نماند."],[756,"گرچه با روباه خر اسرار گفت","سرسری گفت و مقلدوار گفت","هرچند که با روباه (حیله‌گر) خر (ساده‌دل) راز و اسراری را بیان کرد، اما به طور سطحی و به شیوه‌ای تقلیدی صحبت کرد."],[756,"آب را بستود و او تایق نبود","رخ درید و جامه او عاشق نبود","آب را ستود، اما او شایسته‌ی این ستایش نبود؛ چراکه خود را در معرض دید قرار داد و جامه‌اش نشانه‌ی عشق نبود."],[756,"از منافق عذر رد آمد نه خوب","زانک در لب بود آن نه در قلوب","عذر و بهانه‌های منافق پذیرفتنی نیست، زیرا نفاق فقط ظاهری است و در دل‌ها حقیقت دیگری وجود دارد."],[756,"بوی سیبش هست جزو سیب نیست","بو درو جز از پی آسیب نیست","بوی سیب وجود دارد ولی خود سیب نیست؛ این بو ناشی از آسیب و عیب دیگری است. یعنی ممکن است چیزی ظاهرا خوب و خوش‌بو به نظر برسد، اما در واقع هیچ‌گونه کیفیت واقعی و نیکی نداشته باشد."],[756,"حمله زن در میان کارزار","نشکند صف بلک گردد کار زار","حمله زن در میدان جنگ صفوف دشمن را نمی‌شکند، بلکه باعث می‌شود که اوضاع جنگ به هم بریزد و کارزار به هم بریزد."],[756,"گرچه می‌بینی چو شیر اندر صفش","تیغ بگرفته همی‌لرزد کفش","هرچند که او را مانند شیری در میدان می‌بینی که تیغ در دست دارد، اما در واقع از ترس و اضطراب پاهایش میلرزد."],[756,"وای آنک عقل او ماده بود","نفس زشتش نر و آماده بود","آه بر او که عقلش به ماده وابسته است و نفس زشت او به قوت و آمادگی رسیده است."],[756,"لاجرم مغلوب باشد عقل او","جز سوی خسران نباشد نقل او","عقل او به‌طور حتم مغلوب است و به جز به سوی ضرر و خسارت، نمی‌تواند راهی را پیش بگیرد."],[756,"ای خنک آن کس که عقلش نر بود","نفس زشتش ماده و مضطر بود","خوشا به حال کسی که عقل او قوی و غالب باشد، هرچند نفس او زشت و ضعیف باشد و تحت فشار باشد."],[756,"عقل جزوی‌اش نر و غالب بود","نفس انثی را خرد سالب بود","عقل او جزئی و قوی است و برتری دارد، ولی نفس او زنانه و ضعیف است و همین ضعف، عقل او را در کنترل خود دارد."],[756,"حمله ماده به صورت هم جریست","آفت او هم‌چو آن خر از خریست","حمله زن (ماده) به صورت، به معنای این است که در نظر دیگران، او آسیب دیده است، و مانند خر (که به سادگی مورد سو استفاده قرار می‌گیرد) ضعف نشان می‌دهد."],[756,"وصف حیوانی بود بر زن فزون","زانک سوی رنگ و بو دارد رکون","حیوانی که توصیف می‌شود، بیشتر از زن زیباست، زیرا او به سمت رنگ و بوی خوش کشیده می‌شود."],[756,"رنگ و بوی سبزه‌زار آن خر شنید","جمله حجتها ز طبع او رمید","خر به رنگ و بوی سبزه‌زار توجه کرد و به همین دلیل از همه دلایل منطقی که برای او آورده شده بود، فرار کرد و به آنچه که طبعش می‌طلبید، روی آورد."],[756,"تشنه محتاج مطر شد وابر نه","نفس را جوع البقر بد صبر نه","تشنه به آب و نیازمند باران شد، و نفس انسان هم مانند گاو، طاقت گرسنگی را ندارد."],[756,"اسپر آهن بود صبر ای پدر","حق نبشته بر سپر جاء الظفر","صبر مانند سپری از جنس آهن است، ای پدر، که خداوند بر سپر پیروزی نوشته است. یعنی صبر و استقامت باعث دستیابی به پیروزی می‌شود."],[756,"صد دلیل آرد مقلد در بیان","از قیاسی گوید آن را نه از عیان","مقلد (پیرو) می‌تواند صد دلیل برای اثبات نظریه‌اش بیاورد، اما این دلایل از قیاس (استدلال غیرمستقیم) نشأت می‌گیرند و نه از مشاهدات واقعی و عینی."],[756,"مشک‌آلودست الا مشک نیست","بوی مشکستش ولی جز پشک نیست","این بیت به این معناست که چیزی که به نظر می‌رسد دارای ارزش و زیبایی است (مانند بوی مشک) در واقع تنها حاوی چیز بی‌ارزش و سطحی است (مانند پشک) و نشان‌دهنده فریبندگی ظواهر است."],[756,"تا که پشکی مشک گردد ای مرید","سالها باید در آن روضه چرید","مرید باید سال‌ها در جست‌وجو و تربیت باشد تا بتواند از پشک، که نماد ناپاکی و بی‌ارزشی است، به مرتبه‌ای برسد که مانند مشک، نماد عطر و پاکی، شود."],[756,"که نباید خورد و جو هم‌چون خران","آهوانه در ختن چر ارغوان","نباید مانند خران، بی‌هدف در صحرا بچرند و علف بخورند؛ باید عاقلانه و با درک از زیبایی‌های موجود باشد، همان‌طور که آهوها در ختن (منطقه‌ای معروف به زیبایی و گل‌کاری) رفتار می‌کنند."],[756,"جز قرنفل یا سمن یا گل مچر","رو به صحرای ختن با آن نفر","از صحرای ختن، از بین گل‌ها و گیاهان معطری مانند قرنفل، سمن و گل، دور نشوید و به خاطر نداشته باشید که فقط در اینجا به دنبال چیزهای دیگر نروید."],[756,"معده را خو کن بدان ریحان و گل","تا بیابی حکمت و قوت رسل","برای رسیدن به حکمت و توانمندی، باید معده‌ات را با خوردن ریحان و گل عادت بدهی و هماهنگ کنی."],[756,"خوی معده زین که و جو باز کن","خوردن ریحان و گل آغاز کن","مزاج خود را به‌وسیله آنچه می‌خوری تغییر بده، پس شروع کن به خوردن ریحان و گل."],[756,"معده تن سوی کهدان می‌کشد","معده دل سوی ریحان می‌کشد","معده‌ی جسم به سمت غذاهای ساده و کالری‌زا (که یا کاه و جو هستند) می‌رود، در حا