ارین و شحنه خود توی","اما اگر در عالم غیب بگشتی، مایملک و قدرت تو به دست خودت بود و تو نیز فرمانده آن ملک می‌شدی."],[964,"شحنگی و پادشاهی مقیم","نه دو روزه و مستعارست و سقیم","در این بیت، مولانا می‌گوید که مقام‌هایی مانند شحنه (فرمانده یا مأمور) و پادشاهی دائمی نیستند و به‌طور موقت و فانی هستند؛ این موقعیت‌ها مانند بیماری‌اند و نمی‌توان به آن‌ها درازمدت اعتماد کرد."],[964,"رستی از بیگار و کار خود کنی","هم تو شاه و هم تو طبل خود زنی","اگر از زحمت و کار خسته شده‌ای، خودت را رها کن و بدان که هم تو پادشاهی (بالاترین مقام را داری) و هم خودت آلات و وسایل زندگی‌ات را به صدا در می‌آوری."],[964,"چون گلو تنگ آورد بر ما جهان","خاک خوردی کاشکی حلق و دهان","وقتی که دنیا بر ما تنگ می‌شود و نفس‌کشیدن سخت می‌شود، به یاد می‌آوریم که ما از خاک هستیم و آرزوی می‌کنیم که حلق و دهان ما به زمین برگردد."],[964,"این دهان خود خاک‌خواری آمدست","لیک خاکی را که آن رنگین شدست","این دهان، تنها برای خوردن خاک و مادیات به وجود آمده است، اما آن خاکی که رنگین و زیبا شده، به دلیل آب و خاک و شرایطی است که بر آن گذشته است."],[964,"این کباب و این شراب و این شکر","خاک رنگینست و نقشین ای پسر","این غذاها و نوشیدنی‌ها، یعنی کباب و شراب و شکر، در واقع از خاک و زمین شکل گرفته‌اند و زیبایی و رنگینی آن‌ها هم به خاطر آب و هوای خاکی است که از آن به وجود آمده‌اند."],[964,"چونک خوردی و شد آن لحم و پوست","رنگ لحمش داد و این هم خاک کوست","زمانی که تو خوردی و بدن تو از لحم و پوست تشکیل شده، رنگ لحم تو را تغییر داد و در نهایت، این بدن هم به خاک تبدیل خواهد شد."],[964,"هم ز خاکی بخیه بر گل می‌زند","جمله را هم باز خاکی می‌کند","همه انسان‌ها که از خاک خلق شده‌اند، در نهایت نیازمند خاک می‌شوند و به آن بازمی‌گردند؛ حتی اگر در زندگی به زیبایی و شکوهی مثل گل باشند."],[964,"هندو و قفچاق و رومی و حبش","جمله یک رنگ‌اند اندر گور خوش","هندو، قفچاقی (مردمان مناطق قفقاز)، رومی و حبشی (مردم حبشه) همه در مقابل مرگ و در گور یکسان و مشابه‌اند. در آنجا همه تفاوت‌ها و رنگ و نژادها از بین می‌رود و انسان‌ها به طور یکسان در خاک می‌خوابند."],[964,"تا بدانی کان همه رنگ و نگار","جمله روپوشست و مکر و مستعار","بدان که همه زینت‌ها و زیبایی‌ها تنها پوششی هستند و در حقیقت فریب و تزویر به شمار می‌روند."],[964,"رنگ باقی صبغة الله است و بس","غیر آن بر بسته دان هم‌چون جرس","رنگی که پایدار است تنها صبغه الله (رنگ الهی) است و بس؛ سایر رنگ‌ها مانند زنگ جرس (زنگ وبازگونگی) در حقیقت بی‌اساس و زودگذر هستند."],[964,"رنگ صدق و رنگ تقوی و یقین","تا ابد باقی بود بر عابدین","رنگ صداقت و رنگ تقوا و یقین، برای عابدانی که به خداوند بندگی می‌کنند، همیشه باقی و پایدار است."],[964,"رنگ شک و رنگ کفران و نفاق","تا ابد باقی بود بر جان عاق","شک، کفر و نفاق همواره بر روح کسی که در دایره عاق و نادان است، سایه می‌افکند و در آن‌ها باقی می‌ماند."],[964,"چون سیه‌رویی فرعون دغا","رنگ آن باقی و جسم او فنا","فرعون که چهره‌اش سیاه‌رو و نیرنگی بود، به رغم وجود ظاهری‌اش، در واقع شخصیت و درونش نابود شده و از بین رفته است."],[964,"برق و فر روی خوب صادقین","تن فنا شد وان به جا تا یوم دین","زیبایی و درخشندگی چهره‌های خوب و راستین (صادقین) از بین می‌رود و بدن (تن) آنها فنا می‌شود، اما آن زیبایی و درخشندگی تا روز قیامت باقی خواهد ماند."],[964,"زشت آن زشتست و خوب آن خوب و بس","دایم آن ضحاک و این اندر عبس","زشت همان‌طور که هست زشت است و خوب نیز به همان صورت خوب است و هیچ‌چیز در این دنیا تغییر نمی‌کند؛ مانند ضحاک، که نماد شر و زشتی است، و عبس، که اشاره به بی‌هدف بودن و بی‌فایده بودن است."],[964,"خاک را رنگ و فن و سنگی دهد","طفل‌خویان را بر آن جنگی دهد","خاک به کودکان شکلی متفاوت و رنگ و زیبایی می‌دهد و آنها را به جنگ و جدال بر می‌انگیزد."],[964,"از خمیری اشتر وشیری پزند","کودکان از حرص آن کف می‌گزند","کودکان از خمیر و شیر خوراکی می‌سازند و به خاطر حرص و طمعی که دارند، از آن‌ها به شدت بهره‌برداری می‌کنند."],[964,"شیر و اشتر نان شود اندر دهان","در نگیرد این سخن با کودکان","شیر و شتر برای کودکان مانند نان در دهانشان می‌شود، اما این مفهوم برای آن‌ها قابل درک نیست و نمی‌توانند آن را بفهمند."],[964,"کودک اندر جهل و پندار و شکیست","شکر باری قوت او اندکیست","کودک در نادانی، خیال و تردید به سر می‌برد و در واقع شکر این است که قوت او بسیار کم است."],[964,"طفل را استیزه و صد آفتست","شکر این که بی‌فن و بی‌قوتست","کودک در معرض آزمون و بلاهاست و این مایه شکرگزاری است که او هنوز بدون مهارت و قدرت است."],[964,"وای ازین پیران طفل ناادیب","گشته از قوت بلای هر رقیب","ناله و فریاد از این بزرگ‌ترها (پیران) که کودکانی بی‌تعلیم و نادان شده‌اند و از شدت بلا و فشار رقبای خود تضعیف گشته‌اند."],[964,"چون سلاح و جهل جمع آید به هم","گشت فرعونی جهان‌سوز از ستم","وقتی که سلاح و جهل با هم ترکیب شوند، نتیجه‌اش ظهور فرعونی است که با ستم خود، جهان را می‌سوزاند و نابود می‌کند."],[964,"شکر کن ای مرد درویش از قصور","که ز فرعونی رهیدی وز کفور","ای مرد درویش، شکر کن که از نادانی و ظلم فرعونی نجات یافتی و از زشتی‌ها دور هستی."],[964,"شکر که مظلومی و ظالم نه‌ای","آمن از فرعونی و هر فتنه‌ای","خوشحالی کن که تو مظلوم هستی و ظالم نیستی و از دست فرعونیان و هر نوع فتنه‌ای در امان مانده‌ای."],[964,"اشکم تی لاف اللهی نزد","که آتشش را نیست از هیزم مدد","اشک‌هایم در برابر خدا به‌قدری ارزشمند هستند که هیچ آتش و سوزشی نمی‌تواند آن‌ها را خاموش کند، زیرا این اشک‌ها بدون کمک هیزم (یعنی به‌خودی‌خود و از دل) سوزانند."],[964,"اشکم خالی بود زندان دیو","کش غم نان مانعست از مکر و ریو","اشک من در غم و اندوه خالی است و مانند زندانی است که دچار دیو ناامیدی‌ام، زیرا غم نان و معیشت مانع از ریاکاری و نیرنگ‌ها می‌شود."],[964,"اشکم پر لوت دان بازار دیو","تاجران دیو را در وی غریو","چشمم پر از غم و اندوه است، مانند بازاری پر از فاجعه و ناامیدی، که در آن تاجران بدطینت و فاسد مشغول به کارند و مانند دیوها در آن شلوغی به داد و ستد مشغولند."],[964,"تاجران ساحر لاشی‌فروش","عقل‌ها را تیره کرده از خروش","تاجران فریبکار و جادوگر، عقل‌ها را به خاطر نغمه و سر و صدای بلند خود، تاریک و نابینا کرده‌اند."],[964,"خم روان کرده ز سحری چون فرس","کرده کرباسی ز مهتاب و غلس","به خاطر سحر و جادو، خم و زین زده شده و سرشار از حالت شیرینی است، همان‌طور که کرباس (پارچه‌ای زبر) در شب مهتاب و در محلی مرطوب حس خوبی را منتقل می‌کند."],[964,"چون بریشم خاک را برمی‌تنند","خاک در چشم ممیز می‌زنند","چون پارچه‌ی ابریشمی روی خاک می‌کشند، خاک به چشم فردی که تشخیص می‌دهد، می‌خورد و او را نابینا می‌کند."],[964,"چندلی را رنگ عودی می‌دهند","بر کلوخیمان حسودی می‌دهند","به چندل، که نوعی گیاه معطر است، رنگی زرد مانند عود می‌دهند، اما بر کلوخ (خاک) حسودان، به خاطر حسادت، بدی‌ها و زشت‌کاری می‌افزایند."],[964,"پاک آنک خاک را رنگی دهد","هم‌چو کودکمان بر آن جنگی دهد","خاک را که رنگ می‌زنند، پاک و زیبا می‌شود، درست مانند اینکه کودکان بر سر یکدیگر می‌جنگند و بازی می‌کنند."],[964,"دامنی پر خاک ما چون طفلکان","در نظرمان خاک هم‌چون زر کان","دامن ما که پر از خاک است، در نگاه ما مانند دامن کودکان می‌نماید و این خاک را همچون طلا می‌بینیم."],[964,"طفل را با بالغان نبود مجال","طفل را حق کی نشاند با رجال","کودک در کنار بزرگ‌ترها جایی ندارد و نمی‌تواند در محافل آنان حضور پیدا کند. حقایق و مسئولیت‌ها به او تعلق ندارد و نمی‌تواند در زندگی بزرگ‌ترها شرکت کند."],[964,"میوه گر کهنه شود تا هست خام","پخته نبود غوره گویندش به نام","هر میوه‌ای که کهنه و رسیده شود، اگر هنوز نرسیده و خام باشد، به نام غوره شناخته می‌شود. به این معنا که هر چیز، حتی اگر در سن و سال پیشرفت کند، اما به بلوغ نرسد، به عنوان ناقص و خام باقی می‌ماند."],[964,"گر شود صدساله آن خام ترش","طفل و غوره‌ست او بر هر تیزهش","اگرچه آن میوه صد سال هم بگذرد و کهنه شود، اما هنوز هم طعم ترش و خامی را دارد و در حقیقت، مانند یک کودک یا میوه نارس است."],[964,"گرچه باشد مو و ریش او سپید","هم در آن طفلی خوفست و امید","اگرچه مو و ریش او سفید شده، اما در دل این انسان بزرگسالی هنوز ترس و امید یک کودک وجود دارد."],[964,"که رسم یا نارسیده مانده‌ام","ای عجب با من کند کرم آن کرم","من در وضعی نامناسب و نرسیده به هدف خود هستم، اما به شگفتی می‌بینم که آن شخص بخشنده با من چقدر مهربانی می‌کند."],[964,"با چنین ناقابلی و دوریی","بخشد این غوره مرا انگوریی","با این حالتی که من دارم و با این فاصله‌ای که از او دارم، باید چطور این انگور را به من بدهد."],[964,"نیستم اومیدوار از هیچ سو","وان کرم می‌گویدم لا تیاسوا","من از هیچ‌جا امیدی ندارم و با این حال این بزرگمهربانی می‌فرماید ناامید نشوید."],[964,"دایما خاقان ما کردست طو","گوشمان را می‌کشد لا تقنطوا","مسلمان خاقان (شاه) ما همواره ما را به امیدواری دعوت می‌کند و گوش ما را به این موضوع گوشزد می‌کند که ناامید نشوید."],[964,"گرچه ما زین ناامیدی در گویم","چون صلا زد دست اندازان رویم","هرچند که در این ناامیدی به سر می‌بریم و چیزی از امید نداریم، اما وقتی صدا می‌زنند، به حرکت درمی‌آییم و از جا برمی‌خیزیم."],[964,"دست اندازیم چون اسپان سیس","در دویدن سوی مرعای انیس","به مانند اسبان تندرو که به‌سرعت به سمت مرتع خوشایند می‌دوند، ما نیز تلاش می‌کنیم و شتاب می‌کنیم."],[964,"گام اندازیم و آن‌جا گام نی","جام پردازیم و آن‌جا جام نی","حرکت کنیم و در آن‌جا قدم نزنیم، یعنی در آن مکان، به جای راه رفتن، در حال رسیدن به معانی معنوی و عمیق هستیم و نه به دنبال خرید و فروش ظاهری (جام)."],[964,"زانک آن‌جا جمله اشیا جانیست","معنی اندر معنی اندر معنیست","در آنجا همه اشیا وجود ندارند و تنها حقیقت و معنا وجود دارد که این معنا در عمق معانی نهفته است."],[964,"هست صورت سایه معنی آفتاب","نور بی‌سایه بود اندر خراب","سایه تنها تصویر و نمود ظاهری است و برای وجود آن به آفتاب (نور) نیاز دارد، اما نور واقعی و اصلی وجود دارد که بدون نیاز به سایه، ابدی و پایدار است. در واقع، هر چیز ظاهری به معنای باطنی وابسته است و حقیقت در درون خود معنا دارد."],[964,"چونک آنجا خشت بر خشتی نماند","نور مه را سایه زشتی نماند","وقتی که در آنجا یک لایه از خشت بر روی لایه دیگر نماند، به همین ترتیب نور ماه هم سایه زشتی نمی‌تواند بر جا بگذارد. یعنی وقتی فضای پاک و خالی از کثیفی باشد، نور و زیبایی هم به درستی جلوه می‌کند و زشتی تاثیری ندارد."],[964,"خشت اگر زرین بود بر کندنیست","چون بهای خشت وحی و روشنیست","اگر خشت هم از طلا باشد، باز هم برای ساختن بنا استفاده نمی‌شود، چرا که ارزش و قیمت واقعی خشت در وحی و روشنایی است، نه در جنس آن."],[964,"کوه بهر دفع سایه مندکست","پاره گشتن بهر این نور اندکست","کوه برای دفع سایه، شکسته می‌شود، اما پاره شدن آن به خاطر نور کمی است که در آن وجود دارد."],[964,"بر برون که چو زد نور صمد","پاره شد تا در درونش هم زند","نور خداوندی که از «صمد» (خود ماندگار) برون زنهار می‌تابد، آن‌چنان قوی است که هر پیکر و موجودی را از هم می‌پاشد و به محض اینکه این نور به درون انسان برسد، او نیز دگرگون می‌شود."],[964,"گرسنه چون بر کفش زد قرص نان","وا شکافد از هوس چشم و دهان","زمانی که فردی گرسنه می‌شود و نان را می‌بیند، از روی هوس و اشتها، به شدت به آن توجه می‌کند و تمامی حواسش به خوردن نان معطوف می‌شود."],[964,"صد هزاران پاره گشتن ارزد این","از میان چرخ برخیز ای زمین","اگر بر اثر چرخ (سرنوشت) صد هزاران پاره (چیزهای ارزشمند) از دست برود، ارزش آن را ندارد که زمین از خواب و بی‌تحرکی بلند شود."],[964,"تا که نور چرخ گردد سایه‌سوز","شب ز سایه تست ای یاغی روز","تا زمانی که نور آسمان درخشان شود و سایه شب را بسوزاند، تو ای روز، از سایه تو فرار می‌کنند."],[964,"این زمین چون گاهواره طفلکان","بالغان را تنگ می‌دارد مکان","این زمین مانند گهواره‌ای برای بچه‌های بزرگ شده است که آنها را در خود محصور و محدود می‌کند."],[964,"بهر طفلان حق زمین را مهد خواند","شیر در گهواره بر طفلان فشاند","زمین به خاطر اینکه به کودکان نگاه‌داری و پرورش می‌دهد، به مانند مهد و گهواره‌ای است که خداوند به آنها می‌دهد. مانند شیری که در گهواره بر روی کودکان محبت و نعمت خود را می‌افشاند."],[964,"خانه تنگ آمد ازین گهواره‌ها","طفلکان را زود بالغ کن شها","گهواره‌ها برای این کودکان تنگ شده است، ای شاه، پس هر چه زودتر آن‌ها را بزرگ کن و به زندگی مستقل هدایت کن."],[964,"ای گواره خانه را ضیق مدار","تا تواند کرد بالغ انتشار","ای گهواره، خانه را تنگ نکن تا کودکان بتوانند به خوبی بزرگ شوند و رشد کنند."],[965,"چون مسلم گشت بی‌بیع و شری","از درون شاه در جانش جری","زمانی که به‌طور واضح احساس کرد که از فروختن و معامله دور شده و از درون وجود شاه، شور و هیجانی به وجود آمده، به‌واقع مشکلی در روح او ایجاد شد."],[965,"قوت می‌خوردی ز نور جان شاه","ماه جانش هم‌چو از خورشید ماه","تو از نور جان شاه قوت می‌گیری؛ روح او مانند ماه است که از نور خورشید بهره‌مند می‌شود."],[965,"راتبه جانی ز شاه بی‌ندید","دم به دم در جان مستش می‌رسید","شاه دلی پرنور و روحی زنده دارد که هر لحظه به او الهام می‌شود و این الهام، زندگی و سرزندگی را به جان او منتقل می‌کند."],[965,"آن نه که ترسا و مشرک می‌خورند","زان غذایی که ملایک می‌خورند","این بیت بیان می‌کند که برخی از مردم، مانند ترسایان و مشرکان، به خاطر غذایی که فرشتگان از آن می‌خورند، نمی‌توانند به مقام و مرتبه‌ای که فرشتگان دارند، دست یابند. در واقع، اشاره به این است که برتری و برکت در غذا و خوراک نیست، بلکه در روح و ایمان انسان است."],[965,"اندرون خویش استغنا بدید","گشت طغیانی ز استغنا پدید","در درون خود غنای روحانی را مشاهده کرد و از همین احساس غنی بودن، طغیانی در وجودش ایجاد شد."],[965,"که نه من هم شاه و هم شه‌زاده‌ام","چون عنان خود بدین شه داده‌ام","من هم شاه هستم و هم پسر شاه، اما چون اختیار خود را به این پادشاه سپرده‌ام، دیگر در واقعیت خود را فراموش کرده‌ام."],[965,"چون مرا ماهی بر آمد با لمع","من چرا باشم غباری را تبع","وقتی که ماهی (عشق و نور) در دل من روشن شد، چرا باید به غباری (همچون دنیا و مشغولیت‌های ناچیز) توجه کنم؟"],[965,"آب در جوی منست و وقت ناز","ناز غیر از چه کشم من بی‌نیاز","آب در جوی من است و وقتی که در حال ناز و نازپروری هستم، دیگر چه چیزی باید ببرم در حالی که به هیچ چیز نیاز ندارم؟"],[965,"سر چرا بندم چو درد سر نماند","وقت روی زرد و چشم تر نماند","چرا باید سر را به پایی بزنم وقتی که دیگر دردی در سر وجود ندارد و در این حالت، چهره رنگ پریده و چشمانم اشک‌آلود است؟"],[965,"چون شکرلب گشته‌ام عارض قمر","باز باید کرد دکان دگر","من به زیبایی و دلنشینی همچون لب‌های شراب‌ساز (شکرلب) تبدیل شده‌ام و حالا که چهره‌ام مانند ماه (قمر) زیبا شده است، باید به دنبال عشق یا کار تازه‌ای بروم."],[965,"زین منی چون نفس زاییدن گرفت","صد هزاران ژاژ خاییدن گرفت","وقتی که انسان دچار خودپسندی و غرور می‌شود، به طور طبیعی هزاران حرف بیهوده و ناپسند از او خارج می‌شود، مانند نفس کشیدن که باعث زاییدن او می‌شود."],[965,"صد بیابان زان سوی حرص و حسد","تا بدان‌جا چشم بد هم می‌رسد","از شدت حرص و حسد، فرد به میزان زیادی در تلاش است و حتی تا آن‌جا پیش می‌رود که آسیب‌های بد و چشم‌زخم نیز به او می‌رسد."],[965,"بحر شه که مرجع هر آب اوست","چون نداند آنچ اندر سیل و جوست","پادشاهی که منبع و مرجع همه نعمت‌ها و زندگی‌هاست، چگونه می‌تواند از آنچه در سیل و جریان زندگی می‌گذرد، آگاه نباشد؟"],[965,"شاه را دل درد کرد از فکر او","ناسپاسی عطای بکر او","شاه به خاطر فکر ناسپاسی و ناقدری از هدایای بی‌نظیر و خاصی که به او داده شده، دچار غم و ناراحتی شده است."],[965,"گفت آخر ای خس واهی‌ادب","این سزای داد من بود ای عجب","شاه به او گفت: «ای خسیس و بی‌ادب، تو سزاوار این کیفر هستی که به تو داده‌ام، واقعا شگفت‌انگیز است."],[965,"من چه کردم با تو زین گنج نفیس","تو چه کردی با من از خوی خسیس","من چه کار خوبی با تو کرده‌ام که چنین گنجی باارزش را به تو داده‌ام، و تو چه کار ناپسندی با من کرده‌ای که چنین خصلت بخیلانه‌ای داری؟"],[965,"من ترا ماهی نهادم در کنار","که غروبش نیست تا روز شمار","من تو را مانند ماه در کنار گذاشتم که غروب نمی‌کند، یعنی همیشه درخشان و پایدار هستی و هیچ‌گاه از بین نمی‌روی."],[965,"در جزای آن عطای نور پاک","تو زدی در دیده من خار و خاک","به خاطر بخشش و نور پاک تو، در چشم من چیزی شبیه خار و خاک قرار گرفته است که باعث درد و رنج من شده."],[965,"من ترا بر چرخ گشته نردبان","تو شده در حرب من تیر و کمان","من تو را وسیله‌ای برای رسیدن به اهدافم می‌دانم، و در جنگ با دشمنانم، تو مانند تیر و کمان برای من عمل می‌کنی."],[965,"درد غیرت آمد اندر شه پدید","عکس درد شاه اندر وی رسید","درد غیرت بر دل شاه ظاهر شد و او هم درد خودش را در وجود شاه حس کرد."],[965,"مرغ دولت در عتابش بر طپید","پرده آن گوشه گشته بر درید","مرغ دولت، که نمادی از خوشبختی و موفقیت است، در غضب و خشم او پرواز کرده و به او روی می‌آورد، در حالی که پرده‌ای که او را از حقیقت محافظت می‌کرد، پاره شده است."],[965,"چون درون خود بدید آن خوش‌پسر","از سیه‌کاری خود گرد و اثر","آن پسر خوش‌سیما که درون خود را نگریست، از نادرستی‌ها و اعمال زشت خود، غمگین و پشیمان شد."],[965,"از وظیفه لطف و نعمت کم شده","خانه شادی او پر غم شده","به خاطر کوتاهی در سپاسگزاری از نعمت‌ها و لطف‌های خداوند، شادی و خوشحالی در دل او کم شده و جای آن را غم گرفته است."],[965,"با خود آمد او ز مستی عقار","زان گنه گشته سرش خانه خمار","او که به حالت مستی و گیجی به سر می‌برد، اکنون به حال خود بازگشته و متوجه شده که به خاطر گناهی که کرده، حالش و زندگی‌اش خراب و دچار افسردگی شده است."],[965,"خورده گندم حله زو بیرون شده","خلد بر وی بادیه و هامون شده","از جایی که درستی‌اش مشخص نیست، گندم حله (گندم با کیفیت و مرغوب) را خورده و به خاطر آن به بهشت (خلد) راه یافته است و اینک او در بیابان و هامون (مناطق خشک و بی‌آب) قرار گرفته است."],[965,"دید کان شربت ورا بیمار کرد","زهر آن ما و منیها کار کرد","پادشاه متوجه شد که نوشیدنی‌ای که او را شفا می‌دهد، در حقیقت باعث بیماریش شده است و زهر خودخواهی و منیت او را بیشتر کرده است."],[965,"جان چون طاوس در گل‌زار ناز","هم‌چو چغدی شد به ویرانه مجاز","جان انسانی در زیبایی و نازش مانند طاووس در باغ گل، دچار غفلت و پوچی شده است و حالا مثل مرغ چغدی در ویرانی و خیالات بی‌اساس زندگی می‌کند."],[965,"هم‌چو آدم دور ماند او از بهشت","در زمین می‌راند گاوی بهر کشت","او مانند آدم که به خاطر نافرمانی از بهشت رانده شد، در اینجا در زمین سرگردان است و گویا همچون گاوی برای کشت و کار به کار گرفته می‌شود."],[965,"اشک می‌راند او کای هندوی زاو","شیر را کردی اسیر دم گاو","این بیت به فردی به نام هندوی زاو اشاره دارد که به نوعی باعث تسلیم شیر (نماد قدرت و شجاعت) در برابر گاو (نماد ضعف و اسارت) شده است. به عبارت دیگر، او (هندوی زاو) با دلسوزی و اشک‌هایش، قدرت و شجاعت را به زانو درآورده و به اسارت کشانده است."],[965,"کردی ای نفس بد بارد نفس","بی‌حفاظی با شه فریادرس","ای نفس بد، تو باعث شده‌ای که در خطر بیفتیم و به پادشاه (خدا) که یاری‌دهنده ماست، فریاد بزنیم و به او پناه ببریم."],[965,"دام بگزیدی ز حرص گندمی","بر تو شد هر گندم او کزدمی","تو به خاطر حرص و طمعی که داری، در دام افتادهای. هر گندم، بر تو حکم نرم دمی (نخوت‌زدن) دارد، و تو را به انحطاط می‌کشاند."],[965,"در سرت آمد هوای ما و من","قید بین بر پای خود پنجاه من","غیرت و خودپسندی تو باعث شده که از حقیقت دور شوی؛ در حالی که تو خود را در محدودیت‌ها و وابستگی‌ها محبوس کرده‌ای."],[965,"نوحه می‌کرد این نمط بر جان خویش","که چرا گشتم ضد سلطان خویش","او بر جان خود نوحه می‌کرد و به خاطر این که چرا با سلطان خود (خدا) مخالفت کرده است، از خود ناخرسند بود."],[965,"آمد او با خویش و استغفار کرد","با انابت چیز دیگر یار کرد","او (پادشاه‌زاده) به سوی خود آمد و از کارهای خود پشیمان شد، به درگاه خدا بازگشت و به علاوه، چیز دیگری نیز برای جلب محبت خداوند انجام داد."],[965,"درد کان از وحشت ایمان بود","رحم کن کان درد بی‌درمان بود","دردی که به خاطر ترس از ایمان به وجود آمده، بسیار شدید و بی‌پایان است؛ پس ای خدا، به این درد توجه کن و رحمت کن، چرا که این درد را درمانی نیست."],[965,"مر بشر را خود مبا جامه درست","چون رهید از صبر در حین صدر جست","انسان را از پوشیدن لباس نیک و درست باید باز داشت وقتی که از صبر و تحمل رهایی یابد و در حال بزرگی و مقام قرار گیرد."],[965,"مر بشر را پنجه و ناخن مباد","که نه دین اندیشد آنگه نه سداد","آدمی را نباید دست و ناخن باشد (یعنی نباید از خود منفعت‌طلبی و خودخواهی نشان دهد)، زیرا در این صورت نه به دین فکر می‌کند و نه به انصاف و راستگویی."],[965,"آدمی اندر بلا کشته بهست","نفس کافر نعمتست و گمرهست","انسان در بلا و سختی، به بهترین حالت ممکن کشته می‌شود، اما کسی که به شکرگزاری نعمت‌ها توجه نداشته باشد، کافر و گمراه است."],[966,"حق به عزرائیل می‌گفت ای نقیب","بر کی رحم آمد ترا از هر کئیب","خداوند به عزرائیل می‌گوید: ای فرشته مرگ، بر کدام یک از این مردم رحم کرده‌ای و دلت به حالشان سوخته است؟"],[966,"گفت بر جمله دلم سوزد به درد","لیک ترسم امر را اهمال کرد","عزرائیل می‌گوید که دلم به خاطر همه انسان‌ها می‌سوزد و از درد آن‌ها ناراحتم، اما می‌ترسم که در انجام مسئولیت خود کوتاهی کنم یا وظیفه‌ام را فراموش کنم."],[966,"تا بگویم کاشکی یزدان مرا","در عوض قربان کند بهر فتی","عزرائیل آرزو می‌کند ای کاش خداوند او را در عوض قربانی قرار دهد تا جانش از بندگی و خدمت به انسان‌ها آزاد شود."],[966,"گفت بر کی بیشتر رحم آمدت","از کی دل پر سوز و بریان‌تر شدت","خداوند به عزرائیل می‌پرسد که بر چه کسی بیشتر رحم کرده‌ای و دلش بیشتر از دیگران در آتش حسرت سوخته است."],[966,"گفت روزی کشتیی بر موج تیز","من شکستم ز امر تا شد ریز ریز","عزرائیل می‌گوید یک روز کشتی‌ای به خاطر امری که بر من پیش آمد بر روی موج‌های تند شکسته شد و آن کشتی به تکه‌های کوچک تبدیل شد."],[966,"پس بگفتی قبض کن جان همه","جز زنی و غیر طفلی زان رمه","پس حق تعالی به عزرائیل فرمود: جان همه را بگیر، جز زن و غیر از کودک در این گروه."],[966,"هر دو بر یک تخته‌ای در ماندند","تخته را آن موج‌ها می‌راندند","هر دو، یعنی عزرائیل و خداوند، بر یک تخته که نماد زندگی و وجود است، به حالت انتظار و تردید قرار دارند. این تخته در وسط دریا امواجی دارد که نشان‌دهنده سختی‌ها و مشکلات زندگی است و آنها را از هم دور می‌کند."],[966,"باز گفتی جان مادر قبض کن","طفل را بگذار تنها ز امر کن","خداوند به عزرائیل می‌گوید دوباره جان مادر را بگیر و طفل را به حال خود رها کن و به تو چنین دستور داده‌ام."],[966,"چون ز مادر بسکلیدم طفل را","خود تو می‌دانی چه تلخ آمد مرا","وقتی که من کودک را از مادرش جدا کردم، تو خود می‌دانی که چقدر این کار برای من تلخ و دردناک بود."],[966,"بس بدیدم دود ماتم‌های زفت","تلخی آن طفل از فکرم نرفت","عزرائیل به تلخی‌ها و مرگ‌هایی که دیده اشاره می‌کند و می‌گوید که تأثیر بد آن ماتم‌ها و سوگواری‌ها در ذهنش باقی مانده و فراموش نمی‌شود."],[966,"گفت حق آن طفل را از فضل خویش","موج را گفتم فکن در بیشه‌ایش","خداوند به عزرائیل فرمود که آن کودک را از برکت و لطف خود نجات دادم و به او گفتم که او را در دشت پر از زیبایی و نعمات قرار بده."],[966,"بیشه‌ای پر سوسن و ریحان و گل","پر درخت میوه‌دار خوش‌اکل","درباره باغی سرشار از گل‌ها و گیاهان خوشبو و درختان میوه‌دار صحبت می‌کند که در آن تنوع زیبایی وجود دارد و می‌توان از میوه‌های خوشمزه‌اش بهره‌مند شد."],[966,"چشمه‌های آب شیرین زلال","پروریدم طفل را با صد دلال","من چشمه‌های آب شیرین و زلال را برای پرورش کودک گذاشتم و به او با هزاران نشان و اشاره، محبت و لطف کردم."],[966,"صد هزاران مرغ مطرب خوش‌صدا","اندر آن روضه فکنده صد نوا","در آن بهشت زیبایی، صدها هزار پرنده خوش‌صدا آواز می‌خوانند و نغمه‌های دل‌نواز را پراکنده کرده‌اند."],[966,"پسترش کردم ز برگ نسترن","کرده او را آمن از صدمه فتن","من به گل برگ نسترن بی‌خطر و آرامش بخشیدم و او را از آسیب فتنه‌ها نجات دادم."],[966,"گفته من خورشید را کو را مگز","باد را گفته برو آهسته وز","خداوند به عزرائیل می‌گوید که به خورشید بگو به تندی نتابد و باد را هم بگو به آرامی بوزد. یعنی به او سفارش کن که با ملایمت عمل کند."],[966,"ابر را گفته برو باران مریز","برق را گفته برو مگرای تیز","خدا به ابر می‌گوید که باران نریزد و به برق می‌گوید که از تیزی و تندروی خود بکاهد."],[966,"زین چمن ای دی مبران اعتدال","پنجه ای بهمن برین روضه ممال","از این چمن، ای دی ماه (دی‌ماه، وقت زایش گیاه) دوری کن؛ چون اعتدال (بهار) با پنجه‌ای از بهمن (ماه سرد و خشک) این باغ را در می‌نوردد."],[967,"هم‌چو آن شیبان که از گرگ عنید","وقت جمعه بر رعا خط می‌کشید","شیخ شیبان، که به خاطر پرهیزگاری‌اش معروف بود، مانند این مثال است که در روزهای جمعه دور گوسفندها خط می‌کشید تا از گرگ و دزدها محافظت کند."],[967,"تا برون ناید از آن خط گوسفند","نه در آید گرگ و دزد با گزند","این بیت می‌گوید برای اینکه گوسفندها از خطی که شیبان رسم کرده‌اند خارج نشوند، باید آنها را در امنیت نگه داشت؛ در غیر این صورت، گرگ و دزد به آنها آسیب خواهند زد."],[967,"بر مثال دایره تعویذ هود","که اندر آن صرصر امان آل بود","در این بیت، به شباهت یک دایره حفاظت اشاره شده که در آن، طوفان (صرصر) و آسیب از آل (نسل) محفوظ می‌مانند. این دایره نمادی از امنیت و حفاظت است."],[967,"هشت روزی اندرین خط تن زنید","وز برون مثله تماشا می‌کنید","هشت روز در این خط (مسیر) تن زندگی کردید و آنچه درون این مسیر است (وجود انسان) را از بیرون مشاهده می‌کنید."],[967,"بر هوا بردی فکندی بر حجر","تا دریدی لحم و عظم از هم‌دگر","به هوای بالا پرتاب کردی و بر سنگی انداختی تا گوشت و استخوان را از یکدیگر جدا کنی."],[967,"یک گره را بر هوا درهم زدی","تا چو خشخاش استخوان ریزان شدی","یعنی تو یک گره را بر هوا به هم زدی و آن‌چنان شدی که مثل دانه‌های خشخاش، استخوان‌های تو ریخته و پراکنده شد."],[967,"آن سیاست را که لرزید آسمان","مثنوی اندر نگنجد شرح آن","این سیاستی که آسمان را به لرزه واداشته، آن‌قدر عظیم و پر significado است که نمی‌توان آن را در مثنوی توضیح داد."],[967,"گر به طبع این می‌کنی ای باد سرد","گرد خط و دایره آن هود گرد","اگر می‌خواهی، ای باد سرد، بر طبق طبیعت‌ات عمل کنی، به دور خط و دایره آن بیفکن."],[967,"ای طبیعی فوق طبع این ملک بین","یا بیا و محو کن از مصحف این","ای طبیعت، تو فراتر از صفات طبیعی این عالم را بنگر یا بیا و این نوشته (مصحف) را از بین ببر."],[967,"مقریان را منع کن بندی بنه","یا معلم را به مال و سهم ده","به مقریان (کسانی که آواز می‌خوانند) دستور بده تا از کار خود باز بایستند و آنها را محدود کن، یا به معلم (مدرس) پاداش و حق‌الزحمه بده تا بتواند به درستی مسئولیت خود را انجام دهد."],[967,"عاجزی و خیره کن عجز از کجاست","عجز تو تابی از آن روز جزاست","عجز و ناتوانی تو از کجا نشأت گرفته است؟ عجز تو نتیجه تاب و سرگردانی تو در همان روزی است که به آن اشاره می‌شود."],[967,"عجزها داری تو در پیش ای لجوج","وقت شد پنهانیان را نک خروج","ای لجوج، تو در برابر خداوند عجز و ناتوانی‌های زیادی داری، اکنون زمان آن رسیده است که پنهانی‌ها را از پس پرده بیرون بیاوری."],[967,"خرم آن کین عجز و حیرت قوت اوست","در دو عالم خفته اندر ظل دوست","خوشحالی از این است که عجز و حیرت ما قدرت و قوت او (خدا) است و در دو جهان، ما تحت سایه دوست (خدا) آرام گرفته‌ایم."],[967,"هم در آخر عجز خود را او بدید","مرده شد دین عجایز را گزید","او (انسان) در آخرین لحظات ضعف و ناتوانی خود را دید و در این حال، مثل کسی که از شگفتی و حیرت می‌میرد، دین‌های عجیب و غریب را پذیرفت."],[967,"چون زلیخا یوسفش بر وی بتافت","از عجوزی در جوانی راه یافت","زلیخا، که سال‌ها به خاطر عشقش به یوسف دچار رنج و از دست رفتن جوانی‌اش شده بود، به طرز معجزه‌آسا و در اوج پیری دوباره به جوانی و زیبایی خود دست می‌یابد."],[967,"زندگی در مردن و در محنتست","آب حیوان در درون ظلمتست","زندگی در واقع در مردن و سختی‌ها نهفته است و حقیقت زندگی مانند آب حیات، در عمق تاریکی‌ها و مشکلات قرار دارد."],[968,"حاصل آن روضه چو باغ عارفان","از سموم صرصر آمد در امان","حاصل و نتیجه آن باغ که زندگی عارفان در آن جریان دارد، از آسیب و خطرات باد سرد و مضر (صرصر) در امان مانده است."],[968,"یک پلنگی طفلکان نو زاده بود","گفتم او را شیر ده طاعت نمود","یک پلنگی بچه‌های تازه به دنیا آمده‌ای داشت. گفتم او را به شیرسردی جزا بدهید."],[968,"پس بدادش شیر و خدمتهاش کرد","تا که بالغ گشت و زفت و شیرمرد","او را شیر داد و خدماتی برایش انجام داد تا اینکه به سن بلوغ رسید و مردی بزرگ و قدرتمند شد."],[968,"چون فطامش شد بگفتم با پری","تا در آموزید نطق و داوری","وقتی کودک به سن بلوغ رسید، به او گفتم که با پری (موجودی زیبا و فریبنده) صحبت کند تا زبان‌آموزی و توانایی قضاوت را یاد بگیرد."],[968,"پرورش دادم مر او را زان چمن","کی بگفت اندر بگنجد فن من","من او را در چمن پرورش دادم، آیا او (نمرود) به من گفت که کار من در اینجا چگونه می‌گنجد؟"],[968,"داده من ایوب را مهر پدر","بهر مهمانی کرمان بی‌ضرر","من، ایوب را برای مهمانی به کرمان فرستاده‌ام و مهر پدر را هم به او داده‌ام تا بی‌خطر و بحالت خوش، مهمانی کند."],[968,"داده کرمان را برو مهر ولد","بر پدر من اینت قدرت اینت ید","خداوند محبت و عطوفت را به فرزند در کرمان داده، و این قدرت و قدرت نمایی تو، ای پدر، نشانه‌ای از عظمت و قدرت خداوند است."],[968,"مادران را داب من آموختم","چون بود لطفی که من افروختم","من به مادران روحیه و رفتار خاصی را آموزش دادم، تا لطف و محبت خود را به آن‌ها نشان دهم و برکت افروزم."],[968,"صد عنایت کردم و صد رابطه","تا ببیند لطف من بی‌واسطه","من به افراد زیادی نعمت و لطف دادم و به آن‌ها ارتباطات متعددی را نشان دادم، تا لطف و رحمت من را بدون واسطه و به‌طور مستقیم ببینند."],[968,"تا نباشد از سبب در کش‌مکش","تا بود هر استعانت از منش","اگر انسان در کشمکش‌ها و مشکلات زندگی از علل و وسایل بیرونی کمک بگیرد، نمی‌تواند به ذات و منش واقعی خود پی ببرد. در واقع، تا زمانی که وابسته به دیگران باشد، نمی‌تواند به نیروی درونی و خویش‌کاری خود دست یابد."],[968,"ورنه تا خود هیچ عذری نبودش","شکوتی نبود ز هر یار بدش","اگر علت و دلیلی از طرف او وجود نداشته باشد، پس هیچ مانعی برای او وجود نخواهد داشت و در نتیجه شکایتی از هیچ دوستی که بد باشد هم نخواهد داشت."],[968,"این حضانه دید با صد رابطه","که بپروردم ورا بی‌واسطه","خداوند نمرود را بدون نیاز به مادر یا دایه و با صدها ارتباط و تدبیر خود تربیت کرد."],[968,"شکر او آن بود ای بنده جلیل","که شد او نمرود و سوزنده خلیل","شکر و سپاس خدا بر این است که او چنین بنده بزرگی چون نمرود را به وجود آورد، کسی که آتش سوزان خلیل، یعنی ابراهیم را به دوش کشید."],[968,"هم‌چنان کین شاه‌زاده شکر شاه","کرد استکبار و استکثار جاه","همچنان که این شاه‌زاده (نمرود) در مقابل خداوند سپاسگزاری کرد، دلش را پر از تکبر و خواست قدرت و جاه کرد."],[968,"که چرا من تابع غیری شوم","چونک صاحب ملک و اقبال نوم","چرا باید تابع و پیرو کسی دیگر شوم، حال آنکه من خود صاحب کشور و وضعیت خوب هستم؟"],[968,"لطف‌های شه که ذکر آن گذشت","از تجبر بر دلش پوشیده گشت","لطف‌هایی که به نمرود (پادشاه بابل) از جانب خداوند عطا شده بود، به خاطر تکبر و خودبزرگ‌بینی‌اش بر دلش پنهان ماند و نتوانست آنها را درک کند."],[968,"هم‌چنان نمرود آن الطاف را","زیر پا بنهاد از جهل و عمی","نمرود همچنان به خاطر نادانی و نادانی‌اش، آن نعمت‌ها و لطف‌های الهی را نادیده گرفت و زیر پا گذاشت."],[968,"این زمان کافر شد و ره می‌زند","کبر و دعوی خدایی می‌کند","نمرود در این زمان کافر شده و به خود غره شده است و با تکبر و ادعای خدایی خود را به نمایش می‌گذارد."],[968,"رفته سوی آسمان با جلال","با سه کرکس تا کند با من قتال","نمرود به آسمان رفته تا با جلال و بزرگی خود و با سه کرکس (نوعی پرنده) به جنگ با خدا برود."],[968,"صد هزاران طفل بی‌تلویم را","کشته تا یابد وی ابراهیم را","نمرود، برای اینکه ابراهیم (که در آن زمان در سن کودکی بود و تهدیدی برای او محسوب می‌شد) را بکشند، صد هزاران کودک بی‌گناه را قربانی کرده است."],[968,"که منجم گفته کاندر حکم سال","زاد خواهد دشمنی بهر قتال","منجم گفته است که طبق پیش‌بینی‌ها، در سالی که ابراهیم متولد می‌شود، دشمنی متولد خواهد شد که برای جنگ آماده است."],[968,"هین بکن در دفع آن خصم احتیاط","هر که می‌زایید می‌کشت از خباط","مراقب باش تا با احتیاط از آن دشمن جلوگیری کنی، زیرا هر کسی که به دنیا می‌آید، از آن بدی‌ها و زشتی‌ها باید کشته شود."],[968,"کوری او رست طفل وحی کش","ماند خون‌های دگر در گردنش","نابینایی نمرود باعث شد که او همچنان وابسته به وحی و الهام باقی بماند و در عین حال، گناهان و خطاهای دیگران بر گردن او سنگینی کند."],[968,"از پدر یابید آن ملک ای عجب","تا غرورش داد ظلمات نسب","نکته جالب این است که او (نمرود) از پدرش این مقام را به ارث برد، با این حال، غرور او او را به سمت تاریکی و گمراهی کشانده است."],[968,"دیگران را گر ام و اب شد حجیب","او ز ما یابید گوهرها به جیب","اگر دیگران به مقام و مرتبه‌ای برسند، برای ما عجیب نیست، زیرا او (خدا) از ما به معنای باطن و ارزش‌های درونی‌مان، چیزهای ارزشمندی را به دست آورده است."],[968,"گرگ درنده‌ست نفس بد یقین","چه بهانه می‌نهی بر هر قرین","نفس بد انسان مانند گرگ درنده‌ای است که همیشه در کمین است؛ بنابراین بهانه‌جویی برای توجیه کارهای ناپسند اصلا جایز نیست."],[968,"در ضلالت هست صد کل را کله","نفس زشت کفرناک پر سفه","نفس زشت و بد، مانند یک سر بد که بر هزاران سر دیگر تسلط دارد، آدمی را به گمراهی می‌کشاند و در جهل و کفر نگه می‌دارد."],[968,"زین سبب می‌گویم این بنده فقیر","سلسله از گردن سگ برمگیر","به همین دلیل می‌گویم، ای پروردگار، این بنده نیازمند را از زنجیر و بند گیاهی که به گردن سگ است رها کن."],[968,"گر معلم گشت این سگ هم سگست","باش ذلت نفسه کو بدرگست","اگرچه این سگ معلم شود، هنوز هم سگ است و نشان‌دهنده خفت و حقارت نفس است که او را در چنین مقامی قرار داده است."],[968,"فرض می‌آری به جا گر طایفی","بر سهیلی چون ادیم طایفی","اگر تصور کنی که وقتی قومی در جائی متحد می‌شوند، به مانند جایی که به لشکری می‌پیوندند، آنجا هم به سهولت و راحتی، می‌توانند در کنار هم بایستند."],[968,"تا سهیلت وا خرد از شر پوست","تا شوی چون موزه‌ای هم‌پای دوست","اگر از گوهر وجودت پاکی و صفا داشته باشی، آن‌گاه مانند یک دستمال تمیز خواهی شد که در کنارت قرار می‌گیرد و هم‌پای دوستت می‌گردی."],[968,"جمله قرآن شرح خبث نفس‌هاست","بنگر اندر مصحف آن چشمت کجاست","قرآن به وضیحی ویژگی‌های پلید نفس انسان‌ها را شرح می‌دهد، پس به دقت به محتوای کتاب قرآن نگاه کن که چشمانت کجا را می‌بیند."],[968,"ذکر نفس عادیان کالت بیافت","در قتال انبیا مو می‌شکافت","این بیت به نقد نفس‌های معمولی و عادی اشاره دارد که در برخورد با پیامبران در جدال و ستیز هستند. در اینجا، حالت عادی انسان‌ها به گونه‌ای ابراز شده که در نبرد حق و باطل، همچون مویی که در جنگ می‌شکافد، در معرض آسیب و کشمکش قرار می‌گیرد."],[968,"قرن قرن از شوم نفس بی‌ادب","ناگهان اندر جهان می‌زد لهب","یعنی نسل پس از نسل، نفس‌های بی‌ادب و شوم در دنیا آتش و فساد ایجاد می‌کنند و ناگهان به شکلی خطرناک ظاهر می‌شوند."],[969,"قصه کوته کن که رای نفس کور","برد او را بعد سالی سوی گور","نفس انسان، به خاطر نادانی و کوری‌اش، او را به راهی می‌برد که به مرگ و گور ختم می‌شود، بنابراین باید داستان را به طور خلاصه و مختصر بیان کرد."],[969,"شاه چون از محو شد سوی وجود","چشم مریخیش آن خون کرده بود","شاه پس از آنکه از وجود خود محو شد، به سوی آن نگاه کرد که مانند چشم مریخ، حالت خونین و سرخ دارد."],[969,"چون به ترکش بنگرید آن بی‌نظیر","دید کم از ترکشش یک چوبه تیر","وقتی آن بی‌نظیر (شاه‌زاده) به ترکش نگاه کرد، متوجه شد که از تیرکش او (ترکش) حتی یک تیر هم کم است."],[969,"گفت کو آن تیر و از حق باز جست","گفت که اندر حلق او کز تیر تست","گفت: تیر کجاست؟ و از حقیقت دور شو. پاسخ داد که آن تیر در حلق اوست، نه در تیروکمان."],[969,"عفو کرد آن شاه دریادل ولی","آمده بد تیر اه بر مقتلی","آن شاه بزرگ دل که عاطفه‌اش فراوان است، برای قتل شده بخشش کرد، ولی این تیر که به او اصابت کرده، در حقیقت به کسی اشاره می‌کند که جانش گرفته شده است."],[969,"کشته شد در نوحه او می‌گریست","اوست جمله هم کشنده و هم ولیست","او در سوگ (نوحه) کشته شده می‌گریست؛ زیرا او هم قاتل همه است و هم ولی (پدر) همگان."],[969,"ور نباشد هر دو او پس کل نیست","هم کشنده خلق و هم ماتم‌کنیست","اگر هر دو (کشته و کشنده) وجود نداشته باشند، در واقع هیچ چیزی نیست؛ چرا که او هم خداوندی است که خلق را می‌کشد و هم شخصی است که بر کشته‌ها می‌گرید."],[969,"شکر می‌کرد آن شهید زردخد","کان بزد بر جسم و بر معنی نزد","شهیدی به نام زردخد از اینکه به واسطه جراحتی که بر جسم و روحش وارد آمده، شکرگزاری می‌کند و به او حسرت وارد نمی‌شود."],[969,"جسم ظاهر عاقبت خود رفتنیست","تا ابد معنی بخواهد شاد زیست","جسم ظاهری در نهایت از بین می‌رود و ماندگار نیست، اما معنای حقیقی و روحی نیاز به زندگی شاد و خوش دارد."],[969,"آن عتاب ار رفت هم بر پوست رفت","دوست بی‌آزار سوی دوست رفت","اگر تندخویی و سرزنش به ظاهر به کسی آسیب زد، در واقع این تنها بر جسم او تأثیر دارد و روح دوستانه و بی‌آزاری به سوی دوست واقعی خود ادامه می‌دهد."],[969,"گرچه او فتراک شاهنشه گرفت","آخر از عین الکمال او ره گرفت","با اینکه او تاج شاهنشاهی را بر سر نهاد، اما در حقیقت از کمال و فضیلت واقعی خود دور شد و از راه حقیقت منحرف گردید."],[969,"و آن سوم کاهل‌ترین هر سه بود","صورت و معنی به کلی او ربود","سومین شخص از آن سه، تنبل‌ترین بود و در نتیجه، هم ظاهر و هم باطنش به طور کامل از آن‌ها جدا شده بود."],[970,"آن یکی شخصی به وقت مرگ خویش","گفته بود اندر وصیت پیش‌پیش","آن شخص در لحظه‌ی مرگش خواسته بود که وصیت کند و درباره‌ی تقسیم اموالش صحبت کند."],[970,"سه پسر بودش چو سه سرو روان","وقف ایشان کرده او جان و روان","او سه پسر داشت که مانند سه درخت سرو، سالم و سرزنده بودند و همه دارایی‌اش را به آن‌ها بخشیده بود."],[970,"گفت هرچه در کفم کاله و زرست","او برد زین هر سه کو کاهل‌ترست","او گفت هر چه اموال و دارایی دارم باید بردارد کسی که از این سه فرزندم تنبل‌تر است."],[970,"گفت با قاضی و پس اندرز کرد","بعد از آن جام شراب مرگ خورد","او با قاضی صحبت کرده و نصیحتی کرد، سپس بعد از آن شراب مرگ را نوشید."],[970,"گفته فرزندان به قاضی کای کریم","نگذریم از حکم او ما سه یتیم","فرزندان به قاضی می‌گویند: ای انسان مهربان، ما از حکم او نمی‌گذریم زیرا که ما سه یتیم هستیم."],[970,"ما چو اسمعیل ز ابراهیم خود","سرنپیچیم ارچه قربان می‌کند","ما مانند اسماعیل (پسر ابراهیم) هرگز از انجام فرمان خدا سرپیچی نمی‌کنیم، هرچند که ابراهیم (پدر اسماعیل) او را برای قربانی کردن آماده کرده بود."],[970,"گفت قاضی هر یکی با عاقلیش","تا بگوید قصه‌ای از کاهلیش","قاضی گفت هر یک از فرزندان باید با هوش و عاقلی که دارند، داستانی از کاهلی و بی‌عملی خود بگویند."],[970,"تا ببینم کاهلی هر یکی","تا بدانم حال هر یک بی‌شکی","منتظرم تا ببینم کاهلی هر یک از فرزندانم را، تا بتوانم به طور یقین حال هر یک را بفهمم."],[970,"عارفان از دو جهان کاهل‌ترند","زانک بی شد یار خرمن می‌برند","عارفان از هر دو جهان (دنیا و آخرت) کم‌تحرک‌تر هستند، زیرا که یار و محبوبشان (خدا) را از دست داده‌اند و در نتیجه، توجه‌ و تلاششان به دست آوردن نعمت‌های معنوی کاهش یافته است."],[970,"کاهلی را کرده‌اند ایشان سند","کار ایشان را چو یزدان می‌کند","عارفان به بهانه کاهلی، کارهای خود را توجیه می‌کنند؛ همان‌طور که یزدان (خدا) کارهایش را به شیوه‌ای خاص انجام می‌دهد."],[970,"کار یزدان را نمی‌بینند عام","می‌نیاسایند از کد صبح و شام","بعضی از مردم، اعمال خداوند را نمی‌بینند و از نعمت‌های خدا در صبح و شب غافلند و آرام نمی‌گیرند."],[970,"هین ز حد کاهلی گویید باز","تا بدانم حد آن از کشف راز","بیدار باشید و از کسالت و تنبلی دست بکشید و به من بگویید که چقدر ناتوانی شما از کشف حقایق و اسرار وجود دارد."],[970,"بی‌گمان که هر زبان پرده دلست","چون بجنبد پرده سرها واصلست","هر زبانی در واقع پرده‌ای است که نشان‌دهنده احساسات و دل انسان است، و وقتی که زبان به حرف آید، نشان‌دهنده عمق فکر و احساسات درونی فرد می‌شود."],[970,"پرده کوچک چو یک شرحه کباب","می‌بپوشد صورت صد آفتاب","پرده کوچک مانند یک تکه کباب، می‌تواند چهره صد خورشید را بپوشاند. این جمله به این معناست که چیزهای ظاهری (پرده) می‌توانند واقعیت‌های بزرگ و نورانی (آفتاب) را بپوشانند و از دید پنهان کنند."],[970,"گر بیان نطق کاذب نیز هست","لیک بوی از صدق و کذبش مخبرست","هرچند ممکن است گفتار دروغ باشد، اما بوی صدق و دروغ از آن به خوبی احساس می‌شود."],[970,"آن نسیمی که بیایدت از چمن","هست پیدا از سموم گولخن","نسیمی که از چمن به سوی تو می‌وزد، ناشی از هوای پاک و خوشبوست، در حالی که هوای بد و آلوده (سموم گولخن) هم وجود دارد؛ بنابراین می‌توانی به خوبی تشخیص دهی که کدام هوای سالم است."],[970,"بوی صدق و بوی کذب گول‌گیر","هست پیدا در نفس چون مشک و سیر","بوی صداقت و بوی دروغ در وجود انسان وجود دارد، همان‌طور که بوی مشک و سیر در هوا به وضوح احساس می‌شود."],[970,"گر ندانی یار را از ده‌دله","از مشام فاسد خود کن گله","اگر نتوانی دوست را از آدم‌های دو رو تشخیص بدهی، باید از بوی بد درون خود شکایت کنی."],[970,"بانگ حیزان و شجاعان دلیر","هست پیدا چون فن روباه و شیر","صدای شجاعان و دلاوران به‌وضوح شنیده می‌شود، همان‌طور که فنون و ترفندهای روباه و شیر نیز شناخته شده است."],[970,"یا زبان هم‌چون سر دیگست راست","چون بجنبد تو بدانی چه اباست","زبان انسان مانند درپوش دیگ است؛ هنگامی که حرکت کند و به صحبت بیافتد، می‌توانی بفهمی چه چیزی در دل او جو دارد."],[970,"از بخار آن بداند تیزهش","دیگ شیرینی ز سکباج ترش","از بخار دیگ می‌توان فهمید که شیرینی آن بهتر و خوشمزه‌تر از ترشی سکباج (نوعی خوراک است که معمولا ترش است) است."],[970,"دست بر دیگ نوی چون زد فتی","وقت بخریدن بدید اشکسته را","وقتی که به دیگ شیرینی دست زد و دید که در آن چیزی شکسته وجود دارد، متوجه شد که وقت برای خرید چیزی مناسب است."],[970,"گفت دانم مرد را در حین ز پوز","ور نگوید دانمش اندر سه روز","او (شخصی که در موردش صحبت می‌شود) می‌گوید که من می‌دانم مردی که در هنگام بروز مشکل، خود را خونسرد و آرام نگه می‌دارد، حتی اگر بعد از سه روز نتواند چیزی بگوید، باز هم نشانه خرد و فهم اوست."],[970,"وآن دگر گفت ار بگوید دانمش","ور نگوید در سخن پیچانمش","شخص دیگر گفت: اگر او (مرد) در این موضوع صحبت کند، به خوبی می‌شناسمش، و اگر هم چیزی نگوید، در حرف‌زنی و پیچیدگی‌های کلامش او را می‌شناسم."],[970,"گفت اگر این مکر بشنیده بود","لب ببندد در خموشی در رود","گفت اگر این فریب (مکر) را شنیده بود، باید که سکوت کند و در خاموشی برود."],[971,"آنچنان که گفت مادر بچه را","گر خیالی آیدت در شب فرا","مادری به فرزندش گفت اگر در شب تصوری ترسناک به سراغت آمد،"],[971,"یا بگورستان و جای سهمگین","تو خیالی بینی اسود پر ز کین","یا اگر در گورستان و مکان ترسناک هیولایی خیالی، سیاه و پر از کینه دیدی،"],[971,"دل قوی دار و بکن حمله برو","او بگرداند ز تو در حال رو","شجاع باش و به او حمله کن؛ او بلافاصله فرار می کند"],[971,"گفت کودک آن خیال دیووش","گر بدو این گفته باشد مادرش","کودک به مادرش گفت اگر مادر آن هیولای وحشتناک هم به او همین را گفته باشد"],[971,"حمله آرم افتد اندر گردنم","ز امر مادر پس من آنگه چون کنم","در آن صورت اگر به او حمله کنم، او هم به توصیه مادرش به من حمله می کند و آنگاه چه باید کنم؟"],[971,"تو همی‌آموزیم که چست ایست","آن خیال زشت را هم مادریست","تو به من یاد می دهی که محکم بایستم اما آن هیولای زشت هم مادری دارد"],[971,"دیو و مردم را ملقّن آن یکیست","غالب از وی گردد ار خصم اندکیست","هم انسان ها و هم دیوها آموزش دهنده ای دارند و از جانب وی پیروز می شوند اگر دشمن اندک باشد"],[971,"تا کدامین سوی باشد آن یواش","الله‌الله رو تو هم زان سوی باش","متوجه باش که طرفی که به او اشاره می‌شود، خداوند متعالی است و تو نیز باید به همان سوی، یعنی به سمت او، تمایل داشته باشی و از او یاد کنی."],[971,"گفت اگر از مکر ناید در کلام","حیله را دانسته باشد آن همام","گفت اگر در سخن، فریب و نیرنگی وجود نداشته باشد، آن شخص (همام) باید با هوشیاری و آگاهی به این موضوع پی ببرد."],[971,"سرّ او را چون شناسی راست گو","گفت من خامش نشینم پیش او","وقتی که حقیقت او را بشناسی، باید بدون هیچ دروغی سخن بگویی. اما من در حضور او سکوت می‌کنم."],[971,"صبر را سلّم کنم سوی درج","تا بر آیم صبر مفتاح الفرج","از صبر نردبانی می سازم تا بالا روم و به گنجینه های جواهر دست یابم که همانا صبر کلید گشایش است"],[971,"ور بجوشد در حضورش از دلم","منطقی بیرون ازین شادی و غم","اگر در حضور او (خدا) از دل من چیزی بجوشد، منطقی خواهد بود که فراتر از شادی و غم است."],[971,"من بدانم کو فرستاد آن به من","از ضمیر چون سهیل اندر یمن","من می‌دانم کسی که آن پیام را به من فرستاد، کیست، زیرا او مانند ستاره سهیل در یمن در دل من حاضر است."],[971,"در دل من آن سخن زان میمنه‌ست","زانک از دل جانب دل روزنه‌ست","در دل من آن سخن از سرزمینی خوش آمده است، زیرا آن سخن به دل نزدیک است و از جانب دل به سوی دل جریان دارد."]]}